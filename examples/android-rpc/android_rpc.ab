import "abla/compiler/parser"
import "abla/compiler"

compile fun androidRpcHash(text: string, seed: int, factor: int): int {
    var value = seed
    var index = 0
    while (index < text.size) {
        value = value * factor + text[index] + 1
        value = value - value / 1000000007 * 1000000007
        index = index + 1
    }
    value
}

compile fun androidRpcIdentifier(
    cursor: ParserCursor,
    expression: SyntaxExpression
): string {
    val identity =
        "${parserSourceIdentity(cursor)}:${syntaxBegin(expression)}:${syntaxEnd(expression)}"
    val first = androidRpcHash(identity, 23, 257)
    val second = androidRpcHash(identity, 101, 263)
    "abla_android_rpc_action_${first}_${second}"
}

compile fun androidRpcAnnotated(function: int): bool {
    var found = false
    var index = 0
    while (index < compiler.annotationCount(function)) {
        if (compiler.annotation(function, index) == "rpc") found = true
        index = index + 1
    }
    found
}

compile fun androidRpcFinalizeClick(
    actionIdentifier: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val target = typedCallTarget(expression)
    val intType = compilerFindType("i64")
    val module = compilerGeneratedModule(actionIdentifier, expression)
    var valid = target >= 0 && intType >= 0
    if (valid) valid = typedExpressionKind(expression) == "call" &&
        typedCallArgumentCount(expression) == 1
    if (valid) valid = typedCallArgumentType(expression, 0) == "i64" &&
        typedCallResultTypeHandle(expression) == intType
    if (valid) valid = compiler.parameterCount(target) == 1
    if (valid) valid = compiler.parameterType(target, 0) == "i64" &&
        compiler.resultType(target) == "i64"
    if (valid) valid = androidRpcAnnotated(target)

    if (valid) {
        val adapterName =
            "abla_android_rpc_${compiler.functionName(target)}"
        val parameterName = compiler.parameterName(target, 0)
        val parameters: array<string> = [parameterName]
        val parameterTypes: array<int> = [intType]
        val arguments: array<SyntaxExpression> = [
            syntaxIdentifier(parameterName)
        ]
        compilerGeneratedExportFunction(
            module,
            adapterName,
            parameters,
            parameterTypes,
            intType,
            syntaxCallTarget(target, arguments)
        )
    } else {
        val names: array<string> = []
        val types: array<int> = []
        compilerGeneratedFunction(
            module,
            "invalidRpcClickSignature",
            names,
            types,
            compilerFindType("MissingAndroidRpcActionType"),
            syntaxInteger(0)
        )
    }
    module
}

compile fun androidRpcParseClick(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "{")
    val action = parserParseAblaExpression(cursor)
    parserRawExpect(cursor, "}")
    if (syntaxKind(action) != "call" || syntaxChildCount(action) != 1) {
        parserFail(
            cursor,
            "Android RPC click must be a direct function call with one argument"
        )
    }

    val actionIdentifier = androidRpcIdentifier(cursor, action)
    compilerRecordGeneratedExtensionRequest(
        actionIdentifier,
        actionIdentifier,
        action,
        androidRpcFinalizeClick
    )

    syntaxChild(action, 0)
}

#compilerRegisterSubparser("androidclick", androidRpcParseClick)
