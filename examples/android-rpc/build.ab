import "main.ab"
import "abla/compiler"

#compilerGrant("filesystem.write")

compile fun androidRpcReplaceAll(
    source: string,
    expected: string,
    replacement: string
): string {
    var output = ""
    var segment = 0
    var index = 0
    while (index + expected.size <= source.size) {
        if (source.slice(index, index + expected.size) == expected) {
            output = "$output${source.slice(segment, index)}$replacement"
            index = index + expected.size
            segment = index
        } else index = index + 1
    }
    "$output${source.slice(segment, source.size)}"
}

compile fun writeRpcAndroidProject(
    root: string,
    actionName: string,
    argumentName: string
): bool {
    val settings = "pluginManagement {\n    repositories {\n        google()\n        mavenCentral()\n        gradlePluginPortal()\n    }\n}\n\ndependencyResolutionManagement {\n    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)\n    repositories {\n        google()\n        mavenCentral()\n    }\n}\n\nrootProject.name = \"AblaRpcCounter\"\n"
    val gradle = "plugins {\n    id(\"com.android.application\") version \"8.13.0\"\n    id(\"org.jetbrains.kotlin.android\") version \"2.2.20\"\n}\n\nandroid {\n    namespace = \"org.abla.rpc.example\"\n    compileSdk = 36\n    buildToolsVersion = \"36.0.0\"\n    ndkVersion = \"28.2.13676358\"\n\n    defaultConfig {\n        applicationId = \"org.abla.rpc.example\"\n        minSdk = 24\n        targetSdk = 36\n        versionCode = 1\n        versionName = \"0.0.1\"\n        ndk { abiFilters += \"arm64-v8a\" }\n    }\n\n    compileOptions {\n        sourceCompatibility = JavaVersion.VERSION_17\n        targetCompatibility = JavaVersion.VERSION_17\n    }\n\n    externalNativeBuild {\n        cmake {\n            path = file(\"src/main/cpp/CMakeLists.txt\")\n            version = \"3.22.1\"\n        }\n    }\n\n    sourceSets[\"main\"].jniLibs.srcDir(\"src/main/jniLibs\")\n}\n\nkotlin {\n    compilerOptions {\n        jvmTarget.set(org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_17)\n    }\n}\n"
    val manifest = "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\">\n    <uses-permission android:name=\"android.permission.INTERNET\" />\n    <application\n        android:allowBackup=\"false\"\n        android:label=\"Abla RPC Counter\"\n        android:theme=\"@android:style/Theme.Material.Light.NoActionBar\"\n        android:usesCleartextTraffic=\"true\">\n        <activity\n            android:name=\".MainActivity\"\n            android:exported=\"true\">\n            <intent-filter>\n                <action android:name=\"android.intent.action.MAIN\" />\n                <category android:name=\"android.intent.category.LAUNCHER\" />\n            </intent-filter>\n        </activity>\n    </application>\n</manifest>\n"
    val activity = "package org.abla.rpc.example\n\nimport android.app.Activity\nimport android.os.Bundle\nimport android.view.Gravity\nimport android.widget.Button\nimport android.widget.LinearLayout\nimport android.widget.TextView\nimport java.net.HttpURLConnection\nimport java.net.URL\n\nclass MainActivity : Activity() {\n    private val endpoint = \"http://10.0.2.2:18080/rpc/$actionName\"\n    private val argument = AblaApp.answer()\n    private var current = 0L\n\n    override fun onCreate(state: Bundle?) {\n        super.onCreate(state)\n\n        val value = TextView(this).apply {\n            gravity = Gravity.CENTER\n            textSize = 32f\n            text = current.toString()\n        }\n        val increment = Button(this).apply {\n            text = \"Increment on server\"\n            setOnClickListener {\n                isEnabled = false\n                text = \"Calling discovered action...\"\n                Thread { callIncrement(value, this) }.start()\n            }\n        }\n        val layout = LinearLayout(this).apply {\n            orientation = LinearLayout.VERTICAL\n            gravity = Gravity.CENTER\n            addView(value)\n            addView(increment)\n        }\n        setContentView(layout)\n    }\n\n    private fun callIncrement(value: TextView, button: Button) {\n        try {\n            val target = endpoint + \"?$argumentName=\" + argument\n            val connection = URL(target).openConnection() as HttpURLConnection\n            connection.requestMethod = \"POST\"\n            connection.connectTimeout = 3000\n            connection.readTimeout = 3000\n            val status = connection.responseCode\n            if (status !in 200..299) error(\"HTTP \" + status)\n            val next = connection.inputStream.bufferedReader().use { it.readText() }.trim().toLong()\n            connection.disconnect()\n            current = next\n            runOnUiThread {\n                value.text = current.toString()\n                button.text = \"Increment on server\"\n                button.isEnabled = true\n            }\n        } catch (failure: Exception) {\n            runOnUiThread {\n                button.text = \"Retry: \" + (failure.message ?: \"RPC failed\")\n                button.isEnabled = true\n            }\n        }\n    }\n}\n"
    val mutableArgument = androidRpcReplaceAll(
        activity,
        "private val argument",
        "private var argument"
    )
    val generatedActivity = androidRpcReplaceAll(
        mutableArgument,
        "            current = next\n",
        "            current = next\n            argument = next\n"
    )
    var written = compiler.writeFile("$root/settings.gradle.kts", settings)
    if (written) written = compiler.writeFile("$root/build.gradle.kts", gradle)
    if (written) written = compiler.writeFile(
        "$root/src/main/AndroidManifest.xml",
        manifest
    )
    if (written) written = compiler.writeFile(
        "$root/src/main/kotlin/org/abla/rpc/example/MainActivity.kt",
        generatedActivity
    )
    written
}

compile fun writeRpcServer(
    root: string,
    actionName: string,
    argumentName: string
): bool {
    val source = "import \"abla/http\"\nimport \"../../../examples/android-rpc/main.ab\"\n\nfun handleRpc(request: HttpRequest): HttpResponse {\n    val argument = httpDecimalLength(request.parameter(\"$argumentName\"), 1000000)\n    if (argument < 0) {\n        return httpText(\"expected a non-negative integer parameter: $argumentName\", 400)\n    }\n    val result = $actionName(argument)\n    httpText(\"\$result\")\n}\n\nfun main: int {\n    val rpc = httpRouter()\n    rpc.post(\"/rpc/$actionName\", handleRpc)\n    serveHttp(rpc, 18080)\n}\n"
    var written = compiler.writeFile("$root/server.ab", source)
    if (written) written = compiler.writeFile(
        "$root/rpc-action.txt",
        actionName
    )
    written
}

compile fun configureRpcExample(): void {
    val root = "build/examples/android-rpc"
    val functions = compiler.functionsAnnotated("rpc")
    var action = -1
    var index = 0
    while (index < functions.size) {
        val candidate = functions[index]
        if (compiler.parameterCount(candidate) == 1) {
            if (compiler.parameterType(candidate, 0) == "i64" &&
                compiler.resultType(candidate) == "i64") {
                action = candidate
            }
        }
        index = index + 1
    }

    if (action >= 0) {
        val actionName =
            "abla_android_rpc_${compiler.functionName(action)}"
        val argumentName = compiler.parameterName(action, 0)
        writeRpcAndroidProject(root, actionName, argumentName)
        writeRpcServer(root, actionName, argumentName)
    }
    return
}

#compiler.transform(configureRpcExample)

fun main: int = 0
