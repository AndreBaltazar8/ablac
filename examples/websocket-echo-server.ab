import "abla/websocket"

fun echoSocket(
    request: HttpRequest,
    var connection: WebSocketConnection
): void {
    var receiving = true
    while (receiving) {
        val message = connection.readMessage(1048576, 30000)
        if (message.available && message.kind == "text") {
            receiving = connection.sendText(message.payload)
        } else if (message.available && message.kind == "binary") {
            receiving = connection.sendBinary(message.payload)
        } else receiving = false
    }
    return
}

fun main: int {
    val router = webSocketRouter()
    router.route("/echo", echoSocket)
    serveWebSockets(router, 8080)
}
