#import("abla/android/build")
#import("abla/compiler")

#compilerGrant("filesystem.write")

compile fun writeAndroidApplication(root: string): bool {
    val settings = "pluginManagement {\n    repositories {\n        google()\n        mavenCentral()\n        gradlePluginPortal()\n    }\n}\n\ndependencyResolutionManagement {\n    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)\n    repositories {\n        google()\n        mavenCentral()\n    }\n}\n\nrootProject.name = \"AblaHello\"\n"
    val gradle = "plugins {\n    id(\"com.android.application\") version \"8.13.0\"\n    id(\"org.jetbrains.kotlin.android\") version \"2.2.20\"\n}\n\nandroid {\n    namespace = \"org.abla.example\"\n    compileSdk = 36\n    buildToolsVersion = \"36.0.0\"\n    ndkVersion = \"28.2.13676358\"\n\n    defaultConfig {\n        applicationId = \"org.abla.example\"\n        minSdk = 24\n        targetSdk = 36\n        versionCode = 1\n        versionName = \"0.0.1\"\n        ndk { abiFilters += \"arm64-v8a\" }\n    }\n\n    compileOptions {\n        sourceCompatibility = JavaVersion.VERSION_17\n        targetCompatibility = JavaVersion.VERSION_17\n    }\n\n    externalNativeBuild {\n        cmake {\n            path = file(\"src/main/cpp/CMakeLists.txt\")\n            version = \"3.22.1\"\n        }\n    }\n\n    sourceSets[\"main\"].jniLibs.srcDir(\"src/main/jniLibs\")\n}\n\nkotlin {\n    compilerOptions {\n        jvmTarget.set(org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_17)\n    }\n}\n"
    val manifest = "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\">\n    <application\n        android:allowBackup=\"false\"\n        android:label=\"Abla Hello\"\n        android:theme=\"@android:style/Theme.Material.Light.NoActionBar\">\n        <activity\n            android:name=\".MainActivity\"\n            android:exported=\"true\">\n            <intent-filter>\n                <action android:name=\"android.intent.action.MAIN\" />\n                <category android:name=\"android.intent.category.LAUNCHER\" />\n            </intent-filter>\n        </activity>\n    </application>\n</manifest>\n"
    val activity = "package org.abla.example\n\nimport android.app.Activity\nimport android.os.Bundle\nimport android.view.Gravity\nimport android.widget.TextView\n\nclass MainActivity : Activity() {\n    override fun onCreate(state: Bundle?) {\n        super.onCreate(state)\n        val greeting = TextView(this)\n        greeting.gravity = Gravity.CENTER\n        greeting.textSize = 24f\n        greeting.text = \"Hello from Abla: \" + AblaApp.answer().toString()\n        setContentView(greeting)\n    }\n}\n"
    var written = compilerWriteFile("$root/settings.gradle.kts", settings)
    if (written) written = compilerWriteFile("$root/build.gradle.kts", gradle)
    if (written) written = compilerWriteFile(
        "$root/src/main/AndroidManifest.xml",
        manifest
    )
    if (written) written = compilerWriteFile(
        "$root/src/main/kotlin/org/abla/example/MainActivity.kt",
        activity
    )
    written
}

val projectRoot = "build/examples/android"
val application = #writeAndroidApplication(projectRoot)
val nativeLibrary = #androidBuildArm64Library(
    "abla-hello-android",
    "examples/android/main.ab",
    projectRoot,
    "org.abla.example",
    true,
    true
)

fun main: int = if (application && nativeLibrary) 0 else 1
