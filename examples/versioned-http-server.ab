import "abla/http"

fun customerV1(request: HttpRequest): HttpResponse = httpJson(
    "{\"id\":\"${request.parameter("id")}\",\"apiVersion\":\"2024-01-01\"}"
)

fun customerV2(request: HttpRequest): HttpResponse {
    // A version can deliberately build on the previous representation, as in
    // the original Abla README's previous() idea. This stays explicit and
    // type-checked until @version compile-time sugar is added.
    val previous = customerV1(request)
    httpJson("{\"previous\":${previous.body},\"apiVersion\":\"2025-01-01\"}")
}

fun health(request: HttpRequest): HttpResponse = httpText("healthy")

fun main: int {
    val api = httpRouter("Stripe-Version")

    api.get("/health", health)
    api.version("2024-01-01").get("/customers/:id", customerV1)
    api.version("2025-01-01").get("/customers/:id", customerV2)

    serveHttp(api, 8080)
}
