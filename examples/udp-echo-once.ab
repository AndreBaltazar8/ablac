import "abla/net"

fun main: int {
    val socket = udpBindPort(8081)
    val incoming = socket.receiveFromWithTimeout(65507, 30000)
    var status = 1
    if (incoming.received) {
        val sent = socket.sendTo(incoming.bytes, incoming.source)
        if (sent.succeeded() && sent.written == incoming.bytes.size) status = 0
    }
    socket.close()
    status
}
