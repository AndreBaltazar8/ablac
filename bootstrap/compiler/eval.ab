#import("sema.ab")
#import("abla/sys/linux/fs")
#import("abla/sys/linux/process")
#import("abla/sys/linux/net")

// Parser handlers, finalizers, and ordinary staged expressions use separate
// evaluator objects. Keep their transaction in a private per-process staging
// directory; only scalar counters are global, so scoped-region safety remains
// independent from compile-driver bookkeeping.
var bootstrapCompileOutputCount: int = 0
var bootstrapCompileOutputBytes: int = 0

class BootstrapCompileProgramRequest(
    val name: string,
    val entry: string,
    val output: string,
    val target: string,
    val artifact: string,
    val fast: bool,
    val cache: bool
)

class BootstrapExportRequest(
    val source: string,
    val name: string,
    val resultType: string,
    val parameterNames: array<string>,
    val parameterTypes: array<string>
)

class BootstrapDefinedTarget(
    val name: string,
    val llvmTriple: string,
    val objectFormat: string,
    val linkerFlavor: string,
    val linkerEmulation: string,
    val hosted: bool,
    val libcFree: bool
)

var bootstrapCompileProgramRequestCount: int = 0
var bootstrapDriverDiagnosticCount: int = 0
var bootstrapExportRequestCount: int = 0
var bootstrapDefinedTargetCount: int = 0

fun bootstrapDefinedTargetRoot(): string =
    "build/.abla-defined-targets-${linuxProcessId()}"

fun bootstrapTargetTokenValid(value: string): bool {
    var valid = value.size > 0 && value.size <= 128
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122)
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !digit && byte != 45 && byte != 46 && byte != 95) {
            valid = false
        }
        index = index + 1
    }
    valid
}

fun bootstrapStageDefinedTarget(target: BootstrapDefinedTarget): bool {
    var valid = bootstrapDefinedTargetCount < 16 &&
        bootstrapTargetTokenValid(target.name) &&
        bootstrapTargetTokenValid(target.llvmTriple) &&
        bootstrapTargetTokenValid(target.objectFormat) &&
        bootstrapTargetTokenValid(target.linkerFlavor) &&
        bootstrapTargetTokenValid(target.linkerEmulation) &&
        !(target.hosted && target.libcFree)
    val root = bootstrapDefinedTargetRoot()
    var index = 0
    while (valid && index < bootstrapDefinedTargetCount) {
        if (Path("$root/$index.name").readText() == target.name) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val targetIndex = bootstrapDefinedTargetCount
    if (valid) valid = Path("$root/$targetIndex.name").writeTextAtomic(
        target.name
    )
    if (valid) valid = Path("$root/$targetIndex.triple").writeTextAtomic(
        target.llvmTriple
    )
    if (valid) valid = Path("$root/$targetIndex.format").writeTextAtomic(
        target.objectFormat
    )
    if (valid) valid = Path("$root/$targetIndex.linker").writeTextAtomic(
        target.linkerFlavor
    )
    if (valid) valid = Path("$root/$targetIndex.emulation").writeTextAtomic(
        target.linkerEmulation
    )
    if (valid) valid = Path("$root/$targetIndex.hosted").writeTextAtomic(
        if (target.hosted) "1" else "0"
    )
    if (valid) valid = Path("$root/$targetIndex.libc-free").writeTextAtomic(
        if (target.libcFree) "1" else "0"
    )
    if (valid) bootstrapDefinedTargetCount = targetIndex + 1
    if (!valid) {
        Path("$root/$targetIndex.name").remove()
        Path("$root/$targetIndex.triple").remove()
        Path("$root/$targetIndex.format").remove()
        Path("$root/$targetIndex.linker").remove()
        Path("$root/$targetIndex.emulation").remove()
        Path("$root/$targetIndex.hosted").remove()
        Path("$root/$targetIndex.libc-free").remove()
    }
    valid
}

fun bootstrapTakeDefinedTargets(): array<BootstrapDefinedTarget> {
    val targets: array<BootstrapDefinedTarget> = []
    val root = bootstrapDefinedTargetRoot()
    var index = 0
    while (index < bootstrapDefinedTargetCount) {
        targets.append(BootstrapDefinedTarget(
            Path("$root/$index.name").readText(),
            Path("$root/$index.triple").readText(),
            Path("$root/$index.format").readText(),
            Path("$root/$index.linker").readText(),
            Path("$root/$index.emulation").readText(),
            Path("$root/$index.hosted").readText() == "1",
            Path("$root/$index.libc-free").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.triple").remove()
        Path("$root/$index.format").remove()
        Path("$root/$index.linker").remove()
        Path("$root/$index.emulation").remove()
        Path("$root/$index.hosted").remove()
        Path("$root/$index.libc-free").remove()
        index = index + 1
    }
    bootstrapDefinedTargetCount = 0
    Path(root).remove()
    targets
}

fun bootstrapExportRequestRoot(): string =
    "build/.abla-export-requests-${linuxProcessId()}"

fun bootstrapExportNameValid(name: string): bool {
    var valid = name.size > 0 && name.size <= 128 && name != "main"
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !(index > 0 && digit)) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapStageExportRequest(request: BootstrapExportRequest): bool {
    var valid = bootstrapExportRequestCount < 64 &&
        bootstrapExportNameValid(request.name)
    val root = bootstrapExportRequestRoot()
    var index = 0
    while (valid && index < bootstrapExportRequestCount) {
        if (Path("$root/$index.name").readText() == request.name ||
            Path("$root/$index.source").readText() == request.source) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapExportRequestCount
    if (valid) valid = Path("$root/$requestIndex.source").writeTextAtomic(
        request.source
    )
    if (valid) valid = Path("$root/$requestIndex.name").writeTextAtomic(
        request.name
    )
    if (valid) valid = Path("$root/$requestIndex.result").writeTextAtomic(
        request.resultType
    )
    if (valid) valid = Path("$root/$requestIndex.parameters").writeTextAtomic(
        "${request.parameterTypes.size}"
    )
    var parameter = 0
    while (valid && parameter < request.parameterTypes.size) {
        valid = Path(
            "$root/$requestIndex.parameter-$parameter-name"
        ).writeTextAtomic(request.parameterNames[parameter])
        if (valid) valid = Path(
            "$root/$requestIndex.parameter-$parameter-type"
        ).writeTextAtomic(request.parameterTypes[parameter])
        parameter = parameter + 1
    }
    if (valid) bootstrapExportRequestCount = requestIndex + 1
    if (!valid) {
        Path("$root/$requestIndex.source").remove()
        Path("$root/$requestIndex.name").remove()
        Path("$root/$requestIndex.result").remove()
        Path("$root/$requestIndex.parameters").remove()
        parameter = 0
        while (parameter < request.parameterTypes.size) {
            Path("$root/$requestIndex.parameter-$parameter-name").remove()
            Path("$root/$requestIndex.parameter-$parameter-type").remove()
            parameter = parameter + 1
        }
    }
    valid
}

fun bootstrapTakeExportRequests(): array<BootstrapExportRequest> {
    val requests: array<BootstrapExportRequest> = []
    val root = bootstrapExportRequestRoot()
    var index = 0
    while (index < bootstrapExportRequestCount) {
        val parameterNames: array<string> = []
        val parameterTypes: array<string> = []
        val parameterCount = bootstrapDecimalIndex(
            Path("$root/$index.parameters").readText()
        )
        var parameter = 0
        while (parameter < parameterCount) {
            parameterNames.append(Path(
                "$root/$index.parameter-$parameter-name"
            ).readText())
            parameterTypes.append(Path(
                "$root/$index.parameter-$parameter-type"
            ).readText())
            Path("$root/$index.parameter-$parameter-name").remove()
            Path("$root/$index.parameter-$parameter-type").remove()
            parameter = parameter + 1
        }
        requests.append(BootstrapExportRequest(
            Path("$root/$index.source").readText(),
            Path("$root/$index.name").readText(),
            Path("$root/$index.result").readText(),
            parameterNames,
            parameterTypes
        ))
        Path("$root/$index.source").remove()
        Path("$root/$index.name").remove()
        Path("$root/$index.result").remove()
        Path("$root/$index.parameters").remove()
        index = index + 1
    }
    bootstrapExportRequestCount = 0
    Path(root).remove()
    requests
}

fun bootstrapDriverDiagnosticRoot(): string =
    "build/.abla-driver-diagnostics-${linuxProcessId()}"

fun bootstrapStageDriverDiagnostic(diagnostic: string): void {
    if (diagnostic.size <= 8192 && bootstrapDriverDiagnosticCount < 64) {
        val root = bootstrapDriverDiagnosticRoot()
        if (Path(root).createDirectories() && Path(
            "$root/$bootstrapDriverDiagnosticCount"
        ).writeTextAtomic(diagnostic)) {
            bootstrapDriverDiagnosticCount =
                bootstrapDriverDiagnosticCount + 1
        }
    }
    bootstrapSemanticUnit()
}

fun bootstrapTakeDriverDiagnostics(): string {
    var diagnostics = ""
    val root = bootstrapDriverDiagnosticRoot()
    var index = 0
    while (index < bootstrapDriverDiagnosticCount) {
        val path = Path("$root/$index")
        diagnostics = "$diagnostics${path.readText()}"
        path.remove()
        index = index + 1
    }
    bootstrapDriverDiagnosticCount = 0
    Path(root).remove()
    diagnostics
}

fun bootstrapCompileProgramRequestRoot(): string =
    "build/.abla-program-requests-${linuxProcessId()}"

fun bootstrapStageCompileProgramRequest(
    request: BootstrapCompileProgramRequest
): bool {
    var valid = bootstrapCompileProgramRequestCount < 32
    val root = bootstrapCompileProgramRequestRoot()
    var index = 0
    while (valid && index < bootstrapCompileProgramRequestCount) {
        if (Path("$root/$index.name").readText() == request.name ||
            Path("$root/$index.output").readText() == request.output) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapCompileProgramRequestCount
    if (valid) valid = Path("$root/$requestIndex.name").writeTextAtomic(
        request.name
    )
    if (valid) valid = Path("$root/$requestIndex.entry").writeTextAtomic(
        request.entry
    )
    if (valid) valid = Path("$root/$requestIndex.output").writeTextAtomic(
        request.output
    )
    if (valid) valid = Path("$root/$requestIndex.target").writeTextAtomic(
        request.target
    )
    if (valid) valid = Path("$root/$requestIndex.artifact").writeTextAtomic(
        request.artifact
    )
    if (valid) valid = Path("$root/$requestIndex.fast").writeTextAtomic(
        if (request.fast) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.cache").writeTextAtomic(
        if (request.cache) "1" else "0"
    )
    if (valid) bootstrapCompileProgramRequestCount = requestIndex + 1
    if (!valid) {
        Path("$root/$requestIndex.name").remove()
        Path("$root/$requestIndex.entry").remove()
        Path("$root/$requestIndex.output").remove()
        Path("$root/$requestIndex.target").remove()
        Path("$root/$requestIndex.artifact").remove()
        Path("$root/$requestIndex.fast").remove()
        Path("$root/$requestIndex.cache").remove()
    }
    valid
}

fun bootstrapTakeCompileProgramRequests(
): array<BootstrapCompileProgramRequest> {
    val requests: array<BootstrapCompileProgramRequest> = []
    val root = bootstrapCompileProgramRequestRoot()
    var index = 0
    while (index < bootstrapCompileProgramRequestCount) {
        requests.append(BootstrapCompileProgramRequest(
            Path("$root/$index.name").readText(),
            Path("$root/$index.entry").readText(),
            Path("$root/$index.output").readText(),
            Path("$root/$index.target").readText(),
            Path("$root/$index.artifact").readText(),
            Path("$root/$index.fast").readText() == "1",
            Path("$root/$index.cache").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.entry").remove()
        Path("$root/$index.output").remove()
        Path("$root/$index.target").remove()
        Path("$root/$index.artifact").remove()
        Path("$root/$index.fast").remove()
        Path("$root/$index.cache").remove()
        index = index + 1
    }
    bootstrapCompileProgramRequestCount = 0
    Path(root).remove()
    requests
}

fun bootstrapCompileOutputRoot(): string =
    "build/.abla-compile-outputs-${linuxProcessId()}"

fun bootstrapBeginCompileOutputs(): void {
    val root = bootstrapCompileOutputRoot()
    var index = 0
    while (index < 64) {
        Path("$root/$index.path").remove()
        Path("$root/$index.data").remove()
        index = index + 1
    }
    Path(root).remove()
    bootstrapCompileOutputCount = 0
    bootstrapCompileOutputBytes = 0
    bootstrapSemanticUnit()
}

fun bootstrapDiscardCompileOutputs(): void {
    bootstrapBeginCompileOutputs()
    bootstrapSemanticUnit()
}

fun bootstrapCompileOutputPathValid(path: string): bool {
    var valid = path.size > 0 && path.size <= 4096 && path[0] != 47
    var begin = 0
    var index = 0
    while (valid && index <= path.size) {
        val boundary = index == path.size || path[index] == 47
        if (boundary) {
            val length = index - begin
            if (length == 0 ||
                (length == 1 && path[begin] == 46) ||
                (length == 2 && path[begin] == 46 &&
                 path[begin + 1] == 46)) valid = false
            begin = index + 1
        } else if (path[index] == 0) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapStageCompileOutput(path: string, contents: string): bool {
    var valid = bootstrapCompileOutputPathValid(path) &&
        contents.size <= 16777216
    val nextBytes = bootstrapCompileOutputBytes + contents.size
    if (nextBytes > 67108864) valid = false
    if (bootstrapCompileOutputCount >= 64) valid = false
    if (valid) {
        val root = bootstrapCompileOutputRoot()
        val pathFile = Path("$root/$bootstrapCompileOutputCount.path")
        val dataFile = Path("$root/$bootstrapCompileOutputCount.data")
        valid = pathFile.writeTextAtomic(path)
        if (valid) valid = dataFile.writeTextAtomic(contents)
        if (!valid) {
            pathFile.remove()
            dataFile.remove()
        }
    }
    if (valid) {
        bootstrapCompileOutputCount = bootstrapCompileOutputCount + 1
        bootstrapCompileOutputBytes = nextBytes
    }
    valid
}

// Toolchain-owned sidecars inherit the already validated/authorized artifact
// output path, which may be absolute for a root CLI build. Keep this separate
// from compilerWriteFile so staged user code remains project-relative.
fun bootstrapStageToolchainOutput(path: string, contents: string): bool {
    var valid = path.size > 0 && path.size <= 4096 &&
        contents.size <= 16777216
    var index = 0
    while (valid && index < path.size) {
        if (path[index] == 0) valid = false
        index = index + 1
    }
    val nextBytes = bootstrapCompileOutputBytes + contents.size
    if (nextBytes > 67108864) valid = false
    if (bootstrapCompileOutputCount >= 64) valid = false
    if (valid) {
        val root = bootstrapCompileOutputRoot()
        val pathFile = Path("$root/$bootstrapCompileOutputCount.path")
        val dataFile = Path("$root/$bootstrapCompileOutputCount.data")
        valid = pathFile.writeTextAtomic(path)
        if (valid) valid = dataFile.writeTextAtomic(contents)
        if (!valid) {
            pathFile.remove()
            dataFile.remove()
        }
    }
    if (valid) {
        bootstrapCompileOutputCount = bootstrapCompileOutputCount + 1
        bootstrapCompileOutputBytes = nextBytes
    }
    valid
}

fun bootstrapCommitCompileOutputs(): bool {
    var committed = true
    var index = 0
    val root = bootstrapCompileOutputRoot()
    while (committed && index < bootstrapCompileOutputCount) {
        val pathFile = Path("$root/$index.path")
        val dataFile = Path("$root/$index.data")
        committed = pathFile.exists() && dataFile.exists()
        if (committed) committed = Path(pathFile.readText()).writeTextAtomic(
            dataFile.readText()
        )
        index = index + 1
    }
    bootstrapDiscardCompileOutputs()
    committed
}

class BootstrapEvalValue(
    val kind: string,
    val integer: int,
    val boolean: bool,
    val text: string,
    val elements: array<BootstrapEvalValue>,
    val owner: string,
    val fieldNames: array<string>
)

class BootstrapEvalResult(
    val value: BootstrapEvalValue,
    val errors: int,
    val diagnostics: string,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    val generatedDeclarations: array<BootstrapDeclaration>
)

fun bootstrapEvalInvalid(): BootstrapEvalValue =
    BootstrapEvalValue("invalid", 0, false, "", [], "", [])

fun bootstrapEvalInteger(value: int): BootstrapEvalValue =
    BootstrapEvalValue("integer", value, false, "", [], "", [])

fun bootstrapEvalBoolean(value: bool): BootstrapEvalValue =
    BootstrapEvalValue("boolean", 0, value, "", [], "", [])

fun bootstrapEvalString(value: string): BootstrapEvalValue =
    BootstrapEvalValue("string", 0, false, value, [], "", [])

fun bootstrapEvalNull(): BootstrapEvalValue =
    BootstrapEvalValue("null", 0, false, "", [], "", [])

fun bootstrapEvalVoid(): BootstrapEvalValue =
    BootstrapEvalValue("void", 0, false, "", [], "", [])

fun bootstrapEvalEqual(
    left: BootstrapEvalValue,
    right: BootstrapEvalValue
): bool {
    var equal = left.kind == right.kind
    if (left.kind == "integer") {
        equal = equal && left.integer == right.integer
    }
    if (left.kind == "boolean") {
        equal = equal && left.boolean == right.boolean
    }
    if (left.kind == "string") equal = equal && left.text == right.text
    if (left.kind == "shared" || left.kind == "weak") {
        equal = equal && left.elements[0] == right.elements[0]
    }
    equal
}

fun bootstrapEvalReturn(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("return", 0, false, "", [value], "", [])

fun bootstrapEvalLoopControl(kind: string): BootstrapEvalValue =
    BootstrapEvalValue(kind, 0, false, "", [], "", [])

fun bootstrapEvalFunction(name: string): BootstrapEvalValue =
    BootstrapEvalValue("function", 0, false, name, [], "", [])

fun bootstrapEvalClosure(
    expression: int,
    family: string,
    captures: array<BootstrapEvalValue>,
    names: array<string>
): BootstrapEvalValue = BootstrapEvalValue(
    "closure",
    expression,
    family == "once",
    "",
    captures,
    family,
    names
)

fun bootstrapEvalArray(
    elements: array<BootstrapEvalValue>
): BootstrapEvalValue = BootstrapEvalValue(
    "array",
    0,
    false,
    "",
    elements,
    "",
    []
)

fun bootstrapEvalObject(
    owner: string,
    fieldNames: array<string>,
    fields: array<BootstrapEvalValue>
): BootstrapEvalValue = BootstrapEvalValue(
    "object",
    0,
    false,
    "",
    fields,
    owner,
    fieldNames
)

fun bootstrapEvalShared(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = BootstrapEvalValue(
        "shared.control",
        0,
        false,
        "",
        [value, bootstrapEvalInteger(1), bootstrapEvalInteger(1)],
        "",
        []
    )
    BootstrapEvalValue("shared", 0, false, "", [control], "", [])
}

fun bootstrapEvalSharedClone(
    value: BootstrapEvalValue
): BootstrapEvalValue {
    val control = value.elements[0]
    control.elements[1] = bootstrapEvalInteger(
        control.elements[1].integer + 1
    )
    BootstrapEvalValue("shared", 0, false, "", [control], "", [])
}

fun bootstrapEvalBorrow(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("borrow", 0, false, "", [value], "", [])

fun bootstrapEvalCell(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("cell", 0, false, "", [value], "", [])

fun bootstrapEvalUnwrapBorrow(value: BootstrapEvalValue): BootstrapEvalValue =
    if (value.kind == "borrow" && value.elements.size == 1) value.elements[0]
    else value

fun bootstrapEvalValueNeedsBorrow(value: BootstrapEvalValue): bool =
    value.kind == "object" || value.kind == "array" ||
    value.kind == "string" || value.kind == "shared" ||
    value.kind == "weak" || value.kind == "closure" || value.kind == "cell"

fun bootstrapEvalSharedGet(value: BootstrapEvalValue): BootstrapEvalValue =
    bootstrapEvalBorrow(value.elements[0].elements[0])

fun bootstrapEvalWeak(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = value.elements[0]
    control.elements[2] = bootstrapEvalInteger(
        control.elements[2].integer + 1
    )
    BootstrapEvalValue("weak", 0, false, "", [control], "", [])
}

fun bootstrapEvalWeakClone(value: BootstrapEvalValue): BootstrapEvalValue =
    bootstrapEvalWeak(value)

fun bootstrapEvalWeakUpgrade(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = value.elements[0]
    var result = bootstrapEvalNull()
    if (control.elements[1].integer > 0) {
        control.elements[1] = bootstrapEvalInteger(
            control.elements[1].integer + 1
        )
        result = BootstrapEvalValue(
            "shared", 0, false, "", [control], "", []
        )
    }
    result
}

class BootstrapEvaluator(
    val declarations: array<BootstrapDeclaration>,
    val affineTypes: array<string>,
    val names: array<string>,
    val values: array<BootstrapEvalValue>,
    val mutable: array<bool>,
    val cursors: array<BootstrapSubparserCursor>,
    val syntax: array<BootstrapExpression>,
    val typedCalls: array<BootstrapTypedCall>,
    val reflectedTypes: array<string>,
    val generatedDeclarations: array<BootstrapDeclaration>,
    val extensionRequests: array<BootstrapExtensionRequest>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    val allowedCompileEffects: int,
    var errors: int,
    var steps: int,
    var diagnostics: string
) {
    fun recordEvaluatorDiagnostic(code: string, message: string): void {
        this.diagnostics =
            "${this.diagnostics}error[$code]: $message\n"
        bootstrapSemanticUnit()
    }

    fun functionHandleLimit(): int {
        var limit = this.declarations.size
        var declaration = 0
        while (declaration < this.declarations.size) {
            limit = limit + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        limit
    }

    fun recordInvalidFunctionHandle(operation: string, handle: int): void {
        val limit = this.functionHandleLimit()
        var classification = "wrong declaration kind"
        var code = "E_EXT_FUNCTION_HANDLE_WRONG_KIND"
        if (handle < 0) classification = "unknown"
        if (handle < 0) code = "E_EXT_FUNCTION_HANDLE_UNKNOWN"
        if (handle >= limit) {
            classification = "out of range"
            code = "E_EXT_FUNCTION_HANDLE_OUT_OF_RANGE"
        }
        val domain =
            "compilation-scoped function declaration handle in [0, $limit)"
        val message =
            "compiler API `$operation` received invalid function handle $handle ($classification; expected a $domain)"
        this.recordEvaluatorDiagnostic(code, message)
    }

    fun recordCompileInput(path: string, contents: string): void {
        var found = -1
        var index = 0
        while (index < this.compileInputPaths.size) {
            if (this.compileInputPaths[index] == path) found = index
            index = index + 1
        }
        if (found >= 0) {
            this.compileInputContents[found] = contents
        } else {
            this.compileInputPaths.append(path)
            this.compileInputContents.append(contents)
        }
    }

    fun uninitializedValue(): BootstrapEvalValue = BootstrapEvalValue(
        "uninitialized",
        0,
        false,
        "",
        [],
        "",
        []
    )

    fun directResourceHasDrop(value: BootstrapEvalValue): bool {
        var found = false
        if (value.kind == "object") {
            var declarationIndex = 0
            while (declarationIndex < this.declarations.size) {
                val declaration = this.declarations[declarationIndex]
                if (declaration.kind == "class" && declaration.isResource &&
                    declaration.name == value.owner) {
                    var methodIndex = 0
                    while (methodIndex < declaration.methods.size) {
                        if (declaration.methods[methodIndex].name == "drop") {
                            found = true
                        }
                        methodIndex = methodIndex + 1
                    }
                }
                declarationIndex = declarationIndex + 1
            }
        }
        found
    }

    fun valueIsAffine(value: BootstrapEvalValue): bool {
        var affine = value.kind == "object" &&
            bootstrapAffineNamesContain(this.affineTypes, value.owner)
        if (value.kind == "shared") affine = true
        if (value.kind == "weak") affine = true
        if (value.kind == "closure" &&
            (value.owner == "mut" || value.owner == "once")) affine = true
        if (value.kind == "array") {
            var element = 0
            while (element < value.elements.size && !affine) {
                affine = this.valueIsAffine(value.elements[element])
                element = element + 1
            }
        }
        affine
    }

    fun dropValue(var value: BootstrapEvalValue): void {
        if (value.kind == "shared" && value.elements.size == 1) {
            val control = value.elements[0]
            val next = control.elements[1].integer - 1
            control.elements[1] = bootstrapEvalInteger(next)
            if (next == 0 &&
                control.elements[0].kind != "uninitialized") {
                this.dropValue(control.elements[0])
                control.elements[0] = this.uninitializedValue()
                control.elements[2] = bootstrapEvalInteger(
                    control.elements[2].integer - 1
                )
            }
        }
        if (value.kind == "weak" && value.elements.size == 1) {
            val control = value.elements[0]
            control.elements[2] = bootstrapEvalInteger(
                control.elements[2].integer - 1
            )
        }
        if (value.kind == "closure" &&
            (value.owner == "mut" || value.owner == "once")) {
            var capture = value.elements.size
            while (capture > 0) {
                capture = capture - 1
                if (value.elements[capture].kind != "uninitialized") {
                    this.dropValue(value.elements[capture])
                    value.elements[capture] = this.uninitializedValue()
                }
            }
        }
        if (value.kind == "array" && this.valueIsAffine(value)) {
            var element = value.elements.size
            while (element > 0) {
                element = element - 1
                if (value.elements[element].kind != "uninitialized") {
                    this.dropValue(value.elements[element])
                    value.elements[element] = this.uninitializedValue()
                }
            }
        }
        if (value.kind == "object" &&
            bootstrapAffineNamesContain(this.affineTypes, value.owner)) {
            if (this.directResourceHasDrop(value)) {
                this.evaluateMethod(value, BootstrapExpression(
                    "member.call",
                    "drop",
                    0,
                    0,
                    []
                ))
            }
            var field = value.elements.size
            while (field > 0) {
                field = field - 1
                if (value.elements[field].kind != "uninitialized") {
                    this.dropValue(value.elements[field])
                    value.elements[field] = this.uninitializedValue()
                }
            }
        }
    }

    fun dropOwnedParameters(
        parameterKinds: array<string>,
        returned: BootstrapEvalValue,
        offset: int
    ): void {
        var parameter = parameterKinds.size
        while (parameter > 0) {
            parameter = parameter - 1
            val valueIndex = parameter + offset
            if (parameterKinds[parameter] == "own" &&
                valueIndex < this.values.size &&
                this.values[valueIndex].kind != "uninitialized" &&
                this.values[valueIndex] != returned) {
                val owned = this.values[valueIndex]
                this.dropValue(owned)
                this.values[valueIndex] = this.uninitializedValue()
            }
        }
    }

    fun find(name: string): int {
        var result = -1
        var index = 0
        while (index < this.names.size) {
            if (this.names[index] == name) result = index
            index = index + 1
        }
        result
    }

    fun printable(value: BootstrapEvalValue): string {
        var result = value.text
        if (value.kind == "integer") result = "${value.integer}"
        if (value.kind == "boolean") {
            result = if (value.boolean) "true" else "false"
        }
        if (value.kind == "null") result = "null"
        result
    }

    fun syntaxValue(expression: BootstrapExpression): BootstrapEvalValue {
        val handle = this.syntax.size
        this.syntax.append(expression)
        BootstrapEvalValue("syntax", handle, false, "", [], "", [])
    }

    fun reflectedTypeHandle(type: string): int {
        val normalized = bootstrapNormalizeType(type)
        var found = -1
        var index = 0
        while (index < this.reflectedTypes.size) {
            if (this.reflectedTypes[index] == normalized) found = index
            index = index + 1
        }
        if (found < 0 && normalized != "" && normalized != "unknown" &&
            this.reflectedTypes.size < 4096) {
            this.reflectedTypes.append(normalized)
            found = this.reflectedTypes.size - 1
        }
        found
    }

    fun reflectedTypeValid(handle: int): bool =
        handle >= 0 && handle < this.reflectedTypes.size

    fun reflectedTypeKind(type: string): string {
        var kind = "nominal"
        if (type == "void" || type == "never" || type == "null" ||
            type == "bool" || type == "char" || type == "string" ||
            type == "i8" || type == "i16" || type == "i32" ||
            type == "i64" || type == "u8" || type == "u16" ||
            type == "u32" || type == "u64" || type == "f32" ||
            type == "f64") kind = "primitive"
        if (bootstrapIsNullableType(type)) kind = "nullable"
        if (bootstrapIsArrayType(type)) kind = "array"
        if (bootstrapIsSharedType(type)) kind = "shared"
        if (bootstrapIsWeakType(type)) kind = "weak"
        if (bootstrapIsMutexType(type)) kind = "mutex"
        if (bootstrapIsBorrowType(type)) kind = "borrow"
        if (bootstrapIsFunctionType(type)) kind = "function"
        if (bootstrapIsOnceFunctionType(type)) kind = "function.once"
        if (bootstrapIsMutableFunctionType(type)) kind = "function.mutable"
        if (type.size > 0 && type[type.size - 1] == 42) kind = "pointer"
        kind
    }

    fun reflectedTypeElement(type: string): string {
        var element = "unknown"
        if (bootstrapIsNullableType(type)) {
            element = bootstrapNullableElementType(type)
        }
        if (bootstrapIsArrayType(type)) element = bootstrapArrayElementType(type)
        if (bootstrapIsSharedType(type)) element = bootstrapSharedElementType(type)
        if (bootstrapIsWeakType(type)) element = bootstrapWeakElementType(type)
        if (bootstrapIsMutexType(type)) element = bootstrapMutexElementType(type)
        if (bootstrapIsBorrowType(type)) element = bootstrapBorrowElementType(type)
        if (type.size > 0 && type[type.size - 1] == 42) {
            element = type.slice(0, type.size - 1)
        }
        element
    }

    fun generatedIdentifierPart(text: string): string {
        var result = ""
        var index = 0
        while (index < text.size) {
            val byte = text[index]
            if ((byte >= 65 && byte <= 90) ||
                (byte >= 97 && byte <= 122) ||
                (byte >= 48 && byte <= 57) || byte == 95) {
                result = "$result${text.slice(index, index + 1)}"
            } else result = "${result}_"
            index = index + 1
        }
        if (result == "") result = "generated"
        result
    }

    fun generatedStringLiteral(text: string): string {
        var result = "\""
        var index = 0
        while (index < text.size) {
            val byte = text[index]
            if (byte == 34) result = "${result}\\\""
            else if (byte == 92) result = "${result}\\\\"
            else if (byte == 10) result = "${result}\\n"
            else if (byte == 13) result = "${result}\\r"
            else if (byte == 9) result = "${result}\\t"
            else result = "$result${text.slice(index, index + 1)}"
            index = index + 1
        }
        "$result\""
    }

    fun generatedSyntaxSource(
        expression: BootstrapExpression,
        depth: int
    ): string {
        var result = ""
        if (depth <= 128) {
        if (expression.kind == "integer") result = expression.text
        if (expression.kind == "string") {
            result = this.generatedStringLiteral(expression.text)
        }
        if (expression.kind == "identifier") result = expression.text
        if (expression.kind == "true" || expression.kind == "false" ||
            expression.kind == "null") result = expression.kind
        if (expression.kind == "if" && expression.children.size == 3) {
            result = "if (${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}) ${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )} else ${this.generatedSyntaxSource(
                expression.children[2], depth + 1
            )}"
        }
        if (expression.kind == "array") {
            result = "["
            var element = 0
            while (element < expression.children.size) {
                if (element > 0) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[element], depth + 1
                )}"
                element = element + 1
            }
            result = "$result]"
        }
        if (expression.kind == "call") {
            var name = expression.text
            if (expression.begin < 0) {
                val handle = 0 - expression.begin - 1
                if (this.functionHandleValid(handle)) {
                    val owner = this.functionHandleOwner(handle)
                    if (owner < 0) name = this.declarations[handle].name
                }
            }
            result = "$name("
            var argument = 0
            while (argument < expression.children.size) {
                if (argument > 0) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[argument], depth + 1
                )}"
                argument = argument + 1
            }
            result = "$result)"
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}.${expression.text}("
            var argument = 1
            while (argument < expression.children.size) {
                if (argument > 1) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[argument], depth + 1
                )}"
                argument = argument + 1
            }
            result = "$result)"
        }
        if (expression.kind == "member" && expression.children.size == 1) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}.${expression.text}"
        }
        if (expression.kind == "index" && expression.children.size == 2) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}[${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )}]"
        }
        if (expression.children.size == 2 && expression.text != "" &&
            result == "") {
            result = "(${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )} ${expression.text} ${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )})"
        }
        if (expression.kind == "return") {
            result = "return"
            if (expression.children.size > 0) {
                result = "$result ${this.generatedSyntaxSource(
                    expression.children[0], depth + 1
                )}"
            }
        }
        if (expression.kind == "assign" &&
            expression.children.size == 1) {
            result = "${expression.text} = ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if ((expression.kind == "local.val" ||
             expression.kind == "local.var") &&
            expression.children.size > 0) {
            val keyword = if (expression.kind == "local.val") "val" else "var"
            result = "$keyword ${expression.text}"
            if (expression.children.size > 1 &&
                expression.children[1].text != "inferred") {
                result = "$result: ${expression.children[1].text}"
            }
            result = "$result = ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if (expression.kind == "block") {
            result = "{\n"
            var statement = 0
            while (statement < expression.children.size) {
                result = "$result${this.generatedSyntaxSource(
                    expression.children[statement], depth + 1
                )}\n"
                statement = statement + 1
            }
            result = "$result}"
        }
        if ((expression.kind == "lambda" ||
             expression.kind == "lambda.move") &&
            expression.children.size > 0) {
            result = ""
            if (expression.kind == "lambda.move") result = "move "
            result = "$result{"
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                if (parameter > 0) result = "$result, "
                val found = expression.children[parameter]
                result = "$result${found.text}: ${found.children[0].text}"
                parameter = parameter + 1
            }
            result = "$result -> ${this.generatedSyntaxSource(
                expression.children[expression.children.size - 1],
                depth + 1
            )}}"
        }
        }
        result
    }

    fun generatedDeclarationName(
        module: BootstrapEvalValue,
        hint: string
    ): string {
        val namespace = this.generatedIdentifierPart(module.text)
        val readable = this.generatedIdentifierPart(hint)
        val base = "__abla_generated_${namespace}_${module.integer}_${module.elements.size}_${readable}"
        var result = base
        var suffix = 0
        var collision = true
        while (collision && suffix < 1024) {
            collision = false
            var declaration = 0
            while (declaration < this.declarations.size) {
                if (this.declarations[declaration].name == result) {
                    collision = true
                }
                declaration = declaration + 1
            }
            var generated = 0
            while (generated < module.fieldNames.size) {
                if (module.fieldNames[generated] == result) collision = true
                generated = generated + 1
            }
            if (collision) {
                suffix = suffix + 1
                result = "${base}_$suffix"
            }
        }
        if (collision) "" else result
    }

    fun generatedExportName(
        module: BootstrapEvalValue,
        name: string
    ): string {
        var available = name != "" &&
            this.generatedIdentifierPart(name) == name
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].name == name) available = false
            declaration = declaration + 1
        }
        var generated = 0
        while (generated < module.fieldNames.size) {
            if (module.fieldNames[generated] == name) available = false
            generated = generated + 1
        }
        if (available) name else ""
    }

    fun methodHandle(owner: int, method: int): int {
        var handle = this.declarations.size
        var declaration = 0
        while (declaration < owner) {
            handle = handle + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        handle + method
    }

    fun functionHandleOwner(handle: int): int {
        var owner = -1
        if (handle >= this.declarations.size) {
            var cursor = this.declarations.size
            var declaration = 0
            while (owner < 0 && declaration < this.declarations.size) {
                val next = cursor +
                    this.declarations[declaration].methods.size
                if (handle >= cursor && handle < next) owner = declaration
                cursor = next
                declaration = declaration + 1
            }
        }
        owner
    }

    fun functionHandleMethod(handle: int): int {
        val owner = this.functionHandleOwner(handle)
        var method = -1
        if (owner >= 0) method = handle - this.methodHandle(owner, 0)
        method
    }

    fun functionHandleValid(handle: int): bool {
        var valid = handle >= 0 && handle < this.declarations.size &&
            (this.declarations[handle].kind == "fun" ||
             this.declarations[handle].kind == "compile.fun" ||
             this.declarations[handle].kind == "extern")
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size) valid = true
        valid
    }

    fun functionHandleResultType(handle: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size) {
            result = bootstrapNormalizeType(
                this.declarations[handle].resultType
            )
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size) {
            result = bootstrapNormalizeType(
                this.declarations[owner].methods[method].resultType
            )
        }
        result
    }

    fun generatedDeclarationCount(module: BootstrapEvalValue): int {
        var count = 0
        var element = 0
        if (module.kind == "generated.module") {
            while (element < module.elements.size) {
                if (module.elements[element].kind ==
                    "generated.declaration") count = count + 1
                element = element + 1
            }
        }
        count
    }

    fun generatedDeclarationAt(
        module: BootstrapEvalValue,
        ordinal: int
    ): int {
        var result = -1
        var current = 0
        var element = 0
        if (module.kind == "generated.module" && ordinal >= 0) {
            while (element < module.elements.size) {
                val candidate = module.elements[element]
                if (candidate.kind == "generated.declaration") {
                    if (current == ordinal) result = candidate.integer
                    current = current + 1
                }
                element = element + 1
            }
        }
        if (result < 0 || result >= this.generatedDeclarations.size) {
            result = -1
        }
        result
    }

    fun functionHandleParameterType(handle: int, parameter: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size && parameter >= 0 &&
            parameter < this.declarations[handle].parameterTypes.size) {
            result = bootstrapNormalizeType(
                this.declarations[handle].parameterTypes[parameter]
            )
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size && parameter >= 0 &&
            parameter <
                this.declarations[owner].methods[method].parameterTypes.size) {
            result = bootstrapNormalizeType(
                this.declarations[owner].methods[method].parameterTypes[parameter]
            )
        }
        result
    }

    fun functionHandleParameterKind(handle: int, parameter: int): string {
        var result = "parameter"
        if (handle >= 0 && handle < this.declarations.size && parameter >= 0 &&
            parameter < this.declarations[handle].parameterKinds.size) {
            result = this.declarations[handle].parameterKinds[parameter]
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size && parameter >= 0 &&
            parameter <
                this.declarations[owner].methods[method].parameterKinds.size) {
            val declaration = this.declarations[owner].methods[method]
            result = declaration.parameterKinds[parameter]
        }
        result
    }

    fun functionHandleDeclaration(handle: int): BootstrapDeclaration {
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0) {
            this.declarations[owner].methods[method]
        } else this.declarations[handle]
    }

    fun classFieldType(handle: int, wanted: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size &&
            this.declarations[handle].kind == "class" && wanted >= 0) {
            val declaration = this.declarations[handle]
            var field = 0
            var parameter = 0
            while (parameter < declaration.parameterKinds.size) {
                if (declaration.parameterKinds[parameter] == "val" ||
                    declaration.parameterKinds[parameter] == "var") {
                    if (field == wanted &&
                        parameter < declaration.parameterTypes.size) {
                        result = bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                    }
                    field = field + 1
                }
                parameter = parameter + 1
            }
        }
        result
    }

    fun lexicalTypeInExpression(
        container: BootstrapExpression,
        name: string,
        position: int,
        depth: int
    ): string {
        var result = "unknown"
        if (depth < 32 && container.kind == "block") {
            var child = 0
            while (child < container.children.size) {
                val statement = container.children[child]
                if ((statement.kind == "local.val" ||
                     statement.kind == "local.var") &&
                    statement.text == name && statement.begin < position) {
                    if (statement.children.size > 1 &&
                        statement.children[1].text != "inferred") {
                        result = bootstrapNormalizeType(
                            statement.children[1].text
                        )
                    } else if (statement.children.size > 0) {
                        result = this.staticSyntaxTypeAt(
                            statement.children[0], depth + 1
                        )
                    }
                }
                if (statement.begin <= position &&
                    statement.end >= position) {
                    val nested = this.lexicalTypeInExpression(
                        statement, name, position, depth + 1
                    )
                    if (nested != "unknown") result = nested
                }
                child = child + 1
            }
        } else if (depth < 32 &&
            container.begin <= position && container.end >= position) {
            if (container.kind == "lambda" ||
                container.kind == "lambda.move") {
                var parameter = 0
                while (parameter + 1 < container.children.size) {
                    val found = container.children[parameter]
                    if (found.kind == "lambda.parameter" &&
                        found.text == name && found.children.size > 0) {
                        result = bootstrapNormalizeType(
                            found.children[0].text
                        )
                    }
                    parameter = parameter + 1
                }
            }
            var child = 0
            while (child < container.children.size) {
                val nested = this.lexicalTypeInExpression(
                    container.children[child],
                    name,
                    position,
                    depth + 1
                )
                if (nested != "unknown") result = nested
                child = child + 1
            }
        }
        result
    }

    fun lexicalSyntaxType(name: string, position: int, depth: int): string {
        var result = "unknown"
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (candidate.expression.begin <= position &&
                candidate.expression.end >= position) {
                var parameter = 0
                while (parameter < candidate.parameters.size &&
                    parameter < candidate.parameterTypes.size) {
                    if (candidate.parameters[parameter] == name) {
                        result = bootstrapNormalizeType(
                            candidate.parameterTypes[parameter]
                        )
                    }
                    parameter = parameter + 1
                }
                if (candidate.extensionOwner != "" && name == "this") {
                    result = bootstrapNormalizeType(candidate.extensionOwner)
                }
                val local = this.lexicalTypeInExpression(
                    candidate.expression,
                    name,
                    position,
                    depth
                )
                if (local != "unknown") result = local
            }
            var method = 0
            while (method < candidate.methods.size) {
                val member = candidate.methods[method]
                if (member.expression.begin <= position &&
                    member.expression.end >= position) {
                    if (name == "this") result = candidate.name
                    var parameter = 0
                    while (parameter < member.parameters.size &&
                        parameter < member.parameterTypes.size) {
                        if (member.parameters[parameter] == name) {
                            result = bootstrapNormalizeType(
                                member.parameterTypes[parameter]
                            )
                        }
                        parameter = parameter + 1
                    }
                    val local = this.lexicalTypeInExpression(
                        member.expression,
                        name,
                        position,
                        depth
                    )
                    if (local != "unknown") result = local
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
        result
    }

    fun directCallTarget(
        expression: BootstrapExpression,
        depth: int
    ): int {
        var handle = -1
        if ((expression.kind == "call" ||
             expression.kind == "member.call") && expression.begin < 0) {
            val marked = 0 - expression.begin - 1
            if (this.functionHandleValid(marked)) handle = marked
        }
        if (handle < 0 && expression.kind == "call") {
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun" ||
                     candidate.kind == "extern") &&
                    candidate.name == expression.text) {
                    if (handle >= 0) handle = -2
                    if (handle == -1) handle = declaration
                }
                declaration = declaration + 1
            }
        }
        if (handle < 0 && expression.kind == "member.call" &&
            expression.children.size > 0) {
            val receiver = bootstrapBorrowElementType(
                this.staticSyntaxTypeAt(expression.children[0], depth + 1)
            )
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (bootstrapNormalizeType(candidate.extensionOwner) ==
                    receiver && candidate.name == expression.text) {
                    if (handle >= 0) handle = -2
                    if (handle == -1) handle = declaration
                }
                if (candidate.kind == "class" &&
                    candidate.name == receiver) {
                    var method = 0
                    while (method < candidate.methods.size) {
                        if (candidate.methods[method].name == expression.text) {
                            if (handle >= 0) handle = -2
                            if (handle == -1) {
                                handle = this.methodHandle(declaration, method)
                            }
                        }
                        method = method + 1
                    }
                }
                declaration = declaration + 1
            }
        }
        handle
    }

    fun staticSyntaxTypeAt(
        expression: BootstrapExpression,
        depth: int
    ): string {
        var result = "unknown"
        if (depth >= 8) result = "unknown"
        if (expression.kind == "integer") result = "i64"
        if (expression.kind == "true" || expression.kind == "false") {
            result = "bool"
        }
        if (expression.kind == "string") result = "string"
        if (expression.kind == "null") result = "null"
        if (expression.kind == "+" || expression.kind == "-" ||
            expression.kind == "*" || expression.kind == "/") {
            result = "i64"
        }
        if (expression.kind == "==" || expression.kind == "!=" ||
            expression.kind == "<" || expression.kind == "<=" ||
            expression.kind == ">" || expression.kind == ">=") {
            result = "bool"
        }
        if (depth < 8 && expression.kind == "identifier") {
            result = this.lexicalSyntaxType(
                expression.text,
                expression.begin,
                depth + 1
            )
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if ((candidate.kind == "val" || candidate.kind == "var") &&
                    candidate.name == expression.text && result == "unknown") {
                    if (candidate.resultType == "inferred") {
                        result = this.staticSyntaxTypeAt(
                            candidate.expression,
                            depth + 1
                        )
                    } else result = bootstrapNormalizeType(
                        candidate.resultType
                    )
                }
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun" ||
                    candidate.kind == "extern") &&
                    candidate.name == expression.text && result == "unknown") {
                    result = bootstrapDeclarationFunctionType(candidate)
                }
                declaration = declaration + 1
            }
        }
        if (depth < 8 && expression.kind == "array") {
            var elementType = "unknown"
            var element = 0
            while (element < expression.children.size) {
                val found = this.staticSyntaxTypeAt(
                    expression.children[element], depth + 1
                )
                if (elementType == "unknown") elementType = found
                if (elementType != found) elementType = "unknown"
                element = element + 1
            }
            result = "array:$elementType"
        }
        if (depth < 8 && expression.kind == "member" &&
            expression.children.size > 0) {
            val receiver = bootstrapBorrowElementType(
                this.staticSyntaxTypeAt(expression.children[0], depth + 1)
            )
            if (expression.text == "size" &&
                (receiver == "string" || bootstrapIsArrayType(receiver))) {
                result = "i64"
            }
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (candidate.kind == "class" &&
                    candidate.name == receiver) {
                    var field = 0
                    while (field < candidate.parameters.size) {
                        if (candidate.parameters[field] == expression.text &&
                            field < candidate.parameterKinds.size &&
                            (candidate.parameterKinds[field] == "val" ||
                             candidate.parameterKinds[field] == "var") &&
                            field < candidate.parameterTypes.size) {
                            result = bootstrapNormalizeType(
                                candidate.parameterTypes[field]
                            )
                        }
                        field = field + 1
                    }
                }
                declaration = declaration + 1
            }
        }
        if (depth < 8) {
            val target = this.directCallTarget(expression, depth)
            if (target >= 0) result = this.functionHandleResultType(target)
            if (expression.kind == "call" && target < 0) {
                var declaration = 0
                while (declaration < this.declarations.size) {
                    if (this.declarations[declaration].kind == "class" &&
                        this.declarations[declaration].name == expression.text) {
                        result = this.declarations[declaration].name
                    }
                    declaration = declaration + 1
                }
            }
        }
        result
    }

    fun staticSyntaxType(expression: BootstrapExpression): string =
        this.staticSyntaxTypeAt(expression, 0)

    fun typedCallIndex(expression: BootstrapExpression): int {
        var result = -1
        var index = 0
        while (result < 0 && index < this.typedCalls.size) {
            val candidate = this.typedCalls[index]
            if (candidate.begin == expression.begin &&
                candidate.end == expression.end &&
                candidate.kind == expression.kind &&
                candidate.name == expression.text) result = index
            index = index + 1
        }
        result
    }

    fun appendUniqueName(var names: array<string>, name: string): void {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        if (!found) names.append(name)
    }

    fun collectLambdaLocals(
        expression: BootstrapExpression,
        var names: array<string>
    ): void {
        if (expression.kind == "local.val" ||
            expression.kind == "local.var") {
            this.appendUniqueName(names, expression.text)
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (child < expression.children.size) {
                this.collectLambdaLocals(expression.children[child], names)
                child = child + 1
            }
        }
    }

    fun nameIsBound(names: array<string>, name: string): bool {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun collectLambdaFreeNames(
        expression: BootstrapExpression,
        bound: array<string>,
        var free: array<string>
    ): void {
        var nested = false
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            nested = true
            val nestedBound: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nestedBound.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                this.appendUniqueName(
                    nestedBound,
                    expression.children[parameter].text
                )
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaLocals(body, nestedBound)
            this.collectLambdaFreeNames(body, nestedBound, free)
        }
        if (!nested) {
            if (expression.kind == "identifier" &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            if ((expression.kind == "call" ||
                 expression.kind == "assign") &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            var child = 0
            while (child < expression.children.size) {
                this.collectLambdaFreeNames(
                    expression.children[child],
                    bound,
                    free
                )
                child = child + 1
            }
        }
    }

    fun lambdaMutatesCapturedPlace(
        expression: BootstrapExpression,
        bound: array<string>
    ): bool {
        var mutates = false
        if (expression.kind == "assign" &&
            !this.nameIsBound(bound, expression.text) &&
            (this.find(expression.text) >= 0 ||
             this.find("this") >= 0)) mutates = true
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.nameIsBound(bound, root) &&
                this.find(root) >= 0) mutates = true
        }
        if (expression.kind == "call" &&
            !this.nameIsBound(bound, expression.text)) {
            val target = this.find(expression.text)
            if (target >= 0 && this.values[target].kind == "closure" &&
                this.values[target].owner == "mut") mutates = true
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (!mutates && child < expression.children.size) {
                mutates = this.lambdaMutatesCapturedPlace(
                    expression.children[child],
                    bound
                )
                child = child + 1
            }
        }
        mutates
    }

    fun lambdaRequiresMutableCall(
        expression: BootstrapExpression
    ): bool {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        this.collectLambdaLocals(body, bound)
        this.lambdaMutatesCapturedPlace(body, bound)
    }

    fun evaluateCall(expression: BootstrapExpression): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        var targetName = expression.text
        val target = this.find(expression.text)
        var callable = bootstrapEvalInvalid()
        if (target >= 0) callable = this.values[target]
        if (target < 0) {
            var global = 0
            while (callable.kind == "invalid" &&
                   global < this.declarations.size) {
                val declaration = this.declarations[global]
                if ((declaration.kind == "val" ||
                     declaration.kind == "var") &&
                    declaration.name == expression.text) {
                    callable = this.evaluate(declaration.expression)
                }
                global = global + 1
            }
        }
        if (callable.kind == "function") targetName = callable.text
        if (callable.kind == "closure") {
            val closure = callable
            val lambda = this.syntax[closure.integer]
            val callNames: array<string> = []
            val callValues: array<BootstrapEvalValue> = []
            val callMutable: array<bool> = []
            var capture = 0
            while (capture < closure.fieldNames.size) {
                callNames.append(closure.fieldNames[capture])
                callValues.append(closure.elements[capture])
                callMutable.append(closure.owner == "mut")
                capture = capture + 1
            }
            var parameter = 0
            while (parameter + 1 < lambda.children.size) {
                callNames.append(lambda.children[parameter].text)
                var argumentValue = bootstrapEvalInvalid()
                if (parameter < expression.children.size) {
                    argumentValue = this.evaluate(
                        expression.children[parameter]
                    )
                    bootstrapSemanticUnit()
                } else {
                    this.errors = this.errors + 1
                    bootstrapSemanticUnit()
                }
                callValues.append(argumentValue)
                callMutable.append(false)
                parameter = parameter + 1
            }
            val invocation = BootstrapEvaluator(
                this.declarations,
                this.affineTypes,
                callNames,
                callValues,
                callMutable,
                this.cursors,
                this.syntax,
                this.typedCalls,
                this.reflectedTypes,
                this.generatedDeclarations,
                this.extensionRequests,
                this.compileInputPaths,
                this.compileInputContents,
                this.allowedCompileEffects,
                this.errors,
                this.steps,
                this.diagnostics
            )
            result = invocation.evaluate(
                lambda.children[lambda.children.size - 1]
            )
            if (result.kind == "return" && result.elements.size == 1) {
                result = result.elements[0]
            }
            if (closure.boolean) {
                capture = closure.elements.size
                while (capture > 0) {
                    capture = capture - 1
                    val captured = invocation.values[capture]
                    if (captured.kind != "uninitialized" &&
                        captured != result) {
                        invocation.dropValue(captured)
                    }
                    invocation.values[capture] =
                        invocation.uninitializedValue()
                    closure.elements[capture] = this.uninitializedValue()
                }
                if (target >= 0) {
                    this.values[target] = this.uninitializedValue()
                }
            }
            this.errors = invocation.errors
            this.steps = invocation.steps
            this.diagnostics = invocation.diagnostics
        }
        // Compiler reflection handles are declaration indexes. They are
        // stable for one compilation and need no host state, so reflection
        // works identically in the self-hosted compile-time evaluator.
        if (targetName == "compilerFindType") {
            val name = this.evaluate(expression.children[0])
            result = bootstrapEvalInteger(this.reflectedTypeHandle(name.text))
        }
        if (targetName == "typedExpressionTypeHandle") {
            val syntaxHandle = this.evaluate(expression.children[0]).integer
            if (syntaxHandle >= 0 && syntaxHandle < this.syntax.size) {
                val syntaxExpression = this.syntax[syntaxHandle]
                val typed = this.typedCallIndex(syntaxExpression)
                var type = this.staticSyntaxType(syntaxExpression)
                if (typed >= 0) type = this.typedCalls[typed].type
                if ((syntaxExpression.kind == "call" ||
                     syntaxExpression.kind == "member.call") && typed < 0) {
                    this.errors = this.errors + 1
                } else result = bootstrapEvalInteger(
                    this.reflectedTypeHandle(type)
                )
            } else this.errors = this.errors + 1
        }
        if (targetName == "compilerFunctionParameterTypeHandle") {
            val handle = this.evaluate(expression.children[0]).integer
            val parameter = this.evaluate(expression.children[1]).integer
            val type = this.functionHandleParameterType(handle, parameter)
            val typeHandle = this.reflectedTypeHandle(type)
            if (this.functionHandleValid(handle) && typeHandle >= 0) {
                result = bootstrapEvalInteger(typeHandle)
            } else this.errors = this.errors + 1
        }
        if (targetName == "compilerFunctionResultTypeHandle") {
            val handle = this.evaluate(expression.children[0]).integer
            val typeHandle = this.reflectedTypeHandle(
                this.functionHandleResultType(handle)
            )
            if (this.functionHandleValid(handle) && typeHandle >= 0) {
                result = bootstrapEvalInteger(typeHandle)
            } else this.errors = this.errors + 1
        }
        if (targetName == "compilerClassFieldTypeHandle") {
            val handle = this.evaluate(expression.children[0]).integer
            val field = this.evaluate(expression.children[1]).integer
            val typeHandle = this.reflectedTypeHandle(
                this.classFieldType(handle, field)
            )
            if (typeHandle >= 0) result = bootstrapEvalInteger(typeHandle)
            else this.errors = this.errors + 1
        }
        if (targetName == "compilerTypeName" ||
            targetName == "compilerTypeKind" ||
            targetName == "compilerTypeIsNullable" ||
            targetName == "compilerTypeIsAffine" ||
            targetName == "compilerTypeArgumentCount" ||
            targetName == "compilerTypeElement" ||
            targetName == "compilerTypeResult" ||
            targetName == "compilerTypeDeclaration") {
            val handle = this.evaluate(expression.children[0]).integer
            if (this.reflectedTypeValid(handle)) {
                val type = this.reflectedTypes[handle]
                val kind = this.reflectedTypeKind(type)
                if (targetName == "compilerTypeName") {
                    result = bootstrapEvalString(type)
                }
                if (targetName == "compilerTypeKind") {
                    result = bootstrapEvalString(kind)
                }
                if (targetName == "compilerTypeIsNullable") {
                    result = bootstrapEvalBoolean(bootstrapIsNullableType(type))
                }
                if (targetName == "compilerTypeIsAffine") {
                    result = bootstrapEvalBoolean(bootstrapSummaryTypeIsAffine(
                        type,
                        this.affineTypes
                    ))
                }
                if (targetName == "compilerTypeArgumentCount") {
                    var count = 0
                    if (kind == "nullable" || kind == "array" ||
                        kind == "shared" || kind == "weak" ||
                        kind == "mutex" || kind == "borrow" ||
                        kind == "pointer") count = 1
                    if (bootstrapIsFunctionType(type)) {
                        count = bootstrapFunctionParameterCount(type)
                    }
                    result = bootstrapEvalInteger(count)
                }
                if (targetName == "compilerTypeElement") {
                    val element = this.reflectedTypeHandle(
                        this.reflectedTypeElement(type)
                    )
                    if (element >= 0) result = bootstrapEvalInteger(element)
                    else this.errors = this.errors + 1
                }
                if (targetName == "compilerTypeResult") {
                    val resultType = this.reflectedTypeHandle(
                        bootstrapFunctionResultType(type)
                    )
                    if (bootstrapIsFunctionType(type) && resultType >= 0) {
                        result = bootstrapEvalInteger(resultType)
                    } else this.errors = this.errors + 1
                }
                if (targetName == "compilerTypeDeclaration") {
                    var declaration = -1
                    var candidate = 0
                    while (candidate < this.declarations.size) {
                        if (this.declarations[candidate].kind == "class" &&
                            bootstrapNormalizeType(
                                this.declarations[candidate].name
                            ) == type) declaration = candidate
                        candidate = candidate + 1
                    }
                    result = bootstrapEvalInteger(declaration)
                }
            } else this.errors = this.errors + 1
        }
        if (targetName == "compilerTypeArgument") {
            val handle = this.evaluate(expression.children[0]).integer
            val argument = this.evaluate(expression.children[1]).integer
            if (this.reflectedTypeValid(handle)) {
                val type = this.reflectedTypes[handle]
                var argumentType = "unknown"
                val kind = this.reflectedTypeKind(type)
                if (argument == 0 && (kind == "nullable" || kind == "array" ||
                    kind == "shared" || kind == "weak" || kind == "mutex" ||
                    kind == "borrow" || kind == "pointer")) {
                    argumentType = this.reflectedTypeElement(type)
                }
                if (bootstrapIsFunctionType(type) && argument >= 0 &&
                    argument < bootstrapFunctionParameterCount(type)) {
                    argumentType = bootstrapFunctionParameterType(type, argument)
                }
                val argumentHandle = this.reflectedTypeHandle(argumentType)
                if (argumentHandle >= 0) {
                    result = bootstrapEvalInteger(argumentHandle)
                } else this.errors = this.errors + 1
            } else this.errors = this.errors + 1
        }
        if (targetName == "compilerFunctions") {
            val handles: array<BootstrapEvalValue> = []
            var declarationIndex = 0
            while (declarationIndex < this.declarations.size) {
                val declaration = this.declarations[declarationIndex]
                if (declaration.kind == "fun" ||
                    declaration.kind == "compile.fun") {
                    handles.append(bootstrapEvalInteger(declarationIndex))
                }
                var method = 0
                while (method < declaration.methods.size) {
                    handles.append(bootstrapEvalInteger(
                        this.methodHandle(declarationIndex, method)
                    ))
                    method = method + 1
                }
                declarationIndex = declarationIndex + 1
            }
            result = bootstrapEvalArray(handles)
        }
        if (targetName == "ablaRuntimeMemoryCollect") {
            // The tree evaluator uses host-managed BootstrapEvalValue graphs;
            // native collection belongs to the generated program. Treat the
            // explicit safe point as a successful no-op while staging.
            result = bootstrapEvalInteger(0)
        }
        if (targetName == "compilerFindFunction") {
            val name = this.evaluate(expression.children[0])
            var handle = -1
            var declarationIndex = 0
            while (declarationIndex < this.declarations.size) {
                val declaration = this.declarations[declarationIndex]
                if ((declaration.kind == "fun" ||
                     declaration.kind == "compile.fun" ||
                     declaration.kind == "extern") &&
                    declaration.name == name.text) handle = declarationIndex
                var method = 0
                while (method < declaration.methods.size) {
                    if ("${declaration.name}.${declaration.methods[method].name}" ==
                        name.text) {
                        handle = this.methodHandle(declarationIndex, method)
                    }
                    method = method + 1
                }
                declarationIndex = declarationIndex + 1
            }
            result = bootstrapEvalInteger(handle)
        }
        if (targetName == "compilerFunctionName" ||
            targetName == "compilerFunctionCanonicalIdentity" ||
            targetName == "compilerFunctionOwner" ||
            targetName == "compilerFunctionParameterCount" ||
            targetName == "compilerFunctionParameterName" ||
            targetName == "compilerFunctionParameterType" ||
            targetName == "compilerFunctionResultType" ||
            targetName == "compilerFunctionIsCompileOnly" ||
            targetName == "compilerFunctionIsTrusted" ||
            targetName == "compilerFunctionIsExternal") {
            val handle = this.evaluate(expression.children[0]).integer
            val validHandle = this.functionHandleValid(handle)
            if (validHandle) {
                val owner = this.functionHandleOwner(handle)
                val method = this.functionHandleMethod(handle)
                var declarationIndex = handle
                if (owner >= 0) declarationIndex = owner
                var declaration = this.declarations[declarationIndex]
                if (owner >= 0) {
                    declaration = this.declarations[owner].methods[method]
                }
                if (targetName == "compilerFunctionName") {
                    result = bootstrapEvalString(declaration.name)
                }
                if (targetName == "compilerFunctionOwner") {
                    var ownerName = declaration.extensionOwner
                    if (owner >= 0) {
                        ownerName = this.declarations[owner].name
                    }
                    result = bootstrapEvalString(ownerName)
                }
                if (targetName == "compilerFunctionCanonicalIdentity") {
                    var identity = declaration.name
                    if (owner >= 0) {
                        identity = "${this.declarations[owner].name}.${declaration.name}"
                    } else if (declaration.extensionOwner != "") {
                        identity = "${bootstrapNormalizeType(
                            declaration.extensionOwner
                        )}.${declaration.name}"
                    }
                    result = bootstrapEvalString(identity)
                }
                if (targetName == "compilerFunctionParameterCount") {
                    result = bootstrapEvalInteger(declaration.parameters.size)
                }
                if (targetName == "compilerFunctionParameterName") {
                    val parameter = this.evaluate(
                        expression.children[1]
                    ).integer
                    if (parameter >= 0 &&
                        parameter < declaration.parameters.size) {
                        result = bootstrapEvalString(
                            declaration.parameters[parameter]
                        )
                    } else this.errors = this.errors + 1
                }
                if (targetName == "compilerFunctionParameterType") {
                    val parameter = this.evaluate(
                        expression.children[1]
                    ).integer
                    if (parameter >= 0 &&
                        parameter < declaration.parameterTypes.size) {
                        result = bootstrapEvalString(bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        ))
                    } else this.errors = this.errors + 1
                }
                if (targetName == "compilerFunctionResultType") {
                    result = bootstrapEvalString(
                        bootstrapNormalizeType(declaration.resultType)
                    )
                }
                if (targetName == "compilerFunctionIsCompileOnly") {
                    result = bootstrapEvalBoolean(
                        declaration.kind == "compile.fun"
                    )
                }
                if (targetName == "compilerFunctionIsTrusted") {
                    result = bootstrapEvalBoolean(declaration.isTrusted)
                }
                if (targetName == "compilerFunctionIsExternal") {
                    result = bootstrapEvalBoolean(
                        declaration.kind == "extern"
                    )
                }
            }
            if (!validHandle) {
                this.recordInvalidFunctionHandle(targetName, handle)
            }
        }
        if (targetName == "compilerFunctionGenericSubstitutionCount" ||
            targetName == "compilerFunctionGenericSubstitutionName" ||
            targetName == "compilerFunctionGenericSubstitutionTypeHandle") {
            val handle = this.evaluate(expression.children[0]).integer
            if (this.functionHandleValid(handle)) {
                if (targetName ==
                    "compilerFunctionGenericSubstitutionCount") {
                    result = bootstrapEvalInteger(0)
                } else {
                    this.evaluate(expression.children[1])
                    this.errors = this.errors + 1
                }
            } else this.errors = this.errors + 1
        }
        if (targetName == "compilerFindClass") {
            val name = this.evaluate(expression.children[0]).text
            var handle = -1
            var declaration = 0
            while (declaration < this.declarations.size) {
                if (this.declarations[declaration].kind == "class" &&
                    this.declarations[declaration].name == name) {
                    handle = declaration
                }
                declaration = declaration + 1
            }
            result = bootstrapEvalInteger(handle)
        }
        if (targetName == "compilerClassFieldCount" ||
            targetName == "compilerClassFieldName" ||
            targetName == "compilerClassFieldType" ||
            targetName == "compilerClassFieldIsMutable") {
            val handle = this.evaluate(expression.children[0]).integer
            val valid = handle >= 0 && handle < this.declarations.size &&
                this.declarations[handle].kind == "class"
            if (valid) {
                val declaration = this.declarations[handle]
                if (targetName == "compilerClassFieldCount") {
                    var count = 0
                    var parameter = 0
                    while (parameter < declaration.parameterKinds.size) {
                        if (declaration.parameterKinds[parameter] == "val" ||
                            declaration.parameterKinds[parameter] == "var") {
                            count = count + 1
                        }
                        parameter = parameter + 1
                    }
                    result = bootstrapEvalInteger(count)
                } else {
                    val wanted = this.evaluate(
                        expression.children[1]
                    ).integer
                    var field = -1
                    var count = 0
                    var parameter = 0
                    while (parameter < declaration.parameterKinds.size) {
                        if (declaration.parameterKinds[parameter] == "val" ||
                            declaration.parameterKinds[parameter] == "var") {
                            if (count == wanted) field = parameter
                            count = count + 1
                        }
                        parameter = parameter + 1
                    }
                    if (field >= 0) {
                        if (targetName == "compilerClassFieldName") {
                            result = bootstrapEvalString(
                                declaration.parameters[field]
                            )
                        }
                        if (targetName == "compilerClassFieldType") {
                            result = bootstrapEvalString(bootstrapNormalizeType(
                                declaration.parameterTypes[field]
                            ))
                        }
                        if (targetName == "compilerClassFieldIsMutable") {
                            result = bootstrapEvalBoolean(
                                declaration.parameterKinds[field] == "var"
                            )
                        }
                    } else this.errors = this.errors + 1
                }
            } else this.errors = this.errors + 1
        }
        if (targetName == "compilerRegisterSubparser") {
            var argument = 0
            while (argument < expression.children.size) {
                this.evaluate(expression.children[argument])
                argument = argument + 1
            }
            result = bootstrapEvalVoid()
        }
        if (targetName == "compilerGrant") {
            this.evaluate(expression.children[0])
            result = bootstrapEvalVoid()
        }
        if (targetName == "compilerGenerateModule") {
            this.evaluate(expression.children[0])
            this.evaluate(expression.children[1])
            result = bootstrapEvalVoid()
        }
        if (targetName == "compilerBuildProgram") {
            val name = this.evaluate(expression.children[0])
            val entry = this.evaluate(expression.children[1])
            val output = this.evaluate(expression.children[2])
            val target = this.evaluate(expression.children[3])
            val artifact = this.evaluate(expression.children[4])
            val fast = this.evaluate(expression.children[5])
            val cache = this.evaluate(expression.children[6])
            var valid = name.kind == "string" && name.text.size > 0 &&
                name.text.size <= 128 && entry.kind == "string" &&
                bootstrapCompileOutputPathValid(entry.text) &&
                output.kind == "string" &&
                bootstrapCompileOutputPathValid(output.text) &&
                target.kind == "string" && target.text.size > 0 &&
                target.text.size <= 128 && artifact.kind == "string" &&
                artifact.text.size > 0 && artifact.text.size <= 64 &&
                fast.kind == "boolean" && cache.kind == "boolean"
            if (valid) {
                valid = bootstrapStageCompileProgramRequest(
                    BootstrapCompileProgramRequest(
                        name.text, entry.text, output.text, target.text,
                        artifact.text, fast.boolean, cache.boolean
                    )
                )
            }
            if (valid) {
                result = bootstrapEvalBoolean(true)
            } else {
                bootstrapStageDriverDiagnostic(
                    "error[E_BUILD_PROGRAM_REQUEST]: compilerBuildProgram received an invalid or duplicate program node\n"
                )
                this.errors = this.errors + 1
                result = bootstrapEvalBoolean(false)
            }
        }
        if (targetName == "compilerDefineTarget") {
            val name = this.evaluate(expression.children[0])
            val triple = this.evaluate(expression.children[1])
            val format = this.evaluate(expression.children[2])
            val linker = this.evaluate(expression.children[3])
            val emulation = this.evaluate(expression.children[4])
            val hosted = this.evaluate(expression.children[5])
            val libcFree = this.evaluate(expression.children[6])
            var valid = name.kind == "string" &&
                triple.kind == "string" && format.kind == "string" &&
                linker.kind == "string" && emulation.kind == "string" &&
                hosted.kind == "boolean" && libcFree.kind == "boolean"
            if (valid) valid = bootstrapStageDefinedTarget(
                BootstrapDefinedTarget(
                    name.text,
                    triple.text,
                    format.text,
                    linker.text,
                    emulation.text,
                    hosted.boolean,
                    libcFree.boolean
                )
            )
            if (valid) {
                result = bootstrapEvalBoolean(true)
            } else {
                bootstrapStageDriverDiagnostic(
                    "error[E_BUILD_TARGET_DEFINITION]: compilerDefineTarget received an invalid or duplicate bounded target descriptor\n"
                )
                this.errors = this.errors + 1
                result = bootstrapEvalBoolean(false)
            }
        }
        if (targetName == "compilerExportFunction") {
            val reflected = this.evaluate(expression.children[0])
            val exportName = this.evaluate(expression.children[1])
            var valid = reflected.kind == "integer" &&
                exportName.kind == "string" &&
                bootstrapExportNameValid(exportName.text) &&
                this.functionHandleValid(reflected.integer) &&
                reflected.integer >= 0 &&
                reflected.integer < this.declarations.size
            var source = ""
            var resultType = ""
            val parameterNames: array<string> = []
            val parameterTypes: array<string> = []
