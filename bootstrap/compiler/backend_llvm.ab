    output = "${output}define internal void @abla_object_create(ptr noalias sret(%AblaValue) align 8 %out, i32 %type_symbol) noinline {\nentry:\n  %object = call ptr @abla_runtime_alloc(i64 32)\n  call void @abla_runtime_memory_set_layout(ptr %object, i64 5)\n  %type_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 0\n  %count_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 1\n  %capacity_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 2\n  %fields_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 3\n  store i32 %type_symbol, ptr %type_pointer, align 8\n  store i64 0, ptr %count_pointer, align 8\n  store i64 0, ptr %capacity_pointer, align 8\n  store ptr null, ptr %fields_pointer, align 8\n  %object_integer = ptrtoint ptr %object to i64\n  %payload = insertvalue %AblaPayload zeroinitializer, i64 %object_integer, 0\n  %tagged = insertvalue %AblaValue zeroinitializer, i32 8, 0\n  %value = insertvalue %AblaValue %tagged, %AblaPayload %payload, 1\n  store %AblaValue %value, ptr %out, align 8\n  ret void\n}\n\n"
    output = "${output}define internal void @abla_field_get(ptr noalias sret(%AblaValue) align 8 %out, ptr byval(%AblaValue) align 8 %boxed, i32 %wanted) noinline {\nentry:\n  %object = call ptr @abla_object_pointer(ptr byval(%AblaValue) align 8 %boxed)\n  %count_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 1\n  %fields_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 3\n  %count = load i64, ptr %count_pointer, align 8\n  %fields = load ptr, ptr %fields_pointer, align 8\n  br label %condition\ncondition:\n  %index = phi i64 [ 0, %entry ], [ %next_index, %next ]\n  %more = icmp ult i64 %index, %count\n  br i1 %more, label %body, label %missing\nbody:\n  %field = getelementptr %AblaField, ptr %fields, i64 %index\n  %symbol_pointer = getelementptr %AblaField, ptr %field, i32 0, i32 0\n  %symbol = load i32, ptr %symbol_pointer, align 8\n  %matched = icmp eq i32 %symbol, %wanted\n  br i1 %matched, label %found, label %next\nnext:\n  %next_index = add i64 %index, 1\n  br label %condition\nfound:\n  %value_pointer = getelementptr %AblaField, ptr %field, i32 0, i32 1\n  %value = load %AblaValue, ptr %value_pointer, align 8\n  store %AblaValue %value, ptr %out, align 8\n  ret void\nmissing:\n  %message = getelementptr [21 x i8], ptr @abla_object_missing_field, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 20)\n  unreachable\n}\n\n"
    output = "${output}define internal void @abla_field_set(ptr byval(%AblaValue) align 8 %boxed, i32 %wanted, ptr byval(%AblaValue) align 8 %input) noinline {\nentry:\n  %object = call ptr @abla_object_pointer(ptr byval(%AblaValue) align 8 %boxed)\n  %count_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 1\n  %capacity_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 2\n  %fields_pointer = getelementptr %AblaObject, ptr %object, i32 0, i32 3\n  %count = load i64, ptr %count_pointer, align 8\n  br label %condition\ncondition:\n  %index = phi i64 [ 0, %entry ], [ %next_index, %next ]\n  %more = icmp ult i64 %index, %count\n  br i1 %more, label %body, label %append_check\nbody:\n  %current_fields = load ptr, ptr %fields_pointer, align 8\n  %field = getelementptr %AblaField, ptr %current_fields, i64 %index\n  %symbol_pointer = getelementptr %AblaField, ptr %field, i32 0, i32 0\n  %symbol = load i32, ptr %symbol_pointer, align 8\n  %matched = icmp eq i32 %symbol, %wanted\n  br i1 %matched, label %found, label %next\nnext:\n  %next_index = add i64 %index, 1\n  br label %condition\nfound:\n  %found_value_pointer = getelementptr %AblaField, ptr %field, i32 0, i32 1\n  %found_value = load %AblaValue, ptr %input, align 8\n  store %AblaValue %found_value, ptr %found_value_pointer, align 8\n  ret void\nappend_check:\n  %capacity = load i64, ptr %capacity_pointer, align 8\n  %full = icmp eq i64 %count, %capacity\n  br i1 %full, label %grow, label %append\ngrow:\n  %was_empty = icmp eq i64 %capacity, 0\n  %doubled = mul i64 %capacity, 2\n  %next_capacity = select i1 %was_empty, i64 4, i64 %doubled\n  %next_bytes = mul i64 %next_capacity, 48\n  %next_fields = call ptr @abla_runtime_alloc(i64 %next_bytes)\n  call void @abla_runtime_memory_set_layout(ptr %next_fields, i64 3)\n  %old_fields = load ptr, ptr %fields_pointer, align 8\n  %copy_bytes = mul i64 %count, 48\n  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %next_fields, ptr align 8 %old_fields, i64 %copy_bytes, i1 false)\n  call void @abla_runtime_free(ptr %old_fields)\n  store i64 %next_capacity, ptr %capacity_pointer, align 8\n  store ptr %next_fields, ptr %fields_pointer, align 8\n  br label %append\nappend:\n  %fields = load ptr, ptr %fields_pointer, align 8\n  %destination = getelementptr %AblaField, ptr %fields, i64 %count\n  %destination_symbol = getelementptr %AblaField, ptr %destination, i32 0, i32 0\n  %destination_value = getelementptr %AblaField, ptr %destination, i32 0, i32 1\n  store i32 %wanted, ptr %destination_symbol, align 8\n  %appended = load %AblaValue, ptr %input, align 8\n  store %AblaValue %appended, ptr %destination_value, align 8\n  %next_count = add i64 %count, 1\n  store i64 %next_count, ptr %count_pointer, align 8\n  %next_scan_bytes = mul i64 %next_count, 48\n  call void @abla_runtime_memory_set_scan(ptr %fields, i64 %next_scan_bytes)\n  ret void\n}\n\n"
    output
