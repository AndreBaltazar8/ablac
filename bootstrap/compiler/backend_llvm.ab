fun bootstrapLlvmRuntimePlatform(
    program: BootstrapIrProgram,
    collectorEnabled: bool
): string {
    var output = ""
    if (bootstrapLlvmNeedsHostRuntime(program)) {
        output = "declare ptr @abla_platform_alloc(i64)\ndeclare void @abla_platform_free(ptr)\ndeclare void @abla_platform_panic(ptr, i64) noreturn\ndeclare i64 @abla_platform_memory_checkpoint()\ndeclare void @abla_platform_memory_reset(i64)\ndeclare i64 @abla_platform_memory_live_bytes()\ndeclare i64 @abla_platform_memory_limit()\ndeclare void @abla_platform_memory_set_limit(i64)\ndeclare void @abla_platform_memory_set_scan(ptr, i64)\ndeclare void @abla_platform_memory_set_layout(ptr, i64)\ndeclare i64 @abla_platform_memory_collect(ptr)\n\n"
        output = "${output}define internal ptr @abla_runtime_alloc(i64 %size) {\nentry:\n  %result = call ptr @abla_platform_alloc(i64 %size)\n  ret ptr %result\n}\n\n"
        output = "${output}define internal ptr @abla_runtime_alloc_uninitialized(i64 %size) {\nentry:\n  %result = call ptr @abla_platform_alloc(i64 %size)\n  ret ptr %result\n}\n\n"
        output = "${output}define internal void @abla_runtime_free(ptr %pointer) {\nentry:\n  call void @abla_platform_free(ptr %pointer)\n  ret void\n}\n\n"
        output = "${output}define internal void @abla_runtime_panic(ptr %message, i64 %length) noreturn {\nentry:\n  call void @abla_platform_panic(ptr %message, i64 %length)\n  unreachable\n}\n\n"
        output = "${output}define internal i64 @abla_runtime_memory_checkpoint() {\nentry:\n  %value = call i64 @abla_platform_memory_checkpoint()\n  ret i64 %value\n}\n\n"
        output = "${output}define internal void @abla_runtime_memory_reset(i64 %checkpoint) {\nentry:\n  call void @abla_platform_memory_reset(i64 %checkpoint)\n  ret void\n}\n\n"
        output = "${output}define internal i64 @abla_runtime_memory_live_bytes() {\nentry:\n  %value = call i64 @abla_platform_memory_live_bytes()\n  ret i64 %value\n}\n\n"
        output = "${output}define internal i64 @abla_runtime_memory_limit() {\nentry:\n  %value = call i64 @abla_platform_memory_limit()\n  ret i64 %value\n}\n\n"
        output = "${output}define internal void @abla_runtime_memory_set_limit(i64 %limit) {\nentry:\n  call void @abla_platform_memory_set_limit(i64 %limit)\n  ret void\n}\n\n"
        if (collectorEnabled) {
            output = "${output}define internal void @abla_runtime_memory_set_scan(ptr %pointer, i64 %scan_size) {\nentry:\n  call void @abla_platform_memory_set_scan(ptr %pointer, i64 %scan_size)\n  ret void\n}\n\n"
            output = "${output}define internal void @abla_runtime_memory_set_layout(ptr %pointer, i64 %layout) {\nentry:\n  call void @abla_platform_memory_set_layout(ptr %pointer, i64 %layout)\n  ret void\n}\n\n"
        } else {
            output = "${output}define internal void @abla_runtime_memory_set_scan(ptr %pointer, i64 %scan_size) alwaysinline {\nentry:\n  ret void\n}\n\n"
            output = "${output}define internal void @abla_runtime_memory_set_layout(ptr %pointer, i64 %layout) alwaysinline {\nentry:\n  ret void\n}\n\n"
        }
    }
