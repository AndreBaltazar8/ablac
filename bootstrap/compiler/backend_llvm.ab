    output = "${output}define internal void @abla_to_string(ptr noalias sret(%AblaValue) align 8 %out, ptr byval(%AblaValue) align 8 %boxed) noinline {\nentry:\n  %tag_pointer = getelementptr %AblaValue, ptr %boxed, i32 0, i32 0\n  %tag = load i32, ptr %tag_pointer, align 8\n  switch i32 %tag, label %invalid [\n    i32 1, label %null\n    i32 2, label %integer\n    i32 3, label %boolean\n    i32 4, label %string\n  ]\nstring:\n  %string_value = load %AblaValue, ptr %boxed, align 8\n  store %AblaValue %string_value, ptr %out, align 8\n  ret void\nnull:\n  %null_text = getelementptr [5 x i8], ptr @abla_print_null, i64 0, i64 0\n  call void @abla_string_static(ptr sret(%AblaValue) align 8 %out, ptr %null_text, i64 4)\n  ret void\nboolean:\n  %boolean_value = call i1 @abla_as_bool(ptr byval(%AblaValue) align 8 %boxed)\n  br i1 %boolean_value, label %boolean_true, label %boolean_false\nboolean_true:\n  %true_text = getelementptr [5 x i8], ptr @abla_print_true, i64 0, i64 0\n  call void @abla_string_static(ptr sret(%AblaValue) align 8 %out, ptr %true_text, i64 4)\n  ret void\nboolean_false:\n  %false_text = getelementptr [6 x i8], ptr @abla_print_false, i64 0, i64 0\n  call void @abla_string_static(ptr sret(%AblaValue) align 8 %out, ptr %false_text, i64 5)\n  ret void\ninteger:\n  %integer_value = call i64 @abla_as_i64(ptr byval(%AblaValue) align 8 %boxed)\n  %negative = icmp slt i64 %integer_value, 0\n  %negated = sub i64 0, %integer_value\n  %magnitude = select i1 %negative, i64 %negated, i64 %integer_value\n  br label %count_digits\ncount_digits:\n  %count = phi i64 [ 1, %integer ], [ %next_count, %count_more ]\n  %remaining = phi i64 [ %magnitude, %integer ], [ %next_remaining, %count_more ]\n  %next_remaining = udiv i64 %remaining, 10\n  %count_done = icmp eq i64 %next_remaining, 0\n  br i1 %count_done, label %allocate, label %count_more\ncount_more:\n  %next_count = add i64 %count, 1\n  br label %count_digits\nallocate:\n  %sign_length = zext i1 %negative to i64\n  %length = add i64 %count, %sign_length\n  %allocation_size = add i64 %length, 1\n  %text = call ptr @abla_runtime_alloc(i64 %allocation_size)\n  call void @abla_runtime_memory_set_layout(ptr %text, i64 1)\n  %terminator = getelementptr i8, ptr %text, i64 %length\n  store i8 0, ptr %terminator, align 1\n  br label %write_digits\nwrite_digits:\n  %position = phi i64 [ %count, %allocate ], [ %next_position, %write_more ]\n  %digits = phi i64 [ %magnitude, %allocate ], [ %next_digits, %write_more ]\n  %next_position = sub i64 %position, 1\n  %digit = urem i64 %digits, 10\n  %digit_byte = trunc i64 %digit to i8\n  %character = add i8 %digit_byte, 48\n  %character_index = add i64 %sign_length, %next_position\n  %character_pointer = getelementptr i8, ptr %text, i64 %character_index\n  store i8 %character, ptr %character_pointer, align 1\n  %next_digits = udiv i64 %digits, 10\n  %digits_done = icmp eq i64 %position, 1\n  br i1 %digits_done, label %write_sign, label %write_more\nwrite_more:\n  br label %write_digits\nwrite_sign:\n  br i1 %negative, label %negative_sign, label %box\nnegative_sign:\n  store i8 45, ptr %text, align 1\n  br label %box\nbox:\n  %text_integer = ptrtoint ptr %text to i64\n  %payload_data = insertvalue %AblaPayload zeroinitializer, i64 %text_integer, 0\n  %payload_length = insertvalue %AblaPayload %payload_data, i64 %length, 1\n  %payload_owned = insertvalue %AblaPayload %payload_length, i64 1, 2\n  %tagged = insertvalue %AblaValue zeroinitializer, i32 4, 0\n  %result = insertvalue %AblaValue %tagged, %AblaPayload %payload_owned, 1\n  store %AblaValue %result, ptr %out, align 8\n  ret void\ninvalid:\n  %message = getelementptr [23 x i8], ptr @abla_not_printable, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 22)\n  unreachable\n}\n\n"
