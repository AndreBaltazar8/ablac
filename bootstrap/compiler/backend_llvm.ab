fun bootstrapLlvmRootRuntime(
    program: BootstrapIrProgram,
    collectorEnabled: bool
): string {
    var output =
        "define internal void @abla_runtime_roots_push(ptr %frame, ptr %roots, i64 %count) {\nentry:\n  %previous = load ptr, ptr @abla_runtime_root_frame, align 8\n  %previous_slot = getelementptr %AblaRootFrame, ptr %frame, i32 0, i32 0\n  %roots_slot = getelementptr %AblaRootFrame, ptr %frame, i32 0, i32 1\n  %count_slot = getelementptr %AblaRootFrame, ptr %frame, i32 0, i32 2\n  store ptr %previous, ptr %previous_slot, align 8\n  store ptr %roots, ptr %roots_slot, align 8\n  store i64 %count, ptr %count_slot, align 8\n  store ptr %frame, ptr @abla_runtime_root_frame, align 8\n  ret void\n}\n\n"
    output = "${output}define internal void @abla_runtime_roots_pop(ptr %frame) {\nentry:\n  %previous_slot = getelementptr %AblaRootFrame, ptr %frame, i32 0, i32 0\n  %previous = load ptr, ptr %previous_slot, align 8\n  store ptr %previous, ptr @abla_runtime_root_frame, align 8\n  ret void\n}\n\n"
    if (bootstrapLlvmNeedsHostRuntime(program) && collectorEnabled) {
        output = "${output}define internal i64 @abla_runtime_memory_collect() {\nentry:\n  %frames = load ptr, ptr @abla_runtime_root_frame, align 8\n  %freed = call i64 @abla_platform_memory_collect(ptr %frames)\n  ret i64 %freed\n}\n\n"
    }
    if (!bootstrapLlvmNeedsHostRuntime(program) && collectorEnabled) {
        output = "${output}define internal i1 @abla_runtime_mark_pointer(i64 %candidate) {\nentry:\n  %initial = load ptr, ptr @abla_runtime_allocation_tail, align 8\n  br label %condition\ncondition:\n  %header = phi ptr [ %next_header, %next ], [ %initial, %entry ]\n  %more = icmp ne ptr %header, null\n  br i1 %more, label %inspect, label %missing\ninspect:\n  %payload = getelementptr i8, ptr %header, i64 40\n  %payload_integer = ptrtoint ptr %payload to i64\n  %matched = icmp eq i64 %payload_integer, %candidate\n  br i1 %matched, label %mark, label %next\nnext:\n  %previous_slot = getelementptr i8, ptr %header, i64 0\n  %next_header = load ptr, ptr %previous_slot, align 8\n  br label %condition\nmark:\n  %generation_slot = getelementptr i8, ptr %header, i64 16\n  %generation = load i64, ptr %generation_slot, align 8\n  %already = icmp slt i64 %generation, 0\n  br i1 %already, label %unchanged, label %new\nnew:\n  %marked = or i64 %generation, -9223372036854775808\n  store i64 %marked, ptr %generation_slot, align 8\n  ret i1 true\nunchanged:\n  ret i1 false\nmissing:\n  ret i1 false\n}\n\n"
        output = "${output}define internal i1 @abla_runtime_mark_words(ptr %bytes, i64 %size) {\nentry:\n  %count = udiv i64 %size, 8\n  br label %condition\ncondition:\n  %index = phi i64 [ 0, %entry ], [ %next_index, %next ]\n  %changed = phi i1 [ false, %entry ], [ %next_changed, %next ]\n  %more = icmp ult i64 %index, %count\n  br i1 %more, label %body, label %done\nbody:\n  %word_pointer = getelementptr i64, ptr %bytes, i64 %index\n  %candidate = load i64, ptr %word_pointer, align 1\n  %marked = call i1 @abla_runtime_mark_pointer(i64 %candidate)\n  %next_changed = or i1 %changed, %marked\n  %next_index = add i64 %index, 1\n  br label %next\nnext:\n  br label %condition\ndone:\n  ret i1 %changed\n}\n\n"
        output = "${output}define internal i1 @abla_runtime_mark_slot(ptr %bytes, i64 %offset) {\nentry:\n  %slot = getelementptr i8, ptr %bytes, i64 %offset\n  %candidate = load i64, ptr %slot, align 1\n  %changed = call i1 @abla_runtime_mark_pointer(i64 %candidate)\n  ret i1 %changed\n}\n\n"
        output = "${output}define internal i1 @abla_runtime_mark_value(ptr %value) {\nentry:\n  %tag = load i32, ptr %value, align 8\n  switch i32 %tag, label %none [\n    i32 4, label %string\n    i32 5, label %function\n    i32 6, label %word0\n    i32 7, label %word0\n    i32 8, label %word0\n    i32 9, label %word0\n    i32 10, label %word0\n  ]\nstring:\n  %string_data = call i1 @abla_runtime_mark_slot(ptr %value, i64 8)\n  %string_rope = call i1 @abla_runtime_mark_slot(ptr %value, i64 32)\n  %string_changed = or i1 %string_data, %string_rope\n  ret i1 %string_changed\nfunction:\n  %function_changed = call i1 @abla_runtime_mark_slot(ptr %value, i64 24)\n  ret i1 %function_changed\nword0:\n  %word0_changed = call i1 @abla_runtime_mark_slot(ptr %value, i64 8)\n  ret i1 %word0_changed\nnone:\n  ret i1 false\n}\n\n"
        output = "${output}define internal i1 @abla_runtime_mark_allocation(ptr %bytes, i64 %size, i64 %layout) {\nentry:\n  switch i64 %layout, label %words [\n    i64 1, label %none\n    i64 10, label %none\n    i64 2, label %values_begin\n    i64 3, label %fields_begin\n    i64 4, label %array_struct\n    i64 5, label %object_struct\n    i64 6, label %rope\n    i64 7, label %shared\n    i64 8, label %cell\n    i64 9, label %strings_begin\n  ]\nnone:\n  ret i1 false\nwords:\n  %words_changed = call i1 @abla_runtime_mark_words(ptr %bytes, i64 %size)\n  ret i1 %words_changed\nvalues_begin:\n  %value_count = udiv i64 %size, 40\n  br label %values_condition\nvalues_condition:\n  %value_index = phi i64 [ 0, %values_begin ], [ %next_value_index, %values_body ]\n  %values_changed = phi i1 [ false, %values_begin ], [ %next_values_changed, %values_body ]\n  %more_values = icmp ult i64 %value_index, %value_count\n  br i1 %more_values, label %values_body, label %values_done\nvalues_body:\n  %value = getelementptr %AblaValue, ptr %bytes, i64 %value_index\n  %value_changed = call i1 @abla_runtime_mark_value(ptr %value)\n  %next_values_changed = or i1 %values_changed, %value_changed\n  %next_value_index = add i64 %value_index, 1\n  br label %values_condition\nvalues_done:\n  ret i1 %values_changed\nfields_begin:\n  %field_count = udiv i64 %size, 48\n  br label %fields_condition\nfields_condition:\n  %field_index = phi i64 [ 0, %fields_begin ], [ %next_field_index, %fields_body ]\n  %fields_changed = phi i1 [ false, %fields_begin ], [ %next_fields_changed, %fields_body ]\n  %more_fields = icmp ult i64 %field_index, %field_count\n  br i1 %more_fields, label %fields_body, label %fields_done\nfields_body:\n  %field_offset = mul i64 %field_index, 48\n  %field_base = getelementptr i8, ptr %bytes, i64 %field_offset\n  %field_value = getelementptr i8, ptr %field_base, i64 8\n  %field_changed = call i1 @abla_runtime_mark_value(ptr %field_value)\n  %next_fields_changed = or i1 %fields_changed, %field_changed\n  %next_field_index = add i64 %field_index, 1\n  br label %fields_condition\nfields_done:\n  ret i1 %fields_changed\narray_struct:\n  %array_changed = call i1 @abla_runtime_mark_slot(ptr %bytes, i64 16)\n  ret i1 %array_changed\nobject_struct:\n  %object_changed = call i1 @abla_runtime_mark_slot(ptr %bytes, i64 24)\n  ret i1 %object_changed\nrope:\n  %rope0 = call i1 @abla_runtime_mark_slot(ptr %bytes, i64 0)\n  %rope1 = call i1 @abla_runtime_mark_slot(ptr %bytes, i64 24)\n  %rope2 = call i1 @abla_runtime_mark_slot(ptr %bytes, i64 32)\n  %rope3 = call i1 @abla_runtime_mark_slot(ptr %bytes, i64 56)\n  %rope4 = call i1 @abla_runtime_mark_slot(ptr %bytes, i64 64)\n  %rope01 = or i1 %rope0, %rope1\n  %rope23 = or i1 %rope2, %rope3\n  %rope0123 = or i1 %rope01, %rope23\n  %rope_changed = or i1 %rope0123, %rope4\n  ret i1 %rope_changed\nshared:\n  %shared_value = getelementptr i8, ptr %bytes, i64 16\n  %shared_changed = call i1 @abla_runtime_mark_value(ptr %shared_value)\n  ret i1 %shared_changed\ncell:\n  %cell_changed = call i1 @abla_runtime_mark_value(ptr %bytes)\n  ret i1 %cell_changed\nstrings_begin:\n  %string_count = udiv i64 %size, 32\n  br label %strings_condition\nstrings_condition:\n  %string_index = phi i64 [ 0, %strings_begin ], [ %next_string_index, %strings_body ]\n  %strings_changed = phi i1 [ false, %strings_begin ], [ %next_strings_changed, %strings_body ]\n  %more_strings = icmp ult i64 %string_index, %string_count\n  br i1 %more_strings, label %strings_body, label %strings_done\nstrings_body:\n  %string_offset = mul i64 %string_index, 32\n  %string_base = getelementptr i8, ptr %bytes, i64 %string_offset\n  %string_data_changed = call i1 @abla_runtime_mark_slot(ptr %string_base, i64 0)\n  %string_rope_changed = call i1 @abla_runtime_mark_slot(ptr %string_base, i64 24)\n  %string_changed_item = or i1 %string_data_changed, %string_rope_changed\n  %next_strings_changed = or i1 %strings_changed, %string_changed_item\n  %next_string_index = add i64 %string_index, 1\n  br label %strings_condition\nstrings_done:\n  ret i1 %strings_changed\n}\n\n"
        output = "${output}define internal i64 @abla_runtime_memory_collect() {\nentry:\n  %before = load i64, ptr @abla_runtime_allocation_live_bytes, align 8\n  %initial_frame = load ptr, ptr @abla_runtime_root_frame, align 8\n  br label %frame_condition\nframe_condition:\n  %frame = phi ptr [ %initial_frame, %entry ], [ %previous_frame, %frame_next ]\n  %has_frame = icmp ne ptr %frame, null\n  br i1 %has_frame, label %frame_body, label %propagate_begin\nframe_body:\n  %roots_slot = getelementptr %AblaRootFrame, ptr %frame, i32 0, i32 1\n  %count_slot = getelementptr %AblaRootFrame, ptr %frame, i32 0, i32 2\n  %roots = load ptr, ptr %roots_slot, align 8\n  %root_count = load i64, ptr %count_slot, align 8\n  br label %root_condition\nroot_condition:\n  %root_index = phi i64 [ 0, %frame_body ], [ %next_root_index, %root_next ]\n  %more_roots = icmp ult i64 %root_index, %root_count\n  br i1 %more_roots, label %root_body, label %frame_next\nroot_body:\n  %root_slot = getelementptr ptr, ptr %roots, i64 %root_index\n  %root = load ptr, ptr %root_slot, align 8\n  %root_changed = call i1 @abla_runtime_mark_value(ptr %root)\n  %next_root_index = add i64 %root_index, 1\n  br label %root_next\nroot_next:\n  br label %root_condition\nframe_next:\n  %previous_slot = getelementptr %AblaRootFrame, ptr %frame, i32 0, i32 0\n  %previous_frame = load ptr, ptr %previous_slot, align 8\n  br label %frame_condition\npropagate_begin:\n  br label %propagate\npropagate:\n  %pass_header = load ptr, ptr @abla_runtime_allocation_tail, align 8\n  br label %allocation_condition\nallocation_condition:\n  %allocation = phi ptr [ %pass_header, %propagate ], [ %previous_allocation, %allocation_next ]\n  %pass_changed = phi i1 [ false, %propagate ], [ %next_pass_changed, %allocation_next ]\n  %has_allocation = icmp ne ptr %allocation, null\n  br i1 %has_allocation, label %allocation_body, label %pass_done\nallocation_body:\n  %allocation_generation_slot = getelementptr i8, ptr %allocation, i64 16\n  %allocation_generation = load i64, ptr %allocation_generation_slot, align 8\n  %allocation_marked = icmp slt i64 %allocation_generation, 0\n  br i1 %allocation_marked, label %scan_allocation, label %allocation_skip\nscan_allocation:\n  %allocation_scan_size_slot = getelementptr i8, ptr %allocation, i64 32\n  %allocation_scan_encoded = load i64, ptr %allocation_scan_size_slot, align 8\n  %allocation_scan_size = and i64 %allocation_scan_encoded, 72057594037927935\n  %allocation_scan_layout = lshr i64 %allocation_scan_encoded, 56\n  %allocation_payload = getelementptr i8, ptr %allocation, i64 40\n  %allocation_changed = call i1 @abla_runtime_mark_allocation(ptr %allocation_payload, i64 %allocation_scan_size, i64 %allocation_scan_layout)\n  br label %allocation_next\nallocation_skip:\n  br label %allocation_next\nallocation_next:\n  %this_changed = phi i1 [ %allocation_changed, %scan_allocation ], [ false, %allocation_skip ]\n  %next_pass_changed = or i1 %pass_changed, %this_changed\n  %allocation_previous_slot = getelementptr i8, ptr %allocation, i64 0\n  %previous_allocation = load ptr, ptr %allocation_previous_slot, align 8\n  br label %allocation_condition\npass_done:\n  br i1 %pass_changed, label %propagate, label %sweep_begin\nsweep_begin:\n  %sweep_tail = load ptr, ptr @abla_runtime_allocation_tail, align 8\n  br label %sweep_condition\nsweep_condition:\n  %sweep = phi ptr [ %sweep_tail, %sweep_begin ], [ %sweep_previous, %sweep_next ]\n  %has_sweep = icmp ne ptr %sweep, null\n  br i1 %has_sweep, label %sweep_body, label %done\nsweep_body:\n  %sweep_previous_slot = getelementptr i8, ptr %sweep, i64 0\n  %sweep_previous = load ptr, ptr %sweep_previous_slot, align 8\n  %sweep_generation_slot = getelementptr i8, ptr %sweep, i64 16\n  %sweep_generation = load i64, ptr %sweep_generation_slot, align 8\n  %sweep_marked = icmp slt i64 %sweep_generation, 0\n  %sweep_scan_slot = getelementptr i8, ptr %sweep, i64 32\n  %sweep_scan_encoded = load i64, ptr %sweep_scan_slot, align 8\n  %sweep_layout = lshr i64 %sweep_scan_encoded, 56\n  %sweep_pinned = icmp eq i64 %sweep_layout, 10\n  %sweep_live = or i1 %sweep_marked, %sweep_pinned\n  br i1 %sweep_live, label %sweep_keep, label %sweep_free\nsweep_keep:\n  %restored_generation = and i64 %sweep_generation, 9223372036854775807\n  store i64 %restored_generation, ptr %sweep_generation_slot, align 8\n  br label %sweep_next\nsweep_free:\n  %sweep_payload = getelementptr i8, ptr %sweep, i64 40\n  call void @abla_runtime_free(ptr %sweep_payload)\n  br label %sweep_next\nsweep_next:\n  br label %sweep_condition\ndone:\n  %after = load i64, ptr @abla_runtime_allocation_live_bytes, align 8\n  %freed = sub i64 %before, %after\n  ret i64 %freed\n}\n\n"
    }
    if (!collectorEnabled) {
        output = "${output}define internal i64 @abla_runtime_memory_collect() {\nentry:\n  ret i64 0\n}\n\n"
    }
    if (collectorEnabled) {
        output = "${output}@abla_runtime_collection_threshold = internal global i64 9223372036854775807, align 8\n\n"
        output = "${output}define internal void @abla_runtime_memory_pressure() alwaysinline {\nentry:\n  %live = call i64 @abla_runtime_memory_live_bytes()\n  %limit = call i64 @abla_runtime_memory_limit()\n  %has_large_reserve = icmp ugt i64 %limit, 536870912\n  %small_reserve = udiv i64 %limit, 2\n  %reserve = select i1 %has_large_reserve, i64 536870912, i64 %small_reserve\n  %latest = sub i64 %limit, %reserve\n  %configured = load i64, ptr @abla_runtime_collection_threshold, align 8\n  %configured_first = icmp ult i64 %configured, %latest\n  %trigger = select i1 %configured_first, i64 %configured, i64 %latest\n  %pressured = icmp uge i64 %live, %trigger\n  br i1 %pressured, label %collect, label %done\ncollect:\n  %freed = call i64 @abla_runtime_memory_collect()\n  %after = call i64 @abla_runtime_memory_live_bytes()\n  %plus = add i64 %after, 1048576\n  %plus_overflow = icmp ult i64 %plus, %after\n  %doubled = shl i64 %after, 1\n  %double_overflow = icmp ult i64 %doubled, %after\n  %larger_double = icmp ugt i64 %doubled, %plus\n  %grown = select i1 %larger_double, i64 %doubled, i64 %plus\n  %growth_overflow = or i1 %plus_overflow, %double_overflow\n  %candidate = select i1 %growth_overflow, i64 %limit, i64 %grown\n  %above_limit = icmp ugt i64 %candidate, %limit\n  %next = select i1 %above_limit, i64 %limit, i64 %candidate\n  store i64 %next, ptr @abla_runtime_collection_threshold, align 8\n  br label %done\ndone:\n  ret void\n}\n\n"
    } else {
        output = "${output}define internal void @abla_runtime_memory_pressure() alwaysinline {\nentry:\n  ret void\n}\n\n"
    }
    output
}

fun bootstrapLlvmHeader(program: BootstrapIrProgram): string {
    val collectorEnabled = bootstrapLlvmNeedsCollector(program)
    var output =
        "; Generated deterministically by the self-hosted Abla LLVM backend.\n"
    output = "${output}target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\n"
    output = "${output}target triple = \"x86_64-unknown-linux-gnu\"\n\n"
    output = "${output}%AblaPayload = type { i64, i64, i64, i64 }\n"
    output = "${output}%AblaValue = type { i32, %AblaPayload }\n\n"
    output = "${output}%AblaRootFrame = type { ptr, ptr, i64 }\n"
    output = "${output}@abla_runtime_root_frame = internal global ptr null, align 8\n\n"
    output = "${output}%AblaString = type { ptr, i64, i8, ptr }\n"
    output = "${output}%AblaStringRope = type { %AblaString, %AblaString, ptr }\n"
    output = "${output}%AblaArray = type { i64, i64, ptr }\n\n"
    output = "${output}%AblaField = type { i32, %AblaValue }\n"
    output = "${output}%AblaObject = type { i32, i64, i64, ptr }\n\n"
    if (bootstrapLlvmNeedsSharedRuntime(program)) {
        output = "${output}%AblaShared = type { i64, i64, %AblaValue, i64 }\n\n"
    }
    output = "${output}@abla_process_argc = internal global i32 0, align 4\n"
    output = "${output}@abla_process_argv = internal global ptr null, align 8\n\n"
    output = "${output}@abla_process_envp = internal global ptr null, align 8\n\n"
    output = "$output${bootstrapLlvmRuntimePlatform(
        program,
        collectorEnabled
    )}"
    output = "$output${bootstrapLlvmRootRuntime(
        program,
        collectorEnabled
    )}"
    output = "${output}declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)\ndeclare void @llvm.memset.p0.i64(ptr, i8, i64, i1 immarg)\n\n"
    output = "$output${bootstrapLlvmScalarRuntime()}"
    output = "$output${bootstrapLlvmStringRuntime()}"
    output = "$output${bootstrapLlvmStringDataRuntime()}"
    output = "$output${bootstrapLlvmProcessRuntime()}"
    output = "$output${bootstrapLlvmRemainingValueRuntime()}"
    output = "$output${bootstrapLlvmArrayRuntime()}"
    output = "$output${bootstrapLlvmObjectRuntime()}"
    if (bootstrapLlvmNeedsSharedRuntime(program)) {
        output = "$output${bootstrapLlvmSharedRuntime()}"
    }
    if (bootstrapLlvmNeedsHostRuntime(program)) {
        output = "${output}declare void @abla_host_set_arguments(i32, ptr)\n\n"
    }
    output
}

fun bootstrapLlvmProcessRuntime(): string {
    var output =
        "@abla_argument_bounds = private unnamed_addr constant [29 x i8] c\"argument index out of bounds\\00\", align 1\n\n"
    output = "${output}define internal void @abla_borrow_cstring(ptr noalias sret(%AblaValue) align 8 %out, ptr %text) {\nentry:\n  br label %measure\nmeasure:\n  %length = phi i64 [ 0, %entry ], [ %next_length, %more ]\n  %character = getelementptr i8, ptr %text, i64 %length\n  %byte = load i8, ptr %character, align 1\n  %ended = icmp eq i8 %byte, 0\n  br i1 %ended, label %done, label %more\nmore:\n  %next_length = add i64 %length, 1\n  br label %measure\ndone:\n  call void @abla_string_static(ptr sret(%AblaValue) align 8 %out, ptr %text, i64 %length)\n  ret void\n}\n\n"
    output = "${output}define internal void @abla_linux_argument(ptr noalias sret(%AblaValue) align 8 %out, i64 %index) noinline {\nentry:\n  %argc = load i32, ptr @abla_process_argc, align 4\n  %count_i32 = sub i32 %argc, 1\n  %count = sext i32 %count_i32 to i64\n  %nonnegative = icmp sge i64 %index, 0\n  %below = icmp slt i64 %index, %count\n  %valid = and i1 %nonnegative, %below\n  br i1 %valid, label %lookup, label %invalid\nlookup:\n  %argv = load ptr, ptr @abla_process_argv, align 8\n  %position = add i64 %index, 1\n  %slot = getelementptr ptr, ptr %argv, i64 %position\n  %text = load ptr, ptr %slot, align 8\n  call void @abla_borrow_cstring(ptr sret(%AblaValue) align 8 %out, ptr %text)\n  ret void\ninvalid:\n  %message = getelementptr [29 x i8], ptr @abla_argument_bounds, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 28)\n  unreachable\n}\n\n"
    output
}

fun bootstrapLlvmCopy(
    source: string,
    destination: string,
    temporary: string
): string =
    "  %$temporary = load %AblaValue, ptr %$source, align 8\n  store %AblaValue %$temporary, ptr %$destination, align 8\n"

fun bootstrapLlvmFunctionFingerprint(
    function: BootstrapIrFunction,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = bootstrapIrHashText(seed, function.name, factor, modulus)
    var parameter = 0
    while (parameter < function.parameters.size) {
        hash = bootstrapIrHashText(
            hash,
            function.parameters[parameter],
            factor,
            modulus
        )
        parameter = parameter + 1
    }
    hash = hash * factor + function.result + 2
    hash = hash - (hash / modulus) * modulus
    var instruction = 0
    while (instruction < function.instructions.size) {
        val found = function.instructions[instruction]
        hash = bootstrapIrHashText(hash, found.opcode, factor, modulus)
        hash = bootstrapIrHashText(hash, found.text, factor, modulus)
        hash = hash * factor + found.result + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.left + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.right + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.target + 2
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + found.alternate + 2
        hash = hash - (hash / modulus) * modulus
        var operand = 0
        while (operand < found.operands.size) {
            hash = hash * factor + found.operands[operand] + 2
            hash = hash - (hash / modulus) * modulus
            operand = operand + 1
        }
        instruction = instruction + 1
    }
    if (hash < 0) 0 - hash else hash
}

// Linkage identities describe declarations, not implementations. A body edit
// must leave callers' relocation targets intact so their native objects remain
// reusable. The extracted LLVM partition is hashed separately by the
// toolchain, which invalidates the object that actually contains the edit.
fun bootstrapLlvmFunctionLinkFingerprint(
    function: BootstrapIrFunction,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = bootstrapIrHashText(seed, function.name, factor, modulus)
    var parameter = 0
    while (parameter < function.parameters.size) {
        hash = bootstrapIrHashText(
            hash,
            function.parameters[parameter],
            factor,
            modulus
        )
        parameter = parameter + 1
    }
    if (hash < 0) 0 - hash else hash
}

fun bootstrapLlvmFunctionSymbol(function: BootstrapIrFunction): string =
    "abla_fn_${bootstrapLlvmFunctionLinkFingerprint(
        function, 41, 269, 1000000007
    )}_${bootstrapLlvmFunctionLinkFingerprint(
        function, 101, 271, 1000000009
    )}"

fun bootstrapLlvmFunctionRuntimeId(function: BootstrapIrFunction): int =
    bootstrapLlvmFunctionLinkFingerprint(function, 151, 277, 1000000007)

class BootstrapLlvmFunctionIdentities(
    val symbols: array<string>,
    val runtimeIds: array<int>,
    val collisions: int
)

fun bootstrapLlvmFunctionIdentities(
    program: BootstrapIrProgram
): BootstrapLlvmFunctionIdentities {
    val symbols: array<string> = []
    val runtimeIds: array<int> = []
    var collisions = 0
    var function = 0
    while (function < program.functions.size) {
        val symbol = bootstrapLlvmFunctionSymbol(program.functions[function])
        val runtimeId = bootstrapLlvmFunctionRuntimeId(
            program.functions[function]
        )
        var previous = 0
        while (previous < symbols.size) {
            if (symbols[previous] == symbol ||
                runtimeIds[previous] == runtimeId) collisions = collisions + 1
            previous = previous + 1
        }
        symbols.append(symbol)
        runtimeIds.append(runtimeId)
        function = function + 1
    }
    BootstrapLlvmFunctionIdentities(symbols, runtimeIds, collisions)
}

fun bootstrapLlvmStableNameId(name: string): int {
    var hash = bootstrapIrHashText(181, name, 281, 1000000007)
    if (hash < 0) hash = 0 - hash
    hash
}

fun bootstrapLlvmStableNameCollisions(names: array<string>): int {
    var collisions = 0
    var index = 0
    while (index < names.size) {
        val identity = bootstrapLlvmStableNameId(names[index])
        var previous = 0
        while (previous < index) {
            if (names[previous] != names[index] &&
                bootstrapLlvmStableNameId(names[previous]) == identity) {
                collisions = collisions + 1
            }
            previous = previous + 1
        }
        index = index + 1
    }
    collisions
}

fun bootstrapLlvmGlobalSymbol(name: string): string =
    "abla_global_${bootstrapIrHashText(
        191, name, 283, 1000000007
    )}_${bootstrapIrHashText(
        211, name, 293, 1000000009
    )}"

fun bootstrapLlvmStringSymbol(
    function: BootstrapIrFunction,
    result: int
): string = "abla_string_${bootstrapLlvmFunctionSymbol(function)}_$result"

fun bootstrapLlvmStringSymbolFrom(
    functionSymbol: string,
    result: int
): string = "abla_string_${functionSymbol}_$result"

fun bootstrapLlvmEmitFunction(
    program: BootstrapIrProgram,
    function: BootstrapIrFunction,
    functionId: int,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities,
    nativeIndex: BootstrapLlvmNameIndex,
    globalNamesIndex: BootstrapLlvmNameIndex,
    classNamesIndex: BootstrapLlvmNameIndex,
    fieldNamesIndex: BootstrapLlvmNameIndex,
    mayCollect: array<bool>
): BootstrapLlvmEmission {
    val localIndex = bootstrapLlvmLocalIndex(function)
    val gcRootPlan = bootstrapLlvmGcRootPlan(
        function,
        functionIndex,
        mayCollect
    )
    var errors = 0
    var output =
        "define hidden void @${identities.symbols[functionId]}(ptr noalias sret(%AblaValue) align 8 %out, ptr %args, i64 %count) {\nentry:\n"

    val rootNames: array<string> = []
    var instructionIndex = 0
    while (instructionIndex < function.instructions.size) {
        val instruction = function.instructions[instructionIndex]
        if (instruction.result >= 0) {
            output = "$output  %v${instruction.result} = alloca %AblaValue, align 8\n"
            if (functionId < mayCollect.size && mayCollect[functionId] &&
                instruction.result < gcRootPlan.size &&
                gcRootPlan[instruction.result]) {
                rootNames.append("v${instruction.result}")
            }
        }
        if (instruction.opcode == "local.declare" ||
            instruction.opcode == "local.zero" ||
            instruction.opcode == "local.allocate") {
            output = "$output  %local_$instructionIndex = alloca %AblaValue, align 8\n"
            if (functionId < mayCollect.size && mayCollect[functionId]) {
                rootNames.append("local_$instructionIndex")
            }
        }
        // LLVM allocas are released when the function returns, not when the
        // source block or loop iteration ends.  Keep every fixed-size scratch
        // array in the entry block so a loop cannot grow the native stack on
        // each iteration.
        if (instruction.opcode == "closure.create" &&
            instruction.operands.size > 0) {
            output = "$output  %closure_values_$instructionIndex = alloca [${instruction.operands.size} x %AblaValue], align 8\n"
        }
        if (instruction.opcode == "call" &&
            instruction.operands.size > 0) {
            output = "$output  %call_args_$instructionIndex = alloca [${instruction.operands.size} x %AblaValue], align 8\n"
        }
        if (instruction.opcode == "resource.drop") {
            output = "$output  %drop_args_$instructionIndex = alloca [1 x %AblaValue], align 8\n"
            output = "$output  %drop_result_$instructionIndex = alloca %AblaValue, align 8\n"
        }
        if ((instruction.opcode == "call.indirect" ||
             instruction.opcode == "call.indirect.once") &&
            instruction.operands.size > 1) {
            output = "$output  %indirect_args_$instructionIndex = alloca [${instruction.operands.size - 1} x %AblaValue], align 8\n"
        }
        if (instruction.opcode == "array.create" &&
            instruction.operands.size > 0) {
            output = "$output  %array_values_$instructionIndex = alloca [${instruction.operands.size} x %AblaValue], align 8\n"
        }
        instructionIndex = instructionIndex + 1
    }

    var parameter = 0
    while (parameter < function.parameters.size) {
        output = "$output  %parameter_$parameter = alloca %AblaValue, align 8\n"
        if (functionId < mayCollect.size && mayCollect[functionId]) {
            rootNames.append("parameter_$parameter")
        }
        parameter = parameter + 1
    }
    instructionIndex = 0
    while (instructionIndex < function.instructions.size) {
        val instruction = function.instructions[instructionIndex]
        if (instruction.result >= 0) {
            output = "$output  store %AblaValue zeroinitializer, ptr %v${instruction.result}, align 8\n"
        }
        if (instruction.opcode == "local.declare" ||
            instruction.opcode == "local.zero" ||
            instruction.opcode == "local.allocate") {
            output = "$output  store %AblaValue zeroinitializer, ptr %local_$instructionIndex, align 8\n"
        }
        instructionIndex = instructionIndex + 1
    }
    if (rootNames.size > 0) {
        output = "$output  %gc_frame = alloca %AblaRootFrame, align 8\n"
        output = "$output  %gc_roots = alloca [${rootNames.size} x ptr], align 8\n"
    }

    parameter = 0
    while (parameter < function.parameters.size) {
        output = "$output  %has_argument_$parameter = icmp ugt i64 %count, $parameter\n"
        output = "$output  br i1 %has_argument_$parameter, label %argument_${parameter}_present, label %argument_${parameter}_missing\n"
        output = "$output\nargument_${parameter}_present:\n"
        output = "$output  %argument_${parameter}_pointer = getelementptr %AblaValue, ptr %args, i64 $parameter\n"
        output = "$output${bootstrapLlvmCopy("argument_${parameter}_pointer", "parameter_$parameter", "argument_${parameter}_value")}" 
        output = "$output  br label %argument_${parameter}_ready\n"
        output = "$output\nargument_${parameter}_missing:\n"
        output = "$output  call void @abla_void(ptr sret(%AblaValue) align 8 %parameter_$parameter)\n"
        output = "$output  br label %argument_${parameter}_ready\n"
        output = "$output\nargument_${parameter}_ready:\n"
        parameter = parameter + 1
    }

    var root = 0
    while (root < rootNames.size) {
        output = "$output  %gc_root_$root = getelementptr [${rootNames.size} x ptr], ptr %gc_roots, i64 0, i64 $root\n"
        output = "$output  store ptr %${rootNames[root]}, ptr %gc_root_$root, align 8\n"
        root = root + 1
    }
    if (rootNames.size > 0) {
        output = "$output  %gc_roots_pointer = getelementptr [${rootNames.size} x ptr], ptr %gc_roots, i64 0, i64 0\n"
        output = "$output  call void @abla_runtime_roots_push(ptr %gc_frame, ptr %gc_roots_pointer, i64 ${rootNames.size})\n"
    }
    output = "$output  ; abla.gc.roots ${function.name} ${rootNames.size}\n"
    if (functionId < mayCollect.size && mayCollect[functionId]) {
        output = "$output  call void @abla_runtime_memory_pressure()\n"
    }

    var terminated = false
    instructionIndex = 0
    while (instructionIndex < function.instructions.size) {
        val instruction = function.instructions[instructionIndex]
        var matched = false
        var supported = true
        val reachable = !terminated || instruction.opcode == "label"
        if (!reachable) matched = true
        if (reachable) {
        if (instruction.opcode == "const.i64") {
            matched = true
            output = "$output  call void @abla_i64(ptr sret(%AblaValue) align 8 %v${instruction.result}, i64 ${instruction.text})\n"
        }
        if (instruction.opcode == "const.bool") {
            matched = true
            val value = if (instruction.text == "true") "true" else "false"
            output = "$output  call void @abla_bool(ptr sret(%AblaValue) align 8 %v${instruction.result}, i1 $value)\n"
        }
        if (instruction.opcode == "const.string") {
            matched = true
            output = "$output  %string_pointer_$instructionIndex = getelementptr [${instruction.text.size + 1} x i8], ptr @${bootstrapLlvmStringSymbolFrom(identities.symbols[functionId], instruction.result)}, i64 0, i64 0\n"
            output = "$output  call void @abla_string_static(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr %string_pointer_$instructionIndex, i64 ${instruction.text.size})\n"
        }
        if (instruction.opcode == "const.null") {
            matched = true
            output = "$output  call void @abla_null(ptr sret(%AblaValue) align 8 %v${instruction.result})\n"
        }
        if (instruction.opcode == "const.void") {
            matched = true
            output = "$output  call void @abla_void(ptr sret(%AblaValue) align 8 %v${instruction.result})\n"
        }
        if (instruction.opcode == "parameter.load") {
            matched = true
            val found = bootstrapLlvmParameterId(function, instruction.text)
            if (found < 0) supported = false
            if (found >= 0) output = "$output${bootstrapLlvmCopy("parameter_$found", "v${instruction.result}", "parameter_load_$instructionIndex")}" 
        }
        if (instruction.opcode == "parameter.default") {
            matched = true
            val found = bootstrapLlvmParameterId(function, instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                output = "$output  %needs_default_$instructionIndex = icmp ule i64 %count, ${instruction.right}\n"
                output = "$output  br i1 %needs_default_$instructionIndex, label %default_${instructionIndex}_use, label %default_${instructionIndex}_keep\n"
                output = "$output\ndefault_${instructionIndex}_use:\n"
                output = "$output${bootstrapLlvmCopy("v${instruction.left}", "parameter_$found", "default_${instructionIndex}_value")}" 
                output = "$output  br label %default_${instructionIndex}_ready\n"
                output = "$output\ndefault_${instructionIndex}_keep:\n"
                output = "$output  br label %default_${instructionIndex}_ready\n"
                output = "$output\ndefault_${instructionIndex}_ready:\n"
                output = "$output${bootstrapLlvmCopy("parameter_$found", "v${instruction.result}", "default_${instructionIndex}_result")}" 
            }
        }
        if (instruction.opcode == "local.declare") {
            matched = true
            val found = localIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                output = "$output${bootstrapLlvmCopy("v${instruction.left}", "local_$found", "local_declare_${instructionIndex}_value")}" 
                output = "$output${bootstrapLlvmCopy("local_$found", "v${instruction.result}", "local_declare_${instructionIndex}_result")}" 
            }
        }
        if (instruction.opcode == "local.load") {
            matched = true
            val found = localIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) output = "$output${bootstrapLlvmCopy("local_$found", "v${instruction.result}", "local_load_$instructionIndex")}" 
        }
        if (instruction.opcode == "resource.peek") {
            matched = true
            val parameterFound = bootstrapLlvmParameterId(
                function,
                instruction.text
            )
            val localFound = localIndex.find(instruction.text)
            if (parameterFound < 0 && localFound < 0) supported = false
            if (parameterFound >= 0) {
                output = "$output${bootstrapLlvmCopy("parameter_$parameterFound", "v${instruction.result}", "resource_peek_$instructionIndex")}" 
            }
            if (parameterFound < 0 && localFound >= 0) {
                output = "$output${bootstrapLlvmCopy("local_$localFound", "v${instruction.result}", "resource_peek_$instructionIndex")}" 
            }
        }
        if (instruction.opcode == "place.root") {
            matched = true
            val parameterFound = bootstrapLlvmParameterId(
                function,
                instruction.text
            )
            val localFound = localIndex.find(instruction.text)
            if (parameterFound < 0 && localFound < 0) supported = false
            if (parameterFound >= 0) {
                output = "$output${bootstrapLlvmCopy("parameter_$parameterFound", "v${instruction.result}", "place_root_$instructionIndex")}" 
            }
            if (parameterFound < 0 && localFound >= 0) {
                output = "$output${bootstrapLlvmCopy("local_$localFound", "v${instruction.result}", "place_root_$instructionIndex")}" 
            }
        }
        if (instruction.opcode == "place.load" ||
            instruction.opcode == "place.move" ||
            instruction.opcode == "place.set" ||
            instruction.opcode == "borrow.bind" ||
            instruction.opcode == "borrow.mutate") matched = true
        if (instruction.opcode == "local.assign") {
            matched = true
            val found = localIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                output = "$output${bootstrapLlvmCopy("v${instruction.left}", "local_$found", "local_assign_${instructionIndex}_value")}" 
                output = "$output${bootstrapLlvmCopy("local_$found", "v${instruction.result}", "local_assign_${instructionIndex}_result")}" 
            }
        }
        if (instruction.opcode == "local.zero") {
            matched = true
            val found = localIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) output = "$output  call void @abla_i64(ptr sret(%AblaValue) align 8 %local_$found, i64 0)\n"
        }
        if (instruction.opcode == "local.allocate") {
            matched = true
            val found = localIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                output = "$output  call void @abla_null(ptr sret(%AblaValue) align 8 %local_$found)\n"
            }
        }
        if (instruction.opcode == "local.move") {
            matched = true
            val parameterFound = bootstrapLlvmParameterId(
                function,
                instruction.text
            )
            val localFound = localIndex.find(instruction.text)
            if (parameterFound < 0 && localFound < 0) supported = false
            if (parameterFound >= 0) {
                output = "$output  call void @abla_null(ptr sret(%AblaValue) align 8 %parameter_$parameterFound)\n"
            }
            if (parameterFound < 0 && localFound >= 0) {
                output = "$output  call void @abla_null(ptr sret(%AblaValue) align 8 %local_$localFound)\n"
            }
        }
        if (instruction.opcode == "resource.clear") {
            matched = true
            val parameterFound = bootstrapLlvmParameterId(
                function,
                instruction.text
            )
            val localFound = localIndex.find(instruction.text)
            if (parameterFound < 0 && localFound < 0) supported = false
            if (parameterFound >= 0) {
                output = "$output  call void @abla_null(ptr sret(%AblaValue) align 8 %parameter_$parameterFound)\n"
            }
            if (parameterFound < 0 && localFound >= 0) {
                output = "$output  call void @abla_null(ptr sret(%AblaValue) align 8 %local_$localFound)\n"
            }
        }
        if (instruction.opcode == "resource.drop") {
            matched = true
            val called = functionIndex.find(
                bootstrapDropFunctionName(instruction.text)
            )
            if (called < 0) supported = false
            if (called >= 0) {
                output = "$output  %drop_tag_pointer_$instructionIndex = getelementptr %AblaValue, ptr %v${instruction.left}, i32 0, i32 0\n"
                output = "$output  %drop_tag_$instructionIndex = load i32, ptr %drop_tag_pointer_$instructionIndex, align 8\n"
                output = "$output  %drop_active_$instructionIndex = icmp ne i32 %drop_tag_$instructionIndex, 1\n"
                output = "$output  br i1 %drop_active_$instructionIndex, label %drop_${instructionIndex}_run, label %drop_${instructionIndex}_done\n"
                output = "$output\ndrop_${instructionIndex}_run:\n"
                output = "$output  %drop_arg_$instructionIndex = getelementptr [1 x %AblaValue], ptr %drop_args_$instructionIndex, i64 0, i64 0\n"
                output = "$output${bootstrapLlvmCopy("v${instruction.left}", "drop_arg_$instructionIndex", "drop_copy_$instructionIndex")}" 
                output = "$output  call void @${identities.symbols[called]}(ptr sret(%AblaValue) align 8 %drop_result_$instructionIndex, ptr %drop_arg_$instructionIndex, i64 1)\n"
                output = "$output  br label %drop_${instructionIndex}_done\n"
                output = "$output\ndrop_${instructionIndex}_done:\n"
            }
        }
        if (instruction.opcode == "closure.drop") {
            matched = true
            output =
                "$output  call void @abla_llvm_drop_closure(ptr %v${instruction.left})\n"
        }
        if (instruction.opcode == "local.set") {
            matched = true
            val found = localIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) output = "$output${bootstrapLlvmCopy("v${instruction.left}", "local_$found", "local_set_$instructionIndex")}" 
        }
        if (bootstrapLlvmIsBinary(instruction.opcode)) {
            matched = true
            val runtime = bootstrapLlvmRuntimeBinary(instruction.opcode)
            output = "$output  call void @$runtime(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left}, ptr byval(%AblaValue) align 8 %v${instruction.right})\n"
        }
        if (instruction.opcode == "neg") {
            matched = true
            output = "$output  call void @abla_negate(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "not") {
            matched = true
            output = "$output  call void @abla_not(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "function.ref") {
            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0) {
                output = "$output  call void @abla_function(ptr sret(%AblaValue) align 8 %v${instruction.result}, i32 ${identities.runtimeIds[found]})\n"
            }
        }
        if (instruction.opcode == "closure.create") {
            matched = true
            val found = functionIndex.find(instruction.text)
            if (found < 0) supported = false
            if (found >= 0 && instruction.operands.size == 0) {
                output = "$output  call void @abla_function(ptr sret(%AblaValue) align 8 %v${instruction.result}, i32 ${identities.runtimeIds[found]})\n"
            }
            if (found >= 0 && instruction.operands.size > 0) {
                var capture = 0
                while (capture < instruction.operands.size) {
                    output = "$output  %closure_value_${instructionIndex}_$capture = getelementptr [${instruction.operands.size} x %AblaValue], ptr %closure_values_$instructionIndex, i64 0, i64 $capture\n"
                    output = "$output${bootstrapLlvmCopy("v${instruction.operands[capture]}", "closure_value_${instructionIndex}_$capture", "closure_copy_${instructionIndex}_$capture")}" 
                    capture = capture + 1
                }
                output = "$output  %closure_pointer_$instructionIndex = getelementptr [${instruction.operands.size} x %AblaValue], ptr %closure_values_$instructionIndex, i64 0, i64 0\n"
                output = "$output  call void @abla_closure(ptr sret(%AblaValue) align 8 %v${instruction.result}, i32 ${identities.runtimeIds[found]}, ptr %closure_pointer_$instructionIndex, i64 ${instruction.operands.size})\n"
            }
        }
        if (instruction.opcode == "cell.create") {
            matched = true
            output = "$output  call void @abla_cell_create(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "cell.get") {
            matched = true
            output = "$output  call void @abla_cell_get(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "cell.set") {
            matched = true
            output = "$output  call void @abla_cell_set(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.operands[0]}, ptr byval(%AblaValue) align 8 %v${instruction.operands[1]})\n"
        }
        if (instruction.opcode == "shared.create") {
            matched = true
            output = "$output  call void @abla_shared_create(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "shared.clone") {
            matched = true
            output = "$output  call void @abla_shared_clone(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "shared.get") {
            matched = true
            output = "$output  call void @abla_shared_get(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "shared.lock") {
            matched = true
            output = "$output  call void @abla_shared_lock(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "shared.unlock") {
            matched = true
            output = "$output  call void @abla_shared_unlock(ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "shared.release") {
            matched = true
            output = "$output  call void @abla_shared_release(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "weak.create") {
            matched = true
            output = "$output  call void @abla_weak_create(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "weak.clone") {
            matched = true
            output = "$output  call void @abla_weak_clone(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "weak.upgrade") {
            matched = true
            output = "$output  call void @abla_weak_upgrade(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "weak.alive") {
            matched = true
            output = "$output  call void @abla_weak_alive(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "weak.release") {
            matched = true
            output = "$output  call void @abla_weak_release(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
        }
        if (instruction.opcode == "&&" || instruction.opcode == "||") {
            matched = true
            output = "$output  %boolean_${instructionIndex}_left = call i1 @abla_as_bool(ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
            output = "$output  %boolean_${instructionIndex}_right = call i1 @abla_as_bool(ptr byval(%AblaValue) align 8 %v${instruction.right})\n"
            val operation = if (instruction.opcode == "&&") "and" else "or"
            output = "$output  %boolean_${instructionIndex}_result = $operation i1 %boolean_${instructionIndex}_left, %boolean_${instructionIndex}_right\n"
            output = "$output  call void @abla_bool(ptr sret(%AblaValue) align 8 %v${instruction.result}, i1 %boolean_${instructionIndex}_result)\n"
        }
        if (instruction.opcode == "return") {
            matched = true
            output = "$output${bootstrapLlvmCopy("v${instruction.left}", "out", "early_return_$instructionIndex")}" 
            if (rootNames.size > 0) {
                output = "$output  call void @abla_runtime_roots_pop(ptr %gc_frame)\n"
            }
            output = "$output  ret void\n"
            terminated = true
        }
        if (instruction.opcode == "unreachable") {
            matched = true
            output = "$output  %when_message_$instructionIndex = getelementptr [20 x i8], ptr @abla_non_exhaustive_when, i64 0, i64 0\n"
            output = "$output  call void @abla_runtime_panic(ptr %when_message_$instructionIndex, i64 19)\n"
            output = "$output  unreachable\n"
            terminated = true
        }
        if (instruction.opcode == "label") {
            matched = true
            if (!terminated) output = "$output  br label %label_${instruction.target}\n"
            output = "$output\nlabel_${instruction.target}:\n"
            terminated = false
        }
        if (instruction.opcode == "jump") {
            matched = true
            output = "$output  br label %label_${instruction.target}\n"
            terminated = true
        }
        if (instruction.opcode == "branch") {
            matched = true
            output = "$output  %branch_condition_$instructionIndex = call i1 @abla_as_bool(ptr byval(%AblaValue) align 8 %v${instruction.left})\n"
            output = "$output  br i1 %branch_condition_$instructionIndex, label %label_${instruction.target}, label %label_${instruction.alternate}\n"
            terminated = true
        }
        if (instruction.opcode == "call") {
            matched = true
            val called = functionIndex.find(instruction.text)
            if (called < 0) supported = false
            if (called >= 0 && instruction.operands.size == 0) {
                output = "$output  call void @${identities.symbols[called]}(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr null, i64 0)\n"
            }
            if (called >= 0 && instruction.operands.size > 0) {
                var operand = 0
                while (operand < instruction.operands.size) {
                    output = "$output  %call_arg_${instructionIndex}_$operand = getelementptr [${instruction.operands.size} x %AblaValue], ptr %call_args_$instructionIndex, i64 0, i64 $operand\n"
                    output = "$output${bootstrapLlvmCopy("v${instruction.operands[operand]}", "call_arg_${instructionIndex}_$operand", "call_value_${instructionIndex}_$operand")}" 
                    operand = operand + 1
                }
                output = "$output  %call_args_${instructionIndex}_pointer = getelementptr [${instruction.operands.size} x %AblaValue], ptr %call_args_$instructionIndex, i64 0, i64 0\n"
                output = "$output  call void @${identities.symbols[called]}(ptr sret(%AblaValue) align 8 %v${instruction.result}, ptr %call_args_${instructionIndex}_pointer, i64 ${instruction.operands.size})\n"
            }
        }
        if (instruction.opcode == "extern.host") {
            matched = true
            output = "$output  call void @${instruction.text}(ptr sret(%AblaValue) align 8 %v${instruction.result}"
            var operand = 0
            while (operand < instruction.operands.size) {
                output = "$output, ptr byval(%AblaValue) align 8 %v${instruction.operands[operand]}"
                operand = operand + 1
            }
            output = "$output)\n"
        }
        if (instruction.opcode == "extern.c") {
            matched = true
            var operand = 0
            while (operand < instruction.operands.size) {
                val parameterType = bootstrapLlvmNativeParameterType(
                    program,
                    nativeIndex,
                    instruction.text,
                    operand
                )
                if (parameterType == "i64" || parameterType == "u64") {
                    output = "$output  %native_argument_${instructionIndex}_$operand = call i64 @abla_as_i64(ptr byval(%AblaValue) align 8 %v${instruction.operands[operand]})\n"
                } else if (bootstrapLlvmIsNarrowNativeInteger(parameterType)) {
                    output = "$output  %native_argument_integer_${instructionIndex}_$operand = call i64 @abla_as_i64(ptr byval(%AblaValue) align 8 %v${instruction.operands[operand]})\n"
                    output = "$output  %native_argument_${instructionIndex}_$operand = trunc i64 %native_argument_integer_${instructionIndex}_$operand to ${bootstrapLlvmNativeType(parameterType)}\n"
                } else if (parameterType == "bool") {
                    output = "$output  %native_argument_${instructionIndex}_$operand = call i1 @abla_as_bool(ptr byval(%AblaValue) align 8 %v${instruction.operands[operand]})\n"
                } else if (parameterType == "cstring") {
                    output = "$output  %native_argument_${instructionIndex}_$operand = call ptr @abla_as_cstring(ptr byval(%AblaValue) align 8 %v${instruction.operands[operand]})\n"
                } else if (bootstrapLlvmIsPointerType(parameterType)) {
                    output = "$output  %native_argument_integer_${instructionIndex}_$operand = call i64 @abla_as_i64(ptr byval(%AblaValue) align 8 %v${instruction.operands[operand]})\n"
                    output = "$output  %native_argument_${instructionIndex}_$operand = inttoptr i64 %native_argument_integer_${instructionIndex}_$operand to ptr\n"
                } else {
                    supported = false
                    output = output
                }
                operand = operand + 1
            }
            val resultType = bootstrapLlvmNativeResultType(
                program,
                nativeIndex,
                instruction.text
            )
            val nativeResultType = bootstrapLlvmNativeType(resultType)
            if (nativeResultType == "unknown" || resultType == "cstring") {
                supported = false
            }
            if (resultType == "void") output = "$output  call void @${instruction.text}("
            else output = "$output  %native_result_$instructionIndex = call $nativeResultType @${instruction.text}("
            operand = 0
            while (operand < instruction.operands.size) {
                if (operand > 0) output = "$output, "
                val parameterType = bootstrapLlvmNativeParameterType(
                    program,
                    nativeIndex,
                    instruction.text,
                    operand
                )
                output = "${output}${bootstrapLlvmNativeType(parameterType)} %native_argument_${instructionIndex}_$operand"
                operand = operand + 1
            }
            output = "$output)\n"
            if (resultType == "i64" || resultType == "u64") {
                output = "$output  call void @abla_i64(ptr sret(%AblaValue) align 8 %v${instruction.result}, i64 %native_result_$instructionIndex)\n"
            }
            if (bootstrapLlvmIsNarrowNativeInteger(resultType)) {
                val extension = if (bootstrapLlvmIsUnsignedNativeInteger(
                    resultType
