    output = "${output}define internal void @abla_not_equal(ptr noalias sret(%AblaValue) align 8 %out, ptr byval(%AblaValue) align 8 %left, ptr byval(%AblaValue) align 8 %right) {\nentry:\n  %equal = alloca %AblaValue, align 8\n  call void @abla_equal(ptr sret(%AblaValue) align 8 %equal, ptr byval(%AblaValue) align 8 %left, ptr byval(%AblaValue) align 8 %right)\n  %same = call i1 @abla_as_bool(ptr byval(%AblaValue) align 8 %equal)\n  %different = xor i1 %same, true\n  call void @abla_bool(ptr sret(%AblaValue) align 8 %out, i1 %different)\n  ret void\n}\n\n"
