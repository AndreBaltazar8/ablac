        }

        if (!matched || !supported) {
            output = "$output  ; abla.backend.error unsupported ${instruction.opcode} ${instruction.text}\n"
            errors = errors + 1
        }
        instructionIndex = instructionIndex + 1
    }

    if (!terminated && function.result >= 0) {
        output = "$output${bootstrapLlvmCopy("v${function.result}", "out", "function_result")}" 
        if (rootNames.size > 0) {
            output = "$output  call void @abla_runtime_roots_pop(ptr %gc_frame)\n"
        }
        output = "$output  ret void\n"
    }
    if (!terminated && function.result < 0) {
        output = "$output  call void @abla_void(ptr sret(%AblaValue) align 8 %out)\n"
        if (rootNames.size > 0) {
            output = "$output  call void @abla_runtime_roots_pop(ptr %gc_frame)\n"
        }
        output = "$output  ret void\n"
    }
    BootstrapLlvmEmission("$output}\n\n", errors, "[]")
}

fun bootstrapLlvmClosureDropDispatcher(
    program: BootstrapIrProgram,
    functionIndex: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities
): string {
    var output =
        "define internal void @abla_llvm_release_closure(ptr %function) {\nentry:\n"
    output = "$output  %captures = call ptr @abla_function_capture_pointer(ptr byval(%AblaValue) align 8 %function)\n"
    output = "$output  call void @abla_runtime_free(ptr %captures)\n"
    output = "$output  ret void\n}\n\n"
    output = "${output}define internal void @abla_llvm_drop_closure(ptr %function) {\nentry:\n"
    output = "$output  %drop_result = alloca %AblaValue, align 8\n"
    output = "$output  %function_id = call i32 @abla_as_function(ptr byval(%AblaValue) align 8 %function)\n"
    output = "$output  %captures = call ptr @abla_function_capture_pointer(ptr byval(%AblaValue) align 8 %function)\n"
    output = "$output  %capture_count = call i64 @abla_function_capture_count(ptr byval(%AblaValue) align 8 %function)\n"
    output = "$output  switch i32 %function_id, label %release [\n"
    var original = 0
    while (original < program.functions.size) {
        val drop = functionIndex.find(bootstrapClosureDropFunctionName(
            program.functions[original].name
        ))
        if (drop >= 0) {
            output = "$output    i32 ${identities.runtimeIds[original]}, label %drop_$original\n"
        }
        original = original + 1
    }
    output = "$output  ]\n"
    original = 0
    while (original < program.functions.size) {
        val drop = functionIndex.find(bootstrapClosureDropFunctionName(
            program.functions[original].name
        ))
        if (drop >= 0) {
            output = "$output\ndrop_$original:\n"
            output = "$output  call void @${identities.symbols[drop]}(ptr sret(%AblaValue) align 8 %drop_result, ptr %captures, i64 %capture_count)\n"
            output = "$output  br label %release\n"
        }
        original = original + 1
    }
    output = "$output\nrelease:\n"
    output = "$output  call void @abla_runtime_free(ptr %captures)\n"
    "$output  ret void\n}\n\n"
}

fun bootstrapLlvmIndirectDispatcher(
    program: BootstrapIrProgram,
    addressTaken: array<bool>,
    identities: BootstrapLlvmFunctionIdentities
): string {
    var output =
        "define internal void @abla_llvm_call_indirect(ptr noalias sret(%AblaValue) align 8 %out, ptr %function, ptr %args, i64 %count) {\nentry:\n"
    output = "$output  %indirect_frame = alloca %AblaRootFrame, align 8\n"
    output = "$output  %merged_root_value = alloca %AblaValue, align 8\n"
    output = "$output  %capture_count = call i64 @abla_function_capture_count(ptr byval(%AblaValue) align 8 %function)\n"
    output = "$output  %total = add i64 %capture_count, %count\n"
    output = "$output  %bytes = mul i64 %total, 40\n"
    output = "$output  %merged = call ptr @abla_runtime_alloc(i64 %bytes)\n"
    output = "$output  call void @abla_runtime_memory_set_layout(ptr %merged, i64 2)\n"
    output = "$output  %root_count = add i64 %total, 1\n"
    output = "$output  %indirect_roots = alloca ptr, i64 %root_count, align 8\n"
    output = "$output  %merged_integer = ptrtoint ptr %merged to i64\n"
    output = "$output  %merged_root_payload = insertvalue %AblaPayload zeroinitializer, i64 %merged_integer, 0\n"
    output = "$output  %merged_root_tagged = insertvalue %AblaValue zeroinitializer, i32 7, 0\n"
    output = "$output  %merged_root_boxed = insertvalue %AblaValue %merged_root_tagged, %AblaPayload %merged_root_payload, 1\n"
    output = "$output  store %AblaValue %merged_root_boxed, ptr %merged_root_value, align 8\n"
    output = "$output  store ptr %merged_root_value, ptr %indirect_roots, align 8\n"
    output = "$output  br label %capture_condition\n"
    output = "$output\ncapture_condition:\n"
    output = "$output  %capture_index = phi i64 [ 0, %entry ], [ %capture_next, %capture_body ]\n"
    output = "$output  %capture_more = icmp ult i64 %capture_index, %capture_count\n"
    output = "$output  br i1 %capture_more, label %capture_body, label %argument_condition\n"
    output = "$output\ncapture_body:\n"
    output = "$output  %capture_destination = getelementptr %AblaValue, ptr %merged, i64 %capture_index\n"
    output = "$output  call void @abla_function_capture(ptr sret(%AblaValue) align 8 %capture_destination, ptr byval(%AblaValue) align 8 %function, i64 %capture_index)\n"
    output = "$output  %capture_root_index = add i64 %capture_index, 1\n"
    output = "$output  %capture_root = getelementptr ptr, ptr %indirect_roots, i64 %capture_root_index\n"
    output = "$output  store ptr %capture_destination, ptr %capture_root, align 8\n"
    output = "$output  %capture_next = add i64 %capture_index, 1\n"
    output = "$output  br label %capture_condition\n"
    output = "$output\nargument_condition:\n"
    output = "$output  %argument_index = phi i64 [ 0, %capture_condition ], [ %argument_next, %argument_body ]\n"
    output = "$output  %argument_more = icmp ult i64 %argument_index, %count\n"
    output = "$output  br i1 %argument_more, label %argument_body, label %dispatch\n"
    output = "$output\nargument_body:\n"
    output = "$output  %argument_source = getelementptr %AblaValue, ptr %args, i64 %argument_index\n"
    output = "$output  %argument_position = add i64 %capture_count, %argument_index\n"
    output = "$output  %argument_destination = getelementptr %AblaValue, ptr %merged, i64 %argument_position\n"
    output = "$output  %argument_value = load %AblaValue, ptr %argument_source, align 8\n"
    output = "$output  store %AblaValue %argument_value, ptr %argument_destination, align 8\n"
    output = "$output  %argument_root_index = add i64 %argument_position, 1\n"
    output = "$output  %argument_root = getelementptr ptr, ptr %indirect_roots, i64 %argument_root_index\n"
    output = "$output  store ptr %argument_destination, ptr %argument_root, align 8\n"
    output = "$output  %argument_next = add i64 %argument_index, 1\n"
    output = "$output  br label %argument_condition\n"
    output = "$output\ndispatch:\n"
    output = "$output  call void @abla_runtime_roots_push(ptr %indirect_frame, ptr %indirect_roots, i64 %root_count)\n"
    output = "$output  %function_id = call i32 @abla_as_function(ptr byval(%AblaValue) align 8 %function)\n"
    output = "$output  switch i32 %function_id, label %invalid_function [\n"
    var functionIndex = 0
    while (functionIndex < program.functions.size) {
        if (addressTaken[functionIndex]) {
            output = "$output    i32 ${identities.runtimeIds[functionIndex]}, label %indirect_$functionIndex\n"
        }
        functionIndex = functionIndex + 1
    }
    output = "$output  ]\n"
    functionIndex = 0
    while (functionIndex < program.functions.size) {
        if (addressTaken[functionIndex]) {
            output = "$output\nindirect_$functionIndex:\n"
            output = "$output  call void @${identities.symbols[functionIndex]}(ptr sret(%AblaValue) align 8 %out, ptr %merged, i64 %total)\n"
            output = "$output  br label %indirect_done\n"
        }
        functionIndex = functionIndex + 1
    }
    output = "$output\ninvalid_function:\n"
    output = "$output  %invalid_message = getelementptr [27 x i8], ptr @abla_invalid_function, i64 0, i64 0\n"
    output = "$output  call void @abla_runtime_panic(ptr %invalid_message, i64 26)\n"
    output = "$output  unreachable\n"
    output = "$output\nindirect_done:\n"
    output = "$output  call void @abla_runtime_roots_pop(ptr %indirect_frame)\n"
    output = "$output  call void @abla_runtime_free(ptr %merged)\n"
    "$output  ret void\n}\n\n"
}

fun bootstrapLlvmExportAdapters(
    exports: array<BootstrapExportRequest>,
    functionNames: BootstrapLlvmNameIndex,
    identities: BootstrapLlvmFunctionIdentities
): BootstrapLlvmEmission {
    var output = ""
    var errors = 0
    var index = 0
    while (index < exports.size) {
        val request = exports[index]
        val function = functionNames.find(request.source)
        if (function < 0 || function >= identities.symbols.size) {
            errors = errors + 1
        } else {
            var llvmResult = "void"
            if (request.resultType == "i64") llvmResult = "i64"
            if (request.resultType == "bool") llvmResult = "i8"
            output = "${output}define $llvmResult @${request.name}() {\nentry:\n"
            output = "$output  %result = alloca %AblaValue, align 8\n"
            output = "$output  call void @${identities.symbols[function]}(ptr sret(%AblaValue) align 8 %result, ptr null, i64 0)\n"
            if (request.resultType == "i64") {
                output = "$output  %value = call i64 @abla_as_i64(ptr byval(%AblaValue) align 8 %result)\n"
                output = "$output  ret i64 %value\n"
            }
            if (request.resultType == "bool") {
                output = "$output  %boolean = call i1 @abla_as_bool(ptr byval(%AblaValue) align 8 %result)\n"
                output = "$output  %value = zext i1 %boolean to i8\n"
                output = "$output  ret i8 %value\n"
            }
            if (request.resultType == "void") output = "$output  ret void\n"
            output = "$output}\n\n"
        }
        index = index + 1
    }
    BootstrapLlvmEmission(output, errors, "[]")
}

fun bootstrapLlvmJsonEscape(value: string): string {
    var output = ""
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        if (byte == 34) output = "$output\\\""
        else if (byte == 92) output = "$output\\\\"
        else if (byte == 10) output = "$output\\n"
        else if (byte == 13) output = "$output\\r"
        else if (byte == 9) output = "$output\\t"
        else output = "$output${value.slice(index, index + 1)}"
        index = index + 1
    }
    output
}

fun bootstrapLlvmExportAbi(
    exports: array<BootstrapExportRequest>
): string {
    var output = "["
    var index = 0
    while (index < exports.size) {
        val request = exports[index]
        var abi = request.resultType
        var ownership = "value"
        if (request.resultType == "bool") abi = "u8-bool"
        if (request.resultType == "void") ownership = "none"
        if (index > 0) output = "$output,"
        output = "$output\n    {\"source\":\"${bootstrapLlvmJsonEscape(
            request.source
        )}\",\"symbol\":\"${request.name}\",\"parameters\":[],\"result\":{\"abi\":\"$abi\",\"ownership\":\"$ownership\",\"nullable\":false},\"failure\":{\"panic\":\"not-contained\"}}"
        index = index + 1
    }
    if (exports.size > 0) output = "$output\n  "
    "$output]"
}

fun bootstrapEmitLlvmProgram(
    program: BootstrapIrProgram
): BootstrapLlvmEmission {
    val exports = bootstrapTakeExportRequests()
    val functionNames: array<string> = []
    var nameIndex = 0
    while (nameIndex < program.functions.size) {
        functionNames.append(program.functions[nameIndex].name)
        nameIndex = nameIndex + 1
    }
    val nativeNames: array<string> = []
    nameIndex = 0
    while (nameIndex < program.natives.size) {
        nativeNames.append(program.natives[nameIndex].name)
        nameIndex = nameIndex + 1
    }
    val functionNamesIndex = bootstrapLlvmNameIndex(functionNames)
    val nativeNamesIndex = bootstrapLlvmNameIndex(nativeNames)
    val globalNamesIndex = bootstrapLlvmGlobalIndex(program)
    val classNamesIndex = bootstrapLlvmClassIndex(program)
    val fieldNamesIndex = bootstrapLlvmFieldIndex(program)
    val addressTaken = bootstrapLlvmAddressTaken(program, functionNamesIndex)
    val mayCollect = bootstrapLlvmCollectingFunctions(
        program,
        functionNamesIndex,
        addressTaken
    )
    val identities = bootstrapLlvmFunctionIdentities(program)
    var output = bootstrapLlvmHeader(program)
    var errors = program.errors + identities.collisions +
        bootstrapLlvmStableNameCollisions(classNamesIndex.names) +
        bootstrapLlvmStableNameCollisions(fieldNamesIndex.names)
    output = "$output@abla_invalid_function = private unnamed_addr constant [27 x i8] c\"invalid function reference\\00\", align 1\n@abla_non_exhaustive_when = private unnamed_addr constant [20 x i8] c\"non-exhaustive when\\00\", align 1\n"

    var stringFunction = 0
    while (stringFunction < program.functions.size) {
        var stringInstruction = 0
        while (stringInstruction <
               program.functions[stringFunction].instructions.size) {
            val instruction =
                program.functions[stringFunction].instructions[stringInstruction]
            if (instruction.opcode == "const.string") {
                output = "$output@${bootstrapLlvmStringSymbolFrom(identities.symbols[stringFunction], instruction.result)} = hidden unnamed_addr constant [${instruction.text.size + 1} x i8] c\"${bootstrapLlvmBytes(instruction.text)}\", align 1\n"
            }
            stringInstruction = stringInstruction + 1
        }
        stringFunction = stringFunction + 1
    }
    output = "$output\n"

    var globalIndex = 0
    while (globalIndex < program.instructions.size) {
        if (program.instructions[globalIndex].opcode == "global.store") {
            output = "$output@${bootstrapLlvmGlobalSymbol(program.instructions[globalIndex].text)} = hidden global %AblaValue zeroinitializer, align 8\n"
        }
        globalIndex = globalIndex + 1
    }
    if (program.instructions.size > 0) output = "$output\n"

    val declaredHost: array<string> = []
    val declaredNative: array<string> = []
    if (!bootstrapLlvmNeedsHostRuntime(program)) {
        declaredNative.append("malloc")
        declaredNative.append("free")
    }
    var declarationFunction = 0
    while (declarationFunction < program.functions.size) {
        var declarationInstruction = 0
        while (declarationInstruction <
               program.functions[declarationFunction].instructions.size) {
            val declaration = program.functions[declarationFunction]
            val instruction = declaration.instructions[declarationInstruction]
            if (instruction.opcode == "extern.host") {
                var seen = false
                var seenIndex = 0
                while (seenIndex < declaredHost.size) {
                    if (declaredHost[seenIndex] == instruction.text) seen = true
                    seenIndex = seenIndex + 1
                }
                if (!seen) {
                    declaredHost.append(instruction.text)
                    output = "${output}declare void @${instruction.text}(ptr sret(%AblaValue) align 8"
                    var parameter = 0
                    while (parameter < instruction.operands.size) {
                        output = "$output, ptr byval(%AblaValue) align 8"
                        parameter = parameter + 1
                    }
                    output = "$output)\n"
                }
            }
            if (instruction.opcode == "extern.c") {
                var seen = false
                var seenIndex = 0
                while (seenIndex < declaredNative.size) {
                    if (declaredNative[seenIndex] == instruction.text) seen = true
                    seenIndex = seenIndex + 1
                }
                if (!seen) {
                    declaredNative.append(instruction.text)
                    val resultType = bootstrapLlvmNativeResultType(
                        program,
                        nativeNamesIndex,
                        instruction.text
                    )
                    output = "${output}declare ${bootstrapLlvmNativeType(resultType)} @${instruction.text}("
                    var parameter = 0
                    while (parameter < instruction.operands.size) {
                        if (parameter > 0) output = "$output, "
                        output = "${output}${bootstrapLlvmNativeType(
                            bootstrapLlvmNativeParameterType(
                                program,
                                nativeNamesIndex,
                                instruction.text,
                                parameter
                            )
                        )}"
                        parameter = parameter + 1
                    }
                    output = "$output)\n"
                }
            }
            declarationInstruction = declarationInstruction + 1
        }
        declarationFunction = declarationFunction + 1
    }
    if (declaredHost.size > 0 || declaredNative.size > 0) {
        output = "$output\n"
    }

    var functionIndex = 0
    while (functionIndex < program.functions.size) {
        val emitted = bootstrapLlvmEmitFunction(
            program,
            program.functions[functionIndex],
            functionIndex,
            functionNamesIndex,
            identities,
            nativeNamesIndex,
            globalNamesIndex,
            classNamesIndex,
            fieldNamesIndex,
            mayCollect
        )
        output = "$output${emitted.output}"
        errors = errors + emitted.errors
        functionIndex = functionIndex + 1
    }


    output = "$output${bootstrapLlvmClosureDropDispatcher(
        program,
        functionNamesIndex,
        identities
    )}"
    output = "$output${bootstrapLlvmIndirectDispatcher(
        program,
        addressTaken,
        identities
    )}"

    val mainId = functionNamesIndex.find("main")
    val globalsId = functionNamesIndex.find("__bootstrap_globals")
    val exportAdapters = bootstrapLlvmExportAdapters(
        exports,
        functionNamesIndex,
        identities
    )
    output = "$output${exportAdapters.output}"
    errors = errors + exportAdapters.errors
    if (exports.size > 0 && globalsId >= 0) {
        output = "$output@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @abla_export_initialize, ptr null }]\n"
        output = "${output}define internal void @abla_export_initialize() {\nentry:\n"
        output = "$output  %result = alloca %AblaValue, align 8\n"
        output = "$output  call void @${identities.symbols[globalsId]}(ptr sret(%AblaValue) align 8 %result, ptr null, i64 0)\n"
        output = "$output  ret void\n}\n\n"
    }

    if (mainId >= 0) {
        output = "${output}define i32 @main(i32 %argc, ptr %argv) {\nentry:\n"
    if (globalNamesIndex.names.size > 0) {
        output = "$output  %global_gc_frame = alloca %AblaRootFrame, align 8\n"
        output = "$output  %global_gc_roots = alloca [${globalNamesIndex.names.size} x ptr], align 8\n"
        var globalRoot = 0
        while (globalRoot < globalNamesIndex.names.size) {
            output = "$output  %global_gc_root_$globalRoot = getelementptr [${globalNamesIndex.names.size} x ptr], ptr %global_gc_roots, i64 0, i64 $globalRoot\n"
            output = "$output  store ptr @${bootstrapLlvmGlobalSymbol(globalNamesIndex.names[globalRoot])}, ptr %global_gc_root_$globalRoot, align 8\n"
            globalRoot = globalRoot + 1
        }
        output = "$output  %global_gc_roots_pointer = getelementptr [${globalNamesIndex.names.size} x ptr], ptr %global_gc_roots, i64 0, i64 0\n"
        output = "$output  call void @abla_runtime_roots_push(ptr %global_gc_frame, ptr %global_gc_roots_pointer, i64 ${globalNamesIndex.names.size})\n"
    }
    output = "$output  store i32 %argc, ptr @abla_process_argc, align 4\n"
    output = "$output  store ptr %argv, ptr @abla_process_argv, align 8\n"
    output = "$output  %process_argc_wide = sext i32 %argc to i64\n"
    output = "$output  %process_environment_index = add i64 %process_argc_wide, 1\n"
    output = "$output  %process_environment_candidate = getelementptr ptr, ptr %argv, i64 %process_environment_index\n"
    output = "$output  %process_has_argv = icmp ne ptr %argv, null\n"
    output = "$output  %process_environment = select i1 %process_has_argv, ptr %process_environment_candidate, ptr null\n"
    output = "$output  store ptr %process_environment, ptr @abla_process_envp, align 8\n"
    if (bootstrapLlvmNeedsHostRuntime(program)) {
        output = "$output  call void @abla_host_set_arguments(i32 %argc, ptr %argv)\n"
    }
    if (globalsId >= 0 && exports.size == 0) {
        output = "$output  %global_result = alloca %AblaValue, align 8\n"
        output = "$output  call void @${identities.symbols[globalsId]}(ptr sret(%AblaValue) align 8 %global_result, ptr null, i64 0)\n"
    }
        output = "$output  %main_result = alloca %AblaValue, align 8\n"
        output = "$output  call void @${identities.symbols[mainId]}(ptr sret(%AblaValue) align 8 %main_result, ptr null, i64 0)\n"
        output = "$output  %main_status_i64 = call i64 @abla_as_i64(ptr byval(%AblaValue) align 8 %main_result)\n"
        output = "$output  %main_status = trunc i64 %main_status_i64 to i32\n"
        output = "$output  ret i32 %main_status\n"
        output = "$output}\n"
    }
    if (mainId < 0 && exports.size == 0) errors = errors + 1
    BootstrapLlvmEmission(output, errors, bootstrapLlvmExportAbi(exports))
}

fun bootstrapCompileLlvmParsedCached(
    parsed: BootstrapParseResult,
    var cache: BootstrapIrCacheState
): BootstrapLlvmCompilation {
    val analyzed = bootstrapAnalyzeParsed(parsed)
    val program = bootstrapLowerParsedCached(parsed, analyzed, cache)
    val emitted = bootstrapEmitLlvmProgram(program)
    var diagnostics = analyzed.diagnostics
    diagnostics = "${diagnostics}${bootstrapTakeDriverDiagnostics()}"
    if (program.errors > analyzed.errors) {
        diagnostics =
            "${diagnostics}ir.verification:${program.errors - analyzed.errors}\n${bootstrapIrVerificationDiagnostics(program)}"
    }
    BootstrapLlvmCompilation(
        emitted.output,
        emitted.errors,
        parsed.errors - parsed.extensionErrors,
        parsed.extensionErrors + analyzed.extensionErrors,
        analyzed.errors - parsed.errors - analyzed.extensionErrors,
        diagnostics,
        bootstrapLlvmNeedsLlvm(program),
        bootstrapLlvmNeedsHostRuntime(program),
        program.compileInputPaths,
        program.compileInputContents,
        emitted.abiExports
    )
}

fun bootstrapCompileLlvmParsed(
    parsed: BootstrapParseResult
): BootstrapLlvmCompilation {
    val cache = bootstrapIrTransientState()
    bootstrapCompileLlvmParsedCached(parsed, cache)
}

fun bootstrapCompileLlvm(source: string): BootstrapLlvmCompilation =
    bootstrapCompileLlvmParsed(bootstrapParseStaged(source))

fun bootstrapEmitLlvm(source: string): string =
    bootstrapCompileLlvm(source).output
