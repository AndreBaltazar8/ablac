        if (collectorEnabled) uninitializedClear = "true"
        output = "@abla_runtime_panic_prefix = private unnamed_addr constant [13 x i8] c\"abla panic: \\00\", align 1\n@abla_runtime_panic_newline = private unnamed_addr constant [2 x i8] c\"\\0A\\00\", align 1\n@abla_runtime_out_of_memory = private unnamed_addr constant [14 x i8] c\"out of memory\\00\", align 1\n@abla_runtime_memory_limit_exceeded = private unnamed_addr constant [22 x i8] c\"memory limit exceeded\\00\", align 1\n@abla_runtime_invalid_memory_limit = private unnamed_addr constant [21 x i8] c\"invalid memory limit\\00\", align 1\n@abla_runtime_invalid_checkpoint = private unnamed_addr constant [26 x i8] c\"invalid memory checkpoint\\00\", align 1\n@abla_runtime_allocation_tail = internal global ptr null, align 8\n@abla_runtime_allocation_generation = internal global i64 0, align 8\n@abla_runtime_allocation_live_bytes = internal global i64 0, align 8\n@abla_runtime_allocation_limit = internal global i64 1073741824, align 8\n\ndeclare ptr @malloc(i64)\ndeclare void @free(ptr)\n\n"
        output = "${output}@abla_runtime_invalid_scan_size = private unnamed_addr constant [25 x i8] c\"invalid memory scan size\\00\", align 1\n\n"
        output = "${output}define internal void @abla_runtime_panic(ptr %message, i64 %length) noreturn {\nentry:\n  %prefix = getelementptr [13 x i8], ptr @abla_runtime_panic_prefix, i64 0, i64 0\n  %prefix_integer = ptrtoint ptr %prefix to i64\n  %prefix_written = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, i64 %prefix_integer, i64 12)\n  %message_integer = ptrtoint ptr %message to i64\n  %message_written = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, i64 %message_integer, i64 %length)\n  %newline = getelementptr [2 x i8], ptr @abla_runtime_panic_newline, i64 0, i64 0\n  %newline_integer = ptrtoint ptr %newline to i64\n  %newline_written = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}\"(i64 1, i64 2, i64 %newline_integer, i64 1)\n  %exited = call i64 asm sideeffect \"syscall\", \"={rax},{rax},{rdi},~{rcx},~{r11},~{memory}\"(i64 231, i64 134)\n  unreachable\n}\n\n"
        output = "${output}define internal ptr @abla_runtime_alloc_internal(i64 %requested, i1 %clear) {\nentry:\n  %empty = icmp eq i64 %requested, 0\n  %size = select i1 %empty, i64 1, i64 %requested\n  %total = add i64 %size, 40\n  %overflow = icmp ult i64 %total, %size\n  br i1 %overflow, label %failed, label %allocate\nallocate:\n  %header = call ptr @malloc(i64 %total)\n  %valid = icmp ne ptr %header, null\n  br i1 %valid, label %initialize, label %failed\ninitialize:\n  %previous_slot = getelementptr i8, ptr %header, i64 0\n  %next_slot = getelementptr i8, ptr %header, i64 8\n  %generation_slot = getelementptr i8, ptr %header, i64 16\n  %size_slot = getelementptr i8, ptr %header, i64 24\n  %scan_size_slot = getelementptr i8, ptr %header, i64 32\n  %previous = load ptr, ptr @abla_runtime_allocation_tail, align 8\n  %generation = load i64, ptr @abla_runtime_allocation_generation, align 8\n  %next_generation = add i64 %generation, 1\n  %live = load i64, ptr @abla_runtime_allocation_live_bytes, align 8\n  %next_live = add i64 %live, %size\n  %live_overflow = icmp ult i64 %next_live, %live\n  %limit = load i64, ptr @abla_runtime_allocation_limit, align 8\n  %over_limit = icmp ugt i64 %next_live, %limit\n  %live_budget_failed = or i1 %live_overflow, %over_limit\n  %generation_failed = icmp eq i64 %generation, 9223372036854775807\n  %budget_failed = or i1 %live_budget_failed, %generation_failed\n  br i1 %budget_failed, label %limit_failed, label %record\nrecord:\n  store ptr %previous, ptr %previous_slot, align 8\n  store ptr null, ptr %next_slot, align 8\n  store i64 %next_generation, ptr %generation_slot, align 8\n  store i64 %size, ptr %size_slot, align 8\n  %initial_scan = or i64 %size, 72057594037927936\n  store i64 %initial_scan, ptr %scan_size_slot, align 8\n  store i64 %next_generation, ptr @abla_runtime_allocation_generation, align 8\n  store i64 %next_live, ptr @abla_runtime_allocation_live_bytes, align 8\n  store ptr %header, ptr @abla_runtime_allocation_tail, align 8\n  %has_previous = icmp ne ptr %previous, null\n  br i1 %has_previous, label %connect, label %ready\nconnect:\n  %previous_next = getelementptr i8, ptr %previous, i64 8\n  store ptr %header, ptr %previous_next, align 8\n  br label %ready\nready:\n  %payload = getelementptr i8, ptr %header, i64 40\n  br i1 %clear, label %clear_payload, label %return\nclear_payload:\n  call void @llvm.memset.p0.i64(ptr align 8 %payload, i8 0, i64 %size, i1 false)\n  br label %return\nreturn:\n  ret ptr %payload\nlimit_failed:\n  call void @free(ptr %header)\n  %limit_message = getelementptr [22 x i8], ptr @abla_runtime_memory_limit_exceeded, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %limit_message, i64 21)\n  unreachable\nfailed:\n  %message = getelementptr [14 x i8], ptr @abla_runtime_out_of_memory, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 13)\n  unreachable\n}\n\ndefine internal ptr @abla_runtime_alloc(i64 %size) {\nentry:\n  %result = call ptr @abla_runtime_alloc_internal(i64 %size, i1 ${uninitializedClear})\n  ret ptr %result\n}\n\ndefine internal ptr @abla_runtime_alloc_uninitialized(i64 %size) {\nentry:\n  %result = call ptr @abla_runtime_alloc_internal(i64 %size, i1 ${uninitializedClear})\n  ret ptr %result\n}\n\n"
        if (collectorEnabled) {
            output = "${output}define internal void @abla_runtime_memory_set_scan(ptr %pointer, i64 %scan_size) {\nentry:\n  %is_null = icmp eq ptr %pointer, null\n  %negative = icmp slt i64 %scan_size, 0\n  %initial_invalid = or i1 %is_null, %negative\n  br i1 %initial_invalid, label %invalid, label %inspect\ninspect:\n  %header = getelementptr i8, ptr %pointer, i64 -40\n  %size_slot = getelementptr i8, ptr %header, i64 24\n  %size = load i64, ptr %size_slot, align 8\n  %too_large = icmp ugt i64 %scan_size, %size\n  br i1 %too_large, label %invalid, label %ready\nready:\n  %scan_size_slot = getelementptr i8, ptr %header, i64 32\n  %encoded = load i64, ptr %scan_size_slot, align 8\n  %layout = and i64 %encoded, -72057594037927936\n  %combined = or i64 %layout, %scan_size\n  store i64 %combined, ptr %scan_size_slot, align 8\n  ret void\ninvalid:\n  %message = getelementptr [25 x i8], ptr @abla_runtime_invalid_scan_size, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 24)\n  unreachable\n}\n\n"
            output = "${output}define internal void @abla_runtime_memory_set_layout(ptr %pointer, i64 %layout) {\nentry:\n  %is_null = icmp eq ptr %pointer, null\n  %valid_layout = icmp ule i64 %layout, 10\n  %valid_pointer = xor i1 %is_null, true\n  %valid = and i1 %valid_pointer, %valid_layout\n  br i1 %valid, label %ready, label %invalid\nready:\n  %header = getelementptr i8, ptr %pointer, i64 -40\n  %scan_size_slot = getelementptr i8, ptr %header, i64 32\n  %encoded = load i64, ptr %scan_size_slot, align 8\n  %size = and i64 %encoded, 72057594037927935\n  %wide_layout = shl i64 %layout, 56\n  %combined = or i64 %wide_layout, %size\n  store i64 %combined, ptr %scan_size_slot, align 8\n  ret void\ninvalid:\n  %message = getelementptr [25 x i8], ptr @abla_runtime_invalid_scan_size, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 24)\n  unreachable\n}\n\n"
        } else {
            output = "${output}define internal void @abla_runtime_memory_set_scan(ptr %pointer, i64 %scan_size) alwaysinline {\nentry:\n  ret void\n}\n\n"
            output = "${output}define internal void @abla_runtime_memory_set_layout(ptr %pointer, i64 %layout) alwaysinline {\nentry:\n  ret void\n}\n\n"
        }
        output = "${output}define internal void @abla_runtime_free(ptr %pointer) {\nentry:\n  %is_null = icmp eq ptr %pointer, null\n  br i1 %is_null, label %done, label %unlink\nunlink:\n  %header = getelementptr i8, ptr %pointer, i64 -40\n  %previous_slot = getelementptr i8, ptr %header, i64 0\n  %next_slot = getelementptr i8, ptr %header, i64 8\n  %size_slot = getelementptr i8, ptr %header, i64 24\n  %previous = load ptr, ptr %previous_slot, align 8\n  %next = load ptr, ptr %next_slot, align 8\n  %has_previous = icmp ne ptr %previous, null\n  br i1 %has_previous, label %update_previous, label %check_next\nupdate_previous:\n  %previous_next = getelementptr i8, ptr %previous, i64 8\n  store ptr %next, ptr %previous_next, align 8\n  br label %check_next\ncheck_next:\n  %has_next = icmp ne ptr %next, null\n  br i1 %has_next, label %update_next, label %update_tail\nupdate_next:\n  %next_previous = getelementptr i8, ptr %next, i64 0\n  store ptr %previous, ptr %next_previous, align 8\n  br label %account\nupdate_tail:\n  store ptr %previous, ptr @abla_runtime_allocation_tail, align 8\n  br label %account\naccount:\n  %size = load i64, ptr %size_slot, align 8\n  %live = load i64, ptr @abla_runtime_allocation_live_bytes, align 8\n  %next_live = sub i64 %live, %size\n  store i64 %next_live, ptr @abla_runtime_allocation_live_bytes, align 8\n  call void @free(ptr %header)\n  br label %done\ndone:\n  ret void\n}\n\n"
        output = "${output}define internal i64 @abla_runtime_memory_checkpoint() {\nentry:\n  %value = load i64, ptr @abla_runtime_allocation_generation, align 8\n  ret i64 %value\n}\n\n"
        output = "${output}define internal i64 @abla_runtime_memory_live_bytes() {\nentry:\n  %value = load i64, ptr @abla_runtime_allocation_live_bytes, align 8\n  ret i64 %value\n}\n\n"
        output = "${output}define internal i64 @abla_runtime_memory_limit() {\nentry:\n  %value = load i64, ptr @abla_runtime_allocation_limit, align 8\n  ret i64 %value\n}\n\n"
        output = "${output}define internal void @abla_runtime_memory_set_limit(i64 %limit) {\nentry:\n  %negative = icmp slt i64 %limit, 0\n  %live = load i64, ptr @abla_runtime_allocation_live_bytes, align 8\n  %below_live = icmp ult i64 %limit, %live\n  %invalid = or i1 %negative, %below_live\n  br i1 %invalid, label %failed, label %ready\nready:\n  store i64 %limit, ptr @abla_runtime_allocation_limit, align 8\n  ret void\nfailed:\n  %message = getelementptr [21 x i8], ptr @abla_runtime_invalid_memory_limit, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 20)\n  unreachable\n}\n\n"
        output = "${output}define internal void @abla_runtime_clear_newer_rope_caches(i64 %checkpoint) {\nentry:\n  %initial = load ptr, ptr @abla_runtime_allocation_tail, align 8\n  br label %condition\ncondition:\n  %header = phi ptr [ %initial, %entry ], [ %previous, %next ]\n  %more = icmp ne ptr %header, null\n  br i1 %more, label %inspect, label %done\ninspect:\n  %generation_slot = getelementptr i8, ptr %header, i64 16\n  %generation = load i64, ptr %generation_slot, align 8\n  %retained = icmp ule i64 %generation, %checkpoint\n  %scan_slot = getelementptr i8, ptr %header, i64 32\n  %scan = load i64, ptr %scan_slot, align 8\n  %layout = lshr i64 %scan, 56\n  %rope = icmp eq i64 %layout, 6\n  %inspect_cache = and i1 %retained, %rope\n  br i1 %inspect_cache, label %cache, label %next\ncache:\n  %payload = getelementptr i8, ptr %header, i64 40\n  %cache_slot = getelementptr i8, ptr %payload, i64 64\n  %flattened = load ptr, ptr %cache_slot, align 8\n  %has_cache = icmp ne ptr %flattened, null\n  br i1 %has_cache, label %cache_generation, label %next\ncache_generation:\n  %cache_generation_slot = getelementptr i8, ptr %flattened, i64 -24\n  %cached_generation = load i64, ptr %cache_generation_slot, align 8\n  %cache_newer = icmp ugt i64 %cached_generation, %checkpoint\n  br i1 %cache_newer, label %clear, label %next\nclear:\n  store ptr null, ptr %cache_slot, align 8\n  br label %next\nnext:\n  %previous_slot = getelementptr i8, ptr %header, i64 0\n  %previous = load ptr, ptr %previous_slot, align 8\n  br label %condition\ndone:\n  ret void\n}\n\n"
        output = "${output}define internal void @abla_runtime_memory_reset(i64 %checkpoint) {\nentry:\n  %generation = load i64, ptr @abla_runtime_allocation_generation, align 8\n  call void @abla_runtime_clear_newer_rope_caches(i64 %checkpoint)\n  %valid = icmp ule i64 %checkpoint, %generation\n  br i1 %valid, label %condition, label %invalid\ncondition:\n  %tail = load ptr, ptr @abla_runtime_allocation_tail, align 8\n  %has_tail = icmp ne ptr %tail, null\n  br i1 %has_tail, label %inspect, label %done\ninspect:\n  %generation_slot = getelementptr i8, ptr %tail, i64 16\n  %tail_generation = load i64, ptr %generation_slot, align 8\n  %newer = icmp ugt i64 %tail_generation, %checkpoint\n  br i1 %newer, label %release, label %done\nrelease:\n  %payload = getelementptr i8, ptr %tail, i64 40\n  call void @abla_runtime_free(ptr %payload)\n  br label %condition\ndone:\n  ret void\ninvalid:\n  %message = getelementptr [26 x i8], ptr @abla_runtime_invalid_checkpoint, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 25)\n  unreachable\n}\n\n"
