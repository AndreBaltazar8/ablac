    output = "${output}define internal void @abla_cell_set(ptr noalias sret(%AblaValue) align 8 %out, ptr byval(%AblaValue) align 8 %boxed, ptr byval(%AblaValue) align 8 %input) {\nentry:\n  %cell = call ptr @abla_cell_pointer(ptr byval(%AblaValue) align 8 %boxed)\n  %value = load %AblaValue, ptr %input, align 8\n  store %AblaValue %value, ptr %cell, align 8\n  store %AblaValue %value, ptr %out, align 8\n  ret void\n}\n\n"
