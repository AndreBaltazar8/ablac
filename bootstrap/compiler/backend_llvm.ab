ptr %count_slot, align 8\n  br label %loop\ncomplete:\n  %final_pending = load ptr, ptr %pending_slot, align 8\n  call void @abla_runtime_free(ptr %final_pending)\n  %final_output = load i64, ptr %output_slot, align 8\n  %complete_length = icmp eq i64 %final_output, %length\n  br i1 %complete_length, label %finish, label %invalid\nfinish:\n  %terminator = getelementptr i8, ptr %flattened, i64 %length\n  store i8 0, ptr %terminator, align 1\n  store ptr %flattened, ptr %cache_pointer, align 8\n  ret ptr %flattened\noverflow:\n  %overflow_message = getelementptr [23 x i8], ptr @abla_string_overflow, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %overflow_message, i64 22)\n  unreachable\ntoo_deep:\n  %deep_message = getelementptr [24 x i8], ptr @abla_string_rope_too_deep, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %deep_message, i64 23)\n  unreachable\ninvalid:\n  %invalid_message = getelementptr [20 x i8], ptr @abla_invalid_string_rope, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %invalid_message, i64 19)\n  unreachable\n}\n\n"
