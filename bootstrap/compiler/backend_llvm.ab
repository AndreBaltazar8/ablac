    output = "${output}define internal void @abla_function_capture(ptr noalias sret(%AblaValue) align 8 %out, ptr byval(%AblaValue) align 8 %boxed, i64 %index) {\nentry:\n  %checked = call i32 @abla_as_function(ptr byval(%AblaValue) align 8 %boxed)\n  %payload = getelementptr %AblaValue, ptr %boxed, i32 0, i32 1\n  %count_pointer = getelementptr %AblaPayload, ptr %payload, i32 0, i32 1\n  %count = load i64, ptr %count_pointer, align 8\n  %valid = icmp ult i64 %index, %count\n  br i1 %valid, label %value, label %invalid\nvalue:\n  %captures_pointer = getelementptr %AblaPayload, ptr %payload, i32 0, i32 2\n  %captures_integer = load i64, ptr %captures_pointer, align 8\n  %captures = inttoptr i64 %captures_integer to ptr\n  %source = getelementptr %AblaValue, ptr %captures, i64 %index\n  %capture = load %AblaValue, ptr %source, align 8\n  store %AblaValue %capture, ptr %out, align 8\n  ret void\ninvalid:\n  %message = getelementptr [31 x i8], ptr @abla_scalar_capture_bounds, i64 0, i64 0\n  call void @abla_runtime_panic(ptr %message, i64 30)\n  unreachable\n}\n\n"
