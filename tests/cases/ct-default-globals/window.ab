// A global made by a constructor call that leaves defaults out, as abla-forge's
// `val nativeWindow = NativeWindow(...)`; the site writes its fields. And globals
// with no written type whose initializer is a float literal or literal arithmetic,
// or an array literal, as abla-forge's `var vkxTimerPeriod = 0.0` and `val __LENGTH_EXTRA = [0, ...]`.
import "abla/float/text"

class Window(var width: int, var open: bool, var pixelWidth: int = 0, var scale: f64 = 1.0)

val window = Window(0, false)
var period = 0.0
var offset = -2.0
var last = 0 - 1
var lengths = [1, 2, 3]

fun openWindow(): string {
    var step = 0
    while (step < 3) {
        window.width = window.width + 7
        period = period + 0.5
        offset = offset + 1.0
        last = last + 7
        step += 1
    }
    window.open = true
    lengths.append(window.width)
    window.pixelWidth = window.width * 2
    "${window.width}:${window.pixelWidth}:${window.open}:${period}:${offset}:${last}:${lengths.size}"
}
