// Every global here has a constant initializer, and the program has no `main`:
// the exports are its only entries. What they store in the globals must still
// survive a collection.
import "abla/memory"

class Node(val value: int, val label: string)

var node: Node? = null
var text: string = "start"
val items: array<string> = []

fun padded(value: int): string {
    var result = "value-$value"
    while (result.size < 64) result = "$result."
    result
}

@export("store")
fun store(value: int): void {
    node = Node(value, padded(value))
    text = padded(value + 1)
    items.append(padded(value + 2))
    return
}

// Garbage for the collector to reuse the stored objects' memory for.
@export("churn")
fun churn(rounds: int): int {
    var total = 0
    var round = 0
    while (round < rounds) {
        total = total + padded(round + 1000000).size
        round = round + 1
    }
    total
}

@export("collect")
fun collect(): int = memoryCollect()

// The value stored, or a negative number for what was lost.
@export("read")
fun read(value: int): int {
    val held = node
    if (held == null) return -1
    if (held.label != padded(value)) return -2
    if (text != padded(value + 1)) return -3
    if (items[items.size - 1] != padded(value + 2)) return -4
    held.value
}
