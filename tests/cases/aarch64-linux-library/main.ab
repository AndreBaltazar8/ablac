import "abla/build"
import "abla/io"

// A shared and a static library of the aarch64-linux cross target (#811): strings, arrays, maps, floats, a thread and
// output, on the library's own system calls, heap and routines. tools/test-aarch64-linux-library.sh checks what it
// leaves to the host process and runs it from a glibc host under the AArch64 runner.
fun greet(n: int): string {
    val parts: array<string> = []
    for (index in 0 until n) parts.append("item$index")
    var text = ""
    for (part in parts) text = "$text$part,"
    text
}

fun answer: int {
    val table: Map<string, int> = Map()
    for (index in 0 until 20) table.set("key$index", index * index)
    val scale = 2.5
    println("library: ${table.size} keys")
    greet(40).size + table.size + (if (scale % 2.0 == 0.5) 10 else 0)
}

fun threaded: int {
    val worker = thread { greet(10).size }
    val result = await worker
    println("library: thread $result")
    result
}

val exportedAnswer = #exportFunction("answer", "abla_app_answer")
val exportedThreaded = #exportFunction("threaded", "abla_app_threaded")
