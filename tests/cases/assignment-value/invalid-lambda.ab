// A lambda passed where a `() -> Ticket` is expected returns its last
// expression: an assignment there hands out what `t` owns.
resource class Ticket(val value: int)

fun run(make: () -> Ticket): Ticket = make()

fun main: int {
    val made = run({ ->
        var t = Ticket(1)
        t = Ticket(2)
    })
    made.value
}
