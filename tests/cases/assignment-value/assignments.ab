// Assignments as statements, a void function ending in one, a value written to
// a local first and returned after assigning, and a non-affine assignment's
// value used: each resource drops once, at run time and under `#`.
import "abla/io"

resource class Ticket(val value: int) {
    fun drop(): void {
        println("drop $value")
        return
    }
}

class Box(var ticket: Ticket)

fun replace(var box: Box): void {
    box.ticket = Ticket(3)
}

fun issue(): Ticket {
    var t = Ticket(1)
    t = Ticket(2)
    t
}

fun counted(): int {
    var n = 0
    n = 5
}

fun total(): int {
    val box = Box(Ticket(4))
    replace(box)
    val issued = issue()
    issued.value + box.ticket.value + counted()
}

compile fun atCompileTime(): int = total()

fun main: int {
    val now = total()
    val then = #atCompileTime()
    println("$now $then")
    now
}
