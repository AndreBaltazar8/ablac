// A method and an extension of the same name on one class name different
// borrow sources. The later declaration wins: here the extension, whose result
// borrows `right`, so moving `left` while `picked` lives is fine.
// later-method.ab declares them the other way round.
resource class Ticket(val value: int)

class Desk(val label: int) {
    fun pick(left: Shared<Ticket>, right: Shared<Ticket>): borrow(left) Ticket = left.get()
}

fun Desk.pick(left: Shared<Ticket>, right: Shared<Ticket>): borrow(right) Ticket = right.get()

fun main: int {
    val desk = Desk(1)
    val left = Shared(Ticket(1))
    val right = Shared(Ticket(42))
    val picked = desk.pick(left, right)
    val moved = move(left)
    picked.value
}
