import "abla/io"
import "abla/sys/linux"
import "abla/unsafe/memory"

// epoll through the portable Linux-numbered surface (#811 group 4): on macOS the dispatcher builds
// it on kqueue and kevent, on Linux it is the kernel's. Each line is "name: ok (value)"; exit status
// 7 when all are right. An epoll_event is 12 bytes here: the event bits, then the 64-bit data.

trusted fun report(name: string, ok: bool, value: int): bool {
    println("${name}: ${if (ok) "ok" else "FAIL"} ($value)")
    ok
}

trusted fun unixAddress(address: int, path: string): int {
    var clear = 0
    while (clear < 128) {
        ablaRuntimeStoreU8(address + clear, 0)
        clear = clear + 1
    }
    ablaRuntimeStoreU8(address, 1)
    var index = 0
    while (index < path.size) {
        ablaRuntimeStoreU8(address + 2 + index, path[index])
        index = index + 1
    }
    2 + path.size + 1
}

trusted fun event(address: int, bits: int, data: int): void {
    ablaRuntimeStoreI32(address, bits)
    ablaRuntimeStoreI64(address + 4, data)
    return
}

trusted fun main: int {
    var good = true
    val queue = linuxSyscall1(291, 0)
    good = report("epoll_create1", queue >= 3, queue) && good
    val path = "build/darwin-syscalls/k.sock"
    linuxSyscall1(87, nativeCStringAddress(path))
    val address = nativeStackAllocate(128)
    val size = unixAddress(address, path)
    val server = linuxSyscall3(41, 1, 1, 0)
    linuxSyscall3(49, server, address, size)
    linuxSyscall2(50, server, 4)
    val client = linuxSyscall3(41, 1, 1, 0)
    linuxSyscall3(42, client, address, size)
    val accepted = linuxSyscall4(288, server, 0, 0, 2048)
    val request = nativeStackAllocate(16)
    val ready = nativeStackAllocate(64)
    // Level-triggered readiness for reading.
    event(request, 1, accepted)
    val added = linuxSyscall4(233, queue, 1, accepted, request)
    good = report("epoll_ctl add", added == 0, added) && good
    val idle = linuxSyscall4(232, queue, ready, 4, 0)
    good = report("epoll_wait nothing ready", idle == 0, idle) && good
    val text = "x"
    linuxSyscall6(44, client, nativeCStringAddress(text), 1, 0, 0, 0)
    val one = linuxSyscall4(232, queue, ready, 4, 2000)
    good = report("epoll_wait readable", one == 1 && (ablaRuntimeLoadI32(ready) & 1) == 1 &&
        ablaRuntimeLoadI64(ready + 4) == accepted, one) && good
    // Modify to writability: a connected socket is writable at once.
    event(request, 4, accepted)
    val modified = linuxSyscall4(233, queue, 3, accepted, request)
    good = report("epoll_ctl modify", modified == 0, modified) && good
    val writable = linuxSyscall4(232, queue, ready, 4, 2000)
    good = report("epoll_wait writable", writable == 1 && (ablaRuntimeLoadI32(ready) & 4) == 4 &&
        ablaRuntimeLoadI64(ready + 4) == accepted, writable) && good
    // Delete: nothing is reported any more.
    val deleted = linuxSyscall4(233, queue, 2, accepted, 0)
    good = report("epoll_ctl delete", deleted == 0, deleted) && good
    val gone = linuxSyscall4(232, queue, ready, 4, 0)
    good = report("epoll_wait after delete", gone == 0, gone) && good
    // Both bits on one descriptor: epoll reports it once (kqueue keeps two filters).
    linuxSyscall6(44, client, nativeCStringAddress(text), 1, 0, 0, 0)
    event(request, 5, accepted)
    linuxSyscall4(233, queue, 1, accepted, request)
    val both = linuxSyscall4(232, queue, ready, 4, 2000)
    good = report("epoll_wait one event for both bits",
        both == 1 && (ablaRuntimeLoadI32(ready) & 5) == 5 &&
        ablaRuntimeLoadI64(ready + 4) == accepted, both) && good
    linuxSyscall4(233, queue, 2, accepted, 0)
    val goneAgain = linuxSyscall4(232, queue, ready, 4, 0)
    good = report("epoll_wait after deleting both bits", goneAgain == 0, goneAgain) && good
    // A closed peer is reported as readable (end of file), with the hang-up bit where there is one.
    event(request, 1, accepted)
    linuxSyscall4(233, queue, 1, accepted, request)
    val inbox = nativeStackAllocate(16)
    linuxSyscall6(45, accepted, inbox, 16, 0, 0, 0)
    linuxSyscall1(3, client)
    val closed = linuxSyscall4(232, queue, ready, 4, 2000)
    good = report("epoll_wait peer closed", closed == 1 && (ablaRuntimeLoadI32(ready) & 1) == 1,
        closed) && good
    linuxSyscall1(3, accepted)
    linuxSyscall1(3, server)
    linuxSyscall1(3, queue)
    linuxSyscall1(87, nativeCStringAddress(path))
    if (good) return 7
    1
}
