import "abla/io"
import "abla/unsafe/memory"

// The pure translations of the macOS socket and readiness layer (host.ab, #811 group 4): Linux
// structures and numbers as Darwin's and back. They do no system call, so this program checks them
// on every OS (the macOS job and Linux alike); it prints "name: ok" per check and exits 7 when all
// are right. Darwin values: xnu's bsd/sys/socket.h, netinet/in.h, netinet/tcp.h (unverified, from
// memory: the macOS job's sockets.ab exercises them for real).

trusted fun report(name: string, ok: bool): bool {
    println("${name}: ${if (ok) "ok" else "FAIL"}")
    ok
}

trusted fun byteAt(address: int, offset: int): int = ablaRuntimeLoadU8(address + offset)

trusted fun fill(address: int, count: int, value: int): void {
    var index = 0
    while (index < count) {
        ablaRuntimeStoreU8(address + index, value)
        index = index + 1
    }
    return
}

trusted fun main: int {
    var good = true
    val linux = nativeStackAllocate(128)
    val darwin = nativeStackAllocate(128)

    // Linux to Darwin, in place. AF_INET: family 2, port 0x1f90 (8080) in network order, 127.0.0.1.
    fill(linux, 128, 0)
    ablaRuntimeStoreU8(linux, 2)
    ablaRuntimeStoreU8(linux + 2, 31)
    ablaRuntimeStoreU8(linux + 3, 144)
    ablaRuntimeStoreU8(linux + 4, 127)
    ablaRuntimeStoreU8(linux + 7, 1)
    val inetLength = __ablaRuntimeDarwinSockaddrLength(linux, 16)
    good = report("sockaddr inet length", inetLength == 16 &&
        __ablaRuntimeDarwinSockaddrLength(linux, 128) == 16) && good
    val inetSaved = __ablaRuntimeDarwinSockaddrMark(linux, inetLength)
    good = report("sockaddr inet bytes", inetSaved == 2 && byteAt(linux, 0) == 16 && byteAt(linux,
        1) == 2 &&
        byteAt(linux, 2) == 31 && byteAt(linux, 3) == 144 && byteAt(linux, 4) == 127 &&
        byteAt(linux, 7) == 1 && byteAt(linux, 8) == 0) && good
    __ablaRuntimeDarwinSockaddrRestore(linux, inetSaved)
    good = report("sockaddr inet restored", byteAt(linux, 0) == 2 && byteAt(linux, 1) == 0 &&
        byteAt(linux, 2) == 31) && good
    good = report("sockaddr inet too short", __ablaRuntimeDarwinSockaddrLength(linux,
        8) == -97) && good

    // AF_INET6: family 10 becomes 30, the port, flow info, address and scope follow unchanged.
    fill(linux, 128, 0)
    ablaRuntimeStoreU8(linux, 10)
    ablaRuntimeStoreU8(linux + 2, 1)
    ablaRuntimeStoreU8(linux + 3, 187)
    ablaRuntimeStoreU8(linux + 23, 1)
    ablaRuntimeStoreU8(linux + 24, 3)
    val inet6Length = __ablaRuntimeDarwinSockaddrLength(linux, 28)
    val inet6Saved = __ablaRuntimeDarwinSockaddrMark(linux, inet6Length)
    good = report("sockaddr inet6", inet6Length == 28 && inet6Saved == 10 && byteAt(linux,
        0) == 28 &&
        byteAt(linux, 1) == 30 && byteAt(linux, 2) == 1 && byteAt(linux, 3) == 187 &&
        byteAt(linux, 23) == 1 && byteAt(linux, 24) == 3) && good
    __ablaRuntimeDarwinSockaddrRestore(linux, inet6Saved)
    good = report("sockaddr inet6 restored", byteAt(linux, 0) == 10 && byteAt(linux,
        1) == 0) && good

    // AF_UNIX: the length byte counts the family, the length and the path with its NUL.
    fill(linux, 128, 0)
    ablaRuntimeStoreU8(linux, 1)
    ablaRuntimeStoreU8(linux + 2, 47)
    ablaRuntimeStoreU8(linux + 3, 116)
    ablaRuntimeStoreU8(linux + 4, 0)
    val unixLength = __ablaRuntimeDarwinSockaddrLength(linux, 5)
    val unixSaved = __ablaRuntimeDarwinSockaddrMark(linux, unixLength)
    good = report("sockaddr unix", unixLength == 5 && byteAt(linux, 0) == 5 && byteAt(linux,
        1) == 1 &&
        byteAt(linux, 2) == 47 && byteAt(linux, 3) == 116 && byteAt(linux, 4) == 0) && good
    __ablaRuntimeDarwinSockaddrRestore(linux, unixSaved)
    ablaRuntimeStoreU8(linux + 2, 0)
    good = report("sockaddr abstract unix refused", __ablaRuntimeDarwinSockaddrLength(linux,
        5) == -97) && good
    ablaRuntimeStoreU8(linux + 2, 47)
    ablaRuntimeStoreU8(linux + 4, 1)
    good = report("sockaddr unix without NUL", __ablaRuntimeDarwinSockaddrLength(linux,
        5) == -22) && good
    good = report("sockaddr unix path too long", __ablaRuntimeDarwinSockaddrLength(linux,
        108) == -36) && good
    good = report("sockaddr null", __ablaRuntimeDarwinSockaddrLength(0, 16) == -22) && good

    // Darwin to Linux, in place: the family byte becomes a 16-bit family; the rest stays.
    fill(darwin, 128, 0)
    ablaRuntimeStoreU8(darwin, 16)
    ablaRuntimeStoreU8(darwin + 1, 2)
    ablaRuntimeStoreU8(darwin + 2, 31)
    ablaRuntimeStoreU8(darwin + 3, 144)
    ablaRuntimeStoreU8(darwin + 4, 10)
    ablaRuntimeStoreU8(darwin + 7, 9)
    __ablaRuntimeLinuxSockaddr(darwin, 128)
    good = report("linux sockaddr inet", byteAt(darwin, 0) == 2 && byteAt(darwin, 1) == 0 &&
        byteAt(darwin, 2) == 31 && byteAt(darwin, 3) == 144 && byteAt(darwin, 4) == 10 &&
        byteAt(darwin, 7) == 9 && byteAt(darwin, 8) == 0) && good
    ablaRuntimeStoreU8(darwin, 28)
    ablaRuntimeStoreU8(darwin + 1, 30)
    ablaRuntimeStoreU8(darwin + 23, 1)
    __ablaRuntimeLinuxSockaddr(darwin, 128)
    good = report("linux sockaddr inet6", byteAt(darwin, 0) == 10 && byteAt(darwin, 1) == 0 &&
        byteAt(darwin, 23) == 1) && good
    ablaRuntimeStoreU8(darwin, 5)
    ablaRuntimeStoreU8(darwin + 1, 1)
    __ablaRuntimeLinuxSockaddr(darwin, 128)
    good = report("linux sockaddr unix", byteAt(darwin, 0) == 1 && byteAt(darwin, 1) == 0) && good
    ablaRuntimeStoreU8(darwin, 28)
    ablaRuntimeStoreU8(darwin + 1, 99)
    __ablaRuntimeLinuxSockaddr(darwin, 128)
    good = report("linux sockaddr unknown family stays", byteAt(darwin, 0) == 28 && byteAt(darwin,
        1) == 99) && good
    ablaRuntimeStoreU8(darwin + 1, 2)
    ablaRuntimeStoreU8(darwin, 16)
    __ablaRuntimeLinuxSockaddr(darwin, 1)
    good = report("linux sockaddr without room stays", byteAt(darwin, 0) == 16 && byteAt(darwin,
        1) == 2) && good

    // Constants and options.
    good = report("domain",
        __ablaRuntimeDarwinSocketDomain(10) == 30 && __ablaRuntimeDarwinSocketDomain(2) == 2 &&
        __ablaRuntimeDarwinSocketDomain(1) == 1) && good
    good = report("type", __ablaRuntimeDarwinSocketType(1 | 2048 | 524288) == 1 &&
        __ablaRuntimeDarwinSocketType(2) == 2) && good
    good = report("message flags", __ablaRuntimeDarwinMessageFlags(16384 | 2) == 2) && good
    good = report("SOL_SOCKET options", __ablaRuntimeDarwinSocketOption(65535, 2) == 4 &&
        __ablaRuntimeDarwinSocketOption(65535, 4) == 4103 && __ablaRuntimeDarwinSocketOption(65535,
            20) == 4102 &&
        __ablaRuntimeDarwinSocketOption(65535, 21) == 4101 && __ablaRuntimeDarwinSocketOption(65535,
            9) == 8) && good
    good = report("TCP options", __ablaRuntimeDarwinSocketOption(6, 1) == 1 &&
        __ablaRuntimeDarwinSocketOption(6, 4) == 16 && __ablaRuntimeDarwinSocketOption(6,
            5) == 257 &&
        __ablaRuntimeDarwinSocketOption(6, 6) == 258) && good
    good = report("IPv6 options", __ablaRuntimeDarwinSocketOption(41, 26) == 27 &&
        __ablaRuntimeDarwinSocketOption(41, 16) == 4) && good
    good = report("unknown option passes through", __ablaRuntimeDarwinSocketOption(65535,
        99) == 99) && good

    // A kevent record.
    val event = nativeStackAllocate(32)
    fill(event, 32, 255)
    __ablaRuntimeDarwinKevent(event, 7, -2, 5, 7)
    good = report("kevent", ablaRuntimeLoadI64(event) == 7 && byteAt(event,
        8) == 254 && byteAt(event, 9) == 255 &&
        byteAt(event, 10) == 5 && byteAt(event, 11) == 0 && ablaRuntimeLoadI32(event + 12) == 0 &&
        ablaRuntimeLoadI64(event + 16) == 0 && ablaRuntimeLoadI64(event + 24) == 7) && good
    // Signal numbers (Linux to Darwin).
    good = report("signal numbers",
        __ablaRuntimeDarwinSignal(2) == 2 && __ablaRuntimeDarwinSignal(9) == 9 &&
        __ablaRuntimeDarwinSignal(7) == 10 && __ablaRuntimeDarwinSignal(10) == 30 &&
        __ablaRuntimeDarwinSignal(12) == 31 && __ablaRuntimeDarwinSignal(17) == 20 &&
        __ablaRuntimeDarwinSignal(18) == 19 && __ablaRuntimeDarwinSignal(19) == 17 &&
        __ablaRuntimeDarwinSignal(20) == 18 && __ablaRuntimeDarwinSignal(16) == 0 &&
        __ablaRuntimeDarwinSignal(0) == 0 && __ablaRuntimeDarwinSignal(15) == 15) && good
    if (good) {
        println("darwin translations: every check agrees")
        return 7
    }
    1
}
