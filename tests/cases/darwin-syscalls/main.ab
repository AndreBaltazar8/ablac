import "abla/io"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// The calls a macOS program issues by BSD system call (#811), through the portable
// Linux-numbered surface; on Linux the same numbers are the kernel's, so the
// program prints the same lines everywhere. Each line is "name: result".

trusted fun firstWordAt(address: int): int = ablaUnsafeLoadI64(nativePointerFromAddress(address))

fun report(name: string, ok: bool, value: int): bool {
    println("${name}: ${if (ok) "ok" else "FAIL"} ($value)")
    ok
}

fun main: int {
    var good = true
    val pid = linuxSyscall0(39)
    good = report("getpid", pid > 0 && pid == linuxProcessId(), pid) && good
    val text = "darwin-syscalls: write\n"
    val written = linuxSyscall3(1, 1, nativeCStringAddress(text), text.size)
    good = report("write", written == text.size, written) && good
    // stdout may be a pipe (ESPIPE, 29), a file or a terminal: any of them is a valid answer
    val seek = linuxSyscall3(8, 1, 0, 1)
    good = report("lseek", seek >= 0 || seek == -29, seek) && good
    val duplicate = linuxSyscall2(33, 1, 9)
    good = report("dup2", duplicate == 9, duplicate) && good
    linuxSyscall1(3, 9)
    val sync = linuxSyscall1(74, 1)
    good = report("fsync", sync == 0 || sync == -22 || sync == -25, sync) && good
    val dot = "."
    val changed = linuxSyscall1(80, nativeCStringAddress(dot))
    good = report("chdir", changed == 0, changed) && good
    val missing = "/nonexistent-darwin-syscalls-directory"
    val failed = linuxSyscall1(80, nativeCStringAddress(missing))
    good = report("chdir error", failed == -2, failed) && good
    val previous = linuxSyscall1(95, 18)
    val restored = linuxSyscall1(95, previous)
    good = report("umask", previous >= 0 && restored == 18, restored) && good
    // Files and directories (second group): a work directory under the repository's build/.
    val directory = "build/darwin-syscalls/work"
    val file = "build/darwin-syscalls/work/a"
    val moved = "build/darwin-syscalls/work/b"
    val link = "build/darwin-syscalls/work/l"
    linuxSyscall1(87, nativeCStringAddress(moved))
    linuxSyscall1(87, nativeCStringAddress(file))
    linuxSyscall1(87, nativeCStringAddress(link))
    linuxSyscall1(84, nativeCStringAddress(directory))
    val made = linuxSyscall2(83, nativeCStringAddress(directory), 493)
    good = report("mkdir", made == 0, made) && good
    val again = linuxSyscall2(83, nativeCStringAddress(directory), 493)
    good = report("mkdir exists", again == -17, again) && good
    val reachable = linuxSyscall2(21, nativeCStringAddress(directory), 0)
    good = report("access", reachable == 0, reachable) && good
    val absent = linuxSyscall2(21, nativeCStringAddress(moved), 0)
    good = report("access missing", absent == -2, absent) && good
    val descriptor = linuxSyscall4(257, -100, nativeCStringAddress(file), 577, 420)
    good = report("openat create", descriptor >= 3, descriptor) && good
    val fchmoded = linuxSyscall2(91, descriptor, 384)
    good = report("fchmod", fchmoded == 0, fchmoded) && good
    val locked = linuxSyscall2(73, descriptor, 2)
    good = report("flock", locked == 0, locked) && good
    val unlocked = linuxSyscall2(73, descriptor, 8)
    good = report("flock unlock", unlocked == 0, unlocked) && good
    val flags = linuxSyscall3(72, descriptor, 3, 0)
    good = report("fcntl F_GETFL", flags >= 0 && (flags & 3) == 1, flags) && good
    val setFlags = linuxSyscall3(72, descriptor, 4, 2048)
    val nonBlocking = linuxSyscall3(72, descriptor, 3, 0)
    good = report("fcntl F_SETFL", setFlags == 0 && nonBlocking >= 0 && (nonBlocking & 2048) != 0,
        nonBlocking) && good
    val copy = linuxSyscall3(72, descriptor, 1030, 10)
    val copyFlags = if (copy >= 0) linuxSyscall3(72, copy, 1, 0) else -1
    good = report("fcntl F_DUPFD_CLOEXEC", copy >= 10 && copyFlags >= 0 && (copyFlags & 1) == 1,
        copy) && good
    if (copy >= 0) linuxSyscall1(3, copy)
    linuxSyscall1(3, descriptor)
    val chmoded = linuxSyscall2(90, nativeCStringAddress(file), 420)
    good = report("chmod", chmoded == 0, chmoded) && good
    val renamed = linuxSyscall2(82, nativeCStringAddress(file), nativeCStringAddress(moved))
    good = report("rename", renamed == 0, renamed) && good
    val linked = linuxSyscall2(88, nativeCStringAddress(moved), nativeCStringAddress(link))
    good = report("symlink", linked == 0, linked) && good
    val unlinkedLink = linuxSyscall1(87, nativeCStringAddress(link))
    good = report("unlink link", unlinkedLink == 0, unlinkedLink) && good
    val unlinked = linuxSyscall1(87, nativeCStringAddress(moved))
    good = report("unlink", unlinked == 0, unlinked) && good
    val removed = linuxSyscall1(84, nativeCStringAddress(directory))
    good = report("rmdir", removed == 0, removed) && good
    val removedAgain = linuxSyscall1(84, nativeCStringAddress(directory))
    good = report("rmdir missing", removedAgain == -2, removedAgain) && good
    // Directory-relative forms exactly as SecureDirectory.replaceSymlink uses them, with a
    // real directory descriptor, and the same calls with AT_FDCWD (-100).
    val base = "build/darwin-syscalls/work4"
    linuxSyscall1(84, nativeCStringAddress(base))
    linuxSyscall2(83, nativeCStringAddress(base), 493)
    val dirFd = linuxSyscall4(257, -100, nativeCStringAddress(base), 65536, 0)
    good = report("open directory", dirFd >= 3, dirFd) && good
    val current = "current"
    val temporary = "temp-link"
    val newTarget = "new"
    val probe = nativeByteBuffer(144)
    val probed = linuxSyscall4(262, dirFd, nativeCStringAddress(current),
        nativePointerAddress(probe.address), 256)
    good = report("fstatat relative missing", probed == -2, probed) && good
    val symlinked = linuxSyscall3(266, nativeCStringAddress(newTarget), dirFd,
        nativeCStringAddress(temporary))
    good = report("symlinkat", symlinked == 0, symlinked) && good
    val renamedAt = linuxSyscall4(264, dirFd, nativeCStringAddress(temporary), dirFd,
        nativeCStringAddress(current))
    good = report("renameat", renamedAt == 0, renamedAt) && good
    val linkPath = "build/darwin-syscalls/work4/current"
    val linkBuffer = nativeByteBuffer(64)
    val linkSize = linuxSyscall3(89, nativeCStringAddress(linkPath),
        nativePointerAddress(linkBuffer.address), 64)
    good = report("readlink of the replaced link", linkSize == 3, linkSize) && good
    val other = "other"
    val madeOther = linuxSyscall3(266, nativeCStringAddress(newTarget), dirFd,
        nativeCStringAddress(other))
    val noReplace = linuxSyscall5(316, dirFd, nativeCStringAddress(other), dirFd,
        nativeCStringAddress(current), 1)
    good = report("renameat2 NOREPLACE onto an existing name", madeOther == 0 && noReplace == -17,
        noReplace) && good
    val freeName = "free"
    val movedFresh = linuxSyscall5(316, dirFd, nativeCStringAddress(other), dirFd,
        nativeCStringAddress(freeName), 1)
    good = report("renameat2 NOREPLACE onto a free name", movedFresh == 0, movedFresh) && good
    val removedFree = linuxSyscall3(263, dirFd, nativeCStringAddress(freeName), 0)
    val removedCurrent = linuxSyscall3(263, dirFd, nativeCStringAddress(current), 0)
    good = report("unlinkat", removedFree == 0 && removedCurrent == 0, removedCurrent) && good
    val sub = "sub"
    val madeSub = linuxSyscall3(258, dirFd, nativeCStringAddress(sub), 493)
    val removedSub = linuxSyscall3(263, dirFd, nativeCStringAddress(sub), 512)
    good = report("mkdirat and unlinkat AT_REMOVEDIR", madeSub == 0 && removedSub == 0,
        removedSub) && good
    val cwdDirectory = "build/darwin-syscalls/work4/cwd"
    val cwdLink = "build/darwin-syscalls/work4/l2"
    val cwdMoved = "build/darwin-syscalls/work4/l3"
    val atMade = linuxSyscall3(258, -100, nativeCStringAddress(cwdDirectory), 493)
    val atLinked = linuxSyscall3(266, nativeCStringAddress(newTarget), -100,
        nativeCStringAddress(cwdLink))
    val atMoved = linuxSyscall4(264, -100, nativeCStringAddress(cwdLink), -100,
        nativeCStringAddress(cwdMoved))
    val atUnlinked = linuxSyscall3(263, -100, nativeCStringAddress(cwdMoved), 0)
    val atRemoved = linuxSyscall3(263, -100, nativeCStringAddress(cwdDirectory), 512)
    good = report("AT_FDCWD forms",
        atMade == 0 && atLinked == 0 && atMoved == 0 && atUnlinked == 0 && atRemoved == 0,
        atMade + atLinked + atMoved + atUnlinked + atRemoved) && good
    if (dirFd >= 0) linuxSyscall1(3, dirFd)
    linuxSyscall1(84, nativeCStringAddress(base))
    // The stat family, getdents, getcwd, readlink (third group).
    val work = "build/darwin-syscalls/work3"
    val entry = "build/darwin-syscalls/work3/entry"
    val symbolic = "build/darwin-syscalls/work3/sym"
    linuxSyscall1(87, nativeCStringAddress(symbolic))
    linuxSyscall1(87, nativeCStringAddress(entry))
    linuxSyscall1(84, nativeCStringAddress(work))
    linuxSyscall2(83, nativeCStringAddress(work), 493)
    val made3 = linuxSyscall4(257, -100, nativeCStringAddress(entry), 577, 420)
    val bytes = "12345"
    if (made3 >= 0) {
        linuxSyscall3(1, made3, nativeCStringAddress(bytes), 5)
        val statBuffer = nativeByteBuffer(144)
        val fstatted = linuxSyscall2(5, made3, nativePointerAddress(statBuffer.address))
        val size = statBuffer.loadI64(48)
        val mode = statBuffer.loadI64(24)
        good = report("fstat", fstatted == 0 && size == 5 && (mode & 61440) == 32768, size) && good
        linuxSyscall1(3, made3)
    } else good = report("create for stat", false, made3) && good
    val atBuffer = nativeByteBuffer(144)
    val statted = linuxSyscall4(262, -100, nativeCStringAddress(entry),
        nativePointerAddress(atBuffer.address), 0)
    good = report("fstatat", statted == 0 && atBuffer.loadI64(48) == 5, statted) && good
    val statMissing = linuxSyscall4(262, -100, nativeCStringAddress(moved),
        nativePointerAddress(atBuffer.address), 0)
    good = report("fstatat missing", statMissing == -2, statMissing) && good
    val linkMade = linuxSyscall2(88, nativeCStringAddress(entry), nativeCStringAddress(symbolic))
    val target = nativeByteBuffer(256)
    val linkLength = linuxSyscall3(89, nativeCStringAddress(symbolic),
        nativePointerAddress(target.address), 256)
    good = report("readlink", linkMade == 0 && linkLength == 33, linkLength) && good
    val directoryHandle = linuxSyscall4(257, -100, nativeCStringAddress(work), 65536, 0)
    val listing = nativeByteBuffer(4096)
    val listed = if (directoryHandle >= 0) linuxSyscall3(217, directoryHandle,
        nativePointerAddress(listing.address), 4096) else -1
    good = report("getdents", listed > 0, listed) && good
    var names = 0
    var cursor = 0
    while (listed > 0 && cursor < listed) {
        val record = listing.load(cursor + 16) + listing.load(cursor + 17) * 256
        if (record == 0) cursor = listed else {
            names = names + 1
            cursor = cursor + record
        }
    }
    good = report("getdents records", names >= 3, names) && good
    if (directoryHandle >= 0) linuxSyscall1(3, directoryHandle)
    val cwdBuffer = nativeByteBuffer(1024)
    val cwdLength = linuxSyscall2(79, nativePointerAddress(cwdBuffer.address), 1024)
    good = report("getcwd", cwdLength > 1 && cwdBuffer.load(0) == 47, cwdLength) && good
    linuxSyscall1(87, nativeCStringAddress(symbolic))
    linuxSyscall1(87, nativeCStringAddress(entry))
    linuxSyscall1(84, nativeCStringAddress(work))
    // Time and random (group 7).
    val request = nativeByteBuffer(16)
    request.storeI64(0, 0)
    request.storeI64(8, 2000000)
    val clockBefore = nativeByteBuffer(16)
    val clockAfter = nativeByteBuffer(16)
    linuxSyscall2(228, 1, nativePointerAddress(clockBefore.address))
    val slept = linuxSyscall2(35, nativePointerAddress(request.address), 0)
    linuxSyscall2(228, 1, nativePointerAddress(clockAfter.address))
    val elapsed = (clockAfter.loadI64(0) - clockBefore.loadI64(0)) * 1000000000 +
        clockAfter.loadI64(8) - clockBefore.loadI64(8)
    good = report("nanosleep 2 ms", slept == 0, slept) && good
    good = report("nanosleep took at least 2 ms", elapsed >= 2000000, elapsed) && good
    request.storeI64(8, 2000000000)
    val badSleep = linuxSyscall2(35, nativePointerAddress(request.address), 0)
    good = report("nanosleep invalid", badSleep == -22, badSleep) && good
    val random = nativeByteBuffer(300)
    val filled = linuxSyscall3(318, nativePointerAddress(random.address), 300, 0)
    var nonZero = 0
    var randomIndex = 0
    while (randomIndex < 300) {
        if (random.load(randomIndex) != 0) nonZero = nonZero + 1
        randomIndex = randomIndex + 1
    }
    good = report("getrandom 300 bytes", filled == 300 && nonZero > 200, nonZero) && good
    // Resource limits of the stack (group 7).
    val limits = nativeByteBuffer(16)
    val gotLimit = linuxSyscall2(97, 3, nativePointerAddress(limits.address))
    val currentLimit = limits.loadI64(0)
    good = report("getrlimit stack", gotLimit == 0 && (currentLimit > 0 || currentLimit == -1),
        currentLimit) && good
    val setLimit = linuxSyscall2(160, 3, nativePointerAddress(limits.address))
    good = report("setrlimit stack to its own value", setLimit == 0, setLimit) && good
    val badLimit = linuxSyscall2(97, 99, nativePointerAddress(limits.address))
    good = report("getrlimit other resource", badLimit == -22, badLimit) && good
    // The running image's path (group 7): "/proc/self/exe" opens, stats and reads as the executable.
    val selfPath = "/proc/self/exe"
    val selfLinkBuffer = nativeByteBuffer(2048)
    val selfLength = linuxSyscall3(89, nativeCStringAddress(selfPath),
        nativePointerAddress(selfLinkBuffer.address), 2048)
    good = report("readlink /proc/self/exe", selfLength > 1 && selfLinkBuffer.load(0) != 0,
        selfLength) && good
    val selfStat = nativeByteBuffer(144)
    val selfStatted = linuxSyscall4(262, -100, nativeCStringAddress(selfPath),
        nativePointerAddress(selfStat.address), 0)
    good = report("fstatat /proc/self/exe", selfStatted == 0 && selfStat.loadI64(48) > 1000,
        selfStat.loadI64(48)) && good
    val selfDescriptor = linuxSyscall4(257, -100, nativeCStringAddress(selfPath), 0, 0)
    val selfHead = nativeByteBuffer(4)
    val selfRead = if (selfDescriptor >= 0) linuxSyscall3(0, selfDescriptor,
        nativePointerAddress(selfHead.address), 4) else -1
    good = report("openat /proc/self/exe", selfDescriptor >= 3 && selfRead == 4, selfRead) && good
    if (selfDescriptor >= 0) linuxSyscall1(3, selfDescriptor)
    // ioctl on a descriptor that is not a terminal fails the way Linux's does (group 7).
    val notTerminal = linuxSyscall3(16, 1, 21505,
        nativePointerAddress(nativeByteBuffer(64).address))
    good = report("ioctl TCGETS on a non-terminal", notTerminal == -25 || notTerminal >= 0,
        notTerminal) && good
    // The heap's system calls and the futex its locks wait on (group 8): mmap, madvise, munmap, futex.
    val region = linuxSyscall6(9, 0, 16384, 3, 34, -1, 0)
    good = report("mmap anonymous", region > 4096, region) && good
    val firstWord = if (region > 4096) firstWordAt(region) else -1
    good = report("mmap pages are zero", firstWord == 0, firstWord) && good
    val advised = linuxSyscall3(28, region, 16384, 4)
    good = report("madvise DONTNEED", advised == 0, advised) && good
    val futexWord = nativeByteBuffer(8)
    futexWord.storeI64(0, 0)
    val woken = linuxSyscall3(202, nativePointerAddress(futexWord.address), 129, 1)
    good = report("futex wake with no waiter", woken >= 0, woken) && good
    val mismatch = linuxSyscall4(202, nativePointerAddress(futexWord.address), 128, 5, 0)
    good = report("futex wait on a changed word", mismatch >= 0 || mismatch == -11,
        mismatch) && good
    val unmapped = linuxSyscall2(11, region, 16384)
    good = report("munmap", unmapped == 0, unmapped) && good
    println(if (good) "darwin-syscalls: all ok" else "darwin-syscalls: FAILED")
    // exit_group with a status the harness checks
    linuxSyscall1(231, if (good) 7 else 9)
    1
}
