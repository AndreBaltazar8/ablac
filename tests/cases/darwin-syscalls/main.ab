import "abla/io"
import "abla/sys/linux"
import "abla/unsafe/memory"

// The calls a macOS program issues by BSD system call (#811), through the portable
// Linux-numbered surface; on Linux the same numbers are the kernel's, so the
// program prints the same lines everywhere. Each line is "name: result".

fun report(name: string, ok: bool, value: int): bool {
    println("${name}: ${if (ok) "ok" else "FAIL"} ($value)")
    ok
}

fun main: int {
    var good = true
    val pid = linuxSyscall0(39)
    good = report("getpid", pid > 0 && pid == linuxProcessId(), pid) && good
    val text = "darwin-syscalls: write\n"
    val written = linuxSyscall3(1, 1, nativeCStringAddress(text), text.size)
    good = report("write", written == text.size, written) && good
    // stdout may be a pipe (ESPIPE, 29), a file or a terminal: any of them is a valid answer
    val seek = linuxSyscall3(8, 1, 0, 1)
    good = report("lseek", seek >= 0 || seek == -29, seek) && good
    val duplicate = linuxSyscall2(33, 1, 9)
    good = report("dup2", duplicate == 9, duplicate) && good
    linuxSyscall1(3, 9)
    val sync = linuxSyscall1(74, 1)
    good = report("fsync", sync == 0 || sync == -22 || sync == -25, sync) && good
    val dot = "."
    val changed = linuxSyscall1(80, nativeCStringAddress(dot))
    good = report("chdir", changed == 0, changed) && good
    val missing = "/nonexistent-darwin-syscalls-directory"
    val failed = linuxSyscall1(80, nativeCStringAddress(missing))
    good = report("chdir error", failed == -2, failed) && good
    val previous = linuxSyscall1(95, 18)
    val restored = linuxSyscall1(95, previous)
    good = report("umask", previous >= 0 && restored == 18, restored) && good
    // Files and directories (second group): a work directory under the repository's build/.
    val directory = "build/darwin-syscalls/work"
    val file = "build/darwin-syscalls/work/a"
    val moved = "build/darwin-syscalls/work/b"
    val link = "build/darwin-syscalls/work/l"
    linuxSyscall1(87, nativeCStringAddress(moved))
    linuxSyscall1(87, nativeCStringAddress(file))
    linuxSyscall1(87, nativeCStringAddress(link))
    linuxSyscall1(84, nativeCStringAddress(directory))
    val made = linuxSyscall2(83, nativeCStringAddress(directory), 493)
    good = report("mkdir", made == 0, made) && good
    val again = linuxSyscall2(83, nativeCStringAddress(directory), 493)
    good = report("mkdir exists", again == -17, again) && good
    val reachable = linuxSyscall2(21, nativeCStringAddress(directory), 0)
    good = report("access", reachable == 0, reachable) && good
    val absent = linuxSyscall2(21, nativeCStringAddress(moved), 0)
    good = report("access missing", absent == -2, absent) && good
    val descriptor = linuxSyscall4(257, -100, nativeCStringAddress(file), 577, 420)
    good = report("openat create", descriptor >= 3, descriptor) && good
    val fchmoded = linuxSyscall2(91, descriptor, 384)
    good = report("fchmod", fchmoded == 0, fchmoded) && good
    val locked = linuxSyscall2(73, descriptor, 2)
    good = report("flock", locked == 0, locked) && good
    val unlocked = linuxSyscall2(73, descriptor, 8)
    good = report("flock unlock", unlocked == 0, unlocked) && good
    val flags = linuxSyscall3(72, descriptor, 3, 0)
    good = report("fcntl F_GETFL", flags >= 0 && (flags & 3) == 1, flags) && good
    val setFlags = linuxSyscall3(72, descriptor, 4, 2048)
    val nonBlocking = linuxSyscall3(72, descriptor, 3, 0)
    good = report("fcntl F_SETFL", setFlags == 0 && nonBlocking >= 0 && (nonBlocking & 2048) != 0, nonBlocking) && good
    val copy = linuxSyscall3(72, descriptor, 1030, 10)
    val copyFlags = if (copy >= 0) linuxSyscall3(72, copy, 1, 0) else -1
    good = report("fcntl F_DUPFD_CLOEXEC", copy >= 10 && copyFlags >= 0 && (copyFlags & 1) == 1, copy) && good
    if (copy >= 0) linuxSyscall1(3, copy)
    linuxSyscall1(3, descriptor)
    val chmoded = linuxSyscall2(90, nativeCStringAddress(file), 420)
    good = report("chmod", chmoded == 0, chmoded) && good
    val renamed = linuxSyscall2(82, nativeCStringAddress(file), nativeCStringAddress(moved))
    good = report("rename", renamed == 0, renamed) && good
    val linked = linuxSyscall2(88, nativeCStringAddress(moved), nativeCStringAddress(link))
    good = report("symlink", linked == 0, linked) && good
    val unlinkedLink = linuxSyscall1(87, nativeCStringAddress(link))
    good = report("unlink link", unlinkedLink == 0, unlinkedLink) && good
    val unlinked = linuxSyscall1(87, nativeCStringAddress(moved))
    good = report("unlink", unlinked == 0, unlinked) && good
    val removed = linuxSyscall1(84, nativeCStringAddress(directory))
    good = report("rmdir", removed == 0, removed) && good
    val removedAgain = linuxSyscall1(84, nativeCStringAddress(directory))
    good = report("rmdir missing", removedAgain == -2, removedAgain) && good
    println(if (good) "darwin-syscalls: all ok" else "darwin-syscalls: FAILED")
    // exit_group with a status the harness checks
    linuxSyscall1(231, if (good) 7 else 9)
    1
}
