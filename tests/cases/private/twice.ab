import "abla/compiler/parser"

// Its own `helper`, which the expansion below doesn't mean.
private fun helper(value: int): int = value * 100

// `$twice(x)` is `helper(x) + helper(x)`, with the invoking module's `helper`.
compile fun parseTwice(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val argument = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    syntaxBinary("+", syntaxCall("helper", [argument]), syntaxCall("helper", [argument]))
}

#compilerRegisterSubparser("twice", parseTwice)
