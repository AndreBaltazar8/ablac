// Private names: visible only here. A transform's generated members see them.
import "abla/compiler"

private val greeting = "hello"

private class Node(val value: int)

private fun helper(n: int): int = n * 2

interface Doubler {
    fun doubled(): int
}

class Box(val n: int)

compile fun derive(): void {
    compiler.addConformance(
        compiler.findClass("Box"), "Doubler", ["fun doubled(): int = helper(this.n)"]
    )
    return
}

#compiler.transform(derive)

compile fun nodeIsPrivate(): bool = compiler.isPrivate(compiler.findClass("Node"))

val NODE_PRIVATE = #nodeIsPrivate()

fun api(n: int): string {
    val node = Node(helper(n))
    "$greeting ${node.value}"
}
