// Another module's private `helper`: no clash with helpers.ab's.

private fun helper(n: int): int = n + 100

class Point(val x: int)

private fun Point.secret(): int = this.x * 7

private var Point.tag: string = "t"

fun setTag(var value: Point, text: string): void { value.tag = text; return }
fun readTag(value: Point): string = value.tag

fun other(n: int): int = helper(n) + Point(1).secret() - 7
