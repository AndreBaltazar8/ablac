import "abla/io"
import "patterns-other.ab"

// A private constant or class used as a `when` match (`A ->`, `0, A ->`,
// `A, B ->`, `is C ->`) is this module's own, beside another module's of
// the same name; a lambda's parameter or a loop's variable of that name is
// still that.
private val LIMIT = 1
private val SECOND = 2
private val LOW = 10
private val HIGH = 20

private interface Piece
private class Mark(val size: int) : Piece
private class Gap(val size: int) : Piece

fun classify(value: int): int = when (value) {
    LIMIT -> 100
    0, SECOND -> 200
    LOW, HIGH -> 300
    else -> 0
}

fun oneLine(value: int): int = when (value) { LIMIT, SECOND -> 1
    else -> 0 }

private fun pieceSize(piece: Piece): int = when (piece) {
    is Mark -> piece.size
    is Gap -> 0 - piece.size
    else -> 0
}

fun pieces(): int = pieceSize(Mark(7)) + pieceSize(Gap(3))

private fun applyToFive(function: (int) -> int): int = function(5)

// `LIMIT` is the lambda's parameter here, and `LOW` the loop's variable.
fun bound(): int {
    var total = applyToFive { LIMIT -> LIMIT * 2 }
    for (LOW in [1]) total = total + LOW
    total
}

fun summary(): string =
    "${classify(1)} ${classify(2)} ${classify(20)} ${classify(35)} ${oneLine(2)} " +
    "${otherClassify(2)} ${otherClassify(3)} ${otherClassify(30)} ${otherClassify(1)} " +
    "${otherOneLine(3)} ${pieces()} ${otherPieces()} ${bound()}"

fun main: int {
    val atRunTime = summary()
    val atCompileTime = #summary()
    println(atRunTime)
    if (atRunTime == atCompileTime) 42 else 1
}
