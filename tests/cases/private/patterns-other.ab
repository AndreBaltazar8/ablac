// The same private names as patterns.ab, with other values, used the same way.
private val LIMIT = 2
private val SECOND = 3
private val LOW = 30
private val HIGH = 40

private interface Piece
private class Mark(val size: int) : Piece
private class Gap(val size: int) : Piece

fun otherClassify(value: int): int = when (value) {
    LIMIT -> 100
    0, SECOND -> 200
    LOW, HIGH -> 300
    else -> 0
}

fun otherOneLine(value: int): int = when (value) { LIMIT, SECOND -> 1
    else -> 0 }

private fun pieceSize(piece: Piece): int = when (piece) {
    is Mark -> piece.size
    is Gap -> 0 - piece.size
    else -> 0
}

fun otherPieces(): int = pieceSize(Mark(5)) + pieceSize(Gap(2))
