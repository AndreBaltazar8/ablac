import "abla/io"
import "./helpers.ab"
import "./other.ab"

// This module's own public `helper`.
fun helper(n: int): int = n - 1

val STAGED = #api(3)

fun main: int {
    var point = Point(3)
    setTag(point, "changed")
    if (readTag(point) != "changed") return 1
    val doubler: Doubler = Box(21)
    println("${api(3)} ${other(1)} ${helper(10)} ${doubler.doubled()} $NODE_PRIVATE $STAGED")
    42
}
