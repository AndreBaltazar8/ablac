import "abla/yaml"
import "abla/bytes"

fun yamlEditCheck(): int {
    val source = "# untouched\r\naccounts:\r\n  'first@example.com':\r\n    password: 'old' # keep\r\n    port: 993\r\nother: [one, two]"
    val document = yamlParseDocument(source)
    if (!document.succeeded || document.document.toText() != source) return 1
    val edit = document.document.edit()
    if (!edit.set([yamlKey("accounts"), yamlKey("first@example.com"), yamlKey("password")], yamlString("new'pass"))) return 2
    val expected = "# untouched\r\naccounts:\r\n  'first@example.com':\r\n    password: 'new''pass' # keep\r\n    port: 993\r\nother: [one, two]"
    if (edit.finish().document.toText() != expected) return 3
    if (!edit.set([yamlKey("accounts"), yamlKey("first@example.com"), yamlKey("password")], yamlString("new'pass"))) return 4
    if (edit.finish().document.toText() != expected) return 5
    if (!edit.insert([yamlKey("accounts"), yamlKey("second@example.com")], yamlObject(["password", "port"], [yamlString("another"), yamlInteger(993)]))) return 6
    if (!edit.remove([yamlKey("other"), yamlIndex(0)])) return 7
    val changed = edit.finish()
    if (!changed.succeeded || changed.document.value.get("other").at(0).asString() != "two") return 8
    if (changed.document.value.get("accounts").get("second@example.com").get("port").asInt() != 993) return 9
    val anchored = yamlParseDocument("defaults: &d {port: 993}\naccount: *d # alias\n")
    val aliases = anchored.document.edit()
    if (!aliases.materialize([yamlKey("account")])) return 10
    if (!aliases.set([yamlKey("account"), yamlKey("port")], yamlInteger(995))) return 11
    if (aliases.finish().document.value.get("defaults").get("port").asInt() != 993) return 12
    if (aliases.finish().document.value.get("account").get("port").asInt() != 995) return 13
    val rollback = document.document.edit()
    if (!rollback.set([yamlKey("other"), yamlIndex(0)], yamlString("changed"))) return 14
    if (rollback.remove([yamlKey("absent")])) return 15
    val failed = rollback.finish()
    if (failed.succeeded || failed.document.toText() != source) return 16
    val protected = anchored.document.edit()
    if (protected.set([yamlKey("defaults"), yamlKey("port")], yamlInteger(995))) return 17
    if (protected.finish().error.code != "edit.anchor") return 18
    val folded = yamlParseDocument("text: >- # header\n  old\n# footer\n")
    val foldEdit = folded.document.edit()
    if (!foldEdit.set([yamlKey("text")], yamlString("one\n\ntwo\n"))) return 19
    if (foldEdit.finish().document.value.get("text").asString() != "one\n\ntwo\n") return 20
    val small = yamlParseDocument("a: 1\n", YamlLimits(maximumBytes = 16))
    val bounded = small.document.edit()
    if (bounded.set([yamlKey("a")], yamlString("this will not fit the document"))) return 21
    if (bounded.finish().document.toText() != "a: 1\n") return 22
    val work = yamlParseDocument("a: x\n", YamlLimits(maximumWork = 100)).document.edit()
    var i = 0
    while (i < 40) { work.set([yamlKey("a")], yamlInteger(i)); i += 1 }
    if (work.finish().succeeded || work.finish().error.code != "limit.work") return 23
    if (work.finish().document.toText() != "a: x\n") return 24
    val large = byteBuffer()
    large.appendText("a: &a ")
    i = 0
    while (i < 16) { large.appendText("x"); i += 1 }
    large.appendText("\nb: &b [")
    i = 0
    while (i < 16) { if (i > 0) large.appendText(","); large.appendText("*a"); i += 1 }
    large.appendText("]\nc: [")
    i = 0
    while (i < 32) { if (i > 0) large.appendText(","); large.appendText("*b"); i += 1 }
    large.appendText("]\n")
    val largeSource = large.toText()
    val largeLimits = YamlLimits(maximumBytes = 256)
    val largeDoc = yamlParseDocument(largeSource, largeLimits)
    if (!largeDoc.succeeded) return 25
    val same = yamlParse(largeSource, largeLimits)
    if (!same.succeeded || yamlEmit(same.value, limits = largeLimits).succeeded) return 26
    val noOp = largeDoc.document.edit()
    if (!noOp.set([], same.value) || noOp.finish().document.toText() != largeSource) return 27
    if (!noOp.set([yamlKey("c")], same.value.get("c")) || noOp.finish().document.toText() != largeSource) return 28
    42
}
