import "abla/yaml"
import "abla/bytes"
import "abla/text"

fun yamlCheck(): int {
    val parsed = yamlParse("items:\n- {name: 'first', value: 0xA}\n- &item {name: second, value: 10}\ncopy: *item\ntext: >-\n  one\n  two\n")
    if (!parsed.succeeded) return 1
    if (parsed.value.get("items").at(0).get("value").asInt() != 10) return 2
    if (parsed.value.get("copy").get("name").asString() != "second") return 3
    if (parsed.value.get("text").asString() != "one two") return 4
    if (yamlNumberText("-9223372036854775808").asInt() != -9223372036854775808) return 5
    if (yamlNumberText("9223372036854775808").intAvailable()) return 6
    if (yamlNumberText("-0.001200e999999999999999999999").numberValue.canonical != "-12e999999999999999999995") return 7
    if (!yamlParse("a: &a old\nb: &a new\nc: *a").succeeded) return 8
    if (yamlParse("0xA: 1\n10: 2").succeeded) return 9
    if (yamlParse("1e0: 1\n1.0: 2").succeeded) return 10
    if (!yamlParse("1: a\n1.0: b\n'1': c").succeeded) return 11
    if (yamlParse("a: &a [*a]").succeeded) return 12
    if (yamlParse("a: *missing").succeeded) return 13
    if (yamlParse("a: !!str x").error.message != "YAML tags are not supported") return 14
    if (yamlParse("<<: x").error.message != "YAML merge keys are not supported") return 15
    if (!yamlParse("'<<': x").succeeded) return 16
    if (yamlParse("a: [1,2,3]", YamlLimits(maximumNodes = 3)).succeeded) return 17
    if (yamlParse("[[[1]]]", YamlLimits(maximumDepth = 3)).succeeded) return 18
    if (yamlParse("a: &a [1,2]\nb: [*a,*a,*a]", YamlLimits(maximumExpandedNodes = 12)).succeeded) return 19
    if (yamlParse("a: &a abc\nb: [*a,*a]", YamlLimits(maximumExpandedScalarBytes = 8)).succeeded) return 20
    if (yamlParse("a: &a x\nb: *a\nc: *a", YamlLimits(maximumAliases = 1)).succeeded) return 21
    if (yamlParse("a: x\nb: y", YamlLimits(maximumCollectionMembers = 1)).succeeded) return 22
    if (yamlParse("12345", YamlLimits(maximumNumberBytes = 4)).succeeded) return 23
    if (yamlParse("'abcdef'", YamlLimits(maximumScalarBytes = 4)).succeeded) return 24
    if (yamlParse("x", YamlLimits(maximumDepth = 257)).succeeded) return 25
    if (yamlParse("abc", YamlLimits(maximumBytes = 2)).succeeded) return 26
    if (yamlParse("[a,b,c]", YamlLimits(maximumWork = 1)).succeeded) return 27
    if (yamlParse("---\na\n---\nb").error.code != "unsupported.documents") return 28
    if (yamlParse("? [a]\n: b").error.code != "unsupported.key") return 29
    if (yamlParse("{,}").succeeded) return 30
    if (yamlParse("{, a: b}").succeeded) return 31
    if (yamlParse("...word").value.asString() != "...word") return 32
    if (!yamlParse("%YAML   1.2 # comment\n---\na: b\n").succeeded) return 33
    if (yamlParse("%YAML 1.2\n%TAG !e! tag:example.com,2000:\n---\nx").error.message != "YAML tags are not supported") return 34
    if (yamlParse("x: \"a\\\n\n  b\"\n").value.get("x").asString() != "a\nb") return 35
    if (yamlParse("a: 1\n \t # comment\nb: 2\n").value.get("a").asInt() != 1) return 36
    val longKey = byteBuffer()
    var index = 0
    while (index < 1025) { longKey.appendText("a"); index += 1 }
    if (yamlParse(longKey.toText() + ": value").succeeded) return 37
    if (yamlParse("[" + longKey.toText() + ": value]").succeeded) return 38
    var nested = "0"
    index = 0
    while (index < 255) { nested = "[" + nested + "]"; index += 1 }
    if (!yamlParse(nested, YamlLimits(maximumDepth = 256)).succeeded) return 39
    if (yamlParse("[" + nested + "]", YamlLimits(maximumDepth = 256)).succeeded) return 40
    val invalid = yamlParse("\n" + byteEncode(255))
    if (invalid.succeeded || invalid.error.byteOffset != 1 || invalid.error.line != 2 || invalid.error.column != 1) return 41
    val bomInvalid = yamlParse("\ufeff" + byteEncode(255))
    if (bomInvalid.succeeded || bomInvalid.error.byteOffset != 3 || bomInvalid.error.column != 1) return 41
    val nonprint = byteEncode(127) + utf8Encode(128) + utf8Encode(65534)
    val quotedNonprint = yamlParse("\"" + nonprint + "\"")
    if (!quotedNonprint.succeeded || quotedNonprint.value.asString() != nonprint) return 41
    if (yamlParse("plain" + nonprint).succeeded || yamlParse("# " + nonprint).succeeded) return 41
    42
}
