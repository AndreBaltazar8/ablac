import "abla/yaml"
import "abla/json"
import "abla/fs"
import "abla/io"
import "abla/process/arguments"
fun show(value: Yaml): Json {
    if (value.kind == 0) return jsonArray([jsonString("null")])
    if (value.kind == 1) return jsonArray([jsonString("str"), jsonString(value.stringValue)])
    if (value.kind == 2) return jsonArray([jsonString(if (value.numberValue.integer) "int" else "float"), jsonString(value.numberValue.canonical)])
    if (value.kind == 3) return jsonArray([jsonString("bool"), jsonBoolean(value.boolValue)])
    val values: array<Json> = []
    var i = 0
    while (i < value.values.size) {
        if (value.kind == 5) values.append(jsonArray([show(value.keys[i]), show(value.values[i])]))
        else values.append(show(value.values[i]))
        i += 1
    }
    jsonArray([jsonString(if (value.kind == 5) "map" else "seq"), jsonArray(values)])
}
fun main(): int {
    val parsed = yamlParse(Path(processArgument(0)).readText())
    if (!parsed.succeeded) {
        println(jsonStringify(jsonArray([jsonString("error"), jsonString(parsed.error.code), jsonString(parsed.error.message), jsonInteger(parsed.error.line), jsonInteger(parsed.error.column)])))
        return 1
    }
    if (processArgumentCount() > 1) {
        val first = yamlEmit(parsed.value, YamlEmitOptions(flow = processArgument(1) == "flow"))
        if (!first.succeeded) return 2
        val again = yamlParse(first.text)
        if (!again.succeeded || yamlEmit(again.value, YamlEmitOptions(flow = processArgument(1) == "flow")).text != first.text) return 3
        println(jsonStringify(show(again.value)))
    } else println(jsonStringify(show(parsed.value)))
    0
}
