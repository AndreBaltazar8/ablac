import "abla/yaml"
fun emitCheck(): int {
    val value = yamlObject(["null", "accounts", "quoted", "empty"], [yamlString("true"),
        yamlObject(["mail@example.com"], [yamlObject(["port", "password"], [yamlInteger(993), yamlString("s'e\"c\\r\net")])]),
        yamlString("\u0080\u0085\u009f\u007f\u0000"), yamlSequence([])])
    val emitted = yamlEmit(value)
    if (!emitted.succeeded) return 1
    val read = yamlParse(emitted.text)
    if (!read.succeeded || read.value.get("null").asString() != "true") return 2
    if (read.value.get("accounts").get("mail@example.com").get("password").asString() != "s'e\"c\\r\net") return 3
    if (read.value.get("quoted").asString() != value.get("quoted").asString()) return 4
    if (yamlEmit(read.value).text != emitted.text) return 5
    val flow = yamlEmit(value, YamlEmitOptions(flow = true))
    if (!flow.succeeded || !yamlParse(flow.text).succeeded) return 6
    if (yamlEmit(yamlObject(["a"], [])).succeeded) return 7
    if (yamlEmit(yamlMapping([yamlInteger(10), yamlNumberText("0xA")], [yamlNull(), yamlNull()])).succeeded) return 8
    if (yamlEmit(yamlNumberText("not a number")).succeeded) return 9
    if (yamlEmit(value, limits = YamlLimits(maximumBytes = 8)).succeeded) return 10
    if (yamlEmit(value, limits = YamlLimits(maximumDepth = 2)).succeeded) return 11
    if (yamlEmit(value, YamlEmitOptions(newline = "x")).succeeded) return 12
    if (yamlEmit(yamlMapping([yamlSequence([])], [yamlNull()])).succeeded) return 13
    if (yamlEmit(yamlMapping([yamlString("<<")], [yamlNull()])).text != "\"<<\": null\n") return 14
    if (yamlEmit(yamlNumberText(".nan")).text != ".nan\n") return 15
    42
}
val stagedEmit = #emitCheck()
@export("check")
fun wasmCheck(): int = emitCheck()
fun main(): int = if (stagedEmit == 42) emitCheck() else stagedEmit
