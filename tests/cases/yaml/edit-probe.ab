import "abla/yaml"
import "abla/json"
import "abla/fs"
import "abla/io"
import "abla/process/arguments"
fun show(value: Yaml): Json {
    if (value.kind == 0) return jsonArray([jsonString("null")])
    if (value.kind == 1) return jsonArray([jsonString("str"), jsonString(value.stringValue)])
    if (value.kind == 2) return jsonArray([jsonString(if (value.numberValue.integer) "int" else "float"), jsonString(value.numberValue.canonical)])
    if (value.kind == 3) return jsonArray([jsonString("bool"), jsonBoolean(value.boolValue)])
    val values: array<Json> = []
    var i = 0
    while (i < value.values.size) {
        if (value.kind == 5) values.append(jsonArray([show(value.keys[i]), show(value.values[i])]))
        else values.append(show(value.values[i]))
        i += 1
    }
    jsonArray([jsonString(if (value.kind == 5) "map" else "seq"), jsonArray(values)])
}
// edit-probe SPEC.json [value]: apply the spec's operations and print one canonical
//   line {"succeeded","error","text"}; with `value`, a second line holds the value.
// edit-probe noop FILE: edit nothing and print the document text, raw.
// edit-probe root FILE: set the root to the file's own text, parsed, and print the text, raw.
fun main(): int {
    val mode = processArgument(0)
    if (mode == "noop" || mode == "root") {
        val source = Path(processArgument(1)).readText()
        val document = yamlParseDocument(source)
        if (!document.succeeded) return 1
        val editor = document.document.edit()
        if (mode == "root") editor.set([], yamlParse(source).value)
        val result = editor.finish()
        if (!result.succeeded) return 2
        print(result.document.toText())
        return 0
    }
    val spec = jsonParse(Path(mode).readText()).value
    val document = yamlParseDocument(spec.get("source").asString())
    if (!document.succeeded) return 1
    val editor = document.document.edit()
    for (operation in spec.get("ops").values) {
        val path: array<YamlPathPart> = []
        for (part in operation.get("path").values) {
            if (part.kind == 1) path.append(yamlKey(part.asString()))
            else if (part.kind == 2) path.append(yamlIndex(part.asInt()))
            else path.append(yamlValueKey(yamlParse(part.get("key").asString()).value))
        }
        val method = operation.get("op").asString()
        val value = yamlParse(operation.get("value").asString()).value
        if (method == "set") editor.set(path, value)
        else if (method == "insert") editor.insert(path, value)
        else if (method == "remove") editor.remove(path)
        else if (method == "materialize") editor.materialize(path)
    }
    val result = editor.finish()
    println(jsonStringify(jsonObject(["succeeded", "error", "text"], [jsonBoolean(result.succeeded), jsonString(result.error.code), jsonString(result.document.toText())])))
    if (processArgumentCount() > 1 && processArgument(1) == "value") println(jsonStringify(show(result.document.value)))
    0
}
