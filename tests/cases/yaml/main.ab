import "abla/yaml"
import "abla/io"
fun main(): int {
    val p = yamlParse("accounts:\n  test@example.com:\n    password: 'secret'\n    port: 993\nlist: [1, 2, true, null]\n")
    if (!p.succeeded) { println(p.error.message); println("${p.error.line}:${p.error.column}"); return 1 }
    if (p.value.get("accounts").get("test@example.com").get("port").asInt() != 993) return 2
    if (p.value.get("list").size() != 4) return 3
    println("yaml: ok")
    0
}
