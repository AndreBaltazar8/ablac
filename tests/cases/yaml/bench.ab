import "abla/yaml"
import "abla/json"
import "abla/fs"
import "abla/process/arguments"
fun main(): int {
    val text = Path(processArgument(1)).readText()
    var total = 0
    var i = 0
    while (i < 10) {
        if (processArgument(0) == "yaml") {
            val result = yamlParse(text)
            if (!result.succeeded) return 1
            total += result.value.size()
        } else {
            val result = jsonParse(text)
            if (!result.succeeded) return 2
            total += result.value.size()
        }
        i += 1
    }
    if (total == 80000) 0 else 3
}
