import "./phases.ab"
import "./emit.ab"
import "./edit-phases.ab"
val parserCheck = #yamlCheck()
val emitterCheck = #emitCheck()
val editorCheck = #yamlEditCheck()
@export("check")
fun wasmCheck(): int {
    val parser = yamlCheck()
    if (parser != 42) return parser
    val emitter = emitCheck()
    if (emitter != 42) return emitter + 100
    val editor = yamlEditCheck()
    if (editor != 42) return editor + 200
    42
}
fun main(): int {
    if (parserCheck != 42) return parserCheck
    if (emitterCheck != 42) return emitterCheck + 100
    if (editorCheck != 42) return editorCheck + 200
    wasmCheck()
}
