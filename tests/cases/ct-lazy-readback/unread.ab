// A native site's writes that no later evaluation reads aren't read back into the compiler (#1022): `made` and
// `hits` stay the generation's to the end of the build. A program starts from its globals' initializers anyway.
import "abla/io"

var made: array<int> = []
compile var hits: int = 0

compile fun fill(count: int): int {
    var index = 0
    while (index < count) {
        made.append(index * 3)
        index = index + 1
    }
    hits = hits + 1
    made.size
}

val filled = #fill(1000)

fun main: int {
    println("$filled ${made.size}")
    0
}
