// What a native site wrote is read back when a later interpreted evaluation reads it (#1022): `seen` runs in the
// interpreter after `fill` ran natively and sees `hits` as fill left it.
import "abla/io"
import "abla/compiler"

var made: array<int> = []
compile var hits: int = 0

compile fun fill(count: int): int {
    var index = 0
    while (index < count) {
        made.append(index * 3)
        index = index + 1
    }
    hits = hits + 1
    made.size
}

// Naming a compiler API call that takes a function keeps a site in the interpreter (the call itself never runs).
compile fun interpreted(value: int): int {
    if (value < 0) compilerApplyTransform({ })
    value
}

compile fun seen(): int = interpreted(hits)

val filled = #fill(1000)
val later = #seen()

fun main: int {
    println("$filled ${made.size} $later")
    0
}
