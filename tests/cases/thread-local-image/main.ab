// Initialized thread-locals in an executable linked without libc (#829): each thread block's .tdata image must sit where
// the linker addressed it, tp - roundup(p_memsz, p_align). Three sites with initial bytes, each written (so each stays
// a thread-local with its image), read on the main thread and on a new thread, whose block starts from the image again.
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "abla/unsafe/memory/raw"

trusted fun tick(): int {
    val slot = nativePointerFromAddress(nativeThreadLocalBytes("\x05\x00\x00\x00\x00\x00\x00\x00"))
    val value = ablaUnsafeLoadI64(slot)
    ablaUnsafeStoreI64(slot, value + 1)
    value
}

trusted fun tock(): int {
    val slot = nativePointerFromAddress(nativeThreadLocalBytes("\x11\x22\x33\x44\x00\x00\x00\x00"))
    val value = ablaUnsafeLoadI64(slot)
    ablaUnsafeStoreI64(slot, value + 2)
    value
}

// 24 bytes: the last word is the one read.
trusted fun wide(): int {
    val slot = nativePointerFromAddress(
        nativeThreadLocalBytes("\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00"))
    val last = ablaUnsafePointerOffset(slot, 16)
    val value = ablaUnsafeLoadI64(last)
    ablaUnsafeStoreI64(last, value * 3)
    value
}

fun round(): int {
    val a = tick()
    val b = tick()
    val c = tock()
    val d = tock()
    val e = wide()
    val f = wide()
    if (a == 5 && b == 6 && c == 1144201745 && d == 1144201747 && e == 7 && f == 21) 1 else 0
}

fun main: int {
    val mainThread = round()
    val other = thread { round() }
    val otherThread = await other
    val again = tick()
    if (mainThread == 1 && otherThread == 1 && again == 7) 42 else mainThread * 10 + otherThread
}
