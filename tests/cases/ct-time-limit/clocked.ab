// A `#` site that keeps reading the clock for a minute: each read is a call into the compiler, where the time
// limit's signal often lands. Both tiers must stop it at the limit (#1036: the native tier crashed).
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

fun spin(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 60000) turns = turns + 1
    42
}

val spun = #spin()
fun main: int = spun
