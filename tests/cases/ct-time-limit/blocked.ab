// A `#` site blocked in a system call: it reads a pipe whose write end it keeps open, so the read never returns by
// itself. Both tiers must stop it at ABLA_COMPILE_EVAL_TIME_LIMIT with E_CT_TIME_LIMIT; the interpreter used to wait
// for ever (only its step limit bounded it, and a blocked call takes no steps).
import "abla/compiler"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
#compilerGrant("trusted.native")

trusted fun blockedRead(): int {
    val ends = nativeByteBuffer(8)
    linuxSyscall2(293, nativePointerAddress(ends.address), 524288)
    val reader = ends.load(0) + ends.load(1) * 256 + ends.load(2) * 65536
    val bytes = nativeByteBuffer(16)
    var read = -4
    // EINTR (-4) is retried, as the standard library's reads do.
    while (read == -4) read = linuxSyscall3(0, reader, nativePointerAddress(bytes.address), 16)
    read
}

val staged = #blockedRead()
fun main: int = staged
