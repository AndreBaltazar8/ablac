// A `#` site that sleeps for a minute: both tiers must stop it at ABLA_COMPILE_EVAL_TIME_LIMIT. The sleep runs in the
// compiler (a provider): the interpreter slept the whole minute and then built the program (#1037), and the native
// tier's stop jumped over the compiler's frames and took the compiler down (#1036).
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

fun nap(): int {
    sleep(60000)
    42
}

val napped = #nap()
fun main: int = napped
