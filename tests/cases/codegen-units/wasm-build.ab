import "abla/wasm/build"

// Development modules for tools/test-codegen-units.sh, which builds this file
// with one code generation unit and with eight: one whose `orElse`
// alternatives are left by an exception (exception handling), and one without.
// The first registers the target; the second reuses it.
val unwinding = #wasmBuildModule(
    "codegen-units-unwinding", "tests/cases/stm/unwinding/module.ab",
    "build/codegen-units/wasm/unwinding.wasm", true, false
)
val plain = #buildProgram(
    "codegen-units-plain", "tests/cases/stm/surface-module.ab",
    "build/codegen-units/wasm/plain.wasm", "wasm32-module", "module", true, false
)

fun main: int = if (unwinding && plain) 0 else 1
