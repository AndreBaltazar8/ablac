// Division in WebAssembly, where the instructions themselves trap on a zero
// divisor and on MIN / -1: the checks come first, so MIN / -1 wraps and a
// zero divisor ends in the runtime's panic (an `unreachable` trap there).
@export("divide")
fun divide(a: i64, b: i64): i64 = a / b

@export("remainder")
fun remainder(a: i64, b: i64): i64 = a % b

@export("divide32")
fun divide32(a: i32, b: i32): i32 = a / b

@export("remainder32")
fun remainder32(a: i32, b: i32): i32 = a % b

@export("divideUnsigned")
fun divideUnsigned(a: u32, b: u32): u32 = a / b
