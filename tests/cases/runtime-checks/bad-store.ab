// tools/test-runtime-checks.sh: a bad store (address 16) in a function a release build keeps by its name, which the
// fault report's instruction symbolizes to (`ablac symbolize`).
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

@noinline
@export("abla_test_bad_store")
trusted fun badStore(): int {
    ablaUnsafeStoreU8(nativePointerFromAddress(16), 1)
    return 0
}

fun main {
    println("${badStore()}")
}
