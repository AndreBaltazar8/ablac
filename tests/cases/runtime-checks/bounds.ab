// Every bounds-checked operation panics with its reason (exit 101).
import "abla/io"
import "abla/process"

fun main {
    val which = if (processArgumentCount() > 0) processArgument(0) else ""
    val k = processArgumentCount() + 4
    var ints = [1, 2, 3]
    var words = ["a", "b"]
    var flags = [true]
    val text = "hello"
    if (which == "array-read") println("${ints[k]}")
    if (which == "array-write") ints[k] = 0
    if (which == "array-negative") println("${ints[-k]}")
    if (which == "string-array") println(words[k])
    if (which == "string-array-write") words[-1] = "x"
    if (which == "bool-array") println("${flags[k]}")
    if (which == "string-index") println("${text[k + 1]}")
    if (which == "slice") println(text.slice(3, k + 5))
    if (which == "slice-reversed") println(text.slice(4, k - 3))
    if (which == "truncate") ints.truncate(4 - k)
    if (which == "filled") println("${filledArray(1 - k, 0).size}")
    // At or past the size, truncate changes nothing.
    ints.truncate(k)
    ints.truncate(3)
    if (ints.size != 3) println("truncated")
    println("ok")
}
