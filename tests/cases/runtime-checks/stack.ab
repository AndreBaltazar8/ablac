// Unbounded recursion panics with "stack overflow" (exit 101); any other
// SIGSEGV keeps its default course (`segv`).
import "abla/io"
import "abla/process"

extern:"c" fun raise(signal: int): int

// Not a tail call, nor one LLVM can turn into a loop (`-` doesn't commute).
fun deep(n: int): int = if (n == 0) 0 else n - deep(n - 1)

fun main {
    val which = if (processArgumentCount() > 0) processArgument(0) else ""
    if (which == "overflow") println("${deep(processArgumentCount() * 1000000000)}")
    if (which == "segv") raise(11)
    println("ok ${deep(1000)}")
}
