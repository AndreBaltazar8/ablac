// Unbounded recursion panics with "stack overflow" (exit 101), on the main thread or on a thread it started
// (`thread-overflow`, #831: each thread has its own signal stack); any other SIGSEGV keeps its default course (`segv`,
// a sent one), a release build saying first where a bad access was (`store`, at address 16).
import "abla/io"
import "abla/process"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

extern:"c" fun raise(signal: int): int

// Not a tail call, nor one LLVM can turn into a loop (`-` doesn't commute).
fun deep(n: int): int = if (n == 0) 0 else n - deep(n - 1)

trusted fun badStore(): int {
    ablaUnsafeStoreU8(nativePointerFromAddress(16), 1)
    return 0
}

fun main {
    val which = if (processArgumentCount() > 0) processArgument(0) else ""
    if (which == "overflow") println("${deep(processArgumentCount() * 1000000000)}")
    if (which == "thread-overflow") {
        val worker = thread { deep(processArgumentCount() * 1000000000) }
        println("${await worker}")
    }
    if (which == "segv") raise(11)
    if (which == "store") println("${badStore()}")
    println("ok ${deep(1000)}")
}
