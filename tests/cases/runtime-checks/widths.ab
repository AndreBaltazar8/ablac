// Division at every integer width: MIN / -1 wraps at the width, unsigned
// widths divide unsigned, nominal integers divide as their underlying type.
// The same text at run time and under `#`; a zero divisor panics (argument).
import "abla/io"
import "abla/process"

type Count = int

fun report(minus: int, seventeen: int): string {
    val i8min = i8(-128)
    val i16min = i16(-32768)
    val i32min = i32(-2147483648)
    val big = u64(minus)
    val three = u64(3)
    val n = Count(seventeen)
    "${i8min / i8(minus)} ${i8min % i8(minus)} ${i16min / i16(minus)} ${i16min % i16(minus)} ${i32min / i32(minus)} ${i32min % i32(minus)} ${big / three} ${big % three} ${big / big} ${u8(250) / u8(seventeen - 10)} ${u32(minus) % u32(10)} ${n / Count(5)} ${n % Count(-5)}"
}

fun main {
    val count = processArgumentCount()
    println(report(count - 1, count + 17))
    println(#report(-1, 17))
    if (count > 0) {
        val which = processArgument(0)
        val zero = count - 1
        val n = Count(17)
        if (which == "int") println("${n / zero}")
        if (which == "rem") println("${n % zero}")
        if (which == "u8") println("${u8(250) / u8(zero)}")
        if (which == "i32") println("${i32(7) % i32(zero)}")
        if (which == "u64") println("${u64(7) / u64(zero)}")
    }
}
