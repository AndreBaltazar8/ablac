// tools/test-runtime-checks.sh (x86-64 Linux): a bad load in code outside the program, as in a shared library. The
// file at argument 0 gets `mov rax, [16]` at byte 32 and is mapped executable; the call faults there, and the release
// report names the file and offset 0x20 from /proc/self/maps.
import "abla/io"
import "abla/process"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native"

trusted fun main: int {
    val path = processArgument(0)
    val code = nativeByteBuffer(64)
    val instruction = [0x48, 0x8b, 0x04, 0x25, 0x10, 0x00, 0x00, 0x00]
    for (k in 0 until instruction.size) code.store(32 + k, instruction[k])
    // openat(AT_FDCWD, path, O_WRONLY | O_CREAT | O_TRUNC, 0700), write, close.
    val output = ablaLinuxSyscall(257, -100, nativeCStringAddress(path), 577, 448, 0, 0)
    if (output < 0) { println("library-fault: open for writing failed ($output)"); return 1 }
    ablaLinuxSyscall(1, output, nativePointerAddress(code.address), 64, 0, 0, 0)
    ablaLinuxSyscall(3, output, 0, 0, 0, 0, 0)
    // openat(..., O_RDONLY), then mmap(0, 4096, PROT_READ | PROT_EXEC, MAP_PRIVATE, fd, 0).
    val input = ablaLinuxSyscall(257, -100, nativeCStringAddress(path), 0, 0, 0, 0)
    if (input < 0) { println("library-fault: open failed ($input)"); return 1 }
    val mapped = ablaLinuxSyscall(9, 0, 4096, 5, 2, input, 0)
    if (mapped < 0 && mapped > -4096) { println("library-fault: mmap failed ($mapped)"); return 1 }
    ablaUnsafeCallVoid0(mapped + 32)
    println("library-fault: no fault")
    0
}
