// Integer division and remainder: rounding toward zero, the sign of the
// remainder, MIN / -1 wrapping. The same text at run time and under `#`.
import "abla/io"

fun quotients(values: array<int>, divisors: array<int>): string {
    var out = ""
    for (value in values) {
        for (divisor in divisors) {
            out = "$out ${value / divisor}:${value % divisor}"
        }
    }
    out
}

fun report(): string {
    val min = -9223372036854775807 - 1
    var text = quotients([7, -7, 0, 9223372036854775807, min], [2, -2, 3, -1, 1])
    var total = 0
    var i = 1
    while (i < 50) {
        total = total + (i * 37) / (i % 7 + 1) - i % 5
        i = i + 1
    }
    "$text $total ${min / -1} ${min % -1}"
}

fun main {
    println(report())
    println(#report())
}
