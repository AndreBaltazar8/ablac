// What panics at run time is a positioned error under `#`, with the same text.
import "abla/io"

fun divide(a: int, b: int): int = a / b
fun remainder(a: int, b: int): int = a % b
fun element(i: int): int = [1, 2, 3][i]
fun byte(i: int): int = "abc"[i]
fun piece(): string = "hello".slice(3, 10)
fun cut(): int {
    var values = [1]
    values.truncate(4)
    values.truncate(values.size - 2)
    values.size
}
fun store(): int {
    var values = [1]
    values[3] = 2
    values[0]
}
fun filled(): int = filledArray(-2, 0).size

fun main {
    println("${#divide(7, 0)}")
    println("${#remainder(7, 0)}")
    println("${#element(5)}")
    println("${#byte(-1)}")
    println(#piece())
    println("${#cut()}")
    println("${#store()}")
    println("${#filled()}")
}
