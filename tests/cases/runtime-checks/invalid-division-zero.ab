// A divisor that is always zero is an error.
val NONE = 0
val ALSO = NONE * 3

fun main: int {
    val x = 7
    val a = x / 0
    val b = x % (2 - 2)
    val c = x / NONE
    val d = u8(x) / u8(0)
    val e = x % -ALSO
    // Not constant: a local shadows the global.
    val NONE = 1
    a + b + c + int(d) + e + x / NONE
}
