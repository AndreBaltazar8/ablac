// A debug (-g / --fast) build routes SIGABRT to the fault report: the first raise
// runs the handler, which prints the report and restores the default action, and
// returns (through the kernel's rt_sigreturn on x86-64 Linux), so execution goes
// on after the raise; the second raise then ends the process by the signal.
import "abla/io"

extern:"c" fun raise(signal: int): int

fun main {
    println("before")
    raise(6)
    println("after the first")
    raise(6)
    println("not reached")
}
