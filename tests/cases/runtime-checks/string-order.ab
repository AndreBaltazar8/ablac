// Strings order byte by byte, at run time and under `#`.
import "abla/io"

fun order(a: string, b: string): string =
    "${if (a < b) "<" else ""}${if (a <= b) "<=" else ""}${if (a > b) ">" else ""}${if (a >= b) ">=" else ""}"

fun sorted(var words: array<string>): string {
    var i = 1
    while (i < words.size) {
        var j = i
        while (j > 0 && words[j] < words[j - 1]) {
            val swap = words[j]
            words[j] = words[j - 1]
            words[j - 1] = swap
            j = j - 1
        }
        i = i + 1
    }
    var out = ""
    for (word in words) out = "$out[$word]"
    out
}

fun report(): string {
    val pairs = ["a", "b", "b", "a", "", "", "", "a", "ab", "abc", "abc", "ab",
        "abd", "abc", "Z", "a", "é", "z", "é", "ê"]
    var out = ""
    var i = 0
    while (i < pairs.size) {
        out = "$out ${order(pairs[i], pairs[i + 1])}"
        i = i + 2
    }
    "$out ${sorted(["pear", "apple", "fig", "", "apples", "Zebra", "été"])}"
}

fun main {
    println(report())
    println(#report())
}
