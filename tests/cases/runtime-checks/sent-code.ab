// A SIGSEGV this process queues itself (rt_sigqueueinfo, whose number is the argument: 129 on x86-64, 240 on AArch64)
// with si_code 0x10001, macOS's SI_USER (Linux lets a process give a signal it sends itself any code), and si_addr 16:
// a sent signal as macOS delivers one, which a release build reports without an address.
import "abla/process"
import "abla/sys/linux"
import "abla/unsafe/memory/raw"

trusted fun sendSegv(number: int): int {
    val info = nativeStaticAllocate(128)
    ablaUnsafeStoreU32(nativePointerFromAddress(info), 11)
    ablaUnsafeStoreU32(nativePointerFromAddress(info + 8), 65537)
    ablaUnsafeStoreI64(nativePointerFromAddress(info + 16), 16)
    linuxSyscall3(number, linuxProcessId(), 11, info)
}

fun main {
    sendSegv(if (processArgumentCount() > 0 && processArgument(0) == "aarch64") 240 else 129)
    return
}
