// A panic anywhere ends the whole process at once with its message and status
// 101: on the main thread, in a `thread { }` (another OS thread), in a
// `task { }`, in a generator, and an explicit `panic` in a thread.
import "abla/io"
import "abla/process"
import "abla/process/exit"

fun boom(n: int): int {
    val values = [1, 2]
    values[n]
}

fun inThread(): int {
    val worker = thread { boom(5) }
    await worker
}

fun inTask(n: int): int {
    val job = task { boom(n) }
    await job
}

fun numbers(n: int): Generator<int> = generator {
    yield 1
    yield boom(n)
}

fun inGenerator(n: int): int {
    var total = 0
    for (value in numbers(n)) total += value
    total
}

fun panicInThread(): int {
    val worker = thread {
        panic("from a thread")
        0
    }
    await worker
}

fun main {
    val which = if (processArgumentCount() > 0) processArgument(0) else ""
    val n = processArgumentCount() + 4
    if (which == "main") println("${boom(n)}")
    if (which == "thread") println("${inThread()}")
    if (which == "task") println("${inTask(n)}")
    if (which == "generator") println("${inGenerator(n)}")
    if (which == "thread-panic") println("${panicInThread()}")
    println("finished")
}
