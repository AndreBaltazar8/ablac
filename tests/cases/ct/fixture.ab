// What tools/test-ct.sh reads the assembly of, on each target: functions of secrets, exported
// so they have names, with nothing else in them. The `ct_fix_` ones must have no conditional
// branch, memory index or division from a secret; `ct_leak_` ones must be caught.
import "abla/ct"
import "abla/crypto/aes"
import "abla/crypto/bignum"
import "abla/crypto/der"
import "abla/crypto/rsa"
import "abla/unsafe/memory/raw"

@inline @export("ct_fix_select_u32")
fun fixSelectU32(mask: u32, a: u32, b: u32): u32 =
    ctSelect(secretU32(mask), secretU32(a), secretU32(b)).declassify()

@inline @export("ct_fix_select_u64")
fun fixSelectU64(mask: u64, a: u64, b: u64): u64 =
    ctSelect(secretU64(mask), secretU64(a), secretU64(b)).declassify()

@inline @export("ct_fix_select_u8")
fun fixSelectU8(mask: u8, a: u8, b: u8): u8 =
    ctSelect(secretU8(mask), secretU8(a), secretU8(b)).declassify()

@inline @export("ct_fix_eq_u32")
fun fixEqU32(a: u32, b: u32): u32 = ctEq(secretU32(a), secretU32(b)).declassify()

@inline @export("ct_fix_eq_u64")
fun fixEqU64(a: u64, b: u64): u64 = ctEq(secretU64(a), secretU64(b)).declassify()

@inline @export("ct_fix_lt_u32")
fun fixLtU32(a: u32, b: u32): u32 = ctLt(secretU32(a), secretU32(b)).declassify()

@inline @export("ct_fix_lt_u64")
fun fixLtU64(a: u64, b: u64): u64 = ctLt(secretU64(a), secretU64(b)).declassify()

@inline @export("ct_fix_max_u32")
fun fixMaxU32(a: u32, b: u32): u32 {
    val x = secretU32(a)
    val y = secretU32(b)
    ctSelect(ctLt(x, y), y, x).declassify()
}

@inline @export("ct_fix_arithmetic_u32")
fun fixArithmeticU32(a: u32, b: u32): u32 {
    val x = secretU32(a)
    val y = secretU32(b)
    (((x + y) ^ (x * y)) - (x & ~y) | x.rotl(7) | (y >> 3)).declassify()
}

@inline @export("ct_fix_add_u64")
fun fixAddU64(a: u64, b: u64): u64 = (secretU64(a) + secretU64(b)).declassify()

@inline @export("ct_fix_sub_u64")
fun fixSubU64(a: u64, b: u64): u64 = (secretU64(a) - secretU64(b)).declassify()

@inline @export("ct_fix_mul_u64")
fun fixMulU64(a: u64, b: u64): u64 = (secretU64(a) * secretU64(b)).declassify()

@inline @export("ct_fix_nonzero_u64")
fun fixNonZeroU64(a: u64): u64 = ctIsNonZero(secretU64(a)).declassify()

@inline @export("ct_fix_mul_wide_u32")
fun fixMulWideU32(a: u32, b: u32): u64 = (secretU32(a).widen() * secretU32(b).widen()).declassify()

@inline @export("ct_fix_equals")
trusted fun fixEquals(left: int, right: int, count: int): u8 = ctDifferenceAddress(left, right, count).declassify()

// What abla/crypto builds on these: a secret in memory behind each address.
@inline @export("ct_fix_aes_encrypt")
trusted fun fixAesEncrypt(q: int, keys: int, rounds: int): void = aesSoftEncryptBody(q, keys, rounds)

@inline @export("ct_fix_aes_decrypt")
trusted fun fixAesDecrypt(q: int, keys: int, rounds: int): void = aesSoftDecryptBody(q, keys, rounds)

@inline @export("ct_fix_aes_padding")
trusted fun fixAesPadding(address: int): u32 = aesPaddingBad(address).declassify()

@inline @export("ct_fix_rsa_pkcs1")
trusted fun fixRsaPkcs1(address: int, size: int): u32 = rsaPkcs1Delimiter(address, size).declassify()

@inline @export("ct_fix_rsa_oaep")
trusted fun fixRsaOaep(block: int, size: int, expected: int, hashSize: int): u32 =
    rsaOaepDelimiter(block, size, expected, hashSize, u8(ablaUnsafeLoadU8(bnPointer(expected)))).declassify()

@inline @export("ct_fix_ghash")
trusted fun fixGhash(y: int, h: int): void = ghashSoftMultiplyBody(y, h)

@inline @export("ct_fix_montgomery")
trusted fun fixMontgomery(out: int, a: int, b: int, modulus: int, words: int): void =
    bnMontgomeryMultiplyBody(out, a, b, modulus, modulus + words * 4, words, modulus + words * 8)

@inline @export("ct_fix_lookup")
trusted fun fixLookup(index: u32, out: int, table: int, count: int, words: int): void =
    bnLookupBody(out, table, count, words, secretU32(index))

@inline @export("ct_fix_add_multiple")
trusted fun fixAddMultiple(multiplier: u32, out: int, a: int, words: int): void =
    bnAddMultipleBody(out, a, words, secretU32(multiplier))

@inline @export("ct_fix_base64")
fun fixBase64(c: u32): u32 = (ctBase64Value(secretU32(c)) | ctBase64Valid(secretU32(c))).declassify()

// A store that can't be speculated, under a test of the secret.
@inline @export("ct_leak_branch")
trusted fun leakBranch(secret: u32, address: int): void {
    if (secret != u32(0)) ablaUnsafeStoreU8(nativePointerFromAddress(address), 1)
}

// A table lookup at a secret index.
@inline @export("ct_leak_index")
trusted fun leakIndex(secret: u32, address: int): int =
    ablaUnsafeLoadU8(nativePointerFromAddress(address + int(secret & u32(255))))

// memcmp with an early exit, over secret memory.
@inline @export("ct_leak_compare")
trusted fun leakCompare(left: int, right: int, count: int): int {
    var at = 0
    while (at < count) {
        if (ablaUnsafeLoadU8(nativePointerFromAddress(left + at)) !=
            ablaUnsafeLoadU8(nativePointerFromAddress(right + at))) return 1
        at = at + 1
    }
    0
}

@inline @export("ct_leak_divide")
fun leakDivide(a: u32, b: u32): u32 = (a / b) + (a % b)
