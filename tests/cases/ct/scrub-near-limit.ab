// ctScrubStack8192 called with less than 8 KiB of stack left under it (tools/test-ct.sh runs it in a thread, whose stack
// has a guard page under it): the wipe must stop at the end of the stack, not fault on the guard, and must still zero
// what lies between the end of the stack and itself. The thread finds its stack's lowest address in /proc/self/maps (the
// mapping that holds its stack pointer starts right above the guard), goes down by recursion until about 6 KiB are left,
// fills that space with a marker, wipes, and checks that the space is zero. Exit 0 if so; 1 or 2 for a setup that
// went wrong, 3 for a marker left; a fault (the wipe crossed the guard) ends it with a signal. The stack pointer is read
// by inline assembly; the AArch64 run replaces the template (tools/test-ct.sh).
import "abla/ct/scrub"
import "abla/fs"
import "abla/io"
import "abla/text"
import "abla/unsafe/memory/raw"

trusted noescape extern:"inline-assembly" fun stackPointer(template: string, constraints: string): int

trusted fun sp(): int = stackPointer("movq %rsp, $0", "=r")

// The value of the hexadecimal digits `text`, -1 if one is not a digit.
fun hex(text: string): int {
    var value = 0
    for (at in 0 until text.size) {
        val c = text[at]
        val digit = if (c >= 48 && c <= 57) c - 48 else if (c >= 97 && c <= 102) c - 87 else -1
        if (digit < 0) return -1
        value = value * 16 + digit
    }
    value
}

// The start of the mapping that holds `address`, from /proc/self/maps; 0 if none does.
fun mappingStart(address: int): int {
    for (line in path("/proc/self/maps").readText().split("\n")) {
        val dash = line.indexOf("-")
        val space = line.indexOf(" ")
        if (dash > 0 && space > dash) {
            val start = hex(line.slice(0, dash))
            val end = hex(line.slice(dash + 1, space))
            if (start >= 0 && start <= address && address < end) return start
        }
    }
    0
}

val room = 6144

@noinline trusted fun fill(from: int, to: int): void {
    var at = from
    while (at < to) {
        ablaUnsafeStoreU8(nativePointerFromAddress(at), 165)
        at = at + 1
    }
}

// Whether [from, to) is all zero.
@noinline trusted fun zero(from: int, to: int): bool {
    var at = from
    while (at < to) {
        if (ablaUnsafeLoadU8(nativePointerFromAddress(at)) != 0) return false
        at = at + 1
    }
    true
}

@noinline fun wipe(): void {
    ctScrubStack8192()
    return
}

// Recurse until less than `room` bytes are left above `low`, then mark that space and wipe it: 0 if it is zero after,
// 2 if the recursion overshot, 3 if a marker byte is left. The marker stops 512 bytes under sp, clear of the frames of
// fill, wipe and the scrub's own call.
@noinline fun descend(low: int): int {
    val here = sp()
    if (here - low > room) {
        // Not a tail call: the frame stays, and `here` is read after it.
        val status = descend(low)
        return if (here == 0) -1 else status
    }
    if (here - low < 4608) return 2
    fill(low, here - 512)
    wipe()
    if (zero(low, here - 512)) 0 else 3
}

fun worker(): int {
    val low = mappingStart(sp())
    if (low == 0) return 1
    val status = descend(low)
    if (status == 0) println("scrub near the limit: wiped down to the stack's end with ${room} bytes or less left")
    status
}

fun main: int {
    val running = thread { worker() }
    val status = await running
    if (status != 0) println("scrub near the limit: check $status")
    status
}
