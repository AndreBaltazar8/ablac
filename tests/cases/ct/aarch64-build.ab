// Builds the checks and fixtures as an AArch64 Linux object (see ../simd/aarch64-build.ab).
import "abla/build"
import "abla/compiler"

#compilerGrant("filesystem.write")

compile fun ctAarch64Object(): bool {
    val target = defineTarget("linux-arm64-object", "aarch64-unknown-linux-gnu", "elf", "none", "none", false, false)
    target && buildProgram(
        "ct-aarch64", "tests/cases/ct/object.ab", "build/ct/aarch64.o", "linux-arm64-object",
        "object", false, false
    )
}

// The same program built --fast: every Abla call stays a call, which the checker follows.
compile fun ctAarch64FastObject(): bool = buildProgram(
    "ct-aarch64-fast", "tests/cases/ct/object.ab", "build/ct/aarch64-fast.o", "linux-arm64-object",
    "object", true, false
)

// The residue entries (tools/test-ct.sh writes them to build/ct/residue-cases): release, so each worker stays a call.
compile fun ctAarch64ResidueObject(): bool = buildProgram(
    "ct-aarch64-residue", "build/ct/residue-cases/object.ab", "build/ct/aarch64-residue.o", "linux-arm64-object",
    "object", false, false
)

val built = #ctAarch64Object()
val builtResidue = #ctAarch64ResidueObject()
val builtFast = #ctAarch64FastObject()

fun main: int = if (built && builtFast && builtResidue) 0 else 1
