// What abla/ct's operations compute. 0 if they agree with the values here, or the first check's number.
import "abla/ct"
import "abla/ct/scrub"

var ctCheckAt = 0
var ctFailure = 0

fun ctExpect(ok: bool): void {
    ctCheckAt = ctCheckAt + 1
    if (ctFailure == 0 && !ok) ctFailure = ctCheckAt
}

fun ctChecks(): int {
    val ones32 = u32(4294967295)
    val edges32: array<u32> = [u32(0), u32(1), u32(2), u32(2147483647), u32(2147483648), ones32]
    for (a in edges32) {
        for (b in edges32) {
            val x = secretU32(a)
            val y = secretU32(b)
            ctExpect(ctEq(x, y).declassify() == (if (a == b) ones32 else u32(0)))
            ctExpect(ctLt(x, y).declassify() == (if (a < b) ones32 else u32(0)))
            ctExpect(ctSelect(ctLt(x, y), x, y).declassify() == (if (a < b) a else b))
            ctExpect((x + y).declassify() == a + b)
            ctExpect((x - y).declassify() == a - b)
            ctExpect((x * y).declassify() == a * b)
            ctExpect((x ^ y).declassify() == (a ^ b))
            ctExpect((x & y).declassify() == (a & b))
            ctExpect((x | y).declassify() == (a | b))
            ctExpect((~x).declassify() == ~a)
            ctExpect((x << 5).declassify() == a << 5)
            ctExpect((x >> 5).declassify() == a >> 5)
            ctExpect(x.rotl(9).declassify() == ((a << 9) | (a >> 23)))
            ctExpect(x.rotr(9).declassify() == ((a >> 9) | (a << 23)))
            ctExpect(x.rotl(0).declassify() == a)
            ctExpect((x.widen() * y.widen()).declassify() == u64(a) * u64(b))
            ctExpect((x.widen() * y.widen()).high().declassify() == u32((u64(a) * u64(b)) >> 32))
        }
        val x = secretU32(a)
        ctExpect(ctIsZero(x).declassify() == (if (a == u32(0)) ones32 else u32(0)))
        ctExpect(ctIsNonZero(x).declassify() == (if (a != u32(0)) ones32 else u32(0)))
        ctExpect(ctFromLowBit(x).declassify() == (if ((a & u32(1)) == u32(1)) ones32 else u32(0)))
    }
    val edges64: array<u64> = [u64(0), u64(1), u64(-1), u64(4294967296), u64(-9223372036854775807 - 1), u64(9223372036854775807)]
    for (a in edges64) {
        for (b in edges64) {
            val x = secretU64(a)
            val y = secretU64(b)
            ctExpect(ctEq(x, y).declassify() == (if (a == b) u64(-1) else u64(0)))
            ctExpect(ctLt(x, y).declassify() == (if (a < b) u64(-1) else u64(0)))
            ctExpect(ctSelect(ctLt(x, y), x, y).declassify() == (if (a < b) a else b))
            ctExpect((x + y).declassify() == a + b)
            ctExpect((x - y).declassify() == a - b)
            ctExpect((x * y).declassify() == a * b)
            ctExpect(x.low().declassify() == u32(a))
            ctExpect(x.high().declassify() == u32(a >> 32))
        }
    }
    for (a in edges64) ctExpect(ctIsZero(secretU64(a)).declassify() == (if (a == u64(0)) u64(-1) else u64(0)))
    for (a in 0 until 256) {
        for (b in [0, 1, 127, 128, 255]) {
            val x = secretU8(u8(a))
            val y = secretU8(u8(b))
            ctExpect(ctEq(x, y).declassify() == (if (a == b) u8(255) else u8(0)))
            ctExpect(ctLt(x, y).declassify() == (if (a < b) u8(255) else u8(0)))
            ctExpect(ctSelect(ctLt(x, y), x, y).declassify() == u8(if (a < b) a else b))
        }
    }
    ctExpect(ctEquals("", ""))
    ctExpect(ctEquals("secret", "secret"))
    ctExpect(!ctEquals("secret", "secreT"))
    ctExpect(!ctEquals("Secret", "secret"))
    ctExpect(!ctEquals("secret", "secret2"))
    // A secret keeps its value through what holds it boxed.
    val list: array<secretU32> = [secretU32(7)]
    list.append(secretU32(9))
    ctExpect((list[0] + list[1]).declassify() == u32(16))
    // Wiping the stack below leaves what is live alone (and does nothing where there is no native stack to wipe).
    val kept = secretU32(11)
    ctScrubStack512()
    ctScrubStack1024()
    ctScrubStack2048()
    ctExpect((kept + secretU32(1)).declassify() == u32(12))
    ctFailure
}
