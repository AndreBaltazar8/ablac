// What allocates through the crypto allocation entry, for tools/test-ct.sh (alloc_entry_read): a function of each crypto
// module that calls it, exported so the object keeps it. The check is that each export still calls the entry out of
// line (a function in the section .text.abla_ct_allocate): if it were inlined the call, and with it the point where
// the checker takes the result for a header-public pointer, would be gone.
import "abla/crypto/aes"
import "abla/crypto/bignum"

@export("probe_bignum_allocate") trusted fun probeBignumAllocate(words: int): int =
    bnAllocate(words)

@export("probe_aes_expand") trusted fun probeAesExpand(count: int): int {
    val key = aesExpand("0123456789abcdef", false)
    key.rounds + count
}

fun main: int = 0
