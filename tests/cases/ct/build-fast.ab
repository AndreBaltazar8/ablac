import "abla/build"
import "abla/wasm/build"

// The checks and fixtures as a --fast WebAssembly module: every Abla call stays a call, which the checker follows.
// (The target is registered by the release build in build.ab, so this one only builds.)
val builtFast = #wasmBuildModule("ct-fast", "tests/cases/ct/wasm.ab", "build/ct/ct-fast.wasm", true,
    false)

fun main: int = if (builtFast) 0 else 1
