// glibc's fortified entry points in the statically linked compiler's C library (src/static_libc/fortify.ab, #1139 area 14): LLVM and libstdc++ were
// built with _FORTIFY_SOURCE and pass the size of the destination object when the compiler knew it. With no argument this program makes calls that fit
// (and ones whose object size is unknown, SIZE_MAX) and exits 42; with `memcpy`, `memset`, `snprintf` or `realpath` it makes one that does not, which
// must end the process by SIGABRT after "*** buffer overflow detected ***: terminated" (they used to drop the size and overflow). Checked by
// tools/test-libc-functions.sh.
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/process/arguments"
import "../../../src/static_libc/fortify.ab"

// Raw memory, never freed: a NativeByteBuffer would be freed when the function returns, under the caller.
trusted fun cString(text: string): int {
    val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(text.size + 1))
    for (i in 0 until text.size) ablaUnsafeStoreU8(nativePointerFromAddress(address + i), text[i])
    ablaUnsafeStoreU8(nativePointerFromAddress(address + text.size), 0)
    address
}

trusted fun main: int {
    val target = ablaUnsafePointerAddress(ablaUnsafeAllocate(64))
    val source = cString("0123456789abcdef0123456789abcdef")
    val format = cString("hello")
    val mode = if (processArgumentCount() > 0) processArgument(0) else ""
    if (mode == "memcpy") libcMemcpyChk(target, source, 33, 32)
    else if (mode == "memset") libcMemsetChk(target, 0, 65, 64)
    else if (mode == "snprintf") libcVsnprintfChk(target, 64, 1, 16, format, 0)
    else if (mode == "realpath") libcRealpathChk(cString("/"), target, 64)
    else {
        libcMemcpyChk(target, source, 32, 32)
        libcMemcpyChk(target, source, 32, -1)
        libcMemsetChk(target, 0, 64, 64)
        if (libcVsnprintfChk(target, 16, 1, 16, format, 0) != 5) return 1
        if (libcVsnprintfChk(target, 16, 1, -1, format, 0) != 5) return 2
        return 42
    }
    3
}
