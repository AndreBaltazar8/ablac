class Counter(var calls: int)

fun Counter.rhs(answer: bool): bool {
    this.calls += 1
    answer
}

fun exercise(): int {
    val counter = Counter(0)
    var off = false
    var on = true
    off &&= counter.rhs(true)
    on ||= counter.rhs(false)
    if (off || !on || counter.calls != 0) return 1
    val changed = on &&= counter.rhs(false)
    if (on || changed || counter.calls != 1) return 2
    off ||= counter.rhs(true)
    if (!off || counter.calls != 2) return 3
    0
}

val compiled = #exercise()
fun main(): int = if (compiled == 0) exercise() else 4
