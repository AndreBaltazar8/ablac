class Switch(var enabled: bool)

fun Switch.keep(): bool = enabled &&= true
class State(var target: Switch, var visits: int, var order: int)

fun State.receiver(): Switch {
    this.visits += 1
    this.order = 1
    val created = Switch(true)
    this.target = created
    created
}

fun State.rhs(): bool {
    if (this.order != 1) return false
    this.order = 2
    // The write must use the value of the field read before this call.
    this.target.enabled = false
    true
}

fun exercise(): int {
    val state = State(Switch(true), 0, 0)
    state.receiver().enabled &&= state.rhs()
    if (!state.target.enabled || state.visits != 1 || state.order != 2) return 1
    state.receiver().enabled ||= state.rhs()
    if (!state.target.enabled || state.visits != 2 || state.order != 1) return 2
    val retained = Switch(true)
    if (!retained.keep() || !retained.enabled) return 4
    0
}

val compiled = #exercise()
fun main(): int = if (compiled == 0) exercise() else 3
