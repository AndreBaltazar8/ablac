import "abla/io"
import "abla/memory"
import "abla/process"

// Garbage made in main's own loop, by runtime helpers only (string building): the
// loop's back edge is its only safe point. The peak of the tracked heap stays near
// one collection step instead of growing with the rounds, and the kept strings
// survive every collection. With an argument, fewer rounds and a tighter bound
// (for ABLA_GC_STRESS=1, which collects at every safe point).
fun main: int {
    val short = processArgument(0) == "short"
    val rounds = if (short) 100000 else 3000000
    val bound = if (short) 2097152 else 104857600
    val kept: array<string> = []
    for (index in 0 until 1000) kept.append("kept-$index")
    var peak = 0
    var total = 0
    for (round in 0 until rounds) {
        val text = "garbage-$round-${kept[round % 1000]}-padding-to-make-it-longer"
        total = total + text.size
        val live = memoryLiveBytes()
        if (live > peak) peak = live
    }
    var check = 0
    for (text in kept) check = check + text.size
    println("total $total kept $check bounded ${peak < bound}")
    0
}
