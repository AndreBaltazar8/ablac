// Buffer arrays (#1299, `KernelBuffers<B, N>`): a kernel taking three input and three output buffers, read under `@unroll`
// (each get folds to its buffer) and by a runtime index (a choice among the three), the same on both backends.
import "abla/kernel"
import "abla/float"

/** ys[s][i] = xs[s][i] * (s + 2) for the first `streams` of three streams. */
@kernel
fun scaleStreams(xs: KernelBuffers<KernelF32Buffer, 3>, ys: KernelBuffers<KernelF32Buffer, 3>, streams: int, n: int) {
    val i = kernelGlobalId()
    if (i < n) {
        @unroll
        for (s in 0 until 3) {
            if (s < streams) ys.get(s).store(i, xs.get(s).load(i) * f32FromInt(s + 2))
        }
    }
}

/** out[i] = xs[i % 3][i] + xs[2][i]: a runtime index and a literal one. */
@kernel
fun pickStream(xs: KernelBuffers<KernelF32Buffer, 3>, out: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) out.store(i, xs.get(i % 3).load(i) + xs.get(2).load(i))
}
