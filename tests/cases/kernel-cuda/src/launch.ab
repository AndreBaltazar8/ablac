// @launchBounds and dynamic shared memory (#1303): `bounded` declares at most 128 threads per group and 2 groups per
// multiprocessor (its PTX has .maxntid and .minnctapersm, and a launch of 256 threads is refused); `reverseChunks` reverses
// each group's chunk of x through dynamic shared memory sized at launch, the same on both backends.
import "abla/kernel"

/** x[i] += 1 for every thread i below n. */
@kernel
@launchBounds(128, 2)
fun bounded(x: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) x.store(i, x.load(i) + f32(1.0))
}

/** out's chunk g (as long as the dynamic shared memory) = x's chunk g reversed, through the shared memory. */
@kernel
fun reverseChunks(x: KernelF32Buffer, out: KernelF32Buffer) {
    val shared = kernelSharedF32Dynamic()
    val length = shared.size()
    val base = kernelGroupId() * length
    var k = kernelLocalId()
    while (k < length) {
        shared.store(k, x.load(base + k))
        k = k + kernelGroupSize()
    }
    kernelBarrier()
    k = kernelLocalId()
    while (k < length) {
        out.store(base + k, shared.load(length - 1 - k))
        k = k + kernelGroupSize()
    }
}
