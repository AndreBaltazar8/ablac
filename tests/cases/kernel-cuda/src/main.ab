// The same `@kernel` functions on the CPU backend (kernelRunCpu) and on CUDA (abla/kernel/cuda, the PTX the compiler built):
// vadd gives the same floats on both; the NVFP4 matvec (abla-grad's) agrees within 1e-5 of its largest output (the GPU's fma
// rounds once, the CPU's twice), and the rows past `rows` stay untouched on both. Without a CUDA driver or GPU it says so
// and passes. The half-precision conversions (halfgpu.ab) make the module sm_89 (Ada) for its FP8 conversions.
import "vadd.ab"
import "nvfp4.ab"
import "edges.ab"
import "rmsnorm.ab"
import "q8.ab"
import "exp.ab"
import "pick4.ab"
import "quad.ab"
import "words.ab"
import "subgroups.ab"
import "arrays.ab"
import "launch.ab"
import "intrinsics.ab"
import "groups.ab"
import "q8fast.ab"
import "guards.ab"
import "probe.ab"
import "halfgpu.ab"
import "tanh.ab"
import "abla/kernel"
import "abla/kernel/cuda"
import "abla/float"
import "abla/io"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

/** Stores the low 32 bits of `value` little endian at byte `offset` of `buffer`. */
fun storeWord(var buffer: NativeByteBuffer, offset: int, value: int): void {
    for (k in 0 until 4) buffer.store(offset + k, (value >> (k * 8)) & 255)
}

/** A buffer of `count` f32 values, value(i) each. */
fun floats(count: int, value: (int) -> f32): NativeByteBuffer {
    val buffer = nativeByteBuffer(count * 4)
    for (index in 0 until count) storeWord(buffer, index * 4, int(f32ToBits(value(index))))
    buffer
}

/** Element `index` of a buffer of f32 values. */
trusted fun floatAt(buffer: NativeByteBuffer, index: int): f32 =
    KernelF32Buffer(nativePointerAddress(buffer.address), buffer.capacity / 4).load(index)

/** NVFP4 weights for `rows` x `cols` (GGML blocks of 36 bytes), pseudo-random, with zero and subnormal scales. */
fun nvfp4Weights(rows: int, cols: int): NativeByteBuffer {
    val words = rows * cols / 64 * 9
    val buffer = nativeByteBuffer(words * 4)
    var seed = 12345
    for (index in 0 until words) {
        seed = (seed * 1103515245 + 12345) & 2147483647
        var word = seed & 4294967295
        if (index % 9 == 0) {
            word = 0
            for (s in 0 until 4) {
                seed = (seed * 1103515245 + 12345) & 2147483647
                var code = ((1 + seed % 9) << 3) | (seed >> 8 & 7)
                if (seed % 17 == 0) code = seed >> 4 & 7
                if (seed % 23 == 0) code = 127
                word = word | (code << (s * 8))
            }
        }
        storeWord(buffer, index * 4, word)
    }
    buffer
}

trusted fun main: int {
    var device = cudaKernelDevice()
    if (!device.ready()) {
        println("kernel-cuda: skipped (${device.error})")
        return 0
    }
    // vadd on both backends.
    val n = 100000
    val a = floats(n) { i -> f32FromInt(i) * f32(0.5) }
    val b = floats(n) { i -> f32FromInt(1000 - i) }
    val cpu = floats(n) { i -> f32(0.0) }
    val cpuOut = KernelF32Buffer(nativePointerAddress(cpu.address), n)
    val cpuA = KernelF32Buffer(nativePointerAddress(a.address), n)
    val cpuB = KernelF32Buffer(nativePointerAddress(b.address), n)
    kernelRunCpu((n + 255) / 256, 256) { vadd(cpuA, cpuB, cpuOut, n) }
    val da = device.allocate(n * 4)
    val db = device.allocate(n * 4)
    val dc = device.allocate(n * 4)
    if (da == null || db == null || dc == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpu = floats(n) { i -> f32(0.0) }
    if (!device.upload(da, a) || !device.upload(db, b) ||
        !device.launch("vadd", (n + 255) / 256, 256, cudaKernelArguments().buffer(da.floats()).buffer(db.floats())
            .buffer(dc.floats()).integer(n)) || !device.download(dc, gpu)) {
        println("kernel-cuda: vadd: ${device.error}")
        return 1
    }
    var vaddEqual = true
    for (i in 0 until n) if (floatAt(gpu, i) != floatAt(cpu, i)) vaddEqual = false
    println("vadd: $n elements, GPU equal to CPU $vaddEqual")

    // pick4 (an `if` choosing between two load4 results) over vadd's inputs: the same floats on both backends.
    val quads = n / 4
    val cpuPick = floats(quads) { i -> f32(0.0) }
    val cpuPickBuffer = KernelF32Buffer(nativePointerAddress(cpuPick.address), quads)
    kernelRunCpu((quads + 255) / 256, 256) { pick4(cpuA, cpuB, cpuPickBuffer, quads) }
    val dp = device.allocate(quads * 4)
    if (dp == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuPick = floats(quads) { i -> f32(0.0) }
    if (!device.launch("pick4", (quads + 255) / 256, 256, cudaKernelArguments().buffer(da.floats()).buffer(db.floats())
        .buffer(dp.floats()).integer(quads)) || !device.download(dp, gpuPick)) {
        println("kernel-cuda: pick4: ${device.error}")
        return 1
    }
    var pickEqual = floatAt(cpuPick, 1) != floatAt(cpuPick, 0)
    for (i in 0 until quads) if (floatAt(gpuPick, i) != floatAt(cpuPick, i)) pickEqual = false
    println("pick4: $quads quads chosen by an if, GPU equal to CPU $pickEqual")

    // quad4: f32x4 values the kernel builds (#1298), as parameters, results and a var set in both branches. Small
    // integers and halves, so every sum is exact on both backends.
    val quadCount = 4096
    val qx = floats(quadCount * 4 + 4) { i -> f32FromInt((i * 7) % 13 - 6) * f32(0.5) }
    val qw = floats(quadCount * 4) { i -> f32FromInt(i % 5 - 2) }
    val cpuQuad = floats(quadCount) { i -> f32(0.0) }
    val cpuQx = KernelF32Buffer(nativePointerAddress(qx.address), quadCount * 4 + 4)
    val cpuQw = KernelF32Buffer(nativePointerAddress(qw.address), quadCount * 4)
    val cpuQo = KernelF32Buffer(nativePointerAddress(cpuQuad.address), quadCount)
    kernelRunCpu((quadCount + 255) / 256, 256) { quad4(cpuQx, cpuQw, cpuQo, quadCount) }
    val dquadX = device.allocate((quadCount * 4 + 4) * 4)
    val dquadW = device.allocate(quadCount * 4 * 4)
    val dquadOut = device.allocate(quadCount * 4)
    if (dquadX == null || dquadW == null || dquadOut == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuQuad = floats(quadCount) { i -> f32(0.0) }
    if (!device.upload(dquadX, qx) || !device.upload(dquadW, qw) ||
        !device.launch("quad4", (quadCount + 255) / 256, 256, cudaKernelArguments().buffer(dquadX.floats())
            .buffer(dquadW.floats()).buffer(dquadOut.floats()).integer(quadCount)) || !device.download(dquadOut, gpuQuad)) {
        println("kernel-cuda: quad4: ${device.error}")
        return 1
    }
    var quadEqual = true
    var quadNonzero = 0
    for (i in 0 until quadCount) {
        if (int(f32ToBits(floatAt(gpuQuad, i))) != int(f32ToBits(floatAt(cpuQuad, i)))) quadEqual = false
        if (floatAt(cpuQuad, i) != f32(0.0)) quadNonzero = quadNonzero + 1
    }
    println("quad4: $quadCount built f32x4 dots, GPU bits equal to CPU ${quadEqual && quadNonzero > quadCount / 2}")

    // words4 (#1301): u32x4 loads and stores and signed bytes, at word offsets 0 (one 16-byte access on the GPU) and 1
    // (four), the last thread's reads and store partly past the buffers' ends; words4Aligned, the trusted one-load forms,
    // gives the checked kernel's words wherever it runs.
    val wordThreads = 1000
    val srcCount = wordThreads * 4 + 1
    val byteCount = wordThreads * 16 - 3
    val dstCount = wordThreads * 4 - 2
    val srcData = nativeByteBuffer(srcCount * 4)
    for (k in 0 until srcCount) storeWord(srcData, k * 4, (k * 2654435761 + 12345) & 0xffffffff)
    val byteData = nativeByteBuffer(byteCount)
    for (k in 0 until byteCount) byteData.store(k, (k * 151 + k / 7) & 255)
    val cpuSrc = KernelU32Buffer(nativePointerAddress(srcData.address), srcCount)
    val cpuBytes = KernelU8Buffer(nativePointerAddress(byteData.address), byteCount)
    val dsrc = device.allocate(srcCount * 4)
    val dbytes = device.allocate(byteCount)
    val ddst = device.allocate(dstCount * 4)
    val dsums = device.allocate(wordThreads * 4)
    if (dsrc == null || dbytes == null || ddst == null || dsums == null) { println("kernel-cuda: ${device.error}"); return 1 }
    if (!device.upload(dsrc, srcData) || !device.upload(dbytes, byteData)) { println("kernel-cuda: ${device.error}"); return 1 }
    var wordsEqual = true
    var negativeSums = 0
    val checkedOffsetZero = nativeByteBuffer(dstCount * 4)
    for (offset in [0, 1]) {
        val cpuDst = nativeByteBuffer(dstCount * 4)
        val cpuSums = nativeByteBuffer(wordThreads * 4)
        for (k in 0 until dstCount) storeWord(cpuDst, k * 4, 0x55555555)
        for (k in 0 until wordThreads) storeWord(cpuSums, k * 4, 0x55555555)
        val gpuDst = nativeByteBuffer(dstCount * 4)
        val gpuSums = nativeByteBuffer(wordThreads * 4)
        val cpuDstBuffer = KernelU32Buffer(nativePointerAddress(cpuDst.address), dstCount)
        val cpuSumsBuffer = KernelU32Buffer(nativePointerAddress(cpuSums.address), wordThreads)
        kernelRunCpu((wordThreads + 255) / 256, 256) { words4(cpuSrc, cpuBytes, cpuDstBuffer, cpuSumsBuffer, wordThreads, offset) }
        if (!device.upload(ddst, cpuDst) || !device.upload(dsums, cpuSums)) { println("kernel-cuda: ${device.error}"); return 1 }
        if (!device.launch("words4", (wordThreads + 255) / 256, 256, cudaKernelArguments().buffer(dsrc.words()).buffer(dbytes.raw())
            .buffer(ddst.words()).buffer(dsums.words()).integer(wordThreads).integer(offset)) ||
            !device.download(ddst, gpuDst) || !device.download(dsums, gpuSums)) {
            println("kernel-cuda: words4: ${device.error}")
            return 1
        }
        val gpuDstBuffer = KernelU32Buffer(nativePointerAddress(gpuDst.address), dstCount)
        val gpuSumsBuffer = KernelU32Buffer(nativePointerAddress(gpuSums.address), wordThreads)
        for (k in 0 until dstCount) if (gpuDstBuffer.load(k) != cpuDstBuffer.load(k)) wordsEqual = false
        for (k in 0 until wordThreads) {
            if (gpuSumsBuffer.load(k) != cpuSumsBuffer.load(k)) wordsEqual = false
            if (cpuSumsBuffer.load(k) >= 0x80000000) negativeSums = negativeSums + 1
        }
        // The last store is partly outside dst: its first two words are written, the last thread's loads read zeros there.
        if (cpuDstBuffer.load(dstCount - 1) == 0x55555555) wordsEqual = false
        if (offset == 0) for (k in 0 until dstCount) storeWord(checkedOffsetZero, k * 4, cpuDstBuffer.load(k))
    }
    val alignedDst = nativeByteBuffer(dstCount * 4)
    for (k in 0 until dstCount) storeWord(alignedDst, k * 4, 0x55555555)
    if (!device.upload(ddst, alignedDst) || !device.launch("words4Aligned", (wordThreads + 255) / 256, 256,
        cudaKernelArguments().buffer(dsrc.words()).buffer(dbytes.raw()).buffer(ddst.words()).integer(wordThreads)) ||
        !device.download(ddst, alignedDst)) {
        println("kernel-cuda: words4Aligned: ${device.error}")
        return 1
    }
    val alignedBuffer = KernelU32Buffer(nativePointerAddress(alignedDst.address), dstCount)
    val checkedBuffer = KernelU32Buffer(nativePointerAddress(checkedOffsetZero.address), dstCount)
    // Every thread but the last (whose bytes run past the end) takes the one-load path on device memory, which is aligned.
    for (k in 0 until (wordThreads - 1) * 4) if (alignedBuffer.load(k) != checkedBuffer.load(k)) wordsEqual = false
    println("words4: $wordThreads u32x4 quads, byte quads and signed-byte sums at offsets 0 and 1, and the aligned forms, GPU equal to CPU ${wordsEqual && negativeSums > 0}")

    // pairs2 (#1301's u32x2) over the same words and bytes, 2000 threads: the last one's byte pair and store run past the
    // ends; pairs2Aligned gives the checked kernel's words wherever it runs.
    val pairThreads = 2000
    val pairCount = pairThreads * 2 - 1
    val dpairs = device.allocate(pairCount * 4)
    if (dpairs == null) { println("kernel-cuda: ${device.error}"); return 1 }
    var pairsEqual = true
    val checkedPairs = nativeByteBuffer(pairCount * 4)
    for (offset in [0, 1]) {
        val cpuPairs = nativeByteBuffer(pairCount * 4)
        for (k in 0 until pairCount) storeWord(cpuPairs, k * 4, 0x55555555)
        val cpuPairsBuffer = KernelU32Buffer(nativePointerAddress(cpuPairs.address), pairCount)
        kernelRunCpu((pairThreads + 255) / 256, 256) { pairs2(cpuSrc, cpuBytes, cpuPairsBuffer, pairThreads, offset) }
        val gpuPairs = nativeByteBuffer(pairCount * 4)
        if (!device.upload(dpairs, cpuPairs) || !device.launch("pairs2", (pairThreads + 255) / 256, 256,
            cudaKernelArguments().buffer(dsrc.words()).buffer(dbytes.raw()).buffer(dpairs.words()).integer(pairThreads)
                .integer(offset)) || !device.download(dpairs, gpuPairs)) {
            println("kernel-cuda: pairs2: ${device.error}")
            return 1
        }
        val gpuPairsBuffer = KernelU32Buffer(nativePointerAddress(gpuPairs.address), pairCount)
        for (k in 0 until pairCount) if (gpuPairsBuffer.load(k) != cpuPairsBuffer.load(k)) pairsEqual = false
        if (cpuPairsBuffer.load(pairCount - 1) == 0x55555555) pairsEqual = false
        if (offset == 0) for (k in 0 until pairCount) storeWord(checkedPairs, k * 4, cpuPairsBuffer.load(k))
    }
    val alignedPairs = nativeByteBuffer(pairCount * 4)
    for (k in 0 until pairCount) storeWord(alignedPairs, k * 4, 0x55555555)
    if (!device.upload(dpairs, alignedPairs) || !device.launch("pairs2Aligned", (pairThreads + 255) / 256, 256,
        cudaKernelArguments().buffer(dsrc.words()).buffer(dbytes.raw()).buffer(dpairs.words()).integer(pairThreads)) ||
        !device.download(dpairs, alignedPairs)) {
        println("kernel-cuda: pairs2Aligned: ${device.error}")
        return 1
    }
    val alignedPairsBuffer = KernelU32Buffer(nativePointerAddress(alignedPairs.address), pairCount)
    val checkedPairsBuffer = KernelU32Buffer(nativePointerAddress(checkedPairs.address), pairCount)
    // Every thread but the last (whose bytes run past the end) takes the one-load path on device memory.
    for (k in 0 until (pairThreads - 1) * 2) if (alignedPairsBuffer.load(k) != checkedPairsBuffer.load(k)) pairsEqual = false
    println("pairs2: $pairThreads u32x2 pairs and byte pairs at offsets 0 and 1, and the aligned forms, GPU equal to CPU $pairsEqual")

    // Atomics: countThreads over vadd's 100000 threads, and sumGroups (the last group adds the partials), twice each.
    val words = nativeByteBuffer(4 * 400)
    val counterCpu = KernelU32Buffer(nativePointerAddress(words.address), 1)
    val partialCpu = KernelU32Buffer(nativePointerAddress(words.address) + 4, 391)
    val totalCpu = KernelU32Buffer(nativePointerAddress(words.address) + 4 * 392, 1)
    counterCpu.store(0, 0)
    kernelRunCpu((n + 255) / 256, 256) { countThreads(counterCpu, n) }
    var countRight = counterCpu.load(0) == n
    counterCpu.store(0, 0)
    val sumGroupsCount = 391
    var expected = 0
    for (g in 0 until sumGroupsCount) expected = expected + 7 * g + 1
    for (round in 0 until 2) {
        kernelRunCpu(sumGroupsCount, 1) { sumGroups(partialCpu, counterCpu, totalCpu, sumGroupsCount) }
        if (totalCpu.load(0) != expected || counterCpu.load(0) != 0) countRight = false
    }
    val dcounter = device.allocate(4)
    val dpartial = device.allocate(4 * sumGroupsCount)
    val dtotal = device.allocate(4)
    if (dcounter == null || dpartial == null || dtotal == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val zero = nativeByteBuffer(4)
    KernelU32Buffer(nativePointerAddress(zero.address), 1).store(0, 0)
    val readBack = nativeByteBuffer(4)
    if (!device.upload(dcounter, zero) || !device.launch("countThreads", (n + 255) / 256, 256,
        cudaKernelArguments().buffer(dcounter.words()).integer(n)) || !device.download(dcounter, readBack)) {
        println("kernel-cuda: countThreads: ${device.error}")
        return 1
    }
    if (KernelU32Buffer(nativePointerAddress(readBack.address), 1).load(0) != n) countRight = false
    if (!device.upload(dcounter, zero)) { println("kernel-cuda: ${device.error}"); return 1 }
    for (round in 0 until 2) {
        if (!device.launch("sumGroups", sumGroupsCount, 64, cudaKernelArguments().buffer(dpartial.words()).buffer(dcounter.words())
            .buffer(dtotal.words()).integer(sumGroupsCount)) || !device.download(dtotal, readBack)) {
            println("kernel-cuda: sumGroups: ${device.error}")
            return 1
        }
        if (KernelU32Buffer(nativePointerAddress(readBack.address), 1).load(0) != expected) countRight = false
        if (!device.download(dcounter, readBack) || KernelU32Buffer(nativePointerAddress(readBack.address), 1).load(0) != 0) countRight = false
    }
    println("atomics: $n adds to one word and $sumGroupsCount groups handing partials to the last, twice, on the GPU and the CPU $countRight")

    // Xor shuffles (GPU only: a CPU subgroup is one thread): per subgroup the largest value, ties to the lowest lane, and
    // each lane's partner's 64-bit int.
    val shuffleThreads = 256 * 4
    val shuffleX = floats(shuffleThreads) { i -> f32FromInt((i * 7) % 5) }
    val dsx = device.allocate(shuffleThreads * 4)
    val dbest = device.allocate(shuffleThreads / 32 * 4)
    val dbestLane = device.allocate(shuffleThreads / 32 * 4)
    val dhigh = device.allocate(shuffleThreads * 4)
    val dlow = device.allocate(shuffleThreads * 4)
    if (dsx == null || dbest == null || dbestLane == null || dhigh == null || dlow == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gotBest = nativeByteBuffer(shuffleThreads / 32 * 4)
    val gotLane = nativeByteBuffer(shuffleThreads / 32 * 4)
    val gotHigh = nativeByteBuffer(shuffleThreads * 4)
    val gotLow = nativeByteBuffer(shuffleThreads * 4)
    if (!device.upload(dsx, shuffleX) || !device.launch("shuffleMax", 4, 256, cudaKernelArguments().buffer(dsx.floats())
            .buffer(dbest.floats()).buffer(dbestLane.words()).buffer(dhigh.words()).buffer(dlow.words())) ||
        !device.download(dbest, gotBest) || !device.download(dbestLane, gotLane) || !device.download(dhigh, gotHigh) ||
        !device.download(dlow, gotLow)) {
        println("kernel-cuda: shuffleMax: ${device.error}")
        return 1
    }
    var shuffleRight = true
    val laneWords = KernelU32Buffer(nativePointerAddress(gotLane.address), shuffleThreads / 32)
    val highWords = KernelU32Buffer(nativePointerAddress(gotHigh.address), shuffleThreads)
    val lowWords = KernelU32Buffer(nativePointerAddress(gotLow.address), shuffleThreads)
    for (warp in 0 until shuffleThreads / 32) {
        var wantScore = f32(-1.0)
        var wantLane = 0
        for (lane in 0 until 32) {
            val value = f32FromInt(((warp * 32 + lane) * 7) % 5)
            if (value > wantScore) {
                wantScore = value
                wantLane = lane
            }
        }
        if (floatAt(gotBest, warp) != wantScore || laneWords.load(warp) != wantLane) shuffleRight = false
    }
    for (i in 0 until shuffleThreads) {
        val partnerLane = (i % 32) ^ 1
        if (highWords.load(i) != (partnerLane + 1) * 2 || lowWords.load(i) != partnerLane) shuffleRight = false
    }
    println("shuffle: $shuffleThreads lanes, the subgroup maximum with ties to the lowest lane and 64-bit partners on the GPU $shuffleRight")

    // subgroupOps (#1300): shuffles by lane, up and down, votes, the subgroup barrier and the ballot argmax, against each
    // subgroup's expected values; kernelCountTrailingZeros on the CPU too.
    val opsThreads = 1024
    val opsX = floats(opsThreads) { i -> subgroupInput(i) }
    val opsIds = nativeByteBuffer(opsThreads * 4)
    for (i in 0 until opsThreads) storeWord(opsIds, i * 4, subgroupId(i))
    val dox = device.allocate(opsThreads * 4)
    val doids = device.allocate(opsThreads * 4)
    val doout = device.allocate(opsThreads * 16)
    val dowords = device.allocate(opsThreads * 32)
    if (dox == null || doids == null || doout == null || dowords == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val opsOut = nativeByteBuffer(opsThreads * 16)
    val opsWords = nativeByteBuffer(opsThreads * 32)
    if (!device.upload(dox, opsX) || !device.upload(doids, opsIds) || !device.launch("subgroupOps", opsThreads / 256, 256,
        cudaKernelArguments().buffer(dox.floats()).buffer(doids.words()).buffer(doout.floats()).buffer(dowords.words())) ||
        !device.download(doout, opsOut) || !device.download(dowords, opsWords)) {
        println("kernel-cuda: subgroupOps: ${device.error}")
        return 1
    }
    val outFloats = KernelF32Buffer(nativePointerAddress(opsOut.address), opsThreads * 4)
    val outWords = KernelU32Buffer(nativePointerAddress(opsWords.address), opsThreads * 8)
    var opsRight = kernelCountTrailingZeros(0) == 64 && kernelCountTrailingZeros(8) == 3 &&
        kernelCountTrailingZeros(1 << 40) == 40 && kernelCountTrailingZeros(-4) == 2
    var anyFalse = 0
    var allFalse = 0
    for (i in 0 until opsThreads) {
        val lane = i % 32
        val base = i - lane
        val upFrom = if (lane >= 3) i - 3 else i
        val downFrom = if (lane + 2 < 32) i + 2 else i
        if (outFloats.load(i * 4) != subgroupInput(base) || outFloats.load(i * 4 + 1) != subgroupInput(base + (lane + 5) % 32) ||
            outFloats.load(i * 4 + 2) != subgroupInput(upFrom) || outFloats.load(i * 4 + 3) != subgroupInput(downFrom)) opsRight = false
        val below = if (lane >= 1) i - 1 else i
        if (outWords.load(i * 8) != (subgroupId(below) ^ 0x5a5a5a5a) || outWords.load(i * 8 + 1) != subgroupId(below) ||
            outWords.load(i * 8 + 2) != subgroupId(base + 31)) opsRight = false
        var ballot = 0
        var anyBig = false
        var allSmall = true
        var top = subgroupInput(base)
        var winner = 0
        for (l in 0 until 32) {
            val value = subgroupInput(base + l)
            if (value > f32(0.0)) ballot = ballot | (1 << l)
            if (value > f32(8.0)) anyBig = true
            if (!(value < f32(100.0))) allSmall = false
            if (value > top) {
                top = value
                winner = l
            }
        }
        if (!anyBig) anyFalse = anyFalse + 1
        if (!allSmall) allFalse = allFalse + 1
        if (outWords.load(i * 8 + 3) != ballot || outWords.load(i * 8 + 4) != (if (anyBig) 1 else 0) ||
            outWords.load(i * 8 + 5) != (if (allSmall) 1 else 0) || outWords.load(i * 8 + 6) != winner ||
            outWords.load(i * 8 + 7) != subgroupId(base + winner)) opsRight = false
    }
    // Both answers of each vote occur.
    if (anyFalse == 0 || anyFalse == opsThreads || allFalse == 0 || allFalse == opsThreads) opsRight = false
    println("subgroups: $opsThreads lanes, shuffles by lane, up and down, ballot, any, all, the barrier and the ballot argmax on the GPU $opsRight")

    // arrays4 (#1299): KernelArray in registers, the same bits on both backends (small integers and halves: exact), and
    // no local memory in its PTX.
    val arrayThreads = 1000
    val arrayX = floats(arrayThreads * 4) { i -> f32FromInt((i * 5) % 11 - 5) * f32(0.5) }
    val cpuArrayOut = floats(arrayThreads) { i -> f32(0.0) }
    val cpuArrayX = KernelF32Buffer(nativePointerAddress(arrayX.address), arrayThreads * 4)
    val cpuArrayResult = KernelF32Buffer(nativePointerAddress(cpuArrayOut.address), arrayThreads)
    kernelRunCpu((arrayThreads + 255) / 256, 256) { arrays4(cpuArrayX, cpuArrayResult, arrayThreads) }
    val darrayX = device.allocate(arrayThreads * 16)
    val darrayOut = device.allocate(arrayThreads * 4)
    if (darrayX == null || darrayOut == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuArrayOut = floats(arrayThreads) { i -> f32(0.0) }
    if (!device.upload(darrayX, arrayX) || !device.launch("arrays4", (arrayThreads + 255) / 256, 256,
        cudaKernelArguments().buffer(darrayX.floats()).buffer(darrayOut.floats()).integer(arrayThreads)) ||
        !device.download(darrayOut, gpuArrayOut)) {
        println("kernel-cuda: arrays4: ${device.error}")
        return 1
    }
    var arraysEqual = true
    var arraysNonzero = 0
    for (i in 0 until arrayThreads) {
        if (int(f32ToBits(floatAt(gpuArrayOut, i))) != int(f32ToBits(floatAt(cpuArrayOut, i)))) arraysEqual = false
        if (floatAt(cpuArrayOut, i) != f32(0.0)) arraysNonzero = arraysNonzero + 1
    }
    val ptx = kernelPtx()
    val entry = ptx.indexOf(".entry arrays4(")
    var section = if (entry < 0) "" else ptx.slice(entry, ptx.size)
    val next = section.indexOf(".entry ", 7)
    if (next > 0) section = section.slice(0, next)
    val registers = section != "" && section.indexOf(".local") < 0
    println("arrays: $arrayThreads threads with f32, int and u32 KernelArrays, GPU bits equal to CPU ${arraysEqual && arraysNonzero > arrayThreads / 2}, in registers $registers")
    // launch (#1303): bounded's PTX directives and its refused wide launch; reverseChunks through dynamic shared memory sized
    // at launch (1000 floats, and 15000 = 60000 bytes, past the 48 KiB a kernel gets without asking), GPU equal to CPU.
    val launchPtx = kernelPtx()
    val boundedAt = launchPtx.indexOf(".entry bounded(")
    var boundedSection = if (boundedAt < 0) "" else launchPtx.slice(boundedAt, launchPtx.size)
    val boundedEnd = boundedSection.indexOf("{")
    if (boundedEnd > 0) boundedSection = boundedSection.slice(0, boundedEnd)
    // llc writes `.maxntid 128` (older ones `.maxntid 128, 1, 1`).
    var launchWhy = if (boundedSection.indexOf(".maxntid 128") >= 0 && boundedSection.indexOf(".minnctapersm 2") >= 0) "" else " (no .maxntid 128 and .minnctapersm 2)"
    val dbounded = device.allocate(1024 * 4)
    if (dbounded == null) { println("kernel-cuda: ${device.error}"); return 1 }
    if (!device.launch("bounded", 8, 128, cudaKernelArguments().buffer(dbounded.floats()).integer(1024))) launchWhy = "$launchWhy (bounded: ${device.error})"
    if (device.launch("bounded", 4, 256, cudaKernelArguments().buffer(dbounded.floats()).integer(1024)) ||
        device.error.indexOf("@launchBounds(128)") < 0) launchWhy = "$launchWhy (the wide launch: ${device.error})"
    device.error = ""
    for (length in [1000, 15000]) {
        val groups = 3
        val total = groups * length
        val chunkX = floats(total) { i -> f32FromInt((i * 13) % 1001) }
        val cpuChunks = floats(total) { i -> f32(0.0) }
        val cpuChunkX = KernelF32Buffer(nativePointerAddress(chunkX.address), total)
        val cpuChunkOut = KernelF32Buffer(nativePointerAddress(cpuChunks.address), total)
        kernelRunCpuShared(groups, 1, length * 4) { reverseChunks(cpuChunkX, cpuChunkOut) }
        val dchunkX = device.allocate(total * 4)
        val dchunkOut = device.allocate(total * 4)
        if (dchunkX == null || dchunkOut == null) { println("kernel-cuda: ${device.error}"); return 1 }
        val gpuChunks = floats(total) { i -> f32(0.0) }
        if (!device.upload(dchunkX, chunkX) || !device.launch("reverseChunks", groups, 256,
            cudaKernelArguments().buffer(dchunkX.floats()).buffer(dchunkOut.floats()), 1, length * 4) ||
            !device.download(dchunkOut, gpuChunks)) {
            println("kernel-cuda: reverseChunks: ${device.error}")
            return 1
        }
        var i = 0
        while (i < total && floatAt(gpuChunks, i) == floatAt(cpuChunks, i)) i = i + 1
        if (i < total) launchWhy = "$launchWhy (chunk $length element $i: GPU bits ${f32ToBits(floatAt(gpuChunks, i))}, CPU ${f32ToBits(floatAt(cpuChunks, i))})"
        // The chunk really is reversed: its first element is the source chunk's last.
        if (floatAt(cpuChunks, 0) != floatAt(chunkX, length - 1)) launchWhy = "$launchWhy (chunk $length not reversed)"
    }
    println("launch: @launchBounds in the PTX and a wider launch refused, dynamic shared memory of 4000 and 60000 bytes on the GPU and the CPU ${launchWhy == ""}$launchWhy")

    // intrinsics (#1304): dp4a, prmt and float atomics, the same words on both backends, and worked values on the CPU.
    val intrinsicThreads = 4096
    val wordsA = nativeByteBuffer(intrinsicThreads * 4)
    val wordsB = nativeByteBuffer(intrinsicThreads * 4)
    for (i in 0 until intrinsicThreads) {
        storeWord(wordsA, i * 4, (i * 2246822519 + 3266489917) & 4294967295)
        storeWord(wordsB, i * 4, (i * 3266489917 + 668265263) & 4294967295)
    }
    val intrinsicResults: array<array<int>> = []
    for (gpu in [false, true]) {
        val dots = nativeByteBuffer(intrinsicThreads * 4)
        val perms = nativeByteBuffer(intrinsicThreads * 4)
        val sums = floats(8) { i -> f32(0.0) }
        if (!gpu) {
            val cpuA = KernelU32Buffer(nativePointerAddress(wordsA.address), intrinsicThreads)
            val cpuB = KernelU32Buffer(nativePointerAddress(wordsB.address), intrinsicThreads)
            val cpuDots = KernelU32Buffer(nativePointerAddress(dots.address), intrinsicThreads)
            val cpuPerms = KernelU32Buffer(nativePointerAddress(perms.address), intrinsicThreads)
            val cpuSums = KernelF32Buffer(nativePointerAddress(sums.address), 7)
            kernelRunCpu(intrinsicThreads / 256, 256) { intrinsics(cpuA, cpuB, cpuDots, cpuPerms, cpuSums, intrinsicThreads) }
        } else {
            val da = device.allocate(intrinsicThreads * 4)
            val dbw = device.allocate(intrinsicThreads * 4)
            val ddots = device.allocate(intrinsicThreads * 4)
            val dperms = device.allocate(intrinsicThreads * 4)
            val dsums = device.allocate(7 * 4)
            if (da == null || dbw == null || ddots == null || dperms == null || dsums == null) { println("kernel-cuda: ${device.error}"); return 1 }
            val zeros = floats(7) { i -> f32(0.0) }
            if (!device.upload(da, wordsA) || !device.upload(dbw, wordsB) || !device.upload(dsums, zeros) ||
                !device.launch("intrinsics", intrinsicThreads / 256, 256, cudaKernelArguments().buffer(da.words()).buffer(dbw.words())
                    .buffer(ddots.words()).buffer(dperms.words()).buffer(dsums.floats()).integer(intrinsicThreads)) ||
                !device.download(ddots, dots) || !device.download(dperms, perms) || !device.download(dsums, sums)) {
                println("kernel-cuda: intrinsics: ${device.error}")
                return 1
            }
        }
        val words: array<int> = []
        val dotWords = KernelU32Buffer(nativePointerAddress(dots.address), intrinsicThreads)
        val permWords = KernelU32Buffer(nativePointerAddress(perms.address), intrinsicThreads)
        val sumWords = KernelU32Buffer(nativePointerAddress(sums.address), 7)
        for (i in 0 until intrinsicThreads) {
            words.append(dotWords.load(i))
            words.append(permWords.load(i))
        }
        for (i in 0 until 7) words.append(sumWords.load(i))
        intrinsicResults.append(words)
    }
    var intrinsicsRight = kernelDp4a(0x01ff7f80, 0x02020202, 10) == 8 && kernelBytePerm(0x33221100, 0x77665544, 0x7654) == 0x77665544 &&
        kernelBytePerm(0x33221100, 0x77665544, 0x0123) == 0x00112233
    for (k in 0 until intrinsicResults[0].size) if (intrinsicResults[1][k] != intrinsicResults[0][k]) intrinsicsRight = false
    println("intrinsics: $intrinsicThreads dp4a, prmt and float atomic adds, GPU equal to CPU $intrinsicsRight")

    // NVFP4 matvec: one subgroup per row on the GPU (8 warps per group), one thread per row on the CPU.
    val rows = 1000
    val cols = 512
    val weights = nvfp4Weights(rows, cols)
    val x = floats(cols) { i -> f32FromInt(i % 13 - 6) / f32(4.0) }
    val cpuY = floats(rows + 8) { i -> f32(-7.0) }
    val w = KernelU32Buffer(nativePointerAddress(weights.address), rows * cols / 64 * 9)
    val cpuX = KernelF32Buffer(nativePointerAddress(x.address), cols)
    val yOut = KernelF32Buffer(nativePointerAddress(cpuY.address), rows + 8)
    kernelRunCpu(rows + 8, 1) { matvecNvfp4(w, cpuX, yOut, rows, cols) }
    val dw = device.allocate(weights.capacity)
    val dx = device.allocate(x.capacity)
    val dy = device.allocate((rows + 8) * 4)
    if (dw == null || dx == null || dy == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuY = floats(rows + 8) { i -> f32(-7.0) }
    val groups = (rows + 8 + 7) / 8
    if (!device.upload(dw, weights) || !device.upload(dx, x) || !device.upload(dy, gpuY) ||
        !device.launch("matvecNvfp4", groups, 256, cudaKernelArguments().buffer(dw.words()).buffer(dx.floats())
            .buffer(dy.floats()).integer(rows).integer(cols)) || !device.download(dy, gpuY)) {
        println("kernel-cuda: matvecNvfp4: ${device.error}")
        return 1
    }
    var worst = 0.0
    var largest = 0.0
    for (row in 0 until rows) {
        val got = f32ToF64(floatAt(gpuY, row))
        val want = f32ToF64(floatAt(cpuY, row))
        val difference = if (got > want) got - want else want - got
        if (difference > worst) worst = difference
        val magnitude = if (want < 0.0) -want else want
        if (magnitude > largest) largest = magnitude
    }
    var untouched = true
    for (row in rows until rows + 8) {
        if (floatAt(gpuY, row) != f32(-7.0) || floatAt(cpuY, row) != f32(-7.0)) untouched = false
    }
    val agree = worst <= largest * 0.00001 && largest > 1.0
    println("matvecNvfp4: $rows x $cols, GPU within 1e-5 of CPU $agree, rows past the end untouched $untouched")

    // Buffer edges: `a` and `c` are 64 elements of memory that holds 128 (the rest 5.0, a guard): reading past `a` gives 0,
    // not the guard, and storing past `c` leaves its guard alone, on both backends.
    val m = 64
    val edgeIn = floats(m * 2) { i -> if (i < m) f32FromInt(i) else f32(5.0) }
    val cpuEdge = floats(m * 2) { i -> f32(5.0) }
    val edgeA = KernelF32Buffer(nativePointerAddress(edgeIn.address), m)
    val edgeC = KernelF32Buffer(nativePointerAddress(cpuEdge.address), m)
    kernelRunCpu(1, m) { edges(edgeA, edgeC, m) }
    val de = device.allocate(m * 8)
    val dc2 = device.allocate(m * 8)
    if (de == null || dc2 == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuEdge = floats(m * 2) { i -> f32(5.0) }
    if (!device.upload(de, edgeIn) || !device.upload(dc2, gpuEdge) ||
        !device.launch("edges", 1, m, cudaKernelArguments().buffer(KernelF32Buffer(de.address, m))
            .buffer(KernelF32Buffer(dc2.address, m)).integer(m)) || !device.download(dc2, gpuEdge)) {
        println("kernel-cuda: edges: ${device.error}")
        return 1
    }
    var edgesRight = true
    for (i in 0 until m * 2) {
        val want = if (i < m - 3) f32FromInt(i + 3) else if (i < m) f32(0.0) else f32(5.0)
        if (floatAt(cpuEdge, i) != want || floatAt(gpuEdge, i) != want) edgesRight = false
    }
    println("edges: loads past a buffer give 0 and stores past it do nothing, on the GPU and the CPU $edgesRight")

    // rmsnorm (shared memory and barriers): 3 rows of 259, weighted, groups of 128 threads on the GPU and of 1 on the CPU.
    val normRows = 3
    val normN = 259
    val normX = floats(normRows * normN) { i -> f32FromInt((i * 13) % 41 - 20) / f32(16.0) }
    val normW = floats(normN) { i -> f32FromInt(i % 19 - 9) / f32(16.0) }
    val cpuNorm = floats(normRows * normN) { i -> f32(0.0) }
    val normXBuffer = KernelF32Buffer(nativePointerAddress(normX.address), normRows * normN)
    val normWBuffer = KernelF32Buffer(nativePointerAddress(normW.address), normN)
    val cpuNormBuffer = KernelF32Buffer(nativePointerAddress(cpuNorm.address), normRows * normN)
    val eps = f32(0.00001)
    kernelRunCpu(normRows, 1) { rmsnorm(normXBuffer, normWBuffer, cpuNormBuffer, normN, eps) }
    val dnx = device.allocate(normX.capacity)
    val dnw = device.allocate(normW.capacity)
    val dny = device.allocate(normX.capacity)
    if (dnx == null || dnw == null || dny == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuNorm = floats(normRows * normN) { i -> f32(0.0) }
    if (!device.upload(dnx, normX) || !device.upload(dnw, normW) ||
        !device.launch("rmsnorm", normRows, 128, cudaKernelArguments().buffer(dnx.floats()).buffer(dnw.floats())
            .buffer(dny.floats()).integer(normN).float(eps)) || !device.download(dny, gpuNorm)) {
        println("kernel-cuda: rmsnorm: ${device.error}")
        return 1
    }
    var normWorst = 0.0
    for (i in 0 until normRows * normN) {
        val got = f32ToF64(floatAt(gpuNorm, i))
        val want = f32ToF64(floatAt(cpuNorm, i))
        val difference = if (got > want) got - want else want - got
        if (difference > normWorst) normWorst = difference
    }
    val normAgree = normWorst <= 0.00001
    println("rmsnorm: $normRows x $normN, groups of 128 on the GPU within 1e-5 of the CPU $normAgree")

    // Q8_0 matvec (byte buffer with u16/u32 loads at any alignment, f16 scales, f32x4 loads): 300 rows of 512.
    val q8Rows = 300
    val q8Cols = 512
    val q8Halves = q8Rows * q8Cols / 32 * 17
    val q8Weights = nativeByteBuffer(q8Halves * 2)
    var q8Seed = 777
    for (half in 0 until q8Halves) {
        q8Seed = (q8Seed * 1103515245 + 12345) & 2147483647
        // A scale: an f16 between 2^-8 and 2^-5 (sign either way); else two random signed bytes.
        val value = if (half % 17 == 0) ((q8Seed >> 3) & 32768) | ((7 + q8Seed % 4) << 10) | (q8Seed >> 9 & 1023) else q8Seed & 65535
        q8Weights.store(half * 2, value & 255)
        q8Weights.store(half * 2 + 1, value >> 8)
    }
    val q8X = floats(q8Cols) { i -> f32FromInt(i % 23 - 11) / f32(8.0) }
    val cpuQ8 = floats(q8Rows) { i -> f32(0.0) }
    val q8W = KernelU8Buffer(nativePointerAddress(q8Weights.address), q8Halves * 2)
    val q8XBuffer = KernelF32Buffer(nativePointerAddress(q8X.address), q8Cols)
    val cpuQ8Buffer = KernelF32Buffer(nativePointerAddress(cpuQ8.address), q8Rows)
    kernelRunCpu(q8Rows, 1) { matvecQ8(q8W, q8XBuffer, cpuQ8Buffer, q8Rows, q8Cols) }
    val dqw = device.allocate(q8Weights.capacity)
    val dqx = device.allocate(q8X.capacity)
    val dqy = device.allocate(q8Rows * 4)
    if (dqw == null || dqx == null || dqy == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuQ8 = floats(q8Rows) { i -> f32(0.0) }
    if (!device.upload(dqw, q8Weights) || !device.upload(dqx, q8X) ||
        !device.launch("matvecQ8", (q8Rows + 7) / 8, 256, cudaKernelArguments().buffer(dqw.raw()).buffer(dqx.floats())
            .buffer(dqy.floats()).integer(q8Rows).integer(q8Cols)) || !device.download(dqy, gpuQ8)) {
        println("kernel-cuda: matvecQ8: ${device.error}")
        return 1
    }
    var q8Worst = 0.0
    var q8Largest = 0.0
    for (row in 0 until q8Rows) {
        val got = f32ToF64(floatAt(gpuQ8, row))
        val want = f32ToF64(floatAt(cpuQ8, row))
        val difference = if (got > want) got - want else want - got
        if (difference > q8Worst) q8Worst = difference
        val magnitude = if (want < 0.0) -want else want
        if (magnitude > q8Largest) q8Largest = magnitude
    }
    val q8Agree = q8Worst <= q8Largest * 0.00001 && q8Largest > 0.01
    println("matvecQ8: $q8Rows x $q8Cols, GPU within 1e-5 of CPU $q8Agree")

    // The unchecked fast path: matvecQ8Fast gives matvecQ8's bits on each backend.
    val cpuQ8Fast = floats(q8Rows) { i -> f32(0.0) }
    val cpuQ8FastBuffer = KernelF32Buffer(nativePointerAddress(cpuQ8Fast.address), q8Rows)
    kernelRunCpu(q8Rows, 1) { matvecQ8Fast(q8W, q8XBuffer, cpuQ8FastBuffer, q8Rows, q8Cols) }
    val gpuQ8Fast = floats(q8Rows) { i -> f32(0.0) }
    if (!device.launch("matvecQ8Fast", (q8Rows + 7) / 8, 256, cudaKernelArguments().buffer(dqw.raw()).buffer(dqx.floats())
        .buffer(dqy.floats()).integer(q8Rows).integer(q8Cols)) || !device.download(dqy, gpuQ8Fast)) {
        println("kernel-cuda: matvecQ8Fast: ${device.error}")
        return 1
    }
    var fastSame = true
    for (row in 0 until q8Rows) {
        if (f32ToBits(floatAt(cpuQ8Fast, row)) != f32ToBits(floatAt(cpuQ8, row))) fastSame = false
        if (f32ToBits(floatAt(gpuQ8Fast, row)) != f32ToBits(floatAt(gpuQ8, row))) fastSame = false
    }
    // The same weights seen one byte later: rows at odd addresses, so matvecQ8Fast takes its checked loop (an unchecked
    // 2-byte load there would fault the launch); it still gives matvecQ8's bits on that view.
    val oddWeights = KernelU8Buffer(dqw.raw().address + 1, dqw.raw().count - 1)
    val gpuOdd = floats(q8Rows) { i -> f32(0.0) }
    val gpuOddFast = floats(q8Rows) { i -> f32(0.0) }
    if (!device.launch("matvecQ8", (q8Rows + 7) / 8, 256, cudaKernelArguments().buffer(oddWeights).buffer(dqx.floats())
            .buffer(dqy.floats()).integer(q8Rows).integer(q8Cols)) || !device.download(dqy, gpuOdd) ||
        !device.launch("matvecQ8Fast", (q8Rows + 7) / 8, 256, cudaKernelArguments().buffer(oddWeights).buffer(dqx.floats())
            .buffer(dqy.floats()).integer(q8Rows).integer(q8Cols)) || !device.download(dqy, gpuOddFast)) {
        println("kernel-cuda: matvecQ8Fast at an odd address: ${device.error}")
        return 1
    }
    for (row in 0 until q8Rows) if (f32ToBits(floatAt(gpuOddFast, row)) != f32ToBits(floatAt(gpuOdd, row))) fastSame = false
    println("matvecQ8Fast: unchecked loads give the checked kernel's bits on the GPU and the CPU, and at an odd address $fastSame")

    // kernelExp from -110 to 95 in steps of 1/1024 (past both ends: 0 below about -104, infinity above about 88.7), and
    // -0, the infinities and NaN. exp is never negative, so the distance between the bit patterns counts ulps.
    val sweep = 205 * 1024 + 1
    val expCount = sweep + 4
    val specials = [f32FromBits(u32(2147483648)), f32FromBits(u32(2139095040)), f32FromBits(u32(4286578688)), f32FromBits(u32(2143289344))]
    val expX = floats(expCount) { i -> if (i < sweep) f32FromInt(i - 110 * 1024) / f32(1024.0) else specials[i - sweep] }
    val cpuExp = floats(expCount) { i -> f32(0.0) }
    val expXBuffer = KernelF32Buffer(nativePointerAddress(expX.address), expCount)
    val cpuExpBuffer = KernelF32Buffer(nativePointerAddress(cpuExp.address), expCount)
    kernelRunCpu((expCount + 255) / 256, 256) { expAll(expXBuffer, cpuExpBuffer, expCount) }
    val dex = device.allocate(expX.capacity)
    val dey = device.allocate(expX.capacity)
    if (dex == null || dey == null) { println("kernel-cuda: ${device.error}"); return 1 }
    val gpuExp = floats(expCount) { i -> f32(0.0) }
    if (!device.upload(dex, expX) || !device.launch("expAll", (expCount + 255) / 256, 256,
        cudaKernelArguments().buffer(dex.floats()).buffer(dey.floats()).integer(expCount)) || !device.download(dey, gpuExp)) {
        println("kernel-cuda: expAll: ${device.error}")
        return 1
    }
    var expWorst = 0
    var expNaN = true
    for (i in 0 until expCount) {
        val got = int(f32ToBits(floatAt(gpuExp, i)))
        val want = int(f32ToBits(floatAt(cpuExp, i)))
        val nan = 2139095040
        if (got > nan || want > nan) {
            if (!(got > nan && want > nan)) expNaN = false
        } else {
            val distance = if (got > want) got - want else want - got
            if (distance > expWorst) expWorst = distance
        }
    }
    val expEnds = f32ToBits(floatAt(gpuExp, 0)) == u32(0) && f32ToBits(floatAt(gpuExp, sweep - 1)) == u32(2139095040) &&
        f32ToBits(floatAt(gpuExp, sweep + 2)) == u32(0) && f32ToBits(floatAt(gpuExp, sweep)) == f32ToBits(f32(1.0))
    val expAgree = expWorst <= 2 && expNaN && expEnds
    println("kernelExp: $expCount values, GPU within $expWorst ulp of the CPU (at most 2), NaN, 0 and infinity at the ends: $expAgree")
    val tanhAgree = tanhCases(device)
    val probeWrong = probeCases(device)
    println("edge indices: loads and stores on every buffer type agree on the GPU and the CPU, and a guard around each buffer is untouched: ${probeWrong == 0}")
    val guardsWrong = guardCases(device)
    println("launch guards: arguments of the wrong number or kind, dropped memory, a buffer past its memory, a closed device, a closed host buffer and a record of another module are refused, and memory stays in its own device's context: ${guardsWrong == 0}")
    val halfWrong = halfCases(device)
    device.close()
    if (halfWrong == 0 && probeWrong == 0 && guardsWrong == 0 && vaddEqual && pickEqual && countRight && shuffleRight && agree && untouched && edgesRight && normAgree && q8Agree && fastSame && expAgree && tanhAgree) 0 else 1
}
