// Integer vector loads and stores and signed bytes in kernels (#1301): KernelU32Buffer.loadU32x4/storeU32x4 (one 16-byte
// access when the four words are inside and aligned, else four checked ones), KernelU8Buffer.loadU32x4 at any byte offset,
// loadS8, and the trusted loadU32x4Aligned twins. The last thread reads and writes past its buffers' ends, where loads give
// 0 and stores do nothing.
import "abla/kernel"
import "abla/simd"

/** dst's quad i = src's quad at word 4i + offset, its lanes mixed with the four words at byte 16i + offset of `bytes`;
 *  sums[i] = the 16 signed bytes from byte 16i + offset, weighted 1 to 16. */
@kernel
fun words4(src: KernelU32Buffer, bytes: KernelU8Buffer, dst: KernelU32Buffer, sums: KernelU32Buffer, n: int, offset: int) {
    val i = kernelGlobalId()
    if (i < n) {
        val q = src.loadU32x4(i * 4 + offset)
        val b = bytes.loadU32x4(i * 16 + offset)
        dst.storeU32x4(i * 4, u32x4(u32(int(q.get(0)) ^ int(b.get(3))), q.get(1), u32(int(q.get(2)) + int(b.get(0))), b.get(1)))
        var sum = 0
        var k = 0
        while (k < 16) {
            sum = sum + bytes.loadS8(i * 16 + offset + k) * (k + 1)
            k = k + 1
        }
        sums.store(i, sum)
    }
}

/** The same quads by the trusted one-load forms, where the kernel has shown they are inside and aligned (else nothing). */
@kernel
trusted fun words4Aligned(src: KernelU32Buffer, bytes: KernelU8Buffer, dst: KernelU32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n && i * 4 + 3 < src.size() && i * 16 + 15 < bytes.size() && src.isAligned(i * 4, 16) && bytes.isAligned(i * 16, 16)) {
        val q = src.loadU32x4Aligned(i * 4)
        val b = bytes.loadU32x4Aligned(i * 16)
        dst.storeU32x4(i * 4, u32x4(u32(int(q.get(0)) ^ int(b.get(3))), q.get(1), u32(int(q.get(2)) + int(b.get(0))), b.get(1)))
    }
}
