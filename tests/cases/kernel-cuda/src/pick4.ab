import "abla/kernel"
import "abla/simd"

/** Four elements of `a` (even i) or `b` (odd i), chosen by an `if` used as an f32x4 value. */
fun pick4Load(a: KernelF32Buffer, b: KernelF32Buffer, i: int): f32x4 = if (i % 2 == 0) a.load4(i * 4) else b.load4(i * 4)

/** c[i] = the sum of the four elements pick4Load chooses for thread i, for every thread i below n. */
@kernel
fun pick4(a: KernelF32Buffer, b: KernelF32Buffer, c: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) {
        val value = pick4Load(a, b, i)
        c.store(i, (value.get(0) + value.get(1)) + (value.get(2) + value.get(3)))
    }
}
