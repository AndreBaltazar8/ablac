// dp4a, prmt and float atomics (#1304): each thread's int8 dot product (kernelDp4a) and byte shuffle (kernelBytePerm) of two
// pseudo-random words, and float adds into seven sums (KernelF32Buffer.atomicAdd) whose partial sums are exact in any order,
// so both backends give the same bits.
import "abla/kernel"
import "abla/float"

/** dots[i] and perms[i] from a[i] and b[i]; sums[i % 7] += (i % 5) / 2. */
@kernel
fun intrinsics(a: KernelU32Buffer, b: KernelU32Buffer, dots: KernelU32Buffer, perms: KernelU32Buffer, sums: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) {
        val x = a.load(i)
        val y = b.load(i)
        dots.store(i, kernelDp4a(x, y, i * 1000 - 500000))
        perms.store(i, kernelBytePerm(x, y, (i * 2654435761) & 65535))
        sums.atomicAdd(i % 7, f32FromInt(i % 5) * f32(0.5))
    }
}
