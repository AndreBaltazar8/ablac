// KernelArray (#1299): f32, int and u32 arrays local to a thread, filled under `@unroll` and read at literals and at
// sums of an unrolled loop's variable; on the GPU they stay in registers (the PTX has no local memory for it).
import "abla/kernel"
import "abla/float"

/** out[i] = a mix of four f32, four int and two u32 elements thread i fills from x. */
@kernel
fun arrays4(x: KernelF32Buffer, out: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) {
        val acc = KernelArray<f32>(4)
        val counts = KernelArray<int>(4)
        val bits = KernelArray<u32>(2)
        @unroll
        for (k in 0 until 4) {
            acc.set(k, x.load(i * 4 + k) * f32(2.0))
            counts.set(3 - k, k * k + i)
        }
        @unroll
        for (k in 0 until 2) bits.set(k, f32ToBits(acc.get(k * 2 + 1)))
        var sum = acc.get(0) + acc.get(3)
        @unroll
        for (k in 1 until 3) sum = sum + acc.get(k) * f32FromInt(counts.get(k + 1) % 7)
        out.store(i, sum + f32FromBits(bits.get(1)) + f32FromInt(counts.get(0)) + acc.get(7))
    }
}
