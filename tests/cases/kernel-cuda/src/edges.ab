import "abla/kernel"

/** c[i] = a[i + 3] (0 for the last three: past the end of `a`), and a store past the end of `c` that must not happen. */
@kernel
fun edges(a: KernelF32Buffer, c: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) {
        c.store(i, a.load(i + 3))
        c.store(i + n, f32(99.0))
    }
}
