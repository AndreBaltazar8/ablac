import "abla/kernel"

/** Every thread below n adds one to counter[0]: whatever the order, the total is n. */
@kernel
fun countThreads(counter: KernelU32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) counter.atomicAdd(0, 1)
}

/** Each group's first thread writes 7 * group + 1 to partial[group], fences, and adds one to counter[0]; the group whose
 *  add saw groups - 1 arrived last, so every partial is written: it fences, adds them all into total[0] and resets the
 *  counter, so the next launch starts from 0 (the pattern that hands one kernel's per-group results to a last step). */
@kernel
fun sumGroups(partial: KernelU32Buffer, counter: KernelU32Buffer, total: KernelU32Buffer, groups: int) {
    if (kernelLocalId() != 0) return
    val group = kernelGroupId()
    partial.store(group, 7 * group + 1)
    kernelFence()
    val arrived = counter.atomicAdd(0, 1)
    if (arrived == groups - 1) {
        kernelFence()
        var sum = 0
        var g = 0
        while (g < groups) {
            sum = sum + partial.load(g)
            g = g + 1
        }
        total.store(0, sum)
        counter.store(0, 0)
    }
}

/** For every subgroup: the largest x over its lanes, ties going to the lowest lane, found with an xor-shuffle butterfly of
 *  (score, lane) pairs, into best and bestLane; and each lane's partner's (lane xor 1) int with bits above 32 set, as its
 *  two halves, so both halves are seen to move. */
@kernel
fun shuffleMax(x: KernelF32Buffer, best: KernelF32Buffer, bestLane: KernelU32Buffer, partnerHigh: KernelU32Buffer,
    partnerLow: KernelU32Buffer) {
    val i = kernelGlobalId()
    val lane = kernelSubgroupLane()
    val size = kernelSubgroupSize()
    var score = x.load(i)
    var at = lane
    var distance = size / 2
    while (distance > 0) {
        val otherScore = kernelSubgroupShuffleXor(score, distance)
        val otherAt = kernelSubgroupShuffleXorInt(at, distance)
        if (otherScore > score || (otherScore == score && otherAt < at)) {
            score = otherScore
            at = otherAt
        }
        distance = distance / 2
    }
    if (lane == 0) {
        best.store(i / size, score)
        bestLane.store(i / size, at)
    }
    val partner = kernelSubgroupShuffleXorInt(((lane + 1) << 33) | lane, 1)
    partnerHigh.store(i, partner >> 32)
    partnerLow.store(i, partner & 4294967295)
}
