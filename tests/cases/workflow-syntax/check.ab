// Parses each file it is given as YAML (abla/yaml, which is strict) and prints "<file>: line L, column C: <code> <message>"
// for one that is not, then exits 1. tools/test-workflow-syntax.sh runs it on .github/workflows: GitHub runs no job of a
// workflow that does not parse, and says so only on its web page.
import "abla/fs"
import "abla/io"
import "abla/process/arguments"
import "abla/yaml"

fun main: int {
    var failed = 0
    var index = 0
    while (index < processArgumentCount()) {
        val file = processArgument(index)
        val parsed = yamlParse(path(file).readText())
        if (!parsed.succeeded) {
            println("$file: line ${parsed.error.line}, column ${parsed.error.column}: ${parsed.error.code} ${parsed.error.message}")
            failed += 1
        }
        index += 1
    }
    if (failed == 0) 0 else 1
}
