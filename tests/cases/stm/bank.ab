import "abla/io"
import "./stm.ab"

// Eight threads move money between 16 accounts at random while two audit the
// total in read-only transactions: every audit and the end see the same total,
// and some attempts conflicted on the way.

val accounts: array<any> = openAccounts()

fun openAccounts(): array<any> {
    val opened: array<any> = []
    var index = 0
    while (index < 16) {
        opened.append(tvar(100))
        index = index + 1
    }
    opened
}

fun total(): int = atomic {
    var sum = 0
    var index = 0
    while (index < 16) {
        sum = sum + readInt(accounts[index])
        index = index + 1
    }
    sum
}

fun transfers(seed: int, count: int): int {
    var state = seed * 7919 + 13
    var moved = 0
    var done = 0
    while (done < count) {
        state = (state * 1103515245 + 12345) % 2147483648
        val from = state % 16
        val to = (state / 16) % 16
        val amount = (state / 256) % 9 + 1
        moved = moved + atomic {
            val balance = readInt(accounts[from])
            if (balance < amount || from == to) 0
            else {
                writeInt(accounts[from], balance - amount)
                writeInt(accounts[to], readInt(accounts[to]) + amount)
                amount
            }
        }
        done = done + 1
    }
    moved
}

fun audits(count: int): int {
    var wrong = 0
    var done = 0
    while (done < count) {
        if (total() != 1600) wrong = wrong + 1
        done = done + 1
    }
    wrong
}

fun main: int {
    if (total() != 1600) return 2
    val a = thread { transfers(1, 20000) }
    val b = thread { transfers(2, 20000) }
    val c = thread { transfers(3, 20000) }
    val d = thread { transfers(4, 20000) }
    val e = thread { transfers(5, 20000) }
    val f = thread { transfers(6, 20000) }
    val g = thread { transfers(7, 20000) }
    val h = thread { transfers(8, 20000) }
    val auditOne = thread { audits(3000) }
    val auditTwo = thread { audits(3000) }
    val moved = await a + await b + await c + await d + await e + await f + await g + await h
    val wrong = await auditOne + await auditTwo
    val end = total()
    println("moved $moved, wrong audits $wrong, total $end, conflicts ${abandoned() > 0}")
    if (wrong == 0 && end == 1600 && moved > 0) 42 else 1
}
