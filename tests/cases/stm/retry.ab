import "abla/io"
import "./stm.ab"

// A one-slot channel: the producer retries while the slot is full, the consumer
// while it is empty, so each wakes only when the other commits. Every value
// arrives once, in order.

val slot: any = tvar(0)

fun produce(count: int): int {
    var next = 1
    while (next <= count) {
        val value = next
        atomic {
            if (readInt(slot) != 0) retry()
            writeInt(slot, value)
            0
        }
        next = next + 1
    }
    count
}

fun consume(count: int): int {
    var sum = 0
    var expected = 1
    var outOfOrder = 0
    while (expected <= count) {
        val value = atomic {
            val held = readInt(slot)
            if (held == 0) retry()
            writeInt(slot, 0)
            held
        }
        if (value != expected) outOfOrder = outOfOrder + 1
        sum = sum + value
        expected = expected + 1
    }
    if (outOfOrder == 0) sum else -1
}

fun main: int {
    val consumer = thread { consume(5000) }
    val producer = thread { produce(5000) }
    val produced = await producer
    val sum = await consumer
    println("produced $produced, sum $sum")
    if (produced == 5000 && sum == 5000 * 5001 / 2) 42 else 1
}
