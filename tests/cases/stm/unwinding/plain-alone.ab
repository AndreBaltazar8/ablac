import "abla/build"
import "abla/wasm/build"

// The module without exception handling, built in a process of its own.
val plainFast = #wasmBuildModule(
    "plain-fast", "tests/cases/stm/surface-module.ab",
    "build/stm-unwinding/alone/plain-fast.wasm", true, false
)
val plain = #buildProgram(
    "plain", "tests/cases/stm/surface-module.ab",
    "build/stm-unwinding/alone/plain.wasm", "wasm32-module", "module", false, false
)

fun main: int = if (plainFast && plain) 0 else 1
