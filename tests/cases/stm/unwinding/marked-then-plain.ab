import "abla/build"
import "abla/wasm/build"

// In one compiler process: the module whose alternatives retry (built with
// exception handling), as a development and as a release build, then a module
// without (surface-module.ab), which must come out as it does alone
// (plain-alone.ab): the exception-handling options don't outlive their module.
val markedFast = #wasmBuildModule(
    "unwinding-fast", "tests/cases/stm/unwinding/module.ab",
    "build/stm-unwinding/marked-fast.wasm", true, false
)
val marked = #buildProgram(
    "unwinding", "tests/cases/stm/unwinding/module.ab",
    "build/stm-unwinding/marked.wasm", "wasm32-module", "module", false, false
)
val plainFast = #buildProgram(
    "plain-fast", "tests/cases/stm/surface-module.ab",
    "build/stm-unwinding/after/plain-fast.wasm", "wasm32-module", "module", true, false
)
val plain = #buildProgram(
    "plain", "tests/cases/stm/surface-module.ab",
    "build/stm-unwinding/after/plain.wasm", "wasm32-module", "module", false, false
)

fun main: int = if (markedFast && marked && plainFast && plain) 0 else 1
