// An orElse whose first alternative can retry, built for WebAssembly: the
// alternative is left by an exception. run() is how many checks failed.
var stock: int by TVar(10)

fun take(wanted: int): int = atomic {
    atomic {
        if (stock < wanted) retry
        stock -= wanted
        wanted
    } orElse { 0 }
}

@export("run")
fun run(): int = if (take(3) == 3 && take(20) == 0 && atomic { stock } == 7) 0 else 1
