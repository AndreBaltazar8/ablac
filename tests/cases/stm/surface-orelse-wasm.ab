// An orElse whose first alternative can retry, built for WebAssembly:
// stm.orelse-retry-wasm (nothing can leave the alternative there).
var stock: int by TVar(10)

fun take(wanted: int): int = atomic {
    atomic {
        if (stock < wanted) retry
        stock -= wanted
        wanted
    } orElse { 0 }
}

@export("run")
fun run(): int = take(3)
