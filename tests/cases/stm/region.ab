import "abla/io"
import "./stm.ab"
import "abla/runtime/scalar"

// A TVar's region (its clock) is the thread's whose logged transaction reached it first, however the TVars were
// made: eight TVars made one after the other, the first four used by one thread and the last four by another,
// take two regions on two clocks, each set once. Before any logged transaction a TVar has none (-2), and a later
// transaction of a third thread over all eight changes none.

resource class Cells(val cells: array<any>)

val made: Shared<Cells> = Shared(makeCells())

fun makeCells(): Cells {
    val cells: array<any> = []
    var index = 0
    while (index < 8) {
        cells.append(tvar(0))
        index = index + 1
    }
    Cells(cells)
}

trusted fun regionOf(cell: any): int = ablaRuntimeLoadI64(__ablaRuntimeSharedControl(cell, 14) + 8)

fun over(first: int, count: int): int = atomically {
    var index = first
    while (index < first + count) {
        writeInt(made.get().cells[index], readInt(made.get().cells[index]) + 1)
        index = index + 1
    }
    0
}

fun regions(): string {
    var text = ""
    for (cell in made.get().cells) text = "$text ${regionOf(cell)}"
    text
}

fun main: int {
    val before = regions()
    alwaysLogged(true)
    await thread { over(0, 4) }
    await thread { over(4, 4) }
    val first = regionOf(made.get().cells[0])
    val second = regionOf(made.get().cells[4])
    val assigned = regions()
    await thread { over(0, 8) }
    alwaysLogged(false)
    val after = regions()
    var same = true
    var index = 0
    while (index < 8) {
        if (regionOf(made.get().cells[index]) != (if (index < 4) first else second)) same = false
        index = index + 1
    }
    val twoClocks = first > 0 && second > 0 && (first & 15) != (second & 15)
    println("before:$before")
    println("two clocks: $twoClocks, each group one: $same, unchanged: ${assigned == after}")
    if (before == " -2 -2 -2 -2 -2 -2 -2 -2" && same && assigned == after && twoClocks) 42 else 1
}
