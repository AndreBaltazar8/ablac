import "abla/memory"
import "./stm.ab"

// One thread: transactions run directly, or logged when asked. Reads see the
// transaction's own writes, nested atomic blocks join the outer one, a block's
// result comes back, and what a transaction wrote or logged survives the
// collections inside it (strings made in the block, an undo log's old values).

fun singleRun(): int {
    val x = tvar(1)
    val y = tvar(2)
    val names = tvar("start")
    var failures = 0
    val sum = atomic {
        writeInt(x, readInt(x) + 10)
        val inner = atomic {
            writeInt(y, readInt(x) + readInt(y))
            if (!inTransaction()) 100 else 0
        }
        readInt(x) + readInt(y) + inner
    }
    if (sum != 11 + 13) failures = failures + 1
    if (atomic { readInt(x) * 100 + readInt(y) } != 1113) failures = failures + 1
    var round = 0
    while (round < 200) {
        atomic {
            val previous = "p${round - 1}-${round * 3 - 3}"
            if (round > 0 && !holds(names, previous)) writeInt(y, -1000)
            writeText(names, "p$round-${round * 3}")
            if (round % 50 == 0) memoryCollect()
            if (!holds(names, "p$round-${round * 3}")) writeInt(y, -2000)
            writeInt(x, readInt(x) + 1)
            0
        }
        round = round + 1
    }
    if (atomic { readInt(x) } != 211) failures = failures + 1
    if (atomic { textSize(names) } != "p199-597".size) failures = failures + 1
    if (atomic { readInt(y) } != 13) failures = failures + 1
    if (inTransaction()) failures = failures + 1
    failures
}

fun singleThreadFailures(): int {
    var failures = singleRun()
    alwaysLogged(true)
    failures = failures + singleRun()
    alwaysLogged(false)
    if (abandoned() != 0) failures = failures + 1
    if (commits() != 201) failures = failures + 100
    failures
}
