import "abla/io"

// Two one-slot channels (0 empty). A producer fills them in turn, retrying
// while the one it fills is full; a consumer takes from either with orElse,
// retrying while both are empty. Every value arrives once.
var first: int by TVar(0)
var second: int by TVar(0)

fun produce(count: int): int {
    var sent = 0
    for (value in 1..count) {
        atomic {
            if (value % 2 == 0) {
                if (first != 0) retry
                first = value
            } else {
                if (second != 0) retry
                second = value
            }
        }
        sent += value
    }
    sent
}

fun consume(count: int): int {
    var received = 0
    for (index in 0 until count) {
        received += atomic {
            if (first == 0) retry
            val taken = first
            first = 0
            taken
        } orElse {
            if (second == 0) retry
            val taken = second
            second = 0
            taken
        }
    }
    received
}

fun main: int {
    val producer = thread { produce(20000) }
    val consumer = thread { consume(20000) }
    val sent = await producer
    val received = await consumer
    println("sent $sent received $received")
    if (sent == received) 42 else 1
}
