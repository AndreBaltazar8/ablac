// A library's own transactional delegate: it conforms to Transactional and
// keeps its value and its write count in TVars, so a binding delegated to it
// works in `atomic` and threads share it, as one delegated to a TVar does.
class Counted(val cell: TVar<int>, val writes: TVar<int>) : Transactional {
    fun getValue(): int = this.cell.getValue()

    fun setValue(value: int): void {
        this.cell.setValue(value)
        this.writes.setValue(this.writes.getValue() + 1)
    }
}

fun counted(initial: int): Counted = Counted(TVar(initial), TVar(0))
