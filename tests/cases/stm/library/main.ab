// abla/stm under strict imports: TVar and Transactional need no import (the
// module is the program's without one), private declarations may use them,
// and a library's own transactional delegate (counted.ab), like a TVar, is
// shared by threads and read and written in `atomic`.
import "abla/io"
import "./counted.ab"

private var hits: int by TVar(0)

private class Tally(var count: int by TVar(0))

private val tally = Tally()

var total: int by counted(0)

private fun add(times: int): int {
    for (done in 0 until times) atomic {
        total += 1
        hits += 2
    }
    times
}

fun main: int {
    val a = thread { add(500) }
    val b = thread { add(500) }
    val added = await a + await b
    // A private class's TVar properties, on this thread (the object itself
    // is a global no thread shares).
    for (done in 0 until 1000) atomic { tally.count += 3 }
    val writes = atomic { ^total.writes.getValue() }
    val seen = atomic { "$total $hits ${tally.count} $writes" }
    if (seen != "1000 2000 3000 1000" || added != 1000) {
        println("stm library: $seen ($added)")
        return 1
    }
    42
}
