import "abla/io"

// The bank of bank.ab in the language's surface: eight threads move money
// among 16 TVar accounts in `atomic` blocks while two audit the total in
// read-only ones. Every audit and the end see 1600.
resource class Bank(val accounts: array<TVar<int>>)

val bank: Shared<Bank> = Shared(open())

fun open(): Bank {
    val accounts: array<TVar<int>> = []
    for (i in 0 until 16) accounts.append(TVar(100))
    Bank(accounts)
}

fun total(): int = atomic {
    var sum = 0
    for (account in bank.get().accounts) sum += account.getValue()
    sum
}

fun transfers(seed: int, count: int): int {
    var state = seed * 7919 + 13
    var moved = 0
    for (done in 0 until count) {
        state = (state * 1103515245 + 12345) % 2147483648
        val from = state % 16
        val to = (state / 16) % 16
        val amount = (state / 256) % 9 + 1
        moved += atomic {
            if (bank.get().accounts[from].getValue() < amount || from == to) 0
            else {
                bank.get().accounts[from].setValue(bank.get().accounts[from].getValue() - amount)
                bank.get().accounts[to].setValue(bank.get().accounts[to].getValue() + amount)
                amount
            }
        }
    }
    moved
}

fun audits(count: int): int {
    var wrong = 0
    for (done in 0 until count) if (total() != 1600) wrong += 1
    wrong
}

fun main: int {
    val a = thread { transfers(1, 20000) }
    val b = thread { transfers(2, 20000) }
    val c = thread { transfers(3, 20000) }
    val d = thread { transfers(4, 20000) }
    val e = thread { transfers(5, 20000) }
    val f = thread { transfers(6, 20000) }
    val g = thread { transfers(7, 20000) }
    val h = thread { transfers(8, 20000) }
    val one = thread { audits(3000) }
    val two = thread { audits(3000) }
    val moved = await a + await b + await c + await d + await e + await f + await g + await h
    val wrong = await one + await two
    println("moved $moved wrong audits $wrong total ${total()}")
    if (wrong == 0 && total() == 1600 && moved > 0) 42 else 1
}
