// A program's own declaration named TVar wins: abla/stm isn't loaded, and
// TVar is the program's plain class.
class TVar(var value: int) {
    fun getValue(): int = this.value

    fun setValue(next: int): void {
        this.value = next * 2
    }
}

fun main: int {
    var doubled: int by TVar(1)
    doubled = 21
    doubled
}
