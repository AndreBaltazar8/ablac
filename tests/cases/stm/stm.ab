// Helpers over the runtime's transactions (no language surface yet): TVars of
// ints and strings, transactions over closures (`atomically`, a plain call:
// `atomic { }` is the language's), retry.

trusted fun tvar(value: any): any = __ablaRuntimeTVarCreate(value)

trusted fun readInt(tvar: any): int = __ablaRuntimeAsI64(__ablaRuntimeStmRead(tvar))

trusted fun writeInt(tvar: any, value: int): void {
    __ablaRuntimeStmWrite(tvar, __ablaRuntimeI64(value))
    return
}

// A string TVar's length, and whether it holds `text`.
trusted fun textSize(tvar: any): int = __ablaRuntimeStringLengthValue(__ablaRuntimeStmRead(tvar))

trusted fun holds(tvar: any, text: string): bool =
    __ablaRuntimeAsBool(__ablaRuntimeEqual(__ablaRuntimeStmRead(tvar), text))

trusted fun writeText(tvar: any, value: string): void {
    __ablaRuntimeStmWrite(tvar, value)
    return
}

trusted fun atomically(body: () -> int): int = __ablaRuntimeAsI64(__ablaRuntimeStmAtomic(body))

trusted fun retry(): never = __ablaRuntimeStmRetry()

trusted fun alwaysLogged(logged: bool): void = __ablaRuntimeStmSetAlwaysLogged(logged)

trusted fun abandoned(): int = __ablaRuntimeStmAbandoned()

trusted fun commits(): int = __ablaRuntimeStmCommits()

trusted fun inTransaction(): bool = __ablaRuntimeStmActive()
