import "abla/build"
import "abla/process"
import "../stm.ab"

// A panic inside a transaction, contained by a checked export: what the
// transaction wrote before it is rolled back (a direct transaction's undo log;
// a logged one's buffer is never written), and the next transaction starts clean.

val from: any = tvar(100)
val to: any = tvar(0)

fun transfer(amount: int): int = atomic {
    writeInt(from, readInt(from) - amount)
    writeInt(to, readInt(to) + amount)
    if (amount > 10) panic("transfer of $amount is over the limit")
    readInt(from)
}

fun balances(logged: int): int {
    alwaysLogged(logged != 0)
    atomic { readInt(from) * 1000 + readInt(to) }
}

val exportedTransfer = #exportCheckedFunction("transfer", "stm_transfer")
val exportedBalances = #exportCheckedFunction("balances", "stm_balances")
