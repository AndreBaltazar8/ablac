import "abla/io"
import "./stm.ab"

// Writes that no read comes before, in clocks of their own: four threads each
// set three accounts, 1,200 bytes apart, to one value without reading them
// (a transaction that has only written moves from one clock to the next at the
// second write), and an auditor reading the accounts, then a fourth in a third
// clock, sees them all equal.

resource class Accounts(val cells: array<any>)

val accounts: Shared<Accounts> = Shared(openAccounts())

fun openAccounts(): Accounts {
    val opened: array<any> = []
    val spares: array<any> = []
    var index = 0
    while (index < 4) {
        opened.append(tvar(0))
        var spare = 0
        while (spare < 25) {
            spares.append(tvar(0))
            spare = spare + 1
        }
        index = index + 1
    }
    Accounts(opened)
}

fun setter(value: int, count: int): int {
    var round = 0
    while (round < count) {
        atomically {
            writeInt(accounts.get().cells[0], value * 1000000 + round)
            writeInt(accounts.get().cells[1], value * 1000000 + round)
            writeInt(accounts.get().cells[2], value * 1000000 + round)
            0
        }
        round = round + 1
    }
    0
}

fun auditor(count: int): int {
    var wrong = 0
    var round = 0
    while (round < count) {
        val agree = atomically {
            val first = readInt(accounts.get().cells[0])
            val second = readInt(accounts.get().cells[1])
            val third = readInt(accounts.get().cells[2])
            readInt(accounts.get().cells[3])
            if (first == second && second == third) 1 else 0
        }
        if (agree == 0) wrong = wrong + 1
        round = round + 1
    }
    wrong
}

fun main: int {
    val a = thread { setter(1, 30000) }
    val b = thread { setter(2, 30000) }
    val c = thread { setter(3, 30000) }
    val d = thread { setter(4, 30000) }
    val checkOne = thread { auditor(30000) }
    val checkTwo = thread { auditor(30000) }
    await a + await b + await c + await d
    val wrong = await checkOne + await checkTwo
    println("blind writes, wrong audits $wrong")
    if (wrong == 0) 42 else 1
}
