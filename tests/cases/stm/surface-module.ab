// Transactions in the language's surface in a WebAssembly module (one thread:
// direct, with an undo log): TVar properties and globals, nested atomic,
// orElse whose first alternative completes. (A retry inside an alternative
// traps there: nothing can leave the alternative without unwinding.)
var stock: int by TVar(10)

class Account(var balance: int by TVar(0), var notes: string by TVar(""))

@export("run")
fun run(): int {
    var failed = 0
    val account = Account()
    atomic {
        account.balance = 5
        account.notes = "opened"
    }
    val doubled = atomic {
        account.balance += 1
        atomic { account.balance * 2 }
    }
    if (doubled != 12) failed += 1
    val chosen = atomic { stock -= 3
                          stock } orElse { -1 }
    if (chosen != 7) failed += 1
    val counter = TVar(1)
    atomic { counter.setValue(counter.getValue() + 41) }
    if (atomic { counter.getValue() } != 42) failed += 1
    if (atomic { account.notes } != "opened") failed += 1
    failed
}
