import "abla/http"
import "abla/http/tls"
import "abla/http/async"

fun awaitCompletion(var client: HttpAsyncClient, id: int): HttpAsyncCompletion {
    var result = HttpAsyncCompletion(id, 0, [], "", "no completion", 0)
    var loops = 0
    while (result.error == "no completion" && loops < 300) {
        client.step(10)
        for (each in client.takeCompletions()) if (each.id == id) result = each
        loops = loops + 1
    }
    result
}

fun main: int {
    val client = httpIpv4Client("localhost:39092", "127.0.0.1", 39092, 4096, 600)
    val close = client.send(httpGet("/close"))
    val head = client.send(httpRequest("HEAD", "/head"))
    val empty = client.send(httpGet("/empty"))
    val notModified = client.send(httpGet("/not-modified"))
    val info = client.send(httpGet("/info"))
    val framed = client.send(httpGet("/framed"))
    val chunked = client.send(httpGet("/chunked"))
    val stalled = client.send(httpGet("/stall"))
    val boundedClient = httpIpv4Client("localhost:39092", "127.0.0.1", 39092, 64, 600)
    val atLimit = boundedClient.send(httpGet("/at-limit"))
    val oversized = boundedClient.send(httpGet("/over"))
    val secure = httpsClient("127.0.0.1", 39093, 4096, 1000)
    val tls = secure.send(httpGet("/tls-close"))
    val tlsStall = secure.send(httpGet("/tls-stall"))
    val tlsHead = secure.send(httpRequest("HEAD", "/tls-head"))
    val tlsNext = secure.send(httpGet("/tls-next"))
    val async = httpAsyncClient()
    val asyncUrl = "http://127.0.0.1:39092"
    val asyncClose = awaitCompletion(async, async.get("$asyncUrl/async-close"))
    val asyncHead = awaitCompletion(async, async.request("HEAD", "$asyncUrl/async-head", [], "", 600))
    val asyncNext = awaitCompletion(async, async.get("$asyncUrl/async-next"))
    val incomplete = httpParseResponseBounded("HTTP/1.0 200 OK\r\n\r\nx", 100, false, false)
    val complete = httpParseResponseBounded("HTTP/1.0 200 OK\r\n\r\nx", 100, false, true)
    val transfer = httpParseResponseBounded("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\nContent-Length: 1\r\n\r\nxyz", 100, false, false)
    val transferEof = httpParseResponseBounded("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\nContent-Length: 1\r\n\r\nxyz", 100, false, true)
    if (close.succeeded && close.complete && close.response.status == 200 &&
        close.response.body == "delayed body" &&
        head.succeeded && head.complete && head.response.body == "" &&
        empty.succeeded && empty.complete && empty.response.body == "" &&
        notModified.succeeded && notModified.complete && notModified.response.body == "" &&
        info.succeeded && info.complete && info.response.body == "" &&
        framed.succeeded && framed.complete && framed.response.body == "ok" &&
        chunked.succeeded && chunked.complete && chunked.response.body == "chunk" &&
        (!stalled.succeeded || !stalled.complete) && atLimit.succeeded && atLimit.complete &&
        atLimit.response.body.size == 45 && (!oversized.succeeded || !oversized.complete) &&
        tls.succeeded && tls.complete && tls.response.body == "secure body" &&
        (!tlsStall.succeeded || !tlsStall.complete) &&
        tlsHead.succeeded && tlsHead.complete && tlsHead.response.body == "" &&
        tlsNext.succeeded && tlsNext.complete &&
        asyncClose.succeeded() && asyncClose.body == "async body" &&
        asyncHead.succeeded() && asyncHead.body == "" && asyncNext.succeeded() &&
        !incomplete.complete && complete.complete && !transfer.complete &&
        transferEof.complete && transferEof.response.body == "xyz") 42 else 1
}
