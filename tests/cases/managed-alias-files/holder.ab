// Each `val` below binds a field holding a managed value, so the analysis
// records it as an alias of that field, by its offsets in this file. The
// `val`s of main.ab sit at the same offsets in that file: an offset names a
// place only together with its file.
class Box(val items: array<int>) {
    fun last(): int {
        val itemsOfBox = this.items
        itemsOfBox[itemsOfBox.size - 1]
    }
}

fun firstOf(box: Box): int {
    val items = box.items
    items[0]
}
