// The `val`s in `Counter.next` and `sumOf` start and end at the offsets of
// the aliases in holder.ab (tools/test-managed-alias-files.sh checks it).
// They bind plain ints of this file and must not be taken for those aliases.
// (Keep them so)
import "holder.ab"

class Counter(val start: int) {
    fun next(): int {
        val values = this.start + 1
        values
    }
}

// A plain function's local.
fun sumOf(x: int): int {
    val total = x + 1 + 2
    total
}

fun main: int {
    val box = Box([5, 6, 7])
    if (Counter(3).next() == 4 && sumOf(4) == 7 && firstOf(box) == 5 &&
        box.last() == 7) 42 else 1
}
