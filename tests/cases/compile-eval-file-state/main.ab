import "abla/compiler"
import "abla/fs"

#compilerGrant("filesystem.read")

interface CompileProbeTls {
    fun close(handle: int): void
}
val compileProbeTlsAdded: array<CompileProbeTls> = []
class CompileProbeConnection {
    fun close(): void {
        if (compileProbeTlsAdded.size > 0) compileProbeTlsAdded[0].close(1)
        return
    }
}

class ReceiptLength(val length: int)
class FileMeasure(val value: int) {
    fun fromReceipt(receipt: ReceiptLength): int = receipt.length
}

// The slice keeps FileMeasure's complete declaration, including a method
// whose parameter type is mentioned only in that method's signature.
compile fun readProbe(): int = 40 + FileMeasure(path("sample.txt").readText().size).value
val RESULT = #readProbe()
fun main: int = RESULT

@export("run")
fun run(): int = RESULT
