import "../../../src/parser.ab"
import "../../../src/ct_state.ab"
import "../../../src/ct_native_effects.ab"
import "abla/fs"

fun main: int {
    val source = "${bootstrapCompileProviderStandardLibrary()}/abla/sys/linux/fs/entry.ab"
    val library = bootstrapParseWithIdentity(Path(source).readText(), source)
    val declarations: array<BootstrapDeclaration> = []
    for (declaration in library.declarations) {
        if (declaration.extensionOwner == "Path" && declaration.name == "readText")
            declarations.append(declaration)
    }
    if (library.errors != 0 || declarations.size != 1) return 1
    // Without an exact target fact for descriptor.close(), the library body's
    // unresolved call would also keep this unrelated writer. The compile-time
    // file provider never makes that call through the program's declarations.
    val user = bootstrapParseWithIdentity(
        "val tracked: array<int> = [0]\n" +
        "class Unrelated { fun close(): void { tracked[0] = 42; return } }\n" +
        "compile fun probe(): string = Path(\"fixture.txt\").readText()\n", "probe.ab")
    if (user.errors != 0 || user.declarations.size != 3) return 2
    for (declaration in user.declarations) declarations.append(declaration)
    val site = user.declarations[2].expression
    val state = bootstrapCtStateAnalyze(declarations, [true, false, false, false],
        [site], ["probe.ab"], [site], ["string"])
    if (state.writers[1] != "") return 3

    // The same declaration name and signature in ordinary program source is
    // not a compiler provider, and its actual write must remain visible.
    val lookalike = bootstrapParseWithIdentity(
        "val tracked: array<int> = [0]\n" +
        "fun Path.readText(): string { tracked[0] = 42; \"\" }\n" +
        "compile fun probe(): string = Path(\"fixture.txt\").readText()\n", "lookalike.ab")
    if (lookalike.errors != 0 || lookalike.declarations.size != 3) return 4
    val fakeSite = lookalike.declarations[2].expression
    val fake = bootstrapCtStateAnalyze(lookalike.declarations, [false, false, false],
        [fakeSite], ["lookalike.ab"], [fakeSite], ["string"])
    if (fake.writers[0] == "") return 5
    42
}
