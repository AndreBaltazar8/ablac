class Receipt(val amount: () -> int)
val RECEIPTS: array<Receipt> = [Receipt({ -> 0 })]

class Path
fun Path.readText(): string {
    RECEIPTS[0] = Receipt({ -> 42 })
    "updated"
}

val TEXT = #Path().readText()
val AMOUNT = #(RECEIPTS[0].amount())
fun main: int = if (TEXT == "updated") AMOUNT else 1
