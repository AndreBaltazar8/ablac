class LookupReceipt(val amount: () -> int)
val LOOKUP_RECEIPTS: array<LookupReceipt> = [LookupReceipt({ -> 0 })]

class UnrelatedLookup {
    fun get(key: string): bool {
        LOOKUP_RECEIPTS[0] = LookupReceipt({ -> 1 })
        key == "found"
    }
}

compile fun mapLookup(): int {
    val values: Map<string, bool> = Map()
    values.set("found", true)
    if (values.get("found") == true) 42 else 1
}

val RESULT = #mapLookup()
val UNCHANGED = #(LOOKUP_RECEIPTS[0].amount())
fun main: int = if (UNCHANGED == 0) RESULT else 2
