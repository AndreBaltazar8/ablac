fun hexOf(s: string): string {
    if (s.size == 0) return "-"
    var out = ""
    for (b in s) out = out + "0123456789abcdef".slice(b / 16, b / 16 + 1) + "0123456789abcdef".slice(b % 16, b % 16 + 1)
    out
}

fun decoded(s: string?): string = if (s == null) "null" else hexOf(s)

fun cases(): array<string> {
    val out: array<string> = []
    for (s in encodeInputs()) {
        out.append("e0 ${percentEncode(s)}")
        out.append("e1 ${percentEncode(s, true)}")
    }
    for (s in decodeInputs()) {
        out.append("d0 ${decoded(percentDecode(s))}")
        out.append("d1 ${decoded(percentDecode(s, true))}")
    }
    for (s in base64Inputs()) {
        out.append("b ${decoded(base64DecodeOrNull(s))} ${hexOf(base64Decode(s))}")
    }
    for (s in hexInputs()) {
        out.append("h ${decoded(hexDecodeOrNull(s))} ${hexOf(hexDecode(s))}")
    }
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) bad = 1
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println(line)
    bad
}
