// HttpRequest.queryParameterDecoded: %XX and + undone, null when the parameter is absent, empty or malformed.
import "abla/io"
import "abla/http"

@noinline fun idS(x: string): string = x

fun decoded(query: string, name: string): string {
    val headers: array<HttpHeader> = []
    val names: array<string> = []
    val values: array<string> = []
    val request = HttpRequest("GET", "/", query, headers, "", names, values)
    val v = request.queryParameterDecoded(name)
    val raw = request.queryParameter(name)
    "[${if (v == null) "null" else v}|${raw}]"
}

fun cases(): array<string> {
    val out: array<string> = []
    out.append("plain ${decoded(idS("a=1&b=2"), idS("b"))} ${decoded(idS("a=1&b=2"), idS("c"))} ${decoded(idS(""), idS("a"))}")
    out.append("space ${decoded(idS("q=a+b"), idS("q"))} ${decoded(idS("q=a%20b"), idS("q"))} ${decoded(idS("q=a%2Bb"), idS("q"))}")
    out.append("utf8 ${decoded(idS("n=J%C3%B6rg"), idS("n"))} ${decoded(idS("n=%E6%97%A5%E6%9C%AC"), idS("n"))} ${decoded(idS("n=%F0%9F%98%80"), idS("n"))}")
    out.append("bad ${decoded(idS("n=%"), idS("n"))} ${decoded(idS("n=%4"), idS("n"))} ${decoded(idS("n=%zz"), idS("n"))} ${decoded(idS("n=%C0%80"), idS("n"))} ${decoded(idS("n=%80"), idS("n"))}")
    out.append("empty ${decoded(idS("a="), idS("a"))} ${decoded(idS("a=&a=%41"), idS("a"))} ${decoded(idS("a"), idS("a"))}")
    out.append("raw-name ${decoded(idS("a%20b=1"), idS("a b"))} ${decoded(idS("a%20b=1"), idS("a%20b"))}")
    out.append("amp-in-value ${decoded(idS("a=1%262&b=3"), idS("a"))} ${decoded(idS("a=x%3Dy"), idS("a"))}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) bad = 1
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println(line)
    bad
}
