// Generators in a WebAssembly module: an infinite one stopped by `break`, its
// `defer` run as it closes, nested generators.
var closes = 0

fun closed(): void {
    closes = closes + 1
    return
}

fun naturals(): Generator<int> = generator {
    defer { closed() }
    var n = 0
    while (true) {
        yield n
        n += 1
    }
}

fun pairs(limit: int): Generator<int> = generator {
    for (a in naturals()) {
        if (a >= limit) break
        for (b in 0 until a) yield a * 100 + b
    }
}

@export("run")
fun run(limit: i32): int {
    var total = 0
    for (v in pairs(int(limit))) total = total + v
    for (n in naturals()) if (n == 3) break
    total * 10 + closes
}
