import "abla/wasm/build"

// A WebAssembly module whose exports iterate generators: the state machine
// needs no stack switching and no host runtime.
val built = #wasmBuildModule(
    "generator-wasm",
    "tests/cases/generator-wasm/module.ab",
    "build/generators-tasks/generator-wasm.wasm",
    false,
    false
)

fun main: int = if (built) 0 else 1
