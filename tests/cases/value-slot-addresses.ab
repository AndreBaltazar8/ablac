// Reads of a value through ablaRuntimeValueAddress. The first three address
// the value's own slot once lowered; the last three must keep the integer
// address as written.

trusted fun slotTag(value: any): int =
    ablaRuntimeLoadI32(ablaRuntimeValueAddress(value))

trusted fun slotWord1(value: any): int =
    ablaRuntimeLoadI64(ablaRuntimeValueAddress(value) + 16)

trusted fun slotLocal(value: any): int {
    val address = ablaRuntimeValueAddress(value)
    if (ablaRuntimeLoadI32(address) == 2) ablaRuntimeLoadI64(address + 8) else 0
}

// The address itself is stored to memory.
trusted fun slotEscapes(value: any): int {
    val address = ablaRuntimeValueAddress(value)
    val memory = __ablaRuntimeAllocate(8)
    ablaRuntimeStoreI64(memory, address)
    val result = ablaRuntimeLoadI64(ablaRuntimeLoadI64(memory) + 8)
    __ablaRuntimeFree(memory)
    result
}

// The read ends past the 24-byte value.
trusted fun slotPast(value: any): int =
    ablaRuntimeLoadI64(ablaRuntimeValueAddress(value) + 20)

// The local holding the address is stored twice.
trusted fun slotTwoStores(left: any, right: any, pick: bool): int {
    var address = ablaRuntimeValueAddress(left)
    if (pick) address = ablaRuntimeValueAddress(right)
    ablaRuntimeLoadI64(address + 8)
}

trusted fun integerWithWord1(word0: int, word1: int): any =
    ablaRuntimeMakeValue(2, 0, word0, word1)

fun main: int {
    val values = [5, 9]
    val left = integerWithWord1(values[0], 37)
    val right = integerWithWord1(values[1], 0)
    val never = values.size == 99
    val past = if (never) slotPast(left) else 0
    val valid = slotTag(left) == 2 && slotWord1(left) == 37 &&
        slotLocal(left) == 5 && slotEscapes(left) == 5 && past == 0 &&
        slotTwoStores(left, right, true) == 9 &&
        slotTwoStores(left, right, false) == 5
    if (valid) 42 else 0
}
