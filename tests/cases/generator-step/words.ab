// A generator whose step allocates (a slice per word) still roots what it
// holds across a collection.
import "abla/io"

fun words(text: string): Generator<string> = generator {
    var start = 0
    var index = 0
    while (index <= text.size) {
        if (index == text.size || text[index] == 32) {
            if (index > start) yield text.slice(start, index)
            start = index + 1
        }
        index = index + 1
    }
}

fun main {
    var text = ""
    var i = 0
    while (i < 20000) {
        text = "$text w$i"
        i = i + 1
    }
    var total = 0
    var round = 0
    while (round < 20) {
        for (w in words(text)) total = total + w.size
        round = round + 1
    }
    println("$total")
}
