// A generator whose step allocates nothing: the step is called directly and
// neither roots values nor polls memory pressure.
import "abla/io"

fun count(limit: int): Generator<int> = generator {
    var value = 0
    while (value < limit) {
        yield value
        value = value + 1
    }
}

fun squares(limit: int): Generator<int> = generator {
    for (v in count(limit)) yield v * v % 1000
}

fun main {
    var total = 0
    for (v in count(100000)) total = total + v
    for (v in squares(1000)) total = total + v
    for (v in count(3)) if (v == 1) break
    println("$total")
}
