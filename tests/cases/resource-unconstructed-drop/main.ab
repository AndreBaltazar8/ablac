// A resource class that is only named as an element type (nothing constructs it) still has a drop
// function built for the array that holds it; there is no `drop` of it to call, and none can run.
// A resource class that is constructed keeps its drop and it runs (the negative check: the call is
// left out only for a class never constructed).
resource class Inner(var handle: int) {
    trusted fun drop(): void {
        if (this.handle != 0) {
            this.handle = 0
        }
        return
    }
}

resource class Outer(val inner: Inner, val count: int) {
    trusted fun drop(): void {
        this.inner.drop()
        return
    }
}

class Holder(val outers: array<Outer>, val marker: int)

var dropped = 0

resource class Live(val id: int) {
    trusted fun drop(): void {
        dropped = dropped + 1
        return
    }
}

fun useLive(): int {
    val live = Live(7)
    return live.id
}

fun main(): int {
    val holder = Holder([], 40)
    val seen = useLive()
    // 40 + 1 drop + (7 - 6)
    return holder.marker + dropped + seen - 6
}
