import "abla/process/exit"

compile fun missingMap(): int {
    val values: Map<string, int> = Map()
    for (key in ["a", "b"]) values.set(key, key.size)
    val result = values.get("missing")
    if (result == null) panic("catalog key missing")
    result
}

val FAIL = #missingMap()
fun main: int = FAIL
