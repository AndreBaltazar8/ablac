class OtherLookup {
    fun get(key: string): int {
        val decimal = 0.5
        if (decimal > 0.0) key.size else 0
    }
}

compile fun otherLookup(): int = OtherLookup().get("xx")

compile fun mapResult(): int {
    val counts: Map<string, int> = Map()
    for (key in ["alpha", "beta", "gamma", "delta", "epsilon", "zeta"]) counts.set(key, key.size)
    counts.set("beta", 1)
    if (counts.get("beta") != 1 || counts.get("missing") != null) return 1
    if (!counts.remove("alpha") || counts.has("alpha") || counts.remove("alpha")) return 2
    counts.set("alpha", 42)
    val keys = counts.keys()
    val values = counts.values()
    if (keys[0] != "beta" || keys[keys.size - 1] != "alpha" ||
        values[0] != 1 || values[values.size - 1] != 42) return 3
    val selected = counts.take("alpha")
    if (selected == null) return 4
    counts.clear()
    if (counts.size != 0 || counts.take("alpha") != null) return 4
    val flags = Map<int, bool>()
    flags.set(-1, true)
    if (flags.get(-1) != true) return 5
    selected
}

val MAP = #mapResult()
val OTHER = #otherLookup()
fun main: int = if (OTHER == 2) MAP else 6
