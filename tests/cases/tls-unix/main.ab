// Every wait here is generous on purpose (a minute where a second would do): a loaded machine may be slow, and what a
// test asserts is which event ended the wait (the deadline, or the peer), not how long it took. The stalled peers
// trickle for 40 s and sleep for a minute, so an enforced 200 or 250 ms deadline ends them at about that and a
// missing one only at 40 s or more; the bounds below sit between. (Connecting is limited to ten seconds by the
// library, and a loopback or Unix connect takes no time.)
import "abla/tls/pure"
import "abla/tls/pure/client"
import "abla/tls/pure/connection"
import "abla/tls/pure/verify"
import "abla/crypto/x509"
import "abla/net"
import "abla/fs"
import "abla/text"
import "abla/process"
import "abla/sys/linux"
import "abla/sys/linux/process"

fun addressOf(text: string): UnixSocketAddress = if (text.startsWith("@"))
    unixAbstractAddress(text.slice(1, text.size)) else unixSocketAddress(text)

fun securedClient(address: UnixSocketAddress, certificate: string, key: string,
    bundle: string, mode: string, deadline: int = 0): TlsConnection {
    var connection = unixConnect(address, 10000)
    if (mode == "limits") connection.setTimeouts(20000, 30000)
    if (mode == "pem" || mode == "invalid") {
        val identity = tlsClientIdentityFromPem(path(certificate).readText(),
            if (mode == "invalid") "bad key" else path(key).readText())
        tlsUpgradeWithIdentity(connection, "localhost", identity, certificate, 60000, 60000, deadline)
    } else if (mode == "p12") {
        val identity = tlsClientIdentityFromPkcs12(path(bundle).readText(), "test")
        tlsUpgradeWithIdentity(connection, "localhost", identity, certificate, 60000, 60000, deadline)
    } else if (mode == "bad-host") {
        tlsUpgrade(connection, "wrong.invalid", certificate, 60000, 60000)
    } else if (mode == "bad-ca") {
        tlsUpgrade(connection, "localhost", "/no-such-ca-file", 60000, 60000)
    } else if (deadline != 0) {
        val trust = x509TrustStoreFromFile(certificate) ?? return tlsFailedConnection()
        val verify = tlsX509Verifier(trust, { realtimeMilliseconds() / 1000 })
        val config = tlsClientConfig("localhost", verify, tlsPureRandom)
        var tcp = TcpConnection(connection.descriptor)
        connection.descriptor = -1
        val inner = tlsPureUpgrade(tcp, config, 60000, 60000, deadline)
        val handle = if (inner.ok()) inner.tcp.descriptor else -1
        TlsConnection(handle, move(inner))
    } else tlsUpgrade(connection, "localhost", certificate, 60000, 60000)
}

trusted fun echoOnce(address: UnixSocketAddress, certificate: string, key: string, inherited: bool): bool {
    var listener = unixListen(address)
    if (listener.descriptor < 0) return false
    val child = linuxSyscall0(57)
    if (child == 0) {
        var secured = securedClient(address, certificate, key, "", if (inherited) "limits" else "plain")
        val kept = !inherited || (secured.handle != -1 &&
            linuxSocketTimeout(secured.descriptor(), 20) >= 16000 &&
            linuxSocketTimeout(secured.descriptor(), 20) < 40000)
        val ok = secured.handle != -1 && kept && secured.write("hello") == 5 && secured.read(32) == "world"
        val closed = secured.close() && secured.close()
        linuxSyscall1(60, if (ok && closed) 0 else 1)
    }
    if (child < 0) return false
    if (!linuxPollSocket(listener.descriptor, true, false, 60000).readable) return false
    var stream = listener.accept()
    if (inherited) stream.setTimeouts(20000, 30000)
    val descriptor = stream.descriptor
    val nonIp = socketPeerAddress(descriptor) == null
    var secured = tlsServerUpgrade(stream, certificate, key, 60000, 10000,
        linuxMonotonicMilliseconds() + 60000)
    // Pure server upgrades apply the requested timeout even when the raw socket had limits.
    val serverLimit = linuxSocketTimeout(descriptor, 20)
    val ok = secured.handle != -1 && nonIp && serverLimit >= 9000 && serverLimit < 11000 &&
        socketPeerAddress(secured.descriptor()) == null &&
        secured.read(32) == "hello" && secured.write("world") == 5
    val closed = secured.close() && secured.close() && listener.close()
    val result = linuxWaitProcess(child)
    // Listener close must not remove the caller's filesystem socket.
    val kept = address.abstract || path(address.name).exists()
    val removed = address.abstract || path(address.name).remove()
    ok && closed && result.status == 0 && kept && removed
}

trusted fun stalledServer(address: UnixSocketAddress, certificate: string, key: string): bool {
    var listener = unixListen(address)
    if (listener.descriptor < 0) return false
    val child = linuxSyscall0(57)
    if (child == 0) {
        var stream = unixConnect(address)
        stream.write("\x16\x03")
        linuxSleep(60000)
        linuxSyscall1(60, 0)
    }
    if (child < 0 || !linuxPollSocket(listener.descriptor, true, false, 60000).readable) return false
    var stream = listener.accept()
    val descriptor = stream.descriptor
    val start = linuxMonotonicMilliseconds()
    var secured = tlsServerUpgrade(stream, certificate, key, 60000, 60000, start + 200)
    val elapsed = linuxMonotonicMilliseconds() - start
    val ok = secured.handle == -1 && elapsed >= 100 && elapsed < 30000 &&
        linuxSyscall3(72, descriptor, 1, 0) < 0
    linuxSyscall2(62, child, 15)
    linuxWaitProcess(child)
    listener.close()
    if (!address.abstract) path(address.name).remove()
    ok
}

trusted fun tcpOnce(certificate: string, key: string, withIdentity: bool): bool {
    var listener = tcpListenAddress(ipv4Loopback(0))
    if (listener.descriptor < 0) return false
    val port = listener.localPort()
    val child = linuxSyscall0(57)
    if (child == 0) {
        var stream = tcpConnectIpv4("127.0.0.1", port, 10000)
        var secured = tlsFailedConnection()
        if (withIdentity) {
            val identity = tlsClientIdentityFromPem(path(certificate).readText(), path(key).readText())
            secured = tlsUpgradeWithIdentity(stream, "localhost", identity, caPath = certificate,
                timeoutMilliseconds = 60000, deadline = linuxMonotonicMilliseconds() + 60000)
        } else secured = tlsUpgrade(stream, "localhost", caPath = certificate,
            timeoutMilliseconds = 60000, readWriteTimeoutMilliseconds = 60000)
        val ok = secured.handle != -1 && secured.write("hello") == 5 && secured.read(32) == "world"
        secured.close()
        linuxSyscall1(60, if (ok) 0 else 1)
    }
    if (child < 0 || !linuxPollSocket(listener.descriptor, true, false, 60000).readable) return false
    var stream = listener.accept()
    var secured = tlsServerUpgrade(stream, certificate, key, handshakeTimeoutMilliseconds = 60000)
    val ok = secured.handle != -1 && socketPeerAddress(secured.descriptor()) != null &&
        secured.read(32) == "hello" && secured.write("world") == 5
    secured.close()
    listener.close()
    val result = linuxWaitProcess(child)
    ok && result.status == 0
}

fun main: int {
    val address = addressOf(processArgument(0))
    val certificate = processArgument(1)
    val key = processArgument(2)
    val bundle = processArgument(3)
    val mode = processArgument(4)
    if (mode == "tcp" || mode == "tcp-identity") return if (tcpOnce(certificate, key, mode == "tcp-identity")) 0 else 10
    if (mode == "echo") return if (echoOnce(address, certificate, key, false)) 0 else 1
    if (mode == "inherited") return if (echoOnce(address, certificate, key, true)) 0 else 2
    if (mode == "server-deadline") return if (stalledServer(address, certificate, key)) 0 else 3
    val deadline = if (mode.startsWith("deadline-")) linuxMonotonicMilliseconds() + 250 else 0
    val kind = if (deadline != 0) mode.slice(9, mode.size) else mode
    val start = linuxMonotonicMilliseconds()
    var secured = securedClient(address, certificate, key, bundle, kind, deadline)
    if (deadline != 0) return if (secured.handle == -1 &&
        linuxMonotonicMilliseconds() - start >= 100 &&
        linuxMonotonicMilliseconds() - start < 30000) 0 else 4
    if (mode == "invalid" || mode == "bad-host" || mode == "bad-ca") {
        return if (secured.handle == -1) 0 else 5
    }
    if (secured.handle == -1 || secured.write("hello") != 5 || secured.read(32) != "world") return 6
    if (socketPeerAddress(secured.descriptor()) != null) return 7
    if (secured.close() && secured.close()) 0 else 8
}
