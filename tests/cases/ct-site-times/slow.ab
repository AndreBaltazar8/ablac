// A site that takes over five seconds (it sleeps) and one that takes none (tools/test-ct-site-times.sh): the slow one
// is noted under any tier, and ABLA_COMPILE_EVAL_TIMES=1 lists both, slowest first.
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

fun nap(): int {
    sleep(5200)
    40
}

val napped = #nap()
val quick = #(1 + 1)
fun main: int = napped + quick
