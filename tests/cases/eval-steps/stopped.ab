// A loop the step limit cuts short leaves `count` below 297, and the slice
// after it is then out of range: the evaluator must stop at the limit and
// report it, not go on to the slice.
compile fun cut(): string {
    val text = "abc"
    var count = 0
    while (count < 300) count = count + 1
    text.slice(count - 300, count - 297)
}

fun main: int = if (#cut() == "abc") 42 else 1
