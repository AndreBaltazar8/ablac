// Compile-time work over the evaluator's lookups: a global value read in a
// loop, calls to compile functions, a class built and read, and a local
// shadowed in a nested block. tools/test-eval-steps.sh pins how many
// evaluation steps it takes.
compile val base: int = 3

class Pair(val left: int, val right: int)

compile fun weight(value: int): int = value + base

compile fun total(count: int): int {
    var sum = 0
    var index = 0
    while (index < count) {
        val pair = Pair(index, base)
        sum = sum + weight(pair.left) + pair.right
        if (index % 2 == 0) {
            val sum = 1000
            index = index + sum - sum
        }
        index = index + 1
    }
    sum
}

fun main: int = #total(10)
