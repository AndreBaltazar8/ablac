import "abla/compiler/parser"

compile fun spin(): int {
    var i = 0
    while (i < 2000) i += 1
    2
}

compile fun delayedCursor(cursor: ParserCursor): ParserCursor {
    spin()
    cursor
}

compile fun delayedText(): string {
    spin()
    "real parser failure"
}

compile fun parseStopped(cursor: ParserCursor): SyntaxExpression {
    parserRawTakeName(delayedCursor(cursor))
    syntaxInteger(42)
}

compile fun parseMessage(cursor: ParserCursor): SyntaxExpression {
    parserFail(cursor, delayedText())
    syntaxInteger(42)
}

#compilerRegisterSubparser("stopped", parseStopped)
#compilerRegisterSubparser("message", parseMessage)
