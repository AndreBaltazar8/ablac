// Each generated caller in test-eval-steps.sh stops in the middle of this
// arithmetic. No divisor is zero until an unfinished operand is consumed.
compile fun spin(): int {
    var total = 0
    var i = 0
    while (i < 2000) {
        total = (total + i * 7) % 1000003
        i += 1
    }
    2
}

compile fun consume(value: int): int = 42 / value

fun main: int = #(spin())
