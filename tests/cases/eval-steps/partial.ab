// The step limit stops `spin` before it returns, so the table holds a value
// the evaluator never finished: the compiler reports the limit, and lowering
// the table never hands the backend a missing element.
compile fun spin(): int {
    var count = 0
    while (count < 300) count = count + 1
    count
}

compile fun table(): array<int> = [1, spin()]

val TABLE = #table()

fun main: int = TABLE[0] + TABLE[1] - 259
