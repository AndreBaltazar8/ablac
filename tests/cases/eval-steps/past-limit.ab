// A failure deep in compile-time recursion: the innermost level builds a range, whose elements count steps without
// a check, so the steps pass the step limit by more than one before `evaluate` sees them. The build reports the step
// limit, not a bare E_EVAL_EXPRESSION.
fun deep(depth: int): int {
    if (depth == 0) {
        val items = 0 until 100000
        return items.size
    }
    deep(depth - 1) + 1
}

val counted = #deep(40)

fun main: int = counted
