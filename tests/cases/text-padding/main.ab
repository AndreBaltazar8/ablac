// padStart and padEnd count bytes but never write half a code point: whole code points of the pad, repeated, and the
// next one is left out when it would not fit (up to 3 bytes short). They used to cut the pad at the byte count, which made
// invalid UTF-8 from valid input. Every case also runs under `#`; the two must agree.
import "abla/io"
import "abla/text"

@noinline fun idS(x: string): string = x

fun shown(s: string): string = "${s}|${s.size}|${s.isValidUtf8()}"

fun cases(): array<string> {
    val out: array<string> = []
    out.append("ascii ${shown(idS("ab").padStart(5, "xy"))} ${shown(idS("ab").padEnd(5, "xy"))} ${shown(idS("7").padStart(3, "0"))}")
    out.append("two-byte ${shown(idS("").padStart(3, "é"))} ${shown(idS("").padStart(4, "é"))} ${shown(idS("ab").padEnd(5, "é"))}")
    out.append("three-byte ${shown(idS("ab").padStart(6, "日"))} ${shown(idS("ab").padStart(8, "日"))} ${shown(idS("ab").padEnd(4, "日"))}")
    out.append("four-byte ${shown(idS("").padStart(7, "😀"))} ${shown(idS("a").padEnd(4, "😀"))} ${shown(idS("a").padEnd(5, "😀"))}")
    out.append("mixed ${shown(idS("").padStart(7, "aé日"))} ${shown(idS("").padStart(6, "aé日"))} ${shown(idS("").padEnd(9, "aé日"))}")
    out.append("none ${shown(idS("abc").padStart(3, "é"))} ${shown(idS("abc").padStart(2, "é"))} ${shown(idS("ab").padStart(3, "日"))} ${shown(idS("ab").padStart(-1, "é"))}")
    out.append("empty pad ${shown(idS("ab").padStart(5, ""))} ${shown(idS("").padEnd(3, ""))}")
    out.append("bad pad bytes ${idS("").padStart(3, "\xff").size} ${idS("").padEnd(3, "\xc3").size} ${idS("").padStart(3, "é\xff").size}")
    out.append("unchanged ${shown(idS("héllo").padStart(2))} ${shown(idS("héllo").padEnd(6))} ${shown(idS("héllo").padEnd(8, "é"))}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) bad = 1
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println(line)
    bad
}
