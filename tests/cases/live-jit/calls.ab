// `ablac run --live` calls every function of the program through the live table (live.ab): this
// program must print the same lines with and without it. It reaches functions every way a call
// can: direct, recursive, mutually recursive, by function value, by closure (with captures), from a
// thread, from a generator, from a method, with a struct and a string result (an output parameter)
// and with scalars of each width. Exits 42.
import "abla/io"
import "abla/float/text"

class Point(val x: int, val y: int) {
    fun moved(dx: int): Point = Point(x + dx, y)
}

fun factorial(n: int): int = if (n <= 1) 1 else n * factorial(n - 1)
fun isEven(n: int): bool = if (n == 0) true else isOdd(n - 1)
fun isOdd(n: int): bool = if (n == 0) false else isEven(n - 1)
fun greeting(name: string): string = "hello $name"
fun origin(): Point = Point(1, 2)
fun half(value: f64): f64 = value / 2.0
fun narrow(value: i32): i32 = value + i32(1)
fun apply(f: (int) -> int, value: int): int = f(value)
fun twice(value: int): int = value * 2

fun counted(limit: int): Generator<int> = generator {
    var at = 0
    while (at < limit) {
        yield twice(at)
        at += 1
    }
}

fun main: int {
    println("factorial ${factorial(10)}")
    println("even ${isEven(10)} odd ${isOdd(7)}")
    println(greeting("live"))
    val p = origin().moved(3)
    println("point ${p.x} ${p.y}")
    println("half ${half(5.0)} narrow ${narrow(i32(41))}")
    val f: (int) -> int = twice
    println("value ${f(21)} applied ${apply(twice, 4)}")
    val offset = 7
    val closure: (int) -> int = { value -> twice(value) + offset }
    println("closure ${closure(5)} applied ${apply(closure, 1)}")
    val worker = thread { factorial(5) + twice(1) }
    println("thread ${await worker}")
    var sum = 0
    for (value in counted(5)) sum += value
    println("generator $sum")
    42
}
