// `ablac run --live`: the program edits its own copy (tools/test-live-jit.sh passes the copy's path)
// and redefines its functions while it runs (abla/live). The checks, each a "name: ok|FAIL" line:
// - value() returns 1, then 2 after the reload: called directly, through a function value and a
//   closure made before the reload, and from a thread that was already calling it in a loop;
// - a thread inside slow()'s old body during the reload finishes it on the old code (10), and its
//   next call takes the new body (20);
// - a reload with no change applies nothing;
// - a changed lambda is redefined (stage 3): a closure made before the reload runs the new body, also when
//   the edit changes the lambda's length (which renames it: the reload matches it to the running one), and
//   keeps the captures it was made with;
// - a lambda whose captures change is refused (E_LIVE_LAMBDA, naming the change) and keeps running as it was;
// - a lambda a reload adds, handed to code that was not redefined, runs through the running module's dispatcher
//   (the registry of new lambdas), and one whose closure owns a Token is dropped through its drop dispatcher.
// - a function a reload adds whose runtime id collides with the running program's livetrqwlyjuls: a function value
//   of livetrqwlyjuls made before the reload still calls it, from new code too.
// - a function whose parameters change, never taken as a value, moves to a new entry: a thread inside its old body
//   finishes it the old way, and the edited caller calls the new one.
// - variables a reload adds (an int, an array, a string) are initialized once when it applies, and stay through a
//   collection under stress right after (they are roots).
// - a new variable whose initializer panics fails the reload (E_LIVE_PANIC) and leaves the variables as they were;
//   the next reload, without it, applies.
// Exits 42 when every check passed. Markers are spelled in two pieces in main, so an edit changes only the
// marked line.
import "abla/io"
import "abla/live"
import "abla/text"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"
import "abla/runtime/memory"

var entered: int by TVar(0)
var released: int by TVar(0)
var spun: int by TVar(0)

fun value(): int = 1 // value-marker

fun slow(): int {
    atomic { entered = 1 }
    while (atomic { released } == 0) {
        atomic { spun += 1 }
    }
    10 // slow-marker
}

fun lambdaMaker(): () -> int = { 5 } // lambda-marker

// A lambda with a capture: base + 1 becomes base + 100, which changes the lambda's length.
fun adder(base: int): () -> int = { base + 1 } // adder-marker

// A lambda that starts capturing a second value.
fun shaped(first: int, second: int): () -> int = { first } // shaped-marker

// Calls what it is given: its code is the running program's, so a lambda a reload adds reaches it through the
// running module's dispatcher, which must find the new generation's.
fun applyIt(f: () -> int): int = f()

// Gains a lambda in a reload (an owner with none before), which it hands to applyIt. It allocates before the edit
// too (a string), so main, which calls it, keeps the same roots across the call and is not redefined.
fun fresh(): int = "${value()}".size - 1 // fresh-marker

var dropped: int by TVar(0)

var gaugeEntered: int by TVar(0)
var gaugeReleased: int by TVar(0)

// Its signature changes in a reload while a thread is inside it (nothing takes it as a value).
fun gauge(x: int): int { // gauge-marker
    atomic { gaugeEntered = 1 }
    while (atomic { gaugeReleased } == 0) {}
    x * 2 // gauge-body-marker
}

fun gauged(): int = gauge(5) // gauged-marker

// A reload adds variables here (new-globals-marker) and has fromGlobals() read them: their initializers run once,
// when it applies.
fun fromGlobals(): int = 0 // fromglobals-marker

// new-globals-marker

resource class Token(val id: int) {
    fun drop(): void {
        atomic { dropped += 1 }
        return
    }
}

// Owns the closure it is given and drops it uncalled when it returns (a call would consume it, in the lambda's own
// code): its code is the running program's, so a closure of a lambda a reload adds is dropped through the running
// module's drop dispatcher, which must find the new one's.
fun discardIt(own once: FnOnce() -> int): int = 0

// Two names whose runtime ids collide (the hash of their name, parameters and result): the running program has
// livetrqwlyjuls; a reload adds livekegiafmcsp, which would win the id (its symbol sorts first) and leave a
// function value of livetrqwlyjuls made before the reload calling livekegiafmcsp. A reload keeps the running
// program's ids and gives a function it adds another.
fun livetrqwlyjuls(): int = 2

// new-function-marker

// Calls the function value it is given; a reload makes it hand the new function to applyIt too.
fun viaNew(f: () -> int): int = f() // via-marker

// Gains a lambda that captures a Token, handed to discardIt (an array: it allocates before the edit too).
fun freshDrop(): int {
    return [value()].size - 1 // drop-marker
}

var failures = 0

fun check(name: string, ok: bool, detail: string): void {
    println("$name: ${if (ok) "ok" else "FAIL"} ($detail)")
    if (!ok) failures += 1
    return
}

fun edit(path: string, from: string, to: string): bool {
    val source = Path(path).readText()
    if (!source.contains(from)) return false
    Path(path).writeText(source.replace(from, to))
}

fun main: int {
    val path = linuxArgument(linuxArgumentCount() - 1)
    check("live available", liveAvailable(), path)
    // Without live mode (--no-live) nothing below can pass, and the watcher would wait out its two minutes while a
    // thread spins in slow(): 125 CPU-seconds of the suite for a line the test doesn't read.
    if (!liveAvailable()) return 1
    val f: () -> int = value
    val closure: () -> int = { value() * 1 }
    val made = lambdaMaker()
    val added = adder(5)
    val kept = shaped(3, 4)
    check("before", value() == 1 && f() == 1 && closure() == 1, "${value()}")
    // applyIt is the running program's (its own code calls what it is given) before any reload.
    check("apply before", applyIt(f) == 1, "${applyIt(f)}")
    val collided: () -> int = livetrqwlyjuls
    check("via before", viaNew(collided) == 2, "")
    val first = Token(1)
    check("consume before",
        discardIt(move { first.id }) == 0 && atomic { dropped } == 1 && freshDrop() == 0, "")
    val watcher = thread {
        // A bound in time, not rounds: under a loaded machine the reload's compile can outlast billions of rounds
        // (a --fast loop runs them in seconds). Two minutes at a millisecond a round.
        var rounds = 0
        while (value() == 1 && rounds < 120000) {
            linuxSleep(1)
            rounds += 1
        }
        value()
    }
    val inside = thread {
        val first = slow()
        val second = slow()
        first * 100 + second
    }
    while (atomic { entered } == 0) {}
    check("edit value and slow", edit(path, "= 1 // value-" + "marker",
        "= 2 // value-" + "marker") &&
        edit(path, "10 // slow-" + "marker", "20 // slow-" + "marker"), path)
    val applied = liveReload()
    check("reload applied", applied.applied(), applied.message)
    // Two compiles of an unchanged function give the same code: only the two edited ones are redefined.
    val words = applied.message.split(" ")
    var named = 0
    for (word in words) if (word == "value" || word == "slow") named += 1
    check("only the edited functions", words.size == 3 && named == 2, applied.message)
    check("direct", value() == 2, "${value()}")
    check("function value", f() == 2, "${f()}")
    check("closure", closure() == 2, "${closure()}")
    check("thread already calling", await watcher == 2, "")
    atomic { released = 1 }
    val pair = await inside
    check("inside the old body, then the new", pair == 1020, "$pair")
    val unchanged = liveReload()
    check("nothing changed", unchanged.applied() && unchanged.message.contains("nothing changed"),
        unchanged.message)
    check("edit lambda", edit(path, "{ 5 } // lambda-" + "marker", "{ 6 } // lambda-" + "marker"),
        path)
    val lambda = liveReload()
    check("lambda applied", lambda.applied(), lambda.message)
    check("closure made before takes the new lambda", made() == 6 && lambdaMaker()() == 6,
        "${made()}")
    check("edit lambda length", edit(path, "{ base + 1 } // adder-" + "marker",
        "{ base + 100 } // adder-" + "marker"), path)
    val longer = liveReload()
    check("renamed lambda applied", longer.applied(), longer.message)
    check("closure made before, captures kept", added() == 105 && adder(7)() == 107, "${added()}")
    check("edit captures", edit(path, "= { first } // shaped-" + "marker",
        "= { first + second } // shaped-" + "marker"), path)
    val shape = liveReload()
    check("capture change refused", shape.refused() && shape.message.contains("E_LIVE_LAMBDA") &&
        shape.message.contains("captures") && shape.message.contains("second"), shape.message)
    check("lambda kept after the refusal", kept() == 3 && shaped(3, 4)() == 3, "${kept()}")
    // Undo the refused edit, then add a lambda: the running code calls it through its own dispatcher.
    check("undo captures", edit(path, "= { first + second } // shaped-" + "marker",
        "= { first } // shaped-" + "marker"), path)
    check("add a lambda", edit(path, ".size - 1 // fresh-" + "marker",
        ".size * 0 + applyIt({ 21 }) * 2 // fresh-" + "marker"), path)
    val adding = liveReload()
    check("new lambda applied", adding.applied() && !adding.message.contains("applyIt"),
        adding.message)
    check("new lambda through the running dispatcher", fresh() == 42, "${fresh()}")
    check("add a dropped lambda", edit(path, "return [value()].size - 1 // drop-" + "marker",
        "val token = Token(7); return [value()].size * 0 + discardIt(move { token.id }) + 7 // drop-" +
        "marker"), path)
    val dropping = liveReload()
    check("dropped lambda applied", dropping.applied() && !dropping.message.contains("discardIt"),
        dropping.message)
    val tokenId = freshDrop()
    check("new lambda dropped through the running dispatcher",
        tokenId == 7 && atomic { dropped } == 2,
        "$tokenId, dropped ${atomic { dropped }}")
    check("add a colliding function",
        edit(path, "// new-function-" + "marker",
            "fun livekegiafmcsp(): int = 1 // new-function-" + "marker") &&
            edit(path, "= f() // via-" + "marker",
                "= f() + applyIt(livekegiafmcsp) * 10 // via-" + "marker"),
        path)
    val colliding = liveReload()
    check("colliding function applied", colliding.applied(), colliding.message)
    val through = viaNew(collided)
    check("a value made before keeps its body", through == 12 && collided() == 2,
        "$through, ${collided()}")
    // A changed signature of a function the program never takes as a value applies: gauge() gains a parameter
    // while a thread is inside its old body, and gauged(), its caller, is edited to pass it.
    val gauging = thread { gauged() }
    while (atomic { gaugeEntered } == 0) {}
    check("edit a signature",
        edit(path, "fun gauge(x: int): int { // gauge-" + "marker",
            "fun gauge(x: int, y: int): int { // gauge-" + "marker") &&
        edit(path, "    x * 2 // gauge-body-" + "marker", "    x * y // gauge-body-" + "marker") &&
        edit(path, "= gauge(5) // gauged-" + "marker", "= gauge(5, 3) // gauged-" + "marker"), path)
    val signed = liveReload()
    check("signature applied", signed.applied() && signed.message.contains("gauge"), signed.message)
    atomic { gaugeReleased = 1 }
    val old = await gauging
    check("a thread in the old body finishes it the old way", old == 10, "$old")
    check("the new signature from then on", gauged() == 15, "${gauged()}")
    // New variables: an int, an array and a string, read by an edited function. Their initializers run when the
    // reload applies; under collection stress, with a collection right after, the array and the string survive
    // (the reload published them as roots).
    check("add variables",
        edit(path, "// new-globals-" + "marker", "var counter = 40\nval table: array<int> = [1, 2, 3]\n" +
            "val word = \"fre\" + \"sh\"\n// new-globals-" + "marker") &&
        edit(path, "= 0 // fromglobals-" + "marker",
            "= counter + table.size - 1 + word.size - 5 + table[2] - 3 // fromglobals-" + "marker"), path)
    val globals = liveReload()
    check("variables applied", globals.applied() && globals.message.contains("fromGlobals"), globals.message)
    runtimeMemorySetStress(true)
    runtimeMemoryCollect()
    val read = fromGlobals()
    val churn: array<string> = []
    var round = 0
    while (round < 200) {
        churn.append("round $round")
        round += 1
    }
    runtimeMemoryCollect()
    val again = fromGlobals()
    runtimeMemorySetStress(false)
    check("the new variables initialized, kept by a collection", read == 42 && again == 42 && churn.size == 200,
        "$read, $again")
    // A new variable whose initializer panics: the reload fails (E_LIVE_PANIC), its generation goes, and the
    // program's variables are as they were; the next reload, without it, applies.
    check("add a variable that panics",
        edit(path, "// new-globals-" + "marker", "val broken: int = [7][counter - 37]\n// new-globals-" + "marker") &&
        edit(path, "+ table[2] - 3 // fromglobals-" + "marker", "+ table[2] - 3 + broken * 0 // fromglobals-" + "marker"),
        path)
    val panicking = liveReload()
    check("a panicking initializer fails the reload", panicking.failed() &&
        panicking.message.contains("E_LIVE_PANIC") && panicking.message.contains("broken"), panicking.message)
    check("the variables as they were", fromGlobals() == 42, "${fromGlobals()}")
    check("then without it",
        edit(path, "val broken: int = [7][counter - 37]\n", "val after = 1\n") &&
        edit(path, "+ broken * 0 // fromglobals-" + "marker", "+ after - 1 // fromglobals-" + "marker"), path)
    val recovered = liveReload()
    check("the next reload applies", recovered.applied() && fromGlobals() == 42,
        "${recovered.message}: ${fromGlobals()}")
    if (failures == 0) 42 else 1
}
