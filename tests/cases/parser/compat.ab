extern:"c" fun printf(format: string): int

fun max(a: int, b: int): int = if (a > b) a else b

class Counter(var value: int) {
    fun increment(by: int = 1): int {
        value = value + by
        value
    }
}

compile fun announce(name: string) {
    printf("compiling $name\n")
}

fun main: int {
    #announce("compat")
    val values: array<int> = [1, 2, 3]
    var index = 0
    while (index < 3) {
        index = index + 1
    }
    when (max(values[0], values[1])) {
        2 -> Counter(2).increment()
        else -> 0
    }
}

