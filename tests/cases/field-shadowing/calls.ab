// A call goes to the first level (local, receiver member, top-level) with a
// candidate that takes it. The shapes are from a real program: an array field
// named like a math function, a 0-argument method named like a conversion, a
// method of another arity named like a top-level function, a 1-argument
// extension method named like a conversion (a conversion's name always means
// the conversion; `this.u32(v)` calls the method).
import "abla/io"
import "abla/math"
import "abla/float"

fun lerp(a: f64, b: f64, t: f64): f64 = a + (b - a) * t
fun scale(x: int): int = x * 10

class StaticWorld(val cos: array<f64>, val sin: array<f64>) {
    fun turn(i: int, yaw: f64): void {
        this.cos[i] = cos(yaw)
        this.sin[i] = sin(yaw)
        return
    }
}

class ByteReader(val word: int) {
    fun u32(): int = word
    fun widened(): u32 = u32(this.u32())
}

class GpuBytes(val words: array<int>)

fun GpuBytes.u32(value: int): void {
    this.words.append(value & 4294967295)
    return
}

fun GpuBytes.u32At(offset: int): int = this.words[offset]

fun GpuBytes.f32At(offset: int): f64 = f32ToF64(f32FromBits(u32(this.u32At(offset))))

fun GpuBytes.put(value: int): int {
    this.u32(value)
    this.words.size
}

class Vec3(val x: f64) {
    fun lerp(other: Vec3, t: f64): Vec3 = Vec3(lerp(x, other.x, t))
}

class Camera(val scale: int) {
    fun bump(): int = 7
    fun calc(v: int): int = scale(v) + scale + bump()
}

fun main: int {
    val world = StaticWorld([0.5], [0.5])
    world.turn(0, 0.0)
    val wide = ByteReader(40).widened()
    val mid = Vec3(0.0).lerp(Vec3(10.0), 0.5)
    var score = 0
    if (world.cos[0] == 1.0 && world.sin[0] == 0.0) score = score + 10
    if (wide == u32(40)) score = score + 10
    if (mid.x == 5.0) score = score + 10
    if (Camera(2).calc(1) == 19) score = score + 10
    val bytes = GpuBytes([])
    // 0x3fc00000 is 1.5 as an f32.
    if (bytes.put(1069547520) == 1 && bytes.f32At(0) == 1.5) score = score + 2
    println("$score")
    score
}
