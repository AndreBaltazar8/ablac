// A local or field is itself, whatever top-level binding of another module
// shares its name: a global `var flag` beside a class with a field `flag` (here
// and in an imported module), a global `closed` beside the standard library's
// classes with a `closed` field, a global delegate `level` beside a method
// reading its field `level`, a method assigning its field `limit` beside a
// global `val limit`, a `compile val registry` beside the runtime's own
// `registry` locals, a thread declaring its own `var counter`.
import "abla/io"
import "box.ab"

class Local(var flag: bool) {
    fun toggle(): void {
        if (!flag) flag = true
        return
    }
}

class Fixed(val current: int) {
    fun getValue(): int = current
}

class Gauge(var level: int) {
    fun show(): int = level
}

class Meter(var limit: int) {
    fun raise(): int {
        limit = limit + 1
        limit
    }
}

class Registry(val names: array<string>)

compile val registry = Registry([])

compile fun register(name: string): void {
    registry.names.append(name)
    return
}

compile fun registered(): int = registry.names.size

#register("alpha")
#register("beta")

var counter = 0
val limit = 5
var flag = 0
var closed = 40
val level by Fixed(99)

fun main: int {
    val local = Local(false)
    local.toggle()
    val imported = Box(false)
    imported.toggle()
    val worker = thread {
        var counter = 20
        counter = counter + 1
        counter
    }
    val threaded = await worker
    flag += 1
    closed += 1
    if (local.flag && imported.flag && flag == 1 && closed == 41 &&
        Gauge(1).show() == 1 && level == 99 && Meter(1).raise() == 2 &&
        limit == 5 && #registered() == 2 && threaded == 21 && counter == 0) 42 else 1
}
