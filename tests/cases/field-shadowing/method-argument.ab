// `reset(1)` fits no level: the method of that name takes a string and no
// top-level declaration has the name, so the error is about the method.
class Counter(var count: int) {
    fun reset(note: string): void {
        count = note.size
        return
    }
    fun bump(): int {
        reset(1)
        count
    }
}

fun main: int = Counter(3).bump()
