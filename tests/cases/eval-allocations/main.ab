// Compile-time work for the interpreter's allocation budget (tools/test-eval-allocations.sh): integers past the shared small ones, text built up a
// byte at a time, returns, objects and moved values. The result is printed by the program, so a change that shares values still computes the same.
import "abla/io"

class Box(val value: int)

fun mix(left: int, right: int): int {
    if (right > 1000000000) return left
    return (left * 7919 + right) % 100003
}

fun steps(count: int): int {
    var total = 0
    var index = 0
    while (index < count) {
        total = total + mix(index, total % 1000)
        index = index + 1
    }
    return total
}

fun label(count: int): string {
    var text = ""
    for (index in 0 until count) text = text + "x"
    return text
}

fun boxes(count: int): int {
    var total = 0
    for (index in 0 until count) {
        val box = Box(index * 3000)
        total = total + box.value
    }
    total
}

val stepped = #steps(20000)
val labelled = #label(300)
val boxed = #boxes(5000)

fun main: int {
    println("$stepped ${labelled.size} $boxed")
    0
}
