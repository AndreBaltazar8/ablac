// Wycheproof's RSASSA-PSS verification vectors (tests/vectors/crypto/wycheproof, as published: JSON) through
// abla/crypto/rsapss, and signing and refusals on a fixed key. Prints a count per file; exit 1 on any failure.
// Usage: vectors VECTORS_DIRECTORY
import "abla/io"
import "abla/crypto"
import "abla/crypto/rsa"
import "abla/crypto/rsapss"
import "abla/integer"
import "abla/json"
import "abla/process/arguments"
import "abla/sys/linux"

var failures = 0

fun fail(file: string, number: int, why: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL $file test $number: $why")
    return
}

fun checkFile(directory: string, name: string): int {
    val parsed = jsonParse(linuxReadFile("$directory/wycheproof/$name", 16777216))
    if (!parsed.succeeded) {
        fail(name, 0, "the JSON did not parse: ${parsed.error.message}")
        return 0
    }
    val root = parsed.value
    var count = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val key = rsaPublicKeyFromDer(hexDecode(group.getString("publicKeyDer")))
        if (!key.ok()) {
            fail(name, 0, "the key did not parse: ${key.error}")
            continue
        }
        // "SHA-256" and the like.
        val sha = group.getString("sha")
        val bits = (sha.slice(4, sha.size).parseInt()) ?? 0
        if (group.getString("mgfSha") != sha) fail(name, 0, "MGF1 over another hash")
        val saltLength = group.getInt("sLen")
        val tests = group.get("tests")
        for (t in 0 until tests.size()) {
            val test = tests.at(t)
            val number = test.getInt("tcId")
            val result = test.getString("result")
            val accepted = rsaPssVerify(key, bits, hexDecode(test.getString("msg")), hexDecode(test.getString("sig")), saltLength)
            if (result == "valid" && !accepted) fail(name, number, "a valid signature was refused: ${test.getString("comment")}")
            else if (result == "invalid" && accepted) fail(name, number, "an invalid one was accepted: ${test.getString("comment")}")
            else if (result != "valid" && result != "invalid") fail(name, number, "result $result")
            count = count + 1
        }
    }
    count
}

fun main: int {
    val directory = processArgument(0)
    for (name in [
        "rsa_pss_2048_sha256_mgf1_32_test.json", "rsa_pss_2048_sha256_mgf1_0_test.json",
        "rsa_pss_3072_sha256_mgf1_32_test.json", "rsa_pss_4096_sha512_mgf1_32_test.json"
    ]) println("$name ${checkFile(directory, name)}")
    println("failures $failures")
    if (failures == 0) 0 else 1
}
