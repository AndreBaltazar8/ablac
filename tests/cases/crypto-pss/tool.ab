// abla/crypto/rsapss on the command line, for peer.mjs; keys are PEM files, data hexadecimal. Prints hexadecimal,
// "yes"/"no", or "refused: why" (exit 3):
//   tool sign PRIVATE_PEM HASH_BITS MESSAGE SALT       tool sign-random PRIVATE_PEM HASH_BITS MESSAGE [SALT_LENGTH]
//   tool verify PUBLIC_PEM HASH_BITS SALT_LENGTH MESSAGE SIGNATURE
// "-" is an empty message or salt.
import "abla/io"
import "abla/crypto"
import "abla/crypto/rsa"
import "abla/crypto/rsapss"
import "abla/integer"
import "abla/process/arguments"
import "abla/sys/linux"

fun arg(index: int): string = processArgument(index)
fun number(index: int): int = arg(index).parseInt() ?? 0
fun file(index: int): string = linuxReadFile(arg(index), 16777216)
fun data(index: int): string = if (arg(index) == "-") "" else hexDecode(arg(index))

fun show(result: CryptoResult): int {
    if (!result.ok) {
        println("refused: ${result.error}")
        return 3
    }
    println(hexEncode(result.bytes))
    0
}

fun main: int {
    val op = arg(0)
    if (op == "sign") return show(rsaPssSignWithSalt(rsaPrivateKeyFromPem(file(1)), number(2), data(3), data(4)))
    if (op == "sign-random") {
        val length: int? = if (processArgumentCount() > 4) number(4) else null
        return show(rsaPssSign(rsaPrivateKeyFromPem(file(1)), number(2), data(3), length))
    }
    if (op == "verify") {
        val ok = rsaPssVerify(rsaPublicKeyFromPem(file(1)), number(2), data(4), data(5), number(3))
        println(if (ok) "yes" else "no")
        return if (ok) 0 else 3
    }
    println("refused: unknown operation")
    2
}
