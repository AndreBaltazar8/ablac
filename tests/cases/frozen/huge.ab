import "abla/io"
import "abla/memory"
import "abla/runtime/memory"

// A freeze whose bytes would not fit the window is refused (reason 2), the value returned whole: four ropes of 2^62 bytes
// (no memory behind them, a rope names its length) count their flat lengths, which summed past 2^64 and wrapped to a few
// bytes; the flattening then wrote past the group's pages ("bad memory access" in the window). A small freeze still works
// after it.
fun huge(seed: string): string {
    var text = seed
    for (step in 0 until 62) text = "$text$text"
    text
}

fun main: int {
    val parts = [huge("a"), huge("b"), huge("c"), huge("d")]
    val kept = Frozen(parts).get()
    val reason = memoryHeapStat(12)
    if (kept.size != 4 || kept[3].size != 4611686018427387904 || reason != 2) {
        println("FAIL: ${kept.size} parts, reason $reason")
        return 1
    }
    val small = Frozen(["after", "it"]).get()
    if (small.size != 2 || small[0] != "after") {
        println("FAIL: a small freeze after the refusal")
        return 1
    }
    println("frozen huge ok: refused with reason $reason")
    0
}
