// Threads freeze graphs of their own, read them, and force collections, all at once: a freeze runs under the collector's
// own stop (the other threads park at a safe point), groups are made and returned from several threads, and a thread
// that reads a group while another collects sees it whole.
import "abla/io"
import "abla/memory"
import "abla/runtime/memory"

class Entry(val name: string, val numbers: array<int>)

fun entries(count: int, salt: int): array<Entry> {
    val list: array<Entry> = []
    var index = 0
    while (index < count) {
        list.append(Entry("entry${index}/${salt}", [index, salt, index * salt]))
        index = index + 1
    }
    list
}

fun sum(list: array<Entry>): int {
    var total = 0
    for (entry in list) total = total + entry.name.size + entry.numbers[2]
    total
}

fun worker(salt: int): int {
    val mine = Frozen(entries(2500, salt)).get()
    val expected = sum(mine)
    var round = 0
    var ok = 0
    while (round < 30) {
        val garbage = entries(800, round)
        if (garbage.size == 800 && sum(mine) == expected) ok = ok + 1
        if (round % 3 == 0) memoryCollect()
        if (round % 10 == 5) {
            val extra = Frozen(entries(600, round + salt)).get()
            if (sum(extra) == sum(entries(600, round + salt))) ok = ok + 1
        }
        round = round + 1
    }
    ok
}

fun main: int {
    val one = thread { worker(3) }
    val two = thread { worker(5) }
    val three = thread { worker(7) }
    val mine = worker(11)
    val good = mine + (await one) + (await two) + (await three)
    if (good != 4 * 33) {
        println("FAIL: $good of ${4 * 33}")
        return 1
    }
    memoryCollect()
    println("frozen threads ok: $good")
    0
}
