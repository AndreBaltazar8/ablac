// More live groups than the table holds (1024): the freezes past it are refused, and a refusal hands the value back
// unchanged, still whole and readable, never a crash. Once the groups are dropped the table is free again.
import "abla/io"
import "abla/memory"
import "abla/runtime/memory"

class Item(val name: string, val numbers: array<int>)

fun makeItems(seed: int): array<Item> {
    val items: array<Item> = []
    var index = 0
    while (index < 5) {
        items.append(Item("item${seed}/${index}", [seed, index, seed * index]))
        index = index + 1
    }
    items
}

fun check(items: array<Item>, seed: int): bool {
    var index = 0
    while (index < 5) {
        if (items[index].name != "item${seed}/${index}" || items[index].numbers[2] != seed * index) return false
        index = index + 1
    }
    items.size == 5
}

fun main: int {
    val kept: array<array<Item>> = []
    var frozen = 0
    var refused = 0
    var seed = 0
    while (seed < 1300) {
        val before = memoryHeapStat(11)
        val items = Frozen(makeItems(seed)).get()
        if (memoryHeapStat(11) > before) frozen = frozen + 1 else refused = refused + 1
        kept.append(items)
        seed = seed + 1
    }
    memoryCollect()
    memoryCollect()
    var bad = 0
    seed = 0
    while (seed < 1300) {
        if (!check(kept[seed], seed)) bad = bad + 1
        seed = seed + 1
    }
    if (bad > 0 || refused == 0 || frozen > 1024) {
        println("FAIL: $frozen frozen, $refused refused, $bad wrong")
        return 1
    }
    kept.clear()
    memoryCollect()
    memoryCollect()
    val before = memoryHeapStat(11)
    val again = Frozen(makeItems(7)).get()
    if (memoryHeapStat(11) <= before || !check(again, 7)) {
        println("FAIL: the table did not recover after the groups were dropped")
        return 1
    }
    println("frozen limits ok: $frozen frozen, $refused refused")
    0
}
