// Groups are returned whole when nothing reaches them, and their address space is reused: freezing a graph more times than the
// window could hold at once (a 64 MiB window at the smallest, 1 GiB usually) never runs out, and the frozen bytes do not climb.
import "abla/io"
import "abla/memory"
import "abla/runtime/memory"

class Row(val name: string, val values: array<int>)

fun makeRows(count: int): array<Row> {
    val rows: array<Row> = []
    var index = 0
    while (index < count) {
        rows.append(Row("row${index}", [index, index + 1, index + 2, index + 3]))
        index = index + 1
    }
    rows
}

fun main: int {
    var refused = 0
    var frozenRounds = 0
    var highest = 0
    var total = 0
    var round = 0
    while (round < 400) {
        val rows = makeRows(20000)
        val before = memoryHeapStat(11)
        val frozen = Frozen(rows).get()
        val after = memoryHeapStat(11)
        if (after > before) frozenRounds = frozenRounds + 1 else refused = refused + 1
        if (after > highest) highest = after
        total = total + frozen.size + frozen[19999].values[3]
        memoryCollect()
        memoryCollect()
        round = round + 1
    }
    memoryCollect()
    memoryCollect()
    val left = memoryHeapStat(11)
    // Each group is a few MB; 400 of them would be over a GiB if none were returned.
    if (refused > 0 || highest > 400000000 || left > 20000000) {
        println("FAIL: refused $refused of 400, highest $highest bytes at once, $left left at the end")
        return 1
    }
    println("frozen churn ok: $frozenRounds groups, highest $highest, left $left, total $total")
    0
}
