// A store into a frozen object faults at once (the group's pages are read-only): never a silent write. tools/test-frozen.sh
// expects this program to die of the fault, after printing `before` and not `after`.
import "abla/io"
import "abla/runtime/memory"

class Counter(var count: int, val label: string)

fun main: int {
    val frozen = Frozen(Counter(1, "label" + "${7}")).get()
    println("before ${frozen.count}")
    frozen.count = 2
    println("after ${frozen.count}")
    0
}
