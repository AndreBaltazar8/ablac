// A forked child reads a frozen graph, collects, and freezes another one: the group table and the read-only pages come
// through the fork (libc's fork, as tests/cases/fork-heap).
import "abla/io"
import "abla/memory"
import "abla/runtime/memory"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

noescape extern:"c" fun fork(): i32
noescape extern:"c" fun waitpid(pid: i32, status: i64*, options: i32): i32
noescape extern:"c" fun _exit(status: int): void

class Item(val name: string, val values: array<int>)

fun items(count: int, salt: int): array<Item> {
    val list: array<Item> = []
    var index = 0
    while (index < count) {
        list.append(Item("item${index}", [index, salt]))
        index = index + 1
    }
    list
}

fun total(list: array<Item>): int {
    var sum = 0
    for (item in list) sum = sum + item.values[0] + item.values[1] + item.name.size
    sum
}

fun child(parent: array<Item>, expected: int): int {
    memoryCollect()
    val again = Frozen(items(2000, 9)).get()
    memoryCollect()
    if (total(parent) == expected && total(again) == total(items(2000, 9))) 0 else 3
}

trusted fun main: int {
    val status = nativeStaticAllocate(8)
    val parent = Frozen(items(5000, 7)).get()
    val expected = total(parent)
    var failures = 0
    var forks = 0
    while (forks < 20) {
        val process = fork()
        if (process == 0) _exit(child(parent, expected))
        if (process < 0) return 4
        ablaRuntimeStoreI64(status, 0)
        val waited = waitpid(process, nativePointerFromAddress(status), 0)
        val code = ablaRuntimeLoadI64(status) & 4294967295
        if (waited != process || code != 0) {
            failures = failures + 1
            println("child ${forks}: waited ${waited} status ${code}")
        }
        forks = forks + 1
        memoryCollect()
    }
    if (failures != 0 || total(parent) != expected) return 1
    println("frozen fork ok: $forks")
    0
}
