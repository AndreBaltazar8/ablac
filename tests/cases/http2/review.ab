// Review of the HTTP/2 server (43874f76), regression cases (tools/test-http2-review.sh): each fails today; prints
// "http2 review ok" when all pass. Helpers as in tests/cases/http2/server.ab.
import "abla/io"
import "abla/crypto"
import "abla/array"
import "abla/integer"
import "abla/http"
import "abla/http/h2"
import "abla/http/h2/hpack"
import "abla/http/h2/server"
import "abla/text"
import "abla/memory"

var failures = 0

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL $what")
    return
}

fun expect(cond: bool, what: string): void {
    if (!cond) fail(what)
    return
}

fun be32(value: int): string = cryptoByteString([(value >> 24) & 255, (value >> 16) & 255, (value >> 8) & 255, value & 255])

fun frame(kind: int, flags: int, stream: int, payload: string): string {
    val n = payload.size
    cryptoByteString([(n >> 16) & 255, (n >> 8) & 255, n & 255, kind, flags, (stream >> 24) & 127, (stream >> 16) & 255, (stream >> 8) & 255, stream & 255]) + payload
}

class Seen(val kind: int, val flags: int, val stream: int, val payload: string)

fun frames(output: string): array<Seen> {
    val list: array<Seen> = []
    var at = 0
    while (at + 9 <= output.size) {
        val n = (output[at] << 16) | (output[at + 1] << 8) | output[at + 2]
        list.append(Seen(output[at + 3], output[at + 4], ((output[at + 5] & 127) << 24) | (output[at + 6] << 16) | (output[at + 7] << 8) | output[at + 8], output.slice(at + 9, at + 9 + n)))
        at = at + 9 + n
    }
    list
}

fun count(list: array<Seen>, kind: int): int {
    var n = 0
    for (s in list) {
        if (s.kind == kind) n = n + 1
    }
    n
}

fun goawayCode(list: array<Seen>): int {
    for (s in list) {
        if (s.kind == 7) return (s.payload[4] << 24) | (s.payload[5] << 16) | (s.payload[6] << 8) | s.payload[7]
    }
    -1
}

fun resetCode(list: array<Seen>, stream: int): int {
    for (s in list) {
        if (s.kind == 3 && s.stream == stream) return (s.payload[0] << 24) | (s.payload[1] << 16) | (s.payload[2] << 8) | s.payload[3]
    }
    -1
}

fun hf(name: string, value: string): HpackField = HpackField(name, value, false)

fun block(fields: array<HpackField>): string {
    var e = hpackEncoderNew(0)
    e.encode(fields)
}

fun getFields(path: string): array<HpackField> = [hf(":method", "GET"), hf(":scheme", "https"), hf(":path", path), hf(":authority", "example.com")]

/** A server past the preface and SETTINGS, its first output taken. */
fun ready(): H2Server {
    var s = h2ServerNew()
    s.feed(H2_PREFACE + frame(4, 0, 0, ""), 0)
    s.takeOutput()
    s
}

fun has(list: array<Seen>, kind: int): bool = count(list, kind) > 0


// H1 (medium). Response HEADERS are queued whatever the output holds: a client that never reads makes a server answer
// HEAD requests (each ends its stream at once, so no stream limit applies) into a queue without bound. Expected: the
// server stops taking requests (or closes) once its output passes a few times H2_OUTPUT_CAP.
fun unreadOutput(): void {
    // A 1 KiB header per response (HPACK indexes it once, so: a 1 KiB value that changes per response).
    val base = "p".repeat(1000)
    var s = ready()
    var id = 1
    var now = 0
    while (id < 40000 && !s.closed) {
        s.feed(frame(1, 5, id, block([hf(":method", "HEAD"), hf(":scheme", "https"), hf(":path", "/"), hf(":authority", "x")])), now)
        val pad = base + "$id"
        for (request in s.takeRequests()) s.respond(request.stream, 200, [HttpHeader("x-pad", pad)], "")
        id = id + 2
        if (id % 2001 == 0) now = now + 1000
    }
    if (!s.closed && s.outputBytes > 4 * H2_OUTPUT_CAP) {
        fail("H1: 20000 HEAD requests with 1 KiB responses never read: ${s.outputBytes} bytes of output queued, the connection open")
    }
    return
}

// H2 (medium, CVE-2025-8671 "MadeYouReset"). A stream the server resets itself (here: WINDOW_UPDATE with increment 0 on
// an open stream) frees its slot but its request was already handed out: the reset budget counts client RST_STREAM only.
// Expected: at most the stream limit of requests from such a burst, or ENHANCE_YOUR_CALM/GOAWAY.
fun madeYouReset(): void {
    var s = ready()
    var burst = ""
    var id = 1
    while (id < 600) {
        burst = burst + frame(1, 5, id, block(getFields("/"))) + frame(8, 0, id, be32(0))
        id = id + 2
    }
    s.feed(burst, 0)
    val handed = s.takeRequests().size
    val out = frames(s.takeOutput())
    if (handed > 100 && !has(out, 7) && !s.closed) fail("H2: 300 HEADERS + WINDOW_UPDATE(0) pairs: $handed requests handed out, no GOAWAY")
    return
}

// H3 (medium). RFC 9113 8.2.1: a field value with NUL, CR or LF (or leading/trailing whitespace) makes the request
// malformed (stream error PROTOCOL_ERROR). Today it reaches HttpRequest's headers (header injection when reflected or
// forwarded over HTTP/1).
fun crlfValue(): void {
    var s = ready()
    val fields = getFields("/")
    fields.append(hf("x-a", "v\r\nInjected: 1"))
    s.feed(frame(1, 5, 1, block(fields)), 0)
    val handed = s.takeRequests().size
    val out = frames(s.takeOutput())
    if (handed != 0 || resetCode(out, 1) != 1) fail("H3: a field value with CRLF: $handed requests, reset code ${resetCode(out, 1)} (wanted PROTOCOL_ERROR)")
    var t = ready()
    val named = getFields("/")
    named.append(hf("x a", "v"))
    t.feed(frame(1, 5, 1, block(named)), 0)
    if (t.takeRequests().size != 0) fail("H3: a field name with a space was accepted")
    return
}

// H4 (medium). The receive window is given back as DATA arrives, not as the handler takes the body: 100 streams each
// buffer up to maximumBodyBytes before END_STREAM. Expected (a proposal: some per-connection budget): the server does
// not credit more than 16 MiB of request bodies no handler has taken.
fun bufferedBodies(): void {
    var s = h2ServerNew()
    s.feed(H2_PREFACE + frame(4, 0, 0, ""), 0)
    s.takeOutput()
    val piece = "a".repeat(16384)
    var credited = 0
    var peak = 0
    var stream = 1
    while (stream < 200) {
        val post = [hf(":method", "POST"), hf(":scheme", "https"), hf(":path", "/"), hf(":authority", "x")]
        s.feed(frame(1, 4, stream, block(post)), 0)
        var sent = 0
        while (sent + 16384 < 512 * 1024 && !s.closed) {
            s.feed(frame(0, 0, stream, piece), 0)
            sent = sent + 16384
            if (s.bufferedBytes > peak) peak = s.bufferedBytes
            for (f in frames(s.takeOutput())) {
                if (f.kind == 8 && f.stream == 0) credited = credited + ((f.payload[0] & 127) << 24 | f.payload[1] << 16 | f.payload[2] << 8 | f.payload[3])
            }
        }
        stream = stream + 2
    }
    // The memory bound is what matters: bytes credited over time may exceed it (a stream that is reset frees its share and its window is returned), but what is buffered at once may not (the budget is 8 MiB, and one stream window of overshoot).
    if (peak > 8 * 1048576 + 262144 + 16384) fail("H4: 100 streams of unfinished bodies: $peak bytes buffered at once (budget 8 MiB), $credited credited over the run")
    return
}

// H6 (low). A body over the limit gets 413, but the stream stays while the response waits for window, and trailers then
// end the request: the handler gets the truncated body as if complete.
fun bodyAfter413(): void {
    var s = h2ServerNew(100, 10)
    s.feed(H2_PREFACE + frame(4, 0, 0, cryptoByteString([0, 4, 0, 0, 0, 0])), 0)
    s.takeOutput()
    s.feed(frame(1, 4, 1, block([hf(":method", "POST"), hf(":scheme", "https"), hf(":path", "/"), hf(":authority", "x")])), 0)
    s.feed(frame(0, 0, 1, "0123456789"), 0)
    s.feed(frame(0, 0, 1, "x"), 0)
    s.feed(frame(1, 5, 1, block([hf("x-t", "1")])), 0)
    val handed = s.takeRequests()
    if (handed.size != 0) fail("H6: a body over the limit (413) reached the handler, truncated: ${handed.size} request(s)")
    return
}

// H7 (low): rule deviations.
fun deviations() {
    // A lower stream id than one already opened was never opened by the client: PROTOCOL_ERROR (RFC 9113 5.1.1), not STREAM_CLOSED.
    var s = ready()
    s.feed(frame(1, 5, 5, block(getFields("/"))), 0)
    s.takeRequests()
    s.feed(frame(1, 5, 3, block(getFields("/"))), 0)
    val code = goawayCode(frames(s.takeOutput()))
    if (code != 1) fail("H7: HEADERS on a lower, never-opened stream id: GOAWAY code $code, wanted PROTOCOL_ERROR (1)")
    // No RST_STREAM on an idle stream (RFC 9113 5.1): a PRIORITY that depends on itself, on idle stream 9.
    var t = ready()
    t.feed(frame(2, 0, 9, be32(9) + cryptoByteString([0])), 0)
    if (resetCode(frames(t.takeOutput()), 9) >= 0) fail("H7: RST_STREAM sent on idle stream 9")
    // :path must start with "/" (RFC 9113 8.3.1) for http(s) requests other than OPTIONS *.
    var u = ready()
    u.feed(frame(1, 5, 1, block([hf(":method", "GET"), hf(":scheme", "https"), hf(":path", "a"), hf(":authority", "x")])), 0)
    if (u.takeRequests().size != 0) fail("H7: a :path of \"a\" was accepted")
    return
}

// R3-1 (low-medium): the open streams of one connection may hold only so many decoded header bytes together. 100 streams with a 45 KB header list each
// (every one under the 64 KiB list limit) made a connection hold 4.5 MB of lists (12 MB resident): past 1 MiB, a new stream is refused (REFUSED_STREAM)
// and the connection stays up; a client that raises the limit gets them all; a normal request still fits next to the held ones.
fun letters(size: int, salt: int): string {
    val bytes: array<int> = []
    for (i in 0 until size) bytes.append(97 + ((i * 7 + salt * 13) % 26))
    cryptoByteString(bytes)
}

fun bigRequest(salt: int): string {
    val fields = getFields("/")
    fields.append(hf("x-a", letters(15000, salt)))
    fields.append(hf("x-b", letters(15000, salt + 1)))
    fields.append(hf("x-c", letters(15000, salt + 2)))
    block(fields)
}

// HEADERS and CONTINUATION frames for a header block, END_HEADERS on the last, no END_STREAM.
fun headerFrames(id: int, block: string): string {
    var wire = ""
    var at = 0
    var first = true
    while (at < block.size) {
        val take = if (block.size - at > 16384) 16384 else block.size - at
        val last = at + take >= block.size
        wire = wire + frame(if (first) 1 else 9, if (last) 4 else 0, id, block.slice(at, at + take))
        at = at + take
        first = false
    }
    wire
}

fun heldHeaders(): void {
    var s = ready()
    var refused = 0
    for (i in 0 until 100) {
        val id = 1 + 2 * i
        s.feed(headerFrames(id, bigRequest(i)), 0)
    }
    val seen = frames(s.takeOutput())
    for (i in 0 until 100) {
        if (resetCode(seen, 1 + 2 * i) == 7) refused = refused + 1
    }
    if (s.isClosed()) fail("R3-1: the connection was closed by 100 large header lists (it must only refuse the streams past the cap)")
    if (refused < 70) fail("R3-1: only $refused of 100 streams with 45 KB header lists were refused (REFUSED_STREAM); the connection holds ~4.5 MB of lists")
    if (s.openStreams() > 25) fail("R3-1: ${s.openStreams()} streams open with 45 KB header lists each (about 1 MiB is the cap)")
    // A small request on the same connection fits (the held lists leave room: the cap is 1 MiB, the lists took at most ~1 MiB, a few KB is refused too only
    // when the cap is full, so free one stream first by ending its request: a complete stream is answered and goes).
    var raised = h2ServerNew(100, 1048576, 65536, null, 16777216)
    raised.feed(H2_PREFACE + frame(4, 0, 0, ""), 0)
    raised.takeOutput()
    for (i in 0 until 100) raised.feed(headerFrames(1 + 2 * i, bigRequest(i)), 0)
    if (raised.openStreams() != 100) fail("R3-1: with maximumHeldHeaderBytes raised 100 streams were not all open: ${raised.openStreams()}")
    return
}

// R3-2 (low): a dynamic table entry that is a slice of its header block keeps the whole block alive (a string slice shares its parent), so a 4 KiB table
// held up to 120 blocks of ~48 KB each (5.8 MB; 128 KiB blocks, 15 MB). The entries are strings of their own.
fun hpackLength(value: int): string {
    if (value < 127) return cryptoByteString([value])
    val bytes: array<int> = [127]
    var rest = value - 127
    while (rest >= 128) {
        bytes.append((rest & 127) | 128)
        rest = rest >> 7
    }
    bytes.append(rest)
    cryptoByteString(bytes)
}

@noinline fun pinningBlock(salt: int): string {
    var block = cryptoByteString([130, 135, 132, 64, 1, 107, 1, 118])
    for (i in 0 until 3) block = block + cryptoByteString([0, 1, 120]) + hpackLength(16000) + letters(16000, salt + i)
    block
}

@noinline fun decodePinning(var decoder: HpackDecoder, salt: int): bool = decoder.decode(pinningBlock(salt)).ok

fun hpackPins(): void {
    var decoder = hpackDecoderNew(4096, 65536, 16384, 256)
    memoryCollect()
    val before = memoryLiveBytes()
    var ok = true
    for (i in 0 until 200) {
        if (!decodePinning(decoder, i)) ok = false
    }
    memoryCollect()
    memoryCollect()
    val held = memoryLiveBytes() - before
    if (!ok) fail("R3-2: a block of raw strings did not decode")
    if (decoder.tableEntries() < 100) fail("R3-2: the table holds only ${decoder.tableEntries()} entries; the check needs it full")
    if (held > 1048576) fail("R3-2: 200 header blocks of 48 KB leave $held bytes live after the requests are gone (the table's entries keep their blocks); under 1 MiB wanted")
    return
}

fun rq(method: string, path: string, authority: string): array<HpackField> =
    [hf(":method", method), hf(":scheme", "https"), hf(":path", path), hf(":authority", authority)]

fun with(fields: array<HpackField>, name: string, value: string): array<HpackField> {
    val more: array<HpackField> = []
    for (f in fields) more.append(f)
    more.append(hf(name, value))
    more
}

/** A request block on stream 1 (END_STREAM): refused with RST_STREAM(PROTOCOL_ERROR) and never handed over, or, with `accepted`, handed over. */
fun ruled(label: string, fields: array<HpackField>, accepted: bool = false): void {
    var s = ready()
    s.feed(frame(1, 5, 1, block(fields)), 0)
    val handed = s.takeRequests().size
    val code = resetCode(frames(s.takeOutput()), 1)
    if (accepted && (handed != 1 || code >= 0)) fail("8.2-8.3: $label: $handed requests, reset code $code (wanted it accepted)")
    if (!accepted && (handed != 0 || code != 1)) fail("8.2-8.3: $label: $handed requests, reset code $code (wanted PROTOCOL_ERROR)")
    return
}

/** A streaming request on stream 1, "abc" of body, then a trailer block holding `name: value`: refused, or with `accepted` the END event carries it. */
fun trailered(label: string, name: string, value: string, accepted: bool = false): void {
    var s = h2ServerNew()
    s.streamRoute("POST", "/up", 0)
    s.feed(H2_PREFACE + frame(4, 0, 0, ""), 0)
    s.takeOutput()
    s.feed(frame(1, 4, 1, block(rq("POST", "/up", "example.com"))), 0)
    s.feed(frame(0, 0, 1, "abc"), 0)
    s.feed(frame(1, 5, 1, block([hf(name, value)])), 0)
    var ended = false
    for (e in s.takeEvents()) {
        if (e.kind == 3 && e.trailers.size == 1 && e.trailers[0].name == name && e.trailers[0].value == value) ended = true
    }
    val code = resetCode(frames(s.takeOutput()), 1)
    if (accepted && (!ended || code >= 0)) fail("8.1 trailers: $label: delivered $ended, reset code $code (wanted it delivered)")
    if (!accepted && (ended || code != 1)) fail("8.1 trailers: $label: delivered $ended, reset code $code (wanted PROTOCOL_ERROR)")
    return
}

// RFC 9113 8.2-8.3 request rules, and the host, path and trailer checks the HTTP/1 readers make (R2-3, F1, httpTrailerLineValid): a handler must
// not get from an HTTP/2 request what an HTTP/1 request could never carry. The H2-1..H2-3 cases (host values, a second host, the path's bytes,
// the trailer fields) failed before the round 6 fix; the others are regressions.
fun requestRules(): void {
    ruled("a plain request", rq("GET", "/a", "example.com:8443"), true)
    ruled("OPTIONS *", rq("OPTIONS", "*", "example.com"), true)
    ruled("DEL in the path (as in HTTP/1)", rq("GET", "/a\u{7f}b", "example.com"), true)
    ruled("a host equal to :authority", with(rq("GET", "/", "example.com"), "host", "example.com"), true)
    ruled("a host and no :authority", [hf(":method", "GET"), hf(":scheme", "https"), hf(":path", "/"), hf("host", "example.com")], true)
    ruled("te: trailers", with(rq("GET", "/", "example.com"), "te", "trailers"), true)
    // H2-1: hosts.
    ruled("H2-1 :authority with a space", rq("GET", "/", "a b"))
    ruled("H2-1 :authority with a comma", rq("GET", "/", "a,b"))
    ruled("H2-1 :authority with a control byte", rq("GET", "/", "a\u{1}b"))
    ruled("H2-1 a host with a space", [hf(":method", "GET"), hf(":scheme", "https"), hf(":path", "/"), hf("host", "a b")])
    ruled("H2-1 two hosts", [hf(":method", "GET"), hf(":scheme", "https"), hf(":path", "/"), hf("host", "good.example"), hf("host", "evil.example")])
    // H2-2: the path's bytes.
    ruled("H2-2 a space in :path", rq("GET", "/a b", "example.com"))
    ruled("H2-2 a control byte in :path", rq("GET", "/a\u{1}b", "example.com"))
    ruled("H2-2 a tab in :path", rq("GET", "/a\tb", "example.com"))
    // Pseudo-headers (8.3).
    ruled("a pseudo-header after a regular field", [hf(":method", "GET"), hf(":scheme", "https"), hf("x-a", "1"), hf(":path", "/"), hf(":authority", "a")])
    ruled("two :path", with(rq("GET", "/", "a"), ":path", "/b"))
    ruled("two :method", [hf(":method", "GET"), hf(":method", "GET"), hf(":scheme", "https"), hf(":path", "/"), hf(":authority", "a")])
    ruled("an unknown pseudo-header", with(rq("GET", "/", "a"), ":protocol", "x"))
    ruled("a response pseudo-header", [hf(":status", "200"), hf(":method", "GET"), hf(":scheme", "https"), hf(":path", "/"), hf(":authority", "a")])
    ruled("no :method", [hf(":scheme", "https"), hf(":path", "/"), hf(":authority", "a")])
    ruled("no :scheme", [hf(":method", "GET"), hf(":path", "/"), hf(":authority", "a")])
    ruled("no :path", [hf(":method", "GET"), hf(":scheme", "https"), hf(":authority", "a")])
    ruled("a :method that is not a token", rq("G T", "/", "a"))
    ruled("a :method with a control byte", rq("GE\u{1}T", "/", "a"))
    // Fields (8.2).
    ruled("an upper case name", with(rq("GET", "/", "a"), "X-A", "1"))
    for (name in ["connection", "keep-alive", "proxy-connection", "transfer-encoding", "upgrade"]) ruled("connection-specific $name", with(rq("GET", "/", "a"), name, "x"))
    ruled("te: gzip", with(rq("GET", "/", "a"), "te", "gzip"))
    ruled("a NUL in a value", with(rq("GET", "/", "a"), "x-a", "1\u{0}2"))
    // content-length against the DATA (8.1.1).
    var s = ready()
    s.feed(frame(1, 4, 1, block(with(rq("POST", "/", "a"), "content-length", "5"))), 0)
    s.feed(frame(0, 1, 1, "abc"), 0)
    val handed = s.takeRequests().size
    val code = resetCode(frames(s.takeOutput()), 1)
    if (handed != 0 || code != 1) fail("8.1.1: content-length 5 with 3 bytes of DATA: $handed requests, reset code $code (wanted PROTOCOL_ERROR)")
    // H2-3: trailers.
    trailered("a plain trailer", "x-sum", "1", true)
    trailered("a host trailer (as in HTTP/1)", "host", "example.com", true)
    trailered("H2-3 CRLF in a trailer value", "x-a", "1\r\nset-cookie: a=1")
    trailered("H2-3 NUL in a trailer value", "x-a", "1\u{0}2")
    trailered("H2-3 an upper case trailer name", "X-A", "1")
    trailered("H2-3 a trailer name with a space", "x a", "1")
    trailered("H2-3 content-length in trailers", "content-length", "5")
    trailered("H2-3 transfer-encoding in trailers", "transfer-encoding", "chunked")
    trailered("H2-3 connection in trailers", "connection", "close")
    trailered("H2-3 te: gzip in trailers", "te", "gzip")
    trailered("a pseudo-header in trailers", ":path", "/x")
    return
}

fun main: int {
    requestRules()
    hpackPins()
    heldHeaders()
    unreadOutput()
    madeYouReset()
    crlfValue()
    bufferedBodies()
    bodyAfter413()
    deviations()
    if (failures == 0) println("http2 review ok")
    if (failures == 0) 0 else 1
}
