// abla/http/async over HTTP/2 against a scripted server in a forked child (h2c, prior knowledge: plain TCP, no TLS), for what a real server will not do on demand: a request that is
// never answered (per-stream timeout, the connection and the other streams go on), REFUSED_STREAM and GOAWAY (retried once on a connection that takes it), a protocol error from the
// server (every request on the connection fails and names the code), trailers (dropped, trailers() empty), the PING before reusing an idle connection, the idle close, and
// header lists in both directions. Each scenario starts its own mock (connection numbers start at 1).
// Prints "http2 mock ok".
import "abla/io"
import "abla/crypto"
import "abla/http"
import "abla/http/async"
import "abla/http/h2/hpack"
import "abla/sys/linux"
import "abla/sys/linux/net"

var failures = 0

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL $what")
    return
}

fun expect(cond: bool, what: string): void {
    if (!cond) fail(what)
    return
}

fun be32(value: int): string = cryptoByteString([(value >> 24) & 255, (value >> 16) & 255, (value >> 8) & 255, value & 255])

fun frame(kind: int, flags: int, stream: int, payload: string): string {
    val n = payload.size
    cryptoByteString([(n >> 16) & 255, (n >> 8) & 255, n & 255, kind, flags, (stream >> 24) & 127, (stream >> 16) & 255, (stream >> 8) & 255, stream & 255]) + payload
}

fun hf(name: string, value: string): HpackField = HpackField(name, value, false)

// ---- the mock server (child process) ----
fun respond(var conn: TcpConnection, var encoder: HpackEncoder, stream: int, status: string, extra: array<HpackField>, body: string, endStream: bool): void {
    val fields: array<HpackField> = [hf(":status", status)]
    for (f in extra) fields.append(f)
    conn.write(frame(1, if (body.size == 0 && endStream) 5 else 4, stream, encoder.encode(fields)))
    if (body.size > 0) conn.write(frame(0, if (endStream) 1 else 0, stream, body))
    return
}

fun serveConnection(var conn: TcpConnection, number: int): int {
    var decoder = hpackDecoderNew(4096, 65536, 16384, 256)
    var encoder = hpackEncoderNew(0)
    var buffer = ""
    var pings = 0
    var resets = 0
    var served = 0
    var prefaceDone = false
    conn.write(frame(4, 0, 0, ""))
    while (true) {
        if (!prefaceDone) {
            if (buffer.size >= 24) {
                buffer = buffer.slice(24, buffer.size)
                prefaceDone = true
            } else {
                val more = conn.read(4096)
                if (more.size == 0) return 0
                buffer = buffer + more
            }
            continue
        }
        if (buffer.size < 9) {
            val more = conn.read(65536)
            if (more.size == 0) return 0
            buffer = buffer + more
            continue
        }
        val length = (buffer[0] << 16) | (buffer[1] << 8) | buffer[2]
        if (buffer.size < 9 + length) {
            val more = conn.read(65536)
            if (more.size == 0) return 0
            buffer = buffer + more
            continue
        }
        val kind = buffer[3]
        val flags = buffer[4]
        val stream = ((buffer[5] & 127) << 24) | (buffer[6] << 16) | (buffer[7] << 8) | buffer[8]
        val payload = buffer.slice(9, 9 + length)
        buffer = buffer.slice(9 + length, buffer.size)
        if (kind == 4 && (flags & 1) == 0) conn.write(frame(4, 1, 0, ""))
        if (kind == 3) resets = resets + 1
        if (kind == 6 && (flags & 1) == 0) {
            pings = pings + 1
            conn.write(frame(6, 1, 0, payload))
        }
        if (kind == 1) {
            val block = decoder.decode(payload)
            var path = ""
            var method = ""
            var seen = ""
            if (block.ok) {
                for (f in block.fields) {
                    if (f.name == ":path") path = f.value
                    if (f.name == ":method") method = f.value
                    if (f.name == "x-echo") seen = f.value
                }
            }
            served = served + 1
            val common: array<HpackField> = [hf("x-conn", "$number"), hf("x-pings", "$pings"), hf("x-rsts", "$resets"), hf("x-stream", "$stream"), hf("x-method", method), hf("x-seen", seen)]
            if (path == "/ok") respond(conn, encoder, stream, "200", common, "ok", true)
            else if (path == "/slow") served = served
            else if (path == "/refuse") {
                if (stream == 1) conn.write(frame(3, 0, stream, be32(7)))
                else respond(conn, encoder, stream, "200", common, "second try", true)
            } else if (path == "/goaway") {
                if (number == 1) {
                    conn.write(frame(7, 0, 0, be32(0) + be32(0)))
                    conn.close()
                    return 0
                }
                respond(conn, encoder, stream, "200", common, "new connection", true)
            } else if (path == "/drain") {
                // GOAWAY (no error) naming this stream as the last one, then its response, and the connection stays open.
                conn.write(frame(7, 0, 0, be32(stream) + be32(0)))
                respond(conn, encoder, stream, "200", common, "drained", true)
            } else if (path == "/trailers") {
                respond(conn, encoder, stream, "200", common, "t", false)
                conn.write(frame(1, 5, stream, encoder.encode([hf("x-trailer", "1")])))
            } else if (path == "/push") {
                conn.write(frame(5, 4, stream, be32(2) + encoder.encode([hf(":method", "GET")])))
            } else if (path == "/interim") {
                conn.write(frame(1, 4, stream, encoder.encode([hf(":status", "103"), hf("link", "</x>; rel=preload")])))
                respond(conn, encoder, stream, "200", common, "after interim", true)
            } else if (path == "/many") {
                val fields: array<HpackField> = [hf(":status", "200")]
                for (i in 0 until 50) fields.append(hf("x-n$i", "v$i"))
                conn.write(frame(1, 4, stream, encoder.encode(fields)))
                conn.write(frame(0, 1, stream, "m"))
            } else respond(conn, encoder, stream, "404", common, "no", true)
        }
    }
    0
}

fun serve(var listener: TcpListener): int {
    var number = 0
    while (true) {
        var conn = listener.accept()
        number = number + 1
        val child = linuxSyscall0(57)
        if (child == 0) linuxSyscall1(60, serveConnection(conn, number))
        conn.close()
    }
    0
}

class Mock(val port: int, val pid: int)

fun startMock(): Mock {
    var listener = tcpListenAddress(ipv4Loopback(0))
    val port = listener.localPort()
    val child = linuxSyscall0(57)
    if (child == 0) linuxSyscall1(60, serve(listener))
    listener.close()
    Mock(port, child)
}

fun stopMock(mock: Mock): void {
    linuxSyscall2(62, mock.pid, 9)
    return
}

// ---- the scenarios (parent) ----
fun drain(var client: HttpAsyncClient, milliseconds: int): array<HttpAsyncCompletion> {
    val done: array<HttpAsyncCompletion> = []
    val deadline = linuxMonotonicMilliseconds() + milliseconds
    while (client.pending() > 0 && linuxMonotonicMilliseconds() < deadline) {
        client.step(10)
        for (c in client.takeCompletions()) done.append(c)
    }
    for (c in client.takeCompletions()) done.append(c)
    done
}

fun pause(var client: HttpAsyncClient, milliseconds: int): void {
    val end = linuxMonotonicMilliseconds() + milliseconds
    while (linuxMonotonicMilliseconds() < end) client.step(10)
    return
}

fun find(done: array<HttpAsyncCompletion>, id: int): HttpAsyncCompletion? {
    for (c in done) {
        if (c.id == id) return c
    }
    null
}

fun options(extra: int): HttpAsyncOptions {
    if (extra == 1) return HttpAsyncOptions(http2PriorKnowledge = true, http2PingAfterIdleMilliseconds = 100)
    if (extra == 2) return HttpAsyncOptions(http2PriorKnowledge = true, idleTimeoutMilliseconds = 300)
    HttpAsyncOptions(http2PriorKnowledge = true)
}

fun basics(): void {
    val mock = startMock()
    linuxSleepMillisecondsChecked(100)
    var client = httpAsyncClient(options(0))
    val base = "http://127.0.0.1:${mock.port}"
    val ids: array<int> = []
    for (i in 0 until 12) ids.append(client.get("$base/ok", [HttpHeader("X-Echo", "e$i")], 5000))
    val post = client.request("POST", "$base/ok", [], "body", 5000)
    val done = drain(client, 8000)
    for (id in ids) {
        val c = find(done, id)
        if (c == null) fail("no completion for $id")
        else if (c.status != 200 || c.body != "ok" || c.protocol != "h2" || c.header("x-conn") != "1") fail("ok: ${c.status} '${c.body}' ${c.protocol} conn ${c.header("x-conn")} ${c.error}")
    }
    val p = find(done, post)
    if (p == null || p.header("x-method") != "POST") fail("the POST arrives as POST")
    expect(client.connectionsOpened == 1, "12 requests share one connection: ${client.connectionsOpened}")
    // Headers: the caller's name in another case reaches the server lower-cased (x-echo), and lower case comes back.
    val first = find(done, ids[3])
    if (first != null) expect(first.header("X-Seen") == "e3", "the request header arrives: '${first.header("X-Seen")}'")
    // 1xx skipped, trailers kept, many headers.
    val interim = client.get("$base/interim", [], 5000)
    val trailers = client.get("$base/trailers", [], 5000)
    val many = client.get("$base/many", [], 5000)
    val more = drain(client, 8000)
    val i1 = find(more, interim)
    if (i1 == null || i1.status != 200 || i1.body != "after interim" || i1.header("link") != "") fail("1xx is skipped")
    val t1 = find(more, trailers)
    if (t1 == null || t1.body != "t" || t1.trailers().size != 1 || t1.trailers()[0].name != "x-trailer" || t1.trailers()[0].value != "1" || t1.header("x-trailer") != "") fail("trailers() returns the trailer, headers do not")
    val m1 = find(more, many)
    if (m1 == null || m1.headers.size != 50 || m1.header("x-n49") != "v49") fail("many headers")
    expect(client.connectionsOpened == 1, "still one connection: ${client.connectionsOpened}")
    stopMock(mock)
    return
}

fun timeouts(): void {
    val mock = startMock()
    linuxSleepMillisecondsChecked(100)
    var client = httpAsyncClient(options(0))
    val base = "http://127.0.0.1:${mock.port}"
    val slow = client.get("$base/slow", [], 300)
    val fast = client.get("$base/ok", [], 5000)
    val done = drain(client, 3000)
    val s = find(done, slow)
    val f = find(done, fast)
    if (s == null || s.error != "timeout") fail("the unanswered request times out")
    if (f == null || f.status != 200) fail("the other request is answered")
    expect(client.connectionsOpened == 1, "a timeout leaves the connection: ${client.connectionsOpened}")
    // The connection still works afterwards.
    val later = client.get("$base/ok", [], 5000)
    val after = find(drain(client, 3000), later)
    if (after == null || after.status != 200 || after.header("x-conn") != "1") fail("the connection serves after a timeout")
    else expect(after.header("x-rsts") == "1", "the timed-out stream was cancelled with RST_STREAM: ${after.header("x-rsts")}")
    expect(client.connectionsOpened == 1, "no new connection after the timeout: ${client.connectionsOpened}")
    stopMock(mock)
    return
}

fun retries(): void {
    val mock = startMock()
    linuxSleepMillisecondsChecked(100)
    var client = httpAsyncClient(options(0))
    val base = "http://127.0.0.1:${mock.port}"
    val refused = client.get("$base/refuse", [], 5000)
    val done = drain(client, 5000)
    val r = find(done, refused)
    if (r == null || r.status != 200 || r.body != "second try") fail("REFUSED_STREAM is retried once: ${if (r == null) "none" else r.error}")
    // GOAWAY with last stream 0 and a close: the request goes to a new connection, which serves it.
    val mock2 = startMock()
    linuxSleepMillisecondsChecked(100)
    var client2 = httpAsyncClient(options(0))
    val g = client2.get("http://127.0.0.1:${mock2.port}/goaway", [], 5000)
    val gd = find(drain(client2, 5000), g)
    if (gd == null || gd.status != 200 || gd.body != "new connection" || gd.header("x-conn") != "2") fail("GOAWAY: the request is retried on a new connection: ${if (gd == null) "none" else gd.error + " conn " + gd.header("x-conn")}")
    expect(client2.connectionsOpened == 2, "two connections: ${client2.connectionsOpened}")
    // GOAWAY that lets the stream finish: the connection is closed once it has, not left idle.
    val mock2b = startMock()
    linuxSleepMillisecondsChecked(100)
    var client2b = httpAsyncClient(options(0))
    val dr = client2b.get("http://127.0.0.1:${mock2b.port}/drain", [], 5000)
    val drd = find(drain(client2b, 5000), dr)
    if (drd == null || drd.status != 200 || drd.body != "drained") fail("GOAWAY(last = this stream): the response arrives: ${if (drd == null) "none" else drd.error}")
    var open = 0
    for (state in client2b.connectionStates) {
        if (state != 0) open = open + 1
    }
    expect(open == 0, "a connection that got GOAWAY and has no stream left is closed: $open open")
    // A protocol error from the server fails the request and names the code.
    val mock3 = startMock()
    linuxSleepMillisecondsChecked(100)
    var client3 = httpAsyncClient(options(0))
    val a = client3.get("http://127.0.0.1:${mock3.port}/push", [], 5000)
    val b = client3.get("http://127.0.0.1:${mock3.port}/slow", [], 5000)
    val pd = drain(client3, 5000)
    val pa = find(pd, a)
    val pb = find(pd, b)
    if (pa == null || !pa.error.contains("PROTOCOL_ERROR")) fail("a protocol error names its code: ${if (pa == null) "none" else pa.error}")
    if (pb == null || !pb.error.contains("PROTOCOL_ERROR")) fail("and fails every request on the connection: ${if (pb == null) "none" else pb.error}")
    stopMock(mock)
    stopMock(mock2)
    stopMock(mock2b)
    stopMock(mock3)
    return
}

fun liveness(): void {
    val mock = startMock()
    linuxSleepMillisecondsChecked(100)
    var client = httpAsyncClient(options(1))
    val base = "http://127.0.0.1:${mock.port}"
    client.get("$base/ok", [], 5000)
    drain(client, 3000)
    pause(client, 300)
    val id = client.get("$base/ok", [], 5000)
    val done = drain(client, 3000)
    val c = find(done, id)
    if (c == null || c.status != 200) fail("the idle connection is used again: ${if (c == null) "none" else c.error}")
    else expect(c.header("x-pings") == "1" && c.header("x-conn") == "1", "a PING went before reusing the idle connection: pings ${c.header("x-pings")} conn ${c.header("x-conn")}")
    expect(client.connectionsOpened == 1, "one connection throughout: ${client.connectionsOpened}")
    stopMock(mock)
    // The idle close: the connection goes after idleTimeoutMilliseconds, the next request opens a new one.
    val mock2 = startMock()
    linuxSleepMillisecondsChecked(100)
    var idle = httpAsyncClient(options(2))
    val base2 = "http://127.0.0.1:${mock2.port}"
    val one = idle.get("$base2/ok", [], 5000)
    drain(idle, 3000)
    pause(idle, 700)
    val two = idle.get("$base2/ok", [], 5000)
    val d2 = find(drain(idle, 3000), two)
    if (d2 == null || d2.status != 200) fail("a request after the idle close")
    else expect(d2.header("x-conn") == "2", "the idle connection was closed: conn ${d2.header("x-conn")}")
    expect(idle.connectionsOpened == 2, "two connections over the idle close: ${idle.connectionsOpened}")
    stopMock(mock2)
    return
}

fun main: int {
    basics()
    timeouts()
    retries()
    liveness()
    if (failures > 0) return 1
    println("http2 mock ok")
    0
}
