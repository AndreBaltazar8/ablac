// The compiler's front end (src/browser_main.ab: module graph, parse, semantic analysis, lowering; no LLVM, no native compile-time tier)
// as a WebAssembly module, for the page of #1138.
import "abla/wasm/build"
import "abla/build"

val target = #wasm32Target()
val frontEnd = #buildProgram(
    "browser-frontend",
    "../../../src/browser_main.ab",
    "../../../build/wasm-browser-frontend/browser-frontend.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (target && frontEnd) 0 else 1
