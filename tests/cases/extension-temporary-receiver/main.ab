import "abla/io"
var log: string = ""
resource class Item(val id: int) { fun drop(): void { log = log + "I$id" } }
class Holder(val item: Item)
fun Item.look(): int { log = log + "B${this.id}"; this.id }
fun Holder.look(): int { log = log + "H${this.item.id}"; this.item.id }
fun Item.ok(): bool { log = log + "C${this.id}"; true }
fun Holder.ok(): bool { log = log + "Q${this.item.id}"; true }
fun make(id: int): Item = Item(id)
fun holder(id: int): Holder = Holder(Item(id))
fun use(value: int): void { log = log + "U$value" }
fun exercise(): string {
    log = ""
    Item(1).look(); log = log + "|"
    make(2).look(); log = log + "|"
    if (Item(3).ok()) log = log + "T"; log = log + "|"
    use(make(4).look()); log = log + "|"
    Holder(Item(5)).look(); log = log + "|"
    holder(6).look(); log = log + "|"
    if (holder(8).ok()) log = log + "T"; log = log + "|"
    use(Holder(Item(9)).look()); log = log + "|"
    val existing = Item(7)
    existing.look(); log = log + "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
