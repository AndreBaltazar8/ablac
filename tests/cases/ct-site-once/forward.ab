// A global a `#` site initializes has one compile-time value (#1022): `twice`, run at compile time after the site,
// reads `a` as the site left it, and `bump` runs once. The effects come in the order the build reaches them: `a`'s
// site, then `c`'s (whose code reads `a`), as `c` initializes after `a` at run time.
import "abla/io"

var count = 0
fun bump(tag: string): int {
    count += 1
    eprintln("bump $tag $count")
    count
}
val a = #bump("a")
fun twice(): int {
    eprintln("twice")
    a * 2
}
val c = #twice()

fun main: int {
    println("$a $c")
    0
}
