// A `#` site in a function body is one constant for the build (#1022): compile-time code that calls `counted` meets
// the site and gets its one value, and `bump` runs once.
import "abla/io"

var count = 0
fun bump(tag: string): int {
    count += 1
    eprintln("bump $tag $count")
    count
}
fun counted(): int = #bump("f")
fun twice(): int = counted() * 2
val c = #twice()

fun main: int {
    println("${counted()} $c")
    0
}
