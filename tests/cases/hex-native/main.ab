// hexEncode and hexDecode (abla/crypto) against the code they replaced, copied here (the loops over slices and arrays): every byte value, every length to 70 and some larger, random
// data; decoding of both cases, mixed, and of everything that is not valid (an odd length, each of the 256 byte values in each position of a short string); and the compile-time
// evaluator's answers (which use the previous code) for some constants. Prints "hex-native ok".
import "abla/io"
import "abla/bytes"
import "abla/crypto"
import "abla/text"

var failures = 0
var seed = 31

fun next(): int {
    seed = (seed * 1103515245 + 12345) & 2147483647
    (seed >> 16) & 255
}

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 30) println("FAIL $what")
    return
}

fun oldEncode(value: string): string {
    val digits = "0123456789abcdef"
    var output = ""
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        val high = digits.slice(byte / 16, byte / 16 + 1)
        val lowIndex = byte - byte / 16 * 16
        val low = digits.slice(lowIndex, lowIndex + 1)
        output = "$output$high$low"
        index = index + 1
    }
    output
}

fun oldDigit(value: int): int =
    if (value >= 48 && value <= 57) value - 48
    else if (value >= 97 && value <= 102) value - 87
    else if (value >= 65 && value <= 70) value - 55
    else -1

fun oldDecode(value: string): string {
    if (value.size % 2 != 0) return ""
    val output = byteBuffer()
    var index = 0
    while (index < value.size) {
        val high = oldDigit(value[index])
        val low = oldDigit(value[index + 1])
        if (high < 0 || low < 0) return ""
        output.appendByteValue(high * 16 + low)
        index = index + 2
    }
    output.toText()
}

fun bytesOf(values: array<int>): string {
    val buffer = byteBuffer()
    for (value in values) buffer.appendByteValue(value)
    buffer.toText()
}

fun checkEncode(what: string, data: string): void {
    if (hexEncode(data) != oldEncode(data)) fail("encode $what")
    if (hexDecode(hexEncode(data)) != data) fail("round trip $what")
    return
}

fun upperHex(text: string): string {
    val buffer = byteBuffer()
    for (i in 0 until text.size) buffer.appendByteValue(if (text[i] >= 97 && text[i] <= 102) text[i] - 32 else text[i])
    buffer.toText()
}

fun main: int {
    for (byte in 0 until 256) checkEncode("byte $byte", bytesOf([byte]))
    for (length in 0 until 71) {
        val values: array<int> = []
        for (i in 0 until length) values.append(next())
        checkEncode("length $length", bytesOf(values))
    }
    for (length in [255, 256, 1000, 4096, 65536]) {
        val values: array<int> = []
        for (i in 0 until length) values.append(next())
        checkEncode("length $length", bytesOf(values))
    }
    // Decoding: valid in both cases and mixed, and everything else.
    for (length in 0 until 40) {
        val values: array<int> = []
        for (i in 0 until length) values.append(next())
        val hex = hexEncode(bytesOf(values))
        if (hexDecode(hex) != oldDecode(hex)) fail("decode $length")
        if (hexDecode(upperHex(hex)) != oldDecode(upperHex(hex))) fail("decode upper $length")
        if (hexDecode(hex + "0") != oldDecode(hex + "0")) fail("decode odd $length")
    }
    for (position in 0 until 6) {
        for (byte in 0 until 256) {
            val values = [48, 49, 97, 98, 70, 69]
            values[position] = byte
            val text = bytesOf(values)
            if (hexDecode(text) != oldDecode(text)) fail("decode position $position byte $byte")
        }
    }
    // The compile-time evaluator's own answers.
    if (hexEncode("abc\x00\xff") != #hexEncode("abc\x00\xff")) fail("compile-time encode")
    if (hexDecode("00ff10Ab") != #hexDecode("00ff10Ab")) fail("compile-time decode")
    if (hexDecode("0g") != #hexDecode("0g") || hexDecode("abc") != #hexDecode("abc")) fail("compile-time invalid")
    if (failures > 0) return 1
    println("hex-native ok")
    0
}
