// Extension fields under `#` and at run time: defaults (with `this`),
// assignments, a mutation through an unset field, `val` and another class.
class Point(val x: int)
class Node(val name: string)

var Point.label: string = "none"
var Point.hits: int = this.x * 10
var Node.children: array<string> = []
val Node.created: int = 0

fun Node.adopt(child: string): void {
    children.append(child)
    return
}

fun parityValue(): string {
    val p = Point(4)
    var out = "${p.label}/${p.hits}"
    p.label = "set"
    p.hits = p.hits + 2
    val n = Node("n")
    n.adopt("a")
    n.children.append("b")
    n.created = 9
    "$out ${p.label}/${p.hits} ${n.children.size} ${n.created} ${Point(1).hits}"
}
