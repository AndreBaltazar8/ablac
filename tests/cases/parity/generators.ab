// Generators: a plain sequence, early exit running `defer`, generators
// iterating generators, a generator capturing locals and yielding strings.
var cleanups = 0

fun recordCleanup(): void {
    cleanups = cleanups + 1
    return
}

fun count(limit: int): Generator<int> = generator {
    defer { recordCleanup() }
    var value = 0
    while (value < limit) {
        yield value
        value = value + 1
    }
}

fun squares(limit: int): Generator<int> = generator {
    for (value in count(limit)) yield value * value
}

fun scaled(factor: int): Generator<string> = generator {
    val prefix = "x$factor:"
    for (value in count(3)) yield "$prefix${value * factor}"
}

fun parityValue(): string {
    var text = ""
    for (value in count(5)) text = "$text$value,"
    for (value in count(100)) {
        if (value == 2) break
        text = "$text early$value"
    }
    for (value in squares(4)) text = "$text sq$value"
    for (value in scaled(7)) text = "$text $value"
    "$text cleanups=$cleanups"
}
