// Generators: a plain sequence, early exit running `defer`, a generator
// capturing locals and yielding strings.
var cleanups = 0

fun recordCleanup(): void {
    cleanups = cleanups + 1
    return
}

fun count(limit: int): Generator<int> = generator {
    defer { recordCleanup() }
    var value = 0
    while (value < limit) {
        yield value
        value = value + 1
    }
}

fun squares(limit: int): Generator<int> = generator {
    var value = 0
    while (value < limit) {
        val square = value * value
        yield square
        value = value + 1
    }
}

fun scaled(factor: int): Generator<string> = generator {
    val prefix = "x$factor:"
    var value = 0
    while (value < 3) {
        val text = "$prefix${value * factor}"
        yield text
        value = value + 1
    }
}

fun parityValue(): string {
    var text = ""
    for (value in count(5)) text = "$text$value,"
    for (value in count(100)) {
        if (value == 2) break
        text = "$text early$value"
    }
    for (value in squares(4)) text = "$text sq$value"
    for (value in scaled(7)) text = "$text $value"
    "$text cleanups=$cleanups"
}
