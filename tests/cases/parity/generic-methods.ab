// Generic methods under `#` and at run time: a class's method with type
// parameters of its own, inferred and written out, on a generic class and a
// plain one, calling another generic method.
class Bag<T>(val items: array<T>) {
    fun <U> remap(f: (T) -> U): Bag<U> {
        val out: array<U> = []
        for (item in items) out.append(f(item))
        Bag(out)
    }

    fun <U> fold(start: U, step: (U, T) -> U): U {
        var total = start
        for (item in items) total = step(total, item)
        total
    }

    fun <U> firstAs(f: (T) -> U): U = remap(f).items[0]
}

class Ledger(val name: string) {
    fun <V> tagged(value: V, text: (V) -> string): string = "$name:${text(value)}"
}

fun parityValue(): string {
    val bag = Bag([1, 2, 3])
    "${bag.remap { n -> "n$n" }.items[2]} ${bag.fold(0) { total, n -> total + n }} " +
        "${bag.remap<string> { n -> "$n!" }.items[0]} ${bag.firstAs { n -> n * 10 }} " +
        "${Ledger("c").tagged(25) { x -> "$x" }} ${Bag(["a", "bb"]).fold("") { text, s -> "$text$s" }}"
}
