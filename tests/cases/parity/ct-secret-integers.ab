// abla/ct's secret integers of every width (add, subtract, multiply with wrap-around, the bit operations, shifts and rotates,
// ctSelect and ctEq masks, declassify) and the target queries of abla/simd/target: the same text at run time and under `#` (#822).
import "abla/ct"
import "abla/simd/target"

fun parityStep8(a: u8, b: u8): string {
    val x = secretU8(a)
    val y = secretU8(b)
    "${(x + y).declassify()},${(x - y).declassify()},${(x * y).declassify()},${(x & y).declassify()},${(x | y).declassify()},${(x ^ y).declassify()},${(~x).declassify()},${(x << 3).declassify()},${(x >> 2).declassify()},${x.rotl(3).declassify()},${ctSelect(ctEq(x, y), x, y).declassify()}"
}

fun parityStep16(a: u16, b: u16): string {
    val x = secretU16(a)
    val y = secretU16(b)
    "${(x + y).declassify()},${(x - y).declassify()},${(x * y).declassify()},${(x & y).declassify()},${(x | y).declassify()},${(x ^ y).declassify()},${(~x).declassify()},${(x << 5).declassify()},${(x >> 7).declassify()},${x.rotl(5).declassify()},${ctSelect(ctEq(x, y), x, y).declassify()}"
}

fun parityStep32(a: u32, b: u32): string {
    val x = secretU32(a)
    val y = secretU32(b)
    "${(x + y).declassify()},${(x - y).declassify()},${(x * y).declassify()},${(x & y).declassify()},${(x | y).declassify()},${(x ^ y).declassify()},${(~x).declassify()},${(x << 9).declassify()},${(x >> 11).declassify()},${x.rotl(13).declassify()},${x.rotr(7).declassify()},${ctSelect(ctEq(x, y), x, y).declassify()}"
}

fun parityStep64(a: u64, b: u64): string {
    val x = secretU64(a)
    val y = secretU64(b)
    "${(x + y).declassify()},${(x - y).declassify()},${(x * y).declassify()},${(x & y).declassify()},${(x | y).declassify()},${(x ^ y).declassify()},${(~x).declassify()},${(x << 17).declassify()},${(x >> 19).declassify()},${x.rotl(23).declassify()},${ctSelect(ctEq(x, y), x, y).declassify()}"
}

fun parityValue(): string {
    val a8 = parityStep8(u8(200), u8(77)) + ";" + parityStep8(u8(5), u8(5))
    val a16 = parityStep16(u16(65000), u16(1234)) + ";" + parityStep16(u16(7), u16(7))
    val a32 = parityStep32(u32(4000000000), u32(123456789)) + ";" + parityStep32(u32(9), u32(9))
    val a64 = parityStep64(u64(9000000000000000000), u64(1234567890123)) + ";" + parityStep64(u64(3), u64(3))
    "$a8|$a16|$a32|$a64|${simdTargetArch()}|${targetHas("sse2")}|${targetHas("neon")}"
}

fun parityShow(value: string): string = value
