// atan2: every quadrant, the table range, quotients beyond 2^±51 (the tiny
// quotient path and the 192-bit path), subnormals, CORE-MATH worst cases and
// specials: every result's exact bits.
import "abla/float"
import "abla/math"

fun parityValue(): string {
    val inf = 1.0 / 0.0
    val pairs: array<f64> = [1.0, 1.0, -2.0, -3.0, 0.5, -0.25, -0.3, 0.7, 3.0, 1e-3, 1e-20, 3.0,
        1e-20, -3.0, -7.0, 1e-30, 3e-300, 2.0, 1e300, 1e-300, 5e-324, 1.0, 2.0, 5e-324,
        0.0, -1.0, -0.0, 0.0, inf, -inf, -inf, 2.0, 1.0, 0.0 / 0.0,
        f64FromBits(4844731956334772370), f64FromBits(4845082964389861807)]
    var text = ""
    var i = 0
    while (i < pairs.size) {
        val result = atan2(pairs[i], pairs[i + 1])
        // NaN's sign and payload are unspecified; every other result keeps its bits.
        val bits = if (result != result) "nan" else "${f64ToBits(result)}"
        text = "$text $bits"
        i += 2
    }
    text
}
