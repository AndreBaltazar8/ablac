// Calls of values that aren't plain names: a call's result (`adder(2)(3)`),
// an element (`fs[0]()`), a parenthesized callee (`(h.cb)(5)`, `(fs[0])()`),
// and a function-typed property called like a method (`h.cb(4)`) when the
// class has no method of that name; a method of that name wins.
class H(val cb: (int) -> int) {
    fun twice(x: int): int = cb(cb(x))
}

class Both(val step: (int) -> int) {
    fun step(x: int): int = x * 100
}

fun adder(k: int): (int) -> int = { x: int -> x + k }

fun curry(a: int): (int) -> (int) -> int = { b: int -> { c: int -> a * 100 + b * 10 + c } }

fun parityValue(): string {
    val fs: array<() -> int> = [{ -> 7 }, { -> 8 }]
    val h = H({ x: int -> x + 1 })
    val both = Both({ x: int -> x + 1 })
    val m: Map<string, (int) -> int> = Map()
    m.set("double", { x: int -> x * 2 })
    val g = m.get("double")
    val viaMap = if (g != null) g(21) else 0
    "${adder(2)(3)} ${curry(1)(2)(3)} ${fs[0]()} ${fs[1]()} ${(fs[0])()} " +
        "${h.cb(4)} ${(h.cb)(5)} ${h.twice(1)} ${both.step(2)} ${(both.step)(2)} $viaMap"
}
