// A class graph with sharing and cycles crosses from compile time intact:
// shared nodes stay one object, cycles close, fields keep their values.
class Node(val id: int, var label: string, var next: Node?, val children: array<Node>)

class Graph(val nodes: array<Node>)

fun parityValue(): Graph {
    val nodes: array<Node> = []
    var index = 0
    while (index < 200) {
        nodes.append(Node(index, "n$index", null, []))
        index = index + 1
    }
    index = 0
    while (index < 200) {
        nodes[index].next = nodes[(index * 7 + 3) % 200]
        nodes[index].children.append(nodes[(index + 1) % 200])
        nodes[index].children.append(nodes[(index * index) % 200])
        index = index + 1
    }
    Graph(nodes)
}

fun parityShow(var graph: Graph): string {
    var walk = 0
    var visited = ""
    var steps = 0
    while (steps < 50) {
        visited = "$visited$walk,"
        val next = graph.nodes[walk].next
        if (next != null) walk = next.id
        steps = steps + 1
    }
    // Sharing: renaming through one path is seen through the others.
    graph.nodes[5].label = "renamed"
    val viaChild = graph.nodes[4].children[0].label
    val viaNext = graph.nodes[22].label
    var childSum = 0
    for (node in graph.nodes) for (child in node.children) childSum = childSum + child.id
    "$visited $viaChild $viaNext $childSum ${graph.nodes[0].children[1].id}"
}
