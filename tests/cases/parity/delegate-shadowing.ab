// Fields and locals named like a top-level delegated binding are themselves:
// a method reading its field `level`, a delegate whose accessors read and
// write their own field `level` beside a global `level` delegated to that
// class, and a compile-time function assigning its own delegated local.
class Fixed(val current: int) {
    fun getValue(): int = current
}

class Settings(var level: int) {
    fun getValue(): int = level
    fun setValue(next: int): void {
        level = next
        return
    }
}

class Box(var level: int) {
    fun show(): int = level
    fun bump(): int {
        level = level + 10
        level
    }
}

var level by Settings(1)
val fixedLevel by Fixed(99)

fun raise(var settings: Settings): void {
    settings.level = settings.level * 2
    return
}

compile fun stagedLevel(): int {
    var staged by Settings(5)
    staged = staged + 1
    staged
}

fun parityValue(): string {
    val box = Box(1)
    val shown = box.show()
    val bumped = box.bump()
    raise(^level)
    level = level + 3
    "$shown $bumped $level $fixedLevel ${#stagedLevel()}"
}
