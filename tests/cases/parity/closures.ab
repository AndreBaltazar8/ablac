// Closures returned from a compile-time evaluation: captured ints, strings,
// arrays and other closures, a captured object.
class Box(val count: int)

fun adder(amount: int): Fn(int) -> int = { value: int -> value + amount }

fun compose(first: Fn(int) -> int, second: Fn(int) -> int): Fn(int) -> int =
    { value: int -> second(first(value)) }

fun parityValue(): Fn(int) -> string {
    val add = adder(5)
    val twice = compose(add, adder(10))
    val names = ["a", "b", "c"]
    val box = Box(40)
    return { value: int -> "${twice(value)} ${names[value % 3]} ${box.count + value}" }
}

fun parityShow(value: Fn(int) -> string): string = "${value(1)}|${value(2)}|${value(3)}"
