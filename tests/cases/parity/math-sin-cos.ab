// sin and cos: tiny, small, moderate, near multiples of pi/2, huge (both
// reductions), the accurate paths and specials: every result's exact bits.
import "abla/float"
import "abla/math"

fun parityValue(): string {
    val inf = 1.0 / 0.0
    val values: array<f64> = [0.0, -0.0, 1e-30, 1e-9, 3e-8, -2e-5, 0.001, 0.5, -1.0, 3.0,
        mathPi, mathHalfPi, 100.0, -12345.678, 2147483647.0, 3e9, 1e22, -1e300,
        1.7976931348623157e308, inf, -inf, 0.0 / 0.0, 5e-324,
        f64FromBits(4611691525602213605), f64FromBits(4566665909499395396),
        f64FromBits(9207116233714453714), f64FromBits(4607183827260264357),
        f64FromBits(4517130995124480366)]
    var text = ""
    for (value in values) {
        for (result in [sin(value), cos(value)]) {
            // NaN's sign and payload are unspecified; every other result keeps its bits.
            val bits = if (result != result) "nan" else "${f64ToBits(result)}"
            text = "$text $bits"
        }
    }
    text
}
