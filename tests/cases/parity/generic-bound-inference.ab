// A type parameter named by an instance bound is bound from the conformance of the type argument (`<T, C : Source<T>>`
// with `C` a `Numbers : Source<int>`): the same text at run time and under `#`.
interface Source<T> {
    fun at(index: int): T?
}

class Numbers(val limit: int) : Source<int> {
    fun at(index: int): int? = if (index < this.limit) index * index else null
}

class Words(val words: array<string>) : Source<string> {
    fun at(index: int): string? = if (index < this.words.size) this.words[index] else null
}

class Repeat<T>(val value: T, val times: int) : Source<T> {
    fun at(index: int): T? = if (index < this.times) this.value else null
}

fun <T, C : Source<T>> second(c: C): T? = c.at(1)

fun <T, C : Source<T>> pair(c: C, join: (T, T) -> T): T? {
    val a = c.at(0)
    val b = c.at(1)
    if (a != null && b != null) join(a, b) else null
}

fun parityValue(): string {
    val shared: Source<int> = Numbers(4)
    "${second(Numbers(3)) ?? -1} ${second(Words(["a", "b"])) ?? "-"} ${second(Repeat("r", 2)) ?? "-"} " +
        "${second(shared) ?? -1} ${pair(Numbers(3)) { x, y -> x + y } ?? -1} ${pair(Words(["p", "q"])) { x, y -> "$x$y" } ?? "-"}"
}
