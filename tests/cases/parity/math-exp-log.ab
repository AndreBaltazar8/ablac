// exp and log: hard-to-round, subnormal and overflowing results, both
// accurate paths, and specials: every result's exact bits.
import "abla/float"
import "abla/math"

fun parityValue(): string {
    val inf = 1.0 / 0.0
    val values: array<f64> = [0.0, -0.0, 1.0, -1.0, 0.5, 1e-20, -1e-17, 709.7, 709.79, -745.0,
        -745.2, -708.5, 100.0, inf, -inf, 0.0 / 0.0, 5e-324, 2.2250738585072014e-308,
        1.7976931348623157e308, 1.0000000001, 0.9999999999,
        f64FromBits(4625197047489145475), f64FromBits(4616190243587021541),
        f64FromBits(4610489747970184643), f64FromBits(4612282036250082575)]
    var text = ""
    for (value in values) {
        for (result in [exp(value), log(value)]) {
            // NaN's sign and payload are unspecified; every other result keeps its bits.
            val bits = if (result != result) "nan" else "${f64ToBits(result)}"
            text = "$text $bits"
        }
    }
    text
}
