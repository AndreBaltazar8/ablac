// Default arguments: a default reading the parameters before it, defaults
// that construct objects with their own defaults, on functions, methods and
// extension functions, and a parameter named like a global.
class Options(val size: int = 4096, val name: string = "options", val flag: bool = false)

class Counter(var count: int) {
    fun add(amount: int = 1, times: int = amount + 1): int {
        this.count = this.count + amount * times
        this.count
    }
}

val options = Options(7)

fun Counter.scaled(factor: int = 3, options: Options = Options(factor)): int =
    this.count * options.size

fun join(first: int, second: int = first * 2, label: string = "n$second"): string =
    "$first $second $label"

fun sized(options: Options = Options()): int = options.size

fun parityValue(): string {
    val counter = Counter(1)
    "${join(5)} ${join(5, 6)} ${join(1, 2, "x")} ${sized()} ${sized(Options(9))} " +
        "${counter.add()} ${counter.add(2)} ${counter.add(3, 1)} ${counter.scaled()} " +
        "${Options().name} ${Options(1, "b").flag} ${options.size}"
}
