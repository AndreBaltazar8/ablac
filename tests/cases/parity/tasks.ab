// Tasks: nested awaits, tasks capturing locals and loop values.
fun square(value: int): Task<int> = task { value * value }

fun parityValue(): string {
    val base = 20
    val inner = task { base }
    val outer = task { await inner + 1 }
    var total = 0
    var index = 0
    while (index < 8) {
        val captured = index
        val each = task { captured + await square(captured) }
        total = total + await each
        index = index + 1
    }
    "${await outer} $total"
}
