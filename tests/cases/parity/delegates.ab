// Delegated bindings: local and top-level `by` delegates (val and var),
// replacing the delegate (`^x = ...`, also of a global from another function), reaching into it (`(^x).field`),
// a closure capturing the live slot, a delegated `compile var`, an affine
// delegate dropped on replacement, a value read through a delegate leaving
// the computation, and accessors that call other functions.
class ClampedInt(var current: int, val minimum: int, val maximum: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = clamp(next, minimum, maximum)
        return
    }
}

class ConstantInt(val value: int) {
    fun getValue(): int = value
}

class Trace(var gets: int, var sets: int)

class TracedText(var text: string, val trace: Trace) {
    fun getValue(): string {
        trace.gets = trace.gets + 1
        decorate(text)
    }
    fun setValue(next: string): void {
        trace.sets = trace.sets + 1
        text = next
        return
    }
}

var drops = 0

resource class OwnedInt(var current: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = next
        return
    }
    fun drop(): void {
        drops = drops + current
        return
    }
}

fun clamp(value: int, low: int, high: int): int =
    if (value < low) low else if (value > high) high else value

fun decorate(text: string): string = "<$text>"

var total: int by ClampedInt(1, 0, 9)
val fixed by ConstantInt(7)
compile var stagedCount: int by ClampedInt(0, 0, 5)

// It sets the global rather than adding to it: the staged variant runs this site
// twice (on its own, then inside `#parityValue()`), and a `compile var` keeps its
// delegate from one evaluation to the next.
compile fun stagedBump(): int {
    stagedCount = stagedCount - stagedCount + 7
    stagedCount
}

fun addToTotal(amount: int): int {
    total = total + amount
    total
}

fun replaceTotal(): int {
    ^total = ClampedInt(2, 0, 4)
    (^total).maximum
}

fun widen(var policy: ClampedInt): void {
    policy.current = policy.current + 1
    return
}

class Pair(val first: int, val second: string)

fun parityValue(): Pair {
    var volume: int by ClampedInt(40, 0, 100)
    volume = 140
    val first = volume
    ^volume = ClampedInt(20, 0, 50)
    volume = volume + 100
    total = total + 20
    val viaFunction = addToTotal(-5)
    val replacedMaximum = replaceTotal()
    val afterReplace = addToTotal(1)
    val read = { volume }
    val bump = { -> volume = 3 }
    bump()
    val captured = read()
    val high = (^volume).maximum
    // `^` binds to the binding: `^volume.maximum` is `(^volume).maximum`.
    val sameHigh = ^volume.maximum == high
    widen(^volume)
    val trace = Trace(0, 0)
    var label: string by TracedText("a", trace)
    label = "b"
    val shown = label + label
    var owned: int by OwnedInt(3)
    ^owned = OwnedInt(5)
    owned = owned + 1
    // A delegated `compile var` lives in compile-time code in both variants.
    val staged = #stagedBump()
    Pair(volume, "$first $captured $high $sameHigh $total $fixed $shown ${trace.gets} " +
        "${trace.sets} $owned $drops $staged $viaFunction $replacedMaximum $afterReplace")
}

fun parityShow(pair: Pair): string = "${pair.first} ${pair.second}"
