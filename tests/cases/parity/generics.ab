// Generics under `#` and at run time: inferred and written type arguments,
// a generic class with methods, generic extensions on arrays and maps, a
// lambda's result binding a type parameter, nested instances, a default and a
// delegated property whose generic calls take each call's type arguments,
// bounded type parameters (a bound's member, its default body), and `#` code
// per instance (a folded type query, a type's name).
import "abla/compiler"
import "abla/float/text"

class Box<T>(val value: T) {
    fun get(): T = this.value
    fun with(other: T): Box<T> = Box(other)
}

class Pair<A, B>(val first: A, val second: B)

fun <T> first(items: array<T>): T = items[0]

fun <T, R> array<T>.mapped(f: (T) -> R): array<R> {
    val out: array<R> = []
    for (item in this) out.append(f(item))
    out
}

fun <K, V> Map<K, V>.valueOr(key: K, fallback: V): V {
    val found = this.get(key)
    if (found != null) found else fallback
}

fun <T> wrap(value: T): Box<Box<T>> = Box(Box(value))

fun <T> boxedOr(value: T, box: Box<T> = Box(value)): T = box.get()

class Slot<T>(var current: T) {
    fun getValue(): T = current
    fun setValue(next: T): void {
        current = next
        return
    }
}

class Tracked<T>(val start: T, var value: T by Slot(start))

interface Sized {
    fun size(): int
    fun describe(): string = "size ${this.size()}"
}

class Crate(val count: int) : Sized {
    fun size(): int = this.count * 2
}

fun <T> measured(value: T): string =
    if (#compiler.typeConformsTo(T, "Sized")) "${#compiler.typeName(T)} ${value.size()}"
    else "${#compiler.typeName(T)} unsized"

fun <T : Sized> sizes(items: array<T>): string {
    var text = ""
    for (item in items) text = "$text${item.size()},${item.describe()};"
    text
}

fun parityValue(): string {
    val words = [1, 2, 3].mapped { n -> "w$n" }
    val ages: Map<string, int> = Map()
    ages.set("ada", 36)
    val pair = Pair(first(words), Box(2.5))
    val small: Box<u8> = Box(7)
    "${first<int>([4, 5])} ${words[2]} ${ages.valueOr("ada", 0)}/${ages.valueOr("bob", -1)} " +
        "${pair.first} ${pair.second.get()} ${wrap("deep").get().get()} ${small.with(9).get()} " +
        "${boxedOr(1)}${boxedOr("s")} ${trackedText()} ${sizes([Crate(1), Crate(3)])} " +
        "${measured(Crate(2))}/${measured("s")}"
}

fun trackedText(): string {
    val text = Tracked("a")
    text.value = "b"
    val number = Tracked(3)
    "${text.value}${number.value}${text.start}"
}
