// Integer edges: the smallest and largest literals, hex, separators,
// wrapping arithmetic, signed division and remainder, shifts and masks.
fun parityValue(): string {
    val minimum = -9223372036854775808
    val maximum = 9223372036854775807
    val hex = 0x7fff_ffff_ffff_ffff
    val wrapped = maximum + 1
    val product = 3037000500 * 3037000500
    "$minimum $maximum ${minimum == -9223372036854775807 - 1} ${hex == maximum} " +
        "$wrapped $product ${-7 / 2} ${-7 % 2} ${7 / -2} ${7 % -2} " +
        "${1 << 62} ${minimum >> 63} ${minimum >>> 63} ${1 << 64} ${1 << -1} " +
        "${0xff & 0x0f} ${0xaa ^ 0xff} ${~0} ${1_000_000}"
}
