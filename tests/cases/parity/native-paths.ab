// The stdlib's fast paths under `#`: text, percent coding, hex, SHA-256/512, ByteBuffer, gzip and JSON. The evaluator runs their portable
// arms, the jit tier (and auto) the native ones, and run time the native ones: all must print the same.
import "abla/bytes"
import "abla/compression/gzip"
import "abla/crypto"
import "abla/json"
import "abla/text"

fun sample(): string {
    val pieces = ["Hello, Wörld! ", "the quick brown fox ", "日本語 ", "a b+c%d ", "ALL CAPS ", "x=1&y=2 ", "~-._ ", "\n\t"]
    var text = ""
    var i = 0
    while (i < 24) {
        text = text + pieces[(i * 5 + i / 3) % pieces.size]
        i = i + 1
    }
    text
}

fun show(value: string?): string = if (value == null) "null" else value

fun parityValue(): string {
    val s = sample()
    val bad = "ab" + byteEncode(255) + "cd" + byteEncode(195)
    val encoded = percentEncode(s)
    val queried = percentEncode(s, true)
    val decoded = percentDecode(queried, true)
    val gz = gzipCompress(s + s + s)
    val un = gzipDecompress(gz, 100000)
    val buffer = byteBuffer()
    var i = 0
    while (i < 40) {
        buffer.appendText("n")
        buffer.appendInt(i * 37 - 500)
        buffer.appendFixed(i * 7 - 50, 2)
        i = i + 1
    }
    val parsed = jsonParse("{\"a\":[1,2.5,\"x\\n\\u00e9\",true,null],\"s\":\"" + "plain text ".repeat(20) + "\",\"u\":\"\\ud83d\\ude00\"}")
    val written = jsonStringify(parsed.value)
    "${s.uppercase()}|${s.lowercase()}|${s.codePointCount()}|${bad.codePointCount()}|${s.isValidUtf8()} ${bad.isValidUtf8()}|" +
        "${s.lastIndexOf("fox")} ${s.lastIndexOf("zzz")} ${s.lastIndexOf("")}|$encoded|$queried|" +
        "${show(decoded)}|${show(percentDecode("%zz"))} ${show(percentDecode("%C3%A9"))} ${show(percentDecode("%C3"))}|" +
        "${hexEncode(s)}|${hexDecode(hexEncode(s)) == s} ${hexDecode("abc")}|${sha256(s)}|${sha512(s)}|" +
        "${gz.size} ${un.error} ${un.data == s + s + s}|${buffer.toText()}|$written"
}
