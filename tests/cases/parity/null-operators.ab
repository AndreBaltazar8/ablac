// Null operators: `?.` skips the rest of its chain (arguments included) on
// null, `??` evaluates its default only on null and groups to the right, and
// `?? return` / `?? continue` / `?? break` leave as an `if` branch does.
class Node(val value: int, val next: Node?, val name: string?)

class Tally(var count: int)

fun Node.add(n: int): int = this.value + n

fun Node.bump(var tally: Tally): void {
    tally.count += this.value
}

fun counted(var tally: Tally, n: int): int {
    tally.count += 1
    n
}

fun firstValue(node: Node?): int {
    val value = node?.value ?? return -1
    value * 10
}

fun sumUntilGap(items: array<Node?>): int {
    var total = 0
    for (item in items) {
        val value = item?.value ?? break
        total += value
    }
    total
}

fun sumPresent(items: array<Node?>): int {
    var total = 0
    for (item in items) {
        val value = item?.value ?? continue
        total += value
    }
    total
}

var dropLog = ""

resource class Ticket(val id: int) {
    fun drop(): void {
        dropLog = "$dropLog${this.id};"
    }
}

fun issue(n: int): Ticket? = if (n > 0) Ticket(n) else null

fun ticketId(ticket: Ticket?): int = ticket?.id ?? -1

// Each ticket is dropped once: `??` hands its left side on, `?.` reads a
// parameter or a `val` in place and drops a fresh receiver after the chain.
fun tickets(): string {
    val a = issue(1) ?? Ticket(9)
    val b = issue(0) ?? Ticket(8)
    val c = issue(3)?.id ?? -1
    val d = issue(4)
    val e = ticketId(d)
    val f = move(d) ?? Ticket(7)
    "${a.id} ${b.id} $c $e ${f.id} [$dropLog]"
}

fun parityValue(): string {
    val list = Node(1, Node(2, null, "two"), null)
    val none: Node? = null
    val tally = Tally(0)
    val skipped = none?.add(counted(tally, 5)) ?? 0
    val taken = list.next?.add(counted(tally, 5)) ?? 0
    val bumps = Tally(0)
    none?.bump(bumps)
    list.next?.bump(bumps)
    val a: int? = null
    val b: int? = null
    val c: int? = a ?? b
    val defaults = Tally(0)
    val lazy = list.next?.value ?? counted(defaults, 9)
    "${list.next?.value ?? 0} ${none?.value ?? 0} ${list.next?.next?.value ?? -1} " +
        "${list.next?.name ?? "anon"} ${list.name ?? "anon"} " +
        "${list.next?.name?.size ?? 0} ${none?.name?.size ?? 0} " +
        "$skipped $taken ${tally.count} ${bumps.count} " +
        "${a ?? b ?? 3} ${c == null} ${a ?? 2 + 3} ${a ?? 1 < 2} $lazy ${defaults.count} " +
        "${firstValue(list)} ${firstValue(none)} " +
        "${sumUntilGap([list, list.next, none, list])} ${sumPresent([list, none, list.next])} " +
        "${tickets()} [$dropLog]"
}
