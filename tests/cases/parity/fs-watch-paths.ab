// abla/fs/watch's path parts (what a watch splits each file into: the directory it waits on and the name an inotify
// event carries). The watch itself waits on the kernel (tools/test-fs-watch.sh).
import "abla/fs/watch"

fun parityValue(): string {
    val paths = ["src/main.ab", "main.ab", "/main.ab", "/a/b/c.ab", "a//b.ab", "dir/"]
    var text = ""
    for (path in paths) text = "$text ${fileWatchDirectory(path)}|${fileWatchName(path)}"
    text
}
