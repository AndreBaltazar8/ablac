import "abla/simd"
import "abla/float"

class SimdParityValue(val packed: i8x16, val wide: u32x16, val rounded: f32x4)

fun parityValue(): SimdParityValue {
    val signed = i8x16Splat(i8(-7)).with(0, i8(127)).with(15, i8(-128))
    val low = signed.widenLow() + i16x8Splat(i16(3))
    val high = signed.widenHigh() - i16x8Splat(i16(2))
    val packed = low.narrowSaturating(high).swizzle(u8x16Splat(90).with(0, 15).with(14, 0))
    val values: array<u32> = [7, 22, 31, 50]
    val indices = u32x16Splat(1).with(0, 0).with(15, 3)
    val wide = u32x16Gather(values, indices) ^ u32x16Splat(3)
    val rounded = f32x4(-0.5, 2.5, f32FromBits(u32(1)), -3.5).roundEven()
    SimdParityValue(packed, wide, rounded)
}

fun parityShow(value: SimdParityValue): string =
    value.packed.text() + "|" + value.wide.text() + "|" + value.rounded.asU32x4().text()
