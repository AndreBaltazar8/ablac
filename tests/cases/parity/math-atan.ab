// atan: tiny, the polynomial range, every table range, huge, the refinement
// path and specials: every result's exact bits.
import "abla/float"
import "abla/math"

fun parityValue(): string {
    val inf = 1.0 / 0.0
    val values: array<f64> = [0.0, -0.0, 1e-30, 1e-8, -0.004, 0.0066, 0.05, -0.3, 1.0, 2.5,
        -17.0, 150.0, 152.0, 1e10, -1e17, 1e300, inf, -inf, 0.0 / 0.0, 5e-324,
        f64FromBits(4638708252418983909), f64FromBits(4589168749033815441),
        f64FromBits(4674737572513462061), f64FromBits(4517111708650976914)]
    var text = ""
    for (value in values) {
        val result = atan(value)
        // NaN's sign and payload are unspecified; every other result keeps its bits.
        val bits = if (result != result) "nan" else "${f64ToBits(result)}"
        text = "$text $bits"
    }
    text
}
