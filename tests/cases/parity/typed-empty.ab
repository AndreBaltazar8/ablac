// Typed empty constructors: `array<T>()` and `Map<K, V>()` are the empty
// array and map of that type, as `val x: array<T> = []` and
// `val m: Map<K, V> = Map()` are, wherever an expression goes.
fun counts(): Map<string, int> = Map<string, int>()

fun total(values: array<int>): int {
    var sum = 0
    for (value in values) sum = sum + value
    sum
}

fun parityValue(): string {
    val numbers = array<int>()
    numbers.append(4)
    numbers.append(5)
    val grid = array<array<int>>()
    grid.append(array<int>())
    grid[0].append(7)
    val thunks = array<() -> int>()
    thunks.append({ -> 6 })
    val names = array<string>()
    val tally = counts()
    tally.set("a", 1)
    tally.set("b", 2)
    val lookup = Map<string, array<int>>()
    lookup.set("n", numbers)
    val got = lookup.get("n")
    val gotSize = if (got != null) got.size else -1
    "${numbers.size} ${total(numbers)} ${grid.size} ${grid[0][0]} ${thunks[0]()} " +
        "${names.size} ${tally.size} ${total(array<int>())} $gotSize"
}
