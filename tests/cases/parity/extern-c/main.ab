// extern:"c" calls into the C library the program links. Native code at
// compile time runs in the compiler, so it needs the trusted.native grant.
import "abla/compiler"
#compilerGrant("trusted.native")
noescape extern:"c" fun strlen(text: cstring): int
extern:"c" fun labs(value: int): int

fun parityValue(): string = "${strlen("compile time")} ${labs(-42)} ${strlen("")}"
