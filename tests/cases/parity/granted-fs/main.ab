// Granted filesystem reads: a compile-time read through `abla/fs` sees what
// the program reads at run time.
import "abla/compiler"
import "abla/fs"
#compilerGrant("filesystem.read")

fun parityValue(): string {
    val contents = path("data.txt").readText()
    val info = path("data.txt").info()
    "${contents.size} ${info.size} $contents"
}
