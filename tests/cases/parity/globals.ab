// Program globals read and changed by the computation: a `var` counter, a
// `val` object mutated through, an array global appended to, a global read
// by another global's initializer. Under `#` they hold one value each, made
// by their initializers, as within one run of the program.
class Row(var name: string)
class Store(val rows: array<Row>)

var counter = 0
val store = Store([Row("a"), Row("b")])
val names: array<string> = []
val doubled = counter * 2 + 1

fun bump(amount: int): int {
    counter = counter + amount
    counter
}

fun find(name: string): Row? {
    for (row in store.rows) if (row.name == name) return row
    null
}

fun parityValue(): string {
    bump(2)
    bump(3)
    val found = find("b")
    if (found != null) found.name = "B"
    names.append("x")
    names.append("y")
    "$counter ${store.rows[1].name} ${find("B") != null} ${names.size} $doubled"
}
