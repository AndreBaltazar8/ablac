// hypot: exact and rounded, huge and subnormal, the integer hard path, and
// specials: every result's exact bits.
import "abla/float"
import "abla/math"

fun parityValue(): string {
    val inf = 1.0 / 0.0
    val pairs: array<f64> = [3.0, 4.0, 1e300, 1e300, 1e-300, 1e-300, 5e-324, 5e-324,
        1e-310, 3e-310, 1.7976931348623157e308, 1.0, 1.7976931348623157e308,
        1.7976931348623157e308, 0.7, 0.70000001, 1.0, 1e-20, -0.0, -0.0,
        f64FromBits(4546522236078591796), f64FromBits(4607182418847470541),
        f64FromBits(4072170629410111), f64FromBits(1923495767767979),
        inf, 0.0 / 0.0, 0.0 / 0.0, 2.0]
    var text = ""
    var i = 0
    while (i < pairs.size) {
        val result = hypot(pairs[i], pairs[i + 1])
        // NaN's sign and payload are unspecified; every other result keeps its bits.
        val bits = if (result != result) "nan" else "${f64ToBits(result)}"
        text = "$text $bits"
        i += 2
    }
    text
}
