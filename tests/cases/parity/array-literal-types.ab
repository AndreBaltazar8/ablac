// Array literals take the type expected of them: from a typed local, a
// constructor or function argument, a function's result and its `return`s,
// into nested literals and lambdas, with `null` into `T?`; a literal with no
// context takes the type its elements share (`[[1], []]`, `["x", null]`).
class Bag(val items: array<int?>)

fun rows(values: array<array<int>>): int = values.size

fun grid(): array<array<int>> = [[1, 2], []]

fun maybe(flag: bool): array<string?> {
    if (flag) return ["a", null]
    ["b"]
}

fun parityValue(): string {
    val bytes: array<u8> = [1, 2]
    val ints: array<int?> = [1, null, 3]
    val names: array<string?> = ["x"]
    val nested = [[1], []]
    val mixed = ["x", null]
    val fs: array<(int) -> int> = [{ x -> x + 1 }, { x -> x * 2 }]
    val out: array<(int) -> int> = []
    out.append({ x -> x + 10 })
    val bag = Bag([4, null])
    val second = ints[1]
    val missing = bag.items[1]
    "${bytes.size} ${bytes[1]} ${ints.size} ${second == null} ${names.size} " +
        "${nested[0][0]} ${nested[1].size} ${mixed.size} ${fs[1](4)} ${out[0](1)} " +
        "${bag.items.size} ${missing == null} ${rows([[1], []])} ${grid()[1].size} " +
        "${maybe(true).size} ${maybe(false).size}"
}
