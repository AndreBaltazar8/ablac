// A generator owns its moved captures and the affine locals alive at a
// `yield`: closing it early, finishing it, or dropping it unstarted drops
// them, last first. A kept value moves on into a `defer` or a nested
// generator as anywhere.
var trace = ""

fun note(text: string): void {
    trace = "$trace$text "
    return
}

resource class Ticket(val value: int) {
    fun drop(): void {
        note("drop${this.value}")
        return
    }
}

fun owning(): Generator<int> {
    val t = Ticket(7)
    generator {
        yield t.value
        val u = Ticket(8)
        yield u.value
        yield 3
    }
}

fun deferred(): Generator<int> = generator {
    val t = Ticket(9)
    yield 1
    if (t.value > 0) {
        defer { note("defer${t.value}") }
    }
    yield 2
}

fun nestedOwner(): Generator<int> = generator {
    val t = Ticket(5)
    yield 0
    val inner = generator { yield t.value }
    for (v in inner) yield v
}

fun parityValue(): string {
    for (v in owning()) {
        note("got$v")
        if (v == 8) break
    }
    for (v in owning()) note("got$v")
    for (v in deferred()) note("got$v")
    for (v in nestedOwner()) note("got$v")
    if (trace.size > 0) {
        val unused = owning()
        note("unused")
    }
    trace
}
