// Delegated class properties under `#`: construction runs the `by`
// expression, reads and writes go through the delegate, `obj.^name` reaches it.
class Counted(var current: int, var reads: int, var writes: int) {
    fun getValue(): int {
        reads += 1
        current
    }
    fun setValue(next: int): void {
        writes += 1
        current = next
        return
    }
}

class Tagged(val text: string) {
    fun getValue(): string = "<$text>"
}

class Account(val owner: string, var balance: int by Counted(10, 0, 0), val label by Tagged(owner)) {
    fun deposit(amount: int): void {
        balance += amount
        return
    }
}

fun parityValue(): string {
    val account = Account("ada")
    account.deposit(5)
    account.balance = account.balance * 2
    val before = account.^balance.reads
    account.^balance = Counted(1, 0, 0)
    account.balance += 1
    "${account.label} ${account.balance} $before ${account.^balance.writes}"
}
