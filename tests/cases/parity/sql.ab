// A checked SQL statement keeps its template and bound values across staging.
import "abla/sql"

fun parityValue(): SqlStatement {
    val title: string = "O'Brien"
    val quantity: i32 = 17
    $sql("SELECT ${title}::text, ${quantity}::integer, ${null}::boolean")
}

fun parityShow(statement: SqlStatement): string {
    var result = statement.text
    for (parameter in statement.parameters) {
        result = result + "\n${parameter.kind}:${parameter.isNull}:${parameter.value}"
    }
    result
}
