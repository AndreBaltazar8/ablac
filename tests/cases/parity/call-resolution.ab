// Calls resolve level by level (local, receiver member, top-level) and a
// level captures a call only with a candidate that takes it: a field that
// isn't a function never does (`cos(n)` beside an array field `cos`), nor a
// method of another arity (`widen(x)` beside `fun widen()`, as `u32(x)`
// beside `fun u32()`; the top-level `lerp(a, b, t)` beside
// `fun lerp(other, t)`; `bump(v)` beside `fun bump()`), nor a local that isn't
// a function or takes other arguments. A method of the right arity whose
// parameter types can't take the arguments the syntax shows (a literal, a
// declared local or field, a constructor) lets the call through too:
// `label(7)` beside `fun label(text: string)`, `tag(Vec(1))` beside
// `fun tag(name: string)`, `tag(count)` with `count: int`.
fun scale(x: int): int = x * 10
fun bump(x: int): int = x + 1
fun lerp(a: int, b: int, t: int): int = a + (b - a) * t / 100
fun cos(x: int): int = x * 3
fun twice(x: int): int = x * 2
fun widen(x: int): int = x * 1000
fun label(n: int): string = "n$n"
fun tag(v: Vec): int = v.x + 5
fun tag(n: int): int = n + 50

class Columns(val cos: array<int>) {
    fun fill(n: int): int {
        cos.append(cos(n))
        cos[cos.size - 1]
    }
}

class Reader(val raw: int) {
    fun widen(): int = raw
    fun wide(): int = widen(this.widen())
}

class Vec(val x: int) {
    fun lerp(other: Vec, t: int): Vec = Vec(lerp(x, other.x, t))
}

class Badge(val name: string, val count: int) {
    fun label(text: string): string = "[$text]"
    fun tag(name: string): int = name.size
    fun shown(): string {
        val local: int = 2
        "${label(7)} ${label("x")} ${tag(Vec(1))} ${tag(count)} ${tag(name)} ${label(local)}"
    }
}

class Camera(val scale: int) {
    fun bump(): int = 7
    fun calc(v: int): int = scale(v) + scale + bump(v) + bump()
}

fun run(twice: (int) -> int): int = twice(3)
fun pick(twice: (int, int) -> int): int = twice(5) + twice(1, 2)
fun shadow(): int {
    val cos = 4
    cos(cos)
}

fun parityValue(): string {
    val columns = Columns([])
    val wide = Reader(9).wide()
    "${columns.fill(5)} $wide ${Vec(0).lerp(Vec(200), 50).x} ${Camera(2).calc(4)} " +
        "${run({ v -> v + 100 })} ${pick({ a, b -> a * b })} ${shadow()} " +
        Badge("abc", 4).shown()
}
