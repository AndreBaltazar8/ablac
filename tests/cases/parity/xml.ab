import "abla/xml"
import "abla/xml/write"

// Record the calls emitted by the writer literal without a package dependency.
class XmlParityWriter(var trace: string)

fun ablaXmlWriteLiteralStart(var writer: XmlParityWriter, name: string): void {
    writer.trace += "<$name>"
}

fun ablaXmlWriteLiteralBinding(var writer: XmlParityWriter, prefix: string, uri: string): void {
    writer.trace += "[$prefix=$uri]"
}

fun ablaXmlWriteLiteralText(var writer: XmlParityWriter, value: string): void {
    writer.trace += value
}

fun ablaXmlWriteLiteralEnd(var writer: XmlParityWriter): void {
    writer.trace += "</>"
}

fun parityValue(): string {
    val message = "A & B"
    val document = xmlDocument($xml <élément xmlns="urn:example">{message}</élément>)
    var writer = XmlParityWriter("")
    $xmlw(writer) <entry>{document.root.text()}</entry>
    return "${document.root.localName} ${document.root.namespaceUri} ${writer.trace}"
}
