// Lazy generators: the body runs only as far as the consumer asks, so the trace
// interleaves producer and consumer; breaking, returning or dropping closes a
// generator (its defers run then); an infinite generator ends when its consumer
// stops; a delegated local and a nested generator live across `yield`.
var trace = ""

fun note(text: string): void {
    trace = "$trace$text "
    return
}

fun naturals(): Generator<int> = generator {
    defer { note("closed") }
    var n = 0
    while (true) {
        note("p$n")
        yield n
        n += 1
    }
}

fun pairs(words: array<string>): Generator<string> = generator {
    for (word in words) {
        if (word == "stop") break
        for (c in word) yield "$word:$c"
    }
    for (i in 1..2) yield "r$i"
}

fun firstNatural(): int {
    for (n in naturals()) return n
    -1
}

class Counter(var current: int) {
    fun getValue(): int = current

    fun setValue(next: int): void {
        current = next
        return
    }
}

fun counted(): Generator<int> = generator {
    var count by Counter(10)
    yield count
    count = count + 5
    yield count
}

fun outer(): Generator<int> = generator {
    for (n in naturals()) {
        if (n == 2) break
        yield n * 100
    }
    yield 7
}

fun parityValue(): string {
    for (n in naturals()) {
        note("c$n")
        if (n == 2) break
    }
    note("first${firstNatural()}")
    val unused = naturals()
    note("dropped")
    for (p in pairs(["ab", "c", "stop", "d"])) note(p)
    for (c in counted()) note("k$c")
    for (o in outer()) note("o$o")
    trace
}
