// Transactions under `#`: plain code, with each TVar write kept until the
// outermost `atomic` ends so an `orElse` can put back what its first
// alternative wrote when it retries.
class Queue(var items: string by TVar(""), var taken: int by TVar(0))

fun pop(queue: Queue): string = atomic {
    atomic {
        queue.taken += 1
        if (queue.items == "") retry
        val first = queue.items.slice(0, 1)
        queue.items = queue.items.slice(1, queue.items.size)
        first
    } orElse { "-" }
}

fun parityValue(): string {
    val queue = Queue()
    atomic { queue.items = "ab" }
    val popped = "${pop(queue)}${pop(queue)}${pop(queue)}"
    val counter = TVar(1)
    val doubled = atomic {
        counter.setValue(counter.getValue() * 2)
        atomic { counter.setValue(counter.getValue() + 1) }
        counter.getValue()
    }
    "$popped taken ${atomic { queue.taken }} counter $doubled"
}
