// Trusted raw memory: native cells, loads and stores, addresses. At compile
// time it is the compiler's memory, so it needs the trusted.native grant.
import "abla/unsafe/memory"
import "abla/compiler"
#compilerGrant("trusted.native")

fun parityValue(): string {
    val cell = nativeI64Cell(19)
    val first = cell.load()
    cell.store(first + 23)
    val answer = cell.load()
    val pointerCell = nativePointerCell(cell.address)
    val roundTrip = pointerCell.load() == cell.address
    val pointerReleased = pointerCell.close()
    val released = cell.close()
    val releasedTwice = cell.close()
    "$answer $roundTrip $pointerReleased $released $releasedTwice"
}
