// Json: parse, build, query, stringify; escapes, big numbers, nesting.
import "abla/json"

fun parityValue(): string {
    val parsed = jsonParse(
        "{\"text\":\"line\\n\\uD83D\\uDE00\",\"n\":[-9223372036854775808,9223372036854775808,1.50e+2],\"t\":true,\"z\":null,\"o\":{\"a\":[1,[2,[3]]]}}")
    val built = jsonObject(["k", "list", "deep"], [jsonString("v\"q"),
        jsonArray([jsonInteger(1), jsonBoolean(false), jsonNull()]),
        jsonObject(["x"], [jsonNumberText("2.5e-3")])])
    "${parsed.succeeded} ${jsonStringify(parsed.value)} ${jsonStringify(built)} " +
        "${parsed.value.get("n").size()} ${parsed.value.get("text").asString()}"
}
