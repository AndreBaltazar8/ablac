// Equality: class objects and arrays compare by identity (two equal-looking
// values are different objects; a value reached two ways is one), ints,
// floats, bools and strings by value, and nullable values against null.
class P(val x: int)

class Holder(val p: P, val list: array<int>)

fun parityValue(): string {
    val a = P(1)
    val b = P(1)
    val holder = Holder(a, [1, 2])
    val xs = [1, 2]
    val ys = [1, 2]
    val same = holder.list
    val maybe: P? = if (a.x > 0) a else null
    val none: P? = null
    val m: Map<int, string> = Map()
    m.set(1, "one")
    "${a == b} ${a == a} ${a != b} ${holder.p == a} ${xs == ys} ${xs == xs} " +
        "${same == holder.list} ${maybe == a} ${maybe == null} ${none == null} " +
        "${m.get(2) == null} ${"ab" == "a" + "b"} ${1.5 == 1.5} ${true == !false}"
}
