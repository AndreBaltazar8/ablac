// Extension functions of arrays and maps under `#` and at run time: one per
// element type, taking arguments and lambdas, reading `this`.
fun array<int>.weigh(k: int): int = this[0] + this.size + k
fun array<string>.weigh(k: int): int = this.size * 100 + k

fun array<int>.texts(f: (int) -> string): array<string> {
    val out: array<string> = []
    for (item in this) out.append(f(item))
    out
}

fun Map<string, int>.total(): int {
    var sum = 0
    for (key in this.keys()) {
        val value = this.get(key)
        if (value != null) sum = sum + value
    }
    sum
}

fun parityValue(): string {
    val ages: Map<string, int> = Map()
    ages.set("ada", 36)
    ages.set("alan", 41)
    val words = [1, 2].texts { n -> "w$n" }
    "${[1, 2, 3].weigh(5)} ${["x"].weigh(1)} ${words[1]} ${ages.total()}"
}
