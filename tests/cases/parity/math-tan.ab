// tan across quadrants, near its poles, huge, the accurate path, tiny
// and special arguments: every result's exact bits.
import "abla/float"
import "abla/math"

fun parityValue(): string {
    val values: array<f64> = [0.0, -0.0, 5e-324, 1e-9, -2.0e-7, 0.5, 0.6743, 0.6745,
        -0.7853981633974483, 1.0, 1.5707963267948966, -1.5707963267948966, 2.0, 3.0,
        4.71238898038469, -100.0, 12345.678, 404838.18296667817, -237603.3647799763,
        1e22, -1e300, f64FromBits(4557643147334432083), f64FromBits(4607188761095497408),
        1.0 / 0.0, -1.0 / 0.0]
    var text = ""
    for (value in values) {
        val result = tan(value)
        // NaN's sign and payload are unspecified; every other result keeps its bits.
        val bits = if (result != result) "nan" else "${f64ToBits(result)}"
        text = "$text $bits"
    }
    text
}
