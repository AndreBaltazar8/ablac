// A string promoted out of a region is the same text at run time and under `#`
// (the evaluator's values live in no region, so promotion keeps the value).
import "abla/memory"

fun parityValue(): string {
    val promoted = region {
        val built = "promoted " + "${40 + 2}"
        memoryPromoteString(built)
    }
    val outside = memoryPromoteString("outside")
    "$promoted $outside"
}
