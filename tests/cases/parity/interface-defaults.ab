// Interface defaults called on class values under `#` and at run time: the
// default body runs with `this` the instance, the most specific default
// answers, and an `extend`'s and a generic interface instance's work alike.
interface Shape {
    fun area(): int
    fun describe(): string = "shape of ${this.area()}"
    fun twice(): int = this.area() * 2
}

interface Solid : Shape {
    fun describe(): string = "solid of ${this.area()}"
}

class Square(val side: int) : Shape {
    fun area(): int = this.side * this.side
    fun summary(): string = "${this.describe()} ${this.twice()}"
}

class Cube(val side: int) : Solid {
    fun area(): int = 6 * this.side * this.side
}

class Dot(val x: int)

fun Dot.area(): int = 1

extend Dot : Shape

interface Source<T> {
    fun at(index: int): T?
    fun first(): T? = this.at(0)
}

class Letters(val text: string) : Source<string> {
    fun at(index: int): string? = if (index < this.text.size) this.text.slice(index, index + 1) else null
}

fun parityValue(): string =
    "${Square(3).summary()} ${Cube(1).describe()} ${Cube(2).twice()} ${Dot(5).describe()} ${Letters("xy").first() ?? "-"}"
