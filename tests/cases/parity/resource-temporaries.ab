// A resource is dropped exactly once: a local that is a nested block's value
// moves out with it, and a discarded value (a statement, a loop's body, an
// `if` without `else`) is dropped where it is discarded. The same under `#`.
var log = ""

resource class Ticket(val id: int) {
    fun drop(): void {
        log = "$log${this.id};"
    }
}

fun issue(id: int): Ticket = Ticket(id)

fun take(own t: Ticket): int = t.id

fun step(name: string): void {
    log = "$log$name|"
}

fun nested(c: bool): string {
    step("nested")
    val a = if (c) { val t = issue(1); t } else Ticket(2)
    step("a")
    val b = when (a.id) {
        1 -> {
            val u = Ticket(3)
            u
        }
        else -> Ticket(4)
    }
    step("b")
    val n = take(if (c) { val v = Ticket(5); v } else Ticket(6))
    step("n$n")
    "${a.id} ${b.id}"
}

fun discarded(): void {
    step("discarded")
    Ticket(7)
    step("after7")
    issue(8)
    step("after8")
    if (true) Ticket(9) else Ticket(10)
    step("after9")
    if (true) { val w = Ticket(11); w } else Ticket(12)
    step("after11")
}

fun branches(c: bool): void {
    step("branches")
    if (c) Ticket(13)
    step("after13")
    when (c) {
        true -> Ticket(14)
        else -> Ticket(15)
    }
    step("after14")
    var k = 0
    do {
        k += 1
        Ticket(30 + k)
    } while (k < 2)
    step("afterdo")
    for (m in [40, 41]) Ticket(m)
    step("afterfor")
}

fun loops(): void {
    step("loops")
    var i = 0
    while (i < 2) {
        i += 1
        val t = Ticket(20 + i)
        t
    }
    step("afterloop")
}

// (The log starts empty: compile-time globals keep their values from one
// `#` site to the next.)
fun parityValue(): string {
    log = ""
    val shown = nested(true)
    discarded()
    branches(true)
    loops()
    "$shown [$log]"
}
