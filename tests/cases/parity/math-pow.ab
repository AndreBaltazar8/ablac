// pow: specials, negative bases, the first phase, the cancellation case near 1,
// subnormal and overflowing results, exact powers and midpoints, and worst
// cases that need the 128- and 256-bit phases: every result's exact bits.
import "abla/float"
import "abla/math"

fun parityValue(): string {
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    val pairs: array<f64> = [2.0, 10.0, 2.5, 3.1, -2.0, 3.0, -1.5, -4.0, 0.0, -1.0, -0.0, -3.0,
        1.0, nan, nan, 0.0, -1.0, inf, -8.0, 1.0 / 3.0, inf, -2.0, -inf, 3.0, 0.5, inf,
        1.0001, 7000.5, 0.9997, -2500.25, 1.0000000001, 1e12, 10.0, -310.0, 2.0, -1074.0,
        0.7, 2000.0, 1.3, 2800.0, 262143.0, 3.0, 68718952449.0, 1.5, 0.25, -2.5, 5.0, -3.0,
        5e-324, 0.5, 1e300, 1.0001, f64FromBits(4607904709822147086), 4025.0,
        f64FromBits(4606074068054028878), 3592.0, f64FromBits(4605661336673503158), 3003.0,
        f64FromBits(4835813121993211188), 0.3125]
    var text = ""
    var i = 0
    while (i < pairs.size) {
        val result = pow(pairs[i], pairs[i + 1])
        // NaN's sign and payload are unspecified; every other result keeps its bits.
        val bits = if (result != result) "nan" else "${f64ToBits(result)}"
        text = "$text $bits"
        i += 2
    }
    text
}
