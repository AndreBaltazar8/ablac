// Generators of many shapes: in a method (reading fields), `when` with
// `yield` in some branches, nested loops cut by `yield` with `break`/`continue`, `do`-`while`
// with `continue`, a nullable narrowed before a `yield` and used after it,
// same-named locals of sibling blocks, a captured variable the consumer
// changes between elements, and `return` from inside nested loops.
var trace = ""

fun note(text: string): void {
    trace = "$trace$text "
    return
}

class Box(val label: string, val values: array<int>) {
    fun items(): Generator<string> = generator {
        for (v in values) yield "$label$v"
    }
}

class Node(val name: string)

fun shapes(maybe: Node?): Generator<string> = generator {
    var k = 0
    while (k < 4) {
        when (k) {
            0 -> yield "zero"
            2 -> {
                yield "two"
                yield "two!"
            }
            else -> note("w$k")
        }
        k += 1
    }
    for (i in 0 until 4) {
        if (i == 1) continue
        for (j in 0 until 4) {
            if (j > i) break
            yield "$i$j"
        }
    }
    var d = 0
    do {
        d += 1
        if (d == 2) continue
        yield "d$d"
    } while (d < 3)
    if (maybe != null) {
        yield "n"
        yield maybe.name
    }
    if (k > 0) {
        val same = "first"
        yield same
    }
    if (k > 0) {
        val same = "second"
        yield same
    }
    for (c in "ab") yield "c$c"
}

fun shared(): Generator<int> {
    var seen = 0
    val g = generator {
        while (seen < 100) {
            yield seen
            seen = seen + 10
        }
    }
    seen = 50
    g
}

fun early(): Generator<int> = generator {
    for (i in 0 until 10) {
        for (j in 0 until 10) {
            if (i * j == 6) return
            yield i * 10 + j
        }
        if (i > 3) return
    }
}

fun parityValue(): string {
    for (s in Box("b", [1, 2]).items()) note(s)
    for (s in shapes(Node("node"))) note(s)
    for (s in shapes(null)) note(s)
    for (v in shared()) note("s$v")
    var count = 0
    for (v in early()) count += v
    note("early$count")
    trace
}
