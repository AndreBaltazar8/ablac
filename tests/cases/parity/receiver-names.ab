// Names resolve local, then receiver member, then global: a method calls the
// receiver's methods by name (overloads too, also inside a lambda), an
// extension function reads, assigns and calls the receiver's fields and
// methods by name, and a local or parameter callable is called as itself
// beside a top-level function of the same name.
class Shape(val w: int, var h: int) {
    fun area(): int = w * h
    fun describe(): string = "area ${area()}"
    fun scaled(k: int): Shape = Shape(w * k, h * k)
    fun scaled(k: int, extra: int): Shape = Shape(w * k + extra, h * k)
    fun apply(f: (int) -> int): int = f(area())
    fun twiceArea(): int = apply({ a: int -> a + area() })
    fun grownArea(): int = scaled(2).area() + scaled(2, 1).area()
}

fun Shape.perimeter(): int = 2 * (w + h)

fun Shape.stretch(by: int): int {
    h = h + by
    area() + perimeter()
}

fun area(): int = -1
fun twice(): int = 0
fun op(): int = 0

fun run(twice: (int) -> int): int = twice(21)

fun each(values: array<int>, print: (int) -> int): int {
    var total = 0
    for (value in values) total = total + print(value)
    total
}

fun parityValue(): string {
    val shape = Shape(3, 4)
    val op = { x: int -> x + 1 }
    "${shape.describe()} ${shape.twiceArea()} ${shape.grownArea()} " +
        "${shape.perimeter()} ${shape.stretch(1)} ${shape.h} " +
        "${run({ x: int -> x * 2 })} ${op(1)} ${each([1, 2, 3], { v: int -> v * 10 })} ${area()}"
}
