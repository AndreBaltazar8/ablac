// A `when` over a JsonDecoded that leaves JsonLimitExceeded out does not compile.
import "abla/json"

fun describe(decoded: JsonDecoded): string = when (decoded) {
    is JsonParsed -> "value"
    is JsonMalformed -> "malformed"
}

fun main: int {
    if (describe(jsonDecode("[1]")) == "value") 0 else 1
}
