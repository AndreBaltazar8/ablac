import "../../../src/ct_portable_extern.ab"

fun declaration(source: string): BootstrapDeclaration = bootstrapParse(source).declarations[0]
fun main: int {
    val source = "noescape extern:\"c\" fun test(value: int): int"
    val base = declaration(source)
    if (!bootstrapCtSameExtern(base, declaration(source))) return 1
    if (bootstrapCtSameExtern(base,
        declaration("noescape extern:\"c\" fun test(own value: int): int"))) return 2
    if (bootstrapCtSameExtern(base,
        declaration("noescape extern:\"c\" fun test(var value: int): int"))) return 3
    if (bootstrapCtSameExtern(base,
        declaration("noescape extern:\"c\" fun test(other: int): int"))) return 4
    if (bootstrapCtSameExtern(base,
        declaration("noescape extern:\"c\" fun test(value: int = 1): int"))) return 5
    if (bootstrapCtSameExtern(base, declaration("extern:\"c\" fun test(value: int): int"))) return 6
    if (bootstrapCtSameExtern(base,
        declaration("private noescape extern:\"c\" fun test(value: int): int"))) return 7
    if (bootstrapCtSameExtern(base,
        declaration("trusted noescape extern:\"c\" fun test(value: int): int"))) return 8
    val kinds = declaration(source)
    kinds.parameterKinds.append("own")
    if (bootstrapCtSameExtern(base, kinds)) return 9
    val defaults = declaration(source)
    defaults.parameterDefaults.append(BootstrapExpression("missing", "", 0, 0, []))
    if (bootstrapCtSameExtern(base, defaults)) return 10
    val names = declaration(source)
    names.parameters.append("extra")
    if (bootstrapCtSameExtern(base, names)) return 11
    val types = declaration(source)
    types.parameterTypes.append("int")
    if (bootstrapCtSameExtern(base, types)) return 12
    42
}
