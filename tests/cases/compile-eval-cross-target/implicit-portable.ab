class Counter(val base: int)
val STEP: int = 2 * 3
val Counter.total: int = this.base + STEP

compile fun sumDefaults(): int {
    var sum = 0
    for (base in 6 until 10) {
        val counter = Counter(base)
        sum += counter.total + counter.total
    }
    sum
}

val RESULT = #sumDefaults()

@export("run")
fun run(): int = if (RESULT == 108 && Counter(36).total == 42) 42 else 1
