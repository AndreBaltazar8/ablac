import "abla/crypto"
import "abla/text"
import "abla/fs"
import "abla/compiler"

#compilerGrant("filesystem.read")

compile fun wrapping(): int {
    var value = 9223372036854775807
    value += 1
    value
}
compile fun shifted(): int {
    var value = -1
    (value >>> 63) + (1 << 65)
}
compile fun textAndArray(): string {
    if ("prefix/α/asset.png".lastIndexOf("/") != 9) return "bad path"
    if (textFindSequence("xéyz", "é", 1, 3) != 1) return "bad sequence"
    if (textFindSequence("xéyz", "", 2, 4) != 2) return "bad empty sequence"
    if (textFindSequence("xéyz", "é", -1, 5) != -1) return "bad bounds"
    if (textFindSequence("prefix-ABCD", "ABCD", 0, 11) != 7) return "bad four-byte tail"
    if (textFindSequence("prefix-ABCE", "ABCD", 0, 11) != -1) return "bad four-byte miss"
    if (textFindSequence("pre-ABCDE", "ABCDE", 0, 9) != 4) return "bad long tail"
    if (textFindSequence("pre-ABCDF", "ABCDE", 0, 9) != -1) return "bad long miss"
    val values: array<int> = [1, 2]
    values.append(3)
    var result = ""
    for (value in values) result = "$result$value"
    result.slice(1, 3)
}
class Pair(val left: int, val right: string)

class Counter(var value: int)
compile fun mutated(): int {
    val values: array<int> = [1, 2]
    val counter = Counter(0)
    counter.value = 40
    values[0] = 2
    counter.value + values[0]
}

val WRAPPED = #wrapping()
val MUTATED = #mutated()
val SHIFTED = #shifted()
val TEXT = #textAndArray()
val PAIR = #Pair(42, "portable")
val DIGEST = #hexEncode(sha256(path("tests/cases/compile-eval-cross-target/data.txt").readText()))

@export("run")
fun run(): int {
    if (WRAPPED != -9223372036854775808 || SHIFTED != 1 || TEXT != "23") return 1
    if (MUTATED != 42) return 4
    if (PAIR.left != 42 || PAIR.right != "portable") return 2
    if (DIGEST != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") return 3
    42
}
