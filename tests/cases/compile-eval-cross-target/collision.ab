import "abla/bytes"
// Same machine signature as host runtime getpid, different trust metadata.
// An unselected call still keeps this declaration in the full host slice.
noescape extern:"c" fun getpid(): i32
compile fun collision(): int = if (ablaAtCompileTime()) 42 else int(getpid())
val VALUE = #collision()
@export("run")
fun run(): int = VALUE
