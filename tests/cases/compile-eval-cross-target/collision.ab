import "abla/bytes"
import "abla/unsafe/memory"
// Same machine signature as host runtime write, different trust metadata.
// An unselected call still keeps this declaration in the full host slice.
noescape extern:"c" fun write(descriptor: int, data: i64*, length: int): int
compile fun collision(): int = if (ablaAtCompileTime()) 42 else write(2, nativeNullPointer(), 0)
val VALUE = #collision()
@export("run")
fun run(): int = VALUE
