import "abla/compiler"
import "abla/bytes"
#compilerGrant("trusted.native")
noescape extern:"c" fun abs(value: i32): i32
val FOREIGN = int(abs(i32(-42)))
class Probe
val Probe.extra: int = if (ablaAtCompileTime()) 42 else FOREIGN

// Retaining the default's full body also retains FOREIGN. The host slice
// would initialize it even though the default's compile-time arm skips it.
val PORTABLE = #(6 * 7)
@export("run")
fun run(): int = if (Probe().extra == 42) PORTABLE else 1
