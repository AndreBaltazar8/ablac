import "abla/compiler"
#compilerGrant("trusted.native")
noescape extern:"c" fun abs(value: i32): i32
val FOREIGN = int(abs(i32(-42)))
class Probe
val Probe.extra: int = FOREIGN

// The extension default is an implicit slice root, although this site does
// not reach it. It must not introduce an unproven eager global initializer.
val PORTABLE = #(6 * 7)
@export("run")
fun run(): int = if (Probe().extra == 42) PORTABLE else 1
