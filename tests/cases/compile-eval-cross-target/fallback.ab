import "abla/uint128"
import "fake/stdlib/abla/entry.ab"
import "abla/bytes"
import "abla/compiler"
import "abla/compiler/parser"
import "abla/unsafe/memory/raw"

#compilerGrant("trusted.native")
noescape extern:"c" fun abs(value: i32): i32

// The evaluator answers false; an emission-derived width probe must keep that
// behavior in a cross-target site rather than silently using the host backend.
sealed interface Shape
class ShapeCounter(val value: int): Shape
compile fun classify(value: Shape): int = when (value) {
    is ShapeCounter -> value.value
}
val WHEN = #classify(ShapeCounter(42))

val NARROW = #ablaU128NarrowTarget()
val PORTABLE = #(6 * 7)

compile fun known(): int = 42
val FAKE = #unprovedFloat()
val INDIRECT = #((if (true) known else known)())
val QUERY = #compilerFindFunction("known")
val PARSER = #syntaxKind(syntaxInteger(42)).size

// A builtin-looking method name must still follow its real declaration.
class Probe {
    fun append(): int = int(abs(i32(-42)))
}
val METHOD = #Probe().append()

// Both tiers take the compile-time arm. Only the unselected native arm may
// contain an operation outside the portability proof.
compile fun phaseSkipped(): int =
    if (ablaAtCompileTime()) 42 else int(abs(i32(-42)))
compile fun phaseSelected(): int =
    if (ablaAtCompileTime()) int(abs(i32(-42))) else 42
val SKIPPED = #phaseSkipped()
val SELECTED = #phaseSelected()

// Unlike an unselected call, a kept global initializer runs when a native
// slice starts. It needs its own proof even if the site never reads it.
val FOREIGN_GLOBAL = int(abs(i32(-42)))
compile fun phaseGlobal(): int = if (ablaAtCompileTime()) 42 else FOREIGN_GLOBAL
val GLOBAL = #phaseGlobal()

trusted fun rawPointer(): int =
    if (pointerIsNull(nativeNullPointer())) 42 else 1
val RAW = #rawPointer()

@export("run")
fun run(): int = if (!NARROW && INDIRECT == 42 && METHOD == 42 &&
    SKIPPED == 42 && SELECTED == 42 && RAW == 42 && WHEN == 42 && FAKE == 42 && GLOBAL == 42 &&
    QUERY >= 0 &&
    PARSER ==
    7) PORTABLE else 1
