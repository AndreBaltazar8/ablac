import "abla/float"
import "abla/float/text"

// Until bit-identical float computation is proved, these sites must retain
// the evaluator's signed-zero, NaN payload and conversion behavior.
val TABLE_READ = #(F64_PARSE_TENS[0] == F64_PARSE_TENS[0])
val N32 = #(f32(0.0) / f32(0.0))
val N64 = #(0.0 / 0.0)
val Z32 = #f32(-0.0)
val Z64 = #(-0.0)
val CONVERTED = #f64ToInt(3.75)
val WIDENED = #f32ToF64(f32(1.5))
@export("run")
fun run(): int {
    if (!TABLE_READ || N32 == N32 || N64 == N64) return 1
    if (f32ToBits(Z32) != u32(2147483648)) return 2
    if (f64ToBits(Z64) != -9223372036854775808) return 3
    if (CONVERTED != 3 || WIDENED != 1.5) return 4
    42
}
