// A rope (a string over 64 bytes from a concatenation) first read inside a memory checkpoint it is older than keeps its
// flat copy through the reset (tools/test-rope-checkpoint.sh). sha256 reads a string's bytes, which makes the copy; the
// hash of each rope after its reset, with the freed memory reused by later strings, must still be the one of the same
// text read where no checkpoint is. Only booleans cross a reset: what was made after a checkpoint is freed by it.
import "abla/io"
import "abla/memory"
import "abla/crypto"

/** `seed` doubled until it is at least `size` bytes: a rope once over 64 bytes. */
fun built(seed: string, size: int): string {
    var text = seed
    while (text.size < size) text = text + text
    text
}

/** Flat strings of the sizes the copies had (sha256 makes each copy), to reuse what a reset freed. */
fun churn(): int {
    var total = 0
    for (round in 0 until 8) total = total + sha256(built("z$round", 100 + round * 30000)).size
    total
}

fun main {
    var bad = ""
    for (size in [100, 5000, 200000]) {
        val reference = sha256(built("abcdefgh", size))

        // One checkpoint.
        val one = built("abcdefgh", size)
        val checkpoint = memoryCheckpoint()
        val insideRight = sha256(one) == reference
        memoryReset(checkpoint)
        churn()
        if (!insideRight || sha256(one) != reference) bad = "$bad one:$size"

        // Nested: a rope older than all three, first read in the innermost, and read again after each reset.
        val older = built("abcdefgh", size)
        val outer = memoryCheckpoint()
        val middle = memoryCheckpoint()
        val between = built("abcdefgh", size)
        val inner = memoryCheckpoint()
        val olderRight = sha256(older) == reference
        val betweenRight = sha256(between) == reference
        memoryReset(inner)
        churn()
        val olderAfterInner = sha256(older) == reference
        val betweenAfterInner = sha256(between) == reference
        memoryReset(middle)
        churn()
        val olderAfterMiddle = sha256(older) == reference
        memoryReset(outer)
        churn()
        val olderAfterOuter = sha256(older) == reference
        if (!olderRight || !olderAfterInner || !olderAfterMiddle || !olderAfterOuter) bad = "$bad nested-older:$size"
        if (!betweenRight || !betweenAfterInner) bad = "$bad nested-between:$size"

        // A marker the next checkpoint reuses.
        val oldest = built("abcdefgh", size)
        val last = memoryCheckpoint()
        val oldestRight = sha256(oldest) == reference
        memoryReset(last)
        val again = memoryCheckpoint()
        churn()
        memoryReset(again)
        if (!oldestRight || sha256(oldest) != reference) bad = "$bad reused-marker:$size"
    }
    println(if (bad == "") "rope checkpoint ok" else "rope checkpoint failed:$bad")
}
