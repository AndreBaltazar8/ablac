    near("libcCosh", 710.0, libcCosh(710.0), 1.1169973830808557e+308)
    near("libcCosh", -710.39999999999998, libcCosh(-710.39999999999998), 1.6663642832806494e+308)
    near("libcTanh", 0.10000000000000001, libcTanh(0.10000000000000001), 0.099667994624955819)
    near("libcTanh", 0.90000000000000002, libcTanh(0.90000000000000002), 0.71629787019902447)
    near("libcTanh", -3.5, libcTanh(-3.5), -0.99817789761119868)
    near("libcTanh", 0.0001, libcTanh(0.0001), 9.9999999666666682e-05)
    near("libcTanh", 21.5, libcTanh(21.5), 1.0)
    near("libcTanh", 0.58999999999999997, libcTanh(0.58999999999999997), 0.52989560752752929)
    near("libcTanh", 0.60999999999999999, libcTanh(0.60999999999999999), 0.54412709885356736)
    near("libcTanh", -9.9999999999999998e-13, libcTanh(-9.9999999999999998e-13), -9.9999999999999998e-13)
    near("libcAsin", 0.5, libcAsin(0.5), 0.52359877559829893)
    near("libcAsin", 0.999, libcAsin(0.999), 1.5260712396261631)
    near("libcAsin", -0.25, libcAsin(-0.25), -0.25268025514207865)
    near("libcAsin", 0.001, libcAsin(0.001), 0.0010000001666667416)
    near("libcAsin", -0.75, libcAsin(-0.75), -0.848062078981481)
    near("libcAsin", 1.0, libcAsin(1.0), 1.5707963267948966)
    near("libcAsin", -1.0, libcAsin(-1.0), -1.5707963267948966)
    near("libcAsin", 0.99999998999999995, libcAsin(0.99999998999999995), 1.5706549054381862)
    near("libcAcos", 0.5, libcAcos(0.5), 1.0471975511965979)
    near("libcAcos", 0.999, libcAcos(0.999), 0.044725087168733454)
    near("libcAcos", -0.25, libcAcos(-0.25), 1.8234765819369754)
