    near("libcAcos", -0.75, libcAcos(-0.75), 2.4188584057763776)
    near("libcAcos", 1.0, libcAcos(1.0), 0.0)
    near("libcAcos", -1.0, libcAcos(-1.0), 3.1415926535897931)
    near("libcAcos", 0.99999998999999995, libcAcos(0.99999998999999995), 0.00014142135671046477)
    near("libcErf", 0.10000000000000001, libcErf(0.10000000000000001), 0.1124629160182849)
    near("libcErf", 0.90000000000000002, libcErf(0.90000000000000002), 0.79690821242283216)
    near("libcErf", -2.25, libcErf(-2.25), -0.99853728341331882)
    near("libcErf", 4.5, libcErf(4.5), 0.99999999980338394)
