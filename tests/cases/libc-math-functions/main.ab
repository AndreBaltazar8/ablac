    near("libcLog2Export", 10.0, libcLog2Export(10.0), 3.3219280948873622)
    near("libcLog2Export", 0.29999999999999999, libcLog2Export(0.29999999999999999), -1.7369655941662063)
    near("libcLog2Export", 1000000.0, libcLog2Export(1000000.0), 19.931568569324174)
    near("libcLog2Export", 2.0, libcLog2Export(2.0), 1.0)
    near("libcLog2Export", 12345.678, libcLog2Export(12345.678), 13.59171844813855)
    near("libcLog2Export", 0.0012340000000000001, libcLog2Export(0.0012340000000000001), -9.6624418901747564)
    near("libcLog2Export", 9.9999999999999694e-311, libcLog2Export(9.9999999999999694e-311), -1029.7977094150824)
    near("libcLog2Export", 1.0000000000000001e+300, libcLog2Export(1.0000000000000001e+300), 996.57842846620872)
    near("libcLog2Export", 1000.0, libcLog2Export(1000.0), 9.965784284662087)
    near("libcLog2Export", 0.001, libcLog2Export(0.001), -9.965784284662087)
    near("libcLog2Export", 8.0, libcLog2Export(8.0), 3.0)
    near("libcLog2Export", 0.125, libcLog2Export(0.125), -3.0)
    near("libcLog10", 10.0, libcLog10(10.0), 1.0)
    near("libcLog10", 0.29999999999999999, libcLog10(0.29999999999999999), -0.52287874528033762)
    near("libcLog10", 1000000.0, libcLog10(1000000.0), 6.0)
    near("libcLog10", 2.0, libcLog10(2.0), 0.3010299956639812)
    near("libcLog10", 12345.678, libcLog10(12345.678), 4.0915149455092017)
    near("libcLog10", 0.0012340000000000001, libcLog10(0.0012340000000000001), -2.9086848403027772)
    near("libcLog10", 9.9999999999999694e-311, libcLog10(9.9999999999999694e-311), -310.0)
    near("libcLog10", 1.0000000000000001e+300, libcLog10(1.0000000000000001e+300), 300.0)
    near("libcLog10", 1000.0, libcLog10(1000.0), 3.0)
    near("libcLog10", 0.001, libcLog10(0.001), -3.0)
    near("libcLog10", 8.0, libcLog10(8.0), 0.90308998699194354)
    near("libcLog10", 0.125, libcLog10(0.125), -0.90308998699194354)
    near("libcLogb", 10.0, libcLogb(10.0), 3.0)
    near("libcLogb", 0.29999999999999999, libcLogb(0.29999999999999999), -2.0)
    near("libcLogb", 1000000.0, libcLogb(1000000.0), 19.0)
    near("libcLogb", 2.0, libcLogb(2.0), 1.0)
    near("libcLogb", 12345.678, libcLogb(12345.678), 13.0)
    near("libcLogb", 0.0012340000000000001, libcLogb(0.0012340000000000001), -10.0)
    near("libcLogb", 9.9999999999999694e-311, libcLogb(9.9999999999999694e-311), -1030.0)
    near("libcLogb", 1.0000000000000001e+300, libcLogb(1.0000000000000001e+300), 996.0)
    near("libcLogb", 1000.0, libcLogb(1000.0), 9.0)
    near("libcLogb", 0.001, libcLogb(0.001), -10.0)
    near("libcLogb", 8.0, libcLogb(8.0), 3.0)
    near("libcLogb", 0.125, libcLogb(0.125), -3.0)
    near("libcLog1p", 0.0001, libcLog1p(0.0001), 9.9995000333308339e-05)
    near("libcLog1p", 3.0, libcLog1p(3.0), 1.3862943611198906)
    near("libcLog1p", -0.5, libcLog1p(-0.5), -0.69314718055994529)
    near("libcLog1p", 9.9999999999999995e-21, libcLog1p(9.9999999999999995e-21), 9.9999999999999995e-21)
    near("libcLog1p", -0.999, libcLog1p(-0.999), -6.9077552789821359)
    near("libcLog1p", 10000000000.0, libcLog1p(10000000000.0), 23.025850930040455)
    near("libcLog1p", -1.0000000000000001e-09, libcLog1p(-1.0000000000000001e-09), -1.0000000005000001e-09)
    // Special cases.
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    val specials = libcSinh(inf) == inf && libcSinh(-inf) == -inf && libcSinh(nan) != libcSinh(nan) &&
        libcCosh(-inf) == inf && libcCosh(0.0) == 1.0 && libcTanh(inf) == 1.0 && libcTanh(-inf) == -1.0 &&
        libcTanh(1000.0) == 1.0 && libcAsin(1.5) != libcAsin(1.5) && libcAcos(-1.5) != libcAcos(-1.5) &&
        libcAcos(1.0) == 0.0 && libcErf(inf) == 1.0 && libcErf(-inf) == -1.0 && libcErf(0.0) == 0.0 &&
        libcLog2Export(0.0) == -inf && libcLog2Export(-1.0) != libcLog2Export(-1.0) && libcLog2Export(inf) == inf &&
        libcLog10(0.0) == -inf && libcLog10(-2.0) != libcLog10(-2.0) && libcLog1p(-1.0) == -inf &&
        libcLog1p(-2.0) != libcLog1p(-2.0) && libcLog1p(0.0) == 0.0 && libcLogb(0.0) == -inf && libcLogb(inf) == inf &&
        libcLogb(-inf) == inf && libcLogb(0.75) == -1.0 && libcLogb(5e-324) == -1074.0
    if (!specials) { failures += 1; println("a special case is wrong") }
    // Exact answers: a power of two for log2, a power of ten for log10.
    var k = -1000
    var exact = true
    while (k <= 1000) {
        val twos = libcLog2Export(m2(k))
        if (twos != f64FromInt(k)) exact = false
        k += 1
    }
    var p = -22
    while (p <= 22) {
        var v = 1.0
        var i = 0
        while (i < (if (p < 0) 0 - p else p)) { v = if (p < 0) v / 10.0 else v * 10.0; i += 1 }
        if (p >= 0 && libcLog10(v) != f64FromInt(p)) exact = false
        i = 0
        p += 1
    }
    if (!exact) { failures += 1; println("log2 or log10 of a power is not exact") }
    // Odd symmetry and the sum of the circular inverses.
    near("asin+acos", 0.3, libcAsin(0.3) + libcAcos(0.3), 1.5707963267948966)
    near("sinh odd", 2.0, libcSinh(-2.0), 0.0 - libcSinh(2.0))
    near("erf odd", 0.7, libcErf(-0.7), 0.0 - libcErf(0.7))
    // Single precision.
    val f = libcLog2f(f64ToF32(10.0))
    if (f != f64ToF32(3.321928)) { failures += 1; println("log2f(10) = $f") }
    if (failures == 0) { println("libc math functions: ok"); return 42 }
    1
}

fun m2(k: int): f64 {
    var v = 1.0
    var i = 0
    val steps = if (k < 0) 0 - k else k
    while (i < steps) {
        v = if (k < 0) v / 2.0 else v * 2.0
        i += 1
    }
    v
}
