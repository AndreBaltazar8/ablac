// The math functions the statically linked compiler's C library exports (src/static_libc/math2.ab, #806 step C), called as the ordinary functions
// they are: each result within 4 units in the last place of the values a C library gives (the table is glibc's, to 17 digits), the C standard's
// special cases, and the exact answers log2 and log10 owe their powers. The program exits 42.
import "abla/io"
import "abla/float"
import "abla/float/text"
import "../../../src/static_libc/math2.ab"

var failures = 0

fun ulps(a: f64, b: f64): int {
    if (a != a || b != b) return if (a != a && b != b) 0 else 1000000
    if (a == b) return 0
    val x = f64ToBits(a)
    val y = f64ToBits(b)
    if ((x < 0) != (y < 0)) return 1000000
    val d = x - y
    if (d < 0) 0 - d else d
}

fun near(name: string, x: f64, got: f64, want: f64) {
    val d = ulps(got, want)
    if (d > 4) {
        failures += 1
        println("$name($x) = $got, wanted $want ($d ulps)")
    }
}

fun main: int {
    near("libcSinh", 0.29999999999999999, libcSinh(0.29999999999999999), 0.3045202934471426)
    near("libcSinh", 1.7, libcSinh(1.7), 2.6456319338372323)
    near("libcSinh", -5.25, libcSinh(-5.25), -95.280510470115402)
    near("libcSinh", 25.5, libcSinh(25.5), 59358004566.084824)
