// A private key whose primes differ in size (2049 and 3073 bits: the modulus's top byte is 1; 3071 and 2100 bits with a
// 1000- and a 1100-bit prime), used through the files of tools/test-rsa-unbalanced.sh:
//   sign KEY MESSAGE PKCS1_SIGNATURE PSS_SIGNATURE      decrypt KEY CIPHERTEXT PLAINTEXT      bits KEY
import "abla/crypto/rsa"
import "abla/crypto/rsapss"
import "abla/fs"
import "abla/io"
import "abla/process/arguments"

fun main: int {
    val mode = processArgument(0)
    val key = rsaPrivateKeyFromPem(path(processArgument(1)).readText())
    if (!key.ok()) {
        println("rsa-unbalanced: the key is refused: ${key.error}")
        return 2
    }
    if (mode == "bits") {
        println("${key.bits}")
        return 0
    }
    if (mode == "sign") {
        val message = path(processArgument(2)).readText()
        val pkcs1 = key.signPkcs1Sha256(message)
        val pss = key.signPssSha256(message)
        if (!pkcs1.ok || !pss.ok) {
            println("rsa-unbalanced: signing failed: ${pkcs1.error} ${pss.error}")
            return 3
        }
        return if (path(processArgument(3)).writeText(pkcs1.bytes) && path(processArgument(4)).writeText(pss.bytes)) 0 else 4
    }
    if (mode == "decrypt") {
        val plain = key.decryptOaepSha256(path(processArgument(2)).readText())
        if (!plain.ok) {
            println("rsa-unbalanced: decryption failed: ${plain.error}")
            return 5
        }
        return if (path(processArgument(3)).writeText(plain.bytes)) 0 else 6
    }
    64
}
