// Independent globals keep declaration order also when one initializer calls into the standard library (#1033):
// memorySetTrace reads a runtime global, declared after this module's, and `filled` used to wait for it, so the
// later `seen` went first and read the array before fill() wrote it. Exits 42.
import "abla/memory"

var items: array<int> = []

fun fill(): int {
    items.append(1)
    items.append(2)
    items.append(3)
    memorySetTrace(false)
    items.size
}

val filled = fill()
val seen = items.size

fun main: int = if (filled == 3 && seen == 3) 42 else 10 + seen
