// stdlib-call.ab under `#` (#1033): the first site fills a compile var and calls into the standard library, and the
// later interpreted site reads the compile var. It ran first and read the empty array, in both tiers. Exits 42.
import "abla/compiler"
import "abla/memory"

compile var items: array<int> = []

compile fun fill(): int {
    items.append(1)
    items.append(2)
    items.append(3)
    memorySetTrace(false)
    items.size
}

// Naming a compiler API call that takes a function keeps a site in the interpreter (the call itself never runs).
compile fun interpreted(value: int): int {
    if (value < 0) compilerApplyTransform({ })
    value
}

val filled = #fill()
val seen = #interpreted(items.size)

fun main: int = if (filled == 3 && seen == 3) 42 else 10 + seen
