// A module value demanded only while lowering (here through an extension
// method call, which source reachability does not follow) must see the
// values its initializer reads already stored.
import "abla/io"
import "./box.ab"
import "./text.ab"

fun main: int {
    val box = Box(1)
    val text = box.describe()
    println(text)
    if (text == "<inner>|<inner>") 0 else 1
}
