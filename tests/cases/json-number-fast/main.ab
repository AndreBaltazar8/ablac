// jsonParse's one-pass integers and shared null/true/false leaves against the general number path
// (jsonNumberText): every string over a number alphabet up to four bytes, integers of 1 to 21 digits with and
// without a sign, a leading zero and a boundary byte after them, in a bare value, an array and an object.
import "abla/io"
import "abla/json"

var failures = 0
var checks = 0

fun bad(label: string): void {
    failures += 1
    if (failures < 20) println("FAIL $label")
    return
}

fun sameNumber(a: Json, b: Json): bool = a.kind == b.kind && a.intValue == b.intValue &&
    a.numberValue.text == b.numberValue.text && a.numberValue.integer == b.numberValue.integer &&
    a.numberValue.intValue == b.numberValue.intValue && a.numberValue.intAvailable == b.numberValue.intAvailable


fun checkText(text: string): void {
    checks += 1
    val reference = jsonNumberText(text)
    val bare = jsonParse(text, jsonPermissiveLimits)
    if (reference.kind == 2) {
        if (!bare.succeeded || !sameNumber(bare.value, reference)) bad("bare '$text'")
        val inArray = jsonParse("[$text,$text ]", jsonPermissiveLimits)
        if (!inArray.succeeded || inArray.value.values.size != 2 ||
            !sameNumber(inArray.value.values[0], reference) ||
            !sameNumber(inArray.value.values[1], reference)) bad("array '$text'")
        val inObject = jsonParse("{\"k\":$text}", jsonPermissiveLimits)
        if (!inObject.succeeded || inObject.value.values.size != 1 ||
            !sameNumber(inObject.value.values[0], reference)) bad("object '$text'")
    } else if (bare.succeeded && bare.value.kind == 2) bad("accepted '$text'")
    return
}

fun main: int {
    val alphabet = "019-+.eE"
    var one = 0
    while (one < alphabet.size) {
        checkText(alphabet.slice(one, one + 1))
        var two = 0
        while (two < alphabet.size) {
            checkText(alphabet.slice(one, one + 1) + alphabet.slice(two, two + 1))
            var three = 0
            while (three < alphabet.size) {
                checkText(alphabet.slice(one, one + 1) + alphabet.slice(two, two + 1) +
                    alphabet.slice(three, three + 1))
                var four = 0
                while (four < alphabet.size) {
                    checkText(alphabet.slice(one, one + 1) + alphabet.slice(two, two + 1) +
                        alphabet.slice(three, three + 1) + alphabet.slice(four, four + 1))
                    four += 1
                }
                three += 1
            }
            two += 1
        }
        one += 1
    }
    val first = ["1", "9", "10", "5"]
    for (sign in ["", "-"]) {
        for (head in first) {
            var length = 0
            var body = head
            while (length < 22) {
                checkText("$sign$body")
                checkText("${sign}0$body")
                body = "${body}7"
                length += 1
            }
        }
    }
    checkText("9223372036854775807")
    checkText("9223372036854775808")
    checkText("-9223372036854775808")
    checkText("-9223372036854775809")
    checkText("999999999999999999")
    checkText("1000000000000000000")
    checkText("-0")
    checkText("0")
    val leaves = jsonParse("[null,true,false,null,true,false]")
    if (!leaves.succeeded || leaves.value.values.size != 6) bad("leaves parse")
    else {
        val v = leaves.value.values
        if (v[0].kind != 0 || v[3].kind != 0) bad("null kind")
        if (v[1].kind != 3 || !v[1].boolValue || v[4].kind != 3 || !v[4].boolValue) bad("true")
        if (v[2].kind != 3 || v[2].boolValue || v[5].kind != 3 || v[5].boolValue) bad("false")
    }
    if (failures == 0) println("json-number-fast ok ($checks texts)")
    else println("json-number-fast FAILED: $failures")
    return if (failures == 0) 0 else 1
}
