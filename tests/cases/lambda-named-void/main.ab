// A lambda whose body is a single assignment is a `() -> void` where a void function is expected, also when the call
// passes a named argument (named arguments become temporaries; the lambda's temporary kept no expected type).
class Flag(var on: bool)
val flag = Flag(true)

fun take(onClose: () -> void, extra: bool = false): int {
    onClose()
    if (extra) 1 else 0
}

fun main: int {
    val a = take({ -> flag.on = false })
    flag.on = true
    val b = take({ -> flag.on = false }, extra = true)
    val c = take(extra = true, onClose = { -> flag.on = false })
    if (flag.on || a != 0 || b != 1 || c != 1) return 1
    42
}
