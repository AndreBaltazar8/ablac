import "abla/io"
// A bool crossing an extern:"c" declaration and the program's own @export of that symbol (a hook: the result and a
// parameter are bool, the thunk takes the extern's signature).
extern:"c" fun mockReady(flag: bool, count: i32): bool
extern:"c" fun mockInverted(flag: bool): bool

@export("mockReady")
fun readyImplementation(flag: bool, count: i32): bool = flag && count > 1

@export("mockInverted")
fun invertedImplementation(flag: bool): bool = !flag

fun main: int {
    println("${mockReady(true, 2)} ${mockReady(true, 1)} ${mockInverted(false)}")
    if (mockReady(true, 2) && !mockReady(true, 1) && mockInverted(false) && !mockInverted(true)) 7 else 1
}
