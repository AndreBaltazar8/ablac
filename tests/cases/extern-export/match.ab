import "abla/io"
// An extern:"c" declaration and the program's own @export of that symbol: the same signature (a nominal scalar is
// its underlying type, the symbol may be one of an array of names).
type Handle = int
extern:"c" fun mockDelay(milliseconds: int): int
extern:"c" fun mockPair(handle: Handle, scale: i32): i64
extern:"c" fun mockAlias(value: int): i32

@export("mockDelay")
fun delayImplementation(milliseconds: int): int = milliseconds * 2

@export(["mockPair", "mockPairAgain"])
fun pairImplementation(handle: int, scale: i32): i64 = handle * i64(scale)

@export("mockAlias")
fun aliasImplementation(value: int): i32 = if (value > 0) 1 else 0

fun main: int {
    println("${mockDelay(5)} ${mockPair(Handle(3), 4)} ${mockAlias(1)}")
    if (mockDelay(5) == 10 && mockPair(Handle(3), 4) == 12 && mockAlias(1) == 1) 42 else 1
}
