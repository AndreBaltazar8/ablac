// The platform: local definitions; platformOutput (lowered as a source root) calls the other hook, whose definition
// nothing the program reaches calls. A live run binds the hooks by symbol lookup, so both must be there.
import "hal.ab"
@exportLocal("live_pin_output")
trusted fun platformOutput(pin: int): void = LivePin(pin).pull(true)
@exportLocal("live_pin_pull")
trusted fun platformPull(pin: int, up: bool): void { return }
