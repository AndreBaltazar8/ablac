// The interface (tools/test-extern-export.sh, live): two hooks and the methods that call them.
type LivePin = int
noescape extern:"c" fun live_pin_output(pin: int): void
noescape extern:"c" fun live_pin_pull(pin: int, up: bool): void
trusted fun LivePin.output(): void { live_pin_output(int(this)) }
trusted fun LivePin.pull(up: bool): void { live_pin_pull(int(this), up) }
