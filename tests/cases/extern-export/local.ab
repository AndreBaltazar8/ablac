import "abla/io"
// @exportLocal: the definition binds only this program's own extern:"c" declarations of the name. localPin is called:
// it links (internal) and runs; localIdle is declared and never called: it is not in the program at all. plainIdle is
// an ordinary @export nobody calls: it stays a global symbol, as before.
extern:"c" fun localPin(pin: int, level: int): int
extern:"c" fun localIdle(pin: int): int

@exportLocal("localPin")
fun pinImplementation(pin: int, level: int): int = pin * 10 + level

@exportLocal("localIdle")
fun idleImplementation(pin: int): int = pin + 1000

@export("plainIdle")
fun plainImplementation(pin: int): int = pin + 2000

fun main: int {
    println("${localPin(4, 2)}")
    if (localPin(4, 2) == 42) 42 else 1
}
