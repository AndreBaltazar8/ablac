import "abla/io"
import "other.ab"

// Everything the compiler names after where it is in the source: lambdas
// (in functions, overloads, methods, extensions, globals, default
// parameters, generics' instances, nested), a generator's slots, and the
// locals `??`, `?.` and named arguments introduce.
class Box(val v: int?)
fun pick(first: int, second: int = 3): int = first * 10 + second
fun apply(x: int, f: (int) -> int = { y: int -> y + 100 }): int = f(x)
fun g(a: int): int { val h = { x: int -> x + a }; return h(1) }
fun g(a: string): int { val h = { x: int -> x + a.size }; return h(2) }
fun <T> twice(value: T, n: int): int { val h = { x: int -> x * 2 + n }; return h(n) }
class Bag<T>(val item: T) {
    fun count(k: int): int { val h = { x: int -> x + k }; return h(1) }
}
fun Box.plus(k: int): int { val h = { x: int -> x + (this.v ?? 0) }; return h(k) }
val scale: (int) -> int = { x: int -> x * 3 }
fun nested(k: int): int {
    val outer = { x: int -> { y: int -> y + k }(x) * 2 }
    return outer(1)
}
fun nums(seed: Box?): Generator<int> = generator {
    val a = seed?.v ?? 7
    yield(a)
    yield(pick(second = a, first = 2))
}
fun main(): int {
    var total = 0
    for (n in nums(Box(4))) total = total + n
    for (n in nums(null)) total = total + n
    println("${apply(1)} ${apply(1, { y: int -> y * 5 })} ${g(1)} ${g("ab")} ${twice(1, 3)} ${twice("s", 4)}")
    println("${Bag(1).count(2)} ${Bag("a").count(5)} ${Box(4).plus(1)} ${scale(5)} ${nested(3)} $total ${otherSum(2)}")
    42
}
