// Copied by tools/test-libc-format.sh to build/libc-format/main.ab, beside format.ab and strto.ab (src/static_libc/format.ab and string.ab without
// their @export lines: those modules cannot be imported by an ordinary program). The statically linked compiler's vsnprintf on the cases
// tests/cases/libc-format/format.c writes ("size<TAB>formathex<TAB>args"), printed as that program prints the host C library's snprintf: "return<TAB>hex of the
// buffer up to its NUL". The va_list is the x86-64 System V one with every register slot used, so each argument comes from its overflow area in order.
// Its native memory is allocated raw and never freed (a NativeByteBuffer would be freed when its expression ends, under the formatter).
import "abla/io"
import "abla/integer"
import "abla/text"
import "abla/runtime/scalar"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "./format.ab"

fun number(text: string): int {
    val parsed = text.parseInt()
    if (parsed != null) parsed else 0
}

fun hexValue(c: int): int = if (c >= 97) c - 87 else if (c >= 65) c - 55 else c - 48

// The bytes of `hex` at a new NUL-terminated native buffer.
trusted fun bytes(hex: string): int {
    val count = hex.size / 2
    val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(count + 1))
    for (i in 0 until count) ablaRuntimeStoreU8(address + i, hexValue(hex[2 * i]) * 16 + hexValue(hex[2 * i + 1]))
    ablaRuntimeStoreU8(address + count, 0)
    address
}

// The 32-bit units of `hex` (8 digits each) at a new wchar_t string with its terminator.
trusted fun units(hex: string): int {
    val count = hex.size / 8
    val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(4 * count + 4))
    for (i in 0 until count) {
        var unit = 0
        for (j in 0 until 8) unit = unit * 16 + hexValue(hex[8 * i + j])
        ablaRuntimeStoreI32(address + 4 * i, unit)
    }
    ablaRuntimeStoreI32(address + 4 * count, 0)
    address
}

fun hexByte(b: int): string {
    val digits = "0123456789abcdef"
    digits.slice(b >> 4, (b >> 4) + 1) + digits.slice(b & 15, (b & 15) + 1)
}

trusted fun run(size: int, formatHex: string, args: string): string {
    val format = bytes(formatHex)
    val tokens = args.split(" ")
    // 16-aligned (a long double's slot is), with room for twelve arguments of 16 bytes and the alignment.
    val area = (ablaUnsafePointerAddress(ablaUnsafeAllocate(8 * 64)) + 15) & -16
    var count = 0
    for (token in tokens) {
        if (token.size == 0) continue
        if (token[0] == 120) {
            // x:<32 hex digits>: a long double's 16 bytes, at the next 16-aligned slot as the System V ABI places one.
            if (count % 2 == 1) count = count + 1
            val bytesAt = bytes(token.slice(2, token.size))
            ablaRuntimeStoreI64(area + 8 * count, ablaRuntimeLoadI64(bytesAt))
            ablaRuntimeStoreI64(area + 8 * count + 8, ablaRuntimeLoadI64(bytesAt + 8))
            count = count + 2
            continue
        }
        val value = if (token[0] == 105) number(token.slice(2, token.size)) else if (token[0] == 110) 0
            else if (token[0] == 119) units(token.slice(2, token.size)) else bytes(token.slice(2, token.size))
        ablaRuntimeStoreI64(area + 8 * count, value)
        count = count + 1
    }
    // gp_offset 48 and fp_offset 176: no register slot left; overflow_arg_area the arguments; reg_save_area unused.
    val list = ablaUnsafePointerAddress(ablaUnsafeAllocate(24))
    ablaRuntimeStoreI32(list, 48)
    ablaRuntimeStoreI32(list + 4, 176)
    ablaRuntimeStoreI64(list + 8, area)
    ablaRuntimeStoreI64(list + 16, 0)
    // A size of -1 is SIZE_MAX (sprintf's): the buffer is the host side's 16 KiB, more than any case makes.
    val buffer = if (size < 0) ablaUnsafePointerAddress(ablaUnsafeAllocate(16384))
        else if (size > 0) ablaUnsafePointerAddress(ablaUnsafeAllocate(size + 1)) else 0
    val result = libcVsnprintf(buffer, size, format, list)
    var out = "$result\t"
    if (buffer != 0) {
        var at = 0
        while (ablaRuntimeLoadU8(buffer + at) != 0) {
            out = out + hexByte(ablaRuntimeLoadU8(buffer + at))
            at = at + 1
        }
    }
    out
}

fun main: int {
    var running = true
    while (running) {
        val line = readInputLine()
        if (!line.available) running = false
        else if (line.text.size > 0) {
            val fields = line.text.split("\t")
            println(run(number(fields[0]), fields[1], if (fields.size > 2) fields[2] else ""))
        }
    }
    0
}
