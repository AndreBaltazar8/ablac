// These clients share the compiler graph at build time only. Each script runs
// its case in a fresh process, with the case's original argument vector.
import "abla/sys/linux"
import "../compiler-bitcode/prune.ab" as prune
import "../compile-time-erased-floats/wire.ab" as liftWire
import "../modules/conformance-ir-cache.ab" as conformance
import "../modules/stable-native-symbols.ab" as symbols

import "../modules/lowered-ir-cache.ab" as lowered
import "../modules/native-function-address.ab" as nativeAddress
import "../modules/xtensa-interrupt-handler.ab" as interrupt
import "../ir-finalization/main.ab" as finalization

trusted fun main(): int {
    val entry = linuxEnvironment("ABLA_COMPILER_API_CASE")
    if (!entry.found) return 2
    if (entry.value == "lift-wire") return liftWire.main()
    if (entry.value == "prune") return prune.main()
    if (entry.value == "conformance") return conformance.main()
    if (entry.value == "symbols") return symbols.main()
    if (entry.value == "lowered-ir-cache") return lowered.main()
    if (entry.value == "native-address") return nativeAddress.main()
    if (entry.value == "xtensa-interrupt") return interrupt.main()
    if (entry.value == "ir-finalization") return finalization.main()
    2
}
