import "abla/io"
import "abla/memory"

// Objects and arrays of them, kept and churned, collected under pressure: the pointers the collector
// follows are all payload starts. Prints the result and how the collections found their candidates
// (memoryHeapStat 5: from the registry alone, 6: through the page directory); tools/test-gc-lookup.sh
// runs it under each forced fallback.
class Node(val value: int, val next: Node?)

fun sumList(node: Node?): int = if (node == null) 0 else node.value + sumList(node.next)

fun churn(round: int): int {
    var list: Node? = null
    for (index in 0 until 40) list = Node(index + round, list)
    sumList(list)
}

fun main: int {
    val kept: array<Node> = []
    for (index in 0 until 2000) kept.append(Node(index, null))
    var total = 0
    for (round in 0 until 60000) total = total + churn(round)
    memoryCollect()
    var check = 0
    for (node in kept) check = check + node.value
    println("total $total kept $check")
    println("lazy ${memoryHeapStat(5) > 0} directory ${memoryHeapStat(6) > 0}")
    0
}
