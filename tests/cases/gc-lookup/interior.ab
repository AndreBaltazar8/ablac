import "abla/io"
import "abla/memory"

// Kept slices of strings: a slice's data pointer is inside its parent's block, not a payload's start, so
// the collection needs the page directory (memoryHeapStat 6) and still keeps what the slices hold.
fun main: int {
    val kept: array<string> = []
    for (index in 0 until 2000) {
        val parent = "parent-$index-with-some-longer-text-to-slice-from-and-keep"
        kept.append(parent.slice(7, 40))
    }
    var total = 0
    for (round in 0 until 60000) {
        val text = "garbage-$round-padding-to-make-it-longer-than-the-small-block-sizes"
        total = total + text.size
    }
    memoryCollect()
    var check = 0
    for (text in kept) check = check + text.size
    println("total $total kept $check first ${kept[0]} last ${kept[1999]}")
    println("directory ${memoryHeapStat(6) > 0}")
    0
}
