import "abla/io"
import "abla/memory"
import "abla/process/arguments"
import "abla/unsafe/memory"

// A process with many mappings: the first argument is how many pages to map readable and writable and
// split into two-page ranges by a PROT_NONE page between them, so /proc/self/maps has about half as many
// lines. Prints how the collections went (memoryHeapStat 5: from the registry alone, 6: through the page
// directory) and a checksum of what the program kept.
trusted noescape extern:"c" fun mmap(address: int, length: int, protection: int, flags: int, descriptor: int, offset: int): int
trusted noescape extern:"c" fun mprotect(address: int, length: int, protection: int): int

class Node(val value: int, val next: Node?)

fun decimal(text: string): int {
    var value = 0
    for (byte in text) value = value * 10 + byte - 48
    value
}

trusted fun split(pages: int): int {
    val base = mmap(0, pages * 4096, 3, 34, -1, 0)
    var index = 1
    while (index < pages) {
        mprotect(base + index * 4096, 4096, 0)
        index = index + 2
    }
    base
}

fun sumList(node: Node?): int = if (node == null) 0 else node.value + sumList(node.next)

fun main: int {
    val pages = if (processArgumentCount() > 0) decimal(processArgument(0)) else 0
    if (pages > 0) split(pages)
    val kept: array<Node> = []
    for (index in 0 until 3000) kept.append(Node(index, null))
    var total = 0
    for (round in 0 until 20000) {
        var list: Node? = null
        for (index in 0 until 40) list = Node(index + round, list)
        total = total + sumList(list)
    }
    for (round in 0 until 4) memoryCollect()
    var check = 0
    for (node in kept) check = check + node.value
    println("total $total kept $check")
    println("lazy ${memoryHeapStat(5) > 0} directory ${memoryHeapStat(6) > 0}")
    0
}
