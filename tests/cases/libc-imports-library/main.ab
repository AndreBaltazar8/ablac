import "abla/build"

// A shared library of the default x86-64 Linux target (#806): strings, arrays, maps and floats, no C library of its
// own. tools/test-libc-imports.sh checks what it leaves to the host process.
fun greet(n: int): string {
    val parts: array<string> = []
    for (index in 0 until n) parts.append("item$index")
    var text = ""
    for (part in parts) text = "$text$part,"
    text
}

fun answer: int {
    val table: Map<string, int> = Map()
    for (index in 0 until 20) table.set("key$index", index * index)
    greet(40).size + table.size
}

val exported = #exportFunction("answer", "abla_app_answer")
