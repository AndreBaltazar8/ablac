// A site the native tier doesn't take (it names a compiler API call that takes a function), which keeps the
// evaluator busy for well over a second: the build says so under auto, without the trace (tools/test-ct-fallback.sh).
import "abla/compiler"

compile fun interpreted(rounds: int): int {
    if (rounds < 0) compilerApplyTransform({ })
    var total = 0
    var round = 0
    while (round < rounds) {
        total = (total * 31 + round) % 1000003
        round = round + 1
    }
    total
}

val value = #interpreted(1500000)
fun main: int = if (value > 0) 42 else 1
