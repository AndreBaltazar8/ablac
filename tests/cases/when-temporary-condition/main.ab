import "abla/io"

var log: string = ""
resource class Item(val id: int) {
    fun drop(): void { log = log + "I$id" }
}
resource class Holder(val item: Item) {
    fun drop(): void { log = log + "H" }
}
fun probe(): string {
    log = ""
    when (2) {
        Holder(Item(1)).item.id -> log = log + "A"
        else -> log = log + "C"
    }
    log = log + "|"
    when (2) {
        Holder(Item(1)).item.id -> log = log + "A"
        Holder(Item(2)).item.id -> log = log + "B"
        else -> log = log + "C"
    }
    log = log + "|"
    when (Holder(Item(3)).item.id) {
        Holder(Item(1)).item.id, Holder(Item(3)).item.id -> log = log + "G"
        else -> log = log + "C"
    }
    log = log + "|"
    when (1) {
        Holder(Item(1)).item.id -> log = log + "A"
        Holder(Item(2)).item.id -> log = log + "B"
        else -> log = log + "C"
    }
    log = log + "|"
    log
}
val evaluated = #probe()
fun main: int { println(probe()); println(evaluated); 0 }
