import "abla/compiler"

// A program whose entry is not there: the build fails naming it, and writes nothing for it (it used to build an empty
// program: a Wasm module of 54 bytes, an executable of nothing, with exit status 0).
val scheduled = #compilerBuildProgram(
    "ghost",
    "no-such-entry.ab",
    "../../../build/programmable-build/ghost",
    "host",
    "executable",
    true,
    false
)

fun main: int = if (scheduled) 0 else 1
