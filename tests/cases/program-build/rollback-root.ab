#import("abla/compiler")

#compilerGrant("filesystem.write")

val generated = #compilerWriteFile(
    "build/programmable-build/rollback-generated.ab",
    "fun generatedRollbackProbe: int = 42\n"
)

val failing = #compilerBuildProgram(
    "rollback-failing-child",
    "tests/cases/program-build/invalid-export.ab",
    "build/programmable-build/rollback-child",
    "x86_64-linux",
    "shared-library",
    true,
    false
)

fun main: int = if (generated && failing) 42 else 1
