#import("abla/build")

fun forward(callback: (int) -> int, value: int): int = callback(value)

// Foreign callbacks are borrowed for one exported call. Passing one onward
// would make its retention behavior unknowable, so export validation rejects
// this boundary even though the ordinary Abla program remains well typed.
fun invalidCallbackExport(
    callback: (int) -> int,
    value: int
): int = forward(callback, value)

val exported = #exportFunction(
    "invalidCallbackExport",
    "invalid_callback_export"
)
