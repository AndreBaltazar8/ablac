#import("abla/compiler")

@client
fun clientAnswer(value: int): int = value + 2

@client
fun clientDouble(value: int): int = value * 2

@client
fun unselectedClient(value: int): int = value + 100

fun serverAnswer(value: int): int = value + 1

compile fun configureSlices(): void {
    compiler.defineTarget(
        "wasm32-module",
        "wasm32-unknown-unknown",
        "wasm",
        "wasm-ld",
        "none",
        false,
        true
    )
    val function = compiler.findFunction("clientAnswer")
    if (compiler.annotationCount(function) == 1 &&
        compiler.annotation(function, 0) == "client") {
        compiler.contributeArtifactRoot(
            "client-slice",
            "wasm32-module",
            "module",
            "build/artifact-slice/client.wasm",
            function,
            "abla_client_answer",
            true,
            false
        )
        compiler.contributeArtifactRoot(
            "client-slice",
            "wasm32-module",
            "module",
            "build/artifact-slice/client.wasm",
            compiler.findFunction("clientDouble"),
            "abla_client_double",
            true,
            false
        )
    }
    return
}

#compiler.transform(configureSlices)

fun main: int = if (serverAnswer(41) == 42) 0 else 1
