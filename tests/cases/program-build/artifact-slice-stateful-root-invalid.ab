import "abla/compiler"
import "artifact-slice-stateful-module-a.ab"

var serverSessions: int = 0

@client
fun invalidStatefulClient(value: int): int = value + serverSessions

compile fun configureSlices(): void {
    compiler.defineTarget(
        "wasm32-module",
        "wasm32-unknown-unknown",
        "wasm",
        "wasm-ld",
        "none",
        false,
        true
    )
    val increment = compiler.findFunction("statefulClientInc")
    val invalid = compiler.findFunction("invalidStatefulClient")
    compiler.contributeArtifactRoot(
        "client-slice-stateful",
        "wasm32-module",
        "module",
        "build/artifact-slice-stateful-invalid/client.wasm",
        increment,
        "client_increment",
        true,
        false
    )
    compiler.contributeArtifactRoot(
        "client-slice-stateful",
        "wasm32-module",
        "module",
        "build/artifact-slice-stateful-invalid/client.wasm",
        invalid,
        "client_invalid",
        true,
        false
    )
    return
}

#compiler.transform(configureSlices)

fun main: int = if (invalidStatefulClient(0) == 1) 0 else 1
