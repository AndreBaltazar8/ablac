import "abla/compiler"
import "abla/compiler/parser"
import "abla/wasm/build"

val offset = 2

fun lifted(): int = 1 + offset

fun annotatedLift(): int = 5

compile fun buildIndependent(): void {
    if (compiler.functionsAnnotated("copied").size != 0) {
        compiler.newModule("")
    }
    val program = compiler.newModule("independent-module")
    program.use(compiler.function("annotatedLift").annotated("copied"))
    program.declare {
        compile fun verifyCopiedAnnotation(): void {
            val copied = compiler.functionsAnnotated("copied")
            if (copied.size == 1 &&
                compiler.functionName(copied[0]) == "annotatedLift") return
            compiler.addFunctionAnnotation(-1, "invalid")
            return
        }

        #verifyCopiedAnnotation()

        fun main: int = lifted() + annotatedLift()
    }
    program.emit("build/independent-module")
    return
}

#buildIndependent()

compile fun buildIndependentWasm(): void {
    val program = compiler.newModule("independent-wasm")
    val lifted = compiler.reference(
        compiler.findFunction("annotatedLift")
    ).annotated("copied").exported("abla_independent_lifted")
    program.use(lifted)

    val generated = compilerGeneratedModule(
        "independent.wasm.adapter",
        syntaxInteger(0)
    )
    val noParameters: array<string> = []
    val noParameterTypes: array<int> = []
    val noArguments: array<SyntaxExpression> = []
    val adapter = compilerGeneratedFunction(
        generated,
        "answer",
        noParameters,
        noParameterTypes,
        compilerFindType("i64"),
        syntaxBinary(
            "+",
            syntaxCallTarget(
                compiler.findFunction("annotatedLift"),
                noArguments
            ),
            syntaxInteger(37)
        )
    )
    program.declareGenerated(generated)
    program.export(adapter, "abla_independent_generated")
    program.emitWasm(
        "build/independent-module.wasm",
        fast = true,
        cache = false
    )
    return
}

#buildIndependentWasm()

fun main: int = 0
