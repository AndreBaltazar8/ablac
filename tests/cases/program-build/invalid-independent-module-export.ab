import "abla/compiler"

fun answer(): int = 42

compile fun buildInvalidIndependentExport(): void {
    val program = compiler.newModule("invalid-independent-export")
    val answer = compiler.reference(compiler.findFunction("answer"))
    program.use(answer.exported("duplicate_answer"))
    program.export("answer", "duplicate_answer")
    program.emit(
        "build/invalid-independent-export",
        target = "x86_64-linux"
    )
    return
}

#buildInvalidIndependentExport()

fun main: int = 0
