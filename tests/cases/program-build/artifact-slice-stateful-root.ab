#import("abla/compiler")
#import("artifact-slice-stateful-module-a.ab")
#import("artifact-slice-stateful-module-b.ab")

var serverSessions: int = 0

fun serverAction(value: int): int = value + serverSessions

compile fun configureSlices(): void {
    compiler.defineTarget(
        "wasm32-module",
        "wasm32-unknown-unknown",
        "wasm",
        "wasm-ld",
        "none",
        false,
        true
    )
    val increment = compiler.findFunction("statefulClientInc")
    val doubled = compiler.findFunction("statefulClientDouble")
    compiler.contributeArtifactRoot(
        "client-slice-stateful",
        "wasm32-module",
        "module",
        "build/artifact-slice-stateful/client.wasm",
        increment,
        "client_increment",
        true,
        false
    )
    compiler.contributeArtifactRoot(
        "client-slice-stateful",
        "wasm32-module",
        "module",
        "build/artifact-slice-stateful/client.wasm",
        doubled,
        "client_double",
        true,
        false
    )
    // Duplicate contribution for the same selected root should be ignored.
    compiler.contributeArtifactRoot(
        "client-slice-stateful",
        "wasm32-module",
        "module",
        "build/artifact-slice-stateful/client.wasm",
        increment,
        "client_increment",
        true,
        false
    )
    return
}

#compiler.transform(configureSlices)

fun main: int = if (serverAction(portableClientAdder(20)) == 21) 0 else 1
