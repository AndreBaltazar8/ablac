import "abla/compiler"

#compilerGrant("filesystem.write")

val generated = #compilerWriteFile(
    "build/programmable-build/generated-child.ab",
    "fun main: int = 43\n"
)

val scheduled = #compilerBuildProgram(
    "generated-child",
    "build/programmable-build/generated-child.ab",
    "build/programmable-build/generated-child",
    "x86_64-linux",
    "executable",
    true,
    false
)

fun main: int = if (generated && scheduled) 39 else 1
