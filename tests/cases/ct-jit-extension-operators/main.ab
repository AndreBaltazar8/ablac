// An operator that is an extension function (`secretU64.minus` in abla/ct) is resolved statically: the jit tier's
// ordinary-global write analysis follows the checker to that one function, so an unrelated class's `minus` that
// writes a module value does not make a compile-time site using the extension decline (#828).
import "abla/io"
import "abla/ct"
import "abla/compiler"

#compilerGrant("trusted.native")

var minusLog: array<int> = []

class Bag(val n: int) {
    operator fun minus(other: Bag): Bag {
        minusLog.append(other.n)
        Bag(this.n - other.n)
    }
}

fun secretDifference(): u64 = (secretU64(u64(7)) - secretU64(u64(5))).declassify()

val staged = #secretDifference()

fun main(): int {
    val bag = Bag(9) - Bag(4)
    println("${staged} ${bag.n} ${minusLog.size}")
    0
}
