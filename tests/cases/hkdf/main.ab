// HKDF (RFC 5869 appendix A, all seven vectors) and TLS 1.3's HKDF-Expand-Label and Derive-Secret
// (RFC 8448 "Simple 1-RTT Handshake" early secret and derived secret for SHA-256; the SHA-384
// values and the key/iv labels were produced with `openssl kdf` over the RFC 8446 section 7.1
// HkdfLabel). tools/test-hkdf.sh runs it.
import "abla/io"
import "abla/crypto"
import "abla/crypto/hkdf"
import "abla/crypto/result"

var failures = 0

fun check(name: string, actual: string, expected: string): void {
    if (hexEncode(actual) != expected) {
        println("FAIL $name: ${hexEncode(actual)} != $expected")
        failures = failures + 1
    }
}

fun repeatByte(byte: int, count: int): string {
    val bytes: array<int> = []
    for (i in 0 until count) bytes.append(byte)
    cryptoByteString(bytes)
}

fun counting(first: int, last: int): string {
    val bytes: array<int> = []
    for (i in first until last + 1) bytes.append(i)
    cryptoByteString(bytes)
}

fun vector(name: string, hash: int, ikm: string, salt: string, info: string, length: int, prk: string,
    okm: string): void {
    check("$name PRK", hkdfExtract(hash, salt, ikm), prk)
    val expanded = hkdfExpand(hash, hkdfExtract(hash, salt, ikm), info, length)
    if (!expanded.ok) {
        println("FAIL $name: ${expanded.error}")
        failures = failures + 1
    } else check("$name OKM", expanded.bytes, okm)
    val whole = hkdf(hash, salt, ikm, info, length)
    check("$name extract-and-expand", whole.bytes, okm)
}

fun main: int {
    vector("A.1", HKDF_SHA256, repeatByte(11, 22), counting(0, 12), counting(240, 249), 42,
        "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
    vector("A.2", HKDF_SHA256, counting(0, 79), counting(96, 175), counting(176, 255), 82,
        "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244",
        "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87")
    vector("A.3", HKDF_SHA256, repeatByte(11, 22), "", "", 42,
        "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04",
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")
    vector("A.4", HKDF_SHA1, repeatByte(11, 11), counting(0, 12), counting(240, 249), 42,
        "9b6c18c432a7bf8f0e71c8eb88f4b30baa2ba243",
        "085a01ea1b10f36933068b56efa5ad81a4f14b822f5b091568a9cdd4f155fda2c22e422478d305f3f896")
    vector("A.5", HKDF_SHA1, counting(0, 79), counting(96, 175), counting(176, 255), 82,
        "8adae09a2a307059478d309b26c4115a224cfaf6",
        "0bd770a74d1160f7c9f12cd5912a06ebff6adcae899d92191fe4305673ba2ffe8fa3f1a4e5ad79f3f334b3b202b2173c486ea37ce3d397ed034c7f9dfeb15c5e927336d0441f4c4300e2cff0d0900b52d3b4")
    vector("A.6", HKDF_SHA1, repeatByte(11, 22), "", "", 42,
        "da8c8a73c7fa77288ec6f5e7c297786aa0d32d01",
        "0ac1af7002b3d761d1e55298da9d0506b9ae52057220a306e07b6b87e8df21d0ea00033de03984d34918")
    vector("A.7", HKDF_SHA1, repeatByte(12, 22), "", "", 42,
        "2adccada18779e7c2077ad2eb19d3f3e731385dd",
        "2c91117204d745f3500d636a62f64f0ab3bae548aa53d423b0d1f27ebba6f5e5673a081d70cce7acfc48")
    // The salt of A.3 is absent, and HashLen zeros is the same salt.
    check("zero salt", hkdfExtract(HKDF_SHA256, repeatByte(0, 32), repeatByte(11, 22)),
        "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")

    // TLS 1.3: the early secret, and the derived secret from the hash of no messages.
    val zeros32 = repeatByte(0, 32)
    val early = hkdfExtract(HKDF_SHA256, zeros32, zeros32)
    check("RFC 8448 early secret", early, "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    val derived = tls13DeriveSecret(HKDF_SHA256, early, "derived", sha256(""))
    check("RFC 8448 derived secret", derived.bytes, "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    check("expand-label key", tls13ExpandLabel(HKDF_SHA256, early, "key", "", 16).bytes, "ebbf95bddc9e43bd09465c5516ab2d5f")
    check("expand-label iv", tls13ExpandLabel(HKDF_SHA256, early, "iv", "", 12).bytes, "a7bf78a10cf9feb156a93f7a")
    val zeros48 = repeatByte(0, 48)
    val early384 = hkdfExtract(HKDF_SHA384, zeros48, zeros48)
    check("SHA-384 early secret", early384,
        "7ee8206f5570023e6dc7519eb1073bc4e791ad37b5c382aa10ba18e2357e716971f9362f2c2fe2a76bfd78dfec4ea9b5")
    check("SHA-384 derived secret", tls13DeriveSecret(HKDF_SHA384, early384, "derived", sha384("")).bytes,
        "1591dac5cbbf0330a4a84de9c753330e92d01f0a88214b4464972fd668049e93e52f2b16fad922fdc0584478428f282b")
    check("SHA-384 key", tls13ExpandLabel(HKDF_SHA384, early384, "key", "", 16).bytes, "a1418517c6013367e0a07f395e78cce7")
    check("SHA-384 iv", tls13ExpandLabel(HKDF_SHA384, early384, "iv", "", 12).bytes, "22ac56124d171e635cebe14e")

    // The bounds: 255 hash lengths is the most Expand gives, and the labels fit their length bytes.
    val prk = repeatByte(7, 32)
    if (!hkdfExpand(HKDF_SHA256, prk, "", 255 * 32).ok) { println("FAIL: the longest expand"); failures = failures + 1 }
    if (hkdfExpand(HKDF_SHA256, prk, "", 255 * 32 + 1).ok) { println("FAIL: one past the longest"); failures = failures + 1 }
    if (hkdfExpand(HKDF_SHA256, prk, "", -1).ok) { println("FAIL: a negative length"); failures = failures + 1 }
    if (hkdfExpand(HKDF_SHA256, prk, "", 0).bytes != "") { println("FAIL: length 0"); failures = failures + 1 }
    if (hkdfExpand(HKDF_SHA1, prk, "", 255 * 20 + 1).ok) { println("FAIL: SHA-1 past the longest"); failures = failures + 1 }
    if (hkdfExpand(HKDF_SHA512, prk, "", 255 * 64).ok != true) { println("FAIL: SHA-512 longest"); failures = failures + 1 }
    if (tls13ExpandLabel(HKDF_SHA256, prk, "", "", 16).ok) { println("FAIL: an empty label"); failures = failures + 1 }
    if (!tls13ExpandLabel(HKDF_SHA256, prk, repeatByte(97, 249), "", 16).ok) { println("FAIL: the longest label"); failures = failures + 1 }
    if (tls13ExpandLabel(HKDF_SHA256, prk, repeatByte(97, 250), "", 16).ok) { println("FAIL: a label past 255"); failures = failures + 1 }
    if (!tls13ExpandLabel(HKDF_SHA256, prk, "key", repeatByte(1, 255), 16).ok) { println("FAIL: the longest context"); failures = failures + 1 }
    if (tls13ExpandLabel(HKDF_SHA256, prk, "key", repeatByte(1, 256), 16).ok) { println("FAIL: a context past 255"); failures = failures + 1 }
    if (tls13ExpandLabel(HKDF_SHA256, prk, "key", "", 65536).ok) { println("FAIL: a length past 16 bits"); failures = failures + 1 }
    if (failures == 0) println("hkdf ok")
    failures
}
