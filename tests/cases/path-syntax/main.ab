// abla/fs/path: the lexical syntax of POSIX and Windows paths, with no file system. The POSIX rows are what Path.parent, name,
// extension and child answered before the syntax moved into the module (the old code's results, as a table); the Windows rows
// follow the forms the module's header lists.
import "abla/fs"
import "abla/fs/path"
import "abla/text"
import "abla/array"
import "abla/io"

var failures = 0

fun same(label: string, actual: string, expected: string) {
    if (actual != expected) {
        failures = failures + 1
        println("FAIL $label: got [$actual] expected [$expected]")
    }
}

fun truth(label: string, actual: bool, expected: bool) {
    if (actual != expected) {
        failures = failures + 1
        println("FAIL $label: got $actual expected $expected")
    }
}

fun posix(text: string, parent: string, name: string, extension: string) {
    same("parent($text)", pathParent(text, false), parent)
    same("name($text)", pathName(text, false), name)
    same("extension($text)", pathExtension(text, false), extension)
    // The host's Path methods are the POSIX ones on this target.
    same("Path.parent($text)", Path(text).parent().text, parent)
    same("Path.name($text)", Path(text).name(), name)
    same("Path.extension($text)", Path(text).extension(), extension)
}

fun windows(text: string, root: int, parent: string, name: string) {
    same("root($text)", "${pathRootLength(text, true)}", "$root")
    same("parent($text)", pathParent(text, true), parent)
    same("name($text)", pathName(text, true), name)
}

fun main: int {
    posix("", ".", "", "")
    posix("a", ".", "a", "")
    posix("a/b", "a", "b", "")
    posix("a/b.txt", "a", "b.txt", "txt")
    posix("/", "/", "", "")
    posix("//", "/", "", "")
    posix("/a", "/", "a", "")
    posix("//a", "/", "a", "")
    posix("/a/b/", "/a", "b", "")
    posix("/a/b//", "/a", "b", "")
    posix("a//b", "a/", "b", "")
    posix("/a/b.tar.gz", "/a", "b.tar.gz", "gz")
    posix("/a/.hidden", "/a", ".hidden", "")
    posix("/a/trailing.", "/a", "trailing.", "")
    posix("dir.d/file", "dir.d", "file", "")
    posix("a\\b", ".", "a\\b", "")

    same("child", Path("/a").child("b").text, "/a/b")
    same("child with slash", Path("/a/").child("b").text, "/a/b")
    same("child of empty", Path("").child("b").text, "/b")
    same("child of root", Path("/").child("b").text, "/b")
    truth("absolute", Path("/a").isAbsolute(), true)
    truth("relative", Path("a/b").isAbsolute(), false)
    same("normalized", Path("/a/./b/../c//d/").normalized().text, "/a/c/d")
    same("components", Path("/a//b/./c").components().join(","), "a,b,c")

    same("norm posix 1", pathNormalize("a/../..", false), "..")
    same("norm posix 2", pathNormalize("/..", false), "/")
    same("norm posix 3", pathNormalize("", false), ".")
    same("norm posix 4", pathNormalize("./a/", false), "a")
    same("norm posix 5", pathNormalize("a/b/../../c", false), "c")
    same("norm posix 6", pathNormalize("../a", false), "../a")
    same("canonical posix", pathToCanonical("a\\b", false), "a\\b")

    windows("C:\\", 3, "C:\\", "")
    windows("C:/", 3, "C:/", "")
    windows("C:\\a", 3, "C:\\", "a")
    windows("C:\\a\\b", 3, "C:\\a", "b")
    windows("C:\\a/b\\", 3, "C:\\a", "b")
    windows("C:", 2, "C:", "")
    windows("C:a", 2, "C:", "a")
    windows("C:a\\b", 2, "C:a", "b")
    windows("\\", 1, "\\", "")
    windows("\\a", 1, "\\", "a")
    windows("/a/b", 1, "/a", "b")
    windows("a", 0, ".", "a")
    windows("a\\b", 0, "a", "b")
    windows("", 0, ".", "")
    windows("\\\\server\\share", 14, "\\\\server\\share", "")
    windows("\\\\server\\share\\", 15, "\\\\server\\share\\", "")
    windows("\\\\server\\share\\dir\\f", 15, "\\\\server\\share\\dir", "f")
    windows("\\\\server\\share\\f", 15, "\\\\server\\share\\", "f")
    windows("\\\\?\\C:\\a\\b", 7, "\\\\?\\C:\\a", "b")
    windows("\\\\?\\C:\\", 7, "\\\\?\\C:\\", "")
    windows("\\\\?\\UNC\\srv\\sh\\x", 15, "\\\\?\\UNC\\srv\\sh\\", "x")
    windows("\\\\.\\pipe\\name", 9, "\\\\.\\pipe\\", "name")
    same("windows extension", pathExtension("C:\\a\\b.txt", true), "txt")
    same("windows extension 2", pathExtension("C:\\a.d\\b", true), "")
    same("windows drive name no extension", pathExtension("C:x.y", true), "y")

    truth("abs C:\\", pathIsAbsolute("C:\\a", true), true)
    truth("abs C:/", pathIsAbsolute("C:/a", true), true)
    truth("abs C:", pathIsAbsolute("C:a", true), false)
    truth("abs \\a", pathIsAbsolute("\\a", true), false)
    truth("abs UNC", pathIsAbsolute("\\\\s\\h\\a", true), true)
    truth("abs verbatim", pathIsAbsolute("\\\\?\\C:\\a", true), true)
    truth("abs relative", pathIsAbsolute("a\\b", true), false)
    truth("abs posix syntax C:", pathIsAbsolute("C:\\a", false), false)

    same("join", pathJoin("C:\\a", "b", true), "C:\\a\\b")
    same("join separator", pathJoin("C:\\a\\", "b", true), "C:\\a\\b")
    same("join slash", pathJoin("C:/a/", "b", true), "C:/a/b")
    same("join drive", pathJoin("C:", "b", true), "C:b")
    same("join empty", pathJoin("", "b", true), "\\b")

    same("norm win 1", pathNormalize("C:/a/./b/../c//d/", true), "C:\\a\\c\\d")
    same("norm win 2", pathNormalize("C:\\..\\a", true), "C:\\a")
    same("norm win 3", pathNormalize("a\\..\\..\\b", true), "..\\b")
    same("norm win 4", pathNormalize("C:", true), "C:")
    same("norm win 5", pathNormalize("C:a\\..", true), "C:")
    same("norm win 6", pathNormalize("\\\\srv\\sh\\a\\..\\b", true), "\\\\srv\\sh\\b")
    same("norm win verbatim", pathNormalize("\\\\?\\C:\\a\\..\\b/c", true), "\\\\?\\C:\\a\\..\\b/c")
    same("norm win empty", pathNormalize("", true), ".")
    same("norm win root", pathNormalize("/", true), "\\")
    same("components win", pathComponents("C:\\a//b\\.\\c", true).join(","), "a,b,c")
    same("components win drive-relative", pathComponents("C:a\\b", true).join(","), "a,b")

    same("canonical", pathToCanonical("C:\\a\\b", true), "C:/a/b")
    same("native", pathToNative("C:/a/b", true), "C:\\a\\b")
    same("native posix", pathToNative("/a/b", false), "/a/b")
    same("round trip", pathToNative(pathToCanonical("\\\\srv\\sh\\a\\b", true), true), "\\\\srv\\sh\\a\\b")

    if (failures == 0) println("path-syntax: ok")
    if (failures == 0) 0 else 1
}
