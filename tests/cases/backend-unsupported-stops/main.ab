// nativeStaticAllocate needs a constant size, so the backend cannot lower this one; the store after it uses its
// result. tools/test-backend-unsupported-stops.sh checks that the build stops with the diagnostic.
import "abla/io"
import "abla/unsafe/memory/raw"

trusted fun cString(text: string): int {
    val at = nativeStaticAllocate(text.size + 1)
    ablaRuntimeStoreU8(at, 0)
    at
}

fun main { println("${cString("ab")}") }
