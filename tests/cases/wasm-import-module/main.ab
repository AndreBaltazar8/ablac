// `@wasmImport` picks the WebAssembly import module (and optionally the
// field name) of an `extern:"c"` declaration. Externs without it keep the
// linker default: module "env", field = symbol name.
@wasmImport("wasi_snapshot_preview1")
trusted noescape extern:"c" fun fd_write(fd: i32, iovs: i32, iovsLength: i32, written: i32): i32

@wasmImport(["host", "now_millis"])
trusted noescape extern:"c" fun hostNow(): i64

trusted noescape extern:"c" fun env_log(pointer: i32, length: i32): void

@export("probe")
trusted fun probe(value: i32): i64 {
    env_log(value, value)
    int(fd_write(value, value, value, value)) + int(hostNow())
}
