import "abla/process/command"

fun chosen(input: string): bool {
    val c = if (input == "") command("printf") else command("printf").argument("%s")
    c.argument("42")
    val result = c.capture()
    result.status == 0 && result.output == "42"
}

class Item(val value: int) {
    fun view(): borrow(this) Item = this
}

fun view(item: Item): borrow(item) Item = item

fun branches(flag: bool): bool {
    val first = if (flag) Item(7).view().view() else Item(7)
    val second = if (flag) Item(8) else view(Item(8))
    val third = when (flag) {
        true -> Item(9)
        else -> Item(9).view()
    }
    first.value == 7 && second.value == 8 && third.value == 9
}

fun main: int = if (chosen("") && chosen("input") && branches(true) && branches(false)) 42 else 1
