// __wctype_l of the statically linked compiler's C library (src/static_libc/wide.ab, #1139 area 14) reads a name no further than its NUL: each
// name is placed so that its NUL is the last byte before a page with no access, and a name shorter than a class name ("a" against "alnum") used
// to be read on past it. Built by tools/test-libc-functions.sh against a copy of the library without its @export lines. Exits 42.
import "abla/io"
import "abla/runtime/scalar"
import "abla/sys/linux"
import "../../../src/static_libc/wide.ab"

// mmap and mprotect by their x86-64 numbers, which the backend translates for AArch64.
trusted fun guardedPages(): int {
    // Two pages, read and write (3), private and anonymous (0x22).
    val pages = linuxSyscall6(9, 0, 8192, 3, 34, -1, 0)
    linuxSyscall3(10, pages + 4096, 4096, 0)
    pages
}

// `name` with its NUL as the last byte before the page with no access.
trusted fun atGuard(pages: int, name: string): int {
    val address = pages + 4096 - name.size - 1
    for (i in 0 until name.size) ablaRuntimeStoreU8(address + i, name[i])
    ablaRuntimeStoreU8(address + name.size, 0)
    address
}

trusted fun main: int {
    val pages = guardedPages()
    if (pages < 0) {
        println("libc-wctype: mmap failed ($pages)")
        return 1
    }
    for (name in ["", "a", "al", "aln", "d", "dig", "x", "up", "prin", "spac", "xdigi", "alphabet", "zz"]) {
        val mask = libcWctype(atGuard(pages, name), 0)
        if (mask != 0) {
            println("libc-wctype: [$name] is a class ($mask)")
            return 1
        }
    }
    val names = ["alnum", "alpha", "blank", "cntrl", "digit", "graph", "lower", "print", "punct", "space", "upper", "xdigit"]
    val masks = [8, 1024, 1, 2, 2048, 32768, 512, 16384, 4, 8192, 256, 4096]
    for (i in 0 until names.size) {
        val mask = libcWctype(atGuard(pages, names[i]), 0)
        if (mask != masks[i]) {
            println("libc-wctype: [${names[i]}] is $mask, expected ${masks[i]}")
            return 1
        }
    }
    42
}
