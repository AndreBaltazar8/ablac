#import("abla/compiler")
#import("abla/compiler/parser")
#import("abla/io")

#compilerGrant("filesystem.read")

compile fun parseBuildInput(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "{")
    parserExpect(cursor, "}")
    val contents = ablaHostReadFile(
        "tests/cases/capabilities/input.txt"
    )
    if (contents == "first\n") syntaxInteger(42) else syntaxInteger(7)
}

#compilerRegisterSubparser("buildInput", parseBuildInput)

fun main: int = $buildInput{}
