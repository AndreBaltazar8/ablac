// tools/test-compile-effects.sh builds a copy of this case that connects to
// the port its listener was given in place of 39091.
import "abla/compiler"

#compilerGrant("network")

val response = #compilerTcpExchange(
    "127.0.0.1",
    39091,
    "PING",
    1024,
    2000
)

fun main: int = if (response == "PONG") 42 else 1
