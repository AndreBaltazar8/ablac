// Raw socket peer for tools/test-compile-effects.sh, the far end of the compile-time
// TCP exchange in network-live.ab. It uses literal bytes only: it listens on 127.0.0.1
// on a port the system picks, publishes the port by renaming a file into place, reads
// four bytes, answers PONG to PING (and NOPE to anything else, or always with the
// "wrong" argument, a control), then exits. Arguments: <ready file> [wrong].
import "abla/fs"
import "abla/net/hosted"
import "abla/process/arguments"

fun main: int {
    val ready = processArgument(0)
    val wrong = processArgumentCount() > 1 && processArgument(1) == "wrong"
    val listener = hostedTcpListen("127.0.0.1", 0, 1, false)
    val port = listener.localPort()
    if (port <= 0) return 1
    if (!Path(ready).writeTextAtomic("$port")) return 2
    val connection = listener.accept()
    val request = connection.readNetwork(4, 10000)
    if (!request.hasData()) return 3
    connection.writeResult(if (request.bytes == "PING" && !wrong) "PONG" else "NOPE")
    connection.close()
    listener.close()
    0
}
