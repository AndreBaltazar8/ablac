class Item(val number: int)
fun text(value: any): string = "$value"
@export("trigger")
fun trigger(): int {
    val erased: any = Item(42)
    if (text(erased) == "") 0 else 1
}

import "abla/io"
fun limit(): int = 0
fun maybe(count: int): void {
    if (count > limit()) println("never")
}
@export("late")
fun late(): int {
    maybe(0)
    0
}
