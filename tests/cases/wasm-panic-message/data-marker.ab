class Item(val number: int)
fun text(value: any): string = "$value"
@export("trigger")
fun trigger(): int {
    val erased: any = Item(42)
    if (text(erased) == "") 0 else 1
}

// The bytes of an abla_host.write import entry, kept in the data section by a
// load at an index only the caller knows: the module imports nothing.
val marker = "\x09abla_host\x05write"
@export("markerByte")
fun markerByte(index: int): int = marker[index]
