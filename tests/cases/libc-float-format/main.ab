// Prints each case of stdin ("conversion precision alternate bits": a printf conversion letter, a precision (-1 for none), 1 for the # flag and
// the double's IEEE bits) as the statically linked compiler's C library formats it (src/static_libc/floatfmt.ab); tools/test-libc-float-format.sh
// compares that with the host C library's printf for the same cases.
import "abla/io"
import "abla/float"
import "abla/integer"
import "abla/text"
import "../../../src/static_libc/floatfmt.ab"

fun number(text: string): int {
    val parsed = text.parseInt()
    if (parsed != null) parsed else 0
}

fun main: int {
    var running = true
    while (running) {
        val line = readInputLine()
        if (!line.available) {
            running = false
        } else if (line.text.size > 0) {
            val fields = line.text.split(" ")
            val conversion = fields[0][0]
            val result = libcFloat(f64FromBits(number(fields[3])), conversion, number(fields[1]), number(fields[2]) == 1)
            println(result)
        }
    }
    return 0
}
