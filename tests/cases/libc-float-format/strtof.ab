// Prints the bits of the float strtof reads from each line of stdin, as the statically linked compiler's C library does it (src/static_libc/strtof.ab);
// tools/test-libc-float-format.sh compares that with the host C library's strtof.
import "abla/io"
import "abla/float"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native"
import "../../../src/static_libc/strtof.ab"

trusted fun floatBits(text: string): u32 = f32ToBits(libcStrtofAt(ablaUnsafeStringAddress(text), 0))

fun main: int {
    var running = true
    while (running) {
        val line = readInputLine()
        if (!line.available) {
            running = false
        } else if (line.text.size > 0) {
            println("${floatBits(line.text + "\0")}")
        }
    }
    return 0
}
