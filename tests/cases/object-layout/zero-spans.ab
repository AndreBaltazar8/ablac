import "abla/runtime/self"
import "abla/unsafe/memory/raw"

// Reuse poisoned storage so fresh zeroed pages cannot hide a short clear.
// No allocating call or safe point occurs between poisoning and freeing it.
trusted noescape fun objectZeroSpan(size: int, span: int): bool {
    val dirty = __ablaRuntimeObjectBlock(size)
    var index = 0
    while (index < span) {
        ablaUnsafeStoreU8(nativePointerFromAddress(dirty + index), 165)
        index = index + 1
    }
    __ablaRuntimeFree(dirty)
    val clean = __ablaRuntimeObjectBlock(size)
    var zero = true
    index = 0
    while (index < span) {
        if (ablaUnsafeLoadU8(nativePointerFromAddress(clean + index)) != 0) zero = false
        index = index + 1
    }
    __ablaRuntimeFree(clean)
    zero
}

fun objectZeroSpanFailures(): int {
    val sizes = [0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65,
        127, 128, 129, 255, 256, 511, 512, 1023, 4095, 4096, 4097, 65535, 65536, 65537]
    val spans = [0, 8, 8, 8, 16, 16, 16, 24, 32, 32, 40, 64, 64, 72,
        128, 128, 136, 256, 256, 512, 512, 1024, 4096, 4096, 4104, 65536, 65536, 65544]
    var failures = 0
    var repeat = 0
    while (repeat < 3) {
        var index = 0
        while (index < sizes.size) {
            if (!objectZeroSpan(sizes[index], spans[index])) failures = failures + 1
            index = index + 1
        }
        repeat = repeat + 1
    }
    failures
}
