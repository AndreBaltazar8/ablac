// Instances of every field kind the lift carries, built at compile time and
// lifted into the program: the lift reads each declared field through its
// class's descriptor. Run the compile-time code natively (ABLA_COMPILE_EVAL=jit).
import "abla/io"
import "abla/float"

class Leaf(var label: string, var weight: f64)

class Lifted(
    var count: int,
    var ratio: f64,
    var on: bool,
    var name: string,
    var items: array<int>,
    var leaf: Leaf,
    var maybe: Leaf?,
    var anything: any,
    var optional: int?,
    var off: bool
)

fun made(seed: int): Lifted {
    var maybe: Leaf? = null
    if (seed % 3 != 0) maybe = Leaf("maybe-$seed", 2.5)
    var anything: any = seed
    if (seed % 2 == 0) anything = "text-$seed"
    var optional: int? = null
    if (seed % 4 != 0) optional = seed * 10
    Lifted(seed, f64FromInt(seed) * 0.5, seed % 2 == 0, "name-$seed", [seed, seed + 1],
        Leaf("leaf-$seed", 1.5), maybe, anything, optional, seed % 2 != 0)
}

fun allMade(): array<Lifted> {
    val all: array<Lifted> = []
    for (seed in 0 until 12) all.append(made(seed))
    all
}

val atCompile: array<Lifted> = #allMade()

fun check(item: Lifted, seed: int): int {
    var failures = 0
    if (item.count != seed || item.ratio != f64FromInt(seed) * 0.5) failures = failures + 1
    if (item.on != (seed % 2 == 0) || item.off != (seed % 2 != 0)) failures = failures + 1
    if (item.name != "name-$seed" || item.items[1] != seed + 1) failures = failures + 1
    if (item.leaf.label != "leaf-$seed" || item.leaf.weight != 1.5) failures = failures + 1
    val maybe = item.maybe
    if (seed % 3 == 0) {
        if (maybe != null) failures = failures + 1
    } else if (maybe == null || maybe.label != "maybe-$seed") failures = failures + 1
    val optional = item.optional
    if (seed % 4 == 0) {
        if (optional != null) failures = failures + 1
    } else if (optional == null || optional != seed * 10) failures = failures + 1
    failures
}

fun main: int {
    var failures = 0
    for (seed in 0 until 12) failures = failures + check(atCompile[seed], seed)
    println("lifted object layout: $failures failed")
    if (failures == 0) 42 else 1
}
