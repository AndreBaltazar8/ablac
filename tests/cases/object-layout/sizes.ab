// What instances cost: each class's instances' payload bytes, by the heap
// census (a 16-byte header, then the fields by kind, words and wider first,
// bools last, the whole rounded to 8 bytes).
import "abla/memory"

class Small(var kind: int = 0, var number: f64 = 0.0, var flag: bool = false, var text: string = "")
class Wide(
    var a0: f64 = 0.0, var a1: f64 = 0.0, var a2: f64 = 0.0, var a3: f64 = 0.0, var a4: f64 = 0.0,
    var a5: f64 = 0.0, var a6: f64 = 0.0, var a7: f64 = 0.0, var a8: f64 = 0.0, var a9: f64 = 0.0
)
class Flags(var a: bool = false, var b: bool = true, var c: bool = false)
class Mixed(var maybe: Small? = null, var anything: any = 0, var items: array<int> = [])
class Empty()

fun make(kind: int): any {
    var made: any = 0
    if (kind == 0) made = Small()
    if (kind == 1) made = Wide()
    if (kind == 2) made = Flags()
    if (kind == 3) made = Mixed()
    if (kind == 4) made = Empty()
    made
}

// The payload bytes an instance of `kind` adds (made 50 times, kept).
fun instanceBytes(kind: int): int {
    val kept: array<any> = []
    for (index in 0 until 50) kept.append(0)
    memoryCollect()
    val before = memoryCensus().bytes[5]
    for (index in 0 until 50) kept[index] = make(kind)
    memoryCollect()
    (memoryCensus().bytes[5] - before) / 50
}

fun sizeFailures(): int {
    var failures = 0
    if (instanceBytes(0) != 16 + 8 + 8 + 16 + 1 + 7) failures = failures + 1
    if (instanceBytes(1) != 16 + 80) failures = failures + 1
    if (instanceBytes(2) != 16 + 8) failures = failures + 1
    // The array default is an array of its own (not an instance).
    if (instanceBytes(3) != 16 + 8 + 24 + 8) failures = failures + 1
    if (instanceBytes(4) != 16) failures = failures + 1
    failures
}
