import "abla/io"
// A `when` on a nullable name: the arms after its `null ->` arm (and not
// sharing that arm's body) see the name not null, at runtime and under `#`.
fun pick(s: string?): string = when (s) {
    null -> "none"
    "a" -> "letter a ${s.size}"
    else -> "other:$s"
}
fun shared(s: string?): string = when (s) {
    "b", null -> "b or none"
    else -> "${s.size}"
}
fun later(n: int?): int = when (n) {
    0 -> 100
    null -> -1
    else -> n + 1
}
fun main: int {
    println("${pick(null)} ${pick("a")} ${pick("xyz")} ${shared(null)} ${shared("hello")} ${later(null)} ${later(41)} ${later(0)}")
    println("${#pick("xyz")} ${#shared("hey")} ${#later(1)}")
    later(41)
}
