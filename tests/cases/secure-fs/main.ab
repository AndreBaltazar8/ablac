import "abla/fs"
import "abla/fs/secure"
import "abla/sys/linux/process"

fun one(root: string): bool {
    val directory = secureDirectory(root)
    directory.descriptor >= 0
}
fun main(): int {
    val root = linuxEnvironment("ABLA_SECURE_FS_ROOT").value
    val parent = secureDirectory(root)
    if (parent.descriptor < 0) return 1
    if (parent.openDirectory("directory-link").descriptor >= 0) return 2
    if (parent.openFile("file-link").descriptor >= 0) return 3
    if (secureDirectory("$root/directory-link").descriptor >= 0) return 21
    if (parent.replaceSymlink("current", "a/b", "next") ||
        parent.replaceSymlink("current", "temp", "../next")) return 22
    for (name in ["", ".", "..", "a/b", "a\x00b"]) {
        if (parent.openDirectory(name).descriptor >= 0 || parent.openFile(name).descriptor >= 0 ||
            parent.createFile(name).descriptor >= 0 || parent.createDirectory(name) ||
            parent.renameNoReplace(name, parent, "dest") == 0 ||
            parent.renameNoReplace("source", parent, name) == 0 ||
            parent.replaceSymlink(name, "temp", "next") || parent.remove(name)) return 4
    }
    val existing = parent.createFile("existing")
    if (existing.descriptor >= 0) return 5
    val created = parent.createFile("created")
    if (created.descriptor < 0 || !created.write("payload") || !created.sync() || !created.close()) return 6
    if (!parent.createDirectory("created-dir") || parent.createDirectory("created-dir")) return 7
    val child = parent.openDirectory("created-dir")
    if (child.descriptor < 0 || !child.sync() || !child.close()) return 8
    if (parent.renameNoReplace("source", parent, "destination") == 0) return 9
    if (Path("$root/source").readText() != "source" || Path("$root/destination").readText() != "destination") return 10
    if (parent.renameNoReplace("source", parent, "renamed") != 0) return 11
    if (!parent.replaceSymlink("current", "temp-link", "new")) return 12
    if (Path("$root/current").linkTarget() != "new") return 13
    if (parent.replaceSymlink("current", "occupied", "other")) return 14
    if (Path("$root/current").linkTarget() != "new") return 15
    if (parent.replaceSymlink("existing", "temp-regular", "new")) return 18
    if (Path("$root/existing").readText() != "file") return 19
    if (parent.replaceSymlink("dir", "temp-directory", "new")) return 20
    if (!parent.sync()) return 16
    var i = 0
    while (i < 1000) { if (!one(root)) return 17; i += 1 }
    0
}
