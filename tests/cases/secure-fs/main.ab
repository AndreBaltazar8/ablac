import "abla/fs"
import "abla/fs/secure"
import "abla/sys/linux"
import "abla/sys/linux/process"

fun one(root: string): bool {
    val directory = secureDirectory(root)
    if (directory.descriptor < 0) return false
    directory.list(100, 255).error == ""
}
fun main(): int {
    val root = linuxEnvironment("ABLA_SECURE_FS_ROOT").value
    val parent = secureDirectory(root)
    if (parent.descriptor < 0) return 1
    if (parent.openDirectory("directory-link").descriptor >= 0) return 2
    if (parent.openFile("file-link").descriptor >= 0) return 3
    if (parent.entryKind("existing") != "file" || parent.entryKind("dir") != "directory" ||
        parent.entryKind("file-link") != "symlink" || parent.entryKind("fifo") != "other" ||
        parent.entryKind("missing") != "missing" ||
        parent.entryKind("../bad") != "error") return 28
    val listingRoot = secureDirectory(root)
    val listing = listingRoot.list(100, 255)
    if (listing.error != "" || listing.names.size != 10) return 29
    val listingAgain = listingRoot.list(100, 255)
    if (listingAgain.error != "" || listingAgain.names.size != listing.names.size) return 35
    val emptyDir = parent.openDirectory("dir")
    val emptyListing = emptyDir.list(0, 0)
    if (emptyListing.error != "" || emptyListing.names.size != 0) return 32
    val limited = secureDirectory(root)
    if (limited.list(1, 255).error != "limit") return 30
    val shortNames = secureDirectory(root)
    if (shortNames.list(100, 1).error != "limit") return 31
    if (secureDirectory("$root/directory-link").descriptor >= 0) return 21
    if (parent.replaceSymlink("current", "a/b", "next") ||
        parent.replaceSymlink("current", "temp", "../next")) return 22
    for (name in ["", ".", "..", "a/b", "a\x00b"]) {
        if (parent.openDirectory(name).descriptor >= 0 || parent.openFile(name).descriptor >= 0 ||
            parent.createFile(name).descriptor >= 0 || parent.createDirectory(name) ||
            parent.renameNoReplace(name, parent, "dest") == 0 ||
            parent.renameNoReplace("source", parent, name) == 0 ||
            parent.replaceSymlink(name, "temp", "next") || parent.remove(name)) return 4
    }
    if (parent.openRegularFile("file-link").descriptor >= 0 ||
        parent.openRegularFile("dir").descriptor >= 0 ||
        parent.openRegularFile("fifo").descriptor >= 0) return 27
    val binary = parent.openRegularFile("binary").read(2)
    if (binary.error != "" || binary.data.size != 2 || binary.data[0] != 0 || binary.data[1] !=
        255) return 33
    val bounded = parent.openRegularFile("existing")
    if (bounded.descriptor < 0 || bounded.read(3).error != "limit") return 23
    val exact = parent.openFile("existing")
    if (exact.permissions() != 0o640 || !exact.isRegular()) return 34
    if (parent.openFile("dir").isRegular()) return 36
    val exactRead = exact.read(4)
    if (exactRead.error != "" || exactRead.data != "file") return 24
    val emptyLimit = parent.openFile("existing")
    if (emptyLimit.read(0).error != "limit") return 25
    if (parent.openFile("existing").read(-1).error != "invalid") return 26
    val chunks = parent.openRegularFile("existing")
    if (chunks.size() != 4) return 42
    val chunk1 = chunks.readChunk(2)
    val chunk2 = chunks.readChunk(2)
    val eof = chunks.readChunk(2)
    if (chunk1.data != "fi" || chunk1.eof || chunk2.data != "le" || chunk2.eof ||
        !eof.eof || eof.error != "" || !chunks.rewind()) return 37
    if (chunks.readChunk(4).data != "file" || chunks.readChunk(0).error != "invalid") return 38
    if (!chunks.rewind()) return 40
    val duplicate = chunks.duplicate()
    if (duplicate.descriptor < 0) return 41
    val flags = linuxSyscall2(72, duplicate.descriptor, 1)
    if (flags < 0 || (flags & 1) != 1 ||
        duplicate.readChunk(2).data != "fi" || !duplicate.close() ||
        chunks.readChunk(2).data != "le" || !chunks.rewind()) return 41
    val checked = parent.createFile("checked")
    if (checked.descriptor < 0 || checked.writeChecked("payload") != "" ||
        !checked.close()) return 39
    val existing = parent.createFile("existing")
    if (existing.descriptor >= 0) return 5
    val created = parent.createFile("created")
    if (created.descriptor < 0 || !created.write("payload") || !created.sync() ||
        !created.close()) return 6
    if (!parent.createDirectory("created-dir") || parent.createDirectory("created-dir")) return 7
    val child = parent.openDirectory("created-dir")
    if (child.descriptor < 0 || !child.sync() || !child.close()) return 8
    if (parent.renameNoReplace("source", parent, "destination") == 0) return 9
    if (Path("$root/source").readText() != "source" || Path("$root/destination").readText() !=
        "destination") return 10
    if (parent.renameNoReplace("source", parent, "renamed") != 0) return 11
    if (!parent.replaceSymlink("current", "temp-link", "new")) return 12
    if (Path("$root/current").linkTarget() != "new") return 13
    if (parent.replaceSymlink("current", "occupied", "other")) return 14
    if (Path("$root/current").linkTarget() != "new") return 15
    if (parent.replaceSymlink("existing", "temp-regular", "new")) return 18
    if (Path("$root/existing").readText() != "file") return 19
    if (parent.replaceSymlink("dir", "temp-directory", "new")) return 20
    if (!parent.sync()) return 16
    var i = 0
    while (i < 1000) { if (!one(root)) return 17; i += 1 }
    0
}
