import "abla/fs/secure"
import "abla/process/arguments"
import "abla/sys/linux/fs"
fun main(): int {
    if (processArgument(1) == "read") {
        val input = SecureFile(linuxOpen(processArgument(0), 0).descriptor)
        if (input.descriptor < 0) return 3
        val chunk = input.readChunk(7)
        if (chunk.error != "" || chunk.data != "payload" || !input.close()) return 4
        return 0
    }
    val file = SecureFile(linuxOpen(processArgument(0), 1025).descriptor)
    if (file.descriptor < 0) return 1
    val result = file.writeChecked("payload")
    if (result != processArgument(1) || !file.close()) return 2
    0
}
