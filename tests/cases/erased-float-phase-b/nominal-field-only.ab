import "abla/runtime/scalar"
type Temperature = f64
class Holder(val value: Temperature)
trusted fun auxiliary(value: any): int = ablaRuntimeLoadI32(ablaRuntimeValueAddress(value) + 4)
fun main: int {
    val holder = Holder(Temperature(1.5))
    val result = __ablaRuntimeFieldGet(holder, 299623629)
    if (auxiliary(result) == 2) 0 else 1
}
