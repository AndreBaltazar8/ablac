import "abla/runtime/scalar"
trusted fun auxiliary(value: any): int = ablaRuntimeLoadI32(ablaRuntimeValueAddress(value) + 4)
fun fieldSymbol(name: string): int {
    var hash = 181
    for (index in 0 until name.size) {
        hash = hash * 281 + name[index] + 1
        hash = hash - (hash / 1000000007) * 1000000007
    }
    if (hash < 0) 0 - hash else hash
}
type Temperature = f64
class TypedFields(val narrow: f32, val wide: f64, val dense: array<f64>, val nominal: Temperature)
fun <T> addValue(var values: array<any>, value: T): void { values.append(value) }
fun <T> addPair(var values: array<T>, value: T): void { values.append(value) }
fun makeValues(): array<any> = [1.5, 42]
fun makeFloats(): array<any> = [1.5, 2.25]
fun firstKind(values: array<any>): int = auxiliary(values[0])
fun optionalKind(value: array<f64>?): int = auxiliary(value)
fun <T> genericKind(value: T): int = auxiliary(value)
@export("check")
fun main: int {
    val values: array<any> = [1.5, f32(2.25), 7]
    if (auxiliary(values[0]) != 2 || auxiliary(values[1]) != 1 || auxiliary(values[2]) != 0) return 1
    values[2] = 3.0
    if (auxiliary(values[2]) != 2) return 2
    values.append(f32(4.0))
    if (auxiliary(values[3]) != 1) return 3
    val map: Map<string, any> = Map()
    map.set("x", 1.5)
    val found = map.get("x")
    if (found == null || auxiliary(found) != 2) return 4
    addValue(values, 5.0)
    if (auxiliary(values[4]) != 2) return 5
    val returned = makeValues()
    if (auxiliary(returned[0]) != 2 || auxiliary(returned[1]) != 0) return 6
    val nested: array<array<any>> = [[1.5, 42], [f32(2.25)]]
    if (auxiliary(nested[0][0]) != 2 || auxiliary(nested[1][0]) != 1) return 7
    val mixed: Map<int, any> = Map()
    mixed.set(1, f32(2.25))
    val foundMixed = mixed.get(1)
    if (foundMixed == null || auxiliary(foundMixed) != 1) return 8
    val fields = TypedFields(f32(2.25), 1.5, [1.5], Temperature(1.5))
    if (auxiliary(__ablaRuntimeFieldGet(fields, fieldSymbol("narrow"))) != 1) return 9
    if (auxiliary(__ablaRuntimeFieldGet(fields, fieldSymbol("wide"))) != 2) return 10
    val typed: array<f64> = [1.5, 2.25]
    if (auxiliary(__ablaRuntimeIndexGet(typed, 0)) != 2) return 11
    val dense = __ablaRuntimeFieldGet(fields, fieldSymbol("dense"))
    if (auxiliary(__ablaRuntimeIndexGet(dense, 0)) != 2) return 12
    val outer: array<array<f32>> = [[f32(1.5)]]
    val inner = __ablaRuntimeIndexGet(outer, 0)
    if (auxiliary(__ablaRuntimeIndexGet(inner, 0)) != 1) return 13
    if (optionalKind(null) != 0) return 14
    if (optionalKind(typed) != 2) return 15
    val nominal: array<Temperature> = [Temperature(1.5)]
    if (auxiliary(__ablaRuntimeIndexGet(nominal, 0)) != 2) return 16
    val optionalElements: array<f64?> = [null, 1.5]
    if (auxiliary(__ablaRuntimeIndexGet(optionalElements, 0)) != 0) return 17
    if (auxiliary(__ablaRuntimeIndexGet(optionalElements, 1)) != 2) return 18
    val optionalNested: array<array<f64>?> = [null, [1.5]]
    if (auxiliary(__ablaRuntimeIndexGet(optionalNested, 0)) != 0) return 19
    val nestedItem = __ablaRuntimeIndexGet(optionalNested, 1)
    if (auxiliary(__ablaRuntimeIndexGet(nestedItem, 0)) != 2) return 20
    if (genericKind(typed) != 2 || genericKind(17) != 0) return 21
    if (auxiliary(__ablaRuntimeFieldGet(fields, fieldSymbol("nominal"))) != 2) return 22
    addPair<any>(values, 2.75)
    if (auxiliary(values[5]) != 2) return 24
    val erasedArrays: array<any> = [[1.5, 2.25]]
    if (auxiliary(__ablaRuntimeIndexGet(erasedArrays[0], 0)) != 2) return 25
    val onlyFloats: array<any> = [1.5, 2.25]
    if (auxiliary(onlyFloats[0]) != 2 || auxiliary(makeFloats()[0]) != 2) return 26
    if (firstKind([1.5]) != 2) return 27
    for (index in 0 until 100) values.append(1.5)
    if (auxiliary(values[0]) != 2 || auxiliary(values[105]) != 2) return 23
    0
}
