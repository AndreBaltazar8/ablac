import "abla/runtime/scalar"
class Holder(val value: f64?)
trusted fun auxiliary(value: any): int = ablaRuntimeLoadI32(ablaRuntimeValueAddress(value) + 4)
fun main: int {
    val present = Holder(1.5)
    val absent = Holder(null)
    val result = __ablaRuntimeFieldGet(present, 299623629)
    val nullResult = __ablaRuntimeFieldGet(absent, 299623629)
    if (auxiliary(result) == 2 && auxiliary(nullResult) == 0) 0 else 1
}
