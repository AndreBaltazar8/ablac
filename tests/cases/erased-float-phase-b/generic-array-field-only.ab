import "abla/runtime/scalar"
class Holder<T>(val value: array<T>)
trusted fun auxiliary(value: any): int = ablaRuntimeLoadI32(ablaRuntimeValueAddress(value) + 4)
fun main: int {
    val holder = Holder<f64>([1.5])
    val values = __ablaRuntimeFieldGet(holder, 299623629)
    val result = __ablaRuntimeIndexGet(values, 0)
    if (auxiliary(result) == 2) 0 else 1
}
