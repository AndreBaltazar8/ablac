// The raw-pointer ("native") versions of abla/text, abla/json and abla/compression/gzip against their portable twins on generated bytes
// (#1139 area 7). Each has two bodies: the native one, which ordinary code and the JIT tier of the compile-time evaluator run, and a portable
// one for the interpreter tier. The program builds the same results at run time and at compile time (#); built under each ABLA_COMPILE_EVAL tier, the
// three must agree for every input. Prints "native-twins ok".
import "abla/io"
import "abla/text"
import "abla/bytes"
import "abla/json"
import "abla/compression/gzip"

val ALPHABET: array<int> = [97, 98, 65, 90, 48, 32, 9, 10, 13, 34, 92, 47, 123, 125, 91, 93, 44, 58, 45, 43, 46, 101, 69, 116, 114, 117, 108, 110, 102, 0, 1, 31, 127, 128, 160, 191, 192, 194, 195, 223, 224, 237, 239, 240, 244, 245, 255, 117, 117]
val JSON_TEMPLATES: array<string> = [
    "{\"a\":[1,2.5,-3e2,\"x\\n\\u00e9\\ud83d\\ude00\"],\"b\":null,\"c\":{\"d\":true,\"e\":false}}",
    "[\"\\\\\\\"\\/\\b\\f\\n\\r\\t\\u0000\\u001f\",\"plain text with ünicode\",\"\",\"a\"]",
    "{\"k\":\"v\",\"k\":\"w\",\"\":[[],[[]],{}]}",
    "  [ 1 , 2 ,3 ]  ",
    "\"just a string \\u00ff\"",
    "12345678901234567890"]
val TEXT_TEMPLATES: array<string> = ["Hello, World! ABC xyz", "ünïcödé 日本語 😀 text", "needle in a haystack with needle", "aaaaabaaaaab", ""]

fun next(state: int): int = (state * 6364136223846793005 + 1442695040888963407) & 9223372036854775807

fun byteText(byte: int): string {
    val buffer = byteBuffer()
    buffer.appendByteValue(byte)
    buffer.toText()
}

// A template with 0 to 5 edits: a byte replaced, inserted or deleted, or the input cut short; sometimes random bytes instead.
fun generate(templates: array<string>, index: int): string {
    var state = next(index * 7919 + 13)
    var text = templates[(state >> 20) % templates.size]
    state = next(state)
    if ((state >> 30) % 11 == 0) {
        val length = (state >> 24) % 40
        var bytes = ""
        for (i in 0 until length) {
            state = next(state)
            bytes = bytes + byteText(ALPHABET[(state >> 22) % ALPHABET.size])
        }
        return bytes
    }
    val edits = (state >> 24) % 6
    for (e in 0 until edits) {
        state = next(state)
        if (text.size == 0) break
        val at = (state >> 16) % text.size
        state = next(state)
        val piece = byteText(ALPHABET[(state >> 22) % ALPHABET.size])
        state = next(state)
        val kind = (state >> 28) % 4
        if (kind == 0) text = text.slice(0, at) + piece + text.slice(at + 1, text.size)
        else if (kind == 1) text = text.slice(0, at) + piece + text.slice(at, text.size)
        else if (kind == 2) text = text.slice(0, at) + text.slice(at + 1, text.size)
        else text = text.slice(0, at)
    }
    text
}

fun hexOf(s: string): string {
    var out = ""
    for (b in s) out = out + "0123456789abcdef".slice(b / 16, b / 16 + 1) + "0123456789abcdef".slice(b % 16, b % 16 + 1)
    out
}

fun renderText(index: int): string {
    val s = generate(TEXT_TEMPLATES, index)
    val needle = generate(TEXT_TEMPLATES, index + 100000)
    val short = if (needle.size > 3) needle.slice(0, 3) else needle
    "${hexOf(s)}|${s.isValidUtf8()}|${s.codePointCount()}|${s.lastIndexOf(short)}|${hexOf(s.lowercase())}|${hexOf(s.uppercase())}|${s.indexOf(short)}"
}

fun renderJson(index: int): string {
    val source = generate(JSON_TEMPLATES, index)
    val parsed = jsonParse(source)
    if (!parsed.succeeded) return "${hexOf(source)}|error|${parsed.error.code}|${parsed.error.byteOffset}"
    hexOf(source) + "|" + hexOf(jsonStringify(parsed.value))
}

fun renderGzip(index: int): string {
    val source = generate(TEXT_TEMPLATES, index + 500000) + generate(TEXT_TEMPLATES, index + 700000)
    val packed = gzipCompress(source)
    val unpacked = gzipDecompress(packed, 1000000)
    // Random bytes that may be a gzip stream, and the compressed stream with one byte changed.
    val noise = generate(TEXT_TEMPLATES, index + 900000)
    val broken = if (packed.size > 12) packed.slice(0, 12) + byteText(noise.size % 256) + packed.slice(13, packed.size) else packed
    val fromNoise = gzipDecompress(noise, 1000)
    val fromBroken = gzipDecompress(broken, 1000)
    "${hexOf(packed)}|${unpacked.error == "" && unpacked.data == source}|${fromNoise.error}|${hexOf(fromNoise.data)}|${fromBroken.error}|${hexOf(fromBroken.data)}"
}

fun cases(count: int): array<string> {
    val out: array<string> = []
    for (i in 0 until count) out.append(renderText(i) + "#" + renderJson(i) + "#" + (if (i % 50 == 0) renderGzip(i) else ""))
    out
}

fun main: int {
    val live = cases(1500)
    val staged = #cases(1500)
    var bad = 0
    if (live.size != staged.size) bad = 1
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            if (bad < 3) println("FAIL case ${i}:\n  run time:     ${live[i]}\n  compile time: ${staged[i]}")
            bad = bad + 1
        }
    }
    if (bad > 0) return 1
    println("native-twins ok")
    0
}
