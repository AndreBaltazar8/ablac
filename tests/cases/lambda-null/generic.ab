fun <T> call(f: (int) -> T?): T? = f(1)
fun <T> maker(): (int) -> T? = { x: int -> null }
fun main: int {
    val text: string? = call<string>({ x: int -> null })
    val number: int? = call<int>({ x: int -> null })
    val stringMaker = maker<string>()
    val intMaker = maker<int>()
    if (text == null && number == null && stringMaker(1) == null && intMaker(1) == null) 0 else 1
}
