fun isMissing(f: (int) -> string?): bool = f(7) == null
class Handler(val f: (int) -> string?)
val globalMissing: (int) -> string? = { n: int -> null }
fun checks(): int {
    val local: (int) -> string? = { n: int -> null }
    val callbacks: array<(int) -> string?> = [{ n: int -> null }]
    val holder = Handler({ n: int -> null })
    if (!isMissing({ x: int -> null })) return 1
    if (!isMissing({ x -> if (x > 0) null else null })) return 2
    if (!isMissing({ x: int -> return null })) return 3
    if (!isMissing(local) || !isMissing(callbacks[0]) || !isMissing(holder.f)) return 4
    if (!isMissing(globalMissing)) return 5
    0
}
fun main: int = checks()
