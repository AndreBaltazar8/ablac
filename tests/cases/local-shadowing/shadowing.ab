// A local of a nested block may shadow a parameter, an outer local or a
// field: every use inside the block binds to the innermost declaration, and
// the outer binding is the name's meaning again once the block ends.

fun shadowParameterInBlock(width: f64, flag: bool): f64 {
    var result = 0.0
    if (flag) {
        val flag = 0.5
        result = width * flag
    }
    if (flag) result + 1.0 else result
}

fun shadowLocalInBlock(width: f64): f64 {
    val flag = true
    var result = 0.0
    if (flag) {
        val flag = 0.25
        result = width * flag
    }
    if (flag) result else -1.0
}

fun shadowNestedTwice(value: int): int {
    var total = value
    if (value > 0) {
        val value = 10
        total = total + value
        if (value > 5) {
            val value = 100
            total = total + value
        }
        total = total + value
    }
    total + value
}

fun shadowInLoop(count: int): int {
    var sum = 0
    var index = 0
    while (index < count) {
        val count = 2
        sum = sum + count
        index = index + 1
    }
    sum + count
}

fun shadowInLambda(base: int): int {
    val read = { ->
        var inner = 0
        if (base > 0) {
            val base = 7
            inner = base
        }
        inner * 100 + base
    }
    read()
}

fun applyEach(values: array<int>, function: (int) -> int): int {
    var total = 0
    for (value in values) total = total + function(value)
    total
}

fun shadowLambdaParameter(offset: int): int = applyEach([1, 2], { value ->
    var result = value
    if (value > 1) {
        val value = 100
        result = result + value
    }
    result + value + offset
})

fun shadowLoopValue(): int {
    var sum = 0
    for (value in 1..3) {
        val value = 10
        sum = sum + value
    }
    sum
}

fun shadowCapturedMutation(): int {
    var total = 0
    val add = { amount: int ->
        if (amount > 0) {
            var total = 1000
            total = total - amount
        }
        total = total + amount
    }
    add(5)
    add(6)
    total
}

fun shadowRefined(value: int?): int {
    var result = 0
    if (value != null) {
        val value = true
        if (value) result = 1
    }
    if (value != null) result + value else result
}

class ShadowScale(val factor: int) {
    fun apply(amount: int): int {
        var result = amount
        if (amount > 0) {
            val amount = factor * 2
            result = result + amount
        }
        result + amount
    }

    fun scaled(): int {
        var result = 0
        if (factor > 0) {
            val factor = 10
            result = factor
        }
        result + factor
    }
}

compile fun stagedShadowing(value: int): int {
    var total = value
    if (value > 0) {
        val value = 10
        total = total + value
    }
    val read = { ->
        var inner = 0
        if (total > 0) {
            val total = 5
            inner = total
        }
        inner + total
    }
    read() + value
}

fun shadowingChecks(): int {
    val scale = ShadowScale(3)
    if (shadowParameterInBlock(8.0, true) == 5.0 &&
        shadowLocalInBlock(8.0) == 2.0 &&
        shadowNestedTwice(1) == 122 &&
        shadowInLoop(3) == 9 &&
        shadowInLambda(3) == 703 &&
        shadowLambdaParameter(5) == 116 &&
        shadowLoopValue() == 30 &&
        shadowCapturedMutation() == 11 &&
        shadowRefined(4) == 5 &&
        scale.apply(4) == 14 &&
        scale.scaled() == 13 &&
        #stagedShadowing(1) == 17) 42 else 0
}
