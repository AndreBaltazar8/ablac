// filledArray(count, value): count copies of a number, bool or string in one
// allocation; the array is an ordinary one afterwards.
import "abla/float"

fun zeros(count: int): array<int> = filledArray(count, 0)

compile fun table(): array<int> = filledArray(3, 7)

val TABLE = #table()

fun main: int {
    val counts = zeros(5)
    if (counts.size != 5 || counts[0] != 0 || counts[4] != 0) return 1
    counts[2] = 9
    counts.append(4)
    if (counts[2] != 9 || counts[1] != 0 || counts.size != 6 || counts[5] != 4) return 2
    val names = filledArray(3, "x")
    names[1] = "y"
    if (names[0] != "x" || names[1] != "y" || names[2] != "x") return 3
    val flags = filledArray(2, true)
    val weights = filledArray(4, 0.5)
    if (!flags[1] || weights[3] != 0.5 || f64ToBits(weights[0]) != f64ToBits(0.5)) return 4
    if (filledArray(0, 1).size != 0) return 5
    if (TABLE.size != 3 || TABLE[0] != 7 || TABLE[2] != 7) return 6
    var total = 0
    for (value in filledArray(1000, 3)) total += value
    if (total != 3000) return 7
    42
}
