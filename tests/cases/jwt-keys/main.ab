// The RSA keys abla/jwt takes from a JWKS (#1139 area 4): RFC 7518 6.3.1.1 wants n and e as minimal-length big-endian numbers, with no leading zero byte.
// The size check (256 bytes, 2048 bits) counted bytes, so a modulus of 250 zero bytes and a 64-bit number passed it and was a usable key that anyone can
// factor. A real 2048-bit key still imports, and a key whose n or e has a leading zero byte does not.
import "abla/io"
import "abla/bytes"
import "abla/text"
import "abla/jwt"

val jwtKeysRealModulus = "m_rnVgF9pSE1UCrJEQwWupUur65twAz5IvMFrzlDZDPETiMntDVQXY9f35xDhj4Cip2kqV0MSx7-tumgKd-RaFAxH0YAl600_OfDu0Y-PaH3cZHQ1eAg-m8DfoBfFARs7XP7OikVt8UAPQdHrQ7PasE6qrLs2cqyx7Bhp5eSW-dAuiS4m0lsMc9Wj5gY7neRmofZB3trZtqGv1CsTBJvp75Exq9wGeWmLTZw6jJSGIY0etiZdnVJSf6QRLXIqLn2EUgcIx1RL9fmg34wgL8UDKhFej2nbSlA3ueRQj8OMpT-NMpi93qk_tw78hJMXteSv51rkDlcCApPwfliOCeG5w"

fun keySet(modulus: string, exponent: string): JwtKeySet =
    jwtKeySet("{\"keys\":[{\"kty\":\"RSA\",\"alg\":\"RS256\",\"kid\":\"k\",\"n\":\"" + modulus + "\",\"e\":\"" + exponent + "\"}]}")

fun main: int {
    var bad = 0
    val real = keySet(jwtKeysRealModulus, "AQAB")
    if (real.size() != 1) {
        println("the real key does not import: ${real.error}")
        bad = bad + 1
    }
    // 250 zero bytes and an odd 64-bit number.
    val padded = jwtBase64UrlEncode("\x00".repeat(250) + "\xc3\x5a\x91\x27\x6b\x11\x85\x4d")
    val weak = keySet(padded, "AQAB")
    if (weak.size() != 0) {
        println("a modulus padded with zero bytes imports")
        bad = bad + 1
    }
    // The real modulus with one zero byte in front (258 bytes by count, the same value).
    val withZero = keySet(jwtBase64UrlEncode("\x00" + jwtBase64UrlDecode(jwtKeysRealModulus).bytes), "AQAB")
    if (withZero.size() != 0) {
        println("a modulus with a leading zero byte imports")
        bad = bad + 1
    }
    // The exponent 65537 with a leading zero byte.
    val zeroExponent = keySet(jwtKeysRealModulus, jwtBase64UrlEncode("\x00\x01\x00\x01"))
    if (zeroExponent.size() != 0) {
        println("an exponent with a leading zero byte imports")
        bad = bad + 1
    }
    if (bad == 0) 42 else 1
}
