// A thread inside an export that is blocked in the host's code (a JNI callback, a UI thread's message) counts as
// stopped for another thread's collection (#811): tools/test-foreign-threads.sh, driver mode -b.
import "abla/memory"

// The driver's: it sleeps for the given milliseconds, and answers 1.
@hostImport
noescape extern:"c" fun abla_test_host_block(milliseconds: i64): i64

fun blockInHost(milliseconds: int): int = int(abla_test_host_block(milliseconds))

// Collections that stopped other threads, and stops abandoned (memoryHeapStat 7 and 8).
fun stopsSoFar(zero: int): int = memoryHeapStat(7) + zero

fun abandonedSoFar(zero: int): int = memoryHeapStat(8) + zero

// A library that is entered through its exports has no safe points unless it asks for collection under allocation
// pressure: this is the ask (a reachable memorySetCollectionGrowth compiles every allocating function as a safe point).
fun enableCollection(zero: int): int {
    memorySetCollectionGrowth(1048576)
    zero
}
