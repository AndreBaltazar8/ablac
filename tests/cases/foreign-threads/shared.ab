// What the shared-library tests call from threads the library did not start (tests/cases/android-run/driver.c, run by
// tools/test-foreign-threads.sh on x86-64 Linux and tools/test-android-run.sh on bionic) (#811).

// The host's hook (the driver defines it): it calls abla_run_nested from inside the library's global initialization.
noescape extern:"c" fun abla_test_host_hook(): i64

// A global whose initializer calls the host, which calls an export again: a nested export while the globals initialize.
val seedFromHost = int(abla_test_host_hook())

fun nestedAnswer(zero: int): int = 77 + zero

fun seedValue(zero: int): int = seedFromHost + zero

// Called with the thread's number: a list of strings that has to survive the garbage the thread makes after it
// (collections run as the loop allocates), each string checked at the end.
fun churn(id: int): int {
    val keep: array<string> = []
    for (index in 0 until 200) keep.append("k$id-$index")
    var made = 0
    for (round in 0 until 400) {
        var garbage = ""
        for (piece in 0 until 20) garbage = "$garbage$round.$piece,"
        made = made + garbage.size
    }
    for (index in 0 until 200) if (keep[index] != "k$id-$index") return 0
    if (made > 0) 1 else 0
}
