import "abla/build"

// A library that calls a C function nobody defines and that is not marked @hostImport: a macOS dylib must not link
// (tools/test-foreign-threads.sh), so a misspelled or missing symbol is a link error, not a crash at load or call.
val exportedMissing = #exportFunction("callMissing", "abla_run_missing")

noescape extern:"c" fun abla_symbol_nobody_defines(): i64

fun callMissing(zero: int): int = int(abla_symbol_nobody_defines()) + zero
