import "abla/io"
import "abla/json"

// A raw node is one already-encoded JSON value that jsonStringify writes verbatim: inside arrays and objects,
// at the root, and (the first compile-time path and the runtime's sized path both) for large texts. jsonRaw
// accepts exactly one well-formed value and returns null for anything else; jsonParse never yields a raw node.
fun expect(name: string, got: string, want: string): int {
    if (got == want) return 0
    println("$name: got $got, want $want")
    1
}

fun main: int {
    var bad = 0
    val raw = jsonRaw("[1, {\"a\":\"b\"} ,null]")
    if (raw == null) return 1
    bad = bad + expect("nested", jsonStringify(jsonObject(["x", "y", "z"], [jsonInteger(1), raw, jsonString("é")])),
        "{\"x\":1,\"y\":[1, {\"a\":\"b\"} ,null],\"z\":\"é\"}")
    bad = bad + expect("root", jsonStringify(raw), "[1, {\"a\":\"b\"} ,null]")
    bad = bad + expect("array", jsonStringify(jsonArray([raw, jsonNull(), raw])),
        "[[1, {\"a\":\"b\"} ,null],null,[1, {\"a\":\"b\"} ,null]]")
    bad = bad + expect("kind", "${raw.kind} ${raw.isRaw()} ${raw.isArray()} ${raw.isObject()} ${raw.isNull()} ${raw.size()} ${raw.asString() == ""} ${raw.get("a").isNull()}", "6 true false false false 0 true true")
    bad = bad + expect("text", raw.rawText(), "[1, {\"a\":\"b\"} ,null]")
    bad = bad + expect("other kinds have no raw text", "${jsonString("x").rawText() == ""} ${jsonString("x").isRaw()}", "true false")
    for (text in ["", "1 2", "[1,", "{\"a\":}", "[1] x", "\"\xff\"", "nul", "[01]", "{\"a\":1,}"]) {
        if (jsonRaw(text) != null) {
            println("accepted: $text")
            bad = bad + 1
        }
    }
    for (text in ["0", "-1.5e3", "\"a\\u00e9\"", "true", "null", "[]", "{}", "  [ 1 ]  "]) {
        val ok = jsonRaw(text)
        if (ok == null) {
            println("rejected: $text")
            bad = bad + 1
        } else bad = bad + expect("verbatim $text", jsonStringify(ok), text)
    }
    // Large: an array of many elements, as a service's per-document list would be.
    val big: array<string> = []
    for (index in 0 until 20000) big.append("{\"name\":\"n$index\",\"range\":{\"start\":$index,\"end\":${index + 1}}}")
    val text = "[" + big.join(",") + "]"
    val large = jsonRaw(text)
    if (large == null) {
        println("the large text was rejected")
        bad = bad + 1
    } else {
        bad = bad + expect("large size", "${jsonStringify(jsonObject(["v"], [large])).size}", "${text.size + 6}")
        bad = bad + expect("large content", jsonStringify(jsonObject(["v"], [large])), "{\"v\":$text}")
    }
    // The unchecked constructor writes what it is given, and a parsed tree is never raw.
    bad = bad + expect("unchecked", jsonStringify(jsonRawUnchecked("[2]")), "[2]")
    val parsed = jsonParse("[1,{\"a\":2}]")
    bad = bad + expect("parsed", "${parsed.value.kind} ${parsed.value.at(1).kind} ${parsed.value.isRaw()}", "4 5 false")
    if (bad == 0) println("json raw ok")
    if (bad == 0) 42 else 1
}
