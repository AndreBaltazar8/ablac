// abla/tls/pure's server against abla/tls/pure's client, in one process with no sockets (bytes moved between the two
// state machines), over certificates made by openssl (tools/test-tls-pure-interop.sh passes the directory with
// <kind>.pem / <kind>.key for rsa, p256, ed25519 and client-<kind>.pem / .key): every key kind x every cipher
// suite x a client that has an X25519 share and a server that wants X25519 or only P-256 (a HelloRetryRequest);
// application data both ways in many records; ALPN; client certificates (accepted, absent and optional, absent and
// required, rejected by the verifier); a client without TLS 1.3, no suite or group in common; close_notify;
// KeyUpdate; damaged input to the server. Prints "tls-pure server ok".
import "abla/io"
import "abla/crypto"
import "abla/crypto/x509"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/tls/pure/client"
import "abla/tls/pure/handshake"
import "abla/tls/pure/identity"
import "abla/tls/pure/record"
import "abla/tls/pure/server"
import "abla/tls/pure/tls12"
import "abla/text"
import "abla/tls/pure/verify"

var failures = 0
var seed = 99

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL $what")
    return
}

fun random(count: int): string {
    val bytes: array<int> = []
    for (i in 0 until count) {
        seed = (seed * 1103515245 + 12345) & 2147483647
        bytes.append((seed >> 8) & 255)
    }
    cryptoByteString(bytes)
}

fun failingRandom(count: int): string = ""
fun read(path: string): string = linuxReadFile(path, 1048576)
fun now(): int = linuxRealtimeNanoseconds() / 1000000000

// Moves bytes between the two until neither has anything to say.
fun pump(var client: TlsClient, var server: TlsServer): void {
    var rounds = 0
    while (rounds < 50) {
        val toServer = client.takeOutput()
        if (toServer.size > 0) server.feed(toServer)
        val toClient = server.takeOutput()
        if (toClient.size > 0) client.feed(toClient)
        if (toServer.size == 0 && toClient.size == 0) return
        rounds = rounds + 1
    }
    return
}

fun clientFor(store: X509TrustStore, host: string): TlsClient {
    val config = tlsClientConfig(host, tlsX509Verifier(store, now), random)
    tlsClientNew(config)
}

fun trusting(path: string): X509TrustStore = x509TrustStoreFromPem(read(path))

fun acceptAny(chain: array<string>, scheme: int, content: string, signature: string): TlsVerdict = tlsAccepted()

fun trustClient(store: X509TrustStore): (array<string>, int, string, string) -> TlsVerdict =
    { chain: array<string>, scheme: int, content: string, signature: string ->
        tlsVerifyClientCertificate(chain, scheme, content, signature, store, now())
    }

fun main: int {
    val directory = processArgument(0)
    // Every key kind x every suite x X25519 / HelloRetryRequest.
    for (kind in ["ed25519", "p256", "rsa"]) {
        val identity = tlsIdentityFromPem(read("$directory/$kind.pem"), read("$directory/$kind.key"))
        if (!identity.ok()) {
            fail("$kind identity: ${identity.error}")
            continue
        }
        val store = trusting("$directory/$kind.pem")
        for (suite in [TLS_SUITE_AES_128_GCM_SHA256, TLS_SUITE_AES_256_GCM_SHA384, TLS_SUITE_CHACHA20_POLY1305_SHA256]) {
            for (groups in [[TLS_GROUP_X25519], [TLS_GROUP_SECP256R1]]) {
                val name = "$kind suite $suite groups ${groups[0]}"
                val config = TlsServerConfig(identity, [suite], groups, [], random, false, false, acceptAny)
                var client = clientFor(store, "localhost")
                var server = tlsServerNew(config)
                pump(client, server)
                if (client.failed() || server.failed()) {
                    fail("$name: client [${client.error}] server [${server.error}]")
                    continue
                }
                if (!client.connected() || !server.connected()) {
                    fail("$name: not connected")
                    continue
                }
                if (client.suite != suite) fail("$name: suite ${client.suite}")
                if (groups[0] == TLS_GROUP_SECP256R1 && !client.retried) fail("$name: no HelloRetryRequest")
                if (groups[0] == TLS_GROUP_X25519 && client.retried) fail("$name: an unneeded HelloRetryRequest")
                // Application data both ways, a lot of it (many records).
                val big = random(70000)
                if (!client.send(big) || !server.send("hello from the server")) fail("$name: send refused")
                pump(client, server)
                if (server.takeApplicationData() != big) fail("$name: the server did not get the client's data")
                if (client.takeApplicationData() != "hello from the server") fail("$name: the client did not get the server's data")
                // close_notify both ways.
                client.close()
                pump(client, server)
                if (!server.closed()) fail("$name: the server did not see close_notify")
            }
        }
    }

    val ed = tlsIdentityFromPem(read("$directory/ed25519.pem"), read("$directory/ed25519.key"))
    val edStore = trusting("$directory/ed25519.pem")
    // TLS 1.2 (the modern subset), every key kind x every suite whose key type matches x both ways of being 1.2:
    // a default client against a TLS 1.2-only server, and a TLS 1.2-only client against a default server (which says
    // so in its random: the downgrade sentinel).
    for (kind in ["ed25519", "p256", "rsa"]) {
        val identity12 = tlsIdentityFromPem(read("$directory/$kind.pem"), read("$directory/$kind.key"))
        val store12 = trusting("$directory/$kind.pem")
        val rsaKey = kind == "rsa"
        for (code in [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256, TLS12_ECDHE_ECDSA_AES_256_GCM_SHA384, TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256,
            TLS12_ECDHE_RSA_AES_128_GCM_SHA256, TLS12_ECDHE_RSA_AES_256_GCM_SHA384, TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256]) {
            val suite12 = tls12Suite(code) ?? return 1
            if (suite12.ecdsa == rsaKey) continue
            for (groups in [[TLS_GROUP_X25519], [TLS_GROUP_SECP256R1]]) {
                val name = "TLS 1.2 $kind suite $code groups ${groups[0]}"
                // A default client, a TLS 1.2-only server.
                var oldServerConfig = TlsServerConfig(identity12, [], groups, [], random, false, false, acceptAny, [code])
                var newClient = clientFor(store12, "localhost")
                var oldServer = tlsServerNew(oldServerConfig)
                pump(newClient, oldServer)
                if (!newClient.connected() || !oldServer.connected() || !newClient.v12 || !oldServer.v12 || newClient.suite != code) {
                    fail("$name (old server): [${newClient.error}] [${oldServer.error}] v12 ${newClient.v12} suite ${newClient.suite}")
                    continue
                }
                val data = random(40000)
                newClient.send(data)
                oldServer.send("reply")
                pump(newClient, oldServer)
                if (oldServer.takeApplicationData() != data || newClient.takeApplicationData() != "reply") fail("$name: data")
                newClient.close()
                pump(newClient, oldServer)
                if (!oldServer.closed()) fail("$name: close_notify")
                // A TLS 1.2-only client, a default server.
                var oldClientConfig = TlsClientConfig("localhost", [], [TLS_SIG_ECDSA_SECP256R1_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA256,
                    TLS_SIG_ED25519, TLS_SIG_RSA_PKCS1_SHA256], [], tlsX509Verifier(store12, now), random, tlsPatchClientHello, [code])
                var newServerConfig = TlsServerConfig(identity12, [TLS_SUITE_AES_128_GCM_SHA256], groups, [], random, false, false, acceptAny)
                var oldClient = tlsClientNew(oldClientConfig)
                var newServer = tlsServerNew(newServerConfig)
                pump(oldClient, newServer)
                if (!oldClient.connected() || !newServer.connected() || !newServer.v12) {
                    fail("$name (old client): [${oldClient.error}] [${newServer.error}]")
                    continue
                }
                if (newServer.serverRandom.slice(24, 32) != "DOWNGRD" + tlsU8(1)) fail("$name: no downgrade sentinel")
                oldClient.send("from the old client")
                pump(oldClient, newServer)
                if (newServer.takeApplicationData() != "from the old client") fail("$name: old client data")
            }
        }
    }
    // The downgrade protection: a TLS 1.3 client given a TLS 1.2 ServerHello with the sentinel refuses it.
    val dgClientConfig = TlsClientConfig("localhost", [], [TLS_SIG_ED25519], [], tlsX509Verifier(edStore, now), random,
        tlsPatchClientHello, [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256])
    var dgOldClient = tlsClientNew(dgClientConfig)
    var dgServer = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random, false, false, acceptAny))
    dgServer.feed(dgOldClient.takeOutput())
    val dgFlight = dgServer.takeOutput()
    var dgNewClient = clientFor(edStore, "localhost")
    dgNewClient.takeOutput()
    dgNewClient.feed(dgFlight)
    if (!dgNewClient.failed() || !dgNewClient.error.contains("downgrade")) fail("a downgrade was not detected: [${dgNewClient.error}]")
    // A ClientHello that declares more than 2^17 bytes is refused at its header; twenty thousand one-byte records of
    // handshake data (no quadratic copying) end in the refusal of the whole message too.
    var bigServer = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random, false, false, acceptAny))
    bigServer.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, cryptoByteString([TLS_CLIENT_HELLO, 16, 0, 0])))
    if (!bigServer.failed()) fail("an oversized ClientHello header was accepted")
    var dripServer = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random, false, false, acceptAny))
    dripServer.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, cryptoByteString([TLS_CLIENT_HELLO, 0, 78, 32])))
    var dripped = 0
    while (dripped < 20000 && !dripServer.failed()) {
        dripServer.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, cryptoByteString([0])))
        dripped = dripped + 1
    }
    if (!dripServer.failed() || dripped != 20000) fail("a ClientHello of 20 000 zero bytes in one-byte records: failed ${dripServer.failed()} after $dripped")
    // A TLS 1.2 client hello without the extended master secret is refused by the server.
    val noEms = tlsHandshakeMessage(TLS_CLIENT_HELLO, tlsU16(771) + random(32) + tlsVec8("") +
        tlsVec16(tlsU16(TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256) + tlsU16(255)) + tlsVec8(tlsU8(0)) +
        tlsVec16(tlsExtension(TLS_EXT_SUPPORTED_GROUPS, tlsVec16(tlsU16(TLS_GROUP_X25519))) +
        tlsExtension(TLS_EXT_SIGNATURE_ALGORITHMS, tlsVec16(tlsU16(TLS_SIG_ED25519)))))
    var emsServer = tlsServerNew(TlsServerConfig(ed, [], [TLS_GROUP_X25519], [], random, false, false, acceptAny, [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256]))
    emsServer.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, noEms))
    if (!emsServer.failed() || !emsServer.error.contains("extended master secret")) fail("a client without the extended master secret was accepted: [${emsServer.error}]")
    // TLS 1.2 with client certificates, RSA and P-256 client keys.
    for (clientKind in ["p256", "rsa"]) {
        val clientIdentity12 = tlsIdentityFromPem(read("$directory/client-$clientKind.pem"), read("$directory/client-$clientKind.key"))
        val clientStore12 = trusting("$directory/client-$clientKind.pem")
        val serverConfig12 = TlsServerConfig(ed, [], [TLS_GROUP_X25519], [], random, true, true, trustClient(clientStore12),
            [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256])
        var authClient12 = clientFor(edStore, "localhost")
        authClient12.useIdentity(clientIdentity12)
        var authServer12 = tlsServerNew(serverConfig12)
        pump(authClient12, authServer12)
        if (!authClient12.connected() || !authServer12.connected() || !authServer12.clientCertificateVerified()) {
            fail("TLS 1.2 client certificate ($clientKind): [${authClient12.error}] [${authServer12.error}]")
        }
        var anon12 = clientFor(edStore, "localhost")
        var required12 = tlsServerNew(serverConfig12)
        pump(anon12, required12)
        if (!required12.failed()) fail("TLS 1.2: a required client certificate was not required")
    }

    // ALPN: the server's order wins; none in common is fatal; the client offering none is fine.
    var alpnConfig = TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], ["h2", "http/1.1"], random,
        false, false, acceptAny)
    var alpnClientConfig = TlsClientConfig("localhost", [TLS_SUITE_AES_128_GCM_SHA256],
        [TLS_SIG_ED25519], ["http/1.1", "h2"], tlsX509Verifier(edStore, now), random, tlsPatchClientHello)
    var alpnClient = tlsClientNew(alpnClientConfig)
    var alpnServer = tlsServerNew(alpnConfig)
    pump(alpnClient, alpnServer)
    if (!alpnClient.connected() || alpnClient.alpn() != "h2" || alpnServer.alpn() != "h2") {
        fail("ALPN: [${alpnClient.alpn()}] [${alpnServer.alpn()}] ${alpnClient.error} ${alpnServer.error}")
    }
    if (alpnServer.serverNameIndication() != "localhost") fail("server name [${alpnServer.serverNameIndication()}]")
    var noAlpnClient = tlsClientNew(TlsClientConfig("localhost", [TLS_SUITE_AES_128_GCM_SHA256], [TLS_SIG_ED25519],
        ["spdy"], tlsX509Verifier(edStore, now), random, tlsPatchClientHello))
    var noAlpnServer = tlsServerNew(alpnConfig)
    pump(noAlpnClient, noAlpnServer)
    if (!noAlpnServer.failed() || !noAlpnClient.failed()) fail("no ALPN in common did not fail")

    // Client certificates.
    val clientIdentity = tlsIdentityFromPem(read("$directory/client-p256.pem"), read("$directory/client-p256.key"))
    val clientStore = trusting("$directory/client-p256.pem")
    val baseConfig = TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random, true, true,
        trustClient(clientStore))
    var authClient = clientFor(edStore, "localhost")
    authClient.useIdentity(clientIdentity)
    var authServer = tlsServerNew(baseConfig)
    pump(authClient, authServer)
    if (!authClient.connected() || !authServer.connected() || !authServer.clientCertificateVerified()) {
        fail("a trusted client certificate: [${authClient.error}] [${authServer.error}]")
    }
    var anonClient = clientFor(edStore, "localhost")
    var requiredServer = tlsServerNew(baseConfig)
    pump(anonClient, requiredServer)
    if (!requiredServer.failed()) fail("a required client certificate was not required")
    val optionalConfig = TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random, true, false,
        trustClient(clientStore))
    var optionalClient = clientFor(edStore, "localhost")
    var optionalServer = tlsServerNew(optionalConfig)
    pump(optionalClient, optionalServer)
    if (!optionalServer.connected() || optionalServer.clientCertificateVerified() || !optionalClient.connected()) {
        fail("an optional client certificate: [${optionalServer.error}]")
    }
    val strangerStore = trusting("$directory/client-rsa.pem")
    var strictServer = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random,
        true, true, trustClient(strangerStore)))
    var strictClient = clientFor(edStore, "localhost")
    strictClient.useIdentity(clientIdentity)
    pump(strictClient, strictServer)
    if (!strictServer.failed()) fail("a client certificate the server does not trust was accepted")

    // KeyUpdate from the client side: send one by hand (the machine itself only answers); both sides keep working.
    var kuClient = clientFor(edStore, "localhost")
    var kuServer = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random,
        false, false, acceptAny))
    pump(kuClient, kuServer)
    kuServer.feed("")
    // The server asks the client to update: a KeyUpdate(update_requested) record under the server's keys.
    val update = tlsProtectRecord(kuServer.write, TLS_HANDSHAKE, tlsHandshakeMessage(TLS_KEY_UPDATE, tlsU8(1)))
    kuServer.serverApplicationSecret = tlsNextTrafficSecretFor(kuServer)
    kuServer.write = tlsRecordProtection(kuServer.aead, tlsTrafficKey(kuServer.hash, kuServer.serverApplicationSecret, kuServer.keyLength),
        tlsTrafficIv(kuServer.hash, kuServer.serverApplicationSecret))
    kuClient.feed(update.bytes)
    pump(kuClient, kuServer)
    if (kuClient.failed() || kuServer.failed()) fail("KeyUpdate: [${kuClient.error}] [${kuServer.error}]")
    kuClient.send("after the update")
    pump(kuClient, kuServer)
    if (kuServer.takeApplicationData() != "after the update") fail("data after a KeyUpdate")

    // Refusals by the server: a ClientHello without TLS 1.3, no common suite, a garbled hello.
    val plainHello = tlsBuildClientHello(random(32), "", [TLS_SUITE_AES_128_GCM_SHA256], "localhost", [TLS_GROUP_X25519],
        [TlsKeyShare(TLS_GROUP_X25519, random(32))], [TLS_SIG_ED25519], [], "")
    var tooOld = tlsServerNew(baseConfig)
    tooOld.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, tlsHandshakeMessage(TLS_CLIENT_HELLO, "garbage")))
    if (!tooOld.failed()) fail("a garbled ClientHello was accepted")
    // A well-formed ClientHello that does not offer TLS 1.3 (no supported_versions): protocol_version.
    val noVersions = tlsHandshakeMessage(TLS_CLIENT_HELLO, tlsU16(771) + random(32) + tlsVec8("") +
        tlsVec16(tlsU16(TLS_SUITE_AES_128_GCM_SHA256)) + tlsVec8(tlsU8(0)) + tlsVec16(""))
    var tls12Only = tlsServerNew(baseConfig)
    tls12Only.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, noVersions))
    if (!tls12Only.failed() || tls12Only.takeOutput().size == 0) fail("a hello without TLS 1.3 did not fail with an alert")
    var noSuite = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_CHACHA20_POLY1305_SHA256], [TLS_GROUP_X25519], [], random,
        false, false, acceptAny))
    var noSuiteClient = tlsClientNew(TlsClientConfig("localhost", [TLS_SUITE_AES_128_GCM_SHA256], [TLS_SIG_ED25519], [],
        tlsX509Verifier(edStore, now), random, tlsPatchClientHello))
    pump(noSuiteClient, noSuite)
    if (!noSuite.failed() || !noSuiteClient.failed()) fail("no common cipher suite did not fail")
    var noGroup = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_SECP384R1], [], random,
        false, false, acceptAny))
    var noGroupClient = clientFor(edStore, "localhost")
    pump(noGroupClient, noGroup)
    if (!noGroup.failed()) fail("no common group did not fail")
    var noScheme = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random,
        false, false, acceptAny))
    var noSchemeClient = tlsClientNew(TlsClientConfig("localhost", [TLS_SUITE_AES_128_GCM_SHA256],
        [TLS_SIG_RSA_PSS_RSAE_SHA256], [], tlsX509Verifier(edStore, now), random, tlsPatchClientHello))
    pump(noSchemeClient, noScheme)
    if (!noScheme.failed()) fail("no common signature scheme did not fail")

    // Damaged input to a server mid-handshake never crashes it and never connects it.
    for (round in 0 until 300) {
        var fuzzClient = clientFor(edStore, "localhost")
        var fuzzServer = tlsServerNew(baseConfig)
        val hello = fuzzClient.takeOutput()
        val bytes: array<int> = []
        val at = hello.size - 1 - (round % hello.size)
        for (i in 0 until hello.size) bytes.append(if (i == at) hello[i] ^ (1 << (round % 8)) else hello[i])
        fuzzServer.feed(cryptoByteString(bytes))
        pump(fuzzClient, fuzzServer)
        if (fuzzServer.connected() && !fuzzServer.failed() && !fuzzClient.connected()) fail("a damaged hello connected only the server")
    }


    // ---- #823: the remainder of the review ----
    // TlsServer.suite is the TLS 1.2 suite after a TLS 1.2 handshake too (checked above for every suite; once here).
    if (true) {
        var s12 = tlsServerNew(TlsServerConfig(ed, [], [TLS_GROUP_X25519], [], random, false, false, acceptAny,
            [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256]))
        var c12 = clientFor(edStore, "localhost")
        pump(c12, s12)
        if (!s12.connected() || s12.suite != TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256) fail("TlsServer.suite after TLS 1.2: ${s12.suite}")
    }
    // A close_notify before the handshake is done ends it at once, for a client and for a server.
    if (true) {
        var c = clientFor(edStore, "localhost")
        c.takeOutput()
        c.feed(tlsPlaintextRecord(TLS_ALERT, 771, cryptoByteString([1, 0])))
        if (!c.failed()) fail("a client went on after a close_notify in the handshake")
        var s = tlsServerNew(baseConfig)
        var c2 = clientFor(edStore, "localhost")
        s.feed(c2.takeOutput())
        s.feed(tlsPlaintextRecord(TLS_ALERT, 771, cryptoByteString([1, 0])))
        if (!s.failed()) fail("a server went on after a close_notify in the handshake")
    }
    // A client certificate flight over 2^14 bytes is split over records: 64 copies of the certificate, TLS 1.3 and 1.2.
    if (true) {
        val chain: array<string> = []
        for (i in 0 until 64) chain.append(ed.chain[0])
        val long = TlsIdentity(chain, ed.schemes, ed.sign)
        for (version12 in [false, true]) {
            val serverConfig = TlsServerConfig(ed, if (version12) [] else [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random,
                true, true, acceptAny, [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256])
            var s = tlsServerNew(serverConfig)
            var c = clientFor(edStore, "localhost")
            c.useIdentity(long)
            pump(c, s)
            if (!c.connected() || !s.connected() || !s.clientAuthenticated) {
                fail("a long client certificate (TLS 1.2 $version12): client [${c.error}] server [${s.error}]")
            }
        }
    }
    // The sending key is replaced after 2^24 records (AES-GCM, RFC 8446 section 5.5): the data goes on, under a new key.
    if (true) {
        var s = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random, false, false, acceptAny))
        var c = clientFor(edStore, "localhost")
        pump(c, s)
        c.write.sequence = 16777215
        s.read.sequence = 16777215
        c.send("a")
        c.send("b")
        pump(c, s)
        if (s.failed() || c.failed() || s.takeApplicationData() != "ab") fail("data across the automatic KeyUpdate: [${s.error}] [${c.error}]")
        if (c.write.sequence > 4) fail("the client did not update its key: sequence ${c.write.sequence}")
        // And a sequence number past 2^62 seals nothing.
        var exhausted = tlsRecordProtection(TLS_AEAD_AES_128_GCM, random(16), random(12))
        exhausted.sequence = TLS_MAX_SEQUENCE
        if (tlsProtectRecord(exhausted, TLS_APPLICATION_DATA, "x").ok) fail("a record was sealed with an exhausted sequence number")
    }
    // TLS_FALLBACK_SCSV with a version below the server's best is inappropriate_fallback.
    if (true) {
        val groups = [TLS_GROUP_X25519]
        val pair = tlsGenerateKeyPair(TLS_GROUP_X25519, random)
        val shares: array<TlsKeyShare> = []
        if (pair != null) shares.append(TlsKeyShare(pair.group, pair.publicKey))
        val hello = tlsBuildClientHello(random(32), random(32), [], "localhost", groups, shares, [TLS_SIG_ED25519], [], "",
            [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256, 22016])
        var s = tlsServerNew(baseConfig)
        s.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 769, hello))
        if (!s.failed()) fail("a TLS 1.2 ClientHello with the fallback SCSV was served by a TLS 1.3 server")
        // Without the SCSV the same hello is served (TLS 1.2).
        val plain = tlsBuildClientHello(random(32), random(32), [], "localhost", groups, shares, [TLS_SIG_ED25519], [], "",
            [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256])
        var s2 = tlsServerNew(baseConfig)
        s2.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 769, plain))
        if (s2.failed() && s2.error.contains("fallback")) fail("a TLS 1.2 ClientHello without the SCSV was refused as a fallback")
    }
    // Names: a server name with a NUL byte or a '/' (and a protocol list with an empty name) cannot be offered; a server
    // refuses a ClientHello that carries one.
    if (true) {
        for (bad in ["a/b", "a b", "a,b"]) {
            var c = clientFor(edStore, bad)
            if (!c.failed()) fail("a client was started with the host name [$bad]")
        }
        val alpnConfig2 = TlsClientConfig("localhost", [TLS_SUITE_AES_128_GCM_SHA256], [TLS_SIG_ED25519], [""], tlsX509Verifier(edStore, now),
            random, tlsPatchClientHello)
        if (!tlsClientNew(alpnConfig2).failed()) fail("a client was started with an empty ALPN protocol name")
        val pair = tlsGenerateKeyPair(TLS_GROUP_X25519, random)
        val shares: array<TlsKeyShare> = []
        if (pair != null) shares.append(TlsKeyShare(pair.group, pair.publicKey))
        val nul = tlsBuildClientHello(random(32), random(32), [TLS_SUITE_AES_128_GCM_SHA256], "bad\x00name", [TLS_GROUP_X25519], shares,
            [TLS_SIG_ED25519], [], "")
        var s = tlsServerNew(baseConfig)
        s.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 769, nul))
        if (!s.failed()) fail("a server accepted a server name with a NUL byte")
    }
    // The scheme of a client's CertificateVerify must be one the CertificateRequest listed: PKCS#1 v1.5 is not (TLS 1.3).
    // An honest client never signs with another, so the client's second flight is replaced by a hand-built one whose
    // CertificateVerify names the scheme (protected with the client's handshake keys, which are the server's read keys).
    if (true) {
        for (scheme in [TLS_SIG_RSA_PKCS1_SHA256, 513, TLS_SIG_ED25519]) {
            val config = TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], random, true, true, trustClient(edStore))
            var s = tlsServerNew(config)
            var c = clientFor(edStore, "localhost")
            c.useIdentity(ed)
            s.feed(c.takeOutput())
            c.feed(s.takeOutput())
            c.takeOutput()
            // The client's handshake write keys, from sequence 0: made from the server's copy of the client handshake traffic
            // secret (the client has moved on to its application keys, and cleared its own).
            val handshakeWrite = tlsRecordProtection(s.aead, tlsTrafficKey(s.hash, s.clientHandshakeSecret, s.keyLength),
                tlsTrafficIv(s.hash, s.clientHandshakeSecret))
            val flight = tlsBuildCertificate("", ed.chain) + tlsHandshakeMessage(TLS_CERTIFICATE_VERIFY, tlsU16(scheme) + tlsVec16("not a signature"))
            val record = tlsProtectRecord(handshakeWrite, TLS_HANDSHAKE, flight)
            if (!record.ok) {
                fail("the hand-built client flight: ${record.error}")
                continue
            }
            s.feed(record.bytes)
            val unlisted = scheme != TLS_SIG_ED25519
            if (!s.failed()) fail("scheme $scheme: the server accepted a CertificateVerify with a made-up signature")
            else if (unlisted != s.error.contains("not requested")) fail("scheme $scheme: refused for the wrong reason: [${s.error}]")
        }
    }
    // A random source that fails is an error, not a hello with short randoms.
    if (true) {
        val broken = tlsClientNew(tlsClientConfig("localhost", tlsX509Verifier(edStore, now), failingRandom))
        if (!broken.failed() || !broken.error.contains("random")) fail("a client started with a failing random source: [${broken.error}]")
        var s = tlsServerNew(TlsServerConfig(ed, [TLS_SUITE_AES_128_GCM_SHA256], [TLS_GROUP_X25519], [], failingRandom, false, false, acceptAny))
        var c = clientFor(edStore, "localhost")
        pump(c, s)
        if (!s.failed()) fail("a server went on with a failing random source")
    }
    if (failures > 0) return 1
    println("tls-pure server ok")
    0
}

fun tlsNextTrafficSecretFor(server: TlsServer): string =
    tlsNextTrafficSecret(server.hash, server.serverApplicationSecret)
