// abla/tls/pure against a live TLS 1.3 server (tools/test-tls-pure-interop.sh starts `openssl s_server` for each
// certificate type, cipher suite and group): the port is the first argument, the server's self-signed certificate
// (PEM, the trust anchor) the second, then the expected cipher-suite code and another certificate (PEM) that does not match. The whole handshake with the real
// certificate check (abla/crypto/x509 on that store, the CertificateVerify under the certificate's key), a request
// and its response, close_notify; then connections with the wrong host name and with an unrelated trust anchor, both refused.
// Prints "tls-pure interop ok (N bytes)".
import "abla/io"
import "abla/crypto"
import "abla/process/arguments"
import "abla/process/time"
import "abla/sys/linux"
import "abla/tls/pure/client"
import "abla/tls/pure/connection"
import "abla/tls/pure/verify"
import "abla/crypto/x509"

var failures = 0

fun fail(what: string): void {
    failures = failures + 1
    println("FAIL $what")
    return
}

fun decimal(text: string): int {
    var value = 0
    for (i in 0 until text.size) value = value * 10 + (text[i] - 48)
    value
}

fun now(): int = realtimeMilliseconds() / 1000

fun main: int {
    val port = decimal(processArgument(0))
    val store = x509TrustStoreFromPem(linuxReadFile(processArgument(1), 1048576))
    if (store.certificates.size != 1) {
        println("FAIL the trust store has ${store.certificates.size} certificates")
        return 1
    }
    val expectedSuite = decimal(processArgument(2))
    var config = tlsClientConfig("localhost", tlsX509Verifier(store, now), tlsPureRandom)
    // A fifth argument "pkcs1" offers only RSA PKCS#1 v1.5 signature schemes (a TLS 1.2 server then signs with those).
    if (processArgumentCount() > 4 && processArgument(4) == "pkcs1") {
        config = TlsClientConfig("localhost", config.suites, [TLS_SIG_RSA_PKCS1_SHA256, TLS_SIG_RSA_PKCS1_SHA384],
            [], tlsX509Verifier(store, now), tlsPureRandom, tlsPatchClientHello)
    }
    var connection = tlsPureConnect(config, port, 5000, 5000)
    if (!connection.ok()) {
        println("FAIL connect: ${connection.lastError}")
        return 1
    }
    if (connection.suite() != expectedSuite) fail("suite ${connection.suite()}, expected $expectedSuite")
    if (connection.write("GET / HTTP/1.0\r\n\r\n") < 0) fail("write: ${connection.lastError}")
    var response = ""
    var chunk = connection.read(4096)
    while (chunk.size > 0) {
        response = response + chunk
        chunk = connection.read(4096)
    }
    if (connection.lastError != "") fail("read: ${connection.lastError}")
    if (response.size == 0) fail("no response")
    connection.close()
    // The wrong host name: the certificate is for localhost only.
    val wrong = tlsClientConfig("example.invalid", tlsX509Verifier(store, now), tlsPureRandom)
    var refused = tlsPureConnect(TlsClientConfig("localhost", wrong.suites, wrong.signatureAlgorithms, [],
        { chain: array<string>, host: string, scheme: int, content: string, signature: string ->
            tlsVerifyServerCertificate(chain, "example.invalid", scheme, content, signature, store, now()) },
        tlsPureRandom, wrong.secondHello), port, 5000, 5000)
    if (refused.ok()) fail("a certificate for another host name was accepted")
    refused.close()
    // Another certificate as the only trust anchor: the chain is not trusted.
    val other = x509TrustStoreFromPem(linuxReadFile(processArgument(3), 1048576))
    var untrusted = tlsPureConnect(tlsClientConfig("localhost", tlsX509Verifier(other, now), tlsPureRandom), port, 5000, 5000)
    if (untrusted.ok()) fail("a certificate not in the trust store was accepted")
    untrusted.close()
    // A clock after the certificate's end: certificate_expired.
    var expired = tlsPureConnect(tlsClientConfig("localhost", tlsX509Verifier(store, { now() + 3153600000 }), tlsPureRandom), port, 5000, 5000)
    if (expired.ok()) fail("an expired certificate was accepted")
    expired.close()
    if (failures > 0) return 1
    println("tls-pure interop ok (${response.size} bytes)")
    0
}
