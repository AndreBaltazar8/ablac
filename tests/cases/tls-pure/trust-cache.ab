// The system trust store is parsed once per process (#820), whichever thread asks first, and the same certificates come
// back to every thread. With the environment's CA variables unset (tools/test-tls-trust-cache.sh), the store is the
// system bundle: parsing it takes several milliseconds, so many calls are fast only from the second on. Prints the
// certificate count and "trust cache ok".
import "abla/io"
import "abla/process/time"
import "abla/tls/pure"

fun certificates(): int = tlsSystemTrustStore().certificates.size

fun repeat(times: int): int {
    var total = 0
    for (i in 0 until times) total = total + certificates()
    total
}

fun main: int {
    val count = certificates()
    if (count == 0) {
        println("no system bundle: nothing to cache")
        return 0
    }
    val started = realtimeMilliseconds()
    val total = repeat(100)
    val elapsed = realtimeMilliseconds() - started
    if (total != count * 100) {
        println("FAIL: the repeated calls disagree: $total != ${count * 100}")
        return 1
    }
    if (elapsed > 300) {
        println("FAIL: 100 calls took $elapsed ms: the store is parsed again each time")
        return 1
    }
    val a = thread { repeat(20) }
    val b = thread { repeat(20) }
    val c = thread { repeat(20) }
    val here = repeat(20)
    val sum = here + (await a) + (await b) + (await c)
    if (sum != count * 80) {
        println("FAIL: the threads disagree: $sum != ${count * 80}")
        return 1
    }
    println("$count certificates, 100 calls in $elapsed ms")
    println("trust cache ok")
    0
}
