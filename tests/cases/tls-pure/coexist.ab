// A program that imports abla/tls/hosted (OpenSSL, with its handles and internals: NovaKind's abla-s3, abla-postgres and
// the gateway do) together with abla/http, whose HTTPS client is the pure TLS imported under an alias, still compiles and
// runs: the two modules' public names (TlsConnection, tlsConnect, TlsClientIdentity ...) must not collide. The shapes are
// abla-s3's: a connection upgraded by hosted, its handle taken and rebuilt as a view, closed by handle; then an HTTPS
// request by the pure client in the same program. Prints "tls-pure coexist ok".
import "abla/io"
import "abla/http"
import "abla/http/tls"
import "abla/net"
import "abla/sys/linux"
import "abla/tls/hosted"

fun hostedWire(var connection: TcpConnection, host: string): int {
    var secured = tlsUpgrade(connection, host)
    val handle = secured.handle
    secured.handle = -1
    handle
}

fun main: int {
    if (!tlsAvailable()) println("(no OpenSSL here)")
    // abla-s3's shapes on hosted's names: a handle rebuilt as a view, its control block, the close by handle.
    var tcp = tcpConnectHost("127.0.0.1", 1, 200)
    var refused = hostedWire(tcp, "localhost")
    var view = TlsConnection(refused)
    view.handle = -1
    if (refused >= 0) {
        // (Not reached: nothing listens on port 1. The calls are the shapes of abla-s3, abla-postgres and the gateway.)
        println("FAIL: hosted upgraded a closed connection: $refused, descriptor ${tlsControlInt(refused, 16)}")
        tlsCloseHandle(refused)
        return 1
    }
    // The pure HTTPS client of abla/http/tls in the same program.
    val result = httpsClient("localhost", 1, 4096, 200, 400).send(httpGet("/"))
    if (result.succeeded) {
        println("FAIL: unexpected success")
        return 1
    }
    println("tls-pure coexist ok")
    0
}
