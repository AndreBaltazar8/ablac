// The trust a connection without a CA file uses comes from NIX_SSL_CERT_FILE, SSL_CERT_FILE and SSL_CERT_DIR (in that
// order) when one is set, and then it is the whole trust: a missing or empty file, an empty directory, or the variable
// set to nothing gives a store that trusts nothing, never the system bundle (#825). tools/test-tls-trust-env.sh runs this
// under each setting:
//   trust-env count          prints the number of certificates the trust store holds
//   trust-env connect PORT   tlsConnect to localhost:PORT with that trust; prints "connected" or "refused: <why>"
import "abla/integer"
import "abla/io"
import "abla/process/arguments"
import "abla/tls/pure"

fun main: int {
    val mode = processArgument(0)
    if (mode == "count") {
        println("${tlsSystemTrustStore().certificates.size}")
        return 0
    }
    if (mode == "connect") {
        val port = processArgument(1).parseInt() ?? 0
        val connection = tlsConnect("localhost", port, 5000, 5000)
        if (connection.handle == -1) println("refused: ${tlsLastError()}: ${connection.detail()}")
        else {
            println("connected")
            connection.close()
        }
        return 0
    }
    println("usage: trust-env count | connect PORT")
    2
}
