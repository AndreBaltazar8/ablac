// Channel bindings against `openssl s_server -keymatexport EXPORTER-Channel-Binding -keymatexportlen 32` (tools/test-tls-pure-interop.sh):
// prints "binding <tls-exporter hex> <tls-server-end-point hex>" for one TLS 1.3 connection; the script compares both with OpenSSL's.
// Usage: binding-interop <port> <ca file>
import "abla/io"
import "abla/crypto"
import "abla/process/arguments"
import "abla/tls/pure"
import "abla/tls/pure/binding"

fun decimal(text: string): int {
    var value = 0
    for (i in 0 until text.size) value = value * 10 + (text[i] - 48)
    value
}

fun main: int {
    val connection = tlsConnectWithCa("localhost", processArgument(1), decimal(processArgument(0)), 5000, 5000)
    if (connection.handle == -1) {
        println("FAIL connect: ${tlsLastError()}")
        return 1
    }
    // No request: a plain s_server (the only mode that prints the exported keying material) answers nothing.
    println("binding ${hexEncode(connection.channelBinding(TLS_BINDING_EXPORTER))} ${hexEncode(connection.channelBinding(TLS_BINDING_END_POINT))}")
    connection.close()
    0
}
