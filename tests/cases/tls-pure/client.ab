// The abla/tls/pure client state machine against RFC 8448 section 3: the trace's own ClientHello is the
// client's first flight, the server's records (ServerHello; the encrypted EncryptedExtensions, Certificate,
// CertificateVerify and Finished; the NewSessionTicket; application data; the close_notify) are fed in, and
// every byte the client queues back must be the RFC's (its ClientHello record, its Finished record, its
// application data and its close_notify). The certificate check is a callback: here it records what it was
// given (the chain, the scheme, the signed content, the signature) and accepts. Then the same trace is fed
// one byte at a time, and the refusals: a flipped bit in the server flight, records in the wrong order, a
// verifier that rejects, a server that answers with an unsupported version. Prints "tls-pure client ok";
// tools/test-tls-pure.sh runs it. Vectors: tests/vectors/tls/rfc8448-section3.txt (the first argument).
import "abla/io"
import "abla/crypto"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/text"
import "abla/tls/pure/client"
import "abla/tls/pure/handshake"
import "abla/tls/pure/keysched"
import "abla/tls/pure/record"

var failures = 0
var lines: array<string> = []
var verifierCalls = 0
var verifierChain: array<string> = []
var verifierHost = ""
var verifierScheme = 0
var verifierContent = ""
var verifierSignature = ""
var verifierAnswer = tlsAccepted()

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL $what")
    return
}

fun check(name: string, actual: string, expected: string): void {
    if (hexEncode(actual) != expected) fail("$name: ${hexEncode(actual)} != $expected")
    return
}

fun vector(heading: string, name: string, occurrence: int = 1): string {
    var seen = 0
    for (line in lines) {
        val parts = line.split("|")
        if (parts.size == 3 && parts[0] == heading && parts[1] == name) {
            seen = seen + 1
            if (seen == occurrence) return parts[2]
        }
    }
    fail("no vector $heading / $name #$occurrence")
    ""
}

fun raw(heading: string, name: string, occurrence: int = 1): string = hexDecode(vector(heading, name, occurrence))

fun verifier(chain: array<string>, host: string, scheme: int, content: string, signature: string): TlsVerdict {
    verifierCalls = verifierCalls + 1
    verifierChain = chain
    verifierHost = host
    verifierScheme = scheme
    verifierContent = content
    verifierSignature = signature
    verifierAnswer
}

fun noRandom(count: int): string = ""

fun newClient(): TlsClient {
    val hello = raw("{client}  construct a ClientHello handshake message", "ClientHello")
    val sessionLength = hello[38]
    val config =TlsClientConfig("server", [TLS_SUITE_AES_128_GCM_SHA256, TLS_SUITE_CHACHA20_POLY1305_SHA256,
        TLS_SUITE_AES_256_GCM_SHA384],
        [TLS_SIG_ECDSA_SECP256R1_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA384,
         TLS_SIG_RSA_PSS_RSAE_SHA512, TLS_SIG_ED25519, TLS_SIG_ECDSA_SECP384R1_SHA384],
        [], verifier, noRandom, tlsPatchClientHello)
    tlsClientStartWith(config, hello, hello.slice(6, 38), hello.slice(39, 39 + sessionLength),
        [TlsKeyPair(TLS_GROUP_X25519, raw("{client}  create an ephemeral x25519 key pair", "public key"),
            raw("{client}  create an ephemeral x25519 key pair", "private key"))], 769)
}

fun serverHello(): string = raw("{server}  send handshake record", "complete record", 1)
fun serverFlight(): string = raw("{server}  send handshake record", "complete record", 2)
fun ticket(): string = raw("{server}  send handshake record", "complete record", 3)
fun serverData(): string = raw("{server}  send application_data record", "complete record")
fun serverAlert(): string = raw("{server}  send alert record", "complete record")

fun flip(text: string, index: int): string {
    val bytes: array<int> = []
    for (i in 0 until text.size) bytes.append(if (i == index) text[i] ^ 1 else text[i])
    cryptoByteString(bytes)
}

fun main: int {
    lines = linuxReadFile("${processArgument(0)}/rfc8448-section3.txt", 4194304).split("\n")

    // The whole trace, record by record.
    var client = newClient()
    check("ClientHello record", client.takeOutput(), vector("{client}  send handshake record", "complete record", 1))
    client.feed(serverHello())
    if (client.failed()) fail("ServerHello: ${client.error}")
    check("no output after the ServerHello", client.takeOutput(), "")
    client.feed(serverFlight())
    if (client.failed()) fail("server flight: ${client.error}")
    if (!client.connected()) fail("not connected after the server's Finished")
    check("client Finished record", client.takeOutput(), vector("{client}  send handshake record", "complete record", 2))
    if (verifierCalls != 1) fail("the verifier ran $verifierCalls times")
    if (verifierHost != "server") fail("verifier host $verifierHost")
    if (verifierScheme != TLS_SIG_RSA_PSS_RSAE_SHA256) fail("verifier scheme $verifierScheme")
    if (verifierChain.size != 1) fail("verifier chain size ${verifierChain.size}")
    else {
        val certificate = raw("{server}  construct a Certificate handshake message", "Certificate")
        // The message is type, length, context (empty), list length, then each certificate with its extensions.
        if (verifierChain[0] != certificate.slice(11, 11 + 432)) fail("the verifier's certificate is not the trace's")
    }
    // The signed content: 64 spaces, the context string, 0, and the hash through the Certificate message.
    val signed = verifierContent
    if (signed.size != 64 + 33 + 1 + 32) fail("signed content size ${signed.size}")
    check("signed content prefix", signed.slice(0, 98), hexEncode(tlsCertificateVerifyContent(true, "").slice(0, 98)))
    check("CertificateVerify signature", verifierSignature,
        vector("{server}  construct a CertificateVerify handshake message", "CertificateVerify").slice(16, 16 + 256))
    client.feed(ticket())
    if (client.failed() || !client.connected()) fail("NewSessionTicket: ${client.error}")
    if (!client.send(raw("{client}  send application_data record", "payload"))) fail("send refused")
    check("client application data record", client.takeOutput(),
        vector("{client}  send application_data record", "complete record"))
    client.feed(serverData())
    check("application data received", client.takeApplicationData(),
        vector("{server}  send application_data record", "payload"))
    client.feed(serverAlert())
    if (!client.closed()) fail("close_notify did not close")
    check("client close_notify", client.takeOutput(), vector("{client}  send alert record", "complete record"))
    if (client.send("late")) fail("send after close accepted")

    // The same trace one byte at a time, and in two chunks.
    client = newClient()
    client.takeOutput()
    val everything = serverHello() + serverFlight() + ticket() + serverData()
    for (i in 0 until everything.size) client.feed(everything.slice(i, i + 1))
    if (client.failed() || !client.connected()) fail("byte at a time: ${client.error}")
    check("byte at a time: client Finished", client.takeOutput(),
        vector("{client}  send handshake record", "complete record", 2))
    check("byte at a time: application data", client.takeApplicationData(),
        vector("{server}  send application_data record", "payload"))

    // Refusals.
    client = newClient()
    client.takeOutput()
    client.feed(serverHello())
    client.feed(flip(serverFlight(), 100))
    if (!client.failed()) fail("a flipped bit in the server flight was accepted")
    if (client.connected()) fail("connected after a bad record")
    val alert = client.takeOutput()
    // After the ServerHello the alert is protected with the client handshake keys: an application_data record of 5 + 2 + 1 + 16 bytes.
    if (alert.size != 24 || alert[0] != TLS_APPLICATION_DATA) fail("the alert after a bad record is not a protected record (${alert.size} bytes)")

    client = newClient()
    client.takeOutput()
    client.feed(serverFlight())
    if (!client.failed()) fail("the server flight before the ServerHello was accepted")

    client = newClient()
    client.takeOutput()
    client.feed(serverHello())
    client.feed(serverHello())
    if (!client.failed()) fail("two ServerHellos were accepted")

    verifierAnswer = tlsRefused(TLS_VERDICT_UNKNOWN_CA, "tls: untrusted certificate")
    client = newClient()
    client.takeOutput()
    client.feed(serverHello())
    client.feed(serverFlight())
    if (!client.failed() || client.error != "tls: untrusted certificate") fail("a rejecting verifier: ${client.error}")
    verifierAnswer = tlsAccepted()

    // A ServerHello for TLS 1.2 (no supported_versions) is refused.
    client = newClient()
    client.takeOutput()
    val hello12 = tlsHandshakeMessage(TLS_SERVER_HELLO, tlsU16(771) + hexDecode(vector("{client}  construct a ClientHello handshake message",
        "ClientHello")).slice(6, 38) + tlsVec8("") + tlsU16(4865) + tlsU8(0) + tlsU16(0))
    client.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, hello12))
    if (!client.failed()) fail("a TLS 1.2 ServerHello was accepted")

    // An alert from the server ends the connection with its description.
    client = newClient()
    client.takeOutput()
    client.feed(tlsPlaintextRecord(TLS_ALERT, 771, tlsU8(2) + tlsU8(40)))
    if (!client.failed() || client.error != "tls: the server sent alert 40") fail("a fatal alert: ${client.error}")

    // A handshake message that declares more body than its type may have is refused at once, before the body arrives:
    // a ServerHello of 200 000 bytes, a Certificate of 70 000, a Finished of 20 000; also with the header split over
    // records of one byte; one declared at the limit is merely waited for.
    for (declared in [cryptoByteString([TLS_SERVER_HELLO, 3, 13, 64]), cryptoByteString([TLS_CERTIFICATE, 1, 17, 112]),
        cryptoByteString([TLS_FINISHED, 0, 78, 32])]) {
        client = newClient()
        client.takeOutput()
        client.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, declared))
        if (!client.failed()) fail("an oversized handshake message header was accepted (type ${declared[0]})")
        client = newClient()
        client.takeOutput()
        for (i in 0 until 4) client.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, declared.slice(i, i + 1)))
        if (!client.failed()) fail("an oversized header in one-byte records was accepted (type ${declared[0]})")
    }
    client = newClient()
    client.takeOutput()
    client.feed(tlsPlaintextRecord(TLS_HANDSHAKE, 771, cryptoByteString([TLS_SERVER_HELLO, 2, 0, 0])))
    if (client.failed()) fail("a ServerHello declared at its limit was refused")

    // Compatibility mode (section 7): a 32-byte session id; the server's ChangeCipherSpec after its
    // ServerHello is ignored, and the client sends its own before its Finished.
    lines = linuxReadFile("${processArgument(0)}/rfc8448-section7.txt", 4194304).split("\n")
    client = newClient()
    check("compat ClientHello record", client.takeOutput(), vector("{client}  send handshake record", "complete record", 1))
    client.feed(raw("{server}  send handshake record", "complete record", 1))
    client.feed(raw("{server}  send change_cipher_spec record", "complete record"))
    if (client.failed()) fail("compat ServerHello or ChangeCipherSpec: ${client.error}")
    client.feed(raw("{server}  send handshake record", "complete record", 2))
    if (client.failed() || !client.connected()) fail("compat flight: ${client.error}")
    check("compat second flight", client.takeOutput(),
        vector("{client}  send change_cipher_spec record", "complete record") +
        vector("{client}  send handshake record", "complete record", 2))
    client.feed(raw("{server}  send alert record", "complete record"))
    if (!client.closed()) fail("compat close_notify did not close")
    check("compat client close_notify", client.takeOutput(), vector("{client}  send alert record", "complete record"))
    // A ChangeCipherSpec right after the ClientHello (before any ServerHello) is dropped (RFC 8446 appendix D.4: allowed
    // once the ClientHello is sent); the handshake goes on. A bad one (not 0x01) is still refused.
    client = newClient()
    client.takeOutput()
    client.feed(tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(1)))
    if (client.failed()) fail("a ChangeCipherSpec before the ServerHello was refused")
    client = newClient()
    client.takeOutput()
    client.feed(tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(2)))
    if (!client.failed()) fail("a ChangeCipherSpec of 0x02 was accepted")

    if (failures > 0) {
        println("tls-pure client: $failures failures")
        return 1
    }
    println("tls-pure client ok")
    0
}
