// A TLS 1.3 server for the interop script (tools/test-tls-pure-interop.sh): abla/tls/pure listening on a free port,
// printing "listening PORT", and answering each connection with a short HTTP/1.0 response that echoes what the
// client's first request was and what was negotiated, until it is killed. Arguments: the mode, the certificate (PEM)
// and key (PEM), and for "auth" the PEM of the one client certificate it trusts.
//   plain  the hosted-style API: tlsListen on ::1, TlsListener.accept
//   alpn   a server configuration with ALPN [h2, http/1.1]
//   auth   a server configuration that requires a client certificate (trusting the given one)
// The response is "HTTP/1.0 200 ok", an empty line, then "pure server: <request line> suite=<n> alpn=<p> client=<ok>".
import "abla/io"
import "abla/crypto"
import "abla/crypto/x509"
import "abla/process/arguments"
import "abla/process/time"
import "abla/sys/linux"
import "abla/sys/linux/net"
import "abla/tls/pure"
import "abla/tls/pure/client"
import "abla/tls/pure/connection"
import "abla/tls/pure/identity"
import "abla/tls/pure/server"
import "abla/tls/pure/verify"

fun now(): int = realtimeMilliseconds() / 1000

fun requestLine(request: string): string {
    var end = 0
    while (end < request.size && request[end] != 13 && request[end] != 10) end = end + 1
    request.slice(0, end)
}

fun trustClient(store: X509TrustStore): (array<string>, int, string, string) -> string =
    { chain: array<string>, scheme: int, content: string, signature: string ->
        val verification = x509Verify(chain, store, X509Options("", now(), 8, 1))
        if (!verification.ok) "client certificate: ${verification.error}"
        else tlsVerifySignature(verification.path[0], scheme, content, signature)
    }

fun serve(var connection: TlsPureConnection): void {
    // The first request: whatever arrives until a blank line or the stream ends (a client may send nothing).
    var request = connection.read(4096)
    val line = requestLine(request)
    connection.write("HTTP/1.0 200 ok\r\n\r\npure server: $line suite=${connection.suite()} alpn=${connection.alpn()} client=${connection.clientCertificateVerified()}\n")
    connection.close()
    return
}

fun main: int {
    val mode = processArgument(0)
    val certificate = processArgument(1)
    val key = processArgument(2)
    if (mode == "plain") {
        val listener = tlsListen(certificate, key, "::1", 0, 16)
        if (listener.handle == -1) {
            println("FAIL listen: ${tlsLastError()}")
            return 1
        }
        println("listening ${listener.localPort()}")
        while (true) {
            val connection = listener.accept(5000, 5000)
            if (connection.handle != -1) {
                val request = connection.read(4096)
                connection.write("HTTP/1.0 200 ok\r\n\r\npure server: ${requestLine(request)}\n")
                connection.close()
            }
        }
        return 0
    }
    val identity = tlsIdentityFromPem(linuxReadFile(certificate, 1048576), linuxReadFile(key, 1048576))
    if (!identity.ok()) {
        println("FAIL identity: ${identity.error}")
        return 1
    }
    var config = tlsServerConfig(identity, tlsPureRandom)
    if (mode == "alpn") {
        config = TlsServerConfig(identity, config.suites, config.groups, ["h2", "http/1.1"], tlsPureRandom, false, false,
            tlsServerRefuseClients)
    } else if (mode == "auth") {
        val store = x509TrustStoreFromPem(linuxReadFile(processArgument(3), 1048576))
        config = TlsServerConfig(identity, config.suites, config.groups, [], tlsPureRandom, true, true, trustClient(store))
    }
    val listener = tcpListenIpv6(ipv6SocketAddress("::1", 0), 16, false)
    if (listener.descriptor < 0) {
        println("FAIL listen")
        return 1
    }
    println("listening ${listener.localPort()}")
    while (true) {
        var tcp = listener.accept()
        if (tcp.descriptor >= 0) {
            val connection = tlsPureServerUpgrade(tcp, config, 5000, 5000, 0)
            if (connection.ok()) serve(connection) else connection.close()
        }
    }
    0
}
