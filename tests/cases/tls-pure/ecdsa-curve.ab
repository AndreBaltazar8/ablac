// The curve of an ECDSA signature in TLS (#819, BoGo's ECDSACurveMismatch-Verify-TLS12): under TLS 1.2 the scheme names
// only the hash (RFC 5246 section 7.4.1.4.1) and the curve is the key's, so a P-384 key may sign under ecdsa_secp256r1_sha256
// and a P-256 key under ecdsa_secp384r1_sha384; under TLS 1.3 the scheme fixes the curve (RFC 8446 section 4.2.3), so the
// same pairs are refused. The TLS 1.2 call sites add TLS_SIGNATURE_TLS12 to the scheme; a scheme without it is checked by 1.3's rules.
// Files from tools/test-tls-ecdsa-curve.sh in the directory given as the argument. Prints "ecdsa curve ok".
import "abla/io"
import "abla/crypto/x509"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/tls/pure/handshake"
import "abla/tls/pure/verify"

var failures = 0

fun leaf(directory: string, name: string): X509Certificate =
    x509ParsePem(linuxReadFile("$directory/$name", 1048576)).certificates[0]

fun check(label: string, verdict: string, accepted: bool): void {
    if ((verdict == "") != accepted) {
        println("FAIL $label: [$verdict]")
        failures = failures + 1
    }
    return
}

fun main: int {
    val directory = processArgument(0)
    val p384 = leaf(directory, "p384.pem")
    val p256 = leaf(directory, "p256.pem")
    val tls12 = linuxReadFile("$directory/content12.bin", 65536)
    val tls13 = linuxReadFile("$directory/content13.bin", 65536)
    val sha256On384For12 = linuxReadFile("$directory/p384-sha256-12.sig", 65536)
    val sha384On256For12 = linuxReadFile("$directory/p256-sha384-12.sig", 65536)
    val sha256On384For13 = linuxReadFile("$directory/p384-sha256-13.sig", 65536)
    val sha256On256For13 = linuxReadFile("$directory/p256-sha256-13.sig", 65536)
    val sha384On384For13 = linuxReadFile("$directory/p384-sha384-13.sig", 65536)
    check("TLS 1.2: a P-384 key under ecdsa_secp256r1_sha256",
        tlsVerifySignature(p384, TLS_SIG_ECDSA_SECP256R1_SHA256 + TLS_SIGNATURE_TLS12, tls12, sha256On384For12), true)
    check("TLS 1.2: a P-256 key under ecdsa_secp384r1_sha384",
        tlsVerifySignature(p256, TLS_SIG_ECDSA_SECP384R1_SHA384 + TLS_SIGNATURE_TLS12, tls12, sha384On256For12), true)
    check("TLS 1.2: a signature of the wrong key",
        tlsVerifySignature(p256, TLS_SIG_ECDSA_SECP256R1_SHA256 + TLS_SIGNATURE_TLS12, tls12, sha256On384For12), false)
    check("TLS 1.2: the wrong hash",
        tlsVerifySignature(p384, TLS_SIG_ECDSA_SECP384R1_SHA384 + TLS_SIGNATURE_TLS12, tls12, sha256On384For12), false)
    check("no flag: the TLS 1.3 rules apply, so a P-384 key under ecdsa_secp256r1_sha256 is refused even over TLS 1.2 content",
        tlsVerifySignature(p384, TLS_SIG_ECDSA_SECP256R1_SHA256, tls12, sha256On384For12), false)
    check("TLS 1.3: a P-256 key under ecdsa_secp256r1_sha256",
        tlsVerifySignature(p256, TLS_SIG_ECDSA_SECP256R1_SHA256, tls13, sha256On256For13), true)
    check("TLS 1.3: a P-384 key under ecdsa_secp384r1_sha384",
        tlsVerifySignature(p384, TLS_SIG_ECDSA_SECP384R1_SHA384, tls13, sha384On384For13), true)
    check("TLS 1.3: a P-384 key under ecdsa_secp256r1_sha256 (the curve is the scheme's)",
        tlsVerifySignature(p384, TLS_SIG_ECDSA_SECP256R1_SHA256, tls13, sha256On384For13), false)
    if (failures == 0) println("ecdsa curve ok")
    failures
}
