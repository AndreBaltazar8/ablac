// A TlsConnection that is dropped (no close() call) tells the peer with a close_notify before the socket closes.
// Usage: dropnotify <port> <ca file>; the peer (openssl s_server -msg, tools/test-tls-pure-interop.sh) logs the alert.
import "abla/io"
import "abla/process/arguments"
import "abla/tls/pure"

fun decimal(text: string): int {
    var value = 0
    for (i in 0 until text.size) value = value * 10 + (text[i] - 48)
    value
}

fun exchange(port: int, ca: string): bool {
    val connection = tlsConnectWithCa("localhost", ca, port, 5000, 5000)
    if (connection.handle == -1) return false
    if (connection.write("GET / HTTP/1.0\r\n\r\n") < 0) return false
    if (connection.read(1024).size == 0) return false
    // The connection goes out of scope here, without close().
    true
}

fun main: int {
    if (!exchange(decimal(processArgument(0)), processArgument(1))) {
        println("FAIL exchange: ${tlsLastError()}")
        return 1
    }
    println("tls-pure dropnotify ok")
    0
}
