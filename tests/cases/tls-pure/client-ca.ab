// A listener that asks for client certificates against a CA file (tlsListenWithClientCa) and says who connected
// (#822): for each of N connections it prints one line, "accepted <bool> verified <bool> chain <n> cn <name>".
// tools/test-tls-client-ca.sh connects openssl s_client with a good certificate, none, one from another CA and one
// without the client-authentication usage. Arguments: certificate, key, client CA file, required (0 or 1), N.
import "abla/io"
import "abla/integer"
import "abla/crypto/x509"
import "abla/process/arguments"
import "abla/tls/pure"

fun main: int {
    val listener = tlsListenWithClientCa(processArgument(0), processArgument(1), processArgument(2), "127.0.0.1", 0, 16,
        true, processArgument(3) == "1")
    if (listener.handle == -1) {
        println("listen failed: ${tlsLastError()}")
        return 2
    }
    println("port ${listener.localPort()}")
    var left = processArgument(4).parseInt() ?? 0
    while (left > 0) {
        left = left - 1
        val connection = listener.accept(5000)
        val der = connection.peerCertificate()
        val name = if (der == "") "" else x509ParseDer(der).subject.commonName
        println("accepted ${connection.handle != -1} verified ${connection.peerCertificateVerified()} chain ${connection.peerChain().size} cn $name")
    }
    0
}
