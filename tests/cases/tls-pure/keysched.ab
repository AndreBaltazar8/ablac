// abla/tls/pure key schedule and record layer against RFC 8448 section 3 ("Simple 1-RTT Handshake", the
// whole trace for TLS_AES_128_GCM_SHA256 and X25519): the shared secret from the two ephemeral keys; the early,
// handshake and master secrets; the transcript hashes; both handshake and application traffic secrets and their
// keys and IVs; the exporter and resumption secrets; both Finished values; and every protected record of the
// trace (the server's encrypted flight, the client Finished, the NewSessionTicket, application data and the
// alerts), sealed and opened with sequence numbers. The vectors are tests/vectors/tls/rfc8448-section3.txt, one
// `heading|name|hex` line each (regenerated by tools/tls/extract-rfc8448.sh), given as the first argument.
// Prints "tls-pure keysched ok"; tools/test-tls-pure.sh runs it.
import "abla/io"
import "abla/crypto"
import "abla/crypto/hkdf"
import "abla/crypto/x25519"
import "abla/process/arguments"
import "abla/text"
import "abla/sys/linux"
import "abla/tls/pure/keysched"
import "abla/tls/pure/record"

var failures = 0
var lines: array<string> = []

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL $what")
    return
}

fun check(name: string, actual: string, expected: string): void {
    if (hexEncode(actual) != expected) fail("$name: ${hexEncode(actual)} != $expected")
    return
}

// The `occurrence`th (1-based) value `name` of the step `heading`, as hex.
fun vector(heading: string, name: string, occurrence: int = 1): string {
    var seen = 0
    for (line in lines) {
        val parts = line.split("|")
        if (parts.size == 3 && parts[0] == heading && parts[1] == name) {
            seen = seen + 1
            if (seen == occurrence) return parts[2]
        }
    }
    fail("no vector $heading / $name #$occurrence")
    ""
}

fun raw(heading: string, name: string, occurrence: int = 1): string = hexDecode(vector(heading, name, occurrence))

fun main: int {
    lines = linuxReadFile("${processArgument(0)}/rfc8448-section3.txt", 4194304).split("\n")
    val h = HKDF_SHA256

    // The ephemeral keys and the shared secret.
    val clientPrivate = raw("{client}  create an ephemeral x25519 key pair", "private key")
    val clientPublic = raw("{client}  create an ephemeral x25519 key pair", "public key")
    val serverPrivate = raw("{server}  create an ephemeral x25519 key pair", "private key")
    val serverPublic = raw("{server}  create an ephemeral x25519 key pair", "public key")
    check("client public key", x25519PublicKey(clientPrivate).bytes, hexEncode(clientPublic))
    check("server public key", x25519PublicKey(serverPrivate).bytes, hexEncode(serverPublic))
    val shared = x25519(clientPrivate, serverPublic)
    val sharedFromServer = x25519(serverPrivate, clientPublic)
    check("shared secret", shared.bytes, vector("{server}  extract secret \"handshake\"", "IKM"))
    check("shared secret (server side)", sharedFromServer.bytes, hexEncode(shared.bytes))

    // The key schedule up to the handshake traffic secrets.
    val early = tlsEarlySecret(h, "")
    check("early secret", early, vector("{server}  extract secret \"early\"", "secret"))
    val transcript = tlsTranscript()
    transcript.add(raw("{client}  construct a ClientHello handshake message", "ClientHello"))
    transcript.add(raw("{server}  construct a ServerHello handshake message", "ServerHello"))
    val helloHash = transcript.hash(h)
    check("hello hash", helloHash, vector("{server}  derive secret \"tls13 c hs traffic\"", "hash"))
    val handshake = tlsDeriveHandshakeSecrets(h, early, shared.bytes, helloHash)
    check("derived (handshake)", tlsDeriveSecret(h, early, "derived", tlsHashOf(h, "")),
        vector("{server}  derive secret for handshake \"tls13 derived\"", "expanded"))
    check("handshake secret", handshake.handshakeSecret, vector("{server}  extract secret \"handshake\"", "secret"))
    check("client handshake traffic secret", handshake.clientTraffic,
        vector("{server}  derive secret \"tls13 c hs traffic\"", "expanded"))
    check("server handshake traffic secret", handshake.serverTraffic,
        vector("{server}  derive secret \"tls13 s hs traffic\"", "expanded"))
    check("server handshake key", tlsTrafficKey(h, handshake.serverTraffic, 16),
        vector("{server}  derive write traffic keys for handshake data", "key expanded"))
    check("server handshake iv", tlsTrafficIv(h, handshake.serverTraffic),
        vector("{server}  derive write traffic keys for handshake data", "iv expanded"))
    check("derived (master)", tlsDeriveSecret(h, handshake.handshakeSecret, "derived", tlsHashOf(h, "")),
        vector("{server}  derive secret for master \"tls13 derived\"", "expanded"))
    check("master secret", tlsMasterSecret(h, handshake.handshakeSecret),
        vector("{server}  extract secret \"master\"", "secret"))

    // The server's flight and its Finished.
    transcript.add(raw("{server}  construct an EncryptedExtensions handshake message", "EncryptedExtensions"))
    transcript.add(raw("{server}  construct a Certificate handshake message", "Certificate"))
    transcript.add(raw("{server}  construct a CertificateVerify handshake message", "CertificateVerify"))
    val beforeFinished = transcript.hash(h)
    check("server finished key", tlsFinishedKey(h, handshake.serverTraffic),
        vector("{server}  calculate finished \"tls13 finished\"", "expanded"))
    val serverVerify = tlsFinishedVerifyData(h, handshake.serverTraffic, beforeFinished)
    check("server verify_data", serverVerify, vector("{server}  calculate finished \"tls13 finished\"", "finished"))
    val serverFinished = raw("{server}  construct a Finished handshake message", "Finished")
    check("server Finished message", serverFinished, hexEncode(hexDecode("14000020") + serverVerify))
    transcript.add(serverFinished)
    val serverFinishedHash = transcript.hash(h)

    // The application secrets, keys and IVs.
    val application = tlsDeriveApplicationSecrets(h, handshake.handshakeSecret, serverFinishedHash)
    check("server finished hash", serverFinishedHash, vector("{server}  derive secret \"tls13 c ap traffic\"", "hash"))
    check("client application traffic secret", application.clientTraffic,
        vector("{server}  derive secret \"tls13 c ap traffic\"", "expanded"))
    check("server application traffic secret", application.serverTraffic,
        vector("{server}  derive secret \"tls13 s ap traffic\"", "expanded"))
    check("exporter master secret", application.exporter,
        vector("{server}  derive secret \"tls13 exp master\"", "expanded"))
    check("server application key", tlsTrafficKey(h, application.serverTraffic, 16),
        vector("{server}  derive write traffic keys for application data", "key expanded"))
    check("server application iv", tlsTrafficIv(h, application.serverTraffic),
        vector("{server}  derive write traffic keys for application data", "iv expanded"))
    check("client application key", tlsTrafficKey(h, application.clientTraffic, 16),
        vector("{client}  derive write traffic keys for application data", "key expanded"))
    check("client application iv", tlsTrafficIv(h, application.clientTraffic),
        vector("{client}  derive write traffic keys for application data", "iv expanded"))
    check("client handshake key", tlsTrafficKey(h, handshake.clientTraffic, 16),
        vector("{server}  derive read traffic keys for handshake data", "key expanded"))

    // The client's Finished and the resumption secret.
    check("client finished key", tlsFinishedKey(h, handshake.clientTraffic),
        vector("{client}  calculate finished \"tls13 finished\"", "expanded"))
    val clientVerify = tlsFinishedVerifyData(h, handshake.clientTraffic, serverFinishedHash)
    check("client verify_data", clientVerify, vector("{client}  calculate finished \"tls13 finished\"", "finished"))
    val clientFinished = raw("{client}  construct a Finished handshake message", "Finished")
    check("client Finished message", clientFinished, hexEncode(hexDecode("14000020") + clientVerify))
    transcript.add(clientFinished)
    check("resumption master secret",
        tlsResumptionMasterSecret(h, tlsMasterSecret(h, handshake.handshakeSecret), transcript.hash(h)),
        vector("{client}  derive secret \"tls13 res master\"", "expanded"))

    // The records: the plaintext ServerHello and ClientHello records, then every protected one.
    check("ClientHello record", tlsPlaintextRecord(TLS_HANDSHAKE, 769, raw("{client}  send handshake record", "payload")),
        vector("{client}  send handshake record", "complete record"))
    check("ServerHello record",
        tlsPlaintextRecord(TLS_HANDSHAKE, 771, raw("{server}  send handshake record", "payload", 1)),
        vector("{server}  send handshake record", "complete record", 1))
    val serverHandshake = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(h, handshake.serverTraffic, 16),
        tlsTrafficIv(h, handshake.serverTraffic))
    val serverFlight = tlsProtectRecord(serverHandshake, TLS_HANDSHAKE, raw("{server}  send handshake record", "payload", 2))
    if (!serverFlight.ok) fail("server flight: ${serverFlight.error}")
    check("server encrypted flight", serverFlight.bytes, vector("{server}  send handshake record", "complete record", 2))
    val openServerHandshake = tlsRecordProtection(TLS_AEAD_AES_128_GCM,
        tlsTrafficKey(h, handshake.serverTraffic, 16), tlsTrafficIv(h, handshake.serverTraffic))
    val openedFlight = tlsOpenRecord(openServerHandshake, hexDecode(vector("{server}  send handshake record", "complete record", 2)))
    if (!openedFlight.ok || openedFlight.type != TLS_HANDSHAKE) fail("server flight did not open: ${openedFlight.error}")
    check("server flight opened", openedFlight.content, vector("{server}  send handshake record", "payload", 2))

    val clientHandshake = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(h, handshake.clientTraffic, 16),
        tlsTrafficIv(h, handshake.clientTraffic))
    val clientFinishedRecord = tlsProtectRecord(clientHandshake, TLS_HANDSHAKE, raw("{client}  send handshake record", "payload", 2))
    check("client Finished record", clientFinishedRecord.bytes, vector("{client}  send handshake record", "complete record", 2))

    val serverApplication = tlsRecordProtection(TLS_AEAD_AES_128_GCM,
        tlsTrafficKey(h, application.serverTraffic, 16), tlsTrafficIv(h, application.serverTraffic))
    val clientApplication = tlsRecordProtection(TLS_AEAD_AES_128_GCM,
        tlsTrafficKey(h, application.clientTraffic, 16), tlsTrafficIv(h, application.clientTraffic))
    val ticket = tlsProtectRecord(serverApplication, TLS_HANDSHAKE, raw("{server}  send handshake record", "payload", 3))
    check("NewSessionTicket record", ticket.bytes, vector("{server}  send handshake record", "complete record", 3))
    val clientData = tlsProtectRecord(clientApplication, TLS_APPLICATION_DATA,
        raw("{client}  send application_data record", "payload"))
    check("client application data record", clientData.bytes,
        vector("{client}  send application_data record", "complete record"))
    val serverData = tlsProtectRecord(serverApplication, TLS_APPLICATION_DATA,
        raw("{server}  send application_data record", "payload"))
    check("server application data record", serverData.bytes,
        vector("{server}  send application_data record", "complete record"))
    val clientAlert = tlsProtectRecord(clientApplication, TLS_ALERT, raw("{client}  send alert record", "payload"))
    check("client alert record", clientAlert.bytes, vector("{client}  send alert record", "complete record"))
    val serverAlert = tlsProtectRecord(serverApplication, TLS_ALERT, raw("{server}  send alert record", "payload"))
    check("server alert record", serverAlert.bytes, vector("{server}  send alert record", "complete record"))

    // Opening them again in order, then the refusals.
    val reader = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(h, application.serverTraffic, 16),
        tlsTrafficIv(h, application.serverTraffic))
    val openedTicket = tlsOpenRecord(reader, hexDecode(vector("{server}  send handshake record", "complete record", 3)))
    if (!openedTicket.ok || openedTicket.type != TLS_HANDSHAKE) fail("ticket did not open: ${openedTicket.error}")
    check("ticket opened", openedTicket.content, vector("{server}  send handshake record", "payload", 3))
    val openedData = tlsOpenRecord(reader, hexDecode(vector("{server}  send application_data record", "complete record")))
    if (!openedData.ok || openedData.type != TLS_APPLICATION_DATA) fail("data did not open: ${openedData.error}")
    check("data opened", openedData.content, vector("{server}  send application_data record", "payload"))
    val openedAlert = tlsOpenRecord(reader, hexDecode(vector("{server}  send alert record", "complete record")))
    if (!openedAlert.ok || openedAlert.type != TLS_ALERT) fail("alert did not open: ${openedAlert.error}")

    val wrongSequence = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(h, application.serverTraffic, 16),
        tlsTrafficIv(h, application.serverTraffic))
    if (tlsOpenRecord(wrongSequence, hexDecode(vector("{server}  send application_data record", "complete record"))).ok) {
        fail("a record opened under the wrong sequence number")
    }
    val tampered = hexDecode(vector("{server}  send application_data record", "complete record"))
    val bytes: array<int> = []
    for (i in 0 until tampered.size) bytes.append(if (i == tampered.size - 3) tampered[i] ^ 1 else tampered[i])
    val flipped = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(h, application.serverTraffic, 16),
        tlsTrafficIv(h, application.serverTraffic))
    flipped.sequence = 1
    if (tlsOpenRecord(flipped, cryptoByteString(bytes)).ok) fail("a record with a flipped bit opened")
    if (tlsOpenRecord(flipped, tampered.slice(0, tampered.size - 1)).ok) fail("a truncated record opened")
    if (tlsOpenRecord(flipped, "").ok) fail("an empty record opened")
    val big = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(h, application.serverTraffic, 16),
        tlsTrafficIv(h, application.serverTraffic))
    val tooLong: array<int> = []
    while (tooLong.size < 16385) tooLong.append(97)
    if (tlsProtectRecord(big, TLS_APPLICATION_DATA, cryptoByteString(tooLong)).ok) fail("content over 2^14 was sealed")
    val full: array<int> = []
    while (full.size < 16384) full.append(98)
    val fullRecord = tlsProtectRecord(big, TLS_APPLICATION_DATA, cryptoByteString(full), 7)
    if (!fullRecord.ok) fail("a full record with padding was not sealed: ${fullRecord.error}")
    val bigReader = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(h, application.serverTraffic, 16),
        tlsTrafficIv(h, application.serverTraffic))
    val bigOpened = tlsOpenRecord(bigReader, fullRecord.bytes)
    if (!bigOpened.ok || bigOpened.content.size != 16384 || bigOpened.type != TLS_APPLICATION_DATA) {
        fail("a padded full record did not open: ${bigOpened.error}")
    }
    // The nonce is the IV xor the sequence number, big-endian in the last eight bytes.
    check("nonce for sequence 0", tlsRecordNonce(hexDecode("5d313eb2671276ee13000b30"), 0), "5d313eb2671276ee13000b30")
    check("nonce for sequence 1", tlsRecordNonce(hexDecode("5d313eb2671276ee13000b30"), 1), "5d313eb2671276ee13000b31")
    check("nonce for a long sequence", tlsRecordNonce(hexDecode("000000000000000000000000"), 258), "000000000000000000000102")

    if (failures > 0) {
        println("tls-pure keysched: $failures failures")
        return 1
    }
    println("tls-pure keysched ok")
    0
}
