// TlsListener.accept bounds the whole handshake, not each wait (#820): a client that sends its ClientHello a byte at a
// time, faster than the per-wait timeout, is cut off after about one timeout. Prints the outcome and the time accept
// took; tools/test-tls-accept-deadline.sh drips the bytes. Arguments: certificate chain (PEM), private key (PEM).
import "abla/io"
import "abla/process/arguments"
import "abla/process/time"
import "abla/tls/pure"

fun main: int {
    val listener = tlsListen(processArgument(0), processArgument(1), "127.0.0.1", 0)
    if (listener.handle == -1) {
        println("listen failed: ${tlsLastError()}")
        return 2
    }
    println("port ${listener.localPort()}")
    val started = realtimeMilliseconds()
    val connection = listener.accept(1500)
    val elapsed = realtimeMilliseconds() - started
    println("accepted ${connection.handle != -1}")
    println("elapsed $elapsed")
    0
}
