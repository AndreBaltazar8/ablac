// Malformed extension bodies in a ClientHello that abla/tls/pure used to take (#1139 area 3, found by the differential against OpenSSL and Go,
// tools/tls-diff): an empty supported_versions list (versions<2..254>), an empty ALPN protocol_name_list (<2..2^16-1>), an early_data extension
// with a body (it is empty in a ClientHello), and a malformed status_request. Each is a decode error; the well formed forms still parse.
// Prints "tls-pure hello ok".
import "abla/io"
import "abla/crypto"
import "abla/text"
import "abla/tls/pure/handshake"

var failures = 0

fun check(ok: bool, what: string): void {
    if (!ok) {
        failures = failures + 1
        println("FAIL $what")
    }
    return
}

fun ext(type: int, body: string): string = tlsExtension(type, body)

/** A ClientHello body with the extensions `extensions` (after the ones every hello here has). */
fun helloBody(versions: string, extensions: string): string {
    val share = "\x00\x24\x00\x1d\x00\x20" + "k".repeat(32)
    val all = ext(43, versions) + ext(10, "\x00\x02\x00\x1d") + ext(13, "\x00\x02\x08\x04") + ext(51, share) + extensions
    "\x03\x03" + "r".repeat(32) + "\x00" + "\x00\x02\x13\x01" + "\x01\x00" + tlsU16(all.size) + all
}

fun parses(versions: string, extensions: string): bool = tlsParseClientHello(helloBody(versions, extensions)).ok

fun main: int {
    val good = "\x02\x03\x04"
    check(parses(good, ""), "the base hello parses")
    check(!parses("\x00", ""), "an empty supported_versions list is refused")
    check(!parses("\x01\x03", ""), "a supported_versions list of one byte is refused")
    check(parses(good, ext(16, "\x00\x03\x02h2")), "an ALPN list with a name parses")
    check(!parses(good, ext(16, "\x00\x00")), "an empty ALPN protocol list is refused")
    check(!parses(good, ext(16, "\x00\x01\x00")), "an empty ALPN protocol name is refused")
    check(parses(good, ext(42, "")), "an empty early_data parses")
    check(!parses(good, ext(42, "\x00")), "an early_data with a body is refused")
    check(!parses(good, ext(42, "\x00\x00\x00\x00")), "an early_data with four bytes is refused")
    check(parses(good, ext(5, "\x01\x00\x00\x00\x00")), "a status_request with empty lists parses")
    check(parses(good, ext(5, "\x01\x00\x02ab\x00\x00")), "a status_request with a responder id list parses")
    check(!parses(good, ext(5, "")), "an empty status_request is refused")
    check(!parses(good, ext(5, "\x01")), "a status_request of one byte is refused")
    check(!parses(good, ext(5, "\x01\x00\x00")), "a status_request cut after the first list is refused")
    check(!parses(good, ext(5, "\x01\x00\x00\x00\x00\x00")), "a status_request with a trailing byte is refused")
    check(!parses(good, ext(5, "\x01\x00\x05ab\x00\x00")), "a status_request whose list overruns is refused")
    check(parses(good, ext(5, "\x02whatever")), "a status_request of another status type is ignored")
    if (failures == 0) println("tls-pure hello ok")
    if (failures == 0) 0 else 1
}
