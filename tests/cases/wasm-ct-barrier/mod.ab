import "abla/ct"

// The constant-time select goes through abla/ct's barrier, which is inline assembly: a --fast
// WebAssembly module with it needs the target's assembly parser in the in-process object route.
@export("pick")
fun pick(mask: u32, a: u32, b: u32): u32 =
    ctSelect(secretU32(mask), secretU32(a), secretU32(b)).declassify()
