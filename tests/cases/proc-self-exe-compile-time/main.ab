import "abla/io"
import "abla/fs"
import "abla/compiler"

#compilerGrant("filesystem.read")

// Compile-time code reads `/proc/self/exe`: the compiler's own image, in the interpreter and in the JIT module
// (which has no process entry to record its image from; on macOS it asks the kernel).
compile fun selfSize(): int = path("/proc/self/exe").readText().size

val size = #selfSize()

fun main {
    println("$size")
}
