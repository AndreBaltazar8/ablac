import "abla/runtime/scalar"
type Temperature = f64
class Point(val x: int)
var Point.wide: f64 = 1.5
var Point.narrow: f32 = f32(1.25)
var Point.maybe: f64? = null
var Point.named: Temperature = Temperature(1.5)
var Point.values: array<f64> = [1.5]
var Point.integer: int = 7
val Point.once: f64 = 0.0
trusted fun auxiliary(value: any): int = ablaRuntimeLoadI32(ablaRuntimeValueAddress(value) + 4)
fun symbol(name: string): int {
    var hash = 181
    for (index in 0 until name.size) {
        hash = hash * 281 + name[index] + 1
        hash = hash - (hash / 1000000007) * 1000000007
    }
    if (hash < 0) 0 - hash else hash
}
@export("check")
fun main: int {
    val point = Point(0)
    point.wide = 2.25
    point.narrow = f32(3.5)
    point.maybe = 4.5
    point.named = Temperature(6.25)
    point.integer = 9
    point.once = 7.75
    if (auxiliary(__ablaRuntimeFieldGet(point, symbol("wide"))) != 2) return 1
    if (auxiliary(__ablaRuntimeFieldGet(point, symbol("narrow"))) != 1) return 2
    if (auxiliary(__ablaRuntimeFieldGet(point, symbol("maybe"))) != 2) return 3
    if (auxiliary(__ablaRuntimeFieldGet(point, symbol("named"))) != 2) return 4
    if (auxiliary(__ablaRuntimeFieldGet(point, symbol("integer"))) != 0) return 5
    if (auxiliary(__ablaRuntimeFieldGet(point, symbol("once"))) != 2) return 10
    if (point.wide + 1.0 != 3.25) return 6
    point.values.append(2.25)
    val values = __ablaRuntimeFieldGet(point, symbol("values"))
    if (auxiliary(__ablaRuntimeIndexGet(values, 0)) != 2) return 7
    if (auxiliary(__ablaRuntimeIndexGet(values, 1)) != 2) return 8
    point.values = [9.5]
    if (auxiliary(__ablaRuntimeIndexGet(__ablaRuntimeFieldGet(point, symbol("values")), 0)) != 2) return 11
    point.maybe = null
    if (auxiliary(__ablaRuntimeFieldGet(point, symbol("maybe"))) != 0) return 9
    0
}
