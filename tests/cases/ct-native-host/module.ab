// A module built for WebAssembly from compile-time code (build.ab): its site runs in a slice for another target,
// which must stay portable. ablaCompileTimeNativeHost is false there, and the walker that proves the slice portable
// skips its `then`, so the non-portable call in it (abs, a C function) doesn't make the site fall back to the
// evaluator. (The grant is for the effect analysis, which counts both arms in a program's own code.)
import "abla/bytes"
import "abla/compiler"

#compilerGrant("trusted.native")
noescape extern:"c" fun abs(value: i32): i32

compile fun which(): int = if (ablaCompileTimeNativeHost()) int(abs(i32(-1))) else if (ablaAtCompileTime()) 2 else 3

val VALUE = #which()
@export("run")
fun run(): int = VALUE
