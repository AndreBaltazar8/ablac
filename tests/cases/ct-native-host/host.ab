// ablaCompileTimeNativeHost (abla/bytes) is true only in compile-time code the host's native tier runs
// (tools/test-ct-native-host.sh): the site's dispatcher answers 1 under jit, 2 in the evaluator (only
// ablaAtCompileTime is true there), and 3 when the program runs.
import "abla/bytes"

fun which(): int = if (ablaCompileTimeNativeHost()) 1 else if (ablaAtCompileTime()) 2 else 3

val atCompileTime = #which()
fun main: int = atCompileTime * 10 + which()
