// Edge cases table, run as ordinary code and under `#` (tools/test-format-edges.sh); main exits with the number of differences.
import "abla/io"
import "abla/http"

@noinline fun idS(x: string): string = x

fun lookup(query: string, name: string): string {
    val headers: array<HttpHeader> = []
    val names: array<string> = []
    val values: array<string> = []
    val request = HttpRequest("GET", "/", query, headers, "", names, values)
    "[${request.queryParameter(name)}]"
}

fun cases(): array<string> {
    val out: array<string> = []
    val queries = ["", "a", "a=", "a=1", "a=1&b=2", "b=2&a=1", "a=&a=2", "a=1&a=2", "&a=1", "a=1&", "&&a=1&&", "=x", "&=x", "a=1&=y", "ab=1&a=2", "a=b=c", "aa=1", "xa=1&a=3",
        "a=%41", "a=%", "a=+", "a=1;b=2", "a==", "a=&&a=", "é=1&a=é", "a=\0&b=1", "key=value&key2=value2&key=again", "a=1&b=2&c=3&d=4&e=5&f=6&g=7&h=8", "long=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&z=1"]
    val names = ["", "a", "b", "ab", "aa", "key", "key2", "=", "a=b", "&", "é", "z", "h", "long", "A", "a=", "x"]
    for (q in queries) {
        var line = "q=${q.size}:"
        for (n in names) line = line + " " + lookup(idS(q), idS(n))
        out.append(line)
    }
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) { println("SIZES"); bad = 1 }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF ${i}:\n live:   ${live[i]}\n staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println("LIVE ${line}")
    bad
}
