// Edge cases table, run as ordinary code and under `#` (tools/test-format-edges.sh); main exits with the number of differences.
import "abla/io"
import "abla/uuid"

@noinline fun idS(x: string): string = x

fun show(text: string): string {
    val u = uuidParse(idS(text))
    if (u == null) "null" else uuidText(u)
}

fun cases(): array<string> {
    val out: array<string> = []
    val inputs = [
        "00000000-0000-0000-0000-000000000000", "ffffffff-ffff-ffff-ffff-ffffffffffff", "FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF", "123e4567-e89b-12d3-a456-426614174000", "123E4567-e89b-12D3-a456-426614174000",
        "", "0", "123e4567e89b12d3a456426614174000", "{123e4567-e89b-12d3-a456-426614174000}", "urn:uuid:123e4567-e89b-12d3-a456-426614174000", "123e4567-e89b-12d3-a456-42661417400", "123e4567-e89b-12d3-a456-4266141740000",
        "123e4567_e89b_12d3_a456_426614174000", "123e4567-e89b-12d3-a456-42661417400g", "g23e4567-e89b-12d3-a456-426614174000", "123e4567-e89b-12d3-a456 426614174000", " 123e4567-e89b-12d3-a456-42661417400", "123e4567-e89b-12d3-a456-42661417400 ",
        "123e4567-e89b-12d3-a456-42661417400\0", "123e456-7e89b-12d3-a456-426614174000", "123e4567-e89-b12d3-a456-426614174000", "123e4567-e89b-12d-3a456-426614174000", "123e4567-e89b-12d3-a45-6426614174000",
        "123e4567-e89b-12d3-a456-42661417400é", "é23e4567-e89b-12d3-a456-426614174000", "-123e4567-e89b-12d3-a456-426614174000", "123e4567-e89b-12d3-a456-426614174000-",
        "00000000-0000-1000-8000-000000000000", "00000000-0000-4000-8000-000000000000", "00000000-0000-7000-8000-000000000000", "00000000-0000-0000-c000-000000000000",
    ]
    for (s in inputs) out.append("parse ${s.size} ${show(s)}")
    // wrong sizes for bytes
    out.append("fromBytes ${uuidFromBytes(idS("")) == null} ${uuidFromBytes(idS("0123456789abcde")) == null} ${uuidFromBytes(idS("0123456789abcdef")) != null} ${uuidFromBytes(idS("0123456789abcdefg")) == null}")
    val u = uuidFromBytes(idS("\0\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\xff"))
    out.append("bytes ${if (u == null) "null" else uuidText(u)}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) { println("SIZES"); bad = 1 }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) { println("DIFF live: ${live[i]} | staged: ${staged[i]}"); bad = bad + 1 }
    }
    for (line in live) println("LIVE ${line}")
    bad
}
