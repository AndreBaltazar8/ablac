// Edge cases table, run as ordinary code and under `#` (tools/test-format-edges.sh); main exits with the number of differences.
import "abla/io"
import "abla/crypto"

@noinline fun idS(x: string): string = x
@noinline fun idI(x: int): int = x

fun bytesOf(s: string): string = if (s.size == 0) "-" else hexEncode(s)

fun decodeInputs(): array<string> = [
    "", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy",
    "Zg", "Zg=", "Zg===", "Z", "Zm9", "Zm9v=", "=Zm9v", "Zm=9", "Zm9v\n", " Zm9v", "Zm9v Zm9v", "Zm9vYg==\n",
    "Zm9v\r\nYmFy", "Zm9-", "Zm9_", "Zm9v\0", "A", "AA", "AAA", "AAAA", "AAAA=", "AAA=", "AA==", "A===", "====", "=",
    "Zh==", "Zm9=", "Zm+/", "+/+/", "//8=", "/+8=", "AAAAAAAA", "AAAAAAA", "AAAAAAAAA", "ab==", "ab=", "a===",
    "\xff\xff\xff\xff", "é===", "Zm9v\xc3\xa9", "Zm9vYmFyYg==Zm9v", "Zm9vYg==Zm9v", "Zg==Zg==",
    "AAAA\nAAAA", "AAAA AAAA", "AAAA\tAAAA", "QUJD", "QUJDRA==", "QUJDREU=", "QUJDREVG", "QQ==", "QQ=", "QQ"
]

fun cases(): array<string> {
    val out: array<string> = []
    // encode: lengths 0..9 of assorted bytes
    val samples = ["", "f", "fo", "foo", "foob", "fooba", "foobar", "\0", "\0\0", "\0\0\0", "\xff", "\xff\xff", "\xff\xff\xff", "\xfb\xff\xbf", "\xfe\xef", "\x01\x02\x03\x04\x05\x06\x07\x08\x09", "héllo", "日本語"]
    for (s in samples) out.append("enc ${bytesOf(s)} ${base64Encode(idS(s))}")
    // round trip of every byte value alone and in pairs
    var failures = 0
    var checked = 0
    for (b in 0 until 256) {
        val one = hexDecode("0123456789abcdef".slice(b / 16, b / 16 + 1) + "0123456789abcdef".slice(b % 16, b % 16 + 1))
        if (base64Decode(base64Encode(one)) != one) failures = failures + 1
        checked = checked + 1
        for (c in [0, 1, 63, 64, 127, 128, 191, 192, 254, 255]) {
            val two = one + hexDecode("0123456789abcdef".slice(c / 16, c / 16 + 1) + "0123456789abcdef".slice(c % 16, c % 16 + 1))
            if (base64Decode(base64Encode(two)) != two) failures = failures + 1
            checked = checked + 1
        }
    }
    out.append("roundtrip ${checked} ${failures}")
    // decode inputs
    for (s in decodeInputs()) out.append("dec ${bytesOf(s)}:${s.size} -> ${bytesOf(base64Decode(idS(s)))}")
    // hex
    val hexIn = ["", "00", "ff", "FF", "aB", "0g", "g0", "0", "000", "abc", " 00", "00 ", "0x00", "-1", "+1", "\xff\xff", "0\0", "é", "DEADbeef", "deadBEEF", "00ff00ff00ff00ff00ff"]
    for (s in hexIn) out.append("hexdec ${bytesOf(s)}:${s.size} -> ${bytesOf(hexDecode(idS(s)))}")
    out.append("hexenc ${hexEncode("")} ${hexEncode("\0")} ${hexEncode("\xff")} ${hexEncode("\0\xff\x7f\x80")} ${hexEncode("日")}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) {
        println("SIZES ${live.size} ${staged.size}")
        bad = 1
    }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println("LIVE ${line}")
    bad
}
