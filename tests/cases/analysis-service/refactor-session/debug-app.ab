import "abla/io"
class Point(val x: int, val y: int) {
    fun norm1: int = this.x + this.y
}
fun main {
    val name = "hello"
    val items = [1, 2, 3]
    val table: Map<string, int> = Map()
    table.set("a", 1)
    val maybe: int? = 5
    val none: string? = null
    val p = Point(3, 4)
    val n = p.norm1()
    println("${name} ${items.size} ${table.size} ${maybe != null} ${none == null} ${n}")
    println("done")
}
