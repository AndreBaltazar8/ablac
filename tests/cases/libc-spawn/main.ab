// posix_spawn and its file actions of the statically linked compiler's C library (src/static_libc/spawn.ab, #806 step C), called as the
// ordinary functions they are: a child that exits with a status, one whose standard output is redirected by an addopen action into a file, one
// given a descriptor by adddup2, the error number for a program that does not exist or a file that cannot be opened (returned, not -1), and
// the environment the child sees. The program exits 42.
import "abla/io"
import "abla/runtime/scalar"
import "abla/sys/linux"
import "../../../src/static_libc/spawn.ab"
import "../../../src/static_libc/memory.ab"
import "../../../src/static_libc/fs.ab"
import "../../../src/static_libc/errno.ab"
import "../../../src/static_libc/time.ab"

var failures = 0

fun check(what: string, ok: bool) {
    if (!ok) {
        failures += 1
        println("libc-spawn: $what")
    }
}

trusted fun cstr(text: string): int {
    val at = libcMalloc(text.size + 1)
    var i = 0
    while (i < text.size) {
        ablaRuntimeStoreU8(at + i, text[i])
        i += 1
    }
    ablaRuntimeStoreU8(at + text.size, 0)
    at
}

// A NULL-terminated vector of C strings.
trusted fun vector(items: array<string>): int {
    val at = libcMalloc((items.size + 1) * 8)
    var i = 0
    while (i < items.size) {
        ablaRuntimeStoreI64(at + i * 8, cstr(items[i]))
        i += 1
    }
    ablaRuntimeStoreI64(at + items.size * 8, 0)
    at
}

// Spawn `program` (found as a path) with `script` for sh -c; returns the wait status's exit code, or -1000 - the error number of posix_spawn.
trusted fun spawnShell(script: string, actions: int, environment: array<string>): int {
    val pid = libcMalloc(8)
    val error = libcPosixSpawn(pid, cstr("/bin/sh"), actions, 0, vector(["sh", "-c", script]), vector(environment))
    if (error != 0) return -1000 - error
    val status = libcMalloc(8)
    linuxSyscall4(61, ablaRuntimeLoadI32(pid), status, 0, 0)
    (ablaRuntimeLoadI32(status) >> 8) & 255
}

trusted fun fileText(path: string): string {
    val buffer = libcMalloc(256)
    val fd = libcOpen(cstr(path), 0, 0)
    if (fd < 0) return "<missing>"
    val n = libcRead(fd, buffer, 255)
    libcClose(fd)
    var text = ""
    var i = 0
    while (i < n) {
        text = text + libcChar(ablaRuntimeLoadU8(buffer + i))
        i += 1
    }
    text
}

trusted fun main: int {
    val directory = "/tmp/abla-libc-spawn-${linuxSyscall0(39)}"
    linuxSyscall2(83, cstr(directory), 448)
    val none = libcMalloc(80)
    libcSpawnActionsInit(none)
    check("exit status 7", spawnShell("exit 7", none, ["PATH=/bin:/usr/bin"]) == 7)
    check("exit status 0", spawnShell("true", 0, ["PATH=/bin:/usr/bin"]) == 0)
    // The environment is the one passed, and nothing else.
    check("environment", spawnShell("test \"\$ABLA_SPAWN\" = yes", none, ["ABLA_SPAWN=yes", "PATH=/bin:/usr/bin"]) == 0)
    check("environment is only what was passed", spawnShell("test -z \"\$HOME\"", none, ["PATH=/bin:/usr/bin"]) == 0)
    // addopen: standard output goes to a file the child creates (O_WRONLY|O_CREAT|O_TRUNC = 577).
    val actions = libcMalloc(80)
    libcSpawnActionsInit(actions)
    check("addopen", libcSpawnActionsAddopen(actions, 1, cstr("$directory/out.txt"), 577, 420) == 0)
    check("redirected output", spawnShell("echo hello", actions, ["PATH=/bin:/usr/bin"]) == 0)
    check("file has the output", fileText("$directory/out.txt") == "hello\n")
    // adddup2: descriptor 3 gets the same file, written by `echo >&3`.
    val second = libcMalloc(80)
    libcSpawnActionsInit(second)
    libcSpawnActionsAddopen(second, 9, cstr("$directory/three.txt"), 577, 420)
    libcSpawnActionsAdddup2(second, 9, 3)
    check("dup2 and write", spawnShell("echo via3 >&3", second, ["PATH=/bin:/usr/bin"]) == 0)
    check("file three", fileText("$directory/three.txt") == "via3\n")
    // Many actions grow the table.
    val many = libcMalloc(80)
    libcSpawnActionsInit(many)
    var i = 0
    while (i < 10) {
        libcSpawnActionsAdddup2(many, 1, 10 + i)
        i += 1
    }
    check("ten dup2 actions", spawnShell("echo ok >&19", many, ["PATH=/bin:/usr/bin"]) == 0)
    // Failures come back as the error number: no such program (ENOENT 2), a file that cannot be opened (ENOENT 2 from the action).
    check("no such program", libcPosixSpawn(libcMalloc(8), cstr("/nonexistent/program"), none, 0, vector(["x"]), vector([])) == 2)
    val bad = libcMalloc(80)
    libcSpawnActionsInit(bad)
    libcSpawnActionsAddopen(bad, 5, cstr("/nonexistent/file"), 0, 0)
    check("bad open action", libcPosixSpawn(libcMalloc(8), cstr("/bin/sh"), bad, 0, vector(["sh", "-c", "true"]), vector([])) == 2)
    check("bad descriptor", libcSpawnActionsAdddup2(bad, -1, 3) == 9)
    check("destroy", libcSpawnActionsDestroy(actions) == 0 && libcSpawnActionsDestroy(second) == 0 && libcSpawnActionsDestroy(many) == 0 && libcSpawnActionsDestroy(bad) == 0)
    linuxSyscall1(87, cstr("$directory/out.txt"))
    linuxSyscall1(87, cstr("$directory/three.txt"))
    linuxSyscall1(84, cstr(directory))
    if (failures == 0) { println("libc spawn: ok"); return 42 }
    1
}
