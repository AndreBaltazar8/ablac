// A buffer built by compile-time code (which has no raw memory) holds the same
// bytes as one built at run time, which stages them in place.
import "abla/bytes"
import "abla/json"

compile fun built(): string {
    val buffer = byteBuffer()
    buffer.appendText("ab")
    buffer.appendInt(-42)
    buffer.appendFixed(-5, 3)
    val encoder = jsonEncoder()
    encoder.beginArray()
    encoder.integer(7)
    encoder.string("x")
    encoder.endArray()
    buffer.appendText(encoder.finish())
    buffer.toText()
}

val BUILT = #built()
val ENCODED = #$jsons {"id": "w-new", "n": [1, -2]}

fun main: int {
    val buffer = byteBuffer()
    buffer.appendText("ab")
    buffer.appendInt(-42)
    buffer.appendFixed(-5, 3)
    buffer.appendText("[7,\"x\"]")
    if (BUILT == buffer.toText() && BUILT == "ab-42-0.005[7,\"x\"]" &&
        ENCODED == "{\"id\":\"w-new\",\"n\":[1,-2]}") 42 else 1
}
