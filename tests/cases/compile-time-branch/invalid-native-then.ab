// Only the `else` of `if (ablaAtCompileTime())` is out of compile-time reach:
// native code in the `then` branch is still denied.
import "abla/bytes"
import "abla/unsafe/memory"

trusted fun rawAddress(): int = ablaUnsafePointerAddress(ablaUnsafeAllocate(8))

compile fun address(): int = if (ablaAtCompileTime()) rawAddress() else 0

val ADDRESS = #address()

fun main: int = ADDRESS
