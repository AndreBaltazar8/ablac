// A parameter that is a bare type parameter bound to a function type still types
// the lambda given for it.
import "abla/io"

fun double(x: int): int = x * 2

fun <T> pick(a: T, b: T, first: bool): T = if (first) a else b

fun main: int {
    val chosen = pick(double, { x -> x + 100 }, false)
    println("${chosen(1)}")
    if (chosen(1) == 101) 42 else 1
}
