// The same open parameter next to a class of its name is still reported: R is
// only the type of the lambda's parameter, and no argument gives it one.
import "abla/io"

class R(val n: int)

fun <T, R> both(a: T, f: (R) -> T): T = a

fun main: int {
    val unbound = both(1) { y -> 2 }
    println("${unbound}")
    0
}
