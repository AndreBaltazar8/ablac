// A parameter bound to a class named like a parameter that is still open:
// `T` is bound to the class `R`, and the lambda's parameter is that class even
// though `R` is also the name of the function's result parameter.
import "abla/io"

class R(val n: int)
class V(val n: int)

fun <T, R> viaOpen(a: T, f: (T) -> R): R = f(a)

class Pipe<T>(var item: T) {
    fun <R> then(f: (T) -> R): R = f(this.item)
}

fun main: int {
    val direct = viaOpen(R(2)) { x -> V(x.n + 1) }
    val method = Pipe(R(5)).then { x -> V(x.n * 2) }
    val plain = viaOpen(4) { x -> x + 1 }
    println("${direct.n} ${method.n} ${plain}")
    if (direct.n == 3 && method.n == 10 && plain == 5) 42 else 1
}
