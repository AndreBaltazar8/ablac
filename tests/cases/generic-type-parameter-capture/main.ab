// A class's type parameter named like a program class, bound to that class: a
// generic method's lambda still gets its parameter typed from the binding.
import "abla/io"

class T(val n: int)
class V(val n: int)

class Slot<T>(var item: T) {
    fun <R> mapTo(f: (T) -> R): Slot<R> = Slot(f(this.item))
}

fun <T, R> mapSlot(slot: Slot<T>, f: (T) -> R): Slot<R> = Slot(f(slot.item))

fun main: int {
    val mapped = Slot(T(1)).mapTo { x -> V(x.n + 2) }
    val free = mapSlot(Slot(T(5))) { x -> V(x.n * 2) }
    val plain = Slot(4).mapTo { x -> x + 1 }
    println("${mapped.item.n} ${free.item.n} ${plain.item}")
    if (mapped.item.n == 3 && free.item.n == 10 && plain.item == 5) 42 else 1
}
