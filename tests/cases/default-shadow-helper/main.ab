import "abla/io"
var log: string = ""
resource class Item(val id: int) { fun drop(): void { log = log + "I$id" } }
resource class Holder(val item: Item) { fun drop(): void { log = log + "H" } }
fun value(tag: int, x: int = Holder(Item(tag)).item.id): int { log = log + "F$x"; x }
fun side(): int { log = log + "S"; 0 }
fun pair(a: int, b: int): void {}
fun exercise(): string {
    log = ""
    val Holder = 5
    pair(value(tag = Holder), side())
    log = log + "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
