import "abla/fs"
import "abla/sys/linux/process"
fun main: int {
    val root = Path(linuxEnvironment("ABLA_DIRECTORY_TEST_ROOT").value)
    val explicit = root.child("existing").child("first").child("second")
    val defaulted = root.child("default").child("child")
    if (explicit.createDirectories(448) && defaulted.createDirectories()) 0 else 1
}
