import "abla/io"
import "abla/json"
import "abla/memory"
import "abla/process/arguments"

fun sameDiagnostic(source: string, limits: JsonLimits): bool {
    val parsed = jsonParse(source, limits)
    val checked = jsonValidate(source, limits)
    parsed.succeeded == checked.succeeded &&
        parsed.error.code == checked.error.code &&
        parsed.error.message == checked.error.message &&
        parsed.error.byteOffset == checked.error.byteOffset &&
        parsed.error.line == checked.error.line &&
        parsed.error.column == checked.error.column
}

fun countBackings: int {
    val parsed = jsonParse(processArgument(1))
    if (!parsed.succeeded || parsed.value.values.size != 128 || memoryHeapStat(14) != 0) return 1
    println("${memoryCensus().counts[8]}")
    42
}

fun main: int {
    if (processArgument(0) == "count") return countBackings()
    val standard = jsonDefaultLimits()
    val keep = JsonLimits(4096, 16, 200, 1024, 40, false)
    val merge = JsonLimits(4096, 16, 200, 1024, 40, false, true)
    val reject = JsonLimits(4096, 16, 200, 1024, 40, true, true)
    val three = JsonLimits(4096, 16, 200, 1024, 3, true)
    val shallow = JsonLimits(4096, 2, 200, 1024, 40, true)
    val fewNodes = JsonLimits(4096, 16, 4, 1024, 40, true)
    val shortStrings = JsonLimits(4096, 16, 200, 1, 40, true)
    val valid = [
        "{}", "{\"a\":0}", "{\"a\":0,\"b\":1}", "{\"a\":0,\"b\":1,\"c\":2}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"e\":4}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"e\":4,\"f\":5,\"g\":6,\"h\":7,\"i\":8,\"j\":9,\"k\":10,\"l\":11,\"m\":12,\"n\":13,\"o\":14,\"p\":15,\"q\":16}"
    ]
    for (source in valid) {
        val parsed = jsonParse(source)
        if (!parsed.succeeded || jsonStringify(parsed.value) != source) return 2
    }
    val bad = [
        "{", "{1:0}", "{\"a\"\n 1}", "{\"a\":}", "{\"a\":0,", "{\"a\":0,}",
        "{\"a\":0,\"\\u0061\":1}", "{\"a\":0,\"b\":1,\"a\":2}",
        "{\"a\":0,\"b\":1,\"c\":2,\"a\":3}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"a\":4}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"e\"}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3 x}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"e\":4,}",
        "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"e\":4,\"f\":5,\"g\":6,\"h\":7,\"i\":8,\"j\":9,\"k\":10,\"l\":11,\"m\":12,\"n\":13,\"o\":14,\"p\":15,\"b\":16}"
    ]
    for (source in bad) {
        if (jsonParse(source).succeeded || !sameDiagnostic(source, standard)) return 3
    }
    for (limit in [three, shallow, fewNodes, shortStrings]) {
        for (source in [valid[4], valid[5], "{\"a\":{\"nested\":0}}", "{\"long\":1}"]) {
            if (!sameDiagnostic(source, limit)) return 4
        }
    }
    val repeated = "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"e\":4,\"b\":5}"
    val kept = jsonParse(repeated, keep)
    val merged = jsonParse(repeated, merge)
    if (!kept.succeeded || jsonStringify(kept.value) != repeated ||
        !merged.succeeded || jsonStringify(merged.value) != "{\"a\":0,\"b\":5,\"c\":2,\"d\":3,\"e\":4}" ||
        jsonParse(repeated, reject).succeeded || !sameDiagnostic(repeated, reject)) return 5
    val grow = jsonParse(valid[4]).value
    grow.keys.append("more")
    grow.values.append(jsonInteger(-1))
    if (jsonStringify(grow) != "{\"a\":0,\"b\":1,\"c\":2,\"d\":3,\"more\":-1}") return 6
    42
}
