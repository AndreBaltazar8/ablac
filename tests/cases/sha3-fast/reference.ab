// The permutation of abla/crypto/sha3 with the lanes in locals (sha3PermuteLanes) against the one that works on the words in memory, round by round
// (sha3PermuteWords, the Xtensa one): the same 200 bytes out of random states, the all-zero and all-one states, a single bit set at each position, and 2000 permutations chained
// (each output the next input). Prints "sha3-fast reference ok".
import "abla/io"
import "abla/crypto/alloc"
import "abla/crypto/sha3"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

var failures = 0
var seed = 3333

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 30) println("FAIL $what")
    return
}

fun next(): int {
    seed = (seed * 1103515245 + 12345) & 2147483647
    (seed >> 16) & 255
}

trusted fun fill(address: int, mode: int): void {
    for (i in 0 until 240) {
        val byte = if (mode == 0) next() else if (mode == 1) 0 else if (mode == 2) 255 else 0
        ablaUnsafeStoreU8(nativePointerFromAddress(address + i), byte)
    }
}

trusted fun same(a: int, b: int): bool {
    for (i in 0 until 200) {
        if (ablaUnsafeLoadU8(nativePointerFromAddress(a + i)) != ablaUnsafeLoadU8(nativePointerFromAddress(b + i))) return false
    }
    true
}

trusted fun copy(to: int, from: int): void {
    for (i in 0 until 240) ablaUnsafeStoreU8(nativePointerFromAddress(to + i), ablaUnsafeLoadU8(nativePointerFromAddress(from + i)))
}

trusted fun main: int {
    val a = cryptoAllocate(240)
    val b = cryptoAllocate(240)
    for (round in 0 until 300) {
        fill(a, if (round == 0) 1 else if (round == 1) 2 else 0)
        copy(b, a)
        sha3PermuteLanes(a)
        sha3PermuteWords(b)
        if (!same(a, b)) fail("state $round")
    }
    for (bit in 0 until 1600) {
        fill(a, 1)
        ablaUnsafeStoreU8(nativePointerFromAddress(a + bit / 8), 1 << (bit % 8))
        copy(b, a)
        sha3PermuteLanes(a)
        sha3PermuteWords(b)
        if (!same(a, b)) fail("bit $bit")
    }
    fill(a, 0)
    copy(b, a)
    for (round in 0 until 2000) {
        sha3PermuteLanes(a)
        sha3PermuteWords(b)
    }
    if (!same(a, b)) fail("chained")
    if (failures > 0) return 1
    println("sha3-fast reference ok")
    0
}
