import "abla/runtime/memory"

// The compile-time interpreter has no program heap: asking it how big one is
// is an error that says so, not an answer the program wouldn't give. A
// collection alone is a safe point it grants (0 bytes reclaimed, #829).
compile fun stagedCollection(): int = runtimeMemoryCollect()
compile fun stagedLiveBytes(): int = runtimeMemoryLiveBytes()

fun main: int = #stagedCollection() + #stagedLiveBytes()
