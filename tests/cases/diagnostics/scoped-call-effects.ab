// A call of a parameter, local or lambda parameter named like an effectful
// function is not charged that function's effects, only where the name is in
// scope: `quiet` may run at compile time; `loud` and `later` reach raw memory
// (trusted.native) and may not.
import "abla/io"
import "abla/unsafe/memory/raw"

trusted fun poke(s: string): int = nativeStackAllocate(s.size)

fun quiet(poke: (string) -> int): int = poke("x")

fun loud(): int {
    val h: ((string) -> int) -> int = { poke -> poke("no") }
    poke("yes")
    h({ s: string -> s.size })
}

fun later(): int {
    poke("before")
    val poke = { s: string -> s.size }
    poke("after")
}

compile fun allowed(): int = quiet({ s: string -> s.size })
compile fun printsInBody(): int = loud()
compile fun printsBeforeLocal(): int = later()

fun main {
    println("${#allowed()} ${#printsInBody()} ${#printsBeforeLocal()}")
}
