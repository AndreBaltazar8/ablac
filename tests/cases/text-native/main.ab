// uppercase, lowercase, codePointCount and percentEncode (abla/text: run-time paths writing into one allocation or reading in place) against the loops they replaced, copied here:
// every byte value alone and in every position of strings of 0 to 40 bytes, valid and invalid UTF-8 for the count, random strings, the query flag, and the evaluator's compile-time
// answers (which use the previous code). Prints "text-native ok".
import "abla/io"
import "abla/bytes"
import "abla/text"

var failures = 0
var seed = 77

fun next(): int {
    seed = (seed * 1103515245 + 12345) & 2147483647
    (seed >> 16) & 255
}

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 30) println("FAIL $what")
    return
}

fun bytesOf(values: array<int>): string {
    val buffer = byteBuffer()
    for (value in values) buffer.appendByteValue(value)
    buffer.toText()
}

fun oldMap(text: string, from: int, to: int): string {
    val buffer = byteBuffer()
    for (i in 0 until text.size) {
        val byte = text[i]
        buffer.appendByteValue(if (byte >= from && byte < from + 26) byte - from + to else byte)
    }
    buffer.toText()
}

fun oldEncode(value: string, query: bool): string {
    val digits = "0123456789ABCDEF"
    val buffer = byteBuffer()
    for (index in 0 until value.size) {
        val byte = value[index]
        if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 || byte == 95 || byte == 126) buffer.appendByteValue(byte)
        else if (query && byte == 32) buffer.appendByteValue(43)
        else {
            buffer.appendByteValue(37)
            buffer.appendByteValue(digits[byte / 16])
            buffer.appendByteValue(digits[byte % 16])
        }
    }
    buffer.toText()
}

fun oldCount(text: string): int {
    var offset = 0
    var count = 0
    while (offset < text.size) {
        val length = utf8SequenceLength(text[offset])
        if (!utf8SequenceValid(text, offset, length)) return -1
        offset = offset + length
        count = count + 1
    }
    count
}

fun check(text: string): void {
    if (text.uppercase() != oldMap(text, 97, 65)) fail("uppercase ${text.size}")
    if (text.lowercase() != oldMap(text, 65, 97)) fail("lowercase ${text.size}")
    if (percentEncode(text) != oldEncode(text, false)) fail("percentEncode ${text.size}")
    if (percentEncode(text, true) != oldEncode(text, true)) fail("percentEncode query ${text.size}")
    if (text.codePointCount() != oldCount(text)) fail("codePointCount ${text.size}: ${text.codePointCount()} vs ${oldCount(text)}")
    return
}

fun main: int {
    for (byte in 0 until 256) check(bytesOf([byte]))
    for (length in 0 until 41) {
        for (byte in [0, 32, 37, 43, 45, 64, 65, 90, 91, 96, 97, 122, 123, 126, 127, 128, 194, 226, 240, 255]) {
            for (position in [0, 1, 7, 8, 9, 20, 39]) {
                if (position >= length) continue
                val values: array<int> = []
                for (i in 0 until length) values.append(97 + (i * 3) % 26)
                values[position] = byte
                check(bytesOf(values))
            }
        }
        val values: array<int> = []
        for (i in 0 until length) values.append(next())
        check(bytesOf(values))
    }
    val samples = ["", "Hello, World", "ünïcödé ✓ 😀", "a b+c%d", "ALL CAPS", "already lower", "mixed 123 CASE _-.~"]
    for (sample in samples) check(sample)
    for (round in 0 until 5000) {
        val values: array<int> = []
        for (i in 0 until next() % 50) {
            val kind = next() % 6
            if (kind < 3) values.append(32 + next() % 95)
            else if (kind == 3) { values.append(195); values.append(128 + next() % 64) }
            else if (kind == 4) { values.append(226); values.append(130); values.append(128 + next() % 64) }
            else values.append(next())
        }
        check(bytesOf(values))
    }
    // The evaluator's answers.
    if ("Hello ünï".uppercase() != #"Hello ünï".uppercase() || "Hello".lowercase() != #"Hello".lowercase()) fail("compile-time case")
    if (percentEncode("a b/c", true) != #percentEncode("a b/c", true)) fail("compile-time encode")
    if ("ünï".codePointCount() != #"ünï".codePointCount()) fail("compile-time count")
    if (failures > 0) return 1
    println("text-native ok")
    0
}
