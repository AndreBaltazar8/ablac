// A boxed local read only by a runtime reader may share the local's own slot; every case
// below changes the local between a load and its last use, so each must keep the old value.
class Box(var name: string)

fun reassigned(first: string, second: string): int {
    var text = first
    val before = text
    text = second
    return before.size * 100 + text.size
}

fun reassignedLoop(count: int): int {
    var text = "ab"
    var total = 0
    var round = 0
    while (round < count) {
        val before = text
        text = text + "c"
        total = total + before.size
        round = round + 1
    }
    return total * 100 + text.size
}

fun reassignedParameter(text: string, other: string): int {
    val before = text
    var mutable = text
    mutable = other
    return before.size * 100 + mutable.size
}

fun parameterStore(text: string, other: string): int {
    var local = text
    val before = local
    local = other
    return before.size * 100 + local.size
}

fun heldField(box: Box): int {
    var held = box.name
    val before = held
    held = held + "xy"
    return before.size * 100 + held.size
}

fun closureWrites(): int {
    var text = "abc"
    val before = text
    val change = { ->
        text = "abcdef"
        0
    }
    change()
    return before.size * 100 + text.size
}

fun equalAfterChange(first: string, second: string): bool {
    var text = first
    val same = text == first
    text = second
    return same && text == second
}

var shared = "abcd"

fun replaceShared(): int {
    shared = "z"
    0
}

fun readAfterGlobalChange(text: string): int {
    replaceShared()
    return text.size * 100 + shared.size
}

fun readAfterCapturedChange(text: string, var change: FnMut() -> int): int {
    change()
    return text.size
}

fun capturedByCaller(): int {
    var held = "abcde"
    val result = readAfterCapturedChange(held, { ->
        held = "q"
        0
    })
    return result * 100 + held.size
}

fun parameterClosureWrite(text: string): int {
    var local = text
    val change = { ->
        local = "abcdefgh"
        0
    }
    val before = text.size
    change()
    return before * 100 + local.size
}

fun main: int {
    if (reassigned("abc", "de") != 302) return 1
    if (reassignedLoop(3) != 905) return 2
    if (reassignedParameter("abcd", "e") != 401) return 3
    if (parameterStore("abcd", "e") != 401) return 4
    if (heldField(Box("abc")) != 305) return 5
    if (closureWrites() != 306) return 6
    if (!equalAfterChange("a", "b")) return 7
    if (readAfterGlobalChange(shared) != 401) return 8
    if (capturedByCaller() != 501) return 9
    if (parameterClosureWrite("abc") != 308) return 11
    return 42
}
