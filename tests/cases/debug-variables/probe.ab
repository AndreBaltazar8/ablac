import "abla/io"

// tools/test-debug-variables.sh stops at `return text` (line 18) and reads each variable.
class Point(val x: int, val y: int) {
    fun norm1(): int = x + y
}

fun describe(p: Point, label: string): string {
    val total = p.norm1()
    val ratio = 1.5 * 2.5
    val items = [p.x, p.y, total * 10]
    val maybe: Point? = if (total > 3) p else null
    val text = "$label=$total"
    val note: string? = null
    val table: Map<string, int> = Map()
    table.set("a", 1)
    if (note != null) println(note)
    return text
}

fun main: int {
    val p = Point(2, 3)
    val apply = { q: Point -> describe(q, "pt") }
    val out = apply(p)
    println(out)
    0
}
