import "abla/compiler/parser"

// `$word name;` is the word as written.
compile fun rawWordParse(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    val word = parserRawTakeUntil(cursor, ";")
    parserRawExpect(cursor, ";")
    syntaxString(word)
}

#compilerRegisterSubparser("word", rawWordParse)
