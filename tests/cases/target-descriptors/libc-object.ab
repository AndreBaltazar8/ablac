import "abla/build"
import "abla/unsafe/memory"

// A non-hosted target that links a C library still gets the runtime, so the
// standard library's memory module is usable; this entry allocates nothing.
trusted fun libcObjectAnswer(): int {
    ablaUnsafeStoreU8(nativePointerFromAddress(4096), 42)
    42
}

val exported = #exportFunction("libcObjectAnswer", "libc_object_answer")
