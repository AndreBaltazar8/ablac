// A program that calls LLVM's C API through abla/llvm/orc, so it links LLVM (tools/test-target-descriptors.sh): on
// aarch64-linux, which links no C library, the build stops with E_BUILD_TARGET_CAPABILITY before the link.
import "abla/io"
import "abla/llvm/orc"

fun main: int {
    println(llvmHostCpuName())
    0
}
