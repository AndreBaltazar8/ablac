import "abla/build"

val target = #defineTarget(
    "riscv64-object",
    "riscv64-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    true
)

val object = #buildProgram(
    "riscv64-object-proof",
    "tests/cases/bootstrap/block.ab",
    "build/target-descriptors-test/riscv64.o",
    "riscv64-object",
    "object",
    true,
    false
)

fun main: int = if (target && object) 43 else 1
