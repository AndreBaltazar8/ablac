import "abla/build"

val target = #defineTarget(
    "riscv64-libc-object",
    "riscv64-unknown-linux-gnu",
    "elf",
    "none",
    "none",
    false,
    false
)

val object = #buildProgram(
    "riscv64-libc-object-proof",
    "tests/cases/target-descriptors/libc-object.ab",
    "build/target-descriptors-test/riscv64-libc.o",
    "riscv64-libc-object",
    "object",
    true,
    false
)

fun main: int = if (target && object) 44 else 1
