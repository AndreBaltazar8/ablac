// Manual collection (memorySetManualCollection): allocation pressure no longer collects, but memoryCollect() does. A
// worker that allocates (so it reaches safe points all the time) must park for main's memoryCollect(). Before the fix
// a safe point returned at once when pressure collection was off, before it looked at the threshold the stop set to 0:
// the worker never parked and every explicit collection was abandoned while it ran.
import "abla/io"
import "abla/memory"
import "abla/process/time"

fun churn(rounds: int): int {
    var total = 0
    var index = 0
    while (index < rounds) {
        val text = "item-$index"
        total = total + text.size
        index += 1
    }
    total
}

fun main: int {
    // A reachable memorySetCollectionGrowth makes allocating functions safe points even in manual mode; without one a
    // manual program has none, and a stop with a running worker is abandoned (a collection never runs while it does).
    memorySetCollectionGrowth(1073741824)
    memorySetManualCollection()
    val worker = thread { churn(3000000) }
    sleep(20)
    val stoppedBefore = memoryHeapStat(7)
    val abandonedBefore = memoryHeapStat(8)
    memoryCollect()
    val stopped = memoryHeapStat(7) - stoppedBefore
    val abandoned = memoryHeapStat(8) - abandonedBefore
    await worker
    println("stopped: $stopped, abandoned: $abandoned")
    if (stopped == 1 && abandoned == 0) 42 else 1
}
