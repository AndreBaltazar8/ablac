// A manual-collection program (memorySetManualCollection) that starts threads and calls memoryCollect() keeps its safe
// points even with no memorySetCollectionGrowth or memorySetLimit: an explicit collection with a running worker parks
// it instead of being abandoned (#811). Before, such a program had no safe points at all and every stop was abandoned.
import "abla/io"
import "abla/memory"
import "abla/process/time"

fun churn(rounds: int): int {
    var total = 0
    var index = 0
    while (index < rounds) {
        val text = "item-$index"
        total = total + text.size
        index += 1
    }
    total
}

fun main: int {
    memorySetManualCollection()
    val worker = thread { churn(3000000) }
    sleep(20)
    val stoppedBefore = memoryHeapStat(7)
    val abandonedBefore = memoryHeapStat(8)
    memoryCollect()
    val stopped = memoryHeapStat(7) - stoppedBefore
    val abandoned = memoryHeapStat(8) - abandonedBefore
    val total = await worker
    println("stopped: $stopped, abandoned: $abandoned, total: $total")
    // "item-0".."item-9" are 6 bytes, "item-10".. 7, ... for 3,000,000 items.
    if (stopped == 1 && abandoned == 0 && total > 0) 42 else 1
}
