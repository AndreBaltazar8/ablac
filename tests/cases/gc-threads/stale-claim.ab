// A thread a stop claimed while it was in native state (here held by memoryDebugHold; a join is the same), then
// a stop abandoned because another thread did not park in time: the next stop, once the other thread is gone, must
// find the held thread stopped and collect. Before the fix it still holds the abandoned stop's token, counts as
// not parked, and that stop (and every later one while it stays in native state) is abandoned too.
import "abla/io"
import "abla/memory"
import "abla/process/time"

// No allocation, so no safe point: a thread that cannot park while it runs.
fun busy(rounds: int): int {
    var sum = 0
    var index = 0
    while (index < rounds) {
        sum = sum + (index ^ 3)
        index += 1
    }
    sum
}

fun holder(): int {
    memoryCollect()
    1
}

fun main: int {
    memoryDebugHold(1)
    val held = thread { holder() }
    while (memoryDebugHold(2) == 0) {}
    val spinning = thread { busy(900000000) }
    sleep(10)
    val abandonedBefore = memoryHeapStat(8)
    // Claims the held thread, then gives up on the spinning one.
    memoryCollect()
    val first = memoryHeapStat(8) - abandonedBefore
    await spinning
    // Past the backoff after an abandoned stop.
    sleep(300)
    val stoppedBefore = memoryHeapStat(7)
    memoryCollect()
    val stopped = memoryHeapStat(7) - stoppedBefore
    val later = memoryHeapStat(8) - abandonedBefore - first
    memoryDebugHold(0)
    await held
    println("first stop abandoned: $first; then stopped: $stopped, abandoned: $later")
    if (first == 1 && stopped == 1 && later == 0) 42 else 1
}
