// A thread held at a collection point (memoryDebugHold) counts as stopped, and the collection that main runs meanwhile
// marks the roots on its chain: the strings and the array the worker keeps are intact after it (#811).
import "abla/io"
import "abla/memory"

fun worker(): int {
    val words: array<string> = []
    var index = 0
    while (index < 50) {
        words.append("word-$index")
        index += 1
    }
    val keep = [10, 20, 30]
    // Held here: the first thread to reach a collection point after memoryDebugHold(1).
    memoryCollect()
    var total = keep[0] + keep[1] + keep[2]
    for (word in words) total += word.size
    total
}

fun main: int {
    memoryDebugHold(1)
    val held = thread { worker() }
    while (memoryDebugHold(2) == 0) {}
    val before = memoryHeapStat(7)
    // Garbage for the collection to free, and a collection with the worker held.
    var round = 0
    while (round < 200) {
        val garbage = "garbage-$round"
        round += if (garbage.size > 0) 1 else 1
    }
    memoryCollect()
    val stopped = memoryHeapStat(7) - before
    memoryDebugHold(0)
    val total = await held
    println("stopped=$stopped total=$total")
    // 10 + 20 + 30, plus the lengths of "word-0".."word-9" (6 bytes each) and "word-10".."word-49" (7 each): 400.
    if (stopped >= 1 && total == 400) 42 else 1
}
