// Threads that allocate while the collector runs: every thread's roots are marked, and each thread stops at a safe
// point for another's collection (stop-the-world, #811). Each worker keeps an array alive across its loop, rebuilds
// strings and arrays, and returns a checksum; the main thread allocates as well and then joins. The loops run until
// collections have stopped threads (memoryHeapStat 7), so the test does not depend on when a collection happens to land.
import "abla/io"
import "abla/memory"

fun build(seed: int, count: int): int {
    val labels: array<string> = []
    var index = 0
    while (index < count) {
        labels.append("n$seed-$index")
        index += 1
    }
    var total = 0
    for (label in labels) total += label.size
    total
}

fun worker(seed: int): int {
    val keep = [seed, seed + 1, seed + 2]
    var total = 0
    var round = 0
    // At least 60 rounds, and on a busy machine (a stop is abandoned when a thread is not scheduled for 20 ms) as many
    // more as it takes for three collections to have stopped threads: the test waits for them rather than hoping.
    while (round < 60 || (memoryHeapStat(7) < 3 && round < 4000)) {
        total += build(seed, 200 + round % 200)
        round += 1
    }
    total + keep[0] + keep[1] + keep[2]
}

fun main: int {
    val first = thread { worker(1) }
    val second = thread { worker(2) }
    val third = thread { worker(3) }
    val own = worker(4)
    val a = await first
    val b = await second
    val c = await third
    println("$a $b $c $own")
    if (a > 0 && b > 0 && c > 0 && own > 0 && memoryHeapStat(7) >= 3) 42 else 1
}
