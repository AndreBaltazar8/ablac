// Threads that allocate while the collector runs: every thread's roots are marked, and each thread stops at a safe
// point for another's collection (stop-the-world, #811). Each worker keeps an array alive across its loop, rebuilds
// strings and arrays, and returns a checksum; the main thread allocates as well and then joins.
import "abla/io"

fun build(seed: int, count: int): int {
    val labels: array<string> = []
    var index = 0
    while (index < count) {
        labels.append("n$seed-$index")
        index += 1
    }
    var total = 0
    for (label in labels) total += label.size
    total
}

fun worker(seed: int): int {
    val keep = [seed, seed + 1, seed + 2]
    var total = 0
    var round = 0
    while (round < 60) {
        total += build(seed, 200 + round)
        round += 1
    }
    total + keep[0] + keep[1] + keep[2]
}

fun main: int {
    val first = thread { worker(1) }
    val second = thread { worker(2) }
    val third = thread { worker(3) }
    val own = worker(4)
    val a = await first
    val b = await second
    val c = await third
    println("$a $b $c $own")
    if (a > 0 && b > 0 && c > 0 && own > 0) 42 else 1
}
