// Threads that enter and leave system calls all the time while another collects all the time: the handshake between
// a collection and a thread coming back from native code (#811). Each worker keeps strings alive across its calls
// and checks them after every one.
import "abla/io"
import "abla/memory"
import "abla/process/time"

fun worker(seed: int): int {
    val kept: array<string> = []
    var index = 0
    while (index < 20) {
        kept.append("kept-$seed-$index")
        index += 1
    }
    var bad = 0
    var round = 0
    while (round < 3000) {
        sleepNanoseconds(1000)
        val fresh = "fresh-$seed-$round"
        var check = 0
        while (check < kept.size) {
            if (kept[check] != "kept-$seed-$check") bad += 1
            check += 1
        }
        if (fresh != "fresh-$seed-$round") bad += 1
        round += 1
    }
    bad
}

fun main: int {
    val first = thread { worker(1) }
    val second = thread { worker(2) }
    val third = thread { worker(3) }
    var collected = 0
    while (collected < 400) {
        val garbage = "garbage-$collected"
        if (garbage.size > 0) memoryCollect()
        collected += 1
    }
    val bad = await first + await second + await third
    println("bad=$bad stopped=${memoryHeapStat(7)} abandoned=${memoryHeapStat(8)}")
    if (bad == 0) 42 else 1
}
