// A thread blocked in a system call (a sleep) counts as stopped: another thread's collections run meanwhile, with no
// stop abandoned, and the blocked thread's live values survive them (#811).
import "abla/io"
import "abla/memory"
import "abla/process/time"

fun sleeper(): int {
    val words: array<string> = []
    var index = 0
    while (index < 40) {
        words.append("word-$index")
        index += 1
    }
    // Blocked here, in the system call, while main collects.
    sleep(1500)
    var total = 0
    for (word in words) total += word.size
    total
}

fun main: int {
    val blocked = thread { sleeper() }
    sleep(200)
    val abandonedBefore = memoryHeapStat(8)
    val stoppedBefore = memoryHeapStat(7)
    var round = 0
    while (round < 20) {
        val garbage = "garbage-$round-" + "x"
        if (garbage.size > 0) memoryCollect()
        round += 1
    }
    val abandoned = memoryHeapStat(8) - abandonedBefore
    val stopped = memoryHeapStat(7) - stoppedBefore
    val total = await blocked
    println("stopped=$stopped abandoned=$abandoned total=$total")
    // "word-0".."word-9" are 6 bytes, "word-10".."word-39" 7: 60 + 210.
    if (total == 270 && abandoned == 0 && stopped >= 20) 42 else 1
}
