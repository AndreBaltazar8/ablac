// More shapes: a closure reaching itself through its captured variable, a
// consuming closure, closures inside containers.
resource class Ticket(val value: int)

class Slot(val pin: int, val label: string)

class Bag(val handlers: array<(int) -> int>)

compile fun stagedFactorial(): (int) -> int {
    var fact: (int) -> int = { x: int -> x }
    fact = { x: int -> if (x <= 1) 1 else x * fact(x - 1) }
    fact
}

compile fun stagedOnce(): FnOnce() -> int {
    val ticket = Ticket(41)
    move { -> ticket.value + 1 }
}

compile fun stagedSlot(): Slot = Slot(7, "seven")

compile fun stagedBag(): Bag {
    val offset = 2
    Bag([{ x: int -> x + offset }, { x: int -> x * offset }])
}

fun finish(own callback: FnOnce() -> int): int = callback()

val FACTORIAL = #stagedFactorial()
val SLOT = #stagedSlot()
val BAG = #stagedBag()

fun main: int {
    val once = #stagedOnce()
    val first = BAG.handlers[0]
    val second = BAG.handlers[1]
    val ok = FACTORIAL(5) == 120 && finish(move(once)) == 42 &&
        SLOT.pin + 1 == 8 && SLOT.label == "seven" &&
        first(40) == 42 && second(21) == 42
    if (ok) 42 else 1
}
