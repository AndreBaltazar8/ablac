// A compile val keeps its whole value between evaluations: a cycle stays a
// cycle, a shared object stays shared, and a kept closure keeps its captures.
class Node(val value: int, var next: Node?)
class Pair(val left: Node, val right: Node)

compile fun stagedRing(): Pair {
    val first = Node(1, null)
    val second = Node(2, first)
    first.next = second
    Pair(first, first)
}

compile fun stagedCounter(): () -> int {
    val base = Node(40, null)
    { -> base.value + 2 }
}

compile val ring: Pair = stagedRing()
compile val counter: () -> int = stagedCounter()

compile fun stagedStep(): int {
    val next = ring.left.next
    var value = 0
    if (next != null) value = next.value
    ring.right.next = Node(value * 10, ring.left)
    value
}

compile fun stagedAfter(): int {
    val next = ring.left.next
    var value = 0
    if (next != null) {
        val back = next.next
        if (back != null && back == ring.right) value = next.value
    }
    value + counter()
}

val FIRST = #stagedStep()
val SECOND = #stagedAfter()

fun main: int = if (FIRST == 2 && SECOND == 62) 42 else 1
