// Positional native captures must become named, typed codec bindings without
// losing a shared object reached both from the result and from a closure.
import "abla/float"
class CodecNode(var number: int)
class CodecGraph(val node: CodecNode, val read: () -> int)
compile fun stagedCodecGraph(): CodecGraph {
    val node = CodecNode(7)
    CodecGraph(node, { -> node.number })
}
compile fun stagedCodecScalars(): () -> int {
    val small: i8 = i8(-128)
    val unsigned: u32 = u32(4294967295)
    val narrow = ablaBitI32ToF32(2143289345)
    val wide = f64FromBits(-9223372036854775808)
    val erased: any = 1.5
    val dense: array<f64> = [f64FromBits(1), 2.25]
    { -> if (int(small) == -128 && int(unsigned) == 4294967295 &&
        ablaBitF32ToI32(narrow) == 2143289345 &&
        f64ToBits(wide) == -9223372036854775808 &&
        erased == 4609434218613702656 && f64ToBits(dense[0]) == 1 &&
        dense[1] == 2.25) 42 else 1 }
}
val GRAPH = #stagedCodecGraph()
val SCALARS = #stagedCodecScalars()
fun main: int {
    GRAPH.node.number = 42
    val read = GRAPH.read
    if (read() == 42 && SCALARS() == 42) 42 else 1
}
