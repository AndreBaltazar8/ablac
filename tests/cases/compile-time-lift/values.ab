// Compile-time results of every data type become equal program values:
// shared objects stay shared, cycles stay cycles.
import "abla/float"

class Node(val value: int, var next: Node?)
class Pair(val left: Node, val right: Node)
class Sample(val narrow: i32, val small: u8, val single: f32, val wide: f64)

compile fun stagedCycle(): Node {
    val first = Node(1, null)
    val second = Node(2, first)
    first.next = second
    first
}

compile fun stagedShared(): Pair {
    val node = Node(5, null)
    Pair(node, node)
}

compile fun stagedMap(): Map<string, array<int>> {
    val map: Map<string, array<int>> = Map()
    map.set("a", [1, 2])
    map.set("b", [])
    map
}

compile fun stagedCell(): Cell<int> = Cell(9)
compile fun stagedNullable(): Node? = null
compile fun stagedSingle(): f32 = f64ToF32(0.1)
compile fun stagedSingles(): array<f32> = [f64ToF32(1.5), f64ToF32(-0.25)]
compile fun stagedNaNs(): array<f64> =
    [f64FromBits(9218868437227405313), f64FromBits(-2251799813685248),
     f64FromBits(-4503599627370496)]
compile fun stagedSingleNaN(): f32 = ablaBitI32ToF32(2143289345)
compile fun stagedSample(): Sample = Sample(-5, 200, f64ToF32(0.5), 0.25)

val CYCLE = #stagedCycle()
val SHARED = #stagedShared()
val MAP = #stagedMap()
val CELL = #stagedCell()
val NOTHING = #stagedNullable()
val SINGLE = #stagedSingle()
val SINGLES = #stagedSingles()
val SAMPLE = #stagedSample()
val NANS = #stagedNaNs()
val SINGLE_NAN = #stagedSingleNaN()

fun main: int {
    SHARED.left.next = CYCLE
    val second = CYCLE.next
    var cycles = false
    if (second != null) cycles = second.value == 2 && second.next == CYCLE
    val shared = SHARED.right.next == CYCLE
    val listed = MAP.get("a")
    var mapped = MAP.size == 2
    if (listed != null) mapped = mapped && listed[1] == 2
    val ok = cycles && shared && mapped && CELL.get() == 9 &&
        NOTHING == null && SINGLE == f64ToF32(0.1) &&
        SINGLES[0] == f64ToF32(1.5) && SINGLES[1] == f64ToF32(-0.25) &&
        i64(SAMPLE.narrow) == -5 && i64(SAMPLE.small) == 200 &&
        SAMPLE.single == f64ToF32(0.5) && SAMPLE.wide == 0.25 &&
        f64ToBits(NANS[0]) == 9218868437227405313 &&
        f64ToBits(NANS[1]) == -2251799813685248 &&
        f64ToBits(NANS[2]) == -4503599627370496 &&
        ablaBitF32ToI32(SINGLE_NAN) == 2143289345
    if (ok) 42 else 1
}
