// Closures made at compile time become program functions: each keeps its
// captured values, and closures sharing a captured variable keep sharing it.
class Counter(var count: int)

class Adders(val add: (int) -> int, val twice: (int) -> int)

class Twin(val bump: FnMut() -> int, val read: () -> int)

fun advance(var callback: FnMut() -> int): int = callback()

fun readNow(callback: () -> int): int = callback()

compile fun stagedAdder(k: int): (int) -> int = { x: int -> x + k }

compile fun stagedPair(): Twin {
    var shared = 10
    val bump = { -> shared = shared + 1
        shared }
    val read = { -> shared }
    Twin(move(bump), read)
}

compile fun stagedCounter(): FnMut() -> int {
    val counter = Counter(0)
    { -> counter.count = counter.count + 1
        counter.count }
}

compile fun stagedNested(): (int) -> int {
    val base = 3
    val inner = { y: int -> y * base }
    { x: int -> inner(x) + 1 }
}

compile fun stagedAdders(): Adders {
    val add = stagedAdder(5)
    Adders(add, { x: int -> add(add(x)) - x })
}

fun double(x: int): int = x * 2

class Box(val value: int) {
    fun reader(): () -> int = { -> value + this.value }
}

compile fun stagedReader(): () -> int = Box(21).reader()

compile fun stagedReference(): (int) -> int = double

val ADD = #stagedAdder(4)
val NESTED = #stagedNested()
val ADDERS = #stagedAdders()
val REFERENCE = #stagedReference()
val READER = #stagedReader()
val INLINE = #{
    val offset = 7
    { x: int -> x - offset }
}

fun main: int {
    var pair = #stagedPair()
    val bumped = advance(pair.bump)
    val bumpedAgain = advance(pair.bump)
    var counter = #stagedCounter()
    val counted = advance(counter) + advance(counter)
    val add = ADDERS.add
    val twice = ADDERS.twice
    val inline = INLINE()
    val ok = ADD(1) == 5 && bumped == 11 && bumpedAgain == 12 &&
        readNow(pair.read) == 12 && counted == 3 && NESTED(4) == 13 &&
        add(1) == 6 && twice(1) == 10 && REFERENCE(21) == 42 &&
        inline(49) == 42 && READER() == 42
    if (ok) 42 else 1
}
