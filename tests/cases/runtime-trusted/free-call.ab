// Ordinary code frees a live array's storage through the runtime's own free, then the next array reuses it: the runtime's
// functions are trusted-only outside the standard library (#191), so this is native.trust and does not build.
import "abla/io"

fun main {
    val words: array<int> = []
    for (k in 0 until 4096) words.append(7)
    val last = __ablaRuntimeHostRegistryLast()
    __ablaRuntimePlatformFree(last)
    val other: array<int> = []
    for (k in 0 until 4096) other.append(9)
    var changed = 0
    for (w in words) if (w != 7) changed = changed + 1
    println("changed $changed")
}
