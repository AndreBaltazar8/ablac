// The same functions inside trusted functions: accepted, as the compiler's own sources use abla/runtime/memory.
import "abla/runtime/memory"
import "abla/io"

trusted fun liveBytes(): int = runtimeMemoryLiveBytes()
trusted fun checkpoint(): int = __ablaRuntimePlatformMemoryCheckpoint()

fun main {
    println("live ${liveBytes() >= 0} checkpoint ${checkpoint() != 0}")
}
