// abla/runtime/memory's checkpoint and reset free every allocation made after the checkpoint, live ones too: from ordinary code
// they are native.trust, though the module is imported.
import "abla/runtime/memory"
import "abla/io"

fun main {
    val checkpoint = runtimeMemoryCheckpoint()
    val words: array<int> = []
    for (k in 0 until 4096) words.append(7)
    runtimeMemoryReset(checkpoint)
    println("words ${words.size}")
}
