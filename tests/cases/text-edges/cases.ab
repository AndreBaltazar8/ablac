// Table-driven text edge cases: UTF-8 boundaries in slice/index/size, comparison order by byte, search, split, join,
// replace, trim, ASCII-only case mapping, repeat/pad, code points, validity, map keys, sorting. tools/test-text-edges.sh
// runs them as ordinary code and under `#`, and as WebAssembly.
import "abla/io"
import "abla/text"

@noinline fun idS(x: string): string = x
@noinline fun idI(x: int): int = x

fun q(s: string): string {
    // a printable form that shows every byte
    var out = "<"
    for (b in s) out = out + "${b},"
    out + ">"
}
fun sn(v: int?): string = if (v == null) "null" else "${v}"
fun parts(xs: array<string>): string {
    var out = "["
    for (x in xs) out = out + q(x)
    out + "]"
}

fun cases(): array<string> {
    val out: array<string> = []
    val e = idS("")
    val a = idS("abc")
    val u = idS("héllo")          // é = 195 169
    val cjk = idS("日本語")        // 9 bytes
    val emoji = idS("a😀b")       // 😀 = 4 bytes
    val nul = idS("a\0b")
    val noParts: array<string> = []
    val high = idS("\xff\xfe")    // not valid UTF-8
    // size, index, slice
    out.append("size ${e.size} ${a.size} ${u.size} ${cjk.size} ${emoji.size} ${nul.size} ${high.size}")
    out.append("index ${u[1]} ${u[2]} ${cjk[0]} ${high[0]} ${nul[1]}")
    out.append("slice mid-char ${q(u.slice(1, 2))} ${q(u.slice(2, 3))} ${q(u.slice(1, 3))}")
    out.append("slice full ${q(a.slice(0, 3))} empty ${q(a.slice(3, 3))} ${q(a.slice(0, 0))} ${q(e.slice(0, 0))}")
    out.append("slice emoji ${q(emoji.slice(1, 5))} ${q(emoji.slice(1, 3))}")
    // comparisons: byte order, high bytes sort after ASCII
    out.append("cmp ${"a" < "b"} ${"é" > "z"} ${"é" < "z"} ${"\xff" > "z"} ${"\x80" > "\x7f"} ${"" < "a"} ${"" == ""} ${"a" < "a\0"}")
    out.append("cmp2 ${idS("é") > idS("z")} ${idS("\xff") > idS("\x01")} ${idS("a\0b") < idS("a\0c")} ${idS("a\0b") == idS("a\0b")} ${idS("a\0b") == idS("a")}")
    out.append("cmp3 ${idS("日") > idS("é")} ${idS("😀") > idS("日")} ${idS("a") <= idS("a")} ${idS("b") >= idS("a")} ${idS("ab") < idS("b")}")
    out.append("eq ${idS("é") == idS("é")} ${idS("é") != idS("e")} ${idS("e\xcc\x81") == idS("é")}")
    // startsWith / endsWith / contains / indexOf / lastIndexOf
    out.append("starts ${a.startsWith("")} ${a.startsWith("ab")} ${a.startsWith("abcd")} ${e.startsWith("")} ${e.startsWith("a")} ${u.startsWith("hé")}")
    out.append("ends ${a.endsWith("")} ${a.endsWith("bc")} ${a.endsWith("xabc")} ${e.endsWith("")} ${u.endsWith("llo")} ${u.endsWith("\xa9llo")}")
    out.append("contains ${a.contains("")} ${e.contains("")} ${e.contains("a")} ${a.contains("c")} ${a.contains("abcd")} ${u.contains("\xa9")} ${u.contains("é")}")
    out.append("indexOf ${a.indexOf("")} ${a.indexOf("c")} ${a.indexOf("d")} ${e.indexOf("")} ${e.indexOf("a")} ${u.indexOf("l")} ${u.indexOf("\xa9")}")
    out.append("indexOf from ${a.indexOf("", 3)} ${a.indexOf("", 4)} ${a.indexOf("a", -5)} ${a.indexOf("c", 2)} ${a.indexOf("c", 3)} ${a.indexOf("a", 1)} ${a.indexOf("", -1)}")
    out.append("lastIndexOf ${a.lastIndexOf("")} ${a.lastIndexOf("c")} ${a.lastIndexOf("a")} ${a.lastIndexOf("abcd")} ${e.lastIndexOf("")} ${e.lastIndexOf("a")} ${idS("abab").lastIndexOf("ab")} ${idS("aaa").lastIndexOf("aa")}")
    out.append("overlap ${idS("aaaa").indexOf("aa", 1)} ${idS("aaaa").replace("aa", "b")} ${idS("aaa").replace("aa", "b")} ${parts(idS("aaaa").split("aa"))} ${parts(idS("aaa").split("aa"))}")
    // split
    out.append("split ${parts(idS("a,b,c").split(","))} ${parts(idS("").split(","))} ${parts(idS(",").split(","))} ${parts(idS(",,").split(","))}")
    out.append("split2 ${parts(idS("abc").split(""))} ${parts(idS("abc").split("abc"))} ${parts(idS("abc").split("abcd"))} ${parts(idS("").split(""))}")
    out.append("split3 ${parts(idS("a,b,").split(","))} ${parts(idS(",a").split(","))} ${parts(idS("a, b").split(", "))} ${parts(idS("a,,b").split(","))}")
    out.append("split utf8 ${parts(idS("日,本,語").split(","))} ${parts(idS("日本語").split("本"))} ${parts(idS("日本語").split("\x97"))} ${parts(idS("a😀b😀c").split("😀"))}")
    out.append("split nul ${parts(idS("a\0b\0c").split("\0"))}")
    // join
    out.append("join ${q(["a", "b", "c"].join(","))} ${q(["a"].join(","))} ${q(noParts.join(","))} ${q(["", ""].join(","))} ${q(["a", "b"].join())} ${q(["日", "本"].join("😀"))}")
    // replace
    out.append("replace ${q(idS("abcabc").replace("b", "X"))} ${q(idS("abcabc").replace("b", ""))} ${q(idS("abcabc").replace("", "X"))} ${q(idS("").replace("a", "X"))} ${q(idS("").replace("", "X"))}")
    out.append("replace2 ${q(idS("aaa").replace("a", "aa"))} ${q(idS("abc").replace("abc", "abc"))} ${q(idS("abc").replace("abcd", "X"))} ${q(idS("ab").replace("ab", ""))} ${q(idS("a.b.c").replace(".", "::"))}")
    out.append("replace utf8 ${q(idS("日本語").replace("本", "x"))} ${q(idS("日本語").replace("\x97", "x"))} ${q(idS("héllo").replace("é", "e"))} ${q(idS("a😀b").replace("😀", ""))}")
    // trim
    out.append("trim ${q(idS("  a  ").trim())} ${q(idS("").trim())} ${q(idS("   ").trim())} ${q(idS("\t\n\r\x0b\x0c a \t\n\r\x0b\x0c").trim())} ${q(idS("a").trim())} ${q(idS(" a b ").trim())}")
    out.append("trimStart ${q(idS("  a  ").trimStart())} ${q(idS("   ").trimStart())} ${q(idS("").trimStart())} trimEnd ${q(idS("  a  ").trimEnd())} ${q(idS("   ").trimEnd())} ${q(idS("").trimEnd())}")
    out.append("trim non-ascii space ${q(idS("\xc2\xa0a\xc2\xa0").trim())} ${q(idS("\xe3\x80\x80a").trim())} ${q(idS("\0a\0").trim())} ${q(idS("\x1fa\x1f").trim())} ${q(idS("\x85a").trim())}")
    // case
    out.append("case ${q(idS("aZ09-_ z").uppercase())} ${q(idS("aZ09-_ z").lowercase())} ${q(idS("").uppercase())} ${q(idS("é").uppercase())} ${q(idS("É").lowercase())} ${q(idS("ß").uppercase())}")
    out.append("case2 ${q(idS("\xe0\xc0\xff").uppercase())} ${q(idS("@[`{").uppercase())} ${q(idS("@[`{").lowercase())} ${q(idS("AZaz").uppercase())} ${q(idS("AZaz").lowercase())}")
    // repeat / pad
    out.append("repeat ${q(idS("ab").repeat(3))} ${q(idS("ab").repeat(0))} ${q(idS("ab").repeat(1))} ${q(idS("").repeat(5))} ${q(idS("ab").repeat(-1))} ${q(idS("é").repeat(2))}")
    out.append("pad ${q(idS("ab").padStart(5))} ${q(idS("ab").padEnd(5))} ${q(idS("ab").padStart(5, "xy"))} ${q(idS("ab").padEnd(5, "xy"))} ${q(idS("abc").padStart(2))} ${q(idS("").padStart(3, "é"))} ${q(idS("ab").padStart(-1))}")
    out.append("pad2 ${q(idS("ab").padStart(5, ""))} ${q(idS("ab").padStart(6, "日"))} ${q(idS("ab").padEnd(4, "日"))} ${q(idS("ab").padStart(2, "x"))}")
    // code points
    out.append("cpcount ${e.codePointCount()} ${a.codePointCount()} ${u.codePointCount()} ${cjk.codePointCount()} ${emoji.codePointCount()} ${high.codePointCount()} ${nul.codePointCount()}")
    out.append("cpat ${u.codePointAt(0)} ${u.codePointAt(1)} ${u.codePointAt(4)} ${u.codePointAt(5)} ${u.codePointAt(-1)} ${emoji.codePointAt(1)} ${emoji.codePointAt(2)} ${cjk.codePointAt(2)} ${high.codePointAt(0)} ${e.codePointAt(0)}")
    out.append("cpslice ${q(u.codePointSlice(1, 2))} ${q(u.codePointSlice(0, 5))} ${q(u.codePointSlice(2, 1))} ${q(u.codePointSlice(0, 6))} ${q(u.codePointSlice(-1, 2))} ${q(emoji.codePointSlice(1, 2))} ${q(e.codePointSlice(0, 0))}")
    out.append("valid ${e.isValidUtf8()} ${a.isValidUtf8()} ${u.isValidUtf8()} ${emoji.isValidUtf8()} ${high.isValidUtf8()} ${idS("\xc0\x80").isValidUtf8()} ${idS("\xed\xa0\x80").isValidUtf8()} ${idS("\xf4\x90\x80\x80").isValidUtf8()} ${idS("\xe2\x82").isValidUtf8()} ${nul.isValidUtf8()} ${idS("\xef\xbf\xbf").isValidUtf8()} ${idS("\xf4\x8f\xbf\xbf").isValidUtf8()}")
    // interpolation and concatenation with odd text
    out.append("concat ${q(idS("a") + idS(""))} ${q(idS("") + idS(""))} ${q(idS("é") + idS("\xa9"))} ${q(idS("a\0") + idS("\0b"))} ${(idS("a") + idS("b")).size}")
    out.append("interp ${q("${idS("é")}${idS("\0")}${idS("")}x")} ${"${1}${2}".size} ${"$e|".size}")
    // string as map key and in arrays
    val m: Map<string, int> = Map()
    m.set(idS("a\0b"), 1)
    m.set(idS("a\0c"), 2)
    m.set(idS("é"), 3)
    m.set(idS(""), 4)
    m.set(idS("\xc3"), 5)
    out.append("map ${sn(m.get("a\0b"))} ${sn(m.get("a\0c"))} ${sn(m.get("a"))} ${sn(m.get("é"))} ${sn(m.get(""))} ${sn(m.get("\xc3"))} ${sn(m.get("\xa9"))} ${m.size}")
    out.append("sorted ${parts(sortedStrings(["b", "é", "a", "", "Z", "日", "a\0", "aa", "z"]))}")
    out.append("sorted2 ${parts(sortedStrings(["\xff", "\x80", "\x7f", "😀", "日", "é"]))}")
    return out
}

