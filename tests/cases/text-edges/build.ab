import "abla/wasm/build"

val release = #wasmBuildModule(
    "text",
    "tests/cases/text-edges/module.ab",
    "build/text-edges/text.wasm",
    false,
    false
)
val development = #buildProgram(
    "text-dev",
    "tests/cases/text-edges/module.ab",
    "build/text-edges/text-dev.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && development) 0 else 1
