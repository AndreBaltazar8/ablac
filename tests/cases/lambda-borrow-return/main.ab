class Row(var n: int)
val stored = Row(9)
val copy: (Row) -> Row = { row: Row -> Row(row.n) }
val staticRow: (Row) -> Row = { row: Row -> stored }
val scalar: (int) -> int = { n: int -> n }
val text: (string) -> string = { s: string -> s }
fun main: int {
    val row = Row(3)
    if (copy(row).n == 3 && staticRow(row).n == 9 && scalar(2) == 2 && text("ok") == "ok") 0 else 1
}
