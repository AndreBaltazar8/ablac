import "abla/io"
import "abla/http"
import "abla/sysroot-path-fixture"

// Lambdas after private names in two standard-library modules (abla/http's
// IPv4 transport and the fixture), and in this one.
private val programBase = 1

fun main: int {
    val client = httpIpv4Client("example.test", "127.0.0.1", 80)
    val local = fixtureApply({ value -> value + programBase }, 0)
    println("${fixtureTotal()} $local ${client.authority}")
    42
}
