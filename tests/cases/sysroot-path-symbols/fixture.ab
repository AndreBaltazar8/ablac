// Copied into each test sysroot as abla/sysroot-path-fixture: a library
// module with private names and lambdas after them, whose rewritten source
// spells the module's path.
private val fixtureBase = 40
private fun fixtureAdd(value: int): int = value + fixtureBase

fun fixtureApply(function: (int) -> int, value: int): int = function(value)

fun fixtureTotal(): int =
    fixtureApply({ value -> fixtureAdd(value) }, 2) +
    fixtureApply({ value -> value * fixtureBase }, 0)
