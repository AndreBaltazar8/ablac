// AArch64 and RISC-V Linux objects: no such executable target exists, so tools/test-uint256.sh
// links them with a startup and C stubs of its own to run under qemu.
import "abla/build"
import "abla/compiler"

#compilerGrant("filesystem.write")

compile fun uint256Object(name: string, triple: string): bool {
    val target = defineTarget(name, triple, "elf", "none", "none", false, false)
    target && buildProgram(
        "uint256-$name", "build/uint256/src/object.ab", "build/uint256/$name.o", name, "object", false, false
    )
}

val aarch64 = #uint256Object("aarch64", "aarch64-unknown-linux-gnu")
val riscv64 = #uint256Object("riscv64", "riscv64-unknown-linux-gnu")

fun main: int = if (aarch64 && riscv64) 0 else 1
