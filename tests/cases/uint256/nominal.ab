// `type Wei = uint256` is a uint256 by another name, in a local, a field, an array and an `if`.
import "abla/uint256"
type Wei = uint256
class Bill(val owed: Wei)
fun plain(amount: Wei): uint256 = amount
fun fee(amount: Wei): Wei = Wei(plain(amount) / uint256(100))
fun pick(c: bool, a: Wei, b: Wei): Wei = if (c) a else b
fun main: int {
    val a = Wei(uint256(1000000))
    val b = fee(a)
    val bill = Bill(b)
    val held: array<Wei> = [a, b]
    val owed: uint256 = bill.owed
    if (owed != uint256(10000)) return 1
    if (plain(held[0]) != uint256(1000000)) return 2
    if ("$a" != "1000000") return 3
    if (plain(pick(false, a, b)) != uint256(10000)) return 4
    0
}
