// What `#` gives is what the same code gives at run time, down to the byte.
import "abla/io"
import "abla/uint256"

type Wei = uint256

compile fun compiled(): string = table()
fun computed(): string = table()

fun table(): string {
    val edge: array<uint256> = [
        uint256(0), uint256(1), uint256(-1), uint256(255), uint256(1) << 64, (uint256(1) << 128) - uint256(1),
        uint256Max(), uint256Words(u32(4294967295), u32(0), u32(305419896), u32(1), u32(2147483648), u32(7), u32(65536), u32(9))
    ]
    var out = ""
    for (a in edge) {
        out = "$out$a ${a.toHex()} ${a.bitLength()} ${a.toU64()} ${a.isZero()} ${~a} ${-a} ${a << 13} ${a >> 200} ${a.shl(uint256(255))}\n"
        for (b in edge) {
            out = "$out${a + b} ${a - b} ${a * b} ${a & b} ${a | b} ${a ^ b} ${a == b} ${a != b} ${a < b} ${a <= b} ${a > b} ${a >= b}"
            if (!b.isZero()) out = "$out ${a / b} ${a % b}"
            val added = a.addChecked(b)
            out = "$out ${if (added == null) "over" else "$added"}\n"
        }
    }
    val parsed = uint256FromDecimal("115792089237316195423570985008687907853269984665640564039457584007913129639935")
    "$out${parsed == uint256Max()} ${uint256FromBytes(uint256(258).toBytes()) == uint256(258)}\n"
}

compile fun wei(): Wei = Wei(uint256(1) << 100)
val atCompileTime = #compiled()
val lifted = #(uint256Max() - uint256(5))
val several = #[uint256(1), uint256(1) << 255]
val maybe: uint256? = #uint256Max().addChecked(uint256(0))
val named = #wei()

fun main: int {
    if (atCompileTime != computed()) {
        println(atCompileTime)
        println(computed())
        return 1
    }
    if (lifted != uint256Max() - uint256(5)) return 2
    if (several[1] != uint256(1) << 255) return 3
    if (maybe == null || maybe != uint256Max()) return 4
    val plain: uint256 = named
    if (plain != uint256(1) << 100) return 5
    0
}
