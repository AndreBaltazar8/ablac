// abla/uint256 against tools/uint256/gen-cases.py, whose answers are Python's: the number of the
// first line that disagrees, or 0. `_` in a case's text stands for a space, and alone for nothing.
import "abla/uint256"
import "abla/ct"
import "abla/simd"

fun word(text: string): uint256 {
    val value = uint256FromHex(text)
    if (value == null) return uint256(0) - uint256(1)
    value
}
fun text(value: uint256?): string = if (value == null) "n" else value.toHex().slice(2, value.toHex().size)
fun low(value: uint256): string = value.toHex().slice(2, value.toHex().size)
fun yes(value: bool): string = if (value) "1" else "0"
fun spaced(value: string): string {
    if (value == "_") return ""
    var out = ""
    for (at in 0 until value.size) {
        val c = value[at]
        out = if (int(c) == 95) "$out " else "$out${char(int(c))}"
    }
    out
}
fun nibble(c: int): int = if (c <= 57) c - 48 else c - 87
fun decoded(hex: string): string {
    var out = ""
    var at = 0
    while (at < hex.size) {
        out = "$out${char(nibble(int(hex[at])) * 16 + nibble(int(hex[at + 1])))}"
        at = at + 2
    }
    out
}
fun encoded(bytes: string): string {
    val digits = "0123456789abcdef"
    var out = ""
    for (at in 0 until bytes.size) {
        val byte = int(bytes[at])
        out = "$out${char(int(digits[byte >> 4]))}${char(int(digits[byte & 15]))}"
    }
    out
}

fun answer(operation: string, x: string, y: string): string {
    if (operation == "decp") return text(uint256FromDecimal(spaced(x)))
    if (operation == "hexp") return text(uint256FromHex(spaced(x)))
    if (operation == "bytesp") return text(uint256FromBytes(decoded(x)))
    val a = word(x)
    val b = word(y)
    when (operation) {
        "add" -> return low(a + b)
        "sub" -> return low(a - b)
        "mul" -> return low(a * b)
        "div" -> return low(a / b)
        "rem" -> return low(a % b)
        "and" -> return low(a & b)
        "or" -> return low(a | b)
        "xor" -> return low(a ^ b)
        "not" -> return low(~a)
        "neg" -> return low(-a)
        "lt" -> return yes(a < b)
        "le" -> return yes(a <= b)
        "gt" -> return yes(a > b)
        "ge" -> return yes(a >= b)
        "eq" -> return yes(a == b)
        "ne" -> return yes(a != b)
        "addc" -> return text(a.addChecked(b))
        "subc" -> return text(a.subChecked(b))
        "mulc" -> return text(a.mulChecked(b))
        "shl" -> return low(a << b.toInt())
        "shr" -> return low(a >> b.toInt())
        "shlw" -> return low(a.shl(b))
        "shrw" -> return low(a.shr(b))
        "dec" -> return a.toDecimal()
        "hexs" -> return a.toHex()
        "bytes" -> return encoded(a.toBytes())
        "bits" -> return low(uint256(a.bitLength())).toDecimalFromHex()
        "bit" -> return yes(a.bit(b.toInt()))
        "u64" -> return low(uint256(a.toU64()))
        "u32" -> return low(uint256(a.toU32()))
        "u16" -> return low(uint256(a.toU16()))
        "u8" -> return low(uint256(a.toU8()))
        "sext" -> return low(uint256(a.toInt()))
        "zext" -> return low(uint256(a.toU64()))
        "u64n" -> {
            val narrow = a.toU64OrNull()
            return if (narrow == null) "n" else low(uint256(narrow))
        }
        "intn" -> {
            val narrow = a.toIntOrNull()
            return if (narrow == null) "n" else low(uint256(narrow))
        }
        "u32n" -> {
            val narrow = a.toU32OrNull()
            return if (narrow == null) "n" else low(uint256(narrow))
        }
        "u16n" -> {
            val narrow = a.toU16OrNull()
            return if (narrow == null) "n" else low(uint256(narrow))
        }
        "u8n" -> {
            val narrow = a.toU8OrNull()
            return if (narrow == null) "n" else low(uint256(narrow))
        }
        else -> return "?"
    }
}
fun string.toDecimalFromHex(): string = word(this).toDecimal()

fun uint256Checks(cases: string): int {
    var line = 0
    var begin = 0
    val fields = ["", "", "", ""]
    var field = 0
    for (at in 0 until cases.size) {
        val c = int(cases[at])
        if (c == 32 || c == 10) {
            fields[field] = cases.slice(begin, at)
            begin = at + 1
            field = field + 1
        }
        if (c == 10) {
            line = line + 1
            field = 0
            if (answer(fields[0], fields[1], fields[2]) != fields[3]) return line
        }
    }
    uint256LanguageChecks()
}

// What Python has no opinion on: how the language carries a uint256.
class Holder(val value: uint256, var other: uint256 = uint256(9))
val SHARED = uint256(7)
var COUNTER = uint256(0)
fun defaulted(a: uint256 = uint256(5)): uint256 = a
fun maybe(flag: bool): uint256? = if (flag) SHARED else null
fun viaWhen(k: int): uint256 = when (k) {
    0 -> SHARED
    else -> uint256(9)
}
fun takesFn(f: (uint256) -> uint256): uint256 = f(SHARED)
fun <T> same(value: T): T = value
fun uint256LanguageChecks(): int {
    COUNTER = COUNTER + SHARED
    COUNTER += SHARED
    if (COUNTER != uint256(14)) return -1
    if (defaulted() != uint256(5) || defaulted(SHARED) != SHARED) return -2
    val m = maybe(true)
    if (m == null || m != SHARED) return -3
    if (maybe(false) != null) return -4
    if (viaWhen(0) != SHARED || viaWhen(1) != uint256(9)) return -5
    if (takesFn({ x: uint256 -> x + x }) != uint256(14)) return -6
    val map = Map<string, uint256>()
    map.set("k", SHARED)
    val found = map.get("k")
    if (found == null || found != SHARED) return -7
    val holder = Holder(uint256Max())
    holder.other = holder.value - uint256(1)
    if (holder.value <= holder.other) return -8
    val list = [uint256(1), uint256Max()]
    list.append(list[0] + list[1])
    if (!list[2].isZero()) return -9
    if (same(SHARED) != SHARED) return -10
    if ("${uint256(1) << 64} $SHARED" != "18446744073709551616 7") return -11
    var i = uint256(0)
    var steps = 0
    while (i < uint256(10)) {
        i += uint256(3)
        steps = steps + 1
    }
    if (steps != 4) return -12
    if (uint256OrNull(-1) != null || uint256OrNull(3) != uint256(3)) return -14
    if (uint256(i8(-1)) != uint256Max() || uint256(u8(255)) != uint256(255)) return -15
    if (uint256(i32(-2)) != uint256Max() - uint256(1) || uint256(u32(4294967295)) != uint256(4294967295)) return -16
    if (uint256Words(u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(1), u32(2)) != uint256(4294967298)) return -17
    if ((uint256(1) << -1) != uint256(0) || (uint256(1) >> -1) != uint256(0)) return -18
    if ((uint256(1) << u8(4)) != uint256(16) || (uint256(16) >> u32(4)) != uint256(1)) return -19
    0
}
