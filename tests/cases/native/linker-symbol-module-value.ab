import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

val linkerBoundary =
    nativeLinkerSymbolAddress("abla_test_linker_boundary")
val linkerBoundary32 =
    u32(nativeLinkerSymbolAddress("abla_test_linker_boundary_32"))

fun main: int =
    if (linkerBoundary != 0 && linkerBoundary32 != u32(0)) 0 else 1
