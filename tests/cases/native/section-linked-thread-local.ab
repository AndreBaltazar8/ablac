import "abla/unsafe/memory"
import "abla/unsafe/native"

@section(".text.abla_test_callback")
fun sectionWordTarget(value: int): int = value + 1

val sectionBytes = nativeInternalSectionBytes(
    "ABCD",
    "abla_test_internal_section_bytes",
    ".rodata.abla_test",
    4
)

val sectionWords = nativeInternalSectionU32s(
    [nativeFunctionAddress(sectionWordTarget), 65538],
    "abla_test_internal_section_words",
    ".abla_registry.123"
)

val sharedTls = nativeSectionLinkedThreadLocalAllocate(
    4,
    "abla_test_section_tls",
    ".tdata.abla_test",
    4
)

val localTls = nativeInternalSectionThreadLocalAllocate(
    4,
    "abla_test_internal_section_tls",
    ".tbss.abla_test",
    4
)

fun main: int =
    if (
        sectionBytes != 0 && sharedTls != 0 && localTls != 0
    ) 0 else 1
