import "abla/unsafe/memory"
import "abla/unsafe/native"

fun staticWordTarget(value: int): int = value + 1

val staticWordBytes = nativeStaticBytes("abcd")
val staticMutableBytes = nativeStaticMutableBytes("wxyz")
val staticWords = nativeStaticU32s([
    staticWordBytes,
    staticWordBytes + 2,
    nativeFunctionAddress(staticWordTarget),
    int((u32(nativeFunctionAddress(staticWordTarget)) + u32(8))),
    305419896
])
val staticMutableWords = nativeStaticMutableU32s([
    1,
    staticWordBytes,
    nativeFunctionAddress(staticWordTarget),
    0
])

fun main(): int = if (
    staticWords != 0 && staticMutableWords != 0 && staticMutableBytes != 0
) 0 else 1
