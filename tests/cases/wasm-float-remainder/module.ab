// The remainders as WebAssembly computes them (the platform's fmod), for
// run.mjs.
import "remainder.ab"

@export("count")
fun exportedCount(): int = remainderCaseCount

@export("bits")
fun exportedBits(i: int): int = remainderBits(i)

@export("bits32")
fun exportedBits32(i: int): int = remainderBits32(i)
