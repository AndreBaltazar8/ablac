// The float remainder check's operands: every pair of the edge values, then
// pairs of pseudo-random bit patterns (every other one with exponents close
// together, where a remainder takes the most steps), and each remainder's bits
// (a NaN as one canonical NaN: its payload is the platform's).
import "abla/float"

val remainderEdges: array<f64> = [
    f64FromBits(0x0000000000000000), f64FromBits(0x8000000000000000),
    f64FromBits(0x0000000000000001), f64FromBits(0x8000000000000001),
    f64FromBits(0x000FFFFFFFFFFFFF), f64FromBits(0x0010000000000000),
    f64FromBits(0x7FEFFFFFFFFFFFFF), f64FromBits(0xFFEFFFFFFFFFFFFF),
    f64FromBits(0x7FF0000000000000), f64FromBits(0xFFF0000000000000),
    f64FromBits(0x7FF8000000000000), f64FromBits(0xFFF8000000000001),
    1.0, -1.0, 1.5, -2.5, 3.0, 0.1, 7.0, -0.75, 1.0e300, -1.0e-300,
    9007199254740992.0, 9007199254740994.0, 6.283185307179586, 360.0
]

val remainderEdgePairs = remainderEdges.size * remainderEdges.size

val remainderCaseCount = remainderEdgePairs + 100000

// splitmix64
fun remainderMix(seed: int): int {
    var z = seed * 0x9E3779B97F4A7C15 + 0x632BE59BD9B4E019
    z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >>> 27)) * 0x94D049BB133111EB
    z ^ (z >>> 31)
}

fun remainderX(i: int): f64 =
    if (i < remainderEdgePairs) remainderEdges[i / remainderEdges.size]
    else f64FromBits(remainderMix(i * 2))

fun remainderY(i: int): f64 {
    if (i < remainderEdgePairs) return remainderEdges[i % remainderEdges.size]
    val bits = remainderMix(i * 2 + 1)
    if (i % 2 == 0) return f64FromBits(bits)
    // x's exponent less 0 to 55, or more by up to 8
    var exponent = ((f64ToBits(remainderX(i)) >>> 52) & 0x7FF) - ((bits >>> 52) & 63) + 8
    if (exponent < 0) exponent = 0
    if (exponent > 0x7FE) exponent = 0x7FE
    f64FromBits((bits & 0x800FFFFFFFFFFFFF) | (exponent << 52))
}

fun remainderBits(i: int): int {
    val rest = remainderX(i) % remainderY(i)
    if (rest != rest) 0x7FF8000000000000 else f64ToBits(rest)
}

// f32 operands: the edge values narrowed, then the random patterns' upper
// halves (exponents close together where the f64 ones are).
fun remainderF32(i: int, value: f64): f32 =
    if (i < remainderEdgePairs) f64ToF32(value)
    else f32FromBits(u32(f64ToBits(value) >>> 32))

fun remainderBits32(i: int): int {
    val rest = remainderF32(i, remainderX(i)) % remainderF32(i, remainderY(i))
    if (rest != rest) 0x7FC00000 else int(f32ToBits(rest))
}
