// A global function value feeds an indirectly called closure, which in turn
// calls another function value. All three boxed entries must remain usable.
fun increment(value: int): int = value + 1
fun twice(value: int): int = value * 2
val globalStep: (int) -> int = increment
fun makeStep(offset: int): (int) -> int = { value: int -> globalStep(value) + offset }
fun apply(step: (int) -> int, value: int): int = step(value)
class Counter(val value: int) {
    fun read(): int = this.value
    fun unused(value: int): int = value + 999
}
fun main: int {
    val step = makeStep(2)
    if (apply(step, 17) == 20 && apply(twice, 21) == 42 && Counter(7).read() == 7) 0 else 1
}
