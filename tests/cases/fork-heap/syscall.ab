// A fork while another thread holds the runtime's heap locks (#812): the child allocates and checks what it
// built, and must not wait for ever on a lock whose holder did not survive the fork. The fork is the system call (the only one a program has where the runtime owns libc: AArch64)
// system call; the second thread allocates and frees as fast as it can the whole time.
import "abla/io"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/runtime/self"
import "abla/sys/linux"


trusted fun stopWord(): int = nativeStaticAllocate(8)

trusted fun churn(): int {
    val stop = stopWord()
    var total = 0
    var round = 0
    var live = 0
    while (ablaRuntimeAtomicLoadI64(stop) == 0) {
        val size = 16 + (round * 37) % 600
        val block = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(size))
        if (block == 0) return -1
        ablaRuntimeStoreI64(block, round)
        if (live != 0) __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(live))
        live = block
        total = total + size
        round = round + 1
    }
    if (live != 0) __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(live))
    total
}

// What the child does: allocation of every kind the runtime has, checked. 0 when all is well.
trusted fun child(): int {
    var sum = 0
    var round = 0
    while (round < 300) {
        val text = "child ${round} " + "x".repeat(round % 50)
        val numbers = [round, round * 2, round * 3]
        if (text.size != ("child ${round} ".size + round % 50)) return 1
        if (numbers[2] != round * 3) return 2
        sum = sum + text.size
        round = round + 1
    }
    0
}

trusted fun main: int {
    val stop = stopWord()
    val status = nativeStaticAllocate(8)
    val worker = thread { churn() }
    var failures = 0
    var forks = 0
    while (forks < 300) {
        val process = linuxSyscall0(57)
        if (process == 0) {
            linuxSyscall1(231, child())
        }
        if (process < 0) return 4
        ablaRuntimeStoreI64(status, 0)
        val waited = linuxSyscall4(61, process, status, 0, 0)
        if (waited != process || (ablaRuntimeLoadI64(status) & 4294967295) != 0) failures = failures + 1
        forks = forks + 1
    }
    ablaRuntimeAtomicStoreI64(stop, 1)
    await worker
    println("forks ${forks} failures ${failures}")
    0
}
