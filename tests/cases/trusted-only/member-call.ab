// A trusted-only extension function (the probe tools/test-unsafe-trusted-only.sh adds to its copy of the standard library)
// called as a method from code that is not trusted.
import "abla/io"
import "abla/unsafe/memory"

fun main {
    val buffer = nativeByteBuffer(8)
    println("${buffer.trustedOnlyProbe(1)}")
    buffer.close()
}
