// The standard library's classes that own raw memory, or whose fields trusted code writes at (decision #165): made or written from code
// that is not trusted, each is native.trust. Must not build; tools/test-unsafe-trusted-only.sh checks every name below is refused.
import "abla/io"
import "abla/bytes"
import "abla/crypto"
import "abla/crypto/aes"
import "abla/crypto/rsa"
import "abla/crypto/sha3"
import "abla/llvm/orc"
import "abla/tls/pure/client"
import "abla/tls/pure/keysched"
import "abla/tls/pure/resume"

fun reopenSession(var session: LlvmOrcSession): void {
    session.closed = false
    return
}

fun reopenGeneration(var generation: LlvmOrcGeneration): void {
    generation.closed = false
    return
}


fun main {
    val buffer = byteBuffer()
    buffer.stage = "shared"
    buffer.staged = -16
    val key = AesKey(0, 16, 10, false)
    val gcm = AesGcmKey(0, 16)
    val rsa = RsaPrivateKey("", "", 0, "", 0, 0, 0)
    val sponge = Keccak(0, 136, 6, 0, false)
    val made = keccakSha3(136)
    made.closed = false
    cryptoWipeString("shared")
    tlsWipe("shared")
    val identityKeys = TlsIdentityKeys("shared", "")
    val stream = Sha256Stream([], [], [], "shared", 0, true)
    var made256 = sha256Stream(true)
    made256.pending = "shared"
    val ticket = TlsStoredTicket("host", "", 4865, "shared", "shared", 0, 100, 0, "scope")
    val state = TlsTicketState(true, 4865, 0, 0, "shared", "", "")
    println("sealed-memory: built")
}
