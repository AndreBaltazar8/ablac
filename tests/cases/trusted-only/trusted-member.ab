// The trusted-only probes called from a trusted function: accepted, and it runs (prints 19).
import "abla/io"
import "abla/unsafe/memory"

trusted fun probe(buffer: NativeByteBuffer): int = buffer.trustedOnlyProbe(1) + (buffer + 2)

fun main {
    val buffer = nativeByteBuffer(8)
    println("${probe(buffer)}")
    buffer.close()
}
