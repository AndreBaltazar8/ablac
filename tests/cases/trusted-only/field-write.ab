// A field of a trusted-only class written from code that is not trusted (decision #161 A): refused. Reopening a closed buffer would
// let its checked methods use the freed bytes, and its drop free them a second time.
import "abla/io"
import "abla/unsafe/memory"

fun main {
    val buffer = nativeByteBuffer(64)
    buffer.close()
    buffer.closed = false
    buffer.store(0, 65)
    println("field-write: reopened a closed buffer")
}
