// abla/memory's raw checkpoint and reset called from code that is not trusted: both are trusted-only (a reset frees values
// older ones may still hold). Must not build; tools/test-unsafe-trusted-only.sh checks both are refused with the region help.
import "abla/io"
import "abla/memory"

fun main {
    val checkpoint = memoryCheckpoint()
    val values: array<int> = [1, 2, 3]
    memoryReset(checkpoint)
    println("${values.size}")
}
