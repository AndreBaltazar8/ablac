// A method is not a value: naming one without calling it is member:<Owner>.<name>, so a trusted-only extension function
// cannot be taken as a value to call later.
import "abla/io"
import "abla/unsafe/memory"

fun main {
    val buffer = nativeByteBuffer(8)
    val probe = buffer.trustedOnlyProbe
    println("${probe(1)}")
    buffer.close()
}
