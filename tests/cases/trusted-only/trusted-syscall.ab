// The same system call inside a trusted function, and abla/sys's checked wrappers from ordinary code: accepted, no warning.
import "abla/io"
import "abla/sys/linux"
import "abla/sys/linux/process"

trusted fun processId(): int = linuxSyscall1(39, 0)

fun main {
    println("pid ${processId() > 0} ${linuxProcessId() == processId()}")
}
