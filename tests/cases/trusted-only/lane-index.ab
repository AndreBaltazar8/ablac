// abla/simd's raw lane intrinsics skip the index check that .get and .with make, so they are private to the module: called from
// a program, each is name.private. Must not build; tools/test-unsafe-trusted-only.sh checks each name below is refused.
import "abla/io"
import "abla/simd"

fun lane(): int = 1000003

fun main {
    val v = u8x16Splat(u8(7))
    val w = ablaSimd_with_u8x16(v, lane(), u8(65))
    println("${ablaSimd_get_u8x16(w, 0)} ${ablaSimd_get_u64x8(u64x8Splat(u64(1)), lane())}")
    val x = ablaSimd_with_f32x4(f32x4Splat(f32(1.0)), 0 - lane(), f32(0.0))
    println("${x.get(0)}")
}
