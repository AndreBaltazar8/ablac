// A trusted-only function taken as a value by code that is not trusted (a call through the value would get around the check).
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

fun main {
    val address = nativePointerAddress
    val buffer = nativeByteBuffer(8)
    println("address ${address(buffer.address) != 0}")
    buffer.close()
}
