// The raw constructor of NativeByteBuffer from code that is not trusted (over an address a trusted helper made).
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun anyAddress(): i64* = nativePointerFromAddress(4096)

fun main {
    val buffer = NativeByteBuffer(anyAddress(), 8, false)
    println("capacity ${buffer.capacity}")
}
