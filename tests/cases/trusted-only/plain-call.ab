// A trusted-only function (nativePointerAddress: an address as an integer) called from code that is not trusted.
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

fun main {
    val buffer = nativeByteBuffer(8)
    println("address ${nativePointerAddress(buffer.address) != 0}")
    buffer.close()
}
