// abla/simd's byte-lane address functions and ByteBuffer.stageReserve (decision #130 A): called from code that is not trusted,
// each is native.trust, as a reference to one taken as a value is. Must not build; tools/test-unsafe-trusted-only.sh checks each
// name below is refused.
import "abla/io"
import "abla/simd"
import "abla/bytes"

fun main {
    val buffer = byteBuffer()
    buffer.appendText("hello")
    val address = buffer.stageReserve(16)
    val lanes = u8x16LoadAddress(address - 5)
    u8x16Splat(u8(88)).storeAddress(address - 5)
    val load = u8x16LoadAddress
    println("${lanes.get(0)} ${load(address).get(0)}")
}
