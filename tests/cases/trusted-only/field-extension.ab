// A field of a trusted-only class written in a program's own extension function of the class, by `this.` and by its bare name, from
// code that is not trusted: refused as a write from any other function is.
import "abla/io"
import "abla/unsafe/memory"

fun NativeByteBuffer.reopen(): void {
    this.closed = false
    return
}

fun NativeByteBuffer.reopenBare(): void {
    closed = false
    return
}

fun main {
    val buffer = nativeByteBuffer(64)
    buffer.close()
    buffer.reopen()
    buffer.reopenBare()
    println("field-extension: reopened a closed buffer")
}
