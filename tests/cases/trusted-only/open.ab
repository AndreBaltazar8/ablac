// What stays open to code that is not trusted: no warning, no error. The factory and the checked methods, and the producers of
// an address of storage or code that lives as long as the program (static storage, a function's address), here in module values.
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native/function-address"

fun handler(value: int): int = value + 1

val region = nativeStaticAllocate(16)
val table = nativeStaticU32s([1, 2])
val handlerAddress = nativeFunctionAddress(handler)

fun main {
    val buffer = nativeByteBuffer(8)
    nativeByteBufferStore(buffer, 3, 7)
    println("load ${buffer.load(3)} ${buffer.load(99)}")
    buffer.close()
    println("static ${region != 0} ${table != 0} ${handlerAddress != 0}")
}
