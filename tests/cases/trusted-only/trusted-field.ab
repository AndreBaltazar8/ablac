// The same kind of field write inside a trusted function (here: marking a buffer closed whose bytes another owner frees, as a mapping's
// owner does), and a read of the field from code that is not trusted: accepted, no warning.
import "abla/io"
import "abla/unsafe/memory"

trusted fun forget(var buffer: NativeByteBuffer): void {
    buffer.closed = true
    return
}

fun main {
    val buffer = nativeByteBuffer(8)
    println("open ${!buffer.closed}")
    forget(buffer)
    println("closed ${buffer.closed}")
}
