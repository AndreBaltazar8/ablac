// A trusted-only function called from compile-time code that is not trusted: sema checks a `compile fun` as any other, so
// the rule is the same before anything is evaluated.
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

compile fun staticAddress(): int = nativePointerAddress(nativePointerFromAddress(4096))

val address = #staticAddress()

fun main {
    println("address $address")
}
