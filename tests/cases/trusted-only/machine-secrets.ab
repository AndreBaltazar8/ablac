// The TLS machines' key material is private to abla/tls/pure/client and server (decision #165): setting it from outside (a string of
// the program's own, which the machine would wipe on failure or close) is name.private. Must not build; tools/test-unsafe-trusted-only.sh
// checks every name below is refused.
import "abla/io"
import "abla/tls/pure/client"
import "abla/tls/pure/connection"
import "abla/tls/pure/handshake"
import "abla/tls/pure/server"

fun main {
    var client = tlsClientNew(tlsClientConfig("localhost", { chain: array<string>, host: string, scheme: int, content: string, signature: string ->
        tlsAccepted() }, tlsPureRandom))
    client.handshakeSecret = "shared"
    client.keyPairs = [TlsKeyPair(29, "", "shared")]
    client.masterSecret = "shared"
    var server = tlsServerNew(tlsServerConfig(TlsIdentity([], [], { scheme: int, content: string -> "" }), tlsPureRandom))
    server.master = "shared"
    server.v12Pair = TlsKeyPair(29, "", "shared")
    server.ticketMaster = "shared"
    println("machine-secrets: built")
}
