// The byte-lane address functions and ByteBuffer.stageReserve inside a trusted function, and the checked lane methods from ordinary
// code: accepted, no warning. Prints "lanes 104 88 7 65".
import "abla/io"
import "abla/simd"
import "abla/bytes"

trusted fun firstLanes(var buffer: ByteBuffer): string {
    val address = buffer.stageReserve(16)
    u8x16Splat(u8(88)).storeAddress(address)
    val text = "hello, sixteen b"
    val lanes = u8x16Load(text)
    "${lanes.get(0)} ${u8x16LoadAddress(address).get(0)}"
}

fun main {
    var buffer = byteBuffer()
    val checked = u8x16Splat(u8(7)).with(1, u8(65))
    println("lanes ${firstLanes(buffer)} ${checked.get(0)} ${checked.get(1)}")
}
