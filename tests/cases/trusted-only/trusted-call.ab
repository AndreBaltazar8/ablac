// The same call inside a trusted function: accepted, no warning.
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun addressOf(buffer: NativeByteBuffer): int = nativePointerAddress(buffer.address)

fun main {
    val buffer = nativeByteBuffer(8)
    println("address ${addressOf(buffer) != 0}")
    buffer.close()
}
