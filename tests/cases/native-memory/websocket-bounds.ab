// The WebSocket server's join and unmask helpers stay inside their strings (#1139 area 10): a join offset past `left` wrote `right`
// before the new string's bytes, a negative one copied the bytes before `left`, and unmask read `length` bytes at any `begin`. Exits 0
// printing "websocket-bounds: ok".
import "abla/io"
import "abla/text"
import "abla/websocket/server"

fun main: int {
    val right = "R".repeat(200)
    if (webSocketServerJoin("", 100, right) != right) return 1
    if (webSocketServerJoin("ab", -64, "c") != "abc") return 2
    if (webSocketServerJoin("abcdef", 2, "g") != "cdefg") return 3
    if (webSocketServerUnmask("abcd", 0, -4096, 4096) != "") return 4
    if (webSocketServerUnmask("abcdefgh", 0, 4, 5) != "") return 5
    if (webSocketServerUnmask("abcd\u0000\u0000\u0000\u0000", 0, 4, 4) != "abcd") return 6
    println("websocket-bounds: ok")
    0
}
