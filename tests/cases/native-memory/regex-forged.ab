// A Regex built by hand whose match leaves its spans at -1 (#1139 area 10): findAll, findAllWork and replace then searched again from -1,
// for ever, and each search's trusted skip read the byte before the text. A match that does not end at or after where its search began
// now ends the search, and the skip starts inside the text. Exits 0 printing "regex-forged: ok".
import "abla/io"
import "abla/text"
import "abla/regex"

fun main: int {
    var table = ""
    for (i in 0 until 256) table = table + "\u0001".slice(0, 1)
    val forged = Regex("x", 1, [7, 0, 0], [], table)
    val text = "y".repeat(40).slice(0, 40)
    if (forged.findAll(text).size != 0) return 1
    forged.findAllWork(text)
    if (forged.replace(text, "z") != text) return 2
    if (regexCompile("y+").regex.findAll(text).size != 1 || regexCompile("y").regex.replace("yay", "b") != "bab") return 3
    println("regex-forged: ok")
    0
}
