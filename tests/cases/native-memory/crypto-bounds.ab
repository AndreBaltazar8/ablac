// Crypto entry points stay inside their own memory (#1139 area 10): rsaPrivateOperation read a value longer than the modulus into a
// modulus-sized number, keccakSha3 took any rate (absorbing past the 240-byte state), a closed sponge kept absorbing into freed memory,
// and aesGcmStart copied 12 nonce bytes from a shorter nonce (here a slice: the bytes after it in its parent became the counter). Exits 0
// printing "crypto-bounds: ok".
import "abla/io"
import "abla/text"
import "abla/crypto"
import "abla/crypto/sha3"
import "abla/crypto/rsa"
import "abla/crypto/aes"
import "abla/unsafe/memory/raw"

/** The first 12 bytes of a GCM state's counter block, as ints. */
trusted fun counterBytes(state: AesGcmState): array<int> {
    val bytes: array<int> = []
    for (i in 0 until 12) bytes.append(ablaUnsafeLoadU8(nativePointerFromAddress(state.counter() + i)))
    bytes
}

fun main: int {
    if (rsaPrivateOperation(rsaPrivateFailed("x"), "A".repeat(100000)).ok) return 1
    val wide = keccakSha3(100000)
    wide.absorb("A".repeat(4096))
    if (wide.squeeze(32) != "") return 2
    val sponge = keccakSha3(136)
    sponge.absorb("abc")
    sponge.close()
    sponge.absorb("A".repeat(4096))
    if (sponge.squeeze(32) != "") return 3
    sponge.close()
    val open = keccakSha3(136)
    open.absorb("abc")
    if (open.squeeze(32).size != 32) return 4
    open.close()
    val nonce = "abQQQQQQQQQQQQQQ".slice(0, 2)
    val key = aesExpand("k".repeat(16), false)
    val state = aesGcmStart(key, nonce, "", false)
    val counter = counterBytes(state)
    if (counter[0] != 97 || counter[1] != 98) return 5
    for (i in 2 until 12) if (counter[i] != 0) return 6
    println("crypto-bounds: ok")
    0
}
