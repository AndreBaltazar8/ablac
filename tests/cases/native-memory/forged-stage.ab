// A ByteBuffer whose stage offset is not one abla/bytes wrote (below 0, or far past the stage) writes nothing outside its stage
// (#1139 area 10): the trusted writers write at the stage's address plus `staged`, and checked only `staged + length` against the
// stage's size, so -16 wrote 16 bytes before the stage (here: into the string the stage is a slice of) and 2^63 - 3 wrapped the sum.
// The fields are set from a trusted function, as only trusted code may write them. Exits 0 printing "forged-stage: ok".
import "abla/io"
import "abla/bytes"
import "abla/text"

/** Points `buffer`'s stage at `stage` with offset `staged`. */
trusted fun forge(var buffer: ByteBuffer, stage: string, staged: int): void {
    buffer.stage = stage
    buffer.staged = staged
    return
}

fun main: int {
    val big = "A".repeat(64)
    val expected = "A".repeat(64)
    val text = byteBuffer()
    forge(text, big.slice(32, 64), -16)
    text.appendText("ZZZZ")
    val byte = byteBuffer()
    forge(byte, big.slice(32, 64), -16)
    byte.appendByteValue(90)
    val number = byteBuffer()
    forge(number, big.slice(32, 64), -16)
    number.appendInt(123456)
    if (big != expected) {
        println("forged-stage: a negative offset wrote before the stage: $big")
        return 1
    }
    val far = byteBuffer()
    forge(far, "abcd".repeat(2), 9223372036854775805)
    far.appendText("xyz")
    far.appendByteValue(90)
    println("forged-stage: ok")
    0
}
