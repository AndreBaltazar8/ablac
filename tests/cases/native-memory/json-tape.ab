// emit writes only what its size pass counted, whatever a program wrote into a document's tape (#1139 area 10): the tape is an
// ordinary array. A scalar span past the source copied that many bytes into a buffer sized for "null"; an array count lower than its
// elements gave fewer commas than the writer wrote. And jsonStringify refuses a total past 2^62 (raw nodes over a 2^62-byte rope, four
// times, wrapped to 5 bytes). Exits 0 printing "json-tape: ok".
import "abla/io"
import "abla/json"
import "abla/text"

fun main: int {
    val spanned = jsonDocument("null").document
    spanned.tape[2] = 1000000
    if (spanned.emit() != "null") return 1
    val reversed = jsonDocument("[1, 22]").document
    reversed.tape[5] = -5
    if (reversed.emit() != "null") return 2
    val counted = jsonDocument("[1,2,3]").document
    counted.tape[0] = counted.tape[0] & 255
    if (counted.emit() != "[1,2,3]") return 3
    var rope = "ab"
    for (i in 0 until 61) rope = rope + rope
    val raw = jsonRawUnchecked(rope)
    if (jsonStringify(jsonArray([raw, raw, raw, raw])) != "null") return 4
    println("json-tape: ok")
    0
}
