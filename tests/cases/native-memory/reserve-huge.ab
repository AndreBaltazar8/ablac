// ByteBuffer.stageReserve of the largest int (#1139 area 10): capacity + 1 wrapped to a 1-byte allocation, which became a stage claiming
// 2^63 - 1 bytes, and the next append wrote past it. Now the reservation asks for more than any buffer holds and the allocation is
// refused: the program must stop (memory limit) before it prints "reserve-huge: wrote".
import "abla/io"
import "abla/bytes"
import "abla/text"

fun main: int {
    val buffer = byteBuffer()
    buffer.stageReserve(9223372036854775807)
    buffer.appendText("A".repeat(200))
    println("reserve-huge: wrote 200 bytes into a stage of ${buffer.stage.size}")
    0
}
