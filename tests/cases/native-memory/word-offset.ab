// NativeByteBuffer's eight-byte accessors refuse an offset whose word would end past the buffer, also one near 2^63, where
// `offset + 8` wrapped below the capacity and the access went to the buffer's address plus 2^63 - 4 (a fault on x86-64; with
// AArch64's top-byte-ignore, the 4 bytes before the buffer). Exits 0 printing "word-offset: ok".
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

/** Whether a pointer store at `offset` was refused. */
trusted fun pointerRefused(var buffer: NativeByteBuffer, offset: int): bool = !buffer.storePointer(offset, nativeNullPointer())

fun main: int {
    val buffer = nativeByteBuffer(64)
    if (!buffer.storeI64(56, 7) || buffer.loadI64(56) != 7 || buffer.storeI64(57, 7)) return 1
    for (offset in [9223372036854775800, 9223372036854775801, 9223372036854775804, 9223372036854775807]) {
        if (buffer.loadI64(offset) != 0 || buffer.storeI64(offset, 1094795585) || !pointerRefused(buffer, offset)) {
            println("word-offset: offset $offset was not refused")
            return 2
        }
    }
    buffer.close()
    println("word-offset: ok")
    0
}
