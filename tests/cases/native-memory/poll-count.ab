// ablaLinuxPollWaitCompact refuses an event count outside 1..1024 (#1139 area 10): 12 bytes per event wrapped for a count near 2^61,
// the buffer was empty, and the kernel (which reads the count as 32 bits) wrote 200 ready events into it. Seen under valgrind
// (tools/test-native-memory-bounds.sh); natively the overrun is silent. Exits 0 printing "poll-count: ok".
import "abla/io"
import "abla/sys/linux/net"

fun main: int {
    var poller = socketPoller()
    var sockets: array<UdpSocket> = []
    for (i in 0 until 200) {
        val socket = udpBindPort(0)
        poller.watchDescriptor(socket.descriptor, false, true)
        sockets.append(move(socket))
    }
    if (ablaLinuxPollWaitCompact(poller.descriptor, 2305843009213693952 + 200, 0) != "") return 1
    // 200 ready sockets: up to 200 records of 12 bytes (the AArch64 system call adapter answers at most 64 at a time).
    val events = ablaLinuxPollWaitCompact(poller.descriptor, 200, 0)
    if (events.size == 0 || events.size % 12 != 0 || events.size > 2400) return 2
    println("poll-count: ok")
    0
}
