import "abla/io"
import "abla/http"
import "abla/http/tls"
import "abla/fs"
import "abla/sys/linux/process"

fun main: int {
    val certificate = path("CERTFILE").readText()
    val key = path("KEYFILE").readText()
    val pkcs12 = path("P12FILE").readText()
    val start = linuxMonotonicMilliseconds()
    val plain = httpsClient("127.0.0.1", 39093, 4096, 3000, DEADLINE)
    val a = plain.send(httpGet("/stall"))
    val first = linuxMonotonicMilliseconds() - start
    val pem = httpsClientWithIdentityPem("127.0.0.1", certificate, key,
        "", "", 39093, 4096, 3000, DEADLINE)
    val b = pem.send(httpGet("/stall"))
    val second = linuxMonotonicMilliseconds() - start - first
    val p12 = httpsClientWithIdentityPkcs12("127.0.0.1", pkcs12, "test",
        "", 39093, 4096, 3000, DEADLINE)
    val c = p12.send(httpGet("/stall"))
    val third = linuxMonotonicMilliseconds() - start - first - second
    println("attempts: plain ${first}ms (succeeded ${a.succeeded}), PEM identity ${second}ms (${b.succeeded}), PKCS12 identity ${third}ms (${c.succeeded}); each must fail after at least 80% of its DEADLINE ms deadline, and in under 20 s more")
    if (!a.succeeded && !b.succeeded && !c.succeeded &&
        first >= DEADLINE * 8 / 10 && first < DEADLINE + 20000 && second >= DEADLINE * 8 / 10 && second < DEADLINE + 20000 &&
        third >= DEADLINE * 8 / 10 && third < DEADLINE + 20000) 42 else 1
}
