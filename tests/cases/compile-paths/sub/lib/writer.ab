// A library the program's transform and subparser call: the paths it writes are its caller's, read against the file
// that declares the transform or uses the subparser, not this one (#95).
import "abla/fs"
import "abla/compiler"
import "abla/compiler/parser"

compile fun pathsLibraryStage(name: string): bool = compilerWriteFile(name, "hello")

// `$staged out/name.txt;` writes the file the using program names and is 1 when it did.
compile fun pathsStagedParse(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    val name = parserRawTakeUntil(cursor, ";")
    parserRawExpect(cursor, ";")
    syntaxInteger(if (Path(name).writeText("hello")) 1 else 0)
}

#compilerRegisterSubparser("staged", pathsStagedParse)
