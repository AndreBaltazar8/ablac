// A write above the package (its abla.toml is beside this file): E_BUILD_PATH_OUTSIDE, nothing written.
import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

compile fun escape(): bool = Path("../../compile-paths-escape.txt").writeText("no")

val escaped = #escape()

fun main: int = if (escaped) 1 else 0
