// tools/test-compile-paths.sh: compile-time code's paths are read against this file (decision #95 A), whichever
// directory the build runs from and whichever tier runs the site: data.txt is the one beside this file, and both
// writes land in sub/out/. The program exits with the data's length (5).
import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

compile fun copyData(): int {
    val data = Path("data.txt").readText()
    val copied = Path("out/copy.txt").writeText(data)
    val staged = compilerWriteFile("out/api.txt", data)
    if (copied && staged && Path("out/copy.txt").exists()) data.size else -1
}

val copiedSize = #copyData()

fun main: int = copiedSize
