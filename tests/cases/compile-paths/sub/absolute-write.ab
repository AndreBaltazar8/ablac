// A write to an absolute path outside the project: E_BUILD_PATH_OUTSIDE, nothing written.
import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

compile fun escape(): bool = Path("/compile-paths-absolute-escape.txt").writeText("no")

val escaped = #escape()

fun main: int = if (escaped) 1 else 0
