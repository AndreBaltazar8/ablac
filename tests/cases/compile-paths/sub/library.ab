// The paths this file hands a library, through a transform and a subparser, are read against this file: sub/out/,
// not sub/lib/out/ (#95).
import "lib/writer.ab"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

compile fun stage(): void {
    pathsLibraryStage("out/transform.txt")
    return
}

#compiler.transform(stage)

fun main: int = $staged out/subparser.txt;
