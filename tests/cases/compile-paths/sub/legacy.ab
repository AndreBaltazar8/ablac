// A path spelled from the working directory: built from the package's directory, "sub/data.txt" is not beside this
// file, and since the v0.2.66 fallback went (#1044) the site reads nothing there, not the old file.
import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

compile fun legacySize(): int = Path("sub/data.txt").readText().size

val legacy = #legacySize()

fun main: int = legacy
