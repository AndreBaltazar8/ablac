// The working-directory reading, kept for one release: built from the package's directory, "sub/data.txt" is not
// beside this file but is there from the working directory, so it is read the old way, with W_BUILD_PATH_CWD.
import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

compile fun legacySize(): int = Path("sub/data.txt").readText().size

val legacy = #legacySize()

fun main: int = legacy
