// An absolute path is read as given, outside the project too (a toolchain, an SDK, /proc), but a write to one outside
// the project is refused (E_BUILD_PATH_OUTSIDE): absolute-write.ab.
import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

compile fun hostsKnown(): int = if (Path("/etc/hosts").exists() && Path("/etc").entries().size > 0) 1 else 0

val known = #hostsKnown()

fun main: int = known
