// The encoders write through trusted raw pointers, which the ordinary-global write analysis cannot place: a site that
// stringifies a document stays in the evaluator on a cross-target build.
import "abla/io"
import "abla/json"

compile fun text(): string =
    jsonStringify(jsonParse("{\"k\":[1,2,{\"z\":null}],\"s\":\"v\\t\"}").value)

val A = #text()
val RESULT = A
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
