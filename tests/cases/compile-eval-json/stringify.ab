// The encoders write through trusted raw pointers into buffers of their own: the addresses reach those writes only as
// scalars, which carry no global's origins, so a site that stringifies a fresh document writes no global and runs
// natively on a cross-target build (#828; before, it stayed in the evaluator).
import "abla/io"
import "abla/json"

compile fun text(): string =
    jsonStringify(jsonParse("{\"k\":[1,2,{\"z\":null}],\"s\":\"v\\t\"}").value)

val A = #text()
val RESULT = A
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
