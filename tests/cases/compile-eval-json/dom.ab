// A JSON document parsed, read and written back at compile time: every accessor on the portable path.
import "abla/io"
import "abla/json"

fun describe(value: Json, depth: int): string {
    if (value.isNull()) return "n"
    if (value.isBoolean()) return if (value.asBoolean()) "t" else "f"
    if (value.isNumber()) return "${value.asInt()}/${value.asNumber().text}/${value.intAvailable()}"
    if (value.isString()) return "'${value.asString()}'"
    var out = if (value.isArray()) "[" else "{"
    var index = 0
    while (index < value.size()) {
        if (index > 0) out = out + ","
        if (value.isObject()) out = out + value.keys[index] + "="
        out = out + describe(if (value.isArray()) value.at(index) else value.values[index],
            depth + 1)
        index += 1
    }
    out + (if (value.isArray()) "]" else "}")
}

compile fun read(): string {
    val text =
        "{\"a\":[1,-2,3,true,false,null,\"x\\ny\",\"é€\",\"\\u00e9\\ud83d\\ude00\"],\"b\":{\"c\":9223372036854775807," +
        "\"d\":-9223372036854775808},\"f\": [ 4 , 5 ] ,\"g\":\"\",\"h\":123456789012345678901234567890}"
    val parsed = jsonParse(text)
    var out = "${parsed.succeeded}:"
    if (parsed.succeeded) {
        val root = parsed.value
        out = out + describe(root,
            0) +
            "|${root.has("b")}${root.has("zz")}${root.getInt("h")}${root.get("b").getInt("c")}" +
            "${root.getString("g").size}${root.get("f").size()}${root.size()}"
    } else {
        out = out + parsed.error.code + "@${parsed.error.byteOffset}"
    }
    out
}

compile fun readValid(): string {
    val parsed = jsonParse("{\"k\":[1,2,{\"z\":null}],\"s\":\"v\\t\"}")
    describe(parsed.value, 0)
}

val A = #read()
val B = #readValid()
val RESULT = "$A;$B"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
