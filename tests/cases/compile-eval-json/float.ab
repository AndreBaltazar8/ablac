// A site that reads a number as a float stays in the evaluator on a cross-target build (floats are not proven bit-identical).
import "abla/io"
import "abla/json"

compile fun asFloat(): int {
    val node = jsonDocument("[1.5, 2]").document.root().at(0)
    if (node.asF64() == 1.5) 1 else 0
}

val A = #asFloat()
val RESULT = "$A"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
