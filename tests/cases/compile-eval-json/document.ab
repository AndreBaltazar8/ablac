// The tape reader (JsonDocument, JsonNode, JsonCursor) at compile time.
import "abla/io"
import "abla/json"

compile fun walk(): string {
    val result =
        jsonDocument("{\"id\":7,\"name\":\"abla\",\"tags\":[\"a\",\"b\",\"c\"],\"nested\":{\"x\":true,\"y\":null},\"n\":-12}")
    var out = "${result.succeeded}:"
    if (!result.succeeded) return out + result.error.code
    val root = result.document.root()
    out = out +
        "${root.size()}${root.getInt("id")}${root.getString("name")}${root.get("n").asInt()}${root.has("nested")}"
    val tags = root.get("tags").elements()
    while (tags.next()) out = out + tags.asString()
    val members = root.members()
    while (members.next()) out = out + "," + members.key() + "${members.kind()}"
    out + root.get("nested").raw() + "${root.get("missing").exists()}"
}

val A = #walk()
val RESULT = A
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
