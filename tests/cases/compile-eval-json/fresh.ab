// A parsed value that reaches the program is a fresh copy: changing its arrays leaves the shared empty arrays alone.
import "abla/io"
import "abla/json"

compile fun parsed(): Json = jsonParse("[1,{\"a\":2}]").value
compile fun scalar(): Json = jsonParse("7").value

val DOC = #parsed()
val ONE = #scalar()
fun main: int {
    ONE.keys.append("x")
    DOC.values.append(jsonNull())
    println("${jsonNull().keys.size}${jsonParse("1").value.keys.size}${DOC.size()}${ONE.keys.size}${DOC.at(1).getInt("a")}")
    0
}
val RESULT = "${DOC.size()}"
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
