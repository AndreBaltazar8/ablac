// The empty key and value arrays every parsed scalar shares are ordinary mutable globals: a site that can write one
// runs in the evaluator, and so does every site that reads it (the #796 rule), so all tiers agree.
import "abla/io"
import "abla/json"

compile fun before(): int = jsonParse("1").value.keys.size
compile fun write(): int { val value = jsonNull(); value.keys.append("x"); value.keys.size }
compile fun after(): int = jsonParse("2").value.keys.size

val A = #before()
val B = #write()
val C = #after()
val RESULT = "$A,$B,$C"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
