// Parse failures and limits at compile time: the error code, byte offset, line and column are the evaluator's.
import "abla/io"
import "abla/json"

fun failure(text: string, limits: JsonLimits): string {
    val parsed = jsonParse(text, limits)
    if (parsed.succeeded) return "ok"
    "${parsed.error.code}@${parsed.error.byteOffset}:${parsed.error.line}:${parsed.error.column}"
}

compile fun many(): string {
    val tight = JsonLimits(64, 3, 6, 8, 2, true, false)
    var out = ""
    for (text in ["", "[", "[1,]", "{\"a\":1,\"a\":2}", "[[[[1]]]]", "[1,2,3,4,5,6,7]",
        "\"abcdefghijk\"", "{\"a\":1,\"b\":2,\"c\":3}",
        "nul", "tru", "[1 2]", "{\"a\" 1}", "\"\\x\"", "01", "-", "1.", "1e", "\"\n\"", "[1]x",
        "  [1]  ",
        "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"",
        "\n\n[1,\n 2,\n x]"]) {
        out = out + failure(text, tight) + ";"
    }
    out
}

compile fun standard(): string {
    var out = ""
    for (text in ["", "[1,]", "{\"a\":1,\"a\":2}", "[1 2]", "\n\n[1,\n 2,\n x]", "\"\\ud800\"",
        "[1]x"]) {
        val parsed = jsonParse(text)
        out = out +
            (if (parsed
                    .succeeded) "ok" else "${parsed.error.code}@${parsed.error.byteOffset}:${parsed.error.line}:${parsed.error.column}") +
            ";"
    }
    out
}

val A = #many()
val B = #standard()
val RESULT = "$A|$B"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
