// A JsonLimits value read from a global (here the library's own, through jsonDefaultLimits, and a user's): its integer
// fields reach the code that writes raw memory only as scalar parameters, which carry no global's origins, so the
// ordinary-global write analysis proves the site writes no global and it runs natively (#828; before, it stayed in the
// evaluator).
import "abla/io"
import "abla/json"

val TIGHT = JsonLimits(64, 3, 6, 8, 2, true, false)

compile fun limited(): string {
    val parsed = jsonParse("[[[[1]]]]", TIGHT)
    if (parsed.succeeded) "ok" else "${parsed.error.code}@${parsed.error.byteOffset}"
}

val A = #limited()
val RESULT = A
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
