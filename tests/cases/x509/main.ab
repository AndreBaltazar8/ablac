// abla/crypto/x509: the committed chains (tests/cases/x509/chains, made by tools/gen-x509-fixtures.sh) with what each must
// give, the host name rules, and certificates damaged in every way a byte or a truncation can: parsing must answer, never
// stop. Argument 0 is the directory of the chains.
import "abla/crypto"
import "abla/crypto/der"
import "abla/crypto/x509"
import "abla/fs"
import "abla/integer"
import "abla/io"
import "abla/process/arguments"
import "abla/tls/pure/handshake"
import "abla/tls/pure/verify"

var failures = 0

fun fail(what: string): void {
    println("x509: FAIL $what")
    failures = failures + 1
    return
}

fun check(ok: bool, what: string): void {
    if (!ok) fail(what)
    return
}

fun split(text: string, separator: int): array<string> {
    val out: array<string> = []
    var start = 0
    for (at in 0 until text.size) {
        if (int(text[at]) == separator) {
            out.append(text.slice(start, at))
            start = at + 1
        }
    }
    out.append(text.slice(start, text.size))
    out
}

fun readCertificates(directory: string, names: string): array<X509Certificate> {
    val out: array<X509Certificate> = []
    for (name in split(names, 44)) {
        if (name == "") continue
        val parsed = x509ParsePem(path(directory + "/" + name).readText())
        if (parsed.skipped > 0 || parsed.certificates.size == 0) fail("$name does not parse")
        for (c in parsed.certificates) out.append(c)
    }
    out
}

fun chains(directory: string): void {
    val lines = split(path(directory + "/cases.tsv").readText(), 10)
    var count = 0
    var accepted = 0
    for (line in lines) {
        if (line == "") continue
        val fields = split(line, 9)
        if (fields.size != 7) {
            fail("cases.tsv line has ${fields.size} fields: $line")
            continue
        }
        val name = fields[0]
        val host = fields[1]
        val now = fields[2].parseInt() ?? 0
        val expect = fields[3]
        val leaf = readCertificates(directory, fields[4])
        val extra = readCertificates(directory, fields[5])
        val roots = readCertificates(directory, fields[6])
        if (leaf.size == 0) {
            fail("$name: no leaf")
            continue
        }
        val chain: array<string> = [leaf[0].der]
        for (c in extra) chain.append(c.der)
        val result = x509Verify(chain, X509TrustStore(roots), X509Options(host, now))
        count = count + 1
        if (result.ok) accepted = accepted + 1
        if (expect == "ok") {
            if (!result.ok) fail("$name: refused: ${result.error}")
            else if (result.path.size < 1) fail("$name: no path")
        } else {
            if (result.ok) fail("$name: accepted, wanted an error with '$expect'")
            else if (pemFind(result.error, expect, 0) < 0) fail("$name: error '${result.error}' lacks '$expect'")
        }
    }
    check(count >= 40, "only $count chains were read")
    println("x509: $count chains, $accepted accepted")
    return
}

fun hosts(): void {
    check(x509DnsMatches("example.com", "example.com"), "plain match")
    check(!x509DnsMatches("example.com", "www.example.com"), "plain mismatch")
    check(x509DnsMatches("*.example.com", "a.example.com"), "wildcard")
    check(!x509DnsMatches("*.example.com", "example.com"), "wildcard needs a label")
    check(!x509DnsMatches("*.example.com", "a.b.example.com"), "wildcard is one label")
    check(!x509DnsMatches("*.com", "example.com"), "no wildcard on a top level domain")
    check(!x509DnsMatches("a*.example.com", "ab.example.com"), "no partial wildcard")
    check(!x509DnsMatches("www.*.example.com", "www.a.example.com"), "wildcard only first")
    check(!x509DnsMatches("*.example.com", ".example.com"), "empty label")
    check(!x509DnsMatches("", ""), "empty")
    check(hexEncode(x509IpBytes("192.0.2.7")) == "c0000207", "IPv4")
    check(x509IpBytes("192.0.2") == "" && x509IpBytes("256.0.0.1") == "" && x509IpBytes("01.2.3.4") == "", "bad IPv4")
    check(hexEncode(x509IpBytes("2001:db8::1")) == "20010db8000000000000000000000001", "IPv6")
    check(hexEncode(x509IpBytes("::1")) == "00000000000000000000000000000001", "::1")
    check(hexEncode(x509IpBytes("::")) == "00000000000000000000000000000000", "::")
    check(hexEncode(x509IpBytes("1:2:3:4:5:6:7:8")) == "00010002000300040005000600070008", "full IPv6")
    check(x509IpBytes("1:2:3:4:5:6:7") == "" && x509IpBytes("1::2::3") == "" && x509IpBytes("12345::") == "", "bad IPv6")
    check(x509IpBytes("example.com") == "", "a name is not an address")
    println("x509: host names")
    return
}

/** Parses every truncation of a certificate and every version of it with one byte changed. */
fun damage(directory: string): void {
    val good = x509ParsePem(path(directory + "/leaf-ec.pem").readText()).certificates[0].der
    // A certificate that still parses after a change is verified against the real intermediate and root: every byte of the
    // signed part is signed, and the signature and its algorithm are checked, so none may verify.
    val realRoots = readCertificates(directory, "root-ec.pem")
    val realInter = readCertificates(directory, "inter-ec.pem")
    check(x509Verify([good, realInter[0].der], X509TrustStore(realRoots), X509Options("example.com", 1893456000)).ok, "the undamaged certificate verifies")
    var survivors = 0
    check(x509ParseDer(good).ok, "the certificate parses")
    var parsed = 0
    for (size in 0 until good.size) {
        if (x509ParseDer(good.slice(0, size)).ok) fail("a truncation to $size bytes parsed")
        parsed = parsed + 1
    }
    check(!x509ParseDer(good + "\x00").ok, "trailing byte")
    check(!x509ParseDer("").ok, "empty")
    for (at in 0 until good.size) {
        for (change in [1, 128, 255]) {
            val damaged = good.slice(0, at) + byteEncode(int(good[at]) ^ change) + good.slice(at + 1, good.size)
            val result = x509ParseDer(damaged)
            parsed = parsed + 1
            if (result.ok) {
                // A change in a value, not in the structure, still parses (a serial, a key byte): it must not verify.
                survivors = survivors + 1
                if (x509Verify([damaged, realInter[0].der], X509TrustStore(realRoots), X509Options("example.com", 1893456000)).ok) {
                    fail("a certificate with byte $at changed by $change verified")
                }
            }
        }
    }
    check(survivors > 0, "no damaged certificate survived parsing: the verification of survivors was not exercised")
    println("x509: $parsed damaged certificates answered, $survivors of them parsed and none verified")
    return
}

/** Lengths and tags a strict DER reader refuses, a name with a NUL, the limits of the path builder, the key usage of a
 *  handshake signature. */
fun attacks(directory: string): void {
    val cert = readCertificates(directory, "leaf-ec.pem")[0]
    val good = cert.der
    check(int(good[0]) == 48 && int(good[1]) == 130, "the outer header is 30 82 hh ll")
    val body = good.slice(4, good.size)
    val length = good.slice(2, 4)
    val variants: array<string> = [
        "\x30\x80" + body + "\x00\x00",
        "\x30\x83\x00" + length + body,
        "\x30\x81" + "\x05" + body,
        "\x30\x85\x01\x00\x00\x00\x00" + body,
        "\x30\x84\xff\xff\xff\xff" + body,
        "\x30\x82\xff\xff" + body,
        "\x30\x82\x00\x10" + body,
        "\x1f\x82" + length + body,
        "\x31\x82" + length + body]
    var index = 0
    for (variant in variants) {
        if (x509ParseDer(variant).ok) fail("a DER certificate with a bad outer header parsed (variant $index)")
        index = index + 1
    }
    check(x509ParseDer("\x30\x82" + length + body).ok, "the control (a rebuilt header) parses")
    check(!derItem("\x30\x81\x05hello", 0, 8).ok, "a long-form length below 128")
    check(derItem("\x30\x05hello", 0, 7).ok, "a short-form length")
    check(!derItem("\x30\x80hello\x00\x00", 0, 9).ok, "an indefinite length")
    check(!derItem("\x30\x82\x00\x80" + "x".repeat(128), 0, 132).ok, "a length with a leading zero byte")
    check(!derItem("\x1f\x05hello", 0, 7).ok, "a multi-byte tag")
    // A NUL (or any control character) in a dNSName is refused when the certificate is read, and no host with a NUL matches.
    val at = pemFind(good, "www.example.com", 0)
    check(at >= 0, "the SAN www.example.com is in the certificate")
    check(x509ParseDer(good.slice(0, at + 3) + "x" + good.slice(at + 4, good.size)).ok, "the control (a changed letter in a SAN) parses")
    check(!x509ParseDer(good.slice(0, at + 3) + "\x00" + good.slice(at + 4, good.size)).ok, "a dNSName with a NUL byte")
    check(!x509ParseDer(good.slice(0, at + 3) + "\x01" + good.slice(at + 4, good.size)).ok, "a dNSName with a control character")
    check(x509MatchesHost(cert, "example.com"), "the host matches")
    check(!x509MatchesHost(cert, "example.com\x00.evil.com"), "a host with a NUL matched")
    check(!x509MatchesHost(cert, "example.com\x00"), "a host with a trailing NUL matched")
    check(x509MatchesHost(cert, "example.com."), "one trailing dot is the same name")
    check(!x509MatchesHost(cert, "example.com.."), "two trailing dots are not")
    check(x509MatchesHost(cert, "a.wild.example.com."), "a wildcard match with a trailing dot")
    check(!x509MatchesHost(cert, "a.b.wild.example.com"), "a wildcard is one label")
    // The path builder gives up after 64 signature checks: a chain with a few decoys that name the issuer but have another key
    // verifies, one whose real intermediate comes after 70 of them does not (and answers).
    val roots = readCertificates(directory, "root-ec.pem")
    val inter = readCertificates(directory, "inter-ec.pem")[0]
    val decoys = readCertificates(directory, "decoys.pem")
    check(decoys.size == 70, "decoys.pem holds ${decoys.size} certificates")
    for (count in [0, 10, 70]) {
        val chain: array<string> = [good]
        for (n in 0 until count) chain.append(decoys[n].der)
        chain.append(inter.der)
        val result = x509Verify(chain, X509TrustStore(roots), X509Options("example.com", 1893456000))
        if (count < 40 && !result.ok) fail("$count decoys: ${result.error}")
        if (count == 70 && result.ok) fail("70 decoys: the path builder went past its limit")
        if (count == 70 && !result.error.contains("too many candidate issuers")) fail("70 decoys: the error does not name the limit: [${result.error}]")
    }
    // A key rollover (certificates with one subject, each signed by the key of the one before) does not lengthen a path, but a path
    // holds at most three self-issued certificates: three are accepted, four are not.
    val rollRoots = X509TrustStore(readCertificates(directory, "roll-root.pem"))
    val rollThree: array<string> = [readCertificates(directory, "roll-leaf.pem")[0].der]
    for (name in ["roll-4", "roll-3", "roll-2", "roll-1"]) rollThree.append(readCertificates(directory, name + ".pem")[0].der)
    val threeVerdict = x509Verify(rollThree, rollRoots, X509Options("example.com", 1893456000))
    check(threeVerdict.ok, "a rollover chain with three self-issued certificates: ${threeVerdict.error}")
    val rollFour: array<string> = [readCertificates(directory, "roll-leaf5.pem")[0].der]
    for (name in ["roll-5", "roll-4", "roll-3", "roll-2", "roll-1"]) rollFour.append(readCertificates(directory, name + ".pem")[0].der)
    val fourVerdict = x509Verify(rollFour, rollRoots, X509Options("example.com", 1893456000))
    check(!fourVerdict.ok && fourVerdict.error.contains("too many self-issued"), "four self-issued certificates in a path: [${fourVerdict.error}]")
    // The subject's emailAddress is an rfc822Name for name constraints: a CA that permits only example.com's e-mail does not
    // sign a certificate whose subject has another.
    val mailVerdict = x509Verify([readCertificates(directory, "mail-leaf.pem")[0].der, readCertificates(directory, "mail-inter.pem")[0].der],
        X509TrustStore(readCertificates(directory, "mail-root.pem")), X509Options("example.com", 1893456000))
    check(!mailVerdict.ok && mailVerdict.error.contains("name constraints"), "a subject emailAddress outside the e-mail constraints: [${mailVerdict.error}]")
    // A serial number in a longer form than DER allows (0x00 before a byte below 0x80, 0xff before one of 0x80 or more) does not parse; one that needs its zero does.
    val serialAt = pemFind(good, "\x02\x01\x67", 8)
    check(serialAt > 8 && serialAt < 20, "the serial number 0x67 is near the start")
    val outerLength = int(good[2]) * 256 + int(good[3])
    val innerLength = int(good[6]) * 256 + int(good[7])
    for (variant in ["\x02\x02\x00\x67", "\x02\x02\xff\x80", "\x02\x02\x01\x67"]) {
        val wider = good.slice(0, 2) + byteEncode((outerLength + 1) >> 8) + byteEncode((outerLength + 1) & 255) + good.slice(4, 6) +
            byteEncode((innerLength + 1) >> 8) + byteEncode((innerLength + 1) & 255) + good.slice(8, serialAt) + variant +
            good.slice(serialAt + 3, good.size)
        val minimal = variant == "\x02\x02\x01\x67"
        if (minimal != x509ParseDer(wider).ok) fail("a serial number written ${hexEncode(variant)}: parses ${x509ParseDer(wider).ok}, should ${minimal}")
    }
    // The key usage of a handshake signature: a certificate that does not allow digitalSignature signs none.
    val noSignature = readCertificates(directory, "leaf-key-usage.pem")[0]
    val verdict = tlsCheckSignature(noSignature, TLS_SIG_ECDSA_SECP256R1_SHA256, "content", "signature")
    check(!verdict.accepted() && verdict.text.contains("key usage"), "a certificate without digitalSignature signed a handshake: [${verdict.text}]")
    println("x509: DER lengths, names, decoys, key usage")
    return
}

/** The system's CA bundle, when this machine has one: its certificates are real ones, of every age and generator. */
fun system(): void {
    val store = x509SystemTrustStore()
    if (store.certificates.size == 0) {
        println("x509: no system CA bundle here")
        return
    }
    var anchors = 0
    for (c in store.certificates) if (c.hasBasicConstraints && c.isCa) anchors = anchors + 1
    check(store.certificates.size > 50, "the system bundle has only ${store.certificates.size} certificates that parse")
    println("x509: system bundle: ${store.certificates.size} certificates parse, $anchors with cA")
    // The bundle's parse count against the PEM blocks it holds.
    for (bundle in x509SystemBundlePaths()) {
        val file = path(bundle)
        if (!file.exists()) continue
        val text = file.readText()
        var blocks = 0
        var at = 0
        while (true) {
            val found = pemFind(text, "-----BEGIN CERTIFICATE-----", at)
            if (found < 0) break
            blocks = blocks + 1
            at = found + 10
        }
        check(blocks - store.certificates.size <= blocks / 20, "$bundle: only ${store.certificates.size} of $blocks certificates parse")
        break
    }
    return
}

fun main: int {
    val directory = processArgument(0)
    system()
    hosts()
    chains(directory)
    damage(directory)
    attacks(directory)
    if (failures != 0) {
        println("x509: $failures failure(s)")
        return 1
    }
    println("x509: ok")
    0
}
