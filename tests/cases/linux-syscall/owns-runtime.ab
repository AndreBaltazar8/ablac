// ablaHostOwnsRuntime() (#811): true for a target whose hosted runtime is the toolchain's own on
// the Linux kernel (direct system calls, futex locks, the Abla heap): x86-64 Linux, not Android,
// not Apple, not WebAssembly. True here.
noescape extern:"intrinsic" fun ablaHostOwnsRuntime(): bool

fun main: int = if (ablaHostOwnsRuntime()) 42 else 1
