// getrandom on the aarch64-linux target: its system calls go by x86-64 numbers through the translator, where the
// kernel's own AArch64 number (278) is vmsplice (#811). 300 bytes arrive, not all zero, and differ between two calls.
import "abla/io"
import "abla/sys/linux/random"

fun main(): int {
    val first = secureRandomBytes(300)
    val second = secureRandomBytes(300)
    if (!first.succeeded || !second.succeeded || first.bytes.size != 300) {
        println("getrandom failed")
        return 1
    }
    var nonZero = 0
    for (i in 0 until first.bytes.size) if (first.bytes[i] != 0) nonZero = nonZero + 1
    if (nonZero < 200 || first.bytes == second.bytes) {
        println("getrandom bytes are not random")
        return 2
    }
    println("getrandom ok")
    0
}
