// The library 128-bit and 256-bit integers on every Linux target: no compiler runtime is needed
// (they are Abla code over 32-bit words), so a -nostdlib AArch64 link carries them (#811).
import "abla/io"
import "abla/uint128"
import "abla/int128"
fun main: int {
    val a = uint128Words(u32(0xFFFFFFFF), u32(0x12345678), u32(7), u32(9))
    val b = uint128(1000003)
    println("${a / b} ${a % b} ${a * b}")
    val c = int128(-123456789012345678) * int128(1000000007)
    println("${c / int128(97)} ${c % int128(97)}")
    println(a.toDecimal())
    0
}
