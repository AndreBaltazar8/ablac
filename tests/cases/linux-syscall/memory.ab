// memcpy, memset, memcmp and strlen over many sizes and alignments, the same answers on every
// Linux target: AArch64 has its own routines in module assembly (#811), so the checksums must
// match the x86-64 build's.
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/text"

trusted noescape extern:"c" fun strlen(value: i64*): int

trusted fun copies(): int {
    val a = nativeByteBuffer(512)
    val b = nativeByteBuffer(512)
    var sum = 0
    for (n in 0 until 140) {
        for (off in 0 until 9) {
            for (i in 0 until 300) a.store(i, (i * 7 + n) % 251)
            ablaUnsafeSetMemory(b.address, n % 256, 300)
            ablaUnsafeCopyMemory(
                nativePointerAddress(b.address) + off,
                nativePointerAddress(a.address) + (off * 3) % 7, n
            )
            ablaUnsafeSetMemory(
                nativePointerFromAddress(nativePointerAddress(b.address) + 200 + off), 9 + n % 100, off + n % 40
            )
            for (i in 0 until 300) sum = (sum * 31 + b.load(i)) % 1000000007
        }
    }
    sum
}

trusted fun lengths(): int {
    val a = nativeByteBuffer(256)
    var wrong = 0
    for (n in 0 until 100) {
        for (off in 0 until 9) {
            for (i in 0 until 256) a.store(i, 0)
            ablaUnsafeSetMemory(nativePointerFromAddress(nativePointerAddress(a.address) + 8 + off), 120, n)
            if (strlen(nativePointerFromAddress(nativePointerAddress(a.address) + 8 + off)) != n) wrong = wrong + 1
            // Starting inside the run, and at an odd offset before a terminator right after it.
            if (n > 3 && strlen(nativePointerFromAddress(nativePointerAddress(a.address) + 8 + off + 3)) != n - 3) wrong = wrong + 1
        }
    }
    wrong
}

fun compares(): int {
    var sum = 0
    for (n in 0 until 100) {
        val base = "q".repeat(n)
        for (k in 0 until n) {
            val changed = base.slice(0, k) + "r" + base.slice(k + 1, n)
            val bigger = if (changed > base) 1 else 0
            val smaller = if (changed < base) 1 else 0
            val same = if (changed == base) 1 else 0
            sum = (sum * 7 + bigger * 4 + smaller * 2 + same + k) % 1000000007
        }
        sum = (sum * 7 + (if (base == "q".repeat(n)) 1 else 0) + base.size) % 1000000007
    }
    sum
}

fun main: int {
    println("${copies()} ${compares()} ${lengths()}")
    0
}
