// Abla's native 128-bit integers (the abla/int128 and abla/uint128 intrinsics: iN add, mul,
// sdiv/udiv/srem/urem, shifts) on every Linux target. A -nostdlib AArch64 link carries no compiler
// runtime, so none of them may call __multi3, __divti3, __udivti3, __modti3 or __umodti3 (#811).
import "abla/io"
import "abla/int128"
import "abla/uint128"
fun main: int {
    val big = int128Words(u32(0x7FFFFFFF), u32(0x89ABCDEF), u32(0x01234567), u32(0xFEDCBA98))
    val neg = -big
    val m = int128Min()
    val seven = int128(7)
    val values = [big, neg, m, int128Max(), int128(-1), int128(0), int128(1), int128(-97),
        int128(123456789012345678), int128(-9223372036854775807)]
    for (a in values) {
        for (b in values) {
            if (b == int128(0)) continue
            println("${a} ${b} ${a * b} ${a / b} ${a % b} ${a + b} ${a - b}")
        }
        println("${a.shl(1)} ${a.shl(63)} ${a.shl(64)} ${a.shl(127)} ${a.shr(1)} ${a.shr(64)} ${a.shr(127)} ${a.shr(128)}")
        println("${a / seven} ${a % seven} ${-a} ${a.xor(big)} ${a.and(big)} ${a.or(seven)} ${a < big} ${a >= neg}")
    }
    val u = uint128Words(u32(0xFFFFFFFF), u32(0x12345678), u32(7), u32(9))
    val v = uint128Words(u32(1), u32(0), u32(0xFFFFFFFF), u32(3))
    println("${u * v} ${u / v} ${u % v} ${u / uint128(10)} ${u % uint128(10)} ${u.shl(100)} ${u.shr(100)} ${u - v} ${v - u}")
    0
}
