// A bad memory access in a --fast (debug) build: the fault report prints "fatal signal" and
// the stack, restores the default action and the process ends by SIGSEGV (#811).
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun main: int {
    val buffer = nativeByteBuffer(8)
    buffer.close()
    ablaUnsafeLoadI64(nativePointerFromAddress(8))
}
