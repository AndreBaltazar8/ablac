// Raw Linux system calls return the kernel's value: a failure is -errno. On x86-64
// Linux this is an inline `syscall` instruction with no libc (#806); everywhere else
// the same results come from the platform's own entry.
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun loadWord(address: int): int = ablaUnsafeLoadI64(nativePointerFromAddress(address))
trusted fun storeWord(address: int, value: int): void {
    ablaUnsafeStoreI64(nativePointerFromAddress(address), value)
    return
}

fun main: int {
    // openat(AT_FDCWD, missing, O_RDONLY): ENOENT.
    val missing = linuxSyscall4(257, -100, nativeCStringAddress("/no/such/abla-syscall-file"), 0, 0)
    if (missing != -2) return 1
    // A directory is not opened for writing: EISDIR.
    val directory = linuxSyscall4(257, -100, nativeCStringAddress("/"), 1, 0)
    if (directory != -21) return 2
    // Six arguments: mmap(0, 8192, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0).
    val mapped = linuxSyscall6(9, 0, 8192, 3, 34, -1, 0)
    if (mapped >= -4095 && mapped < 0) return 3
    if (mapped == 0) return 4
    // The sixth argument reaches the kernel: an offset that is not a page multiple is EINVAL.
    val badOffset = linuxSyscall6(9, 0, 4096, 3, 34, -1, 1)
    if (badOffset != -22) return 5
    // The fifth does too: a file mapping of descriptor -1 is EBADF.
    val badDescriptor = linuxSyscall6(9, 0, 4096, 3, 2, -1, 0)
    if (badDescriptor != -9) return 6
    // The mapping is usable and zero-filled, and munmap succeeds.
    if (loadWord(mapped) != 0) return 7
    storeWord(mapped, 4242)
    if (loadWord(mapped) != 4242) return 8
    if (linuxSyscall2(11, mapped, 8192) != 0) return 9
    // getpid and an unknown number (ENOSYS).
    if (linuxSyscall0(39) <= 0) return 10
    if (linuxSyscall0(100000) != -38) return 11
    42
}
