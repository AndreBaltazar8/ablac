// Unbounded recursion on a thread the main thread started, on every Linux target: the thread has a signal stack of
// its own and the stack guard counts a fault next to its stack pointer as an overflow, so this too prints
// "panic: stack overflow" and exits 101 (#831).
fun deep(n: int): int = if (n == 0) 0 else n - deep(n - 1)
fun main: int {
    val worker = thread { deep(-1) + 1 }
    await worker
}
