import "abla/io"

var events: string = ""
resource class Item {
    fun drop(): void { events = events + "I" }
}
resource class Holder(val item: Item) {
    fun drop(): void { events = events + "H" }
}
fun inspect(value: Item): void { events = events + "B" }
fun fresh(): Holder = Holder(Item())

fun exercise(): string {
    events = ""
    inspect(Holder(Item()).item)
    events = events + "|"
    inspect([Holder(Item())][0].item)
    events = events + "|"
    if (true) {
        val owner = Holder(Item())
        val factory: () -> Holder = { fresh() }
        inspect((if (true) factory else factory)().item)
        events = events + "|"
        inspect((if (true) Holder(Item()) else owner).item)
        events = events + "|"
        inspect((if (false) Holder(Item()) else owner).item)
        events = events + "|"
        inspect((if (true) { val local = Holder(Item()); local } else owner).item)
        events = events + "|"
        inspect((if (true) { val local = Holder(Item()); if (true) local else owner }
            else owner).item)
        events = events + "|"
    }
    events
}

fun quiet(value: Item): void {}
fun repeated(): int {
    val owner = Holder(Item())
    var count = 0
    for (i in 0 until 1000) {
        quiet((if (false) Holder(Item()) else owner).item)
        count += 1
    }
    count
}

val evaluated = #exercise()
val evaluatedRepeated = #repeated()
fun main: int {
    if (evaluatedRepeated != 1000) return 1
    println(exercise())
    println(evaluated)
    42
}
