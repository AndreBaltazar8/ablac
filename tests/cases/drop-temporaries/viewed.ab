// A view of a temporary used within its statement is fine, and the temporary is dropped after it.
import "abla/io"

var order: string = ""

class Item(var values: array<int>)

resource class Owner(val id: int, val item: Item) {
    fun drop(): void { order = order + " owner${id}" }
    fun view(): borrow(this) Item = item
}

fun make(id: int): Owner = Owner(id, Item([id * 10]))

fun main: int {
    val first = make(1).view().values[0]
    order = order + " after${first}"
    val second = make(2).view().values.size + make(3).view().values[0]
    println("$first $second$order")
    42
}
