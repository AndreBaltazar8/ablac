// A temporary in a short-circuit operand that is not evaluated is not dropped; one that is, is dropped before the
// join, and one in a loop condition or body on every pass.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun ok(): bool = true
    fun no(): bool = false
}

fun make(id: int): Res = Res(id)
fun mark(text: string) { order = order + " |" + text }

fun main: int {
    mark("and skipped"); val a = false && make(1).ok()
    mark("or skipped"); val b = true || make(2).ok()
    mark("and taken"); val c = true && make(3).ok()
    mark("or taken"); val d = false || make(4).no()
    mark("left operand"); val e = make(5).ok() && make(6).ok()
    mark("if arms"); if (c) { make(7).ok() } else { make(8).ok() }
    mark("if arm expression"); val g = if (c) make(9).ok() else make(10).ok()
    mark("else arm"); val h = if (!c) make(11).ok() else make(12).no()
    mark("condition each pass"); var i = 0
    while (make(20 + i).ok() && i < 3) { i = i + 1 }
    mark("body each pass"); for (j in 0 until 3) { if (make(30 + j).ok()) order = order + " in" }
    mark("do while"); var k = 0
    do { k = k + 1 } while (make(40 + k).ok() && k < 2)
    mark("end")
    println(order)
    42
}
