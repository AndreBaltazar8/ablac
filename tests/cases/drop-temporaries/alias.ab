// What a method returns from a temporary's field is a view of it, and the temporary is dropped at the end of the
// statement: a view kept after that sees what the drop did (here, zeroing). The memory stays valid (the field is
// a managed object); the analyzer does not refuse it.
import "abla/io"

class Data(var values: array<int>)

resource class Res(val id: int, val data: Data) {
    fun drop(): void { data.values[0] = 0 }
    fun view(): borrow(this) Data = data
}

fun make(): Res = Res(1, Data([7]))

fun main: int {
    val kept = make().view()
    println("${kept.values[0]}")
    42
}
