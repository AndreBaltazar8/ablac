// A return, break or continue in the middle of a statement drops the temporaries made so far.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun ok(): bool = true
}

fun make(id: int): Res = Res(id)
fun borrow(r: Res, tag: int): int = tag
fun mark(text: string) { order = order + " |" + text }

fun leaves(flag: bool): int {
    val total = borrow(make(1), if (flag) { return 7 } else 3)
    total
}

fun loop(): int {
    var sum = 0
    for (i in 0 until 4) {
        sum = sum + borrow(make(10 + i), if (i == 1) { continue } else if (i == 3) { break } else 1)
    }
    sum
}

fun main: int {
    mark("return"); leaves(true)
    mark("no return"); leaves(false)
    mark("break and continue"); loop()
    mark("end")
    println(order)
    42
}
