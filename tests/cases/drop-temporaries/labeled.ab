// A temporary in a statement left by a labeled `break` or `continue` is dropped once, by the frame it was made in,
// and a generator handed to a borrowing parameter (which a `for` over it consumes) is not dropped a second time.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun ok(): bool = true
}

fun make(id: int): Res = Res(id)
fun borrow(r: Res, tag: int): int = tag
fun mark(text: string) { order = order + " |" + text }

fun nested(): int {
    var hits = 0
    outer@ for (row in 0 until 4) {
        inner@ for (column in 0 until 4) {
            if (make(row * 10 + column).ok() && column > row) continue@outer
            if (borrow(make(100 + row * 10 + column), 0) == 0 && row == 2) break@outer
            hits = hits + 1
        }
    }
    hits
}

fun orBreak(): int {
    var found = 0
    search@ for (row in 0 until 3) {
        val value = borrow(make(200 + row), if (row == 1) { break@search } else 5)
        found = found + value
    }
    found
}

fun doContinue(): int {
    var turns = 0
    again@ do {
        turns = turns + 1
        for (k in 0 until 3) {
            if (borrow(make(300 + turns * 10 + k), 0) == 0 && k == 1) continue@again
        }
    } while (turns < 2)
    turns
}

fun numbers(limit: int): Generator<int> = generator {
    var value = 0
    outer@ while (true) {
        value = value + 1
        if (make(400 + value).ok() && value > limit) break@outer
        yield value
    }
}

fun collect(values: Generator<int>): int {
    var total = 0
    for (value in values) total = total + value
    total
}

fun main: int {
    mark("nested"); nested()
    mark("or break"); orBreak()
    mark("do continue"); doContinue()
    mark("generator argument"); collect(numbers(2))
    mark("end")
    println(order)
    42
}
