// A resource something takes is not dropped a second time: a constructor argument, an `own` parameter, an array
// element, a `move`, a `val` it is bound to.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun ok(): bool = true
}

class Holder(val inner: Res) {
    fun id(): int = inner.id
}

fun make(id: int): Res = Res(id)
fun consume(own r: Res): int = r.id
fun mark(text: string) { order = order + " |" + text }

fun main: int {
    mark("constructor"); val h = Holder(make(1)); order = order + " held"
    mark("holder temporary"); Holder(make(2)).id()
    mark("own"); consume(make(3))
    mark("array"); val arr = [make(4)]
    mark("move"); val a = make(5); consume(move(a))
    mark("bound"); val b = make(6); b.ok(); b.ok()
    mark("end")
    println(order)
    42
}
