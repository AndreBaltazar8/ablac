// A `for` whose body is a single expression: its temporary is dropped on every pass, and not at all when the loop
// does not run; a temporary in the source of the loop is dropped after the loop.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun ok(): bool = true
    fun items(): array<int> = [id, id + 1]
}

fun make(id: int): Res = Res(id)
fun borrow(r: Res, tag: int): int = tag
fun mark(text: string) { order = order + " |" + text }

fun main: int {
    mark("bare body"); for (i in 0 until 3) borrow(make(i), 0)
    mark("no pass"); for (i in 0 until 0) borrow(make(10), 0)
    mark("source"); for (x in make(20).items()) order = order + " item${x}"
    mark("array"); val all = [make(30), make(31)]; for (r in all) r.ok()
    mark("end")
    println(order)
    42
}
