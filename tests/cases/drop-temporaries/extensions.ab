// Extension functions: a fresh resource as the receiver or an argument of an extension function, of an extension
// operator and of an extension of another type is dropped at the end of its statement, natively and under `#`.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
}

fun make(id: int): Res = Res(id)
fun Res.ext(): int = id
fun Res.extArg(other: Res): int = other.id
fun int.withRes(r: Res): int = r.id
fun string.tagged(r: Res): string = "$this${r.id}"
operator fun Res.plus(other: Res): int = id + other.id
fun mark(text: string) { order = order + " |" + text }

fun scenario(): string {
    order = ""
    mark("receiver"); make(1).ext()
    mark("argument of another type's extension"); 5.withRes(make(2))
    mark("receiver and argument"); make(3).extArg(make(4))
    mark("operator"); val sum = make(5) + make(6)
    mark("in an interpolation"); order = order + " v=${make(7).ext()}"
    mark("string receiver"); val t = "t".tagged(make(8))
    mark("condition"); if (make(9).ext() == 9) order = order + " then"
    mark("end")
    order
}

val atCompileTime = #scenario()

fun main: int {
    val run = scenario()
    println(run)
    if (run != atCompileTime) println("# differs:$atCompileTime")
    42
}
