// Interface dispatch and default bodies: a fresh resource as the receiver of a resource interface's method, its
// default body or its extension function, or as the argument of a plain or resource interface's method or default
// body, is dropped at the end of its statement, natively and under `#` (the evaluator kept a receiver that a default
// body answered, and could not call an interface's extension function).
import "abla/io"

var order: string = ""

resource interface Held {
    fun ident(): int
    fun twice(): int = this.ident() * 2
    fun with(other: Res): int
    fun withDefault(other: Res): int = other.id + this.ident()
}

interface Taker {
    fun take(other: Res): int
    fun takeDefault(other: Res): int = other.id
}

resource class Res(val id: int) : Held {
    fun drop(): void { order = order + " ${id}" }
    fun ident(): int = id
    fun with(other: Res): int = other.id
}

class Plain(val n: int) : Taker {
    fun take(other: Res): int = other.id
}

fun make(id: int): Res = Res(id)
fun makeHeld(id: int): Held = Res(id)
fun taker(): Taker = Plain(0)
fun Held.described(): string = "held ${this.ident()}"
fun Taker.takeTwice(other: Res): int = other.id * 2
fun useHeld(h: Held): int = h.twice()
fun mark(text: string) { order = order + " |" + text }

fun scenario(): string {
    order = ""
    val t = taker()
    mark("dispatch receiver"); makeHeld(1).ident()
    mark("default body receiver"); makeHeld(2).twice()
    mark("default body through the class"); make(3).twice()
    mark("dispatch argument"); makeHeld(4).with(make(5))
    mark("default body argument"); makeHeld(6).withDefault(make(7))
    mark("interface extension receiver"); makeHeld(8).described()
    mark("plain interface argument"); t.take(make(10))
    mark("plain default body argument"); t.takeDefault(make(11))
    mark("plain interface extension argument"); t.takeTwice(make(12))
    mark("interface parameter"); useHeld(make(13))
    mark("end")
    order
}

val atCompileTime = #scenario()

fun main: int {
    val run = scenario()
    println(run)
    if (run != atCompileTime) println("# differs:$atCompileTime")
    42
}
