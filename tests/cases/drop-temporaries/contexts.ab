// Temporaries inside a lambda, a generator, a `defer`, expression-bodied functions and a global's initializer.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun ok(): bool = true
    fun touch(): void { order = order + " touched${id}" }
}

fun make(id: int): Res = Res(id)
fun borrow(r: Res, tag: int): int = tag
fun mark(text: string) { order = order + " |" + text }
fun shortBody(id: int): bool = make(id).ok()
fun valueBody(id: int): int = borrow(make(id), id * 2)

fun deferred() {
    defer { if (make(53).ok()) order = order + " deferred" }
    defer { make(55).touch() }
    make(54).ok()
}

val initial = make(90).ok()


fun numbers(limit: int): Generator<int> = generator {
    var value = 0
    while (value < limit) {
        if (make(60 + value).ok()) yield value
        value = value + 1
    }
}

fun main: int {
    mark("lambda"); val f = { make(50).ok() }; f()
    mark("expression body"); shortBody(51); valueBody(52)
    mark("defer"); deferred()
    mark("generator"); var total = 0
    for (v in numbers(2)) total = total + v
    mark("generator break"); for (v in numbers(5)) if (v == 1) break
    mark("end")
    println(order)
    42
}
