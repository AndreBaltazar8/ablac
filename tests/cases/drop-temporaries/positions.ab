// A resource that is only a temporary (the receiver of a method or a field read, the argument of a borrowing
// parameter) is dropped at the end of its statement, or of the condition or subject it is part of, newest first.
// Every drop adds its id to `order`; the markers `|n` say where each case starts.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun ok(): bool = true
    fun wrap(other: Res): int = id + other.id
}

fun make(id: int): Res = Res(id)
fun maybeMake(id: int): Res? = Res(id)
fun borrow(r: Res, tag: int): int = tag
fun borrow2(a: Res, b: Res): int = a.id + b.id
fun consume(own r: Res): int = r.id
fun pass(id: int): Res = make(id)
fun next(r: Res): Res = Res(r.id + 100)
fun mark(text: string) { order = order + " |" + text }
fun early(flag: bool): int {
    if (flag) return borrow(make(30), 1)
    borrow(make(31), 2)
}

fun main: int {
    mark("receiver"); if (make(1).ok()) order = order + " body"
    mark("borrowed argument"); borrow(make(2), 5)
    mark("discarded result"); make(3)
    mark("if condition"); if (make(4).ok()) order = order + " then"
    mark("while condition"); var n = 0
    while (make(5).ok() && n < 2) { n = n + 1 }
    mark("when subject"); when (make(6).id) { 6 -> order = order + " six" else -> order = order + " other" }
    mark("loop body"); for (i in 0 until 2) { make(7) }
    mark("field of a temporary"); val f = make(8).id
    mark("early return"); early(true); early(false)
    mark("two arguments"); borrow2(make(10), make(11))
    mark("receiver and argument"); make(12).wrap(make(13))
    mark("own parameter"); consume(make(14))
    mark("moved into a val"); val owner = make(15); order = order + " owner-made"
    mark("interpolation"); order = order + " v=${make(16).id}"
    mark("returned by a call"); pass(17).ok()
    mark("safe call"); maybeMake(18)?.ok()
    mark("array literal"); val arr = [make(19), make(20)]
    mark("nested"); borrow(next(make(21)), 0)
    mark("end")
    println(order)
    42
}
