import "abla/io"

var events: string = ""
resource class Item(val id: int) {
    fun drop(): void { events = events + "I$id" }
}
resource class Holder(val item: Item) {
    fun drop(): void { events = events + "H" }
}
fun inspect(value: Item): int { events = events + "B${value.id}"; value.id }
fun early(): int { return inspect(Holder(Item(Holder(Item(3)).item.id + 1)).item) }
fun nestedDefault(x: int = Holder(Item(Holder(Item(11)).item.id + 1)).item.id): int {
    events = events + "F$x"
    x
}
fun exercise(): string {
    events = ""
    inspect(Holder(Item(Holder(Item(1)).item.id + 1)).item)
    events = events + "|"
    early()
    events = events + "|"
    inspect((if (true) Holder(Item(Holder(Item(5)).item.id + 1)) else Holder(Item(99))).item)
    events = events + "|"
    inspect([Holder(Item(Holder(Item(7)).item.id + 1))][0].item)
    events = events + "|"
    for (v in generator { inspect(Holder(Item(Holder(Item(9)).item.id +
        1)).item); yield 1 }) { events = events + "Y$v" }
    events = events + "|"
    nestedDefault()
    events = events + "|"
    inspect((when (1) { 1 -> Holder(Item(Holder(Item(13)).item.id +
        1)) else -> Holder(Item(99)) }).item)
    events = events + "|"
    for (i in 0 until 2) {
        inspect((if (i == 0) Holder(Item(19)) else Holder(Item(Holder(Item(17)).item.id + 1))).item)
        events = events + ","
    }
    events = events + "|"
    events
}
val evaluated = #exercise()
fun main: int {
    println(exercise())
    println(evaluated)
    42
}
