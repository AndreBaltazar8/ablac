// Generic instances: a fresh resource as the argument of a generic function, of a generic class's method, of a
// bounded generic (T = the resource), of a generic extension and of a call that returns T, is dropped at the end of
// its statement, natively and under `#`.
import "abla/io"

var order: string = ""

resource interface Held {
    fun ident(): int
}

resource class Res(val id: int) : Held {
    fun drop(): void { order = order + " ${id}" }
    fun ident(): int = id
}

class Box<T>(val value: T) {
    fun look(r: Res): int = r.id
    fun keep(r: Res, x: T): T = x
}

class Viewer<T>(val tag: int) {
    fun see(x: T): int = tag
}

fun make(id: int): Res = Res(id)
fun <T> gen(r: Res, x: T): int = r.id
fun <T> seeIt(x: T): int = 1
fun <T : Held> identOf(x: T): int = x.ident()
fun <T> T.genExt(r: Res): int = r.id
fun <T> pick(r: Res, x: T): T = x
fun mark(text: string) { order = order + " |" + text }

fun scenario(): string {
    order = ""
    val box = Box("s")
    val viewer = Viewer<Res>(0)
    mark("generic function"); gen(make(1), 1)
    mark("generic class method"); box.look(make(2))
    mark("returns T"); box.keep(make(3), "x"); pick(make(4), 2)
    mark("T is the resource"); seeIt(make(5)); viewer.see(make(6))
    mark("bounded"); identOf(make(7))
    mark("generic extension"); 3.genExt(make(8))
    mark("end")
    order
}

val atCompileTime = #scenario()

fun main: int {
    val run = scenario()
    println(run)
    if (run != atCompileTime) println("# differs:$atCompileTime")
    42
}
