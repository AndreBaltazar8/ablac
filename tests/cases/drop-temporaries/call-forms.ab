// Calls that lower through other paths: named and default arguments, overloads, a function value, a lambda, a
// `when` arm. Built-in container methods take a resource only to own it (`append`, a map's `set`), so a temporary
// reaches them only through a field or a method's result, which drops it as for any receiver. Each is dropped at
// the end of its statement, natively and under `#`.
import "abla/io"

var order: string = ""

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}" }
    fun name(): string = "r$id"
    fun items(): array<int> = [id, id + 1]
}

fun make(id: int): Res = Res(id)
fun borrow(r: Res, tag: int): int = tag
fun named(r: Res, tag: int = 0): int = tag
fun over(r: Res): int = 1
fun over(r: Res, n: int): int = n
fun viaFn(f: (Res) -> int): int = f(make(9))
fun mark(text: string) { order = order + " |" + text }

fun scenario(): string {
    order = ""
    val names: Map<string, int> = Map()
    names.set("r12", 1)
    val list = [0]
    mark("named"); named(tag = 1, r = make(1))
    mark("default"); named(make(2))
    mark("overloads"); over(make(3)); over(make(4), 2)
    mark("function value"); val f = borrow; f(make(5), 1)
    mark("lambda"); val g = { r: Res -> r.id }; g(make(6))
    mark("when arm"); when (1) { 1 -> borrow(make(7), 0) else -> 0 }
    mark("callee's lambda"); viaFn({ r: Res -> r.id })
    mark("for over a method's array"); for (x in make(10).items()) { order = order + " x$x" }
    mark("array append of a field"); list.append(make(11).id)
    mark("map key from a method"); val v = names.get(make(12).name()) ?? 0
    mark("end")
    order
}

val atCompileTime = #scenario()

fun main: int {
    val run = scenario()
    println(run)
    if (run != atCompileTime) println("# differs:$atCompileTime")
    42
}
