// The compile-time evaluator drops temporaries where the compiled program does: the drops of the cases below, as
// a hash of their order, evaluated by `#` and run natively, must agree. (A `continue` or `break` inside a call's
// argument is not covered here: the evaluator does not pass it through arithmetic; the compiled `exits` case has it.)
import "abla/io"

var order: string = ""
var hash: int = 0

resource class Res(val id: int) {
    fun drop(): void { order = order + " ${id}"; hash = hash * 31 + id }
    fun ok(): bool = true
    fun no(): bool = false
    fun wrap(other: Res): int = id + other.id
    fun items(): array<int> = [id, id + 1]
}

class Holder(val inner: Res) {
    fun id(): int = inner.id
}

fun make(id: int): Res = Res(id)
fun maybeMake(id: int): Res? = Res(id)
fun borrow(r: Res, tag: int): int = tag
fun borrow2(a: Res, b: Res): int = a.id + b.id
fun consume(own r: Res): int = r.id
fun pass(id: int): Res = make(id)
fun next(r: Res): Res = Res(r.id + 100)
fun shortBody(id: int): bool = make(id).ok()
fun early(flag: bool): int {
    if (flag) return borrow(make(30), 1)
    borrow(make(31), 2)
}
fun leaves(flag: bool): int {
    val total = borrow(make(40), if (flag) { return 7 } else 3)
    total
}
fun body(): int {
    if (make(1).ok()) order = order + " body"
    borrow(make(2), 5)
    make(3)
    if (make(4).ok()) order = order + " then"
    var n = 0
    while (make(5).ok() && n < 2) { n = n + 1 }
    when (make(6).id) { 6 -> order = order + " six" else -> order = order + " other" }
    for (i in 0 until 2) { make(7) }
    val f = make(8).id
    early(true); early(false); leaves(true); leaves(false)
    borrow2(make(10), make(11))
    make(12).wrap(make(13))
    consume(make(14))
    val owner = make(15)
    order = order + " v=${make(16).id}"
    pass(17).ok()
    maybeMake(18)?.ok()
    val arr = [make(19), make(20)]
    borrow(next(make(21)), 0)
    val a = false && make(22).ok()
    val b = true || make(23).ok()
    val c = true && make(24).ok()
    val d = false || make(25).no()
    val e = make(26).ok() && make(27).ok()
    val g = if (c) make(28).ok() else make(29).ok()
    var i = 0
    while (make(60 + i).ok() && i < 3) { i = i + 1 }
    for (j in 0 until 3) { if (make(70 + j).ok()) order = order + " in" }
    for (j in 0 until 3) borrow(make(80 + j), 0)
    for (x in make(90).items()) order = order + " item${x}"
    Holder(make(91)).id()
    val h = Holder(make(92))
    shortBody(93)
    val fn = { make(94).ok() }
    fn()
    val x = make(95).id
    val afterHole = { x + make(96).id }
    afterHole()
    var k = 0
    while (k < 10000) { if (make(97).ok()) k = k + 1 }
    val inLambda = { var t = 0; while (t < 2) { when (make(98).id) { 98 -> { if (make(99).ok()) { t = t + 1 } } else -> { t = 5 } } }; t }
    inLambda()
    0
}

val evaluated = #signature()

fun signature(): int {
    body()
    hash
}

fun main: int {
    body()
    val same = evaluated == hash
    println("${same}")
    if (same) 42 else 1
}
