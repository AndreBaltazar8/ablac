resource class Item
resource class Holder(val item: Item)
fun take(own value: Item): void {}
fun bind(): void { val x = Holder(Item()).item }
fun own(): void { take(Holder(Item()).item) }
fun returned(): Item { return Holder(Item()).item }
fun assigned(): void { var x = Item(); x = Holder(Item()).item }
fun moved(): void { val x = move(Holder(Item()).item) }
fun main: int = 0
