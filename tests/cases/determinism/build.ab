import "abla/wasm/build"

// The release module registers the target; the development module reuses it.
val release = #wasmBuildModule(
    "determinism",
    "tests/cases/determinism/module.ab",
    "build/determinism/determinism.wasm",
    false,
    false
)
val fast = #buildProgram(
    "determinism-fast",
    "tests/cases/determinism/module.ab",
    "build/determinism/determinism-fast.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && fast) 0 else 1
