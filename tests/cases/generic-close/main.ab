import "abla/io"

class CloseFields(
    val one: array<int>= [1],
    val two: array<array<int>>= [[2]],
    val three: array<array<array<int>>>= [[[3]]],
    var more: array<array<array<int>>>= [[[4]]]
)
fun defaultOne(xs: array<int>= [5]): array<int>= [xs[0]]
fun defaultTwo(xs: array<array<int>>= [[6]]): array<array<int>>= [[xs[0][0]]]
fun defaultThree(xs: array<array<array<int>>>= [[[7]]]): array<array<array<int>>>= [[[xs[0][0][0]]]]
fun <T> closeIdentity(x: T): T = x
fun array<array<array<int>>>.closeSize(): int = this.size

fun main: int {
    val one: array<int>= [1, 2]
    var mutableOne: array<int>= [9]
    var two: array<array<int>>= [[3]]
    var mutableThree: array<array<array<int>>>= [[[10]]]
    val three: array<array<array<int>>>= [[[4]]]
    val empty = array<array<array<int>>>()
    val called = closeIdentity<array<array<array<int>>>>(three)
    val fields = CloseFields()
    mutableOne = [11]
    two = [[8]]
    mutableThree = [[[12]]]
    val count = { xs: array<array<array<int>>> -> xs.size }
    if (mutableOne[0] != 11 || mutableThree[0][0][0] != 12) return 7
    if (one[1] != 2 || two[0][0] != 8 || called[0][0][0] != 4) return 1
    if (empty.size != 0 || fields.one[0] != 1 || fields.two[0][0] != 2) return 2
    if (fields.three[0][0][0] != 3 || fields.more[0][0][0] != 4) return 3
    if (defaultOne()[0] != 5 || defaultTwo()[0][0] != 6 || defaultThree()[0][0][0] != 7) return 4
    if (count(three) != 1 || three.closeSize() != 1) return 5
    if (!(8 >= 8) || 8 >= 9 || (64 >> 2) != 16 || (64 >>> 3) != 8) return 6
    println("generic closes: passed")
    42
}
