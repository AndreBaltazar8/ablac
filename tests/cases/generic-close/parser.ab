import "../../../src/formatter.ab"
import "../../../src/subparser.ab"
import "abla/io"
fun split(source: string, depth: int, left: string, right: string): bool {
    val tokens = bootstrapLex(source)
    val parser = BootstrapParser("<split>", source, tokens, [], [], [], 0, 0, "", [], [], 0, -1, 0,
        "")
    parser.prepareTypeClose(depth)
    if (!parser.at(if (left.size ==
        1) BOOTSTRAP_TOKEN_GREATER else BOOTSTRAP_TOKEN_SHIFT_RIGHT)) return false
    bootstrapTokenText(source, parser.tokens[0]) == left &&
        bootstrapTokenText(source, parser.tokens[1]) == right &&
        parser.tokens[0].end == parser.tokens[1].begin &&
        tokens[0].kind == bootstrapLex(source)[0].kind
}

fun main: int {
    val cases = [
        "fun main { val x: array<int>= [1, 2] }",
        "fun main { val x: array<array<int>>= [] }",
        "fun main { val x: array<array<array<int>>>= [] }",
        "fun f(x: array<int>= [1]): array<int>= x",
        "class C(val x: array<array<int>>= [])",
        "fun main { val x: array<int>= []; val f = { item: array<int> -> item.size } }",
        "fun <T: array<array<int>>> f(x: T): T = x",
        "fun <T: Source<array<array<int>>>> f(x: T): T = x",
        "class Box<T: Source<array<int>>>(val x: T)",
        "fun main { val x = array<array<array<int>>>() }",
        "fun main { val x = f<array<array<int>>>() }",
        "fun main { val x = value as? Box<array<array<int>>> }",
        "fun Box<array<array<int>>>.f(): int = 1",
        "fun main { val x = value as? Box<int>>= rhs }",
        "fun main { val x = value as? Box<array<int>>>= rhs }"
    ]
    var failures = 0
    val bounded = bootstrapParse("fun <T: Source<array<int>>> f(x: T): T = x")
    if (bounded.errors != 0 || bounded.declarations[0].typeParameters[0] !=
        "T:Source<array<int>>") return 21
    // Graph memo streams must survive private contextual token splitting.
    val sharedSource = "fun main { val x: array<int>= [1] }"
    val sharedTokens = bootstrapLexShared(sharedSource)
    val tokenCount = sharedTokens.size
    val first = bootstrapParseWithIdentity(sharedSource, "shared.ab")
    val second = bootstrapParseWithIdentity(sharedSource, "shared.ab")
    if (sharedTokens.size != tokenCount || first.errors != 0 || second.errors != 0) return 10
    if (!bootstrapFormatAstEqual(first, second, sharedTokens, sharedTokens)) return 11
    var hasCompound = false
    for (token in sharedTokens) if (token.kind == BOOTSTRAP_TOKEN_GREATER_EQUAL) hasCompound = true
    if (!hasCompound) return 12
    val freshTokens = bootstrapLex(sharedSource)
    for (i in 0 until tokenCount) {
        if (sharedTokens[i].kind != freshTokens[i].kind ||
            sharedTokens[i].begin != freshTokens[i].begin ||
            sharedTokens[i].end != freshTokens[i].end) return 13
    }
    if (!split(">=", 1, ">", "=")) return 14
    if (!split(">>=", 1, ">", ">=")) return 15
    if (!split(">>>=", 1, ">", ">>")) return 16
    if (!split(">>>=", 2, ">>", ">=")) return 17
    if (!split(">> =", 1, ">", ">")) return 18
    val cursorSource = "{ val xs: array<int>= [1]; xs.size } )"
    val cursorTokens = bootstrapLex(cursorSource)
    val cursor = BootstrapSubparserCursor("<cursor>", cursorSource, cursorTokens, [], [], [], 0, 0,
        0)
    val expression = cursor.parseAblaExpression()
    cursor.expect(")")
    if (cursor.errors != 0 || cursor.rawPosition != cursorSource.size || expression.kind !=
        "lambda") return 19
    var originalCompound = false
    for (token in cursorTokens) if (token.kind == BOOTSTRAP_TOKEN_GREATER_EQUAL) originalCompound =
        true
    if (!originalCompound) return 20
    for (source in cases) {
        val parsed = bootstrapParse(source)
        if (parsed.errors != 0) { println("PARSE $source: ${parsed.diagnostics}"); failures += 1 }
        val formatted = bootstrapFormat(source)
        if (formatted.error != "") { println("FMT $source: ${formatted.error}"); failures += 1 }
        else {
            val again = bootstrapFormat(formatted.text)
            if (again.text != formatted.text || again.error !=
                "") { println("IDEMPOTENCE $source"); failures += 1 }
        }
    }
    val rejected = [
        "fun main { val x: array<int>>= [] }",
        "fun main { val x: array<array<int>= [] }",
        "fun main { val x: array<array<array<int>>= [] }",
        "fun main { var x = 8; x >>= 1 }"
    ]
    for (source in rejected) if (bootstrapParse(source).errors == 0) {
        println("UNEXPECTED PARSE $source")
        failures += 1
    }
    if (failures == 0) println("generic closes parser: passed")
    if (failures == 0) 42 else 1
}
