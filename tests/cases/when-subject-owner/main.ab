import "abla/io"
var log: string = ""
resource interface Face { fun id(): int }
resource class Item(val value: int): Face {
    fun id(): int = value
    fun drop(): void { log += "I$value" }
}
resource class Holder(val item: Item) { fun drop(): void { log += "H" } }
class View(val value: int) { fun look(): int { log += "B$value"; value } }
class Pair<A, B>(val first: A, val second: B)
resource class Outer(val inner: View?) { fun drop(): void { log += "H" } }
resource class TextItem(val value: int) {
    fun drop(): void { log += "I$value" }
    fun toString(): string { log += "T$value"; "item$value" }
}
fun face(n: int): Face = Item(n)
fun maybeOuter(flag: bool): Outer? = if (flag) Outer(View(4)) else null
fun maybeItem(flag: bool): TextItem? = if (flag) TextItem(5) else null
fun ignore(own callback: FnOnce() -> int): void { log += "C" }
fun subject(flag: bool): void {
    val held: Face = Item(3)
    when (if (flag) face(1) else held) { is Item -> log += "Y" else -> log += "N" }
    log += "|"
}
fun early(): int {
    defer { log += "D" }
    when (face(1)) { is Item -> { log += "Y"; return 1 } else -> 0 }
    0
}
fun leaveLoop(): void {
    for (i in 0 until 1) {
        when (face(1)) { is Item -> { log += "Y"; break } else -> {} }
    }
}
fun generated(): Generator<int> = generator {
    when (face(1)) { is Item -> { log += "Y"; yield 1; log += "Z" } else -> {} }
}
fun generatedRepeated(): Generator<int> = generator {
    for (i in 1 until 3) {
        when (face(i)) { is Item -> { defer { log += "D" }; log += "Y"; yield i } else -> {} }
    }
}
fun generatedSource(): Generator<int> = generator {
    for (x in when (face(Holder(Item(2)).item.value - 1)) {
        is Item -> [Item(4)] else -> []
    }) { log += "B${x.value}"; yield x.value }
}
fun exercise(): string {
    log = ""
    when (face(1)) { is Item -> log += "Y" else -> log += "N" }; log += "|"
    when (face(Holder(Item(2)).item.value - 1)) { is Item -> log += "Y" else -> log += "N" }; log +=
        "|"
    subject(true); log += "|"
    subject(false); log += "|"
    early(); log += "|"
    leaveLoop(); log += "|"
    maybeOuter(true)?.inner?.look(); log += "|"
    maybeOuter(false)?.inner?.look(); log += "|"
    val text = "${TextItem(6).toString()}"; log += "V$text|"
    (maybeItem(true) ?? TextItem(7)).toString(); log += "|"
    (maybeItem(false) ?? TextItem(7)).toString(); log += "|"
    for (x in generated()) {}; log += "|"
    for (x in generated()) { break }; log += "|"
    if (true) { val unused = generated() }; log += "|"
    for (x in generatedRepeated()) {}; log += "|"
    for (x in generatedRepeated()) { break }; log += "|"
    if (true) { val pair = Pair(Item(8), 2); log += "B${pair.first.value}" }; log += "|"
    val captured = Item(9); ignore(move { captured.value }); log += "|"
    val f = { -> if (true) { if (true) Item(10) else Item(11) } else Item(12) }
    if (true) { val item = f(); log += "B${item.value}" }; log += "|"
    for (x in generatedSource()) {}; log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
