// An object made at compile time keeps the extension fields it was given.
import "abla/io"

class Point(val x: int)
var Point.label: string = "none"

fun make(): Point {
    val p = Point(2)
    p.label = "lifted"
    p
}

val lifted = #make()

fun main {
    println("${lifted.x} ${lifted.label}")
}
