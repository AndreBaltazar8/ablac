// `#` code sees extension fields as compiled code does.
import "abla/io"

class Point(val x: int)
class Node(val name: string)

var Point.label: string = "none"
var Point.hits: int = this.x * 10
var Node.children: array<string> = []
val Point.born: int = 0

fun scenario(): string {
    val p = Point(3)
    var out = "${p.label} ${p.hits}"
    p.label = "named"
    p.hits = p.hits + 1
    out = "$out|${p.label} ${p.hits}"
    val n = Node("root")
    out = "$out|${n.children.size}"
    n.children.append("a")
    n.children.append("b")
    out = "$out|${n.children.size}|${p.born}"
    p.born = 7
    out = "$out|${p.born}"
    // Another instance, made after the first gained fields, has none of them.
    out = "$out|${Point(5).hits}"
    out
}

val atCompileTime = #scenario()

fun main {
    println(atCompileTime)
    println(scenario())
}
