// Extension fields read their default until set (a default may use `this`),
// keep a default a mutation goes through, and a `val` takes one assignment.
import "abla/io"

class Point(val x: int)
class Node(val name: string)

var Point.label: string = "none"
var Point.hits: int = this.x * 10
var Node.children: array<string> = []
val Point.born: int = 0

fun main {
    val p = Point(3)
    println("${p.label} ${p.hits}")
    p.label = "named"
    p.hits = p.hits + 1
    println("${p.label} ${p.hits}")
    val n = Node("root")
    println("${n.children.size}")
    n.children.append("a")
    n.children.append("b")
    println("${n.children.size}")
    println("${p.born}")
    p.born = 7
    println("${p.born}")
    val q = Point(5)
    println("${q.label} ${q.hits} ${q.born}")
}
