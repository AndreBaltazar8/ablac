// Affine extension fields drop with their (affine) owner, after its declared
// fields, from the last set to the first; an assignment drops what it replaces.
import "abla/io"

resource class Ticket(val id: int) {
    fun drop(): void {
        println("drop ticket ${id}")
        return
    }
}
resource class Holder(val name: string) {
    fun drop(): void {
        println("drop holder ${name}")
        return
    }
}
class Plain(val x: int)

var Holder.first: Ticket? = null
var Holder.second: Ticket? = null
var Holder.count: int = 0

fun main {
    val h = Holder("h")
    h.first = Ticket(1)
    h.count = 3
    h.second = Ticket(2)
    h.first = Ticket(3)
    println("before drop")
}
