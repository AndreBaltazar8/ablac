import "abla/io"
import "./point.ab"
import "./tags.ab"

class Bag(val id: int)
var Bag.items: array<int> = []
fun Bag.add(item: int): void {
    items.append(item)
    return
}

fun main {
    val p = Point(4)
    println(p.describe())
    p.mark("+")
    println("${p.tag} ${p.describe()}")
    val b = Bag(1)
    b.add(5)
    b.add(6)
    println("${b.items.size}")
}
