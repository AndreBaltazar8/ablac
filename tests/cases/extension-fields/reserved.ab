// Reserved syntax is reported as not supported yet, never read as something else.
sealed class Marker(val n: int)
interface Shape {
    fun area(): int
    type Item
}
fun <T> first(items: array<T>): T = items[0]
fun pick(x: int): int where T : Shape = x
class Box<const N: int>(val v: int)
fun main: int {
    val where = 1
    val sealed = 2
    return where + sealed
}
