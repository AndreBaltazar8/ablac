// The compiler API lists, adds and removes extension fields.
import "abla/io"
import "abla/compiler"

class Enemy(val level: int)

var Enemy.unused: int = 0
var Enemy.tag: string = "e"

compile fun fields(): void {
    val enemy = compiler.findClass("Enemy")
    compiler.addExtensionField(enemy, "maxHp", "int", "this.level * 10")
    compiler.addExtensionField(enemy, "seen", "bool", "false", false)
    compiler.removeExtensionField(enemy, "unused")
    return
}

#compiler.transform(fields)

compile fun listed(): string {
    val enemy = compiler.findClass("Enemy")
    var names = ""
    for (name in compiler.fieldsOf(enemy)) names = "$names $name"
    names = "$names |"
    for (name in compiler.fieldsOf(enemy, false)) names = "$names $name"
    names
}

val names = #listed()

fun main {
    val enemy = Enemy(3)
    println("${enemy.maxHp} ${enemy.seen} ${enemy.tag}")
    println(names)
}
