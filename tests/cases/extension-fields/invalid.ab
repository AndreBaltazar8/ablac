// Each malformed extension field is reported once.
class Point(val x: int) {
    fun area(): int = x * x
}
interface Shape {
    fun size(): int
}
type Meters = int

var Point.label: string = ""
var Point.untyped = 1
var Point.missing: int
var Point.x: int = 0
var Point.area: int = 0
var int.bad: int = 0
var Shape.bad2: int = 0
var Meters.bad3: int = 0
var Nowhere.bad4: int = 0
var Point.label: string = "again"
var Point.wrong: int = "text"

fun main: int = 0
