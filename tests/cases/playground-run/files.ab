import "abla/fs"
import "abla/io"

fun main: int {
    val seed = path("fixture/input.txt")
    val output = path("nested/output.txt")
    if (seed.readText() != "seed") return 81
    if (!output.writeText(seed.readText()) || !output.appendText(" + output")) return 82
    if (output.info().size != 13 || output.readText() != "seed + output") return 83
    if (path("/fixture/input.txt").readTextResult().errorCode != 13 ||
        path("../fixture/input.txt").readTextResult().errorCode != 13) return 84
    println(output.readText())
    0
}
