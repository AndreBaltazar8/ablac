// `x == null` and `x != null` on nullable values read the value's tag. Every kind of
// nullable element, both operand orders, as conditions, values and chained with && and ||,
// natively and under `#` (the results must agree).
import "abla/io"
import "abla/float"

class Node(val value: int, val next: Node?)

@noinline fun id(x: int?): int? = x
@noinline fun idText(x: string?): string? = x
@noinline fun idFloat(x: f64?): f64? = x
@noinline fun idNode(x: Node?): Node? = x
@noinline fun idList(x: array<int>?): array<int>? = x
@noinline fun idMap(x: Map<string, int>?): Map<string, int>? = x

fun newMap(): Map<string, int> {
    val m: Map<string, int> = Map()
    m
}

fun flag(b: bool): string = if (b) "1" else "0"

fun report(
    number: int?, text: string?, real: f64?, node: Node?, list: array<int>?,
    table: Map<string, int>?
): string {
    var out = ""
    out = out + flag(number == null) + flag(number != null) + flag(null == number) + flag(null !=
        number)
    out = out + flag(text == null) + flag(text != null) + flag(real == null) + flag(real != null)
    out = out + flag(node == null) + flag(node != null) + flag(list == null) + flag(list != null)
    out = out + flag(table == null) + flag(table != null)
    val both = node != null && list != null
    val either = number == null || text == null
    val chain = node != null && node.next != null && number != null
    val negated = !(node == null)
    out = out + flag(both) + flag(either) + flag(chain) + flag(negated)
    var counted = 0
    if (number != null) counted = counted + 1
    if (text == null) counted = counted + 10
    while (counted < 3 && node != null) counted = counted + 1
    out + "${counted}"
}

fun cases(): array<string> {
    val out: array<string> = []
    val node = Node(1, Node(2, null))
    out.append(report(id(5), idText("a"), idFloat(1.5), idNode(node), idList([1]), idMap(newMap())))
    out.append(report(id(null), idText(null), idFloat(null), idNode(null), idList(null),
        idMap(null)))
    out.append(report(id(0), idText(""), idFloat(0.0), idNode(Node(3, null)), idList([]),
        idMap(null)))
    out.append(report(id(null), idText("x"), idFloat(null), idNode(node), idList(null),
        idMap(newMap())))
    out.append(report(null, null, null, null, null, null))
    out
}

compile fun casesStaged(): array<string> {
    val out: array<string> = []
    val node = Node(1, Node(2, null))
    out.append(report(5, "a", 1.5, node, [1], newMap()))
    out.append(report(null, null, null, null, null, null))
    out.append(report(0, "", 0.0, Node(3, null), [], null))
    out.append(report(null, "x", null, node, null, newMap()))
    out.append(report(null, null, null, null, null, null))
    out
}

fun main: int {
    val native = cases()
    val staged = #casesStaged()
    var bad = 0
    var i = 0
    while (i < native.size && i < staged.size) {
        if (native[i] != staged[i]) {
            bad = bad + 1
            println("native: ${native[i]}\nstaged: ${staged[i]}")
        }
        i = i + 1
    }
    if (native.size != staged.size) bad = bad + 1
    // The expected strings, so both sides cannot be wrong alike.
    val expected = [
        "0101010101010110113", "10101010101010010010", "0101010101011010013",
        "1010011001100101013", "10101010101010010010"
    ]
    var k = 0
    while (k < expected.size) {
        if (native[k] != expected[k]) {
            bad = bad + 1
            println("case ${k}: ${native[k]} expected ${expected[k]}")
        }
        k = k + 1
    }
    if (bad == 0) 42 else 1
}
