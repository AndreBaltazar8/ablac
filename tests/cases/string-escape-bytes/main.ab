import "abla/io"

// A string literal's escapes, by the bytes they stand for: \n \r \t \b \0 \" \' \\ \$, \xHH (one byte), \uXXXX (exactly four hex
// digits) and \u{H} to \u{HHHHHH} (a Unicode scalar value, stored as UTF-8). A hex digit after an escape is text: \u0000argument
// was read as \u0000a plus rgument (byte 10), so a \uXXXX before a-f or 0-9 took the following digits for its own (#953).
// Every case runs at run time and again in a # build.
class Case(val name: string, val text: string, val expected: array<int>)

fun byteValues(value: string): array<int> {
    val result: array<int> = []
    for (index in 0 until value.size) result.append(value[index])
    result
}

fun show(values: array<int>): string {
    var shown = ""
    for (value in values) shown = "$shown$value "
    shown
}

fun cases(): array<Case> = [
    Case("zero", "\u0000", [0]),
    Case("zero then hex letter", "\u0000argument", [0, 97, 114, 103, 117, 109, 101, 110, 116]),
    Case("zero then hex digit", "\u00001", [0, 49]),
    Case("ascii then letters", "\u0041bc", [65, 98, 99]),
    Case("ascii then digits", "\u0041123", [65, 49, 50, 51]),
    Case("control range", "\u0001b\u001f1\u0009a", [1, 98, 31, 49, 9, 97]),
    Case("delete", "\u007fe", [127, 101]),
    Case("two bytes then letter", "\u00e9a", [195, 169, 97]),
    Case("two bytes, top", "\u07ffd", [223, 191, 100]),
    Case("two bytes, bottom", "\u0080f", [194, 128, 102]),
    Case("three bytes, bottom", "\u0800a", [224, 160, 128, 97]),
    Case("three bytes, below the surrogates", "\ud7ffb", [237, 159, 191, 98]),
    Case("three bytes, above the surrogates", "\ue000c", [238, 128, 128, 99]),
    Case("three bytes, top", "\uffffd", [239, 191, 191, 100]),
    Case("braced, one digit", "\u{0}a", [0, 97]),
    Case("braced, ascii", "\u{41}b", [65, 98]),
    Case("braced, two bytes", "\u{e9}a", [195, 169, 97]),
    Case("braced, three bytes", "\u{20ac}c", [226, 130, 172, 99]),
    Case("braced, four bytes", "\u{1F600}a", [240, 159, 152, 128, 97]),
    Case("braced, first four-byte", "\u{10000}", [240, 144, 128, 128]),
    Case("braced, top", "\u{10FFFF}", [244, 143, 191, 191]),
    Case("braced, leading zeros", "\u{000041}b", [65, 98]),
    Case("byte escape", "\x41b", [65, 98]),
    Case("byte escape, zero", "\x00a", [0, 97]),
    Case("byte escape, high", "\xffa\x80", [255, 97, 128]),
    Case("simple escapes", "\n\r\t\b\0\"\'\\\$", [10, 13, 9, 8, 0, 34, 39, 92, 36]),
    Case("zero escape then digits", "\0001", [0, 48, 48, 49]),
    Case("escapes side by side", "\u0041\u0042\x43\u{44}", [65, 66, 67, 68]),
    Case("a multibyte character as written", "é€😀", [195, 169, 226, 130, 172, 240, 159, 152, 128]),
]

fun failures(report: bool): int {
    var failed = 0
    for (item in cases()) {
        val got = byteValues(item.text)
        var same = got.size == item.expected.size
        if (same) for (index in 0 until got.size) if (got[index] != item.expected[index]) same = false
        if (!same) {
            failed += 1
            if (report) println("${item.name}: got ${show(got)}, expected ${show(item.expected)}")
        }
    }
    failed
}

fun main: int {
    val folded = #failures(false)
    val run = failures(true)
    println("run: $run failing, compile time: $folded failing")
    if (run == 0 && folded == 0) 42 else 1
}
