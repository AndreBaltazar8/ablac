// Intrinsics the standard library's crypto reaches, which the interpreter lacked (tools/test-ct-interp-intrinsics.sh):
// ablaCtScrubBounded (every ctScrubStack* wipe: sha3, chacha20poly1305, ed25519, aes) and nativeStaticBytes /
// nativeStaticMutableBytes (ML-KEM's and SHA's tables). Each line is the same under `#` and at run time.
import "abla/io"
import "abla/compiler"
import "abla/ct/scrub"
import "abla/crypto/sha3"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

#compilerGrant("trusted.native")

fun digest(s: string): string {
    var h = 0
    for (b in s) h = (h * 31 + b) % 1000000007
    "${s.size}:$h"
}

trusted fun staticBytes(): string {
    val table = nativeStaticBytes("\x01\x02\x00\xff")
    "${ablaUnsafeLoadU8(nativePointerFromAddress(table))},${ablaUnsafeLoadU8(nativePointerFromAddress(table + 2))},${ablaUnsafeLoadU8(nativePointerFromAddress(table + 3))}"
}

// One object per call site: a write through the first call is there for the second.
trusted fun mutableCell(): int = nativeStaticMutableBytes("\x00\x00\x00\x00\x00\x00\x00\x00")
trusted fun mutableBytes(): string {
    ablaUnsafeStoreU8(nativePointerFromAddress(mutableCell()), 7)
    "${ablaUnsafeLoadU8(nativePointerFromAddress(mutableCell()))},${mutableCell() == mutableCell()}"
}

fun scrubbed(): string {
    ctScrubStack512()
    ctScrubStack2048()
    "wiped"
}

fun sha3Line(): string = digest(sha3256("abc"))

fun main: int {
    println("static ${staticBytes()} ${#staticBytes()}")
    println("mutable ${mutableBytes()} ${#mutableBytes()}")
    println("scrub ${scrubbed()} ${#scrubbed()}")
    println("sha3 ${sha3Line()} ${#sha3Line()}")
    0
}
