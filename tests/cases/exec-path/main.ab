// Starts the program its first argument names (tools/test-exec-path.sh) and prints the status: a bare name is looked up in
// PATH's absolute directories only, never in the working directory.
import "abla/io"
import "abla/process/arguments"
import "abla/process/command"

fun main {
    val name = if (processArgumentCount() > 0) processArgument(0) else "abla-exec-path-tool"
    println("status ${command(name).run()}")
}
