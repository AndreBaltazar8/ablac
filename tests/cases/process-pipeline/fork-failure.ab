import "abla/process/command"
import "abla/sys/linux/process"
import "abla/sys/linux"
import "abla/unsafe/memory"
fun main: int {
    linuxFailForkNumber(2)
    val result = command("sleep").argument("30").pipe(command("true")).run()
    if (result.launchError != "fork failed" || result.statuses.size != 0) return 1
    val status = nativeByteBuffer(8)
    val waited = linuxSyscall4(61, -1, nativePointerAddress(status.address), 1, 0)
    status.close()
    if (waited == -10) 0 else 2
}
