import "abla/sys/linux"
import "abla/sys/linux/process"

// Run as a session leader (tools/test-process-pipeline.sh starts it with setsid): setpgid(0, 0) fails there (EPERM)
// with the group already its own, as a forked child's can on macOS when its parent's call meets it.
// linuxChildSetProcessGroup takes that as done, and still fails for a group that is not the one it is in.
trusted fun main: int {
    // The control: this process really cannot set its group.
    if (linuxSyscall2(109, 0, 0) >= 0) return 1
    if (linuxChildSetProcessGroup(0) != 0) return 2
    // Group 1 (init's) is in another session.
    if (linuxChildSetProcessGroup(1) >= 0) return 3
    0
}
