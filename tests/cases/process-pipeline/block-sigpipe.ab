// Blocks SIGPIPE in this process's signal mask (rt_sigprocmask SIG_BLOCK; a blocked
// signal, unlike an ignored one, is inherited through exec and survives it) and
// replaces the process with the program in argument 0, whose argv is the arguments
// from 1 on. Used by tools/test-process-pipeline.sh to start the pipeline test with
// SIGPIPE blocked. Usage: block-sigpipe EXECUTABLE ARGV0 [ARGUMENT...]
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/unsafe/memory"

fun main: int {
    if (processArgumentCount() < 2) return 2
    val set = nativeByteBuffer(8)
    set.storeI64(0, 1 << 12) // signal 13 is bit 12 of the mask
    val status = linuxSyscall4(14, 0, nativePointerAddress(set.address), 0, 8)
    set.close()
    if (status != 0) return 3
    val argv: array<string> = []
    var index = 1
    while (index < processArgumentCount()) {
        argv.append(processArgument(index))
        index = index + 1
    }
    linuxExecute(processArgument(0), argv)
}
