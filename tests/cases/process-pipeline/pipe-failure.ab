import "abla/process/command"
fun main: int {
    val pipeline = command("true").pipe(command("true")).pipe(command("true"))
        .pipe(command("true")).pipe(command("true")).pipe(command("true"))
    val failed = pipeline.run()
    if (failed.launchError == "" || failed.statuses.size != 0) return 1
    val after = command("true").captureBoth()
    if (!after.allSucceeded()) return 2
    0
}
