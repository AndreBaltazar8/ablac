import "abla/process/command"
import "abla/sys/linux/process"
import "abla/fs"
import "abla/text"
private noescape extern:"c" fun getpgrp(): i32
fun probe(): Command = command("sh").argument("-c").argument("ps -o pgid= -p $$")
fun main: int {
    val parent = "${int(getpgrp())}"
    val blocking = probe().pipe(command("cat")).capture()
    if (!blocking.allSucceeded() || blocking.output.trim() != parent) return 1
    val file = linuxEnvironment("ABLA_GROUP_TEST_FILE").value
    val running = probe().pipe(command("cat").output(file)).start()
    val finished = running.wait()
    val child = Path(file).readText().trim()
    if (!finished.allSucceeded() || child == "" || child == parent) return 2
    0
}
