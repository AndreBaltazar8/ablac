import "abla/process/command"
import "abla/text"
fun main: int {
    val first = command("printf").argument("hello")
    val pipeline = first.pipe(command("cat"))
    first.argument("changed")
    val basic = pipeline.captureBoth()
    if (!basic.allSucceeded() || basic.output != "hello" || basic.errors != "" || basic.status != 0 || basic.statuses.size != 2) return 1
    val quiet = command("true").pipe(command("true")).run()
    if (!quiet.allSucceeded() || quiet.status != 0) return 9
    val large = command("sh").argument("-c").argument("head -c 262144 /dev/zero; head -c 262144 /dev/zero >&2").captureBoth()
    if (!large.allSucceeded() || large.output.size != 262144 || large.errors.size != 262144) return 2
    val multi = command("sh").argument("-c").argument("printf left >&2; printf data")
        .pipe(command("sh").argument("-c").argument("cat; printf right >&2")).captureBoth()
    if (!multi.allSucceeded() || multi.output != "data" ||
        !multi.errors.contains("left") || !multi.errors.contains("right")) return 14
    val failed = command("sh").argument("-c").argument("exit 3").pipe(command("cat")).capture()
    if (failed.status != 0 || failed.allSucceeded() || failed.statuses[0] != 3) return 3
    val broken = command("yes").pipe(command("head").argument("-n").argument("1")).capture()
    if (broken.status != 0 || broken.statuses[0] != 141 || broken.allSucceeded()) return 4
    val absent = command("/no/such/abla-command").pipe(command("cat")).capture()
    if (absent.launchError == "" || absent.statuses[0] != 127) return 5
    val exits127 = command("sh").argument("-c").argument("exit 127").captureBoth()
    if (exits127.launchError != "" || exits127.status != 127) return 13
    val conflict = command("printf").argument("x").output("/dev/null").pipe(command("cat")).capture()
    if (conflict.launchError == "" || conflict.statuses.size != 0) return 6
    val stderrConflict = command("true").errors("/dev/null").captureBoth()
    if (stderrConflict.launchError == "" || stderrConflict.statuses.size != 0) return 10
    val inputConflict = command("true").pipe(command("cat").input("/dev/null")).run()
    if (inputConflict.launchError == "" || inputConflict.statuses.size != 0) return 11
    val failedStart = command("/no/such/abla-command").pipe(command("sleep").argument("30")).capture()
    if (failedStart.launchError == "" || failedStart.statuses.size != 2 || failedStart.statuses[0] != 127) return 12
    val running = command("sh").argument("-c").argument("sleep 30").pipe(command("cat")).start()
    val stopped = running.stop(50)
    if (stopped.statuses.size != 2 || stopped.allSucceeded()) return 7
    val again = running.wait()
    if (again.statuses.size != 2 || again.status != stopped.status) return 8
    var index = 0
    while (index < 12) {
        val repeated = pipeline.captureBoth()
        if (!repeated.allSucceeded() || repeated.output != "hello") return 15
        index = index + 1
    }
    0
}
