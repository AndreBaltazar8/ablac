// The element's mutation still mutates the receiver: a caller that holds
// the geometry read-only may not call it.
class Attribute(var values: array<int>) {
    fun put(index: int, value: int): void {
        values[index] = value
    }
}

class Geometry(var attributes: array<Attribute> = []) {
    fun clearFirst(): void {
        attributes[0].put(0, 0)
    }
}

fun clearShared(geometry: Geometry): void {
    geometry.clearFirst()
}

fun main: int {
    clearShared(Geometry([Attribute([1])]))
    42
}
