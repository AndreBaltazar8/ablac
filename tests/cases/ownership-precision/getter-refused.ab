// A nullable result read from a local's field is still a view of that local,
// which can't change while the view is used.
import "abla/process/exit"

class Account(var level: int)

class Holder(var value: Account?) {
    fun current(): Account? = value
}

fun replaced(): int {
    val holder = Holder(Account(1))
    val account = holder.current()
    holder.value = Account(2)
    account?.level ?? 0
}

fun main: int = 41 + replaced()
