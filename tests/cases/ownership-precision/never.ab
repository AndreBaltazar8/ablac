// After `if (x == null) panic(…)` (a branch ending in a call of type
// `never`), the rest of the block knows x isn't null, as after a `return`.
import "abla/io"
import "abla/process/exit"

class Mesh(var count: int = 0) {
    fun add(): void {
        count += 1
    }
    fun fail(reason: string): never = panic(reason)
}

val meshes: Map<string, Mesh> = Map()

fun bump(name: string): void {
    val mesh = meshes.get(name)
    if (mesh == null) panic("no mesh $name")
    mesh.add()
}

fun bumpInBlock(name: string): void {
    val mesh = meshes.get(name)
    if (mesh == null) {
        println("missing")
        panic("no mesh $name")
    }
    mesh.add()
}

fun bumpElse(name: string, guard: Mesh): void {
    val mesh = meshes.get(name)
    if (mesh != null) {
        mesh.add()
    } else guard.fail("no mesh $name")
    mesh.add()
}

fun countAfter(meshes: Map<string, Mesh>, name: string): int {
    val mesh = meshes.get(name)
    if (mesh == null) panic("no mesh $name")
    mesh.add()
    mesh.count
}

fun countedAtCompileTime(): int {
    val local: Map<string, Mesh> = Map()
    local.set("b", Mesh(6))
    countAfter(local, "b")
}

// At compile time too.
val compileTimeCount = #countedAtCompileTime()

fun main: int {
    meshes.set("a", Mesh())
    bump("a")
    bumpInBlock("a")
    bumpElse("a", Mesh())
    println("${meshes.get("a")?.count ?? -1} $compileTimeCount")
    42
}
