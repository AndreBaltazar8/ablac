// A string read through a view is a value of its own outside a region, as one
// read through a parameter is: it joins a plain string (`??`, `if`), is
// returned, and is held in a local after the holder changes.
import "abla/io"

class Account(var name: string, var nick: string?, var tags: array<string>)

class Holder(var value: Account?) {
    fun current(): Account? = value
}

class Box(var value: Account) {
    fun account(): Account = value
}

fun label(holder: Holder): string {
    val view = holder.current()
    view?.name ?? "none"
}

fun pick(box: Box, first: bool): string {
    val view = box.account()
    if (first) view.name else "x"
}

fun nick(box: Box): string = box.account().nick ?? "-"

fun firstTag(box: Box): string = box.account().tags[0]

fun kept(): string {
    val box = Box(Account("ann", null, []))
    val name = box.account().name
    box.value = Account("bob", null, [])
    "$name/${box.account().name}"
}

fun describe(): string {
    val account = Account("ann", "an", ["red"])
    val box = Box(account)
    "${label(Holder(account))} ${label(Holder(null))} ${pick(box, true)} ${pick(box, false)} " +
        "${nick(box)} ${firstTag(box)} ${kept()}"
}

val STAGED = #describe()

fun main: int {
    println(if (STAGED == describe()) describe() else "staged: $STAGED")
    42
}
