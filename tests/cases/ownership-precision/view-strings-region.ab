// In a region, a string read through a view of a region-allocated object is
// still freed with the region: storing it outside is refused, directly and
// through a function that returns it.
class Account(var name: string)

class Holder(var value: Account) {
    fun current(): Account = value
}

fun nameOf(holder: Holder): string = holder.current().name

fun main: int {
    var saved = ""
    var other = ""
    val n = region {
        val holder = Holder(Account("inner"))
        val view = holder.current()
        saved = view.name
        other = nameOf(holder)
        0
    }
    42 + n + saved.size + other.size
}
