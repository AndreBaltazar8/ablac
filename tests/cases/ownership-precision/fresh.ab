// A method that builds its result returns a new value whatever its receiver
// is: a local read as the function's last expression (its scope has closed
// by then), or an element of a local's array field.
import "abla/io"

class Bag(var names: array<string> = []) {
    fun copy(source: Bag): void {
        names = []
        for (name in source.names) names.append(name)
    }

    fun clone(): Bag {
        val bag = Bag()
        bag.copy(this)
        bag
    }
}

class Item(var values: array<int>) {
    fun toCopy(): Item {
        val out = Item([])
        for (value in values) out.values.append(value)
        out
    }
}

class Holder(var items: array<Item> = [])

fun makeBag(): Bag = Bag(["a", "b"])

fun cloned(): Bag {
    val local = makeBag()
    local.clone()
}

fun copyOfLocal(): Item {
    val local = Item([1, 2, 3])
    local.toCopy()
}

fun firstCopy(): Item {
    val local = Holder([Item([4, 5])])
    local.items[0].toCopy()
}

fun firstCopyReturned(): Item {
    val local = Holder([Item([6])])
    return local.items[0].toCopy()
}

fun sizes(): int = cloned().names.size * 1000 + copyOfLocal().values.size * 100 +
    firstCopy().values.size * 10 + firstCopyReturned().values.size

// At compile time too.
val sizesAtCompileTime = #sizes()

fun main: int {
    println("${sizes()} $sizesAtCompileTime")
    42
}
