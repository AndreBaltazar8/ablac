// Only a call of type `never` narrows: not one that returns (`log`), not an
// overload of a `never` function that returns (`stop(1)`), and not a local
// function named like one (`halt`).
import "abla/process/exit"

class Mesh(var count: int = 0) {
    fun add(): void {
        count += 1
    }
}

val meshes: Map<string, Mesh> = Map()

fun log(message: string): void {}

fun stop(): never = panic("stop")

fun stop(code: int): int = code

fun halt(message: string): never = panic(message)

fun returns(name: string): void {
    val mesh = meshes.get(name)
    if (mesh == null) log("no mesh")
    mesh.add()
}

fun overloaded(name: string): void {
    val mesh = meshes.get(name)
    if (mesh == null) stop(1)
    mesh.add()
}

fun shadowed(name: string): void {
    val halt = { message: string -> log(message) }
    val mesh = meshes.get(name)
    if (mesh == null) halt("no mesh")
    mesh.add()
}

fun main: int = 42
