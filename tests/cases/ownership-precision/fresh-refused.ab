// A method that returns its receiver (`self`) gives a view of it: reached
// from a parameter it is still a view of the parameter, as the function's
// last expression or returned.
class Item(var values: array<int>) {
    fun self(): borrow(this) Item = this
}

class Holder(var items: array<Item> = [])

fun viewAsTail(holder: Holder): Item {
    val local = holder
    local.items[0].self()
}

fun viewReturned(holder: Holder): Item {
    val local = holder
    return local.items[0].self()
}

fun main: int = 42
