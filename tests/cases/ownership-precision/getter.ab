// A method returning a nullable field is a view of its receiver, as one
// returning a non-null field is (also as a generic `T` with `T` nullable);
// and a view of a global, held in a local (a `var` too), is an ordinary
// reference to it, as `val v = global.field` is.
import "abla/io"
import "abla/process/exit"

class Account(var level: int)

class State<T>(var value: T) {
    fun getValue(): T = value
}

class Holder(var value: Account?) {
    fun current(): Account? = value
}

val accountState = State<Account?>(null)
val signedIn = State<Account>(Account(2))
val holder = Holder(Account(4))

fun fromLocal(): int {
    val state = State<Account?>(Account(5))
    val account = state.getValue()
    account?.level ?? 0
}

fun main: int {
    val first = accountState.getValue()
    accountState.value = Account(1)
    val second = accountState.getValue()
    var third = signedIn.getValue()
    signedIn.value = Account(3)
    println("${first?.level ?? 0} ${second?.level ?? 0} ${third.level} " +
        "${signedIn.getValue().level} ${holder.current()?.level ?? 0} ${fromLocal()}")
    42
}
