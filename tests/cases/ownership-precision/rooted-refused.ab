// An entry of a parameter's Map is a view of the parameter (the help names
// the contract to declare), and so is a parameter in the other branch of
// `??`.
import "abla/process/exit"

class Item(var values: array<int>)

var store: Map<string, Item> = Map()

fun cached(cache: Map<string, Item>, key: string): Item {
    val item = cache.get(key) ?? panic("missing $key")
    item
}

fun orOther(key: string, other: Item): Item = store.get(key) ?? other

fun main: int = 42
