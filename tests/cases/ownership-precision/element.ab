// A method that mutates its receiver only through an element of an array
// field (`attributes[i].put(…)`, `this.parts[0].bump()`) mutates it as one
// that calls a field's mutating method does: callers may call it on a `val`
// they own.
import "abla/io"

class Attribute(var values: array<int>, var bumps: int = 0) {
    fun at(index: int): int = values[index]
    fun put(index: int, value: int): void {
        values[index] = value
    }
    fun bump(): void {
        bumps += 1
    }
}

class Geometry(var attributes: array<Attribute> = []) {
    fun first(): int = 0

    fun scaleAll(): void {
        val slot = first()
        var index = 0
        while (index < 2) {
            attributes[slot].put(index, attributes[slot].at(index) * 2)
            index += 1
        }
    }

    fun bumpFirst(): void {
        this.attributes[0].bump()
    }
}

fun scaledSecond(): int {
    val geometry = Geometry([Attribute([5, 6])])
    geometry.scaleAll()
    geometry.attributes[0].values[1]
}

// At compile time too.
val scaledAtCompileTime = #scaledSecond()

fun main: int {
    val geometry = Geometry([Attribute([1, 2])])
    geometry.scaleAll()
    geometry.bumpFirst()
    println("${geometry.attributes[0].values[0]} ${geometry.attributes[0].values[1]} ${geometry.attributes[0].bumps} $scaledAtCompileTime")
    42
}
