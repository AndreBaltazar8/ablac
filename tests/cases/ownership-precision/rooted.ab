// An entry of a global Map is rooted in the global, as an element of a
// global array is, also through `?? panic(…)`; and a `borrow(cache)` result
// of a global argument is too.
import "abla/io"
import "abla/process/exit"

class Item(var values: array<int>)

var store: Map<string, Item> = Map()

fun lookup(key: string): Item {
    val item = store.get(key) ?? panic("missing $key")
    item
}

fun lookupReturned(key: string): Item {
    return store.get(key) ?? panic("missing $key")
}

fun cached(cache: Map<string, Item>, key: string): borrow(cache) Item {
    val item = cache.get(key) ?? panic("missing $key")
    item
}

fun lookupCached(key: string): Item {
    if (!store.has(key)) store.set(key, Item([7, 8, 9]))
    cached(store, key)
}

fun main: int {
    store.set("a", Item([1]))
    store.set("b", Item([1, 2]))
    println("${lookup("a").values.size} ${lookupReturned("b").values.size} ${lookupCached("c").values.size}")
    42
}
