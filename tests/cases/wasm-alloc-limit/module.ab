// An allocation whose size does not fit 32 bits (or the module's memory) is refused, not truncated: run.mjs asks for sizes around
// 2^31, 2^32 and beyond of the runtime's allocator, of a native byte buffer and of a hex encoding's output (the size a 32-bit
// target computes as `n * 2 + 1`), and a trap is the answer (CVE-2026-121481's class: a size wrapped to a small allocation).
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

@export("allocate")
trusted fun exportedAllocate(size: int): int = ablaUnsafePointerAddress(ablaUnsafeAllocate(size))

@export("buffer")
trusted fun exportedBuffer(size: int): int {
    val buffer = nativeByteBuffer(size + 1)
    ablaUnsafePointerAddress(buffer.pointerAt(0))
}

@export("encoded")
trusted fun exportedEncoded(size: int): int {
    val buffer = nativeByteBuffer(size * 2 + 1)
    ablaUnsafePointerAddress(buffer.pointerAt(0))
}
