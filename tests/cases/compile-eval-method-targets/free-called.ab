// #797, the sound side: the same names, but the site calls Box.shape with a receiver, so
// it reaches the native copy and must stay in the interpreter.
import "abla/unsafe/memory"
import "abla/compiler"

#compilerGrant("trusted.native")
class Box(val n: int)
trusted fun Box.shape(value: string): string {
    ablaUnsafeCopyMemory(0, 0, 0)
    value
}
fun shape(value: string): string = value
val H = #Box(0).shape(shape("abc"))
@export("resultSize")
fun resultSize(): int = H.size
fun main: int = H.size
