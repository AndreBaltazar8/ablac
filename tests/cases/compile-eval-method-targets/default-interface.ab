import "abla/unsafe/memory"
import "abla/compiler"

#compilerGrant("trusted.native")
interface Formatter {
    fun leaf(): string
    fun toText(): string = this.leaf()
}
class Bad: Formatter {
    trusted fun leaf(): string = adoptNativeString(0, 0)
}
val H = #Bad().toText()
@export("resultSize")
fun resultSize(): int = H.size
