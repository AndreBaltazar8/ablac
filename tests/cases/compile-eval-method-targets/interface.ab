import "abla/unsafe/memory"
import "abla/compiler"

#compilerGrant("trusted.native")
sealed interface Choice { fun toText(): string }
class Good: Choice { fun toText(): string = "good" }
class Bad: Choice { trusted fun toText(): string = adoptNativeString(0, 0) }
fun choose(flag: bool): Choice = if (flag) Good() else Bad()
val H = #choose(true).toText()
@export("resultSize")
fun resultSize(): int = H.size
