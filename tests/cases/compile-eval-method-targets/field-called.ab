// #797, the sound side: the same names, but the site calls Box.text, so it reaches the
// native copy and must stay in the interpreter.
import "abla/unsafe/memory"
import "abla/compiler"

#compilerGrant("trusted.native")
class Label(val text: string)
class Box(val n: int)
trusted fun Box.text(value: string): string {
    ablaUnsafeCopyMemory(0, 0, 0)
    value
}
val H = #Box(0).text(Label("abc").text)
@export("resultSize")
fun resultSize(): int = H.size
fun main: int = H.size
