// #797: library code never names a program's function. abla/bytes uses a local `text`; the
// program's `text(value)`, never called, copies memory natively and must stay out of the slice.
import "abla/unsafe/memory"
import "abla/crypto"
import "abla/compiler"

trusted fun text(value: string): string {
    ablaUnsafeCopyMemory(0, 0, 0)
    value
}
compile fun h(): string = hexEncode(sha256("abc"))
val H = #h()

@export("resultSize")
fun resultSize(): int = H.size
@export("resultByte")
fun resultByte(index: int): int = H[index]
fun main: int = H.size
