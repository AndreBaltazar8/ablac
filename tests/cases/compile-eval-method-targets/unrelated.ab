// Reporter m.ab: an unrelated extension must not poison ByteBuffer.toText.
import "abla/unsafe/memory"
import "abla/crypto"
import "abla/compiler"

class Box(val n: int)
trusted fun Box.toText(): string = adoptNativeString(0, 0)
compile fun h(): string = hexEncode(sha256("abc"))
val H = #h()

@export("resultSize")
fun resultSize(): int = H.size
@export("resultByte")
fun resultByte(index: int): int = H[index]
fun main: int = H.size
