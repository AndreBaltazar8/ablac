// #797: a call of a free function must not reach an extension function of its name. The
// site calls the free `shape(value)`; Box.shape(value), never called, copies memory natively.
import "abla/unsafe/memory"
import "abla/crypto"
import "abla/compiler"

class Box(val n: int)
trusted fun Box.shape(value: string): string {
    ablaUnsafeCopyMemory(0, 0, 0)
    value
}
fun shape(value: string): string = value
compile fun h(): string = hexEncode(sha256(shape("abc")))
val H = #h()

@export("resultSize")
fun resultSize(): int = H.size
@export("resultByte")
fun resultByte(index: int): int = H[index]
fun main: int = H.size
