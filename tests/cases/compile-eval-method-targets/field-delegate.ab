// #797, the sound side: a member read that runs code. Label's `text` is delegated;
// reading it calls NativeText.getValue, which copies memory natively, so the site
// must stay in the interpreter.
import "abla/unsafe/memory"
import "abla/compiler"

#compilerGrant("trusted.native")
class NativeText(val seed: int) {
    trusted fun getValue(): string {
        ablaUnsafeCopyMemory(0, 0, 0)
        "abc"
    }
}
class Label(val n: int, val text: string by NativeText(0))
val H = #Label(0).text
@export("resultSize")
fun resultSize(): int = H.size
fun main: int = H.size
