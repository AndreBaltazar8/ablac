// #797, the sound side: a member read that runs code. Label's extension field
// `text` has a default that copies memory natively; reading it runs that default,
// so the site must stay in the interpreter (today the implicit-root guard already
// keeps it there; the walk must reach the default once that guard is lifted).
import "abla/unsafe/memory"
import "abla/compiler"

#compilerGrant("trusted.native")
class Label(val n: int)
trusted fun nativeText(): string {
    ablaUnsafeCopyMemory(0, 0, 0)
    "abc"
}
val Label.text: string = nativeText()
val H = #Label(0).text
@export("resultSize")
fun resultSize(): int = H.size
fun main: int = H.size
