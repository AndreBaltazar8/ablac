// #797, the ordinary slice: a local `output` and a read of the field `run` name no method.
// Command.output and Command.run, never called, read `failures`, whose initializer copies
// memory natively; keeping them kept that global, whose initializer a cross-target slice
// must then prove, and the site went to the interpreter.
import "abla/unsafe/memory"
import "abla/compiler"

class Job(val run: int)
trusted fun nativeCount(): int {
    ablaUnsafeCopyMemory(0, 0, 0)
    0
}
val failures: int = nativeCount()
class Command(val name: string) {
    fun output(): int = failures
    fun run(): int = failures + 1
}
compile fun h(): string {
    val output = Job(4).run
    "${output * 10}"
}
val H = #h()

@export("resultSize")
fun resultSize(): int = H.size
@export("resultByte")
fun resultByte(index: int): int = H[index]
fun main: int = H.size
