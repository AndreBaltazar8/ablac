// #797: a field read must not reach an unrelated method of the field's name. The site
// reads Label's field `text`; Box.text(value), never called, copies memory natively.
import "abla/unsafe/memory"
import "abla/crypto"
import "abla/compiler"

class Label(val text: string)
class Box(val n: int)
trusted fun Box.text(value: string): string {
    ablaUnsafeCopyMemory(0, 0, 0)
    value
}
compile fun h(): string = hexEncode(sha256(Label("abc").text))
val H = #h()

@export("resultSize")
fun resultSize(): int = H.size
@export("resultByte")
fun resultByte(index: int): int = H[index]
fun main: int = H.size
