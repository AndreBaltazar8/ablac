import "abla/build"
import "abla/float"
import "abla/sys/linux/random"

// The library tools/test-android-run.sh loads into bionic's linker under qemu-aarch64 and calls (#811).

// 300 random bytes: how many differ from zero (all but a few of them), or -1 when the call fails. The call is
// getrandom, which the library issues by x86-64 number through its own system call routine.
fun randomNonZero: int {
    val result = secureRandomBytes(300)
    if (!result.succeeded || result.bytes.size != 300) return -1
    var count = 0
    for (index in 0 until 300) if (result.bytes[index] != 0) count = count + 1
    count
}

class Counter(var count: int)

fun greet(n: int): string {
    val parts: array<string> = []
    for (index in 0 until n) parts.append("item$index")
    var text = ""
    for (part in parts) text = "$text$part,"
    text
}

// Heap, strings, arrays, maps and the thread-locals behind them (bionic's pthread keys through the NDK's emutls):
// 270 + 190 + 5.
fun heapAnswer: int {
    val counter = Counter(0)
    val table: Map<string, int> = Map()
    for (index in 0 until 20) {
        table.set("key$index", index * index)
        counter.count = counter.count + index
    }
    val ratio = (f64FromInt(counter.count) % 7.5) * 2.0
    greet(40).size + counter.count + f64ToInt(ratio)
}

val exportedRandom = #exportFunction("randomNonZero", "abla_run_random")
val exportedHeap = #exportFunction("heapAnswer", "abla_run_heap")
