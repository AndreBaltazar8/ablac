import "abla/http"
import "abla/http/tls"
import "abla/http/async"

fun awaitCompletion(var client: HttpAsyncClient, id: int): HttpAsyncCompletion {
    var result = HttpAsyncCompletion(id, 0, [], "", "no completion", 0)
    var loops = 0
    while (result.error == "no completion" && loops < 400) {
        client.step(10)
        for (each in client.takeCompletions()) if (each.id == id) result = each
        loops = loops + 1
    }
    result
}

fun main: int {
    val client = httpIpv4Client("127.0.0.1:39092", "127.0.0.1", 39092, 4096, 1000)
    val plain = client.send(httpGet("/plain"))
    val head = client.send(httpRequest("HEAD", "/head"))
    val incomplete = client.send(httpGet("/incomplete"))
    val switched = client.send(httpGet("/switch"))
    val secure = httpsClient("127.0.0.1", 39093, 4096, 1000)
    val tls = secure.send(httpGet("/tls"))
    val async = httpAsyncClient()
    val base = "http://127.0.0.1:39092"
    val a = awaitCompletion(async, async.get("$base/async"))
    val h = awaitCompletion(async, async.request("HEAD", "$base/async-head", [], "", 1000))
    val reuse = awaitCompletion(async, async.get("$base/reuse"))
    val bad = awaitCompletion(async, async.get("$base/incomplete"))
    val up = awaitCompletion(async, async.get("$base/switch"))
    val counts = client.send(httpGet("/counts"))
    val parsed = httpParseResponse("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
    val only = httpParseResponse("HTTP/1.1 100 Continue\r\n\r\n")
    if (plain.succeeded && plain.complete && plain.response.status == 200 && plain.response.body == "final" &&
        head.succeeded && head.complete && head.response.status == 200 && head.response.body == "" &&
        (!incomplete.succeeded || !incomplete.complete) && switched.succeeded && switched.response.status == 101 &&
        tls.succeeded && tls.complete && tls.response.status == 200 && tls.response.body == "final" &&
        a.succeeded() && a.status == 200 && a.body == "final" && h.succeeded() && h.status == 200 && h.body == "" &&
        reuse.succeeded() && !bad.succeeded() && up.succeeded() && up.status == 101 && counts.complete && counts.response.body == "2" &&
        parsed.complete && parsed.response.status == 200 && parsed.response.body == "ok" && !only.complete) 42 else 1
}
