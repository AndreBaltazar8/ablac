// The client side of tools/test-http-interim.sh: 1xx responses handled by the blocking clients (plain and TLS) and the async one, against the peer of
// tests/cases/http-interim-peer. Arguments: the peer's plain port and its TLS port. Prints one line "FAIL <what>" per check that fails and exits 42
// when every check passes (1 otherwise); the waits are generous (a loaded machine is not a failing server) and deadlines are on the clock, not in loop counts.
import "abla/io"
import "abla/http"
import "abla/http/tls"
import "abla/http/async"
import "abla/process/arguments"
import "abla/sys/linux/process"

fun awaitCompletion(var client: HttpAsyncClient, id: int): HttpAsyncCompletion {
    var result = HttpAsyncCompletion(id, 0, [], "", "no completion", 0)
    val deadline = linuxMonotonicMilliseconds() + 60000
    while (result.error == "no completion" && linuxMonotonicMilliseconds() < deadline) {
        client.step(10)
        for (each in client.takeCompletions()) if (each.id == id) result = each
    }
    result
}

var failures = 0

fun check(ok: bool, what: string): void {
    if (!ok) {
        failures = failures + 1
        println("FAIL $what")
    }
    return
}

fun decimal(text: string): int {
    var value = 0
    for (i in 0 until text.size) value = value * 10 + (text[i] - 48)
    value
}

fun main: int {
    if (processArgumentCount() < 2) {
        println("usage: main <plain port> <tls port>")
        return 2
    }
    val plainPort = decimal(processArgument(0))
    val tlsPort = decimal(processArgument(1))
    // 20 s for each blocking read: the peer's own delays are under 2 s (tests/cases/http-interim-peer/peer.ab), the rest is the machine.
    val client = httpIpv4Client("127.0.0.1:$plainPort", "127.0.0.1", plainPort, 4096, 20000)
    val plain = client.send(httpGet("/plain"))
    val head = client.send(httpRequest("HEAD", "/head"))
    val incomplete = client.send(httpGet("/incomplete"))
    val switched = client.send(httpGet("/switch"))
    val secure = httpsClient("127.0.0.1", tlsPort, 4096, 20000)
    val tls = secure.send(httpGet("/tls"))
    val async = httpAsyncClient()
    val base = "http://127.0.0.1:$plainPort"
    val a = awaitCompletion(async, async.get("$base/async"))
    val h = awaitCompletion(async, async.request("HEAD", "$base/async-head", [], "", 20000))
    val reuse = awaitCompletion(async, async.get("$base/reuse"))
    val bad = awaitCompletion(async, async.get("$base/incomplete"))
    val up = awaitCompletion(async, async.get("$base/switch"))
    val counts = client.send(httpGet("/counts"))
    val parsed = httpParseResponse("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
    val only = httpParseResponse("HTTP/1.1 100 Continue\r\n\r\n")
    check(plain.succeeded && plain.complete && plain.response.status == 200 && plain.response.body == "final", "plain: 1xx skipped, the final response (succeeded ${plain.succeeded}, complete ${plain.complete}, status ${plain.response.status}, body '${plain.response.body}')")
    check(head.succeeded && head.complete && head.response.status == 200 && head.response.body == "", "HEAD (succeeded ${head.succeeded}, complete ${head.complete}, status ${head.response.status})")
    check(!incomplete.succeeded || !incomplete.complete, "an incomplete response is not a complete one")
    check(switched.succeeded && switched.response.status == 101, "101 is final (succeeded ${switched.succeeded}, status ${switched.response.status})")
    check(tls.succeeded && tls.complete && tls.response.status == 200 && tls.response.body == "final", "TLS: 1xx skipped (succeeded ${tls.succeeded}, complete ${tls.complete}, status ${tls.response.status}, body '${tls.response.body}')")
    check(a.succeeded() && a.status == 200 && a.body == "final", "async: 1xx skipped (status ${a.status}, body '${a.body}', error '${a.error}')")
    check(h.succeeded() && h.status == 200 && h.body == "", "async HEAD (status ${h.status}, body '${h.body}', error '${h.error}')")
    check(reuse.succeeded(), "async: the connection is reused (error '${reuse.error}')")
    check(!bad.succeeded(), "async: an incomplete response fails")
    check(up.succeeded() && up.status == 101, "async: 101 is final (status ${up.status}, error '${up.error}')")
    check(counts.complete && counts.response.body == "2", "the peer saw two /incomplete requests (complete ${counts.complete}, body '${counts.response.body}')")
    check(parsed.complete && parsed.response.status == 200 && parsed.response.body == "ok", "parse: 1xx then 200")
    check(!only.complete, "parse: 1xx alone is not complete")
    if (failures == 0) 42 else 1
}
