import "abla/build"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/runtime/self"

// A library whose C host forks while a thread of the host allocates in it (tools/test-fork-heap.sh, #812). The
// runtime's heap locks only exist once a thread has run, so the host calls abla_fork_enable first.
trusted fun stopWord(): int = nativeStaticAllocate(8)

@export("abla_fork_enable")
fun enable(): int {
    val worker = thread { 6 * 7 }
    await worker
}

// Allocates and frees until abla_fork_stop: the heap's lock is held a great part of the time.
@export("abla_fork_churn")
trusted fun churn(): int {
    val stop = stopWord()
    var total = 0
    var round = 0
    var live = 0
    while (ablaRuntimeAtomicLoadI64(stop) == 0) {
        val size = 16 + (round * 37) % 600
        val block = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(size))
        if (block == 0) return -1
        ablaRuntimeStoreI64(block, round)
        if (live != 0) __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(live))
        live = block
        total = total + size
        round = round + 1
    }
    if (live != 0) __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(live))
    total
}

@export("abla_fork_stop")
trusted fun stop(): int {
    ablaRuntimeAtomicStoreI64(stopWord(), 1)
    0
}

// What the child does: allocation, checked. 0 when all is well.
@export("abla_fork_child")
fun child(): int {
    var round = 0
    while (round < 300) {
        val text = "child ${round} " + "x".repeat(round % 50)
        val numbers = [round, round * 2, round * 3]
        if (text.size != ("child ${round} ".size + round % 50)) return 1
        if (numbers[2] != round * 3) return 2
        round = round + 1
    }
    0
}
