import "abla/io"
import "abla/regex"

// Timing-free linearity checks: the VM steps of Regex.findWork (and findAllWork) are counted, not timed. A single
// search takes at most 2 * (text size + 1) * program size steps for every pattern (the classic exponential shapes
// included), and ten times the text takes at most about ten times the steps. findAll restarts the search at each
// match, so it is bounded by (matches + 1) times that, which a pattern whose longer alternative outlives the shorter
// match (`a+b|a`) reaches (docs/stdlib/regex.md, "Cost").

var failures = 0

fun expect(label: string, ok: bool): void {
    if (!ok) {
        failures += 1
        println("FAIL ${label}")
    }
}

fun repeated(unit: string, count: int): string {
    var out = ""
    var half = unit
    var n = count
    while (n > 0) {
        if (n % 2 == 1) out = out + half
        half = half + half
        n = n / 2
    }
    out
}

fun main: int {
    val shapes = ["(a+)+$", "^(a+)+$", "(a|a)*b", "(a|aa)*c", "(a*)*b", "((a*)*)*b", "(x+x+)+y", "(a|b|ab)*c",
        "(.*a){8}", "(a{1,20}){1,20}b", "(?:a|a?)+b", "[a-z]*[a-z]*[a-z]*!", "(\\w+\\s?)*$"]
    for (pattern in shapes) {
        val compiled = regexCompile(pattern)
        expect("compile ${pattern}", compiled.succeeded)
        if (!compiled.succeeded) continue
        val re = compiled.regex
        val size = re.program.size / 3
        var previous = 0
        for (n in [500, 5000]) {
            val text = repeated("a", n) + "!"
            val work = re.findWork(text)
            expect("find ${pattern} on ${n}: ${work} steps over ${2 * (n + 1) * size}", work <= 2 * (n + 2) * size)
            if (previous > 0) expect("find ${pattern}: ${work} steps for ${n}, ${previous} for a tenth", work <= previous * 11)
            previous = work
            expect("matches ${pattern}", re.matches(text) == (re.matchFull(text) != null))
        }
    }
    // findAll: bounded by (matches + 1) searches, and linear when no alternative outlives its match.
    val re = regexCompile("a+b|a").regex
    val size = re.program.size / 3
    val text = repeated("a", 600)
    val work = re.findAllWork(text)
    expect("findAll a+b|a: ${work} steps", work <= 601 * 2 * 601 * size && work > 100 * 600)
    val simple = regexCompile("a|b").regex
    val long = repeated("ab", 5000)
    expect("findAll a|b is linear: ${simple.findAllWork(long)} steps", simple.findAllWork(long) <= 2 * 10001 * (simple.program.size / 3) * 2)
    println(if (failures == 0) "ok" else "failed")
    if (failures == 0) 0 else 1
}
