import "abla/io"
import "abla/process/exit"
import "abla/regex"
import "abla/text"

fun expect(value: bool, label: string): void {
    if (!value) panic(label)
}

fun kind(result: RegexSearchResult): string = when (result) {
    is RegexSearchMatch -> "match"
    is RegexSearchMiss -> "miss"
    is RegexSearchExhausted -> "exhausted"
}

fun compare(regex: Regex, text: string, start: int): void {
    val ordinary = regex.find(text, start)
    val bounded = regex.findWithin(text, 1024, start)
    when (bounded) {
        is RegexSearchMatch -> {
            expect(ordinary != null, "unexpected match")
            if (ordinary != null) {
                expect(ordinary.groupCount() == bounded.matched.groupCount(), "group count")
                for (index in 0..ordinary.groupCount()) {
                    expect(ordinary.groupStart(index) == bounded.matched.groupStart(index), "group start")
                    expect(ordinary.groupEnd(index) == bounded.matched.groupEnd(index), "group end")
                }
            }
        }
        is RegexSearchMiss -> expect(ordinary == null, "unexpected miss")
        is RegexSearchExhausted -> panic("unexpected exhaustion")
    }
}

fun main: int {
    val anchor = regexCompile("^$").regex
    // One position, five newly visited instructions and one thread step.
    expect(kind(anchor.findWithin("", 6)) == "exhausted", "exact limit below result")
    expect(kind(anchor.findWithin("", 7)) == "match", "exact limit at result")

    val captured = regexCompile("(red|green)( [a-z]+)?").regex
    expect(kind(captured.findWithin("green apples", 1)) == "exhausted", "capture closure")
    // A short lower-priority match is tentative while the preferred arm remains live.
    val priority = regexCompile("blue|b").regex
    expect(kind(priority.findWithin("blue", 22)) == "exhausted", "partial match must not escape")
    compare(priority, "blue", 0)
    compare(captured, "green apples", 0)
    compare(captured, "red", 0)
    compare(captured, "blue", 0)
    compare(captured, "é red apples", 3)
    compare(regexCompile("[0-9é]").regex, "5", 0)
    compare($regex("green|red"), "blue green", 0)
    compare($regex("^[a-z]+"), "blue", 1)
    val fixed = regexCompile("[A-Z][0-9]").regex
    expect(kind(fixed.findWithin("item A7", 2)) == "exhausted", "bounded scan")
    compare(fixed, "item A7", 0)
    expect(kind(fixed.findWithin("item A7", 0)) == "exhausted", "zero budget")
    expect(kind(fixed.findWithin("item A7", -1)) == "exhausted", "negative budget")
    expect(kind(fixed.findWithin("item A7", 1, -1)) == "miss", "invalid start")
    expect(kind(fixed.findWithin("item zz", 1024)) == "miss", "completed miss")

    val log = "item still pending\n".repeat(32768)
    val ready = $regex("item ready")
    expect(kind(ready.findWithin(log, 32)) == "exhausted", "budget stops a long log scan")
    println("bounded regex: ok")
    0
}
