import "abla/io"
import "abla/process/exit"
import "abla/regex"

fun require(value: bool) { if (!value) panic("regex literal") }
val globalRegex = $regex("([a-z]+)-(\\d+)?")
fun literal(): Regex = $regex("[é-ü]+|😀")

fun sameSpan(expected: RegexMatch?, actual: RegexMatch?): bool {
    if (expected == null) return actual == null
    if (actual == null) return false
    expected.start() == actual.start() && expected.end() == actual.end() &&
        expected.group(0) == actual.group(0)
}

fun compareLiteral(literal: Regex, samples: array<string>): void {
    val compiled = regexCompile(literal.pattern)
    require(compiled.succeeded)
    for (sample in samples) {
        require(literal.matches(sample) == compiled.regex.matches(sample))
        require(sameSpan(compiled.regex.matchFull(sample), literal.matchFull(sample)))
        val prefix = compiled.regex.find(sample)
        val expectedEnd = if (prefix != null && prefix.start() == 0) prefix.end() else -1
        require(literal.matchPrefixEnd(sample) == expectedEnd)
        for (start in -1..sample.size + 1) {
            val found = compiled.regex.find(sample, start)
            require(sameSpan(found, literal.find(sample, start)))
            require(literal.findStart(sample, start) == (if (found == null) -1 else found.start()))
        }
    }
}

fun checkLiteralFast(): void {
    val compiledMatches = #($regex("[0-9]+").matches("2026"))
    val compiledStart = #($regex("ab|c").findStart("πc"))
    val compiledEnd = #($regex("^a[^\\n]*\\n").matchPrefixEnd("abc\nrest"))
    require(compiledMatches && compiledStart == 2 && compiledEnd == 4)
    val prefixes = ["", "abc", "zab", "xb ab", "😀ab", "\xffab", "aaa"]
    compareLiteral($regex("(?:ab|a|bc)"), prefixes)
    compareLiteral($regex("(?:a|ab|bc)"), prefixes)
    compareLiteral($regex("[0-9]+\\.[0-9]+\\.[0-9]+-[1-9][0-9]*"),
        ["23.1.3-3", "23.01.03-3", "23.1.3-00", "0.0.0-1", "x23.1.3-3", "23.1.3-٣", ""])
    compareLiteral($regex("^(?:\"(?:[^\"\\\\]|\\\\[\\s\\S])*\"|'[^']*')"),
        ["\"hi\" # suffix", "\"é\\\"🐱\"", "'\xffé' tail", "\"\\😀\"", "'x\nz'", "'foo", "", " 'y'"])
    compareLiteral($regex("^[a-z]*"), ["abc", "abc1", "123", ""])
    compareLiteral($regex("^a*?"), ["aaa", "ab", "b", ""])
    compareLiteral($regex("[é-ü]+"), ["ü", "ü😀", "é", "a", "\xff", ""])
    compareLiteral($regex("\\ba\\b"), ["a", "ba", " a ", "猫a", ""])
}

fun main {
    checkLiteralFast()
    val m = globalRegex.matchFull("abc-42") ?? panic("missing match")
    require(m.group(0) == "abc-42" && m.group(1) == "abc" && m.group(2) == "42")
    val optional = globalRegex.matchFull("abc-") ?? panic("missing optional")
    require(optional.group(2) == null && !optional.hasGroup(2))
    require(optional.groupStart(2) == -1 && optional.groupEnd(2) == -1)
    require(optional.groupCount() == 2 && optional.start() == 0 && optional.end() == 4)
    require($regex("a{2,3}").matches("aaa"))
    require($regex("").matches(""))
    val nested = #$regex("a")
    require(nested.matches("a"))
    require($regex("\\$\\{x\\}").matches("\${x}"))
    val expected = regexCompile("[é-ü]+|😀").regex
    for (i in 0 until 5) {
        val re = literal()
        require(re.matches("éü") && re.matches("😀") && !re.matches("a"))
        require(re.program.size == expected.program.size && re.first == expected.first)
        for (j in 0 until re.program.size) require(re.program[j] == expected.program[j])
        val found = re.find("x😀y") ?? panic("missing Unicode")
        require(found.start() == 1 && found.end() == 5 && found.text0() == "😀")
    }
    require($regex("(a+)").replace("aaa baa", "$1!") == "aaa! baa!")
    require($regex("x").findAll("x x").size == 2)
    println("ok")
}
