import "abla/io"
import "abla/process/exit"
import "abla/regex"

fun require(value: bool) { if (!value) panic("regex literal") }
val globalRegex = $regex("([a-z]+)-(\\d+)?")
fun literal(): Regex = $regex("[é-ü]+|😀")

fun main {
    val m = globalRegex.matchFull("abc-42") ?? panic("missing match")
    require(m.group(0) == "abc-42" && m.group(1) == "abc" && m.group(2) == "42")
    val optional = globalRegex.matchFull("abc-") ?? panic("missing optional")
    require(optional.group(2) == null && !optional.hasGroup(2))
    require(optional.groupStart(2) == -1 && optional.groupEnd(2) == -1)
    require(optional.groupCount() == 2 && optional.start() == 0 && optional.end() == 4)
    require($regex("a{2,3}").matches("aaa"))
    require($regex("").matches(""))
    val nested = #$regex("a")
    require(nested.matches("a"))
    require($regex("\\$\\{x\\}").matches("\${x}"))
    val expected = regexCompile("[é-ü]+|😀").regex
    for (i in 0 until 5) {
        val re = literal()
        require(re.matches("éü") && re.matches("😀") && !re.matches("a"))
        require(re.program.size == expected.program.size && re.first == expected.first)
        for (j in 0 until re.program.size) require(re.program[j] == expected.program[j])
        val found = re.find("x😀y") ?? panic("missing Unicode")
        require(found.start() == 1 && found.end() == 5 && found.text0() == "😀")
    }
    require($regex("(a+)").replace("aaa baa", "$1!") == "aaa! baa!")
    require($regex("x").findAll("x x").size == 2)
    println("ok")
}
