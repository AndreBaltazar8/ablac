import "abla/io"

@noinline fun id_string(x: string): string = x
@noinline fun id_int(x: int): int = x
@noinline fun id_bool(x: bool): bool = x
@noinline fun id_f64(x: f64): f64 = x
@noinline fun id_ints(x: array<int>): array<int> = x
@noinline fun id_strings(x: array<string>): array<string> = x

class Point(val x: int, val y: int = 0) {
    fun plus(other: Point): Point = Point(x + other.x, y + other.y)
    fun describe(): string = "(${x}, ${y})"
}
class Counter(var count: int, val step: int = 1) {
    fun bump(): int {
        count = count + step
        count
    }
}
class Node(val value: int, val next: Node?, val name: string?)
fun Node.plus(n: int): int = this.value + n
interface Shape {
    fun area(): int
    fun describe(): string = "shape of ${this.area()}"
}
class Square(val side: int): Shape {
    fun area(): int = this.side * this.side
}
class Circle(val radius: int): Shape {
    fun area(): int = 3 * this.radius * this.radius
    fun describe(): string = "circle"
}
sealed interface Expr
class Num(val value: int): Expr
class Add(val left: Expr, val right: Expr): Expr
class Neg(val operand: Expr): Expr
fun evaluate(expr: Expr): int = when (expr) {
    is Num -> expr.value
    is Add -> evaluate(expr.left) + evaluate(expr.right)
    is Neg -> -evaluate(expr.operand)
}
fun push(var xs: array<int>, v: int): void {
    xs.append(v)
    return
}
fun setAt(var rows: array<array<int>>, i: int, j: int, v: int): void {
    rows[i][j] = v
    return
}
fun showInts(xs: array<int>): string {
    var text = "["
    for (x in xs) text = text + "${x},"
    text + "]"
}
fun showStrings(xs: array<string>): string {
    var text = "["
    for (x in xs) text = text + "${x},"
    text + "]"
}
fun double(n: int): int = n * 2
fun compose(f: (int) -> int, g: (int) -> int): (int) -> int = { x: int -> g(f(x)) }
fun twice(f: (int) -> int): (int) -> int = { x: int -> f(f(x)) }
fun adder(base: int): (int) -> int = { x: int -> x + base }
fun applyAll(fs: array<(int) -> int>, x: int): int {
    var value = x
    for (f in fs) value = f(value)
    value
}

fun callsN(): array<string> {
    val out: array<string> = []
    val g = { n: int -> n + 1 }
    val h = { x: int -> g(x) }
    out.append("lambda ${h(id_int(10))} ${h(-5)}")
    val composed = compose(double, { n: int -> n + 1 })
    out.append("compose ${composed(id_int(10))} ${composed(0)}")
    val both = compose(composed, adder(id_int(100)))
    out.append("nested ${both(3)}")
    val again = twice({ n: int -> n * 3 })
    out.append("twice ${again(id_int(2))} ${twice(again)(1)}")
    val named = double
    val viaName = { x: int -> named(x) + 1 }
    out.append("function value ${viaName(id_int(7))}")
    val chain = { x: int -> { y: int -> g(x) + composed(y) } }
    out.append("inner ${chain(1)(id_int(2))}")
    val fns: array<(int) -> int> = [g, double, composed]
    out.append("all ${applyAll(fns, id_int(1))}")
    val sums = { x: int -> fns[0](x) + fns[1](x) }
    out.append("array ${sums(id_int(4))}")
    out
}

fun stateN(): array<string> {
    val out: array<string> = []
    var total = id_int(0)
    val add = { n: int -> total = total + n }
    add(id_int(3))
    val addOnce = move { n: int -> add(n); add(n) }
    addOnce(4)
    out.append("mutating ${total}")
    out
}

