@noinline fun id_string(x: string): string = x
@noinline fun id_int(x: int): int = x
@noinline fun id_bool(x: bool): bool = x
@noinline fun id_f64(x: f64): f64 = x
@noinline fun id_ints(x: array<int>): array<int> = x
@noinline fun id_strings(x: array<string>): array<string> = x

fun sizesN(): array<string> {
    val out: array<string> = []
    val pool: array<string> = [id_string(""), id_string("a"), id_string("ab"), id_string("hello"),
        id_string("héllo"), id_string("日本語"), id_string("a\u0301"), id_string("x y"),
        id_string("0123456789"), id_string("\n\t"), id_string("😀"),
        id_string("héllo, 日本 😀")]
    for (s in pool) {
        out.append("size ${s.size} cp ${s.codePointCount()} valid ${s.isValidUtf8()}")
        var sum = 0
        for (b in s) sum = sum * 31 + b
        out.append("bytes ${sum}")
    }
    out
}

fun slicesN(): array<string> {
    val out: array<string> = []
    val pool: array<string> = [id_string(""), id_string("a"), id_string("ab"), id_string("hello"),
        id_string("héllo"), id_string("日本語"), id_string("a\u0301"), id_string("x y"),
        id_string("0123456789"), id_string("\n\t"), id_string("😀"),
        id_string("héllo, 日本 😀")]
    for (s in pool) {
        var a = 0
        while (a <= s.size) {
            var b = a
            while (b <= s.size) {
                out.append("slice ${a} ${b} [${s.slice(a, b)}]")
                b = b + 1
            }
            a = a + 1
        }
    }
    out
}

