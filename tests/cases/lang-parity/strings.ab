    val present: int? = n
    val words: string? = null
    val c = char(65)
    val small = i8(-5)
    val wide = u64(18446744073709551615)
    out.append("ints ${n} ${big} ${-big} ${small} ${wide} ${u8(250)} ${i16(-300)} ${u32(7)}")
    out.append("bool ${flag} ${!flag} ${n > 3}")
    out.append("float ${x} ${x * 2.0} ${f64ToF32(x)} ${x / 0.0} ${0.0 - x}")
    out.append("str ${name} ${name + name} [${""}] ${"a${n}b"}")
    out.append("nullable ${maybe ?? -1} ${present ?? -1} ${words ?? "none"} ${maybe == null}")
    out.append("char ${c} ${int(c)}")
    out.append("nested ${"x${"y${n}"}"} ${if (flag) "yes" else "no"} ${n + 1}${n - 1}")
    out.append("$n$name${flag}")
    out
}

