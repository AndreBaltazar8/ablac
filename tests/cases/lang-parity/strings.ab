fun report(name: string, native: array<string>, staged: array<string>): int {
    var bad = 0
    if (native.size != staged.size) {
        println("${name}: sizes ${native.size} ${staged.size}")
        bad = 1000000
    }
    var i = 0
    while (i < native.size && i < staged.size) {
        if (native[i] != staged[i]) {
            bad = bad + 1
            if (bad <= 5) println("${name}[${i}]\nnative: ${native[i]}\nstaged: ${staged[i]}")
        }
        i = i + 1
    }
    bad
}

fun main: int {
    var bad = 0
    bad = bad + report("sizes", sizesN(), #sizesC())
    bad = bad + report("slices", slicesN(), #slicesC())
    bad = bad + report("indexing", indexingN(), #indexingC())
    bad = bad + report("compare", compareN(), #compareC())
    bad = bad + report("operations", operationsN(), #operationsC())
    bad = bad + report("long", longN(), #longC())
    bad = bad + report("interpolation", interpolationN(), #interpolationC())
    if (bad == 0) 42 else 1
}
