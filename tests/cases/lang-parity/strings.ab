fun operationsN(): array<string> {
    val out: array<string> = []
    val pool: array<string> = [id_string(""), id_string("a"), id_string("ab"), id_string("hello"),
        id_string("héllo"), id_string("日本語"), id_string("a\u0301"), id_string("x y"),
