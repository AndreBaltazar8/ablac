}

fun longN(): array<string> {
    val out: array<string> = []
    var big = id_string("")
    var i = 0
    while (i < 20000) {
        big = big + (if (i % 3 == 0) id_string("é") else id_string("ab"))
        i = i + 1
    }
    var sum = 0
    for (b in big) sum = sum * 31 + b
    out.append("long ${big.size} ${big.codePointCount()} ${sum}")
    out.append("tail [${big.slice(big.size - 7, big.size)}] head [${big.slice(0, 7)}]")
    val doubled = big + big
    out.append("doubled ${doubled.size} ${doubled == big + big} ${doubled.indexOf("éabab")}")
    out
}

