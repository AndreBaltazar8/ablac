        id_string("héllo, 日本 😀")]
    for (s in pool) {
        out.append("up [${s.uppercase()}] lo [${s.lowercase()}] trim [${(" " + s + " ").trim()}]")
        out.append("rep [${s.repeat(3)}] pad [${s.padStart(8, "*")}] [${s.padEnd(8, ".")}]")
        out.append("repl [${s.replace("l", "LL")}] [${s.replace("", "-")}]")
        val parts = s.split(id_string("l"))
        out.append("split ${parts.size}")
        for (part in parts) out.append("part [${part}]")
    }
