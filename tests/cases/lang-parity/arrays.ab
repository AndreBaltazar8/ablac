fun growthN(): array<string> {
    val out: array<string> = []
    val a: array<int> = []
    var i = 0
    val limit = id_int(3000)
    while (i < limit) {
        a.append(i * i)
        i = i + 1
    }
    var sum = 0
    for (v in a) sum = sum + v
    out.append("grown ${a.size} ${sum} ${a[0]} ${a[limit - 1]} ${a[limit / 2]}")
    a.truncate(id_int(10))
    out.append("truncated ${showInts(a)}")
    a.truncate(id_int(100))
    out.append("beyond ${a.size}")
    a.clear()
    a.append(id_int(5))
    out.append("cleared ${showInts(a)}")
    val f = filledArray(id_int(4), id_int(7))
    f[1] = id_int(9)
    out.append("filled ${showInts(f)} ${filledArray(0, 1).size}")
    val r = [id_int(5), id_int(6), id_int(7), id_int(8)]
    out.append("removeAt ${r.removeAt(1)} ${r.removeLast()} ${showInts(r)}")
    out
}

fun aliasingN(): array<string> {
    val out: array<string> = []
    val a = [id_int(1), 2, 3]
    push(a, id_int(4))
    val b = a
    out.append("alias ${showInts(a)} ${showInts(b)} ${a.size == b.size}")
    val rows: array<array<int>> = []
    var i = 0
    while (i < id_int(4)) {
        val row: array<int> = []
        var j = 0
        while (j <= i) {
            row.append(i * 10 + j)
            j = j + 1
        }
        rows.append(row)
        i = i + 1
    }
    rows[2].append(id_int(-1))
    setAt(rows, 3, 0, id_int(-2))
    var text = ""
    for (row in rows) text = text + showInts(row)
    out.append("rows ${rows.size} ${text}")
    val names = [id_string("b"), id_string("é"), id_string("a")]
    names.append(id_string("日本"))
    out.append("strings ${showStrings(names)} ${names.size}")
    var total = 0
    for (k in 0 .. 3) total = total + k
    for (k in 2 until 5) total = total * 10 + k
    out.append("ranges ${total}")
    out
}

