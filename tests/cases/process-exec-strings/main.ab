// Every way abla/process starts a child, with each string the child needs computed (not a literal)
// and a collection at every allocation (#829): the executable found on PATH, the working directory
// and the redirect paths must still be what the child gets. Exits 42, or the first check that failed.
import "abla/process"
import "abla/memory"
import "abla/sys/linux/process"

fun main: int {
    memorySetCollectionGrowth(1)
    val shell = "s" + "h"
    val root = "/" + "proc"
    val output = "build/process-exec-strings/" + "out.txt"
    val captured = command(shell).argument("-c").argument("printf Abla").captureText()
    val inDirectory = command(shell).argument("-c").argument("pwd").directory(root).captureText()
    val ran = command(shell).argument("-c").argument("printf ran").output(output).run()
    val written = command(shell).argument("-c").argument("cat " + output).captureText()
    val piped = command(shell).argument("-c").argument("printf ab")
        .pipe(command(shell).argument("-c").argument("tr a-z A-Z")).capture()
    val configured = linuxStartConfiguredProcess(root, [shell, "-c", "exit 7"])
    var status = configured.poll()
    while (status == -1) status = configured.poll()
    val checks = [
        captured == "Abla", inDirectory == "/proc\n", ran == 0, written == "ran",
        piped.output == "AB", piped.status == 0, status == 7
    ]
    var index = 0
    while (index < checks.size) {
        if (!checks[index]) return index + 1
        index = index + 1
    }
    42
}
