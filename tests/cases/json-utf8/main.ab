import "abla/io"
import "abla/bytes"
import "abla/json"
import "abla/text"

// Raw invalid UTF-8 in the JSON text is rejected by jsonParse, jsonValidate and jsonDocument with the
// same error code and the byte offset of the first bad sequence; valid multibyte text is accepted by all
// three. (The check is the runtime's word-skipping validator, with the per-byte pass only for the offset.)
fun check(name: string, text: string, offset: int): int {
    var bad = 0
    val parsed = jsonParse(text)
    val validated = jsonValidate(text)
    val document = jsonDocument(text)
    if (offset < 0) {
        if (!parsed.succeeded || !validated.succeeded || !document.succeeded) {
            println("$name: a valid text was rejected")
            bad = bad + 1
        }
    } else {
        if (parsed.succeeded || parsed.error.code != "invalid_unicode" || parsed.error.byteOffset != offset) {
            println("$name: jsonParse ${parsed.succeeded} ${parsed.error.code} ${parsed.error.byteOffset}, expected offset $offset")
            bad = bad + 1
        }
        if (validated.succeeded || validated.error.code != "invalid_unicode" || validated.error.byteOffset != offset) {
            println("$name: jsonValidate ${validated.error.code} ${validated.error.byteOffset}, expected offset $offset")
            bad = bad + 1
        }
        if (document.succeeded || document.error.code != "invalid_unicode" || document.error.byteOffset != offset) {
            println("$name: jsonDocument ${document.error.code} ${document.error.byteOffset}, expected offset $offset")
            bad = bad + 1
        }
    }
    bad
}

fun main: int {
    var bad = 0
    bad = bad + check("ascii", "[1,2,{\"a\":\"b\"}]", -1)
    bad = bad + check("multibyte", "[\"olá é 日本 😀\", {\"k\": \"ç\"}]", -1)
    bad = bad + check("long ascii then a lead", "[\"" + "x".repeat(40) + "\xc3\"]", 42)
    bad = bad + check("lone continuation", "[1,\"\x80\"]", 4)
    bad = bad + check("0xff", "[1,\"\xff\"]", 4)
    bad = bad + check("bad continuation", "[\"\xc3(\"]", 2)
    bad = bad + check("overlong", "[\"\xc0\x80\"]", 2)
    bad = bad + check("surrogate", "[\"\xed\xa0\x80\"]", 2)
    bad = bad + check("past 10ffff", "[\"\xf4\x90\x80\x80\"]", 2)
    bad = bad + check("truncated at the end", "{\"k\":1}\xe2\x82", 7)
    bad = bad + check("after multibyte", "[\"é\xff\"]", 4)
    // The bad byte at every lane of an aligned 8-byte word (and past it): the word skip stops at the
    // right place.
    for (k in 0 until 24) {
        bad = bad + check("lane $k", "[\"" + "x".repeat(k) + "\x80\"]", 2 + k)
    }
    // The runtime's validator and the per-byte one accept the same strings: every string of up to four
    // bytes drawn from the bytes where the rules change.
    val pool = [65, 128, 194, 224, 237, 240, 244, 255, 160, 144]
    var disagreements = 0
    var strings = 0
    var length = 0
    while (length <= 4) {
        var combination = 0
        var total = 1
        for (i in 0 until length) total = total * pool.size
        while (combination < total) {
            var text = ""
            var rest = combination
            for (i in 0 until length) {
                text = text + byteEncode(pool[rest % pool.size])
                rest = rest / pool.size
            }
            if (text.isValidUtf8() != utf8Info(text).valid) {
                disagreements = disagreements + 1
                if (disagreements < 5) println("validators disagree on length $length combination $combination")
            }
            strings = strings + 1
            combination = combination + 1
        }
        length = length + 1
    }
    if (disagreements != 0 || strings != 11111) {
        println("validators: $disagreements disagreements over $strings strings")
        bad = bad + 1
    }
    if (bad == 0) 42 else 1
}
