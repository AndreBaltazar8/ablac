// x25519 SCALAR-HEX POINT-HEX: the result in hex, or "error: ..." (tools/test-x25519.sh compares it with openssl).
import "abla/io"
import "abla/crypto"
import "abla/crypto/x25519"
import "abla/sys/linux/process"

fun main: int {
    if (linuxArgumentCount() != 2) {
        println("usage: tool SCALAR-HEX POINT-HEX")
        return 2
    }
    val result = x25519(hexDecode(linuxArgument(0)), hexDecode(linuxArgument(1)))
    if (result.ok) println(hexEncode(result.bytes)) else println("error: ${result.error}")
    0
}
