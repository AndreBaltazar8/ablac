// array.sorted / sortedBy and sortedStrings against reference insertion sorts, over empty, short, long, sorted,
// reversed, equal-heavy and random inputs; the sort must be stable and must leave its input unchanged.
import "abla/io"
import "abla/array"
import "abla/text"

class Item(val key: int, val id: int)

var failures = 0
var checks = 0
var seed = 12345

fun next(limit: int): int {
    seed = (seed * 6364136223846793005 + 1442695040888963407) & 9223372036854775807
    (seed >> 20) % limit
}

fun bad(label: string): void {
    failures += 1
    if (failures < 20) println("FAIL $label")
    return
}

fun referenceInts(values: array<int>): array<int> {
    val result: array<int> = []
    for (value in values) {
        result.append(value)
        var index = result.size - 1
        while (index > 0 && value < result[index - 1]) {
            result[index] = result[index - 1]
            index = index - 1
        }
        result[index] = value
    }
    result
}

fun referenceLess(left: string, right: string): bool {
    var index = 0
    while (index < left.size && index < right.size) {
        if (left[index] != right[index]) return left[index] < right[index]
        index = index + 1
    }
    left.size < right.size
}

fun referenceStrings(values: array<string>): array<string> {
    val result: array<string> = []
    for (value in values) {
        result.append(value)
        var index = result.size - 1
        while (index > 0 && referenceLess(value, result[index - 1])) {
            result[index] = result[index - 1]
            index = index - 1
        }
        result[index] = value
    }
    result
}

fun referenceItems(values: array<Item>): array<Item> {
    val result: array<Item> = []
    for (value in values) {
        result.append(value)
        var index = result.size - 1
        while (index > 0 && value.key < result[index - 1].key) {
            result[index] = result[index - 1]
            index = index - 1
        }
        result[index] = value
    }
    result
}

fun checkInts(values: array<int>, label: string): void {
    checks += 1
    val before: array<int> = []
    for (v in values) before.append(v)
    val got = values.sorted()
    val want = referenceInts(values)
    if (got.size != want.size) { bad("ints size $label"); return }
    var i = 0
    while (i < got.size) {
        if (got[i] != want[i]) { bad("ints $label at $i"); return }
        if (values[i] != before[i]) { bad("ints input changed $label"); return }
        i += 1
    }
    return
}

fun checkStrings(values: array<string>, label: string): void {
    checks += 1
    val got = values.sorted()
    val want = referenceStrings(values)
    val viaOld = sortedStrings(values)
    if (got.size != want.size || viaOld.size != want.size) { bad("strings size $label"); return }
    var i = 0
    while (i < got.size) {
        if (got[i] != want[i] || viaOld[i] != want[i]) { bad("strings $label at $i"); return }
        i += 1
    }
    return
}

fun checkItems(values: array<Item>, label: string): void {
    checks += 1
    val got = values.sortedBy { a, b -> a.key < b.key }
    val want = referenceItems(values)
    if (got.size != want.size) { bad("items size $label"); return }
    var i = 0
    while (i < got.size) {
        if (got[i].key != want[i].key || got[i].id != want[i].id) { bad("items (stability) $label at $i"); return }
        i += 1
    }
    return
}

fun word(): string {
    val pieces = ["", "a", "ab", "abc", "b", "é", "日本", "Z", "z", "0", "app", "apple", "apples", "ap"]
    var text = ""
    var parts = next(3) + 1
    while (parts > 0) {
        text = "$text${pieces[next(pieces.size)]}"
        parts -= 1
    }
    text
}

fun main: int {
    val sizes = [0, 1, 2, 3, 7, 8, 9, 15, 16, 17, 31, 32, 33, 64, 100, 255, 256, 257, 1000, 5000]
    for (size in sizes) {
        for (shape in 0 until 5) {
            val ints: array<int> = []
            val strings: array<string> = []
            val items: array<Item> = []
            var i = 0
            while (i < size) {
                val n = if (shape == 0) next(1000000) - 500000
                    else if (shape == 1) i
                    else if (shape == 2) size - i
                    else if (shape == 3) next(4)
                    else (i * 7) % 13
                ints.append(n)
                strings.append(if (shape == 1) "k${1000000 + i}" else if (shape == 2) "k${2000000 - i}" else word())
                items.append(Item(n, i))
                i += 1
            }
            checkInts(ints, "size $size shape $shape")
            checkStrings(strings, "size $size shape $shape")
            checkItems(items, "size $size shape $shape")
        }
    }
    if (failures == 0) println("array-sort ok ($checks cases)")
    else println("array-sort FAILED: $failures")
    return if (failures == 0) 0 else 1
}
