import "abla/io"
import "first.ab"
import "later.ab"

// One lambda in each instance of a generic function, and of a generic class's method.
fun <T> twice(value: T, n: int): int { val h = { x: int -> x * 2 + n }; return h(n) }
class Bag<T>(val item: T) {
    fun count(k: int): int { val h = { x: int -> x + k }; return h(1) }
}

fun main(): int {
    println("${firstAdder()(5)} ${laterAdder()(5)} ${firstGlobal(5)} ${laterGlobal(5)} ${FirstBox(4).run()} ${LaterBox(4).run()}")
    println("${twice(1, 3)} ${twice("s", 4)} ${Bag(1).count(2)} ${Bag("a").count(5)}")
    42
}
