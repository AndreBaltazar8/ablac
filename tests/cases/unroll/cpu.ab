// tools/test-unroll.sh: `@unroll(n)` and `@unroll` on CPU loops (#1296): the IR's loops carry llvm.loop unroll
// metadata, and the program prints what the same loops print without the hints.
import "abla/io"
import "abla/process"

fun mix(n: int): int {
    var total = 0
    @unroll(4)
    for (i in 0 until n) total = total + i * 3
    var k = 0
    @unroll(2) while (k < n) {
        total = total ^ (k * 7)
        k = k + 1
    }
    @unroll
    for (j in 0 until 8) total = total + j * j
    @unroll(3) outer@ do {
        total = total + 1
    } while (total % 5 != 0)
    total
}

fun main {
    println("${mix(processArgumentCount() + 10)}")
}
