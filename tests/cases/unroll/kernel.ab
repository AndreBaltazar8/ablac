// tools/test-unroll.sh: the same 4-trip loop in two kernels, unrolled fully by `@unroll` (its PTX has no back edge)
// and kept a loop by `@unroll(1)` (it has one), so the hint is what decides.
import "abla/io"
import "abla/kernel"

@kernel
fun unrolledQuad(x: KernelF32Buffer, y: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) {
        var sum = f32(0.0)
        @unroll
        for (k in 0 until 4) sum = kernelFma(x.load(i * 4 + k), x.load(k), sum)
        y.store(i, sum)
    }
}

@kernel
fun rolledQuad(x: KernelF32Buffer, y: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) {
        var sum = f32(0.0)
        @unroll(1)
        for (k in 0 until 4) sum = kernelFma(x.load(i * 4 + k), x.load(k), sum)
        y.store(i, sum)
    }
}

fun main {
    print(kernelPtx())
}
