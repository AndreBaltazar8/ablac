import "abla/io"
import "site-provider.ab"

val atTop: string = $site()
fun first(): string = $site()
fun second(x: int): string {
    val a = $site()
    val b = $site()
    return "$a $b"
}
class Holder(val k: int) {
    fun inMethod(): string = $site()
}
fun main(): int {
    println("$atTop ${first()} ${second(1)} ${Holder(1).inMethod()}")
    42
}
