import "abla/compiler"
import "abla/compiler/parser"

// `$site()`: the site's key, as a string.
compile fun parseSite(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    syntaxString(parserSiteKey(cursor))
}

#compilerRegisterSubparser("site", parseSite)
