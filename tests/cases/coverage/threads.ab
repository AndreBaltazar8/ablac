import "sub/used.ab"
import "sub/unused.ab"
import "sub/third.ab"

// Two OS threads run functions of two other modules; main joins both and returns, so the dump runs once.
fun main(): int {
    val first = thread { usedHelper() }
    val second = thread { neverCalled() }
    await first + await second + thirdHelper() * 0
}
