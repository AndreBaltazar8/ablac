import "abla/process/exit"
import "abla/sys/linux/process"
import "sub/used.ab"
import "sub/unused.ab"

// Usage: main <mode>: "return" ends by returning from main, "exit" calls exit(3), "panic" panics, "wait" sleeps for a signal.
fun main(): int {
    val mode = linuxArgument(0)
    usedHelper()
    if (mode == "exit") exit(3)
    if (mode == "panic") panic("coverage fixture")
    if (mode == "wait") {
        var spin = 0
        while (spin < 2000000000) spin = spin + 1
    }
    if (mode == "never") return neverCalled()
    0
}
