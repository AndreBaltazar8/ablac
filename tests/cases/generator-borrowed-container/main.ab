import "abla/io"
var log: string = ""
resource class Item(val id: int) {
    fun drop(): void { log = log + "I$id" }
    fun look(): void { log = log + "B$id" }
}
resource class Box(val items: array<Item>) { fun drop(): void { log = log + "H" } }
fun items(): array<Item> = [Item(1), Item(2)]
val globalItems = items()
fun mapping(): Map<string, Item> {
    val m: Map<string, Item> = Map()
    m.set("a", Item(1)); m.set("b", Item(2)); m
}
fun outer(fresh: bool, finish: bool): Generator<int> = generator {
    val owned = items()
    for (x in if (fresh) items() else owned) {
        x.look(); yield x.id
        if (finish) return
    }
}
fun mapOuter(): Generator<int> = generator {
    val owned = mapping()
    for (x in owned.values()) { x.look(); yield x.id }
}
fun mapChoice(flag: bool): Generator<int> = generator {
    val owner = mapping()
    for (x in if (flag) owner.values() else owner.values()) { x.look(); yield x.id }
}
fun nestedMap(): Generator<int> = generator {
    val owner = mapping()
    for (x in owner.values()) { for (y in owner.values()) { x.look(); y.look(); yield y.id } }
}
fun nested(): Generator<int> = generator {
    val owned = items()
    for (x in owned) { for (y in owned) { x.look(); y.look(); yield y.id } }
}
fun fieldOuter(): Generator<int> = generator {
    val owner = Box(items())
    for (x in owner.items) { x.look(); yield x.id }
}
fun globalOuter(): Generator<int> = generator {
    for (x in globalItems) { x.look(); yield x.id }
}
fun exercise(): string {
    log = ""
    for (v in outer(false, false)) { break }; log += "|"
    for (v in outer(false, false)) {}; log += "|"
    for (v in outer(false, true)) {}; log += "|"
    for (v in outer(true, false)) { break }; log += "|"
    for (v in mapOuter()) { break }; log += "|"
    for (v in mapOuter()) {}; log += "|"
    for (v in mapChoice(true)) { break }; log += "|"
    for (v in mapChoice(false)) {}; log += "|"
    for (v in nestedMap()) { break }; log += "|"
    for (v in nested()) { break }; log += "|"
    for (v in fieldOuter()) { break }; log += "|"
    for (v in globalOuter()) { break }; log += "|"
    if (true) { val beforeInit = outer(false, false) }; log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
