import "abla/compiler"
import "abla/io"
fun factory(): (int) -> int = ({ x: int -> x + 1 })
compile var kept: (int) -> int = factory()
compile var before: int = 0
compile fun edit(): void {
    before = kept(10)
    compiler.replaceFunctionBody(compiler.findFunction("factory"), "({ x: int -> x + 2 })")
    return
}
#compiler.transform(edit)
compile var middle: (int) -> int = factory()
compile var between: int = 0
fun marker(): int = 0
compile fun editAgain(): void {
    between = middle(10)
    compiler.replaceFunctionBody(compiler.findFunction("marker"), "1")
    return
}
#compiler.transform(editAgain)
val BEFORE = #before
val BETWEEN = #between
val MIDDLE = #middle(10)
val OLD = #kept(10)
val NEW = #(factory()(10))
val RUNTIME_NEW = #(factory())
fun main: int {
    println("$BEFORE,$OLD,$BETWEEN,$MIDDLE,$NEW,${RUNTIME_NEW(10)},${factory()(10)}")
    0
}
