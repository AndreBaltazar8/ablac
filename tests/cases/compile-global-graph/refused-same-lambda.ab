import "abla/compiler"
fun factory(): () -> int {
    val captured: i32 = i32(-1)
    { -> int(captured) }
}
compile var kept = factory()
compile var before = 0
compile fun edit(): void {
    before = kept()
    compiler.replaceFunctionBody(compiler.findFunction("factory"),
        "{ val captured: u32 = u32(-1); { -> int(captured) } }")
    return
}
#compiler.transform(edit)
// The lambda body is identical; its enclosing captured local has another type.
val LIFTED_OLD = #kept
fun main: int = LIFTED_OLD()
