import "abla/io"

val arrayRoot: array<int> = []
val arrayAlias = arrayRoot
fun arrayStep(): int { arrayRoot.append(1); arrayAlias.size }

class Counter(var value: int)
class Holder(val target: Counter)
val objectHolder = Holder(Counter(0))
val objectRoot = objectHolder.target
fun objectStep(): int { objectRoot.value += 1; objectHolder.target.value }

val nestedRow: array<int> = []
val matrix = [nestedRow]
val nestedAlias = matrix[0]
fun nestedStep(): int {
    nestedRow.append(1)
    nestedAlias.size + matrix[0].size
}

val mapRoot: Map<string, int> = Map()
val mapAlias = mapRoot
fun mapStep(): int { mapRoot.set("k${mapRoot.size}", 1); mapAlias.size }

class Node(var value: int, var next: Node?)
fun makeCycle(): Node { val value = Node(0, null); value.next = value; value }
val cycleRoot = makeCycle()
val cycleAlias = cycleRoot.next ?? cycleRoot
fun cycleStep(): int {
    cycleAlias.value += 1
    cycleRoot.value + (cycleRoot.next ?? cycleRoot).value
}

var untouched = 0
fun writeOnly(): void { untouched = 99 }
fun resetAll(): void {
    arrayRoot.clear()
    objectRoot.value = 0
    nestedRow.clear()
    mapRoot.clear()
    cycleRoot.value = 0
}
#resetAll()
val array1 = #arrayStep()
val object1 = #objectStep()
val nested1 = #nestedStep()
val map1 = #mapStep()
val cycle1 = #cycleStep()
#writeOnly()
val array2 = #arrayStep()
val object2 = #objectStep()
val nested2 = #nestedStep()
val map2 = #mapStep()
val cycle2 = #cycleStep()
#writeOnly()
val array3 = #arrayStep()
val object3 = #objectStep()
val nested3 = #nestedStep()
val map3 = #mapStep()
val cycle3 = #cycleStep()
#writeOnly()
val COMPILED =
    "$array1,$array2,$array3|$object1,$object2,$object3|$nested1,$nested2,$nested3|$map1,$map2,$map3|$cycle1,$cycle2,$cycle3"
fun runtime(): string {
    resetAll()
    val array1 = arrayStep()
    val object1 = objectStep()
    val nested1 = nestedStep()
    val map1 = mapStep()
    val cycle1 = cycleStep()
    writeOnly()
    val array2 = arrayStep()
    val object2 = objectStep()
    val nested2 = nestedStep()
    val map2 = mapStep()
    val cycle2 = cycleStep()
    writeOnly()
    val array3 = arrayStep()
    val object3 = objectStep()
    val nested3 = nestedStep()
    val map3 = mapStep()
    val cycle3 = cycleStep()
    writeOnly()
    "$array1,$array2,$array3|$object1,$object2,$object3|$nested1,$nested2,$nested3|$map1,$map2,$map3|$cycle1,$cycle2,$cycle3"
}
fun main: int { println(COMPILED); println(runtime()); 0 }
