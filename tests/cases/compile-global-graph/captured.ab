import "abla/io"
class Values(val data: array<int>)
compile var kept = Values([])
val alias = #kept
fun count(value: Values): int = value.data.size
compile fun step(): int { kept.data.append(1); count(alias) }
val A = #step()
val B = #step()
val C = #step()
fun main: int {
    println("$A,$B,$C")
    val value = Values([])
    val other = value
    value.data.append(1); val a = count(other)
    value.data.append(1); val b = count(other)
    value.data.append(1); val c = count(other)
    println("$a,$b,$c")
    0
}
