import "abla/compiler"
import "abla/io"
class Handler(val run: (int) -> int)
fun factory(): Handler = Handler({ x: int -> x + 1 })
compile var kept = factory()
compile fun seed(): void { val force = kept; return }
#seed()
compile fun change(): bool = compiler.replaceFunctionBody(compiler.findFunction("factory"),
    "Handler({ x: int -> x + 2 })")
val CHANGED = #change()
val OLD = #(kept.run(10))
val NEW = #(factory().run(10))
fun main: int { println("$OLD,$NEW"); 0 }
