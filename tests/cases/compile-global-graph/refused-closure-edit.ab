import "abla/compiler"
import "abla/io"
fun factory(): (int) -> int = ({ x: int -> x + 1 })
compile var kept: (int) -> int = factory()
compile var before: int = 0
compile fun edit(): void {
    before = kept(10)
    compiler.replaceFunctionBody(compiler.findFunction("factory"), "({ x: int -> x + 2 })")
    return
}
#compiler.transform(edit)
val BEFORE = #before
val OLD = #kept(10)
val NEW = #(factory()(10))
val RUNTIME_OLD = #kept
fun main: int {
    println("$BEFORE,$OLD,$NEW,${RUNTIME_OLD(10)},${factory()(10)}")
    0
}
