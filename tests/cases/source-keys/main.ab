import "abla/io"
import "a.ab" as a
import "b.ab" as b

// Two modules whose identifiers have equal (offset, text) must stay distinct: the lowering asks whether a name is a local
// that shadows a top-level one by the identifier's source, offset and text, and the source's short key must name one source
// only, in the build and in the build a `#` expression starts (a.g() is 40: the local; b.g() is 1: the global).
fun pair(): int = a.g() * 100 + b.g()

fun main: int {
    val run = pair()
    val folded = #pair()
    println("$run $folded")
    if (run == 4001 && folded == 4001) 42 else 1
}
