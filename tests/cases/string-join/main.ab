import "abla/text"
fun check(): bool {
    val empty: array<string> = []
    val one = ["a"]
    val values = ["a", "", "é"]
    empty.join(",") == "" && one.join(",") == "a" &&
    values.join(",") == "a,,é" && values.join("") == "aé" &&
    values.join() == "aé" && values.size == 3
}
compile fun staged(): bool = check()
fun main: int = if (check() && #staged()) 0 else 1
