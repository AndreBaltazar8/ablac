// An element the loop borrows from an array (or a map's values), or a local a `when` arm names, stored or bound without a move: refused (todo #1039's kin: it was kept beside its owner and dropped twice).
// refused: ownership.borrow-escape:index.assign:x
import "abla/io"
var drops: int = 0
resource class R(val id: int) {
    fun drop(): void {
        drops = drops + 1
    }
}
class Holder(var inner: R? = null)
class Box(val tag: int, var item: R)
fun mkR(id: int): R = R(id)
fun take(r: R): int = r.id
fun peek(r: R?): int = r?.id ?? 0


fun scenario(): void {
    val src: array<R> = [mkR(1)]
    val dst: array<R> = [mkR(2)]
    for (x in src) dst[0] = x
}
fun main: int {
    scenario()
    println("drops ${drops}")
    0
}
