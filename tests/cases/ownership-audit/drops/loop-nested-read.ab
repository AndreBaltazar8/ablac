// Counts the drops of a resource: each object once.
import "abla/io"
var drops: int = 0
resource class R(val id: int) {
    fun drop(): void {
        drops = drops + 1
    }
}
class Holder(var inner: R? = null)
class Box(val tag: int, var item: R)
fun mkR(id: int): R = R(id)
fun take(r: R): int = r.id
fun peek(r: R?): int = r?.id ?? 0


fun scenario(): void {
    val grid: array<array<R>> = [[mkR(1)]]
    val sink: array<R> = []
    for (row in grid) {
        for (cell in row) println("${cell.id}")
    }
}
fun main: int {
    scenario()
    println(if (drops == 1) "ownership audit ok" else "FAIL drops ${drops}, expected 1")
    0
}
