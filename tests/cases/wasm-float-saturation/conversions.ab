// Float to integer conversions exported to a WebAssembly host: an out-of-range
// or NaN input saturates instead of trapping.
import "abla/float"

@export("to_i32")
fun toI32(value: f64): i32 = f32ToI32(f64ToF32(value))

@export("to_u32")
fun toU32(value: f64): u32 = f32ToU32(f64ToF32(value))

@export("to_i64")
fun toI64(value: f64): int = f64ToInt(value)
