import "abla/build"

trusted noescape extern:"inline-assembly" fun assemblyVoid(
    template: string,
    constraints: string
): void

fun retainedFromAssembly(): void {}
fun unusedInternalAlias(): void {}
fun unusedScalarInitializer(): u32 = u32(7)

val unusedConvertedGlobal = u32(unusedScalarInitializer())

val retainedLink = #internalFunction(
    "retainedFromAssembly",
    "abla_test_reachable_from_assembly"
)
val unusedLink = #internalFunction(
    "unusedInternalAlias",
    "abla_test_unused_internal_alias"
)
val unusedInitializerLink = #internalFunction(
    "unusedScalarInitializer",
    "abla_test_unused_scalar_initializer"
)

@naked
@export("abla_test_assembly_root")
trusted fun assemblyRoot(): void = assemblyVoid(
    "call abla_test_reachable_from_assembly\nret",
    "~{memory}"
)

fun main: int = if (
    retainedLink && unusedLink && unusedInitializerLink
) 0 else 1
