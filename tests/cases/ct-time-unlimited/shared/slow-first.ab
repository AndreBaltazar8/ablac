// quick.ab's module, slow: its site keeps busy for 2.5 s itself, so its call stops at a 1 s limit even though the
// unlimited site it also runs (played.ab's) is not.
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

fun slowQuick(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 2500) turns = turns + 1
    1
}

val quickly = #slowQuick()
