// played.ab with a slow first module (slow-first.ab): that module's own 2.5 s still stops at the limit.
import "abla/compiler"
import "abla/process/time"
import "slow-first.ab"
#compilerGrant("clock")
#compilerGrant("time.unlimited")

fun play(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 2500) turns = turns + 1
    40
}

val played = #play()
val answer = #(played + quickly + 1)
fun main: int = answer
