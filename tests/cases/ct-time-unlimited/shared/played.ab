// The module that requests `time.unlimited`: a slow site (2.5 s) that a later site reads, so the slice keeps it and
// the first native call (quick.ab's) runs it. Only its own code runs without the limit. Exits 42.
import "abla/compiler"
import "abla/process/time"
import "quick.ab"
#compilerGrant("clock")
#compilerGrant("time.unlimited")

fun play(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 2500) turns = turns + 1
    40
}

val played = #play()
val answer = #(played + quickly + 1)
fun main: int = answer
