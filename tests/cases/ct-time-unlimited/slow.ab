// A `#` site that keeps busy for 2.5 s and returns 42 (tools/test-ct-time-unlimited.sh): it stops at a 1 s
// ABLA_COMPILE_EVAL_TIME_LIMIT, since this module doesn't request `time.unlimited`.
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

fun nap(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 2500) turns = turns + 1
    42
}

val napped = #nap()
fun main: int = napped
