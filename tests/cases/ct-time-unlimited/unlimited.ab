// slow.ab's site in a module that requests `time.unlimited` (decision #81 C): it isn't stopped. Exits 42.
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")
#compilerGrant("time.unlimited")

fun nap(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 2500) turns = turns + 1
    42
}

val napped = #nap()
fun main: int = napped
