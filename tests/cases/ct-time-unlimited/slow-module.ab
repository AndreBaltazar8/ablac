// A module with a slow `#` site and no `time.unlimited` of its own (granting.ab imports it).
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

fun slowNap(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 2500) turns = turns + 1
    42
}

val slowNapped = #slowNap()
