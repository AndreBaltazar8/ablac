// Forked peers that misbehave according to the request's path, over TLS and
// over plain TCP. A client that dies leaves no peer behind (PR_SET_PDEATHSIG).
import "abla/http"
import "abla/net"
import "abla/process"
import "abla/process/time"
import "abla/sys/linux"
import "abla/tls/hosted"
import "abla/unsafe/memory"
import "abla/websocket"

// An unread close with a zero linger sends RST rather than FIN.
trusted fun peerResetDescriptor(descriptor: int): void {
    val linger = nativeByteBuffer(8)
    // l_onoff 1, l_linger 0.
    linger.storeI64(0, 1)
    linuxSyscall5(54, descriptor, 1, 13, nativePointerAddress(linger.address), 8)
    linger.close()
    linuxTcpCloseDescriptor(descriptor)
    return
}

trusted fun peerResetTls(handle: int): void {
    peerResetDescriptor(tlsControlInt(handle, 16))
    return
}

val peerOk = "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nbody"

fun peerSleep(milliseconds: int): void {
    val limit = monotonicMilliseconds() + milliseconds
    while (monotonicMilliseconds() < limit) linuxSyscall3(7, 0, 0, 20)
    return
}

fun peerServeTls(var listener: TlsListener): void {
    var resets = 0
    val held: array<int> = []
    while (true) {
        var connection = listener.accept()
        var serving = connection.handle != -1
        while (serving) {
            val request = connection.read(65536)
            serving = false
            if (request.contains("/stall ")) {
                // Neither answers nor reads what follows.
                held.append(connection.handle)
                connection.handle = -1
            } else if (request.contains("/reset ") ||
                (request.contains("/flaky ") && resets == 0)) {
                if (request.contains("/flaky ")) resets = 1
                val handle = connection.handle
                connection.handle = -1
                peerResetTls(handle)
            } else if (request.contains("/kept ")) {
                // Stays open for the next request on this connection.
                connection.write(peerOk)
                serving = true
            } else if (request.contains("/drip ")) {
                connection.write("HTTP/1.1 200 OK\r\nContent-Length: 1000000\r\n\r\n")
                while (connection.write("x") == 1) peerSleep(50)
            } else if (request.contains("/late ")) {
                peerSleep(800)
                connection.write("late")
                peerSleep(100)
            } else if (request.contains("/ws ")) {
                // Accepts the upgrade, stays quiet for a while, sends one frame.
                val key = httpParseRequest(request).header("Sec-WebSocket-Key")
                connection.write("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ${webSocketAccept(key)}\r\n\r\n")
                peerSleep(800)
                connection.write("\x82\x02hi")
                connection.read(64)
            } else if (request.size > 0) {
                connection.write(peerOk)
            }
        }
        if (connection.handle != -1) connection.close()
    }
    return
}

fun peerServeTcp(var listener: TcpListener): void {
    val held: array<int> = []
    while (true) {
        var connection = listener.accept()
        val request = connection.read(65536)
        if (request.contains("/stall ")) {
            held.append(connection.descriptor)
            connection.descriptor = -1
        } else if (request.contains("/reset ")) {
            val descriptor = connection.descriptor
            connection.descriptor = -1
            peerResetDescriptor(descriptor)
        } else if (request.contains("/drip ")) {
            connection.write("HTTP/1.1 200 OK\r\nContent-Length: 1000000\r\n\r\n")
            while (connection.write("x") == 1) peerSleep(50)
        } else if (request.contains("/late ")) {
            peerSleep(800)
            connection.write("late")
        } else if (request.contains("/kept ")) {
            // Answers in full and leaves the connection open.
            connection.write(peerOk)
            held.append(connection.descriptor)
            connection.descriptor = -1
        } else if (request.size > 0) {
            connection.write(peerOk)
        }
        if (connection.descriptor >= 0) connection.close()
    }
    return
}

// Accepts and never says anything: a TLS handshake waits here.
fun peerServeSilent(var listener: TcpListener): void {
    val held: array<int> = []
    while (true) {
        var connection = listener.accept()
        held.append(connection.descriptor)
        connection.descriptor = -1
    }
    return
}

fun peerForked(): bool {
    val parent = linuxSyscall0(39)
    val child = linuxSyscall0(57)
    if (child == 0) {
        linuxSyscall2(157, 1, 9)
        // A parent that ended before that line sends no signal: on a loaded machine an HTTP stage
        // finished before its TLS peer ran at all, and the peer waited in accept for good.
        if (linuxSyscall0(110) != parent) linuxSyscall1(231, 0)
    }
    child == 0
}
