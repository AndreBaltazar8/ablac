// A client's whole-exchange deadline against a peer that sends a byte just
// inside each read's timeout, which per-read timeouts alone would never end.
// Usage: deadlines <certificate> <key>
import "peer.ab"
import "abla/http"
import "abla/http/tls"
import "abla/io"
import "abla/net"
import "abla/process"
import "abla/process/time"
import "abla/tls/hosted"

fun bounded(stage: string, client: HttpClient): int {
    val started = monotonicMilliseconds()
    val result = client.send(httpGet("/drip"))
    val elapsed = monotonicMilliseconds() - started
    println("$stage: ok=${result.succeeded} complete=${result.complete} ${elapsed}ms")
    if ((result.succeeded && result.complete) || elapsed < 600 || elapsed > 120000) 1 else 0
}

fun main: int {
    var tlsListener = tlsListen(processArgument(0), processArgument(1), "::", 0)
    var tcpListener = tcpListenAddress(ipv4Loopback(0))
    val tlsPort = tlsListener.localPort()
    val tcpPort = tcpListener.localPort()
    if (tlsPort <= 0 || tcpPort <= 0) return 2
    if (peerForked()) { peerServeTls(tlsListener); return 0 }
    if (peerForked()) { peerServeTcp(tcpListener); return 0 }
    if (bounded("https", httpsClient("localhost", tlsPort, 1048576, 300, 700)) != 0) return 1
    bounded("http", httpIpv4Client("127.0.0.1:$tcpPort", "127.0.0.1", tcpPort, 1048576, 300, 700))
}
