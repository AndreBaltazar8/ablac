class Meters(val value: int) {
    fun scaled(by: int = 2, plus: int = 0): int = value * by + plus
}

class Seconds(val value: int) {
    fun scaled(plus: int = 0, by: int = 2): int = value * by + plus
}

class Grams(val value: int) {
    fun weighed(by: int = 2): int = value * by
}

class Ounces(val value: int) {
    fun weighed(by: int = 3): int = value * by
}

class Left(val value: int) {
    fun mixed(a: int = 1, b: int = 2): int = value + a + b
}

class Right(val value: int) {
    fun mixed(a: int = 1, b: int = 3): int = value + a + b
}

// These exact concrete forms were previously rejected as ambiguous.
fun main: int = if (
    Meters(1).scaled(plus = 1) == 3 &&
    Meters(3).scaled(plus = 1) == 7 && Seconds(3).scaled(plus = 1) == 7 &&
    Grams(1).weighed() == 2 && Ounces(1).weighed(by = 1) == 1 &&
    Left(1).mixed(a = 5) == 8 && Right(1).mixed(a = 5) == 9
) 42 else 1
