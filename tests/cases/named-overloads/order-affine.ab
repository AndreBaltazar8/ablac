var trace = 0
var drops = 0
fun mark(n: int): int { trace = trace * 10 + n; n }
class A {}
class B {}
fun a(): A { mark(1); A() }
fun ordered(value: A, x: int = mark(4), y: int = mark(5)): int = x + y
fun ordered(value: B, y: int = mark(6), x: int = mark(7)): int = x + y
resource class Ticket(val n: int) { fun drop(): void { drops = drops + 1 } }
resource class Other(val n: int) { fun drop(): void { drops = drops + 10 } }
fun consume(own ticket: Ticket, extra: int = 0): int = ticket.n + extra
fun consume(own other: Other, extra: int = 0): int = other.n + extra
fun view(owner: Shared<Ticket>, extra: int = 0): borrow(owner) Ticket = owner.get()
fun view(owner: Shared<Other>, extra: int = 0): borrow(owner) Other = owner.get()
fun main: int {
    if (ordered(a(), y = mark(2), x = mark(3)) != 5 || trace != 123) return 1
    trace = 0
    if (ordered(a(), y = mark(2)) != 6 || trace != 124) return 2
    if (consume(Ticket(5), extra = 2) != 7 || drops != 1) return 3
    if (consume(Other(7), extra = 2) != 9 || drops != 11) return 4
    val owner = Shared(Ticket(9))
    val saved = view(owner, extra = 3)
    if (saved.n != 9 || view(owner = owner, extra = 2).n != 9 || drops != 11) return 5
    42
}
