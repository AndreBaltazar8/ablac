class A {}
class B {}
fun choose(value: A, n: int = 1): int = 10 + n
fun choose(value: B, n: int = 2): int = 20 + n
fun inferred(value: bool): A = A()
fun <T> identity(value: T): T = value
fun withParameter(a: A, b: B): bool = choose(a, n = 3) == 13 && choose(b, n = 4) == 24
fun main: int {
    val a = A()
    val b = inferred(true)
    val generic = identity(B())
    val checked = choose(a, n = 4) == 14 && choose(b, n = 5) == 15 &&
        choose(generic, n = 6) == 26 && withParameter(a, generic) &&
        choose(B(), n = 7) == 27 && choose(n = 8, value = A()) == 18
    if (checked && extra()) 42 else 1
}

fun ordered(a: A, n: int = 1, text: string = "a"): int = 100 + n
fun ordered(b: B, text: string = "b", n: int = 2): int = 200 + n
fun supplied(a: A, n: int): int = n + 1
fun supplied(a: A, n: string): int = n.size + 10
fun pinned(a: A, n: int, flag: any = false): int = 1
fun pinned(a: A, n: any, flag: bool = true): int = 2
fun <T> picked(a: T, n: int = 0): T = a
class Left {
    fun calculate(n: int = 1): int = 100 + n
    fun mixed(a: int = 1, b: int = 2): int = a + b
}
class Right {
    fun calculate(text: string = "right", n: int = 2): int = 200 + n
    fun mixed(a: int = 1, b: int = 3): int = a + b
}
fun Left.adjust(n: int = 1): int = 300 + n
fun Right.adjust(text: string = "right", n: int = 2): int = 400 + n
fun extra(): bool {
    val a = A()
    var inner = false
    if (true) { val a = B(); inner = choose(a, n = 9) == 29 }
    inner && choose(a, n = 9) == 19 &&
        ordered(A(), text = "x", n = 4) == 104 && ordered(B(), n = 5) == 205 &&
        supplied(A(), n = 3) == 4 && supplied(A(), n = "abcd") == 14 &&
        pinned(A(), n = 3) == 1 && picked(a = "yes") == "yes" &&
        picked(a = 9, n = 3) == 9 &&
        Left().calculate(n = 3) == 103 && Right().calculate(n = 4) == 204 &&
        Left().adjust(n = 3) == 303 && Right().adjust(n = 4) == 404 &&
        Left().mixed(a = 5) == 7 && Right().mixed(a = 5) == 8
}
