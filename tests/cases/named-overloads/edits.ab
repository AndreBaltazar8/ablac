import "abla/compiler"
import "abla/text"
class A {}
class B {}
@rewrite
fun answer(a: A, n: int = 0): int = 1
@rewrite
fun answer(b: B, n: int = 0): int = 2
compile fun edit(): int {
    for (function in compiler.functionsAnnotated("rewrite")) {
        if (compiler.functionName(function).startsWith("answer")) {
            compiler.replaceFunctionBody(function, "42")
        }
    }
    0
}
val marker = #edit()
fun main: int = if (answer(A(), n = 1) == 42 && answer(B(), n = 2) == 42 && marker == 0) 42 else 1
