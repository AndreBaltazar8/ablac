import "abla/io"
var log: string = ""
resource class Item(val id: int) { fun drop(): void { log = log + "I$id" } }
val Item.extra: int = this.id
operator fun Item.plus(other: Item): int { log = log + "P"; this.id + other.id }
fun Item.consume(own other: Item): int { log = log + "X"; this.id + other.id }
fun make(id: int): Item = Item(id)
fun exercise(): string {
    log = ""
    val x = Item(1).extra; log = log + "V$x|"
    val y = Item(2) + Item(3); log = log + "V$y|"
    val z = make(4) + make(5); log = log + "V$z|"
    val existing = Item(6)
    val a = existing + Item(7); log = log + "V$a|"
    val b = Item(8) + existing; log = log + "V$b|"
    val c = Item(10).consume(Item(11)); log = log + "V$c|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
