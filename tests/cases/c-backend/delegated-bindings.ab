class IntDelegate(var value: int, var gets: int, var sets: int) {
    fun getValue(): int {
        gets = gets + 1
        value
    }

    fun setValue(next: int): void {
        sets = sets + 1
        value = next
        return
    }
}

fun inspect(delegate: IntDelegate): int =
    delegate.value + delegate.gets * 10 + delegate.sets * 100

fun main: int {
    var value: int by IntDelegate(1, 0, 0)
    val attempted = (value = 7)
    val observed = value
    ^value = IntDelegate(12, 0, 0)
    val replaced = value
    if (attempted == 7 && observed == 7 && replaced == 12 &&
        inspect(^value) == 22) 42 else 0
}
