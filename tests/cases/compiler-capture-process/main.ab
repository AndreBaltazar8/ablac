import "abla/compiler"
import "abla/io"

#compilerGrant("process.io")

// A failed check says which one, and what the capture reported, so a miss on a slow runner explains itself.
compile fun explain(check: int, result: CompilerProcessResult): string =
    "check $check: failure='${result.failure}' exit=${result.exitCode} stdout=${result.stdout.size} bytes, bytesRead=${result.bytesRead}"

// "" when every check passed, else the first failing one. The deadlines of the byte-limit cases are the longest a capture
// may have (ten seconds): those checks are about the limit, not the clock.
compile fun checkCapture(): string {
    val child = "tests/cases/compiler-capture-process/child.sh"
    val exact = compilerCaptureProcess(["sh", child, "bytes", "3"], 3, 10000)
    if (exact.failure != "" || exact.exitCode != 0 || exact.bytesRead != 3 ||
        exact.stdout.size != 3 || exact.stdout[0] != 0 || exact.stdout[1] != 255 ||
        exact.stdout[2] != 65) return explain(1, exact)
    val over = compilerCaptureProcess(["sh", child, "bytes", "4"], 3, 10000)
    if (over.failure != "output-limit" || over.stdout != "" || over.bytesRead != 4) return explain(2, over)
    val maximum = compilerCaptureProcess(["sh", child, "bytes", "1048576"], 1048576, 10000)
    if (maximum.failure != "" || maximum.stdout.size != 1048576 ||
        maximum.bytesRead != 1048576) return explain(3, maximum)
    val excess = compilerCaptureProcess(["sh", child, "bytes", "1048577"], 1048576, 10000)
    if (excess.failure != "output-limit" || excess.stdout != "" || excess.bytesRead != 1048577)
        return explain(4, excess)
    val status = compilerCaptureProcess(["sh", child, "exit", "17"])
    if (status.failure != "" || status.exitCode != 17 || status.stdout != "") return explain(5, status)
    val status127 = compilerCaptureProcess(["sh", child, "exit", "127"])
    if (status127.failure != "" || status127.exitCode != 127) return explain(6, status127)
    val missing = compilerCaptureProcess(["/abla-capture-nonexistent-executable"])
    if (missing.failure != "launch" || missing.stdout != "") return explain(7, missing)
    val stopped = compilerCaptureProcess(["sh", child, "signal"])
    if (stopped.failure != "signal" || stopped.exitCode != 143) return explain(8, stopped)
    val input = compilerCaptureProcess(["sh", child, "stdin"])
    if (input.failure != "" || input.stdout != "closed") return explain(9, input)
    val timed = compilerCaptureProcess(["sh", child, "descendant",
        "build/compiler-capture-process/timeout-child.pid"], 1024, 500)
    if (timed.failure != "timeout" || timed.stdout != "") return explain(10, timed)
    val overflowTree = compilerCaptureProcess(["sh", child, "overflow-descendant",
        "build/compiler-capture-process/overflow-child.pid"], 1024, 10000)
    if (overflowTree.failure != "output-limit" || overflowTree.stdout != "" ||
        overflowTree.bytesRead != 1025) return explain(11, overflowTree)
    ""
}

val RESULT = #checkCapture()
fun main: int {
    if (RESULT == "") return 42
    println(RESULT)
    1
}
