import "abla/compiler"

#compilerGrant("process.io")

compile fun checkCapture(): int {
    val child = "tests/cases/compiler-capture-process/child.py"
    val exact = compilerCaptureProcess(["python3", child, "bytes", "3"], 3, 2000)
    if (exact.failure != "" || exact.exitCode != 0 || exact.bytesRead != 3 ||
        exact.stdout.size != 3 || exact.stdout[0] != 0 || exact.stdout[1] != 255 ||
        exact.stdout[2] != 65) return 1
    val over = compilerCaptureProcess(["python3", child, "bytes", "4"], 3, 2000)
    if (over.failure != "output-limit" || over.stdout != "" || over.bytesRead != 4) return 2
    val maximum = compilerCaptureProcess(["python3", child, "bytes", "1048576"], 1048576, 2000)
    if (maximum.failure != "" || maximum.stdout.size != 1048576 ||
        maximum.bytesRead != 1048576) return 3
    val excess = compilerCaptureProcess(["python3", child, "bytes", "1048577"], 1048576, 2000)
    if (excess.failure != "output-limit" || excess.stdout != "" || excess.bytesRead != 1048577)
        return 4
    val status = compilerCaptureProcess(["python3", child, "exit", "17"])
    if (status.failure != "" || status.exitCode != 17 || status.stdout != "") return 5
    val status127 = compilerCaptureProcess(["python3", child, "exit", "127"])
    if (status127.failure != "" || status127.exitCode != 127) return 6
    val missing = compilerCaptureProcess(["/abla-capture-nonexistent-executable"])
    if (missing.failure != "launch" || missing.stdout != "") return 7
    val stopped = compilerCaptureProcess(["python3", child, "signal"])
    if (stopped.failure != "signal" || stopped.exitCode != 143) return 8
    val input = compilerCaptureProcess(["python3", child, "stdin"])
    if (input.failure != "" || input.stdout != "closed") return 9
    val timed = compilerCaptureProcess(["python3", child, "descendant",
        "build/compiler-capture-process/timeout-child.pid"], 1024, 500)
    if (timed.failure != "timeout" || timed.stdout != "") return 10
    val overflowTree = compilerCaptureProcess(["python3", child, "overflow-descendant",
        "build/compiler-capture-process/overflow-child.pid"], 1024, 2000)
    if (overflowTree.failure != "output-limit" || overflowTree.stdout != "" ||
        overflowTree.bytesRead != 1025) return 11
    42
}

val RESULT = #checkCapture()
fun main: int = RESULT
