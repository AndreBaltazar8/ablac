import "abla/compiler"
import "abla/io"

#compilerGrant("process.io")

val CAPTURE = #compilerCaptureProcess(["python3", "tests/cases/compiler-capture-process/child.py",
    "environment"])
fun main: int {
    if (CAPTURE.failure != "" || CAPTURE.exitCode != 0) return 1
    print(CAPTURE.stdout)
    0
}
