import "../../../src/ct_process.ab"

fun main: int {
    val result = bootstrapProcessCapture(["sh",
        "tests/cases/compiler-capture-process/child.sh", "bytes", "3"], 3, 2000)
    if (result.failure != "" || result.exitCode != 0 || result.stdout.size != 3 ||
        result.stdout[0] != 0 || result.stdout[1] != 255 || result.stdout[2] != 65) return 1
    0
}
