// qsort of the statically linked compiler's C library (src/static_libc/string.ab, #1139 area 14) with comparators that are not consistent: one that
// always answers "less" and one that always answers "more" (each reads both elements, as a real one does). The partition scans used to rely on the
// pivot's neighbours to stop them and walked past the array, reading and swapping outside it; now the array is permuted and the 8 sentinel elements
// on each side are untouched. A consistent comparator still sorts. Exits 42 (tools/test-libc-functions.sh).
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native"
import "../../../src/static_libc/string.ab"

val COUNT = 200
val GUARD = 8
val SENTINEL = 6510615555426900570

trusted fun load(address: int): int = ablaUnsafeLoadI64(nativePointerFromAddress(address))

trusted fun ascending(a: int, b: int): int {
    val x = load(a)
    val y = load(b)
    if (x < y) -1 else if (x > y) 1 else 0
}

trusted fun alwaysLess(a: int, b: int): int = if (load(a) == load(b) - 1) -1 else -1

trusted fun alwaysMore(a: int, b: int): int = if (load(a) == load(b) - 1) 1 else 1

// A buffer of COUNT values between GUARD sentinels on each side; the address of the first value.
trusted fun filled(): int {
    // Raw memory, never freed: a NativeByteBuffer would be freed when this function returns.
    val base = ablaUnsafePointerAddress(ablaUnsafeAllocate((COUNT + 2 * GUARD) * 8))
    for (i in 0 until COUNT + 2 * GUARD) {
        val value = if (i < GUARD || i >= COUNT + GUARD) SENTINEL else (i * 7919) % 1000
        ablaUnsafeStoreI64(nativePointerFromAddress(base + i * 8), value)
    }
    base + GUARD * 8
}

trusted fun guardsIntact(values: int): bool {
    for (i in 0 until GUARD) {
        if (load(values - (i + 1) * 8) != SENTINEL || load(values + (COUNT + i) * 8) != SENTINEL) return false
    }
    true
}

trusted fun main: int {
    val sorted = filled()
    libcQsort(sorted, COUNT, 8, nativeFunctionAddress(ascending))
    for (i in 1 until COUNT) {
        if (load(sorted + (i - 1) * 8) > load(sorted + i * 8)) return 1
    }
    if (!guardsIntact(sorted)) return 2
    val less = filled()
    libcQsort(less, COUNT, 8, nativeFunctionAddress(alwaysLess))
    if (!guardsIntact(less)) return 3
    val more = filled()
    libcQsort(more, COUNT, 8, nativeFunctionAddress(alwaysMore))
    if (!guardsIntact(more)) return 4
    42
}
