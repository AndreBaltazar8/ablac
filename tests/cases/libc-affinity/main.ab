// sched_getaffinity of the statically linked compiler's C library (src/static_libc/lld.ab, #1139 area 14) clears the part of the caller's
// mask the kernel does not write, as glibc's does: a 128-byte cpu_set_t full of ones comes back with CPU_COUNT equal to get_nprocs (the
// processors the process may run on), not counting the bytes past the kernel's. Built by tools/test-libc-functions.sh against a copy of the
// library without its @export lines. Exits 42.
import "abla/io"
import "abla/runtime/scalar"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../../../src/static_libc/lld.ab"

trusted fun main: int {
    val mask = ablaUnsafePointerAddress(ablaUnsafeAllocate(128))
    for (i in 0 until 128) ablaRuntimeStoreU8(mask + i, 255)
    if (libcSchedGetaffinity(0, 128, mask) != 0) {
        println("libc-affinity: sched_getaffinity failed")
        return 1
    }
    val counted = libcSchedCpucount(128, mask)
    val processors = libcGetNprocs()
    if (counted != processors) {
        println("libc-affinity: CPU_COUNT of the mask is $counted, get_nprocs $processors")
        return 1
    }
    42
}
