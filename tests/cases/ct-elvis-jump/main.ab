// A jump on the right of `??` (continue, break, labeled) leaves its loop in the compile-time
// evaluator as in native code: nothing is assigned from it, whether the target is a local
// (`total += x ?? continue`, `y = x ?? break`), a field or an element, under `-` and `!`, and as a range end, a template part, an array element, as an `if`, `while` or `do ... while` condition (`?? return`: `break` and `continue` are outside the loop there) or `when` operand.
import "abla/io"

class Box(var value: int)

fun pick(i: int): int? = if (i % 2 == 0) i else null

fun notOdd(i: int): bool? = if (i % 2 == 0) false else null

fun flag(i: int): bool? = if (i % 2 == 0) true else null

fun below(n: int): bool? = if (n < 3) true else null

fun leaveFromWhile(): int {
    var n = 0
    while (below(n) ?? return 100 + n) {
        n += 1
    }
    0
}

fun leaveFromCondition(): int {
    var n = 0
    do {
        n += 1
    } while (below(n + 10) ?? return -n)
    0
}

fun run(): string {
    var total = 0
    for (i in 0 until 6) {
        total += pick(i) ?? continue
        total += 100
    }
    var last = -1
    for (i in 0 until 6) {
        last = pick(i + 1) ?? break
    }
    var named = 0
    outer@for (i in 0 until 4) {
        for (j in 0 until 4) {
            named = named + (pick(j) ?? continue@outer)
            named = named + 1000
        }
    }
    val box = Box(7)
    for (i in 0 until 3) {
        box.value = pick(i + 1) ?? continue
    }
    val elements = [1, 2, 3]
    for (i in 0 until 3) {
        elements[i] = pick(i + 1) ?? continue
    }
    var negated = 0
    for (i in 0 until 4) {
        negated += -(pick(i + 1) ?? continue)
    }
    var tested = 0
    for (i in 0 until 4) {
        if (!(notOdd(i) ?? continue)) tested += 10
        tested += 1
    }
    var gated = 0
    for (i in 0 until 4) {
        if (flag(i) ?? continue) gated += 10
        gated += 1
    }
    var either = 0
    for (i in 0 until 4) {
        if (i == 1 || (flag(i) ?? continue)) either += 1
    }
    var chosen = 0
    for (i in 0 until 4) {
        chosen += when (pick(i) ?? continue) {
            0 -> 5
            2 -> 7
            else -> 1
        }
    }
    var spans = 0
    for (i in 0 until 4) {
        for (k in 0 .. (pick(i) ?? continue)) spans += 1
    }
    var texts = ""
    for (i in 0 until 4) {
        texts = texts + "${pick(i) ?? continue}" + ","
    }
    var literal = 0
    for (i in 0 until 4) {
        val one = [pick(i) ?? continue, 9]
        literal += one.size + one[0]
    }
    var slices = ""
    val values = [1, 2, 3, 4]
    for (i in 0 until 4) {
        values.truncate(pick(i) ?? continue)
        slices = slices + "abcd".slice(pick(i) ?? continue, 4)
        slices = slices + "abcd".slice(0, pick(i) ?? continue)
    }
    var out =
        "${total} ${last} ${named} ${box.value} ${elements[0]}${elements[1]}${elements[2]} ${negated} ${tested} ${gated} ${leaveFromWhile()} ${either} ${chosen} ${leaveFromCondition()} ${spans} ${texts} ${literal} ${values.size} ${slices}"
    var again = 0
    for (i in 0 until 3) {
        val got = pick(i + 1) ?? continue
        again += got
    }
    "$out ${again}"
}

compile fun runAtCompileTime(): string = run()

val atCompileTime = #runAtCompileTime()

fun main: int {
    val native = run()
    println("$native | $atCompileTime")
    if (native == atCompileTime) 42 else 1
}
