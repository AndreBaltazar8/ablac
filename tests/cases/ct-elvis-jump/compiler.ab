import "abla/compiler"

#compilerGrant("random")

fun subject(value: int): int = value
compile fun absent(): int? = null
compile fun first(): int {
    compilerFunctionName(absent() ?? return 11)
    0
}
compile fun second(): int {
    compilerFunctionParameterTypeHandle(compilerFindFunction("subject"), absent() ?? return 22)
    0
}
compile fun third(): int {
    compilerIsPrivate(absent() ?? return 33)
    0
}
compile fun loop(): int {
    var count = 0
    for (i in 0 until 3) {
        val value: int? = if (i == 1) null else compilerFindFunction("subject")
        compilerIsPrivate(value ?? continue)
        count += 1
    }
    count
}
compile fun hostArgument(): int {
    compilerRandomInteger(absent() ?? return 44)
    0
}
val e = #hostArgument()
val c = #third()
val d = #loop()
val a = #first()
val b = #second()
fun main(): int = if (a == 11 && b == 22 && c == 33 && d == 2 && e == 44) 42 else 1
