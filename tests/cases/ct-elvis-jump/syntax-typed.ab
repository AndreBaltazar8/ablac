import "abla/compiler/parser"

compile fun absentInt(): int? = null
compile fun absentText(): string? = null
compile fun absentSyntax(): SyntaxExpression? = null

compile fun syntaxFirst(): int {
    syntaxInteger(absentInt() ?? return 11)
    0
}
compile fun mustNotRun(): SyntaxExpression {
    compilerFunctionName(-1)
    syntaxInteger(1)
}
compile fun syntaxSecond(): int {
    syntaxBinary("+", absentSyntax() ?? return 22, mustNotRun())
    0
}
compile fun syntaxThird(): int {
    syntaxBinary(absentText() ?? return 33, syntaxInteger(1), syntaxInteger(2))
    0
}
compile fun typedFirst(): int {
    typedCallArgumentCount(absentSyntax() ?? return 44)
    0
}
compile fun typedSecond(): int {
    typedCallArgumentType(syntaxCall("subject", [syntaxInteger(1)]), absentInt() ?? return 55)
    0
}
// Argument evaluation precedes intrinsic validation, even for an invalid handle.
compile fun typedInvalidFunction(): int {
    typedFunctionRead(-1, absentInt() ?? return 66)
    0
}
compile fun typedInvalidExpression(): int {
    typedExpressionRead(syntaxInteger(1), absentInt() ?? return 77)
    0
}
compile fun typedInvalidCall(): int {
    typedCallParameterTypeHandle(syntaxInteger(1), absentInt() ?? return 88)
    0
}
fun subject(value: int): int = value
compile fun typedJournal(): int {
    typedFunctionRead(compilerFindFunction("subject"), absentInt() ?? return 99)
    0
}
compile fun loop(): int {
    var count = 0
    for (i in 0 until 4) {
        val next: int? = if (i == 1) null else i
        syntaxInteger(next ?? continue)
        count += 1
    }
    count
}
val k = #typedJournal()
val g = #typedInvalidFunction()
val h = #typedInvalidExpression()
val j = #typedInvalidCall()
val f = #loop()
val a = #syntaxFirst()
val b = #syntaxSecond()
val c = #syntaxThird()
val d = #typedFirst()
val e = #typedSecond()
fun main(): int = if (a == 11 && b == 22 && c == 33 && d == 44 && e == 55 && f == 3 && g == 66 &&
    h == 77 && j == 88 && k == 99) 42 else 1
