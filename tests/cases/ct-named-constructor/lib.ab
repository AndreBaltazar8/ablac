import "leaf.ab"
import "abla/compiler/parser"
compile fun neverCalled(): int = 1 / (hiddenLeafAnswer() - 42)
compile fun leaveArgument(): int {
    val absent: int? = null
    val unused = OrderedValue(first = absent ?? return 42, second = neverCalled())
    1
}
compile fun readNamedValue(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    val data = HiddenLeafValue(value = 40)
    val reordered = HiddenLeafValue(extra = 2, value = 40)
    val mixed = HiddenLeafValue(40, extra = 2)
    val positional = HiddenLeafValue(40, 2)
    val defaulted = HiddenLeafValue(extra = 2)
    val prior = PriorDefault(value = 40)
    val allDefaults = HiddenLeafValue()
    val lazyDefault = LazyDefault(extra = 2, value = 40)
    val priorPositional = PriorDefault(40)
    val constructorDefault = 999
    val shadowed = HiddenLeafValue(value = 40)
    var order = 0
    val mark = { n: int -> order = order * 10 + n; n }
    val ordered = OrderedValue(second = mark(2), first = mark(1))
    if (data.value != 40 || data.extra != 2 || reordered.value != 40 ||
        reordered.extra != 2 || positional.value != 40 || positional.extra != 2 || mixed.value != 40 || mixed.extra != 2 ||
        defaulted.value != 40 || defaulted.extra != 2 || prior.extra != 42 || allDefaults.value != 40 || allDefaults.extra != 2 ||
        lazyDefault.value != 40 || lazyDefault.extra != 2 || priorPositional.extra != 42 ||
        shadowed.extra != 2 || constructorDefault != 999 || order != 21 ||
        ordered.first != 1 || ordered.second != 2 || leaveArgument() != 42) return syntaxInteger(1)
    syntaxInteger(data.value + hiddenLeafAnswer() - 40)
}
#compilerRegisterSubparser("namedValue", readNamedValue)
