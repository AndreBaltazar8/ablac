import "leaf.ab" as leaf
fun check(): bool {
    val a = leaf.HiddenLeafValue(value = 40)
    val b = leaf.HiddenLeafValue(40, 2)
    val c = leaf.HiddenLeafValue(extra = 2)
    val d = leaf.PriorDefault(value = 40)
    val e = leaf.PriorDefault(40)
    val f = leaf.HiddenLeafValue()
    val g = leaf.LazyDefault(value = 40, extra = 2)
    a.value == 40 && a.extra == 2 && b.value == 40 && b.extra == 2 &&
        c.value == 40 && c.extra == 2 && d.extra == 42 && e.extra == 42 && f.value == 40 && f.extra == 2 && g.extra == 2
}
fun main: int = if (#check()) 42 else 1
