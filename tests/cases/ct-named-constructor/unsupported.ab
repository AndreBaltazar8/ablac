import "abla/compiler/parser"
compile fun readInner(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    syntaxInteger(7)
}
#compilerRegisterSubparser("innerValue", readInner)
compile fun readUnsupported(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    // At the early invocation below this is still a discovery placeholder.
    // The evaluator must reject it even when the result is discarded.
    val ignored = $innerValue()
    syntaxInteger(42)
}
#compilerRegisterSubparser("unsupportedValue", readUnsupported)
fun main: int = $unsupportedValue()
