import "abla/io"
import "abla/crypto/bignum"

// A program that reaches the crypto allocation entry, a function carrying `@section(".text.abla_ct_allocate")`:
// on Mach-O the compiler must name that section "__TEXT,__abla_ct_alloc" (a segment and a section), not hand
// LLVM the ELF spelling.
fun main: int {
    val words = bnAllocate(4)
    println(if (words != 0) "macho section: ok" else "macho section: no memory")
    0
}
