import "abla/tls/hosted"

// An empty write never dereferences the control pointer or calls OpenSSL. A
// negative pointer is an open handle; only -1 is the failed/closed sentinel.
// Restore -1 before the resource drops: this is deliberately not real memory.
fun main: int {
    val tagged = (0xb4 << 56) | 4096
    if (tagged >= 0) return 10
    val connection = TlsConnection(tagged)
    val written = connection.write("")
    connection.handle = -1
    if (written != 0) return 11
    if (!connection.close()) return 12
    0
}
