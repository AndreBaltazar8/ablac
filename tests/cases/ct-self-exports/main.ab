// A program that calls an extern:"c" function it defines itself under @export, as abla-forge's app.ab calls
// `host_option`, which native/linux/host.ab exports (#1022). The linker resolves one to the other; the native slice
// kept the extern but not its definition, so the generation's link failed on the missing symbol and the site ran in
// the interpreter, which can't call it.
import "abla/compiler"
#compilerGrant("trusted.native")
import "abla/io"

trusted noescape extern:"c" fun ct_self_scale(value: i32, factor: i32): i32

@export("ct_self_scale")
fun ctSelfScale(value: i32, factor: i32): i32 = value * factor + i32(1)

trusted fun scaled(): int {
    var total = 0
    for (step in 1..3) total = total + int(ct_self_scale(i32(step), i32(5)))
    total
}

val staged = #scaled()

fun main {
    println("${scaled()} $staged")
}
