// Two unrelated classes have a method `dispatch`; only Keeper's stores what it is given in a module value. A region
// may call Counter.dispatch directly, through `this`, through a field, and through an element of an array field
// and through scoped parameters, locals and statically typed calls (#827, #1193, #1196, #1210).
var kept: array<string> = []

class Keeper(val tag: string) {
    fun dispatch(name: string): int {
        kept.append(this.tag + name)
        kept.size
    }
}

class Counter(var total: int) {
    fun dispatch(name: string): int {
        this.total = this.total + name.size
        this.total
    }
    fun twice(name: string): int = this.dispatch(name) + this.dispatch(name)
}

class Server(val router: Counter) {
    fun handle(name: string): int = this.router.dispatch(name)
}

class RouterPool(val routers: array<Counter>) {
    fun handle(slot: int, name: string): int = this.routers[slot].dispatch(name)
}

class Gateway(val pool: RouterPool) {
    fun handle(name: string): int = this.pool.routers[0].dispatch(name)
}

class ReadOnlyCounter {
    fun dispatch(name: string): int = name.size
}

class ReadOnlyPool(val routers: array<ReadOnlyCounter>)

fun dispatchParameter(router: ReadOnlyCounter, name: string): int = router.dispatch(name)

fun dispatchLocal(name: string): int {
    val router: Counter = Counter(0)
    router.dispatch(name)
}

fun dispatchParameterField(pool: ReadOnlyPool, name: string): int = pool.routers[0].dispatch(name)

fun makeCounter(): ReadOnlyCounter = ReadOnlyCounter()

fun dispatchConstructor(name: string): int = ReadOnlyCounter().dispatch(name)

fun dispatchCallResult(name: string): int = makeCounter().dispatch(name)

fun dispatchInferredLocal(name: string): int {
    val router = makeCounter()
    router.dispatch(name)
}

fun main(): int {
    val keeper = Keeper("k")
    val outside = keeper.dispatch("x")
    val counted = region {
        val counter = Counter(0)
        val server = Server(Counter(1))
        val pool = RouterPool([Counter(0)])
        val gateway = Gateway(pool)
        counter.dispatch("abc") + counter.twice("de") + server.handle("fgh") + server.router.dispatch("i") +
            pool.handle(0, "j") + gateway.handle("k") +
            dispatchParameter(ReadOnlyCounter(), "uv") + dispatchLocal("wxy") +
            dispatchParameterField(ReadOnlyPool([ReadOnlyCounter()]), "z") +
            dispatchConstructor("a") + dispatchCallResult("bc") + dispatchInferredLocal("def") +
            dispatchGlobal("g") + dispatchGlobalElement("hi") +
            ImplicitCounter(ReadOnlyCounter()).handle("jkl")
    }
    counted + outside
}

val globalCounter: ReadOnlyCounter = ReadOnlyCounter()
val globalPool: array<ReadOnlyCounter> = [globalCounter]

fun dispatchGlobal(name: string): int = globalCounter.dispatch(name)

fun dispatchGlobalElement(name: string): int = globalPool[0].dispatch(name)

class ImplicitCounter(val router: ReadOnlyCounter) {
    fun handle(name: string): int = router.dispatch(name)
}
