// Keeper.dispatch stores its argument in a module value, so calling it in a region is still refused, beside a
// Counter.dispatch that is allowed.
var kept: array<string> = []

interface Route {
    fun dispatch(name: string): int
}

class Keeper(val tag: string) : Route {
    fun dispatch(name: string): int {
        kept.append(this.tag + name)
        kept.size
    }
}

class Counter(var total: int) {
    fun dispatch(name: string): int = this.total + name.size
}

class KeeperPool(val keepers: array<Keeper>) {
    fun store(name: string): int = this.keepers[0].dispatch(name)
}

fun storeParameter(keeper: Keeper, name: string): int = keeper.dispatch(name)

fun storeDynamic(route: Route, name: string): int = route.dispatch(name)

fun makeCounter(): Counter = Counter(0)

fun fromKeeper(): Keeper = Keeper("factory")

fun storeFromFactory(name: string): int = fromKeeper().dispatch(name)

fun shadowedFactory(name: string): int {
    val makeCounter = { -> Keeper("local") }
    makeCounter().dispatch(name)
}

fun shadowed(keeper: Keeper, name: string): int {
    val router: Counter = Counter(0)
    if (name.size > 0) {
        val router = keeper
        return router.dispatch(name)
    }
    router.dispatch(name)
}

fun main(): int = region {
    val counter = Counter(0)
    val keeper = Keeper("k")
    val pool = KeeperPool([keeper])
    counter.dispatch("a") + keeper.dispatch("b") + pool.store("c") +
        storeParameter(keeper, "d") + shadowed(keeper, "e") + storeDynamic(keeper, "f") +
        storeFromFactory("g") + shadowedFactory("h")
}
