// memoryPromoteString out of a region: the same bytes whatever the string is made of (empty, one byte,
// a long run, embedded NULs and non-ASCII bytes, a rope built by concatenation) and after the region
// has ended and its memory has been reused.
import "abla/memory"
import "abla/bytes"

private fun pattern(length: int, seed: int): string {
    val out = byteBuffer()
    var state = seed
    for (index in 0 until length) {
        state = (state * 1103515245 + 12345) & 2147483647
        out.appendByteValue((state >> 8) & 255)
    }
    out.toText()
}

fun main: int {
    var bad = 0
    val lengths = [0, 1, 2, 7, 8, 9, 15, 16, 17, 63, 64, 65, 150, 1023, 1024, 4096, 70000]
    val kept: array<string> = []
    val expected: array<string> = []
    for (length in lengths) {
        val original = pattern(length, length + 11)
        val promoted = region {
            val built = pattern(length, length + 11)
            memoryPromoteString(built)
        }
        kept.append(promoted)
        expected.append(original)
        if (promoted != original || promoted.size != length) bad = bad + 1
    }
    // A rope: the concatenation of pieces made inside the region.
    val rope = region {
        var text = ""
        for (piece in 0 until 40) text = text + pattern(13, piece) + "|"
        memoryPromoteString(text)
    }
    var reference = ""
    for (piece in 0 until 40) reference = reference + pattern(13, piece) + "|"
    if (rope != reference) bad = bad + 1
    // Reuse the regions' memory, then compare what was kept.
    for (round in 0 until 50) {
        region {
            val scratch = pattern(2000, round)
            scratch.size
        }
    }
    for (index in 0 until kept.size) {
        if (kept[index] != expected[index]) bad = bad + 1
    }
    // Outside a region promotion is the identity.
    if (memoryPromoteString("outside") != "outside") bad = bad + 1
    if (bad == 0) 42 else 1
}
