// A `#` site whose code writes globals the interpreter's journal never keeps, each of the native generation's alone
// for the pass (ct_jit.ab, bootstrapCtGenerationOnly): one whose class always holds a closure (the compiler's
// bootstrapStrictVisibilityTable has this shape), a raw pointer (bootstrapLlvmHeldContext), and one whose type
// comes from a plain function's declared result (`var counter = counterOf(0)`). Before, each kept the site in the
// interpreter (tools/test-ct-resource-globals.sh), where raw memory doesn't exist.
import "abla/compiler"
import "abla/io"
import "abla/unsafe/memory/raw"

#compilerGrant("trusted.native")

class Router(val names: array<string>, val route: (int) -> string)

fun emptyRouter(): Router = Router([], { at: int -> "" })

var router: Router = emptyRouter()

class Counter(val hits: int)

fun counterOf(hits: int): Counter = Counter(hits)

var counter = counterOf(0)

var held: i64* = nativeNullPointer()

trusted fun hold(): bool {
    held = nativeNullPointer()
    pointerIsNull(held)
}

trusted fun work(): string {
    var round = 0
    while (round < 3) {
        val offset = round * 10
        router = Router(["r$round"], { at: int -> "route-${at + offset}" })
        counter = counterOf(counter.hits + 1)
        round = round + 1
    }
    "${router.names[0]}:${router.route(2)}:${counter.hits}:${hold()}"
}

val COMPILED = #work()

fun main: int {
    println("${work()} $COMPILED")
    0
}
