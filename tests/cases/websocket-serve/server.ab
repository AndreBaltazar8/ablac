// The blocking WebSocket server (serveWebSocketsOnListenerWith) on an ephemeral loopback port with the deadlines given as arguments, for tools/test-websocket-serve.sh:
// prints the port, then serves until it is killed. /echo answers each message with itself; /push sends 8 MB frames until a write fails. Arguments, in milliseconds
// (0 turns a deadline off): firstByte head request response idle frame write.
import "abla/io"
import "abla/http"
import "abla/integer"
import "abla/net"
import "abla/process/arguments"
import "abla/text"
import "abla/websocket"

fun echo(request: HttpRequest, var socket: WebSocketConnection): void {
    var open = true
    while (open) {
        val message = socket.readMessage(1048576)
        if (message.available) socket.sendText(message.payload) else open = false
    }
    return
}

fun push(request: HttpRequest, var socket: WebSocketConnection): void {
    var sent = 0
    while (sent < 8 && socket.sendBinary("y".repeat(8000000))) sent = sent + 1
    return
}

fun number(index: int, fallback: int): int =
    if (index < processArgumentCount()) processArgument(index).parseInt() ?? fallback else fallback

fun main: int {
    val router = webSocketRouter()
    router.route("/echo", echo)
    router.route("/push", push)
    val http = HttpServeOptions(number(0, 10000), number(1, 30000), number(2, 120000), number(3, 30000), 65536, 1048576)
    val options = WebSocketServeOptions(http, number(4, 30000), number(5, 120000), number(6, 30000))
    val listener = tcpListenAddress(ipv4Loopback(0))
    println("${listener.localPort()}")
    serveWebSocketsOnListenerWith(router, listener, options)
}
