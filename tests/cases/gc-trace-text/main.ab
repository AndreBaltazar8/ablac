// Garbage enough for ABLA_GC_TRACE=1 to print every kind of collection line (live and parked bytes, the phases, and the
// adaptive sweep's choice, which takes over 32 MiB kept in 262,144 allocations: the held nodes): tools/test-gc-trace-text.sh
// checks that the trace is plain text, as a stated length that counted one byte past its message wrote the string's
// terminating NUL into it.
import "abla/io"

class Node(val value: int)

fun build(count: int, seed: int): array<Node> {
    val nodes: array<Node> = []
    var at = 0
    while (at < count) {
        nodes.append(Node(seed + at))
        at = at + 1
    }
    nodes
}

fun total(nodes: array<Node>): int {
    var sum = 0
    for (node in nodes) sum = sum + node.value
    sum
}

fun main: int {
    val held = build(800000, 0)
    var sum = 0
    var index = 0
    while (index < 30) {
        sum = sum + total(build(300000, index))
        index = index + 1
    }
    println("gc trace text ok: $sum ${total(held)}")
    0
}
