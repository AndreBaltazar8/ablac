// XmlElement.text() on a tree as deep as a reader with its maxDepth raised can give (abla-xml parses a million levels iteratively): the text of 300,000 nested elements is
// read with a stack of its own, in document order. It was a stack overflow from about 35,000 levels. Prints "xml text deep ok".
import "abla/io"
import "abla/xml"

fun element(name: string, children: array<XmlNode>): XmlElement = XmlElement(name, "", name, "", [], children, 0, 0, 0)

fun main: int {
    val depth = 300000
    // From the inside out: a text, then each level holds the level below and, after it, one more text, so the order of the text is "0 ... 1 2 ... depth".
    val leaf: array<XmlNode> = [XmlText("0")]
    var inner = element("e", leaf)
    for (level in 1 until depth) {
        val children: array<XmlNode> = [inner, XmlText("x")]
        inner = element("e", children)
    }
    val text = inner.text()
    if (text.size != 1 + (depth - 1)) {
        println("FAIL the text has ${text.size} bytes, expected ${1 + (depth - 1)}")
        return 1
    }
    if (text[0] != 48 || text[text.size - 1] != 120) {
        println("FAIL the text is in the wrong order")
        return 1
    }
    // The order of siblings and levels, small: "a" before the nested "b" before "c".
    val middle: array<XmlNode> = [XmlText("b")]
    val outer: array<XmlNode> = [XmlText("a"), element("m", middle), XmlText("c")]
    val small = element("r", outer)
    if (small.text() != "abc") {
        println("FAIL a small tree gave [${small.text()}]")
        return 1
    }
    println("xml text deep ok")
    0
}
