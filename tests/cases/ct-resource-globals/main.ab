// A `#` site whose code writes a global holding resources (abla/tls/pure's pureTlsHandleTable has this shape: a
// private array of a resource class with a function field, appended to and taken from by handle). The native tier owns such a global for
// the pass, and like a TVar never hands it back to the interpreter (ct_jit.ab, bootstrapCtUnexchanged): before, every
// site reaching it went to the interpreter (tools/test-ct-resource-globals.sh).
import "abla/io"

var dropped: int = 0

resource class Handle(var id: int, var label: string, val describe: () -> string) {
    fun drop(): void {
        dropped = dropped + 1
        return
    }
}

private var handleTable: array<Handle> = []

fun register(id: int, label: string): int {
    val handle = Handle(id, label, { -> "handle-$label" })
    handleTable.append(move(handle))
    handleTable.size
}

fun indexOf(id: int): int {
    var at = 0
    while (at < handleTable.size) {
        if (handleTable[at].id == id) return at
        at = at + 1
    }
    -1
}

fun release(id: int): bool {
    val at = indexOf(id)
    if (at < 0) return false
    val taken = handleTable.takeAt(at)
    true
}

fun work(): string {
    register(1, "one")
    register(2, "two")
    register(3, "three")
    val released = release(2)
    val missing = release(9)
    "${handleTable.size}:${handleTable[0].label},${handleTable[1].describe()}:$released,$missing:$dropped"
}

val COMPILED = #work()

fun main: int {
    println("${work()} $COMPILED")
    0
}
