// Threads read a rope while another flattens it. Flattening publishes the
// node's flat copy, then clears its children; a reader that found no copy yet
// and then loaded a cleared child read it as an empty piece (a short or
// garbled result, or a crash). Each round shares a fresh rope with two
// readers, which read through it (appending to it and comparing that) over
// and over, and a writer, which flattens it (comparing it) once both run.

resource class Text(val value: string)

// The readers check in before reading; the writer flattens once both have.
resource class Gate(var arrived: int)

fun arrive(var gate: Gate): int {
    gate.arrived = gate.arrived + 1
    gate.arrived
}

fun arrived(var gate: Gate): int = gate.arrived

fun piece(side: string, round: int): string =
    "$side-$round-0123456789abcdefghijklmnopqrstuvwxyz"

fun bang(text: string): string = text + "!"

fun flattens(rope: Shared<Text>, expected: Shared<Text>, gate: Mutex<Gate>): int {
    while (gate.with(arrived) < 2) {}
    if (rope.get().value == expected.get().value) 0 else 1
}

fun reads(rope: Shared<Text>, expected: Shared<Text>, gate: Mutex<Gate>): int {
    gate.with(arrive)
    var wrong = 0
    var pass = 0
    while (pass < 200) {
        if (bang(rope.get().value) != expected.get().value) wrong = wrong + 1
        pass = pass + 1
    }
    wrong
}

fun main: int {
    var wrong = 0
    var round = 0
    while (round < 8000) {
        val left = piece("left", round)
        val right = piece("right", round)
        val rope = Shared(Text(left + right))
        val flat = Shared(Text("$left$right"))
        val bangs = Shared(Text("$left$right!"))
        val gate = Mutex(Gate(0))
        val writerRope = rope.clone()
        val writerFlat = flat.clone()
        val writerGate = gate.clone()
        val firstRope = rope.clone()
        val firstBangs = bangs.clone()
        val firstGate = gate.clone()
        val secondRope = rope.clone()
        val secondBangs = bangs.clone()
        val secondGate = gate.clone()
        val first = thread { reads(firstRope, firstBangs, firstGate) }
        val second = thread { reads(secondRope, secondBangs, secondGate) }
        val writer = thread { flattens(writerRope, writerFlat, writerGate) }
        wrong = wrong + await writer + await first + await second
        round = round + 1
    }
    if (wrong == 0) 42 else 1
}
