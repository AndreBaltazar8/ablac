// __stack_chk_fail of the statically linked compiler's C library (src/static_libc/stackprot.ab, #806 step C): called, it writes
// "*** stack smashing detected ***: terminated" to standard error and ends the process by SIGABRT, which tools/test-libc-functions.sh checks
// (the program never returns, and exits 3 if it does).
import "../../../src/static_libc/stackprot.ab"

fun main: int {
    libcStackChkFail()
    3
}
