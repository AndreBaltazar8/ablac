// Scalars carry no global's origins in the jit tier's ordinary-global write analysis (#829). An int read from a
// read-only table is appended to an array (the analysis keeps every element in one bucket) and stored in a field; a
// method then returns a fresh object, and assigning its int field is no write of the table. Before, that assignment
// was taken as writing `table` (the shape of http/event's acceptReady and gzip's deflateLengthBases), and the site ran
// in the interpreter.
import "abla/io"

val table: array<int> = [3, 5, 7]

class Conn(var descriptor: int)

class Factory(val base: int) {
    fun make(): Conn = Conn(table[0] + this.base)
}

fun stored(): array<int> {
    val xs: array<int> = []
    xs.append(table[1])
    xs
}

compile fun site(): int {
    val first = stored()[0]
    val connection = Factory(1).make()
    connection.descriptor = -1
    val open = table.size > 2 && connection.descriptor < 0
    if (open) first + table[2] else 0
}

val staged = #site()

fun main(): int {
    println("$staged ${stored()[0]}")
    0
}
