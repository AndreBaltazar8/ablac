class Item(var n: int)
class Tag<T>(val n: int)
fun plain(item: Item, extra: int = 1): borrow(item) Item = item
fun simple(item: Item): borrow(item) Item = item
fun <T> identity(item: T): borrow(item) T = item
fun second(first: Item, second: Item): borrow(second) Item = second
fun <T> generic(item: Item, tag: Tag<T> = Tag<T>(1)): borrow(item) Item = item
class Reader(val item: Item) {
    fun read(extra: int = 1): borrow(this) Item = item
}
fun main: int {
    val item = Item(40)
    val saved = plain(item = item)
    val genericSaved = generic<string>(item = item)
    val plainSaved = simple(item = item)
    val identitySaved = identity<Item>(item = item)
    val secondSaved = second(second = item, first = Item(1))
    val reader = Reader(item)
    val memberSaved = reader.read(extra = 3)
    if (saved.n == 40 && genericSaved.n == 40 && memberSaved.n == 40 &&
        plainSaved.n == 40 && identitySaved.n == 40 && secondSaved.n == 40 &&
        plain(item = item).n == 40 && generic<string>(item = item).n == 40) 0 else 1
}
