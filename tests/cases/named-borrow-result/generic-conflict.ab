class Item(var n: int)
class Tag<T>(val n: int)
fun <T> generic(item: Item, tag: Tag<T> = Tag<T>(1)): borrow(item) Item = item
fun increment(var item: Item): void { item.n = item.n + 1 }
fun main: int {
    val item = Item(40)
    val saved = generic<string>(item = item)
    increment(item)
    saved.n
}
