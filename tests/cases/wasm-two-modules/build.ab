// Two WebAssembly builds in one build file (#wasmBuildModule, then #buildProgram): the compiler links WebAssembly twice in one process. A statically linked compiler runs lld's wasm-ld as a process
// of its own each time (lld's WebAssembly LTO cannot run twice in one process: "attempt to add bitcode file after LTO"); tools/test-static-wasm-modules.sh builds this with it.
import "abla/wasm/build"
import "abla/build"

val release = #wasmBuildModule(
    "wasm-two-release",
    "../wasm-export-extern/main.ab",
    "../../../build/wasm-two-modules/release.wasm",
    false,
    false
)
val development = #buildProgram(
    "wasm-two-development",
    "../wasm-export-extern/main.ab",
    "../../../build/wasm-two-modules/development.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && development) 0 else 1
