// An aliased module's intrinsic keeps its declared name for the compile-time
// effect check (abla/math/fast and abla/math/v8 both declare ablaF64RoundEven,
// so a program with both prefixes them): it is computed, not refused as
// trusted.native.
import "abla/math/v8" as v8

val atCompileTime = #v8.roundEven(2.5)

fun main: int = if (atCompileTime == 2.0 && v8.roundEven(3.5) == 4.0) 42 else 1
