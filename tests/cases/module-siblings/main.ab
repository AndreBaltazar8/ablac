// A program that imports hosted.ab and, through deep.ab and user.ab, pure.ab:
// each module's names mean the declarations its own imports reach.
import "hosted.ab"
import "deep.ab"

// The compile-time evaluator sees the same modules.
val atCompileTime = #viaDeep()

fun main: int {
    val hosted = if (label == "hosted") upgrade(connect()) else 100
    val deep = viaDeep()
    if (atCompileTime != deep) return 1
    // 7 + (6 + 23) + 6 = 42
    hosted + deep + Conn(6).handle
}
