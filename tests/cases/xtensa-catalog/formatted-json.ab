import "abla/json"
import "abla/process"

fun format(value: Json, sortKeys: bool, depth: int): JsonEncoded =
    jsonStringifyPretty(value, sortKeys, depth)

fun require(result: bool, message: string): void {
    if (!result) panic(message)
}

fun formatAtCompileTime(): string =
    format(jsonParse("{\"z\":null,\"a\":[]}").value, true, 1).text

val compileTimeOutput = #formatAtCompileTime()

fun main {
    val parsed = jsonParse("{\"z\":[],\"2\":{},\"10\":[true,{\"z\":null,\"a\":\"é\\\"\"}]}")
    require(parsed.succeeded, "invalid formatter fixture")
    val sorted = format(parsed.value, true, 4)
    val expected = "{\n  \"10\": [\n    true,\n    {\n      \"a\": \"é\\\"\",\n" +
        "      \"z\": null\n    }\n  ],\n  \"2\": {},\n  \"z\": []\n}\n"
    require(sorted.valid && sorted.text + "\n" == expected, "sorted JSON bytes")
    val object = jsonParse("{\"b\":1,\"a\":2}").value
    val ordered = format(object, false, 1)
    require(ordered.valid && ordered.text == "{\n  \"b\": 1,\n  \"a\": 2\n}", "input order")
    val scalar = format(jsonString("a\nb"), true, 0)
    require(scalar.valid && scalar.text == "\"a\\nb\"", "scalar JSON escaping")
    require(format(jsonParse("[]").value, true, 0).text == "[]", "empty root")
    require(!format(object, true, 0).valid, "object depth limit")
    require(!format(parsed.value, true, 2).valid, "nested depth limit")
    require(compileTimeOutput == "{\n  \"a\": [],\n  \"z\": null\n}", "compile-time formatting")
}
