// An array literal stored into a receiver whose type is only inferred takes
// the receiver's element (or value, field, parameter) type, as it does where
// the syntax declares it: `[null]` is an `array<string?>`, not `array<null>`,
// at runtime and under `#`.
import "abla/io"

fun makeRows() {
    val rows: array<array<string?>> = []
    rows
}

fun makeTable() {
    val table: Map<string, array<int?>> = Map()
    table
}

class Board(var rows: array<array<int?>>) {
    fun add(row: array<int?>): void {
        this.rows.append(row)
        return
    }
}

fun makeBoard() = Board([])

fun makeCube() {
    val cube: array<array<array<int?>>> = []
    cube
}

fun describe(): string {
    val rows = makeRows()
    rows.append([null])                       // append
    rows.append([null, "b"])
    rows[0] = [null, null, null]              // index assignment
    var replaced = makeRows()
    replaced = [[null], []]                   // assignment, nested
    val board = makeBoard()
    board.add([null, 2])                      // method argument
    board.rows.append(if (rows.size > 1) [null] else [])   // `if` tail
    val table = makeTable()
    table.set("k", [null])                    // Map value
    val cube = makeCube()
    cube.append([[null], [null, 3]])          // nested element literals
    var nulls = 0
    for (row in rows) for (cell in row) if (cell == null) nulls = nulls + 1
    val first = table.get("k")
    "${rows.size} $nulls ${replaced[0][0] == null} ${board.rows.size} ${board.rows[1][0] == null} ${if (first != null) first.size else -1} ${cube[0][1].size} ${cube[0][0][0] == null}"
}

fun main: int {
    val runtime = describe()
    val staged = #describe()
    println("$runtime|$staged")
    if (runtime == staged) 0 else 1
}
