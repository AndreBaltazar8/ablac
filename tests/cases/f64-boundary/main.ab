// f64Parse (abla/float/text) on the decimal strings tools/fuzz/f64-boundary.mjs makes: midpoints between neighbouring doubles with the digit that decides the
// rounding at significant digit 767 to 810 (the parser keeps 800 and a flag for what follows). Reads one text per line, prints the bits of its value (signed).
import "abla/io"
import "abla/float"
import "abla/float/text"

fun main: int {
    var running = true
    while (running) {
        val input = readInputLine()
        if (!input.available) {
            running = false
        } else if (input.text.size > 0) {
            println("${f64ToBits(f64Parse(input.text))}")
        }
    }
    0
}
