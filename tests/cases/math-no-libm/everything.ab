// Every abla/math function and the rounding builtins, for
// tools/test-math-no-libm.sh: built for each target, the object must call no
// C math library function.
import "abla/float"
import "abla/math"

@export("everything")
fun everything(x: f64, y: f64, z: f64): f64 =
    sin(x) + cos(x) + tan(x) + atan(x) + atan2(y, x) + exp(x) + log(y) +
        pow(x, y) + hypot(x, y) + sqrt(z) + fma(x, y, z) + fmin(x, y) +
        fmax(y, z) + fclamp(x, y, z) + floor(x) + ceil(y) + trunc(z) + roundEven(x) +
        fabs(y)

fun main: int = if (everything(0.5, 1.5, 2.5) > 0.0) 0 else 1
