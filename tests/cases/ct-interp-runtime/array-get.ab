// The runtime's own array getter evaluated at compile time. The interpreter has no run-time representation for it to
// read, so it must refuse with a diagnostic; it used to go on past that error into the runtime's panic path and call
// the real _longjmp, which crashed the compiler (SIGSEGV). ABLA_COMPILE_EVAL=jit runs it natively.
import "abla/compiler"
#compilerGrant("trusted.native")

trusted fun storedWord(values: any): int = __ablaRuntimeAsI64(__ablaRuntimeArrayGet(values, 0))

fun probe(): int {
    val values: array<int> = [7, 8]
    storedWord(values)
}

val staged = #probe()
fun main: int = staged
