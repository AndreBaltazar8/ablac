import "abla/compiler/parser"
import "consumer.ab"
class ProviderShape(val value: int)
compile fun parseShapeAnswer(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    syntaxInteger(21)
}
#compilerRegisterSubparser("shapeAnswer", parseShapeAnswer)
#compilerRegisterSubparser("shapeDecode", parseShapeAnswer)
