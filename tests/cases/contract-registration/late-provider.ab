import "abla/compiler/parser"
fun lateInitialize(): int = 42
val lateShapeValue = lateInitialize()
class LateShape(val value: int = lateShapeValue)
compile fun parseLateAnswer(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    syntaxInteger(42)
}
#compilerRegisterSubparser("lateAnswer", parseLateAnswer)
