// The compiler's own TLS (abla/platform/host/tls: abla/tls/pure, no OpenSSL) at compile time and in the program it builds:
// a connection to a TLS 1.3 and a TLS 1.2 server, a host the certificate does not name, an expired certificate and a closed
// port. A refusal is an error string, never a hang. It runs natively (ABLA_COMPILE_EVAL=jit: pure TLS is far too much work for the
// interpreter) and needs trusted.native (sockets), filesystem.read (the trust store), environment (SSL_CERT_FILE and friends) and clock,
// not network. tools/test-compile-tls.sh writes the ports and files into @…@.
import "abla/compiler"
import "abla/platform/host"
import "abla/platform/host/tls"
#compilerGrant("filesystem.read")
#compilerGrant("environment")
#compilerGrant("clock")
#compilerGrant("trusted.native")

fun fetch(host: string, port: int, ca: string): string {
    val handle = ablaHostTlsOpenWithCa(host, port, 5000, ca)
    if (handle < 0) return "refused: ${ablaHostTlsError()}"
    ablaHostTlsWrite(handle, "GET / HTTP/1.0\r\n\r\n")
    val reply = ablaHostTlsRead(handle, 64)
    ablaHostTlsClose(handle)
    reply.slice(0, 15)
}

fun all(): string = "${fetch("localhost", @PORT13@, "@CA@")} | ${fetch("localhost", @PORT12@, "@CA@")} | " +
    "${fetch("127.0.0.1", @PORT13@, "@CA@")} | ${fetch("localhost", @PORTEXPIRED@, "@EXPIREDCA@")} | " +
    "${fetch("localhost", @PORTCLOSED@, "@CA@")}"

fun main(): int {
    val compiled = #all()
    val running = all()
    ablaHostWriteStdout("compiled: $compiled\n")
    ablaHostWriteStdout("running: $running\n")
    if (compiled == running) 42 else 1
}
