// A build that fails after staging publishes nothing.
import "abla/fs"
import "abla/compiler"

#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

fun stage(): int {
    val root = path("build/compile-time-files/failed")
    root.child("written.txt").writeText("written")
    root.child("old.txt").remove()
    1
}

val staged = #stage()

fun main: int = staged + undefinedName
