// The same file operations at run time and under `#`, where writes, moves and
// removals are staged: what the code sees must agree.
import "abla/io"
import "abla/fs"
import "abla/compiler"

#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

fun fileOperations(): string {
    val root = path("build/compile-time-files/view")
    val file = root.child("note.txt")
    val created = root.createDirectories()
    val written = file.writeTextAtomic("one")
    val watcher = watchFile(file)
    val stable = !watcher.changed()
    file.appendText(" two")
    val detected = watcher.changed()
    val nested = root.child("inner").child("deep.txt").writeText("deep")
    val listed = root.entries().size
    val inner = root.child("inner").info().isDirectory()
    val moved = file.moveTo(root.child("moved.txt"))
    val gone = !file.exists()
    val read = root.child("moved.txt").readText()
    val missing = file.readTextResult()
    val notEmpty = !root.remove()
    val removed = root.child("moved.txt").remove() &&
        root.child("inner").child("deep.txt").remove() &&
        root.child("inner").remove() && root.remove()
    "$created $written $stable $detected $nested $listed $inner $moved $gone $read " +
        "${missing.succeeded}:${missing.errorCode} $notEmpty $removed ${root.exists()}"
}

fun main {
    println(fileOperations())
    println(#fileOperations())
}
