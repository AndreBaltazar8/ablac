// A build that fails after its staging ran (a later `#` divides by zero)
// publishes nothing, in either tier: the native tier leaves a site that
// reaches a capability provider to the evaluator, which stages it.
import "abla/fs"
import "abla/compiler"

#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

fun stage(): int {
    val root = path("build/compile-time-files/failed")
    root.child("written.txt").writeText("written")
    root.child("old.txt").remove()
    1
}

fun fail(zero: int): int = 10 / zero

val staged = #stage()
val broken = #fail(0)

fun main: int = staged + broken
