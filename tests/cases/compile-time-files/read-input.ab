// A file read under `#` is an input of the build: a cached build is reused
// only while it reads the same (the read is journaled in either tier).
import "abla/io"
import "abla/fs"
import "abla/compiler"

#compilerGrant("filesystem.read")

fun input(): string = path("build/compile-time-files/input.txt").readText()

fun main {
    println(#input())
}
