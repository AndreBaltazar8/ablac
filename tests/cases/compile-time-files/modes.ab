import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")
fun stage(): int {
    val root = path("build/compile-time-files/modes")
    var count = 0
    if (root.child("private").child("inner").createDirectories(448)) count = count + 1
    if (root.child("default").child("inner").createDirectories()) count = count + 1
    count
}
fun main: int = #stage()
