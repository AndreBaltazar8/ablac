// Staged writes, directories, moves and removals reach the disk once the build
// succeeds (the test script prepares old.txt and gone.txt).
import "abla/fs"
import "abla/compiler"

#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")

fun stage(): int {
    val root = path("build/compile-time-files/publish")
    var done = 0
    if (root.child("written.txt").writeText("written")) done = done + 1
    if (root.child("made").createDirectories()) done = done + 1
    if (root.child("old.txt").moveTo(root.child("moved.txt"))) done = done + 1
    if (root.child("gone.txt").remove()) done = done + 1
    done
}

fun main: int = #stage()
