import "abla/io"
import "abla/compiler"
import "./edits.ab"
import "./other.ab"

compile fun tagged(): int {
    val function = compiler.findFunction("libraryTagged")
    var found = 0
    var index = 0
    while (index < compiler.annotationCount(function)) {
        if (compiler.annotation(function, index) == "inline") found = 1
        index = index + 1
    }
    found
}

fun main {
    println("tagged=${#tagged()} other=${otherValue()}")
}
