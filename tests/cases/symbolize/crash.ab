// tools/test-symbolize.sh: an index out of bounds two calls deep (line 7), whose printed stack it symbolizes.
import "abla/io"
import "abla/process"

fun inner(items: array<int>, index: int): int {
    val doubled = index * 2
    return items[doubled]
}

fun middle(index: int): int = inner([1, 2, 3], index) + 1

fun main {
    println("${middle(processArgumentCount() + 4)}")
}
