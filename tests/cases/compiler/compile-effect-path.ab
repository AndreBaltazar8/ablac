import "../../../src/eval.ab"

fun effectCall(name: string): BootstrapExpression =
    BootstrapExpression("call", name, 0, 0, [])

fun main: int {
    val parsed = bootstrapParse(
        "fun cycle(): int { cycle(); cycle(); 0 }\nnoescape extern:\"host\" fun ablaHostReadFile(path: string): string\nfun readBuildInput(): int = ablaHostReadFile(\"unused\").size\n"
    )
    // An over-approximated summary can mark a recursive component even though
    // it has no route to the denied effect. Expanding all paths costs 2^32.
    val summary = BootstrapCompileEffectSummary(
        ["cycle", "readBuildInput", "ablaHostReadFile"], ["", "", ""],
        [4, 4, 4], [0], [1, 2, -1], [], [-1, -1, -1]
    )
    val absent = bootstrapCompileEffectPath(
        effectCall("cycle"), parsed.declarations, summary, 4, 0
    )
    val root = BootstrapExpression("block", "", 0, 0,
        [effectCall("cycle"), effectCall("readBuildInput")])
    val found = bootstrapCompileEffectPath(root, parsed.declarations, summary, 4, 0)
    val methods = bootstrapParse(
        "class Recursive { fun spin(): int { this.spin(); this.spin(); 0 } }"
    )
    val methodSummary = BootstrapCompileEffectSummary(
        [""], ["spin"], [4], [], [-1], [0], [-1]
    )
    val methodAbsent = bootstrapCompileEffectPath(
        BootstrapExpression("member.call", "spin", 0, 0, []),
        methods.declarations, methodSummary, 4, 0
    )
    val keys: array<string> = []
    val depths: array<int> = []
    val first = bootstrapCompileEffectPathVisit("same", 31, keys, depths)
    val repeated = bootstrapCompileEffectPathVisit("same", 31, keys, depths)
    val shorter = bootstrapCompileEffectPathVisit("same", 1, keys, depths)
    val longer = bootstrapCompileEffectPathVisit("same", 2, keys, depths)
    if (parsed.errors == 0 && methods.errors == 0 && absent == "" &&
        methodAbsent == "" &&
        found == "readBuildInput->ablaHostReadFile" &&
        first && !repeated && shorter && !longer) 42 else 1
}
