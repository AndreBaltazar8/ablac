// A float `%` on macOS is the runtime's exact remainder, not libSystem's fmod (#811): it must give
// the same bits as libSystem's fmod and fmodf, which this program calls itself for the comparison,
// on every pair of the edge values and on 100000 pseudo-random pairs (the WebAssembly check's cases).
// Exits 42 when all agree. Run by tools/test-darwin-routines.sh.
import "abla/io"
import "abla/float"
import "../wasm-float-remainder/remainder.ab"

extern:"c" fun fmod(x: f64, y: f64): f64
extern:"c" fun fmodf(x: f32, y: f32): f32

fun main(): int {
    var differ = 0
    var i = 0
    while (i < remainderCaseCount) {
        val expected = fmod(remainderX(i), remainderY(i))
        val expectedBits = if (expected != expected) 0x7FF8000000000000 else f64ToBits(expected)
        val expected32 = fmodf(remainderF32(i, remainderX(i)), remainderF32(i, remainderY(i)))
        val expectedBits32 = if (expected32 != expected32) 0x7FC00000 else int(f32ToBits(expected32))
        if (remainderBits(i) != expectedBits || remainderBits32(i) != expectedBits32) {
            if (differ < 5) println("differs at $i: ${remainderBits(i)} ${remainderBits32(i)}, fmod $expectedBits $expectedBits32")
            differ += 1
        }
        i += 1
    }
    println("darwin float remainder: ${remainderCaseCount - differ} of $remainderCaseCount cases agree with fmod and fmodf")
    if (differ == 0) 42 else 1
}
