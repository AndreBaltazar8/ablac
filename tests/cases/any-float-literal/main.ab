// A float literal or float value compared with an `any` through `==`, `!=` and `when` compares
// erased values, kind included: the integer 0 differs from 0.0, a string traps nothing and
// differs, a float equals a float of its own kind (1.5 == 1.5, 0.0 == -0.0, NaN != NaN) and
// differs from the other kind. The same checks run natively and in the compile-time evaluator;
// the two answers must agree and be the expected ones. Exits with the first failing check, plus
// 20 when it failed at compile time.
import "abla/float"

@noinline fun anyInt(value: int): any = value
@noinline fun anyText(value: string): any = value
@noinline fun anyFloat(value: f64): any = value
@noinline fun anySingle(value: f32): any = value
@noinline fun anyBool(value: bool): any = value
@noinline fun nan(): f64 = 0.0 / (0.0 + anyZero())
@noinline fun anyZero(): f64 = 0.0

fun checks(): int {
    val zero = anyInt(0)
    val one = anyInt(1)
    val text = anyText("0")
    val flag = anyBool(true)
    val float = anyFloat(1.5)
    val negative = anyFloat(-0.0)
    val single = anySingle(f32(1.5))
    val notANumber = anyFloat(nan())
    if (zero == 0.0) return 1
    if (!(zero != 0.0)) return 2
    if (0.0 == zero) return 3
    if (!(0.0 != zero)) return 4
    if (one == 1.0) return 5
    if (text == 0.0) return 6
    if (0.0 == text) return 7
    if (flag == 1.0) return 8
    if (float != 1.5) return 9
    if (!(float == 1.5)) return 10
    if (1.5 != float) return 11
    if (negative != 0.0) return 12
    if (0.0 != negative) return 13
    if (single == 1.5) return 14
    if (!(single != 1.5)) return 15
    if (float == f32(1.5)) return 16
    if (single != f32(1.5)) return 17
    if (notANumber == nan()) return 18
    if (!(notANumber != nan())) return 19
    if (zero == f32(0.0)) return 21
    if (anySingle(f32(1.5)) == 1.5) return 25
    if (1.5 == anySingle(f32(1.5))) return 26
    val matchedInt = when (zero) {
        0.0 -> true
        else -> false
    }
    if (matchedInt) return 22
    val matchedFloat = when (float) {
        1.5 -> true
        else -> false
    }
    if (!matchedFloat) return 23
    val matchedText = when (text) {
        0.0 -> true
        else -> false
    }
    if (matchedText) return 24
    0
}

compile fun compileChecks(): int = checks()

val COMPILED = #compileChecks()

fun main(): int {
    if (COMPILED != 0) return COMPILED + 20
    checks()
}
