import "abla/compiler"
import "helper.ab" as left
import "through.ab" as right

@export("reflection_own")
fun localExport(): int = 1

@exportLocal("reflection_local")
fun localOnly(): int = 2

// A local export still appears in reflection when its matching declaration is
// never called and its native body will be pruned.
extern:"c" fun reflection_local(): int

@exportChecked("reflection_checked")
fun checkedExport(): int = 3

fun ordinary(): int = 4

private fun privateProbe(): int = 0

compile fun inspectExports(): bool {
    val identity = compiler.functionModuleIdentity(compiler.findFunction("localExport"))
    if (identity == "") return false
    val own = compiler.exportedNames([identity, identity])
    if (own.size != 3) return false
    val privateIdentity = compiler.functionModuleIdentity(compiler.findFunction("privateProbe"))
    if (compiler.exportedNames([privateIdentity]).size != 3) return false
    if (own[0] != "reflection_checked" || own[1] != "reflection_local" || own[2] !=
        "reflection_own") return false
    val all = compilerExportedNames([])
    if (all.size != 5) return false
    if (all[0] != "reflection_checked" || all[1] != "reflection_helper_a" || all[2] !=
        "reflection_helper_z" ||
        all[3] != "reflection_local" || all[4] != "reflection_own") return false
    if (compiler.exportedNames(["not-a-loaded-module"]).size != 0) return false
    return true
}

val reflected = #inspectExports()

fun main: int = if (reflected && left.scopedExport() == right.throughExport()) 0 else 1
