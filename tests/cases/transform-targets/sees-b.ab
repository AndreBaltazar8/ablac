import "abla/compiler"
import "./library.ab"
import "./sees-a.ab"

// Parsed after sees-a.ab, whose annotation it sees.
compile fun answerB(): void {
    val tagged = compiler.findFunction("libraryTagged")
    if (compiler.annotationCount(tagged) > 0) {
        compiler.replaceFunctionBody(compiler.findFunction("libraryAnswer"), "42")
    }
    return
}

#compiler.transform(answerB)
