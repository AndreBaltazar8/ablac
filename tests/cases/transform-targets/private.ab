// Private functions, found by their source names and replaced: another
// module's, whose edit keys by the declaration whatever name the module
// rewrite gave it, and this module's own. Each new body reads names as its
// module does: the library's private `secretBase` and the `clamp` of the
// `abla/math` it imports (this module doesn't), this module's private `zero`.
import "abla/compiler"
import "./private-library.ab"

private fun zero(): int = 0

private fun own(): int = 7

compile fun edit(): void {
    compiler.replaceFunctionBody(compiler.findFunction("secret"), "secretBase() + clamp(41, 0, 100)")
    compiler.replaceFunctionBody(compiler.findFunction("own"), "zero()")
    return
}

#compiler.transform(edit)

fun main: int = reveal() + own()
