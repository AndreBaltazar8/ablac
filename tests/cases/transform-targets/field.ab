// Another module's extension field, removed (with its default).
import "abla/compiler"
import "./library.ab"

compile fun edit(): void {
    compiler.removeExtensionField(compiler.findClass("Enemy"), "unused")
    return
}

#compiler.transform(edit)

compile fun fields(): int = compiler.extensionFields(compiler.findClass("Enemy")).size

fun main: int = 42 + #fields()
