import "abla/io"
var log: string = ""
resource class Item(val id: int) {
    fun drop(): void { log += "I$id" }
    fun look(): void { log += "B$id" }
}
class Box(val items: array<Item>)
fun items(): array<Item> = [Item(1), Item(2)]
fun take(own x: Item): void { log += "T${x.id}" }
fun fresh(stop: bool): void { for (x in items()) { x.look(); if (stop) break } }
fun moved(stop: bool): void { val owned =
        items(); for (x in move(owned)) { x.look(); if (stop) break } }
fun movedField(): void { val b = Box(items()); for (x in move(b.items)) { x.look() } }
fun consumed(): void { for (x in items()) { take(move(x)) } }
fun earlyReturn(): void { for (x in items()) { x.look(); return } }
fun defers(): void {
    for (x in items()) { defer { log += "D" }; x.look(); continue }
}
fun mixed(fresh: bool): void {
    val owner = items()
    for (x in if (fresh) items() else owner) { x.look() }
}
fun freshBlock(): void {
    val owner = items()
    for (x in if (true) { val owner = items(); owner } else items()) { take(move(x)) }
}
fun gen(fresh: bool): Generator<int> = generator {
    val owned = items()
    for (x in if (fresh) items() else move(owned)) { x.look(); yield x.id }
}
fun genReturn(): Generator<int> = generator {
    for (x in items()) { x.look(); yield x.id; return }
}
fun genDefer(): Generator<int> = generator {
    for (x in items()) { defer { log += "D" }; x.look(); yield x.id }
}
fun exercise(): string {
    log = ""
    fresh(false); log += "|"
    fresh(true); log += "|"
    moved(false); log += "|"
    moved(true); log += "|"
    movedField(); log += "|"
    consumed(); log += "|"
    earlyReturn(); log += "|"
    defers(); log += "|"
    mixed(true); log += "|"
    mixed(false); log += "|"
    freshBlock(); log += "|"
    for (x in gen(false)) {}; log += "|"
    for (x in gen(false)) { break }; log += "|"
    for (x in gen(true)) {}; log += "|"
    for (x in genReturn()) {}; log += "|"
    for (x in genDefer()) { break }; log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
