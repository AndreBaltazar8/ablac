// SHA-384 and SHA-512 of the first n bytes of a fixed pattern (byte i is (7 i + 3) mod 256) for every n from 0 to 520 (the padding boundaries at 111, 112, 127, 128, 239, 240, 255, 256, ...) and for
// some larger sizes, one line "n sha384 sha512" each, for check.mjs to compare with Node's crypto. Argument 0: the largest size to add after the first 520 (a few steps up to it).
import "abla/io"
import "abla/bytes"
import "abla/crypto"
import "abla/process/arguments"
import "abla/text"

fun pattern(count: int): string {
    val buffer = byteBuffer()
    for (i in 0 until count) buffer.appendByteValue((7 * i + 3) & 255)
    buffer.toText()
}

fun main: int {
    val data = pattern(70000)
    for (n in 0 until 521) {
        val part = data.slice(0, n)
        println("$n ${hexEncode(sha384(part))} ${hexEncode(sha512(part))}")
    }
    for (n in [1000, 1023, 1024, 1025, 4095, 4096, 4097, 16383, 16384, 65535, 70000]) {
        val part = data.slice(0, n)
        println("$n ${hexEncode(sha384(part))} ${hexEncode(sha512(part))}")
    }
    0
}
