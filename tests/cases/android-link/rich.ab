import "abla/build"
import "abla/float"

// Everything an android-arm64 library can use today (no abla/io, no threads: the target is not hosted): strings,
// arrays, maps, classes, float arithmetic, and the runtime's thread-locals behind them.
class Counter(var count: int)

fun greet(n: int): string {
    val parts: array<string> = []
    for (index in 0 until n) parts.append("item$index")
    var text = ""
    for (part in parts) text = "$text$part,"
    text
}

fun answer: int {
    val counter = Counter(0)
    val table: Map<string, int> = Map()
    for (index in 0 until 20) {
        table.set("key$index", index * index)
        counter.count = counter.count + index
    }
    val ratio = (f64FromInt(counter.count) % 7.5) * 2.0
    greet(40).size + counter.count + f64ToInt(ratio)
}

val exported = #exportFunction("answer", "abla_app_answer")
