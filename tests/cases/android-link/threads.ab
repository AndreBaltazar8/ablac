import "abla/android/emutls"
import "abla/build"

// A library that starts a thread (bionic's pthread_create and pthread_join) and runs the debug-free heap behind it.
fun threadAnswer: int {
    val worker = thread { 6 * 7 }
    100 + await worker
}

val exported = #exportFunction("threadAnswer", "abla_app_answer")
