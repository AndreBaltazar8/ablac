// Two uses of freed memory that a build for valgrind (ABLA_VALGRIND=1) lets memcheck report (tools/test-valgrind.sh): the
// runtime's memcpy, called as C would call it (extern:"c"), reads 16 bytes of
//   buffer:    a native buffer after its close() freed it;
//   collected: a string's bytes after a collection freed the string (only its address was kept).
// With no argument it copies nothing and memcheck has nothing to report. Without valgrind each run prints "copied 0".
import "abla/io"
import "abla/memory"
import "abla/process/arguments"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

noescape extern:"c" fun memcpy(destination: int, source: int, count: int): int

// The address of a string of its own allocation, and nothing that keeps the string.
fun textAddress(): int {
    val text = "freed by the collection: ${processArgumentCount()} xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    nativeStringDataAddress(text)
}

trusted fun main {
    val which = if (processArgumentCount() > 0) processArgument(0) else "none"
    val target = nativeByteBuffer(64)
    for (index in 0 until 64) nativeByteBufferStore(target, index, 0)
    if (which == "buffer") {
        val buffer = nativeByteBuffer(64)
        val address = nativePointerAddress(buffer.address)
        buffer.close()
        memcpy(nativePointerAddress(target.address), address, 16)
    } else if (which == "collected") {
        val address = textAddress()
        memoryCollect()
        memcpy(nativePointerAddress(target.address), address, 16)
    }
    println("copied ${target.load(16)}")
    target.close()
}
