import "abla/io"

var isolated = 3
var observed = 10

@noinline
fun doubled(value: int): int = value * 2

@noinline
fun advance(limit: int, stop: bool): int {
    var index = 0
    while (index < limit) {
        isolated = doubled(isolated) + 1
        if (index == 10) print("")
        if (stop && index == 1) return isolated
        index += 1
    }
    isolated
}

@noinline
fun readObserved(): int = observed

@noinline
fun advanceObserved(limit: int): int {
    var index = 0
    var sum = 0
    while (index < limit) {
        observed += 1
        sum += readObserved()
        index += 1
    }
    sum
}

fun main {
    println("${advance(8, true)} $isolated")
    println("${advance(2, false)} $isolated")
    println("${advance(0, false)} $isolated")
    println("${advanceObserved(3)} $observed")
}
