import "abla/process/arguments"

@noinline
fun tableSearch(text: string, table: array<f64>, cutoff: f64): int {
    val target = cutoff
    var sum = 0.0
    var index = 0
    while (index < text.size - 1) {
        sum = sum + table[index]
        if (target < sum) break
        index = index + 1
    }
    index
}

@noinline
fun changingSearch(initial: string, table: array<f64>): int {
    var text = initial
    var sum = 0.0
    var index = 0
    while (index < text.size - 1) {
        sum = sum + table[index]
        if (sum > 1.0) break
        index = index + 1
        text = "A"
    }
    index
}

fun main: int {
    if (processArgument(0) == "bounds") return tableSearch("ABCD", [0.25], 0.9)
    val prefix = if (processArgumentCount() == 0) "ABCD" else processArgument(0)
    val rope = prefix + "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    if (tableSearch("", [], 1.0) != 0 ||
        tableSearch("AB", [0.25, 0.75], 0.01) != 0 ||
        tableSearch("ABCDE", [0.10, 0.25, 0.30, 0.10, 0.25], 0.70) != 3 ||
        tableSearch(rope, [0.95], 0.1) != 0 ||
        changingSearch("ABCD", [0.25, 0.25, 0.25, 0.25]) != 1) return 1
    42
}
