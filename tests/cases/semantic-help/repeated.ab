// tools/test-semantic-help.sh: five uses of a name the program doesn't import are five errors, with one help line on the
// command line and one on each error in the editor's analysis.
fun main: int {
    println("one")
    println("two")
    println("three")
    println("four")
    println("five")
    var count: int = 0
    count = "many"
    0
}
