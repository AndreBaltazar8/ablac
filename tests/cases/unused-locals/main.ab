// tools/test-unused-locals.sh: `dead` and `stale` are never used (two warnings); the others are: read, written, in an
// interpolation, captured by a closure, a loop's accumulator, an argument; `_kept` starts with `_`.
import "abla/io"

class Box(var value: int)

fun twice(number: int): int = number * 2

fun scaled(base: int, factor: int = 2): int = base * factor

fun main: int {
    // Named arguments are rewritten before sema numbers the text: the warnings below still point at the file's own offsets.
    val first = scaled(base = 3, factor = 4)
    val dead = 1
    var stale = 2
    val _kept = 3
    val read = 4
    var written = 0
    written = 5
    val text = "n"
    val box = Box(6)
    val captured = 7
    val add = { extra: int -> extra + captured }
    var total = 0
    var step = 0
    while (step < 3) {
        total = total + twice(step)
        step = step + 1
    }
    println("$text ${first + read + total} ${box.value} ${add(written)}")
    0
}
