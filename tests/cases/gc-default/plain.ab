// A release-built hosted Linux program that says nothing about the collector gets the collection with background freeing and, once its heap is large enough, the
// adaptive collection threads (decision #107). Live strings next to garbage, collected twice; tools/test-gc-default.sh reads the trace.
import "abla/io"
import "abla/memory"

fun main: int {
    val live: array<string> = []
    for (index in 0 until 400000) {
        if (index % 2 == 0) live.append("default-live-$index-padding-to-be-a-heap-string")
        else {
            val garbage = "default-garbage-$index-padding-to-be-freed-by-the-sweep"
            if (garbage.size == 0) live.append(garbage)
        }
    }
    memoryCollect()
    memoryCollect()
    var sum = 0
    for (text in live) sum = sum + text.size
    println("default gc ok: $sum")
    0
}
