// The same program turning background freeing off itself (memorySetBackgroundFree(false)): the plain collection, no helper, no threads.
import "abla/io"
import "abla/memory"

fun main: int {
    memorySetBackgroundFree(false)
    val live: array<string> = []
    for (index in 0 until 400000) {
        if (index % 2 == 0) live.append("default-live-$index-padding-to-be-a-heap-string")
        else {
            val garbage = "default-garbage-$index-padding-to-be-freed-by-the-sweep"
            if (garbage.size == 0) live.append(garbage)
        }
    }
    memoryCollect()
    memoryCollect()
    var sum = 0
    for (text in live) sum = sum + text.size
    println("default gc ok: $sum")
    0
}
