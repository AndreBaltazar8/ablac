// Request adaptive workers before a short stress window.
import "abla/io"
import "abla/memory"
import "abla/process/arguments"

fun main: int {
    memorySetBackgroundFree(true)
    memorySetGcWorkers(4)
    val count = if (processArgument(0) == "wide") 90000 else 32
    val live: array<string> = []
    for (index in 0 until count) {
        live.append("scoped-stress-survivor-$index")
    }
    memorySetStress(true)
    memoryCollect()
    memoryCollect()
    memorySetStress(false)
    for (index in 0 until live.size) {
        if (live[index] != "scoped-stress-survivor-$index") return 1
    }
    println("default gc ok: scoped")
    0
}
