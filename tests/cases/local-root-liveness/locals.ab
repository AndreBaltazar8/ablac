import "abla/io"
import "abla/float/text"

// Locals left out of the root frame when no collection can happen while they
// hold a value, and kept in it when one can. Run with a collection at every
// safe point (ABLA_GC_STRESS=1), every value a local still needs must survive.

// The test reads this function's code: its statement `if`s keep result
// temporaries no collection can see, and none of them is in its root frame.
fun pick(x: f64, kind: int): f64 {
    if (kind == 0) return x * 0.5
    if (kind == 1) return x * 0.25
    if (x > 1000.0) {
        val cold: array<f64> = filledArray(2, x)
        return cold[0] + cold[1]
    }
    x + 1.0
}

fun garbage(round: int): int {
    var total = 0
    for (index in 0 until 50) {
        val text = "garbage-$round-$index"
        total = total + text.size
    }
    total
}

// A local set before a loop of collecting calls and read after it.
fun keptAcrossLoop(): int {
    val kept: array<string> = []
    for (index in 0 until 20) kept.append("kept$index")
    var churned = 0
    for (round in 0 until 40) churned = churned + garbage(round)
    var total = 0
    for (text in kept) total = total + text.size
    total * 1000 + churned % 1000
}

// Loop-carried: read at the top of the next iteration, written at the bottom.
fun carried(): int {
    var previous: array<int> = []
    var total = 0
    for (round in 0 until 60) {
        if (previous.size > 0) total = total + previous[previous.size - 1]
        total = total + garbage(round) % 7
        val next: array<int> = []
        for (value in previous) next.append(value)
        next.append(round)
        previous = next
    }
    total * 100 + previous.size
}

// Read by a loop condition that collects, before the body's first use.
fun churnedOnce(var state: array<int>): bool {
    state[0] = state[0] + 1
    garbage(state[0]) > 0 && state[0] < 30
}

fun conditioned(): int {
    var label = "start"
    var state: array<int> = [0]
    while (churnedOnce(state)) {
        label = "$label.${state[0] % 10}"
    }
    label.size
}

// Borrowed and held by a closure: these stay rooted.
fun viaClosure(): int {
    val words: array<string> = []
    for (index in 0 until 10) words.append("word$index")
    val measure = { extra: int -> words.size * 100 + extra + garbage(extra) % 3 }
    var total = 0
    for (round in 0 until 20) total = total + measure(round)
    total
}

fun main: int {
    var picked = 0.0
    var x = 0.0
    for (index in 0 until 3000) {
        picked = picked + pick(x, index % 3)
        x = x + 0.5
    }
    println("picked $picked")
    println("kept ${keptAcrossLoop()}")
    println("carried ${carried()}")
    println("conditioned ${conditioned()}")
    println("closure ${viaClosure()}")
    0
}
