import "abla/fs"
import "abla/sys/linux/process"
fun main: int {
    val root = Path(linuxEnvironment("ABLA_FILE_MODE_ROOT").value)
    if (!root.child("secret").writeText("secret", mode = 0o600)) return 1
    if (!root.child("atomic").writeTextAtomic("atomic", mode = 0o600)) return 2
    if (!root.child("default").writeText("default")) return 3
    if (!root.child("existing").writeText("new", mode = 0o600)) return 4
    if (!root.child("existing-atomic").writeTextAtomic("new", mode = 0o600)) return 5
    if (root.child("existing").writeText("bad", mode = -1)) return 6
    if (root.child("existing-atomic").writeTextAtomic("bad", mode = 0o1000)) return 7
    if (root.child("invalid/child").writeText("bad", mode = 0o4000)) return 8
    if (root.child("invalid-atomic/child").writeTextAtomic("bad", mode = 0o2000)) return 9
    if (!root.child("zero").writeText("private", mode = 0o000)) return 10
    if (!root.child("all").writeTextAtomic("all", mode = 0o777)) return 11
    0
}
