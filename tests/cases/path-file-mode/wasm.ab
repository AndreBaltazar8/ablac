import "abla/fs"
import "abla/compiler"
#compilerGrant("filesystem.write")
val staged = #Path("build/path-file-mode-test/wasm-host").writeText("host secret", mode = 0o600)
@export("check")
fun check(): int {
    val file = Path("unsupported-runtime-file")
    if (staged && !file.writeText("secret", mode = 0o600) &&
        !file.writeTextAtomic("secret", mode = 0o600)) 42 else 1
}
