// Prints a file's fast-runtime record digest, "<size>-<hash>-<hash>", as the compiler computes it
// (bootstrapFastRuntimeDigest): a public function of the bytes, so anyone can write a record for any object.
import "abla/io"
import "abla/text"
import "abla/sys/linux"
import "abla/process/arguments"

fun hash(bytes: string, seed: int, factor: int, modulus: int): int {
    var value = seed
    var index = 0
    while (index + 4 <= bytes.size) {
        value = value * factor + textReadU32LittleEndian(bytes, index) + 1
        value = value - (value / modulus) * modulus
        index = index + 4
    }
    while (index < bytes.size) {
        value = value * factor + bytes[index] + 1
        value = value - (value / modulus) * modulus
        index = index + 1
    }
    value
}

fun main: int {
    val bytes = linuxReadFile(processArgument(0), 67108864)
    if (bytes.size == 0) return 1
    println("${bytes.size}-${hash(bytes, 17, 257, 1000000007)}-${hash(bytes, 31, 263, 1000000009)}")
    0
}
