// The site of main.ab under stress (tools/test-ct-threads-heap-stress.sh): its threads collect their own heap
// at every safe point while they start and allocate, and the compiler runs the call with its own heap under stress
// (ABLA_COMPILER_GC_STRESS=ct). The site's answer carries how many collections its runtime made, which must not be zero.
import "abla/io"
import "abla/memory"

fun work(seed: int): int {
    var total = 0
    var index = 0
    while (index < 200) {
        val text = "t$seed-$index"
        total = total + text.size
        index = index + 1
    }
    total
}

fun rounds(): int {
    var sum = 0
    var round = 0
    while (round < 80) {
        val a = thread { work(1) }
        val b = thread { work(2) }
        val c = thread { work(3) }
        val d = thread { work(4) }
        val e = thread { work(5) }
        val f = thread { work(6) }
        val g = thread { work(7) }
        val h = thread { work(8) }
        sum = sum + await a + await b + await c + await d + await e + await f + await g + await h
        round = round + 1
    }
    sum
}

fun stressedRounds(): string {
    val before = memoryHeapStat(14)
    memorySetStress(true)
    val sum = rounds()
    memorySetStress(false)
    "$sum ${memoryHeapStat(14) - before}"
}

val COMPILED = #stressedRounds()

fun main: int {
    println("${rounds()} $COMPILED")
    0
}
