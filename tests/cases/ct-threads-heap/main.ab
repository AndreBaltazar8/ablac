// Threads a native `#` site starts allocate their emulated thread-locals from the compiler's own heap
// (src/emutls_export.ab); the compiler shares that heap (its lock on) before calling a generation that can start
// threads (ct_eval.ab, bootstrapCtCall). Before, threads starting together could take overlapping blocks for their
// root-frame cells and the build stopped at random under load (thread-heap-mutex in the parity sample). Many rounds of
// many threads started at once, each allocating as soon as it runs, make the race likely within one site
// (tools/test-ct-threads-heap.sh).
import "abla/io"

fun work(seed: int): int {
    var total = 0
    var index = 0
    while (index < 200) {
        val text = "t$seed-$index"
        total = total + text.size
        index = index + 1
    }
    total
}

fun rounds(): int {
    var sum = 0
    var round = 0
    while (round < 80) {
        val a = thread { work(1) }
        val b = thread { work(2) }
        val c = thread { work(3) }
        val d = thread { work(4) }
        val e = thread { work(5) }
        val f = thread { work(6) }
        val g = thread { work(7) }
        val h = thread { work(8) }
        sum = sum + await a + await b + await c + await d + await e + await f + await g + await h
        round = round + 1
    }
    sum
}

val COMPILED = #rounds()

fun main: int {
    println("${rounds()} $COMPILED")
    0
}
