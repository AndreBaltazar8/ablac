import "rsa-copy.ab"
import "abla/fs"
import "abla/process/arguments"

fun main: int {
    val input = path(processArgument(0)).readText()
    val key = rsaPrivateKeyFromPem(input)
    if (!key.ok()) return 1
    val der = rsaPrivateExportDer(key)
    val pem = rsaPrivateExportPem(key)
    if (!der.ok || !pem.ok) return 2
    val fromDer = rsaPrivateKeyFromDer(der.bytes)
    val fromPem = rsaPrivateKeyFromPem(pem.bytes)
    if (!fromDer.ok() || !fromPem.ok()) return 3
    val second = rsaPrivateExportDer(fromPem)
    if (!second.ok || second.bytes != der.bytes) return 4
    // Number-only keys have the CRT components but no original d.
    val words = key.primeWords
    val without = rsaPrivateFromNumbers(key.modulus, key.publicExponent,
        rsaExportLimbs(key.primeP(), words), rsaExportLimbs(key.primeQ(), words),
        rsaExportLimbs(key.exponentP(), words), rsaExportLimbs(key.exponentQ(), words),
        rsaExportLimbs(key.inverseQ(), words))
    val missing = rsaPrivateExportPem(without)
    if (!without.ok() || missing.ok || missing.error != "RSA private exponent is unavailable") return 5
    if (!path(processArgument(1)).writeText(der.bytes) ||
        !path(processArgument(2)).writeText(pem.bytes)) return 6
    0
}
