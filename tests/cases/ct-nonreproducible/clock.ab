// A `#` site that reads the clock: what it computes from the clock may differ from one build to the next, so the
// build notes it (decision #82 B) and lists it in the ABI manifest. The pure site beside it is not noted. (Its value
// is the same every time, so tools/test-ct-bridge.sh can compare the tiers' programs.)
import "abla/compiler"
#compilerGrant("clock")

val ticking = #(compilerClockMilliseconds() > 0)
val answer = #(40 + 2)
fun main: int = if (ticking) answer else 1
