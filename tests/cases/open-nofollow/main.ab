import "abla/sys/linux"
import "abla/sys/linux/process"
fun main(): int {
    val root = linuxEnvironment("ABLA_NOFOLLOW_ROOT").value
    val regular = linuxOpen("$root/file", 131072)
    if (regular.descriptor < 0) return 1
    if (regular.close() != 0) return 2
    val fileLink = linuxOpen("$root/file-link", 131072)
    if (fileLink.descriptor >= 0) { fileLink.close(); return 3 }
    val directory = linuxOpen("$root/dir", 65536 | 131072)
    if (directory.descriptor < 0) return 4
    if (directory.close() != 0) return 5
    val dirLink = linuxOpen("$root/dir-link", 65536 | 131072)
    if (dirLink.descriptor >= 0) { dirLink.close(); return 6 }
    0
}
