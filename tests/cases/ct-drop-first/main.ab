// A `#` site whose only use of a global is a local's drop: Guard.drop appends to `shared` when `g` goes out of scope.
// The site's entry must initialize the globals as one that reads `shared` does.
import "abla/io"

val shared: array<int> = []
resource class Guard(val n: int) {
    fun drop(): void { shared.append(1) }
}
fun scoped(): int {
    val g = Guard(1)
    return g.n + 1
}
compile fun guarded(): int = scoped()
val Y = #guarded()

fun main: int {
    println("$Y ${scoped()} ${shared.size}")
    0
}
