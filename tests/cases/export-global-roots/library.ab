import "abla/build"
import "abla/memory"

// A library whose only entry is an export: `main` never runs, so its globals
// must be collector roots from the export's first initialization.
class Table(val name: string, val values: array<int>)

val table = Table("roots", [3, 5, 7, 11])
var history: array<string> = []

fun churn(round: int): int {
    var total = 0
    var i = 0
    while (i < 2000) {
        val parts = [i, i + 1, i + 2]
        val garbage = "round $round item $i ${parts.size}"
        total = total + garbage.size % 3
        i = i + 1
    }
    total
}

// Allocates, collects, then reads the globals. Returns their checksum, which
// must stay the same however often collection runs.
fun touch(round: int): int {
    churn(round)
    history.append("call $round")
    memoryCollect()
    var sum = 0
    for (value in table.values) sum = sum + value
    sum * 100 + table.name.size * 10 + (if (history[history.size - 1] == "call $round") 1 else 0)
}

#exportFunction("touch", "export_roots_touch")
