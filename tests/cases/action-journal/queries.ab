import "abla/io"
import "abla/compiler"

// An action that only asks the compiler questions (the program's functions by annotation, their
// signatures, a class's fields, a name that is not there): its journal is
// replayable, and asking the same questions again of the same program gives the same answers
// (ABLA_ACTION_JOURNAL=check).
class Point(val x: int, val y: int)

@route
fun first(a: int, b: string): int = a

@route
fun second(p: Point): bool = true

fun plain(): int = 1

compile fun survey(): string {
    var text = ""
    for (function in compiler.functionsAnnotated("route")) {
        text = "$text ${compiler.functionName(function)}/${compiler.parameterCount(function)}"
        var index = 0
        while (index < compiler.parameterCount(function)) {
            text =
                "$text ${compiler.parameterName(function, index)}:${compiler.parameterType(function, index)}"
            index = index + 1
        }
        text = "$text->${compiler.resultType(function)}"
    }
    val point = compiler.findClass("Point")
    text = "$text | ${compiler.fieldsOf(point).size}"
    val missing = compiler.findFunction("notThere")
    text = "$text | ${if (missing < 0) "absent" else "present"}"
    text
}

val surveyed = #survey()

fun main: int {
    println(surveyed)
    42
}
