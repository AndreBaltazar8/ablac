import "abla/io"
import "abla/compiler"

// The negative control: an action that changes the program is not on the journal's allow-list, so
// its record is unreplayable and a result cache must run it every build.
@route
fun tagged(): int = 1

compile fun change(): void {
    compiler.addFunctionAnnotation(compiler.findFunction("tagged"), "inline")
    return
}

#compiler.transform(change)

fun main: int {
    println("done")
    42
}
