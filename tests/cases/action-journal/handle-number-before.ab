import "abla/io"
import "abla/compiler"

// A function handle is a position in the declaration array and its NUMBER is observable: this action
// builds a name from it. The journal must therefore hold the number: the same program with a function
// declared before `target` gets another number (and another result) and the record must differ; one
// declared after it must not change the record.
fun inserted(): int = 2
fun target(): int = 1

compile fun describe(): string {
    val handle = compiler.findFunction("target")
    "gen_${handle}_${compiler.functionName(handle)}"
}

val described = #describe()

fun main: int {
    println(described)
    42
}
