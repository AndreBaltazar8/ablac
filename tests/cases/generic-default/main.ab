var drops = 0
resource class Ticket(val number: int) { fun drop(): void { drops = drops + 1 } }
class Box<T>(val value: T, val number: int = 42)
class Pair<T>(val value: T, val fallback: T = value)
compile fun staged(): int = Box(7).value
fun <T> fromFactory(factory: () -> T): Box<T> = Box<T>(factory())
fun checks(): bool {
    val a = Box<Ticket>(Ticket(1))
    val b = Box<string>("hello")
    val c = Box<int>(number = 42, value = 7)
    val d = Box(Ticket(2))
    val e = Box<array<Ticket>>([Ticket(3)])
    val pair = Pair<int>(42)
    val nested = fromFactory({ -> Ticket(4) })
    a.number == 42 && b.number == 42 && b.value == "hello" && c.number == 42 && c.value == 7 && d.number == 42 && e.number == 42 && pair.fallback == 42 && nested.number == 42 && #staged() == 7
}
fun main: int = if (checks() && drops == 4) 42 else 1
