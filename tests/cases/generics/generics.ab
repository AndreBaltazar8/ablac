// Generic functions, extensions and classes: what each computes, checked
// against what it should (genericsCases returns the number that differ).
import "abla/io"
import "abla/float/text"
import "./module.ab"

class Box<T>(val value: T) {
    fun get(): T = this.value
    fun map(f: (T) -> T): Box<T> = Box(f(this.value))
}

class Pair<A, B>(val first: A, val second: B) {
    fun swapped(): Pair<B, A> = Pair(this.second, this.first)
}

resource class Ticket(val id: int) {
    fun drop(): void {}
}

class Stack<T>(var items: array<T>) {
    fun push(item: T): void {
        this.items.append(item)
        return
    }
    fun top(): T? = if (this.items.size > 0) this.items[this.items.size - 1] else null
}

// A generic delegate, and generic classes whose properties delegate.
class Slot<T>(var current: T, var writes: int) {
    fun getValue(): T = current
    fun setValue(next: T): void {
        writes += 1
        current = next
        return
    }
}

class Tracked<T>(val start: T, var value: T by Slot(start, 0)) {
    fun reset(): void {
        value = start
        return
    }
}

class Counter(var count: int by Slot(0, 0))

// No method reads these: their delegates are typed with the class.
class Bare<T>(val start: T, var value: T by Slot(start, 0))

class Unused(var count: int by Slot(0, 0))

// A generic delegate no body names: its instance is bound where `Gate()`
// fills the delegate in, outside the class (in a function and in a global's
// initializer).
class Latch<T>(var held: T) {
    fun getValue(): T = held
    fun setValue(next: T): void {
        held = next
        return
    }
}

class Gate(var open: bool by Latch(false))

val closedGate = Gate()

fun latched(): string {
    val gate = Gate()
    gate.open = true
    "${gate.open} ${closedGate.open}"
}

// A default that calls a generic, filled in at each call.
fun <T> boxedOr(value: T, box: Box<T> = Box(value)): T = box.get()

fun <T> first(items: array<T>): T = items[0]

fun <T> identity(value: T) = value

fun <T> same(a: T, b: T): bool = a == b

fun <T> emptyOf(): array<T> = []

fun <T, R> array<T>.mapped(f: (T) -> R): array<R> {
    val out: array<R> = []
    for (item in this) out.append(f(item))
    out
}

fun <T> array<T>.firstOr(fallback: T): T = if (this.size > 0) this[0] else fallback

fun <K, V> Map<K, V>.size2(): int = this.size * 2

fun <T> Box<T>.text(show: (T) -> string): string = "box(${show(this.value)})"

fun <T> wrap(value: T): Box<Box<T>> = Box(Box(value))

fun <T> sum(items: array<T>, add: (T, T) -> T, zero: T): T {
    var total = zero
    for (item in items) total = add(total, item)
    total
}

// A class of a resource is a resource; a generic taking one owns it.
class Holder<T>(val value: T)

fun <T> keep(own value: T): Holder<T> = Holder(move(value))

// A returned value starting with a generic call: the call's type
// arguments come from its argument, not from the function's result.
fun firstPlusOne(boxes: array<Box<int>>): int {
    return first(boxes).get() + 1
}

var failures = 0

fun check(name: string, actual: string, expected: string): void {
    if (actual != expected) {
        println("generics: $name: got $actual, expected $expected")
        failures = failures + 1
    }
    return
}

fun genericsCases(): int {
    failures = 0
    check("first", "${first([3, 4])} ${first(["a"])} ${first<f64>([1.5])}", "3 a 1.5")
    check("identity", "${identity(7)} ${identity("s")}", "7 s")
    check("same", "${same(1, 1)} ${same("a", "b")}", "true false")
    val none: array<string> = emptyOf()
    check("expected", "${none.size} ${emptyOf<int>().size}", "0 0")
    val small: Box<u8> = Box(200)
    check("box", "${Box(1).get()} ${Box("x").map { s -> s + "y" }.get()} ${small.get()}", "1 xy 200")
    check("pair", "${Pair(1, "b").swapped().first}", "b")
    check("mapped", "${[1, 2].mapped { n -> n * 10 }[1]} ${[1].mapped { n -> "n$n" }[0]}", "20 n1")
    check("firstOr", "${emptyOf<int>().firstOr(9)} ${[5].firstOr(9)}", "9 5")
    val ages: Map<string, int> = Map()
    ages.set("a", 1)
    check("map", "${ages.size2()}", "2")
    check("boxText", Box(4).text { n -> "$n" }, "box(4)")
    check("wrap", "${wrap(6).get().get()}", "6")
    check("returned", "${firstPlusOne([Box(4)])}", "5")
    check("sum", "${sum([1, 2, 3], { a, b -> a + b }, 0)} ${sum(["a", "b"], { a, b -> a + b }, "")}", "6 ab")
    val stack = Stack<string>([])
    stack.push("p")
    stack.push("q")
    val top = stack.top()
    check("stack", "${if (top != null) top else "-"} ${Stack<int>([]).top() == null}", "q true")
    val ticket = keep(Ticket(5))
    check("resource", "${ticket.value.id} ${keep(8).value}", "5 8")
    check("module", "${moduleBox(3).get()} ${moduleFirst()}", "3 41")
    val tracked = Tracked("a")
    tracked.value = "b"
    val seen = tracked.value
    tracked.reset()
    val counter = Counter()
    counter.count += 2
    check("delegated", "$seen ${tracked.value} ${tracked.^value.writes} ${Tracked(3).value} ${counter.count}", "b a 2 3 2")
    check("bare", "${Bare(5).value} ${Bare("x").value}", "5 x")
    check("filled delegate", latched(), "true false")
    check("defaults", "${boxedOr(1)} ${boxedOr("s")} ${boxedOr(2, Box(5))}", "1 s 5")
    check("nullable", "${stack.top() ?? "-"} ${Stack<int>([]).top() ?? 7} ${Stack<string>([]).top()?.size ?? 0}", "q 7 0")
    failures
}
