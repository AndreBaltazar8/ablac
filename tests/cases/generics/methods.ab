// Generic methods: a class's method with type parameters of its own, made per
// receiver instance and type arguments and inferred at the call, as a generic
// extension is. It reaches what any method reaches: the class's fields and
// methods, its module's private names, a delegated property's delegate
// (`^`), and `this` of a resource class; and under `#` it runs per instance.
class Bag<T>(val items: array<T>) {
    fun <U> remap(f: (T) -> U): Bag<U> {
        val out: array<U> = []
        for (item in items) out.append(f(item))
        Bag(out)
    }

    fun <U> fold(start: U, step: (U, T) -> U): U {
        var total = start
        for (item in items) total = step(total, item)
        total
    }

    // A generic method calling another, and a plain method.
    fun <U> shown(show: (T) -> U, text: (U) -> string): string = "${remap(show).count()}:${text(remap(show).items[0])}"

    fun count(): int = items.size
}

class Ledger(val name: string) {
    fun <V> tagged(value: V, text: (V) -> string): string = "$name:${text(value)}"

    fun <V> pair(a: V, b: V): array<V> = [a, b]
}

private fun methodsSecret(): int = 7

class Peeker(val base: int) {
    fun <V> peek(value: V, text: (V) -> string): string = "${text(value)}+${methodsSecret() + base}"
}

class Gauge(var level: int by Slot(0, 0)) {
    fun <V> bump(tag: V, text: (V) -> string): string {
        level = level + 1
        "${text(tag)} $level ${this.^level.writes}"
    }
}

resource class Vault(val code: int) {
    fun <V> open(key: V, text: (V) -> string): string = "vault $code ${text(key)}"
}

class Shop(val name: string) {
    fun <U : Ordered<U>> cheapest(items: array<U>): U {
        var best = items[0]
        for (item in items) if (item.compare(best) < 0) best = item
        best
    }
}

fun methodsCheck(name: string, actual: string, expected: string): int {
    if (actual == expected) return 0
    println("methods $name: got '$actual', expected '$expected'")
    1
}

fun methodsCases(): int {
    var failures = 0
    val bag = Bag([1, 2, 3])
    failures += methodsCheck("remap", "${bag.remap { n -> "n$n" }.items[2]} ${bag.remap { n -> n * 10 }.items[1]}", "n3 20")
    failures += methodsCheck("explicit", "${bag.remap<string> { n -> "x$n" }.items[0]} ${Ledger("e").pair<f64>(1.5, 2.5)[1]}", "x1 2.5")
    failures += methodsCheck("fold", "${bag.fold(0) { total, n -> total + n }} ${bag.fold("") { text, n -> "$text$n" }}", "6 123")
    failures += methodsCheck("words", "${Bag(["a", "bb"]).remap { s -> s.size }.fold(0) { total, n -> total + n }}", "3")
    failures += methodsCheck("shown", bag.shown({ n -> n * 2 }, { n -> "$n" }), "3:2")
    val ledger = Ledger("cash")
    failures += methodsCheck("plain class", "${ledger.tagged(5) { n -> "$n" }} ${ledger.tagged("x") { s -> s }} ${ledger.pair(1, 2).size}", "cash:5 cash:x 2")
    failures += methodsCheck("private", Peeker(1).peek(true) { b -> if (b) "yes" else "no" }, "yes+8")
    val gauge = Gauge()
    failures += methodsCheck("delegated", "${gauge.bump("a") { s -> s }} ${gauge.bump(2) { n -> "#$n" }}", "a 1 1 #2 2 2")
    val vault = Vault(42)
    failures += methodsCheck("resource", vault.open("k") { s -> s }, "vault 42 k")
    failures += methodsCheck("bound", "${Shop("s").cheapest([Money(5), Money(2), Money(9)]).cents}", "2")
    failures += methodsCheck("compile time", "${#Bag([4, 5]).remap { n -> n + 1 }.items[1]} ${#Ledger("c").tagged(1.5) { x -> "$x" }}", "6 c:1.5")
    failures
}
