// A `#` site that asks for a larger instance in every round never settles:
// compile.edit-fixpoint after 8 rounds, naming the instances it asked for.
import "abla/compiler"

class Box<T>(val value: T)

compile fun deeper(): string {
    var type = "int"
    var count = compiler.instantiations("Box").size
    while (count > 0) {
        type = "Box<$type>"
        count = count - 1
    }
    compiler.instantiate("Box", [type])
}

val DEEPEST = #deeper()

fun main: int = Box(1).value
