// `compiler.instantiate` from a `#` site: the next round of lowering has the
// instance, as if the program used it.
import "abla/io"
import "abla/compiler"

class Box<T>(val value: T)

fun <T> first(items: array<T>): T = items[0]

compile fun made(): string {
    val box = compiler.instantiate("Box", ["string"])
    compiler.instantiate("first", ["bool"])
    "$box ${compiler.classOf(compiler.findType(box)) >= 0} ${compiler.findFunction("first<bool>") >= 0} " +
        "${compiler.instantiations("Box").size}"
}

val MADE = #made()

fun main: int {
    println("${Box(1).value} $MADE")
    42
}
