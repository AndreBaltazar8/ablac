// Private generics: their instances stay this module's, apart from another
// module's public generic of the same name; a generic's body reads this
// module's private names in every instance.
private class Cache<T>(val value: T) {
    fun get(): T = this.value
}

private fun <T> cached(value: T): Cache<T> = Cache(value)

private fun <T> array<T>.lastOne(): T = this[this.size - 1]

private fun string.shout(): string = "$this!"

class Shelf<T>(val items: array<T>) {
    fun last(): T = this.items.lastOne()
    fun title(name: string): string = name.shout()
}

fun libraryValue(): string =
    "${cached(4).get()} ${cached("lib").get()} ${Shelf([1, 2]).last()} ${Shelf(["a"]).title("s")}"
