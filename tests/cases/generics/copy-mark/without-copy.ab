// The same literals in a program with no copied generic call.
import "abla/io"
import "literals.ab"

class Box<T>(val item: T)

fun main: int {
    val a = Box<string>("x")
    val result = copyMarkLiterals()
    println("$result | ${a.item}")
    if (result == COPY_MARK_EXPECTED && a.item == "x") 42 else 1
}
