// Two instances of a class whose property delegates to a generic: the delegate
// call is filled in per instance at one span, so the program has a copied
// generic call, and its marks are dropped from the whole program.
import "abla/io"
import "literals.ab"

class Slot<T>(var value: T) { fun getValue(): T = value }
class Box<T>(val item: T, val saved: T by Slot(item))

fun main: int {
    val a = Box<string>("x")
    val b = Box<int>(1)
    val result = copyMarkLiterals()
    println("$result | ${a.saved}${b.saved}")
    if (result == COPY_MARK_EXPECTED && a.saved == "x" && b.saved == 1) 42 else 1
}
