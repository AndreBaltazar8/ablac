// String literals holding byte 0x1e, the mark a copied generic call carries on
// its text while generics are bound (BOOTSTRAP_GENERIC_COPY_MARK). Only calls
// lose that mark afterwards: a literal keeps the byte and all that follows.
// SHA-256's constant table has it at byte 199, so a cut there made every
// digest wrong. Abla has no character literals; a one-byte string is the
// nearest. The raw blocks hold the byte itself, since raw text has no escapes.

/** Each literal's size, and the bytes around its 0x1e, as one line. */
fun copyMarkLiterals(): string {
    val start = "\x1eab"
    val middle = "ab\x1ecd"
    val end = "ab\x1e"
    val markLike = "a\x1e1"
    val unicode = "x\u{1e}y"
    val single = "\x1e"
    val interpolated = "${start.size}\x1e${end.size}"
    val raw = """raw"""
    val block = """
        lineone
        two
        """
    val wide = "\x10\x1e\x20\x30\x10\x1e\x20\x30\x10\x1e\x20\x30\x10\x1e\x20\x30\x10\x1e\x20\x30\x10\x1e\x20\x30\x10\x1e\x20\x30\x10\x1e\x20\x30"
    val sizes = "${start.size} ${middle.size} ${end.size} ${markLike.size} ${unicode.size} ${single.size} ${interpolated.size} ${raw.size} ${block.size} ${wide.size}"
    val bytes = "${start[0]} ${start[2]} ${middle[2]} ${middle[4]} ${end[2]} ${markLike[2]} ${unicode[1]} ${interpolated[1]} ${raw[1]} ${raw[3]} ${block[4]} ${block[9]} ${block[10]} ${wide[29]}"
    val char30 = single[0] == char(30) && raw[1] == char(30)
    "$sizes | $bytes | $char30"
}

val COPY_MARK_EXPECTED = "3 5 3 3 3 1 3 4 13 32 | 30 98 30 100 30 49 30 30 30 119 30 30 116 30 | true"
