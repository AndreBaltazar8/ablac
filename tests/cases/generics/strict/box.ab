import "./util.ab"

// A generic's body sees its own module's imports, whichever module uses it.
class Box<T>(val value: T) {
    fun label(show: (T) -> string): string = utilLabel(show(this.value))
}

fun <T> boxOf(value: T): Box<T> = Box(value)

fun <T> Box<T>.pair(other: T): array<T> = [this.value, other]
