resource class Ticket(val id: int) {
    fun drop(): void {}
}

class Pair<A, B>(val first: A, val second: B)

// Fine for a copied value, an error for a resource: the error names the instance.
fun <T> twice(value: T): Pair<T, T> = Pair(value, value)

class Box<T>(val value: T)

fun main() {
    val numbers = twice(1)
    val tickets = twice(Ticket(1))
    val box = Box(Ticket(2))
    val other = box
}
