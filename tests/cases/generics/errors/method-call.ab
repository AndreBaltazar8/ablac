// A call of a class's generic method that can't bind is named by its class.
class Sack<T>(val items: array<T>) {
    fun <U> remap(f: (T) -> U): Sack<U> {
        val out: array<U> = []
        for (item in items) out.append(f(item))
        Sack(out)
    }
}

fun main() {
    Sack([1]).remap(5)
}
