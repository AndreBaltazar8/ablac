// An interface's method takes no type parameters of its own (a call through
// an interface value would need each class's instance for each); a class's
// method's type parameter may not reuse the class's name for one.
interface Mapper {
    fun <R> mapped(f: (int) -> R): R
}

class Holder<T>(val value: T) {
    fun <T> again(other: T): T = other
}

fun main() {}
