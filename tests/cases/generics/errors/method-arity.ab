// A generic method's type arguments written out name only its own parameters
// (`U`; the receiver fixes `T`).
class Sack<T>(val items: array<T>) {
    fun <U> remap(f: (T) -> U): Sack<U> {
        val out: array<U> = []
        for (item in items) out.append(f(item))
        Sack(out)
    }
}

fun main() {
    Sack([1]).remap<int, string, bool> { n -> "$n" }
}
