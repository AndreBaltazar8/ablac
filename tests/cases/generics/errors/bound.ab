interface Shape {
    fun area(): int
}

class Square(val side: int) : Shape {
    fun area(): int = this.side * this.side
}

class Gallery<T : Shape>(val items: array<T>)

fun <T : Shape> biggest(items: array<T>): int = items[0].area()

fun main: int {
    val wrong: Gallery<string> = Gallery(["a"])
    biggest([1, 2]) + biggest([Square(2)])
}
