interface Ordered<T> {
    fun compare(other: T): int
}

class Money(val cents: int) : Ordered<Money> {
    fun compare(other: Money): int = this.cents - other.cents
}

// Ordered, but with another type than itself.
class Coin(val cents: int) : Ordered<Money> {
    fun compare(other: Money): int = this.cents - other.cents
}

fun <T : Ordered<T>> largest(items: array<T>): T = items[0]

fun main: int {
    val coin = largest([Coin(1)])
    largest([Money(1)]).cents + largest([1, 2])
}
