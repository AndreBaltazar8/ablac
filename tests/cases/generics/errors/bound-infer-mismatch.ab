interface Source<T> {
    fun at(index: int): T?
}

class Numbers(val limit: int) : Source<int> {
    fun at(index: int): int? = if (index < this.limit) index * index else null
}

fun <T, C : Source<T>> orElse(c: C, fallback: T): T = c.at(5) ?? fallback

fun main() {
    val x = orElse(Numbers(3), "none")
}
