// A type parameter that a bound names is bound from the type argument's conformance: with `<T, C : BiSource<T>>`
// and `C` a class conforming to `BiSource<int>`, `T` is `int` (it used to be generic.cannot-infer). The class may
// be a generic class, conform by `extend`, or be the interface instance itself; a bound's parameter bound by
// another bound binds in turn; explicit type arguments and arguments that bind `T` first still win.
import "abla/io"

interface BiSource<T> {
    fun at(index: int): T?
}

interface BiSink<T> {
    fun put(value: T): int
}

class BiNumbers(val limit: int) : BiSource<int> {
    fun at(index: int): int? = if (index < this.limit) index * index else null
}

class BiWords(val words: array<string>) : BiSource<string> {
    fun at(index: int): string? = if (index < this.words.size) this.words[index] else null
}

class BiRepeat<T>(val value: T, val times: int) : BiSource<T> {
    fun at(index: int): T? = if (index < this.times) this.value else null
}

class BiCouple(val first: int, val second: int)

fun BiCouple.at(index: int): int? = if (index == 0) this.first else if (index == 1) this.second else null

extend BiCouple : BiSource<int>

class BiCounter(var total: int) : BiSink<int> {
    fun put(value: int): int {
        this.total = this.total + value
        this.total
    }
}

// BiBoth instances of one interface: T cannot be told from the class alone.
interface BiMarker<T> {
    fun id(): int
}

class BiBoth : BiMarker<int>, BiMarker<string> {
    fun id(): int = 7
}

fun <T, C : BiMarker<T>> biIdOf(c: C): int = c.id()

fun <T, C : BiSource<T>> biFirstOf(c: C): T? = c.at(0)

fun <T, C : BiSource<T>> biSumTwo(c: C, add: (T, T) -> T): T? {
    val a = c.at(0)
    val b = c.at(1)
    if (a != null && b != null) add(a, b) else null
}

fun <A, S : BiSource<A>, K : BiSink<A>> biPump(source: S, var sink: K): int {
    var last = 0
    var index = 0
    var more = true
    while (more) {
        val item = source.at(index)
        if (item != null) last = sink.put(item) else more = false
        index = index + 1
    }
    last
}

fun <T, C : BiSource<T>> biOrElse(c: C, fallback: T): T = c.at(5) ?? fallback

fun boundInferCheck(name: string, actual: string, expected: string): int {
    if (actual == expected) return 0
    println("bound infer $name: got '$actual', expected '$expected'")
    1
}

fun boundInferCases(): int {
    var failures = 0
    failures += boundInferCheck("int", "${biFirstOf(BiNumbers(3)) ?? -1}", "0")
    failures += boundInferCheck("string", biFirstOf(BiWords(["x", "y"])) ?? "-", "x")
    failures += boundInferCheck("generic class", biFirstOf(BiRepeat("ab", 2)) ?? "-", "ab")
    failures += boundInferCheck("generic class int", "${biFirstOf(BiRepeat(7, 2)) ?? -1}", "7")
    failures += boundInferCheck("extend", "${biFirstOf(BiCouple(4, 5)) ?? -1}", "4")
    val shared: BiSource<int> = BiNumbers(3)
    failures += boundInferCheck("interface value", "${biFirstOf(shared) ?? -1}", "0")
    failures += boundInferCheck("lambda", "${biSumTwo(BiNumbers(3)) { x, y -> x + y + 100 } ?? -1}", "101")
    failures += boundInferCheck("lambda string", biSumTwo(BiWords(["a", "b"])) { x, y -> "$x$y!" } ?? "-", "ab!")
    val counter = BiCounter(0)
    failures += boundInferCheck("chain", "${biPump(BiNumbers(4), counter)} ${counter.total}", "14 14")
    failures += boundInferCheck("argument binds first", "${biOrElse(BiNumbers(3), 99)}", "99")
    failures += boundInferCheck("explicit", "${biFirstOf<int, BiNumbers>(BiNumbers(3)) ?? -1} ${biIdOf<int, BiBoth>(BiBoth()) + biIdOf<string, BiBoth>(BiBoth())}", "0 14")
    failures += boundInferCheck("compile time", "${#biFirstOf(BiNumbers(5)) ?? -1} ${#biFirstOf(BiWords(["q"])) ?? "-"}", "0 q")
    failures
}
