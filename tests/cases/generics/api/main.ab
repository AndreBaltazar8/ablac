// The compiler API on generics: the instances a generic has, an instance's
// type arguments, and an instance asked for from a transform.
import "abla/io"
import "abla/compiler"

class Box<T>(val value: T) {
    fun get(): T = this.value
}

fun <T> first(items: array<T>): T = items[0]

class Square(val side: int)

class Slot<T>(var current: T) {
    fun getValue(): T = current
}

// A delegated property: the rewrite keeps the instance's type arguments.
class Tracked<T>(val start: T, val value: T by Slot(start)) {
    fun read(): T = this.value
}

compile fun ask(): void {
    // Neither is used by the program: each is made because it is asked for.
    compiler.instantiate("Box", ["string"])
    compiler.instantiate("first", ["Square"])
    return
}

#compiler.transform(ask)

compile fun report(): string {
    var text = ""
    for (name in compiler.instantiations("Box")) text = "$text $name"
    text = "$text |"
    for (name in compiler.instantiations("first")) text = "$text $name"
    val box = compiler.findType("Box<int>")
    text = "$text | ${compiler.typeName(box)}:"
    for (argument in compiler.typeArguments(box)) text = "$text ${compiler.typeName(argument)}"
    val chosen = compiler.findFunction("first<Square>")
    text = "$text | ${compiler.functionName(chosen) != ""}:"
    for (argument in compiler.functionTypeArguments(chosen)) text = "$text ${compiler.typeName(argument)}"
    val getter = compiler.findFunction("Box<string>.get")
    for (argument in compiler.functionTypeArguments(getter)) text = "$text ${compiler.typeName(argument)}"
    val reader = compiler.findFunction("Tracked<bool>.read")
    for (argument in compiler.functionTypeArguments(reader)) text = "$text ${compiler.typeName(argument)}"
    "$text | ${compiler.instantiate("Box", ["int"])} ${compiler.classOf(compiler.findType("Box<string>")) >= 0}"
}

val REPORT = #report()

fun main: int {
    println("${Box(1).get()} ${first([2])} ${Tracked(true).read()}")
    println(REPORT)
    42
}
