// A class's generic method's instances are labelled by the method's class.
class Sack<T>(val items: array<T>) {
    fun <U> remap(f: (T) -> U): Sack<U> {
        val out: array<U> = []
        for (item in items) out.append(f(item))
        Sack(out)
    }
}

fun main: int = Sack([1, 2]).remap { n -> "$n" }.items.size
