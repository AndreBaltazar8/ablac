// Bounded type parameters: a body calls its bounds' members, and each
// instance calls the class's own method (no dispatch); an interface type
// argument dispatches as any interface value does.
interface Shape {
    fun area(): int
    fun label(): string = "shape ${this.area()}"
}

interface Named {
    fun name(): string
}

class Square(val side: int) : Shape, Named {
    fun area(): int = this.side * this.side
    fun name(): string = "square"
}

class Rect(val width: int, val height: int) : Shape {
    fun area(): int = this.width * this.height
}

class Tag(val text: string)

fun Tag.name(): string = "#${this.text}"

extend Tag : Named

fun <T : Shape> totalArea(items: array<T>): int {
    var total = 0
    for (item in items) total = total + item.area()
    total
}

fun <T : Shape & Named> describe(item: T): string = "${item.name()} ${item.label()}"

fun <T : Named> names(items: array<T>): string {
    var text = ""
    for (item in items) text = "$text${item.name()};"
    text
}

class Gallery<T : Shape>(val items: array<T>) {
    fun largest(): int {
        var best = 0
        for (item in this.items) if (item.area() > best) best = item.area()
        best
    }
    fun total(): int = totalArea(this.items)
}

fun <T : Shape> array<T>.areas(): array<int> {
    val out: array<int> = []
    for (item in this) out.append(item.area())
    out
}

fun <T : Shape> asShape(item: T): Shape = item

fun boundsCheck(name: string, actual: string, expected: string): int {
    if (actual == expected) return 0
    println("bounds $name: got '$actual', expected '$expected'")
    1
}

fun boundsCases(): int {
    var failures = 0
    failures += boundsCheck("total", "${totalArea([Square(2), Square(3)])} ${totalArea([Rect(2, 5)])}", "13 10")
    val shapes: array<Shape> = [Square(1), Rect(1, 4)]
    failures += boundsCheck("interface", "${totalArea(shapes)} ${totalArea<Shape>([Rect(2, 2)])}", "5 4")
    failures += boundsCheck("two", describe(Square(3)), "square shape 9")
    failures += boundsCheck("extend", "${names([Tag("a"), Tag("b")])} ${names([Square(1)])}", "#a;#b; square;")
    val gallery = Gallery([Rect(1, 2), Rect(3, 3)])
    val typed: Gallery<Square> = Gallery([Square(5)])
    failures += boundsCheck("class", "${gallery.largest()} ${gallery.total()} ${typed.largest()}", "9 11 25")
    failures += boundsCheck("extension", "${[Square(2), Square(4)].areas()[1]}", "16")
    failures += boundsCheck("upcast", asShape(Rect(2, 3)).label(), "shape 6")
    failures
}
