// `#` code in a generic's body runs per instance, with each type parameter
// its type argument's type handle; an `if` a `#` type query decides keeps
// only the branch each instance takes, so the other may use what only some
// type arguments have.
import "abla/io"
import "abla/compiler"

interface Hashable {
    fun hash(): int
}

class Key(val n: int) : Hashable {
    fun hash(): int = this.n * 31
}

class Plain(val n: int)

resource class Handle(val id: int) {
    fun drop(): void {}
}

class Wrapped<T>(val value: T)

fun <T> fingerprint(value: T): int =
    if (#compiler.typeConformsTo(T, "Hashable")) value.hash() else -1

fun <T> typeNameOf(value: T): string = #compiler.typeName(T)

fun <T> ownership(value: T): string =
    if (#compiler.isResource(T)) "resource" else "value"

fun <T> both(value: T): string =
    if (#(compiler.typeConformsTo(T, "Hashable") && !compiler.isResource(T))) "hashable value"
    else if (!#compiler.typeConformsTo(T, "Hashable")) "other"
    else "hashable resource"

fun <T> fieldCount(value: T): int {
    #(if (compiler.classOf(T) >= 0) compiler.fieldsOf(compiler.classOf(T)).size else 0)
}

fun compileTimeCheck(name: string, actual: string, expected: string): int {
    if (actual == expected) return 0
    println("compile-time $name: got '$actual', expected '$expected'")
    1
}

fun compileTimeCases(): int {
    var failures = 0
    failures += compileTimeCheck("fold", "${fingerprint(Key(2))} ${fingerprint(Plain(2))} ${fingerprint(3)}", "62 -1 -1")
    failures += compileTimeCheck("name", "${typeNameOf(1)} ${typeNameOf([Key(1)])} ${typeNameOf(Wrapped("s"))}", "i64 array:Key Wrapped<string>")
    val handle = Handle(1)
    failures += compileTimeCheck("resource", "${ownership(handle)} ${ownership(Plain(1))} ${ownership(2)}", "resource value value")
    failures += compileTimeCheck("logic", "${both(Key(1))} ${both(Plain(1))}", "hashable value other")
    failures += compileTimeCheck("fields", "${fieldCount(Key(1))} ${fieldCount(1)}", "1 0")
    failures
}
