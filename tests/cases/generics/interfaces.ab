// Generic interfaces: a class conforms to an instance of one (`Source<int>`),
// a generic function taking one infers its type argument from the class's
// conformance, a default body runs per instance, an interface may extend an
// instance, and a bound may name its own parameter (`T : Ordered<T>`). The
// compiler API reads instances of generic interfaces as written.
import "abla/compiler"

interface Source<T> {
    fun at(index: int): T?
    fun all(): array<T> {
        val items: array<T> = []
        var index = 0
        var more = true
        while (more) {
            val item = this.at(index)
            if (item != null) items.append(item) else more = false
            index = index + 1
        }
        items
    }
}

class Numbers(val limit: int) : Source<int> {
    fun at(index: int): int? = if (index < this.limit) index * index else null
}

class Words(val words: array<string>) : Source<string> {
    fun at(index: int): string? = if (index < this.words.size) this.words[index] else null
}

// A generic class conforming to the instance for its own type argument.
class Repeat<T>(val value: T, val times: int) : Source<T> {
    fun at(index: int): T? = if (index < this.times) this.value else null
}

interface Sized<T> : Source<T> {
    fun size(): int = this.all().size
}

class Letters(val text: string) : Sized<string> {
    fun at(index: int): string? = if (index < this.text.size) this.text.slice(index, index + 1) else null
}

class Couple(val first: int, val second: int)

fun Couple.at(index: int): int? = if (index == 0) this.first else if (index == 1) this.second else null

extend Couple : Source<int>

fun <T> count(source: Source<T>): int = source.all().size

fun <T> firstOf(source: Source<T>): T? = source.at(0)

fun <T> allOf(source: Source<T>): array<T> = source.all()

interface Ordered<T> {
    fun compare(other: T): int
}

class Money(val cents: int) : Ordered<Money> {
    fun compare(other: Money): int = this.cents - other.cents
}

fun <T : Ordered<T>> largest(items: array<T>): T {
    var best = items[0]
    for (item in items) if (item.compare(best) > 0) best = item
    best
}

// Values of an instance dispatch as any interface value.
fun sumAll(sources: array<Source<int>>): int {
    var total = 0
    for (source in sources) for (value in source.all()) total = total + value
    total
}

// A sealed generic interface: `when` over an instance's value needs no
// `else`, and `is`/`as?` name instances.
sealed interface Outcome<T>

class Done<T>(val value: T) : Outcome<T>

class Broken<T>(val reason: string) : Outcome<T>

fun <T> outcomeText(outcome: Outcome<T>): string = when (outcome) {
    is Done<T> -> "done"
    is Broken<T> -> "broken ${outcome.reason}"
}

fun parseOutcome(text: string): Outcome<int> = if (text == "1") Done(1) else Broken("bad $text")

fun parseCode(code: int): Outcome<string> = when (code) {
    0 -> Done("zero")
    else -> Broken("code $code")
}

fun intText(outcome: Outcome<int>): string = when (outcome) {
    is Done<int> -> "d${outcome.value}"
    is Broken<int> -> "b"
}

fun doneValue(outcome: Outcome<int>): int {
    val done = outcome as? Done<int>
    return if (done != null) done.value else -1
}

compile fun interfacesReflected(): string {
    val numbers = compiler.findClass("Numbers")
    var text = "${compiler.conformsTo(numbers, "Source<int>")} ${compiler.conformsTo(numbers, "Source<string>")}"
    for (name in compiler.conformances(compiler.findClass("Letters"))) text = "$text $name"
    var repeat = false
    for (name in compiler.implementers("Source<int>")) if (name == "Repeat<i64>") repeat = true
    val source = compiler.findType("Source<int>")
    text = "$text $repeat ${compiler.typeName(source)} ${compiler.typeConformsTo(source, "Source<int>")}"
    for (argument in compiler.typeArguments(source)) text = "$text ${compiler.typeName(argument)}"
    "$text ${compiler.typeConformsTo(compiler.findType("Money"), "Ordered<Money>")}"
}

fun interfacesJoined(items: array<int>): string {
    var text = ""
    for (item in items) text = if (text == "") "$item" else "$text $item"
    text
}

fun interfacesCheck(name: string, actual: string, expected: string): int {
    if (actual == expected) return 0
    println("interfaces $name: got '$actual', expected '$expected'")
    1
}

fun interfacesCases(): int {
    var failures = 0
    failures += interfacesCheck("default", interfacesJoined(allOf(Numbers(4))), "0 1 4 9")
    failures += interfacesCheck("direct default", "${interfacesJoined(Numbers(3).all())} ${Letters("abc").size()} ${Couple(1, 2).all().size}", "0 1 4 3 2")
    failures += interfacesCheck("infer", "${count(Numbers(3))} ${count(Words(["a", "b"]))}", "3 2")
    failures += interfacesCheck("result", firstOf(Words(["x", "y"])) ?? "-", "x")
    failures += interfacesCheck("generic class", "${allOf(Repeat("ab", 2)).size} ${count(Repeat(7, 3))}", "2 3")
    val letters: Sized<string> = Letters("abc")
    failures += interfacesCheck("inherited", "${letters.size()} ${count(Letters("ab"))}", "3 2")
    failures += interfacesCheck("extend", interfacesJoined(allOf(Couple(4, 5))), "4 5")
    failures += interfacesCheck("self bound", "${largest([Money(5), Money(9), Money(2)]).cents}", "9")
    val sources: array<Source<int>> = [Numbers(3), Repeat(2, 2), Couple(1, 1)]
    failures += interfacesCheck("dispatch", "${sumAll(sources)}", "11")
    val words: Source<string> = Words(["q"])
    failures += interfacesCheck("typed", "${words.at(0) ?? "-"} ${words.at(1) ?? "-"}", "q -")
    failures += interfacesCheck(
        "sealed", "${outcomeText(parseOutcome("1"))} ${outcomeText(parseOutcome("x"))} ${doneValue(parseOutcome("1"))} ${doneValue(parseOutcome("y"))} " +
            "${outcomeText(Done("s"))} ${intText(parseOutcome("1"))} ${intText(parseOutcome("z"))}",
        "done broken bad x 1 -1 done d1 b"
    )
    failures += interfacesCheck(
        "expected", "${outcomeText(parseCode(0))} ${outcomeText(parseCode(3))} ${#outcomeText(parseOutcome("c"))} ${#outcomeText(parseCode(4))}",
        "done broken code 3 broken bad c broken code 4"
    )
    failures += interfacesCheck(
        "compiler API", #interfacesReflected(),
        "true false Sized<string> Source<string> true Source<i64> true i64 true"
    )
    failures
}
