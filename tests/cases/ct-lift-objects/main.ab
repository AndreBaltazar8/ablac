// A `#` site whose result is a large array of objects (#1029): each field becomes a column of constants and one loop
// builds the objects, so the global initializer's frame doesn't grow with the count (built one object at a time,
// 60,000 objects were an 8.6 MB frame, a stack overflow under the default stack, and minutes of register allocation).
// The fields are of each column kind; an object the scene also holds as `focus` stays the array's own element.
import "abla/io"
import "abla/float"

class Item(var id: int, val name: string, val even: bool, val weight: f64, val small: u8)

class Scene(val items: array<Item>, val focus: Item)

fun item(index: int): Item =
    Item(index, "item${index % 97}", index % 2 == 0, f64FromInt(index) * 0.5, u8(index % 251))

fun scene(count: int): Scene {
    val all: array<Item> = []
    val focus = item(count / 2)
    var index = 0
    while (index < count) {
        if (index == count / 2) all.append(focus) else all.append(item(index))
        index += 1
    }
    Scene(all, focus)
}

fun digest(values: array<Item>): string {
    var sum = 0
    for (each in values) {
        sum = (sum * 31 + each.id + each.name.size + (if (each.even) 1 else 0) + f64ToInt(each.weight * 2.0) +
            int(each.small)) % 1000003
    }
    "${values.size}:$sum"
}

val made = #scene(60000)

fun main {
    val expected = scene(60000)
    val before = "${digest(expected.items)} ${digest(made.items)}"
    // The focus is the array's element: changing it through one changes it through the other.
    made.focus.id = -1
    println("$before ${made.items[30000].id}")
}
