val kept: array<(int) -> int> = []

fun run(callback: (int) -> int): int {
    kept.append(callback)
    callback(1)
}

// Calls the closures kept from every round after their frames are gone (each sees
// the round counter as the loop left it: it captured the variable).
fun later(): int {
    var sum = 0
    for (callback in kept) sum = sum + callback(0)
    sum
}
