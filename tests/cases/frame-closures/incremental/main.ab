import "abla/io"
import "abla/memory"
import "./callee.ab"

// The callee decides whether this closure stays in the frame: the test edits
// callee.ab to keep it, rebuilds with the build cache, and expects a heap closure
// that still holds its captures.
fun main: int {
    var total = 0
    var round = 0
    while (round < 200) {
        val label = "round-$round"
        total = total + run({ x -> x + label.size + round })
        memoryCollect()
        round = round + 1
    }
    println("total $total later ${later()}")
    0
}
