// A site that fails only after more steps than a rerun may take (a million): the rerun doesn't reach the failure, and
// the native place, the site, stays.
fun pick(items: array<int>, at: int): int = items[at]

fun late(): int {
    val items = [1, 2, 3]
    var total = 0
    var round = 0
    while (round < 3000000) {
        total = (total + round) % 7
        round = round + 1
    }
    pick(items, total + 7)
}

val value = #late()
fun main: int = value
