// An index out of bounds two calls below the `#` site, in functions native code inlines: the site can run again
// unseen, so its native failure is placed by rerunning it in the evaluator (tools/test-ct-rerun-place.sh).
fun pick(items: array<int>, at: int): int = items[at]

fun table(): int {
    val items = [1, 2, 3]
    pick(items, 7)
}

val value = #table()
fun main: int = value
