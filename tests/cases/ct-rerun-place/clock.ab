// A site that reads the clock before it fails: running it again would read the clock again, so it isn't rerun and
// keeps its native place, the site.
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

fun pick(items: array<int>, at: int): int = items[at]

fun stamped(): int {
    val items = [1, 2, 3]
    pick(items, if (monotonicMilliseconds() > 0) 7 else 0)
}

val value = #stamped()
fun main: int = value
