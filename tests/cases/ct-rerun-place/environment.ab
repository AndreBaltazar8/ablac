// A site that reads the environment before it fails: it isn't rerun either.
import "abla/compiler"
#compilerGrant("environment")

compile fun pick(items: array<int>, at: int): int = items[at]

compile fun configured(): int {
    val items = [1, 2, 3]
    pick(items, compilerEnvironment("HOME").size + 7)
}

val value = #configured()
fun main: int = value
