// A run of tools/test-libc-imports.sh lists what this program imports; see that script. A WebSocket server with TLS
// (abla/websocket/server/tls over abla/tls/pure) needs no OpenSSL and no libc (#822): this program must link static and
// import nothing, as it did not while the server drove OpenSSL.
import "abla/io"
import "abla/websocket/server"
import "abla/websocket/server/tls"

fun main: int {
    // A certificate that is not there: the configuration is refused, with the whole TLS server code linked.
    val tls = webSocketServerTls("/nonexistent/certificate.pem", "/nonexistent/key.pem")
    println(if (tls.error != "") "refused" else "unexpected success")
    0
}
