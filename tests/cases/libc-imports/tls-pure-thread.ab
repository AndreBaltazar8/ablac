// HTTPS inside `thread {}` compiles, links static (no libc, no OpenSSL) and runs: the pure TLS reaches no mutable global.
import "abla/io"
import "abla/http"
import "abla/http/tls"
import "abla/tls/pure"

fun refusedFetch(): int {
    // A connection that cannot be made (a reserved port): the handshake code is linked.
    val result = httpsClient("localhost", 1, 4096, 200, 400).send(httpGet("/"))
    if (result.succeeded) 1 else 0
}

fun main: int {
    val first = thread { refusedFetch() }
    val second = thread { refusedFetch() }
    val mine = refusedFetch()
    println(if (await first + await second + mine == 0) "refused in threads" else "unexpected success")
    0
}
