// A run of tools/test-libc-imports.sh lists what this program imports; see that script. An HTTPS client over the pure
// TLS (abla/http/tls over abla/tls/pure) needs no OpenSSL and no libc: this program must link static and import nothing.
import "abla/io"
import "abla/http"
import "abla/http/tls"
import "abla/tls/pure"
fun main: int {
    if (tlsAvailable()) println("tls") else println("no tls")
    // A connection that cannot be made (a reserved port): the whole client, handshake code included, is linked.
    val result = httpsClient("localhost", 1, 4096, 200, 400).send(httpGet("/"))
    println(if (result.succeeded) "unexpected success" else "refused")
    0
}
