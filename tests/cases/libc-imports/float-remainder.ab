// A run of tools/test-libc-imports.sh lists what this program imports; see that script.
import "abla/io"
import "abla/float/text"
fun main: int {
    val line = readLine()
    val a: f64 = f64FromInt(line.size) + 0.5
    val b: f32 = f64ToF32(a)
    println("${a % 2.0} ${b % f64ToF32(1.5)}")
    0
}
