// A run of tools/test-libc-imports.sh lists what this program imports; see that script. The nonblocking HTTP client's TLS is
// abla/tls/pure's TlsSession, so a program with an HTTPS request needs no OpenSSL and no libc (#822): it must link static and
// import nothing, as it did not while the client drove OpenSSL.
import "abla/io"
import "abla/http"
import "abla/http/async"
import "abla/process/time"

fun main: int {
    var client = httpAsyncClient()
    // A connection that cannot be made (a reserved port): the HTTPS path, handshake code included, is linked.
    val id = client.get("https://localhost:1/", [], 400)
    var waiting = true
    var status = -1
    val limit = monotonicMilliseconds() + 5000
    while (waiting && monotonicMilliseconds() < limit) {
        client.step(50)
        val done = client.takeCompletions()
        var index = 0
        while (index < done.size) {
            if (done[index].id == id) {
                status = done[index].status
                waiting = false
            }
            index = index + 1
        }
    }
    println(if (waiting) "no completion" else if (status == 200) "unexpected success" else "refused")
    0
}
