// A run of tools/test-libc-imports.sh lists what this program imports; see that script. abla/jwt verifies RS256 and ES256 with
// abla/crypto's RSA and P-256 (#822), so a program that checks a token needs no libcrypto and no libc: this program must link
// static and import nothing, as it did not while the signatures went to OpenSSL.
import "abla/io"
import "abla/jwt"

val jwtImportKeys = "{\"keys\":[{\"kty\":\"EC\",\"x\":\"m8w8ainreQcAWItPCTE7beCaMJ9kivm_WhG3h3Qk6io\",\"y\":\"3ndvwZTS_BTo8MTCPShOmqH6racp5g_j7FgZK9uxhTQ\",\"crv\":\"P-256\",\"kid\":\"ec-1\",\"alg\":\"ES256\"}]}"
val jwtImportToken = "eyJhbGciOiJFUzI1NiIsImtpZCI6ImVjLTEifQ.eyJzdWIiOiJwbGF5ZXItNDIiLCJleHAiOjE5MDAwMDA2MDB9.SrHgBttxs2lVvtrL9aSAvqsfGvJSKaJUkmhrZJuD0A9AkUgVCjL0Oapp9zElwpchhpAoZgWqm5s6i0Uz6qXDVQ"

fun main: int {
    val keys = jwtKeySet(jwtImportKeys)
    // The signature belongs to other claims: refused after the whole verification path ran.
    val result = keys.verify(jwtImportToken, JwtOptions(nowSeconds = 1900000000))
    println(if (keys.error == "" && !result.valid && result.error == "signature verification failed") "refused" else "unexpected: ${result.error}")
    0
}
