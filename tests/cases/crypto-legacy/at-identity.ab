import "abla/io"
import "abla/fs"
import "abla/process/arguments"
import "abla/tls/pure"

// Opens a client identity from a PKCS#12 file as a mutual-TLS client would, and says what came out. Used by the opt-in test of
// the tax authority's published test certificate (tools/test-crypto-legacy.sh, AT_TEST_PFX): a TLS identity needs the key
// and its certificate chain (here the leaf, the issuing CA and the root).
fun main: int {
    val identity = tlsClientIdentityFromPkcs12(path(processArgument(0)).readText(), processArgument(1))
    println("identity: ok=${identity.ok()} chain=${identity.chain.size} error=${identity.error}")
    if (identity.ok() && identity.chain.size >= 1) 0 else 1
}
