import "abla/io"
import "abla/bytes"
import "abla/crypto/legacy"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/crypto/result"

// Known answers made with OpenSSL 3.5 (enc -des-ede3-cbc, -des-ede-cbc, and -rc2-40-cbc / -rc2-cbc from the legacy provider):
// the plaintext is "The quick brown fox jumps over the lazy dog 0123456789" (55 bytes, padded to 56), the IV a1a2a3a4a5a6a7a8.
val legacyPlain = "The quick brown fox jumps over the lazy dog 0123456789"

fun hexBytes(text: string): string {
    val out = byteBuffer()
    var at = 0
    while (at < text.size) {
        val high = if (text[at] >= 97) text[at] - 87 else text[at] - 48
        val low = if (text[at + 1] >= 97) text[at + 1] - 87 else text[at + 1] - 48
        out.appendByteValue(high * 16 + low)
        at += 2
    }
    out.toText()
}

trusted fun keyBuffer(hex: string): NativeByteBuffer {
    val bytes = hexBytes(hex)
    val buffer = nativeByteBuffer(bytes.size)
    for (i in 0 until bytes.size) ablaUnsafeStoreU8(ablaUnsafePointerOffset(ablaUnsafeNullPointer(), ablaUnsafePointerAddress(buffer.address) + i), int(bytes[i]))
    buffer
}

var failures = 0

fun expect(name: string, result: CryptoResult): void {
    if (!result.ok || result.bytes != legacyPlain) {
        println("FAIL $name: ok=${result.ok} error=${result.error} text=${result.bytes}")
        failures = failures + 1
    }
    return
}

fun main: int {
    val iv = hexBytes("a1a2a3a4a5a6a7a8")
    expect("3DES three-key", legacyDes3CbcDecrypt(keyBuffer("000102030405060708090a0b0c0d0e0f1011121314151617"), iv, hexBytes("57732df288f347d7983b856caa0aa63c7585ae634f082e11024205e17a929f4ba89235c24970a5675229ec4c7c72a594d358e7915c137a20")))
    expect("3DES two-key", legacyDes3CbcDecrypt(keyBuffer("000102030405060708090a0b0c0d0e0f"), iv, hexBytes("1376fbe8b120df1f0bc85d5e23e80212cd919a947e4c81d08cb7af997348ae87aab95aeae166135f0c2c940eff93023e1018a2719635ec3f")))
    expect("RC2 40-bit", legacyRc2CbcDecrypt(keyBuffer("0102030405"), 40, iv, hexBytes("bd22e4a6a55a0df83f90d92176eba022f2ec4482ab0bf54ce3f9654e74a83211df6c6990458ca1b44825ed9761e020f1804cf731f157196f")))
    expect("RC2 128-bit", legacyRc2CbcDecrypt(keyBuffer("000102030405060708090a0b0c0d0e0f"), 128, iv, hexBytes("206b11d984c5a4b466bdb60a9ab95a60641bb77f3297fcf6b3edb887fe5ee3d85241610f5b0362d8851bb799772ec3d489f1ea2ef31adf6e")))
    // A wrong key leaves garbage padding: refused as a bad key, not as a plaintext.
    val wrong = legacyDes3CbcDecrypt(keyBuffer("ff0102030405060708090a0b0c0d0e0f1011121314151617"), iv, hexBytes("57732df288f347d7983b856caa0aa63c7585ae634f082e11024205e17a929f4ba89235c24970a5675229ec4c7c72a594d358e7915c137a20"))
    if (wrong.ok) { println("FAIL wrong 3DES key accepted"); failures = failures + 1 }
    if (failures == 0) println("crypto-legacy: ok")
    if (failures == 0) 0 else 1
}
