// The provider main.ab's import line calls: a package made from text, declaring providedValue.
compile fun resolveProvided(): ResolvedImport = resolvedImport(
    "provided-1",
    "provided.ab",
    [
        importFile("abla.toml", "name = \"provided\"\nversion = \"0.1.0\"\nentry = \"provided.ab\"\n"),
        importFile("provided.ab", "fun providedValue(): int = 3\n")
    ]
)

compile fun providedSource(): ImportSource = importSource("provided", "unused-imports:provided", "v1", resolveProvided)
