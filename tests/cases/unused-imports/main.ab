// tools/test-unused-imports.sh: abla/io is used (println), abla/text only through an extension method (trim), abla/fs
// through a class it re-exports (Path, from abla/sys/linux/fs), ./sub.ab for a function, ./exported.ab has an @export
// function; abla/json and ./helper.ab are imported and not used: the two warnings.
import "abla/io"
import "abla/text"
import "abla/fs"
import "abla/json"
import "./helper.ab"
import "./sub.ab"
import "./exported.ab"

fun main: int {
    val name = Path("x").text
    println(" ${name.trim()} ${subValue()}")
    0
}
