// A library on its own has no `fun main`: its build ends at E_NO_MAIN, an IR error after every use is known, so
// abla/json still gets W_UNUSED_IMPORT and fix-imports --prune removes it (abla/text is used, by `trim`).
import "abla/json"
import "abla/text"

fun libraryTrim(value: string): string = value.trim()
