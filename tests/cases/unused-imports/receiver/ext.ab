// Never called. shape.ab: the receiver of `fun Shape.area`; box.ab: `fun Box<int>.doubled` (receiver with type
// arguments); pair.ab: `fun <T> Pair<T>.held` (generic receiver); point.ab: only an extension's result type.
import "./shape.ab"
import "./box.ab"
import "./pair.ab"
import "./point.ab"

fun Shape.area(): int = this.side * this.side
fun Box<int>.doubled(): int = this.item * 2
fun <T> Pair<T>.held(): T = this.first
fun int.toPoint(): Point = Point(this)
fun extValue(): int = 3
