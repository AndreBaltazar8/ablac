// Defines syntax: `$seven()` becomes a call of helper.ab's syntaxHelperSeven. No name here uses helper.ab, but the
// module keeps its imports (it registers a subparser): no W_UNUSED_IMPORT for ./helper.ab.
import "abla/compiler"
import "abla/compiler/parser"
import "./helper.ab"

compile fun parseSeven(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    val arguments: array<SyntaxExpression> = []
    syntaxCall("syntaxHelperSeven", arguments)
}

#compilerRegisterSubparser("seven", parseSeven)
