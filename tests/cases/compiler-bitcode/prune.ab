import "../../../src/toolchain.ab"

// Compare the existing textual pruning with the direct module walk, including
// roots through globals, aliases, constant expressions, text and assembly.
trusted fun main(): int {
    if (linuxArgumentCount() != 3) return 1
    val input = linuxArgument(0)
    if (!Path(linuxArgument(1)).writeText(
        bootstrapLlvmWithoutDeadFunctions(Path(input).readText())
    )) return 2
    val empty = nativeNullPointer()
    val buffer = nativePointerCell(empty)
    val message = nativePointerCell(empty)
    val module = nativePointerCell(empty)
    val context = LLVMContextCreate()
    var status = LLVMCreateMemoryBufferWithContentsOfFile(
        input, buffer.address, message.address
    )
    if (status == 0) status = LLVMParseIRInContext(
        context, buffer.load(), module.address, message.address
    )
    if (status == 0) {
        bootstrapLlvmHeldContext = context
        bootstrapLlvmHeldModule = module.load()
        bootstrapLlvmInlineAssembly = [".quad abla_fn_asm"]
        bootstrapPruneHeldCompilerModule()
        status = LLVMVerifyModule(module.load(), 2, message.address)
        if (status == 0) status = LLVMWriteBitcodeToFile(
            module.load(), linuxArgument(2)
        )
        bootstrapDisposeHeldModule()
    } else LLVMContextDispose(context)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    buffer.close()
    message.close()
    module.close()
    status
}
