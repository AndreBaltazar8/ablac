// Two `#` sites in a pass that can run long (a loop), so auto gives its sites a trial in the evaluator first
// (tools/test-ct-trial-rule.sh): the pure one gets it; the one that reads the environment doesn't, since a trial that
// didn't finish, then its native run, would read it twice (#1042).
import "abla/compiler"
#compilerGrant("environment")

compile fun sum(count: int): int {
    var total = 0
    var index = 0
    while (index < count) {
        total = total + index
        index = index + 1
    }
    total
}

compile fun home(): int = compilerEnvironment("HOME").size + sum(10)

val summed = #sum(100)
val homed = #home()
fun main: int = if (summed == 4950 && homed >= 45) 42 else 1
