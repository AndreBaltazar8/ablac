// The mark of a collection on several threads (ABLA_GC_WORKERS=n, tools/test-gc-parallel.sh): a graph with much sharing, so that
// two threads reach the same object at once (an object claimed twice is traced twice: a trap), a frozen group that very many live
// objects point at (the group's reached flag is set by every thread that finds it: it must stay set and the group must stay
// intact), and garbage made between the collections. The argument is the number of objects (a stress run uses a few thousand).
import "abla/io"
import "abla/memory"
import "abla/process/arguments"
import "abla/runtime/memory"
import "abla/text"

class Hub(val name: string, val weights: array<int>)
class Item(val id: int, val first: Hub, val second: Hub, val third: Hub, val tags: array<string>, var link: Item?)

fun decimal(text: string): int {
    var value = 0
    for (byte in text) value = value * 10 + byte - 48
    value
}

fun buildHubs(count: int): array<Hub> {
    val hubs: array<Hub> = []
    for (index in 0 until count) {
        val weights: array<int> = []
        for (step in 0 until 8) weights.append(index * 8 + step)
        hubs.append(Hub("hub-$index-with-a-longer-name-than-the-small-sizes", weights))
    }
    hubs
}

fun checksum(items: array<Item>): int {
    var total = 0
    for (item in items) {
        total = total + item.id + item.first.weights[3] + item.second.weights[5] + item.third.name.size + item.tags[1].size
        val link = item.link
        if (link != null) total = total + link.id
    }
    total
}

fun main: int {
    memorySetBackgroundFree(true)
    var count = 200000
    if (processArgumentCount() > 0) count = decimal(processArgument(0))
    val hubs = buildHubs(97)
    val frozenHubs = Frozen(buildHubs(31)).get()
    val items: array<Item> = []
    for (index in 0 until count) {
        val tags: array<string> = ["tag-$index", "second-$index-xx"]
        items.append(Item(index, hubs[index % 97], hubs[(index * 7 + 3) % 97], frozenHubs[index % 31], tags, null))
    }
    // A chain through the items too, so that the work does not split at the start only.
    for (index in 1 until count) items[index].link = items[index - 1]
    val expected = checksum(items)
    for (round in 0 until 8) {
        val garbage: array<string> = []
        for (index in 0 until count / 4) garbage.append("garbage-$round-$index-padding-to-be-freed")
        memoryCollect()
    }
    val after = checksum(items)
    if (after != expected) {
        println("FAIL: the checksum changed: $after against $expected")
        return 1
    }
    for (index in 0 until 31) {
        if (frozenHubs[index].name != "hub-$index-with-a-longer-name-than-the-small-sizes" || frozenHubs[index].weights[7] != index * 8 + 7) {
            println("FAIL: frozen hub $index differs")
            return 1
        }
    }
    if (memoryHeapStat(11) == 0) {
        println("FAIL: nothing was frozen (reason ${memoryHeapStat(12)})")
        return 1
    }
    println("gc parallel ok: $expected")
    0
}
