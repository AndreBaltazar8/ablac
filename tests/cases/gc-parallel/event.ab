// An event HTTP server turns on background freeing and four collection threads by default (httpEventServerCollector in
// stdlib/abla/http/event; ABLA_GC_WORKERS overrides): a program that only makes one and then collects a heap of some size runs
// the parallel mark and sweep (tools/test-gc-parallel.sh checks the trace, and that ABLA_GC_WORKERS=0 turns it off). The heap has over
// 262,144 registry slots: a program that asked for threads (not the environment) collects a smaller heap serially (host.ab, adaptive use).
import "abla/http"
import "abla/http/event"
import "abla/io"
import "abla/memory"
import "abla/net"

fun main: int {
    val server = httpEventServer(httpRouter(), ipv4Loopback(0))
    val live: array<string> = []
    for (index in 0 until 400000) {
        if (index % 2 == 0) live.append("event-live-$index-padding-to-be-sure-it-is-a-heap-string")
        else {
            val garbage = "event-garbage-$index-padding-to-be-freed-by-the-sweep"
            if (garbage.size == 0) live.append(garbage)
        }
    }
    memoryCollect()
    memoryCollect()
    var sum = 0
    for (text in live) sum = sum + text.size
    if (server.listener.descriptor < 0) return 1
    println("event gc ok: $sum")
    0
}
