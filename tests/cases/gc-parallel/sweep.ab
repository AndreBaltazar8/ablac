// The parallel sweep (ABLA_GC_WORKERS=n, tools/test-gc-parallel.sh): the registry is cut into slices and swept by several threads, then
// made dense again by a serial move (a prefix of the kept counts) and its headers get their new indexes. The slices are uneven here:
// a run of garbage followed by a run of live objects (the first slices keep nothing, the last keep everything), a run of live ones
// followed by garbage (the opposite) and one where they alternate. A stress run (ABLA_GC_STRESS=1) checks after every parallel
// sweep that each kept header's index is its slot; the program checks what it kept. The argument is the size of a run.
import "abla/io"
import "abla/memory"
import "abla/process/arguments"
import "abla/runtime/memory"
import "abla/text"

fun decimal(text: string): int {
    var value = 0
    for (byte in text) value = value * 10 + byte - 48
    value
}

fun fill(garbageCount: int, liveCount: int, liveFirst: bool, alternate: bool, tag: string): array<string> {
    val live: array<string> = []
    if (alternate) {
        for (index in 0 until garbageCount + liveCount) {
            if (index % 2 == 0) live.append("$tag-live-$index-padding-to-be-sure-it-is-a-heap-string")
            else {
                val garbage = "$tag-garbage-$index-padding-to-be-freed-by-the-sweep"
                if (garbage.size == 0) live.append(garbage)
            }
        }
        return live
    }
    if (liveFirst) for (index in 0 until liveCount) live.append("$tag-live-$index-padding-to-be-sure-it-is-a-heap-string")
    for (index in 0 until garbageCount) {
        val garbage = "$tag-garbage-$index-padding-to-be-freed-by-the-sweep"
        if (garbage.size == 0) live.append(garbage)
    }
    if (!liveFirst) for (index in 0 until liveCount) live.append("$tag-live-$index-padding-to-be-sure-it-is-a-heap-string")
    live
}

fun check(live: array<string>, tag: string, count: int): int {
    var total = 0
    for (index in 0 until live.size) {
        val text = live[index]
        if (!text.startsWith("$tag-live-")) {
            println("FAIL: ${tag}: element $index is $text")
            return -1
        }
        total = total + text.size
    }
    total
}

fun main: int {
    memorySetBackgroundFree(true)
    memorySetCollectionGrowth(1073741824)
    var count = 60000
    if (processArgumentCount() > 0) count = decimal(processArgument(0))
    var sum = 0
    for (shape in 0 until 3) {
        val tag = "s$shape"

        val live = fill(count, count, shape == 1, shape == 2, tag)
        memoryCollect()
        memoryCollect()
        val total = check(live, tag, count)
        if (total < 0) return 1
        if (live.size != count) {
            println("FAIL: $tag kept ${live.size}")
            return 1
        }
        sum = sum + total
    }
    println("gc parallel sweep ok: $sum")
    0
}
