// An arm shared by `is` patterns only (`is A, is B -> ...`) sees a nullable subject not null wherever it stands, as a
// lone `is` arm does (decision #166): before the `null` arm, after it, and without one when the subject is not nullable
// (the control). The same total at run time and at compile time.
import "abla/io"

sealed interface Shape {
    fun tag(): int
}
interface Round : Shape
class Circle(val r: int) : Round {
    fun tag(): int = this.r * 3 + 1
}
class Ring(val outer: int) : Round {
    fun tag(): int = this.outer * 5 + 2
}
class Square(val side: int) : Shape {
    fun tag(): int = this.side * 7 + 3
}

// the group before `null`
fun before(s: Shape?): int = when (s) {
    is Circle, is Square -> s.tag()
    null -> -1
    is Ring -> s.outer
}

// the group after `null`
fun after(s: Shape?): int = when (s) {
    null -> -2
    is Ring -> s.outer * 10
    is Circle, is Square -> s.tag() + 100
}

// a group with an interface covering two classes, the only arm beside `null`
fun mixed(s: Shape?): int = when (s) {
    is Round, is Square -> s.tag() * 2
    null -> -3
}

// the control: a subject that is not nullable
fun plain(s: Shape): int = when (s) {
    is Circle, is Ring -> s.tag()
    is Square -> s.side
}

fun score(): int {
    val shapes: array<Shape?> = [Circle(2), null, Ring(3), Square(4)]
    var total = 0
    for (s in shapes) total = total * 31 + before(s) * 7 + after(s) * 3 + mixed(s)
    total * 31 + plain(Circle(1)) + plain(Ring(2)) * 5 + plain(Square(3)) * 11
}

val atCompileTime = #score()

fun main(): int {
    val now = score()
    println("$now $atCompileTime")
    if (now == atCompileTime) 0 else 1
}
