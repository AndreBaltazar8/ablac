// An arm shared with `null` (`is A, null -> ...`) is not narrowed: the subject can be null there.
sealed interface Shape
class Circle(val r: int) : Shape
class Square(val side: int) : Shape
fun bad(s: Shape?): int = when (s) {
    is Circle, null -> s.r
    is Square -> s.side
}
fun main: int = bad(Circle(1))
