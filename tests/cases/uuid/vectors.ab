import "uuid-copy.ab"
import "abla/text"

fun main: int {
    // RFC 9562 appendix A.3: version and variant replace random bits.
    val v4 = uuidV4From("\x91\x91\x08\xf7\x52\xd1\x33\x20\x5b\xac\xf8\x47\xdb\x41\x48\xa8")
    if (v4 == null || v4.toString() != "919108f7-52d1-4320-9bac-f847db4148a8") return 1
    // Appendix A.6: 1645557742000 milliseconds and the example random fields.
    val v7 = uuidV7From(1645557742000, "\x0c\xc3\x18\xc4\xdc\x0c\x0c\x07\x39\x8f")
    if (v7 == null || v7.toString() != "017f22e2-79b0-7cc3-98c4-dc0c0c07398f") return 2
    if (uuidV4From("short") != null || uuidV7From(-1, "x".repeat(10)) != null ||
        uuidV7From(281474976710656, "x".repeat(10)) != null || uuidV7From(0, "x") != null) return 3
    val first = uuidV7From(100, "\xff".repeat(10))
    val second = uuidV7From(100, "\x00".repeat(10))
    if (first == null || second == null || int(first.toBytes()[6]) <= int(second.toBytes()[6])) return 4
    42
}
