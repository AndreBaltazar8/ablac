import "abla/uuid"
@export("checks")
fun checks(): int {
    val value = uuidParse("919108f7-52d1-4320-9bac-f847db4148a8")
    if (value == null || value.toString() != "919108f7-52d1-4320-9bac-f847db4148a8") return 1
    if (uuidParse("broken") != null || uuidV4() != null || uuidV7() != null) return 2
    0
}
