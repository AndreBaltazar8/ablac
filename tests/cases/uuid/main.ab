import "abla/uuid"
import "abla/text"
import "abla/process/time"

fun main: int {
    val parsed = uuidParse("01890F3E-7B3C-7CC3-98C4-DC0C0C07398F")
    if (parsed == null) return 1
    if (parsed.toString() != "01890f3e-7b3c-7cc3-98c4-dc0c0c07398f") return 2
    val copy = uuidFromBytes(parsed.toBytes())
    if (copy == null || !copy.equals(parsed) || copy.toBytes().size != 16) return 3
    if (uuidFromBytes("short") != null || uuidFromBytes("x".repeat(17)) != null) return 4
    for (invalid in ["", "01890f3e7b3c7cc398c4dc0c0c07398f", " 01890f3e-7b3c-7cc3-98c4-dc0c0c07398f", "01890f3e_7b3c-7cc3-98c4-dc0c0c07398f", "01890f3e-7b3c-7cc3-98c4-dc0c0c07398g", "01890f3e-7b3c-7cc3-98c4-dc0c0c0739é"]) {
        if (uuidParse(invalid) != null) return 5
    }
    val nil = uuidParse("00000000-0000-0000-0000-000000000000")
    if (nil == null || nil.equals(parsed)) return 6
    val max = uuidParse("ffffffff-ffff-ffff-ffff-ffffffffffff")
    if (max == null || max.toString() != "ffffffff-ffff-ffff-ffff-ffffffffffff") return 11
    if (Uuid().toString() != "00000000-0000-0000-0000-000000000000") return 12
    val before = realtimeMilliseconds()
    for (i in 0 until 40) {
        val a = uuidV4()
        val b = uuidV7()
        if (a == null || b == null) return 7
        val ab = a.toBytes()
        val bb = b.toBytes()
        if ((int(ab[6]) & 240) != 64 || (int(ab[8]) & 192) != 128 ||
            (int(bb[6]) & 240) != 112 || (int(bb[8]) & 192) != 128) return 8
        var timestamp = 0
        for (j in 0 until 6) timestamp = timestamp * 256 + int(bb[j])
        if (timestamp < before - 5000 || timestamp > realtimeMilliseconds() + 5000) return 9
        val decoded = uuidParse(b.toString())
        if (decoded == null || !decoded.equals(b)) return 10
    }
    42
}
