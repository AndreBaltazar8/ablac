import "abla/process/command"
class Counter(var value: int) {
    fun add(n: int): borrow(this) Counter { this.value = this.value + n; this }
}
fun main: int {
    val counter = Counter(0)
    counter.add(1).add(2).add(3)
    val run = command("printf")
    run.environment("ABLA_CHAIN_A", "1").environment("ABLA_CHAIN_B", "2").argument("ok")
    val result = run.capture()
    if (counter.value == 6 && result.status == 0 && result.output == "ok") 0 else 1
}
