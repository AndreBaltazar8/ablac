class Counter(var value: int, val children: array<Counter>) {
    fun choose(flag: bool): borrow(this) Counter {
        this.value = this.value + 1
        if (flag) return this.children[0]
        this
    }
    fun add(): borrow(this) Counter { this.value = this.value + 1; this }
}
fun main: int {
    val counter = Counter(0, [Counter(0, [])])
    counter.choose(true).add()
    0
}
