// Prints a TCP port on 127.0.0.1 that the system just handed out and released, for
// tools/test-android-rpc-example.sh (tests run in parallel, and 18080 may be taken).
import "abla/io"
import "abla/net/hosted"

fun main: int {
    val listener = hostedTcpListen("127.0.0.1", 0, 1, false)
    val port = listener.localPort()
    listener.close()
    if (port <= 0) return 1
    println("$port")
    0
}
