// The blocking HTTP server (serveHttpOnListenerWith) on an ephemeral loopback port with the deadlines given as arguments, for tools/test-http-serve.sh: prints the
// port, then serves until it is killed. Arguments: firstByte head request response, in milliseconds (0 turns a deadline off).
import "abla/io"
import "abla/http"
import "abla/integer"
import "abla/net"
import "abla/process/arguments"
import "abla/text"

fun hello(request: HttpRequest): HttpResponse = httpText("hello")
fun big(request: HttpRequest): HttpResponse = httpText("y".repeat(24000000))
fun echo(request: HttpRequest): HttpResponse = httpText("${request.body.size}")

fun number(index: int, fallback: int): int =
    if (index < processArgumentCount()) processArgument(index).parseInt() ?? fallback else fallback

fun main: int {
    val router = httpRouter()
    router.get("/", hello)
    router.get("/big", big)
    router.post("/echo", echo)
    val options = HttpServeOptions(number(0, 10000), number(1, 30000), number(2, 120000), number(3, 30000), 65536, 1048576)
    val listener = tcpListenAddress(ipv4Loopback(0))
    println("${listener.localPort()}")
    serveHttpOnListenerWith(router, listener, options)
}
