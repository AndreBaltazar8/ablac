import "abla/android/build"
import "abla/compiler"

#compilerGrant("filesystem.write")
#compilerGrant("environment")
#compilerGrant("filesystem.read")

compile fun androidTestEntry(): string =
    if (compilerEnvironment("ABLA_TEST_ANDROID_IMPORT") == "1") "needs-ndk.ab" else "app.ab"

val built = #androidBuildArm64Library(
    "abla-android-app",
    androidTestEntry(),
    "../../../build/android-extension",
    "org.abla.generated",
    true,
    true
)

fun main: int = if (built) 37 else 1
