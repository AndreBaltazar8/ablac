import "abla/bytes"
import "abla/io"
import "abla/memory"

fun concatenate(count: int, prefix: string, piece: string): string {
    var text = prefix
    var index = 0
    while (index < count) {
        text = text + piece
        index = index + 1
    }
    text
}

fun interpolate(count: int, prefix: string): string {
    var text = prefix
    for (index in 0 until count) text = "${text}:${index}"
    text
}

fun captures(): string {
    var text = "p"
    val snapshots: array<string> = []
    val keep = { -> snapshots.append(text) }
    var index = 0
    while (index < 3) {
        text = text + "x"
        keep()
        index = index + 1
    }
    snapshots[0] + "/" + snapshots[2]
}

fun main: int {
    val prefix = "prefix"
    val piece = "abcdefghijklmnop"
    val expected = bytes(prefix)
    for (index in 0 until 300) expected.appendText(piece)
    if (concatenate(0, prefix, piece) != prefix ||
        concatenate(300, prefix, piece) != expected.toText()) return 1
    val numbers = bytes(prefix)
    for (index in 0 until 300) {
        numbers.appendText(":")
        numbers.appendInt(index)
    }
    val escaped = region { memoryPromoteString(interpolate(300, prefix)) }
    if (escaped != numbers.toText() || captures() != "px/pxxx") return 2
    println("string building ok")
    0
}
