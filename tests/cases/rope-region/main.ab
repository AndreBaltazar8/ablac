// A global string built by concatenation is a rope, flattened on its first read. When that first read happens inside a
// region, the flat copy must not be allocated in it (the region frees it, and the global then reads freed memory): the
// copy lives as long as the rope. Three shapes (a global `val`, a global `var` assigned later, an element of a global array),
// each first read inside a region and read again after the region ends and its memory has been reused.
import "abla/io"

fun piece(index: int): string = "piece-${index}-"

fun built(count: int): string {
    var text = ""
    for (index in 0 until count) text = text + piece(index)
    text
}

val globalValue = built(40)
var globalVariable = ""
val globalArray: array<string> = [built(30), built(50)]

fun scratchSum(round: int): int {
    val scratch = built(60 + round)
    var sum = 0
    for (index in 0 until 20) sum = sum + (scratch + "x").size
    sum
}

fun main: int {
    globalVariable = built(25) + built(26)
    var bad = 0
    // the first reads, inside a region
    val first = region {
        var ok = 0
        if (globalValue == built(40)) ok = ok + 1
        if (globalVariable == built(25) + built(26)) ok = ok + 1
        if (globalArray[0] == built(30) && globalArray[1] == built(50)) ok = ok + 1
        ok
    }
    if (first != 3) bad = bad + 1
    // the region's memory is reused, then the globals are read again
    for (round in 0 until 100) {
        region { scratchSum(round) }
    }
    if (globalValue != built(40)) bad = bad + 1
    if (globalVariable != built(25) + built(26)) bad = bad + 1
    if (globalArray[0] != built(30) || globalArray[1] != built(50)) bad = bad + 1
    if (bad != 0) {
        println("FAIL: $bad")
        return 1
    }
    println("rope region ok")
    0
}
