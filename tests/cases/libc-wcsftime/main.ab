// __wcsftime_l of the statically linked compiler's C library (src/static_libc/wcsftime.ab, #806 step C): the wide-character strftime, with the
// conversions strftime knows, wide characters beyond ASCII copied through, and a result that does not fit giving 0. The program exits 42.
import "abla/io"
import "abla/runtime/scalar"
import "../../../src/static_libc/wcsftime.ab"
import "../../../src/static_libc/time.ab"
import "../../../src/static_libc/memory.ab"

var failures = 0

trusted fun wide(values: array<int>): int {
    val at = libcMalloc((values.size + 1) * 4)
    var i = 0
    while (i < values.size) {
        ablaRuntimeStoreI32(at + i * 4, values[i])
        i += 1
    }
    ablaRuntimeStoreI32(at + values.size * 4, 0)
    at
}

trusted fun narrow(address: int, count: int): array<int> {
    var out: array<int> = []
    var i = 0
    while (i < count) {
        out.append(ablaRuntimeLoadI32(address + i * 4))
        i += 1
    }
    out
}

trusted fun main: int {
    // 2024-03-05 14:07:09, a Tuesday, day 64 of the year (0-based 64).
    val tm = libcMalloc(64)
    var i = 0
    while (i < 64) { ablaRuntimeStoreU8(tm + i, 0); i += 1 }
    val seconds = libcMalloc(8)
    ablaRuntimeStoreI64(seconds, 1709647629)
    libcLocaltimeR(seconds, tm)
    val buffer = libcMalloc(256)
    // "%Y-%m-%d %H:%M:%S é€" with an e-acute and a euro sign.
    val format = wide([37, 89, 45, 37, 109, 45, 37, 100, 32, 37, 72, 58, 37, 77, 58, 37, 83, 32, 233, 8364])
    val count = libcWcsftimeL(buffer, 64, format, tm, 0)
    val text = narrow(buffer, count)
    val expected = [50, 48, 50, 52, 45, 48, 51, 45, 48, 53, 32, 49, 52, 58, 48, 55, 58, 48, 57, 32, 233, 8364]
    if (!same(text, expected) || ablaRuntimeLoadI32(buffer + count * 4) != 0) { failures += 1; println("libc-wcsftime: wrong text (${text.size} characters)") }
    // Names and the percent sign.
    val names = wide([37, 65, 32, 37, 66, 32, 37, 37])
    val n2 = libcWcsftimeL(buffer, 64, names, tm, 0)
    // "Tuesday March %"
    if (!same(narrow(buffer, n2), [84, 117, 101, 115, 100, 97, 121, 32, 77, 97, 114, 99, 104, 32, 37])) { failures += 1; println("libc-wcsftime: names (${n2} characters)") }
    // It fits in exactly size 20 (19 wide characters and the terminator) and not in 19.
    val date = wide([37, 70, 32, 37, 84])
    if (libcWcsftimeL(buffer, 20, date, tm, 0) != 19) { failures += 1; println("libc-wcsftime: exact fit") }
    if (libcWcsftimeL(buffer, 19, date, tm, 0) != 0) { failures += 1; println("libc-wcsftime: too small must give 0") }
    if (libcWcsftimeL(buffer, 0, date, tm, 0) != 0) { failures += 1; println("libc-wcsftime: size 0 must give 0") }
    // An empty format is an empty string.
    if (libcWcsftimeL(buffer, 4, wide([]), tm, 0) != 0 || ablaRuntimeLoadI32(buffer) != 0) { failures += 1; println("libc-wcsftime: empty") }
    if (failures == 0) { println("libc wcsftime: ok"); return 42 }
    1
}

fun same(a: array<int>, b: array<int>): bool {
    if (a.size != b.size) return false
    var i = 0
    while (i < a.size) {
        if (a[i] != b[i]) return false
        i += 1
    }
    true
}
