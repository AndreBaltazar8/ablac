import "abla/build"

fun increment(value: i32): i32 = value + i32(1)

fun choose(value: i32, fallback: i32 = i32(40)): i32 =
    if (value > i32(0)) value else fallback

val linked = #internalFunction("increment", "abla_test_increment")
val linkedDefault = #internalFunction("choose", "abla_test_choose")

fun main: int = if (
    linked && linkedDefault &&
    increment(i32(1)) == i32(2) &&
    choose(i32(-1)) == i32(40)
) 0 else 1
