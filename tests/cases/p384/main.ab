// P-384 verification against Wycheproof's ECDSA (secp384r1, SHA-384) vectors, parsed with abla/json. Argument 0 is the
// directory of the vectors.
import "abla/crypto"
import "abla/crypto/p384"
import "abla/fs"
import "abla/io"
import "abla/json"
import "abla/process/arguments"

fun main: int {
    val parsed = jsonParse(path(processArgument(0) + "/ecdsa_secp384r1_sha384_test.json").readText())
    if (!parsed.succeeded) {
        println("p384: cannot read the vectors")
        return 2
    }
    val groups = parsed.value.get("testGroups")
    var failures = 0
    var count = 0
    var accepted = 0
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val key = hexDecode(group.get("publicKey").getString("uncompressed"))
        check(p384IsValidPublicKey(key))
        val tests = group.get("tests")
        for (t in 0 until tests.size()) {
            val test = tests.at(t)
            val id = test.getInt("tcId")
            val ok = p384EcdsaVerify(key, hexDecode(test.getString("msg")), hexDecode(test.getString("sig")))
            val verdict = test.getString("result")
            count = count + 1
            if (ok) accepted = accepted + 1
            if (verdict == "valid" && !ok) {
                println("p384: FAIL tcId $id (valid) was refused")
                failures = failures + 1
            }
            if (verdict == "invalid" && ok) {
                println("p384: FAIL tcId $id (invalid) was accepted")
                failures = failures + 1
            }
        }
    }
    println("p384: ECDSA Wycheproof $count vectors, $accepted accepted")
    if (failures != 0 || count < 300) return 1
    println("p384: ok")
    0
}

fun check(ok: bool): void {
    if (!ok) println("p384: FAIL a key in the vectors is not a point of the curve")
    return
}
