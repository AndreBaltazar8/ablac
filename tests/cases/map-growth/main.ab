import "abla/io"
import "abla/array"

// A map grows through its rehash: the entry arrays are kept when nothing was removed (the slots alone are
// rebuilt) and compacted when something was. Against a reference of two plain arrays and a linear scan:
// int keys and string keys, inserts, overwrites, removals between the growths, the size, the
// order of keys() (insertion order of the live keys) and every lookup.
class Reference(val keys: array<int>, val values: array<int>)

fun find(reference: Reference, key: int): int {
    var found = -1
    var index = 0
    while (found < 0 && index < reference.keys.size) {
        if (reference.keys[index] == key) found = index
        index = index + 1
    }
    found
}

fun checkInts(count: int, removeEvery: int): int {
    val map: Map<int, int> = Map()
    val reference = Reference([], [])
    var bad = 0
    var i = 0
    while (i < count) {
        val key = (i * 7919) % (count * 2 + 1) - count
        val at = find(reference, key)
        if (at >= 0) reference.values[at] = i else {
            reference.keys.append(key)
            reference.values.append(i)
        }
        map.set(key, i)
        if (removeEvery > 0 && i % removeEvery == removeEvery - 1) {
            val victim = reference.keys[(i * 3) % reference.keys.size]
            val place = find(reference, victim)
            reference.keys.removeAt(place)
            reference.values.removeAt(place)
            map.remove(victim)
        }
        i = i + 1
    }
    if (map.size != reference.keys.size) bad = bad + 1
    var k = 0
    while (k < reference.keys.size) {
        val got = map.get(reference.keys[k])
        if (got == null || got != reference.values[k]) bad = bad + 1
        k = k + 1
    }
    val order = map.keys()
    if (order.size != reference.keys.size) bad = bad + 1
    else {
        var o = 0
        while (o < order.size) {
            if (order[o] != reference.keys[o]) bad = bad + 1
            o = o + 1
        }
    }
    if (map.get(count * 5 + 3) != null) bad = bad + 1
    bad
}

fun checkStrings(count: int, removeEvery: int): int {
    val map: Map<string, int> = Map()
    val keys: array<string> = []
    val values: array<int> = []
    var bad = 0
    var i = 0
    while (i < count) {
        val key = "k${(i * 31) % (count + 7)}"
        var at = -1
        var j = 0
        while (at < 0 && j < keys.size) {
            if (keys[j] == key) at = j
            j = j + 1
        }
        if (at >= 0) values[at] = i else {
            keys.append(key)
            values.append(i)
        }
        map.set(key, i)
        if (removeEvery > 0 && i % removeEvery == removeEvery - 1) {
            val place = (i * 5) % keys.size
            map.remove(keys[place])
            keys.removeAt(place)
            values.removeAt(place)
        }
        i = i + 1
    }
    if (map.size != keys.size) bad = bad + 1
    var k = 0
    while (k < keys.size) {
        val got = map.get(keys[k])
        if (got == null || got != values[k]) bad = bad + 1
        k = k + 1
    }
    val order = map.keys()
    var o = 0
    while (o < order.size && o < keys.size) {
        if (order[o] != keys[o]) bad = bad + 1
        o = o + 1
    }
    if (map.get("absent") != null) bad = bad + 1
    bad
}

fun main: int {
    var bad = 0
    for (count in [1, 3, 5, 9, 17, 40, 130, 520, 2100]) {
        bad = bad + checkInts(count, 0) + checkInts(count, 5) + checkInts(count, 2)
        bad = bad + checkStrings(count, 0) + checkStrings(count, 7)
    }
    println("bad $bad")
    if (bad == 0) 42 else 1
}
