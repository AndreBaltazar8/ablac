import "abla/io"

// _setjmp/_longjmp as an x86-64 Linux executable defines them itself (#806): a
// transaction's alternative that retries leaves its attempt with _longjmp from
// three frames down, and the frames in between hold values in callee-saved
// registers (eight live integers each, changed after every call) that the jump
// must put back as _setjmp saw them in the frame that resumes.

var visits: int by TVar(0)

fun deepest(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int {
    visits += 1
    val keep = a * 3 + b * 5 + c * 7 + d * 11 + e * 13 + f * 17 + g * 19 + h * 23
    if (visits >= 0) retry
    keep
}

fun middle(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int {
    val first = deepest(a + 1, b + 2, c + 3, d + 4, e + 5, f + 6, g + 7, h + 8)
    a + b + c + d + e + f + g + h + first
}

fun outer(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int {
    val first = middle(a * 2, b * 2, c * 2, d * 2, e * 2, f * 2, g * 2, h * 2)
    a + b + c + d + e + f + g + h + first
}

fun attempt(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int = atomic {
    outer(a, b, c, d, e, f, g, h)
} orElse {
    // Resumed after the jump: every value must be as it was at the setjmp.
    a * 1 + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000
}

fun main: int {
    var failures = 0
    for (round in 0 until 50) {
        val got = attempt(1, 2, 3, 4, 5, 6, 7, 8 + round)
        val want = 1 + 20 + 300 + 4000 + 50000 + 600000 + 7000000 + (8 + round) * 10000000
        if (got != want) failures += 1
    }
    println("libc jump routines: ${50 - failures} of 50 rounds agree")
    if (failures == 0) 42 else 1
}
