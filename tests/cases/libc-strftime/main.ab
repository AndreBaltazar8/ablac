// The Abla side of tools/test-libc-strftime.sh (#1139 area 14): the static libc's strftime (src/static_libc/time.ab, copied without its @export
// lines to build/libc-strftime/libc) on the cases tests/cases/libc-strftime/strftime.c writes ("size<TAB>formathex<TAB>tm fields"), printed as that
// program prints the host C library's: "return<TAB>hex of the buffer". The format sits at the start of a page-sized block whose bytes after
// its NUL are "%Y%Y%Y...", so a strftime that steps past the terminator writes years the host's does not.
import "abla/io"
import "abla/integer"
import "abla/text"
import "abla/runtime/scalar"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "./libc/time.ab"

fun number(text: string): int {
    val parsed = text.parseInt()
    if (parsed != null) parsed else 0
}

fun hexValue(c: int): int = if (c >= 97) c - 87 else if (c >= 65) c - 55 else c - 48

fun hexByte(b: int): string {
    val digits = "0123456789abcdef"
    digits.slice(b >> 4, (b >> 4) + 1) + digits.slice(b & 15, (b & 15) + 1)
}

trusted fun run(size: int, formatHex: string, fields: string): string {
    val count = formatHex.size / 2
    val format = ablaUnsafePointerAddress(ablaUnsafeAllocate(4096))
    for (i in 0 until 4096) ablaRuntimeStoreU8(format + i, if (i % 2 == 0) 37 else 89)
    for (i in 0 until count) ablaRuntimeStoreU8(format + i, hexValue(formatHex[2 * i]) * 16 + hexValue(formatHex[2 * i + 1]))
    ablaRuntimeStoreU8(format + count, 0)
    ablaRuntimeStoreU8(format + 4095, 0)
    val tm = ablaUnsafePointerAddress(ablaUnsafeAllocate(56))
    val values = fields.split(" ")
    for (i in 0 until 8) ablaRuntimeStoreI32(tm + 4 * i, if (i < values.size) number(values[i]) else 0)
    ablaRuntimeStoreI32(tm + 32, 0)
    ablaRuntimeStoreI64(tm + 40, 0)
    ablaRuntimeStoreI64(tm + 48, 0)
    val buffer = ablaUnsafePointerAddress(ablaUnsafeAllocate(size + 1))
    val result = libcStrftime(buffer, size, format, tm)
    var out = "$result\t"
    for (i in 0 until result) out = out + hexByte(ablaRuntimeLoadU8(buffer + i))
    out
}

fun main: int {
    var running = true
    while (running) {
        val line = readInputLine()
        if (!line.available) running = false
        else if (line.text.size > 0) {
            val parts = line.text.split("\t")
            println(run(number(parts[0]), parts[1], if (parts.size > 2) parts[2] else ""))
        }
    }
    0
}
