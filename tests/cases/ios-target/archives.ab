import "abla/build"
import "abla/ios/build"

compile fun buildIosArchives(): bool {
    val device = iosDeviceTarget()
    val simulator = iosSimulatorTarget()
    val deviceArchive = buildProgram(
        "ios-device-archive",
        "tests/cases/ios-target/answer.ab",
        "build/ios-target-test/device/libabla_app.a",
        device,
        "static-library",
        true,
        false
    )
    val simulatorArchive = buildProgram(
        "ios-simulator-archive",
        "tests/cases/ios-target/answer.ab",
        "build/ios-target-test/simulator/libabla_app.a",
        simulator,
        "static-library",
        true,
        false
    )
    deviceArchive && simulatorArchive
}

val built = #buildIosArchives()
fun main(): int = if (built) 0 else 1
