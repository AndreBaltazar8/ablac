import "abla/build"
import "abla/compiler"
import "abla/process/command"
import "abla/unsafe/native/function-address"
#compilerGrant("process.io")
#compilerGrant("trusted.native")

fun compileOnlyCallback(): int = command("true").run()
trusted fun prepareCallback(): int {
    val address = nativeFunctionAddress(compileOnlyCallback)
    if (address == 0) 0 else 42
}
val prepared = #prepareCallback()
fun iosAvailability(): int = prepared
val exported = #exportFunction("iosAvailability", "abla_ios_availability")
