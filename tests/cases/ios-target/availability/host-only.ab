import "abla/build"
import "abla/compiler"
import "abla/platform/host"
#compilerGrant("process.io")
val hostStatus = #ablaHostRunProcess(["true"])

fun iosAvailability(): int {
    if (ablaHostIsIOS() && !ablaHostIsMacOS() && hostStatus == 0) 42 else 0
}
val exported = #exportFunction("iosAvailability", "abla_ios_availability")
