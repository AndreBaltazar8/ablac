import "abla/build"
import "abla/ios/build"

compile fun buildIosObjects(): bool {
    val device = iosDeviceTarget()
    val simulator = iosSimulatorTarget()
    val deviceObject = buildProgram(
        "ios-device-object",
        "tests/cases/ios-target/answer.ab",
        "build/ios-target-test/device.o",
        device,
        "object",
        true,
        false
    )
    val simulatorObject = buildProgram(
        "ios-simulator-object",
        "tests/cases/ios-target/answer.ab",
        "build/ios-target-test/simulator.o",
        simulator,
        "object",
        true,
        false
    )
    deviceObject && simulatorObject
}

val built = #buildIosObjects()
fun main(): int = if (built) 0 else 1
