import "abla/ios/build"
// A package written outside the source file's project is refused before the host is asked about (#1044).
val accepted = #iosCreateXcframework(
    "../../../../outside-ios-target-test/escaped.xcframework",
    ["../../../build/ios-target-test/missing.a"],
    "include"
)
fun main(): int = if (accepted) 0 else 1
