import "answer.ab"
import "abla/build"
import "abla/memory"
import "abla/platform/host"
import "abla/unsafe/native/function-address"

fun iosManagedAnswer(seed: int): int {
    memorySetLimit(16 * 1024 * 1024)
    val values = [seed, seed + 1, seed + 2]
    memoryCollect()
    values[0] + values[1] + values[2]
}
fun iosMemoryLimit(): int = memoryLimit()
fun iosMemoryLive(): int = memoryLiveBytes()
val managedExport = #exportFunction("iosManagedAnswer", "abla_ios_managed_answer")
val limitExport = #exportFunction("iosMemoryLimit", "abla_ios_memory_limit")
val liveExport = #exportFunction("iosMemoryLive", "abla_ios_memory_live")

fun iosTargetCheck(): int = if (ablaHostIsIOS() && !ablaHostIsMacOS()) 42 else 0
val targetExport = #exportFunction("iosTargetCheck", "abla_ios_target_check")

// Closed export reachability must retain interface dispatch, erased values,
// function references, implicit resource drops and native callback adapters.
interface IosShape {
    fun area(): int
}
class IosSquare(val side: int) : IosShape {
    fun area(): int = this.side * this.side
}
var iosDrops = 0
resource class IosTicket(val number: int) {
    fun drop(): void {
        iosDrops = iosDrops + this.number
        return
    }
}
fun iosDropOne(): void {
    val ticket = IosTicket(7)
    return
}
fun iosIncrement(value: int): int = value + 1
fun iosDecrement(value: int): int = value - 1
fun iosManagedPaths(seed: int): int {
    val before = iosDrops
    iosDropOne()
    val shape: IosShape = IosSquare(seed)
    val erased: any = seed + 1
    val displayed = "$erased"
    val action = if (seed > 0) iosIncrement else iosDecrement
    shape.area() + displayed.size +
        action(seed) + iosDrops - before
}
fun iosNativeAddress(): int = nativeFunctionAddress(iosIncrement)
val pathsExport = #exportFunction("iosManagedPaths", "abla_ios_managed_paths")
val addressExport = #exportFunction("iosNativeAddress", "abla_ios_native_address")
