// The peer of tests/cases/http-peer/server.ab for one mode: connects to the listener the
// server announced, sends the request, reads to the end and checks the peer address the
// server reported. Usage: client MODE PORT-OR-SOCKET-PATH CERTIFICATE. Prints `ok MODE`;
// exits 1 with the mismatch on standard error otherwise. TLS trusts the test certificate
// (the server's own, CN=localhost); nothing is unverified.
import "abla/io"
import "abla/process/arguments"
import "abla/sys/linux/net"
import "abla/tls/hosted"
import "abla/text"
import "abla/integer"

val REQUEST = "GET /item/42 HTTP/1.1\r\nHost: localhost\r\nCF-Connecting-IP: 203.0.113.90\r\nX-Forwarded-For: 198.51.100.24\r\nConnection: close\r\n\r\n"

class Reply(val body: string, val port: int)

fun fail(mode: string, what: string): int {
    eprintln("$mode: $what")
    1
}

// The bodies of the responses in `raw`, each cut at its Content-Length.
fun bodies(raw: string): array<string> {
    val found: array<string> = []
    var rest = raw
    while (rest.size > 0) {
        val end = rest.indexOf("\r\n\r\n")
        if (end < 0) return found
        val header = rest.slice(0, end).lowercase()
        val marker = header.indexOf("content-length:")
        if (marker < 0) return found
        var lineEnd = header.indexOf("\r\n", marker)
        if (lineEnd < 0) lineEnd = header.size
        val length = (header.slice(marker + 15, lineEnd).trim().parseInt() ?? -1)
        if (length < 0 || end + 4 + length > rest.size) return found
        found.append(rest.slice(end + 4, end + 4 + length))
        rest = rest.slice(end + 4 + length, rest.size)
    }
    found
}

// One connection to the listener: the request, the whole answer, and the client's own port.
fun exchange(mode: string, target: string, certificate: string, payload: string): Reply {
    val ipv6 = mode.endsWith("6")
    val tls = mode.startsWith("tls")
    val unix = mode == "unix"
    val port = if (unix) 0 else target.parseInt() ?? 0
    var raw = ""
    var localPort = 0
    if (unix) {
        val connection = unixConnect(unixSocketAddress(target))
        if (connection.descriptor < 0) return Reply("", -1)
        connection.write(payload)
        raw = readAll(connection)
        connection.close()
    } else {
        val connection = if (ipv6) tcpConnectIpv6(ipv6Loopback(port)) else tcpConnect(ipv4Loopback(port))
        if (connection.descriptor < 0) return Reply("", -1)
        localPort = if (ipv6) connection.localAddressIpv6().port else connection.localAddress().port
        if (tls) {
            val secure = tlsUpgrade(connection, "localhost", certificate)
            if (secure.handle == -1) return Reply("", -1)
            secure.write(payload)
            raw = readAllTls(secure)
            secure.close()
        } else {
            connection.write(payload)
            raw = readAllTcp(connection)
            connection.close()
        }
    }
    Reply(raw, localPort)
}

fun readAll(connection: UnixConnection): string {
    var text = ""
    while (true) {
        val chunk = connection.read(4096)
        if (chunk == "") return text
        text = "$text$chunk"
    }
    text
}

fun readAllTcp(connection: TcpConnection): string {
    var text = ""
    while (true) {
        val chunk = connection.readWithTimeout(4096, 5000)
        if (chunk == "") return text
        text = "$text$chunk"
    }
    text
}

fun readAllTls(connection: TlsConnection): string {
    var text = ""
    while (true) {
        val chunk = connection.read(4096)
        if (chunk == "") return text
        text = "$text$chunk"
    }
    text
}

fun main: int {
    val mode = processArgument(0)
    val target = processArgument(1)
    val certificate = processArgument(2)
    val pipelined = mode == "event" || mode == "noescape" || mode == "event6" || mode == "noescape6"
    val ipv6 = mode.endsWith("6")
    var payload = REQUEST
    if (mode == "tlsws6") payload = REQUEST.replace("Connection: close", "Connection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==")
    if (pipelined) payload = "${REQUEST.replace("Connection: close", "Connection: keep-alive")}$REQUEST"
    val first = exchange(mode, target, certificate, payload)
    if (first.port < 0) return fail(mode, "could not connect or handshake")
    val received = bodies(first.body)
    // The direct noescape handler bypasses router parameters.
    val direct = mode == "noescape" || mode == "noescape6" || mode == "unix" || mode.startsWith("tls")
    val suffix = "|203.0.113.90|${if (direct) "" else "42"}"
    val family = if (ipv6 || mode == "mapped") 6 else 4
    val address = if (mode == "mapped") "::ffff:7f00:1" else if (ipv6) "::1" else "127.0.0.1"
    val expected = if (mode == "unix") "null$suffix" else "$family|$address|${first.port}|0$suffix"
    val count = if (pipelined) 2 else 1
    if (received.size != count) return fail(mode, "expected $count bodies, got ${received.size}: ${first.body}")
    for (body in received) if (body != expected) return fail(mode, "got `$body`, expected `$expected`")
    if (pipelined) {
        // A new accepted connection can reuse a slot, but never its peer.
        val second = exchange(mode, target, certificate, REQUEST)
        if (second.port < 0) return fail(mode, "second connection failed")
        val reply = bodies(second.body)
        val secondExpected = "$family|$address|${second.port}|0$suffix"
        if (reply.size != 1 || reply[0] != secondExpected) {
            return fail(mode, "second connection: got ${reply.size} bodies, first `${if (reply.size > 0) reply[0] else ""}`, expected `$secondExpected`")
        }
    }
    println("ok $mode")
    0
}
