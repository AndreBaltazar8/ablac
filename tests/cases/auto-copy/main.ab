import "abla/io"
import "abla/process"
import "visible.ab" as visible

class Trace(var events: string)
class Record(val count: int = 0, val note: string? = null, val items: array<int> = []) {
    fun withCount(count: int): Record = this.copy(count = count)
}

fun source(var trace: Trace, items: array<int>): Record {
    trace.events += "r"
    Record(9, "old", items)
}

fun editCount(var trace: Trace): int {
    trace.events += "c"
    7
}

fun editNote(var trace: Trace): string? {
    trace.events += "n"
    null
}

class Written(val n: int) {
    fun copy(n: int): int = this.n + n
}

class Extended(val n: int)
fun Extended.copy(n: int): int = this.n * n

class Callback(val copy: (int) -> int)
fun plusOne(n: int): int = n + 1

private class Local(val n: int)

fun report(): string {
    val trace = Trace("")
    val items = [1, 2]
    val changed = source(trace, items).copy(note = editNote(trace), count = editCount(trace))
    val again = changed.copy()
    val old = Record(4, "keep", items).withCount(5)
    val alias = visible.Value(1, 2).copy(x = visible.Value(0, 3).copy(x = 3).x)
    val written = Written(3).copy(n = 4)
    val extended = Extended(3).copy(n = 4)
    val callback = Callback(plusOne).copy(8)
    val own = Local(5).copy(n = 6)
    "${changed.count} ${changed.note == null} ${changed.items == items} ${changed != again} " +
        "${again.count} ${old.note ?? ""} ${alias.x} ${alias.y} $written $extended $callback ${own.n} ${trace.events}"
}
val STAGED = #report()

compile fun requireCopyCount(count: int) {
    if (count != 12) panic("copy changed the compile-time action result")
}

#requireCopyCount(visible.Value(1, 2).copy(x = 12).x)

fun main {
    println(STAGED)
    println(report())
}
