class Snapshot(val count: int) {
    fun copy(): Snapshot = Snapshot(this.count + 1)
}

class Replay(val snapshot: Snapshot)
class Service(val initial: Snapshot)

fun Service.run(use: bool): int {
    val syntax = if (use) this.initial.copy() else null
    val replay = if (syntax != null) {
        val snapshot = syntax.copy()
        Replay(snapshot)
    } else null
    if (replay != null) replay.snapshot.copy().count else 0
}

fun main: int = if (Service(Snapshot(1)).run(true) == 4) 0 else 1
