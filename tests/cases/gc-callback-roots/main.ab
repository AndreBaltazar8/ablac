// C calls an Abla function that allocates, through a pointer, while the caller holds objects (#1139 area 10, #1279): bsearch (a noescape
// C call with a scalar result, which gets no memory-pressure poll, b6f548d65) calls `compare`, which allocates, so the collector runs
// inside the call. What the caller holds across it (strings, an array, an object built before the call and read after it) must have
// been rooted: ABLA_GC_STRESS=1 collects at every safe point and ABLA_GC_POISON=1 overwrites what a collection frees.
import "abla/io"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native"

noescape extern:"c" fun bsearch(key: i64*, base: i64*, count: i64, size: i64, compare: int): i64

class Held(val name: string, val values: array<int>)

var comparisons = 0

fun expected(index: int): string = "held-$index-${"abc".repeat(40)}"

fun buildStrings(): array<string> {
    val strings: array<string> = []
    for (index in 0 until 32) strings.append(expected(index))
    strings
}

fun buildObject(): Held = Held("object-${"x".repeat(100)}", [1, 2, 3, 4, 5, 6, 7, 8])

/** The comparison C asks for: it allocates (a 20 KB string, so a safe point at its entry may collect), then compares two 64-bit keys. */
trusted fun compare(left: int, right: int): int {
    val garbage = "y".repeat(20000)
    comparisons = comparisons + garbage.size % 2 + 1
    val a = ablaUnsafeLoadI64(nativePointerFromAddress(left))
    val b = ablaUnsafeLoadI64(nativePointerFromAddress(right))
    if (a < b) -1 else if (a > b) 1 else 0
}

/** The caller: it allocates nothing itself (what it holds comes from calls) and makes one skipped C call, which calls back. */
trusted fun search(table: NativeByteBuffer, key: NativeByteBuffer, count: int): int {
    val strings = buildStrings()
    val object = buildObject()
    val found = bsearch(key.address, table.address, i64(count), i64(8), nativeFunctionAddress(compare))
    // What was held across the call is what was built.
    var wrong = 0
    for (index in 0 until 32) if (strings[index] != expected(index)) wrong = wrong + 1
    if (object.name != "object-${"x".repeat(100)}" || object.values[7] != 8) wrong = wrong + 1
    if (found == i64(0)) wrong = wrong + 1000
    wrong
}

/** What an expression holds in temporaries (not locals) across the C call: the arguments are evaluated left to right, so the strings and the
 *  object are built, then bsearch runs and calls back, then the check reads them. */
fun verify(strings: array<string>, object: Held, found: i64): int {
    var wrong = 0
    for (index in 0 until 32) if (strings[index] != expected(index)) wrong = wrong + 1
    if (object.name != "object-${"x".repeat(100)}" || object.values[7] != 8) wrong = wrong + 1
    if (found == i64(0)) wrong = wrong + 1000
    wrong
}

trusted fun searchInExpression(table: NativeByteBuffer, key: NativeByteBuffer, count: int): int =
    verify(buildStrings(), buildObject(), bsearch(key.address, table.address, i64(count), i64(8), nativeFunctionAddress(compare)))

trusted fun main: int {
    val count = 512
    val table = nativeByteBuffer(count * 8)
    for (index in 0 until count) table.storeI64(index * 8, index * 3)
    val key = nativeByteBuffer(8)
    var wrong = 0
    for (round in 0 until 40) {
        key.storeI64(0, ((round * 37) % count) * 3)
        wrong = wrong + search(table, key, count) + searchInExpression(table, key, count)
    }
    if (wrong != 0 || comparisons == 0) {
        println("FAIL: the held objects were wrong $wrong times over $comparisons comparisons")
        return 1
    }
    println("gc callback roots ok: $comparisons comparisons")
    0
}
