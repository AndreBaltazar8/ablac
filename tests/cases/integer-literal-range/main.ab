// Integer literals up to the largest u64 keep their bits (a literal above 9223372036854775807 is the `int` with
// those bits, which `u64(...)` reads as written); the test script checks that anything larger is rejected
// (a literal used to wrap around silently: 99999999999999999999 was 7766279631452241919).
import "abla/io"

fun main: int {
    println("${u64(18446744073709551615)} ${u64(0xFFFFFFFFFFFFFFFF)} ${u64(0o1777777777777777777777)}")
    println("${u64(9223372036854775808)} ${9223372036854775807} ${-9223372036854775808}")
    println("${u64(1_844_674_407_370_955_161_5)} ${0x7FFF_FFFF_FFFF_FFFF} ${0o777_777_777_777_777_777_777}")
    println("${u64(0xFFFFFFFFFFFFFFFF) == u64(18446744073709551615)} ${0x0000000000000000000FF}")
    0
}
