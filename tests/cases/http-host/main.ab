// The Host header in request framing (#1139 area 4, RFC 9112 3.2): a request with more than one Host line, or a Host value with a space, a comma or a
// control byte, is refused (-1, a 400 from the servers); a missing, empty, port-only or bracketed IPv6 Host is accepted, as it always was.
// Prints "http-host ok".
import "abla/io"
import "abla/http/event"

fun framed(head: string): int = httpEventFrame(head, 65536, 1048576).length

fun main: int {
    val refused: array<string> = [
        "GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a\r\nhost: a\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a\r\nX: y\r\nHOST: a\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a b\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a,b\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a\x01b\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: a\x7fb\r\n\r\n",
        "GET / HTTP/1.1\r\nhOsT: a b\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: ab,\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: ,ab\r\n\r\n",
        "POST /p HTTP/1.1\r\nHost: a\r\nContent-Length: 2\r\nHost: a\r\n\r\nhi"]
    for (head in refused) {
        if (framed(head) != -1) {
            println("FAIL accepted: ${head}")
            return 1
        }
    }
    val accepted: array<string> = [
        "GET / HTTP/1.1\r\nHost: a\r\n\r\n",
        "GET / HTTP/1.1\r\n\r\n",
        "GET / HTTP/1.1\r\nHost:\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: example.com:8080\r\n\r\n",
        "GET / HTTP/1.1\r\nHost: [::1]:8080\r\n\r\n",
        "GET / HTTP/1.1\r\nX-Host: a\r\nHost: a\r\nHostx: b\r\n\r\n",
        // Four-byte names a letter away from Host are other headers: their values are not checked, nor counted as a second Host.
        "GET / HTTP/1.1\r\nHost: a\r\nGost: a b\r\nHast: a,b\r\nHoxt: a\r\nHosu: a b\r\n\r\n",
        "GET / HTTP/1.0\r\n\r\n"]
    for (head in accepted) {
        if (framed(head) <= 0) {
            println("FAIL refused: ${head}")
            return 1
        }
    }
    // RFC 9112 3.2.2: an absolute-form target is served by its path with its authority as the host, whatever Host field came with it; one
    // whose scheme is not http(s), whose authority is empty, has userinfo or is not a host is refused. `*` and authority-form are unchanged.
    val absolute: array<string> = [
        "GET http://good.example/admin?x=1 HTTP/1.1\r\nHost: other.example\r\n\r\n", "/admin", "x=1", "good.example",
        "GET HTTPS://good.example:8443 HTTP/1.1\r\n\r\n", "/", "", "good.example:8443",
        "GET http://good.example/a/b HTTP/1.1\r\nHost: good.example\r\n\r\n", "/a/b", "", "good.example",
        "OPTIONS * HTTP/1.1\r\nHost: a\r\n\r\n", "*", "", "a",
        "GET /p HTTP/1.1\r\nHost: a\r\n\r\n", "/p", "", "a"]
    var at = 0
    while (at < absolute.size) {
        val frame = httpEventFrame(absolute[at], 65536, 1048576)
        val request = frame.request
        if (frame.length <= 0 || request == null) {
            println("FAIL refused: ${absolute[at]}")
            return 1
        }
        val host = request.header("Host")
        if (request.path != absolute[at + 1] || request.query != absolute[at + 2] || host != absolute[at + 3]) {
            println("FAIL ${absolute[at]} was served as path ${request.path} query ${request.query} host $host")
            return 1
        }
        at = at + 4
    }
    val absoluteRefused: array<string> = [
        "GET http://user@good.example/ HTTP/1.1\r\nHost: good.example\r\n\r\n",
        "GET http:///admin HTTP/1.1\r\nHost: good.example\r\n\r\n",
        "GET ftp://good.example/ HTTP/1.1\r\nHost: good.example\r\n\r\n",
        "GET http://a,b/ HTTP/1.1\r\nHost: a\r\n\r\n",
        "CONNECT good.example:443 HTTP/1.1\r\nHost: good.example:443\r\n\r\n"]
    for (head in absoluteRefused) {
        if (framed(head) != -1) {
            println("FAIL accepted: ${head}")
            return 1
        }
    }
    println("http-host ok")
    0
}
