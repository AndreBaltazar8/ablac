// A BigNumber built by hand over a buffer that is too small for its width: the first use stops with "does not fit its width", not a wild access.
import "abla/crypto"
import "abla/crypto/bignum"
import "abla/unsafe/memory"

fun main: int {
    val modulus = bigModulus(hexDecode("00000007")) ?? return 2
    val forged = BigNumber(modulus.data.clone(), nativeByteBuffer(16), 8)
    forged.copy().toBytes().size
}
