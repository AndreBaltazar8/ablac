// Numbers of two moduli in one operation: the program stops with "different moduli".
import "abla/crypto"
import "abla/crypto/bignum"

fun main: int {
    val seven = bigModulus(hexDecode("00000007")) ?? return 2
    val eleven = bigModulus(hexDecode("0000000b")) ?? return 2
    val a = seven.number(hexDecode("00000003")) ?? return 2
    val b = eleven.number(hexDecode("00000003")) ?? return 2
    a.add(b).toBytes().size
}
