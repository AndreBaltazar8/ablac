// An element store gives its value away (`list[i] = move(item)`): the element it replaces is dropped once, the new one stays
// alive in the array until the array goes, and nothing is dropped twice. Counted through the resource's drop.
import "abla/io"

var drops: int = 0

resource class Key(val id: int) {
    fun drop(): void {
        drops = drops + 1
    }
}

class Session(val tag: int, var key: Key? = null)

fun make(id: int): Session {
    val session = Session(id)
    session.key = Key(id)
    session
}

fun fill(var sessions: array<Session>, id: int): void {
    val session = make(id)
    sessions[0] = move(session)
    return
}

fun main: int {
    var sessions: array<Session> = [make(1)]
    fill(sessions, 2)
    if (drops != 1) {
        println("FAIL: after the first store ${drops} drops, expected 1 (the replaced element)")
        return 1
    }
    fill(sessions, 3)
    if (drops != 2) {
        println("FAIL: after the second store ${drops} drops, expected 2")
        return 1
    }
    sessions = []
    println("ownership index assign ok: ${drops} drops")
    0
}
