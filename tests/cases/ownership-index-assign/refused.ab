// `list[0] = item` stored an owned value without giving it away: `item` stayed alive beside the element and was dropped
// with the local, then again with the array (todo #1039). It needs `move(item)`, like a field assignment and an append do.
resource class Key(val id: int) {
    fun drop(): void {}
}

class Session(val tag: int, var key: Key? = null)

fun make(id: int): Session {
    val session = Session(id)
    session.key = Key(id)
    session
}

fun fill(var sessions: array<Session>): void {
    val session = make(2)
    sessions[0] = session
    return
}

fun main: int {
    val sessions: array<Session> = [make(1)]
    fill(sessions)
    0
}
