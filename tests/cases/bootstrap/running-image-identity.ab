import "../../../src/toolchain.ab"
import "abla/bytes"
import "abla/sys/linux/fs"

fun matchesImageHash(image: string, backend: string): bool {
    val combined = "$image\n$backend"
    val suffix = bootstrapRunningImageSuffix(
        backend, bootstrapRunningImageTail, image.size % 4
    )
    bootstrapNativeCacheHash(combined, 41, 269, 1000000007) ==
        bootstrapNativeCacheHash(suffix, bootstrapRunningImageFirst, 269, 1000000007) &&
    bootstrapNativeCacheHash(combined, 101, 271, 1000000009) ==
        bootstrapNativeCacheHash(suffix, bootstrapRunningImageSecond, 271, 1000000009)
}

fun main: int {
    bootstrapReadRunningImageIdentity()
    val image = Path("/proc/self/exe").readText()
    if (bootstrapRunningImageSize != image.size || image.size == 0) return 1
    if (!matchesImageHash(image, "") ||
        !matchesImageHash(image, "backend\nllvm-library:23\nprofile:fast")) return 2
    val first = bootstrapRunningImageFirst
    val second = bootstrapRunningImageSecond
    // Repeated builds reuse the same identity, with fresh backend suffixes.
    bootstrapReadRunningImageIdentity()
    if (bootstrapRunningImageFirst != first ||
        bootstrapRunningImageSecond != second || !matchesImageHash(image, "other-profile")) return 3
    42
}
