// `break@name` and `continue@name` must name a loop around them, in the same
// function: a lambda doesn't see its caller's loops.
fun unknownBreak(): void {
    outer@ while (true) {
        break@other
    }
}

fun unknownContinue(): void {
    for (x in 0 until 3) {
        continue@missing
    }
}

fun throughLambda(): void {
    outer@ while (true) {
        val callback = { ->
            while (true) break@outer
        }
        callback()
        break
    }
}

fun main: int = 0
