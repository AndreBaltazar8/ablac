var discardedIfDrops = ""
var discardedIfConditions = 0

resource class DiscardedIfToken(val number: int) {
    fun drop(): void {
        discardedIfDrops = "$discardedIfDrops$number,"
    }
}

class DiscardedIfBox(val number: int)

fun discardedIfCondition(): bool {
    discardedIfConditions = discardedIfConditions + 1
    true
}

fun discardedIfRefinement(value: DiscardedIfBox?): int {
    if (value == null) return -1
    value.number
}

fun discardedIfAffineJoin(flag: bool): DiscardedIfToken =
    if (flag) DiscardedIfToken(6) else DiscardedIfToken(99)

fun discardedIfScalar(flag: bool): int {
    var value = 0
    if (flag) value = 3
    value + 39
}

fun discardedIfExercise(): int {
    if (discardedIfCondition()) DiscardedIfToken(1)
    if (false) DiscardedIfToken(99)
    if (true) {
        val local = DiscardedIfToken(2)
        local
    }
    var index = 0
    while (index < 2) {
        index = index + 1
        if (index == 2) DiscardedIfToken(3)
    }
    do {
        index = index - 1
        if (index == 1) DiscardedIfToken(4)
    } while (index > 0)
    for (item in 0 until 2) {
        if (item == 1) DiscardedIfToken(5)
    }
    // Explicit-else affine joins still materialize and drop their result.
    if (true) DiscardedIfToken(7) else DiscardedIfToken(99)
    var turn = 0
    while (turn < 4) {
        val local = DiscardedIfToken(10 + turn)
        turn = turn + 1
        if (turn == 2) continue
        if (turn == 3) break
    }
    val held = discardedIfAffineJoin(true)
    val answer = if (true) 7 else 99
    answer
}

fun main: int {
    val answer = discardedIfExercise()
    if (answer == 7 && discardedIfScalar(true) == 42 && discardedIfConditions == 1 &&
        discardedIfDrops == "1,2,3,4,5,7,10,11,12,6," &&
        discardedIfRefinement(DiscardedIfBox(8)) == 8 &&
        discardedIfRefinement(null) == -1) 42 else 1
}
