resource class Ticket(val value: int)

compile fun invalidBorrowLifetime(): int {
    val owner = Shared(Ticket(42))
    val view = owner.get()
    val moved = move(owner)
    view.value
}

// Never called: `build` prunes it, but --emit-llvm checks its body and names the conflict.
val answer = 42

fun main: int = answer
