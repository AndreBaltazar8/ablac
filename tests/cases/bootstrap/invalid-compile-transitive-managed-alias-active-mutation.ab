class Counter(var value: int)

class CounterBox(val counter: Counter)

class NestedCounterBox(val box: CounterBox)

compile fun invalidStage(): int {
    val nested = NestedCounterBox(CounterBox(Counter(1)))
    val view = nested
    nested.box.counter.value = 2
    view.box.counter.value
}

fun main: int = #invalidStage()
