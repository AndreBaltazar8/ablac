// Temporaries used inside one block: their slots get lifetime markers, and the
// program computes the same with LLVM free to overlap them.
fun describe(value: int): string =
    "value=$value" + (if (value % 3 == 0) " fizz" else " plain") + "."

fun main: int {
    var total = 0
    var index = 0
    while (index < 1000) {
        total = total + describe(index).size
        index = index + 1
    }
    if (total == 15556) 42 else 1
}
