resource class Ticket(val value: int)
resource class TicketList(val tickets: array<Ticket>)

fun main: int {
    val owner = Shared(TicketList([Ticket(42)]))
    val view = owner.get()
    val copied = view
    val selected = if (true) { copied } else { view }
    val tickets = selected.tickets
    val moved = move(owner)
    tickets[0].value
}
