class Box(var value: int)

class FreshFactory {
    fun make(): Box = Box(1)
}

class AliasingFactory(val shared: Box) {
    fun make(): Box = this.shared
}

fun overwrite(var box: Box): int {
    box.value = 42
    box.value
}

fun main: int {
    val factory = AliasingFactory(Box(1))
    overwrite(factory.make())
}
