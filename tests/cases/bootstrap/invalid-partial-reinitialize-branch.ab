resource class Ticket(val value: int)
class TicketBox(var ticket: Ticket)

fun inspect(box: TicketBox): int = box.ticket.value

fun choose(flag: bool): int {
    val box = TicketBox(Ticket(41))
    val ticket = move(box.ticket)
    if (flag) box.ticket = Ticket(1)
    ticket.value + inspect(box)
}

fun main: int = choose(true)
