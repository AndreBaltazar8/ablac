class Counter(var value: int)

class Holder(val counter: Counter)

fun wrap(counter: Counter): Holder = Holder(counter)

fun increment(var counter: Counter): void {
    counter.value = counter.value + 1
    return
}

fun main: int {
    val counter = Counter(41)
    val holder = wrap(counter)
    increment(counter)
    holder.counter.value
}
