#import("../../../bootstrap/compiler/staged_parser.ab")
#import("abla/io")

fun main: int {
    val staged = bootstrapParseStaged(
        "compile fun parseAnswer(cursor: int): int { parserExpect(cursor, \"{\"); parserExpect(cursor, \"}\"); syntaxBinary(\"+\", syntaxInteger(20), syntaxInteger(22)) }\n#compilerRegisterSubparser(\"answer\", parseAnswer)\nfun answer: int = \$answer{}\n"
    )
    val jsonParsed = bootstrapParse(
        ablaHostReadFile("stdlib/abla/json/entry.ab")
    )
    val jsonRegistry = bootstrapBuildSubparserRegistry(jsonParsed)
    val htmlParsed = bootstrapParse(
        ablaHostReadFile("stdlib/abla/html/entry.ab")
    )
    val htmlRegistry = bootstrapBuildSubparserRegistry(htmlParsed)
    val jsonInput = "{\"answer\": 42}"
    val jsonTokens = bootstrapLex(jsonInput)
    val jsonCursor = BootstrapSubparserCursor(
        jsonInput,
        jsonTokens,
        [],
        [],
        [],
        0,
        jsonTokens[0].begin,
        0
    )
    val jsonInvocation = bootstrapInvokeSubparserHandler(
        jsonParsed.declarations,
        jsonRegistry.registrations[0].handler,
        jsonCursor,
        false
    )
    val htmlInput = "<div>{20 + 22}</div>"
    val htmlTokens = bootstrapLex(htmlInput)
    val htmlCursor = BootstrapSubparserCursor(
        htmlInput,
        htmlTokens,
        [],
        [],
        [],
        0,
        0,
        0
    )
    val htmlInvocation = bootstrapInvokeSubparserHandler(
        htmlParsed.declarations,
        htmlRegistry.registrations[0].handler,
        htmlCursor,
        false
    )
    if (
        staged.errors == 0 &&
        staged.actions.size == 1 &&
        staged.declarations.size == 2 &&
        staged.declarations[1].expression.kind == "+" &&
        staged.declarations[1].expression.children[0].text == "20" &&
        staged.declarations[1].expression.children[1].text == "22" &&
        jsonParsed.errors == 0 &&
        jsonRegistry.errors == 0 &&
        jsonRegistry.contains("json") &&
        htmlParsed.errors == 0 &&
        htmlRegistry.errors == 0 &&
        htmlRegistry.contains("html") &&
        jsonInvocation.errors == 0 &&
        jsonCursor.rawEnd() &&
        jsonInvocation.expression.kind == "call" &&
        jsonInvocation.expression.text == "ablaJsonObject" &&
        jsonInvocation.expression.children.size == 2 &&
        jsonInvocation.expression.children[0].kind == "array" &&
        jsonInvocation.expression.children[0].children[0].text == "answer" &&
        jsonInvocation.expression.children[1].children[0].text ==
            "ablaJsonInteger" &&
        htmlInvocation.errors == 0 &&
        htmlCursor.rawEnd() &&
        htmlInvocation.expression.kind == "call" &&
        htmlInvocation.expression.text == "ablaHtmlElement" &&
        htmlInvocation.expression.children[0].text == "div" &&
        htmlInvocation.expression.children[1].kind == "array" &&
        htmlInvocation.expression.children[1].children[0].text ==
            "ablaHtmlDynamic"
    ) 42 else 0
}
