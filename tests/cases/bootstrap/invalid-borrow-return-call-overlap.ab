resource class Ticket(val value: int)

fun view(owner: Shared<Ticket>): borrow(owner) Ticket = owner.get()

fun observeAndConsume(
    ticket: Ticket,
    own owner: Shared<Ticket>
): int = ticket.value + owner.get().value

fun main: int {
    val owner = Shared(Ticket(21))
    observeAndConsume(view(owner), move(owner))
}
