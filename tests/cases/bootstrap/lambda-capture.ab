fun makeAdder(offset: int): (int) -> int =
    { value: int -> offset + value }

fun makeNested(base: int): (int) -> int {
    val outer = { delta: int ->
        { value: int -> base + delta + value }
    }
    outer(1)
}

class Counter(var value: int) {
    fun callback(): FnMut(int) -> int =
        { amount: int -> this.value = this.value + amount }
}

fun main: int {
    var total = 1
    val accumulate = { value: int ->
        total = total + value
        total
    }
    val first = accumulate(20)
    val second = accumulate(21)
    val add = makeAdder(40)
    val nested = makeNested(20)
    val counter = Counter(40)
    var incrementCounter = counter.callback()
    val counterResult = incrementCounter(2)
    if (
        first == 21 &&
        second == 42 &&
        total == 42 &&
        add(2) == 42 &&
        nested(21) == 42 &&
        counterResult == 42 &&
        counter.value == 42
    ) 42 else 0
}
