resource class Ticket(val value: int)

class Inspector {
    fun invalidBorrowLifetime(): int {
        val owner = Shared(Ticket(42))
        val view = owner.get()
        val moved = move(owner)
        view.value
    }
}

compile fun invokeInvalidMethodBorrow(): int =
    Inspector().invalidBorrowLifetime()

val answer = #invokeInvalidMethodBorrow()

fun main: int = answer
