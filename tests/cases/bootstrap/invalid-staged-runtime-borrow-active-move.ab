resource class Ticket(val value: int)

fun invalidRuntimeBorrowLifetime(): int {
    val owner = Shared(Ticket(42))
    val view = owner.get()
    val moved = move(owner)
    view.value
}

compile fun invokeInvalidRuntimeBorrow(): int =
    invalidRuntimeBorrowLifetime()

val answer = #invokeInvalidRuntimeBorrow()

fun main: int = answer
