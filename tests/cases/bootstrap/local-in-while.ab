class LocalScopeProbe(val values: array<string>) {
    fun matches(value: string): bool = value == "42"

    fun run(): int {
        var index = 0
        var result = 0
        if (this.values.size > 0) {
            val free: array<string> = []
            free.append(this.values[0])
            while (index < free.size) {
                var captureName = free[index]
                if (this.matches(captureName)) captureName = "seen"
                if (captureName == "seen") result = 42
                index = index + 1
            }
        }
        result
    }
}

fun main: int = LocalScopeProbe(["42"]).run()
