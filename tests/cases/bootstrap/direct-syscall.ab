import "abla/sys/linux"

fun main: int {
    val written = linuxWriteStandardOutput("direct-syscall\n")
    val source = linuxReadFile(
        "tests/cases/bootstrap/direct-syscall.ab",
        16384
    )
    // The file reads back as itself: it starts with its import.
    if (written == 15 && linuxProcessId() > 0 &&
        source.size > 6 && source.slice(0, 6) == "import") 42 else 0
}
