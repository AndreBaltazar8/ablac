import "abla/io"

resource class DiscardedCloseTrace(val name: string) {
    fun close(): void { println("close $name") }
    fun drop(): void { this.close() }
}

fun exercise(flag: bool): void {
    println("before if")
    if (flag) {
        val inner = DiscardedCloseTrace("if inner")
        defer { println("defer if") }
        val result = DiscardedCloseTrace("if result")
        result
    } else DiscardedCloseTrace("if other")
    println("after if")
    when (flag) {
        true -> {
            val inner = DiscardedCloseTrace("when inner")
            defer { println("defer when") }
            val result = DiscardedCloseTrace("when result")
            result
        }
        false -> DiscardedCloseTrace("when other")
    }
    println("after when")
    do {
        val inner = DiscardedCloseTrace("block inner")
        defer { println("defer block") }
        val result = DiscardedCloseTrace("block result")
        result
    } while (false)
    println("after block")
}

fun main(): int { exercise(true); exercise(false); 0 }
