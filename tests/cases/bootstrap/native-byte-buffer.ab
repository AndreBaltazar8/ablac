#import("abla/unsafe/memory")

fun main: int {
    val buffer = nativeByteBuffer(4)
    val first = buffer.store(0, 65)
    val second = buffer.store(1, 66)
    val third = buffer.store(2, 67)
    val loaded = buffer.load(1)
    val text = buffer.adoptString(3)
    if (first && second && third && loaded == 66 && text == "ABC") {
        42
    } else {
        0
    }
}
