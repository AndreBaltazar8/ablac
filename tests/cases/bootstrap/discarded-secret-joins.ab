import "abla/ct"

fun discardedSecretIf(flag: bool, input: u32): u32 {
    var word = secretU32(input)
    if (flag) {
        val mask = secretU32(u32(3))
        word = word ^ mask
    } else {
        val add = secretU32(u32(5))
        word = word + add
    }
    word.declassify()
}

fun discardedSecretWhen(flag: bool, input: u32): u32 {
    var word = secretU32(input)
    when (flag) {
        true -> {
            val mask = secretU32(u32(3))
            word = word ^ mask
        }
        false -> {
            val add = secretU32(u32(5))
            word = word + add
        }
    }
    word.declassify()
}

fun discardedSecretNested(flag: bool, input: u32): u32 {
    var word = secretU32(input)
    if (flag) {
        val index = 1
        when (index) {
            0 -> word = secretU32(u32(99))
            else -> {
                val mask = secretU32(u32(3))
                word = word ^ mask
            }
        }
    } else {
        val other = secretU32(u32(2))
        if (flag) word = other else word = word + other
    }
    word.declassify()
}

// Used control-flow expressions still hand their result to the caller.
fun usedSecretIf(flag: bool, input: u32): u32 {
    val selected = if (flag) {
        val word = secretU32(input)
        word ^ secretU32(u32(3))
    } else {
        val word = secretU32(input)
        word + secretU32(u32(5))
    }
    selected.declassify()
}

fun usedSecretWhen(flag: bool, input: u32): u32 {
    val selected = when (flag) {
        true -> {
            val word = secretU32(input)
            word ^ secretU32(u32(3))
        }
        false -> {
            val word = secretU32(input)
            word + secretU32(u32(5))
        }
    }
    selected.declassify()
}

fun main(): int {
    if (discardedSecretIf(true, u32(17)) == u32(18) &&
        discardedSecretIf(false, u32(17)) == u32(22) &&
        discardedSecretWhen(true, u32(17)) == u32(18) &&
        discardedSecretWhen(false, u32(17)) == u32(22) &&
        discardedSecretNested(true, u32(17)) == u32(18) &&
        discardedSecretNested(false, u32(17)) == u32(19) &&
        usedSecretIf(true, u32(17)) == u32(18) &&
        usedSecretIf(false, u32(17)) == u32(22) &&
        usedSecretWhen(true, u32(17)) == u32(18) &&
        usedSecretWhen(false, u32(17)) == u32(22)) 42 else 1
}
