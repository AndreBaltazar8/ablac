class Counter(var value: int)

class Holder(val counter: Counter) {
    fun view(): borrow(this) Counter = counter
}

fun bump(var holder: Holder): void {
    holder.counter.value = holder.counter.value + 1
    return
}

fun main: int {
    val holder = Holder(Counter(41))
    val view = holder.view()
    bump(holder)
    view.value
}
