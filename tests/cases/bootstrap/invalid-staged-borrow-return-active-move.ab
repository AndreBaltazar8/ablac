resource class Ticket(val value: int)

fun view(owner: Shared<Ticket>): borrow(owner) Ticket = owner.get()

fun invalidReturnedBorrowLifetime(): int {
    val owner = Shared(Ticket(42))
    val borrowed = view(owner)
    val moved = move(owner)
    borrowed.value
}

compile fun invokeInvalidReturnedBorrow(): int =
    invalidReturnedBorrowLifetime()

val answer = #invokeInvalidReturnedBorrow()

fun main: int = answer
