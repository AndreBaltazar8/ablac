// A parameter is declared in its function body's own scope: a local of the
// body redeclaring it is a duplicate, as two locals of one block are.
fun redeclared(width: f64, flag: bool): f64 {
    val scale = if (flag) 1.0 else 2.0
    val flag = 0.25
    scale + width * flag
}

fun main: int = if (redeclared(8.0, true) > 0.0) 0 else 1
