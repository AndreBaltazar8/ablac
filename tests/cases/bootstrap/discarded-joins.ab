import "abla/float"

var discardedJoinDrops = ""
var discardedJoinSubjects = 0

resource class DiscardedJoinToken(val number: int) {
    fun drop(): void { discardedJoinDrops = "$discardedJoinDrops$number," }
}

class DiscardedJoinBox(val number: int)

fun discardedJoinSubject(): int {
    discardedJoinSubjects = discardedJoinSubjects + 1
    2
}

fun discardedJoinUsed(flag: bool): int = if (flag) 42 else 7
fun discardedJoinUsedWhen(value: int): int = when (value) {
    1, 2 -> 42
    else -> 7
}

fun discardedJoinIf(flag: bool): int {
    var value = 0
    if (flag) value = 3 else value = 4
    value + 39
}

fun discardedJoinWhen(value: int): int {
    var answer = 0
    when (value) {
        1, 2 -> answer = 3
        else -> answer = 4
    }
    answer + 39
}

fun discardedJoinRefinement(value: DiscardedJoinBox?): int {
    var answer = 0
    when (value) {
        null -> answer = 3
        else -> answer = value.number
    }
    answer + 39
}

fun discardedJoinResourceIf(flag: bool): int {
    if (flag) DiscardedJoinToken(1) else DiscardedJoinToken(99)
    42
}

fun discardedJoinResourceWhen(flag: bool): int {
    when (flag) {
        true -> DiscardedJoinToken(2)
        false -> DiscardedJoinToken(99)
    }
    42
}

fun discardedJoinResources(flag: bool): void {
    discardedJoinResourceIf(flag)
    discardedJoinResourceWhen(flag)
    var turn = 0
    while (turn < 2) {
        val held = DiscardedJoinToken(3 + turn)
        turn = turn + 1
        if (turn == 1) turn + 10 else turn + 20
    }
    do {
        val held = DiscardedJoinToken(5)
        42
    } while (false)
}

fun main: int {
    discardedJoinResources(true)
    val shadowAnswer = discardedJoinShadow(true)
    val subjectAnswer = discardedJoinWhen(discardedJoinSubject())
    if (discardedJoinF32(1.5) == 1077936128 && discardedJoinF32(0.0) == 0 &&
        discardedJoinFloat(true) == 2.5 && discardedJoinFloat(false) == 3.5 &&
        shadowAnswer == 7 && discardedJoinIf(true) == 42 && discardedJoinIf(false) == 43 &&
        subjectAnswer == 42 && discardedJoinSubjects == 1 &&
        discardedJoinWhen(9) == 43 && discardedJoinUsed(true) == 42 &&
        discardedJoinUsedWhen(2) == 42 &&
        discardedJoinRefinement(null) == 42 &&
        discardedJoinRefinement(DiscardedJoinBox(3)) == 42 &&
        discardedJoinDrops == "1,2,3,4,5,8,6,") 42 else 1
}

// Resource joins with arm-local shadowing keep their original ownership path.
fun discardedJoinShadow(flag: bool): int {
    val shadow = DiscardedJoinToken(6)
    if (flag) {
        val shadow = DiscardedJoinToken(8)
        shadow
    } else {
        val shadow = DiscardedJoinToken(99)
        shadow
    }
    7
}

fun discardedJoinF32(value: f32): int {
    var result: f32 = 0.0
    when (value) {
        1.5 -> result = 2.5
        else -> result = 0.5
    }
    if (value > 1.0) result = result + 0.5 else result = result - 0.5
    int(f32ToBits(result))
}

fun discardedJoinFloat(flag: bool): f64 {
    var value = 1.25
    if (flag) value = 2.5 else value = 3.5
    value
}
