resource class Ticket(val value: int)

fun view(owner: Shared<Ticket>): borrow(owner) Ticket = owner.get()

fun invalidIndirectBorrowLifetime(): int {
    val callback = view
    val owner = Shared(Ticket(42))
    val borrowed = callback(owner)
    val moved = move(owner)
    borrowed.value
}

compile fun invokeInvalidIndirectBorrow(): int =
    invalidIndirectBorrowLifetime()

val answer = #invokeInvalidIndirectBorrow()

fun main: int = answer
