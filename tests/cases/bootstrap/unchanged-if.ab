fun unchangedIfPlain(value: int): int = value + 1

fun unchangedIfUsed(flag: bool): int = if (flag) 20 else 30

fun unchangedIfExplicit(flag: bool): int {
    var value = 0
    if (flag) value = 20 else value = 30
    value
}

// The function body's value is still requested, even with a void result.
fun unchangedIfMissing(flag: bool): void = if (flag) 1

fun main: int {
    unchangedIfMissing(true)
    unchangedIfPlain(1) + unchangedIfUsed(true) + unchangedIfExplicit(true)
}
