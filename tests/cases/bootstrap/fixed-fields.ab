// A class's fields are fixed: typed accesses address its declared fields in
// the instance's inline slots, so a by-name store that would add a field
// panics instead of moving them. Source can't name an undeclared field (that
// is a semantic error), so this calls the runtime's by-name store directly.
class Point(var x: int, var y: int)

trusted fun main: int {
    val point = Point(40, 2)
    point.x = point.x + point.y
    __ablaRuntimeFieldSet(point, 12345, 7)
    point.x
}
