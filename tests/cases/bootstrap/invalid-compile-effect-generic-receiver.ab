// A receiver of known type still reaches a method its owner declares generally:
// the local's type names no `array<int>.pid`, and `array<T>.pid` is what runs.
noescape extern:"c" fun getpid(): int

fun <T> array<T>.pid(): int = getpid() + this.size

fun made(): array<int> = [1, 2]

fun loaded(): int {
    val items = made()
    items.pid()
}

val count = #loaded()

fun main: int = if (count > 0) 0 else 1
