import "abla/unsafe/memory"

trusted noescape extern:"intrinsic" fun ablaUnsafeCopyMemory(
    destination: i64*,
    source: i64*,
    size: int
): void

trusted fun copyBytes(
    var destination: NativeByteBuffer,
    source: NativeByteBuffer,
    size: int
): bool {
    val valid = !destination.closed && !source.closed && size >= 0 &&
        size <= destination.capacity && size <= source.capacity
    if (valid && size > 0) {
        ablaUnsafeCopyMemory(destination.address, source.address, size)
    }
    valid
}

fun main: int {
    val source = nativeByteBuffer(4)
    val destination = nativeByteBuffer(4)
    val initialized = source.store(0, 17) && source.store(1, 43) &&
        source.store(2, 97) && source.store(3, 211)
    val copied = initialized && copyBytes(destination, source, 4)
    if (copied && destination.load(0) == 17 &&
        destination.load(1) == 43 && destination.load(2) == 97 &&
        destination.load(3) == 211) 42 else 0
}
