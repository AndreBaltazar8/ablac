resource class Ticket(val value: int)

fun view(owner: Shared<Ticket>): borrow(owner) Ticket = owner.get()

val globalView = view

fun consume(own owner: Shared<Ticket>): int = owner.get().value

fun main: int {
    val owner = Shared(Ticket(42))
    val borrowed = globalView(owner)
    val answer = borrowed.value
    val moved = move(owner)
    answer + consume(move(moved)) - 42
}
