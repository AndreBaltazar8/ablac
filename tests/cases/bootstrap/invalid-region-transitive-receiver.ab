class RegionTransitiveHolder(var value: string) {
    fun replace(value: string): void {
        this.value = value
        return
    }
}

fun replaceThroughWrapper(
    holder: RegionTransitiveHolder,
    value: string
): void {
    holder.replace(value)
    return
}

fun main: int {
    val escaped = RegionTransitiveHolder("before")
    region {
        replaceThroughWrapper(escaped, "region allocation")
        42
    }
}
