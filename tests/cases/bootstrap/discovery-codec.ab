import "../../../src/discovery_cache.ab"
import "abla/sys/linux/io"

fun main: int {
    val ints: array<int> = [-9223372036854775807 - 1, -1, 0, 1, 9223372036854775807]
    val texts: array<string> = ["", "áλ🙂", "a${byteEncode(0)}b", "\r\n"]
    val out = BootstrapDiscoveryWriter()
    out.putInts(ints)
    out.putTexts(texts)
    out.putBool(false)
    out.putBool(true)
    val input = BootstrapDiscoveryReader(out.out.toText())
    val gotInts = input.getInts()
    val gotTexts = input.getTexts()
    if (!input.valid || gotInts.size != ints.size || gotTexts.size != texts.size) return 1
    var i = 0
    while (i < ints.size) { if (ints[i] != gotInts[i]) return 2; i = i + 1 }
    i = 0
    while (i < texts.size) { if (texts[i] != gotTexts[i]) return 3; i = i + 1 }
    if (input.getBool() || !input.getBool() || !input.valid || input.cursor != input.input.size) return 4
    val parsed = BootstrapParseResult([], [], 0, 0, [], [], "")
    val source = "source${byteEncode(0)}á"
    val identity = "/source.ab"
    val record = bootstrapDiscoveryRecord(source, identity, parsed)
    if (!bootstrapDiscoveryDecode(source, identity, record).valid) return 5
    if (bootstrapDiscoveryDecode("other", identity, record).valid || bootstrapDiscoveryDecode(source, "/other.ab", record).valid) return 6
    if (bootstrapDiscoveryDecode(source, identity, "$record!").valid) return 7
    i = 0
    while (i < record.size) {
        if (bootstrapDiscoveryDecode(source, identity, record.slice(0, i)).valid) return 8
        val changed = "${record.slice(0, i)}${byteEncode((record[i] + 1) & 255)}${record.slice(i + 1, record.size)}"
        if (bootstrapDiscoveryDecode(source, identity, changed).valid) return 9
        i = i + 1
    }
    val invalidBool = BootstrapDiscoveryReader(byteEncode(2))
    invalidBool.getBool()
    if (invalidBool.valid) return 10
    val invalidCount = BootstrapDiscoveryReader("${byteEncode(255)}${byteEncode(255)}${byteEncode(255)}${byteEncode(255)}")
    invalidCount.getCount()
    if (invalidCount.valid) return 11
    val tooDeep = BootstrapDiscoveryWriter()
    tooDeep.putExpression(bootstrapDiscoveryEmptyExpression(), 257)
    if (tooDeep.valid) return 12
    val treeSource = "class Box(val name: string = \"hi\") { fun get(value: int = 7): int = value }\n@inline fun helper(value: int = 3): int = value\ncompile fun choose(value: int): int = if (value > 0) value else -value\n"
    val tree = bootstrapParseWithIdentity(treeSource, "/tree.ab")
    val treeRecord = bootstrapDiscoveryRecord(treeSource, "/tree.ab", tree, "test-image")
    val decodedTree = bootstrapDiscoveryDecode(treeSource, "/tree.ab", treeRecord, "test-image")
    if (tree.errors != 0 || !decodedTree.valid || bootstrapDiscoveryPayload(tree) != bootstrapDiscoveryPayload(decodedTree.parsed)) return 13
    if (bootstrapDiscoveryDecode(treeSource, "/tree.ab", treeRecord, "wrong-image").valid) return 14
    linuxPrintStandardOutput("codec scalar bounds, UTF8/NUL, truncation, every-byte corruption, identity and depth checks pass\n")
    0
}
