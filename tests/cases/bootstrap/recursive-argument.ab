class Node(val value: int, val left: Node?, val right: Node?)

fun weight(node: Node): int {
    val left = node.left
    val right = node.right
    val a = if (left == null) 0 else weight(left)
    val b = if (right == null) 0 else weight(right)
    node.value + 2 * a + 3 * b
}

fun main: int {
    val left = Node(9, null, null)
    val right = Node(12, Node(6, null, null), Node(3, null, null))
    if (weight(Node(3, left, right)) == 120) 42 else 1
}
