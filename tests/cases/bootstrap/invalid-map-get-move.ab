resource class Token(val id: int)

fun consume(own token: Token): int = token.id

// `get` lends the map's value: moving it out would leave the map holding a
// value someone else drops. `take` moves it out.
fun main: int {
    val tokens: Map<string, Token> = Map()
    tokens.set("a", Token(1))
    val got = tokens.get("a")
    if (got != null) consume(move(got)) else 0
}
