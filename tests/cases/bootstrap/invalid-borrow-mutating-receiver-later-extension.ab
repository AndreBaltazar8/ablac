// `refresh` mutates its receiver only through `reset`, an extension declared after
// the class (and after main): the receiver summary learns it on its second pass,
// and the borrow of `holder.handle` is still caught.
resource class Ticket(val value: int)

resource class Holder(var handle: Shared<Ticket>) {
    fun refresh(): void {
        this.reset()
        return
    }
}

fun main: int {
    val holder = Holder(Shared(Ticket(42)))
    val view = holder.handle.get()
    holder.refresh()
    view.value
}

fun Holder.reset(): void {
    this.handle = Shared(Ticket(0))
    return
}
