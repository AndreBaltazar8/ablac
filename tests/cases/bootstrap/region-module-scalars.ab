// Calls a region may make: they write scalars to module values, append to an
// array of scalars, or store into locals and parameters that shadow heap
// module values. None keeps region memory after the region ends.
var regionCount = 0
var regionLast = -1
val regionSizes: array<int> = []
var regionLabel = "outer"
val regionNames: array<string> = []

fun countRound(round: int): int {
    regionCount = regionCount + 1
    regionLast = round
    regionSizes.append(round)
    regionCount
}

fun shadowedNames(var regionNames: array<string>): int {
    regionNames.append("parameter")
    val regionLabel = "local" + "label"
    regionNames.size + regionLabel.size
}

fun shadowedLoop(): int {
    var total = 0
    for (regionLabel in ["a", "b"]) {
        var regionNames: array<string> = []
        regionNames.append(regionLabel + "!")
        total = total + regionNames.size
    }
    total
}

fun main: int {
    var total = 0
    var round = 0
    while (round < 3) {
        total = total + region { countRound(round) }
        total = total + region {
            val names: array<string> = []
            shadowedNames(names)
        }
        total = total + region { shadowedLoop() }
        round = round + 1
    }
    // 6 counts + 3 * (1 + 10) + 3 * 2 = 45; less the 3 rounds' last index.
    if (regionSizes.size == 3 && regionLast == 2 && regionLabel == "outer" &&
        regionNames.size == 0) total - 3 else 0
}
