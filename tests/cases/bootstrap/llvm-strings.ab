fun main: int {
    val value = 21
    val text = "answer ${value + 21}"
    val escaped = "\"\\\nA\$"
    if (text != "answer 42") 10
    else if (escaped.size != 5) 11
    else if (escaped[0] != 34) 12
    else if (escaped[1] != 92) 13
    else if (escaped[2] != 10) 14
    else if (escaped[3] != 65) 15
    else if (escaped[4] != 36) 16
    else 42
}
