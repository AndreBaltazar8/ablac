import "abla/http/event"
import "abla/websocket/event"
import "abla/sys/linux/io"
import "abla/process/arguments"

fun main: int {
    if (processArgument(0) == "websocket") {
        val server = webSocketEventServer(
            webSocketEventRouter(), Ipv4SocketAddress("127.0.0.1", 0)
        )
        linuxPrintStandardOutput("${server.listener.localPort()}\n")
        server.run()
    } else {
        val server = httpEventServer(
            httpRouter(), Ipv4SocketAddress("127.0.0.1", 0)
        )
        linuxPrintStandardOutput("${server.listener.localPort()}\n")
        server.run()
    }
    42
}
