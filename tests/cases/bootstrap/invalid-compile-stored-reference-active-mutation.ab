class Counter(var value: int)

class CounterHolder(val counter: Counter)

fun increment(var counter: Counter): int {
    counter.value = counter.value + 1
    counter.value
}

compile fun staged(): int {
    val counter = Counter(1)
    val holder = CounterHolder(counter)
    increment(counter)
    holder.counter.value
}

fun main: int = #staged()
