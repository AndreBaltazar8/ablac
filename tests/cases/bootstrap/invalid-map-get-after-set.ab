resource class Token(val id: int)

// `seen` borrows the map's value; `set` drops it, so `seen` may not be used
// after the map changes.
fun main: int {
    val tokens: Map<string, Token> = Map()
    tokens.set("a", Token(1))
    val seen = tokens.get("a")
    tokens.set("a", Token(2))
    if (seen != null) seen.id else 0
}
