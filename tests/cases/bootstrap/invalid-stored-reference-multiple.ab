class Counter(var value: int)

class CounterPair(val left: Counter, val right: Counter)

// `left` and `right` are both read after the call, so the pair would keep
// references from two sources.
fun main: int {
    val left = Counter(20)
    val right = Counter(22)
    val pair = CounterPair(left, right)
    pair.left.value + pair.right.value + left.value + right.value - 42
}
