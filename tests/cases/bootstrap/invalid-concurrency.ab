resource class Ticket(val value: int)
var globalValue = 0

fun invalidYield(): void {
    yield 1
}

fun invalidAwait(): void {
    val value = await 1
    return
}

fun emptyGenerator(): Generator<int> = generator {}

fun affineGenerator(): Generator<Shared<Ticket>> = generator {
    yield Shared(Ticket(1))
}

fun affineTask(): Task<Ticket> = task { Ticket(1) }

fun unsafeThreadCapture(): Thread<int> {
    val value = 1
    thread { value }
}

fun mutatingThreadCapture(): Thread<int> {
    var value = 1
    thread {
        value = value + 1
        value
    }
}

fun mutatingThreadGlobal(): Thread<int> = thread {
    globalValue = globalValue + 1
    globalValue
}

fun main: int = 0
