// Table-driven numeric edge cases (generated once from a reviewed list; the values were checked against the language
// rules in docs/language.md, IEEE 754 / C99 and Node 22 for abla/math). Each case runs as ordinary code and under `#`;
// main exits with the number of cases where the two differ and prints every result for tools/test-numeric-edges.sh.
import "abla/io"
import "abla/float"
import "abla/float/text"

@noinline fun idI(x: int): int = x
@noinline fun idI8(x: i8): i8 = x
@noinline fun idU8(x: u8): u8 = x
@noinline fun idI16(x: i16): i16 = x
@noinline fun idU16(x: u16): u16 = x
@noinline fun idI32(x: i32): i32 = x
@noinline fun idU32(x: u32): u32 = x
@noinline fun idU64(x: u64): u64 = x
@noinline fun idF(x: f64): f64 = x
@noinline fun idF32(x: f32): f32 = x

fun cases(): array<string> {
    val out: array<string> = []
    val min = idI(-9223372036854775807 - 1)
    val max = idI(9223372036854775807)
    val one = idI(1)
    val neg1 = idI(-1)
    val big = idU64(u64(18446744073709551615))
    val nan = idF(0.0) / idF(0.0)
    val inf = idF(1.0) / idF(0.0)
    val ninf = idF(-1.0) / idF(0.0)
    // wrapping arithmetic
    out.append("int max+1 ${max + one}")
    out.append("int min-1 ${min - one}")
    out.append("int max*2 ${max * idI(2)}")
    out.append("int min*min ${min * min}")
    out.append("int min*-1 ${min * neg1}")
    out.append("int -min ${-min}")
    out.append("int min+min ${min + min}")
    out.append("i8 127+1 ${idI8(127) + idI8(1)}")
    out.append("i8 -128-1 ${idI8(-128) - idI8(1)}")
    out.append("i8 100*3 ${idI8(100) * idI8(3)}")
    out.append("i8 -(-128) ${-idI8(-128)}")
    out.append("u8 255+1 ${idU8(255) + idU8(1)}")
    out.append("u8 0-1 ${idU8(0) - idU8(1)}")
    out.append("u8 200*2 ${idU8(200) * idU8(2)}")
    out.append("u8 -(1) ${-idU8(1)}")
    out.append("i16 32767+1 ${idI16(32767) + idI16(1)}")
    out.append("u16 65535+1 ${idU16(65535) + idU16(1)}")
    out.append("u16 0-1 ${idU16(0) - idU16(1)}")
    out.append("i32 max+1 ${idI32(2147483647) + idI32(1)}")
    out.append("i32 min-1 ${idI32(-2147483648) - idI32(1)}")
    out.append("i32 min*-1 ${idI32(-2147483648) * idI32(-1)}")
    out.append("i32 65536*65536 ${idI32(65536) * idI32(65536)}")
    out.append("u32 max+1 ${idU32(4294967295) + idU32(1)}")
    out.append("u32 0-1 ${idU32(0) - idU32(1)}")
    out.append("u32 max*max ${idU32(4294967295) * idU32(4294967295)}")
    out.append("u64 max+1 ${big + idU64(u64(1))}")
    out.append("u64 0-1 ${idU64(u64(0)) - idU64(u64(1))}")
    out.append("u64 max*2 ${big * idU64(u64(2))}")
    // division and remainder
    out.append("-7/2 ${idI(-7) / idI(2)}")
    out.append("7/-2 ${idI(7) / idI(-2)}")
    out.append("-7/-2 ${idI(-7) / idI(-2)}")
    out.append("-7%3 ${idI(-7) % idI(3)}")
    out.append("7%-3 ${idI(7) % idI(-3)}")
    out.append("-7%-3 ${idI(-7) % idI(-3)}")
    out.append("min/-1 ${min / neg1}")
    out.append("min%-1 ${min % neg1}")
    out.append("i8 -128/-1 ${idI8(-128) / idI8(-1)}")
    out.append("i8 -128%-1 ${idI8(-128) % idI8(-1)}")
    out.append("i8 -7/2 ${idI8(-7) / idI8(2)}")
    out.append("i8 -7%2 ${idI8(-7) % idI8(2)}")
    out.append("i16 min/-1 ${idI16(-32768) / idI16(-1)}")
    out.append("i32 min/-1 ${idI32(-2147483648) / idI32(-1)}")
    out.append("i32 min%-1 ${idI32(-2147483648) % idI32(-1)}")
    out.append("i32 -7/2 ${idI32(-7) / idI32(2)}")
    out.append("u8 200/7 ${idU8(200) / idU8(7)}")
    out.append("u8 200%7 ${idU8(200) % idU8(7)}")
    out.append("u16 60000/7 ${idU16(60000) / idU16(7)}")
    out.append("u32 4000000000/3 ${idU32(4000000000) / idU32(3)}")
    out.append("u32 4000000000%7 ${idU32(4000000000) % idU32(7)}")
    out.append("u64 max/3 ${big / idU64(u64(3))}")
    out.append("u64 max%10 ${big % idU64(u64(10))}")
    out.append("u64 max/max ${big / big}")
    // shifts
    out.append("1<<62 ${one << idI(62)}")
    out.append("1<<63 ${one << idI(63)}")
    out.append("1<<64 ${one << idI(64)}")
    out.append("1<<100 ${one << idI(100)}")
    out.append("1<<-1 ${one << neg1}")
    out.append("-8>>1 ${idI(-8) >> one}")
    out.append("-8>>63 ${idI(-8) >> idI(63)}")
    out.append("-8>>64 ${idI(-8) >> idI(64)}")
    out.append("-8>>-1 ${idI(-8) >> neg1}")
    out.append("8>>64 ${idI(8) >> idI(64)}")
    out.append("-8>>>1 ${idI(-8) >>> one}")
    out.append("-8>>>63 ${idI(-8) >>> idI(63)}")
    out.append("-8>>>64 ${idI(-8) >>> idI(64)}")
    out.append("-8>>>-1 ${idI(-8) >>> neg1}")
    out.append("i32 1<<31 ${idI32(1) << idI32(31)}")
    out.append("i32 1<<32 ${idI32(1) << idI32(32)}")
    out.append("i32 -8>>32 ${idI32(-8) >> idI32(32)}")
    out.append("i32 -8>>33 ${idI32(-8) >> idI32(33)}")
    out.append("i32 -8>>>1 ${idI32(-8) >>> idI32(1)}")
    out.append("i32 -8>>>32 ${idI32(-8) >>> idI32(32)}")
    out.append("u32 1<<31 ${idU32(1) << idU32(31)}")
    out.append("u32 1<<32 ${idU32(1) << idU32(32)}")
    out.append("u32 max>>31 ${idU32(4294967295) >> idU32(31)}")
    out.append("u32 max>>32 ${idU32(4294967295) >> idU32(32)}")
    out.append("u8 255<<1 ${idU8(255) << idU8(1)}")
    out.append("u8 255<<7 ${idU8(255) << idU8(7)}")
    out.append("u8 255<<8 ${idU8(255) << idU8(8)}")
    out.append("u8 255>>7 ${idU8(255) >> idU8(7)}")
    out.append("u8 255>>8 ${idU8(255) >> idU8(8)}")
    out.append("i8 -128>>7 ${idI8(-128) >> idI8(7)}")
    out.append("i8 -128>>8 ${idI8(-128) >> idI8(8)}")
    out.append("i8 -128>>>7 ${idI8(-128) >>> idI8(7)}")
    out.append("i8 1<<7 ${idI8(1) << idI8(7)}")
    out.append("i8 1<<8 ${idI8(1) << idI8(8)}")
    out.append("i8 1<<-1 ${idI8(1) << idI8(-1)}")
    out.append("i16 1<<15 ${idI16(1) << idI16(15)}")
    out.append("i16 -1>>16 ${idI16(-1) >> idI16(16)}")
    out.append("u16 65535>>15 ${idU16(65535) >> idU16(15)}")
    out.append("u64 max>>63 ${big >> idU64(u64(63))}")
    out.append("u64 max>>64 ${big >> idU64(u64(64))}")
    out.append("u64 1<<63 ${idU64(u64(1)) << idU64(u64(63))}")
    out.append("u64 1<<64 ${idU64(u64(1)) << idU64(u64(64))}")
    out.append("1<<u8(3) ${one << idU8(3)}")
    out.append("1<<i8(-1) ${one << idI8(-1)}")
    out.append("1<<u64max ${one << big}")
    out.append("i32 1<<int(33) ${idI32(1) << idI(33)}")
    out.append("u8 255>>int(-1) ${idU8(255) >> idI(-1)}")
    // conversions between integer types
    out.append("i8(200) ${i8(idI(200))}")
    out.append("i8(-129) ${i8(idI(-129))}")
    out.append("i8(u8 255) ${i8(idU8(255))}")
    out.append("u8(-1) ${u8(idI(-1))}")
    out.append("u8(256) ${u8(idI(256))}")
    out.append("u8(i8 -1) ${u8(idI8(-1))}")
    out.append("u8(min) ${u8(min)}")
    out.append("i16(40000) ${i16(idI(40000))}")
    out.append("u16(65537) ${u16(idI(65537))}")
    out.append("u16(i8 -1) ${u16(idI8(-1))}")
    out.append("i32(2147483648) ${i32(idI(2147483648))}")
    out.append("i32(u32 max) ${i32(idU32(4294967295))}")
    out.append("u32(-1) ${u32(neg1)}")
    out.append("u32(4294967296) ${u32(idI(4294967296))}")
    out.append("u32(i8 -1) ${u32(idI8(-1))}")
    out.append("u32(i32 -1) ${u32(idI32(-1))}")
    out.append("u64(-1) ${u64(neg1)}")
    out.append("u64(i8 -1) ${u64(idI8(-1))}")
    out.append("u64(u32 max) ${u64(idU32(4294967295))}")
    out.append("int(u64 max) ${int(big)}")
    out.append("int(u32 max) ${int(idU32(4294967295))}")
    out.append("int(i8 -5) ${int(idI8(-5))}")
    out.append("int(u8 250) ${int(idU8(250))}")
    out.append("int(i32 min) ${int(idI32(-2147483648))}")
    out.append("i64(u64 max) ${int(big) + 0}")
    // compare signed and unsigned
    out.append("u64 max>1 ${big > idU64(u64(1))}")
    out.append("u64 max<0 ${big < idU64(u64(0))}")
    out.append("u64 2^63>1 ${idU64(u64(9223372036854775808)) > idU64(u64(1))}")
    out.append("u32 max>1 ${idU32(4294967295) > idU32(1)}")
    out.append("u8 200>100 ${idU8(200) > idU8(100)}")
    out.append("i8 -1<1 ${idI8(-1) < idI8(1)}")
    out.append("u8 255==u8(-1) ${idU8(255) == u8(idI(-1))}")
    // bitwise
    out.append("~0 ${~idI(0)}")
    out.append("u8 ~0 ${~idU8(0)}")
    out.append("u8 ~255 ${~idU8(255)}")
    out.append("i8 ~0 ${~idI8(0)}")
    out.append("u32 ~0 ${~idU32(0)}")
    out.append("u64 ~0 ${~idU64(u64(0))}")
    out.append("i32 -1&255 ${idI32(-1) & idI32(255)}")
    out.append("u8 255^15 ${idU8(255) ^ idU8(15)}")
    // float to integer
    out.append("f64ToInt 1.9 ${f64ToInt(idF(1.9))}")
    out.append("f64ToInt -1.9 ${f64ToInt(idF(-1.9))}")
    out.append("f64ToInt 0.5 ${f64ToInt(idF(0.5))}")
    out.append("f64ToInt -0.5 ${f64ToInt(idF(-0.5))}")
    out.append("f64ToInt 1e19 ${f64ToInt(idF(1.0e19))}")
    out.append("f64ToInt -1e19 ${f64ToInt(idF(-1.0e19))}")
    out.append("f64ToInt 2^63 ${f64ToInt(idF(9223372036854775808.0))}")
    out.append("f64ToInt -2^63 ${f64ToInt(idF(-9223372036854775808.0))}")
    out.append("f64ToInt 2^63-1024 ${f64ToInt(idF(9223372036854774784.0))}")
    out.append("f64ToInt nan ${f64ToInt(nan)}")
    out.append("f64ToInt inf ${f64ToInt(inf)}")
    out.append("f64ToInt -inf ${f64ToInt(ninf)}")
    out.append("f64ToInt 1e300 ${f64ToInt(idF(1.0e300))}")
    out.append("f64ToInt 2^53+2 ${f64ToInt(idF(9007199254740994.0))}")
    out.append("f32ToInt 1.9 ${f32ToInt(idF32(f32(1.9)))}")
    out.append("f32ToInt -1.9 ${f32ToInt(idF32(f32(-1.9)))}")
    out.append("f32ToInt 1e19 ${f32ToInt(idF32(f32(1.0e19)))}")
    out.append("f32ToInt nan ${f32ToInt(f64ToF32(nan))}")
    out.append("f32ToInt inf ${f32ToInt(f64ToF32(inf))}")
    out.append("f32ToI32 3e9 ${f32ToI32(idF32(f32(3.0e9)))}")
    out.append("f32ToI32 -3e9 ${f32ToI32(idF32(f32(-3.0e9)))}")
    out.append("f32ToI32 2^31 ${f32ToI32(idF32(f32(2147483648.0)))}")
    out.append("f32ToI32 1.9 ${f32ToI32(idF32(f32(1.9)))}")
    out.append("f32ToI32 -1.9 ${f32ToI32(idF32(f32(-1.9)))}")
    out.append("f32ToI32 nan ${f32ToI32(f64ToF32(nan))}")
    out.append("f32ToI32 inf ${f32ToI32(f64ToF32(inf))}")
    out.append("f32ToU32 -1 ${f32ToU32(idF32(f32(-1.0)))}")
    out.append("f32ToU32 5e9 ${f32ToU32(idF32(f32(5.0e9)))}")
    out.append("f32ToU32 2^32 ${f32ToU32(idF32(f32(4294967296.0)))}")
    out.append("f32ToU32 4294967040 ${f32ToU32(idF32(f32(4294967040.0)))}")
    out.append("f32ToU32 nan ${f32ToU32(f64ToF32(nan))}")
    out.append("f32ToU32 inf ${f32ToU32(f64ToF32(inf))}")
    out.append("f32ToU32 0.9 ${f32ToU32(idF32(f32(0.9)))}")
    // integer to float
    out.append("f64FromInt max ${f64FromInt(max)}")
    out.append("f64FromInt min ${f64FromInt(min)}")
    out.append("f64FromInt 2^53+1 ${f64FromInt(idI(9007199254740993))}")
    out.append("f64FromInt 2^53+3 ${f64FromInt(idI(9007199254740995))}")
    out.append("f64FromInt -(2^53+1) ${f64FromInt(idI(-9007199254740993))}")
    out.append("f32FromInt 16777217 ${f32ToF64(f32FromInt(idI(16777217)))}")
    out.append("f32FromInt 16777219 ${f32ToF64(f32FromInt(idI(16777219)))}")
    out.append("f32FromInt max ${f32ToF64(f32FromInt(max))}")
    out.append("f32FromInt min ${f32ToF64(f32FromInt(min))}")
    out.append("f32FromInt 2^40+1 ${f32ToF64(f32FromInt(idI(1099511627777)))}")
    out.append("f32FromI32 max ${f32ToF64(f32FromI32(idI32(2147483647)))}")
    out.append("f32FromI32 16777217 ${f32ToF64(f32FromI32(idI32(16777217)))}")
    out.append("f32FromU32 max ${f32ToF64(f32FromU32(idU32(4294967295)))}")
    out.append("f32FromU32 16777217 ${f32ToF64(f32FromU32(idU32(16777217)))}")
    out.append("f32FromU32 2^31+1 ${f32ToF64(f32FromU32(idU32(2147483649)))}")
    // f64 <-> f32
    out.append("f64ToF32 0.1 ${f32ToF64(f64ToF32(idF(0.1)))}")
    out.append("f64ToF32 1e40 ${f32ToF64(f64ToF32(idF(1.0e40)))}")
    out.append("f64ToF32 -1e40 ${f32ToF64(f64ToF32(idF(-1.0e40)))}")
    out.append("f64ToF32 1e-50 ${f32ToF64(f64ToF32(idF(1.0e-50)))}")
    out.append("f64ToF32 1e-45 ${f32ToF64(f64ToF32(idF(1.0e-45)))}")
    out.append("f64ToF32 3.4028235677973366e38 ${f32ToF64(f64ToF32(idF(3.4028235677973366e38)))}")
    out.append("f64ToF32 3.4028236e38 ${f32ToF64(f64ToF32(idF(3.4028236e38)))}")
    out.append("f64ToF32 nan ${f32ToF64(f64ToF32(nan))}")
    out.append("f64ToF32 16777217 ${f32ToF64(f64ToF32(idF(16777217.0)))}")
    out.append("f64ToF32 halfway ${f32ToF64(f64ToF32(idF(16777218.999999996)))}")
    // float arithmetic
    out.append("0.1+0.2 ${idF(0.1) + idF(0.2)}")
    out.append("f32 0.1+0.2 ${f32ToF64(idF32(f32(0.1)) + idF32(f32(0.2)))}")
    out.append("f32 1e38*10 ${f32ToF64(idF32(f32(1.0e38)) * idF32(f32(10.0)))}")
    out.append("f32 16777216+1 ${f32ToF64(idF32(f32(16777216.0)) + idF32(f32(1.0)))}")
    out.append("f32 1/3 ${f32ToF64(idF32(f32(1.0)) / idF32(f32(3.0)))}")
    out.append("1/0 ${inf}")
    out.append("-1/0 ${ninf}")
    out.append("0/0 ${nan}")
    out.append("inf-inf ${inf - inf}")
    out.append("inf*0 ${inf * idF(0.0)}")
    out.append("1e308*10 ${idF(1.0e308) * idF(10.0)}")
    out.append("5e-324/2 ${idF(5.0e-324) / idF(2.0)}")
    out.append("5.5%2 ${idF(5.5) % idF(2.0)}")
    out.append("-5.5%2 ${idF(-5.5) % idF(2.0)}")
    out.append("5.5%-2 ${idF(5.5) % idF(-2.0)}")
    out.append("5.5%0 ${idF(5.5) % idF(0.0)}")
    out.append("inf%2 ${inf % idF(2.0)}")
    out.append("5%inf ${idF(5.0) % inf}")
    out.append("-0.0 ${idF(0.0) * idF(-1.0)}")
    out.append("1/-0.0 ${idF(1.0) / (idF(0.0) * idF(-1.0))}")
    out.append("-nan ${-nan}")
    out.append("f64 min*max ${idF(1.7976931348623157e308) * idF(2.0)}")
    // float comparisons
    out.append("nan==nan ${nan == nan}")
    out.append("nan!=nan ${nan != nan}")
    out.append("nan<1 ${nan < idF(1.0)}")
    out.append("nan>1 ${nan > idF(1.0)}")
    out.append("nan<=nan ${nan <= nan}")
    out.append("nan>=nan ${nan >= nan}")
    out.append("0==-0 ${idF(0.0) == (idF(0.0) * idF(-1.0))}")
    out.append("inf>max ${inf > idF(1.7976931348623157e308)}")
    out.append("-inf<-max ${ninf < idF(-1.7976931348623157e308)}")
    out.append("f32 nan==nan ${f64ToF32(nan) == f64ToF32(nan)}")
    out.append("f32 nan!=nan ${f64ToF32(nan) != f64ToF32(nan)}")
    out.append("f32 1<2 ${idF32(f32(1.0)) < idF32(f32(2.0))}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) {
        println("SIZES ${live.size} ${staged.size}")
        bad = 1
    }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println("LIVE ${line}")
    bad
}
