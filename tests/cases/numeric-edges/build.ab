import "abla/wasm/build"

val release = #wasmBuildModule(
    "numeric",
    "tests/cases/numeric-edges/module.ab",
    "build/numeric-edges/numeric.wasm",
    false,
    false
)
val development = #buildProgram(
    "numeric-dev",
    "tests/cases/numeric-edges/module.ab",
    "build/numeric-edges/numeric-dev.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && development) 0 else 1
