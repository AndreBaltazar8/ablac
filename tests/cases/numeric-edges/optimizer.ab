// Table-driven numeric edge cases (generated once from a reviewed list; the values were checked against the language
// rules in docs/language.md, IEEE 754 / C99 and Node 22 for abla/math). Each case runs as ordinary code and under `#`;
// main exits with the number of cases where the two differ and prints every result for tools/test-numeric-edges.sh.
import "abla/io"

@noinline fun idI(x: int): int = x
@noinline fun idI8(x: i8): i8 = x
@noinline fun idU8(x: u8): u8 = x
@noinline fun idI32(x: i32): i32 = x
@noinline fun idU32(x: u32): u32 = x
@noinline fun idU64(x: u64): u64 = x

// Things an optimizer may fold if it believes integer arithmetic cannot wrap.
fun addOverflows(x: int): bool = x + 1 < x
fun addOverflowsGt(x: int): bool = x + 1 > x
fun addAssoc(x: int, y: int): bool = (x + y) - y == x
fun mulDivRoundTrip(x: int): bool = x * 2 / 2 == x
fun shiftRoundTrip(x: int): bool = (x << 1) >> 1 == x
fun negIsSelf(x: int): bool = -x == x
fun absOf(x: int): int = if (x < 0) -x else x
fun absIsNegative(x: int): bool = absOf(x) < 0
fun subOverflows(a: int, b: int): bool = a - b > a
fun twiceIsSmaller(x: int): bool = x * 2 < x
fun i32AddOverflows(x: i32): bool = x + i32(1) < x
fun i32MulOverflows(x: i32): bool = x * i32(2) / i32(2) != x
fun i8AddOverflows(x: i8): bool = x + i8(1) < x
fun u8AddWraps(x: u8): bool = x + u8(1) < x
fun u32AddWraps(x: u32): bool = x + u32(1) < x
fun u32MulWraps(x: u32): bool = x * u32(2) < x
fun u64AddWraps(x: u64): bool = x + u64(1) < x
fun u64SubWraps(x: u64): bool = x - u64(1) > x
fun loopCount(start: int): int {
    // counts how many iterations until i + 1 wraps below i (i overflows once)
    var i = start
    var count = 0
    while (i + 1 > i && count < 5) {
        i = i + 1
        count = count + 1
    }
    count
}
fun u8Loop(): int {
    var i = idU8(250)
    var count = 0
    while (count < 20) {
        i = i + u8(1)
        count = count + 1
        if (i == u8(0)) return count
    }
    -1
}
fun i32Loop(): int {
    var i = idI32(2147483646)
    var count = 0
    while (count < 6) {
        i = i + i32(1)
        count = count + 1
        if (i < i32(0)) return count
    }
    -1
}
fun overflowCheckPattern(a: int, b: int): bool {
    // the classic signed-overflow test before adding
    val sum = a + b
    (a > 0 && b > 0 && sum < 0) || (a < 0 && b < 0 && sum >= 0)
}
fun midpoint(a: int, b: int): int = (a + b) / 2
fun shiftedIndex(x: int): int = (x << 62) >> 62
fun divMinNeg1(x: int, y: int): int = x / y
fun remMinNeg1(x: int, y: int): int = x % y
fun i32DivMinNeg1(x: i32, y: i32): i32 = x / y
fun hashStep(h: u32): u32 = h * u32(16777619) ^ u32(2166136261)
fun fnv(): u32 {
    var h = u32(2166136261)
    for (b in 0 until 64) h = (h ^ u32(b)) * u32(16777619)
    h
}
fun lcg(): u64 {
    var s = u64(88172645463325252)
    for (i in 0 until 100) s = s * u64(6364136223846793005) + u64(1442695040888963407)
    s
}

fun cases(): array<string> {
    val out: array<string> = []
    val max = idI(9223372036854775807)
    val min = idI(-9223372036854775807 - 1)
    out.append("x+1<x max ${addOverflows(max)}")
    out.append("x+1>x max ${addOverflowsGt(max)}")
    out.append("(x+y)-y==x ${addAssoc(max, idI(5))} ${addAssoc(min, idI(-5))}")
    out.append("x*2/2==x max ${mulDivRoundTrip(max)}")
    out.append("x*2/2==x 2^62 ${mulDivRoundTrip(idI(4611686018427387904))}")
    out.append("(x<<1)>>1==x ${shiftRoundTrip(max)} ${shiftRoundTrip(idI(4611686018427387904))}")
    out.append("-x==x min ${negIsSelf(min)} 0 ${negIsSelf(idI(0))}")
    out.append("abs(min)<0 ${absIsNegative(min)}")
    out.append("a-b>a ${subOverflows(min, idI(1))} ${subOverflows(idI(0), min)}")
    out.append("x*2<x ${twiceIsSmaller(idI(4611686018427387904))} ${twiceIsSmaller(idI(4611686018427387905))}")
    out.append("i32 x+1<x ${i32AddOverflows(idI32(2147483647))}")
    out.append("i32 x*2/2!=x ${i32MulOverflows(idI32(1073741824))}")
    out.append("i8 x+1<x ${i8AddOverflows(idI8(127))}")
    out.append("u8 x+1<x ${u8AddWraps(idU8(255))}")
    out.append("u32 x+1<x ${u32AddWraps(idU32(4294967295))}")
    out.append("u32 x*2<x ${u32MulWraps(idU32(3000000000))}")
    out.append("u64 x+1<x ${u64AddWraps(idU64(u64(18446744073709551615)))}")
    out.append("u64 x-1>x ${u64SubWraps(idU64(u64(0)))}")
    out.append("loop at max ${loopCount(idI(9223372036854775805))}")
    out.append("u8 loop ${u8Loop()}")
    out.append("i32 loop ${i32Loop()}")
    out.append("overflow pattern ${overflowCheckPattern(max, idI(1))} ${overflowCheckPattern(min, idI(-1))} ${overflowCheckPattern(idI(1), idI(2))}")
    out.append("midpoint ${midpoint(max, idI(1))}")
    out.append("(x<<62)>>62 ${shiftedIndex(idI(3))} ${shiftedIndex(idI(1))} ${shiftedIndex(idI(2))}")
    out.append("min/-1 ${divMinNeg1(min, idI(-1))} min%-1 ${remMinNeg1(min, idI(-1))}")
    out.append("i32 min/-1 ${i32DivMinNeg1(idI32(-2147483648), idI32(-1))}")
    out.append("fnv ${fnv()} lcg ${lcg()}")
    out.append("hashStep ${hashStep(idU32(123456789))}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) {
        println("SIZES ${live.size} ${staged.size}")
        bad = 1
    }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println("LIVE ${line}")
    bad
}
