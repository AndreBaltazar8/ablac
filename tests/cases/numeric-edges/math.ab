// Table-driven numeric edge cases (generated once from a reviewed list; the values were checked against the language
// rules in docs/language.md, IEEE 754 / C99 and Node 22 for abla/math). Each case runs as ordinary code and under `#`;
// main exits with the number of cases where the two differ and prints every result for tools/test-numeric-edges.sh.
import "abla/io"
import "abla/float"
import "abla/float/text"
import "abla/math"

@noinline fun idF(x: f64): f64 = x
@noinline fun idI(x: int): int = x

// a value and its sign when it is a zero
fun z(x: f64): string = if (x == 0.0) (if (1.0 / x < 0.0) "-0" else "+0") else "${x}"

fun cases(): array<string> {
    val out: array<string> = []
    val nan = idF(0.0) / idF(0.0)
    val inf = idF(1.0) / idF(0.0)
    val ninf = idF(-1.0) / idF(0.0)
    val nz = idF(0.0) * idF(-1.0)
    out.append("sqrt 2 ${sqrt(idF(2.0))}")
    out.append("sqrt -1 ${sqrt(idF(-1.0))}")
    out.append("sqrt -0 ${z(sqrt(nz))}")
    out.append("sqrt inf ${sqrt(inf)}")
    out.append("sqrt 5e-324 ${sqrt(idF(5.0e-324))}")
    out.append("floor -0.5 ${floor(idF(-0.5))}")
    out.append("floor 0.5 ${z(floor(idF(0.5)))}")
    out.append("floor -0 ${z(floor(nz))}")
    out.append("ceil -0.5 ${z(ceil(idF(-0.5)))}")
    out.append("ceil 0.5 ${ceil(idF(0.5))}")
    out.append("ceil 2^52+1 ${ceil(idF(4503599627370497.0))}")
    out.append("floor nan ${floor(nan)}")
    out.append("floor inf ${floor(inf)}")
    out.append("floor -inf ${floor(ninf)}")
    out.append("floor 1e300 ${floor(idF(1.0e300))}")
    out.append("trunc -1.5 ${trunc(idF(-1.5))}")
    out.append("trunc -0.5 ${z(trunc(idF(-0.5)))}")
    out.append("trunc 1e300 ${trunc(idF(1.0e300))}")
    out.append("roundEven 0.5 ${z(roundEven(idF(0.5)))}")
    out.append("roundEven 1.5 ${roundEven(idF(1.5))}")
    out.append("roundEven 2.5 ${roundEven(idF(2.5))}")
    out.append("roundEven -0.5 ${z(roundEven(idF(-0.5)))}")
    out.append("roundEven -1.5 ${roundEven(idF(-1.5))}")
    out.append("roundEven -2.5 ${roundEven(idF(-2.5))}")
    out.append("roundEven 2^52-0.5 ${roundEven(idF(4503599627370495.5))}")
    out.append("roundEven 2^52+0.5? ${roundEven(idF(4503599627370497.0))}")
    out.append("roundEven nan ${roundEven(nan)}")
    out.append("fabs -0 ${z(fabs(nz))}")
    out.append("fabs -inf ${fabs(ninf)}")
    out.append("fabs -nan ${fabs(-nan)}")
    out.append("fmin 1 nan ${fmin(idF(1.0), nan)}")
    out.append("fmin nan 1 ${fmin(nan, idF(1.0))}")
    out.append("fmax 1 nan ${fmax(idF(1.0), nan)}")
    out.append("fmin -0 +0 ${z(fmin(nz, idF(0.0)))}")
    out.append("fmin +0 -0 ${z(fmin(idF(0.0), nz))}")
    out.append("fmax -0 +0 ${z(fmax(nz, idF(0.0)))}")
    out.append("fmax +0 -0 ${z(fmax(idF(0.0), nz))}")
    out.append("fmin -inf inf ${fmin(ninf, inf)}")
    out.append("fclamp 5 1 3 ${fclamp(idF(5.0), idF(1.0), idF(3.0))}")
    out.append("fclamp nan 1 3 ${fclamp(nan, idF(1.0), idF(3.0))}")
    out.append("isFinite inf ${isFinite(inf)} nan ${isFinite(nan)} 1e308 ${isFinite(idF(1.0e308))}")
    out.append("isNaN ${isNaN(nan)} ${isNaN(inf)} ${isNaN(idF(1.0))}")
    out.append("fma 2 3 4 ${fma(idF(2.0), idF(3.0), idF(4.0))}")
    out.append("fma exact ${fma(idF(134217729.0), idF(134217729.0), idF(-18014398777917440.0))}")
    out.append("fma inf 0 1 ${fma(inf, idF(0.0), idF(1.0))}")
    out.append("fma 1e308 10 -1e308 ${fma(idF(1.0e308), idF(10.0), idF(-1.0e308))}")
    out.append("pow 2 10 ${pow(idF(2.0), idF(10.0))}")
    out.append("pow 2 .5 ${pow(idF(2.0), idF(0.5))}")
    out.append("pow 0 0 ${pow(idF(0.0), idF(0.0))}")
    out.append("pow nan 0 ${pow(nan, idF(0.0))}")
    out.append("pow 1 nan ${pow(idF(1.0), nan)}")
    out.append("pow -8 1/3 ${pow(idF(-8.0), idF(1.0) / idF(3.0))}")
    out.append("pow -2 3 ${pow(idF(-2.0), idF(3.0))}")
    out.append("pow -2 -3 ${pow(idF(-2.0), idF(-3.0))}")
    out.append("pow 2 -1074 ${pow(idF(2.0), idF(-1074.0))}")
    out.append("pow 2 -1075 ${pow(idF(2.0), idF(-1075.0))}")
    out.append("pow 2 1023 ${pow(idF(2.0), idF(1023.0))}")
    out.append("pow 2 1024 ${pow(idF(2.0), idF(1024.0))}")
    out.append("pow 0 -1 ${pow(idF(0.0), idF(-1.0))}")
    out.append("pow -0 -1 ${pow(nz, idF(-1.0))}")
    out.append("pow -0 -2 ${pow(nz, idF(-2.0))}")
    out.append("pow -0 3 ${z(pow(nz, idF(3.0)))}")
    out.append("pow 10 308 ${pow(idF(10.0), idF(308.0))}")
    out.append("pow 10 -5 ${pow(idF(10.0), idF(-5.0))}")
    out.append("pow 10 22 ${pow(idF(10.0), idF(22.0))}")
    out.append("pow 1.0000001 1e7 ${pow(idF(1.0000001), idF(1.0e7))}")
    out.append("pow inf 0.5 ${pow(inf, idF(0.5))}")
    out.append("pow inf -1 ${pow(inf, idF(-1.0))}")
    out.append("pow 0.5 inf ${pow(idF(0.5), inf)}")
    out.append("pow 2 inf ${pow(idF(2.0), inf)}")
    out.append("pow 2 -inf ${pow(idF(2.0), ninf)}")
    out.append("pow -1 inf ${pow(idF(-1.0), inf)}")
    out.append("pow -inf 3 ${pow(ninf, idF(3.0))}")
    out.append("pow -inf 2 ${pow(ninf, idF(2.0))}")
    out.append("exp 1 ${exp(idF(1.0))}")
    out.append("exp 0 ${exp(idF(0.0))}")
    out.append("exp -0 ${exp(nz)}")
    out.append("exp 710 ${exp(idF(710.0))}")
    out.append("exp 709.782712893384 ${exp(idF(709.782712893384))}")
    out.append("exp -745.1332191019412 ${exp(idF(-745.1332191019412))}")
    out.append("exp -746 ${exp(idF(-746.0))}")
    out.append("exp -inf ${exp(ninf)}")
    out.append("exp inf ${exp(inf)}")
    out.append("exp nan ${exp(nan)}")
    out.append("exp 1e-300 ${exp(idF(1.0e-300))}")
    out.append("exp 0.5 ${exp(idF(0.5))}")
    out.append("exp -1 ${exp(idF(-1.0))}")
    out.append("exp 100 ${exp(idF(100.0))}")
    out.append("log 1 ${z(log(idF(1.0)))}")
    out.append("log 0 ${log(idF(0.0))}")
    out.append("log -0 ${log(nz)}")
    out.append("log -1 ${log(idF(-1.0))}")
    out.append("log inf ${log(inf)}")
    out.append("log nan ${log(nan)}")
    out.append("log e ${log(idF(2.718281828459045))}")
    out.append("log 10 ${log(idF(10.0))}")
    out.append("log 5e-324 ${log(idF(5.0e-324))}")
    out.append("log max ${log(idF(1.7976931348623157e308))}")
    out.append("log 2 ${log(idF(2.0))}")
    out.append("log 0.5 ${log(idF(0.5))}")
    out.append("log 1.0000000000000002 ${log(idF(1.0000000000000002))}")
    out.append("sin 0 ${z(sin(idF(0.0)))}")
    out.append("sin -0 ${z(sin(nz))}")
    out.append("sin 1 ${sin(idF(1.0))}")
    out.append("sin pi ${sin(idF(3.141592653589793))}")
    out.append("sin 1e22 ${sin(idF(1.0e22))}")
    out.append("sin inf ${sin(inf)}")
    out.append("sin nan ${sin(nan)}")
    out.append("sin 1e300 ${sin(idF(1.0e300))}")
    out.append("sin 2^53 ${sin(idF(9007199254740992.0))}")
    out.append("sin 5e-324 ${sin(idF(5.0e-324))}")
    out.append("cos 0 ${cos(idF(0.0))}")
    out.append("cos pi ${cos(idF(3.141592653589793))}")
    out.append("cos 1e22 ${cos(idF(1.0e22))}")
    out.append("cos inf ${cos(inf)}")
    out.append("cos pi/2 ${cos(idF(1.5707963267948966))}")
    out.append("cos 1e300 ${cos(idF(1.0e300))}")
    out.append("tan pi/2 ${tan(idF(1.5707963267948966))}")
    out.append("tan 1 ${tan(idF(1.0))}")
    out.append("tan inf ${tan(inf)}")
    out.append("atan 1 ${atan(idF(1.0))}")
    out.append("atan inf ${atan(inf)}")
    out.append("atan -inf ${atan(ninf)}")
    out.append("atan nan ${atan(nan)}")
    out.append("atan -0 ${z(atan(nz))}")
    out.append("atan 1e-300 ${atan(idF(1.0e-300))}")
    out.append("atan 1e300 ${atan(idF(1.0e300))}")
    out.append("atan2 1 1 ${atan2(idF(1.0), idF(1.0))}")
    out.append("atan2 0 -1 ${atan2(idF(0.0), idF(-1.0))}")
    out.append("atan2 -0 -1 ${atan2(nz, idF(-1.0))}")
    out.append("atan2 0 0 ${z(atan2(idF(0.0), idF(0.0)))}")
    out.append("atan2 0 -0 ${atan2(idF(0.0), nz)}")
    out.append("atan2 -0 -0 ${atan2(nz, nz)}")
    out.append("atan2 -0 0 ${z(atan2(nz, idF(0.0)))}")
    out.append("atan2 inf inf ${atan2(inf, inf)}")
    out.append("atan2 -inf -inf ${atan2(ninf, ninf)}")
    out.append("atan2 1 -inf ${atan2(idF(1.0), ninf)}")
    out.append("atan2 -1 inf ${z(atan2(idF(-1.0), inf))}")
    out.append("atan2 inf 1 ${atan2(inf, idF(1.0))}")
    out.append("atan2 nan 1 ${atan2(nan, idF(1.0))}")
    out.append("atan2 -1 -1 ${atan2(idF(-1.0), idF(-1.0))}")
    out.append("atan2 1 0 ${atan2(idF(1.0), idF(0.0))}")
    out.append("atan2 1 5e-324 ${atan2(idF(1.0), idF(5.0e-324))}")
    out.append("atan2 5e-324 1 ${atan2(idF(5.0e-324), idF(1.0))}")
    out.append("hypot 3 4 ${hypot(idF(3.0), idF(4.0))}")
    out.append("hypot inf nan ${hypot(inf, nan)}")
    out.append("hypot nan inf ${hypot(nan, inf)}")
    out.append("hypot nan 1 ${hypot(nan, idF(1.0))}")
    out.append("hypot -3 4 ${hypot(idF(-3.0), idF(4.0))}")
    out.append("hypot 1e308 1e308 ${hypot(idF(1.0e308), idF(1.0e308))}")
    out.append("hypot 1e-320 1e-320 ${hypot(idF(1.0e-320), idF(1.0e-320))}")
    out.append("hypot 0 0 ${z(hypot(idF(0.0), idF(0.0)))}")
    out.append("hypot 1 1 ${hypot(idF(1.0), idF(1.0))}")
    out.append("lerp 0 10 .25 ${lerp(idF(0.0), idF(10.0), idF(0.25))}")
    // integer helpers
    out.append("min max ${min(idI(3), idI(-4))} ${max(idI(3), idI(-4))}")
    out.append("clamp ${clamp(idI(5), idI(1), idI(3))} ${clamp(idI(-5), idI(1), idI(3))} ${clamp(idI(2), idI(1), idI(3))}")
    out.append("clamp min>max ${clamp(idI(5), idI(3), idI(1))}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) {
        println("SIZES ${live.size} ${staged.size}")
        bad = 1
    }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println("LIVE ${line}")
    bad
}
