// Table-driven numeric edge cases (generated once from a reviewed list; the values were checked against the language
// rules in docs/language.md, IEEE 754 / C99 and Node 22 for abla/math). Each case runs as ordinary code and under `#`;
// main exits with the number of cases where the two differ and prints every result for tools/test-numeric-edges.sh.
import "abla/io"
import "abla/float"
import "abla/float/text"
import "abla/integer"

@noinline fun idI(x: int): int = x
@noinline fun idU8(x: u8): u8 = x
@noinline fun idI8(x: i8): i8 = x
@noinline fun idU32(x: u32): u32 = x
@noinline fun idU64(x: u64): u64 = x

class Packed(var a: u8, var b: i8, var c: u16, var d: i32, var e: u32, var f: u64)

fun showInt(value: int?): string = if (value == null) "null" else "${value}"

fun cases(): array<string> {
    val out: array<string> = []
    // the same operations on literals, which the compiler may fold
    out.append("lit max+1 ${9223372036854775807 + 1}")
    out.append("lit min-1 ${-9223372036854775807 - 1 - 1}")
    out.append("lit max*3 ${9223372036854775807 * 3}")
    out.append("lit -7/2 ${-7 / 2}")
    out.append("lit -7%3 ${-7 % 3}")
    out.append("lit 7%-3 ${7 % -3}")
    out.append("lit 1<<64 ${1 << 64}")
    out.append("lit 1<<63 ${1 << 63}")
    out.append("lit -8>>1 ${-8 >> 1}")
    out.append("lit -8>>>1 ${-8 >>> 1}")
    out.append("lit -8>>70 ${-8 >> 70}")
    out.append("lit 1<<-1 ${1 << -1}")
    out.append("lit u8 250+10 ${u8(250) + u8(10)}")
    out.append("lit u8 0-1 ${u8(0) - u8(1)}")
    out.append("lit i8 127+1 ${i8(127) + i8(1)}")
    out.append("lit i8 -128/-1 ${i8(-128) / i8(-1)}")
    out.append("lit i8 -128%-1 ${i8(-128) % i8(-1)}")
    out.append("lit i32 min/-1 ${i32(-2147483648) / i32(-1)}")
    out.append("lit u8 255<<1 ${u8(255) << u8(1)}")
    out.append("lit u8 255>>8 ${u8(255) >> u8(8)}")
    out.append("lit u32 max+1 ${u32(4294967295) + u32(1)}")
    out.append("lit u64 max+1 ${u64(18446744073709551615) + u64(1)}")
    out.append("lit u64 max/2 ${u64(18446744073709551615) / u64(2)}")
    out.append("lit u64 max>>1 ${u64(18446744073709551615) >> u64(1)}")
    out.append("lit u64 max%7 ${u64(18446744073709551615) % u64(7)}")
    out.append("lit u64 2^63 ${u64(9223372036854775808)}")
    out.append("lit i8(200) ${i8(200)}")
    out.append("lit u8(-1) ${u8(-1)}")
    out.append("lit u32(-1) ${u32(-1)}")
    out.append("lit f64ToInt 1e19 ${f64ToInt(1.0e19)}")
    out.append("lit f64ToInt -1e19 ${f64ToInt(-1.0e19)}")
    out.append("lit f64ToInt 1.9 ${f64ToInt(1.9)}")
    out.append("lit f64ToInt -1.9 ${f64ToInt(-1.9)}")
    out.append("lit f64FromInt 2^53+1 ${f64FromInt(9007199254740993)}")
    out.append("lit f32ToF64 0.1 ${f32ToF64(f32(0.1))}")
    out.append("lit 0.1+0.2 ${0.1 + 0.2}")
    out.append("lit 1/3 ${1.0 / 3.0}")
    out.append("lit 1e308*10 ${1.0e308 * 10.0}")
    out.append("lit 5.5%2 ${5.5 % 2.0}")
    out.append("lit -5.5%2 ${-5.5 % 2.0}")
    // compound assignment and increments on narrow types wrap
    var u = idU8(250)
    u += u8(10)
    out.append("u8 +=10 ${u}")
    u -= u8(20)
    out.append("u8 -=20 ${u}")
    u *= u8(3)
    out.append("u8 *=3 ${u}")
    var s = idI8(120)
    s += i8(10)
    out.append("i8 +=10 ${s}")
    s -= i8(100)
    out.append("i8 -=100 ${s}")
    var w = idU32(4294967290)
    w += u32(10)
    out.append("u32 +=10 ${w}")
    var big = idU64(u64(18446744073709551610))
    big += u64(10)
    out.append("u64 +=10 ${big}")
    var n = idI(9223372036854775800)
    n += 10
    out.append("int +=10 ${n}")
    var sh = idU8(1)
    for (i in 0 until 9) sh = sh << u8(1)
    out.append("u8 1<<9 steps ${sh}")
    var counter = idU8(254)
    for (i in 0 until 4) counter += u8(1)
    out.append("u8 254 + 4 steps ${counter}")
    // narrow fields and array elements keep their width on store
    val p = Packed(idU8(255), idI8(127), 65535, 2147483647, idU32(4294967295), idU64(u64(18446744073709551615)))
    p.a = p.a + u8(1)
    p.b = p.b + i8(1)
    p.c = p.c + u16(1)
    p.d = p.d + i32(1)
    p.e = p.e + u32(1)
    p.f = p.f + u64(1)
    out.append("fields ${p.a} ${p.b} ${p.c} ${p.d} ${p.e} ${p.f}")
    p.a += u8(2)
    p.b -= i8(3)
    out.append("fields += ${p.a} ${p.b}")
    val bytes: array<u8> = [idU8(255), idU8(0), idU8(128)]
    bytes[0] = bytes[0] + u8(1)
    bytes[1] = bytes[1] - u8(1)
    bytes[2] = bytes[2] * u8(2)
    out.append("u8 array ${bytes[0]} ${bytes[1]} ${bytes[2]}")
    val signed: array<i8> = [idI8(127), idI8(-128)]
    signed[0] = signed[0] + i8(1)
    signed[1] = signed[1] - i8(1)
    out.append("i8 array ${signed[0]} ${signed[1]}")
    val longs: array<u64> = [idU64(u64(18446744073709551615))]
    longs[0] = longs[0] + u64(2)
    out.append("u64 array ${longs[0]}")
    // text: printing and parsing
    out.append("parse max ${showInt("9223372036854775807".parseInt())}")
    out.append("parse max+1 ${showInt("9223372036854775808".parseInt())}")
    out.append("parse min ${showInt("-9223372036854775808".parseInt())}")
    out.append("parse min-1 ${showInt("-9223372036854775809".parseInt())}")
    out.append("parse +5 ${showInt("+5".parseInt())}")
    out.append("parse -0 ${showInt("-0".parseInt())}")
    out.append("parse 007 ${showInt("007".parseInt())}")
    out.append("parse empty ${showInt("".parseInt())}")
    out.append("parse minus ${showInt("-".parseInt())}")
    out.append("parse plus ${showInt("+".parseInt())}")
    out.append("parse space ${showInt(" 5".parseInt())}")
    out.append("parse 5space ${showInt("5 ".parseInt())}")
    out.append("parse 1_000 ${showInt("1_000".parseInt())}")
    out.append("parse 0x10 ${showInt("0x10".parseInt())}")
    out.append("parse 1e3 ${showInt("1e3".parseInt())}")
    out.append("parse 99999999999999999999 ${showInt("99999999999999999999".parseInt())}")
    out.append("parse 00000000000000000000009 ${showInt("00000000000000000000009".parseInt())}")
    out.append("print min ${-9223372036854775807 - 1}")
    out.append("print u64 max ${u64(18446744073709551615)}")
    out.append("print i8 min ${i8(-128)}")
    out.append("print f64 1e21 ${idI(0) + 1000000000000000000 * 1000 + 0}")
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) {
        println("SIZES ${live.size} ${staged.size}")
        bad = 1
    }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println("LIVE ${line}")
    bad
}
