// Numeric edge values as a table of int results, one per index. Generated from a list of expressions by the scratch
// harness; the same table runs natively (native.ab prints it) and as WebAssembly (module.ab exports it).
import "abla/float"

@noinline fun idI(x: int): int = x
@noinline fun idI8(x: i8): i8 = x
@noinline fun idU8(x: u8): u8 = x
@noinline fun idI16(x: i16): i16 = x
@noinline fun idU16(x: u16): u16 = x
@noinline fun idI32(x: i32): i32 = x
@noinline fun idU32(x: u32): u32 = x
@noinline fun idU64(x: u64): u64 = x
@noinline fun idF(x: f64): f64 = x
@noinline fun idF32(x: f32): f32 = x

fun numericValue(i: int): int {
    if (i == 0) return int(idI(9223372036854775807) + idI(1))
    if (i == 1) return int(idI(-9223372036854775807 - 1) - idI(1))
    if (i == 2) return idI(-9223372036854775807 - 1) / idI(-1)
    if (i == 3) return idI(-9223372036854775807 - 1) % idI(-1)
    if (i == 4) return int(i8(idI8(-128) / idI8(-1)))
    if (i == 5) return int(i8(idI8(-128) % idI8(-1)))
    if (i == 6) return int(i16(idI16(-32768) / idI16(-1)))
    if (i == 7) return int(i32(idI32(-2147483648) / idI32(-1)))
    if (i == 8) return int(i32(idI32(-2147483648) % idI32(-1)))
    if (i == 9) return idI(-7) / idI(2)
    if (i == 10) return idI(-7) % idI(3)
    if (i == 11) return idI(7) % idI(-3)
    if (i == 12) return int(u8(idU8(255) + idU8(1)))
    if (i == 13) return int(u8(idU8(0) - idU8(1)))
    if (i == 14) return int(u8(idU8(200) * idU8(2)))
    if (i == 15) return int(i8(idI8(127) + idI8(1)))
    if (i == 16) return int(i16(idI16(32767) + idI16(1)))
    if (i == 17) return int(i32(idI32(2147483647) + idI32(1)))
    if (i == 18) return int(i32(idI32(65536) * idI32(65536)))
    if (i == 19) return int(u32(idU32(4294967295) + idU32(1)))
    if (i == 20) return int(u32(idU32(4294967295) * idU32(4294967295)))
    if (i == 21) return int(u32(idU32(4000000000) / idU32(3)))
    if (i == 22) return int(u32(idU32(4000000000) % idU32(7)))
    if (i == 23) return int(u64(idU64(u64(18446744073709551615)) / idU64(u64(3))))
    if (i == 24) return int(u64(idU64(u64(18446744073709551615)) % idU64(u64(10))))
    if (i == 25) return idI(1) << idI(63)
    if (i == 26) return idI(1) << idI(64)
    if (i == 27) return idI(1) << idI(100)
    if (i == 28) return idI(1) << idI(-1)
    if (i == 29) return idI(-8) >> idI(1)
    if (i == 30) return idI(-8) >> idI(64)
    if (i == 31) return idI(-8) >> idI(-1)
    if (i == 32) return idI(-8) >>> idI(1)
    if (i == 33) return idI(-8) >>> idI(64)
    if (i == 34) return int(i32(idI32(1) << idI32(31)))
    if (i == 35) return int(i32(idI32(1) << idI32(32)))
    if (i == 36) return int(i32(idI32(-8) >> idI32(32)))
    if (i == 37) return int(i32(idI32(-8) >> idI32(33)))
    if (i == 38) return int(i32(idI32(-8) >>> idI32(1)))
    if (i == 39) return int(i32(idI32(-8) >>> idI32(32)))
    if (i == 40) return int(u32(idU32(1) << idU32(31)))
    if (i == 41) return int(u32(idU32(1) << idU32(32)))
    if (i == 42) return int(u32(idU32(4294967295) >> idU32(32)))
    if (i == 43) return int(u8(idU8(255) << idU8(1)))
    if (i == 44) return int(u8(idU8(255) << idU8(8)))
    if (i == 45) return int(u8(idU8(255) >> idU8(8)))
    if (i == 46) return int(i8(idI8(-128) >> idI8(8)))
    if (i == 47) return int(i8(idI8(1) << idI8(8)))
    if (i == 48) return int(i16(idI16(-1) >> idI16(16)))
    if (i == 49) return int(u64(idU64(u64(1)) << idU64(u64(63))))
    if (i == 50) return int(u64(idU64(u64(1)) << idU64(u64(64))))
    if (i == 51) return int(u64(idU64(u64(18446744073709551615)) >> idU64(u64(64))))
    if (i == 52) return idI(1) << int(idU8(3))
    if (i == 53) return int(i8(idI(200)))
    if (i == 54) return int(i8(idI(-129)))
    if (i == 55) return int(u8(idI(-1)))
    if (i == 56) return int(u8(idI(256)))
    if (i == 57) return int(i16(idI(40000)))
    if (i == 58) return int(u16(idI(65537)))
    if (i == 59) return int(i32(idI(2147483648)))
    if (i == 60) return int(u32(idI(-1)))
    if (i == 61) return int(u32(idI(4294967296)))
    if (i == 62) return int(u64(idI(-1)))
    if (i == 63) return int(idU64(u64(18446744073709551615)))
    if (i == 64) return int(u8(idI8(-1)))
    if (i == 65) return int(u32(idI8(-1)))
    if (i == 66) return if (idU64(u64(18446744073709551615)) > idU64(u64(1))) 1 else 0
    if (i == 67) return f64ToInt(idF(1.9))
    if (i == 68) return f64ToInt(idF(-1.9))
    if (i == 69) return f64ToInt(idF(1.0e19))
    if (i == 70) return f64ToInt(idF(-1.0e19))
    if (i == 71) return f64ToInt(idF(9223372036854775808.0))
    if (i == 72) return f64ToInt(idF(0.0) / idF(0.0))
    if (i == 73) return f64ToInt(idF(1.0) / idF(0.0))
    if (i == 74) return f64ToInt(idF(-1.0) / idF(0.0))
    if (i == 75) return f32ToInt(f64ToF32(idF(1.0e19)))
    if (i == 76) return f32ToInt(f64ToF32(idF(0.0) / idF(0.0)))
    if (i == 77) return int(f32ToI32(f64ToF32(idF(3.0e9))))
    if (i == 78) return int(f32ToI32(f64ToF32(idF(-3.0e9))))
    if (i == 79) return int(f32ToI32(f64ToF32(idF(0.0) / idF(0.0))))
    if (i == 80) return int(f32ToU32(f64ToF32(idF(-1.0))))
    if (i == 81) return int(f32ToU32(f64ToF32(idF(5.0e9))))
    if (i == 82) return int(f32ToU32(f64ToF32(idF(4294967296.0))))
    if (i == 83) return int(f32ToU32(f64ToF32(idF(0.0) / idF(0.0))))
    if (i == 84) return f64ToBits(f64FromInt(idI(9007199254740993)))
    if (i == 85) return f64ToBits(f64FromInt(idI(9223372036854775807)))
    if (i == 86) return f64ToBits(f64FromInt(idI(-9223372036854775807 - 1)))
    if (i == 87) return int(f32ToBits(f32FromInt(idI(16777217))))
    if (i == 88) return int(f32ToBits(f32FromInt(idI(16777219))))
    if (i == 89) return int(f32ToBits(f32FromInt(idI(9223372036854775807))))
    if (i == 90) return int(f32ToBits(f32FromInt(idI(1099511627777))))
    if (i == 91) return int(f32ToBits(f32FromU32(idU32(4294967295))))
    if (i == 92) return int(f32ToBits(f32FromU32(idU32(2147483649))))
    if (i == 93) return int(f32ToBits(f32FromI32(idI32(2147483647))))
    if (i == 94) return int(f32ToBits(f64ToF32(idF(1.0e40))))
    if (i == 95) return int(f32ToBits(f64ToF32(idF(1.0e-45))))
    if (i == 96) return int(f32ToBits(f64ToF32(idF(1.0e-50))))
    if (i == 97) return int(f32ToBits(f64ToF32(idF(3.4028235677973366e38))))
    if (i == 98) return int(f32ToBits(f64ToF32(idF(16777218.999999996))))
    if (i == 99) return f64ToBits(idF(0.1) + idF(0.2))
    if (i == 100) return f64ToBits(idF(5.5) % idF(2.0))
    if (i == 101) return f64ToBits(idF(-5.5) % idF(2.0))
    if (i == 102) return if (idF(5.5) % idF(0.0) != idF(5.5) % idF(0.0)) 1 else 0   // a NaN: its sign bit is unspecified (docs/language.md), so test for NaN, not its bits
    if (i == 103) return f64ToBits(idF(5.0) % (idF(1.0) / idF(0.0)))
    if (i == 104) return f64ToBits(idF(1.0e308) * idF(10.0))
    if (i == 105) return f64ToBits(idF(5.0e-324) / idF(2.0))
    if (i == 106) return int(f32ToBits(idF32(f32(0.1)) + idF32(f32(0.2))))
    if (i == 107) return int(f32ToBits(idF32(f32(1.0e38)) * idF32(f32(10.0))))
    if (i == 108) return int(f32ToBits(idF32(f32(16777216.0)) + idF32(f32(1.0))))
    if (i == 109) return if (idF(0.0) / idF(0.0) == idF(0.0) / idF(0.0)) 1 else 0
    if (i == 110) return if (idF(0.0) / idF(0.0) != idF(0.0) / idF(0.0)) 1 else 0
    if (i == 111) return if (idF(0.0) / idF(0.0) < idF(1.0)) 1 else 0
    if (i == 112) return if (idF(0.0) == idF(0.0) * idF(-1.0)) 1 else 0
    if (i == 113) return if (f64ToF32(idF(0.0) / idF(0.0)) == f64ToF32(idF(0.0) / idF(0.0))) 1 else 0
    return 0
}

val numericCaseCount = 114
