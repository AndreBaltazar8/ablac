import "abla/io"
fun nums(): Generator<int> = generator { yield 1 }
class Holder(val gen: Generator<int>)
fun outer(): Generator<int> = generator { val holder =
        Holder(nums()); for (v in holder.gen) yield v }
fun once(): int { var n = 0; for (v in outer()) n += v; n }
fun main: int { var n = 0; for (i in 0 until 1000) n += once(); val a: array<string> =
        []; for (i in 0 until 2000) a.append("item $i"); println("$n ${a.size}"); 0 }
