import "abla/io"
import "abla/runtime/memory"

fun numbers(): Generator<int> = generator { yield 1 }
class Holder(val gen: Generator<int>)
fun all(): array<Generator<int>> = [numbers()]

fun field(): int {
    var total = 0
    for (value in Holder(numbers()).gen) total = total + value
    total
}

fun index(): int {
    var total = 0
    for (value in all()[0]) total = total + value
    total
}

fun main: int {
    runtimeMemorySetManualCollection()
    val beforeField = runtimeMemoryLiveBytes()
    var total = 0
    for (i in 0 until 1000) total = total + field()
    val fieldGrowth = runtimeMemoryLiveBytes() - beforeField
    val beforeIndex = runtimeMemoryLiveBytes()
    for (i in 0 until 1000) total = total + index()
    val indexGrowth = runtimeMemoryLiveBytes() - beforeIndex
    println("$total ${fieldGrowth < 100000} ${indexGrowth < 110000}")
    0
}
