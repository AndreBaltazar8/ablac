// truncate keeps a prefix and clear empties an array in place (a function's
// `var` parameter and a field are cleared for their owner), and later appends
// reuse the slots.
class Box(var items: array<string>)

fun drain(var items: array<int>): int {
    var total = 0
    for (item in items) total += item
    items.clear()
    total
}

fun main: int {
    val numbers = [1, 2, 3, 4, 5]
    numbers.truncate(3)
    if (numbers.size != 3 || numbers[2] != 3) return 1
    numbers.append(9)
    if (numbers.size != 4 || numbers[3] != 9) return 2
    numbers.truncate(4)
    numbers.truncate(0)
    if (numbers.size != 0) return 3
    for (i in 0 until 100) numbers.append(i)
    if (drain(numbers) != 4950 || numbers.size != 0) return 4
    val box = Box(["a", "b", "c"])
    box.items.truncate(1)
    if (box.items.size != 1 || box.items[0] != "a") return 5
    box.items.clear()
    box.items.append("z")
    if (box.items.size != 1 || box.items[0] != "z") return 6
    42
}
