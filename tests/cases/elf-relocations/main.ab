// The in-process relocation check of the libc-free links (src/elf_relocations.ab, #806): prints the first relocation of the ELF64 file named by the first
// argument that is not the relative type given as the second argument, "" when there is none and "?" when the file's section headers cannot be read.
// tools/test-elf-relocations.sh runs it on real files and against llvm-readelf's own report.
import "abla/io"
import "abla/sys/linux/process"
import "../../../src/elf_relocations.ab"

fun main: int {
    var kind = 0
    val text = linuxArgument(1)
    var at = 0
    while (at < text.size) {
        kind = kind * 10 + int(text[at]) - 48
        at += 1
    }
    println(bootstrapElfOtherRelocation(linuxArgument(0), kind))
    0
}
