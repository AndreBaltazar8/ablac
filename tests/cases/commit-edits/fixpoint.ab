// A `#` site that asks for a new change in every round never settles.
import "abla/compiler"

fun tagged(): int = 1

compile fun grow(): int {
    val function = compiler.findFunction("tagged")
    compiler.addFunctionAnnotation(function, "tag${compiler.annotationCount(function)}")
    0
}

val marker = #grow()

fun main: int = tagged() + marker
