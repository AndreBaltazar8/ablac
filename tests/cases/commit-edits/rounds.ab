// A change made in round 1 is what round 2's `#` sites see.
import "abla/compiler"

@seed
fun base(): int = 1

compile fun first(): int {
    val function = compiler.findFunction("base")
    if (compiler.annotationCount(function) == 1) compiler.addFunctionAnnotation(function, "inline")
    compiler.annotationCount(function)
}

val seen = #first()

fun main: int = if (seen == 2) 42 else seen
