// A `#` site changes a function's body: the edit is committed and the program
// lowered again; the site, asking for what it got, ends the rounds.
import "abla/compiler"
import "abla/math"

#compilerGrant("transform.library")

fun answer(): int = 1

compile fun specialize(): int {
    compiler.replaceFunctionBody(compiler.findFunction("answer"), "40")
    compiler.replaceFunctionBody(compiler.findFunction("clamp"), "value + 1")
    0
}

val marker = #specialize()

fun main: int = answer() + clamp(1, 5, 9) + marker
