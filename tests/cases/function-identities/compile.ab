// Compile-time closures are decoded using the same resolved ids as the slice.
fun probezpknqsaedjse(): int = 17
fun probekaysvcnfznor(): int = 25
compile fun selected(second: bool): () -> int = if (second) probekaysvcnfznor else probezpknqsaedjse
val first = #selected(false)
val second = #selected(true)
fun main: int = if (first() == 17 && second() == 25) 42 else 1
