// The compiler's own process capture (compilerRunProcess under `#`), built as a program so
// tools/test-gc-stress-io.sh can run it with a collection at every safe point (#829): the
// executable it finds on PATH must still be what the child execs.
import "../../../src/ct_process.ab"

fun main: int {
    val shell = "s" + "h"
    val capture = bootstrapProcessCapture([shell, "-c", "printf Abla"], 4096, 5000)
    if (capture.exitCode == 0 && capture.stdout == "Abla") 42 else 1
}
