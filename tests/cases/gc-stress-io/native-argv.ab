// The compiler's argv for LLVM's in-process option parser (src/native_argv.ab, #829): built from computed
// strings, then a collection and more allocation, then every entry read back through the table. Under
// ABLA_GC_STRESS=1 (tools/test-gc-stress-io.sh) a table of nativeCStringAddress copies points at poison here.
import "abla/memory"
import "abla/unsafe/memory"
import "../../../src/native_argv.ab"
import "abla/unsafe/memory/raw"

fun churn(seed: int): string = "churn-$seed-${seed * 3}"

fun main: int {
    val values = ["abla" + "c", "--min-jump-" + "table-entries=4", "--wasm-" + "use-legacy-eh=true"]
    val vector = bootstrapNativeArgumentVector(values)
    memoryCollect()
    var junk = 0
    var round = 0
    while (round < 64) {
        junk = junk + churn(round).size
        round = round + 1
    }
    var matches = 0
    var index = 0
    while (index < values.size) {
        if (nativeCString(nativePointerFromAddress(vector.loadI64(index * 8))) == values[index]) matches += 1
        index = index + 1
    }
    val terminated = vector.loadI64(values.size * 8) == 0
    vector.close()
    if (matches == values.size && terminated && junk > 0) 42 else 1
}
