import "abla/build"
import "abla/bits"
import "abla/bytes"
import "abla/json"
import "abla/text"
import "abla/unsafe/memory"

@export("abla_wasm_allocate")
trusted fun allocate(length: int): int =
    nativePointerAddress(ablaUnsafeAllocate(length))

@export("abla_wasm_store_and_load")
trusted fun storeAndLoad(pointer: int, value: int): int {
    val address = nativePointerFromAddress(pointer)
    ablaUnsafeStoreI64(address, value)
    ablaUnsafeLoadI64(address)
}

@export("abla_wasm_adopt_string_length")
trusted fun adoptStringLength(pointer: int, length: int): int {
    val text = adoptNativeString(pointer, length)
    text.size
}

@export("abla_wasm_json_length")
fun jsonLength: int {
    val response = $jsons {
        "status": 200,
        "body": "hello"
    }
    response.size
}

@export("abla_wasm_json_packed")
trusted fun jsonPacked: int {
    val response = $jsons {
        "status": 200,
        "body": "hello"
    }
    (nativeCStringAddress(response) << 32) | response.size
}

@export("abla_wasm_nested_json_value")
fun nestedJsonValue: int {
    val parsed = jsonParse(
        "{\"headers\":[[\"accept\",\"*/*\"]],\"body_base64\":\"\"}"
    )
    val headers = parsed.value.get("headers")
    if (parsed.succeeded && headers.isArray() && headers.size() == 1 &&
        headers.at(0).isArray() &&
        headers.at(0).at(0).asString() == "accept") 1 else 0
}

@export("abla_wasm_nested_array_value")
fun nestedArrayValue: int {
    val nested = jsonArray([jsonArray([jsonString("accept")])])
    if (nested.at(0).at(0).asString() == "accept") 1 else 0
}

@export("abla_wasm_bit_runtime_score")
fun bitRuntimeScore: int {
    val valid = bitAnd(6, 3) == 2 && bitOr(4, 1) == 5 &&
        bitXor(7, 3) == 4 && bitNot(0) == -1 &&
        bitShiftLeft(3, 4) == 48 &&
        bitShiftRight(-16, 2) == -4 &&
        bitShiftRightUnsigned(-1, 63) == 1 &&
        bitShiftLeft(1, -1) == 0 &&
        bitShiftRight(1, 64) == 0
    if (valid) 42 else 0
}

@export("abla_wasm_text_runtime_score")
fun textRuntimeScore: int {
    val valid = textFindSequence("abcabc", "bc", 2, 6) == 4 &&
        textFindByte("abc", 98) == 1 &&
        textAsciiEqualInsensitive("AbC", "aBc") &&
        textReadU32LittleEndian("ABCD", 0) == 1145258561 &&
        "olá".isValidUtf8() && !byteEncode(255).isValidUtf8()
    if (valid) 42 else 0
}

@export("abla_wasm_i8_identity")
fun i8Identity(value: i8): i8 = value

@export("abla_wasm_u8_identity")
fun u8Identity(value: u8): u8 = value

@export("abla_wasm_i16_identity")
fun i16Identity(value: i16): i16 = value

@export("abla_wasm_u16_identity")
fun u16Identity(value: u16): u16 = value

@export("abla_wasm_i32_identity")
fun i32Identity(value: i32): i32 = value

@export("abla_wasm_u32_identity")
fun u32Identity(value: u32): u32 = value

@export("abla_wasm_u64_identity")
fun u64Identity(value: u64): u64 = value
