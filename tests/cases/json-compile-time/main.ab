// abla/json at compile time. A parse with escapes needs only the grant that reads
// its file (ByteBuffer.appendText is not Path.appendText, in scope here through
// abla/fs), and key lookups in a large object stay within the step limit.
#compilerGrant("filesystem.read")
import "abla/fs"
import "abla/io"
import "abla/json"

fun escapedFromFile(): string {
    val parsed = jsonParse(Path("tests/cases/json-compile-time/data.json").readText())
    if (!parsed.succeeded) return "not parsed"
    parsed.value.getString("escaped")
}

fun catalog(size: int): Json {
    val keys: array<string> = []
    val values: array<Json> = []
    var index = 0
    while (index < size) {
        keys.append("message.$index")
        values.append(jsonInteger(index))
        index = index + 1
    }
    jsonObject(keys, values)
}

fun sumOverKeys(catalog: Json): int {
    var sum = 0
    for (key in catalog.keys) {
        if (catalog.has(key)) sum = sum + catalog.get(key).asInt()
    }
    sum
}

fun parsedSum(): int = sumOverKeys(jsonParse(jsonStringify(catalog(5000))).value)

val escaped = #escapedFromFile()
val builtSum = #sumOverKeys(catalog(5000))
val readSum = #parsedSum()
// A value made at compile time keeps its index at run time.
val carried = #catalog(40)

fun main: int {
    if (escaped != "line\n") return 1
    if (builtSum != 12497500 || readSum != 12497500) return 2
    if (carried.get("message.39").asInt() != 39 || carried.has("message.40")) return 3
    println("json at compile time: ok")
    42
}
