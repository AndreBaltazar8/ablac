// A region may call the free `floor` (and what calls it): the extension
// `Node.floor` is reached only by a member call.
import "node.ab"

fun floor(value: int): int = value - value % 2

fun halves(value: int): int = floor(value) / 2

fun main(): int {
    val kept = Node("kept").floor()
    val half = region { halves(43) }
    return if (kept.name == "kept" && nodes.size == 1) half * 2 else 1
}
