// A math module and the extension in one WebAssembly module (math.ab imports
// abla/math, fast.ab abla/math/fast, v8.ab abla/math/v8). sin of a large
// argument takes v8's region path, which calls the free `floor`.
import "abla/float"
import "abla/math"
import "node.ab"

@export("f")
fun f(x: f64): f64 = sin(x * 1.0e300) + floor(x) + f64FromInt(Node("n").floor().name.size)
