// Each math module as a release and a development WebAssembly module (the
// first build registers the target; the others reuse it).
import "abla/wasm/build"

val registered = #wasmBuildModule(
    "math", "tests/cases/region-extension-names/math.ab",
    "build/region-extension-names/math.wasm", false, false
)
val mathDevelopment = #buildProgram(
    "math-dev", "tests/cases/region-extension-names/math.ab",
    "build/region-extension-names/math-dev.wasm", "wasm32-module", "module", true, false
)
val fastRelease = #buildProgram(
    "fast", "tests/cases/region-extension-names/fast.ab",
    "build/region-extension-names/fast.wasm", "wasm32-module", "module", false, false
)
val fastDevelopment = #buildProgram(
    "fast-dev", "tests/cases/region-extension-names/fast.ab",
    "build/region-extension-names/fast-dev.wasm", "wasm32-module", "module", true, false
)
val v8Release = #buildProgram(
    "v8", "tests/cases/region-extension-names/v8.ab",
    "build/region-extension-names/v8.wasm", "wasm32-module", "module", false, false
)
val v8Development = #buildProgram(
    "v8-dev", "tests/cases/region-extension-names/v8.ab",
    "build/region-extension-names/v8-dev.wasm", "wasm32-module", "module", true, false
)

fun main: int = if (registered && mathDevelopment && fastRelease && fastDevelopment &&
    v8Release && v8Development) 0 else 1
