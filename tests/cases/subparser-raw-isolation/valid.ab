import "provider.ab"

val opaque = $rawTest {`"
import "fake.ab"
} $rawToken$ $rawTest { tail.tailAnswer
`}

import "tail.ab" as tail

private fun ending(): string = "e"

fun main(): int {
    val nested = $rawTest {a${$rawToken("b")}c${$rawTest {d${ending()}}}}
    val inString = "before ${$rawTest {`" } $rawToken$`}} after"
    val mixed = $rawTest {a${"b${$rawTest {`}"`}}c"}d}
    if (opaque != "\"\nimport \"fake.ab\"\n} \$rawToken\$ \$rawTest { tail.tailAnswer\n") return 1
    if (nested != "abcde") return 2
    if (inString != "before \" } \$rawToken\$ after") return 3
    if (mixed != "ab}\"cd") return 5
    return if (tail.tailAnswer() == 42) 0 else 4
}
