import "abla/compiler/parser"
import "abla/text"

fun rawTestJoin(parts: array<string>): string = parts.join("")

compile fun rawTestParts(cursor: ParserCursor): array<SyntaxExpression> {
    parserRawExpect(cursor, "{")
    val parts: array<SyntaxExpression> = []
    while (!parserRawEnd(cursor) && !parserRawAt(cursor, "}")) {
        val text = parserRawTakeUntil(cursor, "\$`}")
        parts.append(syntaxString(text))
        if (parserRawConsume(cursor, "\${")) {
            parts.append(parserParseAblaExpression(cursor))
            parserRawExpect(cursor, "}")
        } else if (parserRawConsume(cursor, "`")) {
            parts.append(syntaxString(parserRawTakeUntilText(cursor, "`")))
            parserRawExpect(cursor, "`")
        } else if (parserRawConsume(cursor, "\$")) {
            parts.append(syntaxString("\$"))
        }
    }
    if (!parserRawConsume(cursor, "}")) parserFail(cursor, "unterminated raw test literal")
    return parts
}

compile fun rawTestBoundary(cursor: ParserCursor): SyntaxExpression {
    rawTestParts(cursor)
    return syntaxNull()
}

compile fun rawTestParse(cursor: ParserCursor): SyntaxExpression {
    val forbidden = parserRawAt(cursor, "{invalid")
    val parts = rawTestParts(cursor)
    if (forbidden) parserFail(cursor, "invalid raw test literal")
    return syntaxCall("rawTestJoin", [syntaxArray(parts)])
}

compile fun rawTestToken(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    return expression
}

#compilerRegisterSubparser("rawTest", rawTestParse, rawTestBoundary)
#compilerRegisterSubparser("rawToken", rawTestToken)
