import "abla/compiler/parser"
import "preview-dependency.ab"

compile fun previewToken(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    return expression
}

#compilerRegisterSubparser("previewToken", previewToken)

val tokenAnswer = $previewToken(42)

compile fun previewParse(cursor: ParserCursor): SyntaxExpression = previewBoundary(cursor)

#compilerRegisterSubparser("previewRaw", previewParse, previewBoundary)

fun main(): int {
    val rawAnswer = $previewRaw {some } opaque " text`}
    return if (tokenAnswer == 42 && rawAnswer == "some } opaque \" text") 0 else 1
}
