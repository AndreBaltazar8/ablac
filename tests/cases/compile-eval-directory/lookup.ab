import "abla/compiler"
import "abla/fs"

#compilerGrant("filesystem.read")

compile fun lookup(): string {
    val rows: array<string> = []
    for (entry in path("build/compile-eval-directory/input").entries()) {
        rows.append("${entry.name()}:${entry.readText()}")
    }
    // Filesystem enumeration order is not an input to the table format.
    var i = 1
    while (i < rows.size) {
        var j = i
        while (j > 0 && rows[j] < rows[j - 1]) {
            val value = rows[j - 1]
            rows[j - 1] = rows[j]
            rows[j] = value
            j -= 1
        }
        i += 1
    }
    var table = ""
    for (row in rows) table = "$table$row\n"
    table
}

val TABLE = #lookup()

@export("tableSize")
fun tableSize(): int = TABLE.size
@export("tableByte")
fun tableByte(index: int): int = TABLE[index]
