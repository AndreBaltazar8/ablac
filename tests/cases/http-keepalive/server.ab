import "abla/http"
import "abla/http/event"
import "abla/process/arguments"
import "abla/sys/linux/net"

// A keep-alive event server for tools/test-http-keepalive.sh: server PORT MODE, where MODE is "noescape" (the handler
// runs in an allocation region, as abla-web's routes do) or "handler" (an ordinary closure handler).
noescape fun noEscapeHandler(request: HttpRequest): HttpResponse =
    httpText("${request.method} ${request.path} ${request.header("User-Agent")} ${request.header("Accept")}\n")

fun handler(request: HttpRequest): HttpResponse =
    httpText("${request.method} ${request.path} ${request.header("User-Agent")} ${request.header("Accept")}\n")

fun main: int {
    val port = httpDecimalLength(processArgument(0), 65535)
    val mode = processArgument(1)
    val server = if (mode == "noescape") httpEventServerNoEscapeHandler(noEscapeHandler, ipv4Loopback(port))
        else httpEventServerHandler(handler, ipv4Loopback(port))
    // A listener that could not bind (the port is another connection's source port, say) must end the program: run() would
    // wait on nothing for ever, and the script would think the server is merely slow.
    if (server.listener.descriptor < 0) return 1
    server.run()
}
