// `ablac run --watch`: tools/test-live-watch.sh edits a copy of this file while it runs. The program writes the path
// it is given once it started, then waits until value() returns something else than 1 (a reload redefined it), and
// exits 42 when that is 2. The test also renames label()'s parameter, a changed signature that applies.
import "abla/fs"
import "abla/io"
import "abla/process/arguments"
import "abla/sys/linux/process"

fun value(): int = 1 // value-marker

// Called once, by main: a reload that renames its parameter moves it, and main, its only caller, never returns.
fun label(x: int): int = x * 0 // label-marker

fun main: int {
    val started = path(processArgument(0)).writeText("started") && label(1) == 0
    var rounds = 0
    while (value() == 1 && rounds < 120000) {
        linuxSleep(1)
        rounds += 1
    }
    println("value ${value()}")
    if (started && value() == 2) 42 else 1
}
