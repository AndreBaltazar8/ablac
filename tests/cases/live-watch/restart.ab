// `ablac run --watch` restarts: tools/test-live-watch.sh changes value()'s result type in a copy of this file, which a
// reload refuses (E_LIVE_SIGNATURE), so the run starts again on the saved source. The program writes the path it is
// given, with the value it starts with, once it started, then waits until value() returns something else, and exits
// 42 when that is 2.
import "abla/fs"
import "abla/io"
import "abla/process/arguments"
import "abla/sys/linux/process"

fun value(): int = 1 // value-marker

fun main: int {
    val first = value()
    val started = path(processArgument(0)).writeText("started $first")
    var rounds = 0
    while (value() == first && rounds < 120000) {
        linuxSleep(1)
        rounds += 1
    }
    println("value ${value()}")
    if (started && value() == 2) 42 else 1
}
