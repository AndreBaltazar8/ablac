// ed25519 public SEED-HEX | sign SEED-HEX MESSAGE-HEX | verify PUBLIC-HEX MESSAGE-HEX SIGNATURE-HEX: hex out, or
// true/false for verify (tools/test-ed25519.sh compares it with openssl).
import "abla/io"
import "abla/crypto"
import "abla/crypto/ed25519"
import "abla/process/arguments"

fun main: int {
    val command = processArgument(0)
    if (command == "public" && processArgumentCount() == 2) {
        val result = ed25519PublicKey(hexDecode(processArgument(1)))
        println(if (result.ok) hexEncode(result.bytes) else "error: ${result.error}")
        return 0
    }
    if (command == "sign" && processArgumentCount() == 3) {
        val result = ed25519Sign(hexDecode(processArgument(1)), hexDecode(processArgument(2)))
        println(if (result.ok) hexEncode(result.bytes) else "error: ${result.error}")
        return 0
    }
    if (command == "verify" && processArgumentCount() == 4) {
        val ok = ed25519Verify(hexDecode(processArgument(1)), hexDecode(processArgument(2)), hexDecode(processArgument(3)))
        println(if (ok) "true" else "false")
        return 0
    }
    println("usage: tool public SEED | sign SEED MESSAGE | verify PUBLIC MESSAGE SIGNATURE (hex)")
    2
}
