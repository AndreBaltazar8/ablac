import "abla/sql"
import "abla/text"

fun main: int {
    val id = "a'; DROP TABLE users; --"
    val world = 7
    val query = $sql("\n        SELECT stable_snapshot(${id}::uuid, ${world}::integer, ${9}::bigint)::text AS payload")
    if (query.parameters.size != 3) return 1
    if (query.parameters[0].value != id || query.parameters[0].kind != "uuid") return 2
    if (query.parameters[1].value != "7" || query.parameters[1].kind != "int4") return 3
    if (!query.text.contains("\$1::uuid") || query.text.contains(id)) return 4
    return 0
}
