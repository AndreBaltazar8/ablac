import "abla/sql"
import "abla/io"

fun main: int {
    val id = "00000000-0000-0000-0000-000000000001"
    val email = "one@example.test"
    val n = 3
    val statements: array<SqlStatement> = [
        $sql("SELECT \"order\", t.id FROM test t LEFT OUTER JOIN worlds w ON w.id=t.world WHERE t.id = ${id}::uuid AND t.value BETWEEN 1 AND 9 GROUP BY \"order\",t.id HAVING count(*)>0 ORDER BY t.id DESC NULLS LAST LIMIT ${n}::integer OFFSET 0"),
        $sql("INSERT INTO test(id,email) VALUES (${id}::uuid,${email}::text) ON CONFLICT(id) DO UPDATE SET email=excluded.email WHERE test.email<>excluded.email RETURNING id::text"),
        $sql("INSERT INTO test(id) VALUES (${id}::uuid),(${id}::uuid) ON CONFLICT ON CONSTRAINT test_pkey DO NOTHING"),
        $sql("UPDATE test AS t SET email=${email}::text, world=1 FROM worlds AS w WHERE t.world=w.id RETURNING t.id, email AS updated"),
        $sql("DELETE FROM test t USING worlds w WHERE t.world=w.id RETURNING t.*"),
        $sql("SELECT CASE WHEN 1<2 THEN 'yes' ELSE 'no' END AS value, coalesce((SELECT max(world) FROM test),0), CAST(1 AS integer), '{\"n\":1}'::jsonb->>'n' AS n"),
        $sql("SELECT E'a\\'}b' AS escaped, \$\$raw } ' \" text\$\$ AS body, \$tag\$another }\$tag\$ AS tagged"),
        $sql("SELECT 1 /* outer } /* inner } */ still outer */ AS n -- } ignored closing brace\n"),
        $sql("SELECT 1 IN (1,2), 2 NOT BETWEEN 4 AND 6, 'a' ILIKE 'a' ESCAPE '!', NULL IS NOT DISTINCT FROM NULL, NOT false OR true AND false"),
        $sql("SELECT DISTINCT ON (id) id, email FROM test ORDER BY id, email"),
        $sql("SELECT * FROM test WHERE EXISTS (SELECT id FROM worlds WHERE worlds.id=test.world)"),
        $sql("SELECT * FROM (SELECT 1 AS id) AS t(id) WHERE id IN (SELECT 1);"),
        $sql("SELECT \$json\${\"nested\":\"\$regex(\"}\$json\$::jsonb AS payload, ${"literal"}::text AS value"),
        $sql { SELECT $$raw } ' " text$$ AS body, $json${"nested":"$regex("}$json$::jsonb AS payload }
    ]
    if (statements.size != 14) return 1
    println("SQL grammar: 14 accepted templates")
    return 0
}
