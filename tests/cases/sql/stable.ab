// The five proposed game-pandatrails stable.ab migrations, without game state.
import "abla/sql"
import "abla/text"

fun main: int {
    val character = "00000000-0000-0000-0000-000000000001"
    val world = 7
    val epoch = 9007199254740993
    val product = "mount'; DROP TABLE stable; --"
    val kind = "mount"
    val order = "9223372036854775807"
    val view = $sql("SELECT stable_snapshot(${character}::uuid,${world}::integer,${epoch}::bigint)::text AS payload")
    val reserve = $sql("SELECT coalesce(stable_reserve(${character}::uuid,${world}::integer,${epoch}::bigint,${product}::text),0)::text AS payload")
    val purchase = $sql("SELECT stable_purchase(${character}::uuid,${world}::integer,${epoch}::bigint,${sqlInt8Text(order)}::bigint)::text AS payload")
    val select = $sql("SELECT jsonb_build_object('status',CASE WHEN stable_select(${character}::uuid,${world}::integer,${epoch}::bigint,${kind}::text,${product}::text) THEN 'ok' ELSE 'unavailable' END)::text AS payload")
    val feed = $sql("SELECT stable_take_feed_state(${character}::uuid,${world}::integer,${epoch}::bigint,5000)::text AS payload")
    if (view.text != "SELECT stable_snapshot(\$1::uuid,\$2::integer,\$3::bigint)::text AS payload") return 1
    if (view.parameters[2].value != "9007199254740993") return 2
    if (reserve.parameters[3].value != product || reserve.text.contains(product)) return 3
    if (purchase.parameters[3].value != order || purchase.parameters[3].kind != "int8") return 4
    if (select.parameters.size != 5 || select.parameters[4].value != product) return 5
    if (feed.parameters.size != 3 || !feed.text.contains(",5000)")) return 6
    0
}
