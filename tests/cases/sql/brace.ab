// The provider must be discovered through a re-export before host lexing.
import "sql-import.ab"
import "abla/compiler/parser"
import "abla/json"
import "abla/text"

val opaque = $sql {
    SELECT E'a\'}b' AS escaped, $$raw } ' " text$$ AS body,
           $json$literal } $afterSql$ and ${inert}$json$ AS tagged,
           1 /* outer } /* inner } */ still outer */ AS n -- } ignored
}

// A local registration following an opaque SQL body must still be discovered.
compile fun afterSql(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    expression
}
#compilerRegisterSubparser("afterSql", afterSql)

fun main: int {
    val first = $afterSql(17)
    val q = $sql
    {
        SELECT ${if (first == 17) { "O'Brien" } else { "wrong" }
               }::text,
               ${$json{"id":17}}::jsonb, ${null}::boolean
    }
    if (opaque.parameters.size != 0 || !opaque.text.contains("\$\$raw } ' \" text\$\$")) return 1
    if (!opaque.text.contains("\$json\$literal } \$afterSql\$ and \${inert}\$json\$")) return 2
    if (q.parameters.size != 3 || q.parameters[0].value != "O'Brien") return 3
    if (q.parameters[1].value != "{\"id\":17}" || !q.parameters[2].isNull) return 4
    if (!q.text.contains("SELECT \$1::text,") || !q.text.contains("\$2::jsonb, \$3::boolean")) return 5
    0
}
