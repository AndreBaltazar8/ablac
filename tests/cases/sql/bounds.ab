import "../../../stdlib/abla/sql/parser.ab"
import "abla/text"
import "abla/io"

val sizeFailure = #ablaSqlCheck("SELECT '" + "x".repeat(65536) + "'", []).message
val depthFailure = #ablaSqlCheck("SELECT " + "(".repeat(80) + "1" + ")".repeat(80), []).message
val tokenFailure = #ablaSqlCheck("SELECT " + "+".repeat(33000) + "1", []).message
val commentFailure = #ablaSqlCheck("SELECT 1 " + "/*".repeat(65) + "x" + "*/".repeat(65), []).message
// A wildcard takes no alias in PostgreSQL (syntax error at the name after `*`); an arithmetic `*` and a wildcard of a relation do.
val wildcardAlias = #ablaSqlCheck("SELECT * x FROM t", []).message
val qualifiedWildcardAlias = #ablaSqlCheck("SELECT t.* AS y FROM t", []).message
val returningWildcardAlias = #ablaSqlCheck("DELETE FROM t RETURNING * z", []).message
val wildcardFine = #ablaSqlCheck("SELECT *, t.*, 2 * 3 AS six, count(*) AS n FROM t", []).message
fun main: int {
    if (!sizeFailure.contains("size or parameter limit")) return 1
    if (!depthFailure.contains("nesting limit")) return 2
    if (!tokenFailure.contains("token limit")) return 3
    if (!commentFailure.contains("comment nesting limit")) return 4
    if (!wildcardAlias.contains("wildcard cannot have an alias")) return 5
    if (!qualifiedWildcardAlias.contains("wildcard cannot have an alias")) return 6
    if (!returningWildcardAlias.contains("wildcard cannot have an alias")) return 7
    if (wildcardFine != "") return 8
    println("SQL bounds: size, expression depth, tokens, comment depth and wildcard aliases")
    0
}
