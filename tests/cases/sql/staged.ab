import "abla/sql"
import "abla/text"

val frozen = #$sql("SELECT ${"literal"}::text, ${17}::integer, \$json\${\"x\":1}\$json\$::jsonb")
fun main: int {
    if (frozen.parameters.size != 2) return 1
    if (frozen.parameters[0].value != "literal" || frozen.parameters[1].value != "17") return 2
    if (!frozen.text.contains("\$json\$")) return 3
    0
}
