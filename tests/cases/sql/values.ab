import "abla/sql"
import "abla/json"
import "abla/text"
import "abla/io"

var calls = 0
var failures = 0
fun nextSqlValue(): int { calls += 1; calls }
fun sqlCheck(ok: bool, message: string): void {
    if (!ok) { eprintln(message); failures += 1 }
}

fun main: int {
    val attack = "x'); DROP TABLE important; --\n\""
    val nullable: string? = null
    val integer: int? = 42
    val boolean: bool? = true
    val encoded = sqlInt8Text("9223372036854775807")
    val json = jsonObject(["n"], [jsonInteger(3)])
    val statement = $sql("\n        SELECT ${attack}::text AS value, ${nextSqlValue()}::integer,\n            ${nextSqlValue()}::bigint, ${nullable}::uuid,\n            ${integer}::smallint, ${boolean}::boolean,\n            ${f32(0.5)}::real, ${0.25}::double precision,\n            ${json}::jsonb, ${sqlJsonText("{\"raw\":true}")}::jsonb,\n            ${encoded}::bigint, ${null}::text, ${""}::text,\n            ${i8(-2)}::integer, ${u64(-1)}::bigint")
    sqlCheck(calls == 2, "SQL holes must run once, in order")
    sqlCheck(statement.parameters.size == 15, "parameter count")
    sqlCheck(!statement.text.contains(attack), "input appeared in SQL source")
    sqlCheck(statement.parameters[0].value == attack, "input was escaped or changed")
    sqlCheck(statement.parameters[1].value == "1" && statement.parameters[2].value == "2", "evaluation order")
    sqlCheck(statement.parameters[3].isNull && statement.parameters[3].kind == "uuid", "nullable string")
    sqlCheck(statement.parameters[4].value == "42" && statement.parameters[4].kind == "int2", "nullable integer")
    sqlCheck(statement.parameters[5].value == "true", "nullable boolean")
    sqlCheck(statement.parameters[6].value == "0.5" && statement.parameters[7].value == "0.25", "floating codecs")
    sqlCheck(statement.parameters[8].value == "{\"n\":3}" && statement.parameters[9].value == "{\"raw\":true}", "JSON codecs")
    sqlCheck(statement.parameters[10].value == "9223372036854775807", "encoded bigint narrowed")
    sqlCheck(statement.parameters[11].isNull && !statement.parameters[12].isNull, "NULL differs from empty text")
    sqlCheck(statement.parameters[13].value == "-2", "signed width")
    sqlCheck(statement.parameters[14].value == "18446744073709551615", "unsigned value narrowed")
    val empty = $sql("SELECT 1 AS n")
    sqlCheck(empty.parameters.size == 0, "zero-hole SQL")
    println("SQL values: $failures failed")
    failures
}
