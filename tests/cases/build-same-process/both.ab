import "abla/build"
import "abla/wasm/build"

// A development Wasm module, then a release Wasm module and a release native object
// (optimized in process), in one compiler process. The later builds reuse the target
// the first one defined.
val development = #wasmBuildModule(
    "same-process-development",
    "tests/cases/build-same-process/module.ab",
    "build/build-same-process/development.wasm",
    true,
    false
)
val release = #buildProgram(
    "same-process",
    "tests/cases/build-same-process/module.ab",
    "build/build-same-process/after-development.wasm",
    "wasm32-module",
    "module",
    false,
    false
)
val native = #buildProgram(
    "same-process-native",
    "tests/cases/build-same-process/module.ab",
    "build/build-same-process/after-development.o",
    "host",
    "object",
    false,
    false
)

fun main: int = if (development && release && native) 0 else 1
