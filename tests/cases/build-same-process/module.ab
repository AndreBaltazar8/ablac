// Calls whose inlining depends on the inliner's threshold.
fun mix(value: i32, salt: i32): i32 {
    var result = value
    var round = i32(0)
    while (round < i32(4)) {
        result = result * i32(31) + salt
        result = result ^ (result >> i32(7))
        result = result + round * salt
        round = round + i32(1)
    }
    result
}

@export("blend")
fun blend(value: i32): i32 = mix(value, i32(3)) + mix(value, i32(5)) + mix(value, i32(7))
