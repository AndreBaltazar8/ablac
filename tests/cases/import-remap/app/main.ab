// The program uses abla/math/v8 and links ../lib, which imports abla/math:
// the root abla.toml remaps that import, so both see V8's pow (whose
// pow(1, NaN) is NaN; abla/math's is 1).
import "abla/io"
import "abla/float"
import "abla/math/v8"
import "../lib/lib.ab"

fun shown(value: f64): string = if (value != value) "NaN" else "number"

// At compile time too.
val atCompileTime = #shown(libPowOfNaN())

fun main: int {
    val here = pow(1.0, f64FromBits(0x7FF8000000000000))
    println("${shown(libPowOfNaN())} ${shown(here)} ${libFloor()} $atCompileTime")
    42
}
