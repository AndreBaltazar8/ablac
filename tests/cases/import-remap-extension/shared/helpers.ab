import "./dev.ab"

// Extensions (and a plain function) declared against the remapped module's types.
fun Handle.twice(register: int): int = this.read(register) + this.read(register)
fun Counter.twiceNext(): int = this.next() + this.next()
fun plainTwice(handle: Handle, register: int): int = handle.read(register) + handle.read(register)
