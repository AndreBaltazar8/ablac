// A site that runs past a 1 s time limit, reading the clock.
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

@noinline
fun spin(): int {
    val start = monotonicMilliseconds()
    var turns = 0
    while (monotonicMilliseconds() - start < 60000) turns = turns + 1
    turns
}

val value = #spin()
fun main: int = value
