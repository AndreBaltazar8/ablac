// A site that blocks past a 1 s time limit without spending interpreter steps
// polling the clock. The clock-provider interrupt itself has ct-time-limit/clock.ab.
import "abla/compiler"
import "abla/process/time"
#compilerGrant("clock")

@noinline
fun waitPastDeadline(): int {
    sleep(60000)
    42
}

val value = #waitPastDeadline()
fun main: int = value
