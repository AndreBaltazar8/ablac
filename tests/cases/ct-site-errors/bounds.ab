// An index out of bounds two calls below the `#` site (tools/test-ct-site-errors.sh). The functions are @noinline so
// the native tier keeps their frames, and both tiers name the same path.
@noinline
fun pick(items: array<int>, at: int): int = items[at]

@noinline
fun table(): int {
    val items = [1, 2, 3]
    pick(items, 7)
}

val value = #table()
fun main: int = value
