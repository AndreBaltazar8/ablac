import "abla/build"
import "abla/memory"
import "abla/unsafe/memory/raw"

noescape extern:"c" fun fixture_scalar(value: i64): i64
extern:"c" fun fixture_escaping(value: i64): i64
@hostImport
noescape extern:"c" fun fixture_blocking(value: i64): i64
noescape extern:"c" fun fixture_pointer(value: i64): i64*
noescape extern:"c" fun fixture_cstring(value: cstring): i64
noescape extern:"host" fun abla_string_concat(left: string, right: string): string

fun scalarLoop(count: int): i64 {
    var state = i64(7)
    var i = 0
    while (i < count) {
        state = fixture_scalar(state)
        i = i + 1
    }
    state
}

fun escapingCall(value: i64): i64 = fixture_escaping(value)
fun blockingCall(value: i64): i64 = fixture_blocking(value)
fun pointerCall(value: i64): bool = pointerIsNull(fixture_pointer(value))
fun cstringCall(value: string): i64 = fixture_cstring(value)
fun heapCall(left: string, right: string): string = abla_string_concat(left, right)

fun enableCollection(): void {
    memorySetCollectionGrowth(1048576)
    return
}

val exportScalar = #exportFunction("scalarLoop", "scalar_loop")
val exportEscaping = #exportFunction("escapingCall", "escaping_call")
val exportBlocking = #exportFunction("blockingCall", "blocking_call")
val exportPointer = #exportFunction("pointerCall", "pointer_call")
val exportCString = #exportFunction("cstringCall", "cstring_call")
val exportHeap = #exportFunction("heapCall", "heap_call")
val exportEnable = #exportFunction("enableCollection", "enable_fixture_gc")
