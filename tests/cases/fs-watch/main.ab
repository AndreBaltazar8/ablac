// abla/fs/watch (fileEvents): a watch on two files of a directory. Each check prints "name: ok|FAIL":
// - nothing happens: wait times out (false);
// - an in-place write of a watched file is seen;
// - a save through a temporary file and a rename (as editors do) is seen;
// - a write to another file of the directory is not (Linux only: the event names the file);
// - a watched file removed is seen.
// The directory is the first argument. Exits 42 when every check passed.
import "abla/fs"
import "abla/fs/watch"
import "abla/io"
import "abla/process/arguments"
import "abla/platform/host"

var failures = 0

fun check(name: string, ok: bool): void {
    println("$name: ${if (ok) "ok" else "FAIL"}")
    if (!ok) failures += 1
    return
}

fun main: int {
    val directory = processArgument(0)
    val first = "$directory/first.ab"
    val second = "$directory/second.ab"
    check("setup", path(first).writeText("1") && path(second).writeText("2"))
    val watch = fileEvents([first, second])
    check("active", watch.active())
    check("quiet", !watch.wait(100))
    check("in-place write", path(first).writeText("11") && watch.wait(2000))
    // Drain what the write left (a modify and a close).
    while (watch.wait(50)) {}
    check("rename save", path(second).writeTextAtomic("22") && watch.wait(2000))
    while (watch.wait(50)) {}
    // macOS: a directory's vnode event does not name the file, so another file of it is seen too.
    if (!ablaHostIsMacOS()) check("other file ignored", path("$directory/other.txt").writeText("x") && !watch.wait(200))
    check("removed", path(first).remove() && watch.wait(2000))
    watch.close()
    check("closed", !watch.active())
    if (failures == 0) 42 else 1
}
