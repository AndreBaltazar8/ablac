trusted fun runtimeIntrinsicProbe(value: int): int {
    val boxed = ablaRuntimeMakeValue(2, 0, value, 0)
    val address = ablaRuntimeValueAddress(boxed)
    val memory = __ablaRuntimeAllocate(16)
    ablaRuntimeStoreI32(memory, ablaRuntimeLoadI32(address))
    ablaRuntimeStoreI64(memory + 8, ablaRuntimeLoadI64(address + 8))
    val result = if (ablaRuntimeLoadI32(memory) == 2) {
        ablaRuntimeLoadI64(memory + 8)
    } else 0
    __ablaRuntimeFree(memory)
    result
}

class RuntimeProbe(var count: int, var ready: bool)

fun main: int {
    val values = [10, 20]
    values.append(12)
    values[1] = 18
    val probe = RuntimeProbe(40, false)
    probe.count = probe.count + 2
    probe.ready = true
    val left = "ab"
    val right = "cd"
    val text = "$left$right"
    val valid = runtimeIntrinsicProbe(values[0] + values[1] + values[2]) == 40 &&
        values.size == 3 && probe.count == 42 && probe.ready &&
        text.size == 4 && text[2] == 99 && text.slice(1, 3) == "bc"
    if (valid) 42 else 0
}
