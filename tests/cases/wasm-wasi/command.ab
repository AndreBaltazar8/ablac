import "abla/io"
import "abla/process/exit"
import "abla/process/time"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun main: int {
    val mode = linuxArgument(0)
    val expectedArguments = if (mode == "exit") 3 else 2
    if (linuxArgumentCount() != expectedArguments || linuxArgument(expectedArguments) != "" ||
        linuxArgument(-1) == "") return 91
    if (mode == "exit" && linuxArgument(2) != "extra") return 91
    val first = linuxEnvironment("ABLA_WASI_FIRST")
    val second = linuxEnvironment("ABLA_WASI_SECOND")
    val empty = linuxEnvironment("ABLA_WASI_EMPTY")
    if (!first.found || !second.found || !empty.found || empty.value != "") return 92
    if (linuxEnvironment("ABLA_WASI_MISSING").found) return 93
    val input = readInputLine()
    if (!input.available || input.text != "input line" || readInputLine().available) return 94
    val monotonic = monotonicNanoseconds()
    if (realtimeNanoseconds() <= 0 || monotonic <= 0 || monotonicNanoseconds() < monotonic) return 95
    val random = nativeByteBuffer(8)
    if (linuxSyscall3(318, nativePointerAddress(random.address), 8, 0) != 8) return 96
    random.close()
    println("$mode:${linuxArgument(1)}")
    println("${first.value}:${second.value}")
    eprintln(input.text)
    if (mode == "exit") exit(9)
    7
}
