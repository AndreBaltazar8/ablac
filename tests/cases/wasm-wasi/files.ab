import "abla/fs"
import "abla/io"
import "abla/sys/linux/process"

fun main: int {
    val file = path("nested/round-trip.txt")
    if (linuxArgumentCount() == 0) {
        val denied = file.readTextResult()
        return if (!denied.succeeded && denied.errorCode == 13 && !file.writeText("denied")) 0 else 81
    }
    val missing = file.readTextResult()
    if (missing.succeeded || missing.errorCode != 2) return 82
    if (!file.writeText("old contents")) return 83
    if (!file.writeText("first\n") || !file.appendText("second\n")) return 84
    val info = file.info()
    if (!info.isFile() || info.size != 13) return 85
    if (file.readText() != "first\nsecond\n") return 86
    val read = file.readTextResult()
    if (!read.succeeded || read.text != "first\nsecond\n") return 87
    val absolute = path(linuxArgument(0)).readTextResult()
    val parent = path("../outside.txt").readTextResult()
    val link = path("escape.txt").readTextResult()
    if (absolute.succeeded || absolute.errorCode != 13 || parent.succeeded ||
        parent.errorCode != 13 || link.succeeded) return 88
    print(read.text)
    0
}
