// Raw socket peer for tools/test-http-client.sh. It speaks HTTP/1.1 with literal
// bytes only (no abla/http, no parser or client code is shared with the program it
// serves): it listens on 127.0.0.1 on a port the system picks, publishes the port by
// renaming a file into place, answers one GET /hello with "hello" when the request
// line and Host header are exactly right and with "bad" otherwise, and exits.
// Arguments: <ready file> [wrong], where "wrong" always answers "bad" (a control).
import "abla/fs"
import "abla/net/hosted"
import "abla/process/arguments"
import "abla/text"

fun main: int {
    val ready = processArgument(0)
    val wrong = processArgumentCount() > 1 && processArgument(1) == "wrong"
    val listener = hostedTcpListen("127.0.0.1", 0, 1, false)
    val port = listener.localPort()
    if (port <= 0) return 1
    if (!Path(ready).writeTextAtomic("$port")) return 2
    val connection = listener.accept()
    val request = connection.readNetwork(65536, 10000)
    if (!request.hasData()) return 3
    val text = request.bytes
    val valid = text.slice(0, 21) == "GET /hello HTTP/1.1\r\n" &&
        text.contains("Host: localhost:$port\r\n")
    val body = if (valid && !wrong) "hello" else "bad"
    connection.writeResult("HTTP/1.1 200 OK\r\nContent-Length: ${body.size}\r\n\r\n$body")
    connection.close()
    listener.close()
    0
}
