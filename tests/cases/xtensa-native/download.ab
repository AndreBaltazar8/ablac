import "abla/xtensa/companion/native"
import "abla/fs"
import "abla/crypto"
import "abla/process/arguments"
import "abla/sys/linux"

fun main(): int {
    val selected = nativeSelectCatalog(Path(processArgument(0)).readText(), "23.1.3-1", processArgument(1))
    if (selected.error != "") { linuxWriteStandardError("catalog: ${selected.error}\n"); return 1 }
    val downloaded = nativeDownload(selected.url)
    if (downloaded.error != "") { linuxWriteStandardError("download: ${downloaded.error}\n"); return 2 }
    if (hexEncode(sha256(downloaded.bytes)) != selected.pins.archiveSha256) return 3
    linuxWriteStandardOutput("download verified bytes=${downloaded.bytes.size}\n")
    0
}
