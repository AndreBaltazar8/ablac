import "abla/xtensa/companion/native"
import "abla/xtensa/companion"
import "abla/process/arguments"

fun main(): int {
    if (nativeDownloadDiagnostic("download failed").indexOf("--archive PATH", 0) < 0 ||
        nativeDownloadDiagnostic("download timeout").indexOf("proxies are not supported", 0) < 0 ||
        nativeDownloadDiagnostic("disk_full") != "disk_full") return 15
    val residue = CompanionExtractResult("cleanup", false, ".install-stage", "rename_no_replace", 5,
        ".spool-copy", "publish")
    val details = nativeDownloadCleanupError(".download-copy", residue)
    if (details !=
        "download cleanup: .download-copy, .install-stage, .spool-copy; cleanup; publish; rename_no_replace: 5") return 13
    if (nativeInstallError(residue) !=
        "cleanup: .install-stage: .spool-copy; publish; rename_no_replace: 5") return 14
    if (nativeDownloadUrl("https://github.com/a", true).error != "") return 1
    if (nativeDownloadUrl("https://release-assets.githubusercontent.com/a",
        true).error == "") return 2
    if (nativeDownloadUrl("https://release-assets.githubusercontent.com/a",
        false).error != "") return 3
    if (nativeDownloadUrl("https://objects.githubusercontent.com/a", false).error != "") return 4
    if (nativeDownloadUrl("https://evil.example/a",
        false).error != "redirect host: evil.example") return 5
    if (nativeDownloadUrl("https://github.com@evil.example/a", false).error == "") return 6
    if (nativeDownloadUrl("http://github.com/a", true).error == "") return 7
    if (nativeDownloadUrl("https://github.com/a\nX: y", true).error == "") return 8
    if (nativeDownloadUrl("https://github.com/a#fragment", true).error == "") return 9
    if (nativeDownload("https://github.com/a", 0).error != "invalid timeout") return 10
    if (nativeCheckTools(processArgument(0), "23.1.3", 100) != "helper timeout: opt") return 11
    val flood = nativeCheckTools(processArgument(1), "23.1.3", 5000)
    if (flood != "helper output limit: opt" && flood != "helper output: opt") return 12
    0
}
