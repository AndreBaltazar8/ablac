import "abla/io"
var log: string = ""
resource class Item(val id: int) {
    fun drop(): void { log += "I$id" }
    fun look(): void { log += "B$id" }
}
fun maybe(flag: bool): array<Item>? = if (flag) [Item(1), Item(2)] else null
fun ordinary(flag: bool, stop: bool): void {
    for (x in maybe(flag) ?? [Item(3), Item(4)]) { x.look(); if (stop) break }
}
fun generated(flag: bool): Generator<int> = generator {
    for (x in maybe(flag) ?? [Item(3), Item(4)]) { x.look(); yield x.id }
}
fun mixed(flag: bool): void {
    val owner = [Item(3), Item(4)]
    for (x in maybe(flag) ?? owner) { x.look() }
    log += "|"
}
fun exercise(): string {
    log = ""
    ordinary(true, false); log += "|"
    ordinary(false, false); log += "|"
    ordinary(true, true); log += "|"
    ordinary(false, true); log += "|"
    for (x in generated(true)) {}; log += "|"
    for (x in generated(false)) {}; log += "|"
    for (x in generated(true)) { break }; log += "|"
    for (x in generated(false)) { break }; log += "|"
    mixed(true); log += "|"
    mixed(false); log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
