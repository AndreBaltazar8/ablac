// abla/math/v8 exported to a WebAssembly host, which compares each function
// with Node's Math over millions of inputs (run.mjs).
import "abla/math/v8"

@export("sqrt") fun v8Sqrt(x: f64): f64 = sqrt(x)
@export("floor") fun v8Floor(x: f64): f64 = floor(x)
@export("ceil") fun v8Ceil(x: f64): f64 = ceil(x)
@export("trunc") fun v8Trunc(x: f64): f64 = trunc(x)
@export("fabs") fun v8Fabs(x: f64): f64 = fabs(x)
@export("sin") fun v8Sin(x: f64): f64 = sin(x)
@export("cos") fun v8Cos(x: f64): f64 = cos(x)
@export("tan") fun v8Tan(x: f64): f64 = tan(x)
@export("atan") fun v8Atan(x: f64): f64 = atan(x)
@export("exp") fun v8Exp(x: f64): f64 = exp(x)
@export("log") fun v8Log(x: f64): f64 = log(x)
@export("atan2") fun v8Atan2(y: f64, x: f64): f64 = atan2(y, x)
@export("pow") fun v8Pow(x: f64, y: f64): f64 = pow(x, y)
@export("hypot") fun v8Hypot(x: f64, y: f64): f64 = hypot(x, y)
@export("fmin") fun v8Fmin(x: f64, y: f64): f64 = fmin(x, y)
@export("fmax") fun v8Fmax(x: f64, y: f64): f64 = fmax(x, y)
