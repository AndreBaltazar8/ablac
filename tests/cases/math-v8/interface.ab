// abla/math and abla/math/v8 declare the same public interface: every function
// (name, parameter names and types, result type) and every top-level value
// (name, type, val or var), read from the compiler at compile time. Names
// starting with `__` are each module's own. Exits 42 when the two agree.
import "abla/io"
import "abla/compiler"
import "abla/math" as correct
import "abla/math/v8" as v8

compile fun endsWith(text: string, suffix: string): bool =
    text.size >= suffix.size && text.slice(text.size - suffix.size, text.size) == suffix

compile fun isPrivate(name: string): bool = name.size >= 2 && name[0] == 95 && name[1] == 95

// A binding's mangled name is `__abla_module_<the module's path in hex>__<name>`.
compile fun hex(text: string): string {
    val digits = "0123456789abcdef"
    var result = ""
    for (byte in text) result = result + digits.slice(byte >> 4, (byte >> 4) + 1) + digits.slice(byte & 15, (byte & 15) + 1)
    result
}

compile fun bindingModuleHex(mangled: string): string {
    val prefix = "__abla_module_"
    if (mangled.size <= prefix.size || mangled.slice(0, prefix.size) != prefix) return ""
    var index = prefix.size
    while (index < mangled.size && mangled[index] != 95) index += 1
    mangled.slice(prefix.size, index)
}

compile fun bindingName(mangled: string): string {
    val prefix = "__abla_module_"
    var index = prefix.size
    while (index < mangled.size && mangled[index] != 95) index += 1
    if (index + 2 > mangled.size) return mangled
    mangled.slice(index + 2, mangled.size)
}

compile fun sorted(items: array<string>): array<string> {
    val result: array<string> = []
    for (item in items) {
        result.append(item)
        var index = result.size - 1
        while (index > 0 && result[index - 1] > result[index]) {
            val swap = result[index - 1]
            result[index - 1] = result[index]
            result[index] = swap
            index -= 1
        }
    }
    result
}

// The public declarations of the module whose entry path ends with `suffix`.
compile fun surface(suffix: string): array<string> {
    val items: array<string> = []
    for (function in compilerFunctions()) {
        val name = compilerFunctionName(function)
        if (!endsWith(compilerFunctionModuleIdentity(function), suffix) || isPrivate(name)) continue
        var parameters = ""
        var index = 0
        while (index < compilerFunctionParameterCount(function)) {
            if (index > 0) parameters = parameters + ", "
            parameters = parameters + compilerFunctionParameterName(function, index) + ": " +
                compilerFunctionParameterType(function, index)
            index += 1
        }
        items.append("fun $name($parameters): ${compilerFunctionResultType(function)}")
    }
    for (binding in compilerBindings()) {
        val mangled = compilerBindingName(binding)
        val name = bindingName(mangled)
        if (!endsWith(bindingModuleHex(mangled), hex(suffix)) || isPrivate(name)) continue
        val keyword = if (compilerBindingIsMutable(binding)) "var" else "val"
        items.append("$keyword $name: ${compilerBindingExposedType(binding)}")
    }
    sorted(items)
}

// One line per declaration only one module has; empty when they agree.
compile fun differences(): string {
    val left = surface("/abla/math/entry.ab")
    val right = surface("/abla/math/v8/entry.ab")
    var text = ""
    if (left.size < 25) text = "abla/math: only ${left.size} public declarations found\n"
    for (item in left) {
        var found = false
        for (other in right) if (other == item) found = true
        if (!found) text = text + "only in abla/math:    $item\n"
    }
    for (item in right) {
        var found = false
        for (other in left) if (other == item) found = true
        if (!found) text = text + "only in abla/math/v8: $item\n"
    }
    if (text == "") "same ${left.size}" else text
}

val DIFFERENCES = #differences()

fun main: int {
    // both modules are reachable through their aliases
    if (correct.sqrt(4.0) != v8.sqrt(4.0) || correct.mathPi != v8.mathPi) return 1
    if (DIFFERENCES.size < 5 || DIFFERENCES.slice(0, 5) != "same ") {
        print(DIFFERENCES)
        return 2
    }
    println("math-v8 interface: abla/math and abla/math/v8 both declare ${DIFFERENCES.slice(5, DIFFERENCES.size)} public names alike")
    42
}
