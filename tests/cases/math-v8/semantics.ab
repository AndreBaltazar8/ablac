// abla/math/v8 answers as JavaScript's Math where JavaScript and abla/math
// disagree, and gives V8's bits for a few known cases; at run time and under
// `#` alike. Exits 42.
import "abla/io"
import "abla/float"
import "abla/math/v8"

fun bits(value: f64): int = f64ToBits(value)

// 0 when every check holds, else the number of the first that fails.
fun checks(): int {
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    // pow: NaN for (±1)^±inf and 1^NaN, as in JavaScript; x^±0 is 1 even for NaN
    if (!isNaN(pow(1.0, nan)) || !isNaN(pow(1.0, inf)) || !isNaN(pow(-1.0, -inf))) return 1
    if (pow(nan, 0.0) != 1.0 || pow(nan, -0.0) != 1.0 || pow(2.0, 10.0) != 1024.0) return 2
    if (!isNaN(pow(-8.0, 1.0 / 3.0)) || pow(-0.0, -3.0) != -inf || pow(0.5, inf) != 0.0) return 3
    // V8's own last bits: fdlibm's pow rounds these two the other way
    if (bits(pow(f64FromBits(-4602307467844517888), 22.0)) != 0x4436DC5A18E0757D) return 4
    if (bits(pow(f64FromBits(4621688461999472640), f64FromBits(4623924671618744320))) !=
        0x42C21B820A0DEBD4) return 5
    // fmin and fmax: NaN wins, and -0 is below +0
    if (!isNaN(fmin(nan, 1.0)) || !isNaN(fmin(1.0, nan)) || !isNaN(fmax(nan, 1.0))) return 6
    if (bits(fmin(0.0, -0.0)) != bits(-0.0) || bits(fmin(-0.0, 0.0)) != bits(-0.0)) return 7
    if (bits(fmax(-0.0, 0.0)) != 0 || bits(fmax(0.0, -0.0)) != 0) return 8
    if (fmin(2.0, -3.0) != -3.0 || fmax(2.0, -3.0) != 2.0) return 9
    // hypot: scaled, so no early overflow; an infinity wins over a NaN
    if (hypot(inf, nan) != inf || hypot(nan, -inf) != inf || !isNaN(hypot(nan, 1.0))) return 10
    if (hypot(3.0, 4.0) != 5.0 || bits(hypot(1e300, 1e300)) != 0x7E40E4D50F99B211) return 11
    if (bits(hypot(-0.0, -0.0)) != 0) return 12
    // trigonometry with V8's kernels, the huge reduction included
    if (bits(sin(1e300)) != 0xBFEA2C16B010E385 || bits(tan(1e10)) != 0xBFE1DE000F443F50) return 13
    if (bits(cos(3.0)) != 0xBFEFAE04BE85E5D2 || bits(sin(1.0)) != 0x3FEAED548F090CEE) return 14
    if (bits(atan2(1.0, -2.0)) != 0x40056C6E7397F5AE || atan2(-0.0, -1.0) != -mathPi) return 15
    if (exp(1.0) != mathE || log(mathE) != 1.0 || log(0.0) != -inf || !isNaN(log(-1.0))) return 16
    // fma has no JavaScript counterpart: abla/math's exact one, rounded once
    val above = f64FromBits(0x3FF0000000000001)
    val below = f64FromBits(0x3FEFFFFFFFFFFFFF)
    if (bits(fma(0.1, 10.0, -1.0)) != 0x3C90000000000000) return 17
    if (bits(fma(above, f64FromBits(0x3FEFFFFFFFFFFFFE), -1.0)) != 0xB970000000000000) return 18
    if (!isNaN(fma(inf, 0.0, 1.0)) || fma(2.0, 3.0, inf) != inf || bits(fma(below, 1.0, -below)) != 0) return 19
    0
}

compile fun checkedAtCompileTime(): int = checks()

val COMPILE_TIME = #checkedAtCompileTime()

fun main: int {
    val failed = checks()
    if (failed != 0) {
        println("math-v8 semantics: check $failed failed at run time")
        return failed
    }
    if (COMPILE_TIME != 0) {
        println("math-v8 semantics: check $COMPILE_TIME failed under #")
        return 100 + COMPILE_TIME
    }
    42
}
