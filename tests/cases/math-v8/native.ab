// Runs one abla/math/v8 function over the inputs run.mjs wrote: each line of
// the input file holds the bit patterns of the arguments as signed decimal
// integers, and each output line the result's bit pattern, or `nan` for any
// NaN (JavaScript doesn't keep NaN payloads apart).
import "abla/io"
import "abla/fs"
import "abla/float"
import "abla/process/arguments"
import "abla/math/v8"

fun apply(function: string, x: f64, y: f64): f64 = when (function) {
    "sqrt" -> sqrt(x)
    "floor" -> floor(x)
    "ceil" -> ceil(x)
    "trunc" -> trunc(x)
    "fabs" -> fabs(x)
    "sin" -> sin(x)
    "cos" -> cos(x)
    "tan" -> tan(x)
    "atan" -> atan(x)
    "exp" -> exp(x)
    "log" -> log(x)
    "atan2" -> atan2(x, y)
    "pow" -> pow(x, y)
    "hypot" -> hypot(x, y)
    "fmin" -> fmin(x, y)
    "fmax" -> fmax(x, y)
    else -> 0.0 / 0.0
}

fun main: int {
    val function = processArgument(0)
    // every function is a number at (0.5, 0.5); an unknown name is NaN
    if (isNaN(apply(function, 0.5, 0.5))) return 2
    val text = path(processArgument(1)).readText()
    val out = bufferedStandardOutput(1 << 16)
    var values: array<int> = [0, 0]
    var count = 0
    var number = 0
    var negative = false
    var digits = false
    var index = 0
    while (index < text.size) {
        val byte = text[index]
        if (byte == 45) negative = true
        else if (byte >= 48 && byte <= 57) {
            number = number * 10 + (byte - 48)
            digits = true
        } else if (digits) {
            values[count] = if (negative) 0 - number else number
            count += 1
            number = 0
            negative = false
            digits = false
        }
        if (byte == 10) {
            val result = apply(function, f64FromBits(values[0]),
                if (count > 1) f64FromBits(values[1]) else 0.0)
            out.writeLine(if (isNaN(result)) "nan" else "${f64ToBits(result)}")
            count = 0
        }
        index += 1
    }
    if (!out.flush()) return 1
    0
}
