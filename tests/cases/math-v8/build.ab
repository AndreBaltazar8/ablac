// Builds exports.ab as a release and a development WebAssembly module (the
// release module registers the target; the development module reuses it).
import "abla/wasm/build"

val release = #wasmBuildModule(
    "math-v8",
    "tests/cases/math-v8/exports.ab",
    "build/math-v8/math-v8.wasm",
    false,
    false
)
val development = #buildProgram(
    "math-v8-fast",
    "tests/cases/math-v8/exports.ab",
    "build/math-v8/math-v8-fast.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && development) 0 else 1
