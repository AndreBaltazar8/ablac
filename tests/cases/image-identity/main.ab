// A compiler's identity for its caches (src/toolchain.ab, bootstrapReadRunningImageIdentity): the linker's content hash of the running image
// when it carries one, else a hash of the whole image. Prints the linker id (empty without one), then what the identity reads as
// (size, two hashes), so tools/test-image-identity.sh can check both paths.
import "abla/io"
import "../../../src/toolchain.ab"

fun main: int {
    println(bootstrapRunningImageLinkerId())
    bootstrapReadRunningImageIdentity()
    println("${bootstrapRunningImageSize} ${bootstrapRunningImageFirst} ${bootstrapRunningImageSecond} ${bootstrapRunningImageTail}")
    return 0
}
