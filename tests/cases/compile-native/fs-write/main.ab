// abla/fs writes under `#` are staged: published when the build succeeds, and
// a staged path reads back with its staged contents during the compilation.
import "abla/compiler"
import "abla/io"
import "abla/fs"
#compilerGrant("filesystem.write")
#compilerGrant("filesystem.read")

fun generate(): string {
    val directory = path("build-fs-write")
    val made = directory.createDirectories()
    val file = directory.child("generated.txt")
    val written = file.writeText("first\n")
    val appended = file.appendText("second\n")
    "$made $written $appended ${file.exists()} ${file.readText().size} ${file.readTextResult().succeeded}"
}

fun main(): int {
    val report = #generate()
    println(report)
    if (report == "true true true true 13 true" &&
        path("build-fs-write/generated.txt").readText() == "first\nsecond\n") 42 else 1
}
