// A host provider needs its own capability: filesystem.read does not let a
// compile-time evaluation write, and the write is not performed.
import "abla/compiler"
import "abla/platform/host"
#compilerGrant("filesystem.read")

fun record(): bool = ablaHostWriteFileAtomic("denied-output.txt", "written")

fun main(): int = if (#record()) 1 else 0
