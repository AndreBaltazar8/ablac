// A compile-time write is a real write: it stays on disk when the compilation fails later on (#72).
import "abla/compiler"
import "abla/fs"
#compilerGrant("filesystem.write")

fun stage(): bool = path("build-fs-write-failed/written.txt").writeText("written")

fun broken(): int {
    val values = [1, 2]
    values[5]
}

fun main(): int = if (#stage()) #broken() else 0
