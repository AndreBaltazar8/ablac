// A staged write is discarded when the compilation fails later on.
import "abla/compiler"
import "abla/fs"
#compilerGrant("filesystem.write")

fun stage(): bool = path("build-fs-write-failed/never.txt").writeText("never")

fun broken(): int {
    val values = [1, 2]
    values[5]
}

fun main(): int = if (#stage()) #broken() else 0
