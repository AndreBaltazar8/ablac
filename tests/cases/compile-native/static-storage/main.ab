// A program's static storage under `#`: zeroed, and kept for the compilation. The
// host facts are the compiler's host (here also the program's).
import "abla/compiler"
#compilerGrant("trusted.native")
import "abla/unsafe/memory"
import "abla/platform/host"

val score = nativeStaticAllocate(16)

trusted fun scored(): int {
    val before = ablaUnsafeLoadI64(nativePointerFromAddress(score))
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(nativePointerFromAddress(score), 8), 40)
    before + 2 + ablaUnsafeLoadI64(ablaUnsafePointerOffset(nativePointerFromAddress(score), 8))
}

val compiledOnMacOS = #ablaHostIsMacOS()

fun main: int = if (compiledOnMacOS == ablaHostIsMacOS()) #scored() else 1
