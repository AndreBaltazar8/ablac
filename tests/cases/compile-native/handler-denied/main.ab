// A parser handler runs before the effect analysis; without the
// trusted.native grant its C call is denied when evaluated, not performed.
import "abla/compiler/parser"
import "abla/io"

noescape extern:"c" fun unlink(path: cstring): i32

compile fun parseRemove(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "{")
    parserExpect(cursor, "}")
    syntaxInteger(unlink("sentinel.txt"))
}

#compilerRegisterSubparser("remove", parseRemove)

fun main: int = $remove{}
