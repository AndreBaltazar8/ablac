// The flat host API links in a compiled program and runs at compile time
// under the capability each function implies, with the same results.
import "abla/compiler"
import "abla/platform/host"
#compilerGrant("filesystem.read")
#compilerGrant("filesystem.write")
#compilerGrant("process.io")
#compilerGrant("network")
#compilerGrant("clock")
#compilerGrant("random")

fun files(directory: string): string {
    val created = ablaHostCreateDirectories(directory)
    ablaHostWriteFile("$directory/a.txt", "alpha")
    val moved = ablaHostMoveFile("$directory/a.txt", "$directory/b.txt")
    val atomic = ablaHostWriteFileAtomic("$directory/c.txt", "gamma!")
    val text = ablaHostReadFile("$directory/b.txt")
    val kind = ablaHostFileKind("$directory/b.txt")
    val size = ablaHostFileSize("$directory/c.txt")
    val names = ablaHostListDirectory(directory)
    val removed = ablaHostRemoveFile("$directory/b.txt") &&
        ablaHostRemoveFile("$directory/c.txt")
    val gone = ablaHostFileKind("$directory/b.txt")
    "$created $moved $atomic $text $kind $size ${names[0]},${names[1]} $removed $gone"
}

fun echo(): string {
    val listener = ablaHostNetListen("127.0.0.1", 0, 4, false)
    val port = ablaHostNetLocalPort(listener)
    val client = ablaHostNetConnect("127.0.0.1", port, 2000)
    val server = ablaHostNetAccept(listener)
    val written = ablaHostNetWrite(client, "ping")
    val received = ablaHostNetRead(server, 16)
    val status = ablaHostNetStatus()
    val closed = ablaHostNetClose(server) && ablaHostNetClose(client) &&
        ablaHostNetClose(listener)
    "$written $received $status $closed"
}

fun datagram(): string {
    val receiver = ablaHostNetUdpBind("127.0.0.1", 0, false)
    val port = ablaHostNetLocalPort(receiver)
    val sender = ablaHostNetUdpBind("127.0.0.1", 0, false)
    val sent = ablaHostNetUdpSend(sender, "127.0.0.1", port, "datagram")
    val received = ablaHostNetUdpReceive(receiver, 64)
    val source = ablaHostNetSourceAddress()
    val closed = ablaHostNetClose(sender) && ablaHostNetClose(receiver)
    "$sent $received $source $closed"
}

fun main(): int {
    var failures = 0
    val expectedFiles = "true true true alpha 1 6 b.txt,c.txt true 0"
    val compiledFiles = #files("build-host-compile")
    if (compiledFiles != expectedFiles) failures = failures + 1
    if (files("build-host-run") != expectedFiles) failures = failures + 1
    val compiledEcho = #echo()
    if (compiledEcho != "4 ping 0 true" || echo() != compiledEcho) failures = failures + 1
    val compiledDatagram = #datagram()
    if (compiledDatagram != "8 datagram 127.0.0.1 true" ||
        datagram() != compiledDatagram) failures = failures + 1
    if (#ablaHostCaptureProcess(["echo", "captured"]) != "captured\n" ||
        ablaHostCaptureProcess(["echo", "captured"]) != "captured\n") {
        failures = failures + 1
    }
    if (#ablaHostRunProcess(["true"]) != 0 || ablaHostRunProcess(["false"]) == 0) {
        failures = failures + 1
    }
    if (#ablaHostMonotonicMilliseconds() <= 0) failures = failures + 1
    if (#ablaHostSecureRandom(8).size != 8 || ablaHostSecureRandom(8).size != 8) {
        failures = failures + 1
    }
    if (#ablaHostProcessorCount() < 1) failures = failures + 1
    ablaHostWriteStdout("host $compiledFiles | $compiledEcho | $compiledDatagram | $failures\n")
    if (failures == 0) 42 else failures
}
