// The standard library's own raw memory is contained: ByteBuffer's staging
// path (raw copies into an allocation it owns) runs under `#` with no grant.
import "abla/compiler"
import "abla/io"
import "abla/bytes"

fun staged(): string {
    val buffer = byteBuffer()
    buffer.stageText("compile ")
    buffer.stageFixed(1234, 2)
    buffer.stageText(" time")
    buffer.toText()
}

fun main(): int {
    val text = #staged()
    println(text)
    if (text == staged() && text == "compile 12.34 time") 42 else 1
}
