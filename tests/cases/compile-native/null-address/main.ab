// Granted native code that writes through a null pointer, or calls a function the
// compiler process doesn't have (a program's own @export, looked up with dlsym),
// fails the evaluation with E_EVAL_NATIVE_ADDRESS: the compiler doesn't crash.
import "abla/compiler"
#compilerGrant("trusted.native")
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted noescape extern:"c" fun dlsym(handle: i64*, symbol: cstring): i64*

@export("abla_test_null_address_export")
trusted fun exported(): void {
    return
}

trusted fun writeNull(): int {
    ablaUnsafeStoreI64(nativePointerFromAddress(0), 7)
    1
}

trusted fun callMissing(): int {
    val function = dlsym(nativePointerFromAddress(0), "abla_test_null_address_export")
    ablaUnsafeCallVoid0(nativePointerAddress(function))
    2
}

val written = #writeNull()
val called = #callMissing()

fun main: int = written + called
