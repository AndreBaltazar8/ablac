// extern:"c" calls, raw memory and the standard library's system calls,
// evaluated at compile time, give what the same code gives at run time.
import "abla/compiler"
import "abla/io"
import "abla/fs"
import "abla/unsafe/memory"
import "abla/unsafe/native"
#compilerGrant("trusted.native")

noescape extern:"c" fun strlen(text: cstring): int
noescape extern:"c" fun labs(value: int): int
noescape extern:"c" fun abs(value: i32): i32
noescape extern:"c" fun getpid(): i32
noescape extern:"c" fun fabs(value: f64): f64
noescape extern:"c" fun memset(target: i64*, value: i32, size: int): i64*
noescape extern:"c" fun memcmp(left: i64*, right: i64*, size: int): i32
noescape extern:"c" fun qsort(base: i64*, count: int, size: int, compare: i64*): void

// A C function calling back into Abla: qsort with an Abla comparison.
trusted fun compareWords(left: int, right: int): i32 =
    i32(ablaUnsafeLoadI64(nativePointerFromAddress(left)) -
        ablaUnsafeLoadI64(nativePointerFromAddress(right)))

trusted fun sorted(): int {
    val buffer = nativeByteBuffer(40)
    val values = [5, 3, 9, 1, 7]
    var index = 0
    while (index < 5) {
        buffer.storeI64(index * 8, values[index])
        index = index + 1
    }
    qsort(buffer.address, 5, 8, nativePointerFromAddress(
        nativeFunctionAddress(compareWords)
    ))
    var digits = 0
    index = 0
    while (index < 5) {
        digits = digits * 10 + buffer.loadI64(index * 8)
        index = index + 1
    }
    buffer.close()
    digits
}

// Bytes through a C call and raw loads: memset fills, the loads read back.
trusted fun filled(): int {
    val buffer = nativeByteBuffer(16)
    memset(buffer.address, 7, 16)
    buffer.store(3, 250)
    val word = ablaUnsafeLoadU32(buffer.pointerAt(0))
    val total = buffer.load(0) + buffer.load(3) + buffer.load(15)
    buffer.close()
    total * 1000000000 + word
}

trusted fun compareBytes(): int {
    val left = nativeByteBuffer(4)
    val right = nativeByteBuffer(4)
    memset(left.address, 1, 4)
    memset(right.address, 2, 4)
    val order = memcmp(left.address, right.address, 4)
    left.close()
    right.close()
    if (order < 0) -1 else if (order > 0) 1 else 0
}

fun main(): int {
    var failures = 0
    if (#strlen("compile time") != strlen("compile time")) failures = failures + 1
    if (#labs(-42) != 42) failures = failures + 1
    if (#abs(-7) != abs(-7)) failures = failures + 1
    if (#getpid() <= 0) failures = failures + 1
    if (#fabs(-2.5) != 2.5) failures = failures + 1
    if (#filled() != filled()) failures = failures + 1
    if (#compareBytes() != -1) failures = failures + 1
    if (#sorted() != 13579 || sorted() != 13579) failures = failures + 1
    if (#Path("input.txt").readText() != Path("input.txt").readText()) {
        failures = failures + 1
    }
    print("compile-native ${#filled()} ${#strlen("abc")} $failures\n")
    if (failures == 0) 42 else failures
}
