// A library of the root manifest's nativeLibraries is loaded at compile time
// and called through the same declarations the program links against.
import "abla/compiler"
import "abla/io"
import "abla/float"
import "abla/float/text"
#compilerGrant("trusted.native")

noescape extern:"c" fun ctnative_mix(left: int, right: i32): int
noescape extern:"c" fun ctnative_scale(value: f64, factor: f32): f64
noescape extern:"c" fun ctnative_calls(): int

fun main(): int {
    val atCompileTime = #ctnative_mix(42, 7)
    val scaled = #ctnative_scale(1.5, ablaConvertF64ToF32(4.0))
    // Library state persists for the compilation: at least the call above happened.
    val calls = #ctnative_calls()
    print("library $atCompileTime $scaled $calls\n")
    if (atCompileTime == ctnative_mix(42, 7) && scaled == 6.0 && calls >= 1 &&
        #ctnative_mix(12, -5) == 11995) 42 else 1
}
