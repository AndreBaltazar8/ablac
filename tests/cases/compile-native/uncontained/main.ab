// A program's own trusted raw memory is trusted.native, even through the
// standard library's unsafe boundary.
import "abla/compiler"
import "abla/unsafe/memory"

trusted fun poke(): int {
    val buffer = nativeByteBuffer(8)
    buffer.store(0, 7)
    val value = buffer.load(0)
    buffer.close()
    value
}

fun main(): int = #poke()
