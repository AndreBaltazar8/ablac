// abla/fs under `#` with the filesystem.read grant: the run-time API, the
// same answers, and println writing to the compiler's standard output.
import "abla/compiler"
import "abla/io"
import "abla/fs"
#compilerGrant("filesystem.read")

fun announce(text: string): string {
    println("compile time read ${text.size} bytes")
    text
}

fun main(): int {
    var failures = 0
    val text = #announce(path("input/data.txt").readText())
    if (text != path("input/data.txt").readText()) failures = failures + 1
    val present = #path("input/data.txt").readTextResult()
    if (!present.succeeded || present.text != text || present.errorCode != 0) failures = failures + 1
    val missing = #path("input/absent.txt").readTextResult()
    if (missing.succeeded || missing.errorCode != 2 || missing.text != "") failures = failures + 1
    val runtimeMissing = path("input/absent.txt").readTextResult()
    if (runtimeMissing.succeeded || runtimeMissing.errorCode != 2) failures = failures + 1
    if (#path("input/absent.txt").readText() != "") failures = failures + 1
    if (!#path("input/data.txt").exists() || #path("input/absent.txt").exists()) failures = failures + 1
    if (#path("input/data.txt").info().size != text.size) failures = failures + 1
    // Build output and compiler scratch must not change this input listing.
    val entries = #path("input").entries().size
    if (entries == 0 || entries != path("input").entries().size) failures = failures + 1
    if (#currentDirectory().text != currentDirectory().text) failures = failures + 1
    println("fs-read $failures")
    if (failures == 0) 42 else failures
}
