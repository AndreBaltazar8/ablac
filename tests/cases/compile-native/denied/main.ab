// Without the trusted.native grant a compile-time C call is rejected, and
// nothing performs it: lowering still evaluates `#` expressions for its
// diagnostics, so the evaluator checks the grant too. The sentinel survives.
import "abla/compiler"
import "abla/io"

noescape extern:"c" fun unlink(path: cstring): i32

fun main() {
    print("${#unlink("sentinel.txt")}\n")
}
