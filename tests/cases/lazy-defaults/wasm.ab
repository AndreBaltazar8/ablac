var count = 0
fun mark(n: int): int { count = count + 1; n }
fun f(a: int, b: int = mark(3)): int = a + b
@export("checks")
fun checks(): int {
    count = 0
    val supplied = f(1, 2)
    if (supplied != 3 || count != 0) return 1
    val omitted = f(1)
    if (omitted != 4 || count != 1) return 2
    0
}
