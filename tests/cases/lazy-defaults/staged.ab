class Counter(var value: int)
fun mark(var counter: Counter): int {
    counter.value = counter.value + 1
    3
}
fun f(var counter: Counter, value: int = mark(counter)): int = value
compile fun check(): int {
    val counter = Counter(0)
    val supplied = f(counter, 2)
    if (supplied != 2 || counter.value != 0) return 1
    val omitted = f(counter)
    if (omitted != 3 || counter.value != 1) return 2
    0
}
fun main: int = #check()
