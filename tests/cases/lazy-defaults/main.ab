var trace = 0
var made = 0
var dropped = 0
fun mark(n: int): int { trace = trace * 10 + n; n }
resource class Ticket(val value: int) { fun drop(): void { dropped = dropped + value } }
fun makeTicket(): Ticket { made = made + 1; Ticket(7) }
fun add(a: int, b: int = mark(3), c: int = mark(b + 1)): int = a + b + c
fun take(own ticket: Ticket = makeTicket()): int = ticket.value
class Box(val n: int) {
    fun add(a: int, b: int = mark(5)): int = n + a + b
}
fun Box.extend(a: int = mark(6)): int = this.n + a
fun consume(): bool {
    val first = take(Ticket(5))
    val firstOK = first == 5 && made == 0 && dropped == 5
    val second = take()
    val secondOK = second == 7 && made == 1 && dropped == 12
    val named = take(ticket = Ticket(9))
    firstOK && secondOK && named == 9 && made == 1 && dropped == 21
}
fun main: int {
    if (add(1, 2, 3) != 6 || trace != 0) return 1
    if (add(1, 2) != 6 || trace != 3) return 2
    trace = 0
    if (add(1) != 8 || trace != 34) return 3
    trace = 0
    if (Box(1).add(2, 3) != 6 || trace != 0) return 4
    if (Box(1).add(2) != 8 || trace != 5) return 5
    trace = 0
    if (add(c = mark(1), a = mark(2)) != 6 || trace != 123) return 7
    trace = 0
    if (Box(1).extend(2) != 3 || trace != 0) return 8
    if (Box(1).extend() != 7 || trace != 6) return 9
    if (!consume()) return 6
    0
}
