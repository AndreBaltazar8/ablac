// The only float here is one a `#` computation stores into an `any`. The build keeps the kind
// comparison, so the integer 0 differs from 0.0 and the float equals itself. Exits with the
// first failing check.
compile fun computed(): any = 0.0

val COMPUTED: any = #computed()

fun main(): int {
    val zero: any = 0
    if (zero == COMPUTED) return 1
    if (!(zero != COMPUTED)) return 2
    if (COMPUTED != COMPUTED) return 3
    0
}
