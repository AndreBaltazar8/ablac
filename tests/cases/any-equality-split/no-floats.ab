// No float is erased into `any` here, so a whole-program build leaves the erased-float
// comparison out of `==`: tools/test-any-eq-split.sh checks the module has no float-bits
// compare. Exits with the first failing check.
class Point(val x: int, val y: int)

fun main(): int {
    val one: any = 1
    val sameOne: any = 1
    val two: any = 2
    val word: any = "word"
    val sameWord: any = "wor" + "d"
    val flag: any = true
    val point = Point(1, 2)
    val pointAny: any = point
    val samePointAny: any = point
    val otherPointAny: any = Point(1, 2)
    if (one != sameOne) return 1
    if (one == two) return 2
    if (word != sameWord) return 3
    if (one == word) return 4
    if (flag == one) return 5
    if (pointAny != samePointAny) return 6
    if (pointAny == otherPointAny) return 7
    return 0
}
