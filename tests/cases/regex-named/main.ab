import "abla/io"
import "abla/process/exit"
import "abla/regex"
import "first.ab" as first
import "second.ab" as second

fun require(value: bool, scenario: string): void {
    if (!value) panic(scenario)
    return
}

val frozenNamed = #$regex("(?<year>a)")

fun main {
    val frozenMatch = frozenNamed.find("a") ?? panic("frozen named match")
    require(frozenMatch.year == "a", "named matcher can be frozen")
    val date = $regex("(?<year>\\d{4})-(?<month>\\d{2})(?:-(?<day>\\d{2}))?")
    val short = date.matchFull("2026-11") ?? panic("short date")
    val year: string = short.year
    val month: string = short.month
    val day: string? = short.day
    require(year == "2026" && month == "11" && day == null, "required and optional")
    val long = date.find("x2026-11-21y") ?? panic("long date")
    require(long.day == "21", "search projects optional capture")
    require(date.findAll("2026-11 and 2027-01").size == 2, "findAll projects")
    require(!date.matches("2026") && date.find("no date") == null, "no match")
    require(date.replace("2026-11", "$2/$1") == "11/2026", "numbered replacement")
    val raw = date.regex.find("x2026-11") ?? panic("raw match")
    require(raw.start() == 1 && raw.group(1) == "2026", "raw spans")
    val choice = $regex("(?:(?<from>a)|(?<to>b))").matchFull("b") ?? panic("choice")
    require(choice.from == null && choice.to == "b", "alternation")
    val repeats = $regex("(?:(?<earlier>a)|b)+(?<empty>)(?<zero>z){0}(?<tail>c){1,2}")
    val repeat = repeats.matchFull("abbcc") ?? panic("repeats")
    val empty: string = repeat.empty
    val tail: string = repeat.tail
    require(repeat.earlier == "a" && empty == "" && repeat.zero == null && tail == "c", "participation agrees with VM")
    val one = first.capture() ?? panic("first module")
    val two = second.capture() ?? panic("second module")
    require(one.left == "a" && two.side == "b", "sites with the same local key")
    val runtime = regexCompile("(?<name>a)").regex.find("a") ?? panic("runtime group")
    require(runtime.group(1) == "a", "runtime numbered access")
    println("ok")
}
