import "abla/wasm/build"

// Development modules for tools/test-codegen-cache.sh, which builds this file twice
// with a cold code generation cache and a warm one: one whose `orElse`
// alternatives are left by an exception (exception handling), and one without.
// The first registers the target; the second reuses it.
val unwinding = #wasmBuildModule(
    "codegen-cache-unwinding", "tests/cases/stm/unwinding/module.ab",
    "build/codegen-cache/wasm/unwinding.wasm", true, false
)
val plain = #buildProgram(
    "codegen-cache-plain", "tests/cases/stm/surface-module.ab",
    "build/codegen-cache/wasm/plain.wasm", "wasm32-module", "module", true, false
)

fun main: int = if (unwinding && plain) 0 else 1
