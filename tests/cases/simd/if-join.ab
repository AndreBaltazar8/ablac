import "abla/simd"
// An `if`'s value on a vector stays a register: its `_direct` functions box nothing.
fun pick(c: bool, a: u32x4, b: u32x4): u32x4 {
    val j = if (c) a + b else a
    j + b
}
fun wide(c: bool, a: u64x4, b: u64x4): u64x4 {
    val j = if (c) a else b
    j
}
fun real(c: bool, a: f32x4, b: f32x4): f32x4 = if (c) a else b
fun main: int {
    val a = u32x4Splat(1)
    val b = u32x4Splat(20)
    if (pick(true, a, b).get(0) != u32(41)) return 1
    if (pick(false, a, b).get(1) != u32(21)) return 2
    if (wide(false, u64x4Splat(u64(3)), u64x4Splat(u64(4))).get(2) != u64(4)) return 3
    if (real(true, f32x4Splat(f32(1.5)), f32x4Splat(f32(2.0))).get(3) != f32(1.5)) return 4
    0
}
