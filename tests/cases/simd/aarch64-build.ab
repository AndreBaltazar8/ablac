// Builds the checks as an AArch64 Linux object: no such executable target exists, so
// tools/test-simd.sh links it with a startup and C stubs of its own to run under qemu.
import "abla/build"
import "abla/compiler"

#compilerGrant("filesystem.write")

compile fun simdAarch64Object(): bool {
    val target = defineTarget("linux-arm64-object", "aarch64-unknown-linux-gnu", "elf", "none", "none", false, false)
    target && buildProgram(
        "simd-aarch64", "tests/cases/simd/object.ab", "build/simd/aarch64.o", "linux-arm64-object",
        "object", false, false
    )
}

val built = #simdAarch64Object()

fun main: int = if (built) 0 else 1
