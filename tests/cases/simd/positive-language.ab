import "abla/simd"
// a program's ordinary language around vectors: joins, nullable, default, global, etc.
val SHARED = u32x4(u32(1), u32(2), u32(3), u32(4))
var COUNTER = u32x4Splat(u32(0))
fun defaulted(a: u32x4 = u32x4Splat(u32(5))): u32 = a.get(2)
fun maybe(flag: bool): u32x4? = if (flag) SHARED else null
fun chosen(flag: bool): u32x4 = if (flag) SHARED else SHARED + SHARED
fun viaWhen(k: int): u32x4 = when (k) {
    0 -> SHARED
    else -> u32x4Splat(u32(9))
}
fun takesFn(f: (u32x4) -> u32x4): u32 = f(SHARED).sum()
fun main: int {
    COUNTER = COUNTER + SHARED
    COUNTER = COUNTER + SHARED
    if (COUNTER.get(3) != u32(8)) return 1
    if (defaulted() != u32(5)) return 2
    if (defaulted(SHARED) != u32(3)) return 3
    val m = maybe(true)
    if (m == null) return 4
    if (m.get(1) != u32(2)) return 5
    if (maybe(false) != null) return 6
    if (chosen(false).get(0) != u32(2)) return 7
    if (viaWhen(3).get(0) != u32(9)) return 8
    if (takesFn({ x: u32x4 -> x ^ x }) != u32(0)) return 9
    val map = Map<string, u32x4>()
    map.set("k", SHARED)
    val found = map.get("k")
    if (found == null) return 10
    if (found.get(0) != u32(1)) return 10
    var v = SHARED
    var i = 0
    while (i < 3) { v = v + SHARED; i = i + 1 }
    if (v.get(0) != u32(4)) return 11
    val bytes = v.bytes()
    if (bytes.size != 16 || int(bytes[0]) != 4) return 12
    if (u32x4Load(bytes) .get(1) != u32(8)) return 13
    0
}
