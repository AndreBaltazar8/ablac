import "abla/simd"
import "abla/float"

val table = #u32x4(1, 2, 3, 4).swizzle2(u32x4Splat(20), u32x4(4, 1, 8, 3))
val bytes = #u64x8Splat(u64(19)).with(7, u64(23)).bytes()
val load = #u64x8Load(bytes)
val bits = #(
    f32x4(-2.5, 2.5, -0.5, f32FromBits(u32(2143289344))).roundEven().toI32x4().asU32x4()
)

fun main: int {
    if (table.bytes() != u32x4(20, 2, 0, 4).bytes()) return 221
    if (load.get(0) != u64(19) || load.get(7) != u64(23)) return 222
    if (bits.bytes() != i32x4(-2, 2, 0, 0).bytes()) return 223
    0
}
