import "checks.ab"
import "hardware.ab"
import "wide.ab"
import "abla/simd/target"
import "abla/process/arguments"
import "abla/sys/linux/random"

fun main: int {
    if (simdTargetArch() == SIMD_ARCH_AARCH64 && !secureRandomBytes(16).succeeded) return 121
    val failed = simdChecks()
    if (failed != 0) return failed
    val wide = simdWideChecks(processArgumentCount() > 0 && processArgument(0) == "--require-avx512")
    if (wide != 0) wide else simdHardwareChecks()
}
