// The checks as an object for targets with no executable here: tools/test-simd.sh links
// it with a small startup of its own to run it under qemu.
import "checks.ab"
import "hardware.ab"
import "abla/simd/target"
import "abla/sys/linux/random"

@export("simd_checks")
fun exportedChecks(): int {
    // getrandom has another system call number on AArch64 (this runs under qemu, which refuses x86-64's).
    if (simdTargetArch() == SIMD_ARCH_AARCH64 && !secureRandomBytes(16).succeeded) return 9001
    val failed = simdChecks()
    if (failed != 0) failed else simdHardwareChecks()
}
