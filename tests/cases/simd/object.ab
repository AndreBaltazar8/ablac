// The checks as an object for targets with no executable here: tools/test-simd.sh links
// it with a small startup of its own to run it under qemu.
import "checks.ab"
import "hardware.ab"

@export("simd_checks")
fun exportedChecks(): int {
    val failed = simdChecks()
    if (failed != 0) failed else simdHardwareChecks()
}
