import "abla/simd"

private @noinline fun wideAdd(a: u32x16, b: u32x16): u32x16 = a + b

private @target("avx512f") @noinline fun wideAddF(a: u32x16, b: u32x16): u32x16 = a + b

private @target("avx512bw") @noinline fun wideAddBW(a: u8x64, b: u8x64): u8x64 = a + b

class WideBox(val words: u32x16)

private fun checkWide(a: u32x16, b: u32x16): int {
    val sum = wideAdd(a, b)
    if (cpuHas("avx512f") && wideAddF(a, b).bytes() != sum.bytes()) return 211
    for (lane in 0 until 16) {
        if (sum.get(lane) != a.get(lane) + b.get(lane)) return 212
    }
    val reversed = sum.reverse()
    val box = WideBox(reversed)
    val values: array<u32x16> = [a, box.words]
    if (u32x16Concat(sum.low(), sum.high()).bytes() != sum.bytes() ||
        values[1].bytes() != reversed.bytes() || reversed.get(15) != sum.get(0)) return 213
    0
}

private fun checkWideBytes(left: u8x64, right: u8x64): int {
    val sum = left + right
    if (cpuHas("avx512bw") && wideAddBW(left, right).bytes() != sum.bytes()) return 214
    if (!left.eq(left).all() || left.with(63, 255).bitmask() != -9223372036854775807 - 1) return 215
    var indices = u8x64Splat(0)
    for (lane in 0 until 64) indices = indices.with(lane, u8((lane * 11) & 127))
    indices = indices.with(0, 128).with(63, 255)
    val picked = left.swizzle2(right, indices)
    for (lane in 0 until 64) {
        val index = int(indices.get(lane))
        val expected = if (index < 64) left.get(index)
            else if (index < 128) right.get(index - 64) else u8(0)
        if (picked.get(lane) != expected) return 217
    }
    if (left.widenHigh().get(0) != u16(left.get(32)) ||
        u16x32Splat(256).narrowSaturating(u16x32Splat(30)).get(31) != u8(255)) return 218
    0
}

fun simdWideChecks(requireAvx512: bool = false): int {
    if (requireAvx512 && (!cpuHas("avx512f") || !cpuHas("avx512bw"))) return 216
    var words = u32x16Splat(0)
    var bytes = u8x64Splat(0)
    for (lane in 0 until 16) words = words.with(lane, u32(lane * 101))
    for (lane in 0 until 64) bytes = bytes.with(lane, u8(lane * 2))
    val wordResult = checkWide(words, u32x16Splat(45))
    if (wordResult != 0) return wordResult
    val byteResult = checkWideBytes(bytes, u8x64Splat(71))
    if (byteResult != 0) return byteResult
    if (f64x8Splat(-1.5).roundEven().get(7) != -2.0 ||
        f32x16Splat(12.25).toF64x8High().get(7) != 12.25) return 219
    0
}
