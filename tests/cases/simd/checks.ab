// Every operation of abla/simd on every vector type, against values worked out without
// the compiler. Generated by tools/simd/gen-checks.py; change that and run it again.
import "abla/simd"
import "abla/float"

var simdFailure = 0
var simdCheck = 0

fun simdHex(bytes: string): string {
    val digits = "0123456789abcdef"
    var text = ""
    for (at in 0 until bytes.size) {
        val byte = int(bytes[at])
        text = text + digits.slice(byte >> 4, (byte >> 4) + 1) + digits.slice(byte & 15, (byte & 15) + 1)
    }
    text
}

fun simdExpect(bytes: string, hex: string): void {
    simdCheck = simdCheck + 1
    if (simdFailure == 0 && simdHex(bytes) != hex) simdFailure = simdCheck
}

fun simdTrue(value: bool): void {
    simdCheck = simdCheck + 1
    if (simdFailure == 0 && !value) simdFailure = simdCheck
}

@noinline fun simdCheckI8x16(): void {
    val a = i8x16(i8(-1), i8(0), i8(7), i8(-1), i8(0), i8(1), i8(7), i8(-1), i8(92), i8(61), i8(-1), i8(-1), i8(-119), i8(127), i8(-1), i8(-128))
    val b = i8x16(i8(-1), i8(-1), i8(-100), i8(3), i8(3), i8(42), i8(-37), i8(1), i8(63), i8(94), i8(-115), i8(127), i8(-118), i8(3), i8(-95), i8(33))
    simdExpect((a).bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect((i8x16Splat(i8(-1))).bytes(), "ffffffffffffffffffffffffffffffff")
    simdExpect((a.with(15, i8(-1))).bytes(), "ff0007ff000107ff5c3dffff897fffff")
    simdTrue(a.get(8) == i8(92))
    simdExpect((a + b).bytes(), "feffa302032be2009b9b8c7e1382a0a1")
    simdExpect((a - b).bytes(), "00016bfcfdd72cfe1ddf7280ff7c5e5f")
    simdExpect((a * b).bytes(), "010044fd002afdffa4667381da7d5f80")
    simdExpect((-a).bytes(), "0100f90100fff901a4c3010177810180")
    simdExpect((a.min(b)).bytes(), "ffff9cff0001dbff3f3d8dff8903a180")
    simdExpect((a.max(b)).bytes(), "ff000703032a07015c5eff7f8a7fff21")
    simdExpect((a.abs()).bytes(), "01000701000107015c3d0101777f0180")
    simdExpect((a & b).bytes(), "ff000403000003011c1c8d7f8803a100")
    simdExpect((a | b).bytes(), "ffff9fff032bdfff7f7fffff8b7fffa1")
    simdExpect((a ^ b).bytes(), "00ff9bfc032bdcfe63637280037c5ea1")
    simdExpect((~a).bytes(), "00fff800fffef800a3c200007680007f")
    simdExpect((a.andNot(b)).bytes(), "000003fc000104fe40217280017c5e80")
    simdExpect((a.addSat(b)).bytes(), "feffa302032be2007f7f8c7e807fa0a1")
    simdExpect((a.subSat(b)).bytes(), "00016bfcfdd72cfe1ddf7280ff7c5e80")
    simdExpect((a << 3).bytes(), "f80038f8000838f8e0e8f8f848f8f800")
    simdExpect((a >> 3).bytes(), "ff0000ff000000ff0b07fffff10ffff0")
    simdExpect((a << 8).bytes(), "00000000000000000000000000000000")
    simdExpect((a >> 13).bytes(), "00000000000000000000000000000000")
    simdExpect((a.rotl(3)).bytes(), "ff0038ff000838ffe2e9ffff4cfbff04")
    simdExpect((a.rotr(5)).bytes(), "ff0038ff000838ffe2e9ffff4cfbff04")
    simdExpect(a.eq(b).bytes(), "ff000000000000000000000000000000")
    simdExpect(a.ne(b).bytes(), "00ffffffffffffffffffffffffffffff")
    simdExpect(a.lt(b).bytes(), "000000ffffff00ff00ff00ffff0000ff")
    simdExpect(a.le(b).bytes(), "ff0000ffffff00ff00ff00ffff0000ff")
    simdExpect(a.gt(b).bytes(), "00ffff000000ff00ff00ff0000ffff00")
    simdExpect(a.ge(b).bytes(), "ffffff000000ff00ff00ff0000ffff00")
    simdExpect((a.lt(b).select(a, b)).bytes(), "ffff9cff0001dbff3f3d8dff8903a180")
    simdTrue(a.lt(b).bitmask() == 39608)
    simdTrue(a.lt(b).any() == true)
    simdTrue(a.lt(b).all() == false)
    simdTrue(a.sum() == i8(42))
    simdExpect((a.reverse()).bytes(), "80ff7f89ffff3d5cff070100ff0700ff")
    simdExpect((a.interleaveLow(b)).bytes(), "ffff00ff079cff030003012a07dbff01")
    simdExpect((a.interleaveHigh(b)).bytes(), "5c3f3d5eff8dff7f898a7f03ffa18021")
    simdExpect((i8x16Shuffle(a, b, 3, 26, 9, 3, 16, 2, 3, 6, 0, 4, 18, 12, 23, 15, 22, 18)).bytes(), "ff8d3dffff07ff07ff009c890180db9c")
    simdExpect(a.asI16x8().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asI32x4().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asI64x2().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asU8x16().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asU16x8().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asU32x4().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asU64x2().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asF32x4().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(a.asF64x2().bytes(), "ff0007ff000107ff5c3dffff897fff80")
    simdExpect(i8x16Load("xx" + a.bytes() + "yy", 2).bytes(), "ff0007ff000107ff5c3dffff897fff80")
}

@noinline fun simdCheckI16x8(): void {
    val a = i16x8(i16(3), i16(22406), i16(-11841), i16(7), i16(3357), i16(7), i16(-28485), i16(-1))
    val b = i16x8(i16(15343), i16(-5010), i16(5320), i16(-29084), i16(-32768), i16(4418), i16(-25013), i16(3))
    simdExpect((a).bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect((i16x8Splat(i16(3))).bytes(), "03000300030003000300030003000300")
    simdExpect((a.with(7, i16(15343))).bytes(), "03008657bfd107001d0d0700bb90ef3b")
    simdTrue(a.get(4) == i16(3357))
    simdExpect((a + b).bytes(), "f23bf44387e66b8e1d8d4911062f0200")
    simdExpect((a - b).bytes(), "14c4186bf7bca3711d8dc5ee70f2fcff")
    simdExpect((a * b).bytes(), "cdb3942338c9bce40080ce78c9d0fdff")
    simdExpect((-a).bytes(), "fdff7aa8412ef9ffe3f2f9ff456f0100")
    simdExpect((a.min(b)).bytes(), "03006eecbfd1648e00800700bb90ffff")
    simdExpect((a.max(b)).bytes(), "ef3b8657c81407001d0d42114b9e0300")
    simdExpect((a.abs()).bytes(), "03008657412e07001d0d0700456f0100")
    simdExpect((a & b).bytes(), "0300064488100400000002000b900300")
    simdExpect((a | b).bytes(), "ef3beeffffd5678e1d8d4711fb9effff")
    simdExpect((a ^ b).bytes(), "ec3be8bb77c5638e1d8d4511f00efcff")
    simdExpect((~a).bytes(), "fcff79a8402ef8ffe2f2f8ff446f0000")
    simdExpect((a.andNot(b)).bytes(), "0000801337c103001d0d0500b000fcff")
    simdExpect((a.addSat(b)).bytes(), "f23bf44387e66b8e1d8d491100800200")
    simdExpect((a.subSat(b)).bytes(), "14c4186bf7bca371ff7fc5ee70f2fcff")
    simdExpect((a << 3).bytes(), "180030bcf88d3800e8683800d885f8ff")
    simdExpect((a >> 3).bytes(), "0000f00a37fa0000a301000017f2ffff")
    simdExpect((a << 16).bytes(), "00000000000000000000000000000000")
    simdExpect((a >> 21).bytes(), "00000000000000000000000000000000")
    simdExpect((a.rotl(3)).bytes(), "180032bcfe8d3800e8683800dc85ffff")
    simdExpect((a.rotr(5)).bytes(), "0018bc328dfe003868e8003885dcffff")
    simdExpect(a.eq(b).bytes(), "00000000000000000000000000000000")
    simdExpect(a.ne(b).bytes(), "ffffffffffffffffffffffffffffffff")
    simdExpect(a.lt(b).bytes(), "ffff0000ffff00000000ffffffffffff")
    simdExpect(a.le(b).bytes(), "ffff0000ffff00000000ffffffffffff")
    simdExpect(a.gt(b).bytes(), "0000ffff0000ffffffff000000000000")
    simdExpect(a.ge(b).bytes(), "0000ffff0000ffffffff000000000000")
    simdExpect((a.lt(b).select(a, b)).bytes(), "03006eecbfd1648e00800700bb90ffff")
    simdTrue(a.lt(b).bitmask() == 229)
    simdTrue(a.lt(b).any() == true)
    simdTrue(a.lt(b).all() == false)
    simdTrue(a.sum() == i16(-14547))
    simdExpect((a.reverse()).bytes(), "ffffbb9007001d0d0700bfd186570300")
    simdExpect((a.interleaveLow(b)).bytes(), "0300ef3b86576eecbfd1c8140700648e")
    simdExpect((a.interleaveHigh(b)).bytes(), "1d0d008007004211bb904b9effff0300")
    simdExpect((i16x8Shuffle(a, b, 12, 5, 2, 10, 15, 8, 2, 9)).bytes(), "00800700bfd1c8140300ef3bbfd16eec")
    simdExpect(a.asI8x16().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asI32x4().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asI64x2().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asU8x16().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asU16x8().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asU32x4().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asU64x2().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asF32x4().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(a.asF64x2().bytes(), "03008657bfd107001d0d0700bb90ffff")
    simdExpect(i16x8Load("xx" + a.bytes() + "yy", 2).bytes(), "03008657bfd107001d0d0700bb90ffff")
}

@noinline fun simdCheckI32x4(): void {
    val a = i32x4(i32(1805273429), i32(-707480172), i32(-1), i32(0))
    val b = i32x4(i32(1), i32(1422473512), i32(-2147483648), i32(-1043238538))
    simdExpect((a).bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect((i32x4Splat(i32(1805273429))).bytes(), "55499a6b55499a6b55499a6b55499a6b")
    simdExpect((a.with(3, i32(1))).bytes(), "55499a6b94b5d4d5ffffffff01000000")
    simdTrue(a.get(2) == i32(-1))
    simdExpect((a + b).bytes(), "56499a6bbcee9d2affffff7f7671d1c1")
    simdExpect((a - b).bytes(), "54499a6b6c7c0b81ffffff7f8a8e2e3e")
    simdExpect((a * b).bytes(), "55499a6b2053dee60000008000000000")
    simdExpect((-a).bytes(), "abb665946c4a2b2a0100000000000000")
    simdExpect((a.min(b)).bytes(), "0100000094b5d4d5000000807671d1c1")
    simdExpect((a.max(b)).bytes(), "55499a6b2839c954ffffffff00000000")
    simdExpect((a.abs()).bytes(), "55499a6b6c4a2b2a0100000000000000")
    simdExpect((a & b).bytes(), "010000000031c0540000008000000000")
    simdExpect((a | b).bytes(), "55499a6bbcbdddd5ffffffff7671d1c1")
    simdExpect((a ^ b).bytes(), "54499a6bbc8c1d81ffffff7f7671d1c1")
    simdExpect((~a).bytes(), "aab665946b4a2b2a00000000ffffffff")
    simdExpect((a.andNot(b)).bytes(), "54499a6b94841481ffffff7f00000000")
    simdExpect((a.addSat(b)).bytes(), "56499a6bbcee9d2a000000807671d1c1")
    simdExpect((a.subSat(b)).bytes(), "54499a6b6c7c0b81ffffff7f8a8e2e3e")
    simdExpect((a << 3).bytes(), "a84ad25ca0aca5aef8ffffff00000000")
    simdExpect((a >> 3).bytes(), "2a49730db296bafaffffffff00000000")
    simdExpect((a << 32).bytes(), "00000000000000000000000000000000")
    simdExpect((a >> 37).bytes(), "00000000000000000000000000000000")
    simdExpect((a.rotl(3)).bytes(), "ab4ad25ca6aca5aeffffffff00000000")
    simdExpect((a.rotr(5)).bytes(), "4ad25cabaca5aea6ffffffff00000000")
    simdExpect(a.toF32x4().bytes(), "9334d74e2aad28ce000080bf00000000")
    simdExpect(a.eq(b).bytes(), "00000000000000000000000000000000")
    simdExpect(a.ne(b).bytes(), "ffffffffffffffffffffffffffffffff")
    simdExpect(a.lt(b).bytes(), "00000000ffffffff0000000000000000")
    simdExpect(a.le(b).bytes(), "00000000ffffffff0000000000000000")
    simdExpect(a.gt(b).bytes(), "ffffffff00000000ffffffffffffffff")
    simdExpect(a.ge(b).bytes(), "ffffffff00000000ffffffffffffffff")
    simdExpect((a.lt(b).select(a, b)).bytes(), "0100000094b5d4d5000000807671d1c1")
    simdTrue(a.lt(b).bitmask() == 2)
    simdTrue(a.lt(b).any() == true)
    simdTrue(a.lt(b).all() == false)
    simdTrue(a.sum() == i32(1097793256))
    simdExpect((a.reverse()).bytes(), "00000000ffffffff94b5d4d555499a6b")
    simdExpect((a.interleaveLow(b)).bytes(), "55499a6b0100000094b5d4d52839c954")
    simdExpect((a.interleaveHigh(b)).bytes(), "ffffffff00000080000000007671d1c1")
    simdExpect((i32x4Shuffle(a, b, 0, 5, 5, 3)).bytes(), "55499a6b2839c9542839c95400000000")
    simdExpect(a.asI8x16().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asI16x8().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asI64x2().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asU8x16().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asU16x8().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asU32x4().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asU64x2().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asF32x4().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(a.asF64x2().bytes(), "55499a6b94b5d4d5ffffffff00000000")
    simdExpect(i32x4Load("xx" + a.bytes() + "yy", 2).bytes(), "55499a6b94b5d4d5ffffffff00000000")
}

@noinline fun simdCheckI64x2(): void {
    val a = i64x2(1, 2637784057069723399)
