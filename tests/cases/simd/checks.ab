    simdExpect((a.max(b)).bytes(), "0300000000000000075fd4d39f4a9b24")
    simdExpect((a.abs()).bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect((a & b).bytes(), "0100000000000000064a141386009320")
    simdExpect((a | b).bytes(), "0300000000000000777ff7f3bf4edbf7")
    simdExpect((a ^ b).bytes(), "02000000000000007135e3e0394e48d7")
    simdExpect((~a).bytes(), "fefffffffffffffff8a02b2c60b564db")
    simdExpect((a.andNot(b)).bytes(), "00000000000000000115c0c0194a0804")
    simdExpect((a.addSat(b)).bytes(), "04000000000000007dc90b07464f6e18")
    simdExpect((a.subSat(b)).bytes(), "feffffffffffffff91f49ca0f945c830")
    simdExpect((a << 3).bytes(), "080000000000000038f8a29efe54da24")
    simdExpect((a >> 3).bytes(), "0000000000000000e08b7afa53699304")
    simdExpect((a << 64).bytes(), "00000000000000000000000000000000")
    simdExpect((a >> 69).bytes(), "00000000000000000000000000000000")
    simdExpect((a.rotl(3)).bytes(), "080000000000000039f8a29efe54da24")
    simdExpect((a.rotr(5)).bytes(), "0000000000000008f8a29efe54da2439")
    simdExpect(a.toF64x2().bytes(), "000000000000f03f30eae94fa54dc243")
    simdExpect(a.eq(b).bytes(), "00000000000000000000000000000000")
    simdExpect(a.ne(b).bytes(), "ffffffffffffffffffffffffffffffff")
    simdExpect(a.lt(b).bytes(), "ffffffffffffffff0000000000000000")
    simdExpect(a.le(b).bytes(), "ffffffffffffffff0000000000000000")
    simdExpect(a.gt(b).bytes(), "0000000000000000ffffffffffffffff")
    simdExpect(a.ge(b).bytes(), "0000000000000000ffffffffffffffff")
    simdExpect((a.lt(b).select(a, b)).bytes(), "0100000000000000766a3733a604d3f3")
    simdTrue(a.lt(b).bitmask() == 1)
    simdTrue(a.lt(b).any() == true)
    simdTrue(a.lt(b).all() == false)
    simdTrue(a.sum() == 2637784057069723400)
    simdExpect((a.reverse()).bytes(), "075fd4d39f4a9b240100000000000000")
    simdExpect((a.interleaveLow(b)).bytes(), "01000000000000000300000000000000")
    simdExpect((a.interleaveHigh(b)).bytes(), "075fd4d39f4a9b24766a3733a604d3f3")
    simdExpect((i64x2Shuffle(a, b, 0, 3)).bytes(), "0100000000000000766a3733a604d3f3")
    simdExpect(a.asI8x16().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asI16x8().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asI32x4().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asU8x16().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asU16x8().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asU32x4().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asU64x2().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asF32x4().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(a.asF64x2().bytes(), "0100000000000000075fd4d39f4a9b24")
    simdExpect(i64x2Load("xx" + a.bytes() + "yy", 2).bytes(), "0100000000000000075fd4d39f4a9b24")
}

