    simdExpect((a + b).bytes(), "04000000000000007dc90b07464f6e18")
    simdExpect((a - b).bytes(), "feffffffffffffff91f49ca0f945c830")
    simdExpect((a * b).bytes(), "03000000000000003ab3bd627a1ffbb0")
    simdExpect((-a).bytes(), "fffffffffffffffff9a02b2c60b564db")
