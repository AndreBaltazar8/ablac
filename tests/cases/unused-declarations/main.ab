// tools/test-unused-declarations.sh: `neverCalled` (a function), `neverRead` (a value), `onlyItself` (called only by itself) and
// `hidden` (private) are never used (four warnings; in a project that declares a package, only `hidden`); the others are: called, read, named by a function value, a value whose initializer runs for
// its effect, `_`-prefixed, `main`, and `namedElsewhere`, which only other.ab (another file of the project) names.
import "abla/io"

fun neverCalled(): int = 1

private fun hidden(): int = 9

val neverRead: int = 2

fun onlyItself(n: int): int = if (n <= 0) 0 else onlyItself(n - 1)

fun helper(): int = 3

val limit: int = 4

fun viaValue(): int = 5

fun noteStart(): int = 6

val started: int = noteStart()

fun _spare(): int = 7

fun namedElsewhere(): int = 8

fun main: int {
    val function = viaValue
    println("${helper() + limit + function()}")
    0
}
