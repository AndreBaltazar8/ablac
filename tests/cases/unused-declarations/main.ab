// tools/test-unused-declarations.sh: `neverCalled` (a function), `neverRead` (a value), `onlyItself` (called only by itself), `hidden`
// (private), `NeverBuilt` (a class), `NeverImplemented` (an interface) and, in `Counter`, the field `label` and the method `spare` are never
// used (eight warnings; in a project that declares a package, only `hidden`). The others are: types built or implemented, called, read, named by a
// function value, a value whose initializer runs for its effect, an interface's method, `_`-prefixed, `main`, and `namedElsewhere`, which only
// other.ab (another file of the project) names.
import "abla/io"

class NeverBuilt(val value: int)

interface NeverImplemented

interface Shape

class Square(val side: int) : Shape

interface Counted {
    fun count(): int
}

class Counter(val start: int, val label: string, var total: int) : Counted {
    fun count(): int = start + total
    fun add(amount: int): int {
        total = total + amount
        total
    }
    fun spare(): int = 0
}

fun neverCalled(): int = 1

private fun hidden(): int = 9

val neverRead: int = 2

fun onlyItself(n: int): int = if (n <= 0) 0 else onlyItself(n - 1)

fun helper(): int = 3

val limit: int = 4

fun viaValue(): int = 5

fun noteStart(): int = 6

val started: int = noteStart()

fun _spare(): int = 7

fun namedElsewhere(): int = 8

fun main: int {
    val function = viaValue
    println("${helper() + limit + function() + Square(2).side + Counter(1, "c", 0).add(1)}")
    0
}
