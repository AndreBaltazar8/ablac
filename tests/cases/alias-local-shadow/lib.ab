// A block-local `val x` shadows the module's `x` only to the end of its block.
val x = 1
var counter = 10

fun after(): int {
    var t = 0
    for (i in 0 until 3) {
        val x = i + 5
        t = t + x
    }
    return t + x
}

fun nested(): int {
    var t = 0
    if (t == 0) {
        val x = 100
        t = x
    }
    val text = "${x}"
    return t + x + text.size
}

fun whole(x: int): int = x + counter

fun forVariable(): int {
    var t = 0
    for (x in 0 until 3) {
        t = t + x
    }
    return t + x
}
