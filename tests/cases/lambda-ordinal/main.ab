import "abla/io"
import "other.ab"

// Lambdas in globals' initializers (one nested in another), a method and a
// function: each is numbered within its owner, so a function added in
// other.ab, lowered before these, renames none of them.
val first: (int) -> int = { x: int -> x + 1 }
val pair: (int) -> (int) -> int = { x: int -> { y: int -> y * 10 + x } }
val scale: (int) -> int = { x: int -> x * 3 }

class Box(val k: int) {
    fun run(): int { val h = { x: int -> x + this.k }; return h(2) }
}

fun main(): int {
    val local = { x: int -> x - 1 }
    println("${first(1)} ${pair(4)(3)} ${scale(2)} ${Box(5).run()} ${local(10)} ${otherValue()}")
    42
}
