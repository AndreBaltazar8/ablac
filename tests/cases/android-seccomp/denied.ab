import "abla/build"
import "abla/sys/linux"

// The control of tools/test-android-seccomp.sh: a library that issues setuid(0), which Android's app policy blocks (SECCOMP_BLOCKLIST_APP.TXT:
// the process would end with SIGSYS). The check must name setuid (the optimizer inlines the function into the export).
trusted fun dropPrivileges(): int = linuxSyscall1(105, 0)

val exported = #exportFunction("dropPrivileges", "abla_app_answer")
