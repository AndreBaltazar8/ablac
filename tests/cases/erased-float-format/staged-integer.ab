import "abla/wasm/build"
// A staged program that erases no float: the preloaded formatter's own
// modules must not ask for it, so it is left out of the build.
val built = #wasmBuildModule("erased-float-nested-integer", "tests/cases/erased-float-format/nested-target.ab", "build/erased-float-format/nested-integer.wasm", false, false)
fun show(value: any): string = "$value"
fun main: int = if (built && show(7) == "7") 0 else 1
