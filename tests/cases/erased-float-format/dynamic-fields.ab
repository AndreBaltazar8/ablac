import "abla/runtime/scalar"
class Holder(val value: f32, val values: array<f64>)
var Holder.extra: f64 = 0.0
fun show(value: any): string = "$value"
fun symbol(name: string): int {
    var hash = 181
    for (index in 0 until name.size) {
        hash = hash * 281 + name[index] + 1
        hash = hash - (hash / 1000000007) * 1000000007
    }
    if (hash < 0) 0 - hash else hash
}
fun main: int {
    val holder = Holder(f32(1.25), [2.5])
    holder.extra = 3.75
    if (show(__ablaRuntimeFieldGet(holder, symbol("value"))) != "1.25") return 1
    if (show(__ablaRuntimeFieldGet(holder, symbol("extra"))) != "3.75") return 2
    val array = __ablaRuntimeFieldGet(holder, symbol("values"))
    if (show(__ablaRuntimeIndexGet(array, 0)) != "2.5") return 3
    0
}
