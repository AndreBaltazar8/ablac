import "abla/float"
import "abla/float/text"
fun show(value: any): string = "$value"
@export("check")
fun main: int {
    val x = f64FromBits(4607182418800017409)
    val y = f32FromBits(u32(1066192077))
    if (show(x) != "$x") return 1
    if (show(y) != "$y") return 2
    if (show(f64FromBits(1)) != "${f64FromBits(1)}") return 3
    val smallest = f32FromBits(u32(1))
    val inf = f32FromBits(u32(2139095040))
    val nan = f32FromBits(u32(2143289344))
    if (show(smallest) != "$smallest" || show(inf) != "$inf" || show(nan) != "$nan") return 4
    0
}
