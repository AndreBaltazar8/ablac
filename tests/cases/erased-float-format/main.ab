import "abla/float"
type Temperature = f64
fun show(value: any): string = "$value"
fun <T> box(value: T): any = value
class Holder(val value: any)
@export("check")
fun main: int {
    if (show(1.5) != "1.5") return 1
    if (show(f32(1.25)) != "1.25") return 2
    if (show(42) != "42" || show(true) != "true" || show(null) != "null") return 3
    if (show(f64FromBits(-9223372036854775808)) != "0") return 4
    if (show(f64FromBits(9218868437227405312)) != "Infinity") return 5
    if (show(f64FromBits(-4503599627370496)) != "-Infinity") return 6
    if (show(f64FromBits(9221120237041090560)) != "NaN") return 7
    if (show(f64FromBits(1)) != "5e-324") return 8
    if (show(box<f64>(2.25)) != "2.25" || show(box<int>(9)) != "9") return 9
    val holder = Holder(3.5)
    if (show(holder.value) != "3.5") return 10
    val values: array<any> = [4.5, 8, f32(2.5)]
    if (show(values[0]) != "4.5" || show(values[1]) != "8" || show(values[2]) != "2.5") return 11
    val map: Map<string, any> = Map()
    map.set("key", 5.5)
    if (show(map.get("key")) != "5.5") return 12
    val choice: any = if (true) 6.5 else 8
    if (show(choice) != "6.5") return 13
    // A void-typed join can still carry a boxed float on one branch.
    val maybe: any = if (true) 1.5 else { }
    if (show(maybe) != "1.5") return 15
    if (show(Temperature(7.5)) != "7.5") return 14
    0
}
