import "abla/io"
import "abla/json"
import "abla/html"

fun main {
    val count = 2
    val document = $json {"answer": 42}
    val view = $html <div>{count + 1}</div>
    val encoded = #$jsons {"enabled": true}
    println("answer ${document.getInt("answer")}, tag ${view.tag}")
    println(encoded)
}
// output:
// answer 42, tag div
// {"enabled":true}
