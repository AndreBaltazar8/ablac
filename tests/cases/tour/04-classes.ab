import "abla/io"

interface Shape {
    fun area(): int
}

class Rectangle(val width: int, val height: int) : Shape {
    fun area(): int = width * height
}

fun describe(shape: Shape): string = "area ${shape.area()}"

fun main {
    val rectangle = Rectangle(3, 4)
    println(describe(rectangle))
}
// output:
// area 12
