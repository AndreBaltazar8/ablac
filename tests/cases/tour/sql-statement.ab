import "abla/io"
import "abla/sql"
import "abla/text"

fun main {
    val author = "O'Neil"
    val query = $sql("SELECT id FROM books WHERE author = ${author}::text")
    println("has placeholder: ${query.text.contains("\$1::text")}")
    println("bound author: ${query.parameters[0].value}")
}
// output:
// has placeholder: true
// bound author: O'Neil
