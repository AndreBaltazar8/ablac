import "abla/io"

fun main {
    val numbers = [2, 3]
    numbers.append(5)
    var sum = 0
    for (n in numbers) sum += n
    val counts: Map<string, int> = Map()
    counts.set("sum", sum)
    println("${numbers.size} items, sum ${counts.get("sum") ?? 0}")
    println("absent ${counts.get("absent") ?? -1}")
    for (i in 0 until numbers.size) {
        val n = numbers[i]
        println("[$i] $n")
    }
}
// output:
// 3 items, sum 10
// absent -1
// [0] 2
// [1] 3
// [2] 5
