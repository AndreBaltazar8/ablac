import "abla/io"

fun main {
    val numbers = [2, 3]
    numbers.append(5)
    var sum = 0
    for (n in numbers) sum += n
    val counts: Map<string, int> = Map()
    counts.set("sum", sum)
    println("${numbers.size} items, sum ${counts.get("sum") ?? 0}")
    println("absent ${counts.get("absent") ?? -1}")
}
// output:
// 3 items, sum 10
// absent -1
