import "abla/io"

fun check(name: string, ok: bool): bool {
    println("checking $name")
    ok
}

fun main {
    var ready = true
    ready &&= check("disk", true)
    ready &&= check("network", false)
    ready &&= check("printer", true)
    var warned = false
    warned ||= !ready
    println("ready $ready, warned $warned")
}
// output:
// checking disk
// checking network
// ready false, warned true
