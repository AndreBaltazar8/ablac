import "abla/io"

resource class Ticket(val number: int) {
    fun drop(): void {
        println("closed $number")
        return
    }
}

fun inspect(ticket: Ticket): int = ticket.number
fun consume(own ticket: Ticket): void {
    println("consumed ${ticket.number}")
    return
}

fun main {
    val ticket = Ticket(7)
    println("borrowed ${inspect(ticket)}")
    consume(move(ticket))
    println("done")
}
// output:
// borrowed 7
// consumed 7
// closed 7
// done
