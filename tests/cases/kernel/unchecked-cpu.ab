// The CPU backend checks the unchecked fast path anyway (#143): a trusted kernel that reads one element past its buffer
// stops the program there instead of reading the memory after it.
import "abla/kernel"
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

@kernel
trusted fun shiftLeft(x: KernelF32Buffer, out: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) out.store(i, x.loadUnchecked(i + 1))
}

trusted fun main: int {
    val n = 8
    val memory = nativeByteBuffer(n * 4)
    val x = KernelF32Buffer(nativePointerAddress(memory.address), n)
    val out = KernelF32Buffer(nativePointerAddress(memory.address), n)
    kernelRunCpu(1, n) { shiftLeft(x, out, n - 1) }
    println("unchecked-cpu: in bounds ran")
    kernelRunCpu(1, n) { shiftLeft(x, out, n) }
    println("unchecked-cpu: past the end ran (wrong)")
    0
}
