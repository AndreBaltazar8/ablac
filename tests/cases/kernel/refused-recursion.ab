// A kernel may not call itself, directly or through another function: kernel.recursion.
import "abla/kernel"

fun depth(n: int): int = if (n <= 0) 0 else depth(n - 1) + 1

@kernel
fun deep(out: KernelU32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) out.store(i, depth(i))
}

fun main {}
