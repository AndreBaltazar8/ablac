// A device and device memory come from cudaKernelDevice() and CudaKernelDevice.allocate() only (#1139 area 13): code that is not trusted
// cannot build one by hand, which would point the driver calls and a kernel's buffers at an address of its choosing.
import "abla/kernel/cuda"
import "abla/io"

fun main {
    val device = CudaKernelDevice(0, 0, "")
    val memory = CudaKernelMemory(device, 4096, 1000000000)
    val everything = memory.raw()
    println("${everything.count}")
}
