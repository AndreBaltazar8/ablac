// Device memory is a device address: host code may not load from it (CudaKernelMemory.floats() is a CudaKernelF32View,
// which has no load or store), however it got the memory.
import "abla/kernel"
import "abla/kernel/cuda"

fun main {
    var device = cudaKernelDevice()
    val memory = device.allocate(64)
    if (memory != null) {
        val view = memory.floats()
        val first = view.load(0)
    }
}
