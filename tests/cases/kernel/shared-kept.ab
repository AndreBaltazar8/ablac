// #1139 K1 (f0's probe): kernels keep their dynamic shared memory's buffers past the launch, one in a module var and one
// in an array the launch's closure captured (from a second, bigger launch, so the memory grew), then the program allocates
// arrays and writes through both. The CPU backend's dynamic shared memory is never freed, so the writes land in memory of
// its own: no live array changes.
import "abla/kernel"
import "abla/io"
import "abla/float"

var kept: array<KernelU32Buffer> = []

fun grab(): void {
    kept.append(kernelSharedU32Dynamic())
}

fun main {
    kernelRunCpuShared(1, 1, 256) { grab() }
    // And one kept in an array the launch's closure captured, from a launch with more memory.
    val captured: array<KernelF32Buffer> = []
    kernelRunCpuShared(1, 1, 4096) { captured.append(kernelSharedF32Dynamic()) }
    val holders: array<array<int>> = []
    for (round in 0 until 64) {
        val words: array<int> = []
        for (k in 0 until 24) words.append(7)
        holders.append(words)
    }
    val buffer = kept[0]
    println("kept buffers: ${buffer.size()} and ${captured[0].size()} words")
    for (k in 0 until buffer.size()) buffer.store(k, 1094795585)
    val floats = captured[0]
    for (k in 0 until floats.size()) floats.store(k, f32(-3.5))
    var changed = 0
    for (words in holders) for (w in words) if (w != 7) changed = changed + 1
    println("words changed in live arrays: $changed")
    println("read back: ${buffer.load(0)}")
}
