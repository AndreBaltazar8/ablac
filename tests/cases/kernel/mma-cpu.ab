// kernelMmaF16 on the CPU backend (#1304): its subgroup is one thread, so a tensor-core product stops the program and says
// why instead of giving a wrong fragment.
import "abla/kernel"
import "abla/simd"
import "abla/io"

@kernel
fun tile(out: KernelF32Buffer) {
    val sums = kernelMmaF16(u32x4(u32(15360), u32(15360), u32(15360), u32(15360)), u32x2(u32(15360), u32(15360)),
        f32x4(f32(0.0), f32(0.0), f32(0.0), f32(0.0)))
    out.store(kernelGlobalId(), sums.get(0))
}

trusted fun main: int {
    kernelRunCpu(1, 1) { tile(KernelF32Buffer(0, 0)) }
    println("mma-cpu: no stop")
    0
}
