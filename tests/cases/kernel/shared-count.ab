// A group's shared memory on the CPU backend takes 0 to 2^20 elements (#1139 area 13): a count that wraps when multiplied by the element
// size (2^62 + 1 times 4 is 4 bytes) used to give a buffer that claimed 2^62 + 1 elements over 4 bytes, so a store far past it landed in
// whatever memory was there. Exits 0 after printing "shared-count: ok" when the sizes in range work; the huge count must stop the program.
import "abla/kernel"
import "abla/io"

fun main: int {
    val small = kernelSharedF32(16)
    small.store(15, f32(2.0))
    small.store(16, f32(3.0))
    if (small.load(15) != f32(2.0) || small.load(16) != f32(0.0)) return 1
    val none = kernelSharedU32(0)
    if (none.size() != 0) return 2
    println("shared-count: in range ok")
    val huge = kernelSharedF32(4611686018427387905)
    println("shared-count: a count of 2^62 + 1 was accepted (${huge.size()})")
    huge.store(1000000, f32(1.0))
    0
}
