// The one-load u32x4 forms are for trusted kernels only (#1301, #143, #1226): a kernel that is not trusted is refused.
import "abla/kernel"
import "abla/simd"

@kernel
fun copy(x: KernelU8Buffer, out: KernelU32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) out.storeU32x4(i * 4, x.loadU32x4Aligned(i * 16))
}

fun main {}
