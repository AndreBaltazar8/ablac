// The CPU backend's launch state is private to abla/kernel (#1139 area 13): kernelShared hands out its shared-memory slots as buffers,
// so a program that could write a slot's address could read and write any address through the buffer it gets back. Must not build.
import "abla/kernel"
import "abla/io"

fun main: int {
    kernelCpuState.sharedNext = 0
    kernelCpuState.sharedAddresses.append(1094795584)
    kernelCpuState.sharedBytes.append(4194304)
    val buffer = kernelSharedU32(1000)
    buffer.store(0, 7)
    println("refused-cpu-state: wrote through a slot of its choosing")
    0
}
