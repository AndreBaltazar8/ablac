// A buffer's and a device view's address is for trusted code only: code that is not trusted may not read it.
import "abla/kernel"
import "abla/kernel/cuda"
import "abla/io"

fun main {
    var device = cudaKernelDevice()
    val memory = device.allocate(64)
    if (memory != null) println("${memory.floats().address}")
    kernelRunCpu(1, 1) {
        val shared = kernelSharedF32(4)
        println("${shared.address}")
    }
}
