// The PTX of decimal f64 literals in a kernel, read by tools/test-kernels.sh (no GPU needed): 2048.0 and 0.1 must appear
// as their f64 bits, 0d40A0000000000000 and 0d3FB999999999999A. The kernel lowering once gave every decimal literal the
// bits 0, so the multiply by 2048.0 folded away and 0.1 was 0.
import "abla/kernel"
import "abla/float"
import "abla/io"

@kernel
fun literalPtx(y: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) y.store(i, f64ToF32(f64FromInt(n - i) * 2048.0 + f64FromInt(i) * 0.1))
}

fun main: int {
    print(kernelPtx())
    0
}
