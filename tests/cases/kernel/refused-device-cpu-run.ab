// Nor may the CPU backend run a kernel on device memory: a device view is no KernelF32Buffer.
import "abla/kernel"
import "abla/kernel/cuda"

@kernel
fun double(x: KernelF32Buffer, n: int) {
    val i = kernelGlobalId()
    if (i < n) x.store(i, x.load(i) * f32(2.0))
}

fun main {
    var device = cudaKernelDevice()
    val memory = device.allocate(64)
    if (memory != null) {
        val view = memory.floats()
        kernelRunCpu(1, 16) { double(view, 16) }
    }
}
