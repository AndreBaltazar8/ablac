// A KernelArray index the compiler cannot make constant (a loop not unrolled) would leave registers: refused (#1299).
import "abla/kernel"

@kernel
fun sums(x: KernelF32Buffer, n: int) {
    val acc = KernelArray<f32>(4)
    for (k in 0 until 4) acc.set(k, x.load(k))
    x.store(0, acc.get(n))
}

fun main {}
