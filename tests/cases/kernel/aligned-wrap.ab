// The CPU backend's check of the trusted one-load forms stops an index near 2^63 with its panic (64's review): with
// `index + n` the bound wrapped negative, and a buffer starting where `address + index` comes out aligned let the load
// through to a non-canonical address. The argument names the load; each case's buffer offset makes that address aligned.
import "abla/kernel"
import "abla/io"
import "abla/float"
import "abla/process"
import "abla/simd"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun main: int {
    val memory = nativeByteBuffer(128)
    // A 16-byte-aligned base inside the buffer.
    val start = nativePointerAddress(memory.address)
    val base = start + (16 - start % 16) % 16
    val top = 9223372036854775807
    val which = if (processArgumentCount() > 0) processArgument(0) else ""
    var got = 0
    // index * 4 + base + 8 = base + 2^65 - 8 + 8 (mod 2^64): aligned.
    if (which == "load4Aligned") got = int(f32ToBits(KernelF32Buffer(base + 8, 16).load4Aligned(top - 1).get(0)))
    if (which == "loadU32x4Aligned-words") got = int(KernelU32Buffer(base + 8, 16).loadU32x4Aligned(top - 1).get(0))
    // base + 1 + 2^63 - 1, base + 3 + 2^63 - 3, base + 8 + 2^63 - 8: aligned.
    if (which == "loadU16Aligned") got = KernelU8Buffer(base + 1, 64).loadU16Aligned(top)
    if (which == "loadU32Aligned") got = KernelU8Buffer(base + 3, 64).loadU32Aligned(top - 2)
    if (which == "loadU32x4Aligned") got = int(KernelU8Buffer(base + 8, 64).loadU32x4Aligned(top - 7).get(0))
    println("aligned-wrap: $which returned $got (wrong)")
    0
}
