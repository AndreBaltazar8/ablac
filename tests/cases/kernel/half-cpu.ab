// abla/kernel's half-precision conversions on the CPU backend (#1302) against CUDA C on an RTX 4090: the integer versions
// give the device's bits on every input of the fixed set (../kernel-cuda/src/half.ab), each section's hash the one
// tools/probe-kernel-half.cu printed there.
import "../kernel-cuda/src/half.ab"
import "abla/io"

/** The section hashes of CUDA C's __float2bfloat16_rn, __float2half_rn, __float2int_rn, __nv_cvt_float2_to_fp8x2,
 *  __nv_cvt_fp8x2_to_halfraw2 and __hfma2 on the set (sm_89, driver 580.95). */
val HALF_CUDA = "f 279596 b6865045 e 65536 e48995a5 h 272792 f200108e bf16 exact true"

fun main: int {
    val inputs = halfInputs()
    val results = halfResults(inputs)
    halfRunCpu(inputs, results)
    val summary = halfSummary(inputs, results)
    println("half-cpu: $summary")
    println("half-cpu: CUDA C's bits on the CPU ${summary == HALF_CUDA}")
    if (summary == HALF_CUDA) 0 else 1
}
