import "abla/wasm/build"

val release = #wasmBuildModule(
    "collection",
    "tests/cases/collection-edges/module.ab",
    "build/collection-edges/collection.wasm",
    false,
    false
)
val development = #buildProgram(
    "collection-dev",
    "tests/cases/collection-edges/module.ab",
    "build/collection-edges/collection-dev.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && development) 0 else 1
