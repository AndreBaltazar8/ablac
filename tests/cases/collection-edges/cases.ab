// Table-driven collection and control-flow edge cases: array truncate/takeAt/clear/append at the boundaries, nested and nullable
// elements, maps with many deletes and re-inserts (order, take, int and string keys, null values), nullable chains and
// ??, when over sealed types, ints, strings and bools, closures capturing loop variables, nested loops with break and
// continue, empty ranges, compound assignment. `defer` assigning a captured local is left out until the interpreter
// handles it (reported to ablac-9e). tools/test-collection-edges.sh runs them as ordinary code and under `#`.
import "abla/io"
import "abla/array"

@noinline fun idI(x: int): int = x
@noinline fun idS(x: string): string = x

class Point(var x: int, var y: int)
class Box(val label: string, var items: array<int>)
sealed interface Shape
class Circle(val r: int): Shape
class Rect(val w: int, val h: int): Shape
class Empty(): Shape
fun compose(f: (int) -> int, g: (int) -> int): (int) -> int = { x -> g(f(x)) }
class Counter(var n: int) {
    fun bump(): int {
        n = n + 1
        return n
    }
}
fun earlyReturn(limit: int): int {
    for (i in 0 until 100) {
        if (i * i > limit) return i
    }
    return -1
}

fun showI(xs: array<int>): string {
    var out = "["
    for (x in xs) out = out + "${x} "
    out + "]"
}
fun showS(xs: array<string>): string {
    var out = "["
    for (x in xs) out = out + "${x}, "
    out + "]"
}
fun showN(xs: array<int?>): string {
    var out = "["
    for (x in xs) out = out + (if (x == null) "null " else "${x} ")
    out + "]"
}
fun sn(v: int?): string = if (v == null) "null" else "${v}"
fun ss(v: string?): string = if (v == null) "null" else v

fun arrays(): array<string> {
    val out: array<string> = []
    val a = [idI(1), 2, 3, 4, 5]
    a.truncate(idI(5))
    out.append("truncate-size ${showI(a)}")
    a.truncate(idI(10))
    out.append("truncate-over ${showI(a)}")
    a.truncate(idI(0))
    out.append("truncate-0 ${showI(a)} ${a.size}")
    a.append(idI(9))
    out.append("append-after-truncate ${showI(a)}")
    val b = [idI(1), 2, 3]
    out.append("takeAt-mid ${b.takeAt(idI(1))} ${showI(b)}")
    out.append("takeAt-first ${b.takeAt(idI(0))} ${showI(b)}")
    out.append("takeAt-last ${b.takeAt(idI(0))} ${showI(b)} ${b.size}")
    val c = [idI(1), 2, 3, 4]
    out.append("removeLast ${c.removeLast()} ${c.removeAt(idI(1))} ${showI(c)}")
    val d: array<int> = []
    d.clear()
    out.append("clear-empty ${d.size}")
    d.append(idI(1))
    d.clear()
    d.append(idI(2))
    out.append("clear-append ${showI(d)}")
    // copies and aliasing: arrays are values with identity? assignment aliases
    val e = [idI(1), 2]
    e.append(3)
    out.append("append ${showI(e)} ${e.size}")
    val g = [idI(1), 2, 3]
    g[idI(0)] = 100
    out.append("set ${showI(g)} ${g[0]}")
    // nested arrays
    val grid: array<array<int>> = [[idI(1), 2], [3], []]
    grid.append([idI(5)])
    out.append("nested ${showI(grid[0])} ${showI(grid[1])} ${showI(grid[2])} ${showI(grid[3])} ${grid.size}")
    val rows = filledArray(idI(3), 0)
    rows[idI(1)] = 5
    out.append("filled ${showI(rows)}")
    val none = filledArray(idI(0), 7)
    out.append("filled-0 ${none.size}")
    // nullable elements
    val n: array<int?> = [idI(1), null, idI(3)]
    n.append(null)
    out.append("nullable ${showN(n)} ${n.size}")
    n[idI(1)] = idI(2)
    n[idI(0)] = null
    out.append("nullable-set ${showN(n)}")
    // arrays of strings and classes
    val s = [idS("b"), "a"]
    s.append(idS(""))
    out.append("strings ${showS(s)} ${s[2].size}")
    val ps: array<Point> = [Point(idI(1), 2), Point(3, 4)]
    ps[0].x = idI(10)
    out.append("class-elems ${ps[0].x} ${ps[0].y} ${ps[1].x}")
    // iteration with modification of the iterated variable
    var total = 0
    val it = [idI(1), 2, 3]
    for (x in it) total = total + x
    out.append("sum ${total}")
    var count = 0
    val growing = [idI(1), 2]
    for (x in growing) {
        count = count + 1
        if (count < 3) growing.append(x * 10)
    }
    out.append("iterate-while-append ${count} ${showI(growing)}")
    // large growth and reads
    val big: array<int> = []
    var i = 0
    while (i < idI(1000)) {
        big.append(i * i)
        i = i + 1
    }
    out.append("big ${big.size} ${big[0]} ${big[999]} ${big[500]}")
    big.truncate(idI(10))
    big.append(idI(-1))
    out.append("big-trunc ${showI(big)}")
    // index with computed expressions
    val k = [idI(10), 20, 30]
    out.append("index-expr ${k[idI(2) - idI(1)]} ${k[k.size - 1]} ${k[(idI(7) % 3)]}")
    // array of arrays sharing
    // equality is identity or value?
    val x1 = [idI(1), 2]
    val x2 = [idI(1), 2]
    out.append("eq ${x1 == x2} ${x1 == x1}")
    return out
}

fun maps(): array<string> {
    val out: array<string> = []
    val m: Map<string, int> = Map()
    for (i in 0 until idI(50)) m.set("k${i}", i)
    for (i in 0 until idI(50)) if (i % 2 == 0) m.remove("k${i}")
    out.append("half ${m.size} ${m.has("k0")} ${m.has("k1")} ${sn(m.get("k49"))}")
    for (i in 0 until idI(50)) if (i % 2 == 0) m.set("k${i}", i * 100)
    out.append("readd ${m.size} ${sn(m.get("k0"))} ${sn(m.get("k48"))}")
    val keys = m.keys()
    out.append("order-after-readd ${keys[0]} ${keys[1]} ${keys[24]} ${keys[25]} ${keys[49]} ${keys.size}")
    val values = m.values()
    out.append("values ${values[0]} ${values[1]} ${values[25]} ${values.size}")
    m.clear()
    out.append("cleared ${m.size} ${m.has("k1")} ${m.keys().size}")
    m.set("a", idI(1))
    out.append("after-clear ${m.size} ${sn(m.get("a"))} ${showS(m.keys())}")
    // same key set twice: size 1, order stays
    val t: Map<string, int> = Map()
    t.set("x", idI(1))
    t.set("y", idI(2))
    t.set("x", idI(3))
    out.append("same-key ${t.size} ${showS(t.keys())} ${sn(t.get("x"))}")
    // remove missing, remove then re-add moves to the end
    out.append("remove-missing ${t.remove("zz")} ${t.remove("x")} ${t.remove("x")}")
    t.set("x", idI(4))
    out.append("moved-to-end ${showS(t.keys())}")
    // take
    val u: Map<string, int> = Map()
    u.set("p", idI(7))
    out.append("take ${sn(u.take("p"))} ${sn(u.take("p"))} ${u.size}")
    // int keys: negative, zero, large, collisions
    val n: Map<int, string> = Map()
    for (k in [idI(0), -1, 1, idI(-9223372036854775807 - 1), idI(9223372036854775807), 64, 128, 192, 256, -64]) n.set(k, "v${k}")
    out.append("int-keys ${n.size} ${ss(n.get(0))} ${ss(n.get(-1))} ${ss(n.get(idI(-9223372036854775807 - 1)))} ${ss(n.get(idI(9223372036854775807)))} ${ss(n.get(256))} ${ss(n.get(-64))} ${ss(n.get(65))}")
    n.remove(idI(0))
    n.remove(idI(64))
    out.append("int-remove ${n.size} ${ss(n.get(0))} ${ss(n.get(128))} ${ss(n.get(192))}")
    // growth past rehash thresholds with deletes interleaved
    val g: Map<int, int> = Map()
    var sum = 0
    for (i in 0 until idI(2000)) {
        g.set(i, i)
        if (i % 3 == 0) g.remove(i - 1)
    }
    for (k in g.keys()) sum = sum + k
    out.append("grow ${g.size} ${sum} ${sn(g.get(1999))} ${sn(g.get(1998))}")
    // map of arrays, map of classes: shared values
    val ma: Map<string, array<int>> = Map()
    ma.set("a", [idI(1)])
    val got = ma.get("a")
    if (got != null) got.append(2)
    out.append("map-array ${showI(ma.get("a") ?? [])}")
    val mp: Map<string, Point> = Map()
    mp.set("p", Point(idI(1), 2))
    val gp = mp.get("p")
    if (gp != null) gp.x = 99
    out.append("map-class ${(mp.get("p") ?? Point(0, 0)).x}")
    // null values
    val mn: Map<string, int?> = Map()
    mn.set("n", null)
    mn.set("v", idI(1))
    out.append("map-null ${mn.size} ${mn.has("n")} ${mn.has("z")} ${showS(mn.keys())}")
    // empty string key, unicode key
    val e: Map<string, int> = Map()
    e.set("", idI(1))
    e.set("é", idI(2))
    e.set("é", idI(3))
    out.append("keys-special ${e.size} ${sn(e.get(""))} ${sn(e.get("é"))} ${sn(e.get("é"))}")
    return out
}

fun nullables(): array<string> {
    val out: array<string> = []
    val none: Point? = null
    val some: Point? = Point(idI(3), 4)
    out.append("chain ${sn(none?.x)} ${sn(some?.x)} ${none?.x ?? -1} ${some?.y ?? -1}")
    val nested: Box? = Box("b", [idI(1), 2])
    val empty: Box? = null
    out.append("chain2 ${sn(nested?.items.size)} ${sn(empty?.items.size)}")
    val chain: array<int>? = null
    out.append("array-null ${if (chain == null) -1 else chain.size}")
    val s: string? = null
    val t: string? = idS("héllo")
    out.append("string-null ${s?.size ?? -1} ${t?.size ?? -1} ${ss(s)} ${ss(t)}")
    val a: int? = null
    val b: int? = null
    val c: int? = idI(5)
    out.append("coalesce ${a ?? b ?? 7} ${a ?? c ?? 7} ${c ?? a ?? 7} ${(a ?? 1) + (c ?? 1)}")
    out.append("eq ${a == b} ${a == c} ${c == idI(5)} ${a != c} ${c != idI(6)}")
    var count = 0
    val items: array<int?> = [idI(1), null, idI(3), null]
    for (x in items) if (x != null) count = count + x else count = count + 100
    out.append("loop ${count}")
    val m: Map<string, int> = Map()
    m.set("a", idI(0))
    out.append("zero-is-not-null ${m.get("a") != null} ${m.get("b") == null} ${m.get("a") ?? 5}")
    val z: int? = idI(0)
    out.append("zero ${z ?? 9} ${z == null}")
    val f: bool? = false
    out.append("false ${f ?? true} ${f == null}")
    val e: string? = idS("")
    out.append("empty-string ${e ?? "x"} ${(e ?? "x").size}")
    return out
}

fun describe(s: Shape): string = when (s) {
    is Circle -> "circle ${s.r}"
    is Rect -> "rect ${s.w}x${s.h}"
    is Empty -> "empty"
}
fun classify(n: int): string =
    if (n < 0) "neg" else if (n == 0) "zero" else if (n < 10) "small" else if (n < 100) "mid" else "big"
fun byValue(n: int): string = when (n) {
    0 -> "zero"
    1, 2 -> "one-or-two"
    -1 -> "minus-one"
    else -> "other"
}
fun byString(s: string): string = when (s) {
    "" -> "empty"
    "a", "b" -> "ab"
    "é" -> "e-acute"
    else -> "other"
}
fun byBool(b: bool): string = when (b) {
    true -> "yes"
    false -> "no"
}

fun whens(): array<string> {
    val out: array<string> = []
    val shapes: array<Shape> = [Circle(idI(1)), Rect(2, idI(3)), Empty()]
    var text = ""
    for (s in shapes) text = text + describe(s) + ";"
    out.append("sealed ${text}")
    out.append("guards ${classify(idI(-5))} ${classify(idI(0))} ${classify(idI(9))} ${classify(idI(10))} ${classify(idI(99))} ${classify(idI(100))}")
    out.append("int ${byValue(idI(0))} ${byValue(idI(1))} ${byValue(idI(2))} ${byValue(idI(-1))} ${byValue(idI(3))}")
    out.append("string ${byString(idS(""))} ${byString(idS("a"))} ${byString(idS("b"))} ${byString(idS("é"))} ${byString(idS("c"))}")
    out.append("bool ${byBool(idI(1) == 1)} ${byBool(idI(1) == 2)}")
    val v = if (idI(1) == 2) 10 else if (idI(2) == 2) 20 else 30
    out.append("first-match ${v}")
    val counter = Counter(0)
    val w = when (idI(2)) {
        1 -> counter.bump()
        2 -> counter.bump() + counter.bump()
        else -> counter.bump()
    }
    out.append("only-one-branch ${w} ${counter.n}")
    return out
}

fun closures(): array<string> {
    val out: array<string> = []
    val fs: array<() -> int> = []
    for (i in 0 until idI(3)) fs.append({ i * 10 })
    out.append("loop-capture ${fs[0]()} ${fs[1]()} ${fs[2]()}")
    var counter = idI(0)
    val inc = { counter = counter + 1 }
    inc()
    inc()
    out.append("mutate-captured ${counter}")
    val c1 = Counter(idI(10))
    val c2 = Counter(idI(20))
    out.append("independent ${c1.bump()} ${c1.bump()} ${c2.bump()} ${c1.bump()}")
    val adders: array<(int) -> int> = []
    for (k in [idI(1), 2, 3]) adders.append({ x -> x + k })
    out.append("adders ${adders[0](10)} ${adders[1](10)} ${adders[2](10)}")
    var total = 0
    val each = { x: int -> total = total + x }
    for (x in [idI(1), 2, 3]) each(x)
    out.append("each ${total}")
    val h = compose({ x -> x + 1 }, { x -> x * 2 })
    out.append("compose ${h(idI(3))} ${h(idI(0))}")
    var captured = idI(1)
    val peek = { captured }
    captured = idI(2)
    out.append("late-binding ${peek()}")
    return out
}

fun flow(): array<string> {
    val out: array<string> = []
    var log = ""
    for (i in 0 until idI(4)) {
        for (j in 0 until idI(4)) {
            if (j == 1) continue
            if (j == 3) break
            if (i == 2) break
            log = log + "${i}${j} "
        }
    }
    out.append("nested-break ${log}")
    var n = idI(0)
    while (true) {
        n = n + 1
        if (n % 2 == 0) continue
        if (n > 7) break
    }
    out.append("while-true ${n}")
    out.append("early-return ${earlyReturn(idI(50))} ${earlyReturn(idI(1000000))} ${earlyReturn(idI(-1))}")
    var sum = 0
    for (i in idI(5) until idI(5)) sum = sum + 1
    for (i in idI(5) until idI(3)) sum = sum + 10
    for (i in idI(-2) until idI(2)) sum = sum + 100
    out.append("empty-ranges ${sum}")
    var u = 0
    var i = idI(10)
    do {
        u = u + 1
        i = i + 1
    } while (i < 5)
    out.append("do-while ${u}")
    val r = if (idI(1) == 1) { val t = 5; t * 2 } else 0
    out.append("if-expr-block ${r}")
    var x = idI(0)
    x += 5
    x -= 2
    x *= 3
    x /= 2
    x %= 3
    out.append("compound ${x}")
    return out
}

fun cases(): array<string> {
    val out: array<string> = []
    for (l in arrays()) out.append(l)
    for (l in maps()) out.append(l)
    for (l in nullables()) out.append(l)
    for (l in whens()) out.append(l)
    for (l in closures()) out.append(l)
    for (l in flow()) out.append(l)
    return out
}

