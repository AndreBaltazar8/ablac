// One checksum per case line, so the same table can be compared natively and as WebAssembly (which has no stdout).
import "cases.ab"

fun lineChecksum(i: int): int {
    val lines = cases()
    var h = 1469598103934665603
    for (b in lines[i]) h = (h ^ b) * 1099511628211
    h
}
fun lineCount(): int = cases().size
