// The evaluator's table of kinds that decide their own case (eval.ab, BOOTSTRAP_EVAL_KIND_FORMS) gives, for each kind in it, what the chain of tests gives.
import "abla/io"
import "../../../src/eval.ab"

fun main: int {
    val differs = bootstrapEvalCaseTableAgrees()
    if (differs != "") {
        println("eval case: the table and the chain differ for `$differs`")
        return 1
    }
    println("eval case: the table agrees with the chain")
    0
}
