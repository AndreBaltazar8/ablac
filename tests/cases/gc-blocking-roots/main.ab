// Thread A evaluates `verify(buildStrings(), buildObject(), <a blocking call>)` over and over: the strings and the object are expression
// temporaries, live while A is parked in the blocking call, and thread B collects meanwhile (#1139 area 10, #1279 follow-up). Ordinary code, no
// trusted block; what A holds must be there when the call returns. Blocking calls: a sleep and an await of a thread that sleeps.
import "abla/io"
import "abla/memory"
import "abla/process/time"
import "abla/text"

class Held(val name: string, val values: array<int>)

fun expected(index: int): string = "held-$index-${"abc".repeat(40)}"

fun buildStrings(): array<string> {
    val strings: array<string> = []
    for (index in 0 until 32) strings.append(expected(index))
    strings
}

fun buildObject(): Held = Held("object-${"x".repeat(100)}", [1, 2, 3, 4, 5, 6, 7, 8])

/** The number of held values that are not what was built. */
fun verify(strings: array<string>, object: Held, slept: bool): int {
    var wrong = if (slept) 0 else 1
    for (index in 0 until 32) if (strings[index] != expected(index)) wrong = wrong + 1
    if (object.name != "object-${"x".repeat(100)}" || object.values[7] != 8) wrong = wrong + 1
    wrong
}

fun sleeper(): bool = sleepNanoseconds(1000000)

fun waiter(): int {
    var wrong = 0
    for (round in 0 until 400) {
        wrong = wrong + verify(buildStrings(), buildObject(), sleepNanoseconds(2000000))
    }
    for (round in 0 until 200) {
        val other = thread { sleeper() }
        wrong = wrong + verify(buildStrings(), buildObject(), await other)
    }
    wrong
}

fun main: int {
    val a = thread { waiter() }
    var kept = 0
    var round = 0
    while (round < 2000) {
        val garbage = "x".repeat(300000)
        kept = kept + garbage.size % 7
        round = round + 1
    }
    val wrong = await a
    if (wrong != 0) {
        println("FAIL: the held values were wrong $wrong times")
        return 1
    }
    println("gc blocking roots ok")
    0
}
