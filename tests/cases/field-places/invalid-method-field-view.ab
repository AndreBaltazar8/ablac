// A view of an element of `items` (by name, in a method) can't be used after
// the field is replaced, as with a local array.
class Counter(var value: int)

class Box(var items: array<Counter>) {
    fun peek(): int {
        val view = items[0]
        items = [Counter(2)]
        view.value
    }
}

fun main: int = Box([Counter(1)]).peek()
