// A field read by name in a method is the place `this.field`: a resource
// field's members are read through it and assigning it drops the old value,
// compound assignment changes it, and a view of an element of a field's array
// is fine while nothing changes the field. The drops print in order.
import "abla/io"

resource class Ticket(val seat: int) {
    fun drop(): void {
        println("drop $seat")
        return
    }
}

class Booking(var ticket: Ticket, var changes: int) {
    fun swap(seat: int): int {
        val old = ticket.seat
        ticket = Ticket(seat)
        changes += 1
        old
    }
}

class Counter(var value: int)

class Box(var items: array<Counter>) {
    fun firstValue(): int {
        val view = items[0]
        view.value
    }
    fun grow(): int {
        items.append(Counter(items.size + 1))
        items.size
    }
}

fun main: int {
    val booking = Booking(Ticket(1), 0)
    val old = booking.swap(2)
    val box = Box([Counter(40)])
    val first = box.firstValue()
    val size = box.grow()
    println("$old ${booking.ticket.seat} ${booking.changes} $first $size")
    first + size
}
