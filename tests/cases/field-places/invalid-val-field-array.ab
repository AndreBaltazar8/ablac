// A `val` field still holds a mutable array: changing an element while a
// view of it is used is a conflict.
class Counter(var value: int)

class Box(val items: array<Counter>)

fun main: int {
    val box = Box([Counter(1)])
    val view = box.items[0]
    box.items[0] = Counter(5)
    view.value
}
