// The same conflict in code run at compile time is reported the same way.
class Counter(var value: int)

class Box(var items: array<Counter>) {
    fun peek(): int {
        val view = items[0]
        items.clear()
        view.value
    }
}

compile fun peeked(): int = Box([Counter(1)]).peek()

fun main: int = #peeked()
