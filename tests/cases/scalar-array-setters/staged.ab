import "abla/float"

fun stagedScalarStores(): int {
    val numbers = [1, 2]
    numbers[0] = 17
    numbers[1] += 8
    val flags = [false]
    flags[0] = true
    val wide: array<f64> = [0.0]
    wide[0] = 2.5
    val narrow: array<f32> = [0.0]
    narrow[0] = 0.25
    if (numbers[0] + numbers[1] == 27 && flags[0] &&
        wide[0] == 2.5 && narrow[0] == 0.25) 42 else 1
}

val result = #stagedScalarStores()
fun main: int = result
