import "abla/io"
import "abla/compiler"
import "abla/compiler/parser"

// A compile-only function cannot accidentally be called at runtime. Returning
// a nested class/array exercises the same freezing rules as a written # site.
class FrozenSyntaxValue(val values: array<int>, val text: string)
compile fun makeSyntaxValue(value: int = 7): FrozenSyntaxValue = FrozenSyntaxValue([value, 11],
    "frozen")

compile fun parseFrozenSyntax(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    syntaxCompile(expression)
}
#compilerRegisterSubparser("frozenSyntax", parseFrozenSyntax)

compile fun parseFrozenConstant(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val origin = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    val number = if (syntaxText(origin) == "1") 7 else 19
    syntaxCompile(syntaxCall("makeSyntaxValue", [syntaxInteger(number)]), origin)
}
#compilerRegisterSubparser("frozenConstant", parseFrozenConstant)

@syntaxCompileProbe(7)
fun syntaxCompileOrigin(): int = 0

// Unlike a parser callback, a # call can execute through native shims. Keep
// the opaque syntax handles inside compile time and freeze only their kind.
compile fun nativeSyntaxCompileProbe(): string {
    val function = compilerFindFunction("syntaxCompileOrigin")
    val origin = compilerFunctionAnnotationArgument(function, 0, 0)
    syntaxKind(syntaxCompile(syntaxInteger(42), origin))
}

fun main {
    val value = $frozenSyntax(makeSyntaxValue())
    println("${value.values[0] + value.values[1]} ${value.text}")
    val number = $frozenSyntax(6 * 7)
    println("$number")
    val first = $frozenConstant(1)
    val second = $frozenConstant(2)
    println("${first.values[0]} ${second.values[0]}")
    val nativeKind = #nativeSyntaxCompileProbe()
    println(nativeKind)
}
