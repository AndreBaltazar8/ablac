import "abla/compiler/parser"
compile fun parseMissingOrigin(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    syntaxCompile(syntaxInteger(42))
}
#compilerRegisterSubparser("missingOrigin", parseMissingOrigin)
fun main { val value = $missingOrigin() }
