import "abla/archive/tar"
import "abla/bytes"
import "abla/fs"
import "abla/process/arguments"
import "abla/sys/linux"

resource class Source(val data: string, val piece: int, var pos: int = 0,
    val failAt: int = -1): TarSource {
    fun readChunk(maxBytes: int): TarInputChunk {
        if (this.failAt >= 0 && this.pos >= this.failAt) return TarInputChunk("", false, "source")
        var size = this.data.size - this.pos
        if (size > this.piece) size = this.piece
        if (size > maxBytes) size = maxBytes
        val part = this.data.slice(this.pos, this.pos + size)
        this.pos += size
        TarInputChunk(part, this.pos == this.data.size)
    }
}
fun check(data: string, piece: int, output: int): int {
    val limits = TarLimits(data.size + 1, 100, data.size + 1, data.size + 1)
    val old = tarRead(data, limits)
    val source = Source(data, piece)
    val stream = tarStream(limits)
    var count = 0
    while (true) {
        val result = stream.next(source)
        if (result.error != "") {
            if (result.error != old.error) {
                linuxWriteStandardError("stream ${result.error} memory ${old.error}\n")
                return 1
            }
            return 0
        }
        if (result.done) {
            if (old.error != "" || count != old.entries.size) return 2
            if (!stream.next(source).done) return 3
            return 0
        }
        if (old.error == "") {
            if (count >= old.entries.size) return 4
            val expected = old.entries[count]
            if (result.entry.path != expected.path || result.entry.rawPath != expected.rawPath ||
                result.entry.kind != expected.kind || result.entry.mode != expected.mode ||
                result.entry.size != expected.size) return 5
        }
        val buf = byteBuffer()
        while (true) {
            val part = stream.readData(source, output)
            if (part.error != "") {
                if (part.error != old.error) return 6
                return 0
            }
            if (part.data.size > output || part.data.size > 65536) return 7
            buf.appendText(part.data)
            if (part.done) break
            if (part.data.size == 0) return 8
        }
        if (old.error == "") {
            val expected = old.entries[count]
            if (buf.toText() != data.slice(expected.offset,
                expected.offset + expected.size)) return 9
        }
        count += 1
    }
}
fun main(): int {
    val data = Path(processArgument(0)).readText()
    if (processArgumentCount() > 1 && processArgument(1) == "mutate") {
        var i = 0
        while (i < 3000) {
            val pos = (i * 7919) % data.size
            val changed = data.slice(0, pos) + byteEncode(data[pos] ^ (1 << (i % 8))) +
                data.slice(pos + 1, data.size)
            if (check(changed, 37, 61) != 0) return 11
            val end = (i * 6151) % data.size
            if (check(data.slice(0, end), 53, 73) != 0) return 12
            i += 1
        }
        return 0
    }
    for (piece in [1, 2, 7, 511, 512, 4096, 65536]) {
        for (out in [1, 7, 513, 65536]) {
            val result = check(data, piece, out)
            if (result !=
                0) { linuxWriteStandardError("piece $piece out $out result $result\n"); return result }
        }
    }
    if (tarRead(data, TarLimits(data.size + 1, 100, data.size + 1, data.size + 1)).error != "") return 0
    val limitedSource = Source(data, 7)
    val limited = tarStream(TarLimits(data.size - 1, 100, data.size, data.size))
    while (true) {
        val item = limited.next(limitedSource)
        if (item.error != "") { if (item.error != "limit") return 13; break }
        if (item.done) return 14
        while (true) {
            val part = limited.readData(limitedSource, 17)
            if (part.error != "") { if (part.error != "limit") return 15; break }
            if (part.done) break
        }
        if (limited.error != "") break
    }
    val failing = Source(data, 7, 0, 40)
    if (tarStream(TarLimits(data.size, 100, data.size,
        data.size)).next(failing).error != "source") return 16
    0
}
