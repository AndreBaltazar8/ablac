import "abla/bytes"
import "abla/archive/tar"
import "abla/compression/gzip"
import "abla/fs"
import "abla/process/arguments"

resource class Packed(val data: string, var pos: int = 0): GzipSource {
    fun readChunk(maxBytes: int): GzipInputChunk {
        var size = this.data.size - this.pos
        if (size > 13) size = 13
        if (size > maxBytes) size = maxBytes
        val part = this.data.slice(this.pos, this.pos + size)
        this.pos += size
        GzipInputChunk(part, this.pos == this.data.size)
    }
}
resource class Inflated(val packed: Packed, val stream: GzipStream): TarSource {
    fun readChunk(maxBytes: int): TarInputChunk {
        val part = this.stream.read(this.packed, maxBytes)
        TarInputChunk(part.data, part.done, part.error)
    }
}
fun exercise(data: string, expected: string): int {
    val packed = Packed(data)
    val gzip = gzipStream(packed, data.size, 1000000)
    val source = Inflated(move(packed), move(gzip))
    val tar = tarStream(TarLimits(1000000, 100, 1000000, 1000000))
    var files = 0
    while (true) {
        val entry = tar.next(source)
        if (entry.error != "") return if (entry.error == expected) 0 else 1
        if (entry.done) return if (expected == "" && files == 2) 0 else 2
        if (entry.entry.kind == "file") files += 1
        while (true) {
            val part = tar.readData(source, 7)
            if (part.error != "") return if (part.error == expected) 0 else 3
            if (part.done) break
        }
    }
}
fun main(): int {
    val input = Path(processArgument(0)).readText()
    if (exercise(input, "") != 0) return 1
    val bad = input.slice(0, input.size - 8) + byteEncode(input[input.size - 8] ^ 1) +
        input.slice(input.size - 7, input.size)
    if (exercise(bad, "invalid") != 0) return 2
    0
}
