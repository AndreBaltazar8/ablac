import "abla/archive/tar"
import "abla/bytes"
import "abla/fs"
import "abla/process/arguments"
resource class Input(val data: string, var pos: int = 0, val bad: int = 0,
    val failAfter: int = -1): TarSource {
    fun readChunk(maxBytes: int): TarInputChunk {
        if (this.failAfter >= 0 && this.pos >= this.failAfter) return TarInputChunk("", false,
            "source")
        if (this.bad == 1) return TarInputChunk("", false)
        if (this.bad == 2) {
            val out = byteBuffer()
            var n = 0
            while (n <= maxBytes) { out.appendByteValue(0); n += 1 }
            return TarInputChunk(out.toText(), false)
        }
        var n = this.data.size - this.pos
        if (n > maxBytes) n = maxBytes
        val result = this.data.slice(this.pos, this.pos + n)
        this.pos += n
        TarInputChunk(result, this.pos == this.data.size)
    }
}
fun run(input: string, limits: TarLimits): string {
    val source = Input(input)
    val tar = tarStream(limits)
    while (true) {
        val next = tar.next(source)
        if (next.error != "") return next.error
        if (next.done) return ""
        while (true) {
            val data = tar.readData(source, 97)
            if (data.error != "") return data.error
            if (data.done) break
        }
    }
}
fun main(): int {
    val data = Path(processArgument(0)).readText()
    if (run(data, TarLimits(data.size, 2, 1027, 1037)) != "") return 1
    if (run(data, TarLimits(data.size - 1, 2, 1027, 1037)) != "limit") return 2
    if (run(data, TarLimits(data.size, 1, 1027, 1037)) != "limit") return 3
    if (run(data, TarLimits(data.size, 2, 1026, 1037)) != "limit") return 4
    if (run(data, TarLimits(data.size, 2, 1027, 1036)) != "limit") return 5
    for (kind in [1, 2]) {
        val source = Input(data, 0, kind)
        val tar = tarStream(TarLimits(data.size, 2, 1027, 1037))
        if (tar.next(source).error != "source") return 6
    }
    val source = Input(data)
    val tar = tarStream(TarLimits(data.size, 2, 1027, 1037))
    if (tar.next(source).error != "") return 7
    if (tar.next(source).error != "invalid") return 8
    val late = Input(data, failAfter = 513)
    val lateTar = tarStream(TarLimits(data.size, 2, 1027, 1037))
    if (lateTar.next(late).error != "") return 9
    val payload = lateTar.readData(late, 97)
    if (!payload.done || payload.data != "first file") return 10
    if (lateTar.next(late).error != "source" || lateTar.next(late).error != "source") return 11
    0
}
