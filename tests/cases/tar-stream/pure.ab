import "abla/archive/tar"
import "abla/bytes"
resource class EmptyArchive(var pos: int = 0): TarSource {
    fun readChunk(maxBytes: int): TarInputChunk {
        var count = 1024 - this.pos
        if (count > maxBytes) count = maxBytes
        val out = byteBuffer()
        var i = 0
        while (i < count) { out.appendByteValue(0); i += 1 }
        this.pos += count
        TarInputChunk(out.toText(), this.pos == 1024)
    }
}
@export("tarStreamCheck")
fun tarStreamCheck(): int {
    val source = EmptyArchive()
    val reader = tarStream(TarLimits(1024, 1, 100, 100))
    val result = reader.next(source)
    if (result.done && result.error == "") 42 else 1
}
fun main(): int = tarStreamCheck()
