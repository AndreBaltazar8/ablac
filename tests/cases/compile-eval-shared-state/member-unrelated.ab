// A member call on a class receiver reaches the one implementation the checker resolved:
// B.touch is native although A.touch, reached by another site, writes `shared`.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
class A(val n: int) {
    fun touch(): int { shared.append(1); return n }
}
class B(val n: int) {
    fun touch(): int = n
}
compile fun viaB(): int = B(5).touch()
compile fun viaA(): int = A(7).touch()
val X = #viaB()
val Y = #viaA()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
