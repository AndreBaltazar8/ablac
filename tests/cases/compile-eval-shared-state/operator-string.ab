// String `+` beside a class with a writing `plus(string)`: the concatenation is built-in and
// native, the Box's plus interprets.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
class Box(val n: int)
operator fun Box.plus(s: string): string { shared.append(1); return "${this.n}$s" }
compile fun builtin(): string = "a" + "b"
compile fun user(): string = Box(1) + "x"
val X = #builtin()
val Y = #user()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
