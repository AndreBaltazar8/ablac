import "abla/compiler"
import "abla/io"
class Counter(var count: int)
val shared = Counter(0)
compile fun mutate(): int { shared.count += 1; shared.count }
compile fun observe(): int = shared.count
compile fun interpreted(): int {
    val ignored = compilerFindFunction("observe")
    if (ignored < 0) compilerApplyTransform({})
    val before = shared.count
    shared.count += 1
    before
}
val A = #interpreted()
val B = #observe()
val C = #mutate()
val D = #observe()
val RESULT = "$A,$B,$C,$D"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
