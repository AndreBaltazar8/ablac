import "abla/compiler"
import "abla/io"
import "stdlib/abla/relay/entry.ab"
val shared: array<int> = []
class Probe(val n: int) : Visitor {
    fun visit(): int { shared.append(1); return this.n }
}
compile fun mutate(): int { val seen = relay(Probe(0)); shared.size + seen }
compile fun observe(): int = shared.size
compile fun interpreted(): int {
    val ignored = compilerFindFunction("observe")
    if (ignored < 0) compilerApplyTransform({})
    val before = shared.size
    relay(Probe(0))
    before
}
val A = #mutate()
val B = #observe()
val C = #interpreted()
val D = #observe()
val RESULT = "$A,$B,$C,$D"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
