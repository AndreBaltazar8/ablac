// One generic body whose member call resolves to A.touch in one instantiation and to
// B.touch in another: the facts conflict, every implementation stays a candidate, and both
// sites, which reach A.touch (it writes `shared`), run in the interpreter.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
interface Toucher { fun touch(): int }
class A(val n: int): Toucher {
    fun touch(): int { shared.append(1); return n }
}
class B(val n: int): Toucher {
    fun touch(): int = n
}
fun <T : Toucher> go(value: T): int = value.touch()
compile fun viaB(): int = go(B(5))
compile fun viaA(): int = go(A(7))
val X = #viaB()
val Y = #viaA()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
