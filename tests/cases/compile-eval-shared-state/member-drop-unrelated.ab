// A resource local is dropped at its scope's end, through its class's drop (#813). X has locals of ints and a string only,
// so in a Wasm slice it reaches no drop and is native although Guard.drop, which Y's local calls, writes `shared`.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
resource class Guard(val n: int) {
    fun drop(): void { shared.append(1) }
}
compile fun plain(): int {
    val a = 2
    val b = "x"
    return a + b.size + 2
}
fun scoped(): int {
    val g = Guard(1)
    return g.n + 1
}
compile fun guarded(): int = scoped()
val X = #plain()
val Y = #guarded()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
