// An extension operator on a scalar (`int.times(Vec)`) writes `shared`: `2 * 3` is still the
// built-in operator (native in a Wasm slice), `2 * Vec(3)` calls the user's and interprets.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
class Vec(val n: int)
operator fun int.times(v: Vec): Vec { shared.append(1); return Vec(this * v.n) }
compile fun builtin(): int = 2 * 3
compile fun user(): int = (2 * Vec(3)).n
val X = #builtin()
val Y = #user()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
