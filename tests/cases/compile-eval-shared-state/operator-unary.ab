// Unary minus on a user type with a writing unaryMinus interprets; `-3` stays native.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
class Box(val n: int)
operator fun Box.unaryMinus(): Box { shared.append(1); return Box(0 - this.n) }
compile fun builtin(): int = -3
compile fun user(): int = (-Box(4)).n
val X = #builtin()
val Y = #user()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
