// A built-in operator inside a generic instantiation (\`keep\`) is never narrowed: the int
// site interprets here too although its body adds only ints, and the user's plus (which
// writes) interprets. The same sum outside a generic (operator-builtin) is native.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
class Box(val n: int)
operator fun Box.plus(other: Box): Box { shared.append(1); return Box(this.n + other.n) }
fun <T> keep(value: T): int = 1 + 2
compile fun ints(): int = keep(5)
compile fun boxes(): int = (Box(1) + Box(2)).n
val X = #ints()
val Y = #boxes()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
