import "abla/compiler"
import "abla/io"
val shared: array<int> = []
fun appendOne(var target: array<int>): void { target.append(1) }
compile fun mutate(): int { appendOne(shared); shared.size }
compile fun observe(): int = shared.size
compile fun interpreted(): int {
    val ignored = compilerFindFunction("observe")
    if (ignored < 0) compilerApplyTransform({})
    val before = shared.size
    appendOne(shared)
    before
}
val A = #mutate()
val B = #observe()
val C = #interpreted()
val D = #observe()
val RESULT = "$A,$B,$C,$D"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
