import "abla/compiler"
import "abla/io"
class Cell(var current: Cell?, val value: int) {
    fun getValue(): int = value
    fun setValue(next: int): void {}
}
var counter by Cell(null, 0)
compile fun mutate(): int { ^counter = Cell(null, counter + 1); counter }
compile fun observe(): int = counter
compile fun interpreted(): int {
    val ignored = compilerFindFunction("observe")
    if (ignored < 0) compilerApplyTransform({})
    val before = counter
    ^counter = Cell(null, counter + 1)
    before
}
val A = #mutate()
val B = #observe()
val C = #interpreted()
val D = #observe()
val RESULT = "$A,$B,$C,$D"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
