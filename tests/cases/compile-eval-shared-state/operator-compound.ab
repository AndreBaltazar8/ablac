// `x += y` on a Box whose plus writes: the site interprets; `n += 1` on ints stays native.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
class Box(val n: int)
operator fun Box.plus(other: Box): Box { shared.append(1); return Box(this.n + other.n) }
compile fun ints(): int { var n = 2; n += 3; n }
compile fun boxes(): int { var b = Box(1); b += Box(2); b.n }
val X = #ints()
val Y = #boxes()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
