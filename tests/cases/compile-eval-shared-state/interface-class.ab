// A class that declares an interface (#813): the cross-target reach keeps the interface and proves it
// portable by its method signatures. In a Wasm slice X (a call of Plain.size, which writes nothing) is
// native although Writer, another class of the same interface, writes `shared` in its own `size`; Y calls
// that one and runs in the interpreter.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
interface Sized { fun size(): int }
class Plain(val n: int) : Sized { fun size(): int = n }
class Writer(val n: int) : Sized {
    fun size(): int {
        shared.append(1)
        return n
    }
}
compile fun sizePlain(): int = Plain(5).size()
compile fun sizeWriter(): int = Writer(2).size()
val X = #sizePlain()
val Y = #sizeWriter()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
