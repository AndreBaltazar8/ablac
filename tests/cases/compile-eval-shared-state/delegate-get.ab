import "abla/compiler"
import "abla/io"
var log: array<int> = []
class D(val n: int) {
    fun getValue(): int {
        log.append(1)
        n
    }
    fun setValue(next: int): void {}
}
val g by D(1)
compile fun a(): int = g
compile fun observe(): int = log.size
compile fun interpreted(): int {
    val ignored = compilerFindFunction("observe")
    if (ignored < 0) compilerApplyTransform({})
    log.size
}
val A = #a()
val B = #interpreted()
val C = #observe()
val RESULT = "$A,$B,$C"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
