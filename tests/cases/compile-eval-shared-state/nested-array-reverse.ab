import "abla/compiler"
import "abla/io"
val shared: array<array<int>> = [[]]
compile fun mutate(): int { shared[0].append(1); shared[0].size }
compile fun observe(): int = shared[0].size
compile fun interpreted(): int {
    val ignored = compilerFindFunction("observe")
    if (ignored < 0) compilerApplyTransform({})
    val before = shared[0].size
    shared[0].append(1)
    before
}
val A = #interpreted()
val B = #observe()
val C = #mutate()
val D = #observe()
val RESULT = "$A,$B,$C,$D"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
