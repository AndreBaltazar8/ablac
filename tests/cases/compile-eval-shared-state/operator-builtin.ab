// An operator on scalar operands is the built-in one: `2 + 3` calls no user function. In a
// Wasm slice X (the sum of ints) is native although Box.plus, reached by site Y, writes
// `shared`; Y calls the user operator and runs in the interpreter.
import "abla/compiler"
import "abla/io"

val shared: array<int> = []
class Box(val n: int)
operator fun Box.plus(other: Box): Box { shared.append(1); return Box(this.n + other.n) }
compile fun sumInts(): int = 2 + 3
compile fun sumBoxes(): int = (Box(1) + Box(2)).n
val X = #sumInts()
val Y = #sumBoxes()
val RESULT = "$X,$Y"
fun main: int { println(RESULT); 0 }
@export("resultSize")
fun resultSize(): int = RESULT.size
@export("resultByte")
fun resultByte(index: int): int = RESULT[index]
