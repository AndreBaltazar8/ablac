// The control: the site awaits its thread before it panics, so the stop is the ordinary E_CT_PANIC and the
// compiler goes on to report it.
import "abla/process"

fun work(seed: int): int {
    var total = 0
    var index = 0
    while (index < 1000) {
        total = total + "a$seed-$index".size
        index = index + 1
    }
    total
}

fun stopping(): int {
    val worker = thread { work(1) }
    val done = await worker
    if (done > 0) panic("stopped after its thread")
    done
}

val first = #stopping()

fun main: int = first
