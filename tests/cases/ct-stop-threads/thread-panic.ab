// A thread the native compile-time site started panics while the site awaits it (#831): its jump back to the
// compiler went to the compiler's own thread's stack from the wrong thread. The thread parks, the site's own thread
// stops, and the build ends with E_CT_STOPPED naming the panic.
import "abla/process"

fun failing(seed: int): int {
    var total = 0
    var index = 0
    while (index < 1000) {
        total = total + "t$seed-$index".size
        index = index + 1
    }
    if (total > 0) panic("a thread gave up")
    total
}

fun stopping(): int {
    val worker = thread { failing(1) }
    await worker
}

val first = #stopping()

fun main: int = first
