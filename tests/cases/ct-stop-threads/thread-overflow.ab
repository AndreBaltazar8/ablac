// A thread the native compile-time site started overflows its stack while the site awaits it (#831). With no
// signal stack of its own, its SIGSEGV ended the compiler; the thread now has one, so the fault reaches the
// site's stop: the thread parks, and the build ends with E_CT_STOPPED.
import "abla/process"

// Not a tail call, nor one LLVM can turn into a loop (`-` doesn't commute).
fun deep(n: int): int = if (n == 0) 0 else n - deep(n - 1)

fun stopping(): int {
    val worker = thread { deep(1000000000) }
    await worker
}

val first = #stopping()

fun main: int = first
