// A native compile-time site that panics while a thread it started still runs (#831): the compiler used to go on
// beside that thread and crash at random (SIGILL, SIGSEGV); it must end the build with E_CT_STOPPED instead.
import "abla/process"

fun busy(seed: int, limit: int): int {
    var total = 0
    var index = 0
    while (index < limit) {
        total = total + "b$seed-$index".size
        index = index + 1
    }
    total
}

fun stopping(): int {
    val worker = thread { busy(1, 200000000) }
    if (busy(0, 1000) > 0) panic("stopped while a thread runs")
    await worker
}

fun walk(depth: int): string = if (depth == 0) "" else walk(depth - 1) + "w$depth"

val first = #stopping()
val second = #walk(2000).size

fun main: int = first + second
