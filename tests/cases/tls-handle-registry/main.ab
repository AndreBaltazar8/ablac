// The hosted TLS handle calls refuse a handle this layer did not return: tlsControlInt gives -1, tlsControlPointer a null pointer, tlsCloseHandle false, and nothing is read
// from the address. A handle that was made and closed is refused too (tests/cases/tls-unix closes real ones). Prints "tls-handle-registry ok".
import "abla/io"
import "abla/tls/hosted"
import "abla/unsafe/memory/raw"

var failures = 0

fun check(what: string, ok: bool): void {
    if (ok) return
    failures = failures + 1
    println("FAIL $what")
}

fun main: int {
    for (handle in [-1, 0, 1, 8, 16, 4096, 65536, 1099511627776, 281474976710655]) {
        for (offset in [0, 8, 16, 24, 32, -8, 4]) {
            check("tlsControlInt($handle, $offset)", tlsControlInt(handle, offset) == -1)
            check("tlsControlPointer($handle, $offset)", pointerIsNull(tlsControlPointer(handle, offset)))
        }
        check("tlsCloseHandle($handle)", !tlsCloseHandle(handle))
    }
    // A listener that could not be made leaves no handle behind.
    check("a listener without credentials", tlsListenHandle("/no/such/certificate", "/no/such/key", "127.0.0.1", 0, 1, false) == -1)
    if (failures > 0) return 1
    println("tls-handle-registry ok")
    0
}
