// A program that has the hosted TLS (OpenSSL) and the Xtensa installer's HTTPS stream (on abla/tls/pure): they
// must coexist, and each side's TlsConnection must be its own. tools/test-tls-hosted-mix.sh builds this.
import "abla/tls/hosted"
import "abla/xtensa/companion/httpstream"
import "abla/fs/secure"
import "abla/process/arguments"

fun main(): int {
    if (!tlsAvailable()) return 1
    // Never taken (the suite passes no argument); it makes both TlsConnection classes reachable.
    if (processArgument(0) == "connect") {
        val hosted = tlsConnect("localhost", 1)
        val output = secureDirectory(processArgument(1)).createFile("response")
        val result = installerHttpsResponse("localhost", "/", output, 16, 100, 100, "", 1)
        return if (hosted.handle == -1 && result.error != "") 2 else 3
    }
    0
}
