// A program that has the hosted TLS (OpenSSL) and abla/websocket/tls: they must coexist. The module imports
// abla/tls/pure plainly, and its TlsConnection, TlsListener and tlsServerUpgrade still mean pure's (#830). tools/test-tls-hosted-mix.sh builds this.
import "abla/tls/hosted"
import "abla/websocket/tls"

fun main: int = if (tlsAvailable()) 0 else 1
