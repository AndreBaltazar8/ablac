// A program that has the hosted TLS (OpenSSL) and abla/http/tls: they must coexist. Each module that
// reaches abla/tls/pure for itself imports it under an alias, so the two TlsConnection, TlsListener and
// tlsServerUpgrade of the pair are not merged by name. tools/test-tls-hosted-mix.sh builds this.
import "abla/tls/hosted"
import "abla/http/tls"

fun main: int = if (tlsAvailable()) 0 else 1
