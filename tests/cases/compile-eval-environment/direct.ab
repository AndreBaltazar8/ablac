import "abla/compiler"
import "abla/crypto"
#compilerGrant("environment")
compile fun assetTable(): string = hexEncode(sha256(compilerEnvironment("ABLA_CT_ENV_TEST")))
val TABLE = #assetTable()

@export("tableSize")
fun tableSize(): int = TABLE.size
@export("tableByte")
fun tableByte(index: int): int = TABLE[index]
