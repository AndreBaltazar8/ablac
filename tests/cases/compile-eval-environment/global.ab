import "abla/compiler"
#compilerGrant("environment")
compile fun assetHost(): string = compilerEnvironment("ABLA_CT_ENV_TEST")
val ASSET_HOST = #assetHost()
// The direct helper is also visited from this body before the global argument.
// Its direct proof must not hide its second reach through ASSET_HOST's replay.
compile fun assetTable(host: string): string = "$host:${assetHost()}"
val TABLE = #assetTable(ASSET_HOST)

@export("tableSize")
fun tableSize(): int = TABLE.size
@export("tableByte")
fun tableByte(index: int): int = TABLE[index]
