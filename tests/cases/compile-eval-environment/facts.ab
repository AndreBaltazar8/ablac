import "../../../src/ct_jit.ab"
fun main: int {
    val root = bootstrapCompileProviderStandardLibrary()
    val source = "$root/abla/compiler/entry.ab"
    val expected = bootstrapParseWithIdentity(
        "compile extern:\"compiler\" fun compilerEnvironment(name: string): string", source)
    if (!bootstrapCtCrossEnvironment(expected.declarations[0])) return 1
    val fake = bootstrapParseWithIdentity(
        "compile extern:\"compiler\" fun compilerEnvironment(name: string): string", "fake.ab")
    if (bootstrapCtCrossEnvironment(fake.declarations[0])) return 2
    val wrong = bootstrapParseWithIdentity(
        "compile extern:\"compiler\" fun compilerEnvironment(name: int): string", source)
    if (bootstrapCtCrossEnvironment(wrong.declarations[0])) return 3
    val owned = bootstrapParseWithIdentity(
        "compile extern:\"compiler\" fun compilerEnvironment(own name: string): string", source)
    if (owned.errors != 0 || bootstrapCtCrossEnvironment(owned.declarations[0])) return 4
    42
}
