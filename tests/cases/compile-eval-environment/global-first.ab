import "abla/compiler"
#compilerGrant("environment")
compile fun assetHost(): string = compilerEnvironment("ABLA_CT_ENV_TEST")
val ASSET_HOST = #assetHost()
// Reverse worklist order: replayed access precedes the direct helper call.
val TABLE = #(assetHost() + ":" + ASSET_HOST)

@export("tableSize")
fun tableSize(): int = TABLE.size
@export("tableByte")
fun tableByte(index: int): int = TABLE[index]
