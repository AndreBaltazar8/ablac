// Table-driven regex edge cases: every refusal the docs list (backreferences, lookaround, other group forms, inline flags, unknown
// escapes, \\b in a class, nothing to repeat, stacked quantifiers, bad ranges and intervals, unterminated groups and classes,
// invalid UTF-8) with its message and offset, the limits at their boundaries (500 groups, 200 levels, repeat counts
// of 1000, 100000 instructions, regexCompileWithin), and what is accepted next to them. tools/test-regex-edges.sh.
import "abla/io"
import "abla/text"
import "abla/regex"

@noinline fun idS(x: string): string = x
@noinline fun idI(x: int): int = x

fun outcome(pattern: string): string {
    val r = regexCompile(idS(pattern))
    if (r.succeeded) "ok(${r.regex.groupCount})" else "err '${r.error.message}' @${r.error.offset}"
}
fun cut(pattern: string): string = if (pattern.size > 24) pattern.slice(0, 20) + "...(${pattern.size})" else pattern

fun cases(): array<string> {
    val out: array<string> = []
    val patterns = [
        "", "a", "()", "(?:)", "a|", "|a", "|", "a||b", "()()()", "(a)(b)(c)", "((a))", "(?:(a))",
        // documented refusals and nearby accepted patterns
        "(a)\\1", "\\1", "\\0", "\\01", "\\8", "\\k<a>", "(?=a)", "(?!a)", "(?<=a)", "(?<!a)", "(?<n>a)", "(?P<n>a)", "(?i)a", "(?i:a)", "(?s)a", "(?m)a", "(?x)a", "(?-i)a", "(?#c)", "(?>a)", "(?|a)", "(?", "(?:", "(?a)", "(",
        "\\q", "\\e", "\\a", "\\c", "\\g", "\\h", "\\i", "\\j", "\\l", "\\m", "\\o", "\\p{L}", "\\P{L}", "\\z", "\\Z", "\\A", "\\G", "\\R", "\\X", "\\Q", "\\E", "\\y", "\\Y", "\\C", "\\N", "\\H", "\\V", "\\K", "\\B", "\\b",
        "[\\b]", "[a\\b]", "[\\B]", "[[:alpha:]]", "[a-]", "[-a]", "[a-z-9]", "[\\w-z]", "[a-\\w]", "[\\d-9]", "[z-a]", "[a-a]", "[]", "[]a]", "[^]", "[^]a]", "[a", "[", "]", "a]", "[a-", "[\\", "[\\x4", "[\\u00e", "[é-ü]", "[😀-😂]", "[\\x00-\\x7f]", "[^\\n]", "[\\n-\\r]", "[\\s\\S]", "[\\d\\D]", "[^\\d\\D]",
        "*a", "+a", "?a", "{1}a", "^*", "$*", "\\b*", "(*a)", "a**", "a*+", "a+*", "a?*", "a??", "a*?", "a+?", "a{2}?", "a{2,3}?", "a{2}{3}", "a{2}*", "a**?", "a{3,2}", "a{,2}", "a{,}", "a{}", "a{1", "a{1,", "a{1,2", "a{a}", "a{1,a}", "a{-1}", "a{1,-1}", "{", "{1}", "a{", "a{,", "a{0}", "a{0,0}", "(a){0}", "a{1001}", "a{1000}", "a{0,1001}", "a{1000,1000}", "a{1001,}", "a{999,1000}", "a{ 1}", "a{1 }", "a{1, 2}",
        "(a", "a)", "(a))", "((a)", ")", "()", "(|)", "(()", "(?:a", "(?:a))",
        "\\x", "\\x4", "\\x41", "\\xg1", "\\xAg", "\\u", "\\u004", "\\u0041", "\\u00g1", "\\U00000041", "\\x{41}", "\\u{41}", "\\ud800", "\\udfff", "\\ufffe", "\\uffff", "\\u0000", "\\x00",
        "\\.", "\\-", "\\ ", "\\/", "\\\"", "\\'", "\\_", "\\é", "\\😀", "\\\n", "\\",
        "a\xff", "\xff", "(\xc3)", "[\xc3]", "a\xed\xa0\x80", "\xf4\x90\x80\x80", "\xc0\x80",
        "^", "$", "^$", "^^", "$$", "\\b\\b", "^*?", "^+", "$?", "(^)*", "(^|a)+", "(a|^)*", "()*", "(?:)*", "(a*)*", "(a*)+", "(a?)*", "(a|)*", "(|a)*", "(?:(?:(?:a*)*)*)*",
    ]
    for (p in patterns) out.append("${cut(p)} => ${outcome(p)}")
    return out
}

// The limits: compiling programs of up to 100000 instructions is too slow for the compile-time evaluator, so these run
// as ordinary code only.
fun limitCases(): array<string> {
    val out: array<string> = []
    var groups500 = ""
    for (i in 0 until idI(500)) groups500 = groups500 + "(a)"
    out.append("500 groups => ${outcome(groups500)}")
    out.append("501 groups => ${outcome(groups500 + "(a)")}")
    var nested = ""
    var closers = ""
    for (i in 0 until idI(200)) {
        nested = nested + "("
        closers = closers + ")"
    }
    out.append("200 nested => ${outcome(nested + "a" + closers)}")
    out.append("201 nested => ${outcome("(" + nested + "a" + closers + ")")}")
    var nc = ""
    var ncc = ""
    for (i in 0 until idI(200)) {
        nc = nc + "(?:"
        ncc = ncc + ")"
    }
    out.append("200 nested noncapturing => ${outcome(nc + "a" + ncc)}")
    out.append("201 nested noncapturing => ${outcome("(?:" + nc + "a" + ncc + ")")}")
    out.append("a{1000} => ${outcome("a{1000}")} a{1001} => ${outcome("a{1001}")}")
    out.append("(a{1000}){100} => ${outcome("(a{1000}){100}")}")
    out.append("(a{1000}){101} => ${outcome("(a{1000}){101}")}")
    out.append("(a{1000}){1000} => ${outcome("(a{1000}){1000}")}")
    out.append("((a{1000}){1000}){1000} => ${outcome("((a{1000}){1000}){1000}")}")
    out.append("(a{1,30}){1,30} => ${outcome("(a{1,30}){1,30}")}")
    out.append("(((a{10}){10}){10}){10} => ${outcome("(((a{10}){10}){10}){10}")}")
    out.append("(((a{10}){10}){10}){11} => ${outcome("(((a{10}){10}){10}){11}")}")
    // regexCompileWithin: the program sizes
    for (limit in [0, 1, 2, 5, 10, 100000, 100001, 1000000, -1]) {
        val r = regexCompileWithin(idS("a{50}"), limit)
        out.append("within ${limit} a{50} => ${if (r.succeeded) "ok" else "err '${r.error.message}'"}")
    }
    for (limit in [52, 53, 54, 55, 56]) {
        val r = regexCompileWithin(idS("a{50}"), limit)
        out.append("within ${limit} a{50} => ${if (r.succeeded) "ok" else "err"}")
    }
    return out
}

fun main: int {
    val live = cases()
    val staged = #cases()
    var bad = 0
    if (live.size != staged.size) {
        println("SIZES ${live.size} ${staged.size}")
        bad = 1
    }
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            println("DIFF ${i} live: ${live[i]} | staged: ${staged[i]}")
            bad = bad + 1
        }
    }
    for (line in live) println("LIVE ${line}")
    for (line in limitCases()) println("LIMIT ${line}")
    bad
}
