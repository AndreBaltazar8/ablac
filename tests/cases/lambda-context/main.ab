import "abla/io"
// A lambda's parameter types come from where it is stored: an array's or a
// map's element type (append, set, an index, a literal), a field, a variable.
class Button(var onClick: (int) -> int, var label: (string) -> string)
var handler: (int) -> int = { x -> x }
val table: array<(int) -> int> = [{ x -> x * 3 }]
fun staged(): int {
    val fs: array<(int) -> int> = []
    fs.append({ x -> x + 2 })
    var total = 0
    for (f in fs) total += f(1)
    total
}
fun main: int {
    val fs: array<(int) -> int> = [{ x -> x + 1 }, { y -> y * 2 }]
    fs.append({ x -> x + 10 })
    fs[0] = { z -> z - 1 }
    val m: Map<string, (string, int) -> string> = Map()
    m.set("rep", { s, n -> "$s$n" })
    val b = Button({ x -> x }, { s -> "<$s>" })
    b.onClick = { x -> x * 100 }
    b.label = { s -> "[$s]" }
    handler = { x -> x + 1000 }
    var total = 0
    for (f in fs) total += f(1)
    for (f in table) total += f(1)
    val r = m.get("rep")
    if (r != null) println(r("a", 3))
    val c = b.onClick
    val l = b.label
    val h = handler
    total += c(1)
    println("$total ${l("x")} ${h(1)} ${staged()} ${#staged()}")
    42
}
