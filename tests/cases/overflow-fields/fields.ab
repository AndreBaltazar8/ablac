// Fields added by name beyond a class's declared ones live in the instance's
// overflow: they survive collections while it grows, declared fields keep
// their inline slots (typed reads and writes after growth), a set replaces an
// existing value, and a field never set reads its default (null for now).
// Shared by the native program (main.ab) and the WebAssembly module
// (module.ab); returns how many checks failed.

class Point(var x: int, var y: int)

trusted fun extend(point: Point, symbol: int, value: any): void {
    __ablaRuntimeFieldSet(point, symbol, value)
    return
}

trusted fun extension(point: Point, symbol: int): any = __ablaRuntimeFieldGet(point, symbol)

trusted fun number(value: any): int = __ablaRuntimeAsI64(value)

trusted fun length(value: any): int = __ablaRuntimeStringLengthValue(value)

trusted fun isNull(value: any): bool = __ablaRuntimeTag(value) == 1

trusted fun overflowFailures(): int {
    var failures = 0
    val points: array<Point> = []
    for (n in 0 until 20) points.append(Point(n, n * 2))
    // Twelve rounds: each point's overflow grows from 2 slots to 4, 8 and 16
    // while strings are allocated (and dropped) around it.
    for (round in 0 until 12) {
        for (point in points) {
            extend(point, 900000 + round, __ablaRuntimeI64(point.x * 100 + round))
            extend(point, 910000 + round, "label-${point.x}-$round")
            val scratch = "scratch-${point.y}-$round"
            if (scratch.size == 0) failures = failures + 1
        }
    }
    for (point in points) {
        point.y = point.y + 1
        if (point.y != point.x * 2 + 1) failures = failures + 1
    }
    for (point in points) {
        for (round in 0 until 12) {
            if (number(extension(point, 900000 + round)) != point.x * 100 + round) failures = failures + 1
            if (length(extension(point, 910000 + round)) != "label-${point.x}-$round".size) failures = failures + 1
        }
    }
    extend(points[3], 900005, __ablaRuntimeI64(-1))
    if (number(extension(points[3], 900005)) != -1) failures = failures + 1
    if (number(extension(points[3], 900006)) != 306) failures = failures + 1
    if (!isNull(extension(points[0], 123))) failures = failures + 1
    if (points[7].x != 7 || points[7].y != 15) failures = failures + 1
    failures
}
