// An instance built at compile time with fields added by name: the lift
// carries its overflow (as `#<symbol>` fields) into the program, which reads
// them back by name. Run the compile-time code natively (ABLA_COMPILE_EVAL=jit):
// the interpreter doesn't run the runtime's raw memory.
import "abla/io"
import "abla/compiler"
#compilerGrant("trusted.native")

class Point(var x: int, var y: int)

trusted fun built(): Point {
    val point = Point(4, 5)
    for (index in 0 until 5) __ablaRuntimeFieldSet(point, 900000 + index, __ablaRuntimeI64(70 + index))
    __ablaRuntimeFieldSet(point, 900100, "lifted label")
    point
}

val atCompile = #built()

trusted fun main: int {
    var total = 0
    for (index in 0 until 5) total = total + __ablaRuntimeAsI64(__ablaRuntimeFieldGet(atCompile, 900000 + index))
    val label = __ablaRuntimeStringLengthValue(__ablaRuntimeFieldGet(atCompile, 900100))
    println("lifted ${atCompile.x} ${atCompile.y} $total $label")
    42
}
