// Garbage of one size after another under a small memory limit. What each size
// frees is parked on that size's free list, where the next size can't use it
// until a reclaim merges it, so with thresholds too high for the limit the heap
// keeps growing past it with its memory parked.
import "abla/memory"

var source: string = ""

@export("set_limit")
fun setLimit(bytes: int): int {
    var text = "0123456789abcdef"
    while (text.size < 65536) text = "$text$text"
    source = text
    memorySetLimit(memoryLiveBytes() + bytes)
    memoryLimit()
}

@export("live")
fun live(): int = memoryLiveBytes()

// The runtime's counters (memoryHeapStat): 5 collections, 7 reclaims, 9 parked bytes.
@export("stat")
fun stat(which: int): int = memoryHeapStat(which)

// `bytes` in all, as strings of `size`; returns the sum of their sizes.
@export("phase")
fun phase(size: int, bytes: int): int {
    var total = 0
    var made = 0
    while (made < bytes) {
        val copy = "${source.slice(0, size)}!"
        total = total + copy.size
        made = made + size
    }
    total
}
