// OPEN (tools/fuzz-differential, campaign of seeds 13-20, 2026-11-08): equality
// through `any` where the two operands are not the same kind of value. Native
// (--fast, release, JIT, Wasm) compares payload bits; the compile-time interpreter
// compares the kinds first, so it answers false for a float and the integer with
// its bits, and IEEE for 0.0 and -0.0. Each line prints "ok" when the run-time
// answer equals the compile-time one. Move this next to the other cases once the
// semantics of mixed kinds is decided and both sides follow it.
import "abla/io"
import "abla/float"

fun anyEq(a: any, b: any): bool = a == b
fun bit(flag: bool): string = if (flag) "1" else "0"

fun floatAndBits(): bool = anyEq(f64FromInt(1), 4607182418800017408)
fun f32AndInt(): bool = anyEq(f64ToF32(0.0), 0)
fun zeroes(): bool = anyEq(0.0, -0.0)
fun nanSelf(): bool = anyEq(f64FromBits(9221120237041090560), f64FromBits(9221120237041090560))
fun nanPayload(): bool = anyEq(f64FromBits(9221120237041090561), f64FromBits(9221120237041090561))

fun report(name: string, runtime: bool, compileTime: bool): void {
    println("$name=${if (runtime == compileTime) "ok" else "MISMATCH ${bit(runtime)} ${bit(compileTime)}"}")
}

@export("run")
fun run(): int {
    report("float-and-bits", floatAndBits(), #floatAndBits())
    report("f32-and-int", f32AndInt(), #f32AndInt())
    report("zeroes", zeroes(), #zeroes())
    report("nan-self", nanSelf(), #nanSelf())
    report("nan-payload", nanPayload(), #nanPayload())
    0
}

fun main: int = run()
