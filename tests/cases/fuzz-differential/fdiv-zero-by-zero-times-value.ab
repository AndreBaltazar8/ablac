// LLVM 23.1's InstCombine folded `0.0 / (0.0 * v)` to a signed zero, but the divisor is a zero, so the
// quotient is NaN (llvm-project #202482, fixed after 23.1.3, backported in nix/llvm-instcombine-fdiv-zero.patch).
// tools/fuzz found it (seed 100097): `0.0 / (((-0.0) * (-0.0)) * f64FromInt(v2))` printed nan unoptimised and
// 0 in every optimised mode. The case is NaN for every v, so every mode must agree on "ok".
import "abla/io"
import "abla/float"
import "abla/float/text"

fun quotient(v: int): f64 = 0.0 / (((-0.0) * (-0.0)) * f64FromInt(v))
@noinline fun scaled(v: int): f64 = 0.0 / (((-0.0) * (-0.0)) * f64FromInt(v)) * 0.16

fun check(name: string, value: f64): void {
    println("$name=${if (value != value) "ok" else "MISMATCH $value"}")
}

@export("run")
fun run(): int {
    check("quotient-zero", quotient(0))
    check("quotient-one", quotient(1))
    check("quotient-negative", quotient(-7))
    check("quotient-large", quotient(9007199254740993))
    check("scaled-zero", scaled(0))
    check("scaled-one", scaled(1))
    check("scaled-negative", scaled(-7))
    check("scaled-large", scaled(9007199254740993))
    0
}

fun main: int = run()
