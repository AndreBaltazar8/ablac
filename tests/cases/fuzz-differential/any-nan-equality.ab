// Found by tools/fuzz-differential (seed 14, c9). Equality through `any` compares
// the payload bits (docs/language.md, floating point), so a NaN equals itself:
// native --fast, native release, ct-jit and WebAssembly print 1. The
// compile-time interpreter (ABLA_COMPILE_EVAL=interp) evaluates `a == b` from the
// values' kinds alone, sees two f64 and applies IEEE equality: it prints 0.
import "abla/io"

fun anyEq(a: any, b: any): bool = a == b

@export("run")
fun run(): int {
    println("runtime=${if (anyEq(0.0 / 0.0, 0.0 / 0.0)) 1 else 0}")
    println("compile-time=${if (#anyEq(0.0 / 0.0, 0.0 / 0.0)) 1 else 0}")
    0
}

fun main: int = run()
