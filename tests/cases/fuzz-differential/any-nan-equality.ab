// Equality through `any` compares the payload bits (docs/language.md, floating
// point), at run time and under `#` alike. tools/fuzz-differential found the
// compile-time interpreter applying IEEE equality to two `any` NaNs (seed 14,
// check c9). Each case prints "ok" when the run-time answer equals the
// compile-time one, and the typed case checks IEEE equality is untouched.
import "abla/io"
import "abla/float"

val NAN = f64FromBits(9221120237041090560)

class Holder(val value: any)

fun anyEq(a: any, b: any): bool = a == b
fun bit(flag: bool): string = if (flag) "1" else "0"

fun viaParams(): bool = anyEq(NAN, NAN)
fun viaFields(): bool {
    val a = Holder(NAN)
    val b = Holder(NAN)
    a.value == b.value
}
fun viaArray(): bool {
    val xs: array<any> = [NAN, NAN]
    xs[0] == xs[1]
}
fun viaWhen(): bool {
    val a: any = NAN
    val pick = when (1) { 1 -> a; else -> a }
    pick == a
}
fun viaLocals(): bool {
    val a: any = NAN
    val b: any = NAN
    a == b
}
fun floatAndBits(): bool = anyEq(1.0, 4607182418800017408)
fun negativeF32AndBits(): bool = anyEq(f64ToF32(-1.5), 3217031168) == anyEq(f64ToF32(-1.5), 3217031168)
fun negativeF32AndSignedBits(): bool = anyEq(f64ToF32(-1.5), -1077936128)
fun zeroes(): bool = anyEq(0.0, -0.0)
fun typedNan(): bool = NAN == NAN

fun report(name: string, runtime: bool, compileTime: bool): void {
    println("$name=${if (runtime == compileTime) "ok" else "MISMATCH ${bit(runtime)} ${bit(compileTime)}"}")
}

@export("run")
fun run(): int {
    report("params", viaParams(), #viaParams())
    report("fields", viaFields(), #viaFields())
    report("array", viaArray(), #viaArray())
    report("when", viaWhen(), #viaWhen())
    report("locals", viaLocals(), #viaLocals())
    report("float-and-bits", floatAndBits(), #floatAndBits())
    report("f32-bits", negativeF32AndBits(), #negativeF32AndBits())
    report("f32-signed-bits", negativeF32AndSignedBits(), #negativeF32AndSignedBits())
    report("zeroes", zeroes(), #zeroes())
    report("typed-nan", typedNan(), #typedNan())
    println("typed-nan-is-ieee=${bit(!typedNan())}")
    0
}

fun main: int = run()
