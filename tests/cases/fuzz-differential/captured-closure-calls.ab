// A lambda that calls a lambda it captured, found by tools/fuzz-differential (the closure
// generator): under `#` the call of the captured name failed with E_EVAL_EXPRESSION
// "evaluating `call` `g`" while native and WebAssembly gave the answer. The evaluator boxes
// each captured binding in a slot and did not look through it for a callee. Each line
// prints "ok" when the run-time answer equals the compile-time one.
import "abla/io"

fun double(n: int): int = n * 2
fun compose(f: (int) -> int, g: (int) -> int): (int) -> int = { x: int -> g(f(x)) }
fun twice(f: (int) -> int): (int) -> int = { x: int -> f(f(x)) }

fun lambdaCallsCaptured(): int {
    val g = { n: int -> n + 1 }
    val h = { x: int -> g(x) }
    h(10)
}

fun composeReturned(): int {
    val h = compose(double, { n: int -> n + 1 })
    h(10)
}

fun parameterCapturedByReturned(): int {
    val h = twice(compose(double, { n: int -> n - 3 }))
    h(5)
}

fun threeLevels(): int {
    val g = { n: int -> n * 3 }
    val h = { x: int -> { y: int -> g(x) + g(y) } }
    h(2)(5)
}

fun mutatingCapture(): int {
    var total = 0
    val add = { n: int -> total = total + n }
    add(3)
    val addOnce = move { n: int -> add(n) }
    addOnce(4)
    total
}

fun report(name: string, runtime: int, compileTime: int): void {
    println("$name=${if (runtime == compileTime) "ok" else "MISMATCH $runtime $compileTime"}")
}

@export("run")
fun run(): int {
    report("lambda-calls-captured", lambdaCallsCaptured(), #lambdaCallsCaptured())
    report("compose-returned", composeReturned(), #composeReturned())
    report("parameter-captured", parameterCapturedByReturned(), #parameterCapturedByReturned())
    report("three-levels", threeLevels(), #threeLevels())
    report("mutating-capture", mutatingCapture(), #mutatingCapture())
    0
}

fun main: int = run()
