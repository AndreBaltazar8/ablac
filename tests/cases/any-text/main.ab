import "abla/html"
fun renderText(value: any): string = "$value"
fun through(value: any): string = renderText(value)
type Code = int
fun nullableNumber(value: int?): string = renderText(value)
fun nullableText(value: string?): string = renderText(value)
class Item(val number: int)
fun guarded(value: any, show: bool): string = if (show) "$value" else "hidden"
fun main: int {
    val page = $html <p>{42}</p>
    if (renderText(42) == "42" && renderText(true) == "true" &&
        renderText("hello") == "hello" && through(7) == "7" &&
        guarded(Item(1), false) == "hidden" && page.children[0].text == "42" &&
        nullableNumber(null) == "null" && nullableNumber(42) == "42" &&
        nullableText(null) == "null" && nullableText("ok") == "ok" &&
        renderText(Code(8)) == "8") 42 else 1
}
