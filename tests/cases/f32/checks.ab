// Every f32 form, as one function that returns the first check to fail, or 0.
// tools/test-f32.sh runs it natively, on Wasm and at compile time.
import "abla/float"
import "abla/float/text"
import "abla/math"

class Vec(var x: f32, val y: f32 = 0.5) {
    fun scaled(by: f32): f32 = this.x * by
}

val globalValue: f32 = 1.5
var globalCounter: f32 = 0.25
val globalTable: array<f32> = [1.0, -2.5]

fun half(value: f32): f32 = value / 2.0
fun fallback(value: f32 = 0.75): f32 = value
fun literal(): f32 = 0.125
fun early(flag: bool): f32 {
    if (flag) return 8.5
    -8.5
}
fun rows(): array<f32> {
    val made: array<f32> = []
    made
}

fun bits(value: f32): int = int(f32ToBits(value))

fun f32Checks(): int {
    // A declared type gives a literal its width.
    val a: f32 = 1.5
    if (bits(a) != 1069547520) return 1
    var b: f32 = 0.0
    b = 2.5
    if (bits(b) != 1075838976) return 2
    val negative: f32 = -1.5
    if (bits(negative) != 3217031168) return 3
    val folded: f32 = 1.0 / 4.0
    if (bits(folded) != 1048576000) return 4
    val chosen: f32 = if (a > b) 1.0 else 2.0
    if (bits(chosen) != 1073741824) return 5

    // The other operand gives it too, on either side.
    if (bits(a * 2.0) != 1077936128) return 10
    if (bits(2.0 * a) != 1077936128) return 11
    if (bits(a + 1.0 - 0.5) != 1073741824) return 12
    if (bits(1.0 + 2.0 * a) != 1082130432) return 13
    if (bits((1.0 + 3.0) * a) != 1086324736) return 14
    if (!(a < 2.0) || !(1.0 < a) || a == 2.0 || a != 1.5 || !(a >= 1.5)) return 15
    var accumulated: f32 = 1.0
    accumulated = accumulated * 3.0
    accumulated *= 2.0
    accumulated += 0.5
    if (bits(accumulated) != 1087373312) return 16

    // Arrays, fields, parameters, results, globals.
    val table: array<f32> = [1.0, 2.5]
    if (bits(table[1]) != 1075838976) return 20
    table[0] = 4.0
    table.append(0.5)
    if (bits(table[0]) != 1082130432 || bits(table[2]) != 1056964608) return 21
    val inferred = rows()
    inferred.append(6.5)
    inferred.append(-6.5)
    if (bits(inferred[1]) != 3234856960) return 22
    val vector = Vec(1.5)
    vector.x = 3.0
    if (bits(vector.x) != 1077936128 || bits(vector.y) != 1056964608) return 23
    if (bits(vector.scaled(2.0)) != 1086324736) return 24
    if (bits(half(3.0)) != 1069547520) return 25
    if (bits(half(value = 3.0)) != 1069547520) return 31
    if (bits(Vec(y = 2.5, x = 1.5).y) != 1075838976) return 32
    if (bits(fallback()) != 1061158912 || bits(literal()) != 1040187392) return 26
    if (bits(early(true)) != 1091043328 || bits(early(false)) != 3238526976) return 27
    if (bits(globalValue) != 1069547520 || bits(globalTable[1]) != 3223322624) return 28
    globalCounter = 0.5
    if (bits(globalCounter) != 1056964608) return 29
    val apply: (f32) -> f32 = half
    if (bits(apply(1.0)) != 1056964608) return 30

    // The nearest f32 of the digits themselves.
    val tenth: f32 = 0.1
    if (bits(tenth) != 1036831949) return 40
    val tie: f32 = 1.000000178813934326171875
    if (bits(tie) != 1065353218) return 41
    // An f64 rounds these two to the tie above, and would then round wrongly.
    val below: f32 = 1.00000017881393432617187499
    if (bits(below) != 1065353217) return 42
    val above: f32 = 1.00000005960464477539062501
    if (bits(above) != 1065353217) return 43
    val odd: f32 = 16777217.0
    if (bits(odd) != 1266679808) return 44
    val even: f32 = 16777219.0
    if (bits(even) != 1266679810) return 45
    val largest: f32 = 3.4028235e38
    if (bits(largest) != 2139095039) return 46
    val smallestNormal: f32 = 1.17549435e-38
    if (bits(smallestNormal) != 8388608) return 47
    val smallest: f32 = 1e-45
    if (bits(smallest) != 1) return 48
    val tooSmall: f32 = 1e-60
    if (bits(tooSmall) != 0) return 49
    val underscored: f32 = 1_000.5
    if (bits(underscored) != 1148854272) return 50
    val negativeZero: f32 = -0.0
    if (bits(negativeZero) != 2147483648) return 51
    // A literal with no f32 near it stays an f64.
    val plain = 0.1
    if (f64ToBits(plain) != 4591870180066957722) return 52

    // Integers.
    if (bits(f32FromInt(3)) != 1077936128 || bits(f32FromInt(-3)) != 3225419776) return 60
    if (bits(f32FromInt(16777217)) != 1266679808) return 61
    // Through an f64 this would land on the tie and round down.
    if (bits(f32FromInt(18014399583223809)) != 1518338049) return 62
    if (bits(f32FromInt(-18014399583223809)) != 3665821697) return 63
    if (f32ToInt(2.75) != 2 || f32ToInt(-2.75) != -2) return 64
    if (f32ToInt(1e30) != 9223372036854775807) return 65
    if (f32ToInt(-1e30) != -9223372036854775807 - 1) return 66
    val zero: f32 = 0.0
    if (f32ToInt(zero / zero) != 0) return 67

    // Text: an f32 is written as the f64 of the same value.
    val quarter: f32 = 2.25
    if ("$quarter" != "2.25" || "${tenth}" != "0.10000000149011612") return 70

    // abla/math, with literals among the arguments.
    if (bits(sqrt(a * a)) != 1069547520) return 80
    val two: f32 = 2.0
    if (bits(sqrt(two)) != 1068827891) return 81
    if (bits(floor(a)) != 1065353216 || bits(ceil(a)) != 1073741824) return 82
    if (bits(trunc(negative)) != 3212836864 || bits(fabs(negative)) != 1069547520) return 83
    if (bits(roundEven(a)) != 1073741824) return 84
    if (bits(fmin(a, 1.0)) != 1065353216 || bits(fmax(1.0, a)) != 1069547520) return 85
    if (bits(fclamp(a, 0.0, 1.0)) != 1065353216 || bits(fclamp(a, 2.0, 3.0)) != 1073741824) return 87
    if (bits(lerp(a, 2.5, 0.5)) != 1073741824) return 88
    if (bits(fma(a, 2.0, 1.0)) != 1082130432) return 89
    if (bits(pow(two, 10.0)) != 1149239296) return 90
    if (bits(hypot(a, 2.0)) != 1075838976) return 91
    if (bits(exp(zero)) != 1065353216 || bits(log(exp(zero))) != 0) return 92
    if (bits(sin(zero)) != 0 || bits(cos(zero)) != 1065353216 || bits(tan(zero)) != 0) return 93
    if (bits(atan(zero)) != 0 || bits(atan2(zero, a)) != 0) return 94
    if (isNaN(a) || !isNaN(zero / zero) || !isFinite(a)) return 95
    // The f64 functions and the integer ones are as they were.
    if (sqrt(16.0) != 4.0 || min(1, 2) != 1 || clamp(5, 0, 3) != 3) return 96
    if (lerp(0.0, 2.0, 0.5) != 1.0) return 97
    0
}
