// Compiled for Xtensa by tools/test-f32.sh where the shell's LLVM can: f32 in
// hardware registers, literals, conversions and the math overloads.
import "abla/float"
import "abla/math"

val scales: array<f32> = [0.5, 1.5]

@export("area")
fun area(radius: f32): f32 = radius * radius * 3.14159

@export("root")
fun root(value: f32): f32 = sqrt(value) + floor(value * 1.5) + lerp(value, 2.0, 0.25)

@export("whole")
fun whole(value: f32): int = f32ToInt(value * 2.0) + f32ToInt(f32FromInt(7))

@export("scale")
fun scale(index: int, value: f32): f32 = scales[index] * fclamp(value, 0.0, 1.0)
