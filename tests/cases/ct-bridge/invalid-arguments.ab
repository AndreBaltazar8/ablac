// Runs natively inside a test bridge frame, rather than as a parser handler.
import "abla/compiler/bridge"
import "abla/sys/linux/io"
fun unregistered(): int = 7
trusted fun main: int {
    ablaCtBridgeArgFunction(unregistered)
    val first = ablaCtBridgeInvoke("syntaxInteger")
    linuxPrintStandardOutput("function $first ${ablaCtBridgeResultHandle()}\n")
    // A fresh invalid still counts after an earlier, unrelated failure.
    ablaCtBridgeArgHandle(-1)
    val second = ablaCtBridgeInvoke("syntaxInteger")
    linuxPrintStandardOutput("handle $second ${ablaCtBridgeResultHandle()}\n")
    ablaCtBridgeArgArrayBegin()
    ablaCtBridgeArgHandle(-1)
    ablaCtBridgeArgArrayEnd()
    val third = ablaCtBridgeInvoke("syntaxArray")
    linuxPrintStandardOutput("array $third ${ablaCtBridgeResultHandle()}\n")
    0
}
