import "abla/compiler"

// A compile function called by a transform handler adds a module before the
// program is analyzed, so the program can call what it declares.
compile fun addAnswer(value: int): void {
    compiler.generateModule("answer", "fun generatedAnswer(): int = $value\n")
    return
}

compile fun configure(): void {
    addAnswer(42)
    return
}

#compiler.transform(configure)

fun main: int = generatedAnswer()
