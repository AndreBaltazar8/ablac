// Appended to the generated shims: calls the compiler API natively inside a
// bridge frame (ABLA_CT_BRIDGE_RUN_FRAME) and prints what it observed.
import "abla/compiler/bridge"
import "abla/sys/linux/io"

fun say(line: string): void {
    linuxPrintStandardOutput("$line\n")
    return
}

@marker
@route("/probe")
fun probeTarget(count: int, label: string): string = "$label$count"

fun nativeFinalizer(payload: string, expression: SyntaxExpression): string =
    payload

fun main: int {
    val handle = compilerFindFunction("probeTarget")
    say("find ${handle >= 0}")
    say("name ${compilerFunctionName(handle)}")
    say("parameters ${compilerFunctionParameterCount(handle)} ${compilerFunctionParameterName(handle, 1)}:${compilerFunctionParameterType(handle, 1)}")
    say("annotation ${compilerFunctionAnnotationCount(handle)} ${compilerFunctionAnnotation(handle, 0)}")
    say("route ${compilerFunctionAnnotationArgumentCount(handle, 1)} ${compilerFunctionAnnotationArgumentKind(handle, 1, 0)} ${compilerFunctionAnnotationArgumentText(handle, 1, 0)} ${syntaxKind(compilerFunctionAnnotationArgument(handle, 1, 0))}")
    say("missing ${compilerFindFunction("noSuchFunction")}")
    say("functions ${compilerFunctions().size > 0}")

    val call = syntaxCall("f", [syntaxInteger(7), syntaxString("hi")])
    say("call ${syntaxKind(call)} ${syntaxText(call)} ${syntaxChildCount(call)}")
    val first = syntaxChild(call, 0)
    // A handle stays valid for the whole frame.
    val again = syntaxChild(call, 1)
    say("child ${syntaxKind(first)} ${syntaxText(first)} first=${syntaxText(first)}")
    say("child1 ${syntaxKind(again)} ${syntaxText(again)}")

    val intType = compilerFindType("int")
    val module = compilerGeneratedModule("bridge.test", call)
    val generated = compilerGeneratedFunction(
        module, "twice", ["value"], [intType], intType,
        syntaxBinary("*", syntaxIdentifier("value"), syntaxInteger(2))
    )
    say("generated ${generated != ""} count=${compilerGeneratedDeclarationCount(module)}")

    val contents = ablaHostReadFile("tests/cases/ct-bridge/shim-source.ab")
    say("read ${contents.size}")
    val listing = ablaHostListDirectory("tests/cases/ct-bridge")
    say("listing ${listing.size} ${if (listing.size > 0) listing[0] else "-"}")
    say("environment ${compilerEnvironment("ABLA_CT_BRIDGE_PROBE")}")

    compilerRecordExtensionRequest("bridge.test", "payload", call, nativeFinalizer)
    say("done")
    0
}
