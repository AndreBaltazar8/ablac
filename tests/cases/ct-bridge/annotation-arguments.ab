import "abla/compiler"
import "abla/compiler/parser"

@route("/users")
@limit(25)
@marker
fun users(): int = 1

compile fun describe(): string {
    val function = compiler.findFunction("users")
    var text = ""
    var annotation = 0
    while (annotation < compiler.annotationCount(function)) {
        val count = compiler.annotationArgumentCount(function, annotation)
        text = "$text${compiler.annotation(function, annotation)}:$count"
        if (count > 0) {
            val syntax = compiler.annotationArgument(function, annotation)
            text = "$text=${compiler.annotationArgumentKind(function, annotation)}/${compiler.annotationArgumentText(function, annotation)}/${syntaxKind(syntax)}"
        }
        text = "$text;"
        annotation = annotation + 1
    }
    text
}

fun main: int {
    val text = #describe()
    if (text == "route:1=string//users/string;limit:1=integer/25/integer;marker:0;") 42
    else 1
}
