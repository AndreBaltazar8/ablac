import "abla/compiler/parser"
import "abla/stm"
compile fun choose(): SyntaxExpression = atomic {
    atomic { syntaxInteger(retry) } orElse { syntaxInteger(42) }
}
compile fun readChoice(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    choose()
}
#compilerRegisterSubparser("choice", readChoice)
fun main: int = $choice()
