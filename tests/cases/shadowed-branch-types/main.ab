var drops = 0
resource class Token(val n: int) { fun drop(): void { drops = drops * 100 + n } }

fun discardIf(flag: bool): int {
    val value = 7
    if (flag) { val value = Token(value + 1); value } else { val value = Token(value + 2); value }
    value
}
fun discardWhen(flag: bool): int {
    val value = 7
    when (flag) {
        true -> { val value = Token(value + 1); value }
        false -> { val value = Token(value + 2); value }
    }
    value
}
fun sharedWhen(input: int): int {
    val value = 7
    when (input) {
        1, 2 -> { val value = Token(value + 1); value }
        else -> { val value = Token(value + 2); value }
    }
    value
}
fun usedIf(flag: bool): int {
    val value = 7
    val chosen = if (flag) { val value = Token(value + 1); value } else { val value = Token(value + 2); value }
    chosen.n + value
}
fun usedWhen(flag: bool): int {
    val value = 7
    val chosen = when (flag) {
        true -> { val value = Token(value + 1); value }
        false -> { val value = Token(value + 2); value }
    }
    chosen.n + value
}
fun nestedIf(flag: bool): int {
    val value = 7
    val chosen = if (flag) {
        val value = Token(value + 1)
        if (flag) value else value
    } else {
        val value = Token(value + 2)
        value
    }
    chosen.n + value
}
fun scalarIf(flag: bool): int {
    val value = Token(3)
    val answer = if (flag) { val value = 4; value + 1 } else { val value = 6; value + 1 }
    answer + value.n
}
fun scalarWhen(flag: bool): int {
    val value = Token(3)
    val answer = when (flag) {
        true -> { val value = 4; value + 1 }
        false -> { val value = 6; value + 1 }
    }
    answer + value.n
}
fun scalarDiscardIf(flag: bool): int {
    val value = Token(3)
    if (flag) { val value = 4; value + 1 } else { val value = 6; value + 1 }
    value.n
}
fun scalarDiscardWhen(flag: bool): int {
    val value = Token(3)
    when (flag) {
        true -> { val value = 4; value + 1 }
        false -> { val value = 6; value + 1 }
    }
    value.n
}
fun main: int {
    if (discardIf(true) != 7 || drops != 8) return 1
    drops = 0
    if (discardIf(false) != 7 || drops != 9) return 2
    drops = 0
    if (discardWhen(true) != 7 || drops != 8) return 3
    drops = 0
    if (discardWhen(false) != 7 || drops != 9) return 4
    drops = 0
    if (sharedWhen(2) != 7 || drops != 8) return 17
    drops = 0
    if (sharedWhen(3) != 7 || drops != 9) return 18
    drops = 0
    if (usedIf(true) != 15 || drops != 8) return 5
    drops = 0
    if (usedIf(false) != 16 || drops != 9) return 6
    drops = 0
    if (usedWhen(true) != 15 || drops != 8) return 7
    drops = 0
    if (usedWhen(false) != 16 || drops != 9) return 8
    drops = 0
    if (nestedIf(true) != 15 || drops != 8) return 15
    drops = 0
    if (nestedIf(false) != 16 || drops != 9) return 16
    drops = 0
    if (scalarIf(true) != 8 || drops != 3) return 9
    drops = 0
    if (scalarIf(false) != 10 || drops != 3) return 10
    drops = 0
    if (scalarWhen(true) != 8 || drops != 3) return 11
    drops = 0
    if (scalarWhen(false) != 10 || drops != 3) return 12
    drops = 0
    if (scalarDiscardIf(true) != 3 || drops != 3) return 13
    drops = 0
    if (scalarDiscardWhen(false) != 3 || drops != 3) return 14
    42
}
