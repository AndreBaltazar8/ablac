// Compile-time sites whose results are scalars: under ABLA_COMPILE_EVAL=jit each
// runs as native code and must give what the interpreter gives.
class Counter(var count: int) {
    fun bump(by: int): int {
        count = count + by
        count
    }
}

fun fib(n: int): int = if (n < 2) n else fib(n - 1) + fib(n - 2)

fun greet(name: string): string = "hello, $name"

compile fun tally(limit: int): int {
    val counter = Counter(0)
    val steps: array<int> = []
    var index = 0
    while (index < limit) {
        steps.append(index * 3)
        index = index + 1
    }
    for (step in steps) counter.bump(step)
    counter.count
}

compile fun applyTwice(value: int): int {
    val double = { x: int -> x * 2 }
    double(double(value))
}

compile fun spin(limit: int): int {
    var acc = 0
    var index = 0
    while (index < limit) {
        acc = (acc + index * 7) % 1000003
        index = index + 1
    }
    acc
}

val fibValue = #fib(20)
val greeting = #greet("compile time")
val flag = #(fib(10) == 55 && greet("x").size == 8)

#tally(5)

fun main: int {
    val total = #tally(10)
    val twice = #applyTwice(5)
    val spun = #spin(200000)
    if (fibValue == 6765 && greeting == "hello, compile time" && flag &&
        total == 135 && twice == 20 && spun == 880006) 42 else 1
}
