// Compile globals keep one value for the compilation across native and
// interpreted evaluations alike.
import "abla/compiler"

compile var counter: int = 100
compile val label: string = "tag"

compile fun bump(by: int): int {
    counter = counter + by
    counter
}

// A global whose initializer is compile-time code keeps a site that reads it in the
// interpreter: the next native site sees the counter it changed.
val bumpHandle = #compilerFindFunction("bump")

compile fun snapshot(): array<int> {
    counter = counter + 1
    if (bumpHandle < 0) [] else [counter]
}

val a = #bump(1)
val b = #bump(10)
val c = #"$label-$counter"
val d = #snapshot()
val e = #bump(1)

fun main: int = if (a == 101 && b == 111 && c == "tag-111" && d[0] == 112 &&
    e == 113) 42 else 1
