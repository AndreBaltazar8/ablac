// Arrays and objects come back from native code through the value codec; a site
// the native tier cannot take yet (here a compiler API call) is interpreted. The
// program is the same either way.
import "abla/compiler"

class Pair(val left: int, val right: int)

compile fun makeValues(): array<int> = [10, 20, 30]

compile fun makePair(): Pair = Pair(7, 8)

fun square(value: int): int = value * value

fun main: int {
    val values = #makeValues()
    val pair = #makePair()
    val squared = #square(3)
    val handle = #compilerFindFunction("square")
    if (handle < 0) 1 else values[1] + pair.left + pair.right + squared - 11
}
