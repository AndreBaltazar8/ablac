// With trusted.native granted, compile-time code runs system calls, but
// `panic` and `exit` still stop only the evaluation, never the compiler.
import "abla/process"
import "abla/compiler"

#compilerGrant("trusted.native")

compile fun boom(): int {
    if (1 + 1 == 2) panic("from compile time")
    3
}

compile fun leave(): int {
    if (1 + 1 == 2) exit(3)
    3
}

val broken = #boom()
val left = #leave()

fun main: int = broken + left
