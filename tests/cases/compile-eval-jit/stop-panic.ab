// `panic` in compile-time code is a compile error with its message, not a
// dead compiler, and needs no capability.
import "abla/process"

compile fun boom(): int {
    if (1 + 1 == 2) panic("the table is empty")
    3
}

compile fun fine(): int = 7

val first = #fine()
val broken = #boom()
val after = #fine()

fun main: int = first + broken + after
