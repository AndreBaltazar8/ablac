// A compile global without a setter (here a nested array) that an interpreted
// evaluation changes leaves the generation's copy stale: the sites after it are
// interpreted.
import "abla/compiler"

compile var grid: array<array<int>> = [[1]]

compile fun widen(value: int): int {
    grid.append([value])
    grid.size
}

// Naming a compiler API call that takes a function keeps a site in the interpreter
// (the call itself never runs).
compile fun interpreted(value: int): int {
    if (value < 0) compilerApplyTransform({ })
    value
}

val widenHandle = #compilerFindFunction("widen")

compile fun widenInterpreted(): int {
    grid.append([9])
    if (interpreted(widenHandle) < 0) 0 else grid.size
}

val first = #widen(2)
val second = #widenInterpreted()
val third = #widen(3)

fun main: int = if (first == 2 && second == 3 && third == 4) 42 else 1
