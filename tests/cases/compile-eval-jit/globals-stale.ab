// A compile global without a setter (here a nested array) that an interpreted
// evaluation changes leaves the generation's copy stale: the sites after it are
// interpreted.
import "abla/compiler"

compile var grid: array<array<int>> = [[1]]

compile fun widen(value: int): int {
    grid.append([value])
    grid.size
}

// A compiler API call keeps it in the interpreter.
compile fun widenInterpreted(): int {
    grid.append([9])
    if (compilerFindFunction("widen") < 0) 0 else grid.size
}

val first = #widen(2)
val second = #widenInterpreted()
val third = #widen(3)

fun main: int = if (first == 2 && second == 3 && third == 4) 42 else 1
