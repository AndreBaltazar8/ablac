// A compile global without a setter (here a string) that an interpreted evaluation
// changes leaves the generation's copy stale: the sites after it are interpreted.
import "abla/compiler"

compile var trail: string = "a"

compile fun extend(part: string): string {
    trail = "$trail$part"
    trail
}

// A compiler API call keeps it in the interpreter.
compile fun extendInterpreted(): string {
    trail = "${trail}i"
    if (compilerFindFunction("extend") < 0) "" else trail
}

val first = #extend("b")
val second = #extendInterpreted()
val third = #extend("c")

fun main: int = if (first == "ab" && second == "abi" && third == "abic") 42 else 1
