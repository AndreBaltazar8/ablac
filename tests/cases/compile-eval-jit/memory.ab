// Native compile-time code collects as a hosted program does: a global holds what
// it references through `memoryCollect()`, and allocation pressure collects
// without the code asking for it. (The interpreter has no program heap to
// measure, so this case runs natively only.)
import "abla/memory"

class HeldBox(val values: array<int>)
class GarbageLink(var next: GarbageLink?, val payload: array<int>)

var heldBoxes: array<HeldBox> = []

fun heldValues(seed: int): array<int> {
    val values: array<int> = []
    for (index in 0 until 64) values.append(seed + index)
    values
}

// What the global holds survives collections: 200 boxes, sum of (index + 63).
fun keptThroughCollection(): int {
    for (index in 0 until 200) {
        heldBoxes.append(HeldBox(heldValues(index)))
        if (index % 20 == 0) memoryCollect()
    }
    memoryCollect()
    var total = 0
    for (box in heldBoxes) total = total + box.values[63]
    if (heldBoxes.size == 200 && total == 19900 + 200 * 63) 1 else 0
}

fun abandonCycle(seed: int): int {
    val payload: array<int> = []
    var index = 0
    while (index < 1024) {
        payload.append(seed + index)
        index = index + 1
    }
    val left = GarbageLink(null, payload)
    val right = GarbageLink(left, [seed])
    left.next = right
    left.payload[0] + right.payload[0]
}

// 512 MiB of cyclic garbage, never more than half of it live at once.
fun collectedUnderPressure(): int {
    var round = 0
    var sum = 0
    var peak = 0
    while (round < 65536) {
        sum = abandonCycle(21)
        if (memoryLiveBytes() > peak) peak = memoryLiveBytes()
        round = round + 1
    }
    if (sum == 42 && peak < 268435456) 1 else 0
}

val kept = #keptThroughCollection()
val collected = #collectedUnderPressure()

fun main: int = if (kept == 1 && collected == 1) 42 else kept * 10 + collected
