// Compile globals an interpreted evaluation changes go back into the native code
// through their setters: strings, f64, and arrays of ints and strings.
import "abla/compiler"
import "abla/float/text"

compile var trail: string = "a"
compile var scale: f64 = 1.5
compile var counts: array<int> = [1]
compile var names: array<string> = ["x"]

compile fun describe(): string =
    "$trail ${scale} ${counts.size}:${counts[counts.size - 1]} ${names.size}:${names[names.size - 1]}"

// Naming a compiler API call that takes a function keeps a site in the interpreter
// (the call itself never runs).
compile fun interpreted(value: int): int {
    if (value < 0) compilerApplyTransform({ })
    value
}

// The interpreted site changes every global.
val describeHandle = #compilerFindFunction("describe")

compile fun change(): int {
    trail = "${trail}é"
    scale = scale * 2.0
    counts.append(-7)
    names.append("yz")
    interpreted(describeHandle)
}

val before = #describe()
val changed = #change()
val after = #describe()

fun main: int = if (before == "a 1.5 1:1 1:x" && changed >= 0 &&
    after == "aé 3 2:-7 2:yz") 42 else 1
