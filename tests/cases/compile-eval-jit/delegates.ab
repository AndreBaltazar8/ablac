// A delegated `compile var` keeps its delegate for the compilation on both tiers:
// each evaluation sees what the previous one set through it, also when a site
// in a function runs again inside another evaluation, and across an interpreted
// site between native ones.
import "abla/compiler"

class Counter(var current: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = next
        return
    }
}

compile var counted: int by Counter(0)

compile fun bump(): int {
    counted = counted + 3
    counted
}

fun zero(): int = 0

// Naming a compiler API call that takes a function keeps a site in the interpreter
// (the call itself never runs).
compile fun interpreted(value: int): int {
    if (value < 0) compilerApplyTransform({ })
    value
}

val seed = #zero()

// A site the native tier can't take: this one runs in the interpreter.
compile fun bumpInterpreted(): int {
    counted = counted + 3
    counted + interpreted(seed)
}

// Its two sites run where the function is compiled, and again inside `#twice()`.
fun twice(): int {
    val first = #bump()
    first * 100 + #bump()
}

val a = #bump()
val b = #bump()
val c = #twice()
val d = #bumpInterpreted()
val e = #bump()

fun main: int = if (a == 9 && b == 12 && c == 1518 && d == 21 && e == 24) 42 else 1
