// A delegated `compile var` keeps its delegate for the compilation on both tiers:
// each evaluation sees what the previous one set through it, also across an
// interpreted site between native ones. A site in a function is one constant: an
// evaluation that calls the function gets the value it already has.
import "abla/compiler"

class Counter(var current: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = next
        return
    }
}

compile var counted: int by Counter(0)

compile fun bump(): int {
    counted = counted + 3
    counted
}

fun zero(): int = 0

// Naming a compiler API call that takes a function keeps a site in the interpreter
// (the call itself never runs).
compile fun interpreted(value: int): int {
    if (value < 0) compilerApplyTransform({ })
    value
}

val seed = #zero()

// A site the native tier can't take: this one runs in the interpreter.
compile fun bumpInterpreted(): int {
    counted = counted + 3
    counted + interpreted(seed)
}

// Its two sites run once, where the function is compiled (3 and 6): `#twice()` reads
// those values and runs neither again (docs/compile-time.md: a `#` inside a function
// body is still one constant).
fun twice(): int {
    val first = #bump()
    first * 100 + #bump()
}

val a = #bump()
val b = #bump()
val c = #twice()
val d = #bumpInterpreted()
val e = #bump()

fun main: int = if (a == 9 && b == 12 && c == 306 && d == 15 && e == 18) 42 else 1
