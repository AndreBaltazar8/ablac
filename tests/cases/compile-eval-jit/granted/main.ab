// A granted program stays native: the slice's analysis sees its grant (and not
// abla/json's subparser registrations, which name compile code the slice doesn't
// carry), and an extension method the slice keeps by name brings its class. With
// `environment` its runtime has the compiler's environment, as the evaluator does.
import "abla/compiler"
#compilerGrant("trusted.native")
#compilerGrant("environment")
import "abla/json"
import "abla/sys/linux/process"

noescape extern:"c" fun strlen(text: cstring): int

fun counted(): int {
    val parsed = jsonParse("[1, 2, 3, 4]")
    if (!parsed.succeeded) return 0
    val path = if (linuxEnvironment("PATH").found) 0 else 100
    parsed.value.size() * 10 + strlen("ab") + path
}

fun main: int = #counted()
