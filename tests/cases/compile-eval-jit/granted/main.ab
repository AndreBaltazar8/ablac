// A granted program stays native: the slice's analysis sees its grant (and not
// abla/json's subparser registrations, which name compile code the slice doesn't
// carry), and an extension method the slice keeps by name brings its class.
import "abla/compiler"
#compilerGrant("trusted.native")
import "abla/json"

noescape extern:"c" fun strlen(text: cstring): int

fun counted(): int {
    val parsed = jsonParse("[1, 2, 3, 4]")
    if (!parsed.succeeded) return 0
    parsed.value.size() * 10 + strlen("ab")
}

fun main: int = #counted()
