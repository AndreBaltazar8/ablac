// Two compilations in one compiler process: this program's own native site, then
// the program it asks to build (inside this pass, so interpreted).
import "abla/build"

fun triple(value: int): int = value * 3

val tripled = #triple(14)
val built = #buildProgram(
    "compile-eval-jit-inner",
    "tests/cases/compile-eval-jit/twice/inner.ab",
    "build/compile-eval-jit/inner",
    "host",
    "executable",
    true,
    false
)

fun main: int = if (built && tripled == 42) 42 else 1
