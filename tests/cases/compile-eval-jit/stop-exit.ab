// `exit` in compile-time code stops the evaluation (E_CT_STOPPED); the
// compiler goes on and fails the build.
import "abla/process"

compile fun leave(): int {
    if (1 + 1 == 2) exit(3)
    3
}

compile fun fine(): int = 7

val first = #fine()
val broken = #leave()
val after = #fine()

fun main: int = first + broken + after
