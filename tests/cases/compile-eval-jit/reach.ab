// What a slice carries: a site the native tier can't take (here one reading a global
// whose initializer is compile-time code) adds nothing to it, so the other sites stay
// native; a call through a global holding a function brings that global; a moved
// scalar local and an f32 in a string template lower.
import "abla/float"
import "abla/float/text"

compile fun seven(): int = 7

val base = #seven()

compile fun fromBase(): int = base * 2

fun twice(value: int): int = value * 2

val doubler = twice

compile fun throughGlobal(): int = doubler(8)

compile fun movedScalar(): int {
    var source = 19
    val destination = move(source)
    source = 23
    destination + source
}

fun movedAtRunTime(): int {
    var source = 40
    val destination = move(source)
    source = 2
    destination + source
}

compile fun floatLabel(): string {
    val half: f32 = f64ToF32(0.5)
    "half $half"
}

fun main: int {
    val fourteen = #fromBase()
    val sixteen = #throughGlobal()
    val moved = #movedScalar()
    val label = #floatLabel()
    if (fourteen == 14 && sixteen == 16 && moved == 42 && movedAtRunTime() == 42 &&
        label == "half 0.5") 42 else 1
}
