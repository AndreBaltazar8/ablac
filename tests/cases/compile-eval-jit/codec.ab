// A result graph with sharing, a cycle, a map, nested arrays and floats comes back
// from native code as the interpreter would give it.
class Node(val name: string, val weight: f64, var next: Node?)

class Table(val rows: array<array<int>>, val index: Map<string, int>, val nodes: array<Node>)

compile fun build(): Table {
    val first = Node("first", 1.5, null)
    val second = Node("second", 2.25, first)
    first.next = second
    val index: Map<string, int> = Map()
    index.set("x", 1)
    index.set("y", 2)
    val rows: array<array<int>> = []
    var row = 0
    while (row < 50) {
        rows.append([row, row * row])
        row = row + 1
    }
    Table(rows, index, [first, second, first])
}

val table = #build()

fun main: int {
    val shared = table.nodes[0] == table.nodes[2]
    val cycle = table.nodes[0].next == table.nodes[1] && table.nodes[1].next == table.nodes[0]
    if (table.rows[49][1] == 2401 && table.index.get("y") == 2 && shared && cycle &&
        table.nodes[1].weight == 2.25 && table.nodes[0].name == "first") 42 else 1
}
