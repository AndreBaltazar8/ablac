// Ordinary globals remain collector roots at runtime. Keep this coverage
// separately from the compile-time cross-tier ordinary-global fallback.
import "abla/memory"

class HeldBox(val values: array<int>)

var heldBoxes: array<HeldBox> = []

fun heldValues(seed: int): array<int> {
    val values: array<int> = []
    for (index in 0 until 64) values.append(seed + index)
    values
}

// What the global holds survives collections: 200 boxes, sum of (index + 63).
fun keptThroughCollection(): int {
    for (index in 0 until 200) {
        heldBoxes.append(HeldBox(heldValues(index)))
        if (index % 20 == 0) memoryCollect()
    }
    memoryCollect()
    var total = 0
    for (box in heldBoxes) total = total + box.values[63]
    if (heldBoxes.size == 200 && total == 19900 + 200 * 63) 1 else 0
}

fun main: int = if (keptThroughCollection() == 1) 42 else 1
