class Body(var x: f64, var y: f64)

fun replaceAndGrow(var bodies: array<Body>, index: int): void {
    bodies[index] = Body(20.0, 30.0)
    bodies.append(Body(40.0, 50.0))
}

fun advance(var bodies: array<Body>, grow: bool): f64 {
    var index = 0
    var total = 0.0
    while (index < bodies.size) {
        bodies[index].x = bodies[index].x + bodies[index].y
        if (grow && index == 0) replaceAndGrow(bodies, index)
        bodies[index].y = bodies[index].x + 1.0
        total = total + bodies[index].y
        index = index + 1
    }
    total
}

fun main: int {
    var bodies = [Body(1.0, 2.0), Body(3.0, 4.0)]
    val before = advance(bodies, false)
    val after = advance(bodies, true)
    if (before == 12.0 && after == 128.0 && bodies[0].x == 20.0) 42 else 1
}
