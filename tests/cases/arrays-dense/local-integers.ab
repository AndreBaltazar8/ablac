import "abla/memory"
import "abla/process/arguments"
import "abla/runtime/scalar"

trusted fun forceBox(values: any): void {
    __ablaRuntimeArraySet(values, __ablaRuntimeI64(0), __ablaRuntimeNull())
    return
}

fun freshWords(index: int, write: bool): int {
    val values: array<int> = []
    values.append(11)
    values.append(22)
    values.append(33)
    values.append(44)
    values.append(55)
    memoryCollect()
    if (write) {
        values[index] = 42
        return values[index]
    }
    values[index]
}

trusted fun secondWord(values: any): int =
    __ablaRuntimeAsI64(__ablaRuntimeArrayGet(values, __ablaRuntimeI64(1)))

fun escapedWords(): int {
    val values: array<int> = []
    values.append(11)
    values.append(22)
    val alias = values
    forceBox(alias)
    values[1] = 42
    if (values[1] == 42) secondWord(values) else 1
}

fun emptyWord(write: bool): int {
    val values: array<int> = []
    if (write) values[0] = 42
    values[0]
}

// The dense header must be read again after append, which can move the buffer
// and makes an index that was previously out of bounds valid.
fun growingWords(): int {
    val values: array<int> = []
    values.append(1)
    var index = 0
    while (index < 65) {
        val previous = values[index]
        values.append(previous + 1)
        values[index] = values[index + 1] + 40
        index = index + 1
    }
    if (values.size == 66 && values[0] == 42 && values[32] == 74 && values[65] == 66) 42 else 1
}

fun main: int {
    val mode = if (processArgumentCount() == 0) "" else processArgument(0)
    if (mode == "escaped") return escapedWords()
    if (mode == "growing") return growingWords()
    val write = processArgumentCount() > 1
    if (mode == "empty") return emptyWord(write)
    val index = if (mode == "negative") -1 else if (mode == "upper") 5 else 1
    val result = freshWords(index, write)
    if (result == (if (write) 42 else 22)) 42 else 1
}
