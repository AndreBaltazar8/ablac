import "abla/process/arguments"
import "abla/runtime/scalar"

@noinline
fun copyWords(start: int, end: int, size: int): int {
    val source: array<int> = []
    val destination: array<int> = []
    source.append(11)
    source.append(22)
    source.append(33)
    destination.append(1)
    destination.append(2)
    if (size == 3) destination.append(3)
    var i = start
    while (i < end) { destination[i] = source[i]; i = i + 1 }
    if (start >= end) return if (i == start && destination[1] == 2) 42 else 1
    if (i == end && destination[0] == 1 && destination[1] == 22 && destination[2] == 33) 42
    else 2
}

@noinline
fun shiftWords(end: int): int {
    val words: array<int> = []
    words.append(11)
    words.append(22)
    words.append(33)
    words.append(44)
    var i = 0
    while (i < end) { words[i] = words[i + 1]; i = i + 1 }
    if (i == end && words[0] == 22 && words[1] == 33 && words[2] == 44 && words[3] == 44) 42
    else 3
}

trusted fun boxWords(words: any): void {
    __ablaRuntimeArraySet(words, __ablaRuntimeI64(0), __ablaRuntimeNull())
    return
}

@noinline
fun copyBoxed(end: int): int {
    val source: array<int> = []
    val destination: array<int> = []
    source.append(0)
    source.append(42)
    destination.append(7)
    destination.append(8)
    boxWords(source)
    var i = 1
    while (i < end) { destination[i] = source[i]; i = i + 1 }
    destination[1]
}

fun main: int {
    val mode = if (processArgumentCount() == 0) "" else processArgument(0)
    if (mode == "negative") return copyWords(-1, 2, 3)
    if (mode == "destination") return copyWords(1, 3, 2)
    if (mode == "source") return copyWords(1, 4, 3)
    if (mode == "shift-bound") return shiftWords(4)
    if (copyWords(1, 3, 3) != 42 || copyWords(3, 2, 3) != 42 ||
        copyWords(-2, -3, 3) != 42 || shiftWords(3) != 42 || copyBoxed(2) != 42) return 4
    42
}
