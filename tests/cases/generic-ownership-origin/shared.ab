import "abla/array/ownership-probe"
resource class Ticket(val value: int)
fun first(): int {
    val xs = [Ticket(1)]
    val result = xs.invalidPop()
    result.value
}
fun main: int {
    val a = [Ticket(2)]
    val firstResult = a.invalidPop()
    val b = [Ticket(3)]
    val secondResult = b.invalidPop()
    first() + firstResult.value + secondResult.value
}
