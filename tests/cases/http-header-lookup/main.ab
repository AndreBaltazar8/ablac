// HttpRequest.header against its previous form (same length, then a full case-insensitive
// compare, the last duplicate winning): names that differ in case, names whose last bytes
// fold together under `| 32` without being equal letters, duplicates, empty and missing names.
import "abla/http"

private fun referenceHeader(request: HttpRequest, name: string): string {
    var result = ""
    var found = false
    var index = request.headers.size
    while (!found && index > 0) {
        index = index - 1
        val candidate = request.headers[index]
        if (candidate.name.size == name.size && httpAsciiEqualInsensitive(candidate.name, name)) {
            result = candidate.value
            found = true
        }
    }
    result
}

fun main: int {
    // Last bytes that fold together under `| 32` but are different: @ and `, [ and {, \ and |, ] and },
    // ^ and ~, _ and DEL's neighbour, and digits against control codes.
    val names = [
        "X-A", "x-a", "X-a", "x-A", "X-A0", "X-A1", "X-AP", "X-Ap", "X-A@", "X-A`", "X-A[", "X-A{",
        "X-A\\\\", "X-A|", "X-A]", "X-A}", "X-A^", "X-A~", "X-A_", "Host", "host", "HOST", "hOsT",
        "Content-Length", "content-length", "Content-Type", "X-B", "Z", "z", "@", "`", "a", "A"
    ]
    var wire = "GET /h HTTP/1.1\r\n"
    for (name in names) {
        wire = wire + "$name: v-$name\r\n"
    }
    // A duplicate: the last one wins.
    wire = wire + "x-a: second\r\nHOST: example\r\n\r\n"
    val request = httpParseRequest(wire)
    var bad = 0
    // Every name against every name: all case variants, and the last bytes that only fold together.
    for (name in names) {
        for (query in names) {
            if (request.header(query) != referenceHeader(request, query)) bad = bad + 1
        }
        if (request.header(name) != referenceHeader(request, name)) bad = bad + 1
    }
    for (missing in ["", "X-", "X-A00", "Nope", "x-a@", "Content-Lengtu"]) {
        if (request.header(missing) != referenceHeader(request, missing)) bad = bad + 1
    }
    // The values the filter must not hide: the case variants and the duplicate.
    if (request.header("X-A") != "second") bad = bad + 1
    if (request.header("host") != "example") bad = bad + 1
    if (bad == 0) 42 else 1
}
