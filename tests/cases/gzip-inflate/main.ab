import "abla/compression/gzip"
import "abla/bytes"
import "abla/fs"
import "abla/process/arguments"

fun main(): int {
    val raw = Path(processArgument(0)).readText()
    val packed = Path(processArgument(1)).readText()
    val result = gzipDecompress(packed, raw.size)
    if (result.error != "" || result.data != raw) return 1
    if (raw.size > 0 && gzipDecompress(packed, raw.size - 1).error != "limit") return 2
    if (gzipDecompress("", 0).error != "invalid") return 3
    if (gzipDecompress(packed + "x", raw.size).error != "invalid") return 4
    if (gzipDecompress(packed + packed, raw.size).error != "invalid") return 5
    if (gzipDecompress(packed, -1).error != "invalid") return 6
    if (processArgument(2) == "mutate") {
        var i = 0
        while (i < 4000) {
            val at = (i * 7919) % packed.size
            val byte = byteEncode(packed[at] ^ (1 << (i % 8)))
            val altered = packed.slice(0, at) + byte + packed.slice(at + 1, packed.size)
            val changed = gzipDecompress(altered, raw.size)
            if (changed.error == "" && changed.data != raw) return 7
            val short = gzipDecompress(packed.slice(0, at), raw.size)
            if (short.error == "" && short.data != raw) return 8
            i += 1
        }
    }
    0
}
