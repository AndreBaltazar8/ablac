import "../../../src/ir.ab"

fun main: int {
    val parsed = bootstrapParse("")
    val analyzed = bootstrapAnalyzeParsed(parsed)
    val declarations = parsed.declarations
    var lowerer = BootstrapLowerer(
        [], [], ["x"], ["nullable:string"], [], [], [], [], [], [], [], [], [],
        [-1], 0, declarations,
        bootstrapFunctionDeclarationIndex(declarations),
        bootstrapTypeDeclarationIndex(declarations),
        bootstrapScalarTypeDeclarationIndex(declarations),
        bootstrapValueDeclarationIndex(declarations),
        bootstrapMethodDeclarationIndex(declarations),
        bootstrapBuildAffineTypeNames(declarations),
        bootstrapBuildNeverCallNames(declarations),
        analyzed.mutableReceivers, [], [], [], [], [], [], [], [], "", [], [], [], [],
        0, 0, -1, -1, -1, -1, false, 0, bootstrapIrLocalNames(), [],
        BootstrapLiftProbe([], [])
    )
    // Keep one query open while the very same AST node is queried again.
    val x = BootstrapExpression("identifier", "x", 0, 1, [])
    val condition = BootstrapExpression("!=", "", 0, 2, [
        x, BootstrapExpression("null", "", 1, 2, [])
    ])
    lowerer.typeQueryStack.append(0)
    val before = lowerer.lowerExpressionType(x)
    val previous = lowerer.enterLocalScope()
    val insideBefore = lowerer.lowerExpressionType(x)
    lowerer.addNullableRefinement(condition, true)
    val narrowed = lowerer.lowerExpressionType(x)
    lowerer.leaveLocalScope(previous)
    val after = lowerer.lowerExpressionType(x)
    lowerer.typeQueryStack.truncate(0)
    if (before == "nullable:string" && insideBefore == "nullable:string" &&
        narrowed == "string" && after == "nullable:string") 42 else 1
}
