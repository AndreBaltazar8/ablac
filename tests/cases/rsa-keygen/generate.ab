// Test-only key generator. The PEM is written only to the requested path.
import "abla/crypto/rsa"
import "abla/fs"
import "abla/process/arguments"

fun main: int {
    val key = rsaGeneratePrivateKey(2048)
    if (!key.ok()) return 1
    val pem = key.toPkcs8Pem()
    if (!pem.ok || !path(processArgument(0)).writeText(pem.bytes)) 2 else 0
}
