import "abla/crypto/rsa"
import "abla/fs"
import "abla/process/arguments"

fun main: int {
    val mode = processArgument(0)
    if (mode == "invalid") {
        val invalid = rsaGeneratePrivateKey(1024)
        if (invalid.ok()) return 1
        cryptoSetRandom({ count: int -> "" })
        val noRandom = rsaGeneratePrivateKey(2048)
        if (noRandom.ok()) 2 else 0
    } else {
        val bits = if (mode == "3072") 3072 else if (mode == "4096") 4096 else 2048
        val key = rsaGeneratePrivateKey(bits)
        if (!key.ok() || key.bits != bits) return 3
        val der = key.toPkcs8Der()
        val pem = key.toPkcs8Pem()
        if (!der.ok || !pem.ok) return 4
        val imported = rsaPrivateKeyFromPem(pem.bytes)
        if (!imported.ok() || imported.modulus != key.modulus) return 5
        val public = rsaPublicFromNumbers(key.modulus, key.publicExponent, "bad key")
        val message = "RSA key generation pairwise test"
        val signed = key.signPkcs1Sha256(message)
        if (!signed.ok || !public.verifyPkcs1Sha256(message, signed.bytes)) return 6
        val encrypted = public.encryptOaepSha256(message)
        if (!encrypted.ok) return 7
        val decrypted = key.decryptOaepSha256(encrypted.bytes)
        if (!decrypted.ok || decrypted.bytes != message) return 8
        if (!path(processArgument(1)).writeText(pem.bytes)) return 9
        0
    }
}
