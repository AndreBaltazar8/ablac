import "rsa-copy.ab"

var roundIndex = 0

fun roundRandom(count: int): string {
    if (count != 4) return ""
    roundIndex = roundIndex + 1
    if (roundIndex % 2 == 1) "\x00\x00\x00\x02" else "\x00\x00\x00\x03"
}

fun main: int {
    cryptoSetRandom({ count: int -> if (count == 4) "\x00\x00\x00\x02" else "" })
    if (rsaProbablePrime("\x00\x00\x03\xf1", 5) != 1) return 1 // 1009
    if (rsaProbablePrime("\x00\x00\x02\x31", 5) != 0) return 2 // 561
    if (rsaProbablePrime("\x00\x00\x04\x51", 5) != 0) return 3 // 1105
    if (rsaProbablePrime("\x00\x00\x00\x02\x00\x01\x00\x01", 1) != -1) return 4
    // 2047 is a strong pseudoprime to base 2 but not base 3.
    cryptoSetRandom({ count: int -> roundRandom(count) })
    roundIndex = 0
    if (rsaProbablePrime("\x00\x00\x07\xff", 1) != 1) return 6
    roundIndex = 0
    if (rsaProbablePrime("\x00\x00\x07\xff", 2) != 0) return 7
    val low = "\x80" + "\x00".repeat(127)
    val equalDistance = "\x80" + "\x00".repeat(11) + "\x10" + "\x00".repeat(115)
    val greaterDistance = equalDistance.slice(0, 127) + "\x01"
    if (rsaPrimeDistance(low, low) || rsaPrimeDistance(low, equalDistance) ||
        !rsaPrimeDistance(low, greaterDistance)) return 5
    0
}
