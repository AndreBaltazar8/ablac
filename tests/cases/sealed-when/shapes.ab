// A sealed hierarchy in its own module (every class and sub-interface of a sealed interface is declared here),
// used by main.ab from another module.
sealed interface Shape
interface Round : Shape
class Circle(val r: int) : Round
class Ring(val outer: int, val inner: int) : Round
class Square(val side: int) : Shape
class Rect(val w: int, val h: int) : Shape

sealed interface Res<T>
class Ok<T>(val value: T) : Res<T>
class Err<T>(val code: int) : Res<T>
