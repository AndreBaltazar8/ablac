// A `when` whose arms are all `is` over a sealed subject lowers its last arm without a test and has no
// non-exhaustive panic (tools/test-sealed-when.sh). Every shape of that last arm: a class, an interface
// covering two classes, a shared group, a statement whose arm leaves the loop, a generic instance; and a
// nullable subject with a `null` arm, which keeps every test. The same score at run time and at compile time.
import "abla/io"
import "shapes.ab"

fun area(s: Shape): int = when (s) {
    is Circle -> 3 * s.r * s.r
    is Ring -> 3 * (s.outer * s.outer - s.inner * s.inner)
    is Square -> s.side * s.side
    is Rect -> s.w * s.h
}

fun kind(s: Shape): int = when (s) {
    is Square -> 1
    is Rect -> 2
    is Round -> 3
}

fun sides(s: Shape): int = when (s) {
    is Circle, is Ring -> 0
    is Square, is Rect -> 4
}

fun firstSquare(shapes: array<Shape>): int {
    var rects = 0
    for (s in shapes) {
        when (s) {
            is Square -> return s.side * 10 + rects
            is Rect -> rects += 1
            is Round -> continue
        }
    }
    -1
}

fun unwrap(r: Res<int>): int = when (r) {
    is Ok<int> -> r.value
    is Err<int> -> -r.code
}

fun maybe(s: Shape?): int = when (s) {
    null -> -1
    is Round -> 1
    is Square -> 2
    is Rect -> 3
}

fun score(): int {
    val shapes: array<Shape> = [Circle(2), Ring(3, 1), Rect(2, 5), Square(4)]
    var total = 0
    for (s in shapes) total = total * 31 + area(s) * 7 + kind(s) * 3 + sides(s)
    total = total * 31 + firstSquare(shapes) + unwrap(Ok(5)) * 2 + unwrap(Err<int>(3))
    total * 31 + maybe(null) + maybe(Rect(1, 1)) * 5 + maybe(Ring(2, 1)) * 7
}

val atCompileTime = #score()

fun main(): int {
    val now = score()
    println("$now $atCompileTime")
    if (now == atCompileTime) 0 else 1
}
