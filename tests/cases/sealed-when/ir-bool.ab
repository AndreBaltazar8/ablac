// Three `when`s that keep the non-exhaustive panic share one message global (tools/test-sealed-when.sh).
@noinline
fun a(b: bool): int = when (b) {
    true -> 1
    false -> 2
}

@noinline
fun c(b: bool): int = when (b) {
    true -> 3
    false -> 4
}

@noinline
fun d(b: bool): int = when (b) {
    true -> 5
    false -> 6
}

fun main(): int = a(true) + c(false) + d(true) - 10
