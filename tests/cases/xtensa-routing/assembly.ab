import "../../../src/xtensa_assembly.ab"
import "abla/sys/linux"
import "abla/sys/linux/fs"

fun main: int {
    val source = Path(linuxArgument(0)).readText()
    val mode = linuxArgument(2)
    val result = if (mode == "module") {
        bootstrapXtensaAssemblyModule(bootstrapXtensaAlignedAssembly(source))
    } else bootstrapXtensaNarrowAssembly(source, mode == "keep" || mode == "keep-no-narrow",
        mode != "no-narrow" && mode != "keep-no-narrow")
    if (Path(linuxArgument(1)).writeText(result)) 0 else 1
}
