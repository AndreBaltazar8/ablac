import "abla/integer"

fun checks(): bool {
    "0".parseInt() == 0 && "-0".parseInt() == 0 &&
    "+00123".parseInt() == 123 && "-00012".parseInt() == -12 &&
    "9223372036854775807".parseInt() == 9223372036854775807 &&
    "9223372036854775806".parseInt() == 9223372036854775806 &&
    "-9223372036854775808".parseInt() == -9223372036854775807 - 1 &&
    "-9223372036854775807".parseInt() == -9223372036854775807 &&
    "9223372036854775808".parseInt() == null &&
    "-9223372036854775809".parseInt() == null &&
    "999999999999999999999999999999".parseInt() == null &&
    "".parseInt() == null && "+".parseInt() == null && "-".parseInt() == null &&
    " 1".parseInt() == null && "1 ".parseInt() == null && "\t1".parseInt() == null &&
    "1a".parseInt() == null && "١".parseInt() == null && "１２".parseInt() == null
}
compile fun staged(): bool = checks()
fun main: int = if (checks() && #staged()) 0 else 1
