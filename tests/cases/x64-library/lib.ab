import "abla/build"

// An x86-64 Linux shared library as a host process loads it (tools/test-x64-library.sh): global state, strings in
// and out, and enough allocation to exercise the library's own heap.
var calls = 40

@export("abla_app_next")
fun next(): int {
    calls = calls + 1
    calls
}

@export("abla_app_text")
fun text(count: int): string {
    var result = ""
    for (index in 0 until count) result = "$result${index % 10}"
    calls = calls + 1
    result
}

@export("abla_app_echo")
fun echo(value: string): string = "<$value>"

@export("abla_app_churn")
fun churn(rounds: int): int {
    var total = 0
    for (round in 0 until rounds) {
        val parts: array<string> = []
        for (index in 0 until 50) parts.append("part$index")
        for (part in parts) total = total + part.size
    }
    total
}
