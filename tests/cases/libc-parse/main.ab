// Copied by tools/test-libc-parse.sh to build/libc-parse/main.ab, beside strto.ab (src/static_libc/string.ab without its @export lines: the module cannot be imported by an
// ordinary program, its exported memcpy and friends clash with the runtime's own).
// The statically linked compiler's strtod, strtol, strtoll, strtoul and strtoull (src/static_libc/time.ab, string.ab) on the cases tests/cases/libc-parse/parse.c writes
// ("kind base hextext"), printed as that program prints the host C library's answers: "value end errno" (a double as its bits, a NaN as the quiet NaN, end as an offset).
// tools/test-libc-parse.sh compares the two.
import "abla/io"
import "abla/crypto"
import "abla/float"
import "abla/integer"
import "abla/text"
import "abla/runtime/scalar"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../../src/static_libc/errno.ab"
import "./strto.ab"
import "../../src/static_libc/time.ab"

fun number(text: string): int {
    val parsed = text.parseInt()
    if (parsed != null) parsed else 0
}

trusted fun run(kind: int, base: int, text: string): string {
    val buffer = nativeByteBuffer(text.size + 1)
    val address = nativePointerAddress(buffer.address)
    for (index in 0 until text.size) ablaRuntimeStoreU8(address + index, text[index])
    ablaRuntimeStoreU8(address + text.size, 0)
    val endCell = nativeByteBuffer(8)
    val endAddress = nativePointerAddress(endCell.address)
    ablaRuntimeStoreI64(endAddress, address)
    libcSetErrno(0)
    var line = ""
    if (kind == 100) {
        val value = libcStrtod(address, endAddress)
        var bits = f64ToBits(value)
        if (value != value) bits = 9221120237041090560
        val unsigned = if (bits < 0) u64(bits) else u64(bits)
        line = "$unsigned ${ablaRuntimeLoadI64(endAddress) - address} ${if (ablaRuntimeLoadI64(libcErrnoAddress()) == 34) 34 else 0}"
    } else {
        val value = if (kind == 108) libcStrtol(address, endAddress, base) else if (kind == 76) libcStrtoll(address, endAddress, base)
            else if (kind == 117) libcStrtoul(address, endAddress, base) else libcStrtoull(address, endAddress, base)
        line = "$value ${ablaRuntimeLoadI64(endAddress) - address} ${ablaRuntimeLoadI64(libcErrnoAddress())}"
    }
    endCell.close()
    buffer.close()
    line
}

fun main: int {
    var running = true
    while (running) {
        val input = readInputLine()
        if (!input.available) {
            running = false
        } else if (input.text.size > 0) {
            val fields = input.text.split(" ")
            val kind = fields[0][0]
            val hex = if (fields.size > 2) fields[2] else ""
            println(run(kind, number(fields[1]), hexDecode(hex)))
        }
    }
    return 0
}
