// The four hex digits of a \uXXXX escape: each digit position takes every byte value in turn, the other
// three being valid digits. A byte decodes iff it is 0-9, A-F or a-f (the bytes next to those ranges
// must not), and the decoded scalar is the one the digits spell, in its UTF-8 form.
import "abla/json"
import "abla/bytes"

private fun hexValue(byte: int): int {
    if (byte >= 48 && byte <= 57) return byte - 48
    if (byte >= 65 && byte <= 70) return byte - 55
    if (byte >= 97 && byte <= 102) return byte - 87
    -1
}

private fun expectedText(scalar: int): string {
    val out = byteBuffer()
    if (scalar < 128) {
        out.appendByteValue(scalar)
    } else if (scalar < 2048) {
        out.appendByteValue(192 | (scalar >> 6))
        out.appendByteValue(128 | (scalar & 63))
    } else {
        out.appendByteValue(224 | (scalar >> 12))
        out.appendByteValue(128 | ((scalar >> 6) & 63))
        out.appendByteValue(128 | (scalar & 63))
    }
    out.toText()
}

fun main: int {
    // The valid digits around the varied position: 0, 0, A, 1 (so no combination is a surrogate).
    val fixed = [48, 48, 65, 49]
    var bad = 0
    for (position in 0 until 4) {
        for (byte in 0 until 256) {
            val digits = [fixed[0], fixed[1], fixed[2], fixed[3]]
            digits[position] = byte
            val text = byteBuffer()
            text.appendText("\"\\u")
            for (digit in digits) text.appendByteValue(digit)
            text.appendText("\"")
            val parsed = jsonParse(text.toText())
            val first = hexValue(digits[0])
            val second = hexValue(digits[1])
            val third = hexValue(digits[2])
            val fourth = hexValue(digits[3])
            val valid = first >= 0 && second >= 0 && third >= 0 && fourth >= 0
            if (parsed.succeeded != valid) {
                bad = bad + 1
            } else if (valid) {
                val scalar = first * 4096 + second * 256 + third * 16 + fourth
                if (parsed.value.asString() != expectedText(scalar)) bad = bad + 1
            }
        }
    }
    if (bad == 0) 42 else 1
}
