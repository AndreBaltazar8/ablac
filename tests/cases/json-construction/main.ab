// café 😀: fixes use byte ranges, not character offsets.
import "abla/io"
import "abla/json"
import "abla/bytes"
import "abla/text"

fun safe(n: int, enabled: bool): string = "{\"n\":${n},\"enabled\":${enabled}}"
fun concatenated(n: int): string = "{\"n\":" + "${n}" + "}"
fun arrayValue(n: int): string = "[${n}]"
fun escaped(name: string): string = "{\"name\":${jsonStringify(jsonString(name))}}"
fun quoted(name: string): string = "{\"name\":\"${name}\"}"
fun pretty(n: int): string = "{ \"n\": ${n} }"
fun floating(n: f64): string = "{\"n\":${n}}"
fun shared(value: Json): string = "{\"value\":${jsonStringify(value)}}"
fun shadow(n: int, jsonStringify: (Json) -> string): string = "{\"n\":${n}}"
var calls = 0
fun next(): int { calls = calls + 1; calls }
fun effect(): string = "{\"n\":${next()}}"

fun writer(n: int): string {
    val out = byteBuffer()
    out.appendText("{\"n\":")
    out.appendInt(n)
    out.appendText("}")
    out.toText()
}
fun alias(n: int): int {
    val out = byteBuffer()
    out.appendText("{\"n\":")
    out.appendInt(n)
    out.appendText("}")
    val other = out
    other.size()
}
fun terminal(n: int) {
    val out = byteBuffer()
    out.appendText("{\"n\":")
    out.appendInt(n)
    out.appendText("}")
}
fun branch(n: int): string {
    val out = byteBuffer()
    if (n > 0) {
        out.appendText("{\"n\":")
        out.appendInt(n)
        out.appendText("}")
    }
    out.toText()
}
class OtherBuffer {
    fun appendText(text: string) { return }
}
fun unrelated() {
    val out = OtherBuffer()
    out.appendText("{\"n\":")
    out.appendText("1}")
}
fun data(): string = "{\"n\":1}"
fun expectedOutput(n: int): string {
    val expectedJson = "{\"n\":${n}}"
    expectedJson
}
fun parsed(n: int): bool = jsonParse("{\"n\":${n}}").succeeded
fun comparison(value: string, n: int): bool = value == "{\"n\":${n}}"
fun search(value: string, n: int): int = value.indexOf("{\"n\":${n}}")
fun html(n: int): string = "<script>var n={\"n\":${n}}</script>"

fun main {
    println(safe(-9223372036854775808, true))
    println(safe(9223372036854775807, false))
    println(concatenated(4))
    println(arrayValue(5))
    println(escaped("quote \" slash \\ café 😀"))
    println(escaped(byteEncode(255)))
    println(writer(9223372036854775807))
    println(effect())
    println(effect())
}
