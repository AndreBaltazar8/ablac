// A page's module that prints, reads both clocks, takes random bytes, makes a
// system call the browser host doesn't have, and exits: run.mjs gives it the
// abla_host imports and nothing else.
import "abla/io"
import "abla/process/exit"
import "abla/process/time"
import "abla/sys/linux"
import "abla/sys/linux/process"

@export("greet")
fun greet(): int {
    println("hello from the module")
    eprintln("and its standard error")
    0
}

@export("wall")
fun wall(): int = realtimeNanoseconds()

@export("monotonic")
fun monotonic(): int = monotonicNanoseconds()

@export("random")
fun random(): int = linuxRandomInteger(1000000007)

// getpid: no such call on the browser host (-ENOSYS)
@export("unsupported")
fun unsupported(): int = linuxProcessId()

@export("leave")
fun leave(code: int): int {
    exit(code)
}
