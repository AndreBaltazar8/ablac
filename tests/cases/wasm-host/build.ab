// host.ab as a release and a development WebAssembly module (the release
// module registers the target; the development module reuses it).
import "abla/wasm/build"

val release = #wasmBuildModule(
    "host",
    "tests/cases/wasm-host/host.ab",
    "build/wasm-host/host.wasm",
    false,
    false
)
val development = #buildProgram(
    "host-dev",
    "tests/cases/wasm-host/host.ab",
    "build/wasm-host/host-dev.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && development) 0 else 1
