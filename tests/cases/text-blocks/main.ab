import "abla/text"
import """abla/bytes""" as byteModule
import """
    abla/integer
    """

compile fun staged(): string = """compile \q $name"""
val stagedText = #staged()
val imports = """
    import "not-a-real-module"
    { "other": "import" }
    """

val nestedImport = "x${"""import "missing-raw-module" }"""}y"

fun main: int {
    if (byteModule.byteEncode(65) != "A") return 13
    val empty = """"""
    val oneLine = """one " and "" and \n $name ${missing} braces { }"""
    if (empty != "" || oneLine != "one \" and \"\" and \\n \$name \${missing} braces { }") return 1
    val block = """
        first
          second

        last
        """
    if (block != "first\n  second\n\nlast") return 2
    val trailing = """
      first

      """
    if (trailing != "first\n") return 3
    val blank = """
	  first
 	
	    next
	  """
    if (blank != "first\n\n  next") return 4
    val zero = """
first
  second
"""
    if (zero != "first\n  second") return 5
    val nested = "x${"""raw } { \q"""}y"
    if (nested != "xraw } { \\qy") return 6
    if (nestedImport != "ximport \"missing-raw-module\" }y") return 11
    val nestedBlock = "x${"""
        raw } { \q
        """
}y"
    if (nestedBlock != "xraw } { \\qy") return 10
    val quotes = """left""" + "\"\"\"" + """right"""
    if (quotes != "left\"\"\"right") return 7
    if (stagedText != "compile \\q \$name") return 8
    if (imports != "import \"not-a-real-module\"\n{ \"other\": \"import\" }") return 9
    42
}
