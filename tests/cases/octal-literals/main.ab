fun defaultMode(mode: int = 0o600): int = mode
fun check(): bool {
    val secret = 0o600
    val normal = 0o666
    val all = 0o7_77
    secret == 384 && normal == 438 && all == 511 && 0O644 == 420 &&
        0o1_000 == 512 && 0o0 == 0 && -0o10 == -8 &&
        (0o700 | 0o077) == 511 && 0xFF_FF == 65535 &&
        1_000_000 == 1000000 && 1.25e2 == 125.0 && defaultMode() == secret
}
compile fun staged(): bool = check()
fun main: int = if (check() && #staged()) 42 else 1
