// What threads may share: `val`s of scalars, strings and functions, a Mutex
// or Shared handle, the runtime's own globals (an allocation inside the
// thread) and the standard library's `@threadShared` values (abla/json's
// shared empties, float text's tables); a `task` runs on its starter's thread, so
// it may read anything.
import "abla/io"
import "abla/float/text"
import "abla/json"

resource class Counter(var value: int)

fun addTen(var counter: Counter): int {
    counter.value += 10
    counter.value
}

class Settings(val label: string)

val limit = 40
val greeting = "hello"
val double = { value: int -> value * 2 }
val counter = Mutex(Counter(0))
val settings = Settings("main only")

fun work(): int {
    val scratch = [1, 2, 3]
    val parsed = jsonParse("[1.5, \"two\", null]")
    val printed = f64Text(f64Parse(parsed.value.at(0).asNumber().text) * 1.0e1)
    double(limit / 2) + 2 + scratch.size - 3 + greeting.size - 5 +
        (if (parsed.succeeded && parsed.value.size() == 3 && printed == "15") 0 else 100)
}

fun main: int {
    val worker = thread { work() + counter.with(addTen) - 10 }
    val local = task { settings.label.size }
    val result = await worker
    val label = await local
    println("$result $label")
    if (result == 42 && label == 9) 42 else 1
}
