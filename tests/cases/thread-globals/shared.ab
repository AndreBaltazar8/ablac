// Globals a thread reaches, in its body or through what it calls, that other
// threads may change or alias: a class instance, an array, a `var` written by
// a function the thread calls, and a `var` read through a function value.
class Registry(var size: int)

val registry = Registry(0)
val table = [1, 2, 3]
var hits = 0
var seen = 0
val readSeen = { seen }

fun bump(): int {
    hits += 1
    hits
}

fun main: int {
    val worker = thread {
        registry.size + table[0] + bump() + readSeen()
    }
    await worker
}
