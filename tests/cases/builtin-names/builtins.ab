// Doesn't import names.ab: these are the built-ins.
resource class Ticket(val seat: int)

fun seatOf(var ticket: Ticket): int = ticket.seat

fun builtins(): int {
    val hits = Cell(0)
    hits.set(hits.get() + 1)
    val ages: Map<string, int> = Map()
    ages.set("ada", 36)
    val grid = filledArray(3, 2)
    val owner = Shared(Ticket(4))
    val moved = move(owner)
    val guarded = Mutex(Ticket(5))
    hits.get() + ages.size + grid.size + grid[0] + moved.get().seat + guarded.with(seatOf)
}
