// A program's own declarations named like built-ins.
class Cell(val value: int) {
    fun scaled(): int = this.value * 2
}

class Shared(val value: int) {
    fun scaled(): int = this.value * 3
}

class Mutex(val value: int) {
    fun scaled(): int = this.value * 4
}

class Map(val value: int) {
    fun scaled(): int = this.value * 5
}

fun filledArray(count: int, value: int): int = count * value

fun move(value: int): int = value + 1
