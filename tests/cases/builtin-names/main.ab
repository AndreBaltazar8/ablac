import "abla/io"
import "names.ab"
import "builtins.ab"

fun total(): int =
    Cell(1).scaled() + Shared(1).scaled() + Mutex(1).scaled() +
    Map(1).scaled() + filledArray(2, 3) + move(4)

fun main: int {
    val typed: Cell = Cell(5)
    val frozen = #total()
    println("${total()} $frozen ${typed.scaled()} ${builtins()}")
    total() + 17
}
