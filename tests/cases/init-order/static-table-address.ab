// A vtable whose method reads that vtable: the table holds the method's address,
// so its initializer runs nothing and this is no initialization cycle.
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/native"

val vtable = nativeStaticMutableU32s([
    7,
    int(u32(nativeFunctionAddress(firstWord)))
])
val words = nativeStaticU32s([vtable, nativeFunctionAddress(firstWord)])

trusted fun firstWord(): int = ablaUnsafeLoadU32(nativePointerFromAddress(vtable)) + offset

val offset = 1

fun main {
    println("${firstWord()}")
    println("${words != 0}")
}
