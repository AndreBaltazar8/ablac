import "abla/io"

// A global holding a function, called by name in another global's
// initializer: the call reads the global (and what its function reads), so
// both initialize first.

class Leaf(val v: int)
class Node(val leaf: Leaf)

fun makeLeaf(): Leaf = laterLeaf

val maker = makeLeaf
val typedMaker: () -> Leaf = makeLeaf
val node = Node(maker())
val typedNode = Node(typedMaker())
val laterLeaf = Leaf(7)

fun main {
    println("leaf ${node.leaf.v}")
    println("leaf ${typedNode.leaf.v}")
}
