import "abla/io"

// A parameter default runs when a call leaves its argument out, so the
// globals it reads initialize before a global whose initializer makes such
// a call: through a function, an extension function and a method. So do the
// globals an extension function's body reads, called as `x.f()`.

class Leaf(val v: int) {
    fun scaled(factor: int = laterFactor): int = v * factor
}

fun withDefault(leaf: Leaf = laterLeaf): int = leaf.v
fun Leaf.plus(extra: int = laterFactor): int = v + extra
fun Leaf.plusLater(): int = v + laterFactor

val fromFunction = withDefault()
val fromExtension = Leaf(1).plus()
val fromMethod = Leaf(2).scaled()
val fromExtensionBody = Leaf(3).plusLater()
val laterLeaf = Leaf(7)
val laterFactor = seven()

fun seven(): int = 7

fun main {
    println("$fromFunction $fromExtension $fromMethod $fromExtensionBody")
}
