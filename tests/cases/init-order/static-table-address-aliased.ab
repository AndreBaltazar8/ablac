// A qualified address remains a relocation, not a call into the function
// which reads this table. The static-table wrapper is deliberately unaliased.
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "abla/unsafe/native/function-address" as addressApi

val aliasedVtable = nativeStaticMutableU32s([
    7,
    int(u32(addressApi.nativeFunctionAddress(aliasedFirstWord)))
])

trusted fun aliasedFirstWord(): int =
    ablaUnsafeLoadU32(nativePointerFromAddress(aliasedVtable)) + 1

fun main {
    println("${aliasedFirstWord()}")
}
