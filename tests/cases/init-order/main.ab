import "abla/io"
import "other.ab"
// Globals initialize in dependency order (through functions, methods and other
// modules), the earliest declared first among those ready.
fun note(name: string, n: int): int { println("init $name"); n + 1 }
val first: int = note("first", second)
val second: int = note("second", 0)
val third: int = note("third", 0)
val fourth: int = viaFun()
fun viaFun(): int = note("fourth", fifth)
val fifth: int = note("fifth", 10)
class Scale(val k: int) {
    fun apply(n: int): int = n * k * factor
}
val sixth: int = note("sixth", Scale(2).apply(1))
val factor: int = note("factor", 2)
val seventh: int = note("seventh", fromOther + 1)
val eighth = run({ -> note("eighth", ninth) })
val ninth = note("ninth", 5)
fun run(f: () -> int): int = f()
// Pure ones, read under `#` too.
val pa: int = pb * 2
val pb: int = pc()
fun pc(): int = pd + 1
val pd: int = 20
fun main {
    println("$first $second $third $fourth $fifth $sixth $factor $seventh $eighth $ninth")
    println("$pa $pb ${#pa} ${#pb} ${#fromOther}")
}
