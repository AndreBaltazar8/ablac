var trace = 0
fun mark(n: int): int { trace = trace * 10 + n; n - 1 }
resource class Ticket(val n: int)
class Holder(val handle: Shared<Ticket>)
fun view(owner: Shared<Ticket>, extra: int): borrow(owner) Ticket = owner.get()
fun main: int {
    val owners = [Shared(Ticket(42))]
    val saved = view(owner = owners[mark(1)], extra = mark(2))
    val holders = [Holder(Shared(Ticket(43)))]
    val nested = view(owner = holders[mark(1)].handle, extra = mark(2))
    if (trace == 1212 && saved.n == 42 && nested.n == 43) 0 else 1
}
