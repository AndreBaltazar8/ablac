resource class Ticket(val n: int)
fun view(owner: Shared<Ticket>, extra: int): borrow(owner) Ticket = owner.get()
fun consume(own owner: Shared<Ticket>): int = owner.get().n
fun main: int {
    val owner = Shared(Ticket(42))
    val saved = view(owner = owner, extra = consume(move(owner)))
    saved.n
}
