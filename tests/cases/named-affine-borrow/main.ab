resource class Ticket(val n: int)
fun view(owner: Shared<Ticket>, extra: int = 0): borrow(owner) Ticket = owner.get()
fun <T> inspect(owner: Shared<T>, extra: int = 0): int = extra
fun <T> generic(value: T, extra: int): int = extra
fun consume(own owner: Shared<Ticket>): int = owner.get().n
fun main: int {
    val owner = Shared(Ticket(42))
    val saved = view(owner = owner)
    val observed = saved.n + view(owner = owner, extra = 1).n + inspect<Ticket>(owner = owner, extra = 2) +
        generic<Shared<Ticket>>(value = owner, extra = 3)
    val taken = consume(move(owner))
    if (observed == 89 && taken == 42) 0 else 1
}
