// A lambda's result type comes from the expected function type: an integer literal that fits (alone, at the end of a block,
// in an if or a when) is the narrower integer the function type asks for, as it is for an argument or a result. Any int value
// is still integer.narrowing (tools/test-integer-narrowing-stores.sh).
import "abla/io"

fun take(f: (int) -> u32): u32 = f(1)
fun takeBlock(f: (int) -> u32): u32 = f(2)
fun takeSmall(f: (int) -> i16): i16 = f(-1)
fun <T, R> apply(value: T, f: (T) -> R): R = f(value)
fun make(): (int) -> u8 = { x -> if (x > 0) 5 else 6 }

fun main: int {
    val declared: (int) -> u32 = { x -> 9 }
    val list: array<(int) -> u8> = [{ x -> 1 }, { x -> 200 }]
    val generic: u8 = apply(3, { x -> 1 })
    println("${take({ x -> 0 })} ${takeBlock({ x ->
        val y = x + 1
        7
    })} ${takeSmall({ x -> when (x) {
        -1 -> -3
        else -> 4
    } })} ${declared(0)} ${make()(1)} ${list[1](0)} ${generic}")
    0
}
