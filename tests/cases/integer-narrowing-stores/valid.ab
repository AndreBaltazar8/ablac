// A literal that fits, and an explicit conversion, need no ceremony in any place a narrower integer is stored:
// a local, an assignment, a field, an element, an array literal, a result. tools/test-integer-narrowing-stores.sh
// checks that anything else there is integer.narrowing, as it already is for an argument.
import "abla/io"

class Box(var value: u8)

fun result(): u8 = 255
fun statement(): i8 {
    return -128
}
fun converted(value: int): u8 = u8(value)

fun main: int {
    val a: u8 = 255
    val b: i8 = -128
    var c: u32 = 4294967295
    c = 0
    val wide = 300
    val d: u8 = u8(wide)
    val e: i16 = if (wide > 5) 32767 else -32768
    val items: array<u8> = [0, 255]
    var more: array<u8> = [1]
    more[0] = 200
    val box = Box(1)
    box.value = 255
    val letter: char = 65
    val filled: array<u8> = []
    filled.append(255)
    filled.append(u8(wide))
    val table: Map<string, u8> = Map()
    table.set("k", 200)
    table.set("j", u8(wide))
    val cell = Cell(u8(1))
    cell.set(255)
    cell.set(u8(wide))
    println("$a $b $c $d $e ${items[1]} ${more[0]} ${box.value} $letter ${result()} ${statement()} ${converted(300)} ${filled[0]} ${filled[1]} ${table.size} ${cell.get()}")
    0
}
