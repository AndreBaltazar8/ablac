// A strict library whose type parameters are named like classes of the flat
// program that imports it: a type parameter in scope wins over every
// module-level name, before the strict-visibility check.
class Box<T>(var v: T) {
    fun get(): T = v
    fun <U> mapTo(f: (T) -> U): Box<U> = Box(f(v))
}

fun <T> first(items: array<T>): T = items[0]

fun <A, B> pair(a: A, b: B): Pair2<A, B> = Pair2(a, b)

class Pair2<A, B>(val left: A, val right: B)

fun <U> rewrap(box: Box<Box<U>>): Box<U> = Box(box.get().get())

// A type parameter named like a standard-library type.
class Holder<Path>(val value: Path)
