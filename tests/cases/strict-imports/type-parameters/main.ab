import "abla/io"
import "./lib/lib.ab"

class T(val n: int)
class U(val n: int)
class A(val n: int)
class B(val n: int)
class Path(val n: int)

fun main: int {
    val box = Box(3)
    val doubled = box.mapTo { x -> x * 2 }
    val nested = rewrap(Box(Box(5)))
    val both = pair(7, 8)
    val held = Holder(9)
    println("${box.get()} ${doubled.get()} ${nested.get()} ${first([4, 5])} ${both.left + both.right} ${held.value}")
    val t = T(1)
    val u = U(2)
    val a = A(3)
    val b = B(4)
    val p = Path(5)
    println("${t.n + u.n + a.n + b.n + p.n}")
    42
}
