import "abla/io"
import "./facade.ab"

// Strict: names from facade.ab, the shapes.ab it re-exports, and what the
// (flat) standard library reaches. `area` is also a named argument here.
fun scaled(area: int, by: int): int = area * by

fun main: int {
    val square = Square(3)
    println("${area(2)} ${square.doubled()} ${facadeValue()} ${scaled(area = UNIT, by = 5)}")
    42
}
