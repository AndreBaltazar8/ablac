import "abla/compiler/parser"

// `$markup <text> {expression}`: the text up to `{` is markup, a string the program never names; the expression in
// braces is Abla code, the value. The text may span lines, as abla-mvc's `$mvcview` does.
compile fun markupParse(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawTakeUntil(cursor, "{")
    parserRawExpect(cursor, "{")
    val value = parserParseAblaExpression(cursor)
    parserRawExpect(cursor, "}")
    value
}

#compilerRegisterSubparser("markup", markupParse)
