// Built-in types inside generic arguments and a function type, in a strict
// module that doesn't import the program's value named `any`.
fun boxes(): array<any> = [1, 2]

fun table(): Map<string, any> {
    val result: Map<string, any> = Map()
    result.set("a", 1)
    result
}

fun apply(function: (any) -> int): int = function(4)
