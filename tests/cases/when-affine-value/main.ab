import "abla/io"
var log = ""
resource class Item(val id: int) {
    fun drop(): void { log = log + "I$id" }
}
fun choose(flag: bool): void {
    val held = Item(1)
    when (held) {
        (if (flag) Item(2) else held) -> log = log + "M"
        else -> log = log + "N"
    }
    log = log + "|"
}
fun exercise(): string {
    log = ""
    if (true) {
        val held = Item(1)
        when (held) {
            Item(2) -> log = log + "M"
            else -> log = log + "N"
        }
        log = log + "|"
    }
    choose(true)
    choose(false)
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
