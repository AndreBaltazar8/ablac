import "abla/bytes"
import "abla/io"

// String equality at every length from 0 to 41 and every position of a single differing byte (the word
// loop, the overlapping last word, the half-word cases and the byte tail), as map keys and with `==`.
// Two strings built separately never share bytes.
@noinline fun idInt(x: int): int = x
@noinline fun idText(x: string): string = x

fun build(length: int, differ: int): string = buildFrom(0, length, differ)

// The bytes at positions start .. start + length of one endless sequence (a differing byte is `differ`
// counted from the start of the result).
fun buildFrom(start: int, length: int, differ: int): string {
    var text = ""
    var i = 0
    while (i < length) {
        var byte = 65 + ((start + i) * 7 + 3) % 50
        if (i == differ) byte = byte + 1
        text = text + byteEncode(byte)
        i = i + 1
    }
    text
}

fun main: int {
    var bad = 0
    var length = 0
    while (length <= 41) {
        val a = build(idInt(length), -1)
        val b = build(idInt(length), -1)
        if (a != b || !(a == b) || a.size != length) bad = bad + 1
        val map: Map<string, int> = Map()
        map.set(a, length)
        if (map.get(b) != length) bad = bad + 1
        var position = 0
        while (position < length) {
            val c = build(idInt(length), position)
            if (a == c || !(a != c)) bad = bad + 1
            if (map.get(c) != null) bad = bad + 1
            position = position + 1
        }
        // The same bytes at every alignment: a slice of a longer string starting at offsets 0..7 against
        // the string built apart, and a different byte in the slice against it.
        var offset = 0
        while (offset < 8) {
            val padded = buildFrom(0, idInt(offset + length + 3), -1)
            val sliced = padded.slice(offset, offset + length)
            val expected = buildFrom(offset, idInt(length), -1)
            if (sliced != expected || !(sliced == expected)) bad = bad + 1
            if (length > 0) {
                val tail = buildFrom(offset, idInt(length), length - 1)
                if (sliced == tail || !(sliced != tail)) bad = bad + 1
            }
            offset = offset + 1
        }
        length = length + 1
    }
    // A rope (a concatenation) against a flat literal of the same bytes, and against a one-byte-off rope.
    val left = "ABCDEFG" + idText("HIJKLMNO")
    if (left != "ABCDEFGHIJKLMNO" || !(left == "ABCDEFGHIJKLMNO")) bad = bad + 1
    if (left == "ABCDEFGHIJKLMNP" || left == "ABCDEFGHIJKLMN") bad = bad + 1
    println("bad $bad")
    if (bad == 0) 42 else 1
}
