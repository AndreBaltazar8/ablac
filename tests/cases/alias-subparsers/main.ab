// Every standard-library subparser whose module is imported under an alias: its expansion names the module's own helpers (ablaJsonObject, ablaXmlLiteralElement, ...)
// unqualified, and under an alias those helpers carry the module's prefix. The program exits 0 when all of them expand and run.
import "abla/bytes" as bytes
import "abla/json" as jsonProvider
import "abla/regex" as rx
import "abla/sql" as sqlProvider
import "abla/xml" as xmlProvider
import "abla/html" as htmlProvider

fun main: int {
    val count = 3
    val text = jsonProvider.jsonStringify($json {"text": "x", "n": count})
    if (text != "{\"text\":\"x\",\"n\":3}") return 1
    val plain = $jsons {"a": [1, 2]}
    if (plain != "{\"a\":[1,2]}") return 2
    val buffer = bytes.byteBuffer()
    $jsonw(buffer) {"k": count}
    if (buffer.toText() != "{\"k\":3}") return 3
    val date = $regex("(?<year>\\d{4})-(?<month>\\d{2})")
    val found = date.matchFull("2026-11") ?? return 4
    if (found.year != "2026") return 5
    val query = $sql("SELECT ${count}::integer")
    if (query.parameters.size != 1) return 6
    val node = $xml <item id={count}>hello</item>
    if (node.attributeValue("id") != "3") return 7
    val page = $html <p>{count}</p>
    if (page.tag != "p") return 8
    0
}
