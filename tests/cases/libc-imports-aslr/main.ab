// Prints the address of one of its own functions, to show that a libc-free executable is
// position independent and its image moves from run to run (tools/test-libc-imports.sh).
import "abla/io"
import "abla/unsafe/native"

trusted fun marker(): int = 1

fun main: int {
    println("${nativeFunctionAddress(marker)}")
    0
}
