import "abla/io"

// tools/test-wasm-devtools.sh breaks at `val text` (line 13) in the browser and steps over it.
class Point(val x: int, val y: int) {
    fun norm1(): int = x + y
}

fun describe(p: Point, label: string): string {
    val total = p.norm1()
    val ratio = 1.5 * 2.5
    val items = [p.x, p.y, total * 10]
    val maybe: Point? = if (total > 3) p else null
    val text = "$label=$total"
    return text
}

fun main: int {
    val p = Point(2, 3)
    val apply = { q: Point -> describe(q, "pt") }
    val out = apply(p)
    println(out)
    0
}
