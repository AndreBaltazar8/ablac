    // exact and special values
    check("log2", libcCrLog2(8.0), f64ToBits(3.0), f64ToBits(8.0))
    check("log2", libcCrLog2(0.25), f64ToBits(-2.0), f64ToBits(0.25))
    check("log10", libcCrLog10(1000.0), f64ToBits(3.0), f64ToBits(1000.0))
    check("log10", libcCrLog10(1.0e-5), f64ToBits(-5.0), f64ToBits(1.0e-5))
    check("expm1", libcCrExpm1(0.0), f64ToBits(0.0), f64ToBits(0.0))
    check("log1p", libcCrLog1p(-1.0), f64ToBits(-1.0 / 0.0), f64ToBits(-1.0))
    check("asin", libcCrAsin(1.0), f64ToBits(1.5707963267948966), f64ToBits(1.0))
    check("acos", libcCrAcos(1.0), f64ToBits(0.0), f64ToBits(1.0))
    check("acos", libcCrAcos(-1.0), f64ToBits(3.141592653589793), f64ToBits(-1.0))
    check("erf", libcCrErf(10.0), f64ToBits(1.0), f64ToBits(10.0))
    check("erfc", libcCrErfc(30.0), f64ToBits(0.0), f64ToBits(30.0))
    check("tanh", libcCrTanh(30.0), f64ToBits(1.0), f64ToBits(30.0))
    check("cosh", libcCrCosh(0.0), f64ToBits(1.0), f64ToBits(0.0))
    if (failures == 0) {
        println("libc correct rounding: ok")
        return 42
    }
    println("libc correct rounding: $failures failures")
    1
}
