// The correctly rounded libm functions of the statically linked compiler's C library (src/static_libc/crmath.ab, #1045), called as the ordinary
// functions they are: every result must be the bit pattern of the double nearest to the exact value. The vectors (argument bits, result bits) were
// computed with MPFR at 53 bits (tools/libm-oracle.c `gen`), spread over each function's interesting ranges, plus exact and special values.
// tools/test-static-libm.sh compares many more arguments against MPFR. The program exits 42.
import "abla/io"
import "abla/float"
import "abla/float/text"
import "../../../src/static_libc/crmath.ab"

var failures = 0

fun check(name: string, got: f64, wantBits: int, xBits: int) {
    val want = f64FromBits(wantBits)
    if (got != got && want != want) return
    if (f64ToBits(got) != wantBits) {
        failures += 1
        println("$name(${f64FromBits(xBits)}): got bits ${f64ToBits(got)}, wanted $wantBits")
    }
}

fun main: int {
