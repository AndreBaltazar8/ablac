import "abla/io"
import "abla/memory"
import "abla/unsafe/memory"

// Explicit closes keep payload low, but a long series of native buffers
// still needs to reach the automatic collector's allocation threshold.
fun main: int {
    var peak = 0
    for (index in 0 until 160) {
        val buffer = nativeByteBuffer(131072)
        if (!buffer.store(0, index) || buffer.load(0) != index) return 1
        val live = memoryLiveBytes()
        if (live > peak) peak = live
        buffer.close()
    }
    val collected = memoryHeapStat(5) + memoryHeapStat(6) > 0
    println("native pressure $collected small payload ${peak < 1048576}")
    0
}
