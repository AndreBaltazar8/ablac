import "abla/io"
import "abla/memory"
import "abla/runtime/self"

class Item(val value: int, val other: int)

@noinline
fun burst(): int {
    val items: array<Item> = []
    for (index in 0 until 500000) { items.append(Item(index, index)) }
    items[items.size - 1].value
}

trusted fun main: int {
    if (!__ablaRuntimeHostHeapNative()) {
        println("trim unavailable")
        return 0
    }
    if (burst() != 499999) return 1
    val before = __ablaRuntimeHostHeapStat(0)
    memoryCollect()
    val after = __ablaRuntimeHostHeapStat(0)
    println("trim ${before >= 16777216 && after <= before / 2}")
    0
}
