import "abla/io"
import "abla/memory"

// One round's garbage, made in a function of its own: a collection may run where
// it starts (and in main's loop, on its back edge).
fun churn(round: int, kept: array<string>): int {
    val text = "garbage-$round-${kept[round % 1000]}-padding-to-make-it-longer"
    text.size
}

// A small live heap and much garbage: the peak of the tracked heap shows how far
// it grows between collections (ABLA_GC_GROWTH sets the step), and the kept
// strings must survive every collection.
fun main: int {
    val kept: array<string> = []
    for (index in 0 until 1000) kept.append("kept-$index")
    var peak = 0
    var total = 0
    for (round in 0 until 1000000) {
        total = total + churn(round, kept)
        val live = memoryLiveBytes()
        if (live > peak) peak = live
    }
    var check = 0
    for (text in kept) check = check + text.size
    println("total $total kept $check small ${peak < 8388608}")
    0
}
