// aesGcmSealRandom, chaCha20Poly1305SealRandom and their Open: a fresh nonce each call, nonce || ciphertext || tag, refusals, and a failure (no box) with no random source.
import "abla/io"
import "abla/crypto"
import "abla/crypto/aes"
import "abla/crypto/chacha20poly1305"
import "abla/crypto/rsa"

fun main: int {
    val key = hexDecode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    val g1 = aesGcmSealRandom(key, "message", "ctx")
    val g2 = aesGcmSealRandom(key, "message", "ctx")
    if (!g1.ok || g1.bytes.size != 12 + 7 + 16 || g1.bytes == g2.bytes) { println("FAIL gcm seal"); return 1 }
    if (aesGcmOpenRandom(key, g1.bytes, "ctx").bytes != "message") { println("FAIL gcm open"); return 1 }
    if (aesGcmOpenRandom(key, g1.bytes, "other").ok || aesGcmOpenRandom(key, "short").ok) { println("FAIL gcm refuse"); return 1 }
    val c1 = chaCha20Poly1305SealRandom(key, "message", "ctx")
    val c2 = chaCha20Poly1305SealRandom(key, "message", "ctx")
    if (!c1.ok || c1.bytes.size != 12 + 7 + 16 || c1.bytes == c2.bytes) { println("FAIL chacha seal"); return 1 }
    if (chaCha20Poly1305OpenRandom(key, c1.bytes, "ctx").bytes != "message") { println("FAIL chacha open"); return 1 }
    if (chaCha20Poly1305OpenRandom(key, c1.bytes, "other").ok || chaCha20Poly1305OpenRandom(key, "").ok) { println("FAIL chacha refuse"); return 1 }
    // the nonce is the first 12 bytes and the rest is the plain AEAD under it
    if (aesGcmDecrypt(key, g1.bytes.slice(0, 12), g1.bytes.slice(12, g1.bytes.size), "ctx").bytes != "message") { println("FAIL gcm layout"); return 1 }
    // no random source: a failure, no box
    cryptoSetRandom({ count: int -> "" })
    if (aesGcmSealRandom(key, "m").ok || chaCha20Poly1305SealRandom(key, "m").ok) { println("FAIL no-random"); return 1 }
    if (aesGcmSealRandom("short", "m").ok) { println("FAIL bad key"); return 1 }
    println("aead random ok")
    0
}
