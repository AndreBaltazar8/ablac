// The known answers as an AArch64 Linux object (see ../simd/aarch64-build.ab).
import "abla/build"
import "abla/compiler"

#compilerGrant("filesystem.write")

compile fun cryptoAarch64Object(): bool {
    val target = defineTarget("linux-arm64-object", "aarch64-unknown-linux-gnu", "elf", "none", "none", false, false)
    target && buildProgram(
        "crypto-aarch64", "tests/cases/crypto-pure/object.ab", "build/crypto-pure/aarch64.o", "linux-arm64-object",
        "object", false, false
    )
}

val built = #cryptoAarch64Object()

fun main: int = if (built) 0 else 1
