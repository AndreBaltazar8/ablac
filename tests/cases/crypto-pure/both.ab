// Two modules, one on each RSA, with no aliases: what a package on one and a program on the other come to.
import "abla/fs"
import "abla/process/arguments"
import "both-hosted.ab"
import "both-pure.ab"

fun main: int {
    val pem = Path(processArgument(0)).readText()
    val hosted = signsHosted(pem, "both")
    if (hosted == "" || hosted != signsPure(pem, "both")) 1 else 0
}
