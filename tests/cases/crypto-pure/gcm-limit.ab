// AES-GCM's length limit (#1139 area 5, round 4; NIST SP 800-38D 5.2.1.1): at most 2^36 - 32 bytes of text under one nonce, or the 32-bit block
// counter wraps onto the block that masks the tag. The limit is aesGcmLengthValid in the library's internal aes/raw.ab (built with
// --stdlib-internals); a test cannot make a 64 GiB string, so this checks the limit at its boundary, and tools/test-crypto-pure.sh checks that
// every AES-GCM entry point calls it. Short texts still seal and open. Prints "gcm limit ok".
import "abla/io"
import "abla/text"
import "abla/crypto/aes"
import "abla/crypto/aes/raw.ab"

fun main: int {
    var failures = 0
    val accepted = [0, 1, 16, 68719476704 - 1, 68719476704]
    val refused = [68719476704 + 1, 68719476736, 9223372036854775807, -1]
    for (size in accepted) {
        if (!aesGcmLengthValid(size)) {
            println("FAIL a text of $size bytes is refused")
            failures = failures + 1
        }
    }
    for (size in refused) {
        if (aesGcmLengthValid(size)) {
            println("FAIL a text of $size bytes is accepted (the block counter wraps past 68719476704)")
            failures = failures + 1
        }
    }
    val key = "k".repeat(32)
    val nonce = "n".repeat(12)
    val sealed = aesGcmEncrypt(key, nonce, "hello", "ad")
    val opened = aesGcmDecrypt(key, nonce, sealed.bytes, "ad")
    if (!sealed.ok || !opened.ok || opened.bytes != "hello") {
        println("FAIL a short text no longer seals and opens: ${sealed.error} ${opened.error}")
        failures = failures + 1
    }
    if (failures == 0) println("gcm limit ok")
    if (failures == 0) 0 else 1
}
