// Wycheproof sets for the hash variants the other programs (wycheproof-tls, wycheproof-more) do not run (tests/vectors/crypto/wycheproof, JSON as
// published, C2SP/wycheproof testvectors_v1 at 65ca494727a52944c204441c860b039e6786b99b): HMAC with SHA-1, SHA-512 and SHA-3 (224 to 512: this
// program builds the HMAC over abla/crypto/sha3, which tests Keccak at every rate), HKDF with SHA-1 and SHA-512, ECDSA over P-256 and P-384 with
// SHA-3 and SHAKE digests, RSA-OAEP decryption with other hashes (SHA-1, SHA-256, SHA-384, SHA-512 and the rsa_oaep_misc sets) and RSASSA-PSS
// verification with other hashes, other salt lengths and other MGF1 hashes (and the "params" sets, whose keys carry the PSS parameters).
// The library offers a smaller set than Wycheproof has: OAEP and PSS take one hash for the message and for MGF1 (SHA-1 only for OAEP, legacy),
// PSS takes SHA-256, SHA-384 and SHA-512, keys under 2048 bits are refused, and there is no SHA-224, SHA-512/t, SM3, KMAC or SHAKE-based PSS.
// What it does not offer must fail closed: a case it cannot take is counted as "unsupported" (a valid case refused) and must never be accepted
// when invalid, nor decrypt to anything but the message. Usage: wycheproof-hashes VECTORS_DIRECTORY
import "abla/crypto"
import "abla/crypto/hkdf"
import "abla/crypto/p256"
import "abla/crypto/p384"
import "abla/crypto/rsa"
import "abla/crypto/rsapss"
import "abla/crypto/sha3"
import "abla/io"
import "abla/json"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/text"

var failures = 0
var unsupported = 0

fun fail(file: string, id: int, why: string): void {
    failures = failures + 1
    if (failures < 60) println("FAIL $file #$id: $why")
    return
}

fun load(directory: string, name: string): Json? {
    val parsed = jsonParse(linuxReadFile("$directory/wycheproof/$name.json", 33554432), jsonPermissiveLimits)
    if (!parsed.succeeded) {
        fail(name, 0, "the JSON did not parse: ${parsed.error.message}")
        return null
    }
    parsed.value
}

// ---- hashes ----
fun sha3Of(rate: int, size: int, input: string): string {
    val state = keccakSha3(rate)
    state.absorb(input)
    val out = state.squeeze(size)
    state.close()
    out
}

/** The digest `name` ("SHA-256", "SHA3-384", "SHAKE128", ...) of `message`, or "" for one the library does not have. */
fun digest(name: string, message: string): string =
    if (name == "SHA-1") sha1(message)
    else if (name == "SHA-256") sha256(message)
    else if (name == "SHA-384") sha384(message)
    else if (name == "SHA-512") sha512(message)
    else if (name == "SHA3-224") sha3Of(144, 28, message)
    else if (name == "SHA3-256") sha3Of(136, 32, message)
    else if (name == "SHA3-384") sha3Of(104, 48, message)
    else if (name == "SHA3-512") sha3Of(72, 64, message)
    // Wycheproof's ECDSA with SHAKE signs the digest of 256 bits (SHAKE128) and of 512 bits (SHAKE256).
    else if (name == "SHAKE128") shake128(message, 32)
    else if (name == "SHAKE256") shake256(message, 64)
    else ""

fun hashSize(name: string): int =
    if (name == "SHA-1") 20 else if (name == "SHA-256") 32 else if (name == "SHA-384") 48 else if (name == "SHA-512") 64 else 0

fun xorWith(text: string, byte: int): string {
    var out = ""
    for (i in 0 until text.size) out = out + cryptoByteString([int(text[i]) ^ byte])
    out
}

/** HMAC (RFC 2104) over the digest `name`, whose block is `block` bytes. */
fun hmacOver(name: string, block: int, key: string, message: string): string {
    var k = key
    if (k.size > block) k = digest(name, k)
    k = k + "\x00".repeat(block - k.size)
    digest(name, xorWith(k, 92) + digest(name, xorWith(k, 54) + message))
}

// ---- HMAC and HKDF ----
fun hmacFile(directory: string, name: string, hash: string, block: int): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var valid = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val tagBytes = group.getInt("tagSize") / 8
        val tests = group.get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val key = hexDecode(t.getString("key"))
            val message = hexDecode(t.getString("msg"))
            var full = ""
            if (hash == "SHA-1") full = hmacSha1(key, message)
            else if (hash == "SHA-512") full = hmacSha512(key, message)
            else full = hmacOver(hash, block, key, message)
            val tag = full.slice(0, tagBytes)
            count = count + 1
            if (result == "valid") {
                if (tag != hexDecode(t.getString("tag"))) fail(name, id, "a valid tag differs: ${t.getString("comment")}")
                else valid = valid + 1
            } else if (result == "invalid" && tag == hexDecode(t.getString("tag"))) fail(name, id, "an invalid tag matched: ${t.getString("comment")}")
        }
    }
    println("$name.json: $count cases, $valid valid")
    return
}

/** HMAC of the library against hmacOver (written here over the digests) for keys around the block size, where the key is hashed or padded:
 *  Wycheproof has no key of exactly a block, or of a block less one or more. */
fun hmacBoundaries(): void {
    var count = 0
    val hashes = ["SHA-1", "SHA-256", "SHA-384", "SHA-512"]
    val blocks = [64, 64, 128, 128]
    for (which in 0 until 4) {
        val hash = hashes[which]
        val block = blocks[which]
        for (keySize in [0, 1, block - 2, block - 1, block, block + 1, block + 2, 2 * block - 1, 2 * block, 2 * block + 1]) {
            val key = "k".repeat(keySize)
            for (messageSize in [0, 1, block - 1, block, block + 1, 3 * block + 5]) {
                val message = "m".repeat(messageSize)
                val got = if (hash == "SHA-1") hmacSha1(key, message) else if (hash == "SHA-256") hmacSha256(key, message)
                    else if (hash == "SHA-384") hmacSha384(key, message) else hmacSha512(key, message)
                count = count + 1
                if (got != hmacOver(hash, block, key, message)) fail("hmac-boundaries", count, "$hash with a key of $keySize bytes and a message of $messageSize differs")
            }
        }
    }
    println("hmac boundaries: $count cases")
    return
}

fun hkdfFile(directory: string, name: string, hash: int): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var valid = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val tests = groups.at(g).get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val out = hkdf(hash, hexDecode(t.getString("salt")), hexDecode(t.getString("ikm")), hexDecode(t.getString("info")), t.getInt("size"))
            count = count + 1
            if (result == "valid") {
                if (!out.ok || out.bytes != hexDecode(t.getString("okm"))) fail(name, id, "a valid case failed or differs: ${t.getString("comment")}")
                else valid = valid + 1
            } else if (result == "invalid" && out.ok && out.bytes == hexDecode(t.getString("okm"))) fail(name, id, "an invalid case succeeded: ${t.getString("comment")}")
        }
    }
    println("$name.json: $count cases, $valid valid")
    return
}

// ---- ECDSA with SHA-3 and SHAKE digests ----
fun ecdsaFile(directory: string, name: string, curve: int, p1363: bool): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var accepted = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val key = hexDecode(group.get("publicKey").getString("uncompressed"))
        val hash = group.getString("sha")
        val tests = group.get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val d = digest(hash, hexDecode(t.getString("msg")))
            val signature = hexDecode(t.getString("sig"))
            var raw = signature
            if (!p1363) raw = if (curve == 256) p256SignatureFromDer(signature) else p384SignatureFromDer(signature)
            var ok = false
            if (d != "" && raw != "") ok = if (curve == 256) p256EcdsaVerifyDigestRaw(key, d, raw) else p384EcdsaVerifyDigestRaw(key, d, raw)
            count = count + 1
            if (ok) accepted = accepted + 1
            if (result == "valid" && !ok) fail(name, id, "a valid signature was refused ($hash): ${t.getString("comment")}")
            else if (result == "invalid" && ok) fail(name, id, "an invalid signature was accepted ($hash): ${t.getString("comment")}")
        }
    }
    println("$name.json: $count cases, $accepted accepted")
    return
}

// ---- RSA-OAEP decryption ----
fun oaepHash(sha: string): (string) -> string {
    val withSha1: (string) -> string = { data: string -> sha1(data) }
    val withSha256: (string) -> string = { data: string -> sha256(data) }
    val withSha384: (string) -> string = { data: string -> sha384(data) }
    val withSha512: (string) -> string = { data: string -> sha512(data) }
    if (sha == "SHA-1") return withSha1
    if (sha == "SHA-256") return withSha256
    if (sha == "SHA-384") return withSha384
    withSha512
}

fun oaepFile(directory: string, name: string): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var valid = 0
    var refusedKeys = 0
    var unsupportedHere = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val sha = group.getString("sha")
        val mgfSha = group.getString("mgfSha")
        val keySize = group.getInt("keySize")
        val key = rsaPrivateKeyFromPem(group.getString("privateKeyPem"))
        val tests = group.get("tests")
        if (!key.ok()) {
            // Keys under 2048 bits are refused by policy; a larger key must load.
            if (keySize >= 2048) fail(name, 0, "a key of $keySize bits did not load: ${key.error}")
            refusedKeys = refusedKeys + tests.size()
            continue
        }
        val supported = sha == mgfSha && hashSize(sha) > 0
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val message = hexDecode(t.getString("msg"))
            val ciphertext = hexDecode(t.getString("ct"))
            val label = t.getString("label")
            count = count + 1
            val out = rsaDecryptOaep(key, ciphertext, oaepHash(sha), hashSize(sha))
            // No label parameter: a ciphertext made with a label must not decrypt to the message; nor one made with an unsupported pair.
            if (label != "" || !supported) {
                if (out.ok && out.bytes == message) fail(name, id, "a ciphertext decrypted that the library cannot take ($sha, MGF1 $mgfSha, label '$label')")
                if (result == "valid" && label == "") unsupportedHere = unsupportedHere + 1
                continue
            }
            if (result == "valid") {
                if (!out.ok || out.bytes != message) fail(name, id, "a valid ciphertext failed ($sha): ${out.error}")
                else valid = valid + 1
            } else if (result == "invalid" && out.ok && out.bytes == message) fail(name, id, "an invalid ciphertext decrypted ($sha): ${t.getString("comment")}")
        }
    }
    unsupported = unsupported + unsupportedHere
    println("$name.json: $count cases, $valid decrypted, $unsupportedHere valid ones of a pair the library does not take, $refusedKeys of keys under 2048 bits")
    return
}

// ---- RSASSA-PSS verification ----
fun pssFile(directory: string, name: string): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var accepted = 0
    var unsupportedHere = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val sha = group.getString("sha")
        val mgfSha = group.getString("mgfSha")
        // The key as numbers: the "params" sets carry the PSS parameters in the key's algorithm, which this library does not read (the hash is the caller's).
        val asn = hexDecode(group.getString("publicKeyAsn"))
        val key = rsaPublicFromPkcs1(asn, 0, asn.size, "unreadable")
        if (!key.ok()) {
            fail(name, 0, "the key did not load: ${key.error}")
            continue
        }
        val bits = if (sha == "SHA-256") 256 else if (sha == "SHA-384") 384 else if (sha == "SHA-512") 512 else 0
        val supported = sha == mgfSha && bits > 0
        val saltLength = group.getInt("sLen")
        val tests = group.get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val ok = rsaPssVerify(key, if (bits > 0) bits else 256, hexDecode(t.getString("msg")), hexDecode(t.getString("sig")), saltLength)
            count = count + 1
            if (ok) accepted = accepted + 1
            if (!supported) {
                // A pair it cannot take (another MGF1 hash, a hash it does not have): whatever it says to a valid signature, never yes to an invalid one.
                if (result == "valid") unsupportedHere = unsupportedHere + 1
                if (result == "invalid" && ok) fail(name, id, "an invalid signature was accepted ($sha, MGF1 $mgfSha): ${t.getString("comment")}")
                if (result == "valid" && ok && sha != mgfSha) fail(name, id, "a signature made with another MGF1 hash was accepted ($sha, MGF1 $mgfSha)")
                continue
            }
            if (result == "valid" && !ok) fail(name, id, "a valid signature was refused ($sha, salt $saltLength): ${t.getString("comment")}")
            else if (result == "invalid" && ok) fail(name, id, "an invalid signature was accepted ($sha, salt $saltLength): ${t.getString("comment")}")
        }
    }
    unsupported = unsupported + unsupportedHere
    println("$name.json: $count cases, $accepted accepted, $unsupportedHere valid ones of a pair the library does not take")
    return
}

fun main: int {
    val directory = processArgument(0)
    hmacFile(directory, "hmac_sha1_test", "SHA-1", 64)
    hmacFile(directory, "hmac_sha512_test", "SHA-512", 128)
    hmacFile(directory, "hmac_sha3_224_test", "SHA3-224", 144)
    hmacFile(directory, "hmac_sha3_256_test", "SHA3-256", 136)
    hmacFile(directory, "hmac_sha3_384_test", "SHA3-384", 104)
    hmacFile(directory, "hmac_sha3_512_test", "SHA3-512", 72)
    hmacBoundaries()
    hkdfFile(directory, "hkdf_sha1_test", HKDF_SHA1)
    hkdfFile(directory, "hkdf_sha512_test", HKDF_SHA512)
    ecdsaFile(directory, "ecdsa_secp256r1_sha3_256_test", 256, false)
    ecdsaFile(directory, "ecdsa_secp256r1_sha3_512_test", 256, false)
    ecdsaFile(directory, "ecdsa_secp256r1_shake128_test", 256, false)
    ecdsaFile(directory, "ecdsa_secp256r1_shake128_p1363_test", 256, true)
    ecdsaFile(directory, "ecdsa_secp384r1_sha3_384_test", 384, false)
    ecdsaFile(directory, "ecdsa_secp384r1_sha3_512_test", 384, false)
    ecdsaFile(directory, "ecdsa_secp384r1_shake256_test", 384, false)
    ecdsaFile(directory, "ecdsa_secp384r1_shake256_p1363_test", 384, true)
    for (name in [
        "rsa_oaep_2048_sha1_mgf1sha1_test", "rsa_oaep_2048_sha224_mgf1sha224_test", "rsa_oaep_2048_sha256_mgf1sha256_test",
        "rsa_oaep_2048_sha256_mgf1sha1_test", "rsa_oaep_2048_sha384_mgf1sha384_test", "rsa_oaep_2048_sha384_mgf1sha1_test",
        "rsa_oaep_2048_sha512_mgf1sha512_test", "rsa_oaep_2048_sha512_mgf1sha1_test", "rsa_oaep_3072_sha512_mgf1sha512_test",
        "rsa_oaep_4096_sha512_mgf1sha512_test", "rsa_oaep_misc_test"
    ]) oaepFile(directory, name)
    for (name in [
        "rsa_pss_2048_sha1_mgf1_20_test", "rsa_pss_2048_sha1_mgf1_20_params_test", "rsa_pss_2048_sha256_mgf1_0_params_test",
        "rsa_pss_2048_sha256_mgf1_32_params_test", "rsa_pss_2048_sha256_mgf1sha1_20_test", "rsa_pss_2048_sha512_256_mgf1_32_test",
        "rsa_pss_2048_sha512_mgf1sha256_32_params_test", "rsa_pss_2048_shake128_test", "rsa_pss_3072_sha256_mgf1_32_test",
        "rsa_pss_3072_sha256_mgf1_32_params_test", "rsa_pss_4096_sha256_mgf1_32_test", "rsa_pss_4096_sha384_mgf1_48_test",
        "rsa_pss_4096_sha512_mgf1_32_test", "rsa_pss_4096_sha512_mgf1_32_params_test"
    ]) pssFile(directory, name)
    println("valid cases of pairs the library does not take (refused, as designed): $unsupported")
    if (failures > 0) {
        println("wycheproof-hashes: $failures failure(s)")
        return 1
    }
    println("wycheproof-hashes ok")
    0
}
