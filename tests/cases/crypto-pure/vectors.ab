// NIST CAVP and Wycheproof vectors (tests/vectors/crypto) through abla/crypto/aes and
// abla/crypto/rsa. Prints a count per file; exit 1 on any failure.
import "abla/io"
import "abla/crypto"
import "abla/crypto/aes"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/text"

var failures = 0

fun fail(file: string, number: int, why: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL $file line $number: $why")
    return
}

fun hex(field: string): string = if (field == "-") "" else hexDecode(field)

fun records(path: string): array<string> =
    linuxReadFile(path, 16777216).split("\n")

// The CAVP cases have no padding, so a whole-block plaintext encrypts to the vector's
// ciphertext followed by one more block, the padding's. To decrypt without a raw
// mode, that block is made with ECB: E(0x10 x 16) for ECB, and for CBC E(0x10 x 16
// XOR the last ciphertext block).
fun checkBlock(directory: string): int {
    var count = 0
    var number = 0
    val padding = "\x10".repeat(16)
    for (line in records("$directory/aes-block.txt")) {
        number = number + 1
        if (line == "") continue
        val f = line.split(" ")
        if (f[0] == "cbc-pkcs7") {
            val key = hex(f[1])
            val iv = hex(f[2])
            val message = hex(f[3])
            val ciphertext = hex(f[4])
            val decrypted = aesCbcDecryptPkcs7(key, iv, ciphertext)
            if (f[5] == "valid") {
                val encrypted = aesCbcEncryptPkcs7(key, iv, message)
                if (!encrypted.ok || encrypted.bytes != ciphertext) fail("aes-block", number, "cbc-pkcs7 encrypt")
                if (!decrypted.ok || decrypted.bytes != message) fail("aes-block", number, "cbc-pkcs7 decrypt")
            } else if (decrypted.ok) fail("aes-block", number, "cbc-pkcs7 accepted an invalid one")
        } else {
            val key = hex(f[2])
            val iv = hex(f[3])
            val plaintext = hex(f[4])
            val ciphertext = hex(f[5])
            if (f[0] == "ecb") {
                val encrypted = aesEcbEncryptPkcs5(key, plaintext)
                val last = aesEcbEncryptPkcs5(key, padding).bytes.slice(0, 16)
                if (!encrypted.ok || encrypted.bytes != ciphertext + last) fail("aes-block", number, "ecb encrypt")
                val decrypted = aesEcbDecryptPkcs5(key, ciphertext + last)
                if (!decrypted.ok || decrypted.bytes != plaintext) fail("aes-block", number, "ecb decrypt")
            } else {
                val encrypted = aesCbcEncryptPkcs7(key, iv, plaintext)
                if (!encrypted.ok || encrypted.bytes.slice(0, ciphertext.size) != ciphertext) fail("aes-block", number, "cbc encrypt")
                val tail = ciphertext.slice(ciphertext.size - 16, ciphertext.size)
                val last = aesEcbEncryptPkcs5(key, binaryXor(padding, tail)).bytes.slice(0, 16)
                val decrypted = aesCbcDecryptPkcs7(key, iv, ciphertext + last)
                if (!decrypted.ok || decrypted.bytes != plaintext) fail("aes-block", number, "cbc decrypt")
            }
        }
        count = count + 1
    }
    count
}

fun checkGcm(directory: string): int {
    var count = 0
    var number = 0
    for (line in records("$directory/aes-gcm.txt")) {
        number = number + 1
        if (line == "") continue
        val f = line.split(" ")
        val key = hex(f[1])
        val nonce = hex(f[2])
        val plaintext = hex(f[3])
        val aad = hex(f[4])
        val sealed = hex(f[5]) + hex(f[6])
        val opened = aesGcmDecrypt(key, nonce, sealed, aad)
        if (f[7] == "valid") {
            val encrypted = aesGcmEncrypt(key, nonce, plaintext, aad)
            if (!encrypted.ok || encrypted.bytes != sealed) fail("aes-gcm", number, "encrypt")
            if (!opened.ok || opened.bytes != plaintext) fail("aes-gcm", number, "decrypt")
        } else if (opened.ok || opened.bytes != "") fail("aes-gcm", number, "accepted an invalid one")
        count = count + 1
    }
    count
}

fun main: int {
    val directory = processArgument(0)
    for (hardware in [true, false]) {
        aesUseHardware = hardware
        // Hardware rounds where the CPU has them, then software on the same vectors.
        val path = if (aesHardwareAvailable()) "hardware" else "software"
        println("$path aes-block ${checkBlock(directory)}")
        println("$path aes-gcm ${checkGcm(directory)}")
    }
    println("failures $failures")
    if (failures == 0) 0 else 1
}
