// P-384 key agreement (abla/crypto/p384): what Wycheproof's ECDH file (wycheproof-tls.ab) does not say, and the outputs that
// tools/test-crypto-pure.sh compares with openssl. Private keys out of range (0, n, n + 1, all ones, a wrong length) are refused;
// scalar 1 gives the generator and 2 its double; the peer points that must be refused (off the curve, the point at infinity, a
// compressed form, a coordinate at or above p, a wrong length) are. Arguments: PRIVATE_HEX PEER_PUBLIC_HEX (pairs); for each pair
// prints "public HEX" (the public key of PRIVATE) and "shared HEX" (the x coordinate of PRIVATE times PEER), for openssl to check.
// Prints "crypto-pure p384 ok" last.
import "abla/crypto"
import "abla/crypto/p384"
import "abla/io"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/text"

var failures = 0

fun expect(ok: bool, what: string): void {
    if (!ok) {
        failures = failures + 1
        println("FAIL $what")
    }
    return
}

val ORDER = "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"
val PRIME = "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"
val GX = "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"
val GY = "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"
// 2G, from FIPS 186 / SEC 2 test data.
val G2X = "08d999057ba3d2d969260045c55b97f089025959a6f434d651d207d19fb96e9e4fe0e86ebe0e64f85b96a9c75295df61"
val G2Y = "8e80f1fa5b1b3cedb7bfe8dffd6dba74b275d875bc6cc43e904e505f256ab4255ffd43e94d39e22d61501e700a940e80"

fun hex48(value: int): string = "00".repeat(47) + hexByte(value)
fun hexByte(value: int): string = hexEncode(cryptoByteString([value]))

fun refusals(): void {
    val one = hexDecode(hex48(1))
    val g = hexDecode("04" + GX + GY)
    val made = p384PublicKey(one)
    expect(made.ok && made.bytes == g, "the public key of 1 is the generator")
    val two = p384PublicKey(hexDecode(hex48(2)))
    expect(two.ok && two.bytes == hexDecode("04" + G2X + G2Y), "the public key of 2 is 2G")
    expect(!p384PublicKey(hexDecode(hex48(0))).ok, "a zero private key")
    expect(!p384PublicKey(hexDecode(ORDER)).ok, "the private key n")
    val orderPlusOne = hexDecode(ORDER.slice(0, 94) + "74")
    expect(!p384PublicKey(orderPlusOne).ok, "the private key n + 1")
    expect(!p384PublicKey(hexDecode("ff".repeat(48))).ok, "an all-ones private key")
    expect(p384PublicKey(hexDecode(ORDER.slice(0, 94) + "72")).ok, "the private key n - 1")
    expect(!p384PublicKey(hexDecode("00".repeat(47))).ok, "a 47-byte private key")
    expect(!p384PublicKey(hexDecode(hex48(1) + "00")).ok, "a 49-byte private key")
    expect(!p384Ecdh(hexDecode(ORDER), g).ok, "ECDH with the private key n")
    expect(p384Ecdh(one, g).ok && p384Ecdh(one, g).bytes == hexDecode(GX), "ECDH of 1 and G is Gx")
    // Peer points that are refused.
    val offCurve = hexDecode("04" + GX + GY.slice(0, 94) + "60")
    expect(!p384Ecdh(one, offCurve).ok, "a point off the curve")
    expect(!p384Ecdh(one, hexDecode("04" + "00".repeat(96))).ok, "the point (0, 0)")
    expect(!p384Ecdh(one, hexDecode("02" + GX)).ok, "a compressed point")
    expect(!p384Ecdh(one, hexDecode("03" + GX)).ok, "a compressed point, odd")
    expect(!p384Ecdh(one, hexDecode("00")).ok, "the point at infinity, encoded as one byte")
    expect(!p384Ecdh(one, hexDecode("04" + PRIME + GY)).ok, "x equal to p")
    expect(!p384Ecdh(one, hexDecode("04" + GX + PRIME)).ok, "y equal to p")
    expect(!p384Ecdh(one, hexDecode("04" + GX + GY + "00")).ok, "a 98-byte point")
    expect(!p384Ecdh(one, hexDecode("04" + GX + GY.slice(0, 94))).ok, "a 96-byte point")
    expect(!p384Ecdh(one, hexDecode("05" + GX + GY)).ok, "a wrong prefix")
    return
}

/** ECDSA signing: RFC 6979 appendix A.2.6 (P-384, SHA-384, "sample"), our own verifier, determinism, the refused keys. */
fun signing(): void {
    val x = hexDecode("6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5")
    val raw = p384EcdsaSignRaw(x, "sample")
    expect(raw.ok && raw.bytes.size == 96, "signing with the RFC 6979 key")
    expect(hexEncode(raw.bytes) == "94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe46" +
        "99ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8", "RFC 6979 A.2.6: r || s of \"sample\"")
    val pub = p384PublicKey(x)
    expect(pub.ok && hexEncode(pub.bytes) == "04" + "ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc13" +
        "8015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720", "the public key of the RFC 6979 key")
    expect(p384EcdsaVerify(pub.bytes, "sample", p384SignatureToDer(raw.bytes)), "our verifier takes our signature")
    expect(!p384EcdsaVerify(pub.bytes, "samplf", p384SignatureToDer(raw.bytes)), "our verifier refuses it for another message")
    val again = p384EcdsaSign(x, "sample")
    expect(again.ok && again.bytes == p384SignatureToDer(raw.bytes), "one message, one signature, as DER")
    expect(p384SignatureFromDer(again.bytes) == raw.bytes, "DER and back")
    expect(p384EcdsaSign(x, "other").bytes != again.bytes, "another message another signature")
    expect(!p384EcdsaSignRaw(hexDecode(ORDER), "m").ok && !p384EcdsaSignRaw(hexDecode(hex48(0)), "m").ok && !p384EcdsaSignRaw("short", "m").ok, "private keys out of range")
    // A key with leading zero bytes and a signature whose r or s starts with a byte of 0x80 or more (the DER integer needs its padding).
    var padded = 0
    for (round in 0 until 40) {
        val key = hexDecode(hex48(round + 1))
        val publicKey = p384PublicKey(key)
        val signature = p384EcdsaSign(key, "round $round")
        expect(signature.ok && publicKey.ok && p384EcdsaVerify(publicKey.bytes, "round $round", signature.bytes), "sign and verify with key $round")
        if (signature.ok && (signature.bytes.size > 102 || signature.bytes.size < 100)) padded = padded + 1
    }
    expect(padded > 0, "some DER signature is not of the usual length (a padded or a short integer was exercised)")
    return
}

fun main: int {
    refusals()
    signing()
    var at = 0
    while (at + 1 < processArgumentCount()) {
        val priv = hexDecode(processArgument(at))
        val peer = hexDecode(processArgument(at + 1))
        val made = p384PublicKey(priv)
        val shared = p384Ecdh(priv, peer)
        expect(made.ok && shared.ok, "pair at argument $at")
        println("public ${hexEncode(made.bytes)}")
        println("shared ${hexEncode(shared.bytes)}")
        println("signature ${hexEncode(p384EcdsaSign(priv, "p384 sign test").bytes)}")
        at = at + 2
    }
    if (failures > 0) return 1
    println("crypto-pure p384 ok")
    0
}
