// A command line over abla/crypto/aes and abla/crypto/rsa, for tools/test-crypto-pure.sh to compare with the
// openssl CLI: `tool <op> <arguments>`, data in files, keys in hexadecimal or PEM files. Prints hexadecimal
// or "refused". CT_SOFTWARE in the environment takes the software path.
import "abla/io"
import "abla/crypto"
import "abla/crypto/aes"
import "abla/crypto/rsa"
import "abla/process/arguments"
import "abla/sys/linux"

fun arg(index: int): string = processArgument(index)
fun file(index: int): string = linuxReadFile(arg(index), 16777216)

fun show(result: CryptoResult): int {
    if (!result.ok) {
        println("refused: ${result.error}")
        return 3
    }
    println(hexEncode(result.bytes))
    0
}

fun answer(ok: bool): int {
    println(if (ok) "yes" else "no")
    if (ok) 0 else 3
}

fun main: int {
    val op = arg(0)
    if (arg(1) == "software") aesUseHardware = false
    when (op) {
        "ecb-encrypt" -> show(aesEcbEncryptPkcs5(hexDecode(arg(2)), file(3)))
        "ecb-decrypt" -> show(aesEcbDecryptPkcs5(hexDecode(arg(2)), file(3)))
        "cbc-encrypt" -> show(aesCbcEncryptPkcs7(hexDecode(arg(2)), hexDecode(arg(3)), file(4)))
        "cbc-decrypt" -> show(aesCbcDecryptPkcs7(hexDecode(arg(2)), hexDecode(arg(3)), file(4)))
        "gcm-encrypt" -> show(aesGcmEncrypt(hexDecode(arg(2)), hexDecode(arg(3)), file(4)))
        "gcm-decrypt" -> show(aesGcmDecrypt(hexDecode(arg(2)), hexDecode(arg(3)), file(4)))
        "sign-sha1" -> show(rsaPrivateKeyFromPem(file(2)).signPkcs1Sha1Legacy(file(3)))
        "sign-sha256" -> show(rsaPrivateKeyFromPem(file(2)).signPkcs1Sha256(file(3)))
        "verify-sha1" -> answer(rsaPublicKeyFromPem(file(2)).verifyPkcs1Sha1Legacy(file(3), file(4)))
        "verify-sha256" -> answer(rsaPublicKeyFromPem(file(2)).verifyPkcs1Sha256(file(3), file(4)))
        "encrypt-pkcs1" -> show(rsaPublicKeyFromPem(file(2)).encryptPkcs1Legacy(file(3)))
        "encrypt-oaep-sha1" -> show(rsaPublicKeyFromPem(file(2)).encryptOaepSha1Legacy(file(3)))
        "encrypt-oaep-sha256" -> show(rsaPublicKeyFromPem(file(2)).encryptOaepSha256(file(3)))
        else -> {
            println("no such operation: $op")
            2
        }
    }
}
