// Wycheproof sets beyond the ones the other tests read (tests/vectors/crypto/wycheproof, JSON as published, C2SP/wycheproof testvectors_v1 fetched
// 2026-11-23): ML-KEM-768 (the seed-derived keys, decapsulation of valid and altered ciphertexts with the implicit-rejection secret, encapsulation
// with the modulus-overflow keys refused, the semi-expanded decapsulation-key validation), ECDSA P-256 with SHA-512 (DER and P1363) and P-384 with
// SHA-256 and SHA-512 (the digest is longer or shorter than the curve order), RSA PKCS#1 v1.5 decryption at 3072 bits (the Bleichenbacher cases:
// every invalid padding must not give the message), RSA-OAEP with SHA-256 at 3072 and 4096 bits (a ciphertext made with a label must not decrypt
// with the empty label) and RSA PKCS#1 v1.5 signatures at 4096 bits. "valid" must succeed with the expected output, "invalid" must fail (or give
// another output). Keys below 2048 bits are refused by policy and not in these files. Usage: wycheproof-more VECTORS_DIRECTORY
import "abla/crypto"
import "abla/crypto/mlkem"
import "abla/crypto/p256"
import "abla/crypto/p384"
import "abla/crypto/rsa"
import "abla/io"
import "abla/json"
import "abla/process/arguments"
import "abla/sys/linux"

var failures = 0

fun fail(file: string, id: int, why: string): void {
    failures = failures + 1
    if (failures < 60) println("FAIL $file #$id: $why")
    return
}

fun load(directory: string, name: string): Json? {
    val parsed = jsonParse(linuxReadFile("$directory/wycheproof/$name.json", 33554432), jsonPermissiveLimits)
    if (!parsed.succeeded) {
        fail(name, 0, "the JSON did not parse: ${parsed.error.message}")
        return null
    }
    parsed.value
}

// ---- ML-KEM-768 ----
fun mlkemDecapsulation(directory: string): void {
    val root = load(directory, "mlkem_768_test")
    if (root == null) return
    var count = 0
    var rejected = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val tests = groups.at(g).get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val seed = t.getString("seed")
            // A seed of another length is an invalid case this API cannot even be asked.
            if (seed.size != 128) {
                if (result == "valid") fail("mlkem_768_test", id, "a valid case with a seed of another length")
                continue
            }
            val keys = mlkem768KeyGenFromSeeds(hexDecode(seed.slice(0, 64)), hexDecode(seed.slice(64, 128)))
            if (!keys.ok) {
                fail("mlkem_768_test", id, "key generation: ${keys.error}")
                continue
            }
            if (hexEncode(mlkem768EncapsulationKey(keys.bytes)) != t.getString("ek")) fail("mlkem_768_test", id, "the encapsulation key differs")
            val out = mlkem768Decapsulate(keys.bytes, hexDecode(t.getString("c")))
            count = count + 1
            if (!out.ok) {
                if (result == "valid") fail("mlkem_768_test", id, "a valid case was refused: ${out.error}")
                else rejected = rejected + 1
            } else if (hexEncode(out.bytes) != t.getString("K")) fail("mlkem_768_test", id, "$result case: another shared secret (implicit rejection)")
        }
    }
    println("mlkem_768_test.json: $count cases, $rejected refused")
    return
}

fun mlkemEncapsulation(directory: string): void {
    val root = load(directory, "mlkem_768_encaps_test")
    if (root == null) return
    var count = 0
    var refused = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val tests = groups.at(g).get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val out = mlkem768EncapsulateWithMessage(hexDecode(t.getString("ek")), hexDecode(t.getString("m")))
            count = count + 1
            if (t.getString("result") == "valid") {
                if (!out.ok) fail("mlkem_768_encaps_test", id, "a valid case was refused: ${out.error}")
                else if (hexEncode(out.ciphertext) != t.getString("c") || hexEncode(out.sharedSecret) != t.getString("K")) fail("mlkem_768_encaps_test", id, "another output")
            } else if (out.ok) fail("mlkem_768_encaps_test", id, "an invalid encapsulation key was accepted")
            else refused = refused + 1
        }
    }
    println("mlkem_768_encaps_test.json: $count cases, $refused refused")
    return
}

fun mlkemKeyValidation(directory: string): void {
    val root = load(directory, "mlkem_768_semi_expanded_decaps_test")
    if (root == null) return
    var count = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val tests = groups.at(g).get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            var malleable = false
            for (f in 0 until t.get("flags").size()) {
                if (t.get("flags").at(f).asString() == "MalleableCiphertext") malleable = true
            }
            val out = mlkem768Decapsulate(hexDecode(t.getString("dk")), hexDecode(t.getString("c")))
            count = count + 1
            if (t.getString("result") == "valid") {
                if (!out.ok || hexEncode(out.bytes) != t.getString("K")) fail("mlkem_768_semi_expanded_decaps_test", id, "a valid case went wrong: ${out.error}")
            } else if (out.ok && !malleable) {
                // A wrong length or a key that fails its hash check is refused; an altered ciphertext legitimately decapsulates (implicit rejection).
                fail("mlkem_768_semi_expanded_decaps_test", id, "an invalid key or length was accepted")
            }
        }
    }
    println("mlkem_768_semi_expanded_decaps_test.json: $count cases")
    return
}

// ---- ECDSA ----
fun digest(hash: string, message: string): string =
    if (hash == "SHA-256") sha256(message) else if (hash == "SHA-384") sha384(message) else if (hash == "SHA-512") sha512(message) else ""

fun ecdsa(directory: string, name: string, curve: int, p1363: bool): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var accepted = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val key = hexDecode(group.get("publicKey").getString("uncompressed"))
        val hash = group.getString("sha")
        val tests = group.get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val d = digest(hash, hexDecode(t.getString("msg")))
            val signature = hexDecode(t.getString("sig"))
            var raw = signature
            if (!p1363) raw = if (curve == 256) p256SignatureFromDer(signature) else p384SignatureFromDer(signature)
            var ok = false
            if (raw != "") ok = if (curve == 256) p256EcdsaVerifyDigestRaw(key, d, raw) else p384EcdsaVerifyDigestRaw(key, d, raw)
            count = count + 1
            if (ok) accepted = accepted + 1
            if (result == "valid" && !ok) fail(name, id, "a valid signature was refused: ${t.getString("comment")}")
            else if (result == "invalid" && ok) fail(name, id, "an invalid signature was accepted: ${t.getString("comment")}")
        }
    }
    println("$name.json: $count cases, $accepted accepted")
    return
}

// ---- RSA ----
fun rsaDecrypt(directory: string, name: string, pkcs1: bool): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var valid = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val key = rsaPrivateKeyFromPem(group.getString("privateKeyPem"))
        if (!key.ok()) {
            fail(name, 0, "a key group did not load: ${key.error}")
            continue
        }
        val tests = group.get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val message = hexDecode(t.getString("msg"))
            val ciphertext = hexDecode(t.getString("ct"))
            val out = if (pkcs1) key.decryptPkcs1Legacy(ciphertext) else key.decryptOaepSha256(ciphertext)
            count = count + 1
            // No label parameter: a ciphertext made with a label must not decrypt to the message.
            if (!pkcs1 && t.getString("label") != "") {
                if (out.ok && out.bytes == message) fail(name, id, "a ciphertext made with a label decrypted with the empty one")
                continue
            }
            if (result == "valid") {
                if (!out.ok || out.bytes != message) fail(name, id, "a valid ciphertext failed: ${out.error}")
                else valid = valid + 1
            } else if (result == "invalid" && out.ok && out.bytes == message) fail(name, id, "an invalid ciphertext decrypted: ${t.getString("comment")}")
        }
    }
    println("$name.json: $count cases, $valid decrypted")
    return
}

fun rsaVerify(directory: string, name: string): void {
    val root = load(directory, name)
    if (root == null) return
    var count = 0
    var accepted = 0
    val groups = root.get("testGroups")
    for (g in 0 until groups.size()) {
        val group = groups.at(g)
        val key = rsaPublicKeyFromPem(group.getString("publicKeyPem"))
        val tests = group.get("tests")
        for (i in 0 until tests.size()) {
            val t = tests.at(i)
            val id = t.getInt("tcId")
            val result = t.getString("result")
            val ok = key.ok() && key.verifyPkcs1Sha256(hexDecode(t.getString("msg")), hexDecode(t.getString("sig")))
            count = count + 1
            if (ok) accepted = accepted + 1
            if (result == "valid" && !ok) fail(name, id, "a valid signature was refused: ${t.getString("comment")}")
            else if (result == "invalid" && ok) fail(name, id, "an invalid signature was accepted: ${t.getString("comment")}")
        }
    }
    println("$name.json: $count cases, $accepted accepted")
    return
}

fun main: int {
    val directory = processArgument(0)
    mlkemDecapsulation(directory)
    mlkemEncapsulation(directory)
    mlkemKeyValidation(directory)
    ecdsa(directory, "ecdsa_secp256r1_sha512_test", 256, false)
    ecdsa(directory, "ecdsa_secp256r1_sha512_p1363_test", 256, true)
    ecdsa(directory, "ecdsa_secp384r1_sha256_test", 384, false)
    ecdsa(directory, "ecdsa_secp384r1_sha512_test", 384, false)
    rsaDecrypt(directory, "rsa_pkcs1_3072_test", true)
    rsaDecrypt(directory, "rsa_oaep_3072_sha256_mgf1sha256_test", false)
    rsaDecrypt(directory, "rsa_oaep_4096_sha256_mgf1sha256_test", false)
    rsaVerify(directory, "rsa_signature_4096_sha256_test")
    if (failures > 0) {
        println("wycheproof-more: $failures failure(s)")
        return 1
    }
    println("wycheproof-more ok")
    0
}
