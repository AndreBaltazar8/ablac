// SHA-3 and SHAKE (abla/crypto/sha3): the FIPS 202 known answers for the empty message and "abc", then, for the hex-encoded
// random bytes in the file named by argument 0, the digests of prefixes of many lengths (around every rate boundary, and
// past several blocks), printed as "NAME LENGTH HEX" for tools/test-crypto-pure.sh to compare with openssl dgst; and the same
// message fed in odd-sized pieces and squeezed in odd-sized pieces must give what one call gives. Prints "crypto-pure sha3 ok".
import "abla/crypto"
import "abla/crypto/sha3"
import "abla/fs"
import "abla/io"
import "abla/process/arguments"
import "abla/text"

var failures = 0

fun expect(ok: bool, what: string): void {
    if (!ok) {
        failures = failures + 1
        println("FAIL $what")
    }
    return
}

val LENGTHS = [0, 1, 2, 7, 8, 55, 56, 71, 72, 73, 100, 134, 135, 136, 137, 143, 144, 167, 168, 169, 200, 271, 272, 273, 335, 336,
    337, 404, 500, 1000, 1023]

fun pieces(message: string, size: int, squeezeSize: int, total: int, make: () -> Keccak): string {
    var sponge = make()
    var at = 0
    while (at < message.size) {
        val end = if (at + size < message.size) at + size else message.size
        sponge.absorb(message.slice(at, end))
        at = end
    }
    var out = ""
    while (out.size < total) {
        val take = if (out.size + squeezeSize < total) squeezeSize else total - out.size
        out = out + sponge.squeeze(take)
    }
    sponge.close()
    out
}

fun main: int {
    expect(hexEncode(sha3256("")) == "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", "SHA3-256 of the empty message")
    expect(hexEncode(sha3256("abc")) == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", "SHA3-256 of abc")
    expect(hexEncode(sha3512("abc")) == "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0", "SHA3-512 of abc")
    expect(hexEncode(shake128("", 32)) == "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26", "SHAKE128 of the empty message")
    expect(hexEncode(shake256("", 32)) == "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f", "SHAKE256 of the empty message")
    val random = hexDecode(Path(processArgument(0)).readText().trim())
    expect(random.size >= 1024, "the random file holds at least 1024 bytes")
    for (length in LENGTHS) {
        val message = random.slice(0, length)
        println("sha3-256 $length ${hexEncode(sha3256(message))}")
        println("sha3-512 $length ${hexEncode(sha3512(message))}")
        println("shake128 $length ${hexEncode(shake128(message, 300))}")
        println("shake256 $length ${hexEncode(shake256(message, 300))}")
        val whole128 = shake128(message, 400)
        val whole256 = shake256(message, 400)
        for (size in [1, 5, 71, 136, 168, 169]) {
            for (squeezeSize in [1, 3, 136, 168, 200]) {
                expect(pieces(message, size, squeezeSize, 400, { keccakShake128() }) == whole128,
                    "SHAKE128 in pieces of $size, squeezed by $squeezeSize, length $length")
                expect(pieces(message, size, squeezeSize, 400, { keccakShake256() }) == whole256,
                    "SHAKE256 in pieces of $size, squeezed by $squeezeSize, length $length")
            }
        }
    }
    if (failures > 0) return 1
    println("crypto-pure sha3 ok")
    0
}
