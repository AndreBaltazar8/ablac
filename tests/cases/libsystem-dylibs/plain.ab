import "abla/build"
import "abla/text"

// A macOS dylib's libSystem imports (tools/macos-libsystem-inventory.sh, #833): one export that allocates, so the
// runtime, its heap and the export enter/leave thunk are in, and one that starts a thread.
val exportedWords = #exportFunction("words", "abla_dylib_words")
val exportedThreaded = #exportFunction("threaded", "abla_dylib_threaded")

fun words(count: int): int {
    var text = ""
    for (index in 0 until count) text = text + "word$index "
    text.split(" ").size
}

fun threaded(value: int): int {
    val worker = thread { 21 * 2 }
    await worker + value
}
