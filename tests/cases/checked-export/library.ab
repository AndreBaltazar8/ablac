import "abla/build"
import "abla/process"

// 84 / 0 panics (division by zero); an index past the array panics too.
fun quotient(value: int): int = 84 / value

fun element(index: int): int {
    val values = [40, 41, 42]
    values[index]
}

// `panic` from abla/process is contained like a runtime panic.
fun limited(value: int): int {
    if (value > 10) panic("value $value is over the limit")
    value * 2
}

val exportedQuotient = #exportCheckedFunction("quotient", "abla_checked_quotient")
val exportedElement = #exportCheckedFunction("element", "abla_checked_element")
val exportedLimited = #exportCheckedFunction("limited", "abla_checked_limited")
