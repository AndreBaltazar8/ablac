// The YAML parser against the one before its plain-scalar and line-lookup changes (old-parser.ab, old-value.ab): the
// same value tree, or the same error (code, message, offset, line, column), over the YAML test-suite corpus, every
// prefix of each file at several cut points, and copies with one byte replaced. Usage: main <corpus directory> <list of file names without .yaml>
import "abla/io"
import "abla/fs"
import "abla/yaml"
import "abla/process/arguments"
import "abla/text"
import "./old-yaml.ab" as old

fun number(text: string, integer: bool, intValue: int, intAvailable: bool, canonical: string, valid: bool): string =
    "n($text|$integer|$intValue|$intAvailable|$canonical|$valid)"

fun dump(value: Yaml): string {
    var out = "k${value.kind}:${value.stringValue.size}:${value.stringValue}:${value.boolValue}:" +
        number(value.numberValue.text, value.numberValue.integer, value.numberValue.intValue,
            value.numberValue.intAvailable, value.numberValue.canonical, value.numberValue.valid) + "["
    for (key in value.keys) out = "$out${dump(key)};"
    out = "$out|"
    for (child in value.values) out = "$out${dump(child)};"
    "$out]"
}

fun oldDump(value: old.Yaml): string {
    var out = "k${value.kind}:${value.stringValue.size}:${value.stringValue}:${value.boolValue}:" +
        number(value.numberValue.text, value.numberValue.integer, value.numberValue.intValue,
            value.numberValue.intAvailable, value.numberValue.canonical, value.numberValue.valid) + "["
    for (key in value.keys) out = "$out${oldDump(key)};"
    out = "$out|"
    for (child in value.values) out = "$out${oldDump(child)};"
    "$out]"
}

fun result(text: string): string {
    val r = yamlParse(text)
    if (r.succeeded) return "ok ${dump(r.value)}"
    "error ${r.error.code} ${r.error.message} ${r.error.byteOffset} ${r.error.line} ${r.error.column}"
}

fun oldResult(text: string): string {
    val r = old.yamlParse(text)
    if (r.succeeded) return "ok ${oldDump(r.value)}"
    "error ${r.error.code} ${r.error.message} ${r.error.byteOffset} ${r.error.line} ${r.error.column}"
}

var checks = 0
var failures = 0

fun check(label: string, text: string): void {
    checks += 1
    if (result(text) != oldResult(text)) {
        failures += 1
        if (failures < 15) println("FAIL $label (${text.size} bytes)")
    }
    return
}

fun main: int {
    val replacements = ["a", " ", ":", "-", "\n", "#", "'", "\"", "[", "]", "{", "}", ",", "&", "*", "|", ">", "?", "1", "."]
    var files = 0
    for (stem in Path(processArgument(1)).readText().split("\n")) {
        if (stem.size == 0) continue
        val name = "$stem.yaml"
        val text = Path("${processArgument(0)}/$name").readText()
        files += 1
        check(name, text)
        // Prefixes: a cut anywhere in the text; every byte for a short file, about 40 cuts otherwise.
        val step = if (text.size <= 60) 1 else text.size / 40
        var cut = 0
        while (cut < text.size) {
            check("$name prefix $cut", text.slice(0, cut))
            cut += step
        }
        // One byte replaced, at about 12 places, by each of a few characters.
        val every = if (text.size <= 12) 1 else text.size / 12
        var at = 0
        while (at < text.size) {
            var r = 0
            while (r < replacements.size) {
                if (r % 4 == (at / every) % 4) {
                    check("$name replace $at ${replacements[r]}", text.slice(0, at) + replacements[r] + text.slice(at + 1, text.size))
                }
                r += 1
            }
            at += every
        }
    }
    if (files == 0) {
        println("yaml-diff: no files in ${processArgument(0)}")
        return 1
    }
    if (failures == 0) println("yaml-diff ok ($files files, $checks inputs)")
    else println("yaml-diff FAILED: $failures of $checks")
    return if (failures == 0) 0 else 1
}
