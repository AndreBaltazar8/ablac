import "abla/sys/linux/net"

var drops = 0
resource class Ticket(val number: int) {
    fun drop(): void { drops = drops + 1 }
}
class Holder(val ticket: Ticket, val number: int = ticket.number)
class ConnectionHolder(val connection: TcpConnection, val number: int = 42)
class DefaultTicket(val ticket: Ticket = Ticket(1), val number: int = 42)
fun consume(own ticket: Ticket, number: int = ticket.number): int = number
fun checked(): bool {
    val holder = Holder(Ticket(42))
    val connection = ConnectionHolder(TcpConnection(-1))
    val ticket = Ticket(42)
    val moved = Holder(number = 42, ticket = move(ticket))
    val defaulted = DefaultTicket()
    holder.number == 42 && connection.number == 42 && moved.number == 42 &&
        defaulted.number == 42 && consume(number = 42, ticket = Ticket(42)) == 42
}
fun main: int = if (checked() && drops == 4) 42 else 1
