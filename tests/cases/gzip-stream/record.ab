// The fixed transcript was captured from the original decoder in f9c09e2e,
// using that revision's stage-2 compiler with --fast, before its removal.
// It covers 4,000 corruptions and truncations at four output limits.
// Uncompressed transcript SHA-256: 891e8567288290ccdb5eec88a4a1f114f2c0781d1854690ef77464d674fa0744.
import "abla/compression/gzip"
import "abla/bytes"
import "abla/crypto"
import "abla/fs"
import "abla/io"
import "abla/process/arguments"

fun record(var transcript: ByteBuffer, input: string, limit: int): void {
    val result = gzipDecompress(input, limit)
    if (result.error == "invalid") transcript.appendText("I\n")
    else if (result.error == "limit") transcript.appendText("L\n")
    else if (result.error == "") transcript.appendText("S:" + hexEncode(sha256(result.data)) + "\n")
    else transcript.appendText("E:" + result.error + "\n")
}
fun main(): int {
    val packed = Path(processArgument(0)).readText()
    val transcript = byteBuffer()
    var i = 0
    while (i < 4000) {
        val at = (i * 7919) % packed.size
        val changed = packed.slice(0, at) + byteEncode(packed[at] ^ (1 << (i % 8))) +
            packed.slice(at + 1, packed.size)
        val truncated = packed.slice(0, at)
        for (limit in [0, 1, 16, 6548]) {
            record(transcript, changed, limit)
            record(transcript, truncated, limit)
        }
        i += 1
    }
    print(transcript.toText())
    0
}
