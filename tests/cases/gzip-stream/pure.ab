import "abla/compression/gzip"
import "abla/bytes"

resource class PureSource(val input: string, var pos: int = 0): GzipSource {
    fun readChunk(maximum: int): GzipInputChunk {
        val remaining = this.input.size - this.pos
        var amount = if (remaining < maximum) remaining else maximum
        if (amount > 3) amount = 3
        val data = this.input.slice(this.pos, this.pos + amount)
        this.pos += amount
        GzipInputChunk(data, this.pos == this.input.size)
    }
}
@export("streamCheck")
fun streamCheck(): int {
    val input = "hostless streaming test: abcabcabcabc"
    val packed = gzipCompress(input)
    val reader = PureSource(packed)
    val stream = gzipStream(reader, packed.size, input.size)
    val output = byteBuffer()
    while (true) {
        val part = stream.read(reader, 7)
        if (part.error != "") return 1
        output.appendText(part.data)
        if (part.done) return if (output.toText() == input) 42 else 2
    }
}
fun main(): int = streamCheck()
