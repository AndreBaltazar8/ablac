import "abla/compression/gzip"

resource class EmptySource(): GzipSource {
    fun readChunk(count: int): GzipInputChunk = GzipInputChunk("", true)
}
fun one(): bool {
    val source = EmptySource()
    val stream = gzipStream(source, 0, 0)
    stream.read(source, 1).error == "invalid"
}
fun main(): int {
    var i = 0
    while (i < 12000) {
        if (!one()) return 1
        i += 1
    }
    0
}
