import "abla/compression/gzip"
import "abla/bytes"
import "abla/fs"
import "abla/process/arguments"
import "abla/sys/linux"

resource class ParitySource(val input: string, var position: int = 0): GzipSource {
    fun readChunk(maximum: int): GzipInputChunk {
        val remaining = this.input.size - this.position
        val amount = if (remaining < maximum) remaining else maximum
        val data = this.input.slice(this.position, this.position + amount)
        this.position += amount
        GzipInputChunk(data, this.position == this.input.size)
    }
}
fun streamResult(input: string, limit: int): GzipDecompressResult {
    val reader = ParitySource(input)
    val stream = gzipStream(reader, input.size, limit)
    val output = byteBuffer()
    while (true) {
        val chunk = stream.read(reader, 65536)
        if (chunk.error != "") return GzipDecompressResult("", chunk.error)
        output.appendText(chunk.data)
        if (chunk.done) return GzipDecompressResult(output.toText(), "")
    }
}
fun check(input: string, limit: int, data: string, error: string): bool {
    val collected = gzipDecompress(input, limit)
    val streamed = streamResult(input, limit)
    if (collected.error != error || collected.data != data || streamed.error != error ||
        streamed.data != data) {
        linuxWriteStandardError("gzip regression: expected=$error, collecting=${collected.error}, streaming=${streamed.error}, input=${input.size}, limit=$limit\n")
        return false
    }
    true
}
fun main(): int {
    val raw = Path(processArgument(0)).readText()
    val packed = Path(processArgument(1)).readText()
    val short = byteBuffer()
    for (value in [31, 139, 8, 0, 0, 0, 0, 0, 2, 255, 203, 72]) short.appendByteValue(value)
    if (!check(short.toText(), 0, "", "invalid")) return 7
    if (processArgumentCount() > 2 && processArgument(2) == "invalid") {
        if (!check(packed, 100000, "", "invalid")) return 6
        return 0
    }
    if (!check(packed, raw.size, raw, "") || !check(packed, -1, "", "invalid") ||
        !check("", 0, "", "invalid")) return 1
    if (raw.size > 0 && !check(packed, raw.size - 1, "", "limit")) return 2
    if (!check(packed + "x", raw.size, "", "invalid") ||
        !check(packed + packed, raw.size, "", "invalid")) return 3
    val sample = "own compressor parity: abcabcabc"
    if (!check(gzipCompress(sample), sample.size, sample, "")) return 5
    0
}
