import "abla/compression/gzip"
import "abla/bytes"

resource class StagedSource(val input: string, var pos: int = 0): GzipSource {
    fun readChunk(maximum: int): GzipInputChunk {
        val remaining = this.input.size - this.pos
        val amount = if (remaining < maximum) remaining else maximum
        val data = this.input.slice(this.pos, this.pos + amount)
        this.pos += amount
        GzipInputChunk(data, this.pos == this.input.size)
    }
}
compile fun stagedRoundTrip(): bool {
    val input = "compile-time stream: abcabcabc"
    val packed = gzipCompress(input)
    val unpacked = gzipDecompress(packed, input.size)
    if (unpacked.error != "" || unpacked.data != input ||
        gzipDecompress(packed, input.size - 1).error != "limit") return false
    val reader = StagedSource(packed)
    val stream = gzipStream(reader, packed.size, input.size)
    val output = byteBuffer()
    while (true) {
        val part = stream.read(reader, 3)
        if (part.error != "") return false
        output.appendText(part.data)
        if (part.done) return output.toText() == input
    }
}
fun main(): int = if (#stagedRoundTrip()) 0 else 1
