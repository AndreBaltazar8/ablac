// A native site's global read back while collections run inside its getter (#1031). The getter's encoding allocates
// (its growing reply, the map of what it has written), so it can collect partway through; its reply was a collected
// block that only an int held, so the collection freed it and the encoding went on writing into memory given back.
// tools/test-ct-readback-collect.sh builds this with a collection every megabyte and freed blocks poisoned.
import "abla/io"
import "abla/compiler"

class Item(val name: string, val values: array<int>)
class Load(val text: string, val items: array<Item>)

compile var load: Load = Load("", [])

// 16 MB of text first: the encoding then allocates more than half of what the compiler keeps, so it collects partway
// through, with the reply large (a freed reply of that size is given back to the system, and the next write faults).
compile fun fill(size: int, count: int): int {
    var text = "x"
    while (text.size < size) text = text + text
    val items: array<Item> = []
    var index = 0
    while (index < count) {
        items.append(Item("item $index", [index, index * 2, index * 3]))
        index = index + 1
    }
    load = Load(text, items)
    items.size
}

// Naming a compiler API call that takes a function keeps a site in the interpreter (the call itself never runs).
compile fun interpreted(value: int): int {
    if (value < 0) compilerApplyTransform({ })
    value
}

compile fun seen(): int {
    val last = load.items[load.items.size - 1]
    interpreted(load.text.size + last.values[2] + last.name.size)
}

val filled = #fill(16777216, 3000)
val later = #seen()

fun main: int {
    println("$filled $later")
    0
}
