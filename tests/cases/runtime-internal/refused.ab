// The runtime's address-yielding intrinsics and field-slot accessors are
// runtime-internal: a program may not call them, trusted or not. (The slot
// accessors are the runtime's own functions; a runtime without them reports
// them unknown as well.)
class Box(var value: int)

trusted fun trustedCalls(value: any, box: Box, items: array<int>): int {
    var total = ablaRuntimeValueAddress(value)
    total = total + ablaRuntimeValueWord0(value)
    total = total + __ablaRuntimeWord0(value)
    total = total + __ablaRuntimeWord1(value)
    total = total + __ablaRuntimeObjectAddress(box)
    total = total + __ablaRuntimeFieldAddressScan(0, 1, 0, 0)
    total = total + __ablaRuntimeFieldAddress(box, 0, 0)
    total = total + __ablaRuntimeFieldAddressIndexed(box, 0)
    total = total + __ablaRuntimeCellAddress(value)
    total = total + __ablaRuntimeArrayAddress(items)
    total = total + ablaRuntimeLoadSlotI32(total)
    total = total + ablaRuntimeLoadSlotI64(total)
    ablaRuntimeStoreSlotI32(total, 0)
    ablaRuntimeStoreSlotI64(total, 0)
    total
}

fun untrustedCall(value: any): int = ablaRuntimeValueWord0(value)

// Nor take one as a function value.
trusted fun leaked(): (any) -> int = __ablaRuntimeObjectAddress

fun main: int = trustedCalls(1, Box(2), [3]) + untrustedCall(4) + leaked()(5)
