// A function value's id is public: it exposes no memory.
fun first(): int = 1
fun second(): int = 2

fun main: int {
    val one = ablaRuntimeFunctionId(first)
    val two = ablaRuntimeFunctionId(second)
    val again = ablaRuntimeFunctionId(first)
    if (one == 0 || two == 0 || one == two || one != again) return 1
    if (ablaRuntimeFunctionId(7) != 0 || ablaRuntimeFunctionId("text") != 0) return 2
    42
}
