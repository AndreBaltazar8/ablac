// Built from a copy of the standard library that places it under abla/runtime
// (tools/runtime-fixture.sh): the runtime's own code calls its intrinsics.
import "abla/runtime/scalar"

class Box(var value: int)

trusted fun main: int {
    val box = Box(40)
    val word = ablaRuntimeValueWord0(2)
    val object = __ablaRuntimeObjectAddress(box)
    if (object == 0) return 1
    word + box.value
}
