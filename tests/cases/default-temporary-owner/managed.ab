import "abla/io"

var events: string = ""
class Item(var id: int)
resource class Holder(val item: Item) {
    fun drop(): void { item.id = 0; events = events + "H" }
}
var stored: array<Item> = []
fun save(x: Item = Holder(Item(7)).item): void { stored.append(x) }
fun produce(x: Item = Holder(Item(8)).item): Generator<int> = generator { yield x.id }
fun exercise(): string {
    events = ""
    stored = []
    save()
    events = events + "${stored[0].id}|"
    for (n in produce()) events = events + "$n"
    events
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
