import "abla/io"

var events: string = ""
resource class Item(val id: int) {
    fun drop(): void { events = events + "I$id" }
}
resource class Holder(val item: Item) {
    fun drop(): void { events = events + "H" }
}
resource class Local {
    fun drop(): void { events = events + "L" }
}
fun value(a: int, b: int = Holder(Item(a)).item.id): int {
    val local = Local()
    events = events + "F$b"
    b
}
fun early(x: int = Holder(Item(6)).item.id): int {
    val local = Local()
    events = events + "E$x"
    return x
}
fun direct(x: Item = Item(9)): void { events = events + "D${x.id}" }
fun choose(old: Item, flag: bool, x: Item = if (flag) Item(10) else old): int {
    events = events + "Q${x.id}"
    x.id
}
fun indirect(factory: () -> Item, x: Item = factory()): int { events = events + "P${x.id}"; x.id }
fun fresh(): Item = Item(14)
fun namedFactory(tag: int, x: Item = (if (true) fresh else fresh)()): int {
    events = events + "P${x.id}"
    x.id
}
fun namedOwn(tag: int, own x: Item = Item(16)): int {
    events = events + "N${x.id}"
    x.id
}
fun userPrefix(): void {
    val __abla_named_0_default_borrowed_0 = Item(17)
    events = events + "U"
}
fun side(): int { events = events + "S"; 0 }
fun pair(a: int, b: int): void {}
fun choices(): void {
    val held = Item(11)
    choose(held, true)
    events = events + "|"
    choose(held, false)
    events = events + "|"
}
class Methods {
    fun value(a: int, b: int = Holder(Item(a)).item.id): int {
        val local = Local()
        events = events + "M$b"
        b
    }
}
class Box(val a: int, val b: int = Holder(Item(a)).item.id)
fun exercise(): string {
    events = ""
    value(1)
    events = events + "|"
    value(2, 8)
    events = events + "|"
    Methods().value(3)
    events = events + "|"
    val box = Box(4)
    events = events + "C${box.b}|"
    value(a = 5)
    events = events + "|"
    pair(value(a = 15), side())
    events = events + "|"
    direct()
    events = events + "|"
    early()
    events = events + "|"
    early(0)
    events = events + "|"
    choices()
    events = events + "|"
    indirect({ Item(12) })
    events = events + "|"
    pair(namedFactory(tag = 0), side())
    events = events + "|"
    pair(namedOwn(tag = 0), side())
    events = events + "|"
    userPrefix()
    events = events + "|"
    events
}
val evaluated = #exercise()
fun main: int {
    println(exercise())
    println(evaluated)
    0
}
