// A native string copied by nativeCString keeps its text, and so do the
// strings made from it, after its native memory is overwritten and released;
// one read in place by borrowNativeCString shares that memory, and so can a
// string made from it.
import "abla/compiler"
import "abla/io"
import "abla/unsafe/memory"
#compilerGrant("trusted.native")

// Longer than a flat concatenation, so a template around it shares its parts.
val long = "a native string longer than the sixty-four bytes a concatenation copies"

// A native buffer holding text and its NUL.
trusted fun filled(text: string): NativeByteBuffer {
    val buffer = nativeByteBuffer(text.size + 1)
    var index = 0
    while (index < text.size) {
        buffer.store(index, text[index])
        index = index + 1
    }
    buffer.store(text.size, 0)
    buffer
}

trusted fun overwrite(var buffer: NativeByteBuffer, size: int): void {
    var index = 0
    while (index < size) {
        buffer.store(index, 120)
        index = index + 1
    }
}

// 1 for each copy that still reads the text after its memory is gone.
trusted fun copies(): int {
    val buffer = filled(long)
    val copied = nativeCString(buffer.address)
    val template = "${nativeCString(buffer.address)}"
    val joined = "" + nativeCString(buffer.address)
    val wrapped = "text: ${nativeCString(buffer.address)}"
    overwrite(buffer, long.size)
    buffer.close()
    var kept = 0
    if (copied == long) kept = kept + 1
    if (template == long) kept = kept + 1
    if (joined == long) kept = kept + 1
    if (wrapped == "text: $long") kept = kept + 1
    if (nativeCString(nativeNullPointer()) == "") kept = kept + 1
    val empty = filled("")
    if (nativeCString(empty.address) == "") kept = kept + 1
    empty.close()
    kept
}

// What borrowing gives: a string over the native bytes, and a template of it
// that shares them, so both read the overwrite (the native build).
trusted fun borrows(): int {
    val buffer = filled(long)
    val borrowed = borrowNativeCString(buffer.address)
    val template = "${borrowed}"
    var read = 0
    if (borrowed == long) read = read + 1
    overwrite(buffer, 1)
    if (borrowed[0] == 120) read = read + 1
    if (template[0] == 120) read = read + 1
    buffer.close()
    read
}

fun main(): int {
    val atRunTime = copies()
    val atCompileTime = #copies()
    print("native-cstring $atRunTime $atCompileTime ${borrows()}\n")
    if (atRunTime == 6 && atCompileTime == 6) 42 else 1
}
