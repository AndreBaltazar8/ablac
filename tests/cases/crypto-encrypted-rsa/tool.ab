import "abla/crypto/rsa"
import "abla/crypto/der"
import "abla/crypto/aes"
import "abla/crypto"
import "abla/fs"
import "abla/io"
import "abla/process/arguments"
fun number(index: int, fallback: int): int {
    if (processArgumentCount() <= index) return fallback
    val text = processArgument(index)
    var value = 0
    for (c in text) value = value * 10 + int(c) - 48
    value
}
fun main(): int {
    if (processArgument(2) == "software") aesUseHardware = false
    val password = cryptoPassword(processArgument(1))
    val bytes = Path(processArgument(0)).readText()
    val limits = RsaKeyReadLimits(maximumIterations = number(3, 1000000), maximumKdfWork = number(4, 8000000), maximumDerBytes = number(5, 1048576), maximumBags = number(6, 64), maximumDepth = number(7, 8))
    val path = processArgument(0)
    val pfx = path.size >= 4 && path.slice(path.size - 4, path.size) == ".p12"
    val key = if (pfx) rsaPrivateKeyFromPkcs12(bytes, password, limits) else if (pemLabel(bytes) != "") rsaPrivateKeyFromPem(bytes, password, limits) else rsaPrivateKeyFromDer(bytes, password, limits)
    if (!key.ok()) { println(key.error); return 1 }
    // Fixed fixture key identification; no private material is printed.
    println(hexEncode(sha256(key.modulus)))
    0
}
