import "abla/crypto/rsa"
import "abla/crypto"
import "abla/bytes"
var readerState = 1
fun readerRandom(count: int): string {
 val out = byteBuffer()
 for(i in 0 until count) { readerState = (readerState * 1103515245 + 12345) & 2147483647; out.appendText(byteEncode((readerState >> 16) & 255)) }
 out.toText()
}
fun readerCheck(): int {
 cryptoSetRandom({ count: int -> readerRandom(count) })
 val password = cryptoPassword("")
 val key = rsaPrivateKeyFromPkcs12(hexDecode("@P12HEX@"), password)
 if (!key.ok() || key.bits != 2048) return 1
 if (hexEncode(sha256(key.modulus)) != "ebeba98ef666cf584dfebad1922952ce1107cccaf63e3d74f357fd195b88dc44") return 2
 0
}
fun main(): int = readerCheck()
@export("check")
fun check(): int = readerCheck()
@export("simd_checks")
fun armCheck(): int = readerCheck()
