import "abla/build"
import "abla/compiler"
#compilerGrant("filesystem.write")
compile fun objectBuild(): bool {
 val target = defineTarget("pbe-arm", "aarch64-unknown-linux-gnu", "elf", "none", "none", false, false)
 target && buildProgram("pbe-arm", "@SOURCE@", "@OUTPUT@", "pbe-arm", "object", false, false)
}
val built = #objectBuild()
fun main(): int = if (built) 0 else 1
