// width * 100 + height * 10 + depth
fun makeBox(width: int, height: int, depth: int = 1): int = width * 100 + height * 10 + depth

class Placer(val base: int) {
    fun place(width: int, height: int, depth: int = 1): int = this.base * 1000 + width * 100 + height * 10 + depth
}

fun main(): int {
    val reordered = $reordered()
    val skipped = $skipped()
    val mixed = $mixed()
    val atCompile = #makeBoxAll()
    val generated = $generatedBox()
    val viaTarget = $generatedTarget()
    val viaMethod = $methodTarget(Placer(0).place(0, 0))
    println("$reordered $skipped $mixed $atCompile $generated $viaTarget $viaMethod")
    42
}

fun makeBoxAll(): int = $reordered() + $skipped() + $mixed()
