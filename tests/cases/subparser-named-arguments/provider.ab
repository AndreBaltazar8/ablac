import "abla/compiler"
import "abla/compiler/parser"

// Subparsers that build calls with named arguments. `$name()` takes no text.
compile fun noArguments(cursor: ParserCursor) {
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
}

compile fun named(name: string, value: int): SyntaxExpression =
    syntaxNamedArgument(name, syntaxInteger(value))

// makeBox(width, height, depth = 1): names out of declaration order.
compile fun parseReordered(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [named("height", 4), named("width", 3)]
    syntaxCall("makeBox", arguments)
}

// The default of `depth` is left out.
compile fun parseSkipped(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [named("width", 2), named("height", 5)]
    syntaxCall("makeBox", arguments)
}

// A positional argument, then named ones.
compile fun parseMixed(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [syntaxInteger(6), named("depth", 7), named("height",
        8)]
    syntaxCall("makeBox", arguments)
}

// Each of these is an error in ordinary code, and is one here.
compile fun parseUnknown(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [named("width", 1), named("height", 2), named("colour",
        3)]
    syntaxCall("makeBox", arguments)
}

compile fun parseOrder(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [named("width", 1), syntaxInteger(2)]
    syntaxCall("makeBox", arguments)
}

compile fun parseArity(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [syntaxInteger(1), syntaxInteger(2), syntaxInteger(3),
        syntaxInteger(4), named("depth", 5)]
    syntaxCall("makeBox", arguments)
}

compile fun parseDuplicate(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [named("width", 1), named("height", 2), named("width",
        3)]
    syntaxCall("makeBox", arguments)
}

compile fun parseRequired(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [named("width", 1)]
    syntaxCall("makeBox", arguments)
}

compile fun parseNoTarget(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [named("width", 1)]
    syntaxCall("noSuchFunction", arguments)
}

// A named argument anywhere but a call's argument list is refused.
compile fun parseInArray(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val elements: array<SyntaxExpression> = [named("width", 1)]
    syntaxArray(elements)
}

compile fun parseBare(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    named("width", 1)
}

compile fun parseNested(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val outer: array<SyntaxExpression> = [syntaxNamedArgument("width", named("height", 2))]
    syntaxCall("makeBox", outer)
}

compile fun parseBadName(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    val arguments: array<SyntaxExpression> = [syntaxNamedArgument("not a name", syntaxInteger(1))]
    syntaxCall("makeBox", arguments)
}

// The same call built in a finalizer's generated function: `generatedBox` is `makeBox(height = 4, width = 3)`.
compile fun finalizeBox(generatedName: string,
    expression: SyntaxExpression): GeneratedModuleBuilder {
    val module = compilerGeneratedModule(generatedName, expression)
    val names: array<string> = []
    val types: array<int> = []
    val arguments: array<SyntaxExpression> = [named("height", 4), named("width", 3)]
    compilerGeneratedExportFunction(
        module, generatedName, names, types, compilerFindType("i64"),
        syntaxCall("makeBox", arguments)
    )
    module
}

compile fun parseGeneratedBox(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    compilerRecordGeneratedExtensionRequest("generatedBox", "generatedBox", syntaxInteger(0),
        finalizeBox)
    val none: array<SyntaxExpression> = []
    syntaxCall("generatedBox", none)
}

// A named argument that is another's value, in a finalizer.
compile fun finalizeNested(generatedName: string,
    expression: SyntaxExpression): GeneratedModuleBuilder {
    val module = compilerGeneratedModule(generatedName, expression)
    val names: array<string> = []
    val types: array<int> = []
    val arguments: array<SyntaxExpression> = [syntaxNamedArgument("width", named("height", 4))]
    compilerGeneratedExportFunction(
        module, generatedName, names, types, compilerFindType("i64"),
        syntaxCall("makeBox", arguments)
    )
    module
}

compile fun parseGeneratedNested(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    compilerRecordGeneratedExtensionRequest("generatedNested", "generatedNested", syntaxInteger(0),
        finalizeNested)
    val none: array<SyntaxExpression> = []
    syntaxCall("generatedNested", none)
}

// The typed-target forms take named arguments too. `generatedTarget` is `makeBox(height = 4, width = 3)`
// bound to the declaration found by name.
compile fun finalizeTarget(generatedName: string,
    expression: SyntaxExpression): GeneratedModuleBuilder {
    val module = compilerGeneratedModule(generatedName, expression)
    val names: array<string> = []
    val types: array<int> = []
    val arguments: array<SyntaxExpression> = [named("height", 4), named("width", 3)]
    compilerGeneratedExportFunction(
        module, generatedName, names, types, compilerFindType("i64"),
        syntaxCallTarget(compilerFindFunction("makeBox"), arguments)
    )
    module
}

compile fun parseGeneratedTarget(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    compilerRecordGeneratedExtensionRequest("generatedTarget", "generatedTarget", syntaxInteger(0),
        finalizeTarget)
    val none: array<SyntaxExpression> = []
    syntaxCall("generatedTarget", none)
}

// `$methodTarget(placer.place(0, 0))` is `Placer(5).place(height = 4, width = 3)`, bound to the
// method handle of the call it wraps.
compile fun finalizeMethodTarget(generatedName: string,
    expression: SyntaxExpression): GeneratedModuleBuilder {
    val handle = typedCallTarget(expression)
    val module = compilerGeneratedModule(generatedName, expression)
    val names: array<string> = []
    val types: array<int> = []
    val receiverArguments: array<SyntaxExpression> = [syntaxInteger(5)]
    val receiver = syntaxCall("Placer", receiverArguments)
    val arguments: array<SyntaxExpression> = [named("height", 4), named("width", 3)]
    compilerGeneratedExportFunction(
        module, generatedName, names, types, compilerFindType("i64"),
        syntaxMethodCallTarget(handle, receiver, arguments)
    )
    module
}

compile fun parseMethodTarget(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val call = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest("generatedMethodTarget", "generatedMethodTarget", call,
        finalizeMethodTarget)
    val none: array<SyntaxExpression> = []
    syntaxCall("generatedMethodTarget", none)
}

// Each of these is an error in ordinary code, and is one through a target handle.
compile fun finalizeTargetUnknown(generatedName: string,
    expression: SyntaxExpression): GeneratedModuleBuilder {
    val module = compilerGeneratedModule(generatedName, expression)
    val names: array<string> = []
    val types: array<int> = []
    val arguments: array<SyntaxExpression> = [named("width", 1), named("height", 2), named("colour",
        3)]
    compilerGeneratedExportFunction(
        module, generatedName, names, types, compilerFindType("i64"),
        syntaxCallTarget(compilerFindFunction("makeBox"), arguments)
    )
    module
}

compile fun parseGeneratedTargetUnknown(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    compilerRecordGeneratedExtensionRequest("generatedTargetUnknown", "generatedTargetUnknown",
        syntaxInteger(0), finalizeTargetUnknown)
    val none: array<SyntaxExpression> = []
    syntaxCall("generatedTargetUnknown", none)
}

compile fun finalizeTargetNested(generatedName: string,
    expression: SyntaxExpression): GeneratedModuleBuilder {
    val module = compilerGeneratedModule(generatedName, expression)
    val names: array<string> = []
    val types: array<int> = []
    val arguments: array<SyntaxExpression> = [syntaxNamedArgument("width", named("height", 4))]
    compilerGeneratedExportFunction(
        module, generatedName, names, types, compilerFindType("i64"),
        syntaxCallTarget(compilerFindFunction("makeBox"), arguments)
    )
    module
}

compile fun parseGeneratedTargetNested(cursor: ParserCursor): SyntaxExpression {
    noArguments(cursor)
    compilerRecordGeneratedExtensionRequest("generatedTargetNested", "generatedTargetNested",
        syntaxInteger(0), finalizeTargetNested)
    val none: array<SyntaxExpression> = []
    syntaxCall("generatedTargetNested", none)
}

#compilerRegisterSubparser("reordered", parseReordered)
#compilerRegisterSubparser("skipped", parseSkipped)
#compilerRegisterSubparser("mixed", parseMixed)
#compilerRegisterSubparser("unknown", parseUnknown)
#compilerRegisterSubparser("order", parseOrder)
#compilerRegisterSubparser("arity", parseArity)
#compilerRegisterSubparser("duplicate", parseDuplicate)
#compilerRegisterSubparser("required", parseRequired)
#compilerRegisterSubparser("notarget", parseNoTarget)
#compilerRegisterSubparser("inarray", parseInArray)
#compilerRegisterSubparser("bare", parseBare)
#compilerRegisterSubparser("nested", parseNested)
#compilerRegisterSubparser("badname", parseBadName)
#compilerRegisterSubparser("generatedBox", parseGeneratedBox)
#compilerRegisterSubparser("generatedNested", parseGeneratedNested)
#compilerRegisterSubparser("generatedTarget", parseGeneratedTarget)
#compilerRegisterSubparser("methodTarget", parseMethodTarget)
#compilerRegisterSubparser("generatedTargetUnknown", parseGeneratedTargetUnknown)
#compilerRegisterSubparser("generatedTargetNested", parseGeneratedTargetNested)
