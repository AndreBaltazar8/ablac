// A hosted (OpenSSL) TLS client against whatever server the caller runs (tools/test-tls-hosted-verify.sh): connects to
// <host> <port> with the CA file <ca> and says whether the connection was made and verified, or why not. With a fourth
// argument, "linger", it then reads for a few seconds (a server may renegotiate meanwhile).
import "abla/io"
import "abla/integer"
import "abla/tls/hosted"
import "abla/sys/linux/process"

fun main: int {
    val host = linuxArgument(0)
    val port = linuxArgument(1).parseInt() ?? 0
    val ca = linuxArgument(2)
    val connection = tlsConnectWithCa(host, ca, port, 5000)
    if (connection.handle == -1) {
        println("refused")
        return 0
    }
    connection.write("ping\n")
    val reply = connection.read(64)
    println("connected [${reply.size}]")
    if (linuxArgument(3) == "linger") {
        connection.setTimeouts(5000, 5000)
        var more = connection.read(64)
        while (more.size > 0) {
            println("more [${more.size}]")
            more = connection.read(64)
        }
        println("lingered")
    }
    connection.close()
    0
}
