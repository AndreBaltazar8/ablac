// A hosted (OpenSSL) TLS server for tools/test-tls-hosted-verify.sh: listens on a free port with <certificate> <key>,
// prints the port, accepts one connection and answers each thing it reads ("pong <size>") until the peer closes; prints
// "accepted" at the end, or "refused" when the handshake failed.
import "abla/io"
import "abla/tls/hosted"
import "abla/sys/linux/process"

fun main: int {
    val listener = tlsListen(linuxArgument(0), linuxArgument(1), "127.0.0.1", 0)
    println("port ${listener.localPort()}")
    val connection = listener.accept(5000, 5000)
    if (connection.handle == -1) {
        println("refused")
        return 0
    }
    var request = connection.read(64)
    while (request.size > 0) {
        connection.write("pong ${request.size}\n")
        request = connection.read(64)
    }
    println("accepted")
    connection.close()
    0
}
