// What main.ab reaches only through middle.ab: an extension function, an extension operator, an overload of
// describe (the only one a string fits) and a better overload of label.
import "types.ab"

fun Point.doubled(): int = x * 2

operator fun Point.plus(other: Point): int = x + other.x

fun describe(text: string): string = "string"

fun label(text: string): string = "string"
