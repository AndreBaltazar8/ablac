// Uses extras.ab's extension, operator and overloads without importing it: a flat program builds and prints
// "6 4 string string"; strict, the first three are E_NAME_NOT_IMPORTED naming extras.ab, and label("s") takes the
// overload it sees (types.ab's) instead.
import "abla/io"
import "types.ab"
import "middle.ab"

fun main: int {
    val p = Point(3)
    println("${p.doubled()} ${p + Point(1)} ${describe("x")} ${label("s")}")
    middleValue() + 41
}
