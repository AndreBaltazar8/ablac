import "abla/build"
import "abla/wasm/build"

val wasmTarget = #wasm32Target()
val library = #buildProgram("coverage-library", "tests/cases/coverage-lib/lib.ab", "build/coverage/nested/libcov.o", "host", "object", true, true)
val child = #buildProgram("coverage-child", "tests/cases/coverage-nested/child.ab", "build/coverage/nested/child", "host", "executable", true, true)
val wasm = #buildProgram("coverage-wasm", "tests/cases/wasm-host/host.ab", "build/coverage/nested/host.wasm", "wasm32-module", "module", true, true)
fun main(): int = if (wasmTarget && library && child && wasm) 0 else 1
