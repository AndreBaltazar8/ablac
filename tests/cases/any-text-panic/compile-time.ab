// The same any-to-text interpolation as main.ab, run at compile time: it is a compile-time error with the panic's text.
class Item(val number: int)
fun text(value: any): string = "$value"
fun trigger(): int {
    val erased: any = Item(42)
    if (text(erased) == "") 0 else 1
}
val result = #trigger()
fun main: int = result
