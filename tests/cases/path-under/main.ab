// bootstrapPathUnder / bootstrapPathBelow (src/module_paths.ab): a path is under a root when it starts with the root and the separator, whatever the
// root: the file system root "/", a directory, a Windows drive "C:/" or share "//server/share/" (which already end with the separator) as the
// compiler reads them (bootstrapNormalizeModulePathIn(path, true)). Prints "path under: ok" and exits 0 when every case holds.
import "abla/io"
import "../../../src/module_paths.ab"

var failures = 0

fun expect(root: string, path: string, under: bool, below: string): void {
    val got = bootstrapPathUnder(root, path)
    if (got != under) {
        failures = failures + 1
        println("FAIL under(\"$root\", \"$path\") = $got, expected $under")
    }
    if (under && bootstrapPathBelow(root, path) != below) {
        failures = failures + 1
        println("FAIL below(\"$root\", \"$path\") = \"${bootstrapPathBelow(root, path)}\", expected \"$below\"")
    }
}

fun windows(path: string): string = bootstrapNormalizeModulePathIn(path, true)

fun main: int {
    // the file system root: "$root/" would be "//"
    expect("/", "/work/main.ab", true, "work/main.ab")
    expect("/", "/main.ab", true, "main.ab")
    expect("/", "/", false, "")
    // a directory
    expect("/work", "/work/main.ab", true, "main.ab")
    expect("/work", "/work/lib/a.ab", true, "lib/a.ab")
    expect("/work", "/work", false, "")
    expect("/work", "/workshop/a.ab", false, "")
    expect("/work", "/other/work/a.ab", false, "")
    // a root written with its trailing separator
    expect("/work/", "/work/main.ab", true, "main.ab")
    expect("/work/", "/workshop", false, "")
    // a Windows drive root and a directory on a drive, as the compiler reads them
    expect(windows("C:\\"), windows("C:\\a\\b.ab"), true, "a/b.ab")
    expect(windows("C:\\"), windows("D:\\a"), false, "")
    expect(windows("C:\\proj"), windows("C:\\proj\\src\\main.ab"), true, "src/main.ab")
    expect(windows("C:\\proj"), windows("C:\\project\\main.ab"), false, "")
    expect(windows("C:\\proj"), windows("C:\\proj"), false, "")
    // a share
    expect(windows("\\\\server\\share\\"), windows("\\\\server\\share\\a\\b.ab"), true, "a/b.ab")
    expect(windows("\\\\server\\share\\"), windows("\\\\server\\other\\a.ab"), false, "")
    expect(windows("\\\\server\\share\\dir"), windows("\\\\server\\share\\dir\\f"), true, "f")
    // no root: what the old "$root/" test did (every absolute path)
    expect("", "/x", true, "x")
    if (failures == 0) println("path under: ok")
    if (failures == 0) 0 else 1
}
