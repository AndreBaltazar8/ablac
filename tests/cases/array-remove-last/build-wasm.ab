import "abla/wasm/build"
val release = #wasmBuildModule(
    "array-move", "tests/cases/array-remove-last/wasm.ab",
    "build/array-remove-last-test/move.wasm", false, false
)
val fast = #buildProgram(
    "array-move-fast", "tests/cases/array-remove-last/wasm.ab",
    "build/array-remove-last-test/move-fast.wasm", "wasm32-module", "module", true, false
)
fun main: int = if (release && fast) 0 else 1
