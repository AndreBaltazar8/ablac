import "abla/array"
import "abla/float"
fun check(): bool {
    val xs = [10, 20, 30, 40]
    val second = xs.takeAt(1)
    val last = xs.removeLast()
    val first = xs.removeAt(0)
    xs.append(50)
    val words: array<u8> = [u8(255), u8(128), u8(1)]
    val word = words.takeAt(1)
    val bits = [true, false, true]
    val bit = bits.takeAt(1)
    val floats: array<f64> = [1.25, 2.5, -0.0]
    val float = floats.takeAt(1)
    val single: array<f32> = [1.25, 2.5]
    val small = single.removeLast()
    val a8: array<i8> = [i8(-128), i8(127)]
    val a16: array<i16> = [i16(-32768), i16(32767)]
    val b16: array<u16> = [u16(65535), u16(1)]
    val a32: array<i32> = [i32(-2147483648), i32(2147483647)]
    val b32: array<u32> = [u32(4294967295), u32(1)]
    val b64: array<u64> = [u64(-1), u64(1)]
    val chars: array<char> = [char(255), char(1)]
    val widths = a8.takeAt(0) == i8(-128) && a16.removeLast() == i16(32767) &&
        b16.takeAt(0) == u16(65535) && a32.takeAt(0) == i32(-2147483648) &&
        b32.takeAt(0) == u32(4294967295) && b64.takeAt(0) == u64(-1) &&
        chars.takeAt(0) == char(255)
    val doubles = [f64FromBits(-9223372036854775808), f64FromBits(9221120237041095220), f64FromBits(1)]
    val nan = doubles.takeAt(1)
    val tiny = doubles.removeLast()
    val negativeZero = doubles.removeLast()
    val singles = [f32FromBits(u32(2147483648)), f32FromBits(u32(2143289345)), f32FromBits(u32(1))]
    val singleNan = singles.takeAt(1)
    val singleTiny = singles.removeLast()
    val singleZero = singles.removeLast()
    val exactBits = f64ToBits(nan) == 9221120237041095220 && f64ToBits(tiny) == 1 &&
        f64ToBits(negativeZero) == -9223372036854775808 &&
        f32ToBits(singleNan) == u32(2143289345) && f32ToBits(singleTiny) == u32(1) &&
        f32ToBits(singleZero) == u32(2147483648)
    exactBits && widths && second == 20 && last == 40 && first == 10 && xs.size == 2 &&
        xs[0] == 30 && xs[1] == 50 && word == u8(128) && words.size == 2 &&
        words[0] == u8(255) && words[1] == u8(1) && !bit && bits.size == 2 &&
        bits[0] && bits[1] && float == 2.5 && floats.size == 2 && floats[0] == 1.25 &&
        floats[1] == -0.0 && small == 2.5 && single.size == 1
}
compile fun staged(): bool = check()
fun main: int = if (check() && #staged()) 0 else 1
