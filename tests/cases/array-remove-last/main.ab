import "abla/array"
class Item(val value: int)
fun check(): bool {
    val values = [1, 2, 3]
    val last = values.removeLast()
    val second = values.removeLast()
    val first = values.removeLast()
    val strings = ["a", "b"]
    val text = strings.removeLast()
    val objects = [Item(4), Item(5)]
    val object = objects.removeLast()
    last == 3 && second == 2 && first == 1 && values.size == 0 &&
        text == "b" && strings.size == 1 && strings[0] == "a" &&
        object.value == 5 && objects.size == 1 && objects[0].value == 4
}
compile fun staged(): bool = check()
fun main: int = if (check() && #staged()) 0 else 1
