// removeLast/removeAt on an array of a class with a `var` field (a managed element that tracks aliases):
// the removed element is the caller's, whether it is used or dropped, and whatever the receiver is.
import "abla/array"
class State(var value: int)
class Book(val states: array<State>)
class Shelf(val books: array<Book>)

fun Shelf.clear(index: int): void {
    while (this.books[index].states.size > 0) this.books[index].states.removeLast()
}

fun check(): bool {
    val local = [State(1), State(2), State(3)]
    local.removeLast()
    val second = local.removeLast()
    val first = local.removeAt(0)
    val shelf = Shelf([Book([State(7), State(8)])])
    shelf.clear(0)
    second.value == 2 && first.value == 1 && local.size == 0 && shelf.books[0].states.size == 0
}
compile fun staged(): bool = check()
fun main: int = if (check() && #staged()) 0 else 1
