import "abla/array"
class Log(var value: int)
resource class Ticket(val value: int, val log: Log) {
    fun close(): void { log.value = log.value * 10 + value; return }
    fun drop(): void { close(); return }
}
fun consume(own item: Ticket): int = item.value
fun last(log: Log): bool {
    val xs = [Ticket(1, log), Ticket(2, log), Ticket(3, log)]
    val item = xs.removeLast()
    item.value == 3 && xs.size == 2 && xs[0].value == 1 && xs[1].value == 2
}
fun middle(log: Log): bool {
    val xs = [Ticket(1, log), Ticket(2, log), Ticket(3, log)]
    val item = xs.takeAt(1)
    val valid = xs.size == 2 && xs[0].value == 1 && xs[1].value == 3
    valid && consume(move(item)) == 2
}
fun ignored(log: Log): void {
    val xs = [Ticket(1, log), Ticket(2, log), Ticket(3, log)]
    xs.removeAt(2)
    return
}
fun looping(log: Log): void {
    val xs = [Ticket(1, log), Ticket(2, log), Ticket(3, log)]
    while (xs.size > 0) {
        val item = xs.removeLast()
        if (item.value == 3) continue
        if (item.value == 2) break
    }
    return
}
fun reappend(log: Log): void {
    val xs = [Ticket(1, log), Ticket(2, log), Ticket(3, log)]
    val item = xs.removeAt(1)
    xs.append(move(item))
    return
}
fun extract(log: Log): Ticket {
    val xs = [Ticket(1, log), Ticket(2, log)]
    xs.removeLast()
}
fun returned(log: Log): bool {
    val item = extract(log)
    item.value == 2 && log.value == 1
}
fun nested(log: Log): void {
    val xs = [[Ticket(1, log)], [Ticket(2, log)]]
    val inner = xs.removeLast()
    return
}
fun check(): bool {
    val a = Log(0)
    val b = Log(0)
    val c = Log(0)
    val d = Log(0)
    val e = Log(0)
    val f = Log(0)
    val g = Log(0)
    val ok = last(a) && middle(b)
    ignored(c)
    looping(d)
    reappend(e)
    val ok2 = returned(f)
    nested(g)
    ok && ok2 && a.value == 312 && b.value == 213 && c.value == 312 &&
        d.value == 321 && e.value == 132 && f.value == 12 && g.value == 21
}
compile fun staged(): bool = check()
fun main: int = if (check() && #staged()) 0 else 1
