// A standard-library module imported under an alias: abla/json declares a method named `string` (JsonEncoder.string), which must not make the type
// `string` take the module's prefix inside the aliased module (it once did: about a thousand semantic errors in the module). The program exits 42.
import "abla/io"
import "abla/json" as j

fun main: int {
    val parsed = j.jsonParse("{\"answer\":42}")
    if (!parsed.succeeded) return 1
    println("alias ok")
    parsed.value.getInt("answer")
}
