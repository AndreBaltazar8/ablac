// A parser provider whose handler keeps state across every use in a compilation: a
// `compile val` object it appends to, a `compile var` it reassigns, and one output it
// rewrites with the whole tally each time.
import "abla/compiler"
import "abla/compiler/parser"

class Tally(val names: array<string>, var count: int)
compile val tally: Tally = Tally([], 0)
compile var rounds: int = 0

compile fun tallyParse(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    val name = parserRawTakeName(cursor)
    tally.names.append(name)
    tally.count += 1
    rounds = rounds + 1
    var listing = ""
    for (n in tally.names) listing = "$listing$n\n"
    val unused = compilerWriteFile("build/compile-globals/tally.txt", listing)
    syntaxInteger(tally.names.size)
}
#compilerRegisterSubparser("tally", tallyParse)

compile fun tallySeen(): int = tally.count * 10 + rounds
