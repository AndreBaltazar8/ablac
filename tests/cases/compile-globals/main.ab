// Compile-time globals keep one value for the whole compilation (parser handlers in two
// modules and a compile expression see the same tally), a path written again replaces its
// staged output, and a directory lists at compile time (sorted).
import "abla/compiler"
import "abla/platform/host"
#compilerGrant("filesystem.write")
#compilerGrant("filesystem.read")
import "provider.ab"
import "other.ab"

fun first(): int = $tally first
fun second(): int = $tally second

compile fun listed(): string {
    var out = ""
    for (name in ablaHostListDirectory("tests/cases/compile-globals/listed")) out = "$out$name,"
    out
}

val seen: int = #tallySeen()
val names: string = #listed()

fun main: int {
    val counts = first() + second() + third()
    if (seen == 33 && counts == 6 && names == "a.txt,b.txt,c.txt,") return 42
    1
}
