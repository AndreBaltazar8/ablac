// vsnprintf over an AAPCS64 va_list (src/static_libc/format.ab, #1139 area 14), built and run for aarch64-linux by tools/test-libc-functions.sh
// against a copy of the library without its @export lines. The list is the one the static libc's variadic shims (src/toolchain.ab) build: the
// offsets of the general and vector save areas are negative 32-bit words. Integers, a string, doubles and long doubles (binary128) come first
// from the registers, then from the stack; a reader that took the offsets as unsigned read every argument from the stack. Exits 42.
import "abla/io"
import "abla/bytes"
import "abla/runtime/scalar"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../../../src/static_libc/format.ab"

trusted fun cString(text: string): int {
    val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(text.size + 1))
    for (i in 0 until text.size) ablaRuntimeStoreU8(address + i, text[i])
    ablaRuntimeStoreU8(address + text.size, 0)
    address
}

trusted fun main: int {
    // General registers x5, x6, x7 left (gr_offs -24): 11, 22 and a string; vector registers q6, q7 left (vr_offs -32): 1.5 and the long
    // double 2.25. The stack: 33, the double 4.5, then the long double 8.125 at the next 16-aligned slot.
    val general = ablaUnsafePointerAddress(ablaUnsafeAllocate(64))
    ablaRuntimeStoreI64(general + 40, 11)
    ablaRuntimeStoreI64(general + 48, 22)
    ablaRuntimeStoreI64(general + 56, cString("ok"))
    val vector = ablaUnsafePointerAddress(ablaUnsafeAllocate(128))
    ablaRuntimeStoreI64(vector + 96, 4609434218613702656)
    ablaRuntimeStoreI64(vector + 112, 0)
    ablaRuntimeStoreI64(vector + 120, 4611721202799476736)
    val stack = (ablaUnsafePointerAddress(ablaUnsafeAllocate(64)) + 15) & -16
    ablaRuntimeStoreI64(stack, 33)
    ablaRuntimeStoreI64(stack + 8, 4616752568008179712)
    ablaRuntimeStoreI64(stack + 16, 0)
    ablaRuntimeStoreI64(stack + 24, 4612253366427320320)
    val list = ablaUnsafePointerAddress(ablaUnsafeAllocate(32))
    ablaRuntimeStoreI64(list, stack)
    ablaRuntimeStoreI64(list + 8, general + 64)
    ablaRuntimeStoreI64(list + 16, vector + 128)
    ablaRuntimeStoreI32(list + 24, -24)
    ablaRuntimeStoreI32(list + 28, -32)
    val buffer = ablaUnsafePointerAddress(ablaUnsafeAllocate(128))
    val count = libcVsnprintf(buffer, 128, cString("%d %d %s %d %.1f %Lf %.2f %.3Lf"), list)
    var text = ""
    var at = 0
    while (ablaRuntimeLoadU8(buffer + at) != 0) {
        text = text + byteEncode(ablaRuntimeLoadU8(buffer + at))
        at = at + 1
    }
    val expected = "11 22 ok 33 1.5 2.250000 4.50 8.125"
    if (text != expected || count != expected.size) {
        println("libc-format-aarch64: [$text] ($count), expected [$expected]")
        return 1
    }
    42
}
