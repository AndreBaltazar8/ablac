import "abla/io"
import "abla/xml"

fun main {
    val message = "<unsafe>&"
    val count = 2
    val node = $xml <p:item p:id={count} xmlns:p="urn:item" xmlns="urn:default"><data a="a&#9;b">{message} &amp; &#xE9;</data><!--note--><![CDATA[<plain>]]><?ready yes?></p:item>
    val child = node.child("data", "urn:default")
    if (node.namespaceUri != "urn:item" || node.attributeValue("id", "", "urn:item") != "2" || child == null) return
    if (child.attributeValue("a") != "a\tb" || child.text() != "<unsafe>& & é") return
    val frozen = #$xml <é xmlns="urn:accent"/>
    if (frozen.namespaceUri != "urn:accent" || frozen.localName != "é") return
    val nodes: array<XmlNode> = [node, frozen]
    val parent = $xml <parent>{nodes nodes}{node frozen}</parent>
    if (parent.children.size != 3) return
    println("ok")
}
