// A small module graph for the editor under compiler GC stress (tools/test-analysis-gc-stress.sh): main depends on shapes,
// and both on util, the module the session edits.
import "abla/io"
import "./shapes.ab"
import "./util.ab"

fun main(): int {
    val squares = [Square(1), Square(2), Square(3)]
    var total = 0
    for (square in squares) total += area(square)
    println("$total ${twice(4)}")
    0
}
