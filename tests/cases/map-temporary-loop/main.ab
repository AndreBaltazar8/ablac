import "abla/io"
var log: string = ""
resource class Item(val id: int) {
    fun drop(): void { log += "I$id" }
    fun look(): void { log += "B$id" }
}
resource class Source(val id: int) {
    fun drop(): void { log += "I$id" }
    fun values(): array<int> { log += "B$id"; [id] }
}
resource class Holder(val items: array<Item>) {
    fun drop(): void { log += "H" }
}
fun items(): array<Item> = [Item(1), Item(2)]
fun holderLoop(): void { for (x in Holder(items()).items) { x.look() } }
fun holderOuter(): Generator<int> = generator {
    for (x in Holder(items()).items) { x.look(); yield x.id }
}
fun custom(fresh: bool): void {
    val existing = Source(2)
    for (x in (if (fresh) Source(1) else existing).values()) { log += "V$x" }
    log += "|"
}
fun customOuter(fresh: bool): Generator<int> = generator {
    val existing = Source(4)
    for (x in (if (fresh) Source(3) else existing).values()) { log += "V$x"; yield x }
}
fun mapping(): Map<string, Item> {
    val m: Map<string, Item> = Map()
    m.set("a", Item(1)); m.set("b", Item(2)); m
}
fun values(): void { for (x in mapping().values()) { x.look() } }
fun keys(): void { for (x in mapping().keys()) { log += x } }
fun moved(): void {
    val m = mapping()
    for (x in move(m).values()) { x.look() }
}
fun mixed(fresh: bool): void {
    val m = mapping()
    for (x in if (fresh) mapping().values() else m.values()) { x.look() }
}
fun outer(): Generator<int> = generator {
    for (x in mapping().values()) { x.look(); yield x.id }
}
fun outerMoved(): Generator<int> = generator {
    val m = mapping()
    for (x in move(m).values()) { x.look(); yield x.id }
}
fun outerKeys(): Generator<int> = generator {
    for (x in mapping().keys()) { log += x; yield 1 }
}
fun outerMixed(fresh: bool): Generator<int> = generator {
    val m = mapping()
    for (x in if (fresh) mapping().values() else m.values()) { x.look(); yield x.id }
}
fun outerNested(): Generator<int> = generator {
    for (key in mapping().keys()) {
        for (x in mapping().values()) { x.look(); yield x.id }
    }
}
fun exercise(): string {
    log = ""
    values(); log += "|"
    keys(); log += "|"
    moved(); log += "|"
    mixed(true); log += "|"
    mixed(false); log += "|"
    for (x in outer()) { break }; log += "|"
    for (x in outerMoved()) { break }; log += "|"
    for (x in outerKeys()) { break }; log += "|"
    for (x in outerMixed(true)) { break }; log += "|"
    for (x in outerMixed(false)) { break }; log += "|"
    for (x in outerNested()) { break }; log += "|"
    holderLoop(); log += "|"
    for (x in holderOuter()) { break }; log += "|"
    custom(true); custom(false)
    for (x in customOuter(true)) { break }; log += "|"
    for (x in customOuter(false)) { break }; log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
