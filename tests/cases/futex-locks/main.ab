// Mutex, the heap lock and thread joins under contention (#806: on x86-64
// Linux the runtime's locks are futexes, not libpthread's): eight threads
// each take one Mutex 4000 times and allocate on every turn, so the heap
// lock is contended too. tools/test-futex-locks.sh.
import "abla/io"

resource class Tally(var count: int, var bytes: int)

fun bump(var tally: Tally): int {
    val text = "item-${tally.count}-${tally.bytes % 97}"
    tally.count += 1
    tally.bytes += text.size
    tally.count
}

fun countOf(var tally: Tally): int = tally.count

fun work(state: Mutex<Tally>, rounds: int): int {
    var last = 0
    var local = ""
    for (i in 0 until rounds) {
        last = state.with(bump)
        if (i % 64 == 0) local = "$local$i,"
    }
    last + local.size - local.size
}

fun main: int {
    val state = Mutex(Tally(0, 0))
    val rounds = 4000
    val a = state.clone()
    val b = state.clone()
    val c = state.clone()
    val d = state.clone()
    val e = state.clone()
    val f = state.clone()
    val g = state.clone()
    val h = state.clone()
    val t1 = thread { work(a, 4000) }
    val t2 = thread { work(b, 4000) }
    val t3 = thread { work(c, 4000) }
    val t4 = thread { work(d, 4000) }
    val t5 = thread { work(e, 4000) }
    val t6 = thread { work(f, 4000) }
    val t7 = thread { work(g, 4000) }
    val t8 = thread { work(h, 4000) }
    var highest = 0
    for (seen in [await t1, await t2, await t3, await t4, await t5, await t6, await t7, await t8]) {
        if (seen > highest) highest = seen
    }
    val total = state.with(countOf)
    println("futex locks: $total of ${8 * rounds}, highest $highest")
    if (total == 8 * rounds && highest == total) 0 else 1
}
