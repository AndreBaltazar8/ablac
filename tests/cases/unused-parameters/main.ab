// tools/test-unused-parameters.sh: `ignored` (of `area`) and `spare` (of `Shape.describe`) are never used (two warnings); the
// others are: read, interpolated, captured, passed on; `_unused` starts with `_`; `Square.draw` implements an interface and
// `main`'s are the program's, and `combine`, passed as a value, has the signature its user fixed.
import "abla/io"

interface Drawable {
    fun draw(scale: int): int
}

class Square(val side: int) : Drawable {
    fun draw(scale: int): int = side
}

class Shape(val sides: int) {
    fun describe(spare: int): int = sides
}

fun area(width: int, height: int, ignored: int): int = width * height

fun kept(_unused: int, captured: int, text: string): int {
    val add = { extra: int -> extra + captured }
    println("$text")
    add(1)
}

fun combine(left: int, right: int): int = left

fun apply(function: (int, int) -> int): int = function(1, 2)

fun main: int {
    println("${area(2, 3, 4)} ${kept(1, 2, "t")} ${Shape(3).describe(0)} ${Square(5).draw(1)} ${apply(combine)}")
    0
}
