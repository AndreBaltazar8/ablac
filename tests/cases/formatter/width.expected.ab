fun combine(firstArgument: int, secondArgument: int, thirdArgument: int,
    fourthArgument: int): int = firstArgument + secondArgument + thirdArgument + fourthArgument
fun main(): int {
    val result = combine(firstArgument = 111, secondArgument = 222, thirdArgument = 333,
        fourthArgument = 444)
    result
}
