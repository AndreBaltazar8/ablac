import "../../../src/formatter.ab"
import "../../../src/formatter_cli.ab"
import "abla/sys/linux"
import "abla/sys/linux/fs"
import "../../../src/parser.ab"
import "../../../src/lexer.ab"

fun validation(source: string, candidate: string): string {
    val trivia: array<BootstrapTrivia> = []
    val tokens = bootstrapLexWithTrivia(source, trivia)
    bootstrapFormatValidate(source, candidate, bootstrapParse(source), tokens, trivia)
}

fun main(): int {
    val source = "fun f(): int = 1\n"
    if (validation(source, "fun f(): int = 2\n") != "significant tokens changed") return 1
    val before = "fun f(): int { return\n1 }\n"
    val after = "fun f(): int { return 1 }\n"
    if (validation(before, after) != "parsed syntax changed") return 2
    val trailing = "fun f(): int {\n    val x = 1 // attached\n    x\n}\n"
    val moved = "fun f(): int {\n    val x = 1\n    // attached\n    x\n}\n"
    if (validation(trailing, moved) != "comment attachment changed") return 3
    if (validation(source, "fun  f(): int = 1\n") != "formatting is not idempotent") return 4
    if (bootstrapFormatAstEqual(bootstrapParse("fun f(): int = 1 - 2\n"),
        bootstrapParse("fun f(): int = 2 - 1\n"), [], [])) return 5
    if (bootstrapFormat("/* unterminated").error == "") return 6
    if (bootstrapFormat("fun f( {").error == "") return 7
    val files: array<string> = []
    if (bootstrapFormatCollect(Path("src"), files) != "") return 15
    if (bootstrapFormatCollect(Path("stdlib"), files) != "") return 16
    val expected = linuxEnvironment("ABLA_FORMATTER_EXPECTED_FILES")
    if (!expected.found || expected.value != "${files.size}") return 17
    if (validation("fun f(): string = \"\"\n", "fun f(): string = \"\"\n") != "") return 11
    val interpolation = "fun f(): string = \"\${1 + 2}\"\n"
    val changedInterpolation = "fun f(): string = \"\${1+2}\"\n"
    if (validation(interpolation, changedInterpolation) != "verbatim source changed") return 12
    if (validation("val x = \$custom { a  + b }\n", "val x = \$custom { a + b }\n") != "verbatim source changed") return 13
    val signature = "fun f(a: Map<string, int>, b: int): int = b\n"
    val signatureTokens = bootstrapLex(signature)
    val roles: Map<int, int> = Map()
    val traced = bootstrapFormatParameterParse(signature, signatureTokens, roles)
    if (roles.size != 1) return 8
    if (!bootstrapFormatAstEqual(bootstrapParse(signature), traced, signatureTokens, signatureTokens)) return 9
    val ordinary = BootstrapParser("<memory>", signature, signatureTokens, [], [], [], 0, 0, "", [], [], 0, -1, 0, "")
    ordinary.parse()
    if (ordinary.layoutTrace != "") return 10
    42
}
