// abla/__T__ against tools/wide-integers/gen-cases.py, whose answers are Python's: the number of the
// first line that disagrees, or 0. `_` in a case's text stands for a space, and alone for nothing.
// Lines tagged @u, @s, @256 or @128 are for that kind of type only (tools/wide-integers/stage.py).
import "abla/__T__"
import "abla/ct"
import "abla/simd"

// A case's own operand that doesn't parse is a failure of the case, not a stand-in value.
var wordFailed = false
fun nibble(c: int): int = if (c <= 57) c - 48 else c - 87
fun decoded(hex: string): string {
    var out = ""
    var at = 0
    while (at < hex.size) {
        out = "$out${char(nibble(int(hex[at])) * 16 + nibble(int(hex[at + 1])))}"
        at = at + 2
    }
    out
}
fun encoded(bytes: string): string {
    val digits = "0123456789abcdef"
    var out = ""
    for (at in 0 until bytes.size) {
        val byte = int(bytes[at])
        out = "$out${char(int(digits[byte >> 4]))}${char(int(digits[byte & 15]))}"
    }
    out
}
// The hex digits of a value that isn't negative, without 0x.
fun digits(value: __T__): string = value.toHex().slice(2, value.toHex().size)
fun upper(c: int): int = int("0123456789abcdef"[nibble(c) + 8])
// A case's value: its hex is the bits of the value. Spelled out with FromHex, not bytes, so the checks
// allocate little (a target with no collector runs them all).
@u fun word(text: string): __T__ {
@u     val value = __T__FromHex(text)
@u     if (value == null) {
@u         wordFailed = true
@u         return __T__Max()
@u     }
@u     value
@u }
@s fun word(text: string): __T__ {
@s     if (text.size < __BYTES__ * 2 || nibble(int(text[0])) < 8) {
@s         val value = __T__FromHex(text)
@s         if (value == null) {
@s             wordFailed = true
@s             return __T__(0)
@s         }
@s         return value
@s     }
@s     val rest = __T__FromHex("${char(int("01234567"[nibble(int(text[0])) - 8]))}${text.slice(1, text.size)}")
@s     if (rest == null) {
@s         wordFailed = true
@s         return __T__(0)
@s     }
@s     __T__Min() + rest
@s }
// The bits of a value in hex, without leading zeros.
@u fun low(value: __T__): string = digits(value)
@s fun low(value: __T__): string {
@s     if (!value.isNegative()) return digits(value)
@s     var rest = digits(value - __T__Min())
@s     while (rest.size < __BYTES__ * 2) rest = "0$rest"
@s     "${char(upper(int(rest[0])))}${rest.slice(1, rest.size)}"
@s }
fun text(value: __T__?): string = if (value == null) "n" else low(value)
fun yes(value: bool): string = if (value) "1" else "0"
fun spaced(value: string): string {
    if (value == "_") return ""
    var out = ""
    for (at in 0 until value.size) {
        val c = value[at]
        out = if (int(c) == 95) "$out " else "$out${char(int(c))}"
    }
    out
}
fun narrowed(value: u64?): string = if (value == null) "n" else low(__T__(value))
fun narrowedInt(value: int?): string = if (value == null) "n" else low(__T__(value))

fun answer(operation: string, x: string, y: string): string {
    if (operation == "decp") return text(__T__FromDecimal(spaced(x)))
    if (operation == "hexp") return text(__T__FromHex(spaced(x)))
    if (operation == "bytesp") return text(__T__FromBytes(decoded(x)))
    if (operation == "bytesple") return text(__T__FromBytesLittleEndian(decoded(x)))
    val a = word(x)
    val b = word(y)
    if (wordFailed) return "!word"
    when (operation) {
        // low() builds a result from sub and toHex; this ties it to toBytes, which "bytes" checks against Python.
        "lowc" -> {
            val hex = encoded(a.toBytes())
            var at = 0
            while (at < hex.size - 1 && int(hex[at]) == 48) at = at + 1
            return yes(low(a) == hex.slice(at, hex.size))
        }
        "add" -> return low(a + b)
        "sub" -> return low(a - b)
        "mul" -> return low(a * b)
        "div" -> return low(a / b)
        "rem" -> return low(a % b)
        "and" -> return low(a & b)
        "or" -> return low(a | b)
        "xor" -> return low(a ^ b)
        "not" -> return low(~a)
        "neg" -> return low(-a)
        "lt" -> return yes(a < b)
        "le" -> return yes(a <= b)
        "gt" -> return yes(a > b)
        "ge" -> return yes(a >= b)
        "eq" -> return yes(a == b)
        "ne" -> return yes(a != b)
        "addc" -> return text(a.addChecked(b))
        "subc" -> return text(a.subChecked(b))
        "mulc" -> return text(a.mulChecked(b))
        "shl" -> return low(a << b.toInt())
        "shr" -> return low(a >> b.toInt())
@s        "ushr" -> return low(a.ushr(b.toInt()))
@u        "shlw" -> return low(a.shl(b))
@u        "shrw" -> return low(a.shr(b))
        "dec" -> return a.toDecimal()
        "hexs" -> return a.toHex()
        "bytes" -> return encoded(a.toBytes())
        "bytesle" -> return encoded(a.toBytesLittleEndian())
@u        "bits" -> return word(low(__T__(a.bitLength()))).toDecimal()
@s        "sign" -> return "${a.signum() + 1}"
@s        "abs" -> return low(a.abs())
        "bit" -> return yes(a.bit(b.toInt()))
        "u64" -> return low(__T__(a.toU64()))
        "u32" -> return low(__T__(a.toU32()))
        "u16" -> return low(__T__(a.toU16()))
        "u8" -> return low(__T__(a.toU8()))
        "sext" -> return low(__T__(a.toInt()))
        "zext" -> return low(__T__(a.toU64()))
        "u64n" -> return narrowed(a.toU64OrNull())
        "intn" -> return narrowedInt(a.toIntOrNull())
        "u32n" -> {
            val narrow = a.toU32OrNull()
            return if (narrow == null) "n" else low(__T__(narrow))
        }
        "u16n" -> {
            val narrow = a.toU16OrNull()
            return if (narrow == null) "n" else low(__T__(narrow))
        }
        "u8n" -> {
            val narrow = a.toU8OrNull()
            return if (narrow == null) "n" else low(__T__(narrow))
        }
@s        "i32n" -> {
@s            val narrow = a.toI32OrNull()
@s            return if (narrow == null) "n" else low(__T__(narrow))
@s        }
        else -> return "?"
    }
}

fun __T__Checks(cases: string): int {
    var line = 0
    var begin = 0
    val fields = ["", "", "", ""]
    var field = 0
    for (at in 0 until cases.size) {
        val c = int(cases[at])
        if (c == 32 || c == 10) {
            fields[field] = cases.slice(begin, at)
            begin = at + 1
            field = field + 1
        }
        if (c == 10) {
            line = line + 1
            field = 0
            if (answer(fields[0], fields[1], fields[2]) != fields[3]) return line
        }
    }
    __T__LanguageChecks()
}

// What Python has no opinion on: how the language carries a __T__.
class Holder(val value: __T__, var other: __T__ = __T__(9))
val SHARED = __T__(7)
var COUNTER = __T__(0)
fun defaulted(a: __T__ = __T__(5)): __T__ = a
fun maybe(flag: bool): __T__? = if (flag) SHARED else null
fun viaWhen(k: int): __T__ = when (k) {
    0 -> SHARED
    else -> __T__(9)
}
fun takesFn(f: (__T__) -> __T__): __T__ = f(SHARED)
fun <T> same(value: T): T = value
fun __T__LanguageChecks(): int {
    COUNTER = COUNTER + SHARED
    COUNTER += SHARED
    if (COUNTER != __T__(14)) return -1
    if (defaulted() != __T__(5) || defaulted(SHARED) != SHARED) return -2
    val m = maybe(true)
    if (m == null || m != SHARED) return -3
    if (maybe(false) != null) return -4
    if (viaWhen(0) != SHARED || viaWhen(1) != __T__(9)) return -5
    if (takesFn({ x: __T__ -> x + x }) != __T__(14)) return -6
    val map = Map<string, __T__>()
    map.set("k", SHARED)
    val found = map.get("k")
    if (found == null || found != SHARED) return -7
@u    val biggest = __T__Max()
@s    val biggest = __T__Max()
    val holder = Holder(biggest)
    holder.other = holder.value - __T__(1)
    if (holder.value <= holder.other) return -8
@u    val list = [__T__(1), __T__Max()]
@s    val list = [__T__(1), __T__Max()]
    list.append(list[0] + list[1])
@u    if (!list[2].isZero()) return -9
@s    if (list[2] != __T__Min()) return -9
    if (same(SHARED) != SHARED) return -10
    if ("${__T__(1) << 64} $SHARED" != "18446744073709551616 7") return -11
    var i = __T__(0)
    var steps = 0
    while (i < __T__(10)) {
        i += __T__(3)
        steps = steps + 1
    }
    if (steps != 4) return -12
@u    if (__T__OrNull(-1) != null || __T__OrNull(3) != __T__(3)) return -14
@u    if (__T__(i8(-1)) != __T__Max() || __T__(u8(255)) != __T__(255)) return -15
@s    if (__T__(i8(-1)) != __T__(0) - __T__(1) || __T__(u8(255)) != __T__(255)) return -15
@u    if (__T__(i32(-2)) != __T__Max() - __T__(1) || __T__(u32(4294967295)) != __T__(4294967295)) return -16
@s    if (__T__(i32(-2)) != __T__(0) - __T__(2) || __T__(u32(4294967295)) != __T__(4294967295)) return -16
@256    if (__T__Words(__WORDS__) != __T__(4294967298)) return -17
@128    if (__T__Words(__WORDS__) != __T__(4294967298)) return -17
    if ((__T__(1) << -1) != __T__(0) || (__T__(1) >> -1) != __T__(0)) return -18
    if ((__T__(1) << u8(4)) != __T__(16) || (__T__(16) >> u32(4)) != __T__(1)) return -19
@s    if ((__T__(0) - __T__(16)) >> u32(2) != __T__(0) - __T__(4)) return -20
@s    if (__T__Min() / (__T__(0) - __T__(1)) != __T__Min() || __T__Min() % (__T__(0) - __T__(1)) != __T__(0)) return -21
@s    if (__T__(0) - __T__(7) / __T__(2) != __T__(0) - __T__(3) || (__T__(0) - __T__(7)) % __T__(2) != __T__(0) - __T__(1)) return -22
    0
}
