// `type Wei = __T__` is a __T__ by another name, in a local, a field, an array and an `if`.
import "abla/__T__"
type Wei = __T__
class Bill(val owed: Wei)
fun plain(amount: Wei): __T__ = amount
fun fee(amount: Wei): Wei = Wei(plain(amount) / __T__(100))
fun pick(c: bool, a: Wei, b: Wei): Wei = if (c) a else b
fun main: int {
    val a = Wei(__T__(1000000))
    val b = fee(a)
    val bill = Bill(b)
    val held: array<Wei> = [a, b]
    val owed: __T__ = bill.owed
    if (owed != __T__(10000)) return 1
    if (plain(held[0]) != __T__(1000000)) return 2
    if ("$a" != "1000000") return 3
    if (plain(pick(false, a, b)) != __T__(10000)) return 4
    0
}
