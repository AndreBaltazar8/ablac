// What `#` gives is what the same code gives at run time, down to the byte.
import "abla/io"
import "abla/__T__"

type Wei = __T__

compile fun compiled(): string = table()
fun computed(): string = table()

fun table(): string {
    val edge: array<__T__> = [
        __T__(0), __T__(1), __T__(-1), __T__(255), __T__(1) << 64, (__T__(1) << 64) - __T__(1),
        __T__Max(), __T__Words(__EDGEWORDS__)
    ]
    var out = ""
    // Shift counts around the width, through the operators.
    val counts: array<int> = [0, 1, __BITS__ - 1, __BITS__, __BITS__ + 1, -1]
    for (a in edge) {
        for (c in counts) {
@u            out = "$out${a << c} ${a >> c}\n"
@s            out = "$out${a << c} ${a >> c} ${a.ushr(c)}\n"
        }
    }
@s    out = "$out${__T__Min()} ${__T__Min() / __T__(-1)} ${__T__Min() % __T__(-1)} ${__T__Min() >> 5} ${__T__Min().abs()} ${__T__Min() < __T__(0)}\n"
    for (a in edge) {
@u        out = "$out$a ${a.toHex()} ${a.bitLength()} ${a.toU64()} ${a.isZero()} ${~a} ${-a} ${a << 13} ${a >> 100} ${a.shl(__T__(127))}\n"
@s        out = "$out$a ${a.toHex()} ${a.signum()} ${a.abs()} ${a.toU64()} ${a.isZero()} ${~a} ${-a} ${a << 13} ${a >> 100} ${a.ushr(100)} ${a.toBytes() == a.toBytesLittleEndian()}\n"
        for (b in edge) {
            out = "$out${a + b} ${a - b} ${a * b} ${a & b} ${a | b} ${a ^ b} ${a == b} ${a != b} ${a < b} ${a <= b} ${a > b} ${a >= b}"
            if (!b.isZero()) out = "$out ${a / b} ${a % b}"
            val added = a.addChecked(b)
            out = "$out ${if (added == null) "over" else "$added"}\n"
@s            val multiplied = a.mulChecked(b)
@s            out = "$out ${if (multiplied == null) "over" else "$multiplied"}\n"
        }
    }
@u    val parsed = __T__FromDecimal(__MAXDECIMAL__)
@s    val parsed = __T__FromDecimal("-" + __MINDECIMAL__)
@u    "$out${parsed == __T__Max()} ${__T__FromBytes(__T__(258).toBytes()) == __T__(258)}\n"
@s    "$out${parsed == __T__Min()} ${__T__FromBytes(__T__(-258).toBytes()) == __T__(-258)} ${__T__FromBytesLittleEndian(__T__(-258).toBytesLittleEndian()) == __T__(-258)}\n"
}

fun id(x: __T__): __T__ = x
class Box(val value: __T__, val list: array<__T__>)
compile fun made(): __T__ = __T__(7) << 90
compile fun madeBox(): Box = Box(__T__(5) << 70, [__T__(3), __T__(4) << 80])
compile fun wei(): Wei = Wei(__T__(1) << 100)
val atCompileTime = #compiled()
val lifted = #(__T__Max() - __T__(5))
val several = #[__T__(1), __T__(1) << 100]
val maybe: __T__? = #__T__Max().addChecked(__T__(0))
val named = #wei()
val passed = id(#made())
val typed: __T__ = #made()
val boxed = #madeBox()
@s val negative = #(__T__(0) - __T__(5))
@s val minimum = #(__T__Min() / __T__(-1))

fun main: int {
    if (atCompileTime != computed()) {
        println(atCompileTime)
        println(computed())
        return 1
    }
    if (lifted != __T__Max() - __T__(5)) return 2
    if (several[1] != __T__(1) << 100) return 3
    if (maybe == null || maybe != __T__Max()) return 4
    val plain: __T__ = named
    if (plain != __T__(1) << 100) return 5
    if (passed != __T__(7) << 90 || typed != __T__(7) << 90) return 7
    if (boxed.value != __T__(5) << 70 || boxed.list[0] != __T__(3) || boxed.list[1] != __T__(4) << 80) return 8
@s    if (negative != __T__(-5) || minimum != __T__Min()) return 6
@s    if (#(__T__Min() % __T__(-1)) != __T__(0)) return 9
    0
}
