// The checks over a file of cases: a fresh random run each time on this machine.
import "checks.ab"
import "abla/io"
import "abla/fs"
import "abla/process/arguments"

fun main: int {
    val failed = __T__Checks(Path(processArgument(0)).readText())
    if (failed != 0) println("line $failed")
    if (failed != 0) 1 else 0
}
