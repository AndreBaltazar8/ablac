// AArch64 and RISC-V Linux objects: no such executable target exists, so tools/test-wide-integers.sh
// links them with a startup and C stubs of its own to run under qemu.
import "abla/build"
import "abla/compiler"

#compilerGrant("filesystem.write")

compile fun __T__Object(name: string, triple: string): bool {
    val target = defineTarget(name, triple, "elf", "none", "none", false, false)
    target && buildProgram(
        "__T__-$name", "build/__T__/src/object.ab", "build/__T__/$name.o", name, "object", false, false
    )
}

val aarch64 = #__T__Object("aarch64", "aarch64-unknown-linux-gnu")
val riscv64 = #__T__Object("riscv64", "riscv64-unknown-linux-gnu")

fun main: int = if (aarch64 && riscv64) 0 else 1
