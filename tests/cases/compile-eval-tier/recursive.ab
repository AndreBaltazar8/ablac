// A loop-free site whose functions call each other in a cycle: it can run long, so
// under auto the pass has a native generation and the site runs in it.
fun even(value: int): bool = if (value == 0) true else odd(value - 1)

fun odd(value: int): bool = if (value == 0) false else even(value - 1)

val parity = #even(10000)

fun main: int = if (parity && even(10000)) 42 else 1
