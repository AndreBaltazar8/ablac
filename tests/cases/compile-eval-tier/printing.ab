// A loop that prints: it acts outside the interpreter, so under auto it gets no trial (a
// trial that stopped would have printed already) and runs natively, printing each line once.
import "abla/io"

fun shout(times: int): int {
    var index = 0
    while (index < times) {
        println("compile-eval-tier line $index")
        index = index + 1
    }
    times
}

val printed = #shout(3)

fun main: int = if (printed == 3) 42 else 1
