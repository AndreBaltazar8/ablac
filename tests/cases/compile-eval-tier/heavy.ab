// Work past a small interpreter step limit: under the default tier the site runs
// natively (no step limit) and gives the run-time answer; under `interp` it stops
// with E_EVAL_STEP_LIMIT (tools/test-compile-eval-tier.sh lowers the limit).
fun churn(rounds: int): int {
    var value = 7
    var index = 0
    while (index < rounds) {
        value = (value * 31 + index) % 1000003
        index = index + 1
    }
    value
}

val staged = #churn(200000)

fun main: int = if (staged == churn(200000)) 42 else 1
