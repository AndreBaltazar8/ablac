// A loop that finishes in a few thousand interpreter steps, reaching nothing outside the
// interpreter: under auto its trial finishes and the pass needs no native generation.
fun churn(rounds: int): int {
    var value = 7
    var index = 0
    while (index < rounds) {
        value = (value * 31 + index) % 1000003
        index = index + 1
    }
    value
}

val staged = #churn(1000)

fun main: int = if (staged == churn(1000)) 42 else 1
