// C functions reached by dlopen and dlsym and called through their addresses (`ablaUnsafeCallExact_*`), as a game
// engine reaches its window and GPU libraries (#1022). The interpreter can't make such a call, so under auto the site
// runs natively, though it holds no loop, lambda or recursion.
import "abla/compiler"
#compilerGrant("trusted.native")
import "abla/unsafe/memory/raw"
import "abla/unsafe/native"

trusted noescape extern:"c" fun dlopen(path: cstring, mode: i32): i64*
trusted noescape extern:"c" fun dlsym(handle: i64*, symbol: cstring): i64*
trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I64_I64(address: int, a: int): int
trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_F64_F64_I64(address: int, x: f64, e: int): f64

trusted fun cFunction(library: string, name: string): int {
    val handle = dlopen(library, i32(2))
    if (nativePointerAddress(handle) == 0) return 0
    nativePointerAddress(dlsym(handle, name))
}

trusted fun called(): int {
    val labs = cFunction("libc.so.6", "labs")
    val ldexp = cFunction("libm.so.6", "ldexp")
    if (labs == 0 || ldexp == 0) return 1
    val five = ablaUnsafeCallExact_I64_I64(labs, -5)
    val eight = ablaUnsafeCallExact_F64_F64_I64(ldexp, 1.0, 3)
    if (eight != 8.0) return 2
    five + 37
}

val answer = #called()

fun main: int = answer
