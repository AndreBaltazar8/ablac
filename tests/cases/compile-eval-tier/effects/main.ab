// Each site appends one line to its own file: a site runs once, on the tier chosen
// before it runs, whether the native tier takes it (`native`, whose loop makes the
// pass worth a native generation under auto) or refuses it (`evaluated`, which names
// a compiler API call that takes a function).
import "abla/compiler"
import "abla/fs"
#compilerGrant("filesystem.write")
#compilerGrant("filesystem.read")

fun mark(name: string): int {
    val directory = path("build-compile-eval-tier")
    directory.createDirectories()
    directory.child("$name.txt").appendText("$name\n")
    var total = 0
    for (byte in name) total = total + 1
    total
}

compile fun evaluated(name: string): int {
    if (name == "") compilerApplyTransform({})
    mark(name)
}

val native = #mark("native")
val interpreted = #evaluated("evaluated")

fun main: int = if (native == 6 && interpreted == 9) 42 else 1
