// No site reaches a loop, a lambda or recursion: under auto the interpreter runs them
// all without a native generation (its work is bounded by the code's size); under
// jit both run natively. Recursive (a cycle of calls) makes a pass worth one.
class Pair(val left: int, val right: int)

fun square(value: int): int = value * value

fun pair(): Pair = Pair(square(3), square(4))

fun scaled(): int {
    val made = pair()
    if (made.left > made.right) made.left * 2 else made.right * 2
}

val first = #square(6)
val second = #scaled()

fun main: int = if (first == 36 && second == 32) 42 else 1
