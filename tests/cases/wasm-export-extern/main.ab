// A wasm module defining a C function it also calls through an extern (no
// libc in the module). The export reads a runtime-initialized global, so it
// is emitted as a thunk with the extern's signature (`ptr`) around an
// implementation that takes the address as an `i32`.
import "abla/float"

extern:"c" fun atof(text: cstring): f64

val SCALE = [1.0, 10.0]

@export("atof")
trusted fun programAtof(text: i32): f64 = SCALE[1] + f64FromInt(int(text))

@export("probe")
fun probe(): f64 = atof("1.5")
