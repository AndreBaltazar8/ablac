import "abla/xtensa/companion"
import "abla/fs"
import "abla/fs/secure"
import "abla/json"
import "abla/process/arguments"
import "abla/sys/linux"

fun main(): int {
    val config = jsonParse(Path(processArgument(0)).readText())
    if (!config.succeeded) return 90
    val value = config.value
    val pins = CompanionPins(value.getString("version"), value.getString("platform"),
        value.getString("llvmVersion"), value.getString("sourceCommit"), value.getString("sourceArchiveSha256"),
        value.getString("archiveSha256"), value.getString("manifestSha256"))
    val parent = secureDirectory(processArgument(1))
    val archiveDir = secureDirectory(processArgument(2))
    val archive = archiveDir.openRegularFile(processArgument(3))
    val result = extractCompanion(parent, archive, pins)
    if (result.error != processArgument(4)) {
        linuxWriteStandardError("unexpected error: ${result.error}\n")
        return 91
    }
    if (result.error == "cleanup" && result.leftoverStage == "") return 93
    if (result.error == "" && processArgument(5) != "either" &&
        result.existing != (processArgument(5) == "existing")) return 92
    if (result.error == "" && processArgument(5) == "either") {
        linuxWriteStandardOutput(if (result.existing) "existing\n" else "new\n")
    }
    0
}
