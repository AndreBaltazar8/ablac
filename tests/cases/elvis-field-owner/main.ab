import "abla/io"
var log: string = ""
resource class Item(val id: int) { fun drop(): void { log += "I$id" }; fun look(): void { log +=
            "B$id" } }
resource class Holder(val item: Item) { fun drop(): void { log += "H" } }
fun maybe(flag: bool): Item? = if (flag) Item(1) else null
fun maybeHolder(flag: bool): Holder? = if (flag) Holder(Item(4)) else null
fun take(x: Item): void { x.look() }
fun exercise(): string {
    log = ""
    val a = (maybe(true) ?? Item(2)).id; log += "B$a|"
    val b = (maybe(false) ?? Item(2)).id; log += "B$b|"
    take((maybeHolder(true) ?? Holder(Item(5))).item); log += "|"
    take((maybeHolder(false) ?? Holder(Item(5))).item); log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
