// Declares `ApiResult` as lib/reply-text.ab does: a test importing one and a test
// importing the other can't be one program, so they go to separate bundles.
class ApiResult(val code: int)

// Private names are this module's alone: reply-text.ab's `helper` doesn't clash.
private fun helper(): int = 1

fun numberReply(code: int): ApiResult = ApiResult(code * helper())
