// The large-allocation directory must order and retain many interior pointers.
// Each view outlives its rope parent, and its flat allocation exceeds 32 KiB.
import "abla/memory"
fun largeRangeView(index: int): string {
    var text = ""
    for (part in 0 until 2400 + index * 37) text = "${text}0123456789abcdef"
    text.slice(3, text.size - 5)
}
fun main: int {
    val held: array<string> = []
    for (index in 0 until 16) {
        held.append(largeRangeView(index))
        memoryCollect()
    }
    for (index in 0 until 16) {
        val value = held[index]
        if (value.size != 16 * (2400 + index * 37) - 8 ||
            value[0] != 51 || value[value.size - 1] != 97) return 1
    }
    42
}
