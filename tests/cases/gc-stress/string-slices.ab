// A slice-only helper does not collect. Its returned interior views still
// retain the flat allocation when the caller collects after the original
// string is gone, including when slicing first flattens a rope.
import "abla/memory"

@noinline
fun middle(text: string, begin: int, end: int): string = text.slice(begin, end)

fun flatSlice(index: int): string {
    val parent = "[slice $index]"
    middle(parent, 1, parent.size - 1)
}

fun ropeSlice(index: int): string {
    val padding = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    val parent = "$padding/slice $index/$padding"
    middle(parent, padding.size + 1, parent.size - padding.size - 1)
}

fun main: int {
    val held: array<string> = []
    for (index in 0 until 64) {
        held.append(flatSlice(index))
        held.append(ropeSlice(index))
        memoryCollect()
    }
    // Flatten/index/compare temporaries whose only reference is the expression.
    // The padding forces a rope rather than the short flat-concat path.
    val padding = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    for (index in 0 until 64) {
        if (("a$index$padding" + "b")[0] != 97) return 1
        if (("$padding$index" + "b") != "$padding${index}b") return 1
    }
    for (index in 0 until 64) {
        val expected = "slice $index"
        if (held[index * 2] != expected || held[index * 2 + 1] != expected) return 1
    }
    42
}
