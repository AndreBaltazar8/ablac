import "abla/memory"

class Entry(val text: string)
var entries: array<Entry> = []

fun initialize(): int {
    // A later initializer collects while the earlier global owns its array.
    // Reusing the same allocation size exposes an unrooted empty header.
    memoryCollect()
    val scratch: array<int> = []
    scratch.append(7)
    entries.append(Entry("kept through initialization"))
    if (scratch.size == 1 && scratch[0] == 7 && entries.size == 1) 42 else 1
}

val initialized: int = initialize()

fun main(): int {
    if (initialized == 42 && entries.size == 1 &&
        entries[0].text == "kept through initialization") 42 else 1
}
