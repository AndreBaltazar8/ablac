// Under ABLA_GC_STRESS=1 every safe point collects, so the garbage of each call is
// gone by the next: the live heap stays flat (42). By default it is collected only
// under pressure, so a thousand calls' garbage is still there (1).
import "abla/memory"

fun garbage(round: int): int {
    val text = "round $round of the stress check"
    text.size
}

fun main: int {
    val before = memoryLiveBytes()
    var total = 0
    for (round in 0 until 1000) total = total + garbage(round)
    val grown = memoryLiveBytes() - before
    if (total > 0 && grown < 4096) 42 else 1
}
