// A child process gets its arguments intact when a collection runs between
// building its argv and the exec (each argument used to be a collectible
// C-string copy that only the native argv pointed at).
import "abla/sys/linux/process"

fun main: int {
    var intact = 0
    var round = 0
    while (round < 5) {
        val echo = linuxCommand("/bin/echo")
        echo.argument("first-$round")
        echo.argument("second argument")
        echo.argument("third")
        if (echo.captureText() == "first-$round second argument third\n") intact = intact + 1
        round = round + 1
    }
    if (intact == 5) 42 else 1
}
