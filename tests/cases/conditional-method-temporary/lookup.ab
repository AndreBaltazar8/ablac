import "../../../src/eval.ab"

fun has(declarations: array<BootstrapDeclaration>, context: BootstrapEvalContext,
    owner: string, name: string): bool {
    val evaluator = BootstrapEvaluator(declarations, context.affineTypes, context,
        [], [], [], [], [], [], [], [], [], [], [], [], [], 0, 0, 0, "")
    bootstrapEvalClassHasMethodOrExtension(evaluator, owner, name)
}

fun main: int {
    val parsed = bootstrapParse("class A { fun method(): int = 1 }\nfun A.extra(): int = 2")
    if (parsed.errors != 0) return 1
    val indexed = bootstrapEvalContext(parsed.declarations)
    val stale = bootstrapEvalContext([])
    if (!has(parsed.declarations, indexed, "A", "method")) return 2
    if (!has(parsed.declarations, stale, "A", "method")) return 3
    if (!has(parsed.declarations, indexed, "A", "extra")) return 4
    if (!has(parsed.declarations, stale, "A", "extra")) return 5
    if (has(parsed.declarations, stale, "A", "missing")) return 6
    0
}
