import "abla/io"
var log: string = ""
resource class Item(val id: int) {
    fun drop(): void { log = log + "I$id" }
    fun ordinary(): int { log = log + "O$id"; id }
    fun set(): int { log = log + "S$id"; id }
}
fun Item.look(): int { log = log + "B${this.id}"; this.id }
fun extension(flag: bool): void {
    val existing = Item(2)
    (if (flag) Item(1) else existing).look()
    log = log + "|"
}
fun method(flag: bool): void {
    val existing = Item(4)
    (if (flag) Item(3) else existing).ordinary()
    log = log + "|"
}
fun nested(a: bool, b: bool): void {
    val existing = Item(6)
    (if (a) (if (b) Item(5) else existing) else existing).look()
    log = log + "|"
}
fun namedSet(flag: bool): void {
    val existing = Item(11)
    (if (flag) Item(10) else existing).set()
    log = log + "|"
}
fun exercise(): string {
    log = ""
    extension(true); extension(false)
    method(true); method(false)
    nested(true, true); nested(true, false); nested(false, true)
    namedSet(true); namedSet(false)
    (when (true) { true -> Item(7) else -> Item(8) }).look(); log = log + "|"
    (if (true) { val x = Item(9); x } else Item(12)).ordinary(); log = log + "|"
    val values = [1]
    (if (true) values else values).append(2)
    log = log + "A${values.size}|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
