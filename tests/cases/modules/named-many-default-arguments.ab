resource class Configured(val value: int) {
    fun drop(): void {
        return
    }
}

class Device()
class OtherDevice()

fun configured(
    first: int = 1,
    second: int = 2,
    third: int = 3,
    fourth: int = 4,
    fifth: int = 5,
    sixth: int = 6,
    seventh: int = 7,
    eighth: int = 8,
    ninth: int = 9,
    tenth: int = 10,
    eleventh: int = 11,
    twelfth: int = 12,
    thirteenth: int = 13,
    fourteenth: int = 14,
    fifteenth: int = 15,
    sixteenth: int = 16,
    seventeenth: int = 17,
    eighteenth: int = 18,
    nineteenth: int = 19,
    twentieth: bool = true
): Configured = Configured(if (twentieth) first + nineteenth else 0)

fun Device.configured(
    first: int = 1,
    second: int = 2,
    third: int = 3,
    fourth: int = 4,
    fifth: int = 5,
    sixth: int = 6,
    seventh: int = 7,
    eighth: int = 8,
    ninth: int = 9,
    tenth: int = 10,
    eleventh: int = 11,
    twelfth: int = 12,
    thirteenth: int = 13,
    fourteenth: int = 14,
    fifteenth: int = 15,
    sixteenth: int = 16,
    seventeenth: int = 17,
    eighteenth: int = 18,
    nineteenth: int = 19,
    twentieth: bool = true
): Configured = Configured(if (twentieth) first + nineteenth else 0)

fun OtherDevice.configured(
    first: int = 20,
    alternate: bool = true
): Configured = Configured(if (alternate) first else 0)

fun main: int {
    val result = configured(twentieth = false)
    val deviceResult = Device().configured(twentieth = false)
    val otherResult = OtherDevice().configured(alternate = false)
    if (result.value == 0 && deviceResult.value == 0 &&
        otherResult.value == 0) 42 else 1
}
