import "abla/io"
import "abla/runtime/platform/windows"

// The Windows platform file (W1c, stdlib/abla/runtime/platform/windows) parses and lowers on any host: it is data and functions until a
// Windows target calls them. This program calls one that does no system call (the list of the translated Linux numbers).
trusted fun main: int {
    println(__ablaRuntimeWindowsTranslated())
    0
}
