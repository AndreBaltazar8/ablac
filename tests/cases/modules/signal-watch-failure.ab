import "abla/process"
import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

fun currentMask(): int {
    val value = nativeByteBuffer(8)
    linuxSyscall4(14, 0, 0, nativePointerAddress(value.address), 8)
    val result = value.loadI64(0)
    value.close()
    result
}
fun main: int {
    val before = currentMask()
    val outer = watchSignals([signalTerminate])
    val withOuter = currentMask()
    val opened: array<int> = []
    var index = 0
    while (index < 64) {
        val descriptor = linuxOpen("/dev/null", 0, 0).descriptor
        if (descriptor >= 0) opened.append(descriptor)
        index = index + 1
    }
    val failed = watchSignals([signalHangup])
    val unchanged = !failed.started && currentMask() == withOuter
    failed.close()
    val stillUnchanged = currentMask() == withOuter
    for (descriptor in opened) linuxSyscall1(3, descriptor)
    outer.close()
    if (outer.started && unchanged && stillUnchanged && currentMask() == before) 42 else 1
}
