#import("abla/compiler")
#import("abla/compiler/parser")
#import("nested-deferred-nominal-target.ab")

fun nestedDeferredNominalElement(
    attributes: array<int>,
    children: array<int>
): int = 0

fun nestedDeferredNominalAttribute(
    argument: int,
    handler: (int) -> MvcAction
): int = argument + handler(0).value

compile fun finalizeNestedDeferredNominal(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val target = typedCallTarget(expression)
    val module = compilerGeneratedModule(
        "nested.deferred.nominal",
        expression
    )
    val valid = typedExpressionKind(expression) == "call" &&
        typedExpressionType(expression) == "MvcAction" &&
        typedCallArgumentCount(expression) == 1 &&
        typedCallArgumentType(expression, 0) == "i64" &&
        typedCallArgumentParameter(expression, 0) == 0 &&
        typedCallArgumentConversion(expression, 0) == "none" &&
        typedCallInsertedDefaultCount(expression) == 0 &&
        compilerFunctionName(target) == "nestedDeferredNominalAction" &&
        compilerFunctionParameterCount(target) == 1 &&
        compilerFunctionParameterType(target, 0) == "i64" &&
        compilerFunctionResultType(target) == "MvcAction" &&
        compilerTypeName(compilerFunctionResultTypeHandle(target)) ==
            "MvcAction"
    val parameterNames: array<string> = ["argument"]
    val parameterTypes: array<int> = [compilerFindType("i64")]
    val arguments: array<SyntaxExpression> = [
        syntaxIdentifier("argument")
    ]
    val adapter = syntaxCallTarget(target, arguments)
    compilerGeneratedFunction(
        module,
        "adapter",
        parameterNames,
        parameterTypes,
        compilerFindType("MvcAction"),
        adapter
    )
    val exportedArguments: array<SyntaxExpression> = [
        syntaxIdentifier("argument")
    ]
    compilerGeneratedExportFunction(
        module,
        generatedName,
        parameterNames,
        parameterTypes,
        compilerFindType("MvcAction"),
        compilerGeneratedDeclarationCall(module, 0, exportedArguments)
    )
    if (!valid || compilerGeneratedDeclarationCount(module) != 2 ||
        compilerGeneratedDeclarationOriginBegin(module, 0) !=
            syntaxBegin(expression) ||
        compilerGeneratedDeclarationOriginEnd(module, 1) !=
            syntaxEnd(expression)) {
        val invalidNames: array<string> = []
        val invalidTypes: array<int> = []
        compilerGeneratedFunction(
            module,
            "invalidNominalAdapter",
            invalidNames,
            invalidTypes,
            compilerFindType("MissingType"),
            syntaxInteger(0)
        )
    }
    module
}

compile fun nestedDeferredNominalAttributeSyntax(
    cursor: ParserCursor
): SyntaxExpression {
    parserRawExpect(cursor, "onclick={")
    val action = parserParseAblaExpression(cursor)
    parserRawExpect(cursor, "}")
    compilerRecordGeneratedExtensionRequest(
        "nested.deferred.nominal",
        "generatedNominalAdapter",
        action,
        finalizeNestedDeferredNominal
    )
    val arguments: array<SyntaxExpression> = [
        syntaxChild(action, 0),
        syntaxIdentifier(syntaxText(action))
    ]
    syntaxCall("nestedDeferredNominalAttribute", arguments)
}

compile fun parseNestedDeferredNominalElement(
    cursor: ParserCursor
): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "<")
    val tag = parserRawTakeName(cursor)
    val attributes: array<SyntaxExpression> = []
    parserRawSkipWhitespace(cursor)
    while (!parserRawAt(cursor, ">")) {
        attributes.append(nestedDeferredNominalAttributeSyntax(cursor))
        parserRawSkipWhitespace(cursor)
    }
    parserRawExpect(cursor, ">")

    val children: array<SyntaxExpression> = []
    while (!parserRawAt(cursor, "</")) {
        parserRawSkipWhitespace(cursor)
        if (parserRawAt(cursor, "<") && !parserRawAt(cursor, "</")) {
            children.append(parseNestedDeferredNominalElement(cursor))
        }
    }
    parserRawExpect(cursor, "</")
    val closingTag = parserRawTakeName(cursor)
    if (closingTag != tag) parserFail(cursor, "closing tag mismatch")
    parserRawExpect(cursor, ">")

    val arguments: array<SyntaxExpression> = [
        syntaxArray(attributes),
        syntaxArray(children)
    ]
    syntaxCall("nestedDeferredNominalElement", arguments)
}

compile fun parseNestedDeferredNominal(
    cursor: ParserCursor
): SyntaxExpression = parseNestedDeferredNominalElement(cursor)

#compilerRegisterSubparser(
    "nestedDeferredNominal",
    parseNestedDeferredNominal
)
