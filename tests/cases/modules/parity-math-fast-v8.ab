// Compile-time parity of abla/math/fast and abla/math/v8 (each under an alias: both declare the same names): rounding,
// square roots, the float min and max and clamps, NaN and infinity checks print the same at run time and under `#`
// (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/float/text"
import "abla/math/fast" as fast
import "abla/math/v8" as v8

fun main: int {
    for (x in [2.5, -2.5, 3.5, 0.1, -0.0, 1e300, 123456.789]) {
        println("$x fast ${fast.roundEven(x)} ${fast.floor(x)} ${fast.ceil(x)} ${fast.trunc(x)} ${fast.sqrt(fast.fabs(x))}")
        println("$x v8 ${v8.roundEven(x)} ${v8.floor(x)} ${v8.ceil(x)} ${v8.trunc(x)} ${v8.sqrt(v8.fabs(x))}")
    }
    println("fast ${fast.fmin(1.5, -2.0)} ${fast.fmax(1.5, -2.0)} ${fast.fclamp(9.0, 0.0, 4.0)} ${fast.clamp(-5, 0, 10)} ${fast.isNaN(0.0 / 0.0)} ${fast.isFinite(1.0 / 0.0)}")
    println("v8 ${v8.fmin(1.5, -2.0)} ${v8.fmax(1.5, -2.0)} ${v8.fclamp(9.0, 0.0, 4.0)} ${v8.min(3, 4)} ${v8.isNaN(0.0 / 0.0)} ${v8.isFinite(1.0 / 0.0)}")
    42
}
