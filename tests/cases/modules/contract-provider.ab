import "abla/compiler"
import "abla/compiler/parser"

compile fun contractAnnotated(function: int): bool {
    var found = false
    var index = 0
    while (index < compilerFunctionAnnotationCount(function)) {
        if (compilerFunctionAnnotation(function, index) == "rpc") {
            found = true
        }
        index = index + 1
    }
    found
}

compile fun finalizeContractCall(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val target = typedCallTarget(expression)
    val module = compilerGeneratedModule("contract.call", expression)
    val valid = target >= 0 &&
        typedCallIsContract(expression) &&
        compilerFunctionName(target) == "remoteIncrement" &&
        compilerFunctionCanonicalIdentity(target) != "remoteIncrement" &&
        compilerFunctionModuleIdentity(target).size > 0 &&
        compilerFunctionParameterCount(target) == 2 &&
        compilerFunctionParameterName(target, 0) == "value" &&
        compilerFunctionParameterName(target, 1) == "bonus" &&
        compilerFunctionParameterType(target, 0) == "i64" &&
        compilerFunctionParameterType(target, 1) == "i64" &&
        compilerFunctionResultType(target) == "ContractResult" &&
        typedCallArgumentCount(expression) == 1 &&
        typedCallArgumentType(expression, 0) == "i64" &&
        typedCallInsertedDefaultCount(expression) == 1 &&
        contractAnnotated(target)
    val names: array<string> = []
    val types: array<int> = []
    compilerGeneratedExportFunction(
        module,
        generatedName,
        names,
        types,
        compilerFindType("i64"),
        syntaxInteger(if (valid) 42 else 1)
    )
    module
}

compile fun parseContractCall(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "contract.call",
        "generatedContractMetadata",
        expression,
        finalizeContractCall
    )
    syntaxInteger(0)
}

#compilerRegisterSubparser("contractCall", parseContractCall)
