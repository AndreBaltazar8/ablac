#import("../../../bootstrap/compiler/subparser.ab")

fun main: int {
    val source = "{20 + 22}"
    val tokens = bootstrapLex(source)
    val cursor = BootstrapSubparserCursor(
        source,
        tokens,
        [],
        [],
        [],
        0,
        tokens[0].begin,
        0
    )
    cursor.expect("{")
    val expression = cursor.parseAblaExpression()
    cursor.expect("}")

    val rawSource = "<div>A & B</div>"
    val rawTokens = bootstrapLex(rawSource)
    val raw = BootstrapSubparserCursor(
        rawSource,
        rawTokens,
        [],
        [],
        [],
        0,
        0,
        0
    )
    raw.rawExpect("<")
    val tag = raw.rawTakeName()
    raw.rawExpect(">")
    val text = raw.rawTakeUntil("<")
    raw.rawExpect("</")
    val closing = raw.rawTakeName()
    raw.rawExpect(">")

    val built = bootstrapSyntaxCall(
        "answer",
        [bootstrapSyntaxBinary(
            "+",
            bootstrapSyntaxInteger(20),
            bootstrapSyntaxInteger(22)
        )]
    )

    if (
        cursor.errors == 0 &&
        cursor.position + 1 == tokens.size &&
        expression.kind == "+" &&
        expression.children.size == 2 &&
        raw.errors == 0 &&
        raw.rawEnd() &&
        tag == "div" &&
        closing == tag &&
        text == "A & B" &&
        built.kind == "call" &&
        built.text == "answer" &&
        built.children[0].kind == "+"
    ) 42 else 0
}
