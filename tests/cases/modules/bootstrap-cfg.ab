import "../../../src/ir.ab"

fun irInstruction(
    opcode: string,
    result: int,
    left: int,
    target: int,
    alternate: int
): BootstrapInstruction = BootstrapInstruction(
    opcode,
    result,
    left,
    -1,
    "",
    target,
    alternate,
    []
)

fun localInstruction(
    opcode: string,
    result: int,
    left: int,
    text: string,
    target: int,
    alternate: int
): BootstrapInstruction = BootstrapInstruction(
    opcode,
    result,
    left,
    -1,
    text,
    target,
    alternate,
    []
)

fun blocksAreTerminated(function: BootstrapIrFunction): bool {
    var valid = function.blocks.size > 0
    var block = 0
    while (block < function.blocks.size) {
        val found = function.blocks[block]
        valid = valid && found.reachable && found.end > found.begin
        if (found.end > found.begin) {
            valid = valid && bootstrapIrIsTerminator(
                function.instructions[found.end - 1].opcode
            )
        }
        block = block + 1
    }
    valid
}

fun main: int {
    val program = bootstrapLower(
        "fun choose(value: int): int {\n    if (value == 1) return 20\n    while (value < 4) break\n    22\n}\nfun main: int = choose(1) + choose(2)\n"
    )
    val compiled = program.functions[0]

    val unreachable = bootstrapFinalizeIrFunction(
        "unreachable",
        [],
        [
            irInstruction("const.i64", 0, -1, -1, -1),
            irInstruction("return", -1, 0, -1, -1),
            irInstruction("const.i64", 1, -1, -1, -1),
            irInstruction("label", -1, -1, 9, -1),
            irInstruction("const.i64", 2, -1, -1, -1),
            irInstruction("return", -1, 2, -1, -1)
        ],
        0
    )
    val fallthrough = bootstrapFinalizeIrFunction(
        "fallthrough",
        [],
        [
            irInstruction("const.i64", 0, -1, -1, -1),
            irInstruction("label", -1, -1, 1, -1),
            irInstruction("const.i64", 1, -1, -1, -1)
        ],
        1
    )
    val explicitUnreachable = bootstrapFinalizeIrFunction(
        "explicitUnreachable",
        [],
        [
            irInstruction("const.bool", 0, -1, -1, -1),
            irInstruction("const.i64", 1, -1, -1, -1),
            irInstruction("branch", -1, 0, 1, 2),
            irInstruction("label", -1, -1, 1, -1),
            irInstruction("return", -1, 1, -1, -1),
            irInstruction("label", -1, -1, 2, -1),
            irInstruction("unreachable", -1, -1, -1, -1)
        ],
        1
    )
    val missingTarget = bootstrapFinalizeIrFunction(
        "missingTarget",
        [],
        [irInstruction("jump", -1, -1, 77, -1)],
        -1
    )
    val invalidValue = bootstrapFinalizeIrFunction(
        "invalidValue",
        [],
        [irInstruction("return", -1, 99, -1, -1)],
        -1
    )
    val duplicateLabel = bootstrapFinalizeIrFunction(
        "duplicateLabel",
        [],
        [
            irInstruction("jump", -1, -1, 1, -1),
            irInstruction("label", -1, -1, 1, -1),
            irInstruction("jump", -1, -1, 1, -1),
            irInstruction("label", -1, -1, 1, -1),
            irInstruction("const.i64", 0, -1, -1, -1),
            irInstruction("return", -1, 0, -1, -1)
        ],
        0
    )
    val nonDominatingValue = bootstrapFinalizeIrFunction(
        "nonDominatingValue",
        [],
        [
            irInstruction("const.bool", 0, -1, -1, -1),
            irInstruction("branch", -1, 0, 1, 2),
            irInstruction("label", -1, -1, 1, -1),
            irInstruction("const.i64", 1, -1, -1, -1),
            irInstruction("jump", -1, -1, 3, -1),
            irInstruction("label", -1, -1, 2, -1),
            irInstruction("jump", -1, -1, 3, -1),
            irInstruction("label", -1, -1, 3, -1),
            irInstruction("return", -1, 1, -1, -1)
        ],
        1
    )
    val uninitializedLocal = bootstrapFinalizeIrFunction(
        "uninitializedLocal",
        [],
        [
            localInstruction("local.allocate", -1, -1, "slot", -1, -1),
            irInstruction("const.bool", 0, -1, -1, -1),
            irInstruction("const.i64", 1, -1, -1, -1),
            irInstruction("branch", -1, 0, 1, 2),
            irInstruction("label", -1, -1, 1, -1),
            localInstruction("local.set", -1, 1, "slot", -1, -1),
            irInstruction("jump", -1, -1, 3, -1),
            irInstruction("label", -1, -1, 2, -1),
            irInstruction("jump", -1, -1, 3, -1),
            irInstruction("label", -1, -1, 3, -1),
            localInstruction("local.load", 2, -1, "slot", -1, -1),
            irInstruction("return", -1, 2, -1, -1)
        ],
        2
    )
    val initializedLocal = bootstrapFinalizeIrFunction(
        "initializedLocal",
        [],
        [
            localInstruction("local.allocate", -1, -1, "slot", -1, -1),
            irInstruction("const.bool", 0, -1, -1, -1),
            irInstruction("const.i64", 1, -1, -1, -1),
            irInstruction("branch", -1, 0, 1, 2),
            irInstruction("label", -1, -1, 1, -1),
            localInstruction("local.set", -1, 1, "slot", -1, -1),
            irInstruction("jump", -1, -1, 3, -1),
            irInstruction("label", -1, -1, 2, -1),
            localInstruction("local.set", -1, 1, "slot", -1, -1),
            irInstruction("jump", -1, -1, 3, -1),
            irInstruction("label", -1, -1, 3, -1),
            localInstruction("local.load", 2, -1, "slot", -1, -1),
            irInstruction("return", -1, 2, -1, -1)
        ],
        2
    )
    val localBeforeLifetime = bootstrapFinalizeIrFunction(
        "localBeforeLifetime",
        [],
        [
            localInstruction("local.load", 0, -1, "late", -1, -1),
            localInstruction("local.allocate", -1, -1, "late", -1, -1),
            irInstruction("return", -1, 0, -1, -1)
        ],
        0
    )
    val unknownLocal = bootstrapFinalizeIrFunction(
        "unknownLocal",
        [],
        [
            localInstruction("local.load", 0, -1, "missing", -1, -1),
            irInstruction("return", -1, 0, -1, -1)
        ],
        0
    )
    val duplicateLocal = bootstrapFinalizeIrFunction(
        "duplicateLocal",
        [],
        [
            localInstruction("local.zero", -1, -1, "slot", -1, -1),
            localInstruction("local.zero", -1, -1, "slot", -1, -1),
            irInstruction("const.i64", 0, -1, -1, -1),
            irInstruction("return", -1, 0, -1, -1)
        ],
        0
    )
    val useAfterMove = bootstrapFinalizeIrFunction(
        "useAfterMove",
        [],
        [
            irInstruction("const.i64", 0, -1, -1, -1),
            localInstruction("local.declare", 1, 0, "owned", -1, -1),
            localInstruction("local.move", -1, -1, "owned", -1, -1),
            localInstruction("local.load", 2, -1, "owned", -1, -1),
            irInstruction("return", -1, 2, -1, -1)
        ],
        2
    )
    val reinitializedMove = bootstrapFinalizeIrFunction(
        "reinitializedMove",
        [],
        [
            irInstruction("const.i64", 0, -1, -1, -1),
            localInstruction("local.declare", 1, 0, "owned", -1, -1),
            localInstruction("local.move", -1, -1, "owned", -1, -1),
            localInstruction("local.set", -1, 0, "owned", -1, -1),
            localInstruction("local.load", 2, -1, "owned", -1, -1),
            irInstruction("return", -1, 2, -1, -1)
        ],
        2
    )
    val activeBorrowMove = bootstrapFinalizeIrFunction(
        "activeBorrowMove",
        [],
        [
            irInstruction("const.i64", 0, -1, -1, -1),
            localInstruction("local.declare", 1, 0, "owner", -1, -1),
            localInstruction("local.declare", 2, 0, "view", -1, -1),
            localInstruction(
                "borrow.bind", -1, -1, "view|owner", -1, -1
            ),
            localInstruction("local.move", -1, -1, "owner", -1, -1),
            localInstruction("local.load", 3, -1, "view", -1, -1),
            irInstruction("return", -1, 3, -1, -1)
        ],
        3
    )
    val endedBorrowMove = bootstrapFinalizeIrFunction(
        "endedBorrowMove",
        [],
        [
            irInstruction("const.i64", 0, -1, -1, -1),
            localInstruction("local.declare", 1, 0, "owner", -1, -1),
            localInstruction("local.declare", 2, 0, "view", -1, -1),
            localInstruction(
                "borrow.bind", -1, -1, "view|owner", -1, -1
            ),
            localInstruction("local.load", 3, -1, "view", -1, -1),
            localInstruction("local.move", -1, -1, "owner", -1, -1),
            irInstruction("return", -1, 3, -1, -1)
        ],
        3
    )
    val malformedBorrow = bootstrapFinalizeIrFunction(
        "malformedBorrow",
        [],
        [
            irInstruction("const.i64", 0, -1, -1, -1),
            localInstruction("local.declare", 1, 0, "view", -1, -1),
            localInstruction(
                "borrow.bind", -1, -1, "view|missing", -1, -1
            ),
            localInstruction("local.load", 2, -1, "view", -1, -1),
            irInstruction("return", -1, 2, -1, -1)
        ],
        2
    )

    if (
        program.errors == 0 &&
        compiled.verificationErrors == 0 &&
        blocksAreTerminated(compiled) &&
        unreachable.verificationErrors == 0 &&
        unreachable.instructions.size == 2 &&
        unreachable.blocks.size == 1 &&
        fallthrough.verificationErrors == 0 &&
        fallthrough.blocks.size == 2 &&
        fallthrough.blocks[0].successors[0] == 1 &&
        fallthrough.blocks[1].predecessors.size == 1 &&
        explicitUnreachable.verificationErrors == 0 &&
        explicitUnreachable.blocks.size == 3 &&
        explicitUnreachable.blocks[2].successors.size == 0 &&
        explicitUnreachable.instructions[
            explicitUnreachable.instructions.size - 1
        ].opcode == "unreachable" &&
        missingTarget.verificationErrors > 0 &&
        invalidValue.verificationErrors > 0 &&
        duplicateLabel.verificationErrors > 0 &&
        nonDominatingValue.verificationErrors > 0 &&
        uninitializedLocal.verificationErrors > 0 &&
        uninitializedLocal.locals.size == 1 &&
        !uninitializedLocal.locals[0].initialized &&
        initializedLocal.verificationErrors == 0 &&
        initializedLocal.locals.size == 1 &&
        localBeforeLifetime.verificationErrors > 0 &&
        unknownLocal.verificationErrors > 0 &&
        duplicateLocal.verificationErrors > 0 &&
        useAfterMove.verificationErrors > 0 &&
        reinitializedMove.verificationErrors == 0 &&
        activeBorrowMove.verificationErrors > 0 &&
        endedBorrowMove.verificationErrors == 0 &&
        malformedBorrow.verificationErrors > 0 &&
        !bootstrapIrPlacesConflict(
            "owner.boxes[*].ticket",
            "owner.marker"
        ) &&
        !bootstrapIrPlacesConflict(
            "owner.boxes[*].ticket",
            "owner.boxes[0].label"
        ) &&
        bootstrapIrPlacesConflict(
            "owner.boxes[*].ticket",
            "owner.boxes[0].ticket"
        ) &&
        !bootstrapIrPlacesConflict(
            "owner.boxes[0].ticket",
            "owner.boxes[1].ticket"
        ) &&
        !bootstrapIrPlaceRestored(
            "owner.boxes[*].ticket",
            "owner.boxes[*].ticket"
        ) &&
        bootstrapIrPlaceRestored(
            "owner.boxes[*].ticket",
            "owner.boxes"
        )
    ) 42 else 0
}
