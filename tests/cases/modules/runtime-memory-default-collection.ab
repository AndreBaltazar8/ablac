import "abla/memory"

// A hosted program that never mentions collection still collects under
// allocation pressure: every allocating function is a safe point.
class DefaultLink(var next: DefaultLink?, val payload: array<int>)

fun abandonDefaultCycle(seed: int): int {
    val payload: array<int> = []
    var index = 0
    while (index < 1024) {
        payload.append(seed + index)
        index = index + 1
    }
    val left = DefaultLink(null, payload)
    val right = DefaultLink(left, [seed])
    left.next = right
    left.payload[0] + right.payload[0]
}

fun main: int {
    // 65536 cycles of about 8 KiB each: 512 MiB of cyclic garbage that
    // reference release alone never frees.
    var round = 0
    var sum = 0
    var peak = 0
    while (round < 65536) {
        sum = abandonDefaultCycle(21)
        if (memoryLiveBytes() > peak) peak = memoryLiveBytes()
        round = round + 1
    }
    if (sum == 42 && peak < 268435456) 42 else 1
}
