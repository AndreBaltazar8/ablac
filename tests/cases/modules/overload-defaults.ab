// A parameter default that calls an overloaded function, from a call that
// omits it: a constructor (the default copied into the caller keeps its own
// position, in this module or the class's) and a named call, at run time and
// in `#`.
import "./overload-defaults/config.ab" as CONFIG
import "./overload-defaults/record.ab"

fun level(at: int): int = at + 1
fun level(): int = level(1)

class Rec(var season: int = CONFIG.season())
class Tier(var name: int, var level: int = level())

fun pick(base: int, extra: int = level()): int = base + extra

val R = Rec()
val S = Stamp()

fun staged(): int = Rec().season + Stamp().season + pick(base = 1)
val STAGED = #staged()

fun main: int {
    val local = Rec()
    val tier = Tier(name = 7)
    if (R.season == 11 && S.season == 11 && local.season == 11 &&
        Tier(3).level == 2 && tier.level == 2 && pick(base = 1) == 3 && STAGED == 25 &&
        staged() == 25) 42 else 1
}
