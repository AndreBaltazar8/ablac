// Labeled loops: `name@ while`, `name@ do`, `name@ for`, left by
// `break@name` and continued by `continue@name` from any loop inside them.
// tools/test-labeled-loops.sh compares the output.
import "abla/io"

resource class Guard(val label: string) {
    fun drop(): void {
        println("drop $label")
        return
    }
}

// break@outer from a nested loop, continue@outer skipping the rest of the
// inner loop and of the outer body.
fun nested(): int {
    var hits = 0
    var rows = 0
    outer@ for (row in 0 until 10) {
        rows = rows + 1
        inner@ for (column in 0 until 10) {
            if (column > row) continue@outer
            if (column == 2) continue@inner
            hits = hits + 1
            if (hits >= 12) break@outer
        }
        hits = hits + 100
    }
    rows * 1000 + hits
}

// A labeled `do { } while (false)` as a block with several exits: each
// `break@done` skips the rest of it.
fun classify(n: int): string {
    var kind = "big"
    done@ do {
        if (n < 0) {
            kind = "negative"
            break@done
        }
        var step = 0
        while (true) {
            if (step == n) {
                kind = "small $step"
                break@done
            }
            if (step == 5) break
            step = step + 1
        }
        if (n == 7) {
            kind = "seven"
            break@done
        }
    } while (false)
    kind
}

// continue@x of a do/while re-tests its condition.
fun doContinue(): int {
    var turns = 0
    var total = 0
    again@ do {
        turns = turns + 1
        var k = 0
        while (k < 10) {
            k = k + 1
            if (k == 3) continue@again
            total = total + k
        }
    } while (turns < 4)
    turns * 100 + total
}

// Leaving through scopes drops what they own, innermost first, once.
fun drops(): void {
    val keep = Guard("keep")
    outer@ while (true) {
        val a = Guard("outer body")
        var i = 0
        while (i < 3) {
            val b = Guard("inner $i")
            if (i == 1) {
                val c = Guard("branch")
                println("leaving with ${c.label}")
                break@outer
            }
            i = i + 1
        }
        println("not reached ${a.label}")
    }
    println("after loop ${keep.label}")
}

fun continueDrops(): void {
    var turn = 0
    outer@ while (turn < 2) {
        turn = turn + 1
        val a = Guard("turn $turn")
        for (x in 0 until 3) {
            val b = Guard("x $x")
            if (x == 1) continue@outer
        }
    }
    println("continued")
}

// `??`'s right side may be a labeled break or continue.
fun firstMissing(rows: array<array<string?>>): int {
    var found = -1
    var index = 0
    search@ for (row in rows) {
        for (cell in row) {
            val value = cell ?? break@search
            if (value == "skip") continue@search
        }
        index = index + 1
    }
    found = index
    found
}

// Evaluated at compile time.
compile fun compileLabels(): int {
    var total = 0
    outer@ for (a in 0 until 5) {
        var b = 0
        inner@ while (true) {
            b = b + 1
            if (b > a) continue@outer
            if (a == 4) break@outer
            total = total + b
        }
    }
    var block = 0
    exit@ do {
        block = 1
        for (z in 0 until 3) {
            if (z == 1) break@exit
            block = block + 10
        }
        block = 99
    } while (false)
    total * 100 + block
}

// A generator whose labeled loops are cut at `yield`s, left from a loop
// kept whole inside them and from a cut one.
fun pairs(limit: int): Generator<int> = generator {
    outer@ for (a in 0 until limit) {
        var b = 0
        while (true) {
            b = b + 1
            if (b > 3) continue@outer
            if (a * b == 6) break@outer
            yield a * 10 + b
        }
    }
    yield 999
}

fun labeledYield(): Generator<int> = generator {
    var n = 0
    scan@ while (true) {
        n = n + 1
        // Kept whole (no `yield` in it): its jumps leave for the cut loop.
        for (j in 0 until 5) {
            if (n == 2 && j == 1) continue@scan
            if (n == 4 && j == 3) break@scan
        }
        inner@ for (k in 0 until 4) {
            if (k == 2) continue@scan
            yield n * 10 + k
        }
    }
    yield -1
}

fun collect(values: Generator<int>): string {
    var text = ""
    for (value in values) text = "$text $value"
    text
}

compile fun compileGenerator(): string = collect(pairs(4))

fun main: int {
    println("nested ${nested()}")
    println("classify ${classify(-3)} | ${classify(2)} | ${classify(7)} | ${classify(9)}")
    println("do ${doContinue()}")
    drops()
    continueDrops()
    println("missing ${firstMissing([["a"], ["b", "c"], ["d", null, "e"], ["f"]])}")
    println("skip ${firstMissing([["a"], ["skip", null], ["g", null]])}")
    println("compile ${#compileLabels()}")
    println("pairs${collect(pairs(4))}")
    println("compile pairs${#compileGenerator()}")
    println("yield${collect(labeledYield())}")
    0
}
