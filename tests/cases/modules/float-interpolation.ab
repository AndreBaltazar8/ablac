// `"$x"` with x an f64 or f32 is written by abla/float/text's f64Text, as
// JavaScript writes the number.
import "abla/float"
import "abla/float/text"

class Point(val x: f64, val y: f32)

fun main: int {
    val sum = 0.1 + 0.2
    val point = Point(1.5, f64ToF32(2.25))
    val text = "sum=$sum big=${1e21} small=${1.5e-7} p=${point.x},${point.y} n=${3}"
    if (text == "sum=0.30000000000000004 big=1e+21 small=1.5e-7 p=1.5,2.25 n=3") 42
    else 1
}
