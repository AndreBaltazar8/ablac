// A program that panics: under `#` (tools/test-compile-time-parity.sh) the
// evaluation stops with the same message, E_CT_PANIC, on either tier.
import "abla/process"

fun checked(values: array<int>, index: int): int {
    if (index >= values.size) panic("index $index past ${values.size} values")
    values[index]
}

fun main: int = checked([1, 2], 5)
