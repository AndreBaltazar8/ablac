import "abla/io"

class Box(var count: int)

fun main {
    var n = 0
    var log = ""
    val box = Box(0)
    val items = [0]
    if (true) {
        defer { n += 1 }
        defer { log = log + "x" }
        defer { box.count = box.count + 2 }
        defer { items[0] = 3 }
    }
    println("$n $log ${box.count} ${items[0]}")
}
