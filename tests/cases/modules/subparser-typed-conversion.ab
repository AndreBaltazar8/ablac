import "abla/compiler"
import "abla/compiler/parser"

trusted extern:"c" fun strlen(text: cstring): int

compile fun finalizeConversion(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val target = typedCallTarget(expression)
    val module = compilerGeneratedModule("example.conversion", expression)
    val valid = target >= 0 &&
        typedExpressionType(expression) == "i64" &&
        typedCallArgumentCount(expression) == 1 &&
        typedCallArgumentType(expression, 0) == "string" &&
        compilerTypeName(typedCallParameterTypeHandle(expression, 0)) ==
            "cstring" &&
        typedCallArgumentParameter(expression, 0) == 0 &&
        typedCallArgumentConversion(expression, 0) ==
            "string.to-cstring" &&
        typedCallInsertedDefaultCount(expression) == 0 &&
        typedCallParameterOwnership(expression, 0) == "parameter" &&
        typedCallIsTrusted(expression) &&
        !typedCallIsCompileOnly(expression) &&
        compilerFunctionIsExternal(target) &&
        compilerFunctionIsTrusted(target)
    val names: array<string> = []
    val types: array<int> = []
    compilerGeneratedExportFunction(
        module,
        generatedName,
        names,
        types,
        compilerFindType("i64"),
        syntaxInteger(if (valid) 42 else 1)
    )
    module
}

compile fun parseConversion(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "example.conversion",
        "generatedConversionMetadata",
        expression,
        finalizeConversion
    )
    expression
}

#compilerRegisterSubparser("conversion", parseConversion)

trusted fun main: int {
    val length = $conversion(strlen("abc"))
    if (length == 3 && generatedConversionMetadata() == 42) 42 else 1
}
