import "import-alias-members-lib.ab"

// Imports the library plainly while another module aliases it: its own
// members named like the library's top-level names keep theirs.
class Gauge(val level: int) {
    fun read(): int = level + slot(0)
}

fun Gauge.doubled(): int = level * 2

fun gauges(): string = "${Gauge(7).read()} ${Gauge(7).doubled()} ${slot(level)}"
