// `first` is read after the constructor, so it did not move into it: the
// pair borrows the local and cannot be returned.
class Name(var text: string)
class Couple(val first: Name, val second: Name)

fun couple(): Couple {
    val first = Name("x")
    val pair = Couple(first, Name("y"))
    first.text = "changed"
    pair
}

fun main: int = 0
