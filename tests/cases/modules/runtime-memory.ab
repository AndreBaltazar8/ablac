import "abla/runtime/memory"
import "abla/unsafe/memory"

fun allocateTrackedBuffer(): int {
    val buffer = nativeByteBuffer(4097)
    buffer.store(0, 42)
    runtimeMemoryLiveBytes()
}

fun main: int {
    val baseline = runtimeMemoryLiveBytes()
    val originalLimit = runtimeMemoryLimit()
    runtimeMemorySetLimit(baseline + 8192)
    val budgetInstalled = runtimeMemoryLimit() == baseline + 8192
    val checkpoint = runtimeMemoryCheckpoint()
    // A checkpoint is a marker allocation (one 8-byte block) that its reset
    // keeps; resetting returns to the live bytes just after it.
    val atCheckpoint = runtimeMemoryLiveBytes()
    // Affine resources must leave their lexical lifetime before a generation
    // reset invalidates the ordinary heap objects allocated in that region.
    val allocated = allocateTrackedBuffer()
    runtimeMemoryReset(checkpoint)
    val restored = runtimeMemoryLiveBytes()
    runtimeMemorySetLimit(originalLimit)
    if (budgetInstalled && runtimeMemoryLimit() == originalLimit &&
        allocated >= atCheckpoint + 4097 && restored == atCheckpoint &&
        atCheckpoint - baseline <= 8) 42 else 0
}
