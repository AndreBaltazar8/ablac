// `((int) -> int)?` is a function or null: it takes a function, a lambda and null, and calls after a
// check. `(int) -> string?` is a function returning a `string?`.
class W(val h: ((int) -> int)?) {
    fun go(x: int): int { val f = h; if (f != null) { return f(x) }; return 0 }
}
fun g(x: int): int = x + 1
fun t(): int {
    var f: ((int) -> int)? = null
    if (f != null) return 100
    f = g
    val held = f
    if (held != null) { return held(1) }
    return 0
}
fun u(p: ((int) -> int)?): int { if (p != null) return p(3); 0 }
fun opt(x: int): string? = if (x > 0) "yes" else null
fun w(r: (int) -> string?): int { val s = r(1); if (s == null) 0 else s.size }
class V(var cb: ((string) -> string)? = null) {
    fun set(n: (string) -> string): void { cb = n; return }
    fun run(): string { val c = cb; if (c != null) return c("v"); "none" }
}
fun main: int {
    val v = V()
    v.set({ s: string -> "$s!" })
    W({ x: int -> x * 2 }).go(4) + W(null).go(4) + W(g).go(1) + t() + u({ x: int -> x }) + u(null) + w(opt) + w({ x: int -> opt(0 - x) }) + v.run().size + V().run().size + 18
}
