// Compile-time parity of abla/yaml: parsing a document (mappings, sequences, scalars, an anchor and alias), reading
// values, a parse error and emitting a built value print the same at run time and under `#`
// (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/yaml"

val SOURCE = "name: parity\nversion: 3\nratio: 0.25\nenabled: true\nitems:\n  - first\n  - &shared second\n  - *shared\nnested:\n  key: value\n  empty: ~\n"

fun main: int {
    val parsed = yamlParse(SOURCE)
    println("parsed ${parsed.succeeded} size ${parsed.value.size()}")
    val items = parsed.value.get("items")
    println("items ${items.size()} ${items.at(0).asString()} ${items.at(2).asString()}")
    println("nested ${parsed.value.get("nested").get("key").asString()} empty null ${parsed.value.get("nested").get("empty").isNull()}")
    val bad = yamlParse("key: [unclosed\n")
    println("bad ${bad.succeeded} ${bad.error.code} line ${bad.error.line}")
    val built = yamlObject(["title", "count", "tags"], [yamlString("a: b"), yamlInteger(7), yamlSequence([yamlString("x"), yamlBoolean(false)])])
    println(yamlEmit(built).text)
    println(yamlEmit(parsed.value).text)
    42
}
