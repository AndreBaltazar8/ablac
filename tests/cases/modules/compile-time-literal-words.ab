// More literal spellings than the evaluator memo holds, revisited in a loop.
// The same spelling takes both widths; compare exact words, including special values.
import "abla/float"

fun literalWords(): array<int> {
    val words: array<int> = []
    for (round in 0 until 3) {
        val wide: f64 = 0.1
        val single: f32 = 0.1
        val rounded: f32 = 1.0000000596046448
        val tiny: f32 = 1.401298464324817e-45
        val underflow: f32 = 1e-100
        val negativeZero: f32 = -0.0
        words.append(f64ToBits(wide))
        words.append(int(f32ToBits(single)))
        words.append(int(f32ToBits(rounded)))
        words.append(int(f32ToBits(tiny)))
        words.append(int(f32ToBits(underflow)))
        words.append(int(f32ToBits(negativeZero)))
        for (value in [
            0.0, -0.0, 0.1, 5e-324, 1.7976931348623157e308,
            1e-400, 1.0e+21, 1.0000000000000001e-0, 1.0000000000000001e-1, 1.0000000000000001e-2,
            1.0000000000000001e-3, 1.0000000000000001e-4, 1.0000000000000001e-5, 1.0000000000000001e-6, 1.0000000000000001e-7,
            1.0000000000000001e-8, 1.0000000000000001e-9, 1.0000000000000001e-10, 1.0000000000000001e-11, 1.0000000000000001e-12,
            1.0000000000000001e-13, 1.0000000000000001e-14, 1.0000000000000001e-15, 1.0000000000000001e-16, 1.0000000000000001e-17,
            1.0000000000000001e-18, 1.0000000000000001e-19, 1.0000000000000001e-20, 1.0000000000000001e-21, 1.0000000000000001e-22,
            1.0000000000000001e-23, 1.0000000000000001e-24, 1.0000000000000001e-25, 1.0000000000000001e-26, 1.0000000000000001e-27,
            1.0000000000000001e-28, 1.0000000000000001e-29, 1.0000000000000001e-30, 1.0000000000000001e-31, 1.0000000000000001e-32,
            1.0000000000000001e-33, 1.0000000000000001e-34, 1.0000000000000001e-35, 1.0000000000000001e-36, 1.0000000000000001e-37,
            1.0000000000000001e-38, 1.0000000000000001e-39, 1.0000000000000001e-40, 1.0000000000000001e-41, 1.0000000000000001e-42,
            1.0000000000000001e-43, 1.0000000000000001e-44, 1.0000000000000001e-45, 1.0000000000000001e-46, 1.0000000000000001e-47,
            1.0000000000000001e-48, 1.0000000000000001e-49, 1.0000000000000001e-50, 1.0000000000000001e-51, 1.0000000000000001e-52,
            1.0000000000000001e-53, 1.0000000000000001e-54, 1.0000000000000001e-55, 1.0000000000000001e-56, 1.0000000000000001e-57,
            1.0000000000000001e-58, 1.0000000000000001e-59, 1.0000000000000001e-60, 1.0000000000000001e-61, 1.0000000000000001e-62,
            1.0000000000000001e-63, 1.0000000000000001e-64, 1.0000000000000001e-65, 1.0000000000000001e-66, 1.0000000000000001e-67,
            1.0000000000000001e-68, 1.0000000000000001e-69, 1.0000000000000001e-70, 1.0000000000000001e-71, 1.0000000000000001e-72,
            1.0000000000000001e-73, 1.0000000000000001e-74, 1.0000000000000001e-75, 1.0000000000000001e-76, 1.0000000000000001e-77,
            1.0000000000000001e-78, 1.0000000000000001e-79
        ]) words.append(f64ToBits(value))
        words.append(f64ToBits(f64FromBits(9221120237041090561)))
        words.append(f64ToBits(f64FromBits(-2251799813685247)))
        words.append(int(f32ToBits(f32FromBits(u32(2143289345)))))
        words.append(int(f32ToBits(f32FromBits(u32(4290772993)))))
    }
    words
}

compile fun stagedLiteralWords(): array<int> = literalWords()
val LITERAL_WORDS = #stagedLiteralWords()

fun main: int {
    val native = literalWords()
    if (LITERAL_WORDS.size != native.size) return 1
    for (index in 0 until native.size) {
        if (LITERAL_WORDS[index] != native[index]) return 2
    }
    42
}
