#import("abla/runtime/memory")
#import("abla/unsafe/memory")

class Link(var next: Link?, val value: int)

var globalRoot = Link(null, 21)

compile fun stagedCollection(): int {
    if (runtimeMemoryCollect() >= 0) 1 else 0
}

fun collectIndirect(callback: () -> int): int = callback()

fun abandonCycle(): int {
    val left = Link(null, 1)
    val right = Link(null, 2)
    left.next = right
    right.next = left
    val abandoned = [left, right, Link(null, 3)]
    if (abandoned.size == 3) 1 else 0
}

fun main: int {
    val live = Link(null, 21)
    val native = nativeByteBuffer(8)
    native.store(0, 42)
    val made = abandonCycle()
    val before = runtimeMemoryLiveBytes()
    val freed = collectIndirect(runtimeMemoryCollect)
    val after = runtimeMemoryLiveBytes()
    if (made == 1 && freed > 0 && after + freed == before &&
        live.value + globalRoot.value == 42 && native.load(0) == 42 &&
        #stagedCollection() == 1) 42 else 1
}
