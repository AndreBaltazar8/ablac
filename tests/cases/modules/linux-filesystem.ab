#import("abla/sys/linux/fs")

fun main: int {
    val directory = Path("build/linux-filesystem-test")
    val first = directory.child("nested").child("value.txt")
    val moved = directory.child("moved.txt")
    val current = currentDirectory()
    val written = first.writeTextAtomic("native-abla-fs")
    val info = first.info()
    val contents = first.readText()
    val movedOkay = first.moveTo(moved)
    val entries = directory.entries()
    var found = false
    var index = 0
    while (index < entries.size) {
        if (entries[index].name() == "moved.txt") found = true
        index = index + 1
    }
    val removed = moved.remove()
    if (written && info.isFile() && info.size == 14 &&
        contents == "native-abla-fs" && movedOkay && found && removed &&
        current.text.size > 0) 42 else 0
}
