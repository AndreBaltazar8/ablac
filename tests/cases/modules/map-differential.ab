// Map<K, V> against a reference model (parallel arrays, linear search) over random
// set/get/has/remove/take sequences: int and string keys, int, string and object
// values, tables that grow and shrink, keys that collide on their low bits.
import "abla/io"
import "abla/array"

class Item(val name: string, var count: int)

var seed = 88172645463325252

fun next(): int {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >>> 7)
    seed = seed ^ (seed << 17)
    seed >>> 1
}

fun fail(label: string, step: int): int {
    println("FAIL $label at $step")
    1
}

// Keys: a small range so sets overwrite and removes hit, some far apart so slots collide.
fun intKey(raw: int, spread: int): int = (raw % spread) * (if (raw % 3 == 0) 4096 else 1)

fun runInts(steps: int, spread: int): int {
    val map: Map<int, int> = Map()
    val modelKeys: array<int> = []
    val modelValues: array<int> = []
    var failures = 0
    var step = 0
    while (step < steps && failures == 0) {
        val key = intKey(next(), spread)
        val op = next() % 10
        var at = -1
        var scan = 0
        while (scan < modelKeys.size) {
            if (modelKeys[scan] == key) at = scan
            scan = scan + 1
        }
        if (op < 5) {
            map.set(key, step)
            if (at >= 0) modelValues[at] = step
            else {
                modelKeys.append(key)
                modelValues.append(step)
            }
        } else if (op < 7) {
            val got = map.get(key)
            if (at >= 0) { if (got != modelValues[at]) failures = fail("get", step) }
            else if (got != null) failures = fail("absent get", step)
        } else if (op < 8) {
            if (map.has(key) != (at >= 0)) failures = fail("has", step)
        } else {
            val removed = map.remove(key)
            if (removed != (at >= 0)) failures = fail("remove", step)
            if (at >= 0) {
                modelKeys.removeAt(at)
                modelValues.removeAt(at)
            }
        }
        if (map.size != modelKeys.size) failures = fail("size", step)
        step = step + 1
    }
    val keys = map.keys()
    if (keys.size != modelKeys.size) failures = failures + fail("keys size", step)
    var index = 0
    while (failures == 0 && index < keys.size) {
        if (keys[index] != modelKeys[index]) failures = fail("key order", index)
        index = index + 1
    }
    failures
}

fun runStrings(steps: int, spread: int): int {
    val map: Map<string, Item> = Map()
    val modelKeys: array<string> = []
    val modelValues: array<int> = []
    var failures = 0
    var step = 0
    while (step < steps && failures == 0) {
        val key = "key-${next() % spread}"
        val op = next() % 10
        var at = -1
        var scan = 0
        while (scan < modelKeys.size) {
            if (modelKeys[scan] == key) at = scan
            scan = scan + 1
        }
        if (op < 5) {
            map.set(key, Item(key, step))
            if (at >= 0) modelValues[at] = step
            else {
                modelKeys.append(key)
                modelValues.append(step)
            }
        } else if (op < 8) {
            val got = map.get(key)
            if (at >= 0) {
                if (got == null || got.count != modelValues[at] || got.name != key) {
                    failures = fail("string get", step)
                }
            } else if (got != null) failures = fail("string absent", step)
        } else {
            val removed = map.remove(key)
            if (removed != (at >= 0)) failures = fail("string remove", step)
            if (at >= 0) {
                modelKeys.removeAt(at)
                modelValues.removeAt(at)
            }
        }
        if (map.size != modelKeys.size) failures = fail("string size", step)
        step = step + 1
    }
    failures
}

fun main: int {
    var failures = 0
    failures = failures + runInts(1500, 20)
    failures = failures + runInts(1500, 400)
    failures = failures + runStrings(1200, 25)
    failures = failures + runStrings(1200, 300)
    if (failures == 0) 42 else 1
}
