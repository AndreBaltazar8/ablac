// The same `Handle` made to conform by `extend` is what a `Source`'s `read` can run: denied.
import "abla/fs"
interface Source { fun read(): int }
class Counted(val count: int) : Source {
    fun read(): int = count
}
class Handle(val path: string)
fun Handle.read(): int = Path(path).readText().size
extend Handle : Source
fun total(source: Source): int = source.read()
compile fun measured(): int = Handle("forty").path.size + total(Counted(37))
val measure = #measured()
fun main: int = measure
