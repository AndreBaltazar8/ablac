// Compile-time parity of abla/crypto/hkdf: extract, expand and TLS 1.3's derive-secret over fixed inputs print the same
// bytes at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/hkdf"
import "abla/crypto/result"

fun show(result: CryptoResult): string = if (result.ok) hexEncode(result.bytes) else "error ${result.error}"

fun main: int {
    val ikm = hexDecode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    val salt = hexDecode("000102030405060708090a0b0c")
    val info = hexDecode("f0f1f2f3f4f5f6f7f8f9")
    val prk = hkdfExtract(HKDF_SHA256, salt, ikm)
    println("prk ${hexEncode(prk)}")
    println("okm ${show(hkdfExpand(HKDF_SHA256, prk, info, 42))}")
    println("one call ${show(hkdf(HKDF_SHA256, salt, ikm, info, 42))}")
    println("too long ${show(hkdfExpand(HKDF_SHA256, prk, info, 255 * 32 + 1))}")
    println("derive ${show(tls13DeriveSecret(HKDF_SHA256, prk, "derived", ""))}")
    42
}
