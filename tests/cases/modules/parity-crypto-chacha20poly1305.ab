// Compile-time parity of abla/crypto/chacha20poly1305: seal, open, the bare stream and Poly1305 over fixed keys print
// the same bytes at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/chacha20poly1305"

fun show(result: CryptoResult): string = if (result.ok) hexEncode(result.bytes) else "error ${result.error}"

fun main: int {
    val key = hexDecode("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    val nonce = hexDecode("070000004041424344454647")
    val message = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future"
    val sealed = chaCha20Poly1305Seal(key, nonce, message, hexDecode("50515253c0c1c2c3c4c5c6c7"))
    println("seal ${show(sealed)}")
    println("open ${show(chaCha20Poly1305Open(key, nonce, sealed.bytes, hexDecode("50515253c0c1c2c3c4c5c6c7")))}")
    println("open tampered ${chaCha20Poly1305Open(key, nonce, sealed.bytes, "").ok}")
    println("xor ${show(chaCha20Xor(key, 1, nonce, "stream"))}")
    println("poly1305 ${show(poly1305(key, "Cryptographic Forum Research Group"))}")
    42
}
