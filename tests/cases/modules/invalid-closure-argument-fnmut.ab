// A closure that changes what it captured (here an object's field) is an
// FnMut: the error says how to declare the parameter that takes it.
class Box(var v: int)
fun twice(g: () -> int): int = g() + g()
fun main: int {
    val box = Box(0)
    twice({ ->
        box.v = box.v + 1
        box.v
    })
}
