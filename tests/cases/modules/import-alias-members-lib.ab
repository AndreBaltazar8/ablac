// Top-level names that a class's members, parameters, locals and named
// arguments share. Imported under an alias, the top-level ones carry the
// module's prefix and the others keep their names.
val level = 5
fun slot(value: int): int = value + 1

class Item(var slot: int, var code: int, var level: int) {
    fun twice(): int = slot * 2
    fun levelHere(): int = level
    fun viaExtension(): int = extra()
}

class Box(val size: int) {
    fun slot(): int = size + 40
    fun other(): int = slot() + size
}

fun Item.extra(): int = slot * 10
fun Box.third(): int = slot() + size

fun withParameter(level: int): int = level * 2
fun named(): int = withParameter(level = 4) + Item(slot = 1, code = 2, level = 3).slot

fun withLocal(): int {
    val level = 3
    level
}

fun applyTo(function: (int) -> int): int = function(10)
fun withLambda(): int = applyTo { level -> level + 1 }

fun topLevel(): int = slot(1) + level
