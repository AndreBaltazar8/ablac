import "abla/unsafe/memory"

val staticRegion = nativeStaticAllocate(32)

trusted fun main: int {
    val pointer = nativePointerFromAddress(staticRegion)
    ablaUnsafeStoreU16(pointer, 40)
    ablaUnsafeStoreU8(ablaUnsafePointerOffset(pointer, 2), 2)
    ablaUnsafeLoadU16(pointer) +
        ablaUnsafeLoadU8(ablaUnsafePointerOffset(pointer, 2))
}
