// Compile-time parity of abla/uuid: parsing (and refusing) UUID text, building one from bytes and writing it back
// print the same at run time and under `#` (tools/test-compile-time-parity.sh). (uuidV4 and uuidV7 are random and
// time-based, so they are only checked for their shape.)
import "abla/io"
import "abla/uuid"

fun main: int {
    val parsed = uuidParse("123E4567-e89b-12d3-a456-426614174000")
    println("parsed ${if (parsed != null) uuidText(parsed) else "null"}")
    println("bad ${uuidParse("123e4567-e89b-12d3-a456-42661417400") == null} ${uuidParse("not a uuid") == null}")
    val fromBytes = uuidFromBytes("0123456789abcdef")
    println("from bytes ${if (fromBytes != null) uuidText(fromBytes) else "null"} short ${uuidFromBytes("short") == null}")
    if (parsed != null && fromBytes != null) println("equal ${parsed.equals(parsed)} ${parsed.equals(fromBytes)}")
    val v4 = uuidV4()
    val v7 = uuidV7()
    println("v4 ${if (v4 != null) uuidText(v4).size else 0} v7 ${if (v7 != null) uuidText(v7).size else 0}")
    42
}
