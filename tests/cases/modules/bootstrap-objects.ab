import "../../../src/backend_c.ab"

fun main: int {
    val source =
        "class Pair(val left: int, val right: int)\nfun main: int {\nval pair = Pair(19, 23)\npair.left + pair.right\n}"
    val program = bootstrapLower(source)
    if (
        program.errors == 0 &&
        program.classes.size == 1 &&
        program.classes[0].fields.size == 2 &&
        program.functions.size == 1
    ) 42 else 0
}
