import "abla/net/hosted"

fun hostedCancelNow(): bool = true

fun testHostedTcp(): bool {
    val listener = hostedTcpListen("::1", 0, 16, false)
    if (listener.descriptor < 0) return false
    val port = listener.localPort()
    val client = hostedTcpConnect("::1", port, 2000)
    if (client.descriptor < 0) return false
    val server = listener.accept()
    if (server.descriptor < 0) return false
    val written = client.writeNetwork("portable tcp", 2000)
    val input = server.readResult(64)
    val typed = input.networkOutcome()
    val cancelled = server.readNetwork(
        64, 1000, NetworkCancellation(hostedCancelNow), 10
    )
    val cancelledWrite = server.writeNetwork(
        "unused", 1000, NetworkCancellation(hostedCancelNow), 10
    )
    server.close()
    client.close()
    listener.close()
    port > 0 && written.written == 12 && input.hasData() &&
        input.bytes == "portable tcp" && typed.hasData() &&
        !typed.error.present() && cancelled.cancelled() &&
        cancelled.error.category == "cancelled" &&
        cancelledWrite.cancelled()
}

fun testHostedUdpAndPoller(): bool {
    val receiver = hostedUdpBind("::1", 0, false)
    val sender = hostedUdpBind("::1", 0, false)
    if (receiver.descriptor < 0 || sender.descriptor < 0) return false
    val receiverPort = receiver.localPort()
    val poller = hostedSocketPoller()
    if (poller.descriptor < 0) return false
    val watched = poller.watchDescriptor(receiver.descriptor)
    val sent = sender.sendTo("portable udp", "::1", receiverPort)
    val ready = poller.wait(4, 2000)
    val udp = receiver.receiveFrom(64)
    poller.close()
    sender.close()
    receiver.close()
    watched && sent == 12 && !ready.failed() &&
        ready.events.size == 1 && ready.events[0].readable &&
        udp.received && udp.bytes == "portable udp" &&
        udp.sourceAddress == "::1" && udp.sourcePort > 0
}

fun main: int =
    if (testHostedTcp() && testHostedUdpAndPoller()) 42 else 1
