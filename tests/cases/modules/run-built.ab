// What `ablac run` hands the program: its arguments after `--`, the caller's
// environment, working directory and standard input (tools/test-run-built.sh).
import "abla/io"
import "abla/process"
import "abla/sys/linux/fs"

fun main: int {
    var index = 0
    while (index < processArgumentCount()) {
        println("argument ${processArgument(index)}")
        index = index + 1
    }
    println("environment ${processEnvironmentOr("ABLA_RUN_PROBE", "unset")}")
    println("directory ${currentDirectory().name()}")
    println("input ${readLine()}")
    42
}
