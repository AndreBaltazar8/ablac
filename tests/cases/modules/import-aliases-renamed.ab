import "abla/compiler"
import "import-alias-right.ab" as secondary
import "import-alias-left.ab" as primary

compile fun aliasReflectionFailure: int {
    val functions = compilerFunctionsAnnotated("aliasProbe")
    if (functions.size == 1 &&
        compilerFunctionName(functions[0]) == "connect" &&
        compilerFunctionModuleIdentity(functions[0]).size > 0 &&
        compilerFunctionCanonicalIdentity(functions[0]) != "connect" &&
        compilerTypeModuleIdentity(
            compilerFunctionResultTypeHandle(functions[0])
        ) == compilerFunctionModuleIdentity(functions[0])) 0
    else 100
}

val aliasReflectionResult = #aliasReflectionFailure()

fun leftValue(value: primary.ImportAliasResult): int = value.doubled()

class ShapeHolder(val shape: primary.ImportAliasShape?)

class RuntimeLeft(val value: int)

fun shadowAlias(left: RuntimeLeft): int = left.value

fun main: int {
    val leftResult: primary.ImportAliasResult = primary.connect(5)
    val rightResult: secondary.ImportAliasResult = secondary.connect(7)
    val values: array<primary.ImportAliasResult> = [
        primary.origin,
        leftResult
    ]
    val invoke = secondary.callback
    primary.aliasCounter = primary.aliasCounter + 1
    leftValue(values[1]) + rightResult.value + invoke(32) -
        primary.aliasCounter + aliasReflectionResult +
        shadowAlias(RuntimeLeft(0))
}
