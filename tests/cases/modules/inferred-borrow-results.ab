// A result that returns a reference into a parameter or `this` gets the
// `borrow(source)` contract inferred: no annotation, and the caller's use of
// the result is checked against its argument like any other view.
class Counter(var value: int)

class Holder(val counter: Counter)

class Box(val counter: Counter) {
    fun get(): Counter = counter
}

fun same(counter: Counter): Counter = counter

fun Counter.itself(): Counter = this

fun bumped(var counter: Counter): Counter {
    counter.value = counter.value + 1
    counter
}

fun wrap(counter: Counter): Holder = Holder(counter)

fun found(counters: array<Counter>, value: int): Counter {
    for (counter in counters) if (counter.value == value) return counter
    Counter(-1)
}

fun inner(holder: Holder): Counter = holder.counter

fun again(counter: Counter): Counter = same(counter)

fun increment(var counter: Counter): void {
    counter.value = counter.value + 1
    return
}

fun views(): int {
    val kept: array<Counter> = []
    val counter = Counter(1)
    val view = same(counter)
    val before = view.value           // 1
    increment(counter)                // fine: `view` is not used again
    val holder = wrap(counter)
    val held = holder.counter.value   // 2
    increment(counter)                // fine: `holder` is not used again
    kept.append(same(Counter(10)))    // a view of a new value is that value
    val box = Box(Counter(5))
    val counters = [Counter(7), Counter(8)]
    before + held + bumped(counter).value + counter.itself().value +
        kept[0].value + box.get().value + found(counters, 8).value +
        inner(Holder(Counter(3))).value + again(counter).value - 31
}

compile fun stagedViews(): int = views()

fun main: int = if (views() == 10 && #stagedViews() == 10) 42 else 0
