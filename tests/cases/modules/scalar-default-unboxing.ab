import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"

@inline
fun scalarDefaultAdd(value: int, offset: int = 2, enabled: bool = true): int =
    if (enabled) value + offset else value

@export("abla_scalar_default_unboxing")
fun scalarDefaultUnboxing(value: i32): i32 = i32(scalarDefaultAdd(int(value)))

trusted fun main: int {
    if (scalarDefaultUnboxing(i32(40)) != i32(42)) return 10
    if (scalarDefaultAdd(40, 7, false) != 40) return 11
    if (scalarDefaultAdd(40, -2) != 38) return 12
    if (ablaRuntimeValueWord0(42) != 42 || ablaRuntimeValueWord0(-9) != -9) return 13
    if (ablaRuntimeValueWord0(false) != 0 || ablaRuntimeValueWord0(true) != 1) return 14
    val memory = nativePointerFromAddress(nativeStackAllocate(16))
    ablaUnsafeStoreI64(memory, 73)
    val next = ablaUnsafePointerOffset(memory, 8)
    ablaUnsafeStoreI64(next, 91)
    if (ablaUnsafeLoadI64(ablaUnsafePointerOffset(next, -8)) != 73 || ablaUnsafeLoadI64(next) != 91) return 2
    // Never dereference these synthetic addresses; non-inbounds byte offsets
    // retain the previous pointer-width wrapping and null-base semantics.
    if (nativePointerAddress(ablaUnsafePointerOffset(nativePointerFromAddress(-8), 8)) != 0) return 3
    if (nativePointerAddress(ablaUnsafePointerOffset(nativeNullPointer(), 8)) != 8) return 4
    val separate = nativePointerFromAddress(nativeStackAllocate(8))
    ablaUnsafeStoreI64(separate, 137)
    val distance = nativePointerAddress(separate) - nativePointerAddress(memory)
    if (ablaUnsafeLoadI64(ablaUnsafePointerOffset(memory, distance)) != 137) return 5
    0
}
