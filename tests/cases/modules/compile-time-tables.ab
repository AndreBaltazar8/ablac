// A compile-time table of tens of thousands of entries is evaluated whole
// (the step budget is 50 million) and becomes a static table.
compile fun stagedTable(): array<int> {
    val values: array<int> = []
    var index = 0
    while (index < 20000) {
        values.append(index * 3)
        index = index + 1
    }
    values
}

val TABLE = #stagedTable()

fun main: int =
    if (TABLE.size == 20000 && TABLE[19999] == 59997) 42 else 1
