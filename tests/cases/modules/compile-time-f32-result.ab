import "abla/float"

// An f32 result becomes the same f32 in the program.
compile fun stagedSingle(): f32 = f64ToF32(0.1)
compile fun stagedSingles(): array<f32> = [f64ToF32(0.5), f64ToF32(-3.75)]

val SINGLE = #stagedSingle()
val SINGLES = #stagedSingles()

fun main: int = if (SINGLE == f64ToF32(0.1) && SINGLES[0] == f64ToF32(0.5) &&
    SINGLES[1] == f64ToF32(-3.75)) 42 else 1
