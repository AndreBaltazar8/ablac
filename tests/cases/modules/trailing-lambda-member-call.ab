import "abla/io"

class C(val n: int) {
    fun apply(k: int, f: (int) -> int): int = f(n + k)
    fun run(f: (int) -> int): int = f(n)
}

fun int.twice(k: int, f: (int) -> int): int = f(this) + k

fun main {
    val c = C(1)
    val a = c.apply(2) { v -> v * 10 }
    val b = 5.twice(1) { v -> v * 2 }
    val d = c.run() { v -> v + 100 }
    val e = c.run { v -> v - 1 }
    println("$a $b $d $e")
}
