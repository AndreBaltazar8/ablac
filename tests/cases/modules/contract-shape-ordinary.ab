import "contract-provider.ab"
import "contract-server-support.ab" as support
import contract "contract-backend.ab" as backend

// The contract's shapes need a module this client also uses itself: that module
// keeps its implementation, and the contract's module still stays out.
val contractMarker = $contractCall(backend.remoteIncrement(40))

fun main: int {
    val own: support.ContractResult = support.ContractResult(support.serverAdd(20, 22), null)
    if (own.value != 42) return 1
    generatedContractMetadata() + contractMarker
}
