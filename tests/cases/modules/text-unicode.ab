import "abla/text"
import "abla/bytes"

fun utf8WordBoundariesWork(): bool {
    var prefix = ""
    var valid = true
    for (index in 0 until 24) {
        val good = "${prefix}é€😀abcdefghijklmnopqrstuvwxyz"
        valid = valid && prefix.isValidUtf8() && good.isValidUtf8()
        for (bad in [byteEncode(128), byteEncode(255),
            "${byteEncode(192)}${byteEncode(128)}",
            "${byteEncode(237)}${byteEncode(160)}${byteEncode(128)}",
            "${byteEncode(244)}${byteEncode(144)}${byteEncode(128)}${byteEncode(128)}",
            "${byteEncode(226)}${byteEncode(130)}"]) {
            valid = valid && !"$prefix$bad".isValidUtf8() &&
                !"${prefix}${bad}abcdefghijklmnopqrstuvwxyz".isValidUtf8()
        }
        prefix = "${prefix}a"
    }
    valid
}

fun asciiBytePairsWork(): bool {
    val bytes: array<string> = []
    for (byte in 0 until 256) bytes.append(byteEncode(byte))
    for (left in 0 until 256) {
        val expectedLeft = if (left >= 65 && left <= 90) left + 32 else left
        for (right in 0 until 256) {
            val expectedRight = if (right >= 65 && right <= 90) right + 32 else right
            if (textAsciiEqualInsensitive(bytes[left], bytes[right]) !=
                (expectedLeft == expectedRight)) return false
        }
        if (!textAsciiEqualInsensitive("Ab${bytes[left]}Z", "aB${bytes[left]}z")) return false
    }
    !textAsciiEqualInsensitive("A[Z", "a{z") &&
        !textAsciiEqualInsensitive("A@Z", "a`z")
}

fun main: int {
    val text = "Aé€😀"
    val invalid = "${text.slice(0, 2)}${text.slice(3, text.size)}"
    val overlong = "${byteEncode(192)}${byteEncode(128)}"
    val surrogate = "${byteEncode(237)}${byteEncode(160)}${byteEncode(128)}"
    val beyondUnicode = "${byteEncode(244)}${byteEncode(144)}${byteEncode(128)}${byteEncode(128)}"
    if (utf8WordBoundariesWork() && #utf8SequenceLength(240) == 4 &&
        #utf8DecodeAt("😀", 0) == 128512 && text.size == 10 &&
        #textFindSequence("request\r\nheader\r\n", "\r\n", 0, 17) == 7 &&
        #textFindSequence("request", "", 3, 7) == 3 &&
        #textFindByte("request: value", 58, 0, 14) == 7 &&
        #textFindByte("request", 300, 0, 7) == -1 &&
        #textReadU32LittleEndian("ABCD", 0) == 1145258561 &&
        #textAsciiEqualInsensitive("Content-Type", "content-type") &&
        #textAsciiEqualInsensitive("", "") &&
        #textAsciiEqualInsensitive("AB", "ab") &&
        #textAsciiEqualInsensitive("AB", "ac") == false &&
        asciiBytePairsWork() && text.isValidUtf8() && text.codePointCount() == 4 &&
        textFindSequence("request\r\nheader\r\n", "\r\n", 0, 17) == 7 &&
        textFindSequence("request", "missing", 0, 7) == -1 &&
        textFindSequence("request", "", 3, 7) == 3 &&
        textFindSequence("request", "r", -1, 7) == -1 &&
        textFindByte("request: value", 58, 0, 14) == 7 &&
        textFindByte("request", 58, 0, 7) == -1 &&
        textFindByte("request", 300, 0, 7) == -1 &&
        textReadU32LittleEndian("ABCD", 0) == 1145258561 &&
        textReadU32LittleEndian("abc", 0) == -1 &&
        textAsciiEqualInsensitive("Content-Type", "content-type") &&
        textAsciiEqualInsensitive("", "") &&
        textAsciiEqualInsensitive("A", "a") &&
        textAsciiEqualInsensitive("AB", "ab") &&
        !textAsciiEqualInsensitive("AB", "ac") &&
        !textAsciiEqualInsensitive("A", "") &&
        !textAsciiEqualInsensitive("Content-Type", "content-length") &&
        text.codePointAt(0) == 65 && text.codePointAt(1) == 233 &&
        text.codePointAt(2) == 8364 && text.codePointAt(3) == 128512 &&
        text.codePointAt(4) == -1 && text.codePointSlice(1, 3) == "é€" &&
        !invalid.isValidUtf8() && !overlong.isValidUtf8() &&
        !surrogate.isValidUtf8() && !beyondUnicode.isValidUtf8() &&
        invalid.codePointCount() == -1) 42 else 0
}
