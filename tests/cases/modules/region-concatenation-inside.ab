import "abla/io"
fun build(n: int): string {
    var s = ""
    for (i in 0 until n) s = s + "x"
    s
}
fun main: int {
    var total = 0
    val n = region {
        val inner = build(5) + "!"
        total = inner.size
        0
    }
    val other = region {
        val junk = build(50)
        junk.size
    }
    println("$total $n $other")
    0
}
