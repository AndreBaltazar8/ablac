noescape extern:"c" fun strlen(text: cstring): int

@noinline
fun nativeLength(text: string): int = strlen(text)

fun main: int {
    val source = "[0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]"
    // This view has no NUL at its end; the C conversion must make a copy.
    val view = source.slice(1, source.size - 1)
    val rope = view + view
    if (nativeLength("Abla") == 4 && nativeLength("") == 0 &&
        nativeLength(view) == view.size && nativeLength(rope) == rope.size &&
        nativeLength("a\x00b") == 1) 42 else 0
}
