interface ImportAliasShape {
    fun area: int
}

class ImportAliasResult(val value: int) {
    fun doubled: int = this.value * 2
}

val origin = ImportAliasResult(10)
var aliasCounter = 0

@aliasProbe
fun connect(value: int): ImportAliasResult {
    aliasCounter = aliasCounter + value
    ImportAliasResult(aliasCounter)
}

fun callback(value: int): int = value + 1
