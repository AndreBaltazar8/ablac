// A failure in a loop ends the loop, and what's reported of it stays short.
import "abla/compiler"
class Broken(val parts: array<int>) {
    fun next(): int = missing()
}
fun deep(broken: Broken, level: int): int =
    if (level == 0) broken.next() else deep(broken, level - 1) + 1
compile fun generate(): void {
    val broken = Broken([])
    while (true) deep(broken, 100)
    return
}
#compiler.transform(generate)
fun main: int = 0
