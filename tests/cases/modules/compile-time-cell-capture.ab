// A program's `Cell` under `#` is the value it is at run time, also when a
// closure or a generator keeps the binding that holds it: reading the name
// gives the cell, never its content.
fun local(): string {
    val log = Cell(0)
    log.set(log.get() * 10 + 4)
    "${log.get()}"
}

fun captured(): string {
    val log = Cell(1)
    val add: (int) -> void = { step -> log.set(log.get() * 10 + step) }
    add(2)
    add(3)
    var count = 0
    val bump = { count += 1 }
    bump()
    bump()
    "${log.get()} $count"
}

fun replaced(): string {
    var log = Cell(5)
    val read = { -> log.get() }
    log = Cell(7)
    "${read()}"
}

fun kept(): Generator<int> = generator {
    val log = Cell(0)
    var step = 1
    while (step <= 3) {
        log.set(log.get() + step)
        yield log.get()
        step = step + 1
    }
}

fun generated(): string {
    var text = ""
    for (value in kept()) text = "$text$value "
    text
}

fun report(): string =
    "${local()} | ${captured()} | ${replaced()} | ${generated()}"

val STAGED = #report()

fun main: int {
    val runtime = report()
    if (STAGED != runtime) 1
    else if (runtime != "4 | 123 2 | 7 | 1 3 6 ") 2
    else 42
}
