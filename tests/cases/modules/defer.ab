var trace = 0

fun record(value: int): void {
    trace = trace * 10 + value
    return
}

fun normalExit(): void {
    defer { record(1) }
    defer { record(2) }
    return
}

fun earlyReturn(): void {
    defer { record(3) }
    return
}

fun loopExit(): void {
    var current = 0
    while (current < 2) {
        if (current == 0) {
            defer { record(4) }
            current = current + 1
            continue
        } else {
            defer { record(5) }
            break
        }
    }
}

class Counter(val value: Cell<int>)

compile fun staged(counter: Counter): void {
    defer {
        val changed = counter.value.set(counter.value.get() * 10 + 2)
    }
    val changed = counter.value.set(1)
    return
}

compile fun stagedResult(): int {
    val counter = Counter(Cell(0))
    staged(counter)
    counter.value.get()
}

fun main: int {
    normalExit()
    earlyReturn()
    loopExit()
    if (trace == 21345 && #stagedResult() == 12) 42 else 1
}
