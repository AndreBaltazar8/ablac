import "abla/bits"

fun main: int {
    if (bitAnd(240, 60) != 48) 10
    else if (bitOr(240, 15) != 255) 20
    else if (bitXor(170, 255) != 85) 30
    else if (bitAnd(bitNot(0), 4294967295) != 4294967295) 40
    else if (bitShiftLeft(1, 31) != 2147483648) 50
    else if (bitShiftRightUnsigned(2147483648, 31) != 1) 60
    else 0
}
