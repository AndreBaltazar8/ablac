var jwtTestFailures = 0

fun jwtTestExpect(keys: JwtKeySet, name: string, token: string, error: string): void {
    val result = keys.verify(token, JwtOptions(
        issuer = "Example", audience = "app", nowSeconds = 1900000000
    ))
    val ok = if (error == "") result.valid && result.subject == "player-42" &&
        result.claims.get("extra").getString("platform") == "web"
        else !result.valid && result.error == error
    if (!ok) {
        println("FAIL $name: valid=${result.valid} error=${result.error} subject=${result.subject}")
        jwtTestFailures = jwtTestFailures + 1
    }
    return
}

fun jwtTestCheck(name: string, ok: bool): void {
    if (!ok) {
        println("FAIL $name")
        jwtTestFailures = jwtTestFailures + 1
    }
    return
}

fun main: int {
    val keys = jwtKeySet(jwtTestKeys)
    if (keys.error != "" || keys.size() != 2 || !keys.hasKey("ec-1")) {
        println("FAIL keyset: ${keys.error} size=${keys.size()}")
        return 1
    }
    jwtTestExpect(keys, "rsValid", jwtTestRsValid, "")
    jwtTestExpect(keys, "esValid", jwtTestEsValid, "")
    jwtTestExpect(keys, "noKid", jwtTestNoKid, "")
    jwtTestExpect(keys, "expired", jwtTestExpired, "token expired")
    jwtTestExpect(keys, "future", jwtTestFuture, "token not yet valid")
    jwtTestExpect(keys, "wrongIss", jwtTestWrongIss, "unexpected issuer")
    jwtTestExpect(keys, "noSub", jwtTestNoSub, "subject not found in token")
    jwtTestExpect(keys, "unknownKid", jwtTestUnknownKid, "no matching key")
    jwtTestExpect(keys, "none", jwtTestNone, "unsupported algorithm")
    jwtTestExpect(keys, "algSwap", jwtTestAlgSwap, "no matching key")
    jwtTestExpect(keys, "tampered", jwtTestTampered, "signature verification failed")
    jwtTestExpect(keys, "esTampered", jwtTestEsTampered, "signature verification failed")
    val wrongAudience = keys.verify(
        jwtTestRsValid, JwtOptions(audience = "nope", nowSeconds = 1900000000)
    )
    jwtTestCheck("audience", !wrongAudience.valid &&
        wrongAudience.error == "unexpected audience")
    val tolerated = keys.verify(
        jwtTestExpired, JwtOptions(clockToleranceSeconds = 5, nowSeconds = 1900000000)
    )
    jwtTestCheck("tolerance", tolerated.valid)
    val malformed = keys.verify("abc.def", JwtOptions(nowSeconds = 1900000000))
    jwtTestCheck("malformed", !malformed.valid &&
        malformed.error == "malformed token")
    // System clock: the vectors expire in 2030, so they verify today.
    jwtTestCheck("clock", keys.verify(jwtTestRsValid, JwtOptions(issuer = "Example")).valid)
    val raw = "\xfb\xff\xbf\x00ab"
    jwtTestCheck("base64url", jwtBase64UrlEncode(raw) == "-_-_AGFi" &&
        jwtBase64UrlDecode("-_-_AGFi").bytes == raw &&
        !jwtBase64UrlDecode("a*b").valid && !jwtBase64UrlDecode("abcde").valid)
    val bad = jwtKeySet("{\"keys\":3}")
    jwtTestCheck("bad jwks", bad.error != "")
    if (jwtTestFailures == 0) 42 else 1
}
