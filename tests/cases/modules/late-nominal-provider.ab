import "abla/compiler"
import "abla/compiler/parser"

compile fun finalizeLateNominal(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val target = typedCallTarget(expression)
    val module = compilerGeneratedModule("late.nominal", expression)
    val valid = compilerFunctionName(target) == "lateNominalAction" &&
        compilerFunctionParameterCount(target) == 1 &&
        compilerFunctionParameterName(target, 0) == "value" &&
        compilerFunctionParameterType(target, 0) == "i64" &&
        compilerFunctionResultType(target) == "LateNominalResult" &&
        compilerTypeName(compilerFunctionResultTypeHandle(target)) ==
            "LateNominalResult"
    val parameterNames: array<string> = ["argument"]
    val parameterTypes: array<int> = [compilerFindType("i64")]
    val arguments: array<SyntaxExpression> = [
        syntaxIdentifier("argument")
    ]
    compilerGeneratedFunction(
        module,
        "adapter",
        parameterNames,
        parameterTypes,
        compilerFindType("LateNominalResult"),
        syntaxCallTarget(target, arguments)
    )
    val exportedArguments: array<SyntaxExpression> = [
        syntaxIdentifier("argument")
    ]
    compilerGeneratedExportFunction(
        module,
        generatedName,
        parameterNames,
        parameterTypes,
        compilerFindType("LateNominalResult"),
        compilerGeneratedDeclarationCall(module, 0, exportedArguments)
    )
    if (!valid || compilerGeneratedDeclarationCount(module) != 2 ||
        compilerGeneratedDeclarationOriginBegin(module, 0) !=
            syntaxBegin(expression) ||
        compilerGeneratedDeclarationOriginEnd(module, 1) !=
            syntaxEnd(expression)) {
        val invalidNames: array<string> = []
        val invalidTypes: array<int> = []
        compilerGeneratedFunction(
            module,
            "invalidLateNominalAdapter",
            invalidNames,
            invalidTypes,
            compilerFindType("MissingType"),
            syntaxInteger(0)
        )
    }
    module
}

compile fun parseLateNominal(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "late.nominal",
        "generatedLateNominalAdapter",
        expression,
        finalizeLateNominal
    )
    expression
}

#compilerRegisterSubparser("lateNominal", parseLateNominal)
