resource class Counter(var value: int) {
    fun add(delta: int): int {
        this.value = this.value + delta
        this.value
    }

    fun read(): int = this.value

    fun copyFrom(other: Counter): int {
        this.value = other.value
        this.value
    }
}

class CounterPair(var left: Counter, var right: Counter)

fun increment(var counter: Counter, delta: int): int {
    counter.value = counter.value + delta
    counter.value
}

fun addThroughBorrow(var counter: Counter, delta: int): int =
    counter.add(delta)

fun readThroughBorrow(counter: Counter): int = counter.read()

fun copyValue(var target: Counter, source: Counter): int {
    target.value = source.value
    target.value
}

fun invokeMutable(
    callback: (var: Counter, int) -> int,
    var counter: Counter,
    delta: int
): int = callback(counter, delta)

fun bumpFirst(var values: array<Counter>, delta: int): int {
    values[0].value = values[0].value + delta
    values[0].value
}

fun runtimeMutableBorrows(): int {
    val counter = Counter(10)
    increment(counter, 5)
    val callback = increment
    callback(counter, 5)
    invokeMutable(increment, counter, 5)
    counter.add(5)
    addThroughBorrow(counter, 5)
    val values = [Counter(3)]
    bumpFirst(values, 4)
    val pair = CounterPair(Counter(1), Counter(2))
    val disjoint = copyValue(pair.left, pair.right) +
        pair.left.copyFrom(pair.right)
    if (disjoint == 4) {
        readThroughBorrow(counter) + values[0].value
    } else 0
}

compile fun stagedMutableBorrows(): int {
    val counter = Counter(10)
    increment(counter, 5)
    val callback = increment
    callback(counter, 5)
    invokeMutable(increment, counter, 5)
    counter.add(5)
    addThroughBorrow(counter, 5)
    val values = [Counter(3)]
    bumpFirst(values, 4)
    val pair = CounterPair(Counter(1), Counter(2))
    val disjoint = copyValue(pair.left, pair.right) +
        pair.left.copyFrom(pair.right)
    if (disjoint == 4) {
        readThroughBorrow(counter) + values[0].value
    } else 0
}

fun main: int {
    if (#stagedMutableBorrows() == 42 &&
        runtimeMutableBorrows() == 42) 42 else 0
}
