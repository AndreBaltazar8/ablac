import "nominal-scalar-provider.ab"

fun pinNumber(pin: Pin): int = pin

@export("nominal_pin_round_trip")
fun pinRoundTrip(pin: Pin): Pin {
    val copy: Pin = pin
    copy
}

@inline
@export("nominal_pin_choose")
fun choosePin(first: bool): Pin =
    if (first) Pin(40) else Pin(42)

fun main: int = pinNumber(Pin(40).offset(2))
