// A class conforming to an interface that extends `Source` is a `Source` too: denied.
import "abla/fs"
interface Source { fun read(): int }
interface Named : Source { fun name(): string }
class Counted(val count: int) : Source {
    fun read(): int = count
}
class Handle(val path: string) : Named {
    fun name(): string = path
    fun read(): int = Path(path).readText().size
}
fun total(source: Source): int = source.read()
compile fun measured(): int = Handle("forty").path.size + total(Counted(37))
val measure = #measured()
fun main: int = measure
