import "abla/memory"

// A manual program that later asks for pressure collection gets it back: the
// call keeps the compiler's safe points, and it turns collection on at run time.
class GrowthLink(var next: GrowthLink?, val payload: array<int>)

fun abandonGrowthCycle(seed: int): int {
    val payload: array<int> = []
    var index = 0
    while (index < 1024) {
        payload.append(seed + index)
        index = index + 1
    }
    val left = GrowthLink(null, payload)
    val right = GrowthLink(left, [seed])
    left.next = right
    left.payload[0] + right.payload[0]
}

fun churn(rounds: int): int {
    var round = 0
    var sum = 0
    while (round < rounds) {
        sum = abandonGrowthCycle(21)
        round = round + 1
    }
    sum
}

fun main: int {
    memorySetManualCollection()
    // Manual: 48 MiB of cycles stay live.
    val first = churn(6144)
    val grown = memoryLiveBytes()
    memorySetCollectionGrowth(4194304)
    // Pressure again: the same garbage collects once it grows 4 MiB.
    val second = churn(6144)
    val after = memoryLiveBytes()
    if (first == 42 && second == 42 && grown > 33554432 &&
        after < 16777216) 42 else 1
}
