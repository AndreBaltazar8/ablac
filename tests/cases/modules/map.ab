// Map<K, V>: string and int keys, insertion order, removal, growth, object
// values, maps in fields and parameters.
import "abla/io"

class Item(val name: string, var count: int)

class Registry(val table: Map<string, int>)

fun total(counts: Map<string, int>): int {
    var sum = 0
    for (key in counts.keys()) {
        val value = counts.get(key)
        if (value != null) sum = sum + value
    }
    sum
}

fun check(failures: int, ok: bool, label: string): int {
    if (!ok) println("FAIL $label")
    if (ok) failures else failures + 1
}

fun main: int {
    var failures = 0
    val counts: Map<string, int> = Map()
    counts.set("a", 1)
    counts.set("b", 2)
    counts.set("a", 3)
    failures = check(failures, counts.size == 2, "size")
    failures = check(failures, counts.get("a") == 3, "overwrite")
    failures = check(failures, counts.has("b") && !counts.has("c"), "has")
    failures = check(failures, counts.get("c") == null, "missing")
    failures = check(failures, counts.remove("b") && !counts.remove("b"),
        "remove")
    failures = check(failures, counts.size == 1 && counts.get("b") == null,
        "removed")
    counts.set("c", 5)
    counts.set("b", 7)
    val keys = counts.keys()
    failures = check(failures, keys.size == 3 && keys[0] == "a" &&
        keys[1] == "c" && keys[2] == "b", "insertion order")
    failures = check(failures, total(counts) == 15, "parameter")

    val names: Map<int, string> = Map()
    var index = 0
    while (index < 2000) {
        names.set(index * 7, "n$index")
        index = index + 1
    }
    index = 0
    while (index < 2000) {
        if (index % 2 == 0) names.remove(index * 7)
        index = index + 1
    }
    failures = check(failures, names.size == 1000, "int size")
    failures = check(failures, names.get(7) == "n1" && names.get(14) == null &&
        names.get(13993) == "n1999", "int lookups")
    names.set(14, "again")
    failures = check(failures, names.get(14) == "again" && names.size == 1001,
        "reinsert")
    val values = names.values()
    failures = check(failures, values.size == 1001 && values[0] == "n1" &&
        values[1000] == "again", "values")

    val items: Map<string, Item> = Map()
    items.set("sword", Item("sword", 1))
    val sword = items.get("sword")
    if (sword != null) sword.count = sword.count + 4
    val again = items.get("sword")
    failures = check(failures, again != null && again.count == 5,
        "object values")

    val registry = Registry(Map())
    registry.table.set("x", 9)
    failures = check(failures, registry.table.get("x") == 9, "field")
    counts.clear()
    failures = check(failures, counts.size == 0 && counts.get("a") == null,
        "clear")
    counts.set("z", 26)
    failures = check(failures, counts.get("z") == 26, "after clear")
    if (failures == 0) 42 else failures
}
