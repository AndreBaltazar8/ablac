import "abla/process"
import "abla/io"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/sys/linux"

var failures = 0
fun check(ok: bool, label: string): void {
    if (!ok) { eprintln("FAIL $label"); failures = failures + 1 }
}
fun changeMask(how: int, mask: int): void {
    val value = nativeByteBuffer(8)
    value.storeI64(0, mask)
    linuxSyscall4(14, how, nativePointerAddress(value.address), 0, 8)
    value.close()
    return
}
fun currentMask(): int {
    val value = nativeByteBuffer(8)
    linuxSyscall4(14, 0, 0, nativePointerAddress(value.address), 8)
    val result = value.loadI64(0)
    value.close()
    result
}
// Blocking pipes make readiness independent of how soon the worker is scheduled.
// The test runner's deadline still bounds a genuine deadlock.
fun handshakePipe(): array<int> {
    val value = nativeByteBuffer(8)
    val result = linuxSyscall2(293, nativePointerAddress(value.address), 524288) // pipe2, O_CLOEXEC
    val descriptors = value.loadI64(0)
    value.close()
    if (result == 0) [descriptors & 4294967295, descriptors >> 32] else [-1, -1]
}
fun handshake(descriptor: int, sending: bool): bool {
    val value = nativeByteBuffer(8)
    value.storeI64(0, 1)
    val operation = if (sending) 1 else 0 // write or read
    var result = linuxSyscall3(operation, descriptor, nativePointerAddress(value.address), 1)
    while (result == -4) { // EINTR
        result = linuxSyscall3(operation, descriptor, nativePointerAddress(value.address), 1)
    }
    val ok = result == 1 && value.loadI64(0) == 1
    value.close()
    ok
}
// Keep close callable through the same borrowed parameter accepted by 0.2.37.
fun stopWatch(watch: SignalWatch): void { watch.close() }
resource class HandshakeDescriptors(val readyOutput: int, val releaseInput: int)
fun otherThread(descriptors: Shared<HandshakeDescriptors>, bit: int): int {
    val readyOutput = descriptors.get().readyOutput
    val releaseInput = descriptors.get().releaseInput
    val before = currentMask()
    val watch = watchSignals([signalTerminate])
    val ready = handshake(readyOutput, true)
    val signalled = handshake(releaseInput, false)
    watch.close()
    if (watch.started && ready && signalled && (before & bit) != 0 && currentMask() == before) 1 else 0
}
fun main: int {
    val interrupt = 1 << (signalInterrupt - 1)
    val terminate = 1 << (signalTerminate - 1)
    val hangup = 1 << (signalHangup - 1)
    val original = currentMask()
    changeMask(0, interrupt)
    changeMask(1, terminate | hangup)
    val baseline = currentMask()
    val first = watchSignals([signalInterrupt, signalTerminate])
    val second = watchSignals([signalInterrupt, signalHangup])
    val third = watchSignals([signalTerminate])
    check(first.started && second.started && third.started, "three watches started")
    check((currentMask() & (interrupt | terminate | hangup)) == (interrupt | terminate | hangup), "all watched signals blocked")
    stopWatch(first)
    check((currentMask() & (interrupt | terminate | hangup)) == (interrupt | terminate | hangup), "out-of-order close retains overlaps")
    first.close()
    check((currentMask() & (interrupt | terminate | hangup)) == (interrupt | terminate | hangup), "close is idempotent")
    third.close()
    check((currentMask() & terminate) == 0, "last terminate watch restores its bit")
    check((currentMask() & (interrupt | hangup)) == (interrupt | hangup), "other watch remains blocked")
    val child = command("sh").argument("-c").argument("kill -HUP \$\$; exit 7").run()
    check(child == 129, "child unblocks remaining watched signals")
    second.close()
    check(currentMask() == baseline, "final close preserves preblocked SIGINT")
    val old = watchSignals([signalTerminate])
    val oldDescriptor = old.descriptor
    val oldAlias = old
    stopWatch(old)
    val replacement = watchSignals([signalTerminate])
    check(replacement.started && replacement.descriptor == oldDescriptor, "descriptor reused")
    stopWatch(oldAlias)
    check(old.received() == 0 && oldAlias.received() == 0, "closed aliases stay closed")
    check((currentMask() & terminate) != 0, "repeated close leaves replacement blocked")
    stopWatch(replacement)
    check(currentMask() == baseline, "replacement close restores mask")
    val parentWatch = watchSignals([signalTerminate])
    val readyPipe = handshakePipe()
    val releasePipe = handshakePipe()
    if (readyPipe[0] < 0 || releasePipe[0] < 0) {
        check(false, "handshake pipes opened")
        for (descriptor in readyPipe) { if (descriptor >= 0) linuxSyscall1(3, descriptor) }
        for (descriptor in releasePipe) { if (descriptor >= 0) linuxSyscall1(3, descriptor) }
        parentWatch.close()
        changeMask(2, original)
        return 1
    }
    val descriptors = Shared(HandshakeDescriptors(readyPipe[1], releasePipe[0]))
    val worker = thread { otherThread(descriptors, 1 << 14) }
    val ready = handshake(readyPipe[0], false)
    parentWatch.close()
    check(ready && currentMask() == baseline, "other thread's watch does not hold this thread's mask")
    check(handshake(releasePipe[1], true), "worker release sent")
    val workerOk = await worker
    check(workerOk == 1, "worker restores its inherited signal mask")
    for (descriptor in readyPipe) { linuxSyscall1(3, descriptor) }
    for (descriptor in releasePipe) { linuxSyscall1(3, descriptor) }
    changeMask(2, original)
    if (failures == 0) 42 else 1
}
