// Compile-time parity of abla/crypto/aes (tools/test-compile-time-parity.sh): GCM, CBC and ECB over fixed keys print
// the same bytes at run time and under `#`. Correctness is tools/test-crypto-pure.sh's; this compares the two.
import "abla/io"
import "abla/crypto"
import "abla/crypto/pure" // its export import of abla/crypto/aes; the facade is reached too

fun show(result: CryptoResult): string = if (result.ok) hexEncode(result.bytes) else "error ${result.error}"

fun main: int {
    val key = hexDecode("000102030405060708090a0b0c0d0e0f")
    val key256 = hexDecode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    val nonce = hexDecode("cafebabefacedbaddecaf888")
    val message = "parity: the same bytes at run time and under #"
    val sealed = aesGcmEncrypt(key, nonce, message, "header")
    println("gcm ${show(sealed)}")
    println("gcm open ${show(aesGcmDecrypt(key, nonce, sealed.bytes, "header"))}")
    println("gcm wrong header ${aesGcmDecrypt(key, nonce, sealed.bytes, "other").ok}")
    println("gcm-256 ${show(aesGcmEncrypt(key256, nonce, message))}")
    val iv = hexDecode("0f0e0d0c0b0a09080706050403020100")
    val cbc = aesCbcEncryptPkcs7(key, iv, message)
    println("cbc ${show(cbc)} back ${show(aesCbcDecryptPkcs7(key, iv, cbc.bytes))}")
    println("ecb ${show(aesEcbEncryptPkcs5(key, "sixteen byte msg"))}")
    println("short key ${aesKeySizeError("short")}")
    42
}
