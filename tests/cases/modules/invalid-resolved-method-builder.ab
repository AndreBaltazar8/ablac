import "abla/compiler"
import "abla/compiler/parser"

class BuilderOwner(val base: int) {
    fun apply(value: int): int = this.base + value
}

compile fun parseInvalidBuilder(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "{")
    parserExpect(cursor, "}")
    val method = compilerFindFunction("BuilderOwner.apply")
    val arguments: array<SyntaxExpression> = [syntaxInteger(40)]
    // An inherent method cannot be turned into a receiver-less call. The
    // compiler-owned builder must reject this before publishing syntax.
    syntaxCallTarget(method, arguments)
}

#compilerRegisterSubparser("invalidBuilder", parseInvalidBuilder)

fun main: int = $invalidBuilder{}
