class Counter(var value: int)

fun makeCounter(): Counter {
    val result = Counter(20)
    result.value = result.value + 1
    result
}

fun makeValues(): array<int> {
    val result: array<int> = [19]
    result.append(23)
    result
}

compile fun stagedFreshResult(): int = makeCounter().value + makeValues()[0]

fun main: int {
    if (#stagedFreshResult() == 40 &&
        makeCounter().value + makeValues()[0] == 40) 42 else 1
}
