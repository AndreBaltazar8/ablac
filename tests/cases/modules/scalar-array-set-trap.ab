import "abla/process/arguments"

fun main: int {
    val choice = if (processArgumentCount() > 0) processArgument(0) else "i64"
    val index = if (processArgumentCount() > 1) -1 else 2
    if (choice == "i64") {
        val values = [0, 0]
        values[index] = 42
    } else if (choice == "bool") {
        val values = [false, false]
        values[index] = true
    } else if (choice == "f64") {
        val values: array<f64> = [0.0, 0.0]
        values[index] = 2.5
    } else {
        val values: array<f32> = [0.0, 0.0]
        values[index] = 2.5
    }
    1
}
