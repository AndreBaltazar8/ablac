class Node(var weight: int)
class Wrap(val node: Node)

fun wrap(node: Node): Wrap = Wrap(node)

// `first` is a view of `node`: changing `node` while `first` is used later
// is a borrow conflict, as it is for `Wrap(node)` built inline.
fun main: int {
    val node = Node(40)
    val first = wrap(node)
    node.weight = 50
    first.node.weight
}
