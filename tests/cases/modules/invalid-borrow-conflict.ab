// A place changed while a local that borrows it is still used is reported
// with both names, not as an anonymous IR invariant.
class Box(var items: array<string>)

fun Box.grow(): int {
    val shared = this.items
    this.items.append("x")
    shared.size
}

fun main: int {
    val nums = [[1], [2]]
    val first = nums[0]
    nums[0].append(3)
    first.size + Box(["a"]).grow()
}
