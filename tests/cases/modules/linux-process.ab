import "abla/sys/linux/process"

// The clock reads: monotonic is positive and never goes back, wall time is a date from 2023 to 2100, both move by about a 30 ms
// sleep, and the millisecond read agrees with the nanosecond one. (A read that fails is 0; one that mixes up the clock or the two
// words of the kernel's timespec is far outside these.)
fun clockReadsOk(): bool {
    var previous = linuxMonotonicNanoseconds()
    if (previous <= 0) return false
    for (i in 0 until 200) {
        val now = linuxMonotonicNanoseconds()
        if (now < previous) return false
        previous = now
    }
    val wall = linuxRealtimeNanoseconds()
    if (wall < 1700000000000000000 || wall > 4102444800000000000) return false
    val millis = linuxMonotonicMilliseconds()
    val nanos = linuxMonotonicNanoseconds()
    if (nanos / 1000000 < millis || nanos / 1000000 - millis > 1000) return false
    val before = linuxMonotonicNanoseconds()
    val wallBefore = linuxRealtimeNanoseconds()
    linuxSleep(30)
    val slept = linuxMonotonicNanoseconds() - before
    val wallSlept = linuxRealtimeNanoseconds() - wallBefore
    slept >= 25000000 && slept < 10000000000 && wallSlept >= 20000000 && wallSlept < 10000000000
}

fun main: int {
    if (!clockReadsOk()) return 3
    val path = linuxEnvironment("PATH")
    val runStatus = linuxCommand("sh").argument("-c").argument(
        "exit 7"
    ).run()
    val captured = linuxCommand("printf").argument("Abla").capture()
    val child = linuxCommand("sh").argument("-c").argument(
        "sleep 5"
    ).start()
    val stopped = child.stop(20)
    if (path.found && runStatus == 7 && captured.status == 0 &&
        captured.output == "Abla" && child.process > 0 && stopped >= 128) {
        42
    } else 0
}
