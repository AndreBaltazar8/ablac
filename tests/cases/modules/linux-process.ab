#import("abla/sys/linux/process")

fun main: int {
    val path = linuxEnvironment("PATH")
    val runStatus = linuxCommand("sh").argument("-c").argument(
        "exit 7"
    ).run()
    val captured = linuxCommand("printf").argument("Abla").capture()
    val child = linuxCommand("sh").argument("-c").argument(
        "sleep 5"
    ).start()
    val stopped = child.stop(20)
    if (path.found && runStatus == 7 && captured.status == 0 &&
        captured.output == "Abla" && child.process > 0 && stopped >= 128) {
        42
    } else 0
}
