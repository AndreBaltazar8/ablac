import "abla/io"

fun numbers(): Generator<int> = generator { yield 1 }

fun drain(values: Generator<int>, choose: bool): int {
    var total = 0
    for (value in if (choose) values else numbers()) total = total + value
    total
}

fun drainWhen(values: Generator<int>, choose: bool): int {
    var total = 0
    for (value in when (choose) {
        true -> { values }
        false -> { numbers() }
    }) total = total + value
    total
}

fun once(mode: int): int {
    val original = numbers()
    when (mode) {
        0 -> drain(original, true)
        1 -> drain(original, false)
        2 -> drainWhen(original, true)
        else -> drainWhen(original, false)
    }
}

fun main: int {
    var total = 0
    for (i in 0 until 1000) total = total + once(i % 4)
    println("$total")
    0
}
