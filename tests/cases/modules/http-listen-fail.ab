import "abla/http"
import "abla/http/event"
import "abla/io"
import "abla/sys/linux/net"
import "abla/sys/linux/process"
import "abla/websocket"
import "abla/websocket/event"

// A server that could not bind (its port is taken) says so: listenError() is the errno and run() returns 1 at once, where it
// used to wait for ever on a poller with nothing in it (tests/cases/http-keepalive hung 1 server in 100 under load on a port
// another connection held). A server that listens answers 0 and stays up until stopped.

fun listenFailureHandler(request: HttpRequest): HttpResponse = httpText("ok")

fun main: int {
    val first = httpEventServerHandler(listenFailureHandler, ipv4Loopback(0))
    if (first.listenError() != 0) {
        println("FAIL: the server on a free port reports ${first.listenError()}")
        return 1
    }
    val port = first.listener.localPort()
    val taken = httpEventServerHandler(listenFailureHandler, ipv4Loopback(port))
    if (taken.listenError() != 98) {
        println("FAIL: a taken port reports ${taken.listenError()}, not 98 (address in use)")
        return 2
    }
    val started = linuxMonotonicMilliseconds()
    val status = taken.run()
    val elapsed = linuxMonotonicMilliseconds() - started
    if (status != 1 || elapsed > 500) {
        println("FAIL: run() on a taken port returned $status after $elapsed ms")
        return 3
    }
    val socket = webSocketEventServer(webSocketEventRouter(), ipv4Loopback(port))
    if (socket.listenError() != 98 || socket.run() != 1) {
        println("FAIL: the WebSocket event server on a taken port: ${socket.listenError()}")
        return 4
    }
    first.stop()
    println("http listen failure ok")
    0
}
