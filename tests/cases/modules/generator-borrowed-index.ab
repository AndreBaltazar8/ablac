import "abla/io"

fun numbers(): Generator<int> = generator { yield 1 }

fun once(): int {
    val all: array<Generator<int>> = [numbers()]
    var total = 0
    for (value in all[0]) total = total + value
    total
}

fun main: int {
    var total = 0
    for (i in 0 until 1000) total = total + once()
    val strings: array<string> = []
    for (i in 0 until 2000) strings.append("item $i")
    println("$total ${strings.size}")
    0
}
