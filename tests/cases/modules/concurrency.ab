var cleanupTrace = 0

fun recordCleanup(): void {
    cleanupTrace = cleanupTrace + 1
    return
}

fun numbers(): Generator<int> = generator {
    defer { recordCleanup() }
    var value = 1
    while (value <= 3) {
        yield value
        value = value + 1
    }
}

fun generatorTotal(): int {
    var total = 0
    for (value in numbers()) {
        total = total + value
    }
    total
}

fun cancelledGenerator(): int {
    for (value in numbers()) {
        if (value == 1) break
    }
    cleanupTrace
}

fun taskResult(): int {
    val inner = task { 20 }
    val outer = task { await inner + 1 }
    await outer
}

resource class Counter(var value: int)

fun increment(var counter: Counter): int {
    counter.value = counter.value + 1
    counter.value
}

fun observe(var counter: Counter): int = counter.value

fun threadResult(): int {
    val counter = Mutex(Counter(40))
    val firstWorker = counter.clone()
    val secondWorker = counter.clone()
    val first = thread { firstWorker.with(increment) }
    val second = thread { secondWorker.with(increment) }
    val firstResult = await first
    val secondResult = await second
    val observed = counter.with(observe)
    if (firstResult + secondResult == 83 && observed == 42) 21 else 0
}

fun main: int {
    val generated = generatorTotal()
    val afterNatural = cleanupTrace
    val afterCancel = cancelledGenerator()
    val tasked = taskResult()
    val threaded = threadResult()
    if (generated == 6 && afterNatural == 1 && afterCancel == 2 &&
        tasked == 21 && threaded == 21) 42 else 0
}
