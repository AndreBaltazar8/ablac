// The overload probe types only the bodies that may resolve an operator or an
// overload (overload.ab, bootstrapOverloadProbedBodies). Each function below
// comes by a value of the owner type `V` without naming `V`, one way the filter
// must follow. Built with ABLA_OVERLOAD_CHECK=1, the filtered probe must find
// what the probe of every body spelled like a candidate finds.
class V(val x: int)

operator fun V.plus(other: V): V = V(this.x + other.x)
operator fun V.plus(k: int): V = V(this.x + k)
operator fun V.times(k: int): V = V(this.x * k)
fun V.grow(k: int): V = V(this.x + k)
fun V.grow(other: V): V = V(this.x + other.x)
// On a built-in receiver: `3 * v`.
operator fun int.times(v: V): V = V(this * v.x)

fun makeV(x: int): V = V(x)

class Holder(val v: V, val vs: array<V>)
fun holder(): Holder = Holder(V(1), [V(2), V(3)])

class Factory(val base: int) {
    fun build(): V = V(this.base)
}

class Mapper(val f: (V) -> V)

interface VSource {
    fun make: V
}

// An extension on an interface whose method gives a `V`.
fun VSource.doubled(): V = this.make() * 2

// A global typed only by its initializer.
val SEEDS = [makeV(1), makeV(2)]

// A local typed by a call.
fun fromCall(): int {
    val v = makeV(4)
    (v + 1).x
}

// A local read from a field.
fun fromField(h: Holder): int {
    val v = h.v
    (v * 2).x
}

// An element of an array field: the owner only as a generic argument.
fun fromGenericField(h: Holder): int = (h.vs[1] + h.vs[0]).x

// A loop variable (there is no destructuring).
fun fromLoop(): int {
    var total = 0
    for (v in holder().vs) total = total + (v + 1).x
    total
}

// A global with an inferred type.
fun fromGlobal(): int = (SEEDS[1] * 3).x

// A method's result.
fun fromMethod(f: Factory): int = (f.build() + 2).x

// A lambda parameter typed by the callee's parameter type.
fun applyV(f: (V) -> V): V = f(makeV(5))
fun fromLambdaContext(): int = applyV({ v -> v + 1 }).x

// A lambda parameter typed by a constructor's parameter type.
fun fromConstructorContext(): Mapper = Mapper({ v -> v * 3 })

// A method overload on calls' results.
fun fromOverloadedMethod(): int = makeV(1).grow(2).grow(makeV(3)).x

// An extension reached through an interface.
fun fromInterface(s: VSource): int = (s.doubled() + 1).x

// An operator on a built-in receiver, its operand from a call.
fun fromScalarReceiver(): int = (3 * makeV(2)).x

// An operand typed `never` fits any parameter: a call that does not return,
// and a jump.
fun stop(): never {
    while (true) {}
}
fun neverCall(go: bool): V = if (go) V(1) else 3 * stop()
fun neverJump(go: bool): V {
    val jumped = 3 * (if (go) return V(7) else return V(8))
    jumped
}

// No owner value: scalar arithmetic and a method spelled like a candidate.
class Counter(val n: int) {
    fun grow(k: int): Counter = Counter(this.n + k)
}
fun untouched(): int = Counter(1 + 2 * 3).grow(4).n

fun main: int {
    if (fromCall() != 5) return 1
    if (fromField(holder()) != 2) return 2
    if (fromGenericField(holder()) != 5) return 3
    if (fromLoop() != 7) return 4
    if (fromGlobal() != 6) return 5
    if (fromMethod(Factory(4)) != 6) return 6
    if (fromLambdaContext() != 6) return 7
    val mapper = fromConstructorContext()
    val mapped = mapper.f
    if (mapped(makeV(2)).x != 6) return 8
    if (fromOverloadedMethod() != 6) return 9
    if (untouched() != 11) return 10
    if (fromScalarReceiver() != 6) return 11
    if (neverCall(true).x != 1) return 12
    if (neverJump(true).x != 7) return 13
    42
}
