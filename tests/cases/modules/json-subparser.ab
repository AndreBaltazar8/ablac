import "abla/json"

fun streamingJsonWorks(): bool {
    val reader = jsonObjectReader(
        "{\"ignored\":{\"nested\":[1,true]},\"name\":\"a\\u0062la\",\"items\":[[\"x\",\"y\"]]}"
    )
    var name = ""
    var items = ""
    while (!reader.done && reader.state.errorCode == "") {
        val key = reader.next()
        if (!reader.done && key == "name") name = reader.readString()
        else if (!reader.done && key == "items") items = reader.readRaw()
        else if (!reader.done) reader.skip()
    }
    val array = jsonArrayEncoder()
    array.add(jsonEncodeString("x"))
    array.add(jsonEncodeBoolean(true))
    val object = jsonObjectEncoder()
    object.put("name", jsonEncodeString(name))
    object.put("values", array.finish())
    val stream = jsonEncoder()
    stream.beginObject()
    stream.key("name")
    stream.string(name)
    stream.key("values")
    stream.beginArray()
    stream.string("x")
    stream.boolean(true)
    stream.endArray()
    stream.endObject()
    val staticKeys = jsonEncoder()
    staticKeys.beginObject()
    staticKeys.encodedObjectKey(#jsonEncodeObjectKey("o\"k"))
    staticKeys.boolean(true)
    staticKeys.endObject()
    val duplicate = jsonObjectReader("{\"x\":1,\"x\":2}")
    while (!duplicate.done && duplicate.state.errorCode == "") {
        duplicate.next()
        if (!duplicate.done) duplicate.skip()
    }
    reader.finish() && name == "abla" && items == "[[\"x\",\"y\"]]" &&
        object.finish().text == "{\"name\":\"abla\",\"values\":[\"x\",true]}" &&
        stream.finish() == "{\"name\":\"abla\",\"values\":[\"x\",true]}" &&
        staticKeys.finish() == "{\"o\\\"k\":true}" &&
        !duplicate.finish()
}

fun nestedStreamingJsonWorks(): bool {
    val reader = jsonObjectReader(
        "{\"ignored\":null,\"items\":[{\"price\":5,\"qty\":2},{\"qty\":3,\"price\":7}],\"active\":true,\"user\":{\"roles\":[\"admin\",\"writer\"],\"name\":\"Andre\",\"id\":42}}"
    )
    var total = 0
    var itemCount = 0
    var active = false
    var name = ""
    var primaryRole = ""
    while (!reader.done && reader.state.errorCode == "") {
        val key = reader.next()
        if (!reader.done && key == "items") {
            val items = reader.readArray()
            while (items.next()) {
                val item = items.readObject()
                var quantity = 0
                var price = 0
                while (!item.done && item.state.errorCode == "") {
                    val itemKey = item.next()
                    if (!item.done && itemKey == "qty") {
                        quantity = item.readInteger()
                    } else if (!item.done && itemKey == "price") {
                        price = item.readInteger()
                    } else if (!item.done) item.skip()
                }
                if (!item.finishNested()) return false
                total = total + quantity * price
                itemCount = itemCount + 1
            }
            if (!items.finishNested()) return false
        } else if (!reader.done && key == "active") {
            active = reader.readBoolean()
        } else if (!reader.done && key == "user") {
            val user = reader.readObject()
            while (!user.done && user.state.errorCode == "") {
                val userKey = user.next()
                if (!user.done && userKey == "name") {
                    name = user.readString()
                } else if (!user.done && userKey == "roles") {
                    val roles = user.readArray()
                    if (roles.next()) primaryRole = roles.readString()
                    while (roles.next()) roles.skip()
                    if (!roles.finishNested()) return false
                } else if (!user.done) user.skip()
            }
            if (!user.finishNested()) return false
        } else if (!reader.done) reader.skip()
    }
    val trailing = jsonArrayReader("[1,]")
    if (trailing.next()) trailing.readInteger()
    trailing.next()
    val whitespace = jsonObjectReader("{ \"value\" : 9 }")
    whitespace.nextExpectedRaw("value")
    val spacedValue = whitespace.readInteger()
    val compact = jsonObjectReader("{\"first\":1,\"second\":2}")
    compact.nextExpectedRaw("first")
    val first = compact.readInteger()
    compact.nextExpectedRaw("second")
    val second = compact.readInteger()
    val integerEdges = jsonArrayReader(
        "[-9223372036854775808,9223372036854775807]"
    )
    integerEdges.next()
    val minimum = integerEdges.readInteger()
    integerEdges.next()
    val maximum = integerEdges.readInteger()
    val malformedInteger = jsonArrayReader("[1+]")
    malformedInteger.next()
    malformedInteger.readInteger()
    val spacedArray = jsonArrayReader("[ 1, 2 ]")
    spacedArray.next()
    val spacedFirst = spacedArray.readInteger()
    spacedArray.next()
    val spacedSecond = spacedArray.readInteger()
    val emptyArray = jsonArrayReader("[]")
    emptyArray.next()
    val spacedStrings = jsonObjectReader("{ \"name\" : \n\t\"Andre\", \"roles\" : [ \"admin\", \"writer\" ] }")
    spacedStrings.nextExpectedRaw("name")
    val spacedName = spacedStrings.readString()
    spacedStrings.nextExpectedRaw("roles")
    val spacedRoles = spacedStrings.readArray()
    spacedRoles.next()
    val spacedRole = spacedRoles.readString()
    spacedRoles.next()
    val secondRole = spacedRoles.readString()
    val spacedRolesDone = spacedRoles.finishNested()
    reader.finish() && total == 31 && itemCount == 2 && active &&
        name == "Andre" && primaryRole == "admin" && !trailing.finish() &&
        whitespace.finish() && spacedValue == 9 && compact.finish() &&
        first == 1 && second == 2 && integerEdges.finish() &&
        minimum == -9223372036854775808 && maximum == 9223372036854775807 &&
        malformedInteger.state.errorCode == "invalid_number" &&
        spacedArray.finish() && spacedFirst == 1 && spacedSecond == 2 &&
        emptyArray.finish() && spacedStrings.finish() &&
        spacedName == "Andre" && spacedRole == "admin" &&
        secondRole == "writer" && spacedRolesDone
}

fun scalarBufferText(): string = jsonParse(
    "\"\\u0000\\u007f\\u0080\\u07ff\\u0800\\ud7ff\\ue000\\uffff\\ud800\\udc00\\udbff\\udfff\""
).value.asString()

fun escapedBoundaryText(): string {
    val output = byteBuffer()
    for (round in 0 until 40) {
        for (control in 0 until 32) output.appendText(byteEncode(control))
        output.appendText("plain\"\\é🌍")
    }
    output.toText()
}

fun escapedDiagnosticFingerprint(): string {
    val output = byteBuffer()
    for (source in [
        "\"\\ntext\"", "\"\\u0000\"", "\"\\uD800\\uDC00\"",
        "\"\\uDBFF\\uDFFF\"", "\"\\uD800\"", "\"\\uDC00\"",
        "\"\\uD800\\u0041\"", "\"\\u12g4\"", "\"\\u12\"",
        "\"\\x\"", "\"\\", "\"\\nunterminated", "\"\\n\n\"",
        "\"\\n${byteEncode(255)}\"", "\"\\n${byteEncode(192)}${byteEncode(128)}\"",
        "\"\\nabcdefg\"", "\"\\nabcdefgh\"", "\"a\\\"b\\\\c\\/d\""
    ]) {
        for (maximum in [1, 8, 4096]) {
            val result = jsonParse(source, JsonLimits(4096, 64, 10000, maximum, 100, true))
            output.appendText("${result.succeeded}:${jsonQuote(result.value.asString())}:")
            output.appendText("${result.error.code}:${result.error.message}:")
            output.appendText("${result.error.byteOffset}:${result.error.line}:${result.error.column};")
        }
    }
    output.toText()
}

fun escapedSpansWork(): bool {
    val scalarText = scalarBufferText()
    val frozenScalarText = #scalarBufferText()
    var expectedScalars = ""
    for (scalar in [0, 127, 128, 2047, 2048, 55295, 57344, 65535, 65536, 1114111]) {
        expectedScalars = "$expectedScalars${utf8Encode(scalar)}"
    }
    val text = "prefix\" ordinary ASCII é 日本語 \n suffix\\end"
    val encoded = jsonQuote(text)
    val parsed = jsonParse(encoded)
    val limit = JsonLimits(4096, 64, 10000, 8, 100, true)
    val tooLong = jsonParse("\"\\naaaaaaaa\"", limit)
    val exact = jsonParse("\"\\naaaaaaa\"", limit)
    val invalid = jsonParse("\"\\ntext\\uD800rest\"")
    val invalidUtf8 = "quote\"${byteEncode(255)}"
    val boundaryText = escapedBoundaryText()
    val boundaryQuoted = jsonQuote(boundaryText)
    val boundaryReference = #jsonQuote(escapedBoundaryText())
    val boundaryParsed = jsonParse(boundaryQuoted)
    scalarText == expectedScalars && scalarText == frozenScalarText &&
        escapedDiagnosticFingerprint() == #escapedDiagnosticFingerprint() &&
        boundaryQuoted == boundaryReference && boundaryParsed.succeeded &&
        boundaryParsed.value.asString() == boundaryText &&
        encoded == "\"prefix\\\" ordinary ASCII é 日本語 \\n suffix\\\\end\"" &&
        parsed.succeeded && parsed.value.asString() == text &&
        !tooLong.succeeded && tooLong.error.code == "string_limit" &&
        tooLong.error.byteOffset == 0 && exact.succeeded &&
        exact.value.asString() == "\naaaaaaa" &&
        !invalid.succeeded && invalid.error.code == "invalid_unicode" &&
        jsonQuote(invalidUtf8) == "null"
}

fun rawWhitespaceAndPlainStringsWork(): bool {
    val valid = [
        "{\"a\":1,\"b\":2}",
        "{ \n\t\r\"a\": 1 \r\n, \t\"b\":2 }",
        "{\"a\" :1 ,\"b\" : 2}"
    ]
    for (source in valid) {
        val reader = jsonObjectReader(source)
        if (!reader.nextExpectedRaw("a") || reader.readInteger() != 1) return false
        if (!reader.nextExpectedRaw("b") || reader.readInteger() != 2) return false
        if (!reader.finish()) return false
    }
    val invalid = [
        "{\"a\":1 \"b\":2}", "{\"a\":1,,\"b\":2}",
        "{\"a\":1,}", "{\"a\":1,\"b\" 2}",
        "{\"a\":1,\"bextra\":2}", "{\"a\":1,\"\\u0062\":2}",
        "{\"a\":1,\"b\":2,}"
    ]
    for (source in invalid) {
        val reader = jsonObjectReader(source)
        reader.nextExpectedRaw("a")
        reader.readInteger()
        reader.nextExpectedRaw("b")
        reader.readInteger()
        if (reader.finish() || reader.state.errorCode.size == 0) return false
    }
    for (length in [0, 1, 62, 63, 64, 126, 127, 128, 254, 255, 256, 257, 4095]) {
        var text = ""
        var index = 0
        while (index < length) {
            text = "${text}a"
            index = index + 1
        }
        val encoded = jsonQuote(text)
        if (encoded != "\"$text\"") return false
        val parsed = jsonParse(encoded)
        if (!parsed.succeeded || parsed.value.asString() != text) return false
    }
    true
}

fun main: int {
    val rawReference = #rawWhitespaceAndPlainStringsWork()
    val frozen = #$json {"number": 20, "name": "abla"}
    val runtime = $json {"number": 20, "nested": [true, {"name": "abla"}]}
    val encoded = #$jsons {
        "number": 20,
        "nested": [true, {"name": "abla"}]
    }
    if (encoded != "{\"number\":20,\"nested\":[true,{\"name\":\"abla\"}]}") 1
    else if (jsonQuote("a\"b\n") != "\"a\\\"b\\n\"") 2
    else if (!streamingJsonWorks()) 3
    else if (!nestedStreamingJsonWorks()) 4
    else if (!escapedSpansWork()) 5
    else if (!rawReference || !rawWhitespaceAndPlainStringsWork()) 6
    else if (frozen.getString("name") == runtime.at(1).at(1).getString("name")) {
        frozen.getInt("number") + runtime.getInt("number") + 2
    } else 0
}
