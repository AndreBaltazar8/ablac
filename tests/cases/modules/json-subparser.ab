import "abla/json"

fun streamingJsonWorks(): bool {
    val reader = jsonObjectReader(
        "{\"ignored\":{\"nested\":[1,true]},\"name\":\"a\\u0062la\",\"items\":[[\"x\",\"y\"]]}"
    )
    var name = ""
    var items = ""
    while (!reader.done && reader.state.errorCode == "") {
        val key = reader.next()
        if (!reader.done && key == "name") name = reader.readString()
        else if (!reader.done && key == "items") items = reader.readRaw()
        else if (!reader.done) reader.skip()
    }
    val array = jsonArrayEncoder()
    array.add(jsonEncodeString("x"))
    array.add(jsonEncodeBoolean(true))
    val object = jsonObjectEncoder()
    object.put("name", jsonEncodeString(name))
    object.put("values", array.finish())
    val stream = jsonEncoder()
    stream.beginObject()
    stream.key("name")
    stream.string(name)
    stream.key("values")
    stream.beginArray()
    stream.string("x")
    stream.boolean(true)
    stream.endArray()
    stream.endObject()
    val duplicate = jsonObjectReader("{\"x\":1,\"x\":2}")
    while (!duplicate.done && duplicate.state.errorCode == "") {
        duplicate.next()
        if (!duplicate.done) duplicate.skip()
    }
    reader.finish() && name == "abla" && items == "[[\"x\",\"y\"]]" &&
        object.finish().text == "{\"name\":\"abla\",\"values\":[\"x\",true]}" &&
        stream.finish() == "{\"name\":\"abla\",\"values\":[\"x\",true]}" &&
        !duplicate.finish()
}

fun main: int {
    val frozen = #$json {"number": 20, "name": "abla"}
    val runtime = $json {"number": 20, "nested": [true, {"name": "abla"}]}
    val encoded = #$jsons {
        "number": 20,
        "nested": [true, {"name": "abla"}]
    }
    if (encoded != "{\"number\":20,\"nested\":[true,{\"name\":\"abla\"}]}") 1
    else if (jsonQuote("a\"b\n") != "\"a\\\"b\\n\"") 2
    else if (!streamingJsonWorks()) 3
    else if (frozen.getString("name") == runtime.at(1).at(1).getString("name")) {
        frozen.getInt("number") + runtime.getInt("number") + 2
    } else 0
}
