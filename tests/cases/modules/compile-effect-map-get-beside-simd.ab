// A `Map`'s `get` under `#` isn't a vector's: abla/simd's `i8x16.get` (a native intrinsic)
// is reached only by code that makes an `i8x16`, whether the receiver's type is written or not.
import "abla/simd"
fun <T> same(value: T): T = value
fun typed(): int {
    val m: Map<string, int> = Map()
    m.set("a", 20)
    m.get("a") ?? 0
}
fun untyped(): int {
    val m: Map<string, int> = Map()
    m.set("b", 22)
    same(m).get("b") ?? 0
}
val total = #(typed() + untyped())
fun main: int = total
