import "abla/compiler"
import "abla/compiler/parser"

compile fun finalizeNestedGeneratedSubparser(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val module = compilerGeneratedModule(generatedName, expression)
    val target = typedCallTarget(expression)
    val parameterNames: array<string> = ["value"]
    val parameterTypes: array<int> = [compilerFindType("i64")]
    val arguments: array<SyntaxExpression> = [syntaxIdentifier("value")]
    compilerGeneratedExportFunction(
        module,
        generatedName,
        parameterNames,
        parameterTypes,
        compilerFindType("i64"),
        syntaxCallTarget(target, arguments)
    )
    module
}

compile fun parseNestedGeneratedInner(
    cursor: ParserCursor
): SyntaxExpression {
    parserExpect(cursor, "(")
    val call = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    val generatedName = "nestedGeneratedSubparserAdapter"
    compilerRecordGeneratedExtensionRequest(
        generatedName,
        generatedName,
        call,
        finalizeNestedGeneratedSubparser
    )
    syntaxCall(generatedName, [syntaxChild(call, 0)])
}

compile fun parseNestedGeneratedOuter(
    cursor: ParserCursor
): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "<value action={")
    val expression = parserParseAblaExpression(cursor)
    parserRawExpect(cursor, "}></value>")
    expression
}

#compilerRegisterSubparser(
    "nestedGeneratedInner",
    parseNestedGeneratedInner
)

#compilerRegisterSubparser(
    "nestedGeneratedOuter",
    parseNestedGeneratedOuter
)
