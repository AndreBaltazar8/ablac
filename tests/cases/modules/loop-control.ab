compile fun compileLoop(): int {
    var current = 0
    var total = 0
    while (current < 10) {
        current = current + 1
        if (current == 2) continue
        if (current == 6) break
        total = total + current
    }
    total
}

fun nestedLoops(): int {
    var outer = 0
    var hits = 0
    while (outer < 3) {
        outer = outer + 1
        var inner = 0
        while (inner < 5) {
            inner = inner + 1
            if (inner == 2) continue
            if (inner == 4) break
            hits = hits + 1
        }
    }
    hits
}

fun doLoop(): int {
    var current = 0
    var total = 0
    do {
        current = current + 1
        if (current < 3) continue
        total = total + current
        if (current == 4) break
    } while (current < 10)
    total
}

fun main: int = if (
    #compileLoop() == 13 &&
    nestedLoops() == 6 &&
    doLoop() == 7
) 42 else 0
