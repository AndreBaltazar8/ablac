import "abla/io"
// Resource locals are dropped at the end of their scope whatever the length of
// their type's name.
resource class A(val label: string) {
    fun drop(): void {
        println("drop A $label")
        return
    }
}
resource class Doc(val label: string) {
    fun drop(): void {
        println("drop Doc $label")
        return
    }
}
resource class File(val label: string) {
    fun drop(): void {
        println("drop File $label")
        return
    }
}
resource class Files(val label: string) {
    fun drop(): void {
        println("drop Files $label")
        return
    }
}
fun work(): void {
    val a = A("1")
    val doc = Doc("2")
    if (a.label.size > 0) {
        val file = File("3")
        println("inner ${file.label}")
    }
    val files = Files("4")
    println("work ${doc.label} ${files.label}")
}
fun main: int {
    work()
    println("done")
    0
}
