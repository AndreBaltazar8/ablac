import "abla/io"
import "abla/compiler"
import contract "contract-backend.ab" as backend

class Pair<First, Second>(val first: First, val second: Second)

// A transform sees what a contract brought, and a generic class's parameters.
compile fun contractNames(): string {
    var names = ""
    for (function in compilerContractFunctionsAnnotated("rpc")) names = "$names${compiler.parameterCount(function)}"
    val pair = compilerFindClass("Pair")
    "$names ${compiler.functionsAnnotated("rpc").size} ${compilerClassTypeParameterCount(pair)} ${compilerClassTypeParameterName(pair, 1)}"
}

fun main: int {
    println(#contractNames())
    0
}
