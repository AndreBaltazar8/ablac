import "abla/io"
import "abla/compiler"
import contract "contract-backend.ab" as backend

class Pair<First, Second>(val first: First, val second: Second)

// A transform, which runs while generics are still templates, sees what a contract
// brought and a generic class's parameters.
compile fun contractNames(): void {
    var names = ""
    for (function in compilerContractFunctionsAnnotated("rpc")) names = "$names${compiler.parameterCount(function)}"
    val pair = compilerFindClass("Pair")
    val seen = "$names ${compiler.functionsAnnotated("rpc").size} ${compilerClassTypeParameterCount(pair)} ${compilerClassTypeParameterName(pair, 1)}"
    compiler.generateModule("contract_names", "fun contractNamesSeen(): string = \"$seen\"\n")
    return
}

#compiler.transform(contractNames)

fun main: int {
    println(contractNamesSeen())
    0
}
