// A `#` site changes functions of its module and of another: the edits are
// committed and the program lowered again, natively and under `#`.
import "abla/compiler"
import "./graph-edits-library.ab"

fun answer(): int = 1

compile fun specialize(): int {
    compiler.replaceFunctionBody(compiler.findFunction("answer"), "40")
    compiler.replaceFunctionBody(compiler.findFunction("librarySpecialized"), "2")
    0
}

val marker = #specialize()

fun main: int = answer() + librarySpecialized() + marker
