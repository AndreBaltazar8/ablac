// BigModulus and BigNumber (abla/crypto/bignum) on small values worked out by hand, modulo 13 in four bytes: the
// arithmetic, the checked refusals (an even modulus, a value not below the modulus) and the comparison.
import "abla/crypto"
import "abla/crypto/bignum"
import "abla/ct"

// The four bytes of a value below 16.
fun four(value: int): string = hexDecode("0000000" + "0123456789abcdef".slice(value, value + 1))

fun main: int {
    val modulus = bigModulus(four(13)) ?? return 1
    if (bigModulus(four(12)) != null) return 2
    val seven = modulus.number(four(7)) ?? return 3
    val nine = modulus.number(four(9)) ?? return 4
    if (modulus.number(four(13)) != null) return 5
    if (seven.add(nine).toBytes() != four(3)) return 6
    if (seven.sub(nine).toBytes() != four(11)) return 7
    if (seven.mul(nine).toBytes() != four(11)) return 8
    if (seven.isEqual(seven.copy()).declassify() != u32(4294967295)) return 9
    if (seven.isEqual(nine).declassify() != u32(0)) return 10
    0
}
