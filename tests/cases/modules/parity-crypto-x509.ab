// Compile-time parity of abla/crypto/x509: a certificate read from PEM (tests/cases/x509's EC intermediate) and its
// fields, and malformed input, print the same at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/x509"

val CERTIFICATE_PEM =
    "-----BEGIN CERTIFICATE-----\n" +
    "MIIBiTCCAS6gAwIBAgIBZjAKBggqhkjOPQQDAjAXMRUwEwYDVQQDDAxUZXN0IFJv\n" +
    "b3QgRUMwHhcNMjAwMTAxMDAwMDAwWhcNNDAwMTAxMDAwMDAwWjAfMR0wGwYDVQQD\n" +
    "DBRUZXN0IEludGVybWVkaWF0ZSBFQzBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IA\n" +
    "BDRXfEAFilbKE7/KVds7RC+8AlQjxtxv23kVql8owKD134I94g/sz9d0203JYIKq\n" +
    "OpbyhtlkdAtzdzNKpV7KxNCjYzBhMA8GA1UdEwEB/wQFMAMBAf8wDgYDVR0PAQH/\n" +
    "BAQDAgEGMB0GA1UdDgQWBBQknO1moffODvNpUT//IMYDy0X8wjAfBgNVHSMEGDAW\n" +
    "gBSJavJKV8QU6tIJwj/t1z0psPlWizAKBggqhkjOPQQDAgNJADBGAiEAiVAoxMIV\n" +
    "d9hzCaK4Vw1zI/5Zw5mPnIxcpNXjXJIw8SgCIQDvWSS1IcggtOwZL+O+SOaLtwQs\n" +
    "TSLLNKPGVaQUF4i2AA==\n" +
    "-----END CERTIFICATE-----\n"

fun main: int {
    val read = x509ParsePem(CERTIFICATE_PEM)
    println("certificates ${read.certificates.size} skipped ${read.skipped}")
    for (certificate in read.certificates) {
        println("ok ${certificate.ok} version ${certificate.version} serial ${hexEncode(certificate.serial)}")
        println("subject ${certificate.subject.commonName} issuer ${certificate.issuer.commonName}")
        println("valid ${certificate.notBefore} to ${certificate.notAfter} key ${certificate.keyOid} ca ${certificate.isCa} path ${certificate.pathLength} usage ${certificate.keyUsage}")
        println("der ${hexEncode(sha256(certificate.der))}")
    }
    println("garbage ${x509ParseDer("garbage").error}")
    println("no pem ${x509ParsePem("no certificate here").certificates.size}")
    42
}
