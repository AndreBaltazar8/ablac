// An operator on a field read through Shared.get() builds a new value: a
// string concatenation or an arithmetic or bitwise result is not a view of the
// shared object, whether it is used at once or held in a local first.
resource class Text(val value: string, val count: int)

fun joined(rope: Shared<Text>): int {
    val joined = rope.get().value + "!"
    joined.size
}

fun throughLocal(rope: Shared<Text>): string {
    val text = rope.get().value
    text + "?"
}

fun counted(rope: Shared<Text>): int {
    val next = rope.get().count + 1
    val masked = rope.get().count & 6
    next * 10 + masked
}

fun main: int {
    val rope = Shared(Text("abc", 6))
    val concatenated = joined(rope)
    val questioned = throughLocal(rope)
    val numbers = counted(rope)
    if (concatenated == 4 && questioned == "abc?" && numbers == 76 &&
        "${rope.get().value}!" == "abc!") 42 else 1
}
