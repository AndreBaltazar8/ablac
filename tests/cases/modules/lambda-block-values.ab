// A lambda where a block's value is taken is not an error (#824): returned from a function, chosen by an `if`, the
// result of another lambda. `if (true) { ... }` is the block that runs.
import "abla/io"

fun adder(step: int): (int) -> int {
    val base = step * 10
    { value: int -> value + base }
}

fun pick(first: bool): () -> string = if (first) { { -> "first" } } else { { -> "second" } }

fun main: int {
    var ran = 0
    if (true) {
        ran = ran + 1
    }
    val make = { -> { -> "inner" } }
    println("${adder(2)(1)} ${pick(false)()} ${make()()} $ran")
    0
}
