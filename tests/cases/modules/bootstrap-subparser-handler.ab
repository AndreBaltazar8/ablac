#import("../../../bootstrap/compiler/eval.ab")

fun main: int {
    val parsed = bootstrapParse(
        "compile fun parseAnswer(cursor: int): int { parserExpect(cursor, \"{\"); parserExpect(cursor, \"}\"); syntaxBinary(\"+\", syntaxInteger(20), syntaxInteger(22)) }\n#compilerRegisterSubparser(\"answer\", parseAnswer)\n"
    )
    val registry = bootstrapBuildSubparserRegistry(parsed)
    val input = "{}"
    val tokens = bootstrapLex(input)
    val cursor = BootstrapSubparserCursor(
        input,
        tokens,
        [],
        [],
        [],
        0,
        tokens[0].begin,
        0
    )
    val invocation = bootstrapInvokeSubparserHandler(
        parsed.declarations,
        registry.registrations[0].handler,
        cursor,
        false
    )
    if (
        parsed.errors == 0 &&
        registry.errors == 0 &&
        invocation.errors == 0 &&
        cursor.position + 1 == tokens.size &&
        invocation.expression.kind == "+" &&
        invocation.expression.children.size == 2 &&
        invocation.expression.children[0].text == "20" &&
        invocation.expression.children[1].text == "22"
    ) 42 else 0
}
