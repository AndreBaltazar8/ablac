#import("abla/unsafe/memory")

fun main: int {
    val cell = nativeI64Cell(19)
    val first = cell.load()
    cell.store(first + 23)
    val answer = cell.load()
    val pointerCell = nativePointerCell(cell.address)
    val pointerRoundTrip = pointerCell.load() == cell.address
    val pointerReleased = pointerCell.close()
    val released = cell.close()
    val releasedTwice = cell.close()
    if (answer == 42 && pointerRoundTrip && pointerReleased &&
        released && !releasedTwice) 42 else 0
}
