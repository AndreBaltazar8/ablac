import "abla/http"

fun fakeTlsExchange(
    request: string,
    maximum: int,
    timeout: int
): HttpTransportResult {
    val valid = request.slice(0, 15) == "GET /fake HTTP/" &&
        maximum == 4096 && timeout == 1000
    if (valid) HttpTransportResult(
        "HTTP/1.1 201 Created\r\nContent-Length: 4\r\nX-Test: yes\r\n\r\nfake",
        true
    ) else HttpTransportResult("", false)
}

fun main: int {
    val network = httpIpv4Client("localhost:39092", "127.0.0.1", 39092)
    val remote = network.send(httpGet("/hello"))

    val tls = httpClient("example.test", fakeTlsExchange, 4096, 1000)
    val synthetic = tls.send(httpGet("/fake"))

    if (remote.succeeded && remote.complete &&
        remote.response.status == 200 && remote.response.body == "hello" &&
        synthetic.succeeded && synthetic.complete &&
        synthetic.response.status == 201 &&
        synthetic.response.header("x-test") == "yes" &&
        synthetic.response.body == "fake") 42 else 0
}
