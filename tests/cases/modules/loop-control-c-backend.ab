#import("../../../bootstrap/compiler/backend_c.ab")
#import("abla/sys/linux/io")

fun main: int {
    linuxPrintStandardOutput(bootstrapEmitC(
        "fun main: int {\n    var current = 0\n    var total = 0\n    while (current < 10) {\n        current = current + 1\n        if (current == 2) continue\n        if (current == 6) break\n        total = total + current\n    }\n    if (total == 13) 42 else 0\n}\n"
    ))
    0
}
