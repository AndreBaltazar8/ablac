import "abla/compiler/parser"

compile fun parseInferredLambda(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "{")
    val body = parserParseAblaExpression(cursor)
    parserExpect(cursor, "}")
    syntaxInferredLambda(["value"], body, false)
}

#compilerRegisterSubparser("inferredLambda", parseInferredLambda)

fun apply(callback: Fn(int) -> int): int = callback(41)

fun mutate(var callback: FnMut(int) -> int): int = callback(20) + callback(22)

class CallbackBox(val callback: Fn(int) -> int)

class CallbackConsumer() {
    fun apply(callback: Fn(int) -> int): int = callback(41)
}

fun main: int {
    val captured = 1
    val immutable = apply($inferredLambda { value + captured })
    val box = CallbackBox(
        $inferredLambda { value + captured }
    )
    val boxedCallback = box.callback
    val boxed = boxedCallback(41)
    val method = CallbackConsumer().apply(
        $inferredLambda { value + captured }
    )
    val repeatable = mutate($inferredLambda { value })
    var total = 0
    val combined = mutate($inferredLambda { total = total + value })
    if (
        immutable == 42 && boxed == 42 && method == 42 &&
        repeatable == 42 &&
        combined == 62 && total == 42
    ) 42 else 0
}
