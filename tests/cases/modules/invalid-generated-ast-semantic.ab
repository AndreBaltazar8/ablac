import "abla/compiler"
import "abla/compiler/parser"

compile fun finalizeInvalidGeneratedAst(
    payload: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val module = compilerGeneratedModule("invalid.semantic", expression)
    val names: array<string> = []
    val types: array<int> = []
    compilerGeneratedFunction(
        module,
        "badResult",
        names,
        types,
        compilerFindType("int"),
        syntaxString("not an integer")
    )
    module
}

compile fun parseInvalidGeneratedAst(
    cursor: ParserCursor
): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "invalid.semantic",
        "bad-result",
        expression,
        finalizeInvalidGeneratedAst
    )
    expression
}

#compilerRegisterSubparser("invalidGeneratedAst", parseInvalidGeneratedAst)

fun main: int = $invalidGeneratedAst(42)
