class ImportedReactiveState(var count: int, var untouched: int)

fun importedReactiveRead(state: ImportedReactiveState): int = state.count

fun importedReactiveWrite(var state: ImportedReactiveState): void {
    state.count = state.count + 1
    return
}

fun importedReactiveForward(var state: ImportedReactiveState): void {
    importedReactiveWrite(state)
    return
}
