import "abla/io"

var events: string = ""
fun numbers(): Generator<int> = generator {
    defer { events = events + "generator " }
    yield 1
    yield 2
}
resource class Holder(val gen: Generator<int>) {
    fun drop(): void { events = events + "holder " }
}

fun earlyReturn(): int {
    for (value in Holder(numbers()).gen) return value
    0
}

fun outer(): Generator<int> = generator {
    for (value in Holder(numbers()).gen) yield value
}

fun exercise(): string {
    events = ""
    for (value in Holder(numbers()).gen) {}
    events = events + "exhausted | "
    for (value in Holder(numbers()).gen) break
    events = events + "break | "
    earlyReturn()
    events = events + "return | "
    for (value in outer()) break
    events = events + "outer-drop"
    events
}

@export("run")
fun run(): int {
    println(exercise())
    println(#exercise())
    0
}

fun main: int = run()
