#import("abla/runtime/memory")
#import("abla/unsafe/memory")

fun main: int {
    val live = runtimeMemoryLiveBytes()
    runtimeMemorySetLimit(live + 64)
    // Must fail in the runtime before the host allocator can consume this.
    val buffer = nativeByteBuffer(4096)
    buffer.store(0, 42)
    1
}
