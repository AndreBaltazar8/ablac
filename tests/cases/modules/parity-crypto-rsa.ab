// Compile-time parity of abla/crypto/rsa and abla/crypto/rsapss: a private key read from PEM (a 2049-bit key of
// tests/cases/rsa-unbalanced), PKCS #1 v1.5 and PSS signatures (PSS with a fixed salt) and their checks print the
// same at run time and under `#`
// (tools/test-compile-time-parity.sh). Signing blinds with random numbers, but the signature doesn't depend on them.
import "abla/io"
import "abla/crypto"
import "abla/crypto/rsa"
import "abla/crypto/rsapss"
import "abla/text"

fun show(result: CryptoResult): string = if (result.ok) hexEncode(result.bytes) else "error ${result.error}"

val KEY_PEM =
    "-----BEGIN RSA PRIVATE KEY-----\n" +
    "MIIEpQIBAAKCAQEBWB+HGZx2AtPYA0TRiLbXBF6xYMbEHLgcTEgdhwPAXTzdDPjF\n" +
    "3dX71tucWvTjLQdpcbbkGZBVbtvqp7CdlJvFE0n8trMlH036cEXjb1Ywp17VUBNj\n" +
    "aIf/katx0UdXu0Jl+844cGD2NclLNup7LdV/sfXOMU5JtnfjlDZ2ZC06+wBj+914\n" +
    "v6m8jmS5TAC17b+k39O612/UNqTw3d/zZUFaDnj8FtZdF6dlYrSu4BtiZWuGWQoN\n" +
    "FmpvO2dZU1cvqbGIfuhj3xVx+AXfeLIU6m67wH4o6cBZZS4ER9wQAaGrAe+0RPDf\n" +
    "iUX+L79t0W0LaLUSvm9FE/xcnOq7N9TU+PGHIwIDAQABAoIBAQC34Ojk04jvi9ky\n" +
    "LfS009Zi/GJVrwAdxHdCf4pfma6RY7NOeiPonK3cKi8LHy3A4uQCIlMSIeC0wwhJ\n" +
    "IIOjY/TTkMZbrbAZYSaAFago1upalL7w8ds9gOYcJXtE85U6d4ldGt1nlzgYl338\n" +
    "UyEM5bc9FXZfPFEBEmDl0pBCiTSp50lHitDrNYNzdBIRsOH44r1BLdvA2/AvnQNy\n" +
    "QgLUIIZz7irdCFdAOfQ7YmBYp/ZZ3JjwCejw3RUE5wf0FpgE7HCYga+jUi0DAQU+\n" +
    "IyU6bHsOLMpunhFnCAr4DC8bzrU//ZYmttUbN2YPGPjiltfFTGGfnS3fv52ssAM+\n" +
    "oBK7GD3ZAoGBANynKsu4f4igvf9LY9Uix3cQW58zRMIaqaT5y/HiFgs2j0ToH4Ya\n" +
    "YY4bMzQTx6zGQuatIKHEPJChT34nXrEbbDrREE9zXRrqqeXaYG2sdVx/yHk3vGWm\n" +
    "WCUmXtWSmmMN9I1smyU9loniQW00oasWBBquTnydbr0OyczH99xp+JR9AoGBAY8/\n" +
    "yizZRHxlT18sZuazhwHEMEM+Sz481w0seedeow3WNIJIl1wIcQUGWg6erdpZm9QW\n" +
    "04hDo4eq8W8ldeMvj+xhD84litpSfiJmy1Syd1Uo5NGcvR9QcGeGq49V9nPJtOnF\n" +
    "wI4AiBfypYtFPaJGkdW9uGU9newTzrDZpgCGh3wfAoGARYrOGxzP3RDEMOTi1va6\n" +
    "JNVb+wXegsqCcwNjep2F0wzkBJSf8tT3sCD0d1JQmSx3Q1qHMVS2veKJOjpQRsNc\n" +
    "zgC8Aj5atrQEzfOQdqBm8Ls5RLMDRooxt6urMeadj+CDFduH3inV+yj6898loNU0\n" +
    "f/A1vmKj1yQFB+xyOt6PQMUCgYEBD+WJcnGkynLUUySSD5tD3lgV5jWOWJxmeHpJ\n" +
    "quAwe0PeDrwRGIRHM/zXaA14qLNOBGpnNO2beNFaCy+f0VCa24heky3OGlEDxbnr\n" +
    "z4qa6kwnSPlNcv39DwQP4lXQuZossugR8qM6C9UcGHTXPKSCvOWvpoMIAbablKUl\n" +
    "AEaeDlECgYEAw94GC4jv2XBkaT+115EPe/0tkyS22ZJtbYzGAScEsLxHJOhIw+ys\n" +
    "PAmnVBsjrMb1gWP4+ldn7tGCNCzLxQi2H+dwWC6OJ8Oma3WPUfC5daketC/pMDwO\n" +
    "bxnMMmjq+Cml5RbxkwThpjsUDFPB8HDwLJoszNA586wJmN92L2/TgqM=\n" +
    "-----END RSA PRIVATE KEY-----\n"

fun main: int {
    val key = rsaPrivateKeyFromPem(KEY_PEM)
    if (!key.ok()) {
        println("key error ${key.error}")
        return 42
    }
    println("bits ${key.bits} modulus ${hexEncode(sha256(key.modulus))}")
    val publicKey = rsaPublicFromNumbers(key.modulus, key.publicExponent, "unreadable")
    val pkcs1 = key.signPkcs1Sha256("parity")
    println("pkcs1 ${hexEncode(sha256(pkcs1.bytes))} ${publicKey.verifyPkcs1Sha256("parity", pkcs1.bytes)} ${publicKey.verifyPkcs1Sha256("other", pkcs1.bytes)}")
    val pss = rsaPssSignWithSalt(key, 256, "parity", "s".repeat(32))
    println("pss ${hexEncode(sha256(pss.bytes))} ${publicKey.verifyPssSha256("parity", pss.bytes)}")
    42
}
