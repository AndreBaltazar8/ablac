// Arrays of numbers and of bools are stored as 8-byte words; storing any
// other value (a null, a string) boxes the array first. Every operation
// behaves as on a boxed array.
import "abla/io"
import "abla/float"
import "abla/memory"

fun sum(values: array<int>): int {
    var total = 0
    for (value in values) total += value
    total
}

fun main: int {
    val numbers: array<int> = []
    for (i in 0 until 1000) numbers.append(i * 3)
    numbers[10] = -5
    if (numbers.size != 1000 || numbers[10] != -5 || numbers[999] != 2997) return 1
    if (sum(numbers) != 1498500 - 30 - 5) return 2
    numbers.truncate(4)
    numbers.append(7)
    if (numbers.size != 5 || numbers[4] != 7 || sum(numbers) != 0 + 3 + 6 + 9 + 7) return 3
    val weights = [0.5, 1.25, -3.0]
    weights.append(2.0)
    var weight = 0.0
    for (w in weights) weight += w
    if (weight != 0.75 || f64ToBits(weights[2]) != f64ToBits(-3.0)) return 4
    val flags = filledArray(5, false)
    flags[3] = true
    if (flags[0] || !flags[3] || flags.size != 5) return 5
    // A nullable element boxes the array; its numbers keep their values.
    val maybe: array<int?> = []
    for (i in 1 until 4) maybe.append(i)
    maybe.append(null)
    maybe[0] = null
    if (maybe[0] != null || maybe[1] != 2 || maybe[3] != null || maybe.size != 4) return 6
    val grid = [[1, 2], [3]]
    grid[1].append(4)
    if (grid[1][1] != 4 || grid[0][1] != 2) return 7
    // Survives collections, and costs 8 bytes an element.
    memoryCollect()
    val before = memoryLiveBytes()
    val big = filledArray(100000, 1)
    val grown: array<int> = []
    for (i in 0 until 100000) grown.append(i)
    val used = memoryLiveBytes() - before
    memoryCollect()
    if (big[99999] != 1 || grown[99999] != 99999 || sum(grown) != 4999950000) return 8
    println("bytes per element: ${used / 200000}")
    if (used > 200000 * 14) return 9
    42
}
