// Compile-effect summaries resolve method calls by receiver type: importing
// abla/fs (whose Path.appendText writes files natively) must not taint the
// unrelated ByteBuffer.appendText used by jsonStringify, so a staged `#$jsons`
// stays allowed. Before the fix this program never finished compiling.
import "abla/fs"
import "abla/json"

val frozen = #$jsons {"id": "w-new", "items": [1, 2]}

fun main: int = if (frozen == "{\"id\":\"w-new\",\"items\":[1,2]}") 42 else 1
