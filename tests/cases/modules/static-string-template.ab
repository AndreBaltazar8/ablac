// A template made only of literal text and module `val`s holding such strings
// folds to one constant at compile time. A parameter, local or field of the
// same name shadows the module value, and a `var` is read at runtime.
val A = "alpha"
val B = "${A}-beta"
val C = "<$B|${A}>"
var D = "var"
val E = "$D!"

class Box(val A: string) {
    fun show(): string = "{$A}"
}

fun shadowed(A: string): string = "[$A]"

fun local(): string {
    val B = "local"
    "($B)"
}

fun main: int {
    // Compared by shape: the folded text is the only place it appears in the IR.
    if (C.size != 18 || C[0] != 60 || C[17] != 62) return 1
    if (E != "var!") return 2
    D = "changed"
    if ("$D/$E" != "changed/var!") return 3
    if (shadowed("x") != "[x]") return 4
    if (local() != "(local)") return 5
    if (Box("field").show() != "{field}") return 6
    if ("$A$B" != "alphaalpha-beta") return 7
    42
}
