import "shadow-base.ab"

// Shadows shadow-base's `twice`: here and in this module's importers, `twice`
// is this one.
fun twice(value: int): int = value * 3
fun fromMiddle(): int = twice(5)

// A field or a method named like the shadowing function stays a member.
class Pair(val twice: int)
class Doubler(val base: int) {
    fun twice(): int = this.base * 10
}
fun pairTwice(): int = Pair(4).twice + Doubler(1).twice()
