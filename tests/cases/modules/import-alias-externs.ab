// An aliased module's declarations carry the module's prefix; its externs
// must still link by their C names and its intrinsics be recognized
// (`m.sqrt` reaches abla/math's __ablaF64Sqrt).
import "abla/math" as m
import "./import-alias-libm.ab" as libm

fun main: int =
    if (m.sqrt(16.0) == 4.0 && libm.sin(0.0) == 0.0 &&
        libm.twice(2.0) == 4.0) 42 else 1
