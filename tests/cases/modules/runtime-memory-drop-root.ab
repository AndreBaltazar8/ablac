// A function's result stays rooted while its scope's resources are dropped: a
// collection inside a drop helper must not free the value being returned.
import "abla/memory"

resource class Guard(var closed: bool) {
    fun drop(): void {
        closed = true
        return
    }
}

class Outcome(val status: int, val output: string)

fun guarded(index: int): Outcome {
    val guard = Guard(false)
    Outcome(index, "outcome $index")
}

fun main: int {
    memorySetCollectionGrowth(4096)
    var ok = true
    var index = 0
    while (index < 100000) {
        val outcome = guarded(index)
        if (outcome.status != index || outcome.output != "outcome $index") ok = false
        index = index + 1
    }
    if (ok) 42 else 1
}
