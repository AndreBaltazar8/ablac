compile fun compileRangeTotal(): int {
    var total = 0
    for (value in 1..6) {
        if (value == 2) continue
        if (value == 6) break
        total = total + value
    }
    total
}

fun arrayTotal(): int {
    var total = 0
    for (value in [10, 20, 12]) {
        total = total + value
    }
    total
}

fun exclusiveTotal(): int {
    var total = 0
    for (value in 0 until 4) total = total + value
    total
}

fun capturedIterationTotal(): int {
    var total = 0
    for (value in 1..3) {
        val callback = { -> value }
        total = total + callback()
    }
    total
}

fun main: int {
    val values = 2..4
    val reversed = 4..2
    val emptyExclusive = 3 until 3
    var textTotal = 0
    for (byte in "AB") textTotal = textTotal + byte
    if (
        #compileRangeTotal() == 13 &&
        arrayTotal() == 42 &&
        exclusiveTotal() == 6 &&
        capturedIterationTotal() == 6 &&
        values.size == 3 &&
        reversed.size == 0 &&
        emptyExclusive.size == 0 &&
        values[0] + values[1] + values[2] == 9 &&
        textTotal == 131
    ) 42 else 0
}
