class Counter(var value: int)

class CounterPair(var left: Counter, var right: Counter)

class CounterBox(val counter: Counter) {
    fun increment(delta: int): int {
        this.counter.value = this.counter.value + delta
        this.counter.value
    }
}

fun increment(var counter: Counter, delta: int): int {
    counter.value = counter.value + delta
    counter.value
}

fun managedAliasAfterLastUse(): int {
    val counter = Counter(20)
    val view = counter
    val observed = view.value
    increment(counter, 2)
    observed + counter.value
}

fun disjointManagedAlias(): int {
    val pair = CounterPair(Counter(19), Counter(20))
    val left = pair.left
    increment(pair.right, 3)
    left.value + pair.right.value
}

fun controlledTransitiveAlias(): int {
    val box = CounterBox(Counter(20))
    val view = box
    val observed = view.counter.value
    box.increment(2)
    observed + box.counter.value
}

compile fun stagedManagedAliases(): int =
    managedAliasAfterLastUse() + disjointManagedAlias() +
        controlledTransitiveAlias() - 84

fun main: int {
    if (#stagedManagedAliases() == 42 &&
        managedAliasAfterLastUse() == 42 &&
        disjointManagedAlias() == 42 &&
        controlledTransitiveAlias() == 42) 42 else 0
}
