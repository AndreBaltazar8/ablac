import "abla/compiler"
import "abla/compiler/parser"

fun inspectedAdd(left: int, right: int): int = left + right

compile fun parseInspected(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    val handle = compilerFindFunction(syntaxText(expression))
    if (syntaxKind(expression) != "call" ||
        syntaxChildCount(expression) != 2 ||
        syntaxKind(syntaxChild(expression, 0)) != "integer" ||
        syntaxBegin(expression) >= syntaxEnd(expression) ||
        handle < 0 || compilerFunctionParameterCount(handle) != 2 ||
        compilerFunctionParameterType(handle, 0) != "i64" ||
        compilerFunctionResultType(handle) != "i64" ||
        compilerFunctionIsCompileOnly(handle) ||
        compilerFunctionIsTrusted(handle) ||
        compilerFunctionIsExternal(handle)) {
        parserFail(cursor, "expected an eligible (int, int) -> int call")
    }
    expression
}

#compilerRegisterSubparser("inspected", parseInspected)

fun main: int = $inspected(inspectedAdd(19, 23))
