// Fixed-width and nominal scalars at compile time: conversions, wrapping
// arithmetic, unsigned u64 ordering, division, shifts and text, extension and
// operator methods on scalar receivers, and a `return` reached inside an
// argument or an initializer give under `#` what they give at run time.
import "abla/float/text"

type Pin = int
type Port = u16
type UserId = int

class V(val x: int)
class Word(var value: i32)

fun Pin.offset(by: int): Pin = Pin(this + by)
fun Pin.label(): string = "pin ${pinValue(this)}"
fun pinValue(pin: Pin): int = pin
fun Port.next(): Port = Port(portValue(this) + u16(1))
fun portValue(port: Port): u16 = port
fun int.twice(): int = this * 2
operator fun int.times(v: V): V = V(this * v.x)

fun widen(value: u8): int = int(value)
fun port(value: int): Port = Port(value)
fun plusOne(value: int): int = value + 1
fun userText(id: UserId): string = "user $id"
fun userNumber(id: UserId): int {
    val raw: int = id
    raw + 1
}

fun escapeArgument(go: bool): int {
    val jumped = plusOne(if (go) return 9 else return 10)
    jumped
}

fun escapeInitializer(go: bool): int {
    val value = if (go) return 7 else 8
    value + 100
}

fun escapeOperator(go: bool): V {
    val jumped = 3 * (if (go) return V(5) else return V(6))
    jumped
}

fun report(): string {
    var text = ""
    val word = Word(i32(1103515245))
    word.value = word.value * i32(1103515245)
    text = "$text ${word.value}"
    text = "$text ${i8(127) + i8(1)} ${u8(255) + u8(1)} ${u16(65535) + u16(2)}"
    text = "$text ${i16(-32768) - i16(1)} ${u32(4000000000) * u32(3)}"
    text = "$text ${~u32(4000000000)} ${i32(-1) >>> 28} ${i32(-2) >> 1}"
    text = "$text ${u32(1) << 32} ${u32(2147483648) >> 31} ${i32(-7) % i32(3)}"
    val big = u64(9223372036854775807) + u64(1)
    text = "$text $big ${big > u64(5)} ${u64(5) < big} ${big / u64(3)}"
    text = "$text ${big % u64(7)} ${big >> 60} ${u64(0) - u64(1)}"
    text = "$text ${int(big)} ${i32(u64(4294967295))} ${u8(-1)} ${int(char(65) ^ char(3))}"
    val narrow: u8 = u8(200)
    text = "$text ${widen(narrow)} ${narrow + u8(100)}"
    text = "$text ${pinValue(Pin(40).offset(2))} ${Pin(3).label()} ${portValue(port(65535).next())}"
    text = "$text ${(-4).twice()} ${(3 * V(2)).x}"
    text = "$text ${escapeArgument(true)} ${escapeInitializer(true)}"
    text = "$text ${escapeOperator(true).x}"
    text = "$text ${i32(-1) >> 40} ${u8(1) << 257}"
    val id = UserId(41)
    text = "$text ${userText(id)} ${userNumber(id)} ${id == 41} ${char(72)}${char(105)}"
    text = "$text ${f64Text(0.1)} ${f64Text(1.0 / 3.0)} ${f64Text(1e21)} ${f64Text(5e-324)}"
    text
}

val STAGED = #report()

fun main: int {
    val runtime = report()
    if (STAGED != runtime) 1
    else if (runtime != " -1029531031 -128 0 1 32767 3410065408 294967295 15 -1 0 1 -1 9223372036854775808 true true 3074457345618258602 1 8 18446744073709551615 -9223372036854775808 -1 255 66 200 44 42 pin 3 0 -8 6 9 7 5 0 2 user 41 42 true Hi 0.1 0.3333333333333333 1e+21 5e-324") 2
    else 42
}
