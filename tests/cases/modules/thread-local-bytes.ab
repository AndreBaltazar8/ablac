// Thread-local bytes (nativeThreadLocalBytes): one object per call site,
// starting from the given bytes and keeping what is stored in it, natively
// and under `#` on either tier.
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun nextTicket(): int {
    val slot = nativePointerFromAddress(
        nativeThreadLocalBytes("\x05\x00\x00\x00\x00\x00\x00\x00")
    )
    val value = ablaUnsafeLoadI64(slot)
    ablaUnsafeStoreI64(slot, value + 1)
    value
}

trusted fun otherSite(): int =
    ablaUnsafeLoadI64(nativePointerFromAddress(
        nativeThreadLocalBytes("\x09\x00\x00\x00\x00\x00\x00\x00")
    ))

fun main: int {
    val first = nextTicket()
    val second = nextTicket()
    val third = nextTicket()
    if (first == 5 && second == 6 && third == 7 && otherSite() == 9) 42 else 1
}
