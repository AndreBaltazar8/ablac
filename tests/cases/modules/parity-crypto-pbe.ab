// Compile-time parity of abla/crypto/pbe: a PKCS #8 key encrypted with PBES2 (PBKDF2-HMAC-SHA256, 1,000 rounds,
// AES-128-CBC; made once by `openssl pkcs8 -topk8 -v2 aes-128-cbc -iter 1000` from tests/cases/rsa-unbalanced's
// u2049.pem, password "parity"), opened with the right and a wrong password, and malformed input, print the same at
// run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/pbe"

val ENCRYPTED =
    "30820535305f06092a864886f70d01050d3052303106092a864886f70d01050c3024041044b924f1a44f151b0e41a032b35827d6020203e8" +
