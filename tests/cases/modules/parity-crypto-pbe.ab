    "75c9315ecd2b4c4db8034a75a3d49956b0ae819454e79708f61be4f383d846b687ff1edb42feee1375391b7c6c33e6bbdd909e58c437cc3c" +
    "b19f3e0bc08d059812687b485ff611cf8572f92c32c4fec149804bb027ffaa2889badb3b45629a81dc58c03b4d50c50bac97d54615615ca0" +
    "5971a32d13b1181a2f09c11d3ea5e25f29b4c8ebe857eb35cf79d318ca83f8ca5db81c041695017b46fd1a325b2b9664e0895a98f066bf64" +
    "903fd8e7671a6c4c4dfe9f7d6cb14e66a65cf8e563de91de0e25f0a1cc25fc2fbe8d9b866ef1efcfb1c6e50a5db772f11cafc5b9a0dd6b99" +
    "fca65b09ea2e50fe19cbac5931a3d424006f32e5bc15d4f97e803b80a4e02d8ff37699f0b337126576d708412a2eaf444e547bb72df89555" +
    "f3716cf5b21ef88a86ebfa873b298ab7f7dc70874c42cf9623345c083012edc7fe956aa8bd17326d493cffc85d6b4a7a0ab5754c36871448" +
    "3fea49cdc22b3014dfcd139a0a0166b3b0199972e3ec889b0d7f829a30d4ef77b15829ba55e39c3f60d7f6c992a7ee878331d5e3ee65c6d9" +
    "1e1b6d10a2c74b0a065a269867269d2ef4c1c58965336d7fb99a34557a8d930f108efd4e8ba088908cfa84e9b7ac688d0c573ae2ff4d020d" +
    "fca8f8c1bc3bd7af80f03528624975f520c519fd40e2cdf03c9418d35b28f6fa8b86fe936f5d0c36946c0a112265e4c141c1879da31f77c3" +
    "406c0d1f516c6205d8c40ef980058e87bbc98444ae969830c8aa385bbb9c9d621797a11bfce822559fe194292b321b8f411d9414b7adf94a" +
    "c2a166e73b1f8c9fb0e202101e538a7aa1c7f4c0fa1374b96570f40b461bb90f4a8911ff82e0e541f14e1a18b582735dffeb1c3f30e1f736" +
    "383dee85493205f1dc998d2114899283280adfe1dd5da04e10ee8bf37f86646d5d074b23d19fe6e662c40a4c2e34f2942d1a24addcb353a8" +
    "3e8bc11a5a8054dc2ffea03f8a363d119ac1a2e9d30bfb07d07ec24f6afd7b7f17439309bd2bc2b9eed4e92ee87d128f620f2765ea45d7e4" +
    "25904a9c5f637b128d7cbdb13361a5e23087c0ae4e5ebc994fceaec4fb9340ee83ee0c7628d2b5cb5da7bb4435fae11857ee9eb4e0e97921" +
    "2a28b196ffd023f5af4b902deda735fb74a93532c9df83afeef9e9f82188c058238ef4e2511ef4c2f1677a985e5305a907c08703c8b437ea" +
    "ffd7d3f77d3873073bb2b43f7b490c5d8f4aa2dfd6591bed8bdbc3fc2abd8b1361b9b5d7c1e87f73b56cd2d566ba0e9e49f915953730629a" +
    "3a21d2e275f4c420875c6a0b40db8d7a1f03d64bfb058e22a7cd27a91127aa6864bc63946a40112cc78a0cdc59aa444ffbccf7a1d9ccc7cb" +
    "ec5686e77d3efffd42f41d8fdeae2c28a06084f29856d68fb690814c4578c726195880becf4a873b36e49a47d44f0551627cd191976512a6" +
    "92d1c8cc4fea69dd95cae08690e898e40668f90b9338e7557b0d101d86b4a52be2c748fc5706e9cf7df48870b1c1e5522d548bdff65b033f" +
    "e4eeb44128de6cab80836c70762d50deb7758923bc0e8c83dca2b9a0a13c2edf1bedbc3637fc49c0fbb9ff688fc943095fcd1b3c5d1908a0" +
    "ae1fd3425246cc04b357194d5318aff72b31481856997a8dd42f711e8f7477d66a65f9e72b230205d87f2f272d3ca1de64c550e66a9a581a" +
    "2fbde565ec061263d960645d922b9bdcb5cb1608287811c6a73bae020ee3cb8c0f03d08ef6dafadbcf7661b332b158aa06"

fun opened(der: string, password: string): string {
    val key = pbeOpenPkcs8(der, cryptoPassword(password))
    if (key.ok()) "key ${hexEncode(sha256(key.der()))}" else "error ${key.error()}"
}

fun main: int {
    val der = hexDecode(ENCRYPTED)
    println("right ${opened(der, "parity")}")
    println("wrong ${opened(der, "parity!")}")
    println("truncated ${opened(der.slice(0, 40), "parity")}")
    println("empty ${opened("", "parity")}")
    42
}
