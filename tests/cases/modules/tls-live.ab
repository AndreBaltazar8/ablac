import "abla/http/tls"
import "abla/random/hosted"

fun contains(input: string, wanted: string): bool {
    var found = false
    var index = 0
    while (!found && index + wanted.size <= input.size) {
        if (input.slice(index, index + wanted.size) == wanted) found = true
        index = index + 1
    }
    found
}

fun main: int {
    val entropy = hostedSecureRandomBytes(32)
    // Exercise an overall timeout above the raw connector's ten-second cap.
    // The TLS adapter must clamp only the connection phase rather than reject
    // the otherwise valid HTTPS request before opening a socket.
    val client = httpsClient("example.com", 443, 262144, 15000)
    val response = client.send(httpGet("/"))
    if (entropy.succeeded && entropy.bytes.size == 32 && tlsAvailable() &&
        response.succeeded && response.complete && response.response.status == 200 &&
        contains(response.response.body, "Example Domain")) 42 else 1
}
