// An array literal takes its parameter's type when a default fills another
// parameter or a name gives it, as it does in a call that passes everything.
interface Shape { fun sides(): int }
class Square : Shape { fun sides(): int = 4 }
class Line : Shape { fun sides(): int = 1 }
class Holder(val count: int = 1, val shapes: array<Shape> = []) {
    fun total(): int {
        var sum = count
        for (shape in shapes) sum = sum + shape.sides()
        sum
    }
    fun with(extra: int = 1, more: array<Shape> = []): int = extra + more.size
}
class Only(val shapes: array<Shape> = [], val count: int = 2) {
    fun total(): int = shapes.size + count
}
class Generic<X>(val tag: int = 1, val items: array<X> = []) {
    fun sized(extra: int = 1, more: array<X> = []): int = extra + more.size
}
fun <X> generic(extra: int = 1, more: array<X> = []): int = extra + more.size
fun plain(extra: int = 1, more: array<Shape> = []): int = extra + more.size
fun main: int {
    val named = Holder(shapes = [Square()])
    val filled = Only([Square(), Line()])
    val typed = Generic<int>(1, [1, 2])
    named.total() + filled.total() + named.with(more = [Line()]) + typed.items.size +
        typed.sized(more = [3]) + generic(more = ["a"]) + plain(more = [Square()]) +
        Holder(9, [Line()]).total() + 13
}
