import "abla/bytes"
import "abla/crypto"

val stagedSha256 = #hexEncode(sha256("abc"))
val stagedSha1 = #hexEncode(sha1("abc"))

fun main: int {
    val highByte = byteEncode(255)
    if (stagedSha256 !=
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") 1
    else if (hexEncode(sha256("")) !=
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") 2
    else if (hexEncode(sha1("abc")) !=
        "a9993e364706816aba3e25717850c26c9cd0d89d" ||
        stagedSha1 != "a9993e364706816aba3e25717850c26c9cd0d89d") 8
    else if (hexEncode(hmacSha256(
        "key", "The quick brown fox jumps over the lazy dog"
    )) != "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8") 3
    else if (hexEncode(pbkdf2Sha256("password", "salt", 2)) !=
        "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43") 4
    else if (base64Encode("hello") != "aGVsbG8=") 5
    else if (base64Decode("aGVsbG8=") != "hello") 6
    else if (base64Decode("invalid") != "") 7
    else if (hexEncode(md5("abc")) !=
        "900150983cd24fb0d6963f7d28e17f72") 8
    else if (!constantTimeEquals("proof", "proof")) 9
    else if (constantTimeEquals("proof", "proofs")) 10
    else if (highByte.size != 1 || highByte[0] != 255) 11
    else if (byteEncode(-1) != "" || byteEncode(256) != "") 12
    else 42
}
