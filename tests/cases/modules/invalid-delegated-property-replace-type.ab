class Box(var current: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = next
        return
    }
}

class Other(var current: int) {
    fun getValue(): int = current
}

class Holder(var value: int by Box(1)) {
    fun swap(): void {
        ^value = Other(2)
        return
    }
}

fun main: int = Holder().value
