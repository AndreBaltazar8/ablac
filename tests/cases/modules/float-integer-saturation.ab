// Float to integer conversions truncate toward zero and saturate (NaN is 0),
// the same at run time and under `#`.
import "abla/float"

fun report(): string {
    val nan = 0.0 / 0.0
    var text = ""
    for (value in [1e20, -1e20, nan, 3.9, -3.9, 2147483520.0, -0.5, 4294967040.0]) {
        val single = f64ToF32(value)
        text = "$text ${f32ToI32(single)}/${f32ToU32(single)}"
    }
    "$text ${f64ToInt(1e300)} ${f64ToInt(-1e300)} ${f64ToInt(nan)} ${f64ToInt(-2.7)}"
}

val STAGED = #report()

fun main: int {
    val runtime = report()
    if (STAGED != runtime) 1
    else if (runtime != " 2147483647/4294967295 -2147483648/0 0/0 3/3 -3/0 2147483520/2147483520 0/0 2147483647/4294967040 9223372036854775807 -9223372036854775808 0 -2") 2
    else 42
}
