import "abla/io"

fun numbers(): Generator<int> = generator { yield 1 }
class Holder(val gen: Generator<int>)
val holder = Holder(numbers())
val all: array<Generator<int>> = [numbers()]

fun main: int {
    for (value in holder.gen) println("field $value")
    val otherField = numbers()
    for (value in holder.gen) println("bad field $value")
    for (value in otherField) println("other field $value")
    for (value in all[0]) println("index $value")
    val otherIndex = numbers()
    for (value in all[0]) println("bad index $value")
    for (value in otherIndex) println("other index $value")
    0
}
