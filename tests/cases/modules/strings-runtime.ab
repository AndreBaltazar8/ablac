// Dynamic slices exercise fresh copies with unaligned, overlapping sources,
// embedded NUL/high bytes and lengths on both sides of the flat/rope limit.
@noinline
fun copyParts(first: string, second: string): string = first + second

fun stringCopyChecks(): bool {
    val source = "x\x00\x7f\x80\xffé0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    var length = 0
    while (length <= source.size - 2) {
        val left = source.slice(1, length + 1)
        val right = source.slice(2, length + 2)
        val joined = copyParts(left, right)
        val repeated = "$left$left$right$left"
        if (joined.size != length * 2 || repeated.size != length * 4) return false
        var index = 0
        while (index < length) {
            if (joined[index] != source[index + 1] ||
                joined[length + index] != source[index + 2] ||
                repeated[index] != source[index + 1] ||
                repeated[length + index] != source[index + 1] ||
                repeated[length * 2 + index] != source[index + 2] ||
                repeated[length * 3 + index] != source[index + 1]) return false
            index = index + 1
        }
        // Use an already-flattened rope as a leaf in another fresh copy.
        val nested = copyParts(repeated, joined)
        if (nested.size != length * 6 || nested.slice(0, repeated.size) != repeated ||
            nested.slice(repeated.size, nested.size) != joined) return false
        length = length + 1
    }
    true
}

fun main: int {
    val value = 21
    val text = "answer ${value + 21}"
    val escaped = "\"\\\n\u0041\$"
    val binary = "\x00\x7f\x80\xff"
    if (
        stringCopyChecks() &&
        text == "answer 42" &&
        escaped.size == 5 &&
        escaped[0] == 34 &&
        escaped[1] == 92 &&
        escaped[2] == 10 &&
        escaped[3] == 65 &&
        escaped[4] == 36 &&
        binary.size == 4 &&
        binary[0] == 0 &&
        binary[1] == 127 &&
        binary[2] == 128 &&
        binary[3] == 255
    ) 42 else 1
}
