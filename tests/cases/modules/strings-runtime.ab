fun main: int {
    val value = 21
    val text = "answer ${value + 21}"
    val escaped = "\"\\\n\u0041\$"
    val binary = "\x00\x7f\x80\xff"
    if (
        text == "answer 42" &&
        escaped.size == 5 &&
        escaped[0] == 34 &&
        escaped[1] == 92 &&
        escaped[2] == 10 &&
        escaped[3] == 65 &&
        escaped[4] == 36 &&
        binary.size == 4 &&
        binary[0] == 0 &&
        binary[1] == 127 &&
        binary[2] == 128 &&
        binary[3] == 255
    ) 42 else 1
}
