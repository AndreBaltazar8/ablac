fun main: int {
    val value = 21
    val text = "answer ${value + 21}"
    val escaped = "\"\\\n\u0041\$"
    if (
        text == "answer 42" &&
        escaped.size == 5 &&
        escaped[0] == 34 &&
        escaped[1] == 92 &&
        escaped[2] == 10 &&
        escaped[3] == 65 &&
        escaped[4] == 36
    ) 42 else 1
}
