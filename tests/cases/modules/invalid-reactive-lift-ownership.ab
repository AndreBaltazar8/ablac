import "abla/compiler"
import "abla/compiler/parser"

resource class LiftTicket(val value: int)

compile fun finalizeAffineCapture(
    payload: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val module = compilerGeneratedModule("reactive.invalid.owner", expression)
    val captures: array<string> = ["ticket"]
    val names: array<string> = ["captured"]
    val types: array<int> = [compilerFindType("LiftTicket")]
    val mutable: array<bool> = [false]
    compilerGeneratedLiftedFunction(
        module,
        "invalidOwner",
        captures,
        names,
        types,
        mutable,
        compilerFindType("i64"),
        expression
    )
    module
}

compile fun parseAffineCapture(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "reactive.invalid.owner",
        "invalidOwner",
        expression,
        finalizeAffineCapture
    )
    expression
}

#compilerRegisterSubparser("affineCapture", parseAffineCapture)

fun inspect(ticket: LiftTicket): int = $affineCapture(ticket.value)

fun main: int = inspect(LiftTicket(42))
