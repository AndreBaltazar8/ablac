// A new object returned with a parameter (or a place under one) stored in it
// is a view of the caller's value (an inferred `borrow(node)` result): it is
// not a borrow escape, and the caller may change the value once the view is
// no longer used.
class Node(var weight: int)
class Holder(val node: Node)
class Wrap(val node: Node)

fun wrap(node: Node): Wrap = Wrap(node)

fun wrapLater(node: Node): Wrap {
    val made = Wrap(node)
    made
}

fun wrapField(holder: Holder): Wrap = Wrap(holder.node)

fun Node.wrapped(): Wrap = Wrap(this)

fun grab(var node: Node): Wrap {
    node.weight = node.weight + 1
    Wrap(node)
}

fun main: int {
    val node = Node(40)
    val first = wrap(node)
    val second = wrapLater(node)
    val third = wrapField(Holder(node))
    val fourth = Node(1).wrapped()
    // Every wrapper holds the caller's node itself, not a copy.
    val shared = first.node.weight == 40 && second.node.weight == 40 &&
        third.node.weight == 40 && fourth.node.weight == 1
    node.weight = 41 // the wrappers are not used again
    if (shared && grab(node).node.weight == 42) 42 else 1
}
