compile fun stagedMove(): int {
    var source = 19
    val destination = move(source)
    source = 23
    destination + source
}

resource class Ticket(val value: int)

fun inspect(ticket: Ticket): int = ticket.value

fun resourceMove(): int {
    var source = Ticket(40)
    val destination = move(source)
    source = Ticket(2)
    inspect(destination) + inspect(source)
}

fun runtimeMove(): int {
    var source = [40]
    val destination = move(source)
    source = [2]
    destination[0] + source[0]
}

fun main: int {
    if (#stagedMove() == 42 && runtimeMove() == 42 &&
        resourceMove() == 42) 42 else 0
}
