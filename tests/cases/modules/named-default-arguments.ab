class Window(
    val width: int = 4,
    val height: int = width + 1,
    val depth: int = height + 1
)

fun dimensions(
    width: int = 4,
    height: int = width + 1,
    depth: int = height + 1
): int = width * height + depth

compile fun discardedCompileTimeValue(value: int = 42): int = value

// A top-level compile-time expression is an action. Its value is intentionally
// discarded, so registration and generation APIs do not need a dummy binding.
#discardedCompileTimeValue()

fun main: int {
    val reordered = dimensions(depth = 4, width = 2, height = 19)
    val functionDefaults = dimensions(width = 4)
    val constructorDefaults = Window(height = 20)
    val constructorReordered = Window(depth = 1, width = 20, height = 21)
    if (reordered == 42 && functionDefaults == 26 &&
        constructorDefaults.width == 4 &&
        constructorDefaults.height == 20 &&
        constructorDefaults.depth == 21 &&
        constructorReordered.width == 20 &&
        constructorReordered.height == 21 &&
        constructorReordered.depth == 1) 42 else 0
}
