// Compile-time parity of abla/crypto/ed25519: RFC 8032's test 1 key, a signature over a message and its checks print
// the same at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/ed25519"

fun show(result: CryptoResult): string = if (result.ok) hexEncode(result.bytes) else "error ${result.error}"

fun main: int {
    val seed = hexDecode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    val publicKey = ed25519PublicKey(seed)
    val signature = ed25519Sign(seed, "parity")
    println("public ${show(publicKey)}")
    println("signature ${show(signature)}")
    println("verify ${ed25519Verify(publicKey.bytes, "parity", signature.bytes)}")
    println("verify other ${ed25519Verify(publicKey.bytes, "parity!", signature.bytes)}")
    42
}
