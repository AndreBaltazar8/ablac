import "abla/compiler"
import "abla/compiler/parser"

class FunctionHandleStateClass(val value: int)

compile fun finalizeInvalidFunctionHandleStates(
    namespace: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    compilerFunctionName(-1)
    compilerFunctionName(compilerFindClass("FunctionHandleStateClass"))
    compilerFunctionName(999999)
    compilerGeneratedModule(namespace, expression)
}

compile fun parseInvalidFunctionHandleStates(
    cursor: ParserCursor
): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "invalid.function.handle.states",
        "invalid.function.handle.states",
        expression,
        finalizeInvalidFunctionHandleStates
    )
    expression
}

#compilerRegisterSubparser(
    "invalidFunctionHandleStates",
    parseInvalidFunctionHandleStates
)

fun invalidFunctionHandleStatesTarget(value: int): int = value

fun main: int =
    $invalidFunctionHandleStates(invalidFunctionHandleStatesTarget(42))
