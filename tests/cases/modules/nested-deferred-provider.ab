#import("abla/compiler")
#import("abla/compiler/parser")

fun nestedDeferredElement(
    attributes: array<int>,
    children: array<int>
): int = 42

fun nestedDeferredAttribute(
    argument: int,
    handler: (int) -> int
): int = argument + handler(0)

compile fun finalizeNestedDeferred(
    namespace: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val target = typedCallTarget(expression)
    if (typedExpressionKind(expression) == "call" &&
        typedExpressionType(expression) == "i64" &&
        typedCallArgumentCount(expression) == 1 &&
        typedCallArgumentType(expression, 0) == "i64" &&
        typedCallArgumentParameter(expression, 0) == 0 &&
        typedCallArgumentConversion(expression, 0) == "none" &&
        typedCallInsertedDefaultCount(expression) == 0 &&
        compilerFunctionName(target) != "" &&
        compilerTypeName(typedCallResultTypeHandle(expression)) == "i64") {
        val module = compilerGeneratedModule(namespace, expression)
        val names: array<string> = []
        val types: array<int> = []
        compilerGeneratedFunction(
            module,
            "anchor",
            names,
            types,
            compilerFindType("i64"),
            syntaxInteger(0)
        )
        module
    } else compilerGeneratedModule("invalid.nested.deferred", expression)
}

compile fun nestedDeferredAttributeSyntax(
    cursor: ParserCursor
): SyntaxExpression {
    parserRawExpect(cursor, "onclick={")
    val action = parserParseAblaExpression(cursor)
    parserRawExpect(cursor, "}")
    val namespace =
        "nested.deferred:${parserSourceIdentity(cursor)}:${syntaxBegin(action)}"
    compilerRecordGeneratedExtensionRequest(
        namespace,
        namespace,
        action,
        finalizeNestedDeferred
    )
    val arguments: array<SyntaxExpression> = [
        syntaxChild(action, 0),
        syntaxIdentifier(syntaxText(action))
    ]
    syntaxCall("nestedDeferredAttribute", arguments)
}

compile fun parseNestedDeferredElement(
    cursor: ParserCursor
): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "<")
    val tag = parserRawTakeName(cursor)
    val attributes: array<SyntaxExpression> = []
    parserRawSkipWhitespace(cursor)
    while (!parserRawAt(cursor, ">")) {
        attributes.append(nestedDeferredAttributeSyntax(cursor))
        parserRawSkipWhitespace(cursor)
    }
    parserRawExpect(cursor, ">")

    val children: array<SyntaxExpression> = []
    while (!parserRawAt(cursor, "</")) {
        parserRawSkipWhitespace(cursor)
        if (parserRawAt(cursor, "<") && !parserRawAt(cursor, "</")) {
            children.append(parseNestedDeferredElement(cursor))
        }
    }
    parserRawExpect(cursor, "</")
    val closingTag = parserRawTakeName(cursor)
    if (closingTag != tag) parserFail(cursor, "closing tag mismatch")
    parserRawExpect(cursor, ">")

    val arguments: array<SyntaxExpression> = [
        syntaxArray(attributes),
        syntaxArray(children)
    ]
    syntaxCall("nestedDeferredElement", arguments)
}

compile fun parseNestedDeferred(cursor: ParserCursor): SyntaxExpression =
    parseNestedDeferredElement(cursor)

#compilerRegisterSubparser("nestedDeferred", parseNestedDeferred)
