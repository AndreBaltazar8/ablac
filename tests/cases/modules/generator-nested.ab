import "abla/io"
fun count(limit: int): Generator<int> = generator {
    var value = 0
    while (value < limit) {
        yield value
        value = value + 1
    }
}
fun squares(limit: int): Generator<int> = generator {
    for (value in count(limit)) yield value * value
    yield 100
}
fun main: int {
    var total = 0
    for (value in squares(4)) total = total + value
    println("$total")
    0
}
