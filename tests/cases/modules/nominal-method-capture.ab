// A literal `int` isn't a nominal parameter's type, so a method of the same name
// doesn't capture the call; the top-level function gets it.
type Kind = int
type Other = int
class Order(val v: int)
fun order(x: int, y: int): Order = Order(x + y)
fun Kind.order(kind: Kind, y: int): Order {
    if (kind == Kind(9)) return Order(1)
    val plain = order(40, 2)
    val member = order(Kind(9), 2)
    Order(plain.v + member.v - 1)
}
fun Kind.fromOther(other: Other): Order = order(other, 0)
fun main: int = Kind(1).order(Kind(1), 0).v
