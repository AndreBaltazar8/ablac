val narrowGlobalLimit: u32 = u32(4000000000)
var narrowGlobalCounter: u16 = u16(40)

@export("abla_test_increment_u32")
fun incrementU32(value: u32): u32 = value + u32(1)

@export("abla_test_add_u8")
fun addU8(left: u8, right: u8): u8 = left + right

@export("abla_test_shift_u32")
fun shiftU32(value: u32, count: u32): u32 = value >> count

@export("abla_test_divide_u32")
fun divideU32(value: u32, divisor: u32): u32 = value / divisor

@export("abla_test_remainder_u32")
fun remainderU32(value: u32, divisor: u32): u32 = value % divisor

fun updateNarrowLocal(value: u16): u16 {
    var current = value
    current = current + u16(2)
    current
}

fun updateInferredU32(value: u32): u32 {
    var current = value ^ u32(3)
    current = current >> u32(1)
    current | u32(32)
}

fun main: int {
    narrowGlobalCounter = updateNarrowLocal(narrowGlobalCounter)
    if (
        u8(255) + u8(1) == u8(0) &&
        i8(127) + i8(1) == i8(-128) &&
        u16(65535) + u16(2) == u16(1) &&
        i16(-32768) - i16(1) == i16(32767) &&
        incrementU32(u32(41)) == u32(42) &&
        updateInferredU32(u32(83)) == u32(40) &&
        narrowGlobalLimit / u32(2) == u32(2000000000) &&
        remainderU32(u32(4000000001), u32(10)) == u32(1) &&
        i32(-7) % i32(3) == i32(-1) &&
        narrowGlobalLimit > u32(1) &&
        u32(2147483648) >> 31 == u32(1) &&
        u32(1) << 32 == u32(0) &&
        i32(-2) >> 1 == i32(-1) &&
        i32(-2) >>> 1 == i32(2147483647) &&
        (u64(42) | u64(1)) == u64(43) &&
        (char(65) ^ char(3)) == char(66) &&
        narrowGlobalCounter == u16(42)
    ) 42 else 1
}
