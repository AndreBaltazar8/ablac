fun addOne(value: int): int = value + 1

fun positive(value: int): bool = value > 0

fun choose(value: int, fallback: int = 40): int {
    if (positive(value)) addOne(value) else fallback + 2
}

fun apply(callback: Fn(int) -> int, value: int): int = callback(value)

fun main: int {
    val callback: Fn(int) -> int = addOne
    if (
        choose(41) == 42 &&
        choose(-1) == 42 &&
        apply(callback, 41) == 42
    ) 42 else 0
}
