import "abla/memory"

// memorySetManualCollection opts out of pressure collection: allocating
// functions are not safe points, and garbage stays until memoryCollect().
class ManualLink(var next: ManualLink?, val payload: array<int>)

fun abandonManualCycle(seed: int): int {
    val payload: array<int> = []
    var index = 0
    while (index < 1024) {
        payload.append(seed + index)
        index = index + 1
    }
    val left = ManualLink(null, payload)
    val right = ManualLink(left, [seed])
    left.next = right
    left.payload[0] + right.payload[0]
}

fun main: int {
    memorySetManualCollection()
    val kept = ManualLink(null, [42])
    // 8192 cycles of about 8 KiB each: 64 MiB, past the default first
    // collection point, none of it freed on the way.
    var round = 0
    var sum = 0
    while (round < 8192) {
        sum = abandonManualCycle(21)
        round = round + 1
    }
    val grown = memoryLiveBytes()
    val freed = memoryCollect()
    val after = memoryLiveBytes()
    if (sum == 42 && grown > 50331648 && freed > 50331648 &&
        after < 4194304 && kept.payload[0] == 42) 42 else 1
}
