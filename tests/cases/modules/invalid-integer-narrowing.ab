type Count = int

class Pixel(val red: u8)
class Counter(var count: u16) {
    fun add(step: u16): u16 = this.count + step
}

fun take(value: u8): int = int(value)

fun main: int {
    val big = 300
    val pixel = Pixel(big)
    val counter = Counter(u16(1))
    take(big) + take(Count(3)) + take(256) + take(-1) + int(counter.add(big)) + int(pixel.red)
}
