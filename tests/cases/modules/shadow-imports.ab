import "abla/math"
import "shadow-middle.ab"

// Shadows abla/math's `sin`; its `cos` stays visible.
fun sin(value: f64): f64 = 7.0

// The runtime's C externs (`write`, `malloc`) are private to it.
fun write(text: string): int = text.size
fun malloc(size: int): int = size + 1

// A method named like an imported shadowing function stays a method.
class Tripler(val base: int) {
    fun twice(): int = this.base * 100
}

fun main: int {
    var failures = 0
    if (twice(1) != 3) failures = failures + 1
    if (fromBase() != 10) failures = failures + 1
    if (fromMiddle() != 15) failures = failures + 1
    if (pairTwice() != 14) failures = failures + 1
    if (sin(0.0) != 7.0) failures = failures + 1
    if (cos(0.0) != 1.0) failures = failures + 1
    if (write("abc") != 3) failures = failures + 1
    if (malloc(1) != 2) failures = failures + 1
    if (Tripler(1).twice() != 100) failures = failures + 1
    if (failures == 0) 42 else failures
}
