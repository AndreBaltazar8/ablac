import "../../../src/backend/llvm/backend.ab"

fun nativeSymbolFor(source: string, name: string): string {
    val parsed = bootstrapParseStaged(source)
    val program = bootstrapLowerParsed(parsed, bootstrapAnalyzeParsed(parsed))
    var result = ""
    var function = 0
    while (function < program.functions.size) {
        if (program.functions[function].name == name) {
            result = bootstrapLlvmFunctionSymbol(program.functions[function])
        }
        function = function + 1
    }
    result
}

fun runtimeIdFor(source: string, name: string): int {
    val parsed = bootstrapParseStaged(source)
    val program = bootstrapLowerParsed(parsed, bootstrapAnalyzeParsed(parsed))
    val identities = bootstrapLlvmFunctionIdentities(program)
    if (identities.collisions != 0) return -1
    var index = 0
    while (index < program.functions.size) {
        if (program.functions[index].name == name) return identities.runtimeIds[index]
        index = index + 1
    }
    -1
}

fun main: int {
    val original = "fun stable(value: int): int = value + 1\nfun main: int = stable(41)\n"
    val inserted = "fun unrelated: int = 7\nfun stable(value: int): int = value + 1\nfun main: int = stable(41)\n"
    val changed = "fun stable(value: int): int = value + 2\nfun main: int = stable(40)\n"
    val first = nativeSymbolFor(original, "stable")
    val second = nativeSymbolFor(inserted, "stable")
    val third = nativeSymbolFor(changed, "stable")
    // A compact runtime-id collision must not change either function's id
    // when declarations move, nor change an unrelated function's original id.
    val pair = "fun probezpknqsaedjse(): int = 17\nfun probekaysvcnfznor(): int = 25\nfun reservedndtcmzw(): int = 9\nfun main: int = 42\n"
    val reversed = "fun probekaysvcnfznor(): int = 25\nfun probezpknqsaedjse(): int = 17\nfun reservedndtcmzw(): int = 9\nfun main: int = 42\n"
    val a = runtimeIdFor(pair, "probezpknqsaedjse")
    val b = runtimeIdFor(pair, "probekaysvcnfznor")
    if (a < 0 || b < 0 || a == b) return 2
    if (runtimeIdFor(pair, "reservedndtcmzw") != 126216852 || a == 126216852 || b == 126216852) return 5
    if (a != runtimeIdFor(reversed, "probezpknqsaedjse") ||
        b != runtimeIdFor(reversed, "probekaysvcnfznor")) return 3
    if (runtimeIdFor(pair, "main") != runtimeIdFor("fun main: int = 42\n", "main")) return 4
    if (first.size > 16 && first == second && first == third) 42 else 1
}
