// Compile-time parity of abla/crypto/mlkem: ML-KEM-768 keys from fixed seeds, an encapsulation with a fixed message and
// its decapsulation (and a tampered ciphertext's) print the same at run time and under `#`
// (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/mlkem"
import "abla/crypto/sha3"
import "abla/text"

fun main: int {
    val d = "d".repeat(32)
    val z = "z".repeat(32)
    val keys = mlkem768KeyGenFromSeeds(d, z)
    if (!keys.ok) {
        println("keygen error ${keys.error}")
        return 42
    }
    val encapsulationKey = mlkem768EncapsulationKey(keys.bytes)
    println("keys ${hexEncode(sha3256(keys.bytes))} ek ${hexEncode(sha3256(encapsulationKey))} valid ${mlkem768CheckDecapsulationKey(keys.bytes)}")
    val sealed = mlkem768EncapsulateWithMessage(encapsulationKey, "m".repeat(32))
    println("ciphertext ${hexEncode(sha3256(sealed.ciphertext))} secret ${hexEncode(sealed.sharedSecret)}")
    val opened = mlkem768Decapsulate(keys.bytes, sealed.ciphertext)
    println("decapsulated ${hexEncode(opened.bytes)}")
    val tampered = "x${sealed.ciphertext.slice(1, sealed.ciphertext.size)}"
    println("tampered ${hexEncode(mlkem768Decapsulate(keys.bytes, tampered).bytes)}")
    42
}
