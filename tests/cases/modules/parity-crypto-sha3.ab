// Compile-time parity of abla/crypto/sha3: SHA3-256, SHA3-512 and SHAKE over messages around the rate print the same
// digests at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/sha3"
import "abla/text"

fun main: int {
    for (message in ["", "abc", "x".repeat(135), "y".repeat(136), "z".repeat(137)]) {
        println("${message.size}: ${hexEncode(sha3256(message))} ${hexEncode(sha3512(message))}")
        println("   shake ${hexEncode(shake128(message, 40))} ${hexEncode(shake256(message, 70))}")
    }
    42
}
