compile fun compileChoice(value: int): int {
    var current = 0
    while (current < 5) {
        if (current == value) return current + 20
        current = current + 1
    }
    return 0
}

class Picker(val offset: int) {
    fun pick(value: int): int {
        if (value == 2) return value + this.offset
        return 0
    }
}

fun stopEarly(value: int) {
    if (value == 0) return
    value + 1
}

fun choose(value: int): int {
    if (value < 0) return 1

    var current = 0
    while (current < 10) {
        if (current == value) return current + 20
        current = current + 1
    }
    return 40
}

fun returnFromEveryIfBranch(value: bool): int {
    if (value) return 41 else return 42
}

fun main: int {
    val lambda = { value: int ->
        if (value == 3) return "lambda"
        "other"
    }
    stopEarly(0)
    val picker = Picker(40)
    if (
        #compileChoice(2) == 22 &&
        choose(-1) == 1 &&
        choose(1) == 21 &&
        choose(20) == 40 &&
        returnFromEveryIfBranch(false) == 42 &&
        picker.pick(2) == 42 &&
        lambda(3) == "lambda"
    ) 42 else 0
}
