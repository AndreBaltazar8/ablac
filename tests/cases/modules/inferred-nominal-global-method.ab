type Source = int
type Tracked = int

fun source(value: int): Source = Source(value)
fun Source.track(): Tracked = Tracked(this + 1)
fun Tracked.update(): Tracked = Tracked(this + 1)
fun Tracked.value(): int = this

val input = source(39)
var tracked = input.track()

fun main: int {
    tracked = tracked.update()
    tracked.value() + 1
}
