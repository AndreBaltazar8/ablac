import "abla/compiler/parser"

compile fun parseEarlyTyped(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    // Typed queries are deliberately unavailable during raw parsing. A
    // provider must retain the handle in a deferred extension request.
    typedCallTarget(expression)
    expression
}

#compilerRegisterSubparser("earlyTyped", parseEarlyTyped)

fun identity(value: int): int = value

fun main: int = $earlyTyped(identity(42))
