// What a function value or an interface method returns can be returned as it is:
// its type says it isn't a view of an argument.
class Row(var n: int)
val hooks: array<(Row, int) -> Row> = []
interface Sizer { fun size(c: Row): Row }
class Same : Sizer { fun size(c: Row): Row = Row(c.n) }
fun viaArray(c: Row, q: int): Row = hooks[0](c, q)
fun viaLocal(f: (Row, int) -> Row, c: Row, q: int): Row = f(c, q)
fun viaBranch(c: Row): Row {
    val chosen = if (c.n > 0) hooks else []
    if (chosen.size > 0) return chosen[0](c, 1)
    Row(9)
}
fun viaInterface(s: Sizer, c: Row): Row = s.size(c)
fun maker(c: Row, q: int): Row = Row(c.n + q)
fun main: int {
    hooks.append(maker)
    val r = Row(1)
    viaArray(r, 2).n + viaLocal(maker, r, 3).n + viaBranch(r).n + viaInterface(Same(), r).n + 32
}
