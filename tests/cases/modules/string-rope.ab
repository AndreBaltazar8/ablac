fun main: int {
    var text = ""
    var index = 0
    while (index < 100000) {
        text = "${text}x"
        index = index + 1
    }

    val original = "left"
    val alias = original
    val extended = "$original-right"
    if (
        text.size == 100000 &&
        text[0] == 120 &&
        text[99999] == 120 &&
        alias == "left" &&
        extended == "left-right"
    ) 42 else 0
}
