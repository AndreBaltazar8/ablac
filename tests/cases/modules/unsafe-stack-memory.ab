import "abla/unsafe/memory"

trusted fun clobberTemporaryStack(): void {
    val address = nativeStackAllocate(128)
    ablaUnsafeSetMemory(nativePointerFromAddress(address), 170, 128)
    return
}

trusted fun writeTemporaryValue(): int {
    val address = nativeStackAllocate(8)
    val source = nativeStackAllocate(4)
    val destination = nativeStackAllocate(4)
    clobberTemporaryStack()
    val pointer = nativePointerFromAddress(address)
    ablaUnsafeSetMemory(pointer, 0, 8)
    ablaUnsafeStoreU16(pointer, 4660)
    ablaUnsafeStoreU32(ablaUnsafePointerOffset(pointer, 4), 2309737967)
    ablaUnsafeStoreU32(nativePointerFromAddress(source), 305419896)
    ablaUnsafeSetMemory(nativePointerFromAddress(destination), 0, 4)
    ablaUnsafeCopyMemory(destination, source, 4)
    val copied = ablaUnsafeLoadU32(nativePointerFromAddress(destination))
    if (copied == 305419896) ablaUnsafeLoadU16(pointer) +
        ablaUnsafeLoadU32(ablaUnsafePointerOffset(pointer, 4))
    else 1
}

fun main: int = writeTemporaryValue()
