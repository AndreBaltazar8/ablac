class NullableBox(val value: int)

fun maybeBox(present: bool): NullableBox? =
    if (present) NullableBox(40) else null

fun readParameter(value: NullableBox?): int =
    if (value != null) value.value else 0

fun readNegated(value: NullableBox?): int =
    if (!(value == null)) value.value else 0

fun readReversed(value: NullableBox?): int =
    if (null != value) value.value else 0

fun readConjunction(value: NullableBox?): int =
    if (value != null && value.value == 40) value.value else 0

fun readDisjunction(value: NullableBox?): int =
    if (value == null || value.value != 40) 0 else value.value

compile fun stagedNullableRefinement(): int {
    val value = maybeBox(true)
    if (value != null && value.value == 40) value.value + 2 else 0
}

fun main: int {
    val value = maybeBox(true)
    val absent = maybeBox(false)
    val local = if (value != null) value.value else 0
    val missing = if (absent == null) 1 else absent.value
    if (local == 40 && missing == 1 && readParameter(value) == 40 &&
        readNegated(value) == 40 && readReversed(value) == 40 &&
        readConjunction(value) == 40 && readDisjunction(value) == 40 &&
        #stagedNullableRefinement() == 42) 42 else 0
}
