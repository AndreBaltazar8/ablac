import "abla/bytes"

fun main: int {
    val compileHash = #stableTextHash("Abla bytes")
    val buffer = bytes("Abla")
    buffer.appendText(" bytes")
    val appended = buffer.appendByte("!")
    val rejected = !buffer.appendByte("no")
    val view = buffer.slice(5, 10)
    val invalid = buffer.slice(-1, 2)
    // Numbers are written straight into the buffer; many small appends and a
    // write longer than a stage still read back in order.
    val numbers = byteBuffer()
    for (value in [0, -7, 1234567890, 9223372036854775807, -9223372036854775807 - 1]) {
        numbers.appendInt(value)
        numbers.appendText(" ")
    }
    numbers.appendFixed(15, 1)
    numbers.appendFixed(-5, 3)
    numbers.appendFixed(7, 0)
    val written = numbers.toText() ==
        "0 -7 1234567890 9223372036854775807 -9223372036854775808 1.5-0.0057"
    val many = byteBuffer()
    for (index in 0 until 3000) many.appendInt(index % 10)
    many.appendFixed(1, 5000)
    many.appendText("x")
    val long = many.size() == 8003 && many.toText().size == 8003 &&
        many.byteAt(2999) == 57 && many.byteAt(3000) == 48 &&
        many.byteAt(3001) == 46 && many.byteAt(8001) == 49 &&
        many.byteAt(8002) == 120 && many.byteAt(8003) == -1
    if (
        written && long &&
        appended && rejected &&
        buffer.size() == 11 &&
        buffer.byteAt(0) == 65 &&
        buffer.byteAt(99) == -1 &&
        buffer.toText() == "Abla bytes!" &&
        view.isValid() && view.size() == 5 &&
        view.toText() == "bytes" &&
        view.byteAt(4) == 115 &&
        !invalid.isValid() && invalid.toText() == "" &&
        compileHash == stableTextHash("Abla bytes") &&
        bytes("Abla bytes").stableHash() == compileHash
    ) 42 else 0
}
