import "abla/bytes"

fun main: int {
    val compileHash = #stableTextHash("Abla bytes")
    val buffer = bytes("Abla")
    buffer.appendText(" bytes")
    val appended = buffer.appendByte("!")
    val rejected = !buffer.appendByte("no")
    val view = buffer.slice(5, 10)
    val invalid = buffer.slice(-1, 2)
    if (
        appended && rejected &&
        buffer.size() == 11 &&
        buffer.byteAt(0) == 65 &&
        buffer.byteAt(99) == -1 &&
        buffer.toText() == "Abla bytes!" &&
        view.isValid() && view.size() == 5 &&
        view.toText() == "bytes" &&
        view.byteAt(4) == 115 &&
        !invalid.isValid() && invalid.toText() == "" &&
        compileHash == stableTextHash("Abla bytes") &&
        bytes("Abla bytes").stableHash() == compileHash
    ) 42 else 0
}
