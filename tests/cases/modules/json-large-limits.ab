// A caller can raise jsonParse's limits past the defaults for a large trusted
// document; only the depth stays bounded.
import "abla/bytes"
import "abla/json"

fun main: int {
    val count = 1200000
    val text = byteBuffer()
    text.appendText("[")
    for (i in 0 until count) {
        if (i > 0) text.appendText(",")
        text.appendInt(i % 10)
    }
    text.appendText("]")
    val source = text.toText()
    val large = JsonLimits(33554432, 8, 2000000, 1048576, 1000, true)
    val parsed = jsonParse(source, large)
    if (!parsed.succeeded || parsed.value.size() != count) return 1
    if (jsonParse(source).succeeded) return 2
    val deep = JsonLimits(1048576, 300, 100, 100, 10, true)
    val rejected = jsonParse("[]", deep)
    if (rejected.succeeded || rejected.error.code != "input_limit") return 3
    42
}
