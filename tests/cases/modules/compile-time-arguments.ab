import "abla/io"
import "abla/process/arguments"
// Compile-time code is a program the compiler runs with no arguments, so a staged
// read of the arguments sees none, as this program does when started without any.
fun describe(): string {
    var text = "${processArgumentCount()}"
    var index = 0
    while (index < processArgumentCount()) {
        text = "$text ${processArgument(index)}"
        index = index + 1
    }
    text
}
fun main: int {
    println("${describe()} | ${#describe()}")
    0
}
