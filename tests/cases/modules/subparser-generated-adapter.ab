#import("abla/compiler")
#import("abla/compiler/parser")

class ActionOwner(val base: int) {
    fun apply(value: int, bonus: int = 0): int = this.base + value + bonus
}

val actionOwner = ActionOwner(2)

compile fun finalizeAction(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val handle = typedCallTarget(expression)
    val argument = typedCallArgument(expression, 0)
    val owner = compilerFindClass("ActionOwner")
    val module = compilerGeneratedModule("example.action", expression)
    if (syntaxKind(expression) != "member.call" ||
        typedExpressionKind(expression) != "member.call" || handle < 0 ||
        typedExpressionType(expression) != "i64" ||
        typedCallReceiverType(expression) != "ActionOwner" ||
        typedCallArgumentCount(expression) != 1 ||
        typedCallArgumentType(expression, 0) != "i64" ||
        syntaxKind(argument) != "identifier" ||
        syntaxText(argument) != "delta" ||
        compilerFunctionName(handle) != "apply" ||
        compilerFunctionCanonicalIdentity(handle) != "ActionOwner.apply" ||
        compilerFunctionOwner(handle) != "ActionOwner" ||
        compilerFunctionParameterCount(handle) != 2 ||
        compilerFunctionParameterName(handle, 0) != "value" ||
        compilerFunctionParameterType(handle, 0) != "i64" ||
        compilerFunctionParameterName(handle, 1) != "bonus" ||
        compilerFunctionParameterType(handle, 1) != "i64" ||
        compilerFunctionResultType(handle) != "i64" ||
        compilerTypeName(compilerFunctionParameterTypeHandle(handle, 0)) !=
            "i64" ||
        compilerFunctionParameterTypeHandle(handle, 0) !=
            compilerFunctionResultTypeHandle(handle) ||
        compilerTypeName(typedCallParameterTypeHandle(expression, 0)) !=
            "i64" ||
        typedCallResultTypeHandle(expression) !=
            compilerFunctionResultTypeHandle(handle) ||
        typedCallArgumentParameter(expression, 0) != 0 ||
        typedCallArgumentConversion(expression, 0) != "none" ||
        typedCallInsertedDefaultCount(expression) != 1 ||
        typedCallParameterOwnership(expression, 0) != "parameter" ||
        typedCallIsCompileOnly(expression) ||
        typedCallIsTrusted(expression) ||
        compilerFunctionGenericSubstitutionCount(handle) != 0 ||
        compilerFunctionIsCompileOnly(handle) ||
        compilerFunctionIsTrusted(handle) ||
        compilerFunctionIsExternal(handle) || owner < 0 ||
        compilerClassFieldCount(owner) != 1 ||
        compilerClassFieldName(owner, 0) != "base" ||
        compilerClassFieldType(owner, 0) != "i64" ||
        compilerClassFieldIsMutable(owner, 0)) {
        val invalidNames: array<string> = ["value"]
        val invalidTypes: array<int> = [compilerFindType("MissingType")]
        compilerGeneratedFunction(
            module,
            "invalidAction",
            invalidNames,
            invalidTypes,
            compilerFindType("i64"),
            syntaxInteger(0)
        )
        module
    } else {
        val receiverArguments: array<SyntaxExpression> = [syntaxInteger(2)]
        val receiver = syntaxCall("ActionOwner", receiverArguments)
        val callArguments: array<SyntaxExpression> = [syntaxInteger(40)]
        val invocation = syntaxMethodCallTarget(handle, receiver, callArguments)
        val body = syntaxIf(
            syntaxBoolean(true),
            invocation,
            syntaxInteger(0)
        )
        val names: array<string> = []
        val types: array<int> = []
        val resultType = compilerFunctionResultTypeHandle(handle)
        compilerGeneratedFunction(
            module,
            "actionAdapter",
            names,
            types,
            resultType,
            body
        )
        compilerGeneratedValue(
            module,
            "emptyAction",
            compilerFindType("i64?"),
            syntaxNull()
        )
        val emptyArguments: array<SyntaxExpression> = []
        val exportedBody = compilerGeneratedDeclarationCall(
            module,
            0,
            emptyArguments
        )
        compilerGeneratedExportFunction(
            module,
            generatedName,
            names,
            types,
            resultType,
            exportedBody
        )
        if (compilerGeneratedDeclarationCount(module) != 3 ||
            compilerGeneratedDeclarationNamespace(module, 0) !=
                "example.action" ||
            compilerGeneratedDeclarationOriginBegin(module, 1) !=
                syntaxBegin(expression) ||
            compilerGeneratedDeclarationOriginEnd(module, 2) !=
                syntaxEnd(expression)) {
            val invalidNames: array<string> = []
            val invalidTypes: array<int> = []
            compilerGeneratedFunction(
                module,
                "invalidProvenance",
                invalidNames,
                invalidTypes,
                compilerFindType("MissingType"),
                syntaxInteger(0)
            )
        }
        module
    }
}

compile fun parseAction(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "example.action",
        "generatedActionAdapter",
        expression,
        finalizeAction
    )
    expression
}

compile fun parseActionValue(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    expression
}

#compilerRegisterSubparser("action", parseAction)
#compilerRegisterSubparser("actionValue", parseActionValue)

val frozenAction = #$actionValue(ActionOwner(2).apply(40))

fun invokeAction(owner: ActionOwner): int {
    val delta: int = 40
    val generatedMarker = $action(owner.apply(delta))
    generatedActionAdapter() + generatedMarker + frozenAction - 84
}

fun main: int = invokeAction(actionOwner)
