// A binding delegated to a library's transactional delegate is read only
// inside `atomic`, as one delegated to a TVar is.
class Counted(val cell: TVar<int>) : Transactional {
    fun getValue(): int = this.cell.getValue()

    fun setValue(value: int): void {
        this.cell.setValue(value)
    }
}

var total: int by Counted(TVar(0))

fun main: int = total
