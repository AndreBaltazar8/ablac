class TypedBox(val name: string, var value: int, val active: bool)

fun main(): int {
    val text = "typed"
    val numbers = [10, 20, 30]
    val flags = [true]
    val box = TypedBox("box", 1, true)
    box.value = 42
    if (text == "typed" && text.size == 5 && text[1] == 121 &&
        numbers.size == 3 && numbers[2] == 30 &&
        flags[0] &&
        box.name == "box" && box.value == 42 && box.active) return 42
    1
}
