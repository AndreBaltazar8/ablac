class TypedBox(val name: string, var value: int)

fun main(): int {
    val text = "typed"
    val numbers = [10, 20, 30]
    val box = TypedBox("box", 1)
    box.value = 42
    if (text == "typed" && text.size == 5 && text[1] == 121 &&
        numbers.size == 3 && numbers[2] == 30 &&
        box.name == "box" && box.value == 42) return 42
    1
}
