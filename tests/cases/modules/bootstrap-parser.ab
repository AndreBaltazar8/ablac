#import("../../../bootstrap/compiler/parser.ab")

fun main: int {
    val source =
        "fun add(a: int, b: int): int = a + b; class Box(val value: int) { fun get: int = value }; fun choose(value: int): int { when (value) { 1 -> return 41; else -> 42 } }"
    val parsed = bootstrapParse(source)
    if (
        parsed.errors == 0 &&
        parsed.declarations.size == 3 &&
        parsed.declarations[0].kind == "fun" &&
        parsed.declarations[0].name == "add" &&
        parsed.declarations[0].expression.kind == "+" &&
        parsed.declarations[0].expression.children.size == 2 &&
        parsed.declarations[1].kind == "class" &&
        parsed.declarations[1].name == "Box" &&
        parsed.declarations[2].expression.kind == "block" &&
        parsed.declarations[2].expression.children[0].kind == "when" &&
        parsed.declarations[2].expression.children[0].children[2].kind ==
            "return"
    ) 42 else 0
}
