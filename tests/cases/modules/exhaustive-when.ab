compile fun stagedChoice(flag: bool): int = when (flag) {
    true -> 40
    false -> 2
}

fun spinForever(): never {
    while (true) {}
}

fun runtimeChoice(flag: bool): int = when (flag) {
    true -> 42
    false -> spinForever()
}

fun labelled(value: int): string = when (value) {
    42 -> "answer"
    else -> "other"
}

fun main: int {
    val staged = #stagedChoice(true) + #stagedChoice(false)
    if (staged == 42 && runtimeChoice(true) == 42 &&
        labelled(42) == "answer") 42 else 0
}
