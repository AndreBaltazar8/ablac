import "abla/http/event"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/unsafe/memory"

// What a client thread and the server loop share: the listener's port,
// whether the client is done, and (backpressure) when the client may send and
// read.
resource class EventLink(val port: int, var done: bool, var send: bool, var read: bool)

fun eventLinkPort(var link: EventLink): int = link.port
fun eventLinkDone(var link: EventLink): bool = link.done
fun eventLinkSend(var link: EventLink): bool = link.send
fun eventLinkRead(var link: EventLink): bool = link.read
fun eventLinkFinish(var link: EventLink): bool {
    link.done = true
    true
}
fun eventLinkAllowSend(var link: EventLink): bool {
    link.send = true
    true
}
fun eventLinkAllowRead(var link: EventLink): bool {
    link.read = true
    true
}

fun eventLink(port: int): Mutex<EventLink> = Mutex(EventLink(port, false, false, false))

fun eventOne(request: HttpRequest): HttpResponse = httpText("first")
fun eventTwo(request: HttpRequest): HttpResponse = httpText("second")
fun eventBodyHandler(request: HttpRequest): HttpResponse = HttpResponse(
    200,
    [HttpHeader("Content-Type", "application/octet-stream")],
    request.body
)
fun eventLarge(request: HttpRequest): HttpResponse {
    var largePayload = "x"
    var largeIteration = 0
    while (largeIteration < 18) {
        largePayload = "$largePayload$largePayload"
        largeIteration = largeIteration + 1
    }
    httpText(largePayload)
}

fun eventBodyClient(link: Mutex<EventLink>): int {
    val bodyConnection = tcpConnectIpv4(
        "127.0.0.1", link.with(eventLinkPort), 1000
    )
    if (bodyConnection.descriptor < 0) {
        link.with(eventLinkFinish)
        return 1
    }
    var splitPayload = "0123456789abcdef"
    var splitIteration = 0
    while (splitIteration < 12) {
        splitPayload = "$splitPayload$splitPayload"
        splitIteration = splitIteration + 1
    }
    val splitHead = "POST /body HTTP/1.1\r\nHost: local\r\nContent-Length: ${splitPayload.size}\r\nConnection: close\r\n\r\n"
    val splitHeadSent = bodyConnection.write(splitHead)
    var bodyOffset = 0
    while (bodyOffset < splitPayload.size) {
        var bodyEnd = bodyOffset + 1024
        if (bodyEnd > splitPayload.size) bodyEnd = splitPayload.size
        val bodySent = bodyConnection.write(
            splitPayload.slice(bodyOffset, bodyEnd)
        )
        if (bodySent > 0) bodyOffset = bodyOffset + bodySent
        else bodyOffset = splitPayload.size
    }
    var response = ""
    var reading = splitHeadSent == splitHead.size
    while (reading) {
        val incoming = bodyConnection.readWithTimeoutResult(32768, 2000)
        if (incoming.hasData()) response = "${response}${incoming.bytes}"
        else reading = false
    }
    bodyConnection.close()
    link.with(eventLinkFinish)
    if (textContains(response, splitPayload)) 0 else 2
}

fun eventBodyAcrossReads(noEscape: bool = false): bool {
    val router = httpRouter()
    router.post("/body", eventBodyHandler)
    val server = if (noEscape) httpEventServerNoEscapeHandler(eventBodyHandler, ipv4Loopback(0))
        else httpEventServer(router, ipv4Loopback(0))
    val link = eventLink(server.listener.localPort())
    val forClient = link.clone()
    val client = thread { eventBodyClient(forClient) }
    while (!link.with(eventLinkDone)) server.step(100)
    val status = await client
    server.stop()
    server.drain()
    status == 0
}

fun textContains(input: string, wanted: string): bool {
    var found = false
    var index = 0
    while (!found && index + wanted.size <= input.size) {
        if (input.slice(index, index + wanted.size) == wanted) found = true
        index = index + 1
    }
    found
}

fun eventClient(link: Mutex<EventLink>): int {
    val connection = tcpConnectIpv4("127.0.0.1", link.with(eventLinkPort), 1000)
    if (connection.descriptor < 0) {
        link.with(eventLinkFinish)
        return 1
    }
    val requests = "GET /one HTTP/1.1\r\nHost: local\r\nConnection: keep-alive\r\n\r\nGET /two HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n"
    val sent = connection.write(requests)
    var response = ""
    var reading = sent == requests.size
    while (reading) {
        val incoming = connection.readWithTimeoutResult(65536, 2000)
        if (incoming.hasData()) response = "${response}${incoming.bytes}"
        else reading = false
    }
    connection.close()
    link.with(eventLinkFinish)
    if (textContains(response, "first") &&
        textContains(response, "second") &&
        textContains(response, "Connection: keep-alive") &&
        textContains(response, "Connection: close")) 0 else 2
}

fun reusableEventListeners(): bool {
    val first = tcpListenAddress(ipv4Loopback(0), 16, true)
    val port = first.localPort()
    val second = tcpListenAddress(ipv4Loopback(port), 16, true)
    val reusable = first.descriptor >= 0 && second.descriptor >= 0 &&
        port > 0 && second.localPort() == port
    first.close()
    second.close()
    reusable
}

fun eventTestSendBuffer(descriptor: int, bytes: int): bool {
    val buffer = nativeByteBuffer(4)
    linuxNetStoreU32(buffer, 0, bytes)
    val status = linuxSyscall5(
        54, descriptor, 1, 7,
        nativePointerAddress(buffer.address), 4
    )
    buffer.close()
    status == 0
}

fun eventBackpressureClient(link: Mutex<EventLink>): int {
    val connection = tcpConnectIpv4(
        "127.0.0.1", link.with(eventLinkPort), 1000
    )
    if (connection.descriptor < 0) {
        link.with(eventLinkFinish)
        return 1
    }
    while (!link.with(eventLinkSend)) linuxSleep(1)
    val request = "GET /large HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n"
    val sent = connection.write(request)
    while (!link.with(eventLinkRead)) linuxSleep(1)
    var response = ""
    var reading = sent == request.size
    while (reading) {
        val incoming = connection.readWithTimeoutResult(65536, 2000)
        if (incoming.hasData()) response = "${response}${incoming.bytes}"
        else reading = false
    }
    connection.close()
    link.with(eventLinkFinish)
    if (response.size >= 262144 &&
        textContains(response, "Connection: close")) 0 else 2
}

fun eventBackpressure(noEscape: bool = false): bool {
    val router = httpRouter()
    router.get("/large", eventLarge)
    val server = if (noEscape) httpEventServerNoEscapeHandler(eventLarge, ipv4Loopback(0))
        else httpEventServer(router, ipv4Loopback(0))
    val link = eventLink(server.listener.localPort())
    val forClient = link.clone()
    val client = thread { eventBackpressureClient(forClient) }
    while (server.activeConnections() == 0) server.step(100)
    val sendBufferSet = eventTestSendBuffer(server.descriptors[0], 4096)
    link.with(eventLinkAllowSend)
    server.step(1000)
    val writeInterestEnabled = server.writeWatching[0] &&
        server.outputOffsets[0] > 0 && server.outputs[0] != ""
    link.with(eventLinkAllowRead)
    while (!link.with(eventLinkDone)) server.step(100)
    val status = await client
    server.stop()
    server.drain()
    val succeeded = sendBufferSet && writeInterestEnabled && status == 0 &&
        server.activeConnections() == 0
    if (!succeeded) linuxWriteStandardError("backpressure noEscape=$noEscape send=$sendBufferSet interest=$writeInterestEnabled status=$status active=${server.activeConnections()}\n")
    succeeded
}

fun eventResponseFraming(): bool {
    val get = httpParseRequest("GET / HTTP/1.1\r\nHost: local\r\n\r\n")
    val head = httpParseRequest("HEAD / HTTP/1.1\r\nHost: local\r\n\r\n")
    val response = HttpResponse(200, [], "abc")
    val expected = "HTTP/1.1 200 OK\r\nConnection: keep-alive\r\nContent-Length: 3\r\n\r\n"
    if (httpEventResponse(get, response, true, 1048576) != "${expected}abc") return false
    if (httpEventResponse(head, response, true, 1048576) != expected) return false
    val custom = HttpResponse(201, [
        HttpHeader("cOnNeCtIoN", "discarded"),
        HttpHeader("content-length", "3"),
        HttpHeader("X-Test", "z")
    ], "abc")
    if (httpEventResponse(get, custom, false, 1048576) !=
        "HTTP/1.1 201 Created\r\ncontent-length: 3\r\nX-Test: z\r\nConnection: close\r\n\r\nabc") return false
    if (httpEventResponse(get, HttpResponse(101, [], ""), false, 1048576) !=
        "HTTP/1.1 101 Switching Protocols\r\nConnection: close\r\n\r\n") return false
    true
}

// What a connection does with the ways a request can end or be framed: the answer, and whether the server then
// closed the connection (EOF) or left it open (a read that timed out).
class FramingOutcome(val response: string, val closed: bool)

fun framingExchange(port: int, bytes: string, waitMilliseconds: int): FramingOutcome {
    val connection = tcpConnectIpv4("127.0.0.1", port, 1000)
    var response = ""
    var closed = false
    if (connection.descriptor >= 0 && connection.write(bytes) == bytes.size) {
        var reading = true
        while (reading) {
            val incoming = connection.readWithTimeoutResult(65536, waitMilliseconds)
            if (incoming.hasData()) response = "${response}${incoming.bytes}"
            else {
                closed = incoming.reachedEof()
                reading = false
            }
        }
        connection.close()
    }
    FramingOutcome(response, closed)
}

fun textCount(input: string, wanted: string): int {
    var count = 0
    var index = 0
    while (index + wanted.size <= input.size) {
        if (input.slice(index, index + wanted.size) == wanted) {
            count = count + 1
            index = index + wanted.size
        } else index = index + 1
    }
    count
}

// Returns 0, or the number of the first case that went wrong.
fun framingClient(link: Mutex<EventLink>): int {
    val port = link.with(eventLinkPort)
    val get = "GET /one HTTP/1.1\r\nHost: local\r\n\r\n"
    var failed = 0
    // 1. HTTP/1.0 closes after its answer; so does Connection: close on 1.1.
    val old = framingExchange(port, "GET /one HTTP/1.0\r\nHost: local\r\n\r\n", 2000)
    if (failed == 0 && !(textContains(old.response, "first") && textContains(old.response, "Connection: close") && old.closed)) failed = 1
    val close = framingExchange(port, "GET /one HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n", 2000)
    if (failed == 0 && !(textContains(close.response, "first") && close.closed)) failed = 2
    // 2. HTTP/1.1 stays open after an answer (a short read finds it open) and an idle one is closed by the server.
    val open = framingExchange(port, get, 100)
    if (failed == 0 && !(textContains(open.response, "first") && textContains(open.response, "keep-alive") && !open.closed)) failed = 3
    val idle = framingExchange(port, get, 3000)
    if (failed == 0 && !(textContains(idle.response, "first") && idle.closed)) failed = 4
    // 3. The request cap (three a connection): the third answer says close, a fourth gets none.
    val capped = framingExchange(port, "${get}${get}${get}${get}", 2000)
    if (failed == 0 && !(textCount(capped.response, "first") == 3 && textCount(capped.response, "Connection: close") == 1 && capped.closed)) failed = 5
    // 4. A body longer than declared: the extra bytes are the next request, never part of this one's body.
    val extra = framingExchange(port, "POST /body HTTP/1.1\r\nHost: local\r\nContent-Length: 3\r\n\r\nabc${get}", 150)
    if (failed == 0 && !(textContains(extra.response, "abc") && textContains(extra.response, "first") && !textContains(extra.response, "abcGET"))) failed = 6
    //    ... and when the extra bytes are not a request, they are refused and the connection closes.
    val junk = framingExchange(port, "POST /body HTTP/1.1\r\nHost: local\r\nContent-Length: 3\r\n\r\nabcjunk\r\n\r\n", 2000)
    if (failed == 0 && !(textContains(junk.response, "abc") && textContains(junk.response, " 400 ") && junk.closed)) failed = 7
    // 5. A body shorter than declared waits for the rest, and the idle timeout closes it with no answer.
    val shorter = framingExchange(port, "POST /body HTTP/1.1\r\nHost: local\r\nContent-Length: 10\r\n\r\nabc", 3000)
    if (failed == 0 && !(shorter.response == "" && shorter.closed)) failed = 8
    // 6. Content-Length together with chunked framing is refused (request smuggling), and no handler runs.
    val both = framingExchange(port, "POST /body HTTP/1.1\r\nHost: local\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n", 2000)
    if (failed == 0 && !(!textContains(both.response, "abc") && textContains(both.response, " 400 ") && both.closed)) failed = 9
    // 7. A declared length over the body limit is refused without reading it.
    val huge = framingExchange(port, "POST /body HTTP/1.1\r\nHost: local\r\nContent-Length: 99999999\r\n\r\nabc", 2000)
    if (failed == 0 && !(!textContains(huge.response, "abc") && textContains(huge.response, " 400 ") && huge.closed)) failed = 10
    link.with(eventLinkFinish)
    failed
}

fun eventFraming(): int {
    val router = httpRouter()
    router.get("/one", eventOne)
    router.post("/body", eventBodyHandler)
    val limits = HttpEventServerOptions(16, 65536, 65536, 2097152, 3, 400, 256, 1000)
    val server = httpEventServer(router, ipv4Loopback(0), limits)
    val link = eventLink(server.listener.localPort())
    val forClient = link.clone()
    val client = thread { framingClient(forClient) }
    while (!link.with(eventLinkDone)) server.step(50)
    val status = await client
    server.stop()
    server.drain()
    status
}

fun main: int {
    if (!eventResponseFraming()) return 9
    val oversizedHead = "GET / HTTP/1.1\r\nHost: local\r\n\r\n"
    if (httpEventFrame(oversizedHead, 8, 100).length != -1 ||
        httpEventRequestLength(oversizedHead, 8, 100) != -1) return 8
    val reusable = reusableEventListeners()
    val router = httpRouter()
    router.get("/one", eventOne)
    router.get("/two", eventTwo)
    router.post("/body", eventBodyHandler)
    val server = httpEventServer(router, ipv4Loopback(0))
    val link = eventLink(server.listener.localPort())
    val forClient = link.clone()
    val client = thread { eventClient(forClient) }
    while (!link.with(eventLinkDone)) server.step(100)
    val status = await client
    server.stop()
    val drained = server.drain()
    if (!reusable) 1
    else if (status != 0) 2
    else if (drained != 0 || !server.stopped || server.activeConnections() != 0) 3
    else if (!eventBackpressure()) 4
    else if (!eventBodyAcrossReads()) 5
    else if (!eventBackpressure(true)) 6
    else if (!eventBodyAcrossReads(true)) 7
    else {
        val framing = eventFraming()
        if (framing != 0) 100 + framing else 42
    }
}
