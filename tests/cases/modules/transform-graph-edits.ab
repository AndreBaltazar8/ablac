// A transform's edit to the standard library holds for the whole program,
// natively and under `#`.
import "abla/compiler"
import "abla/math"

compile fun edit(): void {
    compiler.replaceFunctionBody(compiler.findFunction("clamp"), "value + minimum + maximum")
    return
}

#compiler.transform(edit)

fun main: int = if (clamp(2, 10, 30) == 42 && clamp(0, 1, 1) == 2) 42 else 1
