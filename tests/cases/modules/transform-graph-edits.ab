// A transform's edit to another of the program's modules holds for the whole
// program, natively and under `#`.
import "abla/compiler"
import "./graph-edits-library.ab"

compile fun edit(): void {
    compiler.replaceFunctionBody(compiler.findFunction("libraryAnswer"), "41")
    return
}

#compiler.transform(edit)

fun main: int = if (libraryAnswer() == 41) 42 else 1
