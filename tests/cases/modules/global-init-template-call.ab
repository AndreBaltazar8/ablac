// A global initialized by a function that interpolates a float reads
// abla/float/text's tables through the f64Text call lowering inserts into that
// function: the tables initialize before the global.
import "abla/float/text"

fun half(value: f64): string = "half ${value / 2.0}"

val HALF = half(0.5)

fun main: int = if (HALF == "half 0.25") 42 else 1
