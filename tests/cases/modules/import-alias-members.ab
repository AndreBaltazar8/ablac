import "abla/io"
import "import-alias-members-lib.ab" as U
import "import-alias-members-plain.ab"

// Through an alias, a field, a method, a parameter (also as a named argument),
// a local and a lambda's parameter that share a name with a top-level
// declaration of their module still mean themselves.
fun summary(): string {
    val item = U.Item(1, 2, 6)
    val box = U.Box(2)
    "${item.slot} ${item.code} ${item.level} ${item.twice()} ${item.levelHere()} " +
        "${item.extra()} ${item.viaExtension()} ${box.slot()} ${box.other()} " +
        "${box.third()} ${U.withParameter(level = 4)} ${U.named()} ${U.withLocal()} " +
        "${U.withLambda()} ${U.topLevel()} ${U.level} ${U.slot(1)} ${gauges()}"
}

fun main: int {
    val atRunTime = summary()
    val atCompileTime = #summary()
    println(atRunTime)
    if (atRunTime == atCompileTime &&
        atRunTime == "1 2 6 2 6 10 10 42 44 44 8 9 3 11 7 5 2 8 14 6") 42 else 1
}
