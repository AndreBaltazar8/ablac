// `compiler.transform` is the compiler's, whatever a class's `transform` does.
import "abla/fs"
import "abla/compiler"
class Page(val path: string) {
    fun op(text: string): void { Path(this.path).appendText(text); return }
    fun transform(n: int): void { this.op("$n"); return }
}
compile fun noChanges(): void { return }
#compiler.transform(noChanges)
fun main: int = 42
