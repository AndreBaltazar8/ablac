#import("abla/compiler/parser")

compile fun parseBox(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "[")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, "]")
    expression
}

#compilerRegisterSubparser("box", parseBox)

fun main: int {
    val frozen = #$box[20 + 1]
    frozen + $box[20 + 1]
}
