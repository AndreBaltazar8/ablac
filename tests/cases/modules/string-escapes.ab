import "abla/io"

fun bytes(text: string): string {
    var result = ""
    var index = 0
    while (index < text.size) {
        result = if (index == 0) "${text[index]}" else "$result ${text[index]}"
        index = index + 1
    }
    result
}

fun main {
    println(bytes("\0|\b|\x41|\xff"))
    println(bytes("\u0001\u0041\u00e9\u20ac"))
    println(bytes("\u{41}\u{e9}\u{1F600}\u{10FFFF}"))
    println("\"\'\\\$ \n\t|")
}
