// abla/text's string helpers, at run time and at compile time.
import "abla/io"
import "abla/text"

compile fun stagedHelpers(): string =
    textJoin("  b, a ,c ".trim().split(","), "|").replace(" ", "").uppercase()

val STAGED = #stagedHelpers()

fun check(failures: int, ok: bool, label: string): int {
    if (!ok) println("FAIL $label")
    if (ok) failures else failures + 1
}

fun main: int {
    var failures = 0
    failures = check(failures, "rocket".startsWith("roc"), "startsWith")
    failures = check(failures, !"roc".startsWith("rocket"), "startsWith longer")
    failures = check(failures, "rocket".startsWith(""), "startsWith empty")
    failures = check(failures, "rocket".endsWith("ket"), "endsWith")
    failures = check(failures, !"rocket".endsWith("roc"), "endsWith miss")
    failures = check(failures, "a.b.c".contains(".b."), "contains")
    failures = check(failures, !"abc".contains("d"), "contains miss")
    failures = check(failures, "a.b.c".indexOf(".") == 1, "indexOf")
    failures = check(failures, "a.b.c".indexOf(".", 2) == 3, "indexOf from")
    failures = check(failures, "a.b.c".indexOf(".", 9) == -1, "indexOf past")
    failures = check(failures, "a.b.c".lastIndexOf(".") == 3, "lastIndexOf")
    failures = check(failures, "abc".lastIndexOf("x") == -1, "lastIndexOf miss")
    val pieces = "a,,b,".split(",")
    failures = check(failures, pieces.size == 4 && pieces[0] == "a" &&
        pieces[1] == "" && pieces[2] == "b" && pieces[3] == "", "split")
    failures = check(failures, "abc".split("").size == 1, "split empty")
    failures = check(failures, "x--y".split("--")[1] == "y", "split long")
    failures = check(failures, textJoin(["a", "b", "c"], ", ") == "a, b, c",
        "join")
    failures = check(failures, textJoin([], ",") == "", "join empty")
    failures = check(failures, " \t x y \n".trim() == "x y", "trim")
    failures = check(failures, "  x ".trimStart() == "x ", "trimStart")
    failures = check(failures, "  x ".trimEnd() == "  x", "trimEnd")
    failures = check(failures, "   ".trim() == "", "trim blank")
    failures = check(failures, "a-b-c".replace("-", "+") == "a+b+c", "replace")
    failures = check(failures, "aaa".replace("aa", "b") == "ba",
        "replace left to right")
    failures = check(failures, "abc".replace("", "x") == "abc", "replace empty")
    failures = check(failures, "Mixed 9é".uppercase() == "MIXED 9é",
        "uppercase")
    failures = check(failures, "MiXeD".lowercase() == "mixed", "lowercase")
    failures = check(failures, "ab".repeat(3) == "ababab", "repeat")
    failures = check(failures, "ab".repeat(0) == "", "repeat zero")
    failures = check(failures, "7".padStart(3, "0") == "007", "padStart")
    failures = check(failures, "7".padEnd(4, "ab") == "7aba", "padEnd")
    failures = check(failures, "long".padStart(2) == "long", "pad shorter")
    failures = check(failures, STAGED == "B|A|C", "compile time")
    if (failures == 0) 42 else failures
}
