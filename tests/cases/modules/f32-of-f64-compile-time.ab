// f32(...) takes an f32, not an f64 expression: analysis rejects it as it does in a plain function
// (f32-of-f64-native.ab), so no division inside it reaches the evaluator.
compile fun f(): any {
    val zero: f64 = 0.0
    val singleNan: any = f32(zero / zero)
    singleNan
}
fun main: int = if (#f() == #f()) 1 else 0
