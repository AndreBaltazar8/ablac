// `place op= value` is `place = place op value`, for + - * / % on a local,
// a field, an index and an operator-function type.
class Counter(var n: int, var total: f64)
class V(val x: int)
operator fun V.plus(other: V): V = V(this.x + other.x)

fun main: int {
    var i = 10
    i += 5
    i -= 3
    i *= 4
    i /= 6
    i %= 5
    if (i != 3) return 1
    val c = Counter(1, 0.5)
    c.n += 41
    c.total *= 3.0
    if (c.n != 42 || c.total != 1.5) return 2
    val xs = [1, 2, 3]
    var k = 1
    xs[k] += 40
    xs[0] -= 1
    if (xs[1] != 42 || xs[0] != 0) return 3
    var v = V(2)
    v += V(40)
    if (v.x != 42) return 4
    var s = 0
    for (j in 1..4) s += j
    if (s != 10) return 5
    42
}
