// An annotation goes before or after the contextual `operator`.
class V(val n: int)
operator @inline fun V.plus(o: V): V = V(this.n + o.n)
@inline operator fun V.minus(o: V): V = V(this.n - o.n)
class W(val n: int) {
    operator @inline fun plus(o: W): W = W(this.n + o.n)
}
fun main: int = (V(40) + V(3) - V(1)).n + (W(0) + W(0)).n
