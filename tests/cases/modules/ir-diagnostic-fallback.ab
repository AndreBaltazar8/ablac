import "../../../src/ir.ab"

fun main: int {
    val parameters: array<string> = []
    val instructions: array<BootstrapInstruction> = []
    val blocks: array<BootstrapIrBlock> = []
    val locals: array<BootstrapIrLocal> = []
    val function = BootstrapIrFunction(
        "brokenGeneratedFunction",
        parameters,
        instructions,
        -1,
        blocks,
        locals,
        [],
        [],
        "unknown",
        false,
        false,
        2
    )
    val functions: array<BootstrapIrFunction> = [function]
    val classes: array<BootstrapIrClass> = []
    val natives: array<BootstrapIrNative> = []
    val inputPaths: array<string> = []
    val inputContents: array<string> = []
    val program = BootstrapIrProgram(
        instructions,
        functions,
        classes,
        natives,
        [],
        [],
        [],
        inputPaths,
        inputContents,
        3
    )
    val diagnostics = bootstrapIrVerificationDiagnostics(
        program,
        bootstrapParse(""),
        0,
        4
    )
    if (bootstrapTextContains(
            diagnostics,
            "error[E_IR_FUNCTION_VERIFICATION]: function `brokenGeneratedFunction`"
        ) && bootstrapTextContains(
            diagnostics,
            "error[E_IR_UNCLASSIFIED]:"
        ) && bootstrapTextContains(
            diagnostics,
            "error[E_IR_EMISSION]:"
        ) && bootstrapPrimaryDiagnosticCount(diagnostics) == 4) 42
    else 1
}
