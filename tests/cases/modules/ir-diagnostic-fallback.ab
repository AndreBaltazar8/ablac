import "../../../src/ir.ab"
import "../../../src/parser.ab"

fun main: int {
    val parameters: array<string> = []
    val instructions: array<BootstrapInstruction> = []
    val valid = bootstrapFinalizeIrFunction("validFunction", parameters, [], -1)
    val invalid = bootstrapFinalizeIrFunction(
        "brokenGeneratedFunction", parameters,
        [BootstrapInstruction("jump", -1, -1, -1, "", 99, -1, [], [], -1)], -1
    )
    if (valid.verificationErrors != 0 || invalid.verificationErrors != 2) return 1
    val functions: array<BootstrapIrFunction> = [valid, invalid]
    val classes: array<BootstrapIrClass> = []
    val natives: array<BootstrapIrNative> = []
    val inputPaths: array<string> = []
    val inputContents: array<string> = []
    val program = BootstrapIrProgram(
        instructions,
        functions,
        classes,
        natives,
        [],
        [],
        [],
        inputPaths,
        inputContents,
        3,
        bootstrapIrLookupOf(instructions, [])
    )
    val declaration = BootstrapDeclaration(
        "fun", "brokenGeneratedFunction", 0, 1,
        BootstrapExpression("delegate.assign", "", 0, 1, []),
        [], [], "void", [], [], "", [], "", false, false, false,
        "test-generated", 31, 48, [], [], [], [], "test.ab"
    )
    val parsed = BootstrapParseResult([declaration], [], 0, 0, [], [], "")
    val diagnostics = bootstrapIrVerificationDiagnostics(program, parsed, 0, 4)
    val origin = "context[generated-namespace]: test-generated\nsource[generated-origin]:test-generated:31:48\n"
    val expected =
        "error[E_DELEGATE_BORROW_CONFLICT]: delegate replacement in `brokenGeneratedFunction` conflicts with a live projected view\n" +
        origin +
        "error[E_IR_FUNCTION_VERIFICATION]: function `brokenGeneratedFunction` violated a typed IR invariant (failure 2 of 2)\n" +
        origin +
        "error[E_IR_UNCLASSIFIED]: typed IR lowering failed without a named function invariant (failure 1 of 1)\n" +
        "error[E_IR_EMISSION]: LLVM IR emission or module verification failed (failure 4 of 4)\n"
    if (diagnostics == expected) 42 else 1
}
