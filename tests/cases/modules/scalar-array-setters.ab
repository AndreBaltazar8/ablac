import "abla/float"
import "abla/memory"

// Force the checked boxed-storage path without changing the statically typed view.
trusted fun scalarArrayForceBox(values: any): void {
    __ablaRuntimeArraySet(values, __ablaRuntimeI64(0), __ablaRuntimeNull())
    return
}
trusted fun scalarArrayWord(values: any): int =
    __ablaRuntimeAsI64(__ablaRuntimeArrayGet(values, __ablaRuntimeI64(1)))
trusted fun scalarArrayBool(values: any): bool =
    __ablaRuntimeAsBool(__ablaRuntimeArrayGet(values, __ablaRuntimeI64(1)))

fun scalarI64Store(var values: array<int>, value: int): int { values[1] = value }
fun scalarBoolStore(var values: array<bool>, value: bool): bool { values[1] = value }
fun scalarF64Store(var values: array<f64>, value: f64): f64 { values[1] = value }
fun scalarF32Store(var values: array<f32>, value: f32): f32 { values[1] = value }

fun scalarI64Case(boxed: bool): bool {
    val values = [0, 0]
    if (boxed) scalarArrayForceBox(values)
    val edges = [0, 1, -1, -9223372036854775808, 9223372036854775807,
        4611686018427387904, -4611686018427387904]
    for (value in edges) {
        if (scalarI64Store(values, value) != value || values[1] != value ||
            scalarArrayWord(values) != value) return false
        memoryCollect()
        if (values[1] != value) return false
    }
    var seed = 17
    var round = 0
    while (round < 256) {
        seed = seed * 6364136223846793005 + 1442695040888963407
        values[1] = seed
        if (values[1] != seed || scalarArrayWord(values) != seed) return false
        round += 1
    }
    true
}

fun scalarBoolCase(boxed: bool): bool {
    val values = [false, false]
    if (boxed) scalarArrayForceBox(values)
    for (value in [true, false, false, true]) {
        if (scalarBoolStore(values, value) != value || values[1] != value ||
            scalarArrayBool(values) != value) return false
        memoryCollect()
        if (values[1] != value) return false
    }
    true
}

fun scalarF64Case(boxed: bool): bool {
    val values: array<f64> = [0.0, 0.0]
    if (boxed) scalarArrayForceBox(values)
    // Signed zeros, subnormals, infinities, finite bounds, and quiet/signaling NaN payloads.
    val edges = [0, -9223372036854775808, 1, -9223372036854775807,
        0x000fffffffffffff, 0x0010000000000000, 0x7fefffffffffffff,
        0x7ff0000000000000, -4503599627370496,
        0x7ff8000000000001, 0x7ff0000000000001, -2251799813685247]
    for (bits in edges) {
        val value = f64FromBits(bits)
        if (f64ToBits(scalarF64Store(values, value)) != bits ||
            f64ToBits(values[1]) != bits || scalarArrayWord(values) != bits) return false
        memoryCollect()
        if (f64ToBits(values[1]) != bits) return false
    }
    true
}

fun scalarF32Case(boxed: bool): bool {
    val values: array<f32> = [0.0, 0.0]
    if (boxed) scalarArrayForceBox(values)
    val edges = [0, 0x80000000, 1, 0x80000001, 0x007fffff, 0x00800000,
        0x7f7fffff, 0x7f800000, 0xff800000, 0x7fc00001, 0x7f800001]
    for (bits in edges) {
        val value = f32FromBits(u32(bits))
        if (int(f32ToBits(scalarF32Store(values, value))) != bits ||
            int(f32ToBits(values[1])) != bits || scalarArrayWord(values) != bits) return false
        memoryCollect()
        if (int(f32ToBits(values[1])) != bits) return false
    }
    true
}

fun main: int {
    if (scalarI64Case(false) && scalarI64Case(true) &&
        scalarBoolCase(false) && scalarBoolCase(true) &&
        scalarF64Case(false) && scalarF64Case(true) &&
        scalarF32Case(false) && scalarF32Case(true)) 42 else 1
}
