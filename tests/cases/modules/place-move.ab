resource class Ticket(val value: int)

class TicketBox(val ticket: Ticket, val label: int)
class MutableTicketBox(var ticket: Ticket, val label: int)
class TicketShelf(val boxes: array<MutableTicketBox>, val marker: int)

fun inspect(ticket: Ticket): int = ticket.value

fun inspectBox(box: MutableTicketBox): int = box.ticket.value + box.label

compile fun stagedReinitialize(): int {
    val box = MutableTicketBox(Ticket(39), 1)
    val ticket = move(box.ticket)
    box.ticket = Ticket(1)
    inspect(ticket) + inspectBox(box) + 1
}

compile fun stagedPlaceMove(): int {
    var box = TicketBox(Ticket(39), 1)
    val ticket = move(box.ticket)
    val retainedLabel = box.label
    box = TicketBox(Ticket(2), 2)
    inspect(ticket) + retainedLabel + inspect(box.ticket)
}

fun fieldMove(): int {
    var box = TicketBox(Ticket(39), 1)
    val ticket = move(box.ticket)
    val retainedLabel = box.label
    box = TicketBox(Ticket(2), 2)
    inspect(ticket) + retainedLabel + inspect(box.ticket)
}

fun indexMove(): int {
    val tickets = [Ticket(39), Ticket(1)]
    val ticket = move(tickets[0])
    inspect(ticket) + inspect(tickets[1]) + 2
}

fun fieldReinitialize(): int {
    val box = MutableTicketBox(Ticket(39), 1)
    val ticket = move(box.ticket)
    box.ticket = Ticket(1)
    inspect(ticket) + inspectBox(box) + 1
}

fun indexReinitialize(): int {
    val tickets = [Ticket(40)]
    val ticket = move(tickets[0])
    tickets[0] = Ticket(1)
    inspect(ticket) + inspect(tickets[0]) + 1
}

fun nestedConstantPlaceMove(): int {
    val shelf = TicketShelf(
        [
            MutableTicketBox(Ticket(38), 1),
            MutableTicketBox(Ticket(1), 0)
        ],
        2
    )
    val ticket = move(shelf.boxes[0].ticket)
    ticket.value + shelf.boxes[0].label +
        shelf.boxes[1].ticket.value + shelf.marker
}

compile fun stagedNestedDynamicPlaceMove(index: int): int {
    val shelf = TicketShelf(
        [MutableTicketBox(Ticket(39), 1)],
        2
    )
    val ticket = move(shelf.boxes[index].ticket)
    ticket.value + shelf.boxes[index].label + shelf.marker
}

fun nestedDynamicPlaceMove(index: int): int {
    val shelf = TicketShelf(
        [MutableTicketBox(Ticket(39), 1)],
        2
    )
    val ticket = move(shelf.boxes[index].ticket)
    ticket.value + shelf.boxes[index].label + shelf.marker
}

fun main: int {
    if (#stagedPlaceMove() == 42 && #stagedReinitialize() == 42 &&
        #stagedNestedDynamicPlaceMove(0) == 42 &&
        fieldMove() == 42 && indexMove() == 42 &&
        fieldReinitialize() == 42 && indexReinitialize() == 42 &&
        nestedConstantPlaceMove() == 42 &&
        nestedDynamicPlaceMove(0) == 42) 42 else 0
}
