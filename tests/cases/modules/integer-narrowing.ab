// An int reaches a narrower integer parameter only through an explicit
// conversion; an integer literal that fits needs none.
type Led = int

class Pixel(val red: u8, val alpha: u8)
class Counter(var count: u16) {
    fun add(step: u16): u16 {
        this.count = this.count + step
        this.count
    }
}

fun take(value: u8): int = int(value)
fun offset(value: i8): int = int(value)

fun main: int {
    val big = 300
    val led = Led(300)
    val pixel = Pixel(255, u8(big))
    val counter = Counter(65535)
    counter.add(1)
    if (take(u8(big)) == 44 && take(u8(led)) == 44 && take(200) == 200 && offset(-128) == -128 &&
        int(pixel.alpha) == 44 && int(pixel.red) == 255 &&
        int(counter.count) == 0) 42 else 1
}
