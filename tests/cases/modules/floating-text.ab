// f64Text (abla/float/text) writes what JavaScript's Number#toString writes: the
// shortest digits that read back exactly, in the same notation. Exits 42 when every
// case matches.

import "abla/io"
import "abla/float"
import "abla/float/text"

val BITS: array<int> = [4591870180066957722, 4599976659396224614, 4609434218613702656, 4519690376349541460, 4728057454355546112, 4599676419421066581, 4604180019048437077, 4589708452245819884, 4608128174721765213, 4921056587992461136, 4906019910204099648, 4907423718797849648, 4636737291354636288, -4625196817309499392, 4606281698874543308, 1, 4503599627370496, 4503599627370495, 9218868437227405311, 4845873199050653696, 4616583683022153318, 4517329193108106637, 4502148214488346440, 4602678819172646912, 1, 9214364837600034816, 4503599627370496, 4950912855330343670, 4512825593480736141, 4519690376349541460, -9223372036854775808, 0, 4614256650576692846, 4589708452245819883, -9104749988965452967, 4845873199050653696, 4877398396442247168]
val TEXTS: array<string> = ["0.1", "0.35", "1.5", "0.0000015", "123456789.125", "0.3333333333333333", "0.6666666666666666", "0.07", "1.2100000000000002", "1e+21", "100000000000000000000", "123000000000000000000", "100", "-0.25", "0.8999999999999999", "5e-324", "2.2250738585072014e-308", "2.225073858507201e-308", "1.7976931348623157e+308", "9007199254740992", "4.35", "0.000001", "1e-7", "0.5", "5e-324", "8.98846567431158e+307", "2.2250738585072014e-308", "1e+23", "5e-7", "0.0000015", "0", "0", "3.14159", "0.06999999999999999", "-1e-300", "9007199254740992", "1152921504606847000"]

fun main: int {
    var wrong = 0
    for (i in 0 until BITS.size) {
        val got = f64Text(f64FromBits(BITS[i]))
        if (got != TEXTS[i]) {
            println("${TEXTS[i]}: got $got")
            wrong += 1
        }
    }
    if (f64Text(0.0 / 0.0) != "NaN" || f64Text(1.0 / 0.0) != "Infinity" || f64Text(-1.0 / 0.0) != "-Infinity") wrong += 1
    if (wrong == 0) 42 else 1
}
