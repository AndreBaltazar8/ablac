// linuxSignalWatchGet and linuxSignalWatchSet, callable from ordinary code, touch only the 66 words of the calling thread's
// signal-watch state: an offset before it, past it or between words reads 0 and writes nothing (they loaded and stored at
// any address before).
import "abla/sys/linux/process"

fun main: int {
    var status = 0
    for (offset in [-8, -1, 3, 528, 4096, 1 << 40]) {
        linuxSignalWatchSet(offset, 77)
        if (linuxSignalWatchGet(offset) != 0) status = 1
    }
    val last = linuxSignalWatchGet(520)
    linuxSignalWatchSet(520, last + 5)
    if (linuxSignalWatchGet(520) != last + 5) status = 2
    linuxSignalWatchSet(520, last)
    status
}
