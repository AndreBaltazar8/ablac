// A string reached through a borrowed alias interpolates.
import "abla/io"

class Sample(val zone: string, var raids: int)

class Bot(val sample: Sample)

fun main: int {
    val bots = [Bot(Sample("north", 1)), Bot(Sample("south", 2))]
    val samples: array<Sample> = []
    for (bot in bots) samples.append(bot.sample)
    val s = samples[1]
    val text = "farming ${s.zone} ${s.raids}"
    if (text == "farming south 2") 42 else 1
}
