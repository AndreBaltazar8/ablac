import "abla/io"

fun counted(limit: int): Generator<int> = generator {
    for (i in 0 until limit) yield i
}

fun drain(values: Generator<int>): int {
    var total = 0
    for (value in values) total = total + value
    total
}

fun once(round: int): int {
    val values = counted(3 + round)
    drain(values)
}

fun main: int {
    var total = 0
    for (i in 0 until 40) total = total + once(i)
    val strings: array<string> = []
    for (i in 0 until 2000) strings.append("item $i")
    println("$total ${strings.size}")
    0
}
