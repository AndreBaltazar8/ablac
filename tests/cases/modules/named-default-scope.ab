// A default a named call leaves out means what it means in its callee, not in
// the caller: positional and named calls agree.
import "named-default-scope-module.ab"
val limit = 7
var counter = 1
val table = [10, 20]
fun f(a: int, b: int = limit): int = a * 100 + b
fun middle(a: int, b: int = limit, c: int = 1): int = a * 100 + b + c * 1000
fun fromEarlier(a: int, b: int = a + limit): int = b
fun current(a: int, b: int = counter): int = a * 100 + b
fun first(a: int, b: array<int> = table): int = a + b[0]
fun inLambda(a: int, b: () -> int = { -> limit }): int = a + b()
class Point(val x: int, val y: int = limit)
class Holder(val limit: int) {
    fun named(): int = f(a = 1)
    fun positional(): int = f(1)
    fun skipped(): int = middle(a = 1, c = 2)
    fun built(): int = Point(x = 1).y
    fun builtPositional(): int = Point(1).y
    fun method(limit: int = 4): int = this.limit + limit
    // The default's own `limit` is the receiver's field, as ever.
    fun viaOwn(): int = method()
}
fun Holder.extended(): int = f(a = 2)
fun localNamed(): int {
    val limit = 3
    f(a = 1) + limit * 1000
}
fun parameterNamed(limit: int): int = f(a = 1) + limit * 1000
fun lambdaNamed(): int {
    val run = { limit: int -> f(a = 1) + limit * 1000 }
    run(3)
}
fun loopNamed(): int {
    var total = 0
    for (limit in [3]) total = f(a = 1) + limit * 1000
    total
}
// Arguments the caller passes are the caller's: a local read by name stays local.
fun argumentLocal(): int {
    val limit = 3
    f(a = 1, b = limit)
}
// A `var` argument names the caller's place, which a later default reads.
fun placeDefault(var a: array<int>, b: int = a.size): int = a.size + b
fun placeCaller(): int {
    var limit = [1, 2]
    placeDefault(a = limit)
}
// A local function value doesn't hide a function a default calls, nor a local
// a global a method's default reads.
fun helper(n: int): int = n + 100
fun viaCall(a: int, b: int = helper(1)): int = a + b
fun viaNamedInside(a: int, b: int = f(a = 0)): int = a + b
fun localFunction(): int {
    val helper = { n: int -> n + 5 }
    val f = { a: int -> a + 5 }
    viaCall(a = 0) + viaNamedInside(a = 0) + 0 * helper(1) + 0 * f(1)
}
class Reader(val z: int) {
    fun read(a: int, b: int = limit): int = a + b
}
fun methodLocal(): int {
    val limit = 3
    Reader(0).read(a = 0) + 0 * limit
}
fun checks(): int {
    val holder = Holder(0)
    if (holder.named() != 107) return 1
    if (holder.positional() != 107) return 2
    if (holder.skipped() != 2107) return 3
    if (holder.built() != 7) return 4
    if (holder.builtPositional() != 7) return 5
    if (holder.extended() != 207) return 6
    if (holder.viaOwn() != 4) return 7
    if (localNamed() != 3107) return 8
    if (parameterNamed(3) != 3107) return 9
    if (lambdaNamed() != 3107) return 10
    if (loopNamed() != 3107) return 11
    if (argumentLocal() != 103) return 12
    if (placeCaller() != 4) return 13
    val limit = 5
    if (fromEarlier(a = 1) != 8 || limit != 5) return 14
    val counter = 9
    if (current(a = 1) != 101 || counter != 9) return 15
    val table = [1]
    if (first(a = 1) != 11 || table[0] != 1) return 16
    if (inLambda(a = 1) != 8) return 17
    // A private global of another module, read by its function's default.
    val hidden = 5
    if (moduleDefault(a = 1) != 41 || hidden != 5) return 18
    if (localFunction() != 108) return 20
    if (methodLocal() != 7) return 21
    // Compile time gives the same.
    if (#compileTimeRead() != 107) return 19
    0
}
fun compileTimeRead(): int {
    val limit = 3
    f(a = 1) + limit - 3
}
fun main: int {
    val failed = checks()
    if (failed == 0) 42 else failed
}
