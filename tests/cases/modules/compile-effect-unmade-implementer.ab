// An interface call takes the effects of the implementers the `#` expression can make: a
// file source no code here makes doesn't stop a parse of a string at compile time.
import "abla/fs"
interface Source { fun read(): string }
class TextSource(val text: string) : Source {
    fun read(): string = text
}
class FileSource(val path: string) : Source {
    fun read(): string = Path(path).readText()
}
fun fileSource(path: string): Source = FileSource(path)
fun Path.source(): Source = FileSource(text)
fun size(source: Source): int = source.read().size
compile fun measured(): int = size(TextSource("forty-two characters long, as is this one"))
val measure = #measured()
fun main: int = measure + 1
