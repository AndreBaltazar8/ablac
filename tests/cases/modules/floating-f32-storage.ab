// Floats read back from managed storage (array elements, class fields, for-in
// iteration) take part in native arithmetic: the load is specialised to the
// element type instead of flowing through the generic boxed operators.
import "abla/float"

class Point(var x: f32, var y: f32)

fun nudge(var point: Point, dt: f32): void {
    point.y = point.y + f64ToF32(2.0) * dt
    return
}

fun accumulate(var values: array<f32>, index: int, dt: f32): void {
    values[index] = values[index] + f64ToF32(2.0) * dt
    return
}

fun main: int {
    var values: array<f32> = []
    values.append(f64ToF32(7.0))
    accumulate(values, 0, f64ToF32(0.5))
    val arrayOk = f32ToI32(values[0]) == i32(8) && f32ToI32(values[0] * f64ToF32(2.0)) == i32(16)

    var point = Point(f64ToF32(1.0), f64ToF32(7.0))
    nudge(point, f64ToF32(0.5))
    val copy = Point(point.x, point.y)
    val fieldOk = f32ToI32(point.y) == i32(8) && f32ToI32(copy.y * f64ToF32(2.0)) == i32(16) &&
        f32ToI32(copy.x) == i32(1)

    val wide: array<f64> = [1.5, 2.5]
    var wideSum = 0.0
    for (value in wide) wideSum = wideSum + value * 2.0
    var narrowSum = f64ToF32(0.0)
    for (value in values) narrowSum = narrowSum + value * f64ToF32(2.0)
    val iterationOk = wideSum == 8.0 && f32ToI32(narrowSum) == i32(16)

    if (arrayOk && fieldOk && iterationOk) 42 else 1
}
