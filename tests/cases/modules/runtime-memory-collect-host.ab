import "abla/platform/host"
import "abla/runtime/memory"
import "abla/unsafe/memory"

fun abandonHostValue(): int {
    val source = ablaHostReadFile("tests/cases/bootstrap/value.ab")
    source.size
}

fun abandonAdoptedString(): int {
    val buffer = nativeByteBuffer(65537)
    buffer.store(0, 65)
    val adopted = buffer.adoptString(1)
    adopted.size
}

fun retainAdoptedSlice(): string {
    val buffer = nativeByteBuffer(8)
    buffer.store(0, 97)
    buffer.store(1, 98)
    buffer.store(2, 99)
    buffer.store(3, 100)
    buffer.store(4, 101)
    buffer.store(5, 102)
    buffer.adoptString(6).slice(1, 5)
}

fun retainRopeSlice(value: string): string =
    "$value-suffix".slice(1, 5)

fun main: int {
    val live = ablaHostReadFile("tests/cases/bootstrap/value.ab")
    val size = abandonHostValue()
    val adoptedSize = abandonAdoptedString()
    val retained = retainAdoptedSlice()
    val retainedRope = retainRopeSlice("abcdef")
    val before = runtimeMemoryLiveBytes()
    val freed = runtimeMemoryCollect()
    val after = runtimeMemoryLiveBytes()
    if (size == 20 && adoptedSize == 1 && retained == "bcde" &&
        retainedRope == "bcde" &&
        live.size == 20 && freed > 65536 &&
        after + freed == before) 42 else 1
}
