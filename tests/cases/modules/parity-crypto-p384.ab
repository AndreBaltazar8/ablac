// Compile-time parity of abla/crypto/p384: a public key, an RFC 6979 (deterministic) signature, its check, the DER form
// and ECDH over fixed keys print the same at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/p384"

fun show(result: CryptoResult): string = if (result.ok) hexEncode(result.bytes) else "error ${result.error}"

fun main: int {
    val key = hexDecode("6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5")
    val peer = hexDecode("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30")
    val publicKey = p384PublicKey(key)
    val signature = p384EcdsaSignRaw(key, "sample")
    println("public ${show(publicKey)}")
    println("signature ${show(signature)} der ${hexEncode(p384SignatureToDer(signature.bytes))}")
    println("ecdh ${show(p384Ecdh(key, p384PublicKey(peer).bytes))} ${show(p384Ecdh(peer, publicKey.bytes))}")
    42
}
