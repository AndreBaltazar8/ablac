import "abla/compiler"

fun target(value: int): int = value

compile fun inspectCompiler(): int {
    val handle = compilerFindFunction("target")
    val functions = compilerFunctions()
    val compileHandle = compilerFindFunction("inspectCompiler")
    if (compilerFunctionName(handle) != "target") 0
    else if (compilerFunctionName(functions[0]) != "target") 0
    else if (compilerFunctionParameterCount(handle) != 1) 0
    else if (compilerFunctionResultType(handle) != "i64") 0
    else if (compilerFunctionIsCompileOnly(handle)) 0
    else if (!compilerFunctionIsCompileOnly(compileHandle)) 0
    else 42
}

fun main: int = #inspectCompiler()
