// A `var` parameter supplied by name borrows the caller's place, as it does
// positionally; named arguments used to bind it to a `val` temporary first.
class Track(val left: array<int>, var events: int)
class Song(var track: Track)

fun at(var track: Track, beat: int, pan: int = 0): void {
    track.left[0] = track.left[0] + beat + pan
    track.events += 1
    return
}

fun main: int {
    val track = Track([0], 0)
    at(track, 1, pan = 2)
    at(beat = 3, track = track)
    val song = Song(Track([0], 0))
    at(song.track, 4, pan = 1)
    at(pan = 5, track = song.track, beat = 6)
    if (track.left[0] == 6 && track.events == 2 &&
        song.track.left[0] == 16 && song.track.events == 2) 42 else 1
}
