// Fields and array elements reach arithmetic boxed; the result must still
// wrap at the declared width, as it does for a typed local.
class Word(var value: i32)
class Unsigned(var value: u32)
class Byte(var value: i8)

fun lcg(word: Word): i32 = word.value * i32(1103515245) + i32(12345)

fun main: int {
    var failures = 0
    val product = Word(i32(1103515245))
    product.value = product.value * i32(1103515245)
    if (product.value != i32(-1029531031)) failures = failures + 1
    val sum = Word(i32(2147483647))
    sum.value += i32(1)
    if (sum.value != i32(-2147483647) - i32(1)) failures = failures + 1
    val difference = Word(i32(-2147483647))
    difference.value = difference.value - i32(2)
    if (difference.value != i32(2147483647)) failures = failures + 1
    val negated = Word(i32(-2147483647) - i32(1))
    negated.value = -negated.value
    if (negated.value != i32(-2147483647) - i32(1)) failures = failures + 1
    val shifted = Word(i32(-1))
    if (shifted.value >>> i32(28) != i32(15)) failures = failures + 1
    val unsigned = Unsigned(u32(4000000000))
    unsigned.value *= u32(3)
    if (unsigned.value != u32(3410065408)) failures = failures + 1
    if (~unsigned.value != u32(884901887)) failures = failures + 1
    val byte = Byte(i8(127))
    byte.value = byte.value + i8(1)
    if (byte.value != i8(-128)) failures = failures + 1
    val words: array<i32> = [i32(1103515245)]
    words[0] *= i32(1103515245)
    if (words[0] != i32(-1029531031)) failures = failures + 1
    if (lcg(Word(i32(1103515245))) != i32(-1029518686)) failures = failures + 1
    if (failures == 0) 42 else failures
}
