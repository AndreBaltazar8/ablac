import "abla/memory"

// A value defined before a loop and read on every iteration must stay a GC
// root across the loop's back-edge. The iterated array here is last used
// (textually) by the element fetch at the top of the body, before the
// allocating call; a collection inside churn() used to free it, so the next
// iteration read reclaimed memory.

class LoopEvent(val id: int, val payload: string)

fun loopEvents(round: int): array<LoopEvent> {
    val events: array<LoopEvent> = []
    var index = 0
    while (index < 8) {
        events.append(LoopEvent(round * 8 + index, "event-$round-$index-0123456789abcdef"))
        index = index + 1
    }
    events
}

fun churn(count: int): int {
    var total = 0
    var index = 0
    while (index < count) {
        val parts = ["a$index", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb$index"]
        total = total + parts[1].size
        index = index + 1
    }
    total
}

fun main: int {
    memorySetLimit(1048576)
    var bad = 0
    var round = 0
    while (round < 2000) {
        var expected = 0
        for (event in loopEvents(round)) {
            churn(16)
            if (event.id != round * 8 + expected ||
                event.payload != "event-$round-$expected-0123456789abcdef") bad = bad + 1
            expected = expected + 1
        }
        round = round + 1
    }
    if (bad == 0) 42 else 1
}
