import "abla/fs"
import "abla/http/stream"
import "abla/process"

val stagedGzipMatch = #gzipCompress("abcabcabcabc")

fun gzipBytesEqual(value: string, expected: array<int>): bool {
    var equal = value.size == expected.size
    var index = 0
    while (equal && index < expected.size) {
        equal = value[index] == expected[index]
        index = index + 1
    }
    equal
}

fun gzipMatchFixture(): bool {
    // Fixed streams cover empty input and overlapping copies. Native raw
    // matching must also agree with the checked compile-time path on ropes.
    val prefix = "abcabc"
    val rope = "$prefix$prefix"
    gzipBytesEqual(gzipCompress(""), [
        31,139,8,0,0,0,0,0,0,255,3,0,0,0,0,0,0,0,0,0
    ]) && gzipBytesEqual(gzipCompress("aaaaa"), [
        31,139,8,0,0,0,0,0,0,255,75,4,1,0,185,147,172,238,5,0,0,0
    ]) && gzipCompress(rope) == stagedGzipMatch &&
        gzipCompress("x${rope}y".slice(1, 13)) == stagedGzipMatch
}

fun repeatedText(): string {
    var output = ""
    var index = 0
    while (index < 200) {
        output = "${output}abla-network-stream-"
        index = index + 1
    }
    output
}

fun main: int {
    val original = repeatedText()
    val compressed = gzipCompress(original)
    val fixture = path("build/http-advanced.gz")
    val written = fixture.writeText(compressed)
    val gzip = command("gzip")
    gzip.argument("-dc")
    gzip.argument("build/http-advanced.gz")
    val decoded = gzip.captureText()
    fixture.remove()

    val chunks = "${httpChunkEncode("hello")}${httpChunkEncode(" world")}${httpChunkEnd()}"
    val chunked = httpDecodeChunked(chunks)
    val parsedChunked = httpParseResponse(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n$chunks"
    )
    val event = serverSentEvent("first\nsecond", "update", "7", 1500)
    val request = httpRequest("GET", "/", "", [
        HttpHeader("Accept-Encoding", "gzip")
    ])
    val response = httpGzipResponse(request, httpText(original), 1)
    if (gzipMatchFixture() && written && decoded == original && compressed.size < original.size &&
        chunked.complete && chunked.error == "" &&
        chunked.body == "hello world" &&
        parsedChunked.complete && parsedChunked.response.body == "hello world" &&
        event.encode() == "event: update\nid: 7\nretry: 1500\ndata: first\ndata: second\n\n" &&
        response.header("Content-Encoding") == "gzip") 42 else 1
}
