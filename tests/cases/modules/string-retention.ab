// What a kept string retains after a collection
// (tools/test-string-retention.sh): a short string built by `+=` or
// interpolation keeps one flat buffer, not the pieces it was joined from, and
// a long rope that was read keeps its flat copy, not its nodes.
import "abla/io"
import "abla/memory"

val digits = "0123456789abcdef"

fun piecewise(seed: int): string {
    var text = ""
    var piece = 0
    while (piece < 32) {
        val digit = (seed + piece * 7) % 16
        text += digits.slice(digit, digit + 1)
        piece = piece + 1
    }
    text
}

fun main: int {
    val count = 4000
    memoryCollect()
    val before = memoryLiveBytes()
    val kept: array<string> = []
    var index = 0
    while (index < count) {
        kept.append(piecewise(index))
        kept.append("u7-$index")
        index = index + 1
    }
    memoryCollect()
    val perString = (memoryLiveBytes() - before) / (2 * count)

    val beforeLarge = memoryLiveBytes()
    var large = ""
    index = 0
    while (index < 1000) {
        large += "0123456789"
        index = index + 1
    }
    memoryCollect()
    val rope = memoryLiveBytes() - beforeLarge
    val read = large[5]
    memoryCollect()
    val flattened = memoryLiveBytes() - beforeLarge
    println("short: $perString B/string; 10000-byte rope: $rope B, after a read: $flattened B")
    val ok = kept[0].size == 32 && kept[1] == "u7-0" && read == 53 &&
        perString < 128 && flattened < 2 * large.size
    if (ok) 42 else 1
}
