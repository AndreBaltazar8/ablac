import "abla/io"
import "abla/process/arguments"
import "abla/sys/linux/fs"

// Renames another file over this program's own path, then reads
// `/proc/self/exe`: the image this process started from, or nothing (where
// the host cannot reach it any more), never the file that replaced it.
fun main: int {
    val before = Path("/proc/self/exe").readText()
    if (before.size == 0) return 2
    if (!Path(processArgument(1)).moveTo(Path(processArgument(0)))) return 3
    val after = Path("/proc/self/exe").readText()
    println("${before.size} ${after.size}")
    if (after.size == 0 || after == before) 0 else 1
}
