import "../../../src/lexer.ab"

fun main: int {
    val source = "fun main { val text = \"ok\" }"
    val tokens = bootstrapLex(source)
    if (
        tokens.size == 11 &&
        tokens[0].kind == BOOTSTRAP_TOKEN_FUN &&
        tokens[1].kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
        tokens[2].kind == BOOTSTRAP_TOKEN_LBRACE &&
        tokens[6].kind == BOOTSTRAP_TOKEN_STRING_START &&
        tokens[7].kind == BOOTSTRAP_TOKEN_STRING_TEXT &&
        tokens[8].kind == BOOTSTRAP_TOKEN_STRING_END &&
        tokens[10].kind == BOOTSTRAP_TOKEN_END &&
        tokens[0].begin == 0 && tokens[0].end == 3 &&
        tokens[1].begin == 4 && tokens[1].end == 8 &&
        tokens[7].begin == 23 && tokens[7].end == 25 &&
        tokens[10].begin == source.size &&
        tokens[10].end == source.size &&
        bootstrapTokenText(source, tokens[1]) == "main" &&
        bootstrapTokenText(source, tokens[7]) == "ok"
    ) 42 else 0
}
