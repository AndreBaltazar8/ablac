#import("../../../bootstrap/compiler/subparser.ab")
#import("abla/io")

fun main: int {
    val parsed = bootstrapParse(
        "compile abstract class Cursor\ncompile abstract class Syntax\ncompile fun parseDemo(cursor: Cursor): Syntax\n#compilerRegisterSubparser(\"demo\", parseDemo)\n"
    )
    val registry = bootstrapBuildSubparserRegistry(parsed)

    val duplicate = bootstrapBuildSubparserRegistry(bootstrapParse(
        "compile fun parseDemo(cursor: int): int = cursor\n#compilerRegisterSubparser(\"demo\", parseDemo)\n#compilerRegisterSubparser(\"demo\", parseDemo)\n"
    ))

    val runtimeHandler = bootstrapBuildSubparserRegistry(bootstrapParse(
        "fun parseDemo(cursor: int): int = cursor\n#compilerRegisterSubparser(\"demo\", parseDemo)\n"
    ))
    val jsonParsed = bootstrapParse(
        ablaHostReadFile("stdlib/abla/json/entry.ab")
    )
    val jsonRegistry = bootstrapBuildSubparserRegistry(jsonParsed)

    if (
        parsed.errors == 0 &&
        parsed.declarations.size == 3 &&
        parsed.actions.size == 1 &&
        registry.errors == 0 &&
        registry.registrations.size == 1 &&
        registry.registrations[0].name == "demo" &&
        registry.registrations[0].handler == "parseDemo" &&
        registry.contains("demo") &&
        duplicate.errors == 1 &&
        runtimeHandler.errors == 1 &&
        jsonParsed.errors == 0 &&
        jsonRegistry.errors == 0 &&
        jsonRegistry.contains("json")
    ) 42 else 0
}
