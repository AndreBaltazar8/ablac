#import("abla/sys/linux/io")

fun main: int {
    val input = linuxStandardInput()
    val ready = input.ready(1000)
    val first = input.readLine()
    val empty = input.readLine()
    val finalLine = input.readLine()
    val end = input.readLine()
    val standardOutput = linuxWriteStandardOutputAll(
        "${first.text}|${empty.text}|${finalLine.text}\n"
    )
    val standardError = linuxWriteStandardErrorAll("linux-io-stderr\n")
    if (ready && first.available && first.text == "alpha" &&
        empty.available && empty.text == "" && finalLine.available &&
        finalLine.text == "beta" && !end.available && standardOutput &&
        standardError) 42 else 0
}
