// `+ x` / `- x` at the start of a line continue the expression above; a
// sign glued to its operand (`-1`) starts the next statement; a line
// starting with `.` continues a call chain.
class Builder(val items: array<string>)

fun Builder.add(item: string): Builder {
    this.items.append(item)
    this
}

fun find(names: array<string>, name: string): int {
    for (i in 0 until names.size) if (names[i] == name) return i
    -1
}

fun spread(a: int, b: int): int {
    val sum = a
        + b
    val difference = a
        - b
    sum * 100 + difference
}

fun main: int {
    val built = Builder([]).add("a")
        .add("b")
        .add("c")
    if (find(["a", "b"], "c") == -1 && find(["a", "b"], "b") == 1 &&
        spread(5, 2) == 703 && built.items.size == 3) 42 else 1
}
