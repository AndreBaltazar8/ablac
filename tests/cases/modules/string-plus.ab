// `+` concatenates two strings, `+=` appends to a string variable, and both
// work at compile time; a string and a number still do not add.
import "abla/io"

compile fun greeting(): string = "hello" + ", " + "world"

val GREETING = #greeting()

fun join(parts: array<string>): string {
    var out = ""
    for (part in parts) out += part + "/"
    out
}

fun main: int {
    val a = "ab"
    val b = a + "cd" + a
    if (b != "abcdab" || b.size != 6) return 1
    if (join(["x", "y"]) != "x/y/") return 2
    if (GREETING != "hello, world") return 3
    val name = "rocket"
    if ("[" + name + "]" != "[rocket]") return 4
    42
}
