import "abla/runtime/memory"
import "abla/memory"
import "abla/unsafe/memory"

var regionDrops = 0

resource class RegionTicket(val value: int) {
    fun drop(): void {
        regionDrops = regionDrops + value
        return
    }
}

compile fun stagedRegion(): int = region {
    val values = ["compile", "time", "region"]
    if (values.size == 3) 42 else 0
}

noescape fun regionNoEscapeLength(value: string): int = value.size

fun regionInvokeNoEscape(
    callback: FnNoEscape(string) -> int,
    value: string
): int = callback(value)

fun main: int {
    val baseline = runtimeMemoryLiveBytes()
    val nestedResult = region {
        val outer = ["outer remains live"]
        val innerBaseline = runtimeMemoryLiveBytes()
        val innerResult = region {
            val inner: array<string> = []
            var innerIndex = 0
            while (innerIndex < 100) {
                inner.append("nested-$innerIndex")
                innerIndex = innerIndex + 1
            }
            if (inner.size == 100) 7 else 0
        }
        if (innerResult == 7 && outer[0] == "outer remains live" &&
            runtimeMemoryLiveBytes() == innerBaseline) 42 else 0
    }
    val result = region {
        val ticket = RegionTicket(1)
        val buffer = nativeByteBuffer(4097)
        buffer.store(0, 42)
        val values: array<string> = []
        var index = 0
        while (index < 200) {
            values.append("region-$index")
            index = index + 1
        }
        if (buffer.load(0) == 42 && ticket.value == 1 &&
            values.size == 200 && runtimeMemoryLiveBytes() > baseline) {
            42
        } else 0
    }
    val promotionResult = region {
        val promoted = region {
            memoryPromoteString("promoted from region")
        }
        if (promoted == "promoted from region") 42 else 0
    }
    val callbackResult = region {
        regionInvokeNoEscape(regionNoEscapeLength, "typed callback")
    }
    if (nestedResult == 42 && result == 42 &&
        promotionResult == 42 && callbackResult == 14 && regionDrops == 1 &&
        runtimeMemoryLiveBytes() == baseline && #stagedRegion() == 42) {
        42
    } else 0
}
