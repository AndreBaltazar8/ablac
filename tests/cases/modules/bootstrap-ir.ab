#import("../../../bootstrap/compiler/ir.ab")

fun main: int {
    val program = bootstrapLower("val answer = 40 + 2")
    val printed = bootstrapPrintIr(program)
    if (
        program.errors == 0 &&
        program.functions.size == 0 &&
        program.instructions.size == 4 &&
        program.instructions[0].opcode == "const.i64" &&
        program.instructions[2].opcode == "+" &&
        program.instructions[2].left == 0 &&
        program.instructions[2].right == 1 &&
        program.instructions[3].opcode == "global.store" &&
        printed.size > 20
    ) 42 else 0
}
