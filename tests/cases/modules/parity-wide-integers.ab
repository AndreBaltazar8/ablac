// Compile-time parity of abla/int128, abla/uint128, abla/int256 and abla/uint256: arithmetic that wraps, division and
// remainder, shifts, checked operations and their text print the same at run time and under `#`
// (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/int128"
import "abla/int256"
import "abla/uint128"
import "abla/uint256"

fun main: int {
    val a = int128(-123456789012345) * int128(987654321) + int128(17)
    println("int128 ${int128Text(a)} ${int128Text(a / int128(1000003))} ${int128Text(a % int128(1000003))}")
    println("        max ${int128Text(int128Max())} wrap ${int128Text(int128Max() + int128(1))} shl ${int128Text(int128(1) << 100)}")
    println("        checked ${int128Max().addChecked(int128(1)) == null} abs ${int128Text(a.abs())} signum ${a.signum()}")
    val b = uint128(1) << 127
    println("uint128 ${uint128Text(b)} ${uint128Text(b / uint128(3))} bits ${b.bitLength()} ${uint128Text(uint128Words(u32(1), u32(2), u32(3), u32(4)))}")
    val c = int256(-1) * int256(1000000007) * int256(998244353) * int256(1000000009)
    println("int256 ${int256Text(c)} ${int256Text(int256Min())} shr ${int256Text(int256ShiftRight(c, 7))}")
    val d = uint256(12345678901) * uint256(98765432109) * uint256(55555555555)
    println("uint256 ${uint256Text(d)} ${uint256Text(d % uint256(97))} ${uint256Text(uint256ShiftLeft(uint256(1), 255))}")
    42
}
