// A default left out of a named call keeps calling what it names, whatever the
// caller's local of that name is, also in a generic function or a method.
val twice = { n: int -> n * 2 }
var thrice: (int) -> int = { n: int -> n * 3 }
class Box(val n: int)
fun answerOf(n: int): int = n
fun <T> generic(a: T, b: int = twice(1)): int = b
fun <T> genericVar(a: T, b: int = thrice(1)): int = b
fun <T> genericBox(a: T, b: Box = Box(4)): int = b.n
fun <T> genericReads(a: T, b: array<T> = pick(a)): int = b.size
fun <T> pick(a: T): array<T> = [a, a]
class Holder(val n: int) {
    fun value(a: int, b: int = twice(this.n)): int = a + b
    fun built(a: int, b: Box = Box(5)): int = a + b.n
    // Reading the receiver and calling a hidden constructor.
    fun shadowed(n: int, b: Box = Box(n + this.n)): int = b.n
    fun read(a: int, b: Box = Box(this.n + n)): int = a + b.n
}
class Other(val n: int)
fun Other.extended(a: int, b: Box = Box(this.n + a)): int = b.n
fun notAFunction(): int {
    val twice = 40
    generic(a = "x") + twice
}
fun aFunction(): int {
    val twice = { n: int -> n * 100 }
    generic(a = "x") + twice(1)
}
fun varNotAFunction(): int {
    val thrice = "text"
    genericVar(a = 1) + thrice.size
}
fun constructorHidden(): int {
    val Box = 1
    genericBox(a = 1) + Box
}
fun readsHidden(): int {
    val pick = 1
    genericReads(a = 1) + pick
}
fun methodHidden(): int {
    val twice = 1
    Holder(3).value(a = 1) + twice
}
fun methodConstructorHidden(): int {
    val Box = 1
    Holder(3).built(a = 1) + Box
}
fun methodReadsReceiver(): int {
    val Box = { n: int -> n * 100 }
    Holder(3).read(a = 1) + Box(0)
}
fun parameterShadowsField(): int {
    val Box = 1
    Holder(3).shadowed(n = 10) + Box
}
fun extensionReadsReceiver(): int {
    val Box = 1
    Other(3).extended(a = 2) + Box
}
class Tagged<T>(val value: T, val n: int) {
    fun taggedRead(a: int, b: Box = Box(this.n)): int = a + b.n
    fun taggedTyped(a: int, b: Pair<T> = Pair(this.value, 2)): int = a + b.n
}
class Pair<U>(val value: U, val n: int)
fun genericClassReads(): int {
    val Box = { n: int -> n * 3 }
    Tagged("x", 1).taggedRead(a = 1) + Box(0)
}
fun genericClassTyped(): int {
    val Pair = 1
    Tagged("x", 1).taggedTyped(a = 1) + Pair
}
fun main: int {
    if (notAFunction() != 42) return 1
    if (aFunction() != 102) return 2
    if (varNotAFunction() != 7) return 3
    if (constructorHidden() != 5) return 4
    if (readsHidden() != 3) return 5
    if (methodHidden() != 8) return 6
    if (methodConstructorHidden() != 7) return 7
    if (methodReadsReceiver() != 7) return 8
    if (extensionReadsReceiver() != 6) return 9
    if (parameterShadowsField() != 14) return 10
    if (genericClassReads() != 2) return 11
    if (genericClassTyped() != 4) return 12
    42
}
