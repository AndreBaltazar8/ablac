import "../../../src/backend_c.ab"
import "abla/sys/linux/io"

fun main: int {
    linuxPrintStandardOutput(bootstrapEmitC(
        "class IntDelegate(var value: int, var gets: int, var sets: int) {\n    fun getValue(): int {\n        gets = gets + 1\n        value\n    }\n    fun setValue(next: int): void {\n        sets = sets + 1\n        value = next\n        return\n    }\n}\nfun inspect(delegate: IntDelegate): int = delegate.value + delegate.gets * 10 + delegate.sets * 100\nfun main: int {\n    var value: int by IntDelegate(1, 0, 0)\n    val attempted = (value = 7)\n    val observed = value\n    ^value = IntDelegate(12, 0, 0)\n    val replaced = value\n    if (attempted == 7 && observed == 7 && replaced == 12 && inspect(^value) == 22) 42 else 0\n}\n"
    ))
    0
}
