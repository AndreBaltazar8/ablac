// A checkpoint taken while the newest allocation is garbage must survive a
// collection that frees that allocation: the reset then frees only what was
// allocated after the checkpoint, never the kept strings before it.
import "abla/memory"

fun main: int {
    val keep: array<string> = []
    for (round in 0 until 50) {
        keep.append("kept $round")
        var scratch = "scratch $round"
        val checkpoint = memoryCheckpoint()
        for (i in 0 until 100) scratch = "work $i"
        memoryCollect()
        memoryReset(checkpoint)
    }
    var ok = keep.size == 50
    for (round in 0 until 50) if (keep[round] != "kept $round") ok = false
    if (ok) 42 else 1
}
