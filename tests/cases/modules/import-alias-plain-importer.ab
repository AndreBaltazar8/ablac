// Imports import-alias-shared.ab plainly while import-alias-plain.ab aliases
// it: its bare names still reach that module, except where a declaration
// here binds the same name (a field, a parameter), which shadows it.
import "./import-alias-shared.ab"

class Box(val size: int)

fun otherValue(): int = sharedValue() + Shared(1).n + limit

fun boxed(limit: int): int = Box(limit).size + limit
