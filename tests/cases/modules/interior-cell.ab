class Counter(val value: Cell<int>)

fun stagedCellValue(): int {
    val counter = Counter(Cell(18))
    val view = counter
    counter.value.set(counter.value.get() + 3)
    view.value.get()
}

fun main: int {
    val counter = Counter(Cell(20))
    val view = counter
    counter.value.set(counter.value.get() + 1)
    view.value.get() + #stagedCellValue()
}
