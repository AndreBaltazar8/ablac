import "../../../src/backend/llvm/backend.ab"
import "abla/sys/linux/io"

fun compileXtensa(source: string): BootstrapLlvmCompilation {
    val cache = bootstrapIrTransientState()
    bootstrapCompileLlvmParsedCached(
        bootstrapParseStaged(source),
        cache,
        "xtensa-esp-unknown-elf"
    )
}

fun countText(input: string, wanted: string): int {
    var count = 0
    var index = 0
    while (wanted.size > 0 && index + wanted.size <= input.size) {
        if (input.slice(index, index + wanted.size) == wanted) {
            count = count + 1
        }
        index = index + 1
    }
    count
}

fun main: int {
    val validSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptHandlerAddress(handler: Fn() -> void): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptTableAddress(): u32\nfun helper(): void { return }\nfun interruptHandler(): void { helper(); return }\n@export(\"handler_address\")\ntrusted fun handlerAddress(): u32 = nativeXtensaInterruptHandlerAddress(interruptHandler)\n@export(\"table_address\")\ntrusted fun tableAddress(): u32 = nativeXtensaInterruptTableAddress()\nfun main: int = 0\n"
    val valid = compileXtensa(validSource)
    var passed = valid.errors == 0 &&
        bootstrapTextContains(
            valid.output,
            "target datalayout = \"e-m:e-p:32:32-v1:8:8-i64:64-i128:128-n32\""
        ) &&
        bootstrapTextContains(
            valid.output,
            "_xtensa_interrupt_entry() section \".iram1.text\""
        ) &&
        countText(valid.output, "section \".iram1.text\"") == 3 &&
        bootstrapTextContains(
            valid.output,
            "ret i32 ptrtoint (ptr @"
        ) &&
        bootstrapTextContains(
            valid.output,
            "@_xt_interrupt_table = external global [128 x i32]"
        ) &&
        !bootstrapTextContains(valid.output, "call void @abla_function(")

    val aliasSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptHandlerAddress(handler: Fn() -> void): u32\nfun interruptHandler(): void { return }\ntrusted fun handlerAddress(): u32 { val alias = interruptHandler; nativeXtensaInterruptHandlerAddress(alias) }\nfun main: int = 0\n"
    val alias = compileXtensa(aliasSource)
    passed = passed && alias.errors > 0

    val closureSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptHandlerAddress(handler: Fn() -> void): u32\ntrusted fun handlerAddress(): u32 { val captured: u32 = 1; nativeXtensaInterruptHandlerAddress({ -> val ignored = captured; return }) }\nfun main: int = 0\n"
    val closure = compileXtensa(closureSource)
    passed = passed && closure.errors > 0

    val ownedSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaOwnedDispatcherTableAddress(): u32\n@export(\"owned_table_address\")\ntrusted fun ownedTableAddress(): u32 = nativeXtensaOwnedDispatcherTableAddress()\nfun main: int = 0\n"
    val owned = compileXtensa(ownedSource)
    passed = passed && owned.errors == 0 &&
        bootstrapTextContains(
            owned.output,
            "@_xt_interrupt_table = global [128 x i32]"
        ) &&
        bootstrapTextContains(
            owned.output,
            "@_xt_exception_table = global [128 x i32]"
        ) &&
        bootstrapTextContains(
            owned.output,
            "@Xthal_intlevel = constant [32 x i8]"
        ) &&
        bootstrapTextContains(
            owned.output,
            "c\"\\01\\01\\01\\01\\01\\01\\01\\01\\01\\01\\01\\03\\01\\07\\03\\05\\01\\01\\01\\02\\02\\02\\03\\03\\04\\04\\05\\03\\04\\03\\04\\05\""
        ) &&
        bootstrapTextContains(
            owned.output,
            "declare void @xt_unhandled_interrupt(i32)"
        ) &&
        bootstrapTextContains(
            owned.output,
            "declare void @xt_unhandled_exception(ptr)"
        ) &&
        bootstrapTextContains(owned.output, "align 8") &&
        bootstrapTextContains(owned.output, "i32 0") &&
        bootstrapTextContains(owned.output, "i32 63") &&
        countText(
            owned.output,
            "ptrtoint (ptr @xt_unhandled_interrupt to i32)"
        ) == 64 &&
        countText(
            owned.output,
            "ptrtoint (ptr @xt_unhandled_exception to i32)"
        ) == 128

    val combinedSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptTableAddress(): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaExceptionTableAddress(): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptLevelTableAddress(): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaUnhandledInterruptAddress(): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaUnhandledExceptionAddress(): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaOwnedDispatcherTableAddress(): u32\n@export(\"table_address\")\ntrusted fun tableAddress(): u32 = nativeXtensaInterruptTableAddress()\n@export(\"exception_table_address\")\ntrusted fun exceptionTableAddress(): u32 = nativeXtensaExceptionTableAddress()\n@export(\"interrupt_level_table_address\")\ntrusted fun interruptLevelTableAddress(): u32 = nativeXtensaInterruptLevelTableAddress()\n@export(\"interrupt_default_address\")\ntrusted fun interruptDefaultAddress(): u32 = nativeXtensaUnhandledInterruptAddress()\n@export(\"exception_default_address\")\ntrusted fun exceptionDefaultAddress(): u32 = nativeXtensaUnhandledExceptionAddress()\n@export(\"owned_dispatcher_table_address\")\ntrusted fun ownTable(): u32 = nativeXtensaOwnedDispatcherTableAddress()\nfun main: int = 0\n"
    val combined = compileXtensa(combinedSource)
    passed = passed && combined.errors == 0 &&
        countText(
            combined.output,
            "@_xt_interrupt_table = global [128 x i32]"
        ) == 1 &&
        !bootstrapTextContains(
            combined.output,
            "@_xt_interrupt_table = external global"
        ) &&
        !bootstrapTextContains(
            combined.output,
            "@_xt_exception_table = external global"
        ) &&
        countText(
            combined.output,
            "@Xthal_intlevel = constant [32 x i8]"
        ) == 1 &&
        bootstrapTextContains(
            combined.output,
            "ret i32 ptrtoint (ptr @xt_unhandled_interrupt to i32)"
        ) &&
        bootstrapTextContains(
            combined.output,
            "ret i32 ptrtoint (ptr @xt_unhandled_exception to i32)"
        )

    val exportedSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaOwnedDispatcherTableAddress(): u32\n@export(\"xt_unhandled_interrupt\")\ntrusted fun unhandled(index: u32): void { val observed = index; return }\n@export(\"owned_dispatcher_table_address\")\ntrusted fun ownTable(): u32 = nativeXtensaOwnedDispatcherTableAddress()\nfun main: int = 0\n"
    val exported = compileXtensa(exportedSource)
    passed = passed && exported.errors == 0 &&
        bootstrapTextContains(
            exported.output,
            "define void @xt_unhandled_interrupt(i32"
        ) &&
        countText(exported.output, "section \".iram1.text\"") == 2 &&
        !bootstrapTextContains(
            exported.output, "_xtensa_interrupt_entry"
        )

    val specialSource = "trusted noescape extern:\"inline-assembly\" fun assemblyReadU32(template: string, constraints: string): u32\ntrusted noescape extern:\"inline-assembly\" fun assemblyWriteU32(template: string, constraints: string, value: u32): void\n@export(\"xthal_special_state_nw\")\ntrusted fun specialState(value: u32): u32 {\n    assemblyWriteU32(\"wur.f64s $0\", \"a\", value)\n    assemblyReadU32(\"rur.threadptr $0\", \"=a\")\n}\nfun main: int = 0\n"
    val special = compileXtensa(specialSource)
    passed = passed && special.errors == 0 &&
        bootstrapTextContains(special.output, "rur.threadptr $0") &&
        bootstrapTextContains(special.output, "wur.f64s $0") &&
        bootstrapTextContains(
            special.output, "@xthal_special_state_nw = alias i32 (i32)"
        ) &&
        !bootstrapTextContains(special.output, "module asm")

    val nakedSource = "trusted noescape extern:\"inline-assembly\" fun assemblyU32(template: string, constraints: string): u32\n@naked\n@export([\"xthal_naked_nw\", \"xthal_naked_alias\"])\ntrusted fun nakedLeaf(): u32 = assemblyU32(\"movi.n a2, 7\\nret.n\", \"~{memory}\")\nfun main: int = 0\n"
    val naked = compileXtensa(nakedSource)
    passed = passed && naked.errors == 0 &&
        bootstrapTextContains(
            naked.output, "@xthal_naked_nw = alias i32 ()"
        ) &&
        bootstrapTextContains(
            naked.output, "@xthal_naked_alias = alias"
        ) &&
        countText(naked.output, "movi.n a2, 7\\0Aret.n") == 1 &&
        bootstrapTextContains(naked.output, "movi.n a2, 7\\0Aret.n") &&
        bootstrapTextContains(naked.output, "naked") &&
        bootstrapTextContains(naked.output, "unreachable") &&
        !bootstrapTextContains(naked.output, "target-features")

    val sectionSource = "trusted noescape extern:\"inline-assembly\" fun assemblyU32(template: string, constraints: string): u32\n@naked\n@section(\".fast.target.text\")\n@export(\"target_fast_leaf\")\ntrusted fun fastLeaf(): u32 = assemblyU32(\"movi.n a2, 9\\nret.n\", \"~{memory}\")\nfun main: int = 0\n"
    val sectioned = compileXtensa(sectionSource)
    passed = passed && sectioned.errors == 0 &&
        bootstrapTextContains(
            sectioned.output,
            "@target_fast_leaf = alias i32 ()"
        ) &&
        countText(sectioned.output, "section \".fast.target.text\"") == 1

    val invalidSectionSource = "@section(7)\nfun invalidSection(): int = 1\nfun main: int = 0\n"
    val invalidSection = compileXtensa(invalidSectionSource)
    passed = passed && invalidSection.errors > 0

    val noinlineSource = "@noinline\nfun retainedBoundary(value: int): int = value + 1\nfun main: int = retainedBoundary(41)\n"
    val noinline = compileXtensa(noinlineSource)
    passed = passed && noinline.errors == 0 &&
        bootstrapTextContains(noinline.output, "noinline") &&
        !bootstrapTextContains(noinline.output, "no-jump-tables")

    val conflictingInlineSource = "@inline\n@noinline\nfun conflicting(value: int): int = value\nfun main: int = conflicting(42)\n"
    val conflictingInline = compileXtensa(conflictingInlineSource)
    passed = passed && conflictingInline.errors > 0

    val framedSource = "trusted noescape extern:\"inline-assembly\" fun assemblyU32(template: string, constraints: string): u32\n@export(\"xthal_framed\")\ntrusted fun framedLeaf(): u32 = assemblyU32(\"movi.n $0, 7\", \"=a\")\nfun main: int = 0\n"
    val framed = compileXtensa(framedSource)
    passed = passed && framed.errors == 0 &&
        !bootstrapTextContains(framed.output, "naked") &&
        bootstrapTextContains(
            framed.output, "@xthal_framed = alias i32 ()"
        ) &&
        bootstrapTextContains(framed.output, "movi.n $0, 7")

    val invalidNakedSource = "trusted noescape extern:\"inline-assembly\" fun assemblyU32(template: string, constraints: string): u32\n@naked(\"xtensa\")\ntrusted fun invalidLeaf(): u32 = assemblyU32(\"ret.n\", \"~{memory}\")\nfun main: int = 0\n"
    val invalidNaked = compileXtensa(invalidNakedSource)
    passed = passed && invalidNaked.errors > 0

    if (passed) 42 else 1
}
