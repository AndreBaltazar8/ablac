import "../../../src/backend/llvm/backend.ab"
import "abla/sys/linux/io"

fun compileXtensa(source: string): BootstrapLlvmCompilation {
    val cache = bootstrapIrTransientState()
    bootstrapCompileLlvmParsedCached(
        bootstrapParseStaged(source),
        cache,
        "xtensa-esp-unknown-elf"
    )
}

fun countText(input: string, wanted: string): int {
    var count = 0
    var index = 0
    while (wanted.size > 0 && index + wanted.size <= input.size) {
        if (input.slice(index, index + wanted.size) == wanted) {
            count = count + 1
        }
        index = index + 1
    }
    count
}

fun main: int {
    val validSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptHandlerAddress(handler: Fn() -> void): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptTableAddress(): u32\nfun helper(): void { return }\nfun interruptHandler(): void { helper(); return }\ntrusted fun handlerAddress(): u32 = nativeXtensaInterruptHandlerAddress(interruptHandler)\ntrusted fun tableAddress(): u32 = nativeXtensaInterruptTableAddress()\nfun main: int = 0\n"
    val valid = compileXtensa(validSource)
    var passed = valid.errors == 0 &&
        bootstrapTextContains(
            valid.output,
            "_xtensa_interrupt_entry() section \".iram1.text\""
        ) &&
        countText(valid.output, "section \".iram1.text\"") == 3 &&
        bootstrapTextContains(
            valid.output,
            "ret i32 ptrtoint (ptr @"
        ) &&
        bootstrapTextContains(
            valid.output,
            "@_xt_interrupt_table = external global [128 x i32]"
        ) &&
        !bootstrapTextContains(valid.output, "call void @abla_function(")

    val aliasSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptHandlerAddress(handler: Fn() -> void): u32\nfun interruptHandler(): void { return }\ntrusted fun handlerAddress(): u32 { val alias = interruptHandler; nativeXtensaInterruptHandlerAddress(alias) }\nfun main: int = 0\n"
    val alias = compileXtensa(aliasSource)
    passed = passed && alias.errors > 0

    val closureSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptHandlerAddress(handler: Fn() -> void): u32\ntrusted fun handlerAddress(): u32 { val captured: u32 = 1; nativeXtensaInterruptHandlerAddress({ -> val ignored = captured; return }) }\nfun main: int = 0\n"
    val closure = compileXtensa(closureSource)
    passed = passed && closure.errors > 0

    val ownedSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaOwnedDispatcherTableAddress(): u32\ntrusted fun ownedTableAddress(): u32 = nativeXtensaOwnedDispatcherTableAddress()\nfun main: int = 0\n"
    val owned = compileXtensa(ownedSource)
    passed = passed && owned.errors == 0 &&
        bootstrapTextContains(
            owned.output,
            "@_xt_interrupt_table = global [128 x i32]"
        ) &&
        bootstrapTextContains(
            owned.output,
            "@_xt_exception_table = global [128 x i32]"
        ) &&
        bootstrapTextContains(owned.output, "align 8") &&
        bootstrapTextContains(owned.output, "i32 0") &&
        bootstrapTextContains(owned.output, "i32 63") &&
        countText(
            owned.output,
            "ptrtoint (ptr @xt_unhandled_interrupt to i32)"
        ) == 64 &&
        countText(
            owned.output,
            "ptrtoint (ptr @xt_unhandled_exception to i32)"
        ) == 128

    val combinedSource = "trusted noescape extern:\"intrinsic\" fun nativeXtensaInterruptTableAddress(): u32\ntrusted noescape extern:\"intrinsic\" fun nativeXtensaOwnedDispatcherTableAddress(): u32\ntrusted fun tableAddress(): u32 = nativeXtensaInterruptTableAddress()\ntrusted fun ownTable(): u32 = nativeXtensaOwnedDispatcherTableAddress()\nfun main: int = 0\n"
    val combined = compileXtensa(combinedSource)
    passed = passed && combined.errors == 0 &&
        countText(
            combined.output,
            "@_xt_interrupt_table = global [128 x i32]"
        ) == 1 &&
        !bootstrapTextContains(
            combined.output,
            "@_xt_interrupt_table = external global"
        )

    if (passed) 42 else 1
}
