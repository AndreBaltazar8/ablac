import "abla/build"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted noescape extern:"c" fun dlsym(handle: i64*, symbol: cstring): i64*

trusted fun nativeSymbol(name: string): i64* =
    dlsym(nativeNullPointer(), name)

val exportBias = 2
val voidZeroScore = nativeStaticAllocate(8)
val voidI32Score = nativeStaticAllocate(8)
val voidI32I32Score = nativeStaticAllocate(16)
val voidOpenGlAbiScore = nativeStaticAllocate(64)
val voidPointerI32Score = nativeStaticAllocate(8)
val voidPointerScore = nativeStaticAllocate(8)
val voidPointerI32I32Score = nativeStaticAllocate(16)
val voidPointerI64I32Score = nativeStaticAllocate(8)
val voidPointerI64I32I32Score = nativeStaticAllocate(8)
val voidPointerI64I64Score = nativeStaticAllocate(8)
val voidPointerI64I64I32Score = nativeStaticAllocate(8)
val voidPointerI64I64I32PointerScore = nativeStaticAllocate(8)
val voidPointerI64I64I64I32Score = nativeStaticAllocate(8)
val voidPointerI64I64I64PointerScore = nativeStaticAllocate(8)
val voidPointerI64I64I32I32Score = nativeStaticAllocate(8)
val voidPointerI64I64I64I64I32I32Score = nativeStaticAllocate(8)
val voidWideScalarScore = nativeStaticAllocate(8)
val voidImageCallScore = nativeStaticAllocate(8)
val voidPointerPointerScore = nativeStaticAllocate(8)
val voidPointer3Score = nativeStaticAllocate(8)
val voidCoreScore = nativeStaticAllocate(8)
val voidFinalScore = nativeStaticAllocate(8)

@export("abla_test_native_void0")
trusted fun nativeVoid0(): void {
    ablaUnsafeStoreI64(nativePointerFromAddress(voidZeroScore), 42)
    return
}

@export("abla_test_native_void_i32")
trusted fun nativeVoidI32(first: i32): void {
    ablaUnsafeStoreI64(nativePointerFromAddress(voidI32Score), first)
    return
}

@export("abla_test_native_void_i32_i32")
trusted fun nativeVoidI32I32(first: i32, second: i32): void {
    val score = nativePointerFromAddress(voidI32I32Score)
    ablaUnsafeStoreI64(score, first)
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(score, 8), second)
    return
}

trusted noescape fun nativeOpenGlAbiPassed(slot: int): void {
    val score = ablaUnsafePointerOffset(
        nativePointerFromAddress(voidOpenGlAbiScore), slot * 8
    )
    ablaUnsafeStoreI64(score, 42)
    return
}

@export("abla_test_native_void_i32_i32_i32")
trusted fun nativeVoidI32I32I32(first: i32, second: i32, third: i32): void {
    if (first == -1 && second == -2 && third == -3)
        nativeOpenGlAbiPassed(0)
    return
}

