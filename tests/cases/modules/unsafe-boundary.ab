trusted fun nativeOpenGlAbiScores(): bool {
    val score = nativePointerFromAddress(voidOpenGlAbiScore)
    var valid = true
    var slot = 0
    while (valid && slot < 8) {
        valid = ablaUnsafeLoadI64(
            ablaUnsafePointerOffset(score, slot * 8)
        ) == 42
        slot = slot + 1
    }
    valid
}

