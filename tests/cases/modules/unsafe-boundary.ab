import "abla/build"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted noescape extern:"c" fun dlsym(handle: i64*, symbol: cstring): i64*

trusted fun nativeSymbol(name: string): i64* =
    dlsym(nativeNullPointer(), name)

val exportBias = 2
val voidZeroScore = nativeStaticAllocate(8)
val voidI32Score = nativeStaticAllocate(8)
val voidI32I32Score = nativeStaticAllocate(16)
val voidPointerI32Score = nativeStaticAllocate(8)
val voidPointerScore = nativeStaticAllocate(8)
val voidPointerI32I32Score = nativeStaticAllocate(16)
val voidPointerPointerScore = nativeStaticAllocate(8)
val voidPointer3Score = nativeStaticAllocate(8)

@export("abla_test_native_void0")
trusted fun nativeVoid0(): void {
    ablaUnsafeStoreI64(nativePointerFromAddress(voidZeroScore), 42)
    return
}

@export("abla_test_native_void_i32")
trusted fun nativeVoidI32(first: i32): void {
    ablaUnsafeStoreI64(nativePointerFromAddress(voidI32Score), first)
    return
}

@export("abla_test_native_void_i32_i32")
trusted fun nativeVoidI32I32(first: i32, second: i32): void {
    val score = nativePointerFromAddress(voidI32I32Score)
    ablaUnsafeStoreI64(score, first)
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(score, 8), second)
    return
}

@export("abla_test_native_void_pointer_i32")
trusted fun nativeVoidPointerI32(first: int, second: i32): void {
    if (first > 0) {
        ablaUnsafeStoreI64(
            nativePointerFromAddress(voidPointerI32Score),
            second
        )
    }
    return
}

@export("abla_test_native_void_pointer")
trusted fun nativeVoidPointer(first: int): void {
    if (first > 0) {
        ablaUnsafeStoreI64(nativePointerFromAddress(voidPointerScore), 42)
    }
    return
}

@export("abla_test_native_void_pointer_i32_i32")
trusted fun nativeVoidPointerI32I32(
    first: int,
    second: i32,
    third: i32
): void {
    if (first > 0) {
        val score = nativePointerFromAddress(voidPointerI32I32Score)
        ablaUnsafeStoreI64(score, second)
        ablaUnsafeStoreI64(ablaUnsafePointerOffset(score, 8), third)
    }
    return
}

@export("abla_test_native_i32_pointer")
fun nativeI32Pointer(first: int): i32 = if (first > 0) -42 else 0

@export("abla_test_native_i32_pointer_i64")
fun nativeI32PointerI64(first: int, second: int): i32 = if (
    first > 0 && second == 1234605616436508552
) -43 else 0

@export("abla_test_native_i32_pointer_i64_pointer")
fun nativeI32PointerI64Pointer(
    first: int,
    second: int,
    third: int
): i32 = if (
    first > 0 && second == 1234605616436508552 && third > 0
) -47 else 0

@export("abla_test_native_i32_pointer_i64_pointer_pointer")
fun nativeI32PointerI64PointerPointer(
    first: int,
    second: int,
    third: int,
    fourth: int
): i32 = if (
    first > 0 && second == 1234605616436508552 &&
    third > 0 && fourth > 0
) -48 else 0

@export("abla_test_native_i32_pointer_i32_pointer")
fun nativeI32PointerI32Pointer(
    first: int,
    second: i32,
    third: int
): i32 = if (first > 0 && second == -1 && third > 0) -45 else 0

@export("abla_test_native_i32_pointer_pointer")
fun nativeI32PointerPointer(first: int, second: int): i32 = if (
    first > 0 && second > 0
) -46 else 0

@export("abla_test_native_void_pointer_pointer")
trusted fun nativeVoidPointerPointer(first: int, second: int): void {
    if (first > 0 && second > 0) {
        ablaUnsafeStoreI64(
            nativePointerFromAddress(voidPointerPointerScore), 42
        )
    }
    return
}

@export("abla_test_native_void_pointer_i32_pointer")
trusted fun nativeVoidPointerI32Pointer(
    first: int,
    second: i32,
    third: int
): void {
    if (first > 0 && second == -2 && third > 0) {
        ablaUnsafeStoreI64(nativePointerFromAddress(third), 42)
    }
    return
}

@export("abla_test_native_i32_pointer3")
fun nativeI32Pointer3(first: int, second: int, third: int): i32 = if (
    first > 0 && second > 0 && third > 0
) -44 else 0

@export("abla_test_native_void_pointer3")
trusted fun nativeVoidPointer3(
    first: int,
    second: int,
    third: int
): void {
    if (first > 0 && second > 0 && third > 0) {
        ablaUnsafeStoreI64(nativePointerFromAddress(voidPointer3Score), 42)
    }
    return
}

@export("abla_test_native_pointer4")
fun nativePointer4(first: int, second: int, third: int, fourth: int): i32 {
    if (first > 0 && second > 0 && third > 0 && fourth > 0) 40 + exportBias
    else 0
}

@export("abla_test_native_void_pointer_int_pointer")
trusted fun nativeVoidPointerIntPointer(
    first: int,
    second: int,
    third: int
): void {
    if (first > 0 && second == 17 && third > 0) {
        ablaUnsafeStoreI64(nativePointerFromAddress(third), 42)
    }
    return
}

@export("abla_test_native_void_pointer_int_int_pointer")
trusted fun nativeVoidPointerIntIntPointer(
    first: int,
    second: u32,
    third: u32,
    fourth: int
): void {
    if (first > 0 && second == 17 && third == 19 && fourth > 0) {
        ablaUnsafeStoreI64(nativePointerFromAddress(fourth), 42)
    }
    return
}

trusted fun rawMemoryRoundTrip(): int {
    val pointer = ablaUnsafeAllocate(8)
    ablaUnsafeStoreI64(pointer, 42)
    val direct = ablaUnsafeLoadI64(pointer)
    ablaUnsafeFree(pointer)
    direct
}

trusted fun nativeVoid0Score(): int =
    ablaUnsafeLoadI64(nativePointerFromAddress(voidZeroScore))

trusted fun nativeI32Scores(): bool =
    ablaUnsafeLoadI64(nativePointerFromAddress(voidI32Score)) == -1 &&
    ablaUnsafeLoadI64(nativePointerFromAddress(voidI32I32Score)) == -2 &&
    ablaUnsafeLoadI64(ablaUnsafePointerOffset(
        nativePointerFromAddress(voidI32I32Score), 8
    )) == -2147483648

trusted fun nativePointerI32Score(): int =
    ablaUnsafeLoadI64(nativePointerFromAddress(voidPointerI32Score))

trusted fun nativePointerScore(): int =
    ablaUnsafeLoadI64(nativePointerFromAddress(voidPointerScore))

trusted fun nativePointerPointerScore(): int =
    ablaUnsafeLoadI64(nativePointerFromAddress(voidPointerPointerScore))

trusted fun nativePointer3Score(): int =
    ablaUnsafeLoadI64(nativePointerFromAddress(voidPointer3Score))

trusted fun nativePointerI32I32Scores(): bool =
    ablaUnsafeLoadI64(
        nativePointerFromAddress(voidPointerI32I32Score)
    ) == -3 &&
    ablaUnsafeLoadI64(ablaUnsafePointerOffset(
        nativePointerFromAddress(voidPointerI32I32Score), 8
    )) == -2147483648

fun main: int {
    val cell = nativeI64Cell(41)
    val loaded = cell.load()
    val released = cell.close()
    val releasedAgain = cell.close()
    val closedLoad = cell.load()
    cell.store(99)
    val closedLoadAfterStore = cell.load()

    val direct = rawMemoryRoundTrip()
    val atomic = nativeI64Cell(7)
    val atomicFirst = nativeAtomicFetchAddI64(atomic.address, 5)
    val atomicSecond = nativeAtomicFetchAddI64(atomic.address, -2)
    val first = nativeI64Cell(1)
    val second = nativeI64Cell(2)
    val third = nativeI64Cell(3)
    val fourth = nativeI64Cell(4)
    val pointer4 = nativeSymbol("abla_test_native_pointer4")
    val indirect = callNativeI32Pointer4(
        nativePointerAddress(pointer4),
        first.address,
        second.address,
        third.address,
        fourth.address
    )
    callNativeVoid0(nativePointerAddress(nativeSymbol(
        "abla_test_native_void0"
    )))
    callNativeVoidI32(nativePointerAddress(nativeSymbol(
        "abla_test_native_void_i32"
    )), 4294967295)
    callNativeVoidI32I32(nativePointerAddress(nativeSymbol(
        "abla_test_native_void_i32_i32"
    )), 4294967294, 2147483648)
    callNativeVoidPointerI32(nativePointerAddress(nativeSymbol(
        "abla_test_native_void_pointer_i32"
    )), first.address, 4294967295)
    callNativeVoidPointer(nativePointerAddress(nativeSymbol(
        "abla_test_native_void_pointer"
    )), first.address)
    callNativeVoidPointerI32I32(nativePointerAddress(nativeSymbol(
        "abla_test_native_void_pointer_i32_i32"
    )), first.address, 4294967293, 2147483648)
    val indirectI32Pointer = callNativeI32Pointer(
        nativePointerAddress(nativeSymbol("abla_test_native_i32_pointer")),
        first.address
    )
    val indirectI32PointerI64 = callNativeI32PointerI64(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_i32_pointer_i64"
        )),
        first.address,
        1234605616436508552
    )
    val indirectI32PointerI64Pointer = callNativeI32PointerI64Pointer(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_i32_pointer_i64_pointer"
        )),
        first.address,
        1234605616436508552,
        second.address
    )
    val indirectI32PointerI64PointerPointer =
        callNativeI32PointerI64PointerPointer(
            nativePointerAddress(nativeSymbol(
                "abla_test_native_i32_pointer_i64_pointer_pointer"
            )),
            first.address,
            1234605616436508552,
            second.address,
            third.address
        )
    val indirectI32PointerI32Pointer = callNativeI32PointerI32Pointer(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_i32_pointer_i32_pointer"
        )),
        first.address,
        4294967295,
        second.address
    )
    val indirectI32PointerPointer = callNativeI32PointerPointer(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_i32_pointer_pointer"
        )),
        first.address,
        second.address
    )
    callNativeVoidPointerPointer(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_void_pointer_pointer"
        )),
        first.address,
        second.address
    )
    val indirectVoidPointerI32PointerScore = nativeI64Cell(0)
    callNativeVoidPointerI32Pointer(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_void_pointer_i32_pointer"
        )),
        first.address,
        4294967294,
        indirectVoidPointerI32PointerScore.address
    )
    val indirectI32Pointer3 = callNativeI32Pointer3(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_i32_pointer3"
        )),
        first.address,
        second.address,
        third.address
    )
    callNativeVoidPointer3(
        nativePointerAddress(nativeSymbol(
            "abla_test_native_void_pointer3"
        )),
        first.address,
        second.address,
        third.address
    )
    val voidPointerIntPointer = nativeSymbol(
        "abla_test_native_void_pointer_int_pointer"
    )
    val indirectVoidScore = nativeI64Cell(0)
    callNativeVoidPointerIntPointer(
        nativePointerAddress(voidPointerIntPointer),
        first.address,
        17,
        indirectVoidScore.address
    )
    val voidPointerIntIntPointer = nativeSymbol(
        "abla_test_native_void_pointer_int_int_pointer"
    )
    val indirectVoidIntIntScore = nativeI64Cell(0)
    callNativeVoidPointerIntIntPointer(
        nativePointerAddress(voidPointerIntIntPointer),
        first.address,
        17,
        19,
        indirectVoidIntIntScore.address
    )
    if (
        loaded == 41 && released && !releasedAgain &&
        closedLoad == 0 && closedLoadAfterStore == 0 &&
        direct == 42 && atomicFirst == 7 && atomicSecond == 12 &&
        atomic.load() == 10 && indirect == 42 &&
        nativeVoid0Score() == 42 &&
        nativeI32Scores() &&
        nativePointerI32Score() == -1 &&
        nativePointerScore() == 42 &&
        nativePointerI32I32Scores() &&
        indirectI32Pointer == -42 &&
        indirectI32PointerI64 == -43 &&
        indirectI32PointerI64Pointer == -47 &&
        indirectI32PointerI64PointerPointer == -48 &&
        indirectI32PointerI32Pointer == -45 &&
        indirectI32PointerPointer == -46 &&
        nativePointerPointerScore() == 42 &&
        indirectVoidPointerI32PointerScore.load() == 42 &&
        indirectI32Pointer3 == -44 &&
        nativePointer3Score() == 42 &&
        indirectVoidScore.load() == 42 &&
        indirectVoidIntIntScore.load() == 42
    ) 42 else 0
}
