trusted fun nativeAddWideScalarScore(bit: int): void {
    val score = nativePointerFromAddress(voidWideScalarScore)
    ablaUnsafeStoreI64(score, ablaUnsafeLoadI64(score) + bit)
    return
}

trusted fun nativeAddImageCallScore(bit: int): void {
    val score = nativePointerFromAddress(voidImageCallScore)
    ablaUnsafeStoreI64(score, ablaUnsafeLoadI64(score) + bit)
    return
}

