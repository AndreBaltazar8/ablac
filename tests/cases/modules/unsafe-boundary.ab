trusted noescape fun nativeStoreAtZero(pointer: i64*, value: int): void {
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(pointer, 0), value)
    return
}

trusted fun rawMemoryRoundTrip(): int {
    val pointer = ablaUnsafeAllocate(8)
    nativeStoreAtZero(pointer, 42)
    val direct = ablaUnsafeLoadI64(pointer)
    ablaUnsafeFree(pointer)
    direct
}

