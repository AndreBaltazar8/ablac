import "abla/net"
import "abla/random"
import "abla/websocket"

fun main: int {
    val socket = udpBindPort(0)
    val port = socket.localPort()
    val poller = socketPoller()
    val watched = poller.watchDescriptor(socket.descriptor)
    val idle = poller.wait(4, 0)
    val entropy = secureRandomBytes(16)
    val frame = webSocketEncodeFrame("raw", 2)
    val decoded = webSocketDecodeFrame(frame, 16)
    poller.close()
    socket.close()
    if (port > 0 && watched && idle.timedOut && entropy.succeeded &&
        entropy.bytes.size == 16 && decoded.succeeded() &&
        decoded.frame.payload == "raw") 42 else 1
}
