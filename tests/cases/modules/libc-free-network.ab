import "abla/net"
import "abla/random"
import "abla/websocket"

fun rawScatterWrite(): bool {
    val listener = tcpListen(0)
    val client = tcpConnectIpv4("127.0.0.1", listener.localPort(), 1000)
    val server = listener.accept()
    var payload = "xx"
    var index = 0
    while (index < 70) {
        payload = "$payload!"
        index = index + 1
    }
    val sent = client.writeCompact(payload, 2)
    val received = server.readWithTimeoutResult(128, 1000)
    client.close()
    server.close()
    listener.close()
    sent.succeeded() && sent.written == 70 && received.hasData() &&
        received.bytes.size == 70
}

fun main: int {
    val socket = udpBindPort(0)
    val port = socket.localPort()
    val poller = socketPoller()
    val watched = poller.watchDescriptor(socket.descriptor)
    val idle = poller.wait(4, 0)
    val entropy = secureRandomBytes(16)
    val frame = webSocketEncodeFrame("raw", 2)
    val decoded = webSocketDecodeFrame(frame, 16)
    poller.close()
    socket.close()
    if (port > 0 && watched && idle.timedOut && rawScatterWrite() &&
        entropy.succeeded &&
        entropy.bytes.size == 16 && decoded.succeeded() &&
        decoded.frame.payload == "raw") 42 else 1
}
