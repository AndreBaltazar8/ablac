// A read count above its buffer (Windows once answered a failed recv with 4294967295) ends the process with status 101 and a message:
// linuxCheckCount and linuxExactString never turn it into a string, a copy or an offset. "ok": a count at the limit passes.
import "abla/io"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/unsafe/memory"

fun main: int {
    val mode = processArgument(0)
    if (mode == "check") {
        linuxCheckCount(65537, 65536)
        println("not reached")
        return 0
    }
    if (mode == "exact") {
        val buffer = nativeByteBuffer(9)
        val text = linuxExactString(buffer, 4294967295, 9)
        println("not reached ${text.size}")
        return 0
    }
    linuxCheckCount(65536, 65536)
    linuxCheckCount(0, 65536)
    linuxCheckCount(-4, 65536)
    val buffer = nativeByteBuffer(9)
    println("exact ${linuxExactString(buffer, 8, 9).size}")
    42
}
