import "abla/fs"

fun main: int {
    val root = path("build/filesystem-test")
    val file = root.child("hello.abla.txt")
    val created = root.createDirectories()
    val written = file.writeTextAtomic("hello")
    val before = file.info()
    val watcher = watchFile(file)
    val initiallyStable = !watcher.changed()
    file.writeTextAtomic("hello, abla")
    val detected = watcher.changed()
    watcher.refresh()
    val refreshed = !watcher.changed()
    val entries = root.entries()
    val read = file.readText()
    val name = file.name()
    val extension = file.extension()
    val link = root.child("hello.link")
    val linked = link.linkTo("hello.abla.txt")
    val linkHeld = link.linkTarget() == "hello.abla.txt"
    val linkItself = link.linkInfo().kind == 4
    val throughLink = link.readText() == "hello, abla"
    val removedLink = link.remove()
    val removedFile = file.remove()
    val removedRoot = root.remove()
    if (
        created && written && before.isFile() && before.size == 5 &&
        initiallyStable && detected && refreshed && entries.size == 1 &&
        read == "hello, abla" && name == "hello.abla.txt" &&
        extension == "txt" && linked && linkHeld && linkItself &&
        throughLink && removedLink && removedFile && removedRoot
    ) 42 else 0
}
