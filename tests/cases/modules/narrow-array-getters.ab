// Packed integer arrays keep their element width and sign through direct,
// generic, iteration, parameter, arithmetic, mutation and reboxing paths.
@noinline
fun <T> narrowRead(values: array<T>, index: int): T = values[index]

fun main: int {
    var failures = 0
    val valuesi8: array<i8> = [i8(-128), i8(-1), i8(127)]
    if (valuesi8[0] != i8(-128) || narrowRead(valuesi8, 0) != i8(-128)) failures += 1
    if (valuesi8[1] != i8(-1) || narrowRead(valuesi8, 1) != i8(-1)) failures += 1
    if (valuesi8[2] != i8(127) || narrowRead(valuesi8, 2) != i8(127)) failures += 1
    var totali8: i8 = i8(0)
    for (value in valuesi8) totali8 += value
    if (totali8 != (i8(-128) + i8(-1)) + i8(127)) failures += 1
    valuesi8[0] = i8(127)
    if (narrowRead(valuesi8, 0) != i8(127)) failures += 1
    valuesi8[0] += i8(1)
    if (valuesi8[0] != (i8(127) + i8(1))) failures += 1
    val erasedi8: any = valuesi8[1]
    if (erasedi8 != i8(-1)) failures += 1
    val valuesu8: array<u8> = [u8(0), u8(128), u8(255)]
    if (valuesu8[0] != u8(0) || narrowRead(valuesu8, 0) != u8(0)) failures += 1
    if (valuesu8[1] != u8(128) || narrowRead(valuesu8, 1) != u8(128)) failures += 1
    if (valuesu8[2] != u8(255) || narrowRead(valuesu8, 2) != u8(255)) failures += 1
    var totalu8: u8 = u8(0)
    for (value in valuesu8) totalu8 += value
    if (totalu8 != (u8(0) + u8(128)) + u8(255)) failures += 1
    valuesu8[0] = u8(255)
    if (narrowRead(valuesu8, 0) != u8(255)) failures += 1
    valuesu8[0] += u8(1)
    if (valuesu8[0] != (u8(255) + u8(1))) failures += 1
    val erasedu8: any = valuesu8[1]
    if (erasedu8 != u8(128)) failures += 1
    val valuesi16: array<i16> = [i16(-32768), i16(-1), i16(32767)]
    if (valuesi16[0] != i16(-32768) || narrowRead(valuesi16, 0) != i16(-32768)) failures += 1
    if (valuesi16[1] != i16(-1) || narrowRead(valuesi16, 1) != i16(-1)) failures += 1
    if (valuesi16[2] != i16(32767) || narrowRead(valuesi16, 2) != i16(32767)) failures += 1
    var totali16: i16 = i16(0)
    for (value in valuesi16) totali16 += value
    if (totali16 != (i16(-32768) + i16(-1)) + i16(32767)) failures += 1
    valuesi16[0] = i16(32767)
    if (narrowRead(valuesi16, 0) != i16(32767)) failures += 1
    valuesi16[0] += i16(1)
    if (valuesi16[0] != (i16(32767) + i16(1))) failures += 1
    val erasedi16: any = valuesi16[1]
    if (erasedi16 != i16(-1)) failures += 1
    val valuesu16: array<u16> = [u16(0), u16(32768), u16(65535)]
    if (valuesu16[0] != u16(0) || narrowRead(valuesu16, 0) != u16(0)) failures += 1
    if (valuesu16[1] != u16(32768) || narrowRead(valuesu16, 1) != u16(32768)) failures += 1
    if (valuesu16[2] != u16(65535) || narrowRead(valuesu16, 2) != u16(65535)) failures += 1
    var totalu16: u16 = u16(0)
    for (value in valuesu16) totalu16 += value
    if (totalu16 != (u16(0) + u16(32768)) + u16(65535)) failures += 1
    valuesu16[0] = u16(65535)
    if (narrowRead(valuesu16, 0) != u16(65535)) failures += 1
    valuesu16[0] += u16(1)
    if (valuesu16[0] != (u16(65535) + u16(1))) failures += 1
    val erasedu16: any = valuesu16[1]
    if (erasedu16 != u16(32768)) failures += 1
    val valuesi32: array<i32> = [i32(-2147483648), i32(-1), i32(2147483647)]
    if (valuesi32[0] != i32(-2147483648) || narrowRead(valuesi32, 0) != i32(-2147483648)) failures += 1
    if (valuesi32[1] != i32(-1) || narrowRead(valuesi32, 1) != i32(-1)) failures += 1
    if (valuesi32[2] != i32(2147483647) || narrowRead(valuesi32, 2) != i32(2147483647)) failures += 1
    var totali32: i32 = i32(0)
    for (value in valuesi32) totali32 += value
    if (totali32 != (i32(-2147483648) + i32(-1)) + i32(2147483647)) failures += 1
    valuesi32[0] = i32(2147483647)
    if (narrowRead(valuesi32, 0) != i32(2147483647)) failures += 1
    valuesi32[0] += i32(1)
    if (valuesi32[0] != (i32(2147483647) + i32(1))) failures += 1
    val erasedi32: any = valuesi32[1]
    if (erasedi32 != i32(-1)) failures += 1
    val valuesu32: array<u32> = [u32(0), u32(2147483648), u32(4294967295)]
    if (valuesu32[0] != u32(0) || narrowRead(valuesu32, 0) != u32(0)) failures += 1
    if (valuesu32[1] != u32(2147483648) || narrowRead(valuesu32, 1) != u32(2147483648)) failures += 1
    if (valuesu32[2] != u32(4294967295) || narrowRead(valuesu32, 2) != u32(4294967295)) failures += 1
    var totalu32: u32 = u32(0)
    for (value in valuesu32) totalu32 += value
    if (totalu32 != (u32(0) + u32(2147483648)) + u32(4294967295)) failures += 1
    valuesu32[0] = u32(4294967295)
    if (narrowRead(valuesu32, 0) != u32(4294967295)) failures += 1
    valuesu32[0] += u32(1)
    if (valuesu32[0] != (u32(4294967295) + u32(1))) failures += 1
    val erasedu32: any = valuesu32[1]
    if (erasedu32 != u32(2147483648)) failures += 1
    val valuesu64: array<u64> = [u64(0), u64(9223372036854775807), u64(9223372036854775807) + u64(1)]
    if (valuesu64[0] != u64(0) || narrowRead(valuesu64, 0) != u64(0)) failures += 1
    if (valuesu64[1] != u64(9223372036854775807) || narrowRead(valuesu64, 1) != u64(9223372036854775807)) failures += 1
    if (valuesu64[2] != u64(9223372036854775807) + u64(1) || narrowRead(valuesu64, 2) != u64(9223372036854775807) + u64(1)) failures += 1
    var totalu64: u64 = u64(0)
    for (value in valuesu64) totalu64 += value
    if (totalu64 != (u64(0) + u64(9223372036854775807)) + u64(9223372036854775807) + u64(1)) failures += 1
    valuesu64[0] = u64(9223372036854775807) + u64(1)
    if (narrowRead(valuesu64, 0) != u64(9223372036854775807) + u64(1)) failures += 1
    valuesu64[0] += u64(1)
    if (valuesu64[0] != (u64(9223372036854775807) + u64(1) + u64(1))) failures += 1
    val erasedu64: any = valuesu64[1]
    if (erasedu64 != u64(9223372036854775807)) failures += 1
    val valueschar: array<char> = [char(0), char(128), char(255)]
    if (valueschar[0] != char(0) || narrowRead(valueschar, 0) != char(0)) failures += 1
    if (valueschar[1] != char(128) || narrowRead(valueschar, 1) != char(128)) failures += 1
    if (valueschar[2] != char(255) || narrowRead(valueschar, 2) != char(255)) failures += 1
    var totalchar: char = char(0)
    for (value in valueschar) totalchar += value
    if (totalchar != (char(0) + char(128)) + char(255)) failures += 1
    valueschar[0] = char(255)
    if (narrowRead(valueschar, 0) != char(255)) failures += 1
    valueschar[0] = char(40)
    valueschar[0] += char(1)
    if (valueschar[0] != char(41)) failures += 1
    val erasedchar: any = valueschar[1]
    if (erasedchar != char(128)) failures += 1
    if (failures == 0) 42 else failures
}
