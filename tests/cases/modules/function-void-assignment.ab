import "abla/io"
class Box(var n: int) {
    fun bump(): void {
        n = n + 1
    }
}
fun Box.twice(): void {
    this.n = this.n * 2
}
var counter = 0
fun count(): void {
    counter = counter + 10
}
fun fill(var values: array<int>): void {
    values[0] = 7
}
fun staged(): int {
    val box = Box(1)
    box.bump()
    box.twice()
    val values = [0]
    fill(values)
    box.n + values[0]
}
fun main: int {
    val box = Box(4)
    box.bump()
    box.twice()
    count()
    val values = [0]
    fill(values)
    // 10 + 10 + 7 at runtime, 4 + 7 under `#`; the exit status is 27 + 15.
    println("${counter + box.n + values[0]} ${#staged()}")
    counter + box.n + values[0] + 15
}
