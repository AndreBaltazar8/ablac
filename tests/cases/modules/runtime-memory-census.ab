// The heap census counts what memoryLiveBytes() does, by layout, and the
// instances' declared fields by the tag of the value each holds.
import "abla/memory"

class Marker(var x: f64, var y: f64, var label: string, var seen: bool)

fun sum(values: array<int>): int {
    var total = 0
    for (value in values) total = total + value
    total
}

fun main: int {
    memoryCollect()
    val before = memoryCensus()
    val markers: array<Marker> = []
    for (index in 0 until 100) markers.append(Marker(1.0, 2.0, "m$index", false))
    memoryCollect()
    val live = memoryLiveBytes()
    val after = memoryCensus()
    val instances = after.counts[5] - before.counts[5]
    val instanceBytes = after.bytes[5] - before.bytes[5]
    val floats = after.fieldTags[2] - before.fieldTags[2]
    val strings = after.fieldTags[4] - before.fieldTags[4]
    val flags = after.fieldTags[3] - before.fieldTags[3]
    // Each allocation costs at least its header past its payload.
    val headers = after.overhead >= (sum(after.counts) * 32)
    // The markers, and `before` (a MemoryCensus: 3 arrays and an int).
    if (instances == 101 && instanceBytes == 100 * (32 + 4 * 32) + (32 + 4 * 32) &&
        floats == 201 && strings == 100 && flags == 100 && headers &&
        sum(after.bytes) == live && markers.size == 100) 42 else 1
}
