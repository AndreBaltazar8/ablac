import "abla/compiler"
import "abla/compiler/parser"

class MutableLiftState(var value: int)

fun mutateLiftState(var state: MutableLiftState): void {
    state.value = state.value + 1
    return
}

compile fun finalizeImmutableCapture(
    payload: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val module = compilerGeneratedModule(
        "reactive.invalid.immutable",
        expression
    )
    val captures: array<string> = ["state"]
    val names: array<string> = ["captured"]
    val types: array<int> = [compilerFindType("MutableLiftState")]
    val mutable: array<bool> = [false]
    compilerGeneratedLiftedFunction(
        module,
        "invalidImmutable",
        captures,
        names,
        types,
        mutable,
        compilerFindType("void"),
        expression
    )
    module
}

compile fun parseImmutableCapture(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "reactive.invalid.immutable",
        "invalidImmutable",
        expression,
        finalizeImmutableCapture
    )
    expression
}

#compilerRegisterSubparser("immutableCapture", parseImmutableCapture)

fun inspect(var state: MutableLiftState): void {
    $immutableCapture(mutateLiftState(state))
    return
}

fun main: int {
    val state = MutableLiftState(1)
    inspect(state)
    state.value
}
