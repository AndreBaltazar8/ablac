fun measure(text: string): int {
    val values = [10]
    values.append(text[0])
    values.append(text.size)
    values.size + values[0] + values[1] - values[2] - 34
}

fun main: int {
    val compileResult = #measure("AZ")
    if (
        measure("AZ") == compileResult &&
        "AZ".slice(1, 2) == "Z" &&
        #"bootstrap".slice(0, 4) == "boot"
    ) 42 else 0
}
