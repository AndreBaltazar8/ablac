// `own` and `region` are keywords only where they introduce an owned
// parameter or a region block; elsewhere they are ordinary names.
class Slot(val own: int, val region: string)

class Area(val name: string) {
    fun region(): string = this.name
    fun own(): int = this.name.size
}

fun region(own: int): int = own * 2

fun consumeOnce(own callback: FnOnce() -> int): int = callback()

fun doubledRegion(): int = region(3)

fun main: int {
    val own = 3
    var region = 4
    region = region + own
    val slot = Slot(own, "north")
    val area = Area("west")
    val inRegion = region {
        val values = [1, 2, 3]
        values.size
    }
    val once: FnOnce() -> int = move { -> 5 }
    val owned = consumeOnce(move(once))
    if (region == 7 && slot.own == 3 && slot.region == "north" &&
        area.region() == "west" && area.own() == 4 &&
        doubledRegion() == 6 && inRegion == 3 && owned == 5) 42 else 1
}
