import "../../../src/backend/llvm/backend.ab"

// The lowered-code cache keeps a function whose `#` code asked about a
// conformance only while the answer holds: when only `extend` changes, a
// rebuild with the cache must equal one without it.

fun compileWithIrCache(
    source: string,
    var cache: BootstrapIrCacheState
): BootstrapLlvmCompilation {
    cache.beginBuild()
    bootstrapCompileLlvmParsedCached(
        bootstrapParseStaged(source), cache, "x86_64-unknown-linux-gnu"
    )
}

fun program(conformances: string): string =
    "compile extern:\"compiler\" fun compilerFindClass(name: string): int\n" +
    "compile extern:\"compiler\" fun compilerConformanceCount(handle: int): int\n" +
    "interface Named {\n    fun name(): int\n}\n" +
    "interface Hashable {\n    fun hash(): int\n}\n" +
    "class Key(val n: int)\n" +
    "fun Key.name(): int = 1\n" +
    "fun Key.hash(): int = this.n\n" +
    "extend Key : $conformances\n" +
    "fun count(): int = #compilerConformanceCount(compilerFindClass(\"Key\"))\n" +
    "fun main: int = count()\n"

fun main: int {
    var cache = bootstrapIrCacheState()
    val first = compileWithIrCache(program("Named"), cache)
    val cached = compileWithIrCache(program("Named, Hashable"), cache)
    // The rebuild reused functions: the cache was in play.
    val reused = cache.reused
    var fresh = bootstrapIrCacheState()
    val alone = compileWithIrCache(program("Named, Hashable"), fresh)
    val passed = first.errors == 0 && cached.errors == 0 && alone.errors == 0 &&
        reused > 0 && first.output != alone.output && cached.output == alone.output
    if (passed) 42 else 1
}
