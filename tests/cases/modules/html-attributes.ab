import "abla/html"
import "abla/text"

fun main: int {
    val url = "/help?q=\"a&b\""
    val label = "<Help & 'support'>"
    val anchor = $html <a href={url} aria-label="Help">{label}</a>
    val image = $html <img src="/logo.svg" alt={label}>
    val wrapped = $html <section>{anchor}{image}{ablaHtmlRaw("<hr>")}</section>
    val attributes = [ablaHtmlAttribute("title", label), ablaHtmlBooleanAttribute("disabled")]
    val button = $html <button type="button" {attributes}>Open</button>
    if (wrapped.render() != "<section><a href=\"/help?q=&quot;a&amp;b&quot;\" aria-label=\"Help\">&lt;Help &amp; &#39;support&#39;&gt;</a><img src=\"/logo.svg\" alt=\"&lt;Help &amp; &#39;support&#39;&gt;\"><hr></section>") return 1
    if (button.render() != "<button type=\"button\" title=\"&lt;Help &amp; &#39;support&#39;&gt;\" disabled>Open</button>") return 1
    val frozen = #$html <meta name="answer" content={"42"}>
    if (frozen.render() != "<meta name=\"answer\" content=\"42\">") return 1
    val vector = $html <svg viewBox="0 0 1 1"><path d="M0 0"/></svg>
    if (vector.render() != "<svg viewBox=\"0 0 1 1\"><path d=\"M0 0\"/></svg>") return 1
    val entities = $html <p title='A &amp; B'>A &amp; B</p>
    if (entities.render() != "<p title='A &amp; B'>A &amp; B</p>") return 1
    val invalid = [ablaHtmlAttribute("name onload", "bad")]
    val guarded = $html <p {invalid}>Ok</p>
    if (guarded.render() != "<p>Ok</p>") return 1
    val script = $html <script>{label}{ablaHtmlRaw("window.ready=true")}</script>
    if (script.render() != "<script>window.ready=true</script>") return 1
    // Inside svg a script still runs (and one under foreignObject is an HTML script): a text hole there is left out as it is in HTML.
    val payload = "alert(1)"
    val vectorScript = $html <svg><script>{payload}{ablaHtmlRaw("window.ready=true")}</script></svg>
    if (vectorScript.render() != "<svg><script>window.ready=true</script></svg>") return 1
    val integrated = $html <svg><foreignObject><script>{payload}</script></foreignObject></svg>
    if (integrated.render() != "<svg><foreignObject><script></script></foreignObject></svg>") return 1
    val vectorStyle = $html <svg><style>{payload}</style><text>{payload}</text></svg>
    if (vectorStyle.render() != "<svg><style></style><text>alert(1)</text></svg>") return 1
    // A hole in a URL attribute refuses javascript:, vbscript: and data:, in any case, with whitespace or control characters anywhere,
    // and behind character references; other URLs, relative ones included, are kept.
    val unsafe = ["javascript:alert(1)", "JaVaScRiPt:alert(1)", "java\tscript:alert(1)", "java\nscript:x", " \u{1}javascript:x",
        "&#106;avascript:x", "&#x6A;avascript:x", "&#106avascript:x", "javascript&colon;x", "jav&Tab;ascript:x", "vbscript:msgbox(1)",
        "VBScript:x", "data:text/html,<script>alert(1)</script>", "DATA:image/svg+xml,x", "j\u{0}avascript:x"]
    for (url in unsafe) {
        val link = $html <a href={url}>x</a>
        if (link.render() != "<a href=\"about:invalid#abla-unsafe-url\">x</a>") return 2
        val form = $html <form action={url}><button formaction={url}>x</button></form>
        if (form.render().contains("script") || form.render().contains("data:")) return 3
        val image = $html <img src={url}>
        if (image.render() != "<img src=\"about:invalid#abla-unsafe-url\">") return 4
        val grouped = [ablaHtmlAttribute("href", url)]
        val viaGroup = $html <a {grouped}>x</a>
        if (viaGroup.render() != "<a href=\"about:invalid#abla-unsafe-url\">x</a>") return 5
        val vectorLink = $html <svg><a xlink:href={url}>x</a></svg>
        if (!vectorLink.render().contains("about:invalid#abla-unsafe-url")) return 6
    }
    val safe = ["/path?q=1", "https://example.com/a:b", "mailto:a@example.com", "relative/javascript:x", "?javascript:x", "#data:x",
        "javascripts:x", "datas:x", ""]
    for (url in safe) {
        val link = $html <a href={url}>x</a>
        if (link.render() != "<a href=\"${ablaHtmlText(url).render()}\">x</a>") return 7
    }
    // Other attributes, authored values and the trusted escape hatch are not rewritten.
    val titled = $html <a title={"javascript:x"} href="javascript:void(0)">x</a>
    if (titled.render() != "<a title=\"javascript:x\" href=\"javascript:void(0)\">x</a>") return 8
    val checked = [ablaHtmlTrustedAttribute("src", "data:image/png;base64,AAAA")]
    val pixel = $html <img {checked}>
    if (pixel.render() != "<img src=\"data:image/png;base64,AAAA\">") return 9
    // An event handler from Abla is left out unless trusted (a hole in one is a compile error, see the docs' examples).
    val handlers = [ablaHtmlAttribute("onclick", "alert(1)"), ablaHtmlAttribute("OnMouseOver", "alert(1)"), ablaHtmlTrustedAttribute("onload", "start()")]
    val handled = $html <body {handlers} onunload="stop()">x</body>
    if (handled.render() != "<body onload=\"start()\" onunload=\"stop()\">x</body>") return 10
    // srcdoc is a document whose scripts run: from Abla it is left out (a hole is a compile error), trusted it is kept, escaped.
    val documents = [ablaHtmlAttribute("srcdoc", "<script>alert(1)</script>"), ablaHtmlAttribute("SRCDOC", "<p>x</p>"), ablaHtmlAttribute("title", "t")]
    val framed = $html <iframe {documents}></iframe>
    if (framed.render() != "<iframe title=\"t\"></iframe>") return 11
    val ownDocument = [ablaHtmlTrustedAttribute("srcdoc", "<p>hi</p>")]
    val ownFrame = $html <iframe {ownDocument}></iframe>
    if (ownFrame.render() != "<iframe srcdoc=\"&lt;p&gt;hi&lt;/p&gt;\"></iframe>") return 12
    // An SVG animation's values, to, from and by set the animated attribute: each ;-item is held to the URL policy.
    val js = "JaVa\tScript:alert(1)"
    for (tag in ["animate", "set", "animateMotion", "animateTransform"]) for (name in ["values", "to", "from", "by"]) {
        val animation = [ablaHtmlAttribute(name, "#a; $js;/b")]
        val node = ablaHtmlElementWithAttributes("svg", [ablaHtmlElementWithAttributes(tag, [], [animation], true)], [])
        if (node.render() != "<svg><$tag $name=\"#a;about:invalid#abla-unsafe-url;/b\"/></svg>") return 13
    }
    val numbers = [ablaHtmlAttribute("values", "0;1;0.5")]
    val fade = $html <svg><animate attributeName="opacity" {numbers}/></svg>
    if (fade.render() != "<svg><animate attributeName=\"opacity\" values=\"0;1;0.5\"/></svg>") return 14
    // values elsewhere (a feColorMatrix's numbers, say) is not a URL list.
    val matrix = [ablaHtmlAttribute("values", "javascript:1")]
    val filter = $html <svg><feColorMatrix {matrix}/></svg>
    if (!filter.render().contains("values=\"javascript:1\"")) return 15
    42
}
