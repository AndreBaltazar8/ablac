// A transform's edit to another module's private function, whose new body
// reads that module's private names, holds natively and under `#`.
import "abla/compiler"
import "./graph-edits-library.ab"

compile fun edit(): void {
    compiler.replaceFunctionBody(compiler.findFunction("libraryHidden"), "40 + libraryStep()")
    return
}

#compiler.transform(edit)

fun main: int = if (libraryReveal() == 41) 42 else 1
