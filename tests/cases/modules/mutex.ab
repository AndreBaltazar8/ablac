resource class Counter(var value: int)

fun increment(var counter: Counter): int {
    counter.value = counter.value + 1
    counter.value
}

fun observe(var counter: Counter): int = counter.value

fun exerciseMutex(): int {
    val mutex = Mutex(Counter(40))
    val clone = mutex.clone()
    val first = mutex.with(increment)
    val second = clone.with(increment)
    val observed = mutex.with(observe)
    if (first == 41 && second == 42 && observed == 42) 42 else 0
}

compile fun stagedMutex(): int = exerciseMutex()

fun main: int =
    if (exerciseMutex() == 42 && #stagedMutex() == 42) 42 else 0
