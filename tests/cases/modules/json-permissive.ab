// jsonPermissiveLimits reads what JavaScript's JSON.parse reads: no byte,
// node, string or member limit, nesting up to jsonParse's deepest, and a
// duplicate key keeping its first position with its last value.
import "abla/bytes"
import "abla/json"

fun duplicatesMerge(): string {
    val merged = jsonParse("{\"a\":1,\"b\":2,\"a\":3}", jsonPermissiveLimits)
    // Past the members the key table indexes (k3 and k19 repeat).
    var long = "{"
    for (i in 0 until 20) long = "$long\"k$i\":$i,"
    long = "$long\"k3\":30,\"k19\":190}"
    val longMerged = jsonParse(long, jsonPermissiveLimits)
    // Kept in source order when duplicates are allowed but not merged.
    val kept = jsonParse(
        "{\"a\":1,\"b\":2,\"a\":3}",
        JsonLimits(1048576, 64, 100000, 1048576, 10000, false)
    )
    val rejected = jsonParse("{\"a\":1,\"a\":2}")
    // A reader gives every member as written; the last value for a key is
    // what JSON.parse keeps.
    val reader = jsonObjectReader("{\"a\":1,\"b\":2,\"a\":3}", jsonPermissiveLimits)
    var read = ""
    var a = 0
    while (!reader.done) {
        val key = reader.next()
        if (!reader.done) {
            val value = reader.readInteger()
            read = "$read$key"
            if (key == "a") a = value
        }
    }
    "${jsonStringify(merged.value)} ${longMerged.value.size()} " +
        "${longMerged.value.getInt("k3")} ${longMerged.value.getInt("k19")} " +
        "${jsonStringify(kept.value)} ${rejected.error.code} $read $a ${reader.finish()}"
}

fun largeAndDeep(): string {
    // A document of several megabytes, past every standard limit.
    val count = 150000
    val text = byteBuffer()
    text.appendText("{\"items\":[")
    for (i in 0 until count) {
        if (i > 0) text.appendText(",")
        text.appendText("{\"id\":")
        text.appendInt(i)
        text.appendText(",\"name\":\"item\"}")
    }
    text.appendText("]}")
    val source = text.toText()
    val large = jsonParse(source, jsonPermissiveLimits)
    val standard = jsonParse(source)
    // Nesting at the deepest jsonParse allows, and one level past it.
    var deepest = ""
    for (i in 0 until 256) deepest = "[$deepest]"
    val deep = jsonParse(deepest, jsonPermissiveLimits)
    val past = jsonParse("[$deepest]", jsonPermissiveLimits)
    "${source.size > 4000000} ${large.succeeded} ${large.value.get("items").size()} " +
        "${standard.error.code} ${deep.succeeded} ${past.error.code}"
}

fun main: int {
    val atRunTime = duplicatesMerge()
    val atCompileTime = #duplicatesMerge()
    val expected = "{\"a\":3,\"b\":2} 20 30 190 {\"a\":1,\"b\":2,\"a\":3} duplicate_key aba 3 true"
    if (atRunTime != expected || atCompileTime != expected) return 1
    if (largeAndDeep() != "true true 150000 input_limit true depth_limit") return 2
    42
}
