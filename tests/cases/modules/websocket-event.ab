import "abla/websocket/event"

// What the client thread and the server loop share: the listener's port and
// whether the client is done.
resource class WebSocketEventLink(val port: int, var done: bool)

fun webSocketEventPort(var link: WebSocketEventLink): int = link.port
fun webSocketEventDone(var link: WebSocketEventLink): bool = link.done
fun webSocketEventFinish(var link: WebSocketEventLink): bool {
    link.done = true
    true
}

fun eventEcho(
    path: string,
    kind: string,
    payload: string
): WebSocketEventReply = webSocketEventReply(
    "$path:$kind:$payload", "text", true
)

fun websocketEventClient(link: Mutex<WebSocketEventLink>): int {
    val connection = tcpConnectIpv4(
        "127.0.0.1", link.with(webSocketEventPort), 1000
    )
    if (connection.descriptor < 0) {
        link.with(webSocketEventFinish)
        return 1
    }
    val request = "GET /rooms/7 HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
    val frame = webSocketEncodeFrame("hello", 1, true, "mask")
    connection.write("$request$frame")
    var response = ""
    var reading = true
    while (reading) {
        val incoming = connection.readWithTimeoutResult(65536, 2000)
        if (incoming.hasData()) response = "${response}${incoming.bytes}"
        else reading = false
    }
    connection.close()
    link.with(webSocketEventFinish)
    val headerEnd = httpHeaderEnd(response)
    var valid = headerEnd > 0 &&
        response.slice(0, 12) == "HTTP/1.1 101"
    if (valid) {
        val decoded = webSocketDecodeFrame(
            response.slice(headerEnd, response.size)
        )
        valid = decoded.succeeded() &&
            decoded.frame.payload == "/rooms/7:text:hello"
    }
    if (valid) 0 else 2
}

fun main: int {
    val router = webSocketEventRouter()
    router.route("/rooms/:room", eventEcho)
    val server = webSocketEventServer(router, ipv4Loopback(0))
    val link = Mutex(WebSocketEventLink(server.listener.localPort(), false))
    val forClient = link.clone()
    val client = thread { websocketEventClient(forClient) }
    while (!link.with(webSocketEventDone)) server.step(100)
    val status = await client
    server.stop()
    val drained = server.drain()
    if (status == 0 && drained == 0 && server.stopped &&
        server.activeConnections() == 0) 42 else 1
}
