import "abla/compiler"

class Payload(val values: array<int?>)

resource class Token(val value: int)

fun transform(values: array<int?>): Payload = Payload(values)

compile fun inspectTypes(): int {
    val payload = compilerFindClass("Payload")
    val field = compilerClassFieldTypeHandle(payload, 0)
    val nullable = compilerTypeElement(field)
    val integer = compilerTypeElement(nullable)
    val function = compilerFindFunction("transform")
    val parameter = compilerFunctionParameterTypeHandle(function, 0)
    val result = compilerFunctionResultTypeHandle(function)
    val callable = compilerFindType("(array<int?>) -> Payload")
    val token = compilerFindType("Token")
    if (compilerTypeKind(field) != "array") return 2
    if (compilerTypeArgumentCount(field) != 1) return 3
    if (compilerTypeArgument(field, 0) != nullable) return 4
    if (compilerTypeKind(nullable) != "nullable") return 5
    if (!compilerTypeIsNullable(nullable)) return 6
    if (compilerTypeName(integer) != "i64") return 7
    if (parameter != field) return 8
    if (result != compilerFindType("Payload")) return 9
    if (compilerTypeDeclaration(result) != payload) return 10
    if (compilerTypeKind(callable) != "function") return 11
    if (compilerTypeArgumentCount(callable) != 1) return 12
    if (compilerTypeArgument(callable, 0) != field) return 13
    if (compilerTypeName(compilerTypeResult(callable)) !=
        compilerTypeName(result)) return 16
    if (compilerTypeResult(callable) != result) return 14
    if (!compilerTypeIsAffine(token)) return 15
    42
}

fun main: int = #inspectTypes()
