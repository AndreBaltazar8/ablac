import "abla/memory"

class GlobalContainerBox(val values: array<int>)

// Initialized by `__bootstrap_globals` and only mutated afterwards: what it
// holds is reachable through the global alone.
var globalContainerItems: array<GlobalContainerBox> = []

fun globalContainerValues(seed: int): array<int> {
    val values: array<int> = []
    for (index in 0 until 64) values.append(seed + index)
    values
}

fun main: int {
    for (index in 0 until 200) {
        globalContainerItems.append(GlobalContainerBox(globalContainerValues(index)))
        if (index % 20 == 0) memoryCollect()
    }
    memoryCollect()
    var total = 0
    for (box in globalContainerItems) {
        total = total + box.values[63]
    }
    // Sum of (index + 63) for index in 0 until 200.
    if (total == 19900 + 200 * 63) 42 else 1
}
