import "abla/io"

var events: string = ""
fun numbers(): Generator<int> = generator {
    defer { events = events + "generator " }
    yield 1
    yield 2
}
resource class Holder(val gen: Generator<int>) {
    fun drop(): void { events = events + "holder " }
}

fun earlyReturn(): int {
    for (value in Holder(numbers()).gen) return value
    0
}

fun exercise(): string {
    events = ""
    for (value in Holder(numbers()).gen) {}
    events = events + "exhausted | "
    for (value in Holder(numbers()).gen) break
    events = events + "break | "
    earlyReturn()
    events = events + "return | "
    for (value in [Holder(numbers())][0].gen) break
    events = events + "array | "
    if (true) {
        val owner = Holder(numbers())
        for (value in (if (true) Holder(numbers()) else owner).gen) break
        events = events + "fresh | "
        for (value in (if (false) Holder(numbers()) else owner).gen) break
        events = events + "borrow | "
    }
    events = events + "end"
    events
}

val evaluated = #exercise()
fun main: int {
    println(exercise())
    println(evaluated)
    0
}
