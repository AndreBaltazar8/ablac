resource class Ticket(val value: int)

fun inspect(ticket: Ticket): int = ticket.value

fun consume(own ticket: Ticket): int = inspect(ticket)

fun invokeOwned(callback: (own: Ticket) -> int, own ticket: Ticket): int =
    callback(move(ticket))

fun forward(own ticket: Ticket): Ticket = move(ticket)

compile fun stagedConsume(own ticket: Ticket): int = ticket.value

compile fun stagedInvokeOwned(
    callback: (own: Ticket) -> int,
    own ticket: Ticket
): int = callback(move(ticket))

compile fun stagedOwnedTransfer(): int {
    var ticket = Ticket(42)
    val answer = stagedConsume(move(ticket))
    ticket = Ticket(0)
    answer + ticket.value
}

class DropCounter(var value: int)

resource class DroppedTicket(val counter: DropCounter, val amount: int) {
    fun drop(): void {
        counter.value = counter.value + amount
        return
    }
}

fun selectOwned(
    chooseLeft: bool,
    own left: DroppedTicket,
    own right: DroppedTicket
): DroppedTicket = if (chooseLeft) left else right

fun dropSelected(own ticket: DroppedTicket): void {}

fun ownedBranchDrop(): int {
    val counter = DropCounter(0)
    val selected = selectOwned(
        true,
        DroppedTicket(counter, 19),
        DroppedTicket(counter, 23)
    )
    dropSelected(move(selected))
    counter.value
}

compile fun stagedOwnedBranchDrop(): int {
    val counter = DropCounter(0)
    val selected = selectOwned(
        false,
        DroppedTicket(counter, 20),
        DroppedTicket(counter, 22)
    )
    dropSelected(move(selected))
    counter.value
}

class TicketSink {
    fun consume(own ticket: Ticket): int = ticket.value
}

class TicketBox(val ticket: Ticket)
class TicketPair(val left: Ticket, val right: Ticket)

fun inspectAndConsume(left: Ticket, own right: Ticket): int =
    left.value + right.value

fun disjointBorrowAndMove(): int {
    var left = Ticket(19)
    var right = Ticket(23)
    val pair = TicketPair(move(left), move(right))
    inspectAndConsume(pair.left, move(pair.right))
}

compile fun stagedDisjointBorrowAndMove(): int {
    var left = Ticket(20)
    var right = Ticket(22)
    val pair = TicketPair(move(left), move(right))
    inspectAndConsume(pair.left, move(pair.right))
}

fun indirectOwnedCall(): int {
    val callback = consume
    var ticket = Ticket(42)
    callback(move(ticket))
}

fun explicitOwnedCallable(): int {
    var ticket = Ticket(42)
    invokeOwned(consume, move(ticket))
}

compile fun stagedIndirectOwnedCall(): int {
    val callback = stagedConsume
    var ticket = Ticket(42)
    callback(move(ticket))
}

compile fun stagedExplicitOwnedCallable(): int {
    var ticket = Ticket(42)
    stagedInvokeOwned(stagedConsume, move(ticket))
}

fun main: int {
    var original = Ticket(19)
    var forwarded = forward(move(original))
    original = Ticket(20)
    var boxedSource = Ticket(0)
    val boxed = TicketBox(move(boxedSource))
    boxedSource = Ticket(0)

    val fromFunction = consume(move(forwarded))
    val fromMethod = TicketSink().consume(move(original))
    val fromFreshValue = consume(Ticket(3))

    if (#stagedOwnedTransfer() == 42 &&
        #stagedDisjointBorrowAndMove() == 42 &&
        #stagedIndirectOwnedCall() == 42 &&
        #stagedExplicitOwnedCallable() == 42 &&
        #stagedOwnedBranchDrop() == 42 &&
        disjointBorrowAndMove() == 42 &&
        indirectOwnedCall() == 42 &&
        explicitOwnedCallable() == 42 &&
        ownedBranchDrop() == 42 &&
        fromFunction + fromMethod + fromFreshValue == 42 &&
        boxed.ticket.value + boxedSource.value == 0) 42 else 0
}
