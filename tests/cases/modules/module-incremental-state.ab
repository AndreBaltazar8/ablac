#import("../../../src/module.ab")

fun main: int {
    val directory = Path("build/module-incremental-state")
    val entry = directory.child("entry.ab")
    val firstLeaf = directory.child("first.ab")
    val secondLeaf = directory.child("second.ab")
    directory.createDirectories()
    firstLeaf.writeTextAtomic("fun answer: int = 41\n")
    secondLeaf.writeTextAtomic("fun answer: int = 43\n")
    entry.writeTextAtomic(
        "#import(\"first.ab\")\nfun main: int = answer()\n"
    )

    val state = bootstrapModuleState()

    state.beginBuild()
    val firstModules: array<BootstrapModule> = []
    val firstOrder: array<BootstrapModuleSnapshot> = []
    val firstGraph = BootstrapModuleGraph(
        firstModules, 0, state, firstOrder, []
    )
    val firstBundle = firstGraph.load(entry.text)
    firstGraph.parse()
    val firstLeafIndex = state.indexOf(firstLeaf.text)
    var firstLeafFingerprint = -1
    if (firstLeafIndex >= 0) {
        firstLeafFingerprint =
            state.snapshots[firstLeafIndex].firstFingerprint
    }
    var passed = firstGraph.errors == 0 &&
        firstModules.size == 2 &&
        state.refreshed == 2 &&
        state.reused == 0 &&
        state.refreshedParsed == 2 &&
        state.reusedParsed == 0

    state.beginBuild()
    val secondModules: array<BootstrapModule> = []
    val secondOrder: array<BootstrapModuleSnapshot> = []
    val secondGraph = BootstrapModuleGraph(
        secondModules, 0, state, secondOrder, []
    )
    val secondBundle = secondGraph.load(entry.text)
    secondGraph.parse()
    passed = passed && secondGraph.errors == 0 &&
        secondBundle == firstBundle &&
        state.refreshed == 0 &&
        state.reused == 2 &&
        state.refreshedParsed == 0 &&
        state.reusedParsed == 2

    // Keep the same byte count: revision tracking, not a length-only cache,
    // must invalidate this leaf while retaining the unchanged entry snapshot.
    firstLeaf.writeTextAtomic("fun answer: int = 42\n")
    state.beginBuild()
    val thirdModules: array<BootstrapModule> = []
    val thirdOrder: array<BootstrapModuleSnapshot> = []
    val thirdGraph = BootstrapModuleGraph(
        thirdModules, 0, state, thirdOrder, []
    )
    val thirdBundle = thirdGraph.load(entry.text)
    thirdGraph.parse()
    val changedLeafIndex = state.indexOf(firstLeaf.text)
    passed = passed && thirdGraph.errors == 0 &&
        thirdBundle != secondBundle &&
        state.refreshed == 1 &&
        state.reused == 1 &&
        state.refreshedParsed == 1 &&
        state.reusedParsed == 1 &&
        state.snapshots[changedLeafIndex].firstFingerprint !=
            firstLeafFingerprint

    // A public-signature edit invalidates both the leaf and its downstream
    // importer, unlike the body-only edit above.
    firstLeaf.writeTextAtomic("fun answer(value: int): int = value\n")
    state.beginBuild()
    val signatureModules: array<BootstrapModule> = []
    val signatureOrder: array<BootstrapModuleSnapshot> = []
    val signatureGraph = BootstrapModuleGraph(
        signatureModules, 0, state, signatureOrder, []
    )
    signatureGraph.load(entry.text)
    signatureGraph.parse()
    passed = passed && state.refreshed == 1 && state.reused == 1 &&
        state.refreshedParsed == 2 && state.reusedParsed == 0

    // Changing an import edge must traverse the new dependency and must not
    // retain the old leaf in the active graph.
    entry.writeTextAtomic(
        "#import(\"second.ab\")\nfun main: int = answer()\n"
    )
    state.beginBuild()
    val fourthModules: array<BootstrapModule> = []
    val fourthOrder: array<BootstrapModuleSnapshot> = []
    val fourthGraph = BootstrapModuleGraph(
        fourthModules, 0, state, fourthOrder, []
    )
    fourthGraph.load(entry.text)
    fourthGraph.parse()
    passed = passed && fourthGraph.errors == 0 &&
        fourthModules.size == 2 &&
        fourthModules[1].path == secondLeaf.text &&
        state.refreshed == 2 &&
        state.reused == 0 &&
        state.refreshedParsed == 2 &&
        state.reusedParsed == 0

    entry.remove()
    firstLeaf.remove()
    secondLeaf.remove()
    directory.remove()
    if (passed) 42 else 1
}
