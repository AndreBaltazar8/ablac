// exit(code) ends the process with that status from any depth; panic writes
// its message to standard error and exits with 101.
import "abla/io"
import "abla/process"

fun check(depth: int, mode: string): int {
    if (depth > 0) return check(depth - 1, mode) + 1
    if (mode == "exit") exit(7)
    if (mode == "panic") panic("deep failure")
    0
}

fun main: int {
    val mode = processArgument(0)
    if (processArgument(5) != "") return 1
    println("start")
    check(5, mode)
    42
}
