#import("../../../bootstrap/compiler/backend_llvm.ab")

fun compileWithIrCache(
    source: string,
    var cache: BootstrapIrCacheState
): BootstrapLlvmCompilation {
    cache.beginBuild()
    bootstrapCompileLlvmParsedCached(bootstrapParseStaged(source), cache)
}

fun main: int {
    val firstSource = "fun leaf: int = 41\nfun stable: int { val add = { value: int -> value + 1 }; add(41) }\nfun main: int = leaf() + stable() - 41\n"
    val changedBody = "fun leaf: int = 42\nfun stable: int { val add = { value: int -> value + 1 }; add(41) }\nfun main: int = leaf() + stable() - 41\n"
    val changedSignature = "fun leaf(value: int): int = value\nfun stable: int { val add = { value: int -> value + 1 }; add(41) }\nfun main: int = leaf(42) + stable() - 41\n"
    var cache = bootstrapIrCacheState()

    val first = compileWithIrCache(firstSource, cache)
    var passed = first.errors == 0 && cache.reused == 0 &&
        cache.refreshed == 4

    val identical = compileWithIrCache(firstSource, cache)
    passed = passed && identical.errors == 0 &&
        identical.output == first.output && cache.reused == 4 &&
        cache.refreshed == 0

    val body = compileWithIrCache(changedBody, cache)
    passed = passed && body.errors == 0 && body.output != first.output &&
        cache.reused == 3 && cache.refreshed == 1

    val signature = compileWithIrCache(changedSignature, cache)
    passed = passed && signature.errors == 0 && cache.reused == 0 &&
        cache.refreshed == 4

    if (passed) 42 else 1
}
