// `?.` and `??`: chains, skipped arguments, defaults evaluated only on null,
// grouping and precedence, `?? return`/`continue`/`break`, `var` and field
// subjects (read once), void calls, line continuation, and the same under `#`.
class Link(val value: int, val next: Link?, val label: string?)

class Counter(var count: int)

class Holder(var link: Link?)

fun Link.plus(n: int): int = this.value + n

fun Link.mark(var counter: Counter): void {
    counter.count += this.value
}

fun counted(var counter: Counter, n: int): int {
    counter.count += 1
    n
}

fun firstOr(link: Link?): int {
    val value = link?.value ?? return -1
    value + 100
}

fun total(items: array<Link?>, stopAtGap: bool): int {
    var sum = 0
    for (item in items) {
        val value = if (stopAtGap) item?.value ?? break else item?.value ?? continue
        sum += value
    }
    sum
}

fun nextOf(holder: Holder, var reads: Counter): Link? {
    reads.count += 1
    holder.link
}

fun check(): int {
    val chain = Link(1, Link(2, null, "two"), null)
    val none: Link? = null
    var failures = 0
    if ((chain.next?.value ?? 0) != 2) failures += 1
    if ((none?.value ?? 7) != 7) failures += 1
    if ((chain.next?.next?.value ?? -1) != -1) failures += 1
    if ((chain.next?.label?.size ?? 0) != 3) failures += 1
    if ((chain.label ?? "none") != "none") failures += 1
    // A skipped call evaluates no arguments; a taken one evaluates each once.
    val arguments = Counter(0)
    if ((none?.plus(counted(arguments, 5)) ?? 0) != 0) failures += 1
    if ((chain.next?.plus(counted(arguments, 5)) ?? 0) != 7) failures += 1
    if (arguments.count != 1) failures += 1
    // The default runs only when the left side is null.
    val defaults = Counter(0)
    if ((chain.next?.value ?? counted(defaults, 9)) != 2) failures += 1
    if ((none?.value ?? counted(defaults, 9)) != 9) failures += 1
    if (defaults.count != 1) failures += 1
    // A void call through `?.`.
    val marks = Counter(0)
    none?.mark(marks)
    chain.next?.mark(marks)
    if (marks.count != 2) failures += 1
    // Grouping and precedence: right to left, below `+`, above comparisons.
    val a: int? = null
    val b: int? = null
    if ((a ?? b ?? 3) != 3) failures += 1
    val c: int? = a ?? b
    if (c != null) failures += 1
    if (a ?? 2 + 3 != 5) failures += 1
    if (!(a ?? 1 < 2)) failures += 1
    // `var` locals, fields and calls are read once.
    var moving: Link? = chain
    if ((moving?.value ?? 0) != 1) failures += 1
    moving = null
    if ((moving?.value ?? 0) != 0) failures += 1
    val holder = Holder(chain)
    val reads = Counter(0)
    if ((nextOf(holder, reads)?.next?.value ?? 0) != 2) failures += 1
    if (reads.count != 1) failures += 1
    if ((holder.link?.value ?? 0) != 1) failures += 1
    // Leaving through the default.
    if (firstOr(chain) != 101 || firstOr(none) != -1) failures += 1
    if (total([chain, chain.next, none, chain], true) != 3) failures += 1
    if (total([chain, none, chain.next], false) != 3) failures += 1
    // A line may start with `?.` or `??`.
    val continued = none
        ?.value
        ?? 40
    if (continued != 40) failures += 1
    failures
}

compile fun stagedCheck(): int = check()

fun main: int = if (check() == 0 && #stagedCheck() == 0) 42 else 1
