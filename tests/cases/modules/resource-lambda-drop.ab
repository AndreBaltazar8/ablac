var lambdaDrops = 0

resource class LambdaToken(val amount: int) {
    fun drop(): void {
        lambdaDrops = lambdaDrops + amount
        return
    }
}

class StageLambdaCounter(var value: int)

resource class StageLambdaToken(
    val counter: StageLambdaCounter,
    val amount: int
) {
    fun drop(): void {
        counter.value = counter.value + amount
        return
    }
}

compile fun stagedNeverInvoked(counter: StageLambdaCounter): void {
    val token = StageLambdaToken(counter, 9)
    val callback = move { token.amount }
    return
}

compile fun stagedInvoked(counter: StageLambdaCounter): void {
    val token = StageLambdaToken(counter, 10)
    val callback = move { token.amount }
    callback()
    return
}

compile fun stagedNested(counter: StageLambdaCounter): void {
    val token = StageLambdaToken(counter, 11)
    val inner = move { token.amount }
    val outer = move { inner() }
    return
}

compile fun stagedLambdaDropTrace(): int {
    val counter = StageLambdaCounter(0)
    stagedNeverInvoked(counter)
    stagedInvoked(counter)
    stagedNested(counter)
    counter.value
}

fun neverInvoked() {
    val token = LambdaToken(1)
    val callback = move { token.amount }
}

fun replaced() {
    val first = LambdaToken(2)
    var callback = move { first.amount }
    val second = LambdaToken(3)
    callback = move { second.amount }
}

fun earlyReturn() {
    val token = LambdaToken(4)
    val callback = move { token.amount }
    return
}

fun invoked() {
    val token = LambdaToken(5)
    val callback = move { token.amount }
    callback()
}

fun nested() {
    val token = LambdaToken(6)
    val inner = move { token.amount }
    val outer = move { inner() }
}

fun arrayOfClosures() {
    val first = LambdaToken(7)
    val second = LambdaToken(8)
    val callbacks = [
        move { first.amount },
        move { second.amount }
    ]
}

fun main: int {
    neverInvoked()
    replaced()
    earlyReturn()
    invoked()
    nested()
    arrayOfClosures()
    if (lambdaDrops == 36 && #stagedLambdaDropTrace() == 30) 42 else 1
}
