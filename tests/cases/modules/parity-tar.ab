// Compile-time parity of abla/archive/tar: an archive built here (ustar headers with their checksums: a file, a
// directory and a second file) read whole, then a truncated copy and one with a bad checksum, print the same at run
// time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/archive/tar"
import "abla/text"

fun octal(value: int, width: int): string {
    var digits = ""
    var rest = value
    while (rest > 0) {
        digits = "${rest % 8}$digits"
        rest = rest / 8
    }
    if (digits == "") digits = "0"
    "${"0".repeat(width - 1 - digits.size)}$digits\x00"
}

fun field(text: string, width: int): string = "$text${"\x00".repeat(width - text.size)}"

fun header(name: string, size: int, kind: string): string {
    val before = "${field(name, 100)}${octal(420, 8)}${octal(0, 8)}${octal(0, 8)}${octal(size, 12)}${octal(1700000000, 12)}"
    val after = "$kind${field("", 100)}ustar\x0000${field("parity", 32)}${field("parity", 32)}${field("", 8)}${field("", 8)}${field("", 155)}${field("", 12)}"
    var sum = 8 * 32
    for (index in 0 until before.size) sum = sum + before[index]
    for (index in 0 until after.size) sum = sum + after[index]
    "$before${octal(sum, 7)} $after"
}

fun member(name: string, content: string, kind: string): string {
    val padding = (512 - content.size % 512) % 512
    "${header(name, content.size, kind)}$content${"\x00".repeat(padding)}"
}

fun show(result: TarReadResult): string {
    var text = "error '${result.error}' entries ${result.entries.size}"
    for (entry in result.entries) {
        text = "$text | ${entry.path} ${entry.kind} ${entry.mode} ${entry.size} '${result.input.slice(entry.offset, entry.offset + entry.size)}'"
    }
    text
}

fun main: int {
    val archive = "${member("hello.txt", "hello, parity\n", "0")}${member("folder/", "", "5")}${member("folder/data.bin", "x".repeat(700), "0")}${"\x00".repeat(1024)}"
    val limits = TarLimits(1048576, 16, 65536, 65536)
    println("size ${archive.size}")
    println("whole ${show(tarRead(archive, limits))}")
    println("truncated ${show(tarRead(archive.slice(0, 700), limits))}")
    println("bad checksum ${show(tarRead("${archive.slice(0, 148)}9${archive.slice(149, archive.size)}", limits))}")
    println("tight limits ${show(tarRead(archive, TarLimits(1048576, 1, 65536, 65536)))}")
    42
}
