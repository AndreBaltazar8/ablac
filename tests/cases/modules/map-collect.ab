// Map under collection pressure: a collection every few KB while maps grow,
// rehash and hold fresh strings and objects.
import "abla/memory"

class Item(val name: string, var count: int)

fun main: int {
    memorySetCollectionGrowth(4096)
    val names: Map<int, string> = Map()
    val items: Map<string, Item> = Map()
    var index = 0
    while (index < 3000) {
        names.set(index, "name-$index")
        items.set("item-${index % 500}", Item("i$index", index))
        if (index % 3 == 0) names.remove(index / 2)
        index = index + 1
    }
    memoryCollect()
    var ok = names.get(2999) == "name-2999" && items.size == 500
    val item = items.get("item-499")
    ok = ok && item != null && item.count == 2999 && item.name == "i2999"
    var count = 0
    for (key in names.keys()) {
        val name = names.get(key)
        if (name != null && name == "name-$key") count = count + 1
    }
    ok = ok && count == names.size
    if (ok) 42 else 1
}
