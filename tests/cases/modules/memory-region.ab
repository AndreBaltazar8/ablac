import "abla/memory"

fun main: int {
    val before = memoryLiveBytes()
    val checkpoint = memoryCheckpoint()
    // A checkpoint is a marker allocation (one 8-byte block) that its reset
    // keeps; resetting returns to the live bytes just after it.
    val atCheckpoint = memoryLiveBytes()
    val values: array<string> = []
    var index = 0
    while (index < 200) {
        values.append("allocation-$index")
        index = index + 1
    }
    val grew = memoryLiveBytes() > atCheckpoint
    memoryReset(checkpoint)
    if (grew && memoryLiveBytes() == atCheckpoint &&
        atCheckpoint - before <= 8) 42 else 0
}
