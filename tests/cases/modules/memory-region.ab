#import("abla/memory")

fun main: int {
    val before = memoryLiveBytes()
    val checkpoint = memoryCheckpoint()
    val values: array<string> = []
    var index = 0
    while (index < 200) {
        values.append("allocation-$index")
        index = index + 1
    }
    val grew = memoryLiveBytes() > before
    memoryReset(checkpoint)
    if (grew && memoryLiveBytes() == before) 42 else 0
}
