import "abla/unsafe/mmio"

trusted fun volatileRoundTrip(address: int, value: int): int {
    mmioStoreU8(address, value)
    mmioStoreU16(address, value)
    mmioStoreU32(address, value)
    mmioStoreU64(address, value)
    mmioLoadU8(address) + mmioLoadU16(address) +
        mmioLoadU32(address) + mmioLoadU64(address)
}

fun main: int = 0
