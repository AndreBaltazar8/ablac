// A parameter's default resolves its operators like any expression: a binary
// and a unary operator in a function's default and in a method's, which reads
// a field.
class N(val value: int)

operator fun N.plus(other: N): N = N(this.value + other.value)
operator fun N.unaryMinus(): N = N(0 - this.value)

fun sum(b: N = N(1) + N(2)): int = b.value

fun negated(b: N = -N(4)): int = b.value

class Holder(val base: int) {
    fun shifted(b: N = N(this.base) + N(2)): int = b.value
}

fun main: int =
    if (sum() == 3 && sum(N(5)) == 5 && negated() == -4 &&
        Holder(40).shifted() == 42) 42 else 1
