import "abla/compiler"
import "abla/compiler/parser"

compile fun finalizeInvalidFunctionHandle(
    namespace: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    compilerFunctionName(999999)
    compilerGeneratedModule(namespace, expression)
}

compile fun parseInvalidFunctionHandle(
    cursor: ParserCursor
): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "invalid.function.handle",
        "invalid.function.handle",
        expression,
        finalizeInvalidFunctionHandle
    )
    expression
}

#compilerRegisterSubparser(
    "invalidFunctionHandle",
    parseInvalidFunctionHandle
)

fun invalidFunctionHandleTarget(value: int): int = value

fun main: int =
    $invalidFunctionHandle(invalidFunctionHandleTarget(42))
