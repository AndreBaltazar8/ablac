import "abla/io"

var events: string = ""

fun sequence(): Generator<int> = generator {
    defer { events = events + "close " }
    yield 1
    yield 2
}

fun first(values: Generator<int>): int {
    for (value in values) return value
    0
}

fun stop(values: Generator<int>): int {
    for (value in values) {
        if (value == 1) break
    }
    1
}

fun main: int {
    val one = sequence()
    first(one)
    events = events + "after-first "
    val two = sequence()
    stop(two)
    events = events + "after-stop "
    first(sequence())
    events = events + "after-temporary"
    println(events)
    0
}
