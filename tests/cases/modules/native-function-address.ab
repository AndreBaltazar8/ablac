import "../../../src/backend/llvm/backend.ab"
import "abla/sys/linux/io"

fun compileNativeAddress(source: string): BootstrapLlvmCompilation {
    val cache = bootstrapIrTransientState()
    bootstrapCompileLlvmParsedCached(
        bootstrapParseStaged(source), cache, "xtensa-esp-unknown-elf"
    )
}

fun main: int {
    val validSource = "trusted noescape extern:\"intrinsic\" fun nativeFunctionAddress(function: any): int\nfun callback(first: u32, second: u32, third: i32): i32 = i32(first + second) + third\ntrusted fun address(): int = nativeFunctionAddress(callback)\nfun main: int = 0\n"
    val valid = compileNativeAddress(validSource)
    var passed = valid.errors == 0 &&
        bootstrapTextContains(valid.output, "_native_adapter(") &&
        bootstrapTextContains(valid.output, "internal i32") &&
        bootstrapTextContains(valid.output, "ptrtoint (ptr @") &&
        bootstrapTextContains(valid.output, " to i64)") &&
        bootstrapTextContains(valid.output, "i64 3") &&
        !bootstrapTextContains(valid.output, "define i32 @callback(")

    val aliasSource = "trusted noescape extern:\"intrinsic\" fun nativeFunctionAddress(function: any): int\nfun callback(value: i32): i32 = value\ntrusted fun address(): int { val alias = callback; nativeFunctionAddress(alias) }\nfun main: int = 0\n"
    passed = passed && compileNativeAddress(aliasSource).errors > 0

    val managedSource = "trusted noescape extern:\"intrinsic\" fun nativeFunctionAddress(function: any): int\nfun callback(value: string): int = value.size\ntrusted fun address(): int = nativeFunctionAddress(callback)\nfun main: int = 0\n"
    passed = passed && compileNativeAddress(managedSource).errors > 0
    if (passed) 42 else 1
}
