#import("abla/compiler/parser")

compile fun parseAnswer(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "{")
    parserExpect(cursor, "}")
    syntaxBinary("+", syntaxInteger(40), syntaxInteger(2))
}

#compilerRegisterSubparser("answer", parseAnswer)

fun main: int {
    val frozen = #$answer{}
    if (frozen == $answer{}) 42 else 0
}
