// abla/process reads environment variables (the test sets ABLA_TEST_ENV).
import "abla/process"

fun main: int {
    val set = processEnvironment("ABLA_TEST_ENV")
    val unset = processEnvironment("ABLA_TEST_ENV_UNSET")
    val ok = set != null && set == "value=with=equals" && unset == null &&
        processEnvironmentOr("ABLA_TEST_ENV_UNSET", "fallback") == "fallback" &&
        processEnvironmentOr("ABLA_TEST_ENV", "") == "value=with=equals" &&
        processEnvironment("ABLA_TEST_EN") == null
    if (ok) 42 else 1
}
