// A `{ ... }` statement is a lambda that nothing calls: its body would never run (#824). Each place its value is
// certainly dropped is an error: before another statement (in a function and in a lambda), as the last statement of a
// loop body, of a `defer` and of a function declared `: void`, and a `move { ... }` the same.
import "abla/io"

fun quiet(): void {
    println("before")
    { println("never") }
}

fun main: int {
    {
        println("never")
    }
    val run = { ->
        { println("never") }
        1
    }
    for (i in 0 until 2) {
        println("loop")
        { println("never") }
    }
    defer {
        println("deferred")
        { println("never") }
    }
    move { println("never") }
    println("end")
    quiet()
    run()
}
