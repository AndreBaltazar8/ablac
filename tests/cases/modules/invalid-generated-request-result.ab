#import("abla/compiler/parser")

compile fun finalizeWrongRequest(
    payload: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder =
    compilerGeneratedModule("wrong.request.namespace", expression)

compile fun parseWrongRequest(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "expected.request.namespace",
        "",
        expression,
        finalizeWrongRequest
    )
    expression
}

#compilerRegisterSubparser("wrongRequest", parseWrongRequest)

fun requestedValue(value: int): int = value

fun main: int = $wrongRequest(requestedValue(1))
