import "abla/io"

fun array<int>.total(): int {
    var sum = 0
    for (value in this) sum = sum + value
    sum
}

fun Map<string, int>.bump(key: string): void {
    val current = this.get(key)
    if (current != null) this.set(key, current + 1) else this.set(key, 1)
}

fun string?.isMissing(): bool = this == null

fun main {
    val values = [1, 2, 3]
    val counts: Map<string, int> = Map()
    counts.bump("a")
    counts.bump("a")
    val absent: string? = null
    val present: string? = "x"
    val total = values.total()
    val bumped = counts.get("a")
    val a = absent.isMissing()
    val b = present.isMissing()
    if (bumped != null) println("$total $bumped $a $b")
}
