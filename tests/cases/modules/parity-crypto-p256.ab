// Compile-time parity of abla/crypto/p256: a public key, an RFC 6979 (deterministic) signature, its checks, the DER
// form and ECDH over fixed keys print the same at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/crypto"
import "abla/crypto/p256"

fun show(result: CryptoResult): string = if (result.ok) hexEncode(result.bytes) else "error ${result.error}"

fun main: int {
    val key = hexDecode("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    val peer = hexDecode("0f0e0d0c0b0a09080706050403020100f0e0d0c0b0a090807060504030201000")
    val publicKey = p256PublicKey(key)
    val signature = p256EcdsaSignRaw(key, "sample")
    println("public ${show(publicKey)}")
    println("signature ${show(signature)} der ${hexEncode(p256SignatureToDer(signature.bytes))}")
    println("verify ${p256EcdsaVerifyRaw(publicKey.bytes, "sample", signature.bytes)} ${p256EcdsaVerifyRaw(publicKey.bytes, "other", signature.bytes)}")
    println("ecdh ${show(p256Ecdh(key, p256PublicKey(peer).bytes))} ${show(p256Ecdh(peer, publicKey.bytes))}")
    42
}
