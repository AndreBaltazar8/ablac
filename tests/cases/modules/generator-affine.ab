// A generator owns what it captures by move and the affine locals it keeps
// across a `yield`: closing it early drops them, last first.
import "abla/io"
resource class Ticket(val value: int) {
    fun drop(): void { println("drop ${this.value}") }
}
fun gen(): Generator<int> {
    val t = Ticket(7)
    generator {
        yield t.value
        val u = Ticket(8)
        yield u.value
        yield 3
    }
}
// A `defer` of a block kept whole takes a kept value by move, as anywhere.
fun deferred(): Generator<int> = generator {
    val t = Ticket(9)
    yield 1
    if (t.value > 0) {
        defer { println("defer sees ${t.value}") }
    }
    yield 2
}

// A generator made inside another takes the outer one's kept value.
fun nestedOwner(): Generator<int> = generator {
    val t = Ticket(5)
    yield 0
    val inner = generator { yield t.value }
    for (v in inner) yield v
}

fun main {
    for (v in gen()) { println("got $v"); if (v == 8) break }
    println("--")
    for (v in gen()) println("got $v")
    println("--")
    for (v in deferred()) println("got $v")
    println("--")
    for (v in nestedOwner()) println("got $v")
    println("--")
    val g = gen()
    println("end")
}
