import "abla/bytes"
import "abla/dns"
import "abla/net"

var ipv6TestPort = 0

fun ipv6Client(): int {
    val connection = tcpConnectIpv6(ipv6Loopback(ipv6TestPort), 1000)
    if (connection.descriptor < 0) return 1
    val sent = connection.write("v6")
    val reply = connection.readWithTimeoutResult(8, 1000)
    connection.close()
    if (sent == 2 && reply.hasData() && reply.bytes == "ok") 0 else 2
}

fun testIpv6Tcp(): bool {
    val listener = tcpListenIpv6(ipv6Loopback(0), 16, false)
    if (listener.descriptor < 0) return false
    ipv6TestPort = listener.localAddressIpv6().port
    val child = thread { ipv6Client() }
    val connection = listener.accept()
    val input = connection.readWithTimeoutResult(8, 1000)
    val sent = connection.write("ok")
    val status = await child
    connection.close()
    listener.close()
    input.hasData() && input.bytes == "v6" && sent == 2 && status == 0
}

fun testIpv6Udp(): bool {
    val socket = udpBindIpv6(ipv6Loopback(0), true, false)
    if (socket.descriptor < 0) return false
    val local = socket.localAddressIpv6()
    val sent = socket.sendToIpv6("six", ipv6Loopback(local.port))
    val received = socket.receiveFromIpv6WithTimeout(32, 1000)
    socket.close()
    sent.succeeded() && received.received && received.bytes == "six" &&
        received.source.port == local.port
}

fun dnsFixture(): string {
    val output = byteBuffer()
    dnsAppendU16(output, 4660)
    dnsAppendU16(output, 33152)
    dnsAppendU16(output, 1)
    dnsAppendU16(output, 2)
    dnsAppendU16(output, 0)
    dnsAppendU16(output, 0)
    output.appendText(dnsEncodeName("example.com"))
    dnsAppendU16(output, 1)
    dnsAppendU16(output, 1)
    output.appendByteValue(192)
    output.appendByteValue(12)
    dnsAppendU16(output, 1)
    dnsAppendU16(output, 1)
    output.appendByteValue(0)
    output.appendByteValue(0)
    output.appendByteValue(0)
    output.appendByteValue(60)
    dnsAppendU16(output, 4)
    output.appendByteValue(127)
    output.appendByteValue(0)
    output.appendByteValue(0)
    output.appendByteValue(1)
    output.appendByteValue(192)
    output.appendByteValue(12)
    dnsAppendU16(output, 28)
    dnsAppendU16(output, 1)
    output.appendByteValue(0)
    output.appendByteValue(0)
    output.appendByteValue(0)
    output.appendByteValue(60)
    dnsAppendU16(output, 16)
    var zero = 0
    while (zero < 15) {
        output.appendByteValue(0)
        zero = zero + 1
    }
    output.appendByteValue(1)
    output.toText()
}

fun testDnsCodec(): bool {
    val query = dnsQuery("example.com", 28, 4660)
    val parsed = dnsParseResponse(dnsFixture(), 4660)
    query.size > 20 && parsed.succeeded && parsed.addresses.size == 2 &&
        parsed.addresses[0].family == 4 &&
        parsed.addresses[0].address == "127.0.0.1" &&
        parsed.addresses[1].family == 6 &&
        parsed.addresses[1].address == "0:0:0:0:0:0:0:1"
}

fun main: int =
    if (testIpv6Tcp() && testIpv6Udp() && testDnsCodec()) 42 else 1
