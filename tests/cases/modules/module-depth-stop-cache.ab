import "../../../src/frontend.ab"
import "abla/io"

fun main: int {
    val state = bootstrapModuleState()
    var round = 0
    while (round < 2) {
        state.beginBuild()
        val graph = bootstrapFrontendLoadHostGraph("build/deep-json/deepest.ab", state)
        val parsed = graph.parse()
        val analyzed = bootstrapFrontendAnalyzeRequested(parsed, [], [], [], [])
        if (parsed.stackDepthStoppedSources.size == 0 ||
            bootstrapEvalErrorLines(analyzed.diagnostics) != 1 ||
            (round == 1 && state.reusedParsed == 0)) {
            println("cache depth stop: round $round, reused ${state.reusedParsed}, diagnostics ${analyzed.diagnostics}")
            return 1
        }
        round = round + 1
    }
    println("cache depth stop: reused with one error")
    0
}
