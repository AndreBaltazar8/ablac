import "abla/json"

// A document reads as jsonParse's tree, reports jsonParse's errors, and its
// toJson() is that tree: at run time and under `#` alike.

fun jsonDocumentSame(node: JsonNode, value: Json): bool {
    if (node.kind() != value.kind || node.size() != value.size()) return false
    if (value.kind == 1) return node.asString() == value.asString()
    if (value.kind == 2) return node.asNumber().text == value.asNumber().text && node.asInt() == value.asInt()
    if (value.kind == 3) return node.asBoolean() == value.asBoolean()
    var index = 0
    while (index < value.size()) {
        if (!jsonDocumentSame(node.at(index), value.at(index))) return false
        if (value.kind == 5 && node.keyAt(index) != value.keys[index]) return false
        index = index + 1
    }
    true
}

fun jsonDocumentAgrees(source: string, limits: JsonLimits): bool {
    val parsed = jsonParse(source, limits)
    val document = jsonDocument(source, limits)
    if (document.succeeded != parsed.succeeded || document.error.code != parsed.error.code ||
        document.error.byteOffset != parsed.error.byteOffset) return false
    if (!parsed.succeeded) return true
    val root = document.document.root()
    jsonStringify(root.toJson()) == jsonStringify(parsed.value) && jsonDocumentSame(root, parsed.value)
}

fun main: int {
    val open = JsonLimits(4096, 16, 1000, 64, 100, false)
    val sources = [
        "{\"a\":[1,2.5e3,-0,true,false,null],\"b\":{\"c\":\"\\u00e9\\n\"}}",
        "{\"a\":1,\"b\":2,\"a\":3}",
        "[[],{},\"\",0]",
        "[1, 2, {\"a\": tru}]",
        "{\"k\" 1}",
        " [ 1 , [ 2 ] ] "
    ]
    var agreed = 0
    for (source in sources) {
        if (jsonDocumentAgrees(source, jsonDefaultLimits())) agreed = agreed + 1
        if (jsonDocumentAgrees(source, open)) agreed = agreed + 1
        if (jsonDocumentAgrees(source, jsonPermissiveLimits)) agreed = agreed + 1
    }
    val root = jsonDocument("{\"x\":[10,20],\"y\":\"z\"}").document.root()
    if (agreed == sources.size * 3 && root.get("x").at(1).asInt() == 20 &&
        root.get("y").raw() == "\"z\"" && !root.get("w").exists()) 42 else agreed
}
