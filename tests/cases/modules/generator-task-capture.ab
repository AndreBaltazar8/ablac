// A local a `task` (or `thread`, or `generator`) captures becomes a cell where
// it is declared. Converting it where the closure is built did so in one `if`
// arm only, so code after the arm read the plain value as a cell and trapped.
import "abla/io"

var useTask = false

fun numbers(n: int): Generator<int> = generator {
    yield 1
    yield n
}

fun main: int {
    val n = 4
    if (useTask) {
        val job = task { n + 1 }
        println("${await job}")
    }
    if (!useTask) {
        for (value in numbers(n)) println("$value")
    }
    var total = n
    if (useTask) {
        val more = generator { yield n }
        for (value in more) total = total + value
    }
    println("finished $total")
    0
}
