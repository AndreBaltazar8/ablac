import "abla/io"

// A class with a delegated property keeps its interfaces: it upcasts, a
// sealed interface's `when is` over it is exhaustive, and a generic class's
// delegated property works in each instance (with its interface).

class Counter(var current: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = next
        return
    }
}

class Slot<T>(var current: T) {
    fun getValue(): T = current
    fun setValue(next: T): void {
        current = next
        return
    }
}

interface Shape {
    fun area(): int
}

class Square(val side: int, var hits: int by Counter(0)) : Shape {
    fun area(): int = this.side * this.side
}

sealed interface Event

class Tick(var count: int by Counter(1)) : Event
class Stop(val reason: string) : Event

fun describe(event: Event): string = when (event) {
    is Tick -> "tick ${event.count}"
    is Stop -> "stop ${event.reason}"
}

class Tracked<T>(val start: T, var value: T by Slot(start)) : Shape {
    fun area(): int = 1
}

fun main: int {
    val square = Square(3)
    square.hits = 2
    val shape: Shape = Square(3)
    val first = shape.area()
    val second = square.area()
    val events: array<Event> = [Tick(), Stop("done")]
    val tracked = Tracked("a")
    tracked.value = "b"
    val number = Tracked(4)
    val shapes: array<Shape> = [tracked, number]
    val text = "$first $second ${square.hits} ${describe(events[0])} ${describe(events[1])} " +
        "${tracked.value} ${number.value} ${shapes[0].area() + shapes[1].area()}"
    println(text)
    if (text == "9 9 2 tick 1 stop done b 4 2") 42 else 1
}
