import "abla/float"

// f32 at compile time gives the bits the program computes at run time: the
// `f32(...)` literal form, and 0/0 (NaN, not a division by zero).
fun literalValue(): f32 = f32(1.5)
fun literalNegative(): f32 = f32(-0.1)
fun zeroOverZero(): f32 {
    val zero = f64ToF32(0.0)
    zero / zero
}
fun oneOverZero(): f32 {
    val zero = f64ToF32(0.0)
    f64ToF32(1.0) / zero
}
fun remainderByZero(): f32 {
    val zero = f64ToF32(0.0)
    f64ToF32(1.0) % zero
}

compile fun stagedLiteral(): f32 = f32(1.5)
compile fun stagedNegative(): f32 = f32(-0.1)
compile fun stagedZeroOverZero(): f32 {
    val zero = f64ToF32(0.0)
    zero / zero
}
compile fun stagedOneOverZero(): f32 {
    val zero = f64ToF32(0.0)
    f64ToF32(1.0) / zero
}
compile fun stagedRemainderByZero(): f32 {
    val zero = f64ToF32(0.0)
    f64ToF32(1.0) % zero
}

fun same(compileTime: f32, runTime: f32): bool = f32ToBits(compileTime) == f32ToBits(runTime)

fun main: int {
    var failures = 0
    if (!same(#stagedLiteral(), literalValue())) failures = failures + 1
    if (!same(#stagedNegative(), literalNegative())) failures = failures + 1
    if (!same(#stagedZeroOverZero(), zeroOverZero())) failures = failures + 2
    if (!same(#stagedOneOverZero(), oneOverZero())) failures = failures + 4
    if (!same(#stagedRemainderByZero(), remainderByZero())) failures = failures + 8
    if (failures == 0) 42 else failures
}
