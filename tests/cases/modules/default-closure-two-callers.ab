// A constructor's defaulted closure is lowered into each function that leaves it out: two
// functions get two functions of their own, not one symbol twice.
class Timed(val read: (int) -> string = { c: int -> "k" }, val now: () -> int = { 2 }) {
    fun go(): int = read(1).size + now()
}
class Counted(val base: int = 1, val step: () -> int = { 3 }) {
    fun go(): int = base + step()
}
fun make(): Timed = Timed()
fun count(): Counted = Counted()
fun main: int {
    val made = make()
    val given = Timed({ c: int -> "" })
    // 3 + 2 + 4 + 8 + 25
    made.go() + given.go() + count().go() + Counted(5).go() + 25
}
