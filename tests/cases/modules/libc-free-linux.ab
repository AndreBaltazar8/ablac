import "abla/io"
import "abla/fs"
import "abla/memory"
import "abla/process"

fun abandonRawGraph(): int {
    val values = ["raw-garbage-a", "raw-garbage-b", "raw-garbage-c"]
    values.size
}

fun main: int {
    val root = path("build/libc-free-target/program-data")
    val file = root.child("value.txt")
    val filesystemValid = root.createDirectories() &&
        file.writeTextAtomic("raw-file") &&
        file.readText() == "raw-file" &&
        file.remove() && root.remove()
    val childValid = command("printf").argument("raw-child").captureText() ==
        "raw-child"
    val garbageSize = abandonRawGraph()
    val collected = memoryCollect()
    val before = memoryLiveBytes()
    val checkpoint = memoryCheckpoint()
    val values: array<string> = []
    var index = 0
    while (index < 32) {
        values.append("raw-allocation-$index")
        index = index + 1
    }
    val valid = values.size == 32 && values[31] == "raw-allocation-31" &&
        processArgumentCount() == 1 && processArgument(0) == "verified" &&
        filesystemValid && childValid && garbageSize == 3 && collected > 0
    println("libc-free abla")
    memoryReset(checkpoint)
    if (valid && memoryLiveBytes() == before) 42 else 1
}
