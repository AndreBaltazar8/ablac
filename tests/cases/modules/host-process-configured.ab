import "abla/fs"
import "abla/process/time"
import "abla/process/supervisor"

fun waitFor(process: SupervisedProcess): int {
    var status = process.poll()
    while (status == -1) {
        sleep(5)
        status = process.poll()
    }
    status
}

fun main: int {
    val clock = monotonicClock()
    val beforeNanoseconds = monotonicNanoseconds()
    val sleptPrecisely = sleepNanoseconds(1000000)
    val afterNanoseconds = monotonicNanoseconds()
    val reusableBefore = clock.nanoseconds()
    val reusableSlept = clock.sleepNanoseconds(1000000)
    val reusableAfter = clock.nanoseconds()
    val directory = currentDirectory().text
    val output = "$directory/build/host-process-configured.log"
    path(output).createParentDirectories()
    val process = startSupervisedProcess(
        directory,
        ["sh", "-c", "printf '%s' \"\$ABLA_HOST_PROCESS_VALUE\""],
        ["ABLA_HOST_PROCESS_VALUE"],
        ["configured"],
        output
    )
    val status = waitFor(process)
    val slow = startSupervisedProcess(
        directory, ["sh", "-c", "sleep 10"], [], [], output
    )
    val stopped = slow.stop(10)
    if (status == 0 && path(output).readText() == "configured" &&
        stopped >= 128 && processProcessorCount() >= 1 &&
        processMonotonicMilliseconds() > 0 && monotonicMilliseconds() > 0 &&
        beforeNanoseconds > 0 && sleptPrecisely &&
        afterNanoseconds >= beforeNanoseconds &&
        !sleepNanoseconds(-1) && clock.valid() && reusableBefore > 0 &&
        reusableSlept && reusableAfter >= reusableBefore &&
        !clock.sleepNanoseconds(-1)) 42 else 1
}
