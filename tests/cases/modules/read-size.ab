// One read is sized by what is there, not by the caller's maximum (LinuxFileDescriptor.read, linuxReadSize): a regular file
// of 300000 bytes read with the largest maximum comes back whole in one read, a /proc file (its size reads 0) comes back
// too where there is one. The suite runs this under a memory limit that a 1 GiB buffer fails.
import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/process"
import "abla/text"

fun main: int {
    val directory = processEnvironmentOr("TMPDIR", "/tmp")
    val file = path("$directory/abla-read-size-${linuxProcessId()}.txt")
    val text = "0123456789".repeat(30000)
    if (!file.writeText(text)) return 1
    val descriptor = linuxOpen(file.text)
    val whole = descriptor.read(9223372036854775807)
    val again = descriptor.read(9223372036854775807)
    descriptor.close()
    file.removeTree()
    if (whole != text) return 2
    if (again != "") return 3
    if (!path("/proc/self/status").exists()) return 0
    val status = linuxOpen("/proc/self/status")
    val proc = status.read(9223372036854775807)
    status.close()
    if (!proc.startsWith("Name:")) return 4
    0
}
