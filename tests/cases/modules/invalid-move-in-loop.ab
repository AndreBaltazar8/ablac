// A loop between the declaration and the constructor runs it more than once
// with the same local: the local does not move.
class Name(var text: string)
class Couple(val first: Name, val second: Name)

fun couples(): array<Couple> {
    val out: array<Couple> = []
    val first = Name("x")
    for (i in 0 until 2) out.append(Couple(first, Name("y")))
    out
}

fun main: int = 0
