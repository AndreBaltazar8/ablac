// Compile-time parity of abla/regex: compiling patterns (and a bad one), matching, finding with groups, finding all and
// replacing print the same at run time and under `#` (tools/test-compile-time-parity.sh).
import "abla/io"
import "abla/regex"

fun boundedLabel(result: RegexSearchResult): string = when (result) {
    is RegexSearchMatch -> result.matched.text0()
    is RegexSearchMiss -> "miss"
    is RegexSearchExhausted -> "exhausted"
}

fun main: int {
    val bad = regexCompile("a(b")
    println("bad ${bad.succeeded} ${bad.error.message} at ${bad.error.offset}")
    val date = regexCompile("(\\d{4})-(\\d{2})-(\\d{2})").regex
    val found = date.find("released 2026-11-15, patched 2026-11-16")
    if (found != null) println("found ${found.text0()} at ${found.start()}-${found.end()} year ${found.group(1) ?? "-"} day ${found.group(3) ?? "-"}")
    for (match in date.findAll("2026-01-02 and 2027-03-04")) println("all ${match.text0()}")
    val word = regexCompile("[\\w-]+").regex
    println("matches ${word.matches("a-b")} ${regexCompile("^x+$").regex.matches("xxy")}")
    println("bounded ${boundedLabel(word.findWithin("a-b", 64))} ${boundedLabel(word.findWithin("a-b", 1))} ${boundedLabel(word.findWithin("!", 64))}")
    println("replace ${regexCompile("o+").regex.replace("foo boo", "0")}")
    println("alternation ${regexCompile("(a|b){3}").regex.find("zabb")?.group(1) ?? "none"}")
    42
}
