import "abla/memory"

// Reachable data held just under the limit while garbage keeps coming: pressure
// collection must not run at every allocating call from there on (each one
// would scan the whole heap and free next to nothing), so the garbage reaches
// the limit and the program stops with the limit's panic.

fun nearLimitBlock(seed: int): array<int> {
    val block: array<int> = []
    var index = 0
    while (index < 512) {
        block.append(seed + index)
        index = index + 1
    }
    block
}

fun nearLimitGarbage(round: int): int {
    val parts = ["a$round", "b$round"]
    parts[0].size + parts[1].size
}

fun main: int {
    memorySetLimit(8388608)
    val kept: array<array<int>> = []
    var seed = 0
    while (memoryLiveBytes() < memoryLimit() - memoryLimit() / 128) {
        kept.append(nearLimitBlock(seed))
        seed = seed + 1
    }
    var total = 0
    var round = 0
    while (round < 100000000) {
        total = total + nearLimitGarbage(round)
        round = round + 1
    }
    // Not reached: the garbage meets the limit first.
    if (total > 0 && kept.size > 0) 1 else 2
}
