// Generators are lazy: the body runs only as far as the consumer asks, and
// leaving the loop early (break, return) or dropping the generator closes it,
// running its defers. Also: an infinite generator, loops of every source kind
// and `when`/`do`-`while` around `yield`, nested generators.
import "abla/io"

fun naturals(limit: int): Generator<int> = generator {
    var n = 0
    while (n < limit) {
        println("produce $n")
        yield n
        n += 1
    }
}

fun forever(): Generator<int> = generator {
    var n = 0
    while (true) {
        yield n
        n += 1
    }
}

fun guarded(): Generator<int> = generator {
    println("start")
    defer { println("closed") }
    yield 1
    println("after 1")
    yield 2
    println("after 2")
}

fun shapes(words: array<string>): Generator<string> = generator {
    for (word in words) {
        if (word == "skip") continue
        if (word == "stop") break
        yield word
        for (c in word) {
            if (c == 98) yield "b!"
        }
    }
    for (i in 0 until 3) yield "u$i"
    for (i in 1..2) yield "c$i"
    var k = 0
    do {
        when (k) {
            0 -> yield "zero"
            1 -> {
                val label = "one"
                yield label
                yield "${label}!"
            }
            else -> yield "many"
        }
        k += 1
    } while (k < 3)
}

fun inner(tag: string): Generator<int> = generator {
    defer { println("close $tag") }
    yield 1
    yield 2
}

fun outer(): Generator<int> = generator {
    for (v in inner("a")) yield v * 10
    yield 99
}

class Clamped(var current: int, val maximum: int) {
    fun getValue(): int = current

    fun setValue(next: int): void {
        current = if (next > maximum) maximum else next
        return
    }
}

// A delegated local lives across a `yield`: the generator keeps its delegate.
fun clamped(): Generator<int> = generator {
    var level by Clamped(0, 5)
    while (level < 5) {
        yield level
        level = level + 2
    }
    yield level
}

fun firstOf(): int {
    for (v in inner("r")) return v
    0
}

fun main {
    for (n in naturals(5)) {
        println("got $n")
        if (n == 2) break
    }
    var total = 0
    for (n in forever()) {
        if (n > 100) break
        total += n
    }
    println("total $total")
    for (v in guarded()) {
        println("v $v")
        if (v == 1) break
    }
    println("--")
    for (v in guarded()) println("v $v")
    println("--")
    val unused = guarded()
    println("dropping")
    for (s in shapes(["a", "bb", "skip", "c", "stop", "d"])) println(s)
    for (v in outer()) {
        println("o $v")
        if (v == 10) break
    }
    println("first ${firstOf()}")
    for (level in clamped()) println("level $level")
    println("end")
}
