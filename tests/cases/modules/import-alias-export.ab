// An alias reaches what the module's `export import`s pass on, keeps it apart
// from a same-named declaration here, and prefers the module's own declaration.
import "alias-facade/facade.ab" as f
import "alias-facade/shadowing.ab" as s
fun hidden(): int = 1000
fun main: int {
    val shape: f.Shape = f.Shape(7)
    f.shapeSides(shape) + f.facadeSides() + s.shared() + s.hidden() - 100 + f.hidden() +
        (hidden() - 1000) + 25
}
