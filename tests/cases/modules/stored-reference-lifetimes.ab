class Counter(var value: int)

class CounterHolder(val counter: Counter)

fun increment(var counter: Counter, delta: int): int {
    counter.value = counter.value + delta
    counter.value
}

fun borrowHolder(
    counter: Counter
): borrow(counter) CounterHolder = CounterHolder(counter)

fun makeHolder(value: int): CounterHolder =
    CounterHolder(Counter(value))

fun storedReferenceAfterLastUse(): int {
    val counter = Counter(20)
    val holder = CounterHolder(counter)
    val observed = holder.counter.value
    increment(counter, 2)
    observed + counter.value
}

fun contractedStoredReference(): int {
    val counter = Counter(21)
    val holder = borrowHolder(counter)
    holder.counter.value + counter.value
}

compile fun stagedStoredReferences(): int =
    storedReferenceAfterLastUse() + contractedStoredReference() - 42

fun main: int {
    if (#stagedStoredReferences() == 42 &&
        storedReferenceAfterLastUse() == 42 &&
        contractedStoredReference() == 42 &&
        makeHolder(42).counter.value == 42) 42 else 0
}
