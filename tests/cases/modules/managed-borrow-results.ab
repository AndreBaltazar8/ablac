// `borrow(source) T` on an ordinary class: a function or method returns a
// view of a parameter or of `this`, and the caller's use of it is checked
// against the source like any other alias.
class Counter(var value: int)

class Holder(val counter: Counter) {
    fun view(): borrow(this) Counter = counter
    fun viewThrough(): borrow(this) Counter = this.counter
}

fun same(counter: Counter): borrow(counter) Counter = counter

fun firstOrNew(left: Counter, first: bool): borrow(left) Counter =
    if (first) left else Counter(0)

fun found(counters: array<Counter>, value: int): borrow(counters) Counter {
    for (counter in counters) if (counter.value == value) return counter
    return Counter(-1)
}

fun increment(var counter: Counter): void {
    counter.value = counter.value + 1
    return
}

fun views(): int {
    val counter = Counter(10)
    val view = same(counter)
    val observed = view.value
    increment(counter) // legal: `view` was last used above
    val holder = Holder(Counter(20))
    val held = holder.view().value + holder.viewThrough().value
    val counters = [Counter(1), Counter(2)]
    observed + counter.value - 11 + held - 40 + found(counters, 2).value +
        firstOrNew(counter, true).value - 11 + firstOrNew(counter, false).value
}

compile fun stagedViews(): int = views()

fun main: int = if (views() == 12 && #stagedViews() == 12) 42 else 0
