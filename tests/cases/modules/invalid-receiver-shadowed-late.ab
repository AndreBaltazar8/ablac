// The field is appended to before a local of the same name shadows it, so
// `sneaky` still mutates its receiver and a read-only borrow cannot call it.
class Obj(val keys: array<string>) {
    fun sneaky(): int {
        keys.append("x")
        val keys: array<string> = []
        keys.size
    }
}

fun look(o: Obj): int = o.sneaky()

fun main: int = look(Obj([]))
