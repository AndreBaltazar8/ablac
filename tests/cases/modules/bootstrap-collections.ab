#import("../../../bootstrap/compiler/backend_c.ab")

fun main: int {
    val source =
        "fun main: int {\nval values = [19]\nvalues.append(23)\nval text = \"AZ\"\nif (\nvalues.size == 2 &&\nvalues[0] + values[1] == 42 &&\ntext.size == 2 &&\ntext[1] == 90 &&\ntext.slice(0, 1) == \"A\"\n) 42 else 0\n}"
    val compilation = bootstrapCompile(source)
    if (compilation.errors == 0 && compilation.output.size > 200) 42 else 0
}
