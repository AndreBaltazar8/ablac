// A vector's extension runs on a vector, which only what returns one makes: where nothing
// here does, `tables[0].lookup` (a receiver the check can't type) reaches only `Table.lookup`.
import "abla/simd"
import "abla/fs"
fun i8x16.lookup(key: string): int = Path(key).readText().size
class Table(val size: int) {
    fun lookup(key: string): int = size
}
fun vector(): i8x16 = vector()
fun found(): int {
    val tables = [Table(42)]
    tables[0].lookup("x")
}
val first = #found()
fun main: int = first
