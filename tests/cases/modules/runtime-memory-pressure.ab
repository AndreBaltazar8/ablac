#import("abla/memory")

class PressureLink(var next: PressureLink?, val value: int)

fun abandonPressureCycle(): int {
    val left = PressureLink(null, 20)
    val right = PressureLink(left, 22)
    left.next = right
    left.value + right.value
}

fun main: int {
    // Selecting a small managed-memory limit also selects the collector. Each
    // allocation-capable function entry is a compiler-published safe point.
    memorySetLimit(32768)
    var index = 0
    var sum = 0
    while (index < 400) {
        sum = abandonPressureCycle()
        index = index + 1
    }
    if (sum == 42 && memoryLiveBytes() < memoryLimit()) 42 else 1
}
