// A lambda's inferred result types what is done with a call of it, as a declared
// type would: in a local, a global, or a global `var` of a declared function type.
import "abla/simd"
class Text(val value: string) {
    fun twice(): string = this.value + this.value
}
fun same(text: string): string = text
fun make(text: string): Text = Text(text)
fun <T> pass(value: T): T {
    val again = { x: T -> x }
    again(value)
}
val globalRead = { text: string -> same(text) }
var source: (int) -> string = { count: int -> "abc" }
fun main: int {
    val read = { text: string -> same(text) }
    if (read("x") + "y" != "xy") return 1
    if ((read("x") + "y").size != 2) return 2
    if ((globalRead("x") + "yz").size != 3) return 3
    val count = 3
    val given = source(count)
    if (given.size != 3) return 4
    val once = move { text: string -> same(text) }
    if (once("abcd").size != 4) return 5
    var total = 0
    val adding = { step: int ->
        total = total + step
        total
    }
    if (adding(5) + 1 != 6) return 6
    val built = { text: string -> make(text) }
    if (built("ab").twice() != "abab") return 7
    if (pass("abc") + "d" != "abcd") return 8
    if (pass(4) + 1 != 5) return 9
    val a = u32x4(1, 2, 3, 4)
    val add = { x: u32x4 -> x + a }
    // text() of the u32x4 overload, not the first one of that name.
    if (add(a).text() != "[2, 4, 6, 8]") return 10
    42
}
