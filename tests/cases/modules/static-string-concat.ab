// `+` over string literals is a static string (sema folds its type); it must
// lower to one constant — it once reached the numeric add at runtime and trapped.
fun size(text: string): int = text.size

val joined = "abc" + "def"

fun main: int {
    val local = "x" + "y" +
        "z"
    if (size("12" + "345") != 5) return 1
    if (joined != "abcdef" || local != "xyz") return 2
    42
}
