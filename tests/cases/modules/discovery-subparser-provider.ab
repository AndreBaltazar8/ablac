import "abla/compiler/parser"

compile fun parseDiscoveryValue(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    parserRawSkipWhitespace(cursor)
    val expression = parserParseAblaExpression(cursor)
    parserRawSkipWhitespace(cursor)
    parserExpect(cursor, ")")
    expression
}

#compilerRegisterSubparser("discoveryValue", parseDiscoveryValue)
