import "abla/http"
import "abla/sys/linux/io"

fun serverCustomerV1(request: HttpRequest): HttpResponse =
    httpText("v1:${request.parameter("id")}")

fun serverCustomerV2(request: HttpRequest): HttpResponse {
    val previous = serverCustomerV1(request)
    httpText("${previous.body}:v2")
}

fun serverHealth(request: HttpRequest): HttpResponse = httpText("healthy")

fun main: int {
    val router = httpRouter("Stripe-Version")
    router.get("/health", serverHealth)
    router.version("2024-01-01").get("/customers/:id", serverCustomerV1)
    router.version("2025-01-01").get("/customers/:id", serverCustomerV2)

    val listener = tcpListen(0)
    linuxPrintStandardError("${listener.localPort()}\n")
    serveHttpOnce(router, listener)
    serveHttpOnce(router, listener)
    serveHttpOnce(router, listener)
    listener.close()
    42
}
