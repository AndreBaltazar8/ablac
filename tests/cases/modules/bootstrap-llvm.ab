import "../../../src/native_install.ab"
import "../../../src/backend/llvm/backend.ab"

fun emitAfterInstall(source: string): string {
    bootstrapNativeInstall()
    bootstrapEmitLlvm(source)
}

fun main: string = emitAfterInstall(
    "fun choose(value: int): int {\n    var adjusted = value\n    while (adjusted < 42) adjusted = adjusted + 1\n    if (adjusted == 42) adjusted else 0\n}\nfun main: int = choose(39)\n"
)
