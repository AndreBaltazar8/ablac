#import("abla/io/buffered")

fun main: int {
    val target = path("build/portable-buffered-io/result.txt")
    val writer = bufferedFileWriter(target, 5)
    val first = writer.write("hello")
    val second = writer.writeLine(" abla")
    val flushed = writer.flush()

    val appended = bufferedFileWriter(target, 3, true)
    val third = appended.write("!")
    val finalFlush = appended.flush()

    if (first && second && flushed && third && finalFlush &&
        writer.pendingBytes() == 0 && writer.isHealthy() &&
        target.readText() == "hello abla\n!") 42 else 0
}
