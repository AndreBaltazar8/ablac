// The flat host API's TLS (abla/platform/host/tls, over abla/tls/pure) is part of the compile-time parity set: what it says it
// provides is the same at compile time and at run time. The connections themselves are tools/test-compile-tls.sh (a local TLS server).
import "abla/platform/host/tls"

fun main: int = if (ablaHostTlsAvailable() && ablaHostTlsError().size >= 0) 42 else 0
