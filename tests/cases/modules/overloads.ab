// Overloading by parameter types (free functions, extensions, methods) and
// operator functions, resolved statically to one declaration per call.
class N(val v: int)

fun describe(n: int): int = n
fun describe(s: string): int = s.size * 100
fun describe(a: int, b: int): int = a * 10 + b

fun N.scaled(other: N): N = N(this.v * other.v)
fun N.scaled(k: int): N = N(this.v * k)
operator fun N.plus(other: N): N = N(this.v + other.v)
operator fun N.plus(k: int): N = N(this.v + k)
operator fun N.times(other: N): N = this.scaled(other)
operator fun N.minus(other: N): N = N(this.v - other.v)
operator fun N.unaryMinus(): N = N(0 - this.v)
operator fun int.times(n: N): N = n.scaled(this)

class Counter(val n: int) {
    fun add(other: Counter): Counter = Counter(this.n + other.n)
    fun add(k: int): Counter = Counter(this.n + k)
    operator fun div(k: int): Counter = Counter(this.n / k)
}

fun main: int {
    if (describe(4) != 4 || describe("abc") != 300 || describe(1, 2) != 12) return 1
    val a = N(2)
    val b = N(3)
    if (a.scaled(b).v != 6 || a.scaled(10).v != 20) return 2
    // Precedence and unary minus: 2 + 3 * 3 - (-2) = 13.
    if ((a + b * b - -a).v != 13) return 3
    // An operator on a receiver of int: 2 * a + 1 = 5.
    if ((2 * a + 1).v != 5) return 4
    if ((Counter(10).add(Counter(5)).add(1) / 2).n != 8) return 5
    // Scalar arithmetic is untouched.
    if (3 + 4 * 2 != 11) return 6
    42
}
