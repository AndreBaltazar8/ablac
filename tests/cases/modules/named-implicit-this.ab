// A named call by plain name in a method reaches the receiver's method first.
fun outer(a: int): int = a + 1000
class Box(val base: int) {
    fun add(a: int, b: int = 2): int = this.base + a * b
    fun viaDefault(): int = add(a = 3)
    fun viaBoth(): int = add(b = 4, a = 3)
    // No method of that name: the top-level function.
    fun viaTop(): int = outer(a = 1)
}
fun Box.twice(n: int, by: int = 2): int = n * by + this.base
fun Box.viaExtension(): int = twice(n = 2)
// Another class's differing `add` doesn't make this one ambiguous.
class Other(val c: int) {
    fun add(first: int, a: int, b: int): int = first + a + b + this.c
}
fun main: int {
    val box = Box(1)
    val total = box.viaDefault() + box.viaBoth() + box.viaTop() + box.viaExtension()
    // 7 + 13 + 1001 + 5 = 1026
    if (total == 1026 && Other(1).add(1, 1, 1) == 4) 42 else total
}
