// A named call by plain name in a method reaches the receiver's method first.
fun outer(a: int): int = a + 1000
class Box(val base: int) {
    fun add(a: int, b: int = 2): int = this.base + a * b
    fun viaDefault(): int = add(a = 3)
    fun viaBoth(): int = add(b = 4, a = 3)
    // No method of that name: the top-level function.
    fun viaTop(): int = outer(a = 1)
}
fun Box.twice(n: int, by: int = 2): int = n * by + this.base
fun Box.viaExtension(): int = twice(n = 2)
// Another class's differing `add` doesn't make this one ambiguous.
class Other(val c: int) {
    fun add(first: int, a: int, b: int): int = first + a + b + this.c
}
// A method of the name without those parameters: the top-level function, by
// name, whichever arguments the method would take by position. The function's
// defaults call top-level functions, whatever the caller's class has.
fun helper(n: int): int = n + 100
fun shared(top: int, other: int = helper(1)): int = top + other
class Shadows(val limit: int) {
    fun shared(a: int): int = a + 1
    fun helper(n: int): int = n + 5
    fun viaName(): int = shared(top = 5)
    fun viaLambda(): int {
        val run = { -> shared(top = 6) }
        run()
    }
    fun viaOwn(): int = shared(a = 5)
}
fun Shadows.twiceOf(a: int): int = a * 2
fun twiceOf(top: int): int = top + 1000
fun Shadows.viaExtension(): int = twiceOf(top = 3)
fun main: int {
    val box = Box(1)
    val total = box.viaDefault() + box.viaBoth() + box.viaTop() + box.viaExtension()
    val shadows = Shadows(0)
    // 5 + 101, 6 + 101, 5 + 1, 1003
    if (shadows.viaName() != 106 || shadows.viaLambda() != 107 || shadows.viaOwn() != 6 ||
        shadows.viaExtension() != 1003) return 1
    // 7 + 13 + 1001 + 5 = 1026
    if (total == 1026 && Other(1).add(1, 1, 1) == 4) 42 else total
}
