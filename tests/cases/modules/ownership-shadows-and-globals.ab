// A local or parameter named like a field shadows it: a method that only
// fills its own `keys` leaves the receiver alone. A reference rooted in a
// global (an element found in its array, the array itself, a local read
// from it) outlives every call and may be returned.
class Obj(val keys: array<string>, val values: array<string>) {
    fun honest(): int {
        val keys: array<string> = []
        keys.append("y")
        keys.size
    }
}

fun Obj.done(): string {
    val keys: array<string> = []
    for (k in this.keys) keys.append(k)
    "${keys.size}"
}

fun Obj.with(key: string, value: Obj): Obj {
    this.keys.append(key)
    this.values.append(value.done())
    this
}

class Row(var name: string)
class Store(var rows: array<Row>)
val store = Store([Row("a"), Row("b")])

fun find(name: string): Row? {
    for (row in store.rows) if (row.name == name) return row
    null
}

fun first(): Row = store.rows[0]
fun allRows(): array<Row> = store.rows
fun second(): Row {
    val row = store.rows[1]
    row
}

fun peek(o: Obj): int = o.honest()

// Constructing from a receiver's scalar field neither mutates the receiver
// (a class's `var` fields are not mutable-borrow parameters) nor makes the
// result anything but fresh.
class Vec(var x: f64)
fun Vec.copy(): Vec = Vec(this.x)
fun doubled(a: Vec): Vec {
    val v = a.copy()
    v.x = v.x * 2.0
    v
}

// A `var` that is never reassigned keeps its fresh initializer.
fun evens(n: int): array<int> {
    var out = [0, 0, 0]
    for (i in 0 until n) out[i] = i * 2
    out
}

// Fresh locals move into a constructor that is their last use.
class Name(var text: string)
class Couple(val first: Name, val second: Name)
fun couple(): Couple {
    val first = Name("x")
    val second = Name("y")
    first.text = "x2"
    Couple(first, second)
}

fun main: int {
    val inner = Obj(["a"], [])
    val outer = Obj([], []).with("config", inner)
    val found = find("b")
    if (found != null) found.name = "B"
    if (peek(Obj([], [])) == 1 && outer.values[0] == "1" &&
        store.rows[1].name == "B" && first().name == "a" &&
        allRows().size == 2 && second().name == "B" &&
        doubled(Vec(1.5)).x == 3.0 && evens(3)[2] == 4 &&
        couple().first.text == "x2" && couple().second.text == "y") 42 else 1
}
