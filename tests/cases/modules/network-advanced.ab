import "network-v6-dns.ab" as v6
import "http-advanced.ab" as streaming
import "http-event.ab" as httpEvent
import "websocket-event.ab" as webSocketEvent
import "hosted-network.ab" as hosted
import "tls.ab" as tls

fun main: int {
    val ipv6AndDns = v6.main()
    val httpStreaming = streaming.main()
    val eventHttp = httpEvent.main()
    val eventWebSocket = webSocketEvent.main()
    val hostedSockets = hosted.main()
    val secureTransport = tls.main()
    if (ipv6AndDns == 42 && httpStreaming == 42 && eventHttp == 42 &&
        eventWebSocket == 42 && hostedSockets == 42 &&
        secureTransport == 42) 42 else 1
}
