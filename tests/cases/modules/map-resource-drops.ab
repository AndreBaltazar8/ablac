import "abla/io"

resource class Token(val id: int) {
    fun drop(): void {
        println("drop $id")
        return
    }
}

fun main {
    val tokens: Map<string, Token> = Map()
    tokens.set("a", Token(1))
    tokens.set("a", Token(2))
    println("replaced")
    tokens.remove("a")
    println("removed")
    tokens.set("b", Token(3))
    println("end")
}
