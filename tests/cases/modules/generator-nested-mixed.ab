import "abla/io"
fun nums(): Generator<int> = generator { yield 1 }
class Holder(val gen: Generator<int>)
fun outer(choice: bool): Generator<int> = generator { val holder =
        Holder(nums()); for (v in if (choice) holder.gen else nums()) yield v }
fun once(choice: bool): int { var n = 0; for (v in outer(choice)) n += v; n }
fun main: int { var n = 0; for (i in 0 until 1000) n += once(i % 2 ==
    0); val a: array<string>=[]; for (i in 0 until 2000) a
        .append("item $i"); println("$n ${a.size}"); 0 }
