import "abla/float"

fun transform(value: f64, scale: f64): f64 =
    -(value * scale + 0.5) / 2.0

fun apply(callback: Fn(f64) -> f64, value: f64): f64 = callback(value)

class Point(val x: f64, var y: f64)

val goldenRatio = 1.618
var globalScale: f64 = 2.0

fun main: int {
    val transformed = transform(3.0, 4.0)
    val scientific = 1.25e2
    val separated = 1_0.0_0
    val square: Fn(f64) -> f64 = { value: f64 -> value * value }
    val point = Point(1.25, 2.5)
    point.y = point.y + 1.0
    val values = [1.5, 2.5]
    globalScale = globalScale + 0.5
    if (transformed == -6.25 && transformed < 0.0 &&
        scientific == 125.0 && separated == 10.0 &&
        9.0 / 4.0 == 2.25 && 2.0 + 3.0 == 5.0 &&
        7.0 - 2.0 == 5.0 && transformed != 6.25 &&
        apply(square, 3.0) == 9.0 && point.x + point.y == 4.75 &&
        values[0] + values[1] == 4.0 && goldenRatio == 1.618 &&
        globalScale == 2.5 &&
        f64ToBits(1.0) == 4607182418800017408 &&
        f64FromBits(4607182418800017408) == 1.0 &&
        f64FromInt(-7) == -7.0 &&
        f64FromInt(9007199254740992) == 9007199254740992.0) 42 else 1
}
