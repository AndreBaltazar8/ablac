import "abla/io"

var closes: int = 0
var holders: int = 0
fun numbers(): Generator<int> = generator {
    defer { closes += 1 }
    yield 1
    yield 2
}
resource class Holder(val gen: Generator<int>) {
    fun drop(): void { holders += 1 }
}

fun outer(indexed: bool, stop: bool): Generator<int> = generator {
    yield 0
    for (value in if (indexed) [Holder(numbers())][0].gen else Holder(numbers()).gen) {
        yield value
        if (stop) break
    }
}

fun mixed(fresh: bool): Generator<int> = generator {
    val owner = Holder(numbers())
    for (value in if (fresh) Holder(numbers()).gen else owner.gen) yield value
}

fun returned(): Generator<int> = generator {
    for (value in Holder(numbers()).gen) {
        yield value
        return
    }
}

fun indirect(choice: bool): Generator<int> = generator {
    val factory: () -> Holder = { Holder(numbers()) }
    for (value in when (choice) {
        true -> (if (true) factory else factory)().gen
        else -> Holder(numbers()).gen
    }) yield value
}

fun exercise(): int {
    closes = 0
    holders = 0
    var total = 0
    for (i in 0 until 6) {
        for (value in outer(i % 2 == 0, i / 2 == 1)) {
            total += value
            if (i / 2 == 0 || (i / 2 == 1 && value == 1)) break
        }
    }
    for (value in mixed(true)) { total += value; break }
    for (value in mixed(false)) { total += value; break }
    for (value in returned()) total += value
    for (value in indirect(true)) { total += value; break }
    for (value in indirect(false)) { total += value; break }
    total * 10000 + closes * 100 + holders
}

val evaluated = #exercise()
fun main: int {
    val actual = exercise()
    println("$actual ${evaluated == actual}")
    0
}
