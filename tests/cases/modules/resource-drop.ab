var drops = 0

resource class Ticket(val value: int) {
    fun drop(): void {
        drops = drops + value
        return
    }
}

class DropCounter(var value: int)

resource class StagedTicket(val counter: DropCounter, val amount: int) {
    fun drop(): void {
        counter.value = counter.value + amount
        return
    }
}

compile fun stagedLocalDrops(counter: DropCounter): void {
    var ticket = StagedTicket(counter, 2)
    ticket = StagedTicket(counter, 3)
    return
}

compile fun stagedEarlyDrop(counter: DropCounter): void {
    val ticket = StagedTicket(counter, 7)
    return
}

compile fun stagedConsume(own ticket: StagedTicket): void {}

compile fun stagedReturn(counter: DropCounter): StagedTicket {
    val ticket = StagedTicket(counter, 13)
    ticket
}

compile fun stagedReturnedDrop(counter: DropCounter): void {
    val ticket = stagedReturn(counter)
    return
}

compile fun stagedDropTrace(): int {
    val counter = DropCounter(0)
    stagedLocalDrops(counter)
    stagedEarlyDrop(counter)
    stagedConsume(StagedTicket(counter, 11))
    stagedReturnedDrop(counter)
    counter.value
}

fun normalExit() {
    val ticket = Ticket(1)
}

fun reassignment() {
    var ticket = Ticket(2)
    ticket = Ticket(3)
}

fun earlyReturn() {
    val ticket = Ticket(4)
    return
}

fun loopControl() {
    var value = 4
    while (value < 6) {
        value = value + 1
        val ticket = Ticket(value)
        if (value == 5) continue
        break
    }
}

fun consume(own ticket: Ticket) {}

fun implicitReturn(value: int): Ticket {
    val ticket = Ticket(value)
    ticket
}

fun explicitReturn(value: int): Ticket {
    val ticket = Ticket(value)
    return ticket
}

fun ownedTransfer() {
    var ticket = Ticket(7)
    consume(move(ticket))
    ticket = Ticket(14)
}

fun returnedOwnership() {
    val before = drops
    val implicit = implicitReturn(8)
    val explicit = explicitReturn(9)
    if (drops != before) drops = 1000
}

fun main: int {
    normalExit()
    reassignment()
    earlyReturn()
    loopControl()
    ownedTransfer()
    returnedOwnership()
    if (drops == 59 && #stagedDropTrace() == 36) 42 else 1
}
