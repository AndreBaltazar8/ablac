import "abla/memory"

// Background freeing changes when unreachable memory goes back to the system
// allocator, never what the program computes.

class BackgroundLink(var next: BackgroundLink?, val value: int)

fun backgroundRound(round: int): int {
    val left = BackgroundLink(null, round)
    val right = BackgroundLink(left, round + 1)
    left.next = right
    val text = "round-$round"
    left.value + right.value + text.size
}

fun main: int {
    memorySetBackgroundFree(true)
    var total = 0
    var round = 0
    while (round < 2000) {
        total = total + backgroundRound(round)
        round = round + 1
    }
    memorySetBackgroundFree(false)
    if (total == 4018890) 42 else 1
}
