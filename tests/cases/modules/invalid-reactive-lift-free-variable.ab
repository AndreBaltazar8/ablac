import "abla/compiler"
import "abla/compiler/parser"

class LiftState(val value: int)

compile fun finalizeMissingCapture(
    payload: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val module = compilerGeneratedModule("reactive.invalid.free", expression)
    val captures: array<string> = []
    val names: array<string> = []
    val types: array<int> = []
    val mutable: array<bool> = []
    compilerGeneratedLiftedFunction(
        module,
        "invalidFree",
        captures,
        names,
        types,
        mutable,
        compilerFindType("i64"),
        expression
    )
    module
}

compile fun parseMissingCapture(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "reactive.invalid.free",
        "invalidFree",
        expression,
        finalizeMissingCapture
    )
    expression
}

#compilerRegisterSubparser("missingCapture", parseMissingCapture)

fun inspect(state: LiftState): int = $missingCapture(state.value)

fun main: int = inspect(LiftState(42))
