resource class Ticket(val value: int)

fun consumeHandle(own handle: Shared<Ticket>): int = handle.get().value
fun inspectTicket(ticket: Ticket): int = ticket.value
fun inspectBorrow(ticket: Borrow<Ticket>): int = ticket.value

fun borrowTicket(
    owner: Shared<Ticket>
): borrow(owner) Ticket = owner.get()

compile fun compileBorrowTicket(
    owner: Shared<Ticket>
): borrow(owner) Ticket = owner.get()

val globalBorrowTicket = borrowTicket
val globalBorrowTicketAlias = globalBorrowTicket

fun borrowingFunction(): (Shared<Ticket>) -> borrow(0) Ticket =
    borrowTicket

fun chooseBorrowedTicket(
    owner: Shared<Ticket>,
    chooseDirect: bool
): borrow(owner) Ticket {
    if (chooseDirect) return borrowTicket(owner)
    borrowTicket(owner)
}

fun invokeBorrowingFunction(
    callback: (Shared<Ticket>) -> borrow(0) Ticket,
    owner: Shared<Ticket>
): borrow(owner) Ticket = callback(owner)

resource class TicketOwner(val handle: Shared<Ticket>) {
    fun borrowTicket(): borrow(this) Ticket = this.handle.get()
}

fun consumeTicketOwner(own owner: TicketOwner): int =
    owner.handle.get().value

fun lastUseThenMove(flag: bool): int {
    val owner = Shared(Ticket(21))
    val view: Borrow<Ticket> = owner.get()
    val observed = if (flag) inspectTicket(view) else view.value
    val explicit = inspectBorrow(view)
    val moved = move(owner)
    observed + explicit + consumeHandle(move(moved)) - 21
}

class HandlePair(
    val left: Shared<Ticket>,
    val right: Shared<Ticket>
)

fun disjointPlaceBorrow(): int {
    val pair = HandlePair(
        Shared(Ticket(19)),
        Shared(Ticket(23))
    )
    val leftView = pair.left.get()
    val movedRight = move(pair.right)
    val leftValue = leftView.value
    val movedLeft = move(pair.left)
    consumeHandle(move(movedLeft)) + consumeHandle(move(movedRight)) +
        leftValue - 19
}

resource class TicketList(val tickets: array<Ticket>)

resource class Holder(var handle: Shared<Ticket>) {
    fun replace(value: int): void {
        handle = Shared(Ticket(value))
        return
    }
}

fun replaceHolder(var holder: Holder, value: int): void {
    holder.handle = Shared(Ticket(value))
    return
}

fun mutationAfterLastUse(): int {
    val holder = Holder(Shared(Ticket(20)))
    val firstView = holder.handle.get()
    val first = firstView.value
    replaceHolder(holder, 22)

    val secondView = holder.handle.get()
    val second = secondView.value
    holder.replace(0)
    first + second
}

fun projectedRead(): int {
    val owner = Shared(TicketList([Ticket(42)]))
    val view = owner.get()
    val copied = view
    val selected = if (true) { copied } else { view }
    val selectedByWhen = when (true) {
        true -> selected
        false -> view
    }
    val tickets = selectedByWhen.tickets
    val first = tickets[0]
    val answer = first.value
    val moved = move(owner)
    answer + consumeHandle(Shared(Ticket(0)))
}

fun returnedBorrowLifetime(flag: bool): int {
    val owner = Shared(Ticket(42))
    val direct = borrowTicket(owner)
    val callback = borrowTicket
    val indirect = callback(owner)
    val indirectGlobal = globalBorrowTicket(owner)
    val indirectGlobalAlias = globalBorrowTicketAlias(owner)
    val returnedCallback = borrowingFunction()
    val indirectReturned = returnedCallback(owner)
    val higherOrder = invokeBorrowingFunction(callback, owner)
    val selected = if (flag) direct else borrowTicket(owner)
    val chosen = chooseBorrowedTicket(owner, !flag)
    val answer = selected.value + chosen.value + indirect.value +
        indirectGlobal.value + indirectGlobalAlias.value +
        indirectReturned.value + higherOrder.value - 252
    val moved = move(owner)
    val holder = TicketOwner(Shared(Ticket(42)))
    val methodView = holder.borrowTicket()
    val methodAnswer = methodView.value
    val movedHolder = move(holder)
    answer + methodAnswer - consumeTicketOwner(move(movedHolder)) +
        consumeHandle(Shared(Ticket(0)))
}

compile fun stagedBorrowLifetime(): int {
    val owner = Shared(Ticket(42))
    val compileView = compileBorrowTicket(owner)
    val compileAnswer = compileView.value
    val moved = move(owner)
    if (lastUseThenMove(false) == 42 && compileAnswer == 42 &&
        disjointPlaceBorrow() == 42 && projectedRead() == 42 &&
        mutationAfterLastUse() == 42 &&
        returnedBorrowLifetime(false) == 42) 42 else 0
}

fun main: int =
    if (lastUseThenMove(true) == 42 &&
        disjointPlaceBorrow() == 42 && projectedRead() == 42 &&
        mutationAfterLastUse() == 42 &&
        returnedBorrowLifetime(true) == 42 &&
        #stagedBorrowLifetime() == 42) 42 else 0
