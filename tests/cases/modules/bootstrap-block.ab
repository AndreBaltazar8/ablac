#import("../../../src/backend_c.ab")

fun main: int {
    val source =
        "fun main: int {\nvar value = 39\nwhile (value < 42) { value = value + 1 }\nif (value == 42) value else 0\n}"
    val parsed = bootstrapParse(source)
    val compilation = bootstrapCompile(source)
    if (
        parsed.errors == 0 &&
        parsed.declarations.size == 1 &&
        parsed.declarations[0].expression.kind == "block" &&
        parsed.declarations[0].expression.children.size == 3 &&
        parsed.declarations[0].expression.children[0].kind == "local.var" &&
        parsed.declarations[0].expression.children[1].kind == "while" &&
        parsed.declarations[0].expression.children[2].kind == "if" &&
        compilation.errors == 0 &&
        compilation.output.size > 100
    ) 42 else 0
}
