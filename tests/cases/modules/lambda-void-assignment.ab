// A lambda passed or declared where a `void` function is expected may end
// in an assignment; a declared function type also gives a lambda its
// parameter types.
class Box(var value: int)

val box = Box(0)
var total = 0
val slots = [0, 0]

fun each(values: array<int>, callback: (int) -> void): void {
    for (value in values) callback(value)
    return
}

fun main: int {
    each([1, 2, 3]) { value ->
        total = total + value
    }
    each([6]) { value -> total += value }
    each([4]) { value -> box.value = value }
    each([5]) { value -> slots[1] = value }
    each([1]) { value ->
        box.value += value
    }
    val add: (int) -> void = { value -> box.value = box.value + value }
    add(10)
    if (total == 12 && box.value == 15 && slots[1] == 5) 42 else 1
}
