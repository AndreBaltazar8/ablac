import "abla/json"

// jsonValidate decides as jsonParse does, with the same error, without a tree:
// at run time and under `#` alike.

fun jsonValidateAgrees(source: string, limits: JsonLimits): bool {
    val parsed = jsonParse(source, limits)
    val checked = jsonValidate(source, limits)
    checked.succeeded == parsed.succeeded && checked.error.code == parsed.error.code &&
        checked.error.byteOffset == parsed.error.byteOffset &&
        checked.error.line == parsed.error.line && checked.error.column == parsed.error.column &&
        checked.error.message == parsed.error.message && checked.value.isNull()
}

fun main: int {
    val merging = JsonLimits(4096, 8, 1000, 64, 2, false, true)
    val sources = [
        "{\"a\":[1,2.5e3,-0,true,false,null],\"b\":{\"c\":\"\\u00e9\\n\"}}",
        "[1, 2, {\"a\": tru}]",
        "{\"a\":1,\"a\":2}",
        "{\"a\":1,\"b\":2,\"a\":3}",
        "{\"a\":1,\"b\":2,\"c\":3}",
        "[01]",
        "+1",
        "\"\\ud800\"",
        "[1,]",
        "{\"k\" 1}",
        "  [ ] x"
    ]
    var agreed = 0
    for (source in sources) {
        if (jsonValidateAgrees(source, jsonDefaultLimits())) agreed = agreed + 1
        if (jsonValidateAgrees(source, merging)) agreed = agreed + 1
        if (jsonValidateAgrees(source, jsonPermissiveLimits)) agreed = agreed + 1
    }
    if (agreed == sources.size * 3 && jsonValidate("[1,2]").succeeded &&
        !jsonValidate("[1,2").succeeded) 42 else agreed
}
