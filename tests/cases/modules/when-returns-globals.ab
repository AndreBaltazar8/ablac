// A returned reference needs no contract when every branch gives a global or a
// new value, in any mix, through `if` and `when` alike.
import "abla/process"
val A = [1]
val B = [2]
fun pick(n: string): array<int> = when (n) {
    "a" -> A
    else -> B
}
fun mixed(n: string): array<int> = when (n) {
    "a" -> A
    "new" -> [10]
    else -> panic("no $n")
}
fun mixedIf(n: int): array<int> = if (n == 0) A else [20]
fun nested(n: int): array<int> = when (n) {
    0 -> if (n == 0) B else [30]
    else -> A
}
fun main: int = pick("a")[0] + pick("b")[0] + mixed("a")[0] + mixed("new")[0] +
    mixedIf(1)[0] + nested(0)[0] + nested(1)[0] + 5
