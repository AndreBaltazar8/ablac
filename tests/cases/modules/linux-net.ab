import "abla/net"
import "abla/text"
import "abla/random"
import "abla/net/contracts"

// The listener's port, handed to the client thread.
resource class NetworkTestPort(val value: int)

fun networkCancelNow(): bool = true

fun networkTcpClient(port: Shared<NetworkTestPort>): int {
    val connection = tcpConnectIpv4("127.0.0.1", port.get().value, 1000)
    if (connection.descriptor < 0) return 1
    val written = connection.writeNetwork("ping", 1000)
    val response = connection.readWithTimeoutResult(128, 1000)
    val closed = connection.close()
    var wanted = ""
    var wantedIndex = 0
    while (wantedIndex < 70) {
        wanted = "$wanted!"
        wantedIndex = wantedIndex + 1
    }
    if (written.succeeded() && written.written == 4 &&
        response.hasData() && response.bytes == wanted && closed) 0 else 2
}

fun testTcp(): bool {
    val listener = tcpListen(0)
    val port = Shared(NetworkTestPort(listener.localPort()))
    val client = thread { networkTcpClient(port) }
    val connection = listener.accept()
    val request = connection.readWithTimeoutResult(16, 1000)
    val typed = request.networkOutcome()
    val cancelled = connection.readNetwork(
        16, 1000, NetworkCancellation(networkCancelNow), 10
    )
    val cancelledWrite = connection.writeNetwork(
        "unused", 1000, NetworkCancellation(networkCancelNow), 10
    )
    // More than 64 rope leaves exercises the bounded scatter-write fallback;
    // the offset also verifies that already-written bytes are skipped exactly.
    var responseText = "xx"
    var responseIndex = 0
    while (responseIndex < 70) {
        responseText = "$responseText!"
        responseIndex = responseIndex + 1
    }
    val response = connection.writeCompact(responseText, 2)
    val clientStatus = await client
    val eof = connection.readWithTimeoutResult(16, 1000)
    val connectionClosed = connection.close()
    val listenerClosed = listener.close()
    request.hasData() && request.bytes == "ping" &&
        typed.hasData() && !typed.error.present() &&
        cancelled.cancelled() && cancelled.error.category == "cancelled" &&
        cancelledWrite.cancelled() &&
        response.succeeded() && response.written == 70 &&
        clientStatus == 0 && eof.reachedEof() &&
        connectionClosed && listenerClosed &&
        connection.descriptor == -1 && listener.descriptor == -1
}

fun testUdp(): bool {
    val socket = udpBindPort(0)
    val socketDescriptor = socket.descriptor
    val port = socket.localPort()
    val poller = socketPoller()
    val watched = poller.watchDescriptor(socket.descriptor)
    val idle = poller.wait(8, 0)
    val before = socket.receiveFromWithTimeout(64, 10)
    val sent = socket.sendTo("hello", ipv4Loopback(port))
    val ready = poller.wait(8, 1000)
    val received = socket.receiveFromWithTimeout(64, 1000)
    val unwatched = poller.unwatchDescriptor(socket.descriptor)
    val pollerClosed = poller.close()
    val closed = socket.close()
    socket.descriptor == -1 && port > 0 && before.timedOut &&
        watched && idle.timedOut && !idle.failed() &&
        sent.succeeded() && sent.written == 5 && received.received &&
        ready.events.size == 1 && ready.events[0].readable &&
        ready.events[0].descriptor == socketDescriptor &&
        !received.timedOut && !received.truncated &&
        received.bytes == "hello" &&
        received.source.address == "127.0.0.1" &&
        received.source.port == port && unwatched && pollerClosed && closed
}

// A peer that never reads: the socket accepts some bytes, then the deadline
// expires, and the outcome must still count what was accepted.
fun testStalledWrite(): bool {
    val listener = tcpListen(0)
    val connection = tcpConnectIpv4("127.0.0.1", listener.localPort(), 1000)
    val peer = listener.accept()
    val payload = "x".repeat(16 * 1024 * 1024)
    val outcome = connection.writeNetwork(payload, 300)
    val closed = connection.close() && peer.close() && listener.close()
    outcome.timedOut() && outcome.written > 0 &&
        outcome.written < payload.size && closed
}

// A read asked for the largest count, or none: the bytes waiting are read with a buffer of at most 1 MiB (the buffer,
// count + 1 bytes, wrapped to a 1-byte allocation for the largest int and the read was refused; then a 1 GiB cap allocated
// 1 GiB up front, which the suite's memory limit refuses); a count of 0 or below reads nothing.
fun testReadLimits(): bool {
    val listener = tcpListen(0)
    val connection = tcpConnectIpv4("127.0.0.1", listener.localPort(), 1000)
    val peer = listener.accept()
    peer.write("waiting bytes")
    val got = connection.read(9223372036854775807)
    val none = connection.read(0)
    val negative = connection.read(-5)
    val closed = connection.close() && peer.close() && listener.close()
    got == "waiting bytes" && none == "" && negative == "" && closed
}

fun main: int {
    val entropy = secureRandomBytes(32)
    if (testTcp() && testUdp() && testStalledWrite() && testReadLimits() && entropy.succeeded &&
        entropy.bytes.size == 32) 42 else 1
}
