import "abla/net"
import "abla/random"

var networkTestPort = 0

fun networkCancelNow(): bool = true

fun networkTcpClient(): int {
    val connection = tcpConnectIpv4("127.0.0.1", networkTestPort, 1000)
    if (connection.descriptor < 0) return 1
    val written = connection.writeNetwork("ping", 1000)
    val response = connection.readWithTimeoutResult(16, 1000)
    val closed = connection.close()
    if (written.succeeded() && written.written == 4 &&
        response.hasData() && response.bytes == "pong" && closed) 0 else 2
}

fun testTcp(): bool {
    val listener = tcpListen(0)
    networkTestPort = listener.localPort()
    val client = thread { networkTcpClient() }
    val connection = listener.accept()
    val request = connection.readWithTimeoutResult(16, 1000)
    val typed = request.networkOutcome()
    val cancelled = connection.readNetwork(
        16, 1000, NetworkCancellation(networkCancelNow), 10
    )
    val cancelledWrite = connection.writeNetwork(
        "unused", 1000, NetworkCancellation(networkCancelNow), 10
    )
    val response = connection.writeNetwork("pong", 1000)
    val clientStatus = await client
    val eof = connection.readWithTimeoutResult(16, 1000)
    val connectionClosed = connection.close()
    val listenerClosed = listener.close()
    request.hasData() && request.bytes == "ping" &&
        typed.hasData() && !typed.error.present() &&
        cancelled.cancelled() && cancelled.error.category == "cancelled" &&
        cancelledWrite.cancelled() &&
        response.succeeded() && response.written == 4 &&
        clientStatus == 0 && eof.reachedEof() &&
        connectionClosed && listenerClosed &&
        connection.descriptor == -1 && listener.descriptor == -1
}

fun testUdp(): bool {
    val socket = udpBindPort(0)
    val socketDescriptor = socket.descriptor
    val port = socket.localPort()
    val poller = socketPoller()
    val watched = poller.watchDescriptor(socket.descriptor)
    val idle = poller.wait(8, 0)
    val before = socket.receiveFromWithTimeout(64, 10)
    val sent = socket.sendTo("hello", ipv4Loopback(port))
    val ready = poller.wait(8, 1000)
    val received = socket.receiveFromWithTimeout(64, 1000)
    val unwatched = poller.unwatchDescriptor(socket.descriptor)
    val pollerClosed = poller.close()
    val closed = socket.close()
    socket.descriptor == -1 && port > 0 && before.timedOut &&
        watched && idle.timedOut && !idle.failed() &&
        sent.succeeded() && sent.written == 5 && received.received &&
        ready.events.size == 1 && ready.events[0].readable &&
        ready.events[0].descriptor == socketDescriptor &&
        !received.timedOut && !received.truncated &&
        received.bytes == "hello" &&
        received.source.address == "127.0.0.1" &&
        received.source.port == port && unwatched && pollerClosed && closed
}

fun main: int {
    val entropy = secureRandomBytes(32)
    if (testTcp() && testUdp() && entropy.succeeded &&
        entropy.bytes.size == 32) 42 else 1
}
