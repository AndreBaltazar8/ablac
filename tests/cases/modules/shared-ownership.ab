var sharedDrops = 0

resource class SharedTicket(val value: int) {
    fun drop(): void {
        sharedDrops = sharedDrops + value
        return
    }
}

class SharedStageCounter(var value: int)

resource class SharedStageTicket(
    val counter: SharedStageCounter,
    val value: int
) {
    fun drop(): void {
        counter.value = counter.value + value
        return
    }
}

fun inspectShared(value: Shared<SharedTicket>): int = value.get().value

fun consumeShared(own value: Shared<SharedTicket>): int = value.get().value

fun sharedRuntimeWork(): int {
    val original = Shared(SharedTicket(20))
    val cloned = original.clone()
    val consumed = original.clone()
    inspectShared(original) + cloned.get().value +
        consumeShared(move(consumed))
}

class SharedTicketBox(val handle: Shared<SharedTicket>)

fun sharedContainerWork(): int {
    val original = Shared(SharedTicket(3))
    val handles = [original.clone(), original.clone()]
    val box = SharedTicketBox(original.clone())
    handles[0].get().value + handles[1].get().value +
        box.handle.get().value
}

fun makeSharedTicket(value: int): Shared<SharedTicket> =
    Shared(SharedTicket(value))

fun sharedReturnedWork(): int {
    val returned = makeSharedTicket(5)
    returned.get().value
}

fun sharedReassignmentWork(): int {
    var current = Shared(SharedTicket(2))
    current = Shared(SharedTicket(4))
    current.get().value
}

fun expiredWeakTicket(): Weak<SharedTicket> {
    val strong = Shared(SharedTicket(7))
    val weak = strong.downgrade()
    weak
}

fun weakRuntimeWork(): int {
    val expired = expiredWeakTicket()
    val cloned = expired.clone()
    val unavailable = expired.upgrade()
    val expiredCorrectly = !expired.isAlive() && unavailable == null

    val strong = Shared(SharedTicket(6))
    val live = strong.downgrade()
    val upgraded = live.upgrade()
    val liveValue = if (upgraded != null) upgraded.get().value else 0
    val liveCorrectly = live.isAlive() && liveValue == 6
    if (expiredCorrectly && liveCorrectly && !cloned.isAlive()) 1 else 0
}

compile fun sharedStagedWork(counter: SharedStageCounter): int {
    val original = Shared(SharedStageTicket(counter, 20))
    val cloned = original.clone()
    original.get().value + cloned.get().value
}

compile fun sharedStagedTrace(): int {
    val counter = SharedStageCounter(0)
    val result = sharedStagedWork(counter)
    if (result == 40 && counter.value == 20) 42 else 0
}

compile fun expiredWeakStage(
    counter: SharedStageCounter
): Weak<SharedStageTicket> {
    val strong = Shared(SharedStageTicket(counter, 7))
    val weak = strong.downgrade()
    weak
}

compile fun weakStagedTrace(): int {
    val counter = SharedStageCounter(0)
    val weak = expiredWeakStage(counter)
    val unavailable = weak.upgrade()
    if (!weak.isAlive() && unavailable == null && counter.value == 7) {
        42
    } else 0
}

compile fun liveWeakStage(): int {
    val strong = Shared(SharedStageTicket(SharedStageCounter(0), 8))
    val weak = strong.downgrade()
    val upgraded = weak.upgrade()
    if (upgraded != null && upgraded.get().value == 8) 42 else 0
}

fun main: int {
    val result = sharedRuntimeWork()
    val containers = sharedContainerWork()
    val returned = sharedReturnedWork()
    val reassigned = sharedReassignmentWork()
    val weak = weakRuntimeWork()
    if (result == 60 && containers == 9 && returned == 5 &&
        reassigned == 4 && weak == 1 && sharedDrops == 47 &&
        #sharedStagedTrace() == 42 && #weakStagedTrace() == 42 &&
        #liveWeakStage() == 42) 42 else 0
}
