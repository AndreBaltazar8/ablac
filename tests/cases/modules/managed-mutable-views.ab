class Counter(var value: int) {
    fun add(delta: int): int {
        this.value = this.value + delta
        this.value
    }

    fun read(): int = this.value
}

class CounterPair(var left: Counter, var right: Counter)

fun increment(var counter: Counter, delta: int): int {
    counter.value = counter.value + delta
    counter.value
}

fun copyValue(var target: Counter, source: Counter): int {
    target.value = source.value
    target.value
}

fun bumpFirst(var values: array<int>, delta: int): int {
    values[0] = values[0] + delta
    values[0]
}

fun exerciseManagedMutableViews(): int {
    val counter = Counter(10)
    increment(counter, 5)
    counter.add(5)
    val values = [8]
    bumpFirst(values, 1)
    val pair = CounterPair(Counter(7), Counter(13))
    copyValue(pair.left, pair.right)
    counter.read() + values[0] + pair.left.read()
}

compile fun stagedManagedMutableViews(): int =
    exerciseManagedMutableViews()

fun main: int {
    if (#stagedManagedMutableViews() == 42 &&
        exerciseManagedMutableViews() == 42) 42 else 0
}
