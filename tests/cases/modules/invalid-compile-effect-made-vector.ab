// A vector's extension is reached once the expression makes a vector: here one reading a
// file, through a function returning `i8x16` (that never returns one), is denied.
import "abla/simd"
import "abla/fs"
fun i8x16.lookup(key: string): int = Path(key).readText().size
class Table(val size: int) {
    fun lookup(key: string): int = size
}
fun vector(): i8x16 = vector()
fun <T> same(value: T): T = value
fun found(): int = if (Table(1).lookup("x") > 0) same(vector()).lookup("x") else 0
val first = #found()
fun main: int = first
