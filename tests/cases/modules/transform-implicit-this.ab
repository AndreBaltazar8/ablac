// A transform's code runs before analysis: a method calling another without
// `this.`, with an argument, and an extension of its class, are still method calls.
import "abla/compiler"
class Counter(val base: int, var seen: int = 0) {
    fun total(): int = step(2) + 1
    fun step(by: int): int {
        seen = seen + by
        doubled() + seen
    }
    fun doubled(): int = base * 2
}
fun Counter.viaExtension(): int = total() + 1
fun doubled(): int = 1000
compile fun generate(): void {
    val counter = Counter(19)
    compiler.generateModule("answer", "fun generatedAnswer(): int = ${counter.viaExtension()}\n")
    return
}
#compiler.transform(generate)
fun main: int = generatedAnswer()
