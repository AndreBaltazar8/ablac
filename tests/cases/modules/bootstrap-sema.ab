#import("../../../bootstrap/compiler/sema.ab")

fun main: int {
    val analyzed = bootstrapAnalyze(
        "val answer = 40 + 2; val correct = answer == 42"
    )
    if (
        analyzed.errors == 0 &&
        analyzed.symbols.size == 2 &&
        analyzed.symbols[0].name == "answer" &&
        analyzed.symbols[0].type == "i64" &&
        analyzed.symbols[1].name == "correct" &&
        analyzed.symbols[1].type == "bool"
    ) 42 else 0
}
