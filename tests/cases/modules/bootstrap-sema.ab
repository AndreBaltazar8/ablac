import "../../../src/sema.ab"

fun nameLookupsAgree(): bool {
    val text = "01234567abcdefghABCDEFGH01234567abcdefgh"
    var size = 0
    while (size <= text.size) {
        val left = text.slice(0, size)
        val right = text.slice(0, size)
        if (!bootstrapNameEquals(left, right) ||
            bootstrapFunctionDeclarationHash(left) !=
            bootstrapFunctionDeclarationHash(right)) return false
        var index = 0
        while (index < size) {
            val changed = "${left.slice(0, index)}!${left.slice(index + 1, size)}"
            if (bootstrapNameEquals(left, changed)) return false
            index = index + 1
        }
        if (bootstrapNameEquals(left, "${right}!")) return false
        size = size + 1
    }
    true
}

fun main: int {
    val analyzed = bootstrapAnalyze(
        "val answer = 40 + 2; val correct = answer == 42"
    )
    val returns = bootstrapAnalyze(
        "fun choose(value: int): int {\nwhen (value) {\n1 -> return 41\nelse -> 42\n}\n}"
    )
    if (
        nameLookupsAgree() &&
        analyzed.errors == 0 &&
        returns.errors == 0 &&
        analyzed.symbols.size == 2 &&
        analyzed.symbols[0].name == "answer" &&
        analyzed.symbols[0].type == "i64" &&
        analyzed.symbols[1].name == "correct" &&
        analyzed.symbols[1].type == "bool"
    ) 42 else 0
}
