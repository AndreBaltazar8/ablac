// Path.copyTreeTo, removeTree, isSymbolicLink and modifiedMilliseconds, run
// in a directory test-fs-tree.sh prepares: source/{a.txt, sub/b.txt,
// link -> ../outside} and outside/c.txt.
import "abla/fs"

fun main: int {
    var ok = Path("source/a.txt").info().modifiedMilliseconds() > 0
    ok = ok && Path("source/link").isSymbolicLink() &&
        !Path("source/sub").isSymbolicLink()
    ok = ok && Path("source").copyTreeTo(Path("copy")) == 3
    ok = ok && Path("copy/sub/b.txt").readText() == "bee\n"
    ok = ok && Path("copy/link/c.txt").readText() == "sea\n"
    ok = ok && Path("source/a.txt").copyTo(Path("single/deep/a.txt"))
    ok = ok && Path("source").removeTree() && !Path("source").exists()
    ok = ok && Path("outside/c.txt").readText() == "sea\n"
    ok = ok && Path("copy").removeTree() && Path("single").removeTree()
    ok = ok && Path("missing").removeTree()
    if (ok) 42 else 1
}
