// Fixed-width integers interpolate as their decimal values; a u64 above
// i64's range is written unsigned.
import "abla/io"

fun main: int {
    val text = "${i8(-5)} ${u8(200)} ${i16(-300)} ${u16(60000)} " +
        "${i32(-70000)} ${u32(4000000000)} ${u64(9000000000)} ${u64(-1)} " +
        "${u64(-10)} ${true}"
    if (text != "-5 200 -300 60000 -70000 4000000000 9000000000 " +
        "18446744073709551615 18446744073709551606 true") {
        println(text)
        return 1
    }
    42
}
