resource class Ticket(val value: int)

fun apply(callback: Fn(int) -> int, value: int): int = callback(value)

fun advance(var callback: FnMut() -> int): int =
    callback() + callback()

fun consumeOnce(own callback: FnOnce() -> int): int = callback()

fun exerciseCallableFamilies(): int {
    val offset = 1
    val reader: Fn(int) -> int = { value: int -> value + offset }

    var counter = 19
    val next: FnMut() -> int = {
        counter = counter + 1
        counter
    }

    val ticket = Ticket(1)
    val once: FnOnce() -> int = move { -> ticket.value + 1 }

    val result = apply(reader, 40) + advance(next) +
        consumeOnce(move(once))
    if (result == 84 && counter == 21) 42 else 0
}

compile fun stagedCallableFamilies(): int = exerciseCallableFamilies()

fun main: int =
    if (exerciseCallableFamilies() == 42 &&
        #stagedCallableFamilies() == 42) 42 else 0
