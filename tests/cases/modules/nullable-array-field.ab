// A class's `array<T>?` field takes what an `array<T>` field takes, null too.
class Body(val parts: array<string>?, val count: int) {
    fun size(): int {
        val held = parts
        if (held == null) return count
        held.size + count
    }
}
class Maker(val words: array<string>) {
    fun none(): Body = Body(null, 1)
    fun given(): Body = Body(words, 2)
    fun pick(some: bool): Body = Body(if (some) words else null, 30)
}
fun main: int {
    val maker = Maker(["x", "y"])
    // 1 + 4 + 32 + 30, less the 25 that makes the case's status.
    maker.none().size() + maker.given().size() + maker.pick(true).size() + maker.pick(false).size() - 25
}
