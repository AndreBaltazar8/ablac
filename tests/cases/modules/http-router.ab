import "abla/http"
import "abla/http/event"

fun customerV1(request: HttpRequest): HttpResponse =
    httpText("v1:${request.parameter("id")}")

fun customerV2(request: HttpRequest): HttpResponse {
    val previous = customerV1(request)
    httpText("${previous.body}:v2")
}

fun health(request: HttpRequest): HttpResponse = httpText("ok")

fun explicitHead(request: HttpRequest): HttpResponse = httpText("head")

fun search(request: HttpRequest): HttpResponse =
    httpText(request.parameter("page"))

fun changed(request: HttpRequest): HttpResponse =
    httpText("${request.method}:${request.parameter("id")}")

fun main: int {
    val router = httpRouter("Stripe-Version")
    router.version("2024-01-01").get("/customers/:id", customerV1)
    router.version("2025-01-01").get("/customers/:id", customerV2)
    router.get("/health", health)
    router.get("/explicit", health)
    router.head("/explicit", explicitHead)
    router.get("/search", search)
    router.put("/resources/:id", changed)
    router.patch("/resources/:id", changed)
    router.delete("/resources/:id", changed)
    router.options("/resources/:id", changed)

    val old = router.dispatch(httpParseRequest(
        "GET /customers/42 HTTP/1.1\r\nStripe-Version: 2024-06-01\r\n\r\n"
    ))
    val current = router.dispatch(httpParseRequest(
        "GET /customers/42 HTTP/1.1\r\nStripe-Version: 2026-01-01\r\n\r\n"
    ))
    val latest = router.dispatch(httpParseRequest(
        "GET /customers/42 HTTP/1.1\r\n\r\n"
    ))
    val health = router.dispatch(httpParseRequest(
        "GET /health HTTP/1.1\r\n\r\n"
    ))
    val head = router.dispatch(httpParseRequest(
        "HEAD /health HTTP/1.1\r\n\r\n"
    ))
    val explicitHead = router.dispatch(httpParseRequest(
        "HEAD /explicit HTTP/1.1\r\n\r\n"
    ))
    val query = router.dispatch(httpParseRequest(
        "GET /search?page=42&order=asc HTTP/1.1\r\n\r\n"
    ))
    val put = router.dispatch(httpParseRequest(
        "PUT /resources/7 HTTP/1.1\r\n\r\n"
    ))
    val patch = router.dispatch(httpParseRequest(
        "PATCH /resources/8 HTTP/1.1\r\n\r\n"
    ))
    val deleted = router.dispatch(httpParseRequest(
        "DELETE /resources/9 HTTP/1.1\r\n\r\n"
    ))
    val options = router.dispatch(httpParseRequest(
        "OPTIONS /resources/10 HTTP/1.1\r\n\r\n"
    ))
    val framed = httpParseRequest(
        "POST /login HTTP/1.1\r\ncontent-length: 3\r\n\r\na=1"
    )
    val completeBody =
        "POST /body HTTP/1.1\r\nHost: local\r\nContent-Length: 5\r\n\r\nabcde"
    val eventFrame = httpEventFrame(completeBody, 4096, 4096)
    val eventRequest = eventFrame.request
    if (
        old.body == "v1:42" && current.body == "v1:42:v2" &&
        latest.body == current.body && health.body == "ok" &&
        head.body == "ok" &&
        explicitHead.body == "head" &&
        head.renderHead() ==
            "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: close\r\n\r\n" &&
        query.body == "42" &&
        put.body == "PUT:7" && patch.body == "PATCH:8" &&
        deleted.body == "DELETE:9" && options.body == "OPTIONS:10" &&
        framed.header("Content-Length") == "3" && framed.body == "a=1" &&
        eventFrame.length == completeBody.size && eventRequest != null &&
        eventRequest.body == "abcde" &&
        httpHeaderEnd("GET / HTTP/1.1\r\n\r\n") == 18 &&
        httpDecimalLength("29", 100) == 29 &&
        httpDecimalLength("101", 100) == -1
    ) 42 else 0
}
