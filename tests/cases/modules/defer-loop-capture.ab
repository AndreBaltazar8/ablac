class DeferLoopCounter(val value: Cell<int>)

fun deferLoopRecord(counter: DeferLoopCounter, digit: int): void {
    val changed = counter.value.set(counter.value.get() * 10 + digit)
}

// mode 0 continues; mode 1 breaks on the third turn; mode 2 falls through.
// The captured local belongs to the function, not to any loop iteration.
fun deferLoopOne(mode: int): int {
    val counter = DeferLoopCounter(Cell(0))
    var round = 0
    while (round < 3) {
        defer { deferLoopRecord(counter, 1) }
        round += 1
        if (mode == 0) continue
        if (mode == 1 && round == 3) break
    }
    counter.value.get()
}

fun deferLoopTwo(mode: int): int {
    val counter = DeferLoopCounter(Cell(0))
    var round = 0
    while (round < 3) {
        defer { deferLoopRecord(counter, 2) }
        defer { deferLoopRecord(counter, 1) }
        round += 1
        if (mode == 0) continue
        if (mode == 1 && round == 3) break
    }
    counter.value.get()
}

fun deferLoopBranch(run: bool): int {
    val counter = DeferLoopCounter(Cell(0))
    if (run) { defer { deferLoopRecord(counter, 7) } }
    counter.value.get()
}

fun deferLoopIterator(): int {
    val counter = DeferLoopCounter(Cell(0))
    for (digit in [1, 2, 3]) {
        defer { deferLoopRecord(counter, digit) }
    }
    counter.value.get()
}

fun deferLoopCaptureChecks(): bool {
    for (mode in [0, 1, 2]) {
        if (deferLoopOne(mode) != 111 || deferLoopTwo(mode) != 121212) return false
    }
    deferLoopBranch(false) == 0 && deferLoopBranch(true) == 7 &&
        deferLoopIterator() == 123
}

fun main: int = if (deferLoopCaptureChecks()) 42 else 1
