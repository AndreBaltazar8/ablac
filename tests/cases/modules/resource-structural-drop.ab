var structuralDrops = 0

resource class Token(val amount: int) {
    fun drop(): void {
        structuralDrops = structuralDrops + amount
        return
    }
}

class Bundle(val first: Token, val second: Token)
class Nested(val bundle: Bundle)
class MutableBox(var token: Token)

class StageCounter(var value: int)

resource class StageToken(val counter: StageCounter, val amount: int) {
    fun drop(): void {
        counter.value = counter.value + amount
        return
    }
}

class StageBundle(val first: StageToken, val second: StageToken)

compile fun stagedStructuralLocals(counter: StageCounter): void {
    val bundle = StageBundle(StageToken(counter, 1), StageToken(counter, 2))
    val array = [StageToken(counter, 3), StageToken(counter, 4)]
    val nullable: StageToken? = StageToken(counter, 5)
    return
}

compile fun stagedFieldRemainder(counter: StageCounter): void {
    var bundle = StageBundle(StageToken(counter, 6), StageToken(counter, 7))
    val extracted = move(bundle.first)
    return
}

compile fun stagedIndexRemainder(counter: StageCounter): void {
    var values = [StageToken(counter, 8), StageToken(counter, 9)]
    val extracted = move(values[0])
    return
}

compile fun stagedStructuralTrace(): int {
    val counter = StageCounter(0)
    stagedStructuralLocals(counter)
    stagedFieldRemainder(counter)
    stagedIndexRemainder(counter)
    counter.value
}

fun normalStructuralExit() {
    val nested = Nested(Bundle(Token(1), Token(2)))
}

fun arrayAndNullableExit() {
    val values = [Token(4), Token(5)]
    val nullable: Token? = Token(6)
}

fun structuralReassignment() {
    var bundle = Bundle(Token(1), Token(2))
    bundle = Bundle(Token(3), Token(4))
}

fun fieldReplacement() {
    val box = MutableBox(Token(5))
    box.token = Token(6)
}

fun indexReplacement() {
    val values = [Token(7)]
    values[0] = Token(8)
}

fun fieldRemainder() {
    var bundle = Bundle(Token(9), Token(10))
    val extracted = move(bundle.first)
}

fun indexRemainder() {
    var values = [Token(11), Token(12)]
    val extracted = move(values[0])
}

fun main: int {
    normalStructuralExit()
    arrayAndNullableExit()
    structuralReassignment()
    fieldReplacement()
    indexReplacement()
    fieldRemainder()
    indexRemainder()
    if (structuralDrops == 96 && #stagedStructuralTrace() == 45) 42 else 1
}
