// Named arguments on methods and extension functions, at run time and under
// `#`: an omitted parameter's default reads the receiver's fields (never a
// caller's variable of the same name), the receiver is evaluated once, first,
// and arguments are evaluated once, in source order.
class Box(val size: int) {
    fun scaled(by: int = 2, plus: int = 0): int = size * by + plus
    fun padded(left: int = size, right: int = left + 1): int = left + size + right
    fun grown(by: int = this.size): Box = Box(size + by)
}

class Trace(var text: string)

fun Box.framed(border: int = this.size / 2, label: string = "box"): string =
    "$label:${this.size + border * 2}"

fun traced(var trace: Trace, label: string, value: int): int {
    trace.text = "${trace.text}$label"
    value
}

fun tracedBox(var trace: Trace, size: int): Box {
    trace.text = "${trace.text}r"
    Box(size)
}

fun report(): string {
    val size = 1000
    val box = Box(3)
    val trace = Trace("")
    val ordered = tracedBox(trace, 4).scaled(
        plus = traced(trace, "p", 1), by = traced(trace, "b", 3)
    )
    "${box.scaled(plus = 1)} ${box.scaled(by = 3)} ${box.padded(right = 0)} " +
        "${box.padded()} ${box.grown().size} ${box.framed(label = "f")} " +
        "${Box(5).framed()} $ordered ${trace.text} $size"
}

val STAGED = #report()

fun main: int {
    val runtime = report()
    if (STAGED != runtime) 1
    else if (runtime != "7 9 6 10 6 f:5 box:9 13 rpb 1000") 2
    else 42
}
