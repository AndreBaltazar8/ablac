// abla/date's UTC calendar and abla/process/time's wall clock.
import "abla/io"
import "abla/date"
import "abla/process/time"

compile fun stagedDate(): string = httpDate(utcMilliseconds(2026, 10, 6))

val STAGED = #stagedDate()

fun check(failures: int, ok: bool, label: string): int {
    if (!ok) println("FAIL $label")
    if (ok) failures else failures + 1
}

fun parsed(value: int?, expected: int): bool =
    if (value == null) false else value == expected

fun main: int {
    var failures = 0
    val epoch = utcDate(0)
    failures = check(failures, epoch.iso8601() == "1970-01-01T00:00:00.000Z" &&
        epoch.weekday == 4 && epoch.dayOfYear() == 1, "epoch")
    failures = check(failures,
        utcIso8601(-1) == "1969-12-31T23:59:59.999Z", "before epoch")
    val leap = utcDate(utcMilliseconds(2000, 2, 29, 13, 5, 9, 7))
    failures = check(failures, leap.year == 2000 && leap.month == 2 &&
        leap.day == 29 && leap.hour == 13 && leap.minute == 5 &&
        leap.second == 9 && leap.millisecond == 7 && leap.weekday == 2 &&
        leap.dayOfYear() == 60, "leap day")
    failures = check(failures, httpDate(784111777000) ==
        "Sun, 06 Nov 1994 08:49:37 GMT", "http date")
    failures = check(failures, utcDate(253402300799999).iso8601() ==
        "9999-12-31T23:59:59.999Z", "year 9999")
    failures = check(failures,
        parsed(httpDateParse("Sun, 06 Nov 1994 08:49:37 GMT"), 784111777000),
        "parse http date")
    failures = check(failures,
        httpDateParse("Mon, 06 Nov 1994 08:49:37 GMT") == null,
        "parse http date weekday")
    failures = check(failures,
        httpDateParse("Sun, 06 Nov 1994 08:49:37 UTC") == null,
        "parse http date zone")
    failures = check(failures,
        parsed(utcIso8601Parse("2026-10-06T08:30:05.250Z"),
            utcMilliseconds(2026, 10, 6, 8, 30, 5, 250)), "parse iso")
    failures = check(failures, parsed(utcIso8601Parse("2026-10-06"),
        utcMilliseconds(2026, 10, 6)), "parse iso date")
    failures = check(failures, parsed(utcIso8601Parse("2026-10-06T08:30:05Z"),
        utcMilliseconds(2026, 10, 6, 8, 30, 5)), "parse iso seconds")
    failures = check(failures, utcIso8601Parse("2026-02-30") == null,
        "parse iso invalid day")
    failures = check(failures, utcIso8601Parse("2026-10-06T24:00:00Z") == null,
        "parse iso invalid hour")
    failures = check(failures, utcIso8601Parse("2026-10-06 08:30:05Z") == null,
        "parse iso separator")
    var day = -800000
    var roundTrips = true
    while (day < 2900000) {
        val time = day * 86400000 + 45296789
        if (utcDate(time).milliseconds() != time) roundTrips = false
        day = day + 997
    }
    failures = check(failures, roundTrips, "round trips")
    failures = check(failures, STAGED == "Tue, 06 Oct 2026 00:00:00 GMT",
        "compile time")
    val now = utcNow()
    failures = check(failures, realtimeMilliseconds() >
        utcMilliseconds(2026, 1, 1) && now.year >= 2026, "realtime")
    if (failures == 0) 42 else failures
}
