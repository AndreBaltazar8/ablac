// A map built at compile time becomes a map in the program.
compile fun stagedCodes(): Map<string, int> {
    val codes: Map<string, int> = Map()
    var index = 0
    while (index < 300) {
        codes.set("code$index", index * 2)
        index = index + 1
    }
    codes.remove("code7")
    codes.set("code0", -1)
    codes
}

val CODES: Map<string, int> = #stagedCodes()

fun main: int {
    val keys = CODES.keys()
    val ok = CODES.size == 299 && CODES.get("code0") == -1 &&
        CODES.get("code299") == 598 && CODES.get("code7") == null &&
        keys[0] == "code0" && keys[7] == "code8"
    if (ok) 42 else 1
}
