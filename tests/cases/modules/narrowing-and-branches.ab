// A local read from a managed field (an array, a class with `var` fields)
// is a borrow: it compares with null, narrows, and iterates like what it
// borrows. An `if` whose branch leaves narrows the rest of the block. `[]`
// takes the other branch's array type.
class Grid(val names: array<string>, var x: int)
class Node(var grid: Grid?)
class Sizes(val size: array<int>? = null)
class Item(val v: int)
class Bag(val items: array<int>)

fun gridNames(node: Node): int {
    val grid = node.grid
    var total = 0
    if (grid != null) total = grid.names.size
    total
}

fun firstSize(sizes: Sizes): int {
    val size = sizes.size
    if (size != null) size[0] else 1
}

fun find(flag: bool): Item? = if (flag) Item(7) else null

fun early(flag: bool): int {
    val item = find(flag)
    if (item == null) return 0
    item.v
}

fun elseLeaves(flag: bool): int {
    val item = find(flag)
    if (item != null) { 1 } else { return 5 }
    item.v
}

fun skipNulls(values: array<int?>): int {
    var total = 0
    for (value in values) {
        if (value == null) continue
        total += value
    }
    total
}

fun sumAlias(bag: Bag): int {
    var total = 0
    val items = bag.items
    for (n in items) total += n
    total
}

fun make(): array<Item> = [Item(1), Item(2)]
fun count(items: array<Item>): int = items.size
fun pick(ok: bool): array<Item> {
    val out = make()
    if (ok) out else []
}

fun main: int {
    val mixed: array<int?> = []
    mixed.append(1)
    mixed.append(null)
    mixed.append(2)
    if (gridNames(Node(Grid(["a", "b"], 0))) == 2 &&
        gridNames(Node(null)) == 0 &&
        firstSize(Sizes([7])) == 7 && firstSize(Sizes()) == 1 &&
        early(true) == 7 && early(false) == 0 &&
        elseLeaves(true) == 7 && elseLeaves(false) == 5 &&
        skipNulls(mixed) == 3 && sumAlias(Bag([4, 5])) == 9 &&
        count(if (true) make() else []) == 2 &&
        pick(true).size == 2 && pick(false).size == 0) 42 else 1
}
