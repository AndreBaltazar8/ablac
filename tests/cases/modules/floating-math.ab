import "abla/float"
import "abla/math"

// f64 values selected by `if` chains must stay f64 (their join temporaries were
// once zero-initialized as integers, so the arithmetic below ran on bit patterns).
fun chained(id: int): f64 {
    val hi = if (id == 0) 1.0 else if (id == 1) 2.0 else 4.0
    val lo = if (id == 0) 10.0 else if (id == 1) 20.0 else 40.0
    hi + lo
}

fun near(value: f64, expected: f64): bool = fabs(value - expected) < 0.000000001

fun main: int {
    if (chained(1) != 22.0 || chained(2) != 44.0) return 1
    if (sqrt(2.25) != 1.5 || floor(-1.5) != -2.0 || ceil(1.25) != 2.0 ||
        trunc(-1.75) != -1.0 || fabs(-3.0) != 3.0 ||
        roundEven(2.5) != 2.0 || roundEven(3.5) != 4.0) return 2
    if (f64ToInt(-2.9) != -2 || f64ToInt(0.0 / 0.0) != 0 ||
        f64ToInt(1.0e300) != 9223372036854775807) return 3
    if (f32ToF64(f64ToF32(1.25)) != 1.25 || f32ToF64(f64ToF32(0.1)) == 0.1) return 4
    if (!near(sin(mathHalfPi), 1.0) || !near(cos(mathPi), -1.0) ||
        !near(sin(1000.0), 0.8268795405320025) ||
        !near(cos(-3.0), -0.9899924966004454)) return 5
    if (!near(atan(1.0), mathQuarterPi) || !near(atan(10.0), 1.4711276743037347) ||
        !near(atan2(1.0, -1.0), 3.0 * mathQuarterPi) ||
        !near(atan2(-2.0, -3.0), -2.5535900500422257) ||
        atan2(0.0, -1.0) != mathPi || atan2(-1.0, 0.0) != -mathHalfPi) return 6
    if (!isNaN(sin(1.0 / 0.0)) || !isFinite(1.0) || isFinite(1.0 / 0.0)) return 7
    42
}
