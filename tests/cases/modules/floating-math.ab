import "abla/float"
import "abla/math"

// f64 values selected by `if` chains must stay f64 (their join temporaries were
// once zero-initialized as integers, so the arithmetic below ran on bit patterns).
fun chained(id: int): f64 {
    val hi = if (id == 0) 1.0 else if (id == 1) 2.0 else 4.0
    val lo = if (id == 0) 10.0 else if (id == 1) 20.0 else 40.0
    hi + lo
}

// tan as msun's k_tan.c: the nearest double for each of these (sin / cos was
// off by one ulp for every one). Bit patterns: [x, result].
val TAN_CASES: array<int> = [-4626844272002145756, -4626740165234942507, -4618308886563422717, -4616554732035401289, -4622182793157235589, -4621713692195800880, -4605742349803876802, 4609757154322443629, -4602750111925555382, 4622981417264290239, -4611508497456290684, 4610767373244163358, 4690698679489371628, -4644870726909664676, 4699010431209526818, -4617278890323535719, -4535968034567634012, -4468771035187176557, -4532598686675781044, -4469798666346472681, -4540350142883512992, -4464681847381749605, 4488458938183720146, 4488458938183720146]

// hypot: the nearest double, also where sqrt(x * x + y * y) rounds twice,
// overflows or underflows (CORE-MATH's worst cases). Bit patterns: [x, y, result].
val HYPOT_CASES: array<int> = [4072170629410111, 1923495767767979, 4503599627370496, 4406209285428609024, 4288204184296380071, 4406209285428609025, 4546522236078591796, 4607182418847470541, 4607182418867126271, 1693132709104637, -9220449341496736965, 3377698406687875, 455106213732346, 2582233789729206, 2622032229130117, -9218868437227405313, 1, 4503599627370495, 36028886486730425, -9187343169578483904, 37894362006831101, 87433869352022443, -9220516949172464737, 87433869352031755]

// exp and log correctly rounded (the nearest double, from MPFR); pow as
// fdlibm's e_pow (V8's own pow differs in the last bit for the final two
// cases). Bit patterns: [x, result] and [x, y, result].
val EXP_CASES: array<int> = [-4580932518542311424, 3086055539475501107, -8330955619822411776, 4607182418800017408, -4574726925091602432, 593079873160603864, 4649208797909221376, 9037013355505515856, -4576577480638332928, 1620176218059886451, -4582769842322407424, 3425299077073453043, -4574786352612114432, 636891625213231974, -4619675727044804608, 4603054803794851740, 4646041984832634880, 7315601131324755936, 4595466675729465344, 4608042764653759281]
val LOG_CASES: array<int> = [4607182419157686178, 4500593114088216830, 4607262824882765824, 4580757812688012778, 3093732212264995, -4573926397319442265, 4607182440353838337, 4527264217192947972, 4610872283186069504, 4603565665945913337, 8364422558250159616, 4648298239345912163, 4240503907459100, -4573929170761969585, 4607182402201321724, -4702062705248164694, 4610868991093637120, 4603562046171521218, 5016086398139807744, 4634058804766665105]
// exp and log on CORE-MATH's hard-to-round arguments, where fdlibm's results
// were one ulp off: [x, result].
val EXP_HARD: array<int> = [4368491638549381120, 4607182418800017409, 4625197047489145475, 4711036207751325389, 4616190243587021541, 4632885094113201331, 4634205198371736504, 5022776862993136337, 4647717572557819971, 7935706333728001181, 4620696330870361543, 4658809962539552303, -4580156224356076121, 2941865107882122979, 4643215993578403879, 6271934301061522967]
val LOG_HARD: array<int> = [4610489747970184643, 4603135005772919079, 4610542438107398662, 4603195561568256613, 4610892677211740038, 4603588057552152953, 4612282036250082575, 4605538025894525259, 4611034949707244855, 4603742735776849455, 4611208196801675315, 4603927571891343017, 4610260546293366413, 4602866745664606645, 4610355327108317946, 4602978648602708183]
// atan on CORE-MATH's hard-to-round arguments, where fdlibm's results were
// one ulp off: [x, result].
val ATAN_HARD: array<int> = [4638708252418983909, 4609717878237909177, 4589168749033815441, 4589157771392324894, 4593672632641693756, 4593627136656748152, 4674737572513462061, 4609752919521091935, 4517111708650976914, 4517111708650975547, 4652220365054302884, 4609748660783014283, 4508106157122068165, 4508106157122068079, 4638710620738799518, 4609717896724332983]
val POW_CASES: array<int> = [4621128311693639680, 4614502578523209728, 4652834350562942348, -4602858301024108544, -4594516044848037888, -5004432940555512509, 345183429597476080, -8056364960624315392, 4607182418800017408, -4605386791220936704, 4623507967449235456, -4471059323293669576, -4609397368868044800, -4598175219545276416, 4492020966871723252, 4607534972264251392, 4649485084892594176, 4956077863838593900, 3119487552323959, 4604885560484429824, 1176173682162803634, -4607943066098073600, -4602115869219225600, -4692272613340254973, 4607174472036777984, -5234935386130764288, 4607182418800017408, 3487379825873137, -4617028800977305600, 8782399202549479444, 2705336397198325, -4617240206783807488, 8675558722806834294, 4618441417868443648, 4623507967449235456, 4758145172020133888, 4616559195695611904, 4614325808406724608, 4637044796955065473, 4619143117814104064, 4618707624236417024, 4683775286913298164, 853556060625401, 4607375310344683520, 53, 4762412914779145, 4607352440449138688, 11591, -4602307467844517888, 4626885667169763328, 4915358322844005756, 4621688461999472640, 4623924671618744320, 4810437597313493973]

fun exactly(value: f64, bits: int): bool = f64ToBits(value) == bits

fun exponentials(): int {
    var i = 0
    while (i < EXP_CASES.size) {
        if (!exactly(exp(f64FromBits(EXP_CASES[i])), EXP_CASES[i + 1])) return 10
        if (!exactly(log(f64FromBits(LOG_CASES[i])), LOG_CASES[i + 1])) return 11
        i += 2
    }
    i = 0
    while (i < EXP_HARD.size) {
        if (!exactly(exp(f64FromBits(EXP_HARD[i])), EXP_HARD[i + 1])) return 20
        if (!exactly(log(f64FromBits(LOG_HARD[i])), LOG_HARD[i + 1])) return 21
        if (!exactly(atan(f64FromBits(ATAN_HARD[i])), ATAN_HARD[i + 1])) return 22
        i += 2
    }
    i = 0
    while (i < POW_CASES.size) {
        if (!exactly(pow(f64FromBits(POW_CASES[i]), f64FromBits(POW_CASES[i + 1])),
            POW_CASES[i + 2])) return 12
        i += 3
    }
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    if (exp(1.0) != mathE || exp(0.0) != 1.0 || exp(-inf) != 0.0 ||
        exp(inf) != inf || exp(710.0) != inf || exp(-746.0) != 0.0 ||
        !isNaN(exp(nan))) return 13
    if (log(1.0) != 0.0 || log(mathE) != 1.0 || log(0.0) != -inf ||
        !isNaN(log(-1.0)) || log(inf) != inf || log(5e-324) != -744.4400719213812) return 14
    if (pow(2.0, 10.0) != 1024.0 || pow(-2.0, 3.0) != -8.0 || pow(3.0, 40.0) != 12157665459056928801.0 ||
        pow(0.0, -1.0) != inf || pow(-0.0, -3.0) != -inf || pow(1.0, nan) != 1.0 ||
        pow(nan, 0.0) != 1.0 || pow(-1.0, inf) != 1.0 || !isNaN(pow(-8.0, 1.0 / 3.0)) ||
        pow(2.0, 1100.0) != inf || pow(2.0, -1100.0) != 0.0 || pow(2.0, -1074.0) != 5e-324 ||
        pow(4.0, 0.5) != 2.0 || pow(-inf, 3.0) != -inf || pow(0.5, inf) != 0.0) return 15
    0
}

fun tangents(): int {
    var i = 0
    while (i < TAN_CASES.size) {
        if (!exactly(tan(f64FromBits(TAN_CASES[i])), TAN_CASES[i + 1])) return 16
        i += 2
    }
    val inf = 1.0 / 0.0
    if (!exactly(tan(-0.0), f64ToBits(-0.0)) || tan(0.0) != 0.0 ||
        !isNaN(tan(inf)) || !isNaN(tan(-inf)) || !isNaN(tan(0.0 / 0.0)) ||
        tan(mathQuarterPi) != 0.9999999999999999 ||
        tan(mathHalfPi) != 16331239353195370.0 ||
        tan(-mathHalfPi) != -16331239353195370.0 || tan(5e-324) != 5e-324) return 17
    0
}

fun hypotenuses(): int {
    var i = 0
    while (i < HYPOT_CASES.size) {
        if (!exactly(hypot(f64FromBits(HYPOT_CASES[i]), f64FromBits(HYPOT_CASES[i + 1])),
            HYPOT_CASES[i + 2])) return 18
        i += 3
    }
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    if (hypot(3.0, -4.0) != 5.0 || hypot(1e300, 1e300) != 1.4142135623730952e300 ||
        hypot(1e-300, 1e-300) != 1.414213562373095e-300 || hypot(5e-324, 5e-324) != 5e-324 ||
        hypot(1e-310, 3e-310) != 3.1622776601684e-310 ||
        hypot(1.7976931348623157e308, 1.7976931348623157e308) != inf ||
        !exactly(hypot(-0.0, -0.0), 0) || hypot(-inf, nan) != inf || hypot(nan, inf) != inf ||
        !isNaN(hypot(nan, 1.0)) || hypot(-2.0, 0.0) != 2.0) return 19
    0
}

fun near(value: f64, expected: f64): bool = fabs(value - expected) < 0.000000001

fun main: int {
    if (chained(1) != 22.0 || chained(2) != 44.0) return 1
    if (sqrt(2.25) != 1.5 || floor(-1.5) != -2.0 || ceil(1.25) != 2.0 ||
        trunc(-1.75) != -1.0 || fabs(-3.0) != 3.0 ||
        roundEven(2.5) != 2.0 || roundEven(3.5) != 4.0) return 2
    if (f64ToInt(-2.9) != -2 || f64ToInt(0.0 / 0.0) != 0 ||
        f64ToInt(1.0e300) != 9223372036854775807) return 3
    if (f32ToF64(f64ToF32(1.25)) != 1.25 || f32ToF64(f64ToF32(0.1)) == 0.1) return 4
    if (!near(sin(mathHalfPi), 1.0) || !near(cos(mathPi), -1.0) ||
        !near(sin(1000.0), 0.8268795405320025) ||
        !near(cos(-3.0), -0.9899924966004454)) return 5
    if (!near(atan(1.0), mathQuarterPi) || !near(atan(10.0), 1.4711276743037347) ||
        !near(atan2(1.0, -1.0), 3.0 * mathQuarterPi) ||
        !near(atan2(-2.0, -3.0), -2.5535900500422257) ||
        atan2(0.0, -1.0) != mathPi || atan2(-1.0, 0.0) != -mathHalfPi) return 6
    if (!isNaN(sin(1.0 / 0.0)) || !isFinite(1.0) || isFinite(1.0 / 0.0)) return 7
    if (atan(1.0) != mathQuarterPi || atan(-1.0 / 0.0) != -mathHalfPi ||
        !exactly(atan(-0.0), f64ToBits(-0.0)) || atan(1e-300) != 1e-300 ||
        atan(1e300) != mathHalfPi || !isNaN(atan(0.0 / 0.0))) return 9
    // IEEE 754-2019 minimum and maximum: NaN wins, -0.0 is below 0.0.
    val nan = 0.0 / 0.0
    if (!isNaN(fmin(nan, 1.0)) || !isNaN(fmin(1.0, nan)) || !isNaN(fmax(nan, 1.0)) ||
        !isNaN(fmax(1.0, nan)) || fmin(1.0, 2.0) != 1.0 || fmin(2.0, -3.0) != -3.0 ||
        fmax(1.0, 2.0) != 2.0 || fmax(2.0, -3.0) != 2.0 ||
        !exactly(fmin(0.0, -0.0), f64ToBits(-0.0)) || !exactly(fmin(-0.0, 0.0), f64ToBits(-0.0)) ||
        !exactly(fmax(0.0, -0.0), 0) || !exactly(fmax(-0.0, 0.0), 0)) return 8
    val exponential = exponentials()
    if (exponential != 0) return exponential
    val tangent = tangents()
    if (tangent != 0) return tangent
    val hypotenuse = hypotenuses()
    if (hypotenuse != 0) return hypotenuse
    42
}
