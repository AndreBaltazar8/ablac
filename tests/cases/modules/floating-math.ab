fun exactly(value: f64, bits: int): bool = f64ToBits(value) == bits

fun exponentials(): int {
    var i = 0
    while (i < EXP_CASES.size) {
        if (!exactly(exp(f64FromBits(EXP_CASES[i])), EXP_CASES[i + 1])) return 10
        if (!exactly(log(f64FromBits(LOG_CASES[i])), LOG_CASES[i + 1])) return 11
        i += 2
    }
    i = 0
    while (i < EXP_HARD.size) {
        if (!exactly(exp(f64FromBits(EXP_HARD[i])), EXP_HARD[i + 1])) return 20
        if (!exactly(log(f64FromBits(LOG_HARD[i])), LOG_HARD[i + 1])) return 21
        if (!exactly(atan(f64FromBits(ATAN_HARD[i])), ATAN_HARD[i + 1])) return 22
        i += 2
    }
    i = 0
    while (i < SIN_HARD.size) {
        if (!exactly(sin(f64FromBits(SIN_HARD[i])), SIN_HARD[i + 1])) return 23
        i += 2
    }
    i = 0
    while (i < COS_HARD.size) {
        if (!exactly(cos(f64FromBits(COS_HARD[i])), COS_HARD[i + 1])) return 24
        if (!exactly(tan(f64FromBits(TAN_HARD[i])), TAN_HARD[i + 1])) return 25
        i += 2
    }
    i = 0
    while (i < POW_CASES.size) {
        if (!exactly(pow(f64FromBits(POW_CASES[i]), f64FromBits(POW_CASES[i + 1])),
            POW_CASES[i + 2])) return 12
        i += 3
    }
    i = 0
    while (i < POW_HARD.size) {
        if (!exactly(pow(f64FromBits(POW_HARD[i]), f64FromBits(POW_HARD[i + 1])),
            POW_HARD[i + 2])) return 27
        i += 3
    }
    i = 0
    while (i < ATAN2_CASES.size) {
        if (!exactly(atan2(f64FromBits(ATAN2_CASES[i]), f64FromBits(ATAN2_CASES[i + 1])),
            ATAN2_CASES[i + 2])) return 28
        i += 3
    }
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    if (exp(1.0) != mathE || exp(0.0) != 1.0 || exp(-inf) != 0.0 ||
        exp(inf) != inf || exp(710.0) != inf || exp(-746.0) != 0.0 ||
        !isNaN(exp(nan))) return 13
    if (log(1.0) != 0.0 || log(mathE) != 1.0 || log(0.0) != -inf ||
        !isNaN(log(-1.0)) || log(inf) != inf || log(5e-324) != -744.4400719213812) return 14
    if (pow(2.0, 10.0) != 1024.0 || pow(-2.0, 3.0) != -8.0 || pow(3.0, 40.0) != 12157665459056928801.0 ||
        pow(0.0, -1.0) != inf || pow(-0.0, -3.0) != -inf || pow(1.0, nan) != 1.0 ||
        pow(nan, 0.0) != 1.0 || pow(-1.0, inf) != 1.0 || !isNaN(pow(-8.0, 1.0 / 3.0)) ||
        pow(2.0, 1100.0) != inf || pow(2.0, -1100.0) != 0.0 || pow(2.0, -1074.0) != 5e-324 ||
        pow(4.0, 0.5) != 2.0 || pow(-inf, 3.0) != -inf || pow(0.5, inf) != 0.0) return 15
    0
}

fun tangents(): int {
    var i = 0
    while (i < TAN_CASES.size) {
        if (!exactly(tan(f64FromBits(TAN_CASES[i])), TAN_CASES[i + 1])) return 16
        i += 2
    }
    val inf = 1.0 / 0.0
    if (!exactly(tan(-0.0), f64ToBits(-0.0)) || tan(0.0) != 0.0 ||
        !isNaN(tan(inf)) || !isNaN(tan(-inf)) || !isNaN(tan(0.0 / 0.0)) ||
        tan(mathQuarterPi) != 0.9999999999999999 ||
        tan(mathHalfPi) != 16331239353195370.0 ||
        tan(-mathHalfPi) != -16331239353195370.0 || tan(5e-324) != 5e-324) return 17
    0
}

fun hypotenuses(): int {
    var i = 0
    while (i < HYPOT_CASES.size) {
        if (!exactly(hypot(f64FromBits(HYPOT_CASES[i]), f64FromBits(HYPOT_CASES[i + 1])),
            HYPOT_CASES[i + 2])) return 18
        i += 3
    }
    val inf = 1.0 / 0.0
    val nan = 0.0 / 0.0
    if (hypot(3.0, -4.0) != 5.0 || hypot(1e300, 1e300) != 1.4142135623730952e300 ||
        hypot(1e-300, 1e-300) != 1.414213562373095e-300 || hypot(5e-324, 5e-324) != 5e-324 ||
        hypot(1e-310, 3e-310) != 3.1622776601684e-310 ||
        hypot(1.7976931348623157e308, 1.7976931348623157e308) != inf ||
        !exactly(hypot(-0.0, -0.0), 0) || hypot(-inf, nan) != inf || hypot(nan, inf) != inf ||
        !isNaN(hypot(nan, 1.0)) || hypot(-2.0, 0.0) != 2.0) return 19
    0
}

fun near(value: f64, expected: f64): bool = fabs(value - expected) < 0.000000001

fun main: int {
    if (chained(1) != 22.0 || chained(2) != 44.0) return 1
    if (sqrt(2.25) != 1.5 || floor(-1.5) != -2.0 || ceil(1.25) != 2.0 ||
        trunc(-1.75) != -1.0 || fabs(-3.0) != 3.0 ||
        roundEven(2.5) != 2.0 || roundEven(3.5) != 4.0) return 2
    if (f64ToInt(-2.9) != -2 || f64ToInt(0.0 / 0.0) != 0 ||
        f64ToInt(1.0e300) != 9223372036854775807) return 3
    if (f32ToF64(f64ToF32(1.25)) != 1.25 || f32ToF64(f64ToF32(0.1)) == 0.1) return 4
    if (!near(sin(mathHalfPi), 1.0) || !near(cos(mathPi), -1.0) ||
        !near(sin(1000.0), 0.8268795405320025) ||
        !near(cos(-3.0), -0.9899924966004454)) return 5
    if (!near(atan(1.0), mathQuarterPi) || !near(atan(10.0), 1.4711276743037347) ||
        !near(atan2(1.0, -1.0), 3.0 * mathQuarterPi) ||
        !near(atan2(-2.0, -3.0), -2.5535900500422257) ||
        atan2(0.0, -1.0) != mathPi || atan2(-1.0, 0.0) != -mathHalfPi) return 6
    if (!isNaN(sin(1.0 / 0.0)) || !isFinite(1.0) || isFinite(1.0 / 0.0)) return 7
    // every finite argument reduces exactly, however large
    if (sin(1e300) != -0.8178819121159085 || cos(1e300) != -0.5753861119575491 ||
        tan(1e300) != 1.4214488238747245 || sin(1.7976931348623157e308) != 0.004961954789184062 ||
        !exactly(sin(-0.0), f64ToBits(-0.0)) || cos(-0.0) != 1.0 || cos(1e-10) != 1.0 ||
        !isNaN(cos(1.0 / 0.0)) || !isNaN(tan(-1.0 / 0.0))) return 26
    if (atan(1.0) != mathQuarterPi || atan(-1.0 / 0.0) != -mathHalfPi ||
        !exactly(atan(-0.0), f64ToBits(-0.0)) || atan(1e-300) != 1e-300 ||
        atan(1e300) != mathHalfPi || !isNaN(atan(0.0 / 0.0))) return 9
    // IEEE 754-2019 minimum and maximum: NaN wins, -0.0 is below 0.0.
    val nan = 0.0 / 0.0
    if (!isNaN(fmin(nan, 1.0)) || !isNaN(fmin(1.0, nan)) || !isNaN(fmax(nan, 1.0)) ||
        !isNaN(fmax(1.0, nan)) || fmin(1.0, 2.0) != 1.0 || fmin(2.0, -3.0) != -3.0 ||
        fmax(1.0, 2.0) != 2.0 || fmax(2.0, -3.0) != 2.0 ||
        !exactly(fmin(0.0, -0.0), f64ToBits(-0.0)) || !exactly(fmin(-0.0, 0.0), f64ToBits(-0.0)) ||
        !exactly(fmax(0.0, -0.0), 0) || !exactly(fmax(-0.0, 0.0), 0)) return 8
    if (!isNaN(fclamp(nan, 0.0, 1.0)) || !isNaN(fclamp(0.5, nan, 1.0)) ||
        !isNaN(fclamp(0.5, 0.0, nan)) || !exactly(fclamp(-0.0, 0.0, 1.0), 0) ||
        !exactly(fclamp(0.0, -1.0, -0.0), f64ToBits(-0.0)) || fclamp(5.0, 0.0, 1.0) != 1.0 ||
        fclamp(-5.0, 0.0, 1.0) != 0.0 || fclamp(0.5, 2.0, 1.0) != 1.0) return 29
    val inf = 1.0 / 0.0
    if (fma(2.0, 3.0, 0.5) != 6.5 || fma(0.1, 10.0, -1.0) != 5.551115123125783e-17 ||
        !exactly(fma(1.0, 1.0, -1.0), 0) || !exactly(fma(-1e-200, 1e-200, 0.0), f64ToBits(-0.0)) ||
        fma(1e308, 10.0, -inf) != -inf || !isNaN(fma(inf, 0.0, 1.0)) ||
        fma(1e308, 10.0, -1e308) != inf || fma(5e-324, 0.5, 0.0) != 0.0) return 30
    var k = 0
    while (k < FMA_CASES.size) {
        if (!exactly(fma(f64FromBits(FMA_CASES[k]), f64FromBits(FMA_CASES[k + 1]),
            f64FromBits(FMA_CASES[k + 2])), FMA_CASES[k + 3])) return 31
        k += 4
    }
    val exponential = exponentials()
    if (exponential != 0) return exponential
    val tangent = tangents()
    if (tangent != 0) return tangent
    val hypotenuse = hypotenuses()
    if (hypotenuse != 0) return hypotenuse
    42
}
