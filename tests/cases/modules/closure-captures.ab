// A captured local lives in one cell from its declaration: a closure built
// inside a loop used to re-wrap it on every pass (a cell in a cell, then a
// crash). A closure's f64 result is boxed, so arithmetic and comparisons on
// it must run as f64, not on its raw bits.
import "abla/float"
class R(var state: f64)
fun R.next(): f64 {
    this.state = this.state + 1.0
    this.state
}
fun callMut(var f: FnMut() -> f64): f64 = f()
fun call(f: () -> f64): f64 = f()
fun t(rng: () -> f64): f64 {
    val a = rng()
    a + 1.0
}
fun neg(rng: () -> f64): bool {
    val a = rng()
    a < -1.0
}
fun main: int {
    val r = R(0.0)
    var i = 0
    var total = 0.0
    while (i < 3) {
        total = total + callMut({ r.next() })
        i = i + 1
    }
    var n = 10
    if (total > 0.0) {
        total = total + call({ f64FromInt(n) })
    }
    n = n + 1
    var counter = 0.0
    for (k in 0 until 3) {
        val step = k
        counter = counter + call({ f64FromInt(step) })
    }
    if (total == 16.0 && r.state == 3.0 && n == 11 &&
        t({ 0.25 }) == 1.25 && neg({ -2.0 }) && !neg({ -0.5 }) &&
        counter == 3.0) 42 else 1
}
