// Json.get and Json.has answer the same with a key index (16 members or more)
// as by scanning, however the object was made, at run time and compile time.
import "abla/json"

fun members(count: int): array<string> {
    val keys: array<string> = []
    var index = 0
    while (index < count) {
        keys.append("key$index")
        index = index + 1
    }
    keys
}

fun numbers(count: int): array<Json> {
    val values: array<Json> = []
    var index = 0
    while (index < count) {
        values.append(jsonInteger(index))
        index = index + 1
    }
    values
}

fun source(count: int): string {
    var text = "{"
    var index = 0
    while (index < count) {
        if (index > 0) text = "$text,"
        text = "$text\"key$index\":$index"
        index = index + 1
    }
    "$text}"
}

// 0 when every key of `value` reads back and others don't.
fun reads(value: Json, count: int): int {
    var index = 0
    while (index < count) {
        if (!value.has("key$index")) return 1
        if (value.get("key$index").asInt() != index) return 2
        index = index + 1
    }
    if (value.has("key$count") || value.has("") || value.has("key")) return 3
    if (!value.get("missing").isNull()) return 4
    0
}

fun check(): int {
    for (count in [0, 1, 15, 16, 17, 64, 65, 1000]) {
        if (reads(jsonObject(members(count), numbers(count)), count) != 0) return 10
        val parsed = jsonParse(source(count))
        if (!parsed.succeeded || reads(parsed.value, count) != 0) return 11
        val merged = jsonParse(source(count), jsonPermissiveLimits)
        if (!merged.succeeded || reads(merged.value, count) != 0) return 12
        val kept = jsonParse(source(count), JsonLimits(100000, 64, 100000, 100000, 100000, false))
        if (!kept.succeeded || reads(kept.value, count) != 0) return 13
        if (reads(jsonJsKeyOrder(parsed.value), count) != 0) return 14
        val document = jsonDocument(source(count))
        if (!document.succeeded || reads(document.document.root().toJson(), count) != 0) return 15
    }
    // A repeated key reads as its last member, with or without an index.
    val keys = members(20)
    val values = numbers(20)
    keys[19] = "key3"
    val repeated = jsonObject(keys, values)
    if (repeated.get("key3").asInt() != 19 || !repeated.has("key3") || repeated.has("key19")) return 20
    val kept = jsonParse(
        "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10," +
        "\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"a\":18}",
        JsonLimits(100000, 64, 100000, 100000, 100000, false)
    )
    if (kept.value.get("a").asInt() != 18 || kept.value.size() != 18) return 21
    val merged = jsonParse(
        "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10," +
        "\"k\":11,\"l\":12,\"m\":13,\"n\":14,\"o\":15,\"p\":16,\"q\":17,\"a\":18}",
        jsonPermissiveLimits
    )
    if (merged.value.get("a").asInt() != 18 || merged.value.size() != 17) return 22
    // Keys added to an object's arrays afterwards are still found.
    val grown = jsonObject(members(32), numbers(32))
    grown.keys.append("late")
    grown.values.append(jsonInteger(7))
    if (grown.get("late").asInt() != 7 || !grown.has("late")) return 23
    // A hand-built object, with no index, scans; mismatched arrays stay safe.
    val plain = Json(5, "", 0, false, members(20), numbers(19), jsonNull().numberValue)
    if (!plain.has("key19") || !plain.get("key19").isNull() || plain.get("key18").asInt() != 18) return 24
    0
}

val atCompileTime = #check()

fun main: int {
    if (atCompileTime != 0) return atCompileTime
    val atRunTime = check()
    if (atRunTime != 0) return 100 + atRunTime
    42
}
