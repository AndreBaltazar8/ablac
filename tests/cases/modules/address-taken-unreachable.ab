// A function whose value only an uncalled method takes isn't in the indirect call's table,
// so isn't in the program; one a reachable function takes is.
import "abla/io"
fun usedValue(x: int): string = "used-function-text-$x"
fun deadValue(x: int): string = "dead-function-text-$x"
class Holder(val n: int) {
    fun live(): int = n
    fun neverCalled(): (int) -> string = deadValue
}
fun main: int {
    val taken: (int) -> string = usedValue
    println(taken(Holder(1).live()))
    0
}
