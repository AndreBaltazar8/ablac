import "../../../src/backend_c.ab"
import "abla/platform/host"
import "bootstrap-block.ab" as block
import "bootstrap-ir.ab" as ir
import "bootstrap-cfg.ab" as cfg
import "bootstrap-collections.ab" as collections
import "bootstrap-objects.ab" as objects

fun main: int {
    if (ablaHostArgumentCount() != 1) return 2
    val argument = ablaHostArgument(0)
    if (argument == "bootstrap-block") return block.main()
    if (argument == "bootstrap-ir") return ir.main()
    if (argument == "bootstrap-cfg") return cfg.main()
    if (argument == "bootstrap-collections") return collections.main()
    if (argument == "bootstrap-objects") return objects.main()

    val source = ablaHostReadFile(argument)
    val output = bootstrapEmitC(source)
    if (output == "") return 1
    ablaHostWriteStdout(output)
    0
}
