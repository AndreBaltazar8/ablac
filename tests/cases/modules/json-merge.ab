// A `$json` object whose computed key repeats another key (decision #154): one member per key, at the position where the key first appears,
// with the later member's value, in the tree form ($json, $jsons) and the streaming form ($jsonw) alike, byte for byte; jsonParse (which refuses a
// repeated key) accepts every output. Objects without a computed key are unchanged. Prints "json merge ok".
import "abla/bytes"
import "abla/io"
import "abla/json"

var failures = 0

fun check(label: string, tree: string, written: string, expected: string): void {
    if (tree != expected || written != expected) {
        failures = failures + 1
        println("FAIL $label: tree $tree, streamed $written, wanted $expected")
    }
    if (expected != "null" && !jsonParse(tree).succeeded) {
        failures = failures + 1
        println("FAIL $label: jsonParse refuses $tree")
    }
    return
}

fun computedFirst(k: string): void {
    val out = byteBuffer()
    $jsonw(out) { k: true, "admin": false }
    check("a computed key before a literal one", jsonStringify($json { k: true, "admin": false }), out.toText(), "{\"admin\":false}")
    return
}

fun computedLast(k: string): void {
    val out = byteBuffer()
    $jsonw(out) { "admin": false, k: true }
    check("a computed key after a literal one", $jsons { "admin": false, k: true }, out.toText(), "{\"admin\":true}")
    return
}

fun positions(a: string, b: string): void {
    val out = byteBuffer()
    $jsonw(out) { a: 1, "y": 2, b: 3, "z": [4, { a: 5, b: 6 }] }
    check("first position, last value, nested", $jsons { a: 1, "y": 2, b: 3, "z": [4, { a: 5, b: 6 }] }, out.toText(),
        "{\"y\":3,\"z\":[4,{\"y\":6}]}")
    return
}

fun guarded(k: string, selected: bool): string {
    val out = byteBuffer()
    $jsonw(out) { if (selected) k: 1, "admin": 2, if (!selected) k: 3 }
    val tree = $jsons { if (selected) k: 1, "admin": 2, if (!selected) k: 3 }
    if (tree != out.toText()) {
        failures = failures + 1
        println("FAIL guarded ($selected): tree $tree, streamed ${out.toText()}")
    }
    tree
}

fun many(k: array<string>): void {
    // Twelve computed keys (past the eight that are compared pairwise): k[0] == k[5] == k[11], k[3] == k[9].
    val out = byteBuffer()
    $jsonw(out) { k[0]: 0, k[1]: 1, k[2]: 2, k[3]: 3, k[4]: 4, k[5]: 5, k[6]: 6, k[7]: 7, k[8]: 8, k[9]: 9, k[10]: 10, k[11]: 11 }
    check("twelve computed keys", $jsons { k[0]: 0, k[1]: 1, k[2]: 2, k[3]: 3, k[4]: 4, k[5]: 5, k[6]: 6, k[7]: 7, k[8]: 8, k[9]: 9, k[10]: 10, k[11]: 11 },
        out.toText(), "{\"a\":11,\"b\":1,\"c\":2,\"d\":9,\"e\":4,\"g\":6,\"h\":7,\"i\":8,\"k\":10}")
    return
}

fun invalidKey(k: string): void {
    val out = byteBuffer()
    $jsonw(out) { k: 1, "a": 2 }
    check("a computed key that is not UTF-8", $jsons { k: 1, "a": 2 }, out.toText(), "null")
    return
}

fun distinct(k: string): void {
    val out = byteBuffer()
    $jsonw(out) { k: 1, "admin": false }
    check("distinct keys", $jsons { k: 1, "admin": false }, out.toText(), "{\"user\":1,\"admin\":false}")
    return
}

fun main: int {
    computedFirst("admin")
    computedLast("admin")
    positions("y", "y")
    distinct("user")
    val on = guarded("admin", true)
    val off = guarded("admin", false)
    if (on != "{\"admin\":2}" || off != "{\"admin\":3}") {
        failures = failures + 1
        println("FAIL guarded: $on and $off, wanted {\"admin\":2} and {\"admin\":3}")
    }
    many(["a", "b", "c", "d", "e", "a", "g", "h", "i", "d", "k", "a"])
    invalidKey("\xff")
    val literal = $jsons { "a": 1, "b": [true, null] }
    if (literal != "{\"a\":1,\"b\":[true,null]}") {
        failures = failures + 1
        println("FAIL a literal-only object: $literal")
    }
    if (failures == 0) println("json merge ok")
    if (failures == 0) 0 else 1
}
