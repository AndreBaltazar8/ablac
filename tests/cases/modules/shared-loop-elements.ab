// A loop over a shared parameter's array can read and store its elements;
// a loop over the receiver's own array makes the method a mutating one.
class Node(var weight: int)
class World(val nodes: array<Node>)

fun copyAll(nodes: array<Node>): array<Node> {
    val out: array<Node> = []
    for (node in nodes) out.append(node)
    out
}

fun total(nodes: array<Node>): int {
    var sum = 0
    for (node in nodes) sum += node.weight
    sum
}

fun bump(var nodes: array<Node>): void {
    for (node in nodes) node.weight = node.weight + 1
    return
}

fun World.reset(): void {
    for (node in this.nodes) node.weight = 0
    return
}

fun main: int {
    val nodes = [Node(1), Node(2)]
    bump(nodes)
    if (total(copyAll(nodes)) != 5) return 1
    var world = World(nodes)
    world.reset()
    if (total(nodes) != 0) return 2
    42
}
