import "abla/compiler"
import "abla/compiler/parser"
import "reactive-dependency-helper.ab"

class ReactiveState(
    var count: int,
    var untouched: int,
    val items: array<int>,
    var selected: int,
    val cached: Cell<int>
) {
    fun bump(): void {
        count = count + 1
        return
    }
}

var reactiveGlobal = 0

class ReactiveDelegate(var current: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = next
        return
    }
}

fun delegatedState(): int {
    var value: int by ReactiveDelegate(1)
    value = 2
    value
}

fun updateReactiveGlobal(): int {
    reactiveGlobal = reactiveGlobal + 1
    reactiveGlobal
}

fun formatted(state: ReactiveState): int = state.count

fun aliasedCount(state: ReactiveState): int {
    val alias = state
    alias.count
}

fun indexedValues(state: ReactiveState): int =
    state.items[4] + state.items[state.selected]

fun thirdValue(state: ReactiveState): int = state.items[3]

fun cachedValue(state: ReactiveState): int = state.cached.get()

fun cacheValue(state: ReactiveState, value: int): void {
    state.cached.set(value)
    return
}

fun increment(var state: ReactiveState): void {
    state.count = state.count + 1
    return
}

fun recursiveCount(state: ReactiveState, depth: int): int {
    if (depth <= 0) return state.count
    recursiveCount(state, depth - 1)
}

noescape extern:"c" fun reactiveUnknown(values: array<int>): void

compile fun finalizeReactiveRead(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val path = typedExpressionRead(expression, 0)
    val rootParameter = typedAccessRootParameter(path)
    val aliasFunction = compilerFindFunction("aliasedCount")
    val aliasPath = typedFunctionRead(aliasFunction, 0)
    val indexedFunction = compilerFindFunction("indexedValues")
    val firstIndex = typedFunctionRead(indexedFunction, 0)
    val secondIndex = typedFunctionRead(indexedFunction, 1)
    val selected = typedFunctionRead(indexedFunction, 2)
    val third = typedFunctionRead(compilerFindFunction("thirdValue"), 0)
    val cellFunction = compilerFindFunction("cachedValue")
    val cellPath = typedFunctionRead(cellFunction, 0)
    val module = compilerGeneratedModule("reactive.read", expression)
    var failure = 0
    if (typedExpressionReadCount(expression) != 1) failure = 1
    if (typedExpressionWriteCount(expression) != 0) failure = 2
    if (typedExpressionReadsUnknown(expression)) failure = 3
    if (typedExpressionWritesUnknown(expression)) failure = 4
    if (typedAccessRootKind(path) != "parameter") failure = 5
    if (rootParameter != 0) failure = 6
    if (typedAccessSegmentCount(path) != 1) failure = 7
    if (typedAccessSegmentKind(path, 0) != "field") failure = 8
    if (typedAccessSegmentName(path, 0) != "count") failure = 9
    if (typedFunctionReadCount(aliasFunction) != 1) failure = 10
    if (typedAccessSegmentName(aliasPath, 0) != "count") failure = 11
    if (typedFunctionReadCount(indexedFunction) != 3) failure = 12
    if (typedAccessSegmentKind(firstIndex, 1) != "index.constant") failure = 13
    if (typedAccessSegmentIndex(firstIndex, 1) != 4) failure = 14
    if (typedAccessSegmentKind(secondIndex, 1) != "index.dynamic") failure = 15
    if (typedAccessSegmentName(selected, 0) != "selected") failure = 16
    if (!typedAccessPathsIntersect(firstIndex, secondIndex)) failure = 19
    if (typedAccessPathsIntersect(firstIndex, third)) failure = 20
    if (typedFunctionReadCount(cellFunction) != 1) failure = 17
    if (typedAccessSegmentKind(cellPath, 1) != "cell") failure = 18
    if (failure != 0) {
        val names: array<string> = []
        val types: array<int> = []
        compilerGeneratedExportFunction(
            module, generatedName, names, types,
            compilerFindType("i64"), syntaxInteger(failure)
        )
        module
    } else {
        val captures: array<string> = ["state"]
        val parameterNames: array<string> = ["model"]
        val parameterTypes: array<int> = [compilerFindType("ReactiveState")]
        val mutableCaptures: array<bool> = [false]
        compilerGeneratedLiftedFunction(
            module,
            "binding",
            captures,
            parameterNames,
            parameterTypes,
            mutableCaptures,
            compilerFindType("i64"),
            expression
        )
        val stateArguments: array<SyntaxExpression> = [
            syntaxInteger(40),
            syntaxInteger(0),
            syntaxArray([
                syntaxInteger(0), syntaxInteger(0), syntaxInteger(0),
                syntaxInteger(0), syntaxInteger(0)
            ]),
            syntaxInteger(0),
            syntaxCall("Cell", [syntaxInteger(0)])
        ]
        val invocation = compilerGeneratedDeclarationCall(
            module,
            0,
            [syntaxCall("ReactiveState", stateArguments)]
        )
        val names: array<string> = []
        val types: array<int> = []
        compilerGeneratedExportFunction(
            module,
            generatedName,
            names,
            types,
            compilerFindType("i64"),
            invocation
        )
        module
    }
}

compile fun finalizeReactiveWrite(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val read = typedExpressionRead(expression, 0)
    val write = typedExpressionWrite(expression, 0)
    val cacheWriter = compilerFindFunction("cacheValue")
    val cachePath = typedFunctionWrite(cacheWriter, 0)
    val module = compilerGeneratedModule("reactive.write", expression)
    if (typedExpressionReadCount(expression) != 1 ||
        typedExpressionWriteCount(expression) != 1 ||
        typedExpressionReadsUnknown(expression) ||
        typedExpressionWritesUnknown(expression) ||
        typedAccessSegmentName(read, 0) != "count" ||
        typedAccessSegmentName(write, 0) != "count" ||
        !typedAccessPathsIntersect(read, write) ||
        typedFunctionWriteCount(cacheWriter) != 1 ||
        typedAccessSegmentKind(cachePath, 1) != "cell") {
        val names: array<string> = []
        val types: array<int> = []
        compilerGeneratedExportFunction(
            module, generatedName, names, types,
            compilerFindType("i64"), syntaxInteger(0)
        )
        module
    } else {
        val captures: array<string> = ["state"]
        val parameterNames: array<string> = ["model"]
        val parameterTypes: array<int> = [compilerFindType("ReactiveState")]
        val mutableCaptures: array<bool> = [true]
        compilerGeneratedLiftedFunction(
            module,
            "handler",
            captures,
            parameterNames,
            parameterTypes,
            mutableCaptures,
            compilerFindType("void"),
            expression
        )
        val stateArguments: array<SyntaxExpression> = [
            syntaxInteger(40),
            syntaxInteger(0),
            syntaxArray([syntaxInteger(0)]),
            syntaxInteger(0),
            syntaxCall("Cell", [syntaxInteger(0)])
        ]
        val local = syntaxVariable(
            "instance",
            compilerFindType("ReactiveState"),
            syntaxCall("ReactiveState", stateArguments)
        )
        val invoke = compilerGeneratedDeclarationCall(
            module,
            0,
            [syntaxIdentifier("instance")]
        )
        val body = syntaxBlock([
            local,
            invoke,
            syntaxMember(syntaxIdentifier("instance"), "count")
        ])
        val names: array<string> = []
        val types: array<int> = []
        compilerGeneratedExportFunction(
            module,
            generatedName,
            names,
            types,
            compilerFindType("i64"),
            body
        )
        module
    }
}

compile fun finalizeReactiveField(
    generatedName: string,
    expression: SyntaxExpression
): GeneratedModuleBuilder {
    val path = typedExpressionRead(expression, 0)
    val recursive = compilerFindFunction("recursiveCount")
    val unknown = compilerFindFunction("reactiveUnknown")
    val receiverMethod = compilerFindFunction("ReactiveState.bump")
    val receiverWrite = typedFunctionWrite(receiverMethod, 0)
    val globalFunction = compilerFindFunction("updateReactiveGlobal")
    val globalRead = typedFunctionRead(globalFunction, 0)
    val globalWrite = typedFunctionWrite(globalFunction, 0)
    val delegated = compilerFindFunction("delegatedState")
    val delegatedRead = typedFunctionRead(delegated, 1)
    val delegatedWrite = typedFunctionWrite(delegated, 1)
    val importedReadFunction = compilerFindFunction("importedReactiveRead")
    val importedRead = typedFunctionRead(importedReadFunction, 0)
    val importedForward = compilerFindFunction("importedReactiveForward")
    val importedWrite = typedFunctionWrite(importedForward, 0)
    var result = 42
    if (typedExpressionReadCount(expression) != 1 ||
        typedExpressionWriteCount(expression) != 0 ||
        typedExpressionHasEffect(expression, "trusted.native") ||
        typedAccessRootKind(path) != "parameter" ||
        typedAccessRootParameter(path) != 0 ||
        typedAccessSegmentCount(path) != 1 ||
        typedAccessSegmentName(path, 0) != "untouched") result = 51
    if (!typedFunctionReadsUnknown(recursive) ||
        !typedFunctionReadsUnknown(unknown) ||
        !typedFunctionHasEffect(unknown, "trusted.native") ||
        typedFunctionWriteCount(unknown) != 0) result = 52
    if (typedAccessRootKind(receiverWrite) != "receiver" ||
        typedAccessSegmentName(receiverWrite, 0) != "count") result = 53
    if (typedAccessRootKind(globalRead) != "global" ||
        typedAccessRootKind(globalWrite) != "global" ||
        !typedAccessPathsIntersect(globalRead, globalWrite)) result = 54
    if (typedFunctionReadCount(delegated) != 2 ||
        typedFunctionWriteCount(delegated) != 2) result = 55
    if (typedAccessSegmentKind(delegatedRead, 0) != "delegate" ||
        typedAccessSegmentName(delegatedRead, 1) != "current" ||
        typedAccessSegmentKind(delegatedWrite, 0) != "delegate" ||
        typedAccessSegmentName(delegatedWrite, 1) != "current") result = 56
    if (typedAccessSegmentName(importedRead, 0) != "count" ||
        typedAccessSegmentName(importedWrite, 0) != "count") result = 57
    val module = compilerGeneratedModule("reactive.field", expression)
    val names: array<string> = []
    val types: array<int> = []
    compilerGeneratedExportFunction(
        module,
        generatedName,
        names,
        types,
        compilerFindType("i64"),
        syntaxInteger(result)
    )
    module
}

compile fun parseReactiveRead(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "reactive.read",
        "reactiveReadAdapter",
        expression,
        finalizeReactiveRead
    )
    expression
}

compile fun parseReactiveWrite(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "reactive.write",
        "reactiveWriteAdapter",
        expression,
        finalizeReactiveWrite
    )
    expression
}

compile fun parseReactiveField(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val expression = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    compilerRecordGeneratedExtensionRequest(
        "reactive.field",
        "reactiveFieldAdapter",
        expression,
        finalizeReactiveField
    )
    expression
}

#compilerRegisterSubparser("reactiveRead", parseReactiveRead)
#compilerRegisterSubparser("reactiveWrite", parseReactiveWrite)
#compilerRegisterSubparser("reactiveField", parseReactiveField)

fun exercise(var state: ReactiveState): int {
    val before = $reactiveRead(formatted(state))
    val direct = $reactiveField(state.untouched)
    $reactiveWrite(increment(state))
    before + direct + state.count
}

fun main: int {
    val state = ReactiveState(1, 0, [0, 0, 0, 0, 0], 0, Cell(0))
    val source = exercise(state)
    if (source != 3) return 1
    val read = reactiveReadAdapter()
    if (read != 40) return read
    if (reactiveWriteAdapter() != 41) return 3
    val field = reactiveFieldAdapter()
    if (field != 42) return field
    42
}
