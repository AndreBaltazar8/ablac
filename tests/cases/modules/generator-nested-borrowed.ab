import "abla/io"

var closes: int = 0

fun numbers(): Generator<int> = generator {
    defer { closes += 1 }
    yield 1
    yield 2
}

class Holder(val gen: Generator<int>)

fun outer(choice: bool, stop: bool): Generator<int> = generator {
    yield 0
    val holder = Holder(numbers())
    for (value in if (choice) holder.gen else numbers()) {
        yield value
        if (stop) break
    }
}

fun exercise(choice: bool, mode: int): int {
    var sum = 0
    for (value in outer(choice, mode == 2)) {
        sum += value
        if (mode == 0 || (mode == 1 && value == 1)) break
    }
    sum
}

fun evaluatorCheck(): int {
    closes = 0
    var sum = 0
    for (i in 0 until 8) {
        sum += exercise((i / 4) % 2 == 0, i % 4)
    }
    sum * 100 + closes
}

fun borrowedCloseCheck(): int {
    closes = 0
    val value = exercise(true, 1)
    value * 10 + closes
}

val evaluated = #evaluatorCheck()
val borrowedClosed = #borrowedCloseCheck()

fun main: int {
    var sum = 0
    for (i in 0 until 1000) {
        sum += exercise((i / 4) % 2 == 0, i % 4)
    }
    val count = closes
    println("$sum $count ${evaluated == evaluatorCheck() && evaluated == 1006 && borrowedClosed == 11 &&
        borrowedClosed == borrowedCloseCheck()}")
    0
}
