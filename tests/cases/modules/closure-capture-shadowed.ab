// A local of a name an outer, captured local has is a local of its own: a
// `for` variable or a block's `val` isn't read as the outer one's cell.
import "abla/io"
val steps: array<() -> int> = []
fun main: int {
    val name = "n"
    steps.append({ -> name.size })
    var count = 0
    for (name in ["x", "y"]) if (name != "") count = count + 1
    var total = 0
    for (name in ["ab", "c"]) {
        steps.append({ -> name.size })
        total = total + name.size
    }
    if (count == 2) {
        val name = 5
        total = total + name
    }
    var outer = 1
    steps.append({ -> outer + name.size })
    for (outer in [7]) total = total + outer
    outer = 20
    var sum = 0
    for (step in steps) sum = sum + step()
    // 1 + 2 + 1 + 21 = 25, count 2, total 3 + 5 + 7 = 15
    println("$count $name")
    sum + count + total
}
