fun remoteTestClient(port: int): int {
    val options = JwtOptions(issuer = "Example", nowSeconds = 1900000000)
    val cache = jwksCache("http://127.0.0.1:$port/v1/jwks/public/jwks.json", 86400, 0, 2000)
    if (cache.keyCount() != 2 || cache.lastError != "") return 2
    val first = cache.verify(remoteTestToken, options)
    if (!first.valid || first.subject != "player-42") return 3
    // Unknown kid: a rotation refetch when the cooldown allows it ...
    val unknown = cache.verify(remoteTestUnknownKid, options)
    if (unknown.valid || unknown.error != "no matching key" || cache.fetches != 2) return 4
    // ... and none within the cooldown after a fetch.
    val cooled = jwksCache("http://127.0.0.1:$port/v1/jwks/public/jwks.json", 86400, 30, 2000)
    cooled.verify(remoteTestUnknownKid, options)
    if (cooled.fetches != 1) return 5
    val missing = jwksCache("http://127.0.0.1:$port/missing", 86400, 30, 2000)
    if (missing.keyCount() != 0 || missing.lastError != "JWKS request returned 404") return 6
    if (!jwksCacheFromDocument(remoteTestKeys).verify(remoteTestToken, options).valid) return 7
    if (jwksParseLocation("https://example.com:8443/a/b").port != 8443) return 8
    0
}

fun main: int {
    val server = webSocketServer(ipv4Loopback(0))
    val port = server.localPort()
    val process = linuxSyscall0(57)
    if (process == 0) linuxSyscall1(60, remoteTestClient(port))
    var requests = 0
    var status = -1
    var loops = 0
    while (status < 0 && loops < 3000) {
        server.step(5)
        val events = server.takeEvents()
        var index = 0
        while (index < events.size) {
            val event = events[index]
            if (event.isHttp()) {
                requests = requests + 1
                if (event.path() == "/v1/jwks/public/jwks.json") {
                    server.respond(event.id, httpJson(remoteTestKeys))
                } else server.respond(event.id, httpText("missing", 404))
            }
            index = index + 1
        }
        val waited = linuxWaitProcess(process, true)
        if (waited.output != "pending") status = waited.status
        loops = loops + 1
    }
    server.step(5)
    server.drain()
    if (status == 0 && requests == 4) 42
    else {
        println("status=$status requests=$requests")
        1
    }
}
