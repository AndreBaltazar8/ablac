import "abla/compiler"

// Delegated class properties: `var name: T by delegate` in a constructor. The
// field holds the delegate (made at each construction from the `by`
// expression, which may read earlier parameters); reads call getValue(),
// assignments setValue(), `obj.^name` is the delegate and `obj.^name = d`
// replaces it. Inside the class's methods the bare name works the same way.

class Clamped(var current: int, val minimum: int, val maximum: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = if (next < minimum) minimum else if (next > maximum) maximum else next
        return
    }
}

class Counted(var current: int, var reads: int, var writes: int) {
    fun getValue(): int {
        reads += 1
        current
    }
    fun setValue(next: int): void {
        writes += 1
        current = next
        return
    }
}

class Label(val text: string) {
    fun getValue(): string = text
}

class Level(var current: u8) {
    fun getValue(): u8 = current
    fun setValue(next: u8): void {
        current = next
        return
    }
}

var drops = 0

resource class Guard(val label: string, var current: int) {
    fun getValue(): int = current
    fun setValue(next: int): void {
        current = next
        return
    }
    fun drop(): void {
        drops += 1
        return
    }
}

class Mixer(
    val name: string,
    var volume: int by Clamped(40, 0, 100),
    val gain: int,
    var hits by Counted(gain, 0, 0),
    val title by Label("mixer $name"),
    var level: u8 by Level(1)
) {
    fun louder(): int {
        volume += 30
        hits = hits + 1
        volume
    }
    fun limit(): int = ^volume.maximum
    fun narrow(): void {
        ^volume = Clamped(volume, 0, 50)
        this.level = 3
        return
    }
}

resource class Vault(val name: string, var gold: int by Guard(name, 10))

fun Mixer.doubled(): int = volume * 2

// Reflection lists a delegated property as one, with its delegate's type.
compile fun reflected(): string {
    val mixer = compiler.findClass("Mixer")
    var text = ""
    for (name in compiler.fieldsOf(mixer)) {
        if (compiler.fieldIsDelegated(mixer, name)) {
            text = "$text $name:${compiler.fieldDelegateType(mixer, name)}"
        }
    }
    "${compiler.fieldsOf(mixer).size}$text ${compilerClassFieldType(mixer, 1)}"
}

fun staged(): int {
    val mixer = Mixer("staged", 2)
    mixer.volume = 150
    mixer.louder() + mixer.hits * 1000 + mixer.doubled()
}

fun check(condition: bool, code: int): int = if (condition) 0 else code

fun main: int {
    var failed = 0
    val mixer = Mixer("main", 3)
    failed += check(mixer.volume == 40 && mixer.gain == 3 && mixer.hits == 3, 1)
    failed += check(mixer.title == "mixer main", 2)
    mixer.volume = 140
    failed += check(mixer.volume == 100, 3)
    mixer.volume -= 150
    failed += check(mixer.volume == 0, 4)
    val assigned = (mixer.volume = 7)
    failed += check(assigned == 7 && mixer.volume == 7, 5)
    failed += check(mixer.louder() == 37 && mixer.limit() == 100, 6)
    failed += check(mixer.^hits.reads == 2 && mixer.^hits.writes == 1, 7)
    mixer.narrow()
    mixer.volume += 100
    failed += check(mixer.volume == 50 && mixer.^volume.maximum == 50, 8)
    mixer.^volume = Clamped(5, 0, 10)
    failed += check(mixer.doubled() == 10 && mixer.level == 3, 9)
    mixer.level = 200
    failed += check(mixer.level == 200, 10)
    val read = { mixer.volume }
    mixer.volume = 9
    failed += check(read() == 9, 11)
    val named = Mixer(name = "n", gain = 4)
    failed += check(named.hits == 4 && named.title == "mixer n", 12)
    failed += check(staged() == 100 + 3000 + 200, 13)
    failed += check(#staged() == staged(), 14)
    if (true) {
        var vault = Vault("v")
        vault.gold += 5
        failed += check(vault.gold == 15 && vault.^gold.label == "v", 15)
        vault.^gold = Guard("w", 1)
        failed += check(drops == 1 && vault.gold == 1, 16)
    }
    failed += check(drops == 2, 17)
    failed += check(#reflected() == "6 volume:Clamped hits:Counted title:Label level:Level i64", 18)
    // `.^` binds to its property: `(mixer.^volume).maximum`.
    failed += check(mixer.^volume.maximum == (mixer.^volume).maximum, 19)
    if (failed == 0) 42 else failed
}
