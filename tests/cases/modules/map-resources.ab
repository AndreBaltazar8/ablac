// A map owns its affine values like an array owns its elements: `get` and
// `values` lend them, `take` moves one out, and a value replaced, removed or
// cleared, or still held when the map goes away, is dropped exactly once,
// at run time and at compile time alike.
class Log(var value: int)

resource class Token(val id: int, val log: Log) {
    fun drop(): void {
        log.value = log.value * 10 + id
        return
    }
}

fun consume(own token: Token): int = token.id

fun scenario(log: Log): int {
    var total = 0
    val tokens: Map<string, Token> = Map()
    tokens.set("a", Token(1, log))
    tokens.set("a", Token(2, log))      // drops 1
    if (tokens.remove("a")) total += 100 // drops 2
    tokens.set("b", Token(3, log))
    tokens.set("c", Token(4, log))
    val seen = tokens.get("b")
    if (seen != null) total += seen.id   // 3
    for (token in tokens.values()) total += token.id // 3 + 4
    val taken = tokens.take("c")
    if (taken != null) total += consume(move(taken)) // 4, dropped by consume
    if (tokens.take("missing") == null) total += 1000
    tokens.set("d", Token(5, log))
    tokens.clear()                        // drops 3, then 5
    tokens.set("e", Token(6, log))
    total                                 // the map drops 6 on the way out
}

fun run(): int {
    val log = Log(0)
    val total = scenario(log)
    total * 10000000 + log.value
}

fun main: int = if (run() == 11140124356 && #run() == 11140124356) 42 else 0
