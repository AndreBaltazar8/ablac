// A global whose initializer interpolates a float reads abla/float/text's tables
// through the f64Text call lowering inserts (an f32 widened by f32ToF64 first):
// those tables initialize before it. So do a u64's and a char's text writers.
import "abla/float"
import "abla/float/text"

val THIRD = "${1.0 / 3.0}"
val SUM = "third ${0.1 + 0.2}"
val NARROW: f32 = f64ToF32(0.1)
val NARROW_TEXT = "${NARROW}"
val WIDE: u64 = u64(18446744073709551615)
val WIDE_TEXT = "${WIDE}"

fun main: int = if (THIRD == "0.3333333333333333" &&
    SUM == "third 0.30000000000000004" && NARROW_TEXT == "0.10000000149011612" &&
    WIDE_TEXT == "18446744073709551615") 42 else 1
