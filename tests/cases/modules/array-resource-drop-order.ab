// An array drops its affine elements first to last, at run time and at
// compile time alike (the evaluator used to drop them last to first).
class Log(var value: int)
resource class Token(val id: int, val log: Log) {
    fun drop(): void {
        log.value = log.value * 10 + id
        return
    }
}
fun run(): int {
    val log = Log(0)
    if (true) {
        val tokens: array<Token> = []
        tokens.append(Token(1, log))
        tokens.append(Token(2, log))
        tokens.append(Token(3, log))
    }
    log.value
}
val atCompile = #run()
fun main: int = if (run() == 123 && atCompile == 123) 42 else 1
