import "../../../src/ir.ab"
import "abla/io"

fun node(
    opcode: string, result: int = -1, left: int = -1,
    target: int = -1
): BootstrapInstruction =
    BootstrapInstruction(opcode, result, left, -1, "", target, -1, [], [], -1)

fun main(): int {
    val valid = bootstrapFinalizeIrFunction("valid", [], [
        node("const.i64", 0), node("return", -1, 0)
    ], 0)
    val pruned = bootstrapFinalizeIrFunction("pruned", [], [
        node("jump", -1, -1, 2), node("label", -1, -1, 1),
        node("const.i64", 1), node("return", -1, 1),
        node("label", -1, -1, 2), node("const.i64", 0), node("return", -1, 0)
    ], 0)
    val duplicate = bootstrapFinalizeIrFunction("duplicate", [], [
        node("const.i64", 0), node("const.i64", 0), node("return", -1, 0)
    ], 0)
    val missingLabel = bootstrapFinalizeIrFunction("missing-label", [], [
        node("jump", -1, -1, 99)
    ], -1)
    // The first structural check can see value 0 in an unreachable block.
    // Pruning removes that definition, so the remaining read must be checked.
    val prunedRead = bootstrapFinalizeIrFunction("pruned-read", [], [
        node("jump", -1, -1, 2), node("label", -1, -1, 1),
        node("const.i64", 0), node("return", -1, 0),
        node("label", -1, -1, 2), node("return", -1, 0)
    ], 0)
    println("valid=${valid.verificationErrors}/${valid.instructions.size}")
    println("pruned=${pruned.verificationErrors}/${pruned.instructions.size}")
    println("duplicate=${duplicate.verificationErrors}")
    println("missing-label=${missingLabel.verificationErrors}")
    println("pruned-read=${prunedRead.verificationErrors}")
    if (valid.verificationErrors == 0 && valid.instructions.size == 2 &&
        pruned.verificationErrors == 0 && pruned.instructions.size == 4 &&
        duplicate.verificationErrors == 2 &&
        missingLabel.verificationErrors == 2 &&
        prunedRead.verificationErrors == 2) 42 else 1
}
