// posix_memalign of the statically linked compiler's C library (src/static_libc/memory.ab, #1139 area 14): LLVM's aligned operator new comes here.
// The block it takes is size + alignment + 32 bytes; a size or an alignment that would take that sum past what the heap can give must be ENOMEM (12),
// not a wrapped sum (a small block the caller then writes `size` bytes into). Ordinary aligned blocks are aligned, writable and freed. Exits 42
// (tools/test-libc-functions.sh).
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../../../src/static_libc/memory.ab"

trusted fun main: int {
    val cell = ablaUnsafePointerAddress(ablaUnsafeAllocate(8))
    // A wrapped sum: SIZE_MAX - 16 + 64 + 32, SIZE_MAX itself, and an alignment of 2^62 with a size of 2^62.
    if (libcPosixMemalign(cell, 64, -17) != 12) return 1
    if (libcPosixMemalign(cell, 64, -1) != 12) return 2
    if (libcPosixMemalign(cell, 4611686018427387904, 4611686018427387904) != 12) return 3
    if (libcPosixMemalign(cell, 16, -1) != 12) return 4
    // Not a power of two, or under 8: EINVAL.
    if (libcPosixMemalign(cell, 24, 16) != 22) return 5
    // Ordinary blocks: aligned, the whole size writable, freed.
    for (alignment in [8, 16, 32, 64, 4096]) {
        if (libcPosixMemalign(cell, alignment, 1000) != 0) return 6
        val block = ablaUnsafeLoadI64(nativePointerFromAddress(cell))
        if (block == 0 || (block & (alignment - 1)) != 0) return 7
        for (i in 0 until 1000) ablaUnsafeStoreU8(nativePointerFromAddress(block + i), 90)
        libcFree(block)
    }
    42
}
