import "abla/io"
import "abla/compiler"
// Reflection under `#` reports an inferred result type as the body's, also for
// a function nothing calls.

@route("/users")
fun listUsers(page: int) = "users page $page"

@route("/count")
fun countUsers() = 42

@route("/flag")
fun hasUsers(n: int) {
    if (n > 0) return true
    false
}

compile fun routeTable(): array<string> {
    val rows: array<string> = []
    for (function in compiler.functionsAnnotated("route")) {
        rows.append("${compiler.functionName(function)} -> ${compiler.resultType(function)}")
    }
    rows
}

fun main {
    for (row in #routeTable()) println(row)
}
