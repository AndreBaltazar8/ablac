import "abla/io"
import "abla/float"
import "abla/float/text"
// Functions, methods, extensions and compile funs without a declared result
// type: their callers use the type of their bodies, at runtime and under `#`.
class Box(var n: int) {
    fun doubled() = n * 2
    fun label() = "box$n"
    fun bump() { n = n + 1 }
}
fun Box.tripled() = this.n * 3
fun Box.half() = f64FromInt(this.n) / 2.0
fun names() = ["a", "b"]
fun ratio(a: int, b: int) = f64FromInt(a) / f64FromInt(b)
fun maybe(n: int) = if (n > 0) "pos" else null
fun make(n: int) = Box(n)
fun boxes(n: int) = [make(n), make(n + 1)]
fun grid() = [[1, 2], [3]]
fun adder(k: int) = { x: int -> x + k }
fun early(n: int) {
    if (n > 10) return "big"
    "small"
}
fun isEven(n: int) = n % 2 == 0
compile fun table(n: int) = n * 10
// Used before its declaration, and by a global.
fun chain(n: int) = inc(n) + 1
fun inc(n: int) = n + 1
val G = chain(1)
var counter = 0
// An assignment tail is the function's value unless it is declared `: void`.
fun count() { counter = counter + 5 }
// Mutual recursion: one annotation is enough.
fun even(n: int): bool = if (n == 0) true else odd(n - 1)
fun odd(n: int) = if (n == 0) false else even(n - 1)
// Overloads, each with its own inferred result.
fun show(n: int) = "int $n"
fun show(s: string) = "string $s"
fun twice(n: int) = n * 2
// Overloaded methods and extensions, and an operator, with inferred results.
class V(val x: int) {
    fun put(n: int) = x + n
    fun put(s: string) = "$s$x"
}
operator fun V.plus(other: V) = V(this.x + other.x)
fun V.scaled(k: int) = V(this.x * k)
fun V.scaled(k: string) = "$k${this.x}"
fun counts() {
    val m: Map<string, int> = Map()
    m.set("x", 3)
    m
}
fun summary() = "${twice(4)} ${inc(1)} ${odd(3)} ${show(2)} ${early(1)}"
fun main: int {
    val b = Box(4)
    b.bump()
    val d: int = b.doubled()
    println("${b.label()} $d ${b.tripled()} ${b.half()}")
    val ns = names()
    println("${ns.size} ${ns[1]} ${ratio(1, 4)} ${grid()[1][0]}")
    val m = maybe(1)
    if (m != null) println(m)
    println("${make(7).n} ${make(2).doubled()} ${boxes(5)[1].n}")
    val f = adder(5)
    val fi = inc
    println("${f(1)} ${fi(1)} ${early(3)} ${early(30)} ${isEven(4)}")
    val t: int = #table(4)
    println("$t $G ${count()} ${count()}")
    println("${odd(7)} ${even(7)} ${show(3)} ${show("x")}")
    val v = V(1) + V(2)
    println("${v.put(10)} ${v.put("x")} ${v.scaled(4).x} ${v.scaled("s")} ${counts().has("x")} ${#(V(5) + V(6)).put(1)}")
    val runtime = summary()
    val staged = #summary()
    println("$runtime|$staged|${#twice(21)}|${#make(3).doubled()}")
    if (runtime == staged) twice(21) else 1
}
