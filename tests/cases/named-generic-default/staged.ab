class Tagged<T>(val n: int)
class Bag<T>(val value: T) {
    fun get(a: int, b: Tagged<T> = Tagged<T>(3)): int = a + b.n
}
fun <T> build(a: T, b: Tagged<T> = Tagged<T>(2)): int = b.n
fun <T> length(a: T, b: array<T> = [a]): int = b.size
fun <T> empty(a: T, b: array<T> = []): int = b.size
fun <T> nullable(a: T, b: T? = null): bool = b == null
compile fun <T> compileBuild(a: T, b: Tagged<T> = Tagged<T>(5)): int = b.n
compile fun check(): bool {
    val Tagged = { n: int -> n * 10 }
    build(a = "x") == 2 && Bag("x").get(a = 1) == 4 &&
        length(a = "x") == 1 && empty(a = "x") == 0 && nullable(a = 2) &&
        compileBuild(a = "x") == 5 && Tagged(1) == 10
}
fun main: int = if (#check()) 0 else 1
