class Tagged<T>(val n: int)
class Slot<T>(var value: T) { fun getValue(): T = value }
class Box<T>(val item: T, val tag: Tagged<T> = Tagged<T>(2), val saved: T by Slot(item))
fun main: int { val Tagged = { n: int -> n * 10 }; val box = Box<string>(item = "ok"); if (box.tag.n == 2 && box.saved == "ok" && Tagged(1) == 10) 0 else 1 }
