var trace = 0
var drops = 0
fun mark(n: int): int { trace = trace * 10 + n; n }
resource class Ticket(val value: int) { fun drop(): void { drops = drops + value } }
class Tagged<T>(val n: int)
class Box<T>(val value: T, val tag: Tagged<T> = Tagged<T>(2))
fun <T> choose(a: int, b: Tagged<T> = Tagged<T>(1)): Tagged<T> = b
fun <T> dependent(a: T, b: Tagged<T> = Tagged<T>(mark(3)), c: int = mark(4)): int = b.n + c
class Bag<T>(val value: T, var count: int) {
    fun item(a: int, b: Tagged<T> = Tagged<T>(1)): int = a + b.n
    fun <U> other(a: U, b: Tagged<U> = Tagged<U>(2)): int = b.n
    fun <U> typed(a: int, b: Tagged<U> = Tagged<U>(3)): Tagged<U> = b
    fun bump(a: int, b: Tagged<T> = Tagged<T>(1)): int { this.count = this.count + b.n; this.count + a }
    fun capture(a: int, b: Tagged<T> = Tagged<T>(count)): int = a + b.n
}
fun resourceCase(): int {
    val box = Box<Ticket>(value = Ticket(40))
    box.value.value + box.tag.n
}
fun main: int {
    val Tagged = { n: int -> n * 3 }
    val explicit = choose<string>(a = 1)
    val contextual: Tagged<string> = choose(a = 2)
    val contextualInt: Tagged<int> = choose(a = 3)
    val box = Box<string>(value = "x")
    val inferred = Box(value = "y")
    val positional = Box("z")
    val bag = Bag("x", 0)
    val typed: Tagged<string> = bag.typed(a = 1)
    val order = dependent(c = mark(1), a = mark(2))
    if (explicit.n != 1) return 11
    if (contextual.n != 1 || contextualInt.n != 1) return 12
    if (box.tag.n != 2 || inferred.tag.n != 2 || positional.tag.n != 2) return 13
    if (bag.item(a = 1) != 2) return 14
    if (bag.other(a = "x") != 2) return 15
    if (typed.n != 3) return 16
    if (bag.bump(a = 1) != 2) return 17
    if (bag.count != 1 || bag.capture(a = 1) != 2) return 18
    if (order != 4) return 19
    if (trace != 123) return 20
    if (Tagged(1) != 3) return 21
    val owned = resourceCase()
    if (owned == 42 && drops == 40) 0 else 2
}
