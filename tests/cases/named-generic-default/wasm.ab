var trace = 0
fun mark(n: int): int { trace = trace * 10 + n; n }
class Tagged<T>(val n: int)
class Bag<T>(val value: T) {
    fun get(a: int, b: Tagged<T> = Tagged<T>(mark(3))): int = a + b.n
}
fun <T> f(a: T, b: Tagged<T> = Tagged<T>(mark(2))): int = b.n
@export("checks")
fun checks(): int {
    trace = 0
    val Tagged = { n: int -> n * 10 }
    val first = f(a = "x")
    val second = Bag("y").get(a = 1)
    if (first == 2 && second == 4 && trace == 23 && Tagged(1) == 10) 0 else 1
}
