// A local, parameter or loop name shadows a constructor of the same name only
// where it is in scope; elsewhere a short call still gets the defaults.
class FloatMaker(val value: int = 7)
class Pair(val a: int, val b: int = 2)
fun pick(Pair: () -> int): int = Pair()
fun main: int {
    if (FloatMaker().value != 7) return 1
    if (true) {
        val FloatMaker = { -> 15 }
        if (FloatMaker() != 15) return 2
    }
    // Back out of that block, the constructor and its default again.
    if (FloatMaker().value != 7) return 3
    val tenfold = { Pair: int -> Pair * 10 }
    if (tenfold(2) != 20) return 4
    if (pick({ -> 9 }) != 9) return 5
    if (Pair(1).b != 2) return 6
    for (Pair in [3]) if (Pair != 3) return 7
    val Pair = { x: int -> x + 100 }
    if (Pair(1) != 101) return 8
    0
}
