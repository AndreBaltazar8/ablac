// A delegated property rules out the default wrapper: generic defaults are
// spelled with the call's explicit type arguments, even under a shadowing local.
class Tagged<T>(val n: int)
class Pair<A, B>(val a: int)
class Slot<T>(var value: T) { fun getValue(): T = value }
class Box<T, U>(
    val n: int,
    val tag: Tagged<T> = Tagged<T>(2),
    val pair: Pair<U, Tagged<T>> = Pair<U, Tagged<T>>(3),
    val saved: int by Slot(1)
)
fun main: int {
    val box = Box<string, Map<string, int>>(1)
    if (box.tag.n != 2 || box.pair.a != 3 || box.saved != 1) return 1
    val Tagged = { n: int -> n * 10 }
    val named = Box<int, bool>(n = 4)
    if (named.tag.n != 2 || named.n != 4 || Tagged(1) != 10) return 2
    0
}
