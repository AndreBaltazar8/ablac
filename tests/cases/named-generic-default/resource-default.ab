var made = 0
var drops = 0
resource class Ticket(val value: int) { fun drop(): void { drops = drops + value } }
fun makeTicket(): Ticket { made = made + 1; Ticket(7) }
class Tagged<T>(val n: int)
class Box<T>(val n: int, val ticket: Ticket = makeTicket(), val tag: Tagged<T> = Tagged<T>(2))
fun call(): int {
    val Tagged = { n: int -> n * 10 }
    val box = Box<string>(n = 1)
    box.ticket.value + box.tag.n + Tagged(0)
}
fun main: int { val result = call(); if (result == 9 && made == 1 && drops == 7) 0 else 1 }
