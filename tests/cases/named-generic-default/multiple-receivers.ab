class Tagged<T>(val n: int)
class Bag<T>(val value: T) {
    fun <U> get(a: int, b: Tagged<U> = Tagged<U>(3)): int = a + b.n
}
class Sack<T>(val value: T) {
    fun <U> get(a: int, b: Tagged<U> = Tagged<U>(3)): int = a + b.n
}
fun main: int {
    val Tagged = { n: int -> n * 10 }
    if (Bag("a").get<string>(a = 1) == 4 && Sack("b").get<string>(a = 2) == 5 && Tagged(1) == 10) 0 else 1
}
