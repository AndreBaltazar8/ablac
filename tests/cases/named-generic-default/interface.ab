class Tagged<T>(val n: int)
interface Thing<T> { fun get(a: int, b: Tagged<T> = Tagged<T>(3)): int }
class Bag<T>(val value: T) : Thing<T> {
    fun get(a: int, b: Tagged<T> = Tagged<T>(3)): int = a + b.n
}
fun run(item: Thing<string>): int { val Tagged = { n: int -> n }; item.get(a = 1) + Tagged(0) }
fun main: int = if (run(Bag("x")) == 4) 0 else 1
