// Random bytes on WebAssembly with no cryptoSetRandom: the host's source (abla_host.random, random_get on WASI), and a failing host fails the call.
import "abla/crypto/rsa"
import "abla/crypto/p256"
import "abla/sys/linux/random"

@export("draw")
fun draw(count: int): int = cryptoRandomBytes(count).size

@export("secure")
fun secure(count: int): int {
    val r = secureRandomBytes(count)
    if (r.succeeded) r.bytes.size else 0 - r.errorCode
}

@export("keygen")
trusted fun keygen(): int {
    val key = p256GeneratePrivateKey()
    if (key.ok) key.bytes.size else -1
}
