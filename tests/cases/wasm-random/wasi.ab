// The same for a WASI module: exit 0 when 32 random bytes came, 7 when the call failed (and then no bytes at all).
import "abla/crypto/rsa"
import "abla/sys/linux/random"

fun main: int {
    val a = cryptoRandomBytes(32)
    val s = secureRandomBytes(32)
    if (a.size == 32 && s.succeeded && a != s.bytes) return 0
    if (a.size == 0 && !s.succeeded) return 7
    return 9
}
