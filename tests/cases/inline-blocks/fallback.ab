import "abla/io"

@inline fun invoke(n: int, block: (int) -> int): int = block(n)
@inline fun forward(block: (int) -> int): (int) -> int = block
@noinline fun dynamic(n: int, block: (int) -> int): int = block(n)

fun captured(n: int): int = invoke(4) { x -> n + x }

fun main {
    val held = forward { n: int -> n * 2 }
    val plain = dynamic(6) { n -> n - 2 }
    println("${captured(5)} ${held(7)} $plain")
}
