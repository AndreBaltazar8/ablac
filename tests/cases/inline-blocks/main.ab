import "abla/io"

@inline fun transform(n: int, block: (int) -> int): int = block(n) + block(n + 1)
@inline fun combine(a: int, b: int, block: (int, int) -> int): int = block(a, b)

fun main {
    val first = transform(5) { n -> n * 2 }
    val second = transform(5) { n -> n + 20 }
    val third = combine(2, 9) { a, b -> a * b }
    println("$first $second $third")
}
