import "abla/io"

@inline fun collect(values: array<int>, transform: (int) -> int): array<int> {
    val result: array<int> = []
    for (value in values) result.append(transform(value))
    result
}

fun triple(value: int): int = value * 3

fun main {
    val source: array<int> = []
    for (index in 0 until 8) source.append(index)
    val output = collect(source) { value -> triple(value) }
    println("${output[1]} ${output[6]} ${source[6]}")
}
