// JSON results under mutation: valid documents and thousands of variants
// (truncated, a byte replaced, a byte inserted; a 40 KB one cut and changed at
// spread positions), each parsed, read with the
// object and array readers (readRaw and skip), under six sets of limits. One
// line per input (with the argument "full"): every error's code and position
// (jsonValidate's and jsonDocument's too, when they differ from jsonParse's, or
// when the document's nodes don't read as the tree),
// and a hash of the messages, the trees' stringified text and the raw slices;
// without it, a hash of each block of 10 such lines. The expected output was
// recorded before the readers' and the parser's fast paths existed: they must
// decide, report and produce exactly what the plain code did.
import "abla/io"
import "abla/float/text"
import "abla/json"
import "abla/process/arguments"
import "abla/text"

fun differentialHash(hash: int, text: string): int {
    var result = hash
    for (byte in text) result = (result ^ byte) * 1099511628211
    (result ^ 255) * 1099511628211
}

fun differentialError(code: string, offset: int): string =
    if (code.size == 0) "ok" else "$code@$offset"

// Whether a document's node reads as jsonParse's tree: kind, size, scalars,
// every element, and every member by position and by key.
fun differentialSame(node: JsonNode, value: Json): bool {
    if (node.kind() != value.kind || node.size() != value.size()) return false
    if (value.kind == 1) {
        return node.asString() == value.asString() && node.utf16Length() == differentialUtf16(value)
    }
    if (value.kind == 2) {
        val left = node.asNumber()
        val right = value.asNumber()
        return left.text == right.text && left.integer == right.integer &&
            left.intValue == right.intValue && left.intAvailable == right.intAvailable &&
            node.asInt() == value.asInt() && node.intAvailable() == value.intAvailable()
    }
    if (value.kind == 3) return node.asBoolean() == value.asBoolean()
    var index = 0
    while (index < value.size()) {
        if (!differentialSame(node.at(index), value.at(index))) return false
        if (value.kind == 5) {
            val key = value.keys[index]
            if (node.keyAt(index) != key || !node.has(key) ||
                !differentialSame(node.get(key), value.get(key))) return false
        }
        index = index + 1
    }
    if (!differentialCursor(node, value)) return false
    !node.has("\u0000missing") && node.at(value.size()).kind() == 0 && !node.at(value.size()).exists()
}

// A string's UTF-16 length from its text (0 for anything else).
fun differentialUtf16(value: Json): int {
    if (value.kind != 1) return 0
    var units = 0
    for (byte in value.stringValue) {
        if (byte < 128 || (byte >= 192 && byte < 240)) units = units + 1
        else if (byte >= 240) units = units + 2
    }
    units
}

// A cursor over the node's elements or members reads each as the tree's.
fun differentialCursor(node: JsonNode, value: Json): bool {
    var cursor = if (value.kind == 4) node.elements() else node.members()
    var index = 0
    while (cursor.next()) {
        if (index >= value.size()) return false
        val item = value.at(index)
        if (cursor.kind() != item.kind || cursor.size() != item.size() ||
            cursor.asString() != item.asString() || cursor.asInt() != item.asInt() ||
            cursor.intAvailable() != item.intAvailable() || cursor.asBoolean() != item.asBoolean() ||
            cursor.asNumber().text != item.asNumber().text ||
            cursor.utf16Length() != differentialUtf16(item) ||
            (item.kind == 2 && cursor.asF64() != f64ParseRange(item.asNumber().text, 0, item.asNumber().text.size)) ||
            cursor.node().raw() != cursor.raw()) return false
        if (value.kind == 5 && (cursor.key() != value.keys[index] || !cursor.keyIs(value.keys[index]))) {
            return false
        }
        index = index + 1
    }
    index == value.size() && !cursor.next()
}

// One object's edits, on keys and values as jsonParse's object holds them: set
// replaces the last member's value or appends; delete removes every member.
fun differentialSet(var keys: array<string>, var values: array<Json>, key: string, value: Json): void {
    var last = -1
    var index = 0
    while (index < keys.size) {
        if (keys[index] == key) last = index
        index = index + 1
    }
    if (last >= 0) values[last] = value
    else {
        keys.append(key)
        values.append(value)
    }
    return
}

fun differentialDelete(keys: array<string>, values: array<Json>, key: string): array<int> {
    val kept: array<int> = []
    var index = 0
    while (index < keys.size) {
        if (keys[index] != key) kept.append(index)
        index = index + 1
    }
    kept
}

// The edit script, on every even-numbered object (in document order) below 60:
// set the first key (the last member with it, when it repeats), add a key and
// an object keyed by array indexes, delete the second key, set and delete a
// key, delete the added key and set it again.
fun differentialScript(ordinal: int): bool = ordinal % 2 == 0 && ordinal < 60

fun differentialEditTree(value: Json, var counter: array<int>): Json {
    if (value.kind == 4) {
        val values: array<Json> = []
        for (element in value.values) values.append(differentialEditTree(element, counter))
        return Json(4, "", 0, false, [], values, value.numberValue)
    }
    if (value.kind != 5) return value
    val ordinal = counter[0]
    counter[0] = ordinal + 1
    var keys: array<string> = []
    var values: array<Json> = []
    for (key in value.keys) keys.append(key)
    for (element in value.values) values.append(differentialEditTree(element, counter))
    if (differentialScript(ordinal)) {
        val first = if (value.keys.size > 0) value.keys[0] else "k0"
        val second = if (value.keys.size > 1) value.keys[1] else "none"
        differentialSet(keys, values, first, jsonBoolean(true))
        differentialSet(keys, values, "added", jsonString("a\u0001b\u00e9"))
        differentialSet(keys, values, "7", jsonObject(["b", "2", "1"], [jsonInteger(1), jsonInteger(2), jsonInteger(3)]))
        for (step in 0 until 3) {
            val key = if (step == 0) second else if (step == 1) "tmp" else "added"
            if (step == 1) differentialSet(keys, values, "tmp", jsonInteger(1))
            val kept = differentialDelete(keys, values, key)
            val keptKeys: array<string> = []
            val keptValues: array<Json> = []
            for (index in kept) {
                keptKeys.append(keys[index])
                keptValues.append(values[index])
            }
            keys = keptKeys
            values = keptValues
        }
        differentialSet(keys, values, "added", jsonNull())
    }
    Json(5, "", 0, false, keys, values, value.numberValue)
}

fun differentialEditNode(var edits: JsonEdits, node: JsonNode, var counter: array<int>): void {
    if (node.kind() == 4) {
        var index = 0
        while (index < node.size()) {
            differentialEditNode(edits, node.at(index), counter)
            index = index + 1
        }
        return
    }
    if (node.kind() != 5) return
    val ordinal = counter[0]
    counter[0] = ordinal + 1
    if (differentialScript(ordinal)) {
        val first = if (node.size() > 0) node.keyAt(0) else "k0"
        val second = if (node.size() > 1) node.keyAt(1) else "none"
        edits.set(node, first, jsonBoolean(true))
        edits.set(node, "added", jsonString("a\u0001b\u00e9"))
        edits.set(node, "7", jsonObject(["b", "2", "1"], [jsonInteger(1), jsonInteger(2), jsonInteger(3)]))
        edits.delete(node, second)
        edits.set(node, "tmp", jsonInteger(1))
        edits.delete(node, "tmp")
        edits.delete(node, "added")
        edits.set(node, "added", jsonNull())
    }
    var index = 0
    while (index < node.size()) {
        differentialEditNode(edits, node.at(index), counter)
        index = index + 1
    }
    return
}

// JavaScript's key order, applied by the test: keys that are array indexes ("0",
// or digits without a leading zero, below 4294967295) first, ascending, then
// the others in their order.
fun differentialIndex(key: string): int {
    if (key.size == 0 || key.size > 10 || (key.size > 1 && key[0] == 48)) return -1
    var value = 0
    for (byte in key) {
        if (byte < 48 || byte > 57) return -1
        value = value * 10 + byte - 48
    }
    if (value < 4294967295) value else -1
}

fun differentialJsOrder(value: Json): Json {
    if (value.kind == 4) {
        val values: array<Json> = []
        for (element in value.values) values.append(differentialJsOrder(element))
        return Json(4, "", 0, false, [], values, value.numberValue)
    }
    if (value.kind != 5) return value
    val keys: array<string> = []
    val values: array<Json> = []
    val taken: array<bool> = []
    for (key in value.keys) taken.append(false)
    // Index keys, smallest first (the first of equal ones first).
    var more = true
    while (more) {
        var best = -1
        var index = 0
        while (index < value.keys.size) {
            val number = differentialIndex(value.keys[index])
            if (!taken[index] && number >= 0 &&
                (best < 0 || number < differentialIndex(value.keys[best]))) best = index
            index = index + 1
        }
        if (best < 0) more = false
        else {
            taken[best] = true
            keys.append(value.keys[best])
            values.append(differentialJsOrder(value.values[best]))
        }
    }
    var index = 0
    while (index < value.keys.size) {
        if (!taken[index]) {
            keys.append(value.keys[index])
            values.append(differentialJsOrder(value.values[index]))
        }
        index = index + 1
    }
    Json(5, "", 0, false, keys, values, value.numberValue)
}

// The document written back (as jsonStringify writes jsonParse's tree), and with
// the edit script (as jsonStringify writes the tree with it applied).
fun differentialEmits(document: JsonDocument, value: Json): bool {
    if (document.emit() != jsonStringify(value)) return false
    val ordered = jsonStringify(differentialJsOrder(value))
    if (document.emit(true) != ordered || jsonStringify(document.root().toJson(true)) != ordered ||
        jsonStringify(jsonJsKeyOrder(value)) != ordered) return false
    var edits = document.edits()
    differentialEditNode(edits, document.root(), [0])
    val editedTree = differentialEditTree(value, [0])
    val expected = jsonStringify(editedTree)
    val expectedOrdered = jsonStringify(differentialJsOrder(editedTree))
    edits.emit() == expected && jsonStringify(edits.toJson()) == expected &&
        edits.emit(true) == expectedOrdered && jsonStringify(edits.toJson(true)) == expectedOrdered
}

fun differentialParse(input: string, limits: JsonLimits): string {
    val parsed = jsonParse(input, limits)
    var hash = differentialHash(-3750763034362895579, parsed.error.message)
    hash = differentialHash(hash, jsonStringify(parsed.value))
    val error = parsed.error
    // jsonValidate decides and reports exactly as jsonParse: any difference is
    // in the line, so it can't hash as recorded.
    val checked = jsonValidate(input, limits)
    val other = checked.error
    val agrees = checked.succeeded == parsed.succeeded && other.code == error.code &&
        other.message == error.message && other.byteOffset == error.byteOffset &&
        other.line == error.line && other.column == error.column && checked.value.isNull()
    val validate = if (agrees) "" else " V ${other.code}@${other.byteOffset}:${other.line}:${other.column} ${other.message}"
    // jsonDocument too, and its nodes read as the tree does.
    val document = jsonDocument(input, limits)
    val third = document.error
    var documented = document.succeeded == parsed.succeeded && third.code == error.code &&
        third.message == error.message && third.byteOffset == error.byteOffset &&
        third.line == error.line && third.column == error.column
    if (documented && parsed.succeeded) {
        val root = document.document.root()
        documented = jsonStringify(root.toJson()) == jsonStringify(parsed.value) &&
            differentialSame(root, parsed.value) && root.raw().size > 0 &&
            differentialEmits(document.document, parsed.value)
    }
    val tape = if (documented) "" else " D ${third.code}@${third.byteOffset}"
    "P ${differentialError(error.code, error.byteOffset)}:${error.line}:${error.column} $hash$validate$tape"
}

fun differentialObject(input: string, limits: JsonLimits): string {
    var reader = jsonObjectReader(input, limits)
    var hash = -3750763034362895579
    var members = 0
    while (members < 1000) {
        val key = reader.next()
        if (reader.done || reader.state.errorCode.size > 0) break
        hash = differentialHash(hash, key)
        if (members % 2 == 0) hash = differentialHash(hash, reader.readRaw())
        else reader.skip()
        members = members + 1
    }
    reader.finish()
    val state = reader.state
    hash = differentialHash(hash, state.errorMessage)
    "O ${differentialError(state.errorCode, state.errorOffset)} $members $hash"
}

fun differentialArray(input: string, limits: JsonLimits): string {
    var reader = jsonArrayReader("[" + input + "]", limits)
    var hash = -3750763034362895579
    var items = 0
    while (items < 1000 && reader.next()) {
        if (items % 2 == 0) hash = differentialHash(hash, reader.readRaw())
        else reader.skip()
        items = items + 1
    }
    reader.finish()
    val state = reader.state
    hash = differentialHash(hash, state.errorMessage)
    "A ${differentialError(state.errorCode, state.errorOffset)} $items $hash"
}

fun differentialMembers(count: int, repeat: bool): string {
    val parts: array<string> = []
    var index = 0
    while (index < count) {
        parts.append("\"m$index\":$index")
        index = index + 1
    }
    if (repeat) parts.append("\"m3\":0")
    "{" + textJoin(parts, ",") + "}"
}

// A 40 KB document of records: keys, strings and numbers that repeat, many
// distinct ones, escapes, literals, nesting.
fun differentialLarge(): string {
    val parts: array<string> = []
    var index = 0
    while (index < 400) {
        parts.append("{\"id\":$index,\"p\":[${index % 7},-12.5,${index * 3}],\"c\":\"#a8b4c${index % 3}\",\"t\":\"k${index % 300}\",\"x\":\"esc\\n$index\",\"f\":true,\"n\":null}")
        index = index + 1
    }
    "{\"name\":\"large\",\"items\":[" + textJoin(parts, ",") + "]}"
}

fun differentialDocuments(): array<string> {
    val accent = "\u00e9"
    [
        "{\"a\":1,\"b\":[true,false,null],\"c\":{\"d\":\"e\\\"f\\\\g\\/h\\b\\f\\n\\r\\t\",\"u\":\"\\u00e9\\ud83d\\ude00\"},\"n\":-0.5e+3}",
        "[1,-2,3.25,1e10,-0,0.0,1E-7,123456789012345678901234,9223372036854775807,-9223372036854775808]",
        "{\"k\":\"v\",\"k\":\"w\",\"\":[]}",
        " \n{ \"x\" : [ 1 , { } , [ ] , \"\" ] ,\r\n \"y\" :\tnull } \t",
        "\"plain $accent text \u6f22\u5b57 \\u0041\"",
        "[[[[[[[1,[2]]]]]]],{\"d\":{\"e\":{\"f\":{}}}}]",
        "{\"long\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"esc\":\"\\u0000\\u001f\\\"\"}",
        differentialMembers(20, true),
        differentialMembers(18, false),
        "[true,false,null,\"t\",\"\\/\",{\"a\":{\"a\":{\"a\":1}}}]",
        "{\"bad\":\"" + accent.slice(0, 1) + "\",\"ok\":2}",
        "[01,1.,.5,1e,-,+1,1e+,0x1]",
        "",
        "{}",
        "[]",
        "  ",
        "{\"a\":[{\"b\":[{\"c\":[1,2,{\"d\":\"\\ud800\"}]}]}]}",
        "{\"a\":1,\"b\":{\"x\":1,\"x\":2,\"y\":[{\"z\":1,\"z\":{\"q\":1,\"q\":2}}]},\"a\":3,\"b\":0}",
        "{\"b\":1,\"10\":2,\"a\":{\"3\":0,\"z\":1,\"0\":2},\"2\":4,\"01\":5,\"4294967294\":6,\"4294967295\":7,\"-1\":8,\"0\":9,\"2\":10}"
    ]
}

// Trees built directly, which a parse never gives: what jsonStringify writes for
// each (every control byte and the escapes, a long string, numbers jsonParse
// would refuse, a string that isn't UTF-8, keys and values of different counts,
// an unknown kind: those write "null"), as one hash.
fun differentialStringified(): int {
    var controls = ""
    var byte = 0
    while (byte < 128) {
        controls = controls + utf8Encode(byte)
        byte = byte + 1
    }
    val accent = "\u00e9"
    val long = "ab\"c".repeat(100)
    val number = jsonNumberText("12.5e-3")
    val values: array<Json> = [
        jsonString(controls),
        jsonString("plain $accent \u6f22"),
        jsonString(long),
        jsonString(""),
        number,
        Json(2, "", 0, false, [], [], JsonNumber("01", true, 1, true)),
        Json(2, "", 0, false, [], [], JsonNumber("", false, 0, false)),
        Json(1, accent.slice(0, 1), 0, false, [], [], number.numberValue),
        Json(5, "", 0, false, ["a", "b"], [jsonNull()], number.numberValue),
        Json(9, "", 0, false, [], [], number.numberValue),
        jsonArray([]),
        jsonObject([], []),
        jsonArray([jsonArray([jsonObject(["k\n", ""], [jsonBoolean(false), jsonInteger(-7)])]), jsonNull()]),
        jsonObject(["x", "x", "y"], [jsonInteger(1), jsonString("\u0001"), jsonArray([jsonBoolean(true)])]),
        jsonArray([jsonInteger(1), Json(1, accent.slice(0, 1), 0, false, [], [], number.numberValue)]),
        jsonObject(["\u0000"], [jsonObject(["\""], [jsonString("\\")])])
    ]
    var hash = -3750763034362895579
    for (value in values) hash = differentialHash(hash, jsonStringify(value))
    hash
}

fun main: int {
    val strict = jsonDefaultLimits()
    val small = JsonLimits(4096, 4, 40, 8, 3, true)
    val open = JsonLimits(2147483647, 256, 2147483647, 2147483647, 2147483647, false)
    val tight = JsonLimits(4096, 64, 12, 1048576, 10000, false)
    val merged = JsonLimits(4096, 64, 100000, 1048576, 3, false, true)
    val limitSets = [strict, small, open, tight, merged, jsonPermissiveLimits]
    val bytes = ["\"", "\\", ",", ":", "[", "]", "{", "}", "0", "-", "+", ".", "e", "t", "n", " ", "\n", "x", "u", "/", "\u00e9".slice(0, 1)]
    val inputs: array<string> = []
    // The large document: whole, and cut or changed at every 211th byte.
    val large = differentialLarge()
    inputs.append(large)
    var cut = 0
    while (cut < large.size) {
        inputs.append(large.slice(0, cut))
        val byte = bytes[(cut / 211) % bytes.size]
        inputs.append(large.slice(0, cut) + byte + large.slice(cut + 1, large.size))
        cut = cut + 211
    }
    for (document in differentialDocuments()) {
        inputs.append(document)
        var position = 0
        while (position <= document.size) {
            inputs.append(document.slice(0, position))
            if (position < document.size) {
                var choice = 0
                while (choice < 3) {
                    val byte = bytes[(position * 7 + choice * 5) % bytes.size]
                    inputs.append(document.slice(0, position) + byte + document.slice(position + 1, document.size))
                    choice = choice + 1
                }
                val inserted = bytes[(position * 3) % bytes.size]
                inputs.append(document.slice(0, position) + inserted + document.slice(position, document.size))
            }
            position = position + 1
        }
    }
    var full = false
    for (position in 0 until processArgumentCount()) {
        if (processArgument(position) == "full") full = true
    }
    println("stringified ${differentialStringified()}")
    var index = 0
    var block = -3750763034362895579
    for (input in inputs) {
        var line = "$index"
        var set = 0
        for (limits in limitSets) {
            line = "$line | $set ${differentialParse(input, limits)} ${differentialObject(input, limits)} ${differentialArray(input, limits)}"
            set = set + 1
        }
        if (full) println(line)
        block = differentialHash(block, line)
        index = index + 1
        if (index % 10 == 0 || index == inputs.size) {
            if (!full) println("${(index - 1) / 10 * 10} $block")
            block = -3750763034362895579
        }
    }
    0
}
