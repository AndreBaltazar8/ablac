import "abla/runtime/scalar"
trusted fun liftKind(value: any): int = ablaRuntimeLoadI32(ablaRuntimeValueAddress(value) + 4)
// Only the low 32 bits belong to an f32; native and lifted values may differ
// in the unused upper half of the payload word (zero vs sign extension).
trusted fun liftBits(value: any): int = if (liftKind(value) == 1)
    ablaRuntimeValueWord0(value) & 4294967295 else ablaRuntimeValueWord0(value)
fun liftSame(left: any, right: any): bool = liftKind(left) == liftKind(right) && liftBits(left) == liftBits(right)
fun liftElement(value: any, index: int): any = __ablaRuntimeIndexGet(value, index)
