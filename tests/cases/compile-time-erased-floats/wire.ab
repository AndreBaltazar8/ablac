// The decoder rejects old wire/cache records instead of guessing float kinds.
import "../../../src/ct_lift.ab"
fun main: int {
    val functions = bootstrapCtNoFunctions()
    if (bootstrapCtLiftDecode("i1;", "any", [], functions).ok) return 1
    if (bootstrapCtLiftDecode("V1;i1;", "any", [], functions).ok) return 2
    if (bootstrapCtLiftDecode("V3;i1;", "any", [], functions).ok) return 3
    val integer = bootstrapCtLiftDecode("V2;i4609434218613702656;", "any", [], functions)
    if (!integer.ok || integer.value.kind != "integer" || integer.value.integer != 4609434218613702656) return 4
    val wide = bootstrapCtLiftDecode("V2;d-9223372036854775808;", "any", [], functions)
    if (!wide.ok || wide.value.kind != "f64" || wide.value.integer != -9223372036854775808) return 5
    val narrow = bootstrapCtLiftDecode("V2;f2143289345;", "any", [], functions)
    if (!narrow.ok || narrow.value.kind != "f32" || narrow.value.integer != 2143289345) return 6
    val legacyTyped = bootstrapCtLiftDecode("V2;i4609434218613702656;", "f64", [], functions)
    if (!legacyTyped.ok || legacyTyped.value.kind != "f64") return 7
    val cycle = bootstrapCtLiftDecode("V2;a2;d1;r0;", "array<any>", [], functions)
    if (!cycle.ok || cycle.value.elements[0].kind != "f64" || cycle.value.elements[1] != cycle.value) return 8
    if (bootstrapCtLiftDecode("V2;d1;garbage", "any", [], functions).ok) return 9
    0
}
