// Compare representations, not formatting or the intentionally bitwise any equality.
import "abla/runtime/fixtures/inspect"
import "abla/float"
class FloatFields(val typed: f64, val narrow: f32, val erased: any, val optional: f64?)
fun erased64(): any = 1.5
fun erased32(): any = f64ToF32(2.25)
fun mixed(): array<any> = [
    1.5,
    f64ToF32(2.25),
    4609434218613702656,
    -0.0,
    f64FromBits(1),
    f64FromBits(9218868437227405313),
    f64FromBits(9218868437227405312),
    f64FromBits(-4503599627370496),
    f64FromBits(-2251799813685248),
    ablaBitI32ToF32(1),
    ablaBitI32ToF32(-2147483648),
    ablaBitI32ToF32(2139095040),
    ablaBitI32ToF32(-8388608),
    ablaBitI32ToF32(2143289345),
    0.0,
    ablaBitI32ToF32(0),
    0,
    f64FromBits(4503599627370495),
    f64FromBits(4503599627370496),
    ablaBitI32ToF32(8388607),
    ablaBitI32ToF32(8388608),
    ablaBitI32ToF32(2139095041)
]
fun dense(): array<f64> = [1.5, -0.0, f64FromBits(1)]
fun erasedDense(): any = dense()
fun erasedNested(): any = [[1.5, -0.0], [f64FromBits(1)]]
fun erasedSingles(): any = [
    ablaBitI32ToF32(-2147483648), ablaBitI32ToF32(2143289345),
    ablaBitI32ToF32(0), ablaBitI32ToF32(8388607), ablaBitI32ToF32(8388608)
]
fun nested(): array<array<any>> = [[1.5, 7], [f64ToF32(2.25)]]
fun fields(): FloatFields = FloatFields(1.5, f64ToF32(2.25), 3.5, -0.0)
fun dictionary(): Map<string, any> {
    val values: Map<string, any> = Map()
    values.set("float", 1.5)
    values.set("integer", 4609434218613702656)
    values
}
fun capture(): () -> any {
    val value: any = 1.5
    { -> value }
}
fun typed(): f64 = f64FromBits(9218868437227405313)
val SCALAR64 = #erased64()
val SCALAR32 = #erased32()
val MIXED = #mixed()
val DENSE = #dense()
val ERASED_DENSE = #erasedDense()
val ERASED_NESTED = #erasedNested()
val ERASED_SINGLES = #erasedSingles()
val NESTED = #nested()
val FIELDS = #fields()
val DICTIONARY = #dictionary()
val CAPTURE = #capture()
val TYPED = #typed()
fun liftChecks(): array<bool> {
    val checks: array<bool> = []
    checks.append(liftSame(SCALAR64, erased64()))
    checks.append(liftSame(SCALAR32, erased32()))
    val expected = mixed()
    var matching = true
    for (index in 0 until expected.size) matching = matching && liftSame(MIXED[index], expected[index])
    checks.append(matching)
    checks.append(liftSame(MIXED[2], 4609434218613702656))
    checks.append(f64ToBits(DENSE[0]) == 4609434218613702656 && f64ToBits(DENSE[1]) == -9223372036854775808 && f64ToBits(DENSE[2]) == 1)
    checks.append(liftSame(liftElement(ERASED_DENSE, 0), 1.5) && liftSame(liftElement(ERASED_DENSE, 1), -0.0) && liftSame(liftElement(ERASED_DENSE, 2), f64FromBits(1)))
    checks.append(liftSame(liftElement(liftElement(ERASED_NESTED, 0), 1), -0.0) && liftSame(liftElement(liftElement(ERASED_NESTED, 1), 0), f64FromBits(1)))
    checks.append(liftSame(liftElement(ERASED_SINGLES, 0), ablaBitI32ToF32(-2147483648)) && liftSame(liftElement(ERASED_SINGLES, 1), ablaBitI32ToF32(2143289345)))
    checks.append(liftSame(NESTED[0][0], 1.5) && liftSame(NESTED[1][0], f64ToF32(2.25)))
    checks.append(liftSame(FIELDS.typed, 1.5) && liftSame(FIELDS.narrow, f64ToF32(2.25)) && liftSame(FIELDS.optional, -0.0))
    checks.append(liftSame(FIELDS.erased, 3.5))
    checks.append(liftSame(DICTIONARY.get("float"), 1.5) && liftSame(DICTIONARY.get("integer"), 4609434218613702656))
    checks.append(liftSame(CAPTURE(), 1.5))
    checks.append(f64ToBits(TYPED) == 9218868437227405313)
    checks
}

fun liftCheckNames(): array<string> = ["scalar64", "scalar32", "mixed", "integer-lookalike", "dense", "erased-dense", "erased-nested", "erased-singles", "nested", "typed-fields", "erased-field", "map", "capture", "typed-nan"]
