// Compare representations, not formatting or the intentionally bitwise any equality.
import "abla/runtime/fixtures/inspect"
import "abla/float"
import "abla/io"
class FloatFields(val typed: f64, val narrow: f32, val erased: any, val optional: f64?)
fun erased64(): any = 1.5
fun erased32(): any = f64ToF32(2.25)
fun mixed(): array<any> = [1.5, f64ToF32(2.25), 4609434218613702656, -0.0, f64FromBits(1), f64FromBits(9218868437227405313), f64FromBits(9218868437227405312), f64FromBits(-4503599627370496), f64FromBits(-2251799813685248), ablaBitI32ToF32(1), ablaBitI32ToF32(-2147483648), ablaBitI32ToF32(2139095040), ablaBitI32ToF32(-8388608), ablaBitI32ToF32(2143289345)]
fun dense(): array<f64> = [1.5, -0.0, f64FromBits(1)]
fun erasedDense(): any = dense()
fun nested(): array<array<any>> = [[1.5, 7], [f64ToF32(2.25)]]
fun fields(): FloatFields = FloatFields(1.5, f64ToF32(2.25), 3.5, -0.0)
fun dictionary(): Map<string, any> {
    val values: Map<string, any> = Map()
    values.set("float", 1.5)
    values.set("integer", 4609434218613702656)
    values
}
fun capture(): () -> any {
    val value: any = 1.5
    { -> value }
}
fun typed(): f64 = f64FromBits(9218868437227405313)
val SCALAR64 = #erased64()
val SCALAR32 = #erased32()
val MIXED = #mixed()
val DENSE = #dense()
val ERASED_DENSE = #erasedDense()
val NESTED = #nested()
val FIELDS = #fields()
val DICTIONARY = #dictionary()
val CAPTURE = #capture()
val TYPED = #typed()
fun report(name: string, ok: bool): void { println("$name:${if (ok) "pass" else "mismatch"}") }
fun main: int {
    report("scalar64", liftSame(SCALAR64, erased64()))
    report("scalar32", liftSame(SCALAR32, erased32()))
    val expected = mixed()
    var matching = true
    for (index in 0 until expected.size) matching = matching && liftSame(MIXED[index], expected[index])
    report("mixed", matching)
    report("integer-lookalike", liftSame(MIXED[2], 4609434218613702656))
    report("dense", f64ToBits(DENSE[0]) == 4609434218613702656 && f64ToBits(DENSE[1]) == -9223372036854775808 && f64ToBits(DENSE[2]) == 1)
    report("erased-dense", liftSame(liftElement(ERASED_DENSE, 0), 1.5) && liftSame(liftElement(ERASED_DENSE, 1), -0.0) && liftSame(liftElement(ERASED_DENSE, 2), f64FromBits(1)))
    report("nested", liftSame(NESTED[0][0], 1.5) && liftSame(NESTED[1][0], f64ToF32(2.25)))
    report("typed-fields", liftSame(FIELDS.typed, 1.5) && liftSame(FIELDS.narrow, f64ToF32(2.25)) && liftSame(FIELDS.optional, -0.0))
    report("erased-field", liftSame(FIELDS.erased, 3.5))
    report("map", liftSame(DICTIONARY.get("float"), 1.5) && liftSame(DICTIONARY.get("integer"), 4609434218613702656))
    report("capture", liftSame(CAPTURE(), 1.5))
    report("typed-nan", f64ToBits(TYPED) == 9218868437227405313)
    0
}
