// Two function values are equal through `any` only when they call the same
// function. Exits with the first failing check.
fun one(): int = 1
fun two(): int = 2

fun main(): int {
    val first: () -> int = one
    val again: () -> int = one
    val second: () -> int = two
    val firstAny: any = first
    val againAny: any = again
    val secondAny: any = second
    if (firstAny == secondAny) return 1
    if (firstAny != againAny) return 2
    if (!(firstAny != secondAny)) return 3
    return 0
}
