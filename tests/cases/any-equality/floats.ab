// A float compared through `any` equals only a float of the same kind and
// bits, never an integer with the same payload. Exits with the first failing
// check.
fun main(): int {
    val float: any = 1.5
    val sameFloat: any = 1.5
    val bits: any = 4609434218613702656
    val sameBits: any = 4609434218613702656
    if (float == bits) return 1
    if (float != sameFloat) return 2
    if (bits != sameBits) return 3
    if (!(float != bits)) return 4
    return 0
}
