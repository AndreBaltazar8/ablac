// A float compared through `any` equals only a float of the same kind, never an
// integer with the same payload, and compares as typed `==` does: a NaN equals
// nothing and 0.0 equals -0.0. The f64 checks also run in the compile-time
// evaluator. Exits with the first failing check, plus 20 when it failed at
// compile time.
import "abla/float"

fun wideChecks(): int {
    val float: any = 1.5
    val sameFloat: any = 1.5
    val bits: any = 4609434218613702656
    val sameBits: any = 4609434218613702656
    val zero: f64 = 0.0
    val nan: any = zero / zero
    val positiveZero: any = 0.0
    val negativeZero: any = -0.0
    if (float == bits) return 1
    if (float != sameFloat) return 2
    if (bits != sameBits) return 3
    if (!(float != bits)) return 4
    if (nan == nan) return 5
    if (positiveZero != negativeZero) return 6
    return 0
}

fun singleChecks(): int {
    val float: any = 1.5
    val single: any = f32(1.5)
    val sameSingle: any = f32(1.5)
    val singleZero: any = f32(0.0)
    val singleNegativeZero: any = f32(-0.0)
    val zero: f32 = f32(0.0)
    val singleNan: any = zero / zero
    if (single != sameSingle) return 7
    if (single == float) return 8
    if (singleZero != singleNegativeZero) return 9
    if (singleNan == singleNan) return 10
    return 0
}

compile fun wideChecksAtCompileTime(): int = wideChecks()

val COMPILED = #wideChecksAtCompileTime()

fun main(): int {
    val wide = wideChecks()
    val single = singleChecks()
    return if (wide != 0) wide else if (single != 0) single
        else if (COMPILED != 0) 20 + COMPILED else 0
}
