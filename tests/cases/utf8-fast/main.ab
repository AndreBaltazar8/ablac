// string.isValidUtf8 with an eight-bytes-at-a-time ASCII path against a validator written here (RFC 3629: shortest forms, no surrogates, nothing above U+10FFFF): strings of every length
// up to 40 made of ASCII with one sequence at every offset (so one that starts and ends in the middle of an eight-byte word, or straddles two words): the valid two-, three- and
// four-byte forms and their boundaries, overlong forms, surrogates, too-large values, stray continuation bytes, truncated sequences at the end; and random strings. Prints "utf8-fast ok".
import "abla/io"
import "abla/bytes"
import "abla/text"

var failures = 0
var seed = 9

fun next(): int {
    seed = (seed * 1103515245 + 12345) & 2147483647
    (seed >> 16) & 255
}

fun fail(what: string): void {
    failures = failures + 1
    if (failures < 30) println("FAIL $what")
    return
}

fun bytesOf(values: array<int>): string {
    val buffer = byteBuffer()
    for (value in values) buffer.appendByteValue(value)
    buffer.toText()
}

fun reference(values: array<int>): bool {
    var i = 0
    while (i < values.size) {
        val b = values[i]
        if (b < 128) { i = i + 1; continue }
        var need = 0
        var low = 128
        var high = 191
        if (b >= 194 && b <= 223) need = 1
        else if (b == 224) { need = 2; low = 160 }
        else if (b >= 225 && b <= 236) need = 2
        else if (b == 237) { need = 2; high = 159 }
        else if (b >= 238 && b <= 239) need = 2
        else if (b == 240) { need = 3; low = 144 }
        else if (b >= 241 && b <= 243) need = 3
        else if (b == 244) { need = 3; high = 143 }
        else return false
        if (i + need >= values.size) return false
        if (values[i + 1] < low || values[i + 1] > high) return false
        for (k in 2 until need + 1) if (values[i + k] < 128 || values[i + k] > 191) return false
        i = i + need + 1
    }
    true
}

fun check(what: string, values: array<int>): void {
    val text = bytesOf(values)
    if (text.isValidUtf8() != reference(values)) fail("$what: size ${values.size}, first byte ${if (values.size > 0) values[0] else -1} is ${text.isValidUtf8()}")
    return
}

fun main: int {
    val sequences: array<array<int>> = [
        [194, 128], [223, 191], [224, 160, 128], [239, 191, 191], [237, 159, 191], [240, 144, 128, 128], [244, 143, 191, 191],
        [192, 128], [193, 191], [224, 159, 191], [237, 160, 128], [237, 191, 191], [240, 143, 191, 191], [244, 144, 128, 128], [245, 128, 128, 128], [248, 136, 128, 128, 128],
        [128], [191], [194], [224, 160], [240, 144, 128], [255], [254], [226, 130, 172], [240, 159, 152, 128], [195, 40], [226, 40, 161]
    ]
    for (length in 0 until 41) {
        for (sequence in sequences) {
            for (position in 0 until 41) {
                if (position + sequence.size > length) break
                val values: array<int> = []
                for (i in 0 until length) values.append(97 + (i * 5 + position) % 26)
                for (i in 0 until sequence.size) values[position + i] = sequence[i]
                check("length $length position $position", values)
            }
        }
        val plain: array<int> = []
        for (i in 0 until length) plain.append(32 + i % 95)
        check("plain $length", plain)
    }
    for (round in 0 until 20000) {
        val values: array<int> = []
        val count = next() % 24
        for (i in 0 until count) {
            val kind = next() % 10
            if (kind < 6) values.append(32 + next() % 95)
            else if (kind == 6) { values.append(195); values.append(128 + next() % 64) }
            else if (kind == 7) { values.append(226); values.append(130); values.append(128 + next() % 64) }
            else values.append(next())
        }
        check("random $round", values)
    }
    if (failures > 0) return 1
    println("utf8-fast ok")
    0
}
