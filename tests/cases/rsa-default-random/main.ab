// An RSA private key loads and signs with the target's own random source, without cryptoSetRandom: the load's consistency
// check and every private operation blind with random bytes. A guard on x86-64 alone made them fail on Apple Silicon
// and AArch64 Linux (the pure TLS server of the macOS host test could not load its key). Exit status 42 is success.
import "abla/crypto/rsa"
import "abla/text"

val pem = "-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQDKC8b+TLhaOZod\nwhFxWySxCRhb6Tzrzehr4OuoH6YfkVZ1kuqePirwwMUeRQWWYVl+r9+D3QIra774\nsPf1pw4Ul2sRy46T3h+Yzv1sIp2ZF+efyFRymddaq1wG5YAkSfwghXBI4+ZpNpSc\nduHZUztN2sWKwgyAHym+OmTFMQ047RrKzConvYmbJGrEYMDfUX3SPQN84n8G5w19\nghifP+Z2mZZ7i3NBdWppQa5Na9irztEdYHufLEtbhvxPFqMy5mJWNj1kFYj1R8rr\nHee/YJjseM5+9zK7FmSm1tp7K0mbMCUCVx+rEKBUmYkNKg6LLlHbFwTiT47TeMB5\nTA7pUgpRAgMBAAECggEABshEU6S2J7syxlunIIr0QJtP5ysj0yOSl4Deadw3UQYP\n/nriNGuQUljnCD5w/7lzwS1Jf41Ti95LGke9Tx1eoa5sI7w75HbqnYNnRBiMxnow\n5lVzQw4q4z2I2MEExYZHqyM0X97PzRZ0TYtIRtzeV9CN9iI2iRxJF0kx0q4nZdKw\n014PsmUZVri9/7fFn1819lsdoJRjPQq7n9dGMiitCWP+7el7At12Bk0kKqLi+liK\naKUE4s2cpLO1iHqZQdLdJWwHHOBVg/+dfD1z9z0r8PvUngbBYUmocJDVIuiu1OTm\n5P+zH95l0ZRH7NLU3jlnASOXk1tY5Uv9tp4J8jQQlQKBgQD3bXwv4U3Cw9rBGKaG\nVrivVyLLwEY8rp4o07l8HJOhbbiy2HaFNUqgJ6Z9uNR3zr/t0Zc5CGz4Pm6YOVL0\neoEVzFpElfuvQoC/jjEVoksnOEM+Y1ZLiUlCM/r7InLecEONI3k84DpTPXNPKrUB\n8X6OY9ruNyWYPiOIAjmS+oOXvQKBgQDRC8mnhUHoM2ZSR1AENW0Q+fetJSJ5UxGs\n7sEMkTvO2Gh7kdvAJzbCcNraB6FyvscJd0Td3A+qEpNScIDL+l37qOcrCLuE3RE3\n1+h8RWl2gOCk/q+DG9OxxjWepF+pTdp7bjmP92uWwj+fX3gABT3WbbvbZcciDvde\ntrfun9VMJQKBgA/gIYC89w1RHb8YAs9Jzy3I7H2gR6FrHtDFzPfuqXZJIPmws+IW\nKkSeZqtYaaGKTXxH32kUZlGDR/tSakUvewrYAs61xOFY5gPkbrfRovrQPFhLbWUJ\nWP77cNYePrqQ/3SV2xiR1owyvCxPNC/8u78NHyX7udjL2+HFKsaIdlsNAoGAJBud\nIUprL+hw7BVVROTVifEjTszzP3GRxAUZY0pSwk+u/GkdQ/uCAePsaWyX/nHlf0US\nqB+ytPWwbLTyCkmcojNyeoRvn2tv5e1tQsnahZWNN/Kl7keIMVTDPju2KlBARMGt\nP6jE9K1ov+aFm7tMCxW5NRRHaSKcp8d3zcfd1+ECgYA8OOasGE/MVJF8aB4LvmXK\n/wW+bCBKbN21LrWD9sDWEf5hpMQdEfAVdfEtQ7KFTMtRfQTu3kyIaXWLHCOHuY4U\nR6zkCYqM75lrxYPBvXkv9UMeBth9SikZQ0bA1DoxA5a2cNzHBn4C8SNenIWJtIIa\n8pXdP+RMDIpKG4H4v+4yjA==\n-----END PRIVATE KEY-----\n"

fun main: int {
    val key = rsaPrivateKeyFromPem(pem)
    if (!key.ok()) return 1
    val probe = "\x01".repeat(key.modulus.size - 1)
    val signed = rsaPrivateOperation(key, probe)
    if (!signed.ok || signed.bytes.size != key.modulus.size) return 2
    42
}
