// OpenSSL's BIO_new_mem_buf takes the length of a PEM as a C int: a text of 2 GiB or more would reach it as a negative number (read to
// the first NUL) or as its low 32 bits (a prefix): the class of CVE-2026-121481 (a size computed in an int). tlsClientIdentityFromPem
// refuses one before it makes a BIO. The text is a rope of 2^31 + bytes: the refusal reads only its size, and a version that reads
// its bytes first flattens it (2 GiB), which the run's memory cap (tools/test-hosted-bio-limit.sh) turns into a failure.
import "abla/io"
import "abla/tls/hosted"

fun main: int {
    var pad = "-"
    while (pad.size < 2147483700) pad = pad + pad
    val identity = tlsClientIdentityFromPem(pad, "key")
    if (identity.error == "") {
        println("FAIL: a PEM of ${pad.size} bytes was accepted")
        return 1
    }
    println("hosted bio limit ok: ${identity.error}")
    0
}
