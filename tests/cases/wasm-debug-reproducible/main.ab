import "shapes.ab" as shapes
// Its helpers are private, so their names carry the library's module prefix.
import "abla/date"

fun total(count: int): int {
    val all: array<shapes.Shape> = []
    var index = 0
    while (index < count) {
        all.append(shapes.shapeOf(3 + index))
        index = index + 1
    }
    var sum = 0
    for (shape in all) sum = sum + shapes.perimeter(shape, 2)
    sum
}

fun main: int =
    if (total(4) == 36 && utcIso8601(86400000) == "1970-01-02T00:00:00.000Z") 0 else 1
