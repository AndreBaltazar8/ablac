import "shapes.ab" as shapes

fun total(count: int): int {
    val all: array<shapes.Shape> = []
    var index = 0
    while (index < count) {
        all.append(shapes.shapeOf(3 + index))
        index = index + 1
    }
    var sum = 0
    for (shape in all) sum = sum + shapes.perimeter(shape, 2)
    sum
}

fun main: int = if (total(4) == 36) 0 else 1
