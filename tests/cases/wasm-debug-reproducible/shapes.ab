// Imported under an alias, so its names are rewritten with its module's
// prefix before parsing.
class Shape(val sides: int)

fun shapeOf(sides: int): Shape = Shape(sides)

fun perimeter(shape: Shape, length: int): int = sideTotal(shape.sides, length)

// Private, so its name is prefixed too; its debug name is the one written here.
private fun sideTotal(sides: int, length: int): int = sides * length
