// A class that refers to itself, and two that refer to each other, hold no resource unless a field's class is one
// (bootstrapCtMayHoldResource searches each class once): the global stays the interpreter's ordinary global, not
// "it holds resources" (tools/test-ct-resource-deep.sh).
import "abla/io"

class Node(var value: int, var children: array<Node>, var parent: Node?)
class Ping(var other: Pong?, var n: int)
class Pong(var other: Ping?, var n: int)

private var registry: array<Node> = []
private var pings: array<Ping> = []

fun work(): int {
    val root = Node(5, [], null)
    root.children.append(Node(7, [], root))
    registry.append(root)
    pings.append(Ping(Pong(null, 2), 3))
    registry[0].children[0].value + registry[0].value + pings[0].n
}

val COMPILED = #work()

fun main: int {
    println("${work()} $COMPILED")
    0
}
