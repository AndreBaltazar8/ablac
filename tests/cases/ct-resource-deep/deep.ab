// A resource held eight classes down is still a resource (bootstrapCtMayHoldResource): the global's type N0 reaches
// Handle only through N1 .. N7. The search used to stop at depth 6 and answer "no", so this global was taken for plain
// data; with a closure in the resource class its site then stayed in the interpreter ("which native code cannot hand
// back"; with one site alone reaching it the closure rule (#1022) hid that, so two sites reach it here). It is the
// generation's for the pass now, as a global of a resource class itself is
// (tools/test-ct-resource-deep.sh).
import "abla/io"

var dropped: int = 0

resource class Handle(var id: int, val describe: () -> string) {
    fun drop(): void {
        dropped = dropped + 1
        return
    }
}

class N7(var handle: Handle, var tag: int)
class N6(var next: N7, var tag: int)
class N5(var next: N6, var tag: int)
class N4(var next: N5, var tag: int)
class N3(var next: N4, var tag: int)
class N2(var next: N3, var tag: int)
class N1(var next: N2, var tag: int)
class N0(var next: N1, var tag: int)

var chain: array<N0> = []

fun work(): string {
    chain = []
    chain.append(N0(N1(N2(N3(N4(N5(N6(N7(Handle(42, { -> "deep" }), 7), 6), 5), 4), 3), 2), 1), 0))
    "${chain.size}:${chain[0].next.next.next.next.next.next.next.handle.id}:${chain[0].next.next.next.next.next.next.next.handle.describe()}"
}

val COMPILED = #work()
val AGAIN = #work()

fun main: int {
    println("${work()} $COMPILED $AGAIN")
    0
}
