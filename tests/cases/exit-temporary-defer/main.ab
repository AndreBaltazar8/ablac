import "abla/io"

var log: string = ""
resource class Item(val id: int) {
    fun drop(): void { log = log + "I$id" }
}
resource class Holder(val item: Item) {
    fun drop(): void { log = log + "H" }
}
resource class Local {
    fun drop(): void { log = log + "L" }
}
fun use(x: Item, n: int): int = n
fun returned(): int { defer { log = log + "D" }; return Holder(Item(1)).item.id }
fun nested(): int {
    defer { log = log + "O" }
    if (true) {
        defer { log = log + "N" }
        return Holder(Item(2)).item.id
    }
    0
}
fun nestedArgument(): int {
    defer { log = log + "O" }
    return use(Holder(Item(7)).item, if (true) {
        defer { log = log + "N" }
        return 3
    } else 0)
}
fun defaulted(x: int = Holder(Item(3)).item.id): int {
    val local = Local()
    defer { log = log + "D" }
    return x
}
fun loop(): void {
    for (i in 0 until 3) {
        defer { log = log + "D$i" }
        use(Holder(Item(4 + i)).item, if (i == 0) { continue } else { break })
    }
}
fun exercise(): string {
    log = ""
    returned(); log = log + "|"
    nested(); log = log + "|"
    nestedArgument(); log = log + "|"
    defaulted(); log = log + "|"
    loop(); log = log + "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
