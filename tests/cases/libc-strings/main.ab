// The Abla side of tools/test-libc-strings.sh (#1139 area 14): the static libc's string functions (src/static_libc/string.ab and ctypestr.ab,
// copied without their @export lines to build/libc-strings/libc) on the cases tests/cases/libc-strings/strings.c writes, printed as that program
// prints the host C library's results.
import "abla/io"
import "abla/integer"
import "abla/text"
import "abla/runtime/scalar"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "./libc/string.ab"
import "./libc/ctypestr.ab"
import "./libc/fs.ab"

fun number(text: string): int {
    val parsed = text.parseInt()
    if (parsed != null) parsed else 0
}

fun hexValue(c: int): int = if (c >= 97) c - 87 else if (c >= 65) c - 55 else c - 48

fun hexByte(b: int): string {
    val digits = "0123456789abcdef"
    digits.slice(b >> 4, (b >> 4) + 1) + digits.slice(b & 15, (b & 15) + 1)
}

// The bytes of `hex` at a new NUL-terminated block of `room` bytes (raw memory: the functions keep pointers into it).
trusted fun cString(hex: string, room: int): int {
    val count = hex.size / 2
    val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(room))
    for (i in 0 until count) ablaRuntimeStoreU8(address + i, hexValue(hex[2 * i]) * 16 + hexValue(hex[2 * i + 1]))
    ablaRuntimeStoreU8(address + count, 0)
    address
}

trusted fun hexOf(address: int): string {
    var text = ""
    var at = 0
    while (ablaRuntimeLoadU8(address + at) != 0) {
        text = text + hexByte(ablaRuntimeLoadU8(address + at))
        at = at + 1
    }
    text
}

fun sign(value: int): int = if (value < 0) -1 else if (value > 0) 1 else 0

fun offset(found: int, base: int): int = if (found == 0) -1 else found - base

trusted fun run(fields: array<string>): string {
    val name = fields[0]
    val a = cString(fields[1], 64)
    val b = cString(fields[2], 160)
    val count = number(fields[3])
    val byte = number(fields[4])
    if (name == "strlen") return "${libcStrlen(a)}"
    if (name == "strcmp") return "${sign(libcInt(libcStrcmp(a, b)))}"
    if (name == "strncmp") return "${sign(libcInt(libcStrncmp(a, b, count)))}"
    if (name == "strcasecmp") return "${sign(libcInt(libcStrcasecmp(a, b)))}"
    if (name == "strncasecmp") return "${sign(libcInt(libcStrncasecmp(a, b, count)))}"
    if (name == "strcoll") return "${sign(libcInt(libcStrcoll(a, b)))}"
    if (name == "strchr") return "${offset(libcStrchr(a, byte), a)}"
    if (name == "strrchr") return "${offset(libcStrrchr(a, byte), a)}"
    if (name == "memchr") return "${offset(libcMemchr(a, byte, count), a)}"
    if (name == "memrchr") return "${offset(libcMemrchr(a, byte, count), a)}"
    if (name == "strnlen") return "${libcStrnlen(a, count)}"
    if (name == "strspn") return "${libcStrspn(a, b)}"
    if (name == "strcspn") return "${libcStrcspn(a, b)}"
    if (name == "strpbrk") return "${offset(libcStrpbrk(a, b), a)}"
    if (name == "strstr") return "${offset(libcStrstr(a, b), a)}"
    if (name == "strncat") return hexOf(libcStrncat(b, a, count))
    if (name == "strndup") return hexOf(libcStrndup(a, count))
    "?"
}

fun main: int {
    var running = true
    while (running) {
        val line = readInputLine()
        if (!line.available) running = false
        else if (line.text.size > 0) println(run(line.text.split("\t")))
    }
    0
}
