// A global whose class may hold closures, reached by one site alone, is native for the pass (#1022: abla-forge's
// `engineApp: App`, whose schedules hold the systems): the site's one evaluation starts from the initializer in either
// tier, and the program's own copy is untouched.
import "abla/io"

class Schedule(var systems: array<() -> int>, var runs: int)

class App(var schedules: array<Schedule>, var started: bool)

var app: App = App([Schedule([], 0), Schedule([], 0)], false)

compile fun runApp(): int {
    for (step in 1..3) {
        app.schedules[step % 2].systems.append({ -> step * 7 })
    }
    app.started = true
    var total = 0
    for (schedule in app.schedules) {
        for (system in schedule.systems) total = total + system()
        schedule.runs = schedule.runs + 1
    }
    total
}

val ran = #runApp()

fun main(): int {
    println("$ran ${app.schedules[0].systems.size} ${app.started}")
    0
}
