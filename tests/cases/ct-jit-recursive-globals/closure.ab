// A recursive class with a function field still may hold a closure (#972): the seen-set must not turn that into "no".
// The global of its type keeps its site in the interpreter, as before.
import "abla/io"

class Handler(val name: string, val run: () -> int, var next: Handler?)

var handlers: array<Handler> = []

compile fun site(): int {
    handlers.append(Handler("a", { -> 3 }, null))
    handlers.size + 3
}

val staged = #site()

fun main(): int {
    println("$staged ${handlers.size}")
    0
}
