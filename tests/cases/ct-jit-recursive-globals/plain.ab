// A recursive class with plain fields may hold no closure (#972). The search for a closure used to stop at depth 6 and
// answer "may hold one", so every recursive class (the compiler's own BootstrapDeclaration, a tree node, a linked
// list) made the ordinary global of its type keep its site in the interpreter. Each class is searched once now.
import "abla/io"

class Node(var value: int, var children: array<Node>, var parent: Node?)

var registry: array<Node> = []

compile fun site(): int {
    val root = Node(5, [], null)
    root.children.append(Node(7, [], root))
    registry.append(root)
    registry[0].children[0].value + registry[0].value
}

val staged = #site()

fun main(): int {
    println("$staged ${registry.size}")
    0
}
