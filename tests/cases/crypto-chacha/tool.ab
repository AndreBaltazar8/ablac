// abla/crypto/chacha20poly1305 on the command line, hex in and hex out, for peer.mjs:
//   tool seal KEY NONCE PLAINTEXT AAD    tool open KEY NONCE SEALED AAD
//   tool xor KEY NONCE COUNTER DATA      tool poly KEY MESSAGE
// "-" stands for an empty argument. Exits 1 with the reason on stderr-less stdout when the call fails.
import "abla/io"
import "abla/crypto"
import "abla/crypto/chacha20poly1305"
import "abla/process/arguments"
import "abla/integer"

fun argument(index: int): string {
    val value = processArgument(index)
    if (value == "-") "" else hexDecode(value)
}

fun report(result: CryptoResult): int {
    if (!result.ok) {
        println("error ${result.error}")
        return 1
    }
    println(hexEncode(result.bytes))
    0
}

fun main: int {
    val mode = processArgument(0)
    if (mode == "seal") return report(chaCha20Poly1305Seal(argument(1), argument(2), argument(3), argument(4)))
    if (mode == "open") return report(chaCha20Poly1305Open(argument(1), argument(2), argument(3), argument(4)))
    if (mode == "xor") return report(chaCha20Xor(argument(1), (processArgument(3).parseInt() ?? 0), argument(2), argument(4)))
    if (mode == "poly") return report(poly1305(argument(1), argument(2)))
    println("error unknown mode")
    2
}
