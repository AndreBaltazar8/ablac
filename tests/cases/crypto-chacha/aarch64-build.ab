// The known answers as an AArch64 Linux object (linked by the test with ../simd/aarch64-start.s).
import "abla/build"
import "abla/compiler"

#compilerGrant("filesystem.write")

compile fun chachaAarch64Object(): bool {
    val target = defineTarget("linux-arm64-object", "aarch64-unknown-linux-gnu", "elf", "none", "none", false, false)
    target && buildProgram(
        "chacha-aarch64", "object.ab", "../../../build/crypto-chacha/aarch64.o", "linux-arm64-object",
        "object", false, false
    )
}

val built = #chachaAarch64Object()

fun main: int = if (built) 0 else 1
