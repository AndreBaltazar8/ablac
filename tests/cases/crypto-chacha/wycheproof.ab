// Wycheproof's ChaCha20-Poly1305 vectors (tests/vectors/crypto/wycheproof/chacha20_poly1305_test.json, as
// published) through abla/crypto/chacha20poly1305: a valid case seals to the vector's ciphertext and tag and opens to
// its message; an invalid one (a changed tag, a nonce of another length) is refused. Exit 1 on any failure.
// Usage: wycheproof VECTORS_DIRECTORY
import "abla/io"
import "abla/crypto"
import "abla/crypto/chacha20poly1305"
import "abla/json"
import "abla/process/arguments"
import "abla/sys/linux"

var failures = 0

fun fail(number: int, why: string): void {
    failures = failures + 1
    if (failures < 40) println("FAIL test $number: $why")
    return
}

fun main: int {
    val parsed = jsonParse(linuxReadFile("${processArgument(0)}/wycheproof/chacha20_poly1305_test.json", 16777216))
    if (!parsed.succeeded) {
        println("FAIL the JSON did not parse: ${parsed.error.message}")
        return 1
    }
    var count = 0
    var valid = 0
    val groups = parsed.value.get("testGroups")
    for (g in 0 until groups.size()) {
        val tests = groups.at(g).get("tests")
        for (t in 0 until tests.size()) {
            val test = tests.at(t)
            val number = test.getInt("tcId")
            val key = hexDecode(test.getString("key"))
            val iv = hexDecode(test.getString("iv"))
            val aad = hexDecode(test.getString("aad"))
            val message = hexDecode(test.getString("msg"))
            val sealed = hexDecode(test.getString("ct")) + hexDecode(test.getString("tag"))
            val result = test.getString("result")
            val opened = chaCha20Poly1305Open(key, iv, sealed, aad)
            if (result == "valid") {
                valid = valid + 1
                val made = chaCha20Poly1305Seal(key, iv, message, aad)
                if (!made.ok || made.bytes != sealed) fail(number, "sealing: ${test.getString("comment")}")
                if (!opened.ok || opened.bytes != message) fail(number, "opening: ${test.getString("comment")}")
            } else if (result == "invalid") {
                if (opened.ok) fail(number, "an invalid one was opened: ${test.getString("comment")}")
            } else fail(number, "result $result")
            count = count + 1
        }
    }
    println("wycheproof chacha20-poly1305: $count tests ($valid valid), failures $failures")
    if (failures == 0) 0 else 1
}
