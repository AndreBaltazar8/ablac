import "abla/archive/tar"
import "abla/compression/gzip"
import "abla/fs"
import "abla/process/arguments"
fun main(): int {
    val packed = Path(processArgument(0)).readText()
    val decoded = gzipDecompress(packed, 80000000)
    if (decoded.error != "") return 1
    val archive = tarRead(decoded.data, TarLimits(80000000, 1024, 80000000, 80000000))
    if (archive.error != "" || archive.entries.size != 18) return 2
    var files = 0
    var directories = 0
    var bytes = 0
    for (entry in archive.entries) {
        if (entry.kind == "file") files += 1
        else if (entry.kind == "directory") directories += 1
        bytes += entry.size
    }
    if (files == 13 && directories == 5 && bytes == 72350478) 0 else 3
}
