import "abla/archive/tar"
import "abla/bytes"
import "abla/fs"
import "abla/process/arguments"
import "abla/text"

fun validEntry(entry: TarEntry, archive: string): bool = entry.offset >= 0 && entry.size >= 0 &&
    entry.offset <= archive.size && entry.size <= archive.size - entry.offset &&
    entry.path != "" && !entry.path.startsWith("/") &&
    (entry.kind == "file" || entry.kind == "directory")

fun main(): int {
    val input = Path(processArgument(0)).readText()
    val result = tarRead(input, TarLimits(100000000, 1000, 80000000, 80000000))
    if (result.error != processArgument(1)) return 1
    if (result.error != "") return 0
    if (result.entries.size == 0) return 2
    for (entry in result.entries) if (!validEntry(entry, result.input)) return 3
    if (processArgument(2) == "verify") {
        if (tarRead(input, TarLimits(input.size - 1, 1000, 80000000, 80000000)).error != "limit") return 9
        if (tarRead(input, TarLimits(100000000, 0, 80000000, 80000000)).error != "limit") return 10
        if (tarRead(input, TarLimits(100000000, 1000, 0, 80000000)).error != "limit") return 11
        if (tarRead(input, TarLimits(100000000, 1000, 80000000, 0)).error != "limit") return 12
        if (tarRead(input, TarLimits(-1, 1000, 80000000, 80000000)).error != "invalid") return 13
        var seen = false
        for (entry in result.entries) {
            if (entry.path == "root/file.txt") {
                if (entry.kind != "file" || result.input.slice(entry.offset, entry.offset + entry.size) != "payload\n") return 7
                seen = true
            }
        }
        if (!seen) return 8
    }
    if (processArgument(2) == "raw") {
        if (result.entries.size != 1 || result.entries[0].rawPath != "./root//file.txt" ||
            result.entries[0].path != "root/file.txt") return 14
    }
    if (processArgument(2) == "rawprefix") {
        val expected = "p".repeat(90) + "/" + "n".repeat(20)
        if (result.entries.size != 1 || result.entries[0].rawPath != expected ||
            result.entries[0].path != expected) return 15
    }
    if (processArgument(2) == "mutate") {
        var i = 0
        while (i < 4000) {
            val at = (i * 7919) % input.size
            val changed = input.slice(0, at) + byteEncode(input[at] ^ (1 << (i % 8))) + input.slice(at + 1, input.size)
            val altered = tarRead(changed, TarLimits(100000000, 1000, 80000000, 80000000))
            if (altered.error == "") {
                for (entry in altered.entries) if (!validEntry(entry, altered.input)) return 4
            } else if (altered.error != "invalid" && altered.error != "unsupported" && altered.error != "limit") return 5
            val shortened = tarRead(input.slice(0, at), TarLimits(100000000, 1000, 80000000, 80000000))
            if (shortened.error == "") {
                for (entry in shortened.entries) if (!validEntry(entry, shortened.input)) return 6
            }
            i += 1
        }
    }
    0
}
