// The raw-pointer scans of abla/http against their checked twins on generated bytes (#1139 area 4). httpParseRequest, httpRequestLineVersion and
// the query lookup have a native version (raw reads: what ordinary code and the JIT tier of the compile-time evaluator run) and a checked
// version (what the interpreter tier runs); both must give the same answer for any bytes. The program builds the same results at run time and at
// compile time (#), so building it under each ABLA_COMPILE_EVAL tier compares the two versions as well as the run-time one.
// Prints "http-native-scan ok" when every case agrees.
import "abla/io"
import "abla/text"
import "abla/http"
import "abla/bytes"

val TEMPLATES: array<string> = [
    "GET /a?b=c&d=e HTTP/1.1\r\nHost: x\r\nA: b\r\n\r\nbody",
    "POST /p/q?x=1&y=&=z&x=2 HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\nX-A:  v \r\n\r\nabcd",
    "GET /?a=b HTTP/1.0\r\n\r\n",
    "GET * HTTP/1.1\r\nHost: x\r\n\r\n",
    "GET http://h/p?q=1 HTTP/1.1\r\nHost: h\r\nA: b\r\n c\r\n\r\n",
    "OPTIONS /a%20b?c=%41&d=+ HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
    "GET /a HTTP/1.1\nHost: x\n\n",
    "GET /a?ab=1&abc=2&b=3 HTTP/1.1\r\nHost: x\r\n\r\n"]

val ALPHABET: array<int> = [32, 13, 10, 58, 63, 38, 61, 37, 43, 47, 0, 200, 9, 97, 98, 65, 49, 72, 84, 80, 46, 44, 255, 1, 127]
val NAMES: array<string> = ["a", "b", "ab", "abc", "x", "y", "", "c", "d", "q", "xyz", "a=b", "?", "A"]

fun next(state: int): int = (state * 6364136223846793005 + 1442695040888963407) & 9223372036854775807

// A template with 0 to 5 edits: a byte of the alphabet replaced, inserted or deleted, or the input cut short.
fun generate(index: int): string {
    var state = next(index * 7919 + 13)
    var text = TEMPLATES[(state >> 20) % TEMPLATES.size]
    state = next(state)
    val edits = (state >> 24) % 6
    for (e in 0 until edits) {
        state = next(state)
        if (text.size == 0) break
        val at = (state >> 16) % text.size
        state = next(state)
        val byte = ALPHABET[(state >> 22) % ALPHABET.size]
        state = next(state)
        val kind = (state >> 28) % 4
        val piece = byteText(byte)
        if (kind == 0) text = text.slice(0, at) + piece + text.slice(at + 1, text.size)
        else if (kind == 1) text = text.slice(0, at) + piece + text.slice(at, text.size)
        else if (kind == 2) text = text.slice(0, at) + text.slice(at + 1, text.size)
        else text = text.slice(0, at)
    }
    text
}

fun byteText(byte: int): string {
    val buffer = byteBuffer()
    buffer.appendByteValue(byte)
    buffer.toText()
}

fun render(input: string): string {
    val request = httpParseRequest(input)
    var out = request.method + "\u001f" + request.path + "\u001f" + request.query + "\u001f" + "${request.body.size}" + "\u001f" + "${httpRequestLineVersion(input, request, httpHeaderEnd(input))}"
    for (header in request.headers) out = out + "\u001e" + header.name + ":" + header.value
    for (name in NAMES) out = out + "\u001d" + request.queryParameter(name) + "\u001c" + request.parameter(name)
    out
}

fun cases(count: int): array<string> {
    val out: array<string> = []
    for (i in 0 until count) out.append(render(generate(i)))
    out
}

fun main: int {
    val count = 3000
    val live = cases(count)
    val staged = #cases(3000)
    var bad = 0
    if (live.size != staged.size) bad = 1
    for (i in 0 until (if (live.size < staged.size) live.size else staged.size)) {
        if (live[i] != staged[i]) {
            if (bad < 5) println("FAIL case ${i}: ${generate(i)}\n  run time:     ${live[i]}\n  compile time: ${staged[i]}")
            bad = bad + 1
        }
    }
    if (bad > 0) return 1
    println("http-native-scan ok")
    0
}
