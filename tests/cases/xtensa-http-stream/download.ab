import "abla/xtensa/companion/native"
import "abla/fs/secure"
import "abla/fs"
import "abla/crypto"
import "abla/process/arguments"
import "abla/sys/linux"
fun main(): int {
    val selection = nativeSelectCatalog(Path(processArgument(0)).readText(), "23.1.3-1",
        "x86_64-linux")
    if (selection.error != "") return 1
    val root = secureDirectory(processArgument(1))
    val output = root.createFile("live.tar.gz")
    if (output.descriptor < 0) return 2
    val error = nativeDownloadTo(selection.url, output, 120000)
    if (!output.close()) return 3
    if (error != "") { linuxWriteStandardError("download: $error\n"); return 4 }
    val input = root.openRegularFile("live.tar.gz")
    val hash = sha256Stream()
    var count = 0
    while (true) {
        val part = input.readChunk(65536)
        if (part.error != "") return 5
        hash.update(part.data)
        count += part.data.size
        if (part.eof) break
    }
    if (hexEncode(hash.finish()) != selection.pins.archiveSha256) return 6
    linuxWriteStandardOutput("stream download hash verified: $count bytes\n")
    0
}
