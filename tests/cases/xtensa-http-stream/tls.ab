import "abla/xtensa/companion/httpstream"
import "abla/fs/secure"
import "abla/fs"
import "abla/process/arguments"
import "abla/sys/linux/process"
import "abla/sys/linux"
import "abla/tls/hosted"
fun decimal(text: string): int {
    var result = 0
    for (byte in text) { if (byte < 48 || byte > 57) return -1; result = result * 10 + byte - 48 }
    result
}
fun main(): int {
    val root = processArgument(0)
    val ca = processArgument(1)
    val port = decimal(processArgument(2))
    val parent = secureDirectory(root)
    val output = parent.createFile("response")
    val result = installerHttpsResponse("localhost", "/fixture", output, 1024, 3000,
        linuxMonotonicMilliseconds() + 5000, ca, port)
    if (!output.close()) return 1
    val body = Path("$root/response").readText()
    if (result.error != "" || result.status != 200 || body != "hello") {
        linuxWriteStandardError("TLS fixture port=$port status=${result.status} error=${result.error} body=$body tls=${tlsLastError()}\n")
        return 2
    }
    0
}
