import "abla/build"

// Model a target helper whose call is introduced after Abla reachability.
// It must be present in the object, but it is not a public ABI export.
fun lateRuntimeHelper(value: i32): i32 = value + i32(1)

#requiredInternalFunction(
    "lateRuntimeHelper",
    "abla_test_late_runtime_helper"
)

fun main: int = 0
