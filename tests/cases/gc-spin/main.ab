// A worker spins in a loop that allocates nothing (it waits on an atomic word) while main allocates garbage: every
// collection has to stop the worker, which only a safe point on the loop's back edge allows. Without it the stop waits its
// 20 ms, is abandoned, and the heap grows for as long as the worker spins (the program below would reach gigabytes).
import "abla/io"
import "abla/memory"
import "abla/process/time"
import "abla/runtime/memory"
import "abla/runtime/scalar"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun stopWord(): int = nativeStaticAllocate(8)

trusted fun spin(): int {
    val stop = stopWord()
    var count = 0
    while (ablaRuntimeAtomicLoadI64(stop) == 0) {
        count = count + 1
    }
    count
}

trusted fun main: int {
    val worker = thread { spin() }
    var kept = 0
    var round = 0
    while (round < 1500) {
        val garbage = "x".repeat(1000000)
        kept = kept + garbage.size % 7
        round = round + 1
    }
    val abandoned = runtimeMemoryHeapStat(8)
    val stopped = runtimeMemoryHeapStat(7)
    ablaRuntimeAtomicStoreI64(stopWord(), 1)
    await worker
    if (abandoned != 0 || stopped == 0 || kept != 1500) {
        println("FAIL: $stopped collections stopped the worker, $abandoned stops abandoned")
        return 1
    }
    println("gc spin ok: $stopped collections")
    0
}
