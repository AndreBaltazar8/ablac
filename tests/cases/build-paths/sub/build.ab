import "abla/compiler"

// Paths in a build call are read against this file's directory (decision #91 A), as imports are: child.ab is the one
// beside this file and the output lands in the repository's build/, whatever directory the build runs from.
val built = #compilerBuildProgram(
    "build-paths-child",
    "child.ab",
    "../../../../build/build-paths/child",
    "host",
    "executable",
    true,
    false
)

fun main: int = if (built) 0 else 1
