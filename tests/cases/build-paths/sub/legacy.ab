import "abla/compiler"

// An entry spelled from the working directory: run from the repository root, it is not next to this file, and since
// the v0.2.65 fallback went (#1044) the build fails, not reading it the old way.
val built = #compilerBuildProgram(
    "build-paths-legacy",
    "tests/cases/build-paths/sub/child.ab",
    "build/build-paths/legacy-child",
    "host",
    "executable",
    true,
    false
)

fun main: int = if (built) 0 else 1
