import "abla/compiler"

// The working-directory reading, kept for v0.2.65: run from the repository root, this entry is not next to the file
// but is there from the working directory, so both paths are read the old way, with W_BUILD_PATH_CWD.
val built = #compilerBuildProgram(
    "build-paths-legacy",
    "tests/cases/build-paths/sub/child.ab",
    "build/build-paths/legacy-child",
    "host",
    "executable",
    true,
    false
)

fun main: int = if (built) 0 else 1
