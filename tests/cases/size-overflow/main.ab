import "abla/io"
import "abla/process"
import "abla/text"

// Sizes that wrap: each case must end in a panic (exit 101) with its reason, never in a copy into a
// buffer sized by a wrapped total (tools/test-size-overflow.sh runs one case per argument).
fun doubled(times: int): string {
    var text = "ab"
    var round = 0
    while (round < times) {
        text = "$text$text"
        round = round + 1
    }
    text
}

fun main: int {
    val which = processArgument(0)
    if (which == "concat") {
        // 2^62 bytes as a rope, doubled once more: 2^63 wraps negative.
        println("${doubled(62).size}")
    } else if (which == "concat-sum") {
        // Two ropes of 2^61 and 2^61 + 2: the sum is over 2^62 and under 2^63.
        val big = doubled(60)
        println("${("$big$big$big").size}")
    } else if (which == "concat4") {
        // Four parts of 2^62 bytes: the sum is 2^64, which wraps to 0.
        val part = doubled(61)
        println("${"$part$part$part$part".size}")
    } else if (which == "repeat") {
        println("${"ab".repeat(4611686018427387904).size}")
    } else if (which == "pad") {
        println("${"x".padStart(4611686018427387905).size}")
    } else if (which == "filled") {
        // 2^61 numbers are 2^64 bytes: the size wraps to 24, and the fill loop wrote past the allocation.
        println("${filledArray(2305843009213693952, 0).size}")
    } else if (which == "filled-string") {
        println("${filledArray(768614336404564652, "x").size}")
    } else if (which == "filled-max") {
        println("${filledArray(9223372036854775807, true).size}")
    } else {
        // 2^61 bytes is still a string.
        println("${doubled(60).size}")
    }
    0
}
