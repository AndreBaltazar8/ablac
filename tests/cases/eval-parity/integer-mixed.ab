fun loop_i8N(): string {
    var v = i8((-128))
    var w = i8(64)
    var i = 0
    while (i < 70) {
        v += w
        w *= i8(3)
        v -= i8(7)
        w = w ^ v
        if (i % 5 == 0) v = v * v
        i = i + 1
    }
    "${v} ${w}"
}

