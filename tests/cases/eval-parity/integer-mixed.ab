fun loop_i8N(): string {
    var v = id_i8(i8((-128)))
    var w = id_i8(i8(64))
    var i = 0
    while (i < 70) {
        v += w
        w *= id_i8(i8(3))
        v -= id_i8(i8(7))
        w = w ^ v
        if (i % 5 == 0) v = v * v
        i = i + 1
    }
    "${v} ${w}"
}

