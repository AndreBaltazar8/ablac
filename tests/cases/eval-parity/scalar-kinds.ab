// char, nominal scalars and narrow fields/elements: the same results natively and under `#`.
// Hand-written (the generated suites are tools/gen-eval-parity.py); operands arrive as
// parameters so the native side runs its own lowering.
import "abla/io"

type Pin = u8
type Wide = i32
class Cell8(var v: i8, val w: u16)

fun nat(c: char, p: Pin, w: Wide, k8: i8, u: u32): array<string> {
    val out: array<string> = []
    out.append("char ${c + char(10)} ${c - char(251)} ${c * char(2)} ${c / char(7)} ${c % char(7)} ${c < char(251)}")
    out.append("char bits ${int(c)} ${int(c + char(10))} ${int(c * char(2))}")
    out.append("pin ${p + Pin(100)} ${p * Pin(2)} ${p - Pin(201)} ${p << Pin(1)} ${p >> Pin(3)}")
    out.append("wide ${w + Wide(1)} ${w * Wide(2)} ${-w} ${~w}")
    val k = Cell8(k8, u16(65535))
    k.v = k.v + i8(1)
    out.append("cell ${k.v} ${k.w + u16(1)} ${k.w * u16(65535)}")
    var m = i8(-128)
    m = m - k8 + i8(126)
    out.append("dec ${m} ${-m} ${m / (k8 - i8(128))} ${m % (k8 - i8(128))}")
    var x = u
    x += u32(2)
    out.append("u32 ${x} ${x - u32(5)} ${u32(0) - u32(1) + (u - u)} ${int(u)} ${i32(u)}")
    val arr = [u8(255) + u8(u - u), u8(1)]
    arr[0] = arr[0] + arr[1]
    out.append("arr ${arr[0]} ${arr[1] << u8(7)}")
    out
}

compile fun stg(c: char, p: Pin, w: Wide, k8: i8, u: u32): array<string> {
    val out: array<string> = []
    out.append("char ${c + char(10)} ${c - char(251)} ${c * char(2)} ${c / char(7)} ${c % char(7)} ${c < char(251)}")
    out.append("char bits ${int(c)} ${int(c + char(10))} ${int(c * char(2))}")
    out.append("pin ${p + Pin(100)} ${p * Pin(2)} ${p - Pin(201)} ${p << Pin(1)} ${p >> Pin(3)}")
    out.append("wide ${w + Wide(1)} ${w * Wide(2)} ${-w} ${~w}")
    val k = Cell8(k8, u16(65535))
    k.v = k.v + i8(1)
    out.append("cell ${k.v} ${k.w + u16(1)} ${k.w * u16(65535)}")
    var m = i8(-128)
    m = m - k8 + i8(126)
    out.append("dec ${m} ${-m} ${m / (k8 - i8(128))} ${m % (k8 - i8(128))}")
    var x = u
    x += u32(2)
    out.append("u32 ${x} ${x - u32(5)} ${u32(0) - u32(1) + (u - u)} ${int(u)} ${i32(u)}")
    val arr = [u8(255) + u8(u - u), u8(1)]
    arr[0] = arr[0] + arr[1]
    out.append("arr ${arr[0]} ${arr[1] << u8(7)}")
    out
}

fun main: int {
    val a = nat(char(250), Pin(200), Wide(2147483647), i8(127), u32(4294967295))
    val b = #stg(char(250), Pin(200), Wide(2147483647), i8(127), u32(4294967295))
    var bad = 0
    var i = 0
    while (i < a.size) {
        if (a[i] != b[i]) {
            bad = bad + 1
            println("native: ${a[i]}\nstaged: ${b[i]}")
        }
        i = i + 1
    }
    if (bad == 0 && a.size == b.size) 42 else 1
}
