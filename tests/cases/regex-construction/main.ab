import "abla/io"
import "abla/regex"

// A literal pattern with `.regex`: the fix is `$regex("...")`.
fun digits(text: string): bool = regexCompile("[0-9]+").regex.matches(text)

// A literal pattern with an escape: suggested, but no edit (the source text is not the pattern).
fun escaped(text: string): bool = regexCompile("\\d+").regex.matches(text)

// A literal pattern kept as the compile result: suggested, no edit (a RegexCompileResult is not a Regex).
fun checked(text: string): bool {
    val compiled = regexCompile("[a-z]+")
    if (!compiled.succeeded) return false
    compiled.regex.matches(text)
}

// A pattern known only at run time stays a regexCompile call and gets no suggestion.
fun dynamic(pattern: string, text: string): bool {
    val compiled = regexCompile(pattern)
    compiled.succeeded && compiled.regex.matches(text)
}

fun main {
    println("${digits("123")} ${escaped("45")} ${checked("abc")} ${dynamic("x+", "xx")}")
}
// output:
// true true true true
