import "abla/io"
var log: string = ""
resource class Item(val id: int) { fun drop(): void { log += "I$id" } }
fun items(): array<Item> = [Item(1), Item(2)]
fun mapping(): Map<string, Item> {
    val m: Map<string, Item> = Map()
    m.set("a", Item(1)); m.set("b", Item(2)); m
}
fun nested(): array<array<Item>> = [items()]
fun borrowed(): void { val m = mapping(); m.values(); log += "M" }
fun exercise(): string {
    log = ""
    items(); log += "|"
    mapping(); log += "|"
    nested(); log += "|"
    if (true) items() else items(); log += "|"
    borrowed(); log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
