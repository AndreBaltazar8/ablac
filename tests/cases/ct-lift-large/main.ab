// A `#` site whose native result is many objects, each a raw aggregate the compiler types back (ct_lift.ab's
// retyper). Typing each one searched every aggregate typed before it and every declaration of the program, so the
// lift took time growing with the square of the value: the game client's compile-time screenshot build spent minutes
// there after its sites had finished (#1022, 8418 declarations). The trace counts the declaration searches.
import "abla/io"

class Point(val x: int, val y: int)

fun points(count: int): array<Point> {
    val result: array<Point> = []
    var index = 0
    while (index < count) {
        result.append(Point(index, index * 3 % 7))
        index += 1
    }
    result
}

fun digest(values: array<Point>): string {
    var sum = 0
    for (point in values) sum = (sum * 31 + point.x + point.y) % 1000003
    "${values.size}:$sum"
}

val made = #points(2000)

fun main {
    println("${digest(points(2000))} ${digest(made)}")
}
