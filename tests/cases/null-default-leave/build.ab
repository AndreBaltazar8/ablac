// module.ab as a release and a development WebAssembly module (the release
// module registers the target; the development module reuses it).
import "abla/wasm/build"

val release = #wasmBuildModule(
    "shapes",
    "tests/cases/null-default-leave/module.ab",
    "build/null-default-leave/shapes.wasm",
    false,
    false
)
val development = #buildProgram(
    "shapes-dev",
    "tests/cases/null-default-leave/module.ab",
    "build/null-default-leave/shapes-dev.wasm",
    "wasm32-module",
    "module",
    true,
    false
)

fun main: int = if (release && development) 0 else 1
