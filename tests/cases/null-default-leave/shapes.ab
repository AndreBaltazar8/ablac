// `subject ?? return`, `?? break`, `?? continue` and `?? panic(…)` on string?,
// class?, array?, int? and f64? subjects, each a digest beside the same
// function written with an explicit null check (the reference): the value
// handed on keeps the subject's type, so `.size`, fields and arithmetic on it
// lower as on that type.
import "abla/process/exit"

class Box(val n: int)

fun maybeText(k: int): string? {
    if (k % 3 == 0) return null
    var out = ""
    var i = 0
    while (i < k) {
        out = out + "x"
        i += 1
    }
    out
}

fun maybeBox(k: int): Box? = if (k % 3 == 0) null else Box(k * 10)

fun maybeArray(k: int): array<int>? {
    if (k % 3 == 0) return null
    val values: array<int> = []
    var i = 0
    while (i < k) {
        values.append(i)
        i += 1
    }
    values
}

fun maybeInt(k: int): int? = if (k % 3 == 0) null else k * 7

fun maybeFloat(k: int): f64? = if (k % 3 == 0) null else 1.5

fun textReturn(k: int): int {
    val text = maybeText(k) ?? return -1
    text.size
}

fun boxReturn(k: int): int {
    val box = maybeBox(k) ?? return -2
    box.n
}

fun arrayReturn(k: int): int {
    val values = maybeArray(k) ?? return -3
    values.size
}

fun intReturn(k: int): int {
    val value = maybeInt(k) ?? return -4
    value + 1
}

fun floatReturn(k: int): int {
    val value = maybeFloat(k) ?? return -5
    if (value * 2.0 == 3.0) 6 else 7
}

// Without a local: the handed-on value used in place, as a receiver, an
// operand and an indexed array.
fun inPlace(k: int): int {
    return (maybeText(k) ?? return -6).size + (maybeBox(k) ?? return -7).n +
        (maybeInt(k) ?? return -8) + (maybeArray(k) ?? return -9)[0]
}

fun loops(n: int): int {
    var sum = 0
    var k = 0
    while (k < n) {
        k += 1
        val text = maybeText(k) ?? continue
        val box = maybeBox(k) ?? continue
        val values = maybeArray(k) ?? continue
        val value = maybeInt(k) ?? continue
        sum = sum + text.size + box.n + values.size + value
    }
    var next = 1
    while (true) {
        val text = maybeText(next) ?? break
        sum = sum * 3 + text.size
        next += 1
    }
    for (j in 0 until n) {
        val value = maybeInt(j) ?? continue
        val half = maybeFloat(j) ?? break
        sum = sum + value + (if (half == 1.5) 1 else 0)
    }
    sum
}

fun panics(k: int): int {
    val text = maybeText(k) ?? panic("no text")
    val box = maybeBox(k) ?? panic("no box")
    val values = maybeArray(k) ?? panic("no values")
    text.size + box.n + values.size
}

fun shapes(): int {
    var digest = loops(12)
    var k = 0
    while (k < 10) {
        digest = digest * 31 + textReturn(k)
        digest = digest * 31 + boxReturn(k)
        digest = digest * 31 + arrayReturn(k)
        digest = digest * 31 + intReturn(k)
        digest = digest * 31 + floatReturn(k)
        digest = digest * 31 + inPlace(k)
        if (k % 3 != 0) digest = digest * 31 + panics(k)
        k += 1
    }
    digest
}

// The same, with explicit null checks.
fun referenceLoops(n: int): int {
    var sum = 0
    var k = 0
    while (k < n) {
        k += 1
        val text = maybeText(k)
        if (text == null) continue
        val box = maybeBox(k)
        if (box == null) continue
        val values = maybeArray(k)
        if (values == null) continue
        val value = maybeInt(k)
        if (value == null) continue
        sum = sum + text.size + box.n + values.size + value
    }
    var next = 1
    while (true) {
        val text = maybeText(next)
        if (text == null) break
        sum = sum * 3 + text.size
        next += 1
    }
    for (j in 0 until n) {
        val value = maybeInt(j)
        if (value == null) continue
        val half = maybeFloat(j)
        if (half == null) break
        sum = sum + value + (if (half == 1.5) 1 else 0)
    }
    sum
}

fun reference(): int {
    var digest = referenceLoops(12)
    var k = 0
    while (k < 10) {
        val text = maybeText(k)
        val box = maybeBox(k)
        val values = maybeArray(k)
        val value = maybeInt(k)
        val half = maybeFloat(k)
        digest = digest * 31 + (if (text == null) -1 else text.size)
        digest = digest * 31 + (if (box == null) -2 else box.n)
        digest = digest * 31 + (if (values == null) -3 else values.size)
        digest = digest * 31 + (if (value == null) -4 else value + 1)
        digest = digest * 31 + (if (half == null) -5 else if (half * 2.0 == 3.0) 6 else 7)
        digest = digest * 31 + (
            if (text == null) -6 else if (box == null) -7 else if (value == null) -8
            else if (values == null) -9 else text.size + box.n + value + values[0]
        )
        if (k % 3 != 0 && text != null && box != null && values != null) {
            digest = digest * 31 + text.size + box.n + values.size
        }
        k += 1
    }
    digest
}
