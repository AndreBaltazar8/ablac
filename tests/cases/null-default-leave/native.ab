// shapes.ab natively and under `#` (the evaluator, or the native tier with
// ABLA_COMPILE_EVAL=jit): 42 when every form agrees with the reference.
import "shapes.ab"

val compiled = #shapes()
val compiledReference = #reference()

fun main(): int =
    if (shapes() == reference() && compiled == shapes() &&
        compiledReference == reference()) 42 else 1
