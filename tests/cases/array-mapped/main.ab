import "abla/array"
import "abla/io"

class Row(val label: string, val score: int)

fun main {
    val input = [2, 5, 3]
    val order: array<int> = []
    val numbers = input.mapped { value ->
        order.append(value)
        value * 2
    }
    val words = ["a", "bc"].mapped { word -> "$word!" }
    val rows = [Row("a", 4), Row("b", 8)].mapped { row -> Row(row.label, row.score + 1) }
    val empty: array<int> = []
    val noCalls = empty.mapped { value ->
        order.append(value)
        value + 1
    }
    numbers.append(99)
    println("${numbers[0]} ${numbers[1]} ${numbers[2]} ${input.size}")
    println("${order.size} ${order[0]} ${order[1]} ${order[2]} ${noCalls.size}")
    println("${words[0]} ${words[1]} ${rows[0].label} ${rows[1].score}")
}
