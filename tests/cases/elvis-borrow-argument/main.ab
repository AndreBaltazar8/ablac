import "abla/io"
var log: string = ""
resource class Item(val id: int) { fun drop(): void { log += "I$id" } }
class Observer { fun take(x: Item): void { log += "B${x.id}" } }
fun take(x: Item): void { log += "B${x.id}" }
fun takeOwned(own x: Item): void { log += "O${x.id}" }
fun maybe(flag: bool): Item? = if (flag) Item(1) else null
fun exercise(): string {
    log = ""
    take(maybe(true) ?? Item(2)); log += "|"
    take(maybe(false) ?? Item(2)); log += "|"
    Observer().take(maybe(true) ?? Item(3)); log += "|"
    Observer().take(maybe(false) ?? Item(3)); log += "|"
    takeOwned(maybe(true) ?? Item(4)); log += "|"
    val f: (Item) -> void = { x: Item -> log += "B${x.id}" }
    f(maybe(true) ?? Item(2)); log += "|"
    f(maybe(false) ?? Item(2)); log += "|"
    (if (true) f else f)(maybe(true) ?? Item(3)); log += "|"
    val consume: (own: Item) -> void = takeOwned
    consume(maybe(true) ?? Item(4)); log += "|"
    (if (true) consume else consume)(maybe(false) ?? Item(4)); log += "|"
    take(x = maybe(true) ?? Item(2)); log += "|"
    take(x = maybe(false) ?? Item(2)); log += "|"
    log
}
val evaluated = #exercise()
fun main: int { println(exercise()); println(evaluated); 0 }
