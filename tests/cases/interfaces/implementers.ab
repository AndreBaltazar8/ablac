import "abla/io"

// Which classes an interface's dispatcher reaches: a conformance declared on the
// class and added by a later `extend`, an `extend` written before its class, and a
// class conforming only through an interface its own interface extends.

interface A {
    fun a(): string
}

interface B {
    fun b(): string
}

interface I {
    fun i(): string
}

interface I2: I {
    fun j(): string
}

// A on the class, B by an extend after it.
class C(val n: int): A {
    fun a(): string = "a${this.n}"
    fun b(): string = "b${this.n}"
}

extend C: B

// The extend comes before the class.
extend D: B

class D(val n: int): A {
    fun a(): string = "a${this.n}"
    fun b(): string = "b${this.n}"
}

// I only through I2.
class E(val n: int): I2 {
    fun i(): string = "i${this.n}"
    fun j(): string = "j${this.n}"
}

class F(val n: int): I {
    fun i(): string = "i${this.n}"
}

fun listA(items: array<A>): string {
    var text = ""
    for (item in items) text = "$text ${item.a()}"
    text
}

fun listB(items: array<B>): string {
    var text = ""
    for (item in items) text = "$text ${item.b()}"
    text
}

fun listI(items: array<I>): string {
    var text = ""
    for (item in items) text = "$text ${item.i()}"
    text
}

fun report(): string {
    val c = C(1)
    val d = D(2)
    val e = E(3)
    val f = F(4)
    val asB: array<B> = [d, c]
    val asI: array<I> = [f, e]
    val i2: I2 = e
    val back = (asB[0] as? D) != null && (asB[1] as? D) == null
    "${listA([c, d])}${listB(asB)}${listI(asI)} ${i2.j()} ${i2.i()} $back"
}

val STAGED = #report()

fun main: int {
    println(report())
    println(STAGED)
    42
}
