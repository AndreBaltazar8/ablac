// A class's values have the members its interfaces' default bodies give it:
// `square.describe()` runs the default directly, with `this` the instance.
// A default calling another member reaches the class's method; the most
// specific default answers (Solid's for a Cube), an `extend`'s and a generic
// interface instance's (`Letters("xy").first()`) work alike, in a class's own
// methods and in `#` code too.
import "abla/io"

interface Shape {
    fun area(): int
    fun describe(): string = "shape of ${this.area()}"
    fun twice(): int = this.area() * 2
}

interface Solid : Shape {
    fun describe(): string = "solid of ${this.area()}"
}

class Square(val side: int) : Shape {
    fun area(): int = this.side * this.side
    fun summary(): string = "${this.describe()} ${this.twice()}"
}

class Cube(val side: int) : Solid {
    fun area(): int = 6 * this.side * this.side
}

class Dot(val x: int)

fun Dot.area(): int = 1

extend Dot : Shape

interface Source<T> {
    fun at(index: int): T?
    fun first(): T? = this.at(0)
}

class Letters(val text: string) : Source<string> {
    fun at(index: int): string? = if (index < this.text.size) this.text.slice(index, index + 1) else null
}

fun main {
    val square = Square(3)
    println("${square.describe()} ${square.twice()} ${square.summary()}")
    println("${Cube(1).describe()} ${Dot(5).describe()} ${Letters("xy").first() ?? "-"}")
    println("${#Square(2).describe()} ${#Cube(2).twice()} ${#Letters("q").first() ?? "-"}")
}
