import "abla/io"
import "./shapes.ab"
import "./square.ab"
import "./disc.ab"

// A third module makes Disc a Shape; calls cross all three.
extend Disc : Shape

fun main: int {
    val shapes: array<Shape> = [Square(2), Disc(2), Square(3)]
    val best = largest(shapes)
    if (best == null) return 1
    val disc = best as? Disc
    println("${best.describe()} ${disc != null} ${shapes[1].describe()}")
    42
}
