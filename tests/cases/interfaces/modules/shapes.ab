// The interface, and a function over it, in their own module.

interface Shape {
    fun area(): int
    fun describe(): string = "shape of ${this.area()}"
}

fun largest(shapes: array<Shape>): Shape? {
    var best: Shape? = null
    var bestArea = -1
    for (shape in shapes) {
        if (shape.area() > bestArea) {
            best = shape
            bestArea = shape.area()
        }
    }
    best
}
