import "abla/io"

// An interface value made at compile time is lifted into the program as its
// instance, and calls through it dispatch at run time.

interface Shape {
    fun area(): int
    fun describe(): string = "shape of ${this.area()}"
}

class Square(val side: int) : Shape {
    fun area(): int = this.side * this.side
}

class Circle(val radius: int) : Shape {
    fun area(): int = 3 * this.radius * this.radius
}

fun pick(round: bool): Shape = if (round) Circle(2) else Square(3)

val PICKED: Shape = #pick(true)
val SHAPES: array<Shape> = #[pick(false), pick(true)]

fun main: int {
    var sum = 0
    for (shape in SHAPES) sum = sum + shape.area()
    println("${PICKED.describe()} $sum ${(PICKED as? Circle) != null}")
    42
}
