import "abla/io"

// An interface (and a class) written on one line.
interface Shape { fun area(): int }
interface Named { fun name(): string; fun short(): string }

class Square(val side: int) : Shape { fun area(): int = this.side * this.side }

class Tag(val text: string) : Named { fun name(): string = this.text; fun short(): string = "t" }

fun main: int {
    val shape: Shape = Square(3)
    val named: Named = Tag("x")
    println("${shape.area()} ${named.name()}${named.short()}")
    42
}
