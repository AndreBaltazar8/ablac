interface Shape {
    fun area(): int
}

interface Named {
    fun name(): string
}

class Square(val side: int) : Shape {
    fun area(): int = this.side
}

class Label(val text: string) : Named {
    fun name(): string = this.text
}

fun main: int {
    val shape: Shape = Square(1)
    val label = shape as? Label
    0
}
