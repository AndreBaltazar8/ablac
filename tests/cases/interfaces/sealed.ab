import "abla/io"

// A sealed interface is a sum type: its classes are all in this module, so a
// `when` with an `is` arm for each needs no `else`, and each arm sees the
// subject as the class it tested.

sealed interface Expr

class Num(val value: int) : Expr
class Add(val left: Expr, val right: Expr) : Expr
class Mul(val left: Expr, val right: Expr) : Expr
class Neg(val operand: Expr) : Expr

fun evaluate(expr: Expr): int = when (expr) {
    is Num -> expr.value
    is Add -> evaluate(expr.left) + evaluate(expr.right)
    is Mul -> evaluate(expr.left) * evaluate(expr.right)
    is Neg -> -evaluate(expr.operand)
}

fun show(expr: Expr): string = when (expr) {
    is Num -> "${expr.value}"
    is Add -> "(${show(expr.left)} + ${show(expr.right)})"
    is Mul -> "${show(expr.left)} * ${show(expr.right)}"
    is Neg -> "-${show(expr.operand)}"
}

sealed interface Shape {
    fun area(): int
}

interface Round : Shape

class Square(val side: int) : Shape {
    fun area(): int = this.side * this.side
}

class Circle(val radius: int) : Round {
    fun area(): int = 3 * this.radius * this.radius
}

class Ring(val outer: int, val inner: int) : Round {
    fun area(): int = 3 * (this.outer * this.outer - this.inner * this.inner)
}

// An interface arm covers its classes; a nullable subject also matches `null`.
fun kind(shape: Shape?): string = when (shape) {
    null -> "none"
    is Square -> "square ${shape.side}"
    is Round -> "round ${shape.area()}"
}

fun report(): string {
    val expr = Add(Num(2), Mul(Num(3), Neg(Num(4))))
    "${show(expr)} = ${evaluate(expr)}; ${kind(Square(2))} ${kind(Ring(2, 1))} ${kind(null)}"
}

val STAGED = #report()

fun main: int {
    println(report())
    println(STAGED)
    42
}
