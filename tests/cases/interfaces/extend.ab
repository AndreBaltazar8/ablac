import "abla/io"

// `extend` makes a class declared elsewhere conform: its members come from the
// class's methods, from extension functions, or from the interface's defaults.

interface Printable {
    fun print(): string
    fun shout(): string = "${this.print()}!"
}

class Point(val x: int, val y: int) {
    fun print(): string = "($x, $y)"
}

class Tag(val text: string)

fun Tag.print(): string = "#${this.text}"

extend Point : Printable
extend Tag : Printable

fun all(items: array<Printable>): string {
    var text = ""
    for (item in items) text = "$text ${item.shout()}"
    text
}

fun report(): string {
    val items: array<Printable> = [Point(1, 2), Tag("abla")]
    val first = items[1] as? Tag
    "${all(items)} ${first != null}"
}

val STAGED = #report()

fun main: int {
    println(report())
    println(STAGED)
    42
}
