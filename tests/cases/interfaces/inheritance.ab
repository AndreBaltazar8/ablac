import "abla/io"

// An interface extends others: its values stand where its parents' are
// expected, a class conforming to it conforms to them, a call on it reaches
// the members it inherits, and its own default replaces a parent's.

interface Shape {
    fun area(): int
    fun describe(): string = "shape of ${this.area()}"
}

interface Named {
    fun name(): string
}

interface Solid : Shape, Named {
    fun volume(): int
    fun describe(): string = "${this.name()} of ${this.volume()}"
}

class Cube(val side: int) : Solid {
    fun area(): int = 6 * this.side * this.side
    fun volume(): int = this.side * this.side * this.side
    fun name(): string = "cube"
}

class Square(val side: int) : Shape {
    fun area(): int = this.side * this.side
}

class Ball(val radius: int)

fun Ball.area(): int = 12 * this.radius * this.radius
fun Ball.volume(): int = 4 * this.radius * this.radius * this.radius
fun Ball.name(): string = "ball"

extend Ball : Solid

fun total(shapes: array<Shape>): int {
    var sum = 0
    for (shape in shapes) sum = sum + shape.area()
    sum
}

fun report(): string {
    val solids: array<Solid> = [Cube(2), Ball(1)]
    val shapes: array<Shape> = [Square(3), solids[0], solids[1]]
    val big = if (solids[0].volume() > 4) solids[0] else Ball(2)
    val named: Named = Cube(1)
    "${total(shapes)} ${solids[0].area()} ${shapes[1].describe()} ${shapes[0].describe()} " +
        "${big.describe()} ${named.name()} ${(shapes[2] as? Ball) != null}"
}

val STAGED = #report()

fun main: int {
    println(report())
    println(STAGED)
    42
}
