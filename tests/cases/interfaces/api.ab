// The compiler API declares interfaces and conformances, and reads them back.
import "abla/io"
import "abla/compiler"

interface Shape {
    fun area(): int
    fun describe(): string = "shape of ${this.area()}"
}

class Square(val side: int) : Shape {
    fun area(): int = this.side * this.side
}

class Point(val x: int, val y: int)

fun Point.describe(): string = "point"

compile fun declare(): void {
    compiler.declareInterface("Labeled", ["fun label(): string"])
    compiler.addConformance(compiler.findClass("Point"), "Shape", ["fun area(): int = 0"])
    compiler.addConformance(
        compiler.findClass("Square"), "Labeled",
        ["fun label(): string = \"square \${this.side}\""]
    )
    return
}

#compiler.transform(declare)

compile fun listed(): string {
    val square = compiler.findClass("Square")
    val point = compiler.findClass("Point")
    var text = ""
    for (name in compiler.conformances(square)) text = "$text $name"
    text = "$text |"
    for (name in compiler.implementers("Shape")) text = "$text $name"
    text = "$text |"
    for (entry in compiler.witness(square, "Shape")) text = "$text $entry"
    text = "$text |"
    for (entry in compiler.witness(point, "Shape")) text = "$text $entry"
    "$text | ${compiler.conformsTo(point, "Labeled")}"
}

val LISTED = #listed()

fun main {
    val shapes: array<Shape> = [Square(2), Point(1, 1)]
    for (shape in shapes) println(shape.describe())
    val labeled: Labeled = Square(3)
    println(labeled.label())
    println(LISTED)
}
