import "abla/io"

// A class names the interfaces it conforms to, and its values pass, store and
// return where those interfaces are expected.

interface Shape {
    fun area(): f64
    fun scaled(by: f64): f64
}

interface Named {
    fun name(): string
}

class Square(val side: f64) : Shape, Named {
    fun area(): f64 = this.side * this.side
    fun scaled(by: f64): f64 = this.area() * by
    fun name() = "square"
}

class Circle(val radius: f64) : Shape {
    fun area(): f64 = 3.0 * this.radius * this.radius
    fun scaled(by: f64): f64 = this.area() * by
}

class Holder(var shape: Shape)

fun keep(shape: Shape): Shape = shape

fun maybe(shape: Shape?): bool = shape != null

fun main: int {
    val square = Square(2.0)
    val shapes: array<Shape> = [square, Circle(1.0)]
    shapes.append(keep(square))
    val holder = Holder(Circle(2.0))
    holder.shape = square
    val named: Named = square
    val first: Shape = shapes[0]
    println("${shapes.size} ${maybe(square)} ${maybe(null)}")
    42
}
