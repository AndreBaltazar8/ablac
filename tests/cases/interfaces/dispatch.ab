import "abla/io"

// Calls through an interface value reach the class's method, or the
// interface's default body when the class has none; `as?` takes the value back
// to its class. `#report()` runs the same calls at compile time.

interface Shape {
    fun area(): int
    fun scaled(by: int): int
    fun describe(): string = "shape of ${this.area()}"
}

interface Named {
    fun name(): string
}

class Square(val side: int) : Shape, Named {
    fun area(): int = this.side * this.side
    fun scaled(by: int): int = this.area() * by
    fun name() = "square ${this.side}"
}

class Circle(val radius: int) : Shape {
    fun area(): int = 3 * this.radius * this.radius
    fun scaled(by: int): int = this.area() * by
    fun describe(): string = "circle"
}

fun total(shapes: array<Shape>): int {
    var sum = 0
    for (shape in shapes) sum = sum + shape.scaled(2)
    sum
}

fun label(shape: Shape): string {
    val square = shape as? Square
    if (square != null) square.name() else shape.describe()
}

fun report(): string {
    val shapes: array<Shape> = [Square(2), Circle(1)]
    val named: Named = Square(3)
    val missing: Shape? = null
    val circle = shapes[1] as? Circle
    val notCircle = shapes[0] as? Circle
    "${total(shapes)} ${shapes[0].describe()} ${shapes[1].describe()} " +
        "${label(shapes[0])} ${label(shapes[1])} ${named.name()} " +
        "${circle != null} ${notCircle == null} ${(missing as? Square) == null}"
}

val STAGED = #report()

fun main: int {
    println(report())
    println(STAGED)
    42
}
