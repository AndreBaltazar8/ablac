import "abla/io"
import "abla/compiler"

// A compile-time transform edits declarations in place (an annotation, a new
// body) before the program is analyzed: the `when` arms over a sealed interface,
// the `extend` conformance and a call through an interface still see every class.

sealed interface Node

class Leaf(val value: int): Node
class Pair(val left: Node, val right: Node): Node

interface Printable {
    fun print(): string
}

class Tag(val text: string)

fun Tag.print(): string = "#${this.text}"

extend Tag: Printable

fun sum(node: Node): int = when (node) {
    is Leaf -> node.value
    is Pair -> sum(node.left) + sum(node.right)
}

fun plain(): int = 1

fun tagged(): int = 2

compile fun edit(): void {
    compiler.addFunctionAnnotation(compiler.findFunction("tagged"), "inline")
    compiler.replaceFunctionBody(compiler.findFunction("plain"), "10")
    return
}

#compiler.transform(edit)

fun show(item: Printable): string = item.print()

fun main: int {
    val tree = Pair(Leaf(plain()), Pair(Leaf(tagged()), Leaf(3)))
    println("${sum(tree)} ${show(Tag("abla"))}")
    42
}
