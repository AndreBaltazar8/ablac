import "abla/io"

// A resource interface's values are resources: one owner, moved, and dropped
// through the class they are an instance of.

resource interface Handle {
    fun id(): int
}

resource class File(val number: int) : Handle {
    fun id(): int = this.number
    fun drop(): void {
        println("close file ${this.number}")
    }
}

resource class Socket(val port: int) : Handle {
    fun id(): int = this.port
    fun drop(): void {
        println("close socket ${this.port}")
    }
}

fun peek(handle: Handle): int = handle.id()

fun finish(own handle: Handle): int {
    val id = handle.id()
    println("finishing $id")
    id
}

fun main: int {
    val file: Handle = File(3)
    println("peek ${peek(file)}")
    val sum = finish(Socket(80)) + finish(move(file))
    println("sum $sum")
    val kept: Handle = Socket(22)
    println("kept ${kept.id()}")
    val many: array<Handle> = [File(7), Socket(9)]
    println("many ${many[0].id() + many[1].id()}")
    42
}
