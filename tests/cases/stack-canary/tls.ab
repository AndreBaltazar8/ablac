// The stack protector's canary of a libc-free x86-64 Linux executable (#1139 area 14; tools/test-stack-canary.sh): the thread block's word at
// fs:0x28, set from the kernel's AT_RANDOM bytes with the low byte cleared. Prints its low byte and the rest; two runs must differ, each with a low
// byte of 0.
import "abla/io"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun main {
    val cell = nativeByteBuffer(8)
    // arch_prctl(ARCH_GET_FS): the thread pointer, which points at the thread block.
    linuxSyscall2(158, 4099, ablaUnsafePointerAddress(cell.pointerAt(0)))
    val pointer = ablaUnsafeLoadI64(cell.pointerAt(0))
    val guard = ablaUnsafeLoadI64(nativePointerFromAddress(pointer + 40))
    println("canary low=${guard & 255} rest=${guard >> 8}")
}
