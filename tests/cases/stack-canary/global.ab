// The stack protector's canary of a libc-free AArch64 or RISC-V executable (#1139 area 14; tools/test-stack-canary.sh): code built with
// -fstack-protector (LLVM, lld and libstdc++ in the static compiler) reads the global __stack_chk_guard, which the start code sets from the kernel's
// AT_RANDOM bytes with the low byte cleared. Prints its low byte and the rest; two runs must differ, each with a low byte of 0 (it was one constant).
import "abla/io"
import "abla/unsafe/memory/raw"

trusted fun main {
    val guard = ablaUnsafeLoadI64(nativePointerFromAddress(nativeLinkerSymbolAddress("__stack_chk_guard")))
    println("canary low=${guard & 255} rest=${guard >> 8}")
}
