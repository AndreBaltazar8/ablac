// linuxReadFile(path, limit) with a limit far above the file: the string it returns holds the file's bytes, not the limit (a 9-byte file read with a 4 MB limit
// used to keep 4 MB alive for as long as the string lived). Also: the copy has the file's exact bytes, for sizes either side of the word size and of half the limit.
import "abla/io"
import "abla/memory"
import "abla/fs"
import "abla/sys/linux"
import "abla/sys/linux/process"

fun content(size: int): string {
    var text = ""
    for (i in 0 until size) text = text + "${(i * 7 + 3) % 10}"
    text
}

fun main: int {
    val directory = "build/read-file-memory"
    Path(directory).createDirectories()
    var failed = 0
    for (size in [0, 1, 7, 8, 9, 15, 16, 17, 100, 4095, 4096, 4097, 70000]) {
        val path = "$directory/f$size.txt"
        val expected = content(size)
        Path(path).writeText(expected)
        for (limit in [size + 1, size * 2 + 2, 4194304]) {
            val got = linuxReadFile(path, limit)
            if (got != expected) {
                println("size $size, limit $limit: read ${got.size} bytes, not the file's ${expected.size}")
                failed = failed + 1
            }
        }
    }
    // the memory: 40 reads of a small file under a 4 MB limit, all kept
    memoryCollect()
    val before = memoryLiveBytes()
    val kept: array<string> = []
    for (i in 0 until 40) kept.append(linuxReadFile("$directory/f100.txt", 4194304))
    memoryCollect()
    val grown = memoryLiveBytes() - before
    println("40 reads of a 100-byte file with a 4 MB limit hold ${grown / 1024} KB")
    if (grown > 1048576) {
        println("too much: the strings keep the read buffers alive")
        failed = failed + 1
    }
    if (kept.size != 40) failed = failed + 1
    if (failed == 0) 42 else 1
}
