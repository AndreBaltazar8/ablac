// A module's identity is its lexically normalized path (src/module_paths.ab) by the host's syntax: here both syntaxes, POSIX and
// Windows, checked on Linux (tools/test-module-path-identity.sh; host.ab is what a host's Path gives, on Linux and under Wine).
import "../../../src/module_paths.ab"
import "abla/io"
import "abla/fs/path"
import "abla/sys/linux/fs"

fun check(failures: int, label: string, got: string, expected: string): int {
    if (got == expected) return failures
    println("FAIL $label: \"$got\", expected \"$expected\"")
    failures + 1
}

fun main: int {
    var failures = 0
    // POSIX, as the compiler always had it.
    failures = check(failures, "posix absolute", bootstrapNormalizeModulePathIn("/a/./b/../c.ab", false), "/a/c.ab")
    failures = check(failures, "posix root", bootstrapNormalizeModulePathIn("/a/..", false), "/")
    failures = check(failures, "posix above root", bootstrapNormalizeModulePathIn("/../x", false), "/x")
    failures = check(failures, "posix relative", bootstrapNormalizeModulePathIn("a//b/../../../c", false), "../c")
    failures = check(failures, "posix empty", bootstrapNormalizeModulePathIn("a/..", false), ".")
    failures = check(failures, "posix backslash is a name byte", bootstrapNormalizeModulePathIn("/a\\b/c", false), "/a\\b/c")
    // Windows: the canonical `/` form, a drive or a share kept as the root.
    failures = check(failures, "windows drive", bootstrapNormalizeModulePathIn("C:\\src\\.\\lib\\..\\main.ab", true), "C:/src/main.ab")
    failures = check(failures, "windows mixed", bootstrapNormalizeModulePathIn("C:/src\\lib/x.ab", true), "C:/src/lib/x.ab")
    failures = check(failures, "windows drive root", bootstrapNormalizeModulePathIn("C:\\a\\..\\..", true), "C:/")
    failures = check(failures, "windows unc", bootstrapNormalizeModulePathIn("\\\\server\\share\\a\\..\\b.ab", true), "//server/share/b.ab")
    failures = check(failures, "windows unc root", bootstrapNormalizeModulePathIn("//server/share/../x", true), "//server/share/x")
    failures = check(failures, "windows relative", bootstrapNormalizeModulePathIn("a\\b\\..\\..\\..\\c", true), "../c")
    failures = check(failures, "windows drive relative", bootstrapNormalizeModulePathIn("C:x\\y", true), "C:x/y")
    if (failures == 0) println("syntax ok")
    failures
}
