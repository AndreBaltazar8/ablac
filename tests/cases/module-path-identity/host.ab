// What this host's Path gives (tools/test-module-path-identity.sh): POSIX's on Linux, Windows's under Wine (built for
// x86_64-windows-hosted), where a drive path is absolute and joins and normal forms come back `/`-separated.
import "abla/io"
import "abla/fs/path"
import "abla/sys/linux/fs"

fun main {
    println("host windows ${pathHostIsWindows()}")
    println("host absolute ${Path("C:\\x").isAbsolute()} ${Path("/x").isAbsolute()}")
    println("host child ${Path("C:\\x").child("y").text}")
    println("host normalized ${Path("C:\\a\\.\\b\\..\\c").normalized().text}")
    println("host parent ${Path("C:/a/b").parent().text}")
    println("host verbatim ${Path("\\\\?\\C:\\a").child("b").text}")
}
