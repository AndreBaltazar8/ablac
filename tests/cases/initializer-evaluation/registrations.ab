import "abla/build"
import "abla/io"

// Nothing reads these globals. Their compile-time evaluations still run, in
// a program with `main` and in an object without one alike.

trusted noescape extern:"inline-assembly" fun assemblyVoid(
    template: string,
    constraints: string
): void

fun exportedLeaf(value: i32): i32 = value + i32(1)
fun requiredLeaf(value: i32): i32 = value + i32(2)
fun assemblyLeaf(): void {}

compile fun announce(): bool {
    println("unread initializer evaluated")
    true
}

val unreadAnnouncement = #announce()
val unreadExport = #exportFunction("exportedLeaf", "abla_test_unread_export")
val unreadRequired = #requiredInternalFunction(
    "requiredLeaf",
    "abla_test_unread_required"
)
val unreadAssemblyLink = #internalFunction(
    "assemblyLeaf",
    "abla_test_unread_assembly_link"
)

@naked
@export("abla_test_unread_assembly_root")
trusted fun assemblyRoot(): void = assemblyVoid(
    "call abla_test_unread_assembly_link\nret",
    "~{memory}"
)
