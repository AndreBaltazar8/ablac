import "abla/memory"
import "abla/float"
import "abla/json"

class Node(var value: int, var label: string)

class Body(var x: f64, var y: f64, var hits: int)

val bodies: array<Body> = []
var history: array<string> = []
var chainDepth = 0
var chain: array<Node> = []
var greeting = "start"

fun ensureBodies(): void {
    if (bodies.size == 0) {
        var i = 0
        while (i < 64) {
            bodies.append(Body(0.0, 0.0, 0))
            i = i + 1
        }
    }
}

// Mutate global state with fresh objects so old ones become garbage while new
// ones must survive collection through the global roots.
@export("mutate")
fun mutate(round: i32): int {
    ensureBodies()
    val r = int(round)
    var i = 0
    while (i < bodies.size) {
        val old = bodies[i]
        bodies[i] = Body(old.x + 1.0, old.y + f64FromInt(i), old.hits + (r + i) % 3)
        i = i + 1
    }
    // Bounded chain: restart it every 32 links so old nodes become garbage.
    if (chainDepth >= 32) {
        chain = [Node(r, "n${r}")]
        chainDepth = 1
    } else {
        chain.append(Node(r, "n${r}"))
        chainDepth = chainDepth + 1
    }
    greeting = "round-${r}-${greeting.size}"
    history.append("h${r % 97}")
    if (history.size > 50) {
        val kept: array<string> = []
        var j = history.size - 25
        while (j < history.size) {
            kept.append(history[j])
            j = j + 1
        }
        history = kept
    }
    0
}

// Pure garbage: none of this is reachable after return.
@export("churn")
fun churn(count: i32): int {
    var total = 0
    var i = 0
    while (i < int(count)) {
        val body = Body(1.0, 2.0, i)
        val text = "garbage-${i}"
        val list = [body, Body(3.0, 4.0, i + 1)]
        val encoded = $jsons { "kind": "churn", "index": 42 }
        total = total + list.size + text.size + encoded.size + body.hits
        i = i + 1
    }
    total
}

// Locals must survive a collection triggered while they are live.
@export("collect_holding")
fun collectHolding(): int {
    val local = Body(5.0, 6.0, 7)
    val localText = "held-${greeting}"
    val localNodes = [Node(1, "a"), Node(2, "b")]
    memoryCollect()
    churn(100)
    memoryCollect()
    local.hits + localText.size + localNodes[0].value + localNodes[1].value +
        localNodes[1].label.size
}

@export("checksum")
fun checksum(): int {
    ensureBodies()
    var sum = 0
    for (body in bodies) sum = sum * 31 + body.hits + f64ToBits(body.x) + f64ToBits(body.y)
    for (node in chain) sum = sum * 7 + node.value + node.label.size
    for (entry in history) sum = sum + entry.size
    sum + greeting.size
}

@export("collect")
fun collect(): int = memoryCollect()

@export("live")
fun live(): int = memoryLiveBytes()
