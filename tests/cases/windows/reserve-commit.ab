// The address-space window of the frozen heap (abla/runtime/platform/host.ab): `mmap` of no access with MAP_NORESERVE reserves address
// space, and `mprotect` to read-write makes pages of it usable, then to read-only again. On Windows the reservation is MEM_RESERVE alone,
// whose pages VirtualProtect refuses until they are committed, so the translation of mprotect commits them (windows-http-async's release
// build wrote to pages it never got, 0xC0000005, on windows-latest). The program writes to the window's pages and reads them back.
import "abla/io"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun put(address: int, value: int): void {
    val cell = nativeByteBuffer(8)
    cell.storeI64(0, value)
    ablaUnsafeCopyMemory(address, nativePointerAddress(cell.address), 8)
    cell.close()
    return
}

trusted fun get(address: int): int {
    val cell = nativeByteBuffer(8)
    ablaUnsafeCopyMemory(nativePointerAddress(cell.address), address, 8)
    val value = cell.loadI64(0)
    cell.close()
    value
}

fun main: int {
    val span = 4194304
    val window = linuxSyscall6(9, 0, span, 0, 16418, -1, 0)
    println("reserved ${window > 0}")
    // two ranges, a 64 KiB chunk each, the second not next to the first
    val first = window
    val second = window + 262144
    println("protect ${linuxSyscall3(10, first, 65536, 3)} ${linuxSyscall3(10, second, 131072, 3)}")
    put(first, 1234)
    put(first + 65528, 5678)
    put(second + 131064, 91011)
    println("values ${get(first)} ${get(first + 65528)} ${get(second + 131064)}")
    println("readonly ${linuxSyscall3(10, first, 65536, 1)} ${get(first)}")
    println("unmap ${linuxSyscall2(11, window, span)}")
    42
}
