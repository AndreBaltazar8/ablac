// Threads of a hosted Windows program (W1c): CreateThread behind the runtime's pthread_create, futex locks on WaitOnAddress. Three
// threads build strings and agree on what they built; the main thread collects meanwhile. The same program run natively prints the same.
import "abla/io"
import "abla/memory"

fun worker(seed: int): int {
    val kept: array<string> = []
    var index = 0
    while (index < 200) {
        kept.append("kept-$seed-$index")
        index += 1
    }
    var bad = 0
    var round = 0
    while (round < 2000) {
        val fresh = "fresh-$seed-$round"
        var check = 0
        while (check < kept.size) {
            if (kept[check] != "kept-$seed-$check") bad += 1
            check += 1
        }
        if (fresh != "fresh-$seed-$round") bad += 1
        round += 1
    }
    bad + seed
}

fun main: int {
    val first = thread { worker(1) }
    val second = thread { worker(2) }
    val third = thread { worker(3) }
    var collected = 0
    while (collected < 50) {
        val garbage = "garbage-$collected"
        if (garbage.size > 0) memoryCollect()
        collected += 1
    }
    println("workers ${await first} ${await second} ${await third}")
    0
}
