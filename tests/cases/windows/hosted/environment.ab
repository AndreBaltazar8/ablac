// The environment of a hosted Windows program (W1c), from GetEnvironmentStringsW as Linux lays it out after argv: a variable the test
// runner sets is found, one it does not set is not, and a value with spaces and non-ASCII text arrives whole. The same program run
// natively on Linux with the same variables prints the same.
import "abla/io"
import "abla/process/environment"

fun main: int {
    println("found [${processEnvironment("ABLA_WINDOWS_TEST") ?? "(none)"}]")
    println("other [${processEnvironment("ABLA_WINDOWS_TEST_UNSET") ?? "(none)"}]")
    println("unicode [${processEnvironment("ABLA_WINDOWS_UNICODE") ?? "(none)"}]")
    0
}
