// A hosted Windows program (W1c): the Abla runtime and standard library over kernel32. Strings, an array that grows, println.
import "abla/io"
fun main: int {
    val xs: array<string> = []
    var i = 0
    while (i < 5) { xs.append("item $i"); i = i + 1 }
    println("${xs.size} ${xs[4]}")
    0
}
