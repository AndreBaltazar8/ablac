// Processes of a hosted Windows program (W1c): a command run for its status, one whose output is captured, one started and polled
// until it ends, and one that is not there. The standard library's launch is one call on Windows (CreateProcessW behind the runtime's
// translation); the same program run natively on Linux runs `sh` where this runs `cmd`, and prints the same.
import "abla/io"
import "abla/text"
import "abla/process/command"
import "abla/process/environment"
import "abla/process/time"

fun isWindows(): bool = (processEnvironment("OS") ?? "") == "Windows_NT"

fun shell(script: string): Command =
    if (isWindows()) command("cmd").argument("/c").argument(script) else command("sh").argument("-c").argument(script)

fun main: int {
    println("status ${shell("exit 7").run()}")
    println("captured [${shell("echo hello").captureText().trim()}]")
    println("missing ${command("abla-no-such-program-anywhere").run()}")
    val child = shell("exit 3").start()
    var status = child.native.poll()
    var spins = 0
    while (status < 0 && spins < 200) {
        sleepNanoseconds(50000000)
        status = child.native.poll()
        spins += 1
    }
    println("polled $status")
    val piped = shell("echo alpha beta").pipe(shell(if (isWindows()) "findstr beta" else "grep beta")).capture()
    println("pipeline [${piped.output.trim()}] ${piped.status}")
    0
}
