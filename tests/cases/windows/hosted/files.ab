// Files of a hosted Windows program (W1c): the portable abla/fs over the runtime's translation of the Linux file calls to kernel32.
// A directory is made, a file written, appended to, read back, measured, renamed, listed and removed; the same program run natively
// on Linux prints the same lines.
import "abla/io"
import "abla/fs"
import "abla/text"

fun main: int {
    val directory = Path("windows-files-test")
    directory.removeTree()
    println("made ${directory.createDirectories()}")
    val file = directory.child("a.txt")
    println("wrote ${file.writeText("hello\nwindows\n")}")
    println("appended ${file.appendText("more")}")
    println(file.readText())
    println("size ${file.info().size} file ${file.info().isFile()} directory ${directory.info().isDirectory()}")
    val moved = directory.child("b.txt")
    println("moved ${file.moveTo(moved)}")
    println("a ${file.exists()} b ${moved.exists()}")
    println("atomic ${directory.child("c.txt").writeTextAtomic("atomic")}")
    val names: array<string> = []
    // the order of a listing is the system's: sorted here
    for (entry in directory.entries()) {
        val name = entry.name()
        var at = names.size
        names.append(name)
        while (at > 0 && names[at - 1] > name) {
            names[at] = names[at - 1]
            at = at - 1
        }
        names[at] = name
    }
    println("entries ${names.join(",")}")
    println("missing ${directory.child("nothing").exists()} ${directory.child("nothing").readTextResult().succeeded}")
    println("removed ${directory.removeTree()} ${directory.exists()}")
    0
}
