// The process arguments of a hosted Windows program, from GetCommandLineW split by CommandLineToArgvW's rules (W1c): the same
// program, run natively on Linux with the same arguments, prints the same lines.
import "abla/io"
import "abla/process/arguments"

fun main: int {
    println("count ${processArgumentCount()}")
    var index = 0
    while (index < processArgumentCount()) {
        println("[${processArgument(index)}]")
        index = index + 1
    }
    0
}
