// A Windows socket call that fails returns -1 as a 32-bit C int; the runtime answers the Linux call with a negative errno, not
// with the 4294967295 of a result read as 64 bits (tools/test-windows-syscalls.sh). A read of a nonblocking connected socket
// with nothing to read fails with WSAEWOULDBLOCK, which is EAGAIN (-11), through read (0), recvfrom (45) and recvfrom with
// MSG_DONTWAIT on a blocking socket, and a send on a closed socket is negative too. Read as 64 bits, the first read's count
// made httpAsyncPlainRead copy 4 GiB from its 64 KiB stack buffer, off the top of the stack (CI run 45374103451).
// SO_RCVTIMEO is a Linux timeval (1.5 s here), which Winsock takes as a DWORD of milliseconds: passed through, it read the
// seconds as milliseconds and waited 1 ms; a read it ends is EAGAIN, as on Linux, not ETIMEDOUT.
// A peer that resets the connection (SO_LINGER on with 0 seconds, then close: an RST) makes every kind of read fail with a negative
// error, ECONNRESET (-104): read(2), TcpConnection.readResult and a TLS session's read, never a count (the stdlib readers also refuse
// a count above their buffer: tests/cases/modules/read-count-guard.ab). SO_LINGER is two ints on Linux and two 16-bit words on Winsock:
// the runtime converts it, so a linger time above 0 comes back as set. A peer that goes silent past a TcpConnection's receive timeout
// makes its readResult an error, EAGAIN, with no bytes.
import "abla/io"
import "abla/net"
import "abla/tls/pure"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// A connected pair on loopback whose server end resets the connection: its close is an RST. The client end is returned.
trusted fun resetClient(listener: TcpListener): TcpConnection {
    val client = tcpConnectIpv4("127.0.0.1", listener.localPort(), 2000)
    val server = listener.accept()
    val linger = nativeByteBuffer(16)
    ablaUnsafeStoreI64(linger.address, 1)
    println("linger set ${linuxSyscall5(54, server.descriptor, 1, 13, nativePointerAddress(linger.address), 8)}")
    server.close()
    linger.close()
    client
}

trusted fun main {
    val listener = tcpListenAddress(ipv4Loopback(0))
    var client = tcpConnectIpv4("127.0.0.1", listener.localPort(), 2000)
    var server = listener.accept()
    val buffer = nativeByteBuffer(64)
    val address = nativePointerAddress(buffer.address)
    // recvfrom(fd, buffer, 64, MSG_DONTWAIT, 0, 0) on the blocking socket
    println("recvfrom dontwait ${linuxSyscall6(45, client.descriptor, address, 64, 64, 0, 0)}")
    // setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, {1, 500000}, 16), getsockopt of it, and a read it ends
    val timeval = nativeByteBuffer(24)
    val timevalAddress = nativePointerAddress(timeval.address)
    ablaUnsafeStoreI64(timeval.address, 1)
    ablaUnsafeStoreI64(nativePointerFromAddress(timevalAddress + 8), 500000)
    println("timeout set ${linuxSyscall5(54, client.descriptor, 1, 20, timevalAddress, 16)}")
    ablaUnsafeStoreI64(timeval.address, 0)
    ablaUnsafeStoreI64(nativePointerFromAddress(timevalAddress + 8), 0)
    ablaUnsafeStoreI64(nativePointerFromAddress(timevalAddress + 16), 16)
    val asked = linuxSyscall5(55, client.descriptor, 1, 20, timevalAddress, timevalAddress + 16)
    println("timeout read $asked: ${ablaUnsafeLoadI64(timeval.address)} s ${ablaUnsafeLoadI64(nativePointerFromAddress(timevalAddress + 8))} us")
    val started = linuxMonotonicMilliseconds()
    val timedOut = linuxSyscall3(0, client.descriptor, address, 64)
    val waited = linuxMonotonicMilliseconds() - started
    println("read until the timeout $timedOut, waited at least 1.4 s ${waited >= 1400}")
    timeval.close()
    // fcntl(fd, F_SETFL, O_NONBLOCK), then read and recvfrom
    println("nonblocking ${linuxSyscall3(72, client.descriptor, 4, 2048)}")
    println("read ${linuxSyscall3(0, client.descriptor, address, 64)}")
    println("recvfrom ${linuxSyscall6(45, client.descriptor, address, 64, 0, 0, 0)}")
    // Bytes the server sends are read as their count.
    ablaUnsafeStoreU8(buffer.address, 33)
    println("send ${linuxSyscall6(44, server.descriptor, address, 1, 0, 0, 0)}")
    var count = -11
    var attempt = 0
    while (count == -11 && attempt < 1000) {
        count = linuxSyscall3(0, client.descriptor, address, 64)
        attempt = attempt + 1
    }
    println("read after send $count")
    // shutdown(server, SHUT_WR): the read sees the end, 0
    linuxSyscall2(48, server.descriptor, 1)
    count = -11
    attempt = 0
    while (count == -11 && attempt < 100000) {
        count = linuxSyscall3(0, client.descriptor, address, 64)
        attempt = attempt + 1
    }
    println("read at the end $count")
    // A send on the socket after shutting down its sending side fails, negative.
    val refused = linuxSyscall6(44, server.descriptor, address, 1, 16384, 0, 0)
    println("send after shutdown negative ${refused < 0}")
    buffer.close()
    client.close()
    server.close()
    // A SO_LINGER with seconds above 0 reads back as set (two 32-bit ints on Linux, two 16-bit words on Winsock).
    val lingered = tcpConnectIpv4("127.0.0.1", listener.localPort(), 2000)
    val accepted = listener.accept()
    val option = nativeByteBuffer(24)
    val optionAddress = nativePointerAddress(option.address)
    ablaUnsafeStoreI64(option.address, 1 + 7 * 4294967296)
    println("linger 7 s set ${linuxSyscall5(54, lingered.descriptor, 1, 13, optionAddress, 8)}")
    ablaUnsafeStoreI64(option.address, 0)
    ablaUnsafeStoreI64(nativePointerFromAddress(optionAddress + 16), 8)
    val lingerRead = linuxSyscall5(55, lingered.descriptor, 1, 13, optionAddress, optionAddress + 16)
    val lingerWord = ablaUnsafeLoadI64(option.address)
    println("linger read $lingerRead: on ${lingerWord % 4294967296} for ${lingerWord / 4294967296} s")
    option.close()
    lingered.close()
    accepted.close()
    // Resets: each kind of read fails with a negative error.
    val resetRead = resetClient(listener)
    val resetBuffer = nativeByteBuffer(64)
    println("read after a reset ${linuxSyscall3(0, resetRead.descriptor, nativePointerAddress(resetBuffer.address), 64)}")
    resetBuffer.close()
    resetRead.close()
    val resetResult = resetClient(listener)
    val result = resetResult.readResult(64)
    println("readResult after a reset ${result.status} ${result.errorCode} ${result.bytes.size}")
    resetResult.close()
    val resetTls = resetClient(listener)
    val session = tlsSessionClient(resetTls.descriptor, "localhost", TLS_VERIFY_NONE)
    val io = session.readReady(16384)
    println("TLS read after a reset ${io.status} ${io.bytes.size}")
    session.close()
    resetTls.close()
    // A peer that goes silent: a TcpConnection's read with a receive timeout (setTimeouts, SO_RCVTIMEO of 0.5 s) waits it
    // out and is an error, EAGAIN (11), with no bytes, as on Linux: not a count, not a crash.
    val silent = tcpConnectIpv4("127.0.0.1", listener.localPort(), 2000)
    val quiet = listener.accept()
    println("timeouts set ${silent.setTimeouts(500, 500)}")
    val silentStart = linuxMonotonicMilliseconds()
    val silentResult = silent.readResult(64)
    val silentWaited = linuxMonotonicMilliseconds() - silentStart
    println("readResult from a silent peer ${silentResult.status} ${silentResult.errorCode} ${silentResult.bytes.size}, " +
        "waited at least 0.4 s ${silentWaited >= 400}")
    silent.close()
    quiet.close()
    listener.close()
}
