// A directory opened by a path of more than 2040 characters: the descriptor of a directory keeps its search pattern (the path and "\*") in a page of
// its own, which was a fixed 4096 bytes: a longer path was written past its end (an access violation at the page's end under Wine, the whole process
// lost to a path of two and a half thousand characters). Directories one level at a time to 2300 characters, then the deepest opened, listed and removed.
// The same program prints the same on Linux; a Windows without long paths enabled cannot make such a directory (programs.txt: wine).
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

fun main: int {
    val buffer = nativeByteBuffer(4096)
    val length = linuxSyscall2(79, nativePointerAddress(buffer.address), 4096)
    val base = buffer.adoptString(length - 1) + "/long-directory-9"
    val levels: array<string> = []
    var full = base
    levels.append(full)
    while (full.size < 2300) {
        full = full + "/" + "d".repeat(100)
        levels.append(full)
    }
    var made = true
    for (level in levels) {
        if (!path(level).createDirectories()) made = false
    }
    println("made $made")
    val opened = linuxOpen(full, 65536)
    println("opened ${opened.descriptor >= 0}")
    // one entry in each directory: the next level's name (and not the pattern or the page's other bytes)
    val parent = levels[levels.size - 2]
    val listed = linuxOpen(parent, 65536)
    val entries = nativeByteBuffer(8192)
    val got = linuxSyscall3(217, listed.descriptor, nativePointerAddress(entries.address), 8192)
    val names = entries.adoptString(if (got > 0) got else 0)
    println("listed ${names.contains("ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")}")
    linuxSyscall1(3, listed.descriptor)
    linuxSyscall1(3, opened.descriptor)
    var index = levels.size
    while (index > 0) {
        index = index - 1
        linuxSyscall1(84, nativeCStringAddress(levels[index]))
    }
    println("removed ${!path(base).exists()}")
    42
}
