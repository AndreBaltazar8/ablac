import "abla/io"
import "abla/sys/linux"
import "abla/sys/linux/fs"

// AnchoredPath (abla/sys/linux/fs) on a plain tree: every operation gives what the Path method does, and the same on Linux, macOS and Windows (#1201: on Windows
// each name is opened from a held directory handle, stdlib/abla/runtime/platform/windows). The links are in anchored-link.ab.

val anchoredRoot = "build/anchored-plain"

var anchoredFailures = 0

fun anchoredCheck(name: string, ok: bool): void {
    if (ok) println("ok $name") else {
        println("FAIL $name")
        anchoredFailures = anchoredFailures + 1
    }
}

fun main: int {
    Path(anchoredRoot).removeTree()
    val made = AnchoredPath("$anchoredRoot/a/b").createDirectories()
    anchoredCheck("createDirectories", made && AnchoredPath("$anchoredRoot/a/b").info().isDirectory())
    anchoredCheck("write", AnchoredPath("$anchoredRoot/a/b/f.txt").writeText("hello"))
    anchoredCheck("read", AnchoredPath("$anchoredRoot/a/b/f.txt").readText() == "hello")
    val info = AnchoredPath("$anchoredRoot/a/b/f.txt").info()
    anchoredCheck("info", info.isFile() && info.size == 5 && info.revision > 0)
    anchoredCheck("append", AnchoredPath("$anchoredRoot/a/b/f.txt").appendText(" world") &&
        AnchoredPath("$anchoredRoot/a/b/f.txt").readText() == "hello world")
    anchoredCheck("overwrite", AnchoredPath("$anchoredRoot/a/b/f.txt").writeText("short") &&
        AnchoredPath("$anchoredRoot/a/b/f.txt").readText() == "short")
    anchoredCheck("atomic", AnchoredPath("$anchoredRoot/a/b/g.txt").writeTextAtomic("atomic") &&
        AnchoredPath("$anchoredRoot/a/b/g.txt").readText() == "atomic" &&
        AnchoredPath("$anchoredRoot/a/b/g.txt").writeTextAtomic("again") &&
        AnchoredPath("$anchoredRoot/a/b/g.txt").readText() == "again")
    anchoredCheck("write creates directories", AnchoredPath("$anchoredRoot/n/m/h.txt").createParentDirectories() &&
        AnchoredPath("$anchoredRoot/n/m/h.txt").writeText("deep") && AnchoredPath("$anchoredRoot/n/m/h.txt").readText() == "deep")
    val entries = AnchoredPath("$anchoredRoot/a/b").entries()
    var names = ""
    for (entry in entries) {
        if (entry.name() == "f.txt" || entry.name() == "g.txt") names = "$names${entry.name()} "
    }
    anchoredCheck("entries", entries.size == 2 && (names == "f.txt g.txt " || names == "g.txt f.txt "))
    val missing = AnchoredPath("$anchoredRoot/a/b/none.txt")
    anchoredCheck("missing", !missing.exists() && !missing.readTextResult().succeeded && missing.info().kind == 0)
    anchoredCheck("directory is no file", !AnchoredPath("$anchoredRoot/a/b").readTextResult().succeeded)
    anchoredCheck("move", AnchoredPath("$anchoredRoot/a/b/f.txt").moveTo(AnchoredPath("$anchoredRoot/c/d/f2.txt")) &&
        !AnchoredPath("$anchoredRoot/a/b/f.txt").exists() && AnchoredPath("$anchoredRoot/c/d/f2.txt").readText() == "short")
    anchoredCheck("move over a file", AnchoredPath("$anchoredRoot/a/b/g.txt").moveTo(AnchoredPath("$anchoredRoot/c/d/f2.txt")) &&
        AnchoredPath("$anchoredRoot/c/d/f2.txt").readText() == "again")
    anchoredCheck("remove file", AnchoredPath("$anchoredRoot/c/d/f2.txt").remove() && !AnchoredPath("$anchoredRoot/c/d/f2.txt").exists())
    anchoredCheck("remove missing", !AnchoredPath("$anchoredRoot/c/d/f2.txt").remove())
    anchoredCheck("remove directory", AnchoredPath("$anchoredRoot/c/d").remove() && !AnchoredPath("$anchoredRoot/c/d").exists())
    anchoredCheck("remove non-empty directory fails", !AnchoredPath("$anchoredRoot/n").remove() && AnchoredPath("$anchoredRoot/n/m/h.txt").exists())
    // A name Windows reads as another is refused on Windows (a DOS device, a trailing dot or space: "nul" is the null device wherever it is named, "a." is
    // "a"); on Linux and macOS they are names like any other.
    val windows = linuxHostIsWindows()
    for (odd in ["nul", "Aux.txt", "com1", "CONIN$", "a.", "a "]) {
        val oddPath = AnchoredPath("$anchoredRoot/a/b/$odd")
        val written = oddPath.writeText("x")
        anchoredCheck("odd name '$odd'", written != windows)
        if (written) oddPath.remove()
    }
    Path(anchoredRoot).removeTree()
    if (anchoredFailures == 0) {
        println("anchored: ok")
        return 42
    }
    1
}
