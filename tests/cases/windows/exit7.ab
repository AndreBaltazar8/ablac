// The smallest Windows program (W1a, docs/design/windows-target.md): no runtime, no C library, one import. abla_start is the PE entry point
// (lld-link /entry:abla_start); it ends the process through kernel32 with status 7.
noescape extern:"c" fun ExitProcess(code: i32): i32

@export("abla_start")
fun start(): i32 = ExitProcess(7)
