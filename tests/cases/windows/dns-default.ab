// The resolver's default configuration (abla/dns): what /etc/resolv.conf and /etc/hosts name on Linux is, on Windows, the system's DNS
// servers (iphlpapi's GetNetworkParams, the runtime's system call 4007) and %SystemRoot%\System32\drivers\etc\hosts. A machine with
// no DNS server configured would fail this on both systems. tools/test-windows-programs.sh compares it with the Linux run.
import "abla/io"
import "abla/dns"
import "abla/text"

fun main: int {
    val configuration = dnsReadConfiguration()
    var valid = configuration.nameservers.size > 0
    for (server in configuration.nameservers) {
        if (server.size < 7 || server.indexOf(".") < 0) valid = false
    }
    println("nameservers $valid")
    println("hosts ${dnsHostsText("/etc/hosts").size > 0}")
    if (dnsChooseServer("", configuration) != "") 42 else 1
}
