// homePath on a hosted Windows program (tools/test-windows-programs.sh): HOME when it is set and not empty, otherwise USERPROFILE, in the
// canonical `/` form; a Windows program has no /etc/passwd. The same program built for Linux gives HOME, or the passwd home when it is
// unset, so it compares with the environment the way the test does, not with a fixed path.
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/sys/linux/process"

fun main: int {
    val home = linuxEnvironment("HOME")
    val profile = linuxEnvironment("USERPROFILE")
    val found = homePath()
    if (found == null) {
        println("home none")
        return 1
    }
    println("home set ${found.text.size > 0} absolute ${found.isAbsolute()}")
    var expected = ""
    if (home.found && home.value != "") expected = home.value
    else if (profile.found && profile.value != "") expected = profile.value.replace("\\", "/")
    if (expected != "" && found.text != expected) {
        println("home differs: ${found.text} ${expected}")
        return 1
    }
    42
}
