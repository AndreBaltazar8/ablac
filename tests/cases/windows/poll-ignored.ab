// poll ignores an entry whose descriptor is negative: its revents is 0 and it is not counted, as on Linux (programs use -1 for an entry to skip).
// The translation answered such an entry as a file that is ready for what was asked.
import "abla/io"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun main: int {
    val entries = nativeByteBuffer(16)
    // { fd -1, events POLLIN | POLLOUT, revents 0 }
    entries.storeI64(0, 4294967295 + 5 * 4294967296)
    entries.storeI64(8, 0)
    val ready = linuxSyscall3(7, nativePointerAddress(entries.address), 1, 0)
    println("ready $ready revents ${entries.load(6) + entries.load(7) * 256}")
    42
}
