// dup2 on a hosted Windows program (the live REPL silences standard error around a reload: dup2 of /dev/null onto 2, then back).
// A descriptor duplicated onto 1 takes the standard output's place, whether the original is closed or not, and putting a saved
// duplicate back restores it; onto a number above 2 it is an independent descriptor; a descriptor that is not open is EBADF (-9).
import "abla/io"
import "abla/fs"
import "abla/sys/linux"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun main: int {
    val steps: array<string> = []
    // standard output into a file, and back
    val file = linuxOpen("dup2-file.txt", 577, 420).descriptor
    val saved = linuxSyscall3(72, 1, 0, 10)
    steps.append("saved ${saved >= 10}")
    steps.append("onto 1 ${linuxSyscall2(33, file, 1)}")
    linuxSyscall1(3, file)
    linuxWrite(1, "captured\n")
    steps.append("back ${linuxSyscall2(33, saved, 1)}")
    linuxSyscall1(3, saved)
    for (step in steps) println(step)
    println("file holds ${path("dup2-file.txt").readText().trim()}")
    // onto a descriptor above 2, and the original closed
    val reading = linuxOpen("dup2-file.txt", 0).descriptor
    steps.clear()
    steps.append("onto 20 ${linuxSyscall2(33, reading, 20)}")
    linuxSyscall1(3, reading)
    val buffer = nativeByteBuffer(16)
    val count = linuxSyscall3(0, 20, nativePointerAddress(buffer.address), 16)
    steps.append("read through 20 $count")
    steps.append("same number ${linuxSyscall2(33, 20, 20)}")
    steps.append("not open ${linuxSyscall2(33, 99, 21)}")
    steps.append("close 20 ${linuxSyscall1(3, 20)}")
    steps.append("closed ${linuxSyscall3(0, 20, nativePointerAddress(buffer.address), 16)}")
    buffer.close()
    for (step in steps) println(step)
    path("dup2-file.txt").remove()
    0
}
