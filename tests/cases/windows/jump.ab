// The unwind-free jump pair the compile-time guard uses (W1c): abla_setjmp saves the registers, xmm6-xmm15, the stack pointer and
// the return address; abla_longjmp returns to it from a deeper frame with the value given (0 becomes 1).
import "abla/io"
import "abla/text"
import "abla/unsafe/memory/raw"

trusted noescape extern:"c" fun abla_setjmp(buffer: int): int
trusted noescape extern:"c" fun abla_longjmp(buffer: int, value: int): void

trusted fun deeper(buffer: int, depth: int): int {
    if (depth == 0) abla_longjmp(buffer, 7)
    deeper(buffer, depth - 1) + 1
}

trusted fun main: int {
    val storage = "0123456789abcdef".repeat(40)
    val buffer = nativeStringAddress(storage)
    val first = abla_setjmp(buffer)
    if (first == 0) {
        println("armed")
        deeper(buffer, 20)
        println("not reached")
        return 1
    }
    println("jumped $first")
    0
}
