// A hosted Windows program's crash reports (tools/test-windows-crash.sh): a panic (`panic`, an index out of bounds), a bad
// store (`store`, at address 16), a copy from address 16 inside memcpy (`copy`), an illegal instruction (`trap`) and unbounded recursion (`overflow`).
import "abla/io"
import "abla/process"
import "abla/unsafe/memory/raw"

// Not a tail call, nor one LLVM can turn into a loop (`-` doesn't commute).
fun deep(n: int): int = if (n == 0) 0 else n - deep(n - 1)

trusted fun badStore(): int {
    ablaUnsafeStoreU8(nativePointerFromAddress(16), 1)
    return 0
}

fun pick(k: int): int {
    val ints = [1, 2, 3]
    ints[k]
}

fun main {
    val which = if (processArgumentCount() > 0) processArgument(0) else ""
    if (which == "panic") println("${pick(processArgumentCount() + 4)}")
    if (which == "store") println("${badStore()}")
    if (which == "copy") println("${badCopy(processArgumentCount())}")
    if (which == "thread-panic") {
        val worker = thread { pick(processArgumentCount() + 4) }
        println("${await worker}")
    }
    if (which == "overflow") println("${deep(processArgumentCount() * 1000000000)}")
    println("ok ${deep(1000)}")
}

// A copy that faults inside memcpy (from address 16, a length LLVM cannot inline), in a function of its own: the stack names it
// after the faulting instruction, which memcpy's unwind data lets the walk step past.
@noinline
trusted fun badCopy(extra: int): int {
    val buffer = nativeStaticAllocate(4096)
    ablaUnsafeCopyMemory(buffer, 16, 1024 + extra)
    ablaUnsafeLoadI64(nativePointerFromAddress(buffer))
}
