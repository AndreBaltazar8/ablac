// What a started program inherits (#1139 area 9): its standard streams and nothing else. The parent makes a pipe whose ends are inheritable (bInheritHandle: what any
// code in the process may have made, and what the spawn makes of a descriptor it passes as a stream for the moment of its own call), starts this program again with the
// number of an end, and the child asks whether it has that handle. CreateProcessW with handle inheritance on gave a child every inheritable handle of the process:
// the child had it. With the list of the three streams (PROC_THREAD_ATTRIBUTE_HANDLE_LIST) it does not.
// (The kernel32 calls are the Windows runtime's own declarations, which a program that names the runtime shares.)
import "abla/io"
import "abla/text"
import "abla/integer"
import "abla/sys/linux/process"
import "abla/runtime/platform/windows"
import "abla/process/command"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// Whether this process has `handle`: SetHandleInformation succeeds on one it has (a mask of nothing changes nothing).
trusted fun hasHandle(handle: int): bool = SetHandleInformation(handle, 0, 0) != 0

// An anonymous pipe whose two ends are inheritable: the write end's number, or 0.
trusted fun inheritablePipe(): int {
    val security = nativeByteBuffer(24)
    security.storeI64(0, 24)
    security.storeI64(8, 0)
    security.storeI64(16, 1)
    val handles = nativeByteBuffer(16)
    if (CreatePipe(nativePointerAddress(handles.address), nativePointerAddress(handles.address) + 8, nativePointerAddress(security.address), 4096) == 0) return 0
    val writeEnd = handles.loadI64(8)
    writeEnd
}

fun main: int {
    if (linuxArgumentCount() == 2 && linuxArgument(0) == "probe") {
        println("child has the handle: ${hasHandle(linuxArgument(1).parseInt() ?? 0)}")
        return 0
    }
    val writeEnd = inheritablePipe()
    if (writeEnd == 0) {
        println("no pipe")
        return 1
    }
    val outcome = command(linuxArgument(-1)).argument("probe").argument("$writeEnd").captureText()
    print(outcome)
    42
}
