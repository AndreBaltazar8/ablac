// What a hosted Windows program learns about itself through the Linux calls the compiler makes before it reaches LLVM
// (tools/test-windows-syscalls.sh): its stack and descriptor limits (getrlimit), the CPUs it may run on (sched_getaffinity),
// and its own executable by the name /proc/self/exe (readlink, stat).
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/metrics"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

fun main {
    val stack = linuxStackLimits()
    println("stack ${if (stack.size == 2) "${stack[0]} ${stack[1]}" else "unread"}")
    println("descriptors ${processMaximumDescriptors()}")
    val mask = nativeByteBuffer(128)
    val written = linuxSyscall3(204, 0, 128, nativePointerAddress(mask.address))
    var cpus = 0
    var word = 0
    while (word * 8 < written) {
        var bits = mask.loadI64(word * 8)
        while (bits != 0) {
            cpus = cpus + 1
            bits = bits & (bits - 1)
        }
        word = word + 1
    }
    mask.close()
    println("affinity ${written} bytes, ${if (cpus >= 1) "some" else "no"} CPUs")
    val image = Path("/proc/self/exe")
    println("image ${image.linkTarget()}")
    println("image exists ${image.exists()}")
}
