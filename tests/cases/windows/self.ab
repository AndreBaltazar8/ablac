// What a hosted Windows program learns about itself through the Linux calls the compiler makes before it reaches LLVM
// (tools/test-windows-syscalls.sh): its stack and descriptor limits (getrlimit), the CPUs it may run on (sched_getaffinity),
// and its own executable by the name /proc/self/exe (readlink, stat); and what it links that a C library gives elsewhere.
import "abla/io"
import "abla/float/text"
import "abla/fs"
import "abla/process"
import "abla/process/metrics"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// Two C functions the compiler names (its heap trim, emutls's key) that a Windows program gets from the backend.
noescape extern:"c" fun malloc_trim(pad: int): int
noescape extern:"c" fun pthread_key_create(key: i64, destructor: i64): i32

fun remainderOf(x: f64, y: f64): f64 = x % y

fun main {
    // A float `%` is the runtime's remainder, not the C library's fmod.
    val divisor = if (processArgumentCount() > 5) 3.0 else 2.0
    println("remainder ${remainderOf(7.5, divisor)}")
    println("trim ${malloc_trim(0)} key ${pthread_key_create(0, 0)}")
    val stack = linuxStackLimits()
    println("stack ${if (stack.size == 2) "${stack[0]} ${stack[1]}" else "unread"}")
    println("descriptors ${processMaximumDescriptors()}")
    val mask = nativeByteBuffer(128)
    val written = linuxSyscall3(204, 0, 128, nativePointerAddress(mask.address))
    var cpus = 0
    var word = 0
    while (word * 8 < written) {
        var bits = mask.loadI64(word * 8)
        while (bits != 0) {
            cpus = cpus + 1
            bits = bits & (bits - 1)
        }
        word = word + 1
    }
    mask.close()
    println("affinity ${written} bytes, ${if (cpus >= 1) "some" else "no"} CPUs")
    // fchmod: the owner's write bit is the read-only attribute, which fstat reads back (0444, 292, or 0644, 420).
    Path("self-mode.txt").writeText("mode")
    val descriptor = linuxSyscall4(257, -100, nativeCStringAddress("self-mode.txt"), 1, 0)
    val status = nativeByteBuffer(144)
    var modes = ""
    for (mode in [0o444, 0o644]) {
        val changed = linuxSyscall2(91, descriptor, mode)
        linuxSyscall2(5, descriptor, nativePointerAddress(status.address))
        modes = "$modes ${changed}:${status.loadI64(24) & 4095}"
    }
    status.close()
    linuxSyscall1(3, descriptor)
    Path("self-mode.txt").remove()
    println("fchmod$modes")
    // /dev/null is the null device (NUL): it takes a write and reads empty. (Wine resolves the name itself, so only the windows-run
    // job, on Windows, tells the runtime's mapping from no mapping.)
    println("null ${Path("/dev/null").writeText("gone")} ${Path("/dev/null").readText().size}")
    val image = Path("/proc/self/exe")
    println("image ${image.linkTarget()}")
    println("image exists ${image.exists()}")
}
