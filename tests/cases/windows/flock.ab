// flock on a hosted Windows program (the standard library's FileLock, and the compiler's --fast runtime cache lock, which a Windows
// build died of: flock was not translated). Two descriptors of one file conflict as two open files do on Linux: an exclusive lock
// keeps the other out, shared locks share, unlocking lets the other in, and a lock converts when its holder asks again.
import "abla/io"
import "abla/fs"
import "abla/sys/linux"

val shared = 1
val exclusive = 2
val nonBlocking = 4
val unlock = 8

trusted fun lock(descriptor: int, operation: int): int = linuxSyscall2(73, descriptor, operation)

trusted fun main: int {
    path("flock-file.txt").writeText("lock me\n")
    val a = linuxOpen("flock-file.txt", 0).descriptor
    val b = linuxOpen("flock-file.txt", 0).descriptor
    var ok = a >= 0 && b >= 0
    val steps: array<string> = []
    steps.append("a exclusive ${lock(a, exclusive | nonBlocking)}")
    steps.append("b exclusive busy ${lock(b, exclusive | nonBlocking)}")
    steps.append("b shared busy ${lock(b, shared | nonBlocking)}")
    steps.append("a unlock ${lock(a, unlock)}")
    steps.append("b exclusive ${lock(b, exclusive | nonBlocking)}")
    steps.append("a shared busy ${lock(a, shared | nonBlocking)}")
    steps.append("b unlock ${lock(b, unlock)}")
    steps.append("a shared ${lock(a, shared | nonBlocking)}")
    steps.append("b shared ${lock(b, shared | nonBlocking)}")
    steps.append("b exclusive busy ${lock(b, exclusive | nonBlocking)}")
    steps.append("b unlock ${lock(b, unlock)}")
    steps.append("a converts to exclusive ${lock(a, exclusive | nonBlocking)}")
    steps.append("a converts back ${lock(a, shared)}")
    steps.append("b shared ${lock(b, shared | nonBlocking)}")
    steps.append("unlock of nothing ${lock(a, unlock)} ${lock(a, unlock)}")
    for (step in steps) println(step)
    linuxSyscall1(3, a)
    linuxSyscall1(3, b)
    path("flock-file.txt").remove()
    if (ok) 42 else 1
}
