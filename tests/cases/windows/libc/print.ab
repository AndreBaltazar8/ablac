// The Windows compiler's own C library's printf into memory (src/static_libc/windows/io.ab): __stdio_common_vsprintf with options 2
// (C's snprintf), 0 (_vsnprintf), 1 (its legacy NUL) and 3, for every count from 0 to 12 over a 10-byte text, then snprintf(NULL, 0),
// sprintf (a count of SIZE_MAX) and __stdio_common_vsprintf_s with room. Each line: the result and the first 16 bytes of a 64-byte zone
// of 0xAA, and OVER<n> when n bytes at or past the count changed. tools/test-windows-libc.sh compares it with print-expected.txt.
import "abla/io"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "../../../../src/static_libc/windows/io.ab"

// The C library's exit (process.ab) runs this table, which tools/windows/static-compiler/crt-free-start.cpp has in the compiler.
@export("abla_crt_run_exit_table")
fun printExitTable(): void {
    return
}

/** Two lower-case hexadecimal digits of the byte `b`. */
fun printHex(b: int): string {
    val digits = "0123456789abcdef"
    digits.slice(b >> 4, (b >> 4) + 1) + digits.slice(b & 15, (b & 15) + 1)
}

/** Fills the 64-byte zone with 0xAA. */
trusted fun printClear(zone: int): void {
    var i = 0
    while (i < 64) {
        ablaRuntimeStoreU8(zone + i, 170)
        i = i + 1
    }
    return
}

/** The bytes of the zone at or past `count` that changed. */
trusted fun printOver(zone: int, count: int): int {
    var over = 0
    var i = count
    while (i < 64) {
        if (ablaRuntimeLoadU8(zone + i) != 170) over = over + 1
        i = i + 1
    }
    over
}

trusted fun main {
    val zone = nativeStaticAllocate(64)
    val list = nativeStaticAllocate(16)
    val text = nativeStaticBytes("0123456789\x00")
    val format = nativeStaticBytes("%s\x00")
    for (options in [2, 0, 1, 3]) {
        var count = 0
        while (count <= 12) {
            printClear(zone)
            ablaRuntimeStoreI64(list, text)
            val result = windowsVsprintf(options, zone, count, format, 0, list)
            var bytes = ""
            var i = 0
            while (i < 16) {
                bytes = bytes + printHex(ablaRuntimeLoadU8(zone + i))
                i = i + 1
            }
            val over = printOver(zone, count)
            println("options $options count $count: $result $bytes${if (over != 0) " OVER$over" else ""}")
            count = count + 1
        }
    }
    ablaRuntimeStoreI64(list, text)
    println("snprintf(NULL, 0): ${windowsVsprintf(2, 0, 0, format, 0, list)}")
    printClear(zone)
    ablaRuntimeStoreI64(list, text)
    val endless = windowsVsprintf(0, zone, -1, format, 0, list)
    println("sprintf: $endless, NUL ${ablaRuntimeLoadU8(zone + 10)}, over ${printOver(zone, 11)}")
    var room = 11
    while (room <= 12) {
        printClear(zone)
        ablaRuntimeStoreI64(list, text)
        val result = windowsVsprintfS(0, zone, room, format, 0, list)
        println("sprintf_s room $room: $result, NUL ${ablaRuntimeLoadU8(zone + 10)}, over ${printOver(zone, room)}")
        room = room + 1
    }
}
