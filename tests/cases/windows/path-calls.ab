// The path calls of a hosted Windows program that the Windows runtime translated late (tools/test-windows-syscall-coverage.sh named them):
// chmod (Path.setPermissions), link (the compiler's codegen units), utimes (touching one), and pread64 (the ELF reader). Each prints what
// the same program prints on Linux: a mode read back with stat keeps its owner write bit as chmod set it (Windows has the read-only
// attribute and no other bit), a hard link reads the same bytes, a touch leaves the file as old as now, and pread reads at an offset
// without moving the position.
import "abla/io"
import "abla/fs"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

fun ownerCanWrite(file: string): bool {
    val buffer = nativeByteBuffer(256)
    val status = linuxSyscall2(4, nativeCStringAddress(file), nativePointerAddress(buffer.address))
    val mode = buffer.load(24) + buffer.load(25) * 256
    buffer.close()
    status == 0 && (mode & 128) != 0
}

fun main: int {
    path("pc-a.txt").writeText("hello pread world")
    path("pc-b.txt").remove()
    // pread64
    val input = linuxOpen("pc-a.txt", 0).descriptor
    val buffer = nativeByteBuffer(64)
    val got = linuxSyscall4(17, input, nativePointerAddress(buffer.address), 5, 6)
    println("pread $got ${buffer.adoptString(got)}")
    val position = linuxSyscall3(8, input, 0, 1)
    println("position $position")
    val past = nativeByteBuffer(8)
    println("pread past the end ${linuxSyscall4(17, input, nativePointerAddress(past.address), 4, 100)}")
    past.close()
    linuxSyscall1(3, input)
    // link
    println("link ${linuxSyscall2(86, nativeCStringAddress("pc-a.txt"), nativeCStringAddress("pc-b.txt"))}")
    println("linked ${path("pc-b.txt").readText()}")
    println("link again ${linuxSyscall2(86, nativeCStringAddress("pc-a.txt"), nativeCStringAddress("pc-b.txt"))}")
    println("link of nothing ${linuxSyscall2(86, nativeCStringAddress("pc-none.txt"), nativeCStringAddress("pc-c.txt"))}")
    // chmod
    println("writable ${ownerCanWrite("pc-a.txt")}")
    println("chmod 444 ${path("pc-a.txt").setPermissions(0o444)} writable ${ownerCanWrite("pc-a.txt")}")
    println("chmod 644 ${path("pc-a.txt").setPermissions(0o644)} writable ${ownerCanWrite("pc-a.txt")}")
    println("chmod of nothing ${path("pc-none.txt").setPermissions(0o644)}")
    // utimes(path, null)
    val before = path("pc-a.txt").revision()
    println("touch ${linuxSyscall2(235, nativeCStringAddress("pc-a.txt"), 0)}")
    val after = path("pc-a.txt").revision()
    println("touched ${after >= before}")
    println("touch of nothing ${linuxSyscall2(235, nativeCStringAddress("pc-none.txt"), 0) < 0}")
    path("pc-a.txt").remove()
    path("pc-b.txt").remove()
    42
}
