// Touch and read a dynamic stack allocation that crosses several guard pages.
import "abla/process/arguments"
import "abla/unsafe/memory/raw"

@noinline trusted fun fillPages(address: int, pages: int): void {
    var page = 0
    while (page < pages) {
        ablaUnsafeStoreU8(nativePointerFromAddress(address + page * 4096), page + 1)
        page += 1
    }
    return
}

@noinline trusted fun sumPages(address: int, pages: int): int {
    var total = 0
    var page = 0
    while (page < pages) {
        total += ablaUnsafeLoadU8(nativePointerFromAddress(address + page * 4096))
        page += 1
    }
    total
}

trusted fun probe(pages: int): int {
    val address = nativeStackAllocate(pages * 4096)
    fillPages(address, pages)
    if (sumPages(address, pages) == pages * (pages + 1) / 2) 42 else 1
}

fun main: int = probe(8 + (processArgumentCount() & 1))
