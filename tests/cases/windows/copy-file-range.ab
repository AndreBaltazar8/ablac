// copy_file_range (326) on a hosted Windows program: the compiler's in-process file copy (bootstrapCopyFileInProcess, src/toolchain.ab) calls it
// until it answers 0, and a default `ablac build` publishes every object that way (the compiler cache failed with "unsupported system call
// 326" on Windows). Copies a file of more than two chunks and compares the bytes; an explicit offset is refused.
import "abla/io"
import "abla/fs"
import "abla/sys/linux"

fun main: int {
    var content = ""
    var index = 0
    while (index < 20000) {
        content = content + "line $index of the file to copy\n"
        index = index + 1
    }
    path("copy-source.txt").writeText(content)
    val input = linuxOpen("copy-source.txt", 0)
    val output = linuxOpen("copy-target.txt", 577, 420)
    var total = 0
    var calls = 0
    var finished = false
    while (!finished && calls < 100) {
        val count = linuxSyscall6(326, input.descriptor, 0, output.descriptor, 0, 1073741824, 0)
        if (count <= 0) finished = true else total = total + count
        calls = calls + 1
    }
    println("copied ${total == content.size}")
    val refused = linuxSyscall6(326, input.descriptor, 8, output.descriptor, 0, 100, 0)
    println("offset refused ${refused < 0}")
    linuxSyscall1(3, input.descriptor)
    linuxSyscall1(3, output.descriptor)
    val same = path("copy-target.txt").readText() == content
    println("same bytes $same")
    path("copy-source.txt").remove()
    path("copy-target.txt").remove()
    if (same && total == content.size) 42 else 1
}
