// Inline assembly in many functions: the backend gathers each one's template for a held
// module before it emits functions, as each function's emission frees what it allocates.
// Gathered during emission instead, the list's storage was freed under it and a build
// with enough of them corrupted the compiler's heap (an Xtensa firmware build ran out of
// memory, then crashed).

trusted noescape extern:"inline-assembly" fun assemblyVoid(
    template: string,
    constraints: string
): void

trusted fun step0(): void = assemblyVoid("nop # step 0", "~{memory}")
