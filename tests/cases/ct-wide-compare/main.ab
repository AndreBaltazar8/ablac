// A `#` site whose code compares int128s (`<` calls abla/int128's int128Less, which no code names) and writes one in a
// template (int128Text), as the game client's exchange code does (#1022). The native slice kept neither, so its
// analysis failed ("import \"abla/int128\" to compare a int128") and every site of the pass ran in the interpreter.
import "abla/io"
import "abla/int128"

fun quote(reserveIn: int, reserveOut: int, amount: int): string {
    var best = int128(0)
    var step = 1
    while (step <= amount) {
        val out = (int128(reserveOut) * int128(step)) / (int128(reserveIn) + int128(step))
        if (out > best && out != int128(reserveOut)) best = out
        step += 1
    }
    "$best:${best >= int128(9)}"
}

val quoted = #quote(1000, 5000, 3)

fun main {
    println("${quote(1000, 5000, 3)} $quoted")
}
