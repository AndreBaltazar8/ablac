// Integer text: every width and the edges of the digit counts, of the table of small
// numbers (0 to 999) and of the signed range, against a reference written in plain Abla
// (divisions and remainders only), natively (through opaque identities) and under `#`.
import "abla/io"

@noinline fun idInt(x: int): int = x
@noinline fun idI8(x: i8): i8 = x
@noinline fun idI16(x: i16): i16 = x
@noinline fun idI32(x: i32): i32 = x
@noinline fun idU8(x: u8): u8 = x
@noinline fun idU16(x: u16): u16 = x
@noinline fun idU32(x: u32): u32 = x
@noinline fun idU64(x: u64): u64 = x

// The decimal text of `value` by repeated division, the digit of the negative remainder.
fun reference(value: int): string {
    if (value == 0) return "0"
    var text = ""
    var rest = if (value > 0) 0 - value else value
    while (rest < 0) {
        val quotient = rest / 10
        val digit = quotient * 10 - rest
        text = "${digit}" + text
        rest = quotient
    }
    if (value < 0) "-" + text else text
}

fun edges(): array<int> {
    val out: array<int> = []
    var power = 1
    var i = 0
    while (i < 19) {
        out.append(power - 1)
        out.append(power)
        out.append(power + 1)
        out.append(0 - power + 1)
        out.append(0 - power)
        out.append(0 - power - 1)
        out.append(power * 2 - 1)
        out.append(power * 9)
        power = power * 10
        i = i + 1
    }
    out.append(9223372036854775807)
    out.append(-9223372036854775807)
    out.append(-9223372036854775807 - 1)
    out.append(4294967295)
    out.append(2147483647)
    out.append(-2147483648)
    out.append(32767)
    out.append(-32768)
    out
}

fun natively(): array<string> {
    val out: array<string> = []
    var x = -2100
    while (x <= 2100) {
        out.append("${idInt(x)}")
        x = x + 1
    }
    for (e in edges()) out.append("${idInt(e)}")
    out.append("${idI8(-128)} ${idI8(127)} ${idI8(0)} ${idI8(-1)} ${idI8(99)} ${idI8(100)}")
    out.append("${idI16(-32768)} ${idI16(32767)} ${idI16(999)} ${idI16(1000)} ${idI16(-999)}")
    out.append("${idI32(-2147483648)} ${idI32(2147483647)} ${idI32(1000)} ${idI32(999)}")
    out.append("${idU8(255)} ${idU8(0)} ${idU8(9)} ${idU8(10)} ${idU8(100)} ${idU8(200)}")
    out.append("${idU16(65535)} ${idU16(1000)} ${idU16(999)} ${idU16(0)}")
    out.append("${idU32(4294967295)} ${idU32(1000)} ${idU32(999)} ${idU32(0)}")
    out
        .append("${idU64(u64(18446744073709551615))} ${idU64(u64(9223372036854775808))} ${idU64(u64(1000))} ${idU64(u64(999))}")
    out
}

compile fun staged(): array<string> {
    val out: array<string> = []
    var x = -2100
    while (x <= 2100) {
        out.append("${x}")
        x = x + 1
    }
    for (e in edges()) out.append("${e}")
    out.append("${i8(-128)} ${i8(127)} ${i8(0)} ${i8(-1)} ${i8(99)} ${i8(100)}")
    out.append("${i16(-32768)} ${i16(32767)} ${i16(999)} ${i16(1000)} ${i16(-999)}")
    out.append("${i32(-2147483648)} ${i32(2147483647)} ${i32(1000)} ${i32(999)}")
    out.append("${u8(255)} ${u8(0)} ${u8(9)} ${u8(10)} ${u8(100)} ${u8(200)}")
    out.append("${u16(65535)} ${u16(1000)} ${u16(999)} ${u16(0)}")
    out.append("${u32(4294967295)} ${u32(1000)} ${u32(999)} ${u32(0)}")
    out.append("${u64(18446744073709551615)} ${u64(9223372036854775808)} ${u64(1000)} ${u64(999)}")
    out
}

fun main: int {
    val native = natively()
    val evaluated = #staged()
    var bad = 0
    if (native.size != evaluated.size) bad = bad + 1000
    var i = 0
    while (i < native.size && i < evaluated.size) {
        if (native[i] != evaluated[i]) {
            bad = bad + 1
            if (bad < 6) println("native ${native[i]} staged ${evaluated[i]}")
        }
        i = i + 1
    }
    // The reference, over the plain integers (the first 4201 and the edges).
    val values: array<int> = []
    var x = -2100
    while (x <= 2100) {
        values.append(x)
        x = x + 1
    }
    for (e in edges()) values.append(e)
    var k = 0
    while (k < values.size) {
        val expected = reference(values[k])
        if (native[k] != expected) {
            bad = bad + 1
            if (bad < 6) println("value ${values[k]} native ${native[k]} reference ${expected}")
        }
        k = k + 1
    }
    if (bad == 0) 42 else 1
}
