// error: region.parameter-retention:stash#0
// The same through a field of the parameter: `holder.keeper.keep(value)` calls Keeper.keep on an outer Keeper.
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

class Holder(val keeper: Keeper)

fun stash(var holder: Holder, value: string): void = holder.keeper.keep(value)

fun main {
    val outer = Keeper([])
    val holder = Holder(outer)
    val n = region {
        stash(holder, "region-" + "text")
        0
    }
    println("${outer.log.size} $n")
}
