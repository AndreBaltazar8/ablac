// error: region.parameter-retention:stash#0
// A method called on an element of a parameter keeps its argument in that element: the element is outer, so the call
// stores the region's string out of the region.
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

fun stash(var keepers: array<Keeper>, value: string): void = keepers[0].keep(value)

fun main {
    val outer = Keeper([])
    val keepers = [outer]
    val n = region {
        stash(keepers, "region-" + "text")
        0
    }
    println("${outer.log.size} $n")
}
