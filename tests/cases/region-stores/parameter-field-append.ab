// error: region.parameter-retention:stash#0
// An append into a field of a parameter: `box.items.append(value)` keeps the region's string in an outer array.
import "abla/io"

class Box(val items: array<string>)

fun stash(var box: Box, value: string): void = box.items.append(value)

fun main {
    val box = Box([])
    val n = region {
        stash(box, "region-" + "text")
        0
    }
    println("${box.items.size} $n")
}
