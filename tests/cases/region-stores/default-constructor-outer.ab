// error: region.receiver-retention:Keeper.keep
// A default the constructor call leaves to the class is what the object is made of too (here the module's array, through a
// function; the ownership check refuses the mutation as well).
import "abla/io"
val moduleLog: array<string> = []
fun moduleArray(): array<string> = moduleLog
class Keeper(val log: array<string> = moduleArray()) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}
fun main {
    val n = region {
        Keeper().keep("region-" + "text")
        0
    }
    println("${moduleLog.size} $n")
}
