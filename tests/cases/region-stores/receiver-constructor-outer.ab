// error: region.receiver-retention:Keeper.keep
// A constructor's object made over an outer array is not the region's own: the store goes into the array.
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

fun main {
    val outer: array<string> = []
    val n = region {
        Keeper(outer).keep("region-" + "text")
        0
    }
    println("${outer.size} $n")
}
