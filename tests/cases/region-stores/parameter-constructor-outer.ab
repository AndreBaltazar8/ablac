// error: region.parameter-retention:stash#0
// The same through a function that keeps its second argument in its first.
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

fun stash(var keeper: Keeper, value: string): void = keeper.keep(value)

fun main {
    val outer: array<string> = []
    val n = region {
        stash(Keeper(outer), "region-" + "text")
        0
    }
    println("${outer.size} $n")
}
