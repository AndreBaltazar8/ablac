// error: region.escape:append
// The same through an object of the region that holds the lambda and calls it.
import "abla/io"

class Box(val run: (string) -> void) {
    fun keep(value: string): void {
        this.run(value)
        return
    }
}

fun main {
    val outer: array<string> = []
    val n = region {
        val small = "region-" + "text"
        Box({ s: string -> outer.append(s) }).keep(small)
        0
    }
    println("${outer.size} $n")
}
