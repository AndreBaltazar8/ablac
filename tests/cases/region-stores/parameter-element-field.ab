// error: region.parameter-retention:stash#0
// A field store into an element of a parameter: `notes[0].text = value` keeps the region's string in an outer object.
import "abla/io"

class Note(var text: string)

fun stash(var notes: array<Note>, value: string): void {
    notes[0].text = value
    return
}

fun main {
    val notes = [Note("")]
    val n = region {
        stash(notes, "region-" + "text")
        0
    }
    println("${notes[0].text.size} $n")
}
