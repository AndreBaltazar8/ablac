// ok
// Objects the region makes may keep region values: a constructor's, a factory's that returns a constructor's (byteBuffer() and a
// program's own), and a lambda made in the region kept by one.
import "abla/io"
import "abla/bytes"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

class Actions(val run: array<() -> int>) {
    fun add(action: () -> int): void {
        this.run.append(action)
        return
    }
}

fun freshKeeper(): Keeper {
    val made = Keeper([])
    made
}

fun main {
    val n = region {
        val small = "region-" + "text"
        val buffer = byteBuffer()
        buffer.appendText(small)
        val direct = Keeper([])
        direct.keep(small)
        val made = freshKeeper()
        made.keep(small)
        val actions = Actions([])
        actions.add({ -> small.size })
        buffer.size() + direct.log.size + made.log.size + actions.run[0]()
    }
    println("$n")
}
