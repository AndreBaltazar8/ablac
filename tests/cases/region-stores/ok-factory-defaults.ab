// ok
// A factory that leaves a constructor's value defaults out returns the region's own object: the call is lowered to a
// block of temporaries, and what the object is made of is what they hold.
import "abla/io"

class Log(val lines: array<string>, var count: int, var label: string = "") {
    fun keep(value: string): void {
        this.lines.append(value)
        this.count = this.count + 1
        return
    }
}

fun log(): Log = Log([], 0)

fun named(): Log = Log(count = 0, lines = [])

fun main {
    val n = region {
        val small = "region-" + "text"
        val first = log()
        first.keep(small)
        val second = named()
        second.keep(small)
        first.count + second.count
    }
    println("$n")
}
