// error: region.receiver-retention:Keeper.keep
// The same through a factory that wraps its argument: its result is made of a parameter.
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

fun wrap(log: array<string>): Keeper = Keeper(log)

fun main {
    val outer: array<string> = []
    val n = region {
        wrap(outer).keep("region-" + "text")
        0
    }
    println("${outer.size} $n")
}
