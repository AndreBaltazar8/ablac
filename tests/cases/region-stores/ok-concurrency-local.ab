// ok
resource class Item(var name: string)

fun length(var item: Item): int { item.name.size }

fun main {
    val n = region {
        val m = Mutex(Item("a" + "b"))
        val worker = m.clone()
        val th = thread { worker.with(length) }
        val t = task { 3 }
        (await th) + (await t)
    }
}
