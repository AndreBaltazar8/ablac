// error: region.receiver-retention:Keeper.keep
// A function's result is not the region's when the function returns an object made outside it (here a module value).
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

val shared = Keeper([])

fun sharedKeeper(): Keeper = shared

fun main {
    val n = region {
        val target = sharedKeeper()
        target.keep("region-" + "text")
        0
    }
    println("$n")
}
