// error: region.escape:field.last
// The same through a field: `holder.last = part` keeps the region's string.
class Holder(var last: string)

fun main {
    val holder = Holder("")
    val n = region {
        val parts: array<string> = []
        parts.append("a" + "b")
        for (part in parts) holder.last = part
        0
    }
}
