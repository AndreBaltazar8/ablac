// error: region.escape:append
// A lambda made in the region is called with the region's values: storing its parameter into an outer array it captured
// is a store out of the region.
import "abla/io"

fun main {
    val outer: array<string> = []
    val n = region {
        val small = "region-" + "text"
        val keep = { s: string -> outer.append(s) }
        keep(small)
        0
    }
    println("${outer.size} $n")
}
