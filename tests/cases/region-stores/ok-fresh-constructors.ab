// ok
// A constructor made only of fresh objects and values is the region's own: literal arrays, a nested fresh object, scalars
// and strings (also from outside), named arguments, value defaults, and a factory made of its value parameters.
import "abla/io"

class Keeper(val log: array<string>, val name: string) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

class Counted(val log: array<string>, val limit: int = 8) {
    fun keep(value: string): void {
        if (this.log.size < this.limit) this.log.append(value)
        return
    }
}

class Pair(val left: Keeper, val right: Keeper) {
    fun keep(value: string): void {
        this.left.keep(value)
        this.right.keep(value)
        return
    }
}

fun named(name: string): Keeper = Keeper([], name)

fun stash(var keeper: Keeper, value: string): void = keeper.keep(value)

fun main {
    val label = "outer"
    val n = region {
        val small = "region-" + "text"
        Keeper([], "direct").keep(small)
        Keeper(["first"], label).keep(small)
        val byName = Keeper(log = [], name = label)
        byName.keep(small)
        val counted = Counted([])
        counted.keep(small)
        val pair = Pair(Keeper([], label), Keeper([small], "right"))
        pair.keep(small)
        named(label).keep(small)
        stash(Keeper([], label), small)
        pair.left.log.size + pair.right.log.size + counted.log.size
    }
    println("$n")
}
