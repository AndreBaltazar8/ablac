// ok
// A lambda made in the region may keep its parameters in what the region owns, and store scalars out of it.
import "abla/io"

fun main {
    val counts: array<int> = []
    val n = region {
        val names: array<string> = []
        val keep = { s: string -> names.append(s) }
        val count = { s: string -> counts.append(s.size) }
        val small = "region-" + "text"
        keep(small)
        count(small)
        names.size
    }
    println("$n ${counts.size}")
}
