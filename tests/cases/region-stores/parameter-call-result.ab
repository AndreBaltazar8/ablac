// error: region.parameter-retention:store#0
// The same through a function that keeps its second argument in its first.
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

val shared = Keeper([])

fun sharedKeeper(): Keeper = shared

fun store(var keeper: Keeper, value: string): void = keeper.keep(value)

fun main {
    val n = region {
        var target = sharedKeeper()
        store(target, "region-" + "text")
        0
    }
    println("$n")
}
