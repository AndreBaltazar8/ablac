// error: region.escape:append
// An inner loop over a row of an array the region owns.
fun main {
    val names: array<string> = []
    val n = region {
        val row: array<string> = []
        row.append("a" + "b")
        val rows: array<array<string>> = []
        rows.append(row)
        for (each in rows) for (part in each) names.append(part)
        0
    }
}
