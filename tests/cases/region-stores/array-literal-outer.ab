// error: region.parameter-retention:stashFirst#0
// An array literal of outer objects is not the region's own either: a store into its element is one into the outer object.
import "abla/io"

class Keeper(val log: array<string>) {
    fun keep(value: string): void {
        this.log.append(value)
        return
    }
}

fun stashFirst(var keepers: array<Keeper>, value: string): void = keepers[0].keep(value)

fun main {
    val outer = Keeper([])
    val n = region {
        stashFirst([outer], "region-" + "text")
        0
    }
    println("${outer.log.size} $n")
}
