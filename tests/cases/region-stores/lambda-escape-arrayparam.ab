// error: region.escape:append
// A lambda made in the region gets a region value as its parameter; keeping it past the region is refused.
import "abla/io"

fun main: int {
    val outer: array<string> = []
    region { val small = "kept-${outer.size + 40000}"; val keep = { a: array<string> -> outer.append(a[0]) }; keep([small]); 0 }
    val second = region { var t = 0; for (i in 0 until 2000) { val s = "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-${i + outer.size}"; t = t + s.size }; t }
    println("${outer[0]} $second")
    if (outer[0] != "kept-${40000}") return 11
    0
}
