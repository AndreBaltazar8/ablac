// ok
// A loop in a region may keep the elements of what it owns in what it owns, store their scalars out, and store
// the elements of an outer array out (they are not the region's).
import "abla/io"

fun main {
    val outerNames: array<string> = []
    outerNames.append("o" + "k")
    val sizes: array<int> = []
    val kept: array<string> = []
    val n = region {
        val parts: array<string> = []
        parts.append("a" + "b")
        val copies: array<string> = []
        for (part in parts) {
            copies.append(part)
            sizes.append(part.size)
        }
        for (name in outerNames) kept.append(name)
        var total = 0
        for (byte in "region") total = total + byte
        copies.size + total
    }
    println("$n ${sizes.size} ${kept.size}")
}
