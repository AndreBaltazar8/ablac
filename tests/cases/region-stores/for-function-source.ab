// error: region.escape:append
// A loop over a function's result made in the region: its elements are the region's.
fun parts(seed: int): array<string> {
    val made: array<string> = []
    made.append("part-$seed")
    made
}

fun main {
    val names: array<string> = []
    val n = region {
        for (part in parts(names.size)) names.append(part)
        0
    }
}
