// ok
// Stores through a parameter's fields and elements are allowed when what is stored is a scalar, or when the parameter is
// the region's own.
import "abla/io"

class Counter(var count: int)
class Box(val items: array<string>, val sizes: array<int>, val counter: Counter)

fun count(var box: Box, value: string): void {
    box.sizes.append(value.size)
    box.counter.count = box.counter.count + 1
    box.items.append(value)
    return
}

fun main {
    val outer = Box([], [], Counter(0))
    val n = region {
        val inner = Box([], [], Counter(0))
        count(inner, "region-" + "text")
        inner.items.size + inner.sizes.size + inner.counter.count
    }
    outer.sizes.append(n)
    println("$n ${outer.sizes.size}")
}
