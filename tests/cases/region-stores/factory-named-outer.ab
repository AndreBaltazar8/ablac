// error: region.receiver-retention:Log.keep
// A factory whose named arguments hand the constructor an outer array returns an object that is not the region's own: a
// store into it is a store into the module's array.
import "abla/io"

val kept: array<string> = []

class Log(val lines: array<string>, var count: int) {
    fun keep(value: string): void {
        this.lines.append(value)
        return
    }
}

fun outerLog(): Log = Log(count = 0, lines = kept)

fun main {
    val n = region {
        val small = "region-" + "text"
        val log = outerLog()
        log.keep(small)
        0
    }
    println("${kept.size} $n")
}
