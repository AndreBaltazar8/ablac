// error: region.escape:append
// An element of an array the region owns is the region's: the loop variable may not be stored out of it.
fun main {
    val names: array<string> = []
    val n = region {
        val parts: array<string> = []
        parts.append("a" + "b")
        for (part in parts) names.append(part)
        0
    }
}
