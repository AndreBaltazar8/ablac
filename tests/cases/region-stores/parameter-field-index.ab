// error: region.parameter-retention:stash#0
// An element store into a field of a parameter: `box.items[0] = value` keeps the region's string in an outer array.
import "abla/io"

class Box(val items: array<string>)

fun stash(var box: Box, value: string): void {
    box.items[0] = value
    return
}

fun main {
    val box = Box(["x"])
    val n = region {
        stash(box, "region-" + "text")
        0
    }
    println("${box.items[0].size} $n")
}
