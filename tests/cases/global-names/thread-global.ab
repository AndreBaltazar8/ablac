// The thread body's inner block declares its own `tally`; the `tally` after
// it is the global `var`.
var tally = 0

fun main: int {
    val worker = thread {
        val start = 1
        if (start > 0) {
            var tally = 1
            tally = tally + 1
        }
        tally = tally + 1
        0
    }
    await worker
}
