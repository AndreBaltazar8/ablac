// A program's globals named like the standard library's parameters and
// locals (`cell`, `value`, `count`, `data`, ...): the library's code, and the
// program's own, keeps reading its locals. A local is still the local once its
// scope is left (a body's result is checked after), a parameter default's
// lambda parameter is not the global of its name, and a module reads the
// globals of the modules it imports.
import "abla/unsafe/memory"
import "abla/io"
import "abla/json"
import "middle.ab"

val cell: any = 1
val value: any = "global value"
val values: array<int> = [1, 2, 3]
val text = "global text"
val count = 7
val data: any = 3
val index = 11
val key = "global key"
val keys: array<string> = ["global"]
val result = 13
var state = 0
val offset = 17
val length = 19
val byte = 23
val begin = 29
val output = "global output"
val kind = "global kind"
val capacity = 31
val address = 37
val source = "global source"
val cursor = 41
val buffer = "global buffer"
val size = 43
val found = false
val first = 47
val depth = 53
val done = false
val line = 59
var stored = 0
val released = false
val valid = false
val name = "global name"
val integer = 61
val succeeded = false
val stringValue = "global string"

class Holder(val amount: int)

// The body's result is its local `cell`, not the global.
fun makeHolder(amount: int): Holder {
    val cell = Holder(amount)
    cell
}

// A nested block's local `data`, returned from the block.
fun nestedHolder(amount: int): Holder =
    if (amount > 0) {
        val data = Holder(amount)
        data
    } else Holder(0)

// The default's lambda parameter `total` is not the global it initializes.
fun applyTwice(start: int, step: (int) -> int = { total: int -> total + 1 }): int =
    step(step(start))

val total = applyTwice(40)

fun main: int {
    var failures = 0
    val memory = nativeI64Cell(40)
    memory.store(42)
    if (memory.load() != 42) failures = failures + 1
    memory.close()
    val parsed = jsonParse("{\"value\":[1,2,3],\"text\":\"local\",\"count\":7}")
    if (!parsed.succeeded) failures = failures + 1
    if (parsed.succeeded) {
        if (parsed.value.get("value").size() != 3) failures = failures + 1
        if (parsed.value.get("text").asString() != "local") failures = failures + 1
        println(jsonStringify(parsed.value))
    }
    if (makeHolder(5).amount != 5) failures = failures + 1
    if (nestedHolder(6).amount != 6) failures = failures + 1
    if (total != 42) failures = failures + 1
    if (middleValue != 101) failures = failures + 1
    // A function of a module this one doesn't import, its default reading a
    // global of its own module.
    if (hiddenAdd(1) != 3) failures = failures + 1
    state = state + 1
    stored = count + index
    println("$text $count $index $key ${values.size} $state $stored")
    if (failures == 0) 42 else failures
}
