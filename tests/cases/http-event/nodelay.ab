// Every connection a server accepts has TCP_NODELAY: without it a response written in two pieces (an HTTP/2 HEADERS frame, then DATA) waits for the peer's
// delayed ACK, up to 40 ms (found by tools/bench-http2-client.sh: HTTP/2 tail latency of 40 ms and half the throughput). One program for both servers:
// a client connects, the server accepts it, and the accepted socket's option is read. Prints "http-event nodelay ok".
import "abla/io"
import "abla/http"
import "abla/http/event"
import "abla/http/event/tls"
import "abla/net"

fun answer(request: HttpRequest): HttpResponse = httpText("ok")

fun main: int {
    val router = httpRouter()
    router.get("/", answer)
    // The plain event server.
    val plain = httpEventServer(router, ipv4Loopback(0))
    if (plain.listener.descriptor < 0) return 1
    var client = tcpConnectIpv4("127.0.0.1", plain.listener.localPort(), 2000)
    var plainChecked = 0
    var steps = 0
    while (plainChecked == 0 && steps < 100) {
        plain.step(20)
        steps = steps + 1
        for (descriptor in plain.descriptors) {
            if (descriptor >= 0) plainChecked = if (linuxSocketNoDelay(descriptor)) 1 else -1
        }
    }
    client.close()
    if (plainChecked != 1) {
        println("FAIL the plain event server accepted a connection without TCP_NODELAY (${plainChecked})")
        return 1
    }
    // The HTTPS server (no TLS configuration: the connection is only accepted).
    val secure = httpsEventServer(router, ipv4Loopback(0))
    if (secure.listener.descriptor < 0) return 1
    client = tcpConnectIpv4("127.0.0.1", secure.listener.localPort(), 2000)
    var secureChecked = 0
    steps = 0
    while (secureChecked == 0 && steps < 100) {
        secure.step(20)
        steps = steps + 1
        for (descriptor in secure.descriptors) {
            if (descriptor >= 0) secureChecked = if (linuxSocketNoDelay(descriptor)) 1 else -1
        }
    }
    client.close()
    if (secureChecked != 1) {
        println("FAIL the HTTPS event server accepted a connection without TCP_NODELAY (${secureChecked})")
        return 1
    }
    // The helper itself: a fresh socket has Nagle on, and setNoDelay turns it off and back on.
    val probe = tcpConnectIpv4("127.0.0.1", plain.listener.localPort(), 2000)
    if (linuxSocketNoDelay(probe.descriptor)) println("note: a new socket already has TCP_NODELAY")
    probe.setNoDelay(false)
    if (linuxSocketNoDelay(probe.descriptor)) {
        println("FAIL setNoDelay(false) left TCP_NODELAY on")
        return 1
    }
    probe.setNoDelay()
    if (!linuxSocketNoDelay(probe.descriptor)) {
        println("FAIL setNoDelay left TCP_NODELAY off")
        return 1
    }
    probe.close()
    println("http-event nodelay ok")
    0
}
