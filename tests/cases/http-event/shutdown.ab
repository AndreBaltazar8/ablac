// A graceful shutdown (SIGTERM) ends an event server's run(): tcpEnableGracefulShutdown blocks SIGTERM and takes it through a signalfd,
// the program sends itself SIGTERM, and run() returns at its first pass, when tcpShutdownRequested() reads the signal record. A
// server that never saw the signal would run until the suite's time limit. Prints "http-event shutdown ok".
import "abla/io"
import "abla/net"
import "abla/http"
import "abla/http/event"
import "abla/sys/linux"

fun answer(request: HttpRequest): HttpResponse = httpText("ok")

// trusted: the program signals itself with a raw kill (62), the point of the test.
trusted fun main: int {
    if (!tcpEnableGracefulShutdown()) {
        println("http-event shutdown: no signalfd")
        return 1
    }
    val router = httpRouter()
    router.get("/", answer)
    val server = httpEventServer(router, ipv4Loopback(0))
    linuxSyscall2(62, linuxProcessId(), 15)
    server.run()
    if (!tcpShutdownRequested()) {
        println("http-event shutdown: run() returned without the request")
        return 1
    }
    println("http-event shutdown ok")
    0
}
