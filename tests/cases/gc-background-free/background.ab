// The work with background freeing on.
import "abla/io"
import "abla/memory"
import "./work.ab"

fun main: int {
    memorySetCollectionGrowth(4194304)
    memorySetBackgroundFree(true)
    val checksum = churn(roundsWanted())
    memoryCollect()
    val echoed = child()
    println("$checksum ${echoed.size} ${returned()}")
    0
}
