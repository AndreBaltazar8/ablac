// Repeatedly fork immediately after handing a batch of garbage to the helper.
// A raw fork can inherit a malloc lock held by the helper and deadlock when
// the child allocates its executable's C string before exec.
import "abla/io"
import "abla/memory"
import "./work.ab"

fun main: int {
    memorySetCollectionGrowth(268435456)
    memorySetBackgroundFree(true)
    var checksum = 0
    for (round in 0 until 100) {
        checksum = checksum + sumOf(listOf(40000, round))
        memoryCollect()
        if (child() != "child\n") return 1
    }
    println("$checksum")
    0
}
