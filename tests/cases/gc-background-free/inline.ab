// The same work with background freeing turned off (a release-built hosted Linux program has it by default, decision #107): the plain collection.
import "abla/io"
import "abla/memory"
import "./work.ab"

fun main: int {
    memorySetBackgroundFree(false)
    memorySetCollectionGrowth(4194304)
    val checksum = churn(roundsWanted())
    memoryCollect()
    val echoed = child()
    println("$checksum ${echoed.size} ${returned()}")
    0
}
