import "abla/crypto/bignum"
import "abla/ct"
import "abla/io"

trusted fun main: int {
    val n = bnAllocate(3)
    val d = bnAllocate(1)
    val r = bnAllocate(1)
    val scratch = bnAllocate(1)
    val work = bnAllocate(31)
    val q = bnAllocate(1)
    bnStore(n, secretU32(u32(10)))
    bnStore(d, secretU32(u32(2)))
    // The reviewer's 10/2 alias once returned success and quotient zero.
    val exact = bnSecretExactDivBody(n, n, 1, d, 1, r, scratch).declassify()
    val partial = bnSecretDivModBody(n + 4, r, n, 2, d, 1, scratch).declassify()
    val divsteps = bnSecretDivstepsBody(n, r, n, d, 1, work).declassify()
    val gcd = bnSecretGcdBody(n, n, d, 1, work).declassify()
    val inverse = bnSecretInverseBody(n, d, n, 1, work).declassify()
    val reduce = bnSecretReduceBody(n, n, 1, d, 1, r, scratch).declassify()
    val nullRange = bnSecretDivModBody(0, r, n, 1, d, 1, scratch).declassify()
    val zeroWidth = bnSecretGcdBody(n, d, r, 0, work).declassify()
    // Every pair of the five division regions is checked, not just q/n.
    val pair1 = bnSecretDivModBody(q, q, n, 1, d, 1, scratch).declassify()
    val pair2 = bnSecretDivModBody(n, r, n, 1, d, 1, scratch).declassify()
    val pair3 = bnSecretDivModBody(d, r, n, 1, d, 1, scratch).declassify()
    val pair4 = bnSecretDivModBody(scratch, r, n, 1, d, 1, scratch).declassify()
    val pair5 = bnSecretDivModBody(q, n, n, 1, d, 1, scratch).declassify()
    val pair6 = bnSecretDivModBody(q, d, n, 1, d, 1, scratch).declassify()
    val pair7 = bnSecretDivModBody(q, scratch, n, 1, d, 1, scratch).declassify()
    val pair8 = bnSecretDivModBody(q, r, n, 1, n, 1, scratch).declassify()
    val pair9 = bnSecretDivModBody(q, r, n, 1, d, 1, n).declassify()
    val pair10 = bnSecretDivModBody(q, r, n, 1, d, 1, d).declassify()
    val ok = exact == u32(0) && partial == u32(0) && divsteps == u32(0) && gcd == u32(0) &&
        inverse == u32(0) && reduce == u32(0) && nullRange == u32(0) && zeroWidth == u32(0) &&
        pair1 == u32(0) && pair2 == u32(0) && pair3 == u32(0) && pair4 == u32(0) && pair5 == u32(0) &&
        pair6 == u32(0) && pair7 == u32(0) && pair8 == u32(0) && pair9 == u32(0) && pair10 == u32(0) &&
        bnLoad(n).declassify() == u32(10)
    bnRelease(n, 3)
    bnRelease(d, 1)
    bnRelease(r, 1)
    bnRelease(scratch, 1)
    bnRelease(work, 31)
    bnRelease(q, 1)
    if (ok) 0 else 1
}
