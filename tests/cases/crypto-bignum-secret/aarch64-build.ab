import "abla/build"
import "abla/compiler"
#compilerGrant("filesystem.write")
compile fun bignumAarch64Object(): bool {
    val target = defineTarget("linux-arm64-object", "aarch64-unknown-linux-gnu", "elf", "none", "none", false, false)
    target && buildProgram("secret-bignum-aarch64", "build/bignum-secret-tests/aarch64-kat.ab",
        "build/bignum-secret-tests/aarch64.o", "linux-arm64-object", "object", false, false)
}
val built = #bignumAarch64Object()
fun main: int = if (built) 0 else 1
