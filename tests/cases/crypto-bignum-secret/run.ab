import "abla/crypto"
import "abla/crypto/bignum"
import "abla/ct"
import "abla/io"
import "abla/text"
import "abla/process/arguments"
import "abla/process/exit"
import "abla/sys/linux"
import "abla/unsafe/memory"

trusted fun main: int {
    val lines = linuxReadFile(processArgument(0), 16777216).split("\n")
    for (line in lines) {
        if (line == "") continue
        val fields = line.split(" ")
        val mbytes = hexDecode(fields[0])
        val vbytes = hexDecode(fields[1])
        val words = (mbytes.size + 3) / 4
        val mode = processArgument(1)
        val vwords = if (mode == "divisionwide" || mode == "exactwide" || mode == "reducewide") words * 2 else words
        val m = guardAllocate(words)
        val v = guardAllocate(vwords)
        val gcd = guardAllocate(words)
        val inverse = guardAllocate(vwords)
        val work = guardAllocate((words + 1) * 9)
        bnFromBytes(m, words, ablaUnsafeStringAddress(mbytes), mbytes.size)
        bnFromBytes(v, vwords, ablaUnsafeStringAddress(vbytes), vbytes.size)
        val valid = if (mode == "gcd") {
            val moreWork = guardAllocate(words * 3 + (words + 1) * 9)
            val ok = bnSecretGcdBody(gcd, m, v, words, moreWork).declassify()
            guardRelease(moreWork, words * 3 + (words + 1) * 9)
            ok
        } else if (mode == "inverse") {
            val moreWork = guardAllocate(words * 13 + (words + 1) * 9)
            val ok = bnSecretInverseBody(inverse, m, v, words, moreWork).declassify()
            guardRelease(moreWork, words * 13 + (words + 1) * 9)
            ok
        } else if (mode == "division" || mode == "divisionwide") {
            bnSecretDivModBody(inverse, gcd, v, vwords, m, words, work).declassify()
        } else if (mode == "exactwide") {
            bnSecretExactDivBody(inverse, v, vwords, m, words, gcd, work).declassify()
        } else if (mode == "reducewide") {
            bnSecretReduceBody(gcd, v, vwords, m, words, inverse, work).declassify()
        } else bnSecretDivstepsBody(gcd, inverse, m, v, words, work).declassify()
        val gout = nativeByteBuffer(words * 4 + 1)
        val iout = nativeByteBuffer(vwords * 4 + 1)
        bnToBytes(ablaUnsafePointerAddress(gout.pointerAt(0)), words * 4, gcd)
        bnToBytes(ablaUnsafePointerAddress(iout.pointerAt(0)), vwords * 4, inverse)
        println("${hexEncode(gout.adoptString(words * 4))} ${hexEncode(iout.adoptString(vwords * 4))} ${int(valid)}")
        guardRelease(m, words)
        guardRelease(v, vwords)
        guardRelease(gcd, words)
        guardRelease(inverse, vwords)
        guardRelease(work, (words + 1) * 9)
    }
    0
}

// Every input, output and scratch allocation is bracketed by canaries.
trusted fun guardAllocate(words: int): int {
    val address = bnAllocate(words + 2)
    bnStore(address, secretU32(u32(3235826430)))
    bnStore(address + (words + 1) * 4, secretU32(u32(3235826430)))
    address + 4
}
trusted fun guardRelease(address: int, words: int): void {
    if (int(bnLoad(address - 4).declassify()) != 3235826430 ||
        int(bnLoad(address + words * 4).declassify()) != 3235826430) panic("buffer guard overwritten")
    bnRelease(address - 4, words + 2)
}
