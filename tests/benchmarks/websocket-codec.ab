import "abla/io"
import "abla/process/supervisor"
import "abla/websocket"

fun main: int {
    var payload = ""
    var byte = 0
    while (byte < 256) {
        payload = "${payload}x"
        byte = byte + 1
    }
    val iterations = 20000
    val started = processMonotonicMilliseconds()
    var completed = 0
    var index = 0
    while (index < iterations) {
        val encoded = webSocketEncodeFrame(payload, 2)
        val decoded = webSocketDecodeFrame(encoded, 1024)
        if (decoded.succeeded() && decoded.frame.payload.size == 256) {
            completed = completed + 1
        }
        index = index + 1
    }
    val elapsed = processMonotonicMilliseconds() - started
    println(
        "websocket codec: $completed frame round trips in ${elapsed}ms"
    )
    if (completed == iterations) 0 else 1
}
