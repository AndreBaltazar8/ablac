// Floating point fields of objects in arrays.
import "abla/io"
import "abla/float"
import "abla/float/text"
import "abla/math"
class Body(var x: f64, var y: f64, var z: f64, var vx: f64, var vy: f64, var vz: f64, val mass: f64)
fun bodies(): array<Body> {
    val made: array<Body> = []
    var i = 0
    while (i < 5) {
        val at = f64FromInt(i + 1)
        made.append(Body(at * 1.5, at * 0.5 - 2.0, at * 0.25, 0.1 * at, 0.2 - 0.05 * at, 0.01 * at, 1.0 + at))
        i = i + 1
    }
    made
}
fun advance(var all: array<Body>, dt: f64) {
    var i = 0
    while (i < all.size) {
        var j = i + 1
        while (j < all.size) {
            val dx = all[i].x - all[j].x
            val dy = all[i].y - all[j].y
            val dz = all[i].z - all[j].z
            val d2 = dx * dx + dy * dy + dz * dz + 0.01
            val mag = dt / (d2 * sqrt(d2))
            all[i].vx = all[i].vx - dx * all[j].mass * mag
            all[i].vy = all[i].vy - dy * all[j].mass * mag
            all[i].vz = all[i].vz - dz * all[j].mass * mag
            all[j].vx = all[j].vx + dx * all[i].mass * mag
            all[j].vy = all[j].vy + dy * all[i].mass * mag
            all[j].vz = all[j].vz + dz * all[i].mass * mag
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while (i < all.size) {
        all[i].x = all[i].x + dt * all[i].vx
        all[i].y = all[i].y + dt * all[i].vy
        all[i].z = all[i].z + dt * all[i].vz
        i = i + 1
    }
}
fun main: int {
    var all = bodies()
    var step = 0
    while (step < 3000000) { advance(all, 0.001); step = step + 1 }
    println("${all[0].x}")
    0
}
