// Text: building, slicing, comparing, templates.
import "abla/io"
import "abla/text"
fun main: int {
    var total = 0
    var round = 0
    while (round < 40) {
        val parts: array<string> = []
        var i = 0
        while (i < 40000) { parts.append("item-${i * 7}-$round"); i = i + 1 }
        i = 0
        while (i < parts.size) {
            val part = parts[i]
            val dash = part.indexOf("-", 5)
            val head = part.slice(0, dash)
            if (head == "item-700") total = total + 1
            total = total + head.size
            i = i + 1
        }
        var joined = ""
        i = 0
        while (i < 4000) { joined = joined + parts[i]; i = i + 1 }
        var byte = 0
        i = 0
        while (i < joined.size) { byte = byte + joined[i]; i = i + 1 }
        total = total + byte
        round = round + 1
    }
    println("$total")
    0
}
