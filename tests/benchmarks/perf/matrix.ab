// Nested arrays of floats, and integer mixing.
import "abla/io"
import "abla/float"
import "abla/float/text"
fun matrix(size: int, seed: int): array<array<f64>> {
    val rows: array<array<f64>> = []
    var i = 0
    while (i < size) {
        val row: array<f64> = []
        var j = 0
        while (j < size) { row.append(f64FromInt((i * j + seed) % 17)); j = j + 1 }
        rows.append(row)
        i = i + 1
    }
    rows
}
fun multiply(a: array<array<f64>>, b: array<array<f64>>): array<array<f64>> {
    val size = a.size
    var out = matrix(size, 0)
    var i = 0
    while (i < size) {
        val row = a[i]
        var j = 0
        while (j < size) {
            var sum = 0.0
            var k = 0
            while (k < size) { sum = sum + row[k] * b[k][j]; k = k + 1 }
            out[i][j] = sum
            j = j + 1
        }
        i = i + 1
    }
    out
}
fun main: int {
    val a = matrix(500, 1)
    val b = matrix(500, 2)
    val c = multiply(a, b)
    println("${c[17][19]}")
    0
}
