// Array reads and writes in tight loops.
import "abla/io"
fun count(limit: int): int {
    val flags: array<int> = []
    var i = 0
    while (i < limit) { flags.append(1); i = i + 1 }
    var total = 0
    i = 2
    while (i < limit) {
        if (flags[i] == 1) {
            total = total + 1
            var j = i + i
            while (j < limit) { flags[j] = 0; j = j + i }
        }
        i = i + 1
    }
    total
}
fun main: int {
    var sum = 0
    var round = 0
    while (round < 8) { sum = sum + count(5000000); round = round + 1 }
    println("$sum")
    0
}
