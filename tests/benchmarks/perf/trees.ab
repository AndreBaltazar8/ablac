// Allocation and collection: short-lived binary trees.
import "abla/io"
class Tree(val left: Tree?, val right: Tree?)
fun make(depth: int): Tree = if (depth == 0) Tree(null, null) else Tree(make(depth - 1), make(depth - 1))
fun check(tree: Tree): int {
    val left = tree.left
    val right = tree.right
    return if (left != null && right != null) 1 + check(left) + check(right) else 1
}
fun main: int {
    val long = make(18)
    var total = 0
    var depth = 4
    while (depth <= 18) {
        val rounds = 1 << (18 - depth + 4)
        var round = 0
        while (round < rounds) { total = total + check(make(depth)); round = round + 1 }
        depth = depth + 4
    }
    println("$total ${check(long)}")
    0
}
