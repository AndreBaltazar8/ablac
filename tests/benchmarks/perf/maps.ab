// Hash maps with string and int keys.
import "abla/io"
fun main: int {
    var total = 0
    var round = 0
    while (round < 6) {
        val words: Map<string, int> = Map()
        val numbers: Map<int, int> = Map()
        var i = 0
        while (i < 200000) {
            val key = "w${i % 5000}"
            val seen = words.get(key)
            words.set(key, if (seen != null) seen + 1 else 1)
            numbers.set(i * 31, i)
            i = i + 1
        }
        i = 0
        while (i < 200000) {
            val hit = numbers.get(i * 31)
            if (hit != null) total = total + hit
            i = i + 1
        }
        total = total + words.size
        round = round + 1
    }
    println("$total")
    0
}
