// Interface calls, lambdas and small objects.
import "abla/io"
interface Shape { fun area(): int }
class Square(val side: int): Shape { fun area(): int = this.side * this.side }
class Rect(val w: int, val h: int): Shape { fun area(): int = this.w * this.h }
class Tri(val b: int, val h: int): Shape { fun area(): int = this.b * this.h / 2 }
fun main: int {
    val shapes: array<Shape> = []
    var i = 0
    while (i < 3000) {
        if (i % 3 == 0) shapes.append(Square(i))
        else if (i % 3 == 1) shapes.append(Rect(i, 2))
        else shapes.append(Tri(i, 3))
        i = i + 1
    }
    val weigh = { value: int -> value % 7 + 1 }
    var total = 0
    var round = 0
    while (round < 30000) {
        i = 0
        while (i < shapes.size) {
            total = total + weigh(shapes[i].area())
            i = i + 1
        }
        round = round + 1
    }
    println("$total")
    0
}
