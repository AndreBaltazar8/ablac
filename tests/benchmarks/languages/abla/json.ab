import "abla/io"
import "abla/fs"
import "abla/json"
import "abla/integer"
import "abla/process/arguments"
fun main: int {
    val n = processArgument(0).parseInt() ?? 1
    val text = path(processArgument(1)).readText()
    var i = 0
    while (i < n) {
        val result = jsonParse(text)
        if (!result.succeeded) return 2
        val out = jsonStringify(result.value)
        if (i == n - 1) println(out)
        i = i + 1
    }
    0
}
