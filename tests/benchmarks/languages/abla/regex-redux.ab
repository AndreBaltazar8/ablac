import "abla/io"
import "abla/fs"
import "abla/regex"
import "abla/process/arguments"
fun main: int {
    val input = path(processArgument(1)).readText()
    var s = regexCompile(">[^\n]*\n|\n").regex.replace(input, "")
    val clean = s.size
    val patterns = ["agggtaaa|tttaccct", "[cgt]gggtaaa|tttaccc[acg]", "a[act]ggtaaa|tttacc[agt]t", "ag[act]gtaaa|tttac[agt]ct", "agg[act]taaa|ttta[agt]cct", "aggg[acg]aaa|ttt[cgt]ccct", "agggt[cgt]aa|tt[acg]accct", "agggta[cgt]a|t[acg]taccct", "agggtaa[cgt]|[acg]ttaccct"]
    for (p in patterns) println("$p ${regexCompile(p).regex.findAll(s).size}")
    val p = ["tHa[Nt]", "aND|caN|Ha[DS]|WaS", "a[NSt]|BY", "<[^>]*>", "\\|[^|][^|]*\\|"]
    val r = ["<4>", "<3>", "<2>", "|", "-"]
    var i = 0
    while (i < 5) { s = regexCompile(p[i]).regex.replace(s, r[i]); i = i + 1 }
    println("\n${input.size}\n$clean\n${s.size}")
    0
}
