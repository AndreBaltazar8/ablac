// Deliberately minimal fixed-body HTTP/1.1, one blocking connection at a time.
import "abla/net"
import "abla/text"
import "abla/integer"
import "abla/process/arguments"
fun main: int {
    val port = processArgument(0).parseInt() ?? 0
    var listener = tcpListenAddress(ipv4Loopback(port), 128)
    if (listener.descriptor < 0) return 2
    while (true) {
        var c = listener.accept()
        if (c.descriptor < 0) return 2
        var input = ""
        while (input.size < 8192) {
            val part = c.read(8192 - input.size)
            if (part.size == 0) break
            input = input + part
            val at = input.indexOf("\r\n\r\n")
            if (at >= 0 && input.size >= at + 4 + 256) {
                val response = "HTTP/1.1 200 OK\r\nContent-Length: 256\r\nConnection: close\r\n\r\n" + input.slice(at + 4, at + 4 + 256)
                var sent = 0
                while (sent < response.size) {
                    val wrote = c.write(response.slice(sent, response.size))
                    if (wrote <= 0) break
                    sent = sent + wrote
                }
                break
            }
        }
        c.close()
    }
    0
}
