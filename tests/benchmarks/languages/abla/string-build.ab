import "abla/integer"
import "abla/io"
import "abla/process/arguments"

fun main: int {
    val count = processArgument(0).parseInt() ?? 0
    var text = ""
    var i = 0
    while (i < count) {
        val chunk = if (i % 2 == 0) "alpha: 01234567\n" else "bravo: 76543210\n"
        text = text + chunk
        i = i + 1
    }
    print(text)
    0
}
