import "abla/io"
import "abla/json"

// JSON trees: build 500 objects, stringify, parse back, sum a field.
fun work(): int {
    val items: array<Json> = []
    var index = 0
    while (index < 500) {
        items.append(jsonObject(
            ["id", "name", "tags"],
            [jsonInteger(index), jsonString("item$index"),
             jsonArray([jsonInteger(index % 3), jsonBoolean(index % 2 == 0)])]
        ))
        index = index + 1
    }
    val text = jsonStringify(jsonArray(items))
    val parsed = jsonParse(text)
    var sum = 0
    var at = 0
    while (at < parsed.value.size()) {
        sum = sum + parsed.value.at(at).get("id").asInt()
        at = at + 1
    }
    sum + text.size
}

val result = @RESULT@

fun main: int {
    println("$result")
    0
}
