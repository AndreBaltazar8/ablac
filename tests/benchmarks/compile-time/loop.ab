import "abla/io"

// Tight loop: integer arithmetic and a back edge, 3M iterations.
fun work(): int {
    var sum = 0
    var index = 0
    while (index < 3000000) {
        sum = sum + index % 7
        index = index + 1
    }
    sum
}

