import "abla/io"
import "abla/bytes"

// String building: 100K appends to a buffer, then one text.
fun work(): string {
    val buffer = byteBuffer()
    var index = 0
    while (index < 100000) {
        buffer.appendInt(index % 1000)
        buffer.appendText(",")
        index = index + 1
    }
    val text = buffer.toText()
    "${text.size}:${text.slice(0, 16)}"
}

val result = @RESULT@

fun main: int {
    println(result)
    0
}
