import "abla/io"

// Table generation: a 256-entry CRC-32 table computed bit by bit, 64 times
// over (a lookup table a program would bake in).
fun crcTable(): array<int> {
    val table: array<int> = []
    var n = 0
    while (n < 256) {
        var c = n
        var k = 0
        while (k < 8) {
            c = if (c % 2 == 1) 3988292384 ^ (c / 2) else c / 2
            k = k + 1
        }
        table.append(c)
        n = n + 1
    }
    table
}

fun work(): array<int> {
    var check = 0
    var round = 1
    while (round < 64) {
        check = check ^ crcTable()[round]
        round = round + 1
    }
    val table = crcTable()
    table[0] = check
    table
}

val result = @RESULT@

fun main: int {
    println("${result.size} ${result[0]} ${result[1]} ${result[255]}")
    0
}
