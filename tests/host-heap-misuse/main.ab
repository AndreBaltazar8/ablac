// The host heap stops a program that frees a block twice, or frees an address inside a block (#1139 area 10):
// tools/test-host-heap-misuse.sh runs each mode and expects SIGILL; `control` must pass and leave the heap consistent.
import "abla/runtime/scalar"
import "abla/sys/linux/process"

trusted fun doubleFree(): int {
    val a = __ablaRuntimeHostHeapAllocate(48, false)
    __ablaRuntimeHostHeapFree(a)
    __ablaRuntimeHostHeapFree(a)
    val b = __ablaRuntimeHostHeapAllocate(48, false)
    val c = __ablaRuntimeHostHeapAllocate(48, false)
    if (b == c) 30 else 32
}

trusted fun largeDoubleFree(): int {
    val a = __ablaRuntimeHostHeapAllocate(200000, false)
    __ablaRuntimeHostHeapFree(a)
    __ablaRuntimeHostHeapFree(a)
    val b = __ablaRuntimeHostHeapAllocate(200000, false)
    val c = __ablaRuntimeHostHeapAllocate(200000, false)
    if (b == c) 35 else 36
}

trusted fun interiorFree(): int {
    val a = __ablaRuntimeHostHeapAllocate(256, true)
    __ablaRuntimeHostHeapFree(a + 64)
    val b = __ablaRuntimeHostHeapAllocate(16, false)
    val c = __ablaRuntimeHostHeapAllocate(16, false)
    if (b == a + 64 || c == a + 64) 40 else 41
}

trusted fun control(): int {
    var i = 0
    while (i < 100000) {
        val a = __ablaRuntimeHostHeapAllocate(i % 300 + 1, false)
        val b = __ablaRuntimeHostHeapAllocate(i % 200000 + 1, false)
        __ablaRuntimeHostHeapFree(a)
        __ablaRuntimeHostHeapFree(b)
        i = i + 1
    }
    if (__ablaRuntimeHostHeapVerify() == 0) 0 else 50 + __ablaRuntimeHostHeapVerify()
}

fun main: int {
    val which = if (linuxArgumentCount() > 0) linuxArgument(0) else "control"
    if (which == "double") doubleFree() else if (which == "large") largeDoubleFree()
    else if (which == "interior") interiorFree() else control()
}
