--- a/lib/Target/Xtensa/XtensaInstrInfo.td
+++ b/lib/Target/Xtensa/XtensaInstrInfo.td
@@ -148,6 +148,31 @@
   let Inst{23-20} = imm2;
 }
 
+// EXTUI for masks and logical right shifts: upstream defines Xtensa_extui
+// but never creates it, so `x & 0xff` costs MOVI + AND, `(x >> s) & m`
+// SRLI + AND, and `x >> 16..31` SSR + SRL (SRLI only encodes 0..15).
+// EXTUI computes (t >> imm1) & (2^imm2 - 1) for any imm1 in 0..31.
+def ExtuiMask : ImmLeaf<i32, [{
+  return Imm > 0 && Imm <= 0xffff && isMask_32((uint32_t)Imm);
+}]>;
+def ExtuiMaskWidth : SDNodeXForm<imm, [{
+  return CurDAG->getTargetConstant(llvm::popcount((uint32_t)N->getZExtValue()),
+                                   SDLoc(N), MVT::i32);
+}]>;
+def ExtuiHighShift : ImmLeaf<i32, [{ return Imm >= 16 && Imm <= 31; }]>;
+def ExtuiHighShiftAmount : SDNodeXForm<imm, [{
+  return CurDAG->getTargetConstant(N->getZExtValue(), SDLoc(N), MVT::i32);
+}]>;
+def ExtuiHighShiftWidth : SDNodeXForm<imm, [{
+  return CurDAG->getTargetConstant(32 - N->getZExtValue(), SDLoc(N), MVT::i32);
+}]>;
+
+def : Pat<(and AR:$t, ExtuiMask:$m), (EXTUI AR:$t, 0, (ExtuiMaskWidth $m))>;
+def : Pat<(and (srl AR:$t, uimm5:$sa), ExtuiMask:$m),
+          (EXTUI AR:$t, uimm5:$sa, (ExtuiMaskWidth $m))>;
+def : Pat<(srl AR:$t, ExtuiHighShift:$sa),
+          (EXTUI AR:$t, (ExtuiHighShiftAmount $sa), (ExtuiHighShiftWidth $sa))>;
+
 def SRAI : RRR_Inst<0x00, 0x01, 0x02, (outs AR:$r), (ins AR:$t, uimm5:$sa),
                    "srai\t$r, $t, $sa",
                    [(set AR:$r, (sra AR:$t, uimm5:$sa))]> {
