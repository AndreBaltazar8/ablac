+// Inline assembly whose size the assembler decides (directives such as
+// .align or .literal, and loops, whose bodies it aligns) bounds no distance.
+static bool hasUnboundedSize(const MachineInstr &MI) {
+  if (!MI.isInlineAsm())
+    return false;
+  StringRef Asm = MI.getOperand(0).getSymbolName();
+  while (!Asm.empty()) {
+    auto [Statement, Rest] = Asm.split('\n');
+    Asm = Rest;
+    Statement = Statement.split('#').first.trim();
+    while (Statement.contains(':') && !Statement.starts_with(".")) {
+      Statement = Statement.split(':').second.trim();
+    }
+    if (Statement.starts_with(".") || Statement.starts_with("loop") ||
+        Statement.contains(';'))
+      return true;
+  }
+  return false;
+}
