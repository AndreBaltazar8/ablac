+void XtensaAsmPrinter::selectNarrowBranches(const MachineFunction &MF) {
+  NarrowBranches.clear();
+  if (!XtensaNarrowBranches || !MF.getSubtarget<XtensaSubtarget>().hasDensity())
     return;
+  const TargetInstrInfo *TII = MF.getSubtarget().getInstrInfo();
+  // Offsets from the function start under the largest and smallest encoding
+  // of everything before: the assembler may still narrow an instruction but
+  // never widens one, and block alignment adds at most Align - 1 bytes.
+  DenseMap<const MachineBasicBlock *, std::pair<uint64_t, uint64_t>> Blocks;
+  DenseMap<const MachineInstr *, std::pair<uint64_t, uint64_t>> Branches;
+  const uint64_t Unbounded = uint64_t(1) << 32;
+  bool Changed = true;
+  while (Changed) {
+    Changed = false;
+    uint64_t Max = 0, Min = 0;
+    for (const MachineBasicBlock &MBB : MF) {
+      Max += MBB.getAlignment().value() - 1;
+      Blocks[&MBB] = {Max, Min};
+      for (const MachineInstr &MI : MBB) {
+        unsigned Size = TII->getInstSizeInBytes(MI);
+        if ((MI.getOpcode() == Xtensa::BEQZ ||
+             MI.getOpcode() == Xtensa::BNEZ) &&
+            MI.getOperand(1).isMBB()) {
+          Branches[&MI] = {Max, Min};
+          if (NarrowBranches.count(&MI))
+            Size = 2;
+        }
+        if (hasUnboundedSize(MI)) {
+          Max += Unbounded;
+        } else {
+          Max += Size;
+          // A 3-byte instruction may become a 2-byte one; meta instructions
+          // and inline assembly may emit nothing.
+          if (Size != 0 && !MI.isInlineAsm())
+            Min += 2;
+        }
+      }
+    }
+    for (auto &[MI, Offsets] : Branches) {
+      if (NarrowBranches.count(MI))
+        continue;
+      const MachineBasicBlock *Target = MI->getOperand(1).getMBB();
+      if (Target->getParent() != &MF ||
+          Target->getSectionID() != MI->getParent()->getSectionID())
+        continue;
+      auto [TargetMax, TargetMin] = Blocks.lookup(Target);
+      // Bytes between the end of the branch and its target. The narrow
+      // encoding reaches pc + 4 .. pc + 67, so 2 .. 65 of them.
+      if (TargetMin < Offsets.second + 2 || TargetMax < Offsets.first + 3)
+        continue;
+      uint64_t GapMax = TargetMax - Offsets.first - 3;
+      uint64_t GapMin = TargetMin - Offsets.second - 2;
+      if (GapMin >= 2 && GapMax <= 65) {
+        NarrowBranches.insert(MI);
+        Changed = true;
+      }
+    }
   }
 }
 
+bool XtensaAsmPrinter::runOnMachineFunction(MachineFunction &MF) {
+  selectNarrowBranches(MF);
+  return AsmPrinter::runOnMachineFunction(MF);
+}
