Keep the standalone opt startup and expose its driver to UTF-8 callers.
On Windows InitLLVM replaces argv with the process command line.

diff --git a/tools/opt/optdriver.cpp b/tools/opt/optdriver.cpp
--- a/tools/opt/optdriver.cpp
+++ b/tools/opt/optdriver.cpp
@@ -396,12 +396,11 @@
 }

 //===----------------------------------------------------------------------===//
-// main for opt
+// Embedded opt entry. The caller already supplies UTF-8 arguments.
 //
 extern "C" int
-optMain(int argc, char **argv,
-        ArrayRef<std::function<void(PassBuilder &)>> PassBuilderCallbacks) {
-  InitLLVM X(argc, argv);
+optMainUtf8(int argc, char **argv,
+            ArrayRef<std::function<void(PassBuilder &)>> PassBuilderCallbacks) {

   // Enable debug stream buffering.
   EnableDebugBuffering = true;
@@ -998,3 +997,10 @@

   return codegen::MaybeSaveStatistics(OutputFilename, "opt");
 }
+
+extern "C" int
+optMain(int argc, char **argv,
+        ArrayRef<std::function<void(PassBuilder &)>> PassBuilderCallbacks) {
+  InitLLVM X(argc, argv);
+  return optMainUtf8(argc, argv, PassBuilderCallbacks);
+}
