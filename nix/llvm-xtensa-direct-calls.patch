+// CALL0/CALL8 reach +-512 KB. With -xtensa-direct-calls, a call from a
+// function in the default text sections to a function defined (and not
+// interposable) in the same module, also in the default text sections, is
+// emitted as a direct call: such sections are linked next to each other in
+// flash. ROM, IRAM and external callees keep the literal-pool (long) call;
+// a call that still ends up out of range is a link-time error.
+static cl::opt<bool> XtensaDirectCalls(
+    "xtensa-direct-calls", cl::Hidden, cl::init(false),
+    cl::desc("Use CALL8/CALL0 for calls between default-text functions of "
+             "one module"));
+
+static bool isInDefaultText(const GlobalValue *GV) {
+  const auto *F = dyn_cast_or_null<Function>(GV->getAliaseeObject());
+  if (!F || F->isDeclaration() || F->isInterposable())
+    return false;
+  return !F->hasSection() || F->getSection().starts_with(".text");
+}
