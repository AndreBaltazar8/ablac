import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"

// Applies a strict-imports report (`ablac build … --visibility-report <file>`):
// adds each module's missing imports after its last top-level `import`, or
// before its first line that isn't a comment, each once. An import a module
// already has is left alone. A new import that makes a name ambiguous
// (E_IMPORT_UNQUALIFIED_AMBIGUOUS) needs an alias instead; the next build
// says which.
//
//     ablac run tools/fix-imports.ab -- <report>

fun indexIn(items: array<string>, item: string): int {
    var index = 0
    while (index < items.size) {
        if (items[index] == item) return index
        index = index + 1
    }
    -1
}

fun main: int {
    if (processArgumentCount() < 1) {
        eprintln("usage: ablac run tools/fix-imports.ab -- <report>")
        return 2
    }
    val modules: array<string> = []
    val imports: array<array<string>> = []
    for (line in Path(processArgument(0)).readText().split("\n")) {
        val fields = line.split("\t")
        if (fields.size >= 6) {
            var module = indexIn(modules, fields[0])
            if (module < 0) {
                modules.append(fields[0])
                imports.append([])
                module = modules.size - 1
            }
            if (indexIn(imports[module], fields[5]) < 0) imports[module].append(fields[5])
        }
    }
    var changed = 0
    var module = 0
    while (module < modules.size) {
        val path = Path(modules[module])
        val lines = path.readText().split("\n")
        var last = -1
        var firstCode = -1
        var index = 0
        while (index < lines.size) {
            val trimmed = lines[index].trim()
            if (trimmed.startsWith("import ") || trimmed.startsWith("export import ")) last = index
            if (firstCode < 0 && trimmed != "" && !trimmed.startsWith("//")) firstCode = index
            index = index + 1
        }
        val added: array<string> = []
        for (wanted in imports[module]) {
            if (indexIn(lines, wanted) < 0) added.append(wanted)
        }
        if (added.size > 0) {
            // After the last import, or before the first line of code.
            val at = if (last >= 0) last + 1 else if (firstCode >= 0) firstCode else 0
            var output = ""
            index = 0
            while (index < lines.size) {
                if (index == at) {
                    for (line in added) output = "$output$line\n"
                    if (last < 0) output = "$output\n"
                }
                output = if (index + 1 < lines.size) "$output${lines[index]}\n"
                    else "$output${lines[index]}"
                index = index + 1
            }
            path.writeTextAtomic(output)
            println("${modules[module]}: ${added.size} import(s) added")
            changed = changed + 1
        }
        module = module + 1
    }
    println("fix-imports: $changed module(s) changed")
    0
}
