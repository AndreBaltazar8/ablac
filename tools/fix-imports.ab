import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"

// Applies a strict-imports report (`ablac build … --visibility-report <file>`):
// adds each module's missing imports after its last top-level `import`, or
// before its first line that isn't a comment, each once. An import a module
// already has is left alone, and none reaches into another package's vendored
// files (that package's entry should pass them on). A new import that makes a name ambiguous
// (E_IMPORT_UNQUALIFIED_AMBIGUOUS) needs an alias instead; the next build
// says which.
//
//     ablac run tools/fix-imports.ab -- <report>

// The quoted module of an import line (`import "abla/math" as m` -> `"abla/math"`), quotes kept.
fun importSpec(line: string): string {
    val open = line.indexOf("\"")
    if (open < 0) return line
    val close = line.slice(open + 1, line.size).indexOf("\"")
    if (close < 0) return line
    line.slice(open, open + close + 2)
}

// Whether `lines` already import `spec` in any form: plain, under an alias (`as m`) or exported. A second
// import of a module the file imports under an alias is E_IMPORT_ALIAS_TARGET_DUPLICATE; the report names a
// module whose declarations the file reaches through its alias too.
fun importsSpec(lines: array<string>, spec: string): bool {
    for (line in lines) {
        val trimmed = line.trim()
        if ((trimmed.startsWith("import ") || trimmed.startsWith("export import ")) &&
            importSpec(trimmed) == spec) return true
    }
    false
}

// The package whose vendored copy (`.abla/packages/<package>/…`) the import line reaches into, "" for none.
fun vendoredPackage(importLine: string): string {
    val marker = ".abla/packages/"
    val at = importLine.indexOf(marker)
    if (at < 0) return ""
    val rest = importLine.slice(at + marker.size, importLine.size)
    val end = rest.indexOf("/")
    if (end < 0) rest else rest.slice(0, end)
}

fun indexIn(items: array<string>, item: string): int {
    var index = 0
    while (index < items.size) {
        if (items[index] == item) return index
        index = index + 1
    }
    -1
}

fun main: int {
    if (processArgumentCount() < 1) {
        eprintln("usage: ablac run tools/fix-imports.ab -- <report>")
        return 2
    }
    val modules: array<string> = []
    val imports: array<array<string>> = []
    // A report joined from several programs' (a module they share) can name, for one name a module uses, a
    // different declaring module in each: each program declares its own (a hook the shared module calls).
    // No import expresses that, and importing them all makes the name ambiguous, so such a name gets no
    // import here; it is listed, for the module to be restructured (or kept flat).
    val firstImport: Map<string, string> = Map()
    val conflicted: Map<string, bool> = Map()
    val rows: array<array<string>> = []
    for (line in Path(processArgument(0)).readText().split("\n")) {
        val fields = line.split("\t")
        if (fields.size >= 6) {
            rows.append(fields)
            val key = "${fields[0]}\t${fields[3]}"
            val seen = firstImport.get(key) ?? ""
            if (seen == "") firstImport.set(key, fields[5])
            else if (seen != fields[5] && !conflicted.has(key)) {
                conflicted.set(key, true)
                println("${fields[0]}: `${fields[3]}` is declared differently by the programs that share this module ($seen, ${fields[5]}): not imported")
            }
        }
    }
    // A name declared in a file of another package that its entry doesn't pass on: the report can only spell a
    // path into the vendored copy, which bypasses the package import. The package's entry should `export import`
    // that file; until it does, no import, and the name is listed.
    val listed: Map<string, bool> = Map()
    for (fields in rows) {
        if (conflicted.has("${fields[0]}\t${fields[3]}")) continue
        val vendored = vendoredPackage(fields[5])
        if (vendored != "") {
            val key = "${fields[0]}\t${fields[3]}"
            if (!listed.has(key)) {
                listed.set(key, true)
                println("${fields[0]}: `${fields[3]}` is declared in ${fields[4]}, which package $vendored's entry doesn't pass on: not imported ($vendored's entry should `export import` it)")
            }
            continue
        }
        var module = indexIn(modules, fields[0])
        if (module < 0) {
            modules.append(fields[0])
            imports.append([])
            module = modules.size - 1
        }
        if (indexIn(imports[module], fields[5]) < 0) imports[module].append(fields[5])
    }
    var changed = 0
    var module = 0
    while (module < modules.size) {
        val path = Path(modules[module])
        val lines = path.readText().split("\n")
        var last = -1
        var firstCode = -1
        var index = 0
        while (index < lines.size) {
            val trimmed = lines[index].trim()
            if (trimmed.startsWith("import ") || trimmed.startsWith("export import ")) last = index
            if (firstCode < 0 && trimmed != "" && !trimmed.startsWith("//")) firstCode = index
            index = index + 1
        }
        val added: array<string> = []
        for (wanted in imports[module]) {
            if (!importsSpec(lines, importSpec(wanted))) added.append(wanted)
        }
        if (added.size > 0) {
            // After the last import, or before the first line of code.
            val at = if (last >= 0) last + 1 else if (firstCode >= 0) firstCode else 0
            var output = ""
            index = 0
            while (index < lines.size) {
                if (index == at) {
                    for (line in added) output = "$output$line\n"
                    if (last < 0) output = "$output\n"
                }
                output = if (index + 1 < lines.size) "$output${lines[index]}\n"
                    else "$output${lines[index]}"
                index = index + 1
            }
            path.writeTextAtomic(output)
            println("${modules[module]}: ${added.size} import(s) added")
            changed = changed + 1
        }
        module = module + 1
    }
    println("fix-imports: $changed module(s) changed")
    0
}
