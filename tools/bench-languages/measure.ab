// Clock outside fork/exec/wait. Output remains in a file, never captured in RAM.
import "abla/process/command"
import "abla/process/arguments"
import "abla/process/time"
import "abla/io"
import "abla/integer"
fun main: int {
    // measure REPEATS STDOUT STDERR EXECUTABLE [ARG ...]
    val repeats = processArgument(0).parseInt() ?? 0
    if (repeats < 1 || processArgumentCount() < 4) return 2
    val c = command(processArgument(3)).output(processArgument(1)).errors(processArgument(2))
    var arg = 4
    while (arg < processArgumentCount()) { c.argument(processArgument(arg)); arg = arg + 1 }
    val began = monotonicNanoseconds()
    var i = 0
    while (i < repeats) {
        val status = c.run()
        if (status != 0) return status
        i = i + 1
    }
    val elapsed = monotonicNanoseconds() - began
    println("$elapsed")
    0
}
