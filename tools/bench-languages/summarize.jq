def stats: sort | {median: (if length%2==1 then .[length/2|floor] else (.[length/2-1]+.[length/2])/2 end), min:.[0], max:.[-1]};
. as $data |
($data.samples | group_by(.program) | map({key:.[0].program,value:{languages:(group_by(.language)|map({key:.[0].language,value:{status:"verified",wallSeconds:([.[]|select(.kind=="runtime")|.wallSeconds]|stats),rssBytes:([.[]|select(.kind=="runtime")|.rssBytes]|stats),compileSeconds:([.[]|select(.kind=="compile")|.wallSeconds]|stats),rawBytes:([.[]|select(.kind=="size")|.rawBytes][0]),strippedBytes:([.[]|select(.kind=="size")|.strippedBytes][0])} + (if .[0].program=="hello" then {startupSeconds:([.[]|select(.kind=="startup")|.wallSeconds]|stats)} else {} end) + (if .[0].program=="http-echo" then {requestsPerSecond:([.[]|select(.kind=="runtime")|.requestsPerSecond]|stats)} else {} end)})|from_entries)}})|from_entries) as $programs |
$data + {programs:($programs|with_entries(.value.languages as $langs|.value.languages |= with_entries(.value += {ratiosToC:{wallSeconds:(if $langs.c.wallSeconds.median>0 then .value.wallSeconds.median/$langs.c.wallSeconds.median else null end),rssBytes:(if $langs.c.rssBytes.median>0 then .value.rssBytes.median/$langs.c.rssBytes.median else null end),compileSeconds:(if $langs.c.compileSeconds.median>0 then .value.compileSeconds.median/$langs.c.compileSeconds.median else null end),strippedBytes:(if $langs.c.strippedBytes>0 then .value.strippedBytes/$langs.c.strippedBytes else null end)}})))}
