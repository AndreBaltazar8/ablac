#!/usr/bin/env bash
# The opt-in Linux x86-64 timing experiment: builds tools/ct-timing/runner.ab with the compiler the run uses (--compiler,
# default build/ablac) and runs it with the same arguments. Run inside nix-shell shell.nix; see README.md.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
compiler=$root/build/ablac
previous=
for argument in "$@"; do
    [[ $previous == --compiler ]] && compiler=$argument
    previous=$argument
done
[[ $compiler == /* ]] || compiler=$PWD/$compiler
tools=$root/build/ct-timing/tools
mkdir -p "$tools"
"$compiler" build "$root/tools/ct-timing/runner.ab" -o "$tools/runner" --fast > "$tools/runner.log" 2>&1 ||
    { cat "$tools/runner.log" >&2; echo "ct-timing: tools/ct-timing/runner.ab did not build" >&2; exit 2; }
ABLA_CT_TIMING_ROOT=$root exec "$tools/runner" "$@"
