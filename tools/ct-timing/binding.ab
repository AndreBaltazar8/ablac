// What the timing runner and its test share (#817): the driver bound to the real private RSA cores (generate.py's
// generate), and whether this host can measure at all.

class CtBinding(val text: string, val error: string)

fun ctCount(text: string, needle: string): int {
    var count = 0
    var at = text.indexOf(needle)
    while (at >= 0) {
        count = count + 1
        at = text.indexOf(needle, at + needle.size)
    }
    count
}

/** The driver `template` with the RSA secret cores of `source` appended, without algorithm copies. */
fun ctTimingGenerate(template: string, source: string): CtBinding {
    val start = "// BEGIN RSA SECRET BIGNUM PRIMITIVES"
    val end = "// END RSA SECRET BIGNUM PRIMITIVES"
    if (ctCount(source, start) != 1 || ctCount(source,
        end) != 1 || source.indexOf(start) > source.indexOf(end)) {
        return CtBinding("", "RSA secret-core markers changed; review the fixture binding")
    }
    val after = source.slice(source.indexOf(start) + start.size, source.size)
    CtBinding(template + "\n" + after.slice(0, after.indexOf(end)), "")
}

/** Why this host can't run the experiment ("" when it can): it needs Linux on x86-64 with RDTSCP. */
fun ctTimingUnavailable(system: string, machine: string, cpuinfo: string): string {
    if (system != "Linux" || (machine != "x86_64" && machine != "AMD64")) {
        return "ct-timing unavailable: requires Linux x86_64, taskset and RDTSCP"
    }
    if (!cpuinfo.contains("rdtscp")) return "ct-timing unavailable: RDTSCP is not advertised"
    ""
}
