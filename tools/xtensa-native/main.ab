import "abla/xtensa/companion"
import "abla/xtensa/companion/native"
import "abla/fs"
import "abla/fs/secure"
import "abla/crypto"
import "abla/memory"
import "abla/platform/host"
import "abla/process/arguments"
import "abla/simd/target"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/sys/linux/random"

private fun fail(message: string): int {
    linuxWriteStandardError("abla-install-xtensa-native: $message\n")
    1
}
private fun hostName(): string {
    if (ablaHostIsMacOS()) {
        if (simdTargetArch() == SIMD_ARCH_X86_64) return "x86_64-macos"
        if (simdTargetArch() == SIMD_ARCH_AARCH64) return "arm64-macos"
    } else if (simdTargetArch() == SIMD_ARCH_X86_64) return "x86_64-linux"
    ""
}
private fun activate(parent: SecureDirectory, version: string): bool {
    val random = secureRandomBytes(16)
    if (!random.succeeded) return false
    parent.replaceSymlink("current", ".current-${hexEncode(random.bytes)}", version)
}
private fun cleanupDownload(parent: SecureDirectory, var directory: SecureDirectory,
    name: string): bool {
    var ok = true
    if (directory.descriptor >= 0) {
        val kind = directory.entryKind("archive.tar.gz")
        if (kind != "missing" && !directory.remove("archive.tar.gz")) ok = false
        if (!directory.close()) ok = false
    }
    if (!parent.remove(name, true)) ok = false
    ok
}
private fun readBounded(path: string, maximum: int): SecureReadResult {
    val file = Path(path)
    val parent = secureDirectory(file.parent().text)
    val opened = parent.openRegularFile(file.name())
    if (opened.descriptor < 0) return SecureReadResult("", "open")
    opened.read(maximum)
}

private fun imageRoot(): string {
    var image = Path("/proc/self/exe").linkTarget()
    if (image == "") return ""
    // Darwin's virtual image link may preserve the path used to launch the
    // executable, including a link outside the toolchain.
    var depth = 0
    while (depth < 40) {
        val target = Path(image).linkTarget()
        if (target == "") return Path(image).parent().parent().text
        image = if (target.startsWith("/")) target else "${Path(image).parent().text}/$target"
        depth += 1
    }
    ""
}

fun main(): int {
    // Keep discarded streaming chunks from accumulating to the normal 64 MiB
    // growth threshold. Preserve an explicit user-selected GC policy.
    if (!linuxEnvironment("ABLA_GC_GROWTH").found && !linuxEnvironment("ABLA_GC_STRESS").found)
        memorySetCollectionGrowth(4194304)
    var root = imageRoot()
    var catalog = ""
    var version = ""
    var archivePath = ""
    var verify = false
    var i = 0
    while (i < processArgumentCount()) {
        val argument = processArgument(i)
        val equals = argument.indexOf("=", 0)
        val arg = if (equals >= 0) argument.slice(0, equals) else argument
        if (arg == "--verify") verify = true
        else if (arg == "--help" || arg == "-h") {
            if (equals >= 0) return fail("unexpected value for $arg")
            linuxWriteStandardOutput("usage: abla-install-xtensa-native [--toolchain-root PATH] [--catalog PATH] [--version VERSION] [--archive PATH] [--verify]\n")
            return 0
        } else if (arg == "--toolchain-root" || arg == "--catalog" || arg == "--version" || arg ==
            "--archive") {
            var value = ""
            if (equals >= 0) value = argument.slice(equals + 1, argument.size)
            else {
                i += 1
                if (i >= processArgumentCount() ||
                    processArgument(i).startsWith("--")) return fail("missing value for $arg")
                value = processArgument(i)
            }
            if (value == "") return fail("missing value for $arg")
            if (arg == "--toolchain-root") root = value
            else if (arg == "--catalog") catalog = value
            else if (arg == "--version") version = value
            else archivePath = value
        } else return fail("unknown argument: $arg")
        if (arg == "--verify" && equals >= 0) return fail("unexpected value for $arg")
        i += 1
    }
    if (root == "") return fail("missing toolchain root")
    if (verify && archivePath != "") return fail("--archive cannot be combined with --verify")
    if (!verify && version == "") return fail("installation needs --version")
    if (!Path("$root/libexec/ablac.bin").info().isFile()) return fail("not an Abla toolchain root")
    if (catalog == "") catalog = "$root/share/abla/xtensa-companions.json"
    val catalogRead = readBounded(catalog, 1048576)
    if (catalogRead.error != "") return fail("cannot read catalog")
    val host = hostName()
    if (host == "") return fail("unsupported host")
    val parentPath = "$root/lib/abla/xtensa-llvm"
    if (!verify &&
        !Path(parentPath).createDirectories(0o755)) return fail("cannot create companion directory")
    val parent = secureDirectory(parentPath)
    if (parent.descriptor < 0) return fail("cannot open companion directory")
    val currentKind = parent.entryKind("current")
    if (!verify && currentKind != "missing" && currentKind !=
        "symlink") return fail("current is not a symlink")
    if (verify && version == "") {
        if (currentKind != "symlink") return fail("no active companion")
        version = Path("$parentPath/current").linkTarget()
    }
    val selection = nativeSelectCatalog(catalogRead.data, version, host)
    if (selection.error != "") return fail(selection.error)
    val pins = selection.pins
    if (verify) {
        val target = parent.openDirectory(version)
        val checked = verifyCompanion(target, pins)
        if (checked.error != "") return fail(checked.error)
        val helper = nativeCheckTools("$parentPath/$version", pins.llvmVersion)
        if (helper != "") return fail(helper)
        linuxWriteStandardOutput("Xtensa companion fully verified: $parentPath/$version\n")
        return 0
    }
    // Existing versions are verified and checked before touching an archive.
    val existing = parent.entryKind(version)
    if (existing == "directory") {
        val target = parent.openDirectory(version)
        val checked = verifyCompanion(target, pins)
        if (checked.error != "") return fail(checked.error)
        val helper = nativeCheckTools("$parentPath/$version", pins.llvmVersion)
        if (helper != "") return fail(helper)
        if (!activate(parent, version)) return fail("activation failed")
        linuxWriteStandardOutput("Xtensa companion installed and selected: $parentPath/$version\n")
        return 0
    }
    if (existing != "missing") return fail("existing target is not a directory")
    var temporary = ""
    var downloadDirectory = SecureDirectory(-1)
    if (archivePath == "") {
        val random = secureRandomBytes(16)
        if (!random.succeeded) return fail("random")
        temporary = ".download-${hexEncode(random.bytes)}"
        val made = parent.createDirectoryStatus(temporary, 0o700)
        if (made == -28 || made == -122) return fail("disk_full")
        if (made != 0) return fail("download temporary directory")
        downloadDirectory = parent.openDirectory(temporary)
        val mode = downloadDirectory.setPermissionsChecked(0o700)
        if (mode != "") {
            if (!cleanupDownload(parent, downloadDirectory,
                temporary)) return fail("download cleanup: $temporary; $mode")
            return fail(if (mode == "disk_full") "disk_full" else "download temporary directory")
        }
        val output = downloadDirectory.createFile("archive.tar.gz", 0o600)
        var downloadError = ""
        if (output.descriptor == -28 || output.descriptor == -122) downloadError = "disk_full"
        else if (output.descriptor < 0) downloadError = "download temporary write"
        if (downloadError == "") downloadError = nativeDownloadTo(selection.url, output)
        if (downloadError == "") {
            val synced = output.syncChecked()
            if (synced != "") downloadError = if (synced ==
                "disk_full") "disk_full" else "download temporary write"
        }
        if (!output.close() && downloadError == "") downloadError = "download temporary write"
        if (downloadError != "") {
            if (!cleanupDownload(parent, downloadDirectory,
                temporary)) return fail("download cleanup: $temporary; $downloadError")
            return fail(downloadError)
        }
        archivePath = "$parentPath/$temporary/archive.tar.gz"
    }
    val archive = Path(archivePath)
    val archiveParent = secureDirectory(archive.parent().text)
    val archiveFile = archiveParent.openRegularFile(archive.name())
    val check = { name: string ->
        nativeCheckTools("$parentPath/$name", pins.llvmVersion)
    }
    val installed = if (temporary != "") extractSpooledCompanionChecked(parent, archiveFile, pins,
        check) else extractCompanionChecked(parent, archiveFile, pins, check)
    if (temporary != "") {
        archiveFile.close()
        if (!cleanupDownload(parent, downloadDirectory, temporary)) {
            return fail(nativeDownloadCleanupError(temporary, installed))
        }
    }
    if (installed.error != "") {
        return fail(nativeInstallError(installed))
    }
    if (!activate(parent, version)) return fail("activation failed")
    linuxWriteStandardOutput("Xtensa companion installed and selected: $parentPath/$version\n")
    0
}
