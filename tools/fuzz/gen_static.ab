// static_concat_check (#648): string `+` trees where some subtrees are static text (literals joined by `+`, which
// lowering folds into one constant) and others are not (parameters, locals, templates, calls, raw blocks). The trees are
// left-deep chains, right-deep chains and random shapes, up to 80 leaves, with static runs at the start, the end and in
// the middle, and with literals that hold escapes (\n, \t, \", \\, \$, \0, \xHH, \u{...}) and multibyte text. Each tree
// is used in one place: a local, a returned value, an argument, a default parameter, a module value, an array element,
// a `when` subject, an interpolation, a `==` with its expected text, `.size`, and a compile-time `#(...)`. The
// generator joins the leaves' texts itself; the check compares every result with that text (written with \xHH
// escapes, one literal) and returns the sizes and a byte hash, so a fold that drops, repeats or reorders a part fails in
// every mode, and a mode that folds differently from the others disagrees.
import "abla/text"
import "./prng.ab"
import "./gen.ab"

/** Literal leaves: the source spelling and the bytes it stands for. */
val FUZZ_STATIC_SOURCE: array<string> = ["a", "bc", "", "hello", "x y", "\\n", "\\t", "\\\"", "\\\\", "\\$", "\\\$x",
    "\\x41", "\\u00e9", "\\u{1F600}", "日本", "é", "\\0", "q\\nr", "{}", "\\\${", "+", "\\'"]
val FUZZ_STATIC_TEXT: array<string> = ["a", "bc", "", "hello", "x y", "\n", "\t", "\"", "\\", "$", "\$x",
    "A", "é", "😀", "日本", "é", "\0", "q\nr", "{}", "\${", "+", "'"]
/** Raw single-line blocks: backslashes and `$` are literal. */
val FUZZ_STATIC_RAW: array<string> = ["a\\n", "\$HOME", "", "x\\\\y", "{\$}", "é\\t"]

/** A leaf or a `+` node: kind "lit" (k indexes FUZZ_STATIC_SOURCE), "raw" (FUZZ_STATIC_RAW), "param" (p<k>), "local"
 *  (s<k>, a val of a literal), "tmpl" ("<${p<k>}>"), "call" (scId<index>(literal k)), "plus" (kids[0] + kids[1]). */
class StaticNode(val kind: string, val k: int, val kids: array<StaticNode>)

fun staticLeaf(kind: string, k: int): StaticNode = StaticNode(kind, k, [])

fun staticPlus(left: StaticNode, right: StaticNode): StaticNode = StaticNode("plus", 0, [left, right])

/** A leaf; `fixed` leaves are literals (a static run), else any kind. */
fun FuzzGen.staticLeafDraw(fixed: bool, params: int): StaticNode {
    if (fixed || this.r.chance(0.5)) {
        if (this.r.chance(0.12)) return staticLeaf("raw", this.r.below(FUZZ_STATIC_RAW.size))
        return staticLeaf("lit", this.r.below(FUZZ_STATIC_SOURCE.size))
    }
    val kind = this.r.below(4)
    if (kind == 0) return staticLeaf("param", this.r.below(params))
    if (kind == 1) return staticLeaf("local", this.r.below(FUZZ_STATIC_SOURCE.size))
    if (kind == 2) return staticLeaf("tmpl", this.r.below(params))
    staticLeaf("call", this.r.below(FUZZ_STATIC_SOURCE.size))
}

/** The leaves of a chain: static runs (all literals) mixed with runtime leaves; `allStatic` makes every leaf a literal. */
fun FuzzGen.staticLeaves(count: int, allStatic: bool, params: int): array<StaticNode> {
    val leaves: array<StaticNode> = []
    var run = 0
    while (leaves.size < count) {
        if (run == 0) run = if (allStatic) count else this.r.range(0, 6)
        val fixed = allStatic || run > 0
        leaves.append(this.staticLeafDraw(fixed, params))
        if (run > 0) run = run - 1
        if (!allStatic && run == 0 && leaves.size < count) leaves.append(this.staticLeafDraw(false, params))
    }
    leaves
}

/** A tree over `leaves[from..to)`: left-deep, right-deep or random. */
fun FuzzGen.staticShape(leaves: array<StaticNode>, from: int, to: int, shape: int): StaticNode {
    if (to - from == 1) return leaves[from]
    var split = to - 1
    if (shape == 1) split = from + 1
    if (shape == 2) split = from + 1 + this.r.below(to - from - 1)
    staticPlus(this.staticShape(leaves, from, split, shape), this.staticShape(leaves, split, to, shape))
}

/** Source text; `shape` 0 (left-deep) writes no parentheses where `+` already groups to the left. */
fun staticSource(node: StaticNode, index: int, top: bool): string {
    val kind = node.kind
    if (kind == "lit") return "\"" + FUZZ_STATIC_SOURCE[node.k] + "\""
    if (kind == "raw") return "\"\"\"" + FUZZ_STATIC_RAW[node.k] + "\"\"\""
    if (kind == "param") return "p${node.k}"
    if (kind == "local") return "s${node.k}"
    if (kind == "tmpl") return "\"<\${p${node.k}}>\""
    if (kind == "call") return "scId$index(\"" + FUZZ_STATIC_SOURCE[node.k] + "\")"
    val left = staticSource(node.kids[0], index, true)
    val right = staticSource(node.kids[1], index, false)
    // a left operand is never parenthesised (`+` is left-associative); a right one that is a `+` is
    if (top) "$left + $right" else "($left + $right)"
}

fun staticText(node: StaticNode, values: array<string>): string {
    val kind = node.kind
    if (kind == "lit" || kind == "local" || kind == "call") return FUZZ_STATIC_TEXT[node.k]
    if (kind == "raw") return FUZZ_STATIC_RAW[node.k]
    if (kind == "param") return values[node.k]
    if (kind == "tmpl") return "<" + values[node.k] + ">"
    staticText(node.kids[0], values) + staticText(node.kids[1], values)
}

fun staticIsStatic(node: StaticNode): bool {
    if (node.kind == "lit" || node.kind == "raw") return true
    if (node.kind != "plus") return false
    staticIsStatic(node.kids[0]) && staticIsStatic(node.kids[1])
}

val FUZZ_HEX_DIGITS = "0123456789abcdef"

/** One literal that spells `text` byte for byte: printable ASCII as itself, the rest as \xHH. */
fun fuzzByteLiteral(text: string): string {
    val out: array<string> = ["\""]
    var i = 0
    while (i < text.size) {
        val b = text[i]
        i = i + 1
        if (b >= 32 && b < 127 && b != 34 && b != 92 && b != 36) {
            out.append(text.slice(i - 1, i))
        } else {
            out.append("\\x" + FUZZ_HEX_DIGITS.slice(b >> 4, (b >> 4) + 1) + FUZZ_HEX_DIGITS.slice(b & 15, (b & 15) + 1))
        }
    }
    out.append("\"")
    textJoin(out, "")
}

val FUZZ_STATIC_PLACES: array<string> = ["local", "return", "argument", "default", "global", "array", "when",
    "interpolation", "equal", "size", "ct"]

fun FuzzGen.staticConcatCheck(index: int): FuzzCheck {
    val params = this.r.range(1, 3)
    val values: array<string> = []
    for (p in 0 until params) values.append(this.r.pick(FUZZ_STRINGS))
    val lines: array<string> = [
        "fun scId$index(s: string): string = s",
        "fun scShow$index(s: string): string = s"]
    val parameters: array<string> = []
    for (p in 0 until params) parameters.append("p$p: string")
    val body: array<string> = []
    for (k in 0 until FUZZ_STATIC_SOURCE.size) body.append("    val s$k = \"${FUZZ_STATIC_SOURCE[k]}\"")
    body.append("    var out = \"\"")
    body.append("    var bad = \"\"")
    val trees = this.r.range(2, 5)
    for (t in 0 until trees) {
        val count = this.r.pickInt([2, 2, 3, 4, 6, 9, 17, 33, 80])
        val allStatic = this.r.chance(0.35)
        val shape = this.r.below(3)
        val tree = this.staticShape(this.staticLeaves(count, allStatic, params), 0, count, shape)
        val source = staticSource(tree, index, true)
        val text = staticText(tree, values)
        val expected = fuzzByteLiteral(text)
        val e = "scExpected${index}x$t"
        var place = this.r.pick(FUZZ_STATIC_PLACES)
        // a default parameter, a module value and `#` take static text only
        if ((place == "default" || place == "global" || place == "ct") && !staticIsStatic(tree)) place = "local"
        body.append("    val $e = $expected")
        var got = ""
        if (place == "local") {
            body.append("    val t${index}x$t: string = $source")
            got = "t${index}x$t"
        } else if (place == "return") {
            lines.append("fun scR${index}x$t(${textJoin(parameters, ", ")}): string {")
            for (k in 0 until FUZZ_STATIC_SOURCE.size) lines.append("    val s$k = \"${FUZZ_STATIC_SOURCE[k]}\"")
            lines.append("    return $source")
            lines.append("}")
            val names: array<string> = []
            for (p in 0 until params) names.append("p$p")
            got = "scR${index}x$t(${textJoin(names, ", ")})"
        } else if (place == "argument") {
            got = "scShow$index($source)"
        } else if (place == "default") {
            lines.append("fun scD${index}x$t(s: string = $source): string = s")
            got = "scD${index}x$t()"
        } else if (place == "global") {
            lines.append("val scG${index}x$t: string = $source")
            got = "scG${index}x$t"
        } else if (place == "array") {
            body.append("    val a${index}x$t: array<string> = [\"-\", $source]")
            got = "a${index}x$t[1]"
        } else if (place == "when") {
            body.append("    val w${index}x$t = when ($source) { $expected -> \"same\"; else -> \"other\" }")
            body.append("    if (w${index}x$t != \"same\") bad = bad + \"when$t;\"")
            got = "($source)"
        } else if (place == "interpolation") {
            body.append("    val i${index}x$t = \"[\${$source}]\"")
            body.append("    if (i${index}x$t != \"[\" + $e + \"]\") bad = bad + \"interp$t;\"")
            got = "($source)"
        } else if (place == "equal") {
            body.append("    if (!($source == $expected)) bad = bad + \"eq$t;\"")
            got = "($source)"
        } else if (place == "size") {
            body.append("    if (($source).size != ${text.size}) bad = bad + \"size$t;\"")
            got = "($source)"
        } else {
            body.append("    val k${index}x$t: string = #($source)")
            got = "k${index}x$t"
        }
        body.append("    if ($got != $e) bad = bad + \"$place$t=\" + \"\${$got.size}:\${fuzzStaticHash$index($got)};\"")
        body.append("    out = out + \"\${$got.size}:\${fuzzStaticHash$index($got)};\"")
        if (t == 0) {
            lines.append("fun fuzzStaticHash$index(text: string): int {")
            lines.append("    var h = 7")
            lines.append("    for (b in text) h = (h * 31 + b) & 1099511627775")
            lines.append("    h")
            lines.append("}")
        }
    }
    body.append("    if (bad != \"\") return \"FUZZ_ORACLE_FAILURE:\" + bad")
    body.append("    out")
    lines.append("fun c$index(${textJoin(parameters, ", ")}): string {")
    for (line in body) lines.append(line)
    lines.append("}")
    val arguments: array<string> = []
    for (value in values) arguments.append("\"$value\"")
    FuzzCheck(lines, "c$index(${textJoin(arguments, ", ")})", "str", index)
}
