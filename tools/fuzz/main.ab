// The differential fuzzer in Abla (#648, decision #60): random well-typed Abla programs, each a list of independent
// checks, run six ways (native --fast, native release, the compile-time evaluator as interpreter and as native code,
// hostless Wasm release and development modules); output and exit status must agree. A disagreement is minimised to
// one check with the fewest statements that still disagrees. tools/fuzz/run builds this and runs it with
// ABLA_FUZZ_ROOT set to the repository.
//
//   tools/fuzz/run --seeds 100000-100039 [--checks 24] [--compiler build/ablac] [--focus json_check] [--keep]
//   ABLA_FUZZ_WASI=1 and ABLA_FUZZ_RISCV64=1 add wasm32-wasi (wasmtime) and riscv64-linux (qemu-riscv64).
//   The default corpus compares portable language values exactly; it does not generate pointer addresses or ABI sizes.
//   The libc campaign is native ABI-specific, and WASI is excluded from the hosted task/thread campaign.
//   tools/fuzz/run --seeds ... --record FILE        also the campaign record in FILE (a JSON array, record.ab): compiler
//                                                  revision and SHA-256, campaign, families, seeds, modes, agree and
//                                                  disagree counts, exit status; tools/readiness.sh reads it as fuzz.json
//   tools/fuzz/run --seeds ... --panics             also one panicking program per seed (native and Wasm)
//   tools/fuzz/run --seeds ... --hosted-tasks       task_check only, the four hosted modes (Wasm has no tasks)
//   tools/fuzz/run --seeds ... --libc               libc_check only (strtod, strtof, strtol, libm): native run vs compile-time jit, no interpreter, no Wasm
//   tools/fuzz/run --seeds ... --shared-globals     compile-time code sharing ordinary globals, interp/jit/auto
//   tools/fuzz/run --seeds ... --module-graphs      provider graphs: no cache, then cached phases and provider edits
//   tools/fuzz/run --seeds ... --subparser-graphs   subparser-built calls: no cache, cached phases, a provider edit
//   tools/fuzz/run --seeds ... --cross-target-tiers one Wasm child built at compile time under interp, jit and auto
//   tools/fuzz/run --seeds ... --integer-stores     an int stored into a narrower integer: refused or exact, in every site
//   tools/fuzz/run --seeds ... --compile-time-tiers the same checks behind `#` in interp, jit and the default tier
//   tools/fuzz/run --seeds ... --strict-flat        a module graph after fix-imports: flat and --strict-imports agree
//   tools/fuzz/run --regex --seeds ... [--cases 2000]  abla/regex against the independent oracle (regex_oracle.ab)
//   tools/fuzz/run --regex-corpus FILE | --control-regex   the oracle on the recorded Python results; its planted fault
//   tools/fuzz/run --check-subparser-refusals       generated-call diagnostics at their sites, in interp and JIT
//   tools/fuzz/run --check-hostless-capabilities    both hostless Wasm builders refuse a task and a thread
//   tools/fuzz/run --program x.ab [--show]          one existing program (with @export("run")), four ways
//   tools/fuzz/run --replay                         every tests/cases/fuzz-differential/*.ab, and no MISMATCH line
//   tools/fuzz/run --selftest                       the PRNG's reference vectors, the comparison, the JSON oracle
//   tools/fuzz/run --control-minimise | --control-oracle f1,f2   the suite's controls (tools/test-fuzz-abla.sh)
//
// This covers every check family (FUZZ_FAMILIES in families.ab; task_check through --hosted-tasks) and every
// campaign of the Python fuzzer it replaced (tools/fuzz-differential, now removed). Seeds are not shared with it:
// this PRNG is xoshiro256**, so seed N here is not the Python's seed N. Use seeds from 100000 up.
import "abla/io"
import "abla/text"
import "abla/integer"
import "abla/fs"
import "abla/process/arguments"
import "abla/process/environment"
import "./gen.ab"
import "./families.ab"
import "./modes.ab"
import "./verdict.ab"
import "./oracle.ab"
import "./graphs.ab"
import "./gen_regex.ab"
import "./stores.ab"
import "./strictflat.ab"
import "./campaigns.ab"
import "./gen_libc.ab"
import "./prng.ab"
import "./record.ab"

class FuzzOptions(
    var seeds: array<int>,
    var checks: int,
    var compiler: string,
    var timeout: int,
    var focus: string,
    var keep: bool,
    var program: string,
    var show: bool,
    var replay: bool,
    var selftest: bool,
    var noAny: bool,
    var controlMinimise: bool,
    var controlOracle: string,
    var hostedTasks: bool,
    var panics: bool,
    var checkHostless: bool,
    var sharedGlobals: bool,
    var moduleGraphs: bool,
    var subparserGraphs: bool,
    var checkRefusals: bool,
    var crossTargetTiers: bool,
    var regex: bool,
    var controlRegex: bool,
    var regexCases: int,
    var regexCorpus: string,
    var integerStores: bool,
    var compileTimeTiers: bool,
    var strictFlat: bool,
    var libc: bool,
    var record: string,
    var recordRevision: string,
    var recordDirty: bool,
    var recordCompilerSha256: string,
    var recordCompilerVersion: string,
    var recordCommand: string,
    var recordCompiler: string
)

val FUZZ_WORK = "build/fuzz-abla"

var fuzzUsageError = ""

fun fuzzParseInt(text: string): int {
    val parsed = text.trim().parseInt() ?? -1
    if (parsed < 0 && fuzzUsageError == "") fuzzUsageError = "not a number: $text"
    parsed
}

/** A seed or a range such as 5-9, or a comma-separated list of those. */
fun fuzzSeedRange(text: string, var into: array<int>): void {
    for (part in text.split(",")) {
        val dash = part.indexOf("-")
        if (dash > 0) {
            val low = fuzzParseInt(part.slice(0, dash))
            val high = fuzzParseInt(part.slice(dash + 1, part.size))
            var seed = low
            while (seed <= high) {
                into.append(seed)
                seed = seed + 1
            }
        } else {
            into.append(fuzzParseInt(part))
        }
    }
    return
}

fun fuzzOptions(root: string): FuzzOptions {
    val options = FuzzOptions([], 24, "$root/build/ablac", 120, "", false, "", false, false, false, false, false, "", false, false, false, false, false, false, false, false, false, false, 2000, "", false, false, false, false, "", "unknown", false, "", "", "", "")
    var seedText = "1"
    var index = 0
    val count = processArgumentCount()
    while (index < count) {
        val argument = processArgument(index)
        val value = if (index + 1 < count) processArgument(index + 1) else ""
        var takes = true
        if (argument == "--seeds" || argument == "--seed") {
            seedText = value
        } else if (argument == "--checks") {
            options.checks = fuzzParseInt(value)
        } else if (argument == "--compiler") {
            options.compiler = value
        } else if (argument == "--timeout") {
            options.timeout = fuzzParseInt(value)
        } else if (argument == "--focus") {
            options.focus = value
        } else if (argument == "--program") {
            options.program = value
        } else if (argument == "--control-oracle") {
            options.controlOracle = value
        } else if (argument == "--cases") {
            options.regexCases = fuzzParseInt(value)
        } else if (argument == "--regex-corpus") {
            options.regexCorpus = value
        } else if (argument == "--record") {
            options.record = value
        } else if (argument == "--record-revision") {
            options.recordRevision = value
        } else if (argument == "--record-dirty") {
            options.recordDirty = value == "1"
        } else if (argument == "--record-compiler-sha256") {
            options.recordCompilerSha256 = value
        } else if (argument == "--record-compiler-version") {
            options.recordCompilerVersion = value
        } else if (argument == "--record-command") {
            options.recordCommand = value
        } else if (argument == "--record-compiler") {
            options.recordCompiler = value
        } else {
            takes = false
            if (argument == "--keep") {
                options.keep = true
            } else if (argument == "--show") {
                options.show = true
            } else if (argument == "--replay") {
                options.replay = true
            } else if (argument == "--selftest") {
                options.selftest = true
            } else if (argument == "--no-any") {
                options.noAny = true
            } else if (argument == "--hosted-tasks") {
                options.hostedTasks = true
            } else if (argument == "--panics") {
                options.panics = true
            } else if (argument == "--check-hostless-capabilities") {
                options.checkHostless = true
            } else if (argument == "--shared-globals") {
                options.sharedGlobals = true
            } else if (argument == "--module-graphs") {
                options.moduleGraphs = true
            } else if (argument == "--subparser-graphs") {
                options.subparserGraphs = true
            } else if (argument == "--check-subparser-refusals") {
                options.checkRefusals = true
            } else if (argument == "--cross-target-tiers") {
                options.crossTargetTiers = true
            } else if (argument == "--integer-stores") {
                options.integerStores = true
            } else if (argument == "--compile-time-tiers") {
                options.compileTimeTiers = true
            } else if (argument == "--libc") {
                options.libc = true
            } else if (argument == "--strict-flat") {
                options.strictFlat = true
            } else if (argument == "--regex") {
                options.regex = true
            } else if (argument == "--control-regex") {
                options.controlRegex = true
            } else if (argument == "--control-minimise") {
                options.controlMinimise = true
            } else if (fuzzUsageError == "") {
                fuzzUsageError = "unknown argument: $argument"
            }
        }
        if (takes && index + 1 >= count && fuzzUsageError == "") fuzzUsageError = "$argument needs a value"
        index = index + (if (takes) 2 else 1)
    }
    fuzzSeedRange(seedText, options.seeds)
    if (options.hostedTasks) {
        if (options.focus != "" && options.focus != "task_check") fuzzUsageError = "--hosted-tasks draws task_check only"
        if (options.panics || options.program != "") fuzzUsageError = "--hosted-tasks cannot be combined with --panics or --program"
        options.focus = "task_check"
    } else if (options.focus == "task_check") {
        fuzzUsageError = "task_check requires --hosted-tasks; it is not a hostless Wasm check"
    }
    if (options.libc) {
        if (options.focus != "" && options.focus != "libc_check") fuzzUsageError = "--libc draws libc_check only"
        if (options.panics || options.program != "") fuzzUsageError = "--libc cannot be combined with --panics or --program"
        options.focus = "libc_check"
        fuzzSkipInterpreter = true
    } else if (options.focus == "libc_check") {
        fuzzUsageError = "libc_check requires --libc (no interpreter, no Wasm mode)"
    }
    var campaigns = 0
    for (on in [options.sharedGlobals, options.moduleGraphs, options.subparserGraphs, options.crossTargetTiers,
        options.hostedTasks, options.checkRefusals, options.checkHostless, options.integerStores, options.compileTimeTiers,
        options.strictFlat, options.libc]) {
        if (on) campaigns = campaigns + 1
    }
    if (campaigns > 1) fuzzUsageError = "choose one campaign at a time"
    if ((options.moduleGraphs || options.subparserGraphs || options.crossTargetTiers) &&
        (options.focus != "" || options.panics || options.program != "")) {
        fuzzUsageError = "graph and tier campaigns cannot be combined with --focus, --panics or --program"
    }
    if (options.sharedGlobals && (options.hostedTasks || options.focus != "" || options.panics || options.program != "")) {
        fuzzUsageError = "--shared-globals cannot be combined with other campaigns"
    }
    if (options.focus != "" && options.focus != "task_check" && options.focus != "libc_check" && !fuzzHasFamily(options.focus)) {
        fuzzUsageError = "--focus ${options.focus}: no such generator (have: ${textJoin(FUZZ_FAMILIES, ", ")})"
    }
    options
}

fun fuzzRemove(path: string): void {
    if (Path(path).exists()) Path(path).removeTree()
    return
}

fun fuzzPrelude(root: string): string = Path("$root/tools/fuzz/prelude.txt").readText()

/** Reduces a disagreement to one check, then to fewer statements: the report's lines. */
fun fuzzMinimise(runner: FuzzRunner, options: FuzzOptions, prelude: string, seed: int, checks: array<FuzzCheck>,
    results: array<FuzzResult>, first: string): string {
    val report: array<string> = ["seed $seed: $first"]
    val ids = fuzzDifferingLines(results)
    if (ids.size == 0) {
        report.append("  no single check line differs (build or exit status differs); kept whole")
        return textJoin(report, "\n")
    }
    var taken = 0
    for (key in ids) {
        if (taken < 3) {
            taken = taken + 1
            var check = checks[0]
            for (candidate in checks) {
                if ("c${candidate.index}" == key) check = candidate
            }
            var lines = fuzzCopyLines(check.lines)
            var tag = 0
            var got = fuzzStill(runner, options, prelude, seed, key, check, lines, "base")
            if (got == "") {
                report.append("  $key: disagreement does not reproduce alone")
            } else {
                // Drop body lines one at a time while the same check still disagrees; repeat the pass until none can go (a
                // line that a later one reads can go once that later one has; the Python made one pass).
                var shrinking = true
                while (shrinking) {
                    shrinking = false
                    var at = 1
                    while (at < lines.size - 2) {
                        val candidate: array<string> = []
                        var line = 0
                        while (line < lines.size) {
                            if (line != at) candidate.append(lines[line])
                            line = line + 1
                        }
                        tag = tag + 1
                        val trial = fuzzStill(runner, options, prelude, seed, key, check, candidate, "$tag")
                        if (trial != "") {
                            lines = candidate
                            got = trial
                            shrinking = true
                        } else {
                            at = at + 1
                        }
                    }
                }
                report.append("  $key minimised to ${lines.size} lines:")
                for (line in lines) report.append("    $line")
                report.append("  call: ${check.call}")
                report.append("  outputs: $got")
                val kept = "$FUZZ_WORK/min$seed-$key"
                Path("${runner.root}/$kept").createDirectories()
                Path("${runner.root}/$kept/program.ab")
                    .writeText(fuzzAssemble(prelude, [FuzzCheck(lines, check.call, check.ty, check.index)], false))
                report.append("  kept: $kept/program.ab")
            }
        }
    }
    textJoin(report, "\n")
}

/** The verdict when the one check with these lines still makes `key` differ and every mode built; else "". */
fun fuzzStill(runner: FuzzRunner, options: FuzzOptions, prelude: string, seed: int, key: string, check: FuzzCheck,
    lines: array<string>, tag: string): string {
    val directory = "$FUZZ_WORK/min$seed-$key-$tag"
    val got = runner.allModes(directory, prelude, [FuzzCheck(lines, check.call, check.ty, check.index)], !(options.hostedTasks || options.libc))
    var ok = fuzzVerdict(got) != ""
    for (result in got) {
        if (!result.built) ok = false
    }
    if (ok) {
        ok = false
        for (id in fuzzDifferingLines(got)) {
            if (id == key) ok = true
        }
    }
    if (!options.keep) fuzzRemove("${runner.root}/$directory")
    if (ok) fuzzVerdict(got) else ""
}

/** A fresh copy, so the minimiser can replace it. */
fun fuzzCopyLines(lines: array<string>): array<string> {
    val copy: array<string> = []
    for (line in lines) copy.append(line)
    copy
}

fun fuzzRunSeed(runner: FuzzRunner, options: FuzzOptions, prelude: string, seed: int): string {
    val gen = fuzzGen(seed, !options.noAny, options.focus)
    val checks: array<FuzzCheck> = []
    for (index in 0 until options.checks) checks.append(gen.check(index))
    val directory = "$FUZZ_WORK/seed$seed"
    val results = runner.allModes(directory, prelude, checks, !(options.hostedTasks || options.libc))
    val bad = fuzzVerdict(results)
    if (bad == "") {
        if (!options.keep) fuzzRemove("${runner.root}/$directory")
        return if (options.panics) fuzzRunPanic(runner, seed, options.keep) else ""
    }
    fuzzMinimise(runner, options, prelude, seed, checks, results, bad)
}

/** The same checks, every one behind `#`, computed by the evaluator's interpreter, by its native code and by the default
 * tier (ABLA_COMPILE_EVAL unset), beside a native build as the reference: "" when all four print the same lines. */
fun fuzzRunTiers(runner: FuzzRunner, options: FuzzOptions, prelude: string, seed: int): string {
    val gen = fuzzGen(seed, !options.noAny, options.focus)
    val checks: array<FuzzCheck> = []
    for (index in 0 until options.checks) checks.append(gen.check(index))
    val directory = "$FUZZ_WORK/tiers$seed"
    val absolute = "${runner.root}/$directory"
    Path(absolute).createDirectories()
    Path("$absolute/program.ab").writeText(fuzzAssemble(prelude, checks, false))
    Path("$absolute/program-ct.ab").writeText(fuzzAssemble(prelude, checks, true))
    val jobs: array<FuzzJob> = [
        fuzzNativeJob(runner, "$absolute/program.ab", "$absolute/native", true, ""),
        fuzzNativeJob(runner, "$absolute/program-ct.ab", "$absolute/interp", true, "interp"),
        fuzzNativeJob(runner, "$absolute/program-ct.ab", "$absolute/jit", true, "jit"),
        fuzzNativeJob(runner, "$absolute/program-ct.ab", "$absolute/default", true, "")
    ]
    runner.runJobs(jobs)
    val results: array<FuzzResult> = [
        fuzzNativeResult("native", jobs[0], "$absolute/native"),
        fuzzNativeResult("interp", jobs[1], "$absolute/interp"),
        fuzzNativeResult("jit", jobs[2], "$absolute/jit"),
        fuzzNativeResult("default", jobs[3], "$absolute/default")
    ]
    val bad = fuzzVerdict(results)
    if (bad == "") {
        if (!options.keep) fuzzRemove(absolute)
        return ""
    }
    "tiers seed $seed (sources in $directory): $bad; checks ${textJoin(fuzzDifferingLines(results), ",")}"
}

/** One existing program, four ways (no compile-time variant): "" when they agree. */
fun fuzzRunProgram(runner: FuzzRunner, source: string, name: string): array<FuzzResult> {
    val directory = "$FUZZ_WORK/$name"
    Path("${runner.root}/$directory").createDirectories()
    Path("${runner.root}/$directory/program.ab").writeText(Path(source).readText())
    runner.modesOf(directory, "$directory/program.ab", "", true)
}

fun fuzzShown(result: FuzzResult): string =
    if (result.built) result.output else textJoin(result.errors, "\n") + "\n"

fun fuzzReplay(runner: FuzzRunner): int {
    val cases: array<string> = []
    for (entry in Path("${runner.root}/tests/cases/fuzz-differential").entries()) {
        if (entry.text.endsWith(".ab")) cases.append(entry.text)
    }
    var failures = 0
    for (source in sortedStrings(cases)) {
        val results = fuzzRunProgram(runner, source, "replay")
        val bad = fuzzVerdict(results)
        if (bad != "") {
            println("$source: $bad")
            failures = failures + 1
        } else if (results[0].output.contains("MISMATCH")) {
            println("$source: compile time disagrees with run time")
            failures = failures + 1
        } else {
            println("$source: all modes agree")
        }
    }
    if (failures == 0) println("fuzz: ${cases.size} recorded cases agree in every mode")
    if (failures == 0) 0 else 1
}

/** The minimiser on a planted disagreement (FuzzRunner.plant: the Wasm release module's `c0=planted` reads differently).
 * Three padding lines go; the check keeps its header, the line that makes the value, its result and its brace. */
fun fuzzControlMinimise(runner: FuzzRunner, options: FuzzOptions, prelude: string): int {
    val lines = ["fun c0(): string {", "    val pad0 = 1 + 2", "    val pad1 = \"x\" + \"\$pad0\"", "    val pad2 = pad0 * 3",
        "    val seen = \"plant\" + \"ed\"", "    \"\${seen}\"", "}"]
    val checks = [FuzzCheck(lines, "c0()", "str", 0)]
        val results = runner.allModes("$FUZZ_WORK/control-minimise", prelude, checks, true)
    val bad = fuzzVerdict(results)
    val report = if (bad == "") "" else fuzzMinimise(runner, options, prelude, 0, checks, results, bad)
    if (!report.contains("c0 minimised to 4 lines:") || !report.contains("    val seen = \"plant\" + \"ed\"")) {
        eprintln("fuzz: minimiser control failed:\n$report")
        return 1
    }
    println("fuzz: a planted Wasm difference is found and minimised to its 4 essential lines")
    0
}

/** The check with its expectation changed, as the Python's suite controls did: a drop log compared as `actual + "x"`,
 * a gzip round trip as `decoded.data + "x"`, a JSON or YAML `expected` text, or a generator's own expected text
 * (`scExpected`, `gcExpected`, `swExpected`, `dnExpected`, `urExpected`, `koExpected`), with "x" appended. None when it
 * has none. */
fun fuzzCorrupt(lines: array<string>): array<string> {
    val broken: array<string> = []
    var changed = false
    for (line in lines) {
        var next = line.replace("if (actual != ", "if (actual + \"x\" != ")
        next = next.replace("decoded.data != original", "decoded.data + \"x\" != original")
        if (next.startsWith("    val expected = ")) next = next + " + \"x\""
        if (next.startsWith("    val scExpected") || next.startsWith("    val gcExpected") || next.startsWith("    val swExpected") || next.startsWith("    val dnExpected") || next.startsWith("    val urExpected") || next.startsWith("    val koExpected")) next = next + " + \"x\""
        if (next != line) changed = true
        broken.append(next)
    }
    if (!changed) return []
    broken
}

/** The families' oracles on their own checks, one check each (c0, c1, ...) in one program: as generated every check
 * agrees in every mode, and with each expectation changed every mode prints FUZZ_ORACLE_FAILURE for every check.
 * `families` is comma-separated. 0 when both hold. */
fun fuzzControlOracle(runner: FuzzRunner, families: string, prelude: string): int {
    val names = families.split(",")
    val good: array<FuzzCheck> = []
    val bad: array<FuzzCheck> = []
    for (index in 0 until names.size) {
        // The first seed from 100000 whose check has an expectation to change (a YAML check may be a malformed-input
        // one). Indexes make the checks' names distinct.
        var seed = 100000
        var check = fuzzGen(seed, true, names[index]).check(index)
        while (fuzzCorrupt(check.lines).size == 0 && seed < 100100) {
            seed = seed + 1
            check = fuzzGen(seed, true, names[index]).check(index)
        }
        val broken = fuzzCorrupt(check.lines)
        if (broken.size == 0) {
            eprintln("fuzz: ${names[index]} control: no check of seeds 100000-100100 has an expectation to change")
            return 1
        }
        good.append(check)
        bad.append(FuzzCheck(broken, check.call, check.ty, index))
    }
    val agreed = fuzzVerdict(runner.allModes("$FUZZ_WORK/control-oracle-good", prelude, good, true))
    if (agreed != "") {
        eprintln("fuzz: oracle control: the checks as generated do not agree: $agreed")
        return 1
    }
    val results = runner.allModes("$FUZZ_WORK/control-oracle-bad", prelude, bad, true)
    for (result in results) {
        for (index in 0 until names.size) {
            if (!result.built || !result.output.contains("c$index=FUZZ_ORACLE_FAILURE")) {
                eprintln("fuzz: ${names[index]} control: ${result.mode} did not report the wrong expectation: " +
                    result.describe())
                return 1
            }
        }
    }
    if (fuzzVerdict(results) == "" || fuzzDifferingLines(results).size != names.size) {
        eprintln("fuzz: oracle control: the comparison did not single out every check")
        return 1
    }
    println("fuzz: a wrong expectation is reported in all six modes for ${textJoin(names, ", ")}")
    0
}

fun fuzzAbsolute(path: string): string {
    if (path.startsWith("/")) return path
    val here = processEnvironment("PWD") ?? ""
    if (here == "") path else "$here/$path"
}

var fuzzRecordFailed = false

/** Reports the first record write that failed; the campaign goes on, and exits 2 at the end if it would have exited 0. */
fun fuzzRecordNote(problem: string): void {
    if (problem != "" && !fuzzRecordFailed) {
        eprintln("fuzz: --record: $problem")
        fuzzRecordFailed = true
    }
    return
}

fun fuzzRecordEnd(var record: FuzzRecord, status: int): int {
    fuzzRecordNote(record.finish(status))
    if (fuzzRecordFailed && status == 0) 2 else status
}

/** The seed campaign the options select, as the record names it. */
fun fuzzCampaignName(options: FuzzOptions): string =
    if (options.moduleGraphs) "module-graphs" else if (options.subparserGraphs) "subparser-graphs"
    else if (options.crossTargetTiers) "cross-target-tiers" else if (options.integerStores) "integer-stores"
    else if (options.compileTimeTiers) "compile-time-tiers" else if (options.strictFlat) "strict-flat"
    else if (options.sharedGlobals) "shared-globals" else if (options.regex) "regex"
    else if (options.hostedTasks) "hosted-tasks" else if (options.libc) "libc"
    else if (options.panics) "default+panics" else "default"

/** The families a campaign's checks are drawn from: the focused one, the whole mix, or the campaign's own generator. */
fun fuzzCampaignFamilies(options: FuzzOptions, campaign: string): array<string> {
    if (options.focus != "") return [options.focus]
    if (campaign != "default" && campaign != "default+panics" && campaign != "compile-time-tiers") return [campaign]
    val families: array<string> = []
    for (family in FUZZ_FAMILIES) {
        if (!(options.noAny && family == "any_pool_check")) families.append(family)
    }
    families
}

fun main: int {
    val root = processEnvironment("ABLA_FUZZ_ROOT") ?? ""
    if (root == "") {
        eprintln("fuzz: run through tools/fuzz/run (ABLA_FUZZ_ROOT is not set)")
        return 2
    }
    val options = fuzzOptions(root)
    if (options.record != "" && (options.selftest || options.controlRegex || options.regexCorpus != "" || options.replay ||
        options.program != "" || options.checkHostless || options.checkRefusals || options.controlMinimise ||
        options.controlOracle != "") && fuzzUsageError == "") {
        fuzzUsageError = "--record records seed campaigns only"
    }
    if (fuzzUsageError != "") {
        eprintln("fuzz: $fuzzUsageError")
        return 2
    }
    val campaign = fuzzCampaignName(options)
    var record = fuzzRecordStart(if (options.record == "") "" else fuzzAbsolute(options.record),
        if (options.recordCommand == "") "tools/fuzz/run" else options.recordCommand, options.recordRevision,
        options.recordDirty, if (options.recordCompiler == "") fuzzAbsolute(options.compiler) else options.recordCompiler,
        options.recordCompilerSha256, options.recordCompilerVersion,
        campaign, fuzzCampaignFamilies(options, campaign), if (options.regex) options.regexCases else options.checks,
        options.seeds)
    if (options.record != "") {
        val problem = fuzzRecordWrite(record)
        if (problem != "") {
            eprintln("fuzz: --record: $problem")
            return 2
        }
    }
    if (options.selftest) {
        val prng = prngSelftest()
        if (prng != "") {
            eprintln("fuzz: PRNG self-test failed: $prng")
            return 1
        }
        val comparison = fuzzVerdictSelftest()
        if (comparison != "") {
            eprintln(comparison)
            return 1
        }
        val oracle = fuzzOracleSelftest(root)
        if (oracle != "") {
            eprintln("fuzz: oracle self-test failed: $oracle")
            return 1
        }
        println("fuzz: PRNG reference vectors, comparison and JSON oracle fixture self-tests passed")
        return 0
    }
    if (options.controlRegex) return rxControl()
    if (options.regexCorpus != "") return rxCorpusCheck(Path(fuzzAbsolute(options.regexCorpus)).readText())
    val wasi = processEnvironment("ABLA_FUZZ_WASI_RUNNER") ?? ""
    val riscv = processEnvironment("ABLA_FUZZ_RISCV64_RUNNER") ?? ""
    if (wasi != "" && (options.hostedTasks || options.libc)) {
        println("fuzz: wasm32-wasi skipped (campaign requires native tasks/threads or libc)")
    }
    if (riscv != "" && options.libc) println("fuzz: riscv64-linux skipped (libc campaign compares the host C ABI)")
    val runner = FuzzRunner(root, fuzzAbsolute(options.compiler), options.timeout, options.controlMinimise,
        if (options.hostedTasks || options.libc) "" else wasi, if (options.libc) "" else riscv)
    if (options.replay) return fuzzReplay(runner)
    if (options.program != "") {
        val results = fuzzRunProgram(runner, fuzzAbsolute(options.program), "program")
        if (options.show) {
            print(fuzzShown(results[0]))
            return 0
        }
        val bad = fuzzVerdict(results)
        println(if (bad == "") "all modes agree" else bad)
        return if (bad == "") 0 else 1
    }
    if (options.regex) {
        var failed = 0
        for (seed in options.seeds) {
            val report = rxRun(seed, options.regexCases, 0)
            println(report.text)
            failed = failed + report.failures
            fuzzSawMode("regex oracle")
            fuzzRecordNote(record.seed(seed, report.failures == 0))
        }
        return fuzzRecordEnd(record, if (failed == 0) 0 else 1)
    }
    if (options.checkHostless) return fuzzCheckHostlessCapabilities(runner)
    if (options.checkRefusals) return fuzzCheckSubparserRefusals(runner)
    if (options.moduleGraphs || options.subparserGraphs || options.crossTargetTiers) {
        var failed = 0
        for (seed in options.seeds) {
            var found = ""
            if (options.moduleGraphs) {
                found = fuzzRunModuleGraph(runner, seed, options.keep)
                if (found == "") println("graph seed $seed: no-cache, cached cold/warm/discovery-hit and provider edits agree in all six modes")
            } else if (options.subparserGraphs) {
                found = fuzzRunSubparserGraph(runner, seed, options.keep)
                if (found == "") println("subparser seed $seed: no-cache, cached cold/warm/helper-hit and provider edit agree in all six modes")
            } else {
                found = fuzzRunCrossTargetTiers(runner, seed, options.keep)
                for (tier in ["interp", "jit", "auto"]) fuzzSawMode(tier)
            }
            fuzzRecordNote(record.seed(seed, found == ""))
            if (found != "") {
                failed = failed + 1
                println(found)
            }
        }
        return fuzzRecordEnd(record, if (failed == 0) 0 else 1)
    }
    if (options.integerStores || options.compileTimeTiers || options.strictFlat) {
        var failed = 0
        for (seed in options.seeds) {
            var found = ""
            if (options.integerStores) found = fuzzRunStores(runner, seed, options.keep)
            else if (options.compileTimeTiers) found = fuzzRunTiers(runner, options, fuzzPrelude(root), seed)
            else found = fuzzRunStrictFlat(runner, seed, options.keep)
            fuzzRecordNote(record.seed(seed, found == ""))
            if (found != "") {
                failed = failed + 1
                println(found)
            } else if (options.integerStores) {
                println("integer stores seed $seed: every site of every class is refused or keeps the exact value, in all four modes")
            } else if (options.compileTimeTiers) {
                println("tiers seed $seed: ${options.checks} compile-time checks agree in interp, jit and the default tier")
            } else {
                println("strict-flat seed $seed: the graph builds and runs the same flat and with --strict-imports after fix-imports")
            }
        }
        return fuzzRecordEnd(record, if (failed == 0) 0 else 1)
    }
    if (options.sharedGlobals) {
        // (its tiers, as the record names them: the campaign does not go through modesOf)
        for (tier in ["interp", "jit", "auto"]) fuzzSawMode(tier)
        var failed = 0
        for (seed in options.seeds) {
            val found = fuzzRunSharedGlobals(runner, seed, options.keep)
            fuzzRecordNote(record.seed(seed, found == ""))
            if (found != "") {
                failed = failed + 1
                println(found)
            } else {
                println("shared globals seed $seed: ${FUZZ_SHARED_KINDS.size} shapes agree with their expected lines in interp/jit/auto")
            }
        }
        return fuzzRecordEnd(record, if (failed == 0) 0 else 1)
    }
    val prelude = if (options.libc) fuzzLibcPrelude() else if (options.hostedTasks) FUZZ_PRELUDE_TASK else fuzzPrelude(root)
    if (options.controlMinimise) return fuzzControlMinimise(runner, options, prelude)
    if (options.controlOracle != "") {
        for (family in options.controlOracle.split(",")) {
            if (!fuzzHasFamily(family)) {
                eprintln("fuzz: --control-oracle $family: no such generator")
                return 2
            }
        }
        return fuzzControlOracle(runner, options.controlOracle, prelude)
    }
    var failures = 0
    for (seed in options.seeds) {
        val found = fuzzRunSeed(runner, options, prelude, seed)
        fuzzRecordNote(record.seed(seed, found == ""))
        if (found != "") {
            failures = failures + 1
            println(found)
        } else {
            val modes = if (options.libc) "fast, release and compile-time jit (and the extra axes)" else if (options.hostedTasks) "four hosted modes (Wasm unsupported)" else "all six modes"
            val wasiMode = if (runner.wasiRunner != "") " + wasm32-wasi" else ""
            val riscvMode = if (runner.riscv64Runner != "") " + riscv64-linux" else ""
            println("seed $seed: ${options.checks} checks agree in $modes$wasiMode$riscvMode")
        }
    }
    fuzzRecordEnd(record, if (failures == 0) 0 else 1)
}
