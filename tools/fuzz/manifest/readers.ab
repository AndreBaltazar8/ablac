// What the compiler's own manifest and lock readers see in a manifest (#1139 area 2, round 2). The readers are line-based and hand written (src/package.ab, src/module.ab,
// src/import_remap.ab); a dependency's abla.toml is untrusted, so what they read must be what a TOML parser reads. tools/fuzz/manifest/main.go writes COUNT cases
// (DIRECTORY/c0 ... c<COUNT-1>, each with an abla.toml and an abla.lock), runs this program over them and compares its output with BurntSushi/toml's reading of the same files.
//
//   readers DIRECTORY COUNT
//
// Output, per case, one line per reader, every string in hex (so any byte is exact):
//   CASE i
//   STR key value                      bootstrapPackageManifestString(manifest, key)
//   ARR key n value...                 bootstrapPackageManifestStringArray(manifest, key)
//   DEP accepted errors (name git kind selector)...      bootstrapPackageManifestDependencies
//   EXP found n (name target)...       bootstrapPackageReadExports
//   IMP n (written target code)...     bootstrapImportRemapLines
//   GRANT n entry...                   bootstrapManifestNamedCompileGrants
//   LOCK valid n (name provider identity source kind selector revision digest entry)...   bootstrapPackageReadLock
import "../../../src/package.ab"
import "../../../src/module.ab"
import "../../../src/import_remap.ab"
import "abla/io"
import "abla/crypto"
import "abla/integer"
import "abla/process/arguments"
import "abla/text"

fun hx(value: string): string = if (value.size == 0) "-" else hexEncode(value)

fun main: int {
    if (processArgumentCount() < 2) {
        println("usage: readers DIRECTORY COUNT")
        return 2
    }
    val directory = processArgument(0)
    val count = processArgument(1).parseInt() ?? 0
    val stringKeys: array<string> = ["name", "entry", "visibility", "version"]
    val arrayKeys: array<string> = ["compileCapabilities", "wasmHostImports", "nativeLibraries"]
    for (i in 0 until count) {
        val manifest = "$directory/c$i/abla.toml"
        val lock = "$directory/c$i/abla.lock"
        println("CASE $i")
        for (key in stringKeys) println("STR $key ${hx(bootstrapPackageManifestString(manifest, key))}")
        for (key in arrayKeys) {
            val values = bootstrapPackageManifestStringArray(manifest, key)
            var line = "ARR $key ${values.size}"
            for (v in values) line = line + " " + hx(v)
            println(line)
        }
        val dependencies = bootstrapPackageManifestDependencies(manifest)
        var dependencyLine = "DEP ${dependencies.values.size} ${dependencies.errors}"
        for (d in dependencies.values) dependencyLine = dependencyLine + " " + hx(d.name) + " " + hx(d.source) + " " + hx(d.selectorKind) + " " + hx(d.selector)
        println(dependencyLine)
        val exports = bootstrapPackageReadExports(manifest)
        var exportLine = "EXP ${if (exports.found) 1 else 0} ${exports.names.size}"
        for (k in 0 until exports.names.size) exportLine = exportLine + " " + hx(exports.names[k]) + " " + hx(exports.targets[k])
        println(exportLine)
        val imports = bootstrapImportRemapLines(manifest)
        var importLine = "IMP ${imports.size}"
        for (e in imports) importLine = importLine + " " + hx(e.written) + " " + hx(e.writtenTarget) + " " + hx(e.code)
        println(importLine)
        val grants = bootstrapManifestNamedCompileGrants(manifest)
        var grantLine = "GRANT ${grants.size}"
        for (g in grants) grantLine = grantLine + " " + hx(g)
        println(grantLine)
        val locked = bootstrapPackageReadLock(lock)
        var lockLine = "LOCK ${if (locked.valid) 1 else 0} ${locked.packages.size}"
        for (p in locked.packages) {
            lockLine = lockLine + " " + hx(p.name) + " " + hx(p.provider) + " " + hx(p.identity) + " " + hx(p.source) + " " + hx(p.selectorKind) + " " + hx(p.selector) + " " + hx(p.revision) + " " + hx(p.digest) + " " + hx(p.entry)
        }
        println(lockLine)
    }
    0
}
