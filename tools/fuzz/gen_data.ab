// Batch D of the port: abla/json, abla/yaml and gzip checks. The expectations come from oracle.ab (the generator's
// own value tree and serialiser) and from the generated bytes themselves, never from the libraries under test.
import "abla/text"
import "./prng.ab"
import "./gen.ab"
import "./oracle.ab"

val FUZZ_JSON_KEYS: array<string> = ["alpha", "z", "é", "q\"", "line"]
// "line\n\t\x01" as bytes: a newline, a tab and the control byte 1.
val FUZZ_JSON_STRINGS: array<string> = ["", "hé😀", "quote\"slash\\", "line\n\t\x01", "\$name"]

/** The Python's value(depth): a container 55% of the time while depth remains, else a scalar. */
fun FuzzGen.jsonValue(depth: int): FuzzValue {
    if (depth > 0 && this.r.chance(0.55)) {
        if (this.r.chance(0.5)) {
            val items: array<FuzzValue> = []
            val count = this.r.below(4)
            for (i in 0 until count) items.append(this.jsonValue(depth - 1))
            return fuzzList(items)
        }
        val keys: array<string> = []
        val items: array<FuzzValue> = []
        for (at in this.r.permutation(FUZZ_JSON_KEYS.size, this.r.below(4))) {
            keys.append(FUZZ_JSON_KEYS[at])
            items.append(this.jsonValue(depth - 1))
        }
        return fuzzObject(keys, items)
    }
    val pick = this.r.below(9)
    if (pick == 0) return fuzzNull()
    if (pick == 1) return fuzzBoolean(true)
    if (pick == 2) return fuzzBoolean(false)
    if (pick == 3) return fuzzInteger(this.r.range(-1000000, 1000000))
    fuzzText(FUZZ_JSON_STRINGS[pick - 4])
}

val FUZZ_JSON_MALFORMED: array<string> = ["[1,", "\"\\q\"", "\"\\uD800\"", "\"\\uDC00\"", "{\"a\":1,\"a\":2}", "depth"]

/** Insertion order, compact UTF-8, integers only; no floats or lone surrogates. */
fun FuzzGen.jsonCheck(index: int): FuzzCheck {
    val value = this.jsonValue(2)
    val text = fuzzSpaced(value, this.r.chance(0.5))
    val expected = fuzzCompact(value)
    val bad = this.r.pick(FUZZ_JSON_MALFORMED)
    val lines: array<string> = ["fun c$index(): string {", "    val parsed = jsonParse(${fuzzLiteral(text)})",
        "    val expected = ${fuzzLiteral(expected)}",
        "    if (!parsed.succeeded || jsonStringify(parsed.value) != expected) return \"FUZZ_ORACLE_FAILURE\"",
        "    val built = ${fuzzConstruct(value, "json")}",
        "    if (jsonStringify(built) != expected) return \"FUZZ_ORACLE_FAILURE\""]
    if (bad == "depth") {
        // The root's depth is 1: 63 nested arrays put the scalar at the default limit, 64.
        val atLimit = "[".repeat(63) + "0" + "]".repeat(63)
        val overLimit = "[".repeat(64) + "0" + "]".repeat(64)
        lines.append("    val atLimit = jsonParse(${fuzzLiteral(atLimit)})")
        lines.append("    if (!atLimit.succeeded || jsonStringify(atLimit.value) != ${fuzzLiteral(atLimit)}) return \"FUZZ_ORACLE_FAILURE\"")
        lines.append("    val invalid = jsonParse(${fuzzLiteral(overLimit)})")
        lines.append("    if (invalid.succeeded || invalid.error.code != \"depth_limit\") return \"FUZZ_ORACLE_FAILURE\"")
    } else {
        lines.append("    val invalid = jsonParse(${fuzzLiteral(bad)})")
        lines.append("    if (invalid.succeeded) return \"FUZZ_ORACLE_FAILURE\"")
        if (bad.startsWith("{")) lines.append("    if (invalid.error.code != \"duplicate_key\") return \"FUZZ_ORACLE_FAILURE\"")
    }
    lines.append("    \"ok:\" + expected")
    lines.append("}")
    FuzzCheck(lines, "c$index()", "str", index)
}

fun fuzzYamlExpected(value: FuzzValue): string = fuzzLiteral(fuzzCompact(value))

fun fuzzYamlFailsUnless(condition: string): string = "    if ($condition) return \"FUZZ_ORACLE_FAILURE\""

/** A YAML subset parsed and emitted by abla/yaml, compared through the JSON form of the generator's own tree. */
fun FuzzGen.yamlCheck(index: int): FuzzCheck {
    val mode = this.r.pick(["tree", "scalar", "alias", "block", "malformed", "limit"])
    val lines: array<string> = ["fun c$index(): string {"]
    if (mode == "tree") {
        val name = fuzzText(this.r.pick(["true", "null", "1e3", "~", "0x10", "", "hé😀", "a\nb"]))
        val item = this.r.below(3)
        val flag = if (item == 0) fuzzBoolean(true) else if (item == 1) fuzzBoolean(false) else fuzzNull()
        val items = fuzzList([fuzzInteger(this.r.range(-100, 100)), flag, fuzzObject(["text"], [fuzzText("quoted")])])
        val value = fuzzObject(["name", "items"], [name, items])
        var source = ""
        if (this.r.chance(0.5)) {
            source = fuzzSpaced(value, false)
        } else {
            for (k in 0 until 2) source = source + fuzzJsonString(value.keys[k], false) + ": " + fuzzSpaced(value.items[k], false) + "\n"
        }
        lines.append("    val expected = ${fuzzYamlExpected(value)}")
        lines.append("    val parsed = yamlParse(${fuzzLiteral(source)})")
        lines.append(fuzzYamlFailsUnless("!parsed.succeeded || jsonStringify(fuzzYamlJson(parsed.value)) != expected"))
        lines.append("    val emitted = yamlEmit(${fuzzConstruct(value, "yaml")})")
        lines.append(fuzzYamlFailsUnless("!emitted.succeeded"))
        lines.append("    val again = yamlParse(emitted.text)")
        lines.append(fuzzYamlFailsUnless("!again.succeeded || jsonStringify(fuzzYamlJson(again.value)) != expected"))
    } else if (mode == "scalar") {
        val texts = ["true", "null", "1e3", "~", "0x10", ""]
        val plains = [fuzzBoolean(true), fuzzNull(), fuzzText("FLOAT:1e3"), fuzzNull(), fuzzInteger(16), fuzzNull()]
        val pick = this.r.below(texts.size)
        val text = texts[pick]
        lines.append("    val quoted = yamlParse(${fuzzLiteral(fuzzJsonString(text, false))})")
        lines.append("    val plain = yamlParse(${fuzzLiteral(text)})")
        lines.append(fuzzYamlFailsUnless("!quoted.succeeded || jsonStringify(fuzzYamlJson(quoted.value)) != " +
            fuzzYamlExpected(fuzzText(text))))
        lines.append(fuzzYamlFailsUnless("!plain.succeeded || jsonStringify(fuzzYamlJson(plain.value)) != " +
            fuzzYamlExpected(plains[pick])))
    } else if (mode == "alias") {
        val source = "a: &v [1, 2]\nb: *v\nc: *v\n"
        val pair = fuzzList([fuzzInteger(1), fuzzInteger(2)])
        val value = fuzzObject(["a", "b", "c"], [pair, pair, pair])
        lines.append("    val parsed = yamlParse(${fuzzLiteral(source)}, YamlLimits(maximumExpandedNodes = 13))")
        lines.append(fuzzYamlFailsUnless("!parsed.succeeded || jsonStringify(fuzzYamlJson(parsed.value)) != " +
            fuzzYamlExpected(value)))
        lines.append("    val limited = yamlParse(${fuzzLiteral(source)}, YamlLimits(maximumExpandedNodes = 12))")
        lines.append(fuzzYamlFailsUnless("limited.succeeded || limited.error.code != \"limit.expansion\""))
    } else if (mode == "block") {
        val pick = this.r.below(3)
        val indicator = ["-", "", "+"][pick]
        val ending = ["", "\n", "\n\n"][pick]
        val source = "key: |$indicator\n  one\n  two\n\n"
        lines.append("    val parsed = yamlParse(${fuzzLiteral(source)})")
        lines.append(fuzzYamlFailsUnless("!parsed.succeeded || jsonStringify(fuzzYamlJson(parsed.value)) != " +
            fuzzYamlExpected(fuzzObject(["key"], [fuzzText("one\ntwo$ending")]))))
    } else if (mode == "malformed") {
        val source = this.r.pick(["a: 1\na: 2\n", "x: \"\\q\"\n", "x: !!str a\n", "x: *missing\n", "---\na\n---\nb\n",
            "a:\n  b: 1\n c: 2\n"])
        lines.append("    val parsed = yamlParse(${fuzzLiteral(source)})")
        lines.append(fuzzYamlFailsUnless("parsed.succeeded"))
    } else {
        val pick = this.r.below(4)
        val source = ["abc", "[a,b]", "[a,b]", "[0]"][pick]
        val limit = ["maximumBytes", "maximumNodes", "maximumCollectionMembers", "maximumDepth"][pick]
        val exact = [3, 3, 2, 2][pick]
        lines.append("    val atLimit = yamlParse(${fuzzLiteral(source)}, YamlLimits($limit = $exact))")
        lines.append("    val over = yamlParse(${fuzzLiteral(source)}, YamlLimits($limit = ${exact - 1}))")
        lines.append(fuzzYamlFailsUnless("!atLimit.succeeded || over.succeeded"))
    }
    lines.append("    \"ok\"")
    lines.append("}")
    FuzzCheck(lines, "c$index()", "str", index)
}

/** Bounded gzip round trips and their exact output limit. */
fun FuzzGen.gzipCheck(index: int): FuzzCheck {
    val size = this.r.pickInt([0, 1, 2, 15, 32, 63, 128, 257])
    val pattern = this.r.pick(["zero", "repeat", "random", "mixed"])
    val data: array<string> = []
    for (i in 0 until size) {
        var byte = 0
        if (pattern == "repeat") {
            byte = i % 5
        } else if (pattern == "random" || (pattern == "mixed" && i % 7 == 0)) {
            byte = this.r.below(256)
        } else if (pattern == "mixed") {
            byte = i % 5
        }
        data.append("$byte")
    }
    val lines: array<string> = ["fun c$index(): string {", "    val buffer = byteBuffer()"]
    if (data.size > 0) lines.append("    for (b in [${textJoin(data, ", ")}]) buffer.appendByteValue(b)")
    for (line in ["    val original = buffer.toText()", "    val compressed = gzipCompress(original)",
        "    val decoded = gzipDecompress(compressed, original.size)",
        "    if (decoded.error != \"\" || decoded.data != original) return \"FUZZ_ORACLE_FAILURE\"",
        "    if (original.size > 0 && gzipDecompress(compressed, original.size - 1).error != \"limit\") return \"FUZZ_ORACLE_FAILURE\"",
        "    var digest = 0",
        "    for (i in 0 until original.size) digest = (digest * 31 + original[i]) % 1000000007",
        "    \"ok:\${original.size}:\$digest\"", "}"]) lines.append(line)
    FuzzCheck(lines, "c$index()", "str", index)
}
