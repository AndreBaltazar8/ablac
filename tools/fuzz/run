#!/usr/bin/env bash
# The differential fuzzer in Abla: builds tools/fuzz/main.ab with the compiler the run uses (--compiler, default
# build/ablac) and runs it with the same arguments. See main.ab's header for the options.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
compiler=$root/build/ablac
record=
previous=
for argument in "$@"; do
    [[ $previous == --compiler ]] && compiler=$argument
    [[ $previous == --record ]] && record=$argument
    previous=$argument
done
[[ $compiler == /* ]] || compiler=$PWD/$compiler
# --record FILE: what the fuzzer cannot see for itself. The revision is the compiler checkout's HEAD (build/ablac
# resolves into it), dirty when tracked files differ; the hash is of the binary the launcher runs (ablac.bin beside it).
record_arguments=()
if [[ -n $record ]]; then
    compiler_dir=$(dirname -- "$compiler")
    revision=$(git -C "$compiler_dir" rev-parse HEAD 2>/dev/null) || revision=unknown
    dirty=0
    if [[ $revision != unknown && -n $(git -C "$compiler_dir" status --porcelain --untracked-files=no 2>/dev/null) ]]; then dirty=1; fi
    binary=$compiler_dir/ablac.bin
    [[ -f $binary ]] || binary=$(realpath -- "$compiler")
    sha=$(sha256sum < "$binary" 2>/dev/null) || sha=
    version=$("$compiler" --version 2>/dev/null) || version=
    version=${version%%$'\n'*}
    command=tools/fuzz/run
    for argument in "$@"; do
        if [[ $argument =~ ^[A-Za-z0-9_./,=:+-]+$ ]]; then command+=" $argument"; else printf -v command '%s %q' "$command" "$argument"; fi
    done
    record_arguments=(--record-revision "$revision" --record-dirty "$dirty" --record-compiler-sha256 "${sha%% *}"
        --record-compiler-version "$version" --record-command "$command" --record-compiler "$(realpath -ms -- "$compiler")")
fi
# Check runnable tools separately from compiler support; once enabled, a build
# or runner failure is a disagreement, including an unexpected exit status.
unset ABLA_FUZZ_WASI_RUNNER ABLA_FUZZ_RISCV64_RUNNER
targets=
if [[ ${ABLA_FUZZ_WASI:-0} == 1 || ${ABLA_FUZZ_RISCV64:-0} == 1 ]]; then
    status=0
    help=$("$compiler" --help 2>&1) || status=$?
    if [[ $status != 0 && $status != 2 ]]; then
        printf '%s\n' "$help" >&2
        exit "$status"
    fi
    targets=$(sed -n 's/^[[:space:]]*targets:[[:space:]]*//p' <<< "$help")
    [[ -n $targets ]] || { echo "fuzz: compiler did not list its targets" >&2; exit 2; }
    targets=${targets//,/ }
fi
enable_target() {
    local target=$1 launcher=$2 output=$3 path
    if [[ " $targets " != *" $target "* ]]; then
        printf 'fuzz: %s skipped (compiler does not support this target)\n' "$target"
    elif ! path=$(command -v -- "$launcher"); then
        printf 'fuzz: %s skipped (%s unavailable)\n' "$target" "$launcher"
    else
        path=$(realpath -- "$path")
        export "$output=$path"
    fi
}
if [[ ${ABLA_FUZZ_WASI:-0} == 1 ]]; then
    enable_target wasm32-wasi "${ABLA_WASMTIME:-wasmtime}" ABLA_FUZZ_WASI_RUNNER
fi
if [[ ${ABLA_FUZZ_RISCV64:-0} == 1 ]]; then
    enable_target riscv64-linux "${ABLA_QEMU_RISCV64:-qemu-riscv64}" ABLA_FUZZ_RISCV64_RUNNER
fi
tools=$root/build/fuzz-abla/tools
mkdir -p "$tools"
"$compiler" build "$root/tools/fuzz/main.ab" -o "$tools/fuzz" --fast > "$tools/fuzz.log" 2>&1 ||
    { cat "$tools/fuzz.log" >&2; echo "fuzz: tools/fuzz/main.ab did not build" >&2; exit 2; }
ABLA_FUZZ_ROOT=$root exec "$tools/fuzz" "$@" "${record_arguments[@]}"
