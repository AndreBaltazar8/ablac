#!/usr/bin/env bash
# The differential fuzzer in Abla: builds tools/fuzz/main.ab with the compiler the run uses (--compiler, default
# build/ablac) and runs it with the same arguments. See main.ab's header for the options.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
compiler=$root/build/ablac
previous=
for argument in "$@"; do
    [[ $previous == --compiler ]] && compiler=$argument
    previous=$argument
done
[[ $compiler == /* ]] || compiler=$PWD/$compiler
tools=$root/build/fuzz-abla/tools
mkdir -p "$tools"
"$compiler" build "$root/tools/fuzz/main.ab" -o "$tools/fuzz" --fast > "$tools/fuzz.log" 2>&1 ||
    { cat "$tools/fuzz.log" >&2; echo "fuzz: tools/fuzz/main.ab did not build" >&2; exit 2; }
ABLA_FUZZ_ROOT=$root exec "$tools/fuzz" "$@"
