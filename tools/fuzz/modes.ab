// Running one program six ways, as the former Python fuzzer's Runner does: native `--fast` and release builds, the
// compile-time evaluator on every check (ABLA_COMPILE_EVAL=interp, and =jit for native compile-time code), and
// hostless WebAssembly, a release module and a development module that node runs through
// tools/fuzz/wasm-run.mjs. The six jobs run at once as child processes; each child runs under coreutils
// `timeout`, so a hang ends with status 124. A mode's result is its standard output (bytes, unchanged: a byte slice
// may cut a UTF-8 sequence) and exit status, or the first lines of its build errors.
import "abla/text"
import "abla/fs"
import "abla/process/time"
import "abla/sys/linux/process"
import "abla/process/environment"
import "./gen.ab"

// `errors`: a failed build's first error lines, or a run's first standard-error line (compared only by the panic
// campaign; a mode's key is its output and status).
class FuzzResult(val mode: string, val built: bool, val output: string, val status: int, val errors: array<string>)

/** How a mode's result compares: equal keys agree. */
fun FuzzResult.key(): string =
    if (this.built) "status ${this.status}\n${this.output}" else "build-failed\n${textJoin(this.errors, "\n")}"

fun FuzzResult.describe(): string {
    val text = if (this.built) "(${fuzzQuote(this.output)}, ${this.status})" else
        "('build-failed', [${textJoin(this.errors, " | ")}])"
    if (text.size > 200) text.slice(0, 200) else text
}

fun fuzzQuote(text: string): string = "'" + text.replace("\\", "\\\\").replace("\n", "\\n").replace("'", "\\'") + "'"

/** One child process of a job: argument vector, extra environment, files for its streams. */
class FuzzStep(
    val arguments: array<string>,
    val environmentNames: array<string>,
    val environmentValues: array<string>,
    val output: string,
    val errors: string,
    val required: bool
)

/** A mode's steps, run one after another; a failed required step skips the rest. */
class FuzzJob(val steps: array<FuzzStep>, var at: int, var process: int, val statuses: array<int>)

// `plant`: the minimiser control (main.ab's --control-minimise) reads the Wasm release module's line `c0=planted` as
// `c0=planted-wasm`, a disagreement that every mode can build and the compile-time evaluator can compute.
class FuzzRunner(val root: string, val compiler: string, val timeout: int, val plant: bool)

fun FuzzRunner.step(arguments: array<string>, names: array<string>, values: array<string>, output: string,
    errors: string, required: bool): FuzzStep {
    val wrapped: array<string> = ["timeout", "-k", "5", "${this.timeout}"]
    for (argument in arguments) wrapped.append(argument)
    FuzzStep(wrapped, names, values, output, errors, required)
}

fun FuzzRunner.startStep(step: FuzzStep): int {
    val command = linuxCommand(step.arguments[0])
    var index = 1
    while (index < step.arguments.size) {
        command.argument(step.arguments[index])
        index = index + 1
    }
    command.removeEnvironment("ABLA_COMPILE_EVAL")
    index = 0
    while (index < step.environmentNames.size) {
        command.environment(step.environmentNames[index], step.environmentValues[index])
        index = index + 1
    }
    command.directory(this.root)
    command.output(step.output)
    command.errors(step.errors)
    command.start().process
}

/** Runs the jobs at once; each job's statuses, one per step it ran. */
fun FuzzRunner.runJobs(var jobs: array<FuzzJob>): void {
    var running = 0
    for (j in 0 until jobs.size) {
        if (jobs[j].steps.size > 0) {
            jobs[j].process = this.startStep(jobs[j].steps[0])
            running = running + 1
        }
    }
    while (running > 0) {
        var progressed = false
        for (j in 0 until jobs.size) {
            if (jobs[j].process > 0) {
                val observed = linuxWaitProcess(jobs[j].process, true)
                if (observed.output != "pending") {
                    progressed = true
                    jobs[j].statuses.append(observed.status)
                    val step = jobs[j].steps[jobs[j].at]
                    jobs[j].at = jobs[j].at + 1
                    jobs[j].process = 0
                    if ((observed.status == 0 || !step.required) && jobs[j].at < jobs[j].steps.size) {
                        jobs[j].process = this.startStep(jobs[j].steps[jobs[j].at])
                    } else {
                        running = running - 1
                    }
                }
            }
        }
        if (!progressed) sleep(20)
    }
    return
}

fun fuzzReadText(file: string): string = if (Path(file).exists()) Path(file).readText() else ""

fun fuzzFirstLines(text: string, count: int): array<string> {
    val lines: array<string> = []
    for (line in text.trim().split("\n")) {
        if (lines.size < count) lines.append(line)
    }
    lines
}

fun fuzzNativeJob(runner: FuzzRunner, source: string, out: string, fast: bool, evaluation: string): FuzzJob =
    fuzzCachedNativeJob(runner, source, out, fast, evaluation, "", false)

/** A native build and run by `compilerPath` with extra environment variables, with no cache: the extra axes below. */
fun fuzzAxisJob(runner: FuzzRunner, compilerPath: string, source: string, out: string, fast: bool, names: array<string>,
    values: array<string>): FuzzJob {
    val arguments: array<string> = [compilerPath, "build", source, "-o", out, "--no-cache"]
    if (fast) arguments.append("--fast")
    val build = runner.step(arguments, names, values, "$out.build.out", "$out.build.err", true)
    val run = runner.step([out], [], [], "$out.stdout", "$out.stderr", true)
    FuzzJob([build, run], 0, 0, [])
}

/** A native build and run; with `cacheDir` the build uses that cache (ABLA_CACHE_DIR) instead of --no-cache, and with
 * `trace` the build writes the compiler's memory trace (discovery cache hits among it) to `<out>.build.err`. */
fun fuzzCachedNativeJob(runner: FuzzRunner, source: string, out: string, fast: bool, evaluation: string, cacheDir: string,
    trace: bool): FuzzJob {
    val arguments: array<string> = [runner.compiler, "build", source, "-o", out]
    if (cacheDir == "") arguments.append("--no-cache")
    if (fast) arguments.append("--fast")
    val names: array<string> = []
    val values: array<string> = []
    if (cacheDir != "") {
        names.append("ABLA_CACHE_DIR")
        values.append(cacheDir)
    }
    if (trace) {
        names.append("ABLA_COMPILER_MEMORY_TRACE")
        values.append("1")
    }
    if (evaluation != "") {
        names.append("ABLA_COMPILE_EVAL")
        values.append(evaluation)
    }
    val build = runner.step(arguments, names, values, "$out.build.out", "$out.build.err", true)
    val run = runner.step([out], [], [], "$out.stdout", "$out.stderr", true)
    FuzzJob([build, run], 0, 0, [])
}

/** The runtime prune with a real hint: a build with a cache of its own (ABLA_PRUNE_RUNTIME=1) leaves the hint, and a second text of the program (a
 * comment appended, so the object cache misses and the compile runs) is built with that cache, pruned by the hint; the program of the second build is
 * the one that runs. Its build log carries the demand trace (abla-prune-runtime N of M, or `fallback`: the hint was found wrong). */
fun fuzzPruneWarmJob(runner: FuzzRunner, source: string, out: string, fast: bool): FuzzJob {
    // The hint is the cache's, keyed by the entry's path: both builds are of one file (a copy of the program in a directory of its own, with the
    // manifest beside it), whose text the step between them changes.
    val directory = "$out.warm"
    Path(directory).createDirectories()
    val entry = "$directory/main.ab"
    Path(entry).writeText(Path(source).readText())
    val manifest = "${source.slice(0, source.lastIndexOf("/"))}/abla.toml"
    if (Path(manifest).exists()) Path("$directory/abla.toml").writeText(Path(manifest).readText())
    val cache = "$out.cache"
    val first: array<string> = [runner.compiler, "build", entry, "-o", "$out.first"]
    val again: array<string> = [runner.compiler, "build", entry, "-o", out]
    if (fast) {
        first.append("--fast")
        again.append("--fast")
    }
    val a = runner.step(first, ["ABLA_PRUNE_RUNTIME", "ABLA_CACHE_DIR"], ["1", cache], "$out.first.out", "$out.first.err", true)
    val edit = runner.step(["/bin/sh", "-c", "printf '\\n// a second text of the same program\\n' >> '$entry'"], [], [], "$out.edit.out", "$out.edit.err", true)
    val b = runner.step(again, ["ABLA_PRUNE_RUNTIME", "ABLA_CACHE_DIR", "ABLA_COMPILER_DEMAND_TRACE"], ["1", cache, "1"], "$out.build.out", "$out.build.err", true)
    val run = runner.step([out], [], [], "$out.stdout", "$out.stderr", true)
    FuzzJob([a, edit, b, run], 0, 0, [])
}

fun fuzzPruneWarmResult(mode: string, job: FuzzJob, out: string): FuzzResult {
    if (job.statuses.size < 4 || job.statuses[0] != 0) {
        return FuzzResult(mode, false, "", 0, fuzzFirstLines(fuzzReadText("$out.first.err"), 6))
    }
    if (job.statuses[1] != 0 || job.statuses[2] != 0) return FuzzResult(mode, false, "", 0, fuzzFirstLines(fuzzReadText("$out.build.err"), 6))
    FuzzResult(mode, true, fuzzReadText("$out.stdout"), job.statuses[3], fuzzFirstLines(fuzzReadText("$out.stderr"), 1))
}

fun fuzzNativeResult(mode: string, job: FuzzJob, out: string): FuzzResult {
    if (job.statuses.size == 0 || job.statuses[0] != 0) {
        return FuzzResult(mode, false, "", 0, fuzzFirstLines(fuzzReadText("$out.build.err"), 6))
    }
    FuzzResult(mode, true, fuzzReadText("$out.stdout"), job.statuses[1], fuzzFirstLines(fuzzReadText("$out.stderr"), 1))
}

fun fuzzRelative(runner: FuzzRunner, path: string): string =
    if (path.startsWith("${runner.root}/")) path.slice(runner.root.size + 1, path.size) else path

/** The root as an absolute path: a build call's paths are read against its build file (decision #91 A), so the drivers
 *  name their sources and outputs absolutely. */
fun fuzzRootAbsolute(runner: FuzzRunner): string {
    if (runner.root.startsWith("/")) return runner.root
    val here = processEnvironment("PWD") ?? ""
    if (here == "") runner.root else "$here/${runner.root}"
}

/** Builds both Wasm modules at compile time from a driver program, then node runs each. */
fun fuzzWasmJob(runner: FuzzRunner, source: string, directory: string): FuzzJob {
    // A build call reads its paths against the build file, inside its project (decision #91 A): absolute ones under the root.
    val base = fuzzRootAbsolute(runner)
    val relativeSource = "$base/${fuzzRelative(runner, source)}"
    val relativeStem = "$base/${fuzzRelative(runner, "$directory/w")}"
    val stem = "$directory/w"
    val driver = "$directory/build-wasm.ab"
    Path(driver).writeText(
        "import \"abla/wasm/build\"\nimport \"abla/build\"\n\n" +
        "val release = #wasmBuildModule(\"w\", \"$relativeSource\", \"$relativeStem.wasm\", false, false)\n" +
        "val development = #buildProgram(\"w-dev\", \"$relativeSource\", \"$relativeStem-dev.wasm\", \"wasm32-module\", \"module\", " +
        "true, false)\n\nfun main: int = if (release && development) 0 else 1\n")
    val build = runner.step([runner.compiler, "build", driver, "-o", "$directory/wasm-driver", "--fast", "--no-cache"],
        [], [], "$stem.build.out", "$stem.build.err", true)
    val harness = "${runner.root}/tools/fuzz/wasm-run.mjs"
    val release = runner.step(["node", harness, "$stem.wasm"], [], [], "$stem.stdout", "$stem.stderr", false)
    val development = runner.step(["node", harness, "$stem-dev.wasm"], [], [], "$stem-dev.stdout", "$stem-dev.stderr",
        false)
    FuzzJob([build, release, development], 0, 0, [])
}

fun fuzzWasmResults(runner: FuzzRunner, job: FuzzJob, directory: string, var results: array<FuzzResult>): void {
    val stem = "$directory/w"
    val built = job.statuses.size > 0 && job.statuses[0] == 0
    val errors = fuzzFirstLines(fuzzReadText("$stem.build.err"), 6)
    val names = ["wasm", "wasm-dev"]
    val files = ["$stem.wasm", "$stem-dev.wasm"]
    val outputs = ["$stem.stdout", "$stem-dev.stdout"]
    val stderrs = ["$stem.stderr", "$stem-dev.stderr"]
    for (index in 0 until 2) {
        if (!built || !Path(files[index]).exists() || job.statuses.size < index + 2) {
            results.append(FuzzResult(names[index], false, "", 0, errors))
        } else {
            var output = fuzzReadText(outputs[index])
            if (runner.plant && index == 0) output = output.replace("c0=planted\n", "c0=planted-wasm\n")
            results.append(FuzzResult(names[index], true, output, job.statuses[index + 1],
                fuzzFirstLines(fuzzReadText(stderrs[index]), 1)))
        }
    }
    return
}

/** Writes program.ab and program-ct.ab under `directory` (relative to the root) and runs every mode. */
fun FuzzRunner.allModes(directory: string, prelude: string, checks: array<FuzzCheck>, includeWasm: bool): array<FuzzResult> {
    Path("${this.root}/$directory").createDirectories()
    // The libc campaign's programs call C at compile time: the root manifest (the nearest abla.toml) must grant it.
    if (fuzzSkipInterpreter) Path("${this.root}/$directory/abla.toml").writeText("compileCapabilities = [\"trusted.native\"]\n")
    val plain = "$directory/program.ab"
    val ct = "$directory/program-ct.ab"
    Path("${this.root}/$plain").writeText(fuzzAssemble(prelude, checks, false))
    Path("${this.root}/$ct").writeText(fuzzAssemble(prelude, checks, true))
    this.modesOf(directory, plain, ct, includeWasm)
}

// The libc campaign (main.ab --libc) calls C functions at compile time, which only the native tier can: no interpreter mode.
var fuzzSkipInterpreter: bool = false

/** Every mode of an existing program; `ct` is "" when there is no compile-time variant (it runs four ways). */
fun FuzzRunner.modesOf(relative: string, plainRelative: string, ctRelative: string, includeWasm: bool): array<FuzzResult> {
    val directory = "${this.root}/$relative"
    val plain = if (plainRelative.startsWith("/")) plainRelative else "${this.root}/$plainRelative"
    val ct = if (ctRelative == "" || ctRelative.startsWith("/")) ctRelative else "${this.root}/$ctRelative"
    val jobs: array<FuzzJob> = [
        fuzzNativeJob(this, plain, "$directory/fast", true, ""),
        fuzzNativeJob(this, plain, "$directory/release", false, "")
    ]
    val interpreter = ct != "" && !fuzzSkipInterpreter
    if (interpreter) jobs.append(fuzzNativeJob(this, ct, "$directory/ct", true, "interp"))
    if (ct != "") jobs.append(fuzzNativeJob(this, ct, "$directory/ctjit", true, "jit"))
    if (includeWasm) jobs.append(fuzzWasmJob(this, plain, directory))
    // Extra axes (environment, so every campaign takes them): ABLA_FUZZ_OTHER_COMPILER=<path> builds the program with another compiler too
    // (the static one against the dynamic: its own C library at compile time, its own link), ABLA_FUZZ_PRUNE=1 with the runtime prune on.
    val axes: array<string> = []
    val other = linuxEnvironment("ABLA_FUZZ_OTHER_COMPILER")
    // (ABLA_FUZZ_OTHER_SYSROOT: the other compiler's own standard library and runtime, when it is not the fuzz root's, e.g. a reference build's pristine sysroot.)
    val otherRoot = linuxEnvironment("ABLA_FUZZ_OTHER_SYSROOT")
    if (other.found && other.value != "") {
        for (fast in [true, false]) {
            val name = if (fast) "other-fast" else "other-release"
            jobs.append(fuzzAxisJob(this, other.value, plain, "$directory/$name", fast, ["ABLA_SYSROOT"], [if (otherRoot.found && otherRoot.value != "") otherRoot.value else this.root]))
            axes.append(name)
        }
    }
    val prune = linuxEnvironment("ABLA_FUZZ_PRUNE")
    if (prune.found && prune.value == "1") {
        for (fast in [true, false]) {
            val name = if (fast) "prune-fast" else "prune-release"
            jobs.append(fuzzAxisJob(this, this.compiler, plain, "$directory/$name", fast, ["ABLA_PRUNE_RUNTIME"], ["1"]))
            axes.append(name)
        }
        for (fast in [true, false]) {
            val name = if (fast) "prune-warm-fast" else "prune-warm-release"
            jobs.append(fuzzPruneWarmJob(this, plain, "$directory/$name", fast))
            axes.append(name)
        }
    }
    this.runJobs(jobs)
    val results: array<FuzzResult> = [
        fuzzNativeResult("fast", jobs[0], "$directory/fast"),
        fuzzNativeResult("release", jobs[1], "$directory/release")
    ]
    var next = 2
    if (interpreter) {
        results.append(fuzzNativeResult("ct", jobs[next], "$directory/ct"))
        next = next + 1
    }
    if (ct != "") {
        results.append(fuzzNativeResult("ct-jit", jobs[next], "$directory/ctjit"))
        next = next + 1
    }
    var axis = if (includeWasm) next + 1 else next
    for (name in axes) {
        results.append(if (name.startsWith("prune-warm")) fuzzPruneWarmResult(name, jobs[axis], "$directory/$name") else fuzzNativeResult(name, jobs[axis], "$directory/$name"))
        axis = axis + 1
    }
    if (includeWasm) fuzzWasmResults(this, jobs[next], directory, results)
    results
}
