// The JSON parser against hostile documents (#1139 area 4): a corpus in the style of the JSONTestSuite (valid documents, the standard
// ways to be invalid, deep nesting, huge and odd numbers, escapes, surrogates, duplicate keys, BOM, bytes that are not UTF-8),
// mutated and parsed. The invariants: no crash or hang (an input that takes over 2 s is a finding); a failure carries a code and an
// offset inside the source; a document that parses stringifies to text that parses to the same text again (stringify(parse(stringify(v)))
// == stringify(v)); and, with the limits wide and duplicate keys allowed, the parser accepts exactly what an independent RFC 8259
// recursive-descent check in this file accepts (inputs with `\ud`/`\uD` surrogate escapes, which the RFC leaves to the implementation,
// and inputs nested deeper than 50, are left out of that comparison).
//
//   tools/fuzz/parsers/run json --seeds 1-200 [--inputs 200]
import "abla/io"
import "abla/text"
import "abla/integer"
import "abla/json"
import "abla/process/arguments"
import "abla/process/time"
import "../prng.ab"
import "./mutate.ab"

val JSON_FUZZ_CORPUS: array<string> = [
    "null", "true", "false", "0", "-0", "1", "-1", "1.5", "-1.5e10", "1E+2", "1e-2", "0.0e0", "123456789012345678901234567890",
    "1e999999", "-1e999999", "0.000000000000000000000000000000000001", "\"\"", "\"a\"", "\"\\u00e9\\n\\t\\\"\\\\\\/\"", "\"\\ud83d\\ude00\"",
    "\"\\ud800\"", "\"\\udc00\"", "\"\u00e9\u20ac\"", "[]", "[1]", "[1,2,3]", "[[],[[]]]", "{}", "{\"a\":1}", "{\"a\":1,\"b\":[true,null]}",
    "{\"a\":1,\"a\":2}", " \t\r\n[ 1 , 2 ]\n", "[1,]", "[,1]", "{\"a\":1,}", "{a:1}", "{'a':1}", "[01]", "[+1]", "[.5]", "[5.]", "[1e]", "[-]",
    "[NaN]", "[Infinity]", "[\"\\x41\"]", "[\"\\u00\"]", "[\"a\nb\"]", "[\"\x01\"]", "\u{feff}[1]", "[1] x", "[1][2]", "", " ", "[", "]", "{",
    "[\"abc", "{\"a\"}", "{\"a\":}", "{1:2}", "[1 2]", "tru", "nul", "[true false]", "\"\\", "[\"\\u12G4\"]",
    "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
    "{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":1}}}}}}}}}}",
    "[\"\xc0\xaf\"]", "[\"\xed\xa0\x80\"]", "[\"\xf4\x90\x80\x80\"]", "[\"\xff\"]"]

/** The index after the whitespace that starts at `at`. */
fun jsonRefSkip(s: string, at: int): int {
    var i = at
    while (i < s.size && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13)) i = i + 1
    i
}

fun jsonRefDigits(s: string, at: int): int {
    var i = at
    while (i < s.size && s[i] >= 48 && s[i] <= 57) i = i + 1
    i
}

/** The index after the value that starts at `at` (whitespace already skipped), or -1 when there is none; -2 when it nests deeper than 50. */
fun jsonRefValue(s: string, at: int, depth: int): int {
    if (at >= s.size) return -1
    if (depth > 50) return -2
    val c = s[at]
    if (c == 110) return if (jsonRefHas(s, at, "null")) at + 4 else -1
    if (c == 116) return if (jsonRefHas(s, at, "true")) at + 4 else -1
    if (c == 102) return if (jsonRefHas(s, at, "false")) at + 5 else -1
    if (c == 34) return jsonRefString(s, at)
    if (c == 91) {
        var i = jsonRefSkip(s, at + 1)
        if (i < s.size && s[i] == 93) return i + 1
        while (true) {
            val end = jsonRefValue(s, i, depth + 1)
            if (end < 0) return end
            i = jsonRefSkip(s, end)
            if (i >= s.size) return -1
            if (s[i] == 93) return i + 1
            if (s[i] != 44) return -1
            i = jsonRefSkip(s, i + 1)
        }
    }
    if (c == 123) {
        var i = jsonRefSkip(s, at + 1)
        if (i < s.size && s[i] == 125) return i + 1
        while (true) {
            if (i >= s.size || s[i] != 34) return -1
            val keyEnd = jsonRefString(s, i)
            if (keyEnd < 0) return keyEnd
            i = jsonRefSkip(s, keyEnd)
            if (i >= s.size || s[i] != 58) return -1
            i = jsonRefSkip(s, i + 1)
            val end = jsonRefValue(s, i, depth + 1)
            if (end < 0) return end
            i = jsonRefSkip(s, end)
            if (i >= s.size) return -1
            if (s[i] == 125) return i + 1
            if (s[i] != 44) return -1
            i = jsonRefSkip(s, i + 1)
        }
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        var i = at
        if (s[i] == 45) i = i + 1
        if (i >= s.size) return -1
        if (s[i] == 48) i = i + 1
        else if (s[i] >= 49 && s[i] <= 57) i = jsonRefDigits(s, i)
        else return -1
        if (i < s.size && s[i] == 46) {
            val after = jsonRefDigits(s, i + 1)
            if (after == i + 1) return -1
            i = after
        }
        if (i < s.size && (s[i] == 101 || s[i] == 69)) {
            i = i + 1
            if (i < s.size && (s[i] == 43 || s[i] == 45)) i = i + 1
            val after = jsonRefDigits(s, i)
            if (after == i) return -1
            i = after
        }
        return i
    }
    -1
}

/** The index after the string whose opening quote is at `at`, or -1. */
fun jsonRefString(s: string, at: int): int {
    var i = at + 1
    while (i < s.size) {
        val c = s[i]
        if (c == 34) return i + 1
        if (c < 32) return -1
        if (c == 92) {
            if (i + 1 >= s.size) return -1
            val e = s[i + 1]
            if (e == 117) {
                if (i + 5 >= s.size) return -1
                for (k in 2 until 6) {
                    val h = s[i + k]
                    if (!((h >= 48 && h <= 57) || (h >= 65 && h <= 70) || (h >= 97 && h <= 102))) return -1
                }
                i = i + 6
            } else if (e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116) i = i + 2
            else return -1
        } else i = i + 1
    }
    -1
}

/** 1 when the RFC 8259 check accepts the whole text, 0 when it rejects, -1 when the text is left out of the comparison. */
fun jsonRefAccepts(s: string): int {
    if (s.indexOf("\\ud") >= 0 || s.indexOf("\\uD") >= 0) return -1
    if (!s.isValidUtf8()) return 0
    val start = jsonRefSkip(s, 0)
    val end = jsonRefValue(s, start, 0)
    if (end == -2) return -1
    if (end < 0) return 0
    if (jsonRefSkip(s, end) != s.size) return 0
    1
}

// The codes jsonDecode answers as JsonLimitExceeded (the library's own list: input, node and depth limits).
fun isLimitCode(code: string): bool = code == "input_limit" || code == "node_limit" || code == "depth_limit"

fun jsonFuzzCheck(source: string, limits: JsonLimits, wide: JsonLimits): string {
    val start = monotonicMilliseconds()
    val parsed = jsonParse(source, limits)
    val elapsed = monotonicMilliseconds() - start
    if (elapsed > 2000) return "parsing took $elapsed ms"
    if (!parsed.succeeded) {
        if (parsed.error.code == "") return "a failure with no code"
        if (parsed.error.byteOffset < 0 || parsed.error.byteOffset > source.size) return "an error offset ${parsed.error.byteOffset} outside the ${source.size} bytes of the source"
    } else {
        val text = jsonStringify(parsed.value)
        val again = jsonParse(text, limits)
        if (!again.succeeded) return "the stringified document does not parse: ${again.error.code} ${again.error.message}\n  text: ${mutateEscape(text)}"
        val second = jsonStringify(again.value)
        if (second != text) return "stringify(parse(stringify(v))) differs\n  first: ${mutateEscape(text)}\n  second: ${mutateEscape(second)}"
    }
    // jsonDecode and jsonDecodeDocument say what jsonParse and jsonDocument say: the success, the code, the offset, and a limit as a limit.
    val decided = jsonDecode(source, limits)
    val decidedKind = when (decided) {
        is JsonParsed -> 0
        is JsonMalformed -> if (parsed.succeeded || isLimitCode(parsed.error.code)) 9 else 1
        is JsonLimitExceeded -> if (!parsed.succeeded && isLimitCode(parsed.error.code)) 2 else 9
    }
    if (decidedKind == 9 || ((decidedKind == 0) != parsed.succeeded)) return "jsonDecode disagrees with jsonParse (succeeded=${parsed.succeeded}, code ${parsed.error.code})"
    val tape = jsonDecodeDocument(source, limits)
    val tapeOk = when (tape) {
        is JsonParsedDocument -> true
        is JsonMalformed -> false
        is JsonLimitExceeded -> false
    }
    if (tapeOk != jsonDocument(source, limits).succeeded) return "jsonDecodeDocument disagrees with jsonDocument"
    val reference = jsonRefAccepts(source)
    if (reference >= 0) {
        val wideResult = jsonParse(source, wide)
        if (wideResult.succeeded && reference == 0) return "the parser accepts what RFC 8259 rejects"
        if (!wideResult.succeeded && reference == 1) return "the parser rejects what RFC 8259 accepts: ${wideResult.error.code} ${wideResult.error.message} at ${wideResult.error.byteOffset}"
    }
    ""
}

fun main: int {
    var low = 1
    var high = 50
    var inputs = 200
    var verbose = false
    val count = processArgumentCount()
    var index = 0
    while (index < count) {
        val argument = processArgument(index)
        val value = if (index + 1 < count) processArgument(index + 1) else ""
        if (argument == "--seeds") {
            val dash = value.indexOf("-")
            low = (if (dash < 0) value else value.slice(0, dash)).parseInt() ?? 1
            high = (if (dash < 0) value else value.slice(dash + 1, value.size)).parseInt() ?? 1
            index = index + 1
        } else if (argument == "--inputs") {
            inputs = value.parseInt() ?? 1
            index = index + 1
        } else if (argument == "--verbose") verbose = true
        index = index + 1
    }
    val tight = JsonLimits(256, 8, 40, 32, 6, true)
    val wide = JsonLimits(1048576, 64, 100000, 1048576, 10000, false)
    var findings = 0
    for (seed in low until high + 1) {
        var r = prngSeeded(seed)
        for (n in 0 until inputs) {
            val source = if (r.below(5) == 0) r.pick(JSON_FUZZ_CORPUS) else mutate(r, r.pick(JSON_FUZZ_CORPUS))
            val limits = if (r.below(3) == 0) tight else jsonDefaultLimits()
            if (verbose) println("input seed=$seed n=$n ${mutateEscape(if (source.size > 200) source.slice(0, 200) else source)}")
            val problem = jsonFuzzCheck(source, limits, wide)
            if (problem != "") {
                println("FINDING seed=$seed n=$n: $problem\n  source: ${mutateEscape(if (source.size > 300) source.slice(0, 300) else source)}")
                findings = findings + 1
            }
        }
    }
    println("json: seeds $low-$high, $inputs inputs each, $findings findings")
    if (findings == 0) 0 else 1
}

/** Whether `word` is in `s` at `at`. */
fun jsonRefHas(s: string, at: int, word: string): bool = at + word.size <= s.size && s.slice(at, at + word.size) == word
