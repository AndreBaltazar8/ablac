#!/usr/bin/env bash
# Runs one parser harness (#1139 area 4): tools/fuzz/parsers/run <name> [--seeds A-B] [--inputs N] [--compiler PATH] [--timeout SECONDS] [--out DIR].
# Builds tools/fuzz/parsers/<name>.ab with the compiler and runs it seed by seed, each seed under a timeout: a crash or a hang
# of a seed is reported with the seed, and the seed is rerun with --verbose so the last input printed is the one that did it.
set -uo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
name=${1:?usage: run <name> [--seeds A-B] [--inputs N] [--compiler PATH] [--timeout SECONDS] [--out DIR]}
shift
compiler=$root/build/ablac seeds=1-50 inputs=200 limit=60 out=$root/build/fuzz-parsers
while (($#)); do
    case $1 in
        --compiler) compiler=$2 ;;
        --seeds) seeds=$2 ;;
        --inputs) inputs=$2 ;;
        --timeout) limit=$2 ;;
        --out) out=$2 ;;
        *) echo "run: unknown option $1" >&2; exit 2 ;;
    esac
    shift 2
done
[[ $compiler == /* ]] || compiler=$PWD/$compiler
cd "$root"
mkdir -p "$out"
"$compiler" build "$root/tools/fuzz/parsers/$name.ab" -o "$out/$name" --fast > "$out/$name.log" 2>&1 ||
    { cat "$out/$name.log" >&2; echo "run: $name did not build" >&2; exit 2; }
first=${seeds%-*} last=${seeds#*-}
failed=0
for ((seed = first; seed <= last; seed++)); do
    status=0
    timeout "$limit" "$out/$name" --seeds "$seed-$seed" --inputs "$inputs" > "$out/$name.out" 2>&1 || status=$?
    if ((status == 124 || status >= 128)); then
        kind=crash; ((status == 124)) && kind=hang
        echo "$name: seed $seed: $kind (status $status); last input:"
        timeout "$limit" "$out/$name" --seeds "$seed-$seed" --inputs "$inputs" --verbose 2>&1 | tail -n 2 | cut -c1-600
        failed=$((failed + 1))
    elif ((status != 0)); then
        grep -A1 '^FINDING' "$out/$name.out"
        failed=$((failed + 1))
    elif ! grep -q "^$name: seeds $seed-$seed, $inputs inputs each" "$out/$name.out"; then
        # A harness that did not take the seed range it was given would run the same inputs for every seed (it once did: argument 0 skipped).
        echo "$name: seed $seed: the harness did not run seed $seed with $inputs inputs: $(tail -n 1 "$out/$name.out" | cut -c1-200)"
        failed=$((failed + 1))
    fi
done
echo "$name: seeds $seeds: $failed seeds with a finding, a crash or a hang"
((failed == 0))
