// The process's CPU time in milliseconds (user and system). The parser harnesses' time limits count it, not the wall
// clock: on a busy machine (the suite runs eight jobs beside them) a decode that takes 0.5 s of CPU once took 3.3 s of
// wall time and was reported as a finding (gzip, seed 4). A real hang still ends in the run script's wall timeout.
import "abla/process/metrics"

fun fuzzCpuMilliseconds(): int {
    val cpu = processCpuMicroseconds()
    (cpu[0] + cpu[1]) / 1000
}
