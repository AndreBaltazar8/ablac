// JWT verification (abla/jwt: RS256 and ES256 only) against forged and damaged tokens and key sets (#1139 area 4). The vectors of
// tests/cases/modules/jwt.ab (an RSA-2048 key and a P-256 key, tokens signed with them) are read from that file, from the repository root. Per input:
//   1 a token damaged in one to three places (a character of a segment, an inserted or deleted character, a swapped segment, an extra dot,
//     whitespace, truncation) is verified: base64url is strict (one encoding per byte string) and the signature covers the text of the
//     first two segments, so the token may verify only when it is exactly one of the signed tokens;
//   2 a forged header (alg none/None/NONE/HS256/HS512/RS384/PS256/ES384/rs256/"RS256 "/empty/not a string, kid of the other key, crit, duplicate
//     alg) with the claims of a valid token and an empty, random or borrowed signature never verifies;
//   3 a mutated key set (JWKS) is imported: no crash, an RSA key it keeps has a modulus without a leading zero byte of at least 256 bytes
//     (RFC 7518 6.3.1.1: minimal-length, so a padded small modulus does not pass the size check) and an EC key a point of 65 bytes.
//
//   tools/fuzz/parsers/run jwt --seeds 1-200 [--inputs 200]
import "abla/io"
import "abla/text"
import "abla/bytes"
import "abla/integer"
import "abla/fs"
import "abla/jwt"
import "abla/process/arguments"
import "abla/process/time"
import "../prng.ab"
import "./mutate.ab"

class JwtFuzzVectors(val keys: string, val valid: array<string>)

/** The string literal of `val name = "..."` in the lines of `text`, with \" turned back into a quote. */
fun jwtFuzzVector(lines: array<string>, name: string): string {
    val prefix = "val $name = \""
    for (line in lines) {
        if (line.startsWith(prefix)) {
            val body = line.slice(prefix.size, line.size - 1)
            return body.replace("\\\"", "\"")
        }
    }
    ""
}

fun jwtFuzzLoad(): JwtFuzzVectors {
    val lines = Path("tests/cases/modules/jwt.ab").readText().split("\n")
    JwtFuzzVectors(jwtFuzzVector(lines, "jwtTestKeys"), [jwtFuzzVector(lines, "jwtTestRsValid"), jwtFuzzVector(lines, "jwtTestEsValid"), jwtFuzzVector(lines, "jwtTestNoKid")])
}

fun jwtFuzzOptions(): JwtOptions = JwtOptions(issuer = "Example", audience = "app", nowSeconds = 1900000000)

fun jwtFuzzIsValid(keys: JwtKeySet, token: string): bool {
    val start = monotonicMilliseconds()
    val result = keys.verify(token, jwtFuzzOptions())
    if (monotonicMilliseconds() - start > 2000) return true
    result.valid
}

fun jwtFuzzSegment(token: string, index: int): string {
    val parts = token.split(".")
    if (index < parts.size) parts[index] else ""
}

fun jwtFuzzDamage(var r: Prng, token: string): string {
    var out = token
    val rounds = 1 + r.below(3)
    for (i in 0 until rounds) {
        if (out.size == 0) return out
        val at = r.below(out.size)
        val kind = r.below(8)
        if (kind == 0) out = out.slice(0, at) + r.pick(["A", "B", "-", "_", "0", "=", "+", "/", " ", ".", "\n"]) + out.slice(at + 1, out.size)
        else if (kind == 1) out = out.slice(0, at) + r.pick(["A", "-", ".", " "]) + out.slice(at, out.size)
        else if (kind == 2) out = out.slice(0, at) + out.slice(at + 1, out.size)
        else if (kind == 3) out = out.slice(0, at)
        else if (kind == 4) out = out + r.pick([".", "=", "==", " ", "\n", ".x"])
        else if (kind == 5) out = jwtFuzzSegment(out, 0) + "." + jwtFuzzSegment(out, 2) + "." + jwtFuzzSegment(out, 1)
        else if (kind == 6) out = out.replace(".", "..")
        else out = mutate(r, out)
    }
    out
}

fun jwtFuzzToken(var r: Prng, vectors: JwtFuzzVectors, keys: JwtKeySet): string {
    val base = r.pick(vectors.valid)
    val damaged = jwtFuzzDamage(r, base)
    if (!jwtFuzzIsValid(keys, damaged)) return ""
    for (original in vectors.valid) if (damaged == original) return ""
    "a damaged token verifies: ${mutateEscape(damaged)}"
}

fun jwtFuzzForged(var r: Prng, vectors: JwtFuzzVectors, keys: JwtKeySet): string {
    val source = r.pick(vectors.valid)
    val claims = jwtFuzzSegment(source, 1)
    val algs: array<string> = ["\"none\"", "\"None\"", "\"NONE\"", "\"HS256\"", "\"HS384\"", "\"HS512\"", "\"RS384\"", "\"RS512\"", "\"PS256\"", "\"ES384\"", "\"ES256K\"", "\"EdDSA\"",
        "\"rs256\"", "\"es256\"", "\"RS256 \"", "\" RS256\"", "\"\"", "null", "256", "[\"RS256\"]", "{}", "true"]
    var header = "{\"alg\":" + r.pick(algs)
    if (r.below(2) == 0) header = header + ",\"kid\":" + r.pick(["\"rsa-1\"", "\"ec-1\"", "\"hmac\"", "\"\"", "null", "\"rsa-2\""])
    if (r.below(4) == 0) header = header + ",\"crit\":[\"exp\"]"
    if (r.below(6) == 0) header = header + ",\"alg\":\"RS256\""
    if (r.below(6) == 0) header = header + ",\"jwk\":{\"kty\":\"oct\",\"k\":\"AAAA\"},\"jku\":\"http://evil.example/keys\""
    header = header + "}"
    val signature = if (r.below(3) == 0) "" else if (r.below(2) == 0) jwtBase64UrlEncode(mutateBytes(r, 64 + r.below(2) * 192)) else jwtFuzzSegment(r.pick(vectors.valid), 2)
    val token = jwtBase64UrlEncode(header) + "." + claims + "." + signature
    if (jwtFuzzIsValid(keys, token)) return "a forged token verifies: header $header"
    ""
}

fun jwtFuzzKeys(var r: Prng, vectors: JwtFuzzVectors): string {
    var text = vectors.keys
    if (r.below(3) != 0) text = mutate(r, text)
    if (r.below(4) == 0) {
        // A padded small modulus: 250 zero bytes and an odd 64-bit number: 258 bytes by the size check, 64 bits by value.
        val padded = jwtBase64UrlEncode("\x00".repeat(250) + "\xc3\x5a\x91\x27\x6b\x11\x85\x4d")
        text = "{\"keys\":[{\"kty\":\"RSA\",\"alg\":\"RS256\",\"kid\":\"weak\",\"n\":\"$padded\",\"e\":\"AQAB\"}]}"
    }
    val set = jwtKeySet(text)
    for (key in set.keys) {
        if (key.kty == "RSA") {
            if (key.modulus.size < 256) return "an RSA key with a modulus of ${key.modulus.size} bytes is usable"
            if (key.modulus[0] == 0) return "an RSA key with a modulus padded with a zero byte (${key.modulus.size} bytes) is usable: $text"
        }
        if (key.kty == "EC" && key.point.size != 65) return "an EC key with a point of ${key.point.size} bytes is usable"
    }
    // The valid tokens still must not verify wrongly: with the mutated set only a token that verified with the real set may verify.
    for (token in vectors.valid) {
        val start = monotonicMilliseconds()
        set.verify(token, jwtFuzzOptions())
        if (monotonicMilliseconds() - start > 2000) return "verification with a mutated key set took over 2 s"
    }
    ""
}

fun main: int {
    var low = 1
    var high = 50
    var inputs = 200
    var verbose = false
    val count = processArgumentCount()
    var index = 0
    while (index < count) {
        val argument = processArgument(index)
        val value = if (index + 1 < count) processArgument(index + 1) else ""
        if (argument == "--seeds") {
            val dash = value.indexOf("-")
            low = (if (dash < 0) value else value.slice(0, dash)).parseInt() ?? 1
            high = (if (dash < 0) value else value.slice(dash + 1, value.size)).parseInt() ?? 1
            index = index + 1
        } else if (argument == "--inputs") {
            inputs = value.parseInt() ?? 1
            index = index + 1
        } else if (argument == "--verbose") verbose = true
        index = index + 1
    }
    val vectors = jwtFuzzLoad()
    val keys = jwtKeySet(vectors.keys)
    if (keys.error != "" || keys.size() != 2) {
        println("FINDING seed=0 n=0: the key set of the test vectors did not load (${keys.error}); run from the repository root")
        return 1
    }
    for (token in vectors.valid) if (!jwtFuzzIsValid(keys, token)) {
        println("FINDING seed=0 n=0: a vector token does not verify")
        return 1
    }
    var findings = 0
    for (seed in low until high + 1) {
        var r = prngSeeded(seed)
        for (n in 0 until inputs) {
            val kind = r.below(10)
            if (verbose) println("input seed=$seed n=$n kind=$kind")
            var problem = ""
            if (kind < 5) problem = jwtFuzzToken(r, vectors, keys)
            else if (kind < 9) problem = jwtFuzzForged(r, vectors, keys)
            else problem = jwtFuzzKeys(r, vectors)
            if (problem != "") {
                println("FINDING seed=$seed n=$n: $problem")
                findings = findings + 1
            }
        }
    }
    println("jwt: seeds $low-$high, $inputs inputs each, $findings findings")
    if (findings == 0) 0 else 1
}
