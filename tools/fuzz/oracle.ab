// The JSON and YAML families' oracle: the generator's own value tree and a serialiser written here, not abla/json,
// so a bug in abla/json cannot sit on both sides of a check and agree with itself. It writes what Python's
// json.dumps wrote for the Python fuzzer (insertion order, integers only, `\"` `\\` `\n` `\r` `\t` `\b` `\f` and
// `\u00XX` escapes, lowercase hex, an astral code point as a surrogate pair when ASCII-only), and the Abla string
// literal the Python wrote around a text. tests/cases/fuzz-oracle/json.jsonl holds values with the strings Python
// computed for them; fuzzOracleSelftest checks this file against every one (abla/json only reads that file).
import "abla/text"
import "abla/fs"
import "abla/json"

// kind: 0 null, 1 boolean (number 0 or 1), 2 integer, 3 string, 4 array (items), 5 object (keys, items)
class FuzzValue(val kind: int, val number: int, val text: string, val keys: array<string>, val items: array<FuzzValue>)

fun fuzzNull(): FuzzValue = FuzzValue(0, 0, "", [], [])
fun fuzzBoolean(value: bool): FuzzValue = FuzzValue(1, if (value) 1 else 0, "", [], [])
fun fuzzInteger(value: int): FuzzValue = FuzzValue(2, value, "", [], [])
fun fuzzText(value: string): FuzzValue = FuzzValue(3, 0, value, [], [])
fun fuzzList(items: array<FuzzValue>): FuzzValue = FuzzValue(4, 0, "", [], items)
fun fuzzObject(keys: array<string>, items: array<FuzzValue>): FuzzValue = FuzzValue(5, 0, "", keys, items)

val FUZZ_HEX = "0123456789abcdef"

fun fuzzHex4(value: int): string {
    var text = ""
    var shift = 12
    while (shift >= 0) {
        val digit = (value >>> shift) & 15
        text = text + FUZZ_HEX.slice(digit, digit + 1)
        shift = shift - 4
    }
    text
}

/** `text` as a JSON string, as Python's json.dumps writes it (ASCII-only escapes DEL and every code point above it, as Python does). */
fun fuzzJsonString(text: string, ascii: bool): string {
    var out = "\""
    var at = 0
    while (at < text.size) {
        val byte = text[at]
        if (byte == 34) {
            out = out + "\\\""
            at = at + 1
        } else if (byte == 92) {
            out = out + "\\\\"
            at = at + 1
        } else if (byte == 10) {
            out = out + "\\n"
            at = at + 1
        } else if (byte == 13) {
            out = out + "\\r"
            at = at + 1
        } else if (byte == 9) {
            out = out + "\\t"
            at = at + 1
        } else if (byte == 8) {
            out = out + "\\b"
            at = at + 1
        } else if (byte == 12) {
            out = out + "\\f"
            at = at + 1
        } else if (byte < 32) {
            out = out + "\\u" + fuzzHex4(byte)
            at = at + 1
        } else if (byte < 127 || !ascii) {
            out = out + text.slice(at, at + 1)
            at = at + 1
        } else if (byte == 127) {
            out = out + "\\u007f"
            at = at + 1
        } else {
            // A UTF-8 sequence (the generator's texts are valid UTF-8): its code point, escaped.
            var point = 0
            var length = 1
            if (byte >= 240) {
                point = byte & 7
                length = 4
            } else if (byte >= 224) {
                point = byte & 15
                length = 3
            } else {
                point = byte & 31
                length = 2
            }
            for (k in 1 until length) point = (point << 6) | (text[at + k] & 63)
            if (point >= 65536) {
                val high = 55296 + ((point - 65536) >>> 10)
                val low = 56320 + ((point - 65536) & 1023)
                out = out + "\\u" + fuzzHex4(high) + "\\u" + fuzzHex4(low)
            } else {
                out = out + "\\u" + fuzzHex4(point)
            }
            at = at + length
        }
    }
    out + "\""
}

/** json.dumps(value, ensure_ascii = ascii, separators = (itemSeparator, keySeparator)). */
fun fuzzJsonText(value: FuzzValue, itemSeparator: string, keySeparator: string, ascii: bool): string {
    if (value.kind == 0) return "null"
    if (value.kind == 1) return if (value.number == 1) "true" else "false"
    if (value.kind == 2) return "${value.number}"
    if (value.kind == 3) return fuzzJsonString(value.text, ascii)
    val parts: array<string> = []
    var index = 0
    while (index < value.items.size) {
        val item = fuzzJsonText(value.items[index], itemSeparator, keySeparator, ascii)
        if (value.kind == 4) {
            parts.append(item)
        } else {
            parts.append(fuzzJsonString(value.keys[index], ascii) + keySeparator + item)
        }
        index = index + 1
    }
    if (value.kind == 4) "[" + textJoin(parts, itemSeparator) + "]" else "{" + textJoin(parts, itemSeparator) + "}"
}

/** The compact text the checks expect: json.dumps(value, ensure_ascii=False, separators=(",", ":")). */
fun fuzzCompact(value: FuzzValue): string = fuzzJsonText(value, ",", ":", false)

/** json.dumps(value, ensure_ascii = ascii, separators = (", ", ": ")): how a source text is written. */
fun fuzzSpaced(value: FuzzValue, ascii: bool): string = fuzzJsonText(value, ", ", ": ", ascii)

/** An Abla string literal of `text`, byte for byte: `\` `"` `$` escaped, control bytes as `\xHH`. */
fun fuzzLiteral(text: string): string {
    var out = "\""
    var at = 0
    while (at < text.size) {
        val byte = text[at]
        if (byte == 92 || byte == 34 || byte == 36) {
            out = out + "\\" + text.slice(at, at + 1)
        } else if (byte < 32) {
            out = out + "\\x" + FUZZ_HEX.slice(byte >>> 4, (byte >>> 4) + 1) + FUZZ_HEX.slice(byte & 15, (byte & 15) + 1)
        } else {
            out = out + text.slice(at, at + 1)
        }
        at = at + 1
    }
    out + "\""
}

/** Source code building `value` with the builders of abla/json (prefix "json") or abla/yaml (prefix "yaml"). */
fun fuzzConstruct(value: FuzzValue, prefix: string): string {
    if (value.kind == 0) return "${prefix}Null()"
    if (value.kind == 1) return "${prefix}Boolean(${if (value.number == 1) "true" else "false"})"
    if (value.kind == 2) return "${prefix}Integer(${value.number})"
    if (value.kind == 3) return "${prefix}String(${fuzzLiteral(value.text)})"
    val items: array<string> = []
    for (item in value.items) items.append(fuzzConstruct(item, prefix))
    if (value.kind == 4) return "${prefix}${if (prefix == "json") "Array" else "Sequence"}([${textJoin(items, ", ")}])"
    val keys: array<string> = []
    for (key in value.keys) keys.append(fuzzLiteral(key))
    "${prefix}Object([${textJoin(keys, ", ")}], [${textJoin(items, ", ")}])"
}

fun fuzzFromJson(json: Json): FuzzValue {
    if (json.isNull()) return fuzzNull()
    if (json.isBoolean()) return fuzzBoolean(json.asBoolean())
    if (json.isNumber()) return fuzzInteger(json.asInt())
    if (json.isString()) return fuzzText(json.asString())
    val items: array<FuzzValue> = []
    for (item in json.values) items.append(fuzzFromJson(item))
    if (json.isArray()) return fuzzList(items)
    val keys: array<string> = []
    for (key in json.keys) keys.append(key)
    fuzzObject(keys, items)
}

/** Every case of the fixture: the emitter and the literal reproduce the strings Python computed. "" when they do. */
fun fuzzOracleSelftest(root: string): string {
    val path = "$root/tests/cases/fuzz-oracle/json.jsonl"
    var count = 0
    for (line in Path(path).readText().split("\n")) {
        if (line != "") {
            val parsed = jsonParse(line)
            if (!parsed.succeeded) return "$path: line ${count + 1} does not parse"
            val case = parsed.value
            val value = fuzzFromJson(case.get("value"))
            val compact = fuzzCompact(value)
            val checks = [compact, fuzzSpaced(value, false), fuzzSpaced(value, true), fuzzLiteral(compact)]
            val names = ["compact", "spaced", "spaced_ascii", "literal"]
            for (k in 0 until 4) {
                val want = case.getString(names[k])
                if (checks[k] != want) return "$path: case ${count + 1} ${names[k]}: wrote ${checks[k]}, Python wrote $want"
            }
            count = count + 1
        }
    }
    if (count < 400) return "$path: only $count cases"
    ""
}
