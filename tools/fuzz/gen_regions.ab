// region_member_check (#827): two unrelated classes of a check share a method name, and only one of them keeps what
// it is given in a module value. A region calls the other one's method in each receiver form the region check must
// resolve by declaration: a local, a field (`holder.inner.poke`), through `this` (`counter.twice`, which calls
// `this.poke`) and through `this.field` (`holder.relay`). Every mode must build it (a refusal in all of them is
// reported like any shared build failure) and print the sum computed here.
import "abla/text"
import "./prng.ab"
import "./gen.ab"

val FUZZ_REGION_WORDS: array<string> = ["", "a", "ab", "abc", "word", "é", "日本"]

fun FuzzGen.regionMemberCheck(index: int): FuzzCheck {
    val keep = "RmKeep$index"
    val count = "RmCount$index"
    val holder = "RmHolder$index"
    var counter = this.r.range(0, 9)
    var inner = this.r.range(0, 9)
    val lines: array<string> = [
        "var rmKept$index: array<string> = []",
        "class $keep(val tag: string) {",
        "    fun poke(name: string): int {",
        "        rmKept$index.append(this.tag + name)",
        "        rmKept$index.size",
        "    }",
        "}",
        "class $count(var total: int) {",
        "    fun poke(name: string): int {",
        "        this.total = this.total + name.size",
        "        this.total",
        "    }",
        "    fun twice(name: string): int = this.poke(name) + this.poke(name)",
        "}",
        "class $holder(val inner: $count) {",
        "    fun relay(name: string): int = this.inner.poke(name)",
        "}",
        "fun c$index(): string {",
        "    val keeper = $keep(\"k\")",
        "    val before = keeper.poke(\"x\")",
        "    val got = region {",
        "        val counter = $count($counter)",
        "        val holder = $holder($count($inner))",
        "        var sum = 0"]
    var sum = 0
    val steps = this.r.range(2, 6)
    for (step in 0 until steps) {
        val word = this.r.pick(FUZZ_REGION_WORDS)
        val size = word.size
        val form = this.r.pick(["counter.poke", "counter.twice", "holder.relay", "holder.inner.poke", "holder.inner.twice"])
        lines.append("        sum += $form(\"$word\")")
        if (form == "counter.poke") {
            counter = counter + size
            sum = sum + counter
        } else if (form == "counter.twice") {
            sum = sum + (counter + size) + (counter + 2 * size)
            counter = counter + 2 * size
        } else if (form == "holder.inner.twice") {
            sum = sum + (inner + size) + (inner + 2 * size)
            inner = inner + 2 * size
        } else {
            inner = inner + size
            sum = sum + inner
        }
    }
    for (line in ["        sum", "    }", "    val actual = \"\$before:\$got\"",
        "    if (actual != \"1:$sum\") return \"FUZZ_ORACLE_FAILURE:\" + actual", "    actual", "}"]) lines.append(line)
    FuzzCheck(lines, "c$index()", "str", index)
}
