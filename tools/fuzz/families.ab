// Which check a draw makes: the Python's mix (Gen.check) over the families ported so far. A family not ported yet is
// left out of its list, so until every batch lands the weights within a list differ from the Python's.
import "./prng.ab"
import "./gen.ab"
import "./gen_types.ab"

// The Python's lists, in its order: the rare draw (10%) and the common draw (30% of the rest). Each name is a family
// of tools/fuzz-differential (its Gen method).
val FUZZ_RARE: array<string> = ["deep_generic_check", "deep_iface_check", "deep_nullable_check", "any_check",
    "clash_check", "generic_lambda_check", "resource_drop_check", "default_owner_check", "ownership_lifetime_check",
    "fresh_select_check", "elvis_member_check", "gzip_check", "nested_generator_check", "json_check", "yaml_check"]
val FUZZ_COMMON: array<string> = ["conv_check", "generic_check", "iface_check", "nullable_check", "string_check",
    "array_check", "map_check", "closure_check", "sealed_check", "range_check", "regex_check", "text_check",
    "array_ops_check", "optional_elements_check", "when_forms_check", "regex_groups_check", "map_stress_check",
    "string_eq_check"]

/** The families ported so far: what --focus accepts. */
val FUZZ_FAMILIES: array<string> = ["plain_check", "any_pool_check",
    "conv_check", "generic_check", "iface_check", "nullable_check", "closure_check", "sealed_check",
    "when_forms_check", "deep_generic_check", "deep_iface_check", "deep_nullable_check", "any_check", "clash_check",
    "generic_lambda_check"]

fun fuzzHasFamily(name: string): bool {
    for (family in FUZZ_FAMILIES) {
        if (family == name) return true
    }
    false
}

fun fuzzPorted(names: array<string>): array<string> {
    val ported: array<string> = []
    for (name in names) {
        if (fuzzHasFamily(name)) ported.append(name)
    }
    ported
}

fun FuzzGen.family(name: string, index: int): FuzzCheck = when (name) {
    "any_pool_check" -> this.anyPoolCheck(index)
    "conv_check" -> this.convCheck(index)
    "generic_check" -> this.genericCheck(index)
    "iface_check" -> this.ifaceCheck(index)
    "nullable_check" -> this.nullableCheck(index)
    "closure_check" -> this.closureCheck(index)
    "sealed_check" -> this.sealedCheck(index)
    "when_forms_check" -> this.whenFormsCheck(index)
    "deep_generic_check" -> this.deepGenericCheck(index)
    "deep_iface_check" -> this.deepIfaceCheck(index)
    "deep_nullable_check" -> this.deepNullableCheck(index)
    "any_check" -> this.anyCheck(index)
    "clash_check" -> this.clashCheck(index)
    "generic_lambda_check" -> this.genericLambdaCheck(index)
    else -> this.plainCheck(index)
}

/** One check: the focused family's, else a draw from the mix. */
fun FuzzGen.check(index: int): FuzzCheck {
    if (this.focus != "") return this.family(this.focus, index)
    if (this.withAny && this.r.chance(0.12)) return this.anyPoolCheck(index)
    if (this.r.chance(0.10)) {
        val rare = fuzzPorted(FUZZ_RARE)
        if (rare.size > 0) return this.family(this.r.pick(rare), index)
    }
    if (this.r.unit() < 0.30) {
        val common = fuzzPorted(FUZZ_COMMON)
        if (common.size > 0) return this.family(this.r.pick(common), index)
    }
    this.plainCheck(index)
}
