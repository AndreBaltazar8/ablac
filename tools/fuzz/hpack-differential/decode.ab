// The Abla side of tools/test-hpack-differential.sh (#1139 area 4 round 8): abla/http/h2/hpack's decoder on the cases oracle/main.go writes, with the
// limits the oracle gives Go's (a 4096-byte table, 16384-byte strings; the list and field-count limits out of reach), printed in the oracle's format.
import "abla/io"
import "abla/bytes"
import "abla/text"
import "abla/http/h2/hpack"
fun hexValue(c: int): int = if (c >= 97) c - 87 else if (c >= 65) c - 55 else c - 48
fun unhex(h: string): string {
    val out = byteBuffer()
    for (i in 0 until h.size / 2) out.appendByteValue(hexValue(h[2 * i]) * 16 + hexValue(h[2 * i + 1]))
    out.toText()
}
fun hexOf(t: string): string {
    val digits = "0123456789abcdef"
    val out = byteBuffer()
    for (b in t) {
        out.appendByteValue(digits[b >> 4])
        out.appendByteValue(digits[b & 15])
    }
    out.toText()
}
fun main: int {
    var running = true
    while (running) {
        val line = readInputLine()
        if (!line.available) running = false
        else if (line.text.size > 0) {
            val decoder = hpackDecoderNew(4096, 1 << 30, 16384, 1000000)
            var verdicts: array<string> = []
            for (part in line.text.split(" ")) {
                if (part.size == 0) continue
                val block = decoder.decode(unhex(part.slice(1, part.size)))
                if (!block.ok) {
                    verdicts.append("E")
                    break
                }
                var fields: array<string> = []
                for (f in block.fields) fields.append(hexOf(f.name) + "=" + hexOf(f.value))
                verdicts.append(fields.join(","))
            }
            println(verdicts.join("|"))
        }
    }
    0
}
