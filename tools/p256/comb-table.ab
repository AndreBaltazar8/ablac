// Prints the table of abla/crypto/p256's fixed-base comb: for idx 1..15, the point sum over the bits j of idx of 2^(64 j) G, as affine x || y in hex (64 bytes
// each), one per line. The scalar multiplication of the generator reads it (p256FixedBase); tests/cases/p256/comb.ab checks every entry against the general
// scalar multiplication. Usage: ablac run tools/p256/comb-table.ab
import "abla/io"
import "abla/crypto"
import "abla/crypto/bignum"
import "abla/crypto/p256"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

trusted fun scalarFor(idx: int, limbs: int): void {
    // The scalar sum over bits j of idx of 2^(64 j): word 2j is 1.
    for (w in 0 until 8) ablaUnsafeStoreU32(bnPointer(limbs + w * 4), 0)
    for (j in 0 until 4) if (((idx >> j) & 1) == 1) ablaUnsafeStoreU32(bnPointer(limbs + (2 * j) * 4), 1)
}

trusted fun main: int {
    val c = p256Open()
    val g = bnAllocate(24)
    val point = bnAllocate(24)
    val scalar = bnAllocate(8)
    val x = bnAllocate(8)
    val y = bnAllocate(8)
    p256Generator(c, g)
    for (idx in 1 until 16) {
        // idx's multiple of G: sum of 2^(64 j) G is scalar * G with that scalar.
        scalarFor(idx, scalar)
        p256ScalarMultiply(c.field.memory, c.work, point, g, scalar)
        p256ToAffine(c, point, x, y)
        println("${hexEncode(p256Bytes(x, 32))}${hexEncode(p256Bytes(y, 32))}")
    }
    0
}
