// A minimal h2c server (prior knowledge, plain TCP) around H2Server for h2spec: one forked child per connection, blocking reads. GET and HEAD answer 200 "hello h2\n" for any
// path, anything else echoes the body. Usage: h2c-server <port or 0>; prints "listening <port>".
import "abla/io"
import "abla/http"
import "abla/http/h2/server"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/sys/linux/net"

fun answer(request: HttpRequest): HttpResponse {
    if (request.method == "GET" || request.method == "HEAD") return HttpResponse(200, [HttpHeader("Content-Type", "text/plain")], "hello h2\n")
    HttpResponse(200, [HttpHeader("Content-Type", "application/octet-stream")], request.body)
}

fun serveConnection(var conn: TcpConnection): int {
    var server = h2ServerNew()
    while (!server.finished()) {
        val out = server.takeOutput()
        if (out.size > 0 && conn.write(out) < 0) return 1
        if (server.isClosed()) return 0
        val data = conn.read(65536)
        if (data.size == 0) return 0
        server.feed(data, linuxMonotonicMilliseconds())
        for (r in server.takeRequests()) {
            val response = answer(r.request)
            server.respond(r.stream, response.status, response.headers, response.body)
        }
    }
    val rest = server.takeOutput()
    if (rest.size > 0) conn.write(rest)
    0
}

fun main: int {
    val port = processArgument(0).parseInt()
    if (port == null) return 2
    var listener = tcpListenAddress(ipv4Loopback(port))
    println("listening ${listener.localPort()}")
    while (true) {
        var conn = listener.accept()
        val child = linuxSyscall0(57)
        if (child == 0) linuxSyscall1(60, serveConnection(conn))
        conn.close()
    }
    0
}
