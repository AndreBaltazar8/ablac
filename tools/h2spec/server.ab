// The test server for tools/test-http2-server.sh: an HttpsEventServer (abla/http/event/tls) answering h2spec, nghttp, our H2Client and h2load.
//   server <port or 0> [certificate.pem private-key.pem] [h2only]
// "h2only" makes the port HTTP/2 only (h2spec over h2c wants that: garbage is not an HTTP/1.1 request there). With a certificate it serves HTTPS (ALPN h2 and http/1.1), without it plain TCP (HTTP/1.1 and h2c with prior knowledge). Prints "listening <port>" and serves until it is
// stopped. Routes: /big.bin 3 MiB of a repeating pattern; /echo returns the body; /headers returns the request line and headers as text; /slow.txt answers after 300 ms (the
// handler runs on the event loop, so it stalls every connection for that long: only for one client at a time); anything else "hello h2\n".
import "abla/io"
import "abla/http"
import "abla/http/event/tls"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/sys/linux/net"
import "abla/tls/pure/server"
import "abla/integer"
import "abla/sys/linux/process"
import "abla/text"

fun pattern(size: int): string {
    val unit = "0123456789abcdef".repeat(64)
    var out = ""
    var n = 0
    while (n + unit.size <= size) {
        out = out + unit
        n = n + unit.size
    }
    out + unit.slice(0, size - n)
}

fun answer(request: HttpRequest): HttpResponse {
    if (request.path == "/big.bin") return HttpResponse(200, [HttpHeader("Content-Type", "application/octet-stream")], pattern(3145728))
    if (request.path == "/echo") return HttpResponse(200, [HttpHeader("Content-Type", "application/octet-stream")], request.body)
    if (request.path == "/headers") {
        var text = "${request.method} ${request.path}?${request.query}\n"
        for (h in request.headers) text = text + "${h.name}: ${h.value}\n"
        return HttpResponse(200, [HttpHeader("Content-Type", "text/plain")], text)
    }
    if (request.path == "/slow.txt") {
        linuxSleepMillisecondsChecked(300)
        return HttpResponse(200, [HttpHeader("Content-Type", "text/plain")], "slow\n")
    }
    HttpResponse(200, [HttpHeader("Content-Type", "text/plain")], "hello h2\n")
}

fun main: int {
    val port = processArgument(0).parseInt()
    if (port == null) return 2
    var tls: TlsServerConfig? = null
    if (processArgumentCount() >= 3) {
        tls = httpsEventServerTls(processArgument(1), processArgument(2))
        if (tls == null) {
            println("certificate or key failed to load")
            return 1
        }
    }
    val h2only = processArgument(processArgumentCount() - 1) == "h2only"
    var server = httpsEventServerHandler(answer, ipv4Loopback(port), tls, HttpsEventServerOptions(http1 = !h2only))
    println("listening ${server.port()}")
    server.run()
}
