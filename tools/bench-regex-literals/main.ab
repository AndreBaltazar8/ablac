import "abla/io"
import "abla/process/exit"
import "abla/process/arguments"
import "abla/integer"
import "abla/regex"

fun main {
    val mode = processArgument(0)
    val pattern = processArgument(1)
    val iterations = processArgument(2).parseInt() ?? 50000
    val literal = $regex("([a-z]+)-(\\d+)")
    val compiled = regexCompile(pattern)
    if (!compiled.succeeded) panic("bad benchmark pattern")
    var count = 0
    for (i in 0 until iterations) {
        val text = if (i % 2 == 0) "item-123" else "no match"
        if (mode == "compile") {
            if (regexCompile(pattern).regex.matches(text)) count += 1
        } else if (mode == "cached") {
            if (compiled.regex.matches(text)) count += 1
        } else if (mode == "literal") {
            if (literal.matches(text)) count += 1
        } else panic("unknown benchmark mode")
    }
    println("$count")
}
