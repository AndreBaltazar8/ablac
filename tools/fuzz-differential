fun maybeOwner(seat: int, id: int, give: bool): TempTicketOwner? = if (give) TempTicketOwner(Ticket(seat), id) else null
fun maybeTickets(seat: int, give: bool): array<Ticket>? = if (give) [Ticket(seat), Ticket(seat + 1)] else null
