                      f'TempTicketOwner(issue({n + 1}), {n + 201}).ticket.seat -> dropLog.append(901) else -> dropLog.append(902) }}')
            events = [n + 200, n, n + 201, n + 1, 901]
        elif kind == 'match':
            definitions = [f'fun ownedBody{index}(): void {{', f'    val held = issue({n})',
                           f'    when (held) {{ issue({n + 1}) -> dropLog.append(900) else -> dropLog.append(901) }}', '}']
            action, events = f'ownedBody{index}()', [n + 1, 901, n]
        elif kind == 'extension':
            action, events = f'issue({n}).fuzzLook()', [1000 + n, n]
        elif kind == 'operator':
            action, events = f'val result = issue({n}) + issue({n + 1})', [800, n + 1, n]
        elif kind == 'receiver':
            fresh = r.choice([True, False])
            flag = str(fresh).lower()
            receiver = r.choice([f'if ({flag}) issue({n}) else held',
                                 f'when ({flag}) {{ true -> issue({n}) else -> held }}',
                                 f'if (true) (if ({flag}) issue({n}) else held) else held',
                                 f'if ({flag}) {{ val result = issue({n}); result }} else held'])
            extension = r.choice([True, False])
            method = 'fuzzLook' if extension else 'twice'
            definitions = [f'fun ownedBody{index}(): void {{', f'    val held = issue({n + 1})',
                           f'    ({receiver}).{method}()',
                           '    return', '}']
            action = f'ownedBody{index}()'
            events = ([1000 + (n if fresh else n + 1)] if extension else [])
            if fresh: events.append(n)
            events.append(n + 1)
        else:
            mode = r.choice(['fresh', 'borrowed', 'temporary'])
            machine = r.choice([True, False])
            stop = r.choice([True, False])
            outer_stop = machine and r.choice([True, False])
            keys = kind == 'map' and r.choice([True, False])
            body = []
            if kind == 'array':
                if mode == 'borrowed':
                    body += [f'    val owner = [issue({n}), issue({n + 1})]']
                    source = 'owner'
                elif mode == 'temporary':
                    source = f'FuzzTicketOwner([issue({n}), issue({n + 1})], {n + 200}).items'
                else:
                    if r.choice([True, False]):
                        body += [f'    val owner = [issue({n}), issue({n + 1})]']
                        source = 'move(owner)'
                    else:
                        source = f'[issue({n}), issue({n + 1})]'
            else:
                # A map's values are borrowed; a temporary map is retained by the loop.
                if mode == 'fresh':
                    source = f'fuzzTicketMap({n}).{"keys" if keys else "values"}()'
                else:
                    body += [f'    val owner = fuzzTicketMap({n})']
                    source = ('move(owner)' if mode == 'temporary' else 'owner') + ('.keys()' if keys else '.values()')
                mode = 'temporary' if mode != 'borrowed' else mode
            body += [f'    for (item in {source}) {{',
                     f'        dropLog.append(if (item == "a") {1000 + n} else {1001 + n})' if keys
                     else '        item.fuzzLook()']
            if machine:
                body += ['        yield 1' if keys else '        yield item.seat']
            if stop:
                body += ['        break']
            body += ['    }']
            header = f'fun ownedBody{index}(): Generator<int> = generator {{' if machine else f'fun ownedBody{index}(): void {{'
            definitions = [header] + body + ['}']
            action = (f'for (item in ownedBody{index}()) {{ {"break" if outer_stop else ""} }}'
                      if machine else f'ownedBody{index}()')
            stopped = stop or outer_stop
            visited = [n] if stopped else [n, n + 1]
            events = []
            for value in visited:
                events.append(1000 + value)
                if mode == 'fresh': events.append(value)
            if kind == 'array' and mode == 'temporary': events.append(n + 200)
            if mode != 'fresh': events += [n, n + 1]
            elif stopped: events.append(n + 1)
        expected = ''.join(f'{event},' for event in events)
        lines = definitions + [f'fun c{index}(): string {{', '    dropLog.clear()',
                               f'    {action}', '    var actual = ""',
                               '    for (event in dropLog) actual += "${event},"',
                               f'    if (actual != "{expected}") return "FUZZ_ORACLE_FAILURE"',
                               '    actual', '}']
        return lines, f'c{index}()', 'str'

