        if bad == 'depth':
            at_limit = '[' * 63 + '0' + ']' * 63
            over_limit = '[' * 64 + '0' + ']' * 64
            depth_expected = json.dumps(json.loads(at_limit), ensure_ascii=False, separators=(',', ':'))
            lines += [f'    val atLimit = jsonParse({literal(at_limit)})',
                      f'    if (!atLimit.succeeded || jsonStringify(atLimit.value) != {literal(depth_expected)}) return "FUZZ_ORACLE_FAILURE"',
                      f'    val invalid = jsonParse({literal(over_limit)})',
                      '    if (invalid.succeeded || invalid.error.code != "depth_limit") return "FUZZ_ORACLE_FAILURE"']
        else:
            lines += [f'    val invalid = jsonParse({literal(bad)})',
                      '    if (invalid.succeeded) return "FUZZ_ORACLE_FAILURE"']
            if bad.startswith('{'):
                lines.append('    if (invalid.error.code != "duplicate_key") return "FUZZ_ORACLE_FAILURE"')
        lines += ['    "ok:" + expected', '}']
        return lines, f'c{index}()', 'str'

