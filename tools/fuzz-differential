    def json_check(self, index):
        """Python oracle: insertion order, compact UTF-8, integers only; no floats or lone surrogates."""
        r = self.r

        def value(depth):
            if depth and r.random() < 0.55:
                if r.choice([True, False]):
                    return [value(depth - 1) for _ in range(r.randrange(4))]
                keys = r.sample(["alpha", "z", "é", "q\"", "line"], r.randrange(4))
                return {key: value(depth - 1) for key in keys}
            return r.choice([None, True, False, r.randint(-1000000, 1000000),
                             "", "hé😀", 'quote"slash\\', "line\n\t\x01", "$name"])

        def literal(text):
            # Abla string literal, preserving bytes and escaping interpolation.
            out = '"'
            for c in text:
                if c in '\\"$': out += '\\' + c
                elif ord(c) < 32: out += f'\\x{ord(c):02x}'
                else: out += c
            return out + '"'

        def construct(v):
            if v is None: return 'jsonNull()'
            if isinstance(v, bool): return 'jsonBoolean(' + str(v).lower() + ')'
            if isinstance(v, int): return f'jsonInteger({v})'
            if isinstance(v, str): return 'jsonString(' + literal(v) + ')'
            if isinstance(v, list): return 'jsonArray([' + ', '.join(construct(x) for x in v) + '])'
            return ('jsonObject([' + ', '.join(literal(k) for k in v) + '], [' +
                    ', '.join(construct(x) for x in v.values()) + '])')

        v = value(2)
        text = json.dumps(v, ensure_ascii=r.choice([True, False]), separators=(', ', ': '))
        expected = json.dumps(json.loads(text), ensure_ascii=False, separators=(',', ':'))
        # Root depth is 1: 63 nested arrays put the scalar at the default limit 64.
        malformed = ['[1,', '"\\q"', '"\\uD800"', '"\\uDC00"', '{"a":1,"a":2}']
        bad = r.choice(malformed + ['depth'])
        lines = [f'fun c{index}(): string {{', f'    val parsed = jsonParse({literal(text)})',
                 f'    val expected = {literal(expected)}',
                 '    if (!parsed.succeeded || jsonStringify(parsed.value) != expected) return "FUZZ_ORACLE_FAILURE"',
                 f'    val built = {construct(v)}',
