        if shape == 'field':
            owner = f"    val owner = GenHolder(ticketGen({seat}, {limit}))"
            place = 'owner.gen'
        elif shape == 'index':
            owner = f"    val owner: array<Generator<int>> = [ticketGen({seat}, {limit})]"
            place = 'owner[0]'
        elif shape == 'tempfield':
            owner = ''
            place = f'TempGenOwner(ticketGen({seat}, {limit}), {seat + 200}).gen'
        elif shape == 'tempindex':
