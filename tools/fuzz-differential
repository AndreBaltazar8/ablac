#!/usr/bin/env python3
"""Differential fuzzer: random well-typed Abla programs, run four ways.

Each generated program is a list of independent checks (a function and a call
that prints its result). The same checks run as

  fast     native, `build --fast`
  release  native, default optimization
  ct       every check evaluated by the compile-time evaluator (`#`), native
           --fast for the rest (ABLA_COMPILE_EVAL=interp); ct-jit the same as
           native code (ABLA_COMPILE_EVAL=jit)
  wasm     hostless WebAssembly, release module and development module (node)

and output plus exit status must agree. A disagreement is minimised to one check
with the fewest statements that still disagrees and kept under
tests/cases/fuzz-differential-<seed>-<check>/ (program.ab and expected outputs).

  tools/fuzz-differential --seeds 1-3 [--checks 24] [--compiler build/ablac]
  tools/fuzz-differential --seed 7 --keep     # one seed, keep its directory
  tools/fuzz-differential --program x.ab      # run one existing program, all ways
Exit status 0 when every mode agreed.
"""
import argparse
import concurrent.futures
import os
import random
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WORK = os.path.join("build", "fuzz-differential")

INTS = ["i8", "i16", "i32", "int", "u8", "u16", "u32", "u64"]
SIGNED = {"i8", "i16", "i32", "int"}
EDGES = [0, 1, 2, 3, 7, 8, 15, 16, 31, 32, 63, 64, 100, 127, 128, 255, 256, 32767,
         32768, 65535, 65536, 2147483647, 2147483648, 4294967295, 4294967296,
         9223372036854775807]
FLOAT_EDGES = ["0.0", "1.0", "0.5", "2.5", "-1.5", "3.0e10", "1.0e-5", "123456.789",
               "1.0e300", "4.9e-324", "0.1", "-0.0"]
STRINGS = ["", "a", "ab", "hello", "x y", "0123456789", "é", "line", "日本語", "h\u00e9llo, \u65e5\u672c \U0001F600", "\U0001F600\U0001F600", "a\u0301"]


class Gen:
    def __init__(self, seed, with_any=True):
        self.r = random.Random(seed)
        self.with_any = with_any
        self.depth_limit = 4

    # ---- literals
    def int_lit(self, ty):
        r = self.r
        pick = r.random()
        if pick < 0.5:
            v = r.choice(EDGES)
        elif pick < 0.8:
            v = r.randint(0, 300)
        else:
            v = r.getrandbits(r.choice([8, 16, 32, 63]))
        if r.random() < 0.35:
            v = -v
        return self.int_const(v, ty)

    def int_const(self, v, ty):
        text = "(-9223372036854775807 - 1)" if v == -9223372036854775808 else (
            f"({v})" if v < 0 else str(v))
        if v < -9223372036854775807:
            text = "(-9223372036854775807 - 1)"
        return text if ty == "int" else f"{ty}({text})"

    def float_lit(self):
        v = self.r.choice(FLOAT_EDGES)
        return f"({v})" if v.startswith("-") else v

    # ---- expressions
    def expr(self, ty, depth, env):
        """An expression of type `ty`; `env` is a list of (name, type)."""
        if ty in INTS:
            return self.int_expr(ty, depth, env)
        if ty == "f64":
            return self.f64_expr(depth, env)
        if ty == "f32":
            return self.f32_expr(depth, env)
        if ty == "bool":
            return self.bool_expr(depth, env)
        if ty == "str":
            return self.str_expr(depth, env)
        raise ValueError(ty)

    def var_of(self, ty, env):
        names = [n for n, t in env if t == ty]
        return self.r.choice(names) if names else None

    def int_expr(self, ty, depth, env):
        r = self.r
        if depth <= 0:
            v = self.var_of(ty, env)
            return v if v and r.random() < 0.6 else self.int_lit(ty)
        c = r.random()
        if c < 0.30:
            op = r.choice(["+", "-", "*", "&", "|", "^"])
            return f"({self.int_expr(ty, depth - 1, env)} {op} {self.int_expr(ty, depth - 1, env)})"
        if c < 0.40:
            op = r.choice(["/", "%"])
            d = self.int_expr(ty, depth - 1, env)
            one = self.int_const(1, ty)
            return f"({self.int_expr(ty, depth - 1, env)} {op} ({d} | {one}))"
        if c < 0.50:
            op = r.choice(["<<", ">>", ">>>"])
            count = self.int_expr(r.choice(INTS), depth - 1, env)
            return f"({self.int_expr(ty, depth - 1, env)} {op} {count})"
        if c < 0.56:
            return f"(~{self.int_expr(ty, depth - 1, env)})" if r.random() < 0.5 else (
                f"(-{self.int_expr(ty, depth - 1, env)})" if ty in SIGNED else
                f"(~{self.int_expr(ty, depth - 1, env)})")
        if c < 0.68:
            src = r.choice(INTS)
            return f"{ty}({self.int_expr(src, depth - 1, env)})"
        if c < 0.74:
            return (f"(if ({self.bool_expr(depth - 1, env)}) {self.int_expr(ty, depth - 1, env)} "
                    f"else {self.int_expr(ty, depth - 1, env)})")
        if c < 0.78:
            sel = self.int_expr("int", depth - 1, env)
            arms = []
            for k in sorted(r.sample(range(-3, 6), 3)):
                arms.append(f"{k} -> {self.int_expr(ty, depth - 1, env)}")
            return f"(when ({sel}) {{ {'; '.join(arms)}; else -> {self.int_expr(ty, depth - 1, env)} }})"
        if c < 0.82:
            return f"{ty}(f64ToInt({self.f64_expr(depth - 1, env)}))"
        if c < 0.85:
            return f"{ty}({self.str_expr(depth - 1, env)}.size)"
        if c < 0.88:
            return f"{ty}(f32ToI32({self.f32_expr(depth - 1, env)}))"
        v = self.var_of(ty, env)
        return v if v else self.int_lit(ty)

    def f64_expr(self, depth, env):
        r = self.r
        if depth <= 0:
            v = self.var_of("f64", env)
            return v if v and r.random() < 0.6 else self.float_lit()
        c = r.random()
        if c < 0.45:
            op = r.choice(["+", "-", "*", "/"])
            return f"({self.f64_expr(depth - 1, env)} {op} {self.f64_expr(depth - 1, env)})"
        if c < 0.55:
            return f"(-{self.f64_expr(depth - 1, env)})"
        if c < 0.70:
            return f"f64FromInt({self.int_expr('int', depth - 1, env)})"
        if c < 0.78:
            return f"f32ToF64({self.f32_expr(depth - 1, env)})"
        if c < 0.86:
            return (f"(if ({self.bool_expr(depth - 1, env)}) {self.f64_expr(depth - 1, env)} "
                    f"else {self.f64_expr(depth - 1, env)})")
        v = self.var_of("f64", env)
        return v if v else self.float_lit()

    def f32_expr(self, depth, env):
        r = self.r
        if depth <= 0:
            v = self.var_of("f32", env)
            return v if v and r.random() < 0.6 else f"f64ToF32({self.float_lit()})"
        c = r.random()
        if c < 0.5:
            op = r.choice(["+", "-", "*", "/"])
            return f"({self.f32_expr(depth - 1, env)} {op} {self.f32_expr(depth - 1, env)})"
        if c < 0.7:
            return f"f64ToF32({self.f64_expr(depth - 1, env)})"
        if c < 0.85:
            return f"f32FromInt({self.int_expr('int', depth - 1, env)})"
        v = self.var_of("f32", env)
        return v if v else f"f64ToF32({self.float_lit()})"

    def bool_expr(self, depth, env):
        r = self.r
        if depth <= 0:
            v = self.var_of("bool", env)
            return v if v and r.random() < 0.5 else r.choice(["true", "false"])
        c = r.random()
        if c < 0.35:
            ty = r.choice(INTS)
            op = r.choice(["<", "<=", ">", ">=", "==", "!="])
            return f"({self.int_expr(ty, depth - 1, env)} {op} {self.int_expr(ty, depth - 1, env)})"
        if c < 0.45:
            op = r.choice(["<", "<=", ">", ">=", "==", "!="])
            return f"({self.f64_expr(depth - 1, env)} {op} {self.f64_expr(depth - 1, env)})"
        if c < 0.50:
            op = r.choice(["<", "<=", ">", ">=", "==", "!="])
            return f"({self.f32_expr(depth - 1, env)} {op} {self.f32_expr(depth - 1, env)})"
        if c < 0.60:
            op = r.choice(["&&", "||"])
            return f"({self.bool_expr(depth - 1, env)} {op} {self.bool_expr(depth - 1, env)})"
        if c < 0.65:
            return f"(!{self.bool_expr(depth - 1, env)})"
        if c < 0.75:
            op = r.choice(["==", "!=", "<", ">="])
            return f"({self.str_expr(depth - 1, env)} {op} {self.str_expr(depth - 1, env)})"
        if c < 0.90 and self.with_any:
            return f"anyEq({self.any_arg(depth - 1, env)}, {self.any_arg(depth - 1, env)})"
        v = self.var_of("bool", env)
        return v if v else r.choice(["true", "false"])

    def any_arg(self, depth, env):
        """A value to box; NaNs stay in (equality through `any` is typed `==` for
        floats of one kind, and a float is never equal to an integer)."""
        ty = self.r.choice(["int", "u8", "i32", "u32", "f64", "f32", "bool", "str", "int"])
        return self.expr(ty, depth, env)

    def str_expr(self, depth, env):
        r = self.r
        if depth <= 0:
            v = self.var_of("str", env)
            return v if v and r.random() < 0.6 else '"' + r.choice(STRINGS) + '"'
        c = r.random()
        if c < 0.30:
            return f"({self.str_expr(depth - 1, env)} + {self.str_expr(depth - 1, env)})"
        if c < 0.55:
            ty = r.choice(["int", "u8", "i32", "u32", "u64", "i16", "bool"])
            return f"\"<${{{self.expr(ty, depth - 1, env)}}}>\""
        if c < 0.65:
            return f"fmtF({self.f64_expr(depth - 1, env)})"
        if c < 0.75:
            s = self.str_expr(depth - 1, env)
            return f"safeSlice({s}, {self.int_expr('int', depth - 1, env)}, {self.int_expr('int', depth - 1, env)})"
        if c < 0.85:
            return (f"(if ({self.bool_expr(depth - 1, env)}) {self.str_expr(depth - 1, env)} "
                    f"else {self.str_expr(depth - 1, env)})")
        v = self.var_of("str", env)
        return v if v else '"' + r.choice(STRINGS) + '"'

    # ---- statements (each is a self-contained line or a short block)
    def statements(self, env, depth, count, indent="    "):
        """Lines that extend `env` in place; every line is deletable on its own
        unless it names a variable a later line reads (the minimiser retries)."""
        r = self.r
        out = []
        for _ in range(count):
            k = r.random()
            n = f"v{len(env)}"
            if k < 0.30:
                ty = r.choice(INTS + ["f64", "f32", "bool", "str"])
                out.append(f"{indent}val {n}: {self.type_name(ty)} = {self.expr(ty, depth, env)}")
                env.append((n, ty))
            elif k < 0.40:
                ty = r.choice(INTS)
                out.append(f"{indent}var {n}: {ty} = {self.expr(ty, depth, env)}")
                inner = [e for e in env] + [(f"i{len(env)}", "int")]
                loop = r.choice(["for", "while"])
                it = f"i{len(env)}"
                op = r.choice(["+", "-", "*", "^", "|", "&"])
                body = self.int_expr(ty, max(depth - 1, 1), inner + [(n, ty)])
                bound = r.randint(1, 6)
                if loop == "for":
                    out.append(f"{indent}for ({it} in 0 until {bound}) {{")
                    out.append(f"{indent}    {n} = {n} {op} {body}")
                else:
                    out.append(f"{indent}var {it} = 0")
                    out.append(f"{indent}while ({it} < {bound}) {{")
                    out.append(f"{indent}    {n} = {n} {op} {body}")
                    out.append(f"{indent}    {it} += 1")
                out.append(f"{indent}}}")
                env.append((n, ty))
            elif k < 0.50:
                a = f"xs{len(env)}"
                size = r.randint(1, 5)
                elems = ", ".join(self.int_expr("int", max(depth - 1, 0), env) for _ in range(size))
                out.append(f"{indent}val {a} = [{elems}]")
                if r.random() < 0.5:
                    out.append(f"{indent}{a}.append({self.int_expr('int', max(depth - 1, 0), env)})")
                idx = self.int_expr("int", max(depth - 1, 0), env)
                out.append(f"{indent}val {n}: int = {a}[(({idx}) & 2147483647) % {a}.size] + {a}.size")
                env.append((n, "int"))
            elif k < 0.60:
                m = f"m{len(env)}"
                out.append(f"{indent}val {m}: Map<int, int> = Map()")
                for _ in range(r.randint(1, 4)):
                    key = self.int_expr("int", 1, env)
                    out.append(f"{indent}{m}.set({key} & 7, {self.int_expr('int', max(depth - 1, 0), env)})")
                probe = self.int_expr("int", 1, env)
                out.append(f"{indent}val {n}: int = (if ({m}.has({probe} & 7)) 1 else 0) + {m}.size")
                env.append((n, "int"))
            elif k < 0.70:
                acc = f"acc{len(env)}"
                out.append(f"{indent}val {acc} = Acc({self.int_expr('int', 1, env)}, {self.int_expr('int', 1, env)})")
                out.append(f"{indent}{acc}.add({self.int_expr('int', max(depth - 1, 0), env)})")
                out.append(f"{indent}val {n}: int = {acc}.add({self.int_expr('int', max(depth - 1, 0), env)}) + {acc}.total")
                env.append((n, "int"))
            elif k < 0.80:
                cap = self.int_expr("int", 1, env)
                g = f"g{len(env)}"
                out.append(f"{indent}val {g} = {{ x: int -> (x {r.choice(['+', '^', '*'])} {cap}) }}")
                out.append(f"{indent}val {n}: int = {g}({self.int_expr('int', 1, env)}) + applyTwice({g}, {self.int_expr('int', 1, env)})")
                env.append((n, "int"))
            elif k < 0.90:
                cond = self.bool_expr(max(depth - 1, 1), env)
                ty = r.choice(INTS)
                out.append(f"{indent}var {n}: {ty} = {self.expr(ty, 1, env)}")
                out.append(f"{indent}if ({cond}) {{")
                out.append(f"{indent}    {n} = {self.expr(ty, max(depth - 1, 1), env)}")
                out.append(f"{indent}}} else {{")
                out.append(f"{indent}    {n} = {self.expr(ty, max(depth - 1, 1), env)}")
                out.append(f"{indent}}}")
                env.append((n, ty))
            elif self.with_any:
                out.append(f"{indent}val {n}: any = {self.any_arg(depth, env)}")
                out.append(f"{indent}val {n}b: bool = anyEq({n}, {self.any_arg(depth, env)})")
                env.append((f"{n}b", "bool"))
        return out


    # ---- more kinds of check; each returns (function lines, call, result type)
    def conv_check(self, index):
        """Conversions between integer widths, and between integers and floats."""
        r = self.r
        lines = [f"fun c{index}(): string {{", '    var out = ""']
        for _ in range(r.randint(8, 16)):
            src, dst = r.choice(INTS), r.choice(INTS)
            v = self.int_lit(src)
            lines.append(f'    out = out + "${{{dst}({v})}} "')
        for _ in range(r.randint(1, 4)):
            f = r.choice(["f64ToInt", "f32ToI32", "f32ToU32"])
            if f == "f64ToInt":
                lines.append(f'    out = out + "${{{f}({self.float_lit()} * {self.float_lit()})}} "')
            else:
                lines.append(f'    out = out + "${{{f}(f64ToF32({self.float_lit()} * {self.float_lit()}))}} "')
        lines.append("    out")
        lines.append("}")
        return lines, f"c{index}()", "str"

    def generic_check(self, index):
        r = self.r
        env = []
        lines = [f"fun c{index}(): string {{", '    var out = ""']
        for _ in range(r.randint(2, 5)):
            ty = r.choice(["int", "f64", "str", "u8", "i32"])
            a, b = self.expr(ty, 2, env), self.expr(ty, 2, env)
            wrap = lambda e: (f'out = out + fmtF({e}) + ";"' if ty == "f64"
                              else f'out = out + "${{{e}}};"')
            kind = r.choice(["pick", "box", "first", "swap", "map"])
            if kind == "pick":
                lines.append("    " + wrap(f"pick({a}, {b}, {self.bool_expr(1, env)})"))
            elif kind == "box":
                lines.append(f"    val bx{index}{len(lines)} = Box({a})")
                lines.append("    " + wrap(f"bx{index}{len(lines) - 1}.put({b})"))
            elif kind == "first":
                lines.append("    " + wrap(f"firstOf([{a}, {b}])"))
            elif kind == "swap":
                lines.append("    " + wrap(f"swapped(Pair({a}, {b})).first"))
            else:
                k = self.int_lit("int")
                lines.append(f'    val mp{len(lines)} = mapAll([{self.int_lit("int")}, {self.int_lit("int")}]) {{ n -> "${{n * {k}}}" }}')
                lines.append(f'    out = out + mp{len(lines) - 1}[0] + mp{len(lines) - 1}[1] + ";"')
        lines.append("    out")
        lines.append("}")
        return lines, f"c{index}()", "str"

    def iface_check(self, index):
        r = self.r
        env = []
        lines = [f"fun c{index}(): string {{"]
        parts = []
        for _ in range(r.randint(2, 5)):
            k = r.choice(["Square", "Rect", "Circle"])
            if k == "Rect":
                parts.append(f"Rect({self.int_expr('int', 2, env)}, {self.int_expr('int', 2, env)})")
            else:
                parts.append(f"{k}({self.int_expr('int', 2, env)})")
        lines.append(f"    val shapes: array<Shape> = [{', '.join(parts)}]")
        lines.append("    var total = 0")
        lines.append('    var names = ""')
        lines.append("    var squares = 0")
        lines.append("    for (s in shapes) {")
        lines.append("        total += s.area()")
        lines.append('        names = names + s.name() + ","')
        lines.append("        squares += when (s) { is Square -> 1; else -> 0 }")
        lines.append("    }")
        lines.append('    "$total $names $squares"')
        lines.append("}")
        return lines, f"c{index}()", "str"

    def nullable_check(self, index):
        r = self.r
        env = []

        def node(d):
            if d == 0 or r.random() < 0.25:
                return "null"
            label = "null" if r.random() < 0.4 else '"' + r.choice(STRINGS) + '"'
            return f"Node({self.int_expr('int', 1, env)}, {node(d - 1)}, {label})"

        lines = [f"fun c{index}(): string {{", f"    val n: Node? = {node(4)}", '    var out = ""']
        for _ in range(r.randint(3, 6)):
            chain = "n" + "".join(r.choice(["?.next"] * 3 + [""]) for _ in range(r.randint(1, 3)))
            tail = r.choice(["?.value ?? " + self.int_lit("int"), "?.label?.size ?? " + self.int_lit("int"),
                             '?.label ?? "d"', "?.value ?? -1"])
            kind = r.choice(["chain", "depth", "when", "opt"])
            if kind == "chain":
                lines.append(f'    out = out + "${{{chain}{tail}}};"')
            elif kind == "depth":
                lines.append(f'    out = out + "${{depth({chain})}};"')
            elif kind == "when":
                lines.append(f'    out = out + when ({chain}?.label) {{ null -> "none;"; else -> "some${{{chain}?.label?.size ?? 0}};" }}')
            else:
                x = f"x{len(lines)}"
                lines.append(f"    val {x}: int? = {r.choice(['null', self.int_expr('int', 2, env)])}")
                lines.append(f'    out = out + "${{{x} ?? {self.int_lit("int")}}}${{{x} == null}}${{if ({x} != null) {x} + 1 else 0}};"')
        lines.append("    out")
        lines.append("}")
        return lines, f"c{index}()", "str"

    def string_check(self, index):
        r = self.r
        env = []
        lines = [f"fun c{index}(): string {{", '    var out = ""']
        for _ in range(r.randint(3, 7)):
            sv = f"s{len(lines)}"
            lines.append(f"    val {sv} = {self.str_expr(2, env)}")
            kind = r.choice(["size", "slice", "byte", "cmp", "iter", "cat"])
            if kind == "size":
                lines.append(f'    out = out + "${{{sv}.size}},"')
            elif kind == "slice":
                lines.append(f'    out = out + safeSlice({sv}, {self.int_expr("int", 1, env)}, {self.int_expr("int", 1, env)}) + ","')
            elif kind == "byte":
                lines.append(f'    out = out + (if ({sv}.size > 0) "${{{sv}[(({self.int_expr("int", 1, env)}) & 2147483647) % {sv}.size]}}" else "e") + ","')
            elif kind == "cmp":
                op = r.choice(["<", "<=", ">", ">=", "==", "!="])
                lines.append(f'    out = out + "${{{sv} {op} {self.str_expr(1, env)}}},"')
            elif kind == "iter":
                lines.append(f"    var sum{sv} = 0")
                lines.append(f"    for (b in {sv}) sum{sv} = sum{sv} * 31 + b")
                lines.append(f'    out = out + "${{sum{sv}}},"')
            else:
                lines.append(f'    out = out + {sv} + {self.str_expr(1, env)} + ","')
        lines.append("    out")
        lines.append("}")
        return lines, f"c{index}()", "str"

    PANIC_KINDS = [
        ("array index", "val xs = [1, 2, 3]\n    val i = 3 + zero\n    println(\"before\")\n    println(\"${xs[i]}\")"),
        ("string index", "val s = \"héllo\"\n    println(\"before\")\n    println(\"${s[10 + zero]}\")"),
        ("string slice", "val s = \"héllo\"\n    println(\"before\")\n    println(s.slice(2, 99 + zero))"),
        ("division", "println(\"before\")\n    println(\"${7 / zero}\")"),
        ("remainder", "println(\"before\")\n    println(\"${7 % zero}\")"),
        ("i8 division", "println(\"before\")\n    println(\"${i8(7) / i8(zero)}\")"),
        ("filledArray", "println(\"before\")\n    val xs = filledArray(zero - 2, 0)\n    println(\"${xs.size}\")"),
        ("truncate", "val xs = [1, 2]\n    println(\"before\")\n    xs.truncate(zero - 1)"),
        ("panic", "println(\"before\")\n    panic(\"boom ${zero}\")"),
    ]

    @staticmethod
    def type_name(ty):
        return {"str": "string"}.get(ty, ty)

    # ---- program
    PRELUDE = """import "abla/io"
import "abla/float"
import "abla/float/text"

class Box<T>(var value: T) {
    fun get(): T = this.value
    fun put(v: T): T {
        this.value = v
        this.value
    }
}
class Pair<A, B>(val first: A, val second: B)
