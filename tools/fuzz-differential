        source = f"if ({choice}) {place} else ticketGen({seat + 100}, {limit})" if mixed else place
        lines = [f"fun nested{index}(): Generator<int> = generator {{", owner,
                 "    yield 0", f"    for (value in {source}) {{", "        yield value",
