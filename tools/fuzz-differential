            elif subject_kind == 'return':
                definitions = [f'fun ownedBody{index}(): int {{', f'    defer {{ dropLog.append({n + 300}) }}',
                               f'    when (face({n}, {otext})) {{ is FaceTicket -> {{ dropLog.append(900); return 1 }} '
                               'else -> dropLog.append(901) }', '    dropLog.append(902)', '    0', '}']
                action = f'val result = ownedBody{index}()'
                events = [900, n, n + 300] if not other else [901, n, 902, n + 300]
            elif subject_kind == 'break':
                definitions = [f'fun ownedBody{index}(): void {{', '    for (i in 0 until 2) {',
                               f'        when (face({n} + i, {otext})) {{ is FaceTicket -> {{ dropLog.append(900); break }} '
                               'else -> dropLog.append(901) }', '    }', '    dropLog.append(902)', '}']
                action = f'ownedBody{index}()'
                events = [900, n, 902] if not other else [901, n, 901, n + 1, 902]
            elif subject_kind == 'yield':
                stop = r.choice([True, False])
                definitions = [f'fun ownedBody{index}(): Generator<int> = generator {{',
                               f'    when (face({n}, {otext})) {{ is FaceTicket -> {{ dropLog.append(900); yield 1; '
                               'dropLog.append(903) } else -> { dropLog.append(901); yield 2; dropLog.append(903) } }',
                               '    dropLog.append(902)', '}']
                action = f'for (v in ownedBody{index}()) {{ {"break" if stop else ""} }}'
                events = [arm, n] if stop else [arm, 903, n, 902]
            else:
                stop = r.choice([True, False])
                definitions = [f'fun ownedBody{index}(): Generator<int> = generator {{', '    for (i in 0 until 2) {',
                               f'        when (face({n} + i, {otext})) {{ is FaceTicket -> {{ defer {{ dropLog.append({n + 300}) }}; '
                               'dropLog.append(900); yield i } else -> { dropLog.append(901); yield i } }', '    }', '}']
                action = f'for (v in ownedBody{index}()) {{ {"break" if stop else ""} }}'
                events = []
                for i in ([0] if stop else [0, 1]):
                    events += [arm] + ([] if other else [n + 300]) + [n + i]
        expected = ''.join(f'{event},' for event in events)
        lines = definitions + [f'fun c{index}(): string {{', '    dropLog.clear()',
                               f'    {action}', '    var actual = ""',
                               '    for (event in dropLog) actual += "${event},"',
                               f'    if (actual != "{expected}") return "FUZZ_ORACLE_FAILURE:" + actual',
                               '    actual', '}']
        return lines, f'c{index}()', 'str'

    def resource_drop_check(self, index):
        """Resource classes: `drop()` logs to a global, so reassignment, `move`, block ends and loops
        show the order and the number of drops; a fresh resource used as a receiver, a field read, in
        an `if` branch, behind `?.`, across `return` and across `break` is a temporary dropped at the
        end of its statement."""
        r = self.r
        env = []
        globals = []
        lines = [f"fun h{index}(): int {{", "    var total = 0", f"    var cur = issue({r.randint(1, 9)})"]
        live = True
        for n in range(r.randint(3, 9)):
            seat = r.randint(10, 99)
            kinds = ["local", "assign", "refund", "revive", "block", "loop", "call",
                     "field", "method", "branch", "maybe", "early", "breaker", "labeled",
                     "elvisloop", "doblock", "paircall", "shortcircuit",
                     "gendrain", "genearly", "genheld", "genlocal",
                     "genfield", "genglobal", "genborrowearly", "tempgenfield", "tempgenindex",
                     "tempgencase", "tempborrow"]
            kind = r.choice(kinds)
            if kind == "local":
                lines.append(f"    val t{n} = issue({seat})")
                lines.append(f"    total += t{n}.seat")
            elif kind == "assign" and live:
                lines.append(f"    cur = issue({seat})")
            elif kind == "refund" and live:
                lines.append("    total += refund(move(cur))")
                live = False
            elif kind == "revive" and not live:
                lines.append(f"    cur = issue({seat})")
                live = True
            elif kind == "block":
                lines.append(f"    if (({self.int_expr('int', 1, env)}) % 2 == 0) {{")
                lines.append(f"        val inner{n} = issue({seat})")
                lines.append(f"        total += inner{n}.seat")
                lines.append("    }")
            elif kind == "loop":
                lines.append(f"    for (i{n} in 0 until {r.randint(1, 4)}) {{")
                lines.append(f"        val l{n} = issue({seat} + i{n})")
                lines.append(f"        total += l{n}.seat")
                lines.append("    }")
            elif kind == "call":
                lines.append(f"    total += show(issue({seat}))")
            elif kind == "paircall":
                lines.append(f"    total += showPair(issue({seat}), issue({seat + 1}))")
            elif kind == "shortcircuit":
                lines.append(f"    if (({self.int_expr('int', 1, env)}) % 2 == 0 && show(issue({seat})) > 0) total += 1")
            elif kind == "field":
                lines.append(f"    total += issue({seat}).seat")
            elif kind == "method":
                lines.append(f"    total += issue({seat}).twice()")
            elif kind == "branch":
                lines.append(f"    total += if (({self.int_expr('int', 1, env)}) % 2 == 0) show(issue({seat})) else issue({seat + 1}).seat")
            elif kind == "maybe":
                lines.append(f"    total += maybeIssue({seat}, ({self.int_expr('int', 1, env)}) % 2 == 0)?.seat ?? 0")
            elif kind == "early":
                lines.append(f"    total += early(({self.int_expr('int', 1, env)}) % 2 == 0, {seat}, {seat + 1})")
            elif kind == "labeled":
                lines.append(f"    L{n}@ for (i{n} in 0 until {r.randint(2, 4)}) {{")
                lines.append(f"        for (j{n} in 0 until {r.randint(2, 4)}) {{")
                lines.append(f"            if (j{n} == {r.randint(0, 2)}) continue@L{n}")
                lines.append(f"            total += show(issue({seat} + i{n} + j{n}))")
                lines.append(f"            if (i{n} == {r.randint(0, 3)}) break@L{n}")
                lines.append("        }")
                lines.append(f"        total += issue({seat + 50}).seat")
                lines.append("    }")
            elif kind == "elvisloop":
                lines.append(f"    for (i{n} in 0 until {r.randint(2, 5)}) {{")
                lines.append(f"        total += maybeIssue({seat} + i{n}, i{n} % 2 == {r.randint(0, 1)})?.seat ?? continue")
                lines.append(f"        total += issue({seat + 50} + i{n}).seat")
                lines.append("    }")
            elif kind == "doblock":
                lines.append(f"    D{n}@ do {{")
                lines.append(f"        total += show(issue({seat}))")
                lines.append(f"        if (({self.int_expr('int', 1, env)}) % 2 == 0) break@D{n}")
                lines.append(f"        total += issue({seat + 50}).seat")
                lines.append("    } while (false)")
            elif kind == "gendrain":
                lines.append(f"    total += drainGen(countedGen({r.randint(0, 5)}))")
            elif kind == "genearly":
                lines.append(f"    total += drainGenEarly(countedGen({r.randint(1, 6)}), {r.randint(0, 4)})")
            elif kind == "genheld":
                lines.append(f"    total += drainGenEarly(ticketGen({seat}, {r.randint(1, 5)}), {seat + r.randint(0, 4)})")
            elif kind == "genlocal":
                lines.append(f"    val g{n} = ticketGen({seat}, {r.randint(1, 4)})")
                lines.append(f"    total += drainGen(g{n})")
            elif kind == "genfield":
                lines.append(f"    val owner{n} = GenHolder(ticketGen({seat}, {r.randint(1, 5)}))")
                lines.append(f"    for (v{n} in owner{n}.gen) {{")
                lines.append(f"        total += v{n}")
                if r.choice([True, False]):
                    lines.append(f"        if (v{n} >= {seat + r.randint(0, 4)}) break")
                lines.append("    }")
            elif kind == "genglobal":
                name = f"globalGen{index}x{n}"
                globals.append(f"val {name} = ticketGen({seat}, {r.randint(1, 5)})")
                lines.append(f"    for (v{n} in {name}) {{")
                lines.append(f"        total += v{n}")
                if r.choice([True, False]):
                    lines.append(f"        if (v{n} >= {seat + r.randint(0, 4)}) break")
                lines.append("    }")
            elif kind == "genborrowearly":
                lines.append(f"    val g{n} = ticketGen({seat}, {r.randint(1, 5)})")
                lines.append(f"    total += drainGenEarly(g{n}, {seat + r.randint(0, 4)})")
            elif kind in ("tempgenfield", "tempgenindex", "tempgencase"):
                limit = r.randint(1, 5)
                if kind == "tempgenfield":
                    source = f'TempGenOwner(ticketGen({seat}, {limit}), {seat + 200}).gen'
                elif kind == "tempgenindex":
                    source = f'[TempGenOwner(ticketGen({seat}, {limit}), {seat + 200})][0].gen'
                else:
                    lines.append(f'    val owner{n} = TempGenOwner(ticketGen({seat}, {limit}), {seat + 200})')
                    flag = r.choice(['true', 'false'])
                    source = f'(if ({flag}) TempGenOwner(ticketGen({seat + 10}, {limit}), {seat + 210}) else owner{n}).gen'
                lines.append(f'    for (v{n} in {source}) {{')
                lines.append(f'        total += v{n}')
                if r.choice([True, False]):
                    lines.append(f'        if (v{n} >= {seat + r.randint(0, 4)}) break')
                lines.append('    }')
            elif kind == "tempborrow":
                lines.append(f'    total += show(TempTicketOwner(issue({seat}), {seat + 200}).ticket)')
            elif kind == "breaker":
                lines.append(f"    for (i{n} in 0 until {r.randint(2, 5)}) {{")
                lines.append(f"        if (i{n} == {r.randint(0, 3)}) break")
                lines.append(f"        total += show(issue({seat} + i{n}))")
                lines.append("    }")
        lines.append("    total")
        lines.append("}")
        lines.append("")
        lines.append(f"fun c{index}(): string {{")
        lines.append("    dropLog.clear()")
        lines.append(f"    val total = h{index}()")
        lines.append('    var out = "${total}:"')
        lines.append('    for (seat in dropLog) out = out + "${seat},"')
        lines.append("    out")
        lines.append("}")
        return globals + lines, f"c{index}()", "str"

    PRELUDE_DEEP = """interface Holder<T> {
