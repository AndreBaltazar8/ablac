    def deep_nullable_check(self, index):
        """`?.` and `??` chains across nullable class fields, nullable generic instances, when on nullables."""
        r = self.r
        env = []

        def chain(d):
            if d == 0 or r.random() < 0.25:
                return "null"
            cell = "null" if r.random() < 0.35 else f"Cell({self.int_expr('int', 1, env)})"
            tag = "null" if r.random() < 0.4 else '"' + r.choice(STRINGS) + '"'
            return f"Chain({chain(d - 1)}, {cell}, {tag})"

        lines = [f"fun c{index}(): string {{", f"    val c: Chain? = {chain(4)}", '    var out = ""']
        for k in range(r.randint(3, 6)):
            path = "c" + "".join(r.choice(["?.next"] * 3 + [""]) for _ in range(r.randint(1, 3)))
            kind = r.choice(["cell", "tag", "size", "when", "cellnull", "guard", "elvis"])
            if kind == "cell":
                lines.append(f'    out = out + "${{{path}?.cell?.inner ?? {self.int_lit("int")}}};"')
            elif kind == "tag":
                lines.append(f'    out = out + "${{{path}?.tag ?? "d"}};"')
            elif kind == "size":
                lines.append(f'    out = out + "${{{path}?.tag?.size ?? -1}};"')
            elif kind == "when":
                lines.append(f'    out = out + when ({path}?.cell) {{ null -> "none;"; else -> "cell${{{path}?.cell?.inner ?? 0}};" }}')
            elif kind == "cellnull":
                lines.append(f'    out = out + "${{{path}?.cell == null}}${{{path}?.tag != null}};"')
            elif kind == "guard":
                x = f"g{k}"
                lines.append(f"    val {x}: Cell<int>? = {path}?.cell")
                lines.append(f'    out = out + (if ({x} != null) "${{{x}.held() + 1}};" else "no;")')
            else:
                lines.append(f'    out = out + "${{heldOr({path}?.cell, {self.int_lit("int")})}};"')
        lines.append("    out")
        lines.append("}")
        return lines, f"c{index}()", "str"

