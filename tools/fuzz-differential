    def check(self, index):
        """One check: a function and its call; returns (function lines, call text, result type)."""
        r = self.r
        if self.focus:
            return getattr(self, self.focus)(index)
        if self.with_any and r.random() < 0.12:
            return self.any_pool_check(index)
        if r.random() < 0.10:
            return r.choice([self.deep_generic_check, self.deep_iface_check, self.deep_nullable_check,
                             self.any_check, self.clash_check,
                             self.generic_lambda_check, self.resource_drop_check, self.default_owner_check,
                             self.ownership_lifetime_check,
                             self.fresh_select_check,
                             self.elvis_member_check, self.gzip_check, self.nested_generator_check,
                             self.json_check, self.yaml_check])(index)
        extra = r.random()
        if extra < 0.30:
            return r.choice([self.conv_check, self.generic_check, self.iface_check,
                             self.nullable_check, self.string_check, self.array_check,
                             self.map_check, self.closure_check, self.sealed_check,
                             self.range_check, self.regex_check,
                             self.text_check, self.array_ops_check, self.optional_elements_check,
                             self.when_forms_check, self.regex_groups_check,
                             self.map_stress_check, self.string_eq_check])(index)
        nparams = r.randint(0, 3)
        env = []
        params = []
        for p in range(nparams):
            ty = r.choice(INTS + ["f64", "bool", "str"])
            params.append((f"p{p}", ty))
            env.append((f"p{p}", ty))
        result = r.choice(INTS + ["f64", "f32", "bool", "str"])
        lines = [f"fun c{index}({', '.join(f'{n}: {self.type_name(t)}' for n, t in params)}): {self.type_name(result)} {{"]
        lines += self.statements(env, self.depth_limit - 1, r.randint(1, 5))
        lines.append(f"    {self.expr(result, self.depth_limit, env)}")
        lines.append("}")
        args = ", ".join(self.arg(t) for _, t in params)
        return lines, f"c{index}({args})", result

    def arg(self, ty):
        if ty in INTS:
            return self.int_lit(ty)
        if ty == "f64":
            return self.float_lit()
        if ty == "bool":
            return self.r.choice(["true", "false"])
        return '"' + self.r.choice(STRINGS) + '"'


def panic_program(kind_index):
    """A program that prints `before` and then panics one way: output and exit status
    must agree between the native and WebAssembly builds (the evaluator reports a
    compile error for the same code, so it is not compared)."""
    name, body = Gen.PANIC_KINDS[kind_index % len(Gen.PANIC_KINDS)]
    return name, f"""import "abla/io"
import "abla/process/exit"

fun makeZero(): int {{
    var z = 0
    for (i in 0 until 3) z = z * 0
    z
}}

@export("run")
fun run(): int {{
    val zero = makeZero()
    {body}
    println("after")
    0
}}

fun main: int = run()
"""


# Conversions of NaN, infinities and huge floats to integers (conv_check) are defined: they
# saturate, NaN gives 0 (docs/language.md, floating point). WebAssembly needs the
# saturating truncation instructions for that, which the toolchain enables.


def render_result(call, ty):
    if ty == "f64":
        return f"fmtF({call})"
    if ty == "f32":
        return f"fmtF(f32ToF64({call}))"
    return call


def assemble(prelude, checks, ct):
    """Source text for a list of (function lines, call, type, id) checks."""
    out = [prelude]
    for lines, _, _, _ in checks:
        out += lines + [""]
    out.append('@export("run")')
    out.append("fun run(): int {")
    for _, call, ty, ident in checks:
        shown = render_result(call, ty)
        value = f"#({shown})" if ct else shown
        out.append(f'    println("c{ident}=${{{value}}}")')
    out.append("    0")
    out.append("}")
    out.append("")
    out.append("fun main: int = run()")
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------- running

class Runner:
    def __init__(self, compiler, timeout):
        self.compiler = compiler if os.path.isabs(compiler) or os.sep not in compiler else (
            os.path.join(ROOT, compiler))
        self.timeout = timeout

    def sh(self, args, env=None, cwd=ROOT):
        e = dict(os.environ)
        e.pop("ABLA_COMPILE_EVAL", None)
        if env:
            e.update(env)
        try:
            p = subprocess.run(args, cwd=cwd, env=e, capture_output=True, timeout=self.timeout)
            # Bytes, kept exact: a string slice may cut a UTF-8 sequence.
            return p.returncode, p.stdout.decode("latin-1"), p.stderr.decode("latin-1")
        except subprocess.TimeoutExpired:
            return 124, "", "timeout"

    def native(self, source, out, fast, ct, stderr=False, cache_dir=None, trace=False):
        env = {"ABLA_COMPILE_EVAL": ct} if ct else {}
        if cache_dir is not None:
            env['ABLA_CACHE_DIR'] = os.path.abspath(cache_dir)
        if trace:
            env['ABLA_COMPILER_MEMORY_TRACE'] = '1'
        args = [self.compiler, "build", source, "-o", out]
        if cache_dir is None:
            args.append("--no-cache")
        if fast:
            args.append("--fast")
        rc, _, err = self.sh(args, env)
        if rc != 0:
            return ("build-failed", err.strip().splitlines()[:6])
        build_trace = err
        rc, stdout, err = self.sh([out])
        if trace:
            return (stdout, rc, build_trace)
        return (stdout, rc, err.strip().splitlines()[:1]) if stderr else (stdout, rc)

    def wasm(self, source, directory, stderr=False):
        stem = os.path.join(directory, "w")
        driver = os.path.join(directory, "build-wasm.ab")
        with open(driver, "w", encoding="utf-8") as f:
            f.write(f'''import "abla/wasm/build"
import "abla/build"

val release = #wasmBuildModule("w", "{source}", "{stem}.wasm", false, false)
val development = #buildProgram("w-dev", "{source}", "{stem}-dev.wasm", "wasm32-module", "module", true, false)

fun main: int = if (release && development) 0 else 1
''')
        rc, _, err = self.sh([self.compiler, "build", driver, "-o", os.path.join(directory, "wasm-driver"),
                              "--fast", "--no-cache"])
        results = {}
        for name, path in (("wasm", f"{stem}.wasm"), ("wasm-dev", f"{stem}-dev.wasm")):
            if rc != 0 or not os.path.exists(os.path.join(ROOT, path)):
                results[name] = ("build-failed", err.strip().splitlines()[:6])
                continue
            code, stdout, err = self.sh(["node", os.path.join(ROOT, "tools", "fuzz-differential.mjs"), path])
            results[name] = (stdout, code, err.strip().splitlines()[:1]) if stderr else (stdout, code)
        return results

    def all_modes(self, directory, prelude_checks, include_wasm=True):
        """prelude_checks: (prelude, checks); returns {mode: (stdout, rc) | failure}."""
        prelude, checks = prelude_checks
        os.makedirs(os.path.join(ROOT, directory), exist_ok=True)
        plain = os.path.join(directory, "program.ab")
        ct = os.path.join(directory, "program-ct.ab")
        with open(os.path.join(ROOT, plain), "w", encoding="utf-8") as f:
            f.write(assemble(prelude, checks, False))
        with open(os.path.join(ROOT, ct), "w", encoding="utf-8") as f:
            f.write(assemble(prelude, checks, True))
        jobs = {
            "fast": lambda: self.native(plain, os.path.join(directory, "fast"), True, False),
            "release": lambda: self.native(plain, os.path.join(directory, "release"), False, False),
            "ct": lambda: self.native(ct, os.path.join(directory, "ct"), True, "interp"),
            "ct-jit": lambda: self.native(ct, os.path.join(directory, "ctjit"), True, "jit"),
        }
        if include_wasm:
            jobs["wasm"] = lambda: self.wasm(plain, directory)
        results = {}
        with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
            futures = {k: pool.submit(v) for k, v in jobs.items()}
            for k, fut in futures.items():
                v = fut.result()
                if k == "wasm":
                    results.update(v)
                else:
                    results[k] = v
        return results


def run_panic(runner, seed, keep):
    name, text = panic_program(seed)
    directory = os.path.join(WORK, f"panic{seed}")
    os.makedirs(os.path.join(ROOT, directory), exist_ok=True)
    plain = os.path.join(directory, "program.ab")
    with open(os.path.join(ROOT, plain), "w", encoding="utf-8") as f:
        f.write(text)
    results = {
        "fast": runner.native(plain, os.path.join(directory, "fast"), True, False, True),
        "release": runner.native(plain, os.path.join(directory, "release"), False, False, True),
    }
    results.update(runner.wasm(plain, directory, True))
    # Agreement is not enough (all modes could be wrong the same way): a panic prints
    # `before` and not `after`, ends with status 101 (the language's panic status, not
    # a normalisation here) and reports itself on standard error before it ends.
    absolute = []
    for mode, value in results.items():
        if value[0] == "build-failed":
            continue
        stdout, code, err = value
        if stdout != "before\n" or code != 101 or not (err and err[0].startswith("panic")):
            absolute.append(f"{mode}: stdout {stdout!r}, status {code}, stderr {err}")
    bad = verdict({m: v[:2] for m, v in results.items()}, allow_nonzero=True)
    if bad is None and absolute:
        bad = "all modes agree but do not panic as specified: " + "; ".join(absolute)
    if bad is None and not keep:
        shutil.rmtree(os.path.join(ROOT, directory), ignore_errors=True)
    return None if bad is None else f"panic ({name}), seed {seed}: {bad}"


def oracle_failed(text):
    """A check's own oracle failed: FUZZ_ORACLE_FAILURE, alone or followed by `:` and what it saw."""
    return text == "FUZZ_ORACLE_FAILURE" or text.startswith("FUZZ_ORACLE_FAILURE:")


def verdict(results, allow_nonzero=False):
    """None when every mode agrees, else a short description."""
    for mode, value in results.items():
        if value[0] != "build-failed" and value[1] != 0 and not allow_nonzero:
            return f"{mode}: exited with status {value[1]}"
        if value[0] != "build-failed" and any(oracle_failed(line.partition("=")[2])
                                               for line in value[0].splitlines()):
            return f"{mode}: result oracle failed"
    distinct = {}
    for mode, value in results.items():
        distinct.setdefault(repr(value), []).append(mode)
    if len(distinct) == 1:
        value = next(iter(results.values()))
        if value[0] == "build-failed":
            return "all modes failed to build: " + " | ".join(value[1][:3])
        return None
    return "; ".join(f"{'+'.join(modes)} -> {value[:200]}" for value, modes in distinct.items())


def differing_lines(results):
    """The check ids whose printed line differs between modes."""
    lines = {}
    for mode, value in results.items():
        if value[0] == "build-failed":
            continue
        for line in value[0].splitlines():
            key, _, text = line.partition("=")
            lines.setdefault(key, {}).setdefault(text, []).append(mode)
    return sorted(k for k, v in lines.items() if len(v) > 1 or any(oracle_failed(text) for text in v))


def graph_provider(base, extra=None):
    signature = 'n: int' if extra is None else f'n: int, extra: int = {extra}'
    suffix = '' if extra is None else ' + extra'
    return f'''val base = {base}
class MBox<T>(val value: T)
fun <T> mbox(value: T): MBox<T> = MBox(value)
interface Measure {{ fun measure(): int }}
class Meter(val n: int) : Measure {{ fun measure(): int = this.n + base }}
compile fun stage({signature}): int = n + base{suffix}
'''


def subparser_provider(style, extra, offset):
    if style == 0:
        arguments = '[syntaxNamedArgument("right", b), syntaxNamedArgument("left", a)]'
    elif style == 1:
        arguments = f'[a, syntaxNamedArgument("right", b), syntaxNamedArgument("extra", syntaxInteger({extra}))]'
    else:
        arguments = f'[syntaxNamedArgument("extra", syntaxInteger({extra})), syntaxNamedArgument("right", b), syntaxNamedArgument("left", a)]'
    return f'''import "abla/compiler"
import "abla/compiler/parser"
compile fun parsePair(cursor: ParserCursor): SyntaxExpression {{
    parserExpect(cursor, "(")
    val a = parserParseAblaExpression(cursor)
    parserExpect(cursor, ",")
    val b = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    syntaxCall("combine", {arguments})
}}
compile fun parseItems(cursor: ParserCursor): SyntaxExpression {{
    parserExpect(cursor, "(")
    val a = parserParseAblaExpression(cursor)
    parserExpect(cursor, ",")
    val b = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    syntaxArray([a, b])
}}
compile fun parseEarly(cursor: ParserCursor): SyntaxExpression {{
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    val absent: int? = null
    syntaxInteger(absent ?? return syntaxInteger({offset}))
}}
compile fun parseBonus(cursor: ParserCursor): SyntaxExpression {{
    parserExpect(cursor, "(")
    parserExpect(cursor, ")")
    syntaxInteger({offset})
}}
#compilerRegisterSubparser("pair", parsePair)
#compilerRegisterSubparser("items", parseItems)
#compilerRegisterSubparser("early", parseEarly)
#compilerRegisterSubparser("bonus", parseBonus)
'''


def subparser_write(directory, seed):
    r = random.Random(seed)
    a, b, extra, offset, delta = (r.randint(1, 8), r.randint(1, 9), r.randint(4, 9),
                                   r.randint(10, 20), r.randint(1, 5))
    style = seed % 3
    os.makedirs(os.path.join(ROOT, directory), exist_ok=True)
    with open(os.path.join(ROOT, directory, 'abla.toml'), 'w', encoding='utf-8') as f:
        f.write('name = "fuzz-subparser"\nversion = "0.1.0"\nentry = "program.ab"\nvisibility = "imports"\n')
    with open(os.path.join(ROOT, directory, 'provider.ab'), 'w', encoding='utf-8') as f:
        f.write(subparser_provider(style, extra, offset))
    with open(os.path.join(ROOT, directory, 'helper.ab'), 'w', encoding='utf-8') as f:
        f.write('fun marker(): int = 42\n')
    actual_extra = 3 if style == 0 else extra
    value = (a + 1) * 100 + b * 10 + actual_extra
    direct_extra = '' if style == 0 else f', extra = {extra}'
    prelude = '''import "abla/io"
import "./provider.ab"
import "./helper.ab"
fun combine(left: int, right: int, extra: int = 3): int = left * 100 + right * 10 + extra
'''
    lines = ['fun c0(): string {', f'    val got = $pair({a} + 1, {b})',
             f'    val direct = combine(left = {a} + 1, right = {b}{direct_extra})',
             '    var sum = 0', f'    for (v in $items({a} + 1, {b})) sum += v',
             f'    val choice = when ($pair({a} + 1, {b})) {{ {value} -> 1; else -> 0 }}',
             '    "$got:$direct:$sum:$choice:${$early()}:${$bonus()}:${marker()}"', '}']
    return prelude, [(lines, 'c0()', 'str', 0)], (a, b, extra, offset, delta, style)


def subparser_expected(data, offset):
    a, b, extra, _, _, style = data
    value = (a + 1) * 100 + b * 10 + (3 if style == 0 else extra)
    return f'c0={value}:{value}:{a + 1 + b}:1:{offset}:{offset}:42\n'


def run_subparser_seed(args, seed, runner):
    directory = os.path.join(WORK, f'subparser{seed}')
    shutil.rmtree(os.path.join(ROOT, directory), ignore_errors=True)
    prelude, checks, data = subparser_write(directory, seed)
    _, _, extra, offset, delta, style = data
    results = runner.all_modes(directory, (prelude, checks))
    expected = subparser_expected(data, offset)
    bad = verdict(results)
    if bad or any(v != (expected, 0) for v in results.values()):
        return f'subparser seed {seed}, no-cache: {bad or "Python oracle mismatch"}; expected {expected!r}; results {results!r}; retained {directory}'
    modes = ('fast', 'release', 'ct', 'ct-jit', 'wasm', 'wasm-dev')
    for phase in ('cold', 'warm', 'discovery', 'provider-edit'):
        if phase == 'provider-edit':
            with open(os.path.join(ROOT, directory, 'provider.ab'), 'w', encoding='utf-8') as f:
                f.write(subparser_provider(style, extra, offset + delta))
        expected = subparser_expected(data, offset + delta if phase == 'provider-edit' else offset)
        results = {}
        for mode in modes:
            cache = os.path.join(directory, 'cache-' + mode)
            if phase == 'discovery':
                for item in os.scandir(os.path.join(ROOT, cache)):
                    if item.name.startswith('discovery-v1-'):
                        continue
                    if item.is_dir(follow_symlinks=False):
                        shutil.rmtree(item.path)
                    else:
                        os.unlink(item.path)
            if mode.startswith('wasm'):
                result = graph_cached_wasm(runner, directory, mode, cache, trace=phase == 'discovery')
            else:
                source = os.path.join(directory, 'program-ct.ab' if mode.startswith('ct') else 'program.ab')
                ct = 'interp' if mode == 'ct' else ('jit' if mode == 'ct-jit' else None)
                result = runner.native(source, os.path.join(directory, 'cached-' + mode),
                                       mode != 'release', ct, cache_dir=cache, trace=phase == 'discovery')
            if phase == 'discovery' and result[0] != 'build-failed':
                stdout, status, trace = result
                if f'discovery.hit:{directory}/helper.ab' not in trace:
                    return f'subparser seed {seed}, discovery: {mode} did not report helper cache hit; retained {directory}'
                result = (stdout, status)
            results[mode] = result
        bad = verdict(results)
        if bad or any(v != (expected, 0) for v in results.values()):
            return f'subparser seed {seed}, {phase}: {bad or "Python oracle mismatch"}; expected {expected!r}; results {results!r}; retained {directory}'
    if not args.keep:
        shutil.rmtree(os.path.join(ROOT, directory), ignore_errors=True)
    return None


def graph_write(directory, seed):
    """Make a small strict graph: direct, facade or diamond with one visible clash."""
    r = random.Random(seed)
    a, b, base, delta, extra = (r.randint(1, 9), r.randint(10, 19), r.randint(20, 40),
                                r.randint(1, 9), r.randint(1, 9))
    os.makedirs(os.path.join(ROOT, directory), exist_ok=True)
    files = {
        'abla.toml': 'name = "fuzz-modules"\nversion = "0.1.0"\nentry = "program.ab"\nvisibility = "imports"\n',
        'provider.ab': graph_provider(base),
    }
    variant = seed % 3
    if variant == 0:
        files['provider.ab'] += '\nfun clash(): int = 7\n'
        imports = 'import "./provider.ab"\n'
        left, right = f'mbox({a}).value', f'mbox({b}).value'
    else:
        files['left.ab'] = f'export import "./provider.ab"\nfun leftValue(): int = mbox({a}).value\nfun clash(): int = 7\n'
        imports = 'import "./left.ab"\n'
        left = 'leftValue()'
        if variant == 1:
            right = f'mbox({b}).value'
        else:
            files['right.ab'] = f'import "./provider.ab"\nfun rightValue(): int = mbox({b}).value\nfun clash(): int = 100\n'
            imports += 'import "./right.ab" as Right\n'
            right = 'Right.rightValue()'
    for name, text in files.items():
        with open(os.path.join(ROOT, directory, name), 'w', encoding='utf-8') as f:
            f.write(text)
    prelude = 'import "abla/io"\n' + imports + 'val staged = #stage(5)\n'
    lines = ['fun c0(): string {', '    val m: Measure = Meter(2)',
             f'    "${{{left}}}:${{{right}}}:${{clash()}}:${{m.measure()}}:$staged"', '}']
    return prelude, [(lines, 'c0()', 'str', 0)], (a, b, base, delta, extra, variant)


def graph_expected(data, base, extra):
    a, b, _, _, _, _ = data
    return f'c0={a}:{b}:7:{2 + base}:{5 + base + extra}\n'


def graph_cached_wasm(runner, directory, mode, cache_dir, trace=False):
    source = os.path.join(directory, 'program.ab')
    output = os.path.join(directory, f'graph-{mode}.wasm')
    driver = os.path.join(directory, f'graph-{mode}-driver.ab')
    registration = 'val target = #wasm32Target()\n' if mode == 'wasm-dev' else ''
    call = (f'wasmBuildModule("graph", "{source}", "{output}", false, true)'
            if mode == 'wasm' else
            f'buildProgram("graph", "{source}", "{output}", "wasm32-module", "module", true, true)')
    driver_path = os.path.join(ROOT, driver)
    if not os.path.exists(driver_path):
        with open(driver_path, 'w', encoding='utf-8') as f:
            f.write(f'import "abla/wasm/build"\nimport "abla/build"\n{registration}val built = #{call}\nfun main: int = if (built) 0 else 1\n')
    env = {'ABLA_CACHE_DIR': os.path.abspath(cache_dir)}
    if trace:
        env['ABLA_COMPILER_MEMORY_TRACE'] = '1'
    rc, _, err = runner.sh([runner.compiler, 'build', driver, '-o',
                             os.path.join(directory, f'graph-{mode}-driver'), '--fast'], env)
    if rc != 0 or not os.path.exists(os.path.join(ROOT, output)):
        return ('build-failed', err.strip().splitlines()[:6])
    rc, stdout, _ = runner.sh(['node', os.path.join(ROOT, 'tools', 'fuzz-differential.mjs'), output])
    return (stdout, rc, err) if trace else (stdout, rc)


def run_module_graph(args, seed, runner):
    directory = os.path.join(WORK, f'graph{seed}')
    # A retry must begin cold, never reuse a partial cache or stale output.
    shutil.rmtree(os.path.join(ROOT, directory), ignore_errors=True)
    prelude, checks, data = graph_write(directory, seed)
    a, b, base, delta, extra, variant = data
    results = runner.all_modes(directory, (prelude, checks))
    expected = graph_expected(data, base, 0)
    bad = verdict(results)
    if bad or any(v != (expected, 0) for v in results.values()):
        return f'graph seed {seed}, no-cache: {bad or "Python oracle mismatch"}; expected {expected!r}; results {results!r}; retained {directory}'

    modes = ('fast', 'release', 'ct', 'ct-jit', 'wasm', 'wasm-dev')
    for phase in ('cold', 'warm', 'discovery', 'constant', 'signature'):
        current_base = base if phase in ('cold', 'warm', 'discovery') else base + delta
        current_extra = extra if phase == 'signature' else None
        if phase in ('constant', 'signature'):
            provider = graph_provider(current_base, current_extra)
            if variant == 0:
                provider += '\nfun clash(): int = 7\n'
            with open(os.path.join(ROOT, directory, 'provider.ab'), 'w', encoding='utf-8') as f:
                f.write(provider)
        expected = graph_expected(data, current_base, current_extra or 0)
        results = {}
        for mode in modes:
            cache = os.path.join(directory, 'cache-' + mode)
            if phase == 'discovery':
                # Force the frontend to run while preserving its populated raw
                # discovery cache, as in tools/test-discovery-cache.sh.
                for item in os.scandir(os.path.join(ROOT, cache)):
                    if item.name.startswith('discovery-v1-'):
                        continue
                    if item.is_dir(follow_symlinks=False):
                        shutil.rmtree(item.path)
                    else:
                        os.unlink(item.path)
            if mode.startswith('wasm'):
                result = graph_cached_wasm(runner, directory, mode, cache, trace=phase == 'discovery')
            else:
                source = os.path.join(directory, 'program-ct.ab' if mode.startswith('ct') else 'program.ab')
                ct = 'interp' if mode == 'ct' else ('jit' if mode == 'ct-jit' else None)
                result = runner.native(source, os.path.join(directory, 'cached-' + mode),
                                       mode != 'release', ct, cache_dir=cache, trace=phase == 'discovery')
            if phase == 'discovery' and result[0] != 'build-failed':
                stdout, status, trace = result
                if f'discovery.hit:{directory}/provider.ab' not in trace:
                    return f'graph seed {seed}, discovery: {mode} did not report provider cache hit; retained {directory}'
                result = (stdout, status)
            results[mode] = result
        bad = verdict(results)
        if bad or any(v != (expected, 0) for v in results.values()):
            return f'graph seed {seed}, {phase}: {bad or "Python oracle mismatch"}; expected {expected!r}; results {results!r}; retained {directory}'
        if phase == 'cold':
            provider_path = os.path.join(ROOT, directory, 'provider.ab')
            with open(provider_path, 'rb') as f:
                provider_source = f.read()
            for mode in modes:
                pattern = os.path.join(ROOT, directory, 'cache-' + mode, 'discovery-v1-*', '*.discovery')
                found = False
                for record in glob.glob(pattern):
                    with open(record, 'rb') as f:
                        if provider_source in f.read():
                            found = True
                            break
                if not found:
                    return f'graph seed {seed}, cold: {mode} has no provider discovery cache record; retained {directory}'
    if not args.keep:
        shutil.rmtree(os.path.join(ROOT, directory), ignore_errors=True)
    return None


def run_seed(args, seed, runner):
    gen = Gen(seed, not args.no_any, args.focus)
    checks = []
    for i in range(args.checks):
        lines, call, ty = gen.check(i)
        checks.append((lines, call, ty, i))
    directory = os.path.join(WORK, f"seed{seed}")
    prelude = Gen.PRELUDE_TASK if args.hosted_tasks else Gen.PRELUDE
    results = runner.all_modes(directory, (prelude, checks), include_wasm=not args.hosted_tasks)
    bad = verdict(results)
    if bad is None:
        if not args.keep:
            shutil.rmtree(os.path.join(ROOT, directory), ignore_errors=True)
        return run_panic(runner, seed, args.keep) if args.panics else None
    return minimise(args, seed, runner, checks, results, bad)


def minimise(args, seed, runner, checks, results, first):
    """Reduce a disagreement to one check, then to fewer statements."""
    ids = differing_lines(results)
    report = [f"seed {seed}: {first}"]
    if not ids:
        report.append("  no single check line differs (build or exit status differs); kept whole")
        return "\n".join(report)
    by_id = {f"c{c[3]}": c for c in checks}
    for key in ids[:3]:
        check = by_id[key]
        lines = list(check[0])

        def still(candidate_lines, tag):
            trial = [(candidate_lines, check[1], check[2], check[3])]
            prelude = Gen.PRELUDE_TASK if args.hosted_tasks else Gen.PRELUDE
            got = runner.all_modes(os.path.join(WORK, f"min{seed}-{key}-{tag}"), (prelude, trial),
                                   include_wasm=not args.hosted_tasks)
            # The same check must still differ, so a reduction cannot drift to another bug.
            ok = verdict(got) is not None and not any(v[0] == "build-failed" for v in got.values()) \
                and key in differing_lines(got)
            return ok, got

        ok, got = still(lines, "base")
        if not ok:
            report.append(f"  {key}: disagreement does not reproduce alone")
            continue
        # drop body lines one at a time while the disagreement persists
        tag = 0
        i = 1
        while i < len(lines) - 2:
            candidate = lines[:i] + lines[i + 1:]
            tag += 1
            ok2, got2 = still(candidate, str(tag))
            if ok2:
                lines, got = candidate, got2
            else:
                i += 1
        report.append(f"  {key} minimised to {len(lines)} lines:")
        report += ["    " + l for l in lines]
        report.append(f"  call: {check[1]}")
        report.append("  outputs: " + verdict(got))
    return "\n".join(report)


def selftest():
    """The comparison itself: agreeing results pass, any difference is reported."""
    same = {m: ("c0=1\nc1=2\n", 0) for m in ("fast", "release", "ct", "wasm")}
    assert verdict(same) is None
    crashed = {m: ("", 101) for m in same}
    assert verdict(crashed) is not None and verdict(crashed, allow_nonzero=True) is None
    broken_roundtrip = {m: ("c0=FUZZ_ORACLE_FAILURE\n", 0) for m in same}
    assert verdict(broken_roundtrip) is not None and differing_lines(broken_roundtrip) == ["c0"]
    seen = {m: ("c0=FUZZ_ORACLE_FAILURE:12,900,\n", 0) for m in same}
    assert verdict(seen) is not None and differing_lines(seen) == ["c0"]
    other = dict(same)
    other["ct"] = ("c0=1\nc1=3\n", 0)
    assert verdict(other) is not None and differing_lines(other) == ["c1"], differing_lines(other)
    status = dict(same)
    status["wasm"] = ("c0=1\nc1=2\n", 101)
    assert verdict(status) is not None and differing_lines(status) == []
    broken = dict(same)
    broken["release"] = ("build-failed", ["error"])
    assert verdict(broken) is not None
    both = {m: ("build-failed", ["error"]) for m in same}
    assert verdict(both).startswith("all modes failed")
    print("fuzz-differential: comparison self-test passed")
    return 0


def check_hostless_capabilities(runner):
    """Check each hostless builder rejects tasks/threads; do not count these as runs."""
    directory = os.path.join(WORK, 'hostless-capabilities')
    os.makedirs(os.path.join(ROOT, directory), exist_ok=True)
    for kind in ('task', 'thread'):
        source = os.path.join(directory, f'{kind}.ab')
        text = f'import "abla/io"\n@export("run")\nfun run(): int {{ val t = {kind} {{ 7 }}; await t }}\nfun main(): int = run()\n'
        with open(os.path.join(ROOT, source), 'w', encoding='utf-8') as f:
            f.write(text)
        for mode in ('wasm', 'wasm-dev'):
            driver = os.path.join(directory, f'{kind}-{mode}-build.ab')
            out = os.path.join(directory, f'{kind}-{mode}.wasm')
            call = (f'wasmBuildModule("probe", "{source}", "{out}", false, false)'
                    if mode == 'wasm' else
                    f'buildProgram("probe", "{source}", "{out}", "wasm32-module", "module", true, false)')
            with open(os.path.join(ROOT, driver), 'w', encoding='utf-8') as f:
                registration = 'val target = #wasm32Target()\n' if mode == 'wasm-dev' else ''
                f.write(f'import "abla/wasm/build"\n{registration}val built = #{call}\nfun main: int = if (built) 0 else 1\n')
            rc, _, err = runner.sh([runner.compiler, 'build', driver, '-o',
                                     os.path.join(directory, f'{kind}-{mode}-driver'), '--fast', '--no-cache'])
