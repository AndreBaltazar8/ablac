    def clash_check(self, index):
        """Type parameters named like classes (T, U, K): the parameter in scope wins, the class still builds."""
        r = self.r
        env = []
        lines = [f"fun c{index}(): string {{", '    var out = ""']
        for n in range(r.randint(2, 5)):
            kind = r.choice(["slot", "mapped", "same", "swap", "klass", "prelude"])
            a, b = self.int_expr("int", 1, env), self.int_expr("int", 1, env)
            tag = f"{index}x{n}"
            if kind == "slot":
                lines.append(f'    out = out + "${{Slot({a}).item}},"')
            elif kind == "mapped":
                lines.append(f"    val sm{tag} = Slot(T({a})).mapTo {{ x -> U(x.n + ({b})) }}")
                lines.append(f'    out = out + "${{sm{tag}.item.n}},"')
            elif kind == "same":
                lines.append(f'    out = out + "${{same(K({a})).item.n}}${{same("s").item}},"')
            elif kind == "swap":
                lines.append(f"    val sw{tag} = crossed(T({a}), U({b}))")
                lines.append(f'    out = out + "${{sw{tag}.first.n}}/${{sw{tag}.second.n}},"')
            elif kind == "klass":
                lines.append(f'    out = out + "${{T({a}).n + U({b}).n + K(1).n}},"')
            else:
                lines.append(f'    out = out + "${{Box(T({a})).value.n}}${{heldOr(Cell(K({b})), K(0)).n}},"')
        lines.append("    out")
        lines.append("}")
        return lines, f"c{index}()", "str"

    def generic_lambda_check(self, index):
