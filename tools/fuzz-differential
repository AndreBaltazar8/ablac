            text = "fmtF(v)" if ty == "f64" else '"${v}"'
            kind = r.choice(["twice", "apply", "map", "chain", "capture", "toBox"])
            if kind == "twice":
                lines.append(f'    out = out + {show(f"twiceOf({a}, {{ v -> {step} }})")} + ";"')
            elif kind == "apply":
                lines.append(f'    out = out + applyTo({a}, {{ v -> {text} }}) + ";"')
            elif kind == "map":
                lines.append(f'    out = out + {show(f"Box({a}).mapBox {{ v -> {step} }}.value")} + ";"')
            elif kind == "chain":
                lines.append(f'    out = out + {show(f"Box({a}).mapBox {{ v -> {step} }}.mapBox {{ v -> {step} }}.value")} + ";"')
            elif kind == "capture":
