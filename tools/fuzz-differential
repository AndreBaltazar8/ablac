"""

    POOL = ["0", "1", "(-1)", "u8(1)", "u8(255)", "i8(-1)", "u64(-1)", "i32(1)", "true", "false",
            "0.0", "(-0.0)", "1.0", "f64FromBits(9221120237041090560)", "f64FromBits(9221120237041090561)", "f64FromInt(1)", "f64ToF32(1.0)", "f64ToF32(0.0)",
            "4607182418800017408", "4611686018427387904", "9218868437227405312",
            '"a"', '("" + "a")', '"ab"', '("a" + "b")', '""', "[1]", "[1]", "o", "o", "Acc(1, 1)",
            "f64FromBits(1)", "f64FromBits(4607182418800017408)", "97", "u8(97)", "f64ToF32(-1.5)", "3217031168", "(-1077936128)", "i32(-1077936128)"]

    def any_pool_check(self, index):
        """Pairs of values whose bits or contents collide, compared through `any`."""
        r = self.r
        pairs = []
        for _ in range(r.randint(6, 12)):
            a, b = r.choice(self.POOL), r.choice(self.POOL)
            if r.random() < 0.3:
                b = a
            pairs.append((a, b))
        lines = [f"fun c{index}(): string {{", "    val o = Acc(3, 4)", '    var out = ""']
        for a, b in pairs:
            lines.append(f'    out = out + (if (anyEq({a}, {b})) "1" else "0")')
        lines.append("    out")
        lines.append("}")
        return lines, f"c{index}()", "str"

    def check(self, index):
        """One check: a function and its call; returns (function lines, call text, result type)."""
        r = self.r
        if self.with_any and r.random() < 0.12:
            return self.any_pool_check(index)
        extra = r.random()
        if extra < 0.30:
            return r.choice([self.conv_check, self.generic_check, self.iface_check,
                             self.nullable_check, self.string_check])(index)
        nparams = r.randint(0, 3)
        env = []
        params = []
        for p in range(nparams):
            ty = r.choice(INTS + ["f64", "bool", "str"])
            params.append((f"p{p}", ty))
            env.append((f"p{p}", ty))
        result = r.choice(INTS + ["f64", "f32", "bool", "str"])
        lines = [f"fun c{index}({', '.join(f'{n}: {self.type_name(t)}' for n, t in params)}): {self.type_name(result)} {{"]
        lines += self.statements(env, self.depth_limit - 1, r.randint(1, 5))
        lines.append(f"    {self.expr(result, self.depth_limit, env)}")
        lines.append("}")
        args = ", ".join(self.arg(t) for _, t in params)
        return lines, f"c{index}({args})", result

    def arg(self, ty):
        if ty in INTS:
            return self.int_lit(ty)
        if ty == "f64":
            return self.float_lit()
        if ty == "bool":
            return self.r.choice(["true", "false"])
        return '"' + self.r.choice(STRINGS) + '"'


def panic_program(kind_index):
    """A program that prints `before` and then panics one way: output and exit status
    must agree between the native and WebAssembly builds (the evaluator reports a
    compile error for the same code, so it is not compared)."""
    name, body = Gen.PANIC_KINDS[kind_index % len(Gen.PANIC_KINDS)]
    return name, f"""import "abla/io"
import "abla/process/exit"

fun makeZero(): int {{
    var z = 0
    for (i in 0 until 3) z = z * 0
    z
}}

@export("run")
fun run(): int {{
    val zero = makeZero()
    {body}
    println("after")
    0
}}

fun main: int = run()
"""


def render_result(call, ty):
    if ty == "f64":
        return f"fmtF({call})"
    if ty == "f32":
        return f"fmtF(f32ToF64({call}))"
    return call


def assemble(prelude, checks, ct):
    """Source text for a list of (function lines, call, type, id) checks."""
    out = [prelude]
    for lines, _, _, _ in checks:
        out += lines + [""]
    out.append('@export("run")')
    out.append("fun run(): int {")
    for _, call, ty, ident in checks:
        shown = render_result(call, ty)
        value = f"#({shown})" if ct else shown
        out.append(f'    println("c{ident}=${{{value}}}")')
    out.append("    0")
    out.append("}")
    out.append("")
    out.append("fun main: int = run()")
    return "\n".join(out) + "\n"


