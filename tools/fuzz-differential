            definitions += ['}']
            action = f'val result = ownedBody{index}()'
            events = [n + 200, n] + ([n + 301] if nested else []) + [n + 300]
        elif kind in ('break', 'continue'):
            jump = kind
            definitions = [f'fun ownedBody{index}(): void {{', '    for (i in 0 until 1) {',
                           f'        defer {{ dropLog.append({n + 300}) }}',
                           f'        showPair(TempTicketOwner(issue({n}), {n + 200}).ticket, if (true) {{ {jump} }} else issue(1))',
                           '    }', '}']
