}
class Cell<T>(val inner: T) : Holder<T> {
    fun held(): T = this.inner
}
class Twice<T>(val inner: T) : Holder<array<T>> {
    fun held(): array<T> = [this.inner, this.inner]
}
class Chain(val next: Chain?, val cell: Cell<int>?, val tag: string?)
fun <T> heldOr(h: Holder<T>?, fallback: T): T = if (h == null) fallback else h.held()
fun <T, R> viaHolder(h: Holder<T>, f: (T) -> R): R = f(h.held())
fun <A, B> zipPair(a: Cell<A>, b: Cell<B>): Pair<A, B> = Pair(a.inner, b.inner)
fun <T> nested(x: T): Box<Pair<T, array<T>>> = Box(Pair(x, [x, x]))
"""
    PRELUDE = PRELUDE + PRELUDE_DEEP
    PRELUDE_LAMBDA = """fun <T> twiceOf(x: T, f: (T) -> T): T = f(f(x))
fun <T, R> applyTo(x: T, f: (T) -> R): R = f(x)
fun <T, R> Box<T>.mapBox(f: (T) -> R): Box<R> = Box(f(this.value))
"""
    PRELUDE = PRELUDE + PRELUDE_LAMBDA
    PRELUDE_DROP = """val dropLog: array<int> = []
resource class Ticket(val seat: int) {
    fun drop(): void {
        dropLog.append(this.seat)
        return
    }
    fun twice(): int = this.seat * 2
}
fun issue(seat: int): Ticket = Ticket(seat)
fun refund(own ticket: Ticket): int = ticket.seat
fun show(ticket: Ticket): int = ticket.seat
fun showPair(a: Ticket, b: Ticket): int = a.seat + b.seat
fun maybeIssue(seat: int, give: bool): Ticket? = if (give) Ticket(seat) else null
