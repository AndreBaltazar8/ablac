import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"
import "../../src/coff_import.ab"

// The import library of a DLL from a list of the names a program imports from it (one per line; blank lines and lines
// starting with `#` are skipped):
//
//     ablac run tools/windows/implib.ab -- <out.lib> <dll> <x86_64|aarch64> <names file>
//
// runtime/windows/imports/<dll>.txt are the lists of the Windows runtime; src/coff_import.ab has the format.
fun main: int {
    if (processArgumentCount() != 4) {
        eprintln("usage: implib <out.lib> <dll> <x86_64|aarch64> <names file>")
        return 2
    }
    val out = processArgument(0)
    val dll = processArgument(1)
    val architecture = processArgument(2)
    val names: array<string> = []
    for (line in Path(processArgument(3)).readText().split("\n")) {
        val name = line.trim()
        if (name.size > 0 && !name.startsWith("#")) names.append(name)
    }
    val library = bootstrapCoffImportLibrary(dll, architecture, names)
    if (library == "") {
        eprintln("implib: unknown architecture $architecture")
        return 2
    }
    if (!Path(out).writeText(library)) {
        eprintln("implib: cannot write $out")
        return 1
    }
    0
}
