{
  "version": 1,
  "jobs": 2,
  "timeoutMs": 5000,
  "logDirectory": "build/test-results/fail",
  "tests": [
    {
      "name": "wrong-status",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["10", "9", "intentional status failure"]
      }]
