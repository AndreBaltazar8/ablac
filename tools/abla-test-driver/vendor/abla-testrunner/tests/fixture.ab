import "abla/platform/host"

fun fixtureInt(value: string): int {
    var result = 0
    var index = 0
    while (index < value.size) {
        result = result * 10 + value[index] - 48
        index = index + 1
    }
    result
}

fun main: int {
    val delay = fixtureInt(ablaHostArgument(0))
    val status = fixtureInt(ablaHostArgument(1))
    val message = ablaHostArgument(2)
    ablaHostSleep(delay)
    ablaHostWriteStdout("$message\n")
    status
}
