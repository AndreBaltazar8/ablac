import "../src/testrunner.ab"
import "abla/platform/host"

fun main: int {
    val root = ablaHostCurrentDirectory()
    val loaded = loadTestSuite(ablaHostReadFile("$root/tests/pass.json"))
    val dependencies = loadTestSuite(
        ablaHostReadFile("$root/tests/dependencies.json")
    )
    val invalidVersion = loadTestSuite("{\"version\":2,\"tests\":[]}")
    val invalidArguments = loadTestSuite(
        "{\"version\":1,\"tests\":[{\"name\":\"bad\",\"steps\":[{\"command\":\"x\",\"args\":[1]}]}]}"
    )
    val invalidDependencyType = loadTestSuite(
        "{\"version\":1,\"tests\":[{\"name\":\"bad\",\"dependsOn\":[1],\"steps\":[{\"command\":\"x\"}]}]}"
    )
    val unknownDependency = loadTestSuite(
        "{\"version\":1,\"tests\":[{\"name\":\"bad\",\"dependsOn\":[\"missing\"],\"steps\":[{\"command\":\"x\"}]}]}"
    )
    val selfDependency = loadTestSuite(
        "{\"version\":1,\"tests\":[{\"name\":\"bad\",\"dependsOn\":[\"bad\"],\"steps\":[{\"command\":\"x\"}]}]}"
    )
    val cyclicDependency = loadTestSuite(
        "{\"version\":1,\"tests\":[{\"name\":\"left\",\"dependsOn\":[\"right\"],\"steps\":[{\"command\":\"x\"}]},{\"name\":\"right\",\"dependsOn\":[\"left\"],\"steps\":[{\"command\":\"x\"}]}]}"
    )
    if (loaded.error != "") 1
    else if (loaded.suite.tests.size != 10 || loaded.suite.jobs != 4) 2
    else if (loaded.suite.tests[2].steps[0].expectedStatus != 7) 3
    else if (!loaded.suite.tests[8].exclusive) 4
    else if (dependencies.error != "" ||
        dependencies.suite.tests[0].dependencies.size != 1) 5
    else if (invalidVersion.error == "" || invalidArguments.error == "" ||
        invalidDependencyType.error == "" || unknownDependency.error == "" ||
        selfDependency.error == "" || cyclicDependency.error == "") 6
    else 0
}
