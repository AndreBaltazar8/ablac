import "../src/testrunner.ab"
import "abla/platform/host"

fun main: int {
    val root = ablaHostCurrentDirectory()
    val loaded = loadTestSuite(ablaHostReadFile("$root/tests/pass.json"))
    val invalidVersion = loadTestSuite("{\"version\":2,\"tests\":[]}")
    val invalidArguments = loadTestSuite(
        "{\"version\":1,\"tests\":[{\"name\":\"bad\",\"steps\":[{\"command\":\"x\",\"args\":[1]}]}]}"
    )
    if (loaded.error != "") 1
    else if (loaded.suite.tests.size != 10 || loaded.suite.jobs != 4) 2
    else if (loaded.suite.tests[2].steps[0].expectedStatus != 7) 3
    else if (!loaded.suite.tests[8].exclusive) 4
    else if (invalidVersion.error == "" || invalidArguments.error == "") 5
    else 0
}
