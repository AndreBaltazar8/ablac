{
  "version": 1,
  "jobs": 4,
  "timeoutMs": 5000,
  "logDirectory": "build/test-results/dependency-fail",
  "tests": [
    {
      "name": "blocked-dependent",
      "dependsOn": ["failing-prerequisite"],
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["1", "0", "must not run"]
      }]
    },
    {
      "name": "failing-prerequisite",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["1", "7", "intentional dependency failure"]
      }]
    }
  ]
}
