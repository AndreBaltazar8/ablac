{
  "version": 1,
  "jobs": 4,
  "timeoutMs": 5000,
  "logDirectory": "build/test-results/dependencies",
  "tests": [
    {
      "name": "dependency-leaf",
      "dependsOn": ["dependency-middle"],
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["100", "0", "leaf"]
      }]
    },
    {
      "name": "dependency-middle",
      "dependsOn": ["dependency-setup"],
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["100", "0", "middle"]
      }]
    },
    {
      "name": "dependency-setup",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["100", "0", "setup"]
      }]
    },
    {
      "name": "unrelated",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["1", "9", "filter must exclude this"]
      }]
    }
  ]
}
