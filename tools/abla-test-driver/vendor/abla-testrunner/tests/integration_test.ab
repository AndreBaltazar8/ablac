import "../src/testrunner.ab"
import "abla/platform/host"

fun main: int {
    val root = ablaHostCurrentDirectory()
    val started = ablaHostMonotonicMilliseconds()
    val passed = runTestCommand(["--file", "tests/pass.json", "--jobs", "4"])
    val elapsed = ablaHostMonotonicMilliseconds() - started
    val failed = runTestCommand(["--file", "tests/fail.json"])
    val filtered = runTestCommand([
        "--file", "tests/pass.json", "--filter", "exclusive-final"
    ])
    val variable = runTestCommand([
        "--file", "tests/variables.json",
        "--set", "fixture=$root/build/fixture"
    ])
    if (passed != 0) 1
    else if (elapsed >= 1800) 2
    else if (failed != 1) 3
    else if (filtered != 0) 4
    else if (variable != 0) 5
    else 0
}
