{
  "version": 1,
  "jobs": 4,
  "timeoutMs": 5000,
  "logDirectory": "build/test-results/pass",
  "environment": {
    "ABLA_TEST_SUITE": "parallel"
  },
  "tests": [
    {
      "name": "parallel-1",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["300", "0", "parallel one"]
      }]
    },
    {
      "name": "parallel-2",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["300", "0", "parallel two"]
      }]
    },
    {
      "name": "parallel-3",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["300", "7", "expected seven"],
        "expect": 7
      }]
    },
    {
      "name": "parallel-4",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["300", "0", "parallel four"]
      }]
    },
    {
      "name": "parallel-5",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["300", "0", "parallel five"]
      }]
    },
    {
      "name": "parallel-6",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["300", "0", "parallel six"]
      }]
    },
    {
      "name": "multi-step",
      "steps": [
        {
          "command": "${root}/build/fixture",
          "args": ["150", "3", "first step"],
          "expect": 3
        },
        {
          "command": "${root}/build/fixture",
          "args": ["150", "0", "second step"]
        }
      ]
    },
    {
      "name": "parallel-8",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["300", "0", "parallel eight"]
      }]
    },
    {
      "name": "exclusive-final",
      "exclusive": true,
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["100", "0", "exclusive"]
      }]
    },
    {
      "name": "other-platform",
      "platform": "macos",
      "steps": [{
        "command": "${root}/build/fixture",
        "args": ["1", "0", "mac only"]
      }]
    }
  ]
}
