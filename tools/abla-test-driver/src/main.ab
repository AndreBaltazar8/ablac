import github("AndreBaltazar8/abla-testrunner")
import "abla/platform/host"

fun main: int {
    val arguments: array<string> = []
    var index = 0
    while (index < ablaHostArgumentCount()) {
        arguments.append(ablaHostArgument(index))
        index = index + 1
    }
    runTestCommand(arguments)
}
