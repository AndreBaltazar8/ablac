#!/usr/bin/env bash
# The suite's network guard (tools/run-tests.sh puts this directory first on every suite command's PATH; gh and wget
# are links to this file). A suite test must never depend on the network: a slow or rate-limited GitHub API hung a gate
# on 2026-11-27. curl and wget run for real when every URL they are given is file:// or on the loopback host (127.0.0.1,
# localhost, [::1], any port), and with no URL at all (curl --version); gh never does. A refused call is written to
# $ABLA_NET_GUARD_LOG (run-tests.sh fails the command when that file is not empty, whatever its exit status) and exits 7,
# curl's "could not connect". A test that needs the network is listed in tools/test-network-allowed.txt.
set -uo pipefail
tool=$(basename -- "$0")
here=$(cd -- "$(dirname -- "$0")" && pwd)

call="$tool $*"
refuse() {
    printf 'net-guard: refused %s: %s (a suite test must not use the network; see tools/lib/net-guard/curl)\n' "$tool" "$1" >&2
    [[ -z ${ABLA_NET_GUARD_LOG:-} ]] || printf '%s\n' "$call" >> "$ABLA_NET_GUARD_LOG"
    exit 7
}

[[ $tool != gh ]] || refuse "every gh call"

local_url() { # URL -> whether it stays on this machine
    local rest
    case $1 in
        file://*) return 0 ;;
        http://* | https://* | ftp://* | ws://* | wss://*) rest=${1#*://} ;;
        *) return 1 ;;
    esac
    rest=${rest#*@}   # user info
    case $rest in
        127.0.0.1 | 127.0.0.1[:/?#]* | localhost | localhost[:/?#]* | '[::1]' | '[::1]'[:/?#]*) return 0 ;;
    esac
    return 1
}

# Every argument with a scheme is judged. (A bare host name, `curl example.com`, is not recognised: telling it from an output
# file name such as `-o out.json` is guesswork, and the suite's tests write full URLs.)
for argument in "$@"; do
    if [[ $argument == *://* ]]; then
        local_url "$argument" || refuse "$argument"
    fi
done

# The real tool: the first one on PATH that is not in this directory or in another copy of the guard (a test's private
# tree under the suite's own guard: two copies that each took the other for the real tool would exec each other for ever).
real=
IFS=: read -r -a entries <<< "$PATH"
for entry in "${entries[@]}"; do
    dir=$(cd -- "$entry" 2>/dev/null && pwd) || continue
    [[ -n $entry && $dir != "$here" && $dir != */tools/lib/net-guard ]] || continue
    if [[ -x $entry/$tool && ! -d $entry/$tool ]]; then real=$entry/$tool; break; fi
done
[[ -n $real ]] || { printf 'net-guard: %s: command not found\n' "$tool" >&2; exit 127; }
exec "$real" "$@"
