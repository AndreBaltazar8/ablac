// The BoGo shim for abla/tls/pure: BoringSSL's TLS test runner (ssl/test/runner, Go) starts this program once per test
// with the test's flags, the shim connects back to the runner, sends its 8-byte id and speaks TLS as a client or (with
// -server) a server through abla/tls/pure's state machines; after the handshake it echoes every byte of application
// data back XOR 0xff until the peer closes. A flag it does not know, or a feature abla/tls/pure does not have (TLS 1.1
// and older, resumption, DTLS, QUIC, ...), exits 89, which the runner counts as unimplemented. Any failure exits 1
// after the alert is flushed. tools/test-tls-bogo.sh builds it and runs the runner.
import "abla/io"
import "abla/crypto"
import "abla/crypto/x509"
import "abla/integer"
import "abla/process/arguments"
import "abla/sys/linux"
import "abla/sys/linux/net"
import "abla/tls/pure/client"
import "abla/tls/pure/connection"
import "abla/tls/pure/handshake"
import "abla/tls/pure/identity"
import "abla/tls/pure/server"
import "abla/tls/pure/tls12"
import "abla/tls/pure/verify"

val UNIMPLEMENTED = 89

class ShimFlags(
    var port: int,
    var shimId: int,
    var isServer: bool,
    var ipv6: bool,
    var keyFile: string,
    var certFile: string,
    var minVersion: int,
    var maxVersion: int,
    var expectVersion: int,
    var shimWritesFirst: bool,
    var advertiseAlpn: array<string>,
    var expectAlpn: string,
    var selectAlpn: string,
    var declineAlpn: bool,
    var hostName: string,
    var expectServerName: string,
    var requireClientCertificate: bool,
    var verifyPeer: bool,
    var curves: array<int>,
    var signingPrefs: array<int>,
    var verifyPrefs: array<int>,
    var unimplemented: string
)

fun shimDefaults(): ShimFlags =
    ShimFlags(0, 0, false, false, "", "", 769, 772, 0, false, [], "", "", false, "", "", false, false, [], [], [], "")

// Flags that change nothing here (the runner's bookkeeping, or behaviour the shim has anyway).
val IGNORED_FLAGS = ["-ipv6-unused"]

// Boolean flags whose feature abla/tls/pure does not have: the test does not apply.
val UNSUPPORTED_BOOLEAN = ["-dtls", "-quic", "-enable-early-data", "-fuzzer-mode", "-async", "-implicit-handshake",
    "-false-start", "-handshaker-resume", "-use-ticket-callback", "-renegotiate-freely", "-renegotiate-once",
    "-renegotiate-ignore", "-renegotiate-explicit", "-enable-ocsp-stapling", "-enable-signed-cert-timestamps",
    "-new-x509-credential", "-new-delegated-credential", "-new-psk-credential", "-new-spake2plusv1-credential",
    "-new-rpk-credential", "-on-initial-new-x509-credential"]

/** The ALPN list in the shim's wire form: each name preceded by its one-byte length. */
fun parseAlpnList(text: string): array<string> {
    val names: array<string> = []
    var at = 0
    while (at < text.size) {
        val length = text[at]
        if (at + 1 + length > text.size) return names
        names.append(text.slice(at + 1, at + 1 + length))
        at = at + 1 + length
    }
    names
}

fun has(list: array<int>, value: int): bool {
    for (item in list) if (item == value) return true
    false
}

fun hasText(list: array<string>, value: string): bool {
    for (item in list) if (item == value) return true
    false
}

fun numberOf(text: string): int {
    val parsed = text.parseInt()
    if (parsed == null) -1 else parsed
}

fun parseFlags(): ShimFlags {
    val flags = shimDefaults()
    val count = processArgumentCount()
    var index = 0
    while (index < count) {
        val name = processArgument(index)
        val value = if (index + 1 < count) processArgument(index + 1) else ""
        var takesValue = true
        if (name == "-server") { flags.isServer = true; takesValue = false }
        else if (name == "-ipv6") { flags.ipv6 = true; takesValue = false }
        else if (name == "-shim-writes-first") { flags.shimWritesFirst = true; takesValue = false }
        else if (name == "-require-any-client-certificate") { flags.requireClientCertificate = true; takesValue = false }
        else if (name == "-verify-peer") { flags.verifyPeer = true; takesValue = false }
        else if (name == "-decline-alpn") { flags.declineAlpn = true; takesValue = false }
        else if (name == "-no-tls13") { if (flags.maxVersion > 771) flags.maxVersion = 771; takesValue = false }
        else if (name == "-no-tls12") { flags.unimplemented = "-no-tls12 (needs TLS 1.1 or 1.3 alone)"; takesValue = false }
        else if (name == "-no-tls11" || name == "-no-tls1" || name == "-no-ssl3") { takesValue = false }
        else if (name == "-port") flags.port = numberOf(value)
        else if (name == "-shim-id") flags.shimId = numberOf(value)
        else if (name == "-key-file") flags.keyFile = value
        else if (name == "-cert-file") flags.certFile = value
        else if (name == "-trust-cert") takesValue = true
        else if (name == "-min-version") flags.minVersion = numberOf(value)
        else if (name == "-max-version") flags.maxVersion = numberOf(value)
        else if (name == "-expect-version") flags.expectVersion = numberOf(value)
        else if (name == "-advertise-alpn") flags.advertiseAlpn = parseAlpnList(value)
        else if (name == "-expect-alpn") flags.expectAlpn = value
        else if (name == "-select-alpn") flags.selectAlpn = value
        else if (name == "-host-name") flags.hostName = value
        else if (name == "-expect-server-name") flags.expectServerName = value
        else if (name == "-curves") flags.curves.append(numberOf(value))
        else if (name == "-signing-prefs") flags.signingPrefs.append(numberOf(value))
        else if (name == "-verify-prefs") flags.verifyPrefs.append(numberOf(value))
        else if (name == "-resume-count") { if (numberOf(value) != 0) flags.unimplemented = "resumption" }
        else if (hasText(UNSUPPORTED_BOOLEAN, name)) { flags.unimplemented = name; takesValue = false }
        else {
            flags.unimplemented = name
            return flags
        }
        index = index + (if (takesValue) 2 else 1)
    }
    flags
}

// ---- the certificate checks: the runner's certificates are not for any name the shim knows, and BoringSSL's shim
// does not verify the chain unless asked to; the CertificateVerify signature is always checked ----
fun signatureOnly(chain: array<string>, host: string, scheme: int, content: string, signature: string): string {
    if (chain.size == 0) return "no certificate"
    val leaf = x509ParseDer(chain[0])
    if (!leaf.ok) return "certificate: ${leaf.error}"
    tlsVerifySignature(leaf, scheme, content, signature)
}

fun clientSignatureOnly(chain: array<string>, scheme: int, content: string, signature: string): string =
    signatureOnly(chain, "", scheme, content, signature)

fun loadIdentity(flags: ShimFlags): TlsIdentity? {
    if (flags.certFile == "" && flags.keyFile == "") return null
    val identity = tlsIdentityFromPem(linuxReadFile(flags.certFile, 1048576), linuxReadFile(flags.keyFile, 1048576))
    if (!identity.ok()) return identity
    if (flags.signingPrefs.size == 0) return identity
    val schemes: array<int> = []
    for (scheme in flags.signingPrefs) if (has(identity.schemes, scheme)) schemes.append(scheme)
    TlsIdentity(identity.chain, schemes, identity.sign, if (schemes.size == 0) "no usable signing preference" else "")
}

val SUPPORTED_GROUPS = [TLS_GROUP_X25519, TLS_GROUP_SECP256R1]

fun shimGroups(flags: ShimFlags): array<int> {
    if (flags.curves.size == 0) return SUPPORTED_GROUPS
    val groups: array<int> = []
    for (group in flags.curves) if (has(SUPPORTED_GROUPS, group)) groups.append(group)
    groups
}

val SUITES13 = [TLS_SUITE_AES_128_GCM_SHA256, TLS_SUITE_AES_256_GCM_SHA384, TLS_SUITE_CHACHA20_POLY1305_SHA256]
val SUITES12 = [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256, TLS12_ECDHE_RSA_AES_128_GCM_SHA256,
    TLS12_ECDHE_ECDSA_AES_256_GCM_SHA384, TLS12_ECDHE_RSA_AES_256_GCM_SHA384,
    TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256, TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256]
val SIGNATURES = [TLS_SIG_ECDSA_SECP256R1_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA384,
    TLS_SIG_RSA_PSS_RSAE_SHA512, TLS_SIG_ED25519, TLS_SIG_ECDSA_SECP384R1_SHA384, TLS_SIG_RSA_PKCS1_SHA256,
    TLS_SIG_RSA_PKCS1_SHA384, TLS_SIG_RSA_PKCS1_SHA512]

fun shimClient(flags: ShimFlags, groups: array<int>): TlsClient {
    val suites = if (flags.maxVersion >= 772) SUITES13 else []
    val suites12 = if (flags.minVersion <= 771) SUITES12 else []
    var signatures = SIGNATURES
    if (flags.verifyPrefs.size > 0) {
        val chosen: array<int> = []
        for (scheme in flags.verifyPrefs) if (has(SIGNATURES, scheme)) chosen.append(scheme)
        signatures = chosen
    }
    val config = TlsClientConfig(flags.hostName, suites, signatures, flags.advertiseAlpn, signatureOnly, tlsPureRandom,
        tlsPatchClientHello, suites12)
    // A key share for the first group the shim prefers (tlsClientNew's choice, X25519, when -curves allows it).
    val helloRandom = tlsPureRandom(32)
    val sessionId = tlsPureRandom(32)
    val pairs: array<TlsKeyPair> = []
    val shares: array<TlsKeyShare> = []
    if (suites.size > 0) {
        val pair = tlsGenerateKeyPair(groups[0], tlsPureRandom)
        if (pair != null) {
            pairs.append(pair)
            shares.append(TlsKeyShare(pair.group, pair.publicKey))
        }
    }
    val hello = tlsBuildClientHello(helloRandom, sessionId, suites, flags.hostName, groups, shares, signatures,
        flags.advertiseAlpn, "", suites12)
    tlsClientStartWith(config, hello, helloRandom, sessionId, pairs, 769)
}

fun shimServer(flags: ShimFlags, identity: TlsIdentity, groups: array<int>): TlsServer {
    val suites = if (flags.maxVersion >= 772) SUITES13 else []
    val suites12 = if (flags.minVersion <= 771) SUITES12 else []
    val alpn: array<string> = if (flags.selectAlpn != "") [flags.selectAlpn] else if (flags.declineAlpn) [] else []
    val request = flags.requireClientCertificate || flags.verifyPeer
    tlsServerNew(TlsServerConfig(identity, suites, groups, alpn, tlsPureRandom, request, flags.requireClientCertificate,
        clientSignatureOnly, suites12))
}

// ---- the connection: one machine, a client's or a server's (the other is an unused placeholder) ----
fun noSignature(scheme: int, content: string): string = ""

fun placeholderClient(): TlsClient =
    tlsClientStartWith(tlsClientConfig("", signatureOnly, tlsPureRandom), "", "", "", [], 769)

fun placeholderServer(): TlsServer = tlsServerNew(tlsServerConfig(TlsIdentity([], [], noSignature), tlsPureRandom))

class Shim(var tcp: TcpConnection, var client: TlsClient, var server: TlsServer, val isServer: bool)

fun Shim.feed(data: string): void {
    if (this.isServer) this.server.feed(data) else this.client.feed(data)
    return
}

fun Shim.output(): string = if (this.isServer) this.server.takeOutput() else this.client.takeOutput()
fun Shim.connected(): bool = if (this.isServer) this.server.connected() else this.client.connected()
fun Shim.failed(): bool = if (this.isServer) this.server.failed() else this.client.failed()
fun Shim.error(): string = if (this.isServer) this.server.error else this.client.error
fun Shim.peerClosed(): bool = if (this.isServer) this.server.closed() else this.client.closed()
fun Shim.received(): string = if (this.isServer) this.server.takeApplicationData() else this.client.takeApplicationData()
fun Shim.send(data: string): bool = if (this.isServer) this.server.send(data) else this.client.send(data)
fun Shim.version(): int = if (this.isServer) (if (this.server.v12) 771 else 772) else (if (this.client.v12) 771 else 772)
fun Shim.alpn(): string = if (this.isServer) this.server.alpn() else this.client.alpn()

fun Shim.flush(): bool {
    val data = this.output()
    if (data.size == 0) return true
    this.tcp.writeResult(data).succeeded()
}

/** Reads once and feeds the machine; false at the end of the stream or on an error. */
fun Shim.pump(): bool {
    this.tcp.setTimeouts(20000, 20000)
    val received = this.tcp.readResult(16384)
    if (!received.hasData()) return false
    this.feed(received.bytes)
    this.flush()
}

/** After a failure: the alert out, then the peer's remaining bytes read until it closes (so that its last writes do
 *  not meet a reset), then the socket closed. */
fun Shim.failWith(what: string): int {
    eprintln("shim: $what")
    this.flush()
    this.tcp.setTimeouts(2000, 2000)
    var reading = true
    while (reading) reading = this.tcp.readResult(16384).hasData()
    this.tcp.close()
    1
}

fun xorAll(data: string): string {
    val bytes: array<int> = []
    for (byte in data) bytes.append(byte ^ 255)
    cryptoByteString(bytes)
}

fun main: int {
    // The runner asks once whether split handshakes are supported: they are not.
    if (processArgumentCount() == 1 && processArgument(0) == "-is-handshaker-supported") {
        println("No")
        return 0
    }
    val flags = parseFlags()
    if (flags.unimplemented != "") {
        eprintln("shim: unimplemented: ${flags.unimplemented}")
        return UNIMPLEMENTED
    }
    if (flags.maxVersion < 771) {
        eprintln("shim: unimplemented: TLS below 1.2 only")
        return UNIMPLEMENTED
    }
    if (flags.minVersion > 772) return UNIMPLEMENTED
    val groups = shimGroups(flags)
    if (groups.size == 0) {
        eprintln("shim: unimplemented: none of the curves offered")
        return UNIMPLEMENTED
    }
    val identity = loadIdentity(flags)
    if (identity != null && !identity.ok()) {
        eprintln("shim: unimplemented: identity: ${identity.error}")
        return UNIMPLEMENTED
    }
    if (flags.isServer && identity == null) {
        eprintln("shim: unimplemented: a server without a certificate")
        return UNIMPLEMENTED
    }

    val tcp = if (flags.ipv6) tcpConnectIpv6(ipv6Loopback(flags.port), 5000) else tcpConnect(ipv4Loopback(flags.port), 5000)
    if (tcp.descriptor < 0) {
        eprintln("shim: cannot connect to the runner on port ${flags.port}")
        return 1
    }
    var id = ""
    var rest = flags.shimId
    for (i in 0 until 8) {
        id = id + cryptoByteString([rest & 255])
        rest = rest >> 8
    }
    tcp.writeResult(id)

    var client = if (flags.isServer) placeholderClient() else shimClient(flags, groups)
    if (!flags.isServer && identity != null) client.useIdentity(identity)
    val server = if (flags.isServer && identity != null) shimServer(flags, identity, groups) else placeholderServer()
    var shim = Shim(move(tcp), client, server, flags.isServer)

    // The handshake.
    if (!shim.flush()) return shim.failWith("write failed")
    while (!shim.connected() && !shim.failed()) {
        if (!shim.pump()) {
            if (shim.failed()) return shim.failWith(shim.error())
            return shim.failWith("the connection ended in the handshake")
        }
    }
    if (shim.failed()) return shim.failWith(shim.error())

    // The checks the flags ask for.
    if (flags.expectVersion != 0 && shim.version() != flags.expectVersion) {
        return shim.failWith("version ${shim.version()}, expected ${flags.expectVersion}")
    }
    if (flags.expectAlpn != "" && shim.alpn() != flags.expectAlpn) {
        return shim.failWith("ALPN '${shim.alpn()}', expected '${flags.expectAlpn}'")
    }
    if (flags.selectAlpn != "" && shim.alpn() != flags.selectAlpn) {
        return shim.failWith("ALPN '${shim.alpn()}', selected '${flags.selectAlpn}'")
    }
    if (flags.declineAlpn && shim.alpn() != "") return shim.failWith("ALPN negotiated though declined")
    if (flags.isServer && flags.expectServerName != "" && shim.server.serverNameIndication() != flags.expectServerName) {
        return shim.failWith("server name '${shim.server.serverNameIndication()}', expected '${flags.expectServerName}'")
    }

    if (flags.shimWritesFirst) {
        shim.send("hello")
        if (!shim.flush()) return shim.failWith("write failed")
    }

    // The echo, XOR 0xff, until the peer closes.
    while (true) {
        val data = shim.received()
        if (data.size > 0) {
            if (!shim.send(xorAll(data))) return shim.failWith("send failed: ${shim.error()}")
            if (!shim.flush()) return shim.failWith("write failed")
        }
        if (shim.failed()) return shim.failWith(shim.error())
        if (shim.peerClosed()) {
            shim.tcp.close()
            return 0
        }
        if (!shim.pump()) {
            if (shim.failed()) return shim.failWith(shim.error())
            val left = shim.received()
            if (left.size > 0) {
                if (!shim.send(xorAll(left)) || !shim.flush()) return shim.failWith("write failed")
            }
            shim.tcp.close()
            return 0
        }
    }
    0
}
