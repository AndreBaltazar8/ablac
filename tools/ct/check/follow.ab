// A call followed into a function of the same object (#817): its own check on the arguments the caller passes. As
// check-asm.py's follow_call; each architecture's checker is passed in with its name (the cache key's first part).
import "abla/text"
import "./core.ab"
import "./objdump.ab"

fun ctIntList(values: array<int>): string {
    val parts: array<string> = []
    for (value in values) parts.append("$value")
    textJoin(parts, ",")
}

fun ctViewKey(views: Map<int, string>): string {
    val parts: array<string> = []
    for (key in views.keys()) parts.append("$key=${views.get(key) ?? ""}")
    textJoin(sortedStrings(parts), ";")
}

fun ctFollowCall(
    name: string,
    secret: array<int>,
    pointers: array<int>,
    text: string,
    checkName: string,
    check: (array<CtLine>, array<int>, array<int>) -> CtTags,
    views: Map<int, string>
): CtTags {
    ctFollow.followed.set(name, true)
    val key = "$checkName\n$name\n${ctIntList(secret)}\n${ctIntList(pointers)}\n${ctViewKey(views)}"
    val known = ctFollow.done.get(key)
    if (known != null) return known
    for (active in ctFollow.stack) {
        if (active == name) {
            ctFail("call: recursion into $name: $text")
            return ctTags()
        }
    }
    val lines = ctDisassemble(ctFollow.path, name)
    if (lines == null) {
        if (ctFatal == "") ctFail("call: $name isn't defined in the object: $text")
        return ctTags()
    }
    for (line in lines) {
        if (line.text.contains("unknown")) {
            ctFail("call: the disassembler can't read $name: ${line.text}")
            return ctTags()
        }
    }
    ctFollow.stack.append(name)
    val copied: Map<int, string> = Map()
    for (index in views.keys()) copied.set(index, views.get(index) ?? "")
    ctFollow.views = copied
    val returned = check(lines, secret, pointers)
    ctFollow.stack.truncate(ctFollow.stack.size - 1)
    if (ctViolation != "") {
        ctViolation = "in $name: $ctViolation"
        return ctTags()
    }
    if (ctFatal != "") return ctTags()
    ctFollow.done.set(key, returned)
    returned
}
