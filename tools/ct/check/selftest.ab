// Regressions of the constant-time checker's readers on hand-written instructions (#817: the Abla port of
// tools/ct/test-check-asm.py, same cases and messages). Each case is a function's instructions, its address its index,
// checked with the given secret and pointer parameters: it must find a leak, or must not.
import "abla/io"
import "abla/text"
import "./core.ab"
import "./objdump.ab"
import "./x86.ab"
import "./aarch64.ab"
import "./xtensa.ab"
import "./wasm.ab"

var selfFailures = 0

fun selfFail(message: string): void {
    eprintln("FAIL $message")
    selfFailures = selfFailures + 1
    return
}

fun selfLines(code: array<string>, last: string): array<CtLine> {
    val lines: array<CtLine> = []
    var i = 0
    for (text in code) {
        lines.append(CtLine(i, text))
        i = i + 1
    }
    if (last != "") lines.append(CtLine(i, last))
    lines
}

/** The violation a check finds ("" for none). */
fun selfRun(arch: string, lines: array<CtLine>, secret: array<int>, pointers: array<int>): string {
    ctViolation = ""
    ctFatal = ""
    if (arch == "x86_64") ctCheckX86(lines, secret, pointers)
    else if (arch == "aarch64") ctCheckAarch64(lines, secret, pointers)
    else if (arch == "xtensa") ctCheckXtensa(lines, secret, pointers)
    else ctCheckWasm(lines, secret, pointers, 0)
    if (ctFatal != "") {
        selfFail("$arch: the check stopped: $ctFatal")
        return ""
    }
    val found = ctViolation
    ctViolation = ""
    found
}

fun selfExpect(arch: string, code: array<string>, secret: array<int>, pointers: array<int>,
    shouldLeak: bool): void {
    val last = if (arch == "x86_64") "retq" else if (arch == "wasm") "" else "ret"
    val found = selfRun(arch, selfLines(code, last), secret, pointers)
    if ((found != "") != shouldLeak) {
        selfFail("$arch ${if (shouldLeak) "missed a leak in" else "found a leak in"} ${textJoin(code, "; ")}: $found")
    }
    return
}

fun main: int {
    // x86 three-operand IMUL overwrites, but two-operand IMUL reads, its destination.
    selfExpect("x86_64", ["imulq $3, %rdx, %rdi", "cmpq $0, %rdi", "jne 0x3"], [0], [], false)
    selfExpect("x86_64", ["imulq $3, %rdi, %rdx", "cmpq $0, %rdx", "jne 0x3"], [0], [], true)
    selfExpect("x86_64", ["imulq %rdx, %rdi", "cmpq $0, %rdi", "jne 0x3"], [0], [], true)
    println("ok   checker: x86 IMUL operand taint")

    // A secret-dependent branch to a trap is still a leak, only worded as one.
    val bounds = ["cmpq $16, %rdi", "jae 0x3", "retq", "ud2"]
    if (!selfRun("x86_64", selfLines(bounds, ""), [0], []).contains("secret branch (to trap)")) {
        selfFail("a secret bounds check to ud2 must be reported")
    }
    if (selfRun("x86_64", selfLines(bounds, ""), [],
        []) != "") selfFail("the same check on a public value is clean")
    if (selfRun("x86_64", selfLines(["cmpq $16, %rdi", "jae 0x3", "retq", "nop", "retq"], ""), [0],
        []).contains("(to trap)")) {
        selfFail("a branch to a nop is not to a trap")
    }
    println("ok   checker: a secret branch to a trap is a leak")

    // AArch64 immediates are operands, not comments; single and paired stack accesses use the same byte offsets.
    val parsed = ctParseDisassembly("ignored", "example",
        "00000000 <example>:\n  0: ldp x1, x2, [sp, #0x48] // comment\n  4: mov w3, #0x1\n  8: ret\n")
    if (parsed == null || parsed.size < 2 || parsed[0].text != "ldp x1, x2, [sp, #0x48]" ||
        parsed[1].text != "mov w3, #0x1") {
        selfFail("AArch64 immediates read as comments")
    }
    selfExpect("aarch64", ["str x0, [sp, #0x50]", "ldp x1, x2, [sp, #0x48]", "cbnz x2, 0x3"], [0],
        [], true)
    selfExpect("aarch64", ["str x0, [sp, #0x50]", "str x1, [sp, #0x50]", "ldp x1, x2, [sp, #0x48]",
        "cbnz x2, 0x4"], [0], [], false)
    selfExpect("aarch64", ["str w0, [sp, #0x54]", "ldr x2, [sp, #0x50]", "cbnz x2, 0x3"], [0], [],
        true)
    selfExpect("aarch64", ["str x0, [sp, #0x50]", "ldr x2, [sp, #0x48]", "cbnz x2, 0x3"], [0], [],
        false)
    selfExpect("aarch64", ["str x0, [sp, #0x50]", "strb w1, [sp, #0x50]", "ldrb w2, [sp, #0x51]",
        "cbnz x2, 0x4"], [0], [], true)
    selfExpect("aarch64", ["str x0, [sp, #0x50]", "strb w1, [sp, #0x50]", "ldrb w2, [sp, #0x50]",
        "cbnz x2, 0x4"], [0], [], false)
    println("ok   checker: AArch64 immediates and stack aliases")

    // Public pointers to secret memory retain their provenance across stack spills.
    selfExpect("x86_64", ["movq %rdi, -0x8(%rsp)", "movq -0x8(%rsp), %rax", "movl (%rax), %eax",
        "testl %eax, %eax", "je 0x5"], [], [0], true)
    selfExpect("x86_64", ["movq %rdi, -0x8(%rsp)", "movq %rsi, -0x8(%rsp)", "movq -0x8(%rsp), %rax",
        "movl (%rax), %eax", "testl %eax, %eax", "je 0x6"], [], [0], true)
    selfExpect("x86_64", ["movq %rdi, -0x8(%rsp)", "movb %sil, -0x8(%rsp)", "movq -0x8(%rsp), %rax",
        "movl (%rax), %eax", "testl %eax, %eax", "je 0x6"], [], [0], true)
    selfExpect("x86_64", ["movq %rdi, %rbp", "movl (%rbp), %eax", "testl %eax, %eax", "je 0x4"], [],
        [0], true)
    selfExpect("aarch64", ["str x0, [sp]", "ldr x1, [sp]", "ldr w1, [x1]", "cbz w1, 0x4"], [], [0],
        true)
    selfExpect("aarch64", ["str x0, [sp, #0x50]", "str x1, [sp, #0x50]", "ldr x2, [sp, #0x50]",
        "ldr w3, [x2]", "cbz w3, 0x5"], [], [0], true)
    selfExpect("aarch64", ["stp x0, x1, [sp, #0x48]", "ldp x2, x3, [sp, #0x48]", "ldr w4, [x2]",
        "cbz w4, 0x4"], [], [0], true)
    selfExpect("aarch64", ["mov x29, x0", "ldr w1, [x29]", "cbz w1, 0x3"], [], [0], true)
    println("ok   checker: secret-pointer spills and general-purpose frame registers")

    // Unknown non-stack memory may alias secret storage even if pointer provenance was lost.
    selfExpect("x86_64", ["movl (%rsi), %eax", "testl %eax, %eax", "je 0x3"], [], [0], true)
    selfExpect("aarch64", ["ldr w1, [x2]", "cbz w1, 0x2"], [], [0], true)
    selfExpect("xtensa", ["s32i a2, a1, 0", "l32i a4, a1, 0", "l32i a5, a4, 0", "beqz a5, 0x4"], [],
        [0], true)
    println("ok   checker: conservative loads and Xtensa pointer spill")

    // Wasm linear memory has no shadow stack cells here: a loaded value is secret, so a spilled pointer can't become a
    // public address; loading a secret value is fine when it is returned without controlling flow.
    val wasmSpill = ["global.get 0", "local.get 0", "i32.store", "global.get 0", "i32.load",
        "i32.load", "return"]
    if (selfRun("wasm", selfLines(wasmSpill, ""), [],
        [0]) == "") selfFail("missed Wasm spilled pointer")
    val returned = selfRun("wasm", selfLines(["local.get 0", "i32.load", "return"], ""), [], [0])
    if (returned != "") selfFail("a loaded secret that is only returned: $returned")
    println("ok   checker: Wasm linear-memory spill fails closed")

    // Changing SP or switching between frame and stack bases must not hide spills.
    selfExpect("x86_64", ["movq %rdi, -0x8(%rsp)", "subq $0x10, %rsp", "movq 0x8(%rsp), %rax",
        "movl (%rax), %eax", "testl %eax, %eax", "je 0x6"], [], [0], true)
    selfExpect("x86_64", ["movq %rsp, %rbp", "movq %rdi, -0x8(%rsp)", "movq -0x8(%rbp), %rax",
        "movl (%rax), %eax", "testl %eax, %eax", "je 0x6"], [], [0], true)
    selfExpect("aarch64", ["str x0, [sp, #0x10]", "sub sp, sp, #0x10", "ldr x1, [sp, #0x20]",
        "ldr w2, [x1]", "cbz w2, 0x5"], [], [0], true)
    selfExpect("aarch64", ["mov x29, sp", "str x0, [sp, #0x10]", "ldr x1, [x29, #0x10]",
        "ldr w2, [x1]", "cbz w2, 0x5"], [], [0], true)
    println("ok   checker: changing stack and frame aliases")

    selfExpect("xtensa", ["s32i a2, a1, 0", "addi a1, a1, -16", "l32i a4, a1, 16", "l32i a5, a4, 0",
        "beqz a5, 0x5"], [], [0], true)
    println("ok   checker: Xtensa changing stack aliases")

    // The pointer value itself remains public when a precise stack spill is reloaded.
    selfExpect("x86_64", ["movq %rdi, -0x8(%rsp)", "movq -0x8(%rsp), %rax", "testq %rax, %rax",
        "je 0x4"], [], [0], false)
    selfExpect("aarch64", ["str x0, [sp]", "ldr x1, [sp]", "cbz x1, 0x3"], [], [0], false)
    selfExpect("xtensa", ["s32i a2, a1, 0", "l32i a4, a1, 0", "beqz a4, 0x3"], [], [0], false)
    println("ok   checker: spilled pointer values remain public")

    // Pointer provenance must not hide a secret offset used in an address.
    selfExpect("x86_64", ["leaq (%rdi,%rsi), %rax", "movl (%rax), %eax"], [1], [0], true)
    selfExpect("aarch64", ["add x2, x0, x1", "ldr w3, [x2]"], [1], [0], true)
    selfExpect("xtensa", ["add a5, a2, a4", "l32i a6, a5, 0"], [1], [0], true)
    if (selfRun("wasm", selfLines(["local.get 0", "global.set 0", "return"], ""), [], [0]) == "") {
        selfFail("missed Wasm secret-pointer global store")
    }
    println("ok   checker: secret pointer offsets and Wasm globals")

    selfExpect("x86_64", ["pushq %rdi", "movq (%rsp), %rax", "movl (%rax), %eax",
        "testl %eax, %eax", "je 0x5"], [], [0], true)
    selfExpect("x86_64", ["pushq %rdi", "movq (%rsp), %rax", "testq %rax, %rax", "je 0x4"], [0], [],
        true)
    println("ok   checker: pushed secret pointers and data")
    if (selfFailures > 0) 1 else 0
}
