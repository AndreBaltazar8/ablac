// Fuzzing of abla/http/h2 (the sans-IO HTTP/2 pieces; H2Client joins when it exists), deterministic from a seed, no sockets.
// HPACK, per run:
//   roundtrip  random header lists (credentials, long and short values, repeated names, binary bytes) through an encoder and
//              a decoder whose table sizes change between blocks (setPeerTableSize): every list must come back equal, both
//              tables must agree in size, credential names must come back marked sensitive and must never be in the table
//   mutate     a valid block with one change (a byte flipped, inserted, removed, truncated, a run repeated): the decoder may
//              accept or refuse, but must not panic, never exceed its limits (fields, list bytes, table bytes) and, once it
//              refused, must refuse every later block
//   random     a block of random bytes, and one made of random HPACK instruction prefixes: same rules
// A finding is a violated rule, a run that takes too long (quadratic cost), or a crash (a panic ends the program: the seed is
// H2Client, per run: a valid server script (SETTINGS, responses, data, trailers, resets, window updates, pings, GOAWAY), a mutated one or random frames, delivered in
// random pieces with time moving: no panic, each stream ends once, at most one CLOSED, no more streams than the limit, nothing queued after the end.
// printed before each run with --verbose). Usage: fuzz <first seed> <count> [--verbose]
import "abla/io"
import "abla/crypto"
import "abla/integer"
import "abla/process/arguments"
import "abla/http/h2/hpack"
import "abla/http"
import "abla/http/h2"
import "abla/http/h2/server"

var choiceState = 1

fun nextChoice(): int {
    choiceState = (choiceState * 6364136223846793005 + 1442695040888963407)
    (choiceState >> 33) & 2147483647
}

fun below(limit: int): int = if (limit <= 0) 0 else nextChoice() % limit

var failures = 0
val coverageLabels: array<string> = []
val coverageCounts: array<int> = []

fun cover(label: string): void {
    for (i in 0 until coverageLabels.size) {
        if (coverageLabels[i] == label) {
            coverageCounts[i] = coverageCounts[i] + 1
            return
        }
    }
    coverageLabels.append(label)
    coverageCounts.append(1)
    return
}

fun finding(seed: int, what: string): void {
    failures = failures + 1
    if (failures < 20) println("FINDING seed $seed: $what")
    return
}

fun randomText(maximum: int, binary: bool): string {
    val count = below(maximum + 1)
    val bytes: array<int> = []
    for (i in 0 until count) bytes.append(if (binary) below(256) else 97 + below(26))
    cryptoByteString(bytes)
}

val NAMES: array<string> = [":method", ":path", ":authority", "cookie", "authorization", "user-agent", "accept", "x-a", "x-b", "x-c", "content-type", "set-cookie", "x-token"]

fun randomFields(): array<HpackField> {
    val fields: array<HpackField> = []
    val count = 1 + below(12)
    for (i in 0 until count) {
        var name = NAMES[below(NAMES.size)]
        if (below(5) == 0) name = "x-" + randomText(12, false)
        val value = if (below(4) == 0) randomText(300, true) else randomText(20, false)
        fields.append(HpackField(name, value, below(8) == 0))
    }
    fields
}

fun isSecret(name: string): bool = name == "cookie" || name == "authorization" || name == "set-cookie" || name == "x-token"

fun roundtrip(seed: int): void {
    var encoder = hpackEncoderNew(4096, ["x-token"])
    var decoder = hpackDecoderNew(4096, 65536, 16384, 256)
    var blocks = 1 + below(6)
    for (b in 0 until blocks) {
        if (below(3) == 0) {
            val size = below(5000)
            encoder.setPeerTableSize(size)
            // The decoder's advertised size is 4096: a peer size above it is capped by the encoder (cap 4096).
        }
        val fields = randomFields()
        val block = encoder.encode(fields)
        val got = decoder.decode(block)
        if (!got.ok) {
            finding(seed, "a block the encoder made was refused: ${got.error}")
            return
        }
        if (got.fields.size != fields.size) {
            finding(seed, "roundtrip count")
            return
        }
        for (i in 0 until fields.size) {
            if (got.fields[i].name != fields[i].name || got.fields[i].value != fields[i].value) {
                finding(seed, "roundtrip field $i")
                return
            }
            if ((isSecret(fields[i].name) || fields[i].sensitive) && !got.fields[i].sensitive) finding(seed, "a secret came back unmarked: ${fields[i].name}")
        }
        if (encoder.tableBytes() != decoder.tableBytes()) {
            finding(seed, "tables differ: ${encoder.tableBytes()} vs ${decoder.tableBytes()}")
            return
        }
    }
    return
}

fun mutate(block: string): string {
    if (block.size == 0) return block
    val at = below(block.size)
    val kind = below(6)
    if (kind == 0) return block.slice(0, at) + cryptoByteString([below(256)]) + block.slice(at + 1, block.size)
    if (kind == 1) return block.slice(0, at) + cryptoByteString([below(256)]) + block.slice(at, block.size)
    if (kind == 2) return block.slice(0, at) + block.slice(at + 1, block.size)
    if (kind == 3) return block.slice(0, at)
    if (kind == 4) {
        val end = at + below(block.size - at) + 1
        return block.slice(0, end) + block.slice(at, end) + block.slice(end, block.size)
    }
    block.slice(0, at) + cryptoByteString([255, 255, 255, 255, 127]) + block.slice(at, block.size)
}

fun check(seed: int, decoder: HpackDecoder, got: HpackBlock, tableLimit: int, what: string): void {
    if (decoder.tableBytes() > tableLimit) finding(seed, "$what: the table grew past its limit: ${decoder.tableBytes()}")
    if (got.ok) {
        if (got.fields.size > 256) finding(seed, "$what: more fields than the limit")
        var total = 0
        for (f in got.fields) total = total + f.name.size + f.value.size + 32
        if (total > 65536) finding(seed, "$what: a list past its limit: $total")
    }
    return
}

fun mutated(seed: int): void {
    var encoder = hpackEncoderNew(4096)
    var decoder = hpackDecoderNew(4096, 65536, 16384, 256)
    // Warm the tables with a valid block or two, then feed a mutated one.
    val warm = decoder.decode(encoder.encode(randomFields()))
    if (!warm.ok) {
        finding(seed, "warm block refused")
        return
    }
    val block = mutate(encoder.encode(randomFields()))
    val got = decoder.decode(block)
    check(seed, decoder, got, 4096, "mutated")
    if (!got.ok) {
        // Once refused, refused for good.
        val again = decoder.decode(encoder.encode(randomFields()))
        if (again.ok) finding(seed, "a decoder that failed accepted a later block")
    }
    return
}

fun randomBlock(seed: int): void {
    var decoder = hpackDecoderNew(4096, 65536, 16384, 256)
    // Pure random bytes.
    val noise = randomText(600, true)
    val got = decoder.decode(noise)
    check(seed, decoder, got, 4096, "random")
    // Random instruction prefixes with plausible lengths: more of the block is parsed before it fails.
    var decoder2 = hpackDecoderNew(4096, 65536, 16384, 256)
    val pieces: array<int> = []
    val count = 1 + below(40)
    for (i in 0 until count) {
        val kind = below(5)
        if (kind == 0) pieces.append(128 + below(128))
        else if (kind == 1) pieces.append(64 + below(64))
        else if (kind == 2) pieces.append(below(32))
        else if (kind == 3) pieces.append(32 + below(32))
        else pieces.append(below(256))
    }
    val got2 = decoder2.decode(cryptoByteString(pieces))
    check(seed, decoder2, got2, 4096, "prefixes")
    return
}


// ---- H2Client ----
fun fuzzFrame(kind: int, flags: int, stream: int, payload: string): string {
    val n = payload.size
    cryptoByteString([(n >> 16) & 255, (n >> 8) & 255, n & 255, kind, flags, (stream >> 24) & 127, (stream >> 16) & 255, (stream >> 8) & 255, stream & 255]) + payload
}

fun fuzzBe32(value: int): string = cryptoByteString([(value >> 24) & 255, (value >> 16) & 255, (value >> 8) & 255, value & 255])

/** A plausible server conversation for requests on streams 1, 3, 5: SETTINGS, responses, data, trailers, resets, window updates, pings, a goaway. */
fun serverScript(): string {
    var encoder = hpackEncoderNew(4096)
    var out = fuzzFrame(4, 0, 0, if (below(2) == 0) "" else cryptoByteString([0, 3, 0, 0, 0, 1 + below(5), 0, 4, 0, 0, below(256), below(256)]))
    val pieces = 2 + below(12)
    for (i in 0 until pieces) {
        val stream = 1 + 2 * below(3)
        val kind = below(9)
        if (kind == 0) {
            out = out + fuzzFrame(1, 4 | below(2), stream, encoder.encode([HpackField(":status", if (below(5) == 0) "103" else "200", false), HpackField("x-a", randomText(30, false), false)]))
        } else if (kind == 1) {
            out = out + fuzzFrame(0, below(2) | 0, stream, randomText(2000, true))
        } else if (kind == 2) {
            out = out + fuzzFrame(3, 0, stream, fuzzBe32(below(14)))
        } else if (kind == 3) {
            out = out + fuzzFrame(8, 0, if (below(2) == 0) 0 else stream, fuzzBe32(1 + below(100000)))
        } else if (kind == 4) {
            out = out + fuzzFrame(6, below(2), 0, "12345678")
        } else if (kind == 5) {
            out = out + fuzzFrame(4, below(2), 0, if (below(2) == 0) "" else cryptoByteString([0, 4, 0, 0, below(2), below(256)]))
        } else if (kind == 6) {
            out = out + fuzzFrame(1, below(2), stream, encoder.encode([HpackField("x-trailer", "1", false)]))
        } else if (kind == 7) {
            out = out + fuzzFrame(2, 0, stream, "12345")
        } else {
            out = out + fuzzFrame(7, 0, 0, fuzzBe32(below(8)) + fuzzBe32(below(3)))
        }
    }
    out
}

fun randomFrames(): string {
    var out = fuzzFrame(4, 0, 0, "")
    val count = 1 + below(20)
    for (i in 0 until count) {
        val length = if (below(4) == 0) below(40) else below(10)
        out = out + fuzzFrame(below(12), below(256), if (below(3) == 0) 0 else below(8), randomText(length, true))
    }
    out
}

fun checkClient(seed: int, var client: H2Client, var ended: array<int>, what: string): void {
    var closed = 0
    for (e in client.takeEvents()) {
        cover("client event " + (if (e.kind == H2_EVENT_HEADERS) "headers" else if (e.kind == H2_EVENT_DATA) "data" else if (e.kind == H2_EVENT_END) "end" else if (e.kind == H2_EVENT_RESET) "reset: " + e.error else if (e.kind == H2_EVENT_GOAWAY) "goaway" else "closed: " + e.error))
        if (e.kind == H2_EVENT_END || e.kind == H2_EVENT_RESET) {
            for (id in ended) {
                if (id == e.stream) finding(seed, "$what: stream ${e.stream} ended twice")
            }
            ended.append(e.stream)
        }
        if (e.kind == H2_EVENT_CLOSED) closed = closed + 1
        if (e.kind == H2_EVENT_DATA && e.data.size > 16384) finding(seed, "$what: a data event over the frame size")
    }
    if (closed > 1) finding(seed, "$what: closed more than once")
    if (client.openStreams() > 100) finding(seed, "$what: more streams than the limit")
    return
}

fun clientRun(seed: int): void {
    var client = h2ClientNew(100, 100000)
    client.takeOutput()
    var ended: array<int> = []
    val mode = below(3)
    for (r in 0 until 3) client.request("GET", "https", "example.com", "/", [], if (r == 2) randomText(70000, true) else "")
    var input = if (mode == 0) randomFrames() else serverScript()
    if (mode == 2) input = mutate(input)
    // Delivered in random pieces, with time moving and the output taken between.
    var at = 0
    var now = 0
    while (at < input.size) {
        val take = 1 + below(if (below(2) == 0) 40 else 3000)
        val end = if (at + take > input.size) input.size else at + take
        client.feed(input.slice(at, end), now)
        at = end
        now = now + below(300)
        client.tick(now)
        val act = below(24)
        if (act == 0) client.cancel(1 + 2 * below(4))
        if (act == 1) client.ping(now)
        if (act == 2) client.request("POST", "https", "example.com", "/x", [], randomText(500, true))
        if (act == 3) client.shutdown()
        if (act == 4) client.broken("fuzz")
        if (client.takeOutput().size > 2000000) finding(seed, "output past what two megabytes of work explain")
        checkClient(seed, client, ended, "run")
    }
    if (client.isClosed()) cover("client ended closed")
    if (client.isClosed()) {
        // Nothing more is accepted and nothing is queued after the end.
        client.feed(serverScript(), now)
        if (client.takeOutput().size > 0) finding(seed, "output after the connection closed")
    }
    return
}

// ---- H2Server ----
/** A plausible client conversation: preface, SETTINGS, requests (with bodies, trailers), resets, window updates, pings, priorities. */
fun clientScript(): string {
    var encoder = hpackEncoderNew(4096)
    var out = H2_PREFACE + fuzzFrame(4, 0, 0, if (below(2) == 0) "" else cryptoByteString([0, 4, 0, 0, below(256), below(256)]))
    var next = 1
    val pieces = 2 + below(14)
    for (i in 0 until pieces) {
        val kind = below(8)
        if (kind <= 2) {
            val fields: array<HpackField> = [HpackField(":method", if (below(3) == 0) "POST" else "GET", false), HpackField(":scheme", "https", false), HpackField(":path", "/" + randomText(10, false), false), HpackField(":authority", "x.test", false), HpackField("x-a", randomText(30, false), false)]
            out = out + fuzzFrame(1, 4 | below(2), next, encoder.encode(fields))
            if (below(2) == 0) out = out + fuzzFrame(0, below(2), next, randomText(500, true))
            next = next + 2
        } else if (kind == 3) {
            out = out + fuzzFrame(3, 0, 1 + 2 * below(next), fuzzBe32(below(14)))
        } else if (kind == 4) {
            out = out + fuzzFrame(8, 0, if (below(2) == 0) 0 else 1 + 2 * below(next), fuzzBe32(1 + below(100000)))
        } else if (kind == 5) {
            out = out + fuzzFrame(6, below(2), 0, "12345678")
        } else if (kind == 6) {
            out = out + fuzzFrame(1, 5, 1 + 2 * below(next), encoder.encode([HpackField("x-trailer", "1", false)]))
        } else {
            out = out + fuzzFrame(2, 0, 1 + 2 * below(next), "12345")
        }
    }
    out
}

fun serverRun(seed: int): void {
    var server = h2ServerNew(4, 100000)
    server.takeOutput()
    var answered: array<int> = []
    val mode = below(3)
    var input = if (mode == 0) H2_PREFACE + randomFrames() else clientScript()
    if (mode == 2) input = mutate(input)
    var at = 0
    var now = 0
    while (at < input.size) {
        val take = 1 + below(if (below(2) == 0) 40 else 3000)
        val end = if (at + take > input.size) input.size else at + take
        server.feed(input.slice(at, end), now)
        at = end
        now = now + below(300)
        server.tick(now)
        for (r in server.takeRequests()) {
            cover("server request " + r.request.method)
            for (id in answered) {
                if (id == r.stream) finding(seed, "stream ${r.stream} delivered twice")
            }
            answered.append(r.stream)
            if (below(4) != 0) server.respond(r.stream, 200 + below(5), [HttpHeader("X-B", randomText(20, false))], randomText(70000, false))
        }
        if (below(12) == 0) server.shutdown()
        if (server.takeOutput().size > 4000000) finding(seed, "output past what the input explains")
        if (server.openStreams() > 4) finding(seed, "more streams than the limit: ${server.openStreams()}")
    }
    cover("server ended: " + (if (server.isClosed()) server.reason() else "open"))
    if (server.isClosed()) {
        server.feed(clientScript(), now)
        if (server.takeOutput().size > 0) finding(seed, "output after the connection closed")
    }
    return
}
fun main: int {
    val firstArg = processArgument(0).parseInt()
    val countArg = processArgument(1).parseInt()
    if (firstArg == null || countArg == null) return 2
    val first: int = firstArg
    val count: int = countArg
    val verbose = processArgumentCount() > 2 && processArgument(2) == "--verbose"
    for (seed in first until first + count) {
        choiceState = seed * 2654435761 + 12345
        if (verbose) println("seed $seed")
        roundtrip(seed)
        mutated(seed)
        randomBlock(seed)
        clientRun(seed)
        serverRun(seed)
    }
    println("coverage: ${coverageLabels.size} outcomes")
    for (i in 0 until coverageLabels.size) println("  ${coverageCounts[i]} ${coverageLabels[i]}")
    if (failures == 0) println("http2-fuzz ok: seeds $first..${first + count - 1}")
    failures
}
