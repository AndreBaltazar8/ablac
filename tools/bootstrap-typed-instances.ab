// Built by tools/build-self-hosted-current.sh with the compiler it starts
// from: exits 42 only when that compiler makes typed instances (a field's
// place and its class's descriptor, docs/bootstrap.md). The runtime traps on
// the field count an older compiler passes instead.
class BootstrapTypedInstance(val word: int, val flag: bool, val text: string)

fun main: int {
    val instance = BootstrapTypedInstance(40, true, "typed")
    if (instance.flag && instance.text == "typed") instance.word + 2 else 0
}
