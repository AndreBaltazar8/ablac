// Our side of the TLS handshake differential (tools/tls-diff, #1139 area 3): abla/tls/pure listening on 127.0.0.1:PORT, one connection at a time with a short
// deadline for the handshake, no output, until it is killed. Arguments: the certificate (PEM), the key (PEM), the port, and optionally "hold" and a client CA file.
// With "hold", after a handshake that succeeds it reads until 450 ms pass without data (so the client's post-handshake messages are processed, for
// tools/tls-diff/cflight.ab) before closing. With a client CA, client certificates are required and checked against it.
import "abla/io"
import "abla/integer"
import "abla/process/arguments"
import "abla/tls/pure"

fun main: int {
    val port = processArgument(2).parseInt() ?? 0
    val hold = processArgumentCount() > 3 && processArgument(3) == "hold"
    val clientCa = if (processArgumentCount() > 4) processArgument(4) else ""
    val listener = if (clientCa == "") tlsListen(processArgument(0), processArgument(1), "127.0.0.1", port, 64, false)
        else tlsListenWithClientCa(processArgument(0), processArgument(1), clientCa, "127.0.0.1", port, 64, false, true)
    if (listener.handle == -1) {
        println("FAIL listen: ${tlsLastError()}")
        return 1
    }
    println("listening $port")
    while (true) {
        val connection = listener.accept(400, 400)
        if (connection.handle != -1) {
            if (hold) {
                connection.setTimeouts(450, 450)
                var seen = connection.read(4096)
                while (seen.size > 0) seen = connection.read(4096)
            }
            connection.close()
        }
    }
    0
}
