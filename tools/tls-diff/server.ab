// Our side of the TLS handshake differential (tools/tls-diff, #1139 area 3): abla/tls/pure listening on 127.0.0.1:PORT, one connection at a time with
// a short deadline for the handshake, no output, until it is killed. Arguments: the certificate (PEM), the key (PEM), the port.
import "abla/io"
import "abla/integer"
import "abla/process/arguments"
import "abla/tls/pure"

fun main: int {
    val port = processArgument(2).parseInt() ?? 0
    val listener = tlsListen(processArgument(0), processArgument(1), "127.0.0.1", port, 64, false)
    if (listener.handle == -1) {
        println("FAIL listen: ${tlsLastError()}")
        return 1
    }
    println("listening $port")
    while (true) {
        val connection = listener.accept(400, 400)
        if (connection.handle != -1) connection.close()
    }
    0
}
