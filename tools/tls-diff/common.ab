// What the two halves of the TLS handshake differential share (tools/tls-diff): an extension as a type, a body and a length error, and the byte helpers.
import "abla/bytes"
import "abla/crypto"
import "../fuzz/prng.ab"

class DiffExt(var type: int, var body: string, var delta: int)

fun diffBytes(var r: Prng, count: int): string {
    var out = byteBuffer()
    for (i in 0 until count) out.appendByteValue(r.below(256))
    out.toText()
}

fun diffPickInt(var r: Prng, values: array<int>): int = values[r.below(values.size)]

fun diffU16(value: int): string = cryptoByteString([(value >> 8) & 255, value & 255])

fun diffRd16(data: string, at: int): int = data[at] * 256 + data[at + 1]

fun diffInsert(list: array<DiffExt>, index: int, item: DiffExt): array<DiffExt> {
    val out: array<DiffExt> = []
    for (i in 0 until list.size) {
        if (i == index) out.append(item)
        out.append(list[i])
    }
    if (index >= list.size) out.append(item)
    out
}

fun diffReverse(list: array<DiffExt>): array<DiffExt> {
    val out: array<DiffExt> = []
    var i = list.size - 1
    while (i >= 0) {
        out.append(list[i])
        i = i - 1
    }
    out
}
