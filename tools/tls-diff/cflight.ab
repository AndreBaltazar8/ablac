// The client-flight side of the TLS handshake differential (#1139 area 3, TLS round 3): a hostile TLS 1.3 client that does a real handshake. It connects COUNT times
// in a row to 127.0.0.1:PORT, sends a ClientHello (X25519, AES-128-GCM), reads the server's flight (it decrypts it, to keep the transcript), and sends its own flight
// changed structurally by a generator seeded by (SEED, i): the Finished (wrong, short, long, empty, a header length that does not match, another type, twice, left out),
// records that may not be there before it (plaintext alert / handshake / application data, change_cipher_spec twice or malformed, encrypted CCS / alert / unknown inner
// type / empty handshake record / a record with no content type), the Finished cut over records or padded, a record with a flipped byte, a wrong sequence number, and,
// after a valid Finished, post-handshake messages under the application keys (KeyUpdate with every value, a NewSessionTicket, CertificateRequest, Certificate, unknown
// types, a Finished again, alerts, change_cipher_spec, empty and large application data, a message cut over records).
// What the server does is read off the wire by decrypting its records: A<n> (an alert, description n: it refused), C (it closed), ok (nothing refused within the
// window, after a probe of valid application data). One line per connection, "CASE i tags class", for tools/tls-diff to join across the servers.
//
//   cflight PORT SEED COUNT [DUMP_INDEX]
import "abla/io"
import "abla/text"
import "abla/array"
import "abla/bytes"
import "abla/crypto"
import "abla/crypto/hkdf"
import "abla/integer"
import "abla/net"
import "abla/process/arguments"
import "abla/tls/pure/handshake"
import "abla/tls/pure/keysched"
import "abla/tls/pure/record"
import "abla/tls/pure/client"
import "../fuzz/prng.ab"
import "./common.ab"

var cfGenerator: Prng = prngSeeded(1)

fun cfRandom(count: int): string = diffBytes(cfGenerator, count)

fun cfHeader(type: int, body: string, delta: int): string =
    cryptoByteString([type, ((body.size + delta) >> 16) & 255, ((body.size + delta) >> 8) & 255, (body.size + delta) & 255]) + body

fun cfPick(var r: Prng, values: array<string>): string = values[r.below(values.size)]

fun cfSplit(var r: Prng, data: string, mode: int): array<string> {
    val out: array<string> = []
    if (mode == 0 || data.size == 0) {
        out.append(data)
        return out
    }
    var at = 0
    while (at < data.size) {
        var size = 1
        if (mode == 2) size = 1 + r.below(data.size - at)
        if (at + size > data.size) size = data.size - at
        out.append(data.slice(at, at + size))
        at = at + size
    }
    out
}

/** The server's reaction in the next `milliseconds`: records are opened under `protection` (a KeyUpdate from the server rekeys it; tickets are ignored). */
fun cfReaction(var connection: TcpConnection, var protection: TlsRecordProtection, milliseconds: int): string {
    var got = ""
    var closed = false
    var rounds = 0
    while (rounds < 4) {
        val incoming = connection.readWithTimeoutResult(65536, milliseconds)
        if (incoming.hasData()) got = got + incoming.bytes
        else {
            if (!incoming.timedOut()) closed = true
            rounds = 4
        }
        rounds = rounds + 1
    }
    var at = 0
    while (at + 5 <= got.size) {
        val length = diffRd16(got, at + 3)
        if (at + 5 + length > got.size) break
        val type = got[at]
        if (type == 21) return if (length >= 2) "A${got[at + 6]}" else "A?"
        if (type == 23) {
            val opened = tlsOpenRecord(protection, got.slice(at, at + 5 + length))
            if (!opened.ok) return "BAD"
            if (opened.type == 21) return if (opened.content.size >= 2) "A${opened.content[1]}" else "A?"
        }
        at = at + 5 + length
    }
    if (closed) "C" else "ok"
}

fun cfTicket(good: bool): string =
    cfHeader(4, "\x00\x00\x1c\x20\x00\x00\x00\x00\x01\x00" + diffU16(4) + "tick" + diffU16(0), 0)

fun main: int {
    if (processArgumentCount() < 3) {
        println("usage: cflight PORT SEED COUNT")
        return 2
    }
    val port = processArgument(0).parseInt() ?? 0
    val seed = processArgument(1).parseInt() ?? 1
    val count = processArgument(2).parseInt() ?? 1
    val hash = HKDF_SHA256
    for (i in 0 until count) {
        var r = prngSeeded(seed * 100003 + i)
        cfGenerator = prngSeeded(seed * 7919 + i)
        var connection = tcpConnect(ipv4Loopback(port), 1000)
        if (connection.descriptor < 0) {
            println("CASE $i connect R")
            continue
        }
        val pair = tlsGenerateKeyPair(29, cfRandom) ?? continue
        val sessionId = cfRandom(32)
        val hello = tlsBuildClientHello(cfRandom(32), sessionId, [4865], "localhost", [29], [TlsKeyShare(29, pair.publicKey)], [0x0403, 0x0804], [], "")
        connection.write(tlsPlaintextRecord(22, 771, hello))
        // The ServerHello (plaintext), then the encrypted flight.
        var got = ""
        var transcript = tlsTranscript()
        transcript.add(hello)
        var state = 0
        var read: TlsRecordProtection = tlsRecordProtection(TLS_AEAD_AES_128_GCM, "", "")
        var write: TlsRecordProtection = tlsRecordProtection(TLS_AEAD_AES_128_GCM, "", "")
        var secrets = TlsHandshakeSecrets("", "", "")
        var pending = ""
        var finishedSeen = false
        var tries = 0
        var failed = ""
        while (!finishedSeen && failed == "" && tries < 20) {
            tries = tries + 1
            val incoming = connection.readWithTimeoutResult(65536, if (tries == 1) 2500 else 400)
            if (!incoming.hasData()) {
                failed = if (incoming.timedOut()) "W" else "C"
                break
            }
            got = got + incoming.bytes
            while (got.size >= 5 && !finishedSeen && failed == "") {
                val length = diffRd16(got, 3)
                if (got.size < 5 + length) break
                val record = got.slice(0, 5 + length)
                got = got.slice(5 + length, got.size)
                if (record[0] == 20) continue
                if (record[0] == 21) {
                    failed = "A${if (record.size > 6) record[6] else 0}"
                    break
                }
                if (state == 0 && record[0] == 22) {
                    val serverHello = tlsParseServerHello(record.slice(9, record.size))
                    if (!serverHello.ok || serverHello.retryRequest) {
                        failed = "nohello"
                        break
                    }
                    transcript.add(record.slice(5, record.size))
                    val shared = tlsAgree(pair, serverHello.shareKey)
                    if (!shared.ok) {
                        failed = "noshare"
                        break
                    }
                    secrets = tlsDeriveHandshakeSecrets(hash, tlsEarlySecret(hash, ""), shared.bytes, transcript.hash(hash))
                    read = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(hash, secrets.serverTraffic, 16), tlsTrafficIv(hash, secrets.serverTraffic))
                    write = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(hash, secrets.clientTraffic, 16), tlsTrafficIv(hash, secrets.clientTraffic))
                    state = 1
                } else if (state == 1 && record[0] == 23) {
                    val opened = tlsOpenRecord(read, record)
                    if (!opened.ok || opened.type != 22) {
                        failed = "badflight"
                        break
                    }
                    pending = pending + opened.content
                    while (pending.size >= 4 && 4 + (pending[1] * 65536 + pending[2] * 256 + pending[3]) <= pending.size) {
                        val size = 4 + (pending[1] * 65536 + pending[2] * 256 + pending[3])
                        val message = pending.slice(0, size)
                        pending = pending.slice(size, pending.size)
                        if (message[0] == 20) {
                            finishedSeen = true
                            break
                        }
                        transcript.add(message)
                    }
                    if (finishedSeen) {
                        // The server's Finished is in the transcript for the client's Finished and the application secrets.
                    }
                } else {
                    failed = "unexpected"
                    break
                }
            }
        }
        if (!finishedSeen) {
            println("CASE $i noflight($failed) W")
            connection.close()
            continue
        }
        // The server Finished: the message is the last one read; add it back (it was not added above).
        val serverFinished = cfHeader(20, tlsFinishedVerifyData(hash, secrets.serverTraffic, transcript.hash(hash)), 0)
        transcript.add(serverFinished)
        val application = tlsDeriveApplicationSecrets(hash, secrets.handshakeSecret, transcript.hash(hash))
        var applicationRead = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(hash, application.serverTraffic, 16), tlsTrafficIv(hash, application.serverTraffic))
        var applicationWrite = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(hash, application.clientTraffic, 16), tlsTrafficIv(hash, application.clientTraffic))
        val verify = tlsFinishedVerifyData(hash, secrets.clientTraffic, transcript.hash(hash))
        // The mutation.
        var tags = ""
        var finishedMode = 0
        var packing = 0
        var padding = 0
        var flipIn = ""
        var sequenceSkip = false
        var postMode = 0
        val before: array<string> = []
        var duplicate = false
        var omit = false
        var typeChange = -1
        var lengthDelta = 0
        var trailing = ""
        var legacyVersion = 771
        val rounds = 1 + (if (r.below(5) == 0) 1 else 0)
        for (k in 0 until rounds) {
            val kind = r.below(28)
            var tag = "?"
            if (kind == 0) { finishedMode = 1 + r.below(5); tag = "fin-$finishedMode" }
            else if (kind == 1) { omit = true; tag = "fin-omitted" }
            else if (kind == 2) { duplicate = true; tag = "fin-twice" }
            else if (kind == 3) { typeChange = diffPickInt(r, [0, 1, 2, 4, 5, 8, 11, 13, 15, 24, 25, 99, 255]); tag = "fin-type-$typeChange" }
            else if (kind == 4) { lengthDelta = diffPickInt(r, [-1, 1, 2, 70000, -32]); tag = "fin-length-$lengthDelta" }
            else if (kind == 5) { packing = 1; tag = "fin-split" }
            else if (kind == 6) { packing = 2; tag = "fin-split-random" }
            else if (kind == 7) { padding = diffPickInt(r, [1, 2, 16, 255, 1000, 16000]); tag = "padding-$padding" }
            else if (kind == 8) { before.append(cfPick(r, ["plain-alert-warning", "plain-alert-fatal", "plain-ccs", "plain-ccs2", "plain-ccs-bad", "plain-handshake", "plain-empty-handshake", "plain-app", "plain-ccs-empty"])); tag = "before-" + before[before.size - 1] }
            else if (kind == 9) { before.append(cfPick(r, ["enc-ccs", "enc-alert-close", "enc-alert-user", "enc-alert-fatal", "enc-alert-short", "enc-alert-long", "enc-unknown-type", "enc-zero-type", "enc-empty-handshake", "enc-app", "enc-empty-app", "enc-certificate-empty", "enc-key-update", "enc-end-of-early-data", "enc-client-hello"])); tag = "before-" + before[before.size - 1] }
            else if (kind == 10) { flipIn = "finished"; tag = "bit-flip" }
            else if (kind == 11) { sequenceSkip = true; tag = "sequence-skip" }
            else if (kind == 12) { trailing = diffBytes(r, 1 + r.below(3)); tag = "fin-trailing" }
            else if (kind == 13) { legacyVersion = diffPickInt(r, [768, 769, 770, 772, 0, 65535]); tag = "record-version-$legacyVersion" }
            else { postMode = 1 + r.below(34); tag = "post-$postMode" }
            tags = tags + (if (k > 0) "+" else "") + tag
        }
        var wire = ""
        for (kind in before) {
            if (kind == "plain-alert-warning") wire = wire + tlsPlaintextRecord(21, 771, "\x01\x00")
            else if (kind == "plain-alert-fatal") wire = wire + tlsPlaintextRecord(21, 771, "\x02\x28")
            else if (kind == "plain-ccs") wire = wire + tlsPlaintextRecord(20, 771, "\x01")
            else if (kind == "plain-ccs2") wire = wire + tlsPlaintextRecord(20, 771, "\x01") + tlsPlaintextRecord(20, 771, "\x01")
            else if (kind == "plain-ccs-bad") wire = wire + tlsPlaintextRecord(20, 771, "\x02")
            else if (kind == "plain-ccs-empty") wire = wire + tlsPlaintextRecord(20, 771, "")
            else if (kind == "plain-handshake") wire = wire + tlsPlaintextRecord(22, 771, cfHeader(14, "", 0))
            else if (kind == "plain-empty-handshake") wire = wire + tlsPlaintextRecord(22, 771, "")
            else if (kind == "plain-app") wire = wire + tlsPlaintextRecord(23, 771, "hello")
            else {
                var content = ""
                var type = 22
                if (kind == "enc-ccs") { type = 20; content = "\x01" }
                else if (kind == "enc-alert-close") { type = 21; content = "\x01\x00" }
                else if (kind == "enc-alert-user") { type = 21; content = "\x01\x5a" }
                else if (kind == "enc-alert-fatal") { type = 21; content = "\x02\x28" }
                else if (kind == "enc-alert-short") { type = 21; content = "\x01" }
                else if (kind == "enc-alert-long") { type = 21; content = "\x01\x00\x00" }
                else if (kind == "enc-unknown-type") { type = 99; content = "x" }
                else if (kind == "enc-zero-type") { type = 0; content = "x" }
                else if (kind == "enc-empty-handshake") { type = 22; content = "" }
                else if (kind == "enc-app") { type = 23; content = "hello" }
                else if (kind == "enc-empty-app") { type = 23; content = "" }
                else if (kind == "enc-certificate-empty") { type = 22; content = cfHeader(11, "\x00\x00\x00\x00", 0) }
                else if (kind == "enc-key-update") { type = 22; content = cfHeader(24, "\x00", 0) }
                else if (kind == "enc-end-of-early-data") { type = 22; content = cfHeader(5, "", 0) }
                else if (kind == "enc-client-hello") { type = 22; content = cfHeader(1, "x", 0) }
                val sealed = tlsProtectRecord(write, type, content, 0)
                if (sealed.ok) wire = wire + sealed.bytes
            }
        }
        var finishedBody = verify
        if (finishedMode == 1 && finishedBody.size > 1) finishedBody = finishedBody.slice(0, finishedBody.size - 1)
        if (finishedMode == 2) finishedBody = finishedBody + "\x00"
        if (finishedMode == 3) finishedBody = cryptoByteString([finishedBody[0] ^ 1]) + finishedBody.slice(1, finishedBody.size)
        if (finishedMode == 4) finishedBody = ""
        if (finishedMode == 5) finishedBody = diffBytes(r, 32)
        var finished = cfHeader(20, finishedBody, lengthDelta)
        if (typeChange >= 0) finished = cryptoByteString([typeChange]) + finished.slice(1, finished.size)
        var data = if (omit) "" else finished
        if (duplicate) data = data + finished
        data = data + trailing
        if (sequenceSkip) write.sequence = write.sequence + 1
        for (piece in cfSplit(r, data, packing)) {
            val sealed = tlsProtectRecord(write, 22, piece, padding)
            if (sealed.ok) {
                var record = sealed.bytes
                if (flipIn == "finished" && record.size > 8) record = record.slice(0, 7) + cryptoByteString([record[7] ^ 1]) + record.slice(8, record.size)
                wire = wire + record
            }
        }
        if (legacyVersion != 771) wire = wire.slice(0, 1) + diffU16(legacyVersion) + wire.slice(3, wire.size)
        connection.write(wire)
        var reaction = cfReaction(connection, applicationRead, 150)
        if (reaction == "ok" && postMode > 0) {
            val records: array<string> = []
            var name = "post"
            var types: array<int> = [22]
            if (postMode == 1) { name = "key-update-0"; records.append(cfHeader(24, "\x00", 0)) }
            else if (postMode == 2) { name = "key-update-1"; records.append(cfHeader(24, "\x01", 0)) }
            else if (postMode == 3) { name = "key-update-2"; records.append(cfHeader(24, "\x02", 0)) }
            else if (postMode == 4) { name = "key-update-empty"; records.append(cfHeader(24, "", 0)) }
            else if (postMode == 5) { name = "key-update-long"; records.append(cfHeader(24, "\x00\x00", 0)) }
            else if (postMode == 6) { name = "key-update-255"; records.append(cfHeader(24, "\xff", 0)) }
            else if (postMode == 7) { name = "ticket"; records.append(cfTicket(true)) }
            else if (postMode == 8) { name = "certificate-request"; records.append(tlsBuildCertificateRequest("", [0x0403])) }
            else if (postMode == 9) { name = "certificate"; records.append(cfHeader(11, "\x00\x00\x00\x00", 0)) }
            else if (postMode == 10) { name = "certificate-verify"; records.append(cfHeader(15, "\x04\x03\x00\x00", 0)) }
            else if (postMode == 11) { name = "unknown-type"; records.append(cfHeader(99, "x", 0)) }
            else if (postMode == 12) { name = "finished-again"; records.append(cfHeader(20, verify, 0)) }
            else if (postMode == 13) { name = "client-hello"; records.append(cfHeader(1, "x", 0)) }
            else if (postMode == 14) { name = "server-hello"; records.append(cfHeader(2, "x", 0)) }
            else if (postMode == 15) { name = "encrypted-extensions"; records.append(cfHeader(8, "\x00\x00", 0)) }
            else if (postMode == 16) { name = "end-of-early-data"; records.append(cfHeader(5, "", 0)) }
            else if (postMode == 17) { name = "empty-handshake-record"; records.append("") }
            else if (postMode == 18) { name = "key-update-split"; records.append(cfHeader(24, "\x00", 0).slice(0, 3)); records.append(cfHeader(24, "\x00", 0).slice(3, 5)) }
            else if (postMode == 19) { name = "key-update-twice"; records.append(cfHeader(24, "\x00", 0) + cfHeader(24, "\x00", 0)) }
            else if (postMode == 20) { name = "key-update-and-ticket"; records.append(cfHeader(24, "\x00", 0) + cfTicket(true)) }
            else if (postMode == 21) { name = "alert-close"; types = [21]; records.append("\x01\x00") }
            else if (postMode == 22) { name = "alert-user-canceled"; types = [21]; records.append("\x01\x5a") }
            else if (postMode == 23) { name = "alert-warning-other"; types = [21]; records.append("\x01\x28") }
            else if (postMode == 24) { name = "alert-fatal"; types = [21]; records.append("\x02\x28") }
            else if (postMode == 25) { name = "alert-short"; types = [21]; records.append("\x01") }
            else if (postMode == 26) { name = "ccs"; types = [20]; records.append("\x01") }
            else if (postMode == 27) { name = "empty-app"; types = [23]; records.append("") }
            else if (postMode == 28) { name = "app-large"; types = [23]; records.append("a".repeat(16384)) }
            else if (postMode == 29) { name = "unknown-inner-type"; types = [99]; records.append("x") }
            else if (postMode == 30) { name = "handshake-then-app"; types = [22, 23]; records.append(cfHeader(24, "\x00", 0)); records.append("hello") }
            else if (postMode == 31) { name = "key-update-then-wrong-key"; records.append(cfHeader(24, "\x00", 0)) }
            else if (postMode == 32) { name = "ticket-twice"; records.append(cfTicket(true) + cfTicket(true)) }
            else if (postMode == 33) { name = "message-hash"; records.append(cfHeader(254, "x", 0)) }
            else { name = "zero-length-handshake-types"; records.append(cfHeader(24, "", 0) + cfHeader(24, "", 0)) }
            var out = ""
            for (k in 0 until records.size) {
                val type = if (types.size > k) types[k] else types[0]
                val sealed = tlsProtectRecord(applicationWrite, type, records[k], 0)
                if (sealed.ok) out = out + sealed.bytes
            }
            connection.write(out)
            if (name.startsWith("key-update")) {
                // The sender's keys move on after a KeyUpdate it sent.
                val next = tlsNextTrafficSecret(hash, application.clientTraffic)
                applicationWrite = tlsRecordProtection(TLS_AEAD_AES_128_GCM, tlsTrafficKey(hash, next, 16), tlsTrafficIv(hash, next))
            }
            tags = tags + "[" + name + "]"
            // A probe of valid application data: a server that took the messages keeps the connection.
            val probe = tlsProtectRecord(applicationWrite, 23, "ping", 0)
            val wrongKey = postMode == 31
            if (probe.ok && !wrongKey) connection.write(probe.bytes)
            val second = cfReaction(connection, applicationRead, 150)
            reaction = "F/" + second
        } else if (reaction == "ok") {
            val probe = tlsProtectRecord(applicationWrite, 23, "ping", 0)
            if (probe.ok) connection.write(probe.bytes)
            reaction = "F/" + cfReaction(connection, applicationRead, 150)
        }
        println("CASE $i $tags $reaction")
        connection.close()
    }
    0
}
