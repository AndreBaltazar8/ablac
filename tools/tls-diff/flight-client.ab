// Our side of the encrypted-flight differential (tools/tls-diff, #1139 area 3, TLS round 3): abla/tls/pure as a client that connects COUNT times in a row to
// 127.0.0.1:PORT (tools/tls-diff/flight-server.ab) as the host "localhost", trusting the CA file CA.PEM (the server's self-signed certificate), so a valid flight is
// accepted and the signature, the Finished and the certificate are all checked. After the handshake it reads for a short while, so the post-handshake messages are
// processed, and closes. The reaction is read off the wire by the server; this program prints nothing.   flight-client PORT COUNT CA.PEM
import "abla/io"
import "abla/net"
import "abla/integer"
import "abla/process/arguments"
import "abla/tls/pure"

fun main: int {
    val port = processArgument(0).parseInt() ?? 0
    val count = processArgument(1).parseInt() ?? 0
    val ca = processArgument(2)
    for (i in 0 until count) {
        var tcp = tcpConnect(ipv4Loopback(port), 1000)
        if (tcp.descriptor < 0) continue
        var connection = tlsUpgrade(tcp, "localhost", ca, 400)
        if (connection.handle != -1) {
            connection.setTimeouts(300, 300)
            connection.read(4096)
            connection.close()
        }
    }
    0
}
