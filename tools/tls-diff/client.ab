// Our side of the ServerHello differential (tools/tls-diff, #1139 area 3): abla/tls/pure as a client that connects COUNT times in a row to 127.0.0.1:PORT (to
// tools/tls-diff/hello-server.ab), each time with a short handshake timeout, and ends the connection however the handshake ends. The reaction is read off the wire
// by the server; this program prints nothing.   client PORT COUNT
import "abla/io"
import "abla/integer"
import "abla/process/arguments"
import "abla/tls/pure"

fun main: int {
    val port = processArgument(0).parseInt() ?? 0
    val count = processArgument(1).parseInt() ?? 0
    for (i in 0 until count) {
        var connection = tlsConnect("127.0.0.1", port, 400)
        if (connection.handle != -1) connection.close()
    }
    0
}
