// Evaluate metadata only, using --emit-llvm: no static LLVM archives or native
// link are required. Import the real entry so new libc modules enter this graph
// through the same imports as the static compiler.
import "../src/orc_main_static.ab" as staticCompiler
import "../src/static_libc_symbol_extras.ab"
import "abla/compiler"
import "abla/io"
import "abla/text"

compile fun staticLibcModule(identity: string): bool =
    identity.startsWith("src/static_libc/") || identity.contains("/src/static_libc/") ||
    identity.startsWith("src/ct_") || identity.contains("/src/ct_") ||
    identity == "src/emutls_export.ab" || identity.endsWith("/src/emutls_export.ab") ||
    identity == "src/live_reload.ab" || identity.endsWith("/src/live_reload.ab")

compile fun staticLibcUnique(names: array<string>): array<string> {
    val result: array<string> = []
    var previous = ""
    for (name in sortedStrings(names)) {
        if (name != previous) result.append(name)
        previous = name
    }
    result
}

compile fun staticLibcPrintArray(name: string, names: array<string>, last: bool = false): void {
    println("//static-libc:fun $name(): array<string> = [")
    for (symbol in names) println("//static-libc:    \"$symbol\",")
    println("//static-libc:]")
    if (!last) println("//static-libc:")
}

compile fun generateStaticLibcSymbols(): void {
    val modules: array<string> = []
    val hosted: array<string> = []
    val functions = compiler.functionsAnnotated("export")
    for (function in compiler.functionsAnnotated("exportChecked")) functions.append(function)
    for (function in compiler.functionsAnnotated("exportLocal")) functions.append(function)
    for (function in functions) {
        val identity = compiler.functionModuleIdentity(function)
        if (staticLibcModule(identity)) modules.append(identity)
        if (identity == "src/static_libc/hosted.ab" ||
            identity.endsWith("/src/static_libc/hosted.ab")) {
            hosted.append(identity)
        }
    }
    if (modules.size == 0 || hosted.size == 0) {
        eprintln("static libc symbols: the static entry's module identities were not found")
        return
    }
    val names: array<string> = []
    for (name in compiler.exportedNames(staticLibcUnique(modules))) {
        // The _Unwind_* stubs intentionally abort, rather than offering a JIT
        // unwinder. abla_libc_* are private implementations of public C aliases.
        if (name.startsWith("abla_libc_")) names.append(name.slice(10, name.size))
        else if (!name.startsWith("_Unwind_")) names.append(name)
    }
    for (name in bootstrapStaticLibcExtraSymbolNames()) names.append(name)
    val table = staticLibcUnique(names)
    for (name in bootstrapStaticLibcLegacyRepeatedNames()) table.append(name)
    println("//static-libc:// Generated by tools/gen-static-libc-symbols.sh; do not edit.")
    println("//static-libc:// Annotation names come from compiler.exportedNames over the static entry's modules.")
    println("//static-libc:// Assembly, data, compiler-rt and legacy repeats: src/static_libc_symbol_extras.ab.")
    println("//static-libc:")
    staticLibcPrintArray("bootstrapStaticLibcSymbolNames", sortedStrings(table))
    val aliases: array<string> = []
    for (name in compiler.exportedNames(staticLibcUnique(hosted))) {
        if (name.startsWith("abla_libc_")) aliases.append(name.slice(10, name.size))
    }
    staticLibcPrintArray("bootstrapStaticLibcAliases", aliases)
    staticLibcPrintArray("bootstrapStaticLibcSymbolsNotOnAarch64",
        bootstrapStaticLibcExtraSymbolsNotOnAarch64(), true)
}

#generateStaticLibcSymbols()

fun main: int = 0
