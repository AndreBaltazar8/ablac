// Signed 256-bit integers: the language's `int256` and what's done with it (docs/stdlib/int256.md).
// Two's complement, as every signed width is: operators wrap, `/` and `%` truncate toward zero, and the one
// quotient too large, the smallest value over -1, wraps to itself with a remainder of 0. The `Checked`
// forms say when a result doesn't fit.
// Not for secrets: comparison and division take a time that depends on the value. abla/ct is for those.

noescape extern:"intrinsic" fun ablaI256NativeMul(): bool
noescape extern:"intrinsic" fun ablaI256_fromU64(value: u64): int256
noescape extern:"intrinsic" fun ablaI256_fromI64(value: i64): int256
noescape extern:"intrinsic" fun ablaI256_toU64(value: int256): u64
noescape extern:"intrinsic" fun ablaI256_not(value: int256): int256
noescape extern:"intrinsic" fun ablaI256_add(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_sub(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_mul(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_udiv(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_urem(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_sdiv(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_srem(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_and(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_or(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_xor(a: int256, b: int256): int256
noescape extern:"intrinsic" fun ablaI256_shl(a: int256, count: u32): int256
noescape extern:"intrinsic" fun ablaI256_lshr(a: int256, count: u32): int256
noescape extern:"intrinsic" fun ablaI256_ashr(a: int256, count: u32): int256
noescape extern:"intrinsic" fun ablaI256_eq(a: int256, b: int256): bool
noescape extern:"intrinsic" fun ablaI256_lt(a: int256, b: int256): bool
noescape extern:"intrinsic" fun ablaI256_slt(a: int256, b: int256): bool
noescape extern:"intrinsic" fun ablaI256NarrowTarget(): bool

// As every widening: a signed source extends its sign, an unsigned one its zeros.
@inline fun int256(value: int): int256 = ablaI256_fromI64(value)
@inline fun int256(value: i32): int256 = ablaI256_fromI64(i64(value))
@inline fun int256(value: i16): int256 = ablaI256_fromI64(i64(value))
@inline fun int256(value: i8): int256 = ablaI256_fromI64(i64(value))
@inline fun int256(value: u64): int256 = ablaI256_fromU64(value)
@inline fun int256(value: u32): int256 = ablaI256_fromU64(u64(value))
@inline fun int256(value: u16): int256 = ablaI256_fromU64(u64(value))
@inline fun int256(value: u8): int256 = ablaI256_fromU64(u64(value))
/** Eight words of its two's complement, most significant first: how to write a constant that doesn't fit an `int`. */
fun int256Words(w7: u32, w6: u32, w5: u32, w4: u32, w3: u32, w2: u32, w1: u32, w0: u32): int256 {
    var out = int256(w7)
    out = ablaI256_or(ablaI256_shl(out, u32(32)), int256(w6))
    out = ablaI256_or(ablaI256_shl(out, u32(32)), int256(w5))
    out = ablaI256_or(ablaI256_shl(out, u32(32)), int256(w4))
    out = ablaI256_or(ablaI256_shl(out, u32(32)), int256(w3))
    out = ablaI256_or(ablaI256_shl(out, u32(32)), int256(w2))
    out = ablaI256_or(ablaI256_shl(out, u32(32)), int256(w1))
    ablaI256_or(ablaI256_shl(out, u32(32)), int256(w0))
}
/** 2^255 - 1. */
fun int256Max(): int256 = ablaI256_lshr(ablaI256_not(int256(0)), u32(1))
/** -2^255. */
fun int256Min(): int256 = ablaI256_shl(int256(1), u32(255))

// What the compiler calls for `==`, `<` and the rest (bootstrapLowerArithmetic), and for "$x".
@inline fun int256Equal(a: int256, b: int256): bool = ablaI256_eq(a, b)
@inline fun int256NotEqual(a: int256, b: int256): bool = !ablaI256_eq(a, b)
@inline fun int256Less(a: int256, b: int256): bool = ablaI256_slt(a, b)
@inline fun int256LessEqual(a: int256, b: int256): bool = !ablaI256_slt(b, a)
@inline fun int256Greater(a: int256, b: int256): bool = ablaI256_slt(b, a)
@inline fun int256GreaterEqual(a: int256, b: int256): bool = !ablaI256_slt(a, b)
fun int256Text(value: int256): string = value.toDecimal()

@inline operator fun int256.plus(other: int256): int256 = ablaI256_add(this, other)
@inline operator fun int256.minus(other: int256): int256 = ablaI256_sub(this, other)
@inline operator fun int256.unaryMinus(): int256 = ablaI256_sub(int256(0), this)
@inline operator fun int256.and(other: int256): int256 = ablaI256_and(this, other)
@inline operator fun int256.or(other: int256): int256 = ablaI256_or(this, other)
@inline operator fun int256.xor(other: int256): int256 = ablaI256_xor(this, other)
@inline operator fun int256.inv(): int256 = ablaI256_not(this)

// One word of a number, least significant first.
private @inline fun int256Word(value: int256,
    index: int): u32 = u32(ablaI256_toU64(ablaI256_lshr(value, u32(index * 32))))

// A word times a word. On a 32-bit target a u64 product calls __muldi3, and four 16-bit products don't.
// Not inlined, or LLVM evaluates the product at the width of what it's added to, and calls __multi3 for it.
private @noinline fun int256WordProduct(a: u32, b: u32): u64 {
    if (!ablaI256NarrowTarget()) return u64(a) * u64(b)
    val aLow = a & u32(65535)
    val aHigh = a >> 16
    val bLow = b & u32(65535)
    val bHigh = b >> 16
    val low = aLow * bLow
    val first = aHigh * bLow + (low >> 16)
    val second = aLow * bHigh + (first & u32(65535))
    (u64(aHigh * bHigh + (first >> 16) + (second >> 16)) << 32) | u64((second << 16) | (low &
        u32(65535)))
}

// Column by column from the top: each step moves what's done up a word and adds the next column.
// The product of two's complements is the same bits whichever sign they stand for, so this is the unsigned one.
private @noinline fun int256MultiplyWords(a: int256, b: int256): int256 {
    var out = int256(0)
    var column = 7
    while (column >= 0) {
        out = ablaI256_shl(out, u32(32))
        for (i in 0 until column + 1) {
            out = ablaI256_add(out, ablaI256_fromU64(int256WordProduct(int256Word(a, i),
                int256Word(b, column - i))))
        }
        column = column - 1
    }
    out
}

@inline operator fun int256.times(other: int256): int256 =
    if (ablaI256NativeMul()) ablaI256_mul(this, other) else int256MultiplyWords(this, other)

// LLVM expands a division to a loop where it's written, so it's written once.
// By zero, the language's own panic: a u32 divided by the zero it's been told about.
private @inline fun int256CheckDivisor(b: int256): void {
    if (ablaI256_eq(b, int256(0))) u32(1) / u32(ablaI256_toU64(b))
}
// The smallest value over -1 wraps to itself, with a remainder of 0, as every width's does.
private @noinline fun int256Divide(a: int256, b: int256): int256 {
    int256CheckDivisor(b)
    if (ablaI256_eq(b, int256(-1))) return ablaI256_sub(int256(0), a)
    ablaI256_sdiv(a, b)
}
private @noinline fun int256Remainder(a: int256, b: int256): int256 {
    int256CheckDivisor(b)
    if (ablaI256_eq(b, int256(-1))) return int256(0)
    ablaI256_srem(a, b)
}
@inline operator fun int256.div(other: int256): int256 = int256Divide(this, other)
@inline operator fun int256.rem(other: int256): int256 = int256Remainder(this, other)

// As every width's: a count that's negative or at least the width gives zero.
fun int256ShiftLeft(value: int256, count: int): int256 =
    if (count < 0 || count >= 256) int256(0) else ablaI256_shl(value, u32(count))
fun int256ShiftRight(value: int256, count: int): int256 =
    if (count < 0 || count >= 256) int256(0) else ablaI256_ashr(value, u32(count))
fun int256UnsignedShiftRight(value: int256, count: int): int256 =
    if (count < 0 || count >= 256) int256(0) else ablaI256_lshr(value, u32(count))
@inline operator fun int256.shl(count: int): int256 = int256ShiftLeft(this, count)
@inline operator fun int256.shr(count: int): int256 = int256ShiftRight(this, count)
@inline operator fun int256.shl(count: i32): int256 = int256ShiftLeft(this, int(count))
@inline operator fun int256.shr(count: i32): int256 = int256ShiftRight(this, int(count))
@inline operator fun int256.shl(count: i16): int256 = int256ShiftLeft(this, int(count))
@inline operator fun int256.shr(count: i16): int256 = int256ShiftRight(this, int(count))
@inline operator fun int256.shl(count: i8): int256 = int256ShiftLeft(this, int(count))
@inline operator fun int256.shr(count: i8): int256 = int256ShiftRight(this, int(count))
@inline operator fun int256.shl(count: u64): int256 = int256ShiftLeft(this, int(count))
@inline operator fun int256.shr(count: u64): int256 = int256ShiftRight(this, int(count))
@inline operator fun int256.shl(count: u32): int256 = int256ShiftLeft(this, int(count))
@inline operator fun int256.shr(count: u32): int256 = int256ShiftRight(this, int(count))
@inline operator fun int256.shl(count: u16): int256 = int256ShiftLeft(this, int(count))
@inline operator fun int256.shr(count: u16): int256 = int256ShiftRight(this, int(count))
@inline operator fun int256.shl(count: u8): int256 = int256ShiftLeft(this, int(count))
@inline operator fun int256.shr(count: u8): int256 = int256ShiftRight(this, int(count))
/** `>>>`: logical, zeros shifted in whatever the sign. */
@inline fun int256.ushr(count: int): int256 = int256UnsignedShiftRight(this, count)

@inline fun int256.isZero(): bool = ablaI256_eq(this, int256(0))
@inline fun int256.isNegative(): bool = ablaI256_slt(this, int256(0))
/** -1, 0 or 1. */
fun int256.signum(): int = if (ablaI256_slt(this, int256(0))) -1 else if (this.isZero()) 0 else 1
/** The magnitude; the smallest value has none that fits, and stays itself. */
fun int256.abs(): int256 = if (this.isNegative()) ablaI256_sub(int256(0), this) else this
/** Bit `index` of its two's complement, the least significant being 0; beyond the width, the sign. */
fun int256.bit(index: int): bool =
    (ablaI256_toU64(ablaI256_ashr(this,
        u32(if (index < 0 || index > 255) 255 else index))) & u64(1)) == u64(1)

/** The sum, or null if it doesn't fit. */
fun int256.addChecked(other: int256): int256? {
    val sum = ablaI256_add(this, other)
    if (this.isNegative() == other.isNegative() && sum.isNegative() !=
        this.isNegative()) null else sum
}
/** The difference, or null if it doesn't fit. */
fun int256.subChecked(other: int256): int256? {
    val difference = ablaI256_sub(this, other)
    if (this.isNegative() != other.isNegative() && difference.isNegative() !=
        this.isNegative()) null
    else difference
}
/** The product, or null if it doesn't fit. */
fun int256.mulChecked(other: int256): int256? {
    if (this.isZero() || other.isZero()) return int256(0)
    val minimum = int256Min()
    val minusOne = int256(-1)
    if ((ablaI256_eq(this, minimum) && ablaI256_eq(other, minusOne)) ||
        (ablaI256_eq(other, minimum) && ablaI256_eq(this, minusOne))) return null
    val product = this * other
    if (ablaI256_eq(int256Divide(product, other), this)) product else null
}

// Narrowing as every width's does: keeps the low bits.
@inline fun int256.toU64(): u64 = ablaI256_toU64(this)
@inline fun int256.toInt(): int = int(ablaI256_toU64(this))
@inline fun int256.toI32(): i32 = i32(ablaI256_toU64(this))
@inline fun int256.toU32(): u32 = u32(ablaI256_toU64(this))
@inline fun int256.toU16(): u16 = u16(ablaI256_toU64(this))
@inline fun int256.toU8(): u8 = u8(ablaI256_toU64(this))
// Or null if it doesn't fit.
fun int256.toIntOrNull(): int? = if (ablaI256_eq(int256(this.toInt()), this)) this.toInt() else null
fun int256.toI32OrNull(): i32? = if (ablaI256_eq(int256(this.toI32()), this)) this.toI32() else null
fun int256.toU64OrNull(): u64? = if (ablaI256_eq(int256(this.toU64()), this)) this.toU64() else null
fun int256.toU32OrNull(): u32? = if (ablaI256_eq(int256(this.toU32()), this)) this.toU32() else null
fun int256.toU16OrNull(): u16? = if (ablaI256_eq(int256(this.toU16()), this)) this.toU16() else null
fun int256.toU8OrNull(): u8? = if (ablaI256_eq(int256(this.toU8()), this)) this.toU8() else null

private @inline fun int256ByteBefore(byte: int, text: string): string = "${char(byte)}$text"

/** In decimal, as "$x" writes it: a minus for a negative one. */
fun int256.toDecimal(): string {
    if (this.isZero()) return "0"
    // Nine digits at a time, in a u32: dividing a u64 would call __udivti3 on a 32-bit target.
    // The magnitude is read as unsigned, which the smallest value needs.
    val chunk = int256(1000000000)
    var text = ""
    var rest = if (this.isNegative()) ablaI256_sub(int256(0), this) else this
    while (!rest.isZero()) {
        var low = u32(ablaI256_toU64(ablaI256_urem(rest, chunk)))
        rest = ablaI256_udiv(rest, chunk)
        for (digit in 0 until 9) {
            if (low != u32(0) || !rest.isZero()) text = int256ByteBefore(48 + int(low % u32(10)),
                text)
            low = low / u32(10)
        }
    }
    if (this.isNegative()) "-$text" else text
}

/** In hex with 0x, in lower case, no leading zeros, a minus before the 0x for a negative one. */
fun int256.toHex(): string {
    if (this.isZero()) return "0x0"
    var text = ""
    var rest = if (this.isNegative()) ablaI256_sub(int256(0), this) else this
    while (!rest.isZero()) {
        val digit = int(rest.toU64() & u64(15))
        text = int256ByteBefore(if (digit < 10) 48 + digit else 87 + digit, text)
        rest = ablaI256_lshr(rest, u32(4))
    }
    if (this.isNegative()) "-0x$text" else "0x$text"
}

// The magnitude read from digits, as unsigned bits, or null if it doesn't fit 256 bits.
private fun int256Magnitude(text: string, start: int): int256? {
    if (text.size == start) return null
    // floor((2^256 - 1) / 10), whose last digit then allows up to 5.
    val limit = int256Words(
        u32(429496729), u32(2576980377), u32(2576980377), u32(2576980377),
        u32(2576980377), u32(2576980377), u32(2576980377), u32(2576980377)
    )
    var out = int256(0)
    for (at in start until text.size) {
        val digit = int(text[at]) - 48
        if (digit < 0 || digit > 9) return null
        if (ablaI256_lt(limit, out) || (ablaI256_eq(out, limit) && digit > 5)) return null
        out = ablaI256_add(ablaI256_add(ablaI256_shl(out, u32(3)), ablaI256_shl(out, u32(1))),
            int256(digit))
    }
    out
}

// A magnitude with its sign, or null if it's beyond the range.
private fun int256Signed(magnitude: int256?, negative: bool): int256? {
    if (magnitude == null) return null
    val bits = magnitude
    if (negative) {
        if (ablaI256_lt(int256Min(), bits)) return null
        return ablaI256_sub(int256(0), bits)
    }
    if (bits.isNegative()) null else bits
}

/** Digits with an optional leading minus (no plus, space or point); leading zeros are allowed. Null if it isn't that, or doesn't fit. */
fun int256FromDecimal(text: string): int256? {
    val negative = text.size > 0 && int(text[0]) == 45
    int256Signed(int256Magnitude(text, if (negative) 1 else 0), negative)
}

// The magnitude from hex digits, after the 0x if there is one.
private fun int256HexMagnitude(text: string, from: int): int256? {
    var start = from
    if (text.size >= start + 2 && int(text[start]) == 48 && (int(text[start + 1]) == 120 ||
        int(text[start + 1]) == 88)) start =
        start + 2
    if (text.size == start) return null
    var out = int256(0)
    for (at in start until text.size) {
        val c = int(text[at])
        val digit = if (c >= 48 && c <= 57) c - 48
            else if (c >= 97 && c <= 102) c - 87
            else if (c >= 65 && c <= 70) c - 55
            else -1
        if (digit < 0 || !ablaI256_lshr(out, u32(252)).isZero()) return null
        out = ablaI256_or(ablaI256_shl(out, u32(4)), int256(digit))
    }
    out
}

/** With or without 0x, in either case, after an optional minus. Null with no digits, on anything else, or if it doesn't fit. */
fun int256FromHex(text: string): int256? {
    val negative = text.size > 0 && int(text[0]) == 45
    int256Signed(int256HexMagnitude(text, if (negative) 1 else 0), negative)
}

/** 32 bytes, big-endian, in two's complement. */
fun int256.toBytes(): string {
    var text = ""
    var rest = this
    for (at in 0 until 32) {
        text = int256ByteBefore(int(rest.toU64() & u64(255)), text)
        rest = ablaI256_lshr(rest, u32(8))
    }
    text
}

/** 32 bytes, little-endian: the least significant byte first. */
fun int256.toBytesLittleEndian(): string {
    var text = ""
    var rest = this
    for (at in 0 until 32) {
        text = "$text${char(int(rest.toU64() & u64(255)))}"
        rest = ablaI256_lshr(rest, u32(8))
    }
    text
}

/** Big-endian bytes, fewer than 32 extending the sign of the first. Null above 32. */
fun int256FromBytes(bytes: string): int256? {
    if (bytes.size > 32) return null
    var out = if (bytes.size > 0 && int(bytes[0]) >= 128) int256(-1) else int256(0)
    for (at in 0 until bytes.size) out = ablaI256_or(ablaI256_shl(out, u32(8)),
        int256(int(bytes[at])))
    out
}

/** Little-endian bytes, fewer than 32 extending the sign of the last. Null above 32. */
fun int256FromBytesLittleEndian(bytes: string): int256? {
    if (bytes.size > 32) return null
    var out = if (bytes.size > 0 && int(bytes[bytes.size - 1]) >= 128) int256(-1) else int256(0)
    var at = bytes.size - 1
    while (at >= 0) {
        out = ablaI256_or(ablaI256_shl(out, u32(8)), int256(int(bytes[at])))
        at = at - 1
    }
    out
}
