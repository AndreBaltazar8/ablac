// RFC 9562 UUIDs. Bytes are in network order, as in the canonical text.
import "abla/bytes"
import "abla/random"
import "abla/process/time"

class Uuid(val bytes: string) {
    /** Compare UUID values by their 16 bytes. Class `==` compares identity. */
    fun equals(other: Uuid): bool = this.bytes == other.bytes
    /** The 16 bytes in network order. */
    fun toBytes(): string = this.bytes
    /** Lowercase, hyphenated text; empty for an invalid direct construction. */
    fun toString(): string = uuidText(this)
}

/** Make a UUID from exactly 16 bytes in network order. */
fun uuidFromBytes(bytes: string): Uuid? = if (bytes.size == 16) Uuid(bytes) else null

private fun uuidHexValue(c: int): int {
    if (c >= 48 && c <= 57) return c - 48
    if (c >= 65 && c <= 70) return c - 65 + 10
    if (c >= 97 && c <= 102) return c - 97 + 10
    -1
}

/** Read exactly the 36-character hyphenated form, in either letter case. */
fun uuidParse(text: string): Uuid? {
    if (text.size != 36) return null
    var bytes = ""
    var i = 0
    while (i < 36) {
        if (i == 8 || i == 13 || i == 18 || i == 23) {
            if (text[i] != 45) return null
            i = i + 1
        } else {
            val high = uuidHexValue(int(text[i]))
            val low = uuidHexValue(int(text[i + 1]))
            if (high < 0 || low < 0) return null
            bytes = bytes + byteEncode(high * 16 + low)
            i = i + 2
        }
    }
    Uuid(bytes)
}

/** Format as 8-4-4-4-12 lowercase hexadecimal digits. */
fun uuidText(value: Uuid): string {
    if (value.bytes.size != 16) return ""
    val hex = "0123456789abcdef"
    var result = ""
    for (i in 0 until 16) {
        if (i == 4 || i == 6 || i == 8 || i == 10) result = result + "-"
        val byte = int(value.bytes[i])
        result = result + hex.slice(byte / 16, byte / 16 + 1) + hex.slice(byte % 16, byte % 16 + 1)
    }
    result
}

private fun uuidV4From(b: string): Uuid? {
    if (b.size != 16) return null
    Uuid(b.slice(0, 6) + byteEncode((int(b[6]) & 15) | 64) + b.slice(7, 8) +
        byteEncode((int(b[8]) & 63) | 128) + b.slice(9, 16))
}

/** Random UUIDv4, or null if secure randomness is unavailable. */
fun uuidV4(): Uuid? {
    val random = secureRandomBytes(16)
    if (!random.succeeded) return null
    uuidV4From(random.bytes)
}

// No process-wide state or counter: same-millisecond values have random order.
private fun uuidV7From(milliseconds: int, random: string): Uuid? {
    if (milliseconds < 0 || milliseconds > 281474976710655 || random.size != 10) return null
    var prefix = ""
    var remaining = milliseconds
    for (i in 0 until 6) {
        prefix = byteEncode(remaining & 255) + prefix
        remaining = remaining >> 8
    }
    Uuid(prefix + byteEncode((int(random[0]) & 15) | 112) + random.slice(1, 2) +
        byteEncode((int(random[2]) & 63) | 128) + random.slice(3, 10))
}

/** UUIDv7 from Unix milliseconds and random bits; null on clock or RNG failure. */
fun uuidV7(): Uuid? {
    val milliseconds = realtimeMilliseconds()
    // The clock API returns zero on failure, indistinguishable from the epoch.
    if (milliseconds <= 0) return null
    val random = secureRandomBytes(10)
    if (!random.succeeded) return null
    uuidV7From(milliseconds, random.bytes)
}
