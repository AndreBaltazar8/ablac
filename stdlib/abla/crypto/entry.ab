private fun cryptoRotateRight64(value: int, count: int): int =
    (value >>> count) | (value << (64 - count))

// SHA-512 and SHA-384, which differ in their start and in how much is kept. Words are
// whole ints, whose arithmetic wraps at 64 bits.
private fun cryptoSha2Long(value: string, initial: array<int>, digestBytes: int): string {
    val input: array<int> = []
    cryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size % 128 != 112) input.append(0)
    // The length has 128 bits, and a string can't reach 2^64 of them.
    cryptoAppendU32Big(input, 0)
    cryptoAppendU32Big(input, 0)
    cryptoAppendU32Big(input, (bitLength >>> 32) & 4294967295)
    cryptoAppendU32Big(input, bitLength & 4294967295)

    val state: array<int> = []
    var index = 0
    while (index < 8) {
        state.append(initial[index])
        index = index + 1
    }
    // The evaluator takes only the first branch, and counts only its effects.
    if (ablaAtCompileTime()) {
        val constants = cryptoSha512Constants()
        var offset = 0
        while (offset < input.size) {
            val words: array<int> = []
            index = 0
            while (index < 16) {
                val at = offset + index * 8
                words.append(
                    (cryptoReadU32Big(input, at) << 32) | cryptoReadU32Big(input, at + 4)
                )
                index = index + 1
            }
            while (index < 80) {
                val previous15 = words[index - 15]
                val previous2 = words[index - 2]
                val small0 = cryptoRotateRight64(previous15, 1) ^
                    cryptoRotateRight64(previous15, 8) ^ (previous15 >>> 7)
                val small1 = cryptoRotateRight64(previous2, 19) ^
                    cryptoRotateRight64(previous2, 61) ^ (previous2 >>> 6)
                words.append(words[index - 16] + small0 + words[index - 7] + small1)
                index = index + 1
            }

            var a = state[0]
            var b = state[1]
            var c = state[2]
            var d = state[3]
            var e = state[4]
            var f = state[5]
            var g = state[6]
            var h = state[7]
            index = 0
            while (index < 80) {
                val big1 = cryptoRotateRight64(e, 14) ^
                    cryptoRotateRight64(e, 18) ^ cryptoRotateRight64(e, 41)
                val choose = (e & f) ^ (~e & g)
                val temporary1 = h + big1 + choose + constants[index] + words[index]
                val big0 = cryptoRotateRight64(a, 28) ^
                    cryptoRotateRight64(a, 34) ^ cryptoRotateRight64(a, 39)
                val majority = (a & b) ^ (a & c) ^ (b & c)
                val temporary2 = big0 + majority
                h = g
                g = f
                f = e
                e = d + temporary1
                d = c
                c = b
                b = a
                a = temporary1 + temporary2
                index = index + 1
            }
            state[0] = state[0] + a
            state[1] = state[1] + b
            state[2] = state[2] + c
            state[3] = state[3] + d
            state[4] = state[4] + e
            state[5] = state[5] + f
            state[6] = state[6] + g
            state[7] = state[7] + h
            offset = offset + 128
        }
    } else {
        cryptoSha512Run(state, cryptoByteString(input))
    }
    val output: array<int> = []
    index = 0
    while (index < digestBytes / 8) {
        cryptoAppendU32Big(output, (state[index] >>> 32) & 4294967295)
        cryptoAppendU32Big(output, state[index] & 4294967295)
        index = index + 1
    }
    cryptoByteString(output)
}

fun sha512(value: string): string = cryptoSha2Long(value, [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
], 64)

fun sha384(value: string): string = cryptoSha2Long(value, [
    0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
    0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4
], 48)

// SHA-1 is provided for protocol compatibility, most notably the RFC 6455
// WebSocket opening handshake. Use SHA-256 for new authentication or storage
// designs.
fun sha1(value: string): string {
    val input: array<int> = []
    cryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size - input.size / 64 * 64 != 56) input.append(0)
    cryptoAppendU32Big(input, bitLength >>> 32)
    cryptoAppendU32Big(input, bitLength)

    var state0 = 1732584193
    var state1 = 4023233417
    var state2 = 2562383102
    var state3 = 271733878
    var state4 = 3285377520
    var offset = 0
    while (offset < input.size) {
        val words: array<int> = []
        var index = 0
        while (index < 16) {
            words.append(cryptoReadU32Big(input, offset + index * 4))
            index = index + 1
        }
        while (index < 80) {
            val mixed = cryptoXorWord(
                cryptoXorWord(words[index - 3], words[index - 8]),
                cryptoXorWord(words[index - 14], words[index - 16])
            )
            words.append(cryptoRotateLeft32(mixed, 1))
            index = index + 1
        }

        var a = state0
        var b = state1
        var c = state2
        var d = state3
        var e = state4
        index = 0
        while (index < 80) {
            var chosen = 0
            var constant = 0
            if (index < 20) {
                chosen = (b & c) | (cryptoNotWord(b) & d)
                constant = 1518500249
            } else if (index < 40) {
                chosen = cryptoXorWord(cryptoXorWord(b, c), d)
                constant = 1859775393
            } else if (index < 60) {
                chosen = (b & c) | (b & d) | (c & d)
                constant = 2400959708
            } else {
                chosen = cryptoXorWord(cryptoXorWord(b, c), d)
                constant = 3395469782
            }
            val temporary = cryptoU32(
                cryptoRotateLeft32(a, 5) + chosen + e +
                constant + words[index]
            )
            e = d
            d = c
            c = cryptoRotateLeft32(b, 30)
            b = a
            a = temporary
            index = index + 1
        }
        state0 = cryptoU32(state0 + a)
        state1 = cryptoU32(state1 + b)
        state2 = cryptoU32(state2 + c)
        state3 = cryptoU32(state3 + d)
        state4 = cryptoU32(state4 + e)
        offset = offset + 64
    }
    val output: array<int> = []
    cryptoAppendU32Big(output, state0)
    cryptoAppendU32Big(output, state1)
    cryptoAppendU32Big(output, state2)
    cryptoAppendU32Big(output, state3)
    cryptoAppendU32Big(output, state4)
    cryptoByteString(output)
}

fun binaryXor(left: string, right: string): string {
    val output: array<int> = []
    var index = 0
    var count = left.size
    if (right.size < count) count = right.size
    while (index < count) {
        output.append((left[index] ^ right[index]) & 255)
        index = index + 1
    }
    cryptoByteString(output)
}

// SHA-256 of more bytes than fit in memory, or arrive in pieces. update(), any number of times, then finish(), which gives
// the same 32 bytes `sha256` would. Whole blocks go straight from the string given, with one schedule kept across them.
class Sha256Stream(
    val state: array<int>,
    val constants: array<int>,
    val schedule: array<int>,
    var pending: string,
    var total: int
)

fun sha256Stream(): Sha256Stream {
    val schedule: array<int> = []
    while (schedule.size < 64) schedule.append(0)
    Sha256Stream(
        [1779033703, 3144134277, 1013904242, 2773480762,
         1359893119, 2600822924, 528734635, 1541459225],
        cryptoSha256Constants(), schedule, "", 0
    )
}

// BEGIN SHA2 SECRET CORES
// SHA-256 and SHA-512 compression over native memory, every word a secret: in HMAC and HKDF (the TLS key schedule) the
// state and the schedule are made from a key. Additions, rotations and logic only, no branch, index or division from
// them; tools/test-ct.sh reads these functions on every target. A state is eight words, native order (SHA-512's as
// low then high halves); the input is whole blocks, big-endian, as the standard reads them.
private @inline trusted fun sha2Load(address: int): secretU32 =
    secretU32(u32(ablaUnsafeLoadU32(nativePointerFromAddress(address))))
private @inline trusted fun sha2Store(address: int, value: secretU32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(address), int(value.declassify()))
private @inline trusted fun sha2Big(address: int): secretU32 {
    val x = sha2Load(address)
    ((x & secretU32(u32(255))) << 24) | ((x & secretU32(u32(65280))) << 8) | ((x >> 8) &
        secretU32(u32(65280))) |
        (x >> 24)
}
private @inline trusted fun sha2Load64(address: int): secretU64 =
    sha2Load(address).widen() | (sha2Load(address + 4).widen() << 32)
private @inline trusted fun sha2Store64(address: int, value: secretU64): void {
    sha2Store(address, value.low())
    sha2Store(address + 4, value.high())
}
private @inline trusted fun sha2Big64(address: int): secretU64 = (sha2Big(address).widen() << 32) |
    sha2Big(address + 4).widen()
private @inline trusted fun sha256Constants(): int =
    nativeStaticBytes("\x98\x2f\x8a\x42\x91\x44\x37\x71\xcf\xfb\xc0\xb5\xa5\xdb\xb5\xe9\x5b\xc2\x56\x39\xf1\x11\xf1\x59\xa4\x82\x3f\x92\xd5\x5e\x1c\xab\x98\xaa\x07\xd8\x01\x5b\x83\x12\xbe\x85\x31\x24\xc3\x7d\x0c\x55\x74\x5d\xbe\x72\xfe\xb1\xde\x80\xa7\x06\xdc\x9b\x74\xf1\x9b\xc1\xc1\x69\x9b\xe4\x86\x47\xbe\xef\xc6\x9d\xc1\x0f\xcc\xa1\x0c\x24\x6f\x2c\xe9\x2d\xaa\x84\x74\x4a\xdc\xa9\xb0\x5c\xda\x88\xf9\x76\x52\x51\x3e\x98\x6d\xc6\x31\xa8\xc8\x27\x03\xb0\xc7\x7f\x59\xbf\xf3\x0b\xe0\xc6\x47\x91\xa7\xd5\x51\x63\xca\x06\x67\x29\x29\x14\x85\x0a\xb7\x27\x38\x21\x1b\x2e\xfc\x6d\x2c\x4d\x13\x0d\x38\x53\x54\x73\x0a\x65\xbb\x0a\x6a\x76\x2e\xc9\xc2\x81\x85\x2c\x72\x92\xa1\xe8\xbf\xa2\x4b\x66\x1a\xa8\x70\x8b\x4b\xc2\xa3\x51\x6c\xc7\x19\xe8\x92\xd1\x24\x06\x99\xd6\x85\x35\x0e\xf4\x70\xa0\x6a\x10\x16\xc1\xa4\x19\x08\x6c\x37\x1e\x4c\x77\x48\x27\xb5\xbc\xb0\x34\xb3\x0c\x1c\x39\x4a\xaa\xd8\x4e\x4f\xca\x9c\x5b\xf3\x6f\x2e\x68\xee\x82\x8f\x74\x6f\x63\xa5\x78\x14\x78\xc8\x84\x08\x02\xc7\x8c\xfa\xff\xbe\x90\xeb\x6c\x50\xa4\xf7\xa3\xf9\xbe\xf2\x78\x71\xc6")
