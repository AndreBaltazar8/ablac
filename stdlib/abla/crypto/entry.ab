    nativeStaticBytes("\x22\xae\x28\xd7\x98\x2f\x8a\x42\xcd\x65\xef\x23\x91\x44\x37\x71\x2f\x3b\x4d\xec\xcf\xfb\xc0\xb5\xbc\xdb\x89\x81\xa5\xdb\xb5\xe9\x38\xb5\x48\xf3\x5b\xc2\x56\x39\x19\xd0\x05\xb6\xf1\x11\xf1\x59\x9b\x4f\x19\xaf\xa4\x82\x3f\x92\x18\x81\x6d\xda\xd5\x5e\x1c\xab\x42\x02\x03\xa3\x98\xaa\x07\xd8\xbe\x6f\x70\x45\x01\x5b\x83\x12\x8c\xb2\xe4\x4e\xbe\x85\x31\x24\xe2\xb4\xff\xd5\xc3\x7d\x0c\x55\x6f\x89\x7b\xf2\x74\x5d\xbe\x72\xb1\x96\x16\x3b\xfe\xb1\xde\x80\x35\x12\xc7\x25\xa7\x06\xdc\x9b\x94\x26\x69\xcf\x74\xf1\x9b\xc1\xd2\x4a\xf1\x9e\xc1\x69\x9b\xe4\xe3\x25\x4f\x38\x86\x47\xbe\xef\xb5\xd5\x8c\x8b\xc6\x9d\xc1\x0f\x65\x9c\xac\x77\xcc\xa1\x0c\x24\x75\x02\x2b\x59\x6f\x2c\xe9\x2d\x83\xe4\xa6\x6e\xaa\x84\x74\x4a\xd4\xfb\x41\xbd\xdc\xa9\xb0\x5c\xb5\x53\x11\x83\xda\x88\xf9\x76\xab\xdf\x66\xee\x52\x51\x3e\x98\x10\x32\xb4\x2d\x6d\xc6\x31\xa8\x3f\x21\xfb\x98\xc8\x27\x03\xb0\xe4\x0e\xef\xbe\xc7\x7f\x59\xbf\xc2\x8f\xa8\x3d\xf3\x0b\xe0\xc6\x25\xa7\x0a\x93\x47\x91\xa7\xd5\x6f\x82\x03\xe0\x51\x63\xca\x06\x70\x6e\x0e\x0a\x67\x29\x29\x14\xfc\x2f\xd2\x46\x85\x0a\xb7\x27\x26\xc9\x26\x5c\x38\x21\x1b\x2e\xed\x2a\xc4\x5a\xfc\x6d\x2c\x4d\xdf\xb3\x95\x9d\x13\x0d\x38\x53\xde\x63\xaf\x8b\x54\x73\x0a\x65\xa8\xb2\x77\x3c\xbb\x0a\x6a\x76\xe6\xae\xed\x47\x2e\xc9\xc2\x81\x3b\x35\x82\x14\x85\x2c\x72\x92\x64\x03\xf1\x4c\xa1\xe8\xbf\xa2\x01\x30\x42\xbc\x4b\x66\x1a\xa8\x91\x97\xf8\xd0\x70\x8b\x4b\xc2\x30\xbe\x54\x06\xa3\x51\x6c\xc7\x18\x52\xef\xd6\x19\xe8\x92\xd1\x10\xa9\x65\x55\x24\x06\x99\xd6\x2a\x20\x71\x57\x85\x35\x0e\xf4\xb8\xd1\xbb\x32\x70\xa0\x6a\x10\xc8\xd0\xd2\xb8\x16\xc1\xa4\x19\x53\xab\x41\x51\x08\x6c\x37\x1e\x99\xeb\x8e\xdf\x4c\x77\x48\x27\xa8\x48\x9b\xe1\xb5\xbc\xb0\x34\x63\x5a\xc9\xc5\xb3\x0c\x1c\x39\xcb\x8a\x41\xe3\x4a\xaa\xd8\x4e\x73\xe3\x63\x77\x4f\xca\x9c\x5b\xa3\xb8\xb2\xd6\xf3\x6f\x2e\x68\xfc\xb2\xef\x5d\xee\x82\x8f\x74\x60\x2f\x17\x43\x6f\x63\xa5\x78\x72\xab\xf0\xa1\x14\x78\xc8\x84\xec\x39\x64\x1a\x08\x02\xc7\x8c\x28\x1e\x63\x23\xfa\xff\xbe\x90\xe9\xbd\x82\xde\xeb\x6c\x50\xa4\x15\x79\xc6\xb2\xf7\xa3\xf9\xbe\x2b\x53\x72\xe3\xf2\x78\x71\xc6\x9c\x61\x26\xea\xce\x3e\x27\xca\x07\xc2\xc0\x21\xc7\xb8\x86\xd1\x1e\xeb\xe0\xcd\xd6\x7d\xda\xea\x78\xd1\x6e\xee\x7f\x4f\x7d\xf5\xba\x6f\x17\x72\xaa\x67\xf0\x06\xa6\x98\xc8\xa2\xc5\x7d\x63\x0a\xae\x0d\xf9\xbe\x04\x98\x3f\x11\x1b\x47\x1c\x13\x35\x0b\x71\x1b\x84\x7d\x04\x23\xf5\x77\xdb\x28\x93\x24\xc7\x40\x7b\xab\xca\x32\xbc\xbe\xc9\x15\x0a\xbe\x9e\x3c\x4c\x0d\x10\x9c\xc4\x67\x1d\x43\xb6\x42\x3e\xcb\xbe\xd4\xc5\x4c\x2a\x7e\x65\xfc\x9c\x29\x7f\x59\xec\xfa\xd6\x3a\xab\x6f\xcb\x5f\x17\x58\x47\x4a\x8c\x19\x44\x6c")

/** SHA-256 over `blocks` 64-byte blocks at `input`: the state (8 words at `state`) is updated; `words` is 256 bytes of
 *  scratch for the schedule. */
private @inline trusted fun sha256CoreBlocks(state: int, input: int, blocks: int,
    words: int): void {
    val constants = sha256Constants()
    for (block in 0 until blocks) {
        val at = input + block * 64
        for (i in 0 until 16) sha2Store(words + i * 4, sha2Big(at + i * 4))
        for (i in 16 until 64) {
            val v15 = sha2Load(words + (i - 15) * 4)
            val v2 = sha2Load(words + (i - 2) * 4)
            val s0 = v15.rotr(7) ^ v15.rotr(18) ^ (v15 >> 3)
            val s1 = v2.rotr(17) ^ v2.rotr(19) ^ (v2 >> 10)
            sha2Store(words + i * 4,
                sha2Load(words + (i - 16) * 4) + s0 + sha2Load(words + (i - 7) * 4) + s1)
        }
        var a = sha2Load(state)
        var b = sha2Load(state + 4)
        var c = sha2Load(state + 8)
        var d = sha2Load(state + 12)
        var e = sha2Load(state + 16)
        var f = sha2Load(state + 20)
        var g = sha2Load(state + 24)
        var h = sha2Load(state + 28)
        for (i in 0 until 64) {
            val t1 = h + (e.rotr(6) ^ e.rotr(11) ^ e.rotr(25)) + ((e & f) ^ (~e & g)) +
                sha2Load(constants + i * 4) +
                sha2Load(words + i * 4)
            val t2 = (a.rotr(2) ^ a.rotr(13) ^ a.rotr(22)) + ((a & b) ^ (a & c) ^ (b & c))
            h = g
            g = f
            f = e
            e = d + t1
            d = c
            c = b
            b = a
            a = t1 + t2
        }
        sha2Store(state, sha2Load(state) + a)
        sha2Store(state + 4, sha2Load(state + 4) + b)
        sha2Store(state + 8, sha2Load(state + 8) + c)
        sha2Store(state + 12, sha2Load(state + 12) + d)
        sha2Store(state + 16, sha2Load(state + 16) + e)
        sha2Store(state + 20, sha2Load(state + 20) + f)
        sha2Store(state + 24, sha2Load(state + 24) + g)
        sha2Store(state + 28, sha2Load(state + 28) + h)
    }
}

/** SHA-512 (and SHA-384) over `blocks` 128-byte blocks at `input`; `words` is 640 bytes of scratch. */
private @inline trusted fun sha512CoreBlocks(state: int, input: int, blocks: int,
    words: int): void {
    val constants = sha512Constants()
    for (block in 0 until blocks) {
        val at = input + block * 128
        for (i in 0 until 16) sha2Store64(words + i * 8, sha2Big64(at + i * 8))
        for (i in 16 until 80) {
            val v15 = sha2Load64(words + (i - 15) * 8)
            val v2 = sha2Load64(words + (i - 2) * 8)
            val s0 = v15.rotr(1) ^ v15.rotr(8) ^ (v15 >> 7)
            val s1 = v2.rotr(19) ^ v2.rotr(61) ^ (v2 >> 6)
            sha2Store64(words + i * 8,
                sha2Load64(words + (i - 16) * 8) + s0 + sha2Load64(words + (i - 7) * 8) + s1)
        }
        var a = sha2Load64(state)
        var b = sha2Load64(state + 8)
        var c = sha2Load64(state + 16)
        var d = sha2Load64(state + 24)
        var e = sha2Load64(state + 32)
        var f = sha2Load64(state + 40)
        var g = sha2Load64(state + 48)
        var h = sha2Load64(state + 56)
        for (i in 0 until 80) {
            val t1 = h + (e.rotr(14) ^ e.rotr(18) ^ e.rotr(41)) + ((e & f) ^ (~e & g)) +
                sha2Load64(constants + i * 8) +
                sha2Load64(words + i * 8)
            val t2 = (a.rotr(28) ^ a.rotr(34) ^ a.rotr(39)) + ((a & b) ^ (a & c) ^ (b & c))
            h = g
            g = f
            f = e
            e = d + t1
            d = c
            c = b
            b = a
            a = t1 + t2
        }
        sha2Store64(state, sha2Load64(state) + a)
        sha2Store64(state + 8, sha2Load64(state + 8) + b)
        sha2Store64(state + 16, sha2Load64(state + 16) + c)
        sha2Store64(state + 24, sha2Load64(state + 24) + d)
        sha2Store64(state + 32, sha2Load64(state + 32) + e)
        sha2Store64(state + 40, sha2Load64(state + 40) + f)
        sha2Store64(state + 48, sha2Load64(state + 48) + g)
        sha2Store64(state + 56, sha2Load64(state + 56) + h)
    }
}
// END SHA2 SECRET CORES

// The cores' scratch is wiped before it is freed (it held a key's state and schedule).
private trusted fun cryptoWipe(address: int, size: int): void {
    for (i in 0 until size) ablaUnsafeVolatileStoreU8(address + i, 0)
    return
}

/** SHA-256 over `blocks` whole blocks of `input` from `offset`, on the stream's state: the secret core above at run time,
 *  the portable block function at compile time (where the constant-time types do not run). */
private fun Sha256Stream.runBlocks(input: string, offset: int, blocks: int): void {
    if (blocks <= 0) return
    // The evaluator takes only this branch, and counts only its effects.
    if (ablaAtCompileTime()) {
        for (block in 0 until blocks) cryptoSha256Block(this.state, this.constants, this.schedule,
            input, offset + block * 64)
    } else {
        cryptoSha256Run(this.state, input, offset, blocks)
    }
    return
}

private trusted fun cryptoSha256Run(var state: array<int>, input: string, offset: int,
    blocks: int): void {
    val memory = ablaUnsafeAllocate(288)
    val base = ablaUnsafePointerAddress(memory)
    for (k in 0 until 8) sha2Store(base + k * 4, secretU32(u32(state[k])))
    sha256CoreBlocks(base, ablaUnsafeStringAddress(input) + offset, blocks, base + 32)
    for (k in 0 until 8) state[k] = int(sha2Load(base + k * 4).declassify())
    cryptoWipe(base, 288)
    ablaUnsafeFree(memory)
    return
}

/** SHA-512's core over the padded message `text` (whole 128-byte blocks), on `state`. */
private trusted fun cryptoSha512Run(var state: array<int>, text: string): void {
    val memory = ablaUnsafeAllocate(704)
    val base = ablaUnsafePointerAddress(memory)
    for (k in 0 until 8) sha2Store64(base + k * 8, secretU64(u64(state[k])))
    sha512CoreBlocks(base, ablaUnsafeStringAddress(text), text.size / 128, base + 64)
    for (k in 0 until 8) state[k] = int(sha2Load64(base + k * 8).declassify())
    cryptoWipe(base, 704)
    ablaUnsafeFree(memory)
    return
}

// Rotates written out, and no call in the loops: built --fast nothing inlines, and this is most of the time spent.
private fun cryptoSha256Block(
    var state: array<int>,
    constants: array<int>,
    var words: array<int>,
    input: string,
    offset: int
): void {
    var index = 0
    while (index < 16) {
        val at = offset + index * 4
        words[index] = (input[at] << 24) | (input[at + 1] << 16) | (input[at + 2] << 8) | input[at +
            3]
        index = index + 1
    }
    while (index < 64) {
        val v15 = words[index - 15]
        val v2 = words[index - 2]
        val small0 = ((v15 >>> 7) | (v15 << 25)) ^ ((v15 >>> 18) | (v15 << 14)) ^ (v15 >>> 3)
        val small1 = ((v2 >>> 17) | (v2 << 15)) ^ ((v2 >>> 19) | (v2 << 13)) ^ (v2 >>> 10)
        words[index] = (words[index - 16] + (small0 & 4294967295) + words[index - 7] + (small1 &
            4294967295)) & 4294967295
        index = index + 1
    }
    var a = state[0]
    var b = state[1]
    var c = state[2]
    var d = state[3]
    var e = state[4]
    var f = state[5]
    var g = state[6]
    var h = state[7]
    index = 0
    while (index < 64) {
        val big1 = (((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7))) &
            4294967295
        val temporary1 = h + big1 + ((e & f) ^ ((e ^ 4294967295) & g)) + constants[index] +
            words[index]
        val big0 = (((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10))) &
            4294967295
        val temporary2 = big0 + ((a & b) ^ (a & c) ^ (b & c))
        h = g
        g = f
        f = e
        e = (d + temporary1) & 4294967295
        d = c
        c = b
        b = a
        a = (temporary1 + temporary2) & 4294967295
        index = index + 1
    }
    state[0] = (state[0] + a) & 4294967295
    state[1] = (state[1] + b) & 4294967295
    state[2] = (state[2] + c) & 4294967295
    state[3] = (state[3] + d) & 4294967295
    state[4] = (state[4] + e) & 4294967295
    state[5] = (state[5] + f) & 4294967295
    state[6] = (state[6] + g) & 4294967295
    state[7] = (state[7] + h) & 4294967295
    return
}

fun Sha256Stream.update(value: string): void {
    this.total = this.total + value.size
    var offset = 0
    if (this.pending.size > 0) {
        val wanted = 64 - this.pending.size
        val taken = if (value.size < wanted) value.size else wanted
        this.pending = "${this.pending}${value.slice(0, taken)}"
        offset = taken
        if (this.pending.size == 64) {
            this.runBlocks(this.pending, 0, 1)
            this.pending = ""
        }
    }
    val whole = (value.size - offset) / 64
    this.runBlocks(value, offset, whole)
    offset = offset + whole * 64
    if (offset < value.size) this.pending = "${this.pending}${value.slice(offset, value.size)}"
    return
}

fun Sha256Stream.finish(): string {
    val bitLength = this.total * 8
    val tail: array<int> = []
    for (byte in this.pending) tail.append(int(byte))
    tail.append(128)
    while (tail.size % 64 != 56) tail.append(0)
    cryptoAppendU32Big(tail, bitLength >>> 32)
    cryptoAppendU32Big(tail, bitLength & 4294967295)
    val text = cryptoByteString(tail)
    this.runBlocks(text, 0, text.size / 64)
    val output: array<int> = []
    for (word in this.state) cryptoAppendU32Big(output, word)
    cryptoByteString(output)
}

fun hmacSha256(key: string, message: string): string {
    var normalized = key
    if (normalized.size > 64) normalized = sha256(normalized)
    val inner: array<int> = []
    val outer: array<int> = []
    var index = 0
    while (index < 64) {
        val byte = if (index < normalized.size) normalized[index] else 0
        inner.append(byte ^ 54)
        outer.append(byte ^ 92)
        index = index + 1
    }
    cryptoAppendText(inner, message)
    cryptoAppendText(outer, sha256(cryptoByteString(inner)))
    sha256(cryptoByteString(outer))
}

private fun cryptoHmacPad(key: string, blockBytes: int, mask: int): string {
    val pad: array<int> = []
    var index = 0
    while (index < blockBytes) {
        pad.append((if (index < key.size) key[index] else 0) ^ mask)
        index = index + 1
    }
    cryptoByteString(pad)
}

// HMAC-SHA-1 stands: HMAC doesn't rest on SHA-1's collision resistance. It's here for
// protocols that require it; new designs use hmacSha256.
fun hmacSha1(key: string, message: string): string {
    val normalized = if (key.size > 64) sha1(key) else key
    sha1(cryptoHmacPad(normalized, 64, 92) + sha1(cryptoHmacPad(normalized, 64, 54) + message))
}

fun hmacSha384(key: string, message: string): string {
    val normalized = if (key.size > 128) sha384(key) else key
    sha384(cryptoHmacPad(normalized, 128, 92) + sha384(cryptoHmacPad(normalized, 128,
        54) + message))
}

fun hmacSha512(key: string, message: string): string {
    val normalized = if (key.size > 128) sha512(key) else key
    sha512(cryptoHmacPad(normalized, 128, 92) + sha512(cryptoHmacPad(normalized, 128,
        54) + message))
}

fun pbkdf2Sha256(password: string, salt: string, iterations: int): string {
    var result = ""
    if (iterations > 0 && iterations <= 1000000) {
        val firstInput: array<int> = []
        cryptoAppendText(firstInput, salt)
        cryptoAppendU32Big(firstInput, 1)
        var current = hmacSha256(password, cryptoByteString(firstInput))
        result = current
        var iteration = 1
        while (iteration < iterations) {
            current = hmacSha256(password, current)
            result = binaryXor(result, current)
            iteration = iteration + 1
        }
    }
    result
}

private fun cryptoBase64Alphabet(): string =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fun base64Encode(value: string): string = ablaBase64Encode(value)

private fun cryptoBase64Digit(value: int): int {
    val alphabet = cryptoBase64Alphabet()
    var result = -1
    var index = 0
    while (index < alphabet.size) {
        if (alphabet[index] == value) result = index
        index = index + 1
    }
    result
}

fun base64Decode(value: string): string = ablaBase64Decode(value)

fun hexEncode(value: string): string {
    val digits = "0123456789abcdef"
    var output = ""
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        val high = digits.slice(byte / 16, byte / 16 + 1)
        val lowIndex = byte - byte / 16 * 16
        val low = digits.slice(lowIndex, lowIndex + 1)
        output = "$output$high$low"
        index = index + 1
    }
    output
}

private fun cryptoHexDigit(value: int): int =
    if (value >= 48 && value <= 57) value - 48
    else if (value >= 97 && value <= 102) value - 87
    else if (value >= 65 && value <= 70) value - 55
    else -1

// Either case. "" for an odd length or any other character, as base64Decode does.
fun hexDecode(value: string): string {
    if (value.size % 2 != 0) return ""
    val output: array<int> = []
    var index = 0
    while (index < value.size) {
        val high = cryptoHexDigit(value[index])
        val low = cryptoHexDigit(value[index + 1])
        if (high < 0 || low < 0) return ""
        output.append(high * 16 + low)
        index = index + 2
    }
    cryptoByteString(output)
}

private fun cryptoMd5Constants(): array<int> = [
    3614090360, 3905402710, 606105819, 3250441966,
    4118548399, 1200080426, 2821735955, 4249261313,
    1770035416, 2336552879, 4294925233, 2304563134,
    1804603682, 4254626195, 2792965006, 1236535329,
    4129170786, 3225465664, 643717713, 3921069994,
    3593408605, 38016083, 3634488961, 3889429448,
    568446438, 3275163606, 4107603335, 1163531501,
    2850285829, 4243563512, 1735328473, 2368359562,
    4294588738, 2272392833, 1839030562, 4259657740,
    2763975236, 1272893353, 4139469664, 3200236656,
    681279174, 3936430074, 3572445317, 76029189,
    3654602809, 3873151461, 530742520, 3299628645,
    4096336452, 1126891415, 2878612391, 4237533241,
    1700485571, 2399980690, 4293915773, 2240044497,
    1873313359, 4264355552, 2734768916, 1309151649,
    4149444226, 3174756917, 718787259, 3951481745
]

private fun cryptoMd5Shifts(): array<int> = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

fun md5(value: string): string {
    val input: array<int> = []
    cryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size - input.size / 64 * 64 != 56) input.append(0)
    cryptoAppendU32Little(input, bitLength)
    input.append(0)
    input.append(0)
    input.append(0)
    input.append(0)
    var state0 = 1732584193
    var state1 = 4023233417
    var state2 = 2562383102
    var state3 = 271733878
    val constants = cryptoMd5Constants()
    val shifts = cryptoMd5Shifts()
    var offset = 0
    while (offset < input.size) {
        val words: array<int> = []
        var index = 0
        while (index < 16) {
            words.append(cryptoReadU32Little(input, offset + index * 4))
            index = index + 1
        }
        var a = state0
        var b = state1
        var c = state2
        var d = state3
        index = 0
        while (index < 64) {
            var mixed = 0
            var word = 0
            if (index < 16) {
                mixed = (b & c) | (cryptoNotWord(b) & d)
                word = index
            } else if (index < 32) {
                mixed = (d & b) | (cryptoNotWord(d) & c)
                word = index * 5 + 1 - (index * 5 + 1) / 16 * 16
            } else if (index < 48) {
                mixed = cryptoXorWord(cryptoXorWord(b, c), d)
                word = index * 3 + 5 - (index * 3 + 5) / 16 * 16
            } else {
                mixed = cryptoXorWord(c, b | cryptoNotWord(d))
                word = index * 7 - index * 7 / 16 * 16
            }
            val nextD = d
            d = c
            c = b
            b = cryptoU32(b + cryptoRotateLeft32(cryptoU32(
                a + mixed + constants[index] + words[word]
            ), shifts[index]))
            a = nextD
            index = index + 1
        }
        state0 = cryptoU32(state0 + a)
        state1 = cryptoU32(state1 + b)
        state2 = cryptoU32(state2 + c)
        state3 = cryptoU32(state3 + d)
        offset = offset + 64
    }
    val output: array<int> = []
    cryptoAppendU32Little(output, state0)
    cryptoAppendU32Little(output, state1)
    cryptoAppendU32Little(output, state2)
    cryptoAppendU32Little(output, state3)
    cryptoByteString(output)
}

fun constantTimeEquals(left: string, right: string): bool {
    if (!ablaAtCompileTime()) return ctEquals(left, right)
    var difference = left.size ^ right.size
    var index = 0
    var count = left.size
    if (right.size > count) count = right.size
    while (index < count) {
        val leftByte = if (index < left.size) left[index] else 0
        val rightByte = if (index < right.size) right[index] else 0
        difference = difference | (leftByte ^ rightByte)
        index = index + 1
    }
    difference == 0
}
