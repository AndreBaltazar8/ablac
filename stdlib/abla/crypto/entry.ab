// Portable cryptographic and binary-text building blocks. Algorithms operate
// on byte-preserving Abla strings and fixed 32-bit or 64-bit words. MD5 is retained
// only for compatibility with legacy protocols; use SHA-256 for new designs. AES
// and RSA live in abla/crypto/hosted, because written here they couldn't be made
// constant-time. These hashes use no secret-dependent branch or table index.

import "abla/bytes"
import "abla/ct"

// Phase-safe entry point: staged execution provides the same byte semantics,
// while native and Wasm targets bind this symbol to the contiguous Abla
// runtime implementation in abla/runtime/self.
noescape extern:"intrinsic" fun ablaBase64Encode(value: string): string
noescape extern:"intrinsic" fun ablaBase64Decode(value: string): string

private fun cryptoU32(value: int): int {
    var result = value - value / 4294967296 * 4294967296
    if (result < 0) result = result + 4294967296
    result
}

private fun cryptoXorWord(left: int, right: int): int =
    (left ^ right) & 4294967295

private fun cryptoNotWord(value: int): int = (~value) & 4294967295

private fun cryptoRotateRight32(value: int, count: int): int =
    ((value >>> count) | (value << (32 - count))) & 4294967295

private fun cryptoRotateLeft32(value: int, count: int): int =
    ((value << count) | (value >>> (32 - count))) & 4294967295

fun cryptoByteString(values: array<int>): string {
    val buffer = byteBuffer()
    var index = 0
    var valid = true
    while (valid && index < values.size) {
        valid = buffer.appendByteValue(values[index])
        index = index + 1
    }
    if (valid) buffer.toText() else ""
}

private fun cryptoAppendText(var bytes: array<int>, value: string): void {
    var index = 0
    while (index < value.size) {
        bytes.append(value[index])
        index = index + 1
    }
}

private fun cryptoAppendU32Big(var bytes: array<int>, value: int): void {
    bytes.append((value >>> 24) & 255)
    bytes.append((value >>> 16) & 255)
    bytes.append((value >>> 8) & 255)
    bytes.append(value & 255)
}

private fun cryptoAppendU32Little(var bytes: array<int>, value: int): void {
    bytes.append(value & 255)
    bytes.append((value >>> 8) & 255)
    bytes.append((value >>> 16) & 255)
    bytes.append((value >>> 24) & 255)
}

private fun cryptoReadU32Big(bytes: array<int>, offset: int): int =
    bytes[offset] * 16777216 + bytes[offset + 1] * 65536 +
    bytes[offset + 2] * 256 + bytes[offset + 3]

private fun cryptoReadU32Little(bytes: array<int>, offset: int): int =
    bytes[offset] + bytes[offset + 1] * 256 +
    bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216

private fun cryptoSha256Constants(): array<int> = [
    1116352408, 1899447441, 3049323471, 3921009573,
    961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987,
    1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628,
    770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671,
    3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291,
    1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771,
    3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877,
    958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424,
    2428436474, 2756734187, 3204031479, 3329325298
]

fun sha256(value: string): string {
    val input: array<int> = []
    cryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size - input.size / 64 * 64 != 56) input.append(0)
    input.append(0)
    input.append(0)
    input.append(0)
    input.append(0)
    cryptoAppendU32Big(input, bitLength)

    var h0 = 1779033703
    var h1 = 3144134277
    var h2 = 1013904242
    var h3 = 2773480762
    var h4 = 1359893119
    var h5 = 2600822924
    var h6 = 528734635
    var h7 = 1541459225
    val constants = cryptoSha256Constants()
    var offset = 0
    while (offset < input.size) {
        val words: array<int> = []
        var index = 0
        while (index < 16) {
            words.append(cryptoReadU32Big(input, offset + index * 4))
            index = index + 1
        }
        while (index < 64) {
            val previous15 = words[index - 15]
            val previous2 = words[index - 2]
            val small0 = cryptoXorWord(
                cryptoXorWord(cryptoRotateRight32(previous15, 7),
                    cryptoRotateRight32(previous15, 18)),
                previous15 >>> 3
            )
            val small1 = cryptoXorWord(
                cryptoXorWord(cryptoRotateRight32(previous2, 17),
                    cryptoRotateRight32(previous2, 19)),
                previous2 >>> 10
            )
            words.append(cryptoU32(
                words[index - 16] + small0 + words[index - 7] + small1
            ))
            index = index + 1
        }

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var h = h7
        index = 0
        while (index < 64) {
            val big1 = cryptoXorWord(
                cryptoXorWord(cryptoRotateRight32(e, 6),
                    cryptoRotateRight32(e, 11)),
                cryptoRotateRight32(e, 25)
            )
            val choose = cryptoXorWord(
                e & f, cryptoNotWord(e) & g
            )
            val temporary1 = cryptoU32(
                h + big1 + choose + constants[index] + words[index]
            )
            val big0 = cryptoXorWord(
                cryptoXorWord(cryptoRotateRight32(a, 2),
                    cryptoRotateRight32(a, 13)),
                cryptoRotateRight32(a, 22)
            )
            val majority = cryptoXorWord(
                cryptoXorWord(a & b, a & c), b & c
            )
            val temporary2 = cryptoU32(big0 + majority)
            h = g
            g = f
            f = e
            e = cryptoU32(d + temporary1)
            d = c
            c = b
            b = a
            a = cryptoU32(temporary1 + temporary2)
            index = index + 1
        }
        h0 = cryptoU32(h0 + a)
        h1 = cryptoU32(h1 + b)
        h2 = cryptoU32(h2 + c)
        h3 = cryptoU32(h3 + d)
        h4 = cryptoU32(h4 + e)
        h5 = cryptoU32(h5 + f)
        h6 = cryptoU32(h6 + g)
        h7 = cryptoU32(h7 + h)
        offset = offset + 64
    }
    val output: array<int> = []
    cryptoAppendU32Big(output, h0)
    cryptoAppendU32Big(output, h1)
    cryptoAppendU32Big(output, h2)
    cryptoAppendU32Big(output, h3)
    cryptoAppendU32Big(output, h4)
    cryptoAppendU32Big(output, h5)
    cryptoAppendU32Big(output, h6)
    cryptoAppendU32Big(output, h7)
    cryptoByteString(output)
}

private fun cryptoSha512Constants(): array<int> = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

private fun cryptoRotateRight64(value: int, count: int): int =
    (value >>> count) | (value << (64 - count))

// SHA-512 and SHA-384, which differ in their start and in how much is kept. Words are
// whole ints, whose arithmetic wraps at 64 bits.
private fun cryptoSha2Long(value: string, initial: array<int>, digestBytes: int): string {
    val input: array<int> = []
    cryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size % 128 != 112) input.append(0)
    // The length has 128 bits, and a string can't reach 2^64 of them.
    cryptoAppendU32Big(input, 0)
    cryptoAppendU32Big(input, 0)
    cryptoAppendU32Big(input, (bitLength >>> 32) & 4294967295)
    cryptoAppendU32Big(input, bitLength & 4294967295)

    val state: array<int> = []
    var index = 0
    while (index < 8) {
        state.append(initial[index])
        index = index + 1
    }
    val constants = cryptoSha512Constants()
    var offset = 0
    while (offset < input.size) {
        val words: array<int> = []
        index = 0
        while (index < 16) {
            val at = offset + index * 8
            words.append(
                (cryptoReadU32Big(input, at) << 32) | cryptoReadU32Big(input, at + 4)
            )
            index = index + 1
        }
        while (index < 80) {
            val previous15 = words[index - 15]
            val previous2 = words[index - 2]
            val small0 = cryptoRotateRight64(previous15, 1) ^
                cryptoRotateRight64(previous15, 8) ^ (previous15 >>> 7)
            val small1 = cryptoRotateRight64(previous2, 19) ^
                cryptoRotateRight64(previous2, 61) ^ (previous2 >>> 6)
            words.append(words[index - 16] + small0 + words[index - 7] + small1)
            index = index + 1
        }

        var a = state[0]
        var b = state[1]
        var c = state[2]
        var d = state[3]
        var e = state[4]
        var f = state[5]
        var g = state[6]
        var h = state[7]
        index = 0
        while (index < 80) {
            val big1 = cryptoRotateRight64(e, 14) ^
                cryptoRotateRight64(e, 18) ^ cryptoRotateRight64(e, 41)
            val choose = (e & f) ^ (~e & g)
            val temporary1 = h + big1 + choose + constants[index] + words[index]
            val big0 = cryptoRotateRight64(a, 28) ^
                cryptoRotateRight64(a, 34) ^ cryptoRotateRight64(a, 39)
            val majority = (a & b) ^ (a & c) ^ (b & c)
            val temporary2 = big0 + majority
            h = g
            g = f
            f = e
            e = d + temporary1
            d = c
            c = b
            b = a
            a = temporary1 + temporary2
            index = index + 1
        }
        state[0] = state[0] + a
        state[1] = state[1] + b
        state[2] = state[2] + c
        state[3] = state[3] + d
        state[4] = state[4] + e
        state[5] = state[5] + f
        state[6] = state[6] + g
        state[7] = state[7] + h
        offset = offset + 128
    }
    val output: array<int> = []
    index = 0
    while (index < digestBytes / 8) {
        cryptoAppendU32Big(output, (state[index] >>> 32) & 4294967295)
        cryptoAppendU32Big(output, state[index] & 4294967295)
        index = index + 1
    }
    cryptoByteString(output)
}

fun sha512(value: string): string = cryptoSha2Long(value, [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
], 64)

fun sha384(value: string): string = cryptoSha2Long(value, [
    0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
    0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4
], 48)

// SHA-1 is provided for protocol compatibility, most notably the RFC 6455
// WebSocket opening handshake. Use SHA-256 for new authentication or storage
// designs.
fun sha1(value: string): string {
    val input: array<int> = []
    cryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size - input.size / 64 * 64 != 56) input.append(0)
    cryptoAppendU32Big(input, bitLength >>> 32)
    cryptoAppendU32Big(input, bitLength)

    var state0 = 1732584193
    var state1 = 4023233417
    var state2 = 2562383102
    var state3 = 271733878
    var state4 = 3285377520
    var offset = 0
    while (offset < input.size) {
        val words: array<int> = []
        var index = 0
        while (index < 16) {
            words.append(cryptoReadU32Big(input, offset + index * 4))
            index = index + 1
        }
        while (index < 80) {
            val mixed = cryptoXorWord(
                cryptoXorWord(words[index - 3], words[index - 8]),
                cryptoXorWord(words[index - 14], words[index - 16])
            )
            words.append(cryptoRotateLeft32(mixed, 1))
            index = index + 1
        }

        var a = state0
        var b = state1
        var c = state2
        var d = state3
        var e = state4
        index = 0
        while (index < 80) {
            var chosen = 0
            var constant = 0
            if (index < 20) {
                chosen = (b & c) | (cryptoNotWord(b) & d)
                constant = 1518500249
            } else if (index < 40) {
                chosen = cryptoXorWord(cryptoXorWord(b, c), d)
                constant = 1859775393
            } else if (index < 60) {
                chosen = (b & c) | (b & d) | (c & d)
                constant = 2400959708
            } else {
                chosen = cryptoXorWord(cryptoXorWord(b, c), d)
                constant = 3395469782
            }
            val temporary = cryptoU32(
                cryptoRotateLeft32(a, 5) + chosen + e +
                constant + words[index]
            )
            e = d
            d = c
            c = cryptoRotateLeft32(b, 30)
            b = a
            a = temporary
            index = index + 1
        }
        state0 = cryptoU32(state0 + a)
        state1 = cryptoU32(state1 + b)
        state2 = cryptoU32(state2 + c)
        state3 = cryptoU32(state3 + d)
        state4 = cryptoU32(state4 + e)
        offset = offset + 64
    }
    val output: array<int> = []
    cryptoAppendU32Big(output, state0)
    cryptoAppendU32Big(output, state1)
    cryptoAppendU32Big(output, state2)
    cryptoAppendU32Big(output, state3)
    cryptoAppendU32Big(output, state4)
    cryptoByteString(output)
}

fun binaryXor(left: string, right: string): string {
    val output: array<int> = []
    var index = 0
    var count = left.size
    if (right.size < count) count = right.size
    while (index < count) {
        output.append((left[index] ^ right[index]) & 255)
        index = index + 1
    }
    cryptoByteString(output)
}

// SHA-256 of more bytes than fit in memory, or arrive in pieces: `sha256` takes
// one string and a 32-bit length. update(), any number of times, then finish(),
// which gives the same 32 bytes `sha256` would.
class Sha256Stream(
    val state: array<int>,
    val constants: array<int>,
    var pending: array<int>,
    var total: int
)

fun sha256Stream(): Sha256Stream = Sha256Stream(
    [1779033703, 3144134277, 1013904242, 2773480762,
     1359893119, 2600822924, 528734635, 1541459225],
    cryptoSha256Constants(), [], 0
)

private fun cryptoSha256Block(
    var state: array<int>,
    constants: array<int>,
    input: array<int>,
    offset: int
): void {
    var h0 = state[0]
    var h1 = state[1]
    var h2 = state[2]
    var h3 = state[3]
    var h4 = state[4]
    var h5 = state[5]
    var h6 = state[6]
    var h7 = state[7]
    val words: array<int> = []
    var index = 0
    while (index < 16) {
        words.append(cryptoReadU32Big(input, offset + index * 4))
        index = index + 1
    }
    while (index < 64) {
        val previous15 = words[index - 15]
        val previous2 = words[index - 2]
        val small0 = cryptoXorWord(
            cryptoXorWord(cryptoRotateRight32(previous15, 7),
                cryptoRotateRight32(previous15, 18)),
            previous15 >>> 3
        )
        val small1 = cryptoXorWord(
            cryptoXorWord(cryptoRotateRight32(previous2, 17),
                cryptoRotateRight32(previous2, 19)),
            previous2 >>> 10
        )
        words.append(cryptoU32(
            words[index - 16] + small0 + words[index - 7] + small1
        ))
        index = index + 1
    }

    var a = h0
    var b = h1
    var c = h2
    var d = h3
    var e = h4
    var f = h5
    var g = h6
    var h = h7
    index = 0
    while (index < 64) {
        val big1 = cryptoXorWord(
            cryptoXorWord(cryptoRotateRight32(e, 6),
                cryptoRotateRight32(e, 11)),
            cryptoRotateRight32(e, 25)
        )
        val choose = cryptoXorWord(
            e & f, cryptoNotWord(e) & g
        )
        val temporary1 = cryptoU32(
            h + big1 + choose + constants[index] + words[index]
        )
        val big0 = cryptoXorWord(
            cryptoXorWord(cryptoRotateRight32(a, 2),
                cryptoRotateRight32(a, 13)),
            cryptoRotateRight32(a, 22)
        )
        val majority = cryptoXorWord(
            cryptoXorWord(a & b, a & c), b & c
        )
        val temporary2 = cryptoU32(big0 + majority)
        h = g
        g = f
        f = e
        e = cryptoU32(d + temporary1)
        d = c
        c = b
        b = a
        a = cryptoU32(temporary1 + temporary2)
        index = index + 1
    }
    h0 = cryptoU32(h0 + a)
    h1 = cryptoU32(h1 + b)
    h2 = cryptoU32(h2 + c)
    h3 = cryptoU32(h3 + d)
    h4 = cryptoU32(h4 + e)
    h5 = cryptoU32(h5 + f)
    h6 = cryptoU32(h6 + g)
    h7 = cryptoU32(h7 + h)
    state[0] = h0
    state[1] = h1
    state[2] = h2
    state[3] = h3
    state[4] = h4
    state[5] = h5
    state[6] = h6
    state[7] = h7
    return
}

fun Sha256Stream.update(value: string): void {
    this.total = this.total + value.size
    var index = 0
    while (index < value.size) {
        this.pending.append(value[index])
        index = index + 1
        if (this.pending.size == 64) {
            cryptoSha256Block(this.state, this.constants, this.pending, 0)
            this.pending = []
        }
    }
    return
}

fun Sha256Stream.finish(): string {
    val bitLength = this.total * 8
    val tail: array<int> = []
    for (byte in this.pending) tail.append(byte)
    tail.append(128)
    while (tail.size % 64 != 56) tail.append(0)
    cryptoAppendU32Big(tail, bitLength >>> 32)
    cryptoAppendU32Big(tail, bitLength & 4294967295)
    var offset = 0
    while (offset < tail.size) {
        cryptoSha256Block(this.state, this.constants, tail, offset)
        offset = offset + 64
    }
    val output: array<int> = []
    for (word in this.state) cryptoAppendU32Big(output, word)
    cryptoByteString(output)
}

fun hmacSha256(key: string, message: string): string {
    var normalized = key
    if (normalized.size > 64) normalized = sha256(normalized)
    val inner: array<int> = []
    val outer: array<int> = []
    var index = 0
    while (index < 64) {
        val byte = if (index < normalized.size) normalized[index] else 0
        inner.append(byte ^ 54)
        outer.append(byte ^ 92)
        index = index + 1
    }
    cryptoAppendText(inner, message)
    cryptoAppendText(outer, sha256(cryptoByteString(inner)))
    sha256(cryptoByteString(outer))
}

private fun cryptoHmacPad(key: string, blockBytes: int, mask: int): string {
    val pad: array<int> = []
    var index = 0
    while (index < blockBytes) {
        pad.append((if (index < key.size) key[index] else 0) ^ mask)
        index = index + 1
    }
    cryptoByteString(pad)
}

// HMAC-SHA-1 stands: HMAC doesn't rest on SHA-1's collision resistance. It's here for
// protocols that require it; new designs use hmacSha256.
fun hmacSha1(key: string, message: string): string {
    val normalized = if (key.size > 64) sha1(key) else key
    sha1(cryptoHmacPad(normalized, 64, 92) + sha1(cryptoHmacPad(normalized, 64, 54) + message))
}

fun hmacSha384(key: string, message: string): string {
    val normalized = if (key.size > 128) sha384(key) else key
    sha384(cryptoHmacPad(normalized, 128, 92) + sha384(cryptoHmacPad(normalized, 128, 54) + message))
}

fun hmacSha512(key: string, message: string): string {
    val normalized = if (key.size > 128) sha512(key) else key
    sha512(cryptoHmacPad(normalized, 128, 92) + sha512(cryptoHmacPad(normalized, 128, 54) + message))
}

fun pbkdf2Sha256(password: string, salt: string, iterations: int): string {
    var result = ""
    if (iterations > 0 && iterations <= 1000000) {
        val firstInput: array<int> = []
        cryptoAppendText(firstInput, salt)
        cryptoAppendU32Big(firstInput, 1)
        var current = hmacSha256(password, cryptoByteString(firstInput))
        result = current
        var iteration = 1
        while (iteration < iterations) {
            current = hmacSha256(password, current)
            result = binaryXor(result, current)
            iteration = iteration + 1
        }
    }
    result
}

private fun cryptoBase64Alphabet(): string =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fun base64Encode(value: string): string = ablaBase64Encode(value)

private fun cryptoBase64Digit(value: int): int {
    val alphabet = cryptoBase64Alphabet()
    var result = -1
    var index = 0
    while (index < alphabet.size) {
        if (alphabet[index] == value) result = index
        index = index + 1
    }
    result
}

fun base64Decode(value: string): string = ablaBase64Decode(value)

fun hexEncode(value: string): string {
    val digits = "0123456789abcdef"
    var output = ""
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        val high = digits.slice(byte / 16, byte / 16 + 1)
        val lowIndex = byte - byte / 16 * 16
        val low = digits.slice(lowIndex, lowIndex + 1)
        output = "$output$high$low"
        index = index + 1
    }
    output
}

private fun cryptoHexDigit(value: int): int =
    if (value >= 48 && value <= 57) value - 48
    else if (value >= 97 && value <= 102) value - 87
    else if (value >= 65 && value <= 70) value - 55
    else -1

// Either case. "" for an odd length or any other character, as base64Decode does.
fun hexDecode(value: string): string {
    if (value.size % 2 != 0) return ""
    val output: array<int> = []
    var index = 0
    while (index < value.size) {
        val high = cryptoHexDigit(value[index])
        val low = cryptoHexDigit(value[index + 1])
        if (high < 0 || low < 0) return ""
        output.append(high * 16 + low)
        index = index + 2
    }
    cryptoByteString(output)
}

private fun cryptoMd5Constants(): array<int> = [
    3614090360, 3905402710, 606105819, 3250441966,
    4118548399, 1200080426, 2821735955, 4249261313,
    1770035416, 2336552879, 4294925233, 2304563134,
    1804603682, 4254626195, 2792965006, 1236535329,
    4129170786, 3225465664, 643717713, 3921069994,
    3593408605, 38016083, 3634488961, 3889429448,
    568446438, 3275163606, 4107603335, 1163531501,
    2850285829, 4243563512, 1735328473, 2368359562,
    4294588738, 2272392833, 1839030562, 4259657740,
    2763975236, 1272893353, 4139469664, 3200236656,
    681279174, 3936430074, 3572445317, 76029189,
    3654602809, 3873151461, 530742520, 3299628645,
    4096336452, 1126891415, 2878612391, 4237533241,
    1700485571, 2399980690, 4293915773, 2240044497,
    1873313359, 4264355552, 2734768916, 1309151649,
    4149444226, 3174756917, 718787259, 3951481745
]

private fun cryptoMd5Shifts(): array<int> = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

fun md5(value: string): string {
    val input: array<int> = []
    cryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size - input.size / 64 * 64 != 56) input.append(0)
    cryptoAppendU32Little(input, bitLength)
    input.append(0)
    input.append(0)
    input.append(0)
    input.append(0)
    var state0 = 1732584193
    var state1 = 4023233417
    var state2 = 2562383102
    var state3 = 271733878
    val constants = cryptoMd5Constants()
    val shifts = cryptoMd5Shifts()
    var offset = 0
    while (offset < input.size) {
        val words: array<int> = []
        var index = 0
        while (index < 16) {
            words.append(cryptoReadU32Little(input, offset + index * 4))
            index = index + 1
        }
        var a = state0
        var b = state1
        var c = state2
        var d = state3
        index = 0
        while (index < 64) {
            var mixed = 0
            var word = 0
            if (index < 16) {
                mixed = (b & c) | (cryptoNotWord(b) & d)
                word = index
            } else if (index < 32) {
                mixed = (d & b) | (cryptoNotWord(d) & c)
                word = index * 5 + 1 - (index * 5 + 1) / 16 * 16
            } else if (index < 48) {
                mixed = cryptoXorWord(cryptoXorWord(b, c), d)
                word = index * 3 + 5 - (index * 3 + 5) / 16 * 16
            } else {
                mixed = cryptoXorWord(c, b | cryptoNotWord(d))
                word = index * 7 - index * 7 / 16 * 16
            }
            val nextD = d
            d = c
            c = b
            b = cryptoU32(b + cryptoRotateLeft32(cryptoU32(
                a + mixed + constants[index] + words[word]
            ), shifts[index]))
            a = nextD
            index = index + 1
        }
        state0 = cryptoU32(state0 + a)
        state1 = cryptoU32(state1 + b)
        state2 = cryptoU32(state2 + c)
        state3 = cryptoU32(state3 + d)
        offset = offset + 64
    }
    val output: array<int> = []
    cryptoAppendU32Little(output, state0)
    cryptoAppendU32Little(output, state1)
    cryptoAppendU32Little(output, state2)
    cryptoAppendU32Little(output, state3)
    cryptoByteString(output)
}

fun constantTimeEquals(left: string, right: string): bool {
    if (!ablaAtCompileTime()) return ctEquals(left, right)
    var difference = left.size ^ right.size
    var index = 0
    var count = left.size
    if (right.size > count) count = right.size
    while (index < count) {
        val leftByte = if (index < left.size) left[index] else 0
        val rightByte = if (index < right.size) right[index] else 0
        difference = difference | (leftByte ^ rightByte)
        index = index + 1
    }
    difference == 0
}
