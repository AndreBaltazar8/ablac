// The block ciphers of old PKCS#12 files, to READ them: 3DES-CBC (pbeWithSHA1And3-KeyTripleDES-CBC, and the two-key form) and
// RC2-CBC (pbeWithSHA1And40BitRC2-CBC, pbeWithSHA1And128BitRC2-CBC), decrypt only. Nothing here encrypts: abla/crypto/pbe
// writes nothing and the container writers of this repository use PBES2 with AES. These ciphers are in the files that OpenSSL
// 1.x, Windows, macOS and Java wrote for years (the tax authority's own test certificate is one), so a reader that refuses them
// refuses real users' keys; they are not a choice for new data.
//
// NOT constant time: DES and RC2 look up S-boxes and tables by secret-dependent indexes. That is acceptable here only because
// the password-protected container is decrypted once, from a file, by its owner; the AES and PBKDF2 paths of abla/crypto/pbe
// keep their constant-time cores, and this module is no model for new code. The key schedule lives in native memory that is
// overwritten before it is freed, and the key buffer stays the caller's to wipe.
import "abla/crypto/result"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/mmio"

@inline trusted fun legacyPointer(address: int): i64* = ablaUnsafePointerOffset(ablaUnsafeNullPointer(), address)
@inline trusted fun legacyLoad(address: int): int = ablaUnsafeLoadU8(legacyPointer(address))
@inline trusted fun legacyStore(address: int, value: int): void = ablaUnsafeStoreU8(legacyPointer(address), value & 255)

private @noinline trusted fun legacyWipe(address: int, size: int): void {
    for (i in 0 until size) ablaUnsafeVolatileStoreU8(address + i, 0)
}

// DES tables: IP 0, FP 64, E 128, P 176, PC1 208, PC2 264, key shifts 312, S-boxes 328 (eight of 64, row-major).
private @inline trusted fun desTables(): int = nativeStaticBytes("\x3a\x32\x2a\x22\x1a\x12\x0a\x02\x3c\x34\x2c\x24\x1c\x14\x0c\x04\x3e\x36\x2e\x26\x1e\x16\x0e\x06\x40\x38\x30\x28\x20\x18\x10\x08\x39\x31\x29\x21\x19\x11\x09\x01\x3b\x33\x2b\x23\x1b\x13\x0b\x03\x3d\x35\x2d\x25\x1d\x15\x0d\x05\x3f\x37\x2f\x27\x1f\x17\x0f\x07\x28\x08\x30\x10\x38\x18\x40\x20\x27\x07\x2f\x0f\x37\x17\x3f\x1f\x26\x06\x2e\x0e\x36\x16\x3e\x1e\x25\x05\x2d\x0d\x35\x15\x3d\x1d\x24\x04\x2c\x0c\x34\x14\x3c\x1c\x23\x03\x2b\x0b\x33\x13\x3b\x1b\x22\x02\x2a\x0a\x32\x12\x3a\x1a\x21\x01\x29\x09\x31\x11\x39\x19\x20\x01\x02\x03\x04\x05\x04\x05\x06\x07\x08\x09\x08\x09\x0a\x0b\x0c\x0d\x0c\x0d\x0e\x0f\x10\x11\x10\x11\x12\x13\x14\x15\x14\x15\x16\x17\x18\x19\x18\x19\x1a\x1b\x1c\x1d\x1c\x1d\x1e\x1f\x20\x01\x10\x07\x14\x15\x1d\x0c\x1c\x11\x01\x0f\x17\x1a\x05\x12\x1f\x0a\x02\x08\x18\x0e\x20\x1b\x03\x09\x13\x0d\x1e\x06\x16\x0b\x04\x19\x39\x31\x29\x21\x19\x11\x09\x01\x3a\x32\x2a\x22\x1a\x12\x0a\x02\x3b\x33\x2b\x23\x1b\x13\x0b\x03\x3c\x34\x2c\x24\x3f\x37\x2f\x27\x1f\x17\x0f\x07\x3e\x36\x2e\x26\x1e\x16\x0e\x06\x3d\x35\x2d\x25\x1d\x15\x0d\x05\x1c\x14\x0c\x04\x0e\x11\x0b\x18\x01\x05\x03\x1c\x0f\x06\x15\x0a\x17\x13\x0c\x04\x1a\x08\x10\x07\x1b\x14\x0d\x02\x29\x34\x1f\x25\x2f\x37\x1e\x28\x33\x2d\x21\x30\x2c\x31\x27\x38\x22\x35\x2e\x2a\x32\x24\x1d\x20\x01\x01\x02\x02\x02\x02\x02\x02\x01\x02\x02\x02\x02\x02\x02\x01\x0e\x04\x0d\x01\x02\x0f\x0b\x08\x03\x0a\x06\x0c\x05\x09\x00\x07\x00\x0f\x07\x04\x0e\x02\x0d\x01\x0a\x06\x0c\x0b\x09\x05\x03\x08\x04\x01\x0e\x08\x0d\x06\x02\x0b\x0f\x0c\x09\x07\x03\x0a\x05\x00\x0f\x0c\x08\x02\x04\x09\x01\x07\x05\x0b\x03\x0e\x0a\x00\x06\x0d\x0f\x01\x08\x0e\x06\x0b\x03\x04\x09\x07\x02\x0d\x0c\x00\x05\x0a\x03\x0d\x04\x07\x0f\x02\x08\x0e\x0c\x00\x01\x0a\x06\x09\x0b\x05\x00\x0e\x07\x0b\x0a\x04\x0d\x01\x05\x08\x0c\x06\x09\x03\x02\x0f\x0d\x08\x0a\x01\x03\x0f\x04\x02\x0b\x06\x07\x0c\x00\x05\x0e\x09\x0a\x00\x09\x0e\x06\x03\x0f\x05\x01\x0d\x0c\x07\x0b\x04\x02\x08\x0d\x07\x00\x09\x03\x04\x06\x0a\x02\x08\x05\x