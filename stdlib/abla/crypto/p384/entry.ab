// NIST P-384 (secp384r1) on bytes: ECDH, ECDSA, public key checks and DER signatures. The arithmetic is constant-time.
// Everything else of the module (the arithmetic on raw addresses and the work areas it needs) is core.ab, which only the
// standard library's own modules import: no program names an address of its own through this module.
export import "abla/crypto/result"
import "core.ab" as core

fun p384PublicKey(privateKey: string): CryptoResult = core.p384PublicKey(privateKey)

fun p384IsValidPublicKey(encoded: string): bool = core.p384IsValidPublicKey(encoded)

fun p384Ecdh(privateKey: string, peerPublicKey: string): CryptoResult = core.p384Ecdh(privateKey, peerPublicKey)

fun p384EcdsaSign(privateKey: string, message: string): CryptoResult = core.p384EcdsaSign(privateKey, message)

fun p384EcdsaSignRaw(privateKey: string, message: string): CryptoResult = core.p384EcdsaSignRaw(privateKey, message)

fun p384EcdsaVerify(publicKey: string, message: string, signature: string): bool = core.p384EcdsaVerify(publicKey, message, signature)

fun p384EcdsaVerifyDigestRaw(publicKey: string, digest: string, signature: string): bool = core.p384EcdsaVerifyDigestRaw(publicKey, digest, signature)

fun p384SignatureToDer(raw: string): string = core.p384SignatureToDer(raw)

fun p384SignatureFromDer(der: string): string = core.p384SignatureFromDer(der)

