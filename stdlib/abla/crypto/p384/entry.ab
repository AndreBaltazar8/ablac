// NIST P-384 (secp384r1) in Abla: ECDH, ECDSA signing and verification, and public key checks, for TLS and certificate chains: the same complete
// point formulas as abla/crypto/p256 (a = -3 here too) on the big-number arithmetic of abla/crypto/bignum, 12 limbs.
//
// What is secret and how it is handled (as in abla/crypto/p256):
//  - A private key is 48 big-endian bytes, a string (as every key in abla/crypto: it cannot be wiped; the limbs made from it
//    and the table of multiples are, when the call ends). It is refused when it is not in 1..n-1; that outcome is public.
//  - Point addition and doubling are the complete formulas of Renes, Costello and Batina (ePrint 2015/1060, algorithms 4 and 6 for
//    a = -3): the same instructions for every input, the point at infinity and equal points included.
//  - A secret scalar multiplication (p384ScalarMultiplySecret, for ECDH and the public key) walks all 96 four-bit windows of the scalar,
//    doubles four times and adds once per window, the added point read from a table of sixteen by looking at every entry (bnLookup).
//  - The inversion that makes the result affine is Fermat's by a public exponent (bnExpPublic): its input is the z of the
//    result, which is not secret once the shared x is revealed; tools/test-ct.sh does not read it.
//  - ECDSA signing (p384EcdsaSign, RFC 6979 nonce from HMAC-SHA-384): k * G is the secret scalar multiplication above, r * d and (e + r d) * k^-1 are
//    plain multiplications in the order's Montgomery field (p384MultiplyPlain, in the region), the inverse of k is Fermat's by a public exponent
//    (bnExpPublic, not read: the checker cannot tell a load of the exponent from a load of secret memory), and the nonce is a string from
//    hmacSha384 (abla/crypto), which has no table or branch on its data but is not among the functions tools/test-ct.sh reads. A candidate nonce
//    outside 1..n-1 (probability about 2^-190) and r or s of zero are public outcomes.
//  - Verification works on public values only (a public key, a message digest, a signature) and uses a plain binary scalar
//    multiplication (p384ScalarMultiplyPublic): nothing is claimed to be constant time there.
//
// tools/test-ct.sh reads the region between BEGIN P384 SECRET CORES and END P384 SECRET CORES.
// A public key is 97 bytes, 0x04 || X || Y; compressed points are refused.

import "abla/bytes"
import "abla/ct"
import "abla/crypto"
import "abla/crypto/bignum"
import "abla/ct/scrub"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
export import "abla/crypto/result"

private val P384_PRIME = "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"
private val P384_PRIME_MINUS_TWO = "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000fffffffd"
private val P384_ORDER = "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"
private val P384_ORDER_MINUS_TWO = "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52971"
private val P384_B = "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"
private val P384_GX = "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7"
private val P384_GY = "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f"

// BEGIN P384 SECRET CORES
private val P384_WORDS = 12
// Work area, in bytes: five temporaries of 48 bytes, then b, then the accumulator, the sum and the entry read from the table (a
// projective point is three field elements, 144 bytes), then the table of sixteen points.
private val P384_TEMPS = 0
private val P384_B_AT = 240
private val P384_ACCUMULATOR = 288
private val P384_SUM = 432
private val P384_ENTRY = 576
private val P384_TABLE = 720
private val P384_WORK_WORDS = 756

// Where a BnModulus keeps what the arithmetic reads, for twelve limbs.
private @inline fun p384Inverse(m: int): int = m + 48
private @inline fun p384One(m: int): int = m + 100
private @inline fun p384Scratch(m: int): int = m + 148

private @inline trusted fun p384Multiply(m: int, out: int, a: int, b: int): void =
    bnMontgomeryMultiply(out, a, b, m, p384Inverse(m), P384_WORDS, p384Scratch(m))

/** `out` = `a` + `b` mod the modulus. `out` may be either. Uses the modulus's scratch. */
private trusted fun p384Add(m: int, out: int, a: int, b: int): void {
    val t = p384Scratch(m)
    var carry = secretU32(u32(0))
    for (j in 0 until P384_WORDS) {
        val sum = bnLoad(a + j * 4).widen() + bnLoad(b + j * 4).widen() + carry.widen()
        bnStore(t + j * 4, sum.low())
        carry = sum.high()
    }
    bnConditionalSubtractBody(out, t, carry, m, P384_WORDS, t + (P384_WORDS + 2) * 4)
}

/** `out` = `a` - `b` mod the modulus. `out` may be either. Uses the modulus's scratch. */
private trusted fun p384Subtract(m: int, out: int, a: int, b: int): void {
    val t = p384Scratch(m)
    var borrow = secretU32(u32(0))
    for (j in 0 until P384_WORDS) {
        val x = bnLoad(a + j * 4)
        val y = bnLoad(b + j * 4)
        val difference = x - y - borrow
        borrow = ((~x & y) | ((~x | y) & difference)) >> 31
        bnStore(t + j * 4, difference)
    }
    val mask = secretU32(u32(0)) - borrow
    var carry = secretU32(u32(0))
    for (j in 0 until P384_WORDS) {
        val sum = bnLoad(t + j * 4).widen() + (bnLoad(m + j * 4) & mask).widen() + carry.widen()
        bnStore(out + j * 4, sum.low())
        carry = sum.high()
    }
}

// --- The curve: complete addition and doubling (a = -3) ---------------------------------------------------------

/** `out` = `p` + `q`, projective points in Montgomery form; `out` is neither. Renes-Costello-Batina, algorithm 4. */
private trusted fun p384PointAdd(f: int, work: int, out: int, p: int, q: int): void {
    val t0 = work + P384_TEMPS
    val t1 = t0 + 48
    val t2 = t1 + 48
    val t3 = t2 + 48
    val t4 = t3 + 48
    val b = work + P384_B_AT
    val x1 = p
    val y1 = p + 48
    val z1 = p + 96
    val x2 = q
    val y2 = q + 48
    val z2 = q + 96
    val x3 = out
    val y3 = out + 48
    val z3 = out + 96
    p384Multiply(f, t0, x1, x2)
    p384Multiply(f, t1, y1, y2)
    p384Multiply(f, t2, z1, z2)
    p384Add(f, t3, x1, y1)
    p384Add(f, t4, x2, y2)
    p384Multiply(f, t3, t3, t4)
    p384Add(f, t4, t0, t1)
    p384Subtract(f, t3, t3, t4)
    p384Add(f, t4, y1, z1)
    p384Add(f, x3, y2, z2)
    p384Multiply(f, t4, t4, x3)
    p384Add(f, x3, t1, t2)
    p384Subtract(f, t4, t4, x3)
    p384Add(f, x3, x1, z1)
    p384Add(f, y3, x2, z2)
    p384Multiply(f, x3, x3, y3)
    p384Add(f, y3, t0, t2)
    p384Subtract(f, y3, x3, y3)
    p384Multiply(f, z3, b, t2)
    p384Subtract(f, x3, y3, z3)
    p384Add(f, z3, x3, x3)
    p384Add(f, x3, x3, z3)
    p384Subtract(f, z3, t1, x3)
    p384Add(f, x3, t1, x3)
    p384Multiply(f, y3, b, y3)
    p384Add(f, t1, t2, t2)
    p384Add(f, t2, t1, t2)
    p384Subtract(f, y3, y3, t2)
    p384Subtract(f, y3, y3, t0)
    p384Add(f, t1, y3, y3)
    p384Add(f, y3, t1, y3)
    p384Add(f, t1, t0, t0)
    p384Add(f, t0, t1, t0)
    p384Subtract(f, t0, t0, t2)
    p384Multiply(f, t1, t4, y3)
    p384Multiply(f, t2, t0, y3)
    p384Multiply(f, y3, x3, z3)
    p384Add(f, y3, y3, t2)
    p384Multiply(f, x3, t3, x3)
    p384Subtract(f, x3, x3, t1)
    p384Multiply(f, z3, t4, z3)
    p384Multiply(f, t1, t3, t0)
    p384Add(f, z3, z3, t1)
}

/** `out` = 2 `p`; `out` is not `p`. Renes-Costello-Batina, algorithm 6. */
private trusted fun p384PointDouble(f: int, work: int, out: int, p: int): void {
    val t0 = work + P384_TEMPS
    val t1 = t0 + 48
    val t2 = t1 + 48
    val t3 = t2 + 48
    val b = work + P384_B_AT
    val x = p
    val y = p + 48
    val z = p + 96
    val x3 = out
    val y3 = out + 48
    val z3 = out + 96
    p384Multiply(f, t0, x, x)
    p384Multiply(f, t1, y, y)
    p384Multiply(f, t2, z, z)
    p384Multiply(f, t3, x, y)
    p384Add(f, t3, t3, t3)
    p384Multiply(f, z3, x, z)
    p384Add(f, z3, z3, z3)
    p384Multiply(f, y3, b, t2)
    p384Subtract(f, y3, y3, z3)
    p384Add(f, x3, y3, y3)
    p384Add(f, y3, x3, y3)
    p384Subtract(f, x3, t1, y3)
    p384Add(f, y3, t1, y3)
    p384Multiply(f, y3, x3, y3)
    p384Multiply(f, x3, x3, t3)
    p384Add(f, t3, t2, t2)
    p384Add(f, t2, t2, t3)
    p384Multiply(f, z3, b, z3)
    p384Subtract(f, z3, z3, t2)
    p384Subtract(f, z3, z3, t0)
    p384Add(f, t3, z3, z3)
    p384Add(f, z3, z3, t3)
    p384Add(f, t3, t0, t0)
    p384Add(f, t0, t3, t0)
    p384Subtract(f, t0, t0, t2)
    p384Multiply(f, t0, t0, z3)
    p384Add(f, y3, y3, t0)
    p384Multiply(f, t0, y, z)
    p384Add(f, t0, t0, t0)
    p384Multiply(f, z3, t0, z3)
    p384Subtract(f, x3, x3, z3)
    p384Multiply(f, z3, t0, t1)
    p384Add(f, z3, z3, z3)
    p384Add(f, z3, z3, z3)
}


/** Nonzero when the twelve limbs at `value` are a number from 1 to n-1, n at `order`: every limb is read, and only the verdict is
 *  public (a key that is refused). A word, not a bool: a comparison here would be a branch on a target with no conditional set. */
trusted fun p384InRange(order: int, value: int): u32 {
    var borrow = secretU32(u32(0))
    var any = secretU32(u32(0))
    for (j in 0 until P384_WORDS) {
        val x = bnLoad(value + j * 4)
        val y = bnLoad(order + j * 4)
        val difference = x - y - borrow
        borrow = ((~x & y) | ((~x | y) & difference)) >> 31
        any = any | x
    }
    // value - n borrows exactly when value < n.
    (borrow & ctIsNonZero(any)).declassify()
}

/** `out` = `scalar` * `point`: `scalar` is twelve plain limbs (secret), `point` projective in Montgomery form, and `out` is neither.
 *  Every window of four bits does the same four doublings, one addition and a read of the whole table of sixteen multiples. */
trusted fun p384ScalarMultiplySecret(f: int, work: int, out: int, point: int, scalar: int): void {
    val accumulator = work + P384_ACCUMULATOR
    val sum = work + P384_SUM
    val entry = work + P384_ENTRY
    val table = work + P384_TABLE
    // Entry 0 is the point at infinity, (0 : 1 : 0).
    for (j in 0 until 36) ablaUnsafeStoreU32(bnPointer(table + j * 4), 0)
    bnCopy(table + 48, p384One(f), P384_WORDS)
    bnCopy(table + 144, point, 36)
    for (i in 2 until 16) p384PointAdd(f, work, table + i * 144, table + (i - 1) * 144, point)
    bnCopy(accumulator, table, 36)
    var window = 95
    while (window >= 0) {
        for (i in 0 until 4) {
            p384PointDouble(f, work, sum, accumulator)
            bnCopy(accumulator, sum, 36)
        }
        val position = window * 4
        val digit = (bnLoad(scalar + (position / 32) * 4) >> (position % 32)) & secretU32(u32(15))
        bnLookup(entry, table, 16, 36, digit)
        p384PointAdd(f, work, sum, accumulator, entry)
        bnCopy(accumulator, sum, 36)
        window = window - 1
    }
    bnCopy(out, accumulator, 36)
}

/** `out` = `a` * `b` mod the modulus, all plain (the ECDSA signature: r * d, and s = (e + r d) * k^-1: `d` and `k^-1` are secret). */
trusted fun p384MultiplyPlain(m: BnModulus, out: int, a: int, b: int): void {
    val encoded = bnAllocate(P384_WORDS)
    p384MultiplyPlainBody(m.memory, out, a, b, encoded)
    bnRelease(encoded, P384_WORDS)
}

/** What p384MultiplyPlain does, on a modulus block at `memory` and a work area of twelve limbs. */
@inline trusted fun p384MultiplyPlainBody(memory: int, out: int, a: int, b: int, encoded: int): void {
    bnMultiplyAt(memory, P384_WORDS, encoded, a, memory + P384_WORDS * 4 + 4)
    bnMultiplyAt(memory, P384_WORDS, out, encoded, b)
}
// END P384 SECRET CORES

class P384Curve(val field: BnModulus, val order: BnModulus, val work: int)

private trusted fun p384Open(): P384Curve {
    val prime = hexDecode(P384_PRIME)
    val order = hexDecode(P384_ORDER)
    val field = bnModulusFrom(ablaUnsafeStringAddress(prime), 48, P384_WORDS)
    val scalar = bnModulusFrom(ablaUnsafeStringAddress(order), 48, P384_WORDS)
    val work = bnAllocate(P384_WORK_WORDS)
    val plainB = bnAllocate(P384_WORDS)
    val b = hexDecode(P384_B)
    bnFromBytes(plainB, P384_WORDS, ablaUnsafeStringAddress(b), 48)
    bnEncode(field, work + P384_B_AT, plainB)
    bnRelease(plainB, P384_WORDS)
    P384Curve(field, scalar, work)
}

private trusted fun p384Close(curve: P384Curve): void {
    bnModulusRelease(curve.field)
    bnModulusRelease(curve.order)
    bnRelease(curve.work, P384_WORK_WORDS)
}

private trusted fun p384IsZero(value: int): bool {
    for (j in 0 until P384_WORDS) if (ablaUnsafeLoadU32(bnPointer(value + j * 4)) != 0) return false
    true
}


/** `out` = `scalar` * `point` for a public scalar (signature verification) of twelve plain limbs; `point` projective, Montgomery; `out` is neither. */
private trusted fun p384ScalarMultiplyPublic(c: P384Curve, out: int, point: int, scalar: int): void {
    val f = c.field.memory
    val work = c.work
    val accumulator = bnAllocate(36)
    val sum = bnAllocate(36)
    // The point at infinity, (0 : 1 : 0).
    bnCopy(accumulator + 48, p384One(f), P384_WORDS)
    var bit = 383
    while (bit >= 0) {
        p384PointDouble(f, work, sum, accumulator)
        bnCopy(accumulator, sum, 36)
        if (((ablaUnsafeLoadU32(bnPointer(scalar + (bit / 32) * 4)) >> (bit % 32)) & 1) == 1) {
            p384PointAdd(f, work, sum, accumulator, point)
            bnCopy(accumulator, sum, 36)
        }
        bit = bit - 1
    }
    bnCopy(out, accumulator, 36)
    bnRelease(accumulator, 36)
    bnRelease(sum, 36)
}

private trusted fun p384Generator(c: P384Curve, out: int): void {
    val plain = bnAllocate(P384_WORDS)
    val gx = hexDecode(P384_GX)
    bnFromBytes(plain, P384_WORDS, ablaUnsafeStringAddress(gx), 48)
    bnEncode(c.field, out, plain)
    val gy = hexDecode(P384_GY)
    bnFromBytes(plain, P384_WORDS, ablaUnsafeStringAddress(gy), 48)
    bnEncode(c.field, out + 48, plain)
    bnCopy(out + 96, c.field.one(), P384_WORDS)
    bnRelease(plain, P384_WORDS)
}

/** `out` (36 limbs) the point `encoded` (0x04 || X || Y) in Montgomery form, if it is on the curve. */
private trusted fun p384ParsePoint(c: P384Curve, encoded: string, out: int): bool {
    if (encoded.size != 97 || encoded[0] != 4) return false
    val f = c.field
    val x = bnAllocate(P384_WORDS)
    val y = bnAllocate(P384_WORDS)
    bnFromBytes(x, P384_WORDS, ablaUnsafeStringAddress(encoded) + 1, 48)
    bnFromBytes(y, P384_WORDS, ablaUnsafeStringAddress(encoded) + 49, 48)
    var ok = bnLessPublic(x, f.value(), P384_WORDS) && bnLessPublic(y, f.value(), P384_WORDS)
    if (ok) {
        bnEncode(f, out, x)
        bnEncode(f, out + 48, y)
        bnCopy(out + 96, f.one(), P384_WORDS)
        // y^2 = x^3 - 3x + b
        val left = bnAllocate(P384_WORDS)
        val right = bnAllocate(P384_WORDS)
        bnMultiply(f, left, out + 48, out + 48)
        bnMultiply(f, right, out, out)
        bnMultiply(f, right, right, out)
        for (i in 0 until 3) p384Subtract(f.memory, right, right, out)
        p384Add(f.memory, right, right, c.work + P384_B_AT)
        ok = bnEqual(left, right, P384_WORDS)
        bnRelease(left, P384_WORDS)
        bnRelease(right, P384_WORDS)
    }
    bnRelease(x, P384_WORDS)
    bnRelease(y, P384_WORDS)
    ok
}

/** The plain affine x of a projective point, or false at infinity. */
private trusted fun p384AffineX(c: P384Curve, point: int, x: int): bool {
    val f = c.field
    val z = bnAllocate(P384_WORDS)
    val inverse = bnAllocate(P384_WORDS)
    bnDecode(f, z, point + 96)
    val infinity = p384IsZero(z)
    bnExpPublic(f, inverse, z, hexDecode(P384_PRIME_MINUS_TWO))
    bnDecode(f, x, point)
    p384MultiplyPlain(f, x, x, inverse)
    bnRelease(z, P384_WORDS)
    bnRelease(inverse, P384_WORDS)
    !infinity
}

/** Whether `encoded` is an uncompressed point of the curve. */
trusted fun p384IsValidPublicKey(encoded: string): bool {
    val c = p384Open()
    val point = bnAllocate(36)
    val ok = p384ParsePoint(c, encoded, point)
    bnRelease(point, 36)
    p384Close(c)
    ok
}

private fun p384Failed(error: string): CryptoResult = cryptoFailed(error)

/** The `count` bytes at `limbs` as a string, most significant first. */
private trusted fun p384Bytes(limbs: int, count: int): string {
    val out = nativeByteBuffer(count + 1)
    bnToBytes(ablaUnsafePointerAddress(out.pointerAt(0)), count, limbs)
    out.adoptString(count)
}

/** The point at `point` (projective, Montgomery) as plain affine x and y, or false for the point at infinity. */
private trusted fun p384ToAffine(c: P384Curve, point: int, x: int, y: int): bool {
    val f = c.field
    val z = bnAllocate(P384_WORDS)
    val inverse = bnAllocate(P384_WORDS)
    bnDecode(f, z, point + 96)
    val infinity = p384IsZero(z)
    bnExpPublic(f, inverse, z, hexDecode(P384_PRIME_MINUS_TWO))
    bnDecode(f, x, point)
    bnDecode(f, y, point + 48)
    p384MultiplyPlain(f, x, x, inverse)
    p384MultiplyPlain(f, y, y, inverse)
    bnRelease(z, P384_WORDS)
    bnRelease(inverse, P384_WORDS)
    !infinity
}

/** The 48 bytes at `key` as a private scalar in `out` (twelve limbs), if it is in 1..n-1. */
private trusted fun p384ParseScalar(c: P384Curve, key: string, out: int): bool {
    if (key.size != 48) return false
    bnFromBytes(out, P384_WORDS, ablaUnsafeStringAddress(key), 48)
    p384InRange(c.order.value(), out) != u32(0)
}

/** The public key, 97 bytes (0x04 || X || Y), of a private key of 48 bytes. */
trusted fun p384PublicKey(privateKey: string): CryptoResult {
    val result = p384PublicKeyWork(privateKey)
    ctScrubStack4096()
    return result
}

private @noinline trusted fun p384PublicKeyWork(privateKey: string): CryptoResult {
    val c = p384Open()
    val scalar = bnAllocate(P384_WORDS)
    var result = p384Failed("the private key is not a number from 1 to n-1 in 48 bytes")
    if (p384ParseScalar(c, privateKey, scalar)) {
        val g = bnAllocate(36)
        val point = bnAllocate(36)
        val x = bnAllocate(P384_WORDS)
        val y = bnAllocate(P384_WORDS)
        p384Generator(c, g)
        p384ScalarMultiplySecret(c.field.memory, c.work, point, g, scalar)
        if (p384ToAffine(c, point, x, y)) {
            result = CryptoResult("\x04" + p384Bytes(x, 48) + p384Bytes(y, 48), true, "")
        }
        bnRelease(g, 36)
        bnRelease(point, 36)
        bnRelease(x, P384_WORDS)
        bnRelease(y, P384_WORDS)
    }
    bnRelease(scalar, P384_WORDS)
    p384Close(c)
    result
}

/** ECDH: the x coordinate, 48 bytes, of `privateKey` times the peer's public point. The peer's point is checked (a point of the
 *  curve: the group has cofactor 1, so that is all there is to check); a private key out of range is refused. */
trusted fun p384Ecdh(privateKey: string, peerPublicKey: string): CryptoResult {
    val result = p384EcdhWork(privateKey, peerPublicKey)
    ctScrubStack4096()
    return result
}

private @noinline trusted fun p384EcdhWork(privateKey: string, peerPublicKey: string): CryptoResult {
    val c = p384Open()
    val scalar = bnAllocate(P384_WORDS)
    var result = p384Failed("the private key is not a number from 1 to n-1 in 48 bytes")
    if (p384ParseScalar(c, privateKey, scalar)) {
        val peer = bnAllocate(36)
        result = p384Failed("the public key is not a point of P-384")
        if (p384ParsePoint(c, peerPublicKey, peer)) {
            val point = bnAllocate(36)
            val x = bnAllocate(P384_WORDS)
            val y = bnAllocate(P384_WORDS)
            p384ScalarMultiplySecret(c.field.memory, c.work, point, peer, scalar)
            if (p384ToAffine(c, point, x, y)) result = CryptoResult(p384Bytes(x, 48), true, "")
            bnRelease(point, 36)
            bnRelease(x, P384_WORDS)
            bnRelease(y, P384_WORDS)
        }
        bnRelease(peer, 36)
    }
    bnRelease(scalar, P384_WORDS)
    p384Close(c)
    result
}

// --- ECDSA signing ----------------------------------------------------------------------------------------------------

/** `out` = the digest's leftmost 384 bits as a number, reduced mod n (it is below 2 n). */
private trusted fun p384DigestScalar(c: P384Curve, digest: string, out: int): void {
    val size = if (digest.size > 48) 48 else digest.size
    bnFromBytes(out, P384_WORDS, ablaUnsafeStringAddress(digest), size)
    bnConditionalSubtractBody(out, out, secretU32(u32(0)), c.order.value(), P384_WORDS, c.order.scratch())
}

/** RFC 6979's nonce for SHA-384 and the private key `key` (48 bytes) for the message hash `h1`, or "" if no candidate falls in 1..n-1
 *  in 100 tries (it always does). `reduced` is h1 mod n as bytes. The qlen of P-384 is 384 bits, hlen of SHA-384 is 384: a candidate is one HMAC block. */
private trusted fun p384Nonce(c: P384Curve, key: string, reduced: string): string {
    var v = "\x01".repeat(48)
    var k = "\x00".repeat(48)
    k = hmacSha384(k, v + "\x00" + key + reduced)
    v = hmacSha384(k, v)
    k = hmacSha384(k, v + "\x01" + key + reduced)
    v = hmacSha384(k, v)
    val candidate = bnAllocate(P384_WORDS)
    var found = ""
    var tries = 0
    while (tries < 100) {
        v = hmacSha384(k, v)
        bnFromBytes(candidate, P384_WORDS, ablaUnsafeStringAddress(v), 48)
        if (p384InRange(c.order.value(), candidate) != u32(0)) {
            found = v
            break
        }
        k = hmacSha384(k, v + "\x00")
        v = hmacSha384(k, v)
        tries = tries + 1
    }
    bnRelease(candidate, P384_WORDS)
    found
}

/** ECDSA over SHA-384 (RFC 6979 nonce, so a message always gets the same signature): the 96 bytes r || s. */
trusted fun p384EcdsaSignRaw(privateKey: string, message: string): CryptoResult {
    val result = p384EcdsaSignWork(privateKey, message)
    ctScrubStack4096()
    return result
}

private @noinline trusted fun p384EcdsaSignWork(privateKey: string, message: string): CryptoResult {
    val c = p384Open()
    val d = bnAllocate(P384_WORDS)
    var result = p384Failed("the private key is not a number from 1 to n-1 in 48 bytes")
    if (p384ParseScalar(c, privateKey, d)) {
        val order = c.order
        val digest = sha384(message)
        val e = bnAllocate(P384_WORDS)
        p384DigestScalar(c, digest, e)
        val nonce = p384Nonce(c, privateKey, p384Bytes(e, 48))
        result = p384Failed("no usable nonce")
        if (nonce.size == 48) {
            val k = bnAllocate(P384_WORDS)
            val g = bnAllocate(36)
            val point = bnAllocate(36)
            val x = bnAllocate(P384_WORDS)
            val y = bnAllocate(P384_WORDS)
            val inverse = bnAllocate(P384_WORDS)
            val product = bnAllocate(P384_WORDS)
            bnFromBytes(k, P384_WORDS, ablaUnsafeStringAddress(nonce), 48)
            p384Generator(c, g)
            p384ScalarMultiplySecret(c.field.memory, c.work, point, g, k)
            p384ToAffine(c, point, x, y)
            // r = x mod n (x is below p, which is below 2 n); s = k^-1 (e + r d) mod n.
            bnConditionalSubtractBody(x, x, secretU32(u32(0)), order.value(), P384_WORDS, order.scratch())
            bnExpPublic(order, inverse, k, hexDecode(P384_ORDER_MINUS_TWO))
            p384MultiplyPlain(order, product, x, d)
            p384Add(order.memory, product, product, e)
            p384MultiplyPlain(order, product, product, inverse)
            // r or s of zero would call, in RFC 6979, for the next candidate nonce: about once in 2^384 signatures, reported as a failure.
            if (!p384IsZero(x) && !p384IsZero(product)) {
                result = CryptoResult(p384Bytes(x, 48) + p384Bytes(product, 48), true, "")
            }
            bnRelease(k, P384_WORDS)
            bnRelease(g, 36)
            bnRelease(point, 36)
            bnRelease(x, P384_WORDS)
            bnRelease(y, P384_WORDS)
            bnRelease(inverse, P384_WORDS)
            bnRelease(product, P384_WORDS)
        }
        bnRelease(e, P384_WORDS)
    }
    bnRelease(d, P384_WORDS)
    p384Close(c)
    result
}

// An INTEGER of a DER signature for a 48-byte value: minimal, positive.
private fun p384DerInteger(value: string): string {
    var start = 0
    while (start < 47 && value[start] == 0) start = start + 1
    val body = value.slice(start, 48)
    val padded = if (body[0] >= 128) "\x00" + body else body
    "\x02" + byteEncode(padded.size) + padded
}

/** The signature r || s (96 bytes) as DER, the form X.509 and TLS carry. */
fun p384SignatureToDer(raw: string): string {
    if (raw.size != 96) return ""
    val body = p384DerInteger(raw.slice(0, 48)) + p384DerInteger(raw.slice(48, 96))
    "\x30" + byteEncode(body.size) + body
}

/** ECDSA over SHA-384, the signature as DER. */
trusted fun p384EcdsaSign(privateKey: string, message: string): CryptoResult {
    val raw = p384EcdsaSignRaw(privateKey, message)
    if (!raw.ok) return raw
    CryptoResult(p384SignatureToDer(raw.bytes), true, "")
}

/** Verifies the signature `r || s` (96 bytes) of a message digest (the leftmost 384 bits of a longer one count) under the
 *  public key (97 bytes). */
trusted fun p384EcdsaVerifyDigestRaw(publicKey: string, digest: string, signature: string): bool {
    if (signature.size != 96 || digest.size == 0) return false
    val c = p384Open()
    val order = c.order
    val q = bnAllocate(36)
    var valid = false
    if (p384ParsePoint(c, publicKey, q)) {
        val r = bnAllocate(P384_WORDS)
        val s = bnAllocate(P384_WORDS)
        bnFromBytes(r, P384_WORDS, ablaUnsafeStringAddress(signature), 48)
        bnFromBytes(s, P384_WORDS, ablaUnsafeStringAddress(signature) + 48, 48)
        if (!p384IsZero(r) && !p384IsZero(s) && bnLessPublic(r, order.value(), P384_WORDS) &&
            bnLessPublic(s, order.value(), P384_WORDS)) {
            val e = bnAllocate(P384_WORDS)
            val w = bnAllocate(P384_WORDS)
            val u1 = bnAllocate(P384_WORDS)
            val u2 = bnAllocate(P384_WORDS)
            val g = bnAllocate(36)
            val first = bnAllocate(36)
            val second = bnAllocate(36)
            val total = bnAllocate(36)
            val x = bnAllocate(P384_WORDS)
            val size = if (digest.size > 48) 48 else digest.size
            bnFromBytes(e, P384_WORDS, ablaUnsafeStringAddress(digest), size)
            bnConditionalSubtractBody(e, e, secretU32(u32(0)), order.value(), P384_WORDS, order.scratch())
            bnExpPublic(order, w, s, hexDecode(P384_ORDER_MINUS_TWO))
            p384MultiplyPlain(order, u1, e, w)
            p384MultiplyPlain(order, u2, r, w)
            p384Generator(c, g)
            p384ScalarMultiplyPublic(c, first, g, u1)
            p384ScalarMultiplyPublic(c, second, q, u2)
            p384PointAdd(c.field.memory, c.work, total, first, second)
            if (p384AffineX(c, total, x)) {
                bnConditionalSubtractBody(x, x, secretU32(u32(0)), order.value(), P384_WORDS, order.scratch())
                valid = bnEqual(x, r, P384_WORDS)
            }
            bnRelease(e, P384_WORDS)
            bnRelease(w, P384_WORDS)
            bnRelease(u1, P384_WORDS)
            bnRelease(u2, P384_WORDS)
            bnRelease(g, 36)
            bnRelease(first, 36)
            bnRelease(second, 36)
            bnRelease(total, 36)
            bnRelease(x, P384_WORDS)
        }
        bnRelease(r, P384_WORDS)
        bnRelease(s, P384_WORDS)
    }
    bnRelease(q, 36)
    p384Close(c)
    valid
}

/** One strict DER INTEGER at `at` as 48 bytes, or "". */
private fun p384DerInteger(text: string, at: int, limit: int): string {
    if (at + 2 > limit || text[at] != 2) return ""
    val length = text[at + 1]
    if (length == 0 || length >= 128 || at + 2 + length > limit) return ""
    val first = text[at + 2]
    if (first >= 128) return ""
    if (length > 1 && first == 0 && text[at + 3] < 128) return ""
    var bytes = text.slice(at + 2, at + 2 + length)
    if (first == 0 && length > 1) bytes = bytes.slice(1, length)
    if (bytes.size > 48) return ""
    "\x00".repeat(48 - bytes.size) + bytes
}

/** r || s (96 bytes) from a strict DER ECDSA signature, or "". */
fun p384SignatureFromDer(der: string): string {
    if (der.size < 8 || der[0] != 48 || der[1] >= 128 || der[1] + 2 != der.size) return ""
    val rLength = der[3]
    val r = p384DerInteger(der, 2, der.size)
    if (r == "") return ""
    val next = 2 + 2 + rLength
    val s = p384DerInteger(der, next, der.size)
    if (s == "" || next + 2 + der[next + 1] != der.size) return ""
    r + s
}

/** ECDSA over SHA-384 with a strict DER signature. */
trusted fun p384EcdsaVerify(publicKey: string, message: string, signature: string): bool {
    val raw = p384SignatureFromDer(signature)
    raw != "" && p384EcdsaVerifyDigestRaw(publicKey, sha384(message), raw)
}
