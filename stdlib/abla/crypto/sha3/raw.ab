// public: none
// The Keccak sponge calls that take a raw address, for the standard library's own modules (abla/crypto/mlkem); no program imports this file.
import "entry.ab"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

/** Absorbs `count` bytes at `address` (a string's, an array's: anything in memory). */
trusted fun Keccak.absorbAt(address: int, count: int): void {
    var done = 0
    while (done < count) {
        val chunk = if (count - done < this.rate - this.position) count - done else this.rate - this.position
        for (i in 0 until chunk) {
            val at = nativePointerFromAddress(this.context + this.position + i)
            ablaUnsafeStoreU8(at, ablaUnsafeLoadU8(at) ^ ablaUnsafeLoadU8(nativePointerFromAddress(address + done + i)))
        }
        this.position = this.position + chunk
        done = done + chunk
        if (this.position == this.rate) {
            sha3Permute(this.context)
            this.position = 0
        }
    }
}

/** Squeezes `count` bytes to `address`. The first call ends the input. */
trusted fun Keccak.squeezeTo(address: int, count: int): void {
    if (!this.squeezing) this.finish()
    var done = 0
    while (done < count) {
        if (this.position == this.rate) {
            sha3Permute(this.context)
            this.position = 0
        }
        val chunk = if (count - done < this.rate - this.position) count - done else this.rate - this.position
        for (i in 0 until chunk) {
            ablaUnsafeStoreU8(nativePointerFromAddress(address + done + i),
                ablaUnsafeLoadU8(nativePointerFromAddress(this.context + this.position + i)))
        }
        this.position = this.position + chunk
        done = done + chunk
    }
}

/** Ends the input: the suffix and the 10*1 padding, and the first permutation. */
trusted fun Keccak.finish(): void {
    val first = nativePointerFromAddress(this.context + this.position)
    ablaUnsafeStoreU8(first, ablaUnsafeLoadU8(first) ^ this.suffix)
    val last = nativePointerFromAddress(this.context + this.rate - 1)
    ablaUnsafeStoreU8(last, ablaUnsafeLoadU8(last) ^ 128)
    sha3Permute(this.context)
    this.position = 0
    this.squeezing = true
}

