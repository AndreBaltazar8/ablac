/** The permutation: 24 rounds. The round constants are literals, so nothing is looked up. */
@noinline trusted fun sha3PermuteWords(s: int): void {
    sha3Round(s, secretU64(u64(1)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(32898)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(32906)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(2147516416)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(32907)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(2147483649)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(2147516545)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(32777)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(138)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(136)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(2147516425)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(2147483658)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(2147516555)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(139)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(32905)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(32771)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(32770)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(128)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(32778)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(2147483658)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(2147516545)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(32896)) | (secretU64(u64(2147483648)) << 32))
    sha3Round(s, secretU64(u64(2147483649)) | (secretU64(u64(0)) << 32))
    sha3Round(s, secretU64(u64(2147516424)) | (secretU64(u64(2147483648)) << 32))
}
/** The permutation: the lanes in locals where the target has registers for them, else the words in memory, round by round. */
@noinline trusted fun sha3Permute(s: int): void {
    if (simdTargetArch() == SIMD_ARCH_XTENSA) sha3PermuteWords(s) else sha3PermuteLanes(s)
}
// END SHA3 SECRET CORE

private val SHA3_CONTEXT_SIZE = 240

/** One sponge. `rate` is the bytes absorbed or squeezed per permutation (168 SHAKE128, 136 SHAKE256 and SHA3-256, 72
 *  SHA3-512); `position` is where the next byte goes in the current block; `suffix` is the domain separation of the
 *  padding (0x06 SHA-3, 0x1f SHAKE); `squeezing` is set once the padding is in. */
class Keccak(val context: int, val rate: int, val suffix: int, var position: int, var squeezing: bool)

private trusted fun sha3Wipe(address: int, size: int): void {
    for (i in 0 until size) ablaUnsafeVolatileStoreU8(address + i, 0)
}

private trusted fun keccakNew(rate: int, suffix: int): Keccak {
    val context = cryptoAllocate(SHA3_CONTEXT_SIZE)
    sha3Wipe(context, SHA3_CONTEXT_SIZE)
    Keccak(context, rate, suffix, 0, false)
}

/// Returns a SHA-3 sponge with the given rate in bytes.
fun keccakSha3(rate: int): Keccak = keccakNew(rate, 6)
/// Returns a SHAKE128 sponge for extendable output.
fun keccakShake128(): Keccak = keccakNew(168, 31)
/// Returns a SHAKE256 sponge for extendable output.
fun keccakShake256(): Keccak = keccakNew(136, 31)

/** Wipes the state and frees it. The sponge can't be used afterwards. */
trusted fun Keccak.close(): void {
    sha3Wipe(this.context, SHA3_CONTEXT_SIZE)
    ablaUnsafeFree(nativePointerFromAddress(this.context))
}


/// Adds the input bytes to the sponge before any output is squeezed.
trusted fun Keccak.absorb(data: string): void = this.absorbAt(ablaUnsafeStringAddress(data), data.size)



/// Returns the next requested bytes of sponge output, finalizing the input on the first call.
trusted fun Keccak.squeeze(count: int): string {
    val bytes: array<int> = []
    val buffer = cryptoAllocate(count + 1)
    this.squeezeTo(buffer, count)
    for (i in 0 until count) bytes.append(ablaUnsafeLoadU8(nativePointerFromAddress(buffer + i)))
    ablaUnsafeFree(nativePointerFromAddress(buffer))
    cryptoByteString(bytes)
}

private fun sha3Digest(rate: int, size: int, input: string): string {
    var sponge = keccakSha3(rate)
    sponge.absorb(input)
    val digest = sponge.squeeze(size)
    sponge.close()
    ctScrubStack2048()
    digest
}

private fun shakeDigest(var sponge: Keccak, input: string, size: int): string {
    sponge.absorb(input)
    val digest = sponge.squeeze(size)
    sponge.close()
    ctScrubStack2048()
    digest
}

/** SHA3-256 of `input`, 32 bytes. */
fun sha3256(input: string): string = sha3Digest(136, 32, input)
/** SHA3-512 of `input`, 64 bytes. */
fun sha3512(input: string): string = sha3Digest(72, 64, input)
/** SHAKE128 of `input`, `size` bytes. */
fun shake128(input: string, size: int): string = shakeDigest(keccakShake128(), input, size)
/** SHAKE256 of `input`, `size` bytes. */
fun shake256(input: string, size: int): string = shakeDigest(keccakShake256(), input, size)
