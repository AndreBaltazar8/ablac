// SHA-3 (FIPS 202): the Keccak-f[1600] permutation, SHA3-256, SHA3-512, SHAKE128 and SHAKE256, in Abla, on every target, for
// ML-KEM (abla/crypto/mlkem), whose seeds and shared secret go through it. Keccak has no table lookup, no branch and no
// division on a lane: only exclusive-or, and, not and rotation by constant amounts, so the permutation is constant time by
// construction; tools/test-ct.sh reads it as written, every lane a secret. What is public is the length of what is absorbed
// and squeezed.
//
// The state is 25 lanes of 64 bits in native memory (little endian on every target of Abla, so a byte i of the state is the byte
// i of the memory and the sponge xors bytes in directly), 200 bytes, followed by 40 bytes of scratch for the permutation.
// `Keccak` is one sponge: absorb, then squeeze as often as needed (SHAKE's output has no length fixed in advance, which
// ML-KEM's sampling of a matrix needs). `close` wipes it.

import "abla/crypto"
import "abla/crypto/alloc"
import "abla/ct"
import "abla/ct/scrub"
import "abla/simd/target"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/mmio"
import "raw.ab"

// BEGIN SHA3 SECRET CORE
@inline trusted fun sha3Load(address: int): secretU64 =
    secretU64(u64(ablaUnsafeLoadU32(nativePointerFromAddress(address)))) |
    (secretU64(u64(ablaUnsafeLoadU32(nativePointerFromAddress(address + 4)))) << 32)
/// Stores a secret lane as two 32-bit words at a writable address.
@inline trusted fun sha3Store(address: int, value: secretU64): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(address), int(value.low().declassify()))
    ablaUnsafeStoreU32(nativePointerFromAddress(address + 4), int(value.high().declassify()))
}

/** One round of Keccak-f[1600] on the 25 lanes at `s` (and 5 lanes of scratch at `s + 200`), with the round constant `rc`. */
@inline trusted fun sha3Round(s: int, rc: secretU64): void {
    val c = s + 200
    for (i in 0 until 5) {
        sha3Store(c + i * 8, sha3Load(s + i * 8) ^ sha3Load(s + (i + 5) * 8) ^ sha3Load(s + (i + 10) * 8) ^
            sha3Load(s + (i + 15) * 8) ^ sha3Load(s + (i + 20) * 8))
    }
    for (i in 0 until 5) {
        val d = sha3Load(c + ((i + 4) % 5) * 8) ^ sha3Load(c + ((i + 1) % 5) * 8).rotl(1)
        for (j in 0 until 5) sha3Store(s + (j * 5 + i) * 8, sha3Load(s + (j * 5 + i) * 8) ^ d)
    }
    // rho and pi: the lanes move along one cycle of 24, by constant rotations.
    var t = sha3Load(s + 8)
    val b0 = sha3Load(s + 10 * 8)
    sha3Store(s + 10 * 8, t.rotl(1))
    t = b0
    val b1 = sha3Load(s + 7 * 8)
    sha3Store(s + 7 * 8, t.rotl(3))
    t = b1
    val b2 = sha3Load(s + 11 * 8)
    sha3Store(s + 11 * 8, t.rotl(6))
    t = b2
    val b3 = sha3Load(s + 17 * 8)
    sha3Store(s + 17 * 8, t.rotl(10))
    t = b3
    val b4 = sha3Load(s + 18 * 8)
    sha3Store(s + 18 * 8, t.rotl(15))
    t = b4
    val b5 = sha3Load(s + 3 * 8)
    sha3Store(s + 3 * 8, t.rotl(21))
    t = b5
    val b6 = sha3Load(s + 5 * 8)
    sha3Store(s + 5 * 8, t.rotl(28))
    t = b6
    val b7 = sha3Load(s + 16 * 8)
    sha3Store(s + 16 * 8, t.rotl(36))
    t = b7
    val b8 = sha3Load(s + 8 * 8)
    sha3Store(s + 8 * 8, t.rotl(45))
    t = b8
    val b9 = sha3Load(s + 21 * 8)
    sha3Store(s + 21 * 8, t.rotl(55))
    t = b9
    val b10 = sha3Load(s + 24 * 8)
    sha3Store(s + 24 * 8, t.rotl(2))
    t = b10
    val b11 = sha3Load(s + 4 * 8)
    sha3Store(s + 4 * 8, t.rotl(14))
    t = b11
    val b12 = sha3Load(s + 15 * 8)
    sha3Store(s + 15 * 8, t.rotl(27))
    t = b12
    val b13 = sha3Load(s + 23 * 8)
    sha3Store(s + 23 * 8, t.rotl(41))
    t = b13
    val b14 = sha3Load(s + 19 * 8)
    sha3Store(s + 19 * 8, t.rotl(56))
    t = b14
    val b15 = sha3Load(s + 13 * 8)
    sha3Store(s + 13 * 8, t.rotl(8))
    t = b15
    val b16 = sha3Load(s + 12 * 8)
    sha3Store(s + 12 * 8, t.rotl(25))
    t = b16
    val b17 = sha3Load(s + 2 * 8)
    sha3Store(s + 2 * 8, t.rotl(43))
    t = b17
    val b18 = sha3Load(s + 20 * 8)
    sha3Store(s + 20 * 8, t.rotl(62))
    t = b18
    val b19 = sha3Load(s + 14 * 8)
    sha3Store(s + 14 * 8, t.rotl(18))
    t = b19
    val b20 = sha3Load(s + 22 * 8)
    sha3Store(s + 22 * 8, t.rotl(39))
    t = b20
    val b21 = sha3Load(s + 9 * 8)
    sha3Store(s + 9 * 8, t.rotl(61))
    t = b21
    val b22 = sha3Load(s + 6 * 8)
    sha3Store(s + 6 * 8, t.rotl(20))
    t = b22
    val b23 = sha3Load(s + 1 * 8)
    sha3Store(s + 1 * 8, t.rotl(44))
    t = b23
    for (j in 0 until 5) {
        for (i in 0 until 5) sha3Store(c + i * 8, sha3Load(s + (j * 5 + i) * 8))
        for (i in 0 until 5) {
            sha3Store(s + (j * 5 + i) * 8,
                sha3Load(s + (j * 5 + i) * 8) ^ (~sha3Load(c + ((i + 1) % 5) * 8) & sha3Load(c + ((i + 2) % 5) * 8)))
        }
    }
    sha3Store(s, sha3Load(s) ^ rc)
}

/// Loads a secret lane from a readable 64-bit address.
@inline trusted fun sha3Load64(address: int): secretU64 = secretU64(u64(ablaUnsafeLoadI64(nativePointerFromAddress(address))))
/// Stores a secret lane as a single 64-bit word at a writable address.
@inline trusted fun sha3Store64(address: int, value: secretU64): void =
    ablaUnsafeStoreI64(nativePointerFromAddress(address), int(value.declassify()))

/** The permutation with the 25 lanes in locals and the 24 rounds written out (no loop counter to keep in a register or on the stack: the round constants are literals).
 *  Not on Xtensa (see sha3Permute): its -O0 register scavenger cannot place 25 lanes and their temporaries. */
@noinline trusted fun sha3PermuteLanes(s: int): void {
    var a0 = sha3Load64(s + 0)
    var a1 = sha3Load64(s + 8)
    var a2 = sha3Load64(s + 16)
    var a3 = sha3Load64(s + 24)
    var a4 = sha3Load64(s + 32)
    var a5 = sha3Load64(s + 40)
    var a6 = sha3Load64(s + 48)
    var a7 = sha3Load64(s + 56)
    var a8 = sha3Load64(s + 64)
    var a9 = sha3Load64(s + 72)
    var a10 = sha3Load64(s + 80)
    var a11 = sha3Load64(s + 88)
    var a12 = sha3Load64(s + 96)
    var a13 = sha3Load64(s + 104)
    var a14 = sha3Load64(s + 112)
    var a15 = sha3Load64(s + 120)
    var a16 = sha3Load64(s + 128)
    var a17 = sha3Load64(s + 136)
    var a18 = sha3Load64(s + 144)
    var a19 = sha3Load64(s + 152)
    var a20 = sha3Load64(s + 160)
    var a21 = sha3Load64(s + 168)
    var a22 = sha3Load64(s + 176)
    var a23 = sha3Load64(s + 184)
    var a24 = sha3Load64(s + 192)
    val c0_0 = a0 ^ a5 ^ a10 ^ a15 ^ a20
    val c1_0 = a1 ^ a6 ^ a11 ^ a16 ^ a21
    val c2_0 = a2 ^ a7 ^ a12 ^ a17 ^ a22
    val c3_0 = a3 ^ a8 ^ a13 ^ a18 ^ a23
    val c4_0 = a4 ^ a9 ^ a14 ^ a19 ^ a24
    val d0_0 = c4_0 ^ c1_0.rotl(1)
    val d1_0 = c0_0 ^ c2_0.rotl(1)
    val d2_0 = c1_0 ^ c3_0.rotl(1)
    val d3_0 = c2_0 ^ c4_0.rotl(1)
    val d4_0 = c3_0 ^ c0_0.rotl(1)
    val t0_0 = a0 ^ d0_0
    val t1_0 = a1 ^ d1_0
    val t2_0 = a2 ^ d2_0
    val t3_0 = a3 ^ d3_0
    val t4_0 = a4 ^ d4_0
    val t5_0 = a5 ^ d0_0
    val t6_0 = a6 ^ d1_0
    val t7_0 = a7 ^ d2_0
    val t8_0 = a8 ^ d3_0
    val t9_0 = a9 ^ d4_0
    val t10_0 = a10 ^ d0_0
    val t11_0 = a11 ^ d1_0
    val t12_0 = a12 ^ d2_0
    val t13_0 = a13 ^ d3_0
    val t14_0 = a14 ^ d4_0
    val t15_0 = a15 ^ d0_0
    val t16_0 = a16 ^ d1_0
    val t17_0 = a17 ^ d2_0
    val t18_0 = a18 ^ d3_0
    val t19_0 = a19 ^ d4_0
    val t20_0 = a20 ^ d0_0
    val t21_0 = a21 ^ d1_0
    val t22_0 = a22 ^ d2_0
    val t23_0 = a23 ^ d3_0
    val t24_0 = a24 ^ d4_0
    val b0_0 = t0_0
    val b10_0 = t1_0.rotl(1)
    val b7_0 = t10_0.rotl(3)
    val b11_0 = t7_0.rotl(6)
    val b17_0 = t11_0.rotl(10)
    val b18_0 = t17_0.rotl(15)
    val b3_0 = t18_0.rotl(21)
    val b5_0 = t3_0.rotl(28)
    val b16_0 = t5_0.rotl(36)
    val b8_0 = t16_0.rotl(45)
    val b21_0 = t8_0.rotl(55)
    val b24_0 = t21_0.rotl(2)
    val b4_0 = t24_0.rotl(14)
    val b15_0 = t4_0.rotl(27)
    val b23_0 = t15_0.rotl(41)
    val b19_0 = t23_0.rotl(56)
    val b13_0 = t19_0.rotl(8)
    val b12_0 = t13_0.rotl(25)
    val b2_0 = t12_0.rotl(43)
    val b20_0 = t2_0.rotl(62)
    val b14_0 = t20_0.rotl(18)
    val b22_0 = t14_0.rotl(39)
    val b9_0 = t22_0.rotl(61)
    val b6_0 = t9_0.rotl(20)
    val b1_0 = t6_0.rotl(44)
    a0 = b0_0 ^ (~b1_0 & b2_0)
    a1 = b1_0 ^ (~b2_0 & b3_0)
    a2 = b2_0 ^ (~b3_0 & b4_0)
    a3 = b3_0 ^ (~b4_0 & b0_0)
    a4 = b4_0 ^ (~b0_0 & b1_0)
    a5 = b5_0 ^ (~b6_0 & b7_0)
    a6 = b6_0 ^ (~b7_0 & b8_0)
    a7 = b7_0 ^ (~b8_0 & b9_0)
    a8 = b8_0 ^ (~b9_0 & b5_0)
    a9 = b9_0 ^ (~b5_0 & b6_0)
    a10 = b10_0 ^ (~b11_0 & b12_0)
    a11 = b11_0 ^ (~b12_0 & b13_0)
    a12 = b12_0 ^ (~b13_0 & b14_0)
    a13 = b13_0 ^ (~b14_0 & b10_0)
    a14 = b14_0 ^ (~b10_0 & b11_0)
    a15 = b15_0 ^ (~b16_0 & b17_0)
    a16 = b16_0 ^ (~b17_0 & b18_0)
    a17 = b17_0 ^ (~b18_0 & b19_0)
    a18 = b18_0 ^ (~b19_0 & b15_0)
    a19 = b19_0 ^ (~b15_0 & b16_0)
    a20 = b20_0 ^ (~b21_0 & b22_0)
    a21 = b21_0 ^ (~b22_0 & b23_0)
    a22 = b22_0 ^ (~b23_0 & b24_0)
    a23 = b23_0 ^ (~b24_0 & b20_0)
    a24 = b24_0 ^ (~b20_0 & b21_0)
    a0 = a0 ^ (secretU64(u64(1)) | (secretU64(u64(0)) << 32))
    val c0_1 = a0 ^ a5 ^ a10 ^ a15 ^ a20
    val c1_1 = a1 ^ a6 ^ a11 ^ a16 ^ a21
    val c2_1 = a2 ^ a7 ^ a12 ^ a17 ^ a22
    val c3_1 = a3 ^ a8 ^ a13 ^ a18 ^ a23
    val c4_1 = a4 ^ a9 ^ a14 ^ a19 ^ a24
    val d0_1 = c4_1 ^ c1_1.rotl(1)
    val d1_1 = c0_1 ^ c2_1.rotl(1)
    val d2_1 = c1_1 ^ c3_1.rotl(1)
    val d3_1 = c2_1 ^ c4_1.rotl(1)
    val d4_1 = c3_1 ^ c0_1.rotl(1)
    val t0_1 = a0 ^ d0_1
    val t1_1 = a1 ^ d1_1
    val t2_1 = a2 ^ d2_1
