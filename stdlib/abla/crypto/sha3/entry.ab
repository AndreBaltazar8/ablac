    val t4_1 = a4 ^ d4_1
    val t5_1 = a5 ^ d0_1
    val t6_1 = a6 ^ d1_1
    val t7_1 = a7 ^ d2_1
    val t8_1 = a8 ^ d3_1
    val t9_1 = a9 ^ d4_1
    val t10_1 = a10 ^ d0_1
    val t11_1 = a11 ^ d1_1
    val t12_1 = a12 ^ d2_1
    val t13_1 = a13 ^ d3_1
    val t14_1 = a14 ^ d4_1
    val t15_1 = a15 ^ d0_1
    val t16_1 = a16 ^ d1_1
    val t17_1 = a17 ^ d2_1
    val t18_1 = a18 ^ d3_1
    val t19_1 = a19 ^ d4_1
    val t20_1 = a20 ^ d0_1
    val t21_1 = a21 ^ d1_1
    val t22_1 = a22 ^ d2_1
    val t23_1 = a23 ^ d3_1
    val t24_1 = a24 ^ d4_1
    val b0_1 = t0_1
    val b10_1 = t1_1.rotl(1)
    val b7_1 = t10_1.rotl(3)
    val b11_1 = t7_1.rotl(6)
    val b17_1 = t11_1.rotl(10)
    val b18_1 = t17_1.rotl(15)
    val b3_1 = t18_1.rotl(21)
    val b5_1 = t3_1.rotl(28)
    val b16_1 = t5_1.rotl(36)
    val b8_1 = t16_1.rotl(45)
    val b21_1 = t8_1.rotl(55)
    val b24_1 = t21_1.rotl(2)
    val b4_1 = t24_1.rotl(14)
    val b15_1 = t4_1.rotl(27)
    val b23_1 = t15_1.rotl(41)
    val b19_1 = t23_1.rotl(56)
    val b13_1 = t19_1.rotl(8)
    val b12_1 = t13_1.rotl(25)
    val b2_1 = t12_1.rotl(43)
    val b20_1 = t2_1.rotl(62)
    val b14_1 = t20_1.rotl(18)
    val b22_1 = t14_1.rotl(39)
    val b9_1 = t22_1.rotl(61)
    val b6_1 = t9_1.rotl(20)
    val b1_1 = t6_1.rotl(44)
    a0 = b0_1 ^ (~b1_1 & b2_1)
    a1 = b1_1 ^ (~b2_1 & b3_1)
    a2 = b2_1 ^ (~b3_1 & b4_1)
    a3 = b3_1 ^ (~b4_1 & b0_1)
    a4 = b4_1 ^ (~b0_1 & b1_1)
    a5 = b5_1 ^ (~b6_1 & b7_1)
    a6 = b6_1 ^ (~b7_1 & b8_1)
    a7 = b7_1 ^ (~b8_1 & b9_1)
    a8 = b8_1 ^ (~b9_1 & b5_1)
    a9 = b9_1 ^ (~b5_1 & b6_1)
    a10 = b10_1 ^ (~b11_1 & b12_1)
    a11 = b11_1 ^ (~b12_1 & b13_1)
    a12 = b12_1 ^ (~b13_1 & b14_1)
    a13 = b13_1 ^ (~b14_1 & b10_1)
    a14 = b14_1 ^ (~b10_1 & b11_1)
    a15 = b15_1 ^ (~b16_1 & b17_1)
    a16 = b16_1 ^ (~b17_1 & b18_1)
    a17 = b17_1 ^ (~b18_1 & b19_1)
    a18 = b18_1 ^ (~b19_1 & b15_1)
    a19 = b19_1 ^ (~b15_1 & b16_1)
    a20 = b20_1 ^ (~b21_1 & b22_1)
    a21 = b21_1 ^ (~b22_1 & b23_1)
    a22 = b22_1 ^ (~b23_1 & b24_1)
    a23 = b23_1 ^ (~b24_1 & b20_1)
    a24 = b24_1 ^ (~b20_1 & b21_1)
    a0 = a0 ^ (secretU64(u64(32898)) | (secretU64(u64(0)) << 32))
