    val t20_2 = a20 ^ d0_2
    val t21_2 = a21 ^ d1_2
    val t22_2 = a22 ^ d2_2
    val t23_2 = a23 ^ d3_2
    val t24_2 = a24 ^ d4_2
    val b0_2 = t0_2
    val b10_2 = t1_2.rotl(1)
    val b7_2 = t10_2.rotl(3)
    val b11_2 = t7_2.rotl(6)
    val b17_2 = t11_2.rotl(10)
    val b18_2 = t17_2.rotl(15)
