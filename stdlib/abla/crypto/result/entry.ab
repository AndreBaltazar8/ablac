// What abla/crypto/aes and abla/crypto/rsa return. The same shape as abla/crypto/hosted's.

// Carries the output bytes and success flag of a cryptographic operation, with error text on failure.
class CryptoResult(val bytes: string, val ok: bool, val error: string)

// Returns a failed cryptographic result with empty bytes and the supplied error.
fun cryptoFailed(error: string): CryptoResult = CryptoResult("", false, error)
