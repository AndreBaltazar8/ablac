// X25519 (RFC 7748 section 5): Diffie-Hellman on Curve25519, in Abla, with no OpenSSL, on every target, and
// constant-time: the Montgomery ladder runs all 255 steps and swaps by a mask on every bit, the field arithmetic has
// no branch, memory index or division on a value, and the inverse is Fermat's. What is public: the lengths and the
// loop counts. A scalar and the shared secret are secret; a point is public.
//
// A field element is 32 limbs of 8 bits, one limb per 32-bit word, little endian (128 bytes), so every product and
// sum fits in 32 bits and nothing wider is needed on any target; 2^256 is 38 mod 2^255 - 19. tools/test-ct.sh reads the
// core below (between the BEGIN and END lines) as written, in a module of its own.
//
// x25519 gives `ok` false, and no bytes, for a shared secret that is all zero (a point of small order, RFC 7748
// section 6.1; TLS 1.3 requires the handshake to fail then).

import "abla/crypto"
import "abla/crypto/alloc"
import "abla/ct"
import "abla/ct/scrub"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/mmio"
export import "abla/crypto/result"

// BEGIN X25519 SECRET CORE
@inline trusted fun x25519Pointer(address: int): i64* =
    ablaUnsafePointerOffset(ablaUnsafeNullPointer(), address)
@inline trusted fun x25519Load(address: int): secretU32 =
    secretU32(u32(ablaUnsafeLoadU32(x25519Pointer(address))))
@inline trusted fun x25519Store(address: int, value: secretU32): void =
    ablaUnsafeStoreU32(x25519Pointer(address), int(value.declassify()))

/** One pass of carries over the 32 limbs at `a`: each limb keeps 8 bits, and the carry out of the top limb comes back
 *  into the bottom one times 38. */
@inline trusted fun x25519CarryPass(a: int): void {
    val mask = secretU32(u32(255))
    for (i in 0 until 31) {
        val limb = x25519Load(a + i * 4)
        x25519Store(a + i * 4, limb & mask)
        x25519Store(a + (i + 1) * 4, x25519Load(a + (i + 1) * 4) + (limb >> 8))
    }
    val top = x25519Load(a + 124)
    x25519Store(a + 124, top & mask)
    x25519Store(a, x25519Load(a) + (top >> 8) * secretU32(u32(38)))
}

/** Two passes leave every limb at most 255, the bottom one at most 293, from limbs of up to 2^27. */
@inline trusted fun x25519Carry(a: int): void {
    x25519CarryPass(a)
    x25519CarryPass(a)
}

/** `out` = `a` + `b`. `out` may be either. */
@inline trusted fun x25519AddBody(out: int, a: int, b: int): void {
    for (i in 0 until 32) x25519Store(out + i * 4, x25519Load(a + i * 4) + x25519Load(b + i * 4))
    x25519Carry(out)
}

/** `out` = `a` - `b`, as `a` + 4p - `b` limb by limb (4p's limbs are all above 293), so nothing is negative. */
@inline trusted fun x25519SubBody(out: int, a: int, b: int): void {
    for (i in 0 until 32) {
        val bias = if (i == 0) 948 else if (i == 31) 508 else 1020
        x25519Store(out + i * 4, x25519Load(a + i * 4) + secretU32(u32(bias)) - x25519Load(b + i * 4))
    }
    x25519Carry(out)
}

/** `out` = `a` * `b`; `t` has 64 words of scratch. `out` may be `a` or `b`. Each output limb is one sum in a
 *  register (at most 32 products of at most 293 * 293), then the high half folds down times 38. */
@inline trusted fun x25519MulBody(out: int, a: int, b: int, t: int): void {
    for (k in 0 until 63) {
        var sum = secretU32(u32(0))
        val first = if (k > 31) k - 31 else 0
        val last = if (k < 31) k else 31
        for (i in first until last + 1) sum = sum + x25519Load(a + i * 4) * x25519Load(b + (k - i) * 4)
        x25519Store(t + k * 4, sum)
    }
    for (k in 0 until 31) {
        x25519Store(out + k * 4, x25519Load(t + k * 4) + x25519Load(t + (k + 32) * 4) * secretU32(u32(38)))
    }
    x25519Store(out + 124, x25519Load(t + 124))
    x25519Carry(out)
}

/** `out` = `a` * 121665, the curve constant (A - 2) / 4. */
@inline trusted fun x25519MulConstantBody(out: int, a: int): void {
    for (i in 0 until 32) x25519Store(out + i * 4, x25519Load(a + i * 4) * secretU32(u32(121665)))
    x25519Carry(out)
}

/** Swaps the elements at `a` and `b` where `mask` has ones. */
@inline trusted fun x25519SwapBody(mask: secretU32, a: int, b: int): void {
    for (i in 0 until 32) {
        val x = x25519Load(a + i * 4)
        val y = x25519Load(b + i * 4)
        val difference = (x ^ y) & mask
        x25519Store(a + i * 4, x ^ difference)
        x25519Store(b + i * 4, y ^ difference)
    }
}

@noinline trusted fun x25519Add(out: int, a: int, b: int): void = x25519AddBody(out, a, b)
@noinline trusted fun x25519Sub(out: int, a: int, b: int): void = x25519SubBody(out, a, b)
@noinline trusted fun x25519Multiply(out: int, a: int, b: int, t: int): void = x25519MulBody(out, a, b, t)
@noinline trusted fun x25519MultiplyConstant(out: int, a: int): void = x25519MulConstantBody(out, a)
@noinline trusted fun x25519Swap(mask: secretU32, a: int, b: int): void = x25519SwapBody(mask, a, b)

@noinline trusted fun x25519SquareTimes(a: int, count: int, t: int): void {
    for (i in 0 until count) x25519MulBody(a, a, a, t)
}

@noinline trusted fun x25519Copy(to: int, from: int): void {
    for (i in 0 until 32) x25519Store(to + i * 4, x25519Load(from + i * 4))
}

/** `out` = `z` ^ (p - 2), the inverse (zero for zero), by the chain of 254 squarings and 11 multiplications of
 *  Bernstein's ref10. `f` has four elements of scratch, `t` the multiplication's. */
@noinline trusted fun x25519Invert(out: int, z: int, f: int, t: int): void {
    val t0 = f
    val t1 = f + 128
    val t2 = f + 256
    val t3 = f + 384
    x25519MulBody(t0, z, z, t)                // z^2
    x25519Copy(t1, t0)
    x25519SquareTimes(t1, 2, t)               // z^8
    x25519MulBody(t1, z, t1, t)               // z^9
    x25519MulBody(t0, t0, t1, t)              // z^11
    x25519MulBody(t2, t0, t0, t)              // z^22
    x25519MulBody(t1, t1, t2, t)              // z^(2^5 - 1)
    x25519Copy(t2, t1)
    x25519SquareTimes(t2, 5, t)
    x25519MulBody(t1, t2, t1, t)              // z^(2^10 - 1)
    x25519Copy(t2, t1)
    x25519SquareTimes(t2, 10, t)
    x25519MulBody(t2, t2, t1, t)              // z^(2^20 - 1)
    x25519Copy(t3, t2)
    x25519SquareTimes(t3, 20, t)
    x25519MulBody(t2, t3, t2, t)              // z^(2^40 - 1)
    x25519SquareTimes(t2, 10, t)
    x25519MulBody(t1, t2, t1, t)              // z^(2^50 - 1)
    x25519Copy(t2, t1)
    x25519SquareTimes(t2, 50, t)
    x25519MulBody(t2, t2, t1, t)              // z^(2^100 - 1)
    x25519Copy(t3, t2)
    x25519SquareTimes(t3, 100, t)
    x25519MulBody(t2, t3, t2, t)              // z^(2^200 - 1)
    x25519SquareTimes(t2, 50, t)
    x25519MulBody(t1, t2, t1, t)              // z^(2^250 - 1)
    x25519SquareTimes(t1, 5, t)
    x25519MulBody(out, t1, t0, t)             // z^(2^255 - 21)
}

/** Carries up through the limbs without wrapping: the top limb keeps what it gets. */
@inline trusted fun x25519Chain(a: int): void {
    val mask = secretU32(u32(255))
    for (i in 0 until 31) {
        val limb = x25519Load(a + i * 4)
        x25519Store(a + i * 4, limb & mask)
        x25519Store(a + (i + 1) * 4, x25519Load(a + (i + 1) * 4) + (limb >> 8))
    }
}

/** The element at `a` reduced to its one value below p = 2^255 - 19, as 32 bytes at `out`. `s` and `bias` are elements of
 *  scratch. */
@noinline trusted fun x25519Pack(out: int, a: int, s: int, bias: int): void {
    x25519Copy(s, a)
    x25519Carry(s)
    // Fold the bit 255 down twice (2^255 is 19): the value is below 2^255 after.
    for (round in 0 until 2) {
        val top = x25519Load(s + 124)
        x25519Store(s + 124, top & secretU32(u32(127)))
        x25519Store(s, x25519Load(s) + (top >> 7) * secretU32(u32(19)))
        x25519Chain(s)
    }
    // Subtract p when the value is at least p: that is when adding 19 reaches 2^255.
    x25519Copy(bias, s)
    x25519Store(bias, x25519Load(bias) + secretU32(u32(19)))
    x25519Chain(bias)
    val reaches = ctFromLowBit(x25519Load(bias + 124) >> 7)
    x25519Store(s, x25519Load(s) + (secretU32(u32(19)) & reaches))
    x25519Chain(s)
    x25519Store(s + 124, x25519Load(s + 124) & secretU32(u32(127)))
    for (i in 0 until 32) ablaUnsafeStoreU8(x25519Pointer(out + i), int(x25519Load(s + i * 4).declassify()))
}

// The work area one scalar multiplication takes. All of it is secret memory.
//   +0     the clamped scalar, 32 bytes
//   +128   the point's u coordinate, an element
//   +256   x1, x2, z2, x3, z3, A, AA, B, BB, E, C, D, DA, CB, tmp: fifteen elements (+0 to +1920)
//   +2176  the multiplication's scratch, 64 words
//   +2432  the inverse's four elements (to +2944)
//   +2944  the pack's scratch element, and +3200 its second
//   +3072  the result, 32 bytes
//   +3328  the point as given, 32 bytes
fun x25519WorkSize(): int = 3392

/** The Montgomery ladder of RFC 7748 section 5, 255 steps from bit 254 down, on the clamped scalar at `work` and the
 *  point at `work + 128`, leaving x2 and z2 at `work + 384` and `work + 512`. */
@noinline trusted fun x25519Ladder(work: int): void {
    val k = work
    val u = work + 128
    val e = work + 256
    val x1 = e
    val x2 = e + 128
    val z2 = e + 256
    val x3 = e + 384
    val z3 = e + 512
    val a = e + 640
    val aa = e + 768
    val b = e + 896
    val bb = e + 1024
    val ee = e + 1152
    val c = e + 1280
    val d = e + 1408
    val da = e + 1536
    val cb = e + 1664
    val tmp = e + 1792
    val t = work + 2176
    x25519Copy(x1, u)
    x25519Copy(x3, u)
    for (i in 0 until 32) {
        x25519Store(x2 + i * 4, secretU32(u32(if (i == 0) 1 else 0)))
        x25519Store(z2 + i * 4, secretU32(u32(0)))
        x25519Store(z3 + i * 4, secretU32(u32(if (i == 0) 1 else 0)))
    }
    var swap = secretU32(u32(0))
    for (step in 0 until 255) {
        val position = 254 - step
        val bit = (secretU32(u32(ablaUnsafeLoadU8(x25519Pointer(k + (position >> 3))))) >> (position & 7)) &
            secretU32(u32(1))
        swap = swap ^ bit
        val mask = ctFromLowBit(swap)
        x25519Swap(mask, x2, x3)
        x25519Swap(mask, z2, z3)
        swap = bit
        x25519Add(a, x2, z2)
        x25519Multiply(aa, a, a, t)
        x25519Sub(b, x2, z2)
        x25519Multiply(bb, b, b, t)
        x25519Sub(ee, aa, bb)
        x25519Add(c, x3, z3)
        x25519Sub(d, x3, z3)
        x25519Multiply(da, d, a, t)
        x25519Multiply(cb, c, b, t)
        x25519Add(tmp, da, cb)
        x25519Multiply(x3, tmp, tmp, t)
        x25519Sub(tmp, da, cb)
        x25519Multiply(tmp, tmp, tmp, t)
        x25519Multiply(z3, x1, tmp, t)
        x25519Multiply(x2, aa, bb, t)
        x25519MultiplyConstant(tmp, ee)
        x25519Add(tmp, aa, tmp)
        x25519Multiply(z2, ee, tmp, t)
    }
    val mask = ctFromLowBit(swap)
    x25519Swap(mask, x2, x3)
    x25519Swap(mask, z2, z3)
}

/** The scalar (32 bytes at `work`, as given) times the point (32 bytes at `work + 128`, as given, one byte
 *  to a word after this), result at `work + 3072`: clamps the scalar, drops the point's top bit, runs the ladder
 *  and multiplies by the inverse of z2. */
@noinline trusted fun x25519Compute(work: int): void {
    val k = work
    val u = work + 128
    // Decode the point: byte i is limb i, bit 255 is dropped (RFC 7748 section 5).
    for (i in 0 until 32) {
        val byte = secretU32(u32(ablaUnsafeLoadU8(x25519Pointer(work + 3328 + i))))
        x25519Store(u + i * 4, if (i == 31) byte & secretU32(u32(127)) else byte)
    }
    // Clamp the scalar: the low three bits clear, bit 255 clear and bit 254 set.
    val first = secretU32(u32(ablaUnsafeLoadU8(x25519Pointer(k))))
    ablaUnsafeStoreU8(x25519Pointer(k), int((first & secretU32(u32(248))).declassify()))
    val last = secretU32(u32(ablaUnsafeLoadU8(x25519Pointer(k + 31))))
    ablaUnsafeStoreU8(x25519Pointer(k + 31), int(((last & secretU32(u32(127))) | secretU32(u32(64))).declassify()))
    x25519Ladder(work)
    val x2 = work + 256 + 128
    val z2 = work + 256 + 256
    x25519Invert(work + 256 + 256, z2, work + 2432, work + 2176)
    x25519Multiply(x2, x2, z2, work + 2176)
    x25519Pack(work + 3072, x2, work + 2944, work + 3200)
}

/** All ones when the 32 bytes at `address` are all zero, else zero. */
@noinline trusted fun x25519IsZero(address: int): secretU32 {
    var accumulated = secretU32(u32(0))
    for (i in 0 until 32) accumulated = accumulated | secretU32(u32(ablaUnsafeLoadU8(x25519Pointer(address + i))))
    ctIsZero(accumulated)
}
// END X25519 SECRET CORE

private trusted fun x25519Wipe(address: int, size: int): void {
    for (at in 0 until size) ablaUnsafeVolatileStoreU8(address + at, 0)
}

private @noinline trusted fun x25519Work(scalar: string, point: string): CryptoResult {
    val work = cryptoAllocate(x25519WorkSize())
    x25519Wipe(work, x25519WorkSize())
    ablaUnsafeCopyMemory(work, ablaUnsafeStringAddress(scalar), 32)
    ablaUnsafeCopyMemory(work + 3328, ablaUnsafeStringAddress(point), 32)
    x25519Compute(work)
    val zero = x25519IsZero(work + 3072).declassify() != u32(0)
    var result = cryptoFailed("x25519: the shared secret is all zero (a point of small order)")
    if (!zero) {
        val bytes: array<int> = []
        for (i in 0 until 32) bytes.append(ablaUnsafeLoadU8(ablaUnsafePointerOffset(ablaUnsafeNullPointer(), work + 3072 + i)))
        result = CryptoResult(cryptoByteString(bytes), true, "")
    }
    x25519Wipe(work, x25519WorkSize())
    ablaUnsafeFree(ablaUnsafePointerOffset(ablaUnsafeNullPointer(), work))
    result
}

private fun x25519BasePoint(): string {
    val bytes: array<int> = [9]
    for (i in 1 until 32) bytes.append(0)
    cryptoByteString(bytes)
}

/** The X25519 function (RFC 7748 section 5): `scalar` times `point`, both 32 bytes, the result 32 bytes. For a
 *  key agreement, `scalar` is your private key and `point` the peer's public key. `ok` is false for a wrong length,
 *  and for an all-zero result. */
fun x25519(scalar: string, point: string): CryptoResult {
    if (scalar.size != 32) return cryptoFailed("x25519: the scalar is 32 bytes")
    if (point.size != 32) return cryptoFailed("x25519: the point is 32 bytes")
    val result = x25519Work(scalar, point)
    ctScrubStack2048()
    return result
}

/** The public key of a private key: x25519 of it and the base point 9. */
fun x25519PublicKey(scalar: string): CryptoResult = x25519(scalar, x25519BasePoint())
