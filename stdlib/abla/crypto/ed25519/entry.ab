// Ed25519 (RFC 8032) on bytes: public keys, signatures and verification. Constant time where a secret is involved.
// Everything else of the module (the arithmetic on raw addresses and the work areas it needs) is core.ab, which only the
// standard library's own modules import: no program names an address of its own through this module.
export import "abla/crypto/result"
import "core.ab" as core

fun ed25519PublicKey(seed: string): CryptoResult = core.ed25519PublicKey(seed)

fun ed25519Sign(seed: string, message: string): CryptoResult = core.ed25519Sign(seed, message)

fun ed25519SignWithPublicKey(seed: string, publicKey: string, message: string): CryptoResult = core.ed25519SignWithPublicKey(seed, publicKey, message)

fun ed25519Verify(publicKey: string, message: string, signature: string): bool = core.ed25519Verify(publicKey, message, signature)

