// Ed25519 (RFC 8032) on bytes: public keys, signatures and verification. Constant time where a secret is involved.
// Everything else of the module (the arithmetic on raw addresses and the work areas it needs) is core.ab, which only the
// standard library's own modules import: no program names an address of its own through this module.
export import "abla/crypto/result"
import "core.ab" as core

/** The public key (32 bytes) of a private key (a 32-byte seed): RFC 8032 section 5.1.5. */
fun ed25519PublicKey(seed: string): CryptoResult = core.ed25519PublicKey(seed)

/** The signature (64 bytes) of `message` under the private key `seed` (32 bytes): RFC 8032 section 5.1.6. Deterministic:
 *  the same seed and message give the same signature. */
fun ed25519Sign(seed: string, message: string): CryptoResult = core.ed25519Sign(seed, message)

/** As ed25519Sign, with the public key of `seed` already in hand (ed25519PublicKey(seed), 32 bytes: it is public, so a holder of the key keeps it and saves
 *  the multiplication of the base point that recomputing it costs, about half of a signature). A public key that is not the seed's gives a signature that
 *  does not verify. */
fun ed25519SignWithPublicKey(seed: string, publicKey: string, message: string): CryptoResult = core.ed25519SignWithPublicKey(seed, publicKey, message)

/** Whether `signature` (64 bytes) is `publicKey`'s signature of `message`: RFC 8032 section 5.1.7. The check is the strict
 *  one: S is below L, the public key is a point with a canonical encoding, and the encoding of [S]B - [k]A is R's bytes
 *  (so R is canonical and the cofactor is not cleared). Everything here is public: the doublings are shared by the two scalars, in windows of four bits. */
fun ed25519Verify(publicKey: string, message: string, signature: string): bool = core.ed25519Verify(publicKey, message, signature)

