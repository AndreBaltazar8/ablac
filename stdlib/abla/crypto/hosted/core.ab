// public: abla/crypto/hosted, abla/tls/hosted, abla/tls/pure
// Narrow OpenSSL libcrypto ABI shared by abla/crypto/hosted and abla/tls/hosted (it was abla/jwt's until abla/jwt moved to
// abla/crypto, #822). These are
// platform-library declarations. Importing the hosted TLS binding shares its
// OpenSSL_version_num declaration, which is what makes the build driver link
// OpenSSL, without a duplicate symbol when both modules are used. Every
// function below exists in both OpenSSL 1.1.1 and 3.x.

import "../../tls/hosted/openssl.ab"

/// Decodes a DER SubjectPublicKeyInfo, advancing the input cursor on success and returning null on failure.
trusted noescape extern:"c" fun d2i_PUBKEY(
    existing: i64*, cursor: i64*, length: int
): i64*
/// Releases a reference to the OpenSSL key.
trusted noescape extern:"c" fun EVP_PKEY_free(key: i64*): void

/// Allocates a digest context and returns null if allocation fails.
trusted noescape extern:"c" fun EVP_MD_CTX_new(): i64*
/// Frees the digest context and its owned resources.
trusted noescape extern:"c" fun EVP_MD_CTX_free(context: i64*): void
/// Returns OpenSSL's SHA-256 digest descriptor.
trusted noescape extern:"c" fun EVP_sha256(): i64*
/// Initializes signature verification for the key and digest and returns 1 on success.
trusted noescape extern:"c" fun EVP_DigestVerifyInit(
    context: i64*, keyContext: i64*, digest: i64*, engine: i64*, key: i64*
): i32
/// Verifies a one-shot signature, returning 1 for a match, 0 for a bad signature or a negative error.
trusted noescape extern:"c" fun EVP_DigestVerify(
    context: i64*, signature: i64*, signatureLength: int,
    message: i64*, messageLength: int
): i32
/// Clears the calling thread's OpenSSL error queue.
trusted noescape extern:"c" fun ERR_clear_error(): void
/// Creates a read-only BIO over caller-owned bytes and returns null if creation fails.
trusted noescape extern:"c" fun BIO_new_mem_buf(buffer: i64*, length: int): i64*
/// Releases the BIO and returns 1 on success.
trusted noescape extern:"c" fun BIO_free(bio: i64*): i32
/// Reads a PEM certificate from the BIO and returns null on failure.
trusted noescape extern:"c" fun PEM_read_bio_X509(
    bio: i64*, existing: i64*, callback: i64*, data: i64*
): i64*
/// Reads a PEM private key from the BIO and returns null on decoding or password failure.
trusted noescape extern:"c" fun PEM_read_bio_PrivateKey(
    bio: i64*, existing: i64*, callback: i64*, data: i64*
): i64*
/// Releases a reference to the X.509 certificate.
trusted noescape extern:"c" fun X509_free(certificate: i64*): void
