// public: abla/crypto/hosted, abla/tls/hosted, abla/tls/pure
// The part of OpenSSL's libcrypto ABI that abla/crypto/hosted and the TLS client
// identity use, beyond what abla/jwt and abla/tls/hosted declare. Importing the
// JWT file brings its declarations and OpenSSL_version_num, which is what makes
// the build driver link OpenSSL. Every function below exists in both OpenSSL
// 1.1.1 and 3.x: what 3.x spells differently (EVP_PKEY_bits, EVP_PKEY_id,
// EVP_PKEY_CTX_set_rsa_padding) is a macro in one of the two, so RSA_bits and
// EVP_PKEY_CTX_ctrl are used instead.

import "core.ab"

/// Allocates a cipher context and returns null if allocation fails.
trusted noescape extern:"c" fun EVP_CIPHER_CTX_new(): i64*
/// Frees the cipher context and its owned resources.
trusted noescape extern:"c" fun EVP_CIPHER_CTX_free(context: i64*): void
/// Runs a cipher-specific control operation and returns 1 on success.
trusted noescape extern:"c" fun EVP_CIPHER_CTX_ctrl(
    context: i64*, command: int, argument: int, pointer: i64*
): i32
/// Initializes an encryption or decryption context and returns 1 on success.
trusted noescape extern:"c" fun EVP_CipherInit_ex(
    context: i64*, cipher: i64*, engine: i64*, key: i64*, iv: i64*, encrypt: int
): i32
/// Processes input into the output buffer, writes the produced byte count and returns 1 on success.
trusted noescape extern:"c" fun EVP_CipherUpdate(
    context: i64*, output: i64*, outputLength: i64*, input: i64*, inputLength: int
): i32
/// Finalizes the cipher operation into the output buffer and returns 0 on padding, authentication or other failure.
trusted noescape extern:"c" fun EVP_CipherFinal_ex(
    context: i64*, output: i64*, outputLength: i64*
): i32
/// Returns the OpenSSL AES-128-ECB cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_128_ecb(): i64*
/// Returns the OpenSSL AES-192-ECB cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_192_ecb(): i64*
/// Returns the OpenSSL AES-256-ECB cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_256_ecb(): i64*
/// Returns the OpenSSL AES-128-CBC cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_128_cbc(): i64*
/// Returns the OpenSSL AES-192-CBC cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_192_cbc(): i64*
/// Returns the OpenSSL AES-256-CBC cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_256_cbc(): i64*
/// Returns the OpenSSL AES-128-GCM cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_128_gcm(): i64*
/// Returns the OpenSSL AES-192-GCM cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_192_gcm(): i64*
/// Returns the OpenSSL AES-256-GCM cipher descriptor.
trusted noescape extern:"c" fun EVP_aes_256_gcm(): i64*

/// Returns OpenSSL's SHA-1 digest descriptor.
trusted noescape extern:"c" fun EVP_sha1(): i64*
/// Initializes signature generation with the specified key and digest and returns 1 on success.
trusted noescape extern:"c" fun EVP_DigestSignInit(
    context: i64*, keyContext: i64*, digest: i64*, engine: i64*, key: i64*
): i32
/// Signs the message or reports the required signature capacity and returns 1 on success.
trusted noescape extern:"c" fun EVP_DigestSign(
    context: i64*, signature: i64*, signatureLength: i64*,
    message: i64*, messageLength: int
): i32

/// Allocates an empty OpenSSL key container and returns null if allocation fails.
trusted noescape extern:"c" fun EVP_PKEY_new(): i64*
/// Stores a retained RSA key reference in the container and returns 1 on success.
trusted noescape extern:"c" fun EVP_PKEY_set1_RSA(key: i64*, rsa: i64*): i32
/// Returns a retained RSA reference or null if the key cannot supply one.
trusted noescape extern:"c" fun EVP_PKEY_get1_RSA(key: i64*): i64*
/// Returns the RSA modulus size in bits.
trusted noescape extern:"c" fun RSA_bits(rsa: i64*): i32
/// Checks RSA private-key consistency and returns 1 for a valid key.
trusted noescape extern:"c" fun RSA_check_key(rsa: i64*): i32
/// Releases a reference to the RSA key.
trusted noescape extern:"c" fun RSA_free(rsa: i64*): void
/// Creates an operation context for the given algorithm ID and returns null on failure.
trusted noescape extern:"c" fun EVP_PKEY_CTX_new_id(keyType: int, engine: i64*): i64*
/// Initializes key generation and returns 1 on success.
trusted noescape extern:"c" fun EVP_PKEY_keygen_init(context: i64*): i32
/// Generates a key into the output pointer and returns 1 on success.
trusted noescape extern:"c" fun EVP_PKEY_keygen(context: i64*, key: i64*): i32
/// Returns a new PKCS#8 private key structure for the given key or null on error.
trusted noescape extern:"c" fun EVP_PKEY2PKCS8(key: i64*): i64*
/// Returns the DER byte count for PKCS#8 and writes the encoding when an output cursor is supplied.
trusted noescape extern:"c" fun i2d_PKCS8_PRIV_KEY_INFO(info: i64*, cursor: i64*): int
/// Frees the PKCS#8 private key structure.
trusted noescape extern:"c" fun PKCS8_PRIV_KEY_INFO_free(info: i64*): void
/// Returns the DER byte count for SubjectPublicKeyInfo and writes the encoding when an output cursor is supplied.
trusted noescape extern:"c" fun i2d_PUBKEY(key: i64*, cursor: i64*): int
/// Creates an operation context for the given key and returns null on failure.
trusted noescape extern:"c" fun EVP_PKEY_CTX_new(
    key: i64*, engine: i64*
): i64*
/// Frees the public-key operation context.
trusted noescape extern:"c" fun EVP_PKEY_CTX_free(context: i64*): void
/// Applies an algorithm-specific key context control and returns a positive value on success.
trusted noescape extern:"c" fun EVP_PKEY_CTX_ctrl(
    context: i64*, keyType: int, operation: int, command: int,
    argument: int, pointer: i64*
): i32
/// Initializes a public-key encryption operation and returns 1 on success.
trusted noescape extern:"c" fun EVP_PKEY_encrypt_init(context: i64*): i32
/// Encrypts the input or reports the required output capacity and returns 1 on success.
trusted noescape extern:"c" fun EVP_PKEY_encrypt(
    context: i64*, output: i64*, outputLength: i64*,
    input: i64*, inputLength: int
): i32
/// Initializes a private-key decryption operation and returns 1 on success.
trusted noescape extern:"c" fun EVP_PKEY_decrypt_init(context: i64*): i32
/// Decrypts the input or reports the required output capacity and returns 1 on success.
trusted noescape extern:"c" fun EVP_PKEY_decrypt(
    context: i64*, output: i64*, outputLength: i64*,
    input: i64*, inputLength: int
): i32

/// Detects and decodes a DER private key, returning null if decoding fails.
trusted noescape extern:"c" fun d2i_AutoPrivateKey(
    existing: i64*, cursor: i64*, length: int
): i64*
/// Decodes a DER certificate, returning null if decoding fails.
trusted noescape extern:"c" fun d2i_X509(
    existing: i64*, cursor: i64*, length: int
): i64*
/// Returns a retained public key from the certificate or null on error.
trusted noescape extern:"c" fun X509_get_pubkey(certificate: i64*): i64*
/// Returns 1 if the key matches the certificate's public key.
trusted noescape extern:"c" fun X509_check_private_key(
    certificate: i64*, key: i64*
): i32
/// Reads a PEM SubjectPublicKeyInfo from the BIO and returns null on failure.
trusted noescape extern:"c" fun PEM_read_bio_PUBKEY(
    bio: i64*, existing: i64*, callback: i64*, data: i64*
): i64*
/// Reads a PEM PKCS#1 RSA public key from the BIO and returns null on failure.
trusted noescape extern:"c" fun PEM_read_bio_RSAPublicKey(
    bio: i64*, existing: i64*, callback: i64*, data: i64*
): i64*
/// Decodes a DER PKCS#12 container, returning null if decoding fails.
trusted noescape extern:"c" fun d2i_PKCS12(
    existing: i64*, cursor: i64*, length: int
): i64*
/// Extracts a private key and certificates using the password and returns 1 on success.
trusted noescape extern:"c" fun PKCS12_parse(
    container: i64*, password: i64*, key: i64*, certificate: i64*, chain: i64*
): i32
/// Frees the decoded PKCS#12 container.
trusted noescape extern:"c" fun PKCS12_free(container: i64*): void
/// Returns the number of stack entries or -1 for a null stack.
trusted noescape extern:"c" fun OPENSSL_sk_num(stack: i64*): i32
/// Returns the entry at the indexed stack position or null if the position is invalid.
trusted noescape extern:"c" fun OPENSSL_sk_value(stack: i64*, index: int): i64*
/// Frees the stack container while leaving element ownership to the caller.
trusted noescape extern:"c" fun OPENSSL_sk_free(stack: i64*): void

/// Compares equal-length memory ranges in time independent of their contents and returns zero for equality.
trusted noescape extern:"c" fun CRYPTO_memcmp(
    left: i64*, right: i64*, length: int
): i32
/// Clears the writable byte range using OpenSSL's non-elidable wipe.
trusted noescape extern:"c" fun OPENSSL_cleanse(pointer: i64*, length: int): void
