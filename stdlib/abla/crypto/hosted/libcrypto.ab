// The part of OpenSSL's libcrypto ABI that abla/crypto/hosted and the TLS client
// identity use, beyond what abla/jwt and abla/tls/hosted declare. Importing the
// JWT file brings its declarations and OpenSSL_version_num, which is what makes
// the build driver link OpenSSL. Every function below exists in both OpenSSL
// 1.1.1 and 3.x: what 3.x spells differently (EVP_PKEY_bits, EVP_PKEY_id,
// EVP_PKEY_CTX_set_rsa_padding) is a macro in one of the two, so RSA_bits and
// EVP_PKEY_CTX_ctrl are used instead.

import "../../jwt/libcrypto.ab"

trusted noescape extern:"c" fun EVP_CIPHER_CTX_new(): i64*
trusted noescape extern:"c" fun EVP_CIPHER_CTX_free(context: i64*): void
trusted noescape extern:"c" fun EVP_CIPHER_CTX_ctrl(
    context: i64*, command: int, argument: int, pointer: i64*
): i32
trusted noescape extern:"c" fun EVP_CipherInit_ex(
    context: i64*, cipher: i64*, engine: i64*, key: i64*, iv: i64*, encrypt: int
): i32
trusted noescape extern:"c" fun EVP_CipherUpdate(
    context: i64*, output: i64*, outputLength: i64*, input: i64*, inputLength: int
): i32
trusted noescape extern:"c" fun EVP_CipherFinal_ex(
    context: i64*, output: i64*, outputLength: i64*
): i32
trusted noescape extern:"c" fun EVP_aes_128_ecb(): i64*
trusted noescape extern:"c" fun EVP_aes_192_ecb(): i64*
trusted noescape extern:"c" fun EVP_aes_256_ecb(): i64*
trusted noescape extern:"c" fun EVP_aes_128_cbc(): i64*
trusted noescape extern:"c" fun EVP_aes_192_cbc(): i64*
trusted noescape extern:"c" fun EVP_aes_256_cbc(): i64*
trusted noescape extern:"c" fun EVP_aes_128_gcm(): i64*
trusted noescape extern:"c" fun EVP_aes_192_gcm(): i64*
trusted noescape extern:"c" fun EVP_aes_256_gcm(): i64*

trusted noescape extern:"c" fun EVP_sha1(): i64*
trusted noescape extern:"c" fun EVP_DigestSignInit(
    context: i64*, keyContext: i64*, digest: i64*, engine: i64*, key: i64*
): i32
trusted noescape extern:"c" fun EVP_DigestSign(
    context: i64*, signature: i64*, signatureLength: i64*,
    message: i64*, messageLength: int
): i32

trusted noescape extern:"c" fun EVP_PKEY_new(): i64*
trusted noescape extern:"c" fun EVP_PKEY_set1_RSA(key: i64*, rsa: i64*): i32
trusted noescape extern:"c" fun EVP_PKEY_get1_RSA(key: i64*): i64*
trusted noescape extern:"c" fun RSA_bits(rsa: i64*): i32
trusted noescape extern:"c" fun RSA_check_key(rsa: i64*): i32
trusted noescape extern:"c" fun RSA_free(rsa: i64*): void
trusted noescape extern:"c" fun EVP_PKEY_CTX_new(
    key: i64*, engine: i64*
): i64*
trusted noescape extern:"c" fun EVP_PKEY_CTX_free(context: i64*): void
trusted noescape extern:"c" fun EVP_PKEY_CTX_ctrl(
    context: i64*, keyType: int, operation: int, command: int,
    argument: int, pointer: i64*
): i32
trusted noescape extern:"c" fun EVP_PKEY_encrypt_init(context: i64*): i32
trusted noescape extern:"c" fun EVP_PKEY_encrypt(
    context: i64*, output: i64*, outputLength: i64*,
    input: i64*, inputLength: int
): i32
trusted noescape extern:"c" fun EVP_PKEY_decrypt_init(context: i64*): i32
trusted noescape extern:"c" fun EVP_PKEY_decrypt(
    context: i64*, output: i64*, outputLength: i64*,
    input: i64*, inputLength: int
): i32

trusted noescape extern:"c" fun d2i_AutoPrivateKey(
    existing: i64*, cursor: i64*, length: int
): i64*
trusted noescape extern:"c" fun d2i_X509(
    existing: i64*, cursor: i64*, length: int
): i64*
trusted noescape extern:"c" fun X509_get_pubkey(certificate: i64*): i64*
trusted noescape extern:"c" fun X509_check_private_key(
    certificate: i64*, key: i64*
): i32
trusted noescape extern:"c" fun PEM_read_bio_PUBKEY(
    bio: i64*, existing: i64*, callback: i64*, data: i64*
): i64*
trusted noescape extern:"c" fun PEM_read_bio_RSAPublicKey(
    bio: i64*, existing: i64*, callback: i64*, data: i64*
): i64*
trusted noescape extern:"c" fun d2i_PKCS12(
    existing: i64*, cursor: i64*, length: int
): i64*
trusted noescape extern:"c" fun PKCS12_parse(
    container: i64*, password: i64*, key: i64*, certificate: i64*, chain: i64*
): i32
trusted noescape extern:"c" fun PKCS12_free(container: i64*): void
trusted noescape extern:"c" fun OPENSSL_sk_num(stack: i64*): i32
trusted noescape extern:"c" fun OPENSSL_sk_value(stack: i64*, index: int): i64*
trusted noescape extern:"c" fun OPENSSL_sk_free(stack: i64*): void

trusted noescape extern:"c" fun CRYPTO_memcmp(
    left: i64*, right: i64*, length: int
): i32
trusted noescape extern:"c" fun OPENSSL_cleanse(pointer: i64*, length: int): void
