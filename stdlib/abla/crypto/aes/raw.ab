// public: none
// The AES block calls and the wipe that take raw addresses: the standard library's own modules and its tests and tools import this file
// (--stdlib-internals), no program does.
import "entry.ab"
import "abla/ct"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/mmio"

// Overwrites the writable byte range using volatile stores so the wipe is retained.
trusted fun aesWipe(address: int, size: int): void {
    // Volatile stores retain the wipe even when it immediately precedes free.
    for (at in 0 until size) ablaUnsafeVolatileStoreU8(address + at, 0)
}

// --- Blocks: hardware or software, input and output may be the same memory ------------------
trusted fun aesSoftBlocks(key: AesKey, encrypt: bool, input: int, output: int, count: int): void {
    val q = key.memory
    val keys = key.schedule() + (key.rounds + 1) * 16
    var block = 0
    while (block < count) {
        val second = block + 1 < count
        for (i in 0 until 4) {
            aesStore(q + i * 8, aesLoadBytes(input + block * 16 + i * 4))
            aesStore(q + i * 8 + 4,
                if (second) aesLoadBytes(input + (block + 1) * 16 + i * 4) else secretU32(u32(0)))
        }
        aesOrthogonalize(q)
        if (encrypt) aesSoftEncryptCore(q, keys, key.rounds) else aesSoftDecryptCore(q, keys,
            key.rounds)
        aesOrthogonalize(q)
        for (i in 0 until 4) {
            aesStoreBytes(output + block * 16 + i * 4, aesLoad(q + i * 8))
            if (second) aesStoreBytes(output + (block + 1) * 16 + i * 4, aesLoad(q + i * 8 + 4))
        }
        block = block + 2
    }
    aesWipe(q, 32)
}

// Encrypts or decrypts the requested complete blocks using the key's selected implementation and valid buffers.
trusted fun aesBlocks(key: AesKey, encrypt: bool, input: int, output: int, count: int): void {
    if (key.hardware) {
        if (encrypt) aesHardwareEncrypt(key, input, output, count)
        else aesHardwareDecrypt(key, input, output, count)
    } else aesSoftBlocks(key, encrypt, input, output, count)
}

