// public: none
// The AES block calls and the wipe that take raw addresses: the standard library's own modules and its tests and tools import this file
// (--stdlib-internals), no program does.
import "entry.ab"
import "abla/ct"
import "abla/simd"
import "abla/simd/target"
import "../../simd/raw.ab"
import "../../simd/byte-lanes.ab"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/mmio"

// Overwrites the writable byte range using volatile stores so the wipe is retained.
trusted fun aesWipe(address: int, size: int): void {
    // Volatile stores retain the wipe even when it immediately precedes free.
    for (at in 0 until size) ablaUnsafeVolatileStoreU8(address + at, 0)
}

// --- Blocks: hardware or software, input and output may be the same memory ------------------
trusted fun aesSoftBlocks(key: AesKey, encrypt: bool, input: int, output: int, count: int): void {
    val q = key.memory
    val keys = key.schedule() + (key.rounds + 1) * 16
    var block = 0
    while (block < count) {
        val second = block + 1 < count
        for (i in 0 until 4) {
            aesStore(q + i * 8, aesLoadBytes(input + block * 16 + i * 4))
            aesStore(q + i * 8 + 4,
                if (second) aesLoadBytes(input + (block + 1) * 16 + i * 4) else secretU32(u32(0)))
        }
        aesOrthogonalize(q)
        if (encrypt) aesSoftEncryptCore(q, keys, key.rounds) else aesSoftDecryptCore(q, keys,
            key.rounds)
        aesOrthogonalize(q)
        for (i in 0 until 4) {
            aesStoreBytes(output + block * 16 + i * 4, aesLoad(q + i * 8))
            if (second) aesStoreBytes(output + (block + 1) * 16 + i * 4, aesLoad(q + i * 8 + 4))
        }
        block = block + 2
    }
    aesWipe(q, 32)
}

// Encrypts or decrypts the requested complete blocks using the key's selected implementation and valid buffers.
trusted fun aesBlocks(key: AesKey, encrypt: bool, input: int, output: int, count: int): void {
    if (key.hardware) {
        if (encrypt) aesHardwareEncrypt(key, input, output, count)
        else aesHardwareDecrypt(key, input, output, count)
    } else aesSoftBlocks(key, encrypt, input, output, count)
}

// Decrypts the requested number of complete blocks using an AES-capable CPU and valid buffers.
@target("aes")
@noinline trusted fun aesHardwareDecrypt(key: AesKey, input: int, output: int, count: int): void =
    aesHardwareDecryptAt(key.decryption(), key.rounds, input, output, count)

// Encrypts the requested number of complete blocks using an AES-capable CPU and valid buffers.
@target("aes")
@noinline trusted fun aesHardwareEncrypt(key: AesKey, input: int, output: int, count: int): void =
    aesHardwareEncryptAt(key.schedule(), key.rounds, input, output, count)

// Returns a secret 32-bit word from readable native storage.
@inline trusted fun aesLoad(address: int): secretU32 =
    secretU32(u32(ablaUnsafeLoadU32(aesPointer(address))))

// A little-endian word from memory of any alignment (a string's).
@inline trusted fun aesLoadBytes(address: int): secretU32 {
    val b0 = u32(ablaUnsafeLoadU8(aesPointer(address)))
    val b1 = u32(ablaUnsafeLoadU8(aesPointer(address + 1)))
    val b2 = u32(ablaUnsafeLoadU8(aesPointer(address + 2)))
    val b3 = u32(ablaUnsafeLoadU8(aesPointer(address + 3)))
    secretU32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
}

/** Turns words of bytes into words of one bit each, and back: its own inverse. */
@inline trusted fun aesOrthogonalize(q: int): void {
    for (i in 0 until 4) {
        val x = aesLoad(q + i * 8)
        val y = aesLoad(q + i * 8 + 4)
        aesStore(q + i * 8, aesSwap(x, y, u32(1431655765), u32(2863311530), 1, true))
        aesStore(q + i * 8 + 4, aesSwap(x, y, u32(1431655765), u32(2863311530), 1, false))
    }
    for (i in [0, 1, 4, 5]) {
        val x = aesLoad(q + i * 4)
        val y = aesLoad(q + (i + 2) * 4)
        aesStore(q + i * 4, aesSwap(x, y, u32(858993459), u32(3435973836), 2, true))
        aesStore(q + (i + 2) * 4, aesSwap(x, y, u32(858993459), u32(3435973836), 2, false))
    }
    for (i in 0 until 4) {
        val x = aesLoad(q + i * 4)
        val y = aesLoad(q + (i + 4) * 4)
        aesStore(q + i * 4, aesSwap(x, y, u32(252645135), u32(4042322160), 4, true))
        aesStore(q + (i + 4) * 4, aesSwap(x, y, u32(252645135), u32(4042322160), 4, false))
    }
}

// --- Memory: raw words, aligned because this module allocates them --------------------------
@inline trusted fun aesPointer(address: int): i64* =
    ablaUnsafePointerOffset(ablaUnsafeNullPointer(), address)

// Decrypts the valid bitsliced state in place with the supplied round schedule.
@noinline trusted fun aesSoftDecryptCore(q: int, keys: int, rounds: int): void =
    aesSoftDecryptBody(q, keys, rounds)

// Encrypts the valid bitsliced state in place with the supplied round schedule.
@noinline trusted fun aesSoftEncryptCore(q: int, keys: int, rounds: int): void =
    aesSoftEncryptBody(q, keys, rounds)

// Stores a secret 32-bit word at a writable native address.
@inline trusted fun aesStore(address: int, value: secretU32): void =
    ablaUnsafeStoreU32(aesPointer(address), int(value.declassify()))

// Stores the secret word as four little-endian bytes, allowing unaligned storage.
@inline trusted fun aesStoreBytes(address: int, value: secretU32): void {
    val bits = value.declassify()
    ablaUnsafeStoreU8(aesPointer(address), int(bits & u32(255)))
    ablaUnsafeStoreU8(aesPointer(address + 1), int((bits >> 8) & u32(255)))
    ablaUnsafeStoreU8(aesPointer(address + 2), int((bits >> 16) & u32(255)))
    ablaUnsafeStoreU8(aesPointer(address + 3), int(bits >> 24))
}

// Runs the inverse AES rounds on a bitsliced state using the expanded keys.
@inline trusted fun aesSoftDecryptBody(q: int, keys: int, rounds: int): void {
    aesAddRoundKey(q, keys + rounds * 32)
    var round = rounds - 1
    while (round >= 1) {
        aesInvShiftRows(q)
        aesInvSubBytes(q)
        aesAddRoundKey(q, keys + round * 32)
        aesInvMixColumns2(q)
        round = round - 1
    }
    aesInvShiftRows(q)
    aesInvSubBytes(q)
    aesAddRoundKey(q, keys)
}

/** Encrypts the two blocks in `q`, already orthogonalized, under `keys`: 8 words a round. */
@inline trusted fun aesSoftEncryptBody(q: int, keys: int, rounds: int): void {
    aesAddRoundKey(q, keys)
    for (round in 1 until rounds) {
        aesSubBytes(q)
        aesShiftRows(q)
        aesMixColumns(q)
        aesAddRoundKey(q, keys + round * 32)
    }
    aesSubBytes(q)
    aesShiftRows(q)
    aesAddRoundKey(q, keys + rounds * 32)
}

// XORs the round-key words into the bitsliced AES state.
@inline trusted fun aesAddRoundKey(q: int, key: int): void {
    for (i in 0 until 8) aesStore(q + i * 4, aesLoad(q + i * 4) ^ aesLoad(key + i * 4))
}

// InvMixColumns is MixColumns after adding {04}(s0 + s2) to s0 and s2, and {04}(s1 + s3) to s1 and s3.
@inline trusted fun aesInvMixColumns2(q: int): void {
    val t0 = aesLoad(q) ^ aesLoad(q).rotr(16)
    val t1 = aesLoad(q + 4) ^ aesLoad(q + 4).rotr(16)
    val t2 = aesLoad(q + 8) ^ aesLoad(q + 8).rotr(16)
    val t3 = aesLoad(q + 12) ^ aesLoad(q + 12).rotr(16)
    val t4 = aesLoad(q + 16) ^ aesLoad(q + 16).rotr(16)
    val t5 = aesLoad(q + 20) ^ aesLoad(q + 20).rotr(16)
    val t6 = aesLoad(q + 24) ^ aesLoad(q + 24).rotr(16)
    val t7 = aesLoad(q + 28) ^ aesLoad(q + 28).rotr(16)
    aesStore(q, aesLoad(q) ^ t6)
    aesStore(q + 4, aesLoad(q + 4) ^ t6 ^ t7)
    aesStore(q + 8, aesLoad(q + 8) ^ t0 ^ t7)
    aesStore(q + 12, aesLoad(q + 12) ^ t1 ^ t6)
    aesStore(q + 16, aesLoad(q + 16) ^ t2 ^ t6 ^ t7)
    aesStore(q + 20, aesLoad(q + 20) ^ t3 ^ t7)
    aesStore(q + 24, aesLoad(q + 24) ^ t4)
    aesStore(q + 28, aesLoad(q + 28) ^ t5)
    aesMixColumns(q)
}

// Applies the inverse AES row permutation to the bitsliced state in place.
@inline trusted fun aesInvShiftRows(q: int): void {
    for (i in 0 until 8) {
        val x = aesLoad(q + i * 4)
        aesStore(q + i * 4, (x & secretU32(u32(255))) |
            aesMaskShift(x, u32(16128), 2, true) | aesMaskShift(x, u32(49152), 6, false) |
            aesMaskShift(x, u32(983040), 4, true) | aesMaskShift(x, u32(15728640), 4, false) |
            aesMaskShift(x, u32(50331648), 6, true) | aesMaskShift(x, u32(4227858432), 2, false))
    }
}

// Applies the inverse AES byte substitution to the bitsliced state in place.
@inline trusted fun aesInvSubBytes(q: int): void {
    aesInvAffine(q)
    aesSubBytes(q)
    aesInvAffine(q)
}

// Applies the AES column mixing step to the bitsliced state in place.
@inline trusted fun aesMixColumns(q: int): void {
    val q0 = aesLoad(q)
    val q1 = aesLoad(q + 4)
    val q2 = aesLoad(q + 8)
    val q3 = aesLoad(q + 12)
    val q4 = aesLoad(q + 16)
    val q5 = aesLoad(q + 20)
    val q6 = aesLoad(q + 24)
    val q7 = aesLoad(q + 28)
    val r0 = q0.rotr(8)
    val r1 = q1.rotr(8)
    val r2 = q2.rotr(8)
    val r3 = q3.rotr(8)
    val r4 = q4.rotr(8)
    val r5 = q5.rotr(8)
    val r6 = q6.rotr(8)
    val r7 = q7.rotr(8)
    aesStore(q, q7 ^ r7 ^ r0 ^ (q0 ^ r0).rotr(16))
    aesStore(q + 4, q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ (q1 ^ r1).rotr(16))
    aesStore(q + 8, q1 ^ r1 ^ r2 ^ (q2 ^ r2).rotr(16))
    aesStore(q + 12, q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ (q3 ^ r3).rotr(16))
    aesStore(q + 16, q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ (q4 ^ r4).rotr(16))
    aesStore(q + 20, q4 ^ r4 ^ r5 ^ (q5 ^ r5).rotr(16))
    aesStore(q + 24, q5 ^ r5 ^ r6 ^ (q6 ^ r6).rotr(16))
    aesStore(q + 28, q6 ^ r6 ^ r7 ^ (q7 ^ r7).rotr(16))
}

// Applies the AES row permutation to the bitsliced state in place.
@inline trusted fun aesShiftRows(q: int): void {
    for (i in 0 until 8) {
        val x = aesLoad(q + i * 4)
        aesStore(q + i * 4, (x & secretU32(u32(255))) |
            aesMaskShift(x, u32(64512), 2, false) | aesMaskShift(x, u32(768), 6, true) |
            aesMaskShift(x, u32(15728640), 4, false) | aesMaskShift(x, u32(983040), 4, true) |
            aesMaskShift(x, u32(3221225472), 6, false) | aesMaskShift(x, u32(1056964608), 2, true))
    }
}

/** The AES S-box on all 32 bits at once: Boyar and Peralta's 113-gate circuit. */
@inline trusted fun aesSubBytes(q: int): void {
    val x0 = aesLoad(q + 28)
    val x1 = aesLoad(q + 24)
    val x2 = aesLoad(q + 20)
    val x3 = aesLoad(q + 16)
    val x4 = aesLoad(q + 12)
    val x5 = aesLoad(q + 8)
    val x6 = aesLoad(q + 4)
    val x7 = aesLoad(q)
    val y14 = x3 ^ x5
    val y13 = x0 ^ x6
    val y9 = x0 ^ x3
    val y8 = x0 ^ x5
    val t0 = x1 ^ x2
    val y1 = t0 ^ x7
    val y4 = y1 ^ x3
    val y12 = y13 ^ y14
    val y2 = y1 ^ x0
    val y5 = y1 ^ x6
    val y3 = y5 ^ y8
    val t1 = x4 ^ y12
    val y15 = t1 ^ x5
    val y20 = t1 ^ x1
    val y6 = y15 ^ x7
    val y10 = y15 ^ t0
    val y11 = y20 ^ y9
    val y7 = x7 ^ y11
    val y17 = y10 ^ y11
    val y19 = y10 ^ y8
    val y16 = t0 ^ y11
    val y21 = y13 ^ y16
    val y18 = x0 ^ y16
    val t2 = y12 & y15
    val t3 = y3 & y6
    val t4 = t3 ^ t2
    val t5 = y4 & x7
    val t6 = t5 ^ t2
    val t7 = y13 & y16
    val t8 = y5 & y1
    val t9 = t8 ^ t7
    val t10 = y2 & y7
    val t11 = t10 ^ t7
    val t12 = y9 & y11
    val t13 = y14 & y17
    val t14 = t13 ^ t12
    val t15 = y8 & y10
    val t16 = t15 ^ t12
    val t17 = t4 ^ t14
    val t18 = t6 ^ t16
    val t19 = t9 ^ t14
    val t20 = t11 ^ t16
    val t21 = t17 ^ y20
    val t22 = t18 ^ y19
    val t23 = t19 ^ y21
    val t24 = t20 ^ y18
    val t25 = t21 ^ t22
    val t26 = t21 & t23
    val t27 = t24 ^ t26
    val t28 = t25 & t27
    val t29 = t28 ^ t22
    val t30 = t23 ^ t24
    val t31 = t22 ^ t26
    val t32 = t31 & t30
    val t33 = t32 ^ t24
    val t34 = t23 ^ t33
    val t35 = t27 ^ t33
    val t36 = t24 & t35
    val t37 = t36 ^ t34
    val t38 = t27 ^ t36
    val t39 = t29 & t38
    val t40 = t25 ^ t39
    val t41 = t40 ^ t37
    val t42 = t29 ^ t33
    val t43 = t29 ^ t40
    val t44 = t33 ^ t37
    val t45 = t42 ^ t41
    val z0 = t44 & y15
    val z1 = t37 & y6
    val z2 = t33 & x7
    val z3 = t43 & y16
    val z4 = t40 & y1
    val z5 = t29 & y7
    val z6 = t42 & y11
    val z7 = t45 & y17
    val z8 = t41 & y10
    val z9 = t44 & y12
    val z10 = t37 & y3
    val z11 = t33 & y4
    val z12 = t43 & y13
    val z13 = t40 & y5
    val z14 = t29 & y2
    val z15 = t42 & y9
    val z16 = t45 & y14
    val z17 = t41 & y8
    val t46 = z15 ^ z16
    val t47 = z10 ^ z11
    val t48 = z5 ^ z13
    val t49 = z9 ^ z10
    val t50 = z2 ^ z12
    val t51 = z2 ^ z5
    val t52 = z7 ^ z8
    val t53 = z0 ^ z3
    val t54 = z6 ^ z7
    val t55 = z16 ^ z17
    val t56 = z12 ^ t48
    val t57 = t50 ^ t53
    val t58 = z4 ^ t46
    val t59 = z3 ^ t54
    val t60 = t46 ^ t57
    val t61 = z14 ^ t57
    val t62 = t52 ^ t58
    val t63 = t49 ^ t58
    val t64 = z4 ^ t59
    val t65 = t61 ^ t62
    val t66 = z1 ^ t63
    val s0 = t59 ^ t63
    val s6 = t56 ^ ~t62
    val s7 = t48 ^ ~t60
    val t67 = t64 ^ t65
    val s3 = t53 ^ t66
    val s4 = t51 ^ t66
    val s5 = t47 ^ t65
    val s1 = t64 ^ ~s3
    val s2 = t55 ^ ~t67
    aesStore(q + 28, s0)
    aesStore(q + 24, s1)
    aesStore(q + 20, s2)
    aesStore(q + 16, s3)
    aesStore(q + 12, s4)
    aesStore(q + 8, s5)
    aesStore(q + 4, s6)
    aesStore(q, s7)
}

/** The inverse S-box: the forward one between two affine maps. */
@inline trusted fun aesInvAffine(q: int): void {
    val q0 = ~aesLoad(q)
    val q1 = ~aesLoad(q + 4)
    val q2 = aesLoad(q + 8)
    val q3 = aesLoad(q + 12)
    val q4 = aesLoad(q + 16)
    val q5 = ~aesLoad(q + 20)
    val q6 = ~aesLoad(q + 24)
    val q7 = aesLoad(q + 28)
    aesStore(q + 28, q1 ^ q4 ^ q6)
    aesStore(q + 24, q0 ^ q3 ^ q5)
    aesStore(q + 20, q7 ^ q2 ^ q4)
    aesStore(q + 16, q6 ^ q1 ^ q3)
    aesStore(q + 12, q5 ^ q0 ^ q2)
    aesStore(q + 8, q4 ^ q7 ^ q1)
    aesStore(q + 4, q3 ^ q6 ^ q0)
    aesStore(q, q2 ^ q5 ^ q7)
}





// BEGIN AES KEY EXPANSION
// What touches a key, in functions of plain integers (addresses and counts, none of an object's fields) that call
// nothing but each other: tools/test-ct.sh reads this region as written, in a module of its own
// (tests/cases/ct/fixture.ab). What allocates or reads an object is above, given nothing secret, and not read
// there: the runtime's allocator and collector branch on state the checker can't tell from secrets, and an
// object's fields are public but look like any other load.
/** SubWord on one word, through the bitsliced S-box. */
trusted fun aesSubWord(q: int, word: secretU32): secretU32 {
    aesStore(q, word)
    for (i in 1 until 8) aesStore(q + i * 4, secretU32(u32(0)))
    aesOrthogonalize(q)
    aesSubBytes(q)
    aesOrthogonalize(q)
    aesLoad(q)
}

val AES_SCRATCH_BYTES = 64

/** Where the decryption keys hardware wants lie: after the schedule and the bitsliced keys. */
@inline fun aesDecryptionAt(schedule: int, rounds: int): int =
    schedule + (rounds + 1) * 4 * 4 + (rounds + 1) * 32

/** The schedule, the bitsliced round keys and, for hardware rounds, the decryption keys of the key at `source`. */
@noinline trusted fun aesExpandSchedule(memory: int, source: int, count: int,
    hardware: bool): void {
    val words = count / 4
    val rounds = words + 6
    val total = 4 * (rounds + 1)
    val schedule = memory + AES_SCRATCH_BYTES
    for (i in 0 until words) aesStore(schedule + i * 4, aesLoadBytes(source + i * 4))
    var rcon = secretU32(u32(1))
    for (i in words until total) {
        var t = aesLoad(schedule + (i - 1) * 4)
        if (i % words == 0) {
            t = aesSubWord(memory, t.rotr(8)) ^ rcon
            // Doubling in GF(2^8); the round constant is public, so this could be plainer.
            val top = (rcon >> 7) & secretU32(u32(1))
            rcon = ((rcon << 1) ^ (top * secretU32(u32(283)))) & secretU32(u32(255))
        } else if (words > 6 && i % words == 4) {
            t = aesSubWord(memory, t)
        }
        aesStore(schedule + i * 4, aesLoad(schedule + (i - words) * 4) ^ t)
    }
    // The same words, orthogonalized, two copies of each: what aesAddRoundKey adds.
    val sliced = schedule + total * 4
    for (round in 0 .. rounds) {
        for (i in 0 until 4) {
            val word = aesLoad(schedule + (round * 4 + i) * 4)
            aesStore(sliced + round * 32 + i * 8, word)
            aesStore(sliced + round * 32 + i * 8 + 4, word)
        }
        aesOrthogonalize(sliced + round * 32)
    }
    if (hardware) aesDecryptionKeys(schedule, aesDecryptionAt(schedule, rounds), rounds)
}

// --- Hardware rounds: only ever reached past cpuHas -----------------------------------------
/** The decryption keys: the round keys with InvMixColumns applied to all but the first and the last. */
@target("aes") @noinline trusted fun aesDecryptionKeys(schedule: int, out: int,
    rounds: int): void {
    for (round in 0 .. rounds) {
        val roundKey = u8x16LoadAddress(schedule + round * 16)
        val turned = if (round == 0 || round == rounds) roundKey else aesInvMixColumns(roundKey)
        turned.storeAddress(out + round * 16)
    }
}


@target("aes") @noinline trusted fun aesHardwareEncryptAt(schedule: int, rounds: int,
    input: int, output: int, count: int): void {
    for (block in 0 until count) {
        var state = u8x16LoadAddress(input + block * 16) ^ u8x16LoadAddress(schedule)
        for (round in 1 until rounds) {
            state = aesEncRound(state, u8x16LoadAddress(schedule + round * 16))
        }
        aesEncLastRound(state,
            u8x16LoadAddress(schedule + rounds * 16)).storeAddress(output + block * 16)
    }
}

@target("aes") @noinline trusted fun aesHardwareDecryptAt(keys: int, rounds: int,
    input: int, output: int, count: int): void {
    for (block in 0 until count) {
        var state = u8x16LoadAddress(input + block * 16) ^ u8x16LoadAddress(keys + rounds * 16)
        var round = rounds - 1
        while (round >= 1) {
            state = aesDecRound(state, u8x16LoadAddress(keys + round * 16))
            round = round - 1
        }
        aesDecLastRound(state, u8x16LoadAddress(keys)).storeAddress(output + block * 16)
    }
}

// END AES KEY EXPANSION
@target("aes") @noinline trusted fun aesCtrHardware(schedule: int, rounds: int, counter: int, scratch: int, input: int, output: int, size: int): void {
    val prefix = u32x4LoadAddress(counter)
    var count = int(aesLoadBig(counter + 12).declassify())
    val first = u8x16LoadAddress(schedule)
    val last = u8x16LoadAddress(schedule + rounds * 16)
    var at = 0
    while (size - at >= 128) {
        var s0 = prefix.with(3, aesSwapWord(count + 1)).asU8x16() ^ first
        var s1 = prefix.with(3, aesSwapWord(count + 2)).asU8x16() ^ first
        var s2 = prefix.with(3, aesSwapWord(count + 3)).asU8x16() ^ first
        var s3 = prefix.with(3, aesSwapWord(count + 4)).asU8x16() ^ first
        var s4 = prefix.with(3, aesSwapWord(count + 5)).asU8x16() ^ first
        var s5 = prefix.with(3, aesSwapWord(count + 6)).asU8x16() ^ first
        var s6 = prefix.with(3, aesSwapWord(count + 7)).asU8x16() ^ first
        var s7 = prefix.with(3, aesSwapWord(count + 8)).asU8x16() ^ first
        for (round in 1 until rounds) {
            val key = u8x16LoadAddress(schedule + round * 16)
            s0 = aesEncRound(s0, key)
            s1 = aesEncRound(s1, key)
            s2 = aesEncRound(s2, key)
            s3 = aesEncRound(s3, key)
            s4 = aesEncRound(s4, key)
            s5 = aesEncRound(s5, key)
            s6 = aesEncRound(s6, key)
            s7 = aesEncRound(s7, key)
        }
        (aesEncLastRound(s0, last) ^ u8x16LoadAddress(input + at)).storeAddress(output + at)
        (aesEncLastRound(s1, last) ^ u8x16LoadAddress(input + at + 16)).storeAddress(output + at + 16)
        (aesEncLastRound(s2, last) ^ u8x16LoadAddress(input + at + 32)).storeAddress(output + at + 32)
        (aesEncLastRound(s3, last) ^ u8x16LoadAddress(input + at + 48)).storeAddress(output + at + 48)
        (aesEncLastRound(s4, last) ^ u8x16LoadAddress(input + at + 64)).storeAddress(output + at + 64)
        (aesEncLastRound(s5, last) ^ u8x16LoadAddress(input + at + 80)).storeAddress(output + at + 80)
        (aesEncLastRound(s6, last) ^ u8x16LoadAddress(input + at + 96)).storeAddress(output + at + 96)
        (aesEncLastRound(s7, last) ^ u8x16LoadAddress(input + at + 112)).storeAddress(output + at + 112)
        count = count + 8
        at = at + 128
    }
    while (at < size) {
        count = count + 1
        var state = prefix.with(3, aesSwapWord(count)).asU8x16() ^ first
        for (round in 1 until rounds) state = aesEncRound(state, u8x16LoadAddress(schedule + round * 16))
        val block = aesEncLastRound(state, last)
        if (size - at >= 16) {
            (block ^ u8x16LoadAddress(input + at)).storeAddress(output + at)
            at = at + 16
        } else {
            block.storeAddress(scratch)
            for (i in 0 until size - at) {
                ablaUnsafeStoreU8(aesPointer(output + at + i), ablaUnsafeLoadU8(aesPointer(input + at + i)) ^ ablaUnsafeLoadU8(aesPointer(scratch + i)))
            }
            aesWipe(scratch, 16)
            at = size
        }
    }
    aesStoreBig(counter + 12, secretU32(u32(count & 4294967295)))
}

// --- ECB and CBC ---------------------------------------------------------------------------
// The padding is checked in a way that doesn't branch on its bytes, though the answer is still an
// answer: see "padding oracle" in the docs.
@inline trusted fun aesPaddingBad(address: int): secretU32 {
    val last = secretU32(u32(ablaUnsafeLoadU8(aesPointer(address + 15))))
    var bad = ctIsZero(last) | ~ctLt(last, secretU32(u32(17)))
    for (at in 0 until 16) {
        val byte = secretU32(u32(ablaUnsafeLoadU8(aesPointer(address + 15 - at))))
        // A byte inside the padding has to be the padding's length.
        val inside = ctLt(secretU32(u32(at)), last)
        bad = bad | (inside & ~ctEq(byte, last))
    }
    bad
}

@target("clmul") @noinline trusted fun ghashHardwareFour(y: int, h: int, powers: int, input: int): void {
    val a1 = ghashReverse(u8x16LoadAddress(y) ^ u8x16LoadAddress(input)).asU64x2()
    val a2 = ghashReverse(u8x16LoadAddress(input + 16)).asU64x2()
    val a3 = ghashReverse(u8x16LoadAddress(input + 32)).asU64x2()
    val a4 = ghashReverse(u8x16LoadAddress(input + 48)).asU64x2()
    val b1 = ghashReverse(u8x16LoadAddress(powers + 32)).asU64x2()
    val b2 = ghashReverse(u8x16LoadAddress(powers + 16)).asU64x2()
    val b3 = ghashReverse(u8x16LoadAddress(powers)).asU64x2()
    val b4 = ghashReverse(u8x16LoadAddress(h)).asU64x2()
    val low = clmul(a1, b1, 0) ^ clmul(a2, b2, 0) ^ clmul(a3, b3, 0) ^ clmul(a4, b4, 0)
    val middle = clmul(a1, b1, 16) ^ clmul(a1, b1, 1) ^ clmul(a2, b2, 16) ^ clmul(a2, b2, 1) ^
        clmul(a3, b3, 16) ^ clmul(a3, b3, 1) ^ clmul(a4, b4, 16) ^ clmul(a4, b4, 1)
    val high = clmul(a1, b1, 17) ^ clmul(a2, b2, 17) ^ clmul(a3, b3, 17) ^ clmul(a4, b4, 17)
    val t3 = (low ^ ghashBytesLeft8(middle)).asU32x4()
    val t6 = (high ^ ghashBytesRight8(middle)).asU32x4()
    val carry3 = t3 >> 31
    val carry6 = t6 >> 31
    val shifted3 = (t3 << 1) | ghashWordsLeft1(carry3)
    val shifted6 = (t6 << 1) | ghashWordsLeft1(carry6) | ghashWordsRight3(carry3)
    val first = (shifted3 << 31) ^ (shifted3 << 30) ^ (shifted3 << 25)
    val reduced = shifted3 ^ ghashWordsLeft3(first)
    val second = (reduced >> 1) ^ (reduced >> 2) ^ (reduced >> 7) ^ ghashWordsRight1(first)
    val result = shifted6 ^ reduced ^ second
    ghashReverse(result.asU8x16()).storeAddress(y)
}

/** As ghashSoftMultiply, with carry-less multiply (Gueron and Kounavis's reduction). */
@target("clmul") @noinline trusted fun ghashHardwareMultiply(y: int, h: int): void {
    val a = ghashReverse(u8x16LoadAddress(y)).asU64x2()
    val b = ghashReverse(u8x16LoadAddress(h)).asU64x2()
    val low = clmul(a, b, 0)
    val middle = clmul(a, b, 16) ^ clmul(a, b, 1)
    val high = clmul(a, b, 17)
    val t3 = (low ^ ghashBytesLeft8(middle)).asU32x4()
    val t6 = (high ^ ghashBytesRight8(middle)).asU32x4()
    // One bit left, for GCM's reflected bit order.
    val carry3 = t3 >> 31
    val carry6 = t6 >> 31
    val shifted3 = (t3 << 1) | ghashWordsLeft1(carry3)
    val shifted6 = (t6 << 1) | ghashWordsLeft1(carry6) | ghashWordsRight3(carry3)
    // Reduction modulo x^128 + x^7 + x^2 + x + 1.
    val first = (shifted3 << 31) ^ (shifted3 << 30) ^ (shifted3 << 25)
    val reduced = shifted3 ^ ghashWordsLeft3(first)
    val second = (reduced >> 1) ^ (reduced >> 2) ^ (reduced >> 7) ^ ghashWordsRight1(first)
    val result = shifted6 ^ reduced ^ second
    ghashReverse(result.asU8x16()).storeAddress(y)
}

/** `y` = `y` * `h`, both 16 big-endian bytes, in GCM's bit order. */
@inline trusted fun ghashSoftMultiplyBody(y: int, h: int): void {
    var v0 = aesLoadBig(h)
    var v1 = aesLoadBig(h + 4)
    var v2 = aesLoadBig(h + 8)
    var v3 = aesLoadBig(h + 12)
    var z0 = secretU32(u32(0))
    var z1 = secretU32(u32(0))
    var z2 = secretU32(u32(0))
    var z3 = secretU32(u32(0))
    for (word in 0 until 4) {
        val x = aesLoadBig(y + word * 4)
        for (bit in 0 until 32) {
            val take = ctFromLowBit(x >> (31 - bit))
            z0 = z0 ^ (v0 & take)
            z1 = z1 ^ (v1 & take)
            z2 = z2 ^ (v2 & take)
            z3 = z3 ^ (v3 & take)
            val reduce = ctFromLowBit(v3) & secretU32(u32(3774873600))
            v3 = (v3 >> 1) | (v2 << 31)
            v2 = (v2 >> 1) | (v1 << 31)
            v1 = (v1 >> 1) | (v0 << 31)
            v0 = (v0 >> 1) ^ reduce
        }
    }
    aesStoreBig(y, z0)
    aesStoreBig(y + 4, z1)
    aesStoreBig(y + 8, z2)
    aesStoreBig(y + 12, z3)
}

// Returns the secret word encoded by four big-endian bytes from readable storage.
@inline trusted fun aesLoadBig(address: int): secretU32 {
    val b0 = u32(ablaUnsafeLoadU8(aesPointer(address)))
    val b1 = u32(ablaUnsafeLoadU8(aesPointer(address + 1)))
    val b2 = u32(ablaUnsafeLoadU8(aesPointer(address + 2)))
    val b3 = u32(ablaUnsafeLoadU8(aesPointer(address + 3)))
    secretU32((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

// Stores a secret word as four big-endian bytes at a writable address.
@inline trusted fun aesStoreBig(address: int, value: secretU32): void {
    val bits = value.declassify()
    ablaUnsafeStoreU8(aesPointer(address), int(bits >> 24))
    ablaUnsafeStoreU8(aesPointer(address + 1), int((bits >> 16) & u32(255)))
    ablaUnsafeStoreU8(aesPointer(address + 2), int((bits >> 8) & u32(255)))
    ablaUnsafeStoreU8(aesPointer(address + 3), int(bits & u32(255)))
}

