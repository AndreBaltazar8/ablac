// public: none
// The RSA private-key arithmetic that takes raw addresses (the CRT, the wide reduction): the standard library's own modules and its tests and tools
// import this file (--stdlib-internals), no program does.
import "entry.ab"
import "abla/ct"
import "abla/crypto/bignum"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

/** `out` = a * b mod the modulus, all in plain form. */
trusted fun rsaMultiplyPlain(modulus: BnModulus, out: int, a: int, b: int): void {
    val encoded = bnAllocate(modulus.words)
    bnEncode(modulus, encoded, a)
    bnMultiply(modulus, out, encoded, b)
    bnRelease(encoded, modulus.words)
}

/** `out` = `value`, of 2 * words limbs, mod the modulus: low + high * 2^k, by multiplying each part. */
trusted fun rsaReduceWide(modulus: BnModulus, out: int, value: int): void {
    val words = modulus.words
    val high = bnAllocate(words)
    // A multiplication by 2^2k mod m is one by 2^k: high * 2^k as it stands, and low made plain again.
    bnMultiply(modulus, high, value + words * 4, modulus.square())
    bnEncode(modulus, out, value)
    bnDecode(modulus, out, out)
    var carry = secretU32(u32(0))
    for (j in 0 until words) {
        val x = bnLoad(out + j * 4)
        val y = bnLoad(high + j * 4)
        val sum = x + y + carry
        carry = ((x & y) | ((x | y) & ~sum)) >> 31
        bnStore(out + j * 4, sum)
    }
    bnConditionalSubtractBody(out, out, carry, modulus.value(), words, modulus.scratch())
    bnRelease(high, words)
}

/** `out` = `value` ^ d mod n, by CRT with fixed-window exponents. */
trusted fun rsaCrt(key: RsaPrivateKey, modulus: BnModulus, out: int, value: int): void {
    val words = key.primeWords
    val p = rsaModulusFromLimbs(key.primeP(), words)
    val q = rsaModulusFromLimbs(key.primeQ(), words)
    val m1 = bnAllocate(words)
    val m2 = bnAllocate(words)
    val h = bnAllocate(words)
    val wide = words * 2
    val nWords = modulus.words
    val padded = bnAllocate(wide)
    bnCopy(padded, value, nWords)
    rsaReduceWide(p, m1, padded)
    rsaReduceWide(q, m2, padded)
    bnExpSecret(p, m1, m1, key.exponentP(), words * 32)
    bnExpSecret(q, m2, m2, key.exponentQ(), words * 32)
    // h = qInverse * (m1 - m2) mod p, with m2 first reduced mod p: q may be the larger.
    val m2p = bnAllocate(words)
    bnEncode(p, m2p, m2)
    bnDecode(p, m2p, m2p)
    var borrow = secretU32(u32(0))
    for (j in 0 until words) {
        val x = bnLoad(m1 + j * 4)
        val y = bnLoad(m2p + j * 4)
        val difference = x - y - borrow
        borrow = ((~x & y) | ((~x | y) & difference)) >> 31
        bnStore(h + j * 4, difference)
    }
    // Add p back if that went below zero.
    val negative = ctFromLowBit(borrow)
    var carry = secretU32(u32(0))
    for (j in 0 until words) {
        val x = bnLoad(h + j * 4)
        val y = bnLoad(p.value() + j * 4) & negative
        val sum = x + y + carry
        carry = ((x & y) | ((x | y) & ~sum)) >> 31
        bnStore(h + j * 4, sum)
    }
    rsaMultiplyPlain(p, h, h, key.inverseQ())
    // out = m2 + h * q, which is below the modulus, whatever room the product had.
    bnMultiplyPlain(padded, h, words, key.primeQ(), words)
    carry = secretU32(u32(0))
    for (j in 0 until wide) {
        val x = bnLoad(padded + j * 4)
        val y = if (j < words) bnLoad(m2 + j * 4) else secretU32(u32(0))
        val sum = x + y + carry
        carry = ((x & y) | ((x | y) & ~sum)) >> 31
        bnStore(padded + j * 4, sum)
    }
    bnCopy(out, padded, nWords)
    bnRelease(padded, wide)
    bnRelease(m1, words)
    bnRelease(m2, words)
    bnRelease(m2p, words)
    bnRelease(h, words)
    bnModulusRelease(p)
    bnModulusRelease(q)
}

// Returns a bignum modulus from the specified readable limbs and clears the temporary byte encoding.
trusted fun rsaModulusFromLimbs(limbs: int, words: int): BnModulus {
    val bytes = nativeByteBuffer(words * 4 + 1)
    val address = ablaUnsafePointerAddress(bytes.pointerAt(0))
    bnToBytes(address, words * 4, limbs)
    val modulus = bnModulusFrom(address, words * 4, words)
    for (at in 0 until words * 4) ablaUnsafeStoreU8(bnPointer(address + at), 0)
    bytes.close()
    modulus
}

// Choose the last of 128 in-range lengths, without revealing which one qualified.
@inline trusted fun rsaImplicitLength(candidates: int, size: int): secretU32 {
    val limit = size - 10
    var mask = limit
    mask = mask | (mask >> 1)
    mask = mask | (mask >> 2)
    mask = mask | (mask >> 4)
    mask = mask | (mask >> 8)
    var chosen = secretU32(u32(0))
    for (i in 0 until 128) {
        val high = secretU32(u32(ablaUnsafeLoadU8(bnPointer(candidates + i * 2))))
        val low = secretU32(u32(ablaUnsafeLoadU8(bnPointer(candidates + i * 2 + 1))))
        val candidate = ((high << 8) | low) & secretU32(u32(mask))
        chosen = ctSelect(ctLt(candidate, secretU32(u32(limit))), candidate, chosen)
    }
    chosen
}

// Read both complete blocks and select every byte before releasing the resulting length.
@inline trusted fun rsaImplicitSelect(out: int, encoded: int, synthetic: int, size: int,
    syntheticLength: secretU32): secretU32 {
    val delimiter = rsaPkcs1Delimiter(encoded, size)
    val good = ctIsNonZero(delimiter)
    val start = ctSelect(good, delimiter + secretU32(u32(1)),
        secretU32(u32(size)) - syntheticLength)
    for (i in 0 until size) {
        val actual = secretU32(u32(ablaUnsafeLoadU8(bnPointer(encoded + i))))
        val fake = secretU32(u32(ablaUnsafeLoadU8(bnPointer(synthetic + i))))
        ablaUnsafeStoreU8(bnPointer(out + i), int(ctSelect(good, actual, fake).declassify()))
    }
    start
}

// `block` is OAEP DB; `expected` is lHash. Inspect every byte before revealing validity.
@inline trusted fun rsaOaepDelimiter(block: int, size: int, expected: int, hashSize: int,
    first: u8): secretU32 {
    var difference = secretU32(u32(first))
    for (i in 0 until hashSize) {
        difference = difference | (secretU32(u32(ablaUnsafeLoadU8(bnPointer(block + i)))) ^
            secretU32(u32(ablaUnsafeLoadU8(bnPointer(expected + i)))))
    }
    var seen = secretU32(u32(0))
    var bad = secretU32(u32(0))
    var delimiter = secretU32(u32(0))
    for (i in hashSize until size) {
        val byte = secretU32(u32(ablaUnsafeLoadU8(bnPointer(block + i))))
        val zero = ctIsZero(byte)
        val one = ctEq(byte, secretU32(u32(1)))
        bad = bad | (~seen & ~(zero | one))
        delimiter = ctSelect(one & ~seen, secretU32(u32(i)), delimiter)
        seen = seen | one
    }
    val good = ctIsZero(difference) & ctIsZero(bad) & seen
    ctSelect(good, delimiter, secretU32(u32(0)))
}

// The delimiter and validity remain secret until the whole block has been inspected.
// A zero result means invalid; valid delimiters are at least byte 10.
@inline trusted fun rsaPkcs1Delimiter(address: int, size: int): secretU32 {
    var good = ctEq(secretU32(u32(ablaUnsafeLoadU8(bnPointer(address)))), secretU32(u32(0)))
    good = good & ctEq(secretU32(u32(ablaUnsafeLoadU8(bnPointer(address + 1)))), secretU32(u32(2)))
    var seen = secretU32(u32(0))
    var delimiter = secretU32(u32(0))
    for (i in 2 until size) {
        val zero = ctIsZero(secretU32(u32(ablaUnsafeLoadU8(bnPointer(address + i)))))
        delimiter = ctSelect(zero & ~seen, secretU32(u32(i)), delimiter)
        seen = seen | zero
    }
    good = good & seen & ~ctLt(delimiter, secretU32(u32(10)))
    ctSelect(good, delimiter, secretU32(u32(0)))
}

