// Fixed-width secret arithmetic for RSA key generation. All widths and addresses are public.
// The module is internal; callers must not branch on returned secret masks. Inputs,
// outputs and scratch must not overlap. Use 1..128 limbs (up to 4096-bit operands),
// with a numerator of at most twice that width; widths and addresses are public.
// Callers must wipe scratch and secret outputs after use. The returned all-zero mask
// means failure; any quotient, remainder or inverse produced then is unspecified.
import "abla/ct"
import "abla/crypto/bignum"

// Divide a little-endian numerator by a little-endian divisor, in a fixed number of steps.
// quotient has numeratorWords limbs; remainder, divisor and scratch each have words limbs.
// Returns all ones for a nonzero divisor and zero otherwise. The quotient and remainder
// for a zero divisor are unspecified; callers must use the returned mask.
@inline trusted fun bnSecretDivModBody(quotient: int, remainder: int, numerator: int,
    numeratorWords: int, divisor: int, words: int, scratch: int): secretU32 {
    for (i in 0 until numeratorWords) bnStore(quotient + i * 4, secretU32(u32(0)))
    var nonzero = secretU32(u32(0))
    for (i in 0 until words) {
        bnStore(remainder + i * 4, secretU32(u32(0)))
        nonzero = nonzero | bnLoad(divisor + i * 4)
    }
    var bit = numeratorWords * 32 - 1
    while (bit >= 0) {
        val incoming = (bnLoad(numerator + (bit / 32) * 4) >> (bit % 32)) & secretU32(u32(1))
        var carry = incoming
        for (i in 0 until words) {
            val value = bnLoad(remainder + i * 4)
            bnStore(remainder + i * 4, (value << 1) | carry)
            carry = value >> 31
        }
        var borrow = secretU32(u32(0))
        for (i in 0 until words) {
            val x = bnLoad(remainder + i * 4)
            val y = bnLoad(divisor + i * 4)
            val difference = x - y - borrow
            borrow = ((~x & y) | ((~x | y) & difference)) >> 31
            bnStore(scratch + i * 4, difference)
        }
        val take = (ctIsNonZero(carry) | ctIsZero(borrow)) & ctIsNonZero(nonzero)
        for (i in 0 until words) {
            bnStore(remainder + i * 4, ctSelect(take, bnLoad(scratch + i * 4), bnLoad(remainder + i * 4)))
        }
        val q = quotient + (bit / 32) * 4
        bnStore(q, bnLoad(q) | ((take & secretU32(u32(1))) << (bit % 32)))
        bit = bit - 1
    }
    ctIsNonZero(nonzero)
}

// Reduction shares division's fixed-width loop; quotient and scratch are temporary.
@inline trusted fun bnSecretReduceBody(remainder: int, numerator: int, numeratorWords: int,
    divisor: int, words: int, quotient: int, scratch: int): secretU32 =
    bnSecretDivModBody(quotient, remainder, numerator, numeratorWords, divisor, words, scratch)

// Returns an all-ones mask only for nonzero divisors and a zero remainder.
@inline trusted fun bnSecretExactDivBody(quotient: int, numerator: int, numeratorWords: int,
    divisor: int, words: int, remainder: int, scratch: int): secretU32 {
    val valid = bnSecretDivModBody(quotient, remainder, numerator, numeratorWords, divisor, words, scratch)
    var rest = secretU32(u32(0))
    for (i in 0 until words) rest = rest | bnLoad(remainder + i * 4)
    valid & ctIsZero(rest)
}

// Bernstein–Yang divsteps, one step per iteration. The inputs are unsigned `words`-limb
// integers and modulus must be odd. Work uses nine (words+1)-limb slots. The signed f/g
// slots have one guard limb; the coefficient slots are reduced modulo the original modulus.
// The fixed iteration bound is Theorem 11.2 of https://gcd.cr.yp.to/safegcd-20190305.pdf.
// Returns an all-ones mask only when modulus is odd and gcd(modulus,value) == 1.
// gcd receives the absolute gcd; inverse receives the normalized coefficient when valid.
@inline trusted fun bnSecretDivstepsBody(gcd: int, inverse: int, modulus: int, value: int,
    words: int, work: int): secretU32 {
    val limbs = words + 1
    val stride = limbs * 4
    val f = work
    val g = work + stride
    val m = work + stride * 2
    val d = work + stride * 3
    val e = work + stride * 4
    val nextG = work + stride * 5
    val plus = work + stride * 6
    val minus = work + stride * 7
    val temporary = work + stride * 8
    var modulusDiff = secretU32(u32(0))
    for (i in 0 until limbs) {
        val a = if (i < words) bnLoad(modulus + i * 4) else secretU32(u32(0))
        val b = if (i < words) bnLoad(value + i * 4) else secretU32(u32(0))
        bnStore(f + i * 4, a)
        bnStore(g + i * 4, b)
        bnStore(m + i * 4, a)
        bnStore(d + i * 4, secretU32(u32(0)))
        modulusDiff = modulusDiff | (a ^ secretU32(u32(if (i == 0) 1 else 0)))
    }
    val modulusNotOne = ctIsNonZero(modulusDiff)
    for (i in 0 until limbs) bnStore(e + i * 4,
        if (i == 0) modulusNotOne & secretU32(u32(1)) else secretU32(u32(0)))
    var delta = secretU32(u32(1))
    val bits = words * 32
    // 3*bits+5 exceeds the theorem's bound for every positive bit width.
    val iterations = bits + bits + bits + 5
    for (step in 0 until iterations) {
        val odd = ctFromLowBit(bnLoad(g))
        val positive = ctIsNonZero(delta) & ~ctFromLowBit(delta >> 31)
        val swap = positive & odd
        delta = ctSelect(swap, secretU32(u32(1)) - delta, secretU32(u32(1)) + delta)

        // nextG = (g + (odd ? (swap ? -f : f) : 0)) / 2, signed.
        var carry = swap & secretU32(u32(1))
        for (i in 0 until limbs) {
            val x = bnLoad(g + i * 4)
            val y = (bnLoad(f + i * 4) ^ swap) & odd
            val sum = x + y + carry
            carry = ((x & y) | ((x | y) & ~sum)) >> 31
            bnStore(nextG + i * 4, sum)
        }
        var shifted = (bnLoad(nextG + (limbs - 1) * 4) >> 31) << 31
        var i = limbs - 1
        while (i >= 0) {
            val x = bnLoad(nextG + i * 4)
            bnStore(nextG + i * 4, (x >> 1) | shifted)
            shifted = (x & secretU32(u32(1))) << 31
            i = i - 1
        }

        // plus = (e + (odd ? d : 0)) mod m.
        carry = secretU32(u32(0))
        for (j in 0 until limbs) {
            val x = bnLoad(e + j * 4)
            val y = bnLoad(d + j * 4) & odd
            val sum = x + y + carry
            carry = ((x & y) | ((x | y) & ~sum)) >> 31
            bnStore(plus + j * 4, sum)
        }
        bnConditionalSubtractBody(plus, plus, carry, m, limbs, temporary)

        // minus = (e - d) mod m.
        var borrow = secretU32(u32(0))
        for (j in 0 until limbs) {
            val x = bnLoad(e + j * 4)
            val y = bnLoad(d + j * 4)
            val difference = x - y - borrow
            borrow = ((~x & y) | ((~x | y) & difference)) >> 31
            bnStore(minus + j * 4, difference)
        }
        val addModulus = ctFromLowBit(borrow)
        carry = secretU32(u32(0))
        for (j in 0 until limbs) {
            val x = bnLoad(minus + j * 4)
            val y = bnLoad(m + j * 4) & addModulus
            val sum = x + y + carry
            carry = ((x & y) | ((x | y) & ~sum)) >> 31
            bnStore(minus + j * 4, sum)
        }

        // The selected coefficient is divided by two modulo odd m.
        val makeEven = ctFromLowBit(ctSelect(swap, bnLoad(minus), bnLoad(plus)))
        carry = secretU32(u32(0))
        for (j in 0 until limbs) {
            val x = ctSelect(swap, bnLoad(minus + j * 4), bnLoad(plus + j * 4))
            val y = bnLoad(m + j * 4) & makeEven
            val sum = x + y + carry
            carry = ((x & y) | ((x | y) & ~sum)) >> 31
            bnStore(temporary + j * 4, sum)
        }
        shifted = secretU32(u32(0))
        i = limbs - 1
        while (i >= 0) {
            val x = bnLoad(temporary + i * 4)
            bnStore(temporary + i * 4, (x >> 1) | shifted)
            shifted = (x & secretU32(u32(1))) << 31
            i = i - 1
        }
        for (j in 0 until limbs) {
            val oldF = bnLoad(f + j * 4)
            val oldG = bnLoad(g + j * 4)
            val oldD = bnLoad(d + j * 4)
            val oldE = bnLoad(e + j * 4)
            bnStore(f + j * 4, ctSelect(swap, oldG, oldF))
            bnStore(g + j * 4, bnLoad(nextG + j * 4))
            bnStore(d + j * 4, ctSelect(swap, oldE, oldD))
            bnStore(e + j * 4, bnLoad(temporary + j * 4))
        }
    }
    val negative = ctFromLowBit(bnLoad(f + (limbs - 1) * 4) >> 31)
    var carry = negative & secretU32(u32(1))
    var gcdDifference = secretU32(u32(0))
    var coefficientOr = secretU32(u32(0))
    for (i in 0 until limbs) {
        val x = bnLoad(f + i * 4) ^ negative
        val sum = x + carry
        carry = (x & ~sum) >> 31
        if (i < words) bnStore(gcd + i * 4, sum)
        gcdDifference = gcdDifference | (sum ^ secretU32(u32(if (i == 0) 1 else 0)))
        coefficientOr = coefficientOr | bnLoad(d + i * 4)
    }
    // If f is negative, negate its coefficient modulo m (zero stays zero).
    var borrow = secretU32(u32(0))
    for (i in 0 until limbs) {
        val x = bnLoad(m + i * 4)
        val y = bnLoad(d + i * 4)
        val difference = x - y - borrow
        borrow = ((~x & y) | ((~x | y) & difference)) >> 31
        if (i < words) bnStore(inverse + i * 4, ctSelect(negative & ctIsNonZero(coefficientOr),
            difference, bnLoad(d + i * 4)))
    }
    ctIsZero(gcdDifference) & ctFromLowBit(bnLoad(modulus))
}

// General unsigned gcd, including even and zero inputs. Strip common powers of two
// with fixed-width masked shifts, then restore them after odd-input divsteps.
// Work has 2*words + 9*(words+1) + words limbs; out may not alias either input.
@inline trusted fun bnSecretGcdBody(out: int, left: int, right: int, words: int, work: int): void {
    val a = work
    val b = work + words * 4
    val unusedInverse = work + words * 8
    val divWork = work + words * 12
    var either = secretU32(u32(0))
    for (i in 0 until words) {
        val x = bnLoad(left + i * 4)
        val y = bnLoad(right + i * 4)
        bnStore(a + i * 4, x)
        bnStore(b + i * 4, y)
        either = either | x | y
    }
    val anyInput = ctIsNonZero(either)
    var commonTwos = secretU32(u32(0))
    val bits = words * 32
    for (step in 0 until bits) {
        val take = ~ctFromLowBit(bnLoad(a) | bnLoad(b)) & anyInput
        commonTwos = commonTwos + (take & secretU32(u32(1)))
        var carryA = secretU32(u32(0))
        var carryB = secretU32(u32(0))
        var i = words - 1
        while (i >= 0) {
            val x = bnLoad(a + i * 4)
            val y = bnLoad(b + i * 4)
            bnStore(a + i * 4, ctSelect(take, (x >> 1) | carryA, x))
            bnStore(b + i * 4, ctSelect(take, (y >> 1) | carryB, y))
            carryA = (x & secretU32(u32(1))) << 31
            carryB = (y & secretU32(u32(1))) << 31
            i = i - 1
        }
    }
    val aOdd = ctFromLowBit(bnLoad(a))
    for (i in 0 until words) {
        val x = bnLoad(a + i * 4)
        val y = bnLoad(b + i * 4)
        val selected = ctSelect(aOdd, x, y)
        bnStore(a + i * 4, ctSelect(anyInput, selected, secretU32(u32(if (i == 0) 1 else 0))))
        bnStore(b + i * 4, ctSelect(aOdd, y, x))
    }
    bnSecretDivstepsBody(out, unusedInverse, a, b, words, divWork)
    for (step in 0 until bits) {
        val take = ctLt(secretU32(u32(step)), commonTwos)
        var carry = secretU32(u32(0))
        for (i in 0 until words) {
            val x = bnLoad(out + i * 4)
            bnStore(out + i * 4, ctSelect(take, (x << 1) | carry, x))
            carry = x >> 31
        }
    }
    for (i in 0 until words) bnStore(out + i * 4, bnLoad(out + i * 4) & anyInput)
    return
}

// General modular inverse, including even moduli. For even M and odd a, invert
// M modulo a with odd-modulus divsteps; t = -M^-1 mod a, then (1 + t*M)/a is
// the inverse of a modulo M. Both paths run for every input and are mask-selected.
// Work contains 13*words + 9*(words+1) limbs. Outputs are undefined if mask=0.
@inline trusted fun bnSecretInverseBody(out: int, modulus: int, value: int, words: int, work: int): secretU32 {
    val stride = words * 4
    val oddModulus = work
    val safeValue = work + stride
    val gcd = work + stride * 2
    val inverse = work + stride * 3
    val factor = work + stride * 4
    val product = work + stride * 5
    val quotient = work + stride * 7
    val remainder = work + stride * 9
    val temporary = work + stride * 10
    val oddGcd = work + stride * 11
    val oddInverse = work + stride * 12
    val divWork = work + stride * 13
    val modulusOdd = ctFromLowBit(bnLoad(modulus))
    val valueOdd = ctFromLowBit(bnLoad(value))
    var modulusBits = secretU32(u32(0))
    for (i in 0 until words) {
        val one = secretU32(u32(if (i == 0) 1 else 0))
        val m = bnLoad(modulus + i * 4)
        modulusBits = modulusBits | m
        bnStore(oddModulus + i * 4, ctSelect(modulusOdd, m, one))
        bnStore(safeValue + i * 4, ctSelect(valueOdd, bnLoad(value + i * 4), one))
    }
    val oddValid = bnSecretDivstepsBody(oddGcd, oddInverse, oddModulus, value, words, divWork)
    bnSecretDivModBody(quotient, remainder, modulus, words, safeValue, words, temporary)
    val evenGcdValid = bnSecretDivstepsBody(gcd, inverse, safeValue, remainder, words, divWork)
    var inverseBits = secretU32(u32(0))
    for (i in 0 until words) inverseBits = inverseBits | bnLoad(inverse + i * 4)
    val hasInverse = ctIsNonZero(inverseBits)
    var borrow = secretU32(u32(0))
    for (i in 0 until words) {
        val x = bnLoad(safeValue + i * 4)
        val y = bnLoad(inverse + i * 4)
        val difference = x - y - borrow
        borrow = ((~x & y) | ((~x | y) & difference)) >> 31
        bnStore(factor + i * 4, difference & hasInverse)
    }
    for (i in 0 until words * 2) bnStore(product + i * 4, secretU32(u32(0)))
    for (i in 0 until words) bnAddMultipleBody(product + i * 4, modulus, words, bnLoad(factor + i * 4))
    var carry = secretU32(u32(1))
    for (i in 0 until words * 2) {
        val x = bnLoad(product + i * 4)
        val sum = x + carry
        carry = (x & ~sum) >> 31
        bnStore(product + i * 4, sum)
    }
    bnSecretDivModBody(quotient, remainder, product, words * 2, safeValue, words, temporary)
    var extra = secretU32(u32(0))
    for (i in 0 until words) {
        extra = extra | bnLoad(remainder + i * 4) | bnLoad(quotient + (i + words) * 4)
        bnStore(out + i * 4, ctSelect(modulusOdd, bnLoad(oddInverse + i * 4), bnLoad(quotient + i * 4)))
    }
    val evenValid = valueOdd & ctIsNonZero(modulusBits) & evenGcdValid & ctIsZero(extra)
    ctSelect(modulusOdd, oddValid, evenValid)
}
