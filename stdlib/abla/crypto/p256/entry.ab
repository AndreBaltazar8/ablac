// NIST P-256 (secp256r1) on bytes: ECDH, ECDSA with SHA-256 and RFC 6979 nonces, public keys and DER signatures. The arithmetic is constant-time.
// Everything else of the module (the arithmetic on raw addresses and the work areas it needs) is core.ab, which only the
// standard library's own modules import: no program names an address of its own through this module.
export import "abla/crypto/result"
import "core.ab" as core

/** The public key, 65 bytes (0x04 || X || Y), of a private key of 32 bytes. */
fun p256PublicKey(privateKey: string): CryptoResult = core.p256PublicKey(privateKey)

/** Whether `encoded` is an uncompressed point of the curve (and so a valid public key). */
fun p256IsValidPublicKey(encoded: string): bool = core.p256IsValidPublicKey(encoded)

/** ECDH: the x coordinate, 32 bytes, of `privateKey` times the peer's public point. The peer's point is checked;
 *  a private key out of range is refused. */
fun p256Ecdh(privateKey: string, peerPublicKey: string): CryptoResult = core.p256Ecdh(privateKey, peerPublicKey)

/** A random private key of 32 bytes, or a failure if there is no random source (see cryptoSetRandom). */
fun p256GeneratePrivateKey(): CryptoResult = core.p256GeneratePrivateKey()

/** ECDSA over SHA-256 (RFC 6979 nonce, so a message always gets the same signature): the 64 bytes r || s. */
fun p256EcdsaSignRaw(privateKey: string, message: string): CryptoResult = core.p256EcdsaSignRaw(privateKey, message)

/** The signature r || s (64 bytes) as DER, the form X.509 and TLS carry. */
fun p256SignatureToDer(raw: string): string = core.p256SignatureToDer(raw)

/** r || s (64 bytes) from a strict DER signature, or "". */
fun p256SignatureFromDer(der: string): string = core.p256SignatureFromDer(der)

/** ECDSA over SHA-256, the signature as DER. */
fun p256EcdsaSign(privateKey: string, message: string): CryptoResult = core.p256EcdsaSign(privateKey, message)

/** Verifies `signature` (64 bytes, r || s) over a message digest (SHA-256 normally; a longer digest is cut to its
 *  leftmost 256 bits, as ECDSA says) by the public key. Public inputs: not constant time. */
fun p256EcdsaVerifyDigestRaw(publicKey: string, digest: string, signature: string): bool = core.p256EcdsaVerifyDigestRaw(publicKey, digest, signature)

/** ECDSA over SHA-256, the signature as r || s (64 bytes). As in any ECDSA, (r, s) and (r, n - s) both verify: never identify a signed message by its signature bytes. */
fun p256EcdsaVerifyRaw(publicKey: string, message: string, signature: string): bool = core.p256EcdsaVerifyRaw(publicKey, message, signature)

/** ECDSA over SHA-256, the signature as strict DER. As in any ECDSA, (r, s) and (r, n - s) both verify: never identify a signed message by its signature bytes. */
fun p256EcdsaVerify(publicKey: string, message: string, signature: string): bool = core.p256EcdsaVerify(publicKey, message, signature)

/** ECDSA over SHA-384 (TLS 1.2's ecdsa_secp256r1 with a longer hash; the digest is cut to 256 bits). */
fun p256EcdsaVerifySha384(publicKey: string, message: string, signature: string): bool = core.p256EcdsaVerifySha384(publicKey, message, signature)

