// NIST P-256 (secp256r1) with no OpenSSL: ECDH, and ECDSA with SHA-256 and RFC 6979 nonces. The field (p256FMul, p256FAdd, p256FSub) is unrolled for the prime
// (Montgomery form, 32-bit limbs, 8 per element, the reduction by the prime's shape: no multiplication), the scalar and the modular arithmetic of the signature use
// the constant-time big-number arithmetic of abla/crypto/bignum (Montgomery, 8 limbs). A multiplication of the generator (a public key, the nonce of a
// signature) is a comb over a table of 15 points (p256FixedBaseMultiply): 64 doublings, not 256; a verification shares its doublings between its two scalars.
//
// What is secret and how it is handled:
//  - Point addition and doubling are the complete formulas of Renes, Costello and Batina (ePrint 2015/1060,
//    algorithms 4 and 6 for a = -3): the same instructions for every input, the point at infinity and equal
//    points included, so there is no exceptional case to branch on.
//  - A scalar multiplication walks all 64 four-bit windows of the scalar, doubles four times and adds once per
//    window, the added point read from a table of sixteen by looking at every entry (bnLookup).
//  - Inversions (a field element, k mod n) are Fermat's, by exponents that are public (bnExpPublic).
//  - A private key or nonce is rejected when it is not in 1..n-1; that outcome, and a rejected RFC 6979
//    candidate (probability about 2^-32), are public.
//  - Verification works on public values only and is not claimed to be constant time.
// A private key is a `string` of 32 big-endian bytes, as every key and secret in abla/crypto is passed: a string
// cannot be wiped, so a caller that must not leave a key in memory keeps it elsewhere. The nonce of RFC 6979 is a string
// too (it comes from hmacSha256 over strings, abla/crypto, which has no table or branch on its data but is not among the
// functions tools/test-ct.sh reads: tools/ct-timing measures it as p256-sign and p256-sign-nonce), so it is not wiped; the
// limbs made from it (the key, the nonce, the table) are, when the call ends. tools/test-ct.sh reads the point and scalar
// cores and the signature's multiplications (the region below); the inversion of the nonce (Fermat's, bnExpPublic, by a public
// exponent) is not read: the checker cannot tell a load of the exponent's bytes from a load of secret memory.
//
// Public points are 65 bytes, 0x04 || X || Y; compressed points are refused. A public key is checked to be on the
// curve (the group has cofactor 1, so that is all that is needed).

import "abla/bytes"
import "abla/ct"
import "abla/ct/scrub"
import "abla/crypto"
import "abla/crypto/bignum"
import "abla/crypto/rsa"
import "abla/simd/target"
import "abla/uint128"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/text"
export import "abla/crypto/result"

private val P256_PRIME = "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"
private val P256_PRIME_MINUS_TWO = "ffffffff00000001000000000000000000000000fffffffffffffffffffffffd"
private val P256_ORDER = "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"
private val P256_ORDER_MINUS_TWO = "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f"
private val P256_B = "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"
private val P256_GX = "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
private val P256_GY = "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"


/** The two moduli and the work area of one operation: made for it and released at its end. */
class P256Curve(val field: BnModulus, val order: BnModulus, val work: int)

/// Allocates and returns the field modulus, scalar modulus and scratch storage for a P-256 operation.
trusted fun p256Open(): P256Curve {
    val prime = hexDecode(P256_PRIME)
    val order = hexDecode(P256_ORDER)
    val field = bnModulusFrom(ablaUnsafeStringAddress(prime), 32, P256_WORDS)
    val scalar = bnModulusFrom(ablaUnsafeStringAddress(order), 32, P256_WORDS)
    val work = bnAllocate(P256_WORK_WORDS)
    val plainB = bnAllocate(P256_WORDS)
    val b = hexDecode(P256_B)
    bnFromBytes(plainB, P256_WORDS, ablaUnsafeStringAddress(b), 32)
    bnEncode(field, work + P256_B_AT, plainB)
    bnRelease(plainB, P256_WORDS)
    P256Curve(field, scalar, work)
}

/// Releases both moduli and the scratch storage owned by the P-256 context.
trusted fun p256Close(curve: P256Curve): void {
    bnModulusRelease(curve.field)
    bnModulusRelease(curve.order)
    bnRelease(curve.work, P256_WORK_WORDS)
}

// --- Modular addition and subtraction (any odd modulus of eight limbs, operands below it) ----------------------

// BEGIN P256 SECRET CORES
private val P256_WORDS = 8
// Byte offsets inside a curve's work area: five temporaries, the accumulator, the sum, the entry read from the table,
// the table of sixteen points (three field elements each, X, Y, Z in Montgomery form), and b.
private val P256_TEMPS = 0
private val P256_ACCUMULATOR = 160
private val P256_SUM = 256
private val P256_ENTRY = 352
private val P256_TABLE = 448
private val P256_B_AT = 1984
private val P256_MUL = 2016
private val P256_WORK_WORDS = 520

// Where a BnModulus (abla/crypto/bignum) keeps what the arithmetic reads, for eight limbs.
@inline fun p256Inverse(m: int): int = m + 32
@inline fun p256One(m: int): int = m + 68
@inline fun p256Scratch(m: int): int = m + 100

// --- The field of the curve, unrolled (the prime is public: p = 2^256 - 2^224 + 2^192 + 2^96 - 1) ----------------------------------------------
@noinline trusted fun p256FProductUnrolled(t: int, a: int, b: int): void {
    val a0 = bnLoad(a + 0)
    val a1 = bnLoad(a + 4)
    val a2 = bnLoad(a + 8)
    val a3 = bnLoad(a + 12)
    val a4 = bnLoad(a + 16)
    val a5 = bnLoad(a + 20)
    val a6 = bnLoad(a + 24)
    val a7 = bnLoad(a + 28)
    val b0 = bnLoad(b + 0)
    val b1 = bnLoad(b + 4)
    val b2 = bnLoad(b + 8)
    val b3 = bnLoad(b + 12)
    val b4 = bnLoad(b + 16)
    val b5 = bnLoad(b + 20)
    val b6 = bnLoad(b + 24)
    val b7 = bnLoad(b + 28)
    val x0_0 = a0.widen() * b0.widen()
    val x0_1 = a0.widen() * b1.widen() + x0_0.high().widen()
    val x0_2 = a0.widen() * b2.widen() + x0_1.high().widen()
    val x0_3 = a0.widen() * b3.widen() + x0_2.high().widen()
    val x0_4 = a0.widen() * b4.widen() + x0_3.high().widen()
    val x0_5 = a0.widen() * b5.widen() + x0_4.high().widen()
    val x0_6 = a0.widen() * b6.widen() + x0_5.high().widen()
    val x0_7 = a0.widen() * b7.widen() + x0_6.high().widen()
    val t0_0 = x0_0.low()
    val t0_1 = x0_1.low()
    val t0_2 = x0_2.low()
    val t0_3 = x0_3.low()
    val t0_4 = x0_4.low()
    val t0_5 = x0_5.low()
    val t0_6 = x0_6.low()
    val t0_7 = x0_7.low()
    val t0_8 = x0_7.high()
    val x1_0 = a1.widen() * b0.widen() + t0_1.widen()
    val x1_1 = a1.widen() * b1.widen() + t0_2.widen() + x1_0.high().widen()
    val x1_2 = a1.widen() * b2.widen() + t0_3.widen() + x1_1.high().widen()
    val x1_3 = a1.widen() * b3.widen() + t0_4.widen() + x1_2.high().widen()
    val x1_4 = a1.widen() * b4.widen() + t0_5.widen() + x1_3.high().widen()
    val x1_5 = a1.widen() * b5.widen() + t0_6.widen() + x1_4.high().widen()
    val x1_6 = a1.widen() * b6.widen() + t0_7.widen() + x1_5.high().widen()
    val x1_7 = a1.widen() * b7.widen() + t0_8.widen() + x1_6.high().widen()
    val t1_0 = x1_0.low()
    val t1_1 = x1_1.low()
    val t1_2 = x1_2.low()
    val t1_3 = x1_3.low()
    val t1_4 = x1_4.low()
    val t1_5 = x1_5.low()
    val t1_6 = x1_6.low()
    val t1_7 = x1_7.low()
    val t1_8 = x1_7.high()
    val x2_0 = a2.widen() * b0.widen() + t1_1.widen()
    val x2_1 = a2.widen() * b1.widen() + t1_2.widen() + x2_0.high().widen()
    val x2_2 = a2.widen() * b2.widen() + t1_3.widen() + x2_1.high().widen()
    val x2_3 = a2.widen() * b3.widen() + t1_4.widen() + x2_2.high().widen()
    val x2_4 = a2.widen() * b4.widen() + t1_5.widen() + x2_3.high().widen()
    val x2_5 = a2.widen() * b5.widen() + t1_6.widen() + x2_4.high().widen()
    val x2_6 = a2.widen() * b6.widen() + t1_7.widen() + x2_5.high().widen()
    val x2_7 = a2.widen() * b7.widen() + t1_8.widen() + x2_6.high().widen()
    val t2_0 = x2_0.low()
    val t2_1 = x2_1.low()
    val t2_2 = x2_2.low()
    val t2_3 = x2_3.low()
    val t2_4 = x2_4.low()
    val t2_5 = x2_5.low()
    val t2_6 = x2_6.low()
    val t2_7 = x2_7.low()
    val t2_8 = x2_7.high()
    val x3_0 = a3.widen() * b0.widen() + t2_1.widen()
    val x3_1 = a3.widen() * b1.widen() + t2_2.widen() + x3_0.high().widen()
    val x3_2 = a3.widen() * b2.widen() + t2_3.widen() + x3_1.high().widen()
    val x3_3 = a3.widen() * b3.widen() + t2_4.widen() + x3_2.high().widen()
    val x3_4 = a3.widen() * b4.widen() + t2_5.widen() + x3_3.high().widen()
    val x3_5 = a3.widen() * b5.widen() + t2_6.widen() + x3_4.high().widen()
    val x3_6 = a3.widen() * b6.widen() + t2_7.widen() + x3_5.high().widen()
    val x3_7 = a3.widen() * b7.widen() + t2_8.widen() + x3_6.high().widen()
    val t3_0 = x3_0.low()
    val t3_1 = x3_1.low()
    val t3_2 = x3_2.low()
    val t3_3 = x3_3.low()
    val t3_4 = x3_4.low()
    val t3_5 = x3_5.low()
    val t3_6 = x3_6.low()
    val t3_7 = x3_7.low()
    val t3_8 = x3_7.high()
    val x4_0 = a4.widen() * b0.widen() + t3_1.widen()
    val x4_1 = a4.widen() * b1.widen() + t3_2.widen() + x4_0.high().widen()
    val x4_2 = a4.widen() * b2.widen() + t3_3.widen() + x4_1.high().widen()
    val x4_3 = a4.widen() * b3.widen() + t3_4.widen() + x4_2.high().widen()
    val x4_4 = a4.widen() * b4.widen() + t3_5.widen() + x4_3.high().widen()
    val x4_5 = a4.widen() * b5.widen() + t3_6.widen() + x4_4.high().widen()
    val x4_6 = a4.widen() * b6.widen() + t3_7.widen() + x4_5.high().widen()
    val x4_7 = a4.widen() * b7.widen() + t3_8.widen() + x4_6.high().widen()
    val t4_0 = x4_0.low()
    val t4_1 = x4_1.low()
    val t4_2 = x4_2.low()
    val t4_3 = x4_3.low()
    val t4_4 = x4_4.low()
    val t4_5 = x4_5.low()
    val t4_6 = x4_6.low()
    val t4_7 = x4_7.low()
    val t4_8 = x4_7.high()
    val x5_0 = a5.widen() * b0.widen() + t4_1.widen()
    val x5_1 = a5.widen() * b1.widen() + t4_2.widen() + x5_0.high().widen()
    val x5_2 = a5.widen() * b2.widen() + t4_3.widen() + x5_1.high().widen()
    val x5_3 = a5.widen() * b3.widen() + t4_4.widen() + x5_2.high().widen()
    val x5_4 = a5.widen() * b4.widen() + t4_5.widen() + x5_3.high().widen()
    val x5_5 = a5.widen() * b5.widen() + t4_6.widen() + x5_4.high().widen()
    val x5_6 = a5.widen() * b6.widen() + t4_7.widen() + x5_5.high().widen()
    val x5_7 = a5.widen() * b7.widen() + t4_8.widen() + x5_6.high().widen()
    val t5_0 = x5_0.low()
    val t5_1 = x5_1.low()
    val t5_2 = x5_2.low()
    val t5_3 = x5_3.low()
    val t5_4 = x5_4.low()
    val t5_5 = x5_5.low()
    val t5_6 = x5_6.low()
    val t5_7 = x5_7.low()
    val t5_8 = x5_7.high()
    val x6_0 = a6.widen() * b0.widen() + t5_1.widen()
    val x6_1 = a6.widen() * b1.widen() + t5_2.widen() + x6_0.high().widen()
    val x6_2 = a6.widen() * b2.widen() + t5_3.widen() + x6_1.high().widen()
    val x6_3 = a6.widen() * b3.widen() + t5_4.widen() + x6_2.high().widen()
    val x6_4 = a6.widen() * b4.widen() + t5_5.widen() + x6_3.high().widen()
    val x6_5 = a6.widen() * b5.widen() + t5_6.widen() + x6_4.high().widen()
    val x6_6 = a6.widen() * b6.widen() + t5_7.widen() + x6_5.high().widen()
    val x6_7 = a6.widen() * b7.widen() + t5_8.widen() + x6_6.high().widen()
    val t6_0 = x6_0.low()
    val t6_1 = x6_1.low()
    val t6_2 = x6_2.low()
    val t6_3 = x6_3.low()
    val t6_4 = x6_4.low()
    val t6_5 = x6_5.low()
    val t6_6 = x6_6.low()
    val t6_7 = x6_7.low()
    val t6_8 = x6_7.high()
    val x7_0 = a7.widen() * b0.widen() + t6_1.widen()
    val x7_1 = a7.widen() * b1.widen() + t6_2.widen() + x7_0.high().widen()
    val x7_2 = a7.widen() * b2.widen() + t6_3.widen() + x7_1.high().widen()
    val x7_3 = a7.widen() * b3.widen() + t6_4.widen() + x7_2.high().widen()
    val x7_4 = a7.widen() * b4.widen() + t6_5.widen() + x7_3.high().widen()
    val x7_5 = a7.widen() * b5.widen() + t6_6.widen() + x7_4.high().widen()
    val x7_6 = a7.widen() * b6.widen() + t6_7.widen() + x7_5.high().widen()
    val x7_7 = a7.widen() * b7.widen() + t6_8.widen() + x7_6.high().widen()
    val t7_0 = x7_0.low()
    val t7_1 = x7_1.low()
    val t7_2 = x7_2.low()
    val t7_3 = x7_3.low()
    val t7_4 = x7_4.low()
    val t7_5 = x7_5.low()
    val t7_6 = x7_6.low()
    val t7_7 = x7_7.low()
    val t7_8 = x7_7.high()
    bnStore(t + 0, t0_0)
    bnStore(t + 4, t1_0)
    bnStore(t + 8, t2_0)
    bnStore(t + 12, t3_0)
    bnStore(t + 16, t4_0)
    bnStore(t + 20, t5_0)
    bnStore(t + 24, t6_0)
    bnStore(t + 28, t7_0)
    bnStore(t + 32, t7_1)
    bnStore(t + 36, t7_2)
    bnStore(t + 40, t7_3)
    bnStore(t + 44, t7_4)
    bnStore(t + 48, t7_5)
    bnStore(t + 52, t7_6)
    bnStore(t + 56, t7_7)
    bnStore(t + 60, t7_8)
}

/** What p256FProductUnrolled does, as loops: LLVM's -O0 register scavenger on Xtensa cannot place the unrolled function (as with X25519's), and a 32-bit CPU gains
 *  nothing from the unrolling. */
@noinline trusted fun p256FProductLoops(t: int, a: int, b: int): void {
    for (i in 0 until 8) {
        val ai = bnLoad(a + i * 4).widen()
        var carry = secretU64(u64(0))
        for (j in 0 until 8) {
            val x = ai * bnLoad(b + j * 4).widen() + (if (i == 0) secretU64(u64(0)) else bnLoad(t + (i + j) * 4).widen()) + carry
            bnStore(t + (i + j) * 4, x.low())
            carry = x >> 32
        }
        bnStore(t + (i + 8) * 4, carry.low())
    }
}

/** The product of the elements at `a` and `b` as the 16 words of 32 bits at `t` that p256FProductUnrolled leaves, from four limbs of 64 bits each (a limb pair of the layout):
 *  16 products of 64 x 64 -> 128 instead of 64 of 32 x 32 -> 64. For targets where that product is one instruction (x86-64, AArch64: abla/uint128's native multiply). */
@noinline trusted fun p256FProductWide(t: int, a: int, b: int): void {
    val a0 = uint128(bnLoad64(a + 0))
    val b0 = uint128(bnLoad64(b + 0))
    val a1 = uint128(bnLoad64(a + 8))
    val b1 = uint128(bnLoad64(b + 8))
    val a2 = uint128(bnLoad64(a + 16))
    val b2 = uint128(bnLoad64(b + 16))
    val a3 = uint128(bnLoad64(a + 24))
    val b3 = uint128(bnLoad64(b + 24))
    val p00 = a0 * b0
    val p01 = a0 * b1 + (p00 >> 64)
    val p02 = a0 * b2 + (p01 >> 64)
    val p03 = a0 * b3 + (p02 >> 64)
    val t0 = uint128(p00.toU64())
    val t1 = uint128(p01.toU64())
    val t2 = uint128(p02.toU64())
    val t3 = uint128(p03.toU64())
    val t4 = p03 >> 64
    val p10 = a1 * b0 + t1
    val p11 = a1 * b1 + t2 + (p10 >> 64)
    val p12 = a1 * b2 + t3 + (p11 >> 64)
    val p13 = a1 * b3 + t4 + (p12 >> 64)
    val u1_1 = uint128(p10.toU64())
    val u1_2 = uint128(p11.toU64())
    val u1_3 = uint128(p12.toU64())
    val u1_4 = uint128(p13.toU64())
    val u1_5 = p13 >> 64
    val p20 = a2 * b0 + u1_2
    val p21 = a2 * b1 + u1_3 + (p20 >> 64)
    val p22 = a2 * b2 + u1_4 + (p21 >> 64)
    val p23 = a2 * b3 + u1_5 + (p22 >> 64)
    val u2_2 = uint128(p20.toU64())
    val u2_3 = uint128(p21.toU64())
    val u2_4 = uint128(p22.toU64())
    val u2_5 = uint128(p23.toU64())
    val u2_6 = p23 >> 64
    val p30 = a3 * b0 + u2_3
    val p31 = a3 * b1 + u2_4 + (p30 >> 64)
    val p32 = a3 * b2 + u2_5 + (p31 >> 64)
    val p33 = a3 * b3 + u2_6 + (p32 >> 64)
    val u3_3 = uint128(p30.toU64())
    val u3_4 = uint128(p31.toU64())
    val u3_5 = uint128(p32.toU64())
    val u3_6 = uint128(p33.toU64())
    val u3_7 = p33 >> 64
    bnStore64(t, t0.toU64())
    bnStore64(t + 8, u1_1.toU64())
    bnStore64(t + 16, u2_2.toU64())
    bnStore64(t + 24, u3_3.toU64())
    bnStore64(t + 32, u3_4.toU64())
    bnStore64(t + 40, u3_5.toU64())
    bnStore64(t + 48, u3_6.toU64())
    bnStore64(t + 56, u3_7.toU64())
}

/** The product at `t` (eight limbs of 64 bits) / 2^256 mod p, fully reduced, at `out`: Montgomery reduction limb by limb. -p^-1 is 1 modulo 2^64 (p ends in 64 one bits), so the
 *  multiplier of each step is the limb itself, and q p = q (2^64 - 1) + q (2^32 - 1) 2^64 + q (2^64 - 2^32 + 1) 2^192: the first term clears the limb and carries q up, so a step is
 *  two products and the additions. The result is below 2 p (the product of two reduced elements is below p 2^256), and p is subtracted when it is p or more. */
@noinline trusted fun p256FReduceWide64(out: int, t: int): void {
    val w0_0 = uint128(bnLoad64(t + 0))
    val w1_0 = uint128(bnLoad64(t + 8))
    val w2_0 = uint128(bnLoad64(t + 16))
    val w3_0 = uint128(bnLoad64(t + 24))
    val w4_0 = uint128(bnLoad64(t + 32))
    val w5_0 = uint128(bnLoad64(t + 40))
    val w6_0 = uint128(bnLoad64(t + 48))
    val w7_0 = uint128(bnLoad64(t + 56))
    val p1 = uint128(4294967295)
    val p3 = uint128((u64(4294967295) << 32) | u64(1))
    val zero = uint128(0)
    val m1_0 = w0_0 * p1
    val m3_0 = w0_0 * p3
    val s1_0 = w1_0 + w0_0 + uint128(m1_0.toU64())
    val s2_0 = w2_0 + (m1_0 >> 64) + (s1_0 >> 64)
    val s3_0 = w3_0 + uint128(m3_0.toU64()) + (s2_0 >> 64)
    val s4_0 = w4_0 + (m3_0 >> 64) + (s3_0 >> 64)
    val c5_0 = w5_0 + (s4_0 >> 64)
    val c6_0 = w6_0 + (c5_0 >> 64)
    val c7_0 = w7_0 + (c6_0 >> 64)
    val c8_0 = zero + (c7_0 >> 64)
    val m1_1 = uint128(s1_0.toU64()) * p1
    val m3_1 = uint128(s1_0.toU64()) * p3
    val s1_1 = uint128(s2_0.toU64()) + uint128(s1_0.toU64()) + uint128(m1_1.toU64())
    val s2_1 = uint128(s3_0.toU64()) + (m1_1 >> 64) + (s1_1 >> 64)
    val s3_1 = uint128(s4_0.toU64()) + uint128(m3_1.toU64()) + (s2_1 >> 64)
    val s4_1 = uint128(c5_0.toU64()) + (m3_1 >> 64) + (s3_1 >> 64)
    val c6_1 = uint128(c6_0.toU64()) + (s4_1 >> 64)
    val c7_1 = uint128(c7_0.toU64()) + (c6_1 >> 64)
    val c8_1 = uint128(c8_0.toU64()) + (c7_1 >> 64)
    val m1_2 = uint128(s1_1.toU64()) * p1
    val m3_2 = uint128(s1_1.toU64()) * p3
    val s1_2 = uint128(s2_1.toU64()) + uint128(s1_1.toU64()) + uint128(m1_2.toU64())
    val s2_2 = uint128(s3_1.toU64()) + (m1_2 >> 64) + (s1_2 >> 64)
    val s3_2 = uint128(s4_1.toU64()) + uint128(m3_2.toU64()) + (s2_2 >> 64)
    val s4_2 = uint128(c6_1.toU64()) + (m3_2 >> 64) + (s3_2 >> 64)
    val c7_2 = uint128(c7_1.toU64()) + (s4_2 >> 64)
    val c8_2 = uint128(c8_1.toU64()) + (c7_2 >> 64)
    val m1_3 = uint128(s1_2.toU64()) * p1
    val m3_3 = uint128(s1_2.toU64()) * p3
    val s1_3 = uint128(s2_2.toU64()) + uint128(s1_2.toU64()) + uint128(m1_3.toU64())
    val s2_3 = uint128(s3_2.toU64()) + (m1_3 >> 64) + (s1_3 >> 64)
    val s3_3 = uint128(s4_2.toU64()) + uint128(m3_3.toU64()) + (s2_3 >> 64)
    val s4_3 = uint128(c7_2.toU64()) + (m3_3 >> 64) + (s3_3 >> 64)
    val c8_3 = uint128(c8_2.toU64()) + (s4_3 >> 64)
    val r0 = uint128(s1_3.toU64()).toU64()
    val r1 = uint128(s2_3.toU64()).toU64()
    val r2 = uint128(s3_3.toU64()).toU64()
    val r3 = uint128(s4_3.toU64()).toU64()
    val top = uint128(c8_3.toU64()).toU64()
    // Subtract p (limbs all-ones, 2^32 - 1, 0, 2^64 - 2^32 + 1), keeping the difference when the result had a bit above the top limb or did not borrow.
    val d0 = r0 - (~u64(0))
    val b0 = ((~r0 & (~u64(0))) | ((~r0 | (~u64(0))) & d0)) >> 63
    val d1 = r1 - u64(4294967295) - b0
    val b1 = ((~r1 & u64(4294967295)) | ((~r1 | u64(4294967295)) & d1)) >> 63
    val d2 = r2 - b1
    val b2 = ((~r2 & u64(0)) | ((~r2 | u64(0)) & d2)) >> 63
    val d3 = r3 - ((u64(4294967295) << 32) | u64(1)) - b2
    val b3 = ((~r3 & ((u64(4294967295) << 32) | u64(1))) | ((~r3 | ((u64(4294967295) << 32) | u64(1))) & d3)) >> 63
    val pick = (top | (u64(1) - b3)) & u64(1)
    val mask = u64(0) - pick
    bnStore64(out, (d0 & mask) | (r0 & ~mask))
    bnStore64(out + 8, (d1 & mask) | (r1 & ~mask))
    bnStore64(out + 16, (d2 & mask) | (r2 & ~mask))
    bnStore64(out + 24, (d3 & mask) | (r3 & ~mask))
}

/** `out` = `a` * `b` / 2^256 mod p: the Montgomery multiplication of the field, fully reduced and bit for bit what bnMontgomeryMultiply gives; `t` is 16 words of scratch.
 *  The product and the reduction are separate calls (the registers of a caller are not those of sixteen words and their carries). */
@noinline trusted fun p256FMul(out: int, a: int, b: int, t: int): void {
    if (ablaU128NativeMul()) p256FProductWide(t, a, b)
    else if (simdTargetArch() == SIMD_ARCH_XTENSA) p256FProductLoops(t, a, b) else p256FProductUnrolled(t, a, b)
    if (ablaU128NativeMul()) p256FReduceWide64(out, t)
    else if (simdTargetArch() == SIMD_ARCH_XTENSA) p256FReduceLoops(out, t) else p256FReduceWide(out, t)
}

/** What p256FReduceWide does, as loops over the words in memory (the m of each of the first eight words replaces it in `t`, the result words the last eight): the
 *  unrolled function is more than LLVM's -O0 register scavenger on Xtensa can place, and a 32-bit CPU gains nothing from it. */
@noinline trusted fun p256FReduceLoops(out: int, t: int): void {
    val bias = secretU64(u64(9223372036854775808))
    val half = secretU64(u64(2147483648))
    var c = secretU64(u64(0))
    for (w in 0 until 16) {
        var s = bnLoad(t + w * 4).widen() + c
        if (w >= 3 && w <= 10) s = s + bnLoad(t + (w - 3) * 4).widen()
        if (w >= 6 && w <= 13) s = s + bnLoad(t + (w - 6) * 4).widen()
        if (w >= 7 && w <= 14) s = s - bnLoad(t + (w - 7) * 4).widen()
        if (w >= 8 && w <= 15) s = s + bnLoad(t + (w - 8) * 4).widen()
        val low = s.low()
        bnStore(t + w * 4, low)
        c = ((s - low.widen() + bias) >> 32) - half
    }
    // The result is (c, words 8 to 15 of t): subtract p when it is p or more.
    var borrow = secretU64(u64(0))
    for (k in 0 until 8) {
        val p = if (k == 6) 1 else if (k < 3 || k == 7) 4294967295 else 0
        val x = bnLoad(t + (8 + k) * 4).widen() - secretU64(u64(p)) - borrow
        borrow = x >> 63
    }
    val pick = c | (secretU64(u64(1)) - borrow)
    val mask = (secretU64(u64(0)) - pick).low()
    borrow = secretU64(u64(0))
    for (k in 0 until 8) {
        val p = if (k == 6) 1 else if (k < 3 || k == 7) 4294967295 else 0
        val x = bnLoad(t + (8 + k) * 4).widen() - (secretU32(u32(p)) & mask).widen() - borrow
        bnStore(out + k * 4, x.low())
        borrow = x >> 63
    }
}

/** The product at `t` (16 words) / 2^256 mod p, fully reduced, at `out`: Montgomery reduction word by word, with p = 2^256 - 2^224 + 2^192 + 2^96 - 1 (so m = t_i and
 *  m p is four shifted copies of m: no multiplication), the carries kept as signed 64-bit values. */
@noinline trusted fun p256FReduceWide(out: int, t: int): void {
    val t0 = bnLoad(t + 0).widen()
    val t1 = bnLoad(t + 4).widen()
    val t2 = bnLoad(t + 8).widen()
    val t3 = bnLoad(t + 12).widen()
    val t4 = bnLoad(t + 16).widen()
    val t5 = bnLoad(t + 20).widen()
    val t6 = bnLoad(t + 24).widen()
    val t7 = bnLoad(t + 28).widen()
    val t8 = bnLoad(t + 32).widen()
    val t9 = bnLoad(t + 36).widen()
    val t10 = bnLoad(t + 40).widen()
    val t11 = bnLoad(t + 44).widen()
    val t12 = bnLoad(t + 48).widen()
    val t13 = bnLoad(t + 52).widen()
    val t14 = bnLoad(t + 56).widen()
    val t15 = bnLoad(t + 60).widen()
    val bias = secretU64(u64(9223372036854775808))
    val half = secretU64(u64(2147483648))
    val c0 = secretU64(u64(0))
    val s0 = t0 + c0
    val m0 = s0.low()
    val c1 = ((s0 - m0.widen() + bias) >> 32) - half
    val s1 = t1 + c1
    val m1 = s1.low()
    val c2 = ((s1 - m1.widen() + bias) >> 32) - half
    val s2 = t2 + c2
    val m2 = s2.low()
    val c3 = ((s2 - m2.widen() + bias) >> 32) - half
    val s3 = t3 + c3 + m0.widen()
    val m3 = s3.low()
    val c4 = ((s3 - m3.widen() + bias) >> 32) - half
    val s4 = t4 + c4 + m1.widen()
    val m4 = s4.low()
    val c5 = ((s4 - m4.widen() + bias) >> 32) - half
    val s5 = t5 + c5 + m2.widen()
    val m5 = s5.low()
    val c6 = ((s5 - m5.widen() + bias) >> 32) - half
    val s6 = t6 + c6 + m3.widen() + m0.widen()
    val m6 = s6.low()
    val c7 = ((s6 - m6.widen() + bias) >> 32) - half
    val s7 = t7 + c7 + m4.widen() + m1.widen() - m0.widen()
    val m7 = s7.low()
    val c8 = ((s7 - m7.widen() + bias) >> 32) - half
    val s8 = t8 + c8 + m5.widen() + m2.widen() - m1.widen() + m0.widen()
    val r0 = s8.low()
    val c9 = ((s8 - r0.widen() + bias) >> 32) - half
    val s9 = t9 + c9 + m6.widen() + m3.widen() - m2.widen() + m1.widen()
    val r1 = s9.low()
    val c10 = ((s9 - r1.widen() + bias) >> 32) - half
    val s10 = t10 + c10 + m7.widen() + m4.widen() - m3.widen() + m2.widen()
    val r2 = s10.low()
    val c11 = ((s10 - r2.widen() + bias) >> 32) - half
    val s11 = t11 + c11 + m5.widen() - m4.widen() + m3.widen()
    val r3 = s11.low()
    val c12 = ((s11 - r3.widen() + bias) >> 32) - half
    val s12 = t12 + c12 + m6.widen() - m5.widen() + m4.widen()
    val r4 = s12.low()
    val c13 = ((s12 - r4.widen() + bias) >> 32) - half
    val s13 = t13 + c13 + m7.widen() - m6.widen() + m5.widen()
    val r5 = s13.low()
    val c14 = ((s13 - r5.widen() + bias) >> 32) - half
    val s14 = t14 + c14 - m7.widen() + m6.widen()
    val r6 = s14.low()
    val c15 = ((s14 - r6.widen() + bias) >> 32) - half
    val s15 = t15 + c15 + m7.widen()
    val r7 = s15.low()
    val c16 = ((s15 - r7.widen() + bias) >> 32) - half
    // The result is (c16, r0 .. r7) with c16 0 or 1: subtract p when it is p or more.
    var borrow = secretU64(u64(0))
    val x0 = r0.widen() - secretU64(u64(4294967295)) - borrow
    val d0 = x0.low()
    borrow = x0 >> 63
    val x1 = r1.widen() - secretU64(u64(4294967295)) - borrow
    val d1 = x1.low()
    borrow = x1 >> 63
    val x2 = r2.widen() - secretU64(u64(4294967295)) - borrow
    val d2 = x2.low()
    borrow = x2 >> 63
    val x3 = r3.widen() - secretU64(u64(0)) - borrow
    val d3 = x3.low()
    borrow = x3 >> 63
    val x4 = r4.widen() - secretU64(u64(0)) - borrow
    val d4 = x4.low()
    borrow = x4 >> 63
    val x5 = r5.widen() - secretU64(u64(0)) - borrow
    val d5 = x5.low()
    borrow = x5 >> 63
    val x6 = r6.widen() - secretU64(u64(1)) - borrow
    val d6 = x6.low()
    borrow = x6 >> 63
    val x7 = r7.widen() - secretU64(u64(4294967295)) - borrow
    val d7 = x7.low()
    borrow = x7 >> 63
    // Use the difference when c16 is 1 or when there was no borrow.
    val pick = c16 | (secretU64(u64(1)) - borrow)
    val mask = (secretU64(u64(0)) - pick).low()
    bnStore(out + 0, (d0 & mask) | (r0 & ~mask))
    bnStore(out + 4, (d1 & mask) | (r1 & ~mask))
    bnStore(out + 8, (d2 & mask) | (r2 & ~mask))
    bnStore(out + 12, (d3 & mask) | (r3 & ~mask))
    bnStore(out + 16, (d4 & mask) | (r4 & ~mask))
    bnStore(out + 20, (d5 & mask) | (r5 & ~mask))
    bnStore(out + 24, (d6 & mask) | (r6 & ~mask))
    bnStore(out + 28, (d7 & mask) | (r7 & ~mask))
}

/** `out` = `a` + `b` mod p (operands below p; `out` may be either): the sum, then p subtracted when the sum is p or more. */
@noinline trusted fun p256FAdd(out: int, a: int, b: int): void {
    var carry = secretU64(u64(0))
    val y0 = bnLoad(a + 0).widen() + bnLoad(b + 0).widen() + carry
    val s0 = y0.low()
    carry = y0 >> 32
    val y1 = bnLoad(a + 4).widen() + bnLoad(b + 4).widen() + carry
    val s1 = y1.low()
    carry = y1 >> 32
    val y2 = bnLoad(a + 8).widen() + bnLoad(b + 8).widen() + carry
    val s2 = y2.low()
    carry = y2 >> 32
    val y3 = bnLoad(a + 12).widen() + bnLoad(b + 12).widen() + carry
    val s3 = y3.low()
    carry = y3 >> 32
    val y4 = bnLoad(a + 16).widen() + bnLoad(b + 16).widen() + carry
    val s4 = y4.low()
    carry = y4 >> 32
    val y5 = bnLoad(a + 20).widen() + bnLoad(b + 20).widen() + carry
    val s5 = y5.low()
    carry = y5 >> 32
    val y6 = bnLoad(a + 24).widen() + bnLoad(b + 24).widen() + carry
    val s6 = y6.low()
    carry = y6 >> 32
    val y7 = bnLoad(a + 28).widen() + bnLoad(b + 28).widen() + carry
    val s7 = y7.low()
    carry = y7 >> 32
    var borrow = secretU64(u64(0))
    val x0 = s0.widen() - secretU64(u64(4294967295)) - borrow
    val d0 = x0.low()
    borrow = x0 >> 63
    val x1 = s1.widen() - secretU64(u64(4294967295)) - borrow
    val d1 = x1.low()
    borrow = x1 >> 63
    val x2 = s2.widen() - secretU64(u64(4294967295)) - borrow
    val d2 = x2.low()
    borrow = x2 >> 63
    val x3 = s3.widen() - secretU64(u64(0)) - borrow
    val d3 = x3.low()
    borrow = x3 >> 63
    val x4 = s4.widen() - secretU64(u64(0)) - borrow
    val d4 = x4.low()
    borrow = x4 >> 63
    val x5 = s5.widen() - secretU64(u64(0)) - borrow
    val d5 = x5.low()
    borrow = x5 >> 63
    val x6 = s6.widen() - secretU64(u64(1)) - borrow
    val d6 = x6.low()
    borrow = x6 >> 63
    val x7 = s7.widen() - secretU64(u64(4294967295)) - borrow
    val d7 = x7.low()
    borrow = x7 >> 63
    val pick = carry | (secretU64(u64(1)) - borrow)
    val mask = (secretU64(u64(0)) - pick).low()
    bnStore(out + 0, (d0 & mask) | (s0 & ~mask))
    bnStore(out + 4, (d1 & mask) | (s1 & ~mask))
    bnStore(out + 8, (d2 & mask) | (s2 & ~mask))
    bnStore(out + 12, (d3 & mask) | (s3 & ~mask))
    bnStore(out + 16, (d4 & mask) | (s4 & ~mask))
    bnStore(out + 20, (d5 & mask) | (s5 & ~mask))
    bnStore(out + 24, (d6 & mask) | (s6 & ~mask))
    bnStore(out + 28, (d7 & mask) | (s7 & ~mask))
}

/** `out` = `a` - `b` mod p (operands below p; `out` may be either): the difference, then p added back when it borrowed. */
@noinline trusted fun p256FSub(out: int, a: int, b: int): void {
    var borrow = secretU64(u64(0))
    val x0 = bnLoad(a + 0).widen() - bnLoad(b + 0).widen() - borrow
    val d0 = x0.low()
    borrow = x0 >> 63
    val x1 = bnLoad(a + 4).widen() - bnLoad(b + 4).widen() - borrow
    val d1 = x1.low()
    borrow = x1 >> 63
    val x2 = bnLoad(a + 8).widen() - bnLoad(b + 8).widen() - borrow
    val d2 = x2.low()
    borrow = x2 >> 63
    val x3 = bnLoad(a + 12).widen() - bnLoad(b + 12).widen() - borrow
    val d3 = x3.low()
    borrow = x3 >> 63
    val x4 = bnLoad(a + 16).widen() - bnLoad(b + 16).widen() - borrow
    val d4 = x4.low()
    borrow = x4 >> 63
    val x5 = bnLoad(a + 20).widen() - bnLoad(b + 20).widen() - borrow
    val d5 = x5.low()
    borrow = x5 >> 63
    val x6 = bnLoad(a + 24).widen() - bnLoad(b + 24).widen() - borrow
    val d6 = x6.low()
    borrow = x6 >> 63
    val x7 = bnLoad(a + 28).widen() - bnLoad(b + 28).widen() - borrow
    val d7 = x7.low()
    borrow = x7 >> 63
    val mask = (secretU64(u64(0)) - borrow).low()
    var carry = secretU64(u64(0))
    val y0 = d0.widen() + (secretU32(u32(4294967295)) & mask).widen() + carry
    bnStore(out + 0, y0.low())
    carry = y0 >> 32
    val y1 = d1.widen() + (secretU32(u32(4294967295)) & mask).widen() + carry
    bnStore(out + 4, y1.low())
    carry = y1 >> 32
    val y2 = d2.widen() + (secretU32(u32(4294967295)) & mask).widen() + carry
    bnStore(out + 8, y2.low())
    carry = y2 >> 32
    val y3 = d3.widen() + (secretU32(u32(0)) & mask).widen() + carry
    bnStore(out + 12, y3.low())
    carry = y3 >> 32
    val y4 = d4.widen() + (secretU32(u32(0)) & mask).widen() + carry
    bnStore(out + 16, y4.low())
    carry = y4 >> 32
    val y5 = d5.widen() + (secretU32(u32(0)) & mask).widen() + carry
    bnStore(out + 20, y5.low())
    carry = y5 >> 32
    val y6 = d6.widen() + (secretU32(u32(1)) & mask).widen() + carry
    bnStore(out + 24, y6.low())
    carry = y6 >> 32
    val y7 = d7.widen() + (secretU32(u32(4294967295)) & mask).widen() + carry
    bnStore(out + 28, y7.low())
    carry = y7 >> 32
}

/** `out` = `a` * `b` / 2^256 mod the modulus at `m`. */
@inline trusted fun p256Multiply(m: int, out: int, a: int, b: int): void {
    if (bnWideLimbs(P256_WORDS)) bnMontgomeryMultiply64(out, a, b, m, p256Inverse(m), P256_WORDS, p256Scratch(m))
    else bnMontgomeryMultiply(out, a, b, m, p256Inverse(m), P256_WORDS, p256Scratch(m))
}

/** `out` = `a` + `b` mod the modulus. `out` may be either. Uses the modulus's scratch. */
trusted fun p256Add(m: int, out: int, a: int, b: int): void {
    val t = p256Scratch(m)
    var carry = secretU32(u32(0))
    for (j in 0 until P256_WORDS) {
        val sum = bnLoad(a + j * 4).widen() + bnLoad(b + j * 4).widen() + carry.widen()
        bnStore(t + j * 4, sum.low())
        carry = sum.high()
    }
    bnConditionalSubtractBody(out, t, carry, m, P256_WORDS, t + (P256_WORDS + 2) * 4)
}

/** `out` = `a` - `b` mod the modulus. `out` may be either. Uses the modulus's scratch. */
trusted fun p256Subtract(m: int, out: int, a: int, b: int): void {
    val t = p256Scratch(m)
    var borrow = secretU32(u32(0))
    for (j in 0 until P256_WORDS) {
        val x = bnLoad(a + j * 4)
        val y = bnLoad(b + j * 4)
        val difference = x - y - borrow
        borrow = ((~x & y) | ((~x | y) & difference)) >> 31
        bnStore(t + j * 4, difference)
    }
    val mask = secretU32(u32(0)) - borrow
    var carry = secretU32(u32(0))
    for (j in 0 until P256_WORDS) {
        val sum = bnLoad(t + j * 4).widen() + (bnLoad(m + j * 4) & mask).widen() + carry.widen()
        bnStore(out + j * 4, sum.low())
        carry = sum.high()
    }
}

// --- The curve: complete addition and doubling (a = -3) ---------------------------------------------------------

/** `out` = `p` + `q`, projective points in Montgomery form; `out` is neither. Renes-Costello-Batina, algorithm 4. */
trusted fun p256PointAdd(f: int, work: int, out: int, p: int, q: int): void {
    val t0 = work + P256_TEMPS
    val tm = work + P256_MUL
    val t1 = t0 + 32
    val t2 = t1 + 32
    val t3 = t2 + 32
    val t4 = t3 + 32
    val b = work + P256_B_AT
    val x1 = p
    val y1 = p + 32
    val z1 = p + 64
    val x2 = q
    val y2 = q + 32
    val z2 = q + 64
    val x3 = out
    val y3 = out + 32
    val z3 = out + 64
    p256FMul(t0, x1, x2, tm)
    p256FMul(t1, y1, y2, tm)
    p256FMul(t2, z1, z2, tm)
    p256FAdd(t3, x1, y1)
    p256FAdd(t4, x2, y2)
    p256FMul(t3, t3, t4, tm)
    p256FAdd(t4, t0, t1)
    p256FSub(t3, t3, t4)
    p256FAdd(t4, y1, z1)
    p256FAdd(x3, y2, z2)
    p256FMul(t4, t4, x3, tm)
    p256FAdd(x3, t1, t2)
    p256FSub(t4, t4, x3)
    p256FAdd(x3, x1, z1)
    p256FAdd(y3, x2, z2)
    p256FMul(x3, x3, y3, tm)
    p256FAdd(y3, t0, t2)
    p256FSub(y3, x3, y3)
    p256FMul(z3, b, t2, tm)
    p256FSub(x3, y3, z3)
    p256FAdd(z3, x3, x3)
    p256FAdd(x3, x3, z3)
    p256FSub(z3, t1, x3)
    p256FAdd(x3, t1, x3)
    p256FMul(y3, b, y3, tm)
    p256FAdd(t1, t2, t2)
    p256FAdd(t2, t1, t2)
    p256FSub(y3, y3, t2)
    p256FSub(y3, y3, t0)
    p256FAdd(t1, y3, y3)
    p256FAdd(y3, t1, y3)
    p256FAdd(t1, t0, t0)
    p256FAdd(t0, t1, t0)
    p256FSub(t0, t0, t2)
    p256FMul(t1, t4, y3, tm)
    p256FMul(t2, t0, y3, tm)
    p256FMul(y3, x3, z3, tm)
    p256FAdd(y3, y3, t2)
    p256FMul(x3, t3, x3, tm)
    p256FSub(x3, x3, t1)
    p256FMul(z3, t4, z3, tm)
    p256FMul(t1, t3, t0, tm)
    p256FAdd(z3, z3, t1)
}

/** `out` = 2 `p`; `out` is not `p`. Renes-Costello-Batina, algorithm 6. */
trusted fun p256PointDouble(f: int, work: int, out: int, p: int): void {
    val t0 = work + P256_TEMPS
    val tm = work + P256_MUL
    val t1 = t0 + 32
    val t2 = t1 + 32
    val t3 = t2 + 32
    val b = work + P256_B_AT
    val x = p
    val y = p + 32
    val z = p + 64
    val x3 = out
    val y3 = out + 32
    val z3 = out + 64
    p256FMul(t0, x, x, tm)
    p256FMul(t1, y, y, tm)
    p256FMul(t2, z, z, tm)
    p256FMul(t3, x, y, tm)
    p256FAdd(t3, t3, t3)
    p256FMul(z3, x, z, tm)
    p256FAdd(z3, z3, z3)
    p256FMul(y3, b, t2, tm)
    p256FSub(y3, y3, z3)
    p256FAdd(x3, y3, y3)
    p256FAdd(y3, x3, y3)
    p256FSub(x3, t1, y3)
    p256FAdd(y3, t1, y3)
    p256FMul(y3, x3, y3, tm)
    p256FMul(x3, x3, t3, tm)
    p256FAdd(t3, t2, t2)
    p256FAdd(t2, t2, t3)
    p256FMul(z3, b, z3, tm)
    p256FSub(z3, z3, t2)
    p256FSub(z3, z3, t0)
    p256FAdd(t3, z3, z3)
    p256FAdd(z3, z3, t3)
    p256FAdd(t3, t0, t0)
    p256FAdd(t0, t3, t0)
    p256FSub(t0, t0, t2)
    p256FMul(t0, t0, z3, tm)
    p256FAdd(y3, y3, t0)
    p256FMul(t0, y, z, tm)
    p256FAdd(t0, t0, t0)
    p256FMul(z3, t0, z3, tm)
    p256FSub(x3, x3, z3)
    p256FMul(z3, t0, t1, tm)
    p256FAdd(z3, z3, z3)
    p256FAdd(z3, z3, z3)
}

/** Nonzero when the eight limbs at `value` are a number from 1 to n-1, n at `order`: every limb is read, and only the
 *  verdict is public (a key or a nonce candidate that is refused). It is returned as a word, not a bool: a comparison
 *  here would be a branch on a target with no conditional set. */
trusted fun p256InRange(order: int, value: int): u32 {
    var borrow = secretU32(u32(0))
    var any = secretU32(u32(0))
    for (j in 0 until P256_WORDS) {
        val x = bnLoad(value + j * 4)
        val y = bnLoad(order + j * 4)
        val difference = x - y - borrow
        borrow = ((~x & y) | ((~x | y) & difference)) >> 31
        any = any | x
    }
    // value - n borrows exactly when value < n.
    (borrow & ctIsNonZero(any)).declassify()
}

/** `out` = `scalar` * `point`: `scalar` is eight plain limbs (secret), `point` projective in Montgomery form, and
 *  `out` is neither. Every window of four bits does the same four doublings, one addition and a read of the whole
 *  table of sixteen multiples. */
trusted fun p256ScalarMultiply(f: int, work: int, out: int, point: int, scalar: int): void {
    val accumulator = work + P256_ACCUMULATOR
    val sum = work + P256_SUM
    val entry = work + P256_ENTRY
    val table = work + P256_TABLE
    // Entry 0 is the point at infinity, (0 : 1 : 0).
    for (j in 0 until 24) ablaUnsafeStoreU32(bnPointer(table + j * 4), 0)
    bnCopy(table + 32, p256One(f), P256_WORDS)
    bnCopy(table + 96, point, 24)
    for (i in 2 until 16) p256PointAdd(f, work, table + i * 96, table + (i - 1) * 96, point)
    bnCopy(accumulator, table, 24)
    var window = 63
    while (window >= 0) {
        for (i in 0 until 4) {
            p256PointDouble(f, work, sum, accumulator)
            bnCopy(accumulator, sum, 24)
        }
        val position = window * 4
        val digit = (bnLoad(scalar + (position / 32) * 4) >> (position % 32)) & secretU32(u32(15))
        if (bnWideLimbs(24)) bnLookup64(entry, table, 16, 24, digit)
        else bnLookup(entry, table, 16, 24, digit)
        p256PointAdd(f, work, sum, accumulator, entry)
        bnCopy(accumulator, sum, 24)
        window = window - 1
    }
    bnCopy(out, accumulator, 24)
}

/** `out` = `a` * `b` mod the modulus, all plain (the ECDSA signature: r * d, and s = (e + r d) * k^-1: `d` and `k^-1` are secret). */
trusted fun p256MultiplyPlain(m: BnModulus, out: int, a: int, b: int): void {
    val encoded = bnAllocate(P256_WORDS)
    p256MultiplyPlainBody(m.memory, out, a, b, encoded)
    bnRelease(encoded, P256_WORDS)
}

/** What p256MultiplyPlain does, on a modulus block at `memory` and a work area of eight limbs. */
@inline trusted fun p256MultiplyPlainBody(memory: int, out: int, a: int, b: int, encoded: int): void {
    bnExpMultiplyAt(memory, P256_WORDS, encoded, a, memory + P256_WORDS * 4 + 4)
    bnExpMultiplyAt(memory, P256_WORDS, out, encoded, b)
}

/** `out` = `scalar` * G, the generator: `scalar` is eight plain limbs (secret), `table` the sixteen entries of p256CombTable, `out` neither. The scalar is read as
 *  four 64-bit rows, column t of the rows (one bit of each: a digit of four bits) picks one entry (the whole table is read, bnLookup), and 64 columns
 *  from the top each do one doubling and one addition: 64 doublings, not the 256 of a window method, since the table already holds the multiples
 *  of G by 2^64, 2^128 and 2^192. */
trusted fun p256FixedBaseMultiply(f: int, work: int, out: int, table: int, scalar: int): void {
    val accumulator = work + P256_ACCUMULATOR
    val sum = work + P256_SUM
    val entry = work + P256_ENTRY
    for (j in 0 until 24) ablaUnsafeStoreU32(bnPointer(accumulator + j * 4), 0)
    bnCopy(accumulator + 32, p256One(f), P256_WORDS)
    var column = 63
    while (column >= 0) {
        p256PointDouble(f, work, sum, accumulator)
        bnCopy(accumulator, sum, 24)
        val shift = column % 32
        val half = (column / 32) * 4
        var digit = (bnLoad(scalar + half) >> shift) & secretU32(u32(1))
        digit = digit | (((bnLoad(scalar + half + 8) >> shift) & secretU32(u32(1))) << 1)
        digit = digit | (((bnLoad(scalar + half + 16) >> shift) & secretU32(u32(1))) << 2)
        digit = digit | (((bnLoad(scalar + half + 24) >> shift) & secretU32(u32(1))) << 3)
        if (bnWideLimbs(24)) bnLookup64(entry, table, 16, 24, digit)
        else bnLookup(entry, table, 16, 24, digit)
        p256PointAdd(f, work, sum, accumulator, entry)
        bnCopy(accumulator, sum, 24)
        column = column - 1
    }
    bnCopy(out, accumulator, 24)
}
// END P256 SECRET CORES


// The comb of p256FixedBaseMultiply: entry idx (1 to 15) is the sum over the bits j of idx of 2^(64 j) G, as affine x || y (tools/p256/comb-table.ab prints them;
// tests/cases/p256/comb.ab checks each against the general scalar multiplication). Entry 0 is the point at infinity.
private val P256_COMB =
    "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5" +
    "0fa822bc2811aaa58492592e326e25de29493baaad651f7e90e75cb48e14db63bff44ae8f5dba80d6f4ad4bcb3df188b34b1a65050fe82f5e41124545f462ee7" +
    "300a4bbc89d6726fb257c0de95e02789e96c98fd0d35f1fa93391ce2097992af72aac7e0d09b46447f1ddb25ff1e3c6f5bb1eeada9d806a5aa54a291c08127a0" +
    "447d739beedb5e67fb982fd588c6766efc35ff7dc297eac357c84fc9d789bd852d4825ab834131eee12e9d953a4aaff73d349b95a7fae5000c7e33c972e25b32" +
    "ef9519328a9c72ffddc6068bb91dfc60ef7fbd2b1a0a11b713949c932a1d367f611e9fc37dbb2c9bc1ee9807022c219c23183b0895ca1740196035a77376d8a8" +
    "550663797b51f5d87dea6482e11238bf2936df5ec6c9bc36cae2b1920b57f4bc157164848aecb8510afa40018d9d50e59fb3d576dbdefbe144ffe216348a964c" +
    "eb5d7745b21141eaa2e8f483f43e43917ccd84e70d715f26e48ecafffc5cde01eafd72ebdbecc17b0990e6a158006cee85f22cfe2844b645cac917e2731a3479" +
    "a6d39677a78492762736ff8344315fc596439591a3c6b94a6cf20ffb313728be674f84749b0b881666b8babd2d27ecdf824a920c2284059bf2bab833c357f5f4" +
    "4e769e7672c9ddad31855f7db8c7fedb74e02f080203a56b2df48c04677c8a3e42b99082de8306631ec0057206947281fb9ae16f3b9122a5a4c36165b824bbb0" +
    "78878ef61c6ce04d7fdc1ca008a1c478d1f89e799c0ce1316ef95150dda868b9b6cb3f5d7b72c321de53142c12309def6ace570ebde08d4f9c62b9121fe0d976" +
    "0c88bc4d716b1287595c5220812ffcae5b82dd5bd54fb4967f991ed2c31a3573dd5ddea3f3901dc618d1b5b39c04e6aa7c8181f4df2564f33a57bf635f48aca8" +
    "68f344af6b317466efe0a423083e49f343a0a28c42ba792fe96a79fb3e72ad0c31b9c405f8540a20604ed93c24d67ff3668bfc2271f5c626cdfe17db3fb24d4a" +
    "4052bf4b6f461db9663c62c3edbad7a00d1a10144ec39c28d36b4789a2582e7ffecf4d5190b0fc61862be6bd71d70cc8e724f33999bfcc5b235a27c3188d25eb" +
    "1eddbae2c802e41a123202a8f62bff7aafdf5cc08526a7a474346c10a1d4cfac43104d86560ebcfc0c45f45273db33a036e06b7e4c7019178fa0af2dd603f844" +
    "b48e26b484f7a21c0a4a46fb6aaf363a66b0de3225c4744b9615b5110d1d78e5fac015404d4d3dab64131bcdfed6f668c004e4048b7b0f9806ebb0f621a01b2d"

/** The sixteen entries (24 limbs each, projective, Montgomery form) of the comb at `table`. */
trusted fun p256CombTable(c: P256Curve, table: int): void {
    for (j in 0 until 24) ablaUnsafeStoreU32(bnPointer(table + j * 4), 0)
    bnCopy(table + 32, c.field.one(), P256_WORDS)
    val plain = bnAllocate(P256_WORDS)
    for (idx in 1 until 16) {
        val bytes = hexDecode(P256_COMB.slice((idx - 1) * 128, idx * 128))
        val entry = table + idx * 96
        bnFromBytes(plain, P256_WORDS, ablaUnsafeStringAddress(bytes), 32)
        bnEncode(c.field, entry, plain)
        bnFromBytes(plain, P256_WORDS, ablaUnsafeStringAddress(bytes) + 32, 32)
        bnEncode(c.field, entry + 32, plain)
        bnCopy(entry + 64, c.field.one(), P256_WORDS)
    }
    bnRelease(plain, P256_WORDS)
}
// A table of sixteen multiples of a point, 0 P to 15 P (24 limbs each), and u1 G + u2 Q on public scalars (ECDSA verification), both outside the region
// the constant-time test reads: nothing here is secret, so the loop shares its doublings between the two scalars and skips the zero digits.
trusted fun p256Table(f: int, work: int, table: int, point: int): void {
    for (j in 0 until 24) ablaUnsafeStoreU32(bnPointer(table + j * 4), 0)
    bnCopy(table + 32, p256One(f), P256_WORDS)
    bnCopy(table + 96, point, 24)
    for (i in 2 until 16) p256PointAdd(f, work, table + i * 96, table + (i - 1) * 96, point)
}

/// Writes the sum of two public scalar-point products into `out` using precomputed point tables.
trusted fun p256DoubleMultiplyPublic(f: int, work: int, out: int, firstTable: int, first: int, secondTable: int, second: int): void {
    val accumulator = work + P256_ACCUMULATOR
    val sum = work + P256_SUM
    for (j in 0 until 24) ablaUnsafeStoreU32(bnPointer(accumulator + j * 4), 0)
    bnCopy(accumulator + 32, p256One(f), P256_WORDS)
    var window = 63
    while (window >= 0) {
        for (i in 0 until 4) {
            p256PointDouble(f, work, sum, accumulator)
            bnCopy(accumulator, sum, 24)
        }
        val position = window * 4
        val shift = position % 32
        val word = (position / 32) * 4
        val a = (int(ablaUnsafeLoadU32(bnPointer(first + word))) >> shift) & 15
        if (a != 0) {
            p256PointAdd(f, work, sum, accumulator, firstTable + a * 96)
            bnCopy(accumulator, sum, 24)
        }
        val b = (int(ablaUnsafeLoadU32(bnPointer(second + word))) >> shift) & 15
        if (b != 0) {
            p256PointAdd(f, work, sum, accumulator, secondTable + b * 96)
            bnCopy(accumulator, sum, 24)
        }
        window = window - 1
    }
    bnCopy(out, accumulator, 24)
}


// --- Conversions -------------------------------------------------------------------------------------------------

/** The `count` bytes at `limbs` as a string, most significant first. */
trusted fun p256Bytes(limbs: int, count: int): string {
    val out = nativeByteBuffer(count + 1)
    bnToBytes(ablaUnsafePointerAddress(out.pointerAt(0)), count, limbs)
    out.adoptString(count)
}

/** Whether the eight limbs are zero (for a decision that is public: a rejected key or point). */
trusted fun p256IsZero(value: int): bool {
    var any = secretU32(u32(0))
    for (j in 0 until P256_WORDS) any = any | bnLoad(value + j * 4)
    ctIsZero(any).declassify() != u32(0)
}

/** `out` = `z` ^ (p - 2) (Montgomery form in and out): the inverse, zero for zero. The exponent is public, so the bits are branched on. */
trusted fun p256FInvert(c: P256Curve, out: int, z: int): void {
    val tm = c.work + P256_MUL
    val exponent = hexDecode(P256_PRIME_MINUS_TWO)
    bnCopy(out, c.field.one(), P256_WORDS)
    for (bit in 0 until 256) {
        p256FMul(out, out, out, tm)
        if (((exponent[bit >> 3] >> (7 - (bit & 7))) & 1) == 1) p256FMul(out, out, z, tm)
    }
}

/** The point at `point` (projective, Montgomery) as plain affine x and y, or false for the point at infinity. */
trusted fun p256ToAffine(c: P256Curve, point: int, x: int, y: int): bool {
    val f = c.field
    val tm = c.work + P256_MUL
    val inverse = bnAllocate(P256_WORDS)
    val xm = bnAllocate(P256_WORDS)
    val ym = bnAllocate(P256_WORDS)
    val infinity = p256IsZero(point + 64)
    p256FInvert(c, inverse, point + 64)
    p256FMul(xm, point, inverse, tm)
    p256FMul(ym, point + 32, inverse, tm)
    bnDecode(f, x, xm)
    bnDecode(f, y, ym)
    bnRelease(inverse, P256_WORDS)
    bnRelease(xm, P256_WORDS)
    bnRelease(ym, P256_WORDS)
    !infinity
}

/** The generator, projective in Montgomery form, at `out` (24 limbs). */
trusted fun p256Generator(c: P256Curve, out: int): void {
    val plain = bnAllocate(P256_WORDS)
    val gx = hexDecode(P256_GX)
    bnFromBytes(plain, P256_WORDS, ablaUnsafeStringAddress(gx), 32)
    bnEncode(c.field, out, plain)
    val gy = hexDecode(P256_GY)
    bnFromBytes(plain, P256_WORDS, ablaUnsafeStringAddress(gy), 32)
    bnEncode(c.field, out + 32, plain)
    bnCopy(out + 64, c.field.one(), P256_WORDS)
    bnRelease(plain, P256_WORDS)
}

/** `out` (24 limbs) the public point `encoded` (0x04 || X || Y) in Montgomery form, if it is a point of the curve. */
trusted fun p256ParsePoint(c: P256Curve, encoded: string, out: int): bool {
    if (encoded.size != 65 || encoded[0] != 4) return false
    val f = c.field
    val x = bnAllocate(P256_WORDS)
    val y = bnAllocate(P256_WORDS)
    bnFromBytes(x, P256_WORDS, ablaUnsafeStringAddress(encoded) + 1, 32)
    bnFromBytes(y, P256_WORDS, ablaUnsafeStringAddress(encoded) + 33, 32)
    var ok = bnLessPublic(x, f.value(), P256_WORDS) && bnLessPublic(y, f.value(), P256_WORDS)
    if (ok) {
        val xm = out
        val ym = out + 32
        bnEncode(f, xm, x)
        bnEncode(f, ym, y)
        bnCopy(out + 64, f.one(), P256_WORDS)
        // y^2 = x^3 - 3x + b
        val left = bnAllocate(P256_WORDS)
        val right = bnAllocate(P256_WORDS)
        bnMultiply(f, left, ym, ym)
        bnMultiply(f, right, xm, xm)
        bnMultiply(f, right, right, xm)
        for (i in 0 until 3) p256Subtract(f.memory, right, right, xm)
        p256Add(f.memory, right, right, c.work + P256_B_AT)
        ok = bnEqual(left, right, P256_WORDS)
        bnRelease(left, P256_WORDS)
        bnRelease(right, P256_WORDS)
    }
    bnRelease(x, P256_WORDS)
    bnRelease(y, P256_WORDS)
    ok
}

/** The 32 bytes at `key` as a private scalar in `out` (eight limbs), if it is in 1..n-1. */
trusted fun p256ParseScalar(c: P256Curve, key: string, out: int): bool {
    if (key.size != 32) return false
    bnFromBytes(out, P256_WORDS, ablaUnsafeStringAddress(key), 32)
    p256InRange(c.order.value(), out) != u32(0)
}

/** `out` = the digest's leftmost 256 bits as a number, reduced mod n (it is below 2 n). */
trusted fun p256DigestScalar(c: P256Curve, digest: string, out: int): void {
    val size = if (digest.size > 32) 32 else digest.size
    bnFromBytes(out, P256_WORDS, ablaUnsafeStringAddress(digest), size)
    bnConditionalSubtractBody(out, out, secretU32(u32(0)), c.order.value(), P256_WORDS, c.order.scratch())
}

private fun p256Failed(error: string): CryptoResult = cryptoFailed(error)

// --- Keys and ECDH -----------------------------------------------------------------------------------------------

/** The public key, 65 bytes (0x04 || X || Y), of a private key of 32 bytes. */
trusted fun p256PublicKey(privateKey: string): CryptoResult {
    val result = p256PublicKeyWork(privateKey)
    ctScrubStack4096()
    return result
}

private @noinline trusted fun p256PublicKeyWork(privateKey: string): CryptoResult {
    val c = p256Open()
    val scalar = bnAllocate(P256_WORDS)
    var result = p256Failed("the private key is not a number from 1 to n-1 in 32 bytes")
    if (p256ParseScalar(c, privateKey, scalar)) {
        val g = bnAllocate(384)
        val point = bnAllocate(24)
        val x = bnAllocate(P256_WORDS)
        val y = bnAllocate(P256_WORDS)
        p256CombTable(c, g)
        p256FixedBaseMultiply(c.field.memory, c.work, point, g, scalar)
        if (p256ToAffine(c, point, x, y)) {
            result = CryptoResult("\x04" + p256Bytes(x, 32) + p256Bytes(y, 32), true, "")
        }
        bnRelease(g, 384)
        bnRelease(point, 24)
        bnRelease(x, P256_WORDS)
        bnRelease(y, P256_WORDS)
    }
    bnRelease(scalar, P256_WORDS)
    p256Close(c)
    result
}

/** Whether `encoded` is an uncompressed point of the curve (and so a valid public key). */
trusted fun p256IsValidPublicKey(encoded: string): bool {
    val c = p256Open()
    val point = bnAllocate(24)
    val ok = p256ParsePoint(c, encoded, point)
    bnRelease(point, 24)
    p256Close(c)
    ok
}

/** ECDH: the x coordinate, 32 bytes, of `privateKey` times the peer's public point. The peer's point is checked;
 *  a private key out of range is refused. */
trusted fun p256Ecdh(privateKey: string, peerPublicKey: string): CryptoResult {
    val result = p256EcdhWork(privateKey, peerPublicKey)
    ctScrubStack4096()
    return result
}

private @noinline trusted fun p256EcdhWork(privateKey: string, peerPublicKey: string): CryptoResult {
    val c = p256Open()
    val scalar = bnAllocate(P256_WORDS)
    var result = p256Failed("the private key is not a number from 1 to n-1 in 32 bytes")
    if (p256ParseScalar(c, privateKey, scalar)) {
        val peer = bnAllocate(24)
        result = p256Failed("the public key is not a point of P-256")
        if (p256ParsePoint(c, peerPublicKey, peer)) {
            val point = bnAllocate(24)
            val x = bnAllocate(P256_WORDS)
            val y = bnAllocate(P256_WORDS)
            p256ScalarMultiply(c.field.memory, c.work, point, peer, scalar)
            if (p256ToAffine(c, point, x, y)) result = CryptoResult(p256Bytes(x, 32), true, "")
            bnRelease(point, 24)
            bnRelease(x, P256_WORDS)
            bnRelease(y, P256_WORDS)
        }
        bnRelease(peer, 24)
    }
    bnRelease(scalar, P256_WORDS)
    p256Close(c)
    result
}

/** A random private key of 32 bytes, or a failure if there is no random source (see cryptoSetRandom). */
trusted fun p256GeneratePrivateKey(): CryptoResult {
    val c = p256Open()
    val scalar = bnAllocate(P256_WORDS)
    var result = p256Failed("no random source here: call cryptoSetRandom")
    var tries = 0
    while (tries < 64) {
        val bytes = cryptoRandomBytes(32)
        if (bytes.size != 32) break
        if (p256ParseScalar(c, bytes, scalar)) {
            result = CryptoResult(bytes, true, "")
            break
        }
        tries = tries + 1
    }
    bnRelease(scalar, P256_WORDS)
    p256Close(c)
    result
}

// --- ECDSA ---------------------------------------------------------------------------------------------------------

/** RFC 6979's nonce for SHA-256 and the private key `key` (32 bytes) for the message hash `h1`, or "" if no
 *  candidate falls in 1..n-1 in 100 tries (it always does). `reduced` is h1 mod n as bytes. */
trusted fun p256Nonce(c: P256Curve, key: string, reduced: string): string {
    var v = "\x01".repeat(32)
    var k = "\x00".repeat(32)
    k = hmacSha256(k, v + "\x00" + key + reduced)
    v = hmacSha256(k, v)
    k = hmacSha256(k, v + "\x01" + key + reduced)
    v = hmacSha256(k, v)
    val candidate = bnAllocate(P256_WORDS)
    var found = ""
    var tries = 0
    while (tries < 100) {
        v = hmacSha256(k, v)
        bnFromBytes(candidate, P256_WORDS, ablaUnsafeStringAddress(v), 32)
        if (p256InRange(c.order.value(), candidate) != u32(0)) {
            found = v
            break
        }
        k = hmacSha256(k, v + "\x00")
        v = hmacSha256(k, v)
        tries = tries + 1
    }
    bnRelease(candidate, P256_WORDS)
    found
}

/** ECDSA over SHA-256 (RFC 6979 nonce, so a message always gets the same signature): the 64 bytes r || s. */
trusted fun p256EcdsaSignRaw(privateKey: string, message: string): CryptoResult {
    val result = p256EcdsaSignWork(privateKey, message)
    ctScrubStack4096()
    return result
}

private @noinline trusted fun p256EcdsaSignWork(privateKey: string, message: string): CryptoResult {
    val c = p256Open()
    val d = bnAllocate(P256_WORDS)
    var result = p256Failed("the private key is not a number from 1 to n-1 in 32 bytes")
    if (p256ParseScalar(c, privateKey, d)) {
        val order = c.order
        val digest = sha256(message)
        val e = bnAllocate(P256_WORDS)
        p256DigestScalar(c, digest, e)
        val nonce = p256Nonce(c, privateKey, p256Bytes(e, 32))
        result = p256Failed("no usable nonce")
        if (nonce.size == 32) {
            val k = bnAllocate(P256_WORDS)
            val g = bnAllocate(384)
            val point = bnAllocate(24)
            val x = bnAllocate(P256_WORDS)
            val y = bnAllocate(P256_WORDS)
            val inverse = bnAllocate(P256_WORDS)
            val product = bnAllocate(P256_WORDS)
            bnFromBytes(k, P256_WORDS, ablaUnsafeStringAddress(nonce), 32)
            p256CombTable(c, g)
            p256FixedBaseMultiply(c.field.memory, c.work, point, g, k)
            p256ToAffine(c, point, x, y)
            // r = x mod n (x is below p, which is below 2 n); s = k^-1 (e + r d) mod n.
            bnConditionalSubtractBody(x, x, secretU32(u32(0)), order.value(), P256_WORDS, order.scratch())
            bnExpPublic(order, inverse, k, hexDecode(P256_ORDER_MINUS_TWO))
            p256MultiplyPlain(order, product, x, d)
            p256Add(order.memory, product, product, e)
            p256MultiplyPlain(order, product, product, inverse)
            // r or s of zero would call, in RFC 6979, for the next candidate nonce: it happens about once in 2^256 signatures,
            // and is reported as a failure.
            if (!p256IsZero(x) && !p256IsZero(product)) {
                result = CryptoResult(p256Bytes(x, 32) + p256Bytes(product, 32), true, "")
            }
            bnRelease(k, P256_WORDS)
            bnRelease(g, 384)
            bnRelease(point, 24)
            bnRelease(x, P256_WORDS)
            bnRelease(y, P256_WORDS)
            bnRelease(inverse, P256_WORDS)
            bnRelease(product, P256_WORDS)
        }
        bnRelease(e, P256_WORDS)
    }
    bnRelease(d, P256_WORDS)
    p256Close(c)
    result
}

// An INTEGER of a DER signature for a 32-byte value: minimal, positive.
private fun p256DerInteger(value: string): string {
    var start = 0
    while (start < 31 && value[start] == 0) start = start + 1
    val body = value.slice(start, 32)
    val padded = if (body[0] >= 128) "\x00" + body else body
    "\x02" + byteEncode(padded.size) + padded
}

/** The signature r || s (64 bytes) as DER, the form X.509 and TLS carry. */
fun p256SignatureToDer(raw: string): string {
    if (raw.size != 64) return ""
    val body = p256DerInteger(raw.slice(0, 32)) + p256DerInteger(raw.slice(32, 64))
    "\x30" + byteEncode(body.size) + body
}

/** One DER INTEGER at `at` of `text` below `limit`, strict (short length, minimal, positive), as 32 bytes: "" if it is not one
 *  or does not fit in 32 bytes. */
private fun p256DerReadInteger(text: string, at: int, limit: int): string {
    if (at + 2 > limit || text[at] != 2) return ""
    val length = text[at + 1]
    if (length == 0 || length >= 128 || at + 2 + length > limit) return ""
    val first = text[at + 2]
    if (first >= 128) return ""
    if (length > 1 && first == 0 && text[at + 3] < 128) return ""
    var bytes = text.slice(at + 2, at + 2 + length)
    if (first == 0 && length > 1) bytes = bytes.slice(1, length)
    if (bytes.size > 32) return ""
    "\x00".repeat(32 - bytes.size) + bytes
}

/** r || s (64 bytes) from a strict DER signature, or "". */
fun p256SignatureFromDer(der: string): string {
    if (der.size < 8 || der[0] != 48 || der[1] >= 128 || der[1] + 2 != der.size) return ""
    val rLength = der[3]
    val r = p256DerReadInteger(der, 2, der.size)
    if (r == "") return ""
    val next = 2 + 2 + rLength
    val s = p256DerReadInteger(der, next, der.size)
    if (s == "" || next + 2 + der[next + 1] != der.size) return ""
    r + s
}

/** ECDSA over SHA-256, the signature as DER. */
trusted fun p256EcdsaSign(privateKey: string, message: string): CryptoResult {
    val raw = p256EcdsaSignRaw(privateKey, message)
    if (!raw.ok) return raw
    CryptoResult(p256SignatureToDer(raw.bytes), true, "")
}

/** Verifies `signature` (64 bytes, r || s) over a message digest (SHA-256 normally; a longer digest is cut to its
 *  leftmost 256 bits, as ECDSA says) by the public key. Public inputs: not constant time. */
trusted fun p256EcdsaVerifyDigestRaw(publicKey: string, digest: string, signature: string): bool {
    if (signature.size != 64 || digest.size == 0) return false
    val c = p256Open()
    val order = c.order
    val q = bnAllocate(24)
    var valid = false
    if (p256ParsePoint(c, publicKey, q)) {
        val r = bnAllocate(P256_WORDS)
        val s = bnAllocate(P256_WORDS)
        bnFromBytes(r, P256_WORDS, ablaUnsafeStringAddress(signature), 32)
        bnFromBytes(s, P256_WORDS, ablaUnsafeStringAddress(signature) + 32, 32)
        if (!p256IsZero(r) && !p256IsZero(s) && bnLessPublic(r, order.value(), P256_WORDS) &&
            bnLessPublic(s, order.value(), P256_WORDS)) {
            val e = bnAllocate(P256_WORDS)
            val w = bnAllocate(P256_WORDS)
            val u1 = bnAllocate(P256_WORDS)
            val u2 = bnAllocate(P256_WORDS)
            val g = bnAllocate(24)
            val gTable = bnAllocate(384)
            val qTable = bnAllocate(384)
            val total = bnAllocate(24)
            val x = bnAllocate(P256_WORDS)
            val y = bnAllocate(P256_WORDS)
            p256DigestScalar(c, digest, e)
            bnExpPublic(order, w, s, hexDecode(P256_ORDER_MINUS_TWO))
            p256MultiplyPlain(order, u1, e, w)
            p256MultiplyPlain(order, u2, r, w)
            p256Generator(c, g)
            p256Table(c.field.memory, c.work, gTable, g)
            p256Table(c.field.memory, c.work, qTable, q)
            p256DoubleMultiplyPublic(c.field.memory, c.work, total, gTable, u1, qTable, u2)
            if (p256ToAffine(c, total, x, y)) {
                bnConditionalSubtractBody(x, x, secretU32(u32(0)), order.value(), P256_WORDS, order.scratch())
                valid = bnEqual(x, r, P256_WORDS)
            }
            bnRelease(e, P256_WORDS)
            bnRelease(w, P256_WORDS)
            bnRelease(u1, P256_WORDS)
            bnRelease(u2, P256_WORDS)
            bnRelease(g, 24)
            bnRelease(gTable, 384)
            bnRelease(qTable, 384)
            bnRelease(total, 24)
            bnRelease(x, P256_WORDS)
            bnRelease(y, P256_WORDS)
        }
        bnRelease(r, P256_WORDS)
        bnRelease(s, P256_WORDS)
    }
    bnRelease(q, 24)
    p256Close(c)
    valid
}

/** ECDSA over SHA-256, the signature as r || s (64 bytes). */
trusted fun p256EcdsaVerifyRaw(publicKey: string, message: string, signature: string): bool =
    p256EcdsaVerifyDigestRaw(publicKey, sha256(message), signature)

/** ECDSA over SHA-256, the signature as strict DER. */
trusted fun p256EcdsaVerify(publicKey: string, message: string, signature: string): bool {
    val raw = p256SignatureFromDer(signature)
    raw != "" && p256EcdsaVerifyRaw(publicKey, message, raw)
}

/** ECDSA over SHA-384 (TLS 1.2's ecdsa_secp256r1 with a longer hash; the digest is cut to 256 bits). */
trusted fun p256EcdsaVerifySha384(publicKey: string, message: string, signature: string): bool {
    val raw = p256SignatureFromDer(signature)
    raw != "" && p256EcdsaVerifyDigestRaw(publicKey, sha384(message), raw)
}
