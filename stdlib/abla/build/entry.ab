import "abla/compiler"

// Framework-neutral programmable-build helpers. Platform packages compose
// these primitives; the compiler itself does not know their policies.
// Builds `entry` as named program `name` for `target`, writing the requested `artifact` to `output`. `fast` selects fast compilation and `cache` permits caching. Returns whether the compiler accepted the build node. It compiles the graph after evaluation.
compile fun buildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool = compilerBuildProgram(
    name,
    entry,
    output,
    target,
    artifact,
    fast,
    cache
)

// Registers target `name` with its `llvmTriple`, `objectFormat`, linker flavor and emulation, and hosted and libc-free policies. Returns whether the compiler accepted the target.
compile fun defineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool = compilerDefineTarget(
    name,
    llvmTriple,
    objectFormat,
    linkerFlavor,
    linkerEmulation,
    hosted,
    libcFree
)

// Returns true if the build graph accepts the SDK association for the named target.
compile fun defineTargetSdk(name: string, sdk: string): bool =
    compilerDefineTargetSdk(name, sdk)

// Returns true if the build graph accepts the ELF link input. With asNeeded, a shared library is retained only if used.
compile fun defineTargetLinkInput(name: string, path: string, asNeeded: bool = false): bool =
    compilerDefineTargetLinkInput(name, path, asNeeded)

// Looks up `sourceName` and exports it under ABI symbol `foreignName`. Returns whether the compiler accepted the export.
compile fun exportFunction(
    sourceName: string,
    foreignName: string
): bool {
    val handle = compiler.findFunction(sourceName)
    compiler.exportFunction(handle, foreignName)
}

// Give a foreign-ABI adapter a stable object symbol without exposing it
// outside the LLVM unit. This is useful for inline/module assembly references;
// ordinary typed Abla calls should keep using the source function directly.
compile fun internalFunction(
    sourceName: string,
    linkName: string
): bool {
    val handle = compiler.findFunction(sourceName)
    compiler.internalFunction(handle, linkName)
}

// Retain a local implementation for a symbol that LLVM or the target backend
// can introduce after source/assembly reachability has closed. This does not
// publish the symbol in the artifact ABI.
compile fun requiredInternalFunction(
    sourceName: string,
    linkName: string
): bool {
    val handle = compiler.findFunction(sourceName)
    compiler.requiredInternalFunction(handle, linkName)
}

// Looks up `sourceName` and returns whether the compiler accepts it under `foreignName` with checked export handling.
compile fun exportCheckedFunction(
    sourceName: string,
    foreignName: string
): bool {
    val handle = compiler.findFunction(sourceName)
    compiler.exportCheckedFunction(handle, foreignName)
}
