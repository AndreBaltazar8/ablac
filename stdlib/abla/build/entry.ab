#import("abla/compiler")

// Framework-neutral programmable-build helpers. Platform packages compose
// these primitives; the compiler itself does not know their policies.
compile fun buildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool = compilerBuildProgram(
    name,
    entry,
    output,
    target,
    artifact,
    fast,
    cache
)

compile fun defineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool = compilerDefineTarget(
    name,
    llvmTriple,
    objectFormat,
    linkerFlavor,
    linkerEmulation,
    hosted,
    libcFree
)

compile fun exportFunction(
    sourceName: string,
    foreignName: string
): bool = compilerExportFunction(
    compilerFindFunction(sourceName),
    foreignName
)
