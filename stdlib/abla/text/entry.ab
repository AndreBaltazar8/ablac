// Phase-safe UTF-8 inspection. Abla strings remain byte-preserving; this
// module adds explicit Unicode scalar operations without forcing Unicode data
// tables into programs that only need bytes or ASCII.

import "abla/bytes"

class Utf8Info(
    val valid: bool,
    val codePoints: int,
    val errorOffset: int
)

noescape extern:"intrinsic" fun ablaUtf8EncodeScalar(scalar: int): string

noescape extern:"intrinsic" fun ablaTextFindSequence(
    text: string,
    sequence: string,
    begin: int,
    end: int
): int

noescape extern:"intrinsic" fun ablaTextFindByte(
    text: string,
    byte: int,
    begin: int,
    end: int
): int

noescape extern:"intrinsic" fun ablaTextAsciiEqualInsensitive(
    left: string,
    right: string
): bool

noescape extern:"intrinsic" fun ablaTextReadU32LittleEndian(
    text: string,
    offset: int
): int

noescape extern:"intrinsic" fun ablaTextIsValidUtf8(text: string): bool

fun utf8Encode(scalar: int): string = ablaUtf8EncodeScalar(scalar)

fun textFindSequence(
    text: string,
    sequence: string,
    begin: int = 0,
    end: int = text.size
): int = ablaTextFindSequence(text, sequence, begin, end)

fun textFindByte(
    text: string,
    byte: int,
    begin: int = 0,
    end: int = text.size
): int = ablaTextFindByte(text, byte, begin, end)

fun textAsciiEqualInsensitive(left: string, right: string): bool =
    ablaTextAsciiEqualInsensitive(left, right)

fun textReadU32LittleEndian(text: string, offset: int): int =
    ablaTextReadU32LittleEndian(text, offset)

fun utf8Continuation(byte: int): bool = byte >= 128 && byte <= 191

fun utf8SequenceLength(lead: int): int {
    var length = 0
    if (lead >= 0 && lead <= 127) length = 1
    if (lead >= 194 && lead <= 223) length = 2
    if (lead >= 224 && lead <= 239) length = 3
    if (lead >= 240 && lead <= 244) length = 4
    length
}

fun utf8SequenceValid(text: string, offset: int, length: int): bool {
    var valid = length > 0 && offset >= 0 && offset + length <= text.size
    var index = 1
    while (valid && index < length) {
        valid = utf8Continuation(text[offset + index])
        index = index + 1
    }
    if (valid && length == 3 && text[offset] == 224) {
        valid = text[offset + 1] >= 160
    }
    if (valid && length == 3 && text[offset] == 237) {
        valid = text[offset + 1] <= 159
    }
    if (valid && length == 4 && text[offset] == 240) {
        valid = text[offset + 1] >= 144
    }
    if (valid && length == 4 && text[offset] == 244) {
        valid = text[offset + 1] <= 143
    }
    valid
}

fun utf8Info(text: string): Utf8Info {
    var valid = true
    var offset = 0
    var count = 0
    var error = -1
    while (valid && offset < text.size) {
        val length = utf8SequenceLength(text[offset])
        valid = utf8SequenceValid(text, offset, length)
        if (valid) {
            offset = offset + length
            count = count + 1
        } else {
            error = offset
        }
    }
    Utf8Info(valid, count, error)
}

fun string.isValidUtf8(): bool = ablaTextIsValidUtf8(this)

fun string.codePointCount(): int {
    val info = utf8Info(this)
    if (info.valid) info.codePoints else -1
}

fun utf8DecodeAt(text: string, offset: int): int {
    var scalar = -1
    if (offset >= 0 && offset < text.size) {
        val lead = text[offset]
        val length = utf8SequenceLength(lead)
        if (utf8SequenceValid(text, offset, length)) {
            if (length == 1) scalar = lead
            if (length == 2) {
                scalar = (lead - 192) * 64 + text[offset + 1] - 128
            }
            if (length == 3) {
                scalar = (lead - 224) * 4096 +
                    (text[offset + 1] - 128) * 64 +
                    text[offset + 2] - 128
            }
            if (length == 4) {
                scalar = (lead - 240) * 262144 +
                    (text[offset + 1] - 128) * 4096 +
                    (text[offset + 2] - 128) * 64 +
                    text[offset + 3] - 128
            }
        }
    }
    scalar
}

fun string.codePointAt(position: int): int {
    var scalar = -1
    var offset = 0
    var current = 0
    var valid = position >= 0
    while (valid && offset < this.size && current <= position) {
        val length = utf8SequenceLength(this[offset])
        valid = utf8SequenceValid(this, offset, length)
        if (valid && current == position) scalar = utf8DecodeAt(this, offset)
        if (valid) {
            offset = offset + length
            current = current + 1
        }
    }
    scalar
}

fun utf8ByteOffset(text: string, position: int): int {
    var result = -1
    var offset = 0
    var current = 0
    var valid = position >= 0
    while (valid && current < position && offset < text.size) {
        val length = utf8SequenceLength(text[offset])
        valid = utf8SequenceValid(text, offset, length)
        if (valid) {
            offset = offset + length
            current = current + 1
        }
    }
    if (valid && current == position) result = offset
    result
}

fun string.codePointSlice(begin: int, end: int): string {
    val beginOffset = utf8ByteOffset(this, begin)
    val endOffset = utf8ByteOffset(this, end)
    if (beginOffset >= 0 && endOffset >= beginOffset) {
        this.slice(beginOffset, endOffset)
    } else ""
}

// Byte-oriented string helpers. Positions and sizes count bytes; whitespace
// and case mapping are ASCII only, so other bytes (UTF-8 included) pass
// through unchanged.

fun textAsciiSpace(byte: int): bool = byte == 32 || (byte >= 9 && byte <= 13)

fun string.startsWith(prefix: string): bool =
    prefix.size <= this.size &&
        ablaTextFindSequence(this, prefix, 0, prefix.size) == 0

fun string.endsWith(suffix: string): bool =
    suffix.size <= this.size &&
        ablaTextFindSequence(
            this, suffix, this.size - suffix.size, this.size
        ) == this.size - suffix.size

fun string.contains(needle: string): bool =
    ablaTextFindSequence(this, needle, 0, this.size) >= 0

// The first position of `needle` at or after `from`, or -1.
fun string.indexOf(needle: string, from: int = 0): int =
    if (from > this.size) -1
    else ablaTextFindSequence(
        this, needle, if (from < 0) 0 else from, this.size
    )

// The last position of `needle`, or -1.
fun string.lastIndexOf(needle: string): int {
    var position = this.size - needle.size
    var found = -1
    while (found < 0 && position >= 0) {
        if (ablaTextFindSequence(
            this, needle, position, position + needle.size
        ) == position) found = position
        position = position - 1
    }
    found
}

// The pieces between the occurrences of `separator`: n occurrences give
// n + 1 pieces, empty ones included. An empty separator leaves it whole.
fun string.split(separator: string): array<string> {
    val pieces: array<string> = []
    var begin = 0
    var found = if (separator.size == 0) -1
        else ablaTextFindSequence(this, separator, 0, this.size)
    while (found >= 0) {
        pieces.append(this.slice(begin, found))
        begin = found + separator.size
        found = ablaTextFindSequence(this, separator, begin, this.size)
    }
    pieces.append(this.slice(begin, this.size))
    pieces
}

// The parts, in order, with `separator` between each two.
fun textJoin(parts: array<string>, separator: string = ""): string {
    val buffer = byteBuffer()
    var index = 0
    while (index < parts.size) {
        if (index > 0) buffer.appendText(separator)
        buffer.appendText(parts[index])
        index = index + 1
    }
    buffer.toText()
}

fun string.trimStart(): string {
    var begin = 0
    while (begin < this.size && textAsciiSpace(this[begin])) begin = begin + 1
    this.slice(begin, this.size)
}

fun string.trimEnd(): string {
    var end = this.size
    while (end > 0 && textAsciiSpace(this[end - 1])) end = end - 1
    this.slice(0, end)
}

fun string.trim(): string {
    var begin = 0
    while (begin < this.size && textAsciiSpace(this[begin])) begin = begin + 1
    var end = this.size
    while (end > begin && textAsciiSpace(this[end - 1])) end = end - 1
    this.slice(begin, end)
}

// Every occurrence of `old` replaced by `replacement`, left to right. An
// empty `old` replaces nothing.
fun string.replace(old: string, replacement: string): string {
    var found = if (old.size == 0) -1
        else ablaTextFindSequence(this, old, 0, this.size)
    if (found < 0) return this.slice(0, this.size)
    val buffer = byteBuffer()
    var begin = 0
    while (found >= 0) {
        buffer.appendText(this.slice(begin, found))
        buffer.appendText(replacement)
        begin = found + old.size
        found = ablaTextFindSequence(this, old, begin, this.size)
    }
    buffer.appendText(this.slice(begin, this.size))
    buffer.toText()
}

fun textAsciiMapCase(text: string, from: int, to: int): string {
    var first = 0
    while (first < text.size &&
        !(text[first] >= from && text[first] < from + 26)) first = first + 1
    if (first == text.size) return text.slice(0, text.size)
    val buffer = byteBuffer()
    buffer.appendText(text.slice(0, first))
    var index = first
    while (index < text.size) {
        val byte = text[index]
        buffer.appendByteValue(
            if (byte >= from && byte < from + 26) byte - from + to else byte
        )
        index = index + 1
    }
    buffer.toText()
}

fun string.uppercase(): string = textAsciiMapCase(this, 97, 65)

fun string.lowercase(): string = textAsciiMapCase(this, 65, 97)

fun string.repeat(count: int): string {
    val buffer = byteBuffer()
    var index = 0
    while (index < count) {
        buffer.appendText(this)
        index = index + 1
    }
    buffer.toText()
}

fun textPadding(size: int, length: int, pad: string): string {
    val buffer = byteBuffer()
    var missing = length - size
    while (missing > 0 && pad.size > 0) {
        val piece = if (pad.size <= missing) pad else pad.slice(0, missing)
        buffer.appendText(piece)
        missing = missing - piece.size
    }
    buffer.toText()
}

// Padded at the start (or end) with `pad` repeated, to `length` bytes; a
// longer text is left as it is.
fun string.padStart(length: int, pad: string = " "): string =
    "${textPadding(this.size, length, pad)}$this"

fun string.padEnd(length: int, pad: string = " "): string =
    "$this${textPadding(this.size, length, pad)}"
