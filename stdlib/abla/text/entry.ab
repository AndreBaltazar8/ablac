// Phase-safe UTF-8 inspection. Abla strings remain byte-preserving; this
// module adds explicit Unicode scalar operations without forcing Unicode data
// tables into programs that only need bytes or ASCII.

import "abla/array"
import "abla/bytes"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// UTF-8 scan result. `valid` means the whole input passed, `codePoints` counts the valid prefix, and `errorOffset` is the first invalid sequence's byte offset or -1 on success.
class Utf8Info(
    val valid: bool,
    val codePoints: int,
    val errorOffset: int
)

// Returns the UTF-8 bytes for `scalar` or an empty string for a surrogate or out-of-range value.
noescape extern:"intrinsic" fun ablaUtf8EncodeScalar(scalar: int): string

// Returns the first byte offset of `sequence` in [`begin`, `end`), `begin` for an empty sequence within valid bounds, or -1 for invalid bounds or no match.
noescape extern:"intrinsic" fun ablaTextFindSequence(
    text: string,
    sequence: string,
    begin: int,
    end: int
): int

// Returns the first offset of `byte` in [`begin`, `end`) or -1 for invalid bounds, an invalid byte, or no match.
noescape extern:"intrinsic" fun ablaTextFindByte(
    text: string,
    byte: int,
    begin: int,
    end: int
): int

// Returns true when the inputs match byte for byte after folding ASCII letters to the same case.
noescape extern:"intrinsic" fun ablaTextAsciiEqualInsensitive(
    left: string,
    right: string
): bool

// Returns a little-endian unsigned 32-bit value as an int or -1 if four bytes cannot be read at `offset`.
noescape extern:"intrinsic" fun ablaTextReadU32LittleEndian(
    text: string,
    offset: int
): int

// Returns true if every byte in `text` belongs to a valid UTF-8 encoding of a Unicode scalar.
noescape extern:"intrinsic" fun ablaTextIsValidUtf8(text: string): bool

// Encodes the Unicode scalar `scalar` as UTF-8. Returns an empty string for surrogate values or values outside the Unicode range.
fun utf8Encode(scalar: int): string = ablaUtf8EncodeScalar(scalar)

// Searches `text` in the byte interval [`begin`, `end`) for `sequence`. Returns the first byte offset, `begin` for an empty sequence within valid bounds, or -1 for invalid bounds or no match.
fun textFindSequence(
    text: string,
    sequence: string,
    begin: int = 0,
    end: int = text.size
): int = ablaTextFindSequence(text, sequence, begin, end)

// Searches `text` in the byte interval [`begin`, `end`) for `byte`. Returns the first byte offset or -1 for no match, invalid bounds, or a byte outside 0–255.
fun textFindByte(
    text: string,
    byte: int,
    begin: int = 0,
    end: int = text.size
): int = ablaTextFindByte(text, byte, begin, end)

// Compares `left` and `right` byte by byte, ignoring case for ASCII letters. All other bytes must match exactly.
fun textAsciiEqualInsensitive(left: string, right: string): bool =
    ablaTextAsciiEqualInsensitive(left, right)

// Reads four little-endian bytes of `text` at byte `offset`. Returns the unsigned 32-bit value as an int or -1 if four bytes are unavailable.
fun textReadU32LittleEndian(text: string, offset: int): int =
    ablaTextReadU32LittleEndian(text, offset)

private fun utf8Continuation(byte: int): bool = byte >= 128 && byte <= 191

// Returns the expected UTF-8 sequence length for leading byte `lead`, or 0 if it cannot start a sequence.
fun utf8SequenceLength(lead: int): int {
    var length = 0
    if (lead >= 0 && lead <= 127) length = 1
    if (lead >= 194 && lead <= 223) length = 2
    if (lead >= 224 && lead <= 239) length = 3
    if (lead >= 240 && lead <= 244) length = 4
    length
}

// Checks that a candidate sequence in `text` at byte `offset` fits, has valid continuation bytes, and meets the boundary rules for three- and four-byte sequences. Supply `length` from utf8SequenceLength for the leading byte. Returns false when these checks fail.
fun utf8SequenceValid(text: string, offset: int, length: int): bool {
    var valid = length > 0 && offset >= 0 && offset + length <= text.size
    var index = 1
    while (valid && index < length) {
        valid = utf8Continuation(text[offset + index])
        index = index + 1
    }
    if (valid && length == 3 && text[offset] == 224) {
        valid = text[offset + 1] >= 160
    }
    if (valid && length == 3 && text[offset] == 237) {
        valid = text[offset + 1] <= 159
    }
    if (valid && length == 4 && text[offset] == 240) {
        valid = text[offset + 1] >= 144
    }
    if (valid && length == 4 && text[offset] == 244) {
        valid = text[offset + 1] <= 143
    }
    valid
}

// Scans `text` and reports UTF-8 validity, the number of complete scalars before any error, and the first invalid sequence's byte offset (-1 when valid).
fun utf8Info(text: string): Utf8Info {
    var valid = true
    var offset = 0
    var count = 0
    var error = -1
    while (valid && offset < text.size) {
        val length = utf8SequenceLength(text[offset])
        valid = utf8SequenceValid(text, offset, length)
        if (valid) {
            offset = offset + length
            count = count + 1
        } else {
            error = offset
        }
    }
    Utf8Info(valid, count, error)
}

// Keep the architecture query local to the runtime path.
private noescape extern:"intrinsic" fun ablaSimdTargetArch(): int

// The x86-64 validator scans long ASCII prefixes with SSE2. For shorter
// inputs and other targets, the local word loop checks ASCII and the
// intrinsic validates any input containing a multibyte sequence.
fun string.isValidUtf8(): bool {
    if (ablaAtCompileTime()) ablaTextIsValidUtf8(this)
    else isValidUtf8Native(this)
}

private trusted fun isValidUtf8Native(text: string): bool {
    val size = text.size
    if (size >= 32 && ablaSimdTargetArch() == 1) return ablaTextIsValidUtf8(text)
    val address = ablaUnsafeStringAddress(text)
    var at = 0
    while (at + 8 <= size) {
        if ((ablaUnsafeLoadI64(nativePointerFromAddress(address + at)) & -9187201950435737472) != 0) return ablaTextIsValidUtf8(text)
        at = at + 8
    }
    while (at < size) {
        if (ablaUnsafeLoadU8(nativePointerFromAddress(address + at)) >= 128) return ablaTextIsValidUtf8(text)
        at = at + 1
    }
    true
}

private fun codePointCountSlow(text: string): int {
    val info = utf8Info(text)
    if (info.valid) info.codePoints else -1
}

// Decodes a Unicode scalar from `text` at byte `offset`. Returns -1 if the offset is out of bounds or a valid sequence does not start there.
fun utf8DecodeAt(text: string, offset: int): int {
    var scalar = -1
    if (offset >= 0 && offset < text.size) {
        val lead = text[offset]
        val length = utf8SequenceLength(lead)
        if (utf8SequenceValid(text, offset, length)) {
            if (length == 1) scalar = lead
            if (length == 2) {
                scalar = (lead - 192) * 64 + text[offset + 1] - 128
            }
            if (length == 3) {
                scalar = (lead - 224) * 4096 +
                    (text[offset + 1] - 128) * 64 +
                    text[offset + 2] - 128
            }
            if (length == 4) {
                scalar = (lead - 240) * 262144 +
                    (text[offset + 1] - 128) * 4096 +
                    (text[offset + 2] - 128) * 64 +
                    text[offset + 3] - 128
            }
        }
    }
    scalar
}

// Returns the Unicode scalar at zero-based scalar `position`, or -1 if it is out of range or invalid UTF-8 is encountered while reaching or decoding it.
fun string.codePointAt(position: int): int {
    var scalar = -1
    var offset = 0
    var current = 0
    var valid = position >= 0
    while (valid && offset < this.size && current <= position) {
        val length = utf8SequenceLength(this[offset])
        valid = utf8SequenceValid(this, offset, length)
        if (valid && current == position) scalar = utf8DecodeAt(this, offset)
        if (valid) {
            offset = offset + length
            current = current + 1
        }
    }
    scalar
}

// Returns the byte offset reached after advancing `position` Unicode scalars from the start of `text`. Returns -1 for a negative position, insufficient scalars, or invalid UTF-8 in the traversed prefix.
fun utf8ByteOffset(text: string, position: int): int {
    var result = -1
    var offset = 0
    var current = 0
    var valid = position >= 0
    while (valid && current < position && offset < text.size) {
        val length = utf8SequenceLength(text[offset])
        valid = utf8SequenceValid(text, offset, length)
        if (valid) {
            offset = offset + length
            current = current + 1
        }
    }
    if (valid && current == position) result = offset
    result
}

// Returns the substring between Unicode scalar positions `begin` (inclusive) and `end` (exclusive). Returns an empty string for invalid or reversed bounds, including bounds that cannot be reached through valid UTF-8.
fun string.codePointSlice(begin: int, end: int): string {
    val beginOffset = utf8ByteOffset(this, begin)
    val endOffset = utf8ByteOffset(this, end)
    if (beginOffset >= 0 && endOffset >= beginOffset) {
        this.slice(beginOffset, endOffset)
    } else ""
}

// Byte-oriented string helpers. Positions and sizes count bytes; whitespace
// and case mapping are ASCII only, so other bytes (UTF-8 included) pass
// through unchanged.

private fun textAsciiSpace(byte: int): bool = byte == 32 || (byte >= 9 && byte <= 13)

// Returns true if the string begins with the exact bytes of `prefix`. An empty prefix always matches.
fun string.startsWith(prefix: string): bool =
    prefix.size <= this.size &&
        ablaTextFindSequence(this, prefix, 0, prefix.size) == 0

// Returns true if the string ends with the exact bytes of `suffix`. An empty suffix always matches.
fun string.endsWith(suffix: string): bool =
    suffix.size <= this.size &&
        ablaTextFindSequence(
            this, suffix, this.size - suffix.size, this.size
        ) == this.size - suffix.size

// Returns true if the exact bytes of `needle` occur in the string. An empty needle always matches.
fun string.contains(needle: string): bool =
    ablaTextFindSequence(this, needle, 0, this.size) >= 0

// The first position of `needle` at or after `from`, or -1.
fun string.indexOf(needle: string, from: int = 0): int =
    if (from > this.size) -1
    else ablaTextFindSequence(
        this, needle, if (from < 0) 0 else from, this.size
    )

// The last position of `needle`, or -1.
fun string.lastIndexOf(needle: string): int =
    if (ablaCompileTimeNativeHost()) lastIndexOfNative(this, needle)
    else if (ablaAtCompileTime()) lastIndexOfSlow(this, needle)
    else lastIndexOfNative(this, needle)

// The bytes compared in place, from the last position down: the first byte rules most positions out.
private trusted fun lastIndexOfNative(text: string, needle: string): int {
    val size = text.size
    val width = needle.size
    var position = size - width
    if (position < 0) return -1
    if (width == 0) return size
    val data = ablaUnsafeStringAddress(text)
    val pattern = ablaUnsafeStringAddress(needle)
    val first = ablaUnsafeLoadU8(nativePointerFromAddress(pattern))
    val last = ablaUnsafeLoadU8(nativePointerFromAddress(pattern + width - 1))
    while (position >= 0) {
        // The needle's last byte first, then its first: a repeated prefix rules a position out at once.
        if (ablaUnsafeLoadU8(nativePointerFromAddress(data + position + width - 1)) == last &&
            ablaUnsafeLoadU8(nativePointerFromAddress(data + position)) == first) {
            var k = 1
            while (k < width && ablaUnsafeLoadU8(nativePointerFromAddress(data + position + k)) ==
                ablaUnsafeLoadU8(nativePointerFromAddress(pattern + k))) k = k + 1
            if (k == width) return position
        }
        position = position - 1
    }
    -1
}

private fun lastIndexOfSlow(text: string, needle: string): int {
    var position = text.size - needle.size
    var found = -1
    while (found < 0 && position >= 0) {
        if (ablaTextFindSequence(
            text, needle, position, position + needle.size
        ) == position) found = position
        position = position - 1
    }
    found
}

// The pieces between the occurrences of `separator`: n occurrences give
// n + 1 pieces, empty ones included. An empty separator leaves it whole.
fun string.split(separator: string): array<string> {
    val pieces: array<string> = []
    var begin = 0
    var found = if (separator.size == 0) -1
        else ablaTextFindSequence(this, separator, 0, this.size)
    while (found >= 0) {
        pieces.append(this.slice(begin, found))
        begin = found + separator.size
        found = ablaTextFindSequence(this, separator, begin, this.size)
    }
    pieces.append(this.slice(begin, this.size))
    pieces
}

// The parts, in order, with `separator` between each two.
fun textJoin(parts: array<string>, separator: string = ""): string {
    val buffer = byteBuffer()
    var index = 0
    while (index < parts.size) {
        if (index > 0) buffer.appendText(separator)
        buffer.appendText(parts[index])
        index = index + 1
    }
    buffer.toText()
}

/** Joins the strings in order, inserting separator between them. */
fun array<string>.join(separator: string = ""): string = textJoin(this, separator)

// Returns the string with leading ASCII whitespace removed (space and bytes 9–13).
fun string.trimStart(): string {
    var begin = 0
    while (begin < this.size && textAsciiSpace(this[begin])) begin = begin + 1
    this.slice(begin, this.size)
}

// Returns the string with trailing ASCII whitespace removed (space and bytes 9–13).
fun string.trimEnd(): string {
    var end = this.size
    while (end > 0 && textAsciiSpace(this[end - 1])) end = end - 1
    this.slice(0, end)
}

// Returns the string with ASCII whitespace removed from both ends (space and bytes 9–13).
fun string.trim(): string {
    var begin = 0
    while (begin < this.size && textAsciiSpace(this[begin])) begin = begin + 1
    var end = this.size
    while (end > begin && textAsciiSpace(this[end - 1])) end = end - 1
    this.slice(begin, end)
}

// Every occurrence of `old` replaced by `replacement`, left to right. An
// empty `old` replaces nothing.
fun string.replace(old: string, replacement: string): string {
    var found = if (old.size == 0) -1
        else ablaTextFindSequence(this, old, 0, this.size)
    if (found < 0) return this.slice(0, this.size)
    val buffer = byteBuffer()
    var begin = 0
    while (found >= 0) {
        buffer.appendText(this.slice(begin, found))
        buffer.appendText(replacement)
        begin = found + old.size
        found = ablaTextFindSequence(this, old, begin, this.size)
    }
    buffer.appendText(this.slice(begin, this.size))
    buffer.toText()
}

private fun textAsciiMapCaseSlow(text: string, from: int, to: int): string {
    var first = 0
    while (first < text.size &&
        !(text[first] >= from && text[first] < from + 26)) first = first + 1
    if (first == text.size) return text.slice(0, text.size)
    val buffer = byteBuffer()
    buffer.appendText(text.slice(0, first))
    var index = first
    while (index < text.size) {
        val byte = text[index]
        buffer.appendByteValue(
            if (byte >= from && byte < from + 26) byte - from + to else byte
        )
        index = index + 1
    }
    buffer.toText()
}

// Returns the string with ASCII a–z mapped to A–Z. Other bytes are preserved.
fun string.uppercase(): string = textAsciiMapCase(this, 97, 65)

// Returns the string with ASCII A–Z mapped to a–z. Other bytes are preserved.
fun string.lowercase(): string = textAsciiMapCase(this, 65, 97)

// Returns `count` concatenated copies of the string, or an empty string when `count` is zero or negative.
fun string.repeat(count: int): string {
    // By doubling: an append per copy takes seconds to make megabytes of one byte.
    val buffer = byteBuffer()
    var piece = this
    var remaining = count
    while (remaining > 0) {
        if ((remaining & 1) != 0) buffer.appendText(piece)
        remaining = remaining >> 1
        if (remaining > 0) piece = "$piece$piece"
    }
    buffer.toText()
}

// The padding for `missing` bytes: `pad` repeated, a whole code point at a time. A code point that would not fit ends
// it, so a multi-byte pad can leave up to 3 bytes unfilled but never writes half of one. A byte of `pad` that is not
// part of a valid UTF-8 sequence counts as a unit of its own.
private fun textPadding(size: int, length: int, pad: string): string {
    val buffer = byteBuffer()
    var missing = length - size
    var at = 0
    var stopped = false
    while (missing > 0 && pad.size > 0 && !stopped) {
        if (at >= pad.size) at = 0
        var unit = utf8SequenceLength(pad[at])
        if (!utf8SequenceValid(pad, at, unit)) unit = 1
        if (unit > missing) {
            stopped = true
        } else {
            buffer.appendText(pad.slice(at, at + unit))
            missing = missing - unit
            at = at + unit
        }
    }
    buffer.toText()
}

// Padded at the start (or end) with `pad` repeated, to `length` bytes (whole code points only: see textPadding); a
// longer text is left as it is.
fun string.padStart(length: int, pad: string = " "): string =
    "${textPadding(this.size, length, pad)}$this"

// Appends repeated `pad` bytes until reaching `length` bytes or the next UTF-8 scalar would not fit. An invalid pad byte counts as a single unit. An empty pad or an already long enough string leaves the string unchanged.
fun string.padEnd(length: int, pad: string = " "): string =
    "$this${textPadding(this.size, length, pad)}"

// A copy of `values` in byte order (a stable merge sort, O(n log n)).
fun sortedStrings(values: array<string>): array<string> {
    val ordered = values.sortedBy { a, b -> stringLess(a, b) }
    // The result is a new array of its own (callers may return it), not a view of the one sorted.
    val result: array<string> = []
    for (item in ordered) result.append(item)
    result
}

/** A copy of the strings in byte order (stable merge sort, O(n log n)). */
fun array<string>.sorted(): array<string> = sortedStrings(this)

private fun stringLess(left: string, right: string): bool {
    var index = 0
    while (index < left.size && index < right.size) {
        if (left[index] != right[index]) return left[index] < right[index]
        index = index + 1
    }
    left.size < right.size
}

// Percent encoding (RFC 3986). The unreserved characters (letters, digits and - . _ ~) stay; every other byte of the
// string's UTF-8 becomes %XX with uppercase hexadecimal digits. With `query` set, a space is written `+` (the form
// encoding of a query component) instead of %20; a literal `+` is %2B either way.
private fun percentEncodeSlow(value: string, query: bool = false): string {
    val digits = "0123456789ABCDEF"
    val buffer = byteBuffer()
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            byte == 45 || byte == 46 || byte == 95 || byte == 126) {
            buffer.appendByteValue(byte)
        } else if (query && byte == 32) {
            buffer.appendByteValue(43)
        } else {
            buffer.appendByteValue(37)
            buffer.appendByteValue(digits[byte / 16])
            buffer.appendByteValue(digits[byte % 16])
        }
        index = index + 1
    }
    buffer.toText()
}

private fun percentHexValue(byte: int): int =
    if (byte >= 48 && byte <= 57) byte - 48
    else if (byte >= 65 && byte <= 70) byte - 55
    else if (byte >= 97 && byte <= 102) byte - 87
    else -1

// The text `value` stands for, or null when it is malformed: a `%` not followed by two hexadecimal digits (either
// case), or a result that is not valid UTF-8 (a stray continuation byte, a truncated, overlong or surrogate sequence,
// as %C0%80 or %ED%A0%80). Other bytes, including non-ASCII ones, are taken as they are. With `query` set, `+` is a space.
private fun percentDecodeSlow(value: string, query: bool = false): string? {
    val buffer = byteBuffer()
    var index = 0
    var valid = true
    while (valid && index < value.size) {
        val byte = value[index]
        if (byte == 37) {
            val high = if (index + 2 <= value.size - 1) percentHexValue(value[index + 1]) else -1
            val low = if (index + 2 <= value.size - 1) percentHexValue(value[index + 2]) else -1
            if (high < 0 || low < 0) {
                valid = false
            } else {
                buffer.appendByteValue(high * 16 + low)
                index = index + 3
            }
        } else {
            buffer.appendByteValue(if (query && byte == 43) 32 else byte)
            index = index + 1
        }
    }
    if (!valid) return null
    val decoded = buffer.toText()
    if (decoded.isValidUtf8()) decoded else null
}

// --- Run-time paths on native memory ------------------------------------------------------------------------------------
// The loops above build their results a byte at a time through a byte buffer (and the evaluator keeps them); at run time these write into one allocation, or, for a count,
// read the bytes in place. Same results, byte for byte (tests/cases/text-native).

// Returns the number of Unicode scalars in the string, or -1 if the string contains invalid UTF-8.
fun string.codePointCount(): int =
    if (ablaCompileTimeNativeHost()) codePointCountNative(this)
    else if (ablaAtCompileTime()) codePointCountSlow(this)
    else codePointCountNative(this)

// A valid string has one code point per byte that is not a continuation byte (10xxxxxx); an invalid one is -1, as the sequence walk says.
private trusted fun codePointCountNative(text: string): int {
    if (!text.isValidUtf8()) return -1
    val size = text.size
    val address = ablaUnsafeStringAddress(text)
    var count = 0
    for (at in 0 until size) {
        if ((ablaUnsafeLoadU8(nativePointerFromAddress(address + at)) & 192) != 128) count = count + 1
    }
    count
}

private fun textAsciiMapCase(text: string, from: int, to: int): string =
    if (ablaCompileTimeNativeHost()) textAsciiMapCaseNative(text, from, to)
    else if (ablaAtCompileTime()) textAsciiMapCaseSlow(text, from, to)
    else textAsciiMapCaseNative(text, from, to)

private trusted fun textAsciiMapCaseNative(text: string, from: int, to: int): string {
    val size = text.size
    val source = ablaUnsafeStringAddress(text)
    var first = 0
    while (first < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + first))
        if (byte >= from && byte < from + 26) break
        first = first + 1
    }
    if (first == size) return text.slice(0, size)
    val buffer = nativeByteBuffer(size + 1)
    val out = ablaUnsafePointerAddress(buffer.pointerAt(0))
    ablaUnsafeCopyMemory(out, source, first)
    for (i in first until size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + i))
        ablaUnsafeStoreU8(nativePointerFromAddress(out + i), if (byte >= from && byte < from + 26) byte - from + to else byte)
    }
    buffer.adoptString(size)
}

// Decodes percent escapes in `value`. With `query` enabled, unescaped plus signs become spaces. Returns null when an escape is malformed or the decoded bytes are invalid UTF-8.
fun percentDecode(value: string, query: bool = false): string? =
    if (ablaCompileTimeNativeHost()) percentDecodeNative(value, query)
    else if (ablaAtCompileTime()) percentDecodeSlow(value, query)
    else percentDecodeNative(value, query)

// Two passes over the bytes in place: the checks and the decoded size, then the bytes into one allocation. A `%` needs
// two hexadecimal digits after it; the result must be valid UTF-8 (the same answers as percentDecodeSlow).
private trusted fun percentDecodeNative(value: string, query: bool): string? {
    val size = value.size
    if (size == 0) return ""
    val source = ablaUnsafeStringAddress(value)
    var decodedSize = 0
    var at = 0
    while (at < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + at))
        if (byte == 37) {
            if (at + 2 > size - 1) return null
            if (percentHexValue(ablaUnsafeLoadU8(nativePointerFromAddress(source + at + 1))) < 0) return null
            if (percentHexValue(ablaUnsafeLoadU8(nativePointerFromAddress(source + at + 2))) < 0) return null
            at = at + 3
        } else at = at + 1
        decodedSize = decodedSize + 1
    }
    val buffer = nativeByteBuffer(decodedSize + 1)
    val out = ablaUnsafePointerAddress(buffer.pointerAt(0))
    at = 0
    var written = 0
    while (at < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + at))
        if (byte == 37) {
            val high = percentHexValue(ablaUnsafeLoadU8(nativePointerFromAddress(source + at + 1)))
            val low = percentHexValue(ablaUnsafeLoadU8(nativePointerFromAddress(source + at + 2)))
            ablaUnsafeStoreU8(nativePointerFromAddress(out + written), high * 16 + low)
            at = at + 3
        } else {
            ablaUnsafeStoreU8(nativePointerFromAddress(out + written), if (query && byte == 43) 32 else byte)
            at = at + 1
        }
        written = written + 1
    }
    val decoded = buffer.adoptString(decodedSize)
    if (decoded.isValidUtf8()) decoded else null
}

// Encodes the bytes of `value` using uppercase percent escapes, preserving ASCII letters, digits, hyphen, period, underscore, and tilde. With `query` enabled, spaces become plus signs.
fun percentEncode(value: string, query: bool = false): string =
    if (ablaCompileTimeNativeHost()) percentEncodeNative(value, query)
    else if (ablaAtCompileTime()) percentEncodeSlow(value, query)
    else percentEncodeNative(value, query)

private trusted fun percentEncodeNative(value: string, query: bool): string {
    val size = value.size
    val source = ablaUnsafeStringAddress(value)
    // Two passes: the size (three bytes for each one that is escaped), then the bytes.
    var escaped = 0
    for (i in 0 until size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + i))
        val plain = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 || byte == 95 || byte == 126 || (query && byte == 32)
        if (!plain) escaped = escaped + 1
    }
    val buffer = nativeByteBuffer(size + escaped * 2 + 1)
    val out = ablaUnsafePointerAddress(buffer.pointerAt(0))
    var at = 0
    for (i in 0 until size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + i))
        if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 || byte == 95 || byte == 126) {
            ablaUnsafeStoreU8(nativePointerFromAddress(out + at), byte)
            at = at + 1
        } else if (query && byte == 32) {
            ablaUnsafeStoreU8(nativePointerFromAddress(out + at), 43)
            at = at + 1
        } else {
            val high = byte >> 4
            val low = byte & 15
            ablaUnsafeStoreU8(nativePointerFromAddress(out + at), 37)
            ablaUnsafeStoreU8(nativePointerFromAddress(out + at + 1), if (high < 10) 48 + high else 55 + high)
            ablaUnsafeStoreU8(nativePointerFromAddress(out + at + 2), if (low < 10) 48 + low else 55 + low)
            at = at + 3
        }
    }
    buffer.adoptString(at)
}
