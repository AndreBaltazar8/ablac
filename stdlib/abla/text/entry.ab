// Phase-safe UTF-8 inspection. Abla strings remain byte-preserving; this
// module adds explicit Unicode scalar operations without forcing Unicode data
// tables into programs that only need bytes or ASCII.

class Utf8Info(
    val valid: bool,
    val codePoints: int,
    val errorOffset: int
)

noescape extern:"intrinsic" fun ablaUtf8EncodeScalar(scalar: int): string

fun utf8Encode(scalar: int): string = ablaUtf8EncodeScalar(scalar)

fun utf8Continuation(byte: int): bool = byte >= 128 && byte <= 191

fun utf8SequenceLength(lead: int): int {
    var length = 0
    if (lead >= 0 && lead <= 127) length = 1
    if (lead >= 194 && lead <= 223) length = 2
    if (lead >= 224 && lead <= 239) length = 3
    if (lead >= 240 && lead <= 244) length = 4
    length
}

fun utf8SequenceValid(text: string, offset: int, length: int): bool {
    var valid = length > 0 && offset >= 0 && offset + length <= text.size
    var index = 1
    while (valid && index < length) {
        valid = utf8Continuation(text[offset + index])
        index = index + 1
    }
    if (valid && length == 3 && text[offset] == 224) {
        valid = text[offset + 1] >= 160
    }
    if (valid && length == 3 && text[offset] == 237) {
        valid = text[offset + 1] <= 159
    }
    if (valid && length == 4 && text[offset] == 240) {
        valid = text[offset + 1] >= 144
    }
    if (valid && length == 4 && text[offset] == 244) {
        valid = text[offset + 1] <= 143
    }
    valid
}

fun utf8Info(text: string): Utf8Info {
    var valid = true
    var offset = 0
    var count = 0
    var error = -1
    while (valid && offset < text.size) {
        val length = utf8SequenceLength(text[offset])
        valid = utf8SequenceValid(text, offset, length)
        if (valid) {
            offset = offset + length
            count = count + 1
        } else {
            error = offset
        }
    }
    Utf8Info(valid, count, error)
}

fun string.isValidUtf8(): bool = utf8Info(this).valid

fun string.codePointCount(): int {
    val info = utf8Info(this)
    if (info.valid) info.codePoints else -1
}

fun utf8DecodeAt(text: string, offset: int): int {
    var scalar = -1
    if (offset >= 0 && offset < text.size) {
        val lead = text[offset]
        val length = utf8SequenceLength(lead)
        if (utf8SequenceValid(text, offset, length)) {
            if (length == 1) scalar = lead
            if (length == 2) {
                scalar = (lead - 192) * 64 + text[offset + 1] - 128
            }
            if (length == 3) {
                scalar = (lead - 224) * 4096 +
                    (text[offset + 1] - 128) * 64 +
                    text[offset + 2] - 128
            }
            if (length == 4) {
                scalar = (lead - 240) * 262144 +
                    (text[offset + 1] - 128) * 4096 +
                    (text[offset + 2] - 128) * 64 +
                    text[offset + 3] - 128
            }
        }
    }
    scalar
}

fun string.codePointAt(position: int): int {
    var scalar = -1
    var offset = 0
    var current = 0
    var valid = position >= 0
    while (valid && offset < this.size && current <= position) {
        val length = utf8SequenceLength(this[offset])
        valid = utf8SequenceValid(this, offset, length)
        if (valid && current == position) scalar = utf8DecodeAt(this, offset)
        if (valid) {
            offset = offset + length
            current = current + 1
        }
    }
    scalar
}

fun utf8ByteOffset(text: string, position: int): int {
    var result = -1
    var offset = 0
    var current = 0
    var valid = position >= 0
    while (valid && current < position && offset < text.size) {
        val length = utf8SequenceLength(text[offset])
        valid = utf8SequenceValid(text, offset, length)
        if (valid) {
            offset = offset + length
            current = current + 1
        }
    }
    if (valid && current == position) result = offset
    result
}

fun string.codePointSlice(begin: int, end: int): string {
    val beginOffset = utf8ByteOffset(this, begin)
    val endOffset = utf8ByteOffset(this, end)
    if (beginOffset >= 0 && endOffset >= beginOffset) {
        this.slice(beginOffset, endOffset)
    } else ""
}
