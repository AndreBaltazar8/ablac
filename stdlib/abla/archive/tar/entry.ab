// Read-only, bounded POSIX ustar. File data remains in the retained input.
import "abla/text"
import "abla/bytes"

class TarLimits(
    val maxArchiveBytes: int,
    val maxEntries: int,
    val maxFileBytes: int,
    val maxTotalFileBytes: int
)
class TarEntry(val path: string, val kind: string, val mode: int, val offset: int, val size: int,
    val rawPath: string = "")
class TarReadResult(val input: string, val entries: array<TarEntry>, val error: string)

private fun tarError(error: string): TarReadResult = TarReadResult("", [], error)

// -1 indicates invalid octal, overflow, or non-padding characters.
private fun tarOctal(input: string, start: int, width: int): int {
    var result = 0
    var i = start
    val end = start + width
    while (i < end && (input[i] == 0 || input[i] == 32)) i += 1
    var seen = false
    while (i < end && input[i] >= 48 && input[i] <= 55) {
        val digit = input[i] - 48
        if (result > (9223372036854775807 - digit) / 8) return -1
        result = result * 8 + digit
        seen = true
        i += 1
    }
    while (i < end) {
        if (input[i] != 0 && input[i] != 32) return -1
        i += 1
    }
    if (seen) result else 0
}

private fun tarField(input: string, start: int, width: int): string {
    var end = start
    while (end < start + width && input[end] != 0) end += 1
    input.slice(start, end)
}

// Empty or dot components collapse; absolute paths and every parent component are refused.
private fun tarPath(path: string): string {
    if (path.size == 0 || path[0] == 47) return ""
    val parts: array<string> = []
    for (part in path.split("/")) {
        if (part == "..") return ""
        if (part != "" && part != ".") parts.append(part)
    }
    if (parts.size == 0) "." else parts.join("/")
}

fun tarRead(input: string, limits: TarLimits): TarReadResult {
    if (limits.maxArchiveBytes < 0 || limits.maxEntries < 0 || limits.maxFileBytes < 0 ||
        limits.maxTotalFileBytes < 0) return tarError("invalid")
    if (input.size > limits.maxArchiveBytes) return tarError("limit")
    val entries: array<TarEntry> = []
    var total = 0
    var pos = 0
    while (true) {
        if (pos > input.size - 512) return tarError("invalid")
        var zero = true
        var i = 0
        while (i < 512) { if (input[pos + i] != 0) zero = false; i += 1 }
        if (zero) {
            if (pos > input.size - 1024) return tarError("invalid")
            i = pos + 512
            while (i < input.size) { if (input[i] != 0) return tarError("invalid"); i += 1 }
            if (input.size % 512 != 0) return tarError("invalid")
            return TarReadResult(input, entries, "")
        }
        val expected = tarOctal(input, pos + 148, 8)
        if (expected < 0) return tarError("invalid")
        var sum = 0
        i = 0
        while (i < 512) {
            sum += if (i >= 148 && i < 156) 32 else input[pos + i]
            i += 1
        }
        if (sum != expected) return tarError("invalid")
        if (input.slice(pos + 257, pos + 263) != "ustar\0" ||
            input.slice(pos + 263, pos + 265) != "00") return tarError("unsupported")
        val mode = tarOctal(input, pos + 100, 8)
        val uid = tarOctal(input, pos + 108, 8)
        val gid = tarOctal(input, pos + 116, 8)
        val size = tarOctal(input, pos + 124, 12)
        val modified = tarOctal(input, pos + 136, 12)
        if (mode < 0 || uid < 0 || gid < 0 || size < 0 || modified < 0) return tarError("invalid")
        val type = input[pos + 156]
        if (type != 0 && type != 48 && type != 53) return tarError("unsupported")
        val kind = if (type == 53) "directory" else "file"
        if (kind == "directory" && size != 0) return tarError("invalid")
        val name = tarField(input, pos, 100)
        val prefix = tarField(input, pos + 345, 155)
        val rawPath = if (prefix == "") name else "$prefix/$name"
        val path = tarPath(rawPath)
        if (path == "" || (path == "." && kind != "directory")) return tarError("invalid")
        for (entry in entries) {
            if (entry.path == path ||
                (entry.kind == "file" && path.startsWith("${entry.path}/")) ||
                (kind == "file" && entry.path.startsWith("$path/"))) return tarError("invalid")
        }
        if (entries.size >= limits.maxEntries || size > limits.maxFileBytes ||
            size > limits.maxTotalFileBytes - total) return tarError("limit")
        pos += 512
        if (size > input.size - pos) return tarError("invalid")
        val padding = (512 - size % 512) % 512
        if (padding > input.size - pos - size) return tarError("invalid")
        i = pos + size
        while (i < pos + size + padding) { if (input[i] != 0) return tarError("invalid"); i += 1 }
        entries.append(TarEntry(path, kind, mode, pos, size, rawPath))
        total += size
        pos += size + padding
    }
}

// The caller owns the source and passes the same source to every operation.
// A source must return no more than maxBytes, and either data, EOF or an error.
class TarInputChunk(val data: string, val eof: bool, val error: string = "")
resource interface TarSource {
    fun readChunk(maxBytes: int): TarInputChunk
}
class TarStreamNext(val entry: TarEntry, val done: bool, val error: string)
class TarStreamData(val data: string, val done: bool, val error: string)

class TarStream(
    val limits: TarLimits,
    val entries: array<TarEntry> = [],
    var archiveBytes: int = 0,
    var totalFileBytes: int = 0,
    var remaining: int = 0,
    var padding: int = 0,
    var sourceEof: bool = false,
    var finished: bool = false,
    var error: string = ""
)

fun tarStream(limits: TarLimits): TarStream {
    val stream = TarStream(limits)
    if (limits.maxArchiveBytes < 0 || limits.maxEntries < 0 || limits.maxFileBytes < 0 ||
        limits.maxTotalFileBytes < 0) stream.error = "invalid"
    stream
}

// At most request bytes are retained. Ask for one extra at the limit so a
// genuine EOF is distinguishable from input exceeding maxArchiveBytes.
private fun TarStream.pull(var source: TarSource, request: int): TarInputChunk {
    if (this.sourceEof) return TarInputChunk("", true)
    val budget = this.limits.maxArchiveBytes - this.archiveBytes
    val wanted = if (budget == 0) 1 else if (request < budget) request else budget
    val chunk = source.readChunk(wanted)
    if (chunk.error != "") { this.error = chunk.error; return TarInputChunk("", false) }
    if (chunk.data.size > wanted || (chunk.data.size == 0 && !chunk.eof)) {
        this.error = "source"
        return TarInputChunk("", false)
    }
    if (chunk.data.size > budget) { this.error = "limit"; return TarInputChunk("", false) }
    this.archiveBytes += chunk.data.size
    this.sourceEof = chunk.eof
    chunk
}

private fun TarStream.block(var source: TarSource, size: int): string {
    val buffer = byteBuffer()
    while (buffer.size() < size && this.error == "") {
        val part = this.pull(source, size - buffer.size())
        buffer.appendText(part.data)
        if (part.eof && buffer.size() < size) this.error = "invalid"
    }
    buffer.toText()
}

private fun tarStreamNone(): TarEntry = TarEntry("", "", 0, 0, 0)
private fun TarStream.nextError(): TarStreamNext = TarStreamNext(tarStreamNone(), false, this.error)

// File bytes are provisional until next() reaches verified EOF. The current
// file must be completely read before next(); its padding is checked there.
fun TarStream.next(var source: TarSource): TarStreamNext {
    if (this.error != "") return this.nextError()
    if (this.finished) return TarStreamNext(tarStreamNone(), true, "")
    if (this.remaining != 0) { this.error = "invalid"; return this.nextError() }
    if (this.padding > 0) {
        val pad = this.block(source, this.padding)
        if (this.error != "") return this.nextError()
        for (byte in pad) if (byte != 0) { this.error = "invalid"; return this.nextError() }
        this.padding = 0
    }
    val header = this.block(source, 512)
    if (this.error != "") return this.nextError()
    var zero = true
    for (byte in header) if (byte != 0) zero = false
    if (zero) {
        val second = this.block(source, 512)
        if (this.error != "") return this.nextError()
        for (byte in second) if (byte != 0) { this.error = "invalid"; return this.nextError() }
        while (!this.sourceEof && this.error == "") {
            val tail = this.pull(source, 65536)
            for (byte in tail.data) if (byte != 0) { this.error =
                    "invalid"; return this.nextError() }
        }
        if (this.error != "") return this.nextError()
        if (this.archiveBytes % 512 != 0) { this.error = "invalid"; return this.nextError() }
        this.finished = true
        return TarStreamNext(tarStreamNone(), true, "")
    }
    val expected = tarOctal(header, 148, 8)
    var sum = 0
    var i = 0
    while (i < 512) { sum += if (i >= 148 && i < 156) 32 else header[i]; i += 1 }
    if (expected < 0 || sum != expected) { this.error = "invalid"; return this.nextError() }
    if (header.slice(257, 263) != "ustar\0" || header.slice(263, 265) != "00") {
        this.error = "unsupported"; return this.nextError()
    }
    val mode = tarOctal(header, 100, 8)
    val uid = tarOctal(header, 108, 8)
    val gid = tarOctal(header, 116, 8)
    val size = tarOctal(header, 124, 12)
    val modified = tarOctal(header, 136, 12)
    if (mode < 0 || uid < 0 || gid < 0 || size < 0 || modified < 0) {
        this.error = "invalid"; return this.nextError()
    }
    val type = header[156]
    if (type != 0 && type != 48 && type != 53) { this.error =
            "unsupported"; return this.nextError() }
    val kind = if (type == 53) "directory" else "file"
    if (kind == "directory" && size != 0) { this.error = "invalid"; return this.nextError() }
    val name = tarField(header, 0, 100)
    val prefix = tarField(header, 345, 155)
    val rawPath = if (prefix == "") name else "$prefix/$name"
    val path = tarPath(rawPath)
    if (path == "" || (path == "." && kind != "directory")) {
        this.error = "invalid"; return this.nextError()
    }
    for (entry in this.entries) {
        if (entry.path == path || (entry.kind == "file" && path.startsWith("${entry.path}/")) ||
            (kind == "file" && entry.path.startsWith("$path/"))) {
            this.error = "invalid"; return this.nextError()
        }
    }
    if (this.entries.size >= this.limits.maxEntries || size > this.limits.maxFileBytes ||
        size > this.limits.maxTotalFileBytes - this.totalFileBytes) {
        this.error = "limit"; return this.nextError()
    }
    val entry = TarEntry(path, kind, mode, 0, size, rawPath)
    this.entries.append(entry)
    this.totalFileBytes += size
    this.remaining = size
    this.padding = (512 - size % 512) % 512
    TarStreamNext(entry, false, "")
}

// Each returned string is at most min(maxBytes, 65536). Empty files are done
// immediately. An error invalidates all earlier entries and file bytes.
fun TarStream.readData(var source: TarSource, maxBytes: int): TarStreamData {
    if (this.error != "") return TarStreamData("", false, this.error)
    if (maxBytes <= 0 || this.finished) {
        this.error = "invalid"; return TarStreamData("", false, this.error)
    }
    if (this.remaining == 0) return TarStreamData("", true, "")
    var wanted = if (maxBytes < 65536) maxBytes else 65536
    if (wanted > this.remaining) wanted = this.remaining
    val chunk = this.pull(source, wanted)
    if (this.error != "") return TarStreamData("", false, this.error)
    this.remaining -= chunk.data.size
    if (chunk.eof && this.remaining > 0) {
        this.error = "invalid"; return TarStreamData("", false, this.error)
    }
    TarStreamData(chunk.data, this.remaining == 0, "")
}
