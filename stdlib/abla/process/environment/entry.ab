import "abla/sys/linux/process"

/** Environment variable `name`, or null when it is not set. */
fun processEnvironment(name: string): string? {
    val variable = linuxEnvironment(name)
    if (variable.found) variable.value else null
}

/** Environment variable `name`, or `fallback` when it is not set. */
fun processEnvironmentOr(name: string, fallback: string): string {
    val variable = linuxEnvironment(name)
    if (variable.found) variable.value else fallback
}
