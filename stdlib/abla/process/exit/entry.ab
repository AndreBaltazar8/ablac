// Ending the process from anywhere in a program: exit(code) with a status,
// panic(message) with the message on standard error first. Tools use them for
// failures deep inside a call chain instead of threading a status back to
// main.

import "abla/sys/linux"

/** Ends the process now, with `code` as its exit status. */
fun exit(code: int): never {
    // exit_group: every thread, not only the calling one.
    while (true) linuxSyscall1(231, code)
}

// Prints the stack to standard error in a debug build of a hosted program
// (the compiler gives it that body); does nothing elsewhere.
fun __ablaDebugPrintStack(): void {}

/**
 * Writes "panic: <message>" to standard error (and, in a debug build, the
 * stack) and exits with status 101.
 */
fun panic(message: string): never {
    linuxWriteStandardError("panic: $message\n")
    __ablaDebugPrintStack()
    exit(101)
}
