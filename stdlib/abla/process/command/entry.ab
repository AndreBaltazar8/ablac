import "abla/sys/linux/process"

class Command(val native: LinuxCommand)

class ChildProcess(val native: LinuxChildProcess)

fun command(executable: string): Command =
    Command(linuxCommand(executable))

fun Command.argument(value: string): Command {
    this.native.argument(value)
    this
}

/** `name` set to `value` for the command; the rest of the environment carries over. */
fun Command.environment(name: string, value: string): Command {
    this.native.environment(name, value)
    this
}

/** `name` taken out of what the command inherits from this process. */
fun Command.removeEnvironment(name: string): Command {
    this.native.removeEnvironment(name)
    this
}

/** Runs the command in this directory. */
fun Command.directory(path: string): Command {
    this.native.directory(path)
    this
}

/** Standard input read from this file. */
fun Command.input(path: string): Command {
    this.native.input(path)
    this
}

/** Standard output written to this file. "/dev/null" discards it. */
fun Command.output(path: string): Command {
    this.native.output(path)
    this
}

/** Standard error written to this file. "/dev/null" discards it. */
fun Command.errors(path: string): Command {
    this.native.errors(path)
    this
}

fun Command.run(): int = this.native.run()

/** Runs the command to its end, with its standard output and exit status. */
fun Command.capture(): LinuxProcessResult = this.native.capture()

/** Replaces this process with the command. Only returns, with 127, if that fails. */
fun Command.execute(): int = this.native.execute()

fun Command.captureText(): string = this.native.captureText()

fun Command.start(): ChildProcess = ChildProcess(this.native.start())

fun ChildProcess.stop(graceMilliseconds: int = 5000): int =
    this.native.stop(graceMilliseconds)

class Pipeline(val stages: array<LinuxCommand>)
class RunningPipeline(val native: LinuxRunningPipeline)

fun Command.pipe(next: Command): Pipeline = Pipeline([this.native.snapshot(),
    next.native.snapshot()])

fun Pipeline.pipe(next: Command): Pipeline {
    val stages: array<LinuxCommand> = []
    for (stage in this.stages) stages.append(stage.snapshot())
    stages.append(next.native.snapshot())
    Pipeline(stages)
}

fun Pipeline.run(): LinuxPipelineResult = linuxPipelineStart(this.stages, false, false,
    false).wait()
fun Pipeline.capture(): LinuxPipelineResult = linuxPipelineStart(this.stages, false, true,
    false).wait()
fun Pipeline.captureBoth(): LinuxPipelineResult = linuxPipelineStart(this.stages, false, true,
    true).wait()
fun Pipeline.start(): RunningPipeline = RunningPipeline(linuxPipelineStart(this.stages, true, false,
    false))
fun RunningPipeline.wait(): LinuxPipelineResult = this.native.wait()
fun RunningPipeline.stop(graceMilliseconds: int = 5000): LinuxPipelineResult =
    this.native.stop(graceMilliseconds)
fun Command.captureBoth(): LinuxPipelineResult = linuxPipelineStart([this.native.snapshot()], false,
    true, true).wait()
