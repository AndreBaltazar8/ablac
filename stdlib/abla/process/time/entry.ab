import "abla/date"
import "abla/sys/linux/process"

// Sleeps for `milliseconds`, resuming after interruption. Invalid durations and sleep failures are ignored.
fun sleep(milliseconds: int): void = linuxSleep(milliseconds)

// Sleeps for `nanoseconds`, resuming after interruption. Returns false for a negative duration or a system error.
fun sleepNanoseconds(nanoseconds: int): bool =
    linuxSleepNanoseconds(nanoseconds)

// Reads the monotonic clock in nanoseconds. Use differences to measure elapsed time. Returns 0 on clock failure.
fun monotonicNanoseconds(): int = linuxMonotonicNanoseconds()

// Reads the monotonic clock in whole milliseconds. Returns 0 on clock failure.
fun monotonicMilliseconds(): int = linuxMonotonicMilliseconds()

// Wall-clock time since 1970-01-01T00:00:00Z. Unlike the monotonic clock it
// can jump when the system clock is set.
fun realtimeNanoseconds(): int = linuxRealtimeNanoseconds()

// Returns wall-clock milliseconds since the Unix epoch, or 0 if the clock read fails.
fun realtimeMilliseconds(): int = linuxRealtimeNanoseconds() / 1000000

// The current UTC date and time (see abla/date).
fun utcNow(): UtcDate = utcDate(realtimeMilliseconds())

// A monotonic clock and sleep helper with reusable native buffers. Create it with monotonicClock.
resource class MonotonicClock(var linux: LinuxMonotonicClock) {
    // Returns true while the clock's native buffers are open and large enough.
    fun valid(): bool = this.linux.valid()
    // Reads the monotonic clock in nanoseconds. Returns 0 if the timestamp buffer is unusable or the clock read fails.
    fun nanoseconds(): int = this.linux.nanoseconds()
    // Reads the monotonic clock in whole milliseconds. Returns 0 on clock failure.
    fun milliseconds(): int = this.nanoseconds() / 1000000
    // Sleeps for `nanoseconds` using the clock's reusable buffers. Returns false for a negative duration, unusable buffers, or a system error.
    fun sleepNanoseconds(nanoseconds: int): bool =
        this.linux.sleepNanoseconds(nanoseconds)

    // Closes the clock's native buffers.
    fun drop(): void {
        this.linux.drop()
        return
    }
}

// Creates a clock with reusable buffers for timestamp reads and sleeps.
fun monotonicClock(): MonotonicClock {
    val clock = linuxMonotonicClock()
    MonotonicClock(move(clock))
}
