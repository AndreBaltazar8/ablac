import "abla/date"
import "abla/sys/linux/process"

fun sleep(milliseconds: int): void = linuxSleep(milliseconds)

fun sleepNanoseconds(nanoseconds: int): bool =
    linuxSleepNanoseconds(nanoseconds)

fun monotonicNanoseconds(): int = linuxMonotonicNanoseconds()

fun monotonicMilliseconds(): int = linuxMonotonicMilliseconds()

// Wall-clock time since 1970-01-01T00:00:00Z. Unlike the monotonic clock it
// can jump when the system clock is set.
fun realtimeNanoseconds(): int = linuxRealtimeNanoseconds()

fun realtimeMilliseconds(): int = linuxRealtimeNanoseconds() / 1000000

// The current UTC date and time (see abla/date).
fun utcNow(): UtcDate = utcDate(realtimeMilliseconds())

resource class MonotonicClock(var linux: LinuxMonotonicClock) {
    fun valid(): bool = this.linux.valid()
    fun nanoseconds(): int = this.linux.nanoseconds()
    fun milliseconds(): int = this.nanoseconds() / 1000000
    fun sleepNanoseconds(nanoseconds: int): bool =
        this.linux.sleepNanoseconds(nanoseconds)

    fun drop(): void {
        this.linux.drop()
        return
    }
}

fun monotonicClock(): MonotonicClock {
    val clock = linuxMonotonicClock()
    MonotonicClock(move(clock))
}
