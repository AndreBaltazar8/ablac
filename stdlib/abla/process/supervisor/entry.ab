// Hosted, process-isolated execution for build tools and test runners. Child
// processes inherit the current environment before explicit entries override
// it. Output can be inherited or redirected to one combined stdout/stderr log.

import "abla/sys/linux/fs"
import "abla/sys/linux/process"

class SupervisedProcess(val identifier: int)

fun startSupervisedProcess(
    directory: string,
    arguments: array<string>,
    environmentNames: array<string> = [],
    environmentValues: array<string> = [],
    outputPath: string = ""
): SupervisedProcess = SupervisedProcess(linuxStartConfiguredProcess(
    directory,
    arguments,
    environmentNames,
    environmentValues,
    outputPath
).process)

// Returns -1 while the child is running, otherwise its conventional process
// exit status (including 128 + signal for signalled children).
fun SupervisedProcess.poll(): int = LinuxChildProcess(this.identifier).poll()

fun SupervisedProcess.stop(graceMilliseconds: int = 100): int =
    LinuxChildProcess(this.identifier).stopTree(graceMilliseconds)

fun processMonotonicMilliseconds(): int = linuxMonotonicMilliseconds()

fun processProcessorCount(): int {
    val online = path("/sys/devices/system/cpu/online").readText()
    var count = 0
    var begin = 0
    while (begin < online.size) {
        var first = 0
        var hasFirst = false
        while (begin < online.size && online[begin] >= 48 &&
            online[begin] <= 57) {
            first = first * 10 + online[begin] - 48
            hasFirst = true
            begin = begin + 1
        }
        var last = first
        if (begin < online.size && online[begin] == 45) {
            begin = begin + 1
            last = 0
            while (begin < online.size && online[begin] >= 48 &&
                online[begin] <= 57) {
                last = last * 10 + online[begin] - 48
                begin = begin + 1
            }
        }
        if (hasFirst && last >= first) count = count + last - first + 1
        while (begin < online.size && online[begin] != 44) begin = begin + 1
        if (begin < online.size) begin = begin + 1
    }
    if (count > 0) count else 1
}
