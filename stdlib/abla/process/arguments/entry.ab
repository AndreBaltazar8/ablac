import "abla/sys/linux/process"

/** Number of user arguments (argv[0], the executable, is not counted). */
fun processArgumentCount(): int = linuxArgumentCount()

/** User argument `index`, zero-based: processArgument(0) is argv[1]. */
fun processArgument(index: int): string = linuxArgument(index)

/** The executable path as invoked (argv[0]), e.g. to re-exec the program. */
fun processExecutable(): string = linuxArgument(-1)
