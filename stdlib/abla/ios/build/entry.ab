import "abla/build"

// Register once per build graph; the returned name is a buildProgram target.
compile fun iosDeviceTarget(): string {
    val target = defineTarget(
        "ios-arm64", "arm64-apple-ios17.0", "macho", "apple-static", "",
        false, false
    )
    val sdk = if (target) defineTargetSdk("ios-arm64", "iphoneos") else false
    if (target && sdk) "ios-arm64" else ""
}

compile fun iosSimulatorTarget(): string {
    val target = defineTarget(
        "ios-arm64-simulator", "arm64-apple-ios17.0-simulator", "macho",
        "apple-static", "", false, false
    )
    val sdk = if (target) defineTargetSdk(
        "ios-arm64-simulator", "iphonesimulator"
    ) else false
    if (target && sdk) "ios-arm64-simulator" else ""
}
