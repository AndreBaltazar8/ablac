// The offline companion installer validates pinned archive bytes before any write.
import "abla/archive/tar"
import "abla/bytes"
import "abla/compression/gzip"
import "abla/crypto"
import "abla/fs/secure"
import "abla/json"
import "abla/text"
import "abla/sys/linux/random"
import "abla/sys/linux/process"

class CompanionPins(
    val version: string,
    val platform: string,
    val llvmVersion: string,
    val sourceCommit: string,
    val sourceArchiveSha256: string,
    val archiveSha256: string,
    val manifestSha256: string
)
class CompanionArchiveResult(val archive: TarReadResult, val manifest: Json, val error: string)

private fun companionError(message: string): CompanionArchiveResult =
    CompanionArchiveResult(TarReadResult("", [], "invalid"), jsonNull(), message)

private fun companionRawPathValid(raw: string): bool {
    if (raw == "" || raw.startsWith("/")) return false
    val name = if (raw.endsWith("/")) raw.slice(0, raw.size - 1) else raw
    if (name == "") return false
    for (part in name.split("/")) if (part == "" || part == "." || part == "..") return false
    true
}

// Archive and manifest pins must already come from the validated catalog.
fun companionValidateArchive(compressed: string, pins: CompanionPins): CompanionArchiveResult {
    if (!companionPinsValid(pins)) return companionError("pins")
    if (compressed.size > 134217728) return companionError("archive_limit")
    if (hexEncode(sha256(compressed)) != pins.archiveSha256) return companionError("archive_hash")
    val decoded = gzipDecompress(compressed, 268435456)
    if (decoded.error != "") return companionError("gzip_${decoded.error}")
    val archive = tarRead(decoded.data, TarLimits(268435456, 1024, 268435456, 268435456))
    if (archive.error != "") return companionError("tar_${archive.error}")
    val root = "abla-xtensa-llvm-${pins.version}-${pins.platform}"
    var manifestIndex = -1
    var i = 0
    while (i < archive.entries.size) {
        val entry = archive.entries[i]
        if (!companionRawPathValid(entry.rawPath) ||
            (entry.path != root &&
                !entry.path.startsWith("$root/"))) return companionError("archive_path")
        if (entry.path == root && entry.kind != "directory") return companionError("archive_root")
        if (entry.path == "$root/manifest.json" && entry.kind == "file") manifestIndex = i
        i += 1
    }
    if (manifestIndex < 0) return companionError("manifest_missing")
    val manifestEntry = archive.entries[manifestIndex]
    if (manifestEntry.size <= 0 || manifestEntry.size >
        65536) return companionError("manifest_limit")
    val raw = archive.input.slice(manifestEntry.offset, manifestEntry.offset + manifestEntry.size)
    if (hexEncode(sha256(raw)) != pins.manifestSha256) return companionError("manifest_hash")
    val parsed = jsonParse(raw, JsonLimits(65536, 32, 10000, 65536, 2048, true))
    if (!parsed.succeeded || !parsed.value.isObject()) return companionError("manifest_json")
    val manifest = parsed.value
    if (manifest.getInt("schema") != 1 || manifest.getString("version") !=
        "abla-xtensa-llvm-${pins.version}" ||
        manifest.getString("platform") != pins.platform || manifest.getString("llvmVersion") !=
        pins.llvmVersion ||
        manifest.getString("sourceCommit") != pins.sourceCommit ||
        manifest.getString("sourceArchiveSha256") !=
        pins.sourceArchiveSha256) return companionError("manifest_identity")
    val files = manifest.get("files")
    if (!files.isObject() || !files.has("bin/opt") ||
        !files.has("bin/llc")) return companionError("manifest_files")
    var hasLibrary = false
    for (key in files.keys) if (key.startsWith("lib/libLLVM")) hasLibrary = true
    if (!hasLibrary) return companionError("manifest_files")
    var count = 0
    for (entry in archive.entries) {
        if (entry.kind == "file" && entry.path != "$root/manifest.json") {
            val name = entry.path.slice(root.size + 1, entry.path.size)
            if (!files.has(name) || !files.get(name).isString()) return companionError("file_set")
            val hash = files.getString(name)
            if (hash.size != 64 || hexEncode(sha256(archive.input.slice(entry.offset,
                entry.offset + entry.size))) != hash)
                return companionError("file_hash")
            if ((name == "bin/opt" || name == "bin/llc") && (entry.mode & 0o111) ==
                0) return companionError("file_mode")
            count += 1
        }
    }
    if (count != files.size()) return companionError("file_set")
    CompanionArchiveResult(archive, manifest, "")
}

class CompanionVerifyResult(val error: string)
private class CompanionWalkState(var entries: int, var bytes: int, var files: int)

// The directory handle is the verification authority; never reopen a path.
private fun companionWalk(
    directory: SecureDirectory, prefix: string, files: Json, var state: CompanionWalkState,
    depth: int
): string {
    if (depth > 64) return "tree_depth"
    val listing = directory.list(1024, 255)
    if (listing.error != "") return "directory_${listing.error}"
    for (name in listing.names) {
        state.entries += 1
        if (state.entries > 1024) return "tree_limit"
        val relative = if (prefix == "") name else "$prefix/$name"
        val kind = directory.entryKind(name)
        if (kind == "directory") {
            val child = directory.openDirectory(name)
            if (child.descriptor < 0) return "directory_open"
            val error = companionWalk(child, relative, files, state, depth + 1)
            if (error != "") return error
        } else if (kind == "file") {
            val opened = directory.openRegularFile(name)
            if (opened.descriptor < 0) return "file_open"
            if (relative == "manifest.json") continue
            if (!files.has(relative) || !files.get(relative).isString()) return "file_set"
            val hash = sha256Stream()
            while (true) {
                val read = opened.readChunk(65536)
                if (read.error != "") return "file_${read.error}"
                if (read.data.size > 1073741824 - state.bytes) return "file_limit"
                state.bytes += read.data.size
                hash.update(read.data)
                if (read.eof) break
            }
            if (hexEncode(hash.finish()) != files.getString(relative)) return "file_hash"
            val permissions = opened.permissions()
            if (permissions < 0 || ((relative == "bin/opt" || relative == "bin/llc") &&
                (permissions & 0o111) == 0)) return "file_mode"
            state.files += 1
        } else return "tree_type"
    }
    ""
}

private fun companionVerifyTree(directory: SecureDirectory,
    pins: CompanionPins): CompanionVerifyResult {
    if (!companionPinsValid(pins)) return CompanionVerifyResult("pins")
    if (directory.descriptor < 0) return CompanionVerifyResult("directory_open")
    val manifestFile = directory.openRegularFile("manifest.json")
    if (manifestFile.descriptor < 0) return CompanionVerifyResult("manifest_missing")
    val read = manifestFile.read(65536)
    if (read.error != "" || read.data.size == 0) return CompanionVerifyResult("manifest_limit")
    if (hexEncode(sha256(read.data)) !=
        pins.manifestSha256) return CompanionVerifyResult("manifest_hash")
    val parsed = jsonParse(read.data, JsonLimits(65536, 32, 10000, 65536, 2048, true))
    if (!parsed.succeeded || !parsed.value.isObject()) return CompanionVerifyResult("manifest_json")
    val manifest = parsed.value
    if (manifest.getInt("schema") != 1 || manifest.getString("version") !=
        "abla-xtensa-llvm-${pins.version}" ||
        manifest.getString("platform") != pins.platform || manifest.getString("llvmVersion") !=
        pins.llvmVersion ||
        manifest.getString("sourceCommit") != pins.sourceCommit ||
        manifest.getString("sourceArchiveSha256") !=
        pins.sourceArchiveSha256) return CompanionVerifyResult("manifest_identity")
    val files = manifest.get("files")
    if (!files.isObject() || !files.has("bin/opt") ||
        !files.has("bin/llc")) return CompanionVerifyResult("manifest_files")
    var library = false
    for (key in files.keys) if (key.startsWith("lib/libLLVM")) library = true
    if (!library) return CompanionVerifyResult("manifest_files")
    val state = CompanionWalkState(0, read.data.size, 0)
    val error = companionWalk(directory, "", files, state, 0)
    if (error != "") return CompanionVerifyResult(error)
    if (state.files != files.size()) return CompanionVerifyResult("file_set")
    CompanionVerifyResult("")
}

// 0700 is the marker for a publish that has not reached its final chmod.
// A crashed publisher is never repaired or removed by verification.
fun verifyCompanion(directory: SecureDirectory, pins: CompanionPins): CompanionVerifyResult {
    if (!companionPinsValid(pins)) return CompanionVerifyResult("pins")
    if (directory.descriptor < 0) return CompanionVerifyResult("directory_open")
    var mode = directory.permissions()
    var waits = 0
    while (mode == 0o700 && waits < 50) {
        linuxSleep(20)
        mode = directory.permissions()
        waits += 1
    }
    if (mode ==
        0o700) return CompanionVerifyResult("publication_in_progress: directory ${pins.version}; ensure no installer is running, remove this directory, and rerun")
    if (mode != 0o555) return CompanionVerifyResult("directory_mode")
    companionVerifyTree(directory, pins)
}

class CompanionExtractResult(val error: string, val existing: bool, val leftoverStage: string = "",
    val operation: string = "", val errorNumber: int = 0, val leftoverSpool: string = "",
    val cause: string = "")
private class CompanionStage(val files: array<string>, val dirs: array<string>)

private fun companionDigits(value: string): bool {
    if (value == "") return false
    for (byte in value) if (byte < 48 || byte > 57) return false
    true
}
private fun companionHex(value: string, length: int): bool {
    if (value.size != length) return false
    for (byte in value) if (!((byte >= 48 && byte <= 57) || (byte >= 97 && byte <=
        102))) return false
    true
}
private fun companionRevisionValid(version: string): bool {
    if (version.size > 64) return false
    val halves = version.split("-")
    if (halves.size != 2 || !companionDigits(halves[1]) || halves[1][0] == 48) return false
    val numbers = halves[0].split(".")
    if (numbers.size != 3) return false
    for (number in numbers) if (!companionDigits(number)) return false
    true
}
private fun companionPlatformValid(platform: string): bool = platform == "x86_64-linux" ||
    platform == "x86_64-macos" || platform == "arm64-macos"
private fun companionPinsValid(pins: CompanionPins): bool {
    if (!companionRevisionValid(pins.version) ||
        !companionPlatformValid(pins.platform)) return false
    val halves = pins.version.split("-")
    pins.llvmVersion == halves[0] && companionHex(pins.sourceCommit, 40) &&
        companionHex(pins.sourceArchiveSha256, 64) && companionHex(pins.archiveSha256, 64) &&
        companionHex(pins.manifestSha256, 64)
}

// Walks one checked component at a time, creating missing directories in the
// private stage and recording every creation for rollback.
private fun companionStageEntry(
    parent: SecureDirectory, parts: array<string>, index: int, prefix: string,
    entry: TarEntry, contents: string, var stage: CompanionStage
): bool {
    val name = parts[index]
    val path = if (prefix == "") name else "$prefix/$name"
    if (index + 1 < parts.size || entry.kind == "directory") {
        if (parent.createDirectory(name, 0o700)) stage.dirs.append(path)
        val child = parent.openDirectory(name)
        if (child.descriptor < 0 || !child.setPermissions(0o700)) return false
        if (index + 1 == parts.size) return true
        return companionStageEntry(child, parts, index + 1, path, entry, contents, stage)
    }
    val file = parent.createFile(name, 0o600)
    if (file.descriptor < 0) return false
    stage.files.append(path)
    if (!file.write(contents) || !file.sync()) return false
    if (!file.setPermissions(if ((entry.mode & 0o111) != 0) 0o555 else 0o444)) return false
    file.close()
}

private fun companionStageMode(parent: SecureDirectory, parts: array<string>, index: int,
    mode: int): bool {
    val child = parent.openDirectory(parts[index])
    if (child.descriptor < 0) return false
    if (index + 1 == parts.size) return child.setPermissions(mode)
    companionStageMode(child, parts, index + 1, mode)
}
private fun companionStageModeChecked(parent: SecureDirectory, parts: array<string>, index: int,
    mode: int): string {
    val child = parent.openDirectory(parts[index])
    if (child.descriptor < 0) return "stage_mode"
    if (index + 1 == parts.size) {
        val status = child.setPermissionsChecked(mode)
        return if (status == "disk_full") "disk_full" else if (status != "") "stage_mode" else ""
    }
    companionStageModeChecked(child, parts, index + 1, mode)
}
private fun companionStageRemove(
    parent: SecureDirectory, parts: array<string>, index: int, directory: bool
): bool {
    if (index + 1 == parts.size) return parent.remove(parts[index], directory)
    val child = parent.openDirectory(parts[index])
    if (child.descriptor < 0) return false
    companionStageRemove(child, parts, index + 1, directory)
}
private fun companionStageCleanup(parent: SecureDirectory, stageName: string,
    var stage: CompanionStage): bool {
    val root = parent.openDirectory(stageName)
    if (root.descriptor < 0) return false
    var ok = root.setPermissions(0o700)
    for (path in stage.dirs) if (!companionStageMode(root, path.split("/"), 0, 0o700)) ok = false
    var i = stage.files.size
    while (i > 0) {
        i -= 1
        if (!companionStageRemove(root, stage.files[i].split("/"), 0, false)) ok = false
    }
    i = stage.dirs.size
    while (i > 0) {
        i -= 1
        if (!companionStageRemove(root, stage.dirs[i].split("/"), 0, true)) ok = false
    }
    if (!root.close()) ok = false
    if (!parent.remove(stageName, true)) ok = false
    ok
}

// Offline only; `parent` is the trusted managed directory next to the final
// version. This function does not run helper executables or activate a link.
fun extractCompanion(parent: SecureDirectory, archiveFile: SecureFile,
    pins: CompanionPins): CompanionExtractResult = extractCompanionChecked(
        parent, archiveFile, pins, { name: string -> "" }
    )

// `check` runs after verification, while a new private stage is unpublished;
// existing winners are also checked before they are returned.
private fun companionExtractFromSpool(parent: SecureDirectory, archiveFile: SecureFile,
    pins: CompanionPins, check: (string) -> string): CompanionExtractResult {
    if (parent.descriptor < 0 || !companionPinsValid(pins)) return CompanionExtractResult("invalid",
        false)
    val currentKind = parent.entryKind(pins.version)
    if (currentKind == "directory") {
        val current = parent.openDirectory(pins.version)
        val checked = verifyCompanion(current, pins)
        if (checked.error.startsWith("publication_in_progress:")) return CompanionExtractResult(
            checked.error, false
        )
        if (checked.error != "") return CompanionExtractResult("existing_${checked.error}", false)
        val helperError = check(pins.version)
        if (helperError != "") return CompanionExtractResult("helper: $helperError", false)
        return CompanionExtractResult("", true)
    }
    if (currentKind != "missing") return CompanionExtractResult("existing_type", false)
    if (archiveFile.descriptor < 0 ||
        !archiveFile.isRegular()) return CompanionExtractResult("archive_open", false)
    val verified = companionStreamValidate(archiveFile, pins)
    if (verified.error != "") return CompanionExtractResult(verified.error, false)
    val random = secureRandomBytes(16)
    if (!random.succeeded) return CompanionExtractResult("random", false)
    val stageName = ".install-${pins.version}-${hexEncode(random.bytes)}"
    val stageMade = parent.createDirectoryStatus(stageName, 0o700)
    if (stageMade == -28 || stageMade == -122) return CompanionExtractResult("disk_full", false)
    if (stageMade != 0) return CompanionExtractResult("stage_create", false)
    val stage = CompanionStage([], [])
    val root = parent.openDirectory(stageName)
    if (root.descriptor < 0) {
        if (!parent.remove(stageName, true)) return CompanionExtractResult("cleanup", false,
            stageName)
        return CompanionExtractResult("stage_open", false)
    }
    var error = ""
    val rootMode = root.setPermissionsChecked(0o700)
    if (rootMode != "") error = if (rootMode == "disk_full") "disk_full" else "stage_open"
    if (error == "") error = companionStreamStage(archiveFile, root, pins, verified, stage)
    if (error == "") {
        val checkRoot = parent.openDirectory(stageName)
        val checked = companionVerifyTree(checkRoot, pins)
        if (checked.error != "") error = "verify_${checked.error}"
    }
    if (error == "") {
        val helperError = check(stageName)
        if (helperError != "") error = "helper: $helperError"
    }
    if (error == "") {
        var i = stage.dirs.size
        while (i > 0) {
            i -= 1
            error = companionStageModeChecked(root, stage.dirs[i].split("/"), 0, 0o555)
            if (error != "") break
        }
        if (error == "") {
            val synced = root.syncChecked()
            if (synced != "") error = if (synced == "disk_full") "disk_full" else "stage_mode"
        }
    }
    if (error != "") {
        root.close()
        if (!companionStageCleanup(parent, stageName,
            stage)) return CompanionExtractResult("cleanup", false, stageName, "", 0, "", error)
        return CompanionExtractResult(error, false)
    }
    val published = parent.renameNoReplace(stageName, parent, pins.version)
    if (published == 0) {
        val finalMode = root.setPermissionsChecked(0o555)
        if (finalMode != "") {
            root.close()
            val details = if (finalMode == "disk_full") "; disk_full" else ""
            return CompanionExtractResult("publication_in_progress: directory ${pins.version}; ensure no installer is running, remove this directory, and rerun$details",
                false)
        }
        if (!root.close()) return CompanionExtractResult("publish_close", false)
        val synced = parent.syncChecked()
        if (synced != "") return CompanionExtractResult(if (synced ==
            "disk_full") "disk_full" else "publish_sync", false)
        return CompanionExtractResult("", false)
    }
    root.close()
    if (!companionStageCleanup(parent, stageName, stage)) return CompanionExtractResult("cleanup",
        false, stageName, "rename_no_replace", -published, "",
        if (published == -28 || published == -122) "disk_full" else "publish")
    if (published == -28 || published == -122) return CompanionExtractResult("disk_full", false)
    if (published != -17) return CompanionExtractResult("publish", false, "",
        "rename_no_replace", -published)
    val winner = parent.openDirectory(pins.version)
    val checked = verifyCompanion(winner, pins)
    if (checked.error.startsWith("publication_in_progress:")) return CompanionExtractResult(
        checked.error, false
    )
    if (checked.error != "") return CompanionExtractResult("existing_${checked.error}", false)
    val helperError = check(pins.version)
    if (helperError != "") return CompanionExtractResult("helper: $helperError", false)
    CompanionExtractResult("", true)
}

// The caller must own a private spool inaccessible to other writers. This
// avoids copying a download that has already been written to such a spool.
fun extractSpooledCompanionChecked(parent: SecureDirectory, archiveFile: SecureFile,
    pins: CompanionPins, check: (string) -> string): CompanionExtractResult =
    companionExtractFromSpool(parent, archiveFile, pins, check)

// Each adapter owns a close-on-exec duplicate of the caller's archive handle.
// Duplicates share the offset, so the caller must not seek or read concurrently.
private resource class CompanionGzipSource(val file: SecureFile,
    val hash: Sha256Stream): GzipSource {
    fun readChunk(maxBytes: int): GzipInputChunk {
        val chunk = this.file.readChunk(maxBytes)
        if (chunk.error != "") return GzipInputChunk("", false, chunk.error)
        this.hash.update(chunk.data)
        GzipInputChunk(chunk.data, chunk.eof)
    }
}
private resource class CompanionTarSource(val input: CompanionGzipSource,
    val gzip: GzipStream): TarSource {
    fun readChunk(maxBytes: int): TarInputChunk {
        val part = this.gzip.read(this.input, maxBytes)
        TarInputChunk(part.data, part.done, if (part.error == "") "" else "gzip_${part.error}")
    }
}
private class CompanionStreamEntry(val entry: TarEntry, val hash: string)
private class CompanionStreamResult(val entries: array<CompanionStreamEntry>, val manifest: Json,
    val error: string)
private fun companionStreamError(error: string): CompanionStreamResult =
    CompanionStreamResult([], jsonNull(), error)

// Hash the entire compressed input before invoking gzip, without trusting a
// length field or retaining the input. The caller retains and owns the handle.
private fun companionArchiveHash(file: SecureFile, maximum: int): string {
    if (!file.rewind()) return "archive_read"
    val hash = sha256Stream()
    var total = 0
    while (true) {
        val part = file.readChunk(65536)
        if (part.error != "") return "archive_read"
        if (part.data.size > maximum - total) return "archive_limit"
        total += part.data.size
        hash.update(part.data)
        if (part.eof) break
    }
    hexEncode(hash.finish())
}

private fun companionStreamValidate(file: SecureFile, pins: CompanionPins): CompanionStreamResult {
    if (!companionPinsValid(pins)) return companionStreamError("pins")
    if (file.descriptor < 0 || !file.isRegular()) return companionStreamError("archive_open")
    val inputHash = companionArchiveHash(file, 536870912)
    if (inputHash == "archive_read" || inputHash ==
        "archive_limit") return companionStreamError(inputHash)
    if (inputHash != pins.archiveSha256) return companionStreamError("archive_hash")
    if (!file.rewind()) return companionStreamError("archive_read")
    val duplicate = file.duplicate()
    if (duplicate.descriptor < 0) return companionStreamError("archive_read")
    val input = CompanionGzipSource(move(duplicate), sha256Stream())
    val gzip = gzipStream(input, 536870912, 1073741824)
    val source = CompanionTarSource(move(input), move(gzip))
    val tar = tarStream(TarLimits(1073741824, 1024, 1073741824, 1073741824))
    val entries: array<CompanionStreamEntry> = []
    val root = "abla-xtensa-llvm-${pins.version}-${pins.platform}"
    var manifestRaw = ""
    var foundManifest = false
    while (true) {
        val next = tar.next(source)
        if (next.error != "") return companionStreamError(if (next.error.startsWith("gzip_"))
            next.error else "tar_${next.error}")
        if (next.done) break
        val entry = next.entry
        if (!companionRawPathValid(entry.rawPath) ||
            (entry.path != root &&
                !entry.path.startsWith("$root/"))) return companionStreamError("archive_path")
        if (entry.path == root && entry.kind !=
            "directory") return companionStreamError("archive_root")
        val isManifest = entry.path == "$root/manifest.json" && entry.kind == "file"
        if (isManifest && (entry.size <= 0 || entry.size >
            65536)) return companionStreamError("manifest_limit")
        val hash = sha256Stream()
        val manifestData = byteBuffer()
        while (true) {
            val part = tar.readData(source, 65536)
            if (part.error != "") return companionStreamError(if (part.error.startsWith("gzip_"))
                part.error else "tar_${part.error}")
            hash.update(part.data)
            if (isManifest) manifestData.appendText(part.data)
            if (part.done) break
        }
        if (isManifest) { manifestRaw = manifestData.toText(); foundManifest = true }
        entries.append(CompanionStreamEntry(entry, hexEncode(hash.finish())))
    }
    if (hexEncode(source.input.hash.finish()) !=
        pins.archiveSha256) return companionStreamError("archive_hash")
    if (!foundManifest) return companionStreamError("manifest_missing")
    if (hexEncode(sha256(manifestRaw)) !=
        pins.manifestSha256) return companionStreamError("manifest_hash")
    val parsed = jsonParse(manifestRaw, JsonLimits(65536, 32, 10000, 65536, 2048, true))
    if (!parsed.succeeded || !parsed.value.isObject()) return companionStreamError("manifest_json")
    val manifest = parsed.value
    if (manifest.getInt("schema") != 1 || manifest.getString("version") !=
        "abla-xtensa-llvm-${pins.version}" || manifest.getString("platform") != pins.platform ||
        manifest.getString("llvmVersion") != pins.llvmVersion ||
        manifest.getString("sourceCommit") != pins.sourceCommit ||
        manifest.getString("sourceArchiveSha256") != pins.sourceArchiveSha256)
        return companionStreamError("manifest_identity")
    val files = manifest.get("files")
    if (!files.isObject() || !files.has("bin/opt") ||
        !files.has("bin/llc")) return companionStreamError("manifest_files")
    var library = false
    for (key in files.keys) if (key.startsWith("lib/libLLVM")) library = true
    if (!library) return companionStreamError("manifest_files")
    var count = 0
    for (item in entries) {
        val entry = item.entry
        if (entry.kind == "file" && entry.path != "$root/manifest.json") {
            val name = entry.path.slice(root.size + 1, entry.path.size)
            if (!files.has(name) ||
                !files.get(name).isString()) return companionStreamError("file_set")
            if (files.getString(name).size != 64 || item.hash != files.getString(name))
                return companionStreamError("file_hash")
            if ((name == "bin/opt" || name == "bin/llc") && (entry.mode & 0o111) == 0)
                return companionStreamError("file_mode")
            count += 1
        }
    }
    if (count != files.size()) return companionStreamError("file_set")
    CompanionStreamResult(entries, manifest, "")
}

// Writes one previously validated entry into a private stage; every created
// path is recorded before another operation so rollback can remove it.
private fun companionStreamStageEntry(parent: SecureDirectory, parts: array<string>, index: int,
    prefix: string, expected: CompanionStreamEntry, var tar: TarStream,
    var source: CompanionTarSource, var stage: CompanionStage): string {
    val name = parts[index]
    val path = if (prefix == "") name else "$prefix/$name"
    if (index + 1 < parts.size || expected.entry.kind == "directory") {
        val made = parent.createDirectoryStatus(name, 0o700)
        if (made == 0) stage.dirs.append(path)
        else if (made == -28 || made == -122) return "disk_full"
        else if (made != -17) return "stage_write"
        val child = parent.openDirectory(name)
        if (child.descriptor < 0) return "stage_write"
        val mode = child.setPermissionsChecked(0o700)
        if (mode != "") return if (mode == "disk_full") "disk_full" else "stage_write"
        if (index + 1 < parts.size) return companionStreamStageEntry(child, parts, index + 1,
            path, expected, tar, source, stage)
        val empty = tar.readData(source, 65536)
        if (empty.error !=
            "") return if (empty.error.startsWith("gzip_")) empty.error else "tar_${empty.error}"
        if (!empty.done || empty.data != "") return "tar_invalid"
        return ""
    }
    val file = parent.createFile(name, 0o600)
    if (file.descriptor == -28 || file.descriptor == -122) return "disk_full"
    if (file.descriptor < 0) return "stage_write"
    stage.files.append(path)
    val hash = sha256Stream()
    while (true) {
        val part = tar.readData(source, 65536)
        if (part.error !=
            "") return if (part.error.startsWith("gzip_")) part.error else "tar_${part.error}"
        hash.update(part.data)
        val written = file.writeChecked(part.data)
        if (written == "disk_full") return "disk_full"
        if (written != "") return "stage_write"
        if (part.done) break
    }
    if (hexEncode(hash.finish()) != expected.hash) return "file_hash"
    val synced = file.syncChecked()
    if (synced == "disk_full") return "disk_full"
    if (synced != "") return "stage_write"
    val mode = file.setPermissionsChecked(if ((expected.entry.mode & 0o111) != 0) 0o555 else 0o444)
    if (mode != "") return if (mode == "disk_full") "disk_full" else "stage_write"
    if (!file.close()) return "stage_write"
    ""
}

private fun companionStreamStage(file: SecureFile, root: SecureDirectory, pins: CompanionPins,
    verified: CompanionStreamResult, var stage: CompanionStage): string {
    if (!file.rewind()) return "archive_read"
    val duplicate = file.duplicate()
    if (duplicate.descriptor < 0) return "archive_read"
    val input = CompanionGzipSource(move(duplicate), sha256Stream())
    val gzip = gzipStream(input, 536870912, 1073741824)
    val source = CompanionTarSource(move(input), move(gzip))
    val tar = tarStream(TarLimits(1073741824, 1024, 1073741824, 1073741824))
    val archiveRoot = "abla-xtensa-llvm-${pins.version}-${pins.platform}"
    var i = 0
    while (true) {
        val next = tar.next(source)
        if (next.error !=
            "") return if (next.error.startsWith("gzip_")) next.error else "tar_${next.error}"
        if (next.done) break
        if (i >= verified.entries.size) return "archive_changed"
        val expected = verified.entries[i]
        val entry = next.entry
        if (entry.path != expected.entry.path || entry.rawPath != expected.entry.rawPath ||
            entry.kind != expected.entry.kind || entry.size != expected.entry.size ||
            entry.mode != expected.entry.mode) return "archive_changed"
        if (entry.path == archiveRoot) {
            val empty = tar.readData(source, 65536)
            if (empty.error != "" || !empty.done || empty.data != "") return "archive_changed"
        } else {
            val relative = entry.path.slice(archiveRoot.size + 1, entry.path.size)
            val error = companionStreamStageEntry(root, relative.split("/"), 0, "", expected,
                tar, source, stage)
            if (error != "") return error
        }
        i += 1
    }
    if (i != verified.entries.size || hexEncode(source.input.hash.finish()) != pins.archiveSha256)
        return "archive_changed"
    ""
}

// Copies an offline input into a private spool before either validation pass.
// No payload file exists until the complete compressed and decoded archive,
// manifest, and every file digest have been validated from that spool.
fun extractCompanionChecked(parent: SecureDirectory, archiveFile: SecureFile,
    pins: CompanionPins, check: (string) -> string): CompanionExtractResult {
    if (parent.descriptor < 0 || !companionPinsValid(pins)) return CompanionExtractResult("invalid",
        false)
    if (parent.entryKind(pins.version) != "missing")
        return companionExtractFromSpool(parent, archiveFile, pins, check)
    if (archiveFile.descriptor < 0 ||
        !archiveFile.isRegular()) return CompanionExtractResult("archive_open", false)
    if (archiveFile.size() > 536870912) return CompanionExtractResult("archive_limit", false)
    val random = secureRandomBytes(16)
    if (!random.succeeded) return CompanionExtractResult("random", false)
    val name = ".spool-${hexEncode(random.bytes)}"
    val made = parent.createDirectoryStatus(name, 0o700)
    if (made == -28 || made == -122) return CompanionExtractResult("disk_full", false)
    if (made != 0) return CompanionExtractResult("spool_create", false)
    val directory = parent.openDirectory(name)
    if (directory.descriptor < 0) {
        if (!parent.remove(name, true)) return CompanionExtractResult("cleanup", false, "", "", 0,
            name, "spool_open")
        return CompanionExtractResult("spool_open", false)
    }
    var error = ""
    val spoolMode = directory.setPermissionsChecked(0o700)
    if (spoolMode != "") error = if (spoolMode == "disk_full") "disk_full" else "spool_open"
    else if (!archiveFile.rewind()) error = "archive_read"
    val output = directory.createFile("archive", 0o600)
    var created = output.descriptor >= 0
    if (!created) {
        if (output.descriptor == -28 || output.descriptor == -122) error = "disk_full"
        else if (error == "") error = "spool_open"
    }
    var total = 0
    while (error == "") {
        val part = archiveFile.readChunk(65536)
        if (part.error != "") { error = "archive_read"; break }
        if (part.data.size > 536870912 - total) { error = "archive_limit"; break }
        total += part.data.size
        val written = output.writeChecked(part.data)
        if (written != "") { error = if (written ==
            "disk_full") "disk_full" else "spool_write"; break }
        if (part.eof) break
    }
    if (error == "") {
        val synced = output.syncChecked()
        if (synced != "") error = if (synced == "disk_full") "disk_full" else "spool_write"
    }
    if (!output.close() && error == "") error = "spool_write"
    var result = CompanionExtractResult(error, false)
    if (error == "") {
        val input = directory.openRegularFile("archive")
        if (input.descriptor < 0) result = CompanionExtractResult("spool_open", false)
        else {
            result = companionExtractFromSpool(parent, input, pins, check)
            if (!input.close() && result.error == "") result = CompanionExtractResult("spool_close",
                false)
        }
    }
    var clean = true
    if (created && !directory.remove("archive")) clean = false
    if (!directory.close()) clean = false
    if (!parent.remove(name, true)) clean = false
    if (!clean) return CompanionExtractResult("cleanup", false, result.leftoverStage,
        result.operation, result.errorNumber, name,
        if (result.cause != "") result.cause else result.error)
    result
}
