/** Moves out the last element in O(1). An empty array panics on the index. */
fun <T> array<T>.removeLast(): T = this.takeAt(this.size - 1)

/** Moves out an element, preserving the order of the remaining elements.
 * An invalid index panics before the array is changed. */
fun <T> array<T>.removeAt(index: int): T = this.takeAt(index)

// One bottom-up merge pass: the runs of `width` in `source` are merged pairwise into `target`.
private fun <T> arrayMergePass(source: array<T>, var target: array<T>, width: int, less: (T, T) -> bool): void {
    val size = source.size
    var start = 0
    while (start < size) {
        val middle = if (start + width < size) start + width else size
        val end = if (start + 2 * width < size) start + 2 * width else size
        var left = start
        var right = middle
        var out = start
        while (out < end) {
            // The right element goes first only when it strictly comes before the left one: ties keep the left, so the
            // sort is stable.
            if (left < middle && (right >= end || !less(source[right], source[left]))) {
                target[out] = source[left]
                left = left + 1
            } else {
                target[out] = source[right]
                right = right + 1
            }
            out = out + 1
        }
        start = end
    }
    return
}

/**
 * A copy of the array ordered by `less`, which says whether its first argument must come before the second (a strict
 * order: `less(a, a)` is false). A stable merge sort, O(n log n): elements that neither comes before the other keep
 * their order. The array itself is not changed.
 */
fun <T> array<T>.sortedBy(less: (T, T) -> bool): array<T> {
    val size = this.size
    val first: array<T> = []
    val second: array<T> = []
    for (item in this) {
        first.append(item)
        second.append(item)
    }
    // Runs of 8 are ordered by insertion (stable), then runs are merged pairwise between the two copies.
    var begin = 0
    while (begin < size) {
        val end = if (begin + 8 < size) begin + 8 else size
        var at = begin + 1
        while (at < end) {
            val item = first[at]
            var hole = at
            while (hole > begin && less(item, first[hole - 1])) {
                first[hole] = first[hole - 1]
                hole = hole - 1
            }
            first[hole] = item
            at = at + 1
        }
        begin = end
    }
    var width = 8
    var inFirst = true
    while (width < size) {
        if (inFirst) arrayMergePass(first, second, width, less)
        else arrayMergePass(second, first, width, less)
        inFirst = !inFirst
        width = width * 2
    }
    val result: array<T> = []
    if (inFirst) for (item in first) result.append(item)
    else for (item in second) result.append(item)
    result
}

/** A copy of the integers in ascending order (stable merge sort, O(n log n)). */
fun array<int>.sorted(): array<int> = this.sortedBy { a, b -> a < b }
