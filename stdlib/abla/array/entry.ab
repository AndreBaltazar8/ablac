/** Moves out the last element in O(1). An empty array panics on the index. */
fun <T> array<T>.removeLast(): T = this.takeAt(this.size - 1)

/** Moves out an element, preserving the order of the remaining elements.
 * An invalid index panics before the array is changed. */
fun <T> array<T>.removeAt(index: int): T = this.takeAt(index)
