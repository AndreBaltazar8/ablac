// Linear-time regular expressions (RE2 style): a pattern is parsed to a tree,
// compiled to a small program, and run by a Pike VM that advances every
// possible path in lock step. A search costs O(text size * program size) with
// no backtracking, so no pattern can take exponential time. findAll and replace
// search again from the end of each match, so they cost up to (matches + 1) times
// that when a longer alternative keeps running after a shorter one has matched. Backreferences and
// lookaround are rejected when the pattern is compiled. A class's ranges are
// sorted and merged when it is compiled, and a class test is a binary search,
// so a class with many members costs O(log ranges) per test, not O(ranges).
// A failed compile's empty Regex matches nothing.
//
// Text is UTF-8: `.`, classes and literals match whole code points, and every
// span is a byte offset into the text. A byte that is not part of valid UTF-8
// reads as U+FFFD, one byte wide. `\d`, `\w`, `\s` and `\b` are ASCII only.
import "abla/array"
import "abla/bytes"
import "abla/text"
import "abla/compiler/parser"
import "abla/compiler"
import "abla/process/exit"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// A failed pattern compilation's message and zero-based byte offset in the pattern.
class RegexError(val message: string, val offset: int)

// `program` holds (operation, x, y) triples; `classes` holds [low, high, ...]
// code point ranges. A failed compile returns an empty Regex.
class Regex(
    val pattern: string,
    val groupCount: int,
    val program: array<int>,
    val classes: array<array<int>>,
    // 256 bytes, one per byte value: 1 when a match can start with that byte (every byte of 128 and over is 1),
    // or "" when a match can start anywhere (an empty match, an assertion or `.` is reachable at the start).
    val first: string,
    // Optional frozen plans for small capture-free literals. The public
    // program and classes retain their normal representation.
    val literalChoices: array<string>? = null,
    val literalDfa: string = "",
    // Runtime search plan, or null when the pattern has no fixed-width ASCII fast path.
    val fixedBytes: RegexFixedBytes? = null
) {
    /** True when the whole text matches. */
    fun matches(text: string): bool {
        val choices = this.literalChoices
        if (choices != null) return regexLiteralWhole(choices, text)
        if (this.literalDfa != "") return regexLiteralEnd(this.literalDfa, text, true) >= 0
        var vm = regexVm(this, text)
        regexRun(this, vm, 0, true, true, false).size > 0
    }
    /** The match of the whole text with its groups, or null. */
    fun matchFull(text: string): RegexMatch? {
        if (this.literalChoices != null || this.literalDfa != "") {
            return if (this.matches(text)) RegexMatch(text, [0, text.size]) else null
        }
        var vm = regexVm(this, text)
        val spans = regexRun(this, vm, 0, true, true, false)
        if (spans.size == 0) null else RegexMatch(text, spans)
    }
    /** The leftmost match starting at or after byte offset `start`, or null. */
    fun find(text: string, start: int = 0): RegexMatch? {
        if (start < 0 || start > text.size) return null
        val choices = this.literalChoices
        if (choices != null) return regexLiteralFind(choices, text, start)
        val fixed = this.fixedBytes
        if (fixed != null) {
            val end = regexFixedFindEnd(fixed, text, start)
            return if (end < 0) null else RegexMatch(text, [end - fixed.width, end])
        }
        val table = this.literalDfa
        if (table.size >= 2 && table[1] == 1) {
            if (start != 0) return null
            val end = regexLiteralEnd(table, text, false)
            return if (end >= 0) RegexMatch(text, [0, end]) else null
        }
        var vm = regexVm(this, text)
        val spans = regexRun(this, vm, start, false, false, false)
        if (spans.size == 0) null else RegexMatch(text, spans)
    }
    /// Finds the leftmost match using at most `maximumSteps` search steps.
    /// An invalid start is a miss. Exhaustion returns its own result without a partial match.
    fun findWithin(text: string, maximumSteps: int, start: int = 0): RegexSearchResult {
        if (start < 0 || start > text.size || this.program.size == 0) return RegexSearchMiss()
        if (maximumSteps <= 0) return RegexSearchExhausted()
        var vm = regexVm(this, text)
        val spans = regexRunBounded(vm, start, maximumSteps, false)
        if (vm.work < 0) return RegexSearchExhausted()
        if (spans.size == 0) RegexSearchMiss() else RegexSearchMatch(RegexMatch(text, spans))
    }
    /// Every non-overlapping match from byte offset `start`, as `findAll`, using at most `maximumSteps` search steps in
    /// all (one budget for every search of the call; a step is as in `findWithin`). When the budget runs out the result
    /// has the matches completed before it and `resumeAt`: `findAllWithin(text, steps, resumeAt)` continues, and the
    /// matches of the calls joined are those of `findAll`. An invalid start, or a failed compile, is done with no match.
    fun findAllWithin(text: string, maximumSteps: int, start: int = 0): RegexFindAllResult {
        val found: array<RegexMatch> = []
        if (start < 0 || start > text.size || this.program.size == 0) return RegexFindAllDone(found)
        if (maximumSteps <= 0) return RegexFindAllExhausted(found, start)
        var vm = regexVm(this, text)
        var position = start
        var advance = false
        while (position <= text.size) {
            val spans = regexRunBounded(vm, position, maximumSteps, advance)
            if (vm.work < 0) {
                // The unfinished search followed an empty match at `position`: that match is left out and found again
                // by the continuation, which starts afresh there (a continuation cannot know it must refuse it).
                if (advance) found.removeLast()
                return RegexFindAllExhausted(found, position)
            }
            if (spans.size == 0) break
            found.append(RegexMatch(text, spans))
            advance = spans[1] == spans[0]
            position = spans[1]
        }
        RegexFindAllDone(found)
    }
    /// `replace` using at most `maximumSteps` search steps in all (a step is as in `findWithin`). When the budget runs
    /// out the result is `RegexReplaceExhausted`, with no partially replaced text.
    fun replaceWithin(text: string, replacement: string, maximumSteps: int): RegexReplaceResult {
        if (this.program.size == 0) return RegexReplaceDone(text)
        if (maximumSteps <= 0) return RegexReplaceExhausted()
        val plain = !replacement.contains("$")
        val out = byteBuffer()
        var last = 0
        var vm = regexVm(this, text)
        var position = 0
        var advance = false
        while (position <= text.size) {
            val spans = regexRunBounded(vm, position, maximumSteps, advance)
            if (vm.work < 0) return RegexReplaceExhausted()
            if (spans.size == 0) break
            out.appendText(text.slice(last, spans[0]))
            out.appendText(if (plain) replacement else regexExpand(RegexMatch(text, spans), replacement))
            last = spans[1]
            advance = spans[1] == spans[0]
            position = spans[1]
        }
        out.appendText(text.slice(last, text.size))
        RegexReplaceDone(out.toText())
    }
    /** Byte offset of the first match at or after start, or -1. */
    fun findStart(text: string, start: int = 0): int {
        if (start < 0 || start > text.size) return -1
        val choices = this.literalChoices
        if (choices != null) return regexLiteralFindStart(choices, text, start)
        val fixed = this.fixedBytes
        if (fixed != null) {
            val end = regexFixedFindEnd(fixed, text, start)
            return if (end < 0) -1 else end - fixed.width
        }
        val table = this.literalDfa
        if (table.size >= 2 && table[1] == 1)
            return if (start == 0 && regexLiteralEnd(table, text, false) >= 0) 0 else -1
        var vm = regexVm(this, text)
        val spans = regexRun(this, vm, start, false, false, false)
        if (spans.size == 0) -1 else spans[0]
    }
    /** Exclusive byte offset of a match starting at byte zero, or -1. */
    fun matchPrefixEnd(text: string): int {
        val choices = this.literalChoices
        if (choices != null) {
            for (choice in choices) if (text.startsWith(choice)) return choice.size
            return -1
        }
        val table = this.literalDfa
        if (table.size >= 2 && table[1] == 1) return regexLiteralEnd(table, text, false)
        var vm = regexVm(this, text)
        val spans = regexRun(this, vm, 0, true, false, false)
        if (spans.size == 0) -1 else spans[1]
    }
    /**
     * The general VM work for `find(text)` (instructions added to a thread list and threads advanced).
     * Never more than 2 * (text.size + 1) * program size, whatever the pattern.
     */
    fun findWork(text: string): int {
        var vm = regexVm(this, text)
        regexRun(this, vm, 0, false, false, false)
        vm.work
    }
    /**
     * A diagnostic: the VM steps `findAll(text)` (and so `replace`) takes. Each match restarts the search where the
     * previous one ended, so a pattern whose longer alternative keeps running after a shorter one has matched
     * (`a+b|a` over `aaaa…`) takes up to (matches + 1) times the bound of `findWork`.
     */
    fun findAllWork(text: string): int {
        var vm = regexVm(this, text)
        var position = 0
        var advance = false
        var more = true
        while (more && position <= text.size) {
            val spans = regexRun(this, vm, position, false, false, advance)
            if (spans.size == 0) {
                more = false
            } else {
                advance = spans[1] == spans[0]
                position = spans[1]
            }
        }
        vm.work
    }
    /** Every non-overlapping match, left to right. */
    fun findAll(text: string): array<RegexMatch> {
        val found: array<RegexMatch> = []
        val fixed = this.fixedBytes
        var vm = regexVm(this, text)
        var position = 0
        var advance = false
        var more = true
        while (more && position <= text.size) {
            val spans = if (fixed != null) regexFixedSpans(fixed, text, position)
                else regexRun(this, vm, position, false, false, advance)
            if (spans.size == 0) {
                more = false
            } else {
                found.append(RegexMatch(text, spans))
                advance = spans[1] == spans[0]
                position = spans[1]
            }
        }
        found
    }
    /**
     * Replace every match. In `replacement`, `$0` is the whole match, `$1`
     * and up are groups (all digits after the `$`, `${12}` also works), and
     * `$$` is a dollar sign. A group that did not take part, or does not
     * exist, is empty; a `$` followed by anything else stays a dollar sign.
     */
    fun replace(text: string, replacement: string): string {
        // A replacement without `$` is the same text for every match: it is not expanded each time.
        val plain = !replacement.contains("$")
        val fixed = this.fixedBytes
        val out = byteBuffer()
        var last = 0
        var vm = regexVm(this, text)
        var position = 0
        var advance = false
        var more = true
        while (more && position <= text.size) {
            val spans = if (fixed != null) regexFixedSpans(fixed, text, position)
                else regexRun(this, vm, position, false, false, advance)
            if (spans.size == 0) {
                more = false
            } else {
                out.appendText(text.slice(last, spans[0]))
                out.appendText(if (plain) replacement else regexExpand(RegexMatch(text, spans), replacement))
                last = spans[1]
                advance = spans[1] == spans[0]
                position = spans[1]
            }
        }
        out.appendText(text.slice(last, text.size))
        out.toText()
    }
}

/// The outcomes of a bounded search.
sealed interface RegexSearchResult

/// A completed search that found the leftmost match and its capture spans.
class RegexSearchMatch(val matched: RegexMatch) : RegexSearchResult

/// A completed search without a match, or a search with a start offset out of range.
class RegexSearchMiss : RegexSearchResult

/// A search that needed another step after spending its budget.
class RegexSearchExhausted : RegexSearchResult

/// The outcomes of `findAllWithin`.
sealed interface RegexFindAllResult

/// Every match, the same as `findAll` from the same start.
class RegexFindAllDone(val matches: array<RegexMatch>) : RegexFindAllResult

/// The budget ran out: the matches completed before it, and the byte offset a continuation starts at.
class RegexFindAllExhausted(val matches: array<RegexMatch>, val resumeAt: int) : RegexFindAllResult

/// The outcomes of `replaceWithin`.
sealed interface RegexReplaceResult

/// The text with every match replaced, the same as `replace`.
class RegexReplaceDone(val text: string) : RegexReplaceResult

/// The budget ran out; there is no partially replaced text.
class RegexReplaceExhausted : RegexReplaceResult

// Holds a named capture's group slot and source span in the pattern.
class RegexCaptureName(val name: string, val slot: int, val begin: int, val end: int)

// A compiled regex when `succeeded` is true. On failure the regex is empty and `error` gives the reason and location.
class RegexCompileResult(
    val regex: Regex, val succeeded: bool, val error: RegexError,
    val captureNames: array<RegexCaptureName> = [], val requiredCaptures: array<bool> = []
)

/// Matcher for a literal with named captures. The underlying Regex keeps the indexed match API.
class NamedRegex<Captures>(val regex: Regex, val project: (RegexMatch) -> Captures) {
    // Returns true if the pattern matches the entire input.
    fun matches(text: string): bool = this.regex.matches(text)
    // Returns the input with every non-overlapping match replaced using the regex replacement syntax.
    fun replace(text: string, replacement: string): string = this.regex.replace(text, replacement)
    // Returns the named captures from a full-input match, or null if it fails.
    fun matchFull(text: string): Captures? {
        val matched = this.regex.matchFull(text)
        val project = this.project
        if (matched != null) project(matched) else null
    }
    // Returns the first projected match at or after the byte offset, or null for no match or an invalid offset.
    fun find(text: string, start: int = 0): Captures? {
        val matched = this.regex.find(text, start)
        val project = this.project
        if (matched != null) project(matched) else null
    }
    // Returns projected captures for every non-overlapping match in source order.
    fun findAll(text: string): array<Captures> {
        val matches = this.regex.findAll(text)
        val result: array<Captures> = []
        val project = this.project
        for (matched in matches) result.append(project(matched))
        result
    }
}

// Used only for generated fields proved to participate on every successful path.
fun ablaRegexRequiredCapture(matched: RegexMatch, index: int): string =
    matched.group(index) ?? panic("required regex capture did not participate")


// A match over the original input `text`. Read whole-match or capture spans with the accessors, which use byte offsets.
class RegexMatch(val text: string, val spans: array<int>) {
    // Returns the byte offset at the start of the whole match.
    fun start(): int = this.spans[0]
    // Returns the exclusive byte offset at the end of the whole match.
    fun end(): int = this.spans[1]
    // Returns the substring covered by the whole match.
    fun text0(): string = this.text.slice(this.spans[0], this.spans[1])
    /** Number of capturing groups, not counting the whole match. */
    fun groupCount(): int = this.spans.size / 2 - 1
    /** True when group `index` (0 is the whole match) took part in the match. */
    fun hasGroup(index: int): bool =
        index >= 0 && index <= this.groupCount() && this.spans[index * 2] >= 0
    // Returns the start byte offset for capture `index`, with zero meaning the whole match. Returns -1 for an out-of-range or unmatched capture.
    fun groupStart(index: int): int = if (this.hasGroup(index)) this.spans[index * 2] else -1
    // Returns the exclusive end byte offset for capture `index`, with zero meaning the whole match. Returns -1 for an out-of-range or unmatched capture.
    fun groupEnd(index: int): int = if (this.hasGroup(index)) this.spans[index * 2 + 1] else -1
    /** The text of group `index`, or null when it did not take part. */
    fun group(index: int): string? =
        if (this.hasGroup(index)) this.text.slice(this.spans[index * 2], this.spans[index * 2 + 1])
        else null
}

// Node kinds: 0 empty, 1 char(a), 2 any, 3 class(a = index, b = negated),
// 4 concatenation, 5 alternation, 6 repeat(a = min, b = max or -1, c = lazy),
// 7 group(a = capture index or -1), 8 assertion(a: 0 ^, 1 $, 2 \b, 3 \B).
class RegexNode(val kind: int, val a: int, val b: int, val c: int, val kids: array<RegexNode>)

private val regexNoKids: array<RegexNode> = []
private val regexMaximumInstructions = 100000
private val regexMaximumRepeat = 1000
private val regexMaximumDepth = 200
private val regexMaximumGroups = 500
// Instructions times capture slots: the VM's working memory is about 4 times this.
private val regexMaximumWork = 2000000

private fun regexLeaf(kind: int, a: int, b: int): RegexNode = RegexNode(kind, a, b, 0, regexNoKids)

private fun regexEmptyRegex(pattern: string): Regex = Regex(pattern, 0, [], [], "")

private fun regexFail(pattern: string, message: string, offset: int): RegexCompileResult =
    RegexCompileResult(regexEmptyRegex(pattern), false, RegexError(message, offset))

private fun regexIsWordByte(c: int): bool =
    (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95

private val regexCaptureKeywords: array<string> = [
    "as", "await", "break", "class", "compile", "continue", "defer", "do", "else",
    "extern", "false", "for", "fun", "generator", "if", "in", "interface",
    "import", "null", "noescape", "resource", "return", "task", "thread", "true",
    "trusted", "until", "val", "var", "when", "while", "yield", "this", "own",
    "borrow", "move", "_"
]

private fun regexCaptureIdentifier(name: string): bool {
    if (name == "" || name.startsWith("__") || (name[0] >= 48 && name[0] <= 57)) return false
    for (keyword in regexCaptureKeywords) if (name == keyword) return false
    true
}

private fun regexHexValue(c: int): int {
    if (c >= 48 && c <= 57) return c - 48
    if (c >= 65 && c <= 70) return c - 55
    if (c >= 97 && c <= 102) return c - 87
    -1
}

// The three shorthand sets, as ascending disjoint ranges.
private fun regexShorthand(letter: int): array<int> {
    if (letter == 100) return [48, 57]
    if (letter == 119) return [48, 57, 65, 90, 95, 95, 97, 122]
    [9, 13, 32, 32]
}

// The [low, high, ...] ranges sorted by low, with overlapping and adjacent ranges merged, so a lookup can binary search.
private fun regexNormalizeRanges(ranges: array<int>): array<int> {
    // A code point fits in 21 bits, so (low, high) packs into one sortable integer.
    val keys: array<int> = []
    var i = 0
    while (i + 1 < ranges.size) {
        keys.append(ranges[i] * 2097152 + ranges[i + 1])
        i += 2
    }
    val out: array<int> = []
    for (key in keys.sorted()) {
        val low = key / 2097152
        val high = key % 2097152
        val last = out.size - 1
        if (last > 0 && low <= out[last] + 1) {
            if (high > out[last]) out[last] = high
        } else {
            out.append(low)
            out.append(high)
        }
    }
    out
}

private fun regexComplement(ranges: array<int>): array<int> {
    val out: array<int> = []
    var next = 0
    var i = 0
    while (i < ranges.size) {
        if (ranges[i] > next) { out.append(next); out.append(ranges[i] - 1) }
        next = ranges[i + 1] + 1
        i += 2
    }
    if (next <= 1114111) { out.append(next); out.append(1114111) }
    out
}

// Tracks the cursor, capture slots, character classes, and first error while parsing a UTF-8 regex.
class RegexParser(
    val src: string,
    var pos: int,
    var groups: int,
    var depth: int,
    var failed: bool,
    var message: string,
    var errorOffset: int,
    val classes: array<array<int>>,
    val captureNames: array<RegexCaptureName> = []
) {
    // Records a parse failure with its source byte offset.
    fun fail(message: string, offset: int): RegexNode {
        if (!this.failed) {
            this.failed = true
            this.message = message
            this.errorOffset = offset
        }
        regexLeaf(0, 0, 0)
    }

    // Returns the next pattern byte or -1 at the end of the source.
    fun peek(): int = if (this.pos < this.src.size) this.src[this.pos] else -1

    // The code point at `pos`; the pattern was checked to be valid UTF-8.
    fun codePoint(): int = utf8DecodeAt(this.src, this.pos)

    // Advances past one UTF-8 scalar from a valid current source position.
    fun advanceCodePoint(): void {
        this.pos = this.pos + utf8SequenceLength(this.src[this.pos])
    }

    // Copies the class's ranges into the parser table and returns its index.
    fun addClass(ranges: array<int>): int {
        this.classes.append(regexNormalizeRanges(ranges))
        this.classes.size - 1
    }

    // Returns syntax for the current pipe-separated branches, recording an error for malformed pattern syntax.
    fun parseAlternation(): RegexNode {
        val branches: array<RegexNode> = []
        branches.append(this.parseConcatenation())
        while (!this.failed && this.peek() == 124) {
            this.pos = this.pos + 1
            branches.append(this.parseConcatenation())
        }
        if (branches.size == 1) branches[0] else RegexNode(5, 0, 0, 0, branches)
    }

    // Returns syntax for consecutive terms up to a pipe, closing group, or end of input.
    fun parseConcatenation(): RegexNode {
        val items: array<RegexNode> = []
        while (!this.failed && this.pos < this.src.size && this.peek() != 124 && this.peek() !=
            41) {
            val atomStart = this.pos
            val atom = this.parseAtom()
            if (!this.failed) items.append(this.parseQuantifiers(atom, atomStart))
        }
        if (items.size == 0) regexLeaf(0, 0, 0)
        else if (items.size == 1) items[0]
        else RegexNode(4, 0, 0, 0, items)
    }

    // Reads `{m}`, `{m,}`, `{m,n}`, `{,n}` or `{,}` at `pos`. Returns [min, max, length] with
    // max -1 for open, [] when the text is not a repeat, or [-1, message] is
    // not representable, so a bad interval is reported through `failed`.
    fun repeatBraces(): array<int> {
        var i = this.pos + 1
        var low = 0
        var digits = 0
        while (i < this.src.size && this.src[i] >= 48 && this.src[i] <= 57) {
            if (low <= 100000) low = low * 10 + this.src[i] - 48
            i += 1
            digits += 1
        }
        val none: array<int> = []
        if (digits == 0 && !(i < this.src.size && this.src[i] == 44)) return none
        var high = low
        if (i < this.src.size && this.src[i] == 44) {
            i += 1
            var highDigits = 0
            high = 0
            while (i < this.src.size && this.src[i] >= 48 && this.src[i] <= 57) {
                if (high <= 100000) high = high * 10 + this.src[i] - 48
                i += 1
                highDigits += 1
            }
            if (highDigits == 0) high = -1
        }
        if (i >= this.src.size || this.src[i] != 125) return none
        [low, high, i + 1 - this.pos]
    }

    // Returns the atom with any following repetition applied and records an error for unsupported or malformed repeats.
    fun parseQuantifiers(atom: RegexNode, atomStart: int): RegexNode {
        var low = -1
        var high = -1
        var length = 0
        val c = this.peek()
        if (c == 42) { low = 0; high = -1; length = 1 }
        else if (c == 43) { low = 1; high = -1; length = 1 }
        else if (c == 63) { low = 0; high = 1; length = 1 }
        else if (c == 123) {
            val braces = this.repeatBraces()
            if (braces.size == 3) { low = braces[0]; high = braces[1]; length = braces[2] }
        }
        if (length == 0) return atom
        val quantifierStart = this.pos
        if (atom.kind == 8) return this.fail("nothing to repeat", quantifierStart)
        if (low > regexMaximumRepeat || high > regexMaximumRepeat) {
            return this.fail("repeat count is larger than 1000", quantifierStart)
        }
        if (high >= 0 && high < low) return this.fail("bad repeat interval", quantifierStart)
        this.pos = this.pos + length
        var lazy = 0
        if (this.peek() == 63) { lazy = 1; this.pos = this.pos + 1 }
        val next = this.peek()
        if (next == 42 || next == 43 || next == 63) return this.fail("multiple repeat", this.pos)
        if (next == 123 && this.repeatBraces().size == 3) return this.fail("multiple repeat",
            this.pos)
        RegexNode(6, low, high, lazy, [atom])
    }

    // Returns the next pattern atom and records an error for an invalid or unexpected token.
    fun parseAtom(): RegexNode {
        val c = this.peek()
        if (c == 40) return this.parseGroup()
        if (c == 91) return this.parseClass()
        if (c == 46) { this.pos = this.pos + 1; return regexLeaf(2, 0, 0) }
        if (c == 94) { this.pos = this.pos + 1; return regexLeaf(8, 0, 0) }
        if (c == 36) { this.pos = this.pos + 1; return regexLeaf(8, 1, 0) }
        if (c == 92) return this.parseEscape()
        if (c == 42 || c == 43 || c == 63) return this.fail("nothing to repeat", this.pos)
        if (c == 123 && this.repeatBraces().size == 3) return this.fail("nothing to repeat",
            this.pos)
        val scalar = this.codePoint()
        this.advanceCodePoint()
        regexLeaf(1, scalar, 0)
    }

    // Allocates and returns the next capture slot, recording a parse error when the group limit is exceeded.
    fun captureSlot(open: int): int {
        this.groups += 1
        if (this.groups > regexMaximumGroups) this.fail("too many groups", open)
        this.groups
    }

    // Parses and returns a named capture's slot, recording an error for invalid or repeated names.
    fun namedCapture(open: int): int {
        this.pos += 2
        val begin = this.pos
        while (regexIsWordByte(this.peek())) this.pos += 1
        val name = this.src.slice(begin, this.pos)
        if (this.peek() != 62 || !regexCaptureIdentifier(name)) {
            this.fail("invalid capture name", begin)
            return -1
        }
        for (existing in this.captureNames) {
            if (existing.name == name) {
                this.fail("duplicate capture name '$name'", begin)
                return -1
            }
        }
        val slot = this.captureSlot(open)
        this.captureNames.append(RegexCaptureName(name, slot, begin, this.pos))
        this.pos += 1
        slot
    }

    // Returns a grouped expression and records a parse error for invalid group syntax or a missing closing parenthesis.
    fun parseGroup(): RegexNode {
        val open = this.pos
        this.pos += 1
        var capture = -1
        if (this.peek() == 63) {
            val kind = if (this.pos + 1 < this.src.size) this.src[this.pos + 1] else -1
            if (kind == 58) {
                this.pos += 2
            } else if (kind == 61 || kind == 33) {
                return this.fail("lookaround is not supported", open)
            } else if (kind == 60) {
                val after = if (this.pos + 2 < this.src.size) this.src[this.pos + 2] else -1
                if (after == 61 || after == 33) return this.fail("lookaround is not supported", open)
                capture = this.namedCapture(open)
            } else {
                return this.fail("unsupported group syntax", open)
            }
        } else capture = this.captureSlot(open)
        if (this.failed) return regexLeaf(0, 0, 0)
        if (this.depth >= regexMaximumDepth) return this.fail("groups are nested too deeply", open)
        this.depth += 1
        val inner = this.parseAlternation()
        this.depth -= 1
        if (this.failed) return inner
        if (this.peek() != 41) return this.fail("missing )", open)
        this.pos += 1
        RegexNode(7, capture, 0, 0, [inner])
    }

    // Returns the Unicode scalar for an escaped letter, recording an error for malformed or unsupported escapes.
    fun escapeScalar(letter: int): int {
        if (letter == 110) return 10
        if (letter == 114) return 13
        if (letter == 116) return 9
        if (letter == 102) return 12
        if (letter == 118) return 11
        -1
    }

    // Reads `count` hex digits at `pos`; -1 when they are not all there.
    fun hexDigits(count: int): int {
        var value = 0
        var i = 0
        while (i < count) {
            val digit = if (this.pos + i < this.src.size) regexHexValue(this.src[this.pos +
                i]) else -1
            if (digit < 0) return -1
            value = value * 16 + digit
            i += 1
        }
        value
    }

    // After `\` in an atom or a class: a code point, or -1 with `failed` set.
    // Shorthand letters are left to the callers.
    fun escapedScalar(): int {
        val at = this.pos - 1
        val e = this.peek()
        if (e < 0) { this.fail("a pattern cannot end with a backslash", at); return -1 }
        val simple = this.escapeScalar(e)
        if (simple >= 0) { this.pos = this.pos + 1; return simple }
        if (e == 120 || e == 117) {
            val count = if (e == 120) 2 else 4
            this.pos = this.pos + 1
            val value = this.hexDigits(count)
            if (value < 0) { this.fail("bad hexadecimal escape", at); return -1 }
            this.pos = this.pos + count
            return value
        }
        if (e >= 48 && e <= 57) {
            this.fail("backreferences and octal escapes are not supported", at)
            return -1
        }
        if ((e >= 65 && e <= 90) || (e >= 97 && e <= 122)) {
            this.fail("unknown escape", at)
            return -1
        }
        val scalar = this.codePoint()
        this.advanceCodePoint()
        scalar
    }

    // Returns syntax for one escaped scalar, class, or assertion and records an error for malformed escapes.
    fun parseEscape(): RegexNode {
        this.pos = this.pos + 1
        val e = this.peek()
        if (e == 100 || e == 119 || e == 115) {
            this.pos = this.pos + 1
            return regexLeaf(3, this.addClass(regexShorthand(e)), 0)
        }
        if (e == 68 || e == 87 || e == 83) {
            this.pos = this.pos + 1
            return regexLeaf(3, this.addClass(regexShorthand(e + 32)), 1)
        }
        if (e == 98) { this.pos = this.pos + 1; return regexLeaf(8, 2, 0) }
        if (e == 66) { this.pos = this.pos + 1; return regexLeaf(8, 3, 0) }
        val scalar = this.escapedScalar()
        if (this.failed) regexLeaf(0, 0, 0) else regexLeaf(1, scalar, 0)
    }

    // Returns syntax for a character class, recording an error if its ranges or closing bracket are invalid.
    fun parseClass(): RegexNode {
        val open = this.pos
        this.pos = this.pos + 1
        var negated = 0
        if (this.peek() == 94) { negated = 1; this.pos = this.pos + 1 }
        val ranges: array<int> = []
        var first = true
        var closed = false
        while (!this.failed && !closed) {
            if (this.pos >= this.src.size) return this.fail("missing ]", open)
            val c = this.peek()
            if (c == 93 && !first) {
                this.pos = this.pos + 1
                closed = true
            } else {
                first = false
                val low = this.classAtom(ranges)
                if (!this.failed && low >= 0) {
                    var high = low
                    if (this.peek() == 45 && this.pos + 1 < this.src.size && this.src[this.pos +
                        1] != 93) {
                        this.pos = this.pos + 1
                        high = this.classAtom(ranges)
                        if (!this.failed && high < 0) return this.fail("bad character range",
                            this.pos)
                        if (!this.failed && high < low) return this.fail("bad character range",
                            this.pos)
                    }
                    ranges.append(low)
                    ranges.append(high)
                } else if (!this.failed && this.peek() == 45 && this.pos + 1 < this.src.size &&
                    this.src[this.pos + 1] != 93) {
                    return this.fail("bad character range", this.pos)
                }
            }
        }
        if (this.failed) regexLeaf(0, 0, 0) else regexLeaf(3, this.addClass(ranges), negated)
    }

    // One class member: a code point, or -1 after adding a shorthand set to
    // `ranges` (or after failing).
    fun classAtom(var ranges: array<int>): int {
        val c = this.peek()
        if (c != 92) {
            val scalar = this.codePoint()
            this.advanceCodePoint()
            return scalar
        }
        this.pos = this.pos + 1
        val e = this.peek()
        if (e == 100 || e == 119 || e == 115 || e == 68 || e == 87 || e == 83) {
            this.pos = this.pos + 1
            val lower = if (e >= 97) e else e + 32
            val set = regexShorthand(lower)
            val use = if (e >= 97) set else regexComplement(set)
            for (value in use) ranges.append(value)
            return -1
        }
        if (e == 98 || e == 66) { this.fail("unsupported escape in a class",
            this.pos - 1); return -1 }
        this.escapedScalar()
    }
}

// Tracks the regex VM instructions and reports when the program exceeds its instruction limit.
class RegexEmitter(val program: array<int>, var failed: bool, var groupSlots: int, val limit: int) {
    // Returns the number of encoded VM instructions.
    fun count(): int = this.program.size / 3

    // Appends an instruction and returns its index, marking the emitter failed if the program limit is exceeded.
    fun add(op: int, x: int, y: int): int {
        this.program.append(op)
        this.program.append(x)
        this.program.append(y)
        if (this.program.size / 3 > this.limit) this.failed = true
        this.program.size / 3 - 1
    }

    // Replaces the first operand at an existing instruction index.
    fun setX(at: int, x: int): void { this.program[at * 3 + 1] = x }
    // Replaces the second operand at an existing instruction index.
    fun setY(at: int, y: int): void { this.program[at * 3 + 2] = y }

    // Appends the instructions for a parsed pattern node, stopping once the emitter records a failure.
    fun emit(node: RegexNode): void {
        if (this.failed) return
        val kind = node.kind
        if (kind == 1) { this.add(0, node.a, 0); return }
        if (kind == 2) { this.add(1, 0, 0); return }
        if (kind == 3) { this.add(2, node.a, node.b); return }
        if (kind == 8) { this.add(6, node.a, 0); return }
        if (kind == 4) {
            for (kid in node.kids) this.emit(kid)
            return
        }
        if (kind == 5) {
            val jumps: array<int> = []
            var i = 0
            while (i < node.kids.size && !this.failed) {
                if (i < node.kids.size - 1) {
                    val split = this.add(3, 0, 0)
                    this.setX(split, this.count())
                    this.emit(node.kids[i])
                    jumps.append(this.add(4, 0, 0))
                    this.setY(split, this.count())
                } else {
                    this.emit(node.kids[i])
                }
                i += 1
            }
            for (jump in jumps) this.setX(jump, this.count())
            return
        }
        if (kind == 7) {
            if (node.a >= 0) this.add(5, node.a * 2, 0)
            this.emit(node.kids[0])
            if (node.a >= 0) this.add(5, node.a * 2 + 1, 0)
            return
        }
        if (kind == 6) {
            val body = node.kids[0]
            var i = 0
            while (i < node.a && !this.failed) { this.emit(body); i += 1 }
            if (node.b < 0) {
                val split = this.add(3, 0, 0)
                this.emit(body)
                this.add(4, split, 0)
                this.fillSplit(split, split + 1, this.count(), node.c)
            } else {
                val splits: array<int> = []
                var extra = node.a
                while (extra < node.b && !this.failed) {
                    val split = this.add(3, 0, 0)
                    splits.append(split)
                    this.emit(body)
                    extra += 1
                }
                for (split in splits) this.fillSplit(split, split + 1, this.count(), node.c)
            }
        }
    }

    // Greedy tries `enter` first; lazy tries `leave` first.
    fun fillSplit(split: int, enter: int, leave: int, lazy: int): void {
        this.setX(split, if (lazy == 1) leave else enter)
        this.setY(split, if (lazy == 1) enter else leave)
    }
}

// A capture slot occurs in one syntactic branch only. The intersection of
// alternative guarantees is therefore empty. Visit only mandatory paths.
private fun regexMarkRequired(node: RegexNode, var required: array<bool>): void {
    if (node.kind == 7) {
        if (node.a > 0) required[node.a] = true
        regexMarkRequired(node.kids[0], required)
    } else if (node.kind == 4) {
        for (child in node.kids) regexMarkRequired(child, required)
    } else if (node.kind == 6 && node.a > 0) {
        regexMarkRequired(node.kids[0], required)
    }
    return
}

/**
 * Compile `pattern`. On failure `error` has the message and its byte offset. A pattern whose program has more than
 * 100,000 instructions is refused ("the pattern is too large"); counted repeats multiply when nested, so
 * `(a{1,30}){1,30}` is 1,863 instructions and `((a{1000}){1000}){1000}` is far over. A search costs up to
 * 2 * (text size + 1) * instructions steps, so for patterns from an untrusted source use `regexCompileWithin`.
 */
fun regexCompile(pattern: string): RegexCompileResult = regexCompileWithin(pattern, regexMaximumInstructions)

/** As `regexCompile`, refusing a program of more than `maximumInstructions` instructions (at most 100,000). */
fun regexCompileWithin(pattern: string, maximumInstructions: int): RegexCompileResult {
    val limit = if (maximumInstructions > regexMaximumInstructions) regexMaximumInstructions else maximumInstructions
    val info = utf8Info(pattern)
    if (!info.valid) return regexFail(pattern, "the pattern is not valid UTF-8", info.errorOffset)
    val parser = RegexParser(pattern, 0, 0, 0, false, "", 0, [])
    val tree = parser.parseAlternation()
    if (!parser.failed && parser.pos < pattern.size) parser.fail("unmatched )", parser.pos)
    if (parser.failed) return regexFail(pattern, parser.message, parser.errorOffset)
    val emitter = RegexEmitter([], false, 0, limit)
    emitter.add(5, 0, 0)
    emitter.emit(tree)
    emitter.add(5, 1, 0)
    emitter.add(7, 0, 0)
    if (emitter.failed) {
        return regexFail(pattern, "the pattern is too large: its program has more than ${limit} instructions", 0)
    }
    if (emitter.count() * (parser.groups + 1) * 2 > regexMaximumWork) {
        return regexFail(pattern, "the pattern is too large: ${emitter.count()} instructions times ${parser.groups + 1} " +
            "capture groups is more than ${regexMaximumWork / 2}", 0)
    }
    val required: array<bool> = []
    if (parser.captureNames.size > 0) {
        for (i in 0..parser.groups) required.append(false)
        regexMarkRequired(tree, required)
    }
    val fixed = if (parser.groups == 0 && !ablaAtCompileTime()) regexFixedPlan(emitter.program, parser.classes) else null
    RegexCompileResult(Regex(pattern, parser.groups, emitter.program, parser.classes,
        regexFirstBytes(emitter.program, parser.classes), null, "", fixed), true, RegexError("", 0),
        parser.captureNames, required)
}

// Whether class `index` holds the ASCII byte `c` (the VM's classMatches, on a program).
private fun regexClassHolds(classes: array<array<int>>, index: int, c: int): bool {
    val ranges = classes[index]
    var i = 0
    while (i < ranges.size) {
        if (c >= ranges[i] && c <= ranges[i + 1]) return true
        i += 2
    }
    false
}

// The bytes a match can begin with (see Regex.first). The instructions reachable from the start without consuming
// text are followed; the match instruction, an assertion or `.` reachable there gives "" (any start).
private fun regexFirstBytes(program: array<int>, classes: array<array<int>>): string {
    val n = program.size / 3
    val seen = filledArray(n, 0)
    val set = filledArray(256, 0)
    val stack = filledArray(n + 2, 0)
    var sp = 1
    var any = false
    while (!any && sp > 0) {
        sp -= 1
        var pc = stack[sp]
        var follow = true
        while (follow && !any) {
            follow = false
            if (pc < n && seen[pc] == 0) {
                seen[pc] = 1
                val op = program[pc * 3]
                val x = program[pc * 3 + 1]
                if (op == 4) {
                    pc = x
                    follow = true
                } else if (op == 3) {
                    stack[sp] = program[pc * 3 + 2]
                    sp += 1
                    pc = x
                    follow = true
                } else if (op == 5) {
                    pc += 1
                    follow = true
                } else if (op == 0) {
                    if (x < 128) set[x] = 1 else for (b in 128 until 256) set[b] = 1
                } else if (op == 2) {
                    val negated = program[pc * 3 + 2] == 1
                    for (b in 0 until 128) if (regexClassHolds(classes, x, b) != negated) set[b] = 1
                    for (b in 128 until 256) set[b] = 1
                } else any = true
            }
        }
    }
    if (any) "" else regexByteTable(set)
}

private trusted fun regexByteTable(set: array<int>): string {
    val buffer = nativeByteBuffer(257)
    val address = nativePointerAddress(buffer.address)
    var i = 0
    while (i < 256) {
        ablaUnsafeStoreU8(nativePointerFromAddress(address + i), set[i])
        i += 1
    }
    buffer.adoptString(256)
}

// Whether a match can start at `i`: not past the end, and not an ASCII byte outside `first`.
private trusted fun regexStartsAt(text: string, first: string, i: int, size: int): bool {
    if (i >= size) return false
    val byte = ablaUnsafeLoadU8(nativePointerFromAddress(ablaUnsafeStringAddress(text) + i))
    byte >= 128 || ablaUnsafeLoadU8(nativePointerFromAddress(ablaUnsafeStringAddress(first) + byte)) != 0
}

// The first position at or after `i` that is not an ASCII byte outside `first`, or `size`. A position after an ASCII
// byte is a code point boundary, so the search loop may start there as it would have by stepping to it.
private trusted fun regexSkipTo(text: string, first: string, i: int, size: int): int {
    var at = i
    val data = ablaUnsafeStringAddress(text)
    val table = ablaUnsafeStringAddress(first)
    var scanning = true
    while (scanning && at < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + at))
        if (byte < 128 && ablaUnsafeLoadU8(nativePointerFromAddress(table + byte)) == 0) at += 1
        else scanning = false
    }
    at
}

// ---- The Pike VM ----

// All capture slots live in one flat `store` of entries, `slots` ints each:
// entries [0, 2n) are the two thread lists (list 0 first, list 1 from n),
// [2n, 4n + 2) the work stack, then a start entry, a result entry and a work
// entry. `seen` marks the instructions already added in this generation.
// Holds the compiled program, input text, and scratch state for matching.
class RegexVm(
    val program: array<int>,
    val classes: array<array<int>>,
    val text: string,
    val n: int,
    val slots: int,
    val pcs: array<int>,
    val store: array<int>,
    val counts: array<int>,
    val seen: array<int>,
    var generation: int,
    val stackPcs: array<int>,
    var work: int
) {
    // Returns whether the requested anchor or word-boundary condition holds at the byte position.
    fun assertionHolds(kind: int, position: int): bool {
        if (kind == 0) return position == 0
        if (kind == 1) return position == this.text.size
        val before = position > 0 && regexIsWordByte(this.text[position - 1])
        val after = position < this.text.size && regexIsWordByte(this.text[position])
        if (kind == 2) before != after else before == after
    }

    // Returns the scratch entry used to store the initial capture state.
    fun startEntry(): int = this.n * 4 + 2
    // Returns the scratch entry that holds the current match result.
    fun resultEntry(): int = this.n * 4 + 3
    // Returns the scratch entry used for temporary capture state.
    fun workEntry(): int = this.n * 4 + 4

    // Copies all capture slots from one valid scratch entry to another.
    fun copyEntry(from: int, to: int): void {
        val a = from * this.slots
        val b = to * this.slots
        if (this.slots == 2) {
            this.store[b] = this.store[a]
            this.store[b + 1] = this.store[a + 1]
        } else for (i in 0 until this.slots) this.store[b + i] = this.store[a + i]
    }

    // Adds the thread at `pc0` with the captures of entry `source`, and
    // everything reachable without consuming text, in priority order.
    fun add(list: int, pc0: int, source: int, position: int): void {
        val stackBase = this.n * 2
        val work = this.workEntry()
        var sp = 1
        this.stackPcs[0] = pc0
        this.copyEntry(source, stackBase)
        while (sp > 0) {
            sp -= 1
            var pc = this.stackPcs[sp]
            this.copyEntry(stackBase + sp, work)
            var follow = true
            while (follow) {
                follow = false
                if (this.seen[pc] != this.generation) {
                    this.seen[pc] = this.generation
                    this.work += 1
                    val op = this.program[pc * 3]
                    if (op == 4) {
                        pc = this.program[pc * 3 + 1]
                        follow = true
                    } else if (op == 3) {
                        this.stackPcs[sp] = this.program[pc * 3 + 2]
                        this.copyEntry(work, stackBase + sp)
                        sp += 1
                        pc = this.program[pc * 3 + 1]
                        follow = true
                    } else if (op == 5) {
                        this.store[work * this.slots + this.program[pc * 3 + 1]] = position
                        pc += 1
                        follow = true
                    } else if (op == 6) {
                        if (this.assertionHolds(this.program[pc * 3 + 1], position)) {
                            pc += 1
                            follow = true
                        }
                    } else {
                        val at = list * this.n + this.counts[list]
                        this.pcs[at] = pc
                        this.copyEntry(work, at)
                        this.counts[list] = this.counts[list] + 1
                    }
                }
            }
        }
    }

    // `add` for a program without capture groups (two slots: the match's start and end). Every thread added from one
    // source shares its start, and a path's end is set by the one `save 1` before the match instruction, so the
    // captures are two scalars and the work stack holds only instruction numbers: no entry is copied.
    fun add2(list: int, pc0: int, start0: int, position: int): void {
        var sp = 1
        this.stackPcs[0] = pc0
        var start = start0
        while (sp > 0) {
            sp -= 1
            var pc = this.stackPcs[sp]
            var end = -1
            var follow = true
            while (follow) {
                follow = false
                if (this.seen[pc] != this.generation) {
                    this.seen[pc] = this.generation
                    this.work += 1
                    val op = this.program[pc * 3]
                    if (op == 4) {
                        pc = this.program[pc * 3 + 1]
                        follow = true
                    } else if (op == 3) {
                        this.stackPcs[sp] = this.program[pc * 3 + 2]
                        sp += 1
                        pc = this.program[pc * 3 + 1]
                        follow = true
                    } else if (op == 5) {
                        if (this.program[pc * 3 + 1] == 0) start = position else end = position
                        pc += 1
                        follow = true
                    } else if (op == 6) {
                        if (this.assertionHolds(this.program[pc * 3 + 1], position)) {
                            pc += 1
                            follow = true
                        }
                    } else {
                        val at = list * this.n + this.counts[list]
                        this.pcs[at] = pc
                        this.store[at * 2] = start
                        this.store[at * 2 + 1] = end
                        this.counts[list] = this.counts[list] + 1
                    }
                }
            }
        }
    }

    // Returns true if the code point matches the indexed character class and its negation rule.
    // Binary search over the class's sorted, disjoint ranges.
    fun classMatches(index: int, c: int): bool {
        val ranges = this.classes[index]
        var low = 0
        var high = ranges.size / 2
        while (low < high) {
            val middle = (low + high) / 2
            if (c < ranges[middle * 2]) high = middle
            else if (c > ranges[middle * 2 + 1]) low = middle + 1
            else return true
        }
        false
    }
}

private fun regexVm(re: Regex, text: string): RegexVm {
    val n = re.program.size / 3
    val slots = (re.groupCount + 1) * 2
    RegexVm(re.program, re.classes, text, n, slots, filledArray(n * 2, 0),
        filledArray((n * 4 + 5) * slots, -1), [0, 0], filledArray(n, 0), 0, filledArray(n + 2, 0), 0)
}

// The width of the code point at `i`; an invalid byte is U+FFFD, one wide.
private fun regexWidth(text: string, i: int): int {
    val length = utf8SequenceLength(text[i])
    if (length > 0 && utf8SequenceValid(text, i, length)) length else 1
}

private fun regexScalar(text: string, i: int, width: int): int =
    if (width == 1 && text[i] >= 128) 65533 else utf8DecodeAt(text, i)

/**
 * Run the program over `text` from byte offset `from`. `anchored` allows a
 * match only to start at `from`, `needEnd` only to end at the text's end, and
 * `advance` refuses an empty match at `from`. Returns the slot array
 * (start, end, group 1 start, ...) with -1 for groups that did not take
 * part, or an empty array when nothing matches.
 */
private fun regexRun(re: Regex, var vm: RegexVm, from: int, anchored: bool, needEnd: bool,
    advance: bool): array<int> {
    // A failed compile's empty Regex has no program: it matches nothing.
    if (re.program.size == 0) return []
    val size = vm.text.size
    var matched = false
    var current = 0
    vm.generation = vm.generation + 1
    vm.counts[0] = 0
    vm.counts[1] = 0
    var i = from
    var running = true
    val skipping = !anchored && re.first.size == 256
    val simple = vm.slots == 2
    while (running) {
        // Nothing is running and no match is pending: the start positions up to the next byte a match can begin with
        // add threads that the next step drops, so they are passed over. Past the last byte nothing can match.
        if (skipping && !matched && vm.counts[current] == 0) {
            i = regexSkipTo(vm.text, re.first, i, size)
            if (i >= size) running = false
        }
        // A start thread at an ASCII byte outside the first-byte set dies at once and no thread behind it is affected.
        if (running && !matched && (!anchored || i == from) &&
            (!skipping || regexStartsAt(vm.text, re.first, i, size))) {
            if (simple) vm.add2(current, 0, -1, i)
            else {
                val start = vm.startEntry()
                for (k in 0 until vm.slots) vm.store[start * vm.slots + k] = -1
                vm.add(current, 0, start, i)
            }
        }
        if (!running || (vm.counts[current] == 0 && (matched || anchored))) {
            running = false
        } else {
            val next = 1 - current
            vm.generation = vm.generation + 1
            vm.counts[next] = 0
            var width = 0
            var scalar = -1
            if (i < size) {
                val byte = vm.text[i]
                // An ASCII byte is one code point of one byte; only the others need the UTF-8 walk.
                if (byte < 128) {
                    width = 1
                    scalar = byte
                } else {
                    width = regexWidth(vm.text, i)
                    scalar = regexScalar(vm.text, i, width)
                }
            }
            var t = 0
            var cut = false
            while (!cut && t < vm.counts[current]) {
                vm.work += 1
                val entry = current * vm.n + t
                val pc = vm.pcs[entry]
                val op = vm.program[pc * 3]
                if (op == 7) {
                    if (!(advance && i == from) && (!needEnd || i == size)) {
                        vm.copyEntry(entry, vm.resultEntry())
                        matched = true
                        cut = true
                    }
                } else if (scalar >= 0) {
                    val x = vm.program[pc * 3 + 1]
                    var hit = false
                    if (op == 0) hit = scalar == x
                    else if (op == 1) hit = scalar != 10
                    else if (op == 2) hit = vm.classMatches(x,
                        scalar) != (vm.program[pc * 3 + 2] == 1)
                    if (hit) {
                        if (simple) vm.add2(next, pc + 1, vm.store[entry * 2], i + width)
                        else vm.add(next, pc + 1, entry, i + width)
                    }
                }
                t += 1
            }
            if (i >= size) {
                running = false
            } else {
                i += width
                current = next
            }
        }
    }
    val result: array<int> = []
    if (matched) {
        val base = vm.resultEntry() * vm.slots
        for (k in 0 until vm.slots) result.append(vm.store[base + k])
    }
    result
}

// The bounded Pike search uses the same program, thread lists and capture slots.
// A negative work count marks exhaustion, even with a tentative match.
private @inline fun RegexVm.searchStep(maximumSteps: int): bool {
    if (this.work == maximumSteps) {
        this.work = -1
        return false
    }
    this.work += 1
    true
}

private @inline fun RegexVm.addBounded(list: int, pc0: int, source: int, position: int,
    maximumSteps: int): bool {
    val stackBase = this.n * 2
    val work = this.workEntry()
    var sp = 1
    this.stackPcs[0] = pc0
    this.copyEntry(source, stackBase)
    while (sp > 0) {
        sp -= 1
        var pc = this.stackPcs[sp]
        this.copyEntry(stackBase + sp, work)
        var follow = true
        while (follow) {
            follow = false
            if (this.seen[pc] != this.generation) {
                this.seen[pc] = this.generation
                if (!this.searchStep(maximumSteps)) return false
                val op = this.program[pc * 3]
                if (op == 4) {
                    pc = this.program[pc * 3 + 1]
                    follow = true
                } else if (op == 3) {
                    this.stackPcs[sp] = this.program[pc * 3 + 2]
                    this.copyEntry(work, stackBase + sp)
                    sp += 1
                    pc = this.program[pc * 3 + 1]
                    follow = true
                } else if (op == 5) {
                    this.store[work * this.slots + this.program[pc * 3 + 1]] = position
                    pc += 1
                    follow = true
                } else if (op == 6) {
                    if (this.assertionHolds(this.program[pc * 3 + 1], position)) {
                        pc += 1
                        follow = true
                    }
                } else {
                    val at = list * this.n + this.counts[list]
                    this.pcs[at] = pc
                    this.copyEntry(work, at)
                    this.counts[list] = this.counts[list] + 1
                }
            }
        }
    }
    true
}

private @inline fun RegexVm.classMatchesBounded(index: int, c: int, maximumSteps: int): bool {
    val ranges = this.classes[index]
    var low = 0
    var high = ranges.size / 2
    var hit = false
    var work = this.work
    while (!hit && low < high) {
        if (work == maximumSteps) {
            work = -1
            break
        }
        work += 1
        val middle = (low + high) / 2
        if (c < ranges[middle * 2]) high = middle
        else if (c > ranges[middle * 2 + 1]) low = middle + 1
        else hit = true
    }
    this.work = work
    hit
}

// `advance` refuses an empty match at `from` (findAllWithin after an empty match). The VM's work count carries over
// from earlier searches on the same VM, so one budget covers them all.
private fun regexRunBounded(var vm: RegexVm, from: int, maximumSteps: int, advance: bool): array<int> {
    val size = vm.text.size
    var matched = false
    var current = 0
    var position = from
    vm.generation += 1
    vm.counts[0] = 0
    vm.counts[1] = 0
    while (!matched || vm.counts[current] != 0) {
        if (!vm.searchStep(maximumSteps)) return []
        if (!matched) {
            val start = vm.startEntry()
            for (slot in 0 until vm.slots) vm.store[start * vm.slots + slot] = -1
            if (!vm.addBounded(current, 0, start, position, maximumSteps)) return []
        }
        val next = 1 - current
        vm.generation += 1
        vm.counts[next] = 0
        val width = if (position < size) regexWidth(vm.text, position) else 0
        val scalar = if (width != 0) regexScalar(vm.text, position, width) else -1
        for (threadIndex in 0 until vm.counts[current]) {
            if (!vm.searchStep(maximumSteps)) return []
            val entry = current * vm.n + threadIndex
            val pc = vm.pcs[entry]
            val op = vm.program[pc * 3]
            if (op == 7) {
                if (advance && position == from) continue
                // Keep only paths ahead of this result in priority order.
                vm.copyEntry(entry, vm.resultEntry())
                matched = true
                break
            }
            if (scalar >= 0) {
                val x = vm.program[pc * 3 + 1]
                var hit = false
                if (op == 0) hit = scalar == x
                else if (op == 1) hit = scalar != 10
                else if (op == 2) {
                    val contains = vm.classMatchesBounded(x, scalar, maximumSteps)
                    if (vm.work < 0) return []
                    hit = contains != (vm.program[pc * 3 + 2] == 1)
                }
                if (hit && !vm.addBounded(next, pc + 1, entry, position + width, maximumSteps)) return []
            }
        }
        if (position == size) break
        position += width
        current = next
    }
    val result: array<int> = []
    if (matched) {
        val base = vm.resultEntry() * vm.slots
        for (slot in 0 until vm.slots) result.append(vm.store[base + slot])
    }
    result
}

private fun regexExpand(m: RegexMatch, replacement: string): string {
    var out = ""
    var i = 0
    while (i < replacement.size) {
        val c = replacement[i]
        if (c != 36 || i + 1 >= replacement.size) {
            out = out + replacement.slice(i, i + 1)
            i += 1
        } else {
            val d = replacement[i + 1]
            if (d == 36) {
                out = out + "$"
                i += 2
            } else {
                var j = i + 1
                var braced = false
                if (d == 123) { braced = true; j += 1 }
                var number = 0
                var digits = 0
                while (j < replacement.size && replacement[j] >= 48 && replacement[j] <= 57) {
                    if (number < 100000) number = number * 10 + replacement[j] - 48
                    j += 1
                    digits += 1
                }
                val closed = !braced || (j < replacement.size && replacement[j] == 125)
                if (digits == 0 || !closed) {
                    out = out + "$"
                    i += 1
                } else {
                    val g = m.group(number)
                    if (g != null) out = out + g
                    i = if (braced) j + 1 else j
                }
            }
        }
    }
    out
}

/**
 * A Shift-And search plan for equal-width ASCII alternatives. Each bit
 * represents one position in an alternative, and the table maps each input
 * byte to the positions it can match. Regex compilation leaves this plan
 * absent when the pattern is ineligible.
 */
class RegexFixedBytes(val width: int, val starts: int, val accepts: int, val masks: string)

// Recognize the emitter's layout for top-level alternatives of consuming
// ASCII instructions. Every branch must have the same nonzero width.
private @noinline fun regexFixedPlan(program: array<int>, classes: array<array<int>>): RegexFixedBytes? {
    val terminal = program.size / 3 - 2
    if (terminal < 3 || terminal > 64) return null
    val positions: array<int> = []
    var width = 0
    var starts = 0
    var accepts = 0
    var branch = 1
    while (branch < terminal) {
        var begin = branch
        var next = terminal
        var end = terminal
        if (program[branch * 3] == 3) {
            begin = program[branch * 3 + 1]
            next = program[branch * 3 + 2]
            if (begin != branch + 1 || next <= begin + 2 || next >= terminal) return null
            end = next - 1
            if (program[end * 3] != 4 || program[end * 3 + 1] != terminal) return null
        }
        val size = end - begin
        if (size < 2 || (width != 0 && size != width) || positions.size + size > 32) return null
        width = size
        starts = starts | (1 << positions.size)
        for (pc in begin until end) {
            val op = program[pc * 3]
            if (op != 0 && op != 2) return null
            if (op == 0 && program[pc * 3 + 1] >= 128) return null
            if (op == 2 && program[pc * 3 + 2] != 0) return null
            positions.append(pc)
        }
        accepts = accepts | (1 << (positions.size - 1))
        branch = next
    }

    val masks = filledArray(128, 0)
    for (index in 0 until positions.size) {
        val bit = 1 << index
        val at = positions[index] * 3
        val value = program[at + 1]
        if (program[at] == 0) masks[value] = masks[value] | bit
        else {
            val ranges = classes[value]
            if (ranges.size > 64) return null
            var pair = 0
            while (pair < ranges.size) {
                if (ranges[pair + 1] >= 128) return null
                for (byte in ranges[pair]..ranges[pair + 1]) masks[byte] = masks[byte] | bit
                pair += 2
            }
        }
    }
    RegexFixedBytes(width, starts, accepts, regexFixedTable(masks))
}

private trusted fun regexFixedTable(masks: array<int>): string {
    val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(1025))
    for (byte in 0 until 256) {
        val mask = if (byte < 128) masks[byte] else 0
        for (offset in 0 until 4) {
            ablaUnsafeStoreU8(nativePointerFromAddress(address + byte * 4 + offset), (mask >> (offset * 8)) & 255)
        }
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(address + 1024), 0)
    adoptNativeString(address, 1024)
}

// The table has four little-endian bytes per input byte. Reading each byte
// separately also permits unaligned storage and native big-endian hosts.
private @inline trusted fun regexFixedMask(address: int): int =
    ablaUnsafeLoadU8(nativePointerFromAddress(address)) |
    (ablaUnsafeLoadU8(nativePointerFromAddress(address + 1)) << 8) |
    (ablaUnsafeLoadU8(nativePointerFromAddress(address + 2)) << 16) |
    (ablaUnsafeLoadU8(nativePointerFromAddress(address + 3)) << 24)

private @noinline trusted fun regexFixedFindEnd(plan: RegexFixedBytes, text: string, start: int): int {
    val masks = plan.masks
    if (masks.size != 1024 || start < 0) return -1
    val table = ablaUnsafeStringAddress(masks)
    val data = ablaUnsafeStringAddress(text)
    val limit = text.size
    val starts = plan.starts
    val accepts = plan.accepts
    var state = 0
    var at = start
    while (at < limit) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + at))
        state = ((state << 1) | starts) & regexFixedMask(table + byte * 4)
        at += 1
        if ((state & accepts) != 0) return at
    }
    -1
}

private @noinline fun regexFixedSpans(plan: RegexFixedBytes, text: string, start: int): array<int> {
    val end = regexFixedFindEnd(plan, text, start)
    if (end < 0) [] else [end - plan.width, end]
}

// Recognize up to four ordered, nonempty ASCII string alternatives. Exiting
// immediately on loops, assertions or classes keeps this work bounded.
private fun regexLiteralGather(program: array<int>, pc: int, prefix: string,
    var choices: array<string>): bool {
    if (pc >= program.size / 3 || prefix.size > 64 || choices.size >= 4) return false
    val at = pc * 3
    val op = program[at]
    val x = program[at + 1]
    val y = program[at + 2]
    if (op == 0 && x < 128)
        return regexLiteralGather(program, pc + 1, prefix + byteEncode(x), choices)
    if (op == 3 && x > pc && y > pc)
        return regexLiteralGather(program, x, prefix, choices) &&
            regexLiteralGather(program, y, prefix, choices)
    if (op == 4 && x > pc) return regexLiteralGather(program, x, prefix, choices)
    if (op == 5) return regexLiteralGather(program, pc + 1, prefix, choices)
    if (op != 7 || prefix == "") return false
    choices.append(prefix)
    true
}

private fun regexLiteralChoices(program: array<int>): array<string> {
    if (program.size > 3 * 64) return []
    val choices: array<string> = []
    if (regexLiteralGather(program, 0, "", choices)) choices else []
}

private fun regexLiteralWhole(choices: array<string>, text: string): bool {
    for (choice in choices) if (text == choice) return true
    false
}

private fun regexLiteralFind(choices: array<string>, text: string, start: int): RegexMatch? {
    if (start == 0) {
        for (choice in choices) {
            if (text.startsWith(choice)) return RegexMatch(text, [0, choice.size])
        }
    }
    var begin = -1
    var end = 0
    for (choice in choices) {
        val at = text.indexOf(choice, start)
        if (at == start) return RegexMatch(text, [start, start + choice.size])
        if (at >= 0 && (begin < 0 || at < begin)) {
            begin = at
            end = at + choice.size
        }
    }
    if (begin >= 0) RegexMatch(text, [begin, end]) else null
}

private @inline fun regexLiteralFindStart(choices: array<string>, text: string, start: int): int {
    if (choices.size == 1) return text.indexOf(choices[0], start)
    if (start == 0) {
        if (text.size == 0) return -1
        val first = text[0]
        for (choice in choices) if (choice[0] == first && text.startsWith(choice)) return 0
    }
    var begin = -1
    for (choice in choices) {
        val at = text.indexOf(choice, start)
        if (at == start) return start
        if (at >= 0 && (begin < 0 || at < begin)) begin = at
    }
    begin
}

// Compile small capture-free literals to a deterministic transition table.
// Bit sets represent consuming program counters and the final match. Groups,
// positional assertions beyond the initial ^, and large automata use the VM.
private fun regexLiteralClosure(program: array<int>, start: int): int {
    val work = [start]
    var cursor = 0
    var seen = 0
    var result = 0
    while (cursor < work.size) {
        val pc = work[cursor]
        cursor += 1
        val bit = 1 << pc
        if ((seen & bit) != 0) continue
        seen = seen | bit
        val at = pc * 3
        val op = program[at]
        if (op == 3) {
            work.append(program[at + 1])
            work.append(program[at + 2])
        } else if (op == 4) work.append(program[at + 1])
        else if (op == 5 || op == 6) work.append(pc + 1)
        else result = result | bit
    }
    result
}

private fun regexLiteralAcceptsScalar(program: array<int>, classes: array<array<int>>,
    pc: int, scalar: int): bool {
    val at = pc * 3
    val op = program[at]
    val x = program[at + 1]
    if (op == 0) return scalar == x
    if (op == 1) return scalar != 10
    op == 2 && regexClassHolds(classes, x, scalar) != (program[at + 2] == 1)
}

// Only collapse non-ASCII input to one column when every non-ASCII scalar
// has identical transitions. A range can change membership at either end.
private fun regexLiteralUniformUnicode(re: Regex): bool {
    val program = re.program
    for (pc in 0 until program.size / 3) {
        val at = pc * 3
        val op = program[at]
        val x = program[at + 1]
        if (op == 0 && x >= 128) return false
        if (op != 2) continue
        val ranges = re.classes[x]
        if (ranges.size > 64) return false
        val expected = regexClassHolds(re.classes, x, 128)
        for (i in 0 until ranges.size) {
            val boundary = ranges[i] + (i & 1)
            if (boundary > 128 && boundary <= 1114111 &&
                regexClassHolds(re.classes, x, boundary) != expected) return false
        }
    }
    true
}

private trusted fun regexLiteralDfa(re: Regex): string {
    val program = re.program
    val n = program.size / 3
    if (n < 3 || n > 32 || !regexLiteralUniformUnicode(re)) return ""
    val startsAtZero = program[3] == 6 && program[4] == 0
    for (pc in 0 until n) {
        if (program[pc * 3] == 6 && !(pc == 1 && startsAtZero)) return ""
    }
    val accepting = 1 << (n - 1)
    val closures: array<int> = []
    for (pc in 0 until n) closures.append(regexLiteralClosure(program, pc))

    val maskForByte: array<int> = []
    for (byte in 0..128) {
        var mask = 0
        for (pc in 0 until n) {
            if (regexLiteralAcceptsScalar(program, re.classes, pc, byte)) mask = mask | (1 << pc)
        }
        maskForByte.append(mask)
    }

    val first = closures[0]
    val states = [0, first]
    val ids: Map<int, int> = Map()
    ids.set(0, 0)
    ids.set(first, 1)
    val rows = byteBuffer()
    var prefixFree = startsAtZero
    var id = 1
    while (id < states.size) {
        val state = states[id]
        val nextIds: Map<int, int> = Map()
        for (mask in maskForByte) {
            val active = mask & state
            var target = nextIds.get(active) ?? -1
            if (target < 0) {
                var reached = 0
                for (pc in 0 until n - 1) {
                    if ((active & (1 << pc)) != 0) reached = reached | closures[pc + 1]
                }
                var next = ids.get(reached) ?? -1
                if (next < 0) {
                    if (states.size > 32) return ""
                    next = states.size
                    states.append(reached)
                    ids.set(reached, next)
                }
                target = next | (if ((reached & accepting) != 0) 64 else 0)
                nextIds.set(active, target)
            }
            // An early accepting transition is safe for find only if there
            // is no alternative consuming path from the accepting state.
            if ((state & accepting) != 0 && active != 0) prefixFree = false
            rows.appendByteValue(target)
        }
        id += 1
    }
    val header = byteBuffer()
    header.appendByteValue(if ((first & accepting) != 0) 65 else 1)
    header.appendByteValue(if (prefixFree) 1 else 0)
    header.appendText(rows.toText())
    header.toText()
}

private @inline fun regexLiteralEnd(table: string, text: string, needEnd: bool): int {
    if (ablaCompileTimeNativeHost()) return regexLiteralNativeEnd(table, text, needEnd)
    if (ablaAtCompileTime()) return regexLiteralInterpretedEnd(table, text, needEnd)
    return regexLiteralNativeEnd(table, text, needEnd)
}

private @inline trusted fun regexLiteralNativeEnd(table: string, text: string, needEnd: bool): int {
    val tableSize = table.size
    if (tableSize < 2) return -1
    val data = ablaUnsafeStringAddress(text)
    val transitions = ablaUnsafeStringAddress(table)
    val length = text.size
    var state = ablaUnsafeLoadU8(nativePointerFromAddress(transitions))
    var cursor = 0
    while (cursor < length && (needEnd || state < 64)) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + cursor))
        val column = if (byte < 128) byte else 128
        val index = 2 + ((state & 63) - 1) * 129 + column
        if (index < 2 || index >= tableSize) return -1
        state = ablaUnsafeLoadU8(nativePointerFromAddress(transitions + index))
        if (state == 0) return -1
        cursor += if (byte < 128) 1 else regexWidth(text, cursor)
    }
    if (state >= 64) cursor else -1
}

private fun regexLiteralInterpretedEnd(table: string, text: string, needEnd: bool): int {
    var state = table[0]
    var cursor = 0
    while (cursor < text.size && (needEnd || state < 64)) {
        val byte = text[cursor]
        val column = if (byte < 128) byte else 128
        state = table[2 + ((state & 63) - 1) * 129 + column]
        if (state == 0) return -1
        cursor += if (byte < 128) 1 else regexWidth(text, cursor)
    }
    if (state >= 64) cursor else -1
}

// Literal compilation shares the runtime parser and limits. The frozen
// matcher carries the program and any bounded specialization.
compile fun ablaRegexSyntaxIntegers(values: array<int>): SyntaxExpression {
    val items: array<SyntaxExpression> = []
    for (value in values) items.append(syntaxInteger(value))
    syntaxArray(items)
}

// Encode module identity and site key separately so no character is lost.
compile fun ablaRegexNamePart(text: string): string {
    val hex = "0123456789abcdef"
    val buffer = byteBuffer()
    for (byte in text) {
        val high = byte / 16
        val low = byte % 16
        buffer.appendText(hex.slice(high, high + 1))
        buffer.appendText(hex.slice(low, low + 1))
    }
    buffer.toText()
}

// Returns the generated capture declaration source for the compiler to publish.
compile fun ablaRegexFinalizeCaptures(source: string, origin: SyntaxExpression): string = source

// Returns syntax that wraps the compiled regex with a generated typed capture projection. Only the stdlib Regex constructor runs at
// compile time; the generated factory is called at run time. Its name is one any module can declare, so a `#` site calling it by
// name could reach a dependency's function of that name with the using file's grants (#1139 area 1, round 5).
compile fun ablaRegexNamedMatcher(cursor: ParserCursor, pattern: SyntaxExpression,
    compiled: RegexCompileResult, constructor: SyntaxExpression): SyntaxExpression {
    val module = ablaRegexNamePart(parserSourceIdentity(cursor))
    val site = ablaRegexNamePart(parserSiteKey(cursor))
    val key = "${module}_$site"
    val shape = "AblaRegexCaptures_$key"
    val factory = "ablaRegexMakeNamed_$key"
    val project = "ablaRegexProject_$key"
    if (compilerFindClass(shape) >= 0 || compilerFindFunction(project) >= 0 ||
        compilerFindFunction(factory) >= 0) {
        parserFail(cursor, "generated regex capture declaration collides with an existing name")
        return syntaxNull()
    }
    val fields = byteBuffer()
    val spans = byteBuffer()
    val projections = byteBuffer()
    var comma = ""
    for (capture in compiled.captureNames) {
        val slot = capture.slot
        val name = capture.name
        spans.appendText("${comma}${capture.begin}, ${capture.end}")
        if (compiled.requiredCaptures[slot]) {
            fields.appendText("${comma}val $name: string")
            projections.appendText("${comma}ablaRegexRequiredCapture(matched, $slot)")
        } else {
            fields.appendText("${comma}val $name: string?")
            projections.appendText("${comma}matched.group($slot)")
        }
        comma = ", "
    }
    val source = "@__ablaDecodedFieldSpans([${spans.toText()}])\nclass $shape(${fields.toText()})\n" +
        "fun $project(matched: RegexMatch): $shape = $shape(${projections.toText()})\n" +
        "fun $factory(regex: Regex): NamedRegex<$shape> = NamedRegex(regex, $project)\n"
    compilerRecordExtensionRequest("abla.regex.$key", source, pattern, ablaRegexFinalizeCaptures)
    syntaxCall(factory, [syntaxCompile(constructor, pattern)])
}

// Returns syntax for a regex literal and records a parser diagnostic for invalid literal or pattern syntax.
compile fun ablaRegexParseLiteral(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val pattern = parserParseAblaExpression(cursor)
    // Skip separators before diagnosing at the still-unconsumed closing token.
    parserAt(cursor, ")")
    if (syntaxKind(pattern) != "string") {
        parserFail(cursor, "expected a plain string literal in \$regex")
        parserExpect(cursor, ")")
        return syntaxNull()
    }
    val compiled = regexCompile(syntaxText(pattern))
    if (!compiled.succeeded) {
        parserFail(cursor,
            "invalid \$regex at pattern byte ${compiled.error.offset}: ${compiled.error.message}")
        parserExpect(cursor, ")")
        return syntaxNull()
    }
    parserExpect(cursor, ")")
    val re = compiled.regex
    val classes: array<SyntaxExpression> = []
    for (ranges in re.classes) classes.append(ablaRegexSyntaxIntegers(ranges))
    val arguments: array<SyntaxExpression> = [
        syntaxString(re.pattern), syntaxInteger(re.groupCount),
        ablaRegexSyntaxIntegers(re.program), syntaxArray(classes), syntaxString(re.first)
    ]
    if (re.groupCount == 0) {
        val choices = regexLiteralChoices(re.program)
        val expressions: array<SyntaxExpression> = []
        for (choice in choices) expressions.append(syntaxString(choice))
        arguments.append(if (choices.size == 0) syntaxNull() else syntaxArray(expressions))
        arguments.append(syntaxString(if (choices.size == 0) regexLiteralDfa(re) else ""))
    }
    val constructor = syntaxCall("Regex", arguments)
    if (compiled.captureNames.size == 0) syntaxCompile(constructor, pattern)
    else ablaRegexNamedMatcher(cursor, pattern, compiled, constructor)
}

// Registers the regex literal syntax, including the typed projection for named capture groups.
#compilerRegisterSubparser("regex", ablaRegexParseLiteral)
