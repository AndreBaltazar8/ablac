// A TLS 1.3 server as a sans-IO state machine (RFC 8446), the counterpart of abla/tls/pure/client: bytes received
// go in with `feed`, bytes to send come out of `takeOutput`, decrypted application data out of
// `takeApplicationData`, and `send`/`close` queue records.
//
// What it does: reads a ClientHello, picks the cipher suite (the server's order), the key-exchange group (X25519,
// P-256: the first of the server's that the client sent a share for, else a single HelloRetryRequest), the
// signature scheme (the identity's, among the client's) and the ALPN protocol, answers with ServerHello,
// EncryptedExtensions, an optional CertificateRequest, Certificate, CertificateVerify and Finished, verifies the
// client's Finished (and, when it asked, its Certificate and CertificateVerify through a configured verifier),
// then carries application data. NewSessionTicket is not sent (no resumption). Refuses a client that does not
// offer TLS 1.3, no common suite, group or signature scheme, a bad Finished, wrong message order, bad records.

import "abla/crypto"
import "abla/crypto/hkdf"
import "abla/tls/pure/client"
import "abla/tls/pure/handshake"
import "abla/tls/pure/keysched"
import "abla/tls/pure/record"
import "abla/tls/pure/tls12"

val TLS_SERVER_WAIT_CLIENT_HELLO = 0
val TLS_SERVER_WAIT_SECOND_HELLO = 1
val TLS_SERVER_WAIT_CERTIFICATE = 2
val TLS_SERVER_WAIT_CERTIFICATE_VERIFY = 3
val TLS_SERVER_WAIT_FINISHED = 4
val TLS_SERVER_CONNECTED = 5
val TLS_SERVER_CLOSED = 6
val TLS_SERVER_FAILED = 7

val TLS_ALERT_NO_APPLICATION_PROTOCOL = 120
val TLS_ALERT_CERTIFICATE_REQUIRED = 116

/** The server's configuration: the identity (certificate chain and signing function), the cipher suites and
 *  groups in the server's order, the ALPN protocols in the server's order ([] for none), a random source, and
 *  whether to ask the client for a certificate (`requestClientCertificate`; `requireClientCertificate` refuses one
 *  that sends none) with `clientVerifier(chain, scheme, signed content, signature)` returning "" for a client it
 *  trusts, else the reason. */
class TlsServerConfig(
    val identity: TlsIdentity,
    val suites: array<int>,
    val groups: array<int>,
    val alpn: array<string>,
    val random: (int) -> string,
    val requestClientCertificate: bool,
    val requireClientCertificate: bool,
    val clientVerifier: (array<string>, int, string, string) -> TlsVerdict,
    /** The TLS 1.2 suites (the modern subset) the server accepts, in its order: [] makes a TLS 1.3-only server. The
     *  suites whose key type does not match the identity are skipped. */
    val suites12: array<int> = [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256, TLS12_ECDHE_RSA_AES_128_GCM_SHA256,
        TLS12_ECDHE_ECDSA_AES_256_GCM_SHA384, TLS12_ECDHE_RSA_AES_256_GCM_SHA384,
        TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256, TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256]
)

class TlsServer(
    val config: TlsServerConfig,
    var state: int,
    var error: string,
    var inbox: string,
    var handshakeBuffer: TlsHandshakeBuffer,
    var outbox: string,
    var applicationData: string,
    val transcript: TlsTranscript,
    var hash: int,
    var suite: int,
    var keyLength: int,
    var aead: int,
    var clientRandom: string,
    var sessionId: string,
    var retried: bool,
    var retryGroup: int,
    var retrySuite: int,
    var readEncrypted: bool,
    var writeEncrypted: bool,
    var read: TlsRecordProtection,
    var write: TlsRecordProtection,
    var handshakeSecret: string,
    var clientHandshakeSecret: string,
    var serverHandshakeSecret: string,
    var clientApplicationSecret: string,
    var serverApplicationSecret: string,
    var clientChain: array<string>,
    var negotiatedAlpn: string,
    var serverName: string,
    var sentCompatibilityChangeCipherSpec: bool,
    var peerClosed: bool,
    var sentClose: bool,
    var clientAuthenticated: bool,
    /** TLS 1.2: set when the ClientHello chose it; the suite, protections, keys, the server's ECDHE pair, the master secret. */
    var v12: bool,
    var v12Suite: int,
    var v12Read: Tls12Protection,
    var v12Write: Tls12Protection,
    var v12Keys: Tls12Keys,
    var v12Pair: TlsKeyPair,
    var serverRandom: string,
    var master: string,
    /** Records in a row that carried nothing (empty application data, ChangeCipherSpec), KeyUpdates in a row, and a
     *  KeyUpdate the peer asked for that is still to be answered (once per batch of input). */
    var emptyRun: int = 0,
    var keyUpdateRun: int = 0,
    var keyUpdateOwed: bool = false
)

private fun tlsServerEmptyProtection(): TlsRecordProtection = tlsRecordProtection(TLS_AEAD_AES_128_GCM, "", "")

/** A TLS 1.3 server connection waiting for its ClientHello. */
fun tlsServerNew(config: TlsServerConfig): TlsServer =
    TlsServer(config, TLS_SERVER_WAIT_CLIENT_HELLO, "", "", TlsHandshakeBuffer([], 0), "", "", tlsTranscript(), HKDF_SHA256, 0, 16,
        TLS_AEAD_AES_128_GCM, "", "", false, 0, 0, false, false, tlsServerEmptyProtection(),
        tlsServerEmptyProtection(), "", "", "", "", "", [], "", "", false, false, false, false, false, 0,
        tls12Protection(tls12Placeholder(), "", ""), tls12Protection(tls12Placeholder(), "", ""), Tls12Keys("", "", "", ""),
        TlsKeyPair(0, "", ""), "", "")

/** The usual configuration: the given identity, AES-GCM and ChaCha20 suites, X25519 then P-256, no ALPN, no client
 *  certificate. */
fun tlsServerConfig(identity: TlsIdentity, random: (int) -> string): TlsServerConfig =
    TlsServerConfig(identity, [TLS_SUITE_AES_128_GCM_SHA256, TLS_SUITE_AES_256_GCM_SHA384,
        TLS_SUITE_CHACHA20_POLY1305_SHA256], [TLS_GROUP_X25519, TLS_GROUP_SECP256R1], [], random, false, false,
        tlsServerRefuseClients)

/** As tlsServerConfig, and asks the client for a certificate that `verifier` (chain, signature scheme, signed content,
 *  signature: "" to accept, else the reason) accepts; `required` refuses a client that sends none. */
fun tlsServerConfigWithClientCertificates(identity: TlsIdentity, random: (int) -> string, required: bool,
    verifier: (array<string>, int, string, string) -> TlsVerdict): TlsServerConfig =
    TlsServerConfig(identity, [TLS_SUITE_AES_128_GCM_SHA256, TLS_SUITE_AES_256_GCM_SHA384,
        TLS_SUITE_CHACHA20_POLY1305_SHA256], [TLS_GROUP_X25519, TLS_GROUP_SECP256R1], [], random, true, required, verifier)

/** The client verifier of a server that asks for no certificate: it trusts none. */
fun tlsServerRefuseClients(chain: array<string>, scheme: int, content: string, signature: string): TlsVerdict =
    tlsRefused(TLS_VERDICT_BAD_CERTIFICATE, "client certificates are not accepted")

fun TlsServer.failed(): bool = this.state == TLS_SERVER_FAILED
fun TlsServer.connected(): bool = this.state == TLS_SERVER_CONNECTED
fun TlsServer.closed(): bool = this.peerClosed

/** The bytes to send to the peer; empties the queue. */
fun TlsServer.takeOutput(): string {
    val data = this.outbox
    this.outbox = ""
    data
}

/** The application data received so far; empties the buffer. */
fun TlsServer.takeApplicationData(): string {
    val data = this.applicationData
    this.applicationData = ""
    data
}

/** The ALPN protocol chosen ("" for none) and the server name the client asked for ("" for none). */
fun TlsServer.alpn(): string = this.negotiatedAlpn
fun TlsServer.serverNameIndication(): string = this.serverName

private fun TlsServer.queueAlert(description: int): void {
    val body = cryptoByteString([if (description == TLS_ALERT_CLOSE_NOTIFY) 1 else 2, description])
    if (this.v12) {
        if (this.writeEncrypted) {
            val sealed = tls12Protect(this.v12Write, TLS_ALERT, body)
            if (sealed.ok) this.outbox = this.outbox + sealed.bytes
        } else {
            this.outbox = this.outbox + tlsPlaintextRecord(TLS_ALERT, 771, body)
        }
        return
    }
    if (this.writeEncrypted) {
        val sealed = tlsProtectRecord(this.write, TLS_ALERT, body)
        if (sealed.ok) this.outbox = this.outbox + sealed.bytes
    } else {
        this.outbox = this.outbox + tlsPlaintextRecord(TLS_ALERT, 771, body)
    }
    return
}

private fun TlsServer.fail(description: int, message: string): void {
    if (this.state == TLS_SERVER_FAILED || this.state == TLS_SERVER_CLOSED) return
    this.queueAlert(description)
    this.state = TLS_SERVER_FAILED
    this.error = message
    return
}

private fun TlsServer.queueRecord(type: int, content: string): void {
    var offset = 0
    while (offset < content.size || offset == 0) {
        val end = if (content.size - offset > TLS_MAX_PLAINTEXT) offset + TLS_MAX_PLAINTEXT else content.size
        val sealed = tlsProtectRecord(this.write, type, content.slice(offset, end))
        if (!sealed.ok) {
            this.fail(TLS_ALERT_INTERNAL_ERROR, sealed.error)
            return
        }
        this.outbox = this.outbox + sealed.bytes
        offset = end
        if (content.size == 0) return
    }
    return
}

private fun TlsServer.setKeys(secret: string, forWrite: bool): void {
    val protection = tlsRecordProtection(this.aead, tlsTrafficKey(this.hash, secret, this.keyLength),
        tlsTrafficIv(this.hash, secret))
    if (forWrite) {
        this.write = protection
        this.writeEncrypted = true
    } else {
        this.read = protection
        this.readEncrypted = true
    }
    return
}

private fun TlsServer.sendCompatibilityChangeCipherSpec(): void {
    if (this.sentCompatibilityChangeCipherSpec) return
    this.sentCompatibilityChangeCipherSpec = true
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(1))
    return
}

private fun tlsServerListHas(list: array<int>, value: int): bool {
    for (item in list) {
        if (item == value) return true
    }
    false
}

private fun tlsServerShareFor(shares: array<TlsKeyShare>, group: int): TlsKeyShare? {
    for (share in shares) {
        if (share.group == group) return share
    }
    null
}

private fun TlsServer.handleClientHello(message: string, body: string): void {
    val hello = tlsParseClientHello(body)
    if (!hello.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, hello.error)
        return
    }
    if (!tlsServerListHas(hello.versions, 772) || this.config.suites.size == 0) {
        // No TLS 1.3 (the client does not offer it, or this server is TLS 1.2 only): a TLS 1.2 client (supported_versions absent or listing 3.3, legacy_version 3.3 or more).
        if (this.config.suites12.size > 0 && this.state == TLS_SERVER_WAIT_CLIENT_HELLO && hello.legacyVersion >= 771 &&
            (hello.versions.size == 0 || tlsServerListHas(hello.versions, 771))) {
            this.startV12(message, hello)
        } else {
            this.fail(TLS_ALERT_PROTOCOL_VERSION, "tls: the client does not offer TLS 1.3")
        }
        return
    }
    if (this.retried && (hello.random != this.clientRandom || hello.sessionId != this.sessionId)) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the second ClientHello changed its random or session id")
        return
    }
    // The cipher suite: the server's first that the client offers.
    var suite = 0
    for (candidate in this.config.suites) {
        if (suite == 0 && tlsServerListHas(hello.suites, candidate) && tlsAeadFor(candidate) != 0) suite = candidate
    }
    if (suite == 0) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: no cipher suite in common")
        return
    }
    if (this.retried && suite != this.retrySuite) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the cipher suite changed after HelloRetryRequest")
        return
    }
    // The signature scheme: the identity's first that the client accepts.
    var scheme = 0
    for (candidate in this.config.identity.schemes) {
        if (scheme == 0 && tlsServerListHas(hello.schemes, candidate) && !tlsSchemeIsPkcs1(candidate)) scheme = candidate
    }
    if (scheme == 0 || this.config.identity.chain.size == 0) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: no signature scheme in common")
        return
    }
    // The ALPN protocol: the server's first that the client lists; none in common is fatal.
    var alpn = ""
    if (hello.alpn.size > 0 && this.config.alpn.size > 0) {
        for (candidate in this.config.alpn) {
            var listed = false
            for (offered in hello.alpn) {
                if (offered == candidate) listed = true
            }
            if (alpn == "" && listed) alpn = candidate
        }
        if (alpn == "") {
            this.fail(TLS_ALERT_NO_APPLICATION_PROTOCOL, "tls: no application protocol in common")
            return
        }
    }
    // RFC 8446 section 4.2.8: a TLS 1.3 ClientHello without key_share is missing an extension (an empty list asks for a
    // HelloRetryRequest), and a group may have one share only.
    if (!hello.hasKeyShare) {
        this.fail(TLS_ALERT_MISSING_EXTENSION, "tls: the ClientHello has no key_share")
        return
    }
    for (i in 0 until hello.shares.size) {
        for (j in 0 until i) {
            if (hello.shares[i].group == hello.shares[j].group) {
                this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: two key shares for one group")
                return
            }
        }
    }
    // The group: the server's first that the client has a share for, else retry on its first common group.
    var chosen: TlsKeyShare? = null
    var retryGroup = 0
    for (group in this.config.groups) {
        if (chosen == null && tlsServerListHas(hello.groups, group)) {
            val share = tlsServerShareFor(hello.shares, group)
            if (share != null) chosen = share
            else if (retryGroup == 0) retryGroup = group
        }
    }
    this.hash = tlsSuiteHash(suite)
    this.aead = tlsAeadFor(suite)
    this.keyLength = tlsAeadKeyLength(this.aead)
    this.suite = suite
    if (chosen == null) {
        if (retryGroup == 0 || this.retried) {
            this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: no key exchange group in common")
            return
        }
        // HelloRetryRequest: the transcript restarts with a synthetic message_hash of this ClientHello.
        this.clientRandom = hello.random
        this.sessionId = hello.sessionId
        this.retried = true
        this.retryGroup = retryGroup
        this.retrySuite = suite
        this.transcript.messages = tlsHandshakeMessage(TLS_MESSAGE_HASH, tlsHashOf(this.hash, message))
        val request = tlsBuildHelloRetryRequest(hello.sessionId, suite, retryGroup, "")
        this.transcript.add(request)
        this.outbox = this.outbox + tlsPlaintextRecord(TLS_HANDSHAKE, 771, request)
        this.sendCompatibilityChangeCipherSpec()
        this.state = TLS_SERVER_WAIT_SECOND_HELLO
        return
    }
    val selected = chosen ?? return
    val pair = tlsGenerateKeyPair(selected.group, this.config.random)
    if (pair == null) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the server could not make a key share")
        return
    }
    val shared = tlsAgree(pair, selected.publicKey)
    if (!shared.ok) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the client's key share is not valid")
        return
    }
    this.clientRandom = hello.random
    this.sessionId = hello.sessionId
    this.serverName = hello.serverName
    this.negotiatedAlpn = alpn
    this.transcript.add(message)
    // ServerHello (plaintext), then the key schedule and the encrypted flight.
    val serverHello = tlsBuildServerHello(this.config.random(32), hello.sessionId, suite,
        TlsKeyShare(pair.group, pair.publicKey))
    this.transcript.add(serverHello)
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_HANDSHAKE, 771, serverHello)
    this.sendCompatibilityChangeCipherSpec()
    val early = tlsEarlySecret(this.hash, "")
    val secrets = tlsDeriveHandshakeSecrets(this.hash, early, shared.bytes, this.transcript.hash(this.hash))
    this.handshakeSecret = secrets.handshakeSecret
    this.clientHandshakeSecret = secrets.clientTraffic
    this.serverHandshakeSecret = secrets.serverTraffic
    this.setKeys(secrets.serverTraffic, true)
    this.setKeys(secrets.clientTraffic, false)
    this.sendFlight(scheme)
    return
}

private fun TlsServer.sendFlight(scheme: int): void {
    var flight = tlsBuildEncryptedExtensions(this.negotiatedAlpn)
    this.transcript.add(flight)
    if (this.config.requestClientCertificate) {
        val request = tlsBuildCertificateRequest("", [TLS_SIG_ECDSA_SECP256R1_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA256,
            TLS_SIG_RSA_PSS_RSAE_SHA384, TLS_SIG_RSA_PSS_RSAE_SHA512, TLS_SIG_ED25519, TLS_SIG_ECDSA_SECP384R1_SHA384])
        this.transcript.add(request)
        flight = flight + request
    }
    val certificate = tlsBuildCertificate("", this.config.identity.chain)
    this.transcript.add(certificate)
    val content = tlsCertificateVerifyContent(true, this.transcript.hash(this.hash))
    val signature = this.config.identity.sign(scheme, content)
    if (signature.size == 0) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the server certificate's key could not sign")
        return
    }
    val verify = tlsBuildCertificateVerify(scheme, signature)
    this.transcript.add(verify)
    val finished = tlsHandshakeMessage(TLS_FINISHED,
        tlsFinishedVerifyData(this.hash, this.serverHandshakeSecret, this.transcript.hash(this.hash)))
    this.transcript.add(finished)
    this.queueRecord(TLS_HANDSHAKE, flight + certificate + verify + finished)
    // Application keys: derived through the server's Finished; the server may write under them at once, and
    // reads the client's last flight under the handshake keys until its Finished arrives.
    val application = tlsDeriveApplicationSecrets(this.hash, this.handshakeSecret, this.transcript.hash(this.hash))
    this.clientApplicationSecret = application.clientTraffic
    this.serverApplicationSecret = application.serverTraffic
    this.setKeys(application.serverTraffic, true)
    this.state = if (this.config.requestClientCertificate) TLS_SERVER_WAIT_CERTIFICATE else TLS_SERVER_WAIT_FINISHED
    return
}

private fun TlsServer.handleClientCertificate(message: string, body: string): void {
    val parsed = tlsParseCertificate(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, parsed.error)
        return
    }
    if (parsed.context.size != 0) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the client's Certificate echoes another request context")
        return
    }
    this.transcript.add(message)
    if (parsed.chain.size == 0) {
        if (this.config.requireClientCertificate) {
            this.fail(TLS_ALERT_CERTIFICATE_REQUIRED, "tls: the client sent no certificate")
            return
        }
        this.state = TLS_SERVER_WAIT_FINISHED
        return
    }
    this.clientChain = parsed.chain
    this.state = TLS_SERVER_WAIT_CERTIFICATE_VERIFY
    return
}

private fun TlsServer.handleClientCertificateVerify(message: string, body: string): void {
    val parsed = tlsParseCertificateVerify(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: malformed CertificateVerify")
        return
    }
    val content = tlsCertificateVerifyContent(false, this.transcript.hash(this.hash))
    val verdict = this.config.clientVerifier(this.clientChain, parsed.scheme, content, parsed.signature)
    if (!verdict.accepted()) {
        this.fail(verdict.alert, verdict.text)
        return
    }
    this.clientAuthenticated = true
    this.transcript.add(message)
    this.state = TLS_SERVER_WAIT_FINISHED
    return
}

private fun TlsServer.handleClientFinished(message: string, body: string): void {
    if (body.size != tlsHashLength(this.hash)) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a Finished of the wrong length")
        return
    }
    val expected = tlsFinishedVerifyData(this.hash, this.clientHandshakeSecret, this.transcript.hash(this.hash))
    if (!constantTimeEquals(expected, body)) {
        this.fail(TLS_ALERT_DECRYPT_ERROR, "tls: the client's Finished does not verify")
        return
    }
    if (!this.handshakeBuffer.empty()) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: data after the client's Finished in its record")
        return
    }
    this.transcript.add(message)
    this.setKeys(this.clientApplicationSecret, false)
    this.state = TLS_SERVER_CONNECTED
    return
}

private fun TlsServer.handleKeyUpdate(body: string): void {
    if (body.size != 1 || body[0] > 1) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed KeyUpdate")
        return
    }
    this.keyUpdateRun = this.keyUpdateRun + 1
    if (this.keyUpdateRun > TLS_MAX_EMPTY_RUN) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many KeyUpdates in a row")
        return
    }
    this.clientApplicationSecret = tlsNextTrafficSecret(this.hash, this.clientApplicationSecret)
    this.setKeys(this.clientApplicationSecret, false)
    // One answer for a batch of requests: it goes out before the next application data (section 4.6.3).
    if (body[0] == 1) this.keyUpdateOwed = true
    return
}

private fun TlsServer.answerKeyUpdate(): void {
    if (!this.keyUpdateOwed || this.state != TLS_SERVER_CONNECTED) return
    this.keyUpdateOwed = false
    this.queueRecord(TLS_HANDSHAKE, tlsHandshakeMessage(TLS_KEY_UPDATE, tlsU8(0)))
    this.serverApplicationSecret = tlsNextTrafficSecret(this.hash, this.serverApplicationSecret)
    this.setKeys(this.serverApplicationSecret, true)
    return
}

private fun TlsServer.handleMessage(type: int, message: string, body: string): void {
    if (this.state == TLS_SERVER_WAIT_CLIENT_HELLO || this.state == TLS_SERVER_WAIT_SECOND_HELLO) {
        if (type == TLS_CLIENT_HELLO) this.handleClientHello(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a ClientHello")
    } else if (this.state == TLS_SERVER_WAIT_CERTIFICATE) {
        if (type == TLS_CERTIFICATE) this.handleClientCertificate(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected the client's Certificate")
    } else if (this.state == TLS_SERVER_WAIT_CERTIFICATE_VERIFY) {
        if (type == TLS_CERTIFICATE_VERIFY) this.handleClientCertificateVerify(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected the client's CertificateVerify")
    } else if (this.state == TLS_SERVER_WAIT_FINISHED) {
        if (type == TLS_FINISHED) this.handleClientFinished(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected the client's Finished")
    } else if (this.state == TLS_SERVER_CONNECTED) {
        if (type == TLS_KEY_UPDATE) this.handleKeyUpdate(body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected handshake message")
    }
    return
}

private fun TlsServer.processHandshake(): void {
    while (this.state != TLS_SERVER_FAILED && this.state != TLS_SERVER_CLOSED) {
        val header = this.handshakeBuffer.header()
        // The cap is checked at the header, before the body is buffered (a peer not yet authenticated).
        if (header.bodyLength > tlsMessageLimit(header.type)) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a handshake message longer than allowed")
            return
        }
        if (!header.complete) return
        val message = this.handshakeBuffer.take(header.total)
        this.handleMessage(header.type, message, message.slice(4, message.size))
        // Nothing may follow a ClientHello until the server has answered it: handshake data after it (a partial
        // Finished or ClientKeyExchange, TLS 1.3 or 1.2) is refused.
        if (!this.handshakeBuffer.empty() && header.type == TLS_CLIENT_HELLO) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: handshake data after the ClientHello in its record")
            return
        }
    }
    return
}

private fun TlsServer.handleAlert(content: string): void {
    if (content.size != 2) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed alert")
        return
    }
    if (content[1] == TLS_ALERT_CLOSE_NOTIFY) {
        this.peerClosed = true
        if (!this.sentClose) this.queueAlert(TLS_ALERT_CLOSE_NOTIFY)
        this.sentClose = true
        this.state = TLS_SERVER_CLOSED
        return
    }
    this.state = TLS_SERVER_FAILED
    this.error = "tls: the client sent alert ${content[1]}"
    return
}

private fun TlsServer.handleRecord(record: string, header: TlsRecordHeader): void {
    if (this.v12) {
        this.handleRecord12(record, header)
        return
    }
    if (header.type == TLS_CHANGE_CIPHER_SPEC) {
        // Compatibility mode: one 0x01 byte, ignored, once a ClientHello has been answered.
        this.emptyRun = this.emptyRun + 1
        if (this.emptyRun > TLS_MAX_EMPTY_RUN) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many empty records")
            return
        }
        if (this.state == TLS_SERVER_CONNECTED || record.size != 6 || record[5] != 1 ||
            (this.state == TLS_SERVER_WAIT_CLIENT_HELLO && !this.retried)) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected ChangeCipherSpec")
        }
        return
    }
    var type = header.type
    var content = ""
    if (this.readEncrypted) {
        if (header.type != TLS_APPLICATION_DATA) {
            this.fail(TLS_ALERT_BAD_RECORD_MAC, "tls: an unprotected record after the keys were set")
            return
        }
        val opened = tlsOpenRecord(this.read, record)
        if (!opened.ok) {
            this.fail(if (opened.error == "tls: record overflow") TLS_ALERT_RECORD_OVERFLOW else TLS_ALERT_BAD_RECORD_MAC,
                opened.error)
            return
        }
        type = opened.type
        content = opened.content
    } else {
        if (header.length > TLS_MAX_PLAINTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        content = record.slice(5, record.size)
    }
    if (content.size == 0) {
        // An empty record carries nothing: a run of them is refused (as BoringSSL does, 32 in a row).
        this.emptyRun = this.emptyRun + 1
        if (this.emptyRun > TLS_MAX_EMPTY_RUN) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many empty records")
            return
        }
    } else {
        this.emptyRun = 0
        if (type == TLS_APPLICATION_DATA) this.keyUpdateRun = 0
    }
    if (type == TLS_HANDSHAKE) {
        if (content.size == 0) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an empty handshake record")
            return
        }
        this.handshakeBuffer.add(content)
        this.processHandshake()
    } else if (type == TLS_ALERT) {
        this.handleAlert(content)
    } else if (type == TLS_APPLICATION_DATA && this.readEncrypted && this.state == TLS_SERVER_CONNECTED) {
        this.applicationData = this.applicationData + content
    } else {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected record type $type")
    }
    return
}

/** Feeds bytes received from the peer: every complete record in them is processed. */
fun TlsServer.feed(data: string): void {
    if (this.state == TLS_SERVER_FAILED || this.state == TLS_SERVER_CLOSED) return
    this.inbox = this.inbox + data
    while (this.state != TLS_SERVER_FAILED && this.state != TLS_SERVER_CLOSED) {
        val header = tlsParseRecordHeader(this.inbox, 0)
        if (!header.ok) return
        if (header.length > TLS_MAX_CIPHERTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        if (this.inbox.size < 5 + header.length) return
        val record = this.inbox.slice(0, 5 + header.length)
        this.inbox = this.inbox.slice(5 + header.length, this.inbox.size)
        this.handleRecord(record, header)
    }
    return
}

/** Queues application data (any length) as records. False when the connection is not open. The server may
 *  write as soon as its own Finished is out; the client has not authenticated itself until `connected()`. */
fun TlsServer.send(data: string): bool {
    if (this.state != TLS_SERVER_CONNECTED) return false
    if (this.v12) return this.send12(data)
    // RFC 8446 section 4.6.3: the answer to the KeyUpdates received (one for the batch) goes out before the next
    // application data.
    this.answerKeyUpdate()
    var offset = 0
    while (offset < data.size && this.state == TLS_SERVER_CONNECTED) {
        val end = if (data.size - offset > TLS_MAX_PLAINTEXT) offset + TLS_MAX_PLAINTEXT else data.size
        this.queueRecord(TLS_APPLICATION_DATA, data.slice(offset, end))
        offset = end
    }
    this.state == TLS_SERVER_CONNECTED
}

/** Queues close_notify; the connection takes no more application data. */
fun TlsServer.close(): void {
    if (this.state == TLS_SERVER_CONNECTED && !this.sentClose) {
        this.queueAlert(TLS_ALERT_CLOSE_NOTIFY)
        this.sentClose = true
        this.state = TLS_SERVER_CLOSED
    }
    return
}

/** True when the client presented a certificate that the configured verifier accepted. */
fun TlsServer.clientCertificateVerified(): bool = this.clientAuthenticated

// ---- TLS 1.2 (the modern subset) ----
// ClientHello without TLS 1.3 -> ServerHello, Certificate, ServerKeyExchange (ECDHE, signed with the identity),
// [CertificateRequest], ServerHelloDone; then the client's [Certificate], ClientKeyExchange, [CertificateVerify],
// ChangeCipherSpec, Finished; then the server's ChangeCipherSpec and Finished. The extended master secret is required.
val TLS_SERVER12_WAIT_CERTIFICATE = 20
val TLS_SERVER12_WAIT_KEY_EXCHANGE = 21
val TLS_SERVER12_WAIT_CERTIFICATE_VERIFY = 22
val TLS_SERVER12_WAIT_CHANGE_CIPHER_SPEC = 23
val TLS_SERVER12_WAIT_FINISHED = 24

// An identity signs with schemes of its key type only (a narrowed list still names the type): any RSA scheme means an RSA key.
private fun tlsServerKeyIsRsa(identity: TlsIdentity): bool {
    for (scheme in identity.schemes) {
        if (scheme == TLS_SIG_RSA_PSS_RSAE_SHA256 || scheme == TLS_SIG_RSA_PSS_RSAE_SHA384 ||
            scheme == TLS_SIG_RSA_PSS_RSAE_SHA512 || tlsSchemeIsPkcs1(scheme)) return true
    }
    false
}

private fun TlsServer.startV12(message: string, hello: TlsClientHello): void {
    if (!hello.extendedMasterSecret || !hello.secureRenegotiation) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: the client does not support the extended master secret")
        return
    }
    // The suite: the server's first that the client offers and whose key type matches the identity.
    val rsa = tlsServerKeyIsRsa(this.config.identity)
    var suite: Tls12Suite? = null
    for (code in this.config.suites12) {
        val candidate = tls12Suite(code)
        if (suite == null && candidate != null && candidate.ecdsa != rsa && tlsServerListHas(hello.suites, code)) {
            suite = candidate
        }
    }
    if (suite == null) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: no cipher suite in common")
        return
    }
    val chosen = suite ?? return
    // The group (the client's list, which TLS 1.2 requires for ECDHE) and the signature scheme.
    var group = 0
    for (candidate in this.config.groups) {
        if (group == 0 && tlsServerListHas(hello.groups, candidate)) group = candidate
    }
    var scheme = 0
    for (candidate in this.config.identity.schemes) {
        if (scheme == 0 && tlsServerListHas(hello.schemes, candidate)) scheme = candidate
    }
    if (group == 0 || scheme == 0 || this.config.identity.chain.size == 0) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: no key exchange group or signature scheme in common")
        return
    }
    var alpn = ""
    if (hello.alpn.size > 0 && this.config.alpn.size > 0) {
        for (candidate in this.config.alpn) {
            var listed = false
            for (offered in hello.alpn) {
                if (offered == candidate) listed = true
            }
            if (alpn == "" && listed) alpn = candidate
        }
        if (alpn == "") {
            this.fail(TLS_ALERT_NO_APPLICATION_PROTOCOL, "tls: no application protocol in common")
            return
        }
    }
    val pair = tlsGenerateKeyPair(group, this.config.random)
    if (pair == null) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the server could not make a key share")
        return
    }
    this.v12 = true
    this.v12Suite = chosen.code
    this.hash = chosen.hash
    this.v12Pair = pair
    this.clientRandom = hello.random
    this.sessionId = hello.sessionId
    this.serverName = hello.serverName
    this.negotiatedAlpn = alpn
    this.serverRandom = this.config.random(32)
    // A TLS 1.3-capable server that negotiates TLS 1.2 says so in its random (RFC 8446 section 4.1.3).
    if (this.config.suites.size > 0) this.serverRandom = this.serverRandom.slice(0, 24) + "DOWNGRD" + tlsU8(1)
    this.transcript.add(message)
    // ServerHello (with the ALPN choice, if any), Certificate, ServerKeyExchange, [CertificateRequest], ServerHelloDone.
    var serverHello = tls12BuildServerHello(this.serverRandom, "", chosen.code)
    if (alpn.size > 0) {
        serverHello = tlsHandshakeMessage(TLS_SERVER_HELLO, tlsU16(771) + this.serverRandom + tlsVec8("") + tlsU16(chosen.code) +
            tlsU8(0) + tlsVec16(tlsExtension(TLS_EXT_RENEGOTIATION_INFO, tlsU8(0)) +
            tlsExtension(TLS_EXT_EXTENDED_MASTER_SECRET, "") + tlsExtension(TLS_EXT_ALPN, tlsVec16(tlsVec8(alpn)))))
    }
    this.transcript.add(serverHello)
    val certificate = tls12BuildCertificate(this.config.identity.chain)
    this.transcript.add(certificate)
    val params = tls12EcdheParams(pair.group, pair.publicKey)
    val signature = this.config.identity.sign(scheme, tls12SignedParams(hello.random, this.serverRandom, params))
    if (signature.size == 0) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the server certificate's key could not sign")
        return
    }
    val keyExchange = tls12BuildServerKeyExchange(pair.group, pair.publicKey, scheme, signature)
    this.transcript.add(keyExchange)
    var flight = serverHello + certificate + keyExchange
    if (this.config.requestClientCertificate) {
        val request = tls12BuildCertificateRequest([TLS_SIG_ECDSA_SECP256R1_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA256,
            TLS_SIG_RSA_PSS_RSAE_SHA384, TLS_SIG_RSA_PSS_RSAE_SHA512, TLS_SIG_ED25519, TLS_SIG_RSA_PKCS1_SHA256])
        this.transcript.add(request)
        flight = flight + request
    }
    val done = tls12BuildServerHelloDone()
    this.transcript.add(done)
    flight = flight + done
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_HANDSHAKE, 771, flight)
    this.state = if (this.config.requestClientCertificate) TLS_SERVER12_WAIT_CERTIFICATE else TLS_SERVER12_WAIT_KEY_EXCHANGE
    return
}

private fun TlsServer.queueRecord12(type: int, content: string): void {
    val sealed = tls12Protect(this.v12Write, type, content)
    if (!sealed.ok) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, sealed.error)
        return
    }
    this.outbox = this.outbox + sealed.bytes
    return
}

private fun TlsServer.handleClientCertificate12(message: string, body: string): void {
    val parsed = tls12ParseCertificate(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, parsed.error)
        return
    }
    this.transcript.add(message)
    if (parsed.chain.size == 0) {
        if (this.config.requireClientCertificate) {
            this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: the client sent no certificate")
            return
        }
        this.state = TLS_SERVER12_WAIT_KEY_EXCHANGE
        return
    }
    this.clientChain = parsed.chain
    this.state = TLS_SERVER12_WAIT_KEY_EXCHANGE
    return
}

private fun TlsServer.handleClientKeyExchange12(message: string, body: string): void {
    val suite = tls12Suite(this.v12Suite)
    val point = tls12ParseClientKeyExchange(body)
    if (suite == null || point.size == 0) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed ClientKeyExchange")
        return
    }
    val shared = tlsAgree(this.v12Pair, point)
    if (!shared.ok) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the client's key share is not valid")
        return
    }
    this.transcript.add(message)
    // The extended master secret: the session hash is through the ClientKeyExchange.
    this.master = tls12MasterSecret(suite.hash, shared.bytes, this.transcript.hash(suite.hash))
    this.v12Keys = tls12DeriveKeys(suite, this.master, this.serverRandom, this.clientRandom)
    // With a client certificate, its CertificateVerify comes next; without, the ChangeCipherSpec.
    this.state = if (this.clientChain.size > 0) TLS_SERVER12_WAIT_CERTIFICATE_VERIFY else TLS_SERVER12_WAIT_CHANGE_CIPHER_SPEC
    return
}

private fun TlsServer.handleClientCertificateVerify12(message: string, body: string): void {
    val parsed = tlsParseCertificateVerify(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: malformed CertificateVerify")
        return
    }
    // The signature covers every handshake message before this one.
    val verdict = this.config.clientVerifier(this.clientChain, parsed.scheme + TLS_SIGNATURE_TLS12, this.transcript.messages,
        parsed.signature)
    if (!verdict.accepted()) {
        this.fail(verdict.alert, verdict.text)
        return
    }
    this.clientAuthenticated = true
    this.transcript.add(message)
    this.state = TLS_SERVER12_WAIT_CHANGE_CIPHER_SPEC
    return
}

private fun TlsServer.handleClientFinished12(message: string, body: string): void {
    if (body.size != 12) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a Finished of the wrong length")
        return
    }
    val expected = tls12FinishedData(this.hash, this.master, "client finished", this.transcript.hash(this.hash))
    if (!constantTimeEquals(expected, body)) {
        this.fail(TLS_ALERT_DECRYPT_ERROR, "tls: the client's Finished does not verify")
        return
    }
    if (!this.handshakeBuffer.empty()) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: data after the client's Finished in its record")
        return
    }
    this.transcript.add(message)
    // The server's ChangeCipherSpec and its Finished under the server keys.
    val suite = tls12Suite(this.v12Suite) ?? return
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(1))
    this.v12Write = tls12Protection(suite, this.v12Keys.serverKey, this.v12Keys.serverIv)
    this.writeEncrypted = true
    this.queueRecord12(TLS_HANDSHAKE, tlsHandshakeMessage(TLS_FINISHED,
        tls12FinishedData(this.hash, this.master, "server finished", this.transcript.hash(this.hash))))
    this.state = TLS_SERVER_CONNECTED
    return
}

private fun TlsServer.handleMessage12(type: int, message: string, body: string): void {
    if (this.state == TLS_SERVER12_WAIT_CERTIFICATE) {
        if (type == TLS_CERTIFICATE) this.handleClientCertificate12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected the client's Certificate")
    } else if (this.state == TLS_SERVER12_WAIT_KEY_EXCHANGE) {
        if (type == TLS12_CLIENT_KEY_EXCHANGE) this.handleClientKeyExchange12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected the client's ClientKeyExchange")
    } else if (this.state == TLS_SERVER12_WAIT_CERTIFICATE_VERIFY) {
        if (type == TLS_CERTIFICATE_VERIFY) this.handleClientCertificateVerify12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected the client's CertificateVerify")
    } else if (this.state == TLS_SERVER12_WAIT_FINISHED) {
        if (type == TLS_FINISHED) this.handleClientFinished12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected the client's Finished")
    } else {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected handshake message")
    }
    return
}

private fun TlsServer.processHandshake12(): void {
    while (this.state != TLS_SERVER_FAILED && this.state != TLS_SERVER_CLOSED) {
        val header = this.handshakeBuffer.header()
        // The cap is checked at the header, before the body is buffered (a peer not yet authenticated).
        if (header.bodyLength > tlsMessageLimit(header.type)) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a handshake message longer than allowed")
            return
        }
        if (!header.complete) return
        val message = this.handshakeBuffer.take(header.total)
        this.handleMessage12(header.type, message, message.slice(4, message.size))
    }
    return
}

private fun TlsServer.handleRecord12(record: string, header: TlsRecordHeader): void {
    if (header.type == TLS_CHANGE_CIPHER_SPEC) {
        if (this.state != TLS_SERVER12_WAIT_CHANGE_CIPHER_SPEC || record.size != 6 || record[5] != 1 ||
            !this.handshakeBuffer.empty()) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected ChangeCipherSpec")
            return
        }
        val suite = tls12Suite(this.v12Suite) ?? return
        this.v12Read = tls12Protection(suite, this.v12Keys.clientKey, this.v12Keys.clientIv)
        this.readEncrypted = true
        this.state = TLS_SERVER12_WAIT_FINISHED
        return
    }
    var type = header.type
    var content = ""
    if (this.readEncrypted) {
        val opened = tls12Open(this.v12Read, record)
        if (!opened.ok) {
            this.fail(if (opened.error == "tls: record overflow") TLS_ALERT_RECORD_OVERFLOW else TLS_ALERT_BAD_RECORD_MAC,
                opened.error)
            return
        }
        type = opened.type
        content = opened.content
    } else {
        if (header.length > TLS_MAX_PLAINTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        content = record.slice(5, record.size)
    }
    if (type == TLS_HANDSHAKE) {
        if (content.size == 0) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an empty handshake record")
            return
        }
        this.handshakeBuffer.add(content)
        this.processHandshake12()
    } else if (type == TLS_ALERT) {
        this.handleAlert(content)
    } else if (type == TLS_APPLICATION_DATA && this.readEncrypted && this.state == TLS_SERVER_CONNECTED) {
        this.applicationData = this.applicationData + content
    } else {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected record type $type")
    }
    return
}

private fun TlsServer.send12(data: string): bool {
    var offset = 0
    while (offset < data.size && this.state == TLS_SERVER_CONNECTED) {
        val end = if (data.size - offset > TLS12_MAX_PLAINTEXT) offset + TLS12_MAX_PLAINTEXT else data.size
        this.queueRecord12(TLS_APPLICATION_DATA, data.slice(offset, end))
        offset = end
    }
    this.state == TLS_SERVER_CONNECTED
}
