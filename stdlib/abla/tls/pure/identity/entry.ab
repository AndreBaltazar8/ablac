// A TLS client identity (a certificate chain and its private key) for mutual TLS, from PEM: the certificates
// leaf first (then any intermediates), and the key as PKCS#8 (RSA, ECDSA P-256 or Ed25519), PKCS#1 (RSA), SEC1 (ECDSA
// P-256) or encrypted PKCS#8 (PBES2) with a passphrase. The key must belong to the first certificate. The
// signing function (abla/tls/pure/client's TlsIdentity.sign) re-reads the key bytes on each call and keeps
// no key object alive, so an identity is plain data. The key bytes it reads are the identity's `secrets`, which
// TlsIdentity.wipe clears; a key that does not load is cleared at once.

import "abla/crypto"
import "abla/crypto/der"
import "abla/crypto/ed25519"
import "abla/crypto/p256"
import "abla/crypto/p384"
import "abla/crypto/pbe"
import "abla/crypto/result"
import "abla/crypto/rsa"
import "abla/crypto/rsapss"
import "abla/crypto/x509"
import "abla/tls/pure/client"
import "abla/tls/pure/handshake"
import "abla/tls/pure/keysched"
import "abla/tls/pure/tls12"

private fun tlsIdentityFailed(error: string): TlsIdentity =
    TlsIdentity([], [], tlsNoSignature, error)

private fun tlsNoSignature(scheme: int, content: string): string = ""

private fun tlsPadLeft(value: string, size: int): string {
    if (value.size >= size) return value.slice(value.size - size, value.size)
    val bytes: array<int> = []
    while (bytes.size < size - value.size) bytes.append(0)
    cryptoByteString(bytes) + value
}

// ---- the three key kinds as signing functions over plain data ----
private fun tlsRsaSigner(der: string): (int, string) -> string =
    { scheme: int, content: string ->
        val key = rsaPrivateKeyFromDer(der)
        val bits = if (scheme == TLS_SIG_RSA_PSS_RSAE_SHA256) 256 else if (scheme == TLS_SIG_RSA_PSS_RSAE_SHA384) 384
            else if (scheme == TLS_SIG_RSA_PSS_RSAE_SHA512) 512 else 0
        if (!key.ok()) "" else if (scheme == TLS_SIG_RSA_PKCS1_SHA256) {
            val signature = rsaSignWith(key, TLS_DIGEST_INFO_SHA256, sha256(content))
            if (signature.ok) signature.bytes else ""
        } else if (scheme == TLS_SIG_RSA_PKCS1_SHA384) {
            val signature = rsaSignWith(key, TLS_DIGEST_INFO_SHA384, sha384(content))
            if (signature.ok) signature.bytes else ""
        } else if (scheme == TLS_SIG_RSA_PKCS1_SHA512) {
            val signature = rsaSignWith(key, TLS_DIGEST_INFO_SHA512, sha512(content))
            if (signature.ok) signature.bytes else ""
        } else if (bits == 0) "" else {
            val signature = rsaPssSign(key, bits, content)
            if (signature.ok) signature.bytes else ""
        }
    }

private fun tlsEcSigner(scalar: string): (int, string) -> string =
    { scheme: int, content: string ->
        if (scheme != TLS_SIG_ECDSA_SECP256R1_SHA256) "" else {
            val signature = p256EcdsaSign(scalar, content)
            if (signature.ok) signature.bytes else ""
        }
    }

private fun tlsEc384Signer(scalar: string): (int, string) -> string =
    { scheme: int, content: string ->
        if (scheme != TLS_SIG_ECDSA_SECP384R1_SHA384) "" else {
            val signature = p384EcdsaSign(scalar, content)
            if (signature.ok) signature.bytes else ""
        }
    }

// The public key is public: kept here, a signature does not recompute it from the seed.
private fun tlsEdSigner(seed: string, publicKey: string): (int, string) -> string =
    { scheme: int, content: string ->
        // A cleared seed (TlsIdentity.wipe) would still sign, under another key: it signs nothing.
        var bits = 0
        for (byte in seed) bits = bits | byte
        if (scheme != TLS_SIG_ED25519 || bits == 0) "" else {
            val signature = ed25519SignWithPublicKey(seed, publicKey, content)
            if (signature.ok) signature.bytes else ""
        }
    }

// PSS first (all TLS versions), then PKCS#1 v1.5, which only TLS 1.2 peers use.
private val TLS_RSA_SCHEMES: array<int> = [TLS_SIG_RSA_PSS_RSAE_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA384, TLS_SIG_RSA_PSS_RSAE_SHA512,
    TLS_SIG_RSA_PKCS1_SHA256, TLS_SIG_RSA_PKCS1_SHA384, TLS_SIG_RSA_PKCS1_SHA512]

private val TLS_DIGEST_INFO_SHA256 = "\x30\x31\x30\x0d\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x01\x05\x00\x04\x20"
private val TLS_DIGEST_INFO_SHA384 = "\x30\x41\x30\x0d\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x02\x05\x00\x04\x30"
private val TLS_DIGEST_INFO_SHA512 = "\x30\x51\x30\x0d\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x03\x05\x00\x04\x40"

/** The scalar of an ECPrivateKey (RFC 5915) at `item` of `der` (a view of it), or "". */
private fun tlsEcScalar(der: string, item: DerItem): string {
    if (!item.ok || item.tag != 48) return ""
    val version = derItem(der, item.start, item.end)
    val octets = derItem(der, version.end, item.end)
    if (!version.ok || !octets.ok || octets.tag != 4) return ""
    // The octets as they are (32 bytes for P-256, 48 for P-384, RFC 5915 section 3); tlsIdentityFromEc pads a short one to its curve.
    der.slice(octets.start, octets.end)
}

/** Reads the key and returns the identity for `chain`; `error` is set when it cannot. */
private fun tlsIdentityFromKey(chain: array<string>, keyDer: string, label: string): TlsIdentity {
    val leaf = x509ParseDer(chain[0])
    if (!leaf.ok) return tlsIdentityFailed("the client certificate does not parse: ${leaf.error}")
    if (label == "RSA PRIVATE KEY") {
        val key = rsaPrivateKeyFromDer(keyDer)
        if (!key.ok()) return tlsIdentityFailed("not a readable RSA private key")
        val pub = rsaPublicKeyFromDer(leaf.spki)
        if (!pub.ok() || pub.modulus != key.modulus) return tlsIdentityFailed("the private key is not the client certificate's")
        return TlsIdentity(chain, TLS_RSA_SCHEMES, tlsRsaSigner(keyDer), "", [keyDer])
    }
    if (label == "EC PRIVATE KEY") {
        val scalar = tlsEcScalar(keyDer, derItem(keyDer, 0, keyDer.size))
        return tlsIdentityFromEc(chain, leaf, scalar, keyDer)
    }
    // PKCS#8: version, the algorithm, the key in an OCTET STRING.
    val root = derItem(keyDer, 0, keyDer.size)
    if (!root.ok || root.tag != 48) return tlsIdentityFailed("not a readable private key")
    val version = derItem(keyDer, root.start, root.end)
    val algorithm = derItem(keyDer, version.end, root.end)
    val inner = derItem(keyDer, algorithm.end, root.end)
    val oid = derItem(keyDer, algorithm.start, algorithm.end)
    if (!version.ok || !algorithm.ok || !inner.ok || inner.tag != 4 || !oid.ok) return tlsIdentityFailed("not a readable private key")
    val algorithmOid = x509OidText(keyDer, oid)
    val body = keyDer.slice(inner.start, inner.end)
    if (algorithmOid == "1.2.840.113549.1.1.1") {
        val key = rsaPrivateKeyFromDer(keyDer)
        if (!key.ok()) return tlsIdentityFailed("not a readable RSA private key")
        val pub = rsaPublicKeyFromDer(leaf.spki)
        if (!pub.ok() || pub.modulus != key.modulus) return tlsIdentityFailed("the private key is not the client certificate's")
        return TlsIdentity(chain, TLS_RSA_SCHEMES, tlsRsaSigner(keyDer), "", [keyDer])
    }
    if (algorithmOid == "1.2.840.10045.2.1") {
        return tlsIdentityFromEc(chain, leaf, tlsEcScalar(body, derItem(body, 0, body.size)), keyDer)
    }
    if (algorithmOid == "1.3.101.112") {
        val seed = derItem(body, 0, body.size)
        if (!seed.ok || seed.tag != 4 || seed.end - seed.start != 32) return tlsIdentityFailed("not a readable Ed25519 private key")
        val seedBytes = body.slice(seed.start, seed.end)
        val pub = ed25519PublicKey(seedBytes)
        if (!pub.ok || pub.bytes != leaf.keyBits) return tlsIdentityFailed("the private key is not the client certificate's")
        return TlsIdentity(chain, [TLS_SIG_ED25519], tlsEdSigner(seedBytes, pub.bytes), "", [keyDer])
    }
    tlsIdentityFailed("an unsupported private key type ($algorithmOid)")
}

// (`keyDer` is what `octets` was read from; the scalar is a buffer of its own, padded to its curve's size, so both are the identity's secrets and
// wiping either leaves the other as it was.) A key of 32 bytes or fewer is P-256, one of 33 to 48 is P-384.
private fun tlsIdentityFromEc(chain: array<string>, leaf: X509Certificate, octets: string, keyDer: string): TlsIdentity {
    if (octets.size == 0 || octets.size > 48) return tlsIdentityFailed("not a readable EC private key")
    val wide = octets.size > 32
    val size = if (wide) 48 else 32
    val scalar = cryptoOwnedJoin([tlsZeroBytes(size - octets.size), octets], size)
    val pub = if (wide) p384PublicKey(scalar) else p256PublicKey(scalar)
    val curve = if (wide) "P-384" else "P-256"
    if (!pub.ok) {
        tlsIdentityWipeOwned(scalar)
        return tlsIdentityFailed("not a valid $curve private key")
    }
    if (pub.bytes != leaf.keyBits) {
        tlsIdentityWipeOwned(scalar)
        return tlsIdentityFailed("the private key is not the client certificate's")
    }
    if (wide) return TlsIdentity(chain, [TLS_SIG_ECDSA_SECP384R1_SHA384], tlsEc384Signer(scalar), "", [keyDer, scalar])
    TlsIdentity(chain, [TLS_SIG_ECDSA_SECP256R1_SHA256], tlsEcSigner(scalar), "", [keyDer, scalar])
}

private fun tlsZeroBytes(count: int): string {
    val bytes: array<int> = []
    while (bytes.size < count) bytes.append(0)
    cryptoByteString(bytes)
}

/** The identity of a certificate PEM (the leaf first, then intermediates) and a private key PEM; `passphrase`
 *  opens an encrypted PKCS#8 key. Check `error` (empty on success). */
trusted fun tlsIdentityFromPem(certificatePem: string, keyPem: string,
    passphrase: string = ""): TlsIdentity {
    val certificates = x509ParsePem(certificatePem)
    if (certificates.certificates.size == 0) return tlsIdentityFailed("not a readable certificate in PEM")
    val chain: array<string> = []
    for (certificate in certificates.certificates) chain.append(certificate.der)
    var label = pemLabel(keyPem)
    if (label == "") return tlsIdentityFailed("not a readable private key in PEM")
    var keyDer = pemBase64Decode(pemBody(keyPem, label))
    if (keyDer.size == 0) return tlsIdentityFailed("not a readable private key in PEM")
    if (label == "ENCRYPTED PRIVATE KEY") {
        val opened = pbeOpenPkcs8(keyDer, cryptoPassword(passphrase))
        if (!opened.ok()) return tlsIdentityFailed("not a readable private key in PEM, or a wrong passphrase")
        // The identity keeps the key past `opened`, which wipes its own copy when dropped: this copy is the identity's.
        keyDer = cryptoOwnedCopy(opened.der())
        label = "PRIVATE KEY"
    }
    val identity = tlsIdentityFromKey(chain, keyDer, label)
    if (!identity.ok()) tlsIdentityWipeOwned2(keyDer)
    identity
}

/** The identity of a PKCS#12 container (PFXv3 with a password MAC, PBES2 encryption: what OpenSSL 3 and current
 *  tools write): its private key and its certificate chain, the leaf first. The leaf is the certificate whose key is
 *  the private key; the rest follow in issuer order (certificates that do not chain are left out). `password` is
 *  the container's. Check `error` (empty on success). */
trusted fun tlsIdentityFromPkcs12(der: string, password: string): TlsIdentity {
    val contents = pbeOpenPkcs12Contents(der, cryptoPassword(password))
    if (!contents.ok) return tlsIdentityFailed("not a readable PKCS#12 identity, or a wrong password")
    if (contents.certificates.size == 0) return tlsIdentityFailed("the PKCS#12 has no certificate")
    // The leaf: the certificate that the key belongs to.
    var leafIndex = -1
    var identity = tlsIdentityFailed("the private key is not the PKCS#12's certificate's")
    var index = 0
    while (index < contents.certificates.size && leafIndex < 0) {
        val attempt = tlsIdentityFromKey([contents.certificates[index]], contents.key, "PRIVATE KEY")
        if (attempt.ok()) {
            leafIndex = index
            identity = attempt
        }
        index = index + 1
    }
    if (leafIndex < 0) {
        tlsIdentityWipeOwned2(contents.key)
        return identity
    }
    // The chain: from the leaf, the certificate whose subject is the current one's issuer, until none.
    val chain: array<string> = [contents.certificates[leafIndex]]
    val used: array<bool> = []
    for (i in 0 until contents.certificates.size) used.append(i == leafIndex)
    var current = x509ParseDer(contents.certificates[leafIndex])
    var extending = true
    while (extending && !current.selfIssued()) {
        extending = false
        for (i in 0 until contents.certificates.size) {
            if (!extending && !used[i]) {
                val candidate = x509ParseDer(contents.certificates[i])
                if (candidate.ok && candidate.subject.canonical == current.issuer.canonical) {
                    chain.append(contents.certificates[i])
                    used[i] = true
                    current = candidate
                    extending = true
                }
            }
        }
    }
    TlsIdentity(chain, identity.schemes, identity.sign, "", identity.secrets)
}

/** Wipes `secret`, a string this module made (cryptoWipeString, which only trusted code may call). */
private trusted fun tlsIdentityWipeOwned(secret: string): void = cryptoWipeString(secret)

/** Wipes `secret`, a string this module made (tlsWipe, which only trusted code may call). */
private trusted fun tlsIdentityWipeOwned2(secret: string): void = tlsWipe(secret)
