// TLS 1.3 handshake messages (RFC 8446 section 4): a bounds-checked reader, the encoders for the
// messages a client sends, and the parsers for the ones it receives. Sans-IO: strings in, strings
// out. A parser never reads outside its input and never trusts a length: a message that is too short,
// has bytes left over, repeats an extension, or breaks a length gives `ok` false and an error.

import "abla/crypto"
import "abla/text"

// ---- handshake message types and code points ----
val TLS_CLIENT_HELLO = 1
val TLS_SERVER_HELLO = 2
val TLS_NEW_SESSION_TICKET = 4
val TLS_END_OF_EARLY_DATA = 5
val TLS_ENCRYPTED_EXTENSIONS = 8
val TLS_CERTIFICATE = 11
val TLS_CERTIFICATE_REQUEST = 13
val TLS_CERTIFICATE_VERIFY = 15
val TLS_FINISHED = 20
val TLS_KEY_UPDATE = 24
val TLS_MESSAGE_HASH = 254

val TLS_SUITE_AES_128_GCM_SHA256 = 4865
val TLS_SUITE_AES_256_GCM_SHA384 = 4866
val TLS_SUITE_CHACHA20_POLY1305_SHA256 = 4867

val TLS_GROUP_SECP256R1 = 23
val TLS_GROUP_SECP384R1 = 24
val TLS_GROUP_X25519 = 29

val TLS_EXT_SERVER_NAME = 0
val TLS_EXT_SUPPORTED_GROUPS = 10
val TLS_EXT_SIGNATURE_ALGORITHMS = 13
val TLS_EXT_ALPN = 16
val TLS_EXT_PSK_KEY_EXCHANGE_MODES = 45
val TLS_EXT_SUPPORTED_VERSIONS = 43
val TLS_EXT_COOKIE = 44
val TLS_EXT_KEY_SHARE = 51

val TLS_SIG_ECDSA_SECP256R1_SHA256 = 1027
val TLS_SIG_ECDSA_SECP384R1_SHA384 = 1283
val TLS_SIG_RSA_PSS_RSAE_SHA256 = 2052
val TLS_SIG_RSA_PSS_RSAE_SHA384 = 2053
val TLS_SIG_RSA_PSS_RSAE_SHA512 = 2054
val TLS_SIG_ED25519 = 2055

// Added to the scheme a verifier is given when the signature is a TLS 1.2 one (a ServerKeyExchange, or a client's
// CertificateVerify in 1.2): the scheme alone does not say which rules apply. An ECDSA scheme fixes the curve in 1.3 (RFC 8446
// section 4.2.3) and names only the hash in 1.2 (RFC 5246 section 7.4.1.4.1). A verifier takes it off with tlsSignatureScheme.
val TLS_SIGNATURE_TLS12 = 65536
fun tlsSignatureScheme(scheme: int): int = scheme & 65535
fun tlsSignatureIsTls12(scheme: int): bool = (scheme & TLS_SIGNATURE_TLS12) != 0

// ---- writing ----
fun tlsU8(value: int): string = cryptoByteString([value & 255])
fun tlsU16(value: int): string = cryptoByteString([(value >> 8) & 255, value & 255])
fun tlsU24(value: int): string = cryptoByteString([(value >> 16) & 255, (value >> 8) & 255, value & 255])
fun tlsU32(value: int): string =
    cryptoByteString([(value >> 24) & 255, (value >> 16) & 255, (value >> 8) & 255, value & 255])

/** `data` with a one-, two- or three-byte length in front. */
fun tlsVec8(data: string): string = tlsU8(data.size) + data
fun tlsVec16(data: string): string = tlsU16(data.size) + data
fun tlsVec24(data: string): string = tlsU24(data.size) + data

/** A handshake message: type, three-byte length, body. */
fun tlsHandshakeMessage(type: int, body: string): string = tlsU8(type) + tlsU24(body.size) + body

/** An extension: type, two-byte length, data. */
fun tlsExtension(type: int, data: string): string = tlsU16(type) + tlsVec16(data)

// ---- reading ----
class TlsReader(val data: string, var position: int, var ok: bool)

fun tlsReader(data: string): TlsReader = TlsReader(data, 0, true)

fun TlsReader.remaining(): int = this.data.size - this.position

fun TlsReader.u8(): int {
    if (!this.ok || this.remaining() < 1) {
        this.ok = false
        return 0
    }
    val value = this.data[this.position]
    this.position = this.position + 1
    value
}

fun TlsReader.u16(): int {
    val high = this.u8()
    val low = this.u8()
    high * 256 + low
}

fun TlsReader.u24(): int {
    val high = this.u8()
    val rest = this.u16()
    high * 65536 + rest
}

fun TlsReader.u32(): int {
    val high = this.u16()
    val low = this.u16()
    high * 65536 + low
}

fun TlsReader.bytes(count: int): string {
    if (!this.ok || count < 0 || this.remaining() < count) {
        this.ok = false
        return ""
    }
    val value = this.data.slice(this.position, this.position + count)
    this.position = this.position + count
    value
}

fun TlsReader.vec8(): string {
    val count = this.u8()
    this.bytes(count)
}

fun TlsReader.vec16(): string {
    val count = this.u16()
    this.bytes(count)
}

fun TlsReader.vec24(): string {
    val count = this.u24()
    this.bytes(count)
}

/** True when the reader is intact and everything was consumed. */
fun TlsReader.finished(): bool = this.ok && this.remaining() == 0

// ---- framing ----
/** The header of the handshake message at `offset` of a buffer of handshake bytes. `complete` is false
 *  while fewer bytes than header and body are there (`ok` is still true); `total` is the whole message's size. */
class TlsMessageHeader(val ok: bool, val complete: bool, val type: int, val bodyLength: int, val total: int)

fun tlsParseMessageHeader(buffer: string, offset: int): TlsMessageHeader {
    if (buffer.size - offset < 4) return TlsMessageHeader(true, false, 0, 0, 0)
    val length = buffer[offset + 1] * 65536 + buffer[offset + 2] * 256 + buffer[offset + 3]
    TlsMessageHeader(true, buffer.size - offset >= 4 + length, buffer[offset], length, 4 + length)
}

// ---- extensions ----
class TlsExtension(val type: int, val data: string)

/** The extensions of a two-byte-length-prefixed list; `ok` false on a truncated list or a repeated type. */
class TlsExtensions(val ok: bool, val list: array<TlsExtension>, val error: string)

fun tlsParseExtensions(var reader: TlsReader): TlsExtensions {
    val block = tlsReader(reader.vec16())
    val list: array<TlsExtension> = []
    if (!reader.ok) return TlsExtensions(false, list, "tls: truncated extensions")
    // Which types were seen: one bit per 16-bit type (a duplicate check that costs the same for 15 000 extensions as
    // for 15).
    val seen: array<int> = []
    while (seen.size < 1024) seen.append(0)
    while (block.remaining() > 0 && block.ok) {
        val type = block.u16()
        val data = block.vec16()
        if (!block.ok) return TlsExtensions(false, list, "tls: truncated extension")
        val word = type >> 6
        val bit = 1 << (type & 63)
        if ((seen[word] & bit) != 0) return TlsExtensions(false, list, "tls: duplicate extension $type")
        seen[word] = seen[word] | bit
        list.append(TlsExtension(type, data))
    }
    TlsExtensions(block.ok, list, if (block.ok) "" else "tls: truncated extensions")
}

/** The data of extension `type`, and whether it is there. */
fun tlsFindExtension(list: array<TlsExtension>, type: int): TlsExtension? {
    for (extension in list) {
        if (extension.type == type) return extension
    }
    null
}

// ---- ClientHello ----
/** One offered key share: the group and the client's public value. */
class TlsKeyShare(val group: int, val publicKey: string)

/** A DNS host name (not an address literal), for server_name (RFC 6066: no literal addresses). */
fun tlsIsDnsName(host: string): bool {
    if (host.size == 0 || host.size > 253) return false
    var digitsAndDots = true
    var index = 0
    while (index < host.size) {
        val character = host[index]
        if (character == 58) return false
        if (!((character >= 48 && character <= 57) || character == 46)) digitsAndDots = false
        index = index + 1
    }
    !digitsAndDots
}

/** A ClientHello message (with its 4-byte header). `sessionId` is the 32 random bytes of middlebox
 *  compatibility mode (RFC 8446 appendix D.4) or empty; `cookie` repeats a HelloRetryRequest's cookie. */
fun tlsBuildClientHello(random: string, sessionId: string, suites: array<int>, host: string,
    groups: array<int>, shares: array<TlsKeyShare>, signatureAlgorithms: array<int>,
    alpn: array<string>, cookie: string, tls12Suites: array<int> = []): string {
    var suiteBytes = ""
    for (suite in suites) suiteBytes = suiteBytes + tlsU16(suite)
    // TLS 1.2 offers: its suites, the versions list, ec_point_formats, extended_master_secret, renegotiation_info.
    for (suite in tls12Suites) suiteBytes = suiteBytes + tlsU16(suite)
    var extensions = ""
    if (tlsIsDnsName(host)) {
        extensions = extensions + tlsExtension(TLS_EXT_SERVER_NAME,
            tlsVec16(tlsU8(0) + tlsVec16(host)))
    }
    var groupBytes = ""
    for (group in groups) groupBytes = groupBytes + tlsU16(group)
    extensions = extensions + tlsExtension(TLS_EXT_SUPPORTED_GROUPS, tlsVec16(groupBytes))
    var algorithmBytes = ""
    for (algorithm in signatureAlgorithms) algorithmBytes = algorithmBytes + tlsU16(algorithm)
    extensions = extensions + tlsExtension(TLS_EXT_SIGNATURE_ALGORITHMS, tlsVec16(algorithmBytes))
    extensions = extensions + tlsExtension(TLS_EXT_SUPPORTED_VERSIONS,
        tlsVec8(if (suites.size == 0) tlsU16(771) else if (tls12Suites.size > 0) tlsU16(772) + tlsU16(771) else tlsU16(772)))
    if (tls12Suites.size > 0) {
        extensions = extensions + tlsExtension(11, tlsVec8(tlsU8(0))) + tlsExtension(23, "") + tlsExtension(65281, tlsU8(0))
    }
    var shareBytes = ""
    for (share in shares) shareBytes = shareBytes + tlsU16(share.group) + tlsVec16(share.publicKey)
    extensions = extensions + tlsExtension(TLS_EXT_KEY_SHARE, tlsVec16(shareBytes))
    if (alpn.size > 0) {
        var names = ""
        for (name in alpn) names = names + tlsVec8(name)
        extensions = extensions + tlsExtension(TLS_EXT_ALPN, tlsVec16(names))
    }
    if (cookie.size > 0) extensions = extensions + tlsExtension(TLS_EXT_COOKIE, tlsVec16(cookie))
    val body = tlsU16(771) + random + tlsVec8(sessionId) + tlsVec16(suiteBytes) + tlsVec8(tlsU8(0)) +
        tlsVec16(extensions)
    tlsHandshakeMessage(TLS_CLIENT_HELLO, body)
}

// ---- ServerHello and HelloRetryRequest ----
/** The special random of a HelloRetryRequest (RFC 8446 section 4.1.3, SHA-256 of "HelloRetryRequest"). */
fun tlsHelloRetryRandom(): string =
    hexDecode("cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c")

class TlsServerHello(val ok: bool, val error: string, val random: string, val sessionId: string,
    val cipherSuite: int, val retryRequest: bool, val selectedVersion: int, val shareGroup: int,
    val shareKey: string, val cookie: string)

private fun tlsBadServerHello(error: string): TlsServerHello =
    TlsServerHello(false, error, "", "", 0, false, 0, 0, "", "")

/** Parses a ServerHello or HelloRetryRequest body (without the 4-byte header). In a HelloRetryRequest
 *  the key_share extension holds only the selected group (`shareKey` empty). */
fun tlsParseServerHello(body: string): TlsServerHello {
    val reader = tlsReader(body)
    val legacyVersion = reader.u16()
    val random = reader.bytes(32)
    val sessionId = reader.vec8()
    val suite = reader.u16()
    val compression = reader.u8()
    val extensions = tlsParseExtensions(reader)
    if (!reader.finished()) return tlsBadServerHello("tls: malformed ServerHello")
    if (!extensions.ok) return tlsBadServerHello(extensions.error)
    if (legacyVersion != 771) return tlsBadServerHello("tls: unexpected legacy_version")
    if (compression != 0) return tlsBadServerHello("tls: a ServerHello with compression")
    val retry = random == tlsHelloRetryRandom()
    var version = 0
    val versionExtension = tlsFindExtension(extensions.list, TLS_EXT_SUPPORTED_VERSIONS)
    if (versionExtension != null) {
        val versionReader = tlsReader(versionExtension.data)
        version = versionReader.u16()
        if (!versionReader.finished()) return tlsBadServerHello("tls: malformed supported_versions")
    }
    var group = 0
    var key = ""
    val shareExtension = tlsFindExtension(extensions.list, TLS_EXT_KEY_SHARE)
    if (shareExtension != null) {
        val shareReader = tlsReader(shareExtension.data)
        group = shareReader.u16()
        if (!retry) key = shareReader.vec16()
        if (!shareReader.finished()) return tlsBadServerHello("tls: malformed key_share")
    }
    var cookie = ""
    val cookieExtension = tlsFindExtension(extensions.list, TLS_EXT_COOKIE)
    if (cookieExtension != null) {
        val cookieReader = tlsReader(cookieExtension.data)
        cookie = cookieReader.vec16()
        if (!cookieReader.finished() || cookie.size == 0) return tlsBadServerHello("tls: malformed cookie")
    }
    TlsServerHello(true, "", random, sessionId, suite, retry, version, group, key, cookie)
}

// ---- the encrypted flight ----
/** EncryptedExtensions: the negotiated ALPN protocol ("" if none) and whether every extension parsed. */
class TlsEncryptedExtensions(val ok: bool, val error: string, val alpn: string, val extensions: array<TlsExtension>)

fun tlsParseEncryptedExtensions(body: string): TlsEncryptedExtensions {
    val reader = tlsReader(body)
    val extensions = tlsParseExtensions(reader)
    val none: array<TlsExtension> = []
    if (!reader.finished() || !extensions.ok) {
        return TlsEncryptedExtensions(false, "tls: malformed EncryptedExtensions", "", none)
    }
    var alpn = ""
    val alpnExtension = tlsFindExtension(extensions.list, TLS_EXT_ALPN)
    if (alpnExtension != null) {
        val outer = tlsReader(alpnExtension.data)
        val names = tlsReader(outer.vec16())
        alpn = names.vec8()
        if (!outer.finished() || !names.finished() || alpn.size == 0) {
            return TlsEncryptedExtensions(false, "tls: malformed ALPN", "", none)
        }
    }
    TlsEncryptedExtensions(true, "", alpn, extensions.list)
}

/** A Certificate message's chain, end entity first, as DER strings. `context` is the request context
 *  (empty from a server). */
class TlsCertificateMessage(val ok: bool, val error: string, val context: string, val chain: array<string>)

fun tlsParseCertificate(body: string): TlsCertificateMessage {
    val reader = tlsReader(body)
    val context = reader.vec8()
    val list = tlsReader(reader.vec24())
    val chain: array<string> = []
    while (list.remaining() > 0 && list.ok) {
        val der = list.vec24()
        val extensions = tlsParseExtensions(list)
        if (!list.ok || !extensions.ok) return TlsCertificateMessage(false, "tls: malformed Certificate", "", chain)
        chain.append(der)
    }
    if (!reader.finished() || !list.ok) return TlsCertificateMessage(false, "tls: malformed Certificate", "", chain)
    TlsCertificateMessage(true, "", context, chain)
}

/** CertificateVerify: the signature scheme and the signature. */
class TlsCertificateVerify(val ok: bool, val scheme: int, val signature: string)

fun tlsParseCertificateVerify(body: string): TlsCertificateVerify {
    val reader = tlsReader(body)
    val scheme = reader.u16()
    val signature = reader.vec16()
    TlsCertificateVerify(reader.finished(), scheme, signature)
}

/** The content a CertificateVerify signs: 64 spaces, the context string, a zero byte, the transcript hash
 *  (RFC 8446 section 4.4.3). `server` selects the server's context string. */
fun tlsCertificateVerifyContent(server: bool, transcriptHash: string): string {
    val spaces: array<int> = []
    while (spaces.size < 64) spaces.append(32)
    cryptoByteString(spaces) +
        (if (server) "TLS 1.3, server CertificateVerify" else "TLS 1.3, client CertificateVerify") +
        tlsU8(0) + transcriptHash
}

/** A NewSessionTicket (parsed only to validate it). */
class TlsNewSessionTicket(val ok: bool, val lifetime: int, val ageAdd: int, val nonce: string, val ticket: string)

fun tlsParseNewSessionTicket(body: string): TlsNewSessionTicket {
    val reader = tlsReader(body)
    val lifetime = reader.u32()
    val ageAdd = reader.u32()
    val nonce = reader.vec8()
    val ticket = reader.vec16()
    val extensions = tlsParseExtensions(reader)
    TlsNewSessionTicket(reader.finished() && extensions.ok && ticket.size > 0, lifetime, ageAdd, nonce, ticket)
}

// ---- the second ClientHello after a HelloRetryRequest ----
/** The ClientHello a HelloRetryRequest asks for (RFC 8446 section 4.1.2): the first one with its
 *  key_share replaced by `share` and, when the server sent one, its cookie added at the end of the
 *  extensions. Everything else stays byte for byte, as the transcript rules require. `first` is the whole
 *  message (header included); an empty string comes back when it does not parse. */
fun tlsPatchClientHello(first: string, share: TlsKeyShare, cookie: string): string {
    if (first.size < 4) return ""
    val reader = tlsReader(first.slice(4, first.size))
    val version = reader.u16()
    val random = reader.bytes(32)
    val sessionId = reader.vec8()
    val suites = reader.vec16()
    val compression = reader.vec8()
    val extensions = tlsParseExtensions(reader)
    if (!reader.finished() || !extensions.ok) return ""
    var rebuilt = ""
    var replaced = false
    for (extension in extensions.list) {
        if (extension.type == TLS_EXT_KEY_SHARE) {
            rebuilt = rebuilt + tlsExtension(TLS_EXT_KEY_SHARE, tlsVec16(tlsU16(share.group) + tlsVec16(share.publicKey)))
            replaced = true
        } else if (extension.type != TLS_EXT_COOKIE) {
            rebuilt = rebuilt + tlsExtension(extension.type, extension.data)
        }
    }
    if (!replaced) return ""
    if (cookie.size > 0) rebuilt = rebuilt + tlsExtension(TLS_EXT_COOKIE, tlsVec16(cookie))
    tlsHandshakeMessage(TLS_CLIENT_HELLO, tlsU16(version) + random + tlsVec8(sessionId) + tlsVec16(suites) +
        tlsVec8(compression) + tlsVec16(rebuilt))
}

/** The groups a ClientHello message lists in supported_groups. */
fun tlsClientHelloGroups(hello: string): array<int> {
    val groups: array<int> = []
    if (hello.size < 4) return groups
    val reader = tlsReader(hello.slice(4, hello.size))
    reader.u16()
    reader.bytes(32)
    reader.vec8()
    reader.vec16()
    reader.vec8()
    val extensions = tlsParseExtensions(reader)
    if (!reader.ok || !extensions.ok) return groups
    val found = tlsFindExtension(extensions.list, TLS_EXT_SUPPORTED_GROUPS)
    if (found != null) {
        val outer = tlsReader(found.data)
        val list = tlsReader(outer.vec16())
        while (list.remaining() > 1 && list.ok) groups.append(list.u16())
    }
    groups
}

// ---- client authentication ----
/** A CertificateRequest: the request context to echo and the signature schemes the server accepts. */
class TlsCertificateRequest(val ok: bool, val context: string, val signatureAlgorithms: array<int>)

fun tlsParseCertificateRequest(body: string): TlsCertificateRequest {
    val none: array<int> = []
    val reader = tlsReader(body)
    val context = reader.vec8()
    val extensions = tlsParseExtensions(reader)
    if (!reader.finished() || !extensions.ok) return TlsCertificateRequest(false, "", none)
    val algorithms: array<int> = []
    val found = tlsFindExtension(extensions.list, TLS_EXT_SIGNATURE_ALGORITHMS)
    // signature_algorithms is mandatory in a CertificateRequest (RFC 8446 section 4.3.2).
    if (found == null) return TlsCertificateRequest(false, "", none)
    val outer = tlsReader(found.data)
    val list = tlsReader(outer.vec16())
    while (list.remaining() > 1 && list.ok) algorithms.append(list.u16())
    TlsCertificateRequest(outer.finished() && list.finished() && algorithms.size > 0, context, algorithms)
}

/** A Certificate message: the request context (empty from a server) and the chain, end entity first,
 *  each certificate without extensions. */
fun tlsBuildCertificate(context: string, chain: array<string>): string {
    var list = ""
    for (der in chain) list = list + tlsVec24(der) + tlsU16(0)
    tlsHandshakeMessage(TLS_CERTIFICATE, tlsVec8(context) + tlsVec24(list))
}

/** A CertificateVerify message from the scheme and the signature. */
fun tlsBuildCertificateVerify(scheme: int, signature: string): string =
    tlsHandshakeMessage(TLS_CERTIFICATE_VERIFY, tlsU16(scheme) + tlsVec16(signature))

// ---- the server's side: ClientHello in, the server's messages out ----
/** What a ClientHello offers (RFC 8446 section 4.1.2): `versions` from supported_versions (empty when the
 *  extension is absent), the key shares in the order sent, the host name, ALPN protocols. */
class TlsClientHello(val ok: bool, val error: string, val random: string, val sessionId: string,
    val suites: array<int>, val versions: array<int>, val groups: array<int>, val shares: array<TlsKeyShare>,
    val schemes: array<int>, val alpn: array<string>, val serverName: string, val cookie: string,
    /** The legacy_version field, whether extended_master_secret was offered, and whether renegotiation_info or
     *  TLS_EMPTY_RENEGOTIATION_INFO_SCSV (0x00FF) was (RFC 5746). */
    val legacyVersion: int = 0, val extendedMasterSecret: bool = false, val secureRenegotiation: bool = false,
    /** Whether the key_share extension was present at all (an empty list is a request for a HelloRetryRequest). */
    val hasKeyShare: bool = false, val compression: string = "\x00")

private fun tlsBadClientHello(error: string): TlsClientHello {
    val none: array<int> = []
    val noShares: array<TlsKeyShare> = []
    val noNames: array<string> = []
    TlsClientHello(false, error, "", "", none, none, none, noShares, none, noNames, "", "")
}

/** Parses a ClientHello body (without its 4-byte header). */
fun tlsParseClientHello(body: string): TlsClientHello {
    val reader = tlsReader(body)
    val legacyVersion = reader.u16()
    val random = reader.bytes(32)
    val sessionId = reader.vec8()
    val suiteBytes = tlsReader(reader.vec16())
    val compression = reader.vec8()
    val extensions = tlsParseExtensions(reader)
    if (!reader.finished() || !extensions.ok) return tlsBadClientHello("tls: malformed ClientHello")
    if (sessionId.size > 32) return tlsBadClientHello("tls: a session id longer than 32 bytes")
    // TLS 1.2 lists the methods it supports, null among them (RFC 5246 section 7.4.1.2); TLS 1.3 sends null only (the server checks).
    if (!compression.contains(tlsU8(0))) return tlsBadClientHello("tls: the ClientHello does not offer null compression")
    val suites: array<int> = []
    while (suiteBytes.remaining() > 1 && suiteBytes.ok) suites.append(suiteBytes.u16())
    if (!suiteBytes.finished() || suites.size == 0) return tlsBadClientHello("tls: malformed cipher suites")
    val versions: array<int> = []
    val groups: array<int> = []
    val shares: array<TlsKeyShare> = []
    val schemes: array<int> = []
    val alpn: array<string> = []
    var serverName = ""
    var cookie = ""
    var ems = false
    var hasKeyShare = false
    var renegotiation = false
    for (suite in suites) {
        if (suite == 255) renegotiation = true
    }
    for (extension in extensions.list) {
        val data = tlsReader(extension.data)
        if (extension.type == 23) ems = true
        if (extension.type == 65281) renegotiation = true
        if (extension.type == TLS_EXT_SUPPORTED_VERSIONS) {
            val list = tlsReader(data.vec8())
            while (list.remaining() > 1 && list.ok) versions.append(list.u16())
            if (!data.finished() || !list.finished()) return tlsBadClientHello("tls: malformed supported_versions")
        } else if (extension.type == TLS_EXT_SUPPORTED_GROUPS) {
            val list = tlsReader(data.vec16())
            while (list.remaining() > 1 && list.ok) groups.append(list.u16())
            if (!data.finished() || !list.finished()) return tlsBadClientHello("tls: malformed supported_groups")
        } else if (extension.type == TLS_EXT_SIGNATURE_ALGORITHMS) {
            val list = tlsReader(data.vec16())
            while (list.remaining() > 1 && list.ok) schemes.append(list.u16())
            if (!data.finished() || !list.finished()) return tlsBadClientHello("tls: malformed signature_algorithms")
        } else if (extension.type == TLS_EXT_KEY_SHARE) {
            hasKeyShare = true
            val list = tlsReader(data.vec16())
            while (list.remaining() > 3 && list.ok) {
                val group = list.u16()
                val key = list.vec16()
                shares.append(TlsKeyShare(group, key))
            }
            if (!data.finished() || !list.finished()) return tlsBadClientHello("tls: malformed key_share")
        } else if (extension.type == TLS_EXT_SERVER_NAME) {
            val list = tlsReader(data.vec16())
            while (list.remaining() > 2 && list.ok) {
                val type = list.u8()
                val name = list.vec16()
                if (type == 0 && serverName == "") serverName = name
            }
            if (!data.finished() || !list.finished()) return tlsBadClientHello("tls: malformed server_name")
        } else if (extension.type == TLS_EXT_ALPN) {
            val list = tlsReader(data.vec16())
            while (list.remaining() > 0 && list.ok) {
                val name = list.vec8()
                if (name.size == 0) return tlsBadClientHello("tls: an empty ALPN protocol name")
                alpn.append(name)
            }
            if (!data.finished() || !list.finished()) return tlsBadClientHello("tls: malformed ALPN")
        } else if (extension.type == TLS_EXT_COOKIE) {
            cookie = data.vec16()
            if (!data.finished()) return tlsBadClientHello("tls: malformed cookie")
        }
    }
    TlsClientHello(true, "", random, sessionId, suites, versions, groups, shares, schemes, alpn, serverName, cookie,
        legacyVersion, ems, renegotiation, hasKeyShare, compression)
}

/** A ServerHello message: the echo of the session id, the suite, and the server's key share. */
fun tlsBuildServerHello(random: string, sessionId: string, suite: int, share: TlsKeyShare): string =
    tlsHandshakeMessage(TLS_SERVER_HELLO, tlsU16(771) + random + tlsVec8(sessionId) + tlsU16(suite) + tlsU8(0) +
        tlsVec16(tlsExtension(TLS_EXT_SUPPORTED_VERSIONS, tlsU16(772)) +
        tlsExtension(TLS_EXT_KEY_SHARE, tlsU16(share.group) + tlsVec16(share.publicKey))))

/** A HelloRetryRequest: the special random, the suite, the group to retry with (and a cookie, if any). */
fun tlsBuildHelloRetryRequest(sessionId: string, suite: int, group: int, cookie: string): string {
    var extensions = tlsExtension(TLS_EXT_SUPPORTED_VERSIONS, tlsU16(772)) +
        tlsExtension(TLS_EXT_KEY_SHARE, tlsU16(group))
    if (cookie.size > 0) extensions = extensions + tlsExtension(TLS_EXT_COOKIE, tlsVec16(cookie))
    tlsHandshakeMessage(TLS_SERVER_HELLO, tlsU16(771) + tlsHelloRetryRandom() + tlsVec8(sessionId) + tlsU16(suite) +
        tlsU8(0) + tlsVec16(extensions))
}

/** EncryptedExtensions carrying the chosen ALPN protocol, if any. */
fun tlsBuildEncryptedExtensions(alpn: string): string {
    var extensions = ""
    if (alpn.size > 0) extensions = tlsExtension(TLS_EXT_ALPN, tlsVec16(tlsVec8(alpn)))
    tlsHandshakeMessage(TLS_ENCRYPTED_EXTENSIONS, tlsVec16(extensions))
}

/** A CertificateRequest with the schemes the server accepts. */
fun tlsBuildCertificateRequest(context: string, schemes: array<int>): string {
    var list = ""
    for (scheme in schemes) list = list + tlsU16(scheme)
    tlsHandshakeMessage(TLS_CERTIFICATE_REQUEST,
        tlsVec8(context) + tlsVec16(tlsExtension(TLS_EXT_SIGNATURE_ALGORITHMS, tlsVec16(list))))
}

/** The RSA PKCS#1 v1.5 signature schemes: valid for certificate signatures and in TLS 1.2, never in a TLS 1.3
 *  CertificateVerify (RFC 8446 section 4.2.3). */
fun tlsSchemeIsPkcs1(scheme: int): bool = scheme == 1025 || scheme == 1281 || scheme == 1537

// ---- reassembling handshake messages from records, bounded ----
/** The most body a handshake message may have, by type, checked as soon as its header is read (before the body is
 *  buffered): hellos 2^17, Certificate 2^16, everything else 2^14. A peer that is not authenticated yet cannot make
 *  the buffer grow beyond that. */
fun tlsMessageLimit(type: int): int =
    if (type == TLS_CLIENT_HELLO || type == TLS_SERVER_HELLO) 131072
    else if (type == TLS_CERTIFICATE) 65536 else 16384

/** The handshake bytes received and not yet taken as messages, kept as the pieces they came in: a message split over
 *  many records is joined once, when it is whole, not once per record (a chain of one-byte records would otherwise cost
 *  quadratic copying). */
class TlsHandshakeBuffer(var parts: array<string>, var size: int)

fun TlsHandshakeBuffer.add(data: string): void {
    if (data.size == 0) return
    this.parts.append(data)
    this.size = this.size + data.size
    return
}

fun TlsHandshakeBuffer.empty(): bool = this.size == 0

/** The header of the first message, read from the first four bytes without joining the pieces; `complete` says whether
 *  the whole message is buffered. Fewer than four bytes: `ok` true, `complete` false, nothing known. */
fun TlsHandshakeBuffer.header(): TlsMessageHeader {
    if (this.size < 4) return TlsMessageHeader(true, false, 0, 0, 0)
    var head = ""
    var index = 0
    while (head.size < 4 && index < this.parts.size) {
        val piece = this.parts[index]
        val wanted = 4 - head.size
        head = head + (if (piece.size > wanted) piece.slice(0, wanted) else piece)
        index = index + 1
    }
    val length = head[1] * 65536 + head[2] * 256 + head[3]
    TlsMessageHeader(true, this.size >= 4 + length, head[0], length, 4 + length)
}

/** The first `total` bytes (a whole message, as `header()` said), joining the pieces; what follows stays buffered. */
fun TlsHandshakeBuffer.take(total: int): string {
    var joined = ""
    if (this.parts.size == 1) joined = this.parts[0]
    else {
        var pieces = ""
        for (piece in this.parts) pieces = pieces + piece
        joined = pieces
    }
    val message = joined.slice(0, total)
    val rest = joined.slice(total, joined.size)
    this.parts = []
    if (rest.size > 0) this.parts.append(rest)
    this.size = rest.size
    message
}

// The answer of a certificate verifier: the alert to send when it refuses (RFC 8446 section 6.2) and the reason.
val TLS_VERDICT_DECODE_ERROR = 50
val TLS_VERDICT_BAD_CERTIFICATE = 42
val TLS_VERDICT_UNSUPPORTED_CERTIFICATE = 43
val TLS_VERDICT_CERTIFICATE_EXPIRED = 45
val TLS_VERDICT_UNKNOWN_CA = 48

/** `text` is "" when the certificate is accepted; otherwise the reason, and `alert` the alert to send. */
class TlsVerdict(val alert: int, val text: string)

fun tlsAccepted(): TlsVerdict = TlsVerdict(0, "")

fun tlsRefused(alert: int, text: string): TlsVerdict = TlsVerdict(alert, text)

fun TlsVerdict.accepted(): bool = this.text.size == 0

/** True for the signature schemes of an ECDSA or Ed25519 key (the ECDHE_ECDSA suites of TLS 1.2), false for RSA's. */
fun tlsSchemeIsEcKey(scheme: int): bool = scheme == TLS_SIG_ECDSA_SECP256R1_SHA256 ||
    scheme == TLS_SIG_ECDSA_SECP384R1_SHA384 || scheme == 1539 || scheme == TLS_SIG_ED25519
