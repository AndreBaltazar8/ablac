// The TLS 1.3 record layer (RFC 8446 section 5): plaintext records before the keys exist, and
// AEAD-protected records after (TLSInnerPlaintext = content || content type || zero padding, a 5-byte
// header that is the additional data, a nonce of the per-direction IV xor the 64-bit record
// sequence). Sans-IO: a protection state is a key, an IV and a sequence number; records are strings.
//
// AES-128-GCM and AES-256-GCM (abla/crypto/aes) and ChaCha20-Poly1305 (abla/crypto/chacha20poly1305). A state that fails to open a record is finished: the caller
// closes the connection (a bad record is fatal in TLS 1.3), so the sequence only advances on success.

import "abla/crypto"
import "abla/crypto/aes"
import "abla/crypto/chacha20poly1305"
import "abla/crypto/result"

val TLS_CHANGE_CIPHER_SPEC = 20
val TLS_ALERT = 21
val TLS_HANDSHAKE = 22
val TLS_APPLICATION_DATA = 23

val TLS_AEAD_AES_128_GCM = 1
val TLS_AEAD_AES_256_GCM = 2
val TLS_AEAD_CHACHA20_POLY1305 = 3

/** The most plaintext one record carries (section 5.1), and the most a protected record's payload
 *  (ciphertext with its tag) may be (section 5.2). */
val TLS_MAX_PLAINTEXT = 16384
val TLS_MAX_EMPTY_RUN = 32

// RFC 8446 section 5.5: a key protects a limited number of records. AES-GCM: 2^24 (the analysis allows 2^24.5), after
// which the sender updates its key; ChaCha20-Poly1305 has no limit that matters, 2^34 is far inside it. A sequence number
// never wraps: past 2^62 records nothing more is sealed or opened.
val TLS_MAX_SEQUENCE = 4611686018427387904

fun tlsRecordLimit(aead: int): int = if (aead == TLS_AEAD_CHACHA20_POLY1305) 17179869184 else 16777216
val TLS_MAX_CIPHERTEXT = 16640

/** One direction's protection: the traffic key, the IV (12 bytes) and the next record's sequence number. */
class TlsRecordProtection(val aead: int, val key: string, val iv: string, var sequence: int)

fun tlsRecordProtection(aead: int, key: string, iv: string): TlsRecordProtection =
    TlsRecordProtection(aead, key, iv, 0)

private fun tlsSeal(aead: int, key: string, nonce: string, plaintext: string, aad: string): CryptoResult =
    if (aead == TLS_AEAD_CHACHA20_POLY1305) chaCha20Poly1305Seal(key, nonce, plaintext, aad)
    else aesGcmEncrypt(key, nonce, plaintext, aad)

private fun tlsOpen(aead: int, key: string, nonce: string, sealed: string, aad: string): CryptoResult =
    if (aead == TLS_AEAD_CHACHA20_POLY1305) chaCha20Poly1305Open(key, nonce, sealed, aad)
    else aesGcmDecrypt(key, nonce, sealed, aad)

/** The key length of an AEAD, 0 for one this layer does not know. */
fun tlsAeadKeyLength(aead: int): int =
    if (aead == TLS_AEAD_AES_128_GCM) 16
    else if (aead == TLS_AEAD_AES_256_GCM || aead == TLS_AEAD_CHACHA20_POLY1305) 32 else 0

/** The per-record nonce: the IV with the sequence number (big-endian, left-padded to 12 bytes) xored in. */
fun tlsRecordNonce(iv: string, sequence: int): string {
    val bytes: array<int> = []
    var index = 0
    while (index < iv.size) {
        val shift = (iv.size - 1 - index) * 8
        val sequenceByte = if (shift < 64) (sequence >>> shift) & 255 else 0
        bytes.append(iv[index] ^ sequenceByte)
        index = index + 1
    }
    cryptoByteString(bytes)
}

/** A record header: type, legacy version, payload length. */
class TlsRecordHeader(val ok: bool, val type: int, val version: int, val length: int)

private fun tlsHeaderBytes(type: int, version: int, length: int): string =
    cryptoByteString([type, (version >> 8) & 255, version & 255, (length >> 8) & 255, length & 255])

/** A plaintext record (used before the handshake keys exist): a header with the legacy version
 *  (0x0301 on a first ClientHello for compatibility, else 0x0303), then the content as is. */
fun tlsPlaintextRecord(type: int, version: int, content: string): string {
    if (content.size <= TLS_MAX_PLAINTEXT) return tlsHeaderBytes(type, version, content.size) + content
    // A message longer than a record (a certificate chain, say) is split over several (RFC 8446 section 5.1).
    var records = ""
    var offset = 0
    while (offset < content.size) {
        val end = if (content.size - offset > TLS_MAX_PLAINTEXT) offset + TLS_MAX_PLAINTEXT else content.size
        records = records + tlsHeaderBytes(type, version, end - offset) + content.slice(offset, end)
        offset = end
    }
    records
}

/** Reads the 5-byte header at `offset` of `data`. `ok` is false when fewer than five bytes remain. */
fun tlsParseRecordHeader(data: string, offset: int): TlsRecordHeader {
    if (data.size - offset < 5) return TlsRecordHeader(false, 0, 0, 0)
    TlsRecordHeader(true, data[offset], data[offset + 1] * 256 + data[offset + 2],
        data[offset + 3] * 256 + data[offset + 4])
}

/** The result of opening one record: the inner content type and the content. */
class TlsOpenedRecord(val ok: bool, val type: int, val content: string, val error: string)

private fun tlsOpenFailed(error: string): TlsOpenedRecord = TlsOpenedRecord(false, 0, "", error)

/** Protects one record's content: the 5-byte header (application_data, 0x0303), then the AEAD of
 *  content || type || `padding` zero bytes. The result's bytes are the whole record; `ok` is false
 *  for a content longer than 2^14 or an unusable key. */
fun tlsProtectRecord(var protection: TlsRecordProtection, contentType: int, content: string,
    padding: int = 0): CryptoResult {
    if (content.size > TLS_MAX_PLAINTEXT) return cryptoFailed("tls: record content longer than 2^14")
    // The inner plaintext (content, type, padding) is at most 2^14 + 1 bytes (section 5.4).
    if (padding < 0 || content.size + 1 + padding > TLS_MAX_PLAINTEXT + 1) {
        return cryptoFailed("tls: record padding out of range")
    }
    if (protection.sequence >= TLS_MAX_SEQUENCE) return cryptoFailed("tls: the record sequence number is exhausted")
    val zeros: array<int> = []
    while (zeros.size < padding) zeros.append(0)
    val inner = content + cryptoByteString([contentType]) + cryptoByteString(zeros)
    val header = tlsHeaderBytes(TLS_APPLICATION_DATA, 771, inner.size + 16)
    val sealed = tlsSeal(protection.aead, protection.key, tlsRecordNonce(protection.iv, protection.sequence),
        inner, header)
    if (!sealed.ok) return sealed
    protection.sequence = protection.sequence + 1
    CryptoResult(header + sealed.bytes, true, "")
}

/** Opens one whole record (header included) that `protection` protected: checks the header (type
 *  application_data, version 0x0303, a length that matches `record` and is at most 2^14 + 256),
 *  authenticates and decrypts, strips the zero padding and the content type. A record that is all
 *  zeros inside, or whose content exceeds 2^14, is refused. */
fun tlsOpenRecord(var protection: TlsRecordProtection, record: string): TlsOpenedRecord {
    val header = tlsParseRecordHeader(record, 0)
    if (!header.ok) return tlsOpenFailed("tls: a record shorter than its header")
    if (header.type != TLS_APPLICATION_DATA || header.version != 771) {
        return tlsOpenFailed("tls: not a protected record (type ${header.type}, version ${header.version})")
    }
    if (header.length > TLS_MAX_CIPHERTEXT) return tlsOpenFailed("tls: record overflow")
    if (header.length != record.size - 5) return tlsOpenFailed("tls: the record length does not match")
    if (header.length < 17) return tlsOpenFailed("tls: a protected record shorter than its tag and type")
    if (protection.sequence >= TLS_MAX_SEQUENCE) return tlsOpenFailed("tls: the record sequence number is exhausted")
    val opened = tlsOpen(protection.aead, protection.key, tlsRecordNonce(protection.iv, protection.sequence),
        record.slice(5, record.size), record.slice(0, 5))
    if (!opened.ok) return tlsOpenFailed("tls: bad record MAC")
    protection.sequence = protection.sequence + 1
    // RFC 8446 section 5.4: the inner plaintext (content, type and padding) is at most 2^14 + 1 bytes.
    if (opened.bytes.size > TLS_MAX_PLAINTEXT + 1) return tlsOpenFailed("tls: record overflow")
    var end = opened.bytes.size
    while (end > 0 && opened.bytes[end - 1] == 0) end = end - 1
    if (end == 0) return tlsOpenFailed("tls: a record with no content type")
    if (end - 1 > TLS_MAX_PLAINTEXT) return tlsOpenFailed("tls: record overflow")
    TlsOpenedRecord(true, opened.bytes[end - 1], opened.bytes.slice(0, end - 1), "")
}
