// A TLS 1.3 client connection over a TCP socket: abla/tls/pure/client driven by the socket. `read` returns ""
// at the end of the stream with an empty `lastError`, and "" with the reason on a timeout or failure; `write`
// returns the bytes taken or -1. The certificate check is the configuration's (abla/tls/pure/verify). The
// hosted-API-compatible calls (tlsConnect and the rest) are in abla/tls/pure.

import "abla/dns"
import "abla/random"
import "abla/sys/linux/net"
import "abla/sys/linux/process"
import "abla/tls/pure/client"

/** Secure random bytes for the handshake (the client's random, its session id, its key shares). */
fun tlsPureRandom(count: int): string {
    val result = secureRandomBytes(count)
    if (result.succeeded) result.bytes else ""
}

/** Why a connection is not usable, as a stage: what the hosted API calls them (1 configuration, 2 tcp_connect,
 *  9 handshake, 10 certificate_verification, 13 timed out), or 0 for none. */
class TlsPureStatus(val stage: int, val message: string)

resource class TlsPureConnection(var tcp: TcpConnection, var client: TlsClient, var lastError: string,
    var stage: int) {
    fun drop(): void {
        if (this.tcp.descriptor >= 0) {
            this.client.close()
            this.tcp.close()
        }
        return
    }
}

private fun TlsPureConnection.flush(): bool {
    val data = this.client.takeOutput()
    if (data.size == 0) return true
    val result = this.tcp.writeResult(data)
    if (!result.succeeded()) {
        this.lastError = if ((result.timedOut() || result.errorCode == 11)) "TLS read or write timed out" else "TLS write failed"
        this.stage = if ((result.timedOut() || result.errorCode == 11)) 13 else 9
        return false
    }
    true
}

private fun tlsPureDeadlineWait(deadline: int, timeout: int): int {
    if (deadline == 0) return timeout
    val left = deadline - linuxMonotonicMilliseconds()
    if (left <= 0) 0 else if (timeout < left) timeout else left
}

/** Runs the handshake over a connected socket, whose ownership passes in (it is closed on failure).
 *  `timeoutMilliseconds` bounds each wait of the handshake, `deadline` (an absolute monotonic millisecond
 *  time, 0 for none) the whole of it; afterwards reads and writes wait up to `readWriteTimeoutMilliseconds`
 *  (0 waits as long as it takes). Check `ok()`: on failure `lastError` and `stage` say why. */
fun tlsPureUpgrade(var tcp: TcpConnection, config: TlsClientConfig, timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000, deadline: int = 0,
    identity: TlsClientIdentity? = null): TlsPureConnection {
    // The socket's ownership passes to the connection: the caller's handle is emptied.
    val owned = TcpConnection(tcp.descriptor)
    tcp.descriptor = -1
    var connection = TlsPureConnection(move(owned), tlsClientNew(config), "", 0)
    var running = connection.tcp.descriptor >= 0
    if (!running) {
        connection.lastError = "TLS failed at socket_attach"
        connection.stage = 8
        return connection
    }
    if (identity != null) connection.client.useIdentity(identity)
    connection.tcp.setTimeouts(timeoutMilliseconds, timeoutMilliseconds)
    running = connection.flush()
    while (running && !connection.client.connected() && !connection.client.failed()) {
        val wait = tlsPureDeadlineWait(deadline, timeoutMilliseconds)
        if (wait <= 0) {
            connection.lastError = "TLS read or write timed out"
            connection.stage = 13
            running = false
        } else {
            connection.tcp.setTimeouts(wait, wait)
            val received = connection.tcp.readResult(16384)
            if (received.hasData()) {
                connection.client.feed(received.bytes)
                running = connection.flush()
            } else {
                connection.lastError = if ((received.timedOut() || received.errorCode == 11)) "TLS read or write timed out"
                    else if (received.reachedEof()) "TLS failed at handshake: the connection closed"
                    else "TLS failed at handshake"
                connection.stage = if ((received.timedOut() || received.errorCode == 11)) 13 else 9
                running = false
            }
        }
    }
    if (connection.client.failed()) {
        connection.flush()
        connection.lastError = connection.client.error
        connection.stage = if (connection.client.certificateRejected) 10 else 9
    }
    if (!connection.client.connected()) {
        connection.tcp.close()
    } else {
        connection.tcp.setTimeouts(readWriteTimeoutMilliseconds, readWriteTimeoutMilliseconds)
    }
    connection
}

/** Connects (a host name, an IPv4 or IPv6 address; "localhost" goes to ::1) and runs the handshake. */
fun tlsPureConnect(config: TlsClientConfig, port: int = 443, timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000, deadline: int = 0,
    identity: TlsClientIdentity? = null): TlsPureConnection {
    val connectTimeout = tlsPureDeadlineWait(deadline,
        if (timeoutMilliseconds > 10000) 10000 else timeoutMilliseconds)
    var tcp = if (connectTimeout <= 0) TcpConnection(-1)
        else if (config.host == "localhost") tcpConnectIpv6(ipv6Loopback(port), connectTimeout)
        else tcpConnectHost(config.host, port, connectTimeout, deadline)
    if (tcp.descriptor < 0) {
        val failed = TlsPureConnection(TcpConnection(-1), tlsClientNew(config), "TLS failed at tcp_connect", 2)
        return failed
    }
    tlsPureUpgrade(tcp, config, timeoutMilliseconds, readWriteTimeoutMilliseconds, deadline, identity)
}

fun TlsPureConnection.ok(): bool = this.tcp.descriptor >= 0 && this.client.connected()

/** Up to `maximum` bytes of application data; "" at the end of the stream (`lastError` is "") or on a
 *  timeout or failure (`lastError` says why; a timed-out read can be repeated). */
fun TlsPureConnection.read(maximum: int = 65536): string {
    this.lastError = ""
    this.stage = 0
    while (true) {
        val buffered = this.client.applicationData
        if (buffered.size > 0) {
            if (buffered.size <= maximum) return this.client.takeApplicationData()
            this.client.applicationData = buffered.slice(maximum, buffered.size)
            return buffered.slice(0, maximum)
        }
        if (this.client.closed() || this.client.state == TLS_CLIENT_CLOSED) return ""
        if (this.client.failed()) {
            this.lastError = this.client.error
            this.stage = 9
            return ""
        }
        if (this.tcp.descriptor < 0) return ""
        val received = this.tcp.readResult(16384)
        if (received.hasData()) {
            this.client.feed(received.bytes)
            this.flush()
        } else if (received.reachedEof()) {
            // The peer closed the stream without close_notify: a truncation, not a clean end.
            if (!this.client.closed()) {
                this.lastError = "TLS connection closed without close_notify"
                this.stage = 9
            }
            return ""
        } else {
            this.lastError = if ((received.timedOut() || received.errorCode == 11)) "TLS read or write timed out" else "TLS read failed"
            this.stage = if ((received.timedOut() || received.errorCode == 11)) 13 else 9
            return ""
        }
    }
    ""
}

/** Sends all of `contents`; the bytes taken, or -1 on failure. */
fun TlsPureConnection.write(contents: string): int {
    if (!this.client.send(contents)) return -1
    if (!this.flush()) return -1
    contents.size
}

fun TlsPureConnection.close(): bool {
    if (this.tcp.descriptor >= 0) {
        this.client.close()
        this.flush()
        return this.tcp.close()
    }
    true
}
