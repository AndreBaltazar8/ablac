// A TLS 1.3 connection over a TCP socket: abla/tls/pure/client or abla/tls/pure/server driven by the socket. `read`
// returns "" at the end of the stream with an empty `lastError`, and "" with the reason on a timeout or failure;
// `write` returns the bytes taken or -1. The certificate check of a client is its configuration's
// (abla/tls/pure/verify). The hosted-API-compatible calls (tlsConnect, tlsListen and the rest) are in abla/tls/pure.

import "abla/dns"
import "abla/random"
import "abla/sys/linux/net"
import "abla/sys/linux/process"
import "abla/tls/pure/handshake"
import "abla/tls/pure/client"
import "abla/tls/pure/server"

/** Secure random bytes for the handshake (the random, the session id, the key shares). */
fun tlsPureRandom(count: int): string {
    val result = secureRandomBytes(count)
    if (result.succeeded) result.bytes else ""
}

private fun tlsPureNoVerify(chain: array<string>, host: string, scheme: int, content: string, signature: string): TlsVerdict = tlsAccepted()
private fun tlsPureNoSignature(scheme: int, content: string): string = ""

/** The state machine nobody uses in a connection of the other kind: cheap, no key generation. */
private fun tlsPurePlaceholderClient(): TlsClient =
    tlsClientStartWith(tlsClientConfig("", tlsPureNoVerify, tlsPureRandom), "", "", "", [], 769)

private fun tlsPurePlaceholderServer(): TlsServer =
    tlsServerNew(tlsServerConfig(TlsIdentity([], [], tlsPureNoSignature), tlsPureRandom))

/** A connection: a socket and the state machine that speaks TLS on it, a client's or a server's (the other is an
 *  unused placeholder; `isServer` says which). `stage` is why it is unusable, as the hosted API numbers them: 0 none,
 *  1 configuration, 2 tcp_connect, 8 socket_attach, 9 handshake, 10 certificate_verification, 12 server handshake,
 *  13 timed out. */
resource class TlsPureConnection(var tcp: TcpConnection, var client: TlsClient, var server: TlsServer,
    var isServer: bool, var lastError: string, var stage: int, var broken: bool = false,
    var brokenStage: int = 9) {
    fun drop(): void {
        if (this.tcp.descriptor >= 0) {
            // close_notify goes out best effort (a broken connection has nothing sane to send).
            this.closeMachine()
            if (!this.broken) this.flush()
            this.tcp.close()
        }
        return
    }
}

// ---- the machine behind the connection, whichever kind ----
private fun TlsPureConnection.takeOutput(): string = if (this.isServer) this.server.takeOutput() else this.client.takeOutput()

private fun TlsPureConnection.feedMachine(data: string): void {
    if (this.isServer) this.server.feed(data) else this.client.feed(data)
    return
}

private fun TlsPureConnection.pending(): string =
    if (this.isServer) this.server.applicationData else this.client.applicationData

private fun TlsPureConnection.takePending(): string =
    if (this.isServer) this.server.takeApplicationData() else this.client.takeApplicationData()

private fun TlsPureConnection.setPending(data: string): void {
    if (this.isServer) this.server.applicationData = data else this.client.applicationData = data
    return
}

private fun TlsPureConnection.sendData(data: string): bool =
    if (this.isServer) this.server.send(data) else this.client.send(data)

private fun TlsPureConnection.closeMachine(): void {
    if (this.isServer) this.server.close() else this.client.close()
    return
}

fun TlsPureConnection.connected(): bool = if (this.isServer) this.server.connected() else this.client.connected()
fun TlsPureConnection.machineFailed(): bool = if (this.isServer) this.server.failed() else this.client.failed()
fun TlsPureConnection.machineError(): string = if (this.isServer) this.server.error else this.client.error
fun TlsPureConnection.machineClosed(): bool = if (this.isServer) this.server.closed() else this.client.closed()

private fun TlsPureConnection.machineEnded(): bool =
    if (this.isServer) this.server.state == TLS_SERVER_CLOSED else this.client.state == TLS_CLIENT_CLOSED

private fun TlsPureConnection.certificateRejected(): bool = !this.isServer && this.client.certificateRejected

/** The cipher suite negotiated (0 before the handshake ends). */
fun TlsPureConnection.suite(): int = if (this.isServer) this.server.suite else this.client.suite

/** The negotiated ALPN protocol, "" for none. */
fun TlsPureConnection.alpn(): string = if (this.isServer) this.server.alpn() else this.client.alpn()

/** True when a client certificate was presented and accepted (a server connection). */
fun TlsPureConnection.clientCertificateVerified(): bool = this.isServer && this.server.clientCertificateVerified()

/** The peer's certificate chain (DER, end entity first): the client's on a server connection (empty when it sent
 *  none), the server's on a client connection. */
fun TlsPureConnection.peerChain(): array<string> = if (this.isServer) this.server.clientChain else this.client.chain

/** Whether the peer's certificate was verified by the configured verifier: on a server connection the client's (false when it
 *  sent none), on a client connection the server's (true once connected: a client that does not verify aborts). */
fun TlsPureConnection.peerVerified(): bool =
    if (this.isServer) this.server.clientCertificateVerified() else this.client.connected() && this.client.chain.size > 0

private fun TlsPureConnection.flush(): bool {
    val data = this.takeOutput()
    if (data.size == 0) return true
    val result = this.tcp.writeResult(data)
    if (!result.succeeded()) {
        // Part of a record may be on the wire: nothing more can be written to this stream (a timeout is final).
        this.broken = true
        val timedOut = result.timedOut() || result.errorCode == 11
        this.lastError = if (timedOut) "TLS read or write timed out" else "TLS write failed"
        this.stage = if (timedOut) 13 else 9
        this.brokenStage = this.stage
        return false
    }
    true
}

private fun tlsPureDeadlineWait(deadline: int, timeout: int): int {
    if (deadline == 0) return timeout
    val left = deadline - linuxMonotonicMilliseconds()
    if (left <= 0) 0 else if (timeout < left) timeout else left
}

/** The socket's ownership passes to the connection: the caller's handle is emptied. */
private fun tlsPureTake(var tcp: TcpConnection): TcpConnection {
    val owned = TcpConnection(tcp.descriptor)
    tcp.descriptor = -1
    owned
}

/** Runs the handshake until the machine is connected or failed (a timeout during it is a handshake failure, as in the hosted
 *  module: stage 9 or 12, with the text of the timeout in `lastError`). `timeoutMilliseconds` bounds each wait, `deadline`
 *  (an absolute monotonic millisecond time, 0 for none) the whole of it; the failure stage is `failStage` for a
 *  handshake error (9 for a client, 12 for a server). */
private fun TlsPureConnection.handshake(timeoutMilliseconds: int, deadline: int, failStage: int): void {
    var running = this.flush()
    while (running && !this.connected() && !this.machineFailed()) {
        val wait = tlsPureDeadlineWait(deadline, timeoutMilliseconds)
        if (wait <= 0) {
            this.lastError = "TLS read or write timed out"
            this.stage = failStage
            running = false
        } else {
            this.tcp.setTimeouts(wait, wait)
            val received = this.tcp.readResult(16384)
            if (received.hasData()) {
                this.feedMachine(received.bytes)
                running = this.flush()
            } else {
                val timedOut = received.timedOut() || received.errorCode == 11
                this.lastError = if (timedOut) "TLS read or write timed out"
                    else if (received.reachedEof()) "TLS failed at handshake: the connection closed"
                    else "TLS failed at handshake"
                this.stage = failStage
                running = false
            }
        }
    }
    if (this.machineFailed()) {
        this.flush()
        this.lastError = this.machineError()
        this.stage = if (this.certificateRejected()) 10 else failStage
    }
    return
}

/** Runs a client handshake over a connected socket, whose ownership passes in (it is closed on failure). Check
 *  `ok()`: on failure `lastError` and `stage` say why. */
fun tlsPureUpgrade(var tcp: TcpConnection, config: TlsClientConfig, timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000, deadline: int = 0,
    identity: TlsIdentity? = null): TlsPureConnection {
    val owned = tlsPureTake(tcp)
    var connection = TlsPureConnection(move(owned), tlsClientNew(config), tlsPurePlaceholderServer(),
        false, "", 0)
    if (connection.tcp.descriptor < 0) {
        connection.lastError = "TLS failed at socket_attach"
        connection.stage = 8
        return connection
    }
    if (identity != null) connection.client.useIdentity(identity)
    // A socket that already has limits keeps them, through the handshake and after (as abla/tls/hosted does).
    // (The handshake sets each wait's limit itself, so the socket's own are read first and put back after it.)
    val ownLimits = linuxSocketHasTimeouts(connection.tcp.descriptor)
    val ownRead = linuxSocketTimeoutMilliseconds(connection.tcp.descriptor, 20)
    val ownWrite = linuxSocketTimeoutMilliseconds(connection.tcp.descriptor, 21)
    if (!ownLimits) connection.tcp.setTimeouts(timeoutMilliseconds, timeoutMilliseconds)
    connection.handshake(timeoutMilliseconds, deadline, 9)
    if (!connection.connected()) {
        connection.tcp.close()
    } else if (ownLimits) {
        connection.tcp.setTimeouts(ownRead, ownWrite)
    } else {
        connection.tcp.setTimeouts(readWriteTimeoutMilliseconds, readWriteTimeoutMilliseconds)
    }
    connection
}

/** Connects (a host name, an IPv4 or IPv6 address; "localhost" goes to ::1) and runs the handshake. */
fun tlsPureConnect(config: TlsClientConfig, port: int = 443, timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000, deadline: int = 0,
    identity: TlsIdentity? = null): TlsPureConnection {
    val connectTimeout = tlsPureDeadlineWait(deadline,
        if (timeoutMilliseconds > 10000) 10000 else timeoutMilliseconds)
    var tcp = if (connectTimeout <= 0) TcpConnection(-1)
        else if (config.host == "localhost") tcpConnectIpv6(ipv6Loopback(port), connectTimeout)
        else tcpConnectHost(config.host, port, connectTimeout, deadline)
    if (tcp.descriptor < 0) {
        val failed = TlsPureConnection(TcpConnection(-1), tlsClientNew(config), tlsPurePlaceholderServer(), false,
            "TLS failed at tcp_connect", 2)
        return failed
    }
    tlsPureUpgrade(tcp, config, timeoutMilliseconds, readWriteTimeoutMilliseconds, deadline, identity)
}

/** Runs a server handshake over an accepted socket, whose ownership passes in (it is closed on failure). A client
 *  that connects and says nothing costs one handshake timeout. */
fun tlsPureServerUpgrade(var tcp: TcpConnection, config: TlsServerConfig, timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000, deadline: int = 0): TlsPureConnection {
    val owned = tlsPureTake(tcp)
    var connection = TlsPureConnection(move(owned), tlsPurePlaceholderClient(), tlsServerNew(config),
        true, "", 0)
    if (connection.tcp.descriptor < 0) {
        connection.lastError = "TLS failed at socket_attach"
        connection.stage = 8
        return connection
    }
    connection.tcp.setTimeouts(timeoutMilliseconds, timeoutMilliseconds)
    connection.handshake(timeoutMilliseconds, deadline, 12)
    if (!connection.connected()) {
        connection.tcp.close()
    } else {
        connection.tcp.setTimeouts(readWriteTimeoutMilliseconds, readWriteTimeoutMilliseconds)
    }
    connection
}

fun TlsPureConnection.ok(): bool = this.tcp.descriptor >= 0 && this.connected()

/** Up to `maximum` bytes of application data; "" at the end of the stream (`lastError` is "") or on a
 *  timeout or failure (`lastError` says why; a timed-out read can be repeated). */
fun TlsPureConnection.read(maximum: int = 65536): string {
    this.lastError = ""
    this.stage = 0
    if (maximum <= 0) {
        this.lastError = "TLS read of no bytes"
        this.stage = 9
        return ""
    }
    if (this.broken) {
        this.lastError = "TLS connection broken by an earlier write failure"
        this.stage = this.brokenStage
        return ""
    }
    while (true) {
        val buffered = this.pending()
        if (buffered.size > 0) {
            if (buffered.size <= maximum) return this.takePending()
            this.setPending(buffered.slice(maximum, buffered.size))
            return buffered.slice(0, maximum)
        }
        if (this.machineClosed() || this.machineEnded()) return ""
        if (this.machineFailed()) {
            this.lastError = this.machineError()
            this.stage = 9
            return ""
        }
        if (this.tcp.descriptor < 0) return ""
        val received = this.tcp.readResult(16384)
        if (received.hasData()) {
            this.feedMachine(received.bytes)
            this.flush()
        } else if (received.reachedEof()) {
            // The peer closed the stream without close_notify: a truncation, not a clean end.
            if (!this.machineClosed()) {
                this.lastError = "TLS connection closed without close_notify"
                this.stage = 9
            }
            return ""
        } else {
            val timedOut = received.timedOut() || received.errorCode == 11
            this.lastError = if (timedOut) "TLS read or write timed out" else "TLS read failed"
            this.stage = if (timedOut) 13 else 9
            return ""
        }
    }
    ""
}

/** Sends all of `contents`; the bytes taken, or -1 on failure. */
fun TlsPureConnection.write(contents: string): int {
    if (this.broken) {
        this.lastError = "TLS connection broken by an earlier write failure"
        this.stage = this.brokenStage
        return -1
    }
    if (!this.sendData(contents)) return -1
    if (!this.flush()) return -1
    contents.size
}

fun TlsPureConnection.close(): bool {
    if (this.tcp.descriptor >= 0) {
        this.closeMachine()
        this.flush()
        return this.tcp.close()
    }
    true
}

/** A failed client connection that never had a socket (a configuration or trust-store problem), for the API layer. */
fun tlsPureFailedConnection(config: TlsClientConfig, message: string, stage: int): TlsPureConnection =
    TlsPureConnection(TcpConnection(-1), tlsClientNew(config), tlsPurePlaceholderServer(), false, message, stage)
