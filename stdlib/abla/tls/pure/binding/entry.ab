// Channel bindings (RFC 5056) of a TLS connection, as authentication mechanisms such as SCRAM-SHA-256-PLUS
// (RFC 5802, RFC 7677) ask for them:
//   "tls-exporter"          RFC 9266: TLS-Exporter("EXPORTER-Channel-Binding", "", 32), TLS 1.3 only (TLS 1.2 needs the
//                           extended master secret, which this library does not negotiate: empty there). The value is made
//                           when the handshake completes; the exporter master secret itself is wiped as before.
//   "tls-server-end-point"  RFC 5929 section 4: the hash of the server's end-entity certificate (DER), by the hash of its
//                           signature algorithm (SHA-1 and MD5 count as SHA-256): SHA-256 for sha256WithRSA/ecdsa-with-SHA256,
//                           SHA-384, SHA-512 likewise. Where that algorithm has no single hash (Ed25519, RSA-PSS), RFC 5929
//                           leaves the binding undefined: empty. Empty also on a resumed connection (no certificate was sent).
// "tls-unique" is not offered: RFC 8446 leaves it undefined for TLS 1.3 and RFC 9266 recommends tls-exporter instead.
// The value is the raw cbind-data bytes; a mechanism prefixes the type name itself.

import "abla/crypto"
import "abla/crypto/x509"

/// Names the channel binding derived from TLS exporter keying material.
val TLS_BINDING_EXPORTER = "tls-exporter"
/// Names the channel binding derived by hashing the server certificate.
val TLS_BINDING_END_POINT = "tls-server-end-point"

/** tls-server-end-point of the DER certificate `der`, or "" when it does not parse or has no single signature hash. */
fun tlsEndPointBinding(der: string): string {
    if (der.size == 0) return ""
    val certificate = x509ParseDer(der)
    if (!certificate.ok) return ""
    val oid = certificate.signatureOid
    // sha256WithRSA, ecdsa-with-SHA256, and the weak hashes RFC 5929 maps to SHA-256 (md5WithRSA, sha1WithRSA, ecdsa-with-SHA1).
    if (oid == "1.2.840.113549.1.1.11" || oid == "1.2.840.10045.4.3.2" || oid == "1.2.840.113549.1.1.4" ||
        oid == "1.2.840.113549.1.1.5" || oid == "1.2.840.10045.4.1") return sha256(der)
    if (oid == "1.2.840.113549.1.1.12" || oid == "1.2.840.10045.4.3.3") return sha384(der)
    if (oid == "1.2.840.113549.1.1.13" || oid == "1.2.840.10045.4.3.4") return sha512(der)
    ""
}
