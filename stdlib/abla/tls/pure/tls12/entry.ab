// The building blocks of TLS 1.2 (RFC 5246, with RFC 5289's AES-GCM and RFC 7905's ChaCha20-Poly1305 suites, RFC 7627's
// extended master secret, RFC 8422's ECDHE): the PRF, the master secret and key block, the Finished value, the AEAD
// record layer, and the messages TLS 1.2 has that 1.3 does not (ServerKeyExchange, ClientKeyExchange, ServerHelloDone,
// the 1.2 Certificate and CertificateRequest). Only the modern subset: ECDHE key exchange with X25519 or P-256,
// AEAD ciphers, no CBC, no RSA key exchange, no compression, no renegotiation, the extended master secret required.
// Sans-IO: strings in, strings out.

import "abla/crypto"
import "abla/crypto/aes"
import "abla/crypto/chacha20poly1305"
import "abla/crypto/hkdf"
import "abla/crypto/result"
import "abla/tls/pure/handshake"
import "abla/tls/pure/record"

val TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256 = 49195
val TLS12_ECDHE_ECDSA_AES_256_GCM_SHA384 = 49196
val TLS12_ECDHE_RSA_AES_128_GCM_SHA256 = 49199
val TLS12_ECDHE_RSA_AES_256_GCM_SHA384 = 49200
val TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256 = 52392
val TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256 = 52393

/** The 1.2 handshake message types that 1.3 does not have. */
val TLS12_SERVER_KEY_EXCHANGE = 12
val TLS12_SERVER_HELLO_DONE = 14
val TLS12_CLIENT_KEY_EXCHANGE = 16

val TLS_EXT_EC_POINT_FORMATS = 11
val TLS_EXT_EXTENDED_MASTER_SECRET = 23
val TLS_EXT_RENEGOTIATION_INFO = 65281

val TLS_SIG_RSA_PKCS1_SHA256 = 1025
val TLS_SIG_RSA_PKCS1_SHA384 = 1281
val TLS_SIG_RSA_PKCS1_SHA512 = 1537

/** A TLS 1.2 cipher suite: its AEAD (TLS_AEAD_*), the hash of its PRF and transcript (HKDF_SHA256 / HKDF_SHA384),
 *  the key length, the length of the fixed part of the nonce (4 for AES-GCM, 12 for ChaCha20-Poly1305), and whether
 *  the server's key is an ECDSA key (else RSA). */
class Tls12Suite(val code: int, val aead: int, val hash: int, val keyLength: int, val ivLength: int, val ecdsa: bool)

fun tls12Suite(code: int): Tls12Suite? {
    if (code == TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256) return Tls12Suite(code, TLS_AEAD_AES_128_GCM, HKDF_SHA256, 16, 4, true)
    if (code == TLS12_ECDHE_ECDSA_AES_256_GCM_SHA384) return Tls12Suite(code, TLS_AEAD_AES_256_GCM, HKDF_SHA384, 32, 4, true)
    if (code == TLS12_ECDHE_RSA_AES_128_GCM_SHA256) return Tls12Suite(code, TLS_AEAD_AES_128_GCM, HKDF_SHA256, 16, 4, false)
    if (code == TLS12_ECDHE_RSA_AES_256_GCM_SHA384) return Tls12Suite(code, TLS_AEAD_AES_256_GCM, HKDF_SHA384, 32, 4, false)
    if (code == TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256) return Tls12Suite(code, TLS_AEAD_CHACHA20_POLY1305, HKDF_SHA256, 32, 12, false)
    if (code == TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256) return Tls12Suite(code, TLS_AEAD_CHACHA20_POLY1305, HKDF_SHA256, 32, 12, true)
    null
}

// ---- the PRF (RFC 5246 section 5) ----
private fun tls12Hmac(hash: int, key: string, message: string): string =
    if (hash == HKDF_SHA384) hmacSha384(key, message) else hmacSha256(key, message)

/** PRF(secret, label, seed) = P_hash(secret, label + seed), `length` bytes. */
fun tls12Prf(hash: int, secret: string, label: string, seed: string, length: int): string {
    val labeled = label + seed
    var output = ""
    var a = labeled
    while (output.size < length) {
        a = tls12Hmac(hash, secret, a)
        output = output + tls12Hmac(hash, secret, a + labeled)
    }
    output.slice(0, length)
}

/** The extended master secret (RFC 7627): PRF(premaster, "extended master secret", session hash), 48 bytes, where the
 *  session hash is the hash of the handshake messages through the ClientKeyExchange. */
fun tls12MasterSecret(hash: int, premaster: string, sessionHash: string): string =
    tls12Prf(hash, premaster, "extended master secret", sessionHash, 48)

/** The key block's four parts for a suite. */
class Tls12Keys(val clientKey: string, val serverKey: string, val clientIv: string, val serverIv: string)

fun tls12DeriveKeys(suite: Tls12Suite, master: string, serverRandom: string, clientRandom: string): Tls12Keys {
    val size = 2 * suite.keyLength + 2 * suite.ivLength
    val block = tls12Prf(suite.hash, master, "key expansion", serverRandom + clientRandom, size)
    var at = 0
    val clientKey = block.slice(at, at + suite.keyLength)
    at = at + suite.keyLength
    val serverKey = block.slice(at, at + suite.keyLength)
    at = at + suite.keyLength
    val clientIv = block.slice(at, at + suite.ivLength)
    at = at + suite.ivLength
    Tls12Keys(clientKey, serverKey, clientIv, block.slice(at, at + suite.ivLength))
}

/** verify_data of a Finished: the first 12 bytes of PRF(master, label, hash of the handshake messages), with the
 *  label "client finished" or "server finished". */
fun tls12FinishedData(hash: int, master: string, label: string, messagesHash: string): string =
    tls12Prf(hash, master, label, messagesHash, 12)

// ---- the AEAD record layer (RFC 5246 section 6.2.3.3, RFC 5288, RFC 7905) ----
/** One direction's protection: the suite's AEAD, the key, the fixed IV part, and the next sequence number. */
class Tls12Protection(val aead: int, val key: string, val iv: string, var sequence: int)

fun tls12Protection(suite: Tls12Suite, key: string, iv: string): Tls12Protection =
    Tls12Protection(suite.aead, key, iv, 0)

private fun tls12Sequence(sequence: int): string =
    cryptoByteString([(sequence >>> 56) & 255, (sequence >>> 48) & 255, (sequence >>> 40) & 255, (sequence >>> 32) & 255,
        (sequence >>> 24) & 255, (sequence >>> 16) & 255, (sequence >>> 8) & 255, sequence & 255])

/** The additional data: the sequence number, the type, the version 3.3, and the length of the plaintext. */
private fun tls12Aad(sequence: int, type: int, length: int): string =
    tls12Sequence(sequence) + cryptoByteString([type, 3, 3, (length >> 8) & 255, length & 255])

/** The ChaCha20-Poly1305 nonce: the 12-byte IV xor the sequence number (big-endian, in the last eight bytes). */
private fun tls12ChaChaNonce(iv: string, sequence: int): string {
    val bytes: array<int> = []
    val seq = tls12Sequence(sequence)
    for (i in 0 until iv.size) bytes.append(if (i < 4) iv[i] else iv[i] ^ seq[i - 4])
    cryptoByteString(bytes)
}

/** The most plaintext a TLS 1.2 record carries, and the most its payload may be (RFC 5246 section 6.2). */
val TLS12_MAX_PLAINTEXT = 16384
val TLS12_MAX_CIPHERTEXT = 18432

/** Protects one record: the whole record (header, then the AEAD payload). AES-GCM puts the 8-byte explicit nonce (the
 *  sequence number) in front of the ciphertext; ChaCha20-Poly1305 has none. `ok` false for content over 2^14. */
fun tls12Protect(var protection: Tls12Protection, type: int, content: string): CryptoResult {
    if (content.size > TLS12_MAX_PLAINTEXT) return cryptoFailed("tls: record content longer than 2^14")
    val aad = tls12Aad(protection.sequence, type, content.size)
    var body = ""
    if (protection.aead == TLS_AEAD_CHACHA20_POLY1305) {
        val sealed = chaCha20Poly1305Seal(protection.key, tls12ChaChaNonce(protection.iv, protection.sequence), content, aad)
        if (!sealed.ok) return sealed
        body = sealed.bytes
    } else {
        val explicit = tls12Sequence(protection.sequence)
        val sealed = aesGcmEncrypt(protection.key, protection.iv + explicit, content, aad)
        if (!sealed.ok) return sealed
        body = explicit + sealed.bytes
    }
    protection.sequence = protection.sequence + 1
    CryptoResult(cryptoByteString([type, 3, 3, (body.size >> 8) & 255, body.size & 255]) + body, true, "")
}

/** Opens one whole record (header included) under `protection`: authenticates (the sequence number and header are
 *  part of what is authenticated) and returns the type and content. The sequence only advances on success. */
fun tls12Open(var protection: Tls12Protection, record: string): TlsOpenedRecord {
    val header = tlsParseRecordHeader(record, 0)
    if (!header.ok) return TlsOpenedRecord(false, 0, "", "tls: a record shorter than its header")
    if (header.length != record.size - 5) return TlsOpenedRecord(false, 0, "", "tls: the record length does not match")
    if (header.length > TLS12_MAX_CIPHERTEXT) return TlsOpenedRecord(false, 0, "", "tls: record overflow")
    var plain = ""
    if (protection.aead == TLS_AEAD_CHACHA20_POLY1305) {
        if (header.length < 16) return TlsOpenedRecord(false, 0, "", "tls: a protected record shorter than its tag")
        val opened = chaCha20Poly1305Open(protection.key, tls12ChaChaNonce(protection.iv, protection.sequence),
            record.slice(5, record.size), tls12Aad(protection.sequence, header.type, header.length - 16))
        if (!opened.ok) return TlsOpenedRecord(false, 0, "", "tls: bad record MAC")
        plain = opened.bytes
    } else {
        if (header.length < 8 + 16) return TlsOpenedRecord(false, 0, "", "tls: a protected record shorter than its nonce and tag")
        val opened = aesGcmDecrypt(protection.key, protection.iv + record.slice(5, 13), record.slice(13, record.size),
            tls12Aad(protection.sequence, header.type, header.length - 8 - 16))
        if (!opened.ok) return TlsOpenedRecord(false, 0, "", "tls: bad record MAC")
        plain = opened.bytes
    }
    if (plain.size > TLS12_MAX_PLAINTEXT) return TlsOpenedRecord(false, 0, "", "tls: record overflow")
    protection.sequence = protection.sequence + 1
    TlsOpenedRecord(true, header.type, plain, "")
}

// ---- the messages ----
/** A TLS 1.2 ServerHello: the suite, the random, the session id, and which of the two extensions the subset needs the
 *  server echoed (extended_master_secret, an empty renegotiation_info). */
class Tls12ServerHello(val ok: bool, val error: string, val random: string, val sessionId: string, val suite: int,
    val extendedMasterSecret: bool, val secureRenegotiation: bool)

fun tls12ParseServerHello(body: string): Tls12ServerHello {
    val reader = tlsReader(body)
    val version = reader.u16()
    val random = reader.bytes(32)
    val sessionId = reader.vec8()
    val suite = reader.u16()
    val compression = reader.u8()
    var extensions = TlsExtensions(true, [], "")
    if (reader.remaining() > 0) extensions = tlsParseExtensions(reader)
    if (!reader.finished() || !extensions.ok) return Tls12ServerHello(false, "tls: malformed ServerHello", "", "", 0, false, false)
    if (version != 771) return Tls12ServerHello(false, "tls: unexpected ServerHello version", "", "", 0, false, false)
    if (compression != 0) return Tls12ServerHello(false, "tls: a ServerHello with compression", "", "", 0, false, false)
    var ems = false
    var renegotiation = false
    for (extension in extensions.list) {
        if (extension.type == TLS_EXT_EXTENDED_MASTER_SECRET && extension.data.size == 0) ems = true
        if (extension.type == TLS_EXT_RENEGOTIATION_INFO && extension.data == tlsU8(0)) renegotiation = true
    }
    Tls12ServerHello(true, "", random, sessionId, suite, ems, renegotiation)
}

/** A ServerHello message for TLS 1.2 (version 3.3, no supported_versions): the echo of the session id, the suite,
 *  extended_master_secret, an empty renegotiation_info, and ec_point_formats (uncompressed) if the client sent it. */
fun tls12BuildServerHello(random: string, sessionId: string, suite: int): string =
    tlsHandshakeMessage(TLS_SERVER_HELLO, tlsU16(771) + random + tlsVec8(sessionId) + tlsU16(suite) + tlsU8(0) +
        tlsVec16(tlsExtension(TLS_EXT_RENEGOTIATION_INFO, tlsU8(0)) + tlsExtension(TLS_EXT_EXTENDED_MASTER_SECRET, "")))

/** The Certificate message of TLS 1.2: a three-byte-length list of three-byte-length certificates. */
fun tls12BuildCertificate(chain: array<string>): string {
    var list = ""
    for (der in chain) list = list + tlsVec24(der)
    tlsHandshakeMessage(TLS_CERTIFICATE, tlsVec24(list))
}

fun tls12ParseCertificate(body: string): TlsCertificateMessage {
    val reader = tlsReader(body)
    val list = tlsReader(reader.vec24())
    val chain: array<string> = []
    while (list.remaining() > 0 && list.ok) chain.append(list.vec24())
    if (!reader.finished() || !list.finished()) return TlsCertificateMessage(false, "tls: malformed Certificate", "", chain)
    TlsCertificateMessage(true, "", "", chain)
}

/** The ECDHE parameters a ServerKeyExchange carries and its signature covers: a named curve and the public point. */
fun tls12EcdheParams(group: int, point: string): string = tlsU8(3) + tlsU16(group) + tlsVec8(point)

/** What a ServerKeyExchange signs: the client random, the server random, the parameters. */
fun tls12SignedParams(clientRandom: string, serverRandom: string, params: string): string =
    clientRandom + serverRandom + params

fun tls12BuildServerKeyExchange(group: int, point: string, scheme: int, signature: string): string =
    tlsHandshakeMessage(TLS12_SERVER_KEY_EXCHANGE, tls12EcdheParams(group, point) + tlsU16(scheme) + tlsVec16(signature))

class Tls12ServerKeyExchange(val ok: bool, val error: string, val group: int, val point: string, val params: string,
    val scheme: int, val signature: string)

fun tls12ParseServerKeyExchange(body: string): Tls12ServerKeyExchange {
    val reader = tlsReader(body)
    val curveType = reader.u8()
    val group = reader.u16()
    val point = reader.vec8()
    val paramsEnd = reader.position
    val scheme = reader.u16()
    val signature = reader.vec16()
    if (!reader.finished() || curveType != 3) return Tls12ServerKeyExchange(false, "tls: malformed ServerKeyExchange", 0, "", "", 0, "")
    Tls12ServerKeyExchange(true, "", group, point, body.slice(0, paramsEnd), scheme, signature)
}

fun tls12BuildClientKeyExchange(point: string): string = tlsHandshakeMessage(TLS12_CLIENT_KEY_EXCHANGE, tlsVec8(point))

/** The point of a ClientKeyExchange body, "" when malformed. */
fun tls12ParseClientKeyExchange(body: string): string {
    val reader = tlsReader(body)
    val point = reader.vec8()
    if (!reader.finished()) return ""
    point
}

fun tls12BuildServerHelloDone(): string = tlsHandshakeMessage(TLS12_SERVER_HELLO_DONE, "")

/** A CertificateRequest of TLS 1.2: the certificate types (ecdsa_sign 64, rsa_sign 1), the signature schemes, no
 *  certificate authorities. */
fun tls12BuildCertificateRequest(schemes: array<int>): string {
    var list = ""
    for (scheme in schemes) list = list + tlsU16(scheme)
    tlsHandshakeMessage(TLS_CERTIFICATE_REQUEST, tlsVec8(tlsU8(64) + tlsU8(1)) + tlsVec16(list) + tlsVec16(""))
}

/** The schemes of a 1.2 CertificateRequest, empty when malformed. */
fun tls12ParseCertificateRequest(body: string): array<int> {
    val schemes: array<int> = []
    val reader = tlsReader(body)
    reader.vec8()
    val list = tlsReader(reader.vec16())
    reader.vec16()
    if (!reader.finished()) return schemes
    while (list.remaining() > 1 && list.ok) schemes.append(list.u16())
    schemes
}
