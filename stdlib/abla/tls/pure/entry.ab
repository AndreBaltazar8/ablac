// TLS 1.3 and 1.2 (the modern subset) in Abla, with the calls of abla/tls/hosted (the OpenSSL-backed module): `tlsConnect`,
// `tlsConnectWithCa`, `tlsUpgrade`, `TlsConnection` with `handle`, `read`, `write`, `setTimeouts`, `close`,
// `tlsLastError` and `tlsAvailable`, so a program (and abla/http/tls, abla/websocket/tls) switches by changing
// its import. No OpenSSL, no libc: abla/tls/pure/client over the socket of abla/sys/linux/net, the system trust
// store (or a CA file) and abla/crypto/x509 for the certificate check.
//
// Differences from the hosted module, for now: TLS 1.2 only in its modern subset (ECDHE with X25519 or P-256, AEAD
// ciphers, the extended master secret required: a server without those fails the handshake; no CBC, no RSA key
// exchange, no renegotiation), no session resumption. Client certificates: tlsConnectWithIdentity with tlsClientIdentityFromPem (RSA, ECDSA P-256
// and Ed25519 keys) and tlsClientIdentityFromPkcs12 (PBES2 containers); the server side: tlsListen, TlsListener,
// tlsServerUpgrade. The last error is a stage, as there:
// "TLS failed at handshake", "TLS failed at certificate_verification", "TLS read or write timed out";
// `TlsConnection.detail`
// has the specific reason of the last failure on that connection.

import "abla/crypto/x509"
import "abla/process/environment"
import "abla/process/time"
import "abla/sys/linux/fs"
import "abla/sys/linux"
import "abla/sys/linux/net"
import "abla/sys/linux/process"
import "abla/tls/pure/client"
import "abla/tls/pure/connection"
import "abla/tls/pure/handshake"
import "abla/tls/pure/server"
import "abla/tls/pure/identity"
import "abla/tls/pure/verify"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// The calling thread's last error, a stage code in thread-local storage (as in abla/tls/hosted).
@inline
trusted fun pureTlsErrorSlot(): i64* =
    nativePointerFromAddress(nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00"))

trusted fun pureTlsSetError(code: int): void {
    ablaUnsafeStoreI64(pureTlsErrorSlot(), code)
    return
}

private fun pureTlsErrorText(code: int): string = when (code) {
    0 -> ""
    1 -> "TLS failed at configuration"
    2 -> "TLS failed at tcp_connect"
    4 -> "TLS failed at trust_store"
    8 -> "TLS failed at socket_attach"
    9 -> "TLS failed at handshake"
    10 -> "TLS failed at certificate_verification"
    11 -> "TLS certificate, private key, or listener failed"
    12 -> "TLS server handshake failed"
    13 -> "TLS read or write timed out"
    14 -> "TLS failed at client_identity: no usable client certificate and key"
    else -> "TLS failed"
}

fun tlsAvailable(): bool = true

trusted fun tlsLastError(): string = pureTlsErrorText(ablaUnsafeLoadI64(pureTlsErrorSlot()))


private val tlsDefaultReadWriteTimeoutMilliseconds = 30000

// The system trust store, parsed once per process (about 6 ms in a release build) on first use and kept in a transactional
// variable: the one kind of mutable global a `thread {}` may reach. Two threads that find it empty both parse, and the
// first to commit wins; an empty result is not kept (a bundle installed later is found).
private var pureTlsSystemCache: X509TrustStore? by TVar<X509TrustStore?>(null)

private fun pureTlsSystemBundle(): X509TrustStore {
    val kept = atomic { pureTlsSystemCache }
    if (kept != null) return kept
    val loaded = x509SystemTrustStore()
    if (loaded.certificates.size == 0) return loaded
    atomic {
        if (pureTlsSystemCache == null) pureTlsSystemCache = loaded
    }
    loaded
}

// What OpenSSL honours (so the programs and tests that point it at a certificate keep working): NIX_SSL_CERT_FILE and
// SSL_CERT_FILE name a bundle that replaces the system one, SSL_CERT_DIR a directory of certificate files; else the
// system bundle (parsed once per process).
private fun pureTlsLoadTrust(): X509TrustStore {
    // A variable that is set names the trust the user wants: if its file is missing or holds no certificate the result
    // is an empty store (nothing verifies), never the system bundle (which would widen the trust). Set but empty counts
    // as set and names nothing, as OpenSSL reads it.
    for (name in ["NIX_SSL_CERT_FILE", "SSL_CERT_FILE"]) {
        val variable = processEnvironment(name)
        if (variable != null) {
            val store = if (variable == "") null else x509TrustStoreFromFile(variable)
            return if (store != null) store else X509TrustStore([])
        }
    }
    val directory = processEnvironment("SSL_CERT_DIR")
    if (directory != null) {
        val certificates: array<X509Certificate> = []
        if (directory == "") return X509TrustStore(certificates)
        for (entry in path(directory).entries()) {
            if (certificates.size < 4096) {
                val store = x509TrustStoreFromFile(entry.text)
                if (store != null) {
                    for (certificate in store.certificates) certificates.append(certificate)
                }
            }
        }
        return X509TrustStore(certificates)
    }
    pureTlsSystemBundle()
}

private fun pureTlsSystemStore(): X509TrustStore = pureTlsLoadTrust()

/** The trust store a connection without a CA file uses: what SSL_CERT_FILE and its friends name, else the system bundle
 *  (parsed once per process). Empty when there is none. */
fun tlsSystemTrustStore(): X509TrustStore = pureTlsSystemStore()

private fun pureTlsNow(): int = realtimeMilliseconds() / 1000

/** A TLS connection. `handle` is -1 for a connection that failed or was closed (tlsLastError says why). */
resource class TlsConnection(var handle: int, var inner: TlsPureConnection) {
    fun drop(): void {
        // A connection whose handle was set to -1 by its owner is detached (the hosted module's idiom for handing the
        // socket to someone else, or holding it open): it is not closed here.
        if (this.handle == -1) this.inner.tcp.descriptor = -1
        this.handle = -1
        return
    }
}

/** The peer's certificate chain (DER, end entity first): the client's on a connection a listener with
 *  `tlsListenWithClientCa` accepted (empty when it sent none), the server's on one this side opened.  After a failed handshake it is the chain that was refused. */
fun TlsConnection.peerChain(): array<string> = this.inner.peerChain()

/** The DER of the peer's end-entity certificate, or "" when it sent none. */
fun TlsConnection.peerCertificate(): string {
    val chain = this.inner.peerChain()
    if (chain.size == 0) "" else chain[0]
}

/** Whether the peer presented a certificate and it verified: the client's against the listener's client CA, the server's
 *  against the trust store. A connection that failed, or whose client sent none, is false. */
fun TlsConnection.peerCertificateVerified(): bool = this.handle != -1 && this.inner.peerVerified()

private fun TlsConnection.record(): void {
    pureTlsSetError(this.inner.stage)
    return
}

// The client configuration for a CA file (read now: a missing file is a trust_store failure before any connection) or
// the system store (read when the server's certificate arrives).
private fun pureTlsConfigFor(host: string, caPath: string): TlsClientConfig? {
    if (caPath == "") return pureTlsConfigSystem(host)
    val store = pureTlsStore(caPath) ?? return null
    pureTlsConfig(host, store)
}

private fun pureTlsStore(caPath: string): X509TrustStore? {
    if (caPath == "") return pureTlsSystemStore()
    val store = x509TrustStoreFromFile(caPath)
    if (store == null || store.certificates.size == 0) return null
    store
}

private fun pureTlsConfig(host: string, store: X509TrustStore): TlsClientConfig =
    tlsClientConfig(host, tlsX509Verifier(store, pureTlsNow), tlsPureRandom)

// The system store is parsed when a certificate arrives, not when the connection starts.
private fun pureTlsConfigSystem(host: string): TlsClientConfig =
    tlsClientConfig(host, tlsX509VerifierLazy(pureTlsSystemStore, pureTlsNow), tlsPureRandom)

private fun pureTlsFailed(host: string, stage: int): TlsConnection {
    val failed = tlsPureFailedConnection(pureTlsConfig(host, X509TrustStore([])), pureTlsErrorText(stage), stage)
    pureTlsSetError(stage)
    TlsConnection(-1, move(failed))
}

private fun pureTlsOpen(host: string, caPath: string, port: int, timeoutMilliseconds: int,
    readWriteTimeoutMilliseconds: int, deadline: int, identity: TlsIdentity? = null): TlsConnection {
    if (host == "" || port <= 0 || port > 65535 || timeoutMilliseconds <= 0 || timeoutMilliseconds > 600000) {
        return pureTlsFailed(host, 1)
    }
    val config = pureTlsConfigFor(host, caPath)
    if (config == null) return pureTlsFailed(host, 4)
    val inner = tlsPureConnect(config, port, timeoutMilliseconds,
        readWriteTimeoutMilliseconds, deadline, identity)
    pureTlsSetError(inner.stage)
    val handle = if (inner.ok()) inner.tcp.descriptor else -1
    TlsConnection(handle, move(inner))
}

/** Connects to host:port over TLS 1.3, verifying the certificate chain against the system trust store and
 *  the host name. Check `handle != -1`; `tlsLastError()` says why not. */
fun tlsConnect(host: string, port: int = 443, timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0): TlsConnection =
    pureTlsOpen(host, "", port, timeoutMilliseconds, readWriteTimeoutMilliseconds, deadline)

/** Mutual TLS: as tlsConnect, presenting `identity` (tlsClientIdentityFromPem) when the server asks for a
 *  certificate, and trusting the CA file at `caPath` if it is not "". Under TLS 1.3 a server's refusal of the
 *  client certificate arrives after the handshake, so it shows as a failing first read. */
fun tlsConnectWithIdentity(host: string, identity: TlsIdentity, caPath: string = "", port: int = 443,
    timeoutMilliseconds: int = 5000, readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0): TlsConnection {
    if (!identity.ok()) return pureTlsFailed(host, 14)
    pureTlsOpen(host, caPath, port, timeoutMilliseconds, readWriteTimeoutMilliseconds, deadline, identity)
}

/** As tlsConnect, trusting the CA file at `caPath` (PEM, one or more certificates) instead of the system store. */
fun tlsConnectWithCa(host: string, caPath: string, port: int = 443, timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds): TlsConnection =
    pureTlsOpen(host, caPath, port, timeoutMilliseconds, readWriteTimeoutMilliseconds, 0)

private fun pureTlsUpgrade(var connection: TcpConnection, host: string, caPath: string, timeoutMilliseconds: int,
    readWriteTimeoutMilliseconds: int, deadline: int, identity: TlsIdentity?): TlsConnection {
    if (host == "") {
        pureTlsSetError(1)
        connection.close()
        return pureTlsFailed(host, 1)
    }
    val config = pureTlsConfigFor(host, caPath)
    if (config == null) {
        pureTlsSetError(4)
        connection.close()
        return pureTlsFailed(host, 4)
    }
    val inner = tlsPureUpgrade(connection, config, timeoutMilliseconds,
        readWriteTimeoutMilliseconds, deadline, identity)
    pureTlsSetError(inner.stage)
    val handle = if (inner.ok()) inner.tcp.descriptor else -1
    TlsConnection(handle, move(inner))
}

/** Takes ownership of an established TCP socket, including on failure; verification is as in tlsConnect. */
fun tlsUpgrade(var connection: TcpConnection, host: string, caPath: string = "", timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds): TlsConnection =
    pureTlsUpgrade(connection, host, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds, 0, null)

/** As tlsUpgrade over a Unix stream socket (the descriptor is what matters). `host` names the certificate and the
 *  server name, not the socket's path. */
fun tlsUpgrade(var connection: UnixConnection, host: string, caPath: string = "", timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds): TlsConnection {
    var stream = TcpConnection(connection.descriptor)
    connection.descriptor = -1
    pureTlsUpgrade(stream, host, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds, 0, null)
}

/** Mutual TLS over an established socket: as tlsUpgrade, presenting `identity` when the server asks (error stage 14
 *  for an unusable one, with the socket closed). */
fun tlsUpgradeWithIdentity(var connection: TcpConnection, host: string, identity: TlsIdentity, caPath: string = "",
    timeoutMilliseconds: int = 5000, readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0): TlsConnection {
    if (!identity.ok()) {
        connection.close()
        return pureTlsFailed(host, 14)
    }
    pureTlsUpgrade(connection, host, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds, deadline, identity)
}

fun tlsUpgradeWithIdentity(var connection: UnixConnection, host: string, identity: TlsIdentity, caPath: string = "",
    timeoutMilliseconds: int = 5000, readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0): TlsConnection {
    var stream = TcpConnection(connection.descriptor)
    connection.descriptor = -1
    tlsUpgradeWithIdentity(stream, host, identity, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds, deadline)
}

/** Up to `maximum` bytes. "" with `tlsLastError()` empty is the end of the stream; "" with an error is a
 *  timeout (the read can be repeated) or a failure. */
fun TlsConnection.read(maximum: int = 65536): string {
    if (this.handle == -1) return ""
    val data = this.inner.read(maximum)
    this.record()
    data
}

/** Sends `contents`; the bytes taken, or -1. A write that times out leaves the connection unusable. */
fun TlsConnection.write(contents: string): int {
    if (this.handle == -1) return -1
    val written = this.inner.write(contents)
    this.record()
    written
}

/** Replaces the limits on one read and one write; 0 waits as long as it takes. */
fun TlsConnection.setTimeouts(readMilliseconds: int, writeMilliseconds: int): bool =
    this.handle != -1 && this.inner.tcp.setTimeouts(readMilliseconds, writeMilliseconds)

/** The specific reason of the connection's last failure, "" if none. */
fun TlsConnection.detail(): string = this.inner.lastError

fun TlsConnection.close(): bool {
    if (this.handle == -1) return true
    this.handle = -1
    this.inner.close()
}

/** The socket of an open connection (what the handle is while it is open), or -1: for a poller, a socket option, a
 *  fault test. Reading or writing it directly corrupts the TLS stream. */
fun TlsConnection.descriptor(): int = if (this.handle == -1) -1 else this.inner.tcp.descriptor

/** Gives the socket back without a close_notify and without closing it: the TLS state is dropped, the peer sees
 *  whatever the caller then does with the descriptor (a reset after SO_LINGER 0, a held-open stall). The connection
 *  is closed afterwards (handle -1). Returns the descriptor, or -1 for a connection that was not open. */
fun TlsConnection.detach(): int {
    if (this.handle == -1) return -1
    val descriptor = this.inner.tcp.descriptor
    // The TLS state goes, its secrets with it (nothing reaches the peer).
    this.inner.discard()
    this.inner.tcp.descriptor = -1
    this.handle = -1
    descriptor
}

/** A connection that is not open (handle -1), the value to return where a call has nothing to return. It sets no
 *  error and has no socket. */
fun tlsFailedConnection(): TlsConnection {
    val failed = tlsPureFailedConnection(pureTlsConfig("", X509TrustStore([])), "no connection", 0)
    TlsConnection(-1, move(failed))
}

/** Whether the last failure on this thread was a read, write or handshake timeout. */
trusted fun tlsLastErrorTimedOut(): bool = ablaUnsafeLoadI64(pureTlsErrorSlot()) == 13

// ---- the server side: tlsListen, TlsListener, tlsServerUpgrade ----
private fun pureTlsServerConfig(certificatePath: string, privateKeyPath: string): TlsServerConfig? {
    val identity = tlsIdentityFromPem(linuxReadFile(certificatePath, 1048576), linuxReadFile(privateKeyPath, 1048576))
    if (!identity.ok()) return null
    tlsServerConfig(identity, tlsPureRandom)
}

/** A TLS server socket: connections are accepted with `accept` and handshaken with the listener's certificate. */
resource class TlsListener(var handle: int, var listener: TcpListener, var config: TlsServerConfig) {
    fun drop(): void {
        this.handle = -1
        // The identity was loaded for this listener: its key is cleared with it.
        this.config.identity.wipe()
        return
    }
}

/** Listens on host:port (an IPv6 or IPv4 address, "::" by default, with `dualStack` for both) with the certificate
 *  chain (PEM, the leaf first) and private key (PEM) from the two files. Check `handle != -1`; `tlsLastError()` says
 *  why not. Port 0 takes a free port (`localPort()`). */
fun tlsListen(certificatePath: string, privateKeyPath: string, host: string = "::", port: int = 443,
    backlog: int = 128, dualStack: bool = true): TlsListener =
    pureTlsListen(pureTlsServerConfig(certificatePath, privateKeyPath), host, port, backlog, dualStack)

// The server configuration that also asks for client certificates: they must chain to a CA of the PEM file `clientCaPath`
// (and be valid for client authentication). A missing file or one without a certificate gives no configuration.
private fun pureTlsServerConfigWithClientCa(certificatePath: string, privateKeyPath: string, clientCaPath: string,
    required: bool): TlsServerConfig? {
    val identity = tlsClientIdentityFromPem(linuxReadFile(certificatePath, 1048576), linuxReadFile(privateKeyPath, 1048576))
    if (!identity.ok()) return null
    val store = x509TrustStoreFromFile(clientCaPath)
    if (store == null || store.certificates.size == 0) return null
    tlsServerConfigWithClientCertificates(identity, tlsPureRandom, required, tlsX509ClientVerifier(store, pureTlsNow))
}

/** As tlsListen, and asks every client for a certificate: it must chain to one of the CA certificates in the PEM file
 *  `clientCaPath`, be valid for client authentication and prove it holds the key. A client that sends none is refused
 *  unless `required` is false, and a certificate that does not verify always fails the handshake. After `accept`, the
 *  connection's `peerCertificate()`, `peerChain()` and `peerCertificateVerified()` say who connected. Check `handle != -1`
 *  (a missing or empty CA file fails like a missing certificate: error 11). */
fun tlsListenWithClientCa(certificatePath: string, privateKeyPath: string, clientCaPath: string, host: string = "::",
    port: int = 443, backlog: int = 128, dualStack: bool = true, required: bool = true): TlsListener =
    pureTlsListen(pureTlsServerConfigWithClientCa(certificatePath, privateKeyPath, clientCaPath, required), host, port,
        backlog, dualStack)

private fun pureTlsListen(config: TlsServerConfig?, host: string, port: int, backlog: int, dualStack: bool): TlsListener {
    var listener = TcpListener(-1)
    if (config != null && port >= 0 && port <= 65535 && backlog > 0 && backlog <= 4096) {
        listener = if (linuxIpv6Words(host).size == 8) tcpListenIpv6(ipv6SocketAddress(host, port), backlog, dualStack)
            else tcpListenAddress(ipv4SocketAddress(host, port), backlog)
    }
    if (config == null || listener.descriptor < 0) {
        pureTlsSetError(11)
        return TlsListener(-1, TcpListener(-1), tlsServerConfig(TlsIdentity([], [], pureTlsNoSignature), tlsPureRandom))
    }
    pureTlsSetError(0)
    TlsListener(1, move(listener), config)
}

private fun pureTlsNoSignature(scheme: int, content: string): string = ""

fun TlsListener.localPort(): int = if (this.handle != -1) this.listener.localPort() else -1

/** The listening socket, for a poller (readable when a connection waits to be accepted), or -1. */
fun TlsListener.descriptor(): int = if (this.handle != -1) this.listener.descriptor else -1

/** Accepts one connection and runs its handshake; a client that connects and says nothing, or sends it a byte at a time,
 *  costs one handshake timeout. Check `handle != -1` of the result. */
fun TlsListener.accept(handshakeTimeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds): TlsConnection {
    if (this.handle == -1) return pureTlsFailed("", 12)
    var tcp = this.listener.accept()
    if (tcp.descriptor < 0) return pureTlsFailed("", 12)
    // The timeout bounds each wait; the deadline bounds the whole handshake, so a client that sends a byte at a time
    // cannot hold this thread for longer than the timeout.
    val deadline = linuxMonotonicMilliseconds() + handshakeTimeoutMilliseconds
    val inner = tlsPureServerUpgrade(tcp, this.config, handshakeTimeoutMilliseconds, readWriteTimeoutMilliseconds, deadline)
    pureTlsSetError(if (inner.ok()) 0 else if (inner.stage == 13) 13 else 12)
    val handle = if (inner.ok()) inner.tcp.descriptor else -1
    TlsConnection(handle, move(inner))
}

fun TlsListener.close(): bool {
    if (this.handle == -1) return true
    this.handle = -1
    this.config.identity.wipe()
    this.listener.close()
}

/** Runs the server handshake on an established (accepted) TCP socket with the certificate and key from the files;
 *  takes the socket, including on failure. */
fun tlsServerUpgrade(var connection: TcpConnection, certificatePath: string, privateKeyPath: string,
    handshakeTimeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds, deadline: int = 0): TlsConnection {
    val config = pureTlsServerConfig(certificatePath, privateKeyPath)
    if (connection.descriptor < 0 || handshakeTimeoutMilliseconds <= 0 || handshakeTimeoutMilliseconds > 600000 ||
        config == null) {
        connection.close()
        return pureTlsFailed("", 11)
    }
    val inner = tlsPureServerUpgrade(connection, config, handshakeTimeoutMilliseconds, readWriteTimeoutMilliseconds, deadline)
    // The identity was loaded for this one handshake, which is over: its key is cleared.
    config.identity.wipe()
    pureTlsSetError(if (inner.ok()) 0 else if (inner.stage == 13) 13 else 12)
    val handle = if (inner.ok()) inner.tcp.descriptor else -1
    TlsConnection(handle, move(inner))
}

/** As tlsServerUpgrade over a Unix stream socket. */
fun tlsServerUpgrade(var connection: UnixConnection, certificatePath: string, privateKeyPath: string,
    handshakeTimeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds, deadline: int = 0): TlsConnection {
    var stream = TcpConnection(connection.descriptor)
    connection.descriptor = -1
    tlsServerUpgrade(stream, certificatePath, privateKeyPath, handshakeTimeoutMilliseconds,
        readWriteTimeoutMilliseconds, deadline)
}

// ---- handles: a connection addressed by an int, for code that keeps only an int (a closure, a table of descriptors) ----
// The hosted module let a program build `TlsConnection(handle)` around an OpenSSL pointer's number. Here the state lives
// in the connection object, so the connection is moved into a process-wide table and addressed by its descriptor.
// The table is a mutable global, so these calls are for one thread (the compiler refuses to reach them from `thread {}`).

private var pureTlsHandleTable: array<TlsConnection> = []

private fun pureTlsHandleIndex(handle: int): int {
    var at = 0
    while (at < pureTlsHandleTable.size) {
        if (pureTlsHandleTable[at].handle == handle) return at
        at = at + 1
    }
    -1
}

/** Moves an open connection into the handle table and returns its handle (its descriptor); -1, with nothing kept,
 *  for a connection that is not open. `tlsClaim(handle)` takes it back, `tlsCloseHandle(handle)` closes it. */
fun tlsRelease(own connection: TlsConnection): int {
    if (connection.handle == -1) return -1
    val handle = connection.handle
    pureTlsHandleTable.append(move(connection))
    handle
}

/** Takes the connection of a handle out of the table (a not-open connection if there is none). */
fun tlsClaim(handle: int): TlsConnection {
    val at = pureTlsHandleIndex(handle)
    if (at < 0) return tlsFailedConnection()
    pureTlsHandleTable.takeAt(at)
}

/** Whether the table holds an open connection under `handle`. */
fun tlsHandleOpen(handle: int): bool = pureTlsHandleIndex(handle) >= 0

/** As TlsConnection.read on the connection of a handle ("" with tlsLastError() empty at the end of the stream; "" too
 *  for an unknown handle). */
fun tlsReadHandle(handle: int, maximum: int = 65536): string {
    val at = pureTlsHandleIndex(handle)
    if (at < 0) return ""
    pureTlsHandleTable[at].read(maximum)
}

fun tlsWriteHandle(handle: int, contents: string): int {
    val at = pureTlsHandleIndex(handle)
    if (at < 0) return -1
    pureTlsHandleTable[at].write(contents)
}

fun tlsSetTimeoutsHandle(handle: int, readMilliseconds: int, writeMilliseconds: int): bool {
    val at = pureTlsHandleIndex(handle)
    if (at < 0) return false
    pureTlsHandleTable[at].setTimeouts(readMilliseconds, writeMilliseconds)
}

/** Closes the connection of a handle (close_notify, then the socket) and forgets it. True for an unknown handle too. */
fun tlsCloseHandle(handle: int): bool {
    val at = pureTlsHandleIndex(handle)
    if (at < 0) return true
    var connection = pureTlsHandleTable.takeAt(at)
    connection.close()
}

// ---- the identity calls under the hosted module's names ----
// (The internal modules name them tlsIdentityFromPem / tlsIdentityFromPkcs12 and the class TlsIdentity, so that they
// never collide with abla/tls/hosted's names in a program that imports both.)

/** A client identity from certificate and key PEM text (the key may be PKCS#8, PKCS#1, SEC1 or encrypted PKCS#8
 *  with `passphrase`): RSA, ECDSA P-256 and Ed25519 keys. Check `identity.ok()` and `identity.error`. */
fun tlsClientIdentityFromPem(certificatePem: string, keyPem: string, passphrase: string = ""): TlsIdentity =
    tlsIdentityFromPem(certificatePem, keyPem, passphrase)

/** A client identity from a PKCS#12 container (PBES2, SHA-1 or SHA-256 MAC). */
fun tlsClientIdentityFromPkcs12(der: string, password: string): TlsIdentity = tlsIdentityFromPkcs12(der, password)

// ---- TlsSession: a client over a descriptor the caller owns and keeps non-blocking ----
//
// For a caller that polls itself (a database driver that did its own SSLRequest exchange on the socket first, say): no call
// here blocks or sets a timeout. `handshake`, `readReady` and `writeReady` do what the socket allows now and say what they
// wait for (want-read 2, want-write 3) when it does not allow more; the caller polls the descriptor for that and calls again.
// The descriptor stays the caller's: `close` sends close_notify at best and shuts the connection down, it does not close it.
// Writes use MSG_NOSIGNAL, so no SIGPIPE is raised.

/** What the peer's certificate must satisfy: nothing (the traffic is encrypted, the signature of the handshake is
 *  checked, the chain is not), a chain to a trusted root, or the chain and the host name (a DNS name or an IP address,
 *  by subjectAltName only). The server name is sent in every mode unless `host` is an IP address. */
val TLS_VERIFY_NONE = 0
val TLS_VERIFY_CHAIN = 1
val TLS_VERIFY_HOST = 2

/** The status of handshake, readReady and writeReady: 1 progress or done, 2 wants the socket readable, 3 wants it
 *  writable, 0 the peer closed the stream cleanly (reads), -1 failed (`detail` says why). */
val TLS_IO_DONE = 1
val TLS_IO_WANT_READ = 2
val TLS_IO_WANT_WRITE = 3
val TLS_IO_CLOSED = 0
val TLS_IO_FAILED = -1

/** `bytes` are what a read returned, `written` how many bytes of a write are through to the socket. */
class TlsIo(val bytes: string, val written: int, val status: int)

class TlsSession(var client: TlsClient, var descriptor: int, var pending: string, var inflight: int, var received: string,
    var failure: string, var finished: bool)

private fun pureTlsSessionStore(caPath: string): X509TrustStore {
    if (caPath == "" || caPath == "system") return pureTlsSystemStore()
    val store = x509TrustStoreFromFile(caPath)
    if (store == null) X509TrustStore([]) else store
}

private fun pureTlsSessionVerifier(mode: int, caPath: string): (array<string>, string, int, string, string) -> TlsVerdict {
    if (mode == TLS_VERIFY_HOST) return tlsX509VerifierLazy({ pureTlsSessionStore(caPath) }, pureTlsNow)
    if (mode == TLS_VERIFY_CHAIN) {
        return { chain: array<string>, host: string, scheme: int, content: string, signature: string ->
            tlsVerifyServerCertificate(chain, "", scheme, content, signature, pureTlsSessionStore(caPath), pureTlsNow(), true)
        }
    }
    { chain: array<string>, host: string, scheme: int, content: string, signature: string ->
        if (chain.size == 0) tlsRefused(TLS_VERDICT_BAD_CERTIFICATE, "no certificate") else {
            val leaf = x509ParseDer(chain[0])
            if (!leaf.ok) tlsRefused(TLS_VERDICT_DECODE_ERROR, "certificate: ${leaf.error}")
            else tlsCheckSignature(leaf, scheme, content, signature)
        }
    }
}

/** Starts a TLS client on `descriptor` (made non-blocking by the caller, connected, and already past any plaintext
 *  exchange): the ClientHello is queued, `handshake` sends it. `caPath` names a PEM file of roots ("" or "system": the
 *  system bundle, or what SSL_CERT_FILE and its friends name). A session that could not start is failed (`ok()` is false,
 *  `detail()` says why). */
fun tlsSessionClient(descriptor: int, host: string, mode: int, caPath: string = ""): TlsSession {
    val config = tlsClientConfig(host, pureTlsSessionVerifier(mode, caPath), tlsPureRandom)
    val client = tlsClientNew(config)
    val session = TlsSession(client, descriptor, "", 0, "", "", false)
    if (descriptor < 0 || host == "" || mode < TLS_VERIFY_NONE || mode > TLS_VERIFY_HOST) {
        session.failure = "TLS failed at configuration"
        session.finished = true
    }
    session
}

fun TlsSession.ok(): bool = !this.finished && this.failure == ""

fun TlsSession.descriptor(): int = this.descriptor

/** The reason of the last failure ("" if none). */
fun TlsSession.detail(): string = this.failure

private fun TlsSession.fail(reason: string): void {
    if (this.failure == "") this.failure = reason
    this.finished = true
    return
}

/** One send that never blocks and never raises SIGPIPE; the bytes sent, or -11 (EAGAIN) or another -errno. */
private trusted fun pureTlsSessionSend(descriptor: int, data: string): int {
    var result = -4
    while (result == -4) {
        result = linuxSyscall6(44, descriptor, nativeStringDataAddress(data), data.size, 16448, 0, 0)
    }
    result
}

/** One read that never blocks; the bytes, "" with `eof` or a negative errno in `code`. */
private class PureTlsSessionRead(val bytes: string, val code: int)

private trusted fun pureTlsSessionRecv(descriptor: int, maximum: int): PureTlsSessionRead {
    val buffer = nativeByteBuffer(maximum + 1)
    var count = linuxSyscall3(0, descriptor, nativePointerAddress(buffer.address), maximum)
    while (count == -4) count = linuxSyscall3(0, descriptor, nativePointerAddress(buffer.address), maximum)
    if (count > 0) return PureTlsSessionRead(buffer.adoptString(count), 0)
    buffer.close()
    PureTlsSessionRead("", if (count == 0) 1 else count)
}

/** Moves what the machine queued to the pending output and sends what the socket takes: 1 all sent, 3 the socket is full,
 *  -1 failed. */
private fun TlsSession.flush(): int {
    this.pending = this.pending + this.client.takeOutput()
    while (this.pending.size > 0) {
        val sent = pureTlsSessionSend(this.descriptor, this.pending)
        if (sent > 0) {
            this.pending = this.pending.slice(sent, this.pending.size)
        } else if (sent == -11) {
            return 3
        } else {
            this.fail("TLS write failed")
            return -1
        }
    }
    1
}

/** Reads what the socket has and gives it to the machine: 2 the socket has nothing now, 1 something was processed,
 *  0 the peer closed the stream, -1 failed. */
private fun TlsSession.pull(): int {
    val read = pureTlsSessionRecv(this.descriptor, 16384)
    if (read.bytes.size > 0) {
        this.client.feed(read.bytes)
        return 1
    }
    if (read.code == -11) return 2
    if (read.code == 1) return 0
    this.fail("TLS read failed")
    -1
}

/** Drives the handshake as far as the socket allows: 1 done, 2 wants the socket readable, 3 writable, -1 failed. */
fun TlsSession.handshake(): int {
    if (this.finished) return -1
    var status = 0
    while (status == 0) {
        val sent = this.flush()
        if (sent < 0) return -1
        if (this.client.failed()) {
            // The alert the machine queued has been offered to the socket above; the failure is final.
            this.fail(this.client.error)
            return -1
        }
        if (this.client.connected()) return if (sent == 3) 3 else 1
        if (sent == 3) {
            status = 3
        } else {
            val pulled = this.pull()
            if (pulled == 2) status = 2
            else if (pulled == 0) {
                this.fail("TLS failed at handshake: the connection closed")
                return -1
            } else if (pulled < 0) return -1
        }
    }
    status
}

/** Up to `maximum` bytes of application data: status 1 with the bytes, 2 or 3 when the socket must become readable
 *  or writable first, 0 when the peer closed the stream cleanly, -1 failed. */
fun TlsSession.readReady(maximum: int): TlsIo {
    if (maximum <= 0 || this.finished) return TlsIo("", 0, -1)
    while (true) {
        if (this.received.size == 0) this.received = this.client.takeApplicationData()
        if (this.received.size > 0) {
            val count = if (this.received.size > maximum) maximum else this.received.size
            val chunk = this.received.slice(0, count)
            this.received = this.received.slice(count, this.received.size)
            return TlsIo(chunk, 0, 1)
        }
        if (this.client.failed()) {
            this.flush()
            this.fail(this.client.error)
            return TlsIo("", 0, -1)
        }
        if (this.client.closed()) {
            this.flush()
            return TlsIo("", 0, 0)
        }
        // A KeyUpdate answer or an alert the machine queued goes out when the socket allows; a full socket does not stop a read.
        if (this.flush() < 0) return TlsIo("", 0, -1)
        val pulled = this.pull()
        if (pulled == 2) return TlsIo("", 0, 2)
        if (pulled == 0) {
            this.fail("TLS read failed: the connection closed without close_notify")
            return TlsIo("", 0, -1)
        }
        if (pulled < 0) return TlsIo("", 0, -1)
    }
    TlsIo("", 0, -1)
}

/** Writes from `bytes` at `offset`: status 1 with `written` bytes that are through to the socket (0 only when
 *  `offset` is at the end), 3 when the socket must become writable first (a partial send is kept: call again with the
 *  same arguments), -1 failed. */
fun TlsSession.writeReady(bytes: string, offset: int): TlsIo {
    if (this.finished || offset < 0) return TlsIo("", 0, -1)
    if (offset >= bytes.size && this.inflight == 0) return TlsIo("", 0, 1)
    if (this.inflight == 0) {
        val remaining = bytes.size - offset
        val count = if (remaining > 16384) 16384 else remaining
        if (!this.client.send(bytes.slice(offset, offset + count))) {
            this.fail(if (this.client.error == "") "TLS write failed: the session is not open" else this.client.error)
            return TlsIo("", 0, -1)
        }
        this.inflight = count
    }
    val sent = this.flush()
    if (sent < 0) return TlsIo("", 0, -1)
    if (sent == 3) return TlsIo("", 0, 3)
    val count = this.inflight
    this.inflight = 0
    TlsIo("", count, 1)
}

/** Best effort and never blocking: queues close_notify, offers it to the socket once and shuts the connection down in
 *  both directions. The descriptor is not closed. */
fun TlsSession.close(): void {
    if (this.descriptor >= 0 && !this.finished) {
        this.client.close()
        this.flush()
        linuxSyscall3(48, this.descriptor, 2, 0)
    }
    this.finished = true
    return
}
