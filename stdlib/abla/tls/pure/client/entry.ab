// A TLS 1.3 client as a sans-IO state machine (RFC 8446): bytes received go in with `feed`, bytes to
// send come out of `takeOutput`, decrypted application data out of `takeApplicationData`, and
// `send`/`close` queue records. No sockets, no clock, no randomness of its own: the random source is
// in the configuration, and certificate verification is a callback (the x509 layer plugs in there), so
// the RFC 8448 traces replay byte for byte.
//
// What it does: ClientHello (X25519 key share; AES-128/256-GCM suites), HelloRetryRequest (once), the
// whole key schedule, EncryptedExtensions (ALPN), Certificate and CertificateVerify (the signed content
// is built here, the verification is the configured callback's), Finished both ways (constant-time
// compare), NewSessionTicket (kept in the caller's TlsSessionCache, if there is one: abla/tls/pure/resume), KeyUpdate, alerts, close_notify, middlebox
// compatibility (ChangeCipherSpec). What it refuses: anything below TLS 1.3, a second
// HelloRetryRequest, compression, unexpected message order, a bad record or Finished, application data
// before the handshake ends. Resumption: a ticket from the cache is offered as a PSK (psk_dhe_ke), with the binder, again after a HelloRetryRequest. Not: 0-RTT.

import "abla/crypto"
import "abla/crypto/der"
import "abla/crypto/hkdf"
import "abla/crypto/mlkem"
import "abla/crypto/p256"
import "abla/crypto/p384"
import "abla/crypto/x25519"
import "abla/tls/pure/binding"
import "abla/tls/pure/handshake"
import "abla/tls/pure/keysched"
import "abla/tls/pure/record"
import "abla/tls/pure/resume"
import "abla/tls/pure/tls12"

val TLS_CLIENT_START = 0
val TLS_CLIENT_WAIT_SERVER_HELLO = 1
val TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS = 2
val TLS_CLIENT_WAIT_CERTIFICATE = 3
val TLS_CLIENT_WAIT_CERTIFICATE_VERIFY = 4
val TLS_CLIENT_WAIT_FINISHED = 5
val TLS_CLIENT_CONNECTED = 6
val TLS_CLIENT_CLOSED = 7
val TLS_CLIENT_FAILED = 8

val TLS_ALERT_CLOSE_NOTIFY = 0
val TLS_ALERT_UNEXPECTED_MESSAGE = 10
val TLS_ALERT_BAD_RECORD_MAC = 20
val TLS_ALERT_RECORD_OVERFLOW = 22
val TLS_ALERT_HANDSHAKE_FAILURE = 40
val TLS_ALERT_BAD_CERTIFICATE = 42
val TLS_ALERT_ILLEGAL_PARAMETER = 47
val TLS_ALERT_DECODE_ERROR = 50
val TLS_ALERT_DECRYPT_ERROR = 51
val TLS_ALERT_PROTOCOL_VERSION = 70
val TLS_ALERT_INTERNAL_ERROR = 80
val TLS_ALERT_MISSING_EXTENSION = 109
val TLS_ALERT_UNSUPPORTED_EXTENSION = 110
val TLS_ALERT_INAPPROPRIATE_FALLBACK = 86

/** The certificate check: the chain (DER, end entity first), the host name, the signature scheme of
 *  the CertificateVerify, the content that was signed and the signature. Returns "" when the chain is
 *  trusted for the host and the signature is valid, else the reason. */
class TlsClientConfig(
    val host: string,
    val suites: array<int>,
    val signatureAlgorithms: array<int>,
    val alpn: array<string>,
    val verifier: (array<string>, string, int, string, string) -> TlsVerdict,
    val random: (int) -> string,
    /** Builds the ClientHello that answers a HelloRetryRequest from the first one, the new key share and
     *  the cookie ("" for none); tlsPatchClientHello is the standard answer. */
    val secondHello: (string, TlsKeyShare, string) -> string,
    /** The TLS 1.2 suites (the modern subset) offered besides TLS 1.3's: [] makes a TLS 1.3-only client. */
    val suites12: array<int> = [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256, TLS12_ECDHE_RSA_AES_128_GCM_SHA256,
        TLS12_ECDHE_ECDSA_AES_256_GCM_SHA384, TLS12_ECDHE_RSA_AES_256_GCM_SHA384,
        TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256, TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256],
    /** True for a client that retries after a failed handshake with a lower version than it supports: the ClientHello
     *  then carries TLS_FALLBACK_SCSV (RFC 7507), so a server that could have done better refuses it. */
    val fallback: bool = false,
    /** The groups offered, in the client's order ([] for tlsDefaultGroups: the hybrid, X25519, P-256, P-384). The first gets a key
     *  share (with X25519's too when the first is the hybrid, as browsers do), the others are answered with a HelloRetryRequest. */
    val groups: array<int> = [],
    /** Where to find (and put) session tickets: a connection to a host that has a ticket in it offers to resume, and a ticket the server sends is kept in it
     *  (TLS 1.3, psk_dhe_ke, no 0-RTT). The caller owns the cache and shares it among connections; null: no resumption. */
    val sessions: TlsSessionCache? = null,
    /** What authenticated the server, as a name: tickets are kept and offered only under the same scope, because a resumption skips the Certificate (RFC 8446 section 4.6.1): "" (the default) keeps and offers none.
     *  tlsClientConfigWithSessions sets it; abla/tls/pure derives it from the verify mode and trust file; for tlsX509Verifier use tlsX509Scope(store). */
    val sessionScope: string = ""
)

/** An ephemeral key pair offered in the key_share extension. */
class TlsKeyPair(val group: int, val publicKey: string, val privateKey: string)

/** A certificate and its key, a client's for mutual TLS or a server's: the chain (DER, end entity first), the signature
 *  schemes its key can make, and the signing function (scheme and the content to sign give the signature, "" on
 *  failure). `secrets` are the key bytes the signing function holds, which `wipe` clears (the loaders,
 *  tlsIdentityFromPem and tlsIdentityFromPkcs12, fill them in). */
class TlsIdentity(val chain: array<string>, val schemes: array<int>, val sign: (int, string) -> string,
    val error: string = "", val secrets: array<string> = []) {
    /** True for an identity with a certificate and a key that signs. */
    fun ok(): bool = this.error == "" && this.chain.size > 0
}

/** Clears the key bytes the identity holds: it signs nothing after this. For when it is done with (a connection's
 *  identity after its handshake, a listener's when it closes). */
fun TlsIdentity.wipe(): void {
    for (secret in this.secrets) tlsWipe(secret)
    return
}

class TlsClient(
    val config: TlsClientConfig,
    var state: int,
    var error: string,
    var inbox: string,
    var handshakeBuffer: TlsHandshakeBuffer,
    var outbox: string,
    var applicationData: string,
    val transcript: TlsTranscript,
    var hash: int,
    var suite: int,
    var keyLength: int,
    var aead: int,
    val helloRandom: string,
    val sessionId: string,
    var firstHello: string,
    var keyPairs: array<TlsKeyPair>,
    var retried: bool,
    var retrySuite: int,
    var readEncrypted: bool,
    var writeEncrypted: bool,
    var read: TlsRecordProtection,
    var write: TlsRecordProtection,
    var handshakeSecret: string,
    var clientHandshakeSecret: string,
    var serverHandshakeSecret: string,
    var clientApplicationSecret: string,
    var serverApplicationSecret: string,
    var masterSecret: string,
    var chain: array<string>,
    var negotiatedAlpn: string,
    var sentCompatibilityChangeCipherSpec: bool,
    var peerClosed: bool,
    var sentClose: bool,
    /** True when the handshake failed in the certificate check (the verifier's answer). */
    var certificateRejected: bool,
    /** The identity to present when the server asks for a certificate; null presents none. */
    var identity: TlsIdentity?,
    /** The certificate request's context and schemes, once the server has sent one. */
    var requested: bool,
    var requestContext: string,
    var requestSchemes: array<int>,
    /** TLS 1.2 (set when the server's hello chooses it): the suite code, the protections, the keys, the server random,
     *  the server's key-exchange group and point. */
    var v12: bool,
    var v12Suite: int,
    var v12Read: Tls12Protection,
    var v12Write: Tls12Protection,
    var v12Keys: Tls12Keys,
    var serverRandom: string,
    var v12Group: int,
    var v12Point: string,
    /** Records in a row that carried nothing (empty application data, ChangeCipherSpec), KeyUpdates in a row, and a
     *  KeyUpdate the peer asked for that is still to be answered (once per batch of input). */
    var emptyRun: int = 0,
    var keyUpdateRun: int = 0,
    var keyUpdateOwed: bool = false,
    /** Warning alerts in a row (ignored up to four, as BoringSSL does). */
    var warningRun: int = 0,
    /** The key exchange group that was negotiated (0 until the ServerHello is processed): the group of the key share, or of the
     *  TLS 1.2 ServerKeyExchange. */
    var negotiatedGroup: int = 0,
    /** Resumption: the ticket this connection offered (null if none), whether the server accepted it, and the resumption master secret kept to make the PSKs of
     *  the tickets the server sends (a buffer of its own, wiped with the connection). */
    var offeredPsk: TlsStoredTicket? = null,
    var didResume: bool = false,
    var resumptionMaster: string = "",
    /** The tls-exporter channel binding (RFC 9266), made when the TLS 1.3 handshake completes; "" before, and on TLS 1.2. */
    var channelExporter: string = ""
)

fun tlsAeadFor(suite: int): int =
    if (suite == TLS_SUITE_AES_128_GCM_SHA256) TLS_AEAD_AES_128_GCM
    else if (suite == TLS_SUITE_AES_256_GCM_SHA384) TLS_AEAD_AES_256_GCM
    else if (suite == TLS_SUITE_CHACHA20_POLY1305_SHA256) TLS_AEAD_CHACHA20_POLY1305 else 0

fun tlsSuiteHash(suite: int): int = if (suite == TLS_SUITE_AES_256_GCM_SHA384) HKDF_SHA384 else HKDF_SHA256

// ---- Key exchange groups ----
// (A slice, and a string built with `+`, may share their memory with the string they come from, so what is made of a secret and
// outlives its wiping is copied into a buffer of its own, tlsOwnedCopy, first: the secret made of two parts, the public key sliced
// out of a decapsulation key.)
// X25519MLKEM768 (draft-ietf-tls-ecdhe-mlkem, section 4): the client's key_exchange value is the ML-KEM-768 encapsulation key (1184
// bytes) followed by an X25519 public key (32): 1216 bytes (section 4.1, which notes the order is the reverse of the naming
// convention of the hybrid design draft: "for historical reasons"); the server's is the ML-KEM ciphertext (1088) followed by its
// X25519 public key (32): 1120 bytes (section 4.2); the shared secret is the ML-KEM secret followed by the X25519 one, 64 bytes
// (section 4.3). The server checks the encapsulation key (FIPS 203 section 7.2) and aborts with illegal_parameter when it fails,
// the client checks the ciphertext length (illegal_parameter), and the X25519 part has its all-zero check (section 4.3 and
// RFC 8446 section 7.4.2). The private key of a hybrid pair is the 2400-byte decapsulation key followed by the 32-byte X25519 scalar.
val TLS_MLKEM768_CLIENT_SHARE_SIZE = 1216
val TLS_MLKEM768_SERVER_SHARE_SIZE = 1120

/** The groups a ClientHello lists when the configuration names none: the hybrid first, then the classic curves. */
fun tlsDefaultGroups(): array<int> = [TLS_GROUP_X25519_MLKEM768, TLS_GROUP_X25519, TLS_GROUP_SECP256R1, TLS_GROUP_SECP384R1]

fun tlsGroupIsHybrid(group: int): bool = group == TLS_GROUP_X25519_MLKEM768

/** The groups TLS 1.2's ECDHE can use (named curves): the hybrid is a TLS 1.3 group only. */
fun tlsGroupIsClassic(group: int): bool =
    group == TLS_GROUP_X25519 || group == TLS_GROUP_SECP256R1 || group == TLS_GROUP_SECP384R1

/** A key pair for `group` from the bytes of `random` (32 for X25519 and P-256, 48 for P-384, 64 and 32 for the hybrid's seeds and
 *  its X25519 key): null for another group. The private key is made of the random source's bytes, which the machine that uses
 *  the pair clears when it is done (tlsWipe): `random` returns fresh bytes, as tlsPureRandom does. */
fun tlsGenerateKeyPair(group: int, random: (int) -> string): TlsKeyPair? {
    if (group == TLS_GROUP_X25519) {
        val privateKey = random(32)
        val publicKey = x25519PublicKey(privateKey)
        if (!publicKey.ok) return null
        return TlsKeyPair(group, publicKey.bytes, privateKey)
    }
    if (group == TLS_GROUP_SECP256R1) {
        // A random 32-byte string is a valid scalar but for one value in 2^32: ask again.
        var attempt = 0
        while (attempt < 4) {
            val privateKey = random(32)
            val publicKey = p256PublicKey(privateKey)
            if (publicKey.ok) return TlsKeyPair(group, publicKey.bytes, privateKey)
            tlsWipe(privateKey)
            attempt = attempt + 1
        }
    }
    if (group == TLS_GROUP_SECP384R1) {
        // A random 48-byte string is a valid scalar but for one value in 2^190 or so (or a wrong length from a failing source).
        var attempt = 0
        while (attempt < 4) {
            val privateKey = random(48)
            val publicKey = p384PublicKey(privateKey)
            if (publicKey.ok) return TlsKeyPair(group, publicKey.bytes, privateKey)
            tlsWipe(privateKey)
            attempt = attempt + 1
        }
    }
    if (group == TLS_GROUP_X25519_MLKEM768) {
        val seeds = random(64)
        val scalar = random(32)
        var pair: TlsKeyPair? = null
        if (seeds.size == 64 && scalar.size == 32) {
            val decapsulationKey = mlkem768KeyGenFromSeeds(seeds.slice(0, 32), seeds.slice(32, 64))
            val x25519Key = x25519PublicKey(scalar)
            if (decapsulationKey.ok && x25519Key.ok) {
                pair = TlsKeyPair(group, tlsOwnedCopy(mlkem768EncapsulationKey(decapsulationKey.bytes) + x25519Key.bytes),
                    tlsOwnedCopy(decapsulationKey.bytes + scalar))
            }
            tlsWipe(decapsulationKey.bytes)
        }
        tlsWipe(seeds)
        tlsWipe(scalar)
        return pair
    }
    null
}

/** The shared secret of our key pair and the peer's share; `ok` false for an invalid share (for the hybrid: a share that is not
 *  the 1120 bytes of a server's, or whose X25519 part gives an all-zero secret). */
fun tlsAgree(pair: TlsKeyPair, peerShare: string): CryptoResult {
    if (pair.group == TLS_GROUP_X25519) return x25519(pair.privateKey, peerShare)
    if (pair.group == TLS_GROUP_SECP256R1) return p256Ecdh(pair.privateKey, peerShare)
    if (pair.group == TLS_GROUP_SECP384R1) return p384Ecdh(pair.privateKey, peerShare)
    if (pair.group == TLS_GROUP_X25519_MLKEM768) {
        if (peerShare.size != TLS_MLKEM768_SERVER_SHARE_SIZE || pair.privateKey.size != 2432) {
            return cryptoFailed("tls: the hybrid key share is not 1120 bytes")
        }
        val kem = mlkem768Decapsulate(pair.privateKey.slice(0, 2400), peerShare.slice(0, 1088))
        val dh = x25519(pair.privateKey.slice(2400, 2432), peerShare.slice(1088, 1120))
        var result = cryptoFailed("tls: the hybrid key exchange failed")
        if (kem.ok && dh.ok) result = CryptoResult(tlsOwnedCopy(kem.bytes + dh.bytes), true, "")
        tlsWipe(kem.bytes)
        tlsWipe(dh.bytes)
        return result
    }
    return cryptoFailed("tls: unsupported group")
}

/** What a server does with a client's key share: the share to send back and the shared secret, or the alert to send. */
class TlsServerExchange(val ok: bool, val alert: int, val error: string, val publicKey: string, val secret: string)

private fun tlsServerExchangeFailed(alert: int, error: string): TlsServerExchange = TlsServerExchange(false, alert, error, "", "")

/** The server's half of the key exchange for `group` against the client's share. A DH group makes its ephemeral key and agrees;
 *  the hybrid encapsulates to the client's ML-KEM key (which must pass FIPS 203 section 7.2) and makes an X25519 key. */
fun tlsServerExchange(group: int, clientShare: string, random: (int) -> string): TlsServerExchange {
    if (group != TLS_GROUP_X25519_MLKEM768) {
        val pair = tlsGenerateKeyPair(group, random)
        if (pair == null) return tlsServerExchangeFailed(TLS_ALERT_INTERNAL_ERROR, "tls: the server could not make a key share")
        val shared = tlsAgree(pair, clientShare)
        tlsWipe(pair.privateKey)
        if (!shared.ok) return tlsServerExchangeFailed(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the client's key share is not valid")
        return TlsServerExchange(true, 0, "", pair.publicKey, shared.bytes)
    }
    if (clientShare.size != TLS_MLKEM768_CLIENT_SHARE_SIZE) {
        return tlsServerExchangeFailed(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the hybrid key share is not 1216 bytes")
    }
    val encapsulationKey = clientShare.slice(0, 1184)
    if (!mlkem768CheckEncapsulationKey(encapsulationKey)) {
        return tlsServerExchangeFailed(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the ML-KEM encapsulation key is not valid")
    }
    val message = random(32)
    val pair = tlsGenerateKeyPair(TLS_GROUP_X25519, random)
    if (message.size != 32 || pair == null) {
        tlsWipe(message)
        return tlsServerExchangeFailed(TLS_ALERT_INTERNAL_ERROR, "tls: the server could not make a key share")
    }
    val encapsulation = mlkem768EncapsulateWithMessage(encapsulationKey, message)
    val dh = x25519(pair.privateKey, clientShare.slice(1184, 1216))
    tlsWipe(message)
    tlsWipe(pair.privateKey)
    if (!encapsulation.ok) {
        return tlsServerExchangeFailed(TLS_ALERT_INTERNAL_ERROR, "tls: the ML-KEM encapsulation failed")
    }
    if (!dh.ok) {
        tlsWipe(encapsulation.sharedSecret)
        return tlsServerExchangeFailed(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the client's X25519 share is not valid")
    }
    val secret = tlsOwnedCopy(encapsulation.sharedSecret + dh.bytes)
    tlsWipe(encapsulation.sharedSecret)
    tlsWipe(dh.bytes)
    TlsServerExchange(true, 0, "", encapsulation.ciphertext + pair.publicKey, secret)
}

/** What a ClientHello offers for key exchange: the groups listed, the key shares sent and the key pairs behind them. */
class TlsClientShares(val ok: bool, val groups: array<int>, val pairs: array<TlsKeyPair>, val shares: array<TlsKeyShare>)

/** The groups and key shares of a ClientHello for the groups `requested` (in the client's order). With TLS 1.3 the shares are for the
 *  first classical group (X25519, P-256 or P-384) and the first hybrid, as BoringSSL's and browsers' clients do, so a server that has
 *  either answers with no extra round trip, and anything else costs a HelloRetryRequest; a group that cannot be offered here is
 *  skipped for the shares. A client without TLS 1.3 (`tls13` false) lists the classical groups only (the hybrid is a TLS 1.3 group)
 *  and has a share for the first of them. `ok` is false if a key pair cannot be made. */
fun tlsClientShares(requested: array<int>, tls13: bool, random: (int) -> string): TlsClientShares {
    val groups: array<int> = []
    for (group in requested) {
        if (tls13 || tlsGroupIsClassic(group)) groups.append(group)
    }
    val shareGroups: array<int> = []
    var classic = false
    var hybrid = false
    for (group in groups) {
        if (tlsGroupIsHybrid(group) && tls13 && !hybrid) {
            shareGroups.append(group)
            hybrid = true
        } else if (tlsGroupIsClassic(group) && !classic) {
            shareGroups.append(group)
            classic = true
        }
    }
    val pairs: array<TlsKeyPair> = []
    val shares: array<TlsKeyShare> = []
    for (group in shareGroups) {
        val pair = tlsGenerateKeyPair(group, random)
        if (pair == null) return TlsClientShares(false, groups, [], [])
        pairs.append(pair)
        shares.append(TlsKeyShare(pair.group, pair.publicKey))
    }
    TlsClientShares(true, groups, pairs, shares)
}

private fun tlsEmptyProtection(): TlsRecordProtection = tlsRecordProtection(TLS_AEAD_AES_128_GCM, "", "")

/** The usual configuration: AES-GCM suites, the signature schemes the stack can verify, no ALPN. */
fun tlsClientConfig(host: string, verifier: (array<string>, string, int, string, string) -> TlsVerdict,
    random: (int) -> string): TlsClientConfig =
    TlsClientConfig(host, [TLS_SUITE_AES_128_GCM_SHA256, TLS_SUITE_AES_256_GCM_SHA384,
        TLS_SUITE_CHACHA20_POLY1305_SHA256],
        [TLS_SIG_ECDSA_SECP256R1_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA384,
         TLS_SIG_RSA_PSS_RSAE_SHA512, TLS_SIG_ED25519, TLS_SIG_ECDSA_SECP384R1_SHA384, TLS_SIG_RSA_PKCS1_SHA256,
         TLS_SIG_RSA_PKCS1_SHA384, TLS_SIG_RSA_PKCS1_SHA512],
        [], verifier, random, tlsPatchClientHello)

/** Starts a client from a ClientHello message that is already built (its 4-byte header included), with
 *  the random, session id and key pairs it was built from. The RFC 8448 traces use this; `tlsClientNew`
 *  builds its own. The ClientHello is queued as the first record. The client keeps copies of the private keys, which it
 *  clears when it is done with them; `keyPairs` stay as they are. */
fun tlsClientStartWith(config: TlsClientConfig, clientHello: string, helloRandom: string, sessionId: string,
    keyPairs: array<TlsKeyPair>, recordVersion: int, offeredPsk: TlsStoredTicket? = null): TlsClient {
    val owned: array<TlsKeyPair> = []
    for (pair in keyPairs) owned.append(TlsKeyPair(pair.group, pair.publicKey, tlsOwnedCopy(pair.privateKey)))
    val client = tlsClientStart(config, clientHello, helloRandom, sessionId, owned, recordVersion)
    client.offeredPsk = offeredPsk
    client
}

// The client, with key pairs that are its own to clear.
private fun tlsClientStart(config: TlsClientConfig, clientHello: string, helloRandom: string, sessionId: string,
    keyPairs: array<TlsKeyPair>, recordVersion: int): TlsClient {
    val client = TlsClient(config, TLS_CLIENT_WAIT_SERVER_HELLO, "", "", TlsHandshakeBuffer([], 0), "", "", tlsTranscript(),
        HKDF_SHA256, 0, 16, TLS_AEAD_AES_128_GCM, helloRandom, sessionId, clientHello, keyPairs, false, 0,
        false, false, tlsEmptyProtection(), tlsEmptyProtection(), "", "", "", "", "", "", [], "", false,
        false, false, false, null, false, "", [], false, 0, tls12Protection(tls12Placeholder(), "", ""),
        tls12Protection(tls12Placeholder(), "", ""), Tls12Keys("", "", "", ""), "", 0, "")
    client.transcript.add(clientHello)
    client.outbox = tlsPlaintextRecord(TLS_HANDSHAKE, recordVersion, clientHello)
    client
}

private fun tlsClientFailedAtStart(config: TlsClientConfig, message: string): TlsClient {
    val client = tlsClientStartWith(config, "", "", "", [], 769)
    client.outbox = ""
    client.state = TLS_CLIENT_FAILED
    client.error = message
    client
}

/** Starts a client: builds a ClientHello with a fresh random, a 32-byte compatibility session id and the key shares for the
 *  configuration's groups (the hybrid and X25519 by default) from its random source. */
fun tlsClientNew(config: TlsClientConfig): TlsClient {
    // A name or a protocol list that cannot be encoded, and a random source that gave less than asked, are errors the
    // caller sees, not a ClientHello that is wrong.
    if ((tlsIsDnsName(config.host) && config.host != "" && !tlsServerNameValid(config.host)) || !tlsAlpnNamesValid(config.alpn)) {
        return tlsClientFailedAtStart(config, "tls: an invalid server name or ALPN protocol")
    }
    val helloRandom = config.random(32)
    val sessionId = config.random(32)
    if (helloRandom.size != 32 || sessionId.size != 32) {
        return tlsClientFailedAtStart(config, "tls: the random source failed")
    }
    val offer = tlsClientShares(if (config.groups.size > 0) config.groups else tlsDefaultGroups(), config.suites.size > 0, config.random)
    if (!offer.ok) return tlsClientFailedAtStart(config, "tls: the client could not make a key share")
    val built = tlsClientBuildHello(config, helloRandom, sessionId, offer)
    val client = tlsClientStart(config, built.message, helloRandom, sessionId, offer.pairs, 769)
    client.offeredPsk = built.ticket
    client
}

fun TlsClient.failed(): bool = this.state == TLS_CLIENT_FAILED
fun TlsClient.connected(): bool = this.state == TLS_CLIENT_CONNECTED
/** True once the peer sent close_notify (every byte it sent was delivered). */
fun TlsClient.closed(): bool = this.peerClosed

/** The bytes to send to the peer; empties the queue. */
fun TlsClient.takeOutput(): string {
    val data = this.outbox
    this.outbox = ""
    data
}

/** The application data received so far; empties the buffer. */
fun TlsClient.takeApplicationData(): string {
    val data = this.applicationData
    this.applicationData = ""
    data
}

/** Sets the certificate to present if the server asks for one (before the first `feed`). */
fun TlsClient.useIdentity(identity: TlsIdentity): void {
    this.identity = identity
    return
}

/** The ALPN protocol the server chose ("" for none). */
fun TlsClient.alpn(): string = this.negotiatedAlpn

private fun TlsClient.queueAlert(description: int): void {
    val body = cryptoByteString([if (description == TLS_ALERT_CLOSE_NOTIFY) 1 else 2, description])
    if (this.v12) {
        if (this.writeEncrypted) {
            val sealed = tls12Protect(this.v12Write, TLS_ALERT, body)
            if (sealed.ok) this.outbox = this.outbox + sealed.bytes
        } else {
            this.outbox = this.outbox + tlsPlaintextRecord(TLS_ALERT, 771, body)
        }
        return
    }
    if (this.writeEncrypted) {
        val sealed = tlsProtectRecord(this.write, TLS_ALERT, body)
        if (sealed.ok) this.outbox = this.outbox + sealed.bytes
    } else {
        this.outbox = this.outbox + tlsPlaintextRecord(TLS_ALERT, 771, body)
    }
    return
}

/** Fails the connection: queues a fatal alert and stops processing. */
private fun TlsClient.fail(description: int, message: string): void {
    if (this.state == TLS_CLIENT_FAILED || this.state == TLS_CLIENT_CLOSED) return
    this.queueAlert(description)
    this.state = TLS_CLIENT_FAILED
    this.error = message
    this.wipeSecrets()
    return
}

private fun TlsClient.queueRecord(type: int, content: string): void {
    // Over 2^14 bytes the content is split over several records (a client certificate chain, say).
    var offset = 0
    while (offset < content.size || offset == 0) {
        val end = if (content.size - offset > TLS_MAX_PLAINTEXT) offset + TLS_MAX_PLAINTEXT else content.size
        val sealed = tlsProtectRecord(this.write, type, content.slice(offset, end))
        if (!sealed.ok) {
            this.fail(TLS_ALERT_INTERNAL_ERROR, sealed.error)
            return
        }
        this.outbox = this.outbox + sealed.bytes
        offset = end
    }
    return
}

// ---- clearing the secrets (keysched's tlsWipe): each when nothing reads it again, and all of them when the connection
// fails or closes ----
private fun TlsClient.wipeKeyPairs(): void {
    for (pair in this.keyPairs) tlsWipe(pair.privateKey)
    return
}

private fun TlsClient.wipeSecrets(): void {
    this.wipeKeyPairs()
    tlsWipe(this.handshakeSecret)
    tlsWipe(this.clientHandshakeSecret)
    tlsWipe(this.serverHandshakeSecret)
    tlsWipe(this.clientApplicationSecret)
    tlsWipe(this.serverApplicationSecret)
    tlsWipe(this.masterSecret)
    tlsWipe(this.resumptionMaster)
    val offeredTicket = this.offeredPsk
    if (offeredTicket != null) {
        tlsWipe(offeredTicket.psk)
        tlsWipe(offeredTicket.ticket)
    }
    tlsWipe(this.read.key)
    tlsWipe(this.read.iv)
    tlsRecordProtectionRelease(this.read)
    tlsWipe(this.write.key)
    tlsWipe(this.write.iv)
    tlsRecordProtectionRelease(this.write)
    // The TLS 1.2 protections hold the key block's parts (v12Keys).
    tlsWipe(this.v12Keys.clientKey)
    tlsWipe(this.v12Keys.serverKey)
    tlsWipe(this.v12Keys.clientIv)
    tlsWipe(this.v12Keys.serverIv)
    return
}

private fun TlsClient.setKeys(secret: string, forWrite: bool): void {
    // The protection this replaces is done with.
    if (forWrite) {
        tlsWipe(this.write.key)
        tlsWipe(this.write.iv)
        tlsRecordProtectionRelease(this.write)
    } else {
        tlsWipe(this.read.key)
        tlsWipe(this.read.iv)
        tlsRecordProtectionRelease(this.read)
    }
    val protection = tlsRecordProtection(this.aead, tlsTrafficKey(this.hash, secret, this.keyLength),
        tlsTrafficIv(this.hash, secret))
    if (forWrite) {
        this.write = move(protection)
        this.writeEncrypted = true
    } else {
        this.read = move(protection)
        this.readEncrypted = true
    }
    return
}

private fun TlsClient.sendCompatibilityChangeCipherSpec(): void {
    if (this.sessionId.size == 0 || this.sentCompatibilityChangeCipherSpec) return
    this.sentCompatibilityChangeCipherSpec = true
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(1))
    return
}

private fun TlsClient.keyPairFor(group: int): TlsKeyPair? {
    for (pair in this.keyPairs) {
        if (pair.group == group) return pair
    }
    null
}

private fun TlsClient.handleServerHello(message: string, body: string): void {
    val hello = tlsParseServerHello(body)
    if (!hello.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, hello.error)
        return
    }
    if (hello.selectedVersion != 772) {
        val sentinel = hello.random.slice(24, 32)
        // (The downgrade check applies to a client that offered TLS 1.3.)
        if (this.config.suites.size > 0 && (sentinel == "DOWNGRD" + tlsU8(1) || sentinel == "DOWNGRD" + tlsU8(0))) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: downgrade detected")
        } else if (this.config.suites12.size > 0 && hello.selectedVersion == 0 && !this.retried) {
            // TLS 1.3's key shares go unused.
            this.wipeKeyPairs()
            this.startV12(message, body)
        } else {
            this.fail(TLS_ALERT_PROTOCOL_VERSION, "tls: the server does not speak TLS 1.3")
        }
        return
    }
    if (hello.sessionId != this.sessionId) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the ServerHello does not echo the session id")
        return
    }
    if (hello.unlisted != -1) {
        this.fail(TLS_ALERT_UNSUPPORTED_EXTENSION, "tls: the ServerHello carries an extension that was not asked for (${hello.unlisted})")
        return
    }
    var offered = false
    for (suite in this.config.suites) {
        if (suite == hello.cipherSuite) offered = true
    }
    if (!offered || tlsAeadFor(hello.cipherSuite) == 0) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose a cipher suite that was not offered")
        return
    }
    if (this.retried && hello.cipherSuite != this.retrySuite) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the cipher suite changed after HelloRetryRequest")
        return
    }
    this.suite = hello.cipherSuite
    this.hash = tlsSuiteHash(hello.cipherSuite)
    this.aead = tlsAeadFor(hello.cipherSuite)
    this.keyLength = tlsAeadKeyLength(this.aead)
    if (hello.retryRequest) {
        this.handleRetryRequest(message, hello)
        return
    }
    if (hello.shareKey.size == 0) {
        this.fail(TLS_ALERT_MISSING_EXTENSION, "tls: the ServerHello has no key share")
        return
    }
    // A pre_shared_key in the ServerHello: the server accepted the ticket (section 4.2.11): it must be the one identity offered, and the suite must have its hash.
    var resumedPsk = ""
    val offeredTicket = this.offeredPsk
    if (hello.pskSelected >= 0) {
        if (offeredTicket == null || hello.pskSelected != 0) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server selected a PSK that was not offered")
            return
        }
        if (tlsSuiteHash(hello.cipherSuite) != tlsSuiteHash(offeredTicket.suite)) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server's cipher suite does not match the PSK's hash")
            return
        }
        resumedPsk = offeredTicket.psk
        this.didResume = true
    }
    val pair = this.keyPairFor(hello.shareGroup)
    if (pair == null) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose a key share group that was not offered")
        return
    }
    val shared = tlsAgree(pair, hello.shareKey)
    this.negotiatedGroup = pair.group
    if (!shared.ok) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the key exchange failed")
        return
    }
    this.transcript.add(message)
    val early = tlsEarlySecret(this.hash, resumedPsk)
    val secrets = tlsDeriveHandshakeSecrets(this.hash, early, shared.bytes, this.transcript.hash(this.hash))
    this.handshakeSecret = secrets.handshakeSecret
    this.clientHandshakeSecret = secrets.clientTraffic
    this.serverHandshakeSecret = secrets.serverTraffic
    this.setKeys(secrets.serverTraffic, false)
    // Everything the client sends from here on is protected with its handshake keys, an alert included, so the
    // compatibility ChangeCipherSpec (appendix D.4) goes out before the first of those records.
    this.sendCompatibilityChangeCipherSpec()
    this.setKeys(secrets.clientTraffic, true)
    // The key exchange is done with: the private keys, the shared secret and the early secret.
    this.wipeKeyPairs()
    tlsWipe(shared.bytes)
    tlsWipe(early)
    // The ticket and its PSK are spent (used for the early secret, or declined by the server): wiped now, not at the end of the connection.
    if (offeredTicket != null) {
        tlsWipe(offeredTicket.psk)
        tlsWipe(offeredTicket.ticket)
        this.offeredPsk = null
    }
    this.state = TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS
    return
}

private fun TlsClient.handleRetryRequest(message: string, hello: TlsServerHello): void {
    if (this.retried) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: a second HelloRetryRequest")
        return
    }
    // RFC 8446 section 4.1.4: a HelloRetryRequest must change the ClientHello: a group that has no share yet, a cookie, or both.
    val cookieOnly = hello.shareGroup == 0 && hello.cookie.size > 0 && this.keyPairs.size > 0
    if (!cookieOnly && (this.keyPairFor(hello.shareGroup) != null || hello.shareGroup == 0)) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the HelloRetryRequest selects no new group")
        return
    }
    var offered = cookieOnly
    for (group in tlsClientHelloGroups(this.firstHello)) {
        if (group == hello.shareGroup) offered = true
    }
    if (!offered) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the HelloRetryRequest selects a group that was not offered")
        return
    }
    // With a cookie alone every share already sent stands, and the key_share extension stays as it was (RFC 8446 section 4.1.2).
    val generated = if (cookieOnly) null else tlsGenerateKeyPair(hello.shareGroup, this.config.random)
    if (!cookieOnly && generated == null) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: the server asks for a group this client does not support")
        return
    }
    this.retried = true
    this.retrySuite = hello.cipherSuite
    // The transcript restarts with a synthetic message_hash of the first ClientHello (section 4.4.1).
    val firstHash = tlsHashOf(this.hash, this.firstHello)
    this.transcript.messages = tlsHandshakeMessage(TLS_MESSAGE_HASH, firstHash)
    this.transcript.add(message)
    // A new share replaces the ones sent first, whose private keys are done with; with a cookie alone the shares stay (group 0 says so).
    var replacement = TlsKeyShare(0, "")
    if (!cookieOnly) {
        val fresh = generated ?? return
        this.wipeKeyPairs()
        this.keyPairs = [fresh]
        replacement = TlsKeyShare(fresh.group, fresh.publicKey)
    }
    this.sendCompatibilityChangeCipherSpec()
    var second = this.config.secondHello(this.firstHello, replacement, hello.cookie)
    if (second.size == 0) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the second ClientHello could not be built")
        return
    }
    // With a PSK the binder is recomputed: it covers the transcript so far (the message_hash of the first ClientHello and the HelloRetryRequest) and the
    // partial second ClientHello (section 4.2.11.2).
    val ticket = this.offeredPsk
    if (ticket != null && tlsSuiteHash(hello.cipherSuite) != tlsSuiteHash(ticket.suite)) {
        // The server's suite has another hash than the PSK's: the PSK cannot be used, and the second ClientHello goes without it (section 4.2.11).
        second = tlsDropPsk(second)
        tlsWipe(ticket.psk)
        tlsWipe(ticket.ticket)
        this.offeredPsk = null
    } else if (ticket != null) {
        val start = tlsBindersStart(second)
        if (start < 0) {
            this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the second ClientHello lost its PSK extension")
            return
        }
        second = tlsReplaceBinders(second, [tlsBinderValue(tlsSuiteHash(ticket.suite), ticket.psk, this.transcript.messages + second.slice(0, start))])
    }
    this.transcript.add(second)
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_HANDSHAKE, 771, second)
    return
}

private fun TlsClient.handleEncryptedExtensions(message: string, body: string): void {
    val parsed = tlsParseEncryptedExtensions(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, parsed.error)
        return
    }
    // RFC 8446 section 4.2: only extensions the ClientHello offered (or that answer it) come back, and only those
    // allowed in EncryptedExtensions: the server_name acknowledgement (when a name was sent), supported_groups, ALPN.
    // (max_fragment_length 1, record_size_limit 28 are answered when offered.)
    val offeredTypes = tlsClientHelloExtensionTypes(this.firstHello)
    val allowedHere: array<int> = [TLS_EXT_SUPPORTED_GROUPS]
    for (candidate in [TLS_EXT_SERVER_NAME, 1, TLS_EXT_ALPN, 28]) {
        for (offeredType in offeredTypes) {
            if (offeredType == candidate) allowedHere.append(candidate)
        }
    }
    val unlisted = tlsFirstUnlisted(parsed.extensions, allowedHere)
    if (unlisted != -1) {
        this.fail(TLS_ALERT_UNSUPPORTED_EXTENSION, "tls: EncryptedExtensions carries an extension that was not asked for ($unlisted)")
        return
    }
    if (parsed.alpn.size > 0) {
        var known = false
        for (name in this.config.alpn) {
            if (name == parsed.alpn) known = true
        }
        if (!known) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose an ALPN protocol that was not offered")
            return
        }
    }
    this.negotiatedAlpn = parsed.alpn
    this.transcript.add(message)
    // A resumed handshake has no Certificate or CertificateVerify: the server's Finished comes next (section 2.2).
    this.state = if (this.didResume) TLS_CLIENT_WAIT_FINISHED else TLS_CLIENT_WAIT_CERTIFICATE
    return
}

private fun TlsClient.handleCertificate(message: string, body: string): void {
    val parsed = tlsParseCertificate(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, parsed.error)
        return
    }
    if (parsed.entryExtension != -1) {
        this.fail(TLS_ALERT_UNSUPPORTED_EXTENSION, "tls: a certificate entry carries an extension that was not asked for (${parsed.entryExtension})")
        return
    }
    if (parsed.context.size != 0 || parsed.chain.size == 0) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a Certificate with a request context or no certificates")
        return
    }
    this.chain = parsed.chain
    this.transcript.add(message)
    this.state = TLS_CLIENT_WAIT_CERTIFICATE_VERIFY
    return
}

private fun TlsClient.handleCertificateVerify(message: string, body: string): void {
    val parsed = tlsParseCertificateVerify(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: malformed CertificateVerify")
        return
    }
    var offered = false
    for (scheme in this.config.signatureAlgorithms) {
        // RSA PKCS#1 v1.5 schemes are for certificate signatures and TLS 1.2 only (RFC 8446 section 4.2.3).
        if (scheme == parsed.scheme && scheme != TLS_SIG_RSA_PKCS1_SHA256 && scheme != TLS_SIG_RSA_PKCS1_SHA384 &&
            scheme != TLS_SIG_RSA_PKCS1_SHA512) offered = true
    }
    if (!offered) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a signature scheme that was not offered")
        return
    }
    val content = tlsCertificateVerifyContent(true, this.transcript.hash(this.hash))
    val verdict = this.config.verifier(this.chain, this.config.host, parsed.scheme, content, parsed.signature)
    if (!verdict.accepted()) {
        this.certificateRejected = true
        this.fail(verdict.alert, verdict.text)
        return
    }
    this.transcript.add(message)
    this.state = TLS_CLIENT_WAIT_FINISHED
    return
}

/** The client's Certificate (empty when it has no identity or none of its keys fits the server's schemes) and,
 *  with one, its CertificateVerify; both go into the transcript. */
private fun TlsClient.clientAuthenticationMessages(): string {
    val identity = this.identity
    var scheme = 0
    if (identity != null && identity.chain.size > 0) {
        for (candidate in identity.schemes) {
            for (accepted in this.requestSchemes) {
                if (scheme == 0 && candidate == accepted && !tlsSchemeIsPkcs1(candidate)) scheme = candidate
            }
        }
    }
    if (identity == null || scheme == 0) {
        val empty = tlsBuildCertificate(this.requestContext, [])
        this.transcript.add(empty)
        return empty
    }
    val certificate = tlsBuildCertificate(this.requestContext, identity.chain)
    this.transcript.add(certificate)
    val content = tlsCertificateVerifyContent(false, this.transcript.hash(this.hash))
    val signature = identity.sign(scheme, content)
    if (signature.size == 0) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the client certificate's key could not sign")
        return ""
    }
    val verify = tlsBuildCertificateVerify(scheme, signature)
    this.transcript.add(verify)
    certificate + verify
}

private fun TlsClient.handleCertificateRequest(message: string, body: string): void {
    val request = tlsParseCertificateRequest(body)
    if (!request.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed CertificateRequest")
        return
    }
    if (request.context.size != 0) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a CertificateRequest with a request context during the handshake")
        return
    }
    this.requested = true
    this.requestContext = request.context
    this.requestSchemes = request.signatureAlgorithms
    this.transcript.add(message)
    return
}

private fun TlsClient.handleFinished(message: string, body: string): void {
    if (body.size != tlsHashLength(this.hash)) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a Finished of the wrong length")
        return
    }
    val expected = tlsFinishedVerifyData(this.hash, this.serverHandshakeSecret, this.transcript.hash(this.hash))
    if (!constantTimeEquals(expected, body)) {
        this.fail(TLS_ALERT_DECRYPT_ERROR, "tls: the server's Finished does not verify")
        return
    }
    if (!this.handshakeBuffer.empty()) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: data after the server's Finished in its record")
        return
    }
    this.transcript.add(message)
    val serverFinishedHash = this.transcript.hash(this.hash)
    val application = tlsDeriveApplicationSecrets(this.hash, this.handshakeSecret, serverFinishedHash)
    this.masterSecret = application.masterSecret
    this.clientApplicationSecret = application.clientTraffic
    this.serverApplicationSecret = application.serverTraffic
    // The server's Finished is checked and the application secrets are made: the handshake secret, the server's
    // handshake traffic secret and the master and exporter secrets (no resumption, no exporter here) are done with.
    tlsWipe(this.serverHandshakeSecret)
    tlsWipe(this.handshakeSecret)
    this.channelExporter = tlsExporterValue(this.hash, application.exporter, "EXPORTER-Channel-Binding", "", 32)
    tlsWipe(application.exporter)
    // The client's second flight: ChangeCipherSpec (compatibility mode), then its Finished under the
    // client handshake keys, then everything after is application traffic.
    this.sendCompatibilityChangeCipherSpec()
    // With client authentication, its Certificate and CertificateVerify come first, in the same record.
    var flight = ""
    if (this.requested) {
        flight = this.clientAuthenticationMessages()
        if (this.state == TLS_CLIENT_FAILED) return
    }
    val verify = tlsFinishedVerifyData(this.hash, this.clientHandshakeSecret, this.transcript.hash(this.hash))
    val finished = tlsHandshakeMessage(TLS_FINISHED, verify)
    this.queueRecord(TLS_HANDSHAKE, flight + finished)
    this.transcript.add(finished)
    this.setKeys(application.clientTraffic, true)
    this.setKeys(application.serverTraffic, false)
    // The resumption master secret (section 7.1) is made from the master secret over the transcript through the client's Finished; it is kept
    // only for a client that has a cache to put tickets in, and the master secret is done with.
    if (this.config.sessions != null) this.resumptionMaster = tlsResumptionMasterSecret(this.hash, application.masterSecret, this.transcript.hash(this.hash))
    tlsWipe(application.masterSecret)
    tlsWipe(this.clientHandshakeSecret)
    this.state = TLS_CLIENT_CONNECTED
    return
}

private fun TlsClient.handleKeyUpdate(body: string): void {
    if (body.size != 1 || body[0] > 1) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed KeyUpdate")
        return
    }
    this.keyUpdateRun = this.keyUpdateRun + 1
    if (this.keyUpdateRun > TLS_MAX_EMPTY_RUN) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many KeyUpdates in a row")
        return
    }
    val previousRead = this.serverApplicationSecret
    this.serverApplicationSecret = tlsNextTrafficSecret(this.hash, previousRead)
    tlsWipe(previousRead)
    this.setKeys(this.serverApplicationSecret, false)
    // One answer for a batch of requests: it goes out before the next application data (section 4.6.3).
    if (body[0] == 1) this.keyUpdateOwed = true
    return
}

/** Updates the sending key when it has protected as many records as its cipher allows (RFC 8446 section 5.5). */
private fun TlsClient.rekeyIfDue(): void {
    if (this.write.sequence < tlsRecordLimit(this.write.aead)) return
    this.queueRecord(TLS_HANDSHAKE, tlsHandshakeMessage(TLS_KEY_UPDATE, tlsU8(0)))
    this.clientApplicationSecret = tlsNextTrafficSecret(this.hash, this.clientApplicationSecret)
    this.setKeys(this.clientApplicationSecret, true)
    return
}

private fun TlsClient.answerKeyUpdate(): void {
    if (!this.keyUpdateOwed || this.state != TLS_CLIENT_CONNECTED) return
    this.keyUpdateOwed = false
    this.queueRecord(TLS_HANDSHAKE, tlsHandshakeMessage(TLS_KEY_UPDATE, tlsU8(0)))
    val previousWrite = this.clientApplicationSecret
    this.clientApplicationSecret = tlsNextTrafficSecret(this.hash, previousWrite)
    tlsWipe(previousWrite)
    this.setKeys(this.clientApplicationSecret, true)
    return
}

private fun TlsClient.handleMessage(type: int, message: string, body: string): void {
    if (this.state == TLS_CLIENT_WAIT_SERVER_HELLO) {
        if (type == TLS_SERVER_HELLO) this.handleServerHello(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a ServerHello")
    } else if (this.state == TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS) {
        if (type == TLS_ENCRYPTED_EXTENSIONS) this.handleEncryptedExtensions(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected EncryptedExtensions")
    } else if (this.state == TLS_CLIENT_WAIT_CERTIFICATE) {
        if (type == TLS_CERTIFICATE) this.handleCertificate(message, body)
        else if (type == TLS_CERTIFICATE_REQUEST && !this.requested) this.handleCertificateRequest(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Certificate")
    } else if (this.state == TLS_CLIENT_WAIT_CERTIFICATE_VERIFY) {
        if (type == TLS_CERTIFICATE_VERIFY) this.handleCertificateVerify(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a CertificateVerify")
    } else if (this.state == TLS_CLIENT_WAIT_FINISHED) {
        if (type == TLS_FINISHED) this.handleFinished(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Finished")
    } else if (this.state == TLS_CLIENT_CONNECTED) {
        if (type == TLS_NEW_SESSION_TICKET) {
            this.handleNewSessionTicket(body)
        } else if (type == TLS_KEY_UPDATE) this.handleKeyUpdate(body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected handshake message")
    }
    return
}

/** Handles whole handshake messages from the buffer, keeping an incomplete tail. A message that
 *  straddles a key change is refused. */
private fun TlsClient.processHandshake(): void {
    while (this.state != TLS_CLIENT_FAILED && this.state != TLS_CLIENT_CLOSED) {
        val header = this.handshakeBuffer.header()
        // The cap is checked at the header, before the body is buffered (a peer not yet authenticated).
        if (header.bodyLength > tlsMessageLimit(header.type)) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a handshake message longer than allowed")
            return
        }
        if (!header.complete) return
        val message = this.handshakeBuffer.take(header.total)
        this.handleMessage(header.type, message, message.slice(4, message.size))
        if (this.v12) {
            // The ServerHello chose TLS 1.2: whatever followed it in the record is the 1.2 flight.
            this.processHandshake12()
            return
        }
        if (!this.handshakeBuffer.empty() && this.state == TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: handshake data after the ServerHello in its record")
            return
        }
    }
    return
}

private fun TlsClient.handleAlert(content: string): void {
    if (content.size != 2) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed alert")
        return
    }
    val level = content[0]
    if (level != 1 && level != 2) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: an alert of an unknown level")
        return
    }
    if (content[1] == TLS_ALERT_CLOSE_NOTIFY) {
        if (this.state != TLS_CLIENT_CONNECTED) {
            // A close_notify before the handshake is done ends it: there is no connection to close cleanly.
            this.state = TLS_CLIENT_FAILED
            this.error = "tls: the peer closed the connection during the handshake"
            return
        }
        this.peerClosed = true
        if (!this.sentClose) this.queueAlert(TLS_ALERT_CLOSE_NOTIFY)
        this.sentClose = true
        this.state = TLS_CLIENT_CLOSED
        this.wipeSecrets()
        return
    }
    if (level == 1) {
        // A warning alert: TLS 1.2 ignores the ones it does not know and so does TLS 1.3 for user_canceled (RFC 8446
        // section 6.1); any other warning in TLS 1.3 is an error. Four in a row at most.
        if (!this.v12 && content[1] != 90 && this.state != TLS_CLIENT_WAIT_SERVER_HELLO) {
            this.fail(TLS_ALERT_DECODE_ERROR, "tls: a warning alert")
            return
        }
        this.warningRun = this.warningRun + 1
        if (this.warningRun > 4) this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many warning alerts")
        return
    }
    this.state = TLS_CLIENT_FAILED
    this.error = "tls: the server sent alert ${content[1]}"
    return
}

private fun TlsClient.handleRecord(record: string, header: TlsRecordHeader): void {
    if (this.v12) {
        this.handleRecord12(record, header)
        return
    }
    if (header.type == TLS_CHANGE_CIPHER_SPEC) {
        // Compatibility mode (appendix D.4): one 0x01 byte, ignored, only during the handshake.
        // (A server may send it right after a HelloRetryRequest too.)
        this.emptyRun = this.emptyRun + 1
        if (this.emptyRun > TLS_MAX_EMPTY_RUN) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many empty records")
            return
        }
        if (this.state == TLS_CLIENT_CONNECTED || record.size != 6 || record[5] != 1) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected ChangeCipherSpec")
        }
        return
    }
    var type = header.type
    var content = ""
    if (this.readEncrypted) {
        if (header.type != TLS_APPLICATION_DATA) {
            this.fail(TLS_ALERT_BAD_RECORD_MAC, "tls: an unprotected record after the keys were set")
            return
        }
        val opened = tlsOpenRecord(this.read, record)
        if (!opened.ok) {
            this.fail(if (opened.error == "tls: record overflow") TLS_ALERT_RECORD_OVERFLOW else TLS_ALERT_BAD_RECORD_MAC,
                opened.error)
            return
        }
        type = opened.type
        content = opened.content
    } else {
        if (header.length > TLS_MAX_PLAINTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        content = record.slice(5, record.size)
    }
    if (content.size == 0) {
        // An empty record carries nothing: a run of them is refused (as BoringSSL does, 32 in a row).
        this.emptyRun = this.emptyRun + 1
        if (this.emptyRun > TLS_MAX_EMPTY_RUN) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many empty records")
            return
        }
    } else {
        if (type != TLS_ALERT) this.emptyRun = 0
        if (type == TLS_APPLICATION_DATA) this.keyUpdateRun = 0
        if (type != TLS_ALERT) this.warningRun = 0
    }
    if (type == TLS_HANDSHAKE) {
        if (content.size == 0) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an empty handshake record")
            return
        }
        this.handshakeBuffer.add(content)
        this.processHandshake()
    } else if (type == TLS_ALERT) {
        this.handleAlert(content)
    } else if (type == TLS_APPLICATION_DATA && this.readEncrypted && this.state == TLS_CLIENT_CONNECTED) {
        this.applicationData = this.applicationData + content
    } else {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected record type $type")
    }
    return
}

/** Feeds bytes received from the peer: every complete record in them is processed. */
fun TlsClient.feed(data: string): void {
    if (this.state == TLS_CLIENT_FAILED || this.state == TLS_CLIENT_CLOSED) return
    this.inbox = this.inbox + data
    while (this.state != TLS_CLIENT_FAILED && this.state != TLS_CLIENT_CLOSED) {
        val header = tlsParseRecordHeader(this.inbox, 0)
        if (!header.ok) return
        if (header.length > TLS_MAX_CIPHERTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        if ((header.version >> 8) != 3) {
            this.fail(TLS_ALERT_PROTOCOL_VERSION, "tls: a record with the version ${header.version}")
            return
        }
        if (this.inbox.size < 5 + header.length) return
        val record = this.inbox.slice(0, 5 + header.length)
        this.inbox = this.inbox.slice(5 + header.length, this.inbox.size)
        this.handleRecord(record, header)
    }
    return
}

/** Queues application data (any length) as records. False when the connection is not open. */
fun TlsClient.send(data: string): bool {
    if (this.state != TLS_CLIENT_CONNECTED) return false
    if (this.v12) return this.send12(data)
    // RFC 8446 section 4.6.3: the answer to the KeyUpdates received (one for the batch) goes out before the next
    // application data.
    this.answerKeyUpdate()
    var offset = 0
    while (offset < data.size && this.state == TLS_CLIENT_CONNECTED) {
        val end = if (data.size - offset > TLS_MAX_PLAINTEXT) offset + TLS_MAX_PLAINTEXT else data.size
        this.rekeyIfDue()
        this.queueRecord(TLS_APPLICATION_DATA, data.slice(offset, end))
        offset = end
    }
    this.state == TLS_CLIENT_CONNECTED
}

/** Queues close_notify; the connection takes no more application data. */
fun TlsClient.close(): void {
    if (this.state == TLS_CLIENT_CONNECTED && !this.sentClose) {
        this.queueAlert(TLS_ALERT_CLOSE_NOTIFY)
        this.sentClose = true
        this.state = TLS_CLIENT_CLOSED
        this.wipeSecrets()
    }
    return
}

// ---- TLS 1.2 (the modern subset, RFC 5246 with RFC 7627's extended master secret) ----
// The server's ServerHello without supported_versions switches the client to this path: Certificate,
// ServerKeyExchange (ECDHE, signed under the certificate's key with the client's and server's randoms),
// [CertificateRequest], ServerHelloDone; then the client's [Certificate], ClientKeyExchange, [CertificateVerify],
// ChangeCipherSpec, Finished; then the server's ChangeCipherSpec and Finished.
val TLS_CLIENT12_WAIT_CERTIFICATE = 20
val TLS_CLIENT12_WAIT_KEY_EXCHANGE = 21
val TLS_CLIENT12_WAIT_HELLO_DONE = 22
val TLS_CLIENT12_WAIT_CHANGE_CIPHER_SPEC = 23
val TLS_CLIENT12_WAIT_FINISHED = 24

private fun TlsClient.startV12(message: string, body: string): void {
    val hello = tls12ParseServerHello(body)
    if (!hello.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, hello.error)
        return
    }
    var offered = false
    for (code in this.config.suites12) {
        if (code == hello.suite) offered = true
    }
    val suite = tls12Suite(hello.suite)
    if (!offered || suite == null) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose a cipher suite that was not offered")
        return
    }
    // The subset needs the extended master secret and refuses renegotiation: a server without them is refused.
    if (!hello.extendedMasterSecret || !hello.secureRenegotiation) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: the server does not support the extended master secret")
        return
    }
    // Only the extensions the ClientHello carried may answer it (RFC 5246 section 7.4.1.4); the subset needs no other.
    // (supported_groups: some TLS 1.2 servers echo it in the ServerHello; it is ignored.)
    val allowed12: array<int> = [23, 65281, 11, TLS_EXT_SUPPORTED_GROUPS]
    if (tlsIsDnsName(this.config.host)) allowed12.append(TLS_EXT_SERVER_NAME)
    if (this.config.alpn.size > 0) allowed12.append(TLS_EXT_ALPN)
    var unlisted12 = -1
    for (type in hello.extensionTypes) {
        var known12 = false
        for (candidate in allowed12) {
            if (candidate == type) known12 = true
        }
        if (!known12 && unlisted12 == -1) unlisted12 = type
    }
    if (unlisted12 != -1) {
        this.fail(TLS_ALERT_UNSUPPORTED_EXTENSION, "tls: the ServerHello carries an extension that was not asked for ($unlisted12)")
        return
    }
    // ALPN (RFC 7301): the server may name one of the protocols the client offered, nothing else.
    if (hello.alpn.size > 0) {
        var known = false
        for (name in this.config.alpn) {
            if (name == hello.alpn) known = true
        }
        if (!known) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose an ALPN protocol that was not offered")
            return
        }
    }
    this.negotiatedAlpn = hello.alpn
    this.v12 = true
    this.v12Suite = hello.suite
    this.suite = hello.suite
    this.hash = suite.hash
    this.serverRandom = hello.random
    this.transcript.add(message)
    this.state = TLS_CLIENT12_WAIT_CERTIFICATE
    return
}

private fun TlsClient.queueRecord12(type: int, content: string): void {
    // Over 2^14 bytes the content is split over several records (a client certificate chain, say).
    var offset = 0
    while (offset < content.size || offset == 0) {
        val end = if (content.size - offset > TLS_MAX_PLAINTEXT) offset + TLS_MAX_PLAINTEXT else content.size
        val sealed = tls12Protect(this.v12Write, type, content.slice(offset, end))
        if (!sealed.ok) {
            this.fail(TLS_ALERT_INTERNAL_ERROR, sealed.error)
            return
        }
        this.outbox = this.outbox + sealed.bytes
        offset = end
    }
    return
}

private fun tlsGroupListed(list: array<int>, group: int): bool {
    for (candidate in list) {
        if (candidate == group) return true
    }
    false
}

/** The TLS group (secp256r1 23, secp384r1 24, secp521r1 25) of the EC key in the DER certificate `certificate`, or 0 for another or no
 *  EC key (RFC 8422 section 5.1.1: in TLS 1.2 the client's list of groups also names the curves of the certificates it accepts). */
fun tlsCertificateEcGroup(certificate: string): int {
    val outer = derItem(certificate, 0, certificate.size)
    if (!outer.ok || outer.tag != DER_SEQUENCE) return 0
    val tbs = derItem(certificate, outer.start, outer.end)
    if (!tbs.ok || tbs.tag != DER_SEQUENCE) return 0
    var at = tbs.start
    var item = derItem(certificate, at, tbs.end)
    if (item.ok && item.tag == 160) at = item.end
    // serial number, signature algorithm, issuer, validity, subject
    for (i in 0 until 5) {
        item = derItem(certificate, at, tbs.end)
        if (!item.ok) return 0
        at = item.end
    }
    val spki = derItem(certificate, at, tbs.end)
    if (!spki.ok || spki.tag != DER_SEQUENCE) return 0
    val algorithm = derItem(certificate, spki.start, spki.end)
    if (!algorithm.ok || algorithm.tag != DER_SEQUENCE) return 0
    val keyType = derItem(certificate, algorithm.start, algorithm.end)
    if (!keyType.ok || keyType.tag != DER_OID || certificate.slice(keyType.start, keyType.end) != "\x2a\x86\x48\xce\x3d\x02\x01") return 0
    val curve = derItem(certificate, keyType.end, algorithm.end)
    if (!curve.ok || curve.tag != DER_OID) return 0
    val name = certificate.slice(curve.start, curve.end)
    if (name == "\x2a\x86\x48\xce\x3d\x03\x01\x07") return TLS_GROUP_SECP256R1
    if (name == "\x2b\x81\x04\x00\x22") return TLS_GROUP_SECP384R1
    if (name == "\x2b\x81\x04\x00\x23") return 25
    0
}

private fun TlsClient.handleCertificate12(message: string, body: string): void {
    val parsed = tls12ParseCertificate(body)
    if (!parsed.ok || parsed.chain.size == 0) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed or empty Certificate")
        return
    }
    // RFC 8422 section 5.1.1: an EC key must be on a curve the ClientHello listed (TLS 1.2 has no signature_algorithms curve; TLS 1.3 does).
    val leafGroup = tlsCertificateEcGroup(parsed.chain[0])
    if (leafGroup != 0 && !tlsGroupListed(tlsClientHelloGroups(this.firstHello), leafGroup)) {
        this.certificateRejected = true
        this.fail(TLS_ALERT_BAD_CERTIFICATE, "tls: the certificate's curve was not offered in the ClientHello")
        return
    }
    this.chain = parsed.chain
    this.transcript.add(message)
    this.state = TLS_CLIENT12_WAIT_KEY_EXCHANGE
    return
}

private fun TlsClient.handleServerKeyExchange12(message: string, body: string): void {
    val parsed = tls12ParseServerKeyExchange(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed ServerKeyExchange")
        return
    }
    var offeredGroup = false
    for (group in tlsClientHelloGroups(this.firstHello)) {
        if (group == parsed.group && tlsGroupIsClassic(group)) offeredGroup = true
    }
    var offeredScheme = false
    for (scheme in this.config.signatureAlgorithms) {
        if (scheme == parsed.scheme) offeredScheme = true
    }
    if (!offeredGroup || !offeredScheme) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a key exchange group or signature scheme that was not offered")
        return
    }
    // The key behind the signature must be of the type the suite names (ECDHE_ECDSA or ECDHE_RSA).
    val suiteInfo = tls12Suite(this.v12Suite)
    if (suiteInfo != null && suiteInfo.ecdsa != tlsSchemeIsEcKey(parsed.scheme)) {
        this.certificateRejected = true
        this.fail(TLS_VERDICT_UNSUPPORTED_CERTIFICATE, "tls: the certificate's key type does not match the cipher suite")
        return
    }
    val signed = tls12SignedParams(this.helloRandom, this.serverRandom, parsed.params)
    val verdict = this.config.verifier(this.chain, this.config.host, parsed.scheme + TLS_SIGNATURE_TLS12, signed,
        parsed.signature)
    if (!verdict.accepted()) {
        this.certificateRejected = true
        this.fail(verdict.alert, verdict.text)
        return
    }
    this.v12Group = parsed.group
    this.negotiatedGroup = parsed.group
    this.v12Point = parsed.point
    this.transcript.add(message)
    this.state = TLS_CLIENT12_WAIT_HELLO_DONE
    return
}

private fun TlsClient.handleHelloDone12(message: string, body: string): void {
    if (body.size != 0) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a ServerHelloDone with a body")
        return
    }
    this.transcript.add(message)
    val suite = tls12Suite(this.v12Suite)
    val pair = tlsGenerateKeyPair(this.v12Group, this.config.random)
    if (suite == null || pair == null) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the client could not make a key share")
        return
    }
    val shared = tlsAgree(pair, this.v12Point)
    if (!shared.ok) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server's key share is not valid")
        return
    }
    var flight = ""
    // A requested client certificate: its Certificate message, empty when there is no usable identity.
    var scheme = 0
    var identityChain: array<string> = []
    val identity = this.identity
    if (this.requested) {
        if (identity != null && identity.chain.size > 0) {
            for (candidate in identity.schemes) {
                for (accepted in this.requestSchemes) {
                    if (scheme == 0 && candidate == accepted) scheme = candidate
                }
            }
            if (scheme != 0) identityChain = identity.chain
        }
        val certificate = tls12BuildCertificate(identityChain)
        this.transcript.add(certificate)
        flight = flight + certificate
    }
    val keyExchange = tls12BuildClientKeyExchange(pair.publicKey)
    this.transcript.add(keyExchange)
    flight = flight + keyExchange
    // The extended master secret: the session hash is through the ClientKeyExchange.
    val master = tls12MasterSecret(suite.hash, shared.bytes, this.transcript.hash(suite.hash))
    this.masterSecret = master
    // The ephemeral key and the premaster secret are done with once the master secret is made.
    tlsWipe(pair.privateKey)
    tlsWipe(shared.bytes)
    if (scheme != 0 && identity != null) {
        val signature = identity.sign(scheme, this.transcript.messages)
        if (signature.size == 0) {
            this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the client certificate's key could not sign")
            return
        }
        val verify = tlsBuildCertificateVerify(scheme, signature)
        this.transcript.add(verify)
        flight = flight + verify
    }
    val keys = tls12DeriveKeys(suite, master, this.serverRandom, this.helloRandom)
    this.v12Keys = keys
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_HANDSHAKE, 771, flight)
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(1))
    this.v12Write = tls12Protection(suite, keys.clientKey, keys.clientIv)
    this.writeEncrypted = true
    val finished = tlsHandshakeMessage(TLS_FINISHED,
        tls12FinishedData(suite.hash, master, "client finished", this.transcript.hash(suite.hash)))
    this.queueRecord12(TLS_HANDSHAKE, finished)
    this.transcript.add(finished)
    this.state = TLS_CLIENT12_WAIT_CHANGE_CIPHER_SPEC
    return
}

private fun TlsClient.handleFinished12(message: string, body: string): void {
    if (body.size != 12) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a Finished of the wrong length")
        return
    }
    val expected = tls12FinishedData(this.hash, this.masterSecret, "server finished", this.transcript.hash(this.hash))
    // The last use of the master secret (the client's Finished is sent).
    tlsWipe(this.masterSecret)
    if (!constantTimeEquals(expected, body)) {
        this.fail(TLS_ALERT_DECRYPT_ERROR, "tls: the server's Finished does not verify")
        return
    }
    if (!this.handshakeBuffer.empty()) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: data after the server's Finished in its record")
        return
    }
    this.transcript.add(message)
    this.state = TLS_CLIENT_CONNECTED
    return
}

private fun TlsClient.handleMessage12(type: int, message: string, body: string): void {
    if (this.state == TLS_CLIENT12_WAIT_CERTIFICATE) {
        if (type == TLS_CERTIFICATE) this.handleCertificate12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Certificate")
    } else if (this.state == TLS_CLIENT12_WAIT_KEY_EXCHANGE) {
        if (type == TLS12_SERVER_KEY_EXCHANGE) this.handleServerKeyExchange12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a ServerKeyExchange")
    } else if (this.state == TLS_CLIENT12_WAIT_HELLO_DONE) {
        if (type == TLS_CERTIFICATE_REQUEST && !this.requested) {
            val schemes = tls12ParseCertificateRequest(body.slice(0, body.size))
            if (schemes.size == 0) {
                this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed CertificateRequest")
                return
            }
            this.requested = true
            this.requestSchemes = schemes
            this.transcript.add(message)
        } else if (type == TLS12_SERVER_HELLO_DONE) this.handleHelloDone12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a ServerHelloDone")
    } else if (this.state == TLS_CLIENT12_WAIT_FINISHED) {
        if (type == TLS_FINISHED) this.handleFinished12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Finished")
    } else {
        // Anything else, including a HelloRequest (renegotiation, which the subset refuses).
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected handshake message")
    }
    return
}

private fun TlsClient.processHandshake12(): void {
    while (this.state != TLS_CLIENT_FAILED && this.state != TLS_CLIENT_CLOSED) {
        val header = this.handshakeBuffer.header()
        // The cap is checked at the header, before the body is buffered (a peer not yet authenticated).
        if (header.bodyLength > tlsMessageLimit(header.type)) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a handshake message longer than allowed")
            return
        }
        if (!header.complete) return
        val message = this.handshakeBuffer.take(header.total)
        this.handleMessage12(header.type, message, message.slice(4, message.size))
    }
    return
}

private fun TlsClient.handleRecord12(record: string, header: TlsRecordHeader): void {
    if (header.type == TLS_CHANGE_CIPHER_SPEC) {
        if (this.state != TLS_CLIENT12_WAIT_CHANGE_CIPHER_SPEC || record.size != 6 || record[5] != 1) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected ChangeCipherSpec")
            return
        }
        if (!this.handshakeBuffer.empty()) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: handshake data before the ChangeCipherSpec")
            return
        }
        val suite = tls12Suite(this.v12Suite) ?? return
        this.v12Read = tls12Protection(suite, this.v12Keys.serverKey, this.v12Keys.serverIv)
        this.readEncrypted = true
        this.state = TLS_CLIENT12_WAIT_FINISHED
        return
    }
    var type = header.type
    var content = ""
    if (this.readEncrypted) {
        val opened = tls12Open(this.v12Read, record)
        if (!opened.ok) {
            this.fail(if (opened.error == "tls: record overflow") TLS_ALERT_RECORD_OVERFLOW else TLS_ALERT_BAD_RECORD_MAC,
                opened.error)
            return
        }
        type = opened.type
        content = opened.content
    } else {
        if (header.length > TLS_MAX_PLAINTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        content = record.slice(5, record.size)
    }
    if (content.size == 0) {
        this.emptyRun = this.emptyRun + 1
        if (this.emptyRun > TLS_MAX_EMPTY_RUN) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: too many empty records")
            return
        }
    } else {
        if (type != TLS_ALERT) this.emptyRun = 0
        if (type != TLS_ALERT) this.warningRun = 0
    }
    if (type == TLS_HANDSHAKE) {
        if (content.size == 0) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an empty handshake record")
            return
        }
        this.handshakeBuffer.add(content)
        this.processHandshake12()
    } else if (type == TLS_ALERT) {
        this.handleAlert(content)
    } else if (type == TLS_APPLICATION_DATA && this.readEncrypted && this.state == TLS_CLIENT_CONNECTED) {
        this.applicationData = this.applicationData + content
    } else {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected record type $type")
    }
    return
}

private fun TlsClient.send12(data: string): bool {
    var offset = 0
    while (offset < data.size && this.state == TLS_CLIENT_CONNECTED) {
        val end = if (data.size - offset > TLS12_MAX_PLAINTEXT) offset + TLS12_MAX_PLAINTEXT else data.size
        this.queueRecord12(TLS_APPLICATION_DATA, data.slice(offset, end))
        offset = end
    }
    this.state == TLS_CLIENT_CONNECTED
}

/** A NewSessionTicket (section 4.6.1): kept in the caller's cache, with the PSK made from the resumption master secret and the ticket's nonce. */
private fun TlsClient.handleNewSessionTicket(body: string): void {
    val parsed = tlsParseNewSessionTicket(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed NewSessionTicket")
        return
    }
    val cache = this.config.sessions
    if (cache == null || this.resumptionMaster.size == 0) return
    val psk = tlsResumptionPsk(this.hash, this.resumptionMaster, parsed.nonce)
    if (psk.size > 0) cache.put(this.config.host, this.negotiatedAlpn, this.suite, parsed.ticket, psk, parsed.ageAdd, parsed.lifetime, this.config.sessionScope)
    tlsWipe(psk)
    return
}

/** Whether this connection resumed a session: the server accepted a ticket from the cache (so no certificate was sent). */
fun TlsClient.resumed(): bool = this.didResume

/** The channel binding of `kind` ("tls-exporter" or "tls-server-end-point", abla/tls/pure/binding), raw bytes, "" when it is not available (see there). Valid once connected. */
fun TlsClient.channelBinding(kind: string): string =
    if (this.state != TLS_CLIENT_CONNECTED) ""
    else if (kind == TLS_BINDING_EXPORTER) this.channelExporter
    else if (kind == TLS_BINDING_END_POINT && !this.didResume && this.chain.size > 0) tlsEndPointBinding(this.chain[0])
    else ""

/** `config` with its ticket cache set (the other fields as they were): a connection made from it offers the tickets in `sessions` that were obtained under the same `scope` and keeps the ones the server
 *  sends under it. `scope` names what authenticates the server for this configuration (the verify mode and trust anchors, for abla/tls/pure's own configurations; `tlsX509Scope(store)` for
 *  `tlsX509Verifier(store, now)`): a ticket resumes without a Certificate, so a ticket must never cross to a configuration that verifies differently. "" keeps and offers none. */
fun tlsClientConfigWithSessions(config: TlsClientConfig, sessions: TlsSessionCache?, scope: string): TlsClientConfig =
    TlsClientConfig(config.host, config.suites, config.signatureAlgorithms, config.alpn, config.verifier, config.random, config.secondHello,
        config.suites12, config.fallback, config.groups, sessions, scope)

/** `config` offering the application protocols `alpn` (in the client's order, for example ["h2", "http/1.1"]); the server's choice is `TlsClient.alpn()`
 *  once connected ("" when it chose none). Names are checked when the client starts. */
fun tlsClientConfigWithAlpn(config: TlsClientConfig, alpn: array<string>): TlsClientConfig =
    TlsClientConfig(config.host, config.suites, config.signatureAlgorithms, alpn, config.verifier, config.random, config.secondHello,
        config.suites12, config.fallback, config.groups, config.sessions, config.sessionScope)

/** A ClientHello and the ticket it offers (null when it offers none). */
class TlsBuiltHello(val message: string, val ticket: TlsStoredTicket?)

/** The ClientHello for `config` and the key shares in `offer`: with a ticket cache, a ticket for the host and ALPN protocols (taken out of the cache) goes in as a PSK
 *  (psk_dhe_ke) with its binder over the partial ClientHello (RFC 8446 section 4.2.11). The caller starts the client with the message (tlsClientStartWith) and sets
 *  `offeredPsk` to the ticket, or uses tlsClientNew, which does all this. */
fun tlsClientBuildHello(config: TlsClientConfig, helloRandom: string, sessionId: string, offer: TlsClientShares): TlsBuiltHello {
    var stored: TlsStoredTicket? = null
    val cache = config.sessions
    var clock = 0
    if (cache != null && config.suites.size > 0) {
        clock = cache.now()
        stored = cache.take(config.host, config.alpn, config.sessionScope)
    }
    var offers: array<TlsPskIdentity> = []
    var binderLength = 0
    val ticket = stored
    if (ticket != null) {
        // The age is in milliseconds, obfuscated with the ticket_age_add, modulo 2^32 (section 4.2.11.1).
        val age = ((clock - ticket.received) * 1000 + ticket.ageAdd) & 4294967295
        offers = [TlsPskIdentity(ticket.ticket, age)]
        binderLength = tlsHashLength(tlsSuiteHash(ticket.suite))
    }
    var hello = tlsBuildClientHello(helloRandom, sessionId, config.suites, config.host,
        offer.groups, offer.shares, config.signatureAlgorithms, config.alpn, "", config.suites12, config.fallback, offers, binderLength,
        cache != null && config.suites.size > 0)
    if (ticket != null) {
        // The binder covers the ClientHello up to the binders list (section 4.2.11.2).
        val partial = hello.slice(0, tlsBindersStart(hello))
        hello = tlsReplaceBinders(hello, [tlsBinderValue(tlsSuiteHash(ticket.suite), ticket.psk, partial)])
    }
    TlsBuiltHello(hello, stored)
}
