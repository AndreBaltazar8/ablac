// A TLS 1.3 client as a sans-IO state machine (RFC 8446): bytes received go in with `feed`, bytes to
// send come out of `takeOutput`, decrypted application data out of `takeApplicationData`, and
// `send`/`close` queue records. No sockets, no clock, no randomness of its own: the random source is
// in the configuration, and certificate verification is a callback (the x509 layer plugs in there), so
// the RFC 8448 traces replay byte for byte.
//
// What it does: ClientHello (X25519 key share; AES-128/256-GCM suites), HelloRetryRequest (once), the
// whole key schedule, EncryptedExtensions (ALPN), Certificate and CertificateVerify (the signed content
// is built here, the verification is the configured callback's), Finished both ways (constant-time
// compare), NewSessionTicket (validated, dropped), KeyUpdate, alerts, close_notify, middlebox
// compatibility (ChangeCipherSpec). What it refuses: anything below TLS 1.3, a second
// HelloRetryRequest, compression, unexpected message order, a bad record or Finished, application data
// before the handshake ends. Not yet: client certificates, resumption, 0-RTT.

import "abla/crypto"
import "abla/crypto/hkdf"
import "abla/crypto/p256"
import "abla/crypto/x25519"
import "abla/tls/pure/handshake"
import "abla/tls/pure/keysched"
import "abla/tls/pure/record"
import "abla/tls/pure/tls12"

val TLS_CLIENT_START = 0
val TLS_CLIENT_WAIT_SERVER_HELLO = 1
val TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS = 2
val TLS_CLIENT_WAIT_CERTIFICATE = 3
val TLS_CLIENT_WAIT_CERTIFICATE_VERIFY = 4
val TLS_CLIENT_WAIT_FINISHED = 5
val TLS_CLIENT_CONNECTED = 6
val TLS_CLIENT_CLOSED = 7
val TLS_CLIENT_FAILED = 8

val TLS_ALERT_CLOSE_NOTIFY = 0
val TLS_ALERT_UNEXPECTED_MESSAGE = 10
val TLS_ALERT_BAD_RECORD_MAC = 20
val TLS_ALERT_RECORD_OVERFLOW = 22
val TLS_ALERT_HANDSHAKE_FAILURE = 40
val TLS_ALERT_BAD_CERTIFICATE = 42
val TLS_ALERT_ILLEGAL_PARAMETER = 47
val TLS_ALERT_DECODE_ERROR = 50
val TLS_ALERT_DECRYPT_ERROR = 51
val TLS_ALERT_PROTOCOL_VERSION = 70
val TLS_ALERT_INTERNAL_ERROR = 80
val TLS_ALERT_MISSING_EXTENSION = 109

/** The certificate check: the chain (DER, end entity first), the host name, the signature scheme of
 *  the CertificateVerify, the content that was signed and the signature. Returns "" when the chain is
 *  trusted for the host and the signature is valid, else the reason. */
class TlsClientConfig(
    val host: string,
    val suites: array<int>,
    val signatureAlgorithms: array<int>,
    val alpn: array<string>,
    val verifier: (array<string>, string, int, string, string) -> string,
    val random: (int) -> string,
    /** Builds the ClientHello that answers a HelloRetryRequest from the first one, the new key share and
     *  the cookie ("" for none); tlsPatchClientHello is the standard answer. */
    val secondHello: (string, TlsKeyShare, string) -> string,
    /** The TLS 1.2 suites (the modern subset) offered besides TLS 1.3's: [] makes a TLS 1.3-only client. */
    val suites12: array<int> = [TLS12_ECDHE_ECDSA_AES_128_GCM_SHA256, TLS12_ECDHE_RSA_AES_128_GCM_SHA256,
        TLS12_ECDHE_ECDSA_AES_256_GCM_SHA384, TLS12_ECDHE_RSA_AES_256_GCM_SHA384,
        TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256, TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256]
)

/** An ephemeral key pair offered in the key_share extension. */
class TlsKeyPair(val group: int, val publicKey: string, val privateKey: string)

/** A client certificate for mutual TLS: the chain (DER, end entity first), the signature schemes its key can
 *  make, and the signing function (scheme and the content to sign give the signature, "" on failure). */
class TlsClientIdentity(val chain: array<string>, val schemes: array<int>, val sign: (int, string) -> string,
    val error: string = "") {
    /** True for an identity with a certificate and a key that signs. */
    fun ok(): bool = this.error == "" && this.chain.size > 0
}

class TlsClient(
    val config: TlsClientConfig,
    var state: int,
    var error: string,
    var inbox: string,
    var handshakeBuffer: string,
    var outbox: string,
    var applicationData: string,
    val transcript: TlsTranscript,
    var hash: int,
    var suite: int,
    var keyLength: int,
    var aead: int,
    val helloRandom: string,
    val sessionId: string,
    var firstHello: string,
    var keyPairs: array<TlsKeyPair>,
    var retried: bool,
    var retrySuite: int,
    var readEncrypted: bool,
    var writeEncrypted: bool,
    var read: TlsRecordProtection,
    var write: TlsRecordProtection,
    var handshakeSecret: string,
    var clientHandshakeSecret: string,
    var serverHandshakeSecret: string,
    var clientApplicationSecret: string,
    var serverApplicationSecret: string,
    var masterSecret: string,
    var chain: array<string>,
    var negotiatedAlpn: string,
    var sentCompatibilityChangeCipherSpec: bool,
    var peerClosed: bool,
    var sentClose: bool,
    /** True when the handshake failed in the certificate check (the verifier's answer). */
    var certificateRejected: bool,
    /** The identity to present when the server asks for a certificate; null presents none. */
    var identity: TlsClientIdentity?,
    /** The certificate request's context and schemes, once the server has sent one. */
    var requested: bool,
    var requestContext: string,
    var requestSchemes: array<int>,
    /** TLS 1.2 (set when the server's hello chooses it): the suite code, the protections, the keys, the server random,
     *  the server's key-exchange group and point. */
    var v12: bool,
    var v12Suite: int,
    var v12Read: Tls12Protection,
    var v12Write: Tls12Protection,
    var v12Keys: Tls12Keys,
    var serverRandom: string,
    var v12Group: int,
    var v12Point: string
)

fun tlsAeadFor(suite: int): int =
    if (suite == TLS_SUITE_AES_128_GCM_SHA256) TLS_AEAD_AES_128_GCM
    else if (suite == TLS_SUITE_AES_256_GCM_SHA384) TLS_AEAD_AES_256_GCM
    else if (suite == TLS_SUITE_CHACHA20_POLY1305_SHA256) TLS_AEAD_CHACHA20_POLY1305 else 0

fun tlsSuiteHash(suite: int): int = if (suite == TLS_SUITE_AES_256_GCM_SHA384) HKDF_SHA384 else HKDF_SHA256

/** A key pair for `group` from 32 bytes of randomness: X25519 only for now; `ok` false for others. */
fun tlsGenerateKeyPair(group: int, random: (int) -> string): TlsKeyPair? {
    if (group == TLS_GROUP_X25519) {
        val privateKey = random(32)
        val publicKey = x25519PublicKey(privateKey)
        if (!publicKey.ok) return null
        return TlsKeyPair(group, publicKey.bytes, privateKey)
    }
    if (group == TLS_GROUP_SECP256R1) {
        // A random 32-byte string is a valid scalar but for one value in 2^32: ask again.
        var attempt = 0
        while (attempt < 4) {
            val privateKey = random(32)
            val publicKey = p256PublicKey(privateKey)
            if (publicKey.ok) return TlsKeyPair(group, publicKey.bytes, privateKey)
            attempt = attempt + 1
        }
    }
    null
}

/** The shared secret of our key pair and the peer's share; `ok` false for an invalid share. */
fun tlsAgree(pair: TlsKeyPair, peerShare: string): CryptoResult =
    if (pair.group == TLS_GROUP_X25519) x25519(pair.privateKey, peerShare)
    else if (pair.group == TLS_GROUP_SECP256R1) p256Ecdh(pair.privateKey, peerShare)
    else cryptoFailed("tls: unsupported group")

private fun tlsEmptyProtection(): TlsRecordProtection = tlsRecordProtection(TLS_AEAD_AES_128_GCM, "", "")

/** The usual configuration: AES-GCM suites, the signature schemes the stack can verify, no ALPN. */
fun tlsClientConfig(host: string, verifier: (array<string>, string, int, string, string) -> string,
    random: (int) -> string): TlsClientConfig =
    TlsClientConfig(host, [TLS_SUITE_AES_128_GCM_SHA256, TLS_SUITE_AES_256_GCM_SHA384,
        TLS_SUITE_CHACHA20_POLY1305_SHA256],
        [TLS_SIG_ECDSA_SECP256R1_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA256, TLS_SIG_RSA_PSS_RSAE_SHA384,
         TLS_SIG_RSA_PSS_RSAE_SHA512, TLS_SIG_ED25519, TLS_SIG_ECDSA_SECP384R1_SHA384, TLS_SIG_RSA_PKCS1_SHA256,
         TLS_SIG_RSA_PKCS1_SHA384, TLS_SIG_RSA_PKCS1_SHA512],
        [], verifier, random, tlsPatchClientHello)

/** Starts a client from a ClientHello message that is already built (its 4-byte header included), with
 *  the random, session id and key pairs it was built from. The RFC 8448 traces use this; `tlsClientNew`
 *  builds its own. The ClientHello is queued as the first record. */
fun tlsClientStartWith(config: TlsClientConfig, clientHello: string, helloRandom: string, sessionId: string,
    keyPairs: array<TlsKeyPair>, recordVersion: int): TlsClient {
    val client = TlsClient(config, TLS_CLIENT_WAIT_SERVER_HELLO, "", "", "", "", "", tlsTranscript(),
        HKDF_SHA256, 0, 16, TLS_AEAD_AES_128_GCM, helloRandom, sessionId, clientHello, keyPairs, false, 0,
        false, false, tlsEmptyProtection(), tlsEmptyProtection(), "", "", "", "", "", "", [], "", false,
        false, false, false, null, false, "", [], false, 0, tls12Protection(tls12Placeholder(), "", ""),
        tls12Protection(tls12Placeholder(), "", ""), Tls12Keys("", "", "", ""), "", 0, "")
    client.transcript.add(clientHello)
    client.outbox = tlsPlaintextRecord(TLS_HANDSHAKE, recordVersion, clientHello)
    client
}

/** Starts a client: builds a ClientHello with a fresh random, a 32-byte compatibility session id and an
 *  X25519 key share from the configuration's random source. */
fun tlsClientNew(config: TlsClientConfig): TlsClient {
    val helloRandom = config.random(32)
    val sessionId = config.random(32)
    val pair = tlsGenerateKeyPair(TLS_GROUP_X25519, config.random)
    val pairs: array<TlsKeyPair> = []
    val shares: array<TlsKeyShare> = []
    if (pair != null) {
        pairs.append(pair)
        shares.append(TlsKeyShare(pair.group, pair.publicKey))
    }
    val hello = tlsBuildClientHello(helloRandom, sessionId, config.suites, config.host,
        [TLS_GROUP_X25519, TLS_GROUP_SECP256R1], shares, config.signatureAlgorithms, config.alpn, "", config.suites12)
    tlsClientStartWith(config, hello, helloRandom, sessionId, pairs, 769)
}

fun TlsClient.failed(): bool = this.state == TLS_CLIENT_FAILED
fun TlsClient.connected(): bool = this.state == TLS_CLIENT_CONNECTED
/** True once the peer sent close_notify (every byte it sent was delivered). */
fun TlsClient.closed(): bool = this.peerClosed

/** The bytes to send to the peer; empties the queue. */
fun TlsClient.takeOutput(): string {
    val data = this.outbox
    this.outbox = ""
    data
}

/** The application data received so far; empties the buffer. */
fun TlsClient.takeApplicationData(): string {
    val data = this.applicationData
    this.applicationData = ""
    data
}

/** Sets the certificate to present if the server asks for one (before the first `feed`). */
fun TlsClient.useIdentity(identity: TlsClientIdentity): void {
    this.identity = identity
    return
}

/** The ALPN protocol the server chose ("" for none). */
fun TlsClient.alpn(): string = this.negotiatedAlpn

private fun TlsClient.queueAlert(description: int): void {
    val body = cryptoByteString([if (description == TLS_ALERT_CLOSE_NOTIFY) 1 else 2, description])
    if (this.v12) {
        if (this.writeEncrypted) {
            val sealed = tls12Protect(this.v12Write, TLS_ALERT, body)
            if (sealed.ok) this.outbox = this.outbox + sealed.bytes
        } else {
            this.outbox = this.outbox + tlsPlaintextRecord(TLS_ALERT, 771, body)
        }
        return
    }
    if (this.writeEncrypted) {
        val sealed = tlsProtectRecord(this.write, TLS_ALERT, body)
        if (sealed.ok) this.outbox = this.outbox + sealed.bytes
    } else {
        this.outbox = this.outbox + tlsPlaintextRecord(TLS_ALERT, 771, body)
    }
    return
}

/** Fails the connection: queues a fatal alert and stops processing. */
private fun TlsClient.fail(description: int, message: string): void {
    if (this.state == TLS_CLIENT_FAILED || this.state == TLS_CLIENT_CLOSED) return
    this.queueAlert(description)
    this.state = TLS_CLIENT_FAILED
    this.error = message
    return
}

private fun TlsClient.queueRecord(type: int, content: string): void {
    val sealed = tlsProtectRecord(this.write, type, content)
    if (!sealed.ok) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, sealed.error)
        return
    }
    this.outbox = this.outbox + sealed.bytes
    return
}

private fun TlsClient.setKeys(secret: string, forWrite: bool): void {
    val protection = tlsRecordProtection(this.aead, tlsTrafficKey(this.hash, secret, this.keyLength),
        tlsTrafficIv(this.hash, secret))
    if (forWrite) {
        this.write = protection
        this.writeEncrypted = true
    } else {
        this.read = protection
        this.readEncrypted = true
    }
    return
}

private fun TlsClient.sendCompatibilityChangeCipherSpec(): void {
    if (this.sessionId.size == 0 || this.sentCompatibilityChangeCipherSpec) return
    this.sentCompatibilityChangeCipherSpec = true
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(1))
    return
}

private fun TlsClient.keyPairFor(group: int): TlsKeyPair? {
    for (pair in this.keyPairs) {
        if (pair.group == group) return pair
    }
    null
}

private fun TlsClient.handleServerHello(message: string, body: string): void {
    val hello = tlsParseServerHello(body)
    if (!hello.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, hello.error)
        return
    }
    if (hello.selectedVersion != 772) {
        val sentinel = hello.random.slice(24, 32)
        if (sentinel == "DOWNGRD" + tlsU8(1) || sentinel == "DOWNGRD" + tlsU8(0)) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: downgrade detected")
        } else if (this.config.suites12.size > 0 && hello.selectedVersion == 0 && !this.retried) {
            this.startV12(message, body)
        } else {
            this.fail(TLS_ALERT_PROTOCOL_VERSION, "tls: the server does not speak TLS 1.3")
        }
        return
    }
    if (hello.sessionId != this.sessionId) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the ServerHello does not echo the session id")
        return
    }
    var offered = false
    for (suite in this.config.suites) {
        if (suite == hello.cipherSuite) offered = true
    }
    if (!offered || tlsAeadFor(hello.cipherSuite) == 0) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose a cipher suite that was not offered")
        return
    }
    if (this.retried && hello.cipherSuite != this.retrySuite) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the cipher suite changed after HelloRetryRequest")
        return
    }
    this.suite = hello.cipherSuite
    this.hash = tlsSuiteHash(hello.cipherSuite)
    this.aead = tlsAeadFor(hello.cipherSuite)
    this.keyLength = tlsAeadKeyLength(this.aead)
    if (hello.retryRequest) {
        this.handleRetryRequest(message, hello)
        return
    }
    if (hello.shareKey.size == 0) {
        this.fail(TLS_ALERT_MISSING_EXTENSION, "tls: the ServerHello has no key share")
        return
    }
    val pair = this.keyPairFor(hello.shareGroup)
    if (pair == null) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose a key share group that was not offered")
        return
    }
    val shared = tlsAgree(pair, hello.shareKey)
    if (!shared.ok) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the key exchange failed")
        return
    }
    this.transcript.add(message)
    val early = tlsEarlySecret(this.hash, "")
    val secrets = tlsDeriveHandshakeSecrets(this.hash, early, shared.bytes, this.transcript.hash(this.hash))
    this.handshakeSecret = secrets.handshakeSecret
    this.clientHandshakeSecret = secrets.clientTraffic
    this.serverHandshakeSecret = secrets.serverTraffic
    this.setKeys(secrets.serverTraffic, false)
    this.state = TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS
    return
}

private fun TlsClient.handleRetryRequest(message: string, hello: TlsServerHello): void {
    if (this.retried) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: a second HelloRetryRequest")
        return
    }
    if (this.keyPairFor(hello.shareGroup) != null || hello.shareGroup == 0) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the HelloRetryRequest selects no new group")
        return
    }
    var offered = false
    for (group in tlsClientHelloGroups(this.firstHello)) {
        if (group == hello.shareGroup) offered = true
    }
    if (!offered) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the HelloRetryRequest selects a group that was not offered")
        return
    }
    val pair = tlsGenerateKeyPair(hello.shareGroup, this.config.random)
    if (pair == null) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: the server asks for a group this client does not support")
        return
    }
    this.retried = true
    this.retrySuite = hello.cipherSuite
    // The transcript restarts with a synthetic message_hash of the first ClientHello (section 4.4.1).
    val firstHash = tlsHashOf(this.hash, this.firstHello)
    this.transcript.messages = tlsHandshakeMessage(TLS_MESSAGE_HASH, firstHash)
    this.transcript.add(message)
    this.keyPairs = [pair]
    this.sendCompatibilityChangeCipherSpec()
    val second = this.config.secondHello(this.firstHello, TlsKeyShare(pair.group, pair.publicKey), hello.cookie)
    if (second.size == 0) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the second ClientHello could not be built")
        return
    }
    this.transcript.add(second)
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_HANDSHAKE, 771, second)
    return
}

private fun TlsClient.handleEncryptedExtensions(message: string, body: string): void {
    val parsed = tlsParseEncryptedExtensions(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, parsed.error)
        return
    }
    if (parsed.alpn.size > 0) {
        var known = false
        for (name in this.config.alpn) {
            if (name == parsed.alpn) known = true
        }
        if (!known) {
            this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose an ALPN protocol that was not offered")
            return
        }
    }
    this.negotiatedAlpn = parsed.alpn
    this.transcript.add(message)
    this.state = TLS_CLIENT_WAIT_CERTIFICATE
    return
}

private fun TlsClient.handleCertificate(message: string, body: string): void {
    val parsed = tlsParseCertificate(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, parsed.error)
        return
    }
    if (parsed.context.size != 0 || parsed.chain.size == 0) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a Certificate with a request context or no certificates")
        return
    }
    this.chain = parsed.chain
    this.transcript.add(message)
    this.state = TLS_CLIENT_WAIT_CERTIFICATE_VERIFY
    return
}

private fun TlsClient.handleCertificateVerify(message: string, body: string): void {
    val parsed = tlsParseCertificateVerify(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: malformed CertificateVerify")
        return
    }
    var offered = false
    for (scheme in this.config.signatureAlgorithms) {
        // RSA PKCS#1 v1.5 schemes are for certificate signatures and TLS 1.2 only (RFC 8446 section 4.2.3).
        if (scheme == parsed.scheme && scheme != TLS_SIG_RSA_PKCS1_SHA256 && scheme != TLS_SIG_RSA_PKCS1_SHA384 &&
            scheme != TLS_SIG_RSA_PKCS1_SHA512) offered = true
    }
    if (!offered) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a signature scheme that was not offered")
        return
    }
    val content = tlsCertificateVerifyContent(true, this.transcript.hash(this.hash))
    val verdict = this.config.verifier(this.chain, this.config.host, parsed.scheme, content, parsed.signature)
    if (verdict.size > 0) {
        this.certificateRejected = true
        this.fail(TLS_ALERT_BAD_CERTIFICATE, verdict)
        return
    }
    this.transcript.add(message)
    this.state = TLS_CLIENT_WAIT_FINISHED
    return
}

/** The client's Certificate (empty when it has no identity or none of its keys fits the server's schemes) and,
 *  with one, its CertificateVerify; both go into the transcript. */
private fun TlsClient.clientAuthenticationMessages(): string {
    val identity = this.identity
    var scheme = 0
    if (identity != null && identity.chain.size > 0) {
        for (candidate in identity.schemes) {
            for (accepted in this.requestSchemes) {
                if (scheme == 0 && candidate == accepted) scheme = candidate
            }
        }
    }
    if (identity == null || scheme == 0) {
        val empty = tlsBuildCertificate(this.requestContext, [])
        this.transcript.add(empty)
        return empty
    }
    val certificate = tlsBuildCertificate(this.requestContext, identity.chain)
    this.transcript.add(certificate)
    val content = tlsCertificateVerifyContent(false, this.transcript.hash(this.hash))
    val signature = identity.sign(scheme, content)
    if (signature.size == 0) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the client certificate's key could not sign")
        return ""
    }
    val verify = tlsBuildCertificateVerify(scheme, signature)
    this.transcript.add(verify)
    certificate + verify
}

private fun TlsClient.handleCertificateRequest(message: string, body: string): void {
    val request = tlsParseCertificateRequest(body)
    if (!request.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed CertificateRequest")
        return
    }
    this.requested = true
    this.requestContext = request.context
    this.requestSchemes = request.signatureAlgorithms
    this.transcript.add(message)
    return
}

private fun TlsClient.handleFinished(message: string, body: string): void {
    if (body.size != tlsHashLength(this.hash)) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a Finished of the wrong length")
        return
    }
    val expected = tlsFinishedVerifyData(this.hash, this.serverHandshakeSecret, this.transcript.hash(this.hash))
    if (!constantTimeEquals(expected, body)) {
        this.fail(TLS_ALERT_DECRYPT_ERROR, "tls: the server's Finished does not verify")
        return
    }
    if (this.handshakeBuffer.size != 0) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: data after the server's Finished in its record")
        return
    }
    this.transcript.add(message)
    val serverFinishedHash = this.transcript.hash(this.hash)
    val application = tlsDeriveApplicationSecrets(this.hash, this.handshakeSecret, serverFinishedHash)
    this.masterSecret = application.masterSecret
    this.clientApplicationSecret = application.clientTraffic
    this.serverApplicationSecret = application.serverTraffic
    // The client's second flight: ChangeCipherSpec (compatibility mode), then its Finished under the
    // client handshake keys, then everything after is application traffic.
    this.sendCompatibilityChangeCipherSpec()
    this.setKeys(this.clientHandshakeSecret, true)
    // With client authentication, its Certificate and CertificateVerify come first, in the same record.
    var flight = ""
    if (this.requested) {
        flight = this.clientAuthenticationMessages()
        if (this.state == TLS_CLIENT_FAILED) return
    }
    val verify = tlsFinishedVerifyData(this.hash, this.clientHandshakeSecret, this.transcript.hash(this.hash))
    val finished = tlsHandshakeMessage(TLS_FINISHED, verify)
    this.queueRecord(TLS_HANDSHAKE, flight + finished)
    this.transcript.add(finished)
    this.setKeys(application.clientTraffic, true)
    this.setKeys(application.serverTraffic, false)
    this.state = TLS_CLIENT_CONNECTED
    return
}

private fun TlsClient.handleKeyUpdate(body: string): void {
    if (body.size != 1 || body[0] > 1) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed KeyUpdate")
        return
    }
    this.serverApplicationSecret = tlsNextTrafficSecret(this.hash, this.serverApplicationSecret)
    this.setKeys(this.serverApplicationSecret, false)
    if (body[0] == 1) {
        this.queueRecord(TLS_HANDSHAKE, tlsHandshakeMessage(TLS_KEY_UPDATE, tlsU8(0)))
        this.clientApplicationSecret = tlsNextTrafficSecret(this.hash, this.clientApplicationSecret)
        this.setKeys(this.clientApplicationSecret, true)
    }
    return
}

private fun TlsClient.handleMessage(type: int, message: string, body: string): void {
    if (this.state == TLS_CLIENT_WAIT_SERVER_HELLO) {
        if (type == TLS_SERVER_HELLO) this.handleServerHello(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a ServerHello")
    } else if (this.state == TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS) {
        if (type == TLS_ENCRYPTED_EXTENSIONS) this.handleEncryptedExtensions(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected EncryptedExtensions")
    } else if (this.state == TLS_CLIENT_WAIT_CERTIFICATE) {
        if (type == TLS_CERTIFICATE) this.handleCertificate(message, body)
        else if (type == TLS_CERTIFICATE_REQUEST && !this.requested) this.handleCertificateRequest(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Certificate")
    } else if (this.state == TLS_CLIENT_WAIT_CERTIFICATE_VERIFY) {
        if (type == TLS_CERTIFICATE_VERIFY) this.handleCertificateVerify(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a CertificateVerify")
    } else if (this.state == TLS_CLIENT_WAIT_FINISHED) {
        if (type == TLS_FINISHED) this.handleFinished(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Finished")
    } else if (this.state == TLS_CLIENT_CONNECTED) {
        if (type == TLS_NEW_SESSION_TICKET) {
            if (!tlsParseNewSessionTicket(body).ok) this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed NewSessionTicket")
        } else if (type == TLS_KEY_UPDATE) this.handleKeyUpdate(body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected handshake message")
    }
    return
}

/** Handles whole handshake messages from the buffer, keeping an incomplete tail. A message that
 *  straddles a key change is refused. */
private fun TlsClient.processHandshake(): void {
    while (this.state != TLS_CLIENT_FAILED && this.state != TLS_CLIENT_CLOSED) {
        val header = tlsParseMessageHeader(this.handshakeBuffer, 0)
        if (!header.complete) return
        val message = this.handshakeBuffer.slice(0, header.total)
        this.handshakeBuffer = this.handshakeBuffer.slice(header.total, this.handshakeBuffer.size)
        this.handleMessage(header.type, message, message.slice(4, message.size))
        if (this.handshakeBuffer.size > 0 && this.state == TLS_CLIENT_WAIT_ENCRYPTED_EXTENSIONS) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: handshake data after the ServerHello in its record")
            return
        }
    }
    return
}

private fun TlsClient.handleAlert(content: string): void {
    if (content.size != 2) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed alert")
        return
    }
    if (content[1] == TLS_ALERT_CLOSE_NOTIFY) {
        this.peerClosed = true
        if (!this.sentClose) this.queueAlert(TLS_ALERT_CLOSE_NOTIFY)
        this.sentClose = true
        this.state = TLS_CLIENT_CLOSED
        return
    }
    this.state = TLS_CLIENT_FAILED
    this.error = "tls: the server sent alert ${content[1]}"
    return
}

private fun TlsClient.handleRecord(record: string, header: TlsRecordHeader): void {
    if (this.v12) {
        this.handleRecord12(record, header)
        return
    }
    if (header.type == TLS_CHANGE_CIPHER_SPEC) {
        // Compatibility mode (appendix D.4): one 0x01 byte, ignored, only during the handshake.
        // (A server may send it right after a HelloRetryRequest too.)
        if (this.state == TLS_CLIENT_CONNECTED || record.size != 6 || record[5] != 1 ||
            (this.state == TLS_CLIENT_WAIT_SERVER_HELLO && !this.retried)) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected ChangeCipherSpec")
        }
        return
    }
    var type = header.type
    var content = ""
    if (this.readEncrypted) {
        if (header.type != TLS_APPLICATION_DATA) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unprotected record after the keys were set")
            return
        }
        val opened = tlsOpenRecord(this.read, record)
        if (!opened.ok) {
            this.fail(if (opened.error == "tls: record overflow") TLS_ALERT_RECORD_OVERFLOW else TLS_ALERT_BAD_RECORD_MAC,
                opened.error)
            return
        }
        type = opened.type
        content = opened.content
    } else {
        if (header.length > TLS_MAX_PLAINTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        content = record.slice(5, record.size)
    }
    if (type == TLS_HANDSHAKE) {
        if (content.size == 0) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an empty handshake record")
            return
        }
        this.handshakeBuffer = this.handshakeBuffer + content
        this.processHandshake()
    } else if (type == TLS_ALERT) {
        this.handleAlert(content)
    } else if (type == TLS_APPLICATION_DATA && this.readEncrypted && this.state == TLS_CLIENT_CONNECTED) {
        this.applicationData = this.applicationData + content
    } else {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected record type $type")
    }
    return
}

/** Feeds bytes received from the peer: every complete record in them is processed. */
fun TlsClient.feed(data: string): void {
    if (this.state == TLS_CLIENT_FAILED || this.state == TLS_CLIENT_CLOSED) return
    this.inbox = this.inbox + data
    while (this.state != TLS_CLIENT_FAILED && this.state != TLS_CLIENT_CLOSED) {
        val header = tlsParseRecordHeader(this.inbox, 0)
        if (!header.ok) return
        if (header.length > TLS_MAX_CIPHERTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        if (this.inbox.size < 5 + header.length) return
        val record = this.inbox.slice(0, 5 + header.length)
        this.inbox = this.inbox.slice(5 + header.length, this.inbox.size)
        this.handleRecord(record, header)
    }
    return
}

/** Queues application data (any length) as records. False when the connection is not open. */
fun TlsClient.send(data: string): bool {
    if (this.state != TLS_CLIENT_CONNECTED) return false
    if (this.v12) return this.send12(data)
    var offset = 0
    while (offset < data.size && this.state == TLS_CLIENT_CONNECTED) {
        val end = if (data.size - offset > TLS_MAX_PLAINTEXT) offset + TLS_MAX_PLAINTEXT else data.size
        this.queueRecord(TLS_APPLICATION_DATA, data.slice(offset, end))
        offset = end
    }
    this.state == TLS_CLIENT_CONNECTED
}

/** Queues close_notify; the connection takes no more application data. */
fun TlsClient.close(): void {
    if (this.state == TLS_CLIENT_CONNECTED && !this.sentClose) {
        this.queueAlert(TLS_ALERT_CLOSE_NOTIFY)
        this.sentClose = true
        this.state = TLS_CLIENT_CLOSED
    }
    return
}

// ---- TLS 1.2 (the modern subset, RFC 5246 with RFC 7627's extended master secret) ----
// The server's ServerHello without supported_versions switches the client to this path: Certificate,
// ServerKeyExchange (ECDHE, signed under the certificate's key with the client's and server's randoms),
// [CertificateRequest], ServerHelloDone; then the client's [Certificate], ClientKeyExchange, [CertificateVerify],
// ChangeCipherSpec, Finished; then the server's ChangeCipherSpec and Finished.
val TLS_CLIENT12_WAIT_CERTIFICATE = 20
val TLS_CLIENT12_WAIT_KEY_EXCHANGE = 21
val TLS_CLIENT12_WAIT_HELLO_DONE = 22
val TLS_CLIENT12_WAIT_CHANGE_CIPHER_SPEC = 23
val TLS_CLIENT12_WAIT_FINISHED = 24

private fun TlsClient.startV12(message: string, body: string): void {
    val hello = tls12ParseServerHello(body)
    if (!hello.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, hello.error)
        return
    }
    var offered = false
    for (code in this.config.suites12) {
        if (code == hello.suite) offered = true
    }
    val suite = tls12Suite(hello.suite)
    if (!offered || suite == null) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server chose a cipher suite that was not offered")
        return
    }
    // The subset needs the extended master secret and refuses renegotiation: a server without them is refused.
    if (!hello.extendedMasterSecret || !hello.secureRenegotiation) {
        this.fail(TLS_ALERT_HANDSHAKE_FAILURE, "tls: the server does not support the extended master secret")
        return
    }
    this.v12 = true
    this.v12Suite = hello.suite
    this.suite = hello.suite
    this.hash = suite.hash
    this.serverRandom = hello.random
    this.transcript.add(message)
    this.state = TLS_CLIENT12_WAIT_CERTIFICATE
    return
}

private fun TlsClient.queueRecord12(type: int, content: string): void {
    val sealed = tls12Protect(this.v12Write, type, content)
    if (!sealed.ok) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, sealed.error)
        return
    }
    this.outbox = this.outbox + sealed.bytes
    return
}

private fun TlsClient.handleCertificate12(message: string, body: string): void {
    val parsed = tls12ParseCertificate(body)
    if (!parsed.ok || parsed.chain.size == 0) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed or empty Certificate")
        return
    }
    this.chain = parsed.chain
    this.transcript.add(message)
    this.state = TLS_CLIENT12_WAIT_KEY_EXCHANGE
    return
}

private fun TlsClient.handleServerKeyExchange12(message: string, body: string): void {
    val parsed = tls12ParseServerKeyExchange(body)
    if (!parsed.ok) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed ServerKeyExchange")
        return
    }
    var offeredGroup = false
    for (group in tlsClientHelloGroups(this.firstHello)) {
        if (group == parsed.group && (group == TLS_GROUP_X25519 || group == TLS_GROUP_SECP256R1)) offeredGroup = true
    }
    var offeredScheme = false
    for (scheme in this.config.signatureAlgorithms) {
        if (scheme == parsed.scheme) offeredScheme = true
    }
    if (!offeredGroup || !offeredScheme) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: a key exchange group or signature scheme that was not offered")
        return
    }
    val signed = tls12SignedParams(this.helloRandom, this.serverRandom, parsed.params)
    val verdict = this.config.verifier(this.chain, this.config.host, parsed.scheme, signed, parsed.signature)
    if (verdict.size > 0) {
        this.certificateRejected = true
        this.fail(TLS_ALERT_BAD_CERTIFICATE, verdict)
        return
    }
    this.v12Group = parsed.group
    this.v12Point = parsed.point
    this.transcript.add(message)
    this.state = TLS_CLIENT12_WAIT_HELLO_DONE
    return
}

private fun TlsClient.handleHelloDone12(message: string, body: string): void {
    if (body.size != 0) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a ServerHelloDone with a body")
        return
    }
    this.transcript.add(message)
    val suite = tls12Suite(this.v12Suite)
    val pair = tlsGenerateKeyPair(this.v12Group, this.config.random)
    if (suite == null || pair == null) {
        this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the client could not make a key share")
        return
    }
    val shared = tlsAgree(pair, this.v12Point)
    if (!shared.ok) {
        this.fail(TLS_ALERT_ILLEGAL_PARAMETER, "tls: the server's key share is not valid")
        return
    }
    var flight = ""
    // A requested client certificate: its Certificate message, empty when there is no usable identity.
    var scheme = 0
    var identityChain: array<string> = []
    val identity = this.identity
    if (this.requested) {
        if (identity != null && identity.chain.size > 0) {
            for (candidate in identity.schemes) {
                for (accepted in this.requestSchemes) {
                    if (scheme == 0 && candidate == accepted) scheme = candidate
                }
            }
            if (scheme != 0) identityChain = identity.chain
        }
        val certificate = tls12BuildCertificate(identityChain)
        this.transcript.add(certificate)
        flight = flight + certificate
    }
    val keyExchange = tls12BuildClientKeyExchange(pair.publicKey)
    this.transcript.add(keyExchange)
    flight = flight + keyExchange
    // The extended master secret: the session hash is through the ClientKeyExchange.
    val master = tls12MasterSecret(suite.hash, shared.bytes, this.transcript.hash(suite.hash))
    this.masterSecret = master
    if (scheme != 0 && identity != null) {
        val signature = identity.sign(scheme, this.transcript.messages)
        if (signature.size == 0) {
            this.fail(TLS_ALERT_INTERNAL_ERROR, "tls: the client certificate's key could not sign")
            return
        }
        val verify = tlsBuildCertificateVerify(scheme, signature)
        this.transcript.add(verify)
        flight = flight + verify
    }
    val keys = tls12DeriveKeys(suite, master, this.serverRandom, this.helloRandom)
    this.v12Keys = keys
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_HANDSHAKE, 771, flight)
    this.outbox = this.outbox + tlsPlaintextRecord(TLS_CHANGE_CIPHER_SPEC, 771, tlsU8(1))
    this.v12Write = tls12Protection(suite, keys.clientKey, keys.clientIv)
    this.writeEncrypted = true
    val finished = tlsHandshakeMessage(TLS_FINISHED,
        tls12FinishedData(suite.hash, master, "client finished", this.transcript.hash(suite.hash)))
    this.queueRecord12(TLS_HANDSHAKE, finished)
    this.transcript.add(finished)
    this.state = TLS_CLIENT12_WAIT_CHANGE_CIPHER_SPEC
    return
}

private fun TlsClient.handleFinished12(message: string, body: string): void {
    if (body.size != 12) {
        this.fail(TLS_ALERT_DECODE_ERROR, "tls: a Finished of the wrong length")
        return
    }
    val expected = tls12FinishedData(this.hash, this.masterSecret, "server finished", this.transcript.hash(this.hash))
    if (!constantTimeEquals(expected, body)) {
        this.fail(TLS_ALERT_DECRYPT_ERROR, "tls: the server's Finished does not verify")
        return
    }
    if (this.handshakeBuffer.size != 0) {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: data after the server's Finished in its record")
        return
    }
    this.transcript.add(message)
    this.state = TLS_CLIENT_CONNECTED
    return
}

private fun TlsClient.handleMessage12(type: int, message: string, body: string): void {
    if (this.state == TLS_CLIENT12_WAIT_CERTIFICATE) {
        if (type == TLS_CERTIFICATE) this.handleCertificate12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Certificate")
    } else if (this.state == TLS_CLIENT12_WAIT_KEY_EXCHANGE) {
        if (type == TLS12_SERVER_KEY_EXCHANGE) this.handleServerKeyExchange12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a ServerKeyExchange")
    } else if (this.state == TLS_CLIENT12_WAIT_HELLO_DONE) {
        if (type == TLS_CERTIFICATE_REQUEST && !this.requested) {
            val schemes = tls12ParseCertificateRequest(body.slice(0, body.size))
            if (schemes.size == 0) {
                this.fail(TLS_ALERT_DECODE_ERROR, "tls: a malformed CertificateRequest")
                return
            }
            this.requested = true
            this.requestSchemes = schemes
            this.transcript.add(message)
        } else if (type == TLS12_SERVER_HELLO_DONE) this.handleHelloDone12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a ServerHelloDone")
    } else if (this.state == TLS_CLIENT12_WAIT_FINISHED) {
        if (type == TLS_FINISHED) this.handleFinished12(message, body)
        else this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: expected a Finished")
    } else {
        // Anything else, including a HelloRequest (renegotiation, which the subset refuses).
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected handshake message")
    }
    return
}

private fun TlsClient.processHandshake12(): void {
    while (this.state != TLS_CLIENT_FAILED && this.state != TLS_CLIENT_CLOSED) {
        val header = tlsParseMessageHeader(this.handshakeBuffer, 0)
        if (!header.complete) return
        val message = this.handshakeBuffer.slice(0, header.total)
        this.handshakeBuffer = this.handshakeBuffer.slice(header.total, this.handshakeBuffer.size)
        this.handleMessage12(header.type, message, message.slice(4, message.size))
    }
    return
}

private fun TlsClient.handleRecord12(record: string, header: TlsRecordHeader): void {
    if (header.type == TLS_CHANGE_CIPHER_SPEC) {
        if (this.state != TLS_CLIENT12_WAIT_CHANGE_CIPHER_SPEC || record.size != 6 || record[5] != 1) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected ChangeCipherSpec")
            return
        }
        if (this.handshakeBuffer.size != 0) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: handshake data before the ChangeCipherSpec")
            return
        }
        val suite = tls12Suite(this.v12Suite) ?? return
        this.v12Read = tls12Protection(suite, this.v12Keys.serverKey, this.v12Keys.serverIv)
        this.readEncrypted = true
        this.state = TLS_CLIENT12_WAIT_FINISHED
        return
    }
    var type = header.type
    var content = ""
    if (this.readEncrypted) {
        val opened = tls12Open(this.v12Read, record)
        if (!opened.ok) {
            this.fail(if (opened.error == "tls: record overflow") TLS_ALERT_RECORD_OVERFLOW else TLS_ALERT_BAD_RECORD_MAC,
                opened.error)
            return
        }
        type = opened.type
        content = opened.content
    } else {
        if (header.length > TLS_MAX_PLAINTEXT) {
            this.fail(TLS_ALERT_RECORD_OVERFLOW, "tls: record overflow")
            return
        }
        content = record.slice(5, record.size)
    }
    if (type == TLS_HANDSHAKE) {
        if (content.size == 0) {
            this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an empty handshake record")
            return
        }
        this.handshakeBuffer = this.handshakeBuffer + content
        this.processHandshake12()
    } else if (type == TLS_ALERT) {
        this.handleAlert(content)
    } else if (type == TLS_APPLICATION_DATA && this.readEncrypted && this.state == TLS_CLIENT_CONNECTED) {
        this.applicationData = this.applicationData + content
    } else {
        this.fail(TLS_ALERT_UNEXPECTED_MESSAGE, "tls: an unexpected record type $type")
    }
    return
}

private fun TlsClient.send12(data: string): bool {
    var offset = 0
    while (offset < data.size && this.state == TLS_CLIENT_CONNECTED) {
        val end = if (data.size - offset > TLS12_MAX_PLAINTEXT) offset + TLS12_MAX_PLAINTEXT else data.size
        this.queueRecord12(TLS_APPLICATION_DATA, data.slice(offset, end))
        offset = end
    }
    this.state == TLS_CLIENT_CONNECTED
}
