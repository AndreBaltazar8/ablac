// public: abla/tls/hosted, abla/tls/pure
// Narrow OpenSSL ABI used by the all-Abla hosted TLS adapter. These are
// platform-library declarations, not a project runtime shim. The build driver
// links OpenSSL only when this module survives import resolution.

/// Returns the numeric version of the loaded OpenSSL library.
trusted noescape extern:"c" fun OpenSSL_version_num(): int

/// Returns the version-negotiating TLS client method.
trusted noescape extern:"c" fun TLS_client_method(): i64*
/// Returns the version-negotiating TLS server method.
trusted noescape extern:"c" fun TLS_server_method(): i64*

/// Creates a context for the TLS method, returning a null pointer on failure.
trusted noescape extern:"c" fun SSL_CTX_new(method: i64*): i64*
/// Releases a reference to the TLS context.
trusted noescape extern:"c" fun SSL_CTX_free(context: i64*): void
/// Loads the default trust locations, returning one on success and zero on failure.
trusted noescape extern:"c" fun SSL_CTX_set_default_verify_paths(
    context: i64*
): i32
/// Loads CA certificates from the given file or directory, returning one on success.
trusted noescape extern:"c" fun SSL_CTX_load_verify_locations(
    context: i64*, certificateFile: cstring, certificateDirectory: i64*
): i32
/// Loads the server certificate and chain from a PEM file and returns one on success.
trusted noescape extern:"c" fun SSL_CTX_use_certificate_chain_file(
    context: i64*, certificateFile: cstring
): i32
/// Loads a key from a file of the given type and returns one on success.
trusted noescape extern:"c" fun SSL_CTX_use_PrivateKey_file(
    context: i64*, privateKeyFile: cstring, fileType: int
): i32
/// Returns one when the context's key matches its certificate and zero on failure.
trusted noescape extern:"c" fun SSL_CTX_check_private_key(
    context: i64*
): i32
/// Sets the peer verification mode and optional verification callback.
trusted noescape extern:"c" fun SSL_CTX_set_verify(
    context: i64*, mode: int, callback: i64*
): void

/// Creates a TLS session from the context, returning a null pointer on failure.
trusted noescape extern:"c" fun SSL_new(context: i64*): i64*
/// Releases a reference to the TLS session and frees its resources when the last reference is dropped.
trusted noescape extern:"c" fun SSL_free(session: i64*): void
/// Applies a command to the TLS session and returns the command-specific result.
trusted noescape extern:"c" fun SSL_ctrl(
    session: i64*, command: int, argument: int, pointer: cstring
): int
/// Sets the expected peer hostname for certificate verification and returns one on success.
trusted noescape extern:"c" fun SSL_set1_host(
    session: i64*, host: cstring
): i32
/// Associates the session with the socket descriptor and returns one on success.
trusted noescape extern:"c" fun SSL_set_fd(
    session: i64*, descriptor: int
): i32
/// Advances the client handshake, returning one when complete and a status for SSL_get_error otherwise.
trusted noescape extern:"c" fun SSL_connect(session: i64*): i32
/// Advances the server handshake, returning one when complete and a status for SSL_get_error otherwise.
trusted noescape extern:"c" fun SSL_accept(session: i64*): i32
/// Reads decrypted bytes and returns the byte count, or a nonpositive status to inspect with SSL_get_error.
trusted noescape extern:"c" fun SSL_read(
    session: i64*, destination: i64*, maximum: int
): i32
/// Writes plaintext through TLS and returns the byte count, or a nonpositive status to inspect with SSL_get_error.
trusted noescape extern:"c" fun SSL_write(
    session: i64*, source: cstring, length: int
): i32
/// Returns one on complete shutdown, zero while awaiting the peer close notification, or a negative status on failure or retry.
trusted noescape extern:"c" fun SSL_shutdown(session: i64*): i32
/// Returns the peer certificate verification status, with zero representing X509_V_OK.
trusted noescape extern:"c" fun SSL_get_verify_result(session: i64*): int
/// Classifies the status from the preceding TLS I/O operation, including retry and closure.
trusted noescape extern:"c" fun SSL_get_error(session: i64*, result: i32): i32

/// Applies a command to the TLS context and returns the command-specific result.
trusted noescape extern:"c" fun SSL_CTX_ctrl(
    context: i64*, command: int, argument: int, pointer: i64*
): int
/// Installs a certificate in the context and returns one on success.
trusted noescape extern:"c" fun SSL_CTX_use_certificate(
    context: i64*, certificate: i64*
): i32
/// Installs a private key in the context and returns one on success.
trusted noescape extern:"c" fun SSL_CTX_use_PrivateKey(
    context: i64*, key: i64*
): i32
