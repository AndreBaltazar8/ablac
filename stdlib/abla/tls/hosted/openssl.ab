// Narrow OpenSSL ABI used by the all-Abla hosted TLS adapter. These are
// platform-library declarations, not a project runtime shim. The build driver
// links OpenSSL only when this module survives import resolution.

trusted noescape extern:"c" fun OpenSSL_version_num(): int

trusted noescape extern:"c" fun TLS_client_method(): i64*
trusted noescape extern:"c" fun TLS_server_method(): i64*

trusted noescape extern:"c" fun SSL_CTX_new(method: i64*): i64*
trusted noescape extern:"c" fun SSL_CTX_free(context: i64*): void
trusted noescape extern:"c" fun SSL_CTX_set_default_verify_paths(
    context: i64*
): i32
trusted noescape extern:"c" fun SSL_CTX_load_verify_locations(
    context: i64*, certificateFile: cstring, certificateDirectory: i64*
): i32
trusted noescape extern:"c" fun SSL_CTX_use_certificate_chain_file(
    context: i64*, certificateFile: cstring
): i32
trusted noescape extern:"c" fun SSL_CTX_use_PrivateKey_file(
    context: i64*, privateKeyFile: cstring, fileType: int
): i32
trusted noescape extern:"c" fun SSL_CTX_check_private_key(
    context: i64*
): i32
trusted noescape extern:"c" fun SSL_CTX_set_verify(
    context: i64*, mode: int, callback: i64*
): void

trusted noescape extern:"c" fun SSL_new(context: i64*): i64*
trusted noescape extern:"c" fun SSL_free(session: i64*): void
trusted noescape extern:"c" fun SSL_ctrl(
    session: i64*, command: int, argument: int, pointer: cstring
): int
trusted noescape extern:"c" fun SSL_set1_host(
    session: i64*, host: cstring
): i32
trusted noescape extern:"c" fun SSL_set_fd(
    session: i64*, descriptor: int
): i32
trusted noescape extern:"c" fun SSL_connect(session: i64*): i32
trusted noescape extern:"c" fun SSL_accept(session: i64*): i32
trusted noescape extern:"c" fun SSL_read(
    session: i64*, destination: i64*, maximum: int
): i32
trusted noescape extern:"c" fun SSL_write(
    session: i64*, source: cstring, length: int
): i32
trusted noescape extern:"c" fun SSL_shutdown(session: i64*): i32
trusted noescape extern:"c" fun SSL_get_verify_result(session: i64*): int
