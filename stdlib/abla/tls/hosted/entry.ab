// Certificate-verified hosted TLS client. The host adapter dynamically loads
// OpenSSL 1.1+/3 so importing the module is optional and ordinary/raw programs
// do not acquire a TLS dependency.

import "abla/platform/host"

resource class TlsConnection(var handle: int) {
    fun drop(): void {
        if (this.handle >= 0) ablaHostTlsClose(this.handle)
        this.handle = -1
        return
    }
}

resource class TlsListener(var handle: int) {
    fun drop(): void {
        if (this.handle >= 0) ablaHostTlsListenerClose(this.handle)
        this.handle = -1
        return
    }
}

fun tlsAvailable(): bool = ablaHostTlsAvailable()

fun tlsLastError(): string = ablaHostTlsError()

fun tlsConnect(
    host: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000
): TlsConnection = TlsConnection(
    ablaHostTlsOpen(host, port, timeoutMilliseconds)
)

fun tlsConnectWithCa(
    host: string,
    caPath: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000
): TlsConnection = TlsConnection(
    ablaHostTlsOpenWithCa(host, port, timeoutMilliseconds, caPath)
)

fun tlsListen(
    certificatePath: string,
    privateKeyPath: string,
    host: string = "::",
    port: int = 443,
    backlog: int = 128,
    dualStack: bool = true
): TlsListener = TlsListener(ablaHostTlsListen(
    host,
    port,
    backlog,
    dualStack,
    certificatePath,
    privateKeyPath
))

fun TlsListener.localPort(): int =
    if (this.handle >= 0) ablaHostTlsListenerPort(this.handle) else -1

// The listener owns the shared certificate context and must outlive accepted
// connections.
fun TlsListener.accept(): TlsConnection = TlsConnection(
    if (this.handle >= 0) ablaHostTlsAccept(this.handle) else -1
)

fun TlsConnection.read(maximum: int = 65536): string =
    if (this.handle >= 0) ablaHostTlsRead(this.handle, maximum) else ""

fun TlsConnection.write(contents: string): int =
    if (this.handle >= 0) ablaHostTlsWrite(this.handle, contents) else -1

fun TlsConnection.close(): bool {
    var closed = this.handle < 0
    if (this.handle >= 0) {
        closed = ablaHostTlsClose(this.handle)
        this.handle = -1
    }
    closed
}

fun TlsListener.close(): bool {
    var closed = this.handle < 0
    if (this.handle >= 0) {
        closed = ablaHostTlsListenerClose(this.handle)
        this.handle = -1
    }
    closed
}
