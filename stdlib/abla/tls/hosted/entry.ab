// Certificate-verified TLS implemented in Abla over the raw Linux networking
// package. OpenSSL is a platform-library boundary, like libc and pthreads; no
// C runtime source or host-value adapter participates in this path.

import "openssl.ab"
import "../../jwt/libcrypto.ab"
import "../../crypto/hosted/libcrypto.ab"
import "../../crypto/hosted/pkcs12.ab"
import "abla/dns"
import "abla/sys/linux/net"
import "abla/sys/linux/process"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// The calling thread's last error, as a code in thread-local storage (like
// errno: each thread has its own, so threads starting connections at once
// don't share it); tlsLastError reads it as text.
@inline
trusted fun hostedTlsErrorSlot(): i64* =
    nativePointerFromAddress(
        nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00")
    )

trusted fun hostedTlsSetError(code: int): void {
    ablaUnsafeStoreI64(hostedTlsErrorSlot(), code)
    return
}

private val hostedTlsListenerFailed = 11
private val hostedTlsServerHandshakeFailed = 12
private val hostedTlsTimedOut = 13

// How long one read or write of an open connection may wait, unless the
// connection is told otherwise. Connecting and the handshake have their own,
// shorter limit; a protocol may reasonably wait this long for its peer's reply.
private val tlsDefaultReadWriteTimeoutMilliseconds = 30000

// A failed stage of a client connection, as its error code.
private fun hostedTlsStageCode(stage: string): int = when (stage) {
    "tcp_connect" -> 2
    "context_create" -> 3
    "trust_store" -> 4
    "session_create" -> 5
    "server_name" -> 6
    "host_verification_setup" -> 7
    "socket_attach" -> 8
    "handshake" -> 9
    "certificate_verification" -> 10
    "client_identity" -> 14
    else -> 1
}

private fun hostedTlsErrorText(code: int): string = when (code) {
    0 -> ""
    1 -> "TLS failed at configuration"
    2 -> "TLS failed at tcp_connect"
    3 -> "TLS failed at context_create"
    4 -> "TLS failed at trust_store"
    5 -> "TLS failed at session_create"
    6 -> "TLS failed at server_name"
    7 -> "TLS failed at host_verification_setup"
    8 -> "TLS failed at socket_attach"
    9 -> "TLS failed at handshake"
    10 -> "TLS failed at certificate_verification"
    11 -> "TLS certificate, private key, or listener failed"
    12 -> "TLS server handshake failed"
    13 -> "TLS read or write timed out"
    14 -> "TLS failed at client_identity: no usable client certificate and key"
    else -> "TLS failed"
}

// Connection control: context pointer, SSL pointer, descriptor, owns-context.
// Listener control: context pointer, descriptor.
trusted fun tlsAllocateConnection(
    context: i64*,
    session: i64*,
    descriptor: int,
    ownsContext: bool
): int {
    val control = ablaUnsafeAllocate(32)
    ablaUnsafeStorePointer(control, context)
    ablaUnsafeStorePointer(ablaUnsafePointerOffset(control, 8), session)
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(control, 16), descriptor)
    ablaUnsafeStoreI64(
        ablaUnsafePointerOffset(control, 24), if (ownsContext) 1 else 0
    )
    nativePointerAddress(control)
}

trusted fun tlsAllocateListener(context: i64*, descriptor: int): int {
    val control = ablaUnsafeAllocate(16)
    ablaUnsafeStorePointer(control, context)
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(control, 8), descriptor)
    nativePointerAddress(control)
}

trusted fun tlsControl(handle: int): i64* = nativePointerFromAddress(handle)

trusted fun tlsControlPointer(handle: int, offset: int): i64* =
    ablaUnsafeLoadPointer(ablaUnsafePointerOffset(tlsControl(handle), offset))

trusted fun tlsControlInt(handle: int, offset: int): int =
    ablaUnsafeLoadI64(ablaUnsafePointerOffset(tlsControl(handle), offset))

resource class TlsConnection(var handle: int) {
    fun drop(): void {
        if (this.handle >= 0) tlsCloseHandle(this.handle)
        this.handle = -1
        return
    }
}

resource class TlsListener(var handle: int) {
    fun drop(): void {
        if (this.handle >= 0) tlsCloseListenerHandle(this.handle)
        this.handle = -1
        return
    }
}

trusted fun tlsAvailable(): bool = OpenSSL_version_num() > 0

trusted fun tlsLastError(): string =
    hostedTlsErrorText(ablaUnsafeLoadI64(hostedTlsErrorSlot()))

// The raw connector deliberately bounds its nonblocking connection phase to
// ten seconds. HTTPS callers may use a larger overall exchange timeout; keep
// that valid input from being rejected before a socket is opened.
private fun tlsTcpConnectTimeout(timeoutMilliseconds: int): int =
    if (timeoutMilliseconds > 10000) 10000 else timeoutMilliseconds

// A client certificate, its chain and its private key, for mutual TLS: held by
// OpenSSL and freed when dropped. Check error first, or ok().
resource class TlsClientIdentity(
    val certificate: int,
    val key: int,
    val chain: array<int>,
    val error: string
) {
    trusted fun drop(): void {
        if (this.certificate != 0) X509_free(nativePointerFromAddress(this.certificate))
        if (this.key != 0) EVP_PKEY_free(nativePointerFromAddress(this.key))
        var index = 0
        while (index < this.chain.size) {
            X509_free(nativePointerFromAddress(this.chain[index]))
            index = index + 1
        }
        return
    }
    fun ok(): bool = this.certificate != 0 && this.key != 0
}

// Takes ownership of what it's given. Refuses a key that isn't the certificate's.
private trusted fun tlsIdentityFrom(
    certificate: int, key: int, chain: array<int>, error: string
): TlsClientIdentity {
    var problem = error
    if (problem == "" && (certificate == 0 || key == 0)) {
        problem = "the client identity needs a certificate and its private key"
    }
    if (problem == "" && X509_check_private_key(
        nativePointerFromAddress(certificate), nativePointerFromAddress(key)
    ) != i32(1)) {
        problem = "the private key isn't the client certificate's"
    }
    ERR_clear_error()
    if (problem == "") return TlsClientIdentity(certificate, key, chain, "")
    if (certificate != 0) X509_free(nativePointerFromAddress(certificate))
    if (key != 0) EVP_PKEY_free(nativePointerFromAddress(key))
    var index = 0
    while (index < chain.size) {
        X509_free(nativePointerFromAddress(chain[index]))
        index = index + 1
    }
    TlsClientIdentity(0, 0, [], problem)
}

// From PEM text: the certificate first and then any intermediates, and its key,
// PKCS#8 or PKCS#1, encrypted with `passphrase` if it is. A key that needs one fails
// without it; it never asks on the terminal.
trusted fun tlsClientIdentityFromPem(
    certificatePem: string, keyPem: string, passphrase: string = ""
): TlsClientIdentity {
    val chain: array<int> = []
    if (certificatePem.size == 0 || keyPem.size == 0 || cryptoHasNul(passphrase)) {
        return tlsIdentityFrom(0, 0, chain,
            "the client identity needs a certificate and its private key")
    }
    val none = nativeNullPointer()
    val certificates = BIO_new_mem_buf(
        nativePointerFromAddress(nativeStringAddress(certificatePem)), certificatePem.size
    )
    var certificate = 0
    if (!pointerIsNull(certificates)) {
        certificate = nativePointerAddress(PEM_read_bio_X509(certificates, none, none, none))
        var reading = certificate != 0
        while (reading) {
            val next = nativePointerAddress(PEM_read_bio_X509(certificates, none, none, none))
            if (next == 0) reading = false
            else chain.append(next)
        }
        BIO_free(certificates)
    }
    var key = 0
    val keys = BIO_new_mem_buf(
        nativePointerFromAddress(nativeStringAddress(keyPem)), keyPem.size
    )
    if (!pointerIsNull(keys)) {
        // With no callback, OpenSSL takes the last argument as the passphrase itself.
        key = nativePointerAddress(PEM_read_bio_PrivateKey(
            keys, none, none, nativePointerFromAddress(nativeCStringAddress(passphrase))
        ))
        BIO_free(keys)
    }
    ERR_clear_error()
    tlsIdentityFrom(
        certificate, key, chain,
        if (certificate == 0) "not a readable certificate in PEM"
        else if (key == 0) "not a readable private key in PEM, or a wrong passphrase"
        else ""
    )
}

// From a PKCS#12 (.pfx) container, which is how AT's manuals have a certificate
// and its key joined.
trusted fun tlsClientIdentityFromPkcs12(der: string, password: string): TlsClientIdentity {
    val parts = cryptoPkcs12Open(der, password)
    tlsIdentityFrom(parts.certificate, parts.key, parts.chain, parts.error)
}

// Adds the identity to a new context. OpenSSL counts its own references.
private trusted fun tlsContextUseIdentity(
    context: i64*, certificate: int, key: int, chain: array<int>
): bool {
    if (SSL_CTX_use_certificate(context, nativePointerFromAddress(certificate)) != i32(1) ||
        SSL_CTX_use_PrivateKey(context, nativePointerFromAddress(key)) != i32(1) ||
        SSL_CTX_check_private_key(context) != i32(1)) {
        ERR_clear_error()
        return false
    }
    var index = 0
    while (index < chain.size) {
        // SSL_CTX_add1_chain_cert takes a reference of its own.
        if (SSL_CTX_ctrl(context, 89, 1, nativePointerFromAddress(chain[index])) != 1) {
            ERR_clear_error()
            return false
        }
        index = index + 1
    }
    true
}

// A nonzero deadline is an absolute monotonic millisecond time shared by
// the caller's connect, handshake, and subsequent protocol exchange.
private fun hostedTlsDeadlineWait(deadline: int, timeout: int): int {
    if (deadline == 0) return timeout
    val left = deadline - linuxMonotonicMilliseconds()
    if (left <= 0) 0 else if (timeout < left) timeout else left
}

trusted fun tlsOpen(
    host: string,
    caPath: string,
    port: int,
    timeoutMilliseconds: int,
    readWriteTimeoutMilliseconds: int = 30000,
    identityCertificate: int = 0,
    identityKey: int = 0,
    identityChain: array<int> = [],
    deadline: int = 0
): int {
    var handle = -1
    var stage = "configuration"
    var connection = TcpConnection(-1)
    var context = nativeNullPointer()
    var session = nativeNullPointer()
    var ready = port > 0 && port <= 65535 &&
        timeoutMilliseconds > 0 && timeoutMilliseconds <= 600000 &&
        tlsAvailable()
    if (ready) {
        stage = "tcp_connect"
        val connectTimeout = hostedTlsDeadlineWait(
            deadline, tlsTcpConnectTimeout(timeoutMilliseconds)
        )
        // Local development certificates conventionally identify
        // `localhost`; avoid a DNS round-trip and preserve the listener's
        // IPv6 loopback choice while still verifying the original host name.
        if (connectTimeout > 0) connection = if (host == "localhost") tcpConnectIpv6(
            ipv6Loopback(port), connectTimeout
        ) else tcpConnectHost(host, port, connectTimeout, deadline)
        ready = connection.descriptor >= 0
    }
    if (!ready) { hostedTlsSetError(hostedTlsStageCode(stage)); return -1 }
    tlsUpgradeHandle(
        connection, host, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds,
        identityCertificate, identityKey, identityChain, deadline
    )
}

// Takes ownership of an established TCP socket, including on failure.
// Certificate-chain and hostname verification are identical to tlsConnect.
// A socket that already has timeouts keeps them, through the handshake and after.
trusted fun tlsUpgradeHandle(
    var connection: TcpConnection,
    host: string,
    caPath: string,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000,
    identityCertificate: int = 0,
    identityKey: int = 0,
    identityChain: array<int> = [],
    deadline: int = 0
): int {
    var handle = -1
    var stage = "configuration"
    var context = nativeNullPointer()
    var session = nativeNullPointer()
    var ready = connection.descriptor >= 0 && host.size > 0 && tlsAvailable()
    if (ready) {
        stage = "context_create"
        context = SSL_CTX_new(TLS_client_method())
        ready = !pointerIsNull(context)
    }
    if (ready) {
        stage = "trust_store"
        SSL_CTX_set_verify(context, 1, nativeNullPointer())
        val trustLoaded = if (caPath != "")
            SSL_CTX_load_verify_locations(
                context, caPath, nativeNullPointer()
            ) == 1
        else SSL_CTX_set_default_verify_paths(context) == 1
        ready = trustLoaded
    }
    if (ready && identityCertificate != 0) {
        stage = "client_identity"
        ready = tlsContextUseIdentity(
            context, identityCertificate, identityKey, identityChain
        )
    }
    if (ready) {
        stage = "session_create"
        session = SSL_new(context)
        ready = !pointerIsNull(session)
    }
    if (ready) {
        stage = "server_name"
        ready = SSL_ctrl(session, 55, 0, host) == 1
    }
    if (ready) {
        stage = "host_verification_setup"
        ready = SSL_set1_host(session, host) == 1
    }
    if (ready) {
        stage = "socket_attach"
        ready = SSL_set_fd(session, connection.descriptor) == 1
    }
    val configured = ready && linuxSocketHasTimeouts(connection.descriptor)
    if (ready) {
        stage = "handshake"
        if (!configured) linuxSocketSetTimeouts(
            connection.descriptor, timeoutMilliseconds, timeoutMilliseconds
        )
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        if (deadline == 0) {
            val wait = HostedTlsWait(connection.descriptor)
            var shook = SSL_connect(session)
            while (shook != 1 && hostedTlsInterrupted(wait, session, int(shook))) {
                shook = SSL_connect(session)
            }
            hostedTlsWaitDone(wait)
            ready = shook == 1
        } else {
            // Nonblocking TLS lets the absolute budget bound the entire handshake,
            // including peers which send a partial record before each timeout.
            ready = linuxSocketSetNonblocking(connection.descriptor, true)
            var done = false
            while (ready && !done) {
                val remaining = hostedTlsDeadlineWait(deadline, timeoutMilliseconds)
                if (remaining <= 0) ready = false
                else {
                    val result = SSL_connect(session)
                    if (result == 1) done = true
                    else {
                        val error = SSL_get_error(session, result)
                        if (error != 2 && error != 3) ready = false
                        else {
                            val wait = hostedTlsDeadlineWait(deadline, timeoutMilliseconds)
                            if (wait <= 0) ready = false
                            else {
                                val polled = linuxPollSocket(connection.descriptor,
                                    error == 2, error == 3, wait)
                                if (polled.timedOut || polled.failed() ||
                                    (polled.closed && !polled.readable && !polled.writable)) ready =
                                    false
                            }
                        }
                    }
                }
            }
            if (!linuxSocketSetNonblocking(connection.descriptor, false)) ready = false
        }
        linuxBrokenPipeRelease(held)
    }
    if (ready) {
        stage = "certificate_verification"
        ready = SSL_get_verify_result(session) == 0
    }
    if (ready) {
        if (!configured) linuxSocketSetTimeouts(
            connection.descriptor,
            readWriteTimeoutMilliseconds,
            readWriteTimeoutMilliseconds
        )
        handle = tlsAllocateConnection(
            context, session, connection.descriptor, true
        )
        connection.descriptor = -1
        hostedTlsSetError(0)
    } else {
        if (!pointerIsNull(session)) SSL_free(session)
        if (!pointerIsNull(context)) SSL_CTX_free(context)
        hostedTlsSetError(hostedTlsStageCode(stage))
        connection.close()
    }
    handle
}

fun tlsUpgrade(
    var connection: TcpConnection,
    host: string,
    caPath: string = "",
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection = TlsConnection(tlsUpgradeHandle(
    connection, host, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds
))

// Unix streams use exactly the TCP upgrade's descriptor-based TLS path. Move
// ownership into the view before delegation, so failure also closes only once.
trusted fun tlsUpgradeHandle(
    var connection: UnixConnection, host: string, caPath: string,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000,
    identityCertificate: int = 0, identityKey: int = 0,
    identityChain: array<int> = [], deadline: int = 0
): int {
    var stream = TcpConnection(connection.descriptor)
    connection.descriptor = -1
    tlsUpgradeHandle(stream, host, caPath, timeoutMilliseconds,
        readWriteTimeoutMilliseconds, identityCertificate, identityKey, identityChain, deadline)
}

// host identifies the certificate/SNI, not the Unix socket pathname.
fun tlsUpgrade(var connection: UnixConnection, host: string, caPath: string = "",
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection = TlsConnection(tlsUpgradeHandle(connection, host, caPath,
    timeoutMilliseconds, readWriteTimeoutMilliseconds))

trusted fun tlsUpgradeWithIdentity(var connection: TcpConnection, host: string,
    identity: TlsClientIdentity, caPath: string = "", timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0
): TlsConnection {
    if (!identity.ok()) {
        connection.close()
        hostedTlsSetError(14)
        return TlsConnection(-1)
    }
    TlsConnection(tlsUpgradeHandle(connection, host, caPath, timeoutMilliseconds,
        readWriteTimeoutMilliseconds, identity.certificate, identity.key, identity.chain, deadline))
}

trusted fun tlsUpgradeWithIdentity(var connection: UnixConnection, host: string,
    identity: TlsClientIdentity, caPath: string = "", timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0
): TlsConnection {
    var stream = TcpConnection(connection.descriptor)
    connection.descriptor = -1
    tlsUpgradeWithIdentity(stream, host, identity, caPath, timeoutMilliseconds,
        readWriteTimeoutMilliseconds, deadline)
}

fun tlsConnect(
    host: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0
): TlsConnection = TlsConnection(
    tlsOpen(host, "", port, timeoutMilliseconds, readWriteTimeoutMilliseconds,
        deadline = deadline)
)

fun tlsConnectWithCa(
    host: string,
    caPath: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection = TlsConnection(
    tlsOpen(host, caPath, port, timeoutMilliseconds, readWriteTimeoutMilliseconds)
)

// Mutual TLS: as tlsConnect, presenting the identity, and trusting the CA file at
// caPath if it isn't "". Under TLS 1.3 a server's refusal of the client certificate
// arrives after the handshake, so it shows as a failing first read, not as a failed
// connect. The identity may be dropped once this returns.
trusted fun tlsConnectWithIdentity(
    host: string,
    identity: TlsClientIdentity,
    caPath: string = "",
    port: int = 443,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0
): TlsConnection {
    if (!identity.ok()) {
        hostedTlsSetError(14)
        return TlsConnection(-1)
    }
    TlsConnection(tlsOpen(
        host, caPath, port, timeoutMilliseconds, readWriteTimeoutMilliseconds,
        identity.certificate, identity.key, identity.chain, deadline
    ))
}

// Replaces the limits on one read and one write; 0 waits as long as it takes.
// A read that times out returns "" and can be repeated (tlsLastError tells it
// from a closed connection). A write that times out leaves the connection unusable.
trusted fun TlsConnection.setTimeouts(
    readMilliseconds: int,
    writeMilliseconds: int
): bool = this.handle >= 0 && linuxSocketSetTimeouts(
    tlsControlInt(this.handle, 16), readMilliseconds, writeMilliseconds
)

// A server context owns the loaded certificate and key. On failure no context
// escapes; callers keep their existing error reporting and socket ownership.
private trusted fun hostedTlsServerContext(certificatePath: string, privateKeyPath: string): i64* {
    var context = SSL_CTX_new(TLS_server_method())
    var ready = !pointerIsNull(context)
    if (ready) ready = SSL_CTX_use_certificate_chain_file(context, certificatePath) == 1
    if (ready) ready = SSL_CTX_use_PrivateKey_file(context, privateKeyPath, 1) == 1
    if (ready) ready = SSL_CTX_check_private_key(context) == 1
    if (!ready && !pointerIsNull(context)) {
        SSL_CTX_free(context)
        context = nativeNullPointer()
    }
    context
}

// Loads the certificate/key on each call. For many connections, tlsListen
// reuses a server context. This operation consumes the stream even on failure.
trusted fun tlsServerUpgrade(var connection: TcpConnection,
    certificatePath: string, privateKeyPath: string,
    handshakeTimeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0
): TlsConnection {
    if (connection.descriptor < 0 || handshakeTimeoutMilliseconds <= 0 ||
        handshakeTimeoutMilliseconds > 600000 || !tlsAvailable()) {
        connection.close()
        hostedTlsSetError(hostedTlsListenerFailed)
        return TlsConnection(-1)
    }
    val context = hostedTlsServerContext(certificatePath, privateKeyPath)
    if (pointerIsNull(context)) {
        connection.close()
        hostedTlsSetError(hostedTlsListenerFailed)
        return TlsConnection(-1)
    }
    val descriptor = connection.descriptor
    connection.descriptor = -1
    val handle = hostedTlsServerAccept(context, descriptor,
        handshakeTimeoutMilliseconds, readWriteTimeoutMilliseconds, deadline, true, true)
    if (handle >= 0) hostedTlsSetError(0)
    TlsConnection(handle)
}

trusted fun tlsServerUpgrade(var connection: UnixConnection,
    certificatePath: string, privateKeyPath: string,
    handshakeTimeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds,
    deadline: int = 0
): TlsConnection {
    var stream = TcpConnection(connection.descriptor)
    connection.descriptor = -1
    tlsServerUpgrade(stream, certificatePath, privateKeyPath, handshakeTimeoutMilliseconds,
        readWriteTimeoutMilliseconds, deadline)
}

trusted fun tlsListenHandle(
    certificatePath: string,
    privateKeyPath: string,
    host: string,
    port: int,
    backlog: int,
    dualStack: bool
): int {
    var handle = -1
    var context = nativeNullPointer()
    var listener = TcpListener(-1)
    var ready = port >= 0 && port <= 65535 && backlog > 0 &&
        backlog <= 4096 && tlsAvailable()
    if (ready) {
        context = hostedTlsServerContext(certificatePath, privateKeyPath)
        ready = !pointerIsNull(context)
    }
    if (ready) {
        listener = if (linuxIpv6Words(host).size == 8)
            tcpListenIpv6(ipv6SocketAddress(host, port), backlog, dualStack)
        else tcpListenAddress(ipv4SocketAddress(host, port), backlog)
        ready = listener.descriptor >= 0
    }
    if (ready) {
        handle = tlsAllocateListener(context, listener.descriptor)
        listener.descriptor = -1
        hostedTlsSetError(0)
    } else {
        if (!pointerIsNull(context)) SSL_CTX_free(context)
        hostedTlsSetError(hostedTlsListenerFailed)
    }
    handle
}

fun tlsListen(
    certificatePath: string,
    privateKeyPath: string,
    host: string = "::",
    port: int = 443,
    backlog: int = 128,
    dualStack: bool = true
): TlsListener = TlsListener(tlsListenHandle(
    certificatePath, privateKeyPath, host, port, backlog, dualStack
))

trusted fun TlsListener.localPort(): int = if (this.handle >= 0) {
    var listener = TcpListener(tlsControlInt(this.handle, 8))
    val port = listener.localPort()
    listener.descriptor = -1
    port
} else -1

// A client that connects and says nothing costs one handshake timeout, so it
// can't hold up the clients behind it.
trusted fun TlsListener.accept(
    handshakeTimeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection {
    var handle = -1
    if (this.handle >= 0) {
        val context = tlsControlPointer(this.handle, 0)
        val descriptor = linuxTcpAcceptDescriptor(
            tlsControlInt(this.handle, 8)
        )
        handle = hostedTlsServerAccept(context, descriptor,
            handshakeTimeoutMilliseconds, readWriteTimeoutMilliseconds)
    }
    TlsConnection(handle)
}

// Both the listener and accepted-stream APIs use this one handshake path.
private trusted fun hostedTlsServerAccept(context: i64*, descriptor: int,
    handshakeTimeoutMilliseconds: int, readWriteTimeoutMilliseconds: int,
    deadline: int = 0, ownsContext: bool = false, preserveTimeouts: bool = false): int {
    var handle = -1
    var session = nativeNullPointer()
    var ready = descriptor >= 0
    if (ready) {
        session = SSL_new(context)
        ready = !pointerIsNull(session)
    }
    if (ready) ready = SSL_set_fd(session, descriptor) == 1
    val configured = ready && preserveTimeouts && linuxSocketHasTimeouts(descriptor)
    if (ready) {
        if (!configured) linuxSocketSetTimeouts(
            descriptor, handshakeTimeoutMilliseconds, handshakeTimeoutMilliseconds
        )
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        if (deadline == 0) {
            val wait = HostedTlsWait(descriptor)
            var shook = SSL_accept(session)
            while (shook != 1 && hostedTlsInterrupted(wait, session, int(shook))) {
                shook = SSL_accept(session)
            }
            hostedTlsWaitDone(wait)
            ready = shook == 1
        } else {
            ready = linuxSocketSetNonblocking(descriptor, true)
            var done = false
            while (ready && !done) {
                val remaining = hostedTlsDeadlineWait(deadline, handshakeTimeoutMilliseconds)
                if (remaining <= 0) ready = false
                else {
                    val result = SSL_accept(session)
                    if (result == 1) done = true
                    else {
                        val error = SSL_get_error(session, result)
                        if (error != 2 && error != 3) ready = false
                        else {
                            val wait = hostedTlsDeadlineWait(deadline, handshakeTimeoutMilliseconds)
                            if (wait <= 0) ready = false
                            else {
                                val polled = linuxPollSocket(descriptor, error == 2, error == 3,
                                    wait)
                                if (polled.timedOut || polled.failed() ||
                                    (polled.closed && !polled.readable && !polled.writable)) ready =
                                    false
                            }
                        }
                    }
                }
            }
            if (!linuxSocketSetNonblocking(descriptor, false)) ready = false
        }
        linuxBrokenPipeRelease(held)
    }
    if (ready) {
        if (!configured) linuxSocketSetTimeouts(
            descriptor, readWriteTimeoutMilliseconds, readWriteTimeoutMilliseconds
        )
        handle = tlsAllocateConnection(context, session, descriptor, ownsContext)
    } else {
        if (!pointerIsNull(session)) SSL_free(session)
        if (descriptor >= 0) linuxTcpCloseDescriptor(descriptor)
        if (ownsContext) SSL_CTX_free(context)
        hostedTlsSetError(hostedTlsServerHandshakeFailed)
    }
    handle
}

// One blocking OpenSSL call on a socket with timeouts. OpenSSL reads EINTR, as from
// a stop and continue, like the timeout (both retry), and there is no errno to read
// here: one that came back well before its limit was interrupted, and goes on for
// what is left of it.
class HostedTlsWait(
    val descriptor: int,
    val started: int = linuxMonotonicMilliseconds(),
    var readLimit: int = -1,
    var writeLimit: int = -1
)

private trusted fun hostedTlsInterrupted(var wait: HostedTlsWait, session: i64*,
    result: int): bool {
    val code: int = SSL_get_error(session, i32(result))
    if (code != 2 && code != 3) return false
    val reading = code == 2
    val option = if (reading) 20 else 21
    if (reading && wait.readLimit < 0) wait.readLimit = linuxSocketTimeout(wait.descriptor, option)
    if (!reading && wait.writeLimit < 0) wait.writeLimit = linuxSocketTimeout(wait.descriptor,
        option)
    val limit = if (reading) wait.readLimit else wait.writeLimit
    if (limit == 0) return true
    // (Both clock readings round down, so a timeout can read 1 ms early.)
    val left = limit - (linuxMonotonicMilliseconds() - wait.started)
    if (left <= 1) return false
    linuxSocketSetTimeout(wait.descriptor, option, left)
    ERR_clear_error()
    true
}

// The limits as they were, for the next call.
private fun hostedTlsWaitDone(wait: HostedTlsWait): void {
    if (wait.readLimit > 0) linuxSocketSetTimeout(wait.descriptor, 20, wait.readLimit)
    if (wait.writeLimit > 0) linuxSocketSetTimeout(wait.descriptor, 21, wait.writeLimit)
    return
}

// A blocking socket that wants to go on waiting has hit its timeout. Anything
// else is the end of the connection, which has no error to report.
private trusted fun hostedTlsNoteFailure(session: i64*, result: int): void {
    val code: int = SSL_get_error(session, i32(result))
    hostedTlsSetError(if (code == 2 || code == 3) hostedTlsTimedOut else 0)
    return
}

trusted fun TlsConnection.read(maximum: int = 65536): string {
    var result = ""
    if (this.handle >= 0 && maximum > 0 && maximum <= 16777216) {
        val buffer = nativeByteBuffer(maximum + 1)
        val session = tlsControlPointer(this.handle, 8)
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        val wait = HostedTlsWait(tlsControlInt(this.handle, 16))
        var measured: int = SSL_read(session, buffer.address, maximum)
        while (measured <= 0 && hostedTlsInterrupted(wait, session, measured)) {
            measured = SSL_read(session, buffer.address, maximum)
        }
        hostedTlsWaitDone(wait)
        if (measured > 0) result = buffer.adoptString(measured)
        else {
            buffer.close()
            hostedTlsNoteFailure(session, measured)
        }
        linuxBrokenPipeRelease(held)
    }
    result
}

trusted fun TlsConnection.write(contents: string): int {
    var offset = 0
    var writing = this.handle >= 0
    while (writing && offset < contents.size) {
        var length = contents.size - offset
        if (length > 2147483647) length = 2147483647
        val session = tlsControlPointer(this.handle, 8)
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        val wait = HostedTlsWait(tlsControlInt(this.handle, 16))
        val chunk = contents.slice(offset, offset + length)
        var written: int = SSL_write(session, chunk, length)
        while (written <= 0 && hostedTlsInterrupted(wait, session, written)) {
            written = SSL_write(session, chunk, length)
        }
        hostedTlsWaitDone(wait)
        if (written <= 0) {
            writing = false
            hostedTlsNoteFailure(session, written)
        } else offset = offset + written
        linuxBrokenPipeRelease(held)
    }
    if (writing) offset else -1
}

trusted fun tlsCloseHandle(handle: int): bool {
    val session = tlsControlPointer(handle, 8)
    ERR_clear_error()
    val held = linuxBrokenPipeHold()
    SSL_shutdown(session)
    linuxBrokenPipeRelease(held)
    SSL_free(session)
    if (tlsControlInt(handle, 24) != 0) {
        SSL_CTX_free(tlsControlPointer(handle, 0))
    }
    val closed = linuxTcpCloseDescriptor(tlsControlInt(handle, 16))
    ablaUnsafeFree(tlsControl(handle))
    closed
}

trusted fun tlsCloseListenerHandle(handle: int): bool {
    val closed = linuxTcpCloseDescriptor(tlsControlInt(handle, 8))
    SSL_CTX_free(tlsControlPointer(handle, 0))
    ablaUnsafeFree(tlsControl(handle))
    closed
}

fun TlsConnection.close(): bool {
    var closed = this.handle < 0
    if (this.handle >= 0) {
        closed = tlsCloseHandle(this.handle)
        this.handle = -1
    }
    closed
}

fun TlsListener.close(): bool {
    var closed = this.handle < 0
    if (this.handle >= 0) {
        closed = tlsCloseListenerHandle(this.handle)
        this.handle = -1
    }
    closed
}
