// Certificate-verified TLS implemented in Abla over the raw Linux networking
// package. OpenSSL is a platform-library boundary, like libc and pthreads; no
// C runtime source or host-value adapter participates in this path.

import "openssl.ab"
import "../../jwt/libcrypto.ab"
import "abla/dns"
import "abla/sys/linux/net"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// The calling thread's last error, as a code in thread-local storage (like
// errno: each thread has its own, so threads starting connections at once
// don't share it); tlsLastError reads it as text.
@inline
trusted fun hostedTlsErrorSlot(): i64* =
    nativePointerFromAddress(
        nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00")
    )

trusted fun hostedTlsSetError(code: int): void {
    ablaUnsafeStoreI64(hostedTlsErrorSlot(), code)
    return
}

private val hostedTlsListenerFailed = 11
private val hostedTlsServerHandshakeFailed = 12
private val hostedTlsTimedOut = 13

// How long one read or write of an open connection may wait, unless the
// connection is told otherwise. Connecting and the handshake have their own,
// shorter limit; a protocol may reasonably wait this long for its peer's reply.
private val tlsDefaultReadWriteTimeoutMilliseconds = 30000

// A failed stage of a client connection, as its error code.
private fun hostedTlsStageCode(stage: string): int = when (stage) {
    "tcp_connect" -> 2
    "context_create" -> 3
    "trust_store" -> 4
    "session_create" -> 5
    "server_name" -> 6
    "host_verification_setup" -> 7
    "socket_attach" -> 8
    "handshake" -> 9
    "certificate_verification" -> 10
    else -> 1
}

private fun hostedTlsErrorText(code: int): string = when (code) {
    0 -> ""
    1 -> "TLS failed at configuration"
    2 -> "TLS failed at tcp_connect"
    3 -> "TLS failed at context_create"
    4 -> "TLS failed at trust_store"
    5 -> "TLS failed at session_create"
    6 -> "TLS failed at server_name"
    7 -> "TLS failed at host_verification_setup"
    8 -> "TLS failed at socket_attach"
    9 -> "TLS failed at handshake"
    10 -> "TLS failed at certificate_verification"
    11 -> "TLS certificate, private key, or listener failed"
    12 -> "TLS server handshake failed"
    13 -> "TLS read or write timed out"
    else -> "TLS failed"
}

// Connection control: context pointer, SSL pointer, descriptor, owns-context.
// Listener control: context pointer, descriptor.
trusted fun tlsAllocateConnection(
    context: i64*,
    session: i64*,
    descriptor: int,
    ownsContext: bool
): int {
    val control = ablaUnsafeAllocate(32)
    ablaUnsafeStorePointer(control, context)
    ablaUnsafeStorePointer(ablaUnsafePointerOffset(control, 8), session)
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(control, 16), descriptor)
    ablaUnsafeStoreI64(
        ablaUnsafePointerOffset(control, 24), if (ownsContext) 1 else 0
    )
    nativePointerAddress(control)
}

trusted fun tlsAllocateListener(context: i64*, descriptor: int): int {
    val control = ablaUnsafeAllocate(16)
    ablaUnsafeStorePointer(control, context)
    ablaUnsafeStoreI64(ablaUnsafePointerOffset(control, 8), descriptor)
    nativePointerAddress(control)
}

trusted fun tlsControl(handle: int): i64* = nativePointerFromAddress(handle)

trusted fun tlsControlPointer(handle: int, offset: int): i64* =
    ablaUnsafeLoadPointer(ablaUnsafePointerOffset(tlsControl(handle), offset))

trusted fun tlsControlInt(handle: int, offset: int): int =
    ablaUnsafeLoadI64(ablaUnsafePointerOffset(tlsControl(handle), offset))

resource class TlsConnection(var handle: int) {
    fun drop(): void {
        if (this.handle >= 0) tlsCloseHandle(this.handle)
        this.handle = -1
        return
    }
}

resource class TlsListener(var handle: int) {
    fun drop(): void {
        if (this.handle >= 0) tlsCloseListenerHandle(this.handle)
        this.handle = -1
        return
    }
}

trusted fun tlsAvailable(): bool = OpenSSL_version_num() > 0

trusted fun tlsLastError(): string =
    hostedTlsErrorText(ablaUnsafeLoadI64(hostedTlsErrorSlot()))

// The raw connector deliberately bounds its nonblocking connection phase to
// ten seconds. HTTPS callers may use a larger overall exchange timeout; keep
// that valid input from being rejected before a socket is opened.
private fun tlsTcpConnectTimeout(timeoutMilliseconds: int): int =
    if (timeoutMilliseconds > 10000) 10000 else timeoutMilliseconds

trusted fun tlsOpen(
    host: string,
    caPath: string,
    port: int,
    timeoutMilliseconds: int,
    readWriteTimeoutMilliseconds: int = 30000
): int {
    var handle = -1
    var stage = "configuration"
    var connection = TcpConnection(-1)
    var context = nativeNullPointer()
    var session = nativeNullPointer()
    var ready = port > 0 && port <= 65535 &&
        timeoutMilliseconds > 0 && timeoutMilliseconds <= 600000 &&
        tlsAvailable()
    if (ready) {
        stage = "tcp_connect"
        val connectTimeout = tlsTcpConnectTimeout(timeoutMilliseconds)
        // Local development certificates conventionally identify
        // `localhost`; avoid a DNS round-trip and preserve the listener's
        // IPv6 loopback choice while still verifying the original host name.
        connection = if (host == "localhost") tcpConnectIpv6(
            ipv6Loopback(port), connectTimeout
        ) else tcpConnectHost(host, port, connectTimeout)
        ready = connection.descriptor >= 0
    }
    if (!ready) { hostedTlsSetError(hostedTlsStageCode(stage)); return -1 }
    tlsUpgradeHandle(
        connection, host, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds
    )
}

// Takes ownership of an established TCP socket, including on failure.
// Certificate-chain and hostname verification are identical to tlsConnect.
// A socket that already has timeouts keeps them, through the handshake and after.
trusted fun tlsUpgradeHandle(
    var connection: TcpConnection,
    host: string,
    caPath: string,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = 30000
): int {
    var handle = -1
    var stage = "configuration"
    var context = nativeNullPointer()
    var session = nativeNullPointer()
    var ready = connection.descriptor >= 0 && host.size > 0 && tlsAvailable()
    if (ready) {
        stage = "context_create"
        context = SSL_CTX_new(TLS_client_method())
        ready = !pointerIsNull(context)
    }
    if (ready) {
        stage = "trust_store"
        SSL_CTX_set_verify(context, 1, nativeNullPointer())
        val trustLoaded = if (caPath != "")
            SSL_CTX_load_verify_locations(
                context, caPath, nativeNullPointer()
            ) == 1
        else SSL_CTX_set_default_verify_paths(context) == 1
        ready = trustLoaded
    }
    if (ready) {
        stage = "session_create"
        session = SSL_new(context)
        ready = !pointerIsNull(session)
    }
    if (ready) {
        stage = "server_name"
        ready = SSL_ctrl(session, 55, 0, host) == 1
    }
    if (ready) {
        stage = "host_verification_setup"
        ready = SSL_set1_host(session, host) == 1
    }
    if (ready) {
        stage = "socket_attach"
        ready = SSL_set_fd(session, connection.descriptor) == 1
    }
    val configured = ready && linuxSocketHasTimeouts(connection.descriptor)
    if (ready) {
        stage = "handshake"
        if (!configured) linuxSocketSetTimeouts(
            connection.descriptor, timeoutMilliseconds, timeoutMilliseconds
        )
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        ready = SSL_connect(session) == 1
        linuxBrokenPipeRelease(held)
    }
    if (ready) {
        stage = "certificate_verification"
        ready = SSL_get_verify_result(session) == 0
    }
    if (ready) {
        if (!configured) linuxSocketSetTimeouts(
            connection.descriptor,
            readWriteTimeoutMilliseconds,
            readWriteTimeoutMilliseconds
        )
        handle = tlsAllocateConnection(
            context, session, connection.descriptor, true
        )
        connection.descriptor = -1
        hostedTlsSetError(0)
    } else {
        if (!pointerIsNull(session)) SSL_free(session)
        if (!pointerIsNull(context)) SSL_CTX_free(context)
        hostedTlsSetError(hostedTlsStageCode(stage))
        connection.close()
    }
    handle
}

fun tlsUpgrade(
    var connection: TcpConnection,
    host: string,
    caPath: string = "",
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection = TlsConnection(tlsUpgradeHandle(
    connection, host, caPath, timeoutMilliseconds, readWriteTimeoutMilliseconds
))

fun tlsConnect(
    host: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection = TlsConnection(
    tlsOpen(host, "", port, timeoutMilliseconds, readWriteTimeoutMilliseconds)
)

fun tlsConnectWithCa(
    host: string,
    caPath: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection = TlsConnection(
    tlsOpen(host, caPath, port, timeoutMilliseconds, readWriteTimeoutMilliseconds)
)

// Replaces the limits on one read and one write; 0 waits as long as it takes.
// A read that times out returns "" and can be repeated (tlsLastError tells it
// from a closed connection). A write that times out leaves the connection unusable.
trusted fun TlsConnection.setTimeouts(
    readMilliseconds: int,
    writeMilliseconds: int
): bool = this.handle >= 0 && linuxSocketSetTimeouts(
    tlsControlInt(this.handle, 16), readMilliseconds, writeMilliseconds
)

trusted fun tlsListenHandle(
    certificatePath: string,
    privateKeyPath: string,
    host: string,
    port: int,
    backlog: int,
    dualStack: bool
): int {
    var handle = -1
    var context = nativeNullPointer()
    var listener = TcpListener(-1)
    var ready = port >= 0 && port <= 65535 && backlog > 0 &&
        backlog <= 4096 && tlsAvailable()
    if (ready) {
        context = SSL_CTX_new(TLS_server_method())
        ready = !pointerIsNull(context)
    }
    if (ready) ready = SSL_CTX_use_certificate_chain_file(
        context, certificatePath
    ) == 1
    if (ready) ready = SSL_CTX_use_PrivateKey_file(
        context, privateKeyPath, 1
    ) == 1
    if (ready) ready = SSL_CTX_check_private_key(context) == 1
    if (ready) {
        listener = if (linuxIpv6Words(host).size == 8)
            tcpListenIpv6(ipv6SocketAddress(host, port), backlog, dualStack)
        else tcpListenAddress(ipv4SocketAddress(host, port), backlog)
        ready = listener.descriptor >= 0
    }
    if (ready) {
        handle = tlsAllocateListener(context, listener.descriptor)
        listener.descriptor = -1
        hostedTlsSetError(0)
    } else {
        if (!pointerIsNull(context)) SSL_CTX_free(context)
        hostedTlsSetError(hostedTlsListenerFailed)
    }
    handle
}

fun tlsListen(
    certificatePath: string,
    privateKeyPath: string,
    host: string = "::",
    port: int = 443,
    backlog: int = 128,
    dualStack: bool = true
): TlsListener = TlsListener(tlsListenHandle(
    certificatePath, privateKeyPath, host, port, backlog, dualStack
))

trusted fun TlsListener.localPort(): int = if (this.handle >= 0) {
    var listener = TcpListener(tlsControlInt(this.handle, 8))
    val port = listener.localPort()
    listener.descriptor = -1
    port
} else -1

// A client that connects and says nothing costs one handshake timeout, so it
// can't hold up the clients behind it.
trusted fun TlsListener.accept(
    handshakeTimeoutMilliseconds: int = 5000,
    readWriteTimeoutMilliseconds: int = tlsDefaultReadWriteTimeoutMilliseconds
): TlsConnection {
    var handle = -1
    if (this.handle >= 0) {
        val context = tlsControlPointer(this.handle, 0)
        val descriptor = linuxTcpAcceptDescriptor(
            tlsControlInt(this.handle, 8)
        )
        var session = nativeNullPointer()
        var ready = descriptor >= 0
        if (ready) {
            session = SSL_new(context)
            ready = !pointerIsNull(session)
        }
        if (ready) ready = SSL_set_fd(session, descriptor) == 1
        if (ready) {
            linuxSocketSetTimeouts(
                descriptor, handshakeTimeoutMilliseconds, handshakeTimeoutMilliseconds
            )
            ERR_clear_error()
            val held = linuxBrokenPipeHold()
            ready = SSL_accept(session) == 1
            linuxBrokenPipeRelease(held)
        }
        if (ready) {
            linuxSocketSetTimeouts(
                descriptor, readWriteTimeoutMilliseconds, readWriteTimeoutMilliseconds
            )
            handle = tlsAllocateConnection(context, session, descriptor, false)
        } else {
            if (!pointerIsNull(session)) SSL_free(session)
            if (descriptor >= 0) linuxTcpCloseDescriptor(descriptor)
            hostedTlsSetError(hostedTlsServerHandshakeFailed)
        }
    }
    TlsConnection(handle)
}

// A blocking socket that wants to go on waiting has hit its timeout. Anything
// else is the end of the connection, which has no error to report.
private trusted fun hostedTlsNoteFailure(session: i64*, result: int): void {
    val code: int = SSL_get_error(session, i32(result))
    hostedTlsSetError(if (code == 2 || code == 3) hostedTlsTimedOut else 0)
    return
}

trusted fun TlsConnection.read(maximum: int = 65536): string {
    var result = ""
    if (this.handle >= 0 && maximum > 0 && maximum <= 16777216) {
        val buffer = nativeByteBuffer(maximum + 1)
        val session = tlsControlPointer(this.handle, 8)
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        val measured: int = SSL_read(session, buffer.address, maximum)
        if (measured > 0) result = buffer.adoptString(measured)
        else {
            buffer.close()
            hostedTlsNoteFailure(session, measured)
        }
        linuxBrokenPipeRelease(held)
    }
    result
}

trusted fun TlsConnection.write(contents: string): int {
    var offset = 0
    var writing = this.handle >= 0
    while (writing && offset < contents.size) {
        var length = contents.size - offset
        if (length > 2147483647) length = 2147483647
        val session = tlsControlPointer(this.handle, 8)
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        val written: int = SSL_write(
            session,
            contents.slice(offset, offset + length),
            length
        )
        if (written <= 0) {
            writing = false
            hostedTlsNoteFailure(session, written)
        } else offset = offset + written
        linuxBrokenPipeRelease(held)
    }
    if (writing) offset else -1
}

trusted fun tlsCloseHandle(handle: int): bool {
    val session = tlsControlPointer(handle, 8)
    ERR_clear_error()
    val held = linuxBrokenPipeHold()
    SSL_shutdown(session)
    linuxBrokenPipeRelease(held)
    SSL_free(session)
    if (tlsControlInt(handle, 24) != 0) {
        SSL_CTX_free(tlsControlPointer(handle, 0))
    }
    val closed = linuxTcpCloseDescriptor(tlsControlInt(handle, 16))
    ablaUnsafeFree(tlsControl(handle))
    closed
}

trusted fun tlsCloseListenerHandle(handle: int): bool {
    val closed = linuxTcpCloseDescriptor(tlsControlInt(handle, 8))
    SSL_CTX_free(tlsControlPointer(handle, 0))
    ablaUnsafeFree(tlsControl(handle))
    closed
}

fun TlsConnection.close(): bool {
    var closed = this.handle < 0
    if (this.handle >= 0) {
        closed = tlsCloseHandle(this.handle)
        this.handle = -1
    }
    closed
}

fun TlsListener.close(): bool {
    var closed = this.handle < 0
    if (this.handle >= 0) {
        closed = tlsCloseListenerHandle(this.handle)
        this.handle = -1
    }
    closed
}
