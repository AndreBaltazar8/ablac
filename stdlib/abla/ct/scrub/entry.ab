// Wiping the stack a secret-handling call used. A register allocator spills into the red zone or a frame
// that nothing clears when the function returns, and the compiler cannot name those slots. The entry
// point that called the secret work calls one of these after it returns: every frame the work used then
// lies below the entry's stack pointer, and the wipe zeroes N bytes below the call (the wipe is a function of
// its own, so the entry that calls it has a call and keeps nothing in a red zone). N must reach the deepest frame
// of the work; tools/test-ct.sh reads the work's stack depth from the assembly and runs the real entries
// to find out if it falls short.
//
// The backend emits the wipe for x86-64 (`rep stosq`) and AArch64 (a store loop). Wasm has no addressable
// native stack, and Xtensa is checked and not run: there this does nothing (docs/constant-time.md). Do not
// call it with a secret you still need below sp.

noescape extern:"intrinsic" fun ablaCtScrubStack512(): void
noescape extern:"intrinsic" fun ablaCtScrubStack1024(): void
noescape extern:"intrinsic" fun ablaCtScrubStack2048(): void
noescape extern:"intrinsic" fun ablaCtScrubStack4096(): void

/** Zeroes the 512 bytes below the stack pointer. */
@noinline fun ctScrubStack512(): void = ablaCtScrubStack512()

/** Zeroes the 1024 bytes below the stack pointer. */
@noinline fun ctScrubStack1024(): void = ablaCtScrubStack1024()

/** Zeroes the 2048 bytes below the stack pointer. */
@noinline fun ctScrubStack2048(): void = ablaCtScrubStack2048()

/** Zeroes the 4096 bytes below the stack pointer. */
@noinline fun ctScrubStack4096(): void = ablaCtScrubStack4096()
