// Wiping the stack a secret-handling call used. A register allocator spills into the red zone or a frame
// that nothing clears when the function returns, and the compiler cannot name those slots. The entry
// point that called the secret work calls one of these after it returns: every frame the work used then
// lies below the entry's stack pointer, and the wipe zeroes N bytes below the call (the wipe is a function of
// its own, so the entry that calls it has a call and keeps nothing in a red zone). N must reach the deepest frame
// of the work; tools/test-ct.sh reads the work's stack depth from the assembly and runs the real entries
// to find out if it falls short.
//
// The backend emits the wipe for x86-64 (`rep stosq`), AArch64 and Xtensa (store loops). Wasm has no addressable
// native stack: there this does nothing (docs/constant-time.md). Xtensa is read, not run. Do not call it with a
// secret you still need below sp.
//
// On Xtensa (windowed ABI) the wipe function can't reach the top of its caller's callee area: under its own a1 are
// its caller's a0-a3 (where a window overflow keeps them) and above that its own frame. Each public wipe is
// therefore inlined into its caller, calls the wipe below, and then clears those 32 bytes from the caller's frame
// (ablaCtScrubSaveAreas, nothing on the other targets). An Xtensa stack has no guard page (a FreeRTOS task's is a
// few KiB), so there the wipe stops at the limit the image gives, and without one it does nothing: the image defines
// `uint32_t abla_ct_stack_low(void)` (C ABI, linked weakly: an image without it links and doesn't wipe), returning
// the lowest address of the running stack the wipe may zero, or 0 for none (in an interrupt, say). It is asked
// once per wipe, from the task that wipes, so it can answer per task.

noescape extern:"intrinsic" fun ablaCtScrubStack512(): void
noescape extern:"intrinsic" fun ablaCtScrubStack1024(): void
noescape extern:"intrinsic" fun ablaCtScrubStack2048(): void
noescape extern:"intrinsic" fun ablaCtScrubStack4096(): void
noescape extern:"intrinsic" fun ablaCtScrubBoundedStack512(): void
noescape extern:"intrinsic" fun ablaCtScrubBoundedStack1024(): void
noescape extern:"intrinsic" fun ablaCtScrubBoundedStack2048(): void
noescape extern:"intrinsic" fun ablaCtScrubBoundedStack4096(): void
noescape extern:"intrinsic" fun ablaCtScrubBounded(): bool
noescape extern:"intrinsic" fun ablaCtScrubSaveAreas(): void
noescape extern:"intrinsic" fun ablaCtScrubAvailable(): bool

/**
 * Whether the ctScrubStack* wipes zero anything in this program as built and linked: always on x86-64 and AArch64,
 * never on Wasm (no native stack), and on Xtensa only when the image defines abla_ct_stack_low (decided by what is
 * linked into the image). There true means the wipes can run, not that each one does: one is skipped when
 * abla_ct_stack_low returns 0 (in an interrupt, or a task with no known limit). A firmware that relies on the wipes
 * can check it once at startup. Not at compile time (`compile.effect-denied`).
 */
fun ctScrubAvailable(): bool = ablaCtScrubAvailable()

@noinline fun ctScrubBelow512(): void = ablaCtScrubStack512()

@noinline fun ctScrubBelow1024(): void = ablaCtScrubStack1024()

@noinline fun ctScrubBelow2048(): void = ablaCtScrubStack2048()

@noinline fun ctScrubBelow4096(): void = ablaCtScrubStack4096()

@noinline fun ctScrubBounded512(): void = ablaCtScrubBoundedStack512()

@noinline fun ctScrubBounded1024(): void = ablaCtScrubBoundedStack1024()

@noinline fun ctScrubBounded2048(): void = ablaCtScrubBoundedStack2048()

@noinline fun ctScrubBounded4096(): void = ablaCtScrubBoundedStack4096()

/** Zeroes the 512 bytes below the stack pointer. */
@inline fun ctScrubStack512(): void {
    if (ablaCtScrubBounded()) ctScrubBounded512() else ctScrubBelow512()
    ablaCtScrubSaveAreas()
}

/** Zeroes the 1024 bytes below the stack pointer. */
@inline fun ctScrubStack1024(): void {
    if (ablaCtScrubBounded()) ctScrubBounded1024() else ctScrubBelow1024()
    ablaCtScrubSaveAreas()
}

/** Zeroes the 2048 bytes below the stack pointer. */
@inline fun ctScrubStack2048(): void {
    if (ablaCtScrubBounded()) ctScrubBounded2048() else ctScrubBelow2048()
    ablaCtScrubSaveAreas()
}

/** Zeroes the 4096 bytes below the stack pointer. */
@inline fun ctScrubStack4096(): void {
    if (ablaCtScrubBounded()) ctScrubBounded4096() else ctScrubBelow4096()
    ablaCtScrubSaveAreas()
}
