/** All ones if `count` bytes at each address differ anywhere, else zero: every byte is read
 *  whatever the others are. What the addresses and `count` are isn't hidden. */
@inline trusted fun ctDifferenceAddress(left: int, right: int, count: int): secretU8 {
    var difference = ablaCtSecret_u8(u8(0))
    for (at in 0 until count) {
        val a = ablaUnsafeLoadU8(ablaUnsafePointerOffset(ablaUnsafeNullPointer(), left + at))
        val b = ablaUnsafeLoadU8(ablaUnsafePointerOffset(ablaUnsafeNullPointer(), right + at))
        difference = difference | (ablaCtSecret_u8(u8(a)) ^ ablaCtSecret_u8(u8(b)))
    }
    ctIsNonZero(difference)
}

/** Whether two strings are equal, reading every byte. Their lengths aren't secret: different
 *  ones are unequal at once. */
trusted fun ctEquals(left: string, right: string): bool {
    if (left.size != right.size) return false
    ctDifferenceAddress(
        ablaUnsafeStringAddress(left), ablaUnsafeStringAddress(right), left.size
    ).declassify() == u8(0)
}
