noescape extern:"intrinsic" fun ablaCtNarrowTarget(): bool

@inline fun ctJoin(low: u32, high: u32): secretU64 = ablaCtSecret_u64((u64(high) << 32) | u64(low))

@inline fun ctAddHalves(aLow: u32, aHigh: u32, bLow: u32, bHigh: u32): secretU64 {
    val low = aLow + bLow
    val carry = ((aLow & bLow) | ((aLow | bLow) & ~low)) >> 31
    ctJoin(low, aHigh + bHigh + carry)
}

@inline fun ctSubHalves(aLow: u32, aHigh: u32, bLow: u32, bHigh: u32): secretU64 {
    val low = aLow - bLow
    val borrow = ((~aLow & bLow) | ((~aLow | bLow) & low)) >> 31
    ctJoin(low, aHigh - bHigh - borrow)
}

// All ones in a word if the first number is less than the second, else zero.
@inline fun ctBorrowHalves(aLow: u32, aHigh: u32, bLow: u32, bHigh: u32): u32 {
    val low = aLow - bLow
    val borrow = ((~aLow & bLow) | ((~aLow | bLow) & low)) >> 31
    val high = aHigh - bHigh - borrow
    u32(0) - (((~aHigh & bHigh) | ((~aHigh | bHigh) & high)) >> 31)
}

