// Phase-safe byte storage. The bootstrap representation keeps immutable byte
// chunks so converting to and from strings does not copy every byte. Backends
// may specialize this public API to contiguous storage without changing users.

import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// Returns a one-byte string for 0 through 255, or an empty string outside that range.
noescape extern:"intrinsic" fun ablaByteEncode(value: int): string
// Joins byte chunks in order using their known combined length.
noescape extern:"intrinsic" fun ablaByteChunksJoin(
    chunks: array<string>,
    byteCount: int
): string

// Returns the one-byte string for 0...255, or an empty string outside that
// range. Unlike UTF-8 scalar encoding, values above 127 remain one byte.
fun byteEncode(value: int): string = ablaByteEncode(value)

// Small appends are copied into `stage`, a string the buffer alone owns and
// writes in place; a full stage becomes a chunk as it is. Stages grow with the
// buffer, from BYTE_BUFFER_FIRST bytes to BYTE_BUFFER_STAGE, so a buffer that
// only ever holds a few bytes stays small. A document written a token at a time (a JSON
// encoder's punctuation, keys and numbers) used to keep a string and an array
// slot per token, and numbers are written without making a string at all
// (appendInt, appendFixed).
// Appends of BYTE_BUFFER_LARGE bytes or more stay their own chunk, uncopied.
@__abla_trusted_only("error: make one with byteBuffer() or bytes(text); its trusted writers write at its stage's address plus `staged`")
class ByteBuffer(
    val chunks: array<string>,
    var byteCount: int,
    var stage: string = "",
    var staged: int = 0
)

// True while ablac's compile-time evaluator runs the caller: the evaluator
// answers this call itself, takes only the `then` branch of an
// `if (ablaAtCompileTime())`, and counts the effects of that branch alone, so
// the `else` may use raw memory it cannot. Compiled code always sees false.
fun ablaAtCompileTime(): bool = false

// True while ablac runs the caller at compile time as native code for the host (the `jit` tier, or `auto` for a site
// it runs natively): such code can take the same raw-memory path compiled code does. False in the evaluator, in a
// slice built for another target (a cross-target site, which must stay portable), and in compiled code. The
// compile-time analyses take it as false, so the `then` of `if (ablaCompileTimeNativeHost())` is never what they
// look at; a dispatcher reads
//     if (ablaCompileTimeNativeHost()) native() else if (ablaAtCompileTime()) portable() else native()
fun ablaCompileTimeNativeHost(): bool = false

private val BYTE_BUFFER_FIRST = 64
private val BYTE_BUFFER_STAGE = 4096
// Appends of at least this many bytes are kept as chunks instead of staged together.
val BYTE_BUFFER_LARGE = 256

// A view over bytes from `begin` inclusive to `end` exclusive in `buffer`. Use isValid to check bounds.
class ByteSlice(
    val buffer: ByteBuffer,
    val begin: int,
    val end: int
) {
    // Returns the span length or zero when its endpoints are reversed.
    fun size(): int = if (this.end >= this.begin) this.end - this.begin else 0

    // Returns true if both endpoints form an ordered range within the current buffer.
    fun isValid(): bool = this.begin >= 0 &&
        this.end >= this.begin &&
        this.end <= this.buffer.byteCount
}

// Creates an empty byte buffer.
trusted fun byteBuffer(): ByteBuffer = ByteBuffer([], 0)

// Creates a buffer initialized with the bytes of `text`.
fun bytes(text: string): ByteBuffer {
    val result = byteBuffer()
    result.appendText(text)
    result
}

// Returns the number of stored bytes.
fun ByteBuffer.size(): int = this.byteCount

// Appends the bytes of `text` in order. An empty string has no effect.
fun ByteBuffer.appendText(text: string): void {
    if (ablaCompileTimeNativeHost()) this.stageText(text)
    else if (ablaAtCompileTime()) this.appendChunk(text)
    else this.stageText(text)
}

// The most bytes one buffer holds: a rope names a length without holding the bytes, so two chunks of 2^62 bytes are
// possible, and their count would wrap (the join then sizes its output by the wrapped count and writes the chunks past it).
private val BYTE_BUFFER_MAXIMUM = 4611686018427387904


// Appends nonempty `text` as a separate chunk after sealing existing staged bytes.
trusted fun ByteBuffer.appendChunk(text: string): void {
    if (text.size > 0) {
        // Past the most a buffer holds nothing is appended (no module here may panic or trap: the compile-time portable library and
        // hostless WebAssembly take no host imports, and a count that wrapped would size the join's output wrongly).
        if (text.size <= BYTE_BUFFER_MAXIMUM - this.byteCount) {
            this.seal()
            this.chunks.append(text)
            this.byteCount = this.byteCount + text.size
        }
    }
}

// Appends text to the staging buffer or keeps a large input as its own chunk.
trusted fun ByteBuffer.stageText(text: string): void {
    val length = text.size
    if (length >= BYTE_BUFFER_LARGE) this.appendChunk(text)
    else if (length > 0) {
        val staged = this.staged
        val stage = this.stage
        var offset = staged
        var destination = 0
        if (staged >= 0 && staged <= stage.size - length) {
            destination = ablaUnsafeStringAddress(stage) + staged
        } else {
            destination = this.stageReserve(length)
            // Growth may seal the old stage and start a new one at zero.
            offset = this.staged
        }
        // Reserve first: text must remain rooted until any growth is done.
        val source = ablaUnsafeStringAddress(text)
        if (length <= 8) {
            // Constant-size copies allow unaligned string slices on every
            // target. Both overlapping first/last writes stay in bounds.
            if (length >= 4) {
                ablaUnsafeCopyMemory(destination, source, 4)
                ablaUnsafeCopyMemory(destination + length - 4, source + length - 4, 4)
            } else if (length >= 2) {
                ablaUnsafeCopyMemory(destination, source, 2)
                ablaUnsafeCopyMemory(destination + length - 2, source + length - 2, 2)
            } else ablaUnsafeCopyMemory(destination, source, 1)
        } else ablaUnsafeCopyMemory(destination, source, length)
        this.staged = offset + length
        this.byteCount = this.byteCount + length
    }
}

// The address where `bytes` more bytes can be written into the stage, which
// the caller then counts in `staged` and `byteCount`. A `staged` outside the stage (not one this module wrote: below 0 or past
// the stage's end) drops the stage first, since every writer writes at the stage's address plus `staged`; the buffer's count
// then no longer matches its bytes, and the join refuses it.
trusted fun ByteBuffer.stageReserve(bytes: int): int {
    if (this.staged < 0 || this.staged > this.stage.size) {
        this.stage = ""
        this.staged = 0
    }
    if (this.staged + bytes > this.stage.size) {
        if (this.staged > 0 && this.staged + bytes <= BYTE_BUFFER_STAGE) {
            // Keep small token streams contiguous. Geometric growth bounds
            // copying while avoiding an array entry and final join per stage.
            var capacity = this.stage.size * 2
            while (capacity < this.staged + bytes && capacity < BYTE_BUFFER_STAGE) {
                capacity = capacity * 2
            }
            if (capacity > BYTE_BUFFER_STAGE) capacity = BYTE_BUFFER_STAGE
            val replacement = adoptNativeString(
                ablaUnsafePointerAddress(ablaUnsafeAllocate(capacity + 1)), capacity
            )
            ablaUnsafeCopyMemory(
                ablaUnsafeStringAddress(replacement),
                ablaUnsafeStringAddress(this.stage), this.staged
            )
            this.stage = replacement
        } else {
            this.seal()
            var capacity = this.byteCount
            if (capacity < BYTE_BUFFER_FIRST) capacity = BYTE_BUFFER_FIRST
            if (capacity > BYTE_BUFFER_STAGE) capacity = BYTE_BUFFER_STAGE
            if (capacity < bytes) capacity = bytes
            // capacity + 1 wraps at the largest int (a stage claiming 2^63 - 1 bytes over a 1-byte allocation): past the most a
            // buffer holds, ask for one byte more than it, which the allocator refuses.
            if (capacity > BYTE_BUFFER_MAXIMUM) capacity = BYTE_BUFFER_MAXIMUM
            this.stage = adoptNativeString(
                ablaUnsafePointerAddress(ablaUnsafeAllocate(capacity + 1)), capacity
            )
        }
    }
    ablaUnsafeStringAddress(this.stage) + this.staged
}

// Moves the staged bytes into a chunk of their own.
trusted fun ByteBuffer.seal(): void {
    if (this.staged > 0) this.chunks.append(this.stagedText())
    this.stage = ""
    this.staged = 0
    return
}

// Returns the bytes currently staged, excluding all sealed chunks.
fun ByteBuffer.stagedText(): string =
    if (this.staged == this.stage.size) this.stage
    else this.stage.slice(0, this.staged)

// `value` in decimal, as "$value" writes it, straight into the stage.
fun ByteBuffer.appendInt(value: int): void = this.appendFixed(value, 0)

// `value` / 10^decimals in decimal with exactly `decimals` digits after the
// point: (15, 1) "1.5", (5, 3) "0.005", (-25, 2) "-0.25", (7, 0) "7".
fun ByteBuffer.appendFixed(value: int, decimals: int): void {
    // The staged text is sign + digits + point + decimals bytes: a decimals near 2^63 wrapped that length negative, the
    // count with it, and the next append wrote before the stage. (Such a count writes nothing; 2^62 or less is an allocation that
    // fails.)
    if (decimals > BYTE_BUFFER_MAXIMUM) return
    if (ablaCompileTimeNativeHost()) this.stageFixed(value, decimals)
    else if (ablaAtCompileTime()) this.appendChunk(byteFixedText(value, decimals))
    else this.stageFixed(value, decimals)
}

// Appends the signed integer as a fixed-point decimal with the requested number of fractional digits.
trusted fun ByteBuffer.stageFixed(value: int, fraction: int): void {
    // As appendFixed: a count of decimals near 2^63 wraps the length. Fewer than none writes the integer, as byteFixedText does.
    if (fraction > BYTE_BUFFER_MAXIMUM) return
    val decimals = if (fraction < 0) 0 else fraction
    var digits = 1
    var rest = value / 10
    while (rest != 0) {
        digits = digits + 1
        rest = rest / 10
    }
    val sign = if (value < 0) 1 else 0
    val whole = if (digits > decimals) digits - decimals else 1
    val point = if (decimals > 0) sign + whole else -1
    val length = sign + whole + (if (decimals > 0) 1 + decimals else 0)
    val address = this.stageReserve(length)
    if (sign == 1) ablaUnsafeStoreU8(nativePointerFromAddress(address), 45)
    var remaining = value
    var position = length - 1
    while (position >= sign) {
        if (position == point) {
            ablaUnsafeStoreU8(nativePointerFromAddress(address + position), 46)
        } else {
            var digit = remaining - remaining / 10 * 10
            if (digit < 0) digit = 0 - digit
            ablaUnsafeStoreU8(nativePointerFromAddress(address + position), 48 + digit)
            remaining = remaining / 10
        }
        position = position - 1
    }
    this.staged = this.staged + length
    this.byteCount = this.byteCount + length
    return
}

// appendFixed's text, made as a string.
private fun byteFixedText(value: int, decimals: int): string {
    val text = "$value"
    if (decimals <= 0) return text
    val sign = if (value < 0) "-" else ""
    var digits = if (value < 0) text.slice(1, text.size) else text
    while (digits.size <= decimals) digits = "0$digits"
    val point = digits.size - decimals
    "$sign${digits.slice(0, point)}.${digits.slice(point, digits.size)}"
}

// The buffer's pieces in order: its chunks, then the staged bytes.
fun ByteBuffer.pieceCount(): int =
    this.chunks.size + (if (this.staged > 0) 1 else 0)

// Returns sealed chunk `index` if it precedes the staged tail, or the staged text for later indices. A negative index panics. Iterate over 0 until pieceCount for the actual pieces.
fun ByteBuffer.piece(index: int): string =
    if (index < this.chunks.size) this.chunks[index]
    else this.stagedText()

// A byte is represented by a one-byte string at the portable language layer.
// This preserves all 256 values, including bytes originating in files/sockets,
// without pretending that an integer is a Unicode character.
fun ByteBuffer.appendByte(byte: string): bool {
    var appended = false
    if (byte.size == 1) {
        this.appendText(byte)
        appended = true
    }
    appended
}

/// Appends one byte and returns true. Values outside 0 through 255 return false without changing the buffer.
@inline trusted fun ByteBuffer.appendByteValue(value: int): bool {
    if (value < 0 || value > 255) return false
    if (ablaCompileTimeNativeHost()) {
        if (this.tryAppendStagedByte(value)) return true
        return this.growAndAppendStagedByte(value)
    }
    if (ablaAtCompileTime()) return this.appendByte(byteEncode(value))
    if (this.tryAppendStagedByte(value)) return true
    this.growAndAppendStagedByte(value)
}

/// Appends a byte through native staging. Returns false without changing the buffer when the value is outside 0 through 255.
@inline trusted fun ByteBuffer.appendByteValueNative(value: int): bool {
    if (value < 0 || value > 255) return false
    if (this.tryAppendStagedByte(value)) return true
    this.growAndAppendStagedByte(value)
}

// A successful staged write returns before the growth path can push GC roots.
private @inline trusted fun ByteBuffer.tryAppendStagedByte(value: int): bool {
    val staged = this.staged
    val stage = this.stage
    if (staged < 0 || staged >= stage.size) return false
    ablaUnsafeStoreU8(nativePointerFromAddress(ablaUnsafeStringAddress(stage) + staged), value)
    this.staged = staged + 1
    this.byteCount = this.byteCount + 1
    true
}

private trusted fun ByteBuffer.growAndAppendStagedByte(value: int): bool {
    val destination = this.stageReserve(1)
    ablaUnsafeStoreU8(nativePointerFromAddress(destination), value)
    this.staged = this.staged + 1
    this.byteCount = this.byteCount + 1
    true
}

// Appends the pieces of `other` in order. Pass a distinct buffer because the source is traversed as this buffer grows.
fun ByteBuffer.appendBuffer(other: ByteBuffer): void {
    var index = 0
    while (index < other.pieceCount()) {
        this.appendText(other.piece(index))
        index = index + 1
    }
}

// Returns the unsigned byte at zero-based `index`, or -1 if out of range.
fun ByteBuffer.byteAt(index: int): int {
    if (index < 0 || index >= this.byteCount) return -1
    var offset = index
    for (chunk in this.chunks) {
        if (offset < chunk.size) return chunk[offset]
        offset = offset - chunk.size
    }
    this.stage[offset]
}

// Borrows a view over bytes from `begin` inclusive to `end` exclusive. Bounds are checked by the view's read methods.
fun ByteBuffer.slice(begin: int, end: int): borrow(this) ByteSlice =
    ByteSlice(this, begin, end)

// Returns all stored bytes in order as a string. Bytes are preserved even when they are invalid UTF-8.
fun ByteBuffer.toText(): string {
    if (this.chunks.size == 0) return this.stagedText()
    if (this.staged == 0) return ablaByteChunksJoin(this.chunks, this.byteCount)
    val pieces: array<string> = []
    for (chunk in this.chunks) pieces.append(chunk)
    pieces.append(this.stagedText())
    ablaByteChunksJoin(pieces, this.byteCount)
}

// Returns the unsigned byte at slice-relative `index`, or -1 when either the slice or the index is out of range.
fun ByteSlice.byteAt(index: int): int {
    var result = -1
    if (this.isValid() && index >= 0 && index < this.size()) {
        result = this.buffer.byteAt(this.begin + index)
    }
    result
}

// Returns the slice's bytes as a string, or an empty string if the slice is invalid.
fun ByteSlice.toText(): string {
    var result = ""
    if (this.isValid()) {
        var chunkBegin = 0
        var index = 0
        while (index < this.buffer.pieceCount() && chunkBegin < this.end) {
            val chunk = this.buffer.piece(index)
            val chunkEnd = chunkBegin + chunk.size
            var overlapBegin = this.begin
            if (overlapBegin < chunkBegin) overlapBegin = chunkBegin
            var overlapEnd = this.end
            if (overlapEnd > chunkEnd) overlapEnd = chunkEnd
            if (overlapBegin < overlapEnd) {
                result = "$result${chunk.slice(
                    overlapBegin - chunkBegin,
                    overlapEnd - chunkBegin
                )}"
            }
            chunkBegin = chunkEnd
            index = index + 1
        }
    }
    result
}

// Deterministic and overflow-safe on Abla's signed 64-bit integer. This is a
// content fingerprint, not a cryptographic hash.
fun stableTextHash(text: string): int {
    var hash = 17
    var index = 0
    while (index < text.size) {
        hash = hash * 257 + text[index] + 1
        hash = hash - (hash / 1000000007) * 1000000007
        index = index + 1
    }
    hash
}

// Returns a deterministic, noncryptographic fingerprint of the stored bytes.
fun ByteBuffer.stableHash(): int = stableTextHash(this.toText())

// Returns a deterministic, noncryptographic fingerprint of the slice. An invalid slice hashes as an empty string.
fun ByteSlice.stableHash(): int = stableTextHash(this.toText())
