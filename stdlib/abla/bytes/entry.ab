// Phase-safe byte storage. The bootstrap representation keeps immutable byte
// chunks so converting to and from strings does not copy every byte. Backends
// may specialize this public API to contiguous storage without changing users.

import "abla/unsafe/memory"

noescape extern:"intrinsic" fun ablaByteEncode(value: int): string
noescape extern:"intrinsic" fun ablaByteChunksJoin(
    chunks: array<string>,
    byteCount: int
): string

// Returns the one-byte string for 0...255, or an empty string outside that
// range. Unlike UTF-8 scalar encoding, values above 127 remain one byte.
fun byteEncode(value: int): string = ablaByteEncode(value)

// Small appends are copied into `stage`, a string the buffer alone owns and
// writes in place; a full stage becomes a chunk as it is. Stages grow with the
// buffer, from BYTE_BUFFER_FIRST bytes to BYTE_BUFFER_STAGE, so a buffer that
// only ever holds a few bytes stays small. A document written a token at a time (a JSON
// encoder's punctuation, keys and numbers) used to keep a string and an array
// slot per token, and numbers are written without making a string at all
// (appendInt, appendFixed).
// Appends of BYTE_BUFFER_LARGE bytes or more stay their own chunk, uncopied.
class ByteBuffer(
    val chunks: array<string>,
    var byteCount: int,
    var stage: string = "",
    var staged: int = 0
)

// True while ablac's compile-time evaluator runs the caller: the evaluator
// answers this call itself, takes only the `then` branch of an
// `if (ablaAtCompileTime())`, and counts the effects of that branch alone, so
// the `else` may use raw memory it cannot. Compiled code always sees false.
fun ablaAtCompileTime(): bool = false

val BYTE_BUFFER_FIRST = 64
val BYTE_BUFFER_STAGE = 4096
val BYTE_BUFFER_LARGE = 256

class ByteSlice(
    val buffer: ByteBuffer,
    val begin: int,
    val end: int
) {
    fun size(): int = if (this.end >= this.begin) this.end - this.begin else 0

    fun isValid(): bool = this.begin >= 0 &&
        this.end >= this.begin &&
        this.end <= this.buffer.byteCount
}

fun byteBuffer(): ByteBuffer = ByteBuffer([], 0)

fun bytes(text: string): ByteBuffer {
    val result = byteBuffer()
    result.appendText(text)
    result
}

fun ByteBuffer.size(): int = this.byteCount

fun ByteBuffer.appendText(text: string): void {
    if (ablaAtCompileTime()) this.appendChunk(text)
    else this.stageText(text)
}

fun ByteBuffer.appendChunk(text: string): void {
    if (text.size > 0) {
        this.seal()
        this.chunks.append(text)
        this.byteCount = this.byteCount + text.size
    }
}

trusted fun ByteBuffer.stageText(text: string): void {
    if (text.size >= BYTE_BUFFER_LARGE) this.appendChunk(text)
    else if (text.size > 0) {
        ablaUnsafeCopyMemory(
            this.stageReserve(text.size), ablaUnsafeStringAddress(text), text.size
        )
        this.staged = this.staged + text.size
        this.byteCount = this.byteCount + text.size
    }
}

// The address where `bytes` more bytes can be written into the stage, which
// the caller then counts in `staged` and `byteCount`.
trusted fun ByteBuffer.stageReserve(bytes: int): int {
    if (this.staged + bytes > this.stage.size) {
        this.seal()
        var capacity = this.byteCount
        if (capacity < BYTE_BUFFER_FIRST) capacity = BYTE_BUFFER_FIRST
        if (capacity > BYTE_BUFFER_STAGE) capacity = BYTE_BUFFER_STAGE
        if (capacity < bytes) capacity = bytes
        this.stage = adoptNativeString(
            ablaUnsafePointerAddress(ablaUnsafeAllocate(capacity + 1)), capacity
        )
    }
    ablaUnsafeStringAddress(this.stage) + this.staged
}

// Moves the staged bytes into a chunk of their own.
fun ByteBuffer.seal(): void {
    if (this.staged > 0) this.chunks.append(this.stagedText())
    this.stage = ""
    this.staged = 0
    return
}

fun ByteBuffer.stagedText(): string =
    if (this.staged == this.stage.size) this.stage
    else this.stage.slice(0, this.staged)

// `value` in decimal, as "$value" writes it, straight into the stage.
fun ByteBuffer.appendInt(value: int): void = this.appendFixed(value, 0)

// `value` / 10^decimals in decimal with exactly `decimals` digits after the
// point: (15, 1) "1.5", (5, 3) "0.005", (-25, 2) "-0.25", (7, 0) "7".
fun ByteBuffer.appendFixed(value: int, decimals: int): void {
    if (ablaAtCompileTime()) this.appendChunk(byteFixedText(value, decimals))
    else this.stageFixed(value, decimals)
}

trusted fun ByteBuffer.stageFixed(value: int, decimals: int): void {
    var digits = 1
    var rest = value / 10
    while (rest != 0) {
        digits = digits + 1
        rest = rest / 10
    }
    val sign = if (value < 0) 1 else 0
    val whole = if (digits > decimals) digits - decimals else 1
    val point = if (decimals > 0) sign + whole else -1
    val length = sign + whole + (if (decimals > 0) 1 + decimals else 0)
    val address = this.stageReserve(length)
    if (sign == 1) ablaUnsafeStoreU8(nativePointerFromAddress(address), 45)
    var remaining = value
    var position = length - 1
    while (position >= sign) {
        if (position == point) {
            ablaUnsafeStoreU8(nativePointerFromAddress(address + position), 46)
        } else {
            var digit = remaining - remaining / 10 * 10
            if (digit < 0) digit = 0 - digit
            ablaUnsafeStoreU8(nativePointerFromAddress(address + position), 48 + digit)
            remaining = remaining / 10
        }
        position = position - 1
    }
    this.staged = this.staged + length
    this.byteCount = this.byteCount + length
    return
}

// appendFixed's text, made as a string.
fun byteFixedText(value: int, decimals: int): string {
    val text = "$value"
    if (decimals <= 0) return text
    val sign = if (value < 0) "-" else ""
    var digits = if (value < 0) text.slice(1, text.size) else text
    while (digits.size <= decimals) digits = "0$digits"
    val point = digits.size - decimals
    "$sign${digits.slice(0, point)}.${digits.slice(point, digits.size)}"
}

// The buffer's pieces in order: its chunks, then the staged bytes.
fun ByteBuffer.pieceCount(): int =
    this.chunks.size + (if (this.staged > 0) 1 else 0)

fun ByteBuffer.piece(index: int): string =
    if (index < this.chunks.size) this.chunks[index]
    else this.stagedText()

// A byte is represented by a one-byte string at the portable language layer.
// This preserves all 256 values, including bytes originating in files/sockets,
// without pretending that an integer is a Unicode character.
fun ByteBuffer.appendByte(byte: string): bool {
    var appended = false
    if (byte.size == 1) {
        this.appendText(byte)
        appended = true
    }
    appended
}

fun ByteBuffer.appendByteValue(value: int): bool =
    this.appendByte(byteEncode(value))

fun ByteBuffer.appendBuffer(other: ByteBuffer): void {
    var index = 0
    while (index < other.pieceCount()) {
        this.appendText(other.piece(index))
        index = index + 1
    }
}

fun ByteBuffer.byteAt(index: int): int {
    if (index < 0 || index >= this.byteCount) return -1
    var offset = index
    for (chunk in this.chunks) {
        if (offset < chunk.size) return chunk[offset]
        offset = offset - chunk.size
    }
    this.stage[offset]
}

fun ByteBuffer.slice(begin: int, end: int): borrow(this) ByteSlice =
    ByteSlice(this, begin, end)

fun ByteBuffer.toText(): string {
    if (this.staged == 0) return ablaByteChunksJoin(this.chunks, this.byteCount)
    val pieces: array<string> = []
    for (chunk in this.chunks) pieces.append(chunk)
    pieces.append(this.stagedText())
    ablaByteChunksJoin(pieces, this.byteCount)
}

fun ByteSlice.byteAt(index: int): int {
    var result = -1
    if (this.isValid() && index >= 0 && index < this.size()) {
        result = this.buffer.byteAt(this.begin + index)
    }
    result
}

fun ByteSlice.toText(): string {
    var result = ""
    if (this.isValid()) {
        var chunkBegin = 0
        var index = 0
        while (index < this.buffer.pieceCount() && chunkBegin < this.end) {
            val chunk = this.buffer.piece(index)
            val chunkEnd = chunkBegin + chunk.size
            var overlapBegin = this.begin
            if (overlapBegin < chunkBegin) overlapBegin = chunkBegin
            var overlapEnd = this.end
            if (overlapEnd > chunkEnd) overlapEnd = chunkEnd
            if (overlapBegin < overlapEnd) {
                result = "$result${chunk.slice(
                    overlapBegin - chunkBegin,
                    overlapEnd - chunkBegin
                )}"
            }
            chunkBegin = chunkEnd
            index = index + 1
        }
    }
    result
}

// Deterministic and overflow-safe on Abla's signed 64-bit integer. This is a
// content fingerprint, not a cryptographic hash.
fun stableTextHash(text: string): int {
    var hash = 17
    var index = 0
    while (index < text.size) {
        hash = hash * 257 + text[index] + 1
        hash = hash - (hash / 1000000007) * 1000000007
        index = index + 1
    }
    hash
}

fun ByteBuffer.stableHash(): int = stableTextHash(this.toText())

fun ByteSlice.stableHash(): int = stableTextHash(this.toText())
