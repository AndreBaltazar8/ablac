// Fixed-width bit operations over Abla's signed 64-bit integer storage.
// Callers that model narrower words should mask results explicitly.

fun bitAnd(left: int, right: int): int = left & right

fun bitOr(left: int, right: int): int = left | right

fun bitXor(left: int, right: int): int = left ^ right

fun bitNot(value: int): int = ~value

fun bitShiftLeft(value: int, count: int): int =
    value << count

fun bitShiftRight(value: int, count: int): int =
    value >> count

fun bitShiftRightUnsigned(value: int, count: int): int =
    value >>> count
