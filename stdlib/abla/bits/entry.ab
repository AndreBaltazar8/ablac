// Fixed-width bit operations over Abla's signed 64-bit integer storage.
// Callers that model narrower words should mask results explicitly.

// Returns the bitwise intersection of the 64-bit patterns of `left` and `right`.
fun bitAnd(left: int, right: int): int = left & right

// Returns the bitwise union of the 64-bit patterns of `left` and `right`.
fun bitOr(left: int, right: int): int = left | right

// Returns the 64-bit pattern whose bits differ between `left` and `right`.
fun bitXor(left: int, right: int): int = left ^ right

// Returns the 64-bit pattern obtained by flipping every bit of `value`.
fun bitNot(value: int): int = ~value

// Shifts `value` left by `count` bits, discarding high bits and filling with zeros. Returns zero for counts outside 0–63.
fun bitShiftLeft(value: int, count: int): int =
    value << count

// Shifts `value` right by `count` bits, copying the sign bit into the high bits. Returns zero for counts outside 0–63.
fun bitShiftRight(value: int, count: int): int =
    value >> count

// Shifts the bit pattern of `value` right by `count` bits, filling with zeros. Returns zero for counts outside 0–63.
fun bitShiftRightUnsigned(value: int, count: int): int =
    value >>> count
