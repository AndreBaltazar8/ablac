// Fixed-width bit operations over Abla's signed 64-bit integer storage.
// Callers that model narrower words should mask results explicitly.

noescape extern:"intrinsic" fun ablaBitAnd(left: int, right: int): int

noescape extern:"intrinsic" fun ablaBitOr(left: int, right: int): int

noescape extern:"intrinsic" fun ablaBitXor(left: int, right: int): int

noescape extern:"intrinsic" fun ablaBitNot(value: int): int

noescape extern:"intrinsic" fun ablaBitShiftLeft(value: int, count: int): int

noescape extern:"intrinsic" fun ablaBitShiftRightUnsigned(
    value: int,
    count: int
): int

fun bitAnd(left: int, right: int): int = ablaBitAnd(left, right)

fun bitOr(left: int, right: int): int = ablaBitOr(left, right)

fun bitXor(left: int, right: int): int = ablaBitXor(left, right)

fun bitNot(value: int): int = ablaBitNot(value)

fun bitShiftLeft(value: int, count: int): int =
    ablaBitShiftLeft(value, count)

fun bitShiftRightUnsigned(value: int, count: int): int =
    ablaBitShiftRightUnsigned(value, count)

