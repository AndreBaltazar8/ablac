// The CUDA backend of abla/kernel (#1233): a device, its memory, and launches of the program's `@kernel` functions from the
// PTX the compiler built for them (kernelPtx()), over the CUDA driver API. The program links the driver: its abla.toml lists
// nativeLibraries = ["cuda"]. No CUDA toolkit is needed: the driver compiles the PTX for the GPU it finds.
import "abla/kernel"
import "abla/float"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

private trusted noescape extern:"c" fun cuInit(flags: u32): i32
private trusted noescape extern:"c" fun cuDeviceGet(device: i64*, ordinal: i32): i32
private trusted noescape extern:"c" fun cuCtxCreate_v2(context: i64*, flags: u32, device: i32): i32
private trusted noescape extern:"c" fun cuCtxDestroy_v2(context: i64*): i32
private trusted noescape extern:"c" fun cuCtxSynchronize(): i32
private trusted noescape extern:"c" fun cuMemAlloc_v2(address: i64*, bytes: u64): i32
private trusted noescape extern:"c" fun cuMemFree_v2(address: u64): i32
private trusted noescape extern:"c" fun cuMemcpyHtoD_v2(destination: u64, source: i64*, bytes: u64): i32
private trusted noescape extern:"c" fun cuMemcpyDtoH_v2(destination: i64*, source: u64, bytes: u64): i32
private trusted noescape extern:"c" fun cuModuleLoadData(module: i64*, data: cstring): i32
private trusted noescape extern:"c" fun cuModuleUnload(module: i64*): i32
private trusted noescape extern:"c" fun cuModuleGetFunction(function: i64*, module: i64*, name: cstring): i32
private trusted noescape extern:"c" fun cuLaunchKernel(
    function: i64*, gridX: u32, gridY: u32, gridZ: u32,
    blockX: u32, blockY: u32, blockZ: u32, sharedBytes: u32,
    stream: i64*, params: i64*, extra: i64*
): i32

/** A CUDA device with the program's kernels loaded: `error` says what the last failed call was. */
class CudaKernelDevice(val context: int, val module: int, var error: string)

/** Device memory of `bytes` bytes at `address` on `device`; freed when dropped. */
resource class CudaKernelMemory(val device: CudaKernelDevice, val address: int, val bytes: int) {
    /** Frees the device memory (cuMemFree). */
    trusted fun drop(): void {
        cuMemFree_v2(u64(this.address))
        return
    }
}

/** The memory as a kernel's f32 buffer (bytes / 4 elements). */
trusted fun CudaKernelMemory.floats(): KernelF32Buffer = KernelF32Buffer(this.address, this.bytes / 4)

/** The memory as a kernel's u32 buffer (bytes / 4 elements). */
trusted fun CudaKernelMemory.words(): KernelU32Buffer = KernelU32Buffer(this.address, this.bytes / 4)

/** The memory as a kernel's u16 buffer (bytes / 2 elements). */
trusted fun CudaKernelMemory.halves(): KernelU16Buffer = KernelU16Buffer(this.address, this.bytes / 2)

/** The memory as a kernel's byte buffer. */
trusted fun CudaKernelMemory.raw(): KernelU8Buffer = KernelU8Buffer(this.address, this.bytes)

/** Whether the driver call answered `status` 0; else records `call` and the status in `device`. */
private fun cudaKernelOk(var device: CudaKernelDevice, status: i32, call: string): bool {
    if (status == i32(0)) return true
    device.error = "$call failed with CUDA status ${int(status)}"
    false
}

/** Device `ordinal` with the program's kernels (kernelPtx()) loaded, or a device whose `error` is not "" (no driver or
 *  GPU, or PTX the driver refused). */
trusted fun cudaKernelDevice(ordinal: int = 0): CudaKernelDevice {
    val failed = CudaKernelDevice(0, 0, "")
    if (!cudaKernelOk(failed, cuInit(u32(0)), "cuInit")) return failed
    val device = nativeI64Cell(0)
    if (!cudaKernelOk(failed, cuDeviceGet(device.address, i32(ordinal)), "cuDeviceGet")) return failed
    val context = nativePointerCell(nativeNullPointer())
    if (!cudaKernelOk(failed, cuCtxCreate_v2(context.address, u32(0), i32(device.load())), "cuCtxCreate")) return failed
    val ptx = kernelPtx()
    if (ptx == "") {
        failed.error = "the program has no @kernel function"
        return failed
    }
    val module = nativePointerCell(nativeNullPointer())
    if (!cudaKernelOk(failed, cuModuleLoadData(module.address, ptx), "cuModuleLoadData")) {
        cuCtxDestroy_v2(context.load())
        return failed
    }
    CudaKernelDevice(nativePointerAddress(context.load()), nativePointerAddress(module.load()), "")
}

/** Whether the device is usable (its `error` is ""). */
fun CudaKernelDevice.ready(): bool = this.error == "" && this.context != 0

/** `bytes` bytes of device memory, or null (the reason in `error`). */
trusted fun CudaKernelDevice.allocate(bytes: int): CudaKernelMemory? {
    val address = nativeI64Cell(0)
    if (bytes <= 0 || !cudaKernelOk(this, cuMemAlloc_v2(address.address, u64(bytes)), "cuMemAlloc")) return null
    CudaKernelMemory(this, address.load(), bytes)
}

/** Copies all of `data` (at most the memory's size) to the start of `memory`. */
trusted fun CudaKernelDevice.upload(memory: CudaKernelMemory, data: NativeByteBuffer): bool {
    val bytes = if (data.capacity < memory.bytes) data.capacity else memory.bytes
    cudaKernelOk(this, cuMemcpyHtoD_v2(u64(memory.address), data.address, u64(bytes)), "cuMemcpyHtoD")
}

/** Copies the start of `memory` into all of `data` (at most the memory's size); waits for the launches before it. */
trusted fun CudaKernelDevice.download(memory: CudaKernelMemory, var data: NativeByteBuffer): bool {
    val bytes = if (data.capacity < memory.bytes) data.capacity else memory.bytes
    cudaKernelOk(this, cuMemcpyDtoH_v2(data.address, u64(memory.address), u64(bytes)), "cuMemcpyDtoH")
}

/** The parameters of one launch, in the kernel's order: a buffer is its address and its element count, an int is 64 bits,
 *  an f32 32 bits (each in an 8-byte slot, as cuLaunchKernel reads them). */
class CudaKernelArguments(val words: array<int>)

/** An empty parameter list. */
fun cudaKernelArguments(): CudaKernelArguments = CudaKernelArguments([])

/** Adds an f32 buffer parameter. */
fun CudaKernelArguments.buffer(buffer: KernelF32Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this
}

/** Adds a u32 buffer parameter. */
fun CudaKernelArguments.buffer(buffer: KernelU32Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this
}

/** Adds a u16 buffer parameter. */
fun CudaKernelArguments.buffer(buffer: KernelU16Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this
}

/** Adds a byte buffer parameter. */
fun CudaKernelArguments.buffer(buffer: KernelU8Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this
}

/** Adds an int parameter. */
fun CudaKernelArguments.integer(value: int): CudaKernelArguments {
    this.words.append(value)
    this
}

/** Adds an f32 parameter. */
fun CudaKernelArguments.float(value: f32): CudaKernelArguments {
    this.words.append(int(f32ToBits(value)))
    this
}

/** Runs kernel `name` over `groups` (x) by `groupsY` (y) groups of `groupSize` threads with `arguments`, and waits for it. */
trusted fun CudaKernelDevice.launch(name: string, groups: int, groupSize: int, arguments: CudaKernelArguments, groupsY: int = 1): bool {
    if (!this.ready()) return false
    if (groups < 1 || groups > 2147483647 || groupsY < 1 || groupsY > 65535 || groupSize < 1 || groupSize > 1024) {
        this.error = "a launch has 1 to 2^31 - 1 by 1 to 65535 groups of 1 to 1024 threads"
        return false
    }
    val function = nativePointerCell(nativeNullPointer())
    if (!cudaKernelOk(this, cuModuleGetFunction(function.address, nativePointerFromAddress(this.module), name),
        "cuModuleGetFunction($name)")) return false
    // The driver reads the parameter bytes during cuLaunchKernel.
    val count = arguments.words.size
    val values = nativeByteBuffer(if (count == 0) 8 else count * 8)
    val pointers = nativeByteBuffer(if (count == 0) 8 else count * 8)
    val base = nativePointerAddress(values.address)
    for (index in 0 until count) {
        values.storeI64(index * 8, arguments.words[index])
        pointers.storePointer(index * 8, nativePointerFromAddress(base + index * 8))
    }
    val launched = cudaKernelOk(this, cuLaunchKernel(function.load(), u32(groups), u32(groupsY), 1, u32(groupSize), 1, 1, 0,
        nativeNullPointer(), pointers.address, nativeNullPointer()), "cuLaunchKernel($name)") &&
        cudaKernelOk(this, cuCtxSynchronize(), "cuCtxSynchronize")
    values.close()
    pointers.close()
    launched
}

/** Unloads the kernels and destroys the context. */
trusted fun CudaKernelDevice.close(): void {
    if (this.module != 0) cuModuleUnload(nativePointerFromAddress(this.module))
    if (this.context != 0) cuCtxDestroy_v2(nativePointerFromAddress(this.context))
    return
}
