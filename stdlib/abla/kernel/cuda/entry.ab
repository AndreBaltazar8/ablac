// The CUDA backend of abla/kernel (#1233): a device, its memory, and launches of the program's `@kernel` functions from the
// PTX the compiler built for them (kernelPtx()), over the CUDA driver API. The program links the driver: its abla.toml lists
// nativeLibraries = ["cuda"]. No CUDA toolkit is needed: the driver compiles the PTX for the GPU it finds.
import "abla/kernel"
import "abla/float"
import "abla/text"
import "abla/array"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

private trusted noescape extern:"c" fun cuInit(flags: u32): i32
private trusted noescape extern:"c" fun cuDeviceGet(device: i64*, ordinal: i32): i32
private trusted noescape extern:"c" fun cuCtxCreate_v2(context: i64*, flags: u32, device: i32): i32
private trusted noescape extern:"c" fun cuCtxDestroy_v2(context: i64*): i32
private trusted noescape extern:"c" fun cuCtxSynchronize(): i32
private trusted noescape extern:"c" fun cuCtxPushCurrent_v2(context: i64*): i32
private trusted noescape extern:"c" fun cuCtxPopCurrent_v2(context: i64*): i32
private trusted noescape extern:"c" fun cuMemAlloc_v2(address: i64*, bytes: u64): i32
private trusted noescape extern:"c" fun cuMemFree_v2(address: u64): i32
private trusted noescape extern:"c" fun cuMemcpyHtoD_v2(destination: u64, source: i64*, bytes: u64): i32
private trusted noescape extern:"c" fun cuMemcpyDtoH_v2(destination: i64*, source: u64, bytes: u64): i32
private trusted noescape extern:"c" fun cuModuleLoadData(module: i64*, data: cstring): i32
private trusted noescape extern:"c" fun cuModuleUnload(module: i64*): i32
private trusted noescape extern:"c" fun cuModuleGetFunction(function: i64*, module: i64*, name: cstring): i32
private trusted noescape extern:"c" fun cuLaunchKernel(
    function: i64*, gridX: u32, gridY: u32, gridZ: u32,
    blockX: u32, blockY: u32, blockZ: u32, sharedBytes: u32,
    stream: i64*, params: i64*, extra: i64*
): i32
private trusted noescape extern:"c" fun cuFuncSetAttribute(function: i64*, attribute: i32, value: i32): i32

// What this module has made and not yet released, which no other code can write: the contexts (a context and its module each: the
// driver may give a closed context's handle to a later one, and a device record of the closed one must not pass for it) and the device
// allocations (a context, an address and a size each). A device or memory value is only a record of these, and a record
// that code could build or change by hand is not believed: every driver call and every launch checks it against these lists
// (an address a program made up, a context closed already, a buffer whose memory was dropped).
private val cudaOpenContexts: array<int> = []
private val cudaLiveMemory: array<int> = []

/** A CUDA device with the program's kernels loaded: `error` says what the last failed call was. Only cudaKernelDevice makes one. */
@__abla_trusted_only("error: get a device from cudaKernelDevice(); a hand-made one would send the driver calls to a context of your choosing")
class CudaKernelDevice(val context: int, val module: int, var error: string)

/** Device memory of `bytes` bytes at `address` on `device`; freed when dropped. Only CudaKernelDevice.allocate makes one. */
@__abla_trusted_only("error: get memory from CudaKernelDevice.allocate(); a hand-made one would free or hand a kernel an address of your choosing")
resource class CudaKernelMemory(val device: CudaKernelDevice, val address: int, val bytes: int) {
    /** Frees the device memory (cuMemFree) and forgets it: a buffer made from it no longer launches. */
    trusted fun drop(): void {
        if (cudaForgetMemory(this.device.context, this.address, this.bytes) && cudaEnter(this.device.context)) {
            cuMemFree_v2(u64(this.address))
            cudaLeave()
        }
        return
    }
}

// Every driver call runs with its device's context made current on this thread (pushed before, popped after): the driver allocates in,
// loads into and launches on the current context, which is otherwise the one made last, so memory of one device would be made in (and
// freed with) another's context.

/** Makes `context` current on this thread; false when the driver refused. */
private trusted fun cudaEnter(context: int): bool = cuCtxPushCurrent_v2(nativePointerFromAddress(context)) == i32(0)

/** Restores the context that was current before cudaEnter. */
private trusted fun cudaLeave(): void {
    val previous = nativePointerCell(nativeNullPointer())
    cuCtxPopCurrent_v2(previous.address)
    return
}

/** Removes the allocation (`context`, `address`, `bytes`) from the live list; false when it is not there (made by hand, freed already, or its context closed). */
private fun cudaForgetMemory(context: int, address: int, bytes: int): bool {
    var index = 0
    while (index + 2 < cudaLiveMemory.size) {
        if (cudaLiveMemory[index] == context && cudaLiveMemory[index + 1] == address && cudaLiveMemory[index + 2] == bytes) {
            cudaLiveMemory[index] = cudaLiveMemory[cudaLiveMemory.size - 3]
            cudaLiveMemory[index + 1] = cudaLiveMemory[cudaLiveMemory.size - 2]
            cudaLiveMemory[index + 2] = cudaLiveMemory[cudaLiveMemory.size - 1]
            cudaLiveMemory.removeLast()
            cudaLiveMemory.removeLast()
            cudaLiveMemory.removeLast()
            return true
        }
        index += 3
    }
    false
}

/** Whether bytes `address` to `address + bytes - 1` are inside one live allocation of `context`. */
private fun cudaMemoryHolds(context: int, address: int, bytes: int): bool {
    if (bytes < 0 || address < 0) return false
    var index = 0
    while (index + 2 < cudaLiveMemory.size) {
        val start = cudaLiveMemory[index + 1]
        val size = cudaLiveMemory[index + 2]
        if (cudaLiveMemory[index] == context && address >= start && address - start <= size && bytes <= size - (address - start)) return true
        index += 3
    }
    false
}

// The memory as a kernel's buffer argument, of the whole allocation (an empty one, address 0, when the memory is not a live allocation
// of an open device). It is a device address, which host code cannot read or write, so it is a view of its own type with no load or
// store (not a KernelF32Buffer, which host code and kernelRunCpu read as host memory), and its address is for trusted code only. It
// outlives its memory as a value, but not as a launch argument: CudaKernelDevice.launch refuses one whose bytes are no longer inside a
// live allocation (a device allocation is freed when its memory is dropped).

/** Device memory as f32 elements, for a kernel's KernelF32Buffer parameter (CudaKernelArguments.buffer); `count` elements. */
@__abla_trusted_only("error: get one from CudaKernelMemory.floats()")
@__abla_trusted_fields("address")
class CudaKernelF32View(val address: int, val count: int)

/** Device memory as u32 elements, for a kernel's KernelU32Buffer parameter; `count` elements. */
@__abla_trusted_only("error: get one from CudaKernelMemory.words()")
@__abla_trusted_fields("address")
class CudaKernelU32View(val address: int, val count: int)

/** Device memory as u16 elements, for a kernel's KernelU16Buffer parameter; `count` elements. */
@__abla_trusted_only("error: get one from CudaKernelMemory.halves()")
@__abla_trusted_fields("address")
class CudaKernelU16View(val address: int, val count: int)

/** Device memory as bytes, for a kernel's KernelU8Buffer parameter; `count` bytes. */
@__abla_trusted_only("error: get one from CudaKernelMemory.raw()")
@__abla_trusted_fields("address")
class CudaKernelU8View(val address: int, val count: int)

// A part of a view as an argument of its own: `count` elements from byte `offset` of the view on, at any byte offset (an unaligned
// one is the kernel's to handle); an empty view when they are not all inside it.

/** `count` f32 elements from byte `offset` of the view on. */
trusted fun CudaKernelF32View.at(offset: int, count: int): CudaKernelF32View =
    if (offset < 0 || count < 0 || offset > this.count * 4 || count > (this.count * 4 - offset) / 4) CudaKernelF32View(0, 0)
    else CudaKernelF32View(this.address + offset, count)

/** `count` u32 elements from byte `offset` of the view on. */
trusted fun CudaKernelU32View.at(offset: int, count: int): CudaKernelU32View =
    if (offset < 0 || count < 0 || offset > this.count * 4 || count > (this.count * 4 - offset) / 4) CudaKernelU32View(0, 0)
    else CudaKernelU32View(this.address + offset, count)

/** `count` u16 elements from byte `offset` of the view on. */
trusted fun CudaKernelU16View.at(offset: int, count: int): CudaKernelU16View =
    if (offset < 0 || count < 0 || offset > this.count * 2 || count > (this.count * 2 - offset) / 2) CudaKernelU16View(0, 0)
    else CudaKernelU16View(this.address + offset, count)

/** `count` bytes from byte `offset` of the view on. */
trusted fun CudaKernelU8View.at(offset: int, count: int): CudaKernelU8View =
    if (offset < 0 || count < 0 || offset > this.count || count > this.count - offset) CudaKernelU8View(0, 0)
    else CudaKernelU8View(this.address + offset, count)

/** The memory as a kernel's f32 buffer argument (bytes / 4 elements). */
trusted fun CudaKernelMemory.floats(): CudaKernelF32View =
    if (cudaMemoryHolds(this.device.context, this.address, this.bytes)) CudaKernelF32View(this.address, this.bytes / 4) else CudaKernelF32View(0, 0)

/** The memory as a kernel's u32 buffer argument (bytes / 4 elements). */
trusted fun CudaKernelMemory.words(): CudaKernelU32View =
    if (cudaMemoryHolds(this.device.context, this.address, this.bytes)) CudaKernelU32View(this.address, this.bytes / 4) else CudaKernelU32View(0, 0)

/** The memory as a kernel's u16 buffer argument (bytes / 2 elements). */
trusted fun CudaKernelMemory.halves(): CudaKernelU16View =
    if (cudaMemoryHolds(this.device.context, this.address, this.bytes)) CudaKernelU16View(this.address, this.bytes / 2) else CudaKernelU16View(0, 0)

/** The memory as a kernel's byte buffer argument. */
trusted fun CudaKernelMemory.raw(): CudaKernelU8View =
    if (cudaMemoryHolds(this.device.context, this.address, this.bytes)) CudaKernelU8View(this.address, this.bytes) else CudaKernelU8View(0, 0)

/** Whether the driver call answered `status` 0; else records `call` and the status in `device`. */
private trusted fun cudaKernelOk(var device: CudaKernelDevice, status: i32, call: string): bool {
    if (status == i32(0)) return true
    device.error = "$call failed with CUDA status ${int(status)}"
    false
}

/** Device `ordinal` with the program's kernels (kernelPtx()) loaded, or a device whose `error` is not "" (no driver or
 *  GPU, or PTX the driver refused). */
trusted fun cudaKernelDevice(ordinal: int = 0): CudaKernelDevice {
    val failed = CudaKernelDevice(0, 0, "")
    if (!cudaKernelOk(failed, cuInit(u32(0)), "cuInit")) return failed
    val device = nativeI64Cell(0)
    if (!cudaKernelOk(failed, cuDeviceGet(device.address, i32(ordinal)), "cuDeviceGet")) return failed
    val context = nativePointerCell(nativeNullPointer())
    if (!cudaKernelOk(failed, cuCtxCreate_v2(context.address, u32(0), i32(device.load())), "cuCtxCreate")) return failed
    val ptx = kernelPtx()
    if (ptx == "") {
        failed.error = "the program has no @kernel function"
        cuCtxDestroy_v2(context.load())
        return failed
    }
    val module = nativePointerCell(nativeNullPointer())
    if (!cudaKernelOk(failed, cuModuleLoadData(module.address, ptx), "cuModuleLoadData")) {
        cuCtxDestroy_v2(context.load())
        return failed
    }
    // cuCtxCreate made the context current; it is current again only inside each call on the device (cudaEnter).
    cudaLeave()
    val made = CudaKernelDevice(nativePointerAddress(context.load()), nativePointerAddress(module.load()), "")
    cudaOpenContexts.append(made.context)
    cudaOpenContexts.append(made.module)
    made
}

/** Whether `context` with `module` is a device cudaKernelDevice made and close has not closed. */
private fun cudaDeviceOpen(context: int, module: int): bool {
    if (context == 0) return false
    var index = 0
    while (index + 1 < cudaOpenContexts.size) {
        if (cudaOpenContexts[index] == context && cudaOpenContexts[index + 1] == module) return true
        index += 2
    }
    false
}

/** Whether the device is usable: no error, and its context was made by cudaKernelDevice and is not closed. */
fun CudaKernelDevice.ready(): bool = this.error == "" && cudaDeviceOpen(this.context, this.module)

/** `bytes` bytes of device memory, or null (the reason in `error`). */
trusted fun CudaKernelDevice.allocate(bytes: int): CudaKernelMemory? {
    if (!this.ready() || bytes <= 0 || !cudaKernelOk(this, cuCtxPushCurrent_v2(nativePointerFromAddress(this.context)), "cuCtxPushCurrent")) return null
    val address = nativeI64Cell(0)
    val allocated = cudaKernelOk(this, cuMemAlloc_v2(address.address, u64(bytes)), "cuMemAlloc")
    cudaLeave()
    if (!allocated) return null
    cudaLiveMemory.append(this.context)
    cudaLiveMemory.append(address.load())
    cudaLiveMemory.append(bytes)
    CudaKernelMemory(this, address.load(), bytes)
}

/** Copies all of `data` (at most the memory's size) to the start of `memory`; false for a closed `data`. */
trusted fun CudaKernelDevice.upload(memory: CudaKernelMemory, data: NativeByteBuffer): bool {
    if (data.closed || !this.ready() || !cudaMemoryHolds(this.context, memory.address, memory.bytes)) return false
    if (!cudaKernelOk(this, cuCtxPushCurrent_v2(nativePointerFromAddress(this.context)), "cuCtxPushCurrent")) return false
    val bytes = if (data.capacity < memory.bytes) data.capacity else memory.bytes
    val copied = cudaKernelOk(this, cuMemcpyHtoD_v2(u64(memory.address), data.address, u64(bytes)), "cuMemcpyHtoD")
    cudaLeave()
    copied
}

/** Copies the start of `memory` into all of `data` (at most the memory's size); waits for the launches before it. False for a closed
 *  `data` (its bytes are freed). */
trusted fun CudaKernelDevice.download(memory: CudaKernelMemory, var data: NativeByteBuffer): bool {
    if (data.closed || !this.ready() || !cudaMemoryHolds(this.context, memory.address, memory.bytes)) return false
    if (!cudaKernelOk(this, cuCtxPushCurrent_v2(nativePointerFromAddress(this.context)), "cuCtxPushCurrent")) return false
    val bytes = if (data.capacity < memory.bytes) data.capacity else memory.bytes
    val copied = cudaKernelOk(this, cuMemcpyDtoH_v2(data.address, u64(memory.address), u64(bytes)), "cuMemcpyDtoH")
    cudaLeave()
    copied
}

/** The parameters of one launch, in the kernel's order: a buffer is its address and its element count, an int is 64 bits,
 *  an f32 32 bits (each in an 8-byte slot, as cuLaunchKernel reads them). `kinds` has one letter per parameter (f f32 buffer, w u32
 *  buffer, h u16 buffer, r byte buffer, i int, x f32); launch checks it against the kernel's own parameters, which the compiler
 *  writes into the PTX, so an argument of the wrong kind or number is refused before the driver reads it. */
class CudaKernelArguments(val words: array<int>, var kinds: string)

/** An empty parameter list. */
fun cudaKernelArguments(): CudaKernelArguments = CudaKernelArguments([], "")

/** Adds an f32 buffer parameter (a launch refuses one that is not inside live memory of its device). */
trusted fun CudaKernelArguments.buffer(buffer: KernelF32Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this.kinds = "${this.kinds}f"
    this
}

/** Adds a u32 buffer parameter. */
trusted fun CudaKernelArguments.buffer(buffer: KernelU32Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this.kinds = "${this.kinds}w"
    this
}

/** Adds a u16 buffer parameter. */
trusted fun CudaKernelArguments.buffer(buffer: KernelU16Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this.kinds = "${this.kinds}h"
    this
}

/** Adds a byte buffer parameter. */
trusted fun CudaKernelArguments.buffer(buffer: KernelU8Buffer): CudaKernelArguments {
    this.words.append(buffer.address)
    this.words.append(buffer.count)
    this.kinds = "${this.kinds}r"
    this
}

/** Adds device memory seen as f32 elements (CudaKernelMemory.floats()), for a kernel's KernelF32Buffer parameter. */
trusted fun CudaKernelArguments.buffer(view: CudaKernelF32View): CudaKernelArguments {
    this.words.append(view.address)
    this.words.append(view.count)
    this.kinds = "${this.kinds}f"
    this
}

/** Adds device memory seen as u32 elements (CudaKernelMemory.words()), for a kernel's KernelU32Buffer parameter. */
trusted fun CudaKernelArguments.buffer(view: CudaKernelU32View): CudaKernelArguments {
    this.words.append(view.address)
    this.words.append(view.count)
    this.kinds = "${this.kinds}w"
    this
}

/** Adds device memory seen as u16 elements (CudaKernelMemory.halves()), for a kernel's KernelU16Buffer parameter. */
trusted fun CudaKernelArguments.buffer(view: CudaKernelU16View): CudaKernelArguments {
    this.words.append(view.address)
    this.words.append(view.count)
    this.kinds = "${this.kinds}h"
    this
}

/** Adds device memory seen as bytes (CudaKernelMemory.raw()), for a kernel's KernelU8Buffer parameter. */
trusted fun CudaKernelArguments.buffer(view: CudaKernelU8View): CudaKernelArguments {
    this.words.append(view.address)
    this.words.append(view.count)
    this.kinds = "${this.kinds}r"
    this
}

/** Adds each of `views` in order, for a `KernelBuffers<KernelF32Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(views: array<CudaKernelF32View>): CudaKernelArguments {
    for (view in views) {
        val _added = this.buffer(view)
    }
    this
}

/** Adds each of `views` in order, for a `KernelBuffers<KernelU32Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(views: array<CudaKernelU32View>): CudaKernelArguments {
    for (view in views) {
        val _added = this.buffer(view)
    }
    this
}

/** Adds each of `views` in order, for a `KernelBuffers<KernelU16Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(views: array<CudaKernelU16View>): CudaKernelArguments {
    for (view in views) {
        val _added = this.buffer(view)
    }
    this
}

/** Adds each of `views` in order, for a `KernelBuffers<KernelU8Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(views: array<CudaKernelU8View>): CudaKernelArguments {
    for (view in views) {
        val _added = this.buffer(view)
    }
    this
}

/** Adds each of `buffers` in order, for a `KernelBuffers<KernelF32Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(buffers: array<KernelF32Buffer>): CudaKernelArguments {
    for (buffer in buffers) {
        val _added = this.buffer(buffer)
    }
    this
}

/** Adds each of `buffers` in order, for a `KernelBuffers<KernelU32Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(buffers: array<KernelU32Buffer>): CudaKernelArguments {
    for (buffer in buffers) {
        val _added = this.buffer(buffer)
    }
    this
}

/** Adds each of `buffers` in order, for a `KernelBuffers<KernelU16Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(buffers: array<KernelU16Buffer>): CudaKernelArguments {
    for (buffer in buffers) {
        val _added = this.buffer(buffer)
    }
    this
}

/** Adds each of `buffers` in order, for a `KernelBuffers<KernelU8Buffer, N>` parameter (exactly N of them). */
fun CudaKernelArguments.buffers(buffers: array<KernelU8Buffer>): CudaKernelArguments {
    for (buffer in buffers) {
        val _added = this.buffer(buffer)
    }
    this
}

/** Adds an int parameter. */
fun CudaKernelArguments.integer(value: int): CudaKernelArguments {
    this.words.append(value)
    this.kinds = "${this.kinds}i"
    this
}

/** Adds an f32 parameter. */
fun CudaKernelArguments.float(value: f32): CudaKernelArguments {
    this.words.append(int(f32ToBits(value)))
    this.kinds = "${this.kinds}x"
    this
}

/** The parameter kinds the compiler wrote for kernel `name` into the PTX ("// abla-kernel <name> <kinds>"), or "?" when there is none. */
private fun cudaKernelSignature(name: string): string {
    val prefix = "// abla-kernel $name "
    for (line in kernelPtx().split("\n")) {
        if (line.startsWith(prefix)) return line.slice(prefix.size, line.size).trim()
    }
    "?"
}

/** The most dynamic shared memory a group of a launch takes (the 4090's per-block limit, 99 KiB; the driver refuses more on smaller GPUs). */
val CUDA_KERNEL_DYNAMIC_SHARED_MAX = 101376

/** The most threads per group kernel `name` declares with @launchBounds ("// abla-kernel-bounds <name> <threads>" in the PTX), or
 *  1024 (a group's most) when it declares none. */
private fun cudaKernelBound(name: string): int {
    val prefix = "// abla-kernel-bounds $name "
    for (line in kernelPtx().split("\n")) {
        if (line.startsWith(prefix)) {
            var value = 0
            for (byte in line.slice(prefix.size, line.size).trim()) value = value * 10 + byte - 48
            return value
        }
    }
    1024
}

/** Why `arguments` do not fit kernel `name` on `device` (not the kernel's parameters in number or kind, or a buffer not inside live device
 *  memory of this device), or "" when they do. */
private fun cudaKernelArgumentProblem(device: CudaKernelDevice, name: string, arguments: CudaKernelArguments): string {
    val signature = cudaKernelSignature(name)
    if (signature == "?") return "no kernel named $name in the program's PTX"
    if (signature != arguments.kinds) return "kernel $name takes parameters '$signature' (f/w/h/r buffers, i int, x f32), not '${arguments.kinds}'"
    var word = 0
    for (kind in signature) {
        if (kind == 105 || kind == 120) {
            word += 1
        } else {
            val size = if (kind == 114) 1 else if (kind == 104) 2 else 4
            if (word + 1 >= arguments.words.size) return "kernel $name: a buffer argument is missing its count"
            val address = arguments.words[word]
            val count = arguments.words[word + 1]
            // An empty buffer (count 0) is never read or written, whatever its address.
            if (count < 0 || count > 2305843009213693951 || (count > 0 && !cudaMemoryHolds(device.context, address, count * size))) {
                return "kernel $name: a buffer argument is not inside live memory of this device (freed, from another device, or made up)"
            }
            word += 2
        }
    }
    if (word != arguments.words.size) return "kernel $name: the argument words do not match their kinds"
    ""
}

/** Runs kernel `name` over `groups` (x) by `groupsY` (y) groups of `groupSize` threads with `arguments`, and waits for it. The arguments
 *  must be the kernel's parameters in kind and number, each buffer inside live memory of this device, and `groupSize` at most its
 *  @launchBounds (else false, the reason in `error`). `sharedBytes` is each group's dynamic shared memory (kernelSharedF32Dynamic), 0 to
 *  CUDA_KERNEL_DYNAMIC_SHARED_MAX bytes. */
trusted fun CudaKernelDevice.launch(name: string, groups: int, groupSize: int, arguments: CudaKernelArguments, groupsY: int = 1,
    sharedBytes: int = 0): bool {
    if (!this.ready()) return false
    if (groups < 1 || groups > 2147483647 || groupsY < 1 || groupsY > 65535 || groupSize < 1 || groupSize > 1024) {
        this.error = "a launch has 1 to 2^31 - 1 by 1 to 65535 groups of 1 to 1024 threads"
        return false
    }
    if (sharedBytes < 0 || sharedBytes > CUDA_KERNEL_DYNAMIC_SHARED_MAX) {
        this.error = "a group has 0 to $CUDA_KERNEL_DYNAMIC_SHARED_MAX bytes of dynamic shared memory, not $sharedBytes"
        return false
    }
    val bound = cudaKernelBound(name)
    if (groupSize > bound) {
        this.error = "kernel $name declares @launchBounds($bound): a launch of $groupSize threads per group is refused"
        return false
    }
    val problem = cudaKernelArgumentProblem(this, name, arguments)
    if (problem != "") {
        this.error = problem
        return false
    }
    if (!cudaKernelOk(this, cuCtxPushCurrent_v2(nativePointerFromAddress(this.context)), "cuCtxPushCurrent")) return false
    val function = nativePointerCell(nativeNullPointer())
    if (!cudaKernelOk(this, cuModuleGetFunction(function.address, nativePointerFromAddress(this.module), name),
        "cuModuleGetFunction($name)")) {
        cudaLeave()
        return false
    }
    // Above 48 KiB a kernel has to ask for its dynamic shared memory.
    if (sharedBytes > 49152 && !cudaKernelOk(this, cuFuncSetAttribute(function.load(), i32(8), i32(sharedBytes)),
        "cuFuncSetAttribute($name, dynamic shared memory)")) {
        cudaLeave()
        return false
    }
    // The driver reads the parameter bytes during cuLaunchKernel.
    val count = arguments.words.size
    val values = nativeByteBuffer(if (count == 0) 8 else count * 8)
    val pointers = nativeByteBuffer(if (count == 0) 8 else count * 8)
    val base = nativePointerAddress(values.address)
    for (index in 0 until count) {
        values.storeI64(index * 8, arguments.words[index])
        pointers.storePointer(index * 8, nativePointerFromAddress(base + index * 8))
    }
    val launched = cudaKernelOk(this, cuLaunchKernel(function.load(), u32(groups), u32(groupsY), 1, u32(groupSize), 1, 1, u32(sharedBytes),
        nativeNullPointer(), pointers.address, nativeNullPointer()), "cuLaunchKernel($name)") &&
        cudaKernelOk(this, cuCtxSynchronize(), "cuCtxSynchronize")
    cudaLeave()
    values.close()
    pointers.close()
    launched
}

/** Unloads the kernels and destroys the context, also when a call failed on it (a refused launch leaves `error` set, and its
 *  context still holds driver resources such as BAR1 space). */
trusted fun CudaKernelDevice.close(): void {
    if (!cudaDeviceOpen(this.context, this.module)) return
    // The context goes first from the open list, so a second close, or a launch or allocation on this device, finds it closed; its
    // allocations go with it (the driver frees them with the context).
    var kept: array<int> = []
    var index = 0
    while (index + 2 < cudaLiveMemory.size) {
        if (cudaLiveMemory[index] != this.context) {
            kept.append(cudaLiveMemory[index])
            kept.append(cudaLiveMemory[index + 1])
            kept.append(cudaLiveMemory[index + 2])
        }
        index += 3
    }
    while (cudaLiveMemory.size > 0) cudaLiveMemory.removeLast()
    for (word in kept) cudaLiveMemory.append(word)
    var open: array<int> = []
    index = 0
    while (index + 1 < cudaOpenContexts.size) {
        if (cudaOpenContexts[index] != this.context) {
            open.append(cudaOpenContexts[index])
            open.append(cudaOpenContexts[index + 1])
        }
        index += 2
    }
    while (cudaOpenContexts.size > 0) cudaOpenContexts.removeLast()
    for (word in open) cudaOpenContexts.append(word)
    if (this.module != 0 && cudaEnter(this.context)) {
        cuModuleUnload(nativePointerFromAddress(this.module))
        cudaLeave()
    }
    cuCtxDestroy_v2(nativePointerFromAddress(this.context))
    this.error = "the device is closed"
    return
}
