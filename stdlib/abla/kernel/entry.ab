// Kernels written in Abla (#1233, docs/design/gpu-kernels.md). A `@kernel` function is ordinary Abla restricted to what a GPU
// can run (scalars, the buffers below, arithmetic, branches, loops, calls to such functions); the compiler checks it
// (`kernel.<rule>`) and also compiles it for each GPU backend (CUDA: kernelPtx()). The same function runs on the CPU through
// kernelRunCpu, where this module answers the ids.
//
// A kernel reads and writes device memory only through KernelF32Buffer, KernelU32Buffer, KernelU16Buffer and KernelU8Buffer, each an address and an element
// count: an index outside the buffer loads 0 and stores nothing, on every backend. On CUDA a buffer is two kernel parameters,
// its device address and its count (u64 each).
import "abla/float"
import "abla/unsafe/memory/raw"
import "abla/unsafe/memory"
import "abla/simd"
import "abla/math"
import "abla/process/exit"

/** A buffer of `count` f32 values at `address` (host memory on the CPU, device memory on a GPU), as a kernel sees it. */
@__abla_trusted_only("error: take one from CudaKernelMemory.floats(), or build it in a trusted function that owns the memory and keeps it alive")
class KernelF32Buffer(val address: int, val count: int)

/** A buffer of `count` u32 values at `address`, as a kernel sees it; its elements read as ints from 0 to 2^32 - 1. */
@__abla_trusted_only("error: take one from CudaKernelMemory.words(), or build it in a trusted function that owns the memory and keeps it alive")
class KernelU32Buffer(val address: int, val count: int)

/** The number of elements of the buffer (0 for an empty one, which a kernel can take for "none"). */
fun KernelF32Buffer.size(): int = this.count

/** The number of elements of the buffer. */
fun KernelU32Buffer.size(): int = this.count

/** Element `index` of the buffer, or 0 when `index` is outside it. */
trusted fun KernelF32Buffer.load(index: int): f32 =
    if (index >= 0 && index < this.count) f32FromBits(u32(ablaUnsafeLoadU32(nativePointerFromAddress(this.address + index * 4)))) else f32(0.0)

/** Stores `value` as element `index`; does nothing when `index` is outside the buffer. */
trusted fun KernelF32Buffer.store(index: int, value: f32): void {
    if (index >= 0 && index < this.count) ablaUnsafeStoreU32(nativePointerFromAddress(this.address + index * 4), int(f32ToBits(value)))
    return
}

/** Element `index` of the buffer (0 to 2^32 - 1), or 0 when `index` is outside it. */
trusted fun KernelU32Buffer.load(index: int): int =
    if (index >= 0 && index < this.count) ablaUnsafeLoadU32(nativePointerFromAddress(this.address + index * 4)) else 0

/** Stores the low 32 bits of `value` as element `index`; does nothing when `index` is outside the buffer. */
trusted fun KernelU32Buffer.store(index: int, value: int): void {
    if (index >= 0 && index < this.count) ablaUnsafeStoreU32(nativePointerFromAddress(this.address + index * 4), value)
    return
}

/** A buffer of `count` u16 values at `address`, as a kernel sees it (GGML Q8_0 blocks are 17 of them: an f16 scale and 32
 *  bytes); its elements read as ints from 0 to 65535. */
@__abla_trusted_only("error: take one from CudaKernelMemory.halves(), or build it in a trusted function that owns the memory and keeps it alive")
class KernelU16Buffer(val address: int, val count: int)

/** The number of elements of the buffer. */
fun KernelU16Buffer.size(): int = this.count

/** Element `index` of the buffer (0 to 65535), or 0 when `index` is outside it. */
trusted fun KernelU16Buffer.load(index: int): int =
    if (index >= 0 && index < this.count) ablaUnsafeLoadU16(nativePointerFromAddress(this.address + index * 2)) else 0

/** Stores the low 16 bits of `value` as element `index`; does nothing when `index` is outside the buffer. */
trusted fun KernelU16Buffer.store(index: int, value: int): void {
    if (index >= 0 && index < this.count) ablaUnsafeStoreU16(nativePointerFromAddress(this.address + index * 2), value)
    return
}

/** A buffer of `count` bytes at `address`, as a kernel sees it: packed data at any alignment (GGML blocks of 34 or 36
 *  bytes), read a byte, two or four at a time. */
@__abla_trusted_only("error: take one from CudaKernelMemory.raw(), or build it in a trusted function that owns the memory and keeps it alive")
class KernelU8Buffer(val address: int, val count: int)

/** The number of bytes of the buffer. */
fun KernelU8Buffer.size(): int = this.count

/** Byte `index` (0 to 255), or 0 when `index` is outside the buffer. */
trusted fun KernelU8Buffer.load(index: int): int =
    if (index >= 0 && index < this.count) ablaUnsafeLoadU8(nativePointerFromAddress(this.address + index)) else 0

/** Stores the low 8 bits of `value` as byte `index`; does nothing when `index` is outside the buffer. */
trusted fun KernelU8Buffer.store(index: int, value: int): void {
    if (index >= 0 && index < this.count) ablaUnsafeStoreU8(nativePointerFromAddress(this.address + index), value)
    return
}

/** The little-endian u16 at bytes `index` and `index + 1`, at any alignment (bytes outside the buffer count 0). On a GPU
 *  an even address is one 16-bit load. */
fun KernelU8Buffer.loadU16(index: int): int = this.load(index) | (this.load(index + 1) << 8)

/** The little-endian u32 at bytes `index` to `index + 3`, at any alignment (bytes outside the buffer count 0). On a GPU a
 *  4-byte-aligned address is one 32-bit load and an even one two 16-bit loads. */
fun KernelU8Buffer.loadU32(index: int): int =
    this.load(index) | (this.load(index + 1) << 8) | (this.load(index + 2) << 16) | (this.load(index + 3) << 24)

/** Byte `index` as a signed byte, -128 to 127 (GGML's Q8 quants), or 0 when `index` is outside the buffer. */
fun KernelU8Buffer.loadS8(index: int): int = (this.load(index) ^ 128) - 128

/** The four little-endian u32 at bytes `index` to `index + 15`, at any alignment (bytes outside the buffer count 0), as
 *  loadU32 reads each. A trusted kernel that shows the 16 bytes are inside and 16-byte aligned reads them in one load
 *  with loadU32x4Aligned. */
fun KernelU8Buffer.loadU32x4(index: int): u32x4 =
    u32x4(u32(this.loadU32(index)), u32(this.loadU32(index + 4)), u32(this.loadU32(index + 8)), u32(this.loadU32(index + 12)))

/** Elements `index` to `index + 3` as one vector, each 0 when outside the buffer. On a GPU, four elements inside the buffer
 *  at a 16-byte-aligned address are one 16-byte load (CUDA's float4); anywhere else, four loads. */
fun KernelF32Buffer.load4(index: int): f32x4 =
    f32x4(this.load(index), this.load(index + 1), this.load(index + 2), this.load(index + 3))

/** Elements `index` to `index + 3` as one vector, each 0 when outside the buffer. On a GPU, four elements inside the buffer
 *  at a 16-byte-aligned address are one 16-byte load (CUDA's uint4); anywhere else, four loads. */
fun KernelU32Buffer.loadU32x4(index: int): u32x4 =
    u32x4(u32(this.load(index)), u32(this.load(index + 1)), u32(this.load(index + 2)), u32(this.load(index + 3)))

/** Stores the four lanes of `value` as elements `index` to `index + 3`, each only when inside the buffer. On a GPU, four
 *  elements inside the buffer at a 16-byte-aligned address are one 16-byte store; anywhere else, four stores. */
fun KernelU32Buffer.storeU32x4(index: int, value: u32x4): void {
    for (lane in 0 until 4) this.store(index + lane, int(value.get(lane)))
}

/** Whether element `index`'s address is a multiple of `bytes` (a power of two), so a kernel can pick its aligned fast
 *  path once (a buffer may start anywhere: an offset into device memory). Reads no memory. */
fun KernelF32Buffer.isAligned(index: int, bytes: int): bool = (this.address + index * 4) % bytes == 0

/** Whether element `index`'s address is a multiple of `bytes` (see KernelF32Buffer.isAligned). */
fun KernelU32Buffer.isAligned(index: int, bytes: int): bool = (this.address + index * 4) % bytes == 0

/** Whether element `index`'s address is a multiple of `bytes` (see KernelF32Buffer.isAligned). */
fun KernelU16Buffer.isAligned(index: int, bytes: int): bool = (this.address + index * 2) % bytes == 0

/** Whether byte `index`'s address is a multiple of `bytes` (see KernelF32Buffer.isAligned). */
fun KernelU8Buffer.isAligned(index: int, bytes: int): bool = (this.address + index) % bytes == 0

// The unchecked fast path (#143): loads a trusted kernel makes where it has shown the index is inside the buffer (and,
// for the wide ones, aligned), so the GPU spends no compare and branch on it. On a GPU nothing checks: an index outside
// reads whatever memory is there, or faults the launch. The CPU backend checks anyway and stops the program, so a CPU run
// of the same kernel finds a wrong index.

/** Element `index`, which the caller guarantees is inside the buffer (see the unchecked fast path above). */
@__abla_trusted_only("error: use load(index), which checks the index; loadUnchecked is for trusted kernels that show it is inside")
trusted fun KernelF32Buffer.loadUnchecked(index: int): f32 {
    if (index < 0 || index >= this.count) panic("KernelF32Buffer.loadUnchecked: index $index outside a buffer of ${this.count}")
    f32FromBits(u32(ablaUnsafeLoadU32(nativePointerFromAddress(this.address + index * 4))))
}

/** Element `index` (0 to 2^32 - 1), which the caller guarantees is inside the buffer (see the unchecked fast path). */
@__abla_trusted_only("error: use load(index), which checks the index; loadUnchecked is for trusted kernels that show it is inside")
trusted fun KernelU32Buffer.loadUnchecked(index: int): int {
    if (index < 0 || index >= this.count) panic("KernelU32Buffer.loadUnchecked: index $index outside a buffer of ${this.count}")
    ablaUnsafeLoadU32(nativePointerFromAddress(this.address + index * 4))
}

/** Element `index` (0 to 65535), which the caller guarantees is inside the buffer (see the unchecked fast path). */
@__abla_trusted_only("error: use load(index), which checks the index; loadUnchecked is for trusted kernels that show it is inside")
trusted fun KernelU16Buffer.loadUnchecked(index: int): int {
    if (index < 0 || index >= this.count) panic("KernelU16Buffer.loadUnchecked: index $index outside a buffer of ${this.count}")
    ablaUnsafeLoadU16(nativePointerFromAddress(this.address + index * 2))
}

/** Byte `index` (0 to 255), which the caller guarantees is inside the buffer (see the unchecked fast path). */
@__abla_trusted_only("error: use load(index), which checks the index; loadUnchecked is for trusted kernels that show it is inside")
trusted fun KernelU8Buffer.loadUnchecked(index: int): int {
    if (index < 0 || index >= this.count) panic("KernelU8Buffer.loadUnchecked: index $index outside a buffer of ${this.count}")
    ablaUnsafeLoadU8(nativePointerFromAddress(this.address + index))
}

/** Elements `index` to `index + 3` as one 16-byte load, which the caller guarantees are inside the buffer at a 16-byte-
 *  aligned address (see the unchecked fast path; a misaligned address faults the launch on a GPU). */
@__abla_trusted_only("error: use load4(index), which checks the index and the alignment; load4Aligned is for trusted kernels that show both")
trusted fun KernelF32Buffer.load4Aligned(index: int): f32x4 {
    if (index < 0 || index > this.count - 4 || (this.address + index * 4) % 16 != 0) {
        panic("KernelF32Buffer.load4Aligned: index $index outside a buffer of ${this.count} or not 16-byte aligned")
    }
    f32x4(this.loadUnchecked(index), this.loadUnchecked(index + 1), this.loadUnchecked(index + 2), this.loadUnchecked(index + 3))
}

/** The little-endian u16 at byte `index`, one 2-byte load: the caller guarantees both bytes are inside the buffer at an
 *  even address (see the unchecked fast path). */
@__abla_trusted_only("error: use loadU16(index), which checks the index and the alignment; loadU16Aligned is for trusted kernels that show both")
trusted fun KernelU8Buffer.loadU16Aligned(index: int): int {
    if (index < 0 || index > this.count - 2 || (this.address + index) % 2 != 0) {
        panic("KernelU8Buffer.loadU16Aligned: index $index outside a buffer of ${this.count} or not 2-byte aligned")
    }
    ablaUnsafeLoadU16(nativePointerFromAddress(this.address + index))
}

/** The little-endian u32 at byte `index`, one 4-byte load: the caller guarantees the four bytes are inside the buffer at a
 *  4-byte-aligned address (see the unchecked fast path). */
@__abla_trusted_only("error: use loadU32(index), which checks the index and the alignment; loadU32Aligned is for trusted kernels that show both")
trusted fun KernelU8Buffer.loadU32Aligned(index: int): int {
    if (index < 0 || index > this.count - 4 || (this.address + index) % 4 != 0) {
        panic("KernelU8Buffer.loadU32Aligned: index $index outside a buffer of ${this.count} or not 4-byte aligned")
    }
    ablaUnsafeLoadU32(nativePointerFromAddress(this.address + index))
}

/** Elements `index` to `index + 3` as one 16-byte load, which the caller guarantees are inside the buffer at a 16-byte-
 *  aligned address (see the unchecked fast path). */
@__abla_trusted_only("error: use loadU32x4(index), which checks the index and the alignment; loadU32x4Aligned is for trusted kernels that show both")
trusted fun KernelU32Buffer.loadU32x4Aligned(index: int): u32x4 {
    if (index < 0 || index > this.count - 4 || (this.address + index * 4) % 16 != 0) {
        panic("KernelU32Buffer.loadU32x4Aligned: index $index outside a buffer of ${this.count} or not 16-byte aligned")
    }
    u32x4(u32(this.loadUnchecked(index)), u32(this.loadUnchecked(index + 1)), u32(this.loadUnchecked(index + 2)),
        u32(this.loadUnchecked(index + 3)))
}

/** The four little-endian u32 at bytes `index` to `index + 15` as one 16-byte load: the caller guarantees the 16 bytes are
 *  inside the buffer at a 16-byte-aligned address (see the unchecked fast path). */
@__abla_trusted_only("error: use loadU32x4(index), which checks the index and the alignment; loadU32x4Aligned is for trusted kernels that show both")
trusted fun KernelU8Buffer.loadU32x4Aligned(index: int): u32x4 {
    if (index < 0 || index > this.count - 16 || (this.address + index) % 16 != 0) {
        panic("KernelU8Buffer.loadU32x4Aligned: index $index outside a buffer of ${this.count} or not 16-byte aligned")
    }
    val at = this.address + index
    u32x4(u32(ablaUnsafeLoadU32(nativePointerFromAddress(at))), u32(ablaUnsafeLoadU32(nativePointerFromAddress(at + 4))),
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(at + 8))), u32(ablaUnsafeLoadU32(nativePointerFromAddress(at + 12))))
}

// Where the CPU backend is in a launch: the thread kernelRunCpu is running. One launch at a time. Private to this module: its shared
// memory slots are addresses kernelShared hands out as buffers, so code that could write them could read and write any address.
private class KernelCpuState(
    var group: int, var groupY: int, var local: int, var groupSize: int,
    // The group's shared memory: slot n is the n-th kernelShared call of the thread being run (sharedNext counts them).
    var sharedNext: int, val sharedAddresses: array<int>, val sharedBytes: array<int>
)

// The CPU backend's launch position.
private val kernelCpuState = KernelCpuState(0, 0, 0, 1, 0, [], [])

/** The thread's index in the whole launch: group * group size + local index. */
fun kernelGlobalId(): int = kernelCpuState.group * kernelCpuState.groupSize + kernelCpuState.local

/** The thread's index in its group (workgroup, CUDA block). */
fun kernelLocalId(): int = kernelCpuState.local

/** The group's index in the launch (along x, the dimension the other ids count in). */
fun kernelGroupId(): int = kernelCpuState.group

/** The group's index along y in a two-dimensional launch (kernelRunCpuGrid; CUDA's blockIdx.y); 0 in a one-dimensional one. */
fun kernelGroupIdY(): int = kernelCpuState.groupY

/** The number of threads in a group. */
fun kernelGroupSize(): int = kernelCpuState.groupSize

/** The thread's lane in its subgroup (CUDA warp). On the CPU a subgroup is one thread: 0. */
fun kernelSubgroupLane(): int = 0

/** The number of threads in a subgroup: 32 on CUDA, 1 on the CPU. A kernel written for any size runs on every backend. */
fun kernelSubgroupSize(): int = 1

/** The sum of `value` over the thread's subgroup, in every lane. Every lane of the subgroup must call it together. On the
 *  CPU, `value` itself. */
fun kernelSubgroupSum(value: f32): f32 = value

/** The workgroup's shared memory for `count` f32 values: every thread of a group gets the same memory, which a GPU keeps on
 *  the chip (CUDA __shared__). Each call in a kernel is its own array, and `count` must be a compile-time constant (a
 *  literal, or a value the compiler folds to one). Its contents start undefined; share them across threads with
 *  kernelBarrier. */
trusted fun kernelSharedF32(count: int): KernelF32Buffer = KernelF32Buffer(kernelCpuShared(count, 4), count)

/** The workgroup's shared memory for `count` u32 values (see kernelSharedF32). */
trusted fun kernelSharedU32(count: int): KernelU32Buffer = KernelU32Buffer(kernelCpuShared(count, 4), count)

/** The most elements a kernelShared call takes on the CPU backend (4 MiB of 4-byte elements, far above a GPU's 48 KiB per group). */
val KERNEL_SHARED_MAX_ELEMENTS = 1048576

/** The CPU backend's shared memory: the slot of the current thread's next kernelShared call, kept across launches. The count is
 *  checked before it is multiplied by the element size: a count of 2^62 + 1 would wrap to 4 bytes while the buffer kept
 *  claiming 2^62 + 1 elements. */
private trusted fun kernelCpuShared(count: int, elementBytes: int): int {
    if (count < 0 || count > KERNEL_SHARED_MAX_ELEMENTS) panic("kernelShared: a group's shared memory has 0 to $KERNEL_SHARED_MAX_ELEMENTS elements, not $count")
    val bytes = count * elementBytes
    val slot = kernelCpuState.sharedNext
    kernelCpuState.sharedNext = slot + 1
    if (slot < kernelCpuState.sharedAddresses.size && kernelCpuState.sharedBytes[slot] >= bytes) {
        return kernelCpuState.sharedAddresses[slot]
    }
    val address = nativePointerAddress(ablaUnsafeAllocate(if (bytes > 0) bytes else 4))
    if (slot < kernelCpuState.sharedAddresses.size) {
        kernelCpuState.sharedAddresses[slot] = address
        kernelCpuState.sharedBytes[slot] = bytes
    } else {
        kernelCpuState.sharedAddresses.append(address)
        kernelCpuState.sharedBytes.append(bytes)
    }
    address
}

/** Adds the low 32 bits of `value` to element `index` as one indivisible step, so threads of every group may add to the
 *  same element, and gives the element as it was before (0, adding nothing, when `index` is outside the buffer). It orders
 *  no other memory access: to hand results between groups, write them, kernelFence(), then add (CUDA's atomicAdd and
 *  __threadfence). The CPU backend runs one thread at a time, so there it is a plain read and write. */
fun KernelU32Buffer.atomicAdd(index: int, value: int): int {
    if (index < 0 || index >= this.count) return 0
    val previous = this.load(index)
    this.store(index, previous + value)
    previous
}

/** `value` from the lane whose index is this lane's xor `distance` (CUDA's __shfl_xor_sync over the whole subgroup), or this
 *  lane's own `value` when that lane is outside the subgroup; every lane must call it together. A butterfly of these
 *  (distances 16, 8, ..., 1) combines a value across the subgroup in any way a kernel needs, a (score, index) maximum
 *  with ties, say. On the CPU, where a subgroup is one thread, `value`. */
fun kernelSubgroupShuffleXor(value: f32, distance: int): f32 = value

/** kernelSubgroupShuffleXor for an int (all 64 bits move). */
fun kernelSubgroupShuffleXorInt(value: int, distance: int): int = value

/** The `value` of lane `lane` of the subgroup (CUDA's __shfl_sync; taken modulo the subgroup size), every lane calling it
 *  together: kernelSubgroupShuffle(v, 0) gives every lane lane 0's. On the CPU, where a subgroup is one thread, `value`. */
fun kernelSubgroupShuffle(value: f32, lane: int): f32 = value

/** kernelSubgroupShuffle for an int (all 64 bits move). */
fun kernelSubgroupShuffleInt(value: int, lane: int): int = value

/** The `value` of the lane `delta` below this one (CUDA's __shfl_up_sync), or this lane's own when there is none; every
 *  lane calls it together. On the CPU, where a subgroup is one thread, `value`. */
fun kernelSubgroupShuffleUp(value: f32, delta: int): f32 = value

/** kernelSubgroupShuffleUp for an int (all 64 bits move). */
fun kernelSubgroupShuffleUpInt(value: int, delta: int): int = value

/** The `value` of the lane `delta` above this one (CUDA's __shfl_down_sync), or this lane's own when there is none; every
 *  lane calls it together. On the CPU, where a subgroup is one thread, `value`. */
fun kernelSubgroupShuffleDown(value: f32, delta: int): f32 = value

/** kernelSubgroupShuffleDown for an int (all 64 bits move). */
fun kernelSubgroupShuffleDownInt(value: int, delta: int): int = value

/** The lanes of the subgroup whose `condition` holds, as a mask: bit l for lane l, 0 to 2^32 - 1 (CUDA's __ballot_sync);
 *  every lane calls it together. On the CPU, 1 or 0. */
fun kernelSubgroupBallot(condition: bool): int = if (condition) 1 else 0

/** Whether `condition` holds on any lane of the subgroup (CUDA's __any_sync); every lane calls it together. */
fun kernelSubgroupAny(condition: bool): bool = condition

/** Whether `condition` holds on every lane of the subgroup (CUDA's __all_sync); every lane calls it together. */
fun kernelSubgroupAll(condition: bool): bool = condition

/** The lanes of the subgroup wait for each other, their earlier shared-memory writes seen by all (CUDA's __syncwarp()).
 *  Nothing on the CPU, where a subgroup is one thread. */
fun kernelSubgroupBarrier(): void {
    return
}

/** The number of zero bits below the lowest set bit of `value`, 64 when `value` is 0: the lowest lane of a ballot (CUDA's
 *  __ffs(x) - 1 for x != 0). */
fun kernelCountTrailingZeros(value: int): int {
    if (value == 0) return 64
    var count = 0
    var rest = value
    while ((rest & 1) == 0) {
        rest = rest >>> 1
        count = count + 1
    }
    count
}

/** Makes this thread's device-memory writes before it visible to every group before any of its writes after it (CUDA
 *  __threadfence). Nothing on the CPU backend, which runs one thread at a time. */
fun kernelFence(): void {
    return
}

/** Waits until every thread of the group has reached it, and makes their writes to shared and device memory visible to
 *  each other (CUDA __syncthreads). Every thread of the group must reach the same barriers. The CPU backend runs a group's
 *  threads one after another, so there a barrier holds only for groups of one thread: it does nothing then, and stops the
 *  program in a larger group. A kernel that strides by kernelGroupSize() runs on both. */
fun kernelBarrier(): void {
    if (kernelCpuState.groupSize > 1) panic("kernelBarrier: the CPU backend runs a group's threads one after another, so it needs groups of one thread")
    return
}

/** The largest `value` over the thread's subgroup, in every lane (every lane must call it together). On the CPU, `value`. */
fun kernelSubgroupMax(value: f32): f32 = value

/** The square root of `value` (correctly rounded on every backend: through f64 on the CPU). */
fun kernelSqrt(value: f32): f32 = ablaConvertF64ToF32(sqrt(ablaConvertF32ToF64(value)))

/**
 * An approximation of 1 / sqrt(`value`): on CUDA the GPU's rsqrt.approx.f32 (CUDA C's `rsqrtf`, within 2 ulp), on the CPU
 * the correctly rounded 1 / sqrt through f64. Use kernelSqrt where every backend must give the same bits.
 */
fun kernelRsqrt(value: f32): f32 = ablaConvertF64ToF32(1.0 / sqrt(ablaConvertF32ToF64(value)))

/**
 * e to the power `value`: on CUDA exactly what CUDA C's `expf` computes without fast-math (libdevice's __nv_expf, within
 * 2 ulp: 0 below about -104, infinity above about 88.7), on the CPU abla/math's f64 exp rounded to f32.
 */
fun kernelExp(value: f32): f32 = ablaConvertF64ToF32(exp(ablaConvertF32ToF64(value)))

/**
 * The hyperbolic tangent of `value`: on CUDA exactly what CUDA C's `tanhf` computes without fast-math (libdevice's
 * __nv_tanhf as NVRTC 12.9 compiles it, within 2 ulp; +-1 from about +-9.01, NaN for NaN), on the CPU an f64 tanh rounded
 * to f32 (a series below 0.01, so small values keep their bits, and +-1 past 20).
 */
fun kernelTanh(value: f32): f32 {
    val x = ablaConvertF32ToF64(value)
    if (x != x) return value
    val a = if (x < 0.0) -x else x
    if (a < 0.01) {
        val s = x * x
        return ablaConvertF64ToF32(x * (1.0 - s * (1.0 / 3.0 - s * (2.0 / 15.0 - s * (17.0 / 315.0)))))
    }
    if (a > 20.0) return if (x < 0.0) f32(-1.0) else f32(1.0)
    val r = 1.0 - 2.0 / (exp(2.0 * a) + 1.0)
    ablaConvertF64ToF32(if (x < 0.0) -r else r)
}

/**
 * The logistic function 1 / (1 + e^-value): on CUDA exactly what CUDA C's `1.0f / (1.0f + expf(-x))` computes without
 * fast-math (expf's last multiply fused into the add, as CUDA's contraction makes it; 0 below about -88.7, where expf
 * overflows), on the CPU in f64 rounded to f32.
 */
fun kernelSigmoid(value: f32): f32 = ablaConvertF64ToF32(1.0 / (1.0 + exp(-ablaConvertF32ToF64(value))))

/** The f32 value of the IEEE binary16 bits in the low 16 bits of `bits` (exact: every f16 is an f32). */
fun kernelF16ToF32(bits: int): f32 {
    val sign = (bits >> 15) & 1
    val exponent = (bits >> 10) & 31
    val mantissa = bits & 1023
    var magnitude = f32(0.0)
    if (exponent == 0) magnitude = f32FromInt(mantissa) * f32FromBits(u32(864026624))
    else if (exponent == 31) magnitude = f32FromBits(u32(if (mantissa == 0) 2139095040 else 2143289344))
    else magnitude = f32FromBits(u32(((exponent + 112) << 23) | (mantissa << 13)))
    if (sign == 1) -magnitude else magnitude
}

// Half precision on packed bits (#1302): no f16 or bf16 type, the values travel as ints. On CUDA each is the GPU's own
// conversion (cvt, fma.rn.f16x2); on the CPU the integer versions below give the same bits, NaN included: every NaN a
// conversion or the fma makes is the canonical 0x7fff, sign dropped, as the GPU's.

/** `bits` shifted right by `shift` (1 or more), rounded to nearest, ties to even. */
private fun kernelCpuShiftRound(bits: int, shift: int): int {
    val result = bits >> shift
    val remainder = bits & ((1 << shift) - 1)
    val half = 1 << (shift - 1)
    if (remainder > half || (remainder == half && (result & 1) == 1)) result + 1 else result
}

/**
 * The magnitude (2^fractionBits + fraction) * 2^(exponent - fractionBits) rounded to nearest even in a binary format with
 * `mantissa` stored bits and exponent bias `bias`, subnormals included: its encoding, the exponent field above the mantissa
 * bits, unbounded (the caller overflows or saturates it).
 */
private fun kernelCpuRoundBinary(exponent: int, fraction: int, fractionBits: int, mantissa: int, bias: int): int {
    val biased = exponent + bias
    val significand = (1 << fractionBits) | fraction
    if (biased >= 1) return ((biased - 1) << mantissa) + kernelCpuShiftRound(significand, fractionBits - mantissa)
    val shift = fractionBits - mantissa + 1 - biased
    if (shift > fractionBits + 1) 0 else kernelCpuShiftRound(significand, shift)
}

/** The f32 value of the bfloat16 bits in the low 16 bits of `bits` (exact: the f32's top half). */
fun kernelBf16ToF32(bits: int): f32 = f32FromBits(u32((bits & 0xffff) << 16))

/** The bfloat16 bits of `value` rounded to nearest even (CUDA C's `__float2bfloat16_rn`): subnormals kept, NaN 0x7fff. */
fun kernelF32ToBf16(value: f32): int {
    val bits = int(f32ToBits(value))
    if ((bits & 0x7fffffff) > 0x7f800000) return 0x7fff
    (bits + 0x7fff + ((bits >> 16) & 1)) >> 16
}

/** The IEEE binary16 bits of `value` rounded to nearest even (CUDA C's `__float2half_rn`): past 65504 infinity, NaN 0x7fff. */
fun kernelF32ToF16(value: f32): int {
    val bits = int(f32ToBits(value))
    val sign = (bits >> 16) & 0x8000
    val exponent = (bits >> 23) & 255
    val fraction = bits & 0x7fffff
    if (exponent == 255) return if (fraction != 0) 0x7fff else sign | 0x7c00
    if (exponent == 0) return sign
    val magnitude = kernelCpuRoundBinary(exponent - 127, fraction, 23, 10, 15)
    sign | (if (magnitude > 0x7c00) 0x7c00 else magnitude)
}

/** The IEEE binary16 bits of the f64 `value` rounded to nearest even, NaN 0x7fff (one rounding, for kernelF16x2Fma). */
private fun kernelCpuF64ToF16(value: f64): int {
    val bits = f64ToBits(value)
    val sign = if (bits < 0) 0x8000 else 0
    val exponent = (bits >> 52) & 0x7ff
    val fraction = bits & 0xfffffffffffff
    if (exponent == 0x7ff) return if (fraction != 0) 0x7fff else sign | 0x7c00
    if (exponent == 0) return sign
    val magnitude = kernelCpuRoundBinary(exponent - 1023, fraction, 52, 10, 15)
    sign | (if (magnitude > 0x7c00) 0x7c00 else magnitude)
}

/**
 * a * b + c on two binary16 lanes packed in the low 32 bits of each operand (lane 0 in the low half), each rounded once to
 * nearest even: CUDA C's `__hfma2`, `fma.rn.f16x2`. The CPU computes each lane in f64, where the product is exact and the
 * sum's one rounding cannot change the binary16 result.
 */
fun kernelF16x2Fma(a: int, b: int, c: int): int {
    var result = 0
    for (lane in 0 until 2) {
        val x = ablaConvertF32ToF64(kernelF16ToF32((a >> (16 * lane)) & 0xffff))
        val y = ablaConvertF32ToF64(kernelF16ToF32((b >> (16 * lane)) & 0xffff))
        val z = ablaConvertF32ToF64(kernelF16ToF32((c >> (16 * lane)) & 0xffff))
        result = result | (kernelCpuF64ToF16(x * y + z) << (16 * lane))
    }
    result
}

/** The FP8 E4M3 byte of `value` rounded to nearest even and saturated: past 448 (infinity too) +-448 (0x7e), NaN 0x7f. */
private fun kernelCpuF32ToE4m3(value: f32): int {
    val bits = int(f32ToBits(value))
    val sign = (bits >> 24) & 0x80
    val exponent = (bits >> 23) & 255
    val fraction = bits & 0x7fffff
    if (exponent == 255 && fraction != 0) return 0x7f
    if (exponent == 255 || exponent > 127 + 8) return sign | 0x7e
    if (exponent == 0) return sign
    val magnitude = kernelCpuRoundBinary(exponent - 127, fraction, 23, 3, 7)
    sign | (if (magnitude > 0x7e) 0x7e else magnitude)
}

/**
 * Two FP8 E4M3 bytes in 16 bits, `high`'s in the high byte (PTX's `cvt.rn.satfinite.e4m3x2.f32 d, high, low`, CUDA C's
 * `__nv_cvt_float2_to_fp8x2(make_float2(low, high), __NV_SATFINITE, __NV_E4M3)`): each rounded to nearest even, past 448
 * saturated to +-448, NaN 0x7f.
 */
fun kernelF32ToE4m3x2(high: f32, low: f32): int = (kernelCpuF32ToE4m3(high) << 8) | kernelCpuF32ToE4m3(low)

/** The binary16 bits of the FP8 E4M3 byte `byte` (exact; NaN 0x7fff). */
private fun kernelCpuE4m3ToF16(byte: int): int {
    val sign = (byte & 0x80) << 8
    val exponent = (byte >> 3) & 15
    val mantissa = byte & 7
    if (exponent == 15 && mantissa == 7) return 0x7fff
    if (exponent > 0) return sign | ((exponent + 8) << 10) | (mantissa << 7)
    if (mantissa == 0) return sign
    val top = if (mantissa >= 4) 2 else if (mantissa >= 2) 1 else 0
    sign | ((top + 6) << 10) | ((mantissa - (1 << top)) << (10 - top))
}

/**
 * The two FP8 E4M3 bytes in the low 16 bits of `pair` as two binary16 lanes in 32 bits, the low byte's in the low half
 * (PTX's `cvt.rn.f16x2.e4m3x2`, CUDA C's `__nv_cvt_fp8x2_to_halfraw2`): exact, NaN 0x7fff. kernelF16ToF32 reads each lane.
 */
fun kernelE4m3x2ToF16x2(pair: int): int = kernelCpuE4m3ToF16(pair & 0xff) | (kernelCpuE4m3ToF16((pair >> 8) & 0xff) << 16)

/**
 * `value` rounded to the nearest int, ties to even, saturated to the 32-bit range, NaN 0 (CUDA C's `__float2int_rn`,
 * `cvt.rni.s32.f32`).
 */
fun kernelRoundToInt(value: f32): int {
    val bits = int(f32ToBits(value))
    val negative = (bits & 0x80000000) != 0
    val exponent = (bits >> 23) & 255
    val fraction = bits & 0x7fffff
    if (exponent == 255 && fraction != 0) return 0
    if (exponent < 126) return 0
    if (exponent >= 127 + 31) return if (negative) -2147483648 else 2147483647
    val significand = fraction | 0x800000
    val magnitude = if (exponent >= 127 + 23) significand << (exponent - 127 - 23)
        else kernelCpuShiftRound(significand, 127 + 23 - exponent)
    if (negative) -magnitude else magnitude
}

/** x * y + z: one rounding on a GPU; on the CPU the product is exact in f64 and the sum is rounded twice (to f64, then f32). */
fun kernelFma(x: f32, y: f32, z: f32): f32 =
    ablaConvertF64ToF32(ablaConvertF32ToF64(x) * ablaConvertF32ToF64(y) + ablaConvertF32ToF64(z))

/** Runs `body` once per thread of `groups` groups of `groupSize` threads, in order, on this thread: the CPU backend. The
 *  kernel's ids answer the thread being run. */
fun kernelRunCpu(groups: int, groupSize: int, body: () -> void): void = kernelRunCpuGrid(groups, 1, groupSize, body)

/** Runs `body` once per thread of a grid of `groups` x `groupsY` groups of `groupSize` threads, in order, on this thread. */
fun kernelRunCpuGrid(groups: int, groupsY: int, groupSize: int, body: () -> void): void {
    kernelCpuState.groupSize = groupSize
    for (groupY in 0 until groupsY) {
        kernelCpuState.groupY = groupY
        for (group in 0 until groups) {
            kernelCpuState.group = group
            for (local in 0 until groupSize) {
                kernelCpuState.local = local
                kernelCpuState.sharedNext = 0
                body()
            }
        }
    }
    kernelCpuState.group = 0
    kernelCpuState.groupY = 0
    kernelCpuState.local = 0
    kernelCpuState.groupSize = 1
}

/** The PTX of every `@kernel` function of the program, one entry per kernel under its name, for the CUDA driver
 *  (cuModuleLoadData): made by the compiler at build time; "" when the program has no kernel. */
noescape extern:"intrinsic" fun kernelPtx(): string
