// Narrow bootstrap host capability ABI. Portable library entry points should
// not call this module directly; filesystem and compiler adapters select it
// only when the hosted profile is required.

noescape extern:"host" fun ablaHostIsMacOS(): bool

noescape extern:"host" fun ablaHostReadFile(path: string): string

noescape extern:"host" fun ablaHostWriteFile(path: string, contents: string)

noescape extern:"host" fun ablaHostWriteFileAtomic(
    path: string,
    contents: string
): bool

noescape extern:"host" fun ablaHostCreateParentDirectories(path: string)

noescape extern:"host" fun ablaHostCreateDirectories(path: string): bool

noescape extern:"host" fun ablaHostFileKind(path: string): int

noescape extern:"host" fun ablaHostFileSize(path: string): int

noescape extern:"host" fun ablaHostListDirectory(path: string): array<string>

noescape extern:"host" fun ablaHostMoveFile(
    source: string,
    destination: string
): bool

noescape extern:"host" fun ablaHostRemoveFile(path: string): bool

noescape extern:"host" fun ablaHostCurrentDirectory(): string

noescape extern:"host" fun ablaHostReadStdinLine(): string

noescape extern:"host" fun ablaHostStdinLineAvailable(): bool

noescape extern:"host" fun ablaHostWriteStdout(text: string): void

noescape extern:"host" fun ablaHostWriteStderr(text: string): void

noescape extern:"host" fun ablaHostFileRevision(path: string): int

noescape extern:"host" fun ablaHostArgumentCount(): int

noescape extern:"host" fun ablaHostArgument(index: int): string

noescape extern:"host" fun ablaHostSleep(milliseconds: int)

noescape extern:"host" fun ablaHostRunProcess(arguments: array<string>): int

noescape extern:"host" fun ablaHostCaptureProcess(
    arguments: array<string>
): string

noescape extern:"host" fun ablaHostStartProcess(arguments: array<string>): int

noescape extern:"host" fun ablaHostStopProcess(process: int): int

noescape extern:"host" fun ablaHostStopProcessGracefully(
    process: int,
    graceMilliseconds: int
): int
