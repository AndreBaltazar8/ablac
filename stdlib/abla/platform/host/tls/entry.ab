// TLS for the flat host API (see abla/platform/host): connections and
// listeners are integer handles (a connection's or a listener's socket
// descriptor), over abla/tls/pure: TLS in Abla, no OpenSSL and no libc, with
// the verification of every other pure client (the system trust store or the
// CA file, the host name from the certificate's subject alternative names).

import "abla/platform/host"
import "abla/tls/pure"

/// Reports whether the pure TLS backend is available on this host.
fun ablaHostTlsAvailable(): bool = tlsAvailable()

// A connection handle (negative on failure; ablaHostTlsError() says why).
fun ablaHostTlsOpen(host: string, port: int, timeoutMilliseconds: int): int {
    val connection = tlsConnect(host, port, timeoutMilliseconds)
    if (connection.handle == -1) return -1
    tlsRelease(move(connection))
}

/// Opens a verified connection using the supplied CA file and returns its handle, or -1 on failure.
fun ablaHostTlsOpenWithCa(
    host: string,
    port: int,
    timeoutMilliseconds: int,
    caPath: string
): int {
    val connection = tlsConnectWithCa(host, caPath, port, timeoutMilliseconds)
    if (connection.handle == -1) return -1
    tlsRelease(move(connection))
}

/// Reads up to the given number of decrypted bytes, returning an empty string when no bytes are available or on failure.
fun ablaHostTlsRead(handle: int, maximum: int): string = tlsReadHandle(handle, maximum)

/// Writes plaintext to the connection and returns the number of bytes written or a negative result on error.
fun ablaHostTlsWrite(handle: int, contents: string): int = tlsWriteHandle(handle, contents)

// Replaces the limits on one read and one write; 0 waits as long as it takes.
fun ablaHostTlsSetTimeouts(
    handle: int,
    readMilliseconds: int,
    writeMilliseconds: int
): bool = tlsSetTimeoutsHandle(handle, readMilliseconds, writeMilliseconds)

/// Closes a connection by its handle and reports whether the close succeeded.
fun ablaHostTlsClose(handle: int): bool = tlsCloseHandle(handle)

/// Returns the latest error text from the pure TLS backend.
fun ablaHostTlsError(): string = tlsLastError()

// The listeners, by their socket's descriptor. One thread (the compile-time evaluator's), as the connection table of
// abla/tls/pure.
private var hostTlsListeners: array<TlsListener> = []

private fun hostTlsListenerIndex(handle: int): int {
    var at = 0
    while (at < hostTlsListeners.size) {
        if (hostTlsListeners[at].descriptor() == handle) return at
        at = at + 1
    }
    -1
}

/// Creates a listener using the given certificate and key, returning its descriptor or -1 on setup failure.
fun ablaHostTlsListen(
    host: string,
    port: int,
    backlog: int,
    dualStack: bool,
    certificatePath: string,
    privateKeyPath: string
): int {
    val listener = tlsListen(certificatePath, privateKeyPath, host, port, backlog, dualStack)
    if (listener.handle == -1) return -1
    val descriptor = listener.descriptor()
    hostTlsListeners.append(move(listener))
    descriptor
}

/// Returns the listener's bound local port, or -1 for an unknown handle.
fun ablaHostTlsListenerPort(handle: int): int {
    val at = hostTlsListenerIndex(handle)
    if (at < 0) return -1
    hostTlsListeners[at].localPort()
}

/// Accepts and handshakes a client, returning its handle or -1 for an unknown listener or failure.
fun ablaHostTlsAccept(handle: int): int {
    val at = hostTlsListenerIndex(handle)
    if (at < 0) return -1
    val connection = hostTlsListeners[at].accept()
    if (connection.handle == -1) return -1
    tlsRelease(move(connection))
}

/// Removes and closes the listener, returning false if the handle is unknown or close fails.
fun ablaHostTlsListenerClose(handle: int): bool {
    val at = hostTlsListenerIndex(handle)
    if (at < 0) return false
    var listener = hostTlsListeners.takeAt(at)
    listener.close()
}
