// TLS for the flat host API (see abla/platform/host): connections and
// listeners are integer handles of abla/tls/hosted. Importing this module
// links the system TLS library.

import "abla/platform/host"
import "abla/tls/hosted"

fun ablaHostTlsAvailable(): bool = tlsAvailable()

// A connection handle (negative on failure; ablaHostTlsError() says why).
fun ablaHostTlsOpen(host: string, port: int, timeoutMilliseconds: int): int =
    tlsOpen(host, "", port, timeoutMilliseconds)

fun ablaHostTlsOpenWithCa(
    host: string,
    port: int,
    timeoutMilliseconds: int,
    caPath: string
): int = tlsOpen(host, caPath, port, timeoutMilliseconds)

fun ablaHostTlsRead(handle: int, maximum: int): string {
    var connection = TlsConnection(handle)
    val text = connection.read(maximum)
    connection.handle = -1
    text
}

fun ablaHostTlsWrite(handle: int, contents: string): int {
    var connection = TlsConnection(handle)
    val written = connection.write(contents)
    connection.handle = -1
    written
}

fun ablaHostTlsClose(handle: int): bool = tlsCloseHandle(handle)

fun ablaHostTlsError(): string = tlsLastError()

fun ablaHostTlsListen(
    host: string,
    port: int,
    backlog: int,
    dualStack: bool,
    certificatePath: string,
    privateKeyPath: string
): int = tlsListenHandle(
    certificatePath, privateKeyPath, host, port, backlog, dualStack
)

fun ablaHostTlsListenerPort(handle: int): int {
    var listener = TlsListener(handle)
    val port = listener.localPort()
    listener.handle = -1
    port
}

fun ablaHostTlsAccept(handle: int): int {
    var listener = TlsListener(handle)
    var connection = listener.accept()
    listener.handle = -1
    val accepted = connection.handle
    connection.handle = -1
    accepted
}

fun ablaHostTlsListenerClose(handle: int): bool = tlsCloseListenerHandle(handle)
