// Compile-only parser extension API. Values of these types are opaque handles
// owned by the compiler and cannot be frozen into runtime programs.

compile abstract class ParserCursor

compile abstract class SyntaxExpression

compile abstract class GeneratedModuleBuilder

compile abstract class TypedAccessPath

compile extern:"compiler" fun compilerRegisterSubparser(
    name: string,
    parser: (ParserCursor) -> SyntaxExpression
)

compile extern:"parser" fun parserExpect(cursor: ParserCursor, token: string)

compile extern:"parser" fun parserAt(cursor: ParserCursor, token: string): bool

compile extern:"parser" fun parserConsume(cursor: ParserCursor, token: string): bool

compile extern:"parser" fun parserCurrentText(cursor: ParserCursor): string

compile extern:"parser" fun parserRawAt(
    cursor: ParserCursor,
    text: string
): bool

compile extern:"parser" fun parserRawConsume(
    cursor: ParserCursor,
    text: string
): bool

compile extern:"parser" fun parserRawExpect(cursor: ParserCursor, text: string)

// Consumes source until (but not including) any byte in `delimiters`.
compile extern:"parser" fun parserRawTakeUntil(
    cursor: ParserCursor,
    delimiters: string
): string

compile extern:"parser" fun parserRawTakeName(cursor: ParserCursor): string

compile extern:"parser" fun parserRawSkipWhitespace(cursor: ParserCursor)

compile extern:"parser" fun parserRawEnd(cursor: ParserCursor): bool

// Canonical identity of the module currently owned by this parser cursor.
// Providers can combine it with source spans when constructing namespaces;
// unlike byte offsets, it distinguishes otherwise identical imported files.
compile extern:"parser" fun parserSourceIdentity(cursor: ParserCursor): string

compile extern:"parser" fun parserFail(cursor: ParserCursor, message: string)

compile extern:"parser" fun parserParseAblaExpression(
    cursor: ParserCursor
): SyntaxExpression

// Read-only structural inspection. Handles remain compilation-scoped and the
// child operation borrows the same immutable syntax tree.
compile extern:"parser" fun syntaxKind(expression: SyntaxExpression): string

compile extern:"parser" fun syntaxText(expression: SyntaxExpression): string

compile extern:"parser" fun syntaxChildCount(expression: SyntaxExpression): int

compile extern:"parser" fun syntaxChild(
    expression: SyntaxExpression,
    index: int
): SyntaxExpression

compile extern:"parser" fun syntaxBegin(expression: SyntaxExpression): int

compile extern:"parser" fun syntaxEnd(expression: SyntaxExpression): int

// Direct-call typed handles are resolved against the candidate declaration
// set. Ambiguous or non-call targets are compile-time diagnostics.
compile extern:"compiler" fun typedExpressionType(
    expression: SyntaxExpression
): string

compile extern:"compiler" fun typedExpressionTypeHandle(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedExpressionKind(
    expression: SyntaxExpression
): string

compile extern:"compiler" fun typedCallTarget(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedCallArgumentType(
    expression: SyntaxExpression,
    argument: int
): string

compile extern:"compiler" fun typedCallArgumentCount(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedCallArgument(
    expression: SyntaxExpression,
    argument: int
): SyntaxExpression

// Valid only for a member call. Direct calls have no receiver expression.
compile extern:"compiler" fun typedCallReceiverType(
    expression: SyntaxExpression
): string

// Selected-signature metadata. These operations resolve the same declaration
// handle as typedCallTarget; they never repeat name lookup in extension code.
compile extern:"compiler" fun typedCallParameterTypeHandle(
    expression: SyntaxExpression,
    parameter: int
): int

compile extern:"compiler" fun typedCallResultTypeHandle(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedCallArgumentParameter(
    expression: SyntaxExpression,
    argument: int
): int

// Semantic adaptation selected for this source argument: none, borrow.read,
// nullable.inject, string.to-cstring, integer.widen, or integer.narrow.
compile extern:"compiler" fun typedCallArgumentConversion(
    expression: SyntaxExpression,
    argument: int
): string

compile extern:"compiler" fun typedCallInsertedDefaultCount(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedCallParameterOwnership(
    expression: SyntaxExpression,
    parameter: int
): string

compile extern:"compiler" fun typedCallIsCompileOnly(
    expression: SyntaxExpression
): bool

compile extern:"compiler" fun typedCallIsTrusted(
    expression: SyntaxExpression
): bool

compile extern:"compiler" fun typedCallIsContract(
    expression: SyntaxExpression
): bool

// Typed dependency and mutation reflection. Returned paths are immutable,
// compilation-scoped handles owned by the resolved deferred-expression
// snapshot.
compile extern:"compiler" fun typedExpressionReadCount(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedExpressionRead(
    expression: SyntaxExpression,
    index: int
): TypedAccessPath

compile extern:"compiler" fun typedExpressionWriteCount(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedExpressionWrite(
    expression: SyntaxExpression,
    index: int
): TypedAccessPath

compile extern:"compiler" fun typedExpressionConsumeCount(
    expression: SyntaxExpression
): int

compile extern:"compiler" fun typedExpressionConsume(
    expression: SyntaxExpression,
    index: int
): TypedAccessPath

compile extern:"compiler" fun typedExpressionReadsUnknown(
    expression: SyntaxExpression
): bool

compile extern:"compiler" fun typedExpressionWritesUnknown(
    expression: SyntaxExpression
): bool
compile extern:"compiler" fun typedExpressionHasEffect(
    expression: SyntaxExpression,
    effect: string
): bool

compile extern:"compiler" fun typedFunctionReadCount(function: int): int
compile extern:"compiler" fun typedFunctionRead(
    function: int,
    index: int
): TypedAccessPath
compile extern:"compiler" fun typedFunctionWriteCount(function: int): int
compile extern:"compiler" fun typedFunctionWrite(
    function: int,
    index: int
): TypedAccessPath
compile extern:"compiler" fun typedFunctionReadsUnknown(function: int): bool
compile extern:"compiler" fun typedFunctionWritesUnknown(function: int): bool
compile extern:"compiler" fun typedFunctionHasEffect(
    function: int,
    effect: string
): bool

compile extern:"compiler" fun typedAccessRootKind(
    path: TypedAccessPath
): string
compile extern:"compiler" fun typedAccessRootIdentity(
    path: TypedAccessPath
): string
compile extern:"compiler" fun typedAccessRootParameter(
    path: TypedAccessPath
): int
compile extern:"compiler" fun typedAccessSegmentCount(
    path: TypedAccessPath
): int
compile extern:"compiler" fun typedAccessSegmentKind(
    path: TypedAccessPath,
    index: int
): string
compile extern:"compiler" fun typedAccessSegmentName(
    path: TypedAccessPath,
    index: int
): string
compile extern:"compiler" fun typedAccessSegmentIndex(
    path: TypedAccessPath,
    index: int
): int
compile extern:"compiler" fun typedAccessPathsIntersect(
    left: TypedAccessPath,
    right: TypedAccessPath
): bool

// Records a request while a subparser owns the syntax handle. The finalizer
// runs in the same bounded compile-time machine and returns one virtual module
// which is validated transactionally with the candidate program.
compile extern:"compiler" fun compilerRecordExtensionRequest(
    namespace: string,
    payload: string,
    expression: SyntaxExpression,
    finalizer: (string, SyntaxExpression) -> string
)

// Direct owned-AST finalization. The returned builder never becomes source
// text: its declarations are published with namespace/span provenance into the
// candidate parse result and pass the ordinary semantic/ownership/IR pipeline.
compile extern:"compiler" fun compilerRecordGeneratedExtensionRequest(
    namespace: string,
    payload: string,
    expression: SyntaxExpression,
    finalizer: (string, SyntaxExpression) -> GeneratedModuleBuilder
)

compile extern:"parser" fun syntaxInteger(value: int): SyntaxExpression

compile extern:"parser" fun syntaxString(value: string): SyntaxExpression

compile extern:"parser" fun syntaxBoolean(value: bool): SyntaxExpression

compile extern:"parser" fun syntaxNull(): SyntaxExpression

compile extern:"parser" fun syntaxIdentifier(value: string): SyntaxExpression

compile extern:"parser" fun syntaxBinary(
    operation: string,
    left: SyntaxExpression,
    right: SyntaxExpression
): SyntaxExpression

compile extern:"parser" fun syntaxArray(
    elements: array<SyntaxExpression>
): SyntaxExpression

compile extern:"parser" fun syntaxCall(
    name: string,
    arguments: array<SyntaxExpression>
): SyntaxExpression

compile extern:"parser" fun syntaxMember(
    receiver: SyntaxExpression,
    name: string
): SyntaxExpression

compile extern:"parser" fun syntaxIndex(
    receiver: SyntaxExpression,
    index: SyntaxExpression
): SyntaxExpression

compile extern:"parser" fun syntaxIf(
    condition: SyntaxExpression,
    thenExpression: SyntaxExpression,
    elseExpression: SyntaxExpression
): SyntaxExpression

compile extern:"parser" fun syntaxReturn(
    value: SyntaxExpression
): SyntaxExpression

compile extern:"parser" fun syntaxBlock(
    statements: array<SyntaxExpression>
): SyntaxExpression

compile extern:"parser" fun syntaxLocal(
    name: string,
    type: int,
    initializer: SyntaxExpression
): SyntaxExpression

compile extern:"parser" fun syntaxVariable(
    name: string,
    type: int,
    initializer: SyntaxExpression
): SyntaxExpression

compile extern:"parser" fun syntaxAssign(
    name: string,
    value: SyntaxExpression
): SyntaxExpression

compile extern:"parser" fun syntaxLambda(
    parameterNames: array<string>,
    parameterTypes: array<int>,
    body: SyntaxExpression,
    moving: bool
): SyntaxExpression

// Builds the same syntax as a source lambda with unannotated parameters.
// The surrounding callable use supplies their types during ordinary semantic
// analysis, so this form is safe to call from the initial subparser phase.
compile extern:"parser" fun syntaxInferredLambda(
    parameterNames: array<string>,
    body: SyntaxExpression,
    moving: bool
): SyntaxExpression

// Owned, compilation-scoped declaration construction. The builder assigns
// collision-checked deterministic declaration names and retains compiler-owned
// SyntaxExpression trees. Direct finalizers publish those AST declarations
// transactionally; compilerGeneratedModuleSource is the compatibility bridge
// for older source-returning finalizers.
compile extern:"compiler" fun compilerGeneratedModule(
    namespace: string,
    origin: SyntaxExpression
): GeneratedModuleBuilder

compile extern:"compiler" fun compilerGeneratedFunction(
    module: GeneratedModuleBuilder,
    hint: string,
    parameterNames: array<string>,
    parameterTypes: array<int>,
    resultType: int,
    body: SyntaxExpression
): string

// Creates a generated function by rewriting the listed free identifiers to
// explicit generated parameters. Capture types and mutable modes are checked
// before the ordinary generated-declaration validation pipeline runs.
compile extern:"compiler" fun compilerGeneratedLiftedFunction(
    module: GeneratedModuleBuilder,
    hint: string,
    captureNames: array<string>,
    parameterNames: array<string>,
    parameterTypes: array<int>,
    mutableCaptures: array<bool>,
    resultType: int,
    body: SyntaxExpression
): string

// Deliberate source-visible root. Unlike ordinary generated declarations this
// exact name must be unused in the candidate program.
compile extern:"compiler" fun compilerGeneratedExportFunction(
    module: GeneratedModuleBuilder,
    name: string,
    parameterNames: array<string>,
    parameterTypes: array<int>,
    resultType: int,
    body: SyntaxExpression
): string

compile extern:"compiler" fun compilerGeneratedValue(
    module: GeneratedModuleBuilder,
    hint: string,
    type: int,
    initializer: SyntaxExpression
): string

compile extern:"compiler" fun compilerGeneratedModuleSource(
    module: GeneratedModuleBuilder
): string

compile extern:"compiler" fun compilerGeneratedDeclarationCount(
    module: GeneratedModuleBuilder
): int

compile extern:"compiler" fun compilerGeneratedDeclarationNamespace(
    module: GeneratedModuleBuilder,
    declaration: int
): string

compile extern:"compiler" fun compilerGeneratedDeclarationOriginBegin(
    module: GeneratedModuleBuilder,
    declaration: int
): int

compile extern:"compiler" fun compilerGeneratedDeclarationOriginEnd(
    module: GeneratedModuleBuilder,
    declaration: int
): int

// Unforgeable references to declarations already owned by this builder. The
// ordinal is declaration order within the module, not a source-level name.
compile extern:"compiler" fun compilerGeneratedDeclarationReference(
    module: GeneratedModuleBuilder,
    declaration: int
): SyntaxExpression

compile extern:"compiler" fun compilerGeneratedDeclarationCall(
    module: GeneratedModuleBuilder,
    declaration: int,
    arguments: array<SyntaxExpression>
): SyntaxExpression

// Builder calls retain the selected declaration handle as compiler-owned
// provenance. Extensions do not reconstruct or reserve a source-level target
// name, and an inherent/extension method must use the receiver-bearing form.
compile extern:"compiler" fun syntaxCallTarget(
    target: int,
    arguments: array<SyntaxExpression>
): SyntaxExpression

compile extern:"compiler" fun syntaxMethodCallTarget(
    target: int,
    receiver: SyntaxExpression,
    arguments: array<SyntaxExpression>
): SyntaxExpression
