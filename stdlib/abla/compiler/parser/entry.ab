import "abla/compiler"

// Compile-only parser extension API. Values of these types are opaque handles
// owned by the compiler and cannot be frozen into runtime programs.

// An opaque cursor over an embedded-language source site. Use the parser operations to inspect or advance it during compilation.
compile class ParserCursor

// An opaque handle to a compiler syntax expression. Construct or inspect it through the compile-time syntax API.
compile class SyntaxExpression

// An opaque compile-time builder that owns generated declarations until they are published.
compile class GeneratedModuleBuilder

// An opaque compile-time path describing a root and ordered projections used by access analysis.
compile class TypedAccessPath

// Registers `parser` for the embedded language named `name`. The parser receives a source cursor and returns an Abla syntax expression. Invalid registrations produce compile-time diagnostics.
compile extern:"compiler" fun compilerRegisterSubparser(
    name: string,
    parser: (ParserCursor) -> SyntaxExpression,
    rawBoundary: ((ParserCursor) -> SyntaxExpression)? = null
)

// Consumes `token` at `cursor` or reports a parser diagnostic if it does not match.
compile extern:"parser" fun parserExpect(cursor: ParserCursor, token: string)

// Returns true if the next parser token matches the requested text without consuming it.
compile extern:"parser" fun parserAt(cursor: ParserCursor, token: string): bool

// Consumes the next token and returns true on a text match, or returns false without advancing.
compile extern:"parser" fun parserConsume(cursor: ParserCursor, token: string): bool

// Returns the current cursor token's source text, or an empty string at end of input.
compile extern:"parser" fun parserCurrentText(cursor: ParserCursor): string

// The text of the token `ahead` tokens past the current one (0 is the current
// token), without consuming anything: "" past the end and for a negative
// `ahead`. Lets a provider look at what follows before choosing a parse.
compile extern:"parser" fun parserTextAhead(
    cursor: ParserCursor,
    ahead: int
): string

// Returns whether the source at `cursor` starts with exact `text`, without advancing.
compile extern:"parser" fun parserRawAt(
    cursor: ParserCursor,
    text: string
): bool

// Consumes exact `text` from `cursor` and returns true on a match. A mismatch returns false without advancing.
compile extern:"parser" fun parserRawConsume(
    cursor: ParserCursor,
    text: string
): bool

// Consumes exact `text` from `cursor` or reports a diagnostic if it is absent.
compile extern:"parser" fun parserRawExpect(cursor: ParserCursor, text: string)

// Consumes source until (but not including) any byte in `delimiters`.
compile extern:"parser" fun parserRawTakeUntil(
    cursor: ParserCursor,
    delimiters: string
): string

// Consumes source until (but not including) one exact delimiter string. This
// is the linear-time form for embedded multi-line languages whose payload may
// legitimately contain any individual delimiter byte.
compile extern:"parser" fun parserRawTakeUntilText(
    cursor: ParserCursor,
    delimiter: string
): string

// Validates a line-oriented embedded language without interpreting each byte
// through staged Abla. Records may be labels, alphabetic instruction tokens,
// comments beginning with `#`, or dot directives listed one per catalog line.
compile extern:"parser" fun parserRawLineRecordsValid(
    source: string,
    directiveCatalog: string
): bool

// Inserts text after the first top-level line whose initial token exactly
// matches `record`; nested `.pushsection` regions are skipped.
compile extern:"parser" fun parserRawInsertAfterTopLevelRecord(
    source: string,
    record: string,
    insertion: string
): string

// Returns the source with text inserted before the first matching top-level record, skipping nested sections.
compile extern:"parser" fun parserRawInsertBeforeTopLevelRecord(
    source: string,
    record: string,
    insertion: string
): string

// Inserts caller-defined text immediately before and after every nested entry
// record in one linear pass, without teaching the compiler a target
// instruction set or ABI.
compile extern:"parser" fun parserRawGuardNestedEntries(
    source: string,
    entryRecord: string,
    beforeEntry: string,
    afterEntry: string
): string

// Wraps the first matching top-level record with caller-defined text in one
// bounded pass. Nested `.pushsection` regions are ignored.
compile extern:"parser" fun parserRawWrapTopLevelRecord(
    source: string,
    record: string,
    beforeRecord: string,
    afterRecord: string
): string

// Consumes a run of name characters from `cursor` and returns the source spelling. If no name starts there, reports a parser error.
compile extern:"parser" fun parserRawTakeName(cursor: ParserCursor): string

// Consumes a conventional object/linker symbol made from alphanumeric bytes,
// `_`, `.`, and `$`. Target subparsers decide where such a symbol is valid.
compile extern:"parser" fun parserRawTakeSymbol(cursor: ParserCursor): string

// Advances `cursor` past raw whitespace at the current position.
compile extern:"parser" fun parserRawSkipWhitespace(cursor: ParserCursor)

// Returns whether `cursor` has reached the end of the available source.
compile extern:"parser" fun parserRawEnd(cursor: ParserCursor): bool

// Current byte position in the owning source module. Raw subparsers use this
// to retain precise spans for embedded languages without accessing cursor
// internals or mutating compiler state.
compile extern:"parser" fun parserRawPosition(cursor: ParserCursor): int

// Where this `$name` is, as a key for what the subparser names after its
// site (a generated type, a namespace): the method, function or global that
// holds it and its offset there (an identifier's characters). Unlike
// parserRawPosition, an edit outside that declaration (a line or an import
// above it) leaves the key alone, so the names, and the program, don't
// change. Unique within its module; combine it with parserSourceIdentity
// where names must differ across modules.
compile extern:"parser" fun parserSiteKey(cursor: ParserCursor): string

// Canonical identity of the module currently owned by this parser cursor.
// Providers can combine it with source spans when constructing namespaces;
// unlike byte offsets, it distinguishes otherwise identical imported files.
compile extern:"parser" fun parserSourceIdentity(cursor: ParserCursor): string

// Reports a compile-time parser diagnostic using `message` at `cursor`.
compile extern:"parser" fun parserFail(cursor: ParserCursor, message: string)

// Parses an Abla expression at `cursor`, advancing it and returning the syntax handle. Invalid expressions produce parser diagnostics.
compile extern:"parser" fun parserParseAblaExpression(
    cursor: ParserCursor
): SyntaxExpression

// A parsed string template's text fragments and string-valued interpolations
// both have syntaxKind "string". This predicate distinguishes fragments by
// their owned STRING_TEXT token span, without evaluating any interpolation.
compile extern:"parser" fun parserTemplatePartIsText(
    cursor: ParserCursor, template: SyntaxExpression, index: int
): bool

// Read-only structural inspection. Handles remain compilation-scoped and the
// child operation borrows the same immutable syntax tree.
// An annotation's argument as syntax (see compilerFunctionAnnotationArgumentCount).
compile extern:"compiler" fun compilerFunctionAnnotationArgument(
    handle: int,
    annotation: int,
    argument: int
): SyntaxExpression

// Returns the annotation argument as syntax, reporting a compile-time error for an invalid handle or unavailable argument.
compile fun Compiler.annotationArgument(
    function: int,
    annotation: int,
    argument: int = 0
): SyntaxExpression = compilerFunctionAnnotationArgument(
    function, annotation, argument
)

// Returns the compiler's kind name for `expression`.
compile extern:"parser" fun syntaxKind(expression: SyntaxExpression): string

// Returns the compiler syntax node's text payload for `expression`.
compile extern:"parser" fun syntaxText(expression: SyntaxExpression): string

// Returns the number of immediate children of `expression`.
compile extern:"parser" fun syntaxChildCount(expression: SyntaxExpression): int

// Returns child `index` of `expression` as a syntax handle. Invalid indices or expression handles produce a compile-time error.
compile extern:"parser" fun syntaxChild(
    expression: SyntaxExpression,
    index: int
): SyntaxExpression

// Returns the beginning byte offset of `expression` in the parser's source.
compile extern:"parser" fun syntaxBegin(expression: SyntaxExpression): int

// Returns the exclusive ending byte offset of `expression` in the parser's source.
compile extern:"parser" fun syntaxEnd(expression: SyntaxExpression): int

// Direct-call typed handles are resolved against the candidate declaration
// set. Ambiguous or non-call targets are compile-time diagnostics.
compile extern:"compiler" fun typedExpressionType(
    expression: SyntaxExpression
): string

// Returns the resolved type handle of an expression, reporting a compile-time error if no resolved type is available.
compile extern:"compiler" fun typedExpressionTypeHandle(
    expression: SyntaxExpression
): int

// Returns the expression's syntax kind or reports a compile-time error for an invalid syntax handle.
compile extern:"compiler" fun typedExpressionKind(
    expression: SyntaxExpression
): string

// Returns the declaration handle for the resolved call in `expression`. An invalid handle or a call that has not resolved produces a compile-time diagnostic.
compile extern:"compiler" fun typedCallTarget(
    expression: SyntaxExpression
): int

// Returns the indexed argument's resolved type spelling, reporting a compile-time error for an unresolved call or invalid index.
compile extern:"compiler" fun typedCallArgumentType(
    expression: SyntaxExpression,
    argument: int
): string

// Returns the number of explicit call arguments excluding the receiver, reporting a compile-time error for non-call syntax.
compile extern:"compiler" fun typedCallArgumentCount(
    expression: SyntaxExpression
): int

// Returns the indexed explicit argument's syntax, reporting a compile-time error for an invalid call or argument index.
compile extern:"compiler" fun typedCallArgument(
    expression: SyntaxExpression,
    argument: int
): SyntaxExpression

// Valid only for a member call. Direct calls have no receiver expression.
compile extern:"compiler" fun typedCallReceiverType(
    expression: SyntaxExpression
): string

// Selected-signature metadata. These operations resolve the same declaration
// handle as typedCallTarget; they never repeat name lookup in extension code.
compile extern:"compiler" fun typedCallParameterTypeHandle(
    expression: SyntaxExpression,
    parameter: int
): int

// Returns the resolved call result type handle or reports a compile-time error if the call is unresolved.
compile extern:"compiler" fun typedCallResultTypeHandle(
    expression: SyntaxExpression
): int

// Returns the parameter index selected for the indexed argument, reporting a compile-time error for an unresolved call or invalid argument index.
compile extern:"compiler" fun typedCallArgumentParameter(
    expression: SyntaxExpression,
    argument: int
): int

// Semantic adaptation selected for this source argument: none, borrow.read,
// nullable.inject, string.to-cstring, integer.widen, or integer.narrow.
compile extern:"compiler" fun typedCallArgumentConversion(
    expression: SyntaxExpression,
    argument: int
): string

// Returns the number of defaults inserted by call resolution, reporting a compile-time error for an unresolved call.
compile extern:"compiler" fun typedCallInsertedDefaultCount(
    expression: SyntaxExpression
): int

// Returns the selected parameter's ownership kind, reporting a compile-time error for an unresolved call or invalid parameter index.
compile extern:"compiler" fun typedCallParameterOwnership(
    expression: SyntaxExpression,
    parameter: int
): string

// Returns whether the call resolves to a compile-only function, reporting a compile-time error for an unresolved call.
compile extern:"compiler" fun typedCallIsCompileOnly(
    expression: SyntaxExpression
): bool

// Returns whether the call resolves to a trusted function, reporting a compile-time error for an unresolved call.
compile extern:"compiler" fun typedCallIsTrusted(
    expression: SyntaxExpression
): bool

// Returns whether the call resolves through a contract, reporting a compile-time error for an unresolved call.
compile extern:"compiler" fun typedCallIsContract(
    expression: SyntaxExpression
): bool

// Typed dependency and mutation reflection. Returned paths are immutable,
// compilation-scoped handles owned by the resolved deferred-expression
// snapshot.
compile extern:"compiler" fun typedExpressionReadCount(
    expression: SyntaxExpression
): int

// Returns the indexed read path of a resolved expression, reporting a compile-time error for an unavailable path.
compile extern:"compiler" fun typedExpressionRead(
    expression: SyntaxExpression,
    index: int
): TypedAccessPath

// Returns the number of known write paths for a resolved expression, reporting a compile-time error if access analysis is unavailable.
compile extern:"compiler" fun typedExpressionWriteCount(
    expression: SyntaxExpression
): int

// Returns the indexed write path of a resolved expression, reporting a compile-time error for an unavailable path.
compile extern:"compiler" fun typedExpressionWrite(
    expression: SyntaxExpression,
    index: int
): TypedAccessPath

// Returns the number of known consumed paths for a resolved expression, reporting a compile-time error if access analysis is unavailable.
compile extern:"compiler" fun typedExpressionConsumeCount(
    expression: SyntaxExpression
): int

// Returns the indexed consumed path of a resolved expression, reporting a compile-time error for an unavailable path.
compile extern:"compiler" fun typedExpressionConsume(
    expression: SyntaxExpression,
    index: int
): TypedAccessPath

// Returns whether a resolved expression may read unknown storage, reporting a compile-time error if access analysis is unavailable.
compile extern:"compiler" fun typedExpressionReadsUnknown(
    expression: SyntaxExpression
): bool

// Returns whether a resolved expression may write unknown storage, reporting a compile-time error if access analysis is unavailable.
compile extern:"compiler" fun typedExpressionWritesUnknown(
    expression: SyntaxExpression
): bool
// Returns whether effect analysis records the named effect for a resolved expression, reporting a compile-time error when the analysis or effect name is unavailable.
compile extern:"compiler" fun typedExpressionHasEffect(
    expression: SyntaxExpression,
    effect: string
): bool

// Returns the number of known read paths in a function's access summary, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun typedFunctionReadCount(function: int): int
// Returns the indexed read path in a function's access summary, reporting a compile-time error for an invalid handle or index.
compile extern:"compiler" fun typedFunctionRead(
    function: int,
    index: int
): TypedAccessPath
// Returns the number of known write paths in a function's access summary, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun typedFunctionWriteCount(function: int): int
// Returns the indexed write path in a function's access summary, reporting a compile-time error for an invalid handle or index.
compile extern:"compiler" fun typedFunctionWrite(
    function: int,
    index: int
): TypedAccessPath
// Returns whether a function may read unknown storage, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun typedFunctionReadsUnknown(function: int): bool
// Returns whether a function may write unknown storage, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun typedFunctionWritesUnknown(function: int): bool
// Returns whether a function's effect summary contains the named effect, reporting a compile-time error for an invalid handle or effect name.
compile extern:"compiler" fun typedFunctionHasEffect(
    function: int,
    effect: string
): bool

// Returns the path's root kind or reports a compile-time error for a stale or invalid path handle.
compile extern:"compiler" fun typedAccessRootKind(
    path: TypedAccessPath
): string
// Returns the path's root identity or reports a compile-time error for a stale or invalid path handle.
compile extern:"compiler" fun typedAccessRootIdentity(
    path: TypedAccessPath
): string
// Returns the path's recorded root parameter index or reports a compile-time error for a stale or invalid path handle.
compile extern:"compiler" fun typedAccessRootParameter(
    path: TypedAccessPath
): int
// Returns the number of segments after the path root or reports a compile-time error for a stale or invalid path handle.
compile extern:"compiler" fun typedAccessSegmentCount(
    path: TypedAccessPath
): int
// Returns the indexed path segment's kind, reporting a compile-time error for an invalid path or index.
compile extern:"compiler" fun typedAccessSegmentKind(
    path: TypedAccessPath,
    index: int
): string
// Returns the indexed path segment's recorded name, reporting a compile-time error for an invalid path or index.
compile extern:"compiler" fun typedAccessSegmentName(
    path: TypedAccessPath,
    index: int
): string
// Returns the indexed path segment's recorded integer index, reporting a compile-time error for an invalid path or index.
compile extern:"compiler" fun typedAccessSegmentIndex(
    path: TypedAccessPath,
    index: int
): int
// Returns whether the two access paths can overlap, reporting a compile-time error for an invalid path.
compile extern:"compiler" fun typedAccessPathsIntersect(
    left: TypedAccessPath,
    right: TypedAccessPath
): bool

// Records a request while a subparser owns the syntax handle. The finalizer
// runs in the same bounded compile-time machine and returns one virtual module
// which is validated transactionally with the candidate program.
compile extern:"compiler" fun compilerRecordExtensionRequest(
    namespace: string,
    payload: string,
    expression: SyntaxExpression,
    finalizer: (string, SyntaxExpression) -> string
)

// Direct owned-AST finalization. The returned builder never becomes source
// text: its declarations are published with namespace/span provenance into the
// candidate parse result and pass the ordinary semantic/ownership/IR pipeline.
compile extern:"compiler" fun compilerRecordGeneratedExtensionRequest(
    namespace: string,
    payload: string,
    expression: SyntaxExpression,
    finalizer: (string, SyntaxExpression) -> GeneratedModuleBuilder
)

// Builds syntax for an integer literal containing `value`.
compile extern:"parser" fun syntaxInteger(value: int): SyntaxExpression

// Builds syntax for a string literal containing `value`.
compile extern:"parser" fun syntaxString(value: string): SyntaxExpression

// Builds syntax for a boolean literal containing `value`.
compile extern:"parser" fun syntaxBoolean(value: bool): SyntaxExpression

// Builds syntax for the null literal.
compile extern:"parser" fun syntaxNull(): SyntaxExpression

// The same expression as `#value`: evaluate the child at compile time and
// freeze its result into the program. Ordinary compile-time limits, effects
// and value-escape rules apply, including when another subparser builds it.
// Supply a parsed origin when `value` was synthesized without source spans:
// distinct origins keep compile sites distinct and locate their diagnostics.
compile fun syntaxCompile(
    value: SyntaxExpression,
    origin: SyntaxExpression = value
): SyntaxExpression = syntaxCompileAt(value, origin)

// Keep the earlier-parameter default in ordinary Abla code: a routed extern
// receives its explicit handles identically in the interpreter and bridge.
private compile extern:"parser" fun syntaxCompileAt(
    value: SyntaxExpression,
    origin: SyntaxExpression
): SyntaxExpression

// Builds syntax for an identifier spelled `value`. It is resolved when the generated expression is analyzed.
compile extern:"parser" fun syntaxIdentifier(value: string): SyntaxExpression

// Returns a binary expression with the given operator spelling and the supplied left and right syntax.
compile extern:"parser" fun syntaxBinary(
    operation: string,
    left: SyntaxExpression,
    right: SyntaxExpression
): SyntaxExpression

// Builds array literal syntax from the supplied child expressions in order.
compile extern:"parser" fun syntaxArray(
    elements: array<SyntaxExpression>
): SyntaxExpression

// Builds call syntax from the supplied function name and argument expressions. The call is resolved when the generated expression is analyzed.
compile extern:"parser" fun syntaxCall(
    name: string,
    arguments: array<SyntaxExpression>
): SyntaxExpression

// A named argument for a call's argument list: `syntaxCall("f", [syntaxNamedArgument("x", value)])`
// builds what `f(x = value)` parses to, and the ordinary named-argument rules apply. Valid
// only as an element of the argument list of syntaxCall, syntaxCallTarget or
// syntaxMethodCallTarget; anywhere else the subparser fails.
compile extern:"parser" fun syntaxNamedArgument(
    name: string,
    value: SyntaxExpression
): SyntaxExpression

// Returns syntax for accessing the named member on the receiver.
compile extern:"parser" fun syntaxMember(
    receiver: SyntaxExpression,
    name: string
): SyntaxExpression

// Returns syntax for indexing the receiver with the supplied expression.
compile extern:"parser" fun syntaxIndex(
    receiver: SyntaxExpression,
    index: SyntaxExpression
): SyntaxExpression

// Returns conditional syntax with the supplied condition and branches.
compile extern:"parser" fun syntaxIf(
    condition: SyntaxExpression,
    thenExpression: SyntaxExpression,
    elseExpression: SyntaxExpression
): SyntaxExpression

// Returns syntax for returning the supplied value.
compile extern:"parser" fun syntaxReturn(
    value: SyntaxExpression
): SyntaxExpression

// Returns block syntax containing the supplied statements in order.
compile extern:"parser" fun syntaxBlock(
    statements: array<SyntaxExpression>
): SyntaxExpression

// Returns syntax for declaring an immutable local with the supplied name, reflected type, and initializer.
compile extern:"parser" fun syntaxLocal(
    name: string,
    type: int,
    initializer: SyntaxExpression
): SyntaxExpression

// Returns syntax for declaring a mutable local with the supplied name, reflected type, and initializer.
compile extern:"parser" fun syntaxVariable(
    name: string,
    type: int,
    initializer: SyntaxExpression
): SyntaxExpression

// Returns assignment syntax with the supplied target and value.
compile extern:"parser" fun syntaxAssign(
    name: string,
    value: SyntaxExpression
): SyntaxExpression

// Returns lambda syntax with the supplied parameters and body.
compile extern:"parser" fun syntaxLambda(
    parameterNames: array<string>,
    parameterTypes: array<int>,
    body: SyntaxExpression,
    moving: bool
): SyntaxExpression

// Builds the same syntax as a source lambda with unannotated parameters.
// The surrounding callable use supplies their types during ordinary semantic
// analysis, so this form is safe to call from the initial subparser phase.
compile extern:"parser" fun syntaxInferredLambda(
    parameterNames: array<string>,
    body: SyntaxExpression,
    moving: bool
): SyntaxExpression

// Owned, compilation-scoped declaration construction. The builder assigns
// collision-checked deterministic declaration names and retains compiler-owned
// SyntaxExpression trees. Direct finalizers publish those AST declarations
// transactionally; compilerGeneratedModuleSource is the compatibility bridge
// for older source-returning finalizers.
compile extern:"compiler" fun compilerGeneratedModule(
    namespace: string,
    origin: SyntaxExpression
): GeneratedModuleBuilder

// Adds a function to the module and returns its generated name, reporting a compile-time error for invalid signature, body, or builder arguments.
compile extern:"compiler" fun compilerGeneratedFunction(
    module: GeneratedModuleBuilder,
    hint: string,
    parameterNames: array<string>,
    parameterTypes: array<int>,
    resultType: int,
    body: SyntaxExpression
): string

// Creates a generated function by rewriting the listed free identifiers to
// explicit generated parameters. Capture types and mutable modes are checked
// before the ordinary generated-declaration validation pipeline runs.
compile extern:"compiler" fun compilerGeneratedLiftedFunction(
    module: GeneratedModuleBuilder,
    hint: string,
    captureNames: array<string>,
    parameterNames: array<string>,
    parameterTypes: array<int>,
    mutableCaptures: array<bool>,
    resultType: int,
    body: SyntaxExpression
): string

// Deliberate source-visible root. Unlike ordinary generated declarations this
// exact name must be unused in the candidate program.
compile extern:"compiler" fun compilerGeneratedExportFunction(
    module: GeneratedModuleBuilder,
    name: string,
    parameterNames: array<string>,
    parameterTypes: array<int>,
    resultType: int,
    body: SyntaxExpression
): string

// Adds a value to the module and returns its generated name, reporting a compile-time error for an invalid type, initializer, or builder.
compile extern:"compiler" fun compilerGeneratedValue(
    module: GeneratedModuleBuilder,
    hint: string,
    type: int,
    initializer: SyntaxExpression
): string

// Returns the source spelling of a generated module's declarations, reporting a compile-time error for an invalid builder.
compile extern:"compiler" fun compilerGeneratedModuleSource(
    module: GeneratedModuleBuilder
): string

// Publishes compiler-owned generated declarations into a standalone module
// without asking an extension to render, write, or reparse source itself.
compile extern:"compiler" fun compilerIndependentModuleDeclareGenerated(
    destination: int,
    declarations: GeneratedModuleBuilder
): bool

// Returns true when a live independent module accepts the generated declarations, reporting a compile-time error for an invalid module or builder.
compile fun IndependentModule.declareGenerated(
    declarations: GeneratedModuleBuilder
): bool = compilerIndependentModuleDeclareGenerated(
    this.handle, declarations
)

// Returns the number of declarations in the generated module, reporting a compile-time error for an invalid builder.
compile extern:"compiler" fun compilerGeneratedDeclarationCount(
    module: GeneratedModuleBuilder
): int

// Returns the namespace of the indexed generated declaration, reporting a compile-time error for an invalid builder or index.
compile extern:"compiler" fun compilerGeneratedDeclarationNamespace(
    module: GeneratedModuleBuilder,
    declaration: int
): string

// Returns the starting source byte offset for the indexed declaration's origin, reporting a compile-time error for an invalid builder or index.
compile extern:"compiler" fun compilerGeneratedDeclarationOriginBegin(
    module: GeneratedModuleBuilder,
    declaration: int
): int

// Returns the ending source byte offset for the indexed declaration's origin, reporting a compile-time error for an invalid builder or index.
compile extern:"compiler" fun compilerGeneratedDeclarationOriginEnd(
    module: GeneratedModuleBuilder,
    declaration: int
): int

// Unforgeable references to declarations already owned by this builder. The
// ordinal is declaration order within the module, not a source-level name.
compile extern:"compiler" fun compilerGeneratedDeclarationReference(
    module: GeneratedModuleBuilder,
    declaration: int
): SyntaxExpression

// Returns call syntax bound to the indexed generated declaration, reporting a compile-time error for an invalid declaration or argument syntax.
compile extern:"compiler" fun compilerGeneratedDeclarationCall(
    module: GeneratedModuleBuilder,
    declaration: int,
    arguments: array<SyntaxExpression>
): SyntaxExpression

// Builder calls retain the selected declaration handle as compiler-owned
// provenance. Extensions do not reconstruct or reserve a source-level target
// name, and an inherent/extension method must use the receiver-bearing form.
compile extern:"compiler" fun syntaxCallTarget(
    target: int,
    arguments: array<SyntaxExpression>
): SyntaxExpression

// Returns method call syntax bound to a reflected function handle, reporting a compile-time error when the handle or receiver cannot be used.
compile extern:"compiler" fun syntaxMethodCallTarget(
    target: int,
    receiver: SyntaxExpression,
    arguments: array<SyntaxExpression>
): SyntaxExpression
