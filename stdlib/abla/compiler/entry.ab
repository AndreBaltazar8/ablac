compile extern:"compiler" fun compilerGenericInstanceCount(name: string): int

// Returns the indexed concrete instance name of the given generic, reporting a compile-time error for an out-of-range index.
compile extern:"compiler" fun compilerGenericInstanceName(name: string, index: int): string

// Returns the reflected generic instance name, reporting a compile-time error when the spelling or argument count is invalid or a new instance cannot be staged.
compile extern:"compiler" fun compilerInstantiate(spelling: string): string

// Returns the substituted type handle for the indexed generic parameter, reporting a compile-time error for an invalid function handle or index.
compile extern:"compiler" fun compilerFunctionGenericSubstitutionTypeHandle(
