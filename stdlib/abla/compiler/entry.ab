// Internal staging marker consumed by the frontend. Public code uses the
// method-shaped `compiler.transform(...)` surface below.
compile extern:"compiler" fun compilerApplyTransform(
    action: () -> void
): bool

// Public compile-time service. Importing `abla/compiler` makes this single
// object available; the standalone externs above are the version-0 bootstrap
// ABI and are not the preferred user surface.
class Compiler

compile class FunctionReference(
    val handle: int,
    val annotations: array<string>,
    val exportName: string,
    val checkedExport: bool
)

compile class IndependentModule(val handle: int)

compile val compiler: Compiler = Compiler()

compile fun Compiler.transform(action: () -> void): bool =
    compilerApplyTransform(action)

/** The class named `name`'s handle, -1 when there is none. A private class
 *  is found from its own module only. */
compile fun Compiler.findClass(name: string): int = compilerFindClass(name)

/** The type handle of the type spelled `name` (`int`, `array<string>`,
 *  `Square`). In a generic's `#` code, a type parameter `T` is its type
 *  argument's handle. */
compile fun Compiler.findType(name: string): int = compilerFindType(name)

/** The type handle `type`'s spelling (`Box<int>`). */
compile fun Compiler.typeName(type: int): string = compilerTypeName(type)

/** The class of the type handle `type` (a findClass handle), -1 when it is
 *  no class. */
compile fun Compiler.classOf(type: int): int = compilerTypeDeclaration(type)

/** Whether the type handle `type` is a resource (an instance of a generic
 *  class holding one is). */
compile fun Compiler.isResource(type: int): bool = compilerTypeIsAffine(type)

/** Whether the type handle `type` is a class conforming to `interfaceName`
 *  (as conformsTo answers for its class), or is that interface. In a
 *  generic's body, `if (#compiler.typeConformsTo(T, "Hashable")) … else …`
 *  keeps only the branch each instance takes. */
compile fun Compiler.typeConformsTo(type: int, interfaceName: string): bool {
    val declaration = compilerTypeDeclaration(type)
    if (declaration >= 0) return this.conformsTo(declaration, interfaceName)
    // A generic interface's instance as the program spells it (`Source<i64>`).
    var wanted = interfaceName
    for (byte in interfaceName) if (byte == 60) wanted = compilerTypeName(compilerFindType(interfaceName))
    compilerTypeName(type) == wanted
}

/** The type arguments of the type handle `type`, as type handles: an
 *  instance of a generic class's (`Box<int>`: `int`), an array's or a
 *  nullable's element; [] for any other type. */
compile fun Compiler.typeArguments(type: int): array<int> {
    val arguments: array<int> = []
    var index = 0
    while (index < compilerTypeArgumentCount(type)) {
        arguments.append(compilerTypeArgument(type, index))
        index = index + 1
    }
    arguments
}

/** The type arguments of the function handle `function` when it is an
 *  instance of a generic function (or a method of a generic class's
 *  instance), as type handles; [] for any other function. */
compile fun Compiler.functionTypeArguments(function: int): array<int> {
    val arguments: array<int> = []
    var index = 0
    while (index < compilerFunctionGenericSubstitutionCount(function)) {
        arguments.append(compilerFunctionGenericSubstitutionTypeHandle(function, index))
        index = index + 1
    }
    arguments
}

/** The instances of the generic class or function `generic` the program
 *  has, as written (`Box<i64>`): findType, findClass and findFunction take
 *  them. */
compile fun Compiler.instantiations(generic: string): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerGenericInstanceCount(generic)) {
        names.append(compilerGenericInstanceName(generic, index))
        index = index + 1
    }
    names
}

/** The instance of the generic class or function `generic` for
 *  `typeArguments` (`instantiate("Box", ["int"])`), as written (`Box<i64>`).
 *  From a transform it is made with the program's other instances, as if
 *  the program used it; elsewhere it must exist already. */
compile fun Compiler.instantiate(generic: string, typeArguments: array<string>): string {
    var spelling = ""
    for (argument in typeArguments) spelling = if (spelling == "") argument else "$spelling, $argument"
    compilerInstantiate("$generic<$spelling>")
}

/** Whether the declaration (a class or function handle) is `private` to its
 *  module. */
compile fun Compiler.isPrivate(handle: int): bool = compilerIsPrivate(handle)

/** The extension fields of the class `type` (a findClass handle). */
compile fun Compiler.extensionFields(type: int): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerExtensionFieldCount(type)) {
        names.append(compilerExtensionFieldName(type, index))
        index = index + 1
    }
    names
}

/** The class's fields: its declared ones, then (unless left out) its
 *  extension fields. */
compile fun Compiler.fieldsOf(type: int, includeExtensions: bool = true): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerClassFieldCount(type)) {
        names.append(compilerClassFieldName(type, index))
        index = index + 1
    }
    if (includeExtensions) {
        index = 0
        while (index < compilerExtensionFieldCount(type)) {
            names.append(compilerExtensionFieldName(type, index))
            index = index + 1
        }
    }
    names
}

/** Whether the class `type`'s declared field `name` is a delegated property
 *  (`var balance: int by Box(0)`). */
compile fun Compiler.fieldIsDelegated(type: int, name: string): bool {
    var index = 0
    while (index < compilerClassFieldCount(type)) {
        if (compilerClassFieldName(type, index) == name) {
            return compilerClassFieldIsDelegated(type, index)
        }
        index = index + 1
    }
    false
}

/** The delegate's type of the class `type`'s delegated property `name`, ""
 *  for an ordinary field. */
compile fun Compiler.fieldDelegateType(type: int, name: string): string {
    var index = 0
    while (index < compilerClassFieldCount(type)) {
        if (compilerClassFieldName(type, index) == name) {
            return compilerClassFieldDelegateType(type, index)
        }
        index = index + 1
    }
    ""
}

/** From a transform: `var Type.name: fieldType = initial` (`val` when not
 *  mutable), as if the program declared it. */
compile fun Compiler.addExtensionField(
    type: int,
    name: string,
    fieldType: string,
    initial: string,
    mutable: bool = true
): bool = compilerAddExtensionField(type, name, fieldType, initial, mutable)

/** From a transform: removes an extension field the transform's own module
 *  declares. */
compile fun Compiler.removeExtensionField(type: int, name: string): bool =
    compilerRemoveExtensionField(type, name)

/** The interfaces the class `type` (a findClass handle) conforms to: those it
 *  declares, then those `extend` adds. */
compile fun Compiler.conformances(type: int): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerConformanceCount(type)) {
        names.append(compilerConformanceName(type, index))
        index = index + 1
    }
    names
}

/** Whether the class `type` conforms to the interface `interfaceName` (a
 *  generic interface's instance as written: `Source<int>`). */
compile fun Compiler.conformsTo(type: int, interfaceName: string): bool {
    // An instance as conformances spells it (`Source<i64>`).
    var wanted = interfaceName
    for (byte in interfaceName) if (byte == 60) wanted = compilerTypeName(compilerFindType(interfaceName))
    var index = 0
    while (index < compilerConformanceCount(type)) {
        if (compilerConformanceName(type, index) == wanted) return true
        index = index + 1
    }
    false
}

/** The classes that conform to the interface `interfaceName`. */
compile fun Compiler.implementers(interfaceName: string): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerImplementerCount(interfaceName)) {
        names.append(compilerImplementerName(interfaceName, index))
        index = index + 1
    }
    names
}

/** What answers each member of `interfaceName` for the class `type`, as
 *  `member:kind`: `method` (the class's own), `extension` (an extension
 *  function), `default` (the interface's body) or `missing`. */
compile fun Compiler.witness(type: int, interfaceName: string): array<string> {
    val entries: array<string> = []
    var index = 0
    while (index < compilerWitnessCount(type, interfaceName)) {
        entries.append(compilerWitnessEntry(type, interfaceName, index))
        index = index + 1
    }
    entries
}

/** From a transform: `interface name { members }` (each member's source, as
 *  `fun area(): f64` or with a default body), as if the program declared it. */
compile fun Compiler.declareInterface(
    name: string,
    members: array<string>,
    parents: array<string> = []
): bool {
    var memberSource = ""
    for (member in members) memberSource = "$memberSource    $member\n"
    var parentSource = ""
    for (parent in parents) {
        parentSource = if (parentSource == "") parent else "$parentSource, $parent"
    }
    compilerDeclareInterface(name, memberSource, parentSource)
}

/** From a transform: the programmatic `extend Type : interfaceName`. Each of
 *  `members` is a method's source (`fun print(): string = …`, `this` the
 *  instance), added as an extension function of the class. */
compile fun Compiler.addConformance(
    type: int,
    interfaceName: string,
    members: array<string> = []
): bool {
    var memberSource = ""
    for (member in members) memberSource = "$memberSource$member\n"
    compilerAddConformance(type, interfaceName, memberSource)
}

compile fun Compiler.functions(): array<int> {
    val reflected = compilerFunctions()
    val functions: array<int> = []
    var index = 0
    while (index < reflected.size) {
        functions.append(reflected[index])
        index = index + 1
    }
    functions
}

compile fun Compiler.bindings(): array<int> {
    val reflected = compilerBindings()
    val bindings: array<int> = []
    var index = 0
    while (index < reflected.size) {
        bindings.append(reflected[index])
        index = index + 1
    }
    bindings
}

compile fun Compiler.findBinding(name: string): int =
    compilerFindBinding(name)

compile fun Compiler.bindingName(binding: int): string =
    compilerBindingName(binding)

compile fun Compiler.bindingIsDelegated(binding: int): bool =
    compilerBindingIsDelegated(binding)

compile fun Compiler.bindingExposedType(binding: int): string =
    compilerBindingExposedType(binding)

compile fun Compiler.bindingDelegateType(binding: int): string =
    compilerBindingDelegateType(binding)

compile fun Compiler.bindingIsMutable(binding: int): bool =
    compilerBindingIsMutable(binding)

compile fun Compiler.bindingGetter(binding: int): int =
    compilerBindingGetter(binding)

compile fun Compiler.bindingSetter(binding: int): int =
    compilerBindingSetter(binding)

compile fun Compiler.bindingCanReplaceDelegate(binding: int): bool =
    compilerBindingCanReplaceDelegate(binding)

compile fun Compiler.bindingByBegin(binding: int): int =
    compilerBindingByBegin(binding)

compile fun Compiler.bindingByEnd(binding: int): int =
    compilerBindingByEnd(binding)

compile fun Compiler.functionsAnnotated(annotation: string): array<int> {
    val reflected = compilerFunctionsAnnotated(annotation)
    val functions: array<int> = []
    var index = 0
    while (index < reflected.size) {
        functions.append(reflected[index])
        index = index + 1
    }
    functions
}

compile fun Compiler.findFunction(name: string): int =
    compilerFindFunction(name)

// A typed wrapper around a compilation-scoped function handle. Additional
// annotations are immutable metadata applied only to a destination module
// when this reference is used there.
compile fun Compiler.function(name: string): FunctionReference =
    FunctionReference(compilerFindFunction(name), [], "", false)

// Wraps an already reflected function without resolving it again by name.
// This is the preferred bridge from functionsAnnotated() and typed call
// inspection into an independent module.
compile fun Compiler.reference(handle: int): FunctionReference =
    FunctionReference(handle, [], "", false)

compile fun FunctionReference.annotated(
    annotation: string
): FunctionReference {
    val annotations: array<string> = []
    var index = 0
    while (index < this.annotations.size) {
        annotations.append(this.annotations[index])
        index = index + 1
    }
    annotations.append(annotation)
    FunctionReference(
        this.handle,
        annotations,
        this.exportName,
        this.checkedExport
    )
}

// Marks the destination copy as a foreign artifact root. The source function
// keeps its Abla name; only the standalone module receives this export name.
compile fun FunctionReference.exported(name: string): FunctionReference =
    FunctionReference(this.handle, this.annotations, name, false)

compile fun FunctionReference.checkedExported(
    name: string
): FunctionReference =
    FunctionReference(this.handle, this.annotations, name, true)

compile fun Compiler.newModule(name: string): IndependentModule =
    IndependentModule(compilerNewIndependentModule(name))

compile fun IndependentModule.use(function: FunctionReference): bool =
    compilerIndependentModuleUse(
        this.handle,
        function.handle,
        function.annotations,
        function.exportName,
        function.checkedExport
    )

// Exports a declaration added by declare(), including a name returned by a
// compiler-owned generated-declaration builder. Existing declarations should
// normally use FunctionReference.exported() so their handle remains typed.
compile fun IndependentModule.export(
    sourceName: string,
    name: string,
    checked: bool = false
): bool = compilerIndependentModuleExport(
    this.handle, sourceName, name, checked
)

compile fun IndependentModule.declare(
    declarations: DeclarationBlock
): bool = compilerIndependentModuleDeclare(this.handle, declarations)

compile fun IndependentModule.emit(
    output: string,
    target: string = "host",
    artifact: string = "executable",
    fast: bool = false,
    cache: bool = true
): bool = compilerIndependentModuleEmit(
    this.handle, output, target, artifact, fast, cache
)

compile fun Compiler.functionName(function: int): string =
    compilerFunctionName(function)

compile fun Compiler.functionIdentity(function: int): string =
    compilerFunctionCanonicalIdentity(function)

compile fun Compiler.functionModuleIdentity(function: int): string =
    compilerFunctionModuleIdentity(function)

compile fun Compiler.functionOwner(function: int): string =
    compilerFunctionOwner(function)

compile fun Compiler.parameterCount(function: int): int =
    compilerFunctionParameterCount(function)

compile fun Compiler.parameterName(function: int, parameter: int): string =
    compilerFunctionParameterName(function, parameter)

compile fun Compiler.parameterType(function: int, parameter: int): string =
    compilerFunctionParameterType(function, parameter)

compile fun Compiler.resultType(function: int): string =
    compilerFunctionResultType(function)

compile fun Compiler.annotationCount(function: int): int =
    compilerFunctionAnnotationCount(function)

compile fun Compiler.annotation(function: int, annotation: int): string =
    compilerFunctionAnnotation(function, annotation)

compile fun Compiler.annotationArgumentCount(
    function: int,
    annotation: int
): int = compilerFunctionAnnotationArgumentCount(function, annotation)

compile fun Compiler.annotationArgumentKind(
    function: int,
    annotation: int,
    argument: int = 0
): string = compilerFunctionAnnotationArgumentKind(
    function, annotation, argument
)

compile fun Compiler.annotationArgumentText(
    function: int,
    annotation: int,
    argument: int = 0
): string = compilerFunctionAnnotationArgumentText(
    function, annotation, argument
)

compile fun Compiler.isCompileOnly(function: int): bool =
    compilerFunctionIsCompileOnly(function)

compile fun Compiler.isTrusted(function: int): bool =
    compilerFunctionIsTrusted(function)

compile fun Compiler.isExternal(function: int): bool =
    compilerFunctionIsExternal(function)

compile fun Compiler.replaceFunctionBody(
    function: int,
    body: string
): bool = compilerReplaceFunctionBody(function, body)

compile fun Compiler.addFunctionAnnotation(
    function: int,
    annotation: string
): bool = compilerAddFunctionAnnotation(function, annotation)

compile fun Compiler.generateModule(namespace: string, source: string) =
    compilerGenerateModule(namespace, source)

compile fun Compiler.writeFile(path: string, contents: string): bool =
    compilerWriteFile(path, contents)

compile fun Compiler.buildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool = compilerBuildProgram(
    name, entry, output, target, artifact, fast, cache
)

compile fun Compiler.defineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool = compilerDefineTarget(
    name, llvmTriple, objectFormat, linkerFlavor, linkerEmulation,
    hosted, libcFree
)

compile fun Compiler.contributeArtifactRoot(
    name: string,
    target: string,
    artifact: string,
    output: string,
    function: int,
    exportName: string,
    fast: bool,
    cache: bool
): bool = compilerContributeArtifactRoot(
    name, target, artifact, output, function, exportName, fast, cache
)

compile fun Compiler.exportFunction(function: int, name: string): bool =
    compilerExportFunction(function, name)

compile fun Compiler.internalFunction(function: int, name: string): bool =
    compilerInternalFunction(function, name)

compile fun Compiler.requiredInternalFunction(
    function: int,
