compile extern:"compiler" fun compilerReplaceFunctionBody(
    function: int,
    body: string
): bool

compile extern:"compiler" fun compilerAddFunctionAnnotation(
    function: int,
    annotation: string
): bool

// Independent program construction. DeclarationBlock is an opaque syntax
// value produced by a trailing `{ fun ... }` declaration block; it cannot be
// constructed or consumed as a runtime value.
compile class DeclarationBlock

compile extern:"compiler" fun compilerNewIndependentModule(name: string): int

compile extern:"compiler" fun compilerIndependentModuleUse(
    module: int,
    function: int,
    annotations: array<string>,
    exportName: string,
    checkedExport: bool
): bool

