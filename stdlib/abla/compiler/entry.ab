// Returns the reflected type's canonical module prefix, which may be empty, and reports a compile-time error for an invalid type handle.
compile extern:"compiler" fun compilerTypeModuleIdentity(handle: int): string

// Returns the number of annotations attached to the function or reports a compile-time error for an invalid handle.
