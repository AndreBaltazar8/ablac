// Structured, compilation-scoped type reflection. Handles are opaque indexes
// into an interned canonical type table and never expose semantic pointers.
compile extern:"compiler" fun compilerFindType(name: string): int

compile extern:"compiler" fun compilerTypeName(handle: int): string

compile extern:"compiler" fun compilerTypeKind(handle: int): string

compile extern:"compiler" fun compilerTypeIsNullable(handle: int): bool

compile extern:"compiler" fun compilerTypeIsAffine(handle: int): bool

compile extern:"compiler" fun compilerTypeArgumentCount(handle: int): int

compile extern:"compiler" fun compilerTypeArgument(
    handle: int,
    argument: int
): int

compile extern:"compiler" fun compilerTypeElement(handle: int): int

compile extern:"compiler" fun compilerTypeResult(handle: int): int

// Returns the nominal class declaration handle, or -1 for non-class types.
compile extern:"compiler" fun compilerTypeDeclaration(handle: int): int

compile extern:"compiler" fun compilerFunctionParameterTypeHandle(
    handle: int,
    parameter: int
): int

compile extern:"compiler" fun compilerFunctionResultTypeHandle(
    handle: int
): int

// Reserved generic-substitution surface. It returns zero for today's
// non-generic declarations and becomes populated without an API break when
// selected-call generics are introduced.
compile extern:"compiler" fun compilerFunctionGenericSubstitutionCount(
    handle: int
): int

compile extern:"compiler" fun compilerFunctionGenericSubstitutionName(
    handle: int,
    substitution: int
): string

compile extern:"compiler" fun compilerFunctionGenericSubstitutionTypeHandle(
    handle: int,
    substitution: int
): int

compile extern:"compiler" fun compilerClassFieldTypeHandle(
    handle: int,
    field: int
): int

// Declares a non-hermetic compile-time input in source. The grant is part of
// the bundled-source fingerprint; builds without it deny ambient effects.
compile extern:"compiler" fun compilerGrant(capability: string)

// Reads one explicitly named build environment input. The compiler journals
// the observed value, so a native-object cache hit is valid only while that
// variable remains unchanged. Missing variables produce an empty string.
compile extern:"compiler" fun compilerEnvironment(name: string): string

// Stages one project-relative output. Absolute paths, `.`/`..` components,
// more than 64 outputs, individual payloads above 16 MiB, and transactions
// above 64 MiB are rejected. Publication occurs only after a successful build.
compile extern:"compiler" fun compilerWriteFile(
    path: string,
    contents: string
): bool

// Explicitly ambient providers. Unlike named environment inputs, their grants
// intentionally make native-object publication non-cacheable.
compile extern:"compiler" fun compilerClockMilliseconds(): int

compile extern:"compiler" fun compilerRandomInteger(maxExclusive: int): int

compile extern:"compiler" fun compilerRunProcess(
    arguments: array<string>
): int

// Performs one numeric-IPv4 TCP request/response exchange. Payload/response
// are capped at 1 MiB and the connect/read timeout at ten seconds. Network
// capability always disables native-object caching.
compile extern:"compiler" fun compilerTcpExchange(
    ipv4Address: string,
    port: int,
    request: string,
    maxResponseBytes: int,
    timeoutMilliseconds: int
): string

// Submits one deterministic virtual module. It is parsed and checked with the
// complete candidate program; no declarations are published after a failure.
compile extern:"compiler" fun compilerGenerateModule(
    namespace: string,
    source: string
)

// Adds one program node to the current programmable build transaction. Paths
// are project-relative. The compiler evaluates the complete build definition
// first, validates the resulting graph, and only then compiles its nodes.
// Artifact kinds and target names are interpreted by the selected toolchain,
// not by platform-specific logic in the language frontend.
compile extern:"compiler" fun compilerBuildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool

// Adds one exact resolved function root to a named child artifact. Repeated
// contributions with the same artifact configuration are aggregated into one
// target compilation and exported under their explicit foreign names.
compile extern:"compiler" fun compilerContributeArtifactRoot(
    name: string,
    target: string,
    artifact: string,
    output: string,
    function: int,
    exportName: string,
    fast: bool,
    cache: bool
): bool

// Registers one bounded target description for program nodes in the current
// build graph. Platform packages own these values; the compiler interprets
// only generic LLVM/object/linker properties.
compile extern:"compiler" fun compilerDefineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool

// Publishes a stable foreign symbol for a resolved top-level function. The
// The ABI rung accepts bounded scalar, copied borrowed-string, and direct
// non-escaping callback parameters and returns void, scalars, or an owned byte
// handle for string. No internal Abla value layout crosses the boundary.
compile extern:"compiler" fun compilerExportFunction(
    function: int,
    name: string
): bool

// Publishes a status-returning adapter that contains Abla panics on targets
// advertising the checked-export runtime capability.
compile extern:"compiler" fun compilerExportCheckedFunction(
    function: int,
    name: string
): bool

// Validated source mutation is collected only while a top-level
// `#compiler.transform(...)` action is running. The candidate program is
// parsed and analyzed again before any artifact can be published.
compile extern:"compiler" fun compilerReplaceFunctionBody(
    function: int,
    body: string
): bool

// Internal staging marker consumed by the frontend. Public code uses the
// method-shaped `compiler.transform(...)` surface below.
compile extern:"compiler" fun compilerApplyTransform(
    action: () -> void
): bool

// Public compile-time service. Importing `abla/compiler` makes this single
// object available; the standalone externs above are the version-0 bootstrap
// ABI and are not the preferred user surface.
class Compiler

compile val compiler: Compiler = Compiler()

compile fun Compiler.transform(action: () -> void): bool =
    compilerApplyTransform(action)

compile fun Compiler.functions(): array<int> {
    val reflected = compilerFunctions()
    val functions: array<int> = []
    var index = 0
    while (index < reflected.size) {
        functions.append(reflected[index])
        index = index + 1
    }
    functions
}

compile fun Compiler.functionsAnnotated(annotation: string): array<int> {
    val reflected = compilerFunctionsAnnotated(annotation)
    val functions: array<int> = []
    var index = 0
    while (index < reflected.size) {
        functions.append(reflected[index])
        index = index + 1
    }
    functions
}

compile fun Compiler.findFunction(name: string): int =
    compilerFindFunction(name)

compile fun Compiler.functionName(function: int): string =
    compilerFunctionName(function)

compile fun Compiler.functionIdentity(function: int): string =
    compilerFunctionCanonicalIdentity(function)

compile fun Compiler.functionOwner(function: int): string =
    compilerFunctionOwner(function)

compile fun Compiler.parameterCount(function: int): int =
    compilerFunctionParameterCount(function)

compile fun Compiler.parameterName(function: int, parameter: int): string =
    compilerFunctionParameterName(function, parameter)

compile fun Compiler.parameterType(function: int, parameter: int): string =
    compilerFunctionParameterType(function, parameter)

compile fun Compiler.resultType(function: int): string =
    compilerFunctionResultType(function)

compile fun Compiler.annotationCount(function: int): int =
    compilerFunctionAnnotationCount(function)

compile fun Compiler.annotation(function: int, annotation: int): string =
    compilerFunctionAnnotation(function, annotation)

compile fun Compiler.isCompileOnly(function: int): bool =
    compilerFunctionIsCompileOnly(function)

compile fun Compiler.isTrusted(function: int): bool =
    compilerFunctionIsTrusted(function)

compile fun Compiler.isExternal(function: int): bool =
    compilerFunctionIsExternal(function)

compile fun Compiler.replaceFunctionBody(
    function: int,
    body: string
): bool = compilerReplaceFunctionBody(function, body)

compile fun Compiler.generateModule(namespace: string, source: string) =
    compilerGenerateModule(namespace, source)

compile fun Compiler.writeFile(path: string, contents: string): bool =
    compilerWriteFile(path, contents)

compile fun Compiler.buildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool = compilerBuildProgram(
    name, entry, output, target, artifact, fast, cache
)

compile fun Compiler.defineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool = compilerDefineTarget(
    name, llvmTriple, objectFormat, linkerFlavor, linkerEmulation,
    hosted, libcFree
)

compile fun Compiler.contributeArtifactRoot(
    name: string,
    target: string,
    artifact: string,
    output: string,
    function: int,
    exportName: string,
    fast: bool,
    cache: bool
): bool = compilerContributeArtifactRoot(
    name, target, artifact, output, function, exportName, fast, cache
)

compile fun Compiler.exportFunction(function: int, name: string): bool =
    compilerExportFunction(function, name)

compile fun Compiler.exportCheckedFunction(
    function: int,
    name: string
): bool = compilerExportCheckedFunction(function, name)
