// Returns the source spelling of a reflected type or reports a compile-time error for an invalid type handle.
compile extern:"compiler" fun compilerTypeName(handle: int): string

// Returns the reflected type's category, such as `array` or `nullable`, or reports a compile-time error for an invalid handle.
compile extern:"compiler" fun compilerTypeKind(handle: int): string

// Returns whether the reflected type permits null, reporting a compile-time error for an invalid type handle.
compile extern:"compiler" fun compilerTypeIsNullable(handle: int): bool

// Returns whether the reflected type is affine, reporting a compile-time error for an invalid type handle.
compile extern:"compiler" fun compilerTypeIsAffine(handle: int): bool

// Returns the number of reflected type arguments or function parameter types, reporting a compile-time error for an invalid type handle.
compile extern:"compiler" fun compilerTypeArgumentCount(handle: int): int

