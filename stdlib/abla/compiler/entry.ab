    arguments: array<string>
): int

// Performs one numeric-IPv4 TCP request/response exchange. Payload/response
// are capped at 1 MiB and the connect/read timeout at ten seconds. Network
// capability always disables native-object caching.
compile extern:"compiler" fun compilerTcpExchange(
    ipv4Address: string,
    port: int,
    request: string,
    maxResponseBytes: int,
    timeoutMilliseconds: int
): string

// Submits one deterministic virtual module. It is parsed and checked with the
// complete candidate program; no declarations are published after a failure.
compile extern:"compiler" fun compilerGenerateModule(
    namespace: string,
    source: string
)

// Adds one program node to the current programmable build transaction. Paths
// are project-relative. The compiler evaluates the complete build definition
// first, validates the resulting graph, and only then compiles its nodes.
// Artifact kinds and target names are interpreted by the selected toolchain,
// not by platform-specific logic in the language frontend.
compile extern:"compiler" fun compilerBuildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool

// Adds one exact resolved function root to a named child artifact. Repeated
// contributions with the same artifact configuration are aggregated into one
// target compilation and exported under their explicit foreign names.
compile extern:"compiler" fun compilerContributeArtifactRoot(
    name: string,
    target: string,
    artifact: string,
    output: string,
    function: int,
    exportName: string,
    fast: bool,
    cache: bool
): bool

// Registers one bounded target description for program nodes in the current
// build graph. Platform packages own these values; the compiler interprets
// only generic LLVM/object/linker properties.
compile extern:"compiler" fun compilerDefineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool

// Publishes a stable foreign symbol for a resolved top-level function. The
// The ABI rung accepts bounded scalar, copied borrowed-string, and direct
// non-escaping callback parameters and returns void, scalars, or an owned byte
// handle for string. No internal Abla value layout crosses the boundary.
compile extern:"compiler" fun compilerExportFunction(
    function: int,
    name: string
): bool

// Emits the same stable foreign ABI adapter with LLVM internal linkage. It is
// retained for assembly references but is not a public object-file boundary.
compile extern:"compiler" fun compilerInternalFunction(
    function: int,
    name: string
): bool

// Provides an internally linked implementation for an exact symbol that may
// be introduced only during target lowering, after Abla reachability has been
