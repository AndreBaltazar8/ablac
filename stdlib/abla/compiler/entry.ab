): int

// Declares a non-hermetic compile-time input in source. The grant is part of
// the bundled-source fingerprint; builds without it deny ambient effects.
compile extern:"compiler" fun compilerGrant(capability: string)

// Reads one explicitly named build environment input. The compiler journals
// the observed value, so a native-object cache hit is valid only while that
// variable remains unchanged. Missing variables produce an empty string.
compile extern:"compiler" fun compilerEnvironment(name: string): string

// Writes one project-relative file, at once (a real write, as abla/fs writes are
// under `#`): it is on disk when the call returns, and stays there if the build
// fails later. Absolute paths, `.`/`..` components, payloads above 16 MiB and
// more than 256 MiB in one build are rejected. The file is written beside its
// target and renamed over it.
compile extern:"compiler" fun compilerWriteFile(
    path: string,
    contents: string
): bool

// Explicitly ambient providers. Unlike named environment inputs, their grants
// intentionally make native-object publication non-cacheable.
compile extern:"compiler" fun compilerClockMilliseconds(): int

// Returns a random integer in `[0, maxExclusive)`, reporting a compile-time error if the bound is nonpositive or random access is not granted.
compile extern:"compiler" fun compilerRandomInteger(maxExclusive: int): int

// Returns the child process status, reporting a compile-time error if process access is not granted or the argument vector is invalid.
compile extern:"compiler" fun compilerRunProcess(
    arguments: array<string>
): int

// Captures at most 1 MiB with a deadline of at most ten seconds. Uses the build
// environment unchanged, closed stdin and inherited stderr. No shell is added.
// failure is empty for normal exits (including nonzero exits); otherwise it is
// launch, timeout, output-limit, signal, read or wait. Failed captures return no
// stdout. bytesRead counts observed stdout bytes, at most maxStdoutBytes + 1;
// output-limit means at least that many bytes, not the child's total output.
class CompilerProcessResult(
    val exitCode: int,
    val stdout: string,
    val failure: string,
    val bytesRead: int
)

// Returns bounded stdout and process status or failure details, reporting a compile-time error for invalid arguments or missing process access.
compile extern:"compiler" fun compilerCaptureProcess(
    arguments: array<string>,
    maxStdoutBytes: int = 1048576,
    timeoutMilliseconds: int = 10000
): CompilerProcessResult

// Performs one numeric-IPv4 TCP request/response exchange. Payload/response
// are capped at 1 MiB and the connect/read timeout at ten seconds. Network
// capability always disables native-object caching.
compile extern:"compiler" fun compilerTcpExchange(
    ipv4Address: string,
    port: int,
    request: string,
    maxResponseBytes: int,
    timeoutMilliseconds: int
): string

// Submits one deterministic virtual module. It is parsed and checked with the
// complete candidate program; no declarations are published after a failure.
compile extern:"compiler" fun compilerGenerateModule(
    namespace: string,
    source: string
)

// Adds one program node to the current programmable build transaction. Paths
// are project-relative. The compiler evaluates the complete build definition
// first, validates the resulting graph, and only then compiles its nodes.
// Artifact kinds and target names are interpreted by the selected toolchain,
// not by platform-specific logic in the language frontend.
compile extern:"compiler" fun compilerBuildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool

// Adds one exact resolved function root to a named child artifact. Repeated
// contributions with the same artifact configuration are aggregated into one
// target compilation and exported under their explicit foreign names.
compile extern:"compiler" fun compilerContributeArtifactRoot(
    name: string,
    target: string,
    artifact: string,
    output: string,
    function: int,
    exportName: string,
    fast: bool,
    cache: bool
): bool

// Registers one bounded target description for program nodes in the current
// build graph. Platform packages own these values; the compiler interprets
// only generic LLVM/object/linker properties.
compile extern:"compiler" fun compilerDefineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool

// Selects an Apple SDK for an already registered target.
compile extern:"compiler" fun compilerDefineTargetSdk(
    name: string,
    sdk: string
): bool

// Adds an input to the shared-library link of an already registered ELF target (an absolute, one-line path; at most
// 16 per target; they follow the object in the order given). The target's build extension finds them at build time,
// for example a platform's runtime archive.
compile extern:"compiler" fun compilerDefineTargetLinkInput(
    name: string,
    path: string
): bool

// Stages packaging after all program nodes succeed. The bool means accepted.
compile extern:"compiler" fun compilerCreateXcframework(
    output: string,
    slices: array<string>,
    headersDirectory: string
): bool

// Publishes a stable foreign symbol for a resolved top-level function. The
// The ABI rung accepts bounded scalar, copied borrowed-string, and direct
// non-escaping callback parameters and returns void, scalars, or an owned byte
// handle for string. No internal Abla value layout crosses the boundary.
compile extern:"compiler" fun compilerExportFunction(
    function: int,
    name: string
): bool

// Emits the same stable foreign ABI adapter with LLVM internal linkage. It is
// retained for assembly references but is not a public object-file boundary.
compile extern:"compiler" fun compilerInternalFunction(
    function: int,
    name: string
): bool

// Provides an internally linked implementation for an exact symbol that may
// be introduced only during target lowering, after Abla reachability has been
// computed. Unlike an ordinary internalFunction edge, this request itself is
// sufficient to retain the implementation.
compile extern:"compiler" fun compilerRequiredInternalFunction(
    function: int,
    name: string
): bool

// Publishes a status-returning adapter that contains Abla panics on targets
// advertising the checked-export runtime capability.
compile extern:"compiler" fun compilerExportCheckedFunction(
    function: int,
    name: string
): bool

// Validated source mutation is collected only while a top-level
// `#compiler.transform(...)` action is running. The candidate program is
// parsed and analyzed again before any artifact can be published.
compile extern:"compiler" fun compilerReplaceFunctionBody(
    function: int,
    body: string
): bool

// Returns true when a transform stages a new annotation on the function, reporting a compile-time error for invalid or duplicate annotations or requests outside a transform.
compile extern:"compiler" fun compilerAddFunctionAnnotation(
    function: int,
    annotation: string
): bool

// Independent program construction. DeclarationBlock is an opaque syntax
// value produced by a trailing `{ fun ... }` declaration block; it cannot be
// constructed or consumed as a runtime value.
compile class DeclarationBlock

// Returns a handle for a new independent module, reporting a compile-time error for an invalid or duplicate module name.
compile extern:"compiler" fun compilerNewIndependentModule(name: string): int

// Returns true if a live independent module accepts the function and metadata, reporting a compile-time error for invalid handles, annotations, or exports.
compile extern:"compiler" fun compilerIndependentModuleUse(
    module: int,
    function: int,
    annotations: array<string>,
    exportName: string,
    checkedExport: bool
): bool

// Returns true if a live independent module accepts the foreign export, reporting a compile-time error for an invalid or duplicate export.
compile extern:"compiler" fun compilerIndependentModuleExport(
    module: int,
    sourceName: string,
    exportName: string,
    checked: bool
): bool

// Returns true if the live independent module accepts the compile-time declaration block, reporting a compile-time error for an invalid module or block.
compile extern:"compiler" fun compilerIndependentModuleDeclare(
    module: int,
    declarations: DeclarationBlock
): bool

// Returns true if the compiler stages emission of a live module with the given output and target settings, reporting a compile-time error for an invalid request.
compile extern:"compiler" fun compilerIndependentModuleEmit(
    module: int,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool

// Internal staging marker consumed by the frontend. Public code uses the
// method-shaped `compiler.transform(...)` surface below.
compile extern:"compiler" fun compilerApplyTransform(
    action: () -> void
): bool

// Public compile-time service. Importing `abla/compiler` makes this single
// object available; the standalone externs above are the version-0 bootstrap
// ABI and are not the preferred user surface.
class Compiler

// A compile-time function handle with annotations and foreign export metadata for an independent module.
compile class FunctionReference(
    val handle: int,
    val annotations: array<string>,
    val exportName: string,
    val checkedExport: bool
)

// A compile-time handle for an independent module that accepts declarations before emission.
compile class IndependentModule(val handle: int)

// The compile-time service for reflecting on declarations, transforming a program, and scheduling builds.
compile val compiler: Compiler = Compiler()

// Runs `action` as a compile-time transform. Returns whether the compiler accepted the resulting program.
compile fun Compiler.transform(action: () -> void): bool =
    compilerApplyTransform(action)

/** The class named `name`'s handle, -1 when there is none. A private class
 *  is found from its own module only. */
compile fun Compiler.findClass(name: string): int = compilerFindClass(name)

/** The type handle of the type spelled `name` (`int`, `array<string>`,
 *  `Square`). In a generic's `#` code, a type parameter `T` is its type
 *  argument's handle. */
compile fun Compiler.findType(name: string): int = compilerFindType(name)

/** The type handle `type`'s spelling (`Box<int>`). */
compile fun Compiler.typeName(type: int): string = compilerTypeName(type)

/** The class of the type handle `type` (a findClass handle), -1 when it is
 *  no class. */
compile fun Compiler.classOf(type: int): int = compilerTypeDeclaration(type)

/** Whether the type handle `type` is a resource (an instance of a generic
 *  class holding one is). */
compile fun Compiler.isResource(type: int): bool = compilerTypeIsAffine(type)

/** Whether the type handle `type` is a class conforming to `interfaceName`
 *  (as conformsTo answers for its class), or is that interface. In a
 *  generic's body, `if (#compiler.typeConformsTo(T, "Hashable")) … else …`
 *  keeps only the branch each instance takes. */
compile fun Compiler.typeConformsTo(type: int, interfaceName: string): bool {
    val declaration = compilerTypeDeclaration(type)
    if (declaration >= 0) return this.conformsTo(declaration, interfaceName)
    // A generic interface's instance as the program spells it (`Source<i64>`).
    var wanted = interfaceName
    for (byte in interfaceName) if (byte == 60) wanted =
        compilerTypeName(compilerFindType(interfaceName))
    compilerTypeName(type) == wanted
}

/** The type arguments of the type handle `type`, as type handles: an
 *  instance of a generic class's (`Box<int>`: `int`), an array's or a
 *  nullable's element; [] for any other type. */
compile fun Compiler.typeArguments(type: int): array<int> {
    val arguments: array<int> = []
    var index = 0
    while (index < compilerTypeArgumentCount(type)) {
        arguments.append(compilerTypeArgument(type, index))
        index = index + 1
    }
    arguments
}

/** The type arguments of the function handle `function` when it is an
 *  instance of a generic function (or a method of a generic class's
 *  instance), as type handles; [] for any other function. */
compile fun Compiler.functionTypeArguments(function: int): array<int> {
    val arguments: array<int> = []
    var index = 0
    while (index < compilerFunctionGenericSubstitutionCount(function)) {
        arguments.append(compilerFunctionGenericSubstitutionTypeHandle(function, index))
        index = index + 1
    }
    arguments
}

/** The instances of the generic class or function `generic` the program
 *  has, as written (`Box<i64>`): findType, findClass and findFunction take
 *  them. */
compile fun Compiler.instantiations(generic: string): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerGenericInstanceCount(generic)) {
        names.append(compilerGenericInstanceName(generic, index))
        index = index + 1
    }
    names
}

/** The instance of the generic class or function `generic` for
 *  `typeArguments` (`instantiate("Box", ["int"])`), as written (`Box<i64>`).
 *  From a transform it is made with the program's other instances, as if
 *  the program used it; elsewhere it must exist already. */
compile fun Compiler.instantiate(generic: string, typeArguments: array<string>): string {
    var spelling = ""
    for (argument in typeArguments) spelling = if (spelling ==
        "") argument else "$spelling, $argument"
    compilerInstantiate("$generic<$spelling>")
}

/** Whether the declaration (a class or function handle) is `private` to its
 *  module. */
compile fun Compiler.isPrivate(handle: int): bool = compilerIsPrivate(handle)

/** The extension fields of the class `type` (a findClass handle). */
compile fun Compiler.extensionFields(type: int): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerExtensionFieldCount(type)) {
        names.append(compilerExtensionFieldName(type, index))
        index = index + 1
    }
    names
}

/** The class's fields: its declared ones, then (unless left out) its
 *  extension fields. */
compile fun Compiler.fieldsOf(type: int, includeExtensions: bool = true): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerClassFieldCount(type)) {
        names.append(compilerClassFieldName(type, index))
        index = index + 1
    }
    if (includeExtensions) {
        index = 0
        while (index < compilerExtensionFieldCount(type)) {
            names.append(compilerExtensionFieldName(type, index))
            index = index + 1
        }
    }
    names
}

/** Whether the class `type`'s declared field `name` is a delegated property
 *  (`var balance: int by Box(0)`). */
compile fun Compiler.fieldIsDelegated(type: int, name: string): bool {
    var index = 0
    while (index < compilerClassFieldCount(type)) {
        if (compilerClassFieldName(type, index) == name) {
            return compilerClassFieldIsDelegated(type, index)
        }
        index = index + 1
    }
    false
}

/** The delegate's type of the class `type`'s delegated property `name`, ""
 *  for an ordinary field. */
compile fun Compiler.fieldDelegateType(type: int, name: string): string {
    var index = 0
    while (index < compilerClassFieldCount(type)) {
        if (compilerClassFieldName(type, index) == name) {
            return compilerClassFieldDelegateType(type, index)
        }
        index = index + 1
    }
    ""
}

/** From a transform: `var Type.name: fieldType = initial` (`val` when not
 *  mutable), as if the program declared it. */
compile fun Compiler.addExtensionField(
    type: int,
    name: string,
    fieldType: string,
    initial: string,
    mutable: bool = true
): bool = compilerAddExtensionField(type, name, fieldType, initial, mutable)

/** From a transform: removes an extension field the transform's own module
 *  declares. */
compile fun Compiler.removeExtensionField(type: int, name: string): bool =
    compilerRemoveExtensionField(type, name)

/** The interfaces the class `type` (a findClass handle) conforms to: those it
 *  declares, then those `extend` adds. */
compile fun Compiler.conformances(type: int): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerConformanceCount(type)) {
        names.append(compilerConformanceName(type, index))
        index = index + 1
    }
    names
}

/** Whether the class `type` conforms to the interface `interfaceName` (a
 *  generic interface's instance as written: `Source<int>`). */
compile fun Compiler.conformsTo(type: int, interfaceName: string): bool {
    // An instance as conformances spells it (`Source<i64>`).
    var wanted = interfaceName
    for (byte in interfaceName) if (byte == 60) wanted =
        compilerTypeName(compilerFindType(interfaceName))
    var index = 0
    while (index < compilerConformanceCount(type)) {
        if (compilerConformanceName(type, index) == wanted) return true
        index = index + 1
    }
    false
}

/** The classes that conform to the interface `interfaceName`. */
compile fun Compiler.implementers(interfaceName: string): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < compilerImplementerCount(interfaceName)) {
        names.append(compilerImplementerName(interfaceName, index))
        index = index + 1
    }
    names
}

/** What answers each member of `interfaceName` for the class `type`, as
 *  `member:kind`: `method` (the class's own), `extension` (an extension
 *  function), `default` (the interface's body) or `missing`. */
compile fun Compiler.witness(type: int, interfaceName: string): array<string> {
    val entries: array<string> = []
    var index = 0
    while (index < compilerWitnessCount(type, interfaceName)) {
        entries.append(compilerWitnessEntry(type, interfaceName, index))
        index = index + 1
    }
    entries
}

/** From a transform: `interface name { members }` (each member's source, as
 *  `fun area(): f64` or with a default body), as if the program declared it. */
compile fun Compiler.declareInterface(
    name: string,
    members: array<string>,
    parents: array<string> = []
): bool {
    var memberSource = ""
    for (member in members) memberSource = "$memberSource    $member\n"
    var parentSource = ""
    for (parent in parents) {
        parentSource = if (parentSource == "") parent else "$parentSource, $parent"
    }
    compilerDeclareInterface(name, memberSource, parentSource)
}

/** From a transform: the programmatic `extend Type : interfaceName`. Each of
 *  `members` is a method's source (`fun print(): string = …`, `this` the
 *  instance), added as an extension function of the class. */
compile fun Compiler.addConformance(
    type: int,
    interfaceName: string,
    members: array<string> = []
): bool {
    var memberSource = ""
    for (member in members) memberSource = "$memberSource$member\n"
    compilerAddConformance(type, interfaceName, memberSource)
}

// Returns the available function handles as a fresh array. Use them within this compilation.
compile fun Compiler.functions(): array<int> {
    val reflected = compilerFunctions()
    val functions: array<int> = []
    var index = 0
    while (index < reflected.size) {
        functions.append(reflected[index])
        index = index + 1
    }
    functions
}

// Returns the available binding handles as a fresh array. Use them within this compilation.
compile fun Compiler.bindings(): array<int> {
    val reflected = compilerBindings()
    val bindings: array<int> = []
    var index = 0
    while (index < reflected.size) {
        bindings.append(reflected[index])
        index = index + 1
    }
    bindings
}

// Returns the handle of the last top-level binding named `name`, or -1 if none exists.
compile fun Compiler.findBinding(name: string): int =
    compilerFindBinding(name)

// Returns the name of a top-level binding, reporting a compile-time error for an invalid handle.
compile fun Compiler.bindingName(binding: int): string =
    compilerBindingName(binding)

// Returns whether the binding uses `by`, reporting a compile-time error for an invalid handle.
compile fun Compiler.bindingIsDelegated(binding: int): bool =
    compilerBindingIsDelegated(binding)

// Returns the source-visible type of the binding's value, reporting a compile-time error for an invalid handle.
compile fun Compiler.bindingExposedType(binding: int): string =
    compilerBindingExposedType(binding)

// Returns the source-visible type of the delegate, or an empty string for an ordinary binding, and rejects invalid handles.
compile fun Compiler.bindingDelegateType(binding: int): string =
    compilerBindingDelegateType(binding)

// Returns whether the binding was declared with `var`, reporting a compile-time error for an invalid handle.
compile fun Compiler.bindingIsMutable(binding: int): bool =
    compilerBindingIsMutable(binding)

// Returns the delegate's `getValue` handle or -1 when unavailable, and rejects invalid binding handles.
compile fun Compiler.bindingGetter(binding: int): int =
    compilerBindingGetter(binding)

// Returns the delegate's `setValue` handle or -1 when unavailable, and rejects invalid binding handles.
compile fun Compiler.bindingSetter(binding: int): int =
    compilerBindingSetter(binding)

// Returns whether the binding is both delegated and mutable, reporting a compile-time error for an invalid handle.
compile fun Compiler.bindingCanReplaceDelegate(binding: int): bool =
    compilerBindingCanReplaceDelegate(binding)

// Returns the first source byte offset of the `by` expression, or -1 for an ordinary binding, and rejects invalid handles.
compile fun Compiler.bindingByBegin(binding: int): int =
    compilerBindingByBegin(binding)

// Returns the exclusive end byte offset of the `by` expression, or -1 for an ordinary binding, and rejects invalid handles.
compile fun Compiler.bindingByEnd(binding: int): int =
    compilerBindingByEnd(binding)

// Returns a fresh array of top-level function handles with the exact annotation, or an empty array if none match.
compile fun Compiler.functionsAnnotated(annotation: string): array<int> {
    val reflected = compilerFunctionsAnnotated(annotation)
    val functions: array<int> = []
    var index = 0
    while (index < reflected.size) {
        functions.append(reflected[index])
        index = index + 1
    }
    functions
}

// Finds the function or method named by `name` in this compilation. Returns -1 when absent.
compile fun Compiler.findFunction(name: string): int =
    compilerFindFunction(name)

// A typed wrapper around a compilation-scoped function handle. Additional
// annotations are immutable metadata applied only to a destination module
// when this reference is used there.
compile fun Compiler.function(name: string): FunctionReference =
    FunctionReference(compilerFindFunction(name), [], "", false)

// Wraps an already reflected function without resolving it again by name.
// This is the preferred bridge from functionsAnnotated() and typed call
// inspection into an independent module.
compile fun Compiler.reference(handle: int): FunctionReference =
    FunctionReference(handle, [], "", false)

// Returns a new reference with `annotation` appended for validation when the destination module uses it.
compile fun FunctionReference.annotated(
    annotation: string
): FunctionReference {
    val annotations: array<string> = []
    var index = 0
    while (index < this.annotations.size) {
        annotations.append(this.annotations[index])
        index = index + 1
    }
    annotations.append(annotation)
    FunctionReference(
        this.handle,
        annotations,
        this.exportName,
        this.checkedExport
    )
}

// Marks the destination copy as a foreign artifact root. The source function
// keeps its Abla name; only the standalone module receives this export name.
compile fun FunctionReference.exported(name: string): FunctionReference =
    FunctionReference(this.handle, this.annotations, name, false)

// Returns a new reference requesting a checked foreign export, with the name validated when the destination module uses it.
compile fun FunctionReference.checkedExported(
    name: string
): FunctionReference =
    FunctionReference(this.handle, this.annotations, name, true)

// Creates an independent module named `name` for compile-time declaration selection and artifact emission.
compile fun Compiler.newModule(name: string): IndependentModule =
    IndependentModule(compilerNewIndependentModule(name))

// Adds the declaration and metadata in `function` to this independent module. Returns whether the compiler accepted it.
compile fun IndependentModule.use(function: FunctionReference): bool =
    compilerIndependentModuleUse(
        this.handle,
        function.handle,
        function.annotations,
        function.exportName,
        function.checkedExport
    )

// Exports a declaration added by declare(), including a name returned by a
// compiler-owned generated-declaration builder. Existing declarations should
// normally use FunctionReference.exported() so their handle remains typed.
compile fun IndependentModule.export(
    sourceName: string,
    name: string,
    checked: bool = false
): bool = compilerIndependentModuleExport(
    this.handle, sourceName, name, checked
)

// Adds the compile-time `declarations` block to the independent module. Returns whether the compiler accepted it.
compile fun IndependentModule.declare(
    declarations: DeclarationBlock
): bool = compilerIndependentModuleDeclare(this.handle, declarations)

// Emits the independent module at `output` for `target` and `artifact`. Use `fast` to select fast compilation and `cache` to permit caching. Returns whether emission succeeded.
compile fun IndependentModule.emit(
    output: string,
    target: string = "host",
    artifact: string = "executable",
    fast: bool = false,
    cache: bool = true
): bool = compilerIndependentModuleEmit(
    this.handle, output, target, artifact, fast, cache
)

// Returns the source name of the function named by handle `function`. An invalid handle produces a compile-time error.
compile fun Compiler.functionName(function: int): string =
    compilerFunctionName(function)

// Returns the compiler's canonical identity for handle `function`, including its owner when applicable. An invalid handle produces a compile-time error.
compile fun Compiler.functionIdentity(function: int): string =
    compilerFunctionCanonicalIdentity(function)

// Returns the canonical module identity for handle `function`. An invalid handle produces a compile-time error.
compile fun Compiler.functionModuleIdentity(function: int): string =
    compilerFunctionModuleIdentity(function)

// Returns the method's receiver type, or an empty string for a top-level function, and rejects invalid handles.
compile fun Compiler.functionOwner(function: int): string =
    compilerFunctionOwner(function)

// Returns the number of declared parameters of handle `function`. An invalid handle produces a compile-time error.
compile fun Compiler.parameterCount(function: int): int =
    compilerFunctionParameterCount(function)

// Returns the name of zero-based `parameter` of handle `function`. Invalid indices or handles produce a compile-time error.
compile fun Compiler.parameterName(function: int, parameter: int): string =
    compilerFunctionParameterName(function, parameter)

// Returns the normalized source-visible type of zero-based `parameter` of handle `function`. Invalid indices or handles produce a compile-time error.
compile fun Compiler.parameterType(function: int, parameter: int): string =
    compilerFunctionParameterType(function, parameter)

// Returns the reflected result type of handle `function`. An invalid handle produces a compile-time error.
compile fun Compiler.resultType(function: int): string =
    compilerFunctionResultType(function)

// Returns the number of annotations attached to the function or reports a compile-time error for an invalid handle.
compile fun Compiler.annotationCount(function: int): int =
    compilerFunctionAnnotationCount(function)

// Returns the annotation name at zero-based `annotation` on handle `function`. An invalid handle or index produces a compile-time error.
compile fun Compiler.annotation(function: int, annotation: int): string =
    compilerFunctionAnnotation(function, annotation)

// Returns one if the annotation has an argument or zero otherwise, reporting a compile-time error for an invalid function handle or annotation index.
compile fun Compiler.annotationArgumentCount(
    function: int,
    annotation: int
): int = compilerFunctionAnnotationArgumentCount(function, annotation)

// Returns the syntax kind of annotation argument zero, reporting a compile-time error for an invalid handle, annotation, or argument.
compile fun Compiler.annotationArgumentKind(
    function: int,
    annotation: int,
    argument: int = 0
): string = compilerFunctionAnnotationArgumentKind(
    function, annotation, argument
)

// Returns the syntax text of annotation argument zero, reporting a compile-time error for an invalid handle, annotation, or argument.
compile fun Compiler.annotationArgumentText(
    function: int,
    annotation: int,
    argument: int = 0
): string = compilerFunctionAnnotationArgumentText(
    function, annotation, argument
)

// Returns whether the handle names a `compile fun`, reporting a compile-time error for an invalid handle.
compile fun Compiler.isCompileOnly(function: int): bool =
    compilerFunctionIsCompileOnly(function)

// Returns whether the function is declared `trusted`, reporting a compile-time error for an invalid handle.
compile fun Compiler.isTrusted(function: int): bool =
    compilerFunctionIsTrusted(function)

// Returns whether the function is declared `extern`, reporting a compile-time error for an invalid handle.
compile fun Compiler.isExternal(function: int): bool =
    compilerFunctionIsExternal(function)

// Returns true if the enclosing transform stages `body` as new source for `function`, and rejects invalid targets or requests outside a transform.
compile fun Compiler.replaceFunctionBody(
    function: int,
    body: string
): bool = compilerReplaceFunctionBody(function, body)

// Returns true when a transform stages a new annotation on the function, reporting a compile-time error for invalid or duplicate annotations or requests outside a transform.
compile fun Compiler.addFunctionAnnotation(
    function: int,
    annotation: string
): bool = compilerAddFunctionAnnotation(function, annotation)

// Submits `source` as a virtual module under `namespace`, reporting a compile-time error if the compiler rejects the generated module.
compile fun Compiler.generateModule(namespace: string, source: string) =
    compilerGenerateModule(namespace, source)

// Writes `contents` to project-relative `path` during compilation. Returns whether the write succeeded and requires the compiler's filesystem-write grant.
compile fun Compiler.writeFile(path: string, contents: string): bool =
    compilerWriteFile(path, contents)

// Adds a program node named `name` from `entry` to the build graph. Set `output`, `target`, `artifact`, fast compilation, and cache policy. Returns whether the node was accepted. The graph is built after evaluation.
compile fun Compiler.buildProgram(
    name: string,
    entry: string,
    output: string,
    target: string,
    artifact: string,
    fast: bool,
    cache: bool
): bool = compilerBuildProgram(
    name, entry, output, target, artifact, fast, cache
)

// Returns true when the current build graph accepts the named target description, or false when the compiler rejects it.
compile fun Compiler.defineTarget(
    name: string,
    llvmTriple: string,
    objectFormat: string,
    linkerFlavor: string,
    linkerEmulation: string,
    hosted: bool,
    libcFree: bool
): bool = compilerDefineTarget(
    name, llvmTriple, objectFormat, linkerFlavor, linkerEmulation,
    hosted, libcFree
)

// Returns true when the current build graph accepts the SDK for the named target, or false when the compiler rejects it.
compile fun Compiler.defineTargetSdk(name: string, sdk: string): bool =
    compilerDefineTargetSdk(name, sdk)

// Returns true when the current build graph accepts a link input for the named target, or false when the compiler rejects it.
compile fun Compiler.defineTargetLinkInput(name: string, path: string): bool =
    compilerDefineTargetLinkInput(name, path)

// Returns true when the build graph accepts an XCFramework request with the given slices and headers, or false when the compiler rejects it.
compile fun Compiler.createXcframework(
    output: string,
    slices: array<string>,
    headersDirectory: string
): bool = compilerCreateXcframework(output, slices, headersDirectory)

// Returns true if the compiler adds the function and export name to the child artifact, or false for an invalid contribution.
compile fun Compiler.contributeArtifactRoot(
    name: string,
    target: string,
    artifact: string,
    output: string,
    function: int,
    exportName: string,
    fast: bool,
    cache: bool
): bool = compilerContributeArtifactRoot(
    name, target, artifact, output, function, exportName, fast, cache
)

// Exports the declaration identified by `function` under foreign symbol `name`. Returns whether the compiler accepted it.
compile fun Compiler.exportFunction(function: int, name: string): bool =
    compilerExportFunction(function, name)

// Returns true if the compiler marks the function as an internal artifact symbol under `name`, or false for an invalid request.
compile fun Compiler.internalFunction(function: int, name: string): bool =
    compilerInternalFunction(function, name)

// Keeps the declaration named by handle `function` under object symbol `name` for backend references. Returns whether the compiler accepted it.
compile fun Compiler.requiredInternalFunction(
    function: int,
    name: string
): bool = compilerRequiredInternalFunction(function, name)

// Returns true if the compiler accepts the function and name for a checked foreign export, or false for an invalid request.
compile fun Compiler.exportCheckedFunction(
    function: int,
    name: string
): bool = compilerExportCheckedFunction(function, name)
