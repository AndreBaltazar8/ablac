// Version 0 compiler bootstrap ABI. Handles are stable for one compilation;
// validated mutation and artifact transactions are grouped by `compiler`
// below.

// Returns the available compilation-scoped function handles.
compile extern:"compiler" fun compilerFunctions(): array<int>

// Sorted, unique annotation C names in these exact reflected module identities.
// An empty module set selects the whole loaded graph. Includes @export,
// @exportChecked and @exportLocal, whether or not a function is reachable.
compile extern:"compiler" fun compilerExportedNames(
    modules: array<string>
): array<string>

// Returns sorted, unique C export names for the given module identities, or for the entire graph when `modules` is empty.
compile fun Compiler.exportedNames(modules: array<string>): array<string> {
    val reflected = compilerExportedNames(modules)
    val names: array<string> = []
    for (name in reflected) names.append(name)
    names
}

// Top-level binding handles use the same compilation-scoped declaration
// domain as function and class handles.
compile extern:"compiler" fun compilerBindings(): array<int>
// Returns the handle of the last top-level binding named `name`, or -1 if none exists.
compile extern:"compiler" fun compilerFindBinding(name: string): int
// Returns the name of a top-level binding, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun compilerBindingName(handle: int): string
// Returns whether the binding uses `by`, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun compilerBindingIsDelegated(handle: int): bool
// Returns the source-visible type of the binding's value, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun compilerBindingExposedType(handle: int): string
// Returns the source-visible type of the delegate, or an empty string for an ordinary binding, and rejects invalid handles.
compile extern:"compiler" fun compilerBindingDelegateType(handle: int): string
// Returns whether the binding was declared with `var`, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun compilerBindingIsMutable(handle: int): bool
// Returns the delegate's `getValue` handle or -1 when unavailable, and rejects invalid binding handles.
compile extern:"compiler" fun compilerBindingGetter(handle: int): int
// Returns the delegate's `setValue` handle or -1 when unavailable, and rejects invalid binding handles.
compile extern:"compiler" fun compilerBindingSetter(handle: int): int
// Returns whether the binding is both delegated and mutable, reporting a compile-time error for an invalid handle.
compile extern:"compiler" fun compilerBindingCanReplaceDelegate(
    handle: int
): bool
// Returns the first source byte offset of the `by` expression, or -1 for an ordinary binding, and rejects invalid handles.
compile extern:"compiler" fun compilerBindingByBegin(handle: int): int
// Returns the exclusive end byte offset of the `by` expression, or -1 for an ordinary binding, and rejects invalid handles.
compile extern:"compiler" fun compilerBindingByEnd(handle: int): int

// Returns top-level functions carrying the exact annotation. Generated
// declarations remain eligible; nominal and extension methods are excluded so
// every returned handle is valid for top-level artifact roots.
compile extern:"compiler" fun compilerFunctionsAnnotated(
    annotation: string
): array<int>

// Returns -1 when no function has this name.
compile extern:"compiler" fun compilerFindFunction(name: string): int

// Returns the function's source name or reports a compile-time error for an invalid handle.
