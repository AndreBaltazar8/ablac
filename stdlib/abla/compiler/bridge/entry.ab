// Native side of the compiler bridge. When compile-time code runs as native
// code, every compiler API extern it calls is replaced by a generated stub
// (ctBridgeStubSource in the compiler) built from these helpers: the stub
// stages its arguments, invokes the intrinsic in the compiler process and
// reads the result back. The C entry points are exported by the compiler
// binary itself; all of them take and return scalars.

import "abla/unsafe/memory"

trusted noescape extern:"c" fun abla_ct_bridge_arg_integer(value: int): int
trusted noescape extern:"c" fun abla_ct_bridge_arg_boolean(value: int): int
trusted noescape extern:"c" fun abla_ct_bridge_arg_string(
    address: int,
    size: int
): int
trusted noescape extern:"c" fun abla_ct_bridge_arg_handle(handle: int): int
trusted noescape extern:"c" fun abla_ct_bridge_arg_function(address: int): int
trusted noescape extern:"c" fun abla_ct_bridge_arg_function_name(
    address: int,
    size: int
): int
trusted noescape extern:"c" fun abla_ct_bridge_arg_array_begin(): int
trusted noescape extern:"c" fun abla_ct_bridge_arg_array_end(): int
trusted noescape extern:"c" fun abla_ct_bridge_invoke(
    address: int,
    size: int
): int
trusted noescape extern:"c" fun abla_ct_bridge_result_scalar(): int
trusted noescape extern:"c" fun abla_ct_bridge_result_size(): int
trusted noescape extern:"c" fun abla_ct_bridge_result_address(): int
trusted noescape extern:"c" fun abla_ct_bridge_result_element_scalar(
    index: int
): int
trusted noescape extern:"c" fun abla_ct_bridge_result_element_size(
    index: int
): int
trusted noescape extern:"c" fun abla_ct_bridge_result_element_address(
    index: int
): int
trusted noescape extern:"c" fun abla_ct_bridge_entry_scalar(index: int): int
trusted noescape extern:"c" fun abla_ct_bridge_entry_size(index: int): int
trusted noescape extern:"c" fun abla_ct_bridge_entry_address(index: int): int
trusted noescape extern:"c" fun abla_ct_bridge_return_void(): int
trusted noescape extern:"c" fun abla_ct_bridge_return_integer(value: int): int
trusted noescape extern:"c" fun abla_ct_bridge_return_boolean(value: int): int
trusted noescape extern:"c" fun abla_ct_bridge_return_string(
    address: int,
    size: int
): int
trusted noescape extern:"c" fun abla_ct_bridge_return_handle(handle: int): int

trusted fun ablaCtBridgeArgInteger(value: int): void {
    abla_ct_bridge_arg_integer(value)
    return
}

trusted fun ablaCtBridgeArgBoolean(value: bool): void {
    abla_ct_bridge_arg_boolean(if (value) 1 else 0)
    return
}

trusted fun ablaCtBridgeArgString(value: string): void {
    abla_ct_bridge_arg_string(
        if (value.size > 0) ablaUnsafeStringAddress(value) else 0,
        value.size
    )
    return
}

trusted fun ablaCtBridgeArgHandle(handle: int): void {
    abla_ct_bridge_arg_handle(handle)
    return
}

trusted fun ablaCtBridgeArgFunctionName(name: string): void {
    abla_ct_bridge_arg_function_name(
        if (name.size > 0) ablaUnsafeStringAddress(name) else 0,
        name.size
    )
    return
}

// A function value: the compiler maps its code address back to the
// compile-time declaration it was materialized from.
trusted fun ablaCtBridgeArgFunction(value: any): void {
    abla_ct_bridge_arg_function(ablaRuntimeValueWord0(value))
    return
}

trusted fun ablaCtBridgeArgArrayBegin(): void {
    abla_ct_bridge_arg_array_begin()
    return
}

trusted fun ablaCtBridgeArgArrayEnd(): void {
    abla_ct_bridge_arg_array_end()
    return
}

trusted fun ablaCtBridgeArgIntegers(values: array<int>): void {
    abla_ct_bridge_arg_array_begin()
    var index = 0
    while (index < values.size) {
        abla_ct_bridge_arg_integer(values[index])
        index = index + 1
    }
    abla_ct_bridge_arg_array_end()
    return
}

trusted fun ablaCtBridgeArgBooleans(values: array<bool>): void {
    abla_ct_bridge_arg_array_begin()
    var index = 0
    while (index < values.size) {
        abla_ct_bridge_arg_boolean(if (values[index]) 1 else 0)
        index = index + 1
    }
    abla_ct_bridge_arg_array_end()
    return
}

trusted fun ablaCtBridgeArgStrings(values: array<string>): void {
    abla_ct_bridge_arg_array_begin()
    var index = 0
    while (index < values.size) {
        ablaCtBridgeArgString(values[index])
        index = index + 1
    }
    abla_ct_bridge_arg_array_end()
    return
}

// Performs the extern named `name`. 0: done. Otherwise the compiler recorded
// the failure on the evaluation, which then fails as it would under the
// interpreter.
trusted fun ablaCtBridgeInvoke(name: string): int =
    abla_ct_bridge_invoke(ablaUnsafeStringAddress(name), name.size)

trusted fun ablaCtBridgeCopyText(address: int, size: int): string {
    var result = ""
    if (address > 0 && size > 0) {
        val copy = ablaUnsafePointerAddress(ablaUnsafeAllocate(size + 1))
        ablaUnsafeCopyMemory(copy, address, size)
        ablaUnsafeStoreU8(nativePointerFromAddress(copy + size), 0)
        result = adoptNativeString(copy, size)
    }
    result
}

trusted fun ablaCtBridgeResultInteger(): int = abla_ct_bridge_result_scalar()

trusted fun ablaCtBridgeResultBoolean(): bool =
    abla_ct_bridge_result_scalar() != 0

trusted fun ablaCtBridgeResultHandle(): int = abla_ct_bridge_result_scalar()

trusted fun ablaCtBridgeResultString(): string = ablaCtBridgeCopyText(
    abla_ct_bridge_result_address(),
    abla_ct_bridge_result_size()
)

trusted fun ablaCtBridgeResultCount(): int = abla_ct_bridge_result_size()

trusted fun ablaCtBridgeResultIntegers(): array<int> {
    val values: array<int> = []
    val count = abla_ct_bridge_result_size()
    var index = 0
    while (index < count) {
        values.append(abla_ct_bridge_result_element_scalar(index))
        index = index + 1
    }
    values
}

trusted fun ablaCtBridgeResultBooleans(): array<bool> {
    val values: array<bool> = []
    val count = abla_ct_bridge_result_size()
    var index = 0
    while (index < count) {
        values.append(abla_ct_bridge_result_element_scalar(index) != 0)
        index = index + 1
    }
    values
}

trusted fun ablaCtBridgeResultStrings(): array<string> {
    val values: array<string> = []
    val count = abla_ct_bridge_result_size()
    var index = 0
    while (index < count) {
        values.append(ablaCtBridgeCopyText(
            abla_ct_bridge_result_element_address(index),
            abla_ct_bridge_result_element_size(index)
        ))
        index = index + 1
    }
    values
}

trusted fun ablaCtBridgeResultElementHandle(index: int): int =
    abla_ct_bridge_result_element_scalar(index)

// Native entries: their arguments and returned value.

trusted fun ablaCtBridgeEntryInteger(index: int): int =
    abla_ct_bridge_entry_scalar(index)

trusted fun ablaCtBridgeEntryBoolean(index: int): bool =
    abla_ct_bridge_entry_scalar(index) != 0

trusted fun ablaCtBridgeEntryHandle(index: int): int =
    abla_ct_bridge_entry_scalar(index)

trusted fun ablaCtBridgeEntryString(index: int): string = ablaCtBridgeCopyText(
    abla_ct_bridge_entry_address(index),
    abla_ct_bridge_entry_size(index)
)

trusted fun ablaCtBridgeReturnVoid(): void {
    abla_ct_bridge_return_void()
    return
}

trusted fun ablaCtBridgeReturnInteger(value: int): void {
    abla_ct_bridge_return_integer(value)
    return
}

trusted fun ablaCtBridgeReturnBoolean(value: bool): void {
    abla_ct_bridge_return_boolean(if (value) 1 else 0)
    return
}

trusted fun ablaCtBridgeReturnString(value: string): void {
    abla_ct_bridge_return_string(
        if (value.size > 0) ablaUnsafeStringAddress(value) else 0,
        value.size
    )
    return
}

trusted fun ablaCtBridgeReturnHandle(handle: int): void {
    abla_ct_bridge_return_handle(handle)
    return
}

// A `declare { ... }` quote: its box handle (see ctBridgeDeclarationBlock).
trusted fun ablaCtBridgeDeclarationBlock(
    text: string,
    sourceIdentity: string
): int {
    ablaCtBridgeArgString(text)
    ablaCtBridgeArgString(sourceIdentity)
    ablaCtBridgeInvoke("__ablaCtDeclarationBlock")
    abla_ct_bridge_result_scalar()
}
