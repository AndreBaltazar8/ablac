// public: none
// The language's built-in types and members, written as declarations so that an editor has something to open and to show.
//
// This file is not a module: there is no entry.ab beside it, so `import "abla/builtins"` is an error. It could not be one: a program
// that imported it would declare `string`, `int` and `array` itself, over the language's own.
//
// Nothing here is compiled into a program: the compiler knows these types and members itself (sema.ab), and the editor service
// reads this file only to name them (`ablac analyze --stdio`: go-to-definition, hover, find-references on `string`, `array`,
// `Map`, `size`, `append`, ...). A program that declares a name below owns it in its own code.
//
// tools/test-builtin-docs.sh keeps this file honest: every member listed here is accepted by the compiler on that receiver,
// and every member the compiler accepts on a built-in receiver is listed here. Add a built-in member to sema.ab and the test
// asks for a declaration (with its doc comment) here; remove one and it asks for the declaration to go.

/** `true` or `false`. */
class bool

/** A signed 8-bit integer. Arithmetic wraps; convert explicitly to mix widths: `i8(value)`. */
class i8

/** A signed 16-bit integer. Arithmetic wraps; convert explicitly to mix widths: `i16(value)`. */
class i16

/** A signed 32-bit integer. Arithmetic wraps; convert explicitly to mix widths: `i32(value)`. */
class i32

/** A signed 64-bit integer. `int` is `i64`. */
class i64

/** A signed 64-bit integer (`i64`), the type of integer literals and of sizes and indexes. */
class int

/** A function type written with a capture contract: `Fn(A) -> R` reads what it captures, and can be called many times. */
class Fn

/** A function type written `FnMut(A) -> R`: a lambda that changes a capture. Affine. */
class FnMut

/** A function type written `FnOnce(A) -> R`: a `move { ... }` lambda, which can be called once. Affine. */
class FnOnce

/** A function type written `FnNoEscape(A) -> R`: a callback that the callee may call but not keep. */
class FnNoEscape

/** An unsigned 8-bit integer. Arithmetic wraps; convert explicitly to mix widths: `u8(value)`. */
class u8

/** An unsigned 16-bit integer. Arithmetic wraps; convert explicitly to mix widths: `u16(value)`. */
class u16

/** An unsigned 32-bit integer. Arithmetic wraps; convert explicitly to mix widths: `u32(value)`. */
class u32

/** An unsigned 64-bit integer. Arithmetic wraps; convert explicitly to mix widths: `u64(value)`. */
class u64

/** A 32-bit IEEE floating point number. A literal is an `f64` unless its context wants an `f32`. */
class f32

/** A 64-bit IEEE floating point number, the type of float literals. */
class f64

/** A byte-sized character code. */
class char

/** No value: the type of an empty block and of a function that returns nothing. */
class void

/** No value ever: the type of a call that does not return (`panic(...)`). */
class never

/** Any value. Used by low-level code; ordinary code names a type. */
class any

/** Immutable UTF-8 text, indexed by byte. Reading or slicing outside the string panics. */
class string(
    /** The number of bytes. */
    val size: int
) {
    /** The bytes from `begin` up to `end` as a new string. Panics when the range is outside the string. */
    fun slice(begin: int, end: int): string
}

/** A growable sequence. `[]` needs an expected type, or names it: `array<int>()`. Reading or writing outside the array panics. */
class array<T>(
    /** The number of elements. */
    val size: int
) {
    /** Adds `value` at the end. */
    fun append(value: T): void

    /** Removes and returns the element at `index`, moving the later elements down. The result is owned, as a resource's. */
    fun takeAt(index: int): T

    /** Keeps the first `size` elements (all of them when `size` is at least the array's size) and keeps the capacity. */
    fun truncate(size: int): void

    /** Removes every element and keeps the capacity. */
    fun clear(): void
}

/** A hash map with `string` or `int` keys, in insertion order. Its type must be declared where it is created, or named by the constructor: `Map<string, int>()`. */
class Map<K, V>(
    /** The number of entries. */
    val size: int
) {
    /** The value at `key`, or `null` when there is none. The value is lent, not moved. */
    fun get(key: K): V?

    /** Whether `key` is in the map. */
    fun has(key: K): bool

    /** Stores `value` at `key`, replacing what was there. */
    fun set(key: K, value: V): void

    /** Removes `key`. Returns whether it was present. */
    fun remove(key: K): bool

    /** The keys, in insertion order. */
    fun keys(): array<K>

    /** The values, in insertion order. */
    fun values(): array<V>

    /** Removes every entry. */
    fun clear(): void

    /** Removes `key` and returns its value, moved out, or `null` when there is none. */
    fun take(key: K): V?
}

/** A mutable scalar inside an otherwise read-only object. Single thread; copy scalars only. */
class Cell<T> {
    /** The current value. */
    fun get(): T

    /** Replaces the value. */
    fun set(value: T): void
}

/** Exclusive access to an affine value, under a lock. Thread-safe. */
class Mutex<T> {
    /** Another handle to the same lock and value. */
    fun clone(): Mutex<T>

    /** Runs `body` with the value, holding the lock for the whole callback, and returns what it returns. */
    fun <R> with(body: (T) -> R): R
}

/** A reference-counted handle to a value, shared across threads. */
class Shared<T> {
    /** Another strong handle to the same value. */
    fun clone(): Shared<T>

    /** The value. */
    fun get(): T

    /** A `Weak<T>` handle that does not keep the value alive. */
    fun downgrade(): Weak<T>
}

/** A handle to a `Shared<T>` value that does not keep it alive. */
class Weak<T> {
    /** Another weak handle to the same value. */
    fun clone(): Weak<T>

    /** A new strong handle, or `null` when the value is gone. */
    fun upgrade(): Shared<T>?

    /** Whether the value is still alive; observes, without pinning it. */
    fun isAlive(): bool
}
