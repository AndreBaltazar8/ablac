import "abla/build"
import "abla/compiler"

// WebAssembly target policy belongs to this library, not to the compiler's
// built-in target registry. The compiler consumes only the bounded format and
// toolchain descriptor.
compile fun wasm32Target(): bool = defineTarget(
    "wasm32-module",
    "wasm32-unknown-unknown",
    "wasm",
    "wasm-ld",
    "none",
    false,
    true
)

compile fun wasmBuildModule(
    name: string,
    entry: string,
    output: string,
    fast: bool,
    cache: bool
): bool {
    val target = wasm32Target()
    val program = buildProgram(
        name,
        entry,
        output,
        "wasm32-module",
        "module",
        fast,
        cache
    )
    target && program
}

// Emits a standalone module assembled through compiler.newModule(). Target
// registration stays owned by the Wasm package while selection, generated
// declarations, annotations, and exports stay on the generic builder.
compile fun IndependentModule.emitWasm(
    output: string,
    fast: bool = false,
    cache: bool = true
): bool {
    val target = wasm32Target()
    val module = this.emit(
        output,
        target = "wasm32-module",
        artifact = "module",
        fast = fast,
        cache = cache
    )
    target && module
}
