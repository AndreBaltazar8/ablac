// In-process LLVM optimization and native object emission.

import "abla/llvm/orc"
import "abla/simd/target"
import "abla/text"
import "abla/unsafe/memory/raw"
import "abla/unsafe/memory"

/// Finds the registered target for the triple and returns zero on success or an owned diagnostic on failure.
noescape extern:"c" fun LLVMGetTargetFromTriple(
    triple: i64*,
    outputTarget: i64*,
    outputMessage: i64*
): i32
/// Creates a machine with the supplied target and code generation options or returns null on failure.
noescape extern:"c" fun LLVMCreateTargetMachine(
    target: i64*,
    triple: i64*,
    cpu: cstring,
    features: cstring,
    optimizationLevel: i32,
    relocationMode: i32,
    codeModel: i32
): i64*
/// Destroys the caller-owned target machine.
noescape extern:"c" fun LLVMDisposeTargetMachine(machine: i64*): void
/// Configures whether the target machine uses GlobalISel.
noescape extern:"c" fun LLVMSetTargetMachineGlobalISel(machine: i64*, enable: i32): void
/// Creates the caller-owned data layout for the target machine.
noescape extern:"c" fun LLVMCreateTargetDataLayout(machine: i64*): i64*
/// Destroys the caller-owned target data layout.
noescape extern:"c" fun LLVMDisposeTargetData(layout: i64*): void
/// Sets the module's target triple.
noescape extern:"c" fun LLVMSetTarget(module: i64*, triple: i64*): void
/// Sets the LLVM module's data layout from the supplied target data.
noescape extern:"c" fun LLVMSetModuleDataLayout(module: i64*, layout: i64*): void
/// Emits assembly or an object file and returns zero on success or an owned diagnostic on failure.
noescape extern:"c" fun LLVMTargetMachineEmitToFile(
    machine: i64*,
    module: i64*,
    filename: cstring,
    codegen: i32,
    outputMessage: i64*
): i32

/// Returns the feature string for native hosted emission, with RV64GC for Linux on RISC-V.
trusted fun llvmAotHostedFeatures(triple: string): string =
    if (simdTargetArch() == SIMD_ARCH_OTHER && triple.startsWith("riscv64-"))
        "+m,+a,+f,+d,+c,+zicsr,+zifencei" else ""

// Returns zero on success and a stable 130-135 infrastructure status on
// failure. LLVM-owned messages are always disposed. An empty pass pipeline is
// the low-latency development profile: LLVM parses the module once and emits
// unoptimized machine code without first rebuilding an optimization pipeline.
private fun llvmAotEmitObjectFileConfigured(
    irPath: string,
    objectPath: string,
    optimizationLevel: int,
    passes: string
): int {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    val module = nativePointerCell(nullPointer)
    val target = nativePointerCell(nullPointer)
    val context = LLVMContextCreate()
    var status: int = llvmInitializeNativeTarget()
    if (status == 0) status = LLVMCreateMemoryBufferWithContentsOfFile(
            irPath,
            buffer.address,
            message.address
        )
    if (status != 0) status = 130
    if (status == 0) {
        status = LLVMParseIRInContext(
            context,
            buffer.load(),
            module.address,
            message.address
        )
        if (status != 0) status = 131
    }
    var triple = nullPointer
    if (status == 0) {
        triple = LLVMGetDefaultTargetTriple()
        status = LLVMGetTargetFromTriple(
            triple,
            target.address,
            message.address
        )
        if (status != 0) status = 132
    }
    var machine = nullPointer
    var layout = nullPointer
    var passOptions = nullPointer
    if (status == 0) {
        machine = LLVMCreateTargetMachine(
            target.load(),
            triple,
            "generic",
            llvmAotHostedFeatures(nativeCString(triple)),
            i32(optimizationLevel),
            2,
            0
        )
        if (pointerIsNull(machine)) status = 133
        // Unoptimized builds select instructions with FastISel: AArch64's O0
        // GlobalISel spends most of its time in the Localizer on large modules.
        else if (optimizationLevel == 0) LLVMSetTargetMachineGlobalISel(machine, 0)
    }
    if (status == 0) {
        LLVMSetTarget(module.load(), triple)
        layout = LLVMCreateTargetDataLayout(machine)
        LLVMSetModuleDataLayout(module.load(), layout)
        if (passes != "") {
            passOptions = LLVMCreatePassBuilderOptions()
            status = llvmConsumeError(
                LLVMRunPasses(
                    module.load(),
                    passes,
                    machine,
                    passOptions
                ),
                134
            )
        }
    }
    if (status == 0) {
        status = LLVMTargetMachineEmitToFile(
            machine,
            module.load(),
            objectPath,
            1,
            message.address
        )
        if (status != 0) status = 135
    }
    if (!pointerIsNull(passOptions)) {
        LLVMDisposePassBuilderOptions(passOptions)
    }
    if (!pointerIsNull(layout)) LLVMDisposeTargetData(layout)
    if (!pointerIsNull(machine)) LLVMDisposeTargetMachine(machine)
    if (!pointerIsNull(module.load())) LLVMDisposeModule(module.load())
    LLVMContextDispose(context)
    if (!pointerIsNull(triple)) LLVMDisposeMessage(triple)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    buffer.close()
    message.close()
    module.close()
    target.close()
    status
}

// Reproducible release profile. The pipeline string and code-generation level
// are explicit compiler inputs and therefore participate in fixed points.
fun llvmAotEmitObjectFile(irPath: string, objectPath: string): int =
    llvmAotEmitObjectFileConfigured(
        irPath,
        objectPath,
        2,
        "default<O2>,globaldce"
    )

// Middle profile (--o1) for tools that run long enough for code quality to
// matter: scalar promotion, the inliner and local cleanup without O2's loop
// and global passes, selected at codegen level 1 (SelectionDAG). No LTO.
fun llvmAotEmitObjectFileBalanced(irPath: string, objectPath: string): int =
    llvmAotEmitObjectFileConfigured(
        irPath,
        objectPath,
        1,
        llvmPassesBalanced()
    )

// Low-latency profile for edit/run cycles and watched services. Release builds
// remain the default so shipping code never silently loses optimization.
// Scalar promotion and CFG cleanup only: unpromoted locals made O0 codegen
// several times slower on large modules than this pass costs.
fun llvmAotEmitObjectFileFast(irPath: string, objectPath: string): int =
    llvmAotEmitObjectFileConfigured(irPath, objectPath, 0, llvmPassesFast())
