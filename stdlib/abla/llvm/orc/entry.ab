noescape extern:"c" fun LLVMOrcDisposeLLJIT(jit: i64*): i64*
noescape extern:"c" fun LLVMOrcLLJITGetMainJITDylib(jit: i64*): i64*
noescape extern:"c" fun LLVMOrcLLJITGetGlobalPrefix(jit: i64*): i8
noescape extern:"c" fun LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(
