// Minimal LLVM 23 ORC C binding. All native references are opaque pointers;
// ownership transfer follows LLVM's documented C API exactly.

import "abla/runtime/emutls"
import "abla/runtime/memory"
import "abla/simd/target"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "abla/sys/linux/process"
import "abla/sys/linux/fs"
import "abla/unsafe/memory/raw"
import "abla/sys/linux"

/// Registers the LLVM x86 target information.
noescape extern:"c" fun LLVMInitializeX86TargetInfo(): void
/// Registers the LLVM x86 code generation target.
noescape extern:"c" fun LLVMInitializeX86Target(): void
/// Registers the LLVM x86 machine-code layer.
noescape extern:"c" fun LLVMInitializeX86TargetMC(): void
/// Registers the LLVM x86 assembly printer.
noescape extern:"c" fun LLVMInitializeX86AsmPrinter(): void
/// Registers the LLVM x86 assembly parser.
noescape extern:"c" fun LLVMInitializeX86AsmParser(): void
/// Registers the LLVM AArch64 target information.
noescape extern:"c" fun LLVMInitializeAArch64TargetInfo(): void
/// Registers the LLVM AArch64 code generation target.
noescape extern:"c" fun LLVMInitializeAArch64Target(): void
/// Registers the LLVM AArch64 machine-code layer.
noescape extern:"c" fun LLVMInitializeAArch64TargetMC(): void
/// Registers the LLVM AArch64 assembly printer.
noescape extern:"c" fun LLVMInitializeAArch64AsmPrinter(): void
/// Registers the LLVM AArch64 assembly parser.
noescape extern:"c" fun LLVMInitializeAArch64AsmParser(): void
private noescape extern:"c" fun LLVMInitializeRISCVTargetInfo(): void
private noescape extern:"c" fun LLVMInitializeRISCVTarget(): void
private noescape extern:"c" fun LLVMInitializeRISCVTargetMC(): void
private noescape extern:"c" fun LLVMInitializeRISCVAsmPrinter(): void
private noescape extern:"c" fun LLVMInitializeRISCVAsmParser(): void
/// Returns an LLVM-owned string containing the default target triple.
noescape extern:"c" fun LLVMGetDefaultTargetTriple(): i64*
/// Writes the linked LLVM library's major, minor and patch version numbers.
noescape extern:"c" fun LLVMGetVersion(major: i64*, minor: i64*, patch: i64*): void

/// Creates an LLVM context owned by the caller.
noescape extern:"c" fun LLVMContextCreate(): i64*
/// Destroys the caller-owned LLVM context.
noescape extern:"c" fun LLVMContextDispose(context: i64*): void
/// Destroys an LLVM module still owned by the caller.
noescape extern:"c" fun LLVMDisposeModule(module: i64*): void
/// Loads a file into an LLVM buffer and returns zero on success or an owned diagnostic on failure.
noescape extern:"c" fun LLVMCreateMemoryBufferWithContentsOfFile(
    path: cstring,
    outputBuffer: i64*,
    outputMessage: i64*
): i32
/// Returns an LLVM buffer holding a copy of the supplied bytes and the given name.
noescape extern:"c" fun LLVMCreateMemoryBufferWithMemoryRangeCopy(
    data: cstring,
    length: int,
    name: cstring
): i64*
/// Destroys an LLVM buffer owned by the caller.
noescape extern:"c" fun LLVMDisposeMemoryBuffer(buffer: i64*): void
/// Releases a message string allocated by LLVM.
noescape extern:"c" fun LLVMDisposeMessage(message: i64*): void
/// Allocates default options for the LLVM pass builder.
noescape extern:"c" fun LLVMCreatePassBuilderOptions(): i64*
/// Frees the LLVM pass builder options.
noescape extern:"c" fun LLVMDisposePassBuilderOptions(options: i64*): void
/// Runs the named pass pipeline and returns a null error on success.
noescape extern:"c" fun LLVMRunPasses(
    module: i64*,
    passes: cstring,
    machine: i64*,
    options: i64*
): i64*
/// Parses IR in the supplied context, taking the buffer and returning zero on success or an owned diagnostic on failure.
noescape extern:"c" fun LLVMParseIRInContext(
    context: i64*,
    buffer: i64*,
    outputModule: i64*,
    outputMessage: i64*
): i32

/// Wraps the supplied LLVM context in a shared thread-safe context.
noescape extern:"c" fun LLVMOrcCreateNewThreadSafeContextFromLLVMContext(
    context: i64*
): i64*
/// Releases the caller's reference to the thread-safe context.
noescape extern:"c" fun LLVMOrcDisposeThreadSafeContext(context: i64*): void
/// Wraps a module in a thread-safe context and transfers ownership of the module.
noescape extern:"c" fun LLVMOrcCreateNewThreadSafeModule(
    module: i64*,
    context: i64*
): i64*
/// Disposes a thread-safe module still owned by the caller.
noescape extern:"c" fun LLVMOrcDisposeThreadSafeModule(module: i64*): void

/// Creates an LLJIT instance and returns a null error on success.
noescape extern:"c" fun LLVMOrcCreateLLJIT(
    outputJit: i64*,
    builder: i64*
): i64*
/// Destroys the JIT and its managed resources and returns a null error on success.
noescape extern:"c" fun LLVMOrcDisposeLLJIT(jit: i64*): i64*
/// Returns the main dylib borrowed from the LLJIT instance.
noescape extern:"c" fun LLVMOrcLLJITGetMainJITDylib(jit: i64*): i64*
/// Returns the target's global symbol prefix character or zero for no prefix.
noescape extern:"c" fun LLVMOrcLLJITGetGlobalPrefix(jit: i64*): i8
/// Creates a search generator for host process symbols and returns a null error on success.
noescape extern:"c" fun LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(
    outputGenerator: i64*,
    globalPrefix: i8,
    filter: i64*,
    filterContext: i64*
): i64*
/// Transfers the search generator to the JIT dylib for symbol resolution.
noescape extern:"c" fun LLVMOrcJITDylibAddGenerator(
    dylib: i64*,
    symbolGenerator: i64*
): void
/// Transfers a thread-safe module to the JIT dylib and returns a null error on success.
noescape extern:"c" fun LLVMOrcLLJITAddLLVMIRModule(
    jit: i64*,
    dylib: i64*,
    module: i64*
): i64*
/// Returns a retained tracker for a group of resources in the dylib.
noescape extern:"c" fun LLVMOrcJITDylibCreateResourceTracker(
    dylib: i64*
): i64*
/// Releases the caller's reference to an ORC tracker.
noescape extern:"c" fun LLVMOrcReleaseResourceTracker(tracker: i64*): void
/// Removes resources grouped under the tracker and returns a null error on success.
noescape extern:"c" fun LLVMOrcResourceTrackerRemove(tracker: i64*): i64*
/// Transfers a thread-safe module to the JIT under the specified tracker and returns a null error on success.
noescape extern:"c" fun LLVMOrcLLJITAddLLVMIRModuleWithRT(
    jit: i64*,
    tracker: i64*,
    module: i64*
): i64*
/// Resolves an unmangled name in the main dylib, writing its address and returning a null error on success.
noescape extern:"c" fun LLVMOrcLLJITLookup(
    jit: i64*,
    outputAddress: i64*,
    name: cstring
): i64*
/// Disposes a non-null LLVM error without reporting its message.
noescape extern:"c" fun LLVMConsumeError(error: i64*): void
/// Transfers an object buffer to the JIT under the specified tracker and returns a null error on success.
noescape extern:"c" fun LLVMOrcLLJITAddObjectFileWithRT(
    jit: i64*,
    tracker: i64*,
    buffer: i64*
): i64*
/// Returns the object transform layer borrowed from the LLJIT instance.
noescape extern:"c" fun LLVMOrcLLJITGetObjTransformLayer(jit: i64*): i64*
/// Installs a callback and its context for objects passing through the transform layer.
noescape extern:"c" fun LLVMOrcObjectTransformLayerSetTransform(
    layer: i64*,
    transform: int,
    context: i64*
): void
/// Returns the borrowed starting address of the buffer's bytes.
noescape extern:"c" fun LLVMGetBufferStart(buffer: i64*): i64*
/// Returns the byte size of the LLVM memory buffer.
noescape extern:"c" fun LLVMGetBufferSize(buffer: i64*): int
/// Returns an LLVM-owned string naming the detected host CPU.
noescape extern:"c" fun LLVMGetHostCPUName(): i64*
/// Returns an LLVM-owned string of host CPU feature overrides.
noescape extern:"c" fun LLVMGetHostCPUFeatures(): i64*
/// Loads a native library for the lifetime of the process and returns zero on success.
noescape extern:"c" fun LLVMLoadLibraryPermanently(path: cstring): i32
/// Returns a native symbol address or null if it cannot be found.
noescape extern:"c" fun LLVMSearchForAddressOfSymbol(name: cstring): i64*
/// Creates a symbol search generator for the specified library and returns a null error on success.
noescape extern:"c" fun LLVMOrcCreateDynamicLibrarySearchGeneratorForPath(
    outputGenerator: i64*,
    path: cstring,
    globalPrefix: i8,
    filter: i64*,
    filterContext: i64*
): i64*

/// Loads the named native library into LLVM's process symbol search and returns zero on success.
fun llvmLoadLibraryPermanently(path: string): int =
    LLVMLoadLibraryPermanently(path)

// The address of `name` in the process or in a library loaded permanently
// (0 when absent): what the JIT's process generator resolves it to.
trusted fun llvmSearchForAddressOfSymbol(name: string): int =
    nativePointerAddress(LLVMSearchForAddressOfSymbol(name))

/// Consumes an LLVM error and returns the supplied failure status, or zero for a null error.
fun llvmConsumeError(error: i64*, status: int): int {
    var result = 0
    if (!pointerIsNull(error)) {
        LLVMConsumeError(error)
        result = status
    }
    result
}

/// Registers LLVM's x86 and AArch64 targets and the native RISC-V target when applicable. Returns zero on success.
fun llvmInitializeNativeTarget(): int {
    LLVMInitializeX86TargetInfo()
    LLVMInitializeX86Target()
    LLVMInitializeX86TargetMC()
    LLVMInitializeX86AsmPrinter()
    LLVMInitializeX86AsmParser()
    LLVMInitializeAArch64TargetInfo()
    LLVMInitializeAArch64Target()
    LLVMInitializeAArch64TargetMC()
    LLVMInitializeAArch64AsmPrinter()
    LLVMInitializeAArch64AsmParser()
    if (simdTargetArch() == SIMD_ARCH_OTHER && llvmDefaultTargetTriple().startsWith("riscv64-")) {
        LLVMInitializeRISCVTargetInfo()
        LLVMInitializeRISCVTarget()
        LLVMInitializeRISCVTargetMC()
        LLVMInitializeRISCVAsmPrinter()
        LLVMInitializeRISCVAsmParser()
    }
    0
}

// The linked LLVM library's "major.minor.patch" (LLVMGetVersion writes three
// unsigned 32-bit values).
trusted fun llvmLibraryVersion(): string {
    val parts = nativeByteBuffer(12)
    LLVMGetVersion(parts.pointerAt(0), parts.pointerAt(4), parts.pointerAt(8))
    val text =
        "${llvmVersionPart(parts, 0)}.${llvmVersionPart(parts, 4)}.${llvmVersionPart(parts, 8)}"
    parts.close()
    text
}

/// Reads a 32-bit little-endian LLVM version component from the specified offset.
trusted fun llvmVersionPart(parts: NativeByteBuffer, offset: int): int =
    parts.load(offset) + parts.load(offset + 1) * 256 +
        parts.load(offset + 2) * 65536 + parts.load(offset + 3) * 16777216

// Copies an LLVM-owned message (a C string) into an Abla string and disposes it.
private trusted fun llvmTakeMessage(message: i64*): string {
    var result = ""
    if (!pointerIsNull(message)) {
        var length = 0
        while (ablaUnsafeLoadU8(ablaUnsafePointerOffset(message, length)) != 0) {
            length = length + 1
        }
        val copy = nativeByteBuffer(length + 1)
        ablaUnsafeCopyMemory(nativePointerAddress(copy.address), nativePointerAddress(message),
            length)
        copy.store(length, 0)
        result = copy.adoptString(length)
        LLVMDisposeMessage(message)
    }
    result
}

// The host CPU's name and its features, as LLJIT targets them.
fun llvmHostCpuName(): string = llvmTakeMessage(LLVMGetHostCPUName())
/// Returns an owned Abla string of the detected CPU feature overrides.
fun llvmHostCpuFeatures(): string = llvmTakeMessage(LLVMGetHostCPUFeatures())

/// Returns an owned Abla string containing LLVM's default target triple.
trusted fun llvmDefaultTargetTriple(): string {
    val triple = LLVMGetDefaultTargetTriple()
    var result = ""
    if (!pointerIsNull(triple)) {
        var length = 0
        while (ablaUnsafeLoadU8(
            ablaUnsafePointerOffset(triple, length)
        ) != 0) length = length + 1
        val copy = nativeByteBuffer(length + 1)
        var index = 0
        while (index < length) {
            copy.store(index, ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(triple, index)
            ))
            index = index + 1
        }
        copy.store(length, 0)
        result = copy.adoptString(length)
        LLVMDisposeMessage(triple)
    }
    result
}

/// Holds the native JIT, its main dylib and the session lifecycle status.
@__abla_trusted_only("error: create a session with llvmOrcCreateSession(); a hand-made one would dispose a JIT of your choosing")
class LlvmOrcSession(
    val jit: i64*,
    val dylib: i64*,
    val status: int,
    var closed: bool
)

/// Tracks resources installed as one JIT generation and their lifetime.
@__abla_trusted_only("error: a session's add functions make one; a hand-made one would release a tracker of your choosing")
class LlvmOrcGeneration(
    val tracker: i64*,
    val status: int,
    var closed: bool
)

// What the add functions return (LlvmOrcGeneration is made only by trusted code).
private trusted fun llvmOrcGenerationMade(tracker: i64*, status: int, closed: bool): LlvmOrcGeneration =
    LlvmOrcGeneration(tracker, status, closed)

/// Holds a JIT symbol address and the status of resolving it.
class LlvmOrcLookup(
    val status: int,
    val address: int
)

// A session owns one LLJIT instance and its process symbol generator. Modules
// can be added and reclaimed independently through generation trackers.
trusted fun llvmOrcCreateSession(): LlvmOrcSession {
    val nullPointer = nativeNullPointer()
    val jit = nativePointerCell(nullPointer)
    val processGenerator = nativePointerCell(nullPointer)
    var status = llvmInitializeNativeTarget()
    if (status == 0) status = llvmConsumeError(
            LLVMOrcCreateLLJIT(jit.address, nullPointer),
            122
        )
    var dylib = nullPointer
    if (status == 0) {
        dylib = LLVMOrcLLJITGetMainJITDylib(jit.load())
        status = llvmConsumeError(
            LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(
                processGenerator.address,
                LLVMOrcLLJITGetGlobalPrefix(jit.load()),
                nullPointer,
                nullPointer
            ),
            123
        )
    }
    if (status == 0) {
        LLVMOrcJITDylibAddGenerator(dylib, processGenerator.load())
        LLVMOrcObjectTransformLayerSetTransform(
            LLVMOrcLLJITGetObjTransformLayer(jit.load()),
            nativeFunctionAddress(llvmOrcCaptureObject),
            nullPointer
        )
    }
    if (status != 0 && !pointerIsNull(jit.load())) {
        llvmConsumeError(LLVMOrcDisposeLLJIT(jit.load()), 126)
        jit.store(nullPointer)
    }
    val session = LlvmOrcSession(jit.load(), dylib, status, status != 0)
    jit.close()
    processGenerator.close()
    session
}

// The IR pipelines of the middle profile (--o1: scalar promotion, the inliner
// and local cleanup, without O2's loop and global passes) and of the fast one
// (scalar promotion and CFG cleanup). The ahead-of-time profiles and the JIT
// (`ablac run`) share them.
fun llvmPassesBalanced(): string =
    "function(mem2reg,simplifycfg),cgscc(inline,function(sroa,early-cse<memssa>,instcombine<no-verify-fixpoint>,simplifycfg)),globaldce"

// AOT builds amortize this higher threshold over the program's execution.
// The JIT keeps LLVM's default threshold to preserve cold run latency.
fun llvmBalancedAotInlineThreshold(): int = 400

/// Returns the short LLVM pipeline used for fast JIT compilation.
fun llvmPassesFast(): string = "function(mem2reg,simplifycfg)"

// Adds the module in `path`, after running the IR pipeline `passes` on it
// (none when empty: the frontend's IR as it is).
fun LlvmOrcSession.addFile(path: string, passes: string = ""): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    var status: int = 128
    if (!this.closed && this.status == 0) {
        status = LLVMCreateMemoryBufferWithContentsOfFile(
            path,
            buffer.address,
            message.address
        )
    }
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    val generation = this.addBuffer(buffer.load(), status, passes)
    buffer.close()
    message.close()
    generation
}

// Adds the textual IR module `ir` (`name` in LLVM's messages), after running
// the IR pipeline `passes` on it.
fun LlvmOrcSession.addText(
    name: string,
    ir: string,
    passes: string = ""
): LlvmOrcGeneration {
    var status: int = 128
    var buffer = nativeNullPointer()
    if (!this.closed && this.status == 0) {
        buffer = LLVMCreateMemoryBufferWithMemoryRangeCopy(ir, ir.size, name)
        status = if (pointerIsNull(buffer)) 120 else 0
    }
    this.addBuffer(buffer, status, passes)
}

// Parses the memory buffer `source` (consumed; `initialStatus` says how
// creating it went) and adds its module through a new generation tracker.
fun LlvmOrcSession.addBuffer(
    source: i64*,
    initialStatus: int,
    passes: string
): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    val message = nativePointerCell(nullPointer)
    val module = nativePointerCell(nullPointer)
    val context = LLVMContextCreate()
    var contextTransferred = false
    var threadModuleOwned = false
    var threadContextDisposed = false
    var status = initialStatus
    if (status == 0) {
        status = LLVMParseIRInContext(
            context,
            source,
            module.address,
            message.address
        )
        // LLVMParseIRInContext consumes the memory buffer.
        if (status != 0) status = 121
    }
    if (status != 0 && status != 128 && status != 121) status = 120
    if (status == 0 && passes != "") {
        val options = LLVMCreatePassBuilderOptions()
        status = llvmConsumeError(
            LLVMRunPasses(module.load(), passes, nullPointer, options), 129
        )
        LLVMDisposePassBuilderOptions(options)
    }
    var threadContext = nullPointer
    var threadModule = nullPointer
    var tracker = nullPointer
    if (status == 0) {
        threadContext = LLVMOrcCreateNewThreadSafeContextFromLLVMContext(
            context
        )
        contextTransferred = true
        threadModule = LLVMOrcCreateNewThreadSafeModule(
            module.load(),
            threadContext
        )
        threadModuleOwned = true
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) status = 124
    }
    if (status == 0) {
        status = llvmConsumeError(
            LLVMOrcLLJITAddLLVMIRModuleWithRT(
                this.jit,
                tracker,
                threadModule
            ),
            124
        )
        // The WithRT API consumes the thread-safe module even on failure.
        threadModuleOwned = false
        LLVMOrcDisposeThreadSafeContext(threadContext)
        threadContextDisposed = true
    }
    if (!contextTransferred) LLVMContextDispose(context)
    if (threadModuleOwned && !pointerIsNull(threadModule)) {
        LLVMOrcDisposeThreadSafeModule(threadModule)
    }
    if (contextTransferred && !threadContextDisposed &&
        !pointerIsNull(threadContext)) {
        LLVMOrcDisposeThreadSafeContext(threadContext)
    }
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nullPointer
    }
    message.close()
    module.close()
    llvmOrcGenerationMade(tracker, status, status != 0)
}

// Adds an in-memory module (as the backend keeps it: bootstrapLlvmHoldModule)
// after running the IR pipeline `passes` on it (none when empty). The session
// takes ownership of `context` and `module` whatever the outcome.
fun LlvmOrcSession.addModule(
    context: i64*,
    module: i64*,
    passes: string = ""
): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    var status: int = 128
    if (!this.closed && this.status == 0 && !pointerIsNull(module)) status = 0
    if (status == 0 && passes != "") {
        val options = LLVMCreatePassBuilderOptions()
        status = llvmConsumeError(
            LLVMRunPasses(module, passes, nullPointer, options), 129
        )
        LLVMDisposePassBuilderOptions(options)
    }
    var tracker = nullPointer
    if (status == 0) {
        val threadContext =
            LLVMOrcCreateNewThreadSafeContextFromLLVMContext(context)
        val threadModule = LLVMOrcCreateNewThreadSafeModule(
            module,
            threadContext
        )
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) {
            status = 124
            LLVMOrcDisposeThreadSafeModule(threadModule)
        } else {
            // The WithRT API consumes the thread-safe module even on failure.
            status = llvmConsumeError(
                LLVMOrcLLJITAddLLVMIRModuleWithRT(
                    this.jit,
                    tracker,
                    threadModule
                ),
                124
            )
        }
        LLVMOrcDisposeThreadSafeContext(threadContext)
    } else {
        if (!pointerIsNull(module)) LLVMDisposeModule(module)
        if (!pointerIsNull(context)) LLVMContextDispose(context)
    }
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nullPointer
    }
    llvmOrcGenerationMade(tracker, status, status != 0)
}

// Adds an object file's contents (`buffer`, which the call consumes) as a
// generation of its own.
fun LlvmOrcSession.addObjectBuffer(buffer: i64*): LlvmOrcGeneration {
    var status = if (this.closed || this.status != 0) 128 else 0
    var tracker = nativeNullPointer()
    if (status == 0) {
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) status = 124
    }
    if (status == 0) {
        // Consumes the buffer even on failure.
        status = llvmConsumeError(
            LLVMOrcLLJITAddObjectFileWithRT(this.jit, tracker, buffer), 124
        )
    } else LLVMDisposeMemoryBuffer(buffer)
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nativeNullPointer()
    }
    llvmOrcGenerationMade(tracker, status, status != 0)
}

// Adds the object files at `paths` as one generation (one resource tracker, so
// `remove` takes them all): the parts of a module generated elsewhere, which
// link to each other. Status 120 when one cannot be read; on any failure none
// stays added.
fun LlvmOrcSession.addObjectFiles(paths: array<string>): LlvmOrcGeneration =
    this.addObjectFilesWith(paths, nativeNullPointer(), nativeNullPointer())

// addObjectFiles, with the IR `module` (of `context`, both consumed; none when
// null) in the same generation: the part of a module generated elsewhere that
// LLJIT generates itself (code with thread-locals, which it emulates).
fun LlvmOrcSession.addObjectFilesWith(paths: array<string>, context: i64*, module: i64*): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    var status = if (this.closed || this.status != 0) 128 else 0
    var tracker = nullPointer
    if (status == 0) {
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) status = 124
    }
    if (!pointerIsNull(module)) {
        if (status == 0) {
            val threadContext = LLVMOrcCreateNewThreadSafeContextFromLLVMContext(context)
            val threadModule = LLVMOrcCreateNewThreadSafeModule(module, threadContext)
            // (Consumes the thread-safe module even on failure.)
            status = llvmConsumeError(LLVMOrcLLJITAddLLVMIRModuleWithRT(this.jit, tracker, threadModule), 124)
            LLVMOrcDisposeThreadSafeContext(threadContext)
        } else {
            LLVMDisposeModule(module)
            LLVMContextDispose(context)
        }
    }
    for (path in paths) {
        if (status == 0) {
            val buffer = nativePointerCell(nullPointer)
            val message = nativePointerCell(nullPointer)
            if (LLVMCreateMemoryBufferWithContentsOfFile(path, buffer.address, message.address) != 0) status = 120
            if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
            // (Consumes the buffer even on failure.)
            if (status == 0) status = llvmConsumeError(
                LLVMOrcLLJITAddObjectFileWithRT(this.jit, tracker, buffer.load()), 124
            )
            buffer.close()
            message.close()
        }
    }
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nullPointer
    }
    llvmOrcGenerationMade(tracker, status, status != 0)
}

// Adds the object file at `path` (one `lookupCapturing` wrote, say) without
// compiling anything: status 120 when it cannot be read.
fun LlvmOrcSession.addObjectFile(path: string): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    var status = if (this.closed || this.status != 0) 128 else 0
    if (status == 0 && LLVMCreateMemoryBufferWithContentsOfFile(
        path, buffer.address, message.address
    ) != 0) status = 120
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    val loaded = buffer.load()
    buffer.close()
    message.close()
    if (status == 0) this.addObjectBuffer(loaded)
    else llvmOrcGenerationMade(nullPointer, status, true)
}

// Objects the JIT generated while a capture was armed (`lookupCapturing`), as
// their bytes. Every session's object layer passes what it links through
// llvmOrcCaptureObject, so a capture sees exactly the code LLJIT generated.
private var llvmOrcCapturing: bool = false
private var llvmOrcCaptured: array<string> = []
// The bytes of the objects compiled while `lookupMeasuring` runs (no copy is kept).
private var llvmOrcMeasuring: bool = false
private var llvmOrcMeasuredBytes = 0

// The transform's C signature, `LLVMErrorRef (void *, LLVMMemoryBufferRef *)`, as
// addresses (nativeFunctionAddress takes scalar signatures): no error, ever.
trusted fun llvmOrcCaptureObject(context: i64, objectInOut: i64): i64 {
    if (llvmOrcMeasuring) {
        llvmOrcMeasuredBytes = llvmOrcMeasuredBytes + LLVMGetBufferSize(NativePointerCell(nativePointerFromAddress(objectInOut),
            false, false).load())
    }
    if (llvmOrcCapturing) {
        val buffer = NativePointerCell(nativePointerFromAddress(objectInOut), false, false).load()
        val size = LLVMGetBufferSize(buffer)
        val copy = nativeByteBuffer(size + 1)
        ablaUnsafeCopyMemory(
            nativePointerAddress(copy.address),
            nativePointerAddress(LLVMGetBufferStart(buffer)),
            size
        )
        llvmOrcCaptured.append(copy.adoptString(size))
    }
    0
}

// Looks `name` up like `lookup`, keeping the machine code that generating it
// took: when exactly one module was compiled for it, its object is published at
// `objectPath` (written beside it, then renamed) for a later `addObjectFile`, and
// `captured` is true. Nothing is published when nothing (or more than one module)
// was compiled, or the object cannot be written.
fun LlvmOrcSession.lookupCapturing(name: string, objectPath: string): LlvmOrcCapture {
    llvmOrcCaptured.truncate(0)
    llvmOrcCapturing = true
    val found = this.lookup(name)
    llvmOrcCapturing = false
    var captured = false
    if (found.status == 0 && llvmOrcCaptured.size == 1) {
        val staged = Path("$objectPath.tmp.${linuxProcessId()}")
        captured = staged.writeText(llvmOrcCaptured[0]) && staged.moveTo(Path(objectPath))
        if (!captured) staged.remove()
    }
    llvmOrcCaptured.truncate(0)
    LlvmOrcCapture(found.status, found.address, captured)
}

// As lookup, also counting the bytes of the objects the lookup had compiled (code and data of what it linked):
// how much a live reload adds to the session (src/live_reload.ab).
fun LlvmOrcSession.lookupMeasuring(name: string): LlvmOrcMeasured {
    llvmOrcMeasuredBytes = 0
    llvmOrcMeasuring = true
    val found = this.lookup(name)
    llvmOrcMeasuring = false
    LlvmOrcMeasured(found.status, found.address, llvmOrcMeasuredBytes)
}

/// Reports a lookup status, symbol address and the number of generated object bytes.
class LlvmOrcMeasured(val status: int, val address: int, val bytes: int)

/// Reports a lookup status and symbol address with whether an object was captured.
class LlvmOrcCapture(
    val status: int,
    val address: int,
    val captured: bool
)

/// Returns a resolved symbol's address or a nonzero lookup status.
fun LlvmOrcSession.lookup(name: string): LlvmOrcLookup {
    val address = nativeI64Cell(0)
    var status: int = 128
    if (!this.closed && this.status == 0) {
        status = llvmConsumeError(
            LLVMOrcLLJITLookup(this.jit, address.address, name),
            125
        )
    }
    val result = LlvmOrcLookup(status, address.load())
    address.close()
    result
}

// A JIT-compiled program has its own runtime, with its own thread-end hook (abla/runtime/self): the compiler's
// `emutlsThreadEnd` is stored there, so that the program's threads free their emulated thread-locals when they end
// (abla/runtime/emutls). A program without threads has no hook to find: nothing happens.
trusted fun LlvmOrcSession.installThreadEnd(): void {
    val hook = this.lookup("abla_runtime_thread_end_hook")
    if (hook.status == 0 && hook.address != 0) {
        ablaUnsafeStoreI64(nativePointerFromAddress(hook.address), nativeFunctionAddress(emutlsThreadEnd))
    }
    return
}

/// Releases the generation's code and tracker, returning zero on success or 127 on removal failure.
trusted fun LlvmOrcGeneration.remove(): int {
    var status = 0
    if (!this.closed) {
        status = llvmConsumeError(
            LLVMOrcResourceTrackerRemove(this.tracker),
            127
        )
        LLVMOrcReleaseResourceTracker(this.tracker)
        this.closed = true
    }
    status
}

/// Destroys an open JIT and returns zero on success or 126 on disposal failure.
trusted fun LlvmOrcSession.close(): int {
    var status = 0
    if (!this.closed) {
        status = llvmConsumeError(LLVMOrcDisposeLLJIT(this.jit), 126)
        this.closed = true
    }
    status
}

/// Calls a native function with an i32 count and pointer argument and returns its i32 result.
private trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I32_I32_Pointer(address: int,
    count: int, vector: i64*): int

// Calls a JIT-compiled `main(argc, argv)` with a process-start style block: argv =
// [program, arguments…, NULL] followed by the host's envp (the runtime finds its
// environment right after argv's NULL, as on the initial process stack), so the
// program reads processArgument()/linuxEnvironment() as a built executable would.
private trusted fun llvmOrcCallMain(address: int, program: string, arguments: array<string>): int {
    // The program may run threads of its own, whose thread-locals (emulated on macOS: abla/runtime/emutls) allocate from
    // this process's heap: its lock must be live before the first of them exists.
    runtimeMemoryEnableSharing()
    var block = llvmOrcMainBlock(program, arguments)
    val status = ablaUnsafeCallExact_I32_I32_Pointer(address, arguments.size + 1, block.address)
    block.close()
    status
}

// `main`'s address, its argument count and the address of its argv block, for the thread that runs it.
resource class LlvmOrcMainCall(val address: int, val count: int, val vector: int)

// Whether `main` returned, set by the thread that ran it.
resource class LlvmOrcMainDone(var done: bool)

private fun llvmOrcMarkDone(var state: LlvmOrcMainDone): bool {
    state.done = true
    true
}

private fun llvmOrcIsDone(var state: LlvmOrcMainDone): bool = state.done

private trusted fun llvmOrcRunMainCall(call: Shared<LlvmOrcMainCall>, done: Mutex<LlvmOrcMainDone>): int {
    val target = call.get()
    // The program runs with its own runtime: for this process's (the compiler's) this thread is in native code, so a
    // collection here does not wait for it (it would never park: `ablac run --watch` and `ablac repl` then never
    // collected, and grew with every reload). A compiler export the program calls leaves it (runtimeNativeLeave).
    runtimeNativeEnter()
    val status = ablaUnsafeCallExact_I32_I32_Pointer(target.address, target.count,
        nativePointerFromAddress(target.vector))
    runtimeNativeLeave()
    done.with(llvmOrcMarkDone)
    status
}

/// Runs the `main` this session holds (the JIT's own symbol, found by a lookup here), as a program started with `program` and
/// `arguments`, and returns its result. A program is run only through its session: no address of a caller's is called.
fun LlvmOrcSession.runMain(program: string, arguments: array<string>): int {
    val found = this.lookup("main")
    if (found.status != 0 || found.address == 0) return if (found.status != 0) found.status else 125
    llvmOrcCallMain(found.address, program, arguments)
}

/// As runMain, with `main` on a thread of its own and `step` called while it runs (see llvmOrcCallMainWatched).
fun LlvmOrcSession.runMainWatched(program: string, arguments: array<string>, step: () -> void): int {
    val found = this.lookup("main")
    if (found.status != 0 || found.address == 0) return if (found.status != 0) found.status else 125
    llvmOrcCallMainWatched(found.address, program, arguments, step)
}

// As llvmOrcCallMain, with `main` on a thread of its own: this thread calls `step` again and again while `main`
// runs (each call should block for a short while, as a wait for an event with a timeout does) and returns `main`'s
// result once it returns. `ablac run --watch` waits for source changes in `step`.
private trusted fun llvmOrcCallMainWatched(address: int, program: string, arguments: array<string>, step: () -> void): int {
    runtimeMemoryEnableSharing()
    var block = llvmOrcMainBlock(program, arguments)
    val call = Shared(LlvmOrcMainCall(address, arguments.size + 1, nativePointerAddress(block.address)))
    val done = Mutex(LlvmOrcMainDone(false))
    val running = done.clone()
    val runner = thread { llvmOrcRunMainCall(call, running) }
    while (!done.with(llvmOrcIsDone)) step()
    val status = await runner
    block.close()
    status
}

// The argv block: [program, arguments…, NULL], then the host's envp and NULL, then the argument strings.
private trusted fun llvmOrcMainBlock(program: string, arguments: array<string>): NativeByteBuffer {
    val argc = arguments.size + 1
    val environment = linuxEnvironmentPointer()
    var environmentCount = 0
    if (!pointerIsNull(environment)) {
        while (!pointerIsNull(NativePointerCell(ablaUnsafePointerOffset(environment,
            environmentCount * 8), false, false).load())) {
            environmentCount = environmentCount + 1
        }
    }
    val table = (argc + 1 + environmentCount + 1) * 8
    var bytes = program.size + 1
    for (argument in arguments) bytes = bytes + argument.size + 1
    var block = nativeByteBuffer(table + bytes)
    var text = table
    var slot = 0
    while (slot < argc) {
        val value = if (slot == 0) program else arguments[slot - 1]
        block.storePointer(slot * 8, ablaUnsafePointerOffset(block.address, text))
        var index = 0
        while (index < value.size) {
            block.store(text + index, value[index])
            index = index + 1
        }
        block.store(text + value.size, 0)
        text = text + value.size + 1
        slot = slot + 1
    }
    block.storePointer(argc * 8, nativeNullPointer())
    var entry = 0
    while (entry < environmentCount) {
        block.storePointer((argc + 1 + entry) * 8,
            NativePointerCell(ablaUnsafePointerOffset(environment, entry * 8), false, false).load())
        entry = entry + 1
    }
    block.storePointer((argc + 1 + environmentCount) * 8, nativeNullPointer())
    block
}

// Returns the JIT-compiled program's main result. Infrastructure failures use
// 120-129 (129: the IR pipeline failed), keeping them distinct from normal
// compiler diagnostics. `arguments` reach the program as processArgument(0…),
// with `program` (default: `path`) as its argv[0]. `passes` is the IR pipeline
// the module gets first (none when empty).
fun llvmOrcRunFile(
    path: string,
    program: string = "",
    arguments: array<string> = [],
    passes: string = ""
): int {
    val session = llvmOrcCreateSession()
    val generation = session.addFile(path, passes)
    var result = generation.status
    if (result == 0) {
        val lookup = session.lookup("main")
        result = lookup.status
        if (result == 0) {
            session.installThreadEnd()
            result = llvmOrcCallMain(lookup.address,
                if (program == "") path else program, arguments)
        }
    }
    val removeStatus = generation.remove()
    if (result == 0 && removeStatus != 0) result = removeStatus
    val closeStatus = session.close()
    if (result == 0 && closeStatus != 0) result = closeStatus
    result
}
