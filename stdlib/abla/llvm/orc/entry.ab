noescape extern:"c" fun LLVMInitializeAArch64Target(): void
noescape extern:"c" fun LLVMInitializeAArch64TargetMC(): void
noescape extern:"c" fun LLVMInitializeAArch64AsmPrinter(): void
noescape extern:"c" fun LLVMInitializeAArch64AsmParser(): void
noescape extern:"c" fun LLVMGetDefaultTargetTriple(): i64*

noescape extern:"c" fun LLVMContextCreate(): i64*
noescape extern:"c" fun LLVMContextDispose(context: i64*): void
noescape extern:"c" fun LLVMCreateMemoryBufferWithContentsOfFile(
    path: cstring,
    outputBuffer: i64*,
    outputMessage: i64*
): i32
noescape extern:"c" fun LLVMDisposeMemoryBuffer(buffer: i64*): void
