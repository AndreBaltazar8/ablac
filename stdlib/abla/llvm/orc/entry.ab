fun llvmLoadLibraryPermanently(path: string): int =
    LLVMLoadLibraryPermanently(path)

fun llvmConsumeError(error: i64*, status: int): int {
    var result = 0
    if (!pointerIsNull(error)) {
        LLVMConsumeError(error)
        result = status
    }
    result
}

fun llvmInitializeNativeTarget(): int {
    LLVMInitializeX86TargetInfo()
    LLVMInitializeX86Target()
    LLVMInitializeX86TargetMC()
    LLVMInitializeX86AsmPrinter()
    LLVMInitializeX86AsmParser()
    LLVMInitializeAArch64TargetInfo()
    LLVMInitializeAArch64Target()
    LLVMInitializeAArch64TargetMC()
    LLVMInitializeAArch64AsmPrinter()
    LLVMInitializeAArch64AsmParser()
    0
}

trusted fun llvmDefaultTargetTriple(): string {
    val triple = LLVMGetDefaultTargetTriple()
    var result = ""
    if (!pointerIsNull(triple)) {
        var length = 0
        while (ablaUnsafeLoadU8(
            ablaUnsafePointerOffset(triple, length)
        ) != 0) length = length + 1
        val copy = nativeByteBuffer(length + 1)
        var index = 0
        while (index < length) {
            copy.store(index, ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(triple, index)
            ))
            index = index + 1
        }
        copy.store(length, 0)
        result = copy.adoptString(length)
        LLVMDisposeMessage(triple)
    }
    result
}

class LlvmOrcSession(
    val jit: i64*,
    val dylib: i64*,
    val status: int,
    var closed: bool
)

class LlvmOrcGeneration(
    val tracker: i64*,
    val status: int,
    var closed: bool
)

class LlvmOrcLookup(
    val status: int,
    val address: int
)

// A session owns one LLJIT instance and its process symbol generator. Modules
// can be added and reclaimed independently through generation trackers.
fun llvmOrcCreateSession(): LlvmOrcSession {
    val nullPointer = nativeNullPointer()
    val jit = nativePointerCell(nullPointer)
    val processGenerator = nativePointerCell(nullPointer)
    var status = llvmInitializeNativeTarget()
    if (status == 0) status = llvmConsumeError(
            LLVMOrcCreateLLJIT(jit.address, nullPointer),
            122
        )
    var dylib = nullPointer
    if (status == 0) {
        dylib = LLVMOrcLLJITGetMainJITDylib(jit.load())
        status = llvmConsumeError(
            LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(
                processGenerator.address,
                LLVMOrcLLJITGetGlobalPrefix(jit.load()),
                nullPointer,
                nullPointer
            ),
            123
        )
    }
    if (status == 0) {
        LLVMOrcJITDylibAddGenerator(dylib, processGenerator.load())
    }
    if (status != 0 && !pointerIsNull(jit.load())) {
        llvmConsumeError(LLVMOrcDisposeLLJIT(jit.load()), 126)
        jit.store(nullPointer)
    }
    val session = LlvmOrcSession(jit.load(), dylib, status, status != 0)
    jit.close()
    processGenerator.close()
    session
}

fun LlvmOrcSession.addFile(path: string): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    val module = nativePointerCell(nullPointer)
    val context = LLVMContextCreate()
    var contextTransferred = false
    var threadModuleOwned = false
    var threadContextDisposed = false
    var status: int = 128
    if (!this.closed && this.status == 0) {
        status = LLVMCreateMemoryBufferWithContentsOfFile(
            path,
            buffer.address,
            message.address
        )
    }
    if (status == 0) {
        status = LLVMParseIRInContext(
            context,
            buffer.load(),
            module.address,
            message.address
        )
        // LLVMParseIRInContext consumes the memory buffer.
        if (status != 0) status = 121
    }
    if (status != 0 && status != 128 && status != 121) status = 120
    var threadContext = nullPointer
    var threadModule = nullPointer
    var tracker = nullPointer
    if (status == 0) {
        threadContext = LLVMOrcCreateNewThreadSafeContextFromLLVMContext(
            context
        )
        contextTransferred = true
        threadModule = LLVMOrcCreateNewThreadSafeModule(
            module.load(),
            threadContext
        )
        threadModuleOwned = true
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) status = 124
    }
    if (status == 0) {
        status = llvmConsumeError(
            LLVMOrcLLJITAddLLVMIRModuleWithRT(
                this.jit,
                tracker,
                threadModule
            ),
            124
        )
        // The WithRT API consumes the thread-safe module even on failure.
        threadModuleOwned = false
        LLVMOrcDisposeThreadSafeContext(threadContext)
        threadContextDisposed = true
    }
    if (!contextTransferred) LLVMContextDispose(context)
    if (threadModuleOwned && !pointerIsNull(threadModule)) {
        LLVMOrcDisposeThreadSafeModule(threadModule)
    }
    if (contextTransferred && !threadContextDisposed &&
        !pointerIsNull(threadContext)) {
        LLVMOrcDisposeThreadSafeContext(threadContext)
    }
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nullPointer
    }
    buffer.close()
    message.close()
    module.close()
    LlvmOrcGeneration(tracker, status, status != 0)
}

fun LlvmOrcSession.lookup(name: string): LlvmOrcLookup {
    val address = nativeI64Cell(0)
    var status: int = 128
    if (!this.closed && this.status == 0) {
        status = llvmConsumeError(
            LLVMOrcLLJITLookup(this.jit, address.address, name),
            125
        )
    }
    val result = LlvmOrcLookup(status, address.load())
    address.close()
    result
}

fun LlvmOrcGeneration.remove(): int {
    var status = 0
    if (!this.closed) {
        status = llvmConsumeError(
            LLVMOrcResourceTrackerRemove(this.tracker),
            127
        )
        LLVMOrcReleaseResourceTracker(this.tracker)
        this.closed = true
    }
    status
}

fun LlvmOrcSession.close(): int {
    var status = 0
    if (!this.closed) {
        status = llvmConsumeError(LLVMOrcDisposeLLJIT(this.jit), 126)
        this.closed = true
    }
    status
}

trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I32_I32_Pointer(address: int, count: int, vector: i64*): int

// Calls a JIT-compiled `main(argc, argv)` with a process-start style block: argv =
// [program, arguments…, NULL] followed by the host's envp (the runtime finds its
// environment right after argv's NULL, as on the initial process stack), so the
// program reads processArgument()/linuxEnvironment() as a built executable would.
trusted fun llvmOrcCallMain(address: int, program: string, arguments: array<string>): int {
    val argc = arguments.size + 1
    val environment = linuxEnvironmentPointer()
    var environmentCount = 0
    if (!pointerIsNull(environment)) {
        while (!pointerIsNull(NativePointerCell(ablaUnsafePointerOffset(environment, environmentCount * 8), false, false).load())) {
            environmentCount = environmentCount + 1
        }
    }
    val table = (argc + 1 + environmentCount + 1) * 8
    var bytes = program.size + 1
    for (argument in arguments) bytes = bytes + argument.size + 1
    var block = nativeByteBuffer(table + bytes)
    var text = table
    var slot = 0
    while (slot < argc) {
        val value = if (slot == 0) program else arguments[slot - 1]
        block.storePointer(slot * 8, ablaUnsafePointerOffset(block.address, text))
        var index = 0
        while (index < value.size) {
            block.store(text + index, value[index])
            index = index + 1
        }
        block.store(text + value.size, 0)
        text = text + value.size + 1
        slot = slot + 1
    }
    block.storePointer(argc * 8, nativeNullPointer())
    var entry = 0
    while (entry < environmentCount) {
        block.storePointer((argc + 1 + entry) * 8, NativePointerCell(ablaUnsafePointerOffset(environment, entry * 8), false, false).load())
        entry = entry + 1
    }
    block.storePointer((argc + 1 + environmentCount) * 8, nativeNullPointer())
    val status = ablaUnsafeCallExact_I32_I32_Pointer(address, argc, block.address)
    block.close()
    status
}

// Returns the JIT-compiled program's main result. Infrastructure failures use
// 120-128, keeping them distinct from normal compiler diagnostics. `arguments`
// reach the program as processArgument(0…), with `program` (default: `path`) as
// its argv[0].
fun llvmOrcRunFile(path: string, program: string = "", arguments: array<string> = []): int {
    val session = llvmOrcCreateSession()
    val generation = session.addFile(path)
    var result = generation.status
    if (result == 0) {
        val lookup = session.lookup("main")
        result = lookup.status
        if (result == 0) result = llvmOrcCallMain(lookup.address, if (program == "") path else program, arguments)
    }
    val removeStatus = generation.remove()
    if (result == 0 && removeStatus != 0) result = removeStatus
    val closeStatus = session.close()
    if (result == 0 && closeStatus != 0) result = closeStatus
    result
}
