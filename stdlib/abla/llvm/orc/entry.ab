// Minimal LLVM 23 ORC C binding. All native references are opaque pointers;
// ownership transfer follows LLVM's documented C API exactly.

import "abla/unsafe/memory"
import "abla/unsafe/native"
import "abla/sys/linux/process"
import "abla/sys/linux/fs"

