// Minimal LLVM 21 ORC C binding. All native references are opaque pointers;
// ownership transfer follows LLVM's documented C API exactly.

import "abla/unsafe/memory"
import "abla/sys/linux/process"

noescape extern:"c" fun LLVMInitializeX86TargetInfo(): void
noescape extern:"c" fun LLVMInitializeX86Target(): void
noescape extern:"c" fun LLVMInitializeX86TargetMC(): void
