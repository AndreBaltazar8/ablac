fun llvmLoadLibraryPermanently(path: string): int =
    LLVMLoadLibraryPermanently(path)

// The address of `name` in the process or in a library loaded permanently
// (0 when absent): what the JIT's process generator resolves it to.
trusted fun llvmSearchForAddressOfSymbol(name: string): int =
    nativePointerAddress(LLVMSearchForAddressOfSymbol(name))

fun llvmConsumeError(error: i64*, status: int): int {
    var result = 0
    if (!pointerIsNull(error)) {
        LLVMConsumeError(error)
        result = status
    }
    result
}

fun llvmInitializeNativeTarget(): int {
    LLVMInitializeX86TargetInfo()
    LLVMInitializeX86Target()
    LLVMInitializeX86TargetMC()
    LLVMInitializeX86AsmPrinter()
    LLVMInitializeX86AsmParser()
    LLVMInitializeAArch64TargetInfo()
    LLVMInitializeAArch64Target()
    LLVMInitializeAArch64TargetMC()
    LLVMInitializeAArch64AsmPrinter()
    LLVMInitializeAArch64AsmParser()
    0
}

// The linked LLVM library's "major.minor.patch" (LLVMGetVersion writes three
// unsigned 32-bit values).
trusted fun llvmLibraryVersion(): string {
    val parts = nativeByteBuffer(12)
    LLVMGetVersion(parts.pointerAt(0), parts.pointerAt(4), parts.pointerAt(8))
    val text = "${llvmVersionPart(parts, 0)}.${llvmVersionPart(parts, 4)}.${llvmVersionPart(parts, 8)}"
    parts.close()
    text
}

trusted fun llvmVersionPart(parts: NativeByteBuffer, offset: int): int =
    parts.load(offset) + parts.load(offset + 1) * 256 +
        parts.load(offset + 2) * 65536 + parts.load(offset + 3) * 16777216

// Copies an LLVM-owned message (a C string) into an Abla string and disposes it.
trusted fun llvmTakeMessage(message: i64*): string {
    var result = ""
    if (!pointerIsNull(message)) {
        var length = 0
        while (ablaUnsafeLoadU8(ablaUnsafePointerOffset(message, length)) != 0) {
            length = length + 1
        }
        val copy = nativeByteBuffer(length + 1)
        ablaUnsafeCopyMemory(nativePointerAddress(copy.address), nativePointerAddress(message), length)
        copy.store(length, 0)
        result = copy.adoptString(length)
        LLVMDisposeMessage(message)
    }
    result
}

// The host CPU's name and its features, as LLJIT targets them.
fun llvmHostCpuName(): string = llvmTakeMessage(LLVMGetHostCPUName())
fun llvmHostCpuFeatures(): string = llvmTakeMessage(LLVMGetHostCPUFeatures())

trusted fun llvmDefaultTargetTriple(): string {
    val triple = LLVMGetDefaultTargetTriple()
    var result = ""
    if (!pointerIsNull(triple)) {
        var length = 0
        while (ablaUnsafeLoadU8(
            ablaUnsafePointerOffset(triple, length)
        ) != 0) length = length + 1
        val copy = nativeByteBuffer(length + 1)
        var index = 0
        while (index < length) {
            copy.store(index, ablaUnsafeLoadU8(
                ablaUnsafePointerOffset(triple, index)
            ))
            index = index + 1
        }
        copy.store(length, 0)
        result = copy.adoptString(length)
        LLVMDisposeMessage(triple)
    }
    result
}

class LlvmOrcSession(
    val jit: i64*,
    val dylib: i64*,
    val status: int,
    var closed: bool
)

class LlvmOrcGeneration(
    val tracker: i64*,
    val status: int,
    var closed: bool
)

class LlvmOrcLookup(
    val status: int,
    val address: int
)

// A session owns one LLJIT instance and its process symbol generator. Modules
// can be added and reclaimed independently through generation trackers.
fun llvmOrcCreateSession(): LlvmOrcSession {
    val nullPointer = nativeNullPointer()
    val jit = nativePointerCell(nullPointer)
    val processGenerator = nativePointerCell(nullPointer)
    var status = llvmInitializeNativeTarget()
    if (status == 0) status = llvmConsumeError(
            LLVMOrcCreateLLJIT(jit.address, nullPointer),
            122
        )
    var dylib = nullPointer
    if (status == 0) {
        dylib = LLVMOrcLLJITGetMainJITDylib(jit.load())
        status = llvmConsumeError(
            LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(
                processGenerator.address,
                LLVMOrcLLJITGetGlobalPrefix(jit.load()),
                nullPointer,
                nullPointer
            ),
            123
        )
    }
    if (status == 0) {
        LLVMOrcJITDylibAddGenerator(dylib, processGenerator.load())
        LLVMOrcObjectTransformLayerSetTransform(
            LLVMOrcLLJITGetObjTransformLayer(jit.load()),
            nativeFunctionAddress(llvmOrcCaptureObject),
            nullPointer
        )
    }
    if (status != 0 && !pointerIsNull(jit.load())) {
        llvmConsumeError(LLVMOrcDisposeLLJIT(jit.load()), 126)
        jit.store(nullPointer)
    }
    val session = LlvmOrcSession(jit.load(), dylib, status, status != 0)
    jit.close()
    processGenerator.close()
    session
}

// The IR pipelines of the middle profile (--o1: scalar promotion, the inliner
// and local cleanup, without O2's loop and global passes) and of the fast one
// (scalar promotion and CFG cleanup). The ahead-of-time profiles and the JIT
// (`ablac run`) share them.
fun llvmPassesBalanced(): string =
    "function(mem2reg,simplifycfg),cgscc(inline,function(sroa,early-cse,instcombine<no-verify-fixpoint>,simplifycfg)),globaldce"

fun llvmPassesFast(): string = "function(mem2reg,simplifycfg)"

// Adds the module in `path`, after running the IR pipeline `passes` on it
// (none when empty: the frontend's IR as it is).
fun LlvmOrcSession.addFile(path: string, passes: string = ""): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    var status: int = 128
    if (!this.closed && this.status == 0) {
        status = LLVMCreateMemoryBufferWithContentsOfFile(
            path,
            buffer.address,
            message.address
        )
    }
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    val generation = this.addBuffer(buffer.load(), status, passes)
    buffer.close()
    message.close()
    generation
}

// Adds the textual IR module `ir` (`name` in LLVM's messages), after running
// the IR pipeline `passes` on it.
fun LlvmOrcSession.addText(
    name: string,
    ir: string,
    passes: string = ""
): LlvmOrcGeneration {
    var status: int = 128
    var buffer = nativeNullPointer()
    if (!this.closed && this.status == 0) {
        buffer = LLVMCreateMemoryBufferWithMemoryRangeCopy(ir, ir.size, name)
        status = if (pointerIsNull(buffer)) 120 else 0
    }
    this.addBuffer(buffer, status, passes)
}

// Parses the memory buffer `source` (consumed; `initialStatus` says how
// creating it went) and adds its module through a new generation tracker.
fun LlvmOrcSession.addBuffer(
    source: i64*,
    initialStatus: int,
    passes: string
): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    val message = nativePointerCell(nullPointer)
    val module = nativePointerCell(nullPointer)
    val context = LLVMContextCreate()
    var contextTransferred = false
    var threadModuleOwned = false
    var threadContextDisposed = false
    var status = initialStatus
    if (status == 0) {
        status = LLVMParseIRInContext(
            context,
            source,
            module.address,
            message.address
        )
        // LLVMParseIRInContext consumes the memory buffer.
        if (status != 0) status = 121
    }
    if (status != 0 && status != 128 && status != 121) status = 120
    if (status == 0 && passes != "") {
        val options = LLVMCreatePassBuilderOptions()
        status = llvmConsumeError(
            LLVMRunPasses(module.load(), passes, nullPointer, options), 129
        )
        LLVMDisposePassBuilderOptions(options)
    }
    var threadContext = nullPointer
    var threadModule = nullPointer
    var tracker = nullPointer
    if (status == 0) {
        threadContext = LLVMOrcCreateNewThreadSafeContextFromLLVMContext(
            context
        )
        contextTransferred = true
        threadModule = LLVMOrcCreateNewThreadSafeModule(
            module.load(),
            threadContext
        )
        threadModuleOwned = true
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) status = 124
    }
    if (status == 0) {
        status = llvmConsumeError(
            LLVMOrcLLJITAddLLVMIRModuleWithRT(
                this.jit,
                tracker,
                threadModule
            ),
            124
        )
        // The WithRT API consumes the thread-safe module even on failure.
        threadModuleOwned = false
        LLVMOrcDisposeThreadSafeContext(threadContext)
        threadContextDisposed = true
    }
    if (!contextTransferred) LLVMContextDispose(context)
    if (threadModuleOwned && !pointerIsNull(threadModule)) {
        LLVMOrcDisposeThreadSafeModule(threadModule)
    }
    if (contextTransferred && !threadContextDisposed &&
        !pointerIsNull(threadContext)) {
        LLVMOrcDisposeThreadSafeContext(threadContext)
    }
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nullPointer
    }
    message.close()
    module.close()
    LlvmOrcGeneration(tracker, status, status != 0)
}

// Adds an in-memory module (as the backend keeps it: bootstrapLlvmHoldModule)
// after running the IR pipeline `passes` on it (none when empty). The session
// takes ownership of `context` and `module` whatever the outcome.
fun LlvmOrcSession.addModule(
    context: i64*,
    module: i64*,
    passes: string = ""
): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    var status: int = 128
    if (!this.closed && this.status == 0 && !pointerIsNull(module)) status = 0
    if (status == 0 && passes != "") {
        val options = LLVMCreatePassBuilderOptions()
        status = llvmConsumeError(
            LLVMRunPasses(module, passes, nullPointer, options), 129
        )
        LLVMDisposePassBuilderOptions(options)
    }
    var tracker = nullPointer
    if (status == 0) {
        val threadContext =
            LLVMOrcCreateNewThreadSafeContextFromLLVMContext(context)
        val threadModule = LLVMOrcCreateNewThreadSafeModule(
            module,
            threadContext
        )
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) {
            status = 124
            LLVMOrcDisposeThreadSafeModule(threadModule)
        } else {
            // The WithRT API consumes the thread-safe module even on failure.
            status = llvmConsumeError(
                LLVMOrcLLJITAddLLVMIRModuleWithRT(
                    this.jit,
                    tracker,
                    threadModule
                ),
                124
            )
        }
        LLVMOrcDisposeThreadSafeContext(threadContext)
    } else {
        if (!pointerIsNull(module)) LLVMDisposeModule(module)
        if (!pointerIsNull(context)) LLVMContextDispose(context)
    }
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nullPointer
    }
    LlvmOrcGeneration(tracker, status, status != 0)
}

// Adds an object file's contents (`buffer`, which the call consumes) as a
// generation of its own.
fun LlvmOrcSession.addObjectBuffer(buffer: i64*): LlvmOrcGeneration {
    var status = if (this.closed || this.status != 0) 128 else 0
    var tracker = nativeNullPointer()
    if (status == 0) {
        tracker = LLVMOrcJITDylibCreateResourceTracker(this.dylib)
        if (pointerIsNull(tracker)) status = 124
    }
    if (status == 0) {
        // Consumes the buffer even on failure.
        status = llvmConsumeError(
            LLVMOrcLLJITAddObjectFileWithRT(this.jit, tracker, buffer), 124
        )
    } else LLVMDisposeMemoryBuffer(buffer)
    if (status != 0 && !pointerIsNull(tracker)) {
        llvmConsumeError(LLVMOrcResourceTrackerRemove(tracker), 127)
        LLVMOrcReleaseResourceTracker(tracker)
        tracker = nativeNullPointer()
    }
    LlvmOrcGeneration(tracker, status, status != 0)
}

// Adds the object file at `path` (one `lookupCapturing` wrote, say) without
// compiling anything: status 120 when it cannot be read.
fun LlvmOrcSession.addObjectFile(path: string): LlvmOrcGeneration {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    var status = if (this.closed || this.status != 0) 128 else 0
    if (status == 0 && LLVMCreateMemoryBufferWithContentsOfFile(
        path, buffer.address, message.address
    ) != 0) status = 120
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    val loaded = buffer.load()
    buffer.close()
    message.close()
    if (status == 0) this.addObjectBuffer(loaded)
    else LlvmOrcGeneration(nullPointer, status, true)
}

// Objects the JIT generated while a capture was armed (`lookupCapturing`), as
// their bytes. Every session's object layer passes what it links through
// llvmOrcCaptureObject, so a capture sees exactly the code LLJIT generated.
var llvmOrcCapturing: bool = false
var llvmOrcCaptured: array<string> = []

// The transform's C signature, `LLVMErrorRef (void *, LLVMMemoryBufferRef *)`, as
// addresses (nativeFunctionAddress takes scalar signatures): no error, ever.
trusted fun llvmOrcCaptureObject(context: i64, objectInOut: i64): i64 {
    if (llvmOrcCapturing) {
        val buffer = NativePointerCell(nativePointerFromAddress(objectInOut), false, false).load()
        val size = LLVMGetBufferSize(buffer)
        val copy = nativeByteBuffer(size + 1)
        ablaUnsafeCopyMemory(
            nativePointerAddress(copy.address),
            nativePointerAddress(LLVMGetBufferStart(buffer)),
            size
        )
        llvmOrcCaptured.append(copy.adoptString(size))
    }
    0
}

// Looks `name` up like `lookup`, keeping the machine code that generating it
// took: when exactly one module was compiled for it, its object is published at
// `objectPath` (written beside it, then renamed) for a later `addObjectFile`, and
// `captured` is true. Nothing is published when nothing (or more than one module)
// was compiled, or the object cannot be written.
fun LlvmOrcSession.lookupCapturing(name: string, objectPath: string): LlvmOrcCapture {
    llvmOrcCaptured.truncate(0)
    llvmOrcCapturing = true
    val found = this.lookup(name)
    llvmOrcCapturing = false
    var captured = false
    if (found.status == 0 && llvmOrcCaptured.size == 1) {
        val staged = Path("$objectPath.tmp.${linuxProcessId()}")
        captured = staged.writeText(llvmOrcCaptured[0]) && staged.moveTo(Path(objectPath))
        if (!captured) staged.remove()
    }
    llvmOrcCaptured.truncate(0)
    LlvmOrcCapture(found.status, found.address, captured)
}

class LlvmOrcCapture(
    val status: int,
    val address: int,
    val captured: bool
)

fun LlvmOrcSession.lookup(name: string): LlvmOrcLookup {
    val address = nativeI64Cell(0)
    var status: int = 128
    if (!this.closed && this.status == 0) {
        status = llvmConsumeError(
            LLVMOrcLLJITLookup(this.jit, address.address, name),
            125
        )
    }
    val result = LlvmOrcLookup(status, address.load())
    address.close()
    result
}

fun LlvmOrcGeneration.remove(): int {
    var status = 0
    if (!this.closed) {
        status = llvmConsumeError(
            LLVMOrcResourceTrackerRemove(this.tracker),
            127
        )
        LLVMOrcReleaseResourceTracker(this.tracker)
        this.closed = true
    }
    status
}

fun LlvmOrcSession.close(): int {
    var status = 0
    if (!this.closed) {
        status = llvmConsumeError(LLVMOrcDisposeLLJIT(this.jit), 126)
        this.closed = true
    }
    status
}

trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I32_I32_Pointer(address: int, count: int, vector: i64*): int

// Calls a JIT-compiled `main(argc, argv)` with a process-start style block: argv =
// [program, arguments…, NULL] followed by the host's envp (the runtime finds its
// environment right after argv's NULL, as on the initial process stack), so the
// program reads processArgument()/linuxEnvironment() as a built executable would.
trusted fun llvmOrcCallMain(address: int, program: string, arguments: array<string>): int {
    val argc = arguments.size + 1
    val environment = linuxEnvironmentPointer()
    var environmentCount = 0
    if (!pointerIsNull(environment)) {
        while (!pointerIsNull(NativePointerCell(ablaUnsafePointerOffset(environment, environmentCount * 8), false, false).load())) {
            environmentCount = environmentCount + 1
        }
    }
    val table = (argc + 1 + environmentCount + 1) * 8
    var bytes = program.size + 1
    for (argument in arguments) bytes = bytes + argument.size + 1
    var block = nativeByteBuffer(table + bytes)
    var text = table
    var slot = 0
    while (slot < argc) {
        val value = if (slot == 0) program else arguments[slot - 1]
        block.storePointer(slot * 8, ablaUnsafePointerOffset(block.address, text))
        var index = 0
        while (index < value.size) {
            block.store(text + index, value[index])
            index = index + 1
        }
        block.store(text + value.size, 0)
        text = text + value.size + 1
        slot = slot + 1
    }
    block.storePointer(argc * 8, nativeNullPointer())
    var entry = 0
    while (entry < environmentCount) {
        block.storePointer((argc + 1 + entry) * 8, NativePointerCell(ablaUnsafePointerOffset(environment, entry * 8), false, false).load())
        entry = entry + 1
    }
    block.storePointer((argc + 1 + environmentCount) * 8, nativeNullPointer())
    val status = ablaUnsafeCallExact_I32_I32_Pointer(address, argc, block.address)
    block.close()
    status
}

// Returns the JIT-compiled program's main result. Infrastructure failures use
// 120-129 (129: the IR pipeline failed), keeping them distinct from normal
// compiler diagnostics. `arguments` reach the program as processArgument(0…),
// with `program` (default: `path`) as its argv[0]. `passes` is the IR pipeline
// the module gets first (none when empty).
fun llvmOrcRunFile(
    path: string,
    program: string = "",
    arguments: array<string> = [],
    passes: string = ""
): int {
    val session = llvmOrcCreateSession()
    val generation = session.addFile(path, passes)
    var result = generation.status
    if (result == 0) {
        val lookup = session.lookup("main")
        result = lookup.status
        if (result == 0) result = llvmOrcCallMain(lookup.address, if (program == "") path else program, arguments)
    }
    val removeStatus = generation.remove()
    if (result == 0 && removeStatus != 0) result = removeStatus
    val closeStatus = session.close()
    if (result == 0 && closeStatus != 0) result = closeStatus
    result
}
