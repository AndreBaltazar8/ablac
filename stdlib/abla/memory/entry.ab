import "abla/runtime/memory"

// Portable facade over the target-selected allocation tracker. Resetting a
// region invalidates every heap-backed value created after its checkpoint;
// semantic escape checks keep those values out of older state.

fun memoryCheckpoint(): int = runtimeMemoryCheckpoint()

fun memoryReset(checkpoint: int) = runtimeMemoryReset(checkpoint)

fun memoryLiveBytes(): int = runtimeMemoryLiveBytes()

// All targets start with a one-GiB tracked-heap budget. Programs which
// intentionally need more must raise it explicitly.
fun memoryLimit(): int = runtimeMemoryLimit()

fun memorySetLimit(limit: int) = runtimeMemorySetLimit(limit)

// Explicit safe point. Returns the number of unreachable tracked bytes freed.
fun memoryCollect(): int = runtimeMemoryCollect()
