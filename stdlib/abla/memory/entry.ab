import "abla/runtime/memory"

// Portable facade over the target-selected allocation tracker. Resetting a
// region invalidates every heap-backed value created after its checkpoint;
// semantic escape checks keep those values out of older state.

fun memoryCheckpoint(): int = runtimeMemoryCheckpoint()

fun memoryReset(checkpoint: int) = runtimeMemoryReset(checkpoint)

fun memoryLiveBytes(): int = runtimeMemoryLiveBytes()

// All targets start with a one-GiB tracked-heap budget. Programs which
// intentionally need more must raise it explicitly.
fun memoryLimit(): int = runtimeMemoryLimit()

// Set the tracked-heap budget; it also turns on collection under pressure.
// Reaching it is the "memory limit exceeded" panic, and so is reachable data
// held within about 1/64 of it: pressure collection does not run on every
// allocating call there (see standard-library.md).
fun memorySetLimit(limit: int) = runtimeMemorySetLimit(limit)

// Turn on collection under allocation pressure (as memorySetLimit does): a
// collection runs at the next allocating call once the tracked heap has grown
// `bytes` (or half again, if more) past what the last collection kept. The
// default is 64 MiB; programs that make bursts of garbage (a level load) and
// care about their footprint pick less.
fun memorySetCollectionGrowth(bytes: int) = runtimeMemorySetCollectionGrowth(bytes)

// Manual collection. A hosted native program collects under allocation
// pressure by default, which makes every allocating function a rooted safe
// point. Calling this anywhere `main` can reach compiles the program without
// those safe points (smaller, faster code), and at run time it stops pressure
// collection: only memoryCollect() frees garbage, and only the functions that
// can reach it keep roots. A later memorySetLimit or memorySetCollectionGrowth
// turns pressure collection back on (a program that can reach either keeps its
// safe points). Wasm and freestanding programs are manual by default.
fun memorySetManualCollection() = runtimeMemorySetManualCollection()

// Background freeing (hosted native targets; elsewhere a no-op): each collection
// hands what it found unreachable to a helper thread of the runtime's own, which
// frees it while the program goes on, so a collection's pause no longer includes
// returning that memory to the system allocator. Off by default: a program that
// turns it on has that thread during and after each collection. Results are the
// same either way.
fun memorySetBackgroundFree(enabled: bool) = runtimeMemorySetBackgroundFree(enabled)

// Allocator numbers for diagnostics: 0 linear memory bytes, 1 bytes ever
// handed out by the bump cursor, 2 / 3 bytes parked on the small / large free
// lists, 4 tracked live bytes. Targets without them report 0.
fun memoryHeapStat(which: int): int = runtimeMemoryHeapStat(which)

/** What the tracked heap holds, for diagnostics (memoryCensus). Each array
 *  has an entry per allocation layout (0 words, 1 bytes such as a string's,
 *  2 boxed values, 3 32-byte slots such as an instance's extension fields,
 *  4 arrays, 5 class instances, 6 ropes, 7 TVars, 10 unsafe memory,
 *  11 thread controls, 12 checkpoints). `fieldTags` counts the instances'
 *  declared fields by the tag of the value each holds (1 null, 2 int, f64 or
 *  f32, 3 bool, 4 string, 5 function, 6 cell, 7 array, 8 instance, 9-14 the
 *  runtime's shared, task, channel and TVar values). `overhead` is what the
 *  allocations cost past their payloads: their headers, and on Wasm the
 *  allocator's block headers and size-class rounding (a hosted target's
 *  system allocator keeps its own). A region's allocations are not counted. */
class MemoryCensus(
    val counts: array<int>,
    val bytes: array<int>,
    val fieldTags: array<int>,
    val overhead: int
)

// Walks the tracked heap once. It collects nothing: call memoryCollect() first
// to count only what is reachable.
fun memoryCensus(): MemoryCensus {
    val words = runtimeMemoryCensus()
    MemoryCensus(
        memoryCensusPart(words, 0), memoryCensusPart(words, 16),
        memoryCensusPart(words, 32), words[48]
    )
}

private fun memoryCensusPart(words: array<int>, start: int): array<int> {
    val part: array<int> = []
    for (index in start until start + 16) part.append(words[index])
    part
}

// Explicit safe point. Returns the number of unreachable tracked bytes freed.
fun memoryCollect(): int = runtimeMemoryCollect()

// Copy a region-owned string into its parent allocation domain. This is the
// explicit lifetime boundary used when a request result must survive reset.
fun memoryPromoteString(value: string): string =
    runtimeMemoryPromoteString(value)
