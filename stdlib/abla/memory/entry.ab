import "abla/runtime/memory"

// Portable facade over the target-selected allocation tracker. Resetting a
// region invalidates every heap-backed value created after its checkpoint;
// semantic escape checks keep those values out of older state.

fun memoryCheckpoint(): int = runtimeMemoryCheckpoint()

fun memoryReset(checkpoint: int) = runtimeMemoryReset(checkpoint)

fun memoryLiveBytes(): int = runtimeMemoryLiveBytes()

// All targets start with a one-GiB tracked-heap budget. Programs which
// intentionally need more must raise it explicitly.
fun memoryLimit(): int = runtimeMemoryLimit()

fun memorySetLimit(limit: int) = runtimeMemorySetLimit(limit)

// Turn on collection under allocation pressure (as memorySetLimit does): a
// collection runs at the next allocating call once the tracked heap has grown
// `bytes` (or half again, if more) past what the last collection kept. The
// default is 64 MiB; programs that make bursts of garbage (a level load) and
// care about their footprint pick less.
fun memorySetCollectionGrowth(bytes: int) = runtimeMemorySetCollectionGrowth(bytes)

// Allocator numbers for diagnostics: 0 linear memory bytes, 1 bytes ever
// handed out by the bump cursor, 2 / 3 bytes parked on the small / large free
// lists, 4 tracked live bytes. Targets without them report 0.
fun memoryHeapStat(which: int): int = runtimeMemoryHeapStat(which)

// Explicit safe point. Returns the number of unreachable tracked bytes freed.
fun memoryCollect(): int = runtimeMemoryCollect()

// Copy a region-owned string into its parent allocation domain. This is the
// explicit lifetime boundary used when a request result must survive reset.
fun memoryPromoteString(value: string): string =
    runtimeMemoryPromoteString(value)
