trusted noescape extern:"intrinsic" fun ablaSimd_load_f64x4(address: int): f64x4
trusted noescape extern:"intrinsic" fun ablaSimd_store_f64x4(address: int, v: f64x4): void
@inline fun f64x4(l0: f64, l1: f64, l2: f64, l3: f64): f64x4 = ablaSimd_make_f64x4(l0, l1, l2, l3)
@inline fun f64x4Splat(value: f64): f64x4 = ablaSimd_splat_f64x4(value)
@inline fun f64x4.get(index: int): f64 {
    if (index < 0 || index >= 4) panic("f64x4: no lane $index")
    ablaSimd_get_f64x4(this, index)
}
@inline fun f64x4.with(index: int, value: f64): f64x4 {
    if (index < 0 || index >= 4) panic("f64x4: no lane $index")
    ablaSimd_with_f64x4(this, index, value)
}
fun f64x4Load(data: string, offset: int = 0): f64x4 {
    if (offset < 0 || offset > data.size -
        32) panic("f64x4Load: offset $offset in ${data.size} bytes")
    f64x4LoadAddress(nativeStringDataAddress(data) + offset)
}
trusted fun f64x4LoadAddress(address: int): f64x4 = ablaSimd_load_f64x4(address)
trusted fun f64x4.storeAddress(address: int): void = ablaSimd_store_f64x4(address, this)
@inline fun f64x4.bytes(): string = ablaSimd_bytes_f64x4(this)
fun f64x4.text(): string {
    var text = "["
    for (lane in 0 until 4) {
        if (lane > 0) text = text + ", "
        text = text + f64Text(this.get(lane))
    }
    text + "]"
}
noescape extern:"intrinsic" fun f64x4Shuffle(a: f64x4, b: f64x4, i0: int, i1: int, i2: int,
    i3: int): f64x4
@inline fun f64x4.interleaveLow(other: f64x4): f64x4 = f64x4Shuffle(this, other, 0, 4, 1, 5)
@inline fun f64x4.interleaveHigh(other: f64x4): f64x4 = f64x4Shuffle(this, other, 2, 6, 3, 7)
@inline fun f64x4.reverse(): f64x4 = f64x4Shuffle(this, this, 3, 2, 1, 0)
