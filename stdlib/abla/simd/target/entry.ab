// What the target has, at compile time and at run time (docs/simd.md).

import "abla/process/exit"

noescape extern:"intrinsic" fun ablaSimdTargetArch(): int
noescape extern:"intrinsic" fun ablaSimdCpuProbe(leaf: int, sub: int, register: int): int

val SIMD_ARCH_OTHER = 0
val SIMD_ARCH_X86_64 = 1
val SIMD_ARCH_AARCH64 = 2
val SIMD_ARCH_WASM = 3
val SIMD_ARCH_XTENSA = 4

/** The architecture this program is compiled for; constant in the compiled code. */
fun simdTargetArch(): int = ablaSimdTargetArch()

/** Whether the build's baseline has `feature` on every CPU of the target: "sse2" on x86-64,
 *  "neon" on AArch64, "simd128" on Wasm. The answer is a constant, so a branch on it costs
 *  nothing. Anything else needs cpuHas. */
fun targetHas(feature: string): bool {
    val arch = ablaSimdTargetArch()
    if (feature == "sse2") arch == SIMD_ARCH_X86_64
    else if (feature == "neon") arch == SIMD_ARCH_AARCH64
    else if (feature == "simd128") arch == SIMD_ARCH_WASM
    else if (simdFeatureKnown(feature)) false
    else panic("targetHas: unknown feature `$feature`")
}

fun simdFeatureKnown(feature: string): bool =
    feature == "aes" || feature == "clmul" || feature == "avx2" ||
    feature == "sse41" || feature == "ssse3"

private var simdCpuBits = -1
private val SIMD_BIT_AES = 1
private val SIMD_BIT_CLMUL = 2
private val SIMD_BIT_AVX2 = 4
private val SIMD_BIT_SSE41 = 8
private val SIMD_BIT_SSSE3 = 16

private fun simdProbe(): int {
    val arch = ablaSimdTargetArch()
    var bits = 0
    if (arch == SIMD_ARCH_X86_64) {
        val maximum = ablaSimdCpuProbe(0, 0, 0)
        val c = ablaSimdCpuProbe(1, 0, 2)
        if (((c >> 25) & 1) == 1) bits = bits | SIMD_BIT_AES
        if (((c >> 1) & 1) == 1) bits = bits | SIMD_BIT_CLMUL
        if (((c >> 19) & 1) == 1) bits = bits | SIMD_BIT_SSE41
        if (((c >> 9) & 1) == 1) bits = bits | SIMD_BIT_SSSE3
        // AVX2 also needs the system to save the wider registers.
        if (maximum >= 7 && ((c >> 27) & 1) == 1 && ((c >> 28) & 1) == 1 &&
            (ablaSimdCpuProbe(0, 0, 4) & 6) == 6 &&
            ((ablaSimdCpuProbe(7, 0, 1) >> 5) & 1) == 1) bits = bits | SIMD_BIT_AVX2
    } else if (arch == SIMD_ARCH_AARCH64) {
        val field = (ablaSimdCpuProbe(0, 0, 0) >> 4) & 15
        if (field >= 1) bits = bits | SIMD_BIT_AES
        if (field >= 2) bits = bits | SIMD_BIT_CLMUL
    }
    bits
}

/** Whether this CPU, the one running now, has `feature`: "aes", "clmul", "avx2", "sse41",
 *  "ssse3", or what targetHas answers for. False where the target has no way to have it. */
fun cpuHas(feature: string): bool {
    if (simdCpuBits < 0) simdCpuBits = simdProbe()
    val bit = if (feature == "aes") SIMD_BIT_AES
        else if (feature == "clmul") SIMD_BIT_CLMUL
        else if (feature == "avx2") SIMD_BIT_AVX2
        else if (feature == "sse41") SIMD_BIT_SSE41
        else if (feature == "ssse3") SIMD_BIT_SSSE3
        else 0
    if (bit == 0) targetHas(feature) else (simdCpuBits & bit) != 0
}
