// public: abla/simd
// SIMD primitives shared by the public vector API and the native byte scanners.

// Returns a vector with the same value in every lane.
noescape extern:"intrinsic" fun ablaSimd_splat_u8x16(value: u8): u8x16
// Returns a vector with the same value in every lane.
@inline fun u8x16Splat(value: u8): u8x16 = ablaSimd_splat_u8x16(value)
// Loads 16 bytes as a vector from a readable address at any alignment.
trusted noescape extern:"intrinsic" fun ablaSimd_load_u8x16(address: int): u8x16
// Loads 16 bytes as a vector from a readable address at any alignment.
trusted fun u8x16LoadAddress(address: int): u8x16 = ablaSimd_load_u8x16(address)
// Stores 16 vector bytes at a writable address at any alignment.
trusted noescape extern:"intrinsic" fun ablaSimd_store_u8x16(address: int, v: u8x16): void
// Stores 16 vector bytes at a writable address at any alignment.
trusted fun u8x16.storeAddress(address: int): void = ablaSimd_store_u8x16(address, this)
// Returns the lanes selected by literal indices from the concatenation of the two inputs, with indices from 0 through 31.
noescape extern:"intrinsic" fun u8x16Shuffle(a: u8x16, b: u8x16, i0: int, i1: int, i2: int, i3: int,
    i4: int, i5: int, i6: int, i7: int, i8: int, i9: int, i10: int, i11: int, i12: int, i13: int,
    i14: int, i15: int): u8x16
// Returns the lanewise sum, wrapping on integer overflow.
noescape extern:"intrinsic" fun ablaSimd_add_u8x16(a: u8x16, b: u8x16): u8x16
// Returns the lanewise sum, wrapping on integer overflow.
@inline operator fun u8x16.plus(other: u8x16): u8x16 = ablaSimd_add_u8x16(this, other)
// Returns the lanewise difference, wrapping on integer overflow.
noescape extern:"intrinsic" fun ablaSimd_sub_u8x16(a: u8x16, b: u8x16): u8x16
// Returns the lanewise difference, wrapping on integer overflow.
@inline operator fun u8x16.minus(other: u8x16): u8x16 = ablaSimd_sub_u8x16(this, other)
// Returns the lanewise bitwise AND.
noescape extern:"intrinsic" fun ablaSimd_and_u8x16(a: u8x16, b: u8x16): u8x16
// Returns the lanewise bitwise AND.
@inline operator fun u8x16.and(other: u8x16): u8x16 = ablaSimd_and_u8x16(this, other)
// Returns the lanewise bitwise inclusive OR.
noescape extern:"intrinsic" fun ablaSimd_or_u8x16(a: u8x16, b: u8x16): u8x16
// Returns the lanewise bitwise inclusive OR.
@inline operator fun u8x16.or(other: u8x16): u8x16 = ablaSimd_or_u8x16(this, other)
// Returns a mask whose lanes are all ones where the first lane is equal to the second and all zeros elsewhere.
noescape extern:"intrinsic" fun ablaSimd_eq_u8x16(a: u8x16, b: u8x16): u8x16
// Returns a mask whose lanes are all ones where the first lane is equal to the second and all zeros elsewhere.
@inline fun u8x16.eq(other: u8x16): u8x16 = ablaSimd_eq_u8x16(this, other)
// Returns a mask whose lanes are all ones where the first lane is less than the second and all zeros elsewhere.
noescape extern:"intrinsic" fun ablaSimd_lt_u8x16(a: u8x16, b: u8x16): u8x16
// Returns a mask whose lanes are all ones where the first lane is less than the second and all zeros elsewhere.
@inline fun u8x16.lt(other: u8x16): u8x16 = ablaSimd_lt_u8x16(this, other)
// Returns an all-ones lane when the first value is less than or equal to the second, or a zero lane otherwise.
noescape extern:"intrinsic" fun ablaSimd_le_u8x16(a: u8x16, b: u8x16): u8x16
// Returns an all-ones lane when the first value is less than or equal to the second, or a zero lane otherwise.
@inline fun u8x16.le(other: u8x16): u8x16 = ablaSimd_le_u8x16(this, other)
// Returns an all-ones lane when the first value is greater than or equal to the second, or a zero lane otherwise.
noescape extern:"intrinsic" fun ablaSimd_ge_u8x16(a: u8x16, b: u8x16): u8x16
// Returns an all-ones lane when the first value is greater than or equal to the second, or a zero lane otherwise.
@inline fun u8x16.ge(other: u8x16): u8x16 = ablaSimd_ge_u8x16(this, other)
// Returns an integer containing each lane's top bit, with lane zero in the least significant position.
noescape extern:"intrinsic" fun ablaSimd_bitmask_u8x16(a: u8x16): int
// Returns an integer containing each lane's top bit, with lane zero in the least significant position.
@inline fun u8x16.bitmask(): int = ablaSimd_bitmask_u8x16(this)
// Returns true if every lane has its top bit set.
@inline fun u8x16.all(): bool = ablaSimd_bitmask_u8x16(this) == 65535
// Returns the same 128 bits reinterpreted as `u32x4`.
noescape extern:"intrinsic" fun ablaSimd_bits_u8x16_u32x4(a: u8x16): u32x4
// Returns the same 128 bits reinterpreted as `u32x4`.
@inline fun u8x16.asU32x4(): u32x4 = ablaSimd_bits_u8x16_u32x4(this)
// Returns the same 128 bits reinterpreted as `u8x16`.
noescape extern:"intrinsic" fun ablaSimd_bits_u32x4_u8x16(a: u32x4): u8x16
// Returns the same 128 bits reinterpreted as `u8x16`.
@inline fun u32x4.asU8x16(): u8x16 = ablaSimd_bits_u32x4_u8x16(this)
// Returns a vector with the same value in every lane.
noescape extern:"intrinsic" fun ablaSimd_splat_u32x4(value: u32): u32x4
// Returns a vector with the same value in every lane.
@inline fun u32x4Splat(value: u32): u32x4 = ablaSimd_splat_u32x4(value)
// Returns the lanewise bitwise AND.
noescape extern:"intrinsic" fun ablaSimd_and_u32x4(a: u32x4, b: u32x4): u32x4
// Returns the lanewise bitwise AND.
@inline operator fun u32x4.and(other: u32x4): u32x4 = ablaSimd_and_u32x4(this, other)
// Returns the lanewise bitwise inclusive OR.
noescape extern:"intrinsic" fun ablaSimd_or_u32x4(a: u32x4, b: u32x4): u32x4
// Returns the lanewise bitwise inclusive OR.
@inline operator fun u32x4.or(other: u32x4): u32x4 = ablaSimd_or_u32x4(this, other)
// Returns each lane shifted left, or a zero vector if the count is outside 0 through 31.
noescape extern:"intrinsic" fun ablaSimd_shl_u32x4(a: u32x4, count: int): u32x4
// Returns each lane shifted left, or a zero vector if the count is outside 0 through 31.
@inline operator fun u32x4.shl(count: int): u32x4 = ablaSimd_shl_u32x4(this, count)
// Returns each lane shifted logically right, or a zero vector if the count is outside 0 through 31.
noescape extern:"intrinsic" fun ablaSimd_shr_u32x4(a: u32x4, count: int): u32x4
// Returns each lane shifted logically right, or a zero vector if the count is outside 0 through 31.
@inline operator fun u32x4.shr(count: int): u32x4 = ablaSimd_shr_u32x4(this, count)
