import "abla/unsafe/memory"

// Allocation generations are normal runtime functions. Only the raw loads,
// stores, pointer conversions, and allocator system calls are intrinsic or
// platform boundaries.
fun runtimeMemoryCheckpoint(): int =
    __ablaRuntimePlatformMemoryCheckpoint()

fun runtimeMemoryReset(checkpoint: int) =
    __ablaRuntimePlatformMemoryReset(checkpoint)

fun runtimeMemoryLiveBytes(): int =
    __ablaRuntimePlatformMemoryLiveBytes()

fun runtimeMemoryLimit(): int =
    __ablaRuntimePlatformMemoryLimit()

fun runtimeMemorySetLimit(limit: int) =
    __ablaRuntimePlatformMemorySetLimit(limit)

fun runtimeMemorySetCollectionGrowth(bytes: int) =
    __ablaRuntimePlatformMemorySetCollectionGrowth(bytes)

fun runtimeMemorySetManualCollection() =
    __ablaRuntimePlatformMemorySetManualCollection()

fun runtimeMemorySetBackgroundFree(enabled: bool) =
    __ablaRuntimePlatformMemorySetBackgroundFree(enabled)

fun runtimeMemoryHeapStat(which: int): int =
    __ablaRuntimePlatformMemoryHeapStat(which)

fun runtimeMemoryCollect(): int =
    __ablaRuntimePlatformMemoryCollect()

// The census's words (see __ablaRuntimeMemoryCensusWords), read after the
// platform's walk, so the array holding them is not counted.
fun runtimeMemoryCensus(): array<int> {
    __ablaRuntimePlatformMemoryCensusTake()
    val words: array<int> = []
    var index = 0
    while (index < __ablaRuntimeMemoryCensusWords()) {
        words.append(__ablaRuntimePlatformMemoryCensusWord(index))
        index = index + 1
    }
    words
}

// Whether a `region { … }` is active: what is allocated now is freed when it ends,
// so a cache kept beyond the current call must not hold it.
fun runtimeMemoryRegionActive(): bool =
    __ablaRuntimePlatformRegionActive()

trusted fun runtimeMemoryPromoteString(value: string): string {
    var promoted = value
    if (__ablaRuntimePlatformRegionActive()) {
        val length = value.size
        val address = __ablaRuntimeAllocateLayout(length + 1, 1)
        var index = 0
        while (index < length) {
            ablaRuntimeStoreU8(address + index, value[index])
            index = index + 1
        }
        ablaRuntimeStoreU8(address + length, 0)
        val promotedAddress =
            __ablaRuntimePlatformPromoteAllocation(address)
        promoted = adoptNativeString(promotedAddress, length)
    }
    promoted
}
