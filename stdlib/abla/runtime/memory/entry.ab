import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// Allocation generations are normal runtime functions. Only the raw loads,
// stores, pointer conversions, and allocator system calls are intrinsic or
// platform boundaries.
fun runtimeMemoryCheckpoint(): int =
    __ablaRuntimePlatformMemoryCheckpoint()

fun runtimeMemoryReset(checkpoint: int) =
    __ablaRuntimePlatformMemoryReset(checkpoint)

fun runtimeMemoryLiveBytes(): int =
    __ablaRuntimePlatformMemoryLiveBytes()

fun runtimeMemoryLimit(): int =
    __ablaRuntimePlatformMemoryLimit()

fun runtimeMemorySetLimit(limit: int) =
    __ablaRuntimePlatformMemorySetLimit(limit)

fun runtimeMemorySetCollectionGrowth(bytes: int) =
    __ablaRuntimePlatformMemorySetCollectionGrowth(bytes)

fun runtimeMemorySetFreeBlockLimit(bytes: int) =
    __ablaRuntimePlatformMemorySetFreeBlockLimit(bytes)

fun runtimeMemorySetStress(on: bool): void = __ablaRuntimePlatformMemorySetStress(on)

fun runtimeMemorySetTrace(on: bool): void = __ablaRuntimePlatformMemorySetTrace(on)

fun runtimeMemorySetManualCollection() =
    __ablaRuntimePlatformMemorySetManualCollection()

fun runtimeMemorySetBackgroundFree(enabled: bool) =
    __ablaRuntimePlatformMemorySetBackgroundFree(enabled)

// The collection's threads when the program's environment does not say (ABLA_GC_WORKERS, set to anything, wins: 0 or 1 is the
// serial collector). Only the collection with background freeing uses them.
fun runtimeMemorySetGcWorkers(count: int) =
    __ablaRuntimePlatformMemorySetGcWorkers(count)

fun runtimeMemoryDebugHold(mode: int): int =
    __ablaRuntimePlatformMemoryDebugHold(mode)

fun runtimeMemoryHeapStat(which: int): int =
    __ablaRuntimePlatformMemoryHeapStat(which)

fun runtimeMemoryCollect(): int =
    __ablaRuntimePlatformMemoryCollect()

// Hands the heap's free memory back to the system, as far as the platform can (a no-op where the C library's
// allocator holds it: malloc_trim is the caller's). The program's own objects stay.
fun runtimeMemoryRelease(): void =
    __ablaRuntimePlatformMemoryRelease()

// The census's words (see __ablaRuntimeMemoryCensusWords), read after the
// platform's walk, so the array holding them is not counted.
fun runtimeMemoryCensus(): array<int> {
    __ablaRuntimePlatformMemoryCensusTake()
    val words: array<int> = []
    var index = 0
    while (index < __ablaRuntimeMemoryCensusWords()) {
        words.append(__ablaRuntimePlatformMemoryCensusWord(index))
        index = index + 1
    }
    words
}

// Whether a `region { … }` is active: what is allocated now is freed when it ends,
// so a cache kept beyond the current call must not hold it.
fun runtimeMemoryRegionActive(): bool =
    __ablaRuntimePlatformRegionActive()

trusted fun runtimeMemoryPromoteString(value: string): string {
    var promoted = value
    if (__ablaRuntimePlatformRegionActive()) {
        val length = value.size
        val address = __ablaRuntimeAllocateLayout(length + 1, 1)
        // One bulk copy (a rope is flattened by the address); a byte loop through value[index]
        // cost about 14 instructions a byte.
        if (length > 0) ablaUnsafeCopyMemory(address, ablaUnsafeStringAddress(value), length)
        ablaRuntimeStoreU8(address + length, 0)
        val promotedAddress =
            __ablaRuntimePlatformPromoteAllocation(address)
        promoted = adoptNativeString(promotedAddress, length)
    }
    promoted
}

// Makes the runtime's heap lock live. A thread the runtime did not start (a JIT-compiled program's, calling
// abla/runtime/emutls in the compiler's image) allocates from this heap too; call it while the process has one thread.
fun runtimeMemoryEnableSharing(): void =
    __ablaRuntimePlatformThreadsEnable()

// A copy of a value and everything it reaches, in read-only memory the collector does not trace (docs/design/frozen-heap.md):
// for what is built whole and then only read (the editor's module caches). `Frozen(value).get()` is the copy; a store into
// it faults. A value that is not a heap reference (a number) is returned as it is. Runtime-private for now.
@__abla_runtime_value("__ablaRuntimeFrozenCreate get:__ablaRuntimeFrozenGet")
class Frozen<T: __abla_not_resource>(value: T) {
    fun get(): T
}

// The calling thread runs code this runtime does not manage (a JIT-compiled program, whose runtime is its own, on a
// thread of the compiler's: `ablac run --watch` and `ablac repl` run its main so): a stop for a collection counts it
// as parked until runtimeNativeLeave, so the compiler collects while the program runs.
trusted fun runtimeNativeEnter(): void = __ablaRuntimePlatformNativeEnter()

// Back to this runtime's code from such a thread (a compiler export the program calls): true when it was in native
// code, and then runtimeNativeEnter before returning to the program.
trusted fun runtimeNativeLeave(): bool = __ablaRuntimePlatformNativeLeaveIfIn()
