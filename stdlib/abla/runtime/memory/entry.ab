// Allocation generations implemented by the selected emitted runtime.
// Reset invalidates every heap value allocated after the checkpoint.

noescape extern:"intrinsic" fun ablaRuntimeMemoryCheckpoint(): int

noescape extern:"intrinsic" fun ablaRuntimeMemoryReset(checkpoint: int): void

noescape extern:"intrinsic" fun ablaRuntimeMemoryLiveBytes(): int

noescape extern:"intrinsic" fun ablaRuntimeMemoryLimit(): int

noescape extern:"intrinsic" fun ablaRuntimeMemorySetLimit(limit: int): void

noescape extern:"intrinsic" fun ablaRuntimeMemoryCollect(): int

fun runtimeMemoryCheckpoint(): int = ablaRuntimeMemoryCheckpoint()

fun runtimeMemoryReset(checkpoint: int) = ablaRuntimeMemoryReset(checkpoint)

fun runtimeMemoryLiveBytes(): int = ablaRuntimeMemoryLiveBytes()

fun runtimeMemoryLimit(): int = ablaRuntimeMemoryLimit()

fun runtimeMemorySetLimit(limit: int) = ablaRuntimeMemorySetLimit(limit)

fun runtimeMemoryCollect(): int = ablaRuntimeMemoryCollect()
