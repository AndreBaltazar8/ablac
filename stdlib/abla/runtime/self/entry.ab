// Portable algorithms implemented in Abla and linked into the application's
// LLVM unit. Arithmetic, comparisons, and bit operations deliberately do not
// live here: they are language primitives and the LLVM backend lowers typed
// scalar uses directly to native instructions.

fun __ablaRuntimeTextFindSequence(
    text: string,
    sequence: string,
    begin: int,
    end: int
): int {
    var result = -1
    if (begin >= 0 && end >= begin && end <= text.size) {
        if (sequence.size == 0) result = begin
        var index = begin
        while (result < 0 && sequence.size > 0 &&
            index + sequence.size <= end) {
            var equal = true
            var offset = 0
            while (equal && offset < sequence.size) {
                equal = text[index + offset] == sequence[offset]
                offset = offset + 1
            }
            if (equal) result = index
            index = index + 1
        }
    }
    result
}

fun __ablaRuntimeTextFindByte(
    text: string,
    byte: int,
    begin: int,
    end: int
): int {
    var result = -1
    if (byte >= 0 && byte <= 255 && begin >= 0 && end >= begin &&
        end <= text.size) {
        var index = begin
        while (result < 0 && index < end) {
            if (text[index] == byte) result = index
            index = index + 1
        }
    }
    result
}

fun __ablaRuntimeTextAsciiEqualInsensitive(
    left: string,
    right: string
): bool {
    var equal = left.size == right.size
    var index = 0
    while (equal && index < left.size) {
        var leftByte = left[index]
        var rightByte = right[index]
        if (leftByte >= 65 && leftByte <= 90) leftByte = leftByte + 32
        if (rightByte >= 65 && rightByte <= 90) rightByte = rightByte + 32
        equal = leftByte == rightByte
        index = index + 1
    }
    equal
}

fun __ablaRuntimeTextReadU32LittleEndian(text: string, offset: int): int {
    var result = -1
    if (offset >= 0 && offset + 4 <= text.size) {
        result = text[offset] |
            (text[offset + 1] << 8) |
            (text[offset + 2] << 16) |
            (text[offset + 3] << 24)
    }
    result
}

fun __ablaRuntimeTextIsValidUtf8(text: string): bool {
    var valid = true
    var offset = 0
    while (valid && offset < text.size) {
        val lead = text[offset]
        var count = 0
        if (lead <= 127) count = 1
        if (lead >= 194 && lead <= 223) count = 2
        if (lead >= 224 && lead <= 239) count = 3
        if (lead >= 240 && lead <= 244) count = 4
        valid = count > 0 && offset + count <= text.size
        var index = 1
        while (valid && index < count) {
            val byte = text[offset + index]
            valid = byte >= 128 && byte <= 191
            index = index + 1
        }
        if (valid && count == 3 && lead == 224) {
            valid = text[offset + 1] >= 160
        }
        if (valid && count == 3 && lead == 237) {
            valid = text[offset + 1] <= 159
        }
        if (valid && count == 4 && lead == 240) {
            valid = text[offset + 1] >= 144
        }
        if (valid && count == 4 && lead == 244) {
            valid = text[offset + 1] <= 143
        }
        if (valid) offset = offset + count
    }
    valid
}
