}

trusted fun __ablaRuntimeArraySet(
    value: any,
    indexValue: any,
    element: any
): int {
    __ablaRuntimeCopyValue(
        element,
        __ablaRuntimeArrayValueAddress(value, __ablaRuntimeAsI64(indexValue))
    )
    0
}

trusted fun __ablaRuntimeObjectCreate(typeSymbol: int, count: int): any {
    if (count < 0) ablaRuntimeTrap()
    val object = __ablaRuntimeAllocateLayout(32 + count * 32, 5)
    ablaRuntimeStoreI32(object, typeSymbol)
    ablaRuntimeStoreI64(object + 8, 0)
    ablaRuntimeStoreI64(object + 16, count)
    ablaRuntimeStoreI64(object + 24, if (count == 0) 0 else object + 32)
    ablaRuntimeMakeValue(8, 0, object, 0)
}

trusted fun __ablaRuntimeObjectAddress(value: any): int {
    if (!__ablaRuntimeRequire(value, 8)) 0 else __ablaRuntimeWord0(value)
}

trusted fun __ablaRuntimeFieldAddressScan(
    fields: int,
    count: int,
    symbol: int,
    begin: int
): int {
    var index: int = begin
    while (index < count) {
        val address: int = fields + index * 32
        if (ablaRuntimeLoadI32(address) == symbol) return address
        index = index + 1
    }
    ablaRuntimeTrap()
    0
}

trusted fun __ablaRuntimeFieldAddress(
    value: any,
    symbol: int,
    preferred: int
): int {
    val object: int = __ablaRuntimeObjectAddress(value)
    val count: int = ablaRuntimeLoadI64(object + 8)
    val fields: int = ablaRuntimeLoadI64(object + 24)
    val preferredMatches: bool = preferred >= 0 && preferred < count &&
        ablaRuntimeLoadI32(fields + preferred * 32) == symbol
    if (preferredMatches) fields + preferred * 32
    else __ablaRuntimeFieldAddressScan(fields, count, symbol, 0)
}

trusted fun __ablaRuntimeFieldGet(value: any, symbol: int): any =
    __ablaRuntimeValueAt(__ablaRuntimeFieldAddress(value, symbol, -1) + 8)

trusted fun __ablaRuntimeFieldGetIndexed(
    value: any,
    symbol: int,
    index: int
): any = __ablaRuntimeValueAt(
    __ablaRuntimeFieldAddressIndexed(value, index) + 8
)

// Typed IR supplies the declaration-order index for scalar class fields. Such
// fields cannot move or be added dynamically, so do not rescan their symbols
// and rebuild a universal value on every cursor/count/flag access.
trusted fun __ablaRuntimeFieldAddressIndexed(
    value: any,
    index: int
): int {
    val object = __ablaRuntimeWord0(value)
    if (object == 0 || index < 0) ablaRuntimeTrap()
    ablaRuntimeLoadI64(object + 24) + index * 32
}

trusted fun __ablaRuntimeFieldGetIndexedI64(
    value: any,
    symbol: int,
    index: int
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    if (ablaRuntimeLoadI32(field + 8) != 2) ablaRuntimeTrap()
    ablaRuntimeLoadI64(field + 16)
}

trusted fun __ablaRuntimeFieldGetIndexedBool(
    value: any,
    symbol: int,
    index: int
): bool {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    if (ablaRuntimeLoadI32(field + 8) != 3) ablaRuntimeTrap()
    ablaRuntimeLoadI64(field + 16) != 0
}

trusted fun __ablaRuntimeFieldInitialize(
    value: any,
    symbol: int,
    fieldValue: any
): int {
    val object = __ablaRuntimeObjectAddress(value)
    val count = ablaRuntimeLoadI64(object + 8)
    val capacity = ablaRuntimeLoadI64(object + 16)
    if (count >= capacity) ablaRuntimeTrap()
    val field = ablaRuntimeLoadI64(object + 24) + count * 32
    ablaRuntimeStoreI32(field, symbol)
    __ablaRuntimeCopyValue(fieldValue, field + 8)
    ablaRuntimeStoreI64(object + 8, count + 1)
    0
}

trusted fun __ablaRuntimeFieldSet(
    value: any,
    symbol: int,
    fieldValue: any
): int {
    val object = __ablaRuntimeObjectAddress(value)
    val count = ablaRuntimeLoadI64(object + 8)
    var capacity: int = ablaRuntimeLoadI64(object + 16)
    var fields: int = ablaRuntimeLoadI64(object + 24)
    var field: int = 0
    var index: int = 0
    while (field == 0 && index < count) {
        if (ablaRuntimeLoadI32(fields + index * 32) == symbol) {
            field = fields + index * 32
        }
        index = index + 1
    }
    if (field == 0) {
        if (count == capacity) {
            val next = if (capacity == 0) 4 else capacity * 2
            val replacement = __ablaRuntimeAllocateLayout(next * 32, 3)
            index = 0
            while (index < count) {
                var word: int = 0
                while (word < 4) {
                    ablaRuntimeStoreI64(
                        replacement + index * 32 + word * 8,
                        ablaRuntimeLoadI64(fields + index * 32 + word * 8)
                    )
                    word = word + 1
                }
                index = index + 1
            }
            if (fields != 0 && fields != object + 32) {
                __ablaRuntimeFree(fields)
            }
            fields = replacement
            capacity = next
            ablaRuntimeStoreI64(object + 16, capacity)
            ablaRuntimeStoreI64(object + 24, fields)
        }
        field = fields + count * 32
        ablaRuntimeStoreI32(field, symbol)
        ablaRuntimeStoreI64(object + 8, count + 1)
    }
    __ablaRuntimeCopyValue(fieldValue, field + 8)
    0
}

trusted fun __ablaRuntimeFieldSetIndexed(
    value: any,
    symbol: int,
    index: int,
    fieldValue: any
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    __ablaRuntimeCopyValue(fieldValue, field + 8)
    0
}

trusted fun __ablaRuntimeFieldSetIndexedI64(
    value: any,
    symbol: int,
    index: int,
    fieldValue: int
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    ablaRuntimeStoreI32(field + 8, 2)
    ablaRuntimeStoreI32(field + 12, 0)
    ablaRuntimeStoreI64(field + 16, fieldValue)
    ablaRuntimeStoreI64(field + 24, 0)
    0
}

trusted fun __ablaRuntimeFieldSetIndexedBool(
    value: any,
    symbol: int,
    index: int,
    fieldValue: bool
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    ablaRuntimeStoreI32(field + 8, 3)
    ablaRuntimeStoreI32(field + 12, 0)
    ablaRuntimeStoreI64(field + 16, if (fieldValue) 1 else 0)
    ablaRuntimeStoreI64(field + 24, 0)
    0
}

trusted fun __ablaRuntimeJsonStringIsPlain(value: string): bool {
    val size = __ablaRuntimeStringLengthValue(value)
    val data = if (size == 0) 0 else __ablaRuntimeStringData(value)
    var offset = 0
    var plain = true
    while (plain && offset < size) {
        val lead = ablaRuntimeLoadU8(data + offset)
        if (lead == 34 || lead == 92 || lead < 32) plain = false
        else if (lead < 128) offset = offset + 1
        else {
            var count = 0
            if (lead >= 194 && lead <= 223) count = 2
            if (lead >= 224 && lead <= 239) count = 3
            if (lead >= 240 && lead <= 244) count = 4
            plain = count > 0 && offset + count <= size
            var index = 1
            while (plain && index < count) {
                val byte = ablaRuntimeLoadU8(data + offset + index)
                plain = byte >= 128 && byte <= 191
                index = index + 1
            }
            if (plain && count == 3 && lead == 224) {
                plain = ablaRuntimeLoadU8(data + offset + 1) >= 160
            }
            if (plain && count == 3 && lead == 237) {
                plain = ablaRuntimeLoadU8(data + offset + 1) <= 159
            }
            if (plain && count == 4 && lead == 240) {
                plain = ablaRuntimeLoadU8(data + offset + 1) >= 144
            }
            if (plain && count == 4 && lead == 244) {
                plain = ablaRuntimeLoadU8(data + offset + 1) <= 143
            }
            if (plain) offset = offset + count
        }
    }
    plain
}

trusted fun __ablaRuntimeJsonFindPlainStringEnd(
    value: string,
    begin: int,
    end: int
): int {
    val size = __ablaRuntimeStringLengthValue(value)
    if (begin < 0 || end < begin || end > size) return -1
    val data = if (size == 0) 0 else __ablaRuntimeStringData(value)
    var offset = begin
    var found = -1
    var plain = true
    while (plain && found < 0 && offset < end) {
        val lead = ablaRuntimeLoadU8(data + offset)
        if (lead == 34) found = offset
        else if (lead == 92 || lead < 32) plain = false
        else if (lead < 128) offset = offset + 1
        else {
            var count = 0
            if (lead >= 194 && lead <= 223) count = 2
            if (lead >= 224 && lead <= 239) count = 3
            if (lead >= 240 && lead <= 244) count = 4
            plain = count > 0 && offset + count <= end
            var index = 1
            while (plain && index < count) {
                val byte = ablaRuntimeLoadU8(data + offset + index)
