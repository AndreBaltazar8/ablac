        // reader (CopyString, WriteVectors) loads +40 before the children,
        // and once threads run loads it again after them: publish the copy's
        // bytes, then +40, then clear, each across a fence. Two threads may
        // flatten one node at once; each copy is whole, and the later store
        // wins.
        val threads = __ablaRuntimePlatformThreadsEnabled()
        if (threads) ablaRuntimeFence()
        ablaRuntimeStoreI64(rope + 40, allocated)
        if (threads) ablaRuntimeFence()
