            // LIFO: push right first so left is flattened first.
            ablaRuntimeStoreI64(
                stack + count * 16,
                ablaRuntimeLoadI64(storage + 24)
            )
            ablaRuntimeStoreI64(
                stack + count * 16 + 8,
                ablaRuntimeLoadI64(storage + 32)
            )
            count = count + 1
            ablaRuntimeStoreI64(
                stack + count * 16,
                ablaRuntimeLoadI64(storage + 8)
            )
            ablaRuntimeStoreI64(
                stack + count * 16 + 8,
                ablaRuntimeLoadI64(storage + 16)
            )
            count = count + 1
