// Portable runtime semantics implemented in Abla and compiled into the same
// LLVM unit as the application. Typed scalar expressions lower through the
// compiler's normal scalar path; the functions below handle boxed/dynamic
// values at the universal-value ABI boundary.

// These are the irreducible value-layout and raw-memory operations used by
// the runtime below. They are the temporary boundary until Abla has an
// unboxed tagged-union/record representation. Collection, strings, arrays,
// objects, arithmetic, comparisons, and ownership policy are ordinary Abla.

import "abla/runtime/scalar"

trusted noescape extern:"intrinsic" fun ablaRuntimeStoreI32(
    address: int,
    value: int
): void
trusted noescape extern:"intrinsic" fun ablaRuntimeStoreI64(
    address: int,
    value: int
): void
trusted noescape extern:"intrinsic" fun ablaRuntimeLoadU8(address: int): int
// A declared field's slot, read and written only by the typed field accessors
// below (and through them only). The backend tags the access inside each of
// these as a field slot's, which no abla/unsafe load or store reaches
// (bootstrapLlvmTagAccess), so a column's raw stores don't make LLVM reload
// the fields it read. They stay functions, not intrinsics, so a compiler that
// doesn't know them still builds this runtime.
@inline
trusted fun ablaRuntimeLoadSlotI32(address: int): int = ablaRuntimeLoadI32(address)

@inline
trusted fun ablaRuntimeLoadSlotI64(address: int): int = ablaRuntimeLoadI64(address)

@inline
trusted fun ablaRuntimeStoreSlotI32(address: int, value: int): void =
    ablaRuntimeStoreI32(address, value)

@inline
trusted fun ablaRuntimeStoreSlotI64(address: int, value: int): void =
    ablaRuntimeStoreI64(address, value)
// A sequentially consistent fence (orders a rope's flat copy with its children
// across threads).
trusted noescape extern:"intrinsic" fun ablaRuntimeFence(): void
// The transactional memory's atomics on 64-bit words: an acquire load, a release
// store, and a sequentially consistent compare-and-swap (returning the word seen)
// and fetch-add (returning the word before); acquire and release fences.
trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicLoadI64(address: int): int
trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicStoreI64(
    address: int,
    value: int
): void
trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicCompareExchangeI64(
    address: int,
    expected: int,
    replacement: int
): int
trusted noescape extern:"intrinsic" fun ablaRuntimeAtomicFetchAddI64(
    address: int,
    delta: int
): int
trusted noescape extern:"intrinsic" fun ablaRuntimeFenceAcquire(): void
trusted noescape extern:"intrinsic" fun ablaRuntimeFenceRelease(): void
trusted noescape extern:"intrinsic" fun ablaRuntimeStoreU8(
    address: int,
    value: int
): void
trusted noescape extern:"intrinsic" fun ablaRuntimePointerAddress(
    pointer: i64*
): int
trusted noescape extern:"intrinsic" fun ablaRuntimePointerFromAddress(
    address: int
): i64*
@inline
trusted fun __ablaRuntimeAllocate(size: int): int =
    __ablaRuntimePlatformAllocate(size)

@inline
trusted fun __ablaRuntimeAllocateLayout(size: int, layout: int): int =
    __ablaRuntimePlatformAllocateLayout(size, layout)

trusted fun __ablaRuntimeFree(address: int): void =
    __ablaRuntimePlatformFree(address)

// These dispatchers are generated in the same LLVM module. Declaring their C
// ABI here lets ordinary Abla runtime code invoke a closure without embedding
// closure semantics in the backend or a C runtime.
trusted noescape extern:"c" fun abla_llvm_call_indirect(
    output: i64*,
    closure: i64*,
    arguments: i64*,
    count: int
): void
trusted noescape extern:"c" fun abla_llvm_release_closure(
    closure: i64*
): void
// Calls `dispatch`, a dispatcher of abla_llvm_call_indirect's signature (a
// generator's own step entry), with the rest.
trusted noescape extern:"c" fun abla_llvm_call_dispatch(
    dispatch: i64*,
    output: i64*,
    closure: i64*,
    arguments: i64*,
    count: int
): void
trusted noescape extern:"c" fun abla_llvm_drop_closure(
    closure: i64*
): void

@inline
trusted fun __ablaRuntimeValueAt(address: int): any =
    ablaRuntimeMakeValue(
        ablaRuntimeLoadI32(address),
        ablaRuntimeLoadI32(address + 4),
        ablaRuntimeLoadI64(address + 8),
        ablaRuntimeLoadI64(address + 16)
    )

trusted fun __ablaRuntimeCopyValue(value: any, destination: int): void {
    val source = ablaRuntimeValueAddress(value)
    ablaRuntimeStoreI64(destination, ablaRuntimeLoadI64(source))
    ablaRuntimeStoreI64(destination + 8, ablaRuntimeLoadI64(source + 8))
    ablaRuntimeStoreI64(destination + 16, ablaRuntimeLoadI64(source + 16))
}



@inline
trusted fun __ablaRuntimeWord1(value: any): int =
    ablaRuntimeLoadI64(ablaRuntimeValueAddress(value) + 16)

@inline
trusted fun __ablaRuntimeAuxiliary(value: any): int =
    ablaRuntimeLoadI32(ablaRuntimeValueAddress(value) + 4)


@inline
trusted fun __ablaRuntimeStringStatic(data: int, length: int): any {
    if (data == 0 && length != 0) ablaRuntimeTrap()
    ablaRuntimeMakeValue(4, 0, data, length)
}



trusted fun __ablaRuntimeFunction(function: int): any =
    ablaRuntimeMakeValue(5, function, 0, 0)

trusted fun __ablaRuntimeClosure(
    function: int,
    captures: int,
    count: int
): any {
    if (count < 0) ablaRuntimeTrap()
    var owned: int = 0
    if (count > 0) {
        owned = __ablaRuntimeAllocateLayout(count * 24, 2)
        var index: int = 0
        while (index < count) {
            val source = captures + index * 24
            val destination = owned + index * 24
            ablaRuntimeStoreI64(destination, ablaRuntimeLoadI64(source))
            ablaRuntimeStoreI64(
                destination + 8, ablaRuntimeLoadI64(source + 8)
            )
            ablaRuntimeStoreI64(
                destination + 16, ablaRuntimeLoadI64(source + 16)
            )
            index = index + 1
        }
    }
    ablaRuntimeMakeValue(5, function, count, owned)
}

trusted fun __ablaRuntimeAsFunction(value: any): int {
    if (!__ablaRuntimeRequire(value, 5)) 0
    else __ablaRuntimeAuxiliary(value)
}

// A function value's id: the function it calls, as the compiler numbers
// functions (0 for a value that isn't a function). Unlike the value's words it
// exposes no memory, so any code may call it.
trusted fun ablaRuntimeFunctionId(value: any): int =
    if (__ablaRuntimeTag(value) == 5) __ablaRuntimeAuxiliary(value) else 0

trusted fun __ablaRuntimeFunctionCaptureCount(value: any): int {
    if (!__ablaRuntimeRequire(value, 5)) 0
    else __ablaRuntimeWord0(value)
}

trusted fun __ablaRuntimeFunctionCapturePointer(value: any): int {
    if (!__ablaRuntimeRequire(value, 5)) 0
    else __ablaRuntimeWord1(value)
}

trusted fun __ablaRuntimeFunctionCapture(value: any, index: int): any {
    val count = __ablaRuntimeFunctionCaptureCount(value)
    if (index < 0 || index >= count) {
        ablaRuntimeTrap()
        __ablaRuntimeNull()
    } else __ablaRuntimeValueAt(
        __ablaRuntimeFunctionCapturePointer(value) + index * 24
    )
}

// A closure that does not escape its frame keeps its captures there, after a header
// whose last word, the one before them, is -1 (the backend's frame closures); a
// heap block has its layout in that word. Only the heap's are freed.
trusted fun __ablaRuntimeClosureRelease(value: any): int {
    val captures = __ablaRuntimeFunctionCapturePointer(value)
    if (captures != 0 && ablaRuntimeLoadI64(captures - 8) != -1) {
        __ablaRuntimeFree(captures)
    }
    0
}

trusted fun __ablaRuntimeCellCreate(value: any): any {
    val cell = __ablaRuntimeAllocateLayout(24, 2)
    __ablaRuntimeCopyValue(value, cell)
    ablaRuntimeMakeValue(6, 0, cell, 0)
}

trusted fun __ablaRuntimeCellAddress(value: any): int {
    if (!__ablaRuntimeRequire(value, 6)) 0
    else __ablaRuntimeWord0(value)
}

trusted fun __ablaRuntimeCellGet(value: any): any =
    __ablaRuntimeValueAt(__ablaRuntimeCellAddress(value))

trusted fun __ablaRuntimeCellSet(cell: any, value: any): any {
    __ablaRuntimeCopyValue(value, __ablaRuntimeCellAddress(cell))
    value
}

// Map<K, V> (K string or int) is an ordinary array the collector already
// traces: [keys, values, slots, live count]. Entries keep insertion order in
// keys/values; a removed entry's key becomes null. `slots` (dense ints, a
// power of two, at most half used) holds entry index + 1 per occupied slot,
// found by linear probing from the key's hash.
@inline
trusted fun __ablaRuntimeMapPart(map: any, part: int): any =
    __ablaRuntimeArrayGet(map, __ablaRuntimeI64(part))

trusted fun __ablaRuntimeMapEmpty(capacity: int): any {
    val map = __ablaRuntimeArrayFilled(__ablaRuntimeI64(4), __ablaRuntimeNull())
    __ablaRuntimeArraySet(map, __ablaRuntimeI64(0),
        __ablaRuntimeArrayFilled(__ablaRuntimeI64(0), __ablaRuntimeNull()))
    __ablaRuntimeArraySet(map, __ablaRuntimeI64(1),
        __ablaRuntimeArrayFilled(__ablaRuntimeI64(0), __ablaRuntimeNull()))
    __ablaRuntimeArraySet(map, __ablaRuntimeI64(2),
        __ablaRuntimeArrayFilled(__ablaRuntimeI64(capacity), __ablaRuntimeI64(0)))
    __ablaRuntimeArraySet(map, __ablaRuntimeI64(3), __ablaRuntimeI64(0))
    map
}

trusted fun __ablaRuntimeMapCreate(): any = __ablaRuntimeMapEmpty(8)

// FNV-1a over a string's bytes; an int (or bool) through splitmix64's
// finalizer.
trusted fun __ablaRuntimeMapHash(key: any): int {
    var hash = 0
    if (__ablaRuntimeTag(key) == 4) {
        hash = -3750763034362895579
        val data = __ablaRuntimeStringData(key)
        val length = __ablaRuntimeStringLengthValue(key)
        var index = 0
        while (index < length) {
            hash = (hash ^ ablaRuntimeLoadU8(data + index)) * 1099511628211
            index = index + 1
        }
    } else {
        hash = __ablaRuntimeWord0(key)
        hash = (hash ^ (hash >>> 30)) * -4658895280553007687
        hash = (hash ^ (hash >>> 27)) * -7723592293110705685
        hash = hash ^ (hash >>> 31)
    }
    hash
}

trusted fun __ablaRuntimeMapKeyEqual(left: any, right: any): bool {
    val tag = __ablaRuntimeTag(left)
    if (tag != __ablaRuntimeTag(right)) false
    else if (tag == 4) __ablaRuntimeStringEqualBool(left, right)
    else __ablaRuntimeWord0(left) == __ablaRuntimeWord0(right)
}

// The entry index of `key`, or -1.
trusted fun __ablaRuntimeMapEntry(map: any, key: any): int {
    val keys = __ablaRuntimeMapPart(map, 0)
    val slots = __ablaRuntimeMapPart(map, 2)
    val mask = __ablaRuntimeArrayLengthI64(slots) - 1
    var slot = __ablaRuntimeMapHash(key) & mask
    var found = -1
    var probing = true
    while (probing) {
        val entry = __ablaRuntimeArrayGetI64(slots, slot)
        if (entry == 0) probing = false
        else if (__ablaRuntimeMapKeyEqual(
            __ablaRuntimeArrayGet(keys, __ablaRuntimeI64(entry - 1)), key
        )) {
            found = entry - 1
            probing = false
        } else slot = (slot + 1) & mask
    }
    found
}

// Points the first free slot for `key` at entry `entry`.
trusted fun __ablaRuntimeMapPlace(slots: any, key: any, entry: int): int {
    val mask = __ablaRuntimeArrayLengthI64(slots) - 1
    var slot = __ablaRuntimeMapHash(key) & mask
    while (__ablaRuntimeArrayGetI64(slots, slot) != 0) slot = (slot + 1) & mask
    __ablaRuntimeArraySet(slots, __ablaRuntimeI64(slot), __ablaRuntimeI64(entry + 1))
}

// Rebuilds the map from its live entries with room for `extra` more.
trusted fun __ablaRuntimeMapRehash(map: any, extra: int): int {
    val keys = __ablaRuntimeMapPart(map, 0)
    val values = __ablaRuntimeMapPart(map, 1)
    val live = __ablaRuntimeAsI64(__ablaRuntimeMapPart(map, 3))
    var capacity = 8
    while (capacity < (live + extra) * 2 + 2) capacity = capacity * 2
    val rebuilt = __ablaRuntimeMapEmpty(capacity)
    val liveKeys = __ablaRuntimeMapPart(rebuilt, 0)
    val liveValues = __ablaRuntimeMapPart(rebuilt, 1)
    val slots = __ablaRuntimeMapPart(rebuilt, 2)
    val count = __ablaRuntimeArrayLengthI64(keys)
    var index = 0
    var kept = 0
    while (index < count) {
        val key = __ablaRuntimeArrayGet(keys, __ablaRuntimeI64(index))
        if (__ablaRuntimeTag(key) != 1) {
            __ablaRuntimeArrayAppend(liveKeys, key)
            __ablaRuntimeArrayAppend(
                liveValues, __ablaRuntimeArrayGet(values, __ablaRuntimeI64(index))
            )
            __ablaRuntimeMapPlace(slots, key, kept)
            kept = kept + 1
        }
        index = index + 1
    }
    __ablaRuntimeArraySet(map, __ablaRuntimeI64(0), liveKeys)
    __ablaRuntimeArraySet(map, __ablaRuntimeI64(1), liveValues)
    __ablaRuntimeArraySet(map, __ablaRuntimeI64(2), slots)
}

trusted fun __ablaRuntimeMapGet(map: any, key: any): any {
    val entry = __ablaRuntimeMapEntry(map, key)
    if (entry < 0) __ablaRuntimeNull()
    else __ablaRuntimeArrayGet(__ablaRuntimeMapPart(map, 1), __ablaRuntimeI64(entry))
}

trusted fun __ablaRuntimeMapHas(map: any, key: any): any =
    __ablaRuntimeBool(__ablaRuntimeMapEntry(map, key) >= 0)

trusted fun __ablaRuntimeMapSet(map: any, key: any, value: any): any {
    val entry = __ablaRuntimeMapEntry(map, key)
    if (entry >= 0) {
        __ablaRuntimeArraySet(
            __ablaRuntimeMapPart(map, 1), __ablaRuntimeI64(entry), value
        )
    } else {
        val used = __ablaRuntimeArrayLengthI64(__ablaRuntimeMapPart(map, 0))
        val capacity = __ablaRuntimeArrayLengthI64(__ablaRuntimeMapPart(map, 2))
        if ((used + 1) * 2 > capacity) __ablaRuntimeMapRehash(map, 1)
        val keys = __ablaRuntimeMapPart(map, 0)
        val added = __ablaRuntimeArrayLengthI64(keys)
        __ablaRuntimeArrayAppend(keys, key)
        __ablaRuntimeArrayAppend(__ablaRuntimeMapPart(map, 1), value)
        __ablaRuntimeMapPlace(__ablaRuntimeMapPart(map, 2), key, added)
        __ablaRuntimeArraySet(map, __ablaRuntimeI64(3), __ablaRuntimeI64(
            __ablaRuntimeAsI64(__ablaRuntimeMapPart(map, 3)) + 1
        ))
    }
    __ablaRuntimeVoid()
}

trusted fun __ablaRuntimeMapRemove(map: any, key: any): any {
    val entry = __ablaRuntimeMapEntry(map, key)
    if (entry >= 0) {
        __ablaRuntimeArraySet(
            __ablaRuntimeMapPart(map, 0), __ablaRuntimeI64(entry), __ablaRuntimeNull()
        )
        __ablaRuntimeArraySet(
            __ablaRuntimeMapPart(map, 1), __ablaRuntimeI64(entry), __ablaRuntimeNull()
        )
        __ablaRuntimeArraySet(map, __ablaRuntimeI64(3), __ablaRuntimeI64(
            __ablaRuntimeAsI64(__ablaRuntimeMapPart(map, 3)) - 1
        ))
    }
    __ablaRuntimeBool(entry >= 0)
}

// Removes `key`'s entry and returns its value (null when there is none).
trusted fun __ablaRuntimeMapTake(map: any, key: any): any {
    val entry = __ablaRuntimeMapEntry(map, key)
    if (entry < 0) return __ablaRuntimeNull()
    val value = __ablaRuntimeArrayGet(__ablaRuntimeMapPart(map, 1), __ablaRuntimeI64(entry))
    __ablaRuntimeMapRemove(map, key)
    value
}

trusted fun __ablaRuntimeMapSize(map: any): any = __ablaRuntimeMapPart(map, 3)

// The live keys (part 0) or values (part 1), in insertion order.
trusted fun __ablaRuntimeMapEntries(map: any, part: int): any {
    val keys = __ablaRuntimeMapPart(map, 0)
    val source = __ablaRuntimeMapPart(map, part)
    val result = __ablaRuntimeArrayFilled(__ablaRuntimeI64(0), __ablaRuntimeNull())
    val count = __ablaRuntimeArrayLengthI64(keys)
    var index = 0
    while (index < count) {
        if (__ablaRuntimeTag(__ablaRuntimeArrayGet(keys, __ablaRuntimeI64(index))) != 1) {
            __ablaRuntimeArrayAppend(
                result, __ablaRuntimeArrayGet(source, __ablaRuntimeI64(index))
            )
        }
        index = index + 1
    }
    result
}

trusted fun __ablaRuntimeMapKeys(map: any): any = __ablaRuntimeMapEntries(map, 0)

trusted fun __ablaRuntimeMapValues(map: any): any = __ablaRuntimeMapEntries(map, 1)

trusted fun __ablaRuntimeMapClear(map: any): any {
    val empty = __ablaRuntimeMapEmpty(8)
    var part = 0
    while (part < 4) {
        __ablaRuntimeArraySet(
            map, __ablaRuntimeI64(part), __ablaRuntimeMapPart(empty, part)
        )
        part = part + 1
    }
    __ablaRuntimeVoid()
}

// Shared/Weak control blocks are ordinary Abla-owned memory. Two platform
// mutexes keep reference counts and user mutation independent: the platform
// supplies scheduling primitives, while ownership semantics remain here.
// Shared/Weak/Mutex control block: strong count (0), weak count (8), payload
// value (16..40), count mutex (48), payload mutex (48 + one mutex slot). The
// slots were a fixed 40 bytes, Linux's pthread_mutex_t; Darwin's is 64, so the
// two mutexes overlapped and the second ran past the block. Functions, not
// globals: runtime code can run before global initialization.
@inline
trusted fun __ablaRuntimeSharedPayloadMutex(): int =
    48 + __ablaRuntimePlatformMutexBytes()

@inline
trusted fun __ablaRuntimeSharedControlBytes(): int =
    48 + 2 * __ablaRuntimePlatformMutexBytes()

trusted fun __ablaRuntimeSharedControl(value: any, tag: int): int {
    if (!__ablaRuntimeRequire(value, tag)) 0
    else __ablaRuntimeWord0(value)
}

trusted fun __ablaRuntimeSharedCountLock(control: int): void =
    __ablaRuntimePlatformMutexLock(control + 48)

trusted fun __ablaRuntimeSharedCountUnlock(control: int): void =
    __ablaRuntimePlatformMutexUnlock(control + 48)

trusted fun __ablaRuntimeSharedCreate(value: any): any {
    val control = __ablaRuntimeAllocateLayout(__ablaRuntimeSharedControlBytes(), 7)
    ablaRuntimeStoreI64(control, 1)
    ablaRuntimeStoreI64(control + 8, 1)
    __ablaRuntimeCopyValue(value, control + 16)
    __ablaRuntimePlatformMutexInitialize(control + 48)
    __ablaRuntimePlatformMutexInitialize(control + __ablaRuntimeSharedPayloadMutex())
    ablaRuntimeMakeValue(9, 0, control, 0)
}

trusted fun __ablaRuntimeSharedClone(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 9)
    __ablaRuntimeSharedCountLock(control)
    val strong = ablaRuntimeLoadI64(control)
    if (strong <= 0 || strong == 9223372036854775807) ablaRuntimeTrap()
    ablaRuntimeStoreI64(control, strong + 1)
    __ablaRuntimeSharedCountUnlock(control)
    value
}

trusted fun __ablaRuntimeSharedGet(value: any): any =
    __ablaRuntimeValueAt(__ablaRuntimeSharedControl(value, 9) + 16)

trusted fun __ablaRuntimeSharedLock(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 9)
    __ablaRuntimePlatformMutexLock(control + __ablaRuntimeSharedPayloadMutex())
    __ablaRuntimeValueAt(control + 16)
}

trusted fun __ablaRuntimeSharedUnlock(value: any): int {
    __ablaRuntimePlatformMutexUnlock(__ablaRuntimeWord0(value) + __ablaRuntimeSharedPayloadMutex())
    0
}

trusted fun __ablaRuntimeSharedRelease(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 9)
    __ablaRuntimeSharedCountLock(control)
    val strong = ablaRuntimeLoadI64(control)
    if (strong <= 0) ablaRuntimeTrap()
    ablaRuntimeStoreI64(control, strong - 1)
    var released = __ablaRuntimeNull()
    var freeControl = false
    if (strong == 1) {
        released = __ablaRuntimeValueAt(control + 16)
        __ablaRuntimeCopyValue(__ablaRuntimeNull(), control + 16)
        val weak = ablaRuntimeLoadI64(control + 8) - 1
        ablaRuntimeStoreI64(control + 8, weak)
        freeControl = weak == 0
    }
    __ablaRuntimeSharedCountUnlock(control)
    if (freeControl) {
        __ablaRuntimePlatformMutexDestroy(control + 48)
        __ablaRuntimePlatformMutexDestroy(control + __ablaRuntimeSharedPayloadMutex())
        __ablaRuntimeFree(control)
    }
    released
}

trusted fun __ablaRuntimeWeakCreate(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 9)
    __ablaRuntimeSharedCountLock(control)
    val weak = ablaRuntimeLoadI64(control + 8)
    if (weak == 9223372036854775807) ablaRuntimeTrap()
    ablaRuntimeStoreI64(control + 8, weak + 1)
    __ablaRuntimeSharedCountUnlock(control)
    ablaRuntimeMakeValue(10, 0, control, 0)
}

trusted fun __ablaRuntimeWeakClone(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 10)
    __ablaRuntimeSharedCountLock(control)
    val weak = ablaRuntimeLoadI64(control + 8)
    if (weak <= 0 || weak == 9223372036854775807) ablaRuntimeTrap()
    ablaRuntimeStoreI64(control + 8, weak + 1)
    __ablaRuntimeSharedCountUnlock(control)
    value
}

trusted fun __ablaRuntimeWeakUpgrade(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 10)
    __ablaRuntimeSharedCountLock(control)
    val strong = ablaRuntimeLoadI64(control)
    var result = __ablaRuntimeNull()
    if (strong > 0) {
        if (strong == 9223372036854775807) ablaRuntimeTrap()
        ablaRuntimeStoreI64(control, strong + 1)
        result = ablaRuntimeMakeValue(9, 0, control, 0)
    }
    __ablaRuntimeSharedCountUnlock(control)
    result
}

trusted fun __ablaRuntimeWeakAlive(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 10)
    __ablaRuntimeSharedCountLock(control)
    val alive = ablaRuntimeLoadI64(control) > 0
    __ablaRuntimeSharedCountUnlock(control)
    __ablaRuntimeBool(alive)
}

trusted fun __ablaRuntimeWeakRelease(value: any): any {
    val control = __ablaRuntimeSharedControl(value, 10)
    __ablaRuntimeSharedCountLock(control)
    val weak = ablaRuntimeLoadI64(control + 8)
    if (weak <= 0) ablaRuntimeTrap()
    ablaRuntimeStoreI64(control + 8, weak - 1)
    val freeControl = weak == 1
    __ablaRuntimeSharedCountUnlock(control)
    if (freeControl) {
        __ablaRuntimePlatformMutexDestroy(control + 48)
        __ablaRuntimePlatformMutexDestroy(control + __ablaRuntimeSharedPayloadMutex())
        __ablaRuntimeFree(control)
    }
    __ablaRuntimeNull()
}

var __ablaRuntimeCurrentGenerator: int = 0

trusted fun __ablaRuntimeDispatchClosure(
    closure: int,
    output: int
): void = abla_llvm_call_indirect(
    ablaRuntimePointerFromAddress(output),
    ablaRuntimePointerFromAddress(closure),
    ablaRuntimePointerFromAddress(0),
    0
)

trusted fun __ablaRuntimeReleaseClosure(closure: int): void =
    abla_llvm_release_closure(ablaRuntimePointerFromAddress(closure))

trusted fun __ablaRuntimeDropClosure(closure: int): void =
    abla_llvm_drop_closure(ablaRuntimePointerFromAddress(closure))

// A generator's control block (four value slots, two words): its step
// function, the value it last yielded, the step's argument and result, then
// its status (0 suspended, 1 finished, 2 running) and the dispatcher that runs
// its step, in words the collector skips.
// The step function runs to the next `yield` (true) or the end (false);
// given true it closes the generator instead, running pending defers and
// dropping what the generator holds.
trusted fun __ablaRuntimeGeneratorCreate(
    closure: any,
    dispatch: int,
    release: int,
    drop: int
): any {
    val control = __ablaRuntimeAllocateLayout(112, 2)
    __ablaRuntimeCopyValue(closure, control)
    __ablaRuntimeCopyValue(__ablaRuntimeNull(), control + 24)
    __ablaRuntimeCopyValue(__ablaRuntimeNull(), control + 48)
    __ablaRuntimeCopyValue(__ablaRuntimeNull(), control + 72)
    ablaRuntimeStoreI64(control + 96, 0)
    ablaRuntimeStoreI64(control + 104, dispatch)
    ablaRuntimeMakeValue(11, 0, control, 0)
}

trusted fun __ablaRuntimeGeneratorStep(control: int, closing: bool): bool {
    // A generator's body may iterate another generator: each step runs with
    // its own generator current, so a `yield` reaches the right one.
    val outer = __ablaRuntimeCurrentGenerator
    __ablaRuntimeCurrentGenerator = control
    ablaRuntimeStoreI64(control + 96, 2)
    __ablaRuntimeCopyValue(__ablaRuntimeBool(closing), control + 48)
    abla_llvm_call_dispatch(
        ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(control + 104)),
        ablaRuntimePointerFromAddress(control + 72),
        ablaRuntimePointerFromAddress(control),
        ablaRuntimePointerFromAddress(control + 48),
        1
    )
    __ablaRuntimeCurrentGenerator = outer
    val more = __ablaRuntimeAsBool(__ablaRuntimeValueAt(control + 72))
    if (more) ablaRuntimeStoreI64(control + 96, 0)
    else {
        ablaRuntimeStoreI64(control + 96, 1)
        __ablaRuntimeReleaseClosure(control)
        __ablaRuntimeCopyValue(__ablaRuntimeNull(), control)
        __ablaRuntimeCopyValue(__ablaRuntimeNull(), control + 24)
    }
    more
}

trusted fun __ablaRuntimeGeneratorNext(handle: any): any {
    val control = __ablaRuntimeSharedControl(handle, 11)
    val status = ablaRuntimeLoadI64(control + 96)
    // Iterating a generator from inside its own body.
    if (status == 2) ablaRuntimeTrap()
    __ablaRuntimeBool(status == 0 && __ablaRuntimeGeneratorStep(control, false))
}

trusted fun __ablaRuntimeGeneratorValue(handle: any): any {
    val control = __ablaRuntimeSharedControl(handle, 11)
    __ablaRuntimeValueAt(control + 24)
}

trusted fun __ablaRuntimeGeneratorYield(value: any): any {
    val control = __ablaRuntimeCurrentGenerator
    if (control == 0) ablaRuntimeTrap()
    __ablaRuntimeCopyValue(value, control + 24)
    __ablaRuntimeBool(true)
}

trusted fun __ablaRuntimeGeneratorDrop(handle: any): any {
    val control = __ablaRuntimeSharedControl(handle, 11)
    val status = ablaRuntimeLoadI64(control + 96)
    if (status == 2) ablaRuntimeTrap()
    if (status == 0) __ablaRuntimeGeneratorStep(control, true)
    __ablaRuntimeFree(control)
    __ablaRuntimeVoid()
}

trusted fun __ablaRuntimeTaskCreate(
    closure: any,
    dispatch: int,
    release: int,
    drop: int
): any {
    val control = __ablaRuntimeAllocateLayout(48, 2)
    __ablaRuntimeCopyValue(closure, control)
    __ablaRuntimeCopyValue(__ablaRuntimeVoid(), control + 24)
    ablaRuntimeMakeValue(12, 0, control, 0)
}

trusted fun __ablaRuntimeTaskDrop(handle: any): any {
    val control = __ablaRuntimeSharedControl(handle, 12)
    __ablaRuntimeDropClosure(control)
    __ablaRuntimeFree(control)
    __ablaRuntimeVoid()
}

trusted fun __ablaRuntimeThreadEntry(control: int): int {
    __ablaRuntimeDispatchClosure(control, control + 24)
    __ablaRuntimeReleaseClosure(control)
    __ablaRuntimeCopyValue(__ablaRuntimeNull(), control)
    __ablaRuntimeStmThreadExit()
    0
}

trusted fun __ablaRuntimeThreadCreate(
    closure: any,
    dispatch: int,
    release: int,
    drop: int,
    entry: int
): any {
    __ablaRuntimePlatformThreadsEnable()
    val control = __ablaRuntimeAllocateLayout(88, 11)
    __ablaRuntimeCopyValue(closure, control)
    __ablaRuntimeCopyValue(__ablaRuntimeVoid(), control + 24)
    ablaRuntimeStoreI64(control + 48, dispatch)
    ablaRuntimeStoreI64(control + 56, release)
    ablaRuntimeStoreI64(control + 64, drop)
    ablaRuntimeStoreI64(control + 72, 0)
    ablaRuntimeStoreI64(control + 80, 0)
    if (!__ablaRuntimePlatformThreadCreate(
        control + 72, entry, control
    )) ablaRuntimeTrap()
    ablaRuntimeMakeValue(13, 0, control, 0)
}

trusted fun __ablaRuntimeThreadJoin(control: int): void {
    if (ablaRuntimeLoadI64(control + 80) == 0) {
        if (!__ablaRuntimePlatformThreadJoin(control + 72)) {
            ablaRuntimeTrap()
        }
        ablaRuntimeStoreI64(control + 80, 1)
    }
}

trusted fun __ablaRuntimeThreadDrop(handle: any): any {
    val control = __ablaRuntimeSharedControl(handle, 13)
    __ablaRuntimeThreadJoin(control)
    __ablaRuntimeFree(control)
    __ablaRuntimeVoid()
}

trusted fun __ablaRuntimeAwait(operation: any): any {
    val tag = __ablaRuntimeTag(operation)
    val control = __ablaRuntimeWord0(operation)
    var result = __ablaRuntimeNull()
    if (tag == 12) {
        __ablaRuntimeDispatchClosure(control, control + 24)
        __ablaRuntimeReleaseClosure(control)
        result = __ablaRuntimeValueAt(control + 24)
        __ablaRuntimeFree(control)
    } else if (tag == 13) {
        __ablaRuntimeThreadJoin(control)
        result = __ablaRuntimeValueAt(control + 24)
        __ablaRuntimeFree(control)
    } else ablaRuntimeTrap()
    result
}

// Software transactional memory: the runtime half of `atomic`, `retry` and TVars
// (TL2 with snapshot extension). The language lowers an atomic block to
// __ablaRuntimeStmAtomic over the block as a closure, a TVar's reads and writes
// inside it to __ablaRuntimeStmRead / __ablaRuntimeStmWrite, and `retry` to
// __ablaRuntimeStmRetry.
//
// A TVar is a 40-byte block the collector reads as layout 7 (its value at +16):
//   +0  its word: the version of its value << 1, plus 1 while a committing
//       transaction holds it
//   +8  unused
//   +16 the value
// A value of tag 14 holds it.
//
// When no other thread runs (always on WebAssembly), a transaction runs directly:
// reads and writes reach the TVars at once, and the first write to each TVar keeps
// its old value in the thread's undo log, so a panic that a checked export catches
// rolls the transaction back. Nothing can conflict, and no thread can start inside
// it.
//
// Otherwise it is logged. It reads a snapshot (the global clock when it began): a
// read takes the TVar's word, its value, then the word again, and keeps the read
// (TVar, version) when both words agree, the TVar is not held and its version is
// no newer than the snapshot. A newer version first tries to move the snapshot to
// the current clock, which holds when every earlier read is still current. Writes
// go to a write buffer. The commit holds each written TVar (never waiting long:
// a TVar held elsewhere fails it), takes the next clock value, checks the reads
// again unless no other transaction committed since the snapshot, then writes the
// values back and releases each TVar at the new version (the clock is advanced as
// TL2's GV4 does, see __ablaRuntimeStmCommit). A failed read abandons
// the attempt from wherever its body is (the platform's longjmp), so a body never
// sees an inconsistent state; what the attempt pushed (root frames, a region,
// pending defers and drops) is left with its stack, which is why `atomic` may
// mutate only TVars and what it creates.
//
// A failed attempt backs off for a random time that doubles with each failure in a
// row. After 32 in a row the transaction runs alone: it takes the serial lock, and
// every other commit waits for it and fails, so its next attempt succeeds once the
// commits already past that check are done.
//
// `retry` abandons the attempt, then waits (under one global mutex and condition)
// until a TVar it read changes; a commit that wrote wakes the waiters when there
// are any.
//
// Each thread's descriptor (raw memory, in the shared list, freed when its thread
// ends):
//   0 atomic blocks entered (0 outside)   8 mode (1 direct, 2 logged)
//  16 the snapshot   24 the thread's number (from 1)   32 failures in a row
//  40 random state   48 reads   56 read capacity   64 read log   72 read roots
//  80 writes   88 write capacity   96 write log   104 write roots   112 written filter
// 120 the attempt's jmp_buf   128 root frames and region before it (2 words)
// 144 the next descriptor   152 the generator current before it   160 retrying
// 168 runs alone   176 read root frame   200 write root frame
// 224 the body's result (24 bytes)   248 attempts abandoned   256 logged commits
// 264 the block it was carved from
// A read entry is 32 bytes: the TVar's value, the version read. A write entry is
// 56: the TVar's value, the value (logged: to write; direct: the old one), and the
// TVar's word when the commit took it. The two root frames list each entry's values
// for the collector while the transaction runs.
//
// The shared state (raw memory): 0 the clock, alone in its cache line (every
// writing commit adds to it)   128 thread numbers given   136 waiting threads
// 144 the number of the thread running alone (0: none)   152 the first descriptor
// 160 attempts abandoned and 168 logged commits by threads that ended
// 192 the serial lock, the wait lock, then the wait condition.

var __ablaRuntimeStmShared: int = 0
// Every transaction logged, also on one thread (tests: logged transactions under
// collection stress).
var __ablaRuntimeStmAlwaysLogged: bool = false

@noinline
trusted fun __ablaRuntimeStmSharedCreate(): int {
    val lock = __ablaRuntimePlatformGlobalLock()
    var shared = __ablaRuntimeStmShared
    if (shared == 0) {
        val mutexBytes = __ablaRuntimePlatformMutexBytes()
        shared = __ablaRuntimePlatformRawAllocate(
            192 + 2 * mutexBytes + __ablaRuntimePlatformConditionBytes()
        )
        __ablaRuntimePlatformMutexInitialize(shared + 192)
        __ablaRuntimePlatformMutexInitialize(shared + 192 + mutexBytes)
        __ablaRuntimePlatformConditionInitialize(shared + 192 + 2 * mutexBytes)
        ablaRuntimeFenceRelease()
        __ablaRuntimeStmShared = shared
    }
    __ablaRuntimePlatformGlobalUnlock(lock)
    shared
}

@inline
trusted fun __ablaRuntimeStmState(): int {
    val shared = __ablaRuntimeStmShared
    if (shared != 0) shared else __ablaRuntimeStmSharedCreate()
}

@noinline
trusted fun __ablaRuntimeStmDescriptorCreate(): int {
    val shared = __ablaRuntimeStmState()
    // In cache lines of its own: every transaction writes it, and another
    // thread's descriptor sharing a line made four threads each four times slower.
    val block = __ablaRuntimePlatformRawAllocate(512)
    val descriptor = (block + 127) & -128
    ablaRuntimeStoreI64(descriptor + 264, block)
    val number = ablaRuntimeAtomicFetchAddI64(shared + 128, 1) + 1
    ablaRuntimeStoreI64(descriptor + 24, number)
    ablaRuntimeStoreI64(descriptor + 40, number * 2654435761 + 1)
    val lock = __ablaRuntimePlatformGlobalLock()
    ablaRuntimeStoreI64(descriptor + 144, ablaRuntimeLoadI64(shared + 152))
    ablaRuntimeStoreI64(shared + 152, descriptor)
    __ablaRuntimePlatformGlobalUnlock(lock)
    __ablaRuntimePlatformStmSetDescriptor(descriptor)
    descriptor
}

@inline
trusted fun __ablaRuntimeStmDescriptor(): int {
    val descriptor = __ablaRuntimePlatformStmDescriptor()
    if (descriptor != 0) descriptor else __ablaRuntimeStmDescriptorCreate()
}

// The thread is ending: its descriptor leaves the shared list.
trusted fun __ablaRuntimeStmThreadExit(): void {
    val descriptor = __ablaRuntimePlatformStmDescriptor()
    if (descriptor == 0) return
    val shared = __ablaRuntimeStmShared
    val lock = __ablaRuntimePlatformGlobalLock()
    var link = shared + 152
    while (ablaRuntimeLoadI64(link) != 0 && ablaRuntimeLoadI64(link) != descriptor) {
        link = ablaRuntimeLoadI64(link) + 144
    }
    if (ablaRuntimeLoadI64(link) == descriptor) {
        ablaRuntimeStoreI64(link, ablaRuntimeLoadI64(descriptor + 144))
    }
    ablaRuntimeStoreI64(shared + 160, ablaRuntimeLoadI64(shared + 160) + ablaRuntimeLoadI64(descriptor + 248))
    ablaRuntimeStoreI64(shared + 168, ablaRuntimeLoadI64(shared + 168) + ablaRuntimeLoadI64(descriptor + 256))
    __ablaRuntimePlatformGlobalUnlock(lock)
    __ablaRuntimePlatformRawFree(ablaRuntimeLoadI64(descriptor + 64))
    __ablaRuntimePlatformRawFree(ablaRuntimeLoadI64(descriptor + 72))
    __ablaRuntimePlatformRawFree(ablaRuntimeLoadI64(descriptor + 96))
    __ablaRuntimePlatformRawFree(ablaRuntimeLoadI64(descriptor + 104))
    __ablaRuntimePlatformRawFree(ablaRuntimeLoadI64(descriptor + 264))
    __ablaRuntimePlatformStmSetDescriptor(0)
}

trusted fun __ablaRuntimeTVarCreate(value: any): any {
    val tvar = __ablaRuntimeAllocateLayout(40, 7)
    ablaRuntimeStoreI64(tvar, 0)
    ablaRuntimeStoreI64(tvar + 8, 0)
    __ablaRuntimeCopyValue(value, tvar + 16)
    ablaRuntimeMakeValue(14, 0, tvar, 0)
}

// A TVar's bit in a descriptor's written filter.
@inline
trusted fun __ablaRuntimeStmBit(tvar: int): int = 1 << ((tvar >> 4) & 63)

// The write entry for `tvar`, or -1.
trusted fun __ablaRuntimeStmWritten(descriptor: int, tvar: int): int {
    if ((ablaRuntimeLoadI64(descriptor + 112) & __ablaRuntimeStmBit(tvar)) == 0) return -1
    val log = ablaRuntimeLoadI64(descriptor + 96)
    var index = ablaRuntimeLoadI64(descriptor + 80) - 1
    while (index >= 0) {
        if (ablaRuntimeLoadI64(log + index * 56 + 8) == tvar) return index
        index = index - 1
    }
    -1
}

// Grows a log (`at`: the descriptor's count field; capacity, log and roots follow)
// of `bytes`-byte entries holding `values` values each, and points its root frame
// at the new roots.
@noinline
trusted fun __ablaRuntimeStmGrow(at: int, bytes: int, values: int, frame: int): void {
    val count = ablaRuntimeLoadI64(at)
    val capacity = ablaRuntimeLoadI64(at + 8)
    val grown = if (capacity == 0) 16 else capacity * 2
    val log = __ablaRuntimePlatformRawAllocate(grown * bytes)
    val roots = __ablaRuntimePlatformRawAllocate(grown * values * __ablaRuntimePlatformRootBytes())
    val old = ablaRuntimeLoadI64(at + 16)
    var offset = 0
    while (offset < count * bytes) {
        ablaRuntimeStoreI64(log + offset, ablaRuntimeLoadI64(old + offset))
        offset = offset + 8
    }
    var index = 0
    while (index < grown) {
        var value = 0
        while (value < values) {
            __ablaRuntimePlatformRootStore(roots, index * values + value, log + index * bytes + value * 24)
            value = value + 1
        }
        index = index + 1
    }
    __ablaRuntimePlatformRawFree(old)
    __ablaRuntimePlatformRawFree(ablaRuntimeLoadI64(at + 24))
    ablaRuntimeStoreI64(at + 8, grown)
    ablaRuntimeStoreI64(at + 16, log)
    ablaRuntimeStoreI64(at + 24, roots)
    __ablaRuntimePlatformRootsSet(frame, roots, count * values)
}

trusted fun __ablaRuntimeStmLogRead(descriptor: int, tvar: any, version: int): void {
    val count = ablaRuntimeLoadI64(descriptor + 48)
    if (count == ablaRuntimeLoadI64(descriptor + 56)) {
        __ablaRuntimeStmGrow(descriptor + 48, 32, 1, descriptor + 176)
    }
    val entry = ablaRuntimeLoadI64(descriptor + 64) + count * 32
    __ablaRuntimeCopyValue(tvar, entry)
    ablaRuntimeStoreI64(entry + 24, version)
    ablaRuntimeStoreI64(descriptor + 48, count + 1)
    __ablaRuntimePlatformRootsSet(descriptor + 176, ablaRuntimeLoadI64(descriptor + 72), count + 1)
}

trusted fun __ablaRuntimeStmLogWrite(descriptor: int, tvar: any, value: any): void {
    val count = ablaRuntimeLoadI64(descriptor + 80)
    if (count == ablaRuntimeLoadI64(descriptor + 88)) {
        __ablaRuntimeStmGrow(descriptor + 80, 56, 2, descriptor + 200)
    }
    val entry = ablaRuntimeLoadI64(descriptor + 96) + count * 56
    __ablaRuntimeCopyValue(tvar, entry)
    __ablaRuntimeCopyValue(value, entry + 24)
    ablaRuntimeStoreI64(descriptor + 80, count + 1)
    ablaRuntimeStoreI64(
        descriptor + 112,
        ablaRuntimeLoadI64(descriptor + 112) | __ablaRuntimeStmBit(__ablaRuntimeWord0(tvar))
    )
    __ablaRuntimePlatformRootsSet(descriptor + 200, ablaRuntimeLoadI64(descriptor + 104), 2 * count + 2)
}

// Whether every read is still current: the same version, and not held. Only
// `committing`, when this transaction holds what it writes, is a held TVar it wrote
// its own; while its body runs (moving the snapshot up) it holds nothing, and a TVar
// it read and wrote can be held by another commit about to change it. Taking that
// lock for its own let the snapshot move past the other commit's version, and the
// commit then skip its check (the clock had not moved since) and overwrite the
// other's write.
trusted fun __ablaRuntimeStmValidate(descriptor: int, committing: bool): bool {
    val log = ablaRuntimeLoadI64(descriptor + 64)
    val count = ablaRuntimeLoadI64(descriptor + 48)
    var index = 0
    while (index < count) {
        val tvar = ablaRuntimeLoadI64(log + index * 32 + 8)
        val word = ablaRuntimeAtomicLoadI64(tvar)
        if ((word >> 1) != ablaRuntimeLoadI64(log + index * 32 + 24)) return false
        if ((word & 1) != 0 &&
            (!committing || __ablaRuntimeStmWritten(descriptor, tvar) < 0)) return false
        index = index + 1
    }
    true
}

// Leaves the attempt at once (from any depth of its body), to retry it or, with
// `retrying`, to wait for a change first.
@noinline
trusted fun __ablaRuntimeStmAbandon(descriptor: int, retrying: bool): never {
    ablaRuntimeStoreI64(descriptor + 160, if (retrying) 1 else 0)
    __ablaRuntimePlatformAbandon(descriptor + 120)
}

@noinline
trusted fun __ablaRuntimeStmReadLogged(descriptor: int, tvarValue: any, tvar: int): any {
    val written = __ablaRuntimeStmWritten(descriptor, tvar)
    if (written >= 0) {
        return __ablaRuntimeValueAt(ablaRuntimeLoadI64(descriptor + 96) + written * 56 + 24)
    }
    var tries = 0
    while (tries < 256) {
        val word = ablaRuntimeAtomicLoadI64(tvar)
        if ((word & 1) == 0) {
            val value = __ablaRuntimeValueAt(tvar + 16)
            ablaRuntimeFenceAcquire()
            if (ablaRuntimeLoadI64(tvar) == word) {
                val version = word >> 1
                if (version <= ablaRuntimeLoadI64(descriptor + 16)) {
                    __ablaRuntimeStmLogRead(descriptor, tvarValue, version)
                    return value
                }
                // Newer than the snapshot: move the snapshot up, then read again.
                val now = ablaRuntimeAtomicLoadI64(__ablaRuntimeStmShared)
                if (!__ablaRuntimeStmValidate(descriptor, false)) {
                    __ablaRuntimeStmAbandon(descriptor, false)
                }
                ablaRuntimeStoreI64(descriptor + 16, now)
            }
        }
        tries = tries + 1
    }
    __ablaRuntimeStmAbandon(descriptor, false)
}

// A TVar's value, inside a transaction. Inline, as is a write's check: a block's
// accesses share one lookup of the thread's descriptor (a call on some hosts).
@inline
trusted fun __ablaRuntimeStmRead(tvarValue: any): any {
    val tvar = __ablaRuntimeSharedControl(tvarValue, 14)
    val descriptor = __ablaRuntimePlatformStmDescriptor()
    if (descriptor == 0 || ablaRuntimeLoadI64(descriptor + 8) != 2 ||
        ablaRuntimeLoadI64(descriptor) == 0) {
        __ablaRuntimeValueAt(tvar + 16)
    } else __ablaRuntimeStmReadLogged(descriptor, tvarValue, tvar)
}

// Sets a TVar's value, inside a transaction.
@inline
trusted fun __ablaRuntimeStmWrite(tvarValue: any, value: any): any {
    val tvar = __ablaRuntimeSharedControl(tvarValue, 14)
    val descriptor = __ablaRuntimePlatformStmDescriptor()
    if (descriptor == 0 || ablaRuntimeLoadI64(descriptor) == 0) {
        __ablaRuntimeCopyValue(value, tvar + 16)
    } else __ablaRuntimeStmWriteLogged(descriptor, tvarValue, tvar, value)
    __ablaRuntimeVoid()
}

// A write inside a transaction: to the write buffer (logged), or in place with the
// old value kept once (direct).
@noinline
trusted fun __ablaRuntimeStmWriteLogged(descriptor: int, tvarValue: any, tvar: int, value: any): void {
    val logged = ablaRuntimeLoadI64(descriptor + 8) == 2
    val written = __ablaRuntimeStmWritten(descriptor, tvar)
    if (written >= 0) {
        if (logged) {
            __ablaRuntimeCopyValue(
                value, ablaRuntimeLoadI64(descriptor + 96) + written * 56 + 24
            )
        } else __ablaRuntimeCopyValue(value, tvar + 16)
    } else if (logged) {
        __ablaRuntimeStmLogWrite(descriptor, tvarValue, value)
    } else {
        __ablaRuntimeStmLogWrite(descriptor, tvarValue, __ablaRuntimeValueAt(tvar + 16))
        __ablaRuntimeCopyValue(value, tvar + 16)
    }
}

// Inside a transaction: waits until a TVar it read changes, then runs it again.
trusted fun __ablaRuntimeStmRetry(): never {
    val descriptor = __ablaRuntimePlatformStmDescriptor()
    if (descriptor == 0 || ablaRuntimeLoadI64(descriptor) == 0) {
        __ablaRuntimePanic("retry outside a transaction")
    }
    if (ablaRuntimeLoadI64(descriptor + 8) != 2 || __ablaRuntimePlatformOnlyThread() ||
        ablaRuntimeLoadI64(descriptor + 48) == 0) {
        __ablaRuntimePanic("retry can never wake: no other thread can change what the transaction read")
    }
    __ablaRuntimeStmAbandon(descriptor, true)
}

// Whether the calling thread is inside a transaction.
trusted fun __ablaRuntimeStmActive(): bool {
    val descriptor = __ablaRuntimePlatformStmDescriptor()
    descriptor != 0 && ablaRuntimeLoadI64(descriptor) != 0
}

// Starts the outermost transaction of an attempt.
trusted fun __ablaRuntimeStmBegin(descriptor: int): void {
    ablaRuntimeStoreI64(descriptor, 1)
    ablaRuntimeStoreI64(descriptor + 160, 0)
    val logged = __ablaRuntimeStmAlwaysLogged || !__ablaRuntimePlatformOnlyThread()
    ablaRuntimeStoreI64(descriptor + 8, if (logged) 2 else 1)
    ablaRuntimeStoreI64(descriptor + 48, 0)
    ablaRuntimeStoreI64(descriptor + 80, 0)
    ablaRuntimeStoreI64(descriptor + 112, 0)
    if (logged) {
        ablaRuntimeStoreI64(descriptor + 16, ablaRuntimeAtomicLoadI64(__ablaRuntimeStmState()))
    }
    __ablaRuntimeRootsPush(descriptor + 176, ablaRuntimeLoadI64(descriptor + 72), 0)
    __ablaRuntimeRootsPush(descriptor + 200, ablaRuntimeLoadI64(descriptor + 104), 0)
    __ablaRuntimePlatformUnwindSave(descriptor + 128)
    ablaRuntimeStoreI64(descriptor + 152, __ablaRuntimeCurrentGenerator)
}

// Ends the outermost transaction (committed, rolled back or abandoned).
trusted fun __ablaRuntimeStmEnd(descriptor: int): void {
    __ablaRuntimeRootsPop(descriptor + 200)
    __ablaRuntimeRootsPop(descriptor + 176)
    ablaRuntimeStoreI64(descriptor + 48, 0)
    ablaRuntimeStoreI64(descriptor + 80, 0)
    ablaRuntimeStoreI64(descriptor + 112, 0)
    ablaRuntimeStoreI64(descriptor, 0)
}

// Releases the TVars a failed commit held, the first `count` of its writes.
trusted fun __ablaRuntimeStmRelease(descriptor: int, count: int): void {
    val log = ablaRuntimeLoadI64(descriptor + 96)
    var index = 0
    while (index < count) {
        val entry = log + index * 56
        ablaRuntimeAtomicStoreI64(ablaRuntimeLoadI64(entry + 8), ablaRuntimeLoadI64(entry + 48))
        index = index + 1
    }
}

// Commits a logged transaction; false when it conflicted (nothing was written).
trusted fun __ablaRuntimeStmCommit(descriptor: int): bool {
    val writes = ablaRuntimeLoadI64(descriptor + 80)
    if (writes == 0) return true
    val shared = __ablaRuntimeStmShared
    val alone = ablaRuntimeAtomicLoadI64(shared + 144)
    if (alone != 0 && alone != ablaRuntimeLoadI64(descriptor + 24)) {
        // Another transaction runs alone: wait for it, then run again.
        __ablaRuntimePlatformMutexLock(shared + 192)
        __ablaRuntimePlatformMutexUnlock(shared + 192)
        return false
    }
    val log = ablaRuntimeLoadI64(descriptor + 96)
    var held = 0
    while (held < writes) {
        val entry = log + held * 56
        val tvar = ablaRuntimeLoadI64(entry + 8)
        var tries = 0
        var taken = false
        while (!taken && tries < 64) {
            val word = ablaRuntimeAtomicLoadI64(tvar)
            if ((word & 1) == 0 &&
                ablaRuntimeAtomicCompareExchangeI64(tvar, word, word | 1) == word) {
                ablaRuntimeStoreI64(entry + 48, word)
                taken = true
            } else tries = tries + 1
        }
        if (!taken) {
            __ablaRuntimeStmRelease(descriptor, held)
            return false
        }
        held = held + 1
    }
    // The new version: the clock moved up by one, or, when another commit moved it
    // first, the version that commit took (TL2's GV4: both hold their TVars, so they
    // may share it, and a contended clock sees one write instead of a queue of them).
    // The reads need checking again unless this commit moved the clock up from the
    // snapshot itself.
    val seen = ablaRuntimeAtomicLoadI64(shared)
    val observed = ablaRuntimeAtomicCompareExchangeI64(shared, seen, seen + 1)
    val version = if (observed == seen) seen + 1 else observed
    if ((observed != seen || seen != ablaRuntimeLoadI64(descriptor + 16)) &&
        !__ablaRuntimeStmValidate(descriptor, true)) {
        __ablaRuntimeStmRelease(descriptor, writes)
        return false
    }
    // Every TVar's lock bit before any of its new bytes, as a seqlock's writer
    // must: a reader that sees a new byte then sees the TVar held (or released at
    // the new version) when it reads the word again. Without it the stores after
    // the compare-and-swaps could become visible first on arm64, and a transaction
    // could read one TVar's new value under its old version and another's old
    // value, then pass its validation before the bits showed.
    ablaRuntimeFenceRelease()
    var index = 0
    while (index < writes) {
        val entry = log + index * 56
        __ablaRuntimeCopyValue(__ablaRuntimeValueAt(entry + 24), ablaRuntimeLoadI64(entry + 8) + 16)
        index = index + 1
    }
    index = 0
    while (index < writes) {
        ablaRuntimeAtomicStoreI64(ablaRuntimeLoadI64(log + index * 56 + 8), version << 1)
        index = index + 1
    }
    ablaRuntimeStoreI64(descriptor + 256, ablaRuntimeLoadI64(descriptor + 256) + 1)
    // Ordered after the releases: a thread that counted itself waiting before this
    // load is woken; one counted after it sees the new versions.
    ablaRuntimeFence()
    if (ablaRuntimeAtomicLoadI64(shared + 136) != 0) {
        val waitLock = shared + 192 + __ablaRuntimePlatformMutexBytes()
        __ablaRuntimePlatformMutexLock(waitLock)
        __ablaRuntimePlatformConditionBroadcast(waitLock + __ablaRuntimePlatformMutexBytes())
        __ablaRuntimePlatformMutexUnlock(waitLock)
    }
    true
}

// Whether a TVar a retrying transaction read has changed since.
trusted fun __ablaRuntimeStmChanged(descriptor: int): bool {
    val log = ablaRuntimeLoadI64(descriptor + 64)
    val count = ablaRuntimeLoadI64(descriptor + 48)
    var index = 0
    while (index < count) {
        val word = ablaRuntimeAtomicLoadI64(ablaRuntimeLoadI64(log + index * 32 + 8))
        if (word != ablaRuntimeLoadI64(log + index * 32 + 24) << 1) return true
        index = index + 1
    }
    false
}

trusted fun __ablaRuntimeStmAwaitChange(descriptor: int): void {
    val shared = __ablaRuntimeStmShared
    val waitLock = shared + 192 + __ablaRuntimePlatformMutexBytes()
    ablaRuntimeAtomicFetchAddI64(shared + 136, 1)
    __ablaRuntimePlatformMutexLock(waitLock)
    while (!__ablaRuntimeStmChanged(descriptor)) {
        __ablaRuntimePlatformConditionWait(waitLock + __ablaRuntimePlatformMutexBytes(), waitLock)
    }
    __ablaRuntimePlatformMutexUnlock(waitLock)
    ablaRuntimeAtomicFetchAddI64(shared + 136, -1)
    return
}

// No longer running alone. (Plain stores across a fence: a checked export's
// recovery reaches this in every program that has one.)
trusted fun __ablaRuntimeStmJoin(descriptor: int): void {
    if (ablaRuntimeLoadI64(descriptor + 168) != 0) {
        ablaRuntimeFence()
        ablaRuntimeStoreI64(__ablaRuntimeStmShared + 144, 0)
        __ablaRuntimePlatformMutexUnlock(__ablaRuntimeStmShared + 192)
        ablaRuntimeStoreI64(descriptor + 168, 0)
    }
}

// A failed attempt: wait a random time that doubles with each failure in a row, or
// after 32 run alone.
trusted fun __ablaRuntimeStmBackOff(descriptor: int): void {
    val failures = ablaRuntimeLoadI64(descriptor + 32) + 1
    ablaRuntimeStoreI64(descriptor + 32, failures)
    val shared = __ablaRuntimeStmShared
    ablaRuntimeStoreI64(descriptor + 248, ablaRuntimeLoadI64(descriptor + 248) + 1)
    if (failures >= 32 && ablaRuntimeLoadI64(descriptor + 168) == 0) {
        __ablaRuntimePlatformMutexLock(shared + 192)
        ablaRuntimeAtomicStoreI64(shared + 144, ablaRuntimeLoadI64(descriptor + 24))
        ablaRuntimeStoreI64(descriptor + 168, 1)
        return
    }
    var random = ablaRuntimeLoadI64(descriptor + 40)
    random = random ^ (random << 13)
    random = random ^ (random >> 7)
    random = random ^ (random << 17)
    ablaRuntimeStoreI64(descriptor + 40, random)
    val window = 1 << (if (failures > 10) 10 else failures)
    var spins = (random & (window - 1)) * 16
    while (spins > 0) {
        ablaRuntimeAtomicLoadI64(shared)
        spins = spins - 1
    }
}

// Runs `closure` (no arguments) as a transaction and returns its result. Inside
// another transaction it joins that one.
trusted fun __ablaRuntimeStmAtomic(closure: any): any {
    val descriptor = __ablaRuntimeStmDescriptor()
    val closureAddress = ablaRuntimeValueAddress(closure)
    val output = descriptor + 224
    val depth = ablaRuntimeLoadI64(descriptor)
    if (depth != 0) {
        ablaRuntimeStoreI64(descriptor, depth + 1)
        __ablaRuntimeDispatchClosure(closureAddress, output)
        ablaRuntimeStoreI64(descriptor, depth)
