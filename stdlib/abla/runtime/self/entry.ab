    var count: int = 1
    ablaRuntimeStoreI64(stack, __ablaRuntimeWord0(value))
    ablaRuntimeStoreI64(stack + 8, __ablaRuntimeWord1(value))
    while (count > 0) {
        count = count - 1
        val data = ablaRuntimeLoadI64(stack + count * 16)
        val storage = ablaRuntimeLoadI64(stack + count * 16 + 8)
        if (data != 0) {
            var index: int = 0
            while (index < storage) {
