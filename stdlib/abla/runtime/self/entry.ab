    ablaRuntimeStoreI64(pending, __ablaRuntimeWord0(value))
    ablaRuntimeStoreI64(pending + 8, __ablaRuntimeWord1(value))
    while (pendingCount > 0 && count < maximum) {
        pendingCount = pendingCount - 1
        var data = ablaRuntimeLoadI64(pending + pendingCount * 16)
        val storage = ablaRuntimeLoadI64(
            pending + pendingCount * 16 + 8
        )
        val currentLength = if (data != 0) storage
            else if (storage != 0) ablaRuntimeLoadI64(storage)
            else 0
        if (skipped >= currentLength) skipped = skipped - currentLength
        else {
            if (data == 0 && storage != 0) {
                data = ablaRuntimeLoadI64(storage + 40)
            }
            if (data != 0) {
                ablaRuntimeStoreI64(
                    vectors + count * 16, data + skipped
                )
                ablaRuntimeStoreI64(
                    vectors + count * 16 + 8,
                    currentLength - skipped
                )
                count = count + 1
                skipped = 0
            } else if (storage != 0 && pendingCount + 2 <= maximum) {
                // LIFO: push right first so the left segment is emitted first.
                ablaRuntimeStoreI64(
                    pending + pendingCount * 16,
                    ablaRuntimeLoadI64(storage + 24)
                )
                ablaRuntimeStoreI64(
                    pending + pendingCount * 16 + 8,
                    ablaRuntimeLoadI64(storage + 32)
                )
                pendingCount = pendingCount + 1
                ablaRuntimeStoreI64(
                    pending + pendingCount * 16,
                    ablaRuntimeLoadI64(storage + 8)
                )
                ablaRuntimeStoreI64(
                    pending + pendingCount * 16 + 8,
                    ablaRuntimeLoadI64(storage + 16)
                )
                pendingCount = pendingCount + 1
            } else return -7
        }
    }
    if (pendingCount != 0 || count == 0) -7 else count
}

trusted fun __ablaRuntimeAsCString(value: any): int {
    val length = __ablaRuntimeStringLengthValue(value)
    val result = __ablaRuntimeAllocateLayout(length + 1, 1)
    val source = if (length == 0) 0 else __ablaRuntimeStringData(value)
    var index: int = 0
    while (index < length) {
        ablaRuntimeStoreU8(result + index, ablaRuntimeLoadU8(source + index))
        index = index + 1
    }
    ablaRuntimeStoreU8(result + length, 0)
    result
}

trusted fun __ablaRuntimeToString(value: any): any {
    val tag = __ablaRuntimeTag(value)
    var result: any = value
    if (tag == 1) result = "null"
    if (tag == 3) {
        if (__ablaRuntimeAsBool(value)) result = "true"
        else result = "false"
    }
    if (tag == 2) {
        val buffer = __ablaRuntimeAllocateLayout(32, 1)
        var cursor: int = 31
        var number: int = __ablaRuntimeAsI64(value)
        val negative = number < 0
        if (number > 0) number = 0 - number
        if (number == 0) {
            cursor = cursor - 1
            ablaRuntimeStoreU8(buffer + cursor, 48)
        }
        while (number < 0) {
            val quotient = number / 10
            val digit = 0 - (number - quotient * 10)
            cursor = cursor - 1
            ablaRuntimeStoreU8(buffer + cursor, 48 + digit)
            number = quotient
        }
        if (negative) {
            cursor = cursor - 1
            ablaRuntimeStoreU8(buffer + cursor, 45)
        }
        result = __ablaRuntimeStringStatic(buffer + cursor, 31 - cursor)
    }
    if (tag != 1 && tag != 2 && tag != 3 && tag != 4) ablaRuntimeTrap()
    result
}

trusted fun __ablaRuntimeStringConcat(left: any, right: any): any {
    val leftLength = __ablaRuntimeStringLengthValue(left)
    val rightLength = __ablaRuntimeStringLengthValue(right)
    if (leftLength == 0) right
    else if (rightLength == 0) left
    else {
        val rope = __ablaRuntimeAllocateLayout(48, 6)
        ablaRuntimeStoreI64(rope, leftLength + rightLength)
        ablaRuntimeStoreI64(rope + 8, __ablaRuntimeWord0(left))
        ablaRuntimeStoreI64(rope + 16, __ablaRuntimeWord1(left))
        ablaRuntimeStoreI64(rope + 24, __ablaRuntimeWord0(right))
        ablaRuntimeStoreI64(rope + 32, __ablaRuntimeWord1(right))
        ablaRuntimeStoreI64(rope + 40, 0)
        ablaRuntimeMakeValue(4, 0, 0, rope)
    }
}

trusted fun __ablaRuntimeStringLengthI64(value: any): int =
    __ablaRuntimeStringLengthValue(value)

trusted fun __ablaRuntimeStringLength(value: any): any =
    __ablaRuntimeI64(__ablaRuntimeStringLengthValue(value))

trusted fun __ablaRuntimeStringGetI64(value: any, index: int): int {
    val length = __ablaRuntimeStringLengthValue(value)
    if (index < 0 || index >= length) {
        ablaRuntimeTrap()
        0
    } else ablaRuntimeLoadU8(__ablaRuntimeStringData(value) + index)
}

trusted fun __ablaRuntimeStringGet(value: any, index: any): any =
    __ablaRuntimeI64(
        __ablaRuntimeStringGetI64(value, __ablaRuntimeAsI64(index))
    )

trusted fun __ablaRuntimeStringSlice(
    value: any,
    beginValue: any,
    endValue: any
): any {
    val begin = __ablaRuntimeAsI64(beginValue)
    val end = __ablaRuntimeAsI64(endValue)
    val length = __ablaRuntimeStringLengthValue(value)
    if (begin < 0 || end < begin || end > length) {
        ablaRuntimeTrap()
        __ablaRuntimeStringStatic(0, 0)
    } else if (begin == 0 && end == length) value
    else if (begin == end) __ablaRuntimeStringStatic(0, 0)
    else __ablaRuntimeStringStatic(
            __ablaRuntimeStringData(value) + begin,
            end - begin
        )
}

trusted fun __ablaRuntimeByteEncode(value: int): any {
    var result: any = ""
    if (value >= 0 && value <= 255) {
        val data = __ablaRuntimeAllocateLayout(2, 1)
        ablaRuntimeStoreU8(data, value)
        ablaRuntimeStoreU8(data + 1, 0)
        result = __ablaRuntimeStringStatic(data, 1)
    }
    result
}

@inline
trusted fun __ablaRuntimeBase64Digit(value: int): int {
    if (value < 26) value + 65
    else if (value < 52) value + 71
    else if (value < 62) value - 4
    else if (value == 62) 43
    else 47
}

// Base64 is emitted directly into one owned string allocation. Keeping this
// implementation in Abla avoids the tiny-slice and rope churn of the portable
// staged algorithm without introducing a C/runtime-library dependency.
trusted fun __ablaRuntimeBase64Encode(value: string): any {
    val length: int = __ablaRuntimeStringLengthValue(value)
    if (length == 0) return ""
    val outputLength: int = ((length + 2) / 3) * 4
    val output: int = __ablaRuntimeAllocateLayout(outputLength + 1, 1)
    val input: int = __ablaRuntimeStringData(value)
    var source: int = 0
    var destination: int = 0
    while (source < length) {
        val remaining: int = length - source
        val first: int = ablaRuntimeLoadU8(input + source)
        val second: int = if (remaining > 1) {
            ablaRuntimeLoadU8(input + source + 1)
        } else 0
        val third: int = if (remaining > 2) {
            ablaRuntimeLoadU8(input + source + 2)
        } else 0
        val combined: int = (first << 16) | (second << 8) | third
        ablaRuntimeStoreU8(
            output + destination,
            __ablaRuntimeBase64Digit((combined >>> 18) & 63)
        )
        ablaRuntimeStoreU8(
            output + destination + 1,
            __ablaRuntimeBase64Digit((combined >>> 12) & 63)
        )
        ablaRuntimeStoreU8(
            output + destination + 2,
            if (remaining > 1) {
                __ablaRuntimeBase64Digit((combined >>> 6) & 63)
            } else 61
        )
        ablaRuntimeStoreU8(
            output + destination + 3,
            if (remaining > 2) {
                __ablaRuntimeBase64Digit(combined & 63)
            } else 61
        )
        source = source + 3
        destination = destination + 4
    }
    ablaRuntimeStoreU8(output + outputLength, 0)
    __ablaRuntimeStringStatic(output, outputLength)
}

@inline
trusted fun __ablaRuntimeBase64DecodeDigit(value: int): int {
    if (value >= 65 && value <= 90) value - 65
    else if (value >= 97 && value <= 122) value - 71
    else if (value >= 48 && value <= 57) value + 4
    else if (value == 43) 62
    else if (value == 47) 63
    else -1
}

trusted fun __ablaRuntimeBase64Decode(value: string): any {
    val length: int = __ablaRuntimeStringLengthValue(value)
    if (length == 0 || (length & 3) != 0) return ""
    val input: int = __ablaRuntimeStringData(value)
    val padded2: bool = ablaRuntimeLoadU8(input + length - 2) == 61
    val padded3: bool = ablaRuntimeLoadU8(input + length - 1) == 61
    val outputLength: int = (length / 4) * 3 -
        (if (padded3) 1 else 0) - (if (padded2) 1 else 0)
    val output: int = __ablaRuntimeAllocateLayout(outputLength + 1, 1)
    var source: int = 0
    var destination: int = 0
    var valid: bool = true
    while (valid && source < length) {
        val byte2: int = ablaRuntimeLoadU8(input + source + 2)
        val byte3: int = ablaRuntimeLoadU8(input + source + 3)
        val groupPadded2: bool = byte2 == 61
        val groupPadded3: bool = byte3 == 61
        val a: int = __ablaRuntimeBase64DecodeDigit(
            ablaRuntimeLoadU8(input + source)
        )
        val b: int = __ablaRuntimeBase64DecodeDigit(
            ablaRuntimeLoadU8(input + source + 1)
        )
        val c: int = if (groupPadded2) 0
            else __ablaRuntimeBase64DecodeDigit(byte2)
        val d: int = if (groupPadded3) 0
            else __ablaRuntimeBase64DecodeDigit(byte3)
        valid = a >= 0 && b >= 0 && c >= 0 && d >= 0 &&
            (!groupPadded2 || groupPadded3) &&
            (!(groupPadded2 || groupPadded3) || source + 4 == length)
        if (valid) {
            val combined: int = (a << 18) | (b << 12) | (c << 6) | d
            ablaRuntimeStoreU8(
                output + destination, (combined >>> 16) & 255
            )
            destination = destination + 1
            if (!groupPadded2) {
                ablaRuntimeStoreU8(
                    output + destination, (combined >>> 8) & 255
                )
                destination = destination + 1
            }
            if (!groupPadded3) {
                ablaRuntimeStoreU8(output + destination, combined & 255)
                destination = destination + 1
            }
        }
        source = source + 4
    }
    if (valid && destination == outputLength) {
        ablaRuntimeStoreU8(output + outputLength, 0)
        __ablaRuntimeStringStatic(output, outputLength)
    } else {
        __ablaRuntimeFree(output)
        ""
    }
}

// Flatten immutable byte chunks into exactly one owned allocation. ByteBuffer
// remains an ordinary phase-safe Abla class; only the final contiguous storage
// operation lives at the raw-memory runtime boundary.
trusted fun __ablaRuntimeByteChunksJoin(
    chunks: array<string>,
    byteCount: int
): any {
    if (byteCount < 0) {
        ablaRuntimeTrap()
        return ""
    }
    if (byteCount == 0) return ""
    val output: int = __ablaRuntimeAllocateLayout(byteCount + 1, 1)
    var destination: int = 0
    var index: int = 0
    while (index < chunks.size) {
        val chunk: string = chunks[index]
        val length: int = __ablaRuntimeStringLengthValue(chunk)
        if (length < 0 || length > byteCount - destination) {
            ablaRuntimeTrap()
            return ""
        }
        val source: int = if (length == 0) 0
            else __ablaRuntimeStringData(chunk)
        var offset: int = 0
        while (offset < length) {
            ablaRuntimeStoreU8(
                output + destination + offset,
                ablaRuntimeLoadU8(source + offset)
            )
            offset = offset + 1
        }
        destination = destination + length
        index = index + 1
    }
    if (destination != byteCount) {
        ablaRuntimeTrap()
        return ""
    }
    ablaRuntimeStoreU8(output + byteCount, 0)
    __ablaRuntimeStringStatic(output, byteCount)
}

trusted fun __ablaRuntimeUtf8EncodeScalar(value: int): any {
    var length: int = 0
    if (value >= 0 && value <= 127) length = 1
    if (value >= 128 && value <= 2047) length = 2
    if (value >= 2048 && value <= 65535 &&
        (value < 55296 || value > 57343)) length = 3
    if (value >= 65536 && value <= 1114111) length = 4
    var result: any = ""
    if (length > 0) {
        val data = __ablaRuntimeAllocateLayout(length + 1, 1)
        if (length == 1) ablaRuntimeStoreU8(data, value)
        if (length == 2) {
            ablaRuntimeStoreU8(data, 192 | (value >> 6))
            ablaRuntimeStoreU8(data + 1, 128 | (value & 63))
        }
        if (length == 3) {
            ablaRuntimeStoreU8(data, 224 | (value >> 12))
            ablaRuntimeStoreU8(data + 1, 128 | ((value >> 6) & 63))
            ablaRuntimeStoreU8(data + 2, 128 | (value & 63))
        }
        if (length == 4) {
            ablaRuntimeStoreU8(data, 240 | (value >> 18))
            ablaRuntimeStoreU8(data + 1, 128 | ((value >> 12) & 63))
            ablaRuntimeStoreU8(data + 2, 128 | ((value >> 6) & 63))
            ablaRuntimeStoreU8(data + 3, 128 | (value & 63))
        }
        ablaRuntimeStoreU8(data + length, 0)
        result = __ablaRuntimeStringStatic(data, length)
    }
    result
}

// Arrays use the native 64-bit header layout on every target: length,
// capacity, and values pointer. This makes the runtime ABI deterministic and
// keeps the same optimized layout used by native Abla Web services.
trusted fun __ablaRuntimeArrayCreate(values: int, count: int): any {
    if (count < 0) ablaRuntimeTrap()
    val array = __ablaRuntimeAllocateLayout(24 + count * 24, 4)
    val destination = if (count == 0) 0 else array + 24
    ablaRuntimeStoreI64(array, count)
    ablaRuntimeStoreI64(array + 8, count)
    ablaRuntimeStoreI64(array + 16, destination)
    var index: int = 0
    while (index < count) {
        val source = values + index * 24
        ablaRuntimeStoreI64(destination + index * 24, ablaRuntimeLoadI64(source))
        ablaRuntimeStoreI64(
            destination + index * 24 + 8,
            ablaRuntimeLoadI64(source + 8)
        )
        ablaRuntimeStoreI64(
            destination + index * 24 + 16,
            ablaRuntimeLoadI64(source + 16)
        )
        index = index + 1
    }
    ablaRuntimeMakeValue(7, 0, array, 0)
}

trusted fun __ablaRuntimeArrayAddress(value: any): int {
    val array = __ablaRuntimeWord0(value)
    if (array == 0) ablaRuntimeTrap()
    array
}

trusted fun __ablaRuntimeArrayLengthI64(value: any): int =
    ablaRuntimeLoadI64(__ablaRuntimeArrayAddress(value))

trusted fun __ablaRuntimeArrayLength(value: any): any =
    __ablaRuntimeI64(__ablaRuntimeArrayLengthI64(value))

trusted fun __ablaRuntimeArrayValueAddress(value: any, index: int): int {
    val array = __ablaRuntimeArrayAddress(value)
    val length = ablaRuntimeLoadI64(array)
    if (index < 0 || index >= length) {
        ablaRuntimeTrap()
        0
    } else ablaRuntimeLoadI64(array + 16) + index * 24
}

trusted fun __ablaRuntimeArrayAppend(value: any, element: any): any {
    val array = __ablaRuntimeArrayAddress(value)
    val length = ablaRuntimeLoadI64(array)
    val capacity = ablaRuntimeLoadI64(array + 8)
    var values: int = ablaRuntimeLoadI64(array + 16)
    if (length == capacity) {
        val next = if (capacity == 0) 4 else capacity * 2
        val replacement = __ablaRuntimeAllocateLayout(next * 24, 2)
        var index: int = 0
        while (index < length) {
            ablaRuntimeStoreI64(
                replacement + index * 24,
                ablaRuntimeLoadI64(values + index * 24)
            )
            ablaRuntimeStoreI64(
                replacement + index * 24 + 8,
                ablaRuntimeLoadI64(values + index * 24 + 8)
            )
            ablaRuntimeStoreI64(
                replacement + index * 24 + 16,
                ablaRuntimeLoadI64(values + index * 24 + 16)
            )
            index = index + 1
        }
        if (values != 0 && values != array + 24) {
            __ablaRuntimeFree(values)
        }
        values = replacement
        ablaRuntimeStoreI64(array + 8, next)
        ablaRuntimeStoreI64(array + 16, values)
    }
    __ablaRuntimeCopyValue(element, values + length * 24)
    ablaRuntimeStoreI64(array, length + 1)
    __ablaRuntimeVoid()
}

trusted fun __ablaRuntimeArrayGet(value: any, indexValue: any): any =
    __ablaRuntimeValueAt(
        __ablaRuntimeArrayValueAddress(value, __ablaRuntimeAsI64(indexValue))
    )

trusted fun __ablaRuntimeArrayGetI64(value: any, index: int): int {
    val element = __ablaRuntimeArrayValueAddress(value, index)
    if (ablaRuntimeLoadI32(element) != 2) ablaRuntimeTrap()
    ablaRuntimeLoadI64(element + 8)
}

trusted fun __ablaRuntimeArrayGetBool(value: any, index: int): bool {
    val element = __ablaRuntimeArrayValueAddress(value, index)
    if (ablaRuntimeLoadI32(element) != 3) ablaRuntimeTrap()
    ablaRuntimeLoadI64(element + 8) != 0
}

trusted fun __ablaRuntimeIndexGet(value: any, index: any): any {
    val tag = __ablaRuntimeTag(value)
    if (tag == 4) __ablaRuntimeStringGet(value, index)
    else if (tag == 7) __ablaRuntimeArrayGet(value, index)
    else {
        ablaRuntimeTrap()
        __ablaRuntimeNull()
