    __ablaRuntimeStmJoin(descriptor)
    ablaRuntimeStoreI64(descriptor + 48, 0)
    ablaRuntimeStoreI64(descriptor + 80, 0)
    ablaRuntimeStoreI64(descriptor + 112, 0)
    ablaRuntimeStoreI64(descriptor, 0)
