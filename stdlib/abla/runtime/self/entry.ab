// Base64 is emitted directly into one owned string allocation. Keeping this
// implementation in Abla avoids the tiny-slice and rope churn of the portable
// staged algorithm without introducing a C/runtime-library dependency.
trusted fun __ablaRuntimeBase64Encode(value: string): any {
    val length: int = __ablaRuntimeStringLengthValue(value)
    if (length == 0) return ""
    val outputLength: int = ((length + 2) / 3) * 4
    val output: int = __ablaRuntimeAllocateLayout(outputLength + 1, 1)
    val input: int = __ablaRuntimeStringData(value)
    var source: int = 0
    var destination: int = 0
    while (source < length) {
        val remaining: int = length - source
        val first: int = ablaRuntimeLoadU8(input + source)
        val second: int = if (remaining > 1) {
            ablaRuntimeLoadU8(input + source + 1)
        } else 0
        val third: int = if (remaining > 2) {
            ablaRuntimeLoadU8(input + source + 2)
        } else 0
        val combined: int = (first << 16) | (second << 8) | third
        ablaRuntimeStoreU8(
            output + destination,
            __ablaRuntimeBase64Digit((combined >>> 18) & 63)
        )
        ablaRuntimeStoreU8(
            output + destination + 1,
            __ablaRuntimeBase64Digit((combined >>> 12) & 63)
        )
        ablaRuntimeStoreU8(
            output + destination + 2,
            if (remaining > 1) {
                __ablaRuntimeBase64Digit((combined >>> 6) & 63)
            } else 61
        )
        ablaRuntimeStoreU8(
            output + destination + 3,
            if (remaining > 2) {
                __ablaRuntimeBase64Digit(combined & 63)
            } else 61
        )
        source = source + 3
        destination = destination + 4
    }
    ablaRuntimeStoreU8(output + outputLength, 0)
    __ablaRuntimeStringStatic(output, outputLength)
}

@inline
trusted fun __ablaRuntimeBase64DecodeDigit(value: int): int {
    if (value >= 65 && value <= 90) value - 65
    else if (value >= 97 && value <= 122) value - 71
    else if (value >= 48 && value <= 57) value + 4
    else if (value == 43) 62
    else if (value == 47) 63
    else -1
}

trusted fun __ablaRuntimeBase64Decode(value: string): any {
    val length: int = __ablaRuntimeStringLengthValue(value)
    if (length == 0 || (length & 3) != 0) return ""
    val input: int = __ablaRuntimeStringData(value)
    val padded2: bool = ablaRuntimeLoadU8(input + length - 2) == 61
    val padded3: bool = ablaRuntimeLoadU8(input + length - 1) == 61
    val outputLength: int = (length / 4) * 3 -
        (if (padded3) 1 else 0) - (if (padded2) 1 else 0)
    val output: int = __ablaRuntimeAllocateLayout(outputLength + 1, 1)
    var source: int = 0
    var destination: int = 0
    var valid: bool = true
    while (valid && source < length) {
        val byte2: int = ablaRuntimeLoadU8(input + source + 2)
        val byte3: int = ablaRuntimeLoadU8(input + source + 3)
        val groupPadded2: bool = byte2 == 61
        val groupPadded3: bool = byte3 == 61
        val a: int = __ablaRuntimeBase64DecodeDigit(
            ablaRuntimeLoadU8(input + source)
        )
        val b: int = __ablaRuntimeBase64DecodeDigit(
            ablaRuntimeLoadU8(input + source + 1)
        )
        val c: int = if (groupPadded2) 0
            else __ablaRuntimeBase64DecodeDigit(byte2)
        val d: int = if (groupPadded3) 0
            else __ablaRuntimeBase64DecodeDigit(byte3)
        valid = a >= 0 && b >= 0 && c >= 0 && d >= 0 &&
            (!groupPadded2 || groupPadded3) &&
            (!(groupPadded2 || groupPadded3) || source + 4 == length)
        if (valid) {
            val combined: int = (a << 18) | (b << 12) | (c << 6) | d
            ablaRuntimeStoreU8(
                output + destination, (combined >>> 16) & 255
            )
            destination = destination + 1
            if (!groupPadded2) {
                ablaRuntimeStoreU8(
                    output + destination, (combined >>> 8) & 255
                )
                destination = destination + 1
            }
            if (!groupPadded3) {
                ablaRuntimeStoreU8(output + destination, combined & 255)
                destination = destination + 1
            }
        }
        source = source + 4
    }
    if (valid && destination == outputLength) {
        ablaRuntimeStoreU8(output + outputLength, 0)
        __ablaRuntimeStringStatic(output, outputLength)
    } else {
        __ablaRuntimeFree(output)
        ""
    }
}

// Flatten immutable byte chunks into exactly one owned allocation. ByteBuffer
// remains an ordinary phase-safe Abla class; only the final contiguous storage
// operation lives at the raw-memory runtime boundary.
trusted fun __ablaRuntimeByteChunksJoin(
    chunks: array<string>,
    byteCount: int
): any {
    if (byteCount < 0) {
        ablaRuntimeTrap()
        return ""
    }
    if (byteCount == 0) return ""
    val output: int = __ablaRuntimeAllocateLayout(byteCount + 1, 1)
    var destination: int = 0
    var index: int = 0
    while (index < chunks.size) {
        val chunk: string = chunks[index]
        val length: int = __ablaRuntimeStringLengthValue(chunk)
        if (length < 0 || length > byteCount - destination) {
            ablaRuntimeTrap()
            return ""
        }
        val source: int = if (length == 0) 0
            else __ablaRuntimeStringData(chunk)
        var offset: int = 0
        while (offset < length) {
            ablaRuntimeStoreU8(
                output + destination + offset,
                ablaRuntimeLoadU8(source + offset)
            )
            offset = offset + 1
        }
        destination = destination + length
        index = index + 1
    }
    if (destination != byteCount) {
        ablaRuntimeTrap()
        return ""
    }
    ablaRuntimeStoreU8(output + byteCount, 0)
    __ablaRuntimeStringStatic(output, byteCount)
}

trusted fun __ablaRuntimeUtf8EncodeScalar(value: int): any {
    var length: int = 0
    if (value >= 0 && value <= 127) length = 1
    if (value >= 128 && value <= 2047) length = 2
    if (value >= 2048 && value <= 65535 &&
        (value < 55296 || value > 57343)) length = 3
    if (value >= 65536 && value <= 1114111) length = 4
    var result: any = ""
    if (length > 0) {
        val data = __ablaRuntimeAllocateLayout(length + 1, 1)
        if (length == 1) ablaRuntimeStoreU8(data, value)
        if (length == 2) {
            ablaRuntimeStoreU8(data, 192 | (value >> 6))
            ablaRuntimeStoreU8(data + 1, 128 | (value & 63))
        }
        if (length == 3) {
            ablaRuntimeStoreU8(data, 224 | (value >> 12))
            ablaRuntimeStoreU8(data + 1, 128 | ((value >> 6) & 63))
            ablaRuntimeStoreU8(data + 2, 128 | (value & 63))
        }
        if (length == 4) {
            ablaRuntimeStoreU8(data, 240 | (value >> 18))
            ablaRuntimeStoreU8(data + 1, 128 | ((value >> 12) & 63))
            ablaRuntimeStoreU8(data + 2, 128 | ((value >> 6) & 63))
            ablaRuntimeStoreU8(data + 3, 128 | (value & 63))
        }
        ablaRuntimeStoreU8(data + length, 0)
        result = __ablaRuntimeStringStatic(data, length)
    }
    result
}

// Arrays use the native 64-bit header layout on every target: length,
// capacity, and values pointer. This makes the runtime ABI deterministic and
// keeps the same optimized layout used by native Abla Web services.
//
// The capacity word's top byte says how the elements are stored: 0 as boxed
// 24-byte values, 1 as dense 8-byte words (numbers: tag 2), 2 as dense bools
// (tag 3). An array whose elements are all numbers or all bools is dense, a
// third of the memory; storing any other value boxes it first.
@inline
trusted fun __ablaRuntimeArrayKind(array: int): int =
    ablaRuntimeLoadI64(array + 8) >> 56

@inline
trusted fun __ablaRuntimeArrayCapacity(array: int): int =
    ablaRuntimeLoadI64(array + 8) & 72057594037927935

@inline
trusted fun __ablaRuntimeArraySetCapacity(
    array: int,
    kind: int,
    capacity: int
): void {
    ablaRuntimeStoreI64(array + 8, (kind << 56) | capacity)
}

// The dense kind the value at `address` can be stored as, or 0.
@inline
trusted fun __ablaRuntimeDenseKind(address: int): int {
    val tag = ablaRuntimeLoadI32(address)
    if ((tag == 2 || tag == 3) && ablaRuntimeLoadI32(address + 4) == 0 &&
        ablaRuntimeLoadI64(address + 16) == 0) tag - 1 else 0
}

trusted fun __ablaRuntimeArrayCreate(values: int, count: int): any {
    if (count < 0) ablaRuntimeTrap()
    var kind = if (count == 0) 0 else __ablaRuntimeDenseKind(values)
    var index: int = 1
    while (kind != 0 && index < count) {
        if (__ablaRuntimeDenseKind(values + index * 24) != kind) kind = 0
        index = index + 1
    }
    val width = if (kind == 0) 24 else 8
    val array = __ablaRuntimeAllocateLayout(24 + count * width, 4)
    val destination = if (count == 0) 0 else array + 24
    ablaRuntimeStoreI64(array, count)
    __ablaRuntimeArraySetCapacity(array, kind, count)
    ablaRuntimeStoreI64(array + 16, destination)
    index = 0
    while (index < count) {
        val source = values + index * 24
        if (kind != 0) {
            ablaRuntimeStoreI64(destination + index * 8, ablaRuntimeLoadI64(source + 8))
        } else {
            ablaRuntimeStoreI64(destination + index * 24, ablaRuntimeLoadI64(source))
            ablaRuntimeStoreI64(
                destination + index * 24 + 8,
                ablaRuntimeLoadI64(source + 8)
            )
            ablaRuntimeStoreI64(
                destination + index * 24 + 16,
                ablaRuntimeLoadI64(source + 16)
            )
        }
        index = index + 1
    }
    ablaRuntimeMakeValue(7, 0, array, 0)
}

@noinline
trusted fun __ablaRuntimePanicFilledSize(count: int): never =
    __ablaRuntimePanic("filledArray with a negative size ($count)")

@noinline
trusted fun __ablaRuntimePanicTruncateSize(requested: int): never =
    __ablaRuntimePanic("truncate to a negative size ($requested)")

// `count` copies of `element` in one allocation, laid out like a literal.
trusted fun __ablaRuntimeArrayFilled(countValue: any, element: any): any {
    val count = __ablaRuntimeAsI64(countValue)
    if (count < 0) __ablaRuntimePanicFilledSize(count)
    val source = ablaRuntimeValueAddress(element)
    val kind = if (count == 0) 0 else __ablaRuntimeDenseKind(source)
    val width = if (kind == 0) 24 else 8
    val array = __ablaRuntimeAllocateLayout(24 + count * width, 4)
    val values = if (count == 0) 0 else array + 24
    ablaRuntimeStoreI64(array, count)
    __ablaRuntimeArraySetCapacity(array, kind, count)
    ablaRuntimeStoreI64(array + 16, values)
    val word = ablaRuntimeLoadI64(source + 8)
    var index: int = 0
    while (index < count) {
        if (kind != 0) ablaRuntimeStoreI64(values + index * 8, word)
        else __ablaRuntimeCopyValue(element, values + index * 24)
        index = index + 1
    }
    ablaRuntimeMakeValue(7, 0, array, 0)
}

trusted fun __ablaRuntimeArrayAddress(value: any): int {
    val array = __ablaRuntimeWord0(value)
    if (array == 0) ablaRuntimeTrap()
    array
}

trusted fun __ablaRuntimeArrayLengthI64(value: any): int =
    ablaRuntimeLoadI64(__ablaRuntimeArrayAddress(value))

trusted fun __ablaRuntimeArrayLength(value: any): any =
    __ablaRuntimeI64(__ablaRuntimeArrayLengthI64(value))

// `index` after checking it is within the array.
trusted fun __ablaRuntimeArrayIndex(array: int, index: int): int {
    val size = ablaRuntimeLoadI64(array)
    if (index < 0 || index >= size) __ablaRuntimePanicArrayIndex(index, size)
    index
}

// Rewrites a dense array's elements as boxed values, in place of its buffer.
@noinline
trusted fun __ablaRuntimeArrayBox(array: int): void {
    val kind = __ablaRuntimeArrayKind(array)
    if (kind != 0) {
        val length = ablaRuntimeLoadI64(array)
        val capacity = __ablaRuntimeArrayCapacity(array)
        val values = ablaRuntimeLoadI64(array + 16)
        val boxed = if (capacity == 0) 0
            else __ablaRuntimeAllocateLayout(capacity * 24, 2)
        var index: int = 0
        while (index < length) {
            ablaRuntimeStoreI32(boxed + index * 24, kind + 1)
            ablaRuntimeStoreI32(boxed + index * 24 + 4, 0)
            ablaRuntimeStoreI64(
                boxed + index * 24 + 8,
                ablaRuntimeLoadI64(values + index * 8)
            )
            ablaRuntimeStoreI64(boxed + index * 24 + 16, 0)
            index = index + 1
        }
        if (values != 0 && values != array + 24) __ablaRuntimeFree(values)
        ablaRuntimeStoreI64(array + 16, boxed)
        __ablaRuntimeArraySetCapacity(array, 0, capacity)
    }
}

trusted fun __ablaRuntimeArrayAppend(value: any, element: any): any {
    val array = __ablaRuntimeArrayAddress(value)
    val length = ablaRuntimeLoadI64(array)
    val kind = __ablaRuntimeArrayKind(array)
    val source = ablaRuntimeValueAddress(element)
    // Room left and an element of the array's storage: store it here.
    if (length < __ablaRuntimeArrayCapacity(array) &&
        (kind == 0 || __ablaRuntimeDenseKind(source) == kind)) {
        val values = ablaRuntimeLoadI64(array + 16)
        if (kind != 0) {
            ablaRuntimeStoreI64(values + length * 8, ablaRuntimeLoadI64(source + 8))
        } else __ablaRuntimeCopyValue(element, values + length * 24)
        ablaRuntimeStoreI64(array, length + 1)
    } else __ablaRuntimeArrayAppendGrowing(array, element)
    __ablaRuntimeVoid()
}

// Append when the array must grow or change its storage first: a fresh array
// takes the storage of its first element; a dense one is boxed before it
// stores anything else.
@noinline
trusted fun __ablaRuntimeArrayAppendGrowing(array: int, element: any): void {
    val length = ablaRuntimeLoadI64(array)
    val source = ablaRuntimeValueAddress(element)
    val elementKind = __ablaRuntimeDenseKind(source)
    var kind = __ablaRuntimeArrayKind(array)
    var capacity = __ablaRuntimeArrayCapacity(array)
    if (kind == 0 && length == 0 && capacity == 0 && elementKind != 0) {
        kind = elementKind
        __ablaRuntimeArraySetCapacity(array, kind, 0)
    } else if (kind != 0 && elementKind != kind) {
        __ablaRuntimeArrayBox(array)
        kind = 0
    }
    val width = if (kind == 0) 24 else 8
    var values: int = ablaRuntimeLoadI64(array + 16)
    if (length == capacity) {
        val next = if (capacity == 0) 4 else capacity * 2
        val replacement = __ablaRuntimeAllocateLayout(
            next * width, if (kind == 0) 2 else 1
        )
        var offset: int = 0
        while (offset < length * width) {
            ablaRuntimeStoreI64(
                replacement + offset,
                ablaRuntimeLoadI64(values + offset)
            )
            offset = offset + 8
        }
        if (values != 0 && values != array + 24) {
            __ablaRuntimeFree(values)
        }
        values = replacement
        capacity = next
        __ablaRuntimeArraySetCapacity(array, kind, next)
        ablaRuntimeStoreI64(array + 16, values)
    }
    if (kind != 0) {
        ablaRuntimeStoreI64(values + length * 8, ablaRuntimeLoadI64(source + 8))
    } else __ablaRuntimeCopyValue(element, values + length * 24)
    ablaRuntimeStoreI64(array, length + 1)
    return
}

// Keeps the first `count` elements (all of them when `count` is at least the
// size); the slots past them are zeroed so they hold nothing, and the
// capacity stays for later appends.
trusted fun __ablaRuntimeArrayTruncate(value: any, countValue: any): any {
    val array = __ablaRuntimeArrayAddress(value)
    val length = ablaRuntimeLoadI64(array)
    val requested = __ablaRuntimeAsI64(countValue)
    if (requested < 0) __ablaRuntimePanicTruncateSize(requested)
    val count = if (requested < length) requested else length
    val values = ablaRuntimeLoadI64(array + 16)
    val width = if (__ablaRuntimeArrayKind(array) == 0) 24 else 8
    var offset = count * width
    while (offset < length * width) {
        ablaRuntimeStoreI64(values + offset, 0)
        offset = offset + 8
    }
    ablaRuntimeStoreI64(array, count)
    __ablaRuntimeVoid()
}

// Readers: the common case (in bounds, the storage the caller expects) stays
// small where it is inlined; the rest is one shared call.
trusted fun __ablaRuntimeArrayGet(value: any, indexValue: any): any {
    val array = __ablaRuntimeArrayAddress(value)
    val index = __ablaRuntimeAsI64(indexValue)
    if (__ablaRuntimeArrayKind(array) == 0 && index >= 0 &&
        index < ablaRuntimeLoadI64(array)) {
        __ablaRuntimeValueAt(ablaRuntimeLoadI64(array + 16) + index * 24)
    } else __ablaRuntimeArrayGetOther(array, index)
}

@noinline
trusted fun __ablaRuntimeArrayGetOther(array: int, index: int): any {
    val checked = __ablaRuntimeArrayIndex(array, index)
    val kind = __ablaRuntimeArrayKind(array)
    val values = ablaRuntimeLoadI64(array + 16)
    if (kind == 0) __ablaRuntimeValueAt(values + checked * 24)
    else ablaRuntimeMakeValue(kind + 1, 0, ablaRuntimeLoadI64(values + checked * 8), 0)
}

trusted fun __ablaRuntimeArrayGetI64(value: any, index: int): int {
    val array = __ablaRuntimeArrayAddress(value)
    if (__ablaRuntimeArrayKind(array) == 1 && index >= 0 &&
        index < ablaRuntimeLoadI64(array)) {
        ablaRuntimeLoadI64(ablaRuntimeLoadI64(array + 16) + index * 8)
    } else __ablaRuntimeArrayGetWordOther(array, index, 2)
}

trusted fun __ablaRuntimeArrayGetBool(value: any, index: int): bool {
    val array = __ablaRuntimeArrayAddress(value)
    if (__ablaRuntimeArrayKind(array) == 2 && index >= 0 &&
        index < ablaRuntimeLoadI64(array)) {
        ablaRuntimeLoadI64(ablaRuntimeLoadI64(array + 16) + index * 8) != 0
    } else __ablaRuntimeArrayGetWordOther(array, index, 3) != 0
}

// A boxed array's element `index` as a word of type `tag` (trapping on
// another tag or out of bounds).
@noinline
trusted fun __ablaRuntimeArrayGetWordOther(array: int, index: int, tag: int): int {
    val checked = __ablaRuntimeArrayIndex(array, index)
    val kind = __ablaRuntimeArrayKind(array)
    val values = ablaRuntimeLoadI64(array + 16)
    if (kind != 0) {
        if (kind + 1 != tag) ablaRuntimeTrap()
        ablaRuntimeLoadI64(values + checked * 8)
    } else {
        val element = values + checked * 24
        if (ablaRuntimeLoadI32(element) != tag) ablaRuntimeTrap()
        ablaRuntimeLoadI64(element + 8)
    }
}

trusted fun __ablaRuntimeIndexGet(value: any, index: any): any {
    val tag = __ablaRuntimeTag(value)
    if (tag == 4) __ablaRuntimeStringGet(value, index)
    else if (tag == 7) __ablaRuntimeArrayGet(value, index)
    else {
        ablaRuntimeTrap()
        __ablaRuntimeNull()
    }
}

trusted fun __ablaRuntimeArraySet(
    value: any,
    indexValue: any,
    element: any
): int {
    val array = __ablaRuntimeArrayAddress(value)
    val index = __ablaRuntimeAsI64(indexValue)
    val source = ablaRuntimeValueAddress(element)
    val kind = __ablaRuntimeArrayKind(array)
    val inBounds = index >= 0 && index < ablaRuntimeLoadI64(array)
    if (inBounds && kind == 0) {
        __ablaRuntimeCopyValue(element, ablaRuntimeLoadI64(array + 16) + index * 24)
    } else if (inBounds && __ablaRuntimeDenseKind(source) == kind) {
        ablaRuntimeStoreI64(
            ablaRuntimeLoadI64(array + 16) + index * 8,
            ablaRuntimeLoadI64(source + 8)
        )
    } else __ablaRuntimeArraySetOther(array, index, element)
    0
}

// Stores into a boxed array, boxing a dense one first when the value needs it.
@noinline
trusted fun __ablaRuntimeArraySetOther(array: int, index: int, element: any): void {
    val checked = __ablaRuntimeArrayIndex(array, index)
    val source = ablaRuntimeValueAddress(element)
    val kind = __ablaRuntimeArrayKind(array)
    if (kind != 0 && __ablaRuntimeDenseKind(source) == kind) {
        ablaRuntimeStoreI64(
            ablaRuntimeLoadI64(array + 16) + checked * 8,
            ablaRuntimeLoadI64(source + 8)
        )
    } else {
        if (kind != 0) __ablaRuntimeArrayBox(array)
        __ablaRuntimeCopyValue(element, ablaRuntimeLoadI64(array + 16) + checked * 24)
    }
    return
}

trusted fun __ablaRuntimeObjectCreate(typeSymbol: int, count: int): any {
    if (count < 0) ablaRuntimeTrap()
    val object = __ablaRuntimeAllocateLayout(32 + count * 32, 5)
    ablaRuntimeStoreI32(object, typeSymbol)
    ablaRuntimeStoreI64(object + 8, 0)
    ablaRuntimeStoreI64(object + 16, count)
    ablaRuntimeStoreI64(object + 24, 0)
    ablaRuntimeMakeValue(8, 0, object, 0)
}

// An instance: a header (+0 its class's symbol, +8 how many inline slots hold a
// field, +16 how many inline slots it has, +24 its overflow or 0), then its
// inline slots from +32, 32 bytes each (the field's symbol, then its value).
// The inline slots hold the declared fields, in declaration order, and never
// move: typed accesses address them at +32 + index * 32. Construction fills
// them (object.create through __ablaRuntimeFieldInitialize, the compile-time
// lift by name, in order); a compiler that reserves inline slots for extension
// fields must give them their symbols at creation too. Any other field set by
// name (an extension field) goes to the overflow, so nothing may assume where
// an extension field lives: lookups go by symbol, inline slots first.
//
// The overflow is a managed array of 32-byte slots. Its first slot is a header
// (+16 how many slots after it hold a field, +24 how many it has room for)
// tagged as an int, so the collector's walk over 32-byte slots reads it as
// one; its unused slots are zero. Growing it copies it: the new array is
// published only once whole, and the old one is left to the collector, since
// another thread may still read it.

// The address of `object`'s slot holding `symbol`, or 0.
trusted fun __ablaRuntimeFieldSlot(object: int, symbol: int): int {
    val count: int = ablaRuntimeLoadI64(object + 8)
    var index: int = 0
    while (index < count) {
        val slot: int = object + 32 + index * 32
        if (ablaRuntimeLoadI32(slot) == symbol) return slot
        index = index + 1
    }
    val overflow: int = ablaRuntimeLoadI64(object + 24)
    if (overflow == 0) return 0
    val used: int = ablaRuntimeLoadI64(overflow + 16)
    // Orders the slots read below after the count another thread published.
    if (__ablaRuntimePlatformThreadsEnabled()) ablaRuntimeFence()
    index = 1
    while (index <= used) {
        val slot: int = overflow + index * 32
        if (ablaRuntimeLoadI32(slot) == symbol) return slot
        index = index + 1
    }
    0
}

// Adds `symbol` with `fieldValue` to `object`'s overflow, growing it first
// when it is full.
@noinline
trusted fun __ablaRuntimeOverflowAdd(object: int, symbol: int, fieldValue: any): void {
    var overflow: int = ablaRuntimeLoadI64(object + 24)
    val used: int = if (overflow == 0) 0 else ablaRuntimeLoadI64(overflow + 16)
    val room: int = if (overflow == 0) 0 else ablaRuntimeLoadI64(overflow + 24)
    val threads = __ablaRuntimePlatformThreadsEnabled()
    if (used == room) {
        val next: int = if (room == 0) 2 else room * 2
        val grown: int = __ablaRuntimeAllocateLayout((next + 1) * 32, 3)
        var word: int = 0
        while (word < (next + 1) * 4) {
            ablaRuntimeStoreI64(grown + word * 8, 0)
            word = word + 1
        }
        ablaRuntimeStoreI32(grown + 8, 2)
        ablaRuntimeStoreI64(grown + 16, used)
        ablaRuntimeStoreI64(grown + 24, next)
        word = 4
        while (word < (used + 1) * 4) {
            ablaRuntimeStoreI64(grown + word * 8, ablaRuntimeLoadI64(overflow + word * 8))
            word = word + 1
        }
        if (threads) ablaRuntimeFence()
        ablaRuntimeStoreI64(object + 24, grown)
        overflow = grown
    }
    val slot: int = overflow + (used + 1) * 32
    __ablaRuntimeCopyValue(fieldValue, slot + 8)
    ablaRuntimeStoreI32(slot, symbol)
    if (threads) ablaRuntimeFence()
    ablaRuntimeStoreI64(overflow + 16, used + 1)
    return
}

// Whether `value` holds the field `symbol` (one set by name, or declared).
@noinline
trusted fun __ablaRuntimeFieldHas(value: any, symbol: int): bool =
    __ablaRuntimeFieldSlot(__ablaRuntimeObjectAddress(value), symbol) != 0

// The fields in `value`'s overflow, in the order they were set: how many, and
// the `index`-th one's symbol and value. A drop walks them backwards.
trusted fun __ablaRuntimeOverflowCount(value: any): int {
    val overflow = ablaRuntimeLoadI64(__ablaRuntimeObjectAddress(value) + 24)
    if (overflow == 0) 0 else ablaRuntimeLoadI64(overflow + 16)
}

trusted fun __ablaRuntimeOverflowSlot(value: any, index: int): int {
    val overflow = ablaRuntimeLoadI64(__ablaRuntimeObjectAddress(value) + 24)
    if (overflow == 0 || index < 0 || index >= ablaRuntimeLoadI64(overflow + 16)) {
        ablaRuntimeTrap()
    }
    overflow + (index + 1) * 32
}

trusted fun __ablaRuntimeOverflowSymbol(value: any, index: int): int =
    ablaRuntimeLoadI32(__ablaRuntimeOverflowSlot(value, index))

trusted fun __ablaRuntimeOverflowValue(value: any, index: int): any =
    __ablaRuntimeValueAt(__ablaRuntimeOverflowSlot(value, index) + 8)

// What a field never set on `value` reads: the default of the extension field
// `symbol` names. Until extension fields are declared, there is none: null.
@noinline
trusted fun __ablaRuntimeFieldDefault(value: any, symbol: int): any = __ablaRuntimeNull()

trusted fun __ablaRuntimeObjectAddress(value: any): int {
    if (!__ablaRuntimeRequire(value, 8)) 0 else __ablaRuntimeWord0(value)
}

// Not inlined: generated drops read their resource fields by name, in many
// places, and none of those reads is hot.
@noinline
trusted fun __ablaRuntimeFieldGet(value: any, symbol: int): any {
    val slot = __ablaRuntimeFieldSlot(__ablaRuntimeObjectAddress(value), symbol)
    if (slot == 0) __ablaRuntimeFieldDefault(value, symbol)
    else __ablaRuntimeValueAt(slot + 8)
}

trusted fun __ablaRuntimeFieldGetIndexed(
    value: any,
    symbol: int,
    index: int
): any {
    val address = __ablaRuntimeFieldAddressIndexed(value, index) + 8
    ablaRuntimeMakeValue(
        ablaRuntimeLoadSlotI32(address),
        ablaRuntimeLoadSlotI32(address + 4),
        ablaRuntimeLoadSlotI64(address + 8),
        ablaRuntimeLoadSlotI64(address + 16)
    )
}

// Typed IR supplies the declaration-order index for scalar class fields. Such
// fields cannot move or be added dynamically, so do not rescan their symbols
// and rebuild a universal value on every cursor/count/flag access. Nor check
// the field's tag: every field is a constructor parameter, stored (and lifted,
// and set) only from a value of its declared type, so an int, f64, f32 or
// pointer field always holds tag 2 and a bool field tag 3 before any read.
trusted fun __ablaRuntimeFieldAddressIndexed(
    value: any,
    index: int
): int {
    val object = __ablaRuntimeWord0(value)
    if (object == 0 || index < 0) ablaRuntimeTrap()
    // A class's declared fields are its inline slots, after the header, and
    // never move (__ablaRuntimeFieldSet refuses to grow such an object).
    object + 32 + index * 32
}

trusted fun __ablaRuntimeFieldGetIndexedI64(
    value: any,
    symbol: int,
    index: int
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    ablaRuntimeLoadSlotI64(field + 16)
}

trusted fun __ablaRuntimeFieldGetIndexedBool(
    value: any,
    symbol: int,
    index: int
): bool {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    ablaRuntimeLoadSlotI64(field + 16) != 0
}

// Not inlined. It addresses the inline slots directly, so inlined it would let
// LLVM follow every constructor's stores into later reads of the same
// instance: a game's client grew by 47 KB of wasm (+1.3 KB with brotli) for
// no measurable speed. Out of line, its compressed client is 2 KB smaller
// than before the overflow existed.
@noinline
trusted fun __ablaRuntimeFieldInitialize(
    value: any,
    symbol: int,
    fieldValue: any
): int {
    val object = __ablaRuntimeObjectAddress(value)
    val count = ablaRuntimeLoadI64(object + 8)
    val capacity = ablaRuntimeLoadI64(object + 16)
    if (count >= capacity) ablaRuntimeTrap()
    val field = object + 32 + count * 32
    ablaRuntimeStoreI32(field, symbol)
    __ablaRuntimeCopyValue(fieldValue, field + 8)
    ablaRuntimeStoreI64(object + 8, count + 1)
    0
}

trusted fun __ablaRuntimeFieldSet(
    value: any,
    symbol: int,
    fieldValue: any
): int {
    val object = __ablaRuntimeObjectAddress(value)
    val slot = __ablaRuntimeFieldSlot(object, symbol)
    if (slot != 0) __ablaRuntimeCopyValue(fieldValue, slot + 8)
    else {
        val count = ablaRuntimeLoadI64(object + 8)
        if (count < ablaRuntimeLoadI64(object + 16)) {
            // Still being built (the compile-time lift sets its declared
            // fields by name, in order): the next inline slot.
            val field = object + 32 + count * 32
            ablaRuntimeStoreI32(field, symbol)
            __ablaRuntimeCopyValue(fieldValue, field + 8)
            ablaRuntimeStoreI64(object + 8, count + 1)
        } else __ablaRuntimeOverflowAdd(object, symbol, fieldValue)
    }
    0
}

trusted fun __ablaRuntimeFieldSetIndexed(
    value: any,
    symbol: int,
    index: int,
    fieldValue: any
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    val source = ablaRuntimeValueAddress(fieldValue)
    ablaRuntimeStoreSlotI64(field + 8, ablaRuntimeLoadI64(source))
    ablaRuntimeStoreSlotI64(field + 16, ablaRuntimeLoadI64(source + 8))
    ablaRuntimeStoreSlotI64(field + 24, ablaRuntimeLoadI64(source + 16))
    0
}

trusted fun __ablaRuntimeFieldSetIndexedI64(
    value: any,
    symbol: int,
    index: int,
    fieldValue: int
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    ablaRuntimeStoreSlotI32(field + 8, 2)
    ablaRuntimeStoreSlotI32(field + 12, 0)
    ablaRuntimeStoreSlotI64(field + 16, fieldValue)
    ablaRuntimeStoreSlotI64(field + 24, 0)
    0
}

trusted fun __ablaRuntimeFieldSetIndexedBool(
    value: any,
    symbol: int,
    index: int,
    fieldValue: bool
): int {
    val field = __ablaRuntimeFieldAddressIndexed(value, index)
    ablaRuntimeStoreSlotI32(field + 8, 3)
    ablaRuntimeStoreSlotI32(field + 12, 0)
    ablaRuntimeStoreSlotI64(field + 16, if (fieldValue) 1 else 0)
    ablaRuntimeStoreSlotI64(field + 24, 0)
    0
}

trusted fun __ablaRuntimeJsonStringIsPlain(value: string): bool {
    val size = __ablaRuntimeStringLengthValue(value)
    val data = if (size == 0) 0 else __ablaRuntimeStringData(value)
    var offset = 0
    var plain = true
    while (plain && offset < size) {
        val lead = ablaRuntimeLoadU8(data + offset)
        if (lead == 34 || lead == 92 || lead < 32) plain = false
        else if (lead < 128) offset = offset + 1
        else {
            var count = 0
            if (lead >= 194 && lead <= 223) count = 2
            if (lead >= 224 && lead <= 239) count = 3
            if (lead >= 240 && lead <= 244) count = 4
            plain = count > 0 && offset + count <= size
            var index = 1
            while (plain && index < count) {
                val byte = ablaRuntimeLoadU8(data + offset + index)
                plain = byte >= 128 && byte <= 191
                index = index + 1
            }
            if (plain && count == 3 && lead == 224) {
                plain = ablaRuntimeLoadU8(data + offset + 1) >= 160
            }
            if (plain && count == 3 && lead == 237) {
                plain = ablaRuntimeLoadU8(data + offset + 1) <= 159
            }
            if (plain && count == 4 && lead == 240) {
                plain = ablaRuntimeLoadU8(data + offset + 1) >= 144
            }
            if (plain && count == 4 && lead == 244) {
                plain = ablaRuntimeLoadU8(data + offset + 1) <= 143
            }
            if (plain) offset = offset + count
        }
    }
    plain
}

trusted fun __ablaRuntimeJsonFindPlainStringEnd(
    value: string,
    begin: int,
    end: int
): int {
    val size = __ablaRuntimeStringLengthValue(value)
    if (begin < 0 || end < begin || end > size) return -1
    val data = if (size == 0) 0 else __ablaRuntimeStringData(value)
    var offset = begin
    var found = -1
    var plain = true
    while (plain && found < 0 && offset < end) {
        val lead = ablaRuntimeLoadU8(data + offset)
        if (lead == 34) found = offset
        else if (lead == 92 || lead < 32) plain = false
        else if (lead < 128) offset = offset + 1
        else {
            var count = 0
            if (lead >= 194 && lead <= 223) count = 2
            if (lead >= 224 && lead <= 239) count = 3
            if (lead >= 240 && lead <= 244) count = 4
            plain = count > 0 && offset + count <= end
            var index = 1
            while (plain && index < count) {
                val byte = ablaRuntimeLoadU8(data + offset + index)
                plain = byte >= 128 && byte <= 191
                index = index + 1
            }
            if (plain && count == 3 && lead == 224) {
                plain = ablaRuntimeLoadU8(data + offset + 1) >= 160
            }
            if (plain && count == 3 && lead == 237) {
                plain = ablaRuntimeLoadU8(data + offset + 1) <= 159
            }
            if (plain && count == 4 && lead == 240) {
                plain = ablaRuntimeLoadU8(data + offset + 1) >= 144
            }
            if (plain && count == 4 && lead == 244) {
                plain = ablaRuntimeLoadU8(data + offset + 1) <= 143
            }
            if (plain) offset = offset + count
        }
    }
    found
}

trusted fun __ablaRuntimeJsonMatchCompactObjectField(
    value: string,
    offset: int,
    name: string,
    comma: bool
): int {
    val size = __ablaRuntimeStringLengthValue(value)
    val nameSize = __ablaRuntimeStringLengthValue(name)
    val fixed = if (comma) 4 else 3
    var result = -1
    var valid = offset >= 0 && offset <= size &&
        size - offset >= fixed && nameSize <= size - offset - fixed
    val data = if (size == 0) 0 else __ablaRuntimeStringData(value)
    val nameData = if (nameSize == 0) 0 else __ablaRuntimeStringData(name)
    var cursor = offset
    if (valid && comma) {
        valid = ablaRuntimeLoadU8(data + cursor) == 44
        cursor = cursor + 1
    }
    if (valid) {
        valid = ablaRuntimeLoadU8(data + cursor) == 34
        cursor = cursor + 1
    }
    var index = 0
    while (valid && index < nameSize) {
        valid = ablaRuntimeLoadU8(data + cursor + index) ==
            ablaRuntimeLoadU8(nameData + index)
        index = index + 1
    }
    cursor = cursor + nameSize
    if (valid) {
        valid = ablaRuntimeLoadU8(data + cursor) == 34 &&
            ablaRuntimeLoadU8(data + cursor + 1) == 58
    }
    if (valid) result = cursor + 2
    result
}

// Fast state transition for a compact JSON array. Positive results encode the
// next value offset plus one; negative results encode the offset after an
// empty-array closing bracket. Zero asks the checked whitespace-aware reader
// to preserve its full diagnostics.
trusted fun __ablaRuntimeJsonCompactArrayNext(
    value: string,
    offset: int,
    first: bool
): int {
    val size = __ablaRuntimeStringLengthValue(value)
    if (offset < 0 || offset >= size) return 0
    val data = __ablaRuntimeStringData(value)
    var cursor = offset
    if (!first) {
        if (ablaRuntimeLoadU8(data + cursor) != 44) return 0
        cursor = cursor + 1
        if (cursor >= size) return 0
    }
    val byte = ablaRuntimeLoadU8(data + cursor)
    if (byte == 93) {
        if (!first) return 0
        return 0 - cursor - 2
    }
    if (byte == 32 || byte == 9 || byte == 10 || byte == 13) return 0
    cursor + 1
}

trusted fun __ablaRuntimeJsonAvailableIntegerEnd(
    value: string,
    begin: int
): int {
    val size = __ablaRuntimeStringLengthValue(value)
    if (begin < 0 || begin >= size) return -1
    val data = __ablaRuntimeStringData(value)
    var cursor = begin
    val negative = ablaRuntimeLoadU8(data + cursor) == 45
    if (negative) cursor = cursor + 1
    if (cursor >= size) return -1
    val digitBegin = cursor
    val first = ablaRuntimeLoadU8(data + cursor)
    if (first == 48) {
        cursor = cursor + 1
        if (cursor < size) {
            val next = ablaRuntimeLoadU8(data + cursor)
            if (next >= 48 && next <= 57) return -1
        }
    } else if (first >= 49 && first <= 57) {
        var scanning = true
        while (scanning && cursor < size) {
            val byte = ablaRuntimeLoadU8(data + cursor)
            scanning = byte >= 48 && byte <= 57
            if (scanning) cursor = cursor + 1
        }
    } else return -1
    if (cursor < size) {
        val suffix = ablaRuntimeLoadU8(data + cursor)
        if (suffix == 43 || suffix == 45 || suffix == 46 ||
            suffix == 101 || suffix == 69) return -1
    }
    val digits = cursor - digitBegin
    if (digits > 19) return -1
    if (digits < 19) return cursor
    var accumulator = 0
    var index = digitBegin
    var available = true
    while (available && index < cursor) {
        val digit = ablaRuntimeLoadU8(data + index) - 48
        if (accumulator < -922337203685477580 ||
            (accumulator == -922337203685477580 &&
             digit > (if (negative) 8 else 7))) {
            available = false
        } else accumulator = accumulator * 10 - digit
        index = index + 1
    }
    if (available) cursor else -1
}

trusted fun __ablaRuntimeJsonIntegerValueAt(
    value: string,
    begin: int,
    end: int
): int {
    val size = __ablaRuntimeStringLengthValue(value)
    if (begin < 0 || end <= begin || end > size) return 0
    val data = __ablaRuntimeStringData(value)
    val negative = ablaRuntimeLoadU8(data + begin) == 45
    var cursor = if (negative) begin + 1 else begin
    var result = 0
    while (cursor < end) {
        result = result * 10 - (ablaRuntimeLoadU8(data + cursor) - 48)
        cursor = cursor + 1
    }
    if (negative) result else 0 - result
}

trusted fun __ablaRuntimeJsonWhitespaceEnd(
    value: string,
    begin: int
): int {
    val size = __ablaRuntimeStringLengthValue(value)
    if (begin < 0 || begin > size) return begin
    val data = if (size == 0) 0 else __ablaRuntimeStringData(value)
    var cursor = begin
    var scanning = true
    while (scanning && cursor < size) {
        val byte = ablaRuntimeLoadU8(data + cursor)
        scanning = byte == 32 || byte == 9 || byte == 10 || byte == 13
        if (scanning) cursor = cursor + 1
    }
    cursor
}

// The text of a char (string interpolation): its one byte.
trusted fun __ablaRuntimeCharText(value: char): any =
    __ablaRuntimeByteEncode(i64(value))

// The decimal text of a u64 (string interpolation): one above i64's range
// is written as its tenth and its last digit.
fun __ablaRuntimeU64Text(value: u64): string {
    if (i64(value) >= 0) return "${i64(value)}"
    val ten = u64(10)
    val high = value / ten
    "${i64(high)}${i64(value - high * ten)}"
}

trusted fun __ablaRuntimeTextFindSequence(
    text: string,
    sequence: string,
    begin: int,
    end: int
): int {
    val textLength: int = __ablaRuntimeStringLengthValue(text)
    val sequenceLength: int = __ablaRuntimeStringLengthValue(sequence)
    if (begin < 0 || end < begin || end > textLength) return -1
    if (sequenceLength == 0) return begin
    if (sequenceLength > end - begin) return -1

    val textData: int = __ablaRuntimeStringData(text)
    val sequenceData: int = __ablaRuntimeStringData(sequence)
    val first: int = ablaRuntimeLoadU8(sequenceData)
    val last: int = end - sequenceLength
    var index: int = begin

    if (sequenceLength == 1) {
        while (index <= last) {
            if (ablaRuntimeLoadU8(textData + index) == first) return index
            index = index + 1
        }
        return -1
    }

    if (sequenceLength == 2) {
        val second: int = ablaRuntimeLoadU8(sequenceData + 1)
        while (index <= last) {
            if (ablaRuntimeLoadU8(textData + index) == first &&
                ablaRuntimeLoadU8(textData + index + 1) == second) return index
            index = index + 1
        }
        return -1
    }

    if (sequenceLength == 4) {
        val second: int = ablaRuntimeLoadU8(sequenceData + 1)
        val third: int = ablaRuntimeLoadU8(sequenceData + 2)
        val fourth: int = ablaRuntimeLoadU8(sequenceData + 3)
        while (index <= last) {
            if (ablaRuntimeLoadU8(textData + index) == first &&
                ablaRuntimeLoadU8(textData + index + 1) == second &&
                ablaRuntimeLoadU8(textData + index + 2) == third &&
                ablaRuntimeLoadU8(textData + index + 3) == fourth) return index
            index = index + 1
        }
        return -1
    }

    while (index <= last) {
        if (ablaRuntimeLoadU8(textData + index) == first) {
            var equal: bool = true
            var offset: int = 1
            while (equal && offset < sequenceLength) {
                equal = ablaRuntimeLoadU8(textData + index + offset) ==
                    ablaRuntimeLoadU8(sequenceData + offset)
                offset = offset + 1
            }
            if (equal) return index
        }
        index = index + 1
    }
    -1
}

trusted fun __ablaRuntimeTextFindByte(
    text: string,
    byte: int,
    begin: int,
    end: int
): int {
    val textLength: int = __ablaRuntimeStringLengthValue(text)
    if (byte < 0 || byte > 255 || begin < 0 || end < begin ||
        end > textLength) return -1
    if (begin == end) return -1
    val data: int = __ablaRuntimeStringData(text)
    var index: int = begin
    while (index < end) {
        if (ablaRuntimeLoadU8(data + index) == byte) return index
        index = index + 1
    }
    -1
}

trusted fun __ablaRuntimeTextAsciiEqualInsensitive(
    left: string,
    right: string
): bool {
    val leftLength: int = __ablaRuntimeStringLengthValue(left)
    val rightLength: int = __ablaRuntimeStringLengthValue(right)
    val leftData: int = if (leftLength == 0) 0
        else __ablaRuntimeStringData(left)
    val rightData: int = if (rightLength == 0) 0
        else __ablaRuntimeStringData(right)
    var equal: bool = leftLength == rightLength
    if (equal && leftLength > 0) {
        var leftLast: int = ablaRuntimeLoadU8(leftData + leftLength - 1)
        var rightLast: int = ablaRuntimeLoadU8(rightData + rightLength - 1)
        if (leftLast >= 65 && leftLast <= 90) leftLast = leftLast + 32
        if (rightLast >= 65 && rightLast <= 90) rightLast = rightLast + 32
        equal = leftLast == rightLast
    }
    if (equal && leftLength > 1) {
        var leftPrevious: int = ablaRuntimeLoadU8(
            leftData + leftLength - 2
        )
        var rightPrevious: int = ablaRuntimeLoadU8(
            rightData + rightLength - 2
        )
        if (leftPrevious >= 65 && leftPrevious <= 90) {
            leftPrevious = leftPrevious + 32
        }
        if (rightPrevious >= 65 && rightPrevious <= 90) {
            rightPrevious = rightPrevious + 32
        }
        equal = leftPrevious == rightPrevious
    }
    val comparisonLength = if (leftLength > 1) leftLength - 2 else 0
    var index: int = 0
    while (equal && index < comparisonLength) {
        var leftByte: int = ablaRuntimeLoadU8(leftData + index)
        var rightByte: int = ablaRuntimeLoadU8(rightData + index)
        if (leftByte >= 65 && leftByte <= 90) leftByte = leftByte + 32
        if (rightByte >= 65 && rightByte <= 90) rightByte = rightByte + 32
        equal = leftByte == rightByte
        index = index + 1
    }
    equal
}

trusted fun __ablaRuntimeTextReadU32LittleEndian(
    text: string,
    offset: int
): int {
    var result: int = -1
    val length: int = __ablaRuntimeStringLengthValue(text)
    if (offset >= 0 && offset + 4 <= length) {
        val data: int = __ablaRuntimeStringData(text) + offset
        result = ablaRuntimeLoadU8(data) |
            (ablaRuntimeLoadU8(data + 1) << 8) |
            (ablaRuntimeLoadU8(data + 2) << 16) |
            (ablaRuntimeLoadU8(data + 3) << 24)
    }
    result
}

trusted fun __ablaRuntimeTextIsValidUtf8(text: string): bool {
    var valid: bool = true
    val length: int = __ablaRuntimeStringLengthValue(text)
    val data: int = if (length == 0) 0 else __ablaRuntimeStringData(text)
    var offset: int = 0
    while (valid && offset < length) {
        val lead: int = ablaRuntimeLoadU8(data + offset)
        if (lead < 128) {
            offset = offset + 1
            // ASCII is already valid UTF-8. Skip aligned full words without
            // reading beyond the string; the mask is endian-independent.
            if (((data + offset) & 7) == 0) {
                var ascii = true
                while (ascii && offset + 8 <= length) {
                    val word = ablaRuntimeLoadI64(data + offset)
                    ascii = (word & -9187201950435737472) == 0
                    if (ascii) offset = offset + 8
                }
            }
        } else {
            var count: int = 0
            if (lead >= 194 && lead <= 223) count = 2
            if (lead >= 224 && lead <= 239) count = 3
            if (lead >= 240 && lead <= 244) count = 4
            valid = count > 0 && offset + count <= length
            var index: int = 1
            while (valid && index < count) {
                val byte: int = ablaRuntimeLoadU8(data + offset + index)
                valid = byte >= 128 && byte <= 191
                index = index + 1
            }
            if (valid && count == 3 && lead == 224) {
                valid = ablaRuntimeLoadU8(data + offset + 1) >= 160
            }
            if (valid && count == 3 && lead == 237) {
                valid = ablaRuntimeLoadU8(data + offset + 1) <= 159
            }
            if (valid && count == 4 && lead == 240) {
                valid = ablaRuntimeLoadU8(data + offset + 1) >= 144
            }
            if (valid && count == 4 && lead == 244) {
                valid = ablaRuntimeLoadU8(data + offset + 1) <= 143
            }
            if (valid) offset = offset + count
        }
    }
    valid
}
