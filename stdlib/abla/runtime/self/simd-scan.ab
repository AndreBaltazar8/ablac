// public: none
// Portable scanner hooks leave the entire range for the scalar loop.
// Native x86-64 builds choose simd-scan-x86.ab for this runtime import.

/** Returns the starting offset so the scalar loop scans the entire JSON range. */
@inline trusted fun __ablaRuntimeScanJsonAscii(data: int, begin: int, end: int): int = begin

/** Returns the bitwise complement of the starting offset so the scalar loop searches all candidate positions. */
@inline trusted fun __ablaRuntimeScanSequence(data: int, sequence: int, begin: int, last: int, size: int): int = ~begin

/** Returns the bitwise complement of the starting offset so the scalar loop searches the entire byte range. */
@inline trusted fun __ablaRuntimeScanByte(data: int, byte: int, begin: int, end: int): int = ~begin

/** Returns zero so the scalar validator starts at the first byte. */
@inline trusted fun __ablaRuntimeScanAscii(data: int, length: int): int = 0

/** Returns zero consumed input bytes, leaving the entire range to scalar encoding. */
@inline trusted fun __ablaRuntimeScanBase64Encode(input: int, output: int, length: int): int = 0

/** Returns zero consumed input bytes, leaving the entire range to scalar decoding. */
@inline trusted fun __ablaRuntimeScanBase64Decode(input: int, output: int, length: int, outputLength: int): int = 0
