trusted noescape extern:"intrinsic" fun ablaRuntimeValueAddress(
    value: any
): int

// Read this value's own payload directly so LLVM can eliminate temporary
// boxes without changing the semantics of arbitrary raw pointer arithmetic.
trusted noescape extern:"intrinsic" fun ablaRuntimeValueWord0(value: any): int

trusted noescape extern:"intrinsic" fun ablaRuntimeLoadI32(address: int): int

trusted noescape extern:"intrinsic" fun ablaRuntimeLoadI64(address: int): int

trusted noescape extern:"intrinsic" fun ablaRuntimeTrap(): void

@inline
trusted fun __ablaRuntimeTag(value: any): int =
    ablaRuntimeLoadI32(ablaRuntimeValueAddress(value))

// A bootstrap step: read the payload through the address, as compilers from before
// ablaRuntimeValueWord0 can, so they build this compiler (which knows the intrinsic).
@inline
trusted fun __ablaRuntimeWord0(value: any): int =
    ablaRuntimeLoadI64(ablaRuntimeValueAddress(value) + 8)

@inline
trusted fun __ablaRuntimeRequire(value: any, tag: int): bool {
    val valid = __ablaRuntimeTag(value) == tag
    if (!valid) ablaRuntimeTrap()
    valid
}

@inline
trusted fun __ablaRuntimeAsI64(value: any): int {
    __ablaRuntimeRequire(value, 2)
    __ablaRuntimeWord0(value)
}

@inline
trusted fun __ablaRuntimeAsBool(value: any): bool {
    __ablaRuntimeRequire(value, 3)
    __ablaRuntimeWord0(value) != 0
}

// Allocation-free value constructors, shared by hosted and freestanding
// programs. Keeping their bodies visible lets LLVM eliminate unused boxes.
trusted noescape extern:"intrinsic" fun ablaRuntimeMakeValue(
    tag: int,
    auxiliary: int,
    word0: int,
    word1: int
): any

trusted fun __ablaRuntimeVoid(): any =
    ablaRuntimeMakeValue(0, 0, 0, 0)

trusted fun __ablaRuntimeNull(): any =
    ablaRuntimeMakeValue(1, 0, 0, 0)

@inline
trusted fun __ablaRuntimeI64(value: int): any =
    ablaRuntimeMakeValue(2, 0, value, 0)

@inline
trusted fun __ablaRuntimeBool(value: bool): any =
    ablaRuntimeMakeValue(3, 0, if (value) 1 else 0, 0)
