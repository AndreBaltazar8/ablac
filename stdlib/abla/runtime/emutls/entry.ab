// Emulated thread-local storage over the Abla runtime, with no libc and no pthread key (#826).
//
// LLVM lowers a thread-local of JIT-compiled code to a call of `__emutls_get_address(&control)` where the target has no
// native TLS for the JIT (ORC without a MachOPlatform on macOS: `ablac run`). compiler-rt's version of that function
// brings in libSystem's malloc, free, realloc, pthread mutexes and pthread keys; this one needs only the Abla heap and
// atomics, and the compiler's own native thread-local (a Mach-O TLV, whose bootstrap the compiler already imports).
//
// The control block is the ABI's, four words:  +0 size, +8 alignment, +16 index (0 until the first use), +24 the initial
// value (null: zeroes). A control gets its index (1, 2, ...) from one process-wide counter by a compare-and-swap, so
// concurrent first uses agree on it. Each thread has one table: a word with its capacity, then one word per index with
// the address of that thread's copy of the variable (0 before its first use). A table grows by being copied into a larger
// one that only its own thread sees; a variable's storage is allocated from the Abla heap on first use and aligned as the
// control asks.
//
// A thread's table and variables are freed when the thread ends, by one of three ends. The first table a thread makes sets
// the runtime's thread-end hook (abla/runtime/self: `__ablaRuntimeSetThreadEndHook`), which every Abla thread calls last,
// to `emutlsThreadEnd`. A program's own runtime has its own hook: a JIT-compiled program (`ablac run`) is given the
// compiler's `emutlsThreadEnd` by the compiler (abla/llvm/orc: llvmOrcInstallThreadEnd). A thread the runtime did not
// start (a pthread of a host that calls an exported function, a thread of LLVM's or of the compiler's own) never reaches
// that hook (#826):
//  - On macOS each table such a thread makes is also stored as the value under one pthread key whose destructor frees its
//    argument (`emutlsKeyDestroy`), and the system runs it as the thread ends. The hook clears the value when it frees the
//    table first, so either end frees a table once; a table made after the hook (a thread's last frees may use a
//    thread-local) is stored again by its first use. The table comes from the value: the thread's own cell is a thread-local
//    that the system may have ended before the destructor runs.
//    The two pthread calls are libSystem's, always there on macOS, and the only imports this module has;
//    tools/libc-imports-allowlist.txt (#806, Abla without libc) allows the Linux compiler no new libc import.
//  - Elsewhere (Linux, with system calls only) each thread's first table is entered in a registry with the thread's id,
//    and a later registration looks for the threads that have gone: tgkill(pid, id, 0) answers ESRCH for a thread that
//    has ended, and its table and variables are freed by the thread that found it. That is lazy: the registry is swept when
//    the number of entries reaches twice what the last sweep left (at least 8), so at most that many ended threads' tables
//    wait; `emutlsReclaim` sweeps at once (a library may call it, from an export, when it is idle). An id that a new
//    thread was given again is no hiding place: a record whose id is the registering thread's own belongs to a thread
//    that has ended, since a live thread has an id of its own. The thread-end hook takes its own entry out.
import "abla/runtime/scalar"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "abla/unsafe/memory/raw"

private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool
private trusted noescape extern:"intrinsic" fun ablaDarwinSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int
private trusted noescape extern:"intrinsic" fun ablaLinuxSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int
private noescape extern:"c" fun pthread_key_create(key: i64, destructor: i64): i32
private noescape extern:"c" fun pthread_setspecific(key: i64, value: i64): i32

private @runtimeImplementation trusted fun emutlsCounterAddress(): int = nativeStaticAllocate(8)

// 0: no key yet; -1: being created; key + 1 once there.
private @runtimeImplementation trusted fun emutlsKeyCell(): int = nativeStaticAllocate(8)

private @runtimeImplementation trusted fun emutlsKeyScratch(): int = nativeStaticAllocate(8)

// The registry of the threads that have a table (everywhere but macOS): +0 its lock, +8 the newest record, +16 how many
// records, +24 the count at which the next registration sweeps. A record: +0 the next, +8 the previous, +16 the thread's
// id, +24 its table (kept current when the table grows).
private @runtimeImplementation trusted fun emutlsRegistry(): int = nativeStaticAllocate(32)

// This thread's record (24 bytes of its own, not to be shared with another cell of the same text).
private @runtimeImplementation trusted fun emutlsRecordCell(): int =
    nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

// Internal thread-local bytes, like the runtime's own per-thread cells: an exported thread-local would keep ELF's `__tls_get_addr`
// in the compiler's imports, where an internal one is relaxed to a direct access.
private @runtimeImplementation trusted fun emutlsTableCellAddress(): int = nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00")

// The three ways this module traps, each in a function of its own (never inlined) that says which one on standard error first
// (the trap alone is a SIGILL and no word: macOS Intel CI, foreign-thread test, 2026-11-19). `code` is the failing call's result.
private @runtimeImplementation trusted fun emutlsSay(message: int, length: int, code: int): void {
    val digits = emutlsKeyScratch()
    var remaining = if (code < 0) 0 - code else code
    var count = 0
    // The code's decimal digits, at most four, after the message (the scratch word holds them: this thread is going to trap).
    ablaRuntimeStoreI64(digits, 0)
    ablaRuntimeStoreU8(digits + 7, 10)
    while (count < 4 && (remaining > 0 || count == 0)) {
        ablaRuntimeStoreU8(digits + 3 - count, 48 + remaining % 10)
        remaining = remaining / 10
        count = count + 1
    }
    if (ablaHostIsMacOS()) {
        ablaDarwinSyscall(4, 2, message, length, 0, 0, 0)
        ablaDarwinSyscall(4, 2, digits + 4 - count, count, 0, 0, 0)
        ablaDarwinSyscall(4, 2, digits + 7, 1, 0, 0, 0)
    } else {
        ablaLinuxSyscall(1, 2, message, length, 0, 0, 0)
        ablaLinuxSyscall(1, 2, digits + 4 - count, count, 0, 0, 0)
        ablaLinuxSyscall(1, 2, digits + 7, 1, 0, 0, 0)
    }
    return
}

private @noinline @runtimeImplementation trusted fun emutlsTrapKeyCreate(code: int): void {
    emutlsSay(__ablaRuntimeWord0("emutls trap: pthread_key_create returned "), 41, code)
    ablaRuntimeTrap()
    return
}

private @noinline @runtimeImplementation trusted fun emutlsTrapAllocate(): void {
    emutlsSay(__ablaRuntimeWord0("emutls trap: no memory for a table or a variable "), 49, 0)
    ablaRuntimeTrap()
    return
}

private @noinline @runtimeImplementation trusted fun emutlsTrapSetSpecific(code: int): void {
    emutlsSay(__ablaRuntimeWord0("emutls trap: pthread_setspecific returned "), 42, code)
    ablaRuntimeTrap()
    return
}

// The thread-specific key whose destructor ends a thread's table, made by the first caller; the others wait for it (a few
// instructions).
private @runtimeImplementation trusted fun emutlsKey(): int {
    val cell = emutlsKeyCell()
    var state = ablaRuntimeAtomicLoadI64(cell)
    if (state == 0) {
        if (ablaRuntimeAtomicCompareExchangeI64(cell, 0, -1) == 0) {
            val scratch = emutlsKeyScratch()
            val created = pthread_key_create(scratch, nativeFunctionAddress(emutlsKeyDestroy))
            if (created != 0) emutlsTrapKeyCreate(created)
            ablaRuntimeAtomicStoreI64(cell, ablaRuntimeLoadI64(scratch) + 1)
        }
        state = ablaRuntimeAtomicLoadI64(cell)
        while (state <= 0) state = ablaRuntimeAtomicLoadI64(cell)
    }
    state - 1
}

// Runs as a thread that used a thread-local ends, with the key's value: the thread's table (the system clears the value
// first, so it runs once per table; the runtime's thread-end hook clears it too, when it frees the table first). The table
// comes from the value and not from the thread's own cell: that cell is a Mach-O thread-local, and the system may have ended
// those already by the time a key's destructor runs. The cell is emptied as well, so a later use in this thread (another
// destructor's) makes a new table instead of using this one.
private @runtimeImplementation trusted fun emutlsKeyDestroy(value: int): void {
    if (value == 0) return
    ablaRuntimeStoreI64(emutlsTableCellAddress(), 0)
    emutlsFreeTable(value)
    return
}

private @runtimeImplementation trusted fun emutlsAllocate(size: int): int {
    val address = ablaRuntimePointerAddress(ablaUnsafeAllocate(size))
    if (address == 0) emutlsTrapAllocate()
    address
}

// A zeroed table of `capacity` slots, with `old` (its capacity `oldCapacity`) copied in.
private @runtimeImplementation trusted fun emutlsGrow(old: int, oldCapacity: int, needed: int): int {
    var capacity = if (oldCapacity < 8) 8 else oldCapacity * 2
    if (capacity < needed) capacity = needed
    val table = emutlsAllocate(8 * (1 + capacity))
    ablaUnsafeSetMemory(nativePointerFromAddress(table), 0, 8 * (1 + capacity))
    if (old != 0) ablaUnsafeCopyMemory(table + 8, old + 8, 8 * oldCapacity)
    ablaRuntimeStoreI64(table, capacity)
    if (old != 0) ablaUnsafeFree(nativePointerFromAddress(old))
    table
}

private @runtimeImplementation trusted fun emutlsMakeCopy(control: int): int {
    val size = ablaRuntimeLoadI64(control)
    var alignment = ablaRuntimeLoadI64(control + 8)
    // The ABI's alignment is a power of two; anything else (or nothing) gets a word's.
    if (alignment < 8 || (alignment & (alignment - 1)) != 0) alignment = 8
    val length = if (size < 1) 1 else size
    // The block's base is kept in the word before the copy, to free it.
    val base = emutlsAllocate(length + alignment + 8)
    val address = (base + 8 + alignment - 1) & (0 - alignment)
    ablaRuntimeStoreI64(address - 8, base)
    val initial = ablaRuntimeLoadI64(control + 24)
    if (initial != 0 && size > 0) ablaUnsafeCopyMemory(address, initial, size)
    else ablaUnsafeSetMemory(nativePointerFromAddress(address), 0, length)
    address
}

private @runtimeImplementation trusted fun emutlsLock(): void {
    val lock = emutlsRegistry()
    while (ablaRuntimeAtomicCompareExchangeI64(lock, 0, 1) != 0) {}
    return
}

private @runtimeImplementation trusted fun emutlsUnlock(): void {
    ablaRuntimeAtomicStoreI64(emutlsRegistry(), 0)
    return
}

// A table's variables and the table.
private @runtimeImplementation trusted fun emutlsFreeTable(table: int): void {
    val capacity = ablaRuntimeLoadI64(table)
    var index = 1
    while (index <= capacity) {
        val address = ablaRuntimeLoadI64(table + 8 * index)
        if (address != 0) ablaUnsafeFree(nativePointerFromAddress(ablaRuntimeLoadI64(address - 8)))
        index = index + 1
    }
    ablaUnsafeFree(nativePointerFromAddress(table))
    return
}

// Takes `record` out of the registry (the lock held).
private @runtimeImplementation trusted fun emutlsUnlink(record: int): void {
    val registry = emutlsRegistry()
    val next = ablaRuntimeLoadI64(record)
    val previous = ablaRuntimeLoadI64(record + 8)
    if (previous == 0) ablaRuntimeStoreI64(registry + 8, next) else ablaRuntimeStoreI64(previous, next)
    if (next != 0) ablaRuntimeStoreI64(next + 8, previous)
    ablaRuntimeStoreI64(registry + 16, ablaRuntimeLoadI64(registry + 16) - 1)
    return
}

// Moves the records of threads that have ended off the registry onto a chain (the lock held): those of the thread id
// `id` when it is not 0 (a live thread has an id of its own), and, when `full`, those whose thread tgkill says is gone
// (ESRCH, -3). `keep` stays. Returns the chain's head (linked by +0).
private @runtimeImplementation trusted fun emutlsCollectEnded(keep: int, id: int, full: bool): int {
    val registry = emutlsRegistry()
    val process = if (full) ablaLinuxSyscall(39, 0, 0, 0, 0, 0, 0) else 0
    var chain = 0
    var record = ablaRuntimeLoadI64(registry + 8)
    while (record != 0) {
        val next = ablaRuntimeLoadI64(record)
        if (record != keep) {
            val owner = ablaRuntimeLoadI64(record + 16)
            if ((id != 0 && owner == id) || (full && ablaLinuxSyscall(234, process, owner, 0, 0, 0, 0) == -3)) {
                emutlsUnlink(record)
                ablaRuntimeStoreI64(record, chain)
                chain = record
            }
        }
        record = next
    }
    chain
}

// Frees what the chain of ended threads' records holds, and the records (the lock not held).
private @runtimeImplementation trusted fun emutlsFreeEnded(chain: int): int {
    var freed = 0
    var record = chain
    while (record != 0) {
        val next = ablaRuntimeLoadI64(record)
        val table = ablaRuntimeLoadI64(record + 24)
        if (table != 0) emutlsFreeTable(table)
        ablaUnsafeFree(nativePointerFromAddress(record))
        freed = freed + 1
        record = next
    }
    freed
}

// The calling thread's first table: it is entered in the registry, and the registry is swept when it has grown enough.
private @runtimeImplementation trusted fun emutlsRegister(table: int): void {
    val record = emutlsAllocate(32)
    val id = ablaLinuxSyscall(186, 0, 0, 0, 0, 0, 0)
    ablaRuntimeStoreI64(record + 16, id)
    ablaRuntimeStoreI64(record + 24, table)
    ablaRuntimeStoreI64(emutlsRecordCell(), record)
    val registry = emutlsRegistry()
    emutlsLock()
    // A record with this thread's id is from a thread that has ended: it is known without asking the system.
    var chain = emutlsCollectEnded(0, id, false)
    val head = ablaRuntimeLoadI64(registry + 8)
    ablaRuntimeStoreI64(record, head)
    ablaRuntimeStoreI64(record + 8, 0)
    if (head != 0) ablaRuntimeStoreI64(head + 8, record)
    ablaRuntimeStoreI64(registry + 8, record)
    val count = ablaRuntimeLoadI64(registry + 16) + 1
    ablaRuntimeStoreI64(registry + 16, count)
    if (count >= ablaRuntimeLoadI64(registry + 24)) {
        val swept = emutlsCollectEnded(record, 0, true)
        var last = swept
        while (last != 0 && ablaRuntimeLoadI64(last) != 0) last = ablaRuntimeLoadI64(last)
        if (last != 0) {
            ablaRuntimeStoreI64(last, chain)
            chain = swept
        }
        val left = ablaRuntimeLoadI64(registry + 16)
        ablaRuntimeStoreI64(registry + 24, if (left * 2 < 8) 8 else left * 2)
    }
    emutlsUnlock()
    emutlsFreeEnded(chain)
    return
}

// Sweeps the registry now: the tables and variables of the threads that have ended and left them behind are freed. Returns
// how many threads' were. (On macOS the pthread key frees them as the threads end: nothing is ever found.)
@runtimeImplementation
trusted fun emutlsReclaim(): int {
    if (ablaHostIsMacOS()) return 0
    val registry = emutlsRegistry()
    emutlsLock()
    val chain = emutlsCollectEnded(0, 0, true)
    val left = ablaRuntimeLoadI64(registry + 16)
    ablaRuntimeStoreI64(registry + 24, if (left * 2 < 8) 8 else left * 2)
    emutlsUnlock()
    emutlsFreeEnded(chain)
}

// The address of the calling thread's copy of the variable `control` describes.
@runtimeImplementation
trusted fun emutlsGetAddress(control: int): int {
    var index = ablaRuntimeAtomicLoadI64(control + 16)
    if (index == 0) {
        val assigned = ablaRuntimeAtomicFetchAddI64(emutlsCounterAddress(), 1) + 1
        val seen = ablaRuntimeAtomicCompareExchangeI64(control + 16, 0, assigned)
        index = if (seen == 0) assigned else seen
    }
    val cell = emutlsTableCellAddress()
    var table = ablaRuntimeLoadI64(cell)
    val first = table == 0
    if (first) {
        __ablaRuntimeSetThreadEndHook(nativeFunctionAddress(emutlsThreadEnd))
    }
    val capacity = if (first) 0 else ablaRuntimeLoadI64(table)
    if (index > capacity) {
        table = emutlsGrow(table, capacity, index)
        ablaRuntimeStoreI64(cell, table)
        // The table is the key's value, so the destructor that runs as the thread ends frees this one (a grown table replaces
        // the old value).
        if (ablaHostIsMacOS()) {
            val stored = pthread_setspecific(emutlsKey(), table)
            if (stored != 0) emutlsTrapSetSpecific(stored)
        }
        if (first) {
            if (!ablaHostIsMacOS()) emutlsRegister(table)
        } else if (!ablaHostIsMacOS()) {
            val record = ablaRuntimeLoadI64(emutlsRecordCell())
            if (record != 0) ablaRuntimeStoreI64(record + 24, table)
        }
    }
    val slot = table + 8 * index
    var address = ablaRuntimeLoadI64(slot)
    if (address == 0) {
        address = emutlsMakeCopy(control)
        ablaRuntimeStoreI64(slot, address)
    }
    address
}

// The thread is ending: its variables and its table are freed, and the cell is empty (a later use makes a new table).
@runtimeImplementation
trusted fun emutlsThreadEnd(): void {
    val cell = emutlsTableCellAddress()
    val table = ablaRuntimeLoadI64(cell)
    if (table == 0) return
    ablaRuntimeStoreI64(cell, 0)
    // The key's destructor must not free the table a second time.
    if (ablaHostIsMacOS()) pthread_setspecific(emutlsKey(), 0)
    // Out of the registry first: a sweep must not find this thread's table freed twice.
    if (!ablaHostIsMacOS()) {
        val record = ablaRuntimeLoadI64(emutlsRecordCell())
        if (record != 0) {
            ablaRuntimeStoreI64(emutlsRecordCell(), 0)
            emutlsLock()
            emutlsUnlink(record)
            emutlsUnlock()
            ablaUnsafeFree(nativePointerFromAddress(record))
        }
    }
    emutlsFreeTable(table)
    return
}

// How many indexes have been handed out, process-wide (the counter itself).
@runtimeImplementation
trusted fun emutlsIndexCount(): int = ablaRuntimeAtomicLoadI64(emutlsCounterAddress())
