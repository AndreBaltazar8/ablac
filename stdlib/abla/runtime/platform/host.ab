            if ((header & 2) != 0 || (block & 15) != 0 || t < 32) return 2
            if ((ablaRuntimeLoadI64(block + t - 8) & 1) == 0) return 3
            parked = parked + t
            block = ablaRuntimeLoadI64(block)
        }
        sizeClass = sizeClass + 1
    }
    if (parked != __ablaRuntimeHostHeapParked) return 4
    var binned = 0
    var bin = 0
    while (bin < __ablaRuntimeHostHeapBins) {
        var block = ablaRuntimeLoadI64(state + 960 + bin * 8)
        val bit = (ablaRuntimeLoadI64(state + 1928 + (bin >> 6) * 8) >>> (bin & 63)) & 1
