    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(context + 48)))
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(context + 56)))
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(context + 64)))
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(__ablaRuntimeHostCollectionRanges))
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(__ablaRuntimeHostCollectionPages))
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(__ablaRuntimeHostCollectionBitmaps))
    __ablaRuntimeHostCollectionPages = 0
    __ablaRuntimeHostCollectionPageMask = 0
    __ablaRuntimeHostCollectionBitmaps = 0
    __ablaRuntimeHostCollectionLargeCount = 0
    __ablaRuntimeHostCollectionRanges = 0
    __ablaRuntimeHostCollectionMinimum = 0
    __ablaRuntimeHostCollectionMaximum = 0
    return
}

// The value stays rooted while the freeze waits for a stop (it may park behind another thread's collection, which would
// otherwise free what the caller's temporary holds).
trusted fun __ablaRuntimePlatformMemoryFreeze(value: any): any {
    val frame = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(32))
    if (frame == 0) return __ablaRuntimeHostFreezeBody(value)
    ablaRuntimeStoreI64(frame + 24, ablaRuntimeValueAddress(value))
    __ablaRuntimeRootsPush(frame, frame + 24, 1)
    val result = __ablaRuntimeHostFreezeBody(value)
    __ablaRuntimeRootsPop(frame)
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(frame))
    result
}

// The value, frozen: a copy of everything it reaches in a read-only group, or the value itself when it cannot be (no window
