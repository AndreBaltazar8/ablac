// bootstrapLlvmDefineStmInvoke): one attempt of a transaction's body.
trusted noescape extern:"c" fun abla_stm_invoke(
    closure: i64*,
    output: i64*,
    slot: i64*
): int

// Bytes reserved for one pthread_mutex_t: 40 on Linux, 64 on Darwin. Every
// runtime mutex slot (the heap lock, Shared/Mutex control blocks) is sized from
// this; init/lock/unlock write the whole native struct. On x86-64 Linux the
// slot's first eight bytes are a futex word instead (__ablaRuntimeFutexLock).
@inline
trusted fun __ablaRuntimePlatformMutexBytes(): int = 64

// Private, as abla/sys/linux/fs declares it: a program that imports this
// module and abla/platform/host must not see two (and the cross-target
// merge, bootstrapCtSameIntrinsic, takes them as one).
private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool
private noescape extern:"intrinsic" fun ablaHostIsIOS(): bool
private noescape extern:"intrinsic" fun ablaHostOwnsRuntime(): bool

// x86-64 Linux locks and waits on futexes, not libpthread (#806). Each
// function below tests `ablaHostOwnsRuntime()`
// itself: both are constants, so even a --fast build keeps one side only and
// imports no pthread lock (a helper function, not inlined at --fast, would
// keep both). The atomics are the runtime's own (runtime/self/entry.ab):
// declaring them again here made a program that imports both modules see
// each twice.

// futex(2) on the low 32 bits of an 8-byte word, private to the process:
// FUTEX_WAIT_PRIVATE sleeps while the word still holds `expected`, and
// FUTEX_WAKE_PRIVATE wakes up to `count` sleepers. An early return (EAGAIN,
// EINTR) is fine: every caller looks at the word again.
trusted fun __ablaRuntimeFutexWait(address: int, expected: int): void {
    ablaLinuxSyscall(202, address, 128, expected & 4294967295, 0, 0, 0)
    return
}

trusted fun __ablaRuntimeFutexWake(address: int, count: int): void {
    ablaLinuxSyscall(202, address, 129, count, 0, 0, 0)
    return
}

trusted fun __ablaRuntimeFutexExchange(address: int, value: int): int {
    var seen = ablaRuntimeAtomicLoadI64(address)
    while (true) {
        val observed = ablaRuntimeAtomicCompareExchangeI64(address, seen, value)
        if (observed == seen) return seen
        seen = observed
    }
    seen
}

// A mutex of one word: 0 free, 1 held, 2 held and maybe waited for (Drepper,
// "Futexes Are Tricky", mutex 2). Not recursive, like the default
// pthread_mutex_t it replaces. The atomics are sequentially consistent, so
// lock acquires and unlock releases.
trusted fun __ablaRuntimeFutexLock(address: int): void {
    var state = ablaRuntimeAtomicCompareExchangeI64(address, 0, 1)
    if (state == 0) return
    // Contended: in a forked child that is a holder that did not survive (#812), and the repair frees what it held.
    __ablaRuntimeHostForkCheck()
    state = ablaRuntimeAtomicCompareExchangeI64(address, 0, 1)
    if (state == 0) return
    if (state != 2) state = __ablaRuntimeFutexExchange(address, 2)
    while (state != 0) {
        __ablaRuntimeFutexWait(address, 2)
        state = __ablaRuntimeFutexExchange(address, 2)
    }
    return
}

trusted fun __ablaRuntimeFutexUnlock(address: int): void {
    if (ablaRuntimeAtomicFetchAddI64(address, -1) != 1) {
        ablaRuntimeAtomicStoreI64(address, 0)
        __ablaRuntimeFutexWake(address, 1)
    }
    return
}

trusted fun __ablaRuntimePlatformMutexInitialize(address: int): void {
    if (ablaHostOwnsRuntime()) {
        ablaRuntimeAtomicStoreI64(address, 0)
        return
    }
    if (pthread_mutex_init(
        ablaRuntimePointerFromAddress(address),
        ablaRuntimePointerFromAddress(0)
    ) != 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexLock(address: int): void {
    if (ablaHostOwnsRuntime()) {
        __ablaRuntimeFutexLock(address)
        return
    }
    if (pthread_mutex_lock(
        ablaRuntimePointerFromAddress(address)
    ) != 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexUnlock(address: int): void {
    if (ablaHostOwnsRuntime()) {
        __ablaRuntimeFutexUnlock(address)
        return
    }
    if (pthread_mutex_unlock(
        ablaRuntimePointerFromAddress(address)
    ) != 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexDestroy(address: int): void {
    if (ablaHostOwnsRuntime()) return
    if (pthread_mutex_destroy(
        ablaRuntimePointerFromAddress(address)
    ) != 0) ablaRuntimeTrap()
}

// --- the heap's allocator -----------------------------------------------------------------------
// x86-64 Linux allocates without libc: blocks come from anonymous mappings (mmap, munmap, mremap and
// madvise as raw system calls). Every other host (macOS, AArch64 Linux) keeps libc's malloc family.
//
// Blocks have glibc's geometry. A block starts at a 16-byte aligned payload `p`, is `t` bytes long
// (a multiple of 16, at least 32) and has a header word at p - 8: t, bit 0 "the block before this one
// is in use", bit 1 "a mapping of its own", and (small blocks) the block's size class in bits 40-47.
// The next block's payload is p + t, so its header is the last word of this block, which is why a
// block holds t - 8 bytes. A block that is truly free keeps two list links at p and p + 8 and its t in
// its last word before that header (the next block's "previous size", read only when bit 0 of the next
// block's header says the block before it is free). A block that is in use, or parked on a size
// class's list, has the bit set in the next header: freeing is a push on the list of its class and
// allocating a pop, nothing else.
//
// Parked blocks are merged now and then (when allocation finds neither a parked block of its class
// nor a free block that fits, and a good amount is parked; or when a great deal is): each is joined to
// the free blocks around it, a merged block next to the unused tail of the current chunk goes back
// into the tail, a chunk that is entirely free is unmapped, a large merged block gives its pages back
// (madvise), and the rest wait in bins by size to serve any class, split. So a program that frees one
// kind of block and asks for another keeps its heap's size, which lists by class alone could not do.
//
// Size classes: 16-byte steps to 1 KiB, then eight a doubling (1152, 1280, ... 2048, 2304, ...) to
// 128 KiB. Past that a request is a mapping of its own (16 bytes of header, rounded to pages): freeing
// it unmaps it, and realloc grows and shrinks it with mremap, which moves pages, not bytes. Small
// blocks are cut from 1 MiB chunks, the tail of the newest one (the "top") by a cursor.
//
// One lock covers it all, taken only once a second thread can exist (an Abla thread or the
// background-free helper started): a program with one thread pays nothing for it. The lock is a futex word of
// its own (below), so the heap names no pthread function.
// State, one static block: +0 the 120 list heads of the parked blocks, +960 the 121 free-block bins
// (the last for blocks past 128 KiB), +1928 a bitmap of the bins with something in them (3 words),
// +1952 the lock word (and 56 spare bytes).
val __ablaRuntimeHostHeapClasses: int = 120
val __ablaRuntimeHostHeapBins: int = 121
val __ablaRuntimeHostHeapSmallMaximum: int = 131072
val __ablaRuntimeHostHeapChunk: int = 1048576
val __ablaRuntimeHostHeapSizeMask: int = 1099511627760
var __ablaRuntimeHostHeapCursor: int = 0
var __ablaRuntimeHostHeapEnd: int = 0
// The chunk's addresses from here up have never been written (a fresh block there is zero already).
var __ablaRuntimeHostHeapClean: int = 0
var __ablaRuntimeHostHeapShared: bool = false
// Set while __ablaRuntimeHostHeapTrim runs: nothing is kept.
var __ablaRuntimeHostHeapTrimming: bool = false
// Bytes of the blocks parked on the class lists, and of the chunks mapped.
var __ablaRuntimeHostHeapParked: int = 0
var __ablaRuntimeHostHeapMapped: int = 0
// Bytes of the free blocks in the bins.
var __ablaRuntimeHostHeapBinned: int = 0
// The parked bytes at which a free merges them: twice __ablaRuntimeHostHeapMergeAt, kept here so that a free
// compares one word (set again whenever the chunks mapped change).
var __ablaRuntimeHostHeapTrigger: int = 8388608
// Bytes of the large mappings kept after their free (the cache of 16 slots at +2016), for the next large request.
var __ablaRuntimeHostHeapCached: int = 0
val __ablaRuntimeHostHeapCacheEach: int = 8388608
val __ablaRuntimeHostHeapCacheTotal: int = 33554432

// Whether this host's heap is the one below (a constant the backend folds, so the other
// hosts keep libc's functions and this target none).
@inline
trusted fun __ablaRuntimeHostHeapNative(): bool =
    ablaHostOwnsRuntime()

@inline
trusted fun __ablaRuntimeHostHeapState(): int = nativeStaticAllocate(2176)

@inline
trusted fun __ablaRuntimeHostHeapLockAddress(): int = __ablaRuntimeHostHeapState() + 1952

// What the heap holds, for tests and diagnostics: 0 the bytes of chunks mapped, 1 the bytes parked
// on the class lists.
trusted fun __ablaRuntimeHostHeapStat(which: int): int =
    if (which == 0) __ablaRuntimeHostHeapMapped else __ablaRuntimeHostHeapParked

// Bytes of a size class's block, the next block's header word included.
@inline
trusted fun __ablaRuntimeHostHeapClassBytes(sizeClass: int): int =
    if (sizeClass < 64) (sizeClass + 1) * 16
    else (1024 << ((sizeClass - 64) >> 3)) + (128 << ((sizeClass - 64) >> 3)) * (((sizeClass - 64) &
        7) + 1)

// The smallest class whose block holds `total` bytes (32 to 131072).
@inline
trusted fun __ablaRuntimeHostHeapClassOf(total: int): int {
    if (total <= 1024) return ((total + 15) >> 4) - 1
    var octave = 0
    while ((2048 << octave) < total) octave = octave + 1
    64 + octave * 8 + ((total - (1024 << octave) + (128 << octave) - 1) >> (7 + octave)) - 1
}

// The largest class whose block fits in `t` bytes (t from 32 to 131072).
trusted fun __ablaRuntimeHostHeapClassBelow(t: int): int {
    if (t < 1024) return (t >> 4) - 1
    var octave = 0
    while ((2048 << octave) <= t) octave = octave + 1
    64 + octave * 8 + ((t - (1024 << octave)) >> (7 + octave)) - 1
}

// The bin of a free block of `t` bytes.
@inline
trusted fun __ablaRuntimeHostHeapBinOf(t: int): int =
    if (t > 131072) 120 else __ablaRuntimeHostHeapClassBelow(t)

// Anonymous zeroed pages, or 0.
trusted fun __ablaRuntimeHostHeapMap(bytes: int): int {
    val address = ablaLinuxSyscall(9, 0, bytes, 3, 34, -1, 0)
    if (address < 0) 0 else address
}

trusted fun __ablaRuntimeHostHeapUnmap(address: int, bytes: int): void {
    ablaLinuxSyscall(11, address, bytes, 0, 0, 0, 0)
    return
}

// A cached mapping that holds `mapped` bytes (its base), or 0.
// The smallest that fits is taken. The lock is held.
trusted fun __ablaRuntimeHostHeapCacheTake(mapped: int): int {
    val slots = __ablaRuntimeHostHeapState() + 2016
    var best = -1
    var bestLength = 0
    var slot = 0
    while (slot < 16) {
        val base = ablaRuntimeLoadI64(slots + slot * 8)
        if (base != 0) {
            val length = ablaRuntimeLoadI64(base + 8) & -4096
            if (length >= mapped && (best < 0 || length < bestLength)) {
                best = slot
                bestLength = length
            }
        }
        slot = slot + 1
    }
    if (best < 0) return 0
    val base = ablaRuntimeLoadI64(slots + best * 8)
    ablaRuntimeStoreI64(slots + best * 8, 0)
    __ablaRuntimeHostHeapCached = __ablaRuntimeHostHeapCached - bestLength
    base
}

// Keeps a freed mapping for the next request: in an empty slot, or in place of the smallest kept one when
// that is smaller (which is unmapped). False when it is not kept. The lock is held.
trusted fun __ablaRuntimeHostHeapCachePut(base: int, length: int): bool {
    if (length > __ablaRuntimeHostHeapCacheEach) return false
    val slots = __ablaRuntimeHostHeapState() + 2016
    while (true) {
        var empty = -1
        var smallest = -1
        var smallestLength = 0
        var slot = 0
        while (slot < 16) {
            val kept = ablaRuntimeLoadI64(slots + slot * 8)
            if (kept == 0) {
                empty = slot
            } else {
                val keptLength = ablaRuntimeLoadI64(kept + 8) & -4096
                if (smallest < 0 || keptLength < smallestLength) {
                    smallest = slot
                    smallestLength = keptLength
                }
            }
            slot = slot + 1
        }
        if (empty >= 0 && __ablaRuntimeHostHeapCached + length <= __ablaRuntimeHostHeapCacheTotal) {
            ablaRuntimeStoreI64(slots + empty * 8, base)
            __ablaRuntimeHostHeapCached = __ablaRuntimeHostHeapCached + length
            return true
        }
        if (smallest < 0 || smallestLength >= length) return false
        __ablaRuntimeHostHeapUnmap(ablaRuntimeLoadI64(slots + smallest * 8), smallestLength)
        ablaRuntimeStoreI64(slots + smallest * 8, 0)
        __ablaRuntimeHostHeapCached = __ablaRuntimeHostHeapCached - smallestLength
    }
    false
}

@inline
trusted fun __ablaRuntimeHostForkCheck(): void {
    if (ablaHostOwnsRuntime()) {
        val page = __ablaRuntimeHostForkPage
        if (page != 0 && ablaRuntimeLoadI64(page) == 0) __ablaRuntimeHostForkRepair()
    }
    return
}

// The heap's lock: a futex mutex of its own, one word in the static state (the same one the runtime's mutexes
// are, above), so that the heap needs no pthread function nor libc. The holder is never preempted for long, but
// a collection's merge can take a while: a waiter sleeps.
@inline
trusted fun __ablaRuntimeHostHeapAcquire(): void =
    __ablaRuntimeFutexLock(__ablaRuntimeHostHeapLockAddress())

@inline
trusted fun __ablaRuntimeHostHeapLetGo(): void =
    __ablaRuntimeFutexUnlock(__ablaRuntimeHostHeapLockAddress())

// Zeroes `size` bytes at a block's payload, by whole words (a block holds a multiple of 8 bytes). Written out, not
// memset: a --fast build lowers a memset to the C library's.
trusted fun __ablaRuntimeHostHeapZero(address: int, size: int): void {
    val end = address + ((size + 7) & -8)
    var at = address
    while (at < end) {
        ablaRuntimeStoreI64(at, 0)
        at = at + 8
    }
    return
}

// A fork leaves only the forking thread in the child, so a lock another thread held stays held for ever (#812).
// No fork hook is needed, and no system call on the allocation path: one page of its own holds a 1, and
// MADV_WIPEONFORK (Linux 4.14) makes the kernel zero it in the child. The first lock the child takes looks at
// that word, finds a 0, and repairs what the vanished threads may have left (below). Without the advice (an
// older kernel) the word is never wiped and a fork with a lock held is not detected.
var __ablaRuntimeHostForkPage: int = 0
// Set in a child that found the heap's lock held: nothing parked or merged before the fork is trusted, so no
// merge ever consults a block's header from before it (a free block's links may be half written).
var __ablaRuntimeHostHeapNoMerge: bool = false
// Set in a child that found the runtime mutex or the heap lock held: a thread that did not survive may have been in
// the middle of registering an allocation, so the collector never walks the registry in that child.
var __ablaRuntimeHostForkNoCollect: bool = false

trusted fun __ablaRuntimeHostForkArm(): void {
    val page = __ablaRuntimeHostHeapMap(4096)
    if (page == 0) return
    ablaRuntimeStoreI64(page, 1)
    ablaLinuxSyscall(28, page, 4096, 18, 0, 0, 0)
    __ablaRuntimeHostForkPage = page
    return
}

// In the child, by the first thread to take a runtime lock. Nothing else runs, so nothing here is locked.
@noinline
trusted fun __ablaRuntimeHostForkRepair(): void {
    ablaRuntimeStoreI64(__ablaRuntimeHostForkPage, 1)
    val state = __ablaRuntimeHostHeapState()
    val lock = state + 1952
    val mutexWord = __ablaRuntimeHostHeapMutex
    var held = ablaRuntimeAtomicLoadI64(lock) != 0
    if (mutexWord != 0 && ablaRuntimeAtomicLoadI64(mutexWord) != 0) held = true
    if (held) __ablaRuntimeHostForkNoCollect = true
    if (ablaRuntimeAtomicLoadI64(lock) != 0) {
        // Held by a thread that is gone, possibly in the middle of a list update: the parked lists, the bins,
        // the top and the cache of large mappings are dropped (their memory leaks) and nothing merges again.
        var at = state
        while (at < lock) {
            ablaRuntimeStoreI64(at, 0)
            at = at + 8
        }
        at = state + 2016
        while (at < state + 2144) {
            ablaRuntimeStoreI64(at, 0)
            at = at + 8
        }
        __ablaRuntimeHostHeapCursor = 0
        __ablaRuntimeHostHeapEnd = 0
        __ablaRuntimeHostHeapClean = 0
        __ablaRuntimeHostHeapParked = 0
        __ablaRuntimeHostHeapBinned = 0
        __ablaRuntimeHostHeapCached = 0
        __ablaRuntimeHostHeapTrimming = false
        __ablaRuntimeHostHeapNoMerge = true
        ablaRuntimeAtomicStoreI64(lock, 0)
    }
    // The runtime's own mutex (the collector's registry and the thread count) is held by no one now, and no
    // other thread runs.
    if (mutexWord != 0) ablaRuntimeAtomicStoreI64(mutexWord, 0)
    if (!held) __ablaRuntimeHostActiveThreads = 0
    return
}

// From now on the heap is locked (once a second thread can touch it).
trusted fun __ablaRuntimeHostHeapShare(): void {
    if (!__ablaRuntimeHostHeapShared) {
        ablaRuntimeAtomicStoreI64(__ablaRuntimeHostHeapLockAddress(), 0)
        __ablaRuntimeHostForkArm()
        __ablaRuntimeHostHeapShared = true
    }
    return
}

// A free block at `block`, `t` bytes, into its bin (links, bitmap bit).
trusted fun __ablaRuntimeHostHeapBinInsert(block: int, t: int): void {
    val bin = __ablaRuntimeHostHeapBinOf(t)
    val state = __ablaRuntimeHostHeapState()
    val head = state + 960 + bin * 8
    val first = ablaRuntimeLoadI64(head)
    ablaRuntimeStoreI64(block, first)
    ablaRuntimeStoreI64(block + 8, 0)
    if (first != 0) ablaRuntimeStoreI64(first + 8, block)
    ablaRuntimeStoreI64(head, block)
    val word = state + 1928 + (bin >> 6) * 8
    ablaRuntimeStoreI64(word, ablaRuntimeLoadI64(word) | (1 << (bin & 63)))
    __ablaRuntimeHostHeapBinned = __ablaRuntimeHostHeapBinned + t
    return
}

// A free block out of its bin.
trusted fun __ablaRuntimeHostHeapBinRemove(block: int): void {
    val size = ablaRuntimeLoadI64(block - 8) & __ablaRuntimeHostHeapSizeMask
    val bin = __ablaRuntimeHostHeapBinOf(size)
    __ablaRuntimeHostHeapBinned = __ablaRuntimeHostHeapBinned - size
    val state = __ablaRuntimeHostHeapState()
    val next = ablaRuntimeLoadI64(block)
    val previous = ablaRuntimeLoadI64(block + 8)
    if (next != 0) ablaRuntimeStoreI64(next + 8, previous)
    if (previous != 0) ablaRuntimeStoreI64(previous, next)
    else {
        ablaRuntimeStoreI64(state + 960 + bin * 8, next)
        if (next == 0) {
            val word = state + 1928 + (bin >> 6) * 8
            ablaRuntimeStoreI64(word, ablaRuntimeLoadI64(word) & ~(1 << (bin & 63)))
        }
    }
    return
}

// The first bin from `first` up that holds a block, or -1.
trusted fun __ablaRuntimeHostHeapBinFrom(first: int): int {
    val state = __ablaRuntimeHostHeapState()
    var bin = first
    while (bin < __ablaRuntimeHostHeapBins) {
        val bits = ablaRuntimeLoadI64(state + 1928 + (bin >> 6) * 8) >>> (bin & 63)
        if (bits == 0) {
            bin = ((bin >> 6) + 1) << 6
        } else {
            var step = 0
            var rest = bits
            while ((rest & 1) == 0) {
                rest = rest >>> 1
                step = step + 1
            }
            return bin + step
        }
    }
    -1
}

// A block of at least `t` bytes (the class's size) out of the bins, split when much is left over,
// its header made that of a block in use; 0 when none fits.
trusted fun __ablaRuntimeHostHeapFromBins(sizeClass: int, t: int): int {
    val bin = __ablaRuntimeHostHeapBinFrom(sizeClass)
    if (bin < 0) return 0
    val block = ablaRuntimeLoadI64(__ablaRuntimeHostHeapState() + 960 + bin * 8)
    __ablaRuntimeHostHeapBinRemove(block)
    val whole = ablaRuntimeLoadI64(block - 8) & __ablaRuntimeHostHeapSizeMask
    val left = whole - t
    if (left >= 32) {
        ablaRuntimeStoreI64(block - 8, t | 1 | (sizeClass << 40))
        val rest = block + t
        ablaRuntimeStoreI64(rest - 8, left | 1)
        ablaRuntimeStoreI64(rest + left - 16, left)
        __ablaRuntimeHostHeapBinInsert(rest, left)
    } else {
        ablaRuntimeStoreI64(block - 8, whole | 1 | (__ablaRuntimeHostHeapClassBelow(whole) << 40))
        val after = block + whole - 8
        ablaRuntimeStoreI64(after, ablaRuntimeLoadI64(after) | 1)
    }
    block
}

// How much free memory the bins keep before whole chunks and large blocks are given back to the system:
// a program that frees much and allocates again (a collector's cycle) would otherwise pay the system for
// the same pages every time.
@inline
trusted fun __ablaRuntimeHostHeapKeep(): int {
    if (__ablaRuntimeHostHeapTrimming) return 0
    val share = __ablaRuntimeHostHeapMapped / 2
    if (share < 67108864) 67108864 else share
}

// A merged free block [start, end) goes back: into the top, unmapped (a whole chunk), or into a bin.
trusted fun __ablaRuntimeHostHeapRelease(start: int, end: int): void {
    val t = end - start
    if (end == __ablaRuntimeHostHeapCursor) {
        __ablaRuntimeHostHeapCursor = start
        ablaRuntimeStoreI64(start - 8, 1)
        return
    }
    val give = __ablaRuntimeHostHeapBinned + t > __ablaRuntimeHostHeapKeep()
    if (give && t == __ablaRuntimeHostHeapChunk - 16 && (start & 4095) == 16) {
        __ablaRuntimeHostHeapUnmap(start - 16, __ablaRuntimeHostHeapChunk)
        __ablaRuntimeHostHeapMapped = __ablaRuntimeHostHeapMapped - __ablaRuntimeHostHeapChunk
        __ablaRuntimeHostHeapTrigger = 2 * __ablaRuntimeHostHeapMergeAt()
        return
    }
    ablaRuntimeStoreI64(start - 8, t | 1)
    ablaRuntimeStoreI64(end - 16, t)
    val after = end - 8
    ablaRuntimeStoreI64(after, ablaRuntimeLoadI64(after) & -2)
    __ablaRuntimeHostHeapBinInsert(start, t)
    return
}

// One parked block, `block`, truly free now: merged with a free block before it and one after it.
trusted fun __ablaRuntimeHostHeapMerge(block: int): void {
    val header = ablaRuntimeLoadI64(block - 8)
    var start = block
    var end = block + (header & __ablaRuntimeHostHeapSizeMask)
    if ((header & 1) == 0) {
        val before = block - ablaRuntimeLoadI64(block - 16)
        __ablaRuntimeHostHeapBinRemove(before)
        start = before
    }
    val next = ablaRuntimeLoadI64(end - 8) & __ablaRuntimeHostHeapSizeMask
    // A next block of size 0 is the top or the end of a chunk. Otherwise it is free when the block after
    // it says so.
    if (next != 0 && (ablaRuntimeLoadI64(end + next - 8) & 1) == 0) {
        __ablaRuntimeHostHeapBinRemove(end)
        end = end + next
    }
    __ablaRuntimeHostHeapRelease(start, end)
    return
}

// The large free blocks (bin 120) give their pages back, keeping each one's header, links and footer, all but
// the first ones (the newest, the likeliest to be wanted next) that make up what the bins are meant to keep.
@noinline
trusted fun __ablaRuntimeHostHeapGiveBack(): void {
    var block = ablaRuntimeLoadI64(__ablaRuntimeHostHeapState() + 960 + 120 * 8)
