    if (shared) __ablaRuntimeHostHeapAcquire()
    __ablaRuntimeHostHeapTrimming = true
    __ablaRuntimeHostHeapConsolidate()
    var block = ablaRuntimeLoadI64(__ablaRuntimeHostHeapState() + 960 + 120 * 8)
