                val length = ablaRuntimeLoadI64(payload)
                __ablaRuntimeHostFreezeFlatten(payload, place + 32)
                ablaRuntimeStoreI64(place + 16, length + 1)
                ablaRuntimeStoreI64(place + 24, 1)
            } else {
