            ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(context)), capacity * 8)))
        ablaRuntimeStoreI64(context + 48, ablaRuntimePointerAddress(__ablaRuntimeHostRealloc(
            ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(context + 48)), capacity * 8)))
        ablaRuntimeStoreI64(context + 56, ablaRuntimePointerAddress(__ablaRuntimeHostRealloc(
            ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(context + 56)), capacity * 8)))
