    if (lower == 0) return 0
    val large = ablaRuntimeLoadI64(ranges + (lower - 1) * 8)
    val payload = large + 32
    if (candidate >= payload && candidate - payload < ablaRuntimeLoadI64(large + 16)) large else 0
