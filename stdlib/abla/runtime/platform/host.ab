// The unused tail of the newest chunk becomes a free block and a new chunk is the top. False when the
// system has no more.
@noinline
trusted fun __ablaRuntimeHostHeapRefill(): bool {
    val chunk = __ablaRuntimeHostHeapMap(__ablaRuntimeHostHeapChunk)
    if (chunk == 0) return false
    val cursor = __ablaRuntimeHostHeapCursor
    val end = __ablaRuntimeHostHeapEnd
    if (cursor != 0 && end - cursor >= 32) {
        val left = end - cursor
        ablaRuntimeStoreI64(cursor - 8, left | 1)
        ablaRuntimeStoreI64(end - 16, left)
        ablaRuntimeStoreI64(end - 8, 0)
        __ablaRuntimeHostHeapBinInsert(cursor, left)
    }
    __ablaRuntimeHostHeapMapped = __ablaRuntimeHostHeapMapped + __ablaRuntimeHostHeapChunk
    __ablaRuntimeHostHeapSetTrigger()
    __ablaRuntimeHostHeapCursor = chunk + 16
    __ablaRuntimeHostHeapEnd = chunk + __ablaRuntimeHostHeapChunk
    __ablaRuntimeHostHeapClean = chunk + 16
