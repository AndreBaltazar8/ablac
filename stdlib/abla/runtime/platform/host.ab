// One pointer slot of a block: `offset` from its payload. Discovery notes the pointer; the copy pass (`copy` is the
// copy's payload) rewrites the copy's word.
@inline
trusted fun __ablaRuntimeHostFreezeSlot(payload: int, copy: int, offset: int, mode: int): void {
