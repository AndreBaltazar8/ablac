trusted fun __ablaRuntimeRootsPop(frame: int): int {
    if (__ablaRuntimeHostRootFrameLoad() != frame) ablaRuntimeTrap()
    __ablaRuntimeHostRootFrameStore(ablaRuntimeLoadI64(frame))
    0
}

trusted fun __ablaRuntimeMemoryPressure(): int {
    if (!__ablaRuntimeHostCollectionEnabled ||
        __ablaRuntimeHostRegionLoad() != 0 ||
        __ablaRuntimeHostLiveBytes <
            __ablaRuntimeHostCollectionThreshold) return 0
    __ablaRuntimePlatformMemoryCollect()
    val reserve = 67108864
    val least = __ablaRuntimeHostCollectionGrowth
    val growth = if (__ablaRuntimeHostLiveBytes / 2 > least) {
        __ablaRuntimeHostLiveBytes / 2
    } else least
    var next = __ablaRuntimeHostLiveBytes + growth
    val latest = __ablaRuntimeHostLimit -
        if (__ablaRuntimeHostLimit / 4 < reserve) {
            __ablaRuntimeHostLimit / 4
        } else reserve
    if (next < least / 2) next = least / 2
    if (next > latest) next = latest
    __ablaRuntimeHostCollectionThreshold = next
