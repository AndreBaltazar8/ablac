    descriptor: int,
    data: i64*,
    length: int
): int
// The raw system call and the target's architecture, as abla/sys/linux and abla/simd/target declare them
// (the runtime does not import them): the collection reads /proc/self/maps through the former, so a
// freestanding guest needs no libc open, read or close.
trusted noescape extern:"intrinsic" fun ablaLinuxSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int
trusted noescape extern:"intrinsic" fun ablaSimdTargetArch(): int
trusted noescape extern:"c" fun _exit(status: int): void
trusted noescape extern:"c" fun _longjmp(buffer: i64*, value: int): void
// The environment block main received (abla_runtime_set_arguments stores it first thing), so
// the runtime reads its own variables without libc getenv.
trusted noescape extern:"intrinsic" fun ablaLinuxEnvironmentPointer(): i64*
trusted noescape extern:"c" fun pthread_mutex_init(
    mutex: i64*,
