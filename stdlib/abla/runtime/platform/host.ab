// A collection point: the thread that finds the hook armed holds here, in native state (stopped, its roots stable).
private trusted fun __ablaRuntimeHostStwHoldPoint(): void {
    val word = __ablaRuntimeHostStwAddress() + 136
    if (ablaRuntimeAtomicLoadI64(word) != 1) return
    if (__ablaRuntimeHostStwRecord() == 0) return
    if (ablaRuntimeAtomicCompareExchangeI64(word, 1, 2) != 1) return
    __ablaRuntimePlatformNativeEnter()
    while (ablaRuntimeAtomicLoadI64(word) == 2) __ablaRuntimeFutexWait(word, 2)
    __ablaRuntimePlatformNativeLeave()
    return
}

// Stops abandoned and collections that stopped threads (memoryHeapStat 8 and 7).
trusted fun __ablaRuntimeHostStwStat(which: int): int =
    ablaRuntimeLoadI64(__ablaRuntimeHostStwAddress() + (if (which == 8) 40 else 32))

// In a forked child only the forking thread exists: the registry is that thread's record alone, no stop under way.
trusted fun __ablaRuntimeHostStwForkReset(): void {
    val stw = __ablaRuntimeHostStwAddress()
    val record = __ablaRuntimeHostStwRecord()
    ablaRuntimeAtomicStoreI64(stw + 8, 0)
    ablaRuntimeStoreI64(stw + 16, 0)
    if (record != 0) {
        ablaRuntimeStoreI64(record, 0)
        ablaRuntimeStoreI64(stw + 16, record)
        ablaRuntimeAtomicStoreI64(record + 24, 0)
    }
    ablaRuntimeStoreI64(stw + 48, 0)
    val token = ablaRuntimeAtomicLoadI64(stw)
    if ((token & 1) == 1) ablaRuntimeAtomicStoreI64(stw, token + 1)
    return
}

