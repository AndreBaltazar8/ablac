var __ablaRuntimeHostOutOfMemorySeen: int = 0

// The system refused memory: usually a limit on the process rather than the machine (ulimit -v, or the compiler's launcher,
// which sets it from ABLA_MAX_MEMORY_MB). A trap would say nothing. If reporting it needs memory too, that ends it.
// Share this failed-allocation path between the allocator's checks.
@noinline
trusted fun __ablaRuntimeHostOutOfMemory(): void {
