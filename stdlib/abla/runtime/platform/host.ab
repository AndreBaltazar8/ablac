// ---- macOS sockets and readiness (#811 group 4) ----
// BSD numbers: socket 97, connect 98, bind 104, listen 106, accept 30, sendto 133, recvfrom 29,
// sendmsg 28, getsockname 32, getpeername 31, setsockopt 105, getsockopt 118, fcntl 92, poll 230,
// select 93, kqueue 362, kevent 363, mmap 197, munmap 73. UNVERIFIED (from memory of xnu's
// bsd/kern/syscalls.master and the headers, no macOS machine here): every number and constant in
// this section; the macOS job's tools/test-darwin-syscalls.sh names the call that is wrong.
// No stack allocation here (the compile-time JIT's runtime slice cannot resolve
// nativeStackAllocate): a Linux sockaddr is rewritten in the caller's own buffer (only its first
// two bytes differ from Darwin's) for the call and put back, a Darwin one the kernel wrote there is
// rewritten the same way; where a record of another shape is needed (kevents, the select masks)
// the call takes an anonymous mapping.

// A scratch mapping (anonymous, read-write); negative (-errno) when none could be made.
trusted fun __ablaRuntimeDarwinScratch(size: int): int =
    ablaDarwinSyscall(197, 0, size, 3, 4098, -1, 0)

trusted fun __ablaRuntimeDarwinScratchFailed(address: int): bool = address < 0 && address > -4096

trusted fun __ablaRuntimeDarwinScratchFree(address: int, size: int): void {
    ablaDarwinSyscall(73, address, size, 0, 0, 0, 0)
    return
