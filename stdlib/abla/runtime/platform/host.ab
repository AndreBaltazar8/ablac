// A float `%` (f64 and f32) on x86-64 Linux, which then needs no fmod or fmodf
// from libm (#806): the backend calls this there instead of LLVM's frem. The
// same exact algorithm as WebAssembly's (platform/wasm.ab): C's fmod, x - n·y
// for the integer n that x / y truncates to, with x's sign, every step exact.
trusted fun __ablaRuntimeFloatRemainder(x: f64, y: f64): f64 {
    if (x != x || y != y || y == 0.0 || x - x != 0.0) return (x * y) / (x * y)
    val divisor = if (y < 0.0) y * -1.0 else y
    var rest = if (x < 0.0) x * -1.0 else x
    if (rest < divisor) return x
    // The largest divisor·2^k not above rest (doubling is exact short of
    // infinity), then back down to divisor: each step t has rest < 2t, so
    // rest - t is exact when rest >= t (Sterbenz), and halving t is exact.
    var step = divisor
    while (step + step <= rest) step = step + step
    while (step >= divisor) {
        if (rest >= step) rest = rest - step
        step = step * 0.5
    }
    if (x < 0.0) rest * -1.0 else rest
}

