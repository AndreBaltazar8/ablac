// Free what the marker did not reach; clear the marks of what it did. What is
// kept moves down the registry in its order, closing the empty slots.
trusted fun __ablaRuntimeHostCollectionSweep(): void {
    var kept = 0
    var slot = 0
    while (slot < __ablaRuntimeHostRegistrySlots) {
        val header = ablaRuntimeLoadI64(__ablaRuntimeHostRegistry + slot * 8)
        if (header != 0) {
            val state = ablaRuntimeLoadI64(header + 24)
            if (state >= 0 && state < 16 && state != 10 && state != 12) {
                __ablaRuntimeHostLiveBytes =
                    __ablaRuntimeHostLiveBytes - ablaRuntimeLoadI64(header + 16)
                __ablaRuntimeHostAllocationCount = __ablaRuntimeHostAllocationCount - 1
                free(ablaRuntimePointerFromAddress(header))
            } else {
                if (state >= 16) ablaRuntimeStoreI64(header + 24, state - 32)
                ablaRuntimeStoreI64(header, kept)
                ablaRuntimeStoreI64(__ablaRuntimeHostRegistry + kept * 8, header)
                kept = kept + 1
            }
        }
        slot = slot + 1
    }
    __ablaRuntimeHostRegistrySlots = kept
    return
}

trusted fun __ablaRuntimePlatformMemoryCollect(): int {
    // Region pages are reclaimed as a unit and may contain references into
    // the persistent heap. Defer collection until the outermost region ends,
    // when compiler-published stack/global roots are sufficient.
    val mutex = __ablaRuntimeHostHeapLock()
    if (__ablaRuntimeHostRegionLoad() != 0 ||
        __ablaRuntimeHostActiveThreads != 0) {
        __ablaRuntimeHostHeapUnlock(mutex)
        return 0
    }
    val before = __ablaRuntimeHostLiveBytes
    val allocationCount = __ablaRuntimeHostAllocationCount
    if (allocationCount == 0) {
        __ablaRuntimeHostHeapUnlock(mutex)
        return 0
    }
    __ablaRuntimeHostCollectionWorklist = ablaRuntimePointerAddress(
        malloc(allocationCount * 8)
    )
    if (__ablaRuntimeHostCollectionWorklist == 0) ablaRuntimeTrap()
    __ablaRuntimeHostCollectionCount = allocationCount
    __ablaRuntimeHostCollectionWorklistCount = 0
    __ablaRuntimeHostCollectionPagesBuild()
    __ablaRuntimeHostMarkRootValues()
    __ablaRuntimeHostTraceMarkedAllocations()
    __ablaRuntimeHostCollectionSweep()
    free(ablaRuntimePointerFromAddress(
        __ablaRuntimeHostCollectionWorklist
    ))
    free(ablaRuntimePointerFromAddress(
        __ablaRuntimeHostCollectionRanges
    ))
    free(ablaRuntimePointerFromAddress(__ablaRuntimeHostCollectionPages))
    free(ablaRuntimePointerFromAddress(__ablaRuntimeHostCollectionBitmaps))
    __ablaRuntimeHostCollectionPages = 0
    __ablaRuntimeHostCollectionPageMask = 0
    __ablaRuntimeHostCollectionBitmaps = 0
    __ablaRuntimeHostCollectionLargeCount = 0
    __ablaRuntimeHostCollectionCount = 0
    __ablaRuntimeHostCollectionWorklist = 0
    __ablaRuntimeHostCollectionWorklistCount = 0
    __ablaRuntimeHostCollectionRanges = 0
    val freed = before - __ablaRuntimeHostLiveBytes
    __ablaRuntimeHostHeapUnlock(mutex)
    freed
}

trusted fun __ablaRuntimeRootsPush(
    frame: int,
    roots: int,
    count: int
): int {
    ablaRuntimeStoreI64(frame, __ablaRuntimeHostRootFrameLoad())
    ablaRuntimeStoreI64(frame + 8, roots)
    ablaRuntimeStoreI64(frame + 16, count)
    __ablaRuntimeHostRootFrameStore(frame)
