// A collection of `slots` registry slots took `micros` in the mode it used.
private trusted fun __ablaRuntimeHostGcAdaptiveRecord(parallel: bool, micros: int, slots: int): void {
    if (slots < __ablaRuntimeHostGcAdaptiveMinimumSlots) return
    val state = __ablaRuntimeHostGcAdaptiveState()
    val cost = micros * 1024000 / slots
    val mode = if (parallel) 1 else 2
    val lastMode = ablaRuntimeLoadI64(state + 8)
    val last = ablaRuntimeLoadI64(state)
