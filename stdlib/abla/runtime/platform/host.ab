            val header = ablaRuntimeLoadI64(block - 8)
            val t = header & __ablaRuntimeHostHeapSizeMask
            if ((block & 15) != 0 || t < 32 || (header & 2) != 0) return 6
            if (__ablaRuntimeHostHeapBinOf(t) != bin) return 7
            if (ablaRuntimeLoadI64(block + 8) != previous) return 8
            if (ablaRuntimeLoadI64(block + t - 16) != t) return 9
            if ((header & 1) == 0) return 10
            if ((ablaRuntimeLoadI64(block + t - 8) & 1) != 0) return 11
            binned = binned + t
            previous = block
            block = ablaRuntimeLoadI64(block)
        }
        bin = bin + 1
    }
    if (binned != __ablaRuntimeHostHeapBinned) return 12
