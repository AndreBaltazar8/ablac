    ablaRuntimeStoreI64(table + slot * 16, header)
    ablaRuntimeStoreI64(table + slot * 16 + 8, index + 1)
    return
}

// Adds the block at `header` to the group: its place, its flag.
trusted fun __ablaRuntimeHostFreezeAdd(header: int, mode: int): void {
