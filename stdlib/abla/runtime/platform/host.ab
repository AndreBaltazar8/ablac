@noinline
trusted fun __ablaRuntimeHostGcStressConfigured(): bool {
    // A literal's data word is its bytes and a NUL (bootstrapLlvmConstStringPointer).
    val value = ablaRuntimePointerAddress(__ablaRuntimeHostGetenv(ablaRuntimePointerFromAddress(
        __ablaRuntimeWord0("ABLA_GC_STRESS")
