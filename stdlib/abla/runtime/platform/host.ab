            return base + 16
        }
        base = __ablaRuntimeHostHeapMap(mapped)
        if (base == 0) return 0
        ablaRuntimeStoreI64(base + 8, mapped | 2)
        return base + 16
    }
    val sizeClass = __ablaRuntimeHostHeapClassOf(if (size + 8 < 32) 32 else size + 8)
    val t = __ablaRuntimeHostHeapClassBytes(sizeClass)
    val state = __ablaRuntimeHostHeapState()
    val shared = __ablaRuntimeHostHeapShared
