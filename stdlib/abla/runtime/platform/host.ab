// Frees what a freeze built (its tables and the directory the collector's locator reads).
trusted fun __ablaRuntimeHostFreezeCleanup(): void {
    val context = __ablaRuntimeHostFreezeContext()
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(context)))
