    __ablaRuntimeHostRootFrameAddress() + 16

// A checked export's call runs under a recovery frame: a panic inside it copies
// its message to the caller's buffer and resumes the export at its setjmp
// instead of ending the program. The frame, on the export's stack:
//   0 the enclosing frame   8 the root frame head   16 the region
//   24 the message buffer   32 its capacity         40 where the length goes
//   48 the jmp_buf (the backend's abla_checked_invoke sizes it).
