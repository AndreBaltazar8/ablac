    // (free) reads them, and kept in the globals each freed block would load and store them.
    val registry = __ablaRuntimeHostRegistry
    val slots = __ablaRuntimeHostRegistrySlots
    val lists = __ablaRuntimeHostSmallLists()
    val keptLimit = __ablaRuntimeHostSmallKept
    var smallBytes = __ablaRuntimeHostSmallBytes
