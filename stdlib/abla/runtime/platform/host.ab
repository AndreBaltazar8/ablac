/// Updates the native allocator's reclaim threshold from its current state.
trusted fun __ablaRuntimeHostHeapSetTrigger(): void {
    __ablaRuntimeHostHeapTrigger = 4 * __ablaRuntimeHostHeapMergeAt()
    return
}

// How much parked memory is worth a merge when allocation has nothing else: a sixteenth of the
// chunks, at least 4 MiB.
@inline
trusted fun __ablaRuntimeHostHeapMergeAt(): int {
    val share = __ablaRuntimeHostHeapMapped >> 4
    if (share < 4194304) 4194304 else share
