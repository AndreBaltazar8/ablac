/// Returns a zeroed native allocation or null if the size overflows or allocation fails.
trusted fun __ablaRuntimeHostHeapCallocate(count: int, size: int): i64* {
    // No division (its zero check would keep the runtime's panic in every program): both factors under
    // 2^31 cannot overflow, and otherwise one of them has to be 1, as every call here has it.
    if (count < 0 || size < 0) return ablaRuntimePointerFromAddress(0)
    val total = if (count < 2147483648 && size < 2147483648) count * size
        else if (count == 1) size
        else if (size == 1) count
        else -1
    if (total < 0) return ablaRuntimePointerFromAddress(0)
    ablaRuntimePointerFromAddress(__ablaRuntimeHostHeapAllocate(total, true))
}

// The libc functions are named only behind a test of the host that the backend folds to a constant,
// nested as in these four (a test through __ablaRuntimeHostHeapNative() is not folded, and a --fast
// build would keep the imports): an x86-64 Linux program then names none of them, release or --fast.
trusted fun __ablaRuntimeHostCalloc(count: int, size: int): i64* =
    if (ablaHostOwnsRuntime() || (ablaHostIsMacOS() &&
        !ablaHostIsIOS())) __ablaRuntimeHostHeapCallocate(count, size)
    else calloc(count, size)

/// Resizes an existing native allocation and returns its possibly moved address or null on failure.
trusted fun __ablaRuntimeHostRealloc(pointer: i64*, size: int): i64* =
    if (ablaHostOwnsRuntime() || (ablaHostIsMacOS() &&
        !ablaHostIsIOS())) ablaRuntimePointerFromAddress(
            __ablaRuntimeHostHeapResize(ablaRuntimePointerAddress(pointer), size)
        )
    else realloc(pointer, size)

/// Releases a pointer allocated from the runtime's native heap or the selected host allocator.
@inline
trusted fun __ablaRuntimeHostFree(pointer: i64*): void {
    if (ablaHostOwnsRuntime() || (ablaHostIsMacOS() &&
        !ablaHostIsIOS())) __ablaRuntimeHostHeapFree(ablaRuntimePointerAddress(pointer))
    else free(pointer)
    return
}

// A thread's own alternate signal stack, for a thread that has none: a stack overflow's SIGSEGV has no room on
// the overflowed stack, so without one the kernel ends the whole process before any handler runs. The main
// thread's is the stack guard's (debug.ab), and an x86-64 Linux libc-free thread gets one from
// abla_clone_create; a libpthread thread (a hosted program, or a `#` site's thread inside the compiler, #831) has
// none. Enter installs 64 KiB and returns it (0 when the thread had one, or the host has no such call); Leave,
// before the thread ends, takes it down and frees it. sigaltstack is 131 on x86-64 Linux (and in an AArch64
// build whose system calls are translated), 132 on AArch64, 53 on Darwin, whose stack_t has its flags after the
// size (and SS_DISABLE 4, not 2).
// The signal stack is a mapping of its own (mmap and munmap by system call, as the heap maps its large blocks), and the
// stack_t each call passes lives in its first bytes: the kernel copies a stack_t when sigaltstack is called, so it may
// sit in the stack it describes. Enter and Leave take nothing from the heap, so they read none of the thread's
// thread-locals (the heap's, the emulated ones): where they run relative to the thread-end hook doesn't matter.
val __ablaRuntimeHostSignalStackBytes = 65536

/// Installs a signal stack for the current thread and returns its token or zero if unavailable.
trusted fun __ablaRuntimePlatformThreadSignalStackEnter(): int {
    val arch = ablaSimdTargetArch()
    if (arch != 1 && arch != 2) return 0
    val flagsAt = if (ablaHostIsMacOS()) 16 else 8
    val sizeAt = if (ablaHostIsMacOS()) 8 else 16
    val disabled = if (ablaHostIsMacOS()) 4 else 2
    val size = __ablaRuntimeHostSignalStackBytes
    val memory = __ablaRuntimeHostHeapMap(size)
    if (memory == 0) return 0
    // The thread's current one, read into the start of the new mapping: kept if there is one (abla_clone_create's).
    if (!__ablaRuntimeOsSignalStackCall(0, memory) ||
        (ablaRuntimeLoadI64(memory + flagsAt) & 4294967295 & disabled) == 0) {
        __ablaRuntimeHostHeapUnmap(memory, size)
        return 0
    }
    ablaRuntimeStoreI64(memory, memory)
    ablaRuntimeStoreI64(memory + 8, 0)
    ablaRuntimeStoreI64(memory + 16, 0)
    ablaRuntimeStoreI64(memory + sizeAt, size)
    if (!__ablaRuntimeOsSignalStackCall(memory, 0)) {
        __ablaRuntimeHostHeapUnmap(memory, size)
        return 0
    }
    memory
}

/// Removes the thread signal stack represented by the token.
trusted fun __ablaRuntimePlatformThreadSignalStackLeave(stack: int): void {
    if (stack == 0) return
    val flagsAt = if (ablaHostIsMacOS()) 16 else 8
    val disabled = if (ablaHostIsMacOS()) 4 else 2
    // SS_DISABLE, in a stack_t at the start of the stack it takes down (no handler runs on it now).
    ablaRuntimeStoreI64(stack, 0)
    ablaRuntimeStoreI64(stack + 8, 0)
    ablaRuntimeStoreI64(stack + 16, 0)
    ablaRuntimeStoreI64(stack + flagsAt, disabled)
    __ablaRuntimeOsSignalStackCall(stack, 0)
    __ablaRuntimeHostHeapUnmap(stack, __ablaRuntimeHostSignalStackBytes)
    return
}

// The tracked heap stays lock-free until a program actually starts an Abla
// thread. Thread creation happens before the worker can run, so this one-time
// transition does not add a synchronization branch to initialization.
var __ablaRuntimeHostHeapMutex: int = 0
/// Counts started threads that still need to be joined.
var __ablaRuntimeHostActiveThreads: int = 0

/// Enables runtime synchronization for multithreaded execution.
trusted fun __ablaRuntimePlatformThreadsEnable(): void {
    __ablaRuntimeHostThreadsShare()
    // The thread that starts sharing is a registered one for good (a program's main thread).
    if (__ablaRuntimeHostStwRecord() == 0) __ablaRuntimePlatformThreadRegister()
}

/// Marks the allocator as shared and prepares it for competing threads.
trusted fun __ablaRuntimeHostThreadsShare(): void {
    if (__ablaRuntimeHostHeapNative()) __ablaRuntimeHostHeapShare()
    if (__ablaRuntimeHostHeapMutex == 0) {
        // Static storage, the platform's whole mutex (40 bytes on Linux, 64 on Darwin; a 40-byte block let
        // every lock/unlock on macOS write past it into its neighbour): never a block of the heap it guards.
        val mutex = nativeStaticAllocate(64)
        __ablaRuntimePlatformMutexInitialize(mutex)
        __ablaRuntimeHostHeapMutex = mutex
    }
}


// A shared library's exports are entered from threads the library did not start (a host's UI thread and workers, JNI
// callers), possibly at the same time (#811). Each export's thunk (src/backend/llvm/exports.ab) calls
// __ablaRuntimeExportEnter first and __ablaRuntimeExportLeave last, and the one-time initialization of the module
// globals goes through __ablaRuntimeExportInitBegin and __ablaRuntimeExportInitEnd:
//  - the first entry makes the heap lock live (the mode a program that starts a thread is in), before any other caller
//    gets in; the others wait for it;
//  - the number of threads inside the library is counted, and a collection runs only when its caller is the only one
//    inside (and no thread of the library's own runs): a thread's roots are on its own chain, and nothing walks the
//    chain of a thread that is inside. A library under overlapping callers does not collect while they overlap, as a
//    program with threads does not (a stop-the-world collection is a separate project);
//  - the globals are initialized by one caller while the others wait; a nested export on the initializing thread goes on.
// The words are static storage (an address that never moves).
private trusted fun __ablaRuntimeHostExportInsideAddress(): int = nativeStaticAllocate(8)
private trusted fun __ablaRuntimeHostExportShareAddress(): int = nativeStaticAllocate(8)
private trusted fun __ablaRuntimeHostExportInitAddress(): int = nativeStaticAllocate(8)
private trusted fun __ablaRuntimeHostExportInitThreadAddress(): int = nativeStaticAllocate(8)

// How many threads are inside the library's exports now (0 in a program that has none).
trusted fun __ablaRuntimeHostExportInside(): int =
    ablaRuntimeAtomicLoadI64(__ablaRuntimeHostExportInsideAddress())

/// Enters a runtime call from outside and returns zero.
trusted fun __ablaRuntimeExportEnter(): int = __ablaRuntimeHostEnterFromOutside()

/// Leaves a runtime call made from outside and returns zero.
trusted fun __ablaRuntimeExportLeave(): int = __ablaRuntimeHostLeaveToOutside()

// `ablac run --live`: a reload's new variables are initialized by a thread that may not be the program's (the --watch
// thread) or that is inside the compiler's reload (native code): it enters as an export's caller does
// (src/backend/llvm/live_globals.ab). Plain runtime functions: the export bridges exist only in a library.
trusted fun __ablaRuntimeLiveEnter(): int = __ablaRuntimeHostEnterFromOutside()

/// Leaves a live JIT runtime call and returns zero.
trusted fun __ablaRuntimeLiveLeave(): int = __ablaRuntimeHostLeaveToOutside()

private trusted fun __ablaRuntimeHostEnterFromOutside(): int {
    val share = __ablaRuntimeHostExportShareAddress()
    if (ablaRuntimeAtomicLoadI64(share) != 2) {
        if (ablaRuntimeAtomicCompareExchangeI64(share, 0, 1) == 0) {
            __ablaRuntimeHostThreadsShare()
            ablaRuntimeAtomicStoreI64(share, 2)
        } else {
            while (ablaRuntimeAtomicLoadI64(share) != 2) {}
        }
    }
    __ablaRuntimePlatformThreadRegister()
    // A call that comes in while the thread is in native code (an export called from a host callback the library called)
    // runs Abla code: the thread stops counting as stopped until that export returns (a bit per level, popped by Leave).
    val record = __ablaRuntimeHostStwRecord()
    var levels = ablaRuntimeLoadI64(record + 56) * 2
    if (ablaRuntimeAtomicLoadI64(record + 24) < 0) {
        __ablaRuntimePlatformNativeLeave()
        levels = levels + 1
    }
    ablaRuntimeStoreI64(record + 56, levels)
    ablaRuntimeAtomicFetchAddI64(__ablaRuntimeHostExportInsideAddress(), 1)
    0
}

private trusted fun __ablaRuntimeHostLeaveToOutside(): int {
    ablaRuntimeAtomicFetchAddI64(__ablaRuntimeHostExportInsideAddress(), -1)
    val record = __ablaRuntimeHostStwRecord()
    val levels = ablaRuntimeLoadI64(record + 56)
    ablaRuntimeStoreI64(record + 56, levels >>> 1)
    if ((levels & 1) == 1) __ablaRuntimePlatformNativeEnter()
    __ablaRuntimePlatformThreadUnregister()
    0
}

// 1 when the caller is to initialize the globals, 0 when they are initialized or the caller is the thread doing it.
trusted fun __ablaRuntimeExportInitBegin(): int {
    val state = __ablaRuntimeHostExportInitAddress()
    val owner = __ablaRuntimeHostExportInitThreadAddress()
    val me = __ablaRuntimeHostRootFrameAddress()
    var result = -1
    while (result < 0) {
        val seen = ablaRuntimeAtomicCompareExchangeI64(state, 0, 1)
        if (seen == 0) {
            ablaRuntimeAtomicStoreI64(owner, me)
            result = 1
        } else if (seen == 2 || ablaRuntimeAtomicLoadI64(owner) == me) result = 0
    }
    result
}

/// Completes exported-global initialization and returns zero.
trusted fun __ablaRuntimeExportInitEnd(): int {
    ablaRuntimeAtomicStoreI64(__ablaRuntimeHostExportInitAddress(), 2)
    0
}


// ---- Stop-the-world collection (#811) -------------------------------------------------------------------------
// A collection needs every thread's roots, and no thread running while it marks and sweeps. Threads register a record
// in a list; the thread that collects (it runs a safe point past the threshold) makes the others stop at their next
// safe point by setting the byte threshold to 0, so each one's next safe point calls the collector, finds a collection
// under way and parks there. Its roots are then stable on its own chain, which the collector walks with its own.
//   A thread's record (raw memory, from its registration to its last leave; a word of thread-local storage holds its
//   address): 0 next record  8 the thread's root cell (the block above: head, region)  16 the thread's number
//   24 parked  32 registration depth  40 1 while the thread's own pressure collection holds the stop
//   48 1 when it parked for another thread's collection  56 the export levels  64 its kernel thread id (0 off Linux).
//   `parked` holds the stop's token while the thread waits at a safe point, -1 while it is in native code that blocks
//   (a join), where the collector may claim it (its token) and the thread, coming back, waits for the stop to end.
//   The stop's word: even when no collection is under way, odd (its token) from the moment a thread wins it.
// A thread in a region, or one that never reaches a safe point (blocked in the system, a loop that does not allocate),
// cannot park: the stop is abandoned after __ablaRuntimeHostStwWaitMilliseconds (counted, and ABLA_GC_TRACE=1 says
// which thread) and the collection does not run; no stop starts for ten times that long afterwards. (A poll that found this
// thread off the CPU for 2 ms or more moves the deadline by that time, up to ten times the wait. At the deadline a thread the system
// reports as R with almost no processor time since the last look has not been scheduled: the wait goes on, up to a second.)
// The block (static storage): 0 the word  8 the registry's lock  16 its head  24 threads numbered  32 collections
// that stopped threads  40 stops abandoned  48 the collector's record  56 the threshold before the stop  64 frames
// of exited threads (the permanent global-roots frames)  72 unused (the clock scratch is thread-local)  96 number scratch (32)
// 128 no stop starts before this time (milliseconds), after one was abandoned  136 the debug hold  144 free records
// 160 the path of a thread's stat file (48)  208 what was read from it (256)
private trusted fun __ablaRuntimeHostStwAddress(): int = nativeStaticAllocate(480)

// The calling thread's record (0 before its first registration).
private trusted fun __ablaRuntimeHostStwRecordCell(): int =
    nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

private trusted fun __ablaRuntimeHostStwRecord(): int =
    ablaRuntimeLoadI64(__ablaRuntimeHostStwRecordCell())

/// Controls host collector tracing.
var __ablaRuntimeHostGcTrace: bool = __ablaRuntimeHostGcTraceConfigured()

/// Returns whether the startup environment enables collector tracing.
@noinline
trusted fun __ablaRuntimeHostGcTraceConfigured(): bool {
    val value = ablaRuntimePointerAddress(__ablaRuntimeHostGetenv(ablaRuntimePointerFromAddress(
        __ablaRuntimeWord0("ABLA_GC_TRACE")
    )))
    value != 0 && ablaRuntimeLoadU8(value) == 49 && ablaRuntimeLoadU8(value + 1) == 0
}

// The thread joins the registry; nested registrations (an export called from an export) count.
trusted fun __ablaRuntimePlatformThreadRegister(): void {
    var record = __ablaRuntimeHostStwRecord()
    if (record != 0) {
        ablaRuntimeStoreI64(record + 32, ablaRuntimeLoadI64(record + 32) + 1)
        return
    }
    val stw = __ablaRuntimeHostStwAddress()
    // Records of exited threads are reused (+144 heads the list), so a program that starts many threads allocates
    // no more than its most at once.
    __ablaRuntimeFutexLock(stw + 8)
    record = ablaRuntimeLoadI64(stw + 144)
    if (record != 0) ablaRuntimeStoreI64(stw + 144, ablaRuntimeLoadI64(record))
    __ablaRuntimeFutexUnlock(stw + 8)
    if (record == 0) record = __ablaRuntimePlatformRawAllocate(72)
    ablaRuntimeStoreI64(record + 64, __ablaRuntimeHostStwThreadId())
    ablaRuntimeStoreI64(record + 8, __ablaRuntimeHostRootFrameAddress())
    ablaRuntimeStoreI64(record + 24, 0)
    ablaRuntimeStoreI64(record + 32, 1)
    ablaRuntimeStoreI64(record + 40, 0)
    ablaRuntimeStoreI64(record + 56, 0)
    ablaRuntimeStoreI64(record + 48, 0)
    __ablaRuntimeFutexLock(stw + 8)
    ablaRuntimeStoreI64(record, ablaRuntimeLoadI64(stw + 16))
    ablaRuntimeStoreI64(stw + 16, record)
    val number = ablaRuntimeLoadI64(stw + 24) + 1
    ablaRuntimeStoreI64(stw + 24, number)
    ablaRuntimeStoreI64(record + 16, number)
    ablaRuntimeStoreI64(__ablaRuntimeHostStwRecordCell(), record)
    __ablaRuntimeFutexUnlock(stw + 8)
    return
}

// The outermost leave: the record leaves the registry. Frames still on the thread's chain are permanent (the static
// frame of an export's globals, never popped): they move to the registry's own chain, which every collection marks.
trusted fun __ablaRuntimePlatformThreadUnregister(): void {
    val record = __ablaRuntimeHostStwRecord()
    if (record == 0) return
    val depth = ablaRuntimeLoadI64(record + 32) - 1
    ablaRuntimeStoreI64(record + 32, depth)
    if (depth != 0) return
    val cell = __ablaRuntimeHostRootFrameAddress()
    val stw = __ablaRuntimeHostStwAddress()
    __ablaRuntimeFutexLock(stw + 8)
    var at = stw + 16
    var seen = ablaRuntimeLoadI64(at)
    while (seen != 0 && seen != record) {
        at = seen
        seen = ablaRuntimeLoadI64(at)
    }
    if (seen == record) ablaRuntimeStoreI64(at, ablaRuntimeLoadI64(record))
    val head = ablaRuntimeLoadI64(cell)
    if (head != 0) {
        var tail = head
        while (ablaRuntimeLoadI64(tail) != 0) tail = ablaRuntimeLoadI64(tail)
        ablaRuntimeStoreI64(tail, ablaRuntimeLoadI64(stw + 64))
        ablaRuntimeStoreI64(stw + 64, head)
        ablaRuntimeStoreI64(cell, 0)
    }
    ablaRuntimeStoreI64(__ablaRuntimeHostStwRecordCell(), 0)
    ablaRuntimeStoreI64(record, ablaRuntimeLoadI64(stw + 144))
    ablaRuntimeStoreI64(stw + 144, record)
    __ablaRuntimeFutexUnlock(stw + 8)
    return
}

// The calling thread waits for the stop `token` to end, parked.
private trusted fun __ablaRuntimeHostStwPark(token: int, record: int): void {
    val stw = __ablaRuntimeHostStwAddress()
    ablaRuntimeAtomicStoreI64(record + 24, token)
    while (ablaRuntimeAtomicLoadI64(stw) == token) {
        __ablaRuntimeHostForkCheck()
        if (ablaRuntimeAtomicLoadI64(stw) == token) __ablaRuntimeFutexWait(stw, token)
    }
    ablaRuntimeStoreI64(record + 48, 1)
    return
}

// In native code that blocks (a join) the thread counts as parked: its chain is stable. Coming back it waits out
// a stop that claimed it.
trusted fun __ablaRuntimePlatformNativeEnter(): void {
    val record = __ablaRuntimeHostStwRecord()
    if (record != 0) ablaRuntimeAtomicStoreI64(record + 24, -1)
    return
}

// Leaves native code only when the thread is in it: true when it was, and the caller enters it again before going
// back (a compiler export a JIT-compiled program calls from a thread the compiler marked native, runtimeNativeLeave).
trusted fun __ablaRuntimePlatformNativeLeaveIfIn(): bool {
    val record = __ablaRuntimeHostStwRecord()
    if (record == 0 || ablaRuntimeAtomicLoadI64(record + 24) >= 0) return false
    __ablaRuntimePlatformNativeLeave()
    true
}

/// Returns the calling thread from a native boundary to runtime-managed execution.
trusted fun __ablaRuntimePlatformNativeLeave(): void {
    val record = __ablaRuntimeHostStwRecord()
    if (record == 0) return
    val stw = __ablaRuntimeHostStwAddress()
    while (true) {
        val seen = ablaRuntimeAtomicCompareExchangeI64(record + 24, -1, 0)
        if (seen == -1 || seen >= 0) return
        // A collection claimed the thread while it was away (its claim is -2 - the stop's token): wait for the
        // stop to end, then try again: the stop put the thread back to -1, and the next stop may have claimed it
        // already (a plain store of 0 here would let that stop collect while this thread runs).
        val token = -2 - seen
        while (ablaRuntimeAtomicLoadI64(stw) == token) {
            // A child of a fork that came back from the system call during a stop: the collector did not survive the
            // fork, and the repair (the first thing a forked child's check finds) ends the stop and clears this claim.
            __ablaRuntimeHostForkCheck()
            if (ablaRuntimeAtomicLoadI64(stw) == token) __ablaRuntimeFutexWait(stw, token)
        }
    }
    return
}

// The calling thread's own 16 bytes for the clock and the sleep: the block's shared scratch let one thread's clock_gettime
// overwrite the seconds another thread was about to hand to nanosleep, which then slept for the machine's uptime (#1040).
private trusted fun __ablaRuntimeHostStwClockScratch(): int =
    nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

private trusted fun __ablaRuntimeHostStwMilliseconds(): int {
    val scratch = __ablaRuntimeHostStwClockScratch()
    __ablaRuntimeOsMonotonicTime(scratch)
    ablaRuntimeLoadI64(scratch) * 1000 + ablaRuntimeLoadI64(scratch + 8) / 1000000
}

// CLOCK_MONOTONIC in microseconds, for the phase times of a traced collection (ABLA_GC_TRACE).
private trusted fun __ablaRuntimeHostStwMicroseconds(): int {
    val scratch = __ablaRuntimeHostStwClockScratch()
    __ablaRuntimeOsMonotonicTime(scratch)
    ablaRuntimeLoadI64(scratch) * 1000000 + ablaRuntimeLoadI64(scratch + 8) / 1000
}

private trusted fun __ablaRuntimeHostStwSleep(): void {
    val scratch = __ablaRuntimeHostStwClockScratch()
    ablaRuntimeStoreI64(scratch, 0)
    ablaRuntimeStoreI64(scratch + 8, 20000)
    __ablaRuntimeOsSleep(scratch)
    return
}

// The calling thread's kernel id (x86-64 and AArch64 Linux); 0 elsewhere, where a thread's state cannot be read.
private trusted fun __ablaRuntimeHostStwThreadId(): int = __ablaRuntimeOsThreadId()

private trusted fun __ablaRuntimeHostStwAppend(at: int, text: int): int {
    var length = 0
    while (ablaRuntimeLoadU8(text + length) != 0) {
        ablaRuntimeStoreU8(at + length, ablaRuntimeLoadU8(text + length))
        length = length + 1
    }
    at + length
}

// What /proc/self/task/<id>/stat says of a thread: its processor time (user and system, clock ticks) doubled, plus 1 when its
// state (field 3) is R, runnable or running; -1 when it cannot be read (no /proc, a thread that ended, another system).
private trusted fun __ablaRuntimeHostStwProbe(id: int): int {
    if (id <= 0) return -1
    val arch = ablaSimdTargetArch()
    if (arch != 1 && arch != 2) return -1
    val stw = __ablaRuntimeHostStwAddress()
    val path = stw + 160
    var at = __ablaRuntimeHostStwAppend(path, __ablaRuntimeWord0("/proc/self/task/"))
    var scale = 1
    while (id / scale >= 10) scale = scale * 10
    while (scale > 0) {
        ablaRuntimeStoreU8(at, 48 + id / scale % 10)
        at = at + 1
        scale = scale / 10
    }
    at = __ablaRuntimeHostStwAppend(at, __ablaRuntimeWord0("/stat"))
    ablaRuntimeStoreU8(at, 0)
    val descriptor = __ablaRuntimeOsOpenRead(path)
    if (descriptor < 0) return -1
    val buffer = stw + 208
    val got = __ablaRuntimeOsRead(descriptor, buffer, 255)
    __ablaRuntimeOsClose(descriptor)
    if (got <= 0) return -1
    // "id (name) S ppid ...": the name may hold a parenthesis, so the fields start after the last one.
    var position = got - 1
    while (position >= 0 && ablaRuntimeLoadU8(buffer + position) != 41) position = position - 1
    if (position < 0 || position + 3 >= got) return -1
    val runnable = if (ablaRuntimeLoadU8(buffer + position + 2) == 82) 1 else 0
    position = position + 3
    // ppid, pgrp, session, tty, tpgid, flags, minflt, cminflt, majflt, cmajflt lie between the state and utime.
    var skipped = 0
    while (skipped < 10 && position < got) {
        position = position + 1
        while (position < got && ablaRuntimeLoadU8(buffer + position) != 32) position = position + 1
        skipped = skipped + 1
    }
    if (skipped < 10) return -1
    var ticks = 0
    var part = 0
    while (part < 2) {
        position = position + 1
        var value = 0
        while (position < got && ablaRuntimeLoadU8(buffer + position) >= 48 && ablaRuntimeLoadU8(buffer + position) <= 57) {
            value = value * 10 + ablaRuntimeLoadU8(buffer + position) - 48
            position = position + 1
        }
        ticks = ticks + value
        part = part + 1
    }
    ticks * 2 + runnable
}

private trusted fun __ablaRuntimeHostStwWriteNumber(value: int): void {
    val scratch = __ablaRuntimeHostStwAddress() + 96
    var digits = 0
    var rest = value
    if (rest < 0) rest = 0
    while (true) {
        ablaRuntimeStoreU8(scratch + 31 - digits, 48 + rest % 10)
        digits = digits + 1
        rest = rest / 10
        if (rest == 0) break
    }
    __ablaRuntimeHostWrite(2, scratch + 32 - digits, digits)
    return
}

// How long the collector waits for the others to park.
private trusted fun __ablaRuntimeHostStwWaitMilliseconds(): int = 20

// The longest a stop goes on waiting for a thread the system says is runnable but that has not run.
private trusted fun __ablaRuntimeHostStwRunnableMilliseconds(): int = 1000

private trusted fun __ablaRuntimeHostStwTrace(message: string, length: int, number: int, tail: string, tailLength: int): void {
    if (!__ablaRuntimeHostGcTrace) return
    __ablaRuntimeHostWrite(2, __ablaRuntimeWord0(message), length)
    __ablaRuntimeHostStwWriteNumber(number)
    __ablaRuntimeHostWrite(2, __ablaRuntimeWord0(tail), tailLength)
    return
}

// The stop `token` ends: threads it claimed in native code are in native code again (the registry's lock is held).
private trusted fun __ablaRuntimeHostStwUnclaim(token: int): void {
    var other = ablaRuntimeLoadI64(__ablaRuntimeHostStwAddress() + 16)
    while (other != 0) {
        ablaRuntimeAtomicCompareExchangeI64(other + 24, -2 - token, -1)
        other = ablaRuntimeLoadI64(other)
    }
    return
}

// 0: the thread was parked for another's collection, or the stop was abandoned, or it may not collect: it does not
// collect. 1: every other thread is parked, the registry stays locked until __ablaRuntimeHostStwRelease. 2: no
// other thread can exist (the runtime never shared), no stop is needed.
@noinline
trusted fun __ablaRuntimeHostStwStop(): int {
    if (!__ablaRuntimePlatformThreadsEnabled()) return 2
    val me = __ablaRuntimeHostStwRecord()
    // A thread that never registered cannot be stopped nor walked: it does not collect.
    if (me == 0) return 0
    val stw = __ablaRuntimeHostStwAddress()
    var token = ablaRuntimeAtomicLoadI64(stw)
    while (true) {
        if ((token & 1) == 1) {
            __ablaRuntimeHostStwPark(token, me)
            return 0
        }
        // After an abandoned stop the next attempt waits (a thread blocked in the system would stall each collection).
        if (ablaRuntimeLoadI64(stw + 128) != 0 && __ablaRuntimeHostStwMilliseconds() < ablaRuntimeLoadI64(stw + 128)) return 0
        val seen = ablaRuntimeAtomicCompareExchangeI64(stw, token, token + 1)
        if (seen == token) break
        token = seen
    }
    token = token + 1
    ablaRuntimeStoreI64(stw + 48, me)
    ablaRuntimeStoreI64(stw + 56, __ablaRuntimeHostCollectionThreshold)
    // Every other thread's next safe point calls the collector.
    __ablaRuntimeHostCollectionThreshold = 0
    // The wait is the collector's own wall time, so on a loaded machine a thread that is not scheduled looks like one that
    // never parks. Each time this thread itself was off the CPU between two polls (a 20 us sleep that took 2 ms or more) the
    // deadline moves by that time, since the thread that has to park was probably off it too; the total is capped at ten
    // times the wait. A thread that never parks is still abandoned (a little later on a loaded machine).
    val started = __ablaRuntimeHostStwMilliseconds()
    var deadline = started + __ablaRuntimeHostStwWaitMilliseconds()
    var lastPoll = started
    var probedNumber = 0
    var probedTicks = 0
    var stopped = 0
    while (stopped == 0) {
        __ablaRuntimeFutexLock(stw + 8)
        var blocker = 0
        var reason = 0
        var other = ablaRuntimeLoadI64(stw + 16)
        var others = 0
        while (other != 0) {
            if (other != me) {
                others = others + 1
                val state = ablaRuntimeAtomicLoadI64(other + 24)
                var isParked = state == token || state == -2 - token
                if (!isParked && state == -1) {
                    isParked = ablaRuntimeAtomicCompareExchangeI64(other + 24, -1, -2 - token) == -1
                }
                if (ablaRuntimeLoadI64(ablaRuntimeLoadI64(other + 8) + 8) != 0) {
                    // A thread in a region never parks.
                    blocker = other
                    reason = 2
                } else if (!isParked && blocker == 0) {
                    blocker = other
                    reason = 1
                }
            }
            other = ablaRuntimeLoadI64(other)
        }
        if (blocker == 0) {
            if (__ablaRuntimeHostGcTrace) __ablaRuntimeHostStwTrace("gc: stopped ", 12, others, " thread(s)\n", 11)
            ablaRuntimeStoreI64(stw + 32, ablaRuntimeLoadI64(stw + 32) + 1)
            stopped = 1
        } else {
            val number = ablaRuntimeLoadI64(blocker + 16)
            val threadId = ablaRuntimeLoadI64(blocker + 64)
            __ablaRuntimeFutexUnlock(stw + 8)
            val now = __ablaRuntimeHostStwMilliseconds()
            if (now - lastPoll >= 2) {
                deadline = deadline + now - lastPoll
                val limit = started + 10 * __ablaRuntimeHostStwWaitMilliseconds()
                if (deadline > limit) deadline = limit
            }
            lastPoll = now
            var giveUp = reason == 2
            if (!giveUp && now >= deadline) {
                giveUp = true
                // Only here, once the wait is over, is the thread's state read (a thread that just has not been scheduled yet is
                // R, a thread blocked in the system is S or D). One that is R and has used less than two clock ticks of processor
                // time since the last look has not run for the whole wait: it cannot have passed a safe point, so the wait goes
                // on, up to a second in all. One that ran and still did not park (a loop without a safe point) is given up on.
                if (now < started + __ablaRuntimeHostStwRunnableMilliseconds()) {
                    val probe = __ablaRuntimeHostStwProbe(threadId)
                    if (probe >= 0 && (probe & 1) == 1) {
                        if (probedNumber != number) {
                            probedNumber = number
                            probedTicks = probe >>> 1
                            deadline = now + __ablaRuntimeHostStwWaitMilliseconds()
                            giveUp = false
                        } else if ((probe >>> 1) - probedTicks < 2) {
                            deadline = now + __ablaRuntimeHostStwWaitMilliseconds()
                            giveUp = false
                        }
                    }
                }
            }
            if (giveUp) {
                __ablaRuntimeFutexLock(stw + 8)
                __ablaRuntimeHostStwUnclaim(token)
                __ablaRuntimeFutexUnlock(stw + 8)
                ablaRuntimeStoreI64(stw + 40, ablaRuntimeLoadI64(stw + 40) + 1)
                if (__ablaRuntimeHostGcTrace) {
                    if (reason == 2) {
                        __ablaRuntimeHostStwTrace("gc: stop abandoned (thread ", 27, number, " is in a region)\n", 17)
                    } else {
                        __ablaRuntimeHostStwTrace("gc: stop abandoned (thread ", 27, number, " not parked after ", 18)
                        __ablaRuntimeHostStwWriteNumber(now - started)
                        __ablaRuntimeHostWrite(2, __ablaRuntimeWord0(" ms)\n"), 5)
                    }
                }
                ablaRuntimeStoreI64(stw + 48, 0)
