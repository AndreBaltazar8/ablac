    var regionAddress: int = __ablaRuntimeHostRegionCache
    if (regionAddress != 0) {
        __ablaRuntimeHostRegionCache = ablaRuntimeLoadI64(regionAddress)
        __ablaRuntimeHostRegionCacheCount =
            __ablaRuntimeHostRegionCacheCount - 1
    } else {
        regionAddress = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(24))
        if (regionAddress == 0) __ablaRuntimeHostOutOfMemory()
    }
    ablaRuntimeStoreI64(regionAddress, __ablaRuntimeHostRegionLoad())
    ablaRuntimeStoreI64(regionAddress + 8, 0)
    ablaRuntimeStoreI64(regionAddress + 16, 0)
    __ablaRuntimeHostRegionStore(regionAddress)
    __ablaRuntimeHostHeapUnlock(mutex)
    regionAddress
}

trusted fun __ablaRuntimePlatformRegionEnd(regionAddress: int): void {
    val mutex = __ablaRuntimeHostHeapLock()
    if (regionAddress == 0 ||
        regionAddress != __ablaRuntimeHostRegionLoad()) ablaRuntimeTrap()
    val parent = ablaRuntimeLoadI64(regionAddress)
    val pages = ablaRuntimeLoadI64(regionAddress + 8)
    val live = ablaRuntimeLoadI64(regionAddress + 16)
    if (live < 0 || live > __ablaRuntimeHostLiveBytes) ablaRuntimeTrap()
    __ablaRuntimeHostLiveBytes = __ablaRuntimeHostLiveBytes - live
    __ablaRuntimeHostRegionPagesRelease(pages)
    __ablaRuntimeHostRegionStore(parent)
    if (__ablaRuntimeHostRegionCacheCount <
        __ablaRuntimeHostRegionCachedDescriptors) {
        ablaRuntimeStoreI64(regionAddress, __ablaRuntimeHostRegionCache)
        __ablaRuntimeHostRegionCache = regionAddress
        __ablaRuntimeHostRegionCacheCount =
            __ablaRuntimeHostRegionCacheCount + 1
    } else __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(regionAddress))
    __ablaRuntimeHostHeapUnlock(mutex)
}

trusted fun __ablaRuntimePlatformRegionActive(): bool =
    __ablaRuntimeHostRegionLoad() != 0

// Return an equivalent allocation owned by the parent region. This is the
// uncommon backpressure/lifetime boundary; ordinary request allocations stay
// on the zero-malloc bump path.
trusted fun __ablaRuntimePlatformPromoteAllocation(address: int): int {
    if (__ablaRuntimeHostRegionLoad() == 0) return address
    val size = ablaRuntimeLoadI64(address - 16)
    val child = __ablaRuntimeHostRegionLoad()
    __ablaRuntimeHostRegionStore(ablaRuntimeLoadI64(child))
    val promoted = __ablaRuntimePlatformAllocate(size)
    __ablaRuntimeHostRegionStore(child)
    var index: int = 0
    while (index < size) {
        ablaRuntimeStoreU8(
            promoted + index, ablaRuntimeLoadU8(address + index)
        )
        index = index + 1
    }
    __ablaRuntimePlatformFree(address)
    promoted
}

// Prints the stack to standard error in a debug build (the compiler gives it
// that body); does nothing elsewhere.
trusted fun __ablaRuntimePrintStack(): void {}

// Inside a checked export, a panic's message goes to its caller's buffer (as
// much as fits; the length is the whole message's) and the export resumes at
// its recovery frame; elsewhere this returns and the panic ends the program.
trusted fun __ablaRuntimeHostRecover(data: int, length: int): int {
    val frame = ablaRuntimeLoadI64(__ablaRuntimeHostRecoveryAddress())
    if (frame != 0) {
        val buffer = ablaRuntimeLoadI64(frame + 24)
        val capacity = ablaRuntimeLoadI64(frame + 32)
        val lengthAddress = ablaRuntimeLoadI64(frame + 40)
        var index = 0
        while (buffer != 0 && index < length && index < capacity) {
            ablaRuntimeStoreU8(buffer + index, ablaRuntimeLoadU8(data + index))
            index = index + 1
        }
        if (lengthAddress != 0) ablaRuntimeStoreI64(lengthAddress, length)
        _longjmp(ablaRuntimePointerFromAddress(frame + 48), 1)
    }
    0
}

// `panic` from abla/process/exit (through __ablaPanicContain's compiler-given
// body): the same recovery as a runtime panic.
trusted fun __ablaRuntimePanicContain(data: int, length: int): int =
    __ablaRuntimeHostRecover(data, length)

// The runtime's own standard-error writes and its exit: on macOS the BSD system calls
// (write 4, exit 1), so a macOS program imports neither libSystem's write nor _exit for
// them (#811); elsewhere the C functions, which Linux's builds supply by system call.
// `ablaHostIsMacOS()` is a constant: each function keeps one side only.
trusted fun __ablaRuntimeHostWrite(descriptor: int, data: int, length: int): int {
    if (ablaHostIsMacOS()) return ablaDarwinSyscall(4, descriptor, data, length, 0, 0, 0)
    write(descriptor, ablaRuntimePointerFromAddress(data), length)
}

trusted fun __ablaRuntimeHostExit(status: int): void {
    if (ablaHostIsMacOS()) {
        while (true) ablaDarwinSyscall(1, status, 0, 0, 0, 0, 0)
    }
    _exit(status)
    return
}

// A panic raised by the runtime or by compiled code (division by zero, an
// index out of bounds, the memory limit) ends the program the way `panic`
// from abla/process/exit does: "panic: <message>" on standard error, the stack
// in a debug build, then exit status 101.
// String literals are flat, so their data is word 0: __ablaRuntimeStringData's
// rope path (which allocates) would keep the whole allocator in every program
// that can panic, even one that never allocates.
@noinline
trusted fun __ablaRuntimePlatformPanic(data: int, length: int): int {
    __ablaRuntimeHostRecover(data, length)
    __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("panic: "), 7)
    __ablaRuntimeHostWrite(2, data, length)
    __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("\n"), 1)
    __ablaRuntimePrintStack()
    __ablaRuntimeHostExit(101)
    0
}

var __ablaRuntimeHostOutOfMemorySeen: int = 0

// The system refused memory: usually a limit on the process rather than the machine (ulimit -v, or the compiler's launcher,
// which sets it from ABLA_MAX_MEMORY_MB). A trap would say nothing. If reporting it needs memory too, that ends it.
// Share this failed-allocation path between the allocator's checks.
@noinline
trusted fun __ablaRuntimeHostOutOfMemory(): void {
    if (__ablaRuntimeHostOutOfMemorySeen != 0) __ablaRuntimeHostExit(101)
    __ablaRuntimeHostOutOfMemorySeen = 1
    // On macOS the refusal says what the system answered (no allocation: the strings are static).
    if (ablaHostIsMacOS()) {
        val errno = __ablaRuntimeHostMapFailErrno
        if (errno == 12) __ablaRuntimeHostWrite(2,
            __ablaRuntimeWord0("abla heap: the last mmap failed with ENOMEM"), 43)
        else if (errno == 22) __ablaRuntimeHostWrite(2,
            __ablaRuntimeWord0("abla heap: the last mmap failed with EINVAL"), 43)
        else if (errno == 38) __ablaRuntimeHostWrite(2,
            __ablaRuntimeWord0("abla heap: the last mmap failed with ENOSYS (no such system call)"),
            65)
        else if (errno != 0) __ablaRuntimeHostWrite(2,
            __ablaRuntimeWord0("abla heap: the last mmap failed with another error"), 50)
        else __ablaRuntimeHostWrite(2,
            __ablaRuntimeWord0("abla heap: no mmap failed (an allocation size was refused)"), 58)
        __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("\n"), 1)
        if (errno != 0) {
            if (__ablaRuntimeHostMapFailBytes >= 68719476736) __ablaRuntimeHostWrite(2,
                __ablaRuntimeWord0("abla heap: that request was 64 GiB or more"), 42)
            else __ablaRuntimeHostWrite(2,
                __ablaRuntimeWord0("abla heap: that request was under 64 GiB"), 40)
            __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("\n"), 1)
        }
    }
    __ablaRuntimePlatformPanic(
        __ablaRuntimeStringData("out of memory: the system refused an allocation; raise the process's limit (ulimit -v, or ABLA_MAX_MEMORY_MB for ablac)"),
        119
    )
    return
}

// A float `%` (f64 and f32) on x86-64 Linux, which then needs no fmod or fmodf
// from libm (#806): the backend calls this there instead of LLVM's frem. The
// same exact algorithm as WebAssembly's (platform/wasm.ab): C's fmod, x - n·y
// for the integer n that x / y truncates to, with x's sign, every step exact.
trusted fun __ablaRuntimeFloatRemainder(x: f64, y: f64): f64 {
    if (x != x || y != y || y == 0.0 || x - x != 0.0) return (x * y) / (x * y)
    val divisor = if (y < 0.0) y * -1.0 else y
    var rest = if (x < 0.0) x * -1.0 else x
    if (rest < divisor) return x
    // The largest divisor·2^k not above rest (doubling is exact short of
    // infinity), then back down to divisor: each step t has rest < 2t, so
    // rest - t is exact when rest >= t (Sterbenz), and halving t is exact.
    var step = divisor
    while (step + step <= rest) step = step + step
    while (step >= divisor) {
        if (rest >= step) rest = rest - step
        step = step * 0.5
    }
    if (x < 0.0) rest * -1.0 else rest
}

// macOS: the Linux-style system calls of the portable standard library over the
// BSD system calls themselves (#811: a macOS program should import as little of
// libSystem as it can). `ablaDarwinSyscall` is the BSD number and six arguments,
// the result -errno on failure (backend: bootstrapLlvmInlineDarwinSyscall).
// A Linux number this dispatcher does not handle goes to the C adapter
// (runtime/abla_darwin_compat.c), which keeps those cases until each group has
// moved here; its own cases for the numbers handled here exist only for iOS.
// `ablaHostIsMacOS()` is a constant: on every other target this function is
// dead and the C call below never links.
trusted noescape extern:"intrinsic" fun ablaDarwinSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int
// The same with five arguments and the second result register (x1 / rdx: fork's child flag, the second descriptor of
// pipe) stored at `second`.
trusted noescape extern:"intrinsic" fun ablaDarwinSyscallPair(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    second: int
): int
trusted noescape extern:"c" fun abla_darwin_linux_syscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int


// ---- Frozen groups (docs/design/frozen-heap.md): graphs copied into read-only memory that the collector does not trace
// or sweep. A group is made by __ablaRuntimePlatformMemoryFreeze: the value's whole reachable graph is copied into pages of
// a reserved window, then made read-only; the copy points only at frozen blocks or at memory outside the heap, so no
// young block can be missed, and a store into it faults. Marking a pointer into the window marks the pointer's group; a
// group holds the groups it points at (its edges); a group no collection reached is returned to the window whole.
// Linux only: where the window cannot be reserved, a freeze returns its value unchanged.

// The window: [base, end), 0 until the first freeze.
var __ablaRuntimeHostFrozenBase: int = 0
var __ablaRuntimeHostFrozenEnd: int = 0

// +0 the next free address of the window, +8 groups made (the table below is indexed by it), +16 bytes accounted,
// +24 freezes refused, +32 the last refusal's reason.
private trusted fun __ablaRuntimeHostFrozenState(): int = nativeStaticAllocate(64)

// 1024 group records of 48 bytes: +0 start, +8 mapped length (0: reclaimed), +16 reached by the mark (0/1), +24 the groups it
// points at (a malloc'd array of indexes), +32 their count, +40 the live bytes it accounts for.
private trusted fun __ablaRuntimeHostFrozenGroups(): int = nativeStaticAllocate(49152)

// The freeze's working state (one freeze at a time, under the stop and the heap lock): +0 the blocks (old headers), +8 their
// count, +16 their capacity, +24 the forwarding table (16-byte entries: old header, index + 1), +32 its capacity, +40 the bytes
// of the group so far, +48 offsets of the blocks, +56 flags (1: data only), +64 the groups pointed at, +72 their count,
// +80 failure reason (0 none), +88 the group's base address (0 while discovering).
private trusted fun __ablaRuntimeHostFreezeContext(): int = nativeStaticAllocate(96)

@inline
trusted fun __ablaRuntimeHostFrozenIn(address: int): bool =
    __ablaRuntimeHostFrozenBase != 0 &&
    u64(address - __ablaRuntimeHostFrozenBase) < u64(__ablaRuntimeHostFrozenEnd - __ablaRuntimeHostFrozenBase)

// The window is cut into 64 KiB chunks; a group owns a run of them. 16384 chunks (1 GiB) at most, each owner entry 4 bytes:
// 0 free, else the group's record + 1.
private trusted fun __ablaRuntimeHostFrozenOwners(): int = nativeStaticAllocate(65536)

// The record of the group holding `address` (in the window), or 0.
trusted fun __ablaRuntimeHostFrozenGroupOf(address: int): int {
    val owner = ablaRuntimeLoadI32(__ablaRuntimeHostFrozenOwners() + ((address - __ablaRuntimeHostFrozenBase) >>> 16) * 4)
    if (owner == 0) 0 else __ablaRuntimeHostFrozenGroups() + (owner - 1) * 48
}

// The mark reached `address`, in the window.
@noinline
trusted fun __ablaRuntimeHostFrozenMark(address: int): void {
    val group = __ablaRuntimeHostFrozenGroupOf(address)
    if (group != 0) ablaRuntimeStoreI64(group + 16, 1)
    return
}

// After the mark: the groups the reached ones point at are reached too, and what none reached goes back to the window.
trusted fun __ablaRuntimeHostFrozenReclaim(): void {
    val count = ablaRuntimeLoadI64(__ablaRuntimeHostFrozenState() + 8)
    if (count == 0) return
    val groups = __ablaRuntimeHostFrozenGroups()
    var changed = true
    while (changed) {
        changed = false
        var index = 0
        while (index < count) {
            val group = groups + index * 48
            if (ablaRuntimeLoadI64(group + 16) != 0 && ablaRuntimeLoadI64(group + 8) != 0) {
                val edges = ablaRuntimeLoadI64(group + 24)
                var edge = 0
                while (edge < ablaRuntimeLoadI64(group + 32)) {
                    val target = groups + ablaRuntimeLoadI64(edges + edge * 8) * 48
                    if (ablaRuntimeLoadI64(target + 16) == 0) {
                        ablaRuntimeStoreI64(target + 16, 1)
                        changed = true
                    }
                    edge = edge + 1
                }
            }
            index = index + 1
        }
    }
    var index = 0
    while (index < count) {
        val group = groups + index * 48
        val length = ablaRuntimeLoadI64(group + 8)
        if (length != 0) {
            if (ablaRuntimeLoadI64(group + 16) == 0) {
                // Back to reserved, unbacked address space (a fixed anonymous no-access mapping over it).
                ablaLinuxSyscall(9, ablaRuntimeLoadI64(group), length, 0, 16418 + 16, -1, 0)
                var chunk = (ablaRuntimeLoadI64(group) - __ablaRuntimeHostFrozenBase) >>> 16
                val chunkEnd = chunk + (length >>> 16)
                while (chunk < chunkEnd) {
                    ablaRuntimeStoreI32(__ablaRuntimeHostFrozenOwners() + chunk * 4, 0)
                    chunk = chunk + 1
                }
                __ablaRuntimeHostLiveBytes = __ablaRuntimeHostLiveBytes - ablaRuntimeLoadI64(group + 40)
                ablaRuntimeStoreI64(__ablaRuntimeHostFrozenState() + 16,
                    ablaRuntimeLoadI64(__ablaRuntimeHostFrozenState() + 16) - ablaRuntimeLoadI64(group + 40))
                __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(group + 24)))
                ablaRuntimeStoreI64(group + 24, 0)
                ablaRuntimeStoreI64(group + 32, 0)
                ablaRuntimeStoreI64(group + 8, 0)
                ablaRuntimeStoreI64(group + 40, 0)
            } else ablaRuntimeStoreI64(group + 16, 0)
        }
        index = index + 1
    }
    return
}

// The block index of old header `header` in the forwarding table, or -1.
trusted fun __ablaRuntimeHostFreezeFind(header: int): int {
    val context = __ablaRuntimeHostFreezeContext()
    val table = ablaRuntimeLoadI64(context + 24)
    val mask = ablaRuntimeLoadI64(context + 32) - 1
    var slot = ((header >>> 4) * -7046029254386353131) & mask
