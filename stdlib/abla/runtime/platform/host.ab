    val ranges = __ablaRuntimeHostCollectionRanges
    var lower = 0
    var upper = __ablaRuntimeHostCollectionLargeCount
    while (lower < upper) {
        val middle = lower + (upper - lower) / 2
        if (ablaRuntimeLoadI64(ranges + middle * 8) + 32 <= candidate) lower = middle + 1
        else upper = middle
