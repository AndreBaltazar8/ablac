import "abla/unsafe/memory"

trusted noescape extern:"c" fun malloc(size: int): i64*
trusted noescape extern:"c" fun free(pointer: i64*): void
trusted noescape extern:"c" fun calloc(count: int, size: int): i64*
trusted noescape extern:"c" fun realloc(pointer: i64*, size: int): i64*
trusted noescape extern:"c" fun write(
    descriptor: int,
    data: i64*,
    length: int
): int
trusted noescape extern:"c" fun abort(): void
trusted noescape extern:"c" fun pthread_mutex_init(
    mutex: i64*,
    attributes: i64*
): int
trusted noescape extern:"c" fun pthread_mutex_lock(mutex: i64*): int
trusted noescape extern:"c" fun pthread_mutex_unlock(mutex: i64*): int
trusted noescape extern:"c" fun pthread_mutex_destroy(mutex: i64*): int
trusted noescape extern:"c" fun pthread_create(
    handle: i64*,
    attributes: i64*,
    entry: i64*,
    argument: i64*
): int
trusted noescape extern:"c" fun pthread_join(
    handle: int,
    result: i64*
): int

// Bytes reserved for one pthread_mutex_t: 40 on Linux, 64 on Darwin. Every
// runtime mutex slot (the heap lock, Shared/Mutex control blocks) is sized from
// this; init/lock/unlock write the whole native struct.
@inline
trusted fun __ablaRuntimePlatformMutexBytes(): int = 64

trusted fun __ablaRuntimePlatformMutexInitialize(address: int): void {
    if (pthread_mutex_init(
        ablaRuntimePointerFromAddress(address),
        ablaRuntimePointerFromAddress(0)
    ) != 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexLock(address: int): void {
    if (pthread_mutex_lock(
        ablaRuntimePointerFromAddress(address)
    ) != 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexUnlock(address: int): void {
    if (pthread_mutex_unlock(
        ablaRuntimePointerFromAddress(address)
    ) != 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexDestroy(address: int): void {
    if (pthread_mutex_destroy(
        ablaRuntimePointerFromAddress(address)
    ) != 0) ablaRuntimeTrap()
}

// The tracked heap stays lock-free until a program actually starts an Abla
// thread. Thread creation happens before the worker can run, so this one-time
// transition does not add a synchronization branch to initialization.
var __ablaRuntimeHostHeapMutex: int = 0
var __ablaRuntimeHostActiveThreads: int = 0

trusted fun __ablaRuntimePlatformThreadsEnable(): void {
    if (__ablaRuntimeHostHeapMutex == 0) {
        // sizeof(pthread_mutex_t): 40 on Linux, 64 on Darwin. A 40-byte block
        // let every lock/unlock on macOS write past it into the neighbouring
        // malloc slot (nano-zone free-list corruption once threads ran).
        val mutex = ablaRuntimePointerAddress(
            malloc(__ablaRuntimePlatformMutexBytes())
        )
        if (mutex == 0) ablaRuntimeTrap()
        __ablaRuntimePlatformMutexInitialize(mutex)
        __ablaRuntimeHostHeapMutex = mutex
    }
}

@inline
trusted fun __ablaRuntimeHostHeapLock(): int {
    val mutex = __ablaRuntimeHostHeapMutex
    if (mutex != 0) __ablaRuntimePlatformMutexLock(mutex)
    mutex
}

@inline
trusted fun __ablaRuntimeHostHeapUnlock(mutex: int): void {
    if (mutex != 0) __ablaRuntimePlatformMutexUnlock(mutex)
}

trusted fun __ablaRuntimePlatformThreadCreate(
    handle: int,
    entry: int,
    argument: int
): bool {
    val mutex = __ablaRuntimeHostHeapLock()
    __ablaRuntimeHostActiveThreads = __ablaRuntimeHostActiveThreads + 1
    __ablaRuntimeHostHeapUnlock(mutex)
    val created = pthread_create(
        ablaRuntimePointerFromAddress(handle),
        ablaRuntimePointerFromAddress(0),
        ablaRuntimePointerFromAddress(entry),
        ablaRuntimePointerFromAddress(argument)
    ) == 0
    if (!created) {
        val rollbackMutex = __ablaRuntimeHostHeapLock()
        __ablaRuntimeHostActiveThreads =
            __ablaRuntimeHostActiveThreads - 1
        __ablaRuntimeHostHeapUnlock(rollbackMutex)
    }
    created
}

trusted fun __ablaRuntimePlatformThreadJoin(handle: int): bool {
    val joined = pthread_join(
        ablaRuntimeLoadI64(handle),
        ablaRuntimePointerFromAddress(0)
    ) == 0
    if (joined) {
        val mutex = __ablaRuntimeHostHeapLock()
        if (__ablaRuntimeHostActiveThreads <= 0) ablaRuntimeTrap()
        __ablaRuntimeHostActiveThreads = __ablaRuntimeHostActiveThreads - 1
        __ablaRuntimeHostHeapUnlock(mutex)
    }
    joined
}
// Host allocations are registered in allocation order: an array of their headers, each
// header holding its slot (its first word). A freed allocation leaves an empty slot, which
// the next collection compacts away; trailing empty slots are dropped at once, so the last
// slot is always the latest allocation still held. Checkpoints are registry positions, so
// a region or compiler phase can release its complete allocation suffix in one bounded
// walk without involving the LLVM backend. A collection reads the registry in order
// instead of chasing links through the whole heap.
var __ablaRuntimeHostRegistry: int = 0
var __ablaRuntimeHostRegistrySlots: int = 0
var __ablaRuntimeHostRegistryCapacity: int = 0
var __ablaRuntimeHostAllocationCount: int = 0
var __ablaRuntimeHostLiveBytes: int = 0
var __ablaRuntimeHostLimit: int = 4611686018427387903
var __ablaRuntimeHostRegionCache: int = 0
var __ablaRuntimeHostRegionCacheCount: int = 0
var __ablaRuntimeHostRegionPageCache: int = 0
var __ablaRuntimeHostRegionPageCacheCount: int = 0
// Hosted programs collect under allocation pressure from the start; only the
// functions the compiler made safe points (every allocating one, unless the
// program opted out with memorySetManualCollection) ever check this.
var __ablaRuntimeHostCollectionEnabled: bool = true
var __ablaRuntimeHostCollectionThreshold: int = 33554432
// Least growth of the tracked heap past what a collection kept before the next.
var __ablaRuntimeHostCollectionGrowth: int = 67108864
var __ablaRuntimeHostCollectionCount: int = 0
var __ablaRuntimeHostCollectionMinimum: int = 0
var __ablaRuntimeHostCollectionMaximum: int = 0
var __ablaRuntimeHostCollectionWorklist: int = 0
var __ablaRuntimeHostCollectionWorklistCount: int = 0
// The collection's page directory: for each 64 KiB page holding the header of a small
// allocation (header and payload within 32 KiB), a bitmap of where in the page those headers
// start, one bit per 16 bytes (open-addressed, two words an entry: page + 1, its bitmap).
// The allocation behind a pointer is a probe and a scan back through at most two pages'
// bitmaps; no allocation needs sorting. The larger allocations, few, are kept apart in
// address order (`Ranges`, `LargeCount`).
var __ablaRuntimeHostCollectionRanges: int = 0
var __ablaRuntimeHostCollectionLargeCount: int = 0
var __ablaRuntimeHostCollectionPages: int = 0
var __ablaRuntimeHostCollectionPageMask: int = 0
var __ablaRuntimeHostCollectionBitmaps: int = 0
val __ablaRuntimeHostCollectionSmallBytes: int = 32768

val __ablaRuntimeHostRegionCachedDescriptors: int = 64
val __ablaRuntimeHostRegionPageBytes: int = 1048576
val __ablaRuntimeHostRegionCachedPages: int = 32

// Stack roots form a strict LIFO within one native thread. Sharing the head
// between workers lets their push/pop sequences interleave and makes a valid
// pop look corrupt. Resolve this address at each use so LLVM's local-exec TLS
// model selects the calling thread's independent head cell.
@inline
trusted fun __ablaRuntimeHostRootFrameAddress(): int =
    nativeThreadLocalBytes(
        "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    )

@inline
trusted fun __ablaRuntimeHostRootFrameLoad(): int =
    ablaRuntimeLoadI64(__ablaRuntimeHostRootFrameAddress())

@inline
trusted fun __ablaRuntimeHostRootFrameStore(frame: int): void {
    ablaRuntimeStoreI64(__ablaRuntimeHostRootFrameAddress(), frame)
}

@inline
trusted fun __ablaRuntimeHostRegionAddress(): int =
    __ablaRuntimeHostRootFrameAddress() + 8

@inline
trusted fun __ablaRuntimeHostRegionLoad(): int =
    ablaRuntimeLoadI64(__ablaRuntimeHostRegionAddress())

@inline
trusted fun __ablaRuntimeHostRegionStore(regionAddress: int): void {
    ablaRuntimeStoreI64(__ablaRuntimeHostRegionAddress(), regionAddress)
}

// The latest allocation still registered (its header), or 0.
@inline
trusted fun __ablaRuntimeHostRegistryLast(): int =
    if (__ablaRuntimeHostRegistrySlots == 0) 0
    else ablaRuntimeLoadI64(
        __ablaRuntimeHostRegistry + (__ablaRuntimeHostRegistrySlots - 1) * 8
    )

// Out of line: it runs once per doubling, and inlined it made every allocation's path
// too large to inline where it used to be.
@noinline
trusted fun __ablaRuntimeHostRegistryGrow(): void {
    val capacity = if (__ablaRuntimeHostRegistryCapacity == 0) 65536
        else __ablaRuntimeHostRegistryCapacity * 2
    val registry = ablaRuntimePointerAddress(realloc(
        ablaRuntimePointerFromAddress(__ablaRuntimeHostRegistry), capacity * 8
    ))
    if (registry == 0) ablaRuntimeTrap()
    __ablaRuntimeHostRegistry = registry
    __ablaRuntimeHostRegistryCapacity = capacity
    return
}

trusted fun __ablaRuntimeHostRegister(header: int): void {
    if (__ablaRuntimeHostRegistrySlots == __ablaRuntimeHostRegistryCapacity) {
        __ablaRuntimeHostRegistryGrow()
    }
    ablaRuntimeStoreI64(header, __ablaRuntimeHostRegistrySlots)
    ablaRuntimeStoreI64(
        __ablaRuntimeHostRegistry + __ablaRuntimeHostRegistrySlots * 8, header
    )
    __ablaRuntimeHostRegistrySlots = __ablaRuntimeHostRegistrySlots + 1
    return
}

trusted fun __ablaRuntimeHostUnregister(header: int): void {
    ablaRuntimeStoreI64(__ablaRuntimeHostRegistry + ablaRuntimeLoadI64(header) * 8, 0)
    while (__ablaRuntimeHostRegistrySlots > 0 && __ablaRuntimeHostRegistryLast() == 0) {
        __ablaRuntimeHostRegistrySlots = __ablaRuntimeHostRegistrySlots - 1
    }
}

@inline
trusted fun __ablaRuntimeHostCollectionRangeSwap(
    left: int,
    right: int
): void {
    val temporary = ablaRuntimeLoadI64(
        __ablaRuntimeHostCollectionRanges + left * 8
    )
    ablaRuntimeStoreI64(
        __ablaRuntimeHostCollectionRanges + left * 8,
        ablaRuntimeLoadI64(__ablaRuntimeHostCollectionRanges + right * 8)
    )
    ablaRuntimeStoreI64(
        __ablaRuntimeHostCollectionRanges + right * 8, temporary
    )
}

// Heap sort gives the conservative marker an address-ordered allocation
// index without another allocation or recursion. Interior string/array
// pointers can then be resolved in logarithmic time instead of walking every
// live allocation. This is especially important for long-running servers:
// request garbage intentionally accumulates between bounded collections.
trusted fun __ablaRuntimeHostCollectionRangeSift(
    rootIndex: int,
    count: int
): void {
    var root = rootIndex
    var searching = true
    while (searching) {
        val left = root * 2 + 1
        if (left >= count) searching = false
        else {
            var largest = left
            val right = left + 1
            if (right < count && ablaRuntimeLoadI64(
                __ablaRuntimeHostCollectionRanges + right * 8
            ) > ablaRuntimeLoadI64(
                __ablaRuntimeHostCollectionRanges + left * 8
            )) largest = right
            if (ablaRuntimeLoadI64(
                __ablaRuntimeHostCollectionRanges + largest * 8
            ) <= ablaRuntimeLoadI64(
                __ablaRuntimeHostCollectionRanges + root * 8
            )) searching = false
            else {
                __ablaRuntimeHostCollectionRangeSwap(root, largest)
                root = largest
            }
        }
    }
}

trusted fun __ablaRuntimeHostCollectionRangesHeapSort(count: int): void {
    var root = count / 2
    while (root > 0) {
        root = root - 1
        __ablaRuntimeHostCollectionRangeSift(root, count)
    }
    var remaining = count
    while (remaining > 1) {
        remaining = remaining - 1
        __ablaRuntimeHostCollectionRangeSwap(0, remaining)
        __ablaRuntimeHostCollectionRangeSift(0, remaining)
    }
}


// Region pages are ordinary native allocations with a 32-byte control header:
// next, capacity, used, and reserved. Request-local objects are bump-allocated
// after that header and reclaimed together when their region ends.
trusted fun __ablaRuntimeHostRegionPageAcquire(minimum: int): int {
    var page: int = 0
    var capacity: int = __ablaRuntimeHostRegionPageBytes
    if (minimum <= __ablaRuntimeHostRegionPageBytes &&
        __ablaRuntimeHostRegionPageCache != 0) {
        page = __ablaRuntimeHostRegionPageCache
        __ablaRuntimeHostRegionPageCache = ablaRuntimeLoadI64(page)
        __ablaRuntimeHostRegionPageCacheCount =
            __ablaRuntimeHostRegionPageCacheCount - 1
    } else {
        if (minimum > capacity) capacity = minimum
        if (capacity > 4611686018427387871) ablaRuntimeTrap()
        page = ablaRuntimePointerAddress(malloc(capacity + 32))
        if (page == 0) ablaRuntimeTrap()
        ablaRuntimeStoreI64(page + 8, capacity)
    }
    ablaRuntimeStoreI64(page, 0)
    ablaRuntimeStoreI64(page + 16, 0)
    page
}

trusted fun __ablaRuntimeHostRegionPagesRelease(pageAddress: int): void {
    var page: int = pageAddress
    while (page != 0) {
        val next = ablaRuntimeLoadI64(page)
        val capacity = ablaRuntimeLoadI64(page + 8)
        if (capacity == __ablaRuntimeHostRegionPageBytes &&
            __ablaRuntimeHostRegionPageCacheCount <
                __ablaRuntimeHostRegionCachedPages) {
            ablaRuntimeStoreI64(page + 16, 0)
            ablaRuntimeStoreI64(page, __ablaRuntimeHostRegionPageCache)
            __ablaRuntimeHostRegionPageCache = page
            __ablaRuntimeHostRegionPageCacheCount =
                __ablaRuntimeHostRegionPageCacheCount + 1
        } else free(ablaRuntimePointerFromAddress(page))
        page = next
    }
}

trusted fun __ablaRuntimeHostRegionAllocate(size: int): int {
    val required = size + 32
    if (required < size || required > 4611686018427387888) {
        ablaRuntimeTrap()
    }
    val regionState = __ablaRuntimeHostRegionLoad()
    var page: int = ablaRuntimeLoadI64(regionState + 8)
    var offset: int = 0
    if (page != 0) {
        offset = (ablaRuntimeLoadI64(page + 16) + 15) & -16
    }
    if (page == 0 || offset > ablaRuntimeLoadI64(page + 8) ||
        required > ablaRuntimeLoadI64(page + 8) - offset) {
        page = __ablaRuntimeHostRegionPageAcquire(required + 15)
        ablaRuntimeStoreI64(
            page, ablaRuntimeLoadI64(regionState + 8)
        )
        ablaRuntimeStoreI64(regionState + 8, page)
        offset = 0
    }
    val header = page + 32 + offset
    ablaRuntimeStoreI64(page + 16, offset + required)
    ablaRuntimeStoreI64(header, 0)
    ablaRuntimeStoreI64(header + 8, 0)
    ablaRuntimeStoreI64(header + 16, size)
    ablaRuntimeStoreI64(header + 24, regionState)
    ablaRuntimeStoreI64(
        regionState + 16,
        ablaRuntimeLoadI64(regionState + 16) + size
    )
    header + 32
}

// Inlined into each runtime allocator (as it always was by size): left out of line, those
// allocators become small enough to be inlined into every allocation site instead.
@inline
trusted fun __ablaRuntimeHostTrackedAllocate(size: int, layout: int): int {
    if (size > 4611686018427387871) ablaRuntimeTrap()
    val header = ablaRuntimePointerAddress(malloc(size + 32))
    if (header == 0) ablaRuntimeTrap()
    ablaRuntimeStoreI64(header + 8, 0)
    ablaRuntimeStoreI64(header + 16, size)
    ablaRuntimeStoreI64(header + 24, layout)
    __ablaRuntimeHostRegister(header)
    __ablaRuntimeHostAllocationCount =
        __ablaRuntimeHostAllocationCount + 1
    val payload = header + 32
    val end = payload + size
    if (__ablaRuntimeHostCollectionMinimum == 0 ||
        payload < __ablaRuntimeHostCollectionMinimum) {
        __ablaRuntimeHostCollectionMinimum = payload
    }
    if (end > __ablaRuntimeHostCollectionMaximum) {
        __ablaRuntimeHostCollectionMaximum = end
    }
    __ablaRuntimeHostLiveBytes = __ablaRuntimeHostLiveBytes + size
    header + 32
}

@inline
trusted fun __ablaRuntimePlatformAllocateLayout(
    requested: int,
    layout: int
): int {
    val mutex = __ablaRuntimeHostHeapLock()
    val size: int = if (requested <= 0) 1 else requested
    val limit: int = if (__ablaRuntimeHostLimit == 0) {
        4611686018427387903
    } else __ablaRuntimeHostLimit
    if (size > limit - __ablaRuntimeHostLiveBytes) {
        __ablaRuntimePlatformPanic(
            __ablaRuntimeStringData("memory limit exceeded"), 21
        )
    }
    val result = if (__ablaRuntimeHostRegionLoad() != 0) {
        val result: int = __ablaRuntimeHostRegionAllocate(size)
        __ablaRuntimeHostLiveBytes = __ablaRuntimeHostLiveBytes + size
        result
    } else __ablaRuntimeHostTrackedAllocate(size, layout)
    __ablaRuntimeHostHeapUnlock(mutex)
    result
}

@inline
trusted fun __ablaRuntimePlatformAllocate(requested: int): int =
    __ablaRuntimePlatformAllocateLayout(requested, 0)

trusted fun __ablaRuntimeHostFreeUnlocked(address: int): void {
    if (address != 0) {
        val header = address - 32
        val size = ablaRuntimeLoadI64(header + 16)
        if (size != 0) {
            val owner = ablaRuntimeLoadI64(header + 24)
            if (owner >= 0 && owner < 48) {
                __ablaRuntimeHostUnregister(header)
                free(ablaRuntimePointerFromAddress(header))
                __ablaRuntimeHostAllocationCount =
                    __ablaRuntimeHostAllocationCount - 1
            } else {
                ablaRuntimeStoreI64(
                    owner + 16,
                    ablaRuntimeLoadI64(owner + 16) - size
                )
                ablaRuntimeStoreI64(header + 16, 0)
            }
            __ablaRuntimeHostLiveBytes = __ablaRuntimeHostLiveBytes - size
        }
    }
}

trusted fun __ablaRuntimePlatformFree(address: int): void {
    val mutex = __ablaRuntimeHostHeapLock()
    __ablaRuntimeHostFreeUnlocked(address)
    __ablaRuntimeHostHeapUnlock(mutex)
}

// A checkpoint is a marker allocation (layout 12) appended to the registry:
// the collector keeps it, nothing else can free it, and reset frees what
// follows it. A plain registry position (the latest allocation) was freed by
// a collection whenever that allocation was garbage, and the reset then walked
// past it and freed live objects. Consecutive checkpoints share the latest
// marker, so a checkpoint/reset loop adds one marker in all.
trusted fun __ablaRuntimePlatformMemoryCheckpoint(): int {
    val mutex = __ablaRuntimeHostHeapLock()
    var marker = __ablaRuntimeHostRegistryLast()
    if (marker == 0 || ablaRuntimeLoadI64(marker + 24) != 12) {
        marker = __ablaRuntimeHostTrackedAllocate(8, 12) - 32
    }
    __ablaRuntimeHostHeapUnlock(mutex)
    marker
}

trusted fun __ablaRuntimePlatformMemoryReset(checkpoint: int): void {
    while (__ablaRuntimeHostRegistryLast() != checkpoint) {
        if (__ablaRuntimeHostRegistrySlots == 0) ablaRuntimeTrap()
        __ablaRuntimePlatformFree(__ablaRuntimeHostRegistryLast() + 32)
    }
}

trusted fun __ablaRuntimePlatformMemoryLiveBytes(): int =
    __ablaRuntimeHostLiveBytes

// Allocator numbers for diagnostics (see the wasm platform); the host's
// system allocator reports only 4, tracked live bytes.
trusted fun __ablaRuntimePlatformMemoryHeapStat(which: int): int =
    if (which == 4) __ablaRuntimeHostLiveBytes else 0

trusted fun __ablaRuntimePlatformMemoryLimit(): int =
    if (__ablaRuntimeHostLimit == 0) 4611686018427387903
    else __ablaRuntimeHostLimit

trusted fun __ablaRuntimePlatformMemorySetLimit(limit: int): void {
    if (limit < 0 || limit < __ablaRuntimeHostLiveBytes) ablaRuntimeTrap()
    __ablaRuntimeHostLimit = limit
    __ablaRuntimeHostCollectionEnabled = true
    val latest = limit - limit / 4
    if (__ablaRuntimeHostCollectionThreshold > latest) {
        __ablaRuntimeHostCollectionThreshold = latest
    }
    return
}

// Collect under allocation pressure once the tracked heap has grown `bytes`
// (or half again, if more) past what the last collection kept.
trusted fun __ablaRuntimePlatformMemorySetCollectionGrowth(bytes: int): void {
    if (bytes <= 0) ablaRuntimeTrap()
    __ablaRuntimeHostCollectionGrowth = bytes
    // Pressure collection caps its threshold below the limit: give it one.
    if (__ablaRuntimeHostLimit == 0) {
        __ablaRuntimeHostLimit = __ablaRuntimePlatformMemoryLimit()
    }
    __ablaRuntimeHostCollectionEnabled = true
    val next = __ablaRuntimeHostLiveBytes + bytes
    if (__ablaRuntimeHostCollectionThreshold > next) {
        __ablaRuntimeHostCollectionThreshold = next
    }
    return
}

// Manual collection: allocation pressure no longer collects (until a later
// memorySetLimit or memorySetCollectionGrowth); only memoryCollect() does.
trusted fun __ablaRuntimePlatformMemorySetManualCollection(): void {
    __ablaRuntimeHostCollectionEnabled = false
    return
}

trusted fun __ablaRuntimePlatformMemorySetLayout(
    address: int,
    layout: int
): void {
    if (address == 0 || layout < 0 || layout >= 16) ablaRuntimeTrap()
    val header = address - 32
    val owner = ablaRuntimeLoadI64(header + 24)
    if (owner >= 0 && owner < 48) {
        ablaRuntimeStoreI64(header + 24, layout)
    }
}

// The slot of `page` in a page table (where it is, or the empty slot it would take).
@inline
trusted fun __ablaRuntimeHostCollectionPageSlot(table: int, mask: int, page: int): int {
    var slot = (page * -7046029254386353131) & mask
    var key = ablaRuntimeLoadI64(table + slot * 16)
    while (key != 0 && key != page + 1) {
        slot = (slot + 1) & mask
        key = ablaRuntimeLoadI64(table + slot * 16)
    }
    slot
}

trusted fun __ablaRuntimeHostCollectionPagesGrow(table: int, capacity: int): int {
    val grown = ablaRuntimePointerAddress(calloc(capacity * 4, 8))
    if (grown == 0) ablaRuntimeTrap()
    var slot = 0
    while (slot < capacity) {
        val key = ablaRuntimeLoadI64(table + slot * 16)
        if (key != 0) {
            val target = __ablaRuntimeHostCollectionPageSlot(grown, capacity * 2 - 1, key - 1)
            ablaRuntimeStoreI64(grown + target * 16, key)
        }
        slot = slot + 1
    }
    free(ablaRuntimePointerFromAddress(table))
    grown
}

// Every registered allocation into the page directory (or, when larger, the address-ordered
// list of large allocations).
trusted fun __ablaRuntimeHostCollectionPagesBuild(): void {
    val largest = __ablaRuntimeHostCollectionSmallBytes - 32
    var capacity = 4096
    var table = ablaRuntimePointerAddress(calloc(capacity * 2, 8))
    if (table == 0) ablaRuntimeTrap()
    var pages = 0
    var large = 0
    var slot = 0
    while (slot < __ablaRuntimeHostRegistrySlots) {
        val header = ablaRuntimeLoadI64(__ablaRuntimeHostRegistry + slot * 8)
        if (header != 0) {
            if (ablaRuntimeLoadI64(header + 16) > largest) {
                large = large + 1
            } else {
                val page = header >> 16
                val at = __ablaRuntimeHostCollectionPageSlot(table, capacity - 1, page)
                if (ablaRuntimeLoadI64(table + at * 16) == 0) {
                    ablaRuntimeStoreI64(table + at * 16, page + 1)
                    pages = pages + 1
                    if (pages * 2 > capacity) {
                        table = __ablaRuntimeHostCollectionPagesGrow(table, capacity)
                        capacity = capacity * 2
                    }
                }
            }
        }
        slot = slot + 1
    }
    val bitmaps = ablaRuntimePointerAddress(calloc((if (pages > 0) pages else 1) * 512, 1))
    if (bitmaps == 0) ablaRuntimeTrap()
    var next = 0
    slot = 0
    while (slot < capacity) {
        if (ablaRuntimeLoadI64(table + slot * 16) != 0) {
            ablaRuntimeStoreI64(table + slot * 16 + 8, bitmaps + next * 512)
            next = next + 1
        }
        slot = slot + 1
    }
    val list = ablaRuntimePointerAddress(malloc((if (large > 0) large else 1) * 8))
    if (list == 0) ablaRuntimeTrap()
    var listed = 0
    slot = 0
    while (slot < __ablaRuntimeHostRegistrySlots) {
        val header = ablaRuntimeLoadI64(__ablaRuntimeHostRegistry + slot * 8)
        if (header != 0) {
            if (ablaRuntimeLoadI64(header + 16) > largest) {
                ablaRuntimeStoreI64(list + listed * 8, header)
                listed = listed + 1
            } else {
                val at = __ablaRuntimeHostCollectionPageSlot(table, capacity - 1, header >> 16)
                val bit = (header & 65535) >> 4
                val word = ablaRuntimeLoadI64(table + at * 16 + 8) + (bit >> 6) * 8
                ablaRuntimeStoreI64(word, ablaRuntimeLoadI64(word) | (1 << (bit & 63)))
            }
        }
        slot = slot + 1
    }
    __ablaRuntimeHostCollectionPages = table
    __ablaRuntimeHostCollectionPageMask = capacity - 1
    __ablaRuntimeHostCollectionBitmaps = bitmaps
    __ablaRuntimeHostCollectionRanges = list
    __ablaRuntimeHostCollectionLargeCount = listed
    __ablaRuntimeHostCollectionRangesHeapSort(listed)
    return
}

// The bitmap of `page`, or 0 when no small allocation starts in it.
@inline
trusted fun __ablaRuntimeHostCollectionBitmapOf(page: int): int {
    val table = __ablaRuntimeHostCollectionPages
    val slot = __ablaRuntimeHostCollectionPageSlot(
        table, __ablaRuntimeHostCollectionPageMask, page
    )
    if (ablaRuntimeLoadI64(table + slot * 16) == 0) 0
    else ablaRuntimeLoadI64(table + slot * 16 + 8)
}

// The index of the highest set bit of a nonzero word.
@inline
trusted fun __ablaRuntimeHostHighestBit(bits: int): int {
    var word = bits
    var index = 0
    if ((word >>> 32) != 0) {
        index = index + 32
        word = word >>> 32
    }
    if ((word >>> 16) != 0) {
        index = index + 16
        word = word >>> 16
    }
    if ((word >>> 8) != 0) {
        index = index + 8
        word = word >>> 8
    }
    if ((word >>> 4) != 0) {
        index = index + 4
        word = word >>> 4
    }
    if ((word >>> 2) != 0) {
        index = index + 2
        word = word >>> 2
    }
    if ((word >>> 1) != 0) index = index + 1
    index
}

// The header of the small allocation starting last at or before bit `bit` of `page`, or 0.
trusted fun __ablaRuntimeHostCollectionNearest(bitmap: int, page: int, bit: int): int {
    var word = bit >> 6
    var bits = ablaRuntimeLoadI64(bitmap + word * 8) & ((2 << (bit & 63)) - 1)
    while (bits == 0 && word > 0) {
        word = word - 1
        bits = ablaRuntimeLoadI64(bitmap + word * 8)
    }
    if (bits == 0) 0
    else (page << 16) + (word * 64 + __ablaRuntimeHostHighestBit(bits)) * 16
}

// The allocation `candidate` points into (its header), or 0. A small allocation holding it
// starts in its page or the one before: the last small header at or before it is the only
// one that can. Otherwise a large allocation may: the last whose payload starts at or before
// the candidate.
trusted fun __ablaRuntimeHostCollectionLocate(candidate: int): int {
    val page = candidate >> 16
    var header = 0
    val bitmap = __ablaRuntimeHostCollectionBitmapOf(page)
    if (bitmap != 0) {
        header = __ablaRuntimeHostCollectionNearest(bitmap, page, (candidate & 65535) >> 4)
    }
    if (header == 0) {
        val previous = __ablaRuntimeHostCollectionBitmapOf(page - 1)
        if (previous != 0) header = __ablaRuntimeHostCollectionNearest(previous, page - 1, 4095)
    }
    if (header != 0) {
        val payload = header + 32
