        if (option == 7) return 4097
        if (option == 8) return 4098
        if (option == 9) return 8
        if (option == 10) return 256
        if (option == 13) return 128
        if (option == 15) return 512
        if (option == 18) return 4100
        if (option == 19) return 4099
        if (option == 20) return 4102
        if (option == 21) return 4101
        if (option == 30) return 2
