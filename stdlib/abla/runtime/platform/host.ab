    // Time and random (#811 group 7): nanosleep, getrandom. clock_gettime stays with the adapter:
    // CLOCK_MONOTONIC has no system call (libSystem reads the commpage).
    if (number == 35) return __ablaRuntimeDarwinNanosleep(argument0)
    if (number == 278 || number == 318) return __ablaRuntimeDarwinGetrandom(argument0, argument1)
    // The stat family, readlink, openat, getdents and getcwd. The running image's path
    // ("/proc/self/exe") stays with the C adapter, which holds its identity.
    if (number == 5) {
