        // the room left (at least 1/64 of the limit), not the very next safe point, so
        // a heap pinned near its limit reaches the limit's panic in a few collections
        // instead of collecting at every function entry on the way.
        val step = __ablaRuntimeHostLimit / 64
        next = if (__ablaRuntimeHostLiveBytes + step > latest) {
            val half = (__ablaRuntimeHostLimit - __ablaRuntimeHostLiveBytes) / 2
            val near = __ablaRuntimeHostLiveBytes + if (half > step) half else step
            if (near > __ablaRuntimeHostLimit) __ablaRuntimeHostLimit else near
