        val length = header & -4096
        if (shared) __ablaRuntimeHostHeapAcquire()
        val kept = __ablaRuntimeHostHeapCachePut(address - 16, length)
        if (shared) __ablaRuntimeHostHeapLetGo()
        if (!kept) __ablaRuntimeHostHeapUnmap(address - 16, length)
        return
    }
    if (shared) __ablaRuntimeHostHeapAcquire()
    __ablaRuntimeHostHeapFreeLocked(address)
    if (shared) __ablaRuntimeHostHeapLetGo()
    return
}

// The block resized to `size` bytes, its contents kept up to the smaller size; 0 (the old block
// untouched) when memory is short.
trusted fun __ablaRuntimeHostHeapResize(address: int, size: int): int {
    if (address == 0) return __ablaRuntimeHostHeapAllocate(size, false)
    if (size < 0 || size > 4611686018427387871) return 0
    val header = ablaRuntimeLoadI64(address - 8)
    if ((header & 2) != 0) {
        val mappedBefore = header & -4096
        if (size + 8 > __ablaRuntimeHostHeapSmallMaximum) {
            val mapped = (size + 16 + 4095) & -4096
            if (mapped == mappedBefore) return address
            val moved = __ablaRuntimeHostHeapRemap(address - 16, mappedBefore, mapped)
            if (moved < 0) return 0
            ablaRuntimeStoreI64(moved + 8, mapped | 2)
            return moved + 16
        }
        val smaller = __ablaRuntimeHostHeapAllocate(size, false)
        if (smaller == 0) return 0
        ablaUnsafeCopyMemory(smaller, address, size)
        __ablaRuntimeHostHeapFree(address)
        return smaller
    }
    val capacity = (header & __ablaRuntimeHostHeapSizeMask) - 8
    if (size <= capacity) return address
    val larger = __ablaRuntimeHostHeapAllocate(size, false)
    if (larger == 0) return 0
    ablaUnsafeCopyMemory(larger, address, capacity)
    __ablaRuntimeHostHeapFree(address)
    larger
}

/// Returns an uninitialized native allocation or null on failure.
@inline
trusted fun __ablaRuntimeHostMalloc(size: int): i64* =
    if (ablaHostOwnsRuntime() || (ablaHostIsMacOS() &&
        !ablaHostIsIOS())) ablaRuntimePointerFromAddress(__ablaRuntimeHostHeapAllocate(size,
            false))
    else malloc(size)

// The platform's release of free memory to the system (runtimeMemoryRelease): this heap's Trim. Other hosts have libc's
// allocator, which a caller trims with malloc_trim itself (the compiler does).
trusted fun __ablaRuntimePlatformMemoryRelease(): void {
    if (ablaHostOwnsRuntime() || (ablaHostIsMacOS() &&
        !ablaHostIsIOS())) __ablaRuntimeHostHeapTrim()
    return
}

// Gives everything back that can go: parked blocks merged, whole free chunks and the cached large
// mappings unmapped, the pages of the remaining large free blocks released. (malloc_trim for this heap.)
@noinline
trusted fun __ablaRuntimeHostHeapTrim(): void {
