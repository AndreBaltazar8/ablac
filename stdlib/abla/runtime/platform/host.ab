    __ablaRuntimeHostFreezeCleanup()
    if (__ablaRuntimeHostGcTrace) __ablaRuntimeHostStwTrace("gc: freeze ", 11, __ablaRuntimeHostStwMilliseconds() - traceStart, " ms\n", 4)
    __ablaRuntimeHostHeapUnlock(mutex)
    __ablaRuntimeHostStwDone(stopped)
    // Refused, not fatal: the value stays as it is, and the reason is kept (memoryHeapStat 12).
    if (failure != 0) ablaRuntimeStoreI64(state + 32, failure)
