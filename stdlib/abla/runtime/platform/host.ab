/// Returns whether the ABLA_GC_WORKERS environment variable is present (any value); it never fails.
@noinline
trusted fun __ablaRuntimeHostGcWorkersForcedConfigured(): bool =
    ablaRuntimePointerAddress(__ablaRuntimeHostGetenv(ablaRuntimePointerFromAddress(
        __ablaRuntimeWord0("ABLA_GC_WORKERS")
    ))) != 0

/// The registry size, in slots, below which a collection always runs serially, whatever the worker setting.
val __ablaRuntimeHostGcAdaptiveMinimumSlots: int = 262144

private trusted fun __ablaRuntimeHostGcPrefersParallel(state: int): bool {
    val ratio = ablaRuntimeLoadI64(state + 16)
    ratio == 0 || ratio <= 900
}

// Whether the collection of `slots` registry slots uses the threads.
private trusted fun __ablaRuntimeHostGcUseParallel(slots: int): bool {
    if (__ablaRuntimeHostGcWorkers < 2) return false
    if (__ablaRuntimeHostGcStress || __ablaRuntimeHostGcWorkersForced) return true
    if (slots < __ablaRuntimeHostGcAdaptiveMinimumSlots) return false
    val state = __ablaRuntimeHostGcAdaptiveState()
    val prefers = __ablaRuntimeHostGcPrefersParallel(state)
    val since = ablaRuntimeLoadI64(state + 24) + 1
    ablaRuntimeStoreI64(state + 24, since)
    val every = if (ablaRuntimeLoadI64(state + 32) == 0) 2 else ablaRuntimeLoadI64(state + 32)
    if (since >= every) {
        ablaRuntimeStoreI64(state + 24, 0)
        ablaRuntimeStoreI64(state + 40, 1)
        ablaRuntimeStoreI64(state + 48, if (prefers) 1 else 0)
        return !prefers
    }
    ablaRuntimeStoreI64(state + 40, 0)
    prefers
