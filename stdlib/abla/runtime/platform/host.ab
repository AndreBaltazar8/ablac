// The collecting thread lets the others go (its registry lock too). `restore`: the threshold the stop found goes
// back (a collection that sets its own threshold afterwards passes false).
trusted fun __ablaRuntimeHostStwRelease(restore: bool): void {
    val stw = __ablaRuntimeHostStwAddress()
    val me = __ablaRuntimeHostStwRecord()
    if (me == 0 || ablaRuntimeLoadI64(stw + 48) != me) return
    ablaRuntimeStoreI64(stw + 48, 0)
    if (restore) __ablaRuntimeHostCollectionThreshold = ablaRuntimeLoadI64(stw + 56)
    __ablaRuntimeHostStwUnclaim(ablaRuntimeAtomicLoadI64(stw))
    __ablaRuntimeFutexUnlock(stw + 8)
    ablaRuntimeAtomicStoreI64(stw, ablaRuntimeAtomicLoadI64(stw) + 1)
    __ablaRuntimeFutexWake(stw, 2147483647)
    return
}

// The end of a collection that Stop let run: the pressure collection keeps the stop until it has set its threshold.
@inline
trusted fun __ablaRuntimeHostStwDone(stopped: int): void {
    if (stopped == 1 && ablaRuntimeLoadI64(__ablaRuntimeHostStwRecord() + 40) == 0) {
        __ablaRuntimeHostStwRelease(true)
    }
}

// What a pressure collection tells the stop: it keeps the stop (1), and whether it parked for another's (read back).
trusted fun __ablaRuntimeHostStwPressureBegin(): void {
    val record = __ablaRuntimeHostStwRecord()
    if (record != 0) {
        ablaRuntimeStoreI64(record + 48, 0)
        ablaRuntimeStoreI64(record + 40, 1)
    }
    return
}

// True when the thread parked for another's collection, which sets the threshold itself.
trusted fun __ablaRuntimeHostStwPressureEnd(): bool {
    val record = __ablaRuntimeHostStwRecord()
    if (record == 0) return false
    ablaRuntimeStoreI64(record + 40, 0)
    ablaRuntimeLoadI64(record + 48) != 0
}

// The test hook (memoryDebugHold): the word at +136 of the stop's block is 0 (off), 1 (armed) or 2 (a thread holds).
trusted fun __ablaRuntimePlatformMemoryDebugHold(mode: int): int {
    val word = __ablaRuntimeHostStwAddress() + 136
    if (mode == 1) {
        ablaRuntimeAtomicStoreI64(word, 1)
        return 0
    }
    if (mode == 0) {
        ablaRuntimeAtomicStoreI64(word, 0)
        __ablaRuntimeFutexWake(word, 2147483647)
        return 0
    }
    if (ablaRuntimeAtomicLoadI64(word) == 2) 1 else 0
