        return __ablaRuntimeDarwinResult(raw)
    }
    if (number == 257 &&
        !__ablaRuntimeDarwinNamesImage(argument1)) return __ablaRuntimeDarwinResult(
            ablaDarwinSyscall(463, __ablaRuntimeDarwinDirectory(argument0), argument1,
                __ablaRuntimeDarwinOpenFlags(argument2), argument3, 0, 0))
    if (number == 89 && !__ablaRuntimeDarwinNamesImage(argument0)) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(58, argument0, argument1, argument2, 0, 0, 0))
    if (number == 217) return __ablaRuntimeDarwinGetdents(argument0, argument1, argument2)
    if (number == 79) return __ablaRuntimeDarwinGetcwd(argument0, argument1)
    // Sockets and readiness (#811 group 4): see the section above the dispatcher.
    if (number == 41) return __ablaRuntimeDarwinSocket(argument0, argument1, argument2)
    if (number == 42 || number == 49) return __ablaRuntimeDarwinAddressCall(
        number, argument0, argument1, argument2)
    if (number == 44) return __ablaRuntimeDarwinSendto(
        argument0, argument1, argument2, argument3, argument4, argument5)
    if (number == 45) return __ablaRuntimeDarwinRecvfrom(
        argument0, argument1, argument2, argument3, argument4, argument5)
    if (number == 46) return __ablaRuntimeDarwinSendmsg(argument0, argument1, argument2)
    if (number == 50) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(106, argument0, argument1, 0, 0, 0, 0))
    if (number == 51 || number == 52) return __ablaRuntimeDarwinSocketName(
        number, argument0, argument1, argument2)
    if (number == 54 || number == 55) return __ablaRuntimeDarwinSocketOptionCall(
        number, argument0, argument1, argument2, argument3, argument4)
    if (number == 288) return __ablaRuntimeDarwinAccept(
        argument0, argument1, argument2, argument3)
    if (number == 7) return __ablaRuntimeDarwinPoll(argument0, argument1, argument2)
    if (number == 232) return __ablaRuntimeDarwinEpollWait(
        argument0, argument1, argument2, argument3)
    if (number == 233) return __ablaRuntimeDarwinEpollControl(
        argument0, argument1, argument2, argument3)
    if (number == 291) {
        val queue = ablaDarwinSyscall(362, 0, 0, 0, 0, 0, 0)
        __ablaRuntimeDarwinConfigureDescriptor(queue, argument0)
        return __ablaRuntimeDarwinResult(queue)
    }
    // Processes (#811 group 5): the section above the dispatcher. execve of the running image's
    // own name stays with the C adapter, which holds its identity; wait4 passes no rusage (a
    // Linux buffer is not Darwin's layout).
    if (number == 59 && !__ablaRuntimeDarwinNamesImage(argument0)) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(59, argument0, argument1, argument2, 0, 0, 0))
    if (number == 61) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(7, argument0, argument1, argument2, 0, 0, 0))
    if (number == 62) return __ablaRuntimeDarwinKill(argument0, argument1)
    if (number == 109) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(82, argument0, argument1, 0, 0, 0, 0))
    // Signals (#811 group 6): the section above the dispatcher.
    if (number == 14) return __ablaRuntimeDarwinSigprocmask(
        argument0, argument1, argument2, argument3)
    abla_darwin_linux_syscall(
        number, argument0, argument1, argument2, argument3, argument4, argument5)
}
