// points at (a malloc'd array of indexes), +32 their count, +40 the live bytes it accounts for.
private trusted fun __ablaRuntimeHostFrozenGroups(): int = nativeStaticAllocate(49152)

// The freeze's working state (one freeze at a time, under the stop and the heap lock): +0 the blocks (old headers), +8 their
// count, +16 their capacity, +24 the forwarding table (16-byte entries: old header, index + 1), +32 its capacity, +40 the bytes
// of the group so far, +48 offsets of the blocks, +56 flags (1: data only), +64 the groups pointed at, +72 their count,
// +80 failure reason (0 none), +88 the group's base address (0 while discovering).
private trusted fun __ablaRuntimeHostFreezeContext(): int = nativeStaticAllocate(96)

