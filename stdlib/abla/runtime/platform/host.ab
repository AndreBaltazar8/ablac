}


// The flat bytes of the rope whose payload is at `rope`, written at `destination` (length + 1 bytes' room, the
// terminator already zero): its leaves in order, from the flat copy of any node that has one. An explicit stack, from the
// system allocator (not the tracked heap: a freeze runs under the heap lock), and no store into the rope.
trusted fun __ablaRuntimeHostFreezeFlatten(rope: int, destination: int): void {
    var capacity = 256
    var stack = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(capacity * 16))
    if (stack == 0) __ablaRuntimeHostOutOfMemory()
    var depth = 0
    var written = 0
    ablaRuntimeStoreI64(stack, 0)
    ablaRuntimeStoreI64(stack + 8, rope)
    depth = 1
    while (depth > 0) {
        depth = depth - 1
        val first = ablaRuntimeLoadI64(stack + depth * 16)
        val second = ablaRuntimeLoadI64(stack + depth * 16 + 8)
        if (first != 0) {
            // A flat leaf: data pointer, length.
            ablaUnsafeCopyMemory(destination + written, first, second)
            written = written + second
        } else if (second != 0) {
            val flat = ablaRuntimeLoadI64(second + 40)
            if (flat != 0) {
                val length = ablaRuntimeLoadI64(second)
                ablaUnsafeCopyMemory(destination + written, flat, length)
                written = written + length
            } else {
                if (depth + 2 > capacity) {
                    capacity = capacity * 2
                    stack = ablaRuntimePointerAddress(__ablaRuntimeHostRealloc(ablaRuntimePointerFromAddress(stack), capacity * 16))
                    if (stack == 0) __ablaRuntimeHostOutOfMemory()
                }
                // The right child first, so the left one is read first.
                ablaRuntimeStoreI64(stack + depth * 16, ablaRuntimeLoadI64(second + 24))
                ablaRuntimeStoreI64(stack + depth * 16 + 8, ablaRuntimeLoadI64(second + 32))
                ablaRuntimeStoreI64(stack + depth * 16 + 16, ablaRuntimeLoadI64(second + 8))
                ablaRuntimeStoreI64(stack + depth * 16 + 24, ablaRuntimeLoadI64(second + 16))
                depth = depth + 2
            }
        }
    }
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(stack))
    return
}

// Whether `candidate` is a rope node (a layout 6 block's payload, the start of one).
trusted fun __ablaRuntimeHostFreezeIsRope(candidate: int): bool {
    if (candidate == 0 || __ablaRuntimeHostFrozenIn(candidate)) return false
    val payload = __ablaRuntimeHostFreezeLocate(candidate)
    payload != 0 && (ablaRuntimeLoadI64(payload - 8) & 63) == 6 && candidate == payload
}

// A block that lives as long as `owner`: in the owner's region when it was allocated in the active one, else outside every
// region (a global's rope flattened first inside a request's region would otherwise keep a copy the region frees).
trusted fun __ablaRuntimePlatformAllocateOwned(requested: int, layout: int, owner: int): int {
    val region = __ablaRuntimeHostRegionLoad()
    if (region == 0 || ((ablaRuntimeLoadI64(owner - 8) & 63) == 63 && ablaRuntimeLoadI64(owner - 24) == region)) return __ablaRuntimePlatformAllocateLayout(requested, layout)
    __ablaRuntimeHostRegionStore(0)
    val result = __ablaRuntimePlatformAllocateLayout(requested, layout)
    __ablaRuntimeHostRegionStore(region)
    result
}

