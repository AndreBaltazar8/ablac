    val growth = if (__ablaRuntimeHostLiveBytes / 2 > reserve) {
        __ablaRuntimeHostLiveBytes / 2
    } else reserve
    var next = __ablaRuntimeHostLiveBytes + growth
    val latest = __ablaRuntimeHostLimit -
        if (__ablaRuntimeHostLimit / 4 < reserve) {
            __ablaRuntimeHostLimit / 4
        } else reserve
    if (next < 33554432) next = 33554432
    if (next > latest) next = latest
    __ablaRuntimeHostCollectionThreshold = next
    0
}

trusted fun __ablaRuntimePlatformRegionBegin(): int {
    var regionAddress: int = __ablaRuntimeHostRegionCache
    if (regionAddress != 0) {
        __ablaRuntimeHostRegionCache = ablaRuntimeLoadI64(regionAddress)
        __ablaRuntimeHostRegionCacheCount =
            __ablaRuntimeHostRegionCacheCount - 1
    } else {
        regionAddress = ablaRuntimePointerAddress(malloc(24))
        if (regionAddress == 0) ablaRuntimeTrap()
    }
    ablaRuntimeStoreI64(regionAddress, __ablaRuntimeHostRegion)
    ablaRuntimeStoreI64(regionAddress + 8, 0)
    ablaRuntimeStoreI64(regionAddress + 16, 0)
    __ablaRuntimeHostRegion = regionAddress
    regionAddress
}

trusted fun __ablaRuntimePlatformRegionEnd(regionAddress: int): void {
    if (regionAddress == 0 ||
        regionAddress != __ablaRuntimeHostRegion) ablaRuntimeTrap()
    val parent = ablaRuntimeLoadI64(regionAddress)
    val pages = ablaRuntimeLoadI64(regionAddress + 8)
    val live = ablaRuntimeLoadI64(regionAddress + 16)
    if (live < 0 || live > __ablaRuntimeHostLiveBytes) ablaRuntimeTrap()
    __ablaRuntimeHostLiveBytes = __ablaRuntimeHostLiveBytes - live
    __ablaRuntimeHostRegionPagesRelease(pages)
    __ablaRuntimeHostRegion = parent
    if (__ablaRuntimeHostRegionCacheCount <
        __ablaRuntimeHostRegionCachedDescriptors) {
        ablaRuntimeStoreI64(regionAddress, __ablaRuntimeHostRegionCache)
        __ablaRuntimeHostRegionCache = regionAddress
        __ablaRuntimeHostRegionCacheCount =
            __ablaRuntimeHostRegionCacheCount + 1
    } else free(ablaRuntimePointerFromAddress(regionAddress))
}

trusted fun __ablaRuntimePlatformRegionActive(): bool =
    __ablaRuntimeHostRegion != 0

// Return an equivalent allocation owned by the parent region. This is the
// uncommon backpressure/lifetime boundary; ordinary request allocations stay
// on the zero-malloc bump path.
trusted fun __ablaRuntimePlatformPromoteAllocation(address: int): int {
    if (__ablaRuntimeHostRegion == 0) return address
    val size = ablaRuntimeLoadI64(address - 16)
    val child = __ablaRuntimeHostRegion
    __ablaRuntimeHostRegion = ablaRuntimeLoadI64(child)
    val promoted = __ablaRuntimePlatformAllocate(size)
    __ablaRuntimeHostRegion = child
    var index: int = 0
    while (index < size) {
        ablaRuntimeStoreU8(
            promoted + index, ablaRuntimeLoadU8(address + index)
        )
        index = index + 1
    }
    __ablaRuntimePlatformFree(address)
    promoted
}

trusted fun __ablaRuntimePlatformPanic(data: int, length: int): int {
    write(2, ablaRuntimePointerFromAddress(data), length)
    abort()
    0
}
