                ablaRuntimeStoreI64(place + 16, size)
                ablaRuntimeStoreI64(place + 24, ablaRuntimeLoadI64(payload - 8) & 63)
                ablaUnsafeCopyMemory(place + 32, payload, size)
            }
            ablaRuntimeStoreI64(place, -1)
            ablaRuntimeStoreI64(place + 8, 0)
            block = block + 1
        }
        block = 0
        while (block < count) {
            val payload = ablaRuntimeLoadI64(ablaRuntimeLoadI64(context) + block * 8)
            val place = base + ablaRuntimeLoadI64(ablaRuntimeLoadI64(context + 48) + block * 8)
            val flag = ablaRuntimeLoadI64(ablaRuntimeLoadI64(context + 56) + block * 8)
            if ((flag & 15) != 2) __ablaRuntimeHostFreezeScan(payload, place + 32, flag)
            block = block + 1
        }
        __ablaRuntimeOsProtect(base, pages, false)
        // The group's record.
        val group = __ablaRuntimeHostFrozenGroups() + record * 48
        val edgeCount = ablaRuntimeLoadI64(context + 72)
        val edges = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(edgeCount * 8 + 8))
        if (edges == 0) __ablaRuntimeHostOutOfMemory()
        ablaUnsafeCopyMemory(edges, ablaRuntimeLoadI64(context + 64), edgeCount * 8)
        ablaRuntimeStoreI64(group, base)
        ablaRuntimeStoreI64(group + 8, pages)
        ablaRuntimeStoreI64(group + 16, 0)
        ablaRuntimeStoreI64(group + 24, edges)
        ablaRuntimeStoreI64(group + 32, edgeCount)
        ablaRuntimeStoreI64(group + 40, total)
        if (record + 1 > groupCount) ablaRuntimeStoreI64(state + 8, record + 1)
        ablaRuntimeStoreI64(state + 16, ablaRuntimeLoadI64(state + 16) + total)
