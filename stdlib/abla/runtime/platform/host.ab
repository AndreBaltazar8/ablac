            __ablaRuntimeHostHeapMerge(block)
            block = following
        }
        sizeClass = sizeClass + 1
    }
    __ablaRuntimeHostHeapParked = 0
    if (__ablaRuntimeHostHeapBinned > __ablaRuntimeHostHeapKeep()) __ablaRuntimeHostHeapGiveBack()
    return
