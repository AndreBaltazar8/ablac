        val command = if (argument1 == 1030) 67 else argument1
        val argument = if (argument1 == 4) __ablaRuntimeDarwinOpenFlags(argument2) else argument2
        val raw = ablaDarwinSyscall(92, argument0, command, argument, 0, 0, 0)
        if (raw >= 0 && argument1 == 3) return __ablaRuntimeLinuxOpenFlags(raw)
        return __ablaRuntimeDarwinResult(raw)
