    }
    if (ablaRuntimeLoadI64(context + 80) == 0 && count > 0) {
        __ablaRuntimeOsProtect(base, pages, true)
        ablaRuntimeStoreI64(context + 88, base)
        var block = 0
        while (block < count) {
            val payload = ablaRuntimeLoadI64(ablaRuntimeLoadI64(context) + block * 8)
            val place = base + ablaRuntimeLoadI64(ablaRuntimeLoadI64(context + 48) + block * 8)
            if ((ablaRuntimeLoadI64(ablaRuntimeLoadI64(context + 56) + block * 8) & 15) == 2) {
