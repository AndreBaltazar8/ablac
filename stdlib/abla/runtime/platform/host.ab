        if (layout == 6 && size >= 48) {
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 8))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 16))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 24))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 32))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 40))
        }
        if (layout == 7 && size >= 24) {
            __ablaRuntimeHostMarkValue(payload + 16)
        }
        if (layout == 11 && size >= 48) {
            __ablaRuntimeHostMarkValue(payload)
            __ablaRuntimeHostMarkValue(payload + 24)
        }
    }
}

// ---- Parallel mark (ABLA_GC_WORKERS=n, off by default) ---------------------------------------------------------------
// The mark of __ablaRuntimeHostTraceMarkedAllocations on n threads (the collecting thread and n - 1 started for the mark):
// each claims an object by a compare-and-swap of its state word (layout -> layout + 16; the loser of a race leaves it),
// keeps a stack of its own claimed payloads (4,096 entries), and gives half of it to a shared pool (the collection's work
// list, under a spin lock) when the stack fills or when another thread has run dry; a thread with nothing takes from the
// pool, and the mark is over when no thread is busy and the pool is empty. The page directory answers every candidate
// (the lazy registry lookup switches a global mode on its first interior pointer: no race-free form), through a page
// cache of each thread's own. Nothing here allocates or touches thread-local storage: a thread the runtime did not
// register runs it. The sweep stays as it is, on the collecting thread.
// State, static: +0 the pool's lock, +8 its count, +16 threads busy, +24 its capacity (the registry's slots), +32 the
// pool's array, +40 the threads asked for.
private trusted fun __ablaRuntimeHostMarkShared(): int = nativeStaticAllocate(72)

// A thread's block: +0 its stack's address, +8 its count, +16 its page cache's address, +24 1 once its thread started,
// +32 its thread handle, +40 objects it traced, +48 times it took from the pool, +56 times it gave to the pool, +64 idle sleeps,
// +72 idle looks at the pool (the counts are for ABLA_GC_TRACE=1); the stack and the cache follow.
val __ablaRuntimeHostMarkStack: int = 4096
/// Gives the header size of a parallel mark block in bytes.
val __ablaRuntimeHostMarkHeader: int = 128
/// Gives the storage size of a parallel mark block in bytes.
val __ablaRuntimeHostMarkBlock: int = 128 + 4096 * 8 + 4096

private trusted fun __ablaRuntimeHostMarkPoolLock(shared: int): void {
    while (ablaRuntimeAtomicCompareExchangeI64(shared, 0, 1) != 0) {
        while (ablaRuntimeAtomicLoadI64(shared) != 0) {}
    }
    return
}

// The oldest `given` entries of the stack go to the pool.
private trusted fun __ablaRuntimeHostMarkDonate(context: int, given: int): void {
    val shared = __ablaRuntimeHostMarkShared()
    val stack = ablaRuntimeLoadI64(context)
    val count = ablaRuntimeLoadI64(context + 8)
    __ablaRuntimeHostMarkPoolLock(shared)
    val pool = ablaRuntimeLoadI64(shared + 32)
    val pooled = ablaRuntimeLoadI64(shared + 8)
    if (pooled + given > ablaRuntimeLoadI64(shared + 24)) ablaRuntimeTrap()
    var index = 0
    while (index < given) {
        ablaRuntimeStoreI64(pool + (pooled + index) * 8, ablaRuntimeLoadI64(stack + index * 8))
        index = index + 1
    }
    ablaRuntimeAtomicStoreI64(shared + 8, pooled + given)
    ablaRuntimeAtomicStoreI64(shared, 0)
    index = given
    while (index < count) {
        ablaRuntimeStoreI64(stack + (index - given) * 8, ablaRuntimeLoadI64(stack + index * 8))
        index = index + 1
    }
    ablaRuntimeStoreI64(context + 8, count - given)
    ablaRuntimeStoreI64(context + 56, ablaRuntimeLoadI64(context + 56) + 1)
    return
}

// Up to 256 payload addresses from the pool onto the (empty) stack; false when the pool was empty.
private trusted fun __ablaRuntimeHostMarkTake(context: int): bool {
    val shared = __ablaRuntimeHostMarkShared()
    __ablaRuntimeHostMarkPoolLock(shared)
    val pooled = ablaRuntimeLoadI64(shared + 8)
    val taken = if (pooled > 256) 256 else pooled
    if (taken > 0) {
        val pool = ablaRuntimeLoadI64(shared + 32)
        val stack = ablaRuntimeLoadI64(context)
        var index = 0
        while (index < taken) {
            ablaRuntimeStoreI64(stack + index * 8, ablaRuntimeLoadI64(pool + (pooled - 1 - index) * 8))
            index = index + 1
        }
        ablaRuntimeAtomicStoreI64(shared + 8, pooled - taken)
        ablaRuntimeStoreI64(context + 8, taken)
        ablaRuntimeStoreI64(context + 48, ablaRuntimeLoadI64(context + 48) + 1)
    }
    ablaRuntimeAtomicStoreI64(shared, 0)
    taken > 0
}

// __ablaRuntimeHostCollectionBitmapOf with the thread's own page cache.
@inline
trusted fun __ablaRuntimeHostMarkBitmapOf(cache: int, page: int): int {
    val cached = cache + (page & 255) * 16
    if (ablaRuntimeLoadI64(cached) == page + 1) return ablaRuntimeLoadI64(cached + 8)
    val table = __ablaRuntimeHostCollectionPages
    val slot = __ablaRuntimeHostCollectionPageSlot(table, __ablaRuntimeHostCollectionPageMask, page)
    val bitmap = if (ablaRuntimeLoadI64(table + slot * 16) == 0) 0 else ablaRuntimeLoadI64(table + slot * 16 + 8)
    ablaRuntimeStoreI64(cached, page + 1)
    ablaRuntimeStoreI64(cached + 8, bitmap)
    bitmap
}

// __ablaRuntimeHostCollectionLocate with the thread's own page cache.
private trusted fun __ablaRuntimeHostMarkLocate(cache: int, candidate: int): int {
    val page = candidate >>> 16
    val bitmap = __ablaRuntimeHostMarkBitmapOf(cache, page)
    if ((candidate & 15) == 0 && __ablaRuntimeHostDirectoryContains(bitmap, candidate) &&
        ablaRuntimeLoadI64(candidate - 16) > 0) return candidate
    var payload = 0
    if (bitmap != 0) {
        payload = __ablaRuntimeHostCollectionNearest(bitmap, page, (candidate & 65535) >> 4)
    }
    if (payload == 0) {
        val previous = __ablaRuntimeHostMarkBitmapOf(cache, page - 1)
        if (previous != 0) payload = __ablaRuntimeHostCollectionNearest(previous, page - 1, 4095)
    }
    if (payload != 0 && u64(candidate - payload) < u64(ablaRuntimeLoadI64(payload - 16))) return payload
    __ablaRuntimeHostCollectionLocateLarge(candidate)
}

// __ablaRuntimeHostMarkPointer for a thread of the parallel mark: the claim is a compare-and-swap.
private trusted fun __ablaRuntimeHostMarkPointerParallel(context: int, candidate: int): void {
    if (candidate == 0) return
    if (__ablaRuntimeHostFrozenBase != 0 && __ablaRuntimeHostFrozenIn(candidate)) {
        // The group's reached flag: every thread stores the same 1, atomically.
        val group = __ablaRuntimeHostFrozenGroupOf(candidate)
        if (group != 0) ablaRuntimeAtomicStoreI64(group + 16, 1)
        return
    }
    if (u64(candidate) < u64(__ablaRuntimeHostCollectionMinimum) ||
        u64(candidate) >= u64(__ablaRuntimeHostCollectionMaximum)) return
    val payload = __ablaRuntimeHostMarkLocate(ablaRuntimeLoadI64(context + 16), candidate)
    if (payload == 0) return
    val packed = ablaRuntimeAtomicLoadI64(payload - 8)
    if ((packed & 63) >= 16) return
    if (ablaRuntimeAtomicCompareExchangeI64(payload - 8, packed, packed + 16) != packed) return
    var count = ablaRuntimeLoadI64(context + 8)
    if (count == __ablaRuntimeHostMarkStack) {
        __ablaRuntimeHostMarkDonate(context, __ablaRuntimeHostMarkStack / 2)
        count = ablaRuntimeLoadI64(context + 8)
    }
    ablaRuntimeStoreI64(ablaRuntimeLoadI64(context) + count * 8, payload)
    count = count + 1
    ablaRuntimeStoreI64(context + 8, count)
    // Another thread has run dry: share early, not only when the stack is full. A depth-first walk of a tree (a binary tree of a
    // million objects) keeps a stack of a few dozen entries, so the test is at every eighth push from 8 entries: the oldest half, the
    // nearest the roots, are the biggest subtrees.
    if ((count & 7) == 0 && count >= 8) {
        val shared = __ablaRuntimeHostMarkShared()
        if (ablaRuntimeAtomicLoadI64(shared + 16) < ablaRuntimeLoadI64(shared + 40)) {
            __ablaRuntimeHostMarkDonate(context, count / 2)
        }
    }
    return
}

private trusted fun __ablaRuntimeHostMarkValueParallel(context: int, value: int): void {
    val tag = ablaRuntimeLoadI32(value)
    if (tag == 4) {
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(value + 8))
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(value + 16))
    }
    if (tag == 5) {
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(value + 16))
    }
    if (tag >= 6 && tag <= 14) {
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(value + 8))
    }
    return
}

// A large array's element scan is split: past this many elements the scan is cut into chunks of this many, which the threads
// take from the shared range queue (state +48 the entries' address, +56 their count, +64 their capacity; three words each: the
// first and the end of the chunk in the payload, and the layout, which gives the element size).
val __ablaRuntimeHostMarkChunk: int = 4096

private trusted fun __ablaRuntimeHostMarkStride(layout: int): int = if (layout == 0) 8 else if (layout == 2) 24 else 32

// The elements of one chunk, [start, end), of a payload of `layout` 0 (words), 2 (24-byte values) or 3 (32-byte slots).
private trusted fun __ablaRuntimeHostMarkScanRange(context: int, start: int, end: int, layout: int): void {
    var at = start
    if (layout == 0) {
        while (at + 8 <= end) {
            __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(at))
            at = at + 8
        }
    }
    if (layout == 2) {
        while (at + 24 <= end) {
            __ablaRuntimeHostMarkValueParallel(context, at)
            at = at + 24
        }
    }
    if (layout == 3) {
        while (at + 32 <= end) {
            __ablaRuntimeHostMarkValueParallel(context, at + 8)
            at = at + 32
        }
    }
    return
}

// The scan of a claimed object of layout 0, 2 or 3: small ones whole, a large one cut into chunks; the first chunk is
// scanned here, the others go to the range queue (what does not fit there is scanned here too).
private trusted fun __ablaRuntimeHostMarkScan(context: int, payload: int, size: int, layout: int): void {
    val stride = __ablaRuntimeHostMarkStride(layout)
    val elements = size / stride
    val end = payload + elements * stride
    if (elements < 2 * __ablaRuntimeHostMarkChunk) {
        __ablaRuntimeHostMarkScanRange(context, payload, end, layout)
        return
    }
    val shared = __ablaRuntimeHostMarkShared()
    val step = __ablaRuntimeHostMarkChunk * stride
    var next = payload + step
    __ablaRuntimeHostMarkPoolLock(shared)
    val queue = ablaRuntimeLoadI64(shared + 48)
    var queued = ablaRuntimeLoadI64(shared + 56)
    val capacity = ablaRuntimeLoadI64(shared + 64)
    while (next < end && queued < capacity) {
        val last = if (next + step > end) end else next + step
        ablaRuntimeStoreI64(queue + queued * 24, next)
        ablaRuntimeStoreI64(queue + queued * 24 + 8, last)
        ablaRuntimeStoreI64(queue + queued * 24 + 16, layout)
        queued = queued + 1
        next = last
    }
    ablaRuntimeAtomicStoreI64(shared + 56, queued)
    ablaRuntimeAtomicStoreI64(shared, 0)
    __ablaRuntimeHostMarkScanRange(context, payload, payload + step, layout)
    if (next < end) __ablaRuntimeHostMarkScanRange(context, next, end, layout)
    return
}

// Scans one chunk from the range queue; false when it was empty.
private trusted fun __ablaRuntimeHostMarkTakeRange(context: int): bool {
    val shared = __ablaRuntimeHostMarkShared()
    __ablaRuntimeHostMarkPoolLock(shared)
    val queued = ablaRuntimeLoadI64(shared + 56)
    var start = 0
    var end = 0
    var layout = 0
    if (queued > 0) {
        val entry = ablaRuntimeLoadI64(shared + 48) + (queued - 1) * 24
        start = ablaRuntimeLoadI64(entry)
        end = ablaRuntimeLoadI64(entry + 8)
        layout = ablaRuntimeLoadI64(entry + 16)
        ablaRuntimeAtomicStoreI64(shared + 56, queued - 1)
    }
    ablaRuntimeAtomicStoreI64(shared, 0)
    if (queued == 0) return false
    ablaRuntimeStoreI64(context + 80, ablaRuntimeLoadI64(context + 80) + 1)
    __ablaRuntimeHostMarkScanRange(context, start, end, layout)
    true
}

// The fields of one claimed allocation, starting at its payload.
private trusted fun __ablaRuntimeHostMarkTraceParallel(context: int, payload: int): void {
    val packed = ablaRuntimeLoadI64(payload - 8)
    val state = packed & 63
    // Only the thread that claimed it is here, once: any other state is a double claim.
    if (state < 16 || state >= 32) ablaRuntimeTrap()
    val layout = state - 16
    ablaRuntimeStoreI64(payload - 8, packed + 16)
    val size = ablaRuntimeLoadI64(payload - 16)
    if (layout == 0 || layout == 2 || layout == 3) __ablaRuntimeHostMarkScan(context, payload, size, layout)
    if (layout == 4 && size >= 24) {
        val count = ablaRuntimeLoadI64(payload)
        val values = ablaRuntimeLoadI64(payload + 16)
        val dense = (ablaRuntimeLoadI64(payload + 8) >> 56) != 0
        if (values != payload + 24) __ablaRuntimeHostMarkPointerParallel(context, values)
        if (!dense && count > 0) __ablaRuntimeHostMarkScan(context, values, count * 24, 2)
    }
    if (layout == 5 && size >= 16) {
        val descriptor = ablaRuntimeLoadI64(payload) - 4611686018427387904
        val traced = ablaRuntimeLoadI32(descriptor + 12)
        val entries = descriptor + 16 + ablaRuntimeLoadI32(descriptor + 4) * 16
        var index: int = 0
        while (index < traced) {
            val field = payload + ablaRuntimeLoadI32(entries + index * 8)
            val kind = ablaRuntimeLoadI32(entries + index * 8 + 4)
            if (kind == 0) __ablaRuntimeHostMarkValueParallel(context, field)
            if (kind != 0) __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(field))
            if (kind == 3) __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(field + 8))
            index = index + 1
        }
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(payload + 8))
    }
    if (layout == 6 && size >= 48) {
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(payload + 8))
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(payload + 16))
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(payload + 24))
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(payload + 32))
        __ablaRuntimeHostMarkPointerParallel(context, ablaRuntimeLoadI64(payload + 40))
    }
    if (layout == 7 && size >= 24) {
        __ablaRuntimeHostMarkValueParallel(context, payload + 16)
    }
    if (layout == 11 && size >= 48) {
        __ablaRuntimeHostMarkValueParallel(context, payload)
        __ablaRuntimeHostMarkValueParallel(context, payload + 24)
    }
    return
}

// A thread of the mark (the C entry of the ones started for it; the collecting thread calls it too): works until every
// thread is out of work.
trusted fun __ablaRuntimeHostMarkWorker(context: int): int {
    val shared = __ablaRuntimeHostMarkShared()
    var running = true
    while (running) {
        while (ablaRuntimeLoadI64(context + 8) > 0) {
            val count = ablaRuntimeLoadI64(context + 8) - 1
            ablaRuntimeStoreI64(context + 8, count)
            ablaRuntimeStoreI64(context + 40, ablaRuntimeLoadI64(context + 40) + 1)
            __ablaRuntimeHostMarkTraceParallel(context, ablaRuntimeLoadI64(ablaRuntimeLoadI64(context) + count * 8))
        }
        if (!__ablaRuntimeHostMarkTake(context) && !__ablaRuntimeHostMarkTakeRange(context)) {
            ablaRuntimeAtomicFetchAddI64(shared + 16, -1)
            var waiting = true
            while (waiting) {
                // Busy first, then the pool: nothing is added to the pool once no thread is busy.
                val busy = ablaRuntimeAtomicLoadI64(shared + 16)
                ablaRuntimeStoreI64(context + 72, ablaRuntimeLoadI64(context + 72) + 1)
                if (ablaRuntimeAtomicLoadI64(shared + 8) > 0 || ablaRuntimeAtomicLoadI64(shared + 56) > 0) {
                    ablaRuntimeAtomicFetchAddI64(shared + 16, 1)
                    if (__ablaRuntimeHostMarkTake(context) || __ablaRuntimeHostMarkTakeRange(context)) waiting = false
                    else ablaRuntimeAtomicFetchAddI64(shared + 16, -1)
                } else if (busy == 0) {
                    waiting = false
                    running = false
                } else {
                    ablaRuntimeStoreI64(context + 64, ablaRuntimeLoadI64(context + 64) + 1)
                    __ablaRuntimeHostStwSleep()
                }
            }
        }
    }
    0
}

// The mark on `workers` threads, from the roots the collection has put on its work list.
trusted fun __ablaRuntimeHostTraceParallel(workers: int): void {
    val shared = __ablaRuntimeHostMarkShared()
    val block = __ablaRuntimeHostMarkBlock
    val contexts = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(workers * block))
    if (contexts == 0) {
        __ablaRuntimeHostTraceMarkedAllocations()
        return
    }
    var index = 0
    while (index < workers) {
        val context = contexts + index * block
        ablaRuntimeStoreI64(context, context + __ablaRuntimeHostMarkHeader)
        ablaRuntimeStoreI64(context + 8, 0)
        ablaRuntimeStoreI64(context + 16, context + __ablaRuntimeHostMarkHeader + __ablaRuntimeHostMarkStack * 8)
        ablaRuntimeStoreI64(context + 24, 0)
        ablaRuntimeStoreI64(context + 40, 0)
        ablaRuntimeStoreI64(context + 48, 0)
        ablaRuntimeStoreI64(context + 56, 0)
        ablaRuntimeStoreI64(context + 64, 0)
        ablaRuntimeStoreI64(context + 72, 0)
        ablaRuntimeStoreI64(context + 80, 0)
        var cached = 0
        while (cached < 512) {
            ablaRuntimeStoreI64(context + __ablaRuntimeHostMarkHeader + __ablaRuntimeHostMarkStack * 8 + cached * 8, 0)
            cached = cached + 1
        }
        index = index + 1
    }
    ablaRuntimeAtomicStoreI64(shared, 0)
    ablaRuntimeAtomicStoreI64(shared + 8, __ablaRuntimeHostCollectionWorklistCount)
    ablaRuntimeAtomicStoreI64(shared + 16, 1)
    ablaRuntimeStoreI64(shared + 24, __ablaRuntimeHostCollectionCount)
    ablaRuntimeStoreI64(shared + 32, __ablaRuntimeHostCollectionWorklist)
    ablaRuntimeStoreI64(shared + 40, workers)
    // The range queue: chunks of at most 4,096 elements of a payload, so the payload bytes bound the chunks; a queue that
    // cannot be had (or fills) only means a large array is scanned whole by the thread that claimed it.
    val rangeCapacity = __ablaRuntimeHostLiveBytes / 32768 * 2 + 64
    val queue = ablaRuntimePointerAddress(__ablaRuntimeHostMalloc(rangeCapacity * 24))
    ablaRuntimeStoreI64(shared + 48, queue)
    ablaRuntimeStoreI64(shared + 56, 0)
    ablaRuntimeStoreI64(shared + 64, if (queue == 0) 0 else rangeCapacity)
    __ablaRuntimeHostCollectionWorklistCount = 0
    index = 1
    while (index < workers) {
        val context = contexts + index * block
        ablaRuntimeAtomicFetchAddI64(shared + 16, 1)
        if (pthread_create(
            ablaRuntimePointerFromAddress(context + 32),
            ablaRuntimePointerFromAddress(0),
            ablaRuntimePointerFromAddress(nativeFunctionAddress(__ablaRuntimeHostMarkWorker)),
            ablaRuntimePointerFromAddress(context)
        ) == 0) {
            ablaRuntimeStoreI64(context + 24, 1)
        } else {
            ablaRuntimeAtomicFetchAddI64(shared + 16, -1)
            ablaRuntimeAtomicFetchAddI64(shared + 40, -1)
        }
        index = index + 1
    }
    __ablaRuntimeHostMarkWorker(contexts)
    index = 1
    while (index < workers) {
        val context = contexts + index * block
        if (ablaRuntimeLoadI64(context + 24) != 0) {
            pthread_join(ablaRuntimeLoadI64(context + 32), ablaRuntimePointerFromAddress(0))
        }
        index = index + 1
    }
    if (__ablaRuntimeHostGcTrace) {
        var counter = 0
        while (counter < 5) {
            if (counter == 0) __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("gc: parallel mark, objects by thread:"), 37)
            if (counter == 1) __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("gc: parallel mark, takes by thread:"), 35)
            if (counter == 2) __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("gc: parallel mark, gives by thread:"), 35)
            if (counter == 3) __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("gc: parallel mark, sleeps by thread:"), 36)
            if (counter == 4) __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("gc: parallel mark, ranges by thread:"), 36)
            val offset = if (counter == 0) 40 else if (counter == 1) 48 else if (counter == 2) 56 else if (counter == 3) 64 else 80
            index = 0
            while (index < workers) {
                __ablaRuntimeHostStwTrace(" ", 1, ablaRuntimeLoadI64(contexts + index * block + offset), "", 0)
                index = index + 1
            }
            __ablaRuntimeHostWrite(2, __ablaRuntimeWord0("\n"), 1)
            counter = counter + 1
        }
    }
    if (queue != 0) __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(queue))
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(contexts))
    return
}

// Free what the marker did not reach; clear the marks of what it did. What is
// kept moves down the registry in its order, closing the empty slots.
trusted fun __ablaRuntimeHostCollectionSweep(): void {
    // The registry, the lists and their counters stay in locals for the walk: nothing it calls
    // (free) reads them, and kept in the globals each freed block would load and store them.
    val registry = __ablaRuntimeHostRegistry
    val slots = __ablaRuntimeHostRegistrySlots
    val lists = __ablaRuntimeHostSmallLists()
    val keptLimit = __ablaRuntimeHostSmallKept
    var smallBytes = __ablaRuntimeHostSmallBytes
    val poison = __ablaRuntimeHostGcStress || __ablaRuntimeHostGcPoison
    var pushed = 0
    var freedBytes = 0
    var kept = 0
    var slot = 0
    while (slot < slots) {
        val entry = ablaRuntimeLoadI64(registry + slot * 8)
        if (entry != 0) {
            val payload = entry & -16
            val state = ablaRuntimeLoadI64(payload - 8) & 63
            if (state < 16 && state != 10 && state != 12) {
                val width = __ablaRuntimeHostEntryWidth(entry)
                val header = payload - width
                val size = ablaRuntimeLoadI64(payload - 16)
                freedBytes = freedBytes + size
                if (poison) __ablaRuntimeHostHeapPoison(payload, size)
                // __ablaRuntimeHostBlockFree, with its counters held here.
                if (size <= 480 && smallBytes < keptLimit) {
                    val total = (size + width + 7) & -8
                    val list = lists + total
                    ablaRuntimeStoreI64(header, ablaRuntimeLoadI64(list))
                    ablaRuntimeStoreI64(list, header)
                    smallBytes = smallBytes + total
                    pushed = pushed + total
                } else __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(header))
            } else {
                ablaRuntimeStoreI64(payload - 8, (kept << 6) | (state & 15))
                ablaRuntimeStoreI64(registry + kept * 8, entry)
                kept = kept + 1
            }
        }
        slot = slot + 1
    }
    __ablaRuntimeHostLiveBytes = __ablaRuntimeHostLiveBytes - freedBytes
    __ablaRuntimeHostSmallBytes = smallBytes
    __ablaRuntimeHostSmallPushed = __ablaRuntimeHostSmallPushed + pushed
    __ablaRuntimeHostRegistrySlots = kept
    return
}

// Background freeing (opt-in: memorySetBackgroundFree). A collection hands the blocks
// it found unreachable to a helper thread, which free()s them while the program goes
// on; the next collection waits for it first. The helper is the runtime's own (a plain
// pthread, not an Abla thread: collections go on while it runs), and touches nothing
// but those blocks, which nothing can reach. A forked child has no such thread: it
// drops the batch its parent was freeing. A program that doesn't opt in is built with
// the collection above and none of this (nor its state: no global of its own).

// The helper's state, static storage only a program that opts in has: +0 on (0/1),
// +8 the helper's pthread_t, +16 a helper is freeing (0/1), +24 the process that
// started it, +32 the batch the sweep is filling (chunks of [next chunk, count,
// headers…], 65534 headers a chunk).
trusted fun __ablaRuntimeHostFreeState(): int = nativeStaticAllocate(48)

/// Sets whether unreachable blocks may be released by the background sweeper.
trusted fun __ablaRuntimePlatformMemorySetBackgroundFree(enabled: bool): void {
    ablaRuntimeStoreI64(__ablaRuntimeHostFreeState(), if (enabled) 1 else 0)
    return
}

// The collection threads a program asks for (2 to 8; anything else leaves the serial collector), unless ABLA_GC_WORKERS is in
// the environment: then the environment decides (also 0 and 1, which turn it off).
trusted fun __ablaRuntimePlatformMemorySetGcWorkers(count: int): void {
    val value = ablaRuntimePointerAddress(__ablaRuntimeHostGetenv(ablaRuntimePointerFromAddress(
        __ablaRuntimeWord0("ABLA_GC_WORKERS")
    )))
    if (value != 0) return
    // No more threads than CPUs the process may use: on one CPU the collector stays serial.
    val cpus = __ablaRuntimeHostCpuCount()
    val wanted = if (count > cpus) cpus else count
    __ablaRuntimeHostGcWorkers = if (wanted < 2) 0 else if (wanted > 8) 8 else wanted
    return
}

// Frees every block of a batch, then its chunks: the helper's entry (C ABI, through
// nativeFunctionAddress), or the collection itself when no helper could start.
trusted fun __ablaRuntimeHostFreeWorker(batch: int): int {
    // The native heap's lock is taken once per run of frees, not once per block: a helper that took it for each of a
    // collection's millions of blocks fought the program's own allocation for it,
    // about 10% more CPU time and wall time in the compile-time interpreter. The program waits for at most one run.
    val locked = __ablaRuntimeHostHeapNative() && __ablaRuntimeHostHeapShared
    var chunk = batch
    while (chunk != 0) {
        val count = ablaRuntimeLoadI64(chunk + 8)
        var index = 0
        while (index < count) {
            if (locked) {
                val run = if (count - index > 256) index + 256 else count
                __ablaRuntimeHostHeapAcquire()
                while (index < run) {
                    __ablaRuntimeHostHeapFreeLocked(ablaRuntimeLoadI64(chunk + 16 + index * 8))
                    index = index + 1
                }
                __ablaRuntimeHostHeapLetGo()
            } else {
                __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(ablaRuntimeLoadI64(chunk + 16 +
                    index * 8)))
                index = index + 1
            }
        }
        val next = ablaRuntimeLoadI64(chunk)
        __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(chunk))
        chunk = next
    }
    0
}

// A block the sweep found unreachable, for the helper.
