    var index = 0
    if ((word >>> 32) != 0) {
        index = index + 32
        word = word >>> 32
    }
    if ((word >>> 16) != 0) {
        index = index + 16
        word = word >>> 16
    }
    if ((word >>> 8) != 0) {
        index = index + 8
        word = word >>> 8
    }
    if ((word >>> 4) != 0) {
        index = index + 4
        word = word >>> 4
    }
    if ((word >>> 2) != 0) {
        index = index + 2
        word = word >>> 2
    }
    if ((word >>> 1) != 0) index = index + 1
