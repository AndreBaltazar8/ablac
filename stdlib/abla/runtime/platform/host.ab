        if (run < chunks) firstChunk = -1
        var candidate = 0
        while (candidate < groupCount && ablaRuntimeLoadI64(__ablaRuntimeHostFrozenGroups() + candidate * 48 + 8) != 0) {
            candidate = candidate + 1
        }
        if (candidate < 1024) record = candidate
        if (firstChunk < 0 || record < 0) {
