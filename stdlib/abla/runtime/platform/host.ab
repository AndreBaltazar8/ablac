            false))
    else malloc(size)

// The platform's release of free memory to the system (runtimeMemoryRelease): this heap's Trim. Other hosts have libc's
// allocator, which a caller trims with malloc_trim itself (the compiler does).
trusted fun __ablaRuntimePlatformMemoryRelease(): void {
    if (ablaHostOwnsRuntime() || (ablaHostIsMacOS() &&
