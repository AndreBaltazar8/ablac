// Checks the lists and bins against each other and against the boundary tags (for tests): 0 when
// they agree, else the number of the check that failed. Nothing may allocate or free meanwhile.
trusted fun __ablaRuntimeHostHeapVerify(): int {
    val state = __ablaRuntimeHostHeapState()
    var parked = 0
    var sizeClass = 0
    while (sizeClass < __ablaRuntimeHostHeapClasses) {
        var block = ablaRuntimeLoadI64(state + sizeClass * 8)
        while (block != 0) {
