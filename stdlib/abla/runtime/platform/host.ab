    ablaRuntimeStoreI64(frame + 32, errorCapacity)
    ablaRuntimeStoreI64(frame + 40, errorLength)
    if (errorLength != 0) ablaRuntimeStoreI64(errorLength, 0)
    ablaRuntimeStoreI64(__ablaRuntimeHostRecoveryAddress(), frame)
