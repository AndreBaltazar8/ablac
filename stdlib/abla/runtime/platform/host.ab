            while (offset + 24 <= size) {
                __ablaRuntimeHostMarkValue(payload + offset)
                offset = offset + 24
            }
        }
        if (layout == 3) {
            var offset: int = 0
            while (offset + 32 <= size) {
                __ablaRuntimeHostMarkValue(payload + offset + 8)
                offset = offset + 32
