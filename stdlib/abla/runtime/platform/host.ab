// A Darwin errno as the Linux number the portable code expects (the same table
// as the C adapter's linux_errno; the numbers not listed are equal).
trusted fun __ablaRuntimeDarwinErrno(value: int): int {
    if (value == 35) return 11
    if (value == 69) return 122
    if (value == 45 || value == 102) return 95
    if (value == 36) return 115
    if (value == 37) return 114
    if (value == 78) return 38
    if (value == 48) return 98
    if (value == 47) return 97
    if (value == 63) return 36
    if (value == 51) return 101
