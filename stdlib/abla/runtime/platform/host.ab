// The kevents a kevent call returned (32 bytes each at `events`) as Linux's packed 12-byte
// epoll records (event bits, the descriptor, zero) at `output`: a descriptor with both filters
// registered shows up twice and is reported once, with both bits; EV_EOF (0x8000) is EPOLLHUP,
// EV_ERROR (0x4000) EPOLLERR. The number of records.
trusted fun __ablaRuntimeDarwinEpollRecords(events: int, measured: int, output: int): int {
    var index = 0
    var written = 0
    while (index < measured) {
        val event = events + index * 32
        val filter = ablaRuntimeLoadU8(event + 8)
        val flags = ablaRuntimeLoadU8(event + 10) + ablaRuntimeLoadU8(event + 11) * 256
        var bits = 0
        if (filter == 255) bits = bits | 1
        if (filter == 254) bits = bits | 4
        if ((flags & 32768) != 0) bits = bits | 16
        if ((flags & 16384) != 0) bits = bits | 8
        val descriptor = ablaRuntimeLoadI64(event + 24) & 4294967295
        var slot = 0
        while (slot < written && (ablaRuntimeLoadI32(output + slot * 12 + 4) & 4294967295) !=
            descriptor) {
            slot = slot + 1
        }
        val record = output + slot * 12
        if (slot == written) {
            ablaRuntimeStoreI32(record, bits)
            ablaRuntimeStoreI32(record + 4, descriptor)
            ablaRuntimeStoreI32(record + 8, 0)
            written = written + 1
        } else {
            ablaRuntimeStoreI32(record, ablaRuntimeLoadI32(record) | bits)
        }
        index = index + 1
    }
    written
}

// epoll_wait 232 over kevent: at most 64 events per call (a caller asking for more gets fewer, as
// epoll allows), written as Linux's packed 12-byte records (events, the descriptor, zero).
trusted fun __ablaRuntimeDarwinEpollWait(queue: int, output: int, maximum: int, timeout: int): int {
    if (output == 0 || maximum <= 0) return -22
    val capacity = if (maximum > 64) 64 else maximum
    // One mapping: the kevents (32 bytes each) and the timespec (16).
    val size = capacity * 32 + 16
    val memory = __ablaRuntimeDarwinScratch(size)
    if (__ablaRuntimeDarwinScratchFailed(memory)) return -12
    val events = memory
    val duration = memory + capacity * 32
    ablaRuntimeStoreI64(duration, if (timeout < 0) 0 else timeout / 1000)
    ablaRuntimeStoreI64(duration + 8, if (timeout < 0) 0 else timeout % 1000 * 1000000)
    var measured = ablaDarwinSyscall(363, queue, 0, 0, events, capacity,
        if (timeout < 0) 0 else duration)
    while (measured == -4) {
        measured = ablaDarwinSyscall(363, queue, 0, 0, events, capacity,
            if (timeout < 0) 0 else duration)
    }
    if (measured < 0) {
        __ablaRuntimeDarwinScratchFree(memory, size)
        return __ablaRuntimeDarwinResult(measured)
    }
    val written = __ablaRuntimeDarwinEpollRecords(events, measured, output)
    __ablaRuntimeDarwinScratchFree(memory, size)
    written
}

// ---- macOS processes (#811 group 5) ----
// BSD numbers: execve 59, wait4 7, kill 37 (pid, signal, posix = 1), setpgid 82. UNVERIFIED:
// every number in this section (from memory of xnu's syscalls.master).

// A Linux signal number as Darwin's, 0 where Darwin has none: the adapter's darwin_signals table.
trusted fun __ablaRuntimeDarwinSignal(signal: int): int {
    if (signal <= 0 || signal > 31) return signal
    if (signal == 7) return 10
    if (signal == 10) return 30
    if (signal == 12) return 31
    if (signal == 16) return 0
    if (signal == 17) return 20
    if (signal == 18) return 19
    if (signal == 19) return 17
    if (signal == 20) return 18
    if (signal == 23) return 16
    if (signal == 29) return 23
    if (signal == 30) return 0
    if (signal == 31) return 12
    signal
}

// kill 62: signal 0 only probes; a signal Darwin does not have is refused (EINVAL 22).
trusted fun __ablaRuntimeDarwinKill(process: int, signal: int): int {
    val darwin = __ablaRuntimeDarwinSignal(signal)
    if (signal != 0 && darwin == 0) return -22
    __ablaRuntimeDarwinResult(ablaDarwinSyscall(37, process, darwin, 1, 0, 0, 0))
}

// ---- macOS signals (#811 group 6) ----
// BSD numbers: __pthread_sigmask 329 (how, set, oldset: pointers to 32-bit sets). UNVERIFIED (from
// memory of xnu's syscalls.master): the number, SIG_BLOCK 1, SIG_UNBLOCK 2, SIG_SETMASK 3, and that
// Darwin's sigset_t is one 32-bit word with bit n-1 for signal n.

// A Linux signal mask (64 bits, bit n-1 for signal n) as Darwin's 32-bit set: the signals both
// have, by __ablaRuntimeDarwinSignal's table; the others are dropped.
trusted fun __ablaRuntimeDarwinSignalMask(linux: int): int {
    var mask = 0
    var number = 1
    while (number < 32) {
        if (((linux >> (number - 1)) & 1) != 0) {
            val darwin = __ablaRuntimeDarwinSignal(number)
            if (darwin != 0) mask = mask | (1 << (darwin - 1))
        }
        number = number + 1
    }
    mask
}

// A Darwin signal set as Linux's 64-bit mask (the inverse, for the old mask).
trusted fun __ablaRuntimeLinuxSignalMask(darwin: int): int {
    var bits = 0
    var number = 1
    while (number < 32) {
        val darwinNumber = __ablaRuntimeDarwinSignal(number)
        if (darwinNumber != 0 && ((darwin >> (darwinNumber - 1)) & 1) != 0) {
            bits = bits | (1 << (number - 1))
        }
        number = number + 1
    }
    bits
}

// rt_sigprocmask 14: Linux's how is 0/1/2 (block, unblock, set), its sets 8 bytes; the thread's
// mask changes (the adapter used pthread_sigmask, which is this system call).
trusted fun __ablaRuntimeDarwinSigprocmask(how: int, set: int, old: int, size: int): int {
    if (size != 8 || (set != 0 && (how < 0 || how > 2))) return -22
    val memory = __ablaRuntimeDarwinScratch(16)
    if (__ablaRuntimeDarwinScratchFailed(memory)) return -12
    if (set != 0) ablaRuntimeStoreI32(memory,
        __ablaRuntimeDarwinSignalMask(ablaRuntimeLoadI64(set)))
    val raw = ablaDarwinSyscall(329, if (set != 0) how + 1 else 1, if (set != 0) memory else 0,
        if (old != 0) memory + 8 else 0, 0, 0, 0)
    if (raw >= 0 && old != 0) {
        ablaRuntimeStoreI64(old, __ablaRuntimeLinuxSignalMask(ablaRuntimeLoadI32(memory + 8) &
            4294967295))
    }
    __ablaRuntimeDarwinScratchFree(memory, 16)
    __ablaRuntimeDarwinResult(raw)
}

// nanosleep (35) over __semwait_signal (334), which libSystem's nanosleep uses: no condition
// or mutex semaphore, a relative timeout in seconds and nanoseconds. Elapsing the timeout is
// reported as ETIMEDOUT (60), which is success here; an interruption is EINTR (4) and leaves
// the remaining time unset (the caller gets -4 and retries with the same request).
trusted fun __ablaRuntimeDarwinNanosleep(request: int): int {
    if (request == 0) return -14
    val seconds = ablaRuntimeLoadI64(request)
    val nanoseconds = ablaRuntimeLoadI64(request + 8)
    if (seconds < 0 || nanoseconds < 0 || nanoseconds >= 1000000000) return -22
    val raw = ablaDarwinSyscall(334, 0, 0, 1, 1, seconds, nanoseconds)
    if (raw == -60 || raw == 0) return 0
    __ablaRuntimeDarwinResult(raw)
}

// getrandom (278, 318) over getentropy (500), which takes at most 256 bytes a call.
trusted fun __ablaRuntimeDarwinGetrandom(buffer: int, length: int): int {
    if (length < 0) return -22
    var done = 0
    while (done < length) {
        val chunk = if (length - done > 256) 256 else length - done
        val raw = ablaDarwinSyscall(500, buffer + done, chunk, 0, 0, 0, 0)
        if (raw < 0) return __ablaRuntimeDarwinResult(raw)
        done = done + chunk
    }
    length
}

trusted fun __ablaRuntimeDarwinSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int {
    if (!ablaHostIsMacOS()) return -38
    // write 1 -> 4, lseek 8 -> 199, dup2 33 -> 90, getpid 39 -> 20,
    // exit 60 and exit_group 231 -> 1, fsync 74 -> 95, chdir 80 -> 12, umask 95 -> 60.
    if (number == 1) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(4, argument0, argument1, argument2, 0, 0, 0))
    if (number == 8) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(199, argument0, argument1, argument2, 0, 0, 0))
    if (number == 33) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(90, argument0, argument1, 0, 0, 0, 0))
    if (number == 39) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(20, 0, 0, 0, 0, 0, 0))
    if (number == 60 || number == 231) {
        ablaDarwinSyscall(1, argument0, 0, 0, 0, 0, 0)
        while (true) ablaDarwinSyscall(1, argument0, 0, 0, 0, 0, 0)
    }
    if (number == 74) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(95, argument0, 0, 0, 0, 0, 0))
    if (number == 80) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(12, argument0, 0, 0, 0, 0, 0))
    if (number == 95) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(60, argument0, 0, 0, 0, 0, 0))
    // Paths and descriptors without a structure to translate (#811 group: files).
    // access 21 -> 33, rename 82 -> 128, mkdir 83 -> 136, rmdir 84 -> 137,
    // unlink 87 -> 10, symlink 88 -> 57, chmod 90 -> 15, fchmod 91 -> 124,
    // flock 73 -> 131 (its operation bits are the same), mkdirat 258 -> 475,
    // renameat 264 -> 465, symlinkat 266 -> 474. A directory descriptor of -100 (Linux AT_FDCWD)
    // becomes Darwin's -2; the C adapter passed it on unchanged (so those forms failed with EBADF).
    if (number == 21) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(33, argument0, argument1, 0, 0, 0, 0))
    if (number == 82) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(128, argument0, argument1, 0, 0, 0, 0))
    if (number == 83) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(136, argument0, argument1, 0, 0, 0, 0))
    if (number == 84) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(137, argument0, 0, 0, 0, 0, 0))
    if (number == 87) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(10, argument0, 0, 0, 0, 0, 0))
    if (number == 88) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(57, argument0, argument1, 0, 0, 0, 0))
    if (number == 90) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(15, argument0, argument1, 0, 0, 0, 0))
    if (number == 91) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(124, argument0, argument1, 0, 0, 0, 0))
    if (number == 73) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(131, argument0, argument1, 0, 0, 0, 0))
    if (number == 258) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(475, __ablaRuntimeDarwinDirectory(argument0), argument1, argument2, 0, 0,
            0))
    if (number == 264) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(465, __ablaRuntimeDarwinDirectory(argument0), argument1,
            __ablaRuntimeDarwinDirectory(argument2), argument3, 0, 0))
    if (number == 266) return __ablaRuntimeDarwinResult(
        ablaDarwinSyscall(474, argument0, __ablaRuntimeDarwinDirectory(argument1), argument2, 0, 0,
            0))
    // unlinkat 263 -> 472: Linux AT_REMOVEDIR is 512, Darwin's 0x80; other flags are refused (ENOTSUP 95).
    if (number == 263) {
        if (argument2 != 0 && argument2 != 512) return -95
        return __ablaRuntimeDarwinResult(ablaDarwinSyscall(
            472, __ablaRuntimeDarwinDirectory(argument0), argument1,
            if (argument2 == 512) 128 else 0, 0, 0, 0))
    }
    // renameat2 316 with RENAME_NOREPLACE (1) -> renameatx_np 488 with RENAME_EXCL (4).
    if (number == 316) {
        if (argument4 != 1) return -95
        return __ablaRuntimeDarwinResult(ablaDarwinSyscall(
            488, __ablaRuntimeDarwinDirectory(argument0), argument1,
            __ablaRuntimeDarwinDirectory(argument2), argument3, 4, 0))
    }
    // fcntl 72 -> 92: F_DUPFD_CLOEXEC is 1030 on Linux and 67 on Darwin; F_SETFL's argument and
    // F_GETFL's result are open flags, which differ in value.
