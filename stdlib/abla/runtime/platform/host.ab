    if ((flags & 524288) != 0) ablaDarwinSyscall(92, descriptor, 2, 1, 0, 0, 0)
    if ((flags & 2048) != 0) {
        val current = ablaDarwinSyscall(92, descriptor, 3, 0, 0, 0, 0)
        if (current >= 0) ablaDarwinSyscall(92, descriptor, 4, current | 4, 0, 0, 0)
    }
    return
