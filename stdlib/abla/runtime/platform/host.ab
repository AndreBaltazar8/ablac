                    index = index + 1
                }
            } else __ablaRuntimeHostMarkPointer(fields)
        }
        if (layout == 6 && size >= 48) {
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 8))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 16))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 24))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 32))
            __ablaRuntimeHostMarkPointer(ablaRuntimeLoadI64(payload + 40))
        }
        if (layout == 7 && size >= 24) {
