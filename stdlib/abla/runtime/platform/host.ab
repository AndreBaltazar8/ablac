        val raw = ablaDarwinSyscall(339, argument0, argument1, 0, 0, 0, 0)
        if (raw == 0) __ablaRuntimeDarwinStat(argument1, argument1)
        return __ablaRuntimeDarwinResult(raw)
    }
    if (number == 262 && !__ablaRuntimeDarwinNamesImage(argument1)) {
        val raw = ablaDarwinSyscall(470, __ablaRuntimeDarwinDirectory(argument0), argument1,
            argument2,
            if ((argument3 & 256) != 0) 32 else 0, 0, 0)
