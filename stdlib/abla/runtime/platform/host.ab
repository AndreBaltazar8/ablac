}

// The call returned: its frame is no longer the innermost.
trusted fun __ablaRuntimeRecoveryLeave(frame: int): int {
    ablaRuntimeStoreI64(__ablaRuntimeHostRecoveryAddress(), ablaRuntimeLoadI64(frame))
    0
}

