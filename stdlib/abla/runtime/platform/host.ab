        kept = kept + (end - block)
        if (kept > keep) __ablaRuntimeHostHeapDiscard(block + 32, end - 16)
        block = ablaRuntimeLoadI64(block)
    }
    return
}

// Merges every parked block.
@noinline
trusted fun __ablaRuntimeHostHeapConsolidate(): void {
    if (__ablaRuntimeHostHeapNoMerge) return
    val state = __ablaRuntimeHostHeapState()
    var sizeClass = 0
    while (sizeClass < __ablaRuntimeHostHeapClasses) {
