// abstract name, has no Darwin form) is the size itself, AF_INET 16, AF_INET6 28; or -errno
// (EINVAL 22, ENAMETOOLONG 36, EAFNOSUPPORT 97). Nothing is written.
trusted fun __ablaRuntimeDarwinSockaddrLength(address: int, size: int): int {
