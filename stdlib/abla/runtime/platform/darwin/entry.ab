// macOS (#811): the BSD system calls under the portable runtime's Linux-style ones, in a file of their own that only a
// Darwin target loads (a Linux or Wasm build never parses it). The numbering, the dispatcher
// `__ablaRuntimeDarwinSyscall` and its helpers; the intrinsics they use (ablaDarwinSyscall, ablaDarwinSyscallPair) and
// the C adapter's entry stay declared in platform/host.ab, which every hosted build loads.
import "abla/unsafe/memory"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native/function-address"

private noescape extern:"intrinsic" fun ablaUnsafePointerAddress(value: i64*): int
private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool
private noescape extern:"intrinsic" fun ablaHostIsIOS(): bool
private noescape extern:"intrinsic" fun ablaSimdTargetArch(): int
private noescape extern:"intrinsic" fun ablaLinuxEnvironmentPointer(): i64*
// The BSD system call: the number and six arguments, the result -errno on failure (backend:
// bootstrapLlvmInlineDarwinSyscall); and with five arguments and the second result register stored at `second`.
private trusted noescape extern:"intrinsic" fun ablaDarwinSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int
private trusted noescape extern:"intrinsic" fun ablaDarwinSyscallPair(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    second: int
): int

// A Darwin errno as the Linux number the portable code expects (the same table
// as the C adapter's linux_errno; the numbers not listed are equal).
trusted fun __ablaRuntimeDarwinErrno(value: int): int {
    if (value == 35) return 11
    if (value == 69) return 122
    if (value == 45 || value == 102) return 95
    if (value == 36) return 115
    if (value == 37) return 114
    if (value == 78) return 38
    if (value == 48) return 98
    if (value == 47) return 97
    if (value == 63) return 36
    if (value == 51) return 101
    if (value == 54) return 104
    if (value == 57) return 107
    if (value == 60) return 110
    if (value == 61) return 111
    if (value == 65) return 113
    value
}

// A BSD call's result as the Linux-style result: -errno (Linux numbering) on failure.
trusted fun __ablaRuntimeDarwinResult(raw: int): int =
    if (raw < 0 && raw > -4096) -__ablaRuntimeDarwinErrno(-raw) else raw

// Linux open flags as Darwin's (the C adapter's darwin_open_flags).
trusted fun __ablaRuntimeDarwinOpenFlags(flags: int): int {
    var result = 0
    if ((flags & 3) == 1) result = result | 1
    if ((flags & 3) == 2) result = result | 2
    if ((flags & 64) != 0) result = result | 512
    if ((flags & 128) != 0) result = result | 2048
    if ((flags & 512) != 0) result = result | 1024
    if ((flags & 1024) != 0) result = result | 8
    if ((flags & 256) != 0) result = result | 131072
    if ((flags & 2048) != 0) result = result | 4
    if ((flags & 65536) != 0) result = result | 1048576
    if ((flags & 131072) != 0) result = result | 256
    if ((flags & 524288) != 0) result = result | 16777216
    result
}

// Darwin open flags (F_GETFL's result) as Linux's (the adapter's linux_open_flags).
trusted fun __ablaRuntimeLinuxOpenFlags(flags: int): int {
    var result = flags & 3
    if ((flags & 512) != 0) result = result | 64
    if ((flags & 2048) != 0) result = result | 128
    if ((flags & 131072) != 0) result = result | 256
    if ((flags & 1024) != 0) result = result | 512
    if ((flags & 8) != 0) result = result | 1024
    if ((flags & 4) != 0) result = result | 2048
    if ((flags & 1048576) != 0) result = result | 65536
    result
}

// AT_FDCWD is -100 on Linux and -2 on Darwin; other descriptors are the same.
trusted fun __ablaRuntimeDarwinDirectory(descriptor: int): int =
    if (descriptor == -100) -2 else descriptor

// True when the C string at `path` is "/proc/self/exe": the running image, which the
// C adapter still resolves (it records the image's identity before main).
trusted fun __ablaRuntimeDarwinNamesImage(path: int): bool {
    if (path == 0) return false
    // The 14 bytes of the name, little endian in two words (no string literal in the runtime).
    var index = 0
    while (index < 14) {
        val word = if (index < 8) 7310238724270485551 else 111567768086124
        val shift = if (index < 8) index * 8 else (index - 8) * 8
        if (ablaRuntimeLoadU8(path + index) != ((word >> shift) & 255)) return false
        index = index + 1
    }
    ablaRuntimeLoadU8(path + 14) == 0
}

// A Darwin `struct stat` (144 bytes, 64-bit inode: dev 0 int32, mode 4 and nlink 6 uint16, ino 8, uid 16, gid 20, rdev 24
// int32, atime 32, mtime 48, ctime 64 (timespecs), size 96, blocks 104, blksize 112 int32) as the Linux x86-64 record the
// portable code reads (dev 0, ino 8, nlink 16, mode 24, uid 28, gid 32, rdev 40, size 48, blksize 56, blocks 64, atime 72,
// mtime 88, ctime 104, each time seconds then nanoseconds), in place: every field is read before any is written. Only the mode,
// size and mtime were carried before, the rest zero: a file's identity (device, inode) and change time, which a cache key or
// a watch compares to see a file replaced with the same size and a forged modification time, were 0 for every file on macOS.
trusted fun __ablaRuntimeDarwinStat(native: int, output: int): void {
    val device = ablaRuntimeLoadI32(native) & 4294967295
    val mode = ablaRuntimeLoadI32(native + 4) & 65535
    val links = (ablaRuntimeLoadI32(native + 4) >> 16) & 65535
    val inode = ablaRuntimeLoadI64(native + 8)
    val user = ablaRuntimeLoadI32(native + 16) & 4294967295
    val group = ablaRuntimeLoadI32(native + 20) & 4294967295
    val special = ablaRuntimeLoadI32(native + 24) & 4294967295
    val accessed = ablaRuntimeLoadI64(native + 32)
    val accessedNanoseconds = ablaRuntimeLoadI64(native + 40)
    val seconds = ablaRuntimeLoadI64(native + 48)
    val nanoseconds = ablaRuntimeLoadI64(native + 56)
    val changed = ablaRuntimeLoadI64(native + 64)
    val changedNanoseconds = ablaRuntimeLoadI64(native + 72)
    val size = ablaRuntimeLoadI64(native + 96)
    val blocks = ablaRuntimeLoadI64(native + 104)
    val blockSize = ablaRuntimeLoadI32(native + 112) & 4294967295
    var offset = 0
    while (offset < 144) {
        ablaRuntimeStoreI64(output + offset, 0)
        offset = offset + 8
    }
    ablaRuntimeStoreI64(output, device)
    ablaRuntimeStoreI64(output + 8, inode)
    ablaRuntimeStoreI64(output + 16, links)
    ablaRuntimeStoreI32(output + 24, mode)
    ablaRuntimeStoreI32(output + 28, user)
    ablaRuntimeStoreI32(output + 32, group)
    ablaRuntimeStoreI64(output + 40, special)
    ablaRuntimeStoreI64(output + 48, size)
    ablaRuntimeStoreI64(output + 56, blockSize)
    ablaRuntimeStoreI64(output + 64, blocks)
    ablaRuntimeStoreI64(output + 72, accessed)
    ablaRuntimeStoreI64(output + 80, accessedNanoseconds)
    ablaRuntimeStoreI64(output + 88, seconds)
    ablaRuntimeStoreI64(output + 96, nanoseconds)
    ablaRuntimeStoreI64(output + 104, changed)
    ablaRuntimeStoreI64(output + 112, changedNanoseconds)
    return
}

// getdents64 over getdirentries64 (344): Darwin's records (inode, seek offset, length,
// name length, type, name) as Linux's (inode, offset, length, type, name, 8-aligned).
trusted fun __ablaRuntimeDarwinGetdents(descriptor: int, output: int, capacity: int): int {
    if (output == 0 || capacity < 24) return -22
    // The records and the 8-byte position (getdirentries64's base) share one mapping.
    val native = ablaDarwinSyscall(197, 0, capacity + 16, 3, 4098, -1, 0)
    if (native < 0 && native > -4096) return __ablaRuntimeDarwinResult(native)
    val position = native + ((capacity + 7) & -8)
    ablaRuntimeStoreI64(position, 0)
    val measured = ablaDarwinSyscall(344, descriptor, native, capacity, position, 0, 0)
    if (measured <= 0) {
        ablaDarwinSyscall(73, native, capacity + 16, 0, 0, 0, 0)
        return __ablaRuntimeDarwinResult(measured)
    }
    val base = ablaRuntimeLoadI64(position)
    var input = 0
    var written = 0
    var failure = 0
    while (failure == 0 && input < measured) {
        val entry = native + input
        val length = ablaRuntimeLoadU8(entry + 16) + ablaRuntimeLoadU8(entry + 17) * 256
        if (length == 0 || input + length > measured) failure = -5
        else {
            var nameLength = 0
            while (ablaRuntimeLoadU8(entry + 21 + nameLength) != 0) nameLength = nameLength + 1
            val record = (19 + nameLength + 1 + 7) & -8
            if (record > 65535 || written + record > capacity) failure = -75
            else {
                var clear = 0
                while (clear < record) {
                    ablaRuntimeStoreU8(output + written + clear, 0)
                    clear = clear + 1
                }
                ablaRuntimeStoreI64(output + written, ablaRuntimeLoadI64(entry))
                ablaRuntimeStoreI64(output + written + 8, base)
                ablaRuntimeStoreU8(output + written + 16, record & 255)
                ablaRuntimeStoreU8(output + written + 17, record / 256)
                ablaRuntimeStoreU8(output + written + 18, ablaRuntimeLoadU8(entry + 20))
                var copy = 0
                while (copy <= nameLength) {
                    ablaRuntimeStoreU8(output + written + 19 + copy,
                        ablaRuntimeLoadU8(entry + 21 + copy))
                    copy = copy + 1
                }
                written = written + record
                input = input + length
            }
        }
    }
    ablaDarwinSyscall(73, native, capacity + 16, 0, 0, 0, 0)
    if (failure != 0) failure else written
}

// getcwd has no system call: open "." and ask for the path of the descriptor
// (fcntl F_GETPATH, 50, into a PATH_MAX buffer), as libSystem does. Returns the
// length including the terminator, like the Linux system call.
trusted fun __ablaRuntimeDarwinGetcwd(output: int, size: int): int {
    // The caller's buffer holds the path "." for open (a name needs at least a byte and the
    // terminator, so a buffer under 2 bytes is ERANGE anyway); the descriptor's path is read
    // into a mapping of its own (no stack allocation: the compile-time JIT's runtime slice
    // cannot resolve nativeStackAllocate).
    if (size < 2) return -34
    ablaRuntimeStoreU8(output, 46)
    ablaRuntimeStoreU8(output + 1, 0)
    val descriptor = ablaDarwinSyscall(5, output, 0, 0, 0, 0, 0)
    if (descriptor < 0) return __ablaRuntimeDarwinResult(descriptor)
    val buffer = ablaDarwinSyscall(197, 0, 1024, 3, 4098, -1, 0)
    if (buffer < 0 && buffer > -4096) {
        ablaDarwinSyscall(6, descriptor, 0, 0, 0, 0, 0)
        return __ablaRuntimeDarwinResult(buffer)
    }
    val status = ablaDarwinSyscall(92, descriptor, 50, buffer, 0, 0, 0)
    ablaDarwinSyscall(6, descriptor, 0, 0, 0, 0, 0)
    if (status < 0) {
        ablaDarwinSyscall(73, buffer, 1024, 0, 0, 0, 0)
        return __ablaRuntimeDarwinResult(status)
    }
    var length = 0
    while (ablaRuntimeLoadU8(buffer + length) != 0) length = length + 1
    var copy = 0
    if (length + 1 <= size) {
        while (copy <= length) {
            ablaRuntimeStoreU8(output + copy, ablaRuntimeLoadU8(buffer + copy))
            copy = copy + 1
        }
    }
    ablaDarwinSyscall(73, buffer, 1024, 0, 0, 0, 0)
    if (length + 1 > size) return -34
    length + 1
}

// ---- macOS sockets and readiness (#811 group 4) ----
// BSD numbers: socket 97, connect 98, bind 104, listen 106, accept 30, sendto 133, recvfrom 29,
// sendmsg 28, getsockname 32, getpeername 31, setsockopt 105, getsockopt 118, fcntl 92, poll 230,
// select 93, kqueue 362, kevent 363, mmap 197, munmap 73. UNVERIFIED (from memory of xnu's
// bsd/kern/syscalls.master and the headers, no macOS machine here): every number and constant in
// this section; the macOS job's tools/test-darwin-syscalls.sh names the call that is wrong.
// No stack allocation here (the compile-time JIT's runtime slice cannot resolve
// nativeStackAllocate): a Linux sockaddr is rewritten in the caller's own buffer (only its first
// two bytes differ from Darwin's) for the call and put back, a Darwin one the kernel wrote there is
// rewritten the same way; where a record of another shape is needed (kevents, the select masks)
// the call takes an anonymous mapping.

// A scratch mapping (anonymous, read-write); negative (-errno) when none could be made.
trusted fun __ablaRuntimeDarwinScratch(size: int): int =
    ablaDarwinSyscall(197, 0, size, 3, 4098, -1, 0)

/// Reports whether a scratch mapping result encodes a negative errno.
trusted fun __ablaRuntimeDarwinScratchFailed(address: int): bool = address < 0 && address > -4096

/// Unmaps a previously allocated scratch region.
trusted fun __ablaRuntimeDarwinScratchFree(address: int, size: int): void {
    ablaDarwinSyscall(73, address, size, 0, 0, 0, 0)
    return
}

// Linux's address family as Darwin's: AF_UNIX 1 and AF_INET 2 agree, AF_INET6 is 10 and 30.
trusted fun __ablaRuntimeDarwinSocketDomain(domain: int): int = if (domain == 10) 30 else domain

// The socket type without Linux's SOCK_NONBLOCK (2048) and SOCK_CLOEXEC (524288): stream 1,
// datagram 2 and raw 3 agree.
trusted fun __ablaRuntimeDarwinSocketType(type: int): int = type & 15

// Linux message flags as Darwin's, bit by bit: MSG_OOB 1, MSG_PEEK 2 and MSG_DONTROUTE 4 agree; MSG_TRUNC 0x20 is 0x10,
// MSG_DONTWAIT 0x40 is 0x80, MSG_EOR 0x80 is 0x8 and MSG_WAITALL 0x100 is 0x40. MSG_NOSIGNAL (0x4000) has no Darwin bit
// (SO_NOSIGPIPE takes its place) and neither has MSG_MORE (0x8000): they and any other bit are dropped. Passed through as
// they were, Linux's MSG_DONTWAIT became Darwin's MSG_WAITALL: a send or receive meant never to block waited, and a
// write's deadline (TcpConnection.sendWithoutBlocking, a TLS session's send) did not hold against a peer that read nothing.
trusted fun __ablaRuntimeDarwinMessageFlags(flags: int): int {
    var result = flags & 7
    if ((flags & 32) != 0) result = result | 16
    if ((flags & 64) != 0) result = result | 128
    if ((flags & 128) != 0) result = result | 8
    if ((flags & 256) != 0) result = result | 64
    result
}

// A new socket (or kqueue): SO_NOSIGPIPE (0x1022 at SOL_SOCKET 0xffff), then the close-on-exec
// and nonblocking flags the Linux call took (the adapter's configure_descriptor).
trusted fun __ablaRuntimeDarwinConfigureDescriptor(descriptor: int, flags: int): void {
    if (descriptor < 0) return
    val enabled = __ablaRuntimeDarwinScratch(16)
    if (!__ablaRuntimeDarwinScratchFailed(enabled)) {
        ablaRuntimeStoreI32(enabled, 1)
        ablaDarwinSyscall(105, descriptor, 65535, 4130, enabled, 4, 0)
        __ablaRuntimeDarwinScratchFree(enabled, 16)
    }
    if ((flags & 524288) != 0) ablaDarwinSyscall(92, descriptor, 2, 1, 0, 0, 0)
    if ((flags & 2048) != 0) {
        val current = ablaDarwinSyscall(92, descriptor, 3, 0, 0, 0, 0)
        if (current >= 0) ablaDarwinSyscall(92, descriptor, 4, current | 4, 0, 0, 0)
    }
    return
}

// pipe2 293 (descriptors, flags): BSD pipe 42 returns the read end and, in the second result register
// (x1 / rdx), the write end; both ends are written as Linux's two 32-bit ints. The flags apply as
// the adapter's configure_descriptor did.
trusted fun __ablaRuntimeDarwinPipe(descriptors: int, flags: int): int {
    val second = __ablaRuntimeDarwinScratch(16)
    if (__ablaRuntimeDarwinScratchFailed(second)) return -12
    ablaRuntimeStoreI64(second, 0)
    val first = ablaDarwinSyscallPair(42, 0, 0, 0, 0, 0, second)
    val write = ablaRuntimeLoadI64(second)
    __ablaRuntimeDarwinScratchFree(second, 16)
    if (first < 0 && first > -4096) return __ablaRuntimeDarwinResult(first)
    ablaRuntimeStoreI32(descriptors, first)
    ablaRuntimeStoreI32(descriptors + 4, write)
    __ablaRuntimeDarwinConfigureDescriptor(first, flags)
    __ablaRuntimeDarwinConfigureDescriptor(write, flags)
    0
}


// The Darwin length of the Linux sockaddr at `address` (`size` bytes): AF_UNIX (a leading NUL, an
// abstract name, has no Darwin form) is the size itself, AF_INET 16, AF_INET6 28; or -errno
// (EINVAL 22, ENAMETOOLONG 36, EAFNOSUPPORT 97). Nothing is written.
trusted fun __ablaRuntimeDarwinSockaddrLength(address: int, size: int): int {
    if (address == 0 || size < 3) return -22
    val family = ablaRuntimeLoadU8(address) + ablaRuntimeLoadU8(address + 1) * 256
    if (family == 1) {
        if (ablaRuntimeLoadU8(address + 2) == 0) return -97
        val pathLength = size - 2
        if (pathLength > 104) return -36
        if (ablaRuntimeLoadU8(address + size - 1) != 0) return -22
        var scan = 0
        while (scan < pathLength - 1) {
            if (ablaRuntimeLoadU8(address + 2 + scan) == 0) return -22
            scan = scan + 1
        }
        return size
    }
    if (family == 2 && size >= 16) return 16
    if (family == 10 && size >= 28) return 28
    -97
}

// The Linux sockaddr at `address` as Darwin's in place, for `length` bytes: a length byte, then
// the family byte (AF_INET6 is 30) where Linux has a 16-bit family; every other byte is the
// same. The two bytes it overwrote, as a word, for __ablaRuntimeDarwinSockaddrRestore.
trusted fun __ablaRuntimeDarwinSockaddrMark(address: int, length: int): int {
    val first = ablaRuntimeLoadU8(address)
    val second = ablaRuntimeLoadU8(address + 1)
    ablaRuntimeStoreU8(address, length)
    ablaRuntimeStoreU8(address + 1, if (first == 10) 30 else first)
    first + second * 256
}

/// Restores the first two bytes of a socket address from the saved packed value.
trusted fun __ablaRuntimeDarwinSockaddrRestore(address: int, saved: int): void {
    ablaRuntimeStoreU8(address, saved & 255)
    ablaRuntimeStoreU8(address + 1, (saved >> 8) & 255)
    return
}

// A Darwin sockaddr the kernel wrote at `address` (into `room` bytes) as Linux's, in place: the
// family byte becomes a 16-bit family (AF_INET6 is 10); a family it does not know stays as it is.
trusted fun __ablaRuntimeLinuxSockaddr(address: int, room: int): void {
    if (address == 0 || room < 2) return
    val family = ablaRuntimeLoadU8(address + 1)
    var linux = family
    if (family == 30) linux = 10
    if (family == 1 || family == 2 || family == 30) {
        ablaRuntimeStoreU8(address, linux)
        ablaRuntimeStoreU8(address + 1, 0)
    }
    return
}

// Linux socket option numbers as Darwin's (the adapter's darwin_socket_option), by Darwin level:
// SOL_SOCKET 0xffff, IPPROTO_TCP 6, IPPROTO_IP 0, IPPROTO_IPV6 41. One that has no Darwin
// counterpart passes through and fails there.
trusted fun __ablaRuntimeDarwinSocketOption(level: int, option: int): int {
    if (level == 65535) {
        if (option == 1) return 1
        if (option == 2) return 4
        if (option == 3) return 4104
        if (option == 4) return 4103
        if (option == 5) return 16
        if (option == 6) return 32
        if (option == 7) return 4097
        if (option == 8) return 4098
        if (option == 9) return 8
        if (option == 10) return 256
        if (option == 13) return 128
        if (option == 15) return 512
        if (option == 18) return 4100
        if (option == 19) return 4099
        if (option == 20) return 4102
        if (option == 21) return 4101
        if (option == 30) return 2
    }
    if (level == 6) {
        if (option == 4) return 16
        if (option == 5) return 257
        if (option == 6) return 258
    }
    if (level == 0) {
        if (option == 1) return 3
        if (option == 2) return 4
        if (option == 32) return 9
        if (option == 33) return 10
        if (option == 34) return 11
        if (option == 35) return 12
        if (option == 36) return 13
    }
    if (level == 41) {
        if (option == 16) return 4
        if (option == 17) return 9
        if (option == 18) return 10
        if (option == 19) return 11
        if (option == 20) return 12
        if (option == 21) return 13
        if (option == 26) return 27
    }
    option
}

// socket 41.
trusted fun __ablaRuntimeDarwinSocket(domain: int, type: int, protocol: int): int {
    val descriptor = ablaDarwinSyscall(97, __ablaRuntimeDarwinSocketDomain(domain),
        __ablaRuntimeDarwinSocketType(type), protocol, 0, 0, 0)
    __ablaRuntimeDarwinConfigureDescriptor(descriptor, type)
    __ablaRuntimeDarwinResult(descriptor)
}

// connect 42 and bind 49.
trusted fun __ablaRuntimeDarwinAddressCall(number: int, descriptor: int, address: int,
    size: int): int {
    val length = __ablaRuntimeDarwinSockaddrLength(address, size)
    if (length < 0) return length
    val saved = __ablaRuntimeDarwinSockaddrMark(address, length)
    val raw = ablaDarwinSyscall(if (number == 42) 98 else 104, descriptor, address, length, 0, 0, 0)
    __ablaRuntimeDarwinSockaddrRestore(address, saved)
    __ablaRuntimeDarwinResult(raw)
}

// sendto 44: the destination address (argument4, length argument5) is optional.
trusted fun __ablaRuntimeDarwinSendto(
    descriptor: int,
    buffer: int,
    length: int,
    flags: int,
    address: int,
    size: int
): int {
    if (address != 0 && size > 0) {
        val converted = __ablaRuntimeDarwinSockaddrLength(address, size)
        if (converted < 0) return converted
        val saved = __ablaRuntimeDarwinSockaddrMark(address, converted)
        val raw = ablaDarwinSyscall(133, descriptor, buffer, length,
            __ablaRuntimeDarwinMessageFlags(flags), address, converted)
        __ablaRuntimeDarwinSockaddrRestore(address, saved)
        return __ablaRuntimeDarwinResult(raw)
    }
    __ablaRuntimeDarwinResult(ablaDarwinSyscall(133, descriptor, buffer, length,
        __ablaRuntimeDarwinMessageFlags(flags), 0, 0))
}

// recvfrom 45: the kernel writes the source address into the caller's buffer (length word
// `lengthAddress`), which then becomes Linux's layout.
trusted fun __ablaRuntimeDarwinRecvfrom(
    descriptor: int,
    buffer: int,
    length: int,
    flags: int,
    address: int,
    lengthAddress: int
): int {
    if (address == 0 || lengthAddress == 0) {
        return __ablaRuntimeDarwinResult(ablaDarwinSyscall(29, descriptor, buffer, length,
            __ablaRuntimeDarwinMessageFlags(flags), 0, 0))
    }
    val room = ablaRuntimeLoadI32(lengthAddress) & 4294967295
    val received = ablaDarwinSyscall(29, descriptor, buffer, length, __ablaRuntimeDarwinMessageFlags(flags),
        address, lengthAddress)
    if (received >= 0) __ablaRuntimeLinuxSockaddr(address, room)
    __ablaRuntimeDarwinResult(received)
}

// sendmsg 46: Linux's msghdr (name 0, namelen 8, iov 16, iovlen 24, control 32, controllen 40) is
// Darwin's for a send in everything but the name: iovlen and controllen are 64-bit words whose
// low halves sit where Darwin's 32-bit fields do, and msg_flags is not read. The name is a Linux
// sockaddr: rewritten in place for the call (with its length) and put back.
trusted fun __ablaRuntimeDarwinSendmsg(descriptor: int, header: int, flags: int): int {
    if (header == 0) return -22
    val name = ablaRuntimeLoadI64(header)
    val nameLength = ablaRuntimeLoadI32(header + 8) & 4294967295
    if (name == 0 || nameLength == 0) {
        return __ablaRuntimeDarwinResult(ablaDarwinSyscall(28, descriptor, header,
            __ablaRuntimeDarwinMessageFlags(flags), 0, 0, 0))
    }
    val converted = __ablaRuntimeDarwinSockaddrLength(name, nameLength)
    if (converted < 0) return converted
    val saved = __ablaRuntimeDarwinSockaddrMark(name, converted)
    ablaRuntimeStoreI32(header + 8, converted)
    val raw = ablaDarwinSyscall(28, descriptor, header, __ablaRuntimeDarwinMessageFlags(flags), 0,
        0,
        0)
    ablaRuntimeStoreI32(header + 8, nameLength)
    __ablaRuntimeDarwinSockaddrRestore(name, saved)
    __ablaRuntimeDarwinResult(raw)
}

// getsockname 51 (BSD 32) and getpeername 52 (BSD 31): the kernel fills the caller's buffer.
trusted fun __ablaRuntimeDarwinSocketName(
    number: int,
    descriptor: int,
    address: int,
    lengthAddress: int
): int {
    if (address == 0 || lengthAddress == 0) return -22
    val room = ablaRuntimeLoadI32(lengthAddress) & 4294967295
    val raw = ablaDarwinSyscall(if (number == 51) 32 else 31, descriptor, address, lengthAddress, 0,
        0, 0)
    if (raw == 0) __ablaRuntimeLinuxSockaddr(address, room)
    __ablaRuntimeDarwinResult(raw)
}

// setsockopt 54 and getsockopt 55. SO_ERROR comes back as a Linux errno; a timeval's 4 bytes of
// padding after Darwin's 32-bit tv_usec are cleared (Linux reads a 64-bit one).
trusted fun __ablaRuntimeDarwinSocketOptionCall(
    number: int,
    descriptor: int,
    level: int,
    option: int,
    value: int,
    length: int
): int {
    val darwinLevel = if (level == 1) 65535 else level
    val darwinOption = __ablaRuntimeDarwinSocketOption(darwinLevel, option)
    if (number == 54) {
        return __ablaRuntimeDarwinResult(ablaDarwinSyscall(105, descriptor, darwinLevel,
            darwinOption, value, length, 0))
    }
    val raw = ablaDarwinSyscall(118, descriptor, darwinLevel, darwinOption, value, length, 0)
    if (raw < 0) return __ablaRuntimeDarwinResult(raw)
    if (darwinLevel == 65535 && darwinOption == 4103 && value != 0) {
        ablaRuntimeStoreI32(value, __ablaRuntimeDarwinErrno(ablaRuntimeLoadI32(value)))
