// public: none
// What a program that never reaches a freeze loads in place of frozen.ab (bootstrapNativeGraphNeedsFrozen, src/toolchain.ab):
// the one name host.ab calls. The window, the group table and the collector's side of frozen groups stay in host.ab, the
// same in both, so a collection behaves alike whichever file a program loaded.

/// Returns the value unchanged: nothing in this program freezes.
trusted fun __ablaRuntimeHostFreezeBody(value: any): any = value
