        if (wrote == 0) return __ablaRuntimeWindowsEIO
        done = done + wrote
    }
    read
}

// flock(fd, operation): LOCK_SH 1, LOCK_EX 2, LOCK_UN 8, with LOCK_NB 4: the whole file locked through LockFileEx (2^64 - 1 bytes from 0), a
// lock of the open file as flock's is. Linux converts a lock the descriptor holds (shared to exclusive and back); Windows does not let one
// handle lock a range twice, so a lock operation first drops the lock the handle holds (not atomic: another process may take the file
// in between, and a failed LOCK_NB conversion has lost the old lock). A busy file with LOCK_NB is EAGAIN (-11), unlocking a file that
// is not locked is 0.
private @noinline trusted fun __ablaRuntimeWindowsFlock(descriptor: int, operation: int): int {
    val handle = __ablaRuntimeWindowsHandle(descriptor)
    if (handle == 0) return __ablaRuntimeWindowsEBADF
    val record = __ablaRuntimeWindowsPathBuffer()
    if (record == 0) return __ablaRuntimeWindowsENOMEM
    var offset = 0
    while (offset < 32) {
        ablaRuntimeStoreI64(record + offset, 0)
        offset = offset + 8
    }
    val kind = operation & 11
    if (kind != 1 && kind != 2 && kind != 8) return __ablaRuntimeWindowsEINVAL
    int(UnlockFileEx(handle, 0, 4294967295, 4294967295, record))
    if (kind == 8) return 0
    var flags = 0
    if (kind == 2) flags = flags + 2
    if ((operation & 4) != 0) flags = flags + 1
    if (int(LockFileEx(handle, flags, 0, 4294967295, 4294967295, record)) != 0) return 0
    val code = int(GetLastError()) & 4294967295
    if (code == 33 || code == 32) return -11
    return __ablaRuntimeWindowsErrno()
}

// The path calls chmod 90, link 86 and utimes 235, and pread64 17: small mappings of what Linux does onto kernel32.
//  - chmod: the read-only attribute (the owner's write bit), as fchmod does;
//  - link: a hard link (CreateHardLinkW);
//  - utimes(path, null): the access and modification times set to now; a times array is not translated (EINVAL);
//  - pread64(fd, buffer, count, offset): ReadFile at an offset, the file position put back as pread leaves it; 0 at the end.
private @noinline trusted fun __ablaRuntimeWindowsPathCall(number: int, a0: int, a1: int, a2: int, a3: int): int {
    if (number == 86) {
        val from = __ablaRuntimeWindowsWidePath(a0, 0)
        val to = __ablaRuntimeWindowsWidePath(a1, 1)
        if (from == 0 || to == 0) return -2
        if (int(CreateHardLinkW(to, from, 0)) == 0) return __ablaRuntimeWindowsErrno()
        return 0
    }
    if (number == 17) {
        val handle = __ablaRuntimeWindowsHandle(a0)
        if (handle == 0) return -9
        val scratch = __ablaRuntimeWindowsScratch()
        val record = __ablaRuntimeWindowsPathBuffer()
        if (record == 0) return -12
        if (int(SetFilePointerEx(handle, 0, scratch, 1)) == 0) return __ablaRuntimeWindowsErrno()
        val position = ablaRuntimeLoadI64(scratch)
        ablaRuntimeStoreI64(record, 0)
        ablaRuntimeStoreI64(record + 8, 0)
        ablaRuntimeStoreI64(record + 16, a3)
        ablaRuntimeStoreI64(record + 24, 0)
        ablaRuntimeStoreI64(scratch + 8, 0)
        val ok = int(ReadFile(handle, a1, a2, scratch + 8, record))
        val code = int(GetLastError()) & 4294967295
        int(SetFilePointerEx(handle, position, 0, 0))
        if (ok == 0) {
            if (code == 38 || code == 109) return 0
            return __ablaRuntimeWindowsErrno()
        }
        return ablaRuntimeLoadI32(scratch + 8) & 4294967295
    }
    val wide = __ablaRuntimeWindowsWidePath(a0, 0)
    if (wide == 0) return -2
    if (number == 235) {
        if (a1 != 0) return __ablaRuntimeWindowsEINVAL
        // FILE_WRITE_ATTRIBUTES, shared with everyone, backup semantics: a directory opens too
        val handle = CreateFileW(wide, 256, 7, 0, 3, 33554432, 0)
        if (handle == -1) return __ablaRuntimeWindowsErrno()
        val now = __ablaRuntimeWindowsScratch()
        GetSystemTimePreciseAsFileTime(now)
        val done = int(SetFileTime(handle, 0, now, now))
        val failure = if (done == 0) __ablaRuntimeWindowsErrno() else 0
        int(CloseHandle(handle))
        return failure
    }
    // chmod(path, mode): the read-only attribute as fchmod's translation sets it (the owner's write bit); the directory bit is not settable
    val attributes = int(GetFileAttributesW(wide)) & 4294967295
    if (attributes == 4294967295) return __ablaRuntimeWindowsErrno()
    var wanted = if ((a1 & 128) != 0) attributes & 4294967294 else attributes | 1
    if (wanted == attributes) return 0
    wanted = wanted & 4294967279
    if (wanted == 0) wanted = 128
    if (int(SetFileAttributesW(wide, wanted)) == 0) return __ablaRuntimeWindowsErrno()
    0
}

/** The compile-time guard's two entries that must not go through __ablaRuntimeWindowsSyscall: the backend sends a call whose
 *  number is a constant 4003 or 4005 here instead (src/backend/llvm/functions.ab). 4005 is the vectored handler, which runs on
 *  the stack of the thread that faulted, an overflowed one included (tests/cases/windows/fault-guard.ab): the dispatcher's frame,
 *  which grows with every call it translates, left too little room there under Wine (89's socket helper, ablac windows-net-89),
 *  so this one is small, and tools/test-windows-syscalls.sh fails when its frame grows past a fixed bound. 4003 is the watchdog
 *  thread's loop (out of line: its frame is the loop's own). Any other number: ENOSYS.
 */
trusted fun __ablaRuntimeWindowsGuardSyscall(number: int, a0: int): int {
    if (number == 4005) return __ablaRuntimeWindowsFault(a0)
    if (number == 4003) return __ablaRuntimeWindowsWatchdog(a0)
    -38
}

// The process calls: -1000 when `number` is none of them.
private trusted fun __ablaRuntimeWindowsProcessCall(number: int, a0: int, a1: int, a2: int, a3: int): int {
    // wait4(pid, status, options, usage)
    if (number == 61) return __ablaRuntimeWindowsWait(a0, a1, a2)
    // kill(pid, signal)
    if (number == 62) return __ablaRuntimeWindowsKill(a0, a1)
    // setpgid and getpgid: a process group is the process
    if (number == 109) {
        val member = __ablaRuntimeWindowsProcessEntry(a0)
        if (member != 0) ablaRuntimeStoreI64(member + 16, if (a1 == 0) a0 else a1)
        return 0
    }
    if (number == 121) return if (a0 == 0) int(GetCurrentProcessId()) & 4294967295 else a0
    // getrusage(who, usage)
    if (number == 98) return __ablaRuntimeWindowsResourceUsage(a0, a1)
    // pipe2(descriptors, flags)
    if (number == 293) return __ablaRuntimeWindowsPipe(a0)
    // fork and exec are not translated: the standard library launches with spawn (4001)
    if (number == 57 || number == 56 || number == 58 || number == 59) return -38
    // spawn(block)
    if (number == 4001) return __ablaRuntimeWindowsSpawn(a0)
    // watch(request): the compile-time watchdog for the calling thread
    if (number == 4002) return __ablaRuntimeWindowsWatch(a0)
    // the watchdog thread itself (its entry, __ablaRuntimeWindowsWatchdogEntry): does not return
    if (number == 4003) return __ablaRuntimeWindowsWatchdog(a0)
    // faults(request): the compile-time guard's fault target for the calling thread
    if (number == 4004) return __ablaRuntimeWindowsFaults(a0)
    // the vectored handler itself (its entry, __ablaRuntimeWindowsFaultEntry)
    if (number == 4005) return __ablaRuntimeWindowsFault(a0)
    // systemRoots(buffer, size): the DER of the system's trusted root certificates
    if (number == 4006) return __ablaRuntimeWindowsSystemRoots(a0, a1)
    // dnsServers(buffer, size): resolv.conf's lines for the system's DNS servers
    if (number == 4007) return __ablaRuntimeWindowsDnsServers(a0, a1)
    // processInfo(output): the memory, descriptors and start time of the process
    if (number == 4008) return __ablaRuntimeWindowsProcessInfo(a0)
    -1000
}

/** The Linux system call number with six arguments, answered with kernel32: the result, or -errno; a number the translation does not handle ends the process with status 70 after naming it on standard error. */
trusted fun __ablaRuntimeWindowsSyscall(number: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int): int {
    // write(fd, buffer, count)
    if (number == 1) {
        val socket = __ablaRuntimeWindowsSocketOf(a0)
        if (socket != 0) {
            val sent = int(send(socket, a1, a2, 0))
            if (sent < 0) return __ablaRuntimeWindowsSocketIoErrno()
            return sent
        }
        val handle = __ablaRuntimeWindowsHandle(a0)
        if (handle == 0) return __ablaRuntimeWindowsEBADF
        val scratch = __ablaRuntimeWindowsScratch()
        ablaRuntimeStoreI64(scratch, 0)
        if (int(WriteFile(handle, a1, a2, scratch, 0)) == 0) return __ablaRuntimeWindowsEIO
        return ablaRuntimeLoadI32(scratch) & 4294967295
    }
    // renameat(oldDirectory, old, newDirectory, new, flags): directory descriptors only, no flags
    if (number == 264) {
        if (a0 == -100 || a2 == -100 || a4 != 0) return -38
        val from = __ablaRuntimeWindowsAnchoredWide(a0, a1, 16384)
        if (from < 0) return from
        val to = __ablaRuntimeWindowsAnchoredWide(a2, a3, 49152)
        if (to < 0) return to
        if (int(MoveFileExW(from, to, 1)) == 0) return __ablaRuntimeWindowsErrno()
        return 0
    }
    // mmap(address, length, protection, flags, fd, offset): anonymous memory only; MAP_FIXED (16) over an existing range is not
    // translated (the frozen groups' window needs it: a later step)
    if (number == 9) {
        if (a4 != -1 || (a3 & 16) != 0) return -38
        val reserve = a2 == 0
        val address = VirtualAlloc(a0, a1, if (reserve) 8192 else 12288, __ablaRuntimeWindowsProtection(a2))
        if (address == 0) return __ablaRuntimeWindowsENOMEM
        return address
    }
    // mprotect(address, length, protection)
    if (number == 10) {
        val scratch = __ablaRuntimeWindowsScratch()
        val protection = __ablaRuntimeWindowsProtection(a2)
        if (int(VirtualProtect(a0, a1, protection, scratch)) != 0) return 0
        // VirtualProtect refuses pages that are only reserved (an mmap of no access, as the frozen heap's window is: a Linux mprotect
        // makes them usable): commit them with the protection. Without it the pages stayed unusable and the first store to one was
        // an access violation (tests/cases/windows/reserve-commit.ab; windows-http-async's release build on windows-latest).
        if (a2 != 0 && VirtualAlloc(a0, a1, 4096, protection) != 0) return 0
        return __ablaRuntimeWindowsEINVAL
    }
    // munmap(address, length): a whole reservation (the runtime unmaps what it mapped, whole); a part of one is refused
    if (number == 11) {
        if (int(VirtualFree(a0, 0, 32768)) == 0) return __ablaRuntimeWindowsEINVAL
        return 0
    }
    // mremap(base, before, after, flags)
    if (number == 25) return __ablaRuntimeWindowsRemap(a0, a1, a2)
    // madvise(address, length, advice): MADV_DONTNEED (4) gives the pages back; MADV_WIPEONFORK (18) has no fork to serve
    if (number == 28) {
        if (a2 == 4) {
            int(DiscardVirtualMemory(a0, a1))
            return 0
        }
        return __ablaRuntimeWindowsEINVAL
    }
    // nanosleep(request, remaining)
    if (number == 35) {
        val seconds = ablaRuntimeLoadI64(a0)
        val nanoseconds = ablaRuntimeLoadI64(a0 + 8)
        return __ablaRuntimeWindowsSleep(seconds * 1000 + (nanoseconds + 999999) / 1000000)
    }
    // getpid, gettid
    if (number == 39) return int(GetCurrentProcessId()) & 4294967295
    if (number == 186) return int(GetCurrentThreadId()) & 4294967295
    // sigaltstack(new, old): a Windows thread has no alternate signal stack to install; the old one is left as zeroes, "none"
    if (number == 131) return 0
    // getrlimit(resource, limits): the stack (RLIMIT_STACK, 3) is what the calling thread has reserved (GetCurrentThreadStackLimits:
    // the image's /stack, 8 MiB for a program, 128 MiB for the compiler), the descriptors (RLIMIT_NOFILE, 7) the table's size, both
    // soft and hard; any other resource is unlimited (all ones).
    if (number == 97) {
        var stack = 8388608
        if (a0 == 3) {
            val bounds = __ablaRuntimeWindowsScratch()
            GetCurrentThreadStackLimits(bounds, bounds + 8)
            val reserved = ablaRuntimeLoadI64(bounds + 8) - ablaRuntimeLoadI64(bounds)
            if (reserved > 0) stack = reserved
        }
        val limit = if (a0 == 3) stack else if (a0 == 7) __ablaRuntimeWindowsFdCount else -1
        ablaRuntimeStoreI64(a1, limit)
        ablaRuntimeStoreI64(a1 + 8, limit)
        return 0
    }
    // sched_getaffinity(process, size, mask): this process's (GetProcessAffinityMask, the CPUs of its group: up to 64) in the
    // mask's first 8 bytes, the rest zeroes; returns the 8 bytes written, as Linux returns its mask's size.
    if (number == 204) {
        if (a1 < 8) return __ablaRuntimeWindowsEINVAL
        var offset = 0
        while (offset + 8 <= a1) {
            ablaRuntimeStoreI64(a2 + offset, 0)
            offset = offset + 8
