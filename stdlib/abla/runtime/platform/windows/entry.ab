    if (table == 0) return 0
    val entry = table + epfd * 64
    if (ablaRuntimeAtomicLoadI64(entry) == 0 || ablaRuntimeLoadI64(entry + 8) != 4) return 0
    entry
}

private trusted fun __ablaRuntimeWindowsEpollLock(entry: int): void {
    while (ablaRuntimeAtomicCompareExchangeI64(entry + 32, 0, 1) != 0) Sleep(0)
    return
}

private trusted fun __ablaRuntimeWindowsEpollUnlock(entry: int): void {
    ablaRuntimeAtomicStoreI64(entry + 32, 0)
    return
}

