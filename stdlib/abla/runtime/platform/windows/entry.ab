}
/** kernel32 CreateThread: starts a thread at start with parameter; returns its handle, or 0 when it fails. */
private trusted noescape extern:"c" fun CreateThread(attributes: int, stack: int, start: int, parameter: int, flags: int, id: int): int
/** The Abla Windows routine (src/backend/llvm/windows.ab): sets a CONTEXT's ContextFlags to the control and integer registers. */
private trusted noescape extern:"c" fun abla_windows_context_prepare(context: int): void
/** The Abla Windows routine (src/backend/llvm/windows.ab): a CONTEXT's program counter. */
private trusted noescape extern:"c" fun abla_windows_context_pc(context: int): int
/** The Abla Windows routine (src/backend/llvm/windows.ab): makes a CONTEXT resume at target with first and second as its first two arguments, the stack pointer aligned as a call leaves it. */
private trusted noescape extern:"c" fun abla_windows_redirect(context: int, target: int, first: int, second: int): void

// The watchdog's block (one for the process, zeroed): 0 the arming count (32 bits, what the watchdog waits on), 8 the deadline in
// milliseconds of the performance counter (0: disarmed), 16 the watched thread's handle, 24 the check function, 32 the
// redirect target, 40 another interrupt word to set (0: none), 48 the thread's own interrupt word, 56 the watchdog thread's
// handle (0: not started), 64 and 72 the watchdog's clock scratch, 80 its copy of the arming count,
// from 128 the CONTEXT (16-aligned, as GetThreadContext requires; x64's is 1232 bytes, ARM64's 912), from 1536 the
// MEMORY_BASIC_INFORMATION __ablaRuntimeWindowsImageOf fills.
