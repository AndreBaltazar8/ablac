            // early return they already allow.
            while (int(WaitOnAddress(a0, scratch, 4, __ablaRuntimeWindowsWaitSlice)) == 0 &&
                ablaRuntimeLoadI32(a0) == ablaRuntimeLoadI32(scratch)) {
                if (__ablaRuntimeWindowsInterrupted()) return -4
