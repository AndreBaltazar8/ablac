    // beside the program or on the PATH can stand in for it), and a failure to load or find any of the three functions fails the
    // call: the caller gets an error, never a store that was not read.
    val scratch = __ablaRuntimeWindowsScratch()
    ablaRuntimeStoreI64(scratch, 23644237351288914)
    ablaRuntimeStoreI64(scratch + 8, 0)
    ablaRuntimeStoreI64(scratch + 16, 31525717090107491)
    ablaRuntimeStoreI64(scratch + 24, 12948063680397428)
    ablaRuntimeStoreI64(scratch + 32, 463863545956)
