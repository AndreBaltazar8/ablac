        return __ablaRuntimeWindowsRefuse(number)
    }
    // rt_sigprocmask(how, set, old, size): Windows has no POSIX signals to block, so the mask is empty and stays so; the old one
    // (when asked for) is written as empty.
    if (number == 14) {
        if (a2 != 0 && a3 >= 8) ablaRuntimeStoreI64(a2, 0)
        return 0
    }
    // getuid, getgid, geteuid, getegid: Windows has no POSIX user and group ids; every one is 0, the same answer each time (an
    // id the standard library compares against /etc/passwd, which a Windows program reads only under Wine).
    if (number == 102 || number == 104 || number == 107 || number == 108) return 0
    // clock_gettime(clock, timespec)
    if (number == 228) return __ablaRuntimeWindowsClock(a0, a1)
    // exit_group(status), exit(status)
    if (number == 231 || number == 60) {
        ExitProcess(a0)
        return 0
    }
    // the file calls: read, close, stat, lseek, fsync, getcwd, rename, mkdir, unlink, getdents64, openat, newfstatat, getrandom ... (the process's own
    // /proc entries do not exist: an openat of one is ENOENT, and the callers fall back)
    val process = __ablaRuntimeWindowsProcessCall(number, a0, a1, a2, a3)
    if (process != -1000) return process
    // chmod 90, link 86, utimes 235, pread64 17
    if (number == 90 || number == 86 || number == 235 || number == 17) return __ablaRuntimeWindowsPathCall(number, a0, a1, a2, a3)
    // flock(fd, operation)
    if (number == 73) return __ablaRuntimeWindowsFlock(a0, a1)
    // copy_file_range(in, offsetIn, out, offsetOut, length, flags): a chunk of the input
    if (number == 326) return __ablaRuntimeWindowsCopyFileRange(a0, a1, a2, a3, a4, a5)
    val network = __ablaRuntimeWindowsSocketCall(number, a0, a1, a2, a3, a4, a5)
    if (network != -1000) return network
    val file = __ablaRuntimeWindowsFileCall(number, a0, a1, a2, a3)
    if (file != -1000) return file
    __ablaRuntimeWindowsRefuse(number)
}

// The numbers __ablaRuntimeWindowsSyscall translates, for tools/test-windows-syscalls.sh.
/** The Linux system call numbers __ablaRuntimeWindowsSyscall translates, in order, separated by spaces (what tools/test-windows-syscalls.sh checks against the translation). */
trusted fun __ablaRuntimeWindowsTranslated(): string = "0 1 3 4 5 6 7 8 9 10 11 14 16 17 21 25 28 33 35 39 41 42 43 44 45 46 48 49 50 51 52 54 55 56 57 58 59 60 61 62 72 73 74 77 79 80 82 83 84 86 87 88 89 90 91 97 98 102 104 107 108 109 121 131 186 202 204 217 228 231 235 232 233 257 258 262 263 264 288 291 293 318 326 4001 4002 4003 4004 4005 4006 4007 4008"

// argc and argv for main, from GetCommandLineW: the command line as UTF-8 and split by the rules of CommandLineToArgvW (a quoted
// program name; backslashes are literal except before a quote; 2n backslashes and a quote make n and open or close a quoted run;
// 2n+1 make n and a literal quote), in memory of its own (the runtime's heap is not up yet). Stores argc at `argcOut` and returns argv.
/** The process's arguments for main: stores argc at argcOut and returns the address of the argv array, both from GetCommandLineW; argc is 0 and the result 0 when the command line cannot be read. */
trusted fun __ablaRuntimeWindowsArguments(argcOut: int): int {
    val wide = GetCommandLineW()
    val size = int(WideCharToMultiByte(65001, 0, wide, -1, 0, 0, 0, 0))
    if (size <= 0) {
        ablaRuntimeStoreI32(argcOut, 0)
        return 0
    }
    // The environment block: UTF-16 "NAME=value" strings, each NUL-ended, and an empty one at the end (units: the characters through it).
    val environment = GetEnvironmentStringsW()
    var units = 0
    var entries = 0
    if (environment != 0) {
        var scanning = true
        while (scanning) {
            if (ablaRuntimeLoadU8(environment + units * 2) == 0 && ablaRuntimeLoadU8(environment + units * 2 + 1) == 0) {
                units = units + 1
                scanning = false
            } else {
                while (ablaRuntimeLoadU8(environment + units * 2) != 0 || ablaRuntimeLoadU8(environment + units * 2 + 1) != 0) units = units + 1
                units = units + 1
                entries = entries + 1
            }
        }
    }
    val environmentBytes = if (environment != 0) int(WideCharToMultiByte(65001, 0, environment, units, 0, 0, 0, 0)) else 0
    // The text, then room for 1 + size / 2 argument pointers and the terminator, the same for the environment pointers, and its text.
    val slots = size / 2 + 2 + entries + 2
    val block = VirtualAlloc(0, size + slots * 8 + environmentBytes + 32, 12288, 4)
    if (block == 0) {
        ablaRuntimeStoreI32(argcOut, 0)
        return 0
    }
    val text = block
    val argv = block + ((size + 15) / 16) * 16
    int(WideCharToMultiByte(65001, 0, wide, -1, text, size, 0, 0))
    // The pieces are written back into `text` (an argument is never longer than its source).
    var read = 0
    var count = 0
    var written = 0
    val end = size - 1
    var first = true
    while (read < end) {
        while (read < end && (ablaRuntimeLoadU8(text + read) == 32 || ablaRuntimeLoadU8(text + read) == 9)) read = read + 1
        if (read >= end) break
        ablaRuntimeStoreI64(argv + count * 8, text + written)
        count = count + 1
        if (first) {
            // The program name: up to the closing quote when it opens with one, else up to white space; no escapes.
            first = false
            if (ablaRuntimeLoadU8(text + read) == 34) {
                read = read + 1
                while (read < end && ablaRuntimeLoadU8(text + read) != 34) {
                    ablaRuntimeStoreU8(text + written, ablaRuntimeLoadU8(text + read))
                    written = written + 1
                    read = read + 1
                }
                if (read < end) read = read + 1
            } else {
                while (read < end && ablaRuntimeLoadU8(text + read) != 32 && ablaRuntimeLoadU8(text + read) != 9) {
                    ablaRuntimeStoreU8(text + written, ablaRuntimeLoadU8(text + read))
                    written = written + 1
                    read = read + 1
                }
            }
        } else {
            var quoted = false
            var going = true
            while (going && read < end) {
                val byte = ablaRuntimeLoadU8(text + read)
                if (byte == 92) {
                    var slashes = 0
                    while (read < end && ablaRuntimeLoadU8(text + read) == 92) {
                        slashes = slashes + 1
                        read = read + 1
                    }
                    if (read < end && ablaRuntimeLoadU8(text + read) == 34) {
                        var literal = slashes / 2
                        while (literal > 0) {
                            ablaRuntimeStoreU8(text + written, 92)
                            written = written + 1
                            literal = literal - 1
                        }
                        if (slashes % 2 == 1) {
                            ablaRuntimeStoreU8(text + written, 34)
                            written = written + 1
                            read = read + 1
                        }
                    } else {
                        while (slashes > 0) {
                            ablaRuntimeStoreU8(text + written, 92)
                            written = written + 1
                            slashes = slashes - 1
                        }
                    }
                } else if (byte == 34) {
                    quoted = !quoted
                    read = read + 1
                } else if (!quoted && (byte == 32 || byte == 9)) {
                    going = false
                } else {
                    ablaRuntimeStoreU8(text + written, byte)
                    written = written + 1
                    read = read + 1
                }
            }
        }
        ablaRuntimeStoreU8(text + written, 0)
        written = written + 1
        if (read < end) read = read + 1
    }
    ablaRuntimeStoreI64(argv + count * 8, 0)
    // The environment follows argv as Linux lays it out (envp = argv + argc + 1 words), entries that begin with "=" (the per-drive
    // working directories) left out.
    val pointers = argv + (count + 1) * 8
    var variables = 0
    if (environment != 0) {
        val texts = argv + slots * 8
        int(WideCharToMultiByte(65001, 0, environment, units, texts, environmentBytes, 0, 0))
        var at = 0
        while (at < environmentBytes && ablaRuntimeLoadU8(texts + at) != 0) {
            if (ablaRuntimeLoadU8(texts + at) != 61) {
                ablaRuntimeStoreI64(pointers + variables * 8, texts + at)
                variables = variables + 1
            }
            while (ablaRuntimeLoadU8(texts + at) != 0) at = at + 1
            at = at + 1
        }
        int(FreeEnvironmentStringsW(environment))
    }
    ablaRuntimeStoreI64(pointers + variables * 8, 0)
    ablaRuntimeStoreI32(argcOut, count)
    argv
}
