// --- the compile-time watchdog (docs/design/windows-jit.md §5) ---------------------------------------------------------------
// Windows has no SIGALRM to stop a compile-time call that runs past its time limit, so call 4002 arms a watchdog thread for the
// calling thread instead. At the deadline the watchdog stops the thread in one of the ways the Linux alarm does:
// - running JIT'd code (its program counter in no loaded image: VirtualQuery, __ablaRuntimeWindowsImageOf): suspended, its CONTEXT pointed at the
//   redirect target with (14, 0), as the alarm handler is called with SIGALRM, and resumed;
// - anywhere else (the compiler's or the runtime's code, a system DLL): resumed as it was, its interrupt words set and its
//   synchronous I/O cancelled (CancelSynchronousIo), so its waits and reads return EINTR, and tried again a millisecond later,
//   since a redirect there could leave a loader, heap or I/O lock held.
// The check function, called while the thread is suspended, says which applies: 0 the guard is not armed (try again), 1 the
// thread is in the compiler's code and the stop is deferred to its return (done), 2 a redirect may be made. With no check
// function (an interpreted site) every stop is an interrupt, repeated every second until the watch is disarmed, as the Linux
// interval timer repeats. Between SuspendThread and ResumeThread the watchdog allocates nothing and takes no lock.

// (Private: a program may declare the same calls for itself, as tests/cases/windows/preempt.ab and fault-jump.ab do.)
/** kernel32 OpenThread: a handle with the given access to the thread with the given id, or 0 when it fails. */
private trusted noescape extern:"c" fun OpenThread(access: int, inherit: int, id: int): int
/** kernel32 SuspendThread: suspends a thread; returns its previous suspend count, or 0xFFFFFFFF when it fails. */
private trusted noescape extern:"c" fun SuspendThread(target: int): i32
/** kernel32 ResumeThread: lowers a thread's suspend count; returns the previous count, or 0xFFFFFFFF when it fails. */
private trusted noescape extern:"c" fun ResumeThread(target: int): i32
/** kernel32 GetThreadContext: stores a suspended thread's registers in the CONTEXT at context (its ContextFlags say which); returns non-zero on success. */
private trusted noescape extern:"c" fun GetThreadContext(target: int, context: int): i32
/** kernel32 SetThreadContext: sets a suspended thread's registers from the CONTEXT at context; returns non-zero on success. */
private trusted noescape extern:"c" fun SetThreadContext(target: int, context: int): i32
/** kernel32 CancelSynchronousIo: ends the thread's pending synchronous read or write with ERROR_OPERATION_ABORTED; returns non-zero when one was cancelled. */
private trusted noescape extern:"c" fun CancelSynchronousIo(target: int): i32
/** kernel32 VirtualQuery: fills `size` bytes of MEMORY_BASIC_INFORMATION at `info` for the region holding `address`; returns the bytes written, 0 on failure. */
private trusted noescape extern:"c" fun VirtualQuery(address: int, info: int, size: int): int

// The base of the loaded image that holds `pc`, or 0 when none does (JIT'd code, a stack, the heap): VirtualQuery's
// MEMORY_BASIC_INFORMATION (48 bytes at `scratch`: AllocationBase at 8, Type at 40, MEM_IMAGE 0x1000000). RtlPcToFileHeader
// answered this before, but it takes the loader lock (Wine's does), which the thread the watchdog suspended may hold: the
// watchdog then waited for ever (a gate under load). VirtualQuery is a system call and takes no lock.
private trusted fun __ablaRuntimeWindowsImageOf(pc: int, scratch: int): int {
    if (VirtualQuery(pc, scratch, 48) == 0) return 0
    if ((ablaRuntimeLoadI32(scratch + 40) & 4294967295) != 16777216) return 0
