}

// Takes entry `index` out of the registry at `page` (the last one moves into its place).
private trusted fun __ablaRuntimeWindowsEpollRemove(entry: int, page: int, index: int): void {
    val last = ablaRuntimeLoadI64(entry + 24) - 1
