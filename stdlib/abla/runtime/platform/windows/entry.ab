// Milliseconds of the performance counter, with `scratch` (16 bytes) for its out-parameters.
private trusted fun __ablaRuntimeWindowsMilliseconds(scratch: int): int {
    int(QueryPerformanceFrequency(scratch))
    int(QueryPerformanceCounter(scratch + 8))
    val frequency = ablaRuntimeLoadI64(scratch)
    val ticks = ablaRuntimeLoadI64(scratch + 8)
