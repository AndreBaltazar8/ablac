trusted noescape extern:"c" fun GetExitCodeProcess(process: int, code: int): int
/** kernel32 TerminateProcess: ends a process at once with the exit code; returns non-zero on success. */
trusted noescape extern:"c" fun TerminateProcess(process: int, code: int): int
/** kernel32 SetHandleInformation: sets the flags in mask of a handle (HANDLE_FLAG_INHERIT is 1) to flags; returns non-zero on success. */
trusted noescape extern:"c" fun SetHandleInformation(handle: int, mask: int, flags: int): int
/** kernel32 DuplicateHandle: duplicates a handle of a source process into a target process (options 2: same access), storing the new handle at target; returns non-zero on success. */
trusted noescape extern:"c" fun DuplicateHandle(sourceProcess: int, source: int, targetProcess: int, target: int, access: int, inherit: int, options: int): int
/** kernel32 GetCurrentProcess: the pseudo handle of the calling process; never fails. */
trusted noescape extern:"c" fun GetCurrentProcess(): int
