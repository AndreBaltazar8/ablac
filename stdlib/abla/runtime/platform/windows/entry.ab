// --- the compile-time watchdog (docs/design/windows-jit.md §5) ---------------------------------------------------------------
// Windows has no SIGALRM to stop a compile-time call that runs past its time limit, so call 4002 arms a watchdog thread for the
// calling thread instead. At the deadline the watchdog stops the thread in one of the ways the Linux alarm does:
// - running JIT'd code (its program counter in no loaded image, RtlPcToFileHeader): suspended, its CONTEXT pointed at the
//   redirect target with (14, 0), as the alarm handler is called with SIGALRM, and resumed;
// - anywhere else (the compiler's or the runtime's code, a system DLL): resumed as it was, its interrupt words set and its
//   synchronous I/O cancelled (CancelSynchronousIo), so its waits and reads return EINTR, and tried again a millisecond later,
//   since a redirect there could leave a loader, heap or I/O lock held.
// The check function, called while the thread is suspended, says which applies: 0 the guard is not armed (try again), 1 the
// thread is in the compiler's code and the stop is deferred to its return (done), 2 a redirect may be made. With no check
// function (an interpreted site) every stop is an interrupt, repeated every second until the watch is disarmed, as the Linux
// interval timer repeats. Between SuspendThread and ResumeThread the watchdog allocates nothing and takes no lock.

// (Private: a program may declare the same calls for itself, as tests/cases/windows/preempt.ab and fault-jump.ab do.)
/** kernel32 OpenThread: a handle with the given access to the thread with the given id, or 0 when it fails. */
private trusted noescape extern:"c" fun OpenThread(access: int, inherit: int, id: int): int
/** kernel32 SuspendThread: suspends a thread; returns its previous suspend count, or 0xFFFFFFFF when it fails. */
private trusted noescape extern:"c" fun SuspendThread(target: int): int
/** kernel32 ResumeThread: lowers a thread's suspend count; returns the previous count, or 0xFFFFFFFF when it fails. */
private trusted noescape extern:"c" fun ResumeThread(target: int): int
/** kernel32 GetThreadContext: stores a suspended thread's registers in the CONTEXT at context (its ContextFlags say which); returns non-zero on success. */
private trusted noescape extern:"c" fun GetThreadContext(target: int, context: int): int
/** kernel32 SetThreadContext: sets a suspended thread's registers from the CONTEXT at context; returns non-zero on success. */
private trusted noescape extern:"c" fun SetThreadContext(target: int, context: int): int
/** kernel32 CancelSynchronousIo: ends the thread's pending synchronous read or write with ERROR_OPERATION_ABORTED; returns non-zero when one was cancelled. */
private trusted noescape extern:"c" fun CancelSynchronousIo(target: int): int
/** kernel32 RtlPcToFileHeader: the base of the loaded image that holds the address pc (also stored at base), or 0 when no image does. */
private trusted noescape extern:"c" fun RtlPcToFileHeader(pc: int, base: int): int
/** kernel32 CreateThread: starts a thread at start with parameter; returns its handle, or 0 when it fails. */
private trusted noescape extern:"c" fun CreateThread(attributes: int, stack: int, start: int, parameter: int, flags: int, id: int): int
/** The Abla Windows routine (src/backend/llvm/windows.ab): sets a CONTEXT's ContextFlags to the control and integer registers. */
private trusted noescape extern:"c" fun abla_windows_context_prepare(context: int): void
/** The Abla Windows routine (src/backend/llvm/windows.ab): a CONTEXT's program counter. */
private trusted noescape extern:"c" fun abla_windows_context_pc(context: int): int
/** The Abla Windows routine (src/backend/llvm/windows.ab): makes a CONTEXT resume at target with first and second as its first two arguments, the stack pointer aligned as a call leaves it. */
private trusted noescape extern:"c" fun abla_windows_redirect(context: int, target: int, first: int, second: int): void

// The watchdog's block (one for the process, zeroed): 0 the arming count (32 bits, what the watchdog waits on), 8 the deadline in
// milliseconds of the performance counter (0: disarmed), 16 the watched thread's handle, 24 the check function, 32 the
// redirect target, 40 another interrupt word to set (0: none), 48 the thread's own interrupt word, 56 the watchdog thread's
// handle (0: not started), 64 and 72 the watchdog's clock scratch, 80 its copy of the arming count, 88 RtlPcToFileHeader's out
// parameter, from 128 the CONTEXT (16-aligned, as GetThreadContext requires; x64's is 1232 bytes, ARM64's 912).
private trusted fun __ablaRuntimeWindowsWatchBlock(): int = (nativeStaticAllocate(4096) + 15) / 16 * 16

// Milliseconds of the performance counter, with `scratch` (16 bytes) for its out-parameters.
private trusted fun __ablaRuntimeWindowsMilliseconds(scratch: int): int {
    QueryPerformanceFrequency(scratch)
    QueryPerformanceCounter(scratch + 8)
    val frequency = ablaRuntimeLoadI64(scratch)
    val ticks = ablaRuntimeLoadI64(scratch + 8)
    ticks / frequency * 1000 + ticks % frequency * 1000 / frequency
}

// One stop of the watched thread at its deadline: true when it is done (redirected, deferred, an interrupt of an interpreted
// site, or the thread is gone or disarmed), false to try again a millisecond later.
private trusted fun __ablaRuntimeWindowsWatchStop(block: int, armed: int): bool {
    val target = ablaRuntimeLoadI64(block + 16)
    if ((SuspendThread(target) & 4294967295) == 4294967295) return true
    // Disarmed or armed again since the deadline was read: nothing to stop (the thread itself arms and disarms, and it is
    // suspended now).
    if ((ablaRuntimeAtomicLoadI64(block) & 4294967295) != armed || ablaRuntimeAtomicLoadI64(block + 8) == 0) {
        ResumeThread(target)
        return true
    }
    val context = block + 128
    abla_windows_context_prepare(context)
    val read = GetThreadContext(target, context) != 0
    val check = ablaRuntimeLoadI64(block + 24)
    val state = if (check == 0) 3 else ablaUnsafeCallMain(check)
    if (read && state == 2 && RtlPcToFileHeader(abla_windows_context_pc(context), block + 88) == 0) {
        abla_windows_redirect(context, ablaRuntimeLoadI64(block + 32), 14, 0)
        val set = SetThreadContext(target, context) != 0
        ResumeThread(target)
        if (set) return true
    } else ResumeThread(target)
    ablaRuntimeAtomicStoreI64(ablaRuntimeLoadI64(block + 48), 1)
    val other = ablaRuntimeLoadI64(block + 40)
    if (other != 0) ablaRuntimeAtomicStoreI64(other, 1)
    CancelSynchronousIo(target)
    state == 1 || state == 3
}

// The watchdog thread: waits for a deadline, stops the watched thread at it, and waits again.
private trusted fun __ablaRuntimeWindowsWatchdog(block: int): int {
    while (true) {
        val armed = ablaRuntimeAtomicLoadI64(block) & 4294967295
        ablaRuntimeStoreI64(block + 80, armed)
        val deadline = ablaRuntimeAtomicLoadI64(block + 8)
        val now = __ablaRuntimeWindowsMilliseconds(block + 64)
        if (deadline == 0) WaitOnAddress(block, block + 80, 4, 4294967295)
        else if (now < deadline) WaitOnAddress(block, block + 80, 4, deadline - now)
        else if (__ablaRuntimeWindowsWatchStop(block, armed)) {
            // An interpreted site is interrupted again every second; a native call's watch ends (its thread disarms it).
            val next = if (ablaRuntimeLoadI64(block + 24) == 0) now + 1000 else 0
            ablaRuntimeAtomicCompareExchangeI64(block + 8, deadline, next)
        } else Sleep(1)
    }
    0
}

/** The system call intrinsic: on a Windows target the backend sends it to __ablaRuntimeWindowsSyscall. */
private trusted noescape extern:"intrinsic" fun ablaLinuxSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int

// The watchdog thread's entry. A function whose address nativeFunctionAddress takes is kept in every build of a program that
// loads this file, whether or not the code that takes it is (tests/cases/modules/windows-runtime.ab builds it for Linux), so
// the entry reaches the watchdog only through the translation (call 4003): a build for another target has no kernel32
// reference.
private trusted fun __ablaRuntimeWindowsWatchdogEntry(block: int): int = ablaLinuxSyscall(4003, block, 0, 0, 0, 0, 0)

// watch(request): request = {milliseconds until the stop (0: disarm), the check function (0: an interpreted site), the
// redirect target, another interrupt word to set at the stop (0: none)}, for the calling thread. Disarming clears the thread's
// interrupt words. Returns 0, or -errno.
private trusted fun __ablaRuntimeWindowsWatch(request: int): int {
    val block = __ablaRuntimeWindowsWatchBlock()
    val milliseconds = ablaRuntimeLoadI64(request)
    val cell = __ablaRuntimeWindowsInterruptCell()
    // Disarm (or re-arm): the deadline goes first, so a watchdog that wakes meanwhile finds nothing to stop.
    ablaRuntimeAtomicStoreI64(block + 8, 0)
    ablaRuntimeAtomicStoreI64(block, (ablaRuntimeLoadI64(block) + 1) & 4294967295)
    val previous = ablaRuntimeLoadI64(block + 16)
    if (previous != 0) {
        CloseHandle(previous)
        ablaRuntimeStoreI64(block + 16, 0)
    }
    val other = ablaRuntimeLoadI64(block + 40)
    if (other != 0) ablaRuntimeAtomicStoreI64(other, 0)
    ablaRuntimeAtomicStoreI64(cell, 0)
    if (milliseconds <= 0) {
        WakeByAddressAll(block)
        return 0
    }
    // THREAD_ALL_ACCESS: suspend and resume, the context, CancelSynchronousIo's THREAD_TERMINATE.
    val target = OpenThread(2097151, 0, GetCurrentThreadId())
    if (target == 0) return __ablaRuntimeWindowsErrno()
    ablaRuntimeStoreI64(block + 16, target)
    ablaRuntimeStoreI64(block + 24, ablaRuntimeLoadI64(request + 8))
    ablaRuntimeStoreI64(block + 32, ablaRuntimeLoadI64(request + 16))
    ablaRuntimeStoreI64(block + 40, ablaRuntimeLoadI64(request + 24))
    ablaRuntimeStoreI64(block + 48, cell)
    if (ablaRuntimeLoadI64(block + 56) == 0) {
        val watchdog = CreateThread(0, 0, nativeFunctionAddress(__ablaRuntimeWindowsWatchdogEntry), block, 0, 0)
        if (watchdog == 0) return __ablaRuntimeWindowsErrno()
        ablaRuntimeStoreI64(block + 56, watchdog)
    }
    ablaRuntimeAtomicStoreI64(block + 8, __ablaRuntimeWindowsMilliseconds(__ablaRuntimeWindowsScratch()) + milliseconds)
    ablaRuntimeAtomicStoreI64(block, (ablaRuntimeLoadI64(block) + 1) & 4294967295)
    WakeByAddressAll(block)
    0
}

// --- the compile-time guard's faults (docs/design/windows-jit.md §4) --------------------------------------------------------
// Linux catches a bad access in a compile-time call with a SIGSEGV handler that jumps back to the guard with 4. Call 4004 arms
// the same for the calling thread on Windows: a vectored exception handler, ahead of the crash report's, sends an access
// violation (0xC0000005) or a stack overflow (0xC00000FD) to the target, the slice's fault handler, as the signal would: with
// (11, info), the faulting address at info + 16 where siginfo's si_addr is. Only a fault in JIT'd code (no loaded image holds
// the program counter) or in the program's own image is taken: an exception a system DLL raises is often one it handles
// itself, and goes on to the next handler. The thread reserves 64 KiB for the handler first (SetThreadStackGuarantee), so it
// runs even on a stack that overflowed. A fault is taken once: the target jumps back, and the guard arms the next call again.

/** kernel32 AddVectoredExceptionHandler: adds handler to the vectored exception handlers (first: ahead of the others); returns a handle, or 0 when it fails. */
private trusted noescape extern:"c" fun AddVectoredExceptionHandler(first: int, handler: int): int
/** kernel32 SetThreadStackGuarantee: sets the calling thread's stack kept for its exception handlers to the size at size (the previous one is stored there); returns non-zero on success. */
private trusted noescape extern:"c" fun SetThreadStackGuarantee(size: int): int
/** kernel32 GetModuleHandleW: the base of a loaded module by name (0: the process's executable), or 0 when none is loaded. */
private trusted noescape extern:"c" fun GetModuleHandleW(name: int): int

// The calling thread's fault target (0: none armed) and its info block, and RtlPcToFileHeader's out parameter.
private trusted fun __ablaRuntimeWindowsFaultCell(): int =
    nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

// Whether the process's vectored handler is installed (0: not yet).
private trusted fun __ablaRuntimeWindowsFaultInstalled(): int = nativeStaticAllocate(8)

// The vectored handler's entry. As with the watchdog's (__ablaRuntimeWindowsWatchdogEntry), it reaches the handler only
// through the translation (call 4005), so a build for another target has no kernel32 reference.
private trusted fun __ablaRuntimeWindowsFaultEntry(pointers: int): int = ablaLinuxSyscall(4005, pointers, 0, 0, 0, 0, 0)

// The vectored handler: -1 (EXCEPTION_CONTINUE_EXECUTION) when it sent the thread to its target, 0 to let the next handler
// look. EXCEPTION_POINTERS {ExceptionRecord, ContextRecord}; the record's ExceptionCode at 0, ExceptionInformation[1] (the
// address a bad access touched) at 40.
private trusted fun __ablaRuntimeWindowsFault(pointers: int): int {
    val cell = __ablaRuntimeWindowsFaultCell()
    val target = ablaRuntimeLoadI64(cell)
    if (target == 0) return 0
    val record = ablaRuntimeLoadI64(pointers)
    val context = ablaRuntimeLoadI64(pointers + 8)
    val code = ablaRuntimeLoadI32(record) & 4294967295
    if (code != 3221225477 && code != 3221225725) return 0
    val image = RtlPcToFileHeader(abla_windows_context_pc(context), cell + 16)
    if (image != 0 && image != GetModuleHandleW(0)) return 0
    val info = ablaRuntimeLoadI64(cell + 8)
    ablaRuntimeStoreI64(info + 16, ablaRuntimeLoadI64(record + 40))
    ablaRuntimeStoreI64(cell, 0)
    abla_windows_redirect(context, target, 11, info)
    -1
}

// faults(request): request = {the target (0: disarm), its info block (24 bytes or more)}, for the calling thread. Returns 0,
// or -errno.
private trusted fun __ablaRuntimeWindowsFaults(request: int): int {
    val cell = __ablaRuntimeWindowsFaultCell()
    val target = ablaRuntimeLoadI64(request)
    ablaRuntimeStoreI64(cell, 0)
    if (target == 0) return 0
    val installed = __ablaRuntimeWindowsFaultInstalled()
    if (ablaRuntimeAtomicLoadI64(installed) == 0) {
        if (AddVectoredExceptionHandler(1, nativeFunctionAddress(__ablaRuntimeWindowsFaultEntry)) == 0) return __ablaRuntimeWindowsErrno()
        ablaRuntimeAtomicStoreI64(installed, 1)
    }
    // 64 KiB kept for the handler on an overflowed stack (a guarantee is never lowered: a larger one set before stays).
    val scratch = __ablaRuntimeWindowsScratch()
    ablaRuntimeStoreI64(scratch, 65536)
    SetThreadStackGuarantee(scratch)
    ablaRuntimeStoreI64(cell + 8, ablaRuntimeLoadI64(request + 8))
    ablaRuntimeStoreI64(cell, target)
    0
}

// The process calls: -1000 when `number` is none of them.
private trusted fun __ablaRuntimeWindowsProcessCall(number: int, a0: int, a1: int, a2: int, a3: int): int {
    // wait4(pid, status, options, usage)
    if (number == 61) return __ablaRuntimeWindowsWait(a0, a1, a2)
    // kill(pid, signal)
    if (number == 62) return __ablaRuntimeWindowsKill(a0, a1)
    // setpgid and getpgid: a process group is the process
    if (number == 109) {
        val member = __ablaRuntimeWindowsProcessEntry(a0)
        if (member != 0) ablaRuntimeStoreI64(member + 16, if (a1 == 0) a0 else a1)
        return 0
    }
    if (number == 121) return if (a0 == 0) GetCurrentProcessId() & 4294967295 else a0
    // pipe2(descriptors, flags)
    if (number == 293) return __ablaRuntimeWindowsPipe(a0)
    // fork and exec are not translated: the standard library launches with spawn (4001)
    if (number == 57 || number == 56 || number == 58 || number == 59) return -38
    // spawn(block)
    if (number == 4001) return __ablaRuntimeWindowsSpawn(a0)
    // watch(request): the compile-time watchdog for the calling thread
    if (number == 4002) return __ablaRuntimeWindowsWatch(a0)
    // the watchdog thread itself (its entry, __ablaRuntimeWindowsWatchdogEntry): does not return
    if (number == 4003) return __ablaRuntimeWindowsWatchdog(a0)
    // faults(request): the compile-time guard's fault target for the calling thread
    if (number == 4004) return __ablaRuntimeWindowsFaults(a0)
    // the vectored handler itself (its entry, __ablaRuntimeWindowsFaultEntry)
    if (number == 4005) return __ablaRuntimeWindowsFault(a0)
    -1000
}

/** The Linux system call number with six arguments, answered with kernel32: the result, or -errno; a number the translation does not handle ends the process with status 70 after naming it on standard error. */
trusted fun __ablaRuntimeWindowsSyscall(number: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int): int {
    // write(fd, buffer, count)
    if (number == 1) {
        val socket = __ablaRuntimeWindowsSocketOf(a0)
        if (socket != 0) {
            val sent = send(socket, a1, a2, 0)
            if (sent < 0) return __ablaRuntimeWindowsSocketErrno()
            return sent
        }
        val handle = __ablaRuntimeWindowsHandle(a0)
        if (handle == 0) return __ablaRuntimeWindowsEBADF
        val scratch = __ablaRuntimeWindowsScratch()
        ablaRuntimeStoreI64(scratch, 0)
        if (WriteFile(handle, a1, a2, scratch, 0) == 0) return __ablaRuntimeWindowsEIO
        return ablaRuntimeLoadI32(scratch) & 4294967295
    }
    // mmap(address, length, protection, flags, fd, offset): anonymous memory only; MAP_FIXED (16) over an existing range is not
    // translated (the frozen groups' window needs it: a later step)
    if (number == 9) {
        if (a4 != -1 || (a3 & 16) != 0) return -38
        val reserve = a2 == 0
        val address = VirtualAlloc(a0, a1, if (reserve) 8192 else 12288, __ablaRuntimeWindowsProtection(a2))
        if (address == 0) return __ablaRuntimeWindowsENOMEM
        return address
    }
    // mprotect(address, length, protection)
    if (number == 10) {
        val scratch = __ablaRuntimeWindowsScratch()
        if (VirtualProtect(a0, a1, __ablaRuntimeWindowsProtection(a2), scratch) == 0) return __ablaRuntimeWindowsEINVAL
        return 0
    }
    // munmap(address, length): a whole reservation (the runtime unmaps what it mapped, whole); a part of one is refused
    if (number == 11) {
        if (VirtualFree(a0, 0, 32768) == 0) return __ablaRuntimeWindowsEINVAL
        return 0
    }
    // mremap(base, before, after, flags)
    if (number == 25) return __ablaRuntimeWindowsRemap(a0, a1, a2)
    // madvise(address, length, advice): MADV_DONTNEED (4) gives the pages back; MADV_WIPEONFORK (18) has no fork to serve
    if (number == 28) {
        if (a2 == 4) {
            DiscardVirtualMemory(a0, a1)
            return 0
        }
        return __ablaRuntimeWindowsEINVAL
    }
    // nanosleep(request, remaining)
    if (number == 35) {
        val seconds = ablaRuntimeLoadI64(a0)
        val nanoseconds = ablaRuntimeLoadI64(a0 + 8)
        return __ablaRuntimeWindowsSleep(seconds * 1000 + (nanoseconds + 999999) / 1000000)
    }
    // getpid, gettid
    if (number == 39) return GetCurrentProcessId() & 4294967295
    if (number == 186) return GetCurrentThreadId() & 4294967295
    // sigaltstack(new, old): a Windows thread has no alternate signal stack to install; the old one is left as zeroes, "none"
    if (number == 131) return 0
    // getrlimit(resource, limits): the stack (RLIMIT_STACK, 3) is what the calling thread has reserved (GetCurrentThreadStackLimits:
    // the image's /stack, 8 MiB for a program, 128 MiB for the compiler), the descriptors (RLIMIT_NOFILE, 7) the table's size, both
    // soft and hard; any other resource is unlimited (all ones).
    if (number == 97) {
        var stack = 8388608
        if (a0 == 3) {
            val bounds = __ablaRuntimeWindowsScratch()
            GetCurrentThreadStackLimits(bounds, bounds + 8)
            val reserved = ablaRuntimeLoadI64(bounds + 8) - ablaRuntimeLoadI64(bounds)
            if (reserved > 0) stack = reserved
        }
        val limit = if (a0 == 3) stack else if (a0 == 7) __ablaRuntimeWindowsFdCount else -1
        ablaRuntimeStoreI64(a1, limit)
        ablaRuntimeStoreI64(a1 + 8, limit)
        return 0
    }
    // sched_getaffinity(process, size, mask): this process's (GetProcessAffinityMask, the CPUs of its group: up to 64) in the
    // mask's first 8 bytes, the rest zeroes; returns the 8 bytes written, as Linux returns its mask's size.
    if (number == 204) {
        if (a1 < 8) return __ablaRuntimeWindowsEINVAL
        var offset = 0
        while (offset + 8 <= a1) {
            ablaRuntimeStoreI64(a2 + offset, 0)
            offset = offset + 8
        }
        if (GetProcessAffinityMask(GetCurrentProcess(), a2, __ablaRuntimeWindowsScratch()) == 0) return __ablaRuntimeWindowsEINVAL
        return 8
    }
    // futex(address, operation, value, ...): WAIT sleeps while the 32-bit word still holds `value` (WaitOnAddress compares the same
    // way), WAKE wakes one waiter or all of them. A wait may return early (the callers look at the word again); no timeout is passed.
    if (number == 202) {
        val operation = a1 & 127
        if (operation == 1) {
            if (a2 == 1) WakeByAddressSingle(a0) else WakeByAddressAll(a0)
            return 0
        }
        if (operation == 0) {
            val scratch = __ablaRuntimeWindowsScratch()
            ablaRuntimeStoreI32(scratch, a2 & 4294967295)
            // In slices (WaitOnAddress is not alertable): an interrupted thread returns EINTR (§5), which callers treat as the
            // early return they already allow.
            while (WaitOnAddress(a0, scratch, 4, __ablaRuntimeWindowsWaitSlice) == 0 &&
                ablaRuntimeLoadI32(a0) == ablaRuntimeLoadI32(scratch)) {
                if (__ablaRuntimeWindowsInterrupted()) return -4
            }
            return 0
        }
        return __ablaRuntimeWindowsRefuse(number)
    }
    // clock_gettime(clock, timespec)
    if (number == 228) return __ablaRuntimeWindowsClock(a0, a1)
    // exit_group(status), exit(status)
    if (number == 231 || number == 60) {
        ExitProcess(a0)
        return 0
    }
    // the file calls: read, close, stat, lseek, fsync, getcwd, rename, mkdir, unlink, getdents64, openat, newfstatat, getrandom ... (the process's own
    // /proc entries do not exist: an openat of one is ENOENT, and the callers fall back)
    val process = __ablaRuntimeWindowsProcessCall(number, a0, a1, a2, a3)
    if (process != -1000) return process
    val network = __ablaRuntimeWindowsSocketCall(number, a0, a1, a2, a3, a4, a5)
    if (network != -1000) return network
    val file = __ablaRuntimeWindowsFileCall(number, a0, a1, a2, a3)
    if (file != -1000) return file
    __ablaRuntimeWindowsRefuse(number)
}

// The numbers __ablaRuntimeWindowsSyscall translates, for tools/test-windows-syscalls.sh.
/** The Linux system call numbers __ablaRuntimeWindowsSyscall translates, in order, separated by spaces (what tools/test-windows-syscalls.sh checks against the translation). */
trusted fun __ablaRuntimeWindowsTranslated(): string = "0 1 3 4 5 6 7 8 9 10 11 16 21 25 28 35 39 41 42 43 44 45 48 49 50 51 52 54 55 56 57 58 59 60 61 62 72 74 77 79 80 82 83 84 87 89 91 97 109 121 131 186 202 204 217 228 231 257 262 263 288 293 318 4001 4002 4003 4004 4005"

// argc and argv for main, from GetCommandLineW: the command line as UTF-8 and split by the rules of CommandLineToArgvW (a quoted
// program name; backslashes are literal except before a quote; 2n backslashes and a quote make n and open or close a quoted run;
// 2n+1 make n and a literal quote), in memory of its own (the runtime's heap is not up yet). Stores argc at `argcOut` and returns argv.
/** The process's arguments for main: stores argc at argcOut and returns the address of the argv array, both from GetCommandLineW; argc is 0 and the result 0 when the command line cannot be read. */
trusted fun __ablaRuntimeWindowsArguments(argcOut: int): int {
    val wide = GetCommandLineW()
    val size = WideCharToMultiByte(65001, 0, wide, -1, 0, 0, 0, 0)
    if (size <= 0) {
        ablaRuntimeStoreI32(argcOut, 0)
        return 0
    }
    // The environment block: UTF-16 "NAME=value" strings, each NUL-ended, and an empty one at the end (units: the characters through it).
    val environment = GetEnvironmentStringsW()
    var units = 0
    var entries = 0
    if (environment != 0) {
        var scanning = true
        while (scanning) {
            if (ablaRuntimeLoadU8(environment + units * 2) == 0 && ablaRuntimeLoadU8(environment + units * 2 + 1) == 0) {
                units = units + 1
                scanning = false
            } else {
                while (ablaRuntimeLoadU8(environment + units * 2) != 0 || ablaRuntimeLoadU8(environment + units * 2 + 1) != 0) units = units + 1
                units = units + 1
                entries = entries + 1
            }
        }
    }
    val environmentBytes = if (environment != 0) WideCharToMultiByte(65001, 0, environment, units, 0, 0, 0, 0) else 0
    // The text, then room for 1 + size / 2 argument pointers and the terminator, the same for the environment pointers, and its text.
    val slots = size / 2 + 2 + entries + 2
    val block = VirtualAlloc(0, size + slots * 8 + environmentBytes + 32, 12288, 4)
    if (block == 0) {
        ablaRuntimeStoreI32(argcOut, 0)
        return 0
    }
    val text = block
    val argv = block + ((size + 15) / 16) * 16
    WideCharToMultiByte(65001, 0, wide, -1, text, size, 0, 0)
    // The pieces are written back into `text` (an argument is never longer than its source).
    var read = 0
    var count = 0
    var written = 0
    val end = size - 1
    var first = true
    while (read < end) {
        while (read < end && (ablaRuntimeLoadU8(text + read) == 32 || ablaRuntimeLoadU8(text + read) == 9)) read = read + 1
        if (read >= end) break
        ablaRuntimeStoreI64(argv + count * 8, text + written)
        count = count + 1
        if (first) {
            // The program name: up to the closing quote when it opens with one, else up to white space; no escapes.
            first = false
            if (ablaRuntimeLoadU8(text + read) == 34) {
                read = read + 1
                while (read < end && ablaRuntimeLoadU8(text + read) != 34) {
                    ablaRuntimeStoreU8(text + written, ablaRuntimeLoadU8(text + read))
                    written = written + 1
                    read = read + 1
                }
                if (read < end) read = read + 1
            } else {
                while (read < end && ablaRuntimeLoadU8(text + read) != 32 && ablaRuntimeLoadU8(text + read) != 9) {
                    ablaRuntimeStoreU8(text + written, ablaRuntimeLoadU8(text + read))
                    written = written + 1
                    read = read + 1
                }
            }
        } else {
            var quoted = false
            var going = true
            while (going && read < end) {
                val byte = ablaRuntimeLoadU8(text + read)
                if (byte == 92) {
                    var slashes = 0
                    while (read < end && ablaRuntimeLoadU8(text + read) == 92) {
                        slashes = slashes + 1
                        read = read + 1
                    }
                    if (read < end && ablaRuntimeLoadU8(text + read) == 34) {
                        var literal = slashes / 2
                        while (literal > 0) {
                            ablaRuntimeStoreU8(text + written, 92)
                            written = written + 1
                            literal = literal - 1
                        }
                        if (slashes % 2 == 1) {
                            ablaRuntimeStoreU8(text + written, 34)
                            written = written + 1
                            read = read + 1
                        }
                    } else {
                        while (slashes > 0) {
                            ablaRuntimeStoreU8(text + written, 92)
                            written = written + 1
                            slashes = slashes - 1
                        }
                    }
                } else if (byte == 34) {
                    quoted = !quoted
                    read = read + 1
                } else if (!quoted && (byte == 32 || byte == 9)) {
                    going = false
                } else {
                    ablaRuntimeStoreU8(text + written, byte)
                    written = written + 1
                    read = read + 1
                }
            }
        }
        ablaRuntimeStoreU8(text + written, 0)
        written = written + 1
        if (read < end) read = read + 1
    }
    ablaRuntimeStoreI64(argv + count * 8, 0)
    // The environment follows argv as Linux lays it out (envp = argv + argc + 1 words), entries that begin with "=" (the per-drive
    // working directories) left out.
    val pointers = argv + (count + 1) * 8
    var variables = 0
    if (environment != 0) {
        val texts = argv + slots * 8
        WideCharToMultiByte(65001, 0, environment, units, texts, environmentBytes, 0, 0)
        var at = 0
        while (at < environmentBytes && ablaRuntimeLoadU8(texts + at) != 0) {
            if (ablaRuntimeLoadU8(texts + at) != 61) {
                ablaRuntimeStoreI64(pointers + variables * 8, texts + at)
                variables = variables + 1
            }
            while (ablaRuntimeLoadU8(texts + at) != 0) at = at + 1
            at = at + 1
        }
        FreeEnvironmentStringsW(environment)
    }
    ablaRuntimeStoreI64(pointers + variables * 8, 0)
    ablaRuntimeStoreI32(argcOut, count)
    argv
}
