// public: none
// Windows (W1c, docs/design/windows-target.md): the Linux system calls of the portable runtime and standard library, answered with
// kernel32, in a file of their own that only a Windows target loads (a Linux, macOS or Wasm build never parses it), as
// platform/darwin does for the BSD calls. `__ablaRuntimeWindowsSyscall` is what the backend calls for `ablaLinuxSyscall` on this
// target (src/backend/llvm/backend.ab names it); a number it does not translate is refused loudly (a named diagnostic and exit
// status 70), never answered with a quiet success, and tools/test-windows-syscalls.sh lists the translated numbers. The process's
// arguments come from GetCommandLineW (`__ablaRuntimeWindowsArguments`, called by the PE entry in src/backend/llvm/windows.ab).
//
// The imports are kernel32's, listed in runtime/windows/imports/kernel32.txt (tools/windows-imports-allowlist.txt checks them);
// every extern here takes and returns integers and pointers, never a struct (Win64 passes aggregates by hidden pointer, the Abla
// value ABI has no business crossing this boundary).
import "abla/unsafe/memory"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"


/** kernel32 ExitProcess: ends the process with the given status; does not return. */
trusted noescape extern:"c" fun ExitProcess(code: int): void
/** kernel32 GetStdHandle: the handle of standard input (-10), output (-11) or error (-12), or 0 or -1 when there is none. */
trusted noescape extern:"c" fun GetStdHandle(which: int): int
/** kernel32 WriteFile: writes count bytes at buffer to handle, storing the count written at written; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun WriteFile(handle: int, buffer: int, count: int, written: int, overlapped: int): int
/** kernel32 VirtualAlloc: reserves or commits size bytes (allocation type kind, page protection protect) at address or anywhere; returns the base address, or 0 when it fails. */
trusted noescape extern:"c" fun VirtualAlloc(address: int, size: int, kind: int, protect: int): int
/** kernel32 VirtualFree: decommits or releases pages (kind); returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun VirtualFree(address: int, size: int, kind: int): int
/** kernel32 VirtualProtect: changes the protection of size bytes at address, storing the old one at old; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun VirtualProtect(address: int, size: int, protect: int, old: int): int
/** kernel32 DiscardVirtualMemory: gives the contents of whole pages back to the system; returns 0 on success, an error code otherwise. */
trusted noescape extern:"c" fun DiscardVirtualMemory(address: int, size: int): int
/** kernel32 GetCommandLineW: the address of the process's UTF-16 command line; never fails. */
trusted noescape extern:"c" fun GetCommandLineW(): int
/** kernel32 WideCharToMultiByte: converts UTF-16 text to a code page (65001 is UTF-8); returns the bytes written or needed, 0 when it fails. */
trusted noescape extern:"c" fun WideCharToMultiByte(page: int, flags: int, wide: int, wideCount: int, narrow: int, narrowCount: int, defaultCharacter: int, usedDefault: int): int
/** kernel32 QueryPerformanceCounter: stores the performance counter at value; returns non-zero on success. */
trusted noescape extern:"c" fun QueryPerformanceCounter(value: int): int
/** kernel32 QueryPerformanceFrequency: stores the performance counter's ticks per second at value; returns non-zero on success. */
trusted noescape extern:"c" fun QueryPerformanceFrequency(value: int): int
/** kernel32 GetSystemTimePreciseAsFileTime: stores the system time in 100 ns intervals since 1601 at value; never fails. */
trusted noescape extern:"c" fun GetSystemTimePreciseAsFileTime(value: int): void
/** kernel32 Sleep: suspends the calling thread for at least milliseconds. */
trusted noescape extern:"c" fun Sleep(milliseconds: int): void
/** kernel32 GetCurrentProcessId: the calling process's id; never fails. */
trusted noescape extern:"c" fun GetCurrentProcessId(): int
/** kernel32 GetEnvironmentStringsW: the address of the process's environment block (UTF-16 NAME=value strings, each NUL-ended, an empty one at the end), to be released with FreeEnvironmentStringsW; 0 when it cannot be read. */
trusted noescape extern:"c" fun GetEnvironmentStringsW(): int
/** kernel32 FreeEnvironmentStringsW: releases a block GetEnvironmentStringsW returned; returns non-zero on success. */
trusted noescape extern:"c" fun FreeEnvironmentStringsW(block: int): int
/** kernel32 GetCurrentThreadId: the calling thread's id; never fails. */
trusted noescape extern:"c" fun GetCurrentThreadId(): int
/** synchronization WaitOnAddress: sleeps while the size-byte word at address still equals the one at compare (a futex wait), until woken or for milliseconds; returns non-zero when it returns for another reason than a timeout. */
trusted noescape extern:"c" fun WaitOnAddress(address: int, compare: int, size: int, milliseconds: int): int
/** synchronization WakeByAddressSingle: wakes one thread waiting on the word at address. */
trusted noescape extern:"c" fun WakeByAddressSingle(address: int): void
/** synchronization WakeByAddressAll: wakes every thread waiting on the word at address. */
trusted noescape extern:"c" fun WakeByAddressAll(address: int): void
/** kernel32 CreateFileW: opens or creates the file or directory at the UTF-16 path with the given access, sharing, disposition and flags; returns a handle, or -1 when it fails. */
trusted noescape extern:"c" fun CreateFileW(path: int, access: int, share: int, security: int, disposition: int, flags: int, template: int): int
/** kernel32 ReadFile: reads up to count bytes from handle into buffer, storing the count read at read; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun ReadFile(handle: int, buffer: int, count: int, read: int, overlapped: int): int
/** kernel32 CloseHandle: closes a handle; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun CloseHandle(handle: int): int
/** kernel32 SetFilePointerEx: moves the file pointer by distance from the start (0), current position (1) or end (2), storing the new position at position; returns non-zero on success. */
trusted noescape extern:"c" fun SetFilePointerEx(handle: int, distance: int, position: int, method: int): int
/** kernel32 GetFileInformationByHandle: fills the 52-byte BY_HANDLE_FILE_INFORMATION at info for an open file or directory; returns non-zero on success. */
trusted noescape extern:"c" fun GetFileInformationByHandle(handle: int, info: int): int
/** kernel32 CreateDirectoryW: creates the directory at the UTF-16 path; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun CreateDirectoryW(path: int, security: int): int
/** kernel32 RemoveDirectoryW: removes the empty directory at the UTF-16 path; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun RemoveDirectoryW(path: int): int
/** kernel32 DeleteFileW: deletes the file at the UTF-16 path; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun DeleteFileW(path: int): int
/** kernel32 MoveFileExW: renames a file or directory, replacing the destination when flags has 1; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun MoveFileExW(from: int, to: int, flags: int): int
/** kernel32 GetCurrentDirectoryW: stores the current directory as UTF-16 at buffer (size in characters); returns its length, or 0 on failure. */
trusted noescape extern:"c" fun GetCurrentDirectoryW(size: int, buffer: int): int
/** kernel32 SetCurrentDirectoryW: makes the UTF-16 path the current directory; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun SetCurrentDirectoryW(path: int): int
/** kernel32 FlushFileBuffers: writes a file's buffered data to disk; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun FlushFileBuffers(handle: int): int
/** kernel32 SetEndOfFile: ends the file at the current file pointer; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun SetEndOfFile(handle: int): int
/** kernel32 GetLastError: the calling thread's last error code. */
trusted noescape extern:"c" fun GetLastError(): int
/** kernel32 MultiByteToWideChar: converts text of a code page (65001 is UTF-8) to UTF-16; returns the characters written or needed, 0 when it fails. */
trusted noescape extern:"c" fun MultiByteToWideChar(page: int, flags: int, text: int, count: int, wide: int, wideCount: int): int
/** kernel32 FindFirstFileW: starts listing the directory entries that match the UTF-16 pattern, storing the first at data (a 592-byte WIN32_FIND_DATAW); returns a search handle, or -1 when it fails. */
trusted noescape extern:"c" fun FindFirstFileW(pattern: int, data: int): int
/** kernel32 FindNextFileW: stores the next directory entry of a search at data; returns non-zero on success, 0 at the end. */
trusted noescape extern:"c" fun FindNextFileW(search: int, data: int): int
/** kernel32 FindClose: ends a directory search; returns non-zero on success. */
trusted noescape extern:"c" fun FindClose(search: int): int
/** kernel32 GetFileAttributesW: the attributes of the file at the UTF-16 path, or 0xFFFFFFFF when it does not exist. */
trusted noescape extern:"c" fun GetFileAttributesW(path: int): int
/** bcryptprimitives ProcessPrng: fills size bytes at buffer with cryptographically secure random bytes; returns non-zero (it cannot fail on Windows 10 and later). */
trusted noescape extern:"c" fun ProcessPrng(buffer: int, size: int): int
/** ws2_32 WSAStartup: initialises Winsock for version (0x0202 is 2.2), filling the 408-byte WSADATA at data; returns 0 on success. */
trusted noescape extern:"c" fun WSAStartup(version: int, data: int): int
/** ws2_32 WSAGetLastError: the calling thread's last Winsock error code. */
trusted noescape extern:"c" fun WSAGetLastError(): int
/** ws2_32 socket: creates a socket of the address family, type and protocol; returns it, or -1 (INVALID_SOCKET) when it fails. */
trusted noescape extern:"c" fun socket(family: int, kind: int, protocol: int): int
/** ws2_32 closesocket: closes a socket; returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun closesocket(socket: int): int
/** ws2_32 connect: connects a socket to the address (a sockaddr of length bytes); returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun connect(socket: int, address: int, length: int): int
/** ws2_32 bind: binds a socket to the address (a sockaddr of length bytes); returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun bind(socket: int, address: int, length: int): int
/** ws2_32 listen: puts a socket in the listening state with the backlog; returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun listen(socket: int, backlog: int): int
/** ws2_32 accept: takes a pending connection of a listening socket, storing the peer's address and its length; returns the new socket, or -1 when it fails. */
trusted noescape extern:"c" fun accept(socket: int, address: int, length: int): int
/** ws2_32 send: sends count bytes at buffer; returns the bytes sent, or -1 on failure. */
trusted noescape extern:"c" fun send(socket: int, buffer: int, count: int, flags: int): int
/** ws2_32 recv: receives up to count bytes into buffer; returns the bytes received, 0 when the peer closed, or -1 on failure. */
trusted noescape extern:"c" fun recv(socket: int, buffer: int, count: int, flags: int): int
/** ws2_32 sendto: sends count bytes at buffer to the address; returns the bytes sent, or -1 on failure. */
trusted noescape extern:"c" fun sendto(socket: int, buffer: int, count: int, flags: int, address: int, length: int): int
/** ws2_32 recvfrom: receives up to count bytes into buffer, storing the sender's address and its length; returns the bytes received, or -1 on failure. */
trusted noescape extern:"c" fun recvfrom(socket: int, buffer: int, count: int, flags: int, address: int, length: int): int
/** ws2_32 shutdown: disables sending (1), receiving (0) or both (2) on a socket; returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun shutdown(socket: int, how: int): int
/** ws2_32 setsockopt: sets a socket option (level and option as Windows numbers them) from length bytes at value; returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun setsockopt(socket: int, level: int, option: int, value: int, length: int): int
/** ws2_32 getsockopt: reads a socket option into value, its length at length; returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun getsockopt(socket: int, level: int, option: int, value: int, length: int): int
/** ws2_32 getsockname: stores the local address of a socket and its length; returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun getsockname(socket: int, address: int, length: int): int
/** ws2_32 getpeername: stores the peer address of a connected socket and its length; returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun getpeername(socket: int, address: int, length: int): int
/** ws2_32 ioctlsocket: runs a control command on a socket (FIONBIO sets non-blocking mode from the word at argument, FIONREAD stores the bytes pending); returns 0 on success, -1 on failure. */
trusted noescape extern:"c" fun ioctlsocket(socket: int, command: int, argument: int): int
/** ws2_32 WSAPoll: waits up to milliseconds (-1: for ever) for events on count WSAPOLLFD entries (16 bytes: socket, events, revents); returns the number of ready entries, 0 on timeout, -1 on failure. */
trusted noescape extern:"c" fun WSAPoll(entries: int, count: int, milliseconds: int): int



// A thread's own 64 bytes for out-parameters (a written count, a clock reading): the loader gives each thread a copy of the
// thread-local template, so no two calls share them.
private trusted fun __ablaRuntimeWindowsScratch(): int =
    nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

// The errno a Linux caller expects.
private val __ablaRuntimeWindowsENOMEM = -12
private val __ablaRuntimeWindowsEINVAL = -22
private val __ablaRuntimeWindowsEBADF = -9
private val __ablaRuntimeWindowsEIO = -5
private val __ablaRuntimeWindowsENOENT = -2

// Writes `text` (a NUL-ended message at `address`) to standard error and ends the process with status 70.
private trusted fun __ablaRuntimeWindowsRefuse(number: int): int {
    val scratch = __ablaRuntimeWindowsScratch()
    // "abla: Windows runtime: unsupported Linux system call NNN\n", the number in decimal
    val prefix = __ablaRuntimeWord0("abla: Windows runtime: unsupported Linux system call ")
    var length = 0
    while (ablaRuntimeLoadU8(prefix + length) != 0) length = length + 1
    val handle = GetStdHandle(-12)
    WriteFile(handle, prefix, length, scratch, 0)
    var digits = scratch + 16
    var count = 0
    var value = if (number < 0) 0 else number
    var scale = 1
    while (value / scale >= 10) scale = scale * 10
    while (scale > 0) {
        ablaRuntimeStoreU8(digits + count, 48 + value / scale % 10)
        count = count + 1
        scale = scale / 10
    }
    ablaRuntimeStoreU8(digits + count, 10)
    WriteFile(handle, digits, count + 1, scratch, 0)
    ExitProcess(70)
    -38
}

// Protection bits of mmap/mprotect (PROT_READ 1, PROT_WRITE 2, PROT_EXEC 4) as a page protection constant.
private trusted fun __ablaRuntimeWindowsProtection(protection: int): int {
    val write = (protection & 2) != 0
    val execute = (protection & 4) != 0
    if (protection == 0) return 1
    if (execute) return if (write) 64 else 32
    if (write) 4 else 2
}

// The monotonic or real-time clock in a Linux timespec at `output` (clockid 1: QueryPerformanceCounter; 0 and others: the system
// time since 1970).
private trusted fun __ablaRuntimeWindowsClock(clock: int, output: int): int {
    val scratch = __ablaRuntimeWindowsScratch()
    if (clock == 1 || clock == 7) {
        QueryPerformanceFrequency(scratch)
        QueryPerformanceCounter(scratch + 8)
        val frequency = ablaRuntimeLoadI64(scratch)
        val ticks = ablaRuntimeLoadI64(scratch + 8)
        val seconds = ticks / frequency
        val rest = ticks % frequency
        ablaRuntimeStoreI64(output, seconds)
        ablaRuntimeStoreI64(output + 8, rest * 1000000000 / frequency)
        return 0
    }
    GetSystemTimePreciseAsFileTime(scratch)
    // 100 ns intervals since 1601: 11644473600 seconds before the Unix epoch.
    val intervals = ablaRuntimeLoadI64(scratch)
    val seconds = intervals / 10000000 - 11644473600
    ablaRuntimeStoreI64(output, seconds)
    ablaRuntimeStoreI64(output + 8, intervals % 10000000 * 100)
    0
}

// mremap: Windows cannot resize a reservation, so a new one is made and the old bytes copied (what the runtime does by itself on
// macOS), the old one released.
private trusted fun __ablaRuntimeWindowsRemap(base: int, before: int, after: int): int {
    val moved = VirtualAlloc(0, after, 12288, 4)
    if (moved == 0) return __ablaRuntimeWindowsENOMEM
    ablaUnsafeCopyMemory(moved, base, if (before < after) before else after)
    VirtualFree(base, 0, 32768)
    moved
}

// The Linux system call `number` with six arguments, answered with kernel32: the result, or -errno.
// ---- files: descriptors over handles, paths over UTF-16 ----
// A Linux descriptor is an index into a table of 64-byte entries (word 0 the handle, 0 when free; word 1 the kind, 1 a file or
// device, 2 a directory; for a directory word 2 the page holding its search pattern and find data, word 3 the search handle (0
// before the first entry), word 4 non-zero when the find data waits to be returned); 0, 1 and 2 are the standard handles. Paths are
// converted to UTF-16 in a buffer of 128 KiB of the thread's own (64 KiB for each of two paths); "/" in a path is kept (kernel32
// takes it), so the standard library's POSIX path syntax works unchanged.

private val __ablaRuntimeWindowsFdCount = 4096

private trusted fun __ablaRuntimeWindowsFdCell(): int = nativeStaticAllocate(8)

// The descriptor table, made on first use (a race is settled by compare-and-exchange; the loser's memory is released).
private trusted fun __ablaRuntimeWindowsFds(): int {
    val cell = __ablaRuntimeWindowsFdCell()
    val have = ablaRuntimeAtomicLoadI64(cell)
    if (have != 0) return have
    val made = VirtualAlloc(0, __ablaRuntimeWindowsFdCount * 64, 12288, 4)
    if (made == 0) return 0
    val seen = ablaRuntimeAtomicCompareExchangeI64(cell, 0, made)
    if (seen != 0) {
        VirtualFree(made, 0, 32768)
        return seen
    }
    made
}

// The handle of descriptor `fd`, or 0 when it is not open.
private trusted fun __ablaRuntimeWindowsHandle(fd: int): int {
    if (fd == 0) return GetStdHandle(-10)
    if (fd == 1) return GetStdHandle(-11)
    if (fd == 2) return GetStdHandle(-12)
    if (fd < 3 || fd >= __ablaRuntimeWindowsFdCount) return 0
    val table = __ablaRuntimeWindowsFds()
    if (table == 0) return 0
    ablaRuntimeAtomicLoadI64(table + fd * 64)
}

// A free descriptor for `handle` of `kind` (word 2 for a directory), or -24 (EMFILE).
private trusted fun __ablaRuntimeWindowsOpenFd(handle: int, kind: int, extra: int): int {
    val table = __ablaRuntimeWindowsFds()
    if (table == 0) return -24
    var fd = 3
    while (fd < __ablaRuntimeWindowsFdCount) {
        val entry = table + fd * 64
        if (ablaRuntimeAtomicLoadI64(entry) == 0 && ablaRuntimeAtomicCompareExchangeI64(entry, 0, handle) == 0) {
            ablaRuntimeStoreI64(entry + 8, kind)
            ablaRuntimeStoreI64(entry + 16, extra)
            ablaRuntimeStoreI64(entry + 24, 0)
            ablaRuntimeStoreI64(entry + 32, 0)
            return fd
        }
        fd = fd + 1
    }
    -24
}

// The errno of the last kernel32 failure.
private trusted fun __ablaRuntimeWindowsErrno(): int {
    val code = GetLastError() & 4294967295
    if (code == 2 || code == 3 || code == 15) return -2
    if (code == 5 || code == 19) return -13
    if (code == 80 || code == 183) return -17
    if (code == 32 || code == 33 || code == 170) return -16
    if (code == 145) return -39
    if (code == 267) return -20
    if (code == 87 || code == 123 || code == 161) return -22
    if (code == 6) return -9
    if (code == 8 || code == 14) return -12
    -5
}

// The thread's own 128 KiB for UTF-16 paths (made on its first use; the 8 bytes of its thread-local record hold it).
private trusted fun __ablaRuntimeWindowsPathBuffer(): int {
    val cell = __ablaRuntimeWindowsScratch() + 48
    var buffer = ablaRuntimeLoadI64(cell)
    if (buffer == 0) {
        buffer = VirtualAlloc(0, 131072, 12288, 4)
        ablaRuntimeStoreI64(cell, buffer)
    }
    buffer
}

// The UTF-8 path at `text` as UTF-16 in the thread's buffer (`slot` 0 or 1), or 0 when it is too long or not valid.
private trusted fun __ablaRuntimeWindowsWidePath(text: int, slot: int): int {
    val buffer = __ablaRuntimeWindowsPathBuffer()
    if (buffer == 0) return 0
    val wide = buffer + slot * 65536
    if (MultiByteToWideChar(65001, 0, text, -1, wide, 32767) <= 0) return 0
    wide
}

// FILETIME (100 ns since 1601) at `at` as seconds and nanoseconds since 1970 stored at `seconds` and `seconds + 8`.
private trusted fun __ablaRuntimeWindowsStoreTime(at: int, seconds: int): void {
    val intervals = ablaRuntimeLoadI64(at)
    ablaRuntimeStoreI64(seconds, intervals / 10000000 - 11644473600)
    ablaRuntimeStoreI64(seconds + 8, intervals % 10000000 * 100)
    return
}

// A Linux `struct stat` (144 bytes, x86-64) at `output` from the BY_HANDLE_FILE_INFORMATION at `info`: the mode is directory (the
// attribute 0x10), link (a reparse point, when `link`) or regular file with the permission bits Windows does not have made up as
// 755/644 (444 when read-only).
private trusted fun __ablaRuntimeWindowsFillStat(info: int, output: int, link: bool): void {
    var offset = 0
    while (offset < 144) {
        ablaRuntimeStoreI64(output + offset, 0)
        offset = offset + 8
    }
    val attributes = ablaRuntimeLoadI32(info) & 4294967295
    var mode = 33188
    if ((attributes & 1) != 0) mode = 33060
    if ((attributes & 16) != 0) mode = 16877
    if (link && (attributes & 1024) != 0) mode = 41471
    val size = (ablaRuntimeLoadI32(info + 32) & 4294967295) * 4294967296 + (ablaRuntimeLoadI32(info + 36) & 4294967295)
    val links = ablaRuntimeLoadI32(info + 40) & 4294967295
    val index = (ablaRuntimeLoadI32(info + 44) & 4294967295) * 4294967296 + (ablaRuntimeLoadI32(info + 48) & 4294967295)
    ablaRuntimeStoreI64(output + 8, index)
    ablaRuntimeStoreI64(output + 16, links)
    ablaRuntimeStoreI32(output + 24, mode)
    ablaRuntimeStoreI64(output + 48, size)
    ablaRuntimeStoreI64(output + 56, 4096)
    ablaRuntimeStoreI64(output + 64, (size + 511) / 512)
    __ablaRuntimeWindowsStoreTime(info + 12, output + 72)
    __ablaRuntimeWindowsStoreTime(info + 20, output + 88)
    __ablaRuntimeWindowsStoreTime(info + 20, output + 104)
    return
}

// The stat of the file or directory at the UTF-16 path (without following a link when `link`), or -errno.
private trusted fun __ablaRuntimeWindowsStatPath(wide: int, output: int, link: bool): int {
    val scratch = __ablaRuntimeWindowsScratch()
    // backup semantics (0x02000000) so that a directory opens, reparse point (0x00200000) so that a link is itself
    val handle = CreateFileW(wide, 0, 7, 0, 3, if (link) 35651584 else 33554432, 0)
    if (handle == -1) return __ablaRuntimeWindowsErrno()
    // The information is 52 bytes: after the 16 the scratch keeps for others.
    val info = __ablaRuntimeWindowsPathBuffer() + 131072 - 64
    val ok = GetFileInformationByHandle(handle, info) != 0
    val error = if (ok) 0 else __ablaRuntimeWindowsErrno()
    CloseHandle(handle)
    if (!ok) return error
    __ablaRuntimeWindowsFillStat(info, output, link)
    0
}

// open(path, flags, mode) as CreateFileW: the access, disposition and attributes from the Linux flags (O_WRONLY 1, O_RDWR 2, O_CREAT
// 0x40, O_EXCL 0x80, O_TRUNC 0x200, O_APPEND 0x400, O_DIRECTORY 0x10000, O_NOFOLLOW 0x20000); a directory gets a descriptor that
// getdents64 lists. A descriptor, or -errno.
private trusted fun __ablaRuntimeWindowsOpen(text: int, flags: int): int {
    val wide = __ablaRuntimeWindowsWidePath(text, 0)
    if (wide == 0) return -2
    val mode = flags & 3
    var access = 0
    if (mode == 0) access = 2147483648
    else if (mode == 1) access = 1073741824
    else access = 3221225472
    if ((flags & 1024) != 0) access = (access & 2147483648) + 4
    val create = (flags & 64) != 0
    val exclusive = (flags & 128) != 0
    val truncate = (flags & 512) != 0
    var disposition = 3
    if (create && exclusive) disposition = 1
    else if (create && truncate) disposition = 2
    else if (create) disposition = 4
    else if (truncate) disposition = 5
    // 0x02000000 backup semantics (a directory may be opened), 0x00200000 reparse point for O_NOFOLLOW
    var attributes = 33554432
    if ((flags & 131072) != 0) attributes = attributes + 2097152
    val handle = CreateFileW(wide, access, 7, 0, disposition, attributes, 0)
    if (handle == -1) return __ablaRuntimeWindowsErrno()
    val info = __ablaRuntimeWindowsPathBuffer() + 131072 - 64
    var kind = 1
    if (GetFileInformationByHandle(handle, info) != 0 && (ablaRuntimeLoadI32(info) & 16) != 0) kind = 2
    if ((flags & 65536) != 0 && kind != 2) {
        CloseHandle(handle)
        return -20
    }
    var extra = 0
    if (kind == 2) {
        // a page for the pattern (the path and "\*") and the find data
        extra = VirtualAlloc(0, 4096, 12288, 4)
        if (extra == 0) {
            CloseHandle(handle)
            return -12
        }
        var length = 0
        while (ablaRuntimeLoadU8(wide + length) != 0 || ablaRuntimeLoadU8(wide + length + 1) != 0) length = length + 2
        var copy = 0
        while (copy < length) {
            ablaRuntimeStoreU8(extra + copy, ablaRuntimeLoadU8(wide + copy))
            copy = copy + 1
        }
        if (length > 0 && ablaRuntimeLoadU8(extra + length - 2) != 92 && ablaRuntimeLoadU8(extra + length - 2) != 47) {
            ablaRuntimeStoreU8(extra + length, 92)
            ablaRuntimeStoreU8(extra + length + 1, 0)
            length = length + 2
        }
        ablaRuntimeStoreU8(extra + length, 42)
        ablaRuntimeStoreU8(extra + length + 1, 0)
        ablaRuntimeStoreU8(extra + length + 2, 0)
        ablaRuntimeStoreU8(extra + length + 3, 0)
    }
    val fd = __ablaRuntimeWindowsOpenFd(handle, kind, extra)
