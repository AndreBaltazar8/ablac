    val store = ablaUnsafeCallAddressPointerPointer(open, nativePointerFromAddress(0), nativePointerFromAddress(scratch))
    if (store == 0) return -2
    var used = 0
    var context = ablaUnsafeCallAddressPointerPointer(enumerate, nativePointerFromAddress(store), nativePointerFromAddress(0))
    while (context != 0) {
