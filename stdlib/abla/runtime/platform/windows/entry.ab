// ---- sockets: Winsock behind the same descriptors ----
// A socket is a descriptor of kind 3 whose handle word is the SOCKET; read, write and close on it are recv, send and closesocket.
// Numbers that differ between Linux and Windows are translated both ways: the address family (AF_INET6 is 10 and 23), socket levels
// and options, flags, poll events and errors (WSAEWOULDBLOCK is EAGAIN, and EINPROGRESS for a connect). Winsock is started on the first
// socket. A poll covers sockets; any other descriptor (a file, standard input) is reported ready.

private trusted fun __ablaRuntimeWindowsWinsockCell(): int = nativeStaticAllocate(8)

// Starts Winsock once; true when it is up.
private trusted fun __ablaRuntimeWindowsWinsock(): bool {
    val cell = __ablaRuntimeWindowsWinsockCell()
    if (ablaRuntimeAtomicLoadI64(cell) == 2) return true
    if (ablaRuntimeAtomicCompareExchangeI64(cell, 0, 1) == 0) {
        val data = VirtualAlloc(0, 4096, 12288, 4)
        val started = data != 0 && WSAStartup(514, data) == 0
        if (data != 0) VirtualFree(data, 0, 32768)
        ablaRuntimeAtomicStoreI64(cell, if (started) 2 else 3)
        return started
    }
    while (ablaRuntimeAtomicLoadI64(cell) == 1) Sleep(1)
    ablaRuntimeAtomicLoadI64(cell) == 2
}

// The errno of the last Winsock failure.
private trusted fun __ablaRuntimeWindowsSocketErrno(): int {
    val code = WSAGetLastError() & 4294967295
    if (code == 10035) return -11
    if (code == 10036 || code == 10037) return -115
    if (code == 10004) return -4
    if (code == 10009) return -9
    if (code == 10013) return -13
    if (code == 10014) return -14
    if (code == 10022) return -22
    if (code == 10024) return -24
    if (code == 10038) return -88
    if (code == 10040) return -90
    if (code == 10043) return -93
    if (code == 10047) return -97
    if (code == 10048) return -98
    if (code == 10049) return -99
    if (code == 10050 || code == 10051) return -101
    if (code == 10053) return -103
    if (code == 10054) return -104
    if (code == 10055) return -105
    if (code == 10056) return -106
    if (code == 10057) return -107
    if (code == 10058) return -108
    if (code == 10060) return -110
    if (code == 10061) return -111
    if (code == 10064 || code == 10065) return -113
    -5
}

// The SOCKET of descriptor `fd`, or 0 when it is not an open socket.
private trusted fun __ablaRuntimeWindowsSocketOf(fd: int): int {
    if (fd < 3 || fd >= __ablaRuntimeWindowsFdCount) return 0
    val table = __ablaRuntimeWindowsFds()
    if (table == 0) return 0
    val entry = table + fd * 64
    if (ablaRuntimeLoadI64(entry + 8) != 3) return 0
    ablaRuntimeAtomicLoadI64(entry)
}

// The address family of the sockaddr at `address` between Linux's and Windows's numbering (in place; the layouts match).
private trusted fun __ablaRuntimeWindowsFamily(address: int, toWindows: bool): void {
    if (address == 0) return
    val family = ablaRuntimeLoadU8(address) + ablaRuntimeLoadU8(address + 1) * 256
    if (toWindows && family == 10) ablaRuntimeStoreU8(address, 23)
    if (!toWindows && family == 23) ablaRuntimeStoreU8(address, 10)
    return
}

// SOL_SOCKET and its options, from Linux's numbers to Windows's: -1 for one with no counterpart.
private trusted fun __ablaRuntimeWindowsSocketOption(level: int, option: int): int {
    if (level != 1) return option
    if (option == 2) return 4
    if (option == 3) return 4104
    if (option == 4) return 4103
    if (option == 6) return 32
    if (option == 7) return 4097
    if (option == 8) return 4098
    if (option == 9) return 8
    if (option == 13) return 128
    if (option == 20) return 4102
    if (option == 21) return 4101
    -1
}

private trusted fun __ablaRuntimeWindowsSocketLevel(level: int): int = if (level == 1) 65535 else level

