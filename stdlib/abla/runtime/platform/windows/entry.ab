trusted noescape extern:"c" fun ioctlsocket(socket: int, command: int, argument: int): int
/** ws2_32 WSAPoll: waits up to milliseconds (-1: for ever) for events on count WSAPOLLFD entries (16 bytes: socket, events, revents); returns the number of ready entries, 0 on timeout, -1 on failure. */
trusted noescape extern:"c" fun WSAPoll(entries: int, count: int, milliseconds: int): int
/** kernel32 CreateProcessW: starts a process from the UTF-16 command line with an environment block, working directory, STARTUPINFOW and PROCESS_INFORMATION, inheriting handles when inherit is non-zero; returns non-zero on success, 0 on failure. */
trusted noescape extern:"c" fun CreateProcessW(application: int, commandLine: int, processSecurity: int, threadSecurity: int, inherit: int, flags: int, environment: int, directory: int, startup: int, information: int): int
