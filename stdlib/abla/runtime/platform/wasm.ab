trusted fun __ablaRuntimePlatformRegionActive(): bool =
    __ablaRuntimeWasmRegion != 0

// Return an equivalent allocation owned by the parent region (or the tracked
// heap when the parent is the root).
trusted fun __ablaRuntimePlatformPromoteAllocation(address: int): int {
    if (__ablaRuntimeWasmRegion == 0) return address
    val size = ablaRuntimeLoadI64(address - 16)
    val child = __ablaRuntimeWasmRegion
    __ablaRuntimeWasmRegion = ablaRuntimeLoadI64(child)
    val promoted = __ablaRuntimePlatformAllocate(size)
    __ablaRuntimeWasmRegion = child
    var index: int = 0
    while (index < size) {
        ablaRuntimeStoreU8(
            promoted + index, ablaRuntimeLoadU8(address + index)
        )
        index = index + 1
    }
    __ablaRuntimePlatformFree(address)
    promoted
}

trusted fun __ablaRuntimePlatformPanic(data: int, length: int): int {
    ablaRuntimeTrap()
    0
}
