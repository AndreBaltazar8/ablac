}

trusted fun __ablaRuntimePlatformRegionEnd(regionAddress: int): void {
    if (regionAddress == 0 ||
        regionAddress != __ablaRuntimeWasmRegion) ablaRuntimeTrap()
    val parent = ablaRuntimeLoadI64(regionAddress)
    val pages = ablaRuntimeLoadI64(regionAddress + 8)
    val live = ablaRuntimeLoadI64(regionAddress + 16)
    if (live < 0 || live > __ablaRuntimeWasmLiveBytes) ablaRuntimeTrap()
    __ablaRuntimeWasmLiveBytes = __ablaRuntimeWasmLiveBytes - live
    __ablaRuntimeWasmRegionPagesRelease(pages)
    __ablaRuntimeWasmRegion = parent
    if (__ablaRuntimeWasmRegionCacheCount <
        __ablaRuntimeWasmRegionCachedDescriptors) {
        ablaRuntimeStoreI64(regionAddress, __ablaRuntimeWasmRegionCache)
        __ablaRuntimeWasmRegionCache = regionAddress
        __ablaRuntimeWasmRegionCacheCount =
            __ablaRuntimeWasmRegionCacheCount + 1
