// Allocator numbers for diagnostics: 0 linear memory bytes, 1 bytes the bump
// cursor has handed out, 2 bytes parked on the small free lists, 3 bytes parked
// on the large free list (both with headers), 4 tracked live bytes,
// 5 collections run, 6 the most tracked bytes ever live at once, 7 reclaims
// run, 8 bytes they merged into spans and large blocks, 9 bytes parked,
// 10 region pages cached.
trusted fun __ablaRuntimePlatformMemoryHeapStat(which: int): int {
    if (which == 0) return ablaRuntimeWasmMemorySize() << 16
    if (which == 1) {
        if (__ablaRuntimeWasmHeapCursor == 0) return 0
        return __ablaRuntimeWasmHeapCursor - ((ablaRuntimeWasmHeapBase() + 15) & -16)
    }
    if (which == 2) {
        if (__ablaRuntimeWasmFreeLists == 0) return 0
        var total = 0
        var sizeClass = 0
        while (sizeClass < __ablaRuntimeWasmClassCount) {
            var block = ablaRuntimeLoadI64(__ablaRuntimeWasmFreeLists + sizeClass * 8)
            while (block != 0) {
                total = total + 16 + __ablaRuntimeWasmClassBytes(sizeClass)
                block = ablaRuntimeLoadI64(block)
            }
            sizeClass = sizeClass + 1
        }
        return total
    }
    if (which == 3) {
        var total = 0
        var block = __ablaRuntimeWasmLargeFree
        while (block != 0) {
            total = total + 16 + ablaRuntimeLoadI64(block - 16)
            block = ablaRuntimeLoadI64(block)
        }
        return total
    }
    if (which == 4) return __ablaRuntimeWasmLiveBytes
    if (which == 5) return __ablaRuntimeWasmCollections
    if (which == 6) return __ablaRuntimeWasmLivePeak
    if (which == 7) return __ablaRuntimeWasmReclaims
    if (which == 8) return __ablaRuntimeWasmReclaimMerged
    if (which == 9) return __ablaRuntimeWasmParked
    if (which == 10) return __ablaRuntimeWasmRegionPageCacheCount
    // 16 + k: bytes parked on size class k's free list.
