        if (layout == 6 && size >= 48) {
            __ablaRuntimeWasmMarkPointer(ablaRuntimeLoadI64(payload + 8))
            __ablaRuntimeWasmMarkPointer(ablaRuntimeLoadI64(payload + 16))
            __ablaRuntimeWasmMarkPointer(ablaRuntimeLoadI64(payload + 24))
            __ablaRuntimeWasmMarkPointer(ablaRuntimeLoadI64(payload + 32))
            __ablaRuntimeWasmMarkPointer(ablaRuntimeLoadI64(payload + 40))
        }
        if (layout == 7 && size >= 24) {
            __ablaRuntimeWasmMarkValue(payload + 16)
        }
        if (layout == 11 && size >= 48) {
            __ablaRuntimeWasmMarkValue(payload)
            __ablaRuntimeWasmMarkValue(payload + 24)
