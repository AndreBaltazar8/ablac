        var total = 0
        var block = ablaRuntimeLoadI64(__ablaRuntimeWasmFreeLists + (which - 16) * 8)
        while (block != 0) {
            total = total + 16 + __ablaRuntimeWasmClassBytes(which - 16)
            block = ablaRuntimeLoadI64(block)
        }
        return total
    }
