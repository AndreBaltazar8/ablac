    if (bytes <= 0) ablaRuntimeTrap()
    __ablaRuntimeWasmCollectionGrowth = bytes
    __ablaRuntimeWasmCollectionEnabled = true
    val next = __ablaRuntimeWasmLiveBytes + bytes
    if (__ablaRuntimeWasmCollectionThreshold > next) {
        __ablaRuntimeWasmCollectionThreshold = next
    }
    return
}

// Manual collection (the default here): allocation pressure does not collect
// until a later memorySetLimit or memorySetCollectionGrowth.
trusted fun __ablaRuntimePlatformMemorySetManualCollection(): void {
    __ablaRuntimeWasmCollectionEnabled = false
    return
}

trusted fun __ablaRuntimePlatformMemorySetLayout(
