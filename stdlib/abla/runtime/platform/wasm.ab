trusted noescape extern:"intrinsic" fun ablaRuntimeWasmHeapBase(): int
trusted noescape extern:"intrinsic" fun ablaRuntimeWasmMemorySize(): int
trusted noescape extern:"intrinsic" fun ablaRuntimeWasmMemoryGrow(
    pages: int
): int

// A Wasm guest is single-threaded: there is no thread to race the heap, so the
// mutex hooks only validate their argument and threads cannot be created.
// Single-threaded guests keep the host's slot size so runtime layouts match.
@inline
trusted fun __ablaRuntimePlatformMutexBytes(): int = 64

trusted fun __ablaRuntimePlatformMutexInitialize(address: int): void {
    if (address == 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexLock(address: int): void {
    if (address == 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexUnlock(address: int): void {
    if (address == 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformMutexDestroy(address: int): void {
    if (address == 0) ablaRuntimeTrap()
}

trusted fun __ablaRuntimePlatformThreadCreate(
    handle: int,
    entry: int,
    argument: int
): bool {
    if (handle == 0 || entry == 0 || argument == 0) ablaRuntimeTrap()
    false
}

trusted fun __ablaRuntimePlatformThreadJoin(handle: int): bool {
    if (handle == 0) ablaRuntimeTrap()
    false
}

trusted fun __ablaRuntimePlatformThreadsEnable(): void {}

// --- linear-memory block allocator -----------------------------------------
// The guest's malloc/free. Every block carries a 16-byte header whose first
// word is either a size-class index (< 64) or, for large blocks, the payload
// capacity in bytes (>= 1 MiB), so payloads stay 16-byte aligned. Small
// requests use segregated free lists: 16-byte steps up to 256 bytes, then four
// classes per doubling (320, 384, 448, 512, 640, ...) up to 1 MiB, so a block
// is at most a quarter bigger than its request (with powers of two, a 300 KiB
// array took 512 KiB). Larger requests are 64 KiB-granular blocks kept
// on a first-fit list that splits oversized hits. Fresh blocks come from a bump
// cursor that grows linear memory; freed blocks are only ever reused, because
// Wasm memory cannot shrink. Before a small request would grow memory while
// much is parked on the class lists, those blocks are sorted by address and
// physically adjacent runs merge into spans any class can carve from (a burst
// of one size, freed, then serves the others instead of memory growing).
var __ablaRuntimeWasmHeapCursor: int = 0
var __ablaRuntimeWasmHeapLimit: int = 0
var __ablaRuntimeWasmFreeLists: int = 0
var __ablaRuntimeWasmLargeFree: int = 0

// Bytes (with headers) parked on the free lists (small and large), and the
// parked level at which the next reclaim runs.
var __ablaRuntimeWasmParked: int = 0
var __ablaRuntimeWasmReclaimAt: int = 4194304
var __ablaRuntimeWasmReclaims: int = 0
var __ablaRuntimeWasmReclaimMerged: int = 0
// The span being carved [cursor, end) and the list of further spans, each
// starting with [next span, end].
var __ablaRuntimeWasmSpanCursor: int = 0
var __ablaRuntimeWasmSpanEnd: int = 0
var __ablaRuntimeWasmSpans: int = 0
val __ablaRuntimeWasmSpanMinimum: int = 65536

val __ablaRuntimeWasmClassCount: int = 64
val __ablaRuntimeWasmLargeMinimum: int = 1048576
val __ablaRuntimeWasmLargeGranule: int = 65536
val __ablaRuntimeWasmMemoryMaximum: int = 4294967295

trusted fun __ablaRuntimeWasmBump(bytes: int): int {
    if (__ablaRuntimeWasmHeapCursor == 0) {
        __ablaRuntimeWasmHeapCursor = (ablaRuntimeWasmHeapBase() + 15) & -16
        __ablaRuntimeWasmHeapLimit = ablaRuntimeWasmMemorySize() << 16
    }
    val begin = __ablaRuntimeWasmHeapCursor
    val end = begin + bytes
    if (bytes < 0 || end < begin || end > __ablaRuntimeWasmMemoryMaximum) {
        ablaRuntimeTrap()
    }
    if (end > __ablaRuntimeWasmHeapLimit) {
        val currentPages = __ablaRuntimeWasmHeapLimit >>> 16
        val requiredPages = (end + 65535) >>> 16
        // Grow by at least an eighth (1-16 MiB) so a stream of small blocks
        // does not pay one memory.grow per page; linear memory never shrinks,
        // so a big heap must not overshoot by half of itself.
        var growth = requiredPages - currentPages
        var step = currentPages / 8
        if (step < 16) step = 16
        if (step > 256) step = 256
        if (growth < step &&
            ((currentPages + step) << 16) <=
                __ablaRuntimeWasmMemoryMaximum) growth = step
        val previous = ablaRuntimeWasmMemoryGrow(growth)
        if (previous < 0) ablaRuntimeTrap()
        __ablaRuntimeWasmHeapLimit = (previous + growth) << 16
    }
    __ablaRuntimeWasmHeapCursor = end
    begin
}

@inline
trusted fun __ablaRuntimeWasmClassBytes(sizeClass: int): int =
    if (sizeClass < 16) (sizeClass + 1) * 16
    else (64 << ((sizeClass - 16) >> 2)) * (5 + ((sizeClass - 16) & 3))

// A block's payload bytes from its header word (a size class or a large capacity).
@inline
trusted fun __ablaRuntimeWasmBlockBytes(kind: int): int =
    if (kind < 64) __ablaRuntimeWasmClassBytes(kind) else kind

trusted fun __ablaRuntimeWasmClassOf(size: int): int {
    if (size <= 256) return (size + 15) / 16 - 1
    // The doubling (256 << octave, 512 << octave] holding `size`, then its quarter.
    var octave = 0
    while ((512 << octave) < size) octave = octave + 1
    val quarter = 64 << octave
    16 + octave * 4 + (size - (256 << octave) + quarter - 1) / quarter - 1
}

// Park [begin, end) on the class lists as the largest blocks that fit.
trusted fun __ablaRuntimeWasmShatter(begin: int, end: int): void {
    var at = begin
    while (end - at >= 32) {
        val room = end - at - 16
        var sizeClass = if (room <= 256) room / 16 - 1 else 15
        while (sizeClass + 1 < __ablaRuntimeWasmClassCount &&
            __ablaRuntimeWasmClassBytes(sizeClass + 1) <= room) {
            sizeClass = sizeClass + 1
        }
        val bytes = 16 + __ablaRuntimeWasmClassBytes(sizeClass)
        val head = __ablaRuntimeWasmFreeLists + sizeClass * 8
        ablaRuntimeStoreI64(at, sizeClass)
        ablaRuntimeStoreI64(at + 16, ablaRuntimeLoadI64(head))
        ablaRuntimeStoreI64(head, at + 16)
        __ablaRuntimeWasmParked = __ablaRuntimeWasmParked + bytes
        at = at + bytes
    }
}

// A block of `bytes` from the reclaimed spans (0 when they are used up).
trusted fun __ablaRuntimeWasmSpanCarve(bytes: int): int {
    while (true) {
        if (__ablaRuntimeWasmSpanCursor != 0 &&
            __ablaRuntimeWasmSpanCursor + bytes <= __ablaRuntimeWasmSpanEnd) {
            val block = __ablaRuntimeWasmSpanCursor
            __ablaRuntimeWasmSpanCursor = block + bytes
            return block
        }
        if (__ablaRuntimeWasmSpanCursor != 0) {
            __ablaRuntimeWasmShatter(__ablaRuntimeWasmSpanCursor, __ablaRuntimeWasmSpanEnd)
            __ablaRuntimeWasmSpanCursor = 0
        }
        if (__ablaRuntimeWasmSpans != 0) {
            val span = __ablaRuntimeWasmSpans
            __ablaRuntimeWasmSpans = ablaRuntimeLoadI64(span)
            __ablaRuntimeWasmSpanEnd = ablaRuntimeLoadI64(span + 8)
            __ablaRuntimeWasmSpanCursor = span
        } else if (__ablaRuntimeWasmLargeFree != 0) {
            // A parked large block serves small requests before memory grows.
            val large = __ablaRuntimeWasmLargeFree
            __ablaRuntimeWasmLargeFree = ablaRuntimeLoadI64(large)
            val capacity = ablaRuntimeLoadI64(large - 16)
            __ablaRuntimeWasmParked = __ablaRuntimeWasmParked - 16 - capacity
            __ablaRuntimeWasmSpanCursor = large - 16
            __ablaRuntimeWasmSpanEnd = large + capacity
        } else return 0
    }
    0
}

// Sort a list of free payloads (linked through their first word) by address.
trusted fun __ablaRuntimeWasmSortFree(list: int): int {
    if (list == 0) return 0
    var head = list
    var size = 1
    while (true) {
        var p = head
        head = 0
        var tail = 0
        var merges = 0
        while (p != 0) {
            merges = merges + 1
            var q = p
            var pSize = 0
            while (pSize < size && q != 0) {
                pSize = pSize + 1
                q = ablaRuntimeLoadI64(q)
            }
            var qSize = size
            while (pSize > 0 || (qSize > 0 && q != 0)) {
                var picked = 0
                if (pSize == 0) {
                    picked = q
                    q = ablaRuntimeLoadI64(q)
                    qSize = qSize - 1
                } else if (qSize == 0 || q == 0 || p <= q) {
                    picked = p
                    p = ablaRuntimeLoadI64(p)
                    pSize = pSize - 1
                } else {
                    picked = q
                    q = ablaRuntimeLoadI64(q)
                    qSize = qSize - 1
                }
                if (tail == 0) {
                    head = picked
                } else {
                    ablaRuntimeStoreI64(tail, picked)
                }
                tail = picked
            }
            p = q
        }
        ablaRuntimeStoreI64(tail, 0)
        if (merges <= 1) return head
        size = size * 2
    }
    head
}

// Merge physically adjacent parked blocks (small and large): runs of a large
// block or more become one large free block, runs of a span or more spans, and
// shorter runs go back on their class lists.
trusted fun __ablaRuntimeWasmReclaim(): void {
    if (__ablaRuntimeWasmSpanCursor != 0) {
        __ablaRuntimeWasmShatter(__ablaRuntimeWasmSpanCursor, __ablaRuntimeWasmSpanEnd)
        __ablaRuntimeWasmSpanCursor = 0
    }
    var all = 0
    var sizeClass = 0
    while (sizeClass < __ablaRuntimeWasmClassCount) {
        val head = __ablaRuntimeWasmFreeLists + sizeClass * 8
        var block = ablaRuntimeLoadI64(head)
        ablaRuntimeStoreI64(head, 0)
        while (block != 0) {
            val next = ablaRuntimeLoadI64(block)
            ablaRuntimeStoreI64(block, all)
            all = block
            block = next
        }
        sizeClass = sizeClass + 1
    }
    var large = __ablaRuntimeWasmLargeFree
    __ablaRuntimeWasmLargeFree = 0
    while (large != 0) {
        val next = ablaRuntimeLoadI64(large)
        ablaRuntimeStoreI64(large, all)
        all = large
        large = next
    }
    __ablaRuntimeWasmParked = 0
    __ablaRuntimeWasmReclaims = __ablaRuntimeWasmReclaims + 1
    var block = __ablaRuntimeWasmSortFree(all)
    while (block != 0) {
        val first = block
        val runBegin = block - 16
        var runEnd = block + __ablaRuntimeWasmBlockBytes(ablaRuntimeLoadI64(block - 16))
        var count = 1
        block = ablaRuntimeLoadI64(block)
        while (block != 0 && block - 16 == runEnd) {
            runEnd = block + __ablaRuntimeWasmBlockBytes(ablaRuntimeLoadI64(block - 16))
            count = count + 1
            block = ablaRuntimeLoadI64(block)
        }
        if (runEnd - runBegin >= 16 + __ablaRuntimeWasmLargeMinimum) {
            ablaRuntimeStoreI64(runBegin, runEnd - runBegin - 16)
            ablaRuntimeStoreI64(runBegin + 16, __ablaRuntimeWasmLargeFree)
            __ablaRuntimeWasmLargeFree = runBegin + 16
            __ablaRuntimeWasmParked = __ablaRuntimeWasmParked + runEnd - runBegin
            __ablaRuntimeWasmReclaimMerged = __ablaRuntimeWasmReclaimMerged + runEnd - runBegin
        } else if (runEnd - runBegin >= __ablaRuntimeWasmSpanMinimum) {
            ablaRuntimeStoreI64(runBegin, __ablaRuntimeWasmSpans)
            ablaRuntimeStoreI64(runBegin + 8, runEnd)
            __ablaRuntimeWasmSpans = runBegin
            __ablaRuntimeWasmReclaimMerged = __ablaRuntimeWasmReclaimMerged + runEnd - runBegin
        } else {
            var each = first
            while (count > 0) {
                val next = ablaRuntimeLoadI64(each)
                val kind = ablaRuntimeLoadI64(each - 16)
                val head = __ablaRuntimeWasmFreeLists + kind * 8
                ablaRuntimeStoreI64(each, ablaRuntimeLoadI64(head))
                ablaRuntimeStoreI64(head, each)
                __ablaRuntimeWasmParked = __ablaRuntimeWasmParked + 16 + __ablaRuntimeWasmClassBytes(kind)
                each = next
                count = count - 1
            }
        }
    }
    // The next growth reclaims again once another MiB has been freed.
    __ablaRuntimeWasmReclaimAt = __ablaRuntimeWasmParked + 1048576
    return
}

trusted fun __ablaRuntimeWasmMalloc(requested: int): int {
    val size = if (requested <= 0) 16 else requested
    if (__ablaRuntimeWasmFreeLists == 0) {
        // Fresh linear memory is zeroed, so the class heads start empty.
        __ablaRuntimeWasmFreeLists =
            __ablaRuntimeWasmBump(__ablaRuntimeWasmClassCount * 8)
    }
    if (size <= __ablaRuntimeWasmLargeMinimum) {
        val sizeClass = __ablaRuntimeWasmClassOf(size)
        val head = __ablaRuntimeWasmFreeLists + sizeClass * 8
        val bytes = 16 + __ablaRuntimeWasmClassBytes(sizeClass)
        var reused = ablaRuntimeLoadI64(head)
        if (reused == 0 && __ablaRuntimeWasmHeapCursor + bytes > __ablaRuntimeWasmHeapLimit &&
            __ablaRuntimeWasmParked >= __ablaRuntimeWasmReclaimAt) {
            __ablaRuntimeWasmReclaim()
            reused = ablaRuntimeLoadI64(head)
        }
        if (reused != 0) {
            ablaRuntimeStoreI64(head, ablaRuntimeLoadI64(reused))
            __ablaRuntimeWasmParked = __ablaRuntimeWasmParked - bytes
            return reused
        }
        var block = __ablaRuntimeWasmSpanCarve(bytes)
        if (block == 0) block = __ablaRuntimeWasmBump(bytes)
        ablaRuntimeStoreI64(block, sizeClass)
        return block + 16
    }
    if (size > __ablaRuntimeWasmMemoryMaximum) ablaRuntimeTrap()
    val capacity = (size + __ablaRuntimeWasmLargeGranule - 1) &
        -__ablaRuntimeWasmLargeGranule
    var attempt = 0
    while (attempt < 2) {
        var previous: int = 0
        var candidate = __ablaRuntimeWasmLargeFree
        while (candidate != 0) {
            val next = ablaRuntimeLoadI64(candidate)
            val available = ablaRuntimeLoadI64(candidate - 16)
            if (available >= capacity) {
                if (previous == 0) __ablaRuntimeWasmLargeFree = next
                else ablaRuntimeStoreI64(previous, next)
                __ablaRuntimeWasmParked = __ablaRuntimeWasmParked - 16 - available
                val remainder = available - capacity - 16
                if (remainder >= __ablaRuntimeWasmLargeMinimum) {
                    // Split: the tail becomes its own free large block.
                    val tail = candidate + capacity + 16
                    ablaRuntimeStoreI64(tail - 16, remainder)
                    ablaRuntimeStoreI64(tail, __ablaRuntimeWasmLargeFree)
                    __ablaRuntimeWasmLargeFree = tail
                    __ablaRuntimeWasmParked = __ablaRuntimeWasmParked + 16 + remainder
                    ablaRuntimeStoreI64(candidate - 16, capacity)
                }
                return candidate
            }
            previous = candidate
            candidate = next
        }
        // Nothing fits: merge what is parked before growing memory.
        if (attempt == 0 && __ablaRuntimeWasmHeapCursor + 16 + capacity > __ablaRuntimeWasmHeapLimit &&
            __ablaRuntimeWasmParked >= __ablaRuntimeWasmReclaimAt) {
            __ablaRuntimeWasmReclaim()
            attempt = 1
        } else attempt = 2
    }
    val block = __ablaRuntimeWasmBump(16 + capacity)
    ablaRuntimeStoreI64(block, capacity)
    block + 16
}

trusted fun __ablaRuntimeWasmMallocFree(address: int): void {
    if (address == 0) return
    if ((address & 15) != 0) ablaRuntimeTrap()
    val kind = ablaRuntimeLoadI64(address - 16)
    if (kind < 0) ablaRuntimeTrap()
    if (kind < 64) {
        if (kind >= __ablaRuntimeWasmClassCount) ablaRuntimeTrap()
        val head = __ablaRuntimeWasmFreeLists + kind * 8
        ablaRuntimeStoreI64(address, ablaRuntimeLoadI64(head))
        ablaRuntimeStoreI64(head, address)
        __ablaRuntimeWasmParked = __ablaRuntimeWasmParked + 16 + __ablaRuntimeWasmClassBytes(kind)
    } else {
        ablaRuntimeStoreI64(address, __ablaRuntimeWasmLargeFree)
        __ablaRuntimeWasmLargeFree = address
        __ablaRuntimeWasmParked = __ablaRuntimeWasmParked + 16 + kind
    }
    return
}

// --- tracked heap + precise collector ----------------------------------------
// A port of the hosted runtime's collector (platform/host.ab) onto the block
// allocator above. Tracked allocations form an intrusive list behind a 32-byte
// header [previous, next, size, layout-or-region]; the collector marks from
// compiler-published root frames using each allocation's layout, then frees
// everything unmarked. Collection only happens at explicit or
// pressure-triggered safe points inside functions the compiler rooted.
var __ablaRuntimeWasmAllocationHead: int = 0
var __ablaRuntimeWasmAllocationTail: int = 0
var __ablaRuntimeWasmAllocationCount: int = 0
var __ablaRuntimeWasmLiveBytes: int = 0
var __ablaRuntimeWasmLivePeak: int = 0
var __ablaRuntimeWasmCollections: int = 0
var __ablaRuntimeWasmLimit: int = 4294967295
var __ablaRuntimeWasmRegionCache: int = 0
var __ablaRuntimeWasmRegionCacheCount: int = 0
var __ablaRuntimeWasmRegionPageCache: int = 0
var __ablaRuntimeWasmRegionPageCacheCount: int = 0
var __ablaRuntimeWasmCollectionEnabled: bool = false
var __ablaRuntimeWasmCollectionThreshold: int = 33554432
// Least growth of the tracked heap past what a collection kept before the next.
var __ablaRuntimeWasmCollectionGrowth: int = 67108864
var __ablaRuntimeWasmCollectionIndex: int = 0
var __ablaRuntimeWasmCollectionCount: int = 0
var __ablaRuntimeWasmCollectionIndexCapacity: int = 0
var __ablaRuntimeWasmCollectionMinimum: int = 0
var __ablaRuntimeWasmCollectionMaximum: int = 0
var __ablaRuntimeWasmCollectionWorklist: int = 0
var __ablaRuntimeWasmCollectionWorklistCount: int = 0
var __ablaRuntimeWasmCollectionRanges: int = 0
var __ablaRuntimeWasmCollectionScratch: int = 0
var __ablaRuntimeWasmCollectionScratchBytes: int = 0
// Head of the compiler's root-frame chain and the active region. The guest has
// one thread, so these are plain globals rather than thread-local cells.
var __ablaRuntimeWasmRootFrame: int = 0
var __ablaRuntimeWasmRegion: int = 0

val __ablaRuntimeWasmRegionCachedDescriptors: int = 64
val __ablaRuntimeWasmRegionPageBytes: int = 1048576
// A few pages stay cached for the next region; more go back to the allocator
// (a burst's pages would otherwise stay pinned, as linear memory never shrinks).
val __ablaRuntimeWasmRegionCachedPages: int = 4

trusted fun __ablaRuntimeWasmUnlink(header: int): void {
    val previous = ablaRuntimeLoadI64(header)
    val next = ablaRuntimeLoadI64(header + 8)
    if (previous == 0) __ablaRuntimeWasmAllocationHead = next
    else ablaRuntimeStoreI64(previous + 8, next)
    if (next == 0) __ablaRuntimeWasmAllocationTail = previous
    else ablaRuntimeStoreI64(next, previous)
}

// Collector scratch entries are wasm32 addresses, 4 bytes each.
@inline
trusted fun __ablaRuntimeWasmScratchAt(base: int, index: int): int =
    ablaRuntimeLoadI32(base + index * 4) & 4294967295

@inline
trusted fun __ablaRuntimeWasmScratchPut(base: int, index: int, value: int): void {
    ablaRuntimeStoreI32(base + index * 4, value)
}

@inline
trusted fun __ablaRuntimeWasmCollectionIndexSlot(payload: int): int =
    ((payload >> 4) * -7046029254386353131) &
        (__ablaRuntimeWasmCollectionIndexCapacity - 1)

@inline
trusted fun __ablaRuntimeWasmCollectionIndexInsert(header: int): void {
    val mask = __ablaRuntimeWasmCollectionIndexCapacity - 1
    var slot = __ablaRuntimeWasmCollectionIndexSlot(header + 32)
    while (__ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionIndex, slot) != 0) slot = (slot + 1) & mask
    __ablaRuntimeWasmScratchPut(__ablaRuntimeWasmCollectionIndex, slot, header)
}

@inline
trusted fun __ablaRuntimeWasmCollectionRangeSwap(
    left: int,
    right: int
): void {
    val temporary = __ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, left)
    __ablaRuntimeWasmScratchPut(
        __ablaRuntimeWasmCollectionRanges, left,
        __ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, right)
    )
    __ablaRuntimeWasmScratchPut(__ablaRuntimeWasmCollectionRanges, right, temporary)
}

// Heap sort gives the marker an address-ordered allocation index without
// recursion, so interior string/array pointers resolve in logarithmic time.
trusted fun __ablaRuntimeWasmCollectionRangeSift(
    rootIndex: int,
    count: int
): void {
    var root = rootIndex
    var searching = true
    while (searching) {
        val left = root * 2 + 1
        if (left >= count) searching = false
        else {
            var largest = left
            val right = left + 1
            if (right < count && __ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, right) > __ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, left)) largest = right
            if (__ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, largest) <= __ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, root)) searching = false
            else {
                __ablaRuntimeWasmCollectionRangeSwap(root, largest)
                root = largest
            }
        }
    }
}

trusted fun __ablaRuntimeWasmCollectionRangesSort(count: int): void {
    var root = count / 2
    while (root > 0) {
        root = root - 1
        __ablaRuntimeWasmCollectionRangeSift(root, count)
    }
    var remaining = count
    while (remaining > 1) {
        remaining = remaining - 1
        __ablaRuntimeWasmCollectionRangeSwap(0, remaining)
        __ablaRuntimeWasmCollectionRangeSift(0, remaining)
    }
}

@inline
trusted fun __ablaRuntimeWasmCollectionContaining(candidate: int): int {
    var lower = 0
    var upper = __ablaRuntimeWasmCollectionCount
    while (lower < upper) {
        val middle = lower + (upper - lower) / 2
        val header = __ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, middle)
        if (header + 32 <= candidate) lower = middle + 1
        else upper = middle
    }
    var containing = 0
    if (lower > 0) {
        val header = __ablaRuntimeWasmScratchAt(__ablaRuntimeWasmCollectionRanges, (lower - 1))
        val payload = header + 32
        val size = ablaRuntimeLoadI64(header + 16)
        if (candidate >= payload && candidate - payload < size) {
            containing = header
        }
    }
    containing
}

// Region pages carry a 32-byte control header: next, capacity, used, and
// reserved. Region objects are bump-allocated after it and reclaimed together
// when their region ends.
trusted fun __ablaRuntimeWasmRegionPageAcquire(minimum: int): int {
    var page: int = 0
    var capacity: int = __ablaRuntimeWasmRegionPageBytes
    if (minimum <= __ablaRuntimeWasmRegionPageBytes &&
        __ablaRuntimeWasmRegionPageCache != 0) {
        page = __ablaRuntimeWasmRegionPageCache
        __ablaRuntimeWasmRegionPageCache = ablaRuntimeLoadI64(page)
        __ablaRuntimeWasmRegionPageCacheCount =
            __ablaRuntimeWasmRegionPageCacheCount - 1
    } else {
        if (minimum > capacity) capacity = minimum
        page = __ablaRuntimeWasmMalloc(capacity + 32)
        ablaRuntimeStoreI64(page + 8, capacity)
    }
    ablaRuntimeStoreI64(page, 0)
    ablaRuntimeStoreI64(page + 16, 0)
    page
}

trusted fun __ablaRuntimeWasmRegionPagesRelease(pageAddress: int): void {
    var page: int = pageAddress
    while (page != 0) {
        val next = ablaRuntimeLoadI64(page)
        val capacity = ablaRuntimeLoadI64(page + 8)
        if (capacity == __ablaRuntimeWasmRegionPageBytes &&
            __ablaRuntimeWasmRegionPageCacheCount <
                __ablaRuntimeWasmRegionCachedPages) {
            ablaRuntimeStoreI64(page + 16, 0)
            ablaRuntimeStoreI64(page, __ablaRuntimeWasmRegionPageCache)
            __ablaRuntimeWasmRegionPageCache = page
            __ablaRuntimeWasmRegionPageCacheCount =
                __ablaRuntimeWasmRegionPageCacheCount + 1
        } else __ablaRuntimeWasmMallocFree(page)
        page = next
    }
}

trusted fun __ablaRuntimeWasmRegionAllocate(size: int): int {
    val required = size + 32
    if (required < size || required > __ablaRuntimeWasmMemoryMaximum) {
        ablaRuntimeTrap()
    }
    val regionState = __ablaRuntimeWasmRegion
    var page: int = ablaRuntimeLoadI64(regionState + 8)
    var offset: int = 0
    if (page != 0) {
        offset = (ablaRuntimeLoadI64(page + 16) + 15) & -16
    }
    if (page == 0 || offset > ablaRuntimeLoadI64(page + 8) ||
        required > ablaRuntimeLoadI64(page + 8) - offset) {
        page = __ablaRuntimeWasmRegionPageAcquire(required + 15)
        ablaRuntimeStoreI64(page, ablaRuntimeLoadI64(regionState + 8))
        ablaRuntimeStoreI64(regionState + 8, page)
        offset = 0
    }
    val header = page + 32 + offset
    ablaRuntimeStoreI64(page + 16, offset + required)
    ablaRuntimeStoreI64(header, 0)
    ablaRuntimeStoreI64(header + 8, 0)
    ablaRuntimeStoreI64(header + 16, size)
    ablaRuntimeStoreI64(header + 24, regionState)
    ablaRuntimeStoreI64(
        regionState + 16,
        ablaRuntimeLoadI64(regionState + 16) + size
    )
    header + 32
}

trusted fun __ablaRuntimeWasmTrackedAllocate(size: int, layout: int): int {
    if (size > __ablaRuntimeWasmMemoryMaximum) ablaRuntimeTrap()
    val header = __ablaRuntimeWasmMalloc(size + 32)
    ablaRuntimeStoreI64(header, __ablaRuntimeWasmAllocationTail)
    ablaRuntimeStoreI64(header + 8, 0)
    ablaRuntimeStoreI64(header + 16, size)
    ablaRuntimeStoreI64(header + 24, layout)
    if (__ablaRuntimeWasmAllocationTail == 0) {
        __ablaRuntimeWasmAllocationHead = header
    } else {
        ablaRuntimeStoreI64(__ablaRuntimeWasmAllocationTail + 8, header)
    }
    __ablaRuntimeWasmAllocationTail = header
    __ablaRuntimeWasmAllocationCount = __ablaRuntimeWasmAllocationCount + 1
    val payload = header + 32
    val end = payload + size
    if (__ablaRuntimeWasmCollectionMinimum == 0 ||
        payload < __ablaRuntimeWasmCollectionMinimum) {
        __ablaRuntimeWasmCollectionMinimum = payload
    }
    if (end > __ablaRuntimeWasmCollectionMaximum) {
        __ablaRuntimeWasmCollectionMaximum = end
    }
    __ablaRuntimeWasmLiveBytes = __ablaRuntimeWasmLiveBytes + size
    if (__ablaRuntimeWasmLiveBytes > __ablaRuntimeWasmLivePeak) {
        __ablaRuntimeWasmLivePeak = __ablaRuntimeWasmLiveBytes
    }
    payload
}

trusted fun __ablaRuntimePlatformAllocateLayout(
    requested: int,
    layout: int
): int {
    val size: int = if (requested <= 0) 1 else requested
    if (size > __ablaRuntimeWasmLimit - __ablaRuntimeWasmLiveBytes) {
