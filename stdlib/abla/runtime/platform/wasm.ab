    }
}

trusted fun __ablaRuntimePlatformMemoryCollect(): int {
    // Region pages are reclaimed as a unit and may hold references into the
    // tracked heap, so collection waits for the outermost region to end.
    if (__ablaRuntimeWasmRegion != 0) return 0
    __ablaRuntimeWasmCollections = __ablaRuntimeWasmCollections + 1
    val before = __ablaRuntimeWasmLiveBytes
    val allocationCount = __ablaRuntimeWasmAllocationCount
    if (allocationCount == 0) return 0
    __ablaRuntimeWasmCollectionWorklist =
        __ablaRuntimeWasmMalloc(allocationCount * 8)
    __ablaRuntimeWasmCollectionRanges =
        __ablaRuntimeWasmMalloc(allocationCount * 8)
    var indexCapacity = 16
    while (indexCapacity < allocationCount * 2) {
        indexCapacity = indexCapacity * 2
    }
    __ablaRuntimeWasmCollectionIndex =
        __ablaRuntimeWasmMalloc(indexCapacity * 8)
    __ablaRuntimeWasmCollectionIndexCapacity = indexCapacity
    var indexSlot = 0
    while (indexSlot < indexCapacity) {
        ablaRuntimeStoreI64(
            __ablaRuntimeWasmCollectionIndex + indexSlot * 8, 0
        )
        indexSlot = indexSlot + 1
    }
    __ablaRuntimeWasmCollectionCount = allocationCount
    __ablaRuntimeWasmCollectionWorklistCount = 0
    var range = 0
    var indexedHeader = __ablaRuntimeWasmAllocationTail
    while (indexedHeader != 0) {
        ablaRuntimeStoreI64(
            __ablaRuntimeWasmCollectionRanges + range * 8, indexedHeader
        )
        __ablaRuntimeWasmCollectionIndexInsert(indexedHeader)
        range = range + 1
        indexedHeader = ablaRuntimeLoadI64(indexedHeader)
    }
    if (range != allocationCount) ablaRuntimeTrap()
    __ablaRuntimeWasmCollectionRangesSort(allocationCount)
    __ablaRuntimeWasmMarkRootValues()
    __ablaRuntimeWasmTraceMarkedAllocations()
    // Sweep: layout 10 allocations are pinned; marked ones (state >= 32) are
    // unmarked for the next cycle; everything else is garbage.
    var header: int = __ablaRuntimeWasmAllocationTail
    while (header != 0) {
        val previous = ablaRuntimeLoadI64(header)
        val state = ablaRuntimeLoadI64(header + 24)
        if (state == 10) {
            ablaRuntimeStoreI64(header + 24, 10)
        } else if (state >= 0 && state < 16) {
            __ablaRuntimePlatformFree(header + 32)
        } else ablaRuntimeStoreI64(header + 24, state - 32)
        header = previous
    }
    __ablaRuntimeWasmMallocFree(__ablaRuntimeWasmCollectionWorklist)
    __ablaRuntimeWasmMallocFree(__ablaRuntimeWasmCollectionRanges)
    __ablaRuntimeWasmMallocFree(__ablaRuntimeWasmCollectionIndex)
    __ablaRuntimeWasmCollectionCount = 0
    __ablaRuntimeWasmCollectionWorklist = 0
    __ablaRuntimeWasmCollectionWorklistCount = 0
    __ablaRuntimeWasmCollectionRanges = 0
    __ablaRuntimeWasmCollectionIndex = 0
    __ablaRuntimeWasmCollectionIndexCapacity = 0
    before - __ablaRuntimeWasmLiveBytes
}

trusted fun __ablaRuntimeRootsPush(
    frame: int,
    roots: int,
    count: int
): int {
    ablaRuntimeStoreI32(frame, __ablaRuntimeWasmRootFrame)
    ablaRuntimeStoreI32(frame + 4, roots)
    ablaRuntimeStoreI64(frame + 8, count)
    __ablaRuntimeWasmRootFrame = frame
    0
}

trusted fun __ablaRuntimeRootsPop(frame: int): int {
    if (__ablaRuntimeWasmRootFrame == frame) {
        __ablaRuntimeWasmRootFrame = __ablaRuntimeWasmLoadAddress(frame)
        return 0
    }
    // A module's static global-root frame is pushed once, lazily, by the first
    // export that touches globals — possibly while an outer frame is live.
    // That outer frame's pop then finds the permanent frame above it, so
    // unlink it from the middle; a frame absent from the chain is a bug.
    var newer = __ablaRuntimeWasmRootFrame
    while (newer != 0) {
        val older = __ablaRuntimeWasmLoadAddress(newer)
        if (older == frame) {
            ablaRuntimeStoreI32(newer, __ablaRuntimeWasmLoadAddress(frame))
            return 0
        }
        newer = older
    }
    ablaRuntimeTrap()
    0
}

trusted fun __ablaRuntimeMemoryPressure(): int {
    if (!__ablaRuntimeWasmCollectionEnabled ||
        __ablaRuntimeWasmRegion != 0 ||
        __ablaRuntimeWasmLiveBytes <
            __ablaRuntimeWasmCollectionThreshold) return 0
    __ablaRuntimePlatformMemoryCollect()
    val reserve = 67108864
    val least = __ablaRuntimeWasmCollectionGrowth
    val growth = if (__ablaRuntimeWasmLiveBytes / 2 > least) {
        __ablaRuntimeWasmLiveBytes / 2
    } else least
    var next = __ablaRuntimeWasmLiveBytes + growth
    val latest = __ablaRuntimeWasmLimit -
        if (__ablaRuntimeWasmLimit / 4 < reserve) {
            __ablaRuntimeWasmLimit / 4
        } else reserve
    if (next < least / 2) next = least / 2
    if (next > latest) next = latest
    __ablaRuntimeWasmCollectionThreshold = next
    0
}

trusted fun __ablaRuntimePlatformRegionBegin(): int {
    var regionAddress: int = __ablaRuntimeWasmRegionCache
    if (regionAddress != 0) {
        __ablaRuntimeWasmRegionCache = ablaRuntimeLoadI64(regionAddress)
        __ablaRuntimeWasmRegionCacheCount =
            __ablaRuntimeWasmRegionCacheCount - 1
    } else regionAddress = __ablaRuntimeWasmMalloc(24)
    ablaRuntimeStoreI64(regionAddress, __ablaRuntimeWasmRegion)
    ablaRuntimeStoreI64(regionAddress + 8, 0)
    ablaRuntimeStoreI64(regionAddress + 16, 0)
