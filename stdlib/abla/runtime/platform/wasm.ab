trusted fun __ablaRuntimePlatformAllocate(requested: int): int {
    val size = if (requested <= 0) 1 else requested
    if (__ablaRuntimeWasmHeapCursor == 0) {
        __ablaRuntimeWasmHeapCursor =
            (ablaRuntimeWasmHeapBase() + 7) & -8
        __ablaRuntimeWasmHeapLimit =
            ablaRuntimeWasmMemorySize() << 16
    }
    val begin = __ablaRuntimeWasmHeapCursor
    val aligned = (size + 7) & -8
    val end = begin + aligned
    if (end < begin) ablaRuntimeTrap()
    if (end > __ablaRuntimeWasmHeapLimit) {
        val currentPages = __ablaRuntimeWasmHeapLimit >>> 16
        val requiredPages = (end + 65535) >>> 16
        val growth = requiredPages - currentPages
        val previous = ablaRuntimeWasmMemoryGrow(growth)
        if (previous < 0) ablaRuntimeTrap()
        __ablaRuntimeWasmHeapLimit = (previous + growth) << 16
    }
    __ablaRuntimeWasmHeapCursor = end
