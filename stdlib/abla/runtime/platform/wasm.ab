}

trusted fun __ablaRuntimePlatformMemoryLimit(): int = __ablaRuntimeWasmLimit

trusted fun __ablaRuntimePlatformMemorySetLimit(limit: int): void {
    if (limit < 0 || limit < __ablaRuntimeWasmLiveBytes ||
        limit > __ablaRuntimeWasmMemoryMaximum) ablaRuntimeTrap()
