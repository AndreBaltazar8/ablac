// wasm32 lowers the compiler's AblaRootFrame { ptr, ptr, i64 } to 32-bit
// pointer fields at offsets 0 and 4 with the count at 8, and the roots array to
// 4-byte pointers; the hosted layout uses 8-byte fields throughout.
@inline
trusted fun __ablaRuntimeWasmLoadAddress(address: int): int =
    ablaRuntimeLoadI32(address) & 4294967295

trusted fun __ablaRuntimeWasmMarkRootValues(): void {
