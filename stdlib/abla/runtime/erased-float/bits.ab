// public: abla/float, abla/float/text
// The float bit views the erased float formatter needs, kept apart from
// abla/float: the bridge imports them under an alias, so they never meet a
// program's own abla/float import.

/// Reinterprets all 64 integer bits as a double-precision float.
noescape extern:"intrinsic" fun ablaBitI64ToF64(value: int): f64
/// Reinterprets the low 32 integer bits as a single-precision float.
noescape extern:"intrinsic" fun ablaBitI32ToF32(value: int): f32
/// Widens a single-precision float to double precision without rounding.
noescape extern:"intrinsic" fun ablaConvertF32ToF64(value: f32): f64

/// Constructs a double-precision float from its raw 64-bit representation.
fun f64FromBits(value: int): f64 = ablaBitI64ToF64(value)

/// Constructs a single-precision float from its raw 32-bit representation.
fun f32FromBits(value: u32): f32 = ablaBitI32ToF32(int(value))

/// Converts a single-precision float to double precision without rounding.
fun f32ToF64(value: f32): f64 = ablaConvertF32ToF64(value)
