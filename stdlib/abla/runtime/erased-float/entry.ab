import "abla/runtime/scalar"
import "float.ab" as internalBits
import "abla/float/text" as internalFloat

trusted fun __ablaRuntimeFormatErasedFloat(value: any): any {
    val address = ablaRuntimeValueAddress(value)
    if (ablaRuntimeLoadI32(address) == 2) {
        val kind = ablaRuntimeLoadI32(address + 4)
        if (kind == 1 || kind == 2) {
            val bits = ablaRuntimeLoadI64(address + 8)
            val number = if (kind == 1) internalBits.f32ToF64(internalBits.f32FromBits(u32(bits)))
                else internalBits.f64FromBits(bits)
            return internalFloat.f64Text(number)
        }
    }
    __ablaRuntimeToString(value)
}
