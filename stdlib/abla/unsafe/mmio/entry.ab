// Trusted volatile memory-mapped I/O. Platform frameworks own register maps
// and expose typed peripheral APIs; ordinary applications should not import
// this module directly.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU8(
    address: int
): int
/// Loads a unsigned 16-bit value with a volatile read from a valid address of that width.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU16(
    address: int
): int
/// Loads a unsigned 32-bit value with a volatile read from a valid address of that width.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU32(
    address: int
): int
/// Loads a 64-bit bit pattern with a volatile read from a valid address of that width.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU64(
    address: int
): int

/// Stores the low 8 bits with a volatile write to a valid address of that width.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU8(
    address: int,
    value: int
): void
/// Stores the low 16 bits with a volatile write to a valid address of that width.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU16(
    address: int,
    value: int
): void
/// Stores the low 32 bits with a volatile write to a valid address of that width.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU32(
    address: int,
    value: int
): void
/// Stores the low 64 bits with a volatile write to a valid address of that width.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU64(
    address: int,
    value: int
): void

/// Reads a unsigned 8-bit value from an appropriately aligned, readable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioLoadU8(address: int): int =
    ablaUnsafeVolatileLoadU8(address)

/// Reads a unsigned 16-bit value from an appropriately aligned, readable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioLoadU16(address: int): int =
    ablaUnsafeVolatileLoadU16(address)

/// Reads a unsigned 32-bit value from an appropriately aligned, readable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioLoadU32(address: int): int =
    ablaUnsafeVolatileLoadU32(address)

/// Reads a 64-bit bit pattern from an appropriately aligned, readable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioLoadU64(address: int): int =
    ablaUnsafeVolatileLoadU64(address)

/// Writes the low 8 bits to an appropriately aligned, writable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioStoreU8(address: int, value: int): void =
    ablaUnsafeVolatileStoreU8(address, value)

/// Writes the low 16 bits to an appropriately aligned, writable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioStoreU16(address: int, value: int): void =
    ablaUnsafeVolatileStoreU16(address, value)

/// Writes the low 32 bits to an appropriately aligned, writable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioStoreU32(address: int, value: int): void =
    ablaUnsafeVolatileStoreU32(address, value)

/// Writes the low 64 bits to an appropriately aligned, writable device register.
@__abla_trusted_only("warn 0.2.73")
trusted fun mmioStoreU64(address: int, value: int): void =
    ablaUnsafeVolatileStoreU64(address, value)
