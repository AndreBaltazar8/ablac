// Trusted volatile memory-mapped I/O. Platform frameworks own register maps
// and expose typed peripheral APIs; ordinary applications should not import
// this module directly.
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU8(
    address: int
): int
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU16(
    address: int
): int
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU32(
    address: int
): int
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileLoadU64(
    address: int
): int

trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU8(
    address: int,
    value: int
): void
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU16(
    address: int,
    value: int
): void
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU32(
    address: int,
    value: int
): void
trusted noescape extern:"intrinsic" fun ablaUnsafeVolatileStoreU64(
    address: int,
    value: int
): void

trusted fun mmioLoadU8(address: int): int =
    ablaUnsafeVolatileLoadU8(address)

trusted fun mmioLoadU16(address: int): int =
    ablaUnsafeVolatileLoadU16(address)

trusted fun mmioLoadU32(address: int): int =
    ablaUnsafeVolatileLoadU32(address)

trusted fun mmioLoadU64(address: int): int =
    ablaUnsafeVolatileLoadU64(address)

trusted fun mmioStoreU8(address: int, value: int): void =
    ablaUnsafeVolatileStoreU8(address, value)

trusted fun mmioStoreU16(address: int, value: int): void =
    ablaUnsafeVolatileStoreU16(address, value)

trusted fun mmioStoreU32(address: int, value: int): void =
    ablaUnsafeVolatileStoreU32(address, value)

trusted fun mmioStoreU64(address: int, value: int): void =
    ablaUnsafeVolatileStoreU64(address, value)
