// Optional typed indirect calls and atomic native synchronization.
// Kept separate from unsafe/memory so the previous release compiler can
// bootstrap a source graph that adds new intrinsic families.

export import "abla/unsafe/native/function-address"

// Initialize every reachable runtime module value exactly once. Low-level
// process, kernel, and firmware entries call this only after their writable
// data and BSS regions are ready. Ordinary exported functions receive the
// same initialization automatically and do not need to call it.
trusted noescape extern:"intrinsic" fun nativeInitializeGlobals(): void

// Atomically adds `delta` and returns the previous signed 64-bit word at the valid aligned address.
trusted noescape extern:"intrinsic" fun ablaUnsafeAtomicFetchAddI64(
    address: i64*,
    delta: int
): int

// Return the word observed at address. A result equal to expected means that
// replacement was stored. These are LLVM atomics rather than target assembly,
// so low-level frameworks can share the same operation across architectures.
trusted noescape extern:"intrinsic" fun ablaUnsafeAtomicCompareExchangeU32(
    address: int,
    expected: u32,
    replacement: u32
): u32

// Performs a relaxed atomic compare-and-exchange and returns the previous 32-bit word at the valid aligned address.
trusted noescape extern:"intrinsic" fun ablaUnsafeAtomicCompareExchangeRelaxedU32(
    address: int,
    expected: u32,
    replacement: u32
): u32

// A cross-thread, sequentially consistent memory fence. Architectures lower
// this to their native ordering instruction (MEMW on classic ESP32).
trusted noescape extern:"intrinsic" fun ablaUnsafeAtomicFence(): void

// Calls the function at a valid `address` with native ABI arguments `(pointer, pointer, pointer, pointer)` and returns the 32-bit integer result.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32Pointer4(
    address: int,
    first: i64*,
    second: i64*,
    third: i64*,
    fourth: i64*
): int

// Calls the function at a valid `address` with native ABI arguments `(pointer, pointer, pointer)` and returns the 32-bit integer result.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32Pointer3(
    address: int,
    first: i64*,
    second: i64*,
    third: i64*
): int

// Calls the function at a valid `address` with native ABI arguments `(pointer, pointer, pointer)`.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidPointer3(
    address: int,
    first: i64*,
    second: i64*,
    third: i64*
): void

// Calls the function at a valid `address` without arguments.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoid0(
    address: int
): void

// Calls a native zero-argument function whose C ABI result is a signed
// 32-bit scalar. This is the result-bearing counterpart of
// ablaUnsafeCallVoid0; keeping it in the generic native boundary lets target
// packages express callback dispatch as an LLVM indirect call instead of
// hiding the call inside architecture assembly.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32(
    address: int
): int

// Generic 32-bit C-ABI scalar calls. This coherent family covers register-
// sized integers, addresses represented as integers, and opaque handles on
// 32-bit targets without adding a one-off compiler lowering for every native
// callback shape.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32I32(
    address: int, first: int
): int

// Calls the function at a valid `address` with native ABI arguments `(i32, i32)` and returns the 32-bit integer result.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32I32I32(
    address: int, first: int, second: int
): int

// Calls the function at a valid `address` with native ABI arguments `(i32, i32, i32)` and returns the 32-bit integer result.
trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32I32I32I32(
    address: int, first: int, second: int, third: int
