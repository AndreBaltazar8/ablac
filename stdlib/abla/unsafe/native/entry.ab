// Optional typed indirect calls and atomic native synchronization.
// Kept separate from unsafe/memory so the previous release compiler can
// bootstrap a source graph that adds new intrinsic families.

trusted noescape extern:"intrinsic" fun ablaUnsafeAtomicFetchAddI64(
    address: i64*,
    delta: int
): int

trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32Pointer4(
    address: int,
    first: i64*,
    second: i64*,
    third: i64*,
    fourth: i64*
): int

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoid0(
    address: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidI32(
    address: int,
    first: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidI32I32(
    address: int,
    first: int,
    second: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidPointerI32(
    address: int,
    first: i64*,
    second: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidPointer(
    address: int,
    first: i64*
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidPointerI32I32(
    address: int,
    first: i64*,
    second: int,
    third: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32Pointer(
    address: int,
    first: i64*
): int

trusted noescape extern:"intrinsic" fun ablaUnsafeCallI32PointerI64(
    address: int,
    first: i64*,
    second: int
): int

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidPointerPointer(
    address: int,
    first: i64*,
    second: i64*
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidPointerIntPointer(
    address: int,
    first: i64*,
    second: int,
    third: i64*
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCallVoidPointerIntIntPointer(
    address: int,
    first: i64*,
    second: int,
    third: int,
    fourth: i64*
): void

trusted fun nativeAtomicFetchAddI64(address: i64*, delta: int): int =
    ablaUnsafeAtomicFetchAddI64(address, delta)

trusted fun callNativeI32Pointer4(
    address: int,
    first: i64*,
    second: i64*,
    third: i64*,
    fourth: i64*
): int = ablaUnsafeCallI32Pointer4(
    address,
    first,
    second,
    third,
    fourth
)

trusted fun callNativeVoid0(address: int): void {
    ablaUnsafeCallVoid0(address)
    return
}

trusted fun callNativeVoidI32(address: int, first: int): void {
    ablaUnsafeCallVoidI32(address, first)
    return
}

trusted fun callNativeVoidI32I32(
    address: int,
    first: int,
    second: int
): void {
    ablaUnsafeCallVoidI32I32(address, first, second)
    return
}

trusted fun callNativeVoidPointerI32(
    address: int,
    first: i64*,
    second: int
): void {
    ablaUnsafeCallVoidPointerI32(address, first, second)
    return
}

trusted fun callNativeVoidPointer(address: int, first: i64*): void {
    ablaUnsafeCallVoidPointer(address, first)
    return
}

trusted fun callNativeVoidPointerI32I32(
    address: int,
    first: i64*,
    second: int,
    third: int
): void {
    ablaUnsafeCallVoidPointerI32I32(address, first, second, third)
    return
}

trusted fun callNativeI32Pointer(address: int, first: i64*): int =
    ablaUnsafeCallI32Pointer(address, first)

trusted fun callNativeI32PointerI64(
    address: int,
    first: i64*,
    second: int
): int = ablaUnsafeCallI32PointerI64(address, first, second)

trusted fun callNativeVoidPointerPointer(
    address: int,
    first: i64*,
    second: i64*
): void {
    ablaUnsafeCallVoidPointerPointer(address, first, second)
    return
}

trusted fun callNativeVoidPointerIntPointer(
    address: int,
    first: i64*,
    second: int,
    third: i64*
): void {
    ablaUnsafeCallVoidPointerIntPointer(address, first, second, third)
    return
}

trusted fun callNativeVoidPointerIntIntPointer(
    address: int,
    first: i64*,
    second: int,
    third: int,
    fourth: i64*
): void {
    ablaUnsafeCallVoidPointerIntIntPointer(
        address,
        first,
        second,
        third,
        fourth
    )
    return
}
