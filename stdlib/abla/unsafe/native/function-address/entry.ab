// Function addresses without the typed indirect-call and atomic families.
// The host runtime needs only this intrinsic; abla/unsafe/native re-exports it.

// Obtain a C-ABI entry address for a named scalar Abla function without
// exporting a public symbol. The compiler retains a module-private adapter
// only while the returned address is reachable.
noescape extern:"intrinsic" fun nativeFunctionAddress(
    function: any
): int
