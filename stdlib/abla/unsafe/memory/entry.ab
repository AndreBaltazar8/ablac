// Trusted native implementation boundary. Raw declarations can only be called
// by a trusted function. Ordinary code uses the checked resource wrappers.

trusted noescape fun ablaUnsafeAllocate(size: int): i64* =
    ablaRuntimePointerFromAddress(__ablaRuntimeAllocateLayout(size, 10))

trusted noescape fun ablaUnsafeFree(pointer: i64*): void =
    __ablaRuntimeFree(ablaRuntimePointerAddress(pointer))

// Allocates temporary native storage directly in the calling function's stack
// frame with at least 16-byte alignment. The returned address is invalid after
// that function returns and must never be stored in a longer-lived value. This
// is an intrinsic instead of an Abla wrapper so LLVM cannot end an inlined
// callee frame before the caller has finished using the allocation.
trusted noescape extern:"intrinsic" fun nativeStackAllocate(capacity: int): int

// Reserves one zero-initialized native region for each call site. The address
// is stable for the process lifetime. Embedded code normally calls this from a
// module initializer to obtain C-style static storage without a heap wrapper.
// Capacity must be a compile-time integer when using the LLVM backend.
noescape extern:"intrinsic" fun nativeStaticAllocate(capacity: int): int

trusted noescape extern:"intrinsic" fun ablaUnsafeLoadI64(address: i64*): int

trusted noescape extern:"intrinsic" fun ablaUnsafeStoreI64(
    address: i64*,
    value: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeLoadPointer(address: i64*): i64*

trusted noescape extern:"intrinsic" fun ablaUnsafeStorePointer(
    address: i64*,
    value: i64*
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeNullPointer(): i64*

trusted noescape extern:"intrinsic" fun ablaUnsafePointerIsNull(value: i64*): bool

trusted noescape extern:"intrinsic" fun ablaUnsafeCallMain(address: int): int

trusted noescape extern:"intrinsic" fun ablaUnsafeCStringAddress(value: string): int

// Borrows the exact byte storage of a string without adding a terminator or
// copying it. Trusted callers must keep the string alive and pass an explicit
// bounded length to the native operation that consumes this address.
trusted noescape extern:"intrinsic" fun ablaUnsafeStringAddress(value: string): int

trusted noescape extern:"intrinsic" fun ablaUnsafePointerAddress(value: i64*): int

trusted noescape extern:"intrinsic" fun ablaUnsafePointerOffset(
    value: i64*,
    offset: int
): i64*

trusted noescape extern:"intrinsic" fun ablaUnsafeLoadU8(address: i64*): int

trusted noescape extern:"intrinsic" fun ablaUnsafeLoadU16(address: i64*): int

trusted noescape extern:"intrinsic" fun ablaUnsafeLoadU32(address: i64*): int

trusted noescape extern:"intrinsic" fun ablaUnsafeStoreU8(address: i64*, value: int): void

trusted noescape extern:"intrinsic" fun ablaUnsafeStoreU16(
    address: i64*,
    value: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeStoreU32(
    address: i64*,
    value: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeSetMemory(
    address: i64*,
    value: int,
    size: int
): void

trusted noescape extern:"intrinsic" fun ablaUnsafeCopyMemory(
    destinationAddress: int,
    sourceAddress: int,
    size: int
): void

// Takes ownership of a platform allocation with at least length + 1 bytes.
trusted noescape extern:"intrinsic" fun ablaUnsafeAdoptString(
    address: i64*,
    length: int
): string

// Borrows a NUL-terminated string for the lifetime guaranteed by the caller.
trusted noescape extern:"intrinsic" fun ablaUnsafeBorrowCString(address: i64*): string

resource class NativeI64Cell(
    val address: i64*,
    var closed: bool
) {
    trusted fun drop(): void {
        if (!closed) {
            ablaUnsafeFree(address)
            closed = true
        }
    }
}

resource class NativePointerCell(
    val address: i64*,
    var closed: bool,
    val ownsAllocation: bool
) {
    trusted fun drop(): void {
        if (!closed && ownsAllocation) {
            ablaUnsafeFree(address)
            closed = true
        }
    }
}

resource class NativeByteBuffer(
    val address: i64*,
    val capacity: int,
    var closed: bool
) {
    trusted fun drop(): void {
        if (!closed) {
            ablaUnsafeFree(address)
            closed = true
        }
    }
}

trusted fun nativeI64Cell(value: int): NativeI64Cell {
    val cell = NativeI64Cell(ablaUnsafeAllocate(8), false)
    ablaUnsafeStoreI64(cell.address, value)
    cell
}

trusted fun NativeI64Cell.load(): int {
    if (this.closed) 0
    else ablaUnsafeLoadI64(this.address)
}

trusted fun nativeI64CellStore(
    var cell: NativeI64Cell,
    value: int
): bool {
    var stored = false
    if (!cell.closed) {
        ablaUnsafeStoreI64(cell.address, value)
        stored = true
    }
    stored
}

trusted fun NativeI64Cell.store(value: int): bool =
    nativeI64CellStore(this, value)

trusted fun NativeI64Cell.close(): bool {
    var released = false
    if (!this.closed) {
        ablaUnsafeFree(this.address)
        this.closed = true
        released = true
    }
    released
}

trusted fun nativePointerCell(value: i64*): NativePointerCell {
    val cell = NativePointerCell(ablaUnsafeAllocate(8), false, true)
    ablaUnsafeStorePointer(cell.address, value)
    cell
}

trusted fun nativeNullPointer(): i64* = ablaUnsafeNullPointer()

trusted fun pointerIsNull(value: i64*): bool =
    ablaUnsafePointerIsNull(value)

trusted fun callNativeMain(address: int): int = ablaUnsafeCallMain(address)

trusted fun nativeCStringAddress(value: string): int =
    ablaUnsafeCStringAddress(value)

trusted fun nativeStringAddress(value: string): int =
    ablaUnsafeStringAddress(value)

trusted fun nativePointerAddress(value: i64*): int =
    ablaUnsafePointerAddress(value)

trusted fun nativePointerFromAddress(address: int): i64* =
    ablaUnsafePointerOffset(ablaUnsafeNullPointer(), address)

// Transfers a native allocation into an Abla string without copying it. The
// caller must have allocated at least length + 1 bytes at address and must not
// use or release that allocation after this call.
trusted fun adoptNativeString(address: int, length: int): string {
    var result = ""
    if (address > 0 && length >= 0) {
        __ablaRuntimePlatformMemorySetLayout(address, 1)
        result = ablaUnsafeAdoptString(
            nativePointerFromAddress(address),
            length
        )
    }
    result
}

trusted fun borrowNativeCString(value: i64*): string =
    ablaUnsafeBorrowCString(value)

trusted fun nativeByteBuffer(capacity: int): NativeByteBuffer {
    var size = capacity
    if (size < 0) size = 0
    NativeByteBuffer(ablaUnsafeAllocate(size), size, false)
}

trusted fun NativeByteBuffer.load(index: int): int {
    if (this.closed || index < 0 || index >= this.capacity) 0
    else ablaUnsafeLoadU8(ablaUnsafePointerOffset(this.address, index))
}

trusted fun NativeByteBuffer.loadI64(offset: int): int {
    if (this.closed || offset < 0 || offset + 8 > this.capacity) 0
    else ablaUnsafeLoadI64(ablaUnsafePointerOffset(this.address, offset))
}

trusted fun NativeByteBuffer.pointerAt(offset: int): i64* {
    var result = nativeNullPointer()
    if (!this.closed && offset >= 0 && offset <= this.capacity) {
        result = ablaUnsafePointerOffset(this.address, offset)
    }
    result
}

trusted fun nativeByteBufferStore(
    var buffer: NativeByteBuffer,
    index: int,
    value: int
): bool {
    var stored = false
    if (!buffer.closed && index >= 0 && index < buffer.capacity) {
        ablaUnsafeStoreU8(
            ablaUnsafePointerOffset(buffer.address, index),
            value
        )
        stored = true
    }
    stored
}

trusted fun NativeByteBuffer.store(index: int, value: int): bool =
    nativeByteBufferStore(this, index, value)

trusted fun nativeByteBufferStoreI64(
    var buffer: NativeByteBuffer,
    offset: int,
    value: int
): bool {
    var stored = false
    if (!buffer.closed && offset >= 0 && offset + 8 <= buffer.capacity) {
        ablaUnsafeStoreI64(
            ablaUnsafePointerOffset(buffer.address, offset),
            value
        )
        stored = true
    }
    stored
}

trusted fun NativeByteBuffer.storeI64(offset: int, value: int): bool =
    nativeByteBufferStoreI64(this, offset, value)

trusted fun nativeByteBufferStorePointer(
    var buffer: NativeByteBuffer,
    offset: int,
    value: i64*
): bool {
    var stored = false
    if (!buffer.closed && offset >= 0 && offset + 8 <= buffer.capacity) {
        ablaUnsafeStorePointer(
            ablaUnsafePointerOffset(buffer.address, offset),
            value
        )
        stored = true
    }
    stored
}

trusted fun NativeByteBuffer.storePointer(
    offset: int,
    value: i64*
): bool = nativeByteBufferStorePointer(this, offset, value)

trusted fun NativeByteBuffer.adoptString(length: int): string {
    var result = ""
    if (!this.closed && length >= 0 && length < this.capacity) {
        __ablaRuntimePlatformMemorySetLayout(
            ablaRuntimePointerAddress(this.address), 1
        )
        result = ablaUnsafeAdoptString(this.address, length)
        this.closed = true
    }
    result
}

trusted fun NativeByteBuffer.close(): bool {
    var released = false
    if (!this.closed) {
        ablaUnsafeFree(this.address)
        this.closed = true
        released = true
    }
    released
}

trusted fun NativePointerCell.load(): i64* {
    if (this.closed) nativeNullPointer()
    else ablaUnsafeLoadPointer(this.address)
}

trusted fun nativePointerCellStore(
    var cell: NativePointerCell,
    value: i64*
): bool {
    var stored = false
    if (!cell.closed) {
        ablaUnsafeStorePointer(cell.address, value)
        stored = true
    }
    stored
}

trusted fun NativePointerCell.store(value: i64*): bool =
    nativePointerCellStore(this, value)

trusted fun NativePointerCell.close(): bool {
    var released = false
    if (!this.closed) {
        if (this.ownsAllocation) ablaUnsafeFree(this.address)
        this.closed = true
        released = this.ownsAllocation
    }
    released
}
