/// Returns the Xtensa core identifier encoded in the processor ID register.
trusted noescape extern:"intrinsic" fun nativeXtensaCoreId(): u32
/// Returns the current Xtensa hardware cycle counter.
trusted noescape extern:"intrinsic" fun nativeXtensaCycleCounter(): int
/// Waits using the Xtensa cycle counter for the requested number of cycles.
trusted noescape extern:"intrinsic" fun nativeXtensaDelayCycles(
    cycles: int
): void
/// Sets the selected interrupt enable bits and returns the previous enable mask.
trusted noescape extern:"intrinsic" fun nativeXtensaInterruptsEnable(
    mask: u32
): u32
/// Clears the selected interrupt enable bits and returns the previous enable mask.
trusted noescape extern:"intrinsic" fun nativeXtensaInterruptsDisable(
    mask: u32
): u32
/// Returns the address of a native Xtensa interrupt handler.
trusted noescape extern:"intrinsic" fun nativeXtensaInterruptHandlerAddress(
    handler: Fn() -> void
): u32
/// Returns the address of the Xtensa interrupt dispatch table.
trusted noescape extern:"intrinsic" fun nativeXtensaInterruptTableAddress(): u32
/// Returns the address of the Xtensa exception dispatch table.
trusted noescape extern:"intrinsic" fun nativeXtensaExceptionTableAddress(): u32
/// Returns the address of the table of Xtensa interrupt levels.
trusted noescape extern:"intrinsic" fun nativeXtensaInterruptLevelTableAddress(): u32
/// Returns the address of the default handler for unhandled Xtensa interrupts.
trusted noescape extern:"intrinsic" fun nativeXtensaUnhandledInterruptAddress(): u32
/// Returns the address of the default handler for unhandled Xtensa exceptions.
trusted noescape extern:"intrinsic" fun nativeXtensaUnhandledExceptionAddress(): u32
/// Returns the address of the Xtensa owned-dispatcher table.
trusted noescape extern:"intrinsic" fun nativeXtensaOwnedDispatcherTableAddress(): u32
