// RFC 6455 WebSocket handshake, bounded frame codec, and connection lifecycle.
// The codec is transport-independent; the connection adapter below uses the
// affine TCP stream from `abla/net` and never exposes its descriptor.

import "abla/bytes"
import "abla/crypto"
import "abla/http"
import "abla/net"
import "abla/sys/linux/process"

// Holds a frame's final flag, opcode, payload bytes, and masking state.
class WebSocketFrame(
    val final: bool,
    val opcode: int,
    val payload: string,
    val masked: bool
)

// Holds the decoded frame, consumed bytes, completion flag, and any frame error.
class WebSocketFrameDecode(
    val frame: WebSocketFrame,
    val consumed: int,
    val complete: bool,
    val error: string
) {
    // Returns true when a complete frame decoded without error.
    fun succeeded(): bool = this.complete && this.error == ""
}

// Holds a frame or a stream outcome indicating closure, timeout, or error.
class WebSocketReadResult(
    val frame: WebSocketFrame,
    val available: bool,
    val closed: bool,
    val timedOut: bool,
    val error: string
)

// Holds an assembled message's kind and payload or the stream outcome when none is available.
class WebSocketMessage(
    val kind: string,
    val payload: string,
    val available: bool,
    val closed: bool,
    val timedOut: bool,
    val error: string
)

// Owns a WebSocket transport and tracks pending frame and fragmented message bytes.
resource class WebSocketConnection(
    val stream: TcpConnection,
    var buffered: string,
    val expectMasked: bool,
    val outgoingMask: string,
    var closed: bool,
    var fragmentedOpcode: int,
    var fragmentedPayload: string,
    // How long one frame may take from its first byte to its last (0: no limit), and how long a write of one frame may take (0: no limit); see `WebSocketServeOptions`.
    var frameTimeoutMilliseconds: int = 120000,
    var writeTimeoutMilliseconds: int = 30000,
    // How long a read waits for the next byte when the caller gives no timeout (it restarts on every byte); 0 is no limit.
    var idleTimeoutMilliseconds: int = 30000
)

// Sets the deadlines of the blocking WebSocket server (`serveWebSockets`, `serveWebSocketOnce`), in milliseconds, 0 turning one off. `http` bounds the request that asks for
// the upgrade (`HttpServeOptions`: a first byte, a head and a request that must arrive in time, the response written in time, the head and message size limits).
// After the upgrade `idleTimeoutMilliseconds` is how long a read waits for the next byte (it restarts on every byte, so it does not end a peer that trickles),
// `frameTimeoutMilliseconds` how long one frame may take from its first byte to its last (a peer that trickles one frame), `writeTimeoutMilliseconds` how long
// one write may take (a peer that does not read). A connection that runs out of time is closed. The server runs the handler on the thread that accepts, so a
// session holds the server until it ends: a service on an open network wants `abla/websocket/server` or `abla/websocket/event`, which read many connections at once.
class WebSocketServeOptions(
    val http: HttpServeOptions,
    val idleTimeoutMilliseconds: int = 30000,
    val frameTimeoutMilliseconds: int = 120000,
    val writeTimeoutMilliseconds: int = 30000
)

// The options `serveWebSockets` uses: the defaults of `httpServeOptions()` for the upgrade request, 30 s idle, 120 s per frame, 30 s per write.
fun webSocketServeOptions(): WebSocketServeOptions = WebSocketServeOptions(httpServeOptions())

// Associates an HTTP path pattern with its WebSocket handler.
class WebSocketRoute(
    val pattern: string,
    val handler: (HttpRequest, var: WebSocketConnection) -> void
)

// Holds the routes used to dispatch upgraded requests.
class WebSocketRouter(val routes: array<WebSocketRoute>)

private fun webSocketEmptyFrame(): WebSocketFrame =
    WebSocketFrame(true, 0, "", false)

private fun webSocketOpcodeValid(opcode: int): bool =
    opcode == 0 || opcode == 1 || opcode == 2 || opcode == 8 ||
    opcode == 9 || opcode == 10

private fun webSocketControlOpcode(opcode: int): bool = opcode >= 8

// Returns true if the close code is permitted on the wire.
fun webSocketCloseCodeValid(code: int): bool =
    code == 1000 || code == 1001 || code == 1002 || code == 1003 ||
    code == 1007 || code == 1008 || code == 1009 || code == 1010 ||
    code == 1011 || code == 1012 || code == 1013 || code == 1014 ||
    (code >= 3000 && code <= 4999)

private fun webSocketAppendU16(var output: ByteBuffer, value: int): void {
    output.appendByteValue((value >>> 8) & 255)
    output.appendByteValue(value & 255)
    return
}

private fun webSocketAppendU64(var output: ByteBuffer, value: int): void {
    output.appendByteValue((value >>> 56) & 255)
    output.appendByteValue((value >>> 48) & 255)
    output.appendByteValue((value >>> 40) & 255)
    output.appendByteValue((value >>> 32) & 255)
    output.appendByteValue((value >>> 24) & 255)
    output.appendByteValue((value >>> 16) & 255)
    output.appendByteValue((value >>> 8) & 255)
    output.appendByteValue(value & 255)
    return
}

// Returns the payload XORed with the repeating four-byte key, or empty text if the key length is invalid.
fun webSocketMask(payload: string, key: string): string {
    val output = byteBuffer()
    var index = 0
    if (key.size == 4) {
        while (index < payload.size) {
            val maskIndex = index - index / 4 * 4
            output.appendByteValue(payload[index] ^ key[maskIndex])
            index = index + 1
        }
    }
    output.toText()
}

// Encodes `payload` with the given `opcode` and `final` flag. `maskingKey` is empty for no mask or has exactly four bytes. Returns an empty string for invalid opcode or mask, or a control frame that is fragmented or longer than 125 bytes.
fun webSocketEncodeFrame(
    payload: string,
    opcode: int = 1,
    final: bool = true,
    maskingKey: string = ""
): string {
    val control = webSocketControlOpcode(opcode)
    var valid = webSocketOpcodeValid(opcode) &&
        (!control || (final && payload.size <= 125)) &&
        (maskingKey == "" || maskingKey.size == 4)
    val output = byteBuffer()
    if (valid) {
        output.appendByteValue((if (final) 128 else 0) | opcode)
        val mask = if (maskingKey.size == 4) 128 else 0
        if (payload.size <= 125) {
            output.appendByteValue(mask | payload.size)
        } else if (payload.size <= 65535) {
            output.appendByteValue(mask | 126)
            webSocketAppendU16(output, payload.size)
        } else {
            output.appendByteValue(mask | 127)
            webSocketAppendU64(output, payload.size)
        }
        if (mask != 0) output.appendText(maskingKey)
        if (mask != 0) output.appendText(webSocketMask(payload, maskingKey))
        else output.appendText(payload)
    }
    if (valid) output.toText() else ""
}

// Decodes one frame from the start of `input`, capping its payload at `maximumPayload` and requiring masking when `requireMasked` is true. The result separates a complete frame, incomplete input, and a protocol error.
fun webSocketDecodeFrame(
    input: string,
    maximumPayload: int = 1048576,
    requireMasked: bool = false
): WebSocketFrameDecode {
    var frame = webSocketEmptyFrame()
    var consumed = 0
    var complete = false
    var error = ""
    if (maximumPayload < 0) error = "invalid payload limit"
    if (error == "" && input.size >= 2) {
        val first = input[0]
        val second = input[1]
        val final = (first & 128) != 0
        val opcode = first & 15
        val masked = (second & 128) != 0
        var length = second & 127
        var header = 2
        if ((first & 112) != 0) error = "reserved bits are not supported"
        if (error == "" && !webSocketOpcodeValid(opcode)) {
            error = "invalid opcode"
        }
        if (error == "" && requireMasked && !masked) {
            error = "client frame must be masked"
        }
        if (error == "" && length == 126) {
            if (input.size < 4) length = -1
            else {
                length = input[2] * 256 + input[3]
                header = 4
                if (length < 126) error = "non-canonical payload length"
            }
        } else if (error == "" && length == 127) {
            if (input.size < 10) length = -1
            else if ((input[2] & 128) != 0) {
                error = "payload length exceeds signed range"
            } else {
                length = 0
                var index = 2
                while (index < 10 && error == "") {
                    if (length > maximumPayload / 256) {
                        error = "payload exceeds configured limit"
                    } else length = length * 256 + input[index]
                    index = index + 1
                }
                header = 10
                if (error == "" && length <= 65535) {
                    error = "non-canonical payload length"
                }
            }
        }
        if (length >= 0 && masked) header = header + 4
        if (error == "" && length > maximumPayload) {
            error = "payload exceeds configured limit"
        }
        if (error == "" && length >= 0 &&
            webSocketControlOpcode(opcode) && (!final || length > 125)) {
            error = "invalid control frame"
        }
        if (error == "" && length >= 0 && input.size >= header + length) {
            var payload = input.slice(header, header + length)
            if (masked) {
                payload = webSocketMask(
                    payload, input.slice(header - 4, header)
                )
            }
            if (opcode == 8 && payload.size == 1) {
                error = "invalid close payload"
            } else if (opcode == 8 && payload.size >= 2) {
                val code = payload[0] * 256 + payload[1]
                val reason = payload.slice(2, payload.size)
                if (!webSocketCloseCodeValid(code)) {
                    error = "invalid close code"
                } else if (!webSocketUtf8Valid(reason)) {
                    error = "invalid close reason"
                }
            }
            if (error == "") {
                frame = WebSocketFrame(final, opcode, payload, masked)
                consumed = header + length
                complete = true
            }
        }
    }
    if (error != "") complete = true
    WebSocketFrameDecode(frame, consumed, complete, error)
}

// Returns true if the input is a valid UTF-8 encoding.
fun webSocketUtf8Valid(value: string): bool {
    var valid = true
    var remaining = 0
    var codepoint = 0
    var minimum = 0
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        if (remaining == 0) {
            if (byte <= 127) {
                codepoint = byte
            } else if (byte >= 194 && byte <= 223) {
                codepoint = byte & 31
                minimum = 128
                remaining = 1
            } else if (byte >= 224 && byte <= 239) {
                codepoint = byte & 15
                minimum = 2048
                remaining = 2
            } else if (byte >= 240 && byte <= 244) {
                codepoint = byte & 7
                minimum = 65536
                remaining = 3
            } else valid = false
        } else if (byte < 128 || byte > 191) {
            valid = false
        } else {
            codepoint = codepoint * 64 + (byte & 63)
            remaining = remaining - 1
            if (remaining == 0 && (codepoint < minimum ||
                codepoint > 1114111 ||
                (codepoint >= 55296 && codepoint <= 57343))) valid = false
        }
        index = index + 1
    }
    valid && remaining == 0
}

// Returns the Sec-WebSocket-Accept value derived from the client's key.
fun webSocketAccept(key: string): string = base64Encode(sha1(
    "${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
))

// Returns true if the comma-separated header contains the wanted token, ignoring ASCII case and adjacent whitespace.
fun webSocketHeaderContainsToken(value: string, wanted: string): bool {
    var matched = false
    var begin = 0
    var index = 0
    while (!matched && index <= value.size) {
        if (index == value.size || value[index] == 44) {
            var left = begin
            var right = index
            while (left < right && (value[left] == 32 || value[left] == 9)) {
                left = left + 1
            }
            while (right > left &&
                (value[right - 1] == 32 || value[right - 1] == 9)) {
                right = right - 1
            }
            matched = httpAsciiEqualInsensitive(
                value.slice(left, right), wanted
            )
            begin = index + 1
        }
        index = index + 1
    }
    matched
}

// Returns true for a WebSocket version 13 GET upgrade with the required headers and a valid 16-byte nonce.
fun webSocketIsUpgradeRequest(request: HttpRequest): bool {
    val decodedKey = base64Decode(request.header("Sec-WebSocket-Key"))
    request.method == "GET" &&
        webSocketHeaderContainsToken(request.header("Upgrade"), "websocket") &&
        webSocketHeaderContainsToken(request.header("Connection"), "upgrade") &&
        request.header("Sec-WebSocket-Version") == "13" &&
        decodedKey.size == 16
}

// Returns a 101 switching-protocols response for a valid request or a 400 error otherwise.
fun webSocketUpgradeResponse(request: HttpRequest): HttpResponse {
    var response = httpText("invalid WebSocket upgrade", 400)
    if (webSocketIsUpgradeRequest(request)) {
        response = HttpResponse(101, [
            HttpHeader("Upgrade", "websocket"),
            HttpHeader("Connection", "Upgrade"),
            HttpHeader(
                "Sec-WebSocket-Accept",
                webSocketAccept(request.header("Sec-WebSocket-Key"))
            )
        ], "")
    } else if (request.header("Sec-WebSocket-Version") != "13") {
        response = HttpResponse(426, [
            HttpHeader("Sec-WebSocket-Version", "13")
        ], "WebSocket version 13 is required")
    }
    response
}

private fun webSocketUpgrade(
    request: HttpRequest,
    var stream: TcpConnection
): bool {
    val response = webSocketUpgradeResponse(request)
    stream.write(response.render()) > 0 && response.status == 101
}

// Takes ownership of `stream`. Select `expectMasked` for client frames and provide a four-byte `outgoingMask` to mask writes, or an empty string for unmasked writes.
fun webSocketConnection(
    own stream: TcpConnection,
    expectMasked: bool = true,
    outgoingMask: string = ""
): WebSocketConnection = WebSocketConnection(
    move(stream), "", expectMasked, outgoingMask, false, 0, ""
)

// Sends `payload` with the given `opcode` and `final` flag. Returns false for a closed connection, an invalid frame, or an incomplete socket write.
fun WebSocketConnection.sendFrame(
    payload: string,
    opcode: int,
    final: bool = true
): bool {
    var sent = false
    if (!this.closed) {
        val encoded = webSocketEncodeFrame(
            payload, opcode, final, this.outgoingMask
        )
        if (encoded != "") {
            sent = if (this.writeTimeoutMilliseconds > 0) this.stream.writeNetwork(encoded, this.writeTimeoutMilliseconds).succeeded()
                else this.stream.write(encoded) == encoded.size
        }
    }
    sent
}

// Sends UTF-8 `payload` as a text message. Returns false on invalid UTF-8 or a failed frame send.
fun WebSocketConnection.sendText(payload: string): bool =
    webSocketUtf8Valid(payload) && this.sendFrame(payload, 1)

// Sends `payload` as a binary message. Returns false if the frame cannot be sent.
fun WebSocketConnection.sendBinary(payload: string): bool =
    this.sendFrame(payload, 2)

// Sends a ping carrying `payload` (at most 125 bytes). Returns false if the frame cannot be sent.
fun WebSocketConnection.sendPing(payload: string = ""): bool =
    this.sendFrame(payload, 9)

// Sends a pong carrying `payload` (at most 125 bytes). Returns false if the frame cannot be sent.
fun WebSocketConnection.sendPong(payload: string = ""): bool =
    this.sendFrame(payload, 10)

// Returns the wire close payload, or empty text for an invalid code, invalid UTF-8, or a reason over 123 bytes.
fun webSocketClosePayload(code: int, reason: string): string {
    val output = byteBuffer()
    if (webSocketCloseCodeValid(code) && reason.size <= 123 &&
        webSocketUtf8Valid(reason)) {
        output.appendByteValue((code >>> 8) & 255)
        output.appendByteValue(code & 255)
        output.appendText(reason)
    }
    output.toText()
}

// Attempts to send a close frame with `code` and UTF-8 `reason`, then closes the underlying stream even if the frame fails. Returns true when already closed or when the frame was sent.
fun WebSocketConnection.close(
    code: int = 1000,
    reason: string = ""
): bool {
    var success = this.closed
    if (!this.closed) {
        val payload = webSocketClosePayload(code, reason)
        success = payload != "" && this.sendFrame(payload, 8)
        this.stream.close()
        this.closed = true
    }
    success
}

// Returns the next bounded frame or the closure, timeout, or protocol error encountered while reading.
fun WebSocketConnection.readFrame(
    maximumPayload: int = 1048576,
    timeoutMilliseconds: int = -1
): WebSocketReadResult {
    var decoded = webSocketDecodeFrame(
        this.buffered, maximumPayload, this.expectMasked
    )
    var timedOut = false
    var peerClosed = this.closed
    var error = decoded.error
    // The frame's clock starts when its first byte is in hand (it may have arrived with the previous frame).
    var frameStarted = if (this.buffered.size > 0) linuxMonotonicMilliseconds() else 0
    while (!decoded.complete && !peerClosed && !timedOut && error == "") {
        // No timeout given: the connection's idle timeout, where 0 is no limit (waited for a minute at a time).
        val unlimited = timeoutMilliseconds < 0 && this.idleTimeoutMilliseconds <= 0
        var wait = if (unlimited) 60000 else if (timeoutMilliseconds < 0) this.idleTimeoutMilliseconds else timeoutMilliseconds
        if (frameStarted > 0 && this.frameTimeoutMilliseconds > 0) {
            val left = frameStarted + this.frameTimeoutMilliseconds - linuxMonotonicMilliseconds()
            if (left < 1) {
                timedOut = true
                wait = 0
            } else if (left < wait || wait <= 0) wait = left
        }
        val incoming = if (timedOut) SocketReadResult("", "timeout", 0) else this.stream.readWithTimeoutResult(
            65536, wait
        )
        if (incoming.hasData()) {
            if (frameStarted == 0) frameStarted = linuxMonotonicMilliseconds()
            this.buffered = "${this.buffered}${incoming.bytes}"
            decoded = webSocketDecodeFrame(
                this.buffered, maximumPayload, this.expectMasked
            )
            // Only the bytes of a frame still being read are bounded (header 14 + payload): the end of a whole frame may arrive with the next ones.
            if (!decoded.complete && this.buffered.size > maximumPayload + 14) {
                error = "buffer exceeds configured limit"
            }
        } else if (incoming.timedOut()) {
            if (!unlimited) timedOut = true
        } else {
            peerClosed = incoming.reachedEof()
            if (incoming.failed()) error = "socket read failed"
        }
    }
    var available = decoded.succeeded()
    if (available) {
        this.buffered = this.buffered.slice(
            decoded.consumed, this.buffered.size
        )
    }
    if (peerClosed) this.closed = true
    WebSocketReadResult(
        decoded.frame, available, peerClosed, timedOut,
        if (error != "") error else decoded.error
    )
}

// Reads a complete text or binary message, handling fragmentation and control frames. Uses `maximumPayload` to bound frame and message size and `timeoutMilliseconds` for reads. The result distinguishes a message, closure, timeout, and protocol or I/O errors.
fun WebSocketConnection.readMessage(
    maximumPayload: int = 1048576,
    timeoutMilliseconds: int = -1
): WebSocketMessage {
    var result = WebSocketMessage("", "", false, false, false, "")
    var waiting = true
    while (waiting) {
        val incoming = this.readFrame(maximumPayload, timeoutMilliseconds)
        if (!incoming.available) {
            result = WebSocketMessage(
                "", "", false, incoming.closed, incoming.timedOut,
                incoming.error
            )
            waiting = false
        } else {
            val frame = incoming.frame
            if (frame.opcode == 9) {
                if (!this.sendPong(frame.payload)) {
                    result = WebSocketMessage(
                        "", "", false, false, false, "cannot send pong"
                    )
                    waiting = false
                }
            } else if (frame.opcode == 10) {
            } else if (frame.opcode == 8) {
                if (!this.closed) this.sendFrame(frame.payload, 8)
                this.stream.close()
                this.closed = true
                result = WebSocketMessage("", "", false, true, false, "")
                waiting = false
            } else if (frame.opcode == 1 || frame.opcode == 2) {
                if (this.fragmentedOpcode != 0) {
                    result = WebSocketMessage(
                        "", "", false, false, false,
                        "new message before fragmented message completed"
                    )
                    waiting = false
                } else if (frame.final) {
                    val kind = if (frame.opcode == 1) "text" else "binary"
                    var valid = true
                    if (frame.opcode == 1) {
                        valid = webSocketUtf8Valid(frame.payload)
                    }
                    result = WebSocketMessage(
                        kind, frame.payload, valid, false, false,
                        if (valid) "" else "invalid UTF-8 text message"
                    )
                    waiting = false
                } else {
                    this.fragmentedOpcode = frame.opcode
                    this.fragmentedPayload = frame.payload
                }
            } else if (frame.opcode == 0) {
                if (this.fragmentedOpcode == 0) {
                    result = WebSocketMessage(
                        "", "", false, false, false,
                        "continuation without fragmented message"
                    )
                    waiting = false
                } else {
                    this.fragmentedPayload =
                        "${this.fragmentedPayload}${frame.payload}"
                    if (this.fragmentedPayload.size > maximumPayload) {
                        result = WebSocketMessage(
                            "", "", false, false, false,
                            "message exceeds configured limit"
                        )
                        waiting = false
                    } else if (frame.final) {
                        val opcode = this.fragmentedOpcode
                        val payload = this.fragmentedPayload
                        this.fragmentedOpcode = 0
                        this.fragmentedPayload = ""
                        val kind = if (opcode == 1) "text" else "binary"
                        var valid = true
                        if (opcode == 1) valid = webSocketUtf8Valid(payload)
                        result = WebSocketMessage(
                            kind, payload, valid, false, false,
                            if (valid) "" else "invalid UTF-8 text message"
                        )
                        waiting = false
                    }
                }
            }
        }
    }
    result
}

// Creates an empty WebSocket router.
fun webSocketRouter(): WebSocketRouter = WebSocketRouter([])

// Appends a route for the path `pattern` and its connection `handler`. Returns this router for chaining.
fun WebSocketRouter.route(
    pattern: string,
    handler: (HttpRequest, var: WebSocketConnection) -> void
): WebSocketRouter {
    this.routes.append(WebSocketRoute(pattern, handler))
    this
}

// Returns the first registered route index matching the path of `request`, or -1 if absent.
fun WebSocketRouter.find(request: HttpRequest): int {
    var found = -1
    var index = 0
    while (found < 0 && index < this.routes.size) {
        if (httpMatchPath(this.routes[index].pattern, request.path).matched) {
            found = index
        }
        index = index + 1
    }
    found
}

// Returns the request with path parameters captured by the route at a valid index.
fun WebSocketRouter.routedRequest(
    routeIndex: int,
    request: HttpRequest
): HttpRequest {
    val matched = httpMatchPath(
        this.routes[routeIndex].pattern, request.path
    )
    HttpRequest(
        request.method,
        request.path,
        request.query,
        request.headers,
        request.body,
        matched.names,
        matched.values,
        request.peerAddress
    )
}

private fun serveMatchedWebSocket(
    router: WebSocketRouter,
    routeIndex: int,
    request: HttpRequest,
    own stream: TcpConnection,
    options: WebSocketServeOptions
): bool {
    var handled = false
    val response = webSocketUpgradeResponse(request).render()
    val written = if (options.http.responseTimeoutMilliseconds > 0) {
        val outcome = stream.writeNetwork(response, options.http.responseTimeoutMilliseconds)
        if (outcome.succeeded()) outcome.written else -1
    } else stream.write(response)
    if (written == response.size) {
        val connection = webSocketConnection(move(stream))
        connection.frameTimeoutMilliseconds = options.frameTimeoutMilliseconds
        connection.writeTimeoutMilliseconds = options.writeTimeoutMilliseconds
        connection.idleTimeoutMilliseconds = options.idleTimeoutMilliseconds
        val handler = router.routes[routeIndex].handler
        handler(router.routedRequest(routeIndex, request), connection)
        if (!connection.closed) connection.close()
        handled = true
    }
    handled
}

private fun serveWebSocketStream(
    router: WebSocketRouter,
    own stream: TcpConnection,
    options: WebSocketServeOptions
): bool {
    // The request that asks for the upgrade is read within the first-byte, head and request deadlines: a client that sends nothing, or a byte now and then, is
    // closed without an answer instead of holding every other client.
    val read = httpReadRequestWithin(stream, options.http)
    var handled = false
    if (!read.timedOut) {
        val request = httpRequestWithPeer(httpParseRequest(read.request), stream.descriptor)
        val routeIndex = router.find(request)
        if (routeIndex >= 0 && webSocketIsUpgradeRequest(request)) {
            handled = serveMatchedWebSocket(
                router, routeIndex, request, move(stream), options
            )
        } else {
            val response = if (request.method == "") httpText("bad request", 400)
                else if (routeIndex < 0) httpText("not found", 404)
                else webSocketUpgradeResponse(request)
            if (options.http.responseTimeoutMilliseconds > 0) stream.writeNetwork(response.render(), options.http.responseTimeoutMilliseconds)
            else stream.write(response.render())
        }
    }
    handled
}

// Accepts one client from `listener` and uses `router` to handle a WebSocket upgrade within the deadlines of `options`. Returns whether the upgrade was handled.
fun serveWebSocketOnceWith(
    router: WebSocketRouter,
    var listener: TcpListener,
    options: WebSocketServeOptions
): bool {
    val stream = listener.accept()
    serveWebSocketStream(router, move(stream), options)
}

// Accepts one client from `listener` and uses `router` to handle a WebSocket upgrade. `maximumHeader` and `maximumMessage` bound input sizes. The deadlines are those of `webSocketServeOptions()`. Returns whether the upgrade was handled.
fun serveWebSocketOnce(
    router: WebSocketRouter,
    var listener: TcpListener,
    maximumHeader: int = 65536,
    maximumMessage: int = 1048576
): bool = serveWebSocketOnceWith(router, listener, webSocketServeOptionsFor(maximumHeader, maximumMessage))

// The default deadlines with the given input bounds.
private fun webSocketServeOptionsFor(maximumHeader: int, maximumMessage: int): WebSocketServeOptions {
    val http = httpServeOptions()
    WebSocketServeOptions(HttpServeOptions(
        http.firstByteTimeoutMilliseconds, http.requestHeadTimeoutMilliseconds, http.requestTimeoutMilliseconds, http.responseTimeoutMilliseconds,
        maximumHeader, maximumMessage
    ))
}

// Serves WebSocket upgrades from `listener` through `router` within the deadlines of `options` until graceful shutdown, and returns zero on graceful shutdown.
fun serveWebSocketsOnListenerWith(
    router: WebSocketRouter,
    var listener: TcpListener,
    options: WebSocketServeOptions
): int {
    tcpEnableGracefulShutdown()
    while (!tcpShutdownRequested()) {
        val stream = listener.acceptUntilShutdown()
        if (stream.descriptor >= 0) {
            serveWebSocketStream(router, move(stream), options)
        }
    }
    listener.close()
    0
}

// Listens on the given TCP port and runs the WebSocket router within the deadlines of `options`, returning the listener loop's status.
fun serveWebSocketsWith(
    router: WebSocketRouter,
    port: int,
    options: WebSocketServeOptions
): int {
    val listener = tcpListen(port)
    serveWebSocketsOnListenerWith(router, listener, options)
}

// Listens on the given TCP port and runs the WebSocket router with the deadlines of `webSocketServeOptions()`, returning the listener loop's status.
fun serveWebSockets(
    router: WebSocketRouter,
    port: int,
    maximumHeader: int = 65536,
    maximumMessage: int = 1048576
): int = serveWebSocketsWith(router, port, webSocketServeOptionsFor(maximumHeader, maximumMessage))
