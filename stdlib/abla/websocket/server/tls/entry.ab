// TLS for `abla/websocket/server`. Loads one certificate chain and private key
// into an abla/tls/pure server configuration and hands the server the
// nonblocking TLS calls it drives from `step`:
//
//     val tls = webSocketServerTls("fullchain.pem", "privkey.pem")
//     if (tls.error != "") println(tls.error)
//     val server = webSocketServer(ipv4Any(443), WebSocketServerOptions(tls = tls))
//
// No OpenSSL and no libc: each connection is a TlsServerSession over the accepted
// socket. Connections negotiate TLS 1.2 or later; a peer that closes TCP without
// close_notify reads as a close. Create the configuration once: it lives as
// long as the program, and each server holds a reference of its own.

import "abla/websocket/server"
import "abla/tls/pure"
import "abla/tls/pure/server"
import "abla/sys/linux"

// The configurations, by the id the WebSocketServerTls carries as its `context`, with their reference counts; and the
// sessions, by the descriptor they run over plus one (0 is "no session"). One event loop drives them.
class WebSocketServerTlsEntry(val id: int, val config: TlsServerConfig, var references: int)

/// Holds TLS server configurations and their reference counts.
val webSocketServerTlsConfigs: array<WebSocketServerTlsEntry> = []
/// Holds active TLS sessions in the same order as their handles.
val webSocketServerTlsSessions: array<TlsServerSession> = []
/// Holds the descriptor-based handles indexing the active TLS sessions.
val webSocketServerTlsHandles: array<int> = []
/// Holds the next ID to assign to a server TLS configuration.
var webSocketServerTlsNextId = 1

// Reads a certificate chain (leaf first) and its private key from PEM files,
// such as an ACME client's fullchain.pem and privkey.pem.
fun webSocketServerTls(
    certificatePath: string,
    privateKeyPath: string,
    handshakeTimeoutMilliseconds: int = 5000
): WebSocketServerTls = webSocketServerTlsPem(
    webSocketServerTlsFile(certificatePath), webSocketServerTlsFile(privateKeyPath), handshakeTimeoutMilliseconds
)

// Same, from PEM text already in memory.
fun webSocketServerTlsPem(
    certificatePem: string,
    privateKeyPem: string,
    handshakeTimeoutMilliseconds: int = 5000
): WebSocketServerTls {
    val config = tlsServerConfigFromPem(certificatePem, privateKeyPem)
    webSocketServerTlsFor(config, if (config != null) "" else
        (if (tlsServerPemError(certificatePem, privateKeyPem) == "certificate") "TLS certificate failed to load"
            else "TLS private key failed to load"),
        handshakeTimeoutMilliseconds)
}

// As webSocketServerTlsPem for a server with several certificates, chosen by the client's server name (SNI) and signature algorithms
// (tlsServerConfigFromPems: the first entry is the default, a name's ECDSA entry before its RSA one).
fun webSocketServerTlsPems(
    entries: array<TlsServerPem>,
    handshakeTimeoutMilliseconds: int = 5000
): WebSocketServerTls = webSocketServerTlsFor(tlsServerConfigFromPems(entries),
    "TLS certificate or private key failed to load", handshakeTimeoutMilliseconds)

private fun webSocketServerTlsFor(
    config: TlsServerConfig?,
    failure: string,
    handshakeTimeoutMilliseconds: int
): WebSocketServerTls {
    var error = ""
    var context = 0
    if (config == null) {
        error = failure
    } else {
        context = webSocketServerTlsNextId
        webSocketServerTlsNextId = webSocketServerTlsNextId + 1
        webSocketServerTlsConfigs.append(WebSocketServerTlsEntry(context, config, 1))
    }
    WebSocketServerTls(
        context, error, handshakeTimeoutMilliseconds,
        webSocketServerTlsStart, webSocketServerTlsHandshake,
        webSocketServerTlsRead, webSocketServerTlsWrite,
        webSocketServerTlsPending, webSocketServerTlsFree,
        webSocketServerTlsRetain, webSocketServerTlsRelease
    )
}

private fun webSocketServerTlsFile(path: string): string = linuxReadFile(path, 1048576)

private fun webSocketServerTlsConfigIndex(context: int): int {
    var at = 0
    while (at < webSocketServerTlsConfigs.size) {
        if (webSocketServerTlsConfigs[at].id == context) return at
        at = at + 1
    }
    -1
}

private fun webSocketServerTlsIndex(session: int): int {
    var at = 0
    while (at < webSocketServerTlsHandles.size) {
        if (webSocketServerTlsHandles[at] == session) return at
        at = at + 1
    }
    -1
}

// 1 progress or done, 2 wants the socket readable, 3 writable: the TLS_IO statuses as the server's wait values.
fun webSocketServerTlsStatus(status: int, failure: int): int = when (status) {
    2 -> webSocketServerTlsWantsRead
    3 -> webSocketServerTlsWantsWrite
    else -> failure
}

/// Starts a TLS session on the descriptor and returns its handle, or zero on failure.
fun webSocketServerTlsStart(context: int, descriptor: int): int {
    val at = webSocketServerTlsConfigIndex(context)
    if (at < 0 || descriptor < 0) return 0
    val session = tlsServerSession(webSocketServerTlsConfigs[at].config, descriptor, true)
    if (!session.ok()) return 0
    val handle = descriptor + 1
    webSocketServerTlsHandles.append(handle)
    webSocketServerTlsSessions.append(move(session))
    handle
}

/// Advances the handshake and returns success, a readiness request or a negative failure status.
fun webSocketServerTlsHandshake(session: int): int {
    val at = webSocketServerTlsIndex(session)
    if (at < 0) return -5
    val status = webSocketServerTlsSessions[at].handshake()
    if (status == 1) 1 else webSocketServerTlsStatus(status, -5)
}

/// Fills the output with readable bytes or a status for EOF, required readiness or failure.
fun webSocketServerTlsRead(session: int, var result: WebSocketServerRead): void {
    result.text = ""
    val at = webSocketServerTlsIndex(session)
    if (at < 0) {
        result.status = -5
        return
    }
    val read = webSocketServerTlsSessions[at].readReady(16384)
    if (read.status == 1 && read.bytes.size > 0) {
        result.text = read.bytes
        result.status = read.bytes.size
    } else {
        // 0 is the peer closing (cleanly, or by ending the TCP stream).
        result.status = if (read.status == 0) 0 else webSocketServerTlsStatus(read.status, -5)
    }
    return
}

// Writes at most one record. A retry after a pending write passes the same bytes at the same offset.
fun webSocketServerTlsWrite(session: int, contents: string, offset: int): int {
    val at = webSocketServerTlsIndex(session)
    if (at < 0) return -32
    val sent = webSocketServerTlsSessions[at].writeReady(contents, offset)
    if (sent.status == 1 && sent.written > 0) sent.written
    else webSocketServerTlsStatus(sent.status, -32)
}

/// Returns whether the session already has bytes buffered for a read.
fun webSocketServerTlsPending(session: int): bool {
    val at = webSocketServerTlsIndex(session)
    at >= 0 && webSocketServerTlsSessions[at].hasPending()
}

// With `notify` close_notify is offered once; the server closes the socket itself.
fun webSocketServerTlsFree(session: int, notify: bool): void {
    val at = webSocketServerTlsIndex(session)
    if (at < 0) return
    webSocketServerTlsHandles.takeAt(at)
    var ended = webSocketServerTlsSessions.takeAt(at)
    if (notify) ended.close() else ended.discard()
    return
}

/// Increases the configuration's reference count and returns false for an unknown context.
fun webSocketServerTlsRetain(context: int): bool {
    val at = webSocketServerTlsConfigIndex(context)
    if (at < 0) return false
    webSocketServerTlsConfigs[at].references = webSocketServerTlsConfigs[at].references + 1
    true
}

// The last reference clears the private key.
fun webSocketServerTlsRelease(context: int): void {
    val at = webSocketServerTlsConfigIndex(context)
    if (at < 0) return
    webSocketServerTlsConfigs[at].references = webSocketServerTlsConfigs[at].references - 1
    if (webSocketServerTlsConfigs[at].references <= 0) {
        val entry = webSocketServerTlsConfigs.takeAt(at)
        tlsServerConfigWipe(entry.config)
    }
    return
}
