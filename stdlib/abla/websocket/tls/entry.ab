// WSS client built from the shared RFC 6455 codec and pure Abla TLS.

import "abla/random/hosted"
import "abla/tls/pure"
import "abla/websocket"
import "abla/crypto"
import "abla/http"
import "abla/sys/linux/process"

/// Owns the TLS stream and frame buffer for a WebSocket client connection.
resource class TlsWebSocketConnection(
    val stream: TlsConnection,
    var buffered: string,
    // The key the first version masked every frame with; each frame now takes a fresh one (frameMask). Kept for the constructor's shape.
    val maskingKey: string,
    var closed: bool,
    var readTimeoutMilliseconds: int = 0,
    val writeTimeoutMilliseconds: int = 0,
    // Random bytes for the masking keys of the frames to come (RFC 6455 5.3: a fresh key per frame), drawn 256 at a time, and how many are used.
    var maskPool: string = "",
    var maskUsed: int = 0
)

private fun webSocketTlsClientConfigured(
    host: string,
    path: string,
    port: int,
    timeoutMilliseconds: int,
    caPath: string
): TlsWebSocketConnection {
    // The upgrade request is written from `host` and `path` as they are: a part with a space or a control byte (a CR LF would start another
    // header or request) is refused before anything is connected or sent (httpClientRequestError).
    val stream = if (httpClientRequestError("GET", path, host, []) != "") tlsFailedConnection() else if (caPath == "") tlsConnect(
        host, port, timeoutMilliseconds, timeoutMilliseconds
    ) else tlsConnectWithCa(
        host, caPath, port, timeoutMilliseconds, timeoutMilliseconds
    )
    val entropy = hostedSecureRandomBytes(20)
    var mask = "mask"
    var key = ""
    if (entropy.succeeded) {
        mask = entropy.bytes.slice(0, 4)
        key = base64Encode(entropy.bytes.slice(4, 20))
    }
    if (stream.handle != -1 && key != "") {
        val authority = if (port == 443) host else "$host:$port"
        val request =
            "GET $path HTTP/1.1\r\nHost: $authority\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: $key\r\nSec-WebSocket-Version: 13\r\n\r\n"
        if (stream.write(request) == request.size) {
            var response = ""
            var headerEnd = -1
            // The whole upgrade response is bounded by the same limit as the connection (not a limit per read: a server that sends a byte at a time would hold it for 64 KiB of reads).
            val responseStarted = linuxMonotonicMilliseconds()
            while (headerEnd < 0 && response.size < 65536 &&
                   (timeoutMilliseconds <= 0 || linuxMonotonicMilliseconds() - responseStarted < timeoutMilliseconds)) {
                val chunk = stream.read(65536 - response.size)
                if (chunk == "") headerEnd = response.size
                else {
                    response = "$response$chunk"
                    headerEnd = httpHeaderEnd(response)
                }
            }
            val expected = webSocketAccept(key)
            val parsed = httpParseResponse(response)
            if (parsed.response.status == 101 &&
                parsed.response.header("Sec-WebSocket-Accept") == expected) {
                // Waiting for a frame can last as long as the conversation
                // stays quiet; a write keeps its limit.
                stream.setTimeouts(0, timeoutMilliseconds)
                return TlsWebSocketConnection(
                    move(stream),
                    if (headerEnd >= 0) response.slice(
                        headerEnd, response.size
                    ) else "",
                    mask,
                    false,
                    0,
                    timeoutMilliseconds
                )
            }
        }
    }
    stream.close()
    TlsWebSocketConnection(move(stream), "", mask, true)
}

/// Connects to a WebSocket server over verified TLS and returns a closed connection if the handshake fails.
fun webSocketTlsClient(
    host: string,
    path: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000
): TlsWebSocketConnection = webSocketTlsClientConfigured(
    host, path, port, timeoutMilliseconds, ""
)

/// Connects using the supplied CA file and returns a closed connection if TLS or WebSocket setup fails.
fun webSocketTlsClientWithCa(
    host: string,
    path: string,
    caPath: string,
    port: int = 443,
    timeoutMilliseconds: int = 5000
): TlsWebSocketConnection = webSocketTlsClientConfigured(
    host, path, port, timeoutMilliseconds, caPath
)

/** A fresh, unpredictable masking key for one frame (RFC 6455 5.3: the key of each frame must not be predictable from the ones before), or "" when the
 *  system gives no random bytes: then nothing is sent. */
private fun TlsWebSocketConnection.frameMask(): string {
    if (this.maskUsed + 4 > this.maskPool.size) {
        val entropy = hostedSecureRandomBytes(256)
        if (!entropy.succeeded || entropy.bytes.size != 256) return ""
        this.maskPool = entropy.bytes
        this.maskUsed = 0
    }
    val mask = this.maskPool.slice(this.maskUsed, this.maskUsed + 4)
    this.maskUsed = this.maskUsed + 4
    mask
}

/// Sends one masked text frame and returns false for invalid UTF-8, a closed connection or a failed write.
fun TlsWebSocketConnection.sendText(payload: string): bool {
    val mask = this.frameMask()
    if (mask == "") return false
    val frame = webSocketEncodeFrame(payload, 1, true, mask)
    !this.closed && webSocketUtf8Valid(payload) &&
        this.stream.write(frame) == frame.size
}

/// Sends one masked binary frame and returns false if the connection is closed or the write fails.
fun TlsWebSocketConnection.sendBinary(payload: string): bool {
    val mask = this.frameMask()
    if (mask == "") return false
    val frame = webSocketEncodeFrame(payload, 2, true, mask)
    !this.closed && this.stream.write(frame) == frame.size
}

/// Limits how long a read waits, for every later `readFrame` that does not name its own limit: the whole wait for a frame, from the call to its last byte, so a
/// peer that sends a byte at a time cannot hold the reader for ever. 0 (the default) waits as long as it takes, which suits a connection that may stay quiet.
fun TlsWebSocketConnection.setReadTimeout(milliseconds: int): void {
    this.readTimeoutMilliseconds = if (milliseconds < 0) 0 else milliseconds
}

/// Reads the next WebSocket frame and reports a parse error, end of stream or (with a limit) a timeout when unsuccessful. `timeoutMilliseconds` bounds the
/// whole wait for the frame (-1, the default, takes the connection's setReadTimeout limit; 0 waits as long as it takes); a frame that is not complete in time
/// is `timedOut`, the connection stays open and the call can be repeated (the bytes read stay buffered).
fun TlsWebSocketConnection.readFrame(
    maximumPayload: int = 1048576,
    timeoutMilliseconds: int = -1
): WebSocketReadResult {
    var decoded = webSocketDecodeFrame(this.buffered, maximumPayload, false)
    var eof = false
    var timedOut = false
    val limit = if (timeoutMilliseconds < 0) this.readTimeoutMilliseconds else timeoutMilliseconds
    val started = linuxMonotonicMilliseconds()
    var limited = false
    while (!decoded.complete && !eof && !timedOut && !this.closed) {
        if (limit > 0) {
            val left = started + limit - linuxMonotonicMilliseconds()
            if (left <= 0) {
                timedOut = true
            } else {
                limited = this.stream.setTimeouts(left, this.writeTimeoutMilliseconds)
            }
        }
        if (!timedOut) {
            val chunk = this.stream.read(65536)
            if (chunk == "") {
                if (limit > 0 && tlsLastError() == "TLS read or write timed out") timedOut = true
                else eof = true
            } else {
                this.buffered = "${this.buffered}$chunk"
                decoded = webSocketDecodeFrame(
                    this.buffered, maximumPayload, false
                )
            }
        }
    }
    if (decoded.succeeded()) {
        this.buffered = this.buffered.slice(
            decoded.consumed, this.buffered.size
        )
    }
    if (limited) this.stream.setTimeouts(0, this.writeTimeoutMilliseconds)
    if (eof) this.closed = true
    // RFC 6455 5.1: a client fails the connection on a masked frame from the server.
    if (decoded.succeeded() && decoded.frame.masked) {
        this.stream.close()
        this.closed = true
        return WebSocketReadResult(decoded.frame, false, true, false, "a server frame must not be masked")
    }
    WebSocketReadResult(
        decoded.frame, decoded.succeeded(), eof, timedOut, decoded.error
    )
}

/// Closes the TLS connection after trying to send a normal WebSocket close frame and reports whether sending succeeded.
fun TlsWebSocketConnection.close(): bool {
    var result = this.closed
    if (!this.closed) {
        // No close frame without a fresh masking key (a client never sends an unmasked frame); the connection is closed either way.
        val mask = this.frameMask()
        val frame = if (mask == "") "" else webSocketEncodeFrame(webSocketClosePayload(1000, ""), 8, true, mask)
        result = frame != "" && this.stream.write(frame) == frame.size
        this.stream.close()
        this.closed = true
    }
    result
}
