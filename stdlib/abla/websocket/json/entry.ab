// Optional bounded JSON messages over WebSocket text frames.

import "abla/json"
import "abla/websocket"

class WebSocketJsonMessage(
    val value: Json,
    val available: bool,
    val closed: bool,
    val timedOut: bool,
    val error: string
)

fun WebSocketConnection.sendJson(value: Json): bool =
    this.sendText(jsonStringify(value))

fun WebSocketConnection.readJson(
    limits: JsonLimits = jsonDefaultLimits(),
    timeoutMilliseconds: int = 30000
): WebSocketJsonMessage {
    val message = this.readMessage(
        limits.maximumBytes, timeoutMilliseconds
    )
    var value = jsonNull()
    var available = false
    var error = message.error
    if (message.available && message.kind != "text") {
        error = "JSON message must use a text frame"
    } else if (message.available) {
        val parsed = jsonParse(message.payload, limits)
        if (parsed.succeeded) {
            value = parsed.value
            available = true
        } else error = "invalid JSON WebSocket message"
    }
    WebSocketJsonMessage(
        value, available, message.closed, message.timedOut, error
    )
}
