// Small JSON RPC router transported by `abla/websocket`. It intentionally
// keeps transport and dispatch separate so generated `@rpc` adapters can emit
// the same route table without owning the WebSocket implementation.

import "abla/json"
import "abla/websocket"
import "abla/websocket/json"

class WebSocketRpcRoute(
    val method: string,
    val handler: (Json) -> Json
)

class WebSocketRpcRouter(val routes: array<WebSocketRpcRoute>)

fun webSocketRpcRouter(): WebSocketRpcRouter = WebSocketRpcRouter([])

fun WebSocketRpcRouter.route(
    method: string,
    handler: (Json) -> Json
): WebSocketRpcRouter {
    if (method != "") this.routes.append(WebSocketRpcRoute(method, handler))
    this
}

fun webSocketRpcError(
    id: Json,
    code: string,
    message: string
): Json = jsonObject(
    ["id", "error"],
    [id, jsonObject(
        ["code", "message"],
        [jsonString(code), jsonString(message)]
    )]
)

fun WebSocketRpcRouter.dispatch(request: Json): Json {
    val id = request.get("id")
    val method = request.getString("method")
    var selected = -1
    var index = 0
    while (selected < 0 && index < this.routes.size) {
        if (this.routes[index].method == method) selected = index
        index = index + 1
    }
    var response = webSocketRpcError(
        id, "method_not_found", "RPC method was not found"
    )
    if (!request.isObject() || method == "") {
        response = webSocketRpcError(
            id, "invalid_request", "RPC request needs a method"
        )
    } else if (selected >= 0) {
        val handler = this.routes[selected].handler
        response = jsonObject(
            ["id", "result"],
            [id, handler(request.get("params"))]
        )
    }
    response
}

fun WebSocketRpcRouter.serveNext(
    var connection: WebSocketConnection,
    limits: JsonLimits = jsonDefaultLimits(),
    timeoutMilliseconds: int = 30000
): bool {
    val request = connection.readJson(limits, timeoutMilliseconds)
    request.available && connection.sendJson(this.dispatch(request.value))
}
