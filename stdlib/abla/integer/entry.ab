// Integer operations whose exact semantics are useful to LLVM and every
// native target. They are language-level operations, not platform assembly.

noescape extern:"intrinsic" fun ablaCountLeadingZerosU32(value: u32): u32

fun u32.countLeadingZeros(): u32 = ablaCountLeadingZerosU32(this)

/** Parses a signed decimal int, or null for invalid text or overflow. */
fun string.parseInt(): int? {
    if (this.size == 0) return null
    val negative = this[0] == 45
    var index = if (negative || this[0] == 43) 1 else 0
    if (index == this.size) return null
    // Accumulate negatively so the minimum int is representable throughout.
    var value = 0
    val last = if (negative) 8 else 7
    while (index < this.size) {
        val digit = this[index] - 48
        if (digit < 0 || digit > 9) return null
        if (value < -922337203685477580 ||
            (value == -922337203685477580 && digit > last)) return null
        value = value * 10 - digit
        index = index + 1
    }
    if (negative) value else -value
}
