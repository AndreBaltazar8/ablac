// Returns the current member's validated JSON text, or records an error and returns an empty string if the value is invalid or absent.
fun JsonObjectReader.readRaw(): string {
    var value = ""
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
