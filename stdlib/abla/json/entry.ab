// Phase-safe JSON values, strict bounded parsing, deterministic serialization,
// and the `$json` parser provider. Kinds: 0 null, 1 string, 2 number,
// 3 boolean, 4 array, 5 object.

import "abla/bytes"
import "abla/compiler/parser"
import "abla/text"

class JsonNumber(
    val text: string,
    val integer: bool,
    val intValue: int,
    val intAvailable: bool
)

class Json(
    val kind: int,
    val stringValue: string,
    val intValue: int,
    val boolValue: bool,
    val keys: array<string>,
    val values: array<Json>,
    val numberValue: JsonNumber
)

class JsonError(
    val code: string,
    val message: string,
    val byteOffset: int,
    val line: int,
    val column: int
)

class JsonParseResult(
    val value: Json,
    val succeeded: bool,
    val error: JsonError
)

class JsonLimits(
    val maximumBytes: int,
    val maximumDepth: int,
    val maximumNodes: int,
    val maximumStringBytes: int,
    val maximumObjectMembers: int,
    val rejectDuplicateKeys: bool
)

class JsonNumberGrammar(
    val valid: bool,
    val integer: bool
)

class JsonParserState(
    val source: string,
    val limits: JsonLimits,
    var offset: int,
    var nodes: int,
    var errorCode: string,
    var errorMessage: string,
    var errorOffset: int
)

class JsonWriter(
    val output: ByteBuffer,
    var valid: bool
)

// Forward-only, allocation-light object reader. Values are consumed once from
// the source text; callers choose whether to decode a scalar or retain a
// validated raw slice. This complements the tree-shaped `Json` API for hot
// protocol paths that already know their schema.
class JsonObjectReader(
    val state: JsonParserState,
    val keys: array<string>,
    var first: bool,
    var done: bool,
    var expectingValue: bool
)

// Forward-only array companion for schema-aware nested JSON. Object and array
// readers may share one parser state, so nested values are validated exactly
// once without materializing a Json tree or retaining raw substrings.
class JsonArrayReader(
    val state: JsonParserState,
    var first: bool,
    var done: bool,
    var expectingValue: bool
)

// Validated encoded fragments and streaming container builders avoid a
// temporary `Json` object graph during serialization.
class JsonEncoded(val text: string, val valid: bool)

class JsonArrayEncoder(
    val output: ByteBuffer,
    var count: int,
    var valid: bool,
    var finished: bool
)

class JsonObjectEncoder(
    val output: ByteBuffer,
    var count: int,
    var valid: bool,
    var finished: bool
)

// Returns the closing quote for an unescaped, valid UTF-8 JSON string, or -1
// when the input needs the precise escaped-string decoder. This fuses the
// common path's delimiter search and validation into one raw-memory pass.
noescape extern:"intrinsic" fun ablaJsonFindPlainStringEnd(
    value: string,
    begin: int,
    end: int
): int

// Return the offset after a compact `,"name":` (or first-field `"name":`)
// token, or -1 when the source needs the whitespace-aware raw fallback.
// One checked raw-memory pass avoids constructing a slice and then comparing
// that slice through the general string ABI.
noescape extern:"intrinsic" fun ablaJsonMatchCompactObjectField(
    value: string,
    offset: int,
    name: string,
    comma: bool
): int

// Encodes a compact array transition without allocating or repeatedly crossing
// the checked string-index ABI. Zero selects the complete diagnostic path.
noescape extern:"intrinsic" fun ablaJsonCompactArrayNext(
    value: string,
    offset: int,
    first: bool
): int

// Compact signed-64-bit integer decoding uses raw source bytes and returns -1
// for fractions, exponents, malformed grammar, or overflow. Callers retain the
// full scanner as an exact diagnostic fallback for those inputs.
noescape extern:"intrinsic" fun ablaJsonAvailableIntegerEnd(
    value: string,
    begin: int
): int

noescape extern:"intrinsic" fun ablaJsonIntegerValueAt(
    value: string,
    begin: int,
    end: int
): int

noescape extern:"intrinsic" fun ablaJsonWhitespaceEnd(
    value: string,
    begin: int
): int

// Single-buffer streaming serializer. Container state is held in bitsets, so
// nesting does not allocate a DOM node, fragment, or context object.
class JsonEncoder(
    val output: ByteBuffer,
    var depth: int,
    var objectBits: int,
    var nonEmptyBits: int,
    var expectingValueBits: int,
    var rootWritten: bool,
    var valid: bool
)

fun jsonDefaultLimits(): JsonLimits = JsonLimits(
    1048576,
    64,
    100000,
    1048576,
    10000,
    true
)

fun jsonLimitsValid(limits: JsonLimits): bool =
    limits.maximumBytes > 0 && limits.maximumBytes <= 16777216 &&
    limits.maximumDepth > 0 && limits.maximumDepth <= 256 &&
    limits.maximumNodes > 0 && limits.maximumNodes <= 1000000 &&
    limits.maximumStringBytes > 0 &&
    limits.maximumStringBytes <= 16777216 &&
    limits.maximumObjectMembers > 0 &&
    limits.maximumObjectMembers <= 100000

fun jsonEmptyNumber(): JsonNumber = JsonNumber("", false, 0, false)

fun jsonNull(): Json = Json(0, "", 0, false, [], [], jsonEmptyNumber())

fun jsonString(value: string): Json {
    if (value.isValidUtf8()) {
        Json(1, value, 0, false, [], [], jsonEmptyNumber())
    } else jsonNull()
}

fun jsonNumberGrammar(text: string): JsonNumberGrammar {
    var offset = 0
    var valid = text.size > 0
    var integer = true
    if (valid && text[offset] == 45) {
        offset = offset + 1
        if (offset >= text.size) valid = false
    }
    if (valid && text[offset] == 48) {
        offset = offset + 1
        if (offset < text.size && text[offset] >= 48 && text[offset] <= 57) {
            valid = false
        }
    } else if (valid && text[offset] >= 49 && text[offset] <= 57) {
        while (offset < text.size && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
    } else valid = false
    if (valid && offset < text.size && text[offset] == 46) {
        integer = false
        offset = offset + 1
        val fractionBegin = offset
        while (offset < text.size && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == fractionBegin) valid = false
    }
    if (valid && offset < text.size &&
        (text[offset] == 101 || text[offset] == 69)) {
        integer = false
        offset = offset + 1
        if (offset < text.size &&
            (text[offset] == 43 || text[offset] == 45)) {
            offset = offset + 1
        }
        val exponentBegin = offset
        while (offset < text.size && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == exponentBegin) valid = false
    }
    if (offset != text.size) valid = false
    JsonNumberGrammar(valid, valid && integer)
}

fun jsonIntegerTextAvailable(text: string): bool {
    var negative = false
    var begin = 0
    if (text.size > 0 && text[0] == 45) {
        negative = true
        begin = 1
    }
    val digits = text.size - begin
    var available = digits > 0 && digits <= 19
    if (available && digits == 19) {
        val limit = if (negative) "9223372036854775808"
            else "9223372036854775807"
        var index = 0
        var decided = false
        while (index < 19 && !decided) {
            val actual = text[begin + index]
            val maximum = limit[index]
            if (actual < maximum) decided = true
            if (actual > maximum) {
                available = false
                decided = true
            }
            index = index + 1
        }
    }
    available
}

fun jsonIntegerTextValue(text: string): int {
    val negative = text.size > 0 && text[0] == 45
    var offset = if (negative) 1 else 0
    var value = 0
    while (offset < text.size) {
        value = value * 10 - (text[offset] - 48)
        offset = offset + 1
    }
    if (negative) value else -value
}

fun jsonNumberInfo(text: string): JsonNumber {
    val grammar = jsonNumberGrammar(text)
    val available = grammar.valid && grammar.integer &&
        jsonIntegerTextAvailable(text)
    JsonNumber(
        text,
        grammar.integer,
        if (available) jsonIntegerTextValue(text) else 0,
        available
    )
}

fun jsonNumber(value: JsonNumber): Json {
    val checked = jsonNumberInfo(value.text)
    if (jsonNumberGrammar(value.text).valid) {
        Json(
            2,
            "",
            checked.intValue,
            false,
            [],
            [],
            checked
        )
    } else jsonNull()
}

fun jsonNumberText(value: string): Json = jsonNumber(jsonNumberInfo(value))

fun jsonInteger(value: int): Json = jsonNumberText("$value")

fun jsonBoolean(value: bool): Json =
    Json(3, "", 0, value, [], [], jsonEmptyNumber())

fun jsonArray(values: array<Json>): Json =
    Json(4, "", 0, false, [], values, jsonEmptyNumber())

fun jsonObject(keys: array<string>, values: array<Json>): Json {
    var valid = keys.size == values.size
    var index = 0
    while (valid && index < keys.size) {
        valid = keys[index].isValidUtf8()
        index = index + 1
    }
    if (valid) Json(5, "", 0, false, keys, values, jsonEmptyNumber())
    else jsonNull()
}

// Compatibility constructors retained for existing `$json` consumers.
fun ablaJsonNull(): Json = jsonNull()
fun ablaJsonString(value: string): Json = jsonString(value)
fun ablaJsonInteger(value: int): Json = jsonInteger(value)
fun ablaJsonNumberText(value: string): Json = jsonNumberText(value)
fun ablaJsonBoolean(value: bool): Json = jsonBoolean(value)
fun ablaJsonArray(values: array<Json>): Json = jsonArray(values)
fun ablaJsonObject(keys: array<string>, values: array<Json>): Json =
    jsonObject(keys, values)

fun Json.isNull(): bool = this.kind == 0
fun Json.isString(): bool = this.kind == 1
fun Json.isNumber(): bool = this.kind == 2
fun Json.isBoolean(): bool = this.kind == 3
fun Json.isArray(): bool = this.kind == 4
fun Json.isObject(): bool = this.kind == 5
fun Json.asString(): string = if (this.kind == 1) this.stringValue else ""
fun Json.asBoolean(): bool = this.kind == 3 && this.boolValue
fun Json.asNumber(): JsonNumber =
    if (this.kind == 2) this.numberValue else jsonEmptyNumber()
fun Json.asInt(): int =
    if (this.kind == 2 && this.numberValue.intAvailable) this.intValue else 0
fun Json.intAvailable(): bool =
    this.kind == 2 && this.numberValue.intAvailable

fun Json.get(key: string): Json {
    var value = jsonNull()
    var found = false
    var index = if (this.keys.size < this.values.size) {
        this.keys.size
    } else this.values.size
    while (!found && index > 0) {
        index = index - 1
        val candidate = this.keys[index]
        val possible = candidate.size == key.size &&
            (key.size == 0 || candidate[0] == key[0])
        if (possible && candidate == key) {
            value = this.values[index]
            found = true
        }
    }
    value
}

fun Json.has(key: string): bool {
    var found = false
    var index = 0
    while (!found && index < this.keys.size) {
        if (this.keys[index] == key) found = true
        index = index + 1
    }
    found
}

fun Json.size(): int {
    if (this.kind == 4) this.values.size
    else if (this.kind == 5) this.keys.size
    else 0
}

fun Json.at(index: int): Json = this.values[index]

fun Json.getString(key: string): string = this.get(key).asString()

fun Json.getInt(key: string): int = this.get(key).asInt()

fun JsonParserState.fail(
    code: string,
    message: string,
    offset: int
): void {
    if (this.errorCode.size == 0) {
        this.errorCode = code
        this.errorMessage = message
        this.errorOffset = offset
    }
}

fun jsonSkipWhitespace(var state: JsonParserState): void {
    state.offset = ablaJsonWhitespaceEnd(state.source, state.offset)
    return
}

fun jsonHexValue(byte: int): int {
    var value = -1
    if (byte >= 48 && byte <= 57) value = byte - 48
    if (byte >= 65 && byte <= 70) value = byte - 65 + 10
    if (byte >= 97 && byte <= 102) value = byte - 97 + 10
    value
}

fun jsonHexQuad(source: string, offset: int): int {
    var value = 0
    var valid = offset >= 0 && offset + 4 <= source.size
    var index = 0
    while (valid && index < 4) {
        val digit = jsonHexValue(source[offset + index])
        if (digit < 0) valid = false
        if (digit >= 0) value = value * 16 + digit
        index = index + 1
    }
    if (valid) value else -1
}

fun jsonParseEscapedString(
    var state: JsonParserState,
    quoteOffset: int,
    contentBegin: int
): string {
    val output = byteBuffer()
    if (state.offset > contentBegin) output.appendText(
        state.source.slice(contentBegin, state.offset)
    )
    var closed = false
    while (state.errorCode.size == 0 && !closed &&
           state.offset < state.source.size) {
        val byte = state.source[state.offset]
        if (byte == 34) {
            closed = true
            state.offset = state.offset + 1
        } else if (byte == 92) {
            val escapeOffset = state.offset
            state.offset = state.offset + 1
            if (state.offset >= state.source.size) {
                state.fail(
                    "unexpected_end", "unterminated JSON escape", state.offset
                )
            } else {
                val escaped = state.source[state.offset]
                state.offset = state.offset + 1
                if (escaped == 34) output.appendText("\"")
                else if (escaped == 92) output.appendText("\\")
                else if (escaped == 47) output.appendText("/")
                else if (escaped == 98) output.appendText(utf8Encode(8))
                else if (escaped == 102) output.appendText(utf8Encode(12))
                else if (escaped == 110) output.appendText("\n")
                else if (escaped == 114) output.appendText("\r")
                else if (escaped == 116) output.appendText("\t")
                else if (escaped == 117) {
                    val unicodeOffset = state.offset
                    var scalar = jsonHexQuad(state.source, state.offset)
                    if (scalar < 0) {
                        state.fail(
                            "invalid_unicode",
                            "invalid JSON Unicode escape",
                            unicodeOffset
                        )
                    } else {
                        state.offset = state.offset + 4
                        if (scalar >= 55296 && scalar <= 56319) {
                            if (state.offset + 6 <= state.source.size &&
                                state.source[state.offset] == 92 &&
                                state.source[state.offset + 1] == 117) {
                                val low = jsonHexQuad(
                                    state.source, state.offset + 2
                                )
                                if (low >= 56320 && low <= 57343) {
                                    scalar = 65536 + (scalar - 55296) * 1024 +
                                        low - 56320
                                    state.offset = state.offset + 6
                                } else state.fail(
                                    "invalid_unicode",
                                    "invalid JSON surrogate pair",
                                    state.offset
                                )
                            } else state.fail(
                                "invalid_unicode",
                                "missing JSON low surrogate",
                                state.offset
                            )
                        } else if (scalar >= 56320 && scalar <= 57343) {
                            state.fail(
                                "invalid_unicode",
                                "unexpected JSON low surrogate",
                                unicodeOffset
                            )
                        }
                        if (state.errorCode.size == 0) {
                            output.appendText(utf8Encode(scalar))
                        }
                    }
                } else state.fail(
                    "invalid_escape", "invalid JSON string escape", escapeOffset
                )
            }
        } else if (byte < 32) {
            state.fail(
                "unexpected_token",
                "unescaped control byte in JSON string",
                state.offset
            )
        } else if (byte < 128) {
            output.appendText(state.source.slice(state.offset, state.offset + 1))
            state.offset = state.offset + 1
        } else {
            val length = utf8SequenceLength(byte)
            if (!utf8SequenceValid(state.source, state.offset, length)) {
                state.fail(
                    "invalid_unicode", "invalid UTF-8 in JSON string", state.offset
                )
            } else {
                output.appendText(state.source.slice(
                    state.offset, state.offset + length
                ))
                state.offset = state.offset + length
            }
        }
        if (state.errorCode.size == 0 &&
            output.size() > state.limits.maximumStringBytes) {
            state.fail(
                "string_limit", "JSON string exceeds configured limit", quoteOffset
            )
        }
    }
    if (state.errorCode.size == 0 && !closed) {
        state.fail(
            "unexpected_end", "unterminated JSON string", state.source.size
        )
    }
    output.toText()
}

fun jsonParseStringFallback(
    var state: JsonParserState,
    quoteOffset: int,
    contentBegin: int
): string {
    state.offset = contentBegin
    var scanning = state.errorCode.size == 0
    var closed = false
    while (scanning && state.offset < state.source.size) {
        val byte = state.source[state.offset]
        if (byte == 34) {
            closed = true
            scanning = false
        } else if (byte == 92 || byte < 32) scanning = false
        else if (byte < 128) state.offset = state.offset + 1
        else {
            val length = utf8SequenceLength(byte)
            if (!utf8SequenceValid(state.source, state.offset, length)) {
                state.fail(
                    "invalid_unicode", "invalid UTF-8 in JSON string",
                    state.offset
                )
                scanning = false
            } else state.offset = state.offset + length
        }
        if (state.errorCode.size == 0 &&
            state.offset - contentBegin > state.limits.maximumStringBytes) {
            state.fail(
                "string_limit", "JSON string exceeds configured limit",
                quoteOffset
            )
            scanning = false
        }
    }
    if (closed && state.errorCode.size == 0) {
        val result = state.source.slice(contentBegin, state.offset)
        state.offset = state.offset + 1
        result
    } else jsonParseEscapedString(
        state, quoteOffset, contentBegin
    )
}

fun jsonParseString(var state: JsonParserState): string {
    val quoteOffset = state.offset
    if (state.offset < state.source.size && state.source[state.offset] == 34) {
        state.offset = state.offset + 1
    } else state.fail("unexpected_token", "expected JSON string", state.offset)
    val contentBegin = state.offset
    // Keep the overwhelmingly common unescaped path in a small function. The
    // precise escape and Unicode diagnostics live out of line so they do not
    // force their large temporary state into every ordinary string read.
    val plainEnd = if (state.errorCode.size == 0) ablaJsonFindPlainStringEnd(
        state.source, contentBegin, state.source.size
    ) else -1
    if (plainEnd >= contentBegin &&
        plainEnd - contentBegin <= state.limits.maximumStringBytes) {
        val result = state.source.slice(contentBegin, plainEnd)
        state.offset = plainEnd + 1
        result
    } else jsonParseStringFallback(state, quoteOffset, contentBegin)
}

fun jsonParseNumber(var state: JsonParserState): Json {
    val begin = state.offset
    var scanning = true
    while (scanning && state.offset < state.source.size) {
        val byte = state.source[state.offset]
        scanning = (byte >= 48 && byte <= 57) || byte == 45 ||
            byte == 43 || byte == 46 || byte == 101 || byte == 69
        if (scanning) state.offset = state.offset + 1
    }
    val text = state.source.slice(begin, state.offset)
    val grammar = jsonNumberGrammar(text)
    if (!grammar.valid) {
        state.fail("invalid_number", "invalid JSON number", begin)
        jsonNull()
    } else jsonNumberText(text)
}

fun jsonParseValue(var state: JsonParserState, depth: int): Json {
    jsonSkipWhitespace(state)
    var result = jsonNull()
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail("depth_limit", "JSON nesting exceeds configured limit", state.offset)
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) {
            state.fail("node_limit", "JSON node count exceeds configured limit", state.offset)
        }
    }
    if (state.errorCode.size == 0 && state.offset >= state.source.size) {
        state.fail("unexpected_end", "expected JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        val byte = state.source[state.offset]
        if (byte == 34) result = jsonString(jsonParseString(state))
        else if (byte == 91) {
            state.offset = state.offset + 1
            val values: array<Json> = []
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 93) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                values.append(jsonParseValue(state, depth + 1))
                jsonSkipWhitespace(state)
                if (state.offset >= state.source.size) {
                    state.fail(
                        "unexpected_end", "unterminated JSON array", state.offset
                    )
                } else if (state.source[state.offset] == 93) {
                    state.offset = state.offset + 1
                    closed = true
                } else if (state.source[state.offset] == 44) {
                    state.offset = state.offset + 1
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 93) {
                        state.fail(
                            "unexpected_token",
                            "trailing comma in JSON array",
                            state.offset
                        )
                    }
                } else state.fail(
                    "unexpected_token",
                    "expected comma or closing bracket",
                    state.offset
                )
            }
            result = jsonArray(values)
        } else if (byte == 123) {
            state.offset = state.offset + 1
            val keys: array<string> = []
            val values: array<Json> = []
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 125) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                if (state.offset >= state.source.size) {
                    state.fail(
                        "unexpected_end", "unterminated JSON object", state.offset
                    )
                } else if (state.source[state.offset] != 34) {
                    state.fail(
                        "unexpected_token",
                        "JSON object key must be a string",
                        state.offset
                    )
                }
                var key = ""
                if (state.errorCode.size == 0) key = jsonParseString(state)
                if (state.errorCode.size == 0 &&
                    keys.size >= state.limits.maximumObjectMembers) {
                    state.fail(
                        "node_limit",
                        "JSON object member count exceeds configured limit",
                        state.offset
                    )
                }
                var duplicate = false
                var keyIndex = 0
                while (keyIndex < keys.size) {
                    if (keys[keyIndex] == key) duplicate = true
                    keyIndex = keyIndex + 1
                }
                if (state.errorCode.size == 0 && duplicate &&
                    state.limits.rejectDuplicateKeys) {
                    state.fail(
                        "duplicate_key", "duplicate JSON object key", state.offset
                    )
                }
                jsonSkipWhitespace(state)
                if (state.errorCode.size == 0 &&
                    (state.offset >= state.source.size ||
                     state.source[state.offset] != 58)) {
                    state.fail(
                        "unexpected_token",
                        "expected colon after JSON object key",
                        state.offset
                    )
                }
                if (state.errorCode.size == 0) state.offset = state.offset + 1
                var value = jsonNull()
                if (state.errorCode.size == 0) {
                    value = jsonParseValue(state, depth + 1)
                }
                if (state.errorCode.size == 0) {
                    keys.append(key)
                    values.append(value)
                }
                jsonSkipWhitespace(state)
                if (state.errorCode.size == 0 &&
                    state.offset >= state.source.size) {
                    state.fail(
                        "unexpected_end", "unterminated JSON object", state.offset
                    )
                } else if (state.errorCode.size == 0 &&
                    state.source[state.offset] == 125) {
                    state.offset = state.offset + 1
                    closed = true
                } else if (state.errorCode.size == 0 &&
                    state.source[state.offset] == 44) {
                    state.offset = state.offset + 1
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 125) {
                        state.fail(
                            "unexpected_token",
                            "trailing comma in JSON object",
                            state.offset
                        )
                    }
                } else if (state.errorCode.size == 0) state.fail(
                    "unexpected_token",
                    "expected comma or closing brace",
                    state.offset
                )
            }
            result = jsonObject(keys, values)
        } else if ((byte >= 48 && byte <= 57) || byte == 45 || byte == 43) {
            result = jsonParseNumber(state)
        } else if (state.offset + 4 <= state.source.size &&
            state.source.slice(state.offset, state.offset + 4) == "true") {
            state.offset = state.offset + 4
            result = jsonBoolean(true)
        } else if (state.offset + 5 <= state.source.size &&
            state.source.slice(state.offset, state.offset + 5) == "false") {
            state.offset = state.offset + 5
            result = jsonBoolean(false)
        } else if (state.offset + 4 <= state.source.size &&
            state.source.slice(state.offset, state.offset + 4) == "null") {
            state.offset = state.offset + 4
            result = jsonNull()
        } else state.fail(
            "unexpected_token", "unexpected token in JSON input", state.offset
        )
    }
    result
}

fun jsonErrorLocation(source: string, offset: int): array<int> {
    var line = 1
    var column = 1
    var index = 0
    while (index < offset && index < source.size) {
        if (source[index] == 10) {
            line = line + 1
            column = 1
        } else column = column + 1
        index = index + 1
    }
    [line, column]
}

fun jsonParse(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonParseResult {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits)) {
        state.fail("input_limit", "invalid JSON parser limits", 0)
    }
    if (state.errorCode.size == 0 && source.size > limits.maximumBytes) {
        state.fail(
            "input_limit", "JSON input exceeds configured byte limit",
            limits.maximumBytes
        )
    }
    if (state.errorCode.size == 0) {
        val utf8 = utf8Info(source)
        if (!utf8.valid) {
            state.fail("invalid_unicode", "JSON input is not valid UTF-8", utf8.errorOffset)
        }
    }
    var value = jsonNull()
    if (state.errorCode.size == 0) value = jsonParseValue(state, 1)
    jsonSkipWhitespace(state)
    if (state.errorCode.size == 0 && state.offset != source.size) {
        state.fail("trailing_input", "trailing input after JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        JsonParseResult(value, true, JsonError("", "", 0, 1, 1))
    } else {
        val location = jsonErrorLocation(source, state.errorOffset)
        JsonParseResult(
            jsonNull(),
            false,
            JsonError(
                state.errorCode,
                state.errorMessage,
                state.errorOffset,
                location[0],
                location[1]
            )
        )
    }
}

fun jsonReaderConsume(var state: JsonParserState, expected: int): bool {
    jsonSkipWhitespace(state)
    val matches = state.errorCode.size == 0 &&
        state.offset < state.source.size &&
        state.source[state.offset] == expected
    if (matches) state.offset = state.offset + 1
    else state.fail(
        "unexpected_token", "unexpected token while reading JSON", state.offset
    )
    matches
}

fun jsonScanNumber(var state: JsonParserState): void {
    val begin = state.offset
    var scanning = true
    while (scanning && state.offset < state.source.size) {
        val byte = state.source[state.offset]
        scanning = (byte >= 48 && byte <= 57) || byte == 45 ||
            byte == 43 || byte == 46 || byte == 101 || byte == 69
        if (scanning) state.offset = state.offset + 1
    }
    if (!jsonNumberGrammar(
        state.source.slice(begin, state.offset)
    ).valid) state.fail("invalid_number", "invalid JSON number", begin)
}

fun jsonScanLiteral(var state: JsonParserState, literal: string): void {
    if (state.offset + literal.size <= state.source.size &&
        state.source.slice(state.offset, state.offset + literal.size) ==
            literal) {
        state.offset = state.offset + literal.size
    } else state.fail(
        "unexpected_token", "unexpected token in JSON input", state.offset
    )
}

// Validate and consume exactly one value without constructing a `Json` tree.
// Strings are decoded only while validating escapes and duplicate object keys;
// the caller may retain the original byte slice through `readRaw` below.
fun jsonScanValue(var state: JsonParserState, depth: int): void {
    jsonSkipWhitespace(state)
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail(
            "depth_limit", "JSON nesting exceeds configured limit", state.offset
        )
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) state.fail(
            "node_limit", "JSON node count exceeds configured limit", state.offset
        )
    }
    if (state.errorCode.size == 0 && state.offset >= state.source.size) {
        state.fail("unexpected_end", "expected JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        val byte = state.source[state.offset]
        if (byte == 34) jsonParseString(state)
        else if (byte == 91) {
            state.offset = state.offset + 1
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 93) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                jsonScanValue(state, depth + 1)
                jsonSkipWhitespace(state)
                if (state.offset < state.source.size &&
                    state.source[state.offset] == 93) {
                    state.offset = state.offset + 1
                    closed = true
                } else {
                    jsonReaderConsume(state, 44)
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 93) state.fail(
                            "unexpected_token", "trailing comma in JSON array",
                            state.offset
                        )
                }
            }
        } else if (byte == 123) {
            state.offset = state.offset + 1
            val keys: array<string> = []
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 125) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                if (keys.size >= state.limits.maximumObjectMembers) state.fail(
                    "node_limit", "JSON object member limit exceeded",
                    state.offset
                )
                val key = jsonParseString(state)
                var duplicate = false
                var index = 0
                while (index < keys.size) {
                    if (keys[index] == key) duplicate = true
                    index = index + 1
                }
                if (duplicate && state.limits.rejectDuplicateKeys) state.fail(
                    "duplicate_key", "duplicate JSON object key", state.offset
                )
                if (state.errorCode.size == 0) keys.append(key)
                jsonReaderConsume(state, 58)
                jsonScanValue(state, depth + 1)
                jsonSkipWhitespace(state)
                if (state.offset < state.source.size &&
                    state.source[state.offset] == 125) {
                    state.offset = state.offset + 1
                    closed = true
                } else {
                    jsonReaderConsume(state, 44)
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 125) state.fail(
                            "unexpected_token", "trailing comma in JSON object",
                            state.offset
                        )
                }
            }
        } else if ((byte >= 48 && byte <= 57) || byte == 45) {
            jsonScanNumber(state)
        } else if (byte == 116) jsonScanLiteral(state, "true")
        else if (byte == 102) jsonScanLiteral(state, "false")
        else if (byte == 110) jsonScanLiteral(state, "null")
        else state.fail(
            "unexpected_token", "unexpected token in JSON input", state.offset
        )
    }
}

fun jsonObjectReader(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonObjectReader {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits) || source.size > limits.maximumBytes) {
        state.fail("input_limit", "invalid JSON input limits", 0)
    }
    // The forward reader validates every consumed string in place. Bytes
    // outside strings must match ASCII JSON tokens, so a redundant whole-input
    // UTF-8 pass would only scan known-schema protocol payloads twice.
    jsonReaderConsume(state, 123)
    JsonObjectReader(state, [], true, false, false)
}

// Advance to the next member and return its decoded key. An empty result is
// unambiguous when `done` is inspected; empty JSON object keys remain valid.
fun JsonObjectReader.next(): string {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    if (this.state.errorCode.size == 0 && !this.done &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 125) {
        this.state.offset = this.state.offset + 1
        this.done = true
    }
    var key = ""
    if (this.state.errorCode.size == 0 && !this.done) {
        if (!this.first) jsonReaderConsume(this.state, 44)
        jsonSkipWhitespace(this.state)
        if (this.state.offset < this.state.source.size &&
            this.state.source[this.state.offset] == 125) {
            this.state.fail(
                "unexpected_token", "trailing comma in JSON object",
                this.state.offset
            )
        }
        if (this.state.errorCode.size == 0) key = jsonParseString(this.state)
        var duplicate = false
        var index = 0
        while (index < this.keys.size) {
            if (this.keys[index] == key) duplicate = true
            index = index + 1
        }
        if (duplicate && this.state.limits.rejectDuplicateKeys) this.state.fail(
            "duplicate_key", "duplicate JSON object key", this.state.offset
        )
        if (this.keys.size >= this.state.limits.maximumObjectMembers) {
            this.state.fail(
                "node_limit", "JSON object member limit exceeded",
                this.state.offset
            )
        }
        if (this.state.errorCode.size == 0) {
            this.keys.append(key)
            jsonReaderConsume(this.state, 58)
            this.expectingValue = true
            this.first = false
        }
    }
    key
}

// Order-sensitive lookup is the fast path for canonical protocols. It still
// parses and unescapes the actual key, but never rewinds or scans for another
// member when the schema order is known.
fun JsonObjectReader.nextExpected(name: string): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    if (!this.first) jsonReaderConsume(this.state, 44)
    jsonSkipWhitespace(this.state)
    var key = ""
    if (this.state.errorCode.size == 0 &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] != 125) {
        key = jsonParseString(this.state)
    } else if (this.state.errorCode.size == 0) this.state.fail(
        "unexpected_end", "expected JSON object field", this.state.offset
    )
    val matches = this.state.errorCode.size == 0 && key == name
    if (!matches && this.state.errorCode.size == 0) this.state.fail(
        "unexpected_token", "unexpected JSON object field", this.state.offset
    )
    if (matches) {
        jsonReaderConsume(this.state, 58)
        this.expectingValue = true
        this.first = false
    }
    matches
}

// Fastest canonical-schema lookup: compare an unescaped key directly in the
// source buffer. Producers using this contract emit ordinary UTF-8 field
// names; escaped spellings of the same key are deliberately rejected.
fun JsonObjectReader.nextExpectedRaw(name: string): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    val originalOffset = this.state.offset
    val compactEnd = if (this.state.errorCode.size == 0) {
        ablaJsonMatchCompactObjectField(
            this.state.source, originalOffset, name, !this.first
        )
    } else -1
    var matches = compactEnd >= 0
    if (matches) {
        this.state.offset = compactEnd
        this.expectingValue = true
        this.first = false
    } else {
        this.state.offset = originalOffset
        if (!this.first) jsonReaderConsume(this.state, 44)
        jsonSkipWhitespace(this.state)
        // The fallback preserves whitespace handling and precise diagnostics.
        matches = this.state.errorCode.size == 0 &&
            this.state.offset < this.state.source.size &&
            this.state.source[this.state.offset] == 34
        if (matches) this.state.offset = this.state.offset + 1
        val begin = this.state.offset
        val end = begin + name.size
        matches = matches && end < this.state.source.size &&
            this.state.source.slice(begin, end) == name &&
            this.state.source[end] == 34
        if (matches) this.state.offset = end + 1
        else if (this.state.errorCode.size == 0) this.state.fail(
            "unexpected_token", "unexpected JSON object field",
            this.state.offset
        )
        if (matches) {
            jsonReaderConsume(this.state, 58)
            this.expectingValue = true
            this.first = false
        }
    }
    matches
}

fun JsonObjectReader.readString(): string {
    var value = ""
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    if (this.state.errorCode.size == 0) value = jsonParseString(this.state)
    this.expectingValue = false
    value
}

fun JsonObjectReader.readInteger(): int {
    var value = 0
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    val begin = this.state.offset
    val fastEnd = if (this.state.errorCode.size == 0) {
        ablaJsonAvailableIntegerEnd(this.state.source, begin)
    } else -1
    if (fastEnd >= begin) {
        this.state.offset = fastEnd
        value = ablaJsonIntegerValueAt(this.state.source, begin, fastEnd)
    } else {
        if (this.state.errorCode.size == 0) jsonScanNumber(this.state)
        val text = this.state.source.slice(begin, this.state.offset)
        val grammar = jsonNumberGrammar(text)
        if (this.state.errorCode.size == 0 && grammar.integer &&
            jsonIntegerTextAvailable(text)) {
            value = jsonIntegerTextValue(text)
        } else if (this.state.errorCode.size == 0) this.state.fail(
            "invalid_number", "expected available JSON integer", begin
        )
    }
    this.expectingValue = false
    value
}

fun JsonObjectReader.readBoolean(): bool {
    var value = false
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    if (this.state.errorCode.size == 0 &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 116) {
        jsonScanLiteral(this.state, "true")
        value = true
    } else if (this.state.errorCode.size == 0) {
        jsonScanLiteral(this.state, "false")
    }
    this.expectingValue = false
    value
}

fun JsonObjectReader.readObject(): JsonObjectReader {
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    jsonReaderConsume(this.state, 123)
    this.expectingValue = false
    JsonObjectReader(this.state, [], true, false, false)
}

fun JsonObjectReader.readArray(): JsonArrayReader {
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    jsonReaderConsume(this.state, 91)
    this.expectingValue = false
    JsonArrayReader(this.state, true, false, false)
}

fun JsonObjectReader.readRaw(): string {
    var value = ""
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    val begin = this.state.offset
    if (this.state.errorCode.size == 0) jsonScanValue(this.state, 1)
    if (this.state.errorCode.size == 0) {
        value = this.state.source.slice(begin, this.state.offset)
    }
    this.expectingValue = false
    value
}

// Validate an array of two-string tuples and retain its original encoded
// slice. This common protocol shape (notably HTTP headers) avoids a dynamic
// tree and avoids pulling the generic recursive scanner into small binaries.
fun JsonObjectReader.readStringPairsRaw(): string {
    var value = ""
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    val begin = this.state.offset
    jsonReaderConsume(this.state, 91)
    jsonSkipWhitespace(this.state)
    var closed = false
    if (this.state.errorCode.size == 0 &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 93) {
        this.state.offset = this.state.offset + 1
        closed = true
    }
    while (this.state.errorCode.size == 0 && !closed) {
        jsonReaderConsume(this.state, 91)
        jsonParseString(this.state)
        jsonReaderConsume(this.state, 44)
        jsonParseString(this.state)
        jsonReaderConsume(this.state, 93)
        jsonSkipWhitespace(this.state)
        if (this.state.offset < this.state.source.size &&
            this.state.source[this.state.offset] == 93) {
            this.state.offset = this.state.offset + 1
            closed = true
        } else jsonReaderConsume(this.state, 44)
    }
    if (this.state.errorCode.size == 0) {
        value = this.state.source.slice(begin, this.state.offset)
    }
    this.expectingValue = false
    value
}

fun JsonObjectReader.skip(): void {
    this.readRaw()
    jsonSkipWhitespace(this.state)
}

fun JsonObjectReader.finish(): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_end", "JSON object value was not consumed", this.state.offset
    )
    if (!this.done && this.state.errorCode.size == 0) this.next()
    jsonSkipWhitespace(this.state)
    this.state.errorCode.size == 0 && this.done &&
        this.state.offset == this.state.source.size
}

fun JsonObjectReader.finishNested(): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_end", "JSON object value was not consumed", this.state.offset
    )
    if (!this.done && this.state.errorCode.size == 0) this.next()
    this.state.errorCode.size == 0 && this.done
}

fun jsonArrayReader(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonArrayReader {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits) || source.size > limits.maximumBytes) {
        state.fail("input_limit", "invalid JSON input limits", 0)
    }
    jsonReaderConsume(state, 91)
    JsonArrayReader(state, true, false, false)
}

fun JsonArrayReader.next(): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON array value was not consumed",
        this.state.offset
    )
    if (this.state.errorCode.size == 0 && !this.done &&
        !this.expectingValue) {
        val compact = ablaJsonCompactArrayNext(
            this.state.source, this.state.offset, this.first
        )
        if (compact > 0) {
            this.state.offset = compact - 1
            this.expectingValue = true
            this.first = false
            return true
        }
        if (compact < 0) {
            this.state.offset = 0 - compact - 1
            this.done = true
            return false
        }
    }
    jsonSkipWhitespace(this.state)
    if (this.state.errorCode.size == 0 && !this.done &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 93) {
        this.state.offset = this.state.offset + 1
        this.done = true
    }
    if (this.state.errorCode.size == 0 && !this.done) {
        if (!this.first) jsonReaderConsume(this.state, 44)
        jsonSkipWhitespace(this.state)
        if (this.state.offset < this.state.source.size &&
            this.state.source[this.state.offset] == 93) {
            this.state.fail(
                "unexpected_token", "trailing comma in JSON array",
                this.state.offset
            )
        }
        if (this.state.errorCode.size == 0) {
            this.expectingValue = true
            this.first = false
        }
    }
    this.expectingValue
}

fun JsonArrayReader.readString(): string {
    var value = ""
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON array reader has no current value",
        this.state.offset
    )
    if (this.state.errorCode.size == 0) value = jsonParseString(this.state)
    this.expectingValue = false
    value
}

fun JsonArrayReader.readInteger(): int {
    var value = 0
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON array reader has no current value",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    val begin = this.state.offset
    val fastEnd = if (this.state.errorCode.size == 0) {
        ablaJsonAvailableIntegerEnd(this.state.source, begin)
    } else -1
    if (fastEnd >= begin) {
        this.state.offset = fastEnd
        value = ablaJsonIntegerValueAt(this.state.source, begin, fastEnd)
    } else {
        if (this.state.errorCode.size == 0) jsonScanNumber(this.state)
        val text = this.state.source.slice(begin, this.state.offset)
        val grammar = jsonNumberGrammar(text)
        if (this.state.errorCode.size == 0 && grammar.integer &&
            jsonIntegerTextAvailable(text)) {
            value = jsonIntegerTextValue(text)
        } else if (this.state.errorCode.size == 0) this.state.fail(
            "invalid_number", "expected available JSON integer", begin
        )
    }
    this.expectingValue = false
    value
}

fun JsonArrayReader.readBoolean(): bool {
    var value = false
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON array reader has no current value",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    if (this.state.errorCode.size == 0 &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 116) {
        jsonScanLiteral(this.state, "true")
        value = true
    } else if (this.state.errorCode.size == 0) {
        jsonScanLiteral(this.state, "false")
    }
    this.expectingValue = false
    value
}

fun JsonArrayReader.readObject(): JsonObjectReader {
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON array reader has no current value",
        this.state.offset
    )
    jsonReaderConsume(this.state, 123)
    this.expectingValue = false
    JsonObjectReader(this.state, [], true, false, false)
}

fun JsonArrayReader.readArray(): JsonArrayReader {
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON array reader has no current value",
        this.state.offset
    )
    jsonReaderConsume(this.state, 91)
    this.expectingValue = false
    JsonArrayReader(this.state, true, false, false)
}

fun JsonArrayReader.skip(): void {
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON array reader has no current value",
        this.state.offset
    )
    if (this.state.errorCode.size == 0) jsonScanValue(this.state, 1)
    this.expectingValue = false
    jsonSkipWhitespace(this.state)
}

fun JsonArrayReader.finish(): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_end", "JSON array value was not consumed", this.state.offset
    )
    if (!this.done && this.state.errorCode.size == 0) this.next()
    jsonSkipWhitespace(this.state)
    this.state.errorCode.size == 0 && this.done &&
        this.state.offset == this.state.source.size
}

fun JsonArrayReader.finishNested(): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_end", "JSON array value was not consumed", this.state.offset
    )
    if (!this.done && this.state.errorCode.size == 0) this.next()
    this.state.errorCode.size == 0 && this.done
}

// One raw pass handles the common JSON-string case. Keeping the source data
// pointer and length outside the loop avoids re-entering generic string
// indexing for every byte while preserving the full UTF-8 boundary checks.
noescape extern:"intrinsic" fun ablaJsonStringIsPlain(
    value: string
): bool

fun jsonStringIsPlain(value: string): bool =
    ablaJsonStringIsPlain(value)

fun jsonAppendString(var output: ByteBuffer, value: string): bool {
    var offset = 0
    var valid = jsonStringIsPlain(value)
    if (valid) {
        output.appendText("\"")
        output.appendText(value)
        output.appendText("\"")
    } else {
        valid = true
        output.appendText("\"")
        offset = 0
        val hex = "0123456789abcdef"
        while (valid && offset < value.size) {
            val byte = value[offset]
            if (byte == 34) output.appendText("\\\"")
            else if (byte == 92) output.appendText("\\\\")
            else if (byte == 8) output.appendText("\\b")
            else if (byte == 12) output.appendText("\\f")
            else if (byte == 10) output.appendText("\\n")
            else if (byte == 13) output.appendText("\\r")
            else if (byte == 9) output.appendText("\\t")
            else if (byte < 32) {
                output.appendText("\\u00")
                output.appendText(hex.slice(byte / 16, byte / 16 + 1))
                val low = byte - (byte / 16) * 16
                output.appendText(hex.slice(low, low + 1))
            } else if (byte < 128) {
                output.appendText(value.slice(offset, offset + 1))
            } else {
                val length = utf8SequenceLength(byte)
                if (!utf8SequenceValid(value, offset, length)) {
                    valid = false
                }
                if (valid) output.appendText(
                    value.slice(offset, offset + length)
                )
                offset = offset + length - 1
            }
            offset = offset + 1
        }
        if (valid) output.appendText("\"")
    }
    valid
}

fun jsonWriteString(var writer: JsonWriter, value: string): void {
    if (writer.valid) writer.valid = jsonAppendString(writer.output, value)
}

// Encode one UTF-8 string as a complete JSON string literal without building
// a dynamic `Json` tree. Protocol adapters can use this for streaming object
// envelopes while retaining the same escaping and validation rules as
// `jsonStringify`.
fun jsonQuote(value: string): string {
    if (jsonStringIsPlain(value)) "\"$value\""
    else {
        val writer = JsonWriter(byteBuffer(), true)
        jsonWriteString(writer, value)
        if (writer.valid) writer.output.toText() else "null"
    }
}

fun jsonEncodeNull(): JsonEncoded = JsonEncoded("null", true)

fun jsonEncodeString(value: string): JsonEncoded =
    JsonEncoded(jsonQuote(value), value.isValidUtf8())

// Static schemas can precompute the complete quoted-key-and-colon token. This
// preserves ordinary JSON escaping while requiring one output append instead
// of separate key and colon fragments at runtime.
fun jsonEncodeObjectKey(value: string): JsonEncoded {
    val encoded = jsonEncodeString(value)
    JsonEncoded("${encoded.text}:", encoded.valid)
}

fun jsonEncodeInteger(value: int): JsonEncoded = JsonEncoded("$value", true)

fun jsonEncodeBoolean(value: bool): JsonEncoded =
    JsonEncoded(if (value) "true" else "false", true)

fun jsonEncoder(): JsonEncoder = JsonEncoder(
    byteBuffer(), 0, 0, 0, 0, false, true
)

fun JsonEncoder.prepareValue(): void {
    if (this.depth == 0) {
        if (this.rootWritten) this.valid = false
        this.rootWritten = true
    } else {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) != 0) {
            if ((this.expectingValueBits & mask) == 0) this.valid = false
            this.expectingValueBits = this.expectingValueBits & ~mask
        } else {
            if ((this.nonEmptyBits & mask) != 0) {
                this.output.appendText(",")
            }
        }
        this.nonEmptyBits = this.nonEmptyBits | mask
    }
}

fun JsonEncoder.beginObject(): void {
    this.prepareValue()
    if (this.depth >= 63) this.valid = false
    if (this.valid) {
        this.output.appendText("{")
        val mask = 1 << this.depth
        this.objectBits = this.objectBits | mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth + 1
    }
}

fun JsonEncoder.beginArray(): void {
    this.prepareValue()
    if (this.depth >= 63) this.valid = false
    if (this.valid) {
        this.output.appendText("[")
        val mask = 1 << this.depth
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth + 1
    }
}

fun JsonEncoder.key(name: string): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) this.valid = jsonAppendString(this.output, name)
        if (this.valid) {
            this.output.appendText(":")
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

// Static protocol schemas may quote and validate a key at compile time with
// #jsonEncodeString, then append that trusted fragment without rescanning it
// for every encoded object.
fun JsonEncoder.encodedKey(key: JsonEncoded): void {
    if (this.depth <= 0 || !key.valid) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) {
            this.output.appendText(key.text)
            this.output.appendText(":")
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

fun JsonEncoder.encodedObjectKey(key: JsonEncoded): void {
    if (this.depth <= 0 || !key.valid) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) {
            this.output.appendText(key.text)
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

fun JsonEncoder.string(value: string): void {
    this.prepareValue()
    if (this.valid) this.valid = jsonAppendString(this.output, value)
}

fun JsonEncoder.integer(value: int): void {
    this.prepareValue()
    if (this.valid) this.output.appendText("$value")
}

fun JsonEncoder.boolean(value: bool): void {
    this.prepareValue()
    val encoded = if (value) "true" else "false"
    if (this.valid) this.output.appendText(encoded)
}

fun JsonEncoder.nullValue(): void {
    this.prepareValue()
    if (this.valid) this.output.appendText("null")
}

fun JsonEncoder.endObject(): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid) this.output.appendText("}")
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth - 1
    }
}

fun JsonEncoder.endArray(): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) != 0) this.valid = false
        if (this.valid) this.output.appendText("]")
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth - 1
    }
}

fun JsonEncoder.finish(): string {
    if (this.valid && this.rootWritten && this.depth == 0) {
        this.output.toText()
    } else "null"
}

fun jsonArrayEncoder(): JsonArrayEncoder {
    val encoder = JsonArrayEncoder(byteBuffer(), 0, true, false)
    encoder.output.appendText("[")
    encoder
}

fun JsonArrayEncoder.add(value: JsonEncoded): void {
    if (this.finished || !value.valid) this.valid = false
    if (this.valid) {
        if (this.count > 0) this.output.appendText(",")
        this.output.appendText(value.text)
        this.count = this.count + 1
    }
}

fun JsonArrayEncoder.finish(): JsonEncoded {
    if (this.finished) this.valid = false
    if (this.valid) this.output.appendText("]")
    this.finished = true
    JsonEncoded(if (this.valid) this.output.toText() else "null", this.valid)
}

fun jsonObjectEncoder(): JsonObjectEncoder {
    val encoder = JsonObjectEncoder(byteBuffer(), 0, true, false)
    encoder.output.appendText("{")
    encoder
}

fun JsonObjectEncoder.put(name: string, value: JsonEncoded): void {
    if (this.finished || !name.isValidUtf8() || !value.valid) {
        this.valid = false
    }
    if (this.valid) {
        if (this.count > 0) this.output.appendText(",")
        val writer = JsonWriter(this.output, true)
        jsonWriteString(writer, name)
        if (!writer.valid) this.valid = false
    }
    if (this.valid) {
        this.output.appendText(":")
        this.output.appendText(value.text)
        this.count = this.count + 1
    }
}

fun JsonObjectEncoder.finish(): JsonEncoded {
    if (this.finished) this.valid = false
    if (this.valid) this.output.appendText("}")
    this.finished = true
    JsonEncoded(if (this.valid) this.output.toText() else "null", this.valid)
}

fun jsonWriteValue(var writer: JsonWriter, value: Json): void {
    if (value.kind == 0) writer.output.appendText("null")
    else if (value.kind == 1) jsonWriteString(writer, value.stringValue)
    else if (value.kind == 2) {
        if (jsonNumberGrammar(value.numberValue.text).valid) {
            writer.output.appendText(value.numberValue.text)
        } else writer.valid = false
    } else if (value.kind == 3) {
        writer.output.appendText(if (value.boolValue) "true" else "false")
    } else if (value.kind == 4) {
        writer.output.appendText("[")
        var index = 0
        while (writer.valid && index < value.values.size) {
            if (index > 0) writer.output.appendText(",")
            jsonWriteValue(writer, value.values[index])
            index = index + 1
        }
        if (writer.valid) writer.output.appendText("]")
    } else if (value.kind == 5) {
        if (value.keys.size != value.values.size) writer.valid = false
        if (writer.valid) writer.output.appendText("{")
        var index = 0
        while (writer.valid && index < value.keys.size) {
            if (index > 0) writer.output.appendText(",")
            jsonWriteString(writer, value.keys[index])
            if (writer.valid) writer.output.appendText(":")
            if (writer.valid) jsonWriteValue(writer, value.values[index])
            index = index + 1
        }
        if (writer.valid) writer.output.appendText("}")
    } else writer.valid = false
}

fun jsonStringify(value: Json): string {
    val writer = JsonWriter(byteBuffer(), true)
    jsonWriteValue(writer, value)
    if (writer.valid) writer.output.toText() else "null"
}

compile fun ablaJsonSyntaxCall(
    name: string,
    value: SyntaxExpression
): SyntaxExpression {
    val arguments: array<SyntaxExpression> = []
    arguments.append(value)
    syntaxCall(name, arguments)
}

compile fun ablaJsonParseValue(cursor: ParserCursor): SyntaxExpression {
    if (parserAt(cursor, "{")) ablaJsonParseObject(cursor)
    else if (parserAt(cursor, "[")) ablaJsonParseArray(cursor)
    else if (parserAt(cursor, "string")) {
        ablaJsonSyntaxCall(
            "ablaJsonString",
            parserParseAblaExpression(cursor)
        )
    } else if (parserAt(cursor, "integer") || parserAt(cursor, "float") ||
        parserAt(cursor, "-")) {
        val number = parserRawTakeUntil(cursor, " \t\r\n,]}")
        ablaJsonSyntaxCall("ablaJsonNumberText", syntaxString(number))
    } else if (parserAt(cursor, "true") || parserAt(cursor, "false")) {
        ablaJsonSyntaxCall(
            "ablaJsonBoolean",
            parserParseAblaExpression(cursor)
        )
    } else {
        parserExpect(cursor, "null")
        val arguments: array<SyntaxExpression> = []
        syntaxCall("ablaJsonNull", arguments)
    }
}

compile fun ablaJsonParseArray(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "[")
    val values: array<SyntaxExpression> = []
    var more = !parserAt(cursor, "]")
    while (more) {
        values.append(ablaJsonParseValue(cursor))
        more = parserConsume(cursor, ",")
        if (more) parserRawSkipWhitespace(cursor)
    }
    parserExpect(cursor, "]")
    ablaJsonSyntaxCall("ablaJsonArray", syntaxArray(values))
}

compile fun ablaJsonParseObject(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "{")
    val keys: array<SyntaxExpression> = []
    val values: array<SyntaxExpression> = []
    var more = !parserAt(cursor, "}")
    while (more) {
        keys.append(parserParseAblaExpression(cursor))
        parserExpect(cursor, ":")
        values.append(ablaJsonParseValue(cursor))
        more = parserConsume(cursor, ",")
        if (more) parserRawSkipWhitespace(cursor)
    }
    parserExpect(cursor, "}")
    val arguments: array<SyntaxExpression> = []
    arguments.append(syntaxArray(keys))
    arguments.append(syntaxArray(values))
    syntaxCall("ablaJsonObject", arguments)
}

// `$jsons` shares the JSON grammar but produces its deterministic encoded
// string directly. In staged code, `#$jsons {...}` validates and serializes the
// literal at compile time, leaving only the frozen string in the program.
compile fun ablaJsonParseStringifiedValue(
    cursor: ParserCursor
): SyntaxExpression = ablaJsonSyntaxCall(
    "jsonStringify", ablaJsonParseValue(cursor)
)

#compilerRegisterSubparser("json", ablaJsonParseValue)
#compilerRegisterSubparser("jsons", ablaJsonParseStringifiedValue)
