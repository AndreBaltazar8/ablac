// One raw pass handles the common JSON-string case. Keeping the source data
// pointer and length outside the loop avoids re-entering generic string
// indexing for every byte while preserving the full UTF-8 boundary checks.
noescape extern:"intrinsic" fun ablaJsonStringIsPlain(
    value: string
): bool

// Eight bytes at a time for the common case, a string of printable ASCII with no quote or backslash: any word that has a byte below 32, a quote, a backslash or a byte of 128 or more
// (UTF-8, which the intrinsic checks and a whole-word test cannot) sends the whole string to the intrinsic, so the answer is always the intrinsic's.
private trusted fun jsonStringIsPlain(value: string): bool {
    if (ablaCompileTimeNativeHost()) return jsonStringIsPlainNative(value)
    if (ablaAtCompileTime()) return ablaJsonStringIsPlain(value)
    return jsonStringIsPlainNative(value)
}

private trusted fun jsonStringIsPlainNative(value: string): bool {
    val size = value.size
    val address = ablaUnsafeStringAddress(value)
    var at = 0
    while (at + 8 <= size) {
        val word = ablaUnsafeLoadI64(nativePointerFromAddress(address + at))
        // A byte below 32: x - 0x20 borrows out of it; a quote and a backslash: x ^ 0x22 and x ^ 0x5c have a zero byte; a high bit: set already.
        val quote = word ^ 2459565876494606882
        val slash = word ^ 6655295901103053916
        val below = word - 2314885530818453536
        val zeroQuote = (quote - 72340172838076673) & ~quote
        val zeroSlash = (slash - 72340172838076673) & ~slash
        val belowBits = below & ~word
        if (((zeroQuote | zeroSlash | belowBits | word) & -9187201950435737472) != 0) return ablaJsonStringIsPlain(value)
        at = at + 8
    }
    while (at < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(address + at))
        if (byte < 32 || byte == 34 || byte == 92 || byte >= 128) return ablaJsonStringIsPlain(value)
        at = at + 1
    }
    true
}

// Appends a quoted JSON string and returns true, or returns false if invalid UTF-8 interrupts the write.
@noinline
fun jsonAppendStringPortable(var output: ByteBuffer, value: string): bool {
    var offset = 0
    var valid = jsonStringIsPlain(value)
    if (valid) {
        output.appendText("\"")
        output.appendText(value)
        output.appendText("\"")
    } else {
        valid = true
        output.appendText("\"")
        offset = 0
        val hex = "0123456789abcdef"
        while (valid && offset < value.size) {
            val byte = value[offset]
            if (byte == 34) output.appendText("\\\"")
            else if (byte == 92) output.appendText("\\\\")
            else if (byte == 8) output.appendText("\\b")
            else if (byte == 12) output.appendText("\\f")
            else if (byte == 10) output.appendText("\\n")
            else if (byte == 13) output.appendText("\\r")
            else if (byte == 9) output.appendText("\\t")
            else if (byte < 32) {
                output.appendText("\\u00")
                output.appendText(hex.slice(byte / 16, byte / 16 + 1))
                val low = byte - (byte / 16) * 16
                output.appendText(hex.slice(low, low + 1))
            } else if (byte < 128) {
                output.appendText(value.slice(offset, offset + 1))
            } else {
                val length = utf8SequenceLength(byte)
                if (!utf8SequenceValid(value, offset, length)) {
                    valid = false
                }
                if (valid) output.appendText(
                    value.slice(offset, offset + length)
                )
                offset = offset + length - 1
            }
            offset = offset + 1
        }
        if (valid) output.appendText("\"")
    }
    valid
}

// Valid UTF-8 only: size once, then write the escaped bytes into one reserved
// span. The portable writer is the evaluator's; it is not in a runtime build.
@noinline
trusted fun jsonAppendEscapedNative(var output: ByteBuffer, value: string): void {
    val length = jsonEscapedSize(value)
    jsonWriteEscapedAt(value, output.stageReserve(length))
    output.staged = output.staged + length
    output.byteCount = output.byteCount + length
    return
}

// The bytes `value` takes as a quoted, escaped JSON string.
trusted fun jsonEscapedSize(value: string): int {
    val size = value.size
    val source = ablaUnsafeStringAddress(value)
    var length = 2
    var index = 0
    while (index < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + index))
        length = length + (if (byte == 34 || byte == 92 || byte == 8 ||
            byte == 12 || byte == 10 || byte == 13 || byte == 9) 2
            else if (byte < 32) 6 else 1)
        index = index + 1
    }
    length
}

// Writes `value` quoted and escaped at `destination` (jsonEscapedSize bytes).
private trusted fun jsonWriteEscapedAt(value: string, destination: int): void {
    val size = value.size
    val source = ablaUnsafeStringAddress(value)
    ablaUnsafeStoreU8(nativePointerFromAddress(destination), 34)
    var written = 1
    var index = 0
    while (index < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + index))
        if (byte == 34 || byte == 92 || byte < 32) {
            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), 92)
            written = written + 1
            val escape = if (byte == 8) 98 else if (byte == 12) 102
                else if (byte == 10) 110 else if (byte == 13) 114
                else if (byte == 9) 116 else byte
            if (byte >= 32 || escape != byte) {
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), escape)
                written = written + 1
            } else {
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), 117)
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 1), 48)
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 2), 48)
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 3),
                    48 + (byte >> 4))
                val low = byte & 15
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 4),
                    if (low < 10) 48 + low else 87 + low)
                written = written + 5
            }
        } else {
            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), byte)
            written = written + 1
        }
        index = index + 1
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), 34)
    return
}

// Short plain strings need one reservation instead of three token appends.
// Large strings retain the chunk path, avoiding an extra contents copy.
trusted fun jsonAppendPlainNative(var output: ByteBuffer, value: string): void {
    val length = value.size + 2
    val destination = output.stageReserve(length)
    ablaUnsafeStoreU8(nativePointerFromAddress(destination), 34)
    ablaUnsafeCopyMemory(destination + 1, ablaUnsafeStringAddress(value), value.size)
    ablaUnsafeStoreU8(nativePointerFromAddress(destination + length - 1), 34)
    output.staged = output.staged + length
    output.byteCount = output.byteCount + length
    return
}

private fun jsonAppendString(var output: ByteBuffer, value: string): bool {
    if (ablaCompileTimeNativeHost()) return jsonAppendStringNative(output, value)
    if (ablaAtCompileTime()) return jsonAppendStringPortable(output, value)
    return jsonAppendStringNative(output, value)
}

private fun jsonAppendStringNative(var output: ByteBuffer, value: string): bool {
    if (jsonStringIsPlain(value)) {
        if (value.size < BYTE_BUFFER_LARGE) {
            jsonAppendPlainNative(output, value)
            return true
        }
        output.appendText("\"")
        output.appendText(value)
        output.appendText("\"")
        return true
    }
    // Every caller marks its writer invalid on false; nothing reads the
    // partial output, so invalid UTF-8 needs no portable rewrite.
    if (!value.isValidUtf8()) return false
    jsonAppendEscapedNative(output, value)
    true
}

private fun jsonWriteString(var writer: JsonWriter, value: string): void {
    if (writer.valid) writer.valid = jsonAppendString(writer.output, value)
}

// Encode one UTF-8 string as a complete JSON string literal without building
// a dynamic `Json` tree. Protocol adapters can use this for streaming object
// envelopes while retaining the same escaping and validation rules as
// `jsonStringify`.
fun jsonQuote(value: string): string {
    if (jsonStringIsPlain(value)) "\"$value\""
    else {
        val writer = JsonWriter(byteBuffer(), true)
        jsonWriteString(writer, value)
        if (writer.valid) writer.output.toText() else "null"
    }
}

/** `value` as a JSON string appended to `out`: the same bytes as `out.appendText(jsonQuote(value))`, without the quoted copy of a plain string. */
fun jsonAppendQuoted(var out: ByteBuffer, value: string): void {
    if (jsonStringIsPlain(value)) {
        out.appendText("\"")
        out.appendText(value)
        out.appendText("\"")
    } else out.appendText(jsonQuote(value))
    return
}

private fun jsonEncodeNull(): JsonEncoded = JsonEncoded("null", true)

// Returns a quoted JSON string fragment with a validity flag that is false for invalid UTF-8.
fun jsonEncodeString(value: string): JsonEncoded =
    JsonEncoded(jsonQuote(value), value.isValidUtf8())

// Static schemas can precompute the complete quoted-key-and-colon token. This
// preserves ordinary JSON escaping while requiring one output append instead
// of separate key and colon fragments at runtime.
fun jsonEncodeObjectKey(value: string): JsonEncoded {
    val encoded = jsonEncodeString(value)
    JsonEncoded("${encoded.text}:", encoded.valid)
}

private fun jsonEncodeInteger(value: int): JsonEncoded = JsonEncoded("$value", true)

// Returns the valid JSON encoded fragment `true` or `false`.
fun jsonEncodeBoolean(value: bool): JsonEncoded =
    JsonEncoded(if (value) "true" else "false", true)

// Creates an empty writer for one JSON value. Use finish to obtain the text or the invalid-output sentinel.
fun jsonEncoder(): JsonEncoder = JsonEncoder(
    byteBuffer(), 0, 0, 0, 0, false, true
)

// Prepares the next value slot, inserting an array separator when needed and invalidating a second root or a member without a key.
fun JsonEncoder.prepareValue(): void {
    if (this.depth == 0) {
        if (this.rootWritten) this.valid = false
        this.rootWritten = true
    } else {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) != 0) {
            if ((this.expectingValueBits & mask) == 0) this.valid = false
            this.expectingValueBits = this.expectingValueBits & ~mask
        } else {
            if ((this.nonEmptyBits & mask) != 0) {
                this.output.appendText(",")
            }
        }
        this.nonEmptyBits = this.nonEmptyBits | mask
    }
}

// Starts an object at the current value position. Invalid placement or nesting beyond 63 levels invalidates the encoder.
fun JsonEncoder.beginObject(): void {
    this.prepareValue()
    if (this.depth >= 63) this.valid = false
    if (this.valid) {
        this.output.appendText("{")
        val mask = 1 << this.depth
        this.objectBits = this.objectBits | mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth + 1
    }
}

// Starts an array at the current value position. Invalid placement or nesting beyond 63 levels invalidates the encoder.
fun JsonEncoder.beginArray(): void {
    this.prepareValue()
    if (this.depth >= 63) this.valid = false
    if (this.valid) {
        this.output.appendText("[")
        val mask = 1 << this.depth
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth + 1
    }
}

// Writes object member `name` and expects its value next. Invalid UTF-8, a key outside an object, or a previous key missing its value invalidates the encoder.
fun JsonEncoder.key(name: string): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) this.valid = jsonAppendString(this.output, name)
        if (this.valid) {
            this.output.appendText(":")
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

// Static protocol schemas may quote and validate a key at compile time with
// #jsonEncodeString, then append that trusted fragment without rescanning it
// for every encoded object.
fun JsonEncoder.encodedKey(key: JsonEncoded): void {
    if (this.depth <= 0 || !key.valid) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) {
            this.output.appendText(key.text)
            this.output.appendText(":")
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

// Writes a pre-encoded key and colon, invalidating the encoder if the key is invalid or there is no available object member slot.
fun JsonEncoder.encodedObjectKey(key: JsonEncoded): void {
    if (this.depth <= 0 || !key.valid) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) {
            this.output.appendText(key.text)
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

// Writes UTF-8 `value` as a JSON string. Invalid UTF-8 or invalid placement invalidates the encoder.
fun JsonEncoder.string(value: string): void {
    this.prepareValue()
    if (this.valid) this.valid = jsonAppendString(this.output, value)
}

// Writes `value` as a decimal JSON integer. Invalid placement invalidates the encoder.
fun JsonEncoder.integer(value: int): void {
    this.prepareValue()
    if (this.valid) this.output.appendInt(value)
}

// A number the way JSON.stringify writes it: f64Text, and null for NaN and the
// infinities, which JSON cannot hold.
fun JsonEncoder.number(value: f64): void {
    this.prepareValue()
    if (this.valid) {
        if (value != value || value - value != 0.0) this.output.appendText("null")
        else this.output.appendF64(value)
    }
}

// Writes `value` as a JSON boolean. Invalid placement invalidates the encoder.
fun JsonEncoder.boolean(value: bool): void {
    this.prepareValue()
    val encoded = if (value) "true" else "false"
    if (this.valid) this.output.appendText(encoded)
}

// Writes JSON null at the current value position, invalidating the encoder if there is no available slot.
fun JsonEncoder.nullValue(): void {
    this.prepareValue()
    if (this.valid) this.output.appendText("null")
}

// Closes the current object. An unmatched close or a member still missing its value invalidates the encoder.
fun JsonEncoder.endObject(): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid) this.output.appendText("}")
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth - 1
    }
}

// Closes the current array. An unmatched close invalidates the encoder.
fun JsonEncoder.endArray(): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) != 0) this.valid = false
        if (this.valid) this.output.appendText("]")
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth - 1
    }
}

// Returns the encoded text when one root value is complete. Returns the text `null` if nothing was written, a container remains open, or the encoder is invalid.
fun JsonEncoder.finish(): string {
    if (this.valid && this.rootWritten && this.depth == 0) {
        this.output.toText()
    } else "null"
}

// Returns a fresh encoder for one JSON array.
fun jsonArrayEncoder(): JsonArrayEncoder {
    val encoder = JsonArrayEncoder(byteBuffer(), 0, true, false)
    encoder.output.appendText("[")
    encoder
}

// Appends an encoded element, marking the encoder invalid if the value is invalid or the array has already finished.
fun JsonArrayEncoder.add(value: JsonEncoded): void {
    if (this.finished || !value.valid) this.valid = false
    if (this.valid) {
        if (this.count > 0) this.output.appendText(",")
        this.output.appendText(value.text)
        this.count = this.count + 1
    }
}

// Closes the array and returns its encoded text, or an invalid `null` fragment after a prior error or a repeated finish.
fun JsonArrayEncoder.finish(): JsonEncoded {
    if (this.finished) this.valid = false
    if (this.valid) this.output.appendText("]")
    this.finished = true
    JsonEncoded(if (this.valid) this.output.toText() else "null", this.valid)
}

// Returns a fresh encoder for one JSON object.
fun jsonObjectEncoder(): JsonObjectEncoder {
    val encoder = JsonObjectEncoder(byteBuffer(), 0, true, false)
    encoder.output.appendText("{")
    encoder
}

// Appends one encoded member, marking the encoder invalid for invalid UTF-8 in the name, an invalid value, or a finished object.
fun JsonObjectEncoder.put(name: string, value: JsonEncoded): void {
    if (this.finished || !name.isValidUtf8() || !value.valid) {
        this.valid = false
    }
    if (this.valid) {
        if (this.count > 0) this.output.appendText(",")
        val writer = JsonWriter(this.output, true)
        jsonWriteString(writer, name)
        if (!writer.valid) this.valid = false
    }
    if (this.valid) {
        this.output.appendText(":")
        this.output.appendText(value.text)
        this.count = this.count + 1
    }
}

// Closes the object and returns its encoded text, or an invalid `null` fragment after a prior error or a repeated finish.
fun JsonObjectEncoder.finish(): JsonEncoded {
    if (this.finished) this.valid = false
    if (this.valid) this.output.appendText("}")
    this.finished = true
    JsonEncoded(if (this.valid) this.output.toText() else "null", this.valid)
}

private fun jsonWriteValue(var writer: JsonWriter, value: Json): void {
    if (value.kind == 0) writer.output.appendText("null")
    else if (value.kind == 1) jsonWriteString(writer, value.stringValue)
    else if (value.kind == 2) {
        if (jsonNumberKind(value.numberValue.text) >= 0) {
            writer.output.appendText(value.numberValue.text)
        } else writer.valid = false
    } else if (value.kind == 3) {
        writer.output.appendText(if (value.boolValue) "true" else "false")
    } else if (value.kind == 4) {
        writer.output.appendText("[")
        var index = 0
        while (writer.valid && index < value.values.size) {
            if (index > 0) writer.output.appendText(",")
            jsonWriteValue(writer, value.values[index])
            index = index + 1
        }
        if (writer.valid) writer.output.appendText("]")
    } else if (value.kind == 6) {
        writer.output.appendText(value.stringValue)
    } else if (value.kind == 5) {
        if (value.keys.size != value.values.size) writer.valid = false
        if (writer.valid) writer.output.appendText("{")
        var index = 0
        while (writer.valid && index < value.keys.size) {
            if (index > 0) writer.output.appendText(",")
            jsonWriteString(writer, value.keys[index])
            if (writer.valid) writer.output.appendText(":")
            if (writer.valid) jsonWriteValue(writer, value.values[index])
            index = index + 1
        }
        if (writer.valid) writer.output.appendText("}")
    } else writer.valid = false
}

// Serializes `value` to compact JSON text. If a node cannot be encoded, returns the text `null`. Raw nodes are emitted verbatim.
fun jsonStringify(value: Json): string {
    if (ablaCompileTimeNativeHost()) return jsonStringifyNative(value)
    if (ablaAtCompileTime()) {
        val writer = JsonWriter(byteBuffer(), true)
        jsonWriteValue(writer, value)
        return if (writer.valid) writer.output.toText() else "null"
    }
    return jsonStringifyNative(value)
}

private fun jsonWritePrettyLine(var writer: JsonWriter, depth: int): void {
    writer.output.appendText("\n")
    for (index in 0 until depth) writer.output.appendText("  ")
}

private fun jsonWritePrettyValue(
    var writer: JsonWriter, value: Json, sortKeys: bool, depth: int, maxDepth: int
): void {
    if (depth > maxDepth || value.kind == 6) {
        writer.valid = false
        return
    }
    val object = value.kind == 5
    if (!object && value.kind != 4) {
        jsonWriteValue(writer, value)
        return
    }
    val count = value.values.size
    val keys = value.keys
    if (object && keys.size != count) {
        writer.valid = false
        return
    }
    val order: array<int> = if (object && sortKeys && count > 1) {
        val indices: array<int> = []
        val names: array<string> = []
        for (index in 0 until count) {
            indices.append(index)
            names.append(keys[index])
        }
        indices.sortedBy { left, right -> names[left] < names[right] }
    } else []
    writer.output.appendText(if (object) "{" else "[")
    var position = 0
    while (writer.valid && position < count) {
        if (position > 0) writer.output.appendText(",")
        jsonWritePrettyLine(writer, depth + 1)
        val index = if (order.size > 0) order[position] else position
        if (object) {
            jsonWriteString(writer, keys[index])
            if (writer.valid) writer.output.appendText(": ")
        }
        if (writer.valid) jsonWritePrettyValue(writer, value.values[index], sortKeys, depth + 1, maxDepth)
        position += 1
    }
    if (writer.valid) {
        if (count > 0) jsonWritePrettyLine(writer, depth)
        writer.output.appendText(if (object) "}" else "]")
    }
}

/// Serializes a JSON tree with two-space indentation and no terminal newline. Sorts object keys lexically when requested.
/// Returns an invalid fragment for invalid nodes, raw text nodes, or a value beyond maxDepth (the root is depth zero).
fun jsonStringifyPretty(value: Json, sortKeys: bool = false, maxDepth: int = 128): JsonEncoded {
    val writer = JsonWriter(byteBuffer(), true)
    jsonWritePrettyValue(writer, value, sortKeys, 0, maxDepth)
    JsonEncoded(if (writer.valid) writer.output.toText() else "null", writer.valid)
}

private fun jsonStringifyNative(value: Json): string {
    // Compiled code sizes the text first (which also finds anything that can't
    // be written: the result is then "null", as the writer gives), then writes it
    // into one allocation of that size: no buffer of pieces, no copy at the end.
    val size = jsonEncodedSize(value)
    if (size < 0) "null" else jsonEncodeSized(value, size)
}

// The bytes jsonStringify writes for `value`, or -1 when it can't be written (a
// string that isn't valid UTF-8, a number that isn't JSON's, an object whose keys
// and values differ in count, an unknown kind).
private fun jsonEncodedSize(value: Json): int {
    val kind = value.kind
    if (kind == 0) return 4
    if (kind == 1) return jsonStringEncodedSize(value.stringValue)
    if (kind == 2) {
        val text = value.numberValue.text
        return if (jsonNumberKind(text) >= 0) text.size else -1
    }
    if (kind == 3) return if (value.boolValue) 4 else 5
    if (kind == 4) {
        val values = value.values
        var total = if (values.size > 0) 1 + values.size else 2
        for (element in values) {
            val size = jsonEncodedSize(element)
            if (size < 0) return -1
            total = total + size
        }
        return total
    }
    if (kind == 5) {
        val keys = value.keys
        val values = value.values
        if (keys.size != values.size) return -1
        var total = if (keys.size > 0) 1 + keys.size * 2 else 2
        var index = 0
        while (index < keys.size) {
            val keySize = jsonStringEncodedSize(keys[index])
            if (keySize < 0) return -1
            val size = jsonEncodedSize(values[index])
            if (size < 0) return -1
            total = total + keySize + size
            index = index + 1
        }
        return total
    }
    if (kind == 6) return value.stringValue.size
    -1
}

private fun jsonStringEncodedSize(value: string): int {
    if (jsonStringIsPlain(value)) return value.size + 2
    if (!value.isValidUtf8()) return -1
    jsonEscapedSize(value)
}

// `value`, which jsonEncodedSize sized at `size` bytes, written into a string of
// exactly that size.
private trusted fun jsonEncodeSized(value: Json, size: int): string {
    val buffer = nativeByteBuffer(size + 1)
    val written = jsonEncodeAt(value, nativePointerAddress(buffer.address))
    buffer.adoptString(written - nativePointerAddress(buffer.address))
}

// Writes `value` (sized and checked by jsonEncodedSize) at `destination`: the
// address after it.
private trusted fun jsonEncodeAt(value: Json, destination: int): int {
    val kind = value.kind
    if (kind == 0) return jsonEncodeTokenAt("null", destination)
    if (kind == 1) return jsonEncodeStringAt(value.stringValue, destination)
    if (kind == 2) return jsonEncodeTokenAt(value.numberValue.text, destination)
    if (kind == 3) return jsonEncodeTokenAt(if (value.boolValue) "true" else "false", destination)
    if (kind == 6) return jsonEncodeTokenAt(value.stringValue, destination)
    var at = destination
    if (kind == 4) {
        ablaUnsafeStoreU8(nativePointerFromAddress(at), 91)
        at = at + 1
        var index = 0
        for (element in value.values) {
            if (index > 0) {
                ablaUnsafeStoreU8(nativePointerFromAddress(at), 44)
                at = at + 1
            }
            at = jsonEncodeAt(element, at)
            index = index + 1
        }
        ablaUnsafeStoreU8(nativePointerFromAddress(at), 93)
        return at + 1
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(at), 123)
    at = at + 1
    val keys = value.keys
    val values = value.values
    var index = 0
    while (index < keys.size) {
        if (index > 0) {
            ablaUnsafeStoreU8(nativePointerFromAddress(at), 44)
            at = at + 1
        }
        at = jsonEncodeStringAt(keys[index], at)
        ablaUnsafeStoreU8(nativePointerFromAddress(at), 58)
        at = jsonEncodeAt(values[index], at + 1)
        index = index + 1
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(at), 125)
    at + 1
}

// Copies an already encoded token into caller-provided storage and returns the address just past it.
private trusted fun jsonEncodeTokenAt(text: string, destination: int): int {
    ablaUnsafeCopyMemory(destination, ablaUnsafeStringAddress(text), text.size)
    destination + text.size
}

// Writes a quoted JSON string into caller-provided storage and returns the next address, assuming valid UTF-8 and enough room.
private trusted fun jsonEncodeStringAt(value: string, destination: int): int {
    if (jsonStringIsPlain(value)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(destination), 34)
        ablaUnsafeCopyMemory(destination + 1, ablaUnsafeStringAddress(value), value.size)
        ablaUnsafeStoreU8(nativePointerFromAddress(destination + value.size + 1), 34)
        return destination + value.size + 2
    }
    jsonWriteEscapedAt(value, destination)
    destination + jsonEscapedSize(value)
}

// Builds a single-argument call. Static stringification can return a literal.
compile fun ablaJsonSyntaxCall(
    name: string,
    value: SyntaxExpression
): SyntaxExpression {
    // Evaluate the parser argument before trying the optional fold so a stopped
    // parse propagates through the original call path.
    if (name == "jsonStringify") {
        val output = byteBuffer()
        if (ablaJsonAppendStatic(output, value, 0)) return syntaxString(output.toText())
    }
    val arguments: array<SyntaxExpression> = []
    arguments.append(value)
    syntaxCall(name, arguments)
}

// A value is a JSON object or array when it starts with `{` or `[`; anything
// else is an Abla expression. A number literal on its own keeps its source text
// (so 9223372036854775808 and 1.5e-2 stay exact), string, Boolean and null
// literals map directly, and any other expression is converted by its type
// through ablaJsonValue. Unlike JSON, an object or array may end in a comma.
compile fun ablaJsonParseValue(cursor: ParserCursor): SyntaxExpression =
    ablaJsonParseForm(cursor, false)

/// Returns syntax for a JSON value, using the streaming form for containers when requested and reporting malformed input through the cursor.
compile fun ablaJsonParseForm(cursor: ParserCursor, streamed: bool): SyntaxExpression {
    if (parserAt(cursor, "{")) ablaJsonParseObject(cursor, streamed)
    else if (parserAt(cursor, "[")) ablaJsonParseArray(cursor, streamed)
    else {
        val negative = parserAt(cursor, "-")
        val lexeme = parserTextAhead(cursor, if (negative) 1 else 0)
        val value = parserParseAblaExpression(cursor)
        val kind = syntaxKind(value)
        val literal = if (negative) {
            kind == "unary-" && syntaxChildCount(value) == 1 &&
                ablaJsonNumberLiteral(syntaxKind(syntaxChild(value, 0)))
        } else ablaJsonNumberLiteral(kind)
        val number = if (negative) "-$lexeme" else lexeme
        if (literal && jsonNumberKind(number) >= 0) {
            ablaJsonSyntaxCall("ablaJsonNumberText", syntaxString(number))
        } else if (kind == "null") {
            val arguments: array<SyntaxExpression> = []
            syntaxCall("ablaJsonNull", arguments)
        } else if (kind == "string") {
            ablaJsonSyntaxCall("ablaJsonString", value)
        } else if (kind == "true" || kind == "false") {
            ablaJsonSyntaxCall("ablaJsonBoolean", value)
        } else ablaJsonSyntaxCall("ablaJsonValue", value)
    }
}

// Returns true if the syntax kind is an integer or float literal.
compile fun ablaJsonNumberLiteral(kind: string): bool =
    kind == "integer" || kind == "float"

// Consumes `token` or records the supplied parser error if the next token does not match.
compile fun ablaJsonExpect(
    cursor: ParserCursor,
    token: string,
    message: string
) {
    if (!parserConsume(cursor, token)) parserFail(cursor, message)
}

/// Returns syntax for a JSON array and reports malformed elements or delimiters through the cursor.
compile fun ablaJsonParseArray(cursor: ParserCursor, streamed: bool = false): SyntaxExpression {
    parserExpect(cursor, "[")
    val values: array<SyntaxExpression> = []
    var more = !parserAt(cursor, "]")
    while (more) {
        if (parserAt(cursor, ",")) {
            // Report a stray comma once and go on after it.
            parserFail(cursor, "expected a \$json array element before `,`")
            parserConsume(cursor, ",")
            parserRawSkipWhitespace(cursor)
            more = !parserAt(cursor, "]")
        } else {
            values.append(ablaJsonParseForm(cursor, streamed))
            // A comma may follow the last element.
            more = parserConsume(cursor, ",")
            if (more) parserRawSkipWhitespace(cursor)
            if (more && parserAt(cursor, "]")) more = false
        }
    }
    ablaJsonExpect(cursor, "]", "expected `,` or `]` after a \$json array element")
    ablaJsonSyntaxCall("ablaJsonArray", syntaxArray(values))
}

/// Returns syntax for a JSON object with optional guarded members and reports malformed fields or delimiters through the cursor.
compile fun ablaJsonParseObject(cursor: ParserCursor, streamed: bool = false): SyntaxExpression {
    val prefix = "ablaJsonObject_${parserSiteKey(cursor)}"
    parserExpect(cursor, "{")
    val keys: array<SyntaxExpression> = []
    val values: array<SyntaxExpression> = []
    val guards: array<SyntaxExpression> = []
    var guarded = false
    // Literal keys seen so far: a repeated one is an error, as jsonParse's default
    // rejects a duplicate key.
    val literalKeys: array<string> = []
    var computed = false
    var more = !parserAt(cursor, "}")
    while (more) {
        if (parserAt(cursor, ",")) {
            // Report a stray comma once and go on after it.
            parserFail(cursor, "expected a \$json object member before `,`")
            parserConsume(cursor, ",")
            parserRawSkipWhitespace(cursor)
            more = !parserAt(cursor, "}")
        } else {
            var condition = syntaxNull()
            val hasCondition = parserConsume(cursor, "if")
            if (hasCondition) {
                ablaJsonExpect(cursor, "(", "expected `(` after a \$json member guard")
                condition = parserParseAblaExpression(cursor)
                ablaJsonExpect(cursor, ")", "expected `)` after a \$json member condition")
            }
            // A key that is not a string literal must still be a string.
            var key = parserParseAblaExpression(cursor)
            // Preserve an existing computed key of the form `if (...) a else b`.
            if (hasCondition && parserConsume(cursor, "else")) {
                key = syntaxIf(condition, key, parserParseAblaExpression(cursor))
                guards.append(syntaxNull())
            } else {
                if (hasCondition) guarded = true
                guards.append(if (hasCondition) ablaJsonSyntaxCall("ablaJsonGuard", condition) else syntaxNull())
            }
            if (syntaxKind(key) == "string") {
                val text = syntaxText(key)
                for (seen in literalKeys) {
                    if (seen == text) parserFail(cursor,
                        "duplicate key \"$text\" in a \$json object")
                }
                literalKeys.append(text)
                keys.append(key)
            } else {
                computed = true
                keys.append(ablaJsonSyntaxCall("ablaJsonKey", key))
            }
            ablaJsonExpect(cursor, ":", "expected `:` after a \$json object key")
            values.append(ablaJsonParseForm(cursor, streamed))
            // A comma may follow the last member.
            more = parserConsume(cursor, ",")
            if (more) parserRawSkipWhitespace(cursor)
            if (more && parserAt(cursor, "}")) more = false
        }
    }
    ablaJsonExpect(cursor, "}", "expected `,` or `}` after a \$json object member")
    val arguments: array<SyntaxExpression> = []
    arguments.append(syntaxArray(keys))
    arguments.append(syntaxArray(values))
    if (guarded) arguments.append(syntaxArray(guards))
    // A computed key may repeat another (decision #154): the tree form merges such an object at run time, the later member winning.
    val object = syntaxCall(if (computed && !streamed) "ablaJsonObjectMerged" else "ablaJsonObject", arguments)
    if (guarded && !streamed) ablaJsonGuardedTree(object, prefix) else object
}

/// Appends pre-encoded JSON when every node is literal. Returns false when
/// ordinary evaluation or validation is needed. Discard the buffer on false.
private compile fun ablaJsonAppendStatic(
    var output: ByteBuffer,
    expression: SyntaxExpression,
    depth: int
): bool {
    // Folding is optional. Deeper trees keep the ordinary writer and its guard.
    if (depth >= 8) return false
    val name = syntaxText(expression)
    if (name == "ablaJsonArray" || name == "ablaJsonObject") {
        val object = name == "ablaJsonObject"
        if (object && syntaxChildCount(expression) != 2) return false
        val keys = syntaxChild(expression, 0)
        val values = if (object) syntaxChild(expression, 1) else keys
        output.appendText(if (object) "{" else "[")
        for (index in 0 until syntaxChildCount(values)) {
            if (index > 0) output.appendText(",")
            if (object) {
                val key = syntaxChild(keys, index)
                if (syntaxKind(key) != "string" || !syntaxText(key).isValidUtf8()) return false
                output.appendText(jsonQuote(syntaxText(key)))
                output.appendText(":")
            }
            if (!ablaJsonAppendStatic(output, syntaxChild(values, index), depth + 1)) return false
        }
        output.appendText(if (object) "}" else "]")
    } else if (name == "ablaJsonNull") output.appendText("null")
    else if (name == "ablaJsonNumberText") output.appendText(syntaxText(syntaxChild(expression, 0)))
    else if (name == "ablaJsonBoolean") output.appendText(
        if (syntaxKind(syntaxChild(expression, 0)) == "true") "true" else "false"
    )
    else if (name == "ablaJsonString") output.appendText(jsonQuote(syntaxText(syntaxChild(expression, 0))))
    else return false
    true
}

/// Returns compact JSON text, folding shallow static literals after a successful parse.
compile fun ablaJsonParseStringifiedValue(
    cursor: ParserCursor
): SyntaxExpression = ablaJsonSyntaxCall(
    "jsonStringify", ablaJsonParseValue(cursor)
)

// Registers the JSON literal parser that returns a typed JSON value and reports malformed syntax.
#compilerRegisterSubparser("json", ablaJsonParseValue)
// Registers the JSON literal parser that returns a serialized string and reports malformed syntax.
#compilerRegisterSubparser("jsons", ablaJsonParseStringifiedValue)

// The tree form allocates this builder only for objects with guarded members.
// Streaming lowers the same parsed members directly, without this runtime data.
class JsonLiteralObject(val keys: array<string>, val values: array<Json>)
/// Returns a builder with no members for a guarded JSON object.
fun ablaJsonLiteralObject(): JsonLiteralObject = JsonLiteralObject([], [])
/// Appends one key and its value to the guarded object builder.
fun ablaJsonLiteralMember(var object: JsonLiteralObject, key: string, value: Json): void {
    object.keys.append(key)
    object.values.append(value)
    return
}
/// Returns the completed JSON object or JSON null if a key is invalid UTF-8 or the key and value counts differ.
fun ablaJsonLiteralFinish(object: JsonLiteralObject): Json = jsonObject(object.keys, object.values)
/// Returns the completed JSON object of a guarded object with a computed key, a repeated key merged as ablaJsonObjectMerged does, or JSON null if a key is invalid UTF-8.
fun ablaJsonLiteralFinishMerged(object: JsonLiteralObject): Json = ablaJsonObjectMerged(object.keys, object.values)

/// Holds the generated guard and key expressions and the condition that all selected keys are valid.
compile class JsonObjectSyntaxKeys(
    val statements: array<SyntaxExpression>,
    val guards: array<string>,
    val keys: array<string>,
    var valid: SyntaxExpression,
    var nextKey: int,
    // True when a computed or invalid literal key requires generated validity checks.
    var checked: bool = false
)

// Evaluate guards and selected computed keys once, before any values. A false
// guard skips its key and value; an invalid selected key makes the object null.
compile fun ablaJsonGuardedKeys(expression: SyntaxExpression, prefix: string, first: int): JsonObjectSyntaxKeys {
    val prepared = JsonObjectSyntaxKeys([], [], [], syntaxBoolean(true), first)
    val keys = syntaxChild(expression, 0)
    val guards = syntaxChild(expression, 2)
    for (index in 0 until syntaxChildCount(keys)) {
        val condition = syntaxChild(guards, index)
        var guard = ""
        if (syntaxKind(condition) != "null") {
            guard = "${prefix}_guard${prepared.nextKey}"
            prepared.nextKey = prepared.nextKey + 1
            prepared.statements.append(syntaxLocal(guard, compilerFindType("bool"), syntaxChild(condition, 0)))
        }
        prepared.guards.append(guard)
        val key = syntaxChild(keys, index)
        if (syntaxKind(key) == "string") {
            prepared.keys.append("")
            if (!syntaxText(key).isValidUtf8()) {
                prepared.checked = true
                val valid = if (guard == "") syntaxBoolean(false)
                    else syntaxBinary("==", syntaxIdentifier(guard), syntaxBoolean(false))
                prepared.valid = syntaxBinary("&&", prepared.valid, valid)
            }
        } else {
            prepared.checked = true
            val name = "${prefix}_key${prepared.nextKey}"
            prepared.nextKey = prepared.nextKey + 1
            prepared.keys.append(name)
            val selected = if (guard == "") key
                else syntaxIf(syntaxIdentifier(guard), key, syntaxString(""))
            prepared.statements.append(syntaxLocal(name, compilerFindType("string"), selected))
            prepared.valid = syntaxBinary("&&", prepared.valid,
                syntaxCall("ablaJsonWriteKeyValid", [syntaxIdentifier(name)]))
        }
    }
    prepared
}

/// Returns syntax that builds an object from selected members or yields JSON null if a selected key is invalid.
compile fun ablaJsonGuardedTree(expression: SyntaxExpression, prefix: string): SyntaxExpression {
    val prepared = ablaJsonGuardedKeys(expression, prefix, 0)
    val keys = syntaxChild(expression, 0)
    val values = syntaxChild(expression, 1)
    val name = "${prefix}_builder"
    val body: array<SyntaxExpression> = [syntaxLocal(name, compilerFindType("JsonLiteralObject"),
        syntaxCall("ablaJsonLiteralObject", []))]
    for (index in 0 until syntaxChildCount(keys)) {
        val key = if (prepared.keys[index] == "") syntaxChild(keys, index)
            else syntaxIdentifier(prepared.keys[index])
        val member = syntaxCall("ablaJsonLiteralMember", [syntaxIdentifier(name), key, syntaxChild(values, index)])
        if (prepared.guards[index] == "") body.append(member)
        else body.append(syntaxIf(syntaxIdentifier(prepared.guards[index]), member, syntaxBlock([])))
    }
    // With a computed key the members are merged, the later one winning (decision #154).
    var computed = false
    for (local in prepared.keys) { if (local != "") computed = true }
    body.append(syntaxCall(if (computed) "ablaJsonLiteralFinishMerged" else "ablaJsonLiteralFinish", [syntaxIdentifier(name)]))
    prepared.statements.append(syntaxIf(prepared.valid, syntaxBlock(body), syntaxCall("ablaJsonNull", [])))
    syntaxBlock(prepared.statements)
}

// A compile-time plan, never a runtime writer or Json tree. Parsing is shared
// with `$json`: only the constructor syntax produced by that parser is lowered.
compile class JsonWriteSyntaxPlan(
    var sink: SyntaxExpression,
    val prefix: string,
    val statements: array<SyntaxExpression>,
    var pending: string,
    var nextKey: int,
    // The selected buffer append method, or -1 when the typed helper is needed.
    var textTarget: int = -1
)

/// Returns syntax that appends a static fragment directly to the buffer, using
/// the typed helper when its method cannot be resolved. An incompatible sink
/// is diagnosed when the generated expression is type checked.
compile fun ablaJsonWriteTextCall(var plan: JsonWriteSyntaxPlan, text: string): SyntaxExpression {
    // Aliased imports can give the receiver a canonical module prefix that
    // the source-spelled method lookup cannot find. Retain the typed helper
    // there, resolving its target in this provider's module.
    if (plan.textTarget < 0) return syntaxCallTarget(compilerFindFunction("ablaJsonWriteText"),
        [ablaJsonWriteSink(plan.sink), syntaxString(text)])
    syntaxMethodCallTarget(plan.textTarget, ablaJsonWriteSink(plan.sink), [syntaxString(text)])
}

// Coalesces pending literal bytes into one append statement and clears the pending text.
compile fun ablaJsonWriteFlush(var plan: JsonWriteSyntaxPlan): void {
    if (plan.pending != "") {
        plan.statements.append(ablaJsonWriteTextCall(plan, plan.pending))
        plan.pending = ""
    }
    return
}

// Public because generated calls resolve in the importing module.
fun ablaJsonWriteText(var out: ByteBuffer, text: string): void = out.appendText(text)

// Flushes pending text and emits a typed buffer-write call for a dynamic JSON value.
compile fun ablaJsonWriteLeaf(
    var plan: JsonWriteSyntaxPlan,
    value: SyntaxExpression
): void {
    ablaJsonWriteFlush(plan)
    plan.statements.append(syntaxCall("ablaJsonWriteValue", [ablaJsonWriteSink(plan.sink), value]))
    return
}

// Lowers the JSON constructor syntax produced by the literal parser into buffer-write statements.
compile fun ablaJsonWriteLower(
    var plan: JsonWriteSyntaxPlan,
    expression: SyntaxExpression
): void {
    val name = syntaxText(expression)
    if (name == "ablaJsonNull") plan.pending = plan.pending + "null"
    else if (name == "ablaJsonNumberText") {
        // Exact spelling was selected and checked by the shared value parser.
        plan.pending = plan.pending + syntaxText(syntaxChild(expression, 0))
    } else if (name == "ablaJsonString") {
        val value = syntaxChild(expression, 0)
        if (syntaxKind(value) == "string") {
            plan.pending = plan.pending + jsonQuote(syntaxText(value))
        } else ablaJsonWriteLeaf(plan, value)
    } else if (name == "ablaJsonBoolean") {
        plan.pending = plan.pending +
            if (syntaxKind(syntaxChild(expression, 0)) == "true") "true" else "false"
    } else if (name == "ablaJsonValue") {
        ablaJsonWriteLeaf(plan, syntaxChild(expression, 0))
    } else if (name == "ablaJsonArray") {
        plan.pending = plan.pending + "["
        val values = syntaxChild(expression, 0)
        for (index in 0 until syntaxChildCount(values)) {
            if (index > 0) plan.pending = plan.pending + ","
            ablaJsonWriteLower(plan, syntaxChild(values, index))
        }
        plan.pending = plan.pending + "]"
    } else if (name == "ablaJsonObject") ablaJsonWriteObject(plan, expression)
    return
}

// Lowers one object into buffer writes, evaluating computed keys once and emitting JSON null if any key is invalid UTF-8.
compile fun ablaJsonWriteObject(
    var plan: JsonWriteSyntaxPlan,
    expression: SyntaxExpression
): void {
    if (syntaxChildCount(expression) > 2) {
        ablaJsonWriteGuardedObject(plan, expression)
        return
    }
    val keys = syntaxChild(expression, 0)
    val values = syntaxChild(expression, 1)
    val count = syntaxChildCount(keys)
    val keyNames: array<string> = []
    var dynamic = false
    var invalidLiteral = false
    for (index in 0 until count) {
        val key = syntaxChild(keys, index)
        if (syntaxKind(key) != "string") dynamic = true
        else if (!syntaxText(key).isValidUtf8()) invalidLiteral = true
    }
    if (invalidLiteral) {
        plan.pending = plan.pending + "null"
        return
    }
    // As in jsonObject, an invalid UTF-8 key makes this whole object null.
    // Bind computed keys once, before the values, just as `$json` does.
    var valid = syntaxBoolean(true)
    if (dynamic) {
        ablaJsonWriteFlush(plan)
        for (index in 0 until count) {
            val key = syntaxChild(keys, index)
            if (syntaxKind(key) == "string") keyNames.append("")
            else {
                val local = "${plan.prefix}_key${plan.nextKey}"
                plan.nextKey = plan.nextKey + 1
                keyNames.append(local)
                plan.statements.append(syntaxLocal(local, compilerFindType("string"), key))
                valid = syntaxBinary("&&", valid, syntaxCall("ablaJsonWriteKeyValid", [syntaxIdentifier(local)]))
            }
        }
        // A computed key may repeat another: the members are merged as the tree form merges them (decision #154).
        val keyExpressions: array<SyntaxExpression> = []
        val noGuards: array<string> = []
        for (index in 0 until count) {
            keyExpressions.append(if (keyNames[index] == "") syntaxChild(keys, index) else syntaxIdentifier(keyNames[index]))
            noGuards.append("")
        }
        ablaJsonWriteMergedObject(plan, keyExpressions, values, noGuards, valid)
        return
    }
    val body = JsonWriteSyntaxPlan(plan.sink, plan.prefix, [], plan.pending, plan.nextKey, plan.textTarget)
    plan.pending = ""
    body.pending = body.pending + "{"
    for (index in 0 until count) {
        if (index > 0) body.pending = body.pending + ","
        val key = syntaxChild(keys, index)
        if (syntaxKind(key) == "string") {
            body.pending = body.pending + jsonQuote(syntaxText(key)) + ":"
        } else {
            ablaJsonWriteLeaf(body, syntaxIdentifier(keyNames[index]))
            body.pending = body.pending + ":"
        }
        ablaJsonWriteLower(body, syntaxChild(values, index))
    }
    body.pending = body.pending + "}"
    if (dynamic) {
        ablaJsonWriteFlush(body)
        plan.nextKey = body.nextKey
        plan.statements.append(syntaxIf(valid, syntaxBlock(body.statements),
            ablaJsonWriteTextCall(plan, "null")))
    } else {
        for (statement in body.statements) plan.statements.append(statement)
        plan.pending = body.pending
        plan.nextKey = body.nextKey
    }
    return
}

// Returns true if the supplied object key contains valid UTF-8.
fun ablaJsonWriteKeyValid(key: string): bool = key.isValidUtf8()

// `$jsonw` objects with a computed key (decision #154): each member's value is written to a buffer of its own, in source order, and the members are
// merged as the tree form merges them (ablaJsonMergeOrder) before the object is written. Objects without a computed key are written directly.
class JsonWrittenMembers(val keys: array<string>, val texts: array<string>)
/// Returns an empty member list for a `$jsonw` object with a computed key.
fun ablaJsonWrittenMembers(): JsonWrittenMembers = JsonWrittenMembers([], [])
/// Returns a buffer for one member's value of a `$jsonw` object with a computed key.
fun ablaJsonWrittenValue(): ByteBuffer = byteBuffer()
/// Records one member: its key and the JSON text written for its value.
fun ablaJsonWrittenMember(var members: JsonWrittenMembers, key: string, var value: ByteBuffer): void {
    members.keys.append(key)
    members.texts.append(value.toText())
    return
}
/// Writes the recorded members as one object, a repeated key merged (the later member wins, at the first one's position).
fun ablaJsonWriteMerged(var out: ByteBuffer, members: JsonWrittenMembers): void {
    out.appendText("{")
    var first = true
    for (index in ablaJsonMergeOrder(members.keys)) {
        if (!first) out.appendText(",")
        first = false
        ablaJsonWriteValue(out, members.keys[index])
        out.appendText(":")
        out.appendText(members.texts[index])
    }
    out.appendText("}")
    return
}

/// Adds syntax that writes an object with a computed key through JsonWrittenMembers: `keys` are the key expressions (literals or the bound
/// locals), `guards` the guard locals ("" for none); null is written instead when `valid` is false.
compile fun ablaJsonWriteMergedObject(var plan: JsonWriteSyntaxPlan, keys: array<SyntaxExpression>, values: SyntaxExpression,
    guards: array<string>, valid: SyntaxExpression): void {
    ablaJsonWriteFlush(plan)
    val members = "${plan.prefix}_members${plan.nextKey}"
    plan.nextKey = plan.nextKey + 1
    val body: array<SyntaxExpression> = [syntaxLocal(members, compilerFindType("JsonWrittenMembers"), syntaxCall("ablaJsonWrittenMembers", []))]
    for (index in 0 until keys.size) {
        val buffer = "${plan.prefix}_member${plan.nextKey}"
        plan.nextKey = plan.nextKey + 1
        val member = JsonWriteSyntaxPlan(syntaxIdentifier(buffer), plan.prefix, [], "", plan.nextKey, plan.textTarget)
        member.statements.append(syntaxLocal(buffer, compilerFindType("ByteBuffer"), syntaxCall("ablaJsonWrittenValue", [])))
        ablaJsonWriteLower(member, syntaxChild(values, index))
        ablaJsonWriteFlush(member)
        plan.nextKey = member.nextKey
        member.statements.append(syntaxCall("ablaJsonWrittenMember", [syntaxIdentifier(members), keys[index], syntaxIdentifier(buffer)]))
        if (guards[index] == "") {
            for (statement in member.statements) body.append(statement)
        } else body.append(syntaxIf(syntaxIdentifier(guards[index]), syntaxBlock(member.statements), syntaxBlock([])))
    }
    body.append(syntaxCall("ablaJsonWriteMerged", [ablaJsonWriteSink(plan.sink), syntaxIdentifier(members)]))
    plan.statements.append(syntaxIf(valid, syntaxBlock(body), ablaJsonWriteTextCall(plan, "null")))
    return
}

/// Adds syntax to stream the selected object members or write null if a selected key is invalid.
compile fun ablaJsonWriteGuardedObject(var plan: JsonWriteSyntaxPlan, expression: SyntaxExpression): void {
    ablaJsonWriteFlush(plan)
    val prepared = ablaJsonGuardedKeys(expression, plan.prefix, plan.nextKey)
    for (statement in prepared.statements) plan.statements.append(statement)
    // A computed key may repeat another: the members are merged as the tree form merges them (decision #154).
    var computed = false
    for (local in prepared.keys) { if (local != "") computed = true }
    if (computed) {
        plan.nextKey = prepared.nextKey
        val guardedKeys = syntaxChild(expression, 0)
        val keyExpressions: array<SyntaxExpression> = []
        for (index in 0 until syntaxChildCount(guardedKeys)) {
            keyExpressions.append(if (prepared.keys[index] == "") syntaxChild(guardedKeys, index) else syntaxIdentifier(prepared.keys[index]))
        }
        ablaJsonWriteMergedObject(plan, keyExpressions, syntaxChild(expression, 1), prepared.guards, prepared.valid)
        return
    }
    val body = JsonWriteSyntaxPlan(plan.sink, plan.prefix, [], "{", prepared.nextKey, plan.textTarget)
    val keys = syntaxChild(expression, 0)
    val values = syntaxChild(expression, 1)
    val comma = "${plan.prefix}_comma${body.nextKey}"
    body.nextKey = body.nextKey + 1
    val needsComma = prepared.guards[0] != "" && syntaxChildCount(keys) > 1
    if (needsComma) body.statements.append(
        syntaxVariable(comma, compilerFindType("bool"), syntaxBoolean(false)))
    var alwaysMember = false
    var possibleMember = false
    for (index in 0 until syntaxChildCount(keys)) {
        val guarded = prepared.guards[index] != ""
        if (guarded) ablaJsonWriteFlush(body)
        val member = JsonWriteSyntaxPlan(plan.sink, plan.prefix, [], body.pending, body.nextKey, plan.textTarget)
        body.pending = ""
        if (alwaysMember) member.pending = member.pending + ","
        else if (possibleMember) member.statements.append(syntaxIf(syntaxIdentifier(comma),
            ablaJsonWriteTextCall(plan, ","), syntaxBlock([])))
        val key = syntaxChild(keys, index)
        if (syntaxKind(key) == "string") member.pending = member.pending + jsonQuote(syntaxText(key)) + ":"
        else {
            ablaJsonWriteLeaf(member, syntaxIdentifier(prepared.keys[index]))
            member.pending = member.pending + ":"
        }
        ablaJsonWriteLower(member, syntaxChild(values, index))
        if (guarded) {
            ablaJsonWriteFlush(member)
            if (!alwaysMember && needsComma) member.statements.append(syntaxAssign(comma, syntaxBoolean(true)))
            body.statements.append(syntaxIf(syntaxIdentifier(prepared.guards[index]), syntaxBlock(member.statements), syntaxBlock([])))
        } else {
            // Keep the unconditional prefix and adjacent static tokens coalesced.
            for (statement in member.statements) body.statements.append(statement)
            body.pending = member.pending
            alwaysMember = true
        }
        possibleMember = true
        body.nextKey = member.nextKey
    }
    body.pending = body.pending + "}"
    ablaJsonWriteFlush(body)
    plan.nextKey = body.nextKey
    if (prepared.checked) plan.statements.append(syntaxIf(prepared.valid, syntaxBlock(body.statements),
        ablaJsonWriteTextCall(plan, "null")))
    else for (statement in body.statements) plan.statements.append(statement)
    return
}

// `$jsonw(buffer) value` appends one complete value and returns that buffer.
// The sink is evaluated once. Static tokens collapse into one append per run;
// dynamic leaves use ordinary type-checked calls and create no Json nodes.
compile fun ablaJsonParseWrittenValue(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "(")
    val sink = parserParseAblaExpression(cursor)
    parserExpect(cursor, ")")
    val name = "ablaJsonSink_${parserSiteKey(cursor)}"
    val plan = JsonWriteSyntaxPlan(syntaxIdentifier(name), name, [], "", 0,
        compilerFindFunction("ByteBuffer.appendText"))
    if (syntaxKind(sink) == "identifier" || syntaxKind(sink) == "member" || syntaxKind(sink) == "index") {
        if (!ablaJsonWriteStablePlace(sink)) {
            parserFail(cursor, "a \$jsonw sink must be a stable buffer place or a fresh buffer expression")
        }
        plan.sink = ablaJsonWritePlace(plan, sink)
    } else plan.statements.append(syntaxLocal(name, compilerFindType("ByteBuffer"), sink))
    ablaJsonWriteLower(plan, ablaJsonParseForm(cursor, true))
    ablaJsonWriteFlush(plan)
    plan.statements.append(ablaJsonWriteSink(plan.sink))
    syntaxBlock(plan.statements)
}

// Registers the JSON writer literal that appends a value to a mutable buffer and reports malformed syntax.
#compilerRegisterSubparser("jsonw", ablaJsonParseWrittenValue)

// Appends a JSON array of strings, encoding invalid UTF-8 elements as null.
fun ablaJsonWriteValue(var out: ByteBuffer, values: array<string>): void {
    out.appendText("[")
    var index = 0
    for (value in values) {
        if (index > 0) out.appendText(",")
        ablaJsonWriteValue(out, value)
        index = index + 1
    }
    out.appendText("]")
    return
}

/// Appends a JSON array with null for each absent or invalid UTF-8 input.
fun ablaJsonWriteValue(var out: ByteBuffer, values: array<string?>): void {
    out.appendText("[")
    var index = 0
    for (value in values) {
        if (index > 0) out.appendText(",")
        ablaJsonWriteValue(out, value)
        index = index + 1
    }
    out.appendText("]")
    return
}

// Appends a JSON array of decimal integers in input order.
fun ablaJsonWriteValue(var out: ByteBuffer, values: array<int>): void {
    out.appendText("[")
    var index = 0
    for (value in values) {
        if (index > 0) out.appendText(",")
        ablaJsonWriteValue(out, value)
        index = index + 1
    }
    out.appendText("]")
    return
}

// Appends a JSON array of boolean literals in input order.
fun ablaJsonWriteValue(var out: ByteBuffer, values: array<bool>): void {
    out.appendText("[")
    var index = 0
    for (value in values) {
        if (index > 0) out.appendText(",")
        ablaJsonWriteValue(out, value)
        index = index + 1
    }
    out.appendText("]")
    return
}

// Appends a JSON array of round-trippable numbers, encoding NaN and infinity as null.
fun ablaJsonWriteValue(var out: ByteBuffer, values: array<f64>): void {
    out.appendText("[")
    var index = 0
    for (value in values) {
        if (index > 0) out.appendText(",")
        ablaJsonWriteValue(out, value)
        index = index + 1
    }
    out.appendText("]")
    return
}

// Appends a JSON array of the supplied nodes in input order.
fun ablaJsonWriteValue(var out: ByteBuffer, values: array<Json>): void {
    out.appendText("[")
    var index = 0
    for (value in values) {
        if (index > 0) out.appendText(",")
        ablaJsonWriteValue(out, value)
        index = index + 1
    }
    out.appendText("]")
    return
}

// Rebuild the stable place for each use; no mutable borrow is saved as a val.
compile fun ablaJsonWriteStablePlace(place: SyntaxExpression): bool {
    val kind = syntaxKind(place)
    if (kind == "identifier") true
    else if (kind == "member" || kind == "index") ablaJsonWriteStablePlace(syntaxChild(place, 0))
    else false
}

// Returns syntax for reusing a stable buffer place without reevaluating its captured indices.
compile fun ablaJsonWriteSink(place: SyntaxExpression): SyntaxExpression {
    val kind = syntaxKind(place)
    if (kind == "member") syntaxMember(ablaJsonWriteSink(syntaxChild(place, 0)), syntaxText(place))
    else if (kind == "index") syntaxIndex(ablaJsonWriteSink(syntaxChild(place, 0)),
        syntaxIdentifier(syntaxText(syntaxChild(place, 1))))
    else syntaxIdentifier(syntaxText(place))
}

// Returns a stable buffer place and stages locals so its index expressions are evaluated once.
compile fun ablaJsonWritePlace(
    var plan: JsonWriteSyntaxPlan,
    place: SyntaxExpression
): SyntaxExpression {
    val kind = syntaxKind(place)
    if (kind == "member") syntaxMember(ablaJsonWritePlace(plan, syntaxChild(place, 0)), syntaxText(place))
    else if (kind == "index") {
        val receiver = ablaJsonWritePlace(plan, syntaxChild(place, 0))
        val index = "${plan.prefix}_index${plan.nextKey}"
        plan.nextKey = plan.nextKey + 1
        plan.statements.append(syntaxLocal(index, compilerFindType("int"), syntaxChild(place, 1)))
        syntaxIndex(receiver, syntaxIdentifier(index))
    } else place
}

// --- Decoding with a typed outcome ---------------------------------------------------------------------------------
// jsonParse answers with a result whose `value` is JSON null on failure, so a caller that forgets `succeeded` reads a
// null. jsonDecode answers with one of three cases and a `when` over it must say what each does.

/// What jsonDecode answers: the value, or why there is none. The cases are JsonParsed, JsonMalformed and JsonLimitExceeded.
sealed interface JsonDecoded

/// What jsonDecodeDocument answers: the document, or why there is none. The cases are JsonParsedDocument, JsonMalformed and
/// JsonLimitExceeded.
sealed interface JsonDecodedDocument

/// The input is one JSON value within the limits: `value` is it.
class JsonParsed(val value: Json) : JsonDecoded

/// The input is one JSON document within the limits: `document` is it.
class JsonParsedDocument(val document: JsonDocument) : JsonDecodedDocument

/// The input is not JSON, or breaks a rule of the grammar the limits do not govern. `error.code` is `unexpected_token`,
/// `unexpected_end`, `invalid_number`, `trailing_input`, `invalid_unicode` or `duplicate_key`.
class JsonMalformed(val error: JsonError) : JsonDecoded, JsonDecodedDocument

/// The input is more than the limits allow (JsonLimits), however well formed. `error.code` is `input_limit`, `node_limit` or
/// `depth_limit`.
class JsonLimitExceeded(val error: JsonError) : JsonDecoded, JsonDecodedDocument

private fun jsonErrorIsLimit(error: JsonError): bool =
    error.code == "input_limit" || error.code == "node_limit" || error.code == "depth_limit"

/// `source` decoded under `limits` with jsonParse's rules: JsonParsed with the value, JsonMalformed or JsonLimitExceeded with
/// the error jsonParse reports.
fun jsonDecode(source: string, limits: JsonLimits = jsonDefaultLimits()): JsonDecoded {
    val parsed = jsonParse(source, limits)
    if (parsed.succeeded) return JsonParsed(parsed.value)
    if (jsonErrorIsLimit(parsed.error)) return JsonLimitExceeded(parsed.error)
    JsonMalformed(parsed.error)
}

/// jsonDecode into a tape document (jsonDocument's), for the same input and limits.
fun jsonDecodeDocument(source: string, limits: JsonLimits = jsonDefaultLimits()): JsonDecodedDocument {
    val parsed = jsonDocument(source, limits)
    if (parsed.succeeded) return JsonParsedDocument(parsed.document)
    if (jsonErrorIsLimit(parsed.error)) return JsonLimitExceeded(parsed.error)
    JsonMalformed(parsed.error)
}
