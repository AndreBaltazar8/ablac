// One raw pass handles the common JSON-string case. Keeping the source data
// pointer and length outside the loop avoids re-entering generic string
// indexing for every byte while preserving the full UTF-8 boundary checks.
noescape extern:"intrinsic" fun ablaJsonStringIsPlain(
    value: string
): bool

private fun jsonStringIsPlain(value: string): bool =
    ablaJsonStringIsPlain(value)

@noinline
fun jsonAppendStringPortable(var output: ByteBuffer, value: string): bool {
    var offset = 0
    var valid = jsonStringIsPlain(value)
    if (valid) {
        output.appendText("\"")
        output.appendText(value)
        output.appendText("\"")
    } else {
        valid = true
        output.appendText("\"")
        offset = 0
        val hex = "0123456789abcdef"
        while (valid && offset < value.size) {
            val byte = value[offset]
            if (byte == 34) output.appendText("\\\"")
            else if (byte == 92) output.appendText("\\\\")
            else if (byte == 8) output.appendText("\\b")
            else if (byte == 12) output.appendText("\\f")
            else if (byte == 10) output.appendText("\\n")
            else if (byte == 13) output.appendText("\\r")
            else if (byte == 9) output.appendText("\\t")
            else if (byte < 32) {
                output.appendText("\\u00")
                output.appendText(hex.slice(byte / 16, byte / 16 + 1))
                val low = byte - (byte / 16) * 16
                output.appendText(hex.slice(low, low + 1))
            } else if (byte < 128) {
                output.appendText(value.slice(offset, offset + 1))
            } else {
                val length = utf8SequenceLength(byte)
                if (!utf8SequenceValid(value, offset, length)) {
                    valid = false
                }
                if (valid) output.appendText(
                    value.slice(offset, offset + length)
                )
                offset = offset + length - 1
            }
            offset = offset + 1
        }
        if (valid) output.appendText("\"")
    }
    valid
}


// Valid UTF-8 only: size once, then write the escaped bytes into one reserved
// span. The portable writer is the evaluator's; it is not in a runtime build.
@noinline
trusted fun jsonAppendEscapedNative(var output: ByteBuffer, value: string): void {
    val size = value.size
    val source = ablaUnsafeStringAddress(value)
    var length = 2
    var index = 0
    while (index < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + index))
        length = length + (if (byte == 34 || byte == 92 || byte == 8 ||
            byte == 12 || byte == 10 || byte == 13 || byte == 9) 2
            else if (byte < 32) 6 else 1)
        index = index + 1
    }
    val destination = output.stageReserve(length)
    ablaUnsafeStoreU8(nativePointerFromAddress(destination), 34)
    var written = 1
    index = 0
    while (index < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(source + index))
        if (byte == 34 || byte == 92 || byte < 32) {
            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), 92)
            written = written + 1
            val escape = if (byte == 8) 98 else if (byte == 12) 102
                else if (byte == 10) 110 else if (byte == 13) 114
                else if (byte == 9) 116 else byte
            if (byte >= 32 || escape != byte) {
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), escape)
                written = written + 1
            } else {
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), 117)
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 1), 48)
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 2), 48)
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 3), 48 + (byte >> 4))
                val low = byte & 15
                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + 4),
                    if (low < 10) 48 + low else 87 + low)
                written = written + 5
            }
        } else {
            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), byte)
            written = written + 1
        }
        index = index + 1
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), 34)
    output.staged = output.staged + length
    output.byteCount = output.byteCount + length
    return
}

// Short plain strings need one reservation instead of three token appends.
// Large strings retain the chunk path, avoiding an extra contents copy.
trusted fun jsonAppendPlainNative(var output: ByteBuffer, value: string): void {
    val length = value.size + 2
    val destination = output.stageReserve(length)
    ablaUnsafeStoreU8(nativePointerFromAddress(destination), 34)
    ablaUnsafeCopyMemory(destination + 1, ablaUnsafeStringAddress(value), value.size)
    ablaUnsafeStoreU8(nativePointerFromAddress(destination + length - 1), 34)
    output.staged = output.staged + length
    output.byteCount = output.byteCount + length
    return
}

private fun jsonAppendString(var output: ByteBuffer, value: string): bool {
    if (jsonStringIsPlain(value)) {
        if (ablaAtCompileTime()) return jsonAppendStringPortable(output, value)
        else if (value.size < BYTE_BUFFER_LARGE) {
            jsonAppendPlainNative(output, value)
            return true
        }
        output.appendText("\"")
        output.appendText(value)
        output.appendText("\"")
        return true
    }
    if (ablaAtCompileTime()) return jsonAppendStringPortable(output, value)
    else {
        // Every caller marks its writer invalid on false; nothing reads the
        // partial output, so invalid UTF-8 needs no portable rewrite.
        if (!value.isValidUtf8()) return false
        jsonAppendEscapedNative(output, value)
        true
    }
}

private fun jsonWriteString(var writer: JsonWriter, value: string): void {
    if (writer.valid) writer.valid = jsonAppendString(writer.output, value)
}

// Encode one UTF-8 string as a complete JSON string literal without building
// a dynamic `Json` tree. Protocol adapters can use this for streaming object
// envelopes while retaining the same escaping and validation rules as
// `jsonStringify`.
fun jsonQuote(value: string): string {
    if (jsonStringIsPlain(value)) "\"$value\""
    else {
        val writer = JsonWriter(byteBuffer(), true)
        jsonWriteString(writer, value)
        if (writer.valid) writer.output.toText() else "null"
    }
}

private fun jsonEncodeNull(): JsonEncoded = JsonEncoded("null", true)

fun jsonEncodeString(value: string): JsonEncoded =
    JsonEncoded(jsonQuote(value), value.isValidUtf8())

// Static schemas can precompute the complete quoted-key-and-colon token. This
// preserves ordinary JSON escaping while requiring one output append instead
// of separate key and colon fragments at runtime.
fun jsonEncodeObjectKey(value: string): JsonEncoded {
    val encoded = jsonEncodeString(value)
    JsonEncoded("${encoded.text}:", encoded.valid)
}

private fun jsonEncodeInteger(value: int): JsonEncoded = JsonEncoded("$value", true)

fun jsonEncodeBoolean(value: bool): JsonEncoded =
    JsonEncoded(if (value) "true" else "false", true)

fun jsonEncoder(): JsonEncoder = JsonEncoder(
    byteBuffer(), 0, 0, 0, 0, false, true
)

fun JsonEncoder.prepareValue(): void {
    if (this.depth == 0) {
        if (this.rootWritten) this.valid = false
        this.rootWritten = true
    } else {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) != 0) {
            if ((this.expectingValueBits & mask) == 0) this.valid = false
            this.expectingValueBits = this.expectingValueBits & ~mask
        } else {
            if ((this.nonEmptyBits & mask) != 0) {
                this.output.appendText(",")
            }
        }
        this.nonEmptyBits = this.nonEmptyBits | mask
    }
}

fun JsonEncoder.beginObject(): void {
    this.prepareValue()
    if (this.depth >= 63) this.valid = false
    if (this.valid) {
        this.output.appendText("{")
        val mask = 1 << this.depth
        this.objectBits = this.objectBits | mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth + 1
    }
}

fun JsonEncoder.beginArray(): void {
    this.prepareValue()
    if (this.depth >= 63) this.valid = false
    if (this.valid) {
        this.output.appendText("[")
        val mask = 1 << this.depth
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth + 1
    }
}

fun JsonEncoder.key(name: string): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) this.valid = jsonAppendString(this.output, name)
        if (this.valid) {
            this.output.appendText(":")
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

// Static protocol schemas may quote and validate a key at compile time with
// #jsonEncodeString, then append that trusted fragment without rescanning it
// for every encoded object.
fun JsonEncoder.encodedKey(key: JsonEncoded): void {
    if (this.depth <= 0 || !key.valid) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) {
            this.output.appendText(key.text)
            this.output.appendText(":")
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

fun JsonEncoder.encodedObjectKey(key: JsonEncoded): void {
    if (this.depth <= 0 || !key.valid) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid && (this.nonEmptyBits & mask) != 0) {
            this.output.appendText(",")
        }
        if (this.valid) {
            this.output.appendText(key.text)
            this.expectingValueBits = this.expectingValueBits | mask
        }
    }
}

fun JsonEncoder.string(value: string): void {
    this.prepareValue()
    if (this.valid) this.valid = jsonAppendString(this.output, value)
}

fun JsonEncoder.integer(value: int): void {
    this.prepareValue()
    if (this.valid) this.output.appendInt(value)
}

// A number the way JSON.stringify writes it: f64Text, and null for NaN and the
// infinities, which JSON cannot hold.
fun JsonEncoder.number(value: f64): void {
    this.prepareValue()
    if (this.valid) {
        if (value != value || value - value != 0.0) this.output.appendText("null")
        else this.output.appendF64(value)
    }
}

fun JsonEncoder.boolean(value: bool): void {
    this.prepareValue()
    val encoded = if (value) "true" else "false"
    if (this.valid) this.output.appendText(encoded)
}

fun JsonEncoder.nullValue(): void {
    this.prepareValue()
    if (this.valid) this.output.appendText("null")
}

fun JsonEncoder.endObject(): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) == 0 ||
            (this.expectingValueBits & mask) != 0) this.valid = false
        if (this.valid) this.output.appendText("}")
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth - 1
    }
}

fun JsonEncoder.endArray(): void {
    if (this.depth <= 0) this.valid = false
    if (this.valid) {
        val mask = 1 << (this.depth - 1)
        if ((this.objectBits & mask) != 0) this.valid = false
        if (this.valid) this.output.appendText("]")
        this.objectBits = this.objectBits & ~mask
        this.nonEmptyBits = this.nonEmptyBits & ~mask
        this.expectingValueBits = this.expectingValueBits & ~mask
        this.depth = this.depth - 1
    }
}

fun JsonEncoder.finish(): string {
    if (this.valid && this.rootWritten && this.depth == 0) {
        this.output.toText()
    } else "null"
}

fun jsonArrayEncoder(): JsonArrayEncoder {
    val encoder = JsonArrayEncoder(byteBuffer(), 0, true, false)
    encoder.output.appendText("[")
    encoder
}

fun JsonArrayEncoder.add(value: JsonEncoded): void {
    if (this.finished || !value.valid) this.valid = false
    if (this.valid) {
        if (this.count > 0) this.output.appendText(",")
        this.output.appendText(value.text)
        this.count = this.count + 1
    }
}

fun JsonArrayEncoder.finish(): JsonEncoded {
    if (this.finished) this.valid = false
    if (this.valid) this.output.appendText("]")
    this.finished = true
    JsonEncoded(if (this.valid) this.output.toText() else "null", this.valid)
}

fun jsonObjectEncoder(): JsonObjectEncoder {
    val encoder = JsonObjectEncoder(byteBuffer(), 0, true, false)
    encoder.output.appendText("{")
    encoder
}

fun JsonObjectEncoder.put(name: string, value: JsonEncoded): void {
    if (this.finished || !name.isValidUtf8() || !value.valid) {
        this.valid = false
    }
    if (this.valid) {
        if (this.count > 0) this.output.appendText(",")
        val writer = JsonWriter(this.output, true)
        jsonWriteString(writer, name)
        if (!writer.valid) this.valid = false
    }
    if (this.valid) {
        this.output.appendText(":")
        this.output.appendText(value.text)
        this.count = this.count + 1
    }
}

fun JsonObjectEncoder.finish(): JsonEncoded {
    if (this.finished) this.valid = false
    if (this.valid) this.output.appendText("}")
    this.finished = true
    JsonEncoded(if (this.valid) this.output.toText() else "null", this.valid)
}

private fun jsonWriteValue(var writer: JsonWriter, value: Json): void {
    if (value.kind == 0) writer.output.appendText("null")
    else if (value.kind == 1) jsonWriteString(writer, value.stringValue)
    else if (value.kind == 2) {
        if (jsonNumberGrammar(value.numberValue.text).valid) {
            writer.output.appendText(value.numberValue.text)
        } else writer.valid = false
    } else if (value.kind == 3) {
        writer.output.appendText(if (value.boolValue) "true" else "false")
    } else if (value.kind == 4) {
        writer.output.appendText("[")
        var index = 0
        while (writer.valid && index < value.values.size) {
            if (index > 0) writer.output.appendText(",")
            jsonWriteValue(writer, value.values[index])
            index = index + 1
        }
        if (writer.valid) writer.output.appendText("]")
    } else if (value.kind == 5) {
        if (value.keys.size != value.values.size) writer.valid = false
        if (writer.valid) writer.output.appendText("{")
        var index = 0
        while (writer.valid && index < value.keys.size) {
            if (index > 0) writer.output.appendText(",")
            jsonWriteString(writer, value.keys[index])
            if (writer.valid) writer.output.appendText(":")
            if (writer.valid) jsonWriteValue(writer, value.values[index])
            index = index + 1
        }
        if (writer.valid) writer.output.appendText("}")
    } else writer.valid = false
}

fun jsonStringify(value: Json): string {
    val writer = JsonWriter(byteBuffer(), true)
    jsonWriteValue(writer, value)
    if (writer.valid) writer.output.toText() else "null"
}

compile fun ablaJsonSyntaxCall(
    name: string,
    value: SyntaxExpression
): SyntaxExpression {
    val arguments: array<SyntaxExpression> = []
    arguments.append(value)
    syntaxCall(name, arguments)
}

// A value is a JSON object or array when it starts with `{` or `[`; anything
// else is an Abla expression. A number literal on its own keeps its source text
// (so 9223372036854775808 and 1.5e-2 stay exact), string, Boolean and null
// literals map directly, and any other expression is converted by its type
// through ablaJsonValue. Unlike JSON, an object or array may end in a comma.
compile fun ablaJsonParseValue(cursor: ParserCursor): SyntaxExpression {
    if (parserAt(cursor, "{")) ablaJsonParseObject(cursor)
    else if (parserAt(cursor, "[")) ablaJsonParseArray(cursor)
    else {
        val negative = parserAt(cursor, "-")
        val lexeme = parserTextAhead(cursor, if (negative) 1 else 0)
        val value = parserParseAblaExpression(cursor)
        val kind = syntaxKind(value)
        val literal = if (negative) {
            kind == "unary-" && syntaxChildCount(value) == 1 &&
                ablaJsonNumberLiteral(syntaxKind(syntaxChild(value, 0)))
        } else ablaJsonNumberLiteral(kind)
        val number = if (negative) "-$lexeme" else lexeme
        if (literal && jsonNumberKind(number) >= 0) {
            ablaJsonSyntaxCall("ablaJsonNumberText", syntaxString(number))
        } else if (kind == "null") {
            val arguments: array<SyntaxExpression> = []
            syntaxCall("ablaJsonNull", arguments)
        } else if (kind == "string") {
            ablaJsonSyntaxCall("ablaJsonString", value)
        } else if (kind == "true" || kind == "false") {
            ablaJsonSyntaxCall("ablaJsonBoolean", value)
        } else ablaJsonSyntaxCall("ablaJsonValue", value)
    }
}

compile fun ablaJsonNumberLiteral(kind: string): bool =
    kind == "integer" || kind == "float"

compile fun ablaJsonExpect(
    cursor: ParserCursor,
    token: string,
    message: string
) {
    if (!parserConsume(cursor, token)) parserFail(cursor, message)
}

compile fun ablaJsonParseArray(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "[")
    val values: array<SyntaxExpression> = []
    var more = !parserAt(cursor, "]")
    while (more) {
        if (parserAt(cursor, ",")) {
            // Report a stray comma once and go on after it.
            parserFail(cursor, "expected a \$json array element before `,`")
            parserConsume(cursor, ",")
            parserRawSkipWhitespace(cursor)
            more = !parserAt(cursor, "]")
        } else {
            values.append(ablaJsonParseValue(cursor))
            // A comma may follow the last element.
            more = parserConsume(cursor, ",")
            if (more) parserRawSkipWhitespace(cursor)
            if (more && parserAt(cursor, "]")) more = false
        }
    }
    ablaJsonExpect(cursor, "]", "expected `,` or `]` after a \$json array element")
    ablaJsonSyntaxCall("ablaJsonArray", syntaxArray(values))
}

compile fun ablaJsonParseObject(cursor: ParserCursor): SyntaxExpression {
    parserExpect(cursor, "{")
    val keys: array<SyntaxExpression> = []
    val values: array<SyntaxExpression> = []
    // Literal keys seen so far: a repeated one is an error, as jsonParse's default
    // rejects a duplicate key.
    val literalKeys: array<string> = []
    var more = !parserAt(cursor, "}")
    while (more) {
        if (parserAt(cursor, ",")) {
            // Report a stray comma once and go on after it.
            parserFail(cursor, "expected a \$json object member before `,`")
            parserConsume(cursor, ",")
            parserRawSkipWhitespace(cursor)
            more = !parserAt(cursor, "}")
        } else {
            // A key that is not a string literal must still be a string.
            val key = parserParseAblaExpression(cursor)
            if (syntaxKind(key) == "string") {
                val text = syntaxText(key)
                for (seen in literalKeys) {
                    if (seen == text) parserFail(cursor, "duplicate key \"$text\" in a \$json object")
                }
                literalKeys.append(text)
                keys.append(key)
            } else keys.append(ablaJsonSyntaxCall("ablaJsonKey", key))
            ablaJsonExpect(cursor, ":", "expected `:` after a \$json object key")
            values.append(ablaJsonParseValue(cursor))
            // A comma may follow the last member.
            more = parserConsume(cursor, ",")
            if (more) parserRawSkipWhitespace(cursor)
            if (more && parserAt(cursor, "}")) more = false
        }
    }
    ablaJsonExpect(cursor, "}", "expected `,` or `}` after a \$json object member")
    val arguments: array<SyntaxExpression> = []
    arguments.append(syntaxArray(keys))
    arguments.append(syntaxArray(values))
    syntaxCall("ablaJsonObject", arguments)
}

// `$jsons` shares the JSON grammar but produces its deterministic encoded
// string directly. In staged code, `#$jsons {...}` validates and serializes the
// literal at compile time, leaving only the frozen string in the program.
compile fun ablaJsonParseStringifiedValue(
    cursor: ParserCursor
): SyntaxExpression = ablaJsonSyntaxCall(
    "jsonStringify", ablaJsonParseValue(cursor)
)

#compilerRegisterSubparser("json", ablaJsonParseValue)
#compilerRegisterSubparser("jsons", ablaJsonParseStringifiedValue)
