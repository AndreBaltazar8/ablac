// Phase-safe JSON values, strict bounded parsing, deterministic serialization,
// and the `$json` parser provider. Kinds: 0 null, 1 string, 2 number,
// 3 boolean, 4 array, 5 object.

import "abla/array"
import "abla/bytes"
import "abla/compiler"
import "abla/compiler/parser"
import "abla/float/text"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// Holds a JSON number's original spelling and a signed integer value when `intAvailable` is true.
class JsonNumber(
    val text: string,
    val integer: bool,
    val intValue: int,
    val intAvailable: bool
)

// An object of jsonKeyIndexMembers members or more keeps in `stringValue`, which
// it has no other use for, an index for get and has: its member count, then an
// open addressing table of positions + 1 into `keys`, probed linearly from each
// key's FNV-1a hash and at most half full, all as 32-bit little-endian integers.
// (In a string so that a node stays this size, whatever it holds.) A repeated
// key finds its last position, as a scan does; a count that no longer matches
// `keys`, or no index, means a scan.
class Json(
    val kind: int,
    val stringValue: string,
    val intValue: int,
    val boolValue: bool,
    val keys: array<string>,
    val values: array<Json>,
    val numberValue: JsonNumber
)

// Holds a JSON diagnostic code, message, byte offset, line, and column.
class JsonError(
    val code: string,
    val message: string,
    val byteOffset: int,
    val line: int,
    val column: int
)

// The parsed value and success flag. On failure the value is JSON null and `error` locates the problem.
class JsonParseResult(
    val value: Json,
    val succeeded: bool,
    val error: JsonError
)

// Bounds input bytes, depth, nodes, decoded string bytes, and object members. Use `rejectDuplicateKeys` to disallow repeated keys or `mergeDuplicateKeys` to keep the first key position with the last value when repeats are allowed.
class JsonLimits(
    val maximumBytes: int,
    val maximumDepth: int,
    val maximumNodes: int,
    val maximumStringBytes: int,
    val maximumObjectMembers: int,
    val rejectDuplicateKeys: bool,
    // Allowed duplicate keys as JavaScript's JSON.parse reads them: a key
    // keeps its first position and takes its last value. (Off, a parsed
    // object keeps every member in source order.)
    val mergeDuplicateKeys: bool = false
)

// Reports whether the token follows JSON number grammar and uses integer syntax.
class JsonNumberGrammar(
    val valid: bool,
    val integer: bool
)

// Tracks the input, limits, cursor, node count, and first error for a JSON parse.
class JsonParserState(
    val source: string,
    val limits: JsonLimits,
    var offset: int,
    var nodes: int,
    var errorCode: string,
    var errorMessage: string,
    var errorOffset: int
)

// Holds a JSON output buffer and records whether every value has encoded successfully.
class JsonWriter(
    val output: ByteBuffer,
    var valid: bool
)

// Forward-only, allocation-light object reader. Values are consumed once from
// the source text; callers choose whether to decode a scalar or retain a
// validated raw slice. This complements the tree-shaped `Json` API for hot
// protocol paths that already know their schema.
class JsonObjectReader(
    val state: JsonParserState,
    val keys: array<string>,
    var first: bool,
    var done: bool,
    var expectingValue: bool,
    // The keys as a set, once an object rejecting duplicates grows long.
    var keyIndex: JsonKeyTable? = null
)

// Forward-only array companion for schema-aware nested JSON. Object and array
// readers may share one parser state, so nested values are validated exactly
// once without materializing a Json tree or retaining raw substrings.
class JsonArrayReader(
    val state: JsonParserState,
    var first: bool,
    var done: bool,
    var expectingValue: bool
)

// Validated encoded fragments and streaming container builders avoid a
// temporary `Json` object graph during serialization.
class JsonEncoded(val text: string, val valid: bool)

// Builds an encoded JSON array and tracks invalid input or use after finishing.
class JsonArrayEncoder(
    val output: ByteBuffer,
    var count: int,
    var valid: bool,
    var finished: bool
)

// Builds an encoded JSON object and tracks invalid input or use after finishing.
class JsonObjectEncoder(
    val output: ByteBuffer,
    var count: int,
    var valid: bool,
    var finished: bool
)

// Returns the closing quote for an unescaped, valid UTF-8 JSON string, or -1
// when the input needs the precise escaped-string decoder. This fuses the
// common path's delimiter search and validation into one raw-memory pass.
noescape extern:"intrinsic" fun ablaJsonFindPlainStringEnd(
    value: string,
    begin: int,
    end: int
): int

// Return the offset after a compact `,"name":` (or first-field `"name":`)
// token, or -1 when the source needs the whitespace-aware raw fallback.
// One checked raw-memory pass avoids constructing a slice and then comparing
// that slice through the general string ABI.
noescape extern:"intrinsic" fun ablaJsonMatchCompactObjectField(
    value: string,
    offset: int,
    name: string,
    comma: bool
): int

// Encodes a compact array transition without allocating or repeatedly crossing
// the checked string-index ABI. Zero selects the complete diagnostic path.
noescape extern:"intrinsic" fun ablaJsonCompactArrayNext(
    value: string,
    offset: int,
    first: bool
): int

// Compact signed-64-bit integer decoding uses raw source bytes and returns -1
// for fractions, exponents, malformed grammar, or overflow. Callers retain the
// full scanner as an exact diagnostic fallback for those inputs.
noescape extern:"intrinsic" fun ablaJsonAvailableIntegerEnd(
    value: string,
    begin: int
): int

// Returns the signed integer in a byte interval already checked by `ablaJsonAvailableIntegerEnd`.
noescape extern:"intrinsic" fun ablaJsonIntegerValueAt(
    value: string,
    begin: int,
    end: int
): int

// Returns the first non-whitespace offset at or after `begin`, the input length at EOF, or the unchanged offset if it is out of bounds.
noescape extern:"intrinsic" fun ablaJsonWhitespaceEnd(
    value: string,
    begin: int
): int

// The two scanning intrinsics' results as typed integers. A local set straight
// from an intrinsic call isn't known to hold an integer, so every comparison and
// sum on it would go through the boxed runtime operations; through these, they
// stay machine integers (and inline back to the intrinsic).
private fun jsonWhitespaceAfter(value: string, begin: int): int =
    ablaJsonWhitespaceEnd(value, begin)

private fun jsonPlainStringEnd(value: string, begin: int, end: int): int =
    ablaJsonFindPlainStringEnd(value, begin, end)

// Single-buffer streaming serializer. Container state is held in bitsets, so
// nesting does not allocate a DOM node, fragment, or context object.
class JsonEncoder(
    val output: ByteBuffer,
    var depth: int,
    var objectBits: int,
    var nonEmptyBits: int,
    var expectingValueBits: int,
    var rootWritten: bool,
    var valid: bool
)

// These limits contain only immutable scalar fields and can be shared.
@threadShared
val jsonStandardLimits = JsonLimits(
    1048576,
    64,
    100000,
    1048576,
    10000,
    true
)

// Returns the standard bounds and duplicate-key policy used by `jsonParse`.
fun jsonDefaultLimits(): JsonLimits = jsonStandardLimits

// What JavaScript's JSON.parse accepts: no byte, node, string or member
// limit, the deepest nesting jsonParse allows, and duplicate keys merged as
// JSON.parse merges them.
@threadShared
val jsonPermissiveLimits = JsonLimits(
    9223372036854775807,
    256,
    9223372036854775807,
    9223372036854775807,
    9223372036854775807,
    false,
    true
)

// Each call's limits are its own: a caller parsing a large trusted document
// (a map, an admin export) raises bytes, nodes and members as far as it
// needs. Only the depth stays bounded, since parsing recurses per level.
private fun jsonLimitsValid(limits: JsonLimits): bool =
    limits.maximumBytes > 0 &&
    limits.maximumDepth > 0 && limits.maximumDepth <= 256 &&
    limits.maximumNodes > 0 &&
    limits.maximumStringBytes > 0 &&
    limits.maximumObjectMembers > 0

private fun jsonEmptyNumber(): JsonNumber = JsonNumber("", false, 0, false)

// Scalars share these: a Json never changes after it is built, so a string,
// number, boolean or null need not carry arrays and a number record of its own
// (a parse of numeric data would otherwise make several objects per value).
// Nothing changes them, so threads share them too.
@threadShared
val jsonNoKeys: array<string> = []
// Shared empty value array for JSON nodes that have no children.
@threadShared
val jsonNoValues: array<Json> = []
// Shared empty number record for JSON nodes that hold no number.
@threadShared
val jsonNoNumber = JsonNumber("", false, 0, false)

// Returns the JSON null value.
fun jsonNull(): Json = Json(0, "", 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)

// Wraps UTF-8 `value` as a JSON string. Returns JSON null for invalid UTF-8.
fun jsonString(value: string): Json {
    if (value.isValidUtf8()) {
        Json(1, value, 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)
    } else jsonNull()
}

private fun jsonNumberGrammar(text: string): JsonNumberGrammar {
    val kind = jsonNumberKind(text)
    JsonNumberGrammar(kind >= 0, kind == 1)
}

// -1 not a JSON number, 0 a valid non-integer, 1 a valid integer.
private fun jsonNumberKind(text: string): int = jsonNumberKindRange(text, 0, text.size)

// jsonNumberKind of the bytes [begin, end) of `text`, read in place.
// Whether a byte can be part of a number's text: a digit, a sign, a point or an exponent mark.
private fun jsonNumberByte(next: int): bool = (next >= 48 && next <= 57) || next == 45 ||
    next == 43 || next == 46 || next == 101 || next == 69

private fun jsonNumberKindRange(text: string, begin: int, end: int): int {
    var offset = begin
    var valid = end > begin
    var integer = true
    if (valid && text[offset] == 45) {
        offset = offset + 1
        if (offset >= end) valid = false
    }
    if (valid && text[offset] == 48) {
        offset = offset + 1
        if (offset < end && text[offset] >= 48 && text[offset] <= 57) {
            valid = false
        }
    } else if (valid && text[offset] >= 49 && text[offset] <= 57) {
        while (offset < end && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
    } else valid = false
    if (valid && offset < end && text[offset] == 46) {
        integer = false
        offset = offset + 1
        val fractionBegin = offset
        while (offset < end && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == fractionBegin) valid = false
    }
    if (valid && offset < end &&
        (text[offset] == 101 || text[offset] == 69)) {
        integer = false
        offset = offset + 1
        if (offset < end &&
            (text[offset] == 43 || text[offset] == 45)) {
            offset = offset + 1
        }
        val exponentBegin = offset
        while (offset < end && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == exponentBegin) valid = false
    }
    if (offset != end) valid = false
    if (!valid) -1 else if (integer) 1 else 0
}

private fun jsonIntegerTextAvailable(text: string): bool {
    var negative = false
    var begin = 0
    if (text.size > 0 && text[0] == 45) {
        negative = true
        begin = 1
    }
    val digits = text.size - begin
    var available = digits > 0 && digits <= 19
    if (available && digits == 19) {
        val limit = if (negative) "9223372036854775808"
            else "9223372036854775807"
        var index = 0
        var decided = false
        while (index < 19 && !decided) {
            val actual = text[begin + index]
            val maximum = limit[index]
            if (actual < maximum) decided = true
            if (actual > maximum) {
                available = false
                decided = true
            }
            index = index + 1
        }
    }
    available
}

private fun jsonIntegerTextValue(text: string): int {
    val negative = text.size > 0 && text[0] == 45
    var offset = if (negative) 1 else 0
    var value = 0
    while (offset < text.size) {
        value = value * 10 - (text[offset] - 48)
        offset = offset + 1
    }
    if (negative) value else -value
}

private fun jsonNumberInfo(text: string): JsonNumber {
    val grammar = jsonNumberGrammar(text)
    val available = grammar.valid && grammar.integer &&
        jsonIntegerTextAvailable(text)
    JsonNumber(
        text,
        grammar.integer,
        if (available) jsonIntegerTextValue(text) else 0,
        available
    )
}

// Builds a JSON number from `value.text`, recomputing integer metadata. Returns JSON null if the text is not a valid number.
fun jsonNumber(value: JsonNumber): Json = jsonNumberText(value.text)

// Parses `value` as one JSON number, preserving its exact spelling. Returns JSON null for invalid input. Integer access is available only for integer syntax within the int range.
fun jsonNumberText(value: string): Json {
    val kind = jsonNumberKind(value)
    if (kind < 0) return jsonNull()
    val available = kind == 1 && jsonIntegerTextAvailable(value)
    val intValue = if (available) jsonIntegerTextValue(value) else 0
    Json(2, "", intValue, false, jsonNoKeys, jsonNoValues, JsonNumber(value, kind == 1, intValue,
        available))
}

// Integer formatting already produces valid JSON number text; retain the known value.
fun jsonInteger(value: int): Json =
    Json(2, "", value, false, jsonNoKeys, jsonNoValues, JsonNumber("$value", true, value, true))

// Returns the JSON boolean for `value`.
fun jsonBoolean(value: bool): Json =
    Json(3, "", 0, value, jsonNoKeys, jsonNoValues, jsonNoNumber)

// Wraps `values` as a JSON array in order.
fun jsonArray(values: array<Json>): Json =
    Json(4, "", 0, false, jsonNoKeys, values, jsonNoNumber)

// A raw node (kind 6) holds one JSON value that is already encoded: jsonStringify
// writes its text verbatim, as one copy, where the same value as a tree of nodes
// would take a node per number, string and member. For documents a service
// builds once and sends many times (and keeps alongside a compact form of its own).
// jsonParse and jsonDocument never produce one, and it reads as none of the other kinds
// (isNull... isObject are false, size() is 0, get() is null, asString() is ""): to
// read the value, jsonParse its text (jsonRawText).
//
// jsonRaw is the checked constructor: null unless `text` is exactly one well-formed JSON
// value (valid UTF-8, any size, nesting up to what jsonParse allows), which costs one
// validation pass over the text. jsonRawUnchecked trusts its caller: text that is not one
// well-formed JSON value makes jsonStringify's output not JSON (it is not checked again),
// so use it only on text this program encoded itself, with jsonStringify or jsonQuote.
fun jsonRaw(text: string): Json? {
    if (!jsonValidate(text, jsonPermissiveLimits).succeeded) return null
    Json(6, text, 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)
}

// Returns a raw JSON node that serializes `text` verbatim, so callers must supply one valid JSON value.
fun jsonRawUnchecked(text: string): Json =
    Json(6, text, 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)

// Returns true if the node holds already-encoded JSON text.
fun Json.isRaw(): bool = this.kind == 6

/** The encoded text of a raw node, "" for any other kind. */
fun Json.rawText(): string = if (this.kind == 6) this.stringValue else ""

// Pairs `keys` with `values` by position. Returns JSON null if their lengths differ or a key contains invalid UTF-8. Lookup uses the last value for a repeated key.
fun jsonObject(keys: array<string>, values: array<Json>): Json {
    var valid = keys.size == values.size
    var index = 0
    while (valid && index < keys.size) {
        valid = keys[index].isValidUtf8()
        index = index + 1
    }
    if (valid) jsonIndexedObject(keys, values)
    else jsonNull()
}

// Compatibility constructors retained for existing `$json` consumers.
fun ablaJsonNull(): Json = jsonNull()
// Returns a JSON string, or JSON null if the input is invalid UTF-8.
fun ablaJsonString(value: string): Json = jsonString(value)
// Returns a JSON number with the exact integer value.
fun ablaJsonInteger(value: int): Json = jsonInteger(value)
// Returns a JSON number with the supplied spelling, or JSON null for invalid number text.
fun ablaJsonNumberText(value: string): Json = jsonNumberText(value)
// Returns the JSON boolean for `value`.
fun ablaJsonBoolean(value: bool): Json = jsonBoolean(value)
// Returns a JSON array containing `values` in order.
fun ablaJsonArray(values: array<Json>): Json = jsonArray(values)
// Returns a JSON object from parallel keys and values, or JSON null for unequal lengths or a key with invalid UTF-8.
fun ablaJsonObject(keys: array<string>, values: array<Json>): Json =
    jsonObject(keys, values)

/** The members a `$json` object with a computed key keeps (decision #154): one per key, at the position where the key first appears, each the
 *  index of the last member with that key (the later member wins, as JavaScript's JSON.parse and jsonParse's mergeDuplicateKeys read a
 *  repeated key). Linear: a map once there are more than eight members. */
fun ablaJsonMergeOrder(keys: array<string>): array<int> {
    val order: array<int> = []
    if (keys.size <= 8) {
        for (index in 0 until keys.size) {
            var slot = -1
            for (kept in 0 until order.size) {
                if (slot < 0 && keys[order[kept]] == keys[index]) slot = kept
            }
            if (slot < 0) order.append(index) else order[slot] = index
        }
    } else {
        val slots: Map<string, int> = Map()
        for (index in 0 until keys.size) {
            if (slots.has(keys[index])) {
                val slot = slots.get(keys[index]) ?? 0
                order[slot] = index
            } else {
                slots.set(keys[index], order.size)
                order.append(index)
            }
        }
    }
    order
}

/** `$json`'s object when a key is computed: as jsonObject, with a repeated key merged (ablaJsonMergeOrder), so the output has one member per
 *  name and jsonParse accepts it; JSON null if a key is invalid UTF-8. */
fun ablaJsonObjectMerged(keys: array<string>, values: array<Json>): Json {
    if (keys.size != values.size) return jsonNull()
    val kept: array<string> = []
    val keptValues: array<Json> = []
    for (index in ablaJsonMergeOrder(keys)) {
        kept.append(keys[index])
        keptValues.append(values[index])
    }
    jsonObject(kept, keptValues)
}

// A `$json` value written as an Abla expression becomes JSON through these:
// the call picks the overload for the expression's type, so a value of any
// other type is a compile error at the value.
fun ablaJsonValue(value: Json): Json = value
// Returns a JSON string, or JSON null if the input is invalid UTF-8.
fun ablaJsonValue(value: string): Json = jsonString(value)
/// Returns a JSON string or JSON null if the input is absent or invalid UTF-8.
fun ablaJsonValue(value: string?): Json = if (value == null) jsonNull() else jsonString(value)
// Returns a JSON number with the exact integer value.
fun ablaJsonValue(value: int): Json = jsonInteger(value)
// Returns the JSON boolean for `value`.
fun ablaJsonValue(value: bool): Json = jsonBoolean(value)
// Returns a JSON number spelled like `value.text`, or JSON null for invalid number text.
fun ablaJsonValue(value: JsonNumber): Json = jsonNumber(value)
// An f64 interpolates as f64Text, the shortest text that reads back as the
// value, with the same bytes at compile time and at run time; JSON has no NaN
// or infinities: null.
private fun jsonFloatValueText(value: f64): string =
    if (value != value || value - value != 0.0) "null" else "$value"
// Returns the shortest JSON number that round-trips to `value`, or JSON null for NaN or infinity.
fun ablaJsonValue(value: f64): Json = jsonNumberText(jsonFloatValueText(value))
// Returns a JSON array containing the input nodes in order.
fun ablaJsonValue(values: array<Json>): Json = jsonArray(values)
// Returns a JSON array of the strings in order, substituting JSON null for any string with invalid UTF-8.
fun ablaJsonValue(values: array<string>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(jsonString(value))
    jsonArray(converted)
}
/// Returns a JSON array with null for each absent or invalid UTF-8 input.
fun ablaJsonValue(values: array<string?>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(ablaJsonValue(value))
    jsonArray(converted)
}
// Returns a JSON array of exact integer numbers in input order.
fun ablaJsonValue(values: array<int>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(jsonInteger(value))
    jsonArray(converted)
}
// Returns a JSON array of round-trippable numbers in input order, substituting JSON null for NaNs and infinities.
fun ablaJsonValue(values: array<f64>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(ablaJsonValue(value))
    jsonArray(converted)
}
// Returns a JSON array of the booleans in input order.
fun ablaJsonValue(values: array<bool>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(jsonBoolean(value))
    jsonArray(converted)
}

// A `$json` key written as an expression other than a string literal: only a
// string is accepted.
fun ablaJsonKey(key: string): string = key

// Runtime leaves of `$jsonw`: typed values go straight to the caller's buffer.
// Use the tree writer's string encoder, without a quoted intermediate copy.
fun ablaJsonWriteValue(var out: ByteBuffer, value: string): void {
    if (ablaCompileTimeNativeHost()) {
        if (!jsonAppendStringNative(out, value)) out.appendText("null")
    } else if (ablaAtCompileTime()) {
        // The portable writer can discover a bad UTF-8 sequence after writing
        // a prefix, so validate before touching the caller's buffer.
        if (value.isValidUtf8()) jsonAppendStringPortable(out, value)
        else out.appendText("null")
    } else if (!jsonAppendStringNative(out, value)) out.appendText("null")
    return
}
// Appends the integer's decimal representation to the JSON output buffer.
fun ablaJsonWriteValue(var out: ByteBuffer, value: int): void = out.appendInt(value)
/// Appends a quoted JSON string or the literal `null` for absent or invalid UTF-8 input.
fun ablaJsonWriteValue(var out: ByteBuffer, value: string?): void {
    if (value == null) out.appendText("null") else ablaJsonWriteValue(out, value)
    return
}
// Appends the JSON literal `true` or `false` to the output buffer.
fun ablaJsonWriteValue(var out: ByteBuffer, value: bool): void =
    out.appendText(if (value) "true" else "false")
// Appends a round-trippable JSON number, or the literal `null` for NaN or infinity.
fun ablaJsonWriteValue(var out: ByteBuffer, value: f64): void {
    out.appendText(jsonFloatValueText(value))
    return
}
// Appends the number's original spelling if valid, or the literal `null` otherwise.
fun ablaJsonWriteValue(var out: ByteBuffer, value: JsonNumber): void {
    out.appendText(if (jsonNumberKind(value.text) >= 0) value.text else "null")
    return
}
// Explicit tree inputs are supported without building another tree.
fun ablaJsonWriteValue(var out: ByteBuffer, value: Json): void {
    out.appendText(jsonStringify(value))
    return
}

// Returns true when this value is JSON null.
fun Json.isNull(): bool = this.kind == 0
// Returns true when this value is a string.
fun Json.isString(): bool = this.kind == 1
// Returns true when this value is a number.
fun Json.isNumber(): bool = this.kind == 2
// Returns true when this value is a boolean.
fun Json.isBoolean(): bool = this.kind == 3
// Returns true when this value is an array.
fun Json.isArray(): bool = this.kind == 4
// Returns true when this value is an object.
fun Json.isObject(): bool = this.kind == 5
// Returns the decoded string value or an empty string for other kinds.
fun Json.asString(): string = if (this.kind == 1) this.stringValue else ""
// Returns the boolean value, defaulting to false for other kinds.
fun Json.asBoolean(): bool = this.kind == 3 && this.boolValue
// Returns the original number spelling and integer metadata, or an empty number record for other kinds.
fun Json.asNumber(): JsonNumber =
    if (this.kind == 2) this.numberValue else jsonEmptyNumber()
// Returns the integer value, or zero when intAvailable is false.
fun Json.asInt(): int =
    if (this.kind == 2 && this.numberValue.intAvailable) this.intValue else 0
// Returns true for a JSON number written as an integer and representable as int.
fun Json.intAvailable(): bool =
    this.kind == 2 && this.numberValue.intAvailable

private fun Json.hasKeyIndex(): bool =
    this.kind == 5 && this.stringValue.size >= 4 &&
    textReadU32LittleEndian(this.stringValue, 0) == this.keys.size

// Looks up the exact `key` in an object. Returns its last value when repeated or JSON null when absent. Use has to distinguish an absent key from a JSON null member.
fun Json.get(key: string): Json {
    if (this.hasKeyIndex()) {
        val position = jsonKeyIndexPosition(this.stringValue, this.keys, key)
        return if (position >= 0 && position < this.values.size) this.values[position]
            else jsonNull()
    }
    var index = if (this.keys.size < this.values.size) {
        this.keys.size
    } else this.values.size
    while (index > 0) {
        index = index - 1
        val candidate = this.keys[index]
        val possible = candidate.size == key.size &&
            (key.size == 0 || candidate[0] == key[0])
        if (possible && candidate == key) {
            return this.values[index]
        }
    }
    jsonNull()
}

// Returns true if the object contains the exact `key`, including when its value is JSON null.
fun Json.has(key: string): bool {
    if (this.hasKeyIndex()) return jsonKeyIndexPosition(this.stringValue, this.keys, key) >= 0
    var found = false
    var index = 0
    while (!found && index < this.keys.size) {
        if (this.keys[index] == key) found = true
        index = index + 1
    }
    found
}

// Returns the element count of an array, the member count of an object, or zero for other kinds.
fun Json.size(): int {
    if (this.kind == 4) this.values.size
    else if (this.kind == 5) this.keys.size
    else 0
}

// Returns the value at zero-based `index` in the stored values of an array or object. Panics if the index is out of bounds.
fun Json.at(index: int): Json = this.values[index]

// Returns the string at `key`, or an empty string when absent or of another kind.
fun Json.getString(key: string): string = this.get(key).asString()

// Returns the int at `key`, or zero when absent or unavailable as an int.
fun Json.getInt(key: string): int = this.get(key).asInt()

// Records the first parse error with its code, message, and byte offset.
fun JsonParserState.fail(
    code: string,
    message: string,
    offset: int
): void {
    if (this.errorCode.size == 0) {
        this.errorCode = code
        this.errorMessage = message
        this.errorOffset = offset
    }
}

// Advances the parser cursor past consecutive JSON whitespace bytes.
fun jsonSkipWhitespace(var state: JsonParserState): void {
    state.offset = jsonWhitespaceAfter(state.source, state.offset)
    return
}

private fun jsonHexValue(byte: int): int {
    val digit = byte - 48
    if (digit >= 0 && digit <= 9) return digit
    // Letters fold with `| 32` (A to F and a to f only: no other byte folds into 97 to 102).
    val letter = (byte | 32) - 97
    if (letter >= 0 && letter <= 5) letter + 10 else -1
}

private fun jsonHexQuad(source: string, offset: int): int {
    if (offset < 0 || offset + 4 > source.size) return -1
    val packed = textReadU32LittleEndian(source, offset)
    val first = jsonHexValue(packed & 255)
    val second = jsonHexValue((packed >> 8) & 255)
    val third = jsonHexValue((packed >> 16) & 255)
    val fourth = jsonHexValue((packed >> 24) & 255)
    // A byte that is not a hex digit gives -1, which sets every bit of the or.
    if ((first | second | third | fourth) < 0) -1
    else (first << 12) | (second << 8) | (third << 4) | fourth
}

// Returns the decoded JSON string and advances the cursor, recording a parse error if it encounters invalid input.
@noinline
fun jsonParseEscapedPortable(
    var state: JsonParserState,
    quoteOffset: int,
    contentBegin: int
): string {
    val output = byteBuffer()
    if (state.offset > contentBegin) output.appendText(
        state.source.slice(contentBegin, state.offset)
    )
    var closed = false
    while (state.errorCode.size == 0 && !closed &&
           state.offset < state.source.size) {
        val byte = state.source[state.offset]
        if (byte == 34) {
            closed = true
            state.offset = state.offset + 1
        } else if (byte == 92) {
            val escapeOffset = state.offset
            state.offset = state.offset + 1
            if (state.offset >= state.source.size) {
                state.fail(
                    "unexpected_end", "unterminated JSON escape", state.offset
                )
            } else {
                val escaped = state.source[state.offset]
                state.offset = state.offset + 1
                if (escaped == 34) output.appendText("\"")
                else if (escaped == 92) output.appendText("\\")
                else if (escaped == 47) output.appendText("/")
                else if (escaped == 98) output.appendText(utf8Encode(8))
                else if (escaped == 102) output.appendText(utf8Encode(12))
                else if (escaped == 110) output.appendText("\n")
                else if (escaped == 114) output.appendText("\r")
                else if (escaped == 116) output.appendText("\t")
                else if (escaped == 117) {
                    val unicodeOffset = state.offset
                    var scalar = jsonHexQuad(state.source, state.offset)
                    if (scalar < 0) {
                        state.fail(
                            "invalid_unicode",
                            "invalid JSON Unicode escape",
                            unicodeOffset
                        )
                    } else {
                        state.offset = state.offset + 4
                        if (scalar >= 55296 && scalar <= 56319) {
                            if (state.offset + 6 <= state.source.size &&
                                state.source[state.offset] == 92 &&
                                state.source[state.offset + 1] == 117) {
                                val low = jsonHexQuad(
                                    state.source, state.offset + 2
                                )
                                if (low >= 56320 && low <= 57343) {
                                    scalar = 65536 + (scalar - 55296) * 1024 +
                                        low - 56320
                                    state.offset = state.offset + 6
                                } else state.fail(
                                    "invalid_unicode",
                                    "invalid JSON surrogate pair",
                                    state.offset
                                )
                            } else state.fail(
                                "invalid_unicode",
                                "missing JSON low surrogate",
                                state.offset
                            )
                        } else if (scalar >= 56320 && scalar <= 57343) {
                            state.fail(
                                "invalid_unicode",
                                "unexpected JSON low surrogate",
                                unicodeOffset
                            )
                        }
                        if (state.errorCode.size == 0) {
                            output.appendText(utf8Encode(scalar))
                        }
                    }
                } else state.fail(
                    "invalid_escape", "invalid JSON string escape", escapeOffset
                )
            }
        } else if (byte < 32) {
            state.fail(
                "unexpected_token",
                "unescaped control byte in JSON string",
                state.offset
            )
        } else if (byte < 128) {
            output.appendText(state.source.slice(state.offset, state.offset + 1))
            state.offset = state.offset + 1
        } else {
            val length = utf8SequenceLength(byte)
            if (!utf8SequenceValid(state.source, state.offset, length)) {
                state.fail(
                    "invalid_unicode", "invalid UTF-8 in JSON string", state.offset
                )
            } else {
                output.appendText(state.source.slice(
                    state.offset, state.offset + length
                ))
                state.offset = state.offset + length
            }
        }
        if (state.errorCode.size == 0 &&
            output.size() > state.limits.maximumStringBytes) {
            state.fail(
                "string_limit", "JSON string exceeds configured limit", quoteOffset
            )
        }
    }
    if (state.errorCode.size == 0 && !closed) {
        state.fail(
            "unexpected_end", "unterminated JSON string", state.source.size
        )
    }
    output.toText()
}

// Decode a valid escaped string into one bounded allocation. On any unusual
// or invalid input leave the parser untouched and use the precise portable
// diagnostic path. Decoding never produces more bytes than the source span.
trusted fun jsonParseEscapedNative(var state: JsonParserState, begin: int): string {
    val source = state.source
    val maximum = state.limits.maximumStringBytes
    if (begin < 0 || begin > source.size || maximum <= 0) return ""
    val sourceAddress = ablaUnsafeStringAddress(source)
    var scanLimit = source.size
    if (maximum < (source.size - begin) / 6) scanLimit = begin + maximum * 6 + 1
    var end = begin
    var closed = false
    while (!closed && end < scanLimit) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + end))
        if (byte == 34) closed = true
        else end = end + (if (byte == 92) 2 else 1)
    }
    if (!closed) return ""
    val capacity = if (end - begin < maximum) end - begin else maximum
    val buffer = nativeByteBuffer(capacity + 1)
    val destination = nativePointerAddress(buffer.address)
    var offset = begin
    var written = 0
    var valid = true
    // The bits of the bytes copied as written (128 or more: one was from 128 up): escapes give valid
    // UTF-8 by construction (no surrogate), and ASCII is valid, so only copied high bytes need the check.
    var copiedBits = 0
    while (valid && offset < end) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset))
        offset = offset + 1
        if (byte == 92) {
            if (offset >= end) valid = false
            else {
                val escaped = ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset))
                offset = offset + 1
                if (escaped == 117) {
                    var scalar = if (offset + 4 <= end) jsonHexQuad(source, offset) else -1
                    offset = offset + 4
                    if (scalar >= 55296 && scalar <= 56319) {
                        if (offset + 6 <= end &&
                            ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset)) ==
                            92 &&
                            ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset +
                                1)) == 117) {
                            val low = jsonHexQuad(source, offset + 2)
                            if (low >= 56320 && low <= 57343) {
                                scalar = 65536 + (scalar - 55296) * 1024 + low - 56320
                                offset = offset + 6
                            } else valid = false
                        } else valid = false
                    } else if (scalar < 0 || (scalar >= 56320 && scalar <= 57343)) valid = false
                    if (valid) {
                        val length = if (scalar < 128) 1 else if (scalar < 2048) 2
                            else if (scalar < 65536) 3 else 4
                        if (written + length > capacity) valid = false
                        if (valid) {
                            val lead = if (length == 1) scalar
                                else if (length == 2) 192 | (scalar >> 6)
                                else if (length == 3) 224 | (scalar >> 12)
                                else 240 | (scalar >> 18)
                            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), lead)
                            var index = 1
                            while (index < length) {
                                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written +
                                    index),
                                    128 | ((scalar >> ((length - index - 1) * 6)) & 63))
                                index = index + 1
                            }
                            written = written + length
                        }
                    }
                } else {
                    val decoded = if (escaped == 34 || escaped == 92 || escaped == 47) escaped
                        else if (escaped == 98) 8 else if (escaped == 102) 12
                        else if (escaped == 110) 10 else if (escaped == 114) 13
                        else if (escaped == 116) 9 else -1
                    if (decoded < 0 || written >= capacity) valid = false
                    else {
                        ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), decoded)
                        written = written + 1
                    }
                }
            }
        } else if (byte < 32 || written >= capacity) valid = false
        else {
            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), byte)
            written = written + 1
            copiedBits = copiedBits | byte
        }
    }
    if (valid) {
        val text = buffer.adoptString(written)
        if (copiedBits < 128 || text.isValidUtf8()) {
            state.offset = end + 1
            return text
        }
    } else buffer.close()
    ""
}

// Returns a decoded JSON string starting at the given quote, using the portable decoder to report errors the fast decoder cannot handle.
@noinline
fun jsonParseStringFallback(
    var state: JsonParserState,
    quoteOffset: int,
    contentBegin: int
): string {
    state.offset = contentBegin
    // The bounded decoder takes every valid string. Anything it refuses
    // (invalid input, a string over the limit) leaves the cursor unchanged
    // and goes to the portable decoder for its precise diagnostics.
    if (ablaCompileTimeNativeHost()) {
        if (state.errorCode.size == 0) {
            val decoded = jsonParseEscapedNative(state, contentBegin)
            if (state.offset != contentBegin) return decoded
        }
    } else if (ablaAtCompileTime()) {} else {
        if (state.errorCode.size == 0) {
            val decoded = jsonParseEscapedNative(state, contentBegin)
            if (state.offset != contentBegin) return decoded
        }
    }
    jsonParseEscapedPortable(state, quoteOffset, contentBegin)
}

private fun jsonParseString(var state: JsonParserState): string {
    // Streaming object readers leave the cursor immediately after the colon.
    // Compact strings avoid the whitespace scan, while ordinary JSON permits
    // whitespace before the opening quote.
    if (state.offset < state.source.size && state.source[state.offset] != 34) {
        jsonSkipWhitespace(state)
    }
    val quoteOffset = state.offset
    if (state.offset < state.source.size && state.source[state.offset] == 34) {
        state.offset = state.offset + 1
    } else state.fail("unexpected_token", "expected JSON string", state.offset)
    val contentBegin = state.offset
    // Keep the overwhelmingly common unescaped path in a small function. The
    // precise escape and Unicode diagnostics live out of line so they do not
    // force their large temporary state into every ordinary string read.
    val plainEnd = if (state.errorCode.size == 0) jsonPlainStringEnd(
        state.source, contentBegin, state.source.size
    ) else -1
    if (plainEnd >= contentBegin &&
        plainEnd - contentBegin <= state.limits.maximumStringBytes) {
        val result = state.source.slice(contentBegin, plainEnd)
        state.offset = plainEnd + 1
        result
    } else jsonParseStringFallback(state, quoteOffset, contentBegin)
}

// jsonParseString at a value or key, the cursor on its quote.
private fun jsonParseQuoted(var state: JsonParserState): string {
    val source = state.source
    val quoteOffset = state.offset
    val contentBegin = quoteOffset + 1
    val plainEnd = jsonPlainStringEnd(source, contentBegin, source.size)
    if (plainEnd >= contentBegin &&
        plainEnd - contentBegin <= state.limits.maximumStringBytes) {
        state.offset = plainEnd + 1
        return source.slice(contentBegin, plainEnd)
    }
    jsonParseStringFallback(state, quoteOffset, contentBegin)
}

// Check the delimiter after an item, keeping the first parser error and
// advancing to the next item or past the closing bracket.
private fun jsonParseArrayEnd(var state: JsonParserState): bool {
    val source = state.source
    var offset = jsonWhitespaceAfter(source, state.offset)
    var closed = false
    if (offset >= source.size) {
        state.fail("unexpected_end", "unterminated JSON array", offset)
    } else if (source[offset] == 93) {
        offset += 1
        closed = true
    } else if (source[offset] == 44) {
        offset = jsonWhitespaceAfter(source, offset + 1)
        if (offset < source.size && source[offset] == 93) {
            state.fail("unexpected_token", "trailing comma in JSON array", offset)
        }
    } else state.fail(
        "unexpected_token", "expected comma or closing bracket", offset
    )
    state.offset = offset
    closed || state.errorCode.size != 0
}

private fun jsonParseArrayItems(var state: JsonParserState, depth: int): array<Json> {
    val source = state.source
    state.offset = jsonWhitespaceAfter(source, state.offset + 1)
    if (state.offset < source.size && source[state.offset] == 93) {
        state.offset += 1
        return []
    }
    // A small literal builds its header and elements in one allocation.
    val first = jsonParseValue(state, depth)
    if (jsonParseArrayEnd(state)) return [first]
    val second = jsonParseValue(state, depth)
    if (jsonParseArrayEnd(state)) return [first, second]
    val third = jsonParseValue(state, depth)
    if (jsonParseArrayEnd(state)) return [first, second, third]
    val fourth = jsonParseValue(state, depth)
    val values = [first, second, third, fourth]
    while (!jsonParseArrayEnd(state)) {
        values.append(jsonParseValue(state, depth))
    }
    values
}

private fun jsonParseObjectKey(var state: JsonParserState, count: int): string {
    val offset = state.offset
    if (offset >= state.source.size) {
        state.fail("unexpected_end", "unterminated JSON object", offset)
        return ""
    }
    if (state.source[offset] != 34) {
        state.fail("unexpected_token", "JSON object key must be a string", offset)
        return ""
    }
    val key = jsonParseQuoted(state)
    if (state.errorCode.size == 0 && count >= state.limits.maximumObjectMembers) {
        state.fail("node_limit", "JSON object member count exceeds configured limit", state.offset)
    }
    key
}

private fun jsonParseObjectValue(
    var state: JsonParserState, depth: int, duplicate: bool
): Json {
    if (state.errorCode.size != 0) return jsonNull()
    if (duplicate) {
        state.fail("duplicate_key", "duplicate JSON object key", state.offset)
        return jsonNull()
    }
    val source = state.source
    val offset = jsonWhitespaceAfter(source, state.offset)
    if (offset >= source.size || source[offset] != 58) {
        state.fail("unexpected_token", "expected colon after JSON object key", offset)
        return jsonNull()
    }
    state.offset = offset + 1
    jsonParseValue(state, depth)
}

// Advance to the next member or past the closing brace. Let errors from a
// member take precedence over errors at its delimiter.
private fun jsonParseObjectEnd(var state: JsonParserState): bool {
    if (state.errorCode.size != 0) return true
    val source = state.source
    var offset = jsonWhitespaceAfter(source, state.offset)
    var closed = false
    if (offset >= source.size) {
        state.fail("unexpected_end", "unterminated JSON object", offset)
    } else if (source[offset] == 125) {
        offset += 1
        closed = true
    } else if (source[offset] == 44) {
        offset = jsonWhitespaceAfter(source, offset + 1)
        if (offset < source.size && source[offset] == 125) {
            state.fail("unexpected_token", "trailing comma in JSON object", offset)
        }
    } else state.fail("unexpected_token", "expected comma or closing brace", offset)
    state.offset = offset
    closed || state.errorCode.size != 0
}

private fun jsonParseObjectTail(
    var state: JsonParserState, depth: int, var keys: array<string>, var values: array<Json>
): Json {
    var keyIndex: JsonKeyTable? = null
    val reject = state.limits.rejectDuplicateKeys
    val merge = state.limits.mergeDuplicateKeys
    var closed = false
    while (state.errorCode.size == 0 && !closed) {
        val key = jsonParseObjectKey(state, keys.size)
        if (state.errorCode.size != 0) break
        var duplicate = false
        var earlier = -1
        if (reject) {
            if (keyIndex == null && keys.size >= jsonKeyIndexMembers) keyIndex = jsonKeyTable()
            duplicate = jsonKeyRepeats(keys, keyIndex, key)
        } else if (merge) {
            if (keyIndex == null && keys.size >= jsonKeyIndexMembers) keyIndex = jsonKeyTable()
            earlier = jsonKeyPosition(keys, keyIndex, key)
        }
        val value = jsonParseObjectValue(state, depth, duplicate)
        if (state.errorCode.size == 0 && earlier >= 0) values[earlier] = value
        else if (state.errorCode.size == 0) {
            keys.append(key)
            values.append(value)
        }
        closed = jsonParseObjectEnd(state)
    }
    Json(5, jsonKeyIndexFrom(keyIndex, keys), 0, false, keys, values, jsonNoNumber)
}

private fun jsonParsedSmallObject(keys: array<string>, values: array<Json>): Json =
    Json(5, "", 0, false, keys, values, jsonNoNumber)

private fun jsonParseObject(var state: JsonParserState, depth: int): Json {
    val source = state.source
    val offset = jsonWhitespaceAfter(source, state.offset + 1)
    state.offset = offset
    if (offset < source.size && source[offset] == 125) {
        state.offset = offset + 1
        return jsonParsedSmallObject([], [])
    }

    val reject = state.limits.rejectDuplicateKeys
    if (!reject && state.limits.mergeDuplicateKeys) return jsonParseObjectTail(state, depth, [], [])

    // Keep small objects' members in local roots until we know the size.
    // Each literal then allocates its array header and backing space together.
    val key0 = jsonParseObjectKey(state, 0)
    val value0 = jsonParseObjectValue(state, depth, false)
    if (jsonParseObjectEnd(state)) return jsonParsedSmallObject([key0], [value0])

    val key1 = jsonParseObjectKey(state, 1)
    val value1 = jsonParseObjectValue(state, depth, reject && key1 == key0)
    if (jsonParseObjectEnd(state)) return jsonParsedSmallObject([key0, key1], [value0, value1])

    val key2 = jsonParseObjectKey(state, 2)
    val value2 = jsonParseObjectValue(state, depth, reject && (key2 == key0 || key2 == key1))
    if (jsonParseObjectEnd(state)) return jsonParsedSmallObject([key0, key1, key2], [value0, value1, value2])

    val key3 = jsonParseObjectKey(state, 3)
    val value3 = jsonParseObjectValue(state, depth, reject && (key3 == key0 || key3 == key1 || key3 == key2))
    val closed = jsonParseObjectEnd(state)
    val keys = [key0, key1, key2, key3]
    val values = [value0, value1, value2, value3]
    if (closed) return jsonParsedSmallObject(keys, values)
    jsonParseObjectTail(state, depth, keys, values)
}

// The value at the cursor, built, and the cursor after it: jsonParse's walk. Its
// checks come in this order at these offsets (jsonValidateAt makes the same ones
// without building). The cursor is a local within each value; what a string
// decodes to from valid input is valid UTF-8, so nodes are made directly, without
// jsonString's and jsonObject's UTF-8 checks (or a null made first for each
// value), and a number's grammar is read once, in place.
private fun jsonParseValue(var state: JsonParserState, depth: int): Json {
    val source = state.source
    val size = source.size
    var offset = jsonWhitespaceAfter(source, state.offset)
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail("depth_limit", "JSON nesting exceeds configured limit", offset)
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) {
            state.fail("node_limit", "JSON node count exceeds configured limit", offset)
        }
    }
    if (state.errorCode.size == 0 && offset >= size) {
        state.fail("unexpected_end", "expected JSON value", offset)
    }
    if (state.errorCode.size != 0) {
        state.offset = offset
        return jsonNull()
    }
    val byte = source[offset]
    if (byte == 34) {
        state.offset = offset
        return Json(1, jsonParseQuoted(state), 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)
    }
    if (byte == 91) {
        state.offset = offset
        val values = jsonParseArrayItems(state, depth + 1)
        return Json(4, "", 0, false, jsonNoKeys, values, jsonNoNumber)
    }
    if (byte == 123) {
        state.offset = offset
        return jsonParseObject(state, depth + 1)
    }
    if ((byte >= 48 && byte <= 57) || byte == 45 || byte == 43) {
        val begin = offset
        // An integer of 1 to 18 digits without a leading zero, ending at a byte no number continues with, is read
        // here in one pass (its grammar, its value and its fit are known at once); any other number takes the
        // general path below.
        val negative = byte == 45
        var at = if (negative) begin + 1 else begin
        val digitsBegin = at
        var accumulated = 0
        while (at < size && at - digitsBegin < 19) {
            val digit = source[at] - 48
            if (digit < 0 || digit > 9) break
            accumulated = accumulated * 10 + digit
            at = at + 1
        }
        val digitCount = at - digitsBegin
        if (digitCount >= 1 && digitCount <= 18 && (digitCount == 1 || source[digitsBegin] != 48) &&
            (at >= size || !jsonNumberByte(source[at]))) {
            state.offset = at
            val value = if (negative) -accumulated else accumulated
            return Json(2, "", value, false, jsonNoKeys, jsonNoValues,
                JsonNumber(source.slice(begin, at), true, value, true))
        }
        var scanning = true
        while (scanning && offset < size) {
            val next = source[offset]
            scanning = (next >= 48 && next <= 57) || next == 45 ||
                next == 43 || next == 46 || next == 101 || next == 69
            if (scanning) offset = offset + 1
        }
        state.offset = offset
        val kind = jsonNumberKindRange(source, begin, offset)
        if (kind < 0) {
            state.fail("invalid_number", "invalid JSON number", begin)
            return jsonNull()
        }
        val text = source.slice(begin, offset)
        val available = kind == 1 && jsonIntegerTextAvailable(text)
        val intValue = if (available) jsonIntegerTextValue(text) else 0
        return Json(2, "", intValue, false, jsonNoKeys, jsonNoValues, JsonNumber(text, kind == 1,
            intValue, available))
    }
    if (jsonLiteralAt(source, offset, 1)) {
        state.offset = offset + 4
        return jsonBoolean(true)
    }
    if (jsonLiteralAt(source, offset, 2)) {
        state.offset = offset + 5
        return jsonBoolean(false)
    }
    if (jsonLiteralAt(source, offset, 3)) {
        state.offset = offset + 4
        return jsonNull()
    }
    state.fail("unexpected_token", "unexpected token in JSON input", offset)
    state.offset = offset
    jsonNull()
}

private fun jsonErrorLocation(source: string, offset: int): array<int> {
    var line = 1
    var column = 1
    var index = 0
    while (index < offset && index < source.size) {
        if (source[index] == 10) {
            line = line + 1
            column = 1
        } else column = column + 1
        index = index + 1
    }
    [line, column]
}

// The keys of an object rejecting duplicates, once it grows long: an open
// addressing table of positions + 1 into `names`, probed linearly from each
// name's FNV-1a hash and kept at most half full.
class JsonKeyTable(
    val names: array<string>,
    val hashes: array<int>,
    var slots: array<int>,
    var mask: int
)

private val jsonKeyIndexMembers = 16

private fun jsonKeyHash(key: string): int {
    var hash = -3750763034362895579
    for (byte in key) hash = (hash ^ byte) * 1099511628211
    hash
}

private fun jsonKeyTableSlots(size: int): array<int> {
    val slots: array<int> = []
    var index = 0
    while (index < size) {
        slots.append(0)
        index = index + 1
    }
    slots
}

// Whether `key` is in the table; adds it when it is not.
fun JsonKeyTable.repeatsOrAdd(key: string): bool {
    val hash = jsonKeyHash(key)
    var slot = hash & this.mask
    var entry = this.slots[slot]
    while (entry != 0) {
        if (this.hashes[entry - 1] == hash && this.names[entry - 1] == key) return true
        slot = (slot + 1) & this.mask
        entry = this.slots[slot]
    }
    this.names.append(key)
    this.hashes.append(hash)
    this.slots[slot] = this.names.size
    if (this.names.size * 2 > this.mask) {
        this.mask = this.mask * 2 + 1
        this.slots = jsonKeyTableSlots(this.mask + 1)
        var position = 0
        while (position < this.names.size) {
            var free = this.hashes[position] & this.mask
            while (this.slots[free] != 0) free = (free + 1) & this.mask
            this.slots[free] = position + 1
            position = position + 1
        }
    }
    false
}

// `key`'s position in the table, or -1 when it is new; adds it then.
fun JsonKeyTable.positionOrAdd(key: string): int {
    if (!this.repeatsOrAdd(key)) return -1
    val hash = jsonKeyHash(key)
    var slot = hash & this.mask
    while (this.slots[slot] != 0) {
        val entry = this.slots[slot]
        if (this.hashes[entry - 1] == hash && this.names[entry - 1] == key) return entry - 1
        slot = (slot + 1) & this.mask
    }
    -1
}

// Whether `key` repeats one of `keys`, the members before it. Only asked
// while duplicates are rejected, so `keys` are distinct: a short object scans
// them; a longer one (from jsonKeyIndexMembers) keeps `index`, a table that
// starts with every key so far and takes each new one as it is checked.
private fun jsonKeyRepeats(
    keys: array<string>,
    var index: JsonKeyTable?,
    key: string
): bool {
    if (index == null) {
        var found = false
        var position = 0
        while (!found && position < keys.size) {
            found = keys[position] == key
            position = position + 1
        }
        return found
    }
    if (index.names.size == 0) for (earlier in keys) index.repeatsOrAdd(earlier)
    index.repeatsOrAdd(key)
}

// The position of `key` among `keys` (distinct: an object merging its
// duplicates), or -1. As jsonKeyRepeats, a longer object keeps `index`, which
// takes `key` when it is new.
private fun jsonKeyPosition(
    keys: array<string>,
    var index: JsonKeyTable?,
    key: string
): int {
    if (index == null) {
        var position = 0
        while (position < keys.size) {
            if (keys[position] == key) return position
            position = position + 1
        }
        return -1
    }
    if (index.names.size == 0) for (earlier in keys) index.positionOrAdd(earlier)
    index.positionOrAdd(key)
}

// An empty key table for an object that has reached jsonKeyIndexMembers.
private fun jsonKeyTable(): JsonKeyTable = JsonKeyTable([], [], jsonKeyTableSlots(64), 63)

// The index of an object with these keys, "" for a short one.
private fun jsonKeyIndexOf(keys: array<string>): string {
    if (keys.size < jsonKeyIndexMembers) return ""
    var size = 64
    while (size <= keys.size * 2) size = size * 2
    val mask = size - 1
    val slots = jsonKeyTableSlots(size)
    var position = 0
    while (position < keys.size) {
        var slot = jsonKeyHash(keys[position]) & mask
        while (slots[slot] != 0 && keys[slots[slot] - 1] != keys[position]) {
            slot = (slot + 1) & mask
        }
        position = position + 1
        slots[slot] = position
    }
    jsonKeyIndexText(keys.size, slots)
}

// The same from the table that checked `keys` while they were parsed, if any:
// it holds exactly them, in their order.
private fun jsonKeyIndexFrom(table: JsonKeyTable?, keys: array<string>): string {
    if (table == null) return jsonKeyIndexOf(keys)
    jsonKeyIndexText(keys.size, table.slots)
}

private fun jsonKeyIndexText(count: int, slots: array<int>): string {
    if (ablaCompileTimeNativeHost()) jsonKeyIndexTextNative(count, slots)
    else if (ablaAtCompileTime()) {
        val output = byteBuffer()
        jsonKeyIndexAppend(output, count)
        for (slot in slots) jsonKeyIndexAppend(output, slot)
        output.toText()
    } else jsonKeyIndexTextNative(count, slots)
}

private fun jsonKeyIndexAppend(var output: ByteBuffer, value: int): void {
    output.appendText(byteEncode(value & 255))
    output.appendText(byteEncode((value >> 8) & 255))
    output.appendText(byteEncode((value >> 16) & 255))
    output.appendText(byteEncode((value >> 24) & 255))
    return
}

// Encodes the member count and hash table slots as unsigned 32-bit little-endian words.
trusted fun jsonKeyIndexTextNative(count: int, slots: array<int>): string {
    val size = (slots.size + 1) * 4
    val buffer = nativeByteBuffer(size + 1)
    var address = nativePointerAddress(buffer.address)
    var index = -1
    while (index < slots.size) {
        val value = if (index < 0) count else slots[index]
        ablaUnsafeStoreU8(nativePointerFromAddress(address), value & 255)
        ablaUnsafeStoreU8(nativePointerFromAddress(address + 1), (value >> 8) & 255)
        ablaUnsafeStoreU8(nativePointerFromAddress(address + 2), (value >> 16) & 255)
        ablaUnsafeStoreU8(nativePointerFromAddress(address + 3), (value >> 24) & 255)
        address = address + 4
        index = index + 1
    }
    buffer.adoptString(size)
}

private fun jsonIndexedObject(keys: array<string>, values: array<Json>): Json =
    Json(5, jsonKeyIndexOf(keys), 0, false, keys, values, jsonNoNumber)

// `key`'s last position among `keys`, or -1.
private fun jsonKeyIndexPosition(index: string, keys: array<string>, key: string): int {
    val mask = index.size / 4 - 2
    var slot = jsonKeyHash(key) & mask
    var entry = textReadU32LittleEndian(index, 4 + slot * 4)
    while (entry != 0) {
        if (entry <= keys.size && keys[entry - 1] == key) return entry - 1
        slot = (slot + 1) & mask
        entry = textReadU32LittleEndian(index, 4 + slot * 4)
    }
    -1
}

// Parses one JSON value from UTF-8 `source` using `limits`. Invalid syntax, trailing input, invalid UTF-8, and limit violations return succeeded = false with JSON null and a diagnostic location.
fun jsonParse(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonParseResult {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits)) {
        state.fail("input_limit", "invalid JSON parser limits", 0)
    }
    if (state.errorCode.size == 0 && source.size > limits.maximumBytes) {
        state.fail(
            "input_limit", "JSON input exceeds configured byte limit",
            limits.maximumBytes
        )
    }
    if (state.errorCode.size == 0) {
        // The runtime's validator skips ASCII a word at a time; the per-byte pass only finds
        // where invalid input goes wrong.
        if (!source.isValidUtf8()) {
            val utf8 = utf8Info(source)
            if (!utf8.valid) {
                state.fail("invalid_unicode", "JSON input is not valid UTF-8", utf8.errorOffset)
            }
        }
    }
    var value = jsonNull()
    if (state.errorCode.size == 0) value = jsonParseValue(state, 1)
    jsonSkipWhitespace(state)
    if (state.errorCode.size == 0 && state.offset != source.size) {
        state.fail("trailing_input", "trailing input after JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        JsonParseResult(value, true, JsonError("", "", 0, 1, 1))
    } else {
        val location = jsonErrorLocation(source, state.errorOffset)
        JsonParseResult(
            jsonNull(),
            false,
            JsonError(
                state.errorCode,
                state.errorMessage,
                state.errorOffset,
                location[0],
                location[1]
            )
        )
    }
}

// Whether `source` is one JSON value jsonParse accepts under `limits`, without
// building it: the same result as jsonParse (succeeded, and the error's code,
// message, offset, line and column), with a null value. It checks what jsonParse
// checks, in the same order, and allocates only for strings with escapes and for
// object keys it must compare (duplicates rejected or merged).
fun jsonValidate(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonParseResult {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits)) {
        state.fail("input_limit", "invalid JSON parser limits", 0)
    }
    if (state.errorCode.size == 0 && source.size > limits.maximumBytes) {
        state.fail(
            "input_limit", "JSON input exceeds configured byte limit",
            limits.maximumBytes
        )
    }
    if (state.errorCode.size == 0) {
        // The runtime's validator skips ASCII a word at a time; the per-byte pass only finds
        // where invalid input goes wrong.
        if (!source.isValidUtf8()) {
            val utf8 = utf8Info(source)
            if (!utf8.valid) {
                state.fail("invalid_unicode", "JSON input is not valid UTF-8", utf8.errorOffset)
            }
        }
    }
    if (state.errorCode.size == 0) state.offset = jsonValidateAt(state, state.offset, 1)
    jsonSkipWhitespace(state)
    if (state.errorCode.size == 0 && state.offset != source.size) {
        state.fail("trailing_input", "trailing input after JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        JsonParseResult(jsonNull(), true, JsonError("", "", 0, 1, 1))
    } else {
        val location = jsonErrorLocation(source, state.errorOffset)
        JsonParseResult(
            jsonNull(),
            false,
            JsonError(
                state.errorCode,
                state.errorMessage,
                state.errorOffset,
                location[0],
                location[1]
            )
        )
    }
}

// jsonParseValue's walk without the tree, its cursor in a local: the offset after
// the value at `offset`. Each check is jsonParseValue's, at the same point and
// offset; an object keeps its keys only while they decide something (duplicates
// rejected, or merged: then the member limit counts distinct keys).
private fun jsonValidateAt(var state: JsonParserState, start: int, depth: int): int {
    val source = state.source
    val size = source.size
    var offset = jsonWhitespaceAfter(source, start)
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail("depth_limit", "JSON nesting exceeds configured limit", offset)
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) {
            state.fail("node_limit", "JSON node count exceeds configured limit", offset)
        }
    }
    if (state.errorCode.size == 0 && offset >= size) {
        state.fail("unexpected_end", "expected JSON value", offset)
    }
    if (state.errorCode.size != 0) return offset
    val byte = source[offset]
    if (byte == 34) return jsonScanString(state, offset)
    if (byte == 91) {
        offset = jsonWhitespaceAfter(source, offset + 1)
        var closed = false
        if (offset < size && source[offset] == 93) {
            offset = offset + 1
            closed = true
        }
        while (state.errorCode.size == 0 && !closed) {
            offset = jsonWhitespaceAfter(source, jsonValidateAt(state, offset, depth + 1))
            if (offset >= size) {
                state.fail("unexpected_end", "unterminated JSON array", offset)
            } else if (source[offset] == 93) {
                offset = offset + 1
                closed = true
            } else if (source[offset] == 44) {
                offset = jsonWhitespaceAfter(source, offset + 1)
                if (offset < size && source[offset] == 93) {
                    state.fail("unexpected_token", "trailing comma in JSON array", offset)
                }
            } else state.fail(
                "unexpected_token", "expected comma or closing bracket", offset
            )
        }
        return offset
    }
    if (byte == 123) {
        val reject = state.limits.rejectDuplicateKeys
        val merge = !reject && state.limits.mergeDuplicateKeys
        val keys: array<string> = []
        var keyIndex: JsonKeyTable? = null
        var members = 0
        offset = jsonWhitespaceAfter(source, offset + 1)
        var closed = false
        if (offset < size && source[offset] == 125) {
            offset = offset + 1
            closed = true
        }
        while (state.errorCode.size == 0 && !closed) {
            if (offset >= size) {
                state.fail("unexpected_end", "unterminated JSON object", offset)
            } else if (source[offset] != 34) {
                state.fail("unexpected_token", "JSON object key must be a string", offset)
            }
            var key = ""
            if (state.errorCode.size == 0) {
                if (reject || merge) {
                    state.offset = offset
                    key = jsonParseString(state)
                    offset = state.offset
                } else offset = jsonScanString(state, offset)
            }
            if (state.errorCode.size == 0 && members >= state.limits.maximumObjectMembers) {
                state.fail(
                    "node_limit", "JSON object member count exceeds configured limit", offset
                )
            }
            var duplicate = false
            var earlier = -1
            if (reject) {
                if (keyIndex == null && keys.size >= jsonKeyIndexMembers) {
                    keyIndex = jsonKeyTable()
                }
                duplicate = jsonKeyRepeats(keys, keyIndex, key)
            } else if (merge && state.errorCode.size == 0) {
                if (keyIndex == null && keys.size >= jsonKeyIndexMembers) {
                    keyIndex = jsonKeyTable()
                }
                earlier = jsonKeyPosition(keys, keyIndex, key)
            }
            if (state.errorCode.size == 0 && duplicate) {
                state.fail("duplicate_key", "duplicate JSON object key", offset)
            }
            offset = jsonWhitespaceAfter(source, offset)
            if (state.errorCode.size == 0 && (offset >= size || source[offset] != 58)) {
                state.fail("unexpected_token", "expected colon after JSON object key", offset)
            }
            if (state.errorCode.size == 0) offset = offset + 1
            if (state.errorCode.size == 0) offset = jsonValidateAt(state, offset, depth + 1)
            if (state.errorCode.size == 0 && earlier < 0) {
                if (reject || merge) keys.append(key)
                members = members + 1
            }
            offset = jsonWhitespaceAfter(source, offset)
            if (state.errorCode.size == 0 && offset >= size) {
                state.fail("unexpected_end", "unterminated JSON object", offset)
            } else if (state.errorCode.size == 0 && source[offset] == 125) {
                offset = offset + 1
                closed = true
            } else if (state.errorCode.size == 0 && source[offset] == 44) {
                offset = jsonWhitespaceAfter(source, offset + 1)
                if (offset < size && source[offset] == 125) {
                    state.fail("unexpected_token", "trailing comma in JSON object", offset)
                }
            } else if (state.errorCode.size == 0) state.fail(
                "unexpected_token", "expected comma or closing brace", offset
            )
        }
        return offset
    }
    if ((byte >= 48 && byte <= 57) || byte == 45 || byte == 43) {
        val begin = offset
        var scanning = true
        while (scanning && offset < size) {
            val next = source[offset]
            scanning = (next >= 48 && next <= 57) || next == 45 ||
                next == 43 || next == 46 || next == 101 || next == 69
            if (scanning) offset = offset + 1
        }
        if (jsonNumberKindRange(source, begin, offset) < 0) {
            state.fail("invalid_number", "invalid JSON number", begin)
        }
        return offset
    }
    if (jsonLiteralAt(source, offset, 1)) return offset + 4
    if (jsonLiteralAt(source, offset, 2)) return offset + 5
    if (jsonLiteralAt(source, offset, 3)) return offset + 4
    state.fail("unexpected_token", "unexpected token in JSON input", offset)
    offset
}

// A parsed document kept as its source and a tape: four ints per value, in
// source order, so a large document is a few allocations and nothing the
// collector traces value by value. Each value is [kind | flag | count << 8,
// begin, end, next]: Json's kinds (0 null, 1 string, 2 number, 3 boolean,
// 4 array, 5 object); the flag (16) marks a string with escapes, `true`, an
// integer number, or an object whose repeated keys merged; count is an array's
// elements or the members jsonParse's object would hold; [begin, end) is the
// value's source bytes (a string's with its quotes); next is the tape index
// after it. An object's members are a key (a string) followed by its value,
// every one as written.
class JsonDocument(
    val source: string,
    val tape: array<int>,
    val limits: JsonLimits
)

// A value of a document: its tape index, or -1 for a missing one (which reads
// as null).
class JsonNode(
    val document: JsonDocument,
    val index: int
)

// Holds a tape-backed JSON document and success flag, with a diagnostic describing a failed parse.
class JsonDocumentResult(
    val document: JsonDocument,
    val succeeded: bool,
    val error: JsonError
)

private val jsonTapeFlag = 16

// `source` parsed into a document: the same `succeeded` and `error` jsonParse
// gives under `limits`, and on success a document whose nodes read as
// jsonParse's tree does (toJson() builds that tree for any node).
fun jsonDocument(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonDocumentResult {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits)) {
        state.fail("input_limit", "invalid JSON parser limits", 0)
    }
    if (state.errorCode.size == 0 && source.size > limits.maximumBytes) {
        state.fail(
            "input_limit", "JSON input exceeds configured byte limit",
            limits.maximumBytes
        )
    }
    if (state.errorCode.size == 0) {
        // The runtime's validator skips ASCII a word at a time; the per-byte pass only finds
        // where invalid input goes wrong.
        if (!source.isValidUtf8()) {
            val utf8 = utf8Info(source)
            if (!utf8.valid) {
                state.fail("invalid_unicode", "JSON input is not valid UTF-8", utf8.errorOffset)
            }
        }
    }
    val tape: array<int> = []
    if (state.errorCode.size == 0) state.offset = jsonDocumentAt(state, tape, state.offset, 1)
    jsonSkipWhitespace(state)
    if (state.errorCode.size == 0 && state.offset != source.size) {
        state.fail("trailing_input", "trailing input after JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        JsonDocumentResult(JsonDocument(source, tape, limits), true, JsonError("", "", 0, 1, 1))
    } else {
        val location = jsonErrorLocation(source, state.errorOffset)
        JsonDocumentResult(
            JsonDocument(source, [], limits),
            false,
            JsonError(
                state.errorCode,
                state.errorMessage,
                state.errorOffset,
                location[0],
                location[1]
            )
        )
    }
}

private fun jsonTapeAppend(var tape: array<int>, word: int, begin: int, end: int): void {
    tape.append(word)
    tape.append(begin)
    tape.append(end)
    tape.append(tape.size + 1)
    return
}

// The string at `offset` (its quote), consumed onto the tape: the offset after it.
private fun jsonDocumentString(var state: JsonParserState, var tape: array<int>, offset: int): int {
    val source = state.source
    val plainEnd = jsonPlainStringEnd(source, offset + 1, source.size)
    if (plainEnd > offset && plainEnd - offset - 1 <= state.limits.maximumStringBytes) {
        jsonTapeAppend(tape, 1, offset, plainEnd + 1)
        return plainEnd + 1
    }
    jsonParseStringFallback(state, offset, offset + 1)
    if (state.errorCode.size == 0) jsonTapeAppend(tape, 1 | jsonTapeFlag, offset, state.offset)
    state.offset
}

// jsonValidateAt's walk (jsonParseValue's checks, in order, at the same offsets),
// writing each value onto `tape`: the offset after the value at `start`.
private fun jsonDocumentAt(
    var state: JsonParserState,
    var tape: array<int>,
    start: int,
    depth: int
): int {
    val source = state.source
    val size = source.size
    var offset = jsonWhitespaceAfter(source, start)
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail("depth_limit", "JSON nesting exceeds configured limit", offset)
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) {
            state.fail("node_limit", "JSON node count exceeds configured limit", offset)
        }
    }
    if (state.errorCode.size == 0 && offset >= size) {
        state.fail("unexpected_end", "expected JSON value", offset)
    }
    if (state.errorCode.size != 0) return offset
    val byte = source[offset]
    if (byte == 34) return jsonDocumentString(state, tape, offset)
    if (byte == 91) {
        val at = tape.size
        jsonTapeAppend(tape, 4, offset, offset)
        var count = 0
        offset = jsonWhitespaceAfter(source, offset + 1)
        var closed = false
        if (offset < size && source[offset] == 93) {
            offset = offset + 1
            closed = true
        }
        while (state.errorCode.size == 0 && !closed) {
            offset = jsonWhitespaceAfter(source, jsonDocumentAt(state, tape, offset, depth + 1))
            count = count + 1
            if (offset >= size) {
                state.fail("unexpected_end", "unterminated JSON array", offset)
            } else if (source[offset] == 93) {
                offset = offset + 1
                closed = true
            } else if (source[offset] == 44) {
                offset = jsonWhitespaceAfter(source, offset + 1)
                if (offset < size && source[offset] == 93) {
                    state.fail("unexpected_token", "trailing comma in JSON array", offset)
                }
            } else state.fail(
                "unexpected_token", "expected comma or closing bracket", offset
            )
        }
        tape[at] = 4 | (count << 8)
        tape[at + 2] = offset
        tape[at + 3] = tape.size
        return offset
    }
    if (byte == 123) {
        val at = tape.size
        jsonTapeAppend(tape, 5, offset, offset)
        val reject = state.limits.rejectDuplicateKeys
        val merge = !reject && state.limits.mergeDuplicateKeys
        val keys: array<string> = []
        var keyIndex: JsonKeyTable? = null
        var members = 0
        var merged = false
        offset = jsonWhitespaceAfter(source, offset + 1)
        var closed = false
        if (offset < size && source[offset] == 125) {
            offset = offset + 1
            closed = true
        }
        while (state.errorCode.size == 0 && !closed) {
            if (offset >= size) {
                state.fail("unexpected_end", "unterminated JSON object", offset)
            } else if (source[offset] != 34) {
                state.fail("unexpected_token", "JSON object key must be a string", offset)
            }
            var key = ""
            if (state.errorCode.size == 0) {
                val keyBegin = offset
                offset = jsonDocumentString(state, tape, offset)
                if (state.errorCode.size == 0 && (reject || merge)) {
                    key = jsonNodeText(source, state.limits, tape, tape.size - 4)
                }
                if (state.errorCode.size != 0) offset = if (offset < keyBegin) keyBegin else offset
            }
            if (state.errorCode.size == 0 && members >= state.limits.maximumObjectMembers) {
                state.fail(
                    "node_limit", "JSON object member count exceeds configured limit", offset
                )
            }
            var duplicate = false
            var earlier = -1
            if (reject) {
                if (keyIndex == null && keys.size >= jsonKeyIndexMembers) {
                    keyIndex = jsonKeyTable()
                }
                duplicate = jsonKeyRepeats(keys, keyIndex, key)
            } else if (merge && state.errorCode.size == 0) {
                if (keyIndex == null && keys.size >= jsonKeyIndexMembers) {
                    keyIndex = jsonKeyTable()
                }
                earlier = jsonKeyPosition(keys, keyIndex, key)
            }
            if (state.errorCode.size == 0 && duplicate) {
                state.fail("duplicate_key", "duplicate JSON object key", offset)
            }
            offset = jsonWhitespaceAfter(source, offset)
            if (state.errorCode.size == 0 && (offset >= size || source[offset] != 58)) {
                state.fail("unexpected_token", "expected colon after JSON object key", offset)
            }
            if (state.errorCode.size == 0) offset = offset + 1
            if (state.errorCode.size == 0) offset = jsonDocumentAt(state, tape, offset, depth + 1)
            if (state.errorCode.size == 0 && earlier >= 0) merged = true
            if (state.errorCode.size == 0 && earlier < 0) {
                if (reject || merge) keys.append(key)
                members = members + 1
            }
            offset = jsonWhitespaceAfter(source, offset)
            if (state.errorCode.size == 0 && offset >= size) {
                state.fail("unexpected_end", "unterminated JSON object", offset)
            } else if (state.errorCode.size == 0 && source[offset] == 125) {
                offset = offset + 1
                closed = true
            } else if (state.errorCode.size == 0 && source[offset] == 44) {
                offset = jsonWhitespaceAfter(source, offset + 1)
                if (offset < size && source[offset] == 125) {
                    state.fail("unexpected_token", "trailing comma in JSON object", offset)
                }
            } else if (state.errorCode.size == 0) state.fail(
                "unexpected_token", "expected comma or closing brace", offset
            )
        }
        tape[at] = 5 | (if (merged) jsonTapeFlag else 0) | (members << 8)
        tape[at + 2] = offset
        tape[at + 3] = tape.size
        return offset
    }
    if ((byte >= 48 && byte <= 57) || byte == 45 || byte == 43) {
        val begin = offset
        var scanning = true
        while (scanning && offset < size) {
            val next = source[offset]
            scanning = (next >= 48 && next <= 57) || next == 45 ||
                next == 43 || next == 46 || next == 101 || next == 69
            if (scanning) offset = offset + 1
        }
        val kind = jsonNumberKindRange(source, begin, offset)
        if (kind < 0) state.fail("invalid_number", "invalid JSON number", begin)
        else jsonTapeAppend(tape, 2 | (if (kind == 1) jsonTapeFlag else 0), begin, offset)
        return offset
    }
    if (jsonLiteralAt(source, offset, 1)) {
        jsonTapeAppend(tape, 3 | jsonTapeFlag, offset, offset + 4)
        return offset + 4
    }
    if (jsonLiteralAt(source, offset, 2)) {
        jsonTapeAppend(tape, 3, offset, offset + 5)
        return offset + 5
    }
    if (jsonLiteralAt(source, offset, 3)) {
        jsonTapeAppend(tape, 0, offset, offset + 4)
        return offset + 4
    }
    state.fail("unexpected_token", "unexpected token in JSON input", offset)
    offset
}

// The text of the string at tape index `index` (decoded, if it has escapes).
private fun jsonNodeText(source: string, limits: JsonLimits, tape: array<int>, index: int): string {
    val begin = tape[index + 1]
    val end = tape[index + 2]
    if ((tape[index] & jsonTapeFlag) == 0) return source.slice(begin + 1, end - 1)
    val state = JsonParserState(source, limits, begin, 0, "", "", 0)
    jsonParseQuoted(state)
}

// Whether the string at tape index `index` reads as `key`, compared in place
// when it has no escapes.
private fun jsonNodeTextIs(document: JsonDocument, index: int, key: string): bool {
    val tape = document.tape
    if ((tape[index] & jsonTapeFlag) != 0) {
        return jsonNodeText(document.source, document.limits, tape, index) == key
    }
    val begin = tape[index + 1] + 1
    if (tape[index + 2] - 1 - begin != key.size) return false
    val source = document.source
    var position = 0
    while (position < key.size) {
        if (source[begin + position] != key[position]) return false
        position = position + 1
    }
    true
}

// Returns the document's root node, or a missing node when there is no parsed root.
fun JsonDocument.root(): JsonNode = JsonNode(this, if (this.tape.size > 0) 0 else -1)

// What a node or a cursor reads at tape index `index` (-1: missing, read as null).
private fun jsonTapeKind(document: JsonDocument, index: int): int =
    if (index < 0) 0 else document.tape[index] & 15

private fun jsonTapeSize(document: JsonDocument, index: int): int {
    val kind = jsonTapeKind(document, index)
    if (kind == 4 || kind == 5) document.tape[index] >> 8 else 0
}

private fun jsonTapeRaw(document: JsonDocument, index: int): string =
    if (index < 0) ""
    else document.source.slice(document.tape[index + 1], document.tape[index + 2])

private fun jsonTapeString(document: JsonDocument, index: int): string =
    if (jsonTapeKind(document, index) == 1) jsonNodeText(document.source, document.limits,
        document.tape, index)
    else ""

private fun jsonTapeBoolean(document: JsonDocument, index: int): bool =
    jsonTapeKind(document, index) == 3 && (document.tape[index] & jsonTapeFlag) != 0

private fun jsonTapeNumber(document: JsonDocument, index: int): JsonNumber {
    if (jsonTapeKind(document, index) != 2) return jsonEmptyNumber()
    val text = jsonTapeRaw(document, index)
    val integer = (document.tape[index] & jsonTapeFlag) != 0
    val available = integer && jsonIntegerTextAvailable(text)
    JsonNumber(text, integer, if (available) jsonIntegerTextValue(text) else 0, available)
}

// A number's integer value read in place, or 0 (as Json's asInt): no text, no
// record.
private fun jsonTapeInt(document: JsonDocument, index: int): int {
    if (jsonTapeKind(document, index) != 2 || (document.tape[index] & jsonTapeFlag) == 0) return 0
    val source = document.source
    val begin = document.tape[index + 1]
    val end = document.tape[index + 2]
    val negative = source[begin] == 45
    val first = if (negative) begin + 1 else begin
    val digits = end - first
    if (digits > 19) return 0
    if (digits == 19) {
        val limit = if (negative) "9223372036854775808" else "9223372036854775807"
        var position = 0
        while (position < 19) {
            val actual = source[first + position]
            val maximum = limit[position]
            if (actual < maximum) position = 19
            else if (actual > maximum) return 0
            else position = position + 1
        }
    }
    var value = 0
    var offset = first
    while (offset < end) {
        value = value * 10 - (source[offset] - 48)
        offset = offset + 1
    }
    if (negative) value else -value
}

// A number as the nearest f64, read in place (as the readers' readNumber); 0.0
// for anything else.
private fun jsonTapeF64(document: JsonDocument, index: int): f64 =
    if (jsonTapeKind(document, index) != 2) 0.0
    else f64ParseRange(document.source, document.tape[index + 1], document.tape[index + 2])

private fun jsonTapeIntAvailable(document: JsonDocument, index: int): bool =
    jsonTapeKind(document, index) == 2 && jsonTapeNumber(document, index).intAvailable

// A string's length in UTF-16 code units (as JavaScript's `length`), counted from
// its UTF-8 bytes; 0 for anything else.
private fun jsonTapeUtf16Length(document: JsonDocument, index: int): int {
    if (jsonTapeKind(document, index) != 1) return 0
    val tape = document.tape
    val text = if ((tape[index] & jsonTapeFlag) != 0) jsonNodeText(document.source, document.limits,
        tape, index)
        else document.source
    val begin = if ((tape[index] & jsonTapeFlag) != 0) 0 else tape[index + 1] + 1
    val end = if ((tape[index] & jsonTapeFlag) != 0) text.size else tape[index + 2] - 1
    var units = 0
    var offset = begin
    while (offset < end) {
        val byte = text[offset]
        if (byte < 128 || (byte >= 192 && byte < 240)) units = units + 1
        else if (byte >= 240) units = units + 2
        offset = offset + 1
    }
    units
}

// Returns the value kind as an integer from 0 (null) through 5 (object). Missing nodes use kind 0, so use exists to distinguish them.
fun JsonNode.kind(): int = jsonTapeKind(this.document, this.index)
// Returns true when this node represents JSON null or is missing.
fun JsonNode.isNull(): bool = this.kind() == 0
// Returns true when this node represents a string.
fun JsonNode.isString(): bool = this.kind() == 1
// Returns true when this node represents a number.
fun JsonNode.isNumber(): bool = this.kind() == 2
// Returns true when this node represents a boolean.
fun JsonNode.isBoolean(): bool = this.kind() == 3
// Returns true when this node represents an array.
fun JsonNode.isArray(): bool = this.kind() == 4
// Returns true when this node represents an object.
fun JsonNode.isObject(): bool = this.kind() == 5
// Whether the node is a value of the document (not a missing member or element).
fun JsonNode.exists(): bool = this.index >= 0

// An array's elements or an object's members (as jsonParse's object holds them:
// repeated keys counted once when they merge); 0 for anything else.
fun JsonNode.size(): int = jsonTapeSize(this.document, this.index)

// The value's source text, exactly as written (a string with its quotes); "" for
// a missing node.
fun JsonNode.raw(): string = jsonTapeRaw(this.document, this.index)

// Returns the decoded string or an empty string for a missing node or another kind.
fun JsonNode.asString(): string = jsonTapeString(this.document, this.index)

// Returns the boolean, or false for a missing node or another kind.
fun JsonNode.asBoolean(): bool = jsonTapeBoolean(this.document, this.index)

// As Json's asNumber: the number's text and integer value (an empty number for
// anything else).
fun JsonNode.asNumber(): JsonNumber = jsonTapeNumber(this.document, this.index)

// Returns true for a number written as an integer and representable as int.
fun JsonNode.intAvailable(): bool = jsonTapeIntAvailable(this.document, this.index)

// Returns the node's integer value or zero when intAvailable is false.
fun JsonNode.asInt(): int = jsonTapeInt(this.document, this.index)

// A number as the nearest f64 (as a reader's readNumber); 0.0 otherwise.
fun JsonNode.asF64(): f64 = jsonTapeF64(this.document, this.index)

// A string's length in UTF-16 code units, as JavaScript counts it; 0 otherwise.
fun JsonNode.utf16Length(): int = jsonTapeUtf16Length(this.document, this.index)

// The tape index of an array's element `position`, or -1.
private fun jsonNodeElement(node: JsonNode, position: int): int {
    if (node.kind() != 4 || position < 0 || position >= node.size()) return -1
    val tape = node.document.tape
    var child = node.index + 4
    var remaining = position
    while (remaining > 0) {
        child = tape[child + 3]
        remaining = remaining - 1
    }
    child
}

// The tape index of the key of an object's member `position` as jsonParse's
// object holds it (its first key, with the last value for that key, when keys
// merged), or -1.
private fun jsonNodeMemberKey(node: JsonNode, position: int): int {
    if (node.kind() != 5 || position < 0 || position >= node.size()) return -1
    val tape = node.document.tape
    val end = tape[node.index + 3]
    var key = node.index + 4
    if ((tape[node.index] & jsonTapeFlag) == 0) {
        var remaining = position
        while (remaining > 0) {
            key = tape[key + 7]
            remaining = remaining - 1
        }
        return key
    }
    // Merged: count distinct keys in first-appearance order.
    val seen: array<string> = []
    while (key < end) {
        val text = jsonNodeText(node.document.source, node.document.limits, tape, key)
        var known = false
        for (earlier in seen) if (earlier == text) known = true
        if (!known) {
            if (seen.size == position) return key
            seen.append(text)
        }
        key = tape[key + 7]
    }
    -1
}

// The value of the last member whose key is the text at tape index `keyIndex`.
private fun jsonNodeLastValue(node: JsonNode, keyIndex: int): int {
    val tape = node.document.tape
    val text = jsonNodeText(node.document.source, node.document.limits, tape, keyIndex)
    val found = jsonNodeFind(node, text)
    if (found >= 0) found else keyIndex + 4
}

// The tape index of the value of the last member keyed `key`, or -1.
private fun jsonNodeFind(node: JsonNode, key: string): int {
    if (node.kind() != 5) return -1
    val tape = node.document.tape
    val end = tape[node.index + 3]
    var member = node.index + 4
    var found = -1
    while (member < end) {
        if (jsonNodeTextIs(node.document, member, key)) found = member + 4
        member = tape[member + 7]
    }
    found
}

// An array's element or an object's member value at `position` (as Json's `at`),
// or a missing node.
fun JsonNode.at(position: int): JsonNode {
    if (this.kind() == 5) {
        val key = jsonNodeMemberKey(this, position)
        val merged = (this.document.tape[this.index] & jsonTapeFlag) != 0
        return JsonNode(
            this.document,
            if (key < 0) -1 else if (merged) jsonNodeLastValue(this, key) else key + 4
        )
    }
    JsonNode(this.document, jsonNodeElement(this, position))
}

// An object's key at `position` (as Json's `keys`), or "".
fun JsonNode.keyAt(position: int): string {
    val key = jsonNodeMemberKey(this, position)
    if (key < 0) "" else jsonNodeText(this.document.source, this.document.limits,
        this.document.tape, key)
}

// The value of an object's last member keyed `key` (as Json's `get`), or a
// missing node.
fun JsonNode.get(key: string): JsonNode = JsonNode(this.document, jsonNodeFind(this, key))

// Returns true if the node is an object with member `key`, including a member with a null value.
fun JsonNode.has(key: string): bool = jsonNodeFind(this, key) >= 0

// Returns the decoded string at `key`, or an empty string when absent or of another kind.
fun JsonNode.getString(key: string): string = this.get(key).asString()

// Returns the int at `key`, or zero when absent or unavailable as an int.
fun JsonNode.getInt(key: string): int = this.get(key).asInt()

// A forward cursor over an array's elements or an object's members, which reads
// the current one in place: stepping and reading scalars allocate nothing (only
// node(), key() and nested cursors do). An object's members come as jsonParse's
// object holds them: with merged repeated keys, each key once, at its first
// position, with its last value.
class JsonCursor(
    val document: JsonDocument,
    // The array or object (its tape index), -1 for an empty cursor.
    val container: int,
    // The current element's or member value's tape index (-1 before the first
    // and after the last), and a member's key's.
    var index: int,
    var keyIndex: int,
    // Members or elements stepped to so far, and the tape index to visit next.
    var position: int,
    var following: int
)

// Returns a cursor over array elements, or an empty cursor for another kind. Call next before reading.
fun JsonNode.elements(): JsonCursor =
    if (this.kind() == 4) JsonCursor(this.document, this.index, -1, -1, 0, this.index + 4)
    else JsonCursor(this.document, -1, -1, -1, 0, 0)

// Returns a cursor over object members, or an empty cursor for another kind. Call next before reading.
fun JsonNode.members(): JsonCursor =
    if (this.kind() == 5) JsonCursor(this.document, this.index, -1, -1, 0, this.index + 4)
    else JsonCursor(this.document, -1, -1, -1, 0, 0)

// Steps to the next element or member: false (and nothing current) past the last.
fun JsonCursor.next(): bool {
    if (this.container < 0) return false
    val tape = this.document.tape
    if (this.position >= tape[this.container] >> 8) {
        this.index = -1
        this.keyIndex = -1
        return false
    }
    val node = JsonNode(this.document, this.container)
    if ((tape[this.container] & 15) == 5 && (tape[this.container] & jsonTapeFlag) != 0) {
        // Merged repeated keys: the member as jsonParse holds it.
        this.keyIndex = jsonNodeMemberKey(node, this.position)
        this.index = jsonNodeLastValue(node, this.keyIndex)
    } else if ((tape[this.container] & 15) == 5) {
        this.keyIndex = this.following
        this.index = this.following + 4
        this.following = tape[this.following + 7]
    } else {
        this.index = this.following
        this.following = tape[this.following + 3]
    }
    this.position = this.position + 1
    true
}

// Returns the current value as a node. Before the first successful next and after exhaustion, returns a missing node.
fun JsonCursor.node(): JsonNode = JsonNode(this.document, this.index)
// Returns the current value's kind. Kind 0 represents null or no current value.
fun JsonCursor.kind(): int = jsonTapeKind(this.document, this.index)
// Returns the element or member count of the current array or object, or zero for another kind or no current value.
fun JsonCursor.size(): int = jsonTapeSize(this.document, this.index)
// Returns the current value's original JSON spelling, or an empty string when there is no current value.
fun JsonCursor.raw(): string = jsonTapeRaw(this.document, this.index)
// Returns the current string decoded, or an empty string if it is missing or another kind.
fun JsonCursor.asString(): string = jsonTapeString(this.document, this.index)
// Returns the current boolean, or false if it is missing or another kind.
fun JsonCursor.asBoolean(): bool = jsonTapeBoolean(this.document, this.index)
// Returns the current number's original spelling and integer metadata, or an empty number record for another kind or no current value.
fun JsonCursor.asNumber(): JsonNumber = jsonTapeNumber(this.document, this.index)
// Returns the current int, or zero when intAvailable is false.
fun JsonCursor.asInt(): int = jsonTapeInt(this.document, this.index)
// Returns the current number rounded to f64, or zero if the cursor is not on a number.
fun JsonCursor.asF64(): f64 = jsonTapeF64(this.document, this.index)
// Returns true when the current value is a JSON integer representable as int.
fun JsonCursor.intAvailable(): bool = jsonTapeIntAvailable(this.document, this.index)
// Returns the current string's length in UTF-16 code units, or zero if the cursor is not on a string.
fun JsonCursor.utf16Length(): int = jsonTapeUtf16Length(this.document, this.index)
// Returns a cursor over the current array's elements, or an empty cursor for a value of another kind.
fun JsonCursor.elements(): JsonCursor = this.node().elements()
// Returns a cursor over the current object's members, or an empty cursor for a value of another kind.
fun JsonCursor.members(): JsonCursor = this.node().members()

// The current member's key ("" for an element).
fun JsonCursor.key(): string =
    if (this.keyIndex < 0) "" else jsonNodeText(this.document.source, this.document.limits,
        this.document.tape, this.keyIndex)

// Whether the current member's key is `name`, compared in place.
fun JsonCursor.keyIs(name: string): bool = this.keyIndex >= 0 && jsonNodeTextIs(this.document,
    this.keyIndex, name)

// The value of `key` as a JavaScript array index ("0", or digits without a
// leading zero, below 2^32 - 1), or -1 for any other key.
private fun jsonJsIndex(key: string): int {
    if (key.size == 0 || key.size > 10 || (key.size > 1 && key[0] == 48)) return -1
    var value = 0
    for (byte in key) {
        if (byte < 48 || byte > 57) return -1
        value = value * 10 + byte - 48
    }
    if (value < 4294967295) value else -1
}

// The positions of `keys` in the order JavaScript gives an object's keys: array
// indexes first, ascending, then the others in their order.
private fun jsonJsOrder(keys: array<string>): array<int> {
    val indexValues: array<int> = []
    val indexPositions: array<int> = []
    val others: array<int> = []
    var position = 0
    while (position < keys.size) {
        val value = jsonJsIndex(keys[position])
        if (value >= 0) {
            indexValues.append(value)
            indexPositions.append(position)
        } else others.append(position)
        position = position + 1
    }
    // A stable merge sort of the index keys by value, bottom up.
    var values: array<int> = []
    var positions: array<int> = []
    for (value in indexValues) values.append(value)
    for (at in indexPositions) positions.append(at)
    var width = 1
    while (width < values.size) {
        val nextValues: array<int> = []
        val nextPositions: array<int> = []
        var begin = 0
        while (begin < values.size) {
            val middle = if (begin + width < values.size) begin + width else values.size
            val end = if (begin + 2 * width < values.size) begin + 2 * width else values.size
            var left = begin
            var right = middle
            while (left < middle || right < end) {
                if (right >= end || (left < middle && values[left] <= values[right])) {
                    nextValues.append(values[left])
                    nextPositions.append(positions[left])
                    left = left + 1
                } else {
                    nextValues.append(values[right])
                    nextPositions.append(positions[right])
                    right = right + 1
                }
            }
            begin = end
        }
        values = nextValues
        positions = nextPositions
        width = width * 2
    }
    val order: array<int> = []
    for (at in positions) order.append(at)
    for (at in others) order.append(at)
    order
}

// `value` with every object's members in the order JavaScript gives them (array
// indexes first, ascending, then the other keys in their order), as
// JSON.stringify(JSON.parse(text)) writes them.
fun jsonJsKeyOrder(value: Json): Json {
    if (value.kind == 4) {
        val values: array<Json> = []
        for (element in value.values) values.append(jsonJsKeyOrder(element))
        return Json(4, "", 0, false, jsonNoKeys, values, jsonNoNumber)
    }
    if (value.kind != 5 || value.keys.size != value.values.size) return value
    val keys: array<string> = []
    val values: array<Json> = []
    for (position in jsonJsOrder(value.keys)) {
        keys.append(value.keys[position])
        values.append(jsonJsKeyOrder(value.values[position]))
    }
    jsonIndexedObject(keys, values)
}

// Edits to a document's objects, written out with the rest of the document in
// one pass by emit(). An edit names an object of the document (a JsonNode) and a
// key; edits apply in the order they were made, to the object's members as
// jsonParse holds them: set replaces the value of the last member with that key,
// or adds the member at the end; delete removes every member with that key.
// Edits naming anything but an object of this document are ignored.
class JsonEdits(
    val document: JsonDocument,
    val targets: array<int>,
    val keys: array<string>,
    val deletes: array<bool>,
    val values: array<Json>,
    // Per object's tape index, its edits' positions, in order.
    val byObject: Map<int, array<int>>,
    // Per object written from a member list (edited, or with merged keys).
    val prepared: Map<int, JsonEmitMembers>
)

// An object's members as emit writes them: each a key and either a tape index
// (value from the document) or, at -1, a Json from an edit.
class JsonEmitMembers(
    val keys: array<string>,
    val tapeValues: array<int>,
    val jsonValues: array<Json>
)

// Shared JSON null placeholder for edit records without a replacement value.
@threadShared
val jsonEmitPlaceholder = Json(0, "", 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)

// Returns an empty edit collection tied to this document.
fun JsonDocument.edits(): JsonEdits = JsonEdits(this, [], [], [], [], Map(), Map())

private fun jsonEditAdd(var edits: JsonEdits, target: JsonNode, key: string, delete: bool,
    value: Json): void {
    if (target.document != edits.document || target.kind() != 5) return
    val position = edits.targets.size
    edits.targets.append(target.index)
    edits.keys.append(key)
    edits.deletes.append(delete)
    edits.values.append(value)
    val list = edits.byObject.get(target.index)
    if (list != null) list.append(position)
    else edits.byObject.set(target.index, [position])
    return
}

// Queues replacement of the last member with `key` or appends it if absent, ignoring targets outside this document or of another kind.
fun JsonEdits.set(target: JsonNode, key: string, value: Json): void =
    jsonEditAdd(this, target, key, false, value)

// Queues removal of all members with `key`, ignoring targets outside this document or of another kind.
fun JsonEdits.delete(target: JsonNode, key: string): void =
    jsonEditAdd(this, target, key, true, jsonEmitPlaceholder)

// The members emit writes for the object at tape index `index`, built.
private fun jsonEmitMembersBuild(edits: JsonEdits, index: int): JsonEmitMembers {
    val document = edits.document
    val tape = document.tape
    val keys: array<string> = []
    val tapeValues: array<int> = []
    val jsonValues: array<Json> = []
    val merge = (tape[index] & jsonTapeFlag) != 0
    var keyIndex: JsonKeyTable? = null
    val end = tape[index + 3]
    var member = index + 4
    while (member < end) {
        val key = jsonNodeText(document.source, document.limits, tape, member)
        var earlier = -1
        if (merge) {
            if (keyIndex == null && keys.size >= jsonKeyIndexMembers) keyIndex = jsonKeyTable()
            earlier = jsonKeyPosition(keys, keyIndex, key)
        }
        if (earlier >= 0) tapeValues[earlier] = member + 4
        else {
            keys.append(key)
            tapeValues.append(member + 4)
            jsonValues.append(jsonEmitPlaceholder)
        }
        member = tape[member + 7]
    }
    var result = JsonEmitMembers(keys, tapeValues, jsonValues)
    val list = edits.byObject.get(index)
    if (list != null) {
        for (position in list) {
            val key = edits.keys[position]
            if (edits.deletes[position]) {
                val keptKeys: array<string> = []
                val keptTape: array<int> = []
                val keptJson: array<Json> = []
                var at = 0
                while (at < result.keys.size) {
                    if (result.keys[at] != key) {
                        keptKeys.append(result.keys[at])
                        keptTape.append(result.tapeValues[at])
                        keptJson.append(result.jsonValues[at])
                    }
                    at = at + 1
                }
                result = JsonEmitMembers(keptKeys, keptTape, keptJson)
            } else {
                var last = -1
                var at = 0
                while (at < result.keys.size) {
                    if (result.keys[at] == key) last = at
                    at = at + 1
                }
                if (last >= 0) {
                    result.tapeValues[last] = -1
                    result.jsonValues[last] = edits.values[position]
                } else {
                    result.keys.append(key)
                    result.tapeValues.append(-1)
                    result.jsonValues.append(edits.values[position])
                }
            }
        }
    }
    result
}

// Builds the member list of every object written from one (edited, with merged
// keys, or, in JavaScript's key order, with an array-index key), afresh: edits
// made since the last emit count.
private fun jsonEditsPrepare(var edits: JsonEdits, jsKeyOrder: bool): void {
    edits.prepared.clear()
    val document = edits.document
    val tape = document.tape
    var index = 0
    while (index < tape.size) {
        val word = tape[index]
        if ((word & 15) == 5) {
            var listed = (word & jsonTapeFlag) != 0 || edits.byObject.has(index)
            if (!listed && jsKeyOrder) {
                val end = tape[index + 3]
                var member = index + 4
                while (!listed && member < end) {
                    listed = jsonJsIndex(jsonTapeStringText(document, member)) >= 0
                    member = tape[member + 7]
                }
            }
            if (listed) {
                var members = jsonEmitMembersBuild(edits, index)
                if (jsKeyOrder) {
                    val keys: array<string> = []
                    val tapeValues: array<int> = []
                    val jsonValues: array<Json> = []
                    for (position in jsonJsOrder(members.keys)) {
                        keys.append(members.keys[position])
                        tapeValues.append(members.tapeValues[position])
                        jsonValues.append(
                            if (members.tapeValues[position] >= 0) members.jsonValues[position]
                            else jsonJsKeyOrder(members.jsonValues[position])
                        )
                    }
                    members = JsonEmitMembers(keys, tapeValues, jsonValues)
                }
                edits.prepared.set(index, members)
            }
        }
        index = index + 4
    }
    return
}

// The prepared members of the object at `index`.
private fun jsonEmitMembersOf(edits: JsonEdits, index: int): JsonEmitMembers {
    val known = edits.prepared.get(index)
    if (known != null) known else jsonEmitMembersBuild(edits, index)
}

// Whether the object at `index` is written from a (prepared) member list.
private fun jsonEmitListed(edits: JsonEdits, index: int): bool = edits.prepared.has(index)

// The edited document as a tree: what jsonParse gives, with the edits applied
// (with every object's keys in JavaScript's order, if asked).
fun JsonEdits.toJson(jsKeyOrder: bool = false): Json {
    jsonEditsPrepare(this, false)
    val tree = jsonEditedTree(this, if (this.document.tape.size > 0) 0 else -1)
    if (jsKeyOrder) jsonJsKeyOrder(tree) else tree
}

private fun jsonEditedTree(edits: JsonEdits, index: int): Json {
    if (index < 0) return jsonNull()
    val tape = edits.document.tape
    val kind = tape[index] & 15
    if (kind == 4) {
        val values: array<Json> = []
        val end = tape[index + 3]
        var child = index + 4
        while (child < end) {
            values.append(jsonEditedTree(edits, child))
            child = tape[child + 3]
        }
        return Json(4, "", 0, false, jsonNoKeys, values, jsonNoNumber)
    }
    if (kind != 5) return jsonNodeTree(edits.document, index)
    val members = jsonEmitMembersOf(edits, index)
    val keys: array<string> = []
    val values: array<Json> = []
    var at = 0
    while (at < members.keys.size) {
        keys.append(members.keys[at])
        values.append(
            if (members.tapeValues[at] >= 0) jsonEditedTree(edits, members.tapeValues[at])
            else members.jsonValues[at]
        )
        at = at + 1
    }
    jsonIndexedObject(keys, values)
}

// The document as jsonStringify writes jsonParse's tree (in JavaScript's key
// order, if asked: as JSON.stringify(JSON.parse(source)) writes it).
fun JsonDocument.emit(jsKeyOrder: bool = false): string = this.edits().emit(jsKeyOrder)

// The edited document as jsonStringify writes it (jsonStringify(toJson())), in one
// pass over the tape: numbers as written, strings as jsonStringify writes them,
// edited objects (and objects whose repeated keys merged) from their members;
// "null" when an edit's value can't be written. With jsKeyOrder, every object's
// keys come in JavaScript's order (array indexes first, ascending), as
// JSON.stringify writes an object JSON.parse made and the edits changed.
fun JsonEdits.emit(jsKeyOrder: bool = false): string {
    if (ablaCompileTimeNativeHost()) return this.emitNative(jsKeyOrder)
    if (ablaAtCompileTime()) return jsonStringify(this.toJson(jsKeyOrder))
    return this.emitNative(jsKeyOrder)
}

private fun JsonEdits.emitNative(jsKeyOrder: bool): string {
    if (this.document.tape.size == 0) return "null"
    jsonEditsPrepare(this, jsKeyOrder)
    val size = jsonTapeEncodedSize(this, 0)
    if (size < 0) "null" else jsonTapeEncodeSized(this, size)
}

private fun jsonTapeStringText(document: JsonDocument, index: int): string {
    val tape = document.tape
    if ((tape[index] & jsonTapeFlag) == 0) return document.source.slice(tape[index + 1] + 1,
        tape[index + 2] - 1)
    jsonNodeText(document.source, document.limits, tape, index)
}

private fun jsonTapeEncodedSize(edits: JsonEdits, index: int): int {
    val document = edits.document
    val tape = document.tape
    val kind = tape[index] & 15
    if (kind == 0) return 4
    if (kind == 3) return if ((tape[index] & jsonTapeFlag) != 0) 4 else 5
    if (kind == 2) return tape[index + 2] - tape[index + 1]
    if (kind == 1) return jsonStringEncodedSize(jsonTapeStringText(document, index))
    if (kind == 4) {
        val count = tape[index] >> 8
        var total = if (count > 0) 1 + count else 2
        val end = tape[index + 3]
        var child = index + 4
        while (child < end) {
            val size = jsonTapeEncodedSize(edits, child)
            if (size < 0) return -1
            total = total + size
            child = tape[child + 3]
        }
        return total
    }
    if (jsonEmitListed(edits, index)) {
        val members = jsonEmitMembersOf(edits, index)
        val count = members.keys.size
        var total = if (count > 0) 1 + count * 2 else 2
        var at = 0
        while (at < count) {
            val keySize = jsonStringEncodedSize(members.keys[at])
            val size = if (members.tapeValues[at] >= 0) jsonTapeEncodedSize(edits,
                members.tapeValues[at])
                else jsonEncodedSize(members.jsonValues[at])
            if (keySize < 0 || size < 0) return -1
            total = total + keySize + size
            at = at + 1
        }
        return total
    }
    val count = tape[index] >> 8
    var total = if (count > 0) 1 + count * 2 else 2
    val end = tape[index + 3]
    var member = index + 4
    while (member < end) {
        val keySize = jsonStringEncodedSize(jsonTapeStringText(document, member))
        val size = jsonTapeEncodedSize(edits, member + 4)
        if (keySize < 0 || size < 0) return -1
        total = total + keySize + size
        member = tape[member + 7]
    }
    total
}

// Returns the document with edits serialized into a buffer sized from the expected output length, which the caller must supply correctly.
private trusted fun jsonTapeEncodeSized(edits: JsonEdits, size: int): string {
    val buffer = nativeByteBuffer(size + 1)
    val written = jsonTapeEncodeAt(edits, 0, nativePointerAddress(buffer.address))
    buffer.adoptString(written - nativePointerAddress(buffer.address))
}

// Writes the edited tape node at a valid index into caller-provided storage and returns the address just past the encoded value.
private trusted fun jsonTapeEncodeAt(edits: JsonEdits, index: int, destination: int): int {
    val document = edits.document
    val tape = document.tape
    val kind = tape[index] & 15
    if (kind == 0 || kind == 2 || kind == 3) {
        val begin = tape[index + 1]
        val length = tape[index + 2] - begin
        ablaUnsafeCopyMemory(destination, ablaUnsafeStringAddress(document.source) + begin, length)
        return destination + length
    }
    if (kind == 1) return jsonEncodeStringAt(jsonTapeStringText(document, index), destination)
    var at = destination
    if (kind == 4) {
        ablaUnsafeStoreU8(nativePointerFromAddress(at), 91)
        at = at + 1
        val end = tape[index + 3]
        var child = index + 4
        while (child < end) {
            if (child > index + 4) {
                ablaUnsafeStoreU8(nativePointerFromAddress(at), 44)
                at = at + 1
            }
            at = jsonTapeEncodeAt(edits, child, at)
            child = tape[child + 3]
        }
        ablaUnsafeStoreU8(nativePointerFromAddress(at), 93)
        return at + 1
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(at), 123)
    at = at + 1
    if (jsonEmitListed(edits, index)) {
        val members = jsonEmitMembersOf(edits, index)
        var position = 0
        while (position < members.keys.size) {
            if (position > 0) {
                ablaUnsafeStoreU8(nativePointerFromAddress(at), 44)
                at = at + 1
            }
            at = jsonEncodeStringAt(members.keys[position], at)
            ablaUnsafeStoreU8(nativePointerFromAddress(at), 58)
            at = if (members.tapeValues[position] >= 0) jsonTapeEncodeAt(edits,
                members.tapeValues[position], at + 1)
                else jsonEncodeAt(members.jsonValues[position], at + 1)
            position = position + 1
        }
    } else {
        val end = tape[index + 3]
        var member = index + 4
        while (member < end) {
            if (member > index + 4) {
                ablaUnsafeStoreU8(nativePointerFromAddress(at), 44)
                at = at + 1
            }
            at = jsonEncodeStringAt(jsonTapeStringText(document, member), at)
            ablaUnsafeStoreU8(nativePointerFromAddress(at), 58)
            at = jsonTapeEncodeAt(edits, member + 4, at + 1)
            member = tape[member + 7]
        }
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(at), 125)
    at + 1
}

// The node as jsonParse's tree: equal kind by kind, member by member, to what
// jsonParse built for these bytes under the document's limits (null for a
// missing node).
fun JsonNode.toJson(jsKeyOrder: bool = false): Json {
    val tree = jsonNodeTree(this.document, this.index)
    if (jsKeyOrder) jsonJsKeyOrder(tree) else tree
}

private fun jsonNodeTree(document: JsonDocument, index: int): Json {
    if (index < 0) return jsonNull()
    val tape = document.tape
    val word = tape[index]
    val kind = word & 15
    if (kind == 0) return jsonNull()
    if (kind == 1) {
        return Json(1, jsonNodeText(document.source, document.limits, tape, index), 0, false,
            jsonNoKeys, jsonNoValues, jsonNoNumber)
    }
    if (kind == 2) {
        val number = jsonTapeNumber(document, index)
        return Json(2, "", number.intValue, false, jsonNoKeys, jsonNoValues, number)
    }
    if (kind == 3) return jsonBoolean((word & jsonTapeFlag) != 0)
    val end = tape[index + 3]
    if (kind == 4) {
        val values: array<Json> = []
        var child = index + 4
        while (child < end) {
            values.append(jsonNodeTree(document, child))
            child = tape[child + 3]
        }
        return Json(4, "", 0, false, jsonNoKeys, values, jsonNoNumber)
    }
    val keys: array<string> = []
    val values: array<Json> = []
    val merge = (word & jsonTapeFlag) != 0
    var keyIndex: JsonKeyTable? = null
    var member = index + 4
    while (member < end) {
        val key = jsonNodeText(document.source, document.limits, tape, member)
        val value = jsonNodeTree(document, member + 4)
        var earlier = -1
        if (merge) {
            if (keyIndex == null && keys.size >= jsonKeyIndexMembers) keyIndex = jsonKeyTable()
            earlier = jsonKeyPosition(keys, keyIndex, key)
        }
        if (earlier >= 0) values[earlier] = value
        else {
            keys.append(key)
            values.append(value)
        }
        member = tape[member + 7]
    }
    jsonIndexedObject(keys, values)
}

private fun jsonReaderConsume(var state: JsonParserState, expected: int): bool {
    val offset = jsonWhitespaceAfter(state.source, state.offset)
    val matches = state.errorCode.size == 0 &&
        offset < state.source.size && state.source[offset] == expected
    state.offset = offset + (if (matches) 1 else 0)
    if (!matches) state.fail(
        "unexpected_token", "unexpected token while reading JSON", offset
    )
    matches
}

// Advances over one JSON number and records an error when the token fails number grammar.
fun jsonScanNumber(var state: JsonParserState): void {
    val begin = state.offset
    var scanning = true
    while (scanning && state.offset < state.source.size) {
        val byte = state.source[state.offset]
        scanning = (byte >= 48 && byte <= 57) || byte == 45 ||
            byte == 43 || byte == 46 || byte == 101 || byte == 69
        if (scanning) state.offset = state.offset + 1
    }
    if (!jsonNumberGrammar(
        state.source.slice(begin, state.offset)
    ).valid) state.fail("invalid_number", "invalid JSON number", begin)
}

private fun jsonScanLiteral(var state: JsonParserState, literal: string): void {
    if (state.offset + literal.size <= state.source.size &&
        state.source.slice(state.offset, state.offset + literal.size) ==
            literal) {
        state.offset = state.offset + literal.size
    } else state.fail(
        "unexpected_token", "unexpected token in JSON input", state.offset
    )
}

// Validate and consume exactly one value without constructing a `Json` tree.
// Strings are decoded only while validating escapes and duplicate object keys;
// the caller may retain the original byte slice through `readRaw` below.
private fun jsonScanValue(var state: JsonParserState, depth: int): void {
    state.offset = jsonScanAt(state, state.offset, depth)
    return
}

// The string at `offset` (after any whitespace), consumed: the offset after it. A
// plain one (no escape, valid UTF-8, within the limit) is only searched for its
// closing quote, not copied; any other goes through jsonParseString's own fallback,
// which decodes it and reports exactly what jsonParseString does.
private fun jsonScanString(var state: JsonParserState, offset: int): int {
    val source = state.source
    var at = offset
    if (at < source.size && source[at] != 34) at = jsonWhitespaceAfter(source, at)
    val quoteOffset = at
    if (at < source.size && source[at] == 34) at = at + 1
    else state.fail("unexpected_token", "expected JSON string", at)
    if (state.errorCode.size != 0) return at
    val plainEnd = jsonPlainStringEnd(source, at, source.size)
    if (plainEnd >= at && plainEnd - at <= state.limits.maximumStringBytes) {
        return plainEnd + 1
    }
    jsonParseStringFallback(state, quoteOffset, at)
    state.offset
}

// jsonScanValue's walk with its cursor in a local: the offset after the value at
// `offset`. It checks, in the same order and at the same offsets, what the walk
// over `state.offset` with decoded strings and number slices did, and allocates
// nothing for plain strings, numbers and literals; an object's keys are kept only
// while duplicates are rejected (its member count is enough for the limit).
private fun jsonScanAt(var state: JsonParserState, start: int, depth: int): int {
    val source = state.source
    val size = source.size
    var offset = jsonWhitespaceAfter(source, start)
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail(
            "depth_limit", "JSON nesting exceeds configured limit", offset
        )
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) state.fail(
            "node_limit", "JSON node count exceeds configured limit", offset
        )
    }
    if (state.errorCode.size == 0 && offset >= size) {
        state.fail("unexpected_end", "expected JSON value", offset)
    }
    if (state.errorCode.size != 0) return offset
    val byte = source[offset]
    if (byte == 34) return jsonScanString(state, offset)
    if (byte == 91) {
        offset = jsonWhitespaceAfter(source, offset + 1)
        var closed = false
        if (offset < size && source[offset] == 93) {
            offset = offset + 1
            closed = true
        }
        while (state.errorCode.size == 0 && !closed) {
            offset = jsonWhitespaceAfter(source, jsonScanAt(state, offset, depth + 1))
            if (offset < size && source[offset] == 93) {
                offset = offset + 1
                closed = true
            } else {
                offset = jsonScanConsume(state, offset, 44)
                offset = jsonWhitespaceAfter(source, offset)
                if (offset < size && source[offset] == 93) state.fail(
                    "unexpected_token", "trailing comma in JSON array", offset
                )
            }
        }
        return offset
    }
    if (byte == 123) {
        val keep = state.limits.rejectDuplicateKeys
        val keys: array<string> = []
        var keyIndex: JsonKeyTable? = null
        var members = 0
        offset = jsonWhitespaceAfter(source, offset + 1)
        var closed = false
        if (offset < size && source[offset] == 125) {
            offset = offset + 1
            closed = true
        }
        while (state.errorCode.size == 0 && !closed) {
            if (members >= state.limits.maximumObjectMembers) state.fail(
                "node_limit", "JSON object member limit exceeded", offset
            )
            if (keep) {
                state.offset = offset
                val key = jsonParseString(state)
                offset = state.offset
                if (keyIndex == null && keys.size >= jsonKeyIndexMembers) {
                    keyIndex = jsonKeyTable()
                }
                if (jsonKeyRepeats(keys, keyIndex, key)) state.fail(
                    "duplicate_key", "duplicate JSON object key", offset
                )
                if (state.errorCode.size == 0) keys.append(key)
            } else offset = jsonScanString(state, offset)
            if (state.errorCode.size == 0) members = members + 1
            offset = jsonScanConsume(state, offset, 58)
            offset = jsonWhitespaceAfter(source, jsonScanAt(state, offset, depth + 1))
            if (offset < size && source[offset] == 125) {
                offset = offset + 1
                closed = true
            } else {
                offset = jsonScanConsume(state, offset, 44)
                offset = jsonWhitespaceAfter(source, offset)
                if (offset < size && source[offset] == 125) state.fail(
                    "unexpected_token", "trailing comma in JSON object", offset
                )
            }
        }
        return offset
    }
    if ((byte >= 48 && byte <= 57) || byte == 45) {
        val begin = offset
        var scanning = true
        while (scanning && offset < size) {
            val next = source[offset]
            scanning = (next >= 48 && next <= 57) || next == 45 ||
                next == 43 || next == 46 || next == 101 || next == 69
            if (scanning) offset = offset + 1
        }
        if (jsonNumberKindRange(source, begin, offset) < 0) {
            state.fail("invalid_number", "invalid JSON number", begin)
        }
        return offset
    }
    val literal = if (byte == 116) 1 else if (byte == 102) 2 else if (byte == 110) 3 else 0
    if (literal > 0 && jsonLiteralAt(source, offset, literal)) {
        return offset + (if (literal == 2) 5 else 4)
    }
    state.fail("unexpected_token", "unexpected token in JSON input", offset)
    offset
}

// Whether `true` (1), `false` (2) or `null` (3) is at `offset`.
private fun jsonLiteralAt(source: string, offset: int, literal: int): bool {
    if (literal == 2) {
        offset + 5 <= source.size && source[offset] == 102 &&
            source[offset + 1] == 97 && source[offset + 2] == 108 &&
            source[offset + 3] == 115 && source[offset + 4] == 101
    } else if (literal == 1) {
        offset + 4 <= source.size && source[offset] == 116 &&
            source[offset + 1] == 114 && source[offset + 2] == 117 &&
            source[offset + 3] == 101
    } else {
        offset + 4 <= source.size && source[offset] == 110 &&
            source[offset + 1] == 117 && source[offset + 2] == 108 &&
            source[offset + 3] == 108
    }
}

// jsonReaderConsume on a local cursor: the offset after `expected` (after any
// whitespace), or where it was missing, reported as there.
private fun jsonScanConsume(var state: JsonParserState, offset: int, expected: int): int {
    val at = jsonWhitespaceAfter(state.source, offset)
    val matches = state.errorCode.size == 0 &&
        at < state.source.size && state.source[at] == expected
    if (!matches) state.fail(
        "unexpected_token", "unexpected token while reading JSON", at
    )
    at + (if (matches) 1 else 0)
}

// The end of the JSON number (RFC 8259: -?(0|[1-9][0-9]*)(.[0-9]+)?
// ([eE][+-]?[0-9]+)?) starting at `begin`, or -1. A number running on into
// more number bytes ("1-2", "01", "1.5.") is -1 too, as jsonScanNumber
// reports it.
private fun jsonNumberEnd(source: string, begin: int): int {
    var offset = begin
    val size = source.size
    if (offset < size && source[offset] == 45) offset = offset + 1
    if (offset >= size) return -1
    val lead = source[offset]
    if (lead == 48) offset = offset + 1
    else if (lead >= 49 && lead <= 57) {
        while (offset < size && source[offset] >= 48 && source[offset] <= 57) {
            offset = offset + 1
        }
    } else return -1
    if (offset < size && source[offset] == 46) {
        offset = offset + 1
        val fraction = offset
        while (offset < size && source[offset] >= 48 && source[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == fraction) return -1
    }
    if (offset < size && (source[offset] == 101 || source[offset] == 69)) {
        offset = offset + 1
        if (offset < size && (source[offset] == 43 || source[offset] == 45)) {
            offset = offset + 1
        }
        val digits = offset
        while (offset < size && source[offset] >= 48 && source[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == digits) return -1
    }
    if (offset < size) {
        val byte = source[offset]
        if ((byte >= 48 && byte <= 57) || byte == 45 || byte == 43 ||
            byte == 46 || byte == 101 || byte == 69) return -1
    }
    offset
}

// Any JSON number as the nearest f64, read in place (f64ParseRange: no
// allocation up to 18 significant digits).
private fun jsonReadNumber(var state: JsonParserState): f64 {
    val begin = jsonWhitespaceAfter(state.source, state.offset)
    val end = if (state.errorCode.size == 0) jsonNumberEnd(state.source, begin)
        else -1
    if (end > begin) {
        state.offset = end
        return f64ParseRange(state.source, begin, end)
    }
    if (state.errorCode.size == 0) state.fail(
        "invalid_number", "expected JSON number", begin
    )
    0.0
}

// The kind of the value at the cursor (Json.kind's codes: 0 null, 1 string,
// 2 number, 3 boolean, 4 array, 5 object), or -1 when there is none.
private fun jsonPeekKind(state: JsonParserState): int {
    if (state.errorCode.size != 0) return -1
    val offset = jsonWhitespaceAfter(state.source, state.offset)
    if (offset >= state.source.size) return -1
    val byte = state.source[offset]
    if (byte == 34) 1
    else if ((byte >= 48 && byte <= 57) || byte == 45) 2
    else if (byte == 123) 5
    else if (byte == 91) 4
    else if (byte == 116 || byte == 102) 3
    else if (byte == 110) 0
    else -1
}

// Consumes a `null` at the cursor; leaves the cursor where it was otherwise.
private fun jsonReadNull(var state: JsonParserState): bool {
    if (state.errorCode.size != 0) return false
    val offset = jsonWhitespaceAfter(state.source, state.offset)
    val source = state.source
    val matches = offset + 4 <= source.size && source[offset] == 110 &&
        source[offset + 1] == 117 && source[offset + 2] == 108 &&
        source[offset + 3] == 108
    if (matches) state.offset = offset + 4
    matches
}

// Starts a forward reader for a JSON object at the start of `source` with `limits`. Invalid limits, input size, or a missing opening brace put the reader into an error state. Use finish to check successful consumption.
fun jsonObjectReader(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonObjectReader {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits) || source.size > limits.maximumBytes) {
        state.fail("input_limit", "invalid JSON input limits", 0)
    }
    // The forward reader validates every consumed string in place. Bytes
    // outside strings must match ASCII JSON tokens, so a redundant whole-input
    // UTF-8 pass would only scan known-schema protocol payloads twice.
    jsonReaderConsume(state, 123)
    JsonObjectReader(state, [], true, false, false)
}

// Advance to the next member and return its decoded key. An empty result is
// unambiguous when `done` is inspected; empty JSON object keys remain valid.
fun JsonObjectReader.next(): string {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    if (this.state.errorCode.size == 0 && !this.done &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 125) {
        this.state.offset = this.state.offset + 1
        this.done = true
    }
    var key = ""
    if (this.state.errorCode.size == 0 && !this.done) {
        if (!this.first) jsonReaderConsume(this.state, 44)
        jsonSkipWhitespace(this.state)
        if (this.state.offset < this.state.source.size &&
            this.state.source[this.state.offset] == 125) {
            this.state.fail(
                "unexpected_token", "trailing comma in JSON object",
                this.state.offset
            )
        }
        if (this.state.errorCode.size == 0) key = jsonParseString(this.state)
        var duplicate = false
        if (this.state.limits.rejectDuplicateKeys) {
            if (this.keyIndex == null && this.keys.size >= jsonKeyIndexMembers) {
                this.keyIndex = jsonKeyTable()
            }
            duplicate = jsonKeyRepeats(this.keys, this.keyIndex, key)
        }
        if (duplicate) this.state.fail(
            "duplicate_key", "duplicate JSON object key", this.state.offset
        )
        if (this.keys.size >= this.state.limits.maximumObjectMembers) {
            this.state.fail(
                "node_limit", "JSON object member limit exceeded",
                this.state.offset
            )
        }
        if (this.state.errorCode.size == 0) {
            this.keys.append(key)
            jsonReaderConsume(this.state, 58)
            this.expectingValue = true
            this.first = false
        }
    }
    key
}

// Order-sensitive lookup is the fast path for canonical protocols. It still
// parses and unescapes the actual key, but never rewinds or scans for another
// member when the schema order is known.
fun JsonObjectReader.nextExpected(name: string): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    if (!this.first) jsonReaderConsume(this.state, 44)
    jsonSkipWhitespace(this.state)
    var key = ""
    if (this.state.errorCode.size == 0 &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] != 125) {
        key = jsonParseString(this.state)
    } else if (this.state.errorCode.size == 0) this.state.fail(
        "unexpected_end", "expected JSON object field", this.state.offset
    )
    val matches = this.state.errorCode.size == 0 && key == name
    if (!matches && this.state.errorCode.size == 0) this.state.fail(
        "unexpected_token", "unexpected JSON object field", this.state.offset
    )
    if (matches) {
        jsonReaderConsume(this.state, 58)
        this.expectingValue = true
        this.first = false
    }
    matches
}

// Fastest canonical-schema lookup: compare an unescaped key directly in the
// source buffer. Producers using this contract emit ordinary UTF-8 field
// names; escaped spellings of the same key are deliberately rejected.
@inline
fun JsonObjectReader.nextExpectedRaw(name: string): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    val originalOffset = this.state.offset
    val compactEnd = if (this.state.errorCode.size == 0) {
        ablaJsonMatchCompactObjectField(
            this.state.source, originalOffset, name, !this.first
        )
    } else -1
    if (compactEnd >= 0) {
        this.state.offset = compactEnd
        this.expectingValue = true
        this.first = false
        return true
    }
    jsonObjectReaderExpectedRawFallback(this, name, originalOffset)
}

// Keep diagnostics outside the common constant-schema comparison, allowing
// LLVM to specialize short literal field names without duplicating fallback code.
@noinline
fun jsonObjectReaderExpectedRawFallback(
    var reader: JsonObjectReader, name: string, originalOffset: int
): bool {
    var compactEnd = -1
    // Retry the raw matcher after legal separator whitespace, without
    // allocating a key substring. Keep the original cursor for diagnostics.
    if (compactEnd < 0 && reader.state.errorCode.size == 0) {
        var cursor = jsonWhitespaceAfter(reader.state.source, originalOffset)
        var separator = true
        if (!reader.first) {
            separator = cursor < reader.state.source.size && reader.state.source[cursor] == 44
            if (separator) cursor = jsonWhitespaceAfter(reader.state.source, cursor + 1)
        }
        if (separator) compactEnd = ablaJsonMatchCompactObjectField(
            reader.state.source, cursor, name, false
        )
    }
    if (compactEnd >= 0) {
        reader.state.offset = compactEnd
        reader.expectingValue = true
        reader.first = false
        return true
    }
    jsonObjectReaderExpectedRawDiagnostic(reader, name, originalOffset)
}

// Malformed fields and keys with whitespace before the colon retain the
// precise original scanner without growing the whitespace fast-path frame.
@noinline
fun jsonObjectReaderExpectedRawDiagnostic(
    var reader: JsonObjectReader, name: string, originalOffset: int
): bool {
    reader.state.offset = originalOffset
    if (!reader.first) jsonReaderConsume(reader.state, 44)
    jsonSkipWhitespace(reader.state)
    // The fallback preserves whitespace handling and precise diagnostics.
    var matches = reader.state.errorCode.size == 0 &&
        reader.state.offset < reader.state.source.size &&
        reader.state.source[reader.state.offset] == 34
    if (matches) reader.state.offset = reader.state.offset + 1
    val begin = reader.state.offset
    val end = begin + name.size
    matches = matches && end < reader.state.source.size &&
        reader.state.source.slice(begin, end) == name &&
        reader.state.source[end] == 34
    if (matches) reader.state.offset = end + 1
    else if (reader.state.errorCode.size == 0) reader.state.fail(
        "unexpected_token", "unexpected JSON object field",
        reader.state.offset
    )
    if (matches) {
        jsonReaderConsume(reader.state, 58)
        reader.expectingValue = true
        reader.first = false
    }
    matches
}

// Returns the decoded string at the current member and records an error for a missing or invalid value.
fun JsonObjectReader.readString(): string {
    var value = ""
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    if (this.state.errorCode.size == 0) value = jsonParseString(this.state)
    this.expectingValue = false
    value
}

// Malformed or unavailable integers use the full diagnostic scanner. Keep
// its temporary strings and grammar object out of every successful read's
// GC-root frame.
@noinline
fun jsonReadIntegerFallback(var state: JsonParserState, begin: int): int {
    state.offset = begin
    if (state.errorCode.size == 0) jsonScanNumber(state)
    val text = state.source.slice(begin, state.offset)
    val grammar = jsonNumberGrammar(text)
    if (state.errorCode.size == 0 && grammar.integer &&
        jsonIntegerTextAvailable(text)) return jsonIntegerTextValue(text)
    if (state.errorCode.size == 0) state.fail(
        "invalid_number", "expected available JSON integer", begin
    )
    0
}

// Keep the native scans local: a shared helper added overhead even with LLVM
// inlining. Both readers clear expectingValue only after parsing/diagnostics.
trusted fun JsonObjectReader.readInteger(): int {
    var value = 0
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    val begin = jsonWhitespaceAfter(this.state.source, this.state.offset)
    var portablePath = this.state.errorCode.size != 0 || begin < 0
    if (ablaCompileTimeNativeHost()) {} else if (ablaAtCompileTime()) portablePath = true
    if (portablePath) {
        val fastEnd = if (this.state.errorCode.size == 0) {
            ablaJsonAvailableIntegerEnd(this.state.source, begin)
        } else -1
        if (fastEnd >= begin) {
            this.state.offset = fastEnd
            value = ablaJsonIntegerValueAt(this.state.source, begin, fastEnd)
        } else value = jsonReadIntegerFallback(this.state, begin)
    } else {
        var available = true
        while (true) {
            val size: int = this.state.source.size
            if (begin >= size) {
                available = false
                break
            }
            // The state retains the source; no call in this scan allocates.
            val data: int = ablaUnsafeStringAddress(this.state.source)
            var cursor: int = begin
            val negative = ablaUnsafeLoadU8(nativePointerFromAddress(data + cursor)) == 45
            if (negative) cursor = cursor + 1
            if (cursor >= size) {
                available = false
                break
            }
            val digitBegin: int = cursor
            val first: int = ablaUnsafeLoadU8(nativePointerFromAddress(data + cursor))
            var parsed: int = 0
            if (first == 48) {
                cursor = cursor + 1
                if (cursor < size) {
                    val next: int = ablaUnsafeLoadU8(nativePointerFromAddress(data + cursor))
                    if (next >= 48 && next <= 57) {
                        available = false
                        break
                    }
                }
            } else if (first >= 49 && first <= 57) {
                var scanning = true
                while (scanning && cursor < size) {
                    val byte: int = ablaUnsafeLoadU8(nativePointerFromAddress(data + cursor))
                    scanning = byte >= 48 && byte <= 57
                    if (scanning) {
                        parsed = parsed * 10 - (byte - 48)
                        cursor = cursor + 1
                    }
                }
            } else {
                available = false
                break
            }
            if (cursor < size) {
                val suffix: int = ablaUnsafeLoadU8(nativePointerFromAddress(data + cursor))
                if (suffix == 43 || suffix == 45 || suffix == 46 ||
                    suffix == 101 || suffix == 69) {
                    available = false
                    break
                }
            }
            // int arithmetic wraps. At most nineteen digits fit below 2^64, so an
            // overflowing negative accumulation is positive; longer input falls back.
            // Only a negative input may retain the signed minimum itself.
            if (cursor - digitBegin > 19 || parsed > 0 ||
                (!negative && parsed == -9223372036854775808)) {
                available = false
                break
            }
            this.state.offset = cursor
            value = if (negative) parsed else 0 - parsed
            break
        }
        if (!available) value = jsonReadIntegerFallback(this.state, begin)
    }
    this.expectingValue = false
    value
}

