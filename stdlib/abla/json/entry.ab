// Phase-safe JSON values, strict bounded parsing, deterministic serialization,
// and the `$json` parser provider. Kinds: 0 null, 1 string, 2 number,
// 3 boolean, 4 array, 5 object.

import "abla/bytes"
import "abla/compiler/parser"
import "abla/float/text"
import "abla/text"
import "abla/unsafe/memory"

class JsonNumber(
    val text: string,
    val integer: bool,
    val intValue: int,
    val intAvailable: bool
)

class Json(
    val kind: int,
    val stringValue: string,
    val intValue: int,
    val boolValue: bool,
    val keys: array<string>,
    val values: array<Json>,
    val numberValue: JsonNumber
)

class JsonError(
    val code: string,
    val message: string,
    val byteOffset: int,
    val line: int,
    val column: int
)

class JsonParseResult(
    val value: Json,
    val succeeded: bool,
    val error: JsonError
)

class JsonLimits(
    val maximumBytes: int,
    val maximumDepth: int,
    val maximumNodes: int,
    val maximumStringBytes: int,
    val maximumObjectMembers: int,
    val rejectDuplicateKeys: bool
)

class JsonNumberGrammar(
    val valid: bool,
    val integer: bool
)

class JsonParserState(
    val source: string,
    val limits: JsonLimits,
    var offset: int,
    var nodes: int,
    var errorCode: string,
    var errorMessage: string,
    var errorOffset: int
)

class JsonWriter(
    val output: ByteBuffer,
    var valid: bool
)

// Forward-only, allocation-light object reader. Values are consumed once from
// the source text; callers choose whether to decode a scalar or retain a
// validated raw slice. This complements the tree-shaped `Json` API for hot
// protocol paths that already know their schema.
class JsonObjectReader(
    val state: JsonParserState,
    val keys: array<string>,
    var first: bool,
    var done: bool,
    var expectingValue: bool,
    // The keys as a set, once an object rejecting duplicates grows long.
    var keyIndex: JsonKeyTable? = null
)

// Forward-only array companion for schema-aware nested JSON. Object and array
// readers may share one parser state, so nested values are validated exactly
// once without materializing a Json tree or retaining raw substrings.
class JsonArrayReader(
    val state: JsonParserState,
    var first: bool,
    var done: bool,
    var expectingValue: bool
)

// Validated encoded fragments and streaming container builders avoid a
// temporary `Json` object graph during serialization.
class JsonEncoded(val text: string, val valid: bool)

class JsonArrayEncoder(
    val output: ByteBuffer,
    var count: int,
    var valid: bool,
    var finished: bool
)

class JsonObjectEncoder(
    val output: ByteBuffer,
    var count: int,
    var valid: bool,
    var finished: bool
)

// Returns the closing quote for an unescaped, valid UTF-8 JSON string, or -1
// when the input needs the precise escaped-string decoder. This fuses the
// common path's delimiter search and validation into one raw-memory pass.
noescape extern:"intrinsic" fun ablaJsonFindPlainStringEnd(
    value: string,
    begin: int,
    end: int
): int

// Return the offset after a compact `,"name":` (or first-field `"name":`)
// token, or -1 when the source needs the whitespace-aware raw fallback.
// One checked raw-memory pass avoids constructing a slice and then comparing
// that slice through the general string ABI.
noescape extern:"intrinsic" fun ablaJsonMatchCompactObjectField(
    value: string,
    offset: int,
    name: string,
    comma: bool
): int

// Encodes a compact array transition without allocating or repeatedly crossing
// the checked string-index ABI. Zero selects the complete diagnostic path.
noescape extern:"intrinsic" fun ablaJsonCompactArrayNext(
    value: string,
    offset: int,
    first: bool
): int

// Compact signed-64-bit integer decoding uses raw source bytes and returns -1
// for fractions, exponents, malformed grammar, or overflow. Callers retain the
// full scanner as an exact diagnostic fallback for those inputs.
noescape extern:"intrinsic" fun ablaJsonAvailableIntegerEnd(
    value: string,
    begin: int
): int

noescape extern:"intrinsic" fun ablaJsonIntegerValueAt(
    value: string,
    begin: int,
    end: int
): int

noescape extern:"intrinsic" fun ablaJsonWhitespaceEnd(
    value: string,
    begin: int
): int

// Single-buffer streaming serializer. Container state is held in bitsets, so
// nesting does not allocate a DOM node, fragment, or context object.
class JsonEncoder(
    val output: ByteBuffer,
    var depth: int,
    var objectBits: int,
    var nonEmptyBits: int,
    var expectingValueBits: int,
    var rootWritten: bool,
    var valid: bool
)

// These limits contain only immutable scalar fields and can be shared.
@threadShared
val jsonStandardLimits = JsonLimits(
    1048576,
    64,
    100000,
    1048576,
    10000,
    true
)

fun jsonDefaultLimits(): JsonLimits = jsonStandardLimits

// Each call's limits are its own: a caller parsing a large trusted document
// (a map, an admin export) raises bytes, nodes and members as far as it
// needs. Only the depth stays bounded, since parsing recurses per level.
private fun jsonLimitsValid(limits: JsonLimits): bool =
    limits.maximumBytes > 0 &&
    limits.maximumDepth > 0 && limits.maximumDepth <= 256 &&
    limits.maximumNodes > 0 &&
    limits.maximumStringBytes > 0 &&
    limits.maximumObjectMembers > 0

private fun jsonEmptyNumber(): JsonNumber = JsonNumber("", false, 0, false)

// Scalars share these: a Json never changes after it is built, so a string,
// number, boolean or null need not carry arrays and a number record of its own
// (a parse of numeric data would otherwise make several objects per value).
// Nothing changes them, so threads share them too.
@threadShared
val jsonNoKeys: array<string> = []
@threadShared
val jsonNoValues: array<Json> = []
@threadShared
val jsonNoNumber = JsonNumber("", false, 0, false)

fun jsonNull(): Json = Json(0, "", 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)

fun jsonString(value: string): Json {
    if (value.isValidUtf8()) {
        Json(1, value, 0, false, jsonNoKeys, jsonNoValues, jsonNoNumber)
    } else jsonNull()
}

private fun jsonNumberGrammar(text: string): JsonNumberGrammar {
    val kind = jsonNumberKind(text)
    JsonNumberGrammar(kind >= 0, kind == 1)
}

// -1 not a JSON number, 0 a valid non-integer, 1 a valid integer.
private fun jsonNumberKind(text: string): int {
    var offset = 0
    var valid = text.size > 0
    var integer = true
    if (valid && text[offset] == 45) {
        offset = offset + 1
        if (offset >= text.size) valid = false
    }
    if (valid && text[offset] == 48) {
        offset = offset + 1
        if (offset < text.size && text[offset] >= 48 && text[offset] <= 57) {
            valid = false
        }
    } else if (valid && text[offset] >= 49 && text[offset] <= 57) {
        while (offset < text.size && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
    } else valid = false
    if (valid && offset < text.size && text[offset] == 46) {
        integer = false
        offset = offset + 1
        val fractionBegin = offset
        while (offset < text.size && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == fractionBegin) valid = false
    }
    if (valid && offset < text.size &&
        (text[offset] == 101 || text[offset] == 69)) {
        integer = false
        offset = offset + 1
        if (offset < text.size &&
            (text[offset] == 43 || text[offset] == 45)) {
            offset = offset + 1
        }
        val exponentBegin = offset
        while (offset < text.size && text[offset] >= 48 &&
               text[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == exponentBegin) valid = false
    }
    if (offset != text.size) valid = false
    if (!valid) -1 else if (integer) 1 else 0
}

private fun jsonIntegerTextAvailable(text: string): bool {
    var negative = false
    var begin = 0
    if (text.size > 0 && text[0] == 45) {
        negative = true
        begin = 1
    }
    val digits = text.size - begin
    var available = digits > 0 && digits <= 19
    if (available && digits == 19) {
        val limit = if (negative) "9223372036854775808"
            else "9223372036854775807"
        var index = 0
        var decided = false
        while (index < 19 && !decided) {
            val actual = text[begin + index]
            val maximum = limit[index]
            if (actual < maximum) decided = true
            if (actual > maximum) {
                available = false
                decided = true
            }
            index = index + 1
        }
    }
    available
}

private fun jsonIntegerTextValue(text: string): int {
    val negative = text.size > 0 && text[0] == 45
    var offset = if (negative) 1 else 0
    var value = 0
    while (offset < text.size) {
        value = value * 10 - (text[offset] - 48)
        offset = offset + 1
    }
    if (negative) value else -value
}

private fun jsonNumberInfo(text: string): JsonNumber {
    val grammar = jsonNumberGrammar(text)
    val available = grammar.valid && grammar.integer &&
        jsonIntegerTextAvailable(text)
    JsonNumber(
        text,
        grammar.integer,
        if (available) jsonIntegerTextValue(text) else 0,
        available
    )
}

fun jsonNumber(value: JsonNumber): Json = jsonNumberText(value.text)

fun jsonNumberText(value: string): Json {
    val kind = jsonNumberKind(value)
    if (kind < 0) return jsonNull()
    val available = kind == 1 && jsonIntegerTextAvailable(value)
    val intValue = if (available) jsonIntegerTextValue(value) else 0
    Json(2, "", intValue, false, jsonNoKeys, jsonNoValues, JsonNumber(value, kind == 1, intValue, available))
}

// Integer formatting already produces valid JSON number text; retain the known value.
fun jsonInteger(value: int): Json =
    Json(2, "", value, false, jsonNoKeys, jsonNoValues, JsonNumber("$value", true, value, true))

fun jsonBoolean(value: bool): Json =
    Json(3, "", 0, value, jsonNoKeys, jsonNoValues, jsonNoNumber)

fun jsonArray(values: array<Json>): Json =
    Json(4, "", 0, false, jsonNoKeys, values, jsonNoNumber)

fun jsonObject(keys: array<string>, values: array<Json>): Json {
    var valid = keys.size == values.size
    var index = 0
    while (valid && index < keys.size) {
        valid = keys[index].isValidUtf8()
        index = index + 1
    }
    if (valid) Json(5, "", 0, false, keys, values, jsonNoNumber)
    else jsonNull()
}

// Compatibility constructors retained for existing `$json` consumers.
fun ablaJsonNull(): Json = jsonNull()
fun ablaJsonString(value: string): Json = jsonString(value)
fun ablaJsonInteger(value: int): Json = jsonInteger(value)
fun ablaJsonNumberText(value: string): Json = jsonNumberText(value)
fun ablaJsonBoolean(value: bool): Json = jsonBoolean(value)
fun ablaJsonArray(values: array<Json>): Json = jsonArray(values)
fun ablaJsonObject(keys: array<string>, values: array<Json>): Json =
    jsonObject(keys, values)

// A `$json` value written as an Abla expression becomes JSON through these:
// the call picks the overload for the expression's type, so a value of any
// other type is a compile error at the value.
fun ablaJsonValue(value: Json): Json = value
fun ablaJsonValue(value: string): Json = jsonString(value)
fun ablaJsonValue(value: int): Json = jsonInteger(value)
fun ablaJsonValue(value: bool): Json = jsonBoolean(value)
fun ablaJsonValue(value: JsonNumber): Json = jsonNumber(value)
// An f64 interpolates as f64Text, the shortest text that reads back as the
// value, with the same bytes at compile time and at run time; JSON has no NaN
// or infinities: null.
fun ablaJsonValue(value: f64): Json =
    if (value != value || value - value != 0.0) jsonNull()
    else jsonNumberText("$value")
fun ablaJsonValue(values: array<Json>): Json = jsonArray(values)
fun ablaJsonValue(values: array<string>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(jsonString(value))
    jsonArray(converted)
}
fun ablaJsonValue(values: array<int>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(jsonInteger(value))
    jsonArray(converted)
}
fun ablaJsonValue(values: array<f64>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(ablaJsonValue(value))
    jsonArray(converted)
}
fun ablaJsonValue(values: array<bool>): Json {
    val converted: array<Json> = []
    for (value in values) converted.append(jsonBoolean(value))
    jsonArray(converted)
}

// A `$json` key written as an expression other than a string literal: only a
// string is accepted.
fun ablaJsonKey(key: string): string = key

fun Json.isNull(): bool = this.kind == 0
fun Json.isString(): bool = this.kind == 1
fun Json.isNumber(): bool = this.kind == 2
fun Json.isBoolean(): bool = this.kind == 3
fun Json.isArray(): bool = this.kind == 4
fun Json.isObject(): bool = this.kind == 5
fun Json.asString(): string = if (this.kind == 1) this.stringValue else ""
fun Json.asBoolean(): bool = this.kind == 3 && this.boolValue
fun Json.asNumber(): JsonNumber =
    if (this.kind == 2) this.numberValue else jsonEmptyNumber()
fun Json.asInt(): int =
    if (this.kind == 2 && this.numberValue.intAvailable) this.intValue else 0
fun Json.intAvailable(): bool =
    this.kind == 2 && this.numberValue.intAvailable

fun Json.get(key: string): Json {
    var value = jsonNull()
    var found = false
    var index = if (this.keys.size < this.values.size) {
        this.keys.size
    } else this.values.size
    while (!found && index > 0) {
        index = index - 1
        val candidate = this.keys[index]
        val possible = candidate.size == key.size &&
            (key.size == 0 || candidate[0] == key[0])
        if (possible && candidate == key) {
            value = this.values[index]
            found = true
        }
    }
    value
}

fun Json.has(key: string): bool {
    var found = false
    var index = 0
    while (!found && index < this.keys.size) {
        if (this.keys[index] == key) found = true
        index = index + 1
    }
    found
}

fun Json.size(): int {
    if (this.kind == 4) this.values.size
    else if (this.kind == 5) this.keys.size
    else 0
}

fun Json.at(index: int): Json = this.values[index]

fun Json.getString(key: string): string = this.get(key).asString()

fun Json.getInt(key: string): int = this.get(key).asInt()

fun JsonParserState.fail(
    code: string,
    message: string,
    offset: int
): void {
    if (this.errorCode.size == 0) {
        this.errorCode = code
        this.errorMessage = message
        this.errorOffset = offset
    }
}

fun jsonSkipWhitespace(var state: JsonParserState): void {
    state.offset = ablaJsonWhitespaceEnd(state.source, state.offset)
    return
}

private fun jsonHexValue(byte: int): int {
    var value = -1
    if (byte >= 48 && byte <= 57) value = byte - 48
    if (byte >= 65 && byte <= 70) value = byte - 65 + 10
    if (byte >= 97 && byte <= 102) value = byte - 97 + 10
    value
}

private fun jsonHexQuad(source: string, offset: int): int {
    var value = 0
    var valid = offset >= 0 && offset + 4 <= source.size
    val packed = if (valid) textReadU32LittleEndian(source, offset) else 0
    var index = 0
    while (valid && index < 4) {
        val digit = jsonHexValue((packed >> (index * 8)) & 255)
        if (digit < 0) valid = false
        if (digit >= 0) value = value * 16 + digit
        index = index + 1
    }
    if (valid) value else -1
}

@noinline
fun jsonParseEscapedPortable(
    var state: JsonParserState,
    quoteOffset: int,
    contentBegin: int
): string {
    val output = byteBuffer()
    if (state.offset > contentBegin) output.appendText(
        state.source.slice(contentBegin, state.offset)
    )
    var closed = false
    while (state.errorCode.size == 0 && !closed &&
           state.offset < state.source.size) {
        val byte = state.source[state.offset]
        if (byte == 34) {
            closed = true
            state.offset = state.offset + 1
        } else if (byte == 92) {
            val escapeOffset = state.offset
            state.offset = state.offset + 1
            if (state.offset >= state.source.size) {
                state.fail(
                    "unexpected_end", "unterminated JSON escape", state.offset
                )
            } else {
                val escaped = state.source[state.offset]
                state.offset = state.offset + 1
                if (escaped == 34) output.appendText("\"")
                else if (escaped == 92) output.appendText("\\")
                else if (escaped == 47) output.appendText("/")
                else if (escaped == 98) output.appendText(utf8Encode(8))
                else if (escaped == 102) output.appendText(utf8Encode(12))
                else if (escaped == 110) output.appendText("\n")
                else if (escaped == 114) output.appendText("\r")
                else if (escaped == 116) output.appendText("\t")
                else if (escaped == 117) {
                    val unicodeOffset = state.offset
                    var scalar = jsonHexQuad(state.source, state.offset)
                    if (scalar < 0) {
                        state.fail(
                            "invalid_unicode",
                            "invalid JSON Unicode escape",
                            unicodeOffset
                        )
                    } else {
                        state.offset = state.offset + 4
                        if (scalar >= 55296 && scalar <= 56319) {
                            if (state.offset + 6 <= state.source.size &&
                                state.source[state.offset] == 92 &&
                                state.source[state.offset + 1] == 117) {
                                val low = jsonHexQuad(
                                    state.source, state.offset + 2
                                )
                                if (low >= 56320 && low <= 57343) {
                                    scalar = 65536 + (scalar - 55296) * 1024 +
                                        low - 56320
                                    state.offset = state.offset + 6
                                } else state.fail(
                                    "invalid_unicode",
                                    "invalid JSON surrogate pair",
                                    state.offset
                                )
                            } else state.fail(
                                "invalid_unicode",
                                "missing JSON low surrogate",
                                state.offset
                            )
                        } else if (scalar >= 56320 && scalar <= 57343) {
                            state.fail(
                                "invalid_unicode",
                                "unexpected JSON low surrogate",
                                unicodeOffset
                            )
                        }
                        if (state.errorCode.size == 0) {
                            output.appendText(utf8Encode(scalar))
                        }
                    }
                } else state.fail(
                    "invalid_escape", "invalid JSON string escape", escapeOffset
                )
            }
        } else if (byte < 32) {
            state.fail(
                "unexpected_token",
                "unescaped control byte in JSON string",
                state.offset
            )
        } else if (byte < 128) {
            output.appendText(state.source.slice(state.offset, state.offset + 1))
            state.offset = state.offset + 1
        } else {
            val length = utf8SequenceLength(byte)
            if (!utf8SequenceValid(state.source, state.offset, length)) {
                state.fail(
                    "invalid_unicode", "invalid UTF-8 in JSON string", state.offset
                )
            } else {
                output.appendText(state.source.slice(
                    state.offset, state.offset + length
                ))
                state.offset = state.offset + length
            }
        }
        if (state.errorCode.size == 0 &&
            output.size() > state.limits.maximumStringBytes) {
            state.fail(
                "string_limit", "JSON string exceeds configured limit", quoteOffset
            )
        }
    }
    if (state.errorCode.size == 0 && !closed) {
        state.fail(
            "unexpected_end", "unterminated JSON string", state.source.size
        )
    }
    output.toText()
}


// Decode a valid escaped string into one bounded allocation. On any unusual
// or invalid input leave the parser untouched and use the precise portable
// diagnostic path. Decoding never produces more bytes than the source span.
trusted fun jsonParseEscapedNative(var state: JsonParserState, begin: int): string {
    val source = state.source
    val maximum = state.limits.maximumStringBytes
    if (begin < 0 || begin > source.size || maximum <= 0) return ""
    val sourceAddress = ablaUnsafeStringAddress(source)
    var scanLimit = source.size
    if (maximum < (source.size - begin) / 6) scanLimit = begin + maximum * 6 + 1
    var end = begin
    var closed = false
    while (!closed && end < scanLimit) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + end))
        if (byte == 34) closed = true
        else end = end + (if (byte == 92) 2 else 1)
    }
    if (!closed) return ""
    val capacity = if (end - begin < maximum) end - begin else maximum
    val buffer = nativeByteBuffer(capacity + 1)
    val destination = nativePointerAddress(buffer.address)
    var offset = begin
    var written = 0
    var valid = true
    while (valid && offset < end) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset))
        offset = offset + 1
        if (byte == 92) {
            if (offset >= end) valid = false
            else {
                val escaped = ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset))
                offset = offset + 1
                if (escaped == 117) {
                    var scalar = if (offset + 4 <= end) jsonHexQuad(source, offset) else -1
                    offset = offset + 4
                    if (scalar >= 55296 && scalar <= 56319) {
                        if (offset + 6 <= end &&
                            ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset)) == 92 &&
                            ablaUnsafeLoadU8(nativePointerFromAddress(sourceAddress + offset + 1)) == 117) {
                            val low = jsonHexQuad(source, offset + 2)
                            if (low >= 56320 && low <= 57343) {
                                scalar = 65536 + (scalar - 55296) * 1024 + low - 56320
                                offset = offset + 6
                            } else valid = false
                        } else valid = false
                    } else if (scalar < 0 || (scalar >= 56320 && scalar <= 57343)) valid = false
                    if (valid) {
                        val length = if (scalar < 128) 1 else if (scalar < 2048) 2
                            else if (scalar < 65536) 3 else 4
                        if (written + length > capacity) valid = false
                        if (valid) {
                            val lead = if (length == 1) scalar
                                else if (length == 2) 192 | (scalar >> 6)
                                else if (length == 3) 224 | (scalar >> 12)
                                else 240 | (scalar >> 18)
                            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), lead)
                            var index = 1
                            while (index < length) {
                                ablaUnsafeStoreU8(nativePointerFromAddress(destination + written + index),
                                    128 | ((scalar >> ((length - index - 1) * 6)) & 63))
                                index = index + 1
                            }
                            written = written + length
                        }
                    }
                } else {
                    val decoded = if (escaped == 34 || escaped == 92 || escaped == 47) escaped
                        else if (escaped == 98) 8 else if (escaped == 102) 12
                        else if (escaped == 110) 10 else if (escaped == 114) 13
                        else if (escaped == 116) 9 else -1
                    if (decoded < 0 || written >= capacity) valid = false
                    else {
                        ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), decoded)
                        written = written + 1
                    }
                }
            }
        } else if (byte < 32 || written >= capacity) valid = false
        else {
            ablaUnsafeStoreU8(nativePointerFromAddress(destination + written), byte)
            written = written + 1
        }
    }
    if (valid) {
        val text = buffer.adoptString(written)
        if (text.isValidUtf8()) {
            state.offset = end + 1
            return text
        }
    } else buffer.close()
    ""
}

@noinline
fun jsonParseStringFallback(
    var state: JsonParserState,
    quoteOffset: int,
    contentBegin: int
): string {
    state.offset = contentBegin
    // The bounded decoder takes every valid string. Anything it refuses
    // (invalid input, a string over the limit) leaves the cursor unchanged
    // and goes to the portable decoder for its precise diagnostics.
    if (ablaAtCompileTime()) {} else {
        if (state.errorCode.size == 0) {
            val decoded = jsonParseEscapedNative(state, contentBegin)
            if (state.offset != contentBegin) return decoded
        }
    }
    jsonParseEscapedPortable(state, quoteOffset, contentBegin)
}

private fun jsonParseString(var state: JsonParserState): string {
    // Streaming object readers leave the cursor immediately after the colon.
    // Compact strings avoid the whitespace scan, while ordinary JSON permits
    // whitespace before the opening quote.
    if (state.offset < state.source.size && state.source[state.offset] != 34) {
        jsonSkipWhitespace(state)
    }
    val quoteOffset = state.offset
    if (state.offset < state.source.size && state.source[state.offset] == 34) {
        state.offset = state.offset + 1
    } else state.fail("unexpected_token", "expected JSON string", state.offset)
    val contentBegin = state.offset
    // Keep the overwhelmingly common unescaped path in a small function. The
    // precise escape and Unicode diagnostics live out of line so they do not
    // force their large temporary state into every ordinary string read.
    val plainEnd = if (state.errorCode.size == 0) ablaJsonFindPlainStringEnd(
        state.source, contentBegin, state.source.size
    ) else -1
    if (plainEnd >= contentBegin &&
        plainEnd - contentBegin <= state.limits.maximumStringBytes) {
        val result = state.source.slice(contentBegin, plainEnd)
        state.offset = plainEnd + 1
        result
    } else jsonParseStringFallback(state, quoteOffset, contentBegin)
}

private fun jsonParseNumber(var state: JsonParserState): Json {
    val begin = state.offset
    var scanning = true
    while (scanning && state.offset < state.source.size) {
        val byte = state.source[state.offset]
        scanning = (byte >= 48 && byte <= 57) || byte == 45 ||
            byte == 43 || byte == 46 || byte == 101 || byte == 69
        if (scanning) state.offset = state.offset + 1
    }
    val text = state.source.slice(begin, state.offset)
    val parsed = jsonNumberText(text)
    if (parsed.kind != 2) state.fail("invalid_number", "invalid JSON number", begin)
    parsed
}

private fun jsonParseValue(var state: JsonParserState, depth: int): Json {
    jsonSkipWhitespace(state)
    var result = jsonNull()
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail("depth_limit", "JSON nesting exceeds configured limit", state.offset)
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) {
            state.fail("node_limit", "JSON node count exceeds configured limit", state.offset)
        }
    }
    if (state.errorCode.size == 0 && state.offset >= state.source.size) {
        state.fail("unexpected_end", "expected JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        val byte = state.source[state.offset]
        if (byte == 34) result = jsonString(jsonParseString(state))
        else if (byte == 91) {
            state.offset = state.offset + 1
            val values: array<Json> = []
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 93) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                values.append(jsonParseValue(state, depth + 1))
                jsonSkipWhitespace(state)
                if (state.offset >= state.source.size) {
                    state.fail(
                        "unexpected_end", "unterminated JSON array", state.offset
                    )
                } else if (state.source[state.offset] == 93) {
                    state.offset = state.offset + 1
                    closed = true
                } else if (state.source[state.offset] == 44) {
                    state.offset = state.offset + 1
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 93) {
                        state.fail(
                            "unexpected_token",
                            "trailing comma in JSON array",
                            state.offset
                        )
                    }
                } else state.fail(
                    "unexpected_token",
                    "expected comma or closing bracket",
                    state.offset
                )
            }
            result = jsonArray(values)
        } else if (byte == 123) {
            state.offset = state.offset + 1
            val keys: array<string> = []
            var keyIndex: JsonKeyTable? = null
            val values: array<Json> = []
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 125) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                if (state.offset >= state.source.size) {
                    state.fail(
                        "unexpected_end", "unterminated JSON object", state.offset
                    )
                } else if (state.source[state.offset] != 34) {
                    state.fail(
                        "unexpected_token",
                        "JSON object key must be a string",
                        state.offset
                    )
                }
                var key = ""
                if (state.errorCode.size == 0) key = jsonParseString(state)
                if (state.errorCode.size == 0 &&
                    keys.size >= state.limits.maximumObjectMembers) {
                    state.fail(
                        "node_limit",
                        "JSON object member count exceeds configured limit",
                        state.offset
                    )
                }
                var duplicate = false
                if (state.limits.rejectDuplicateKeys) {
                    if (keyIndex == null && keys.size >= jsonKeyIndexMembers) {
                        keyIndex = jsonKeyTable()
                    }
                    duplicate = jsonKeyRepeats(keys, keyIndex, key)
                }
                if (state.errorCode.size == 0 && duplicate) {
                    state.fail(
                        "duplicate_key", "duplicate JSON object key", state.offset
                    )
                }
                jsonSkipWhitespace(state)
                if (state.errorCode.size == 0 &&
                    (state.offset >= state.source.size ||
                     state.source[state.offset] != 58)) {
                    state.fail(
                        "unexpected_token",
                        "expected colon after JSON object key",
                        state.offset
                    )
                }
                if (state.errorCode.size == 0) state.offset = state.offset + 1
                var value = jsonNull()
                if (state.errorCode.size == 0) {
                    value = jsonParseValue(state, depth + 1)
                }
                if (state.errorCode.size == 0) {
                    keys.append(key)
                    values.append(value)
                }
                jsonSkipWhitespace(state)
                if (state.errorCode.size == 0 &&
                    state.offset >= state.source.size) {
                    state.fail(
                        "unexpected_end", "unterminated JSON object", state.offset
                    )
                } else if (state.errorCode.size == 0 &&
                    state.source[state.offset] == 125) {
                    state.offset = state.offset + 1
                    closed = true
                } else if (state.errorCode.size == 0 &&
                    state.source[state.offset] == 44) {
                    state.offset = state.offset + 1
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 125) {
                        state.fail(
                            "unexpected_token",
                            "trailing comma in JSON object",
                            state.offset
                        )
                    }
                } else if (state.errorCode.size == 0) state.fail(
                    "unexpected_token",
                    "expected comma or closing brace",
                    state.offset
                )
            }
            result = jsonObject(keys, values)
        } else if ((byte >= 48 && byte <= 57) || byte == 45 || byte == 43) {
            result = jsonParseNumber(state)
        } else if (state.offset + 4 <= state.source.size &&
            state.source.slice(state.offset, state.offset + 4) == "true") {
            state.offset = state.offset + 4
            result = jsonBoolean(true)
        } else if (state.offset + 5 <= state.source.size &&
            state.source.slice(state.offset, state.offset + 5) == "false") {
            state.offset = state.offset + 5
            result = jsonBoolean(false)
        } else if (state.offset + 4 <= state.source.size &&
            state.source.slice(state.offset, state.offset + 4) == "null") {
            state.offset = state.offset + 4
            result = jsonNull()
        } else state.fail(
            "unexpected_token", "unexpected token in JSON input", state.offset
        )
    }
    result
}

private fun jsonErrorLocation(source: string, offset: int): array<int> {
    var line = 1
    var column = 1
    var index = 0
    while (index < offset && index < source.size) {
        if (source[index] == 10) {
            line = line + 1
            column = 1
        } else column = column + 1
        index = index + 1
    }
    [line, column]
}

// The keys of an object rejecting duplicates, once it grows long: an open
// addressing table of positions + 1 into `names`, probed linearly from each
// name's FNV-1a hash and kept at most half full.
class JsonKeyTable(
    val names: array<string>,
    val hashes: array<int>,
    var slots: array<int>,
    var mask: int
)

private val jsonKeyIndexMembers = 16

private fun jsonKeyHash(key: string): int {
    var hash = -3750763034362895579
    for (byte in key) hash = (hash ^ byte) * 1099511628211
    hash
}

private fun jsonKeyTableSlots(size: int): array<int> {
    val slots: array<int> = []
    var index = 0
    while (index < size) {
        slots.append(0)
        index = index + 1
    }
    slots
}

// Whether `key` is in the table; adds it when it is not.
fun JsonKeyTable.repeatsOrAdd(key: string): bool {
    val hash = jsonKeyHash(key)
    var slot = hash & this.mask
    var entry = this.slots[slot]
    while (entry != 0) {
        if (this.hashes[entry - 1] == hash && this.names[entry - 1] == key) return true
        slot = (slot + 1) & this.mask
        entry = this.slots[slot]
    }
    this.names.append(key)
    this.hashes.append(hash)
    this.slots[slot] = this.names.size
    if (this.names.size * 2 > this.mask) {
        this.mask = this.mask * 2 + 1
        this.slots = jsonKeyTableSlots(this.mask + 1)
        var position = 0
        while (position < this.names.size) {
            var free = this.hashes[position] & this.mask
            while (this.slots[free] != 0) free = (free + 1) & this.mask
            this.slots[free] = position + 1
            position = position + 1
        }
    }
    false
}

// Whether `key` repeats one of `keys`, the members before it. Only asked
// while duplicates are rejected, so `keys` are distinct: a short object scans
// them; a longer one (from jsonKeyIndexMembers) keeps `index`, a table that
// starts with every key so far and takes each new one as it is checked.
private fun jsonKeyRepeats(
    keys: array<string>,
    var index: JsonKeyTable?,
    key: string
): bool {
    if (index == null) {
        var found = false
        var position = 0
        while (!found && position < keys.size) {
            found = keys[position] == key
            position = position + 1
        }
        return found
    }
    if (index.names.size == 0) for (earlier in keys) index.repeatsOrAdd(earlier)
    index.repeatsOrAdd(key)
}

// An empty key table for an object that has reached jsonKeyIndexMembers.
private fun jsonKeyTable(): JsonKeyTable = JsonKeyTable([], [], jsonKeyTableSlots(64), 63)

fun jsonParse(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonParseResult {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits)) {
        state.fail("input_limit", "invalid JSON parser limits", 0)
    }
    if (state.errorCode.size == 0 && source.size > limits.maximumBytes) {
        state.fail(
            "input_limit", "JSON input exceeds configured byte limit",
            limits.maximumBytes
        )
    }
    if (state.errorCode.size == 0) {
        val utf8 = utf8Info(source)
        if (!utf8.valid) {
            state.fail("invalid_unicode", "JSON input is not valid UTF-8", utf8.errorOffset)
        }
    }
    var value = jsonNull()
    if (state.errorCode.size == 0) value = jsonParseValue(state, 1)
    jsonSkipWhitespace(state)
    if (state.errorCode.size == 0 && state.offset != source.size) {
        state.fail("trailing_input", "trailing input after JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        JsonParseResult(value, true, JsonError("", "", 0, 1, 1))
    } else {
        val location = jsonErrorLocation(source, state.errorOffset)
        JsonParseResult(
            jsonNull(),
            false,
            JsonError(
                state.errorCode,
                state.errorMessage,
                state.errorOffset,
                location[0],
                location[1]
            )
        )
    }
}

private fun jsonReaderConsume(var state: JsonParserState, expected: int): bool {
    val offset = ablaJsonWhitespaceEnd(state.source, state.offset)
    val matches = state.errorCode.size == 0 &&
        offset < state.source.size && state.source[offset] == expected
    state.offset = offset + (if (matches) 1 else 0)
    if (!matches) state.fail(
        "unexpected_token", "unexpected token while reading JSON", offset
    )
    matches
}

fun jsonScanNumber(var state: JsonParserState): void {
    val begin = state.offset
    var scanning = true
    while (scanning && state.offset < state.source.size) {
        val byte = state.source[state.offset]
        scanning = (byte >= 48 && byte <= 57) || byte == 45 ||
            byte == 43 || byte == 46 || byte == 101 || byte == 69
        if (scanning) state.offset = state.offset + 1
    }
    if (!jsonNumberGrammar(
        state.source.slice(begin, state.offset)
    ).valid) state.fail("invalid_number", "invalid JSON number", begin)
}

private fun jsonScanLiteral(var state: JsonParserState, literal: string): void {
    if (state.offset + literal.size <= state.source.size &&
        state.source.slice(state.offset, state.offset + literal.size) ==
            literal) {
        state.offset = state.offset + literal.size
    } else state.fail(
        "unexpected_token", "unexpected token in JSON input", state.offset
    )
}

// Validate and consume exactly one value without constructing a `Json` tree.
// Strings are decoded only while validating escapes and duplicate object keys;
// the caller may retain the original byte slice through `readRaw` below.
private fun jsonScanValue(var state: JsonParserState, depth: int): void {
    jsonSkipWhitespace(state)
    if (state.errorCode.size == 0 && depth > state.limits.maximumDepth) {
        state.fail(
            "depth_limit", "JSON nesting exceeds configured limit", state.offset
        )
    }
    if (state.errorCode.size == 0) {
        state.nodes = state.nodes + 1
        if (state.nodes > state.limits.maximumNodes) state.fail(
            "node_limit", "JSON node count exceeds configured limit", state.offset
        )
    }
    if (state.errorCode.size == 0 && state.offset >= state.source.size) {
        state.fail("unexpected_end", "expected JSON value", state.offset)
    }
    if (state.errorCode.size == 0) {
        val byte = state.source[state.offset]
        if (byte == 34) jsonParseString(state)
        else if (byte == 91) {
            state.offset = state.offset + 1
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 93) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                jsonScanValue(state, depth + 1)
                jsonSkipWhitespace(state)
                if (state.offset < state.source.size &&
                    state.source[state.offset] == 93) {
                    state.offset = state.offset + 1
                    closed = true
                } else {
                    jsonReaderConsume(state, 44)
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 93) state.fail(
                            "unexpected_token", "trailing comma in JSON array",
                            state.offset
                        )
                }
            }
        } else if (byte == 123) {
            state.offset = state.offset + 1
            val keys: array<string> = []
            var keyIndex: JsonKeyTable? = null
            jsonSkipWhitespace(state)
            var closed = false
            if (state.offset < state.source.size &&
                state.source[state.offset] == 125) {
                state.offset = state.offset + 1
                closed = true
            }
            while (state.errorCode.size == 0 && !closed) {
                if (keys.size >= state.limits.maximumObjectMembers) state.fail(
                    "node_limit", "JSON object member limit exceeded",
                    state.offset
                )
                val key = jsonParseString(state)
                var duplicate = false
                if (state.limits.rejectDuplicateKeys) {
                    if (keyIndex == null && keys.size >= jsonKeyIndexMembers) {
                        keyIndex = jsonKeyTable()
                    }
                    duplicate = jsonKeyRepeats(keys, keyIndex, key)
                }
                if (duplicate) state.fail(
                    "duplicate_key", "duplicate JSON object key", state.offset
                )
                if (state.errorCode.size == 0) keys.append(key)
                jsonReaderConsume(state, 58)
                jsonScanValue(state, depth + 1)
                jsonSkipWhitespace(state)
                if (state.offset < state.source.size &&
                    state.source[state.offset] == 125) {
                    state.offset = state.offset + 1
                    closed = true
                } else {
                    jsonReaderConsume(state, 44)
                    jsonSkipWhitespace(state)
                    if (state.offset < state.source.size &&
                        state.source[state.offset] == 125) state.fail(
                            "unexpected_token", "trailing comma in JSON object",
                            state.offset
                        )
                }
            }
        } else if ((byte >= 48 && byte <= 57) || byte == 45) {
            jsonScanNumber(state)
        } else if (byte == 116) jsonScanLiteral(state, "true")
        else if (byte == 102) jsonScanLiteral(state, "false")
        else if (byte == 110) jsonScanLiteral(state, "null")
        else state.fail(
            "unexpected_token", "unexpected token in JSON input", state.offset
        )
    }
}

// The end of the JSON number (RFC 8259: -?(0|[1-9][0-9]*)(.[0-9]+)?
// ([eE][+-]?[0-9]+)?) starting at `begin`, or -1. A number running on into
// more number bytes ("1-2", "01", "1.5.") is -1 too, as jsonScanNumber
// reports it.
private fun jsonNumberEnd(source: string, begin: int): int {
    var offset = begin
    val size = source.size
    if (offset < size && source[offset] == 45) offset = offset + 1
    if (offset >= size) return -1
    val lead = source[offset]
    if (lead == 48) offset = offset + 1
    else if (lead >= 49 && lead <= 57) {
        while (offset < size && source[offset] >= 48 && source[offset] <= 57) {
            offset = offset + 1
        }
    } else return -1
    if (offset < size && source[offset] == 46) {
        offset = offset + 1
        val fraction = offset
        while (offset < size && source[offset] >= 48 && source[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == fraction) return -1
    }
    if (offset < size && (source[offset] == 101 || source[offset] == 69)) {
        offset = offset + 1
        if (offset < size && (source[offset] == 43 || source[offset] == 45)) {
            offset = offset + 1
        }
        val digits = offset
        while (offset < size && source[offset] >= 48 && source[offset] <= 57) {
            offset = offset + 1
        }
        if (offset == digits) return -1
    }
    if (offset < size) {
        val byte = source[offset]
        if ((byte >= 48 && byte <= 57) || byte == 45 || byte == 43 ||
            byte == 46 || byte == 101 || byte == 69) return -1
    }
    offset
}

// Any JSON number as the nearest f64, read in place (f64ParseRange: no
// allocation up to 18 significant digits).
private fun jsonReadNumber(var state: JsonParserState): f64 {
    val begin = ablaJsonWhitespaceEnd(state.source, state.offset)
    val end = if (state.errorCode.size == 0) jsonNumberEnd(state.source, begin)
        else -1
    if (end > begin) {
        state.offset = end
        return f64ParseRange(state.source, begin, end)
    }
    if (state.errorCode.size == 0) state.fail(
        "invalid_number", "expected JSON number", begin
    )
    0.0
}

// The kind of the value at the cursor (Json.kind's codes: 0 null, 1 string,
// 2 number, 3 boolean, 4 array, 5 object), or -1 when there is none.
private fun jsonPeekKind(state: JsonParserState): int {
    if (state.errorCode.size != 0) return -1
    val offset = ablaJsonWhitespaceEnd(state.source, state.offset)
    if (offset >= state.source.size) return -1
    val byte = state.source[offset]
    if (byte == 34) 1
    else if ((byte >= 48 && byte <= 57) || byte == 45) 2
    else if (byte == 123) 5
    else if (byte == 91) 4
    else if (byte == 116 || byte == 102) 3
    else if (byte == 110) 0
    else -1
}

// Consumes a `null` at the cursor; leaves the cursor where it was otherwise.
private fun jsonReadNull(var state: JsonParserState): bool {
    if (state.errorCode.size != 0) return false
    val offset = ablaJsonWhitespaceEnd(state.source, state.offset)
    val source = state.source
    val matches = offset + 4 <= source.size && source[offset] == 110 &&
        source[offset + 1] == 117 && source[offset + 2] == 108 &&
        source[offset + 3] == 108
    if (matches) state.offset = offset + 4
    matches
}

fun jsonObjectReader(
    source: string,
    limits: JsonLimits = jsonDefaultLimits()
): JsonObjectReader {
    val state = JsonParserState(source, limits, 0, 0, "", "", 0)
    if (!jsonLimitsValid(limits) || source.size > limits.maximumBytes) {
        state.fail("input_limit", "invalid JSON input limits", 0)
    }
    // The forward reader validates every consumed string in place. Bytes
    // outside strings must match ASCII JSON tokens, so a redundant whole-input
    // UTF-8 pass would only scan known-schema protocol payloads twice.
    jsonReaderConsume(state, 123)
    JsonObjectReader(state, [], true, false, false)
}

// Advance to the next member and return its decoded key. An empty result is
// unambiguous when `done` is inspected; empty JSON object keys remain valid.
fun JsonObjectReader.next(): string {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    if (this.state.errorCode.size == 0 && !this.done &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 125) {
        this.state.offset = this.state.offset + 1
        this.done = true
    }
    var key = ""
    if (this.state.errorCode.size == 0 && !this.done) {
        if (!this.first) jsonReaderConsume(this.state, 44)
        jsonSkipWhitespace(this.state)
        if (this.state.offset < this.state.source.size &&
            this.state.source[this.state.offset] == 125) {
            this.state.fail(
                "unexpected_token", "trailing comma in JSON object",
                this.state.offset
            )
        }
        if (this.state.errorCode.size == 0) key = jsonParseString(this.state)
        var duplicate = false
        if (this.state.limits.rejectDuplicateKeys) {
            if (this.keyIndex == null && this.keys.size >= jsonKeyIndexMembers) {
                this.keyIndex = jsonKeyTable()
            }
            duplicate = jsonKeyRepeats(this.keys, this.keyIndex, key)
        }
        if (duplicate) this.state.fail(
            "duplicate_key", "duplicate JSON object key", this.state.offset
        )
        if (this.keys.size >= this.state.limits.maximumObjectMembers) {
            this.state.fail(
                "node_limit", "JSON object member limit exceeded",
                this.state.offset
            )
        }
        if (this.state.errorCode.size == 0) {
            this.keys.append(key)
            jsonReaderConsume(this.state, 58)
            this.expectingValue = true
            this.first = false
        }
    }
    key
}

// Order-sensitive lookup is the fast path for canonical protocols. It still
// parses and unescapes the actual key, but never rewinds or scans for another
// member when the schema order is known.
fun JsonObjectReader.nextExpected(name: string): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    if (!this.first) jsonReaderConsume(this.state, 44)
    jsonSkipWhitespace(this.state)
    var key = ""
    if (this.state.errorCode.size == 0 &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] != 125) {
        key = jsonParseString(this.state)
    } else if (this.state.errorCode.size == 0) this.state.fail(
        "unexpected_end", "expected JSON object field", this.state.offset
    )
    val matches = this.state.errorCode.size == 0 && key == name
    if (!matches && this.state.errorCode.size == 0) this.state.fail(
        "unexpected_token", "unexpected JSON object field", this.state.offset
    )
    if (matches) {
        jsonReaderConsume(this.state, 58)
        this.expectingValue = true
        this.first = false
    }
    matches
}

// Fastest canonical-schema lookup: compare an unescaped key directly in the
// source buffer. Producers using this contract emit ordinary UTF-8 field
// names; escaped spellings of the same key are deliberately rejected.
@inline
fun JsonObjectReader.nextExpectedRaw(name: string): bool {
    if (this.expectingValue) this.state.fail(
        "unexpected_token", "previous JSON object value was not consumed",
        this.state.offset
    )
    val originalOffset = this.state.offset
    val compactEnd = if (this.state.errorCode.size == 0) {
        ablaJsonMatchCompactObjectField(
            this.state.source, originalOffset, name, !this.first
        )
    } else -1
    if (compactEnd >= 0) {
        this.state.offset = compactEnd
        this.expectingValue = true
        this.first = false
        return true
    }
    jsonObjectReaderExpectedRawFallback(this, name, originalOffset)
}

// Keep diagnostics outside the common constant-schema comparison, allowing
// LLVM to specialize short literal field names without duplicating fallback code.
@noinline
fun jsonObjectReaderExpectedRawFallback(
    var reader: JsonObjectReader, name: string, originalOffset: int
): bool {
    var compactEnd = -1
    // Retry the raw matcher after legal separator whitespace, without
    // allocating a key substring. Keep the original cursor for diagnostics.
    if (compactEnd < 0 && reader.state.errorCode.size == 0) {
        var cursor = ablaJsonWhitespaceEnd(reader.state.source, originalOffset)
        var separator = true
        if (!reader.first) {
            separator = cursor < reader.state.source.size && reader.state.source[cursor] == 44
            if (separator) cursor = ablaJsonWhitespaceEnd(reader.state.source, cursor + 1)
        }
        if (separator) compactEnd = ablaJsonMatchCompactObjectField(
            reader.state.source, cursor, name, false
        )
    }
    if (compactEnd >= 0) {
        reader.state.offset = compactEnd
        reader.expectingValue = true
        reader.first = false
        return true
    }
    jsonObjectReaderExpectedRawDiagnostic(reader, name, originalOffset)
}

// Malformed fields and keys with whitespace before the colon retain the
// precise original scanner without growing the whitespace fast-path frame.
@noinline
fun jsonObjectReaderExpectedRawDiagnostic(
    var reader: JsonObjectReader, name: string, originalOffset: int
): bool {
    reader.state.offset = originalOffset
    if (!reader.first) jsonReaderConsume(reader.state, 44)
    jsonSkipWhitespace(reader.state)
    // The fallback preserves whitespace handling and precise diagnostics.
    var matches = reader.state.errorCode.size == 0 &&
        reader.state.offset < reader.state.source.size &&
        reader.state.source[reader.state.offset] == 34
    if (matches) reader.state.offset = reader.state.offset + 1
    val begin = reader.state.offset
    val end = begin + name.size
    matches = matches && end < reader.state.source.size &&
        reader.state.source.slice(begin, end) == name &&
        reader.state.source[end] == 34
    if (matches) reader.state.offset = end + 1
    else if (reader.state.errorCode.size == 0) reader.state.fail(
        "unexpected_token", "unexpected JSON object field",
        reader.state.offset
    )
    if (matches) {
        jsonReaderConsume(reader.state, 58)
        reader.expectingValue = true
        reader.first = false
    }
    matches
}

fun JsonObjectReader.readString(): string {
    var value = ""
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    if (this.state.errorCode.size == 0) value = jsonParseString(this.state)
    this.expectingValue = false
    value
}

// Malformed or unavailable integers use the full diagnostic scanner. Keep
// its temporary strings and grammar object out of every successful read's
// GC-root frame.
@noinline
fun jsonReadIntegerFallback(var state: JsonParserState, begin: int): int {
    state.offset = begin
    if (state.errorCode.size == 0) jsonScanNumber(state)
    val text = state.source.slice(begin, state.offset)
    val grammar = jsonNumberGrammar(text)
    if (state.errorCode.size == 0 && grammar.integer &&
        jsonIntegerTextAvailable(text)) return jsonIntegerTextValue(text)
    if (state.errorCode.size == 0) state.fail(
        "invalid_number", "expected available JSON integer", begin
    )
    0
}

fun JsonObjectReader.readInteger(): int {
    var value = 0
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    val begin = ablaJsonWhitespaceEnd(this.state.source, this.state.offset)
    val fastEnd = if (this.state.errorCode.size == 0) {
        ablaJsonAvailableIntegerEnd(this.state.source, begin)
    } else -1
    if (fastEnd >= begin) {
        this.state.offset = fastEnd
        value = ablaJsonIntegerValueAt(this.state.source, begin, fastEnd)
    } else value = jsonReadIntegerFallback(this.state, begin)
    this.expectingValue = false
    value
}

fun JsonObjectReader.readBoolean(): bool {
    var value = false
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    jsonSkipWhitespace(this.state)
    if (this.state.errorCode.size == 0 &&
        this.state.offset < this.state.source.size &&
        this.state.source[this.state.offset] == 116) {
        jsonScanLiteral(this.state, "true")
        value = true
    } else if (this.state.errorCode.size == 0) {
        jsonScanLiteral(this.state, "false")
    }
    this.expectingValue = false
    value
}

/** Any JSON number (fraction and exponent included) as the nearest f64. */
fun JsonObjectReader.readNumber(): f64 {
    if (!this.expectingValue) this.state.fail(
        "unexpected_token", "JSON object reader has no current value",
        this.state.offset
    )
    val value = jsonReadNumber(this.state)
    this.expectingValue = false
    value
}

/**
 * The current value's kind without consuming it, as Json.kind numbers kinds
 * (0 null, 1 string, 2 number, 3 boolean, 4 array, 5 object); -1 when there
 * is no current value or the reader has failed.
 */
fun JsonObjectReader.peek(): int =
    if (this.expectingValue) jsonPeekKind(this.state) else -1

/** Consumes a `null` value and returns true; false leaves the value unread. */
