// Optional filesystem adapter for the generic writer in `abla/io`.
// Applications that only print do not import this module and do not retain
// filesystem code.

#import("abla/io")
#import("abla/fs")

fun bufferedFileWriter(
    filePath: Path,
    capacity: int = 65536,
    append: bool = false
): BufferedTextWriter {
    val ready = append || filePath.writeText("")
    bufferedTextWriter(
        capacity,
        { contents: string -> filePath.appendText(contents) },
        !ready
    )
}
