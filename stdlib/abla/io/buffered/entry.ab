// Optional filesystem adapter for the generic writer in `abla/io`.
// Applications that only print do not import this module and do not retain
// filesystem code.

import "abla/io"
import "abla/fs"

// Creates a writer for `filePath` with a flush threshold of `capacity` bytes. Nonpositive capacities use 4096. Unless `append` is true, initialization creates or truncates the file and records any failure. Flushes append bytes and report filesystem errors through the writer.
fun bufferedFileWriter(
    filePath: Path,
    capacity: int = 65536,
    append: bool = false
): BufferedTextWriter {
    val ready = append || filePath.writeText("")
    bufferedTextWriter(
        capacity,
        { contents: string -> filePath.appendText(contents) },
        !ready
    )
}
