import "abla/sys/linux/io"
import "abla/sys/linux"

// Bootstrap host file services remain explicit so compile-time capability
// policy can distinguish them from deterministic phase-safe libraries. The
// public console surface below is target-backed and does not require libc.

// Portable console surface. Platform profiles provide the host declarations
// above; application code uses these functions and never names that adapter.
// Writes `text` to standard output without adding a newline. Write failures are not reported.
fun print(text: string): void = linuxPrintStandardOutput(text)

// Writes `text` and a newline to standard output. The default writes just a newline. Write failures are not reported.
fun println(text: string = ""): void =
    linuxPrintStandardOutput("$text\n")

// Writes `text` to standard error without adding a newline. Write failures are not reported.
fun eprint(text: string): void = linuxPrintStandardError(text)

// Writes `text` and a newline to standard error. The default writes just a newline. Write failures are not reported.
fun eprintln(text: string = ""): void =
    linuxPrintStandardError("$text\n")

// A line read from standard input. `text` holds its bytes and `available` records whether any input was consumed, including an empty line's terminator.
class InputLine(
    val text: string,
    val available: bool
)

// Reads through the next LF on standard input and discards all CR bytes.
// A partial final line is available. EOF and read errors both stop the read.
// With no input consumed, returns an empty string and available = false.
fun readInputLine(): InputLine {
    var text = ""
    var available = false
    var finished = false
    while (!finished) {
        val chunk = LinuxFileDescriptor(0).read(1)
        if (chunk.size == 0) {
            finished = true
            0
        } else if (chunk[0] == 10) {
            available = true
            finished = true
            0
        } else {
            if (chunk[0] != 13) text = "$text$chunk"
            available = true
            0
        }
    }
    InputLine(text, available)
}

// Reads the next standard-input line using readInputLine. Returns an empty
// string for an empty line or when EOF or a read error occurs before any input.
fun readLine(): string = readInputLine().text

// A portable buffered writer is parameterized by a normal Abla callback. It
// therefore works for console, files, sockets, tests, and future target
// adapters without embedding a platform handle in this module.
class BufferedTextWriter(
    val sink: (string) -> bool,
    val capacity: int,
    var chunks: array<string>,
    var bufferedBytes: int,
    var failed: bool
)

// Creates an empty writer that calls `sink` when flushed. `capacity` is the automatic flush threshold in bytes, with 4096 used for nonpositive values. Set `initiallyFailed` to disable writes and flushes. A sink returning false permanently marks the writer failed.
fun bufferedTextWriter(
    capacity: int,
    sink: (string) -> bool,
    initiallyFailed: bool = false
): BufferedTextWriter = BufferedTextWriter(
    sink,
    if (capacity > 0) capacity else 4096,
    [],
    0,
    initiallyFailed
)

// Returns the number of buffered bytes, including bytes retained after a failed flush.
fun BufferedTextWriter.pendingBytes(): int = this.bufferedBytes

// Returns true until the writer starts or becomes failed.
fun BufferedTextWriter.isHealthy(): bool = !this.failed

// Passes all pending bytes to the sink in order. Returns true for an empty healthy buffer or a successful write. A false sink result retains the pending bytes, marks the writer failed, and returns false. A failed writer never calls the sink again.
fun BufferedTextWriter.flush(): bool {
    var success = !this.failed
    if (success && this.bufferedBytes > 0) {
        var output = ""
        var index = 0
        while (index < this.chunks.size) {
            output = "$output${this.chunks[index]}"
            index = index + 1
        }
        val outputSink = this.sink
        success = outputSink(output)
        if (success) {
            this.chunks = []
            this.bufferedBytes = 0
        } else {
            this.failed = true
        }
    }
    success
}

// Buffers `text` and flushes once pending bytes reach the capacity. Returns true if the writer remains healthy, or false if it was already failed or its sink rejected the flush.
fun BufferedTextWriter.write(text: string): bool {
    if (!this.failed && text.size > 0) {
        this.chunks.append(text)
        this.bufferedBytes = this.bufferedBytes + text.size
    }
    if (!this.failed && this.bufferedBytes >= this.capacity) this.flush()
    !this.failed
}

// Buffers `text` followed by a newline, flushing at capacity. Returns false on an existing or newly reported sink failure.
fun BufferedTextWriter.writeLine(text: string = ""): bool =
    this.write("$text\n")

// Creates a writer for standard output with a flush threshold of `capacity` bytes. Nonpositive values use 4096. Write errors are reported by the writer when it flushes.
fun bufferedStandardOutput(capacity: int = 4096): BufferedTextWriter =
    bufferedTextWriter(capacity, linuxWriteStandardOutputAll)

// Creates a writer for standard error with a flush threshold of `capacity` bytes. Nonpositive values use 4096. Write errors are reported by the writer when it flushes.
fun bufferedStandardError(capacity: int = 4096): BufferedTextWriter =
    bufferedTextWriter(capacity, linuxWriteStandardErrorAll)
