// Narrow OpenSSL libcrypto ABI for JWS signature verification. These are
// platform-library declarations. Importing the hosted TLS binding shares its
// OpenSSL_version_num declaration, which is what makes the build driver link
// OpenSSL, without a duplicate symbol when both modules are used. Every
// function below exists in both OpenSSL 1.1.1 and 3.x.

import "../tls/hosted/openssl.ab"

trusted noescape extern:"c" fun d2i_PUBKEY(
    existing: i64*, cursor: i64*, length: int
): i64*
trusted noescape extern:"c" fun EVP_PKEY_free(key: i64*): void

trusted noescape extern:"c" fun EVP_MD_CTX_new(): i64*
trusted noescape extern:"c" fun EVP_MD_CTX_free(context: i64*): void
trusted noescape extern:"c" fun EVP_sha256(): i64*
trusted noescape extern:"c" fun EVP_DigestVerifyInit(
    context: i64*, keyContext: i64*, digest: i64*, engine: i64*, key: i64*
): i32
trusted noescape extern:"c" fun EVP_DigestVerify(
    context: i64*, signature: i64*, signatureLength: int,
    message: i64*, messageLength: int
): i32
trusted noescape extern:"c" fun ERR_clear_error(): void
