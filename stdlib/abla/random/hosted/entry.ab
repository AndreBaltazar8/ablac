// Hosted secure entropy for Linux and macOS. Raw Linux programs should import
// `abla/random`; hosted cross-platform programs can select this adapter.

import "abla/platform/host"
import "abla/random/result"

fun hostedSecureRandomBytes(count: int): SecureRandomResult {
    var result = SecureRandomResult("", false, 22)
    if (count > 0 && count <= 1048576) {
        val bytes = ablaHostSecureRandom(count)
        result = SecureRandomResult(bytes, bytes.size == count,
            if (bytes.size == count) 0 else 5)
    }
    result
}
