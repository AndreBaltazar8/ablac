// Phase-safe core helpers. These functions are available at runtime and under #.

// Returns the magnitude of this integer. The smallest signed integer wraps to itself.
fun int.abs: int = if (this < 0) -this else this

// Returns -1 for a negative integer, 0 for zero, and 1 for a positive integer.
fun int.sign: int = if (this < 0) -1 else if (this > 0) 1 else 0
