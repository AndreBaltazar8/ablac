// Checks for test programs, run by `ablac test <file.ab>...`: expect and
// expectEqual print `FAIL <label>` (with both values) for a check that does
// not hold, and main returns testsPassed(), which prints a summary and is 0
// only when every check held.
//
//     fun main: int {
//         expectEqual(1 + 1, 2, "addition")
//         expect("rocket".startsWith("roc"), "startsWith")
//         testsPassed()
//     }
import "abla/io"
import "abla/float/text"

var __ablaTestChecks = 0
var __ablaTestFailures = 0

fun expect(ok: bool, label: string): bool {
    __ablaTestChecks = __ablaTestChecks + 1
    if (!ok) {
        __ablaTestFailures = __ablaTestFailures + 1
        println("FAIL $label")
    }
    ok
}

fun __ablaTestExpectEqual(
    equal: bool,
    actual: string,
    expected: string,
    label: string
): bool {
    __ablaTestChecks = __ablaTestChecks + 1
    if (!equal) {
        __ablaTestFailures = __ablaTestFailures + 1
        println("FAIL $label: expected $expected, got $actual")
    }
    equal
}

fun expectEqual(actual: int, expected: int, label: string): bool =
    __ablaTestExpectEqual(actual == expected, "$actual", "$expected", label)

fun expectEqual(actual: string, expected: string, label: string): bool =
    __ablaTestExpectEqual(
        actual == expected, "\"$actual\"", "\"$expected\"", label
    )

fun expectEqual(actual: bool, expected: bool, label: string): bool =
    __ablaTestExpectEqual(actual == expected, "$actual", "$expected", label)

fun expectEqual(actual: f64, expected: f64, label: string): bool =
    __ablaTestExpectEqual(actual == expected, "$actual", "$expected", label)

/** Prints "<n> checks, <m> failed"; 0 when every check held, else 1. */
fun testsPassed(): int {
    println("$__ablaTestChecks checks, $__ablaTestFailures failed")
    if (__ablaTestFailures == 0) 0 else 1
}
