import "./value.ab"
import "abla/bytes"
import "abla/text"

// Internal concrete-source records are retained only for document parsing.
// Alias values share closed nodes; expansion budgets count each occurrence.
class YamlSourceEntry(val key: int, val value: int, val begin: int, val end: int,
    val colon: int = -1, var comma: int = -1)
class YamlSourceNode(var value: Yaml, val begin: int, var contentBegin: int,
    var end: int, var style: int, val indent: int,
    val entries: array<YamlSourceEntry>, var anchor: string = "",
    var aliasTarget: int = -1, var closed: bool = false,
    var expandedNodes: int = 1, var expandedBytes: int = 0,
    var expandedDepth: int = 1, var aliasUses: int = 0)
class YamlSourceResult(val value: Yaml, val nodes: array<YamlSourceNode>,
    val root: int, val succeeded: bool, val error: YamlError)
class YamlParser(val source: string, val limits: YamlLimits, val keepSource: bool,
    var pos: int, val starts: array<int>, val ends: array<int>, val nexts: array<int>,
    val indents: array<int>, val nodes: array<YamlSourceNode>,
    val anchors: Map<string, int>, var anchorCount: int, var aliasCount: int,
    var work: int, var flowIndent: int, var errorCode: string, var errorMessage: string, var errorOffset: int)
fun YamlParser.fail(code: string, message: string, offset: int): void {
    if (this.errorCode == "") {
        this.errorCode = code
        this.errorMessage = message
        this.errorOffset = offset
    }
}
fun YamlParser.tick(amount: int): void {
    this.work += amount
    if (this.work > this.limits.maximumWork) this.fail("limit.work", "YAML parsing work limit exceeded", this.pos)
}
fun YamlParser.lineOf(offset: int): int {
    var lo = 0
    var hi = this.starts.size
    while (lo + 1 < hi) {
        val mid = (lo + hi) / 2
        if (this.starts[mid] <= offset) lo = mid else hi = mid
    }
    lo
}
fun YamlParser.endLine(): int = this.ends[this.lineOf(this.pos)]
fun YamlParser.column(): int = this.pos - this.starts[this.lineOf(this.pos)]
fun YamlParser.byte(): int = if (this.pos < this.source.size) this.source[this.pos] else -1
fun yamlSpace(c: int): bool = c == 32 || c == 9
fun yamlBreak(c: int): bool = c == 10 || c == 13
fun yamlSeparation(c: int): bool = c < 0 || yamlSpace(c) || yamlBreak(c)
fun yamlFlowEnd(c: int): bool = c == 44 || c == 93 || c == 125
fun YamlParser.spaces(): void {
    while (this.pos < this.source.size && yamlSpace(this.source[this.pos])) this.pos += 1
}
fun YamlParser.flowSpace(): void {
    var again = true
    while (again && this.pos < this.source.size && this.errorCode == "") {
        this.tick(1)
        val c = this.byte()
        if (yamlSpace(c) || yamlBreak(c)) this.pos += 1
        else if (c == 35) {
            if (this.pos > 0 && !yamlSeparation(this.source[this.pos - 1])) this.fail("syntax.comment", "YAML comments require separation", this.pos)
            this.pos = this.nexts[this.lineOf(this.pos)]
        }
        else {
            if (this.column() <= this.flowIndent && c != 93 && c != 125) this.fail("syntax.indent", "YAML flow continuation must be indented", this.pos)
            if (this.documentMarker(this.pos)) this.fail("syntax.document", "Document marker inside YAML flow collection", this.pos)
            again = false
        }
    }
}
// Skip presentation-only lines, retaining them as gaps in the source model.
fun YamlParser.blockSpace(): void {
    while (this.pos < this.source.size && this.errorCode == "") {
        val line = this.lineOf(this.pos)
        this.pos = this.starts[line] + this.indents[line]
        if (this.pos == this.ends[line] || this.byte() == 35) {
            this.pos = this.nexts[line]
            this.tick(1)
        } else {
            if (this.byte() == 9) {
                var next = this.pos
                while (next < this.ends[line] && yamlSpace(this.source[next])) next += 1
                if (this.indents[line] == 0 && next < this.ends[line] && (this.source[next] == 91 || this.source[next] == 123)) this.pos = next
                else this.fail("syntax.indent", "YAML indentation must use spaces", this.pos)
            }
            return
        }
    }
}
fun YamlParser.finishLine(): void {
    val before = this.pos
    this.spaces()
    if (this.byte() == 35 && this.pos == before && this.pos > 0 && !yamlSeparation(this.source[this.pos - 1])) this.fail("syntax.comment", "YAML comments require separation", this.pos)
    if (this.pos < this.source.size && this.pos < this.endLine() && this.byte() != 35) {
        this.fail("syntax.trailing", "Unexpected content after YAML value", this.pos)
    }
    if (this.pos < this.source.size) this.pos = this.nexts[this.lineOf(this.pos)]
}
fun YamlParser.newNode(begin: int, style: int, indent: int, depth: int): int {
    if (depth > this.limits.maximumDepth) this.fail("limit.depth", "YAML depth limit exceeded", begin)
    if (this.nodes.size >= this.limits.maximumNodes) {
        this.fail("limit.nodes", "YAML node limit exceeded", begin)
        return -1
    }
    val id = this.nodes.size
    this.nodes.append(YamlSourceNode(yamlNull(), begin, this.pos, this.pos, style, indent, []))
    id
}
fun YamlParser.addCost(id: int, child: int): void {
    this.nodes[id].expandedNodes += this.nodes[child].expandedNodes
    this.nodes[id].expandedBytes += this.nodes[child].expandedBytes
    val depth = this.nodes[child].expandedDepth + 1
    if (depth > this.nodes[id].expandedDepth) this.nodes[id].expandedDepth = depth
    this.checkCost(id)
}
fun YamlParser.checkCost(id: int): void {
    if (this.nodes[id].expandedNodes > this.limits.maximumExpandedNodes) this.fail("limit.expansion", "YAML alias expanded-node limit exceeded", this.nodes[id].begin)
    if (this.nodes[id].expandedBytes > this.limits.maximumExpandedScalarBytes) this.fail("limit.expansion", "YAML alias expanded-byte limit exceeded", this.nodes[id].begin)
    if (this.nodes[id].expandedDepth > this.limits.maximumDepth) this.fail("limit.depth", "YAML expanded depth limit exceeded", this.nodes[id].begin)
}
fun YamlParser.closeScalar(id: int, value: Yaml, end: int): int {
    if (id < 0) return id
    this.nodes[id].value = value
    this.nodes[id].end = end
    this.nodes[id].closed = true
    this.nodes[id].expandedBytes = if (value.kind == 1) value.stringValue.size
        else if (value.kind == 2) value.numberValue.text.size else 0
    if (this.nodes[id].expandedBytes > this.limits.maximumScalarBytes) this.fail("limit.scalar", "YAML scalar byte limit exceeded", this.nodes[id].begin)
    this.checkCost(id)
    id
}
fun YamlParser.properties(id: int): void {
    this.spaces()
    if (this.byte() == 33) {
        this.fail("unsupported.tag", "YAML tags are not supported", this.pos)
        return
    }
    if (this.byte() != 38 || id < 0) return
    val begin = this.pos
    if (this.nodes[id].anchor != "") this.fail("syntax.anchor", "A YAML node has more than one anchor", begin)
    this.pos += 1
    val start = this.pos
    while (this.pos < this.source.size && !yamlSeparation(this.byte()) &&
        !yamlFlowEnd(this.byte()) && this.byte() != 91 && this.byte() != 123) this.pos += 1
    if (this.pos == start) this.fail("syntax.anchor", "Expected YAML anchor name", begin)
    val name = this.source.slice(start, this.pos)
    this.anchorCount += 1
    if (this.anchorCount > this.limits.maximumAnchors) this.fail("limit.anchors", "YAML anchor limit exceeded", begin)
    this.nodes[id].anchor = name
    this.anchors.set(name, id)
    this.spaces()
    if (this.byte() == 33) this.fail("unsupported.tag", "YAML tags are not supported", this.pos)
    if (this.byte() == 38) this.fail("syntax.anchor", "A YAML node has more than one anchor", this.pos)
    this.nodes[id].contentBegin = this.pos
}
fun YamlParser.alias(id: int): int {
    if (this.nodes[id].anchor != "") this.fail("syntax.alias", "YAML aliases cannot have anchor properties", this.pos)
    val begin = this.pos
    this.pos += 1
    val start = this.pos
    while (this.pos < this.source.size && !yamlSeparation(this.byte()) &&
        !yamlFlowEnd(this.byte()) && this.byte() != 91 && this.byte() != 123) this.pos += 1
    val name = this.source.slice(start, this.pos)
    this.aliasCount += 1
    if (this.aliasCount > this.limits.maximumAliases) this.fail("limit.aliases", "YAML alias limit exceeded", begin)
    if (!this.anchors.has(name)) this.fail("unsupported.alias", "Undefined or forward YAML aliases are not supported", begin)
    else {
        val found = this.anchors.get(name)
        val target = if (found != null) found else -1
        if (!this.nodes[target].closed) this.fail("unsupported.alias", "Cyclic YAML aliases are not supported", begin)
        else if (id >= 0) {
            this.nodes[id].style = 9
            this.nodes[id].aliasTarget = target
            this.nodes[id].value = yamlCopy(this.nodes[target].value)
            this.nodes[id].expandedNodes = this.nodes[target].expandedNodes
            this.nodes[id].expandedBytes = this.nodes[target].expandedBytes
            this.nodes[id].expandedDepth = this.nodes[target].expandedDepth
            this.nodes[id].closed = true
            this.nodes[id].end = this.pos
            this.nodes[target].aliasUses += 1
            this.checkCost(id)
        }
    }
    id
}
fun YamlParser.quoted(quote: int, parentIndent: int): string {
    this.pos += 1
    val output = byteBuffer()
    var done = false
    while (this.pos < this.source.size && !done && this.errorCode == "") {
        this.tick(1)
        val c = this.byte()
        this.pos += 1
        if (c == quote) {
            if (quote == 39 && this.byte() == 39) { this.pos += 1; output.appendText("'") }
            else done = true
        } else if (c == 92 && quote == 34) {
            val escape = this.byte()
            this.pos += 1
            if (yamlBreak(escape)) {
                if (escape == 13 && this.byte() == 10) this.pos += 1
                while (yamlSpace(this.byte())) this.pos += 1
            } else {
                var scalar = -1
                if (escape == 48) scalar = 0
                else if (escape == 97) scalar = 7
                else if (escape == 98) scalar = 8
                else if (escape == 116 || escape == 9) scalar = 9
                else if (escape == 110) scalar = 10
                else if (escape == 118) scalar = 11
                else if (escape == 102) scalar = 12
                else if (escape == 114) scalar = 13
                else if (escape == 101) scalar = 27
                else if (escape == 32 || escape == 34 || escape == 47 || escape == 92) scalar = escape
                else if (escape == 78) scalar = 133
                else if (escape == 95) scalar = 160
                else if (escape == 76) scalar = 8232
                else if (escape == 80) scalar = 8233
                else if (escape == 120 || escape == 117 || escape == 85) {
                    val count = if (escape == 120) 2 else if (escape == 117) 4 else 8
                    scalar = 0
                    var i = 0
                    while (i < count && this.errorCode == "") {
                        val digit = yamlDigit(this.byte())
                        if (digit < 0 || this.pos >= this.source.size) this.fail("syntax.escape", "Invalid YAML hexadecimal escape", this.pos)
                        else { scalar = scalar * 16 + digit; this.pos += 1 }
                        i += 1
                    }
                }
                if (scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343)) this.fail("syntax.escape", "Invalid YAML Unicode escape", this.pos - 1)
                else output.appendText(utf8Encode(scalar))
            }
        } else if (yamlBreak(c)) {
            // Physical folded breaks trim adjacent separation spaces.
            if (c == 13 && this.byte() == 10) this.pos += 1
            var breaks = 1
            var scanning = true
            while (scanning && this.pos < this.source.size) {
                while (yamlSpace(this.byte())) this.pos += 1
                if (yamlBreak(this.byte())) {
                    val b = this.byte()
                    this.pos += 1
                    if (b == 13 && this.byte() == 10) this.pos += 1
                    breaks += 1
                } else {
                    if (this.column() <= parentIndent || this.documentMarker(this.pos)) this.fail("syntax.indent", "Invalid YAML quoted continuation", this.pos)
                    scanning = false
                }
            }
            if (breaks == 1) output.appendText(" ")
            else { var i = 1; while (i < breaks) { output.appendText("\n"); i += 1 } }
        } else if (yamlSpace(c)) {
            val start = this.pos - 1
            while (yamlSpace(this.byte())) this.pos += 1
            if (!yamlBreak(this.byte())) output.appendText(this.source.slice(start, this.pos))
        } else output.appendText(byteEncode(c))
        if (output.size() > this.limits.maximumScalarBytes) this.fail("limit.scalar", "YAML scalar byte limit exceeded", this.pos)
    }
    if (!done) this.fail("syntax.quote", "Unterminated YAML quoted scalar", this.pos)
    output.toText()
}
// Find a mapping separator, ignoring quoted and nested flow content.
fun YamlParser.documentMarker(offset: int): bool {
    if (offset >= this.source.size || offset != this.starts[this.lineOf(offset)] || offset + 3 > this.source.size) return false
    val marker = this.source.slice(offset, offset + 3)
    (marker == "---" || marker == "...") && (offset + 3 == this.source.size || yamlSeparation(this.source[offset + 3]))
}
fun YamlParser.mappingColon(start: int): int {
    var i = start
    val end = this.ends[this.lineOf(start)]
    // Properties attach to the key when a separator occurs on this line.
    while (i < end && this.source[i] == 38) {
        i += 1
        while (i < end && !yamlSpace(this.source[i])) i += 1
        while (i < end && yamlSpace(this.source[i])) i += 1
    }
    if (i < end && this.source[i] == 42) {
        while (i < end && !yamlSpace(this.source[i])) i += 1
    }
    var quote = 0
    var nesting = 0
    val token = i
    while (i < end) {
        this.tick(1)
        val c = this.source[i]
        if (quote != 0) {
            if (c == 92 && quote == 34) i += 1
            else if (c == quote) {
                if (quote == 39 && i + 1 < end && this.source[i + 1] == 39) i += 1
                else quote = 0
            }
        } else if ((c == 34 || c == 39) && (i == token || nesting > 0)) quote = c
        else if ((c == 91 || c == 123) && (i == token || nesting > 0)) nesting += 1
        else if ((c == 93 || c == 125) && nesting > 0) nesting -= 1
        else if (c == 35 && (i == start || yamlSpace(this.source[i - 1]))) return -1
        else if (c == 58 && nesting == 0 && (i + 1 == end || yamlSpace(this.source[i + 1]))) return i
        i += 1
    }
    -1
}
fun YamlParser.presentationBlank(line: int): bool {
    var pos = this.starts[line] + this.indents[line]
    while (pos < this.ends[line] && yamlSpace(this.source[pos])) pos += 1
    pos == this.ends[line]
}
fun YamlParser.plain(flow: bool, key: bool, parentIndent: int): string {
    val output = byteBuffer()
    var done = false
    while (!done && this.errorCode == "") {
        val begin = this.pos
        val end = this.endLine()
        while (this.pos < end) {
            val c = this.byte()
            if ((flow && (yamlFlowEnd(c) || c == 91 || c == 123)) ||
                (c == 35 && (this.pos == begin || yamlSpace(this.source[this.pos - 1]))) ||
                (c == 58 && (this.pos + 1 == end || yamlSeparation(this.source[this.pos + 1]) ||
                    (flow && yamlFlowEnd(this.source[this.pos + 1]))))) break
            this.pos += 1
        }
        var finish = this.pos
        while (finish > begin && yamlSpace(this.source[finish - 1])) finish -= 1
        output.appendText(this.source.slice(begin, finish))
        this.tick(this.pos - begin + 1)
        if ((key && !flow) || this.pos < end || end == this.source.size) done = true
        else {
            var line = this.lineOf(this.pos) + 1
            var blanks = 0
            while (line < this.starts.size && this.presentationBlank(line)) { blanks += 1; line += 1 }
            if (line < this.starts.size && this.starts[line] < this.source.size &&
                this.indents[line] > parentIndent && this.source[this.starts[line] + this.indents[line]] != 35 &&
                !(flow && yamlFlowEnd(this.source[this.starts[line] + this.indents[line]])) &&
                !(this.documentMarker(this.starts[line]))) {
                this.pos = this.starts[line] + this.indents[line]
                this.spaces()
                if (blanks == 0) output.appendText(" ")
                else { var i = 0; while (i < blanks) { output.appendText("\n"); i += 1 } }
            } else done = true
        }
        if (output.size() > this.limits.maximumScalarBytes) this.fail("limit.scalar", "YAML scalar byte limit exceeded", begin)
    }
    output.toText()
}
fun YamlParser.blockScalar(parentIndent: int): string {
    val folded = this.byte() == 62
    this.pos += 1
    var chomp = 0
    var explicit = 0
    var count = 0
    while (count < 2) {
        val c = this.byte()
        if (c == 43 || c == 45) {
            if (chomp != 0) this.fail("syntax.block", "Repeated YAML chomping indicator", this.pos)
            chomp = c
            this.pos += 1
        } else if (c >= 49 && c <= 57) {
            if (explicit != 0) this.fail("syntax.block", "Repeated YAML indentation indicator", this.pos)
            explicit = c - 48
            this.pos += 1
        } else break
        count += 1
    }
    this.finishLine()
    val contentStart = this.pos
    var required = if (explicit > 0) (if (parentIndent < 0) 0 else parentIndent) + explicit else -1
    var line = this.lineOf(this.pos)
    if (required < 0) {
        var probe = line
        while (probe < this.starts.size && this.starts[probe] + this.indents[probe] == this.ends[probe]) probe += 1
        if (probe < this.starts.size && this.indents[probe] > parentIndent) required = this.indents[probe]
        else required = parentIndent + 1
        if (required < 0) required = 0
    }
    val texts: array<string> = []
    val more: array<bool> = []
    val broken: array<bool> = []
    var finish = contentStart
    var leading = true
    while (line < this.starts.size && this.starts[line] < this.source.size && this.errorCode == "") {
        if (this.documentMarker(this.starts[line])) break
        val blank = this.starts[line] + this.indents[line] == this.ends[line]
        if (!blank && this.indents[line] < required) break
        if (leading && blank && this.indents[line] > required) this.fail("syntax.block", "YAML leading blank line exceeds scalar indentation", this.starts[line])
        val begin = if (this.indents[line] >= required) this.starts[line] + required else this.ends[line]
        val text = this.source.slice(begin, this.ends[line])
        texts.append(text)
        more.append(text.size > 0 && yamlSpace(text[0]))
        if (!blank) leading = false
        broken.append(this.nexts[line] > this.ends[line])
        finish = this.nexts[line]
        this.tick(this.nexts[line] - this.starts[line] + 1)
        line += 1
    }
    this.pos = finish
    val output = byteBuffer()
    var lastText = texts.size - 1
    while (lastText >= 0 && texts[lastText].size == 0) lastText -= 1
    var i = 0
    while (i < texts.size) {
        output.appendText(texts[i])
        if (broken[i]) {
            var nextText = i + 1
            while (nextText < texts.size && texts[nextText].size == 0) nextText += 1
            if (!folded || i >= lastText || more[i] || more[i + 1] ||
                (texts[i].size > 0 && nextText < texts.size && more[nextText])) output.appendText("\n")
            else if (texts[i].size > 0 && texts[i + 1].size > 0) output.appendText(" ")
            else if (texts[i].size == 0) output.appendText("\n")
        }
        i += 1
    }
    var result = output.toText()
    if (chomp != 43) {
        var end = result.size
        while (end > 0 && result[end - 1] == 10) end -= 1
        val hadText = end > 0
        result = result.slice(0, end)
        if (chomp != 45 && hadText && texts.size > 0 && broken[broken.size - 1]) result += "\n"
    }
    result
}
fun YamlParser.scalar(id: int, flow: bool, key: bool, parentIndent: int): int {
    if (id < 0) return id
    val c = this.byte()
    if (c == 42) return this.alias(id)
    if (c == 33) { this.fail("unsupported.tag", "YAML tags are not supported", this.pos); return id }
    if (c == 34 || c == 39) {
        this.nodes[id].style = if (c == 39) 1 else 2
        val value = this.quoted(c, parentIndent)
        return this.closeScalar(id, yamlString(value), this.pos)
    }
    if (c == 124 || c == 62) {
        if (flow) { this.fail("syntax.block", "Block scalar is not allowed here", this.pos); return id }
        this.nodes[id].style = if (c == 124) 3 else 4
        val value = this.blockScalar(parentIndent)
        return this.closeScalar(id, yamlString(value), this.pos)
    }
    if (c == 64 || c == 96 || c == 37 || c == 93 || c == 125 || c == 44 ||
        ((c == 45 || c == 63 || c == 58) && (this.pos + 1 == this.source.size || yamlSeparation(this.source[this.pos + 1]) || (flow && yamlFlowEnd(this.source[this.pos + 1]))))) {
        this.fail("syntax.scalar", "Invalid YAML plain scalar start", this.pos)
        return id
    }
    val value = this.plain(flow, key, parentIndent)
    if (yamlNumberKind(value) >= 0) {
        if (value.size > this.limits.maximumNumberBytes) this.fail("limit.number", "YAML numeric text limit exceeded", this.nodes[id].begin)
        // Base conversion and exponent canonicalization have bounded quadratic work.
        this.tick(value.size * value.size)
    }
    this.closeScalar(id, yamlResolvePlain(value), this.pos)
}
fun YamlParser.member(id: int, key: int, value: int, begin: int, end: int, colon: int,
    var keys: array<Yaml>, var values: array<Yaml>, var seen: Map<string, int>): void {
    if (id < 0 || value < 0 || this.errorCode != "") return
    if (values.size >= this.limits.maximumCollectionMembers) this.fail("limit.members", "YAML collection member limit exceeded", begin)
    if (key >= 0) {
        if (this.nodes[key].style == 0 && this.nodes[key].value.kind == 1 && this.nodes[key].value.stringValue == "<<") this.fail("unsupported.merge", "YAML merge keys are not supported", this.nodes[key].begin)
        if (this.nodes[key].value.kind >= 4) this.fail("unsupported.key", "YAML collection keys are not supported", this.nodes[key].begin)
        val identity = yamlScalarKey(this.nodes[key].value)
        if (seen.has(identity)) this.fail("syntax.duplicate", "Duplicate YAML mapping key", this.nodes[key].begin)
        seen.set(identity, key)
        keys.append(yamlCopy(this.nodes[key].value))
        this.addCost(id, key)
    }
    values.append(yamlCopy(this.nodes[value].value))
    this.addCost(id, value)
    if (this.keepSource) this.nodes[id].entries.append(YamlSourceEntry(key, value, begin, end, colon))
}
fun YamlParser.flow(id: int, depth: int, parentIndent: int): int {
    val previousIndent = this.flowIndent
    this.flowIndent = parentIndent
    val mapping = this.byte() == 123
    val closing = if (mapping) 125 else 93
    this.nodes[id].style = if (mapping) 7 else 8
    this.pos += 1
    this.flowSpace()
    val keys: array<Yaml> = []
    val values: array<Yaml> = []
    val seen: Map<string, int> = Map()
    while (this.pos < this.source.size && this.byte() != closing && this.errorCode == "") {
        val begin = this.pos
        if (!mapping && this.byte() == 44) { this.fail("syntax.flow", "Empty YAML flow sequence entry", this.pos); break }
        var explicit = false
        if (this.byte() == 63 && this.pos + 1 < this.source.size && yamlSeparation(this.source[this.pos + 1])) {
            explicit = true
            this.pos += 1
            this.flowSpace()
        }
        val first = this.inlineNode(depth + 1, true, true, -1)
        this.flowSpace()
        var key = -1
        var value = first
        var colon = -1
        if (mapping || this.byte() == 58 || explicit) {
            if (!mapping && !explicit && this.byte() == 58 && this.lineOf(begin) != this.lineOf(this.pos)) this.fail("syntax.key", "Implicit YAML keys must stay on one line", begin)
            key = first
            if (this.byte() == 58) {
                colon = this.pos
                this.pos += 1
                this.flowSpace()
                value = this.inlineNode(depth + 1, true, false, -1)
            } else value = this.emptyNode(this.pos, depth + 1)
            if (!mapping) {
                val pair = this.newNode(begin, 7, this.column(), depth + 1)
                val pk: array<Yaml> = []
                val pv: array<Yaml> = []
                val ps: Map<string, int> = Map()
                this.member(pair, key, value, begin, this.pos, colon, pk, pv, ps)
                if (pair >= 0) { this.nodes[pair].value = yamlMapping(pk, pv); this.nodes[pair].closed = true; this.nodes[pair].end = this.pos }
                value = pair
                key = -1
            }
        }
        this.flowSpace()
        this.member(id, key, value, begin, this.pos, colon, keys, values, seen)
        if (this.byte() == 44) {
            if (this.keepSource && this.nodes[id].entries.size > 0) this.nodes[id].entries[this.nodes[id].entries.size - 1].comma = this.pos
            this.pos += 1
            this.flowSpace()
        } else if (this.byte() != closing) this.fail("syntax.flow", "Expected comma or YAML flow collection end", this.pos)
    }
    if (this.byte() != closing) this.fail("syntax.flow", "Unterminated YAML flow collection", this.pos)
    else this.pos += 1
    this.nodes[id].value = if (mapping) yamlMapping(keys, values) else yamlSequence(values)
    this.nodes[id].closed = true
    this.nodes[id].end = this.pos
    this.flowIndent = previousIndent
    id
}
fun YamlParser.emptyNode(begin: int, depth: int): int {
    val id = this.newNode(begin, 10, this.column(), depth)
    this.closeScalar(id, yamlNull(), begin)
}
fun YamlParser.inlineNode(depth: int, flow: bool, key: bool, parentIndent: int): int {
    this.spaces()
    val id = this.newNode(this.pos, 0, this.column(), depth)
    if (id < 0 || this.errorCode != "") return id
    this.properties(id)
    val c = this.byte()
    if (c == 91 || c == 123) this.flow(id, depth, parentIndent)
    else if (c < 0 || yamlBreak(c) || c == 35 || (flow && yamlFlowEnd(c)) || (c == 58 && (this.pos + 1 == this.source.size || yamlSeparation(this.source[this.pos + 1]) || (flow && yamlFlowEnd(this.source[this.pos + 1]))))) this.closeScalar(id, yamlNull(), this.pos)
    else this.scalar(id, flow, key, parentIndent)
}
fun YamlParser.afterIndicator(parentIndent: int, depth: int, compact: bool): int {
    this.spaces()
    val begin = this.pos
    val id = this.newNode(begin, 0, this.column(), depth)
    if (id < 0 || this.errorCode != "") return id
    this.properties(id)
    if (this.pos >= this.source.size || this.pos == this.endLine() || this.byte() == 35) {
        this.finishLine()
        this.blockSpace()
        if (this.pos < this.source.size && (this.column() > parentIndent ||
            (!compact && this.column() == parentIndent && this.dash()))) return this.blockNode(depth, id)
        return this.closeScalar(id, yamlNull(), begin)
    }
    if (compact && (this.dash() || this.mappingColon(this.pos) >= 0 || this.explicitKey())) return this.blockNode(depth, id)
    val c = this.byte()
    if (c == 91 || c == 123) this.flow(id, depth, parentIndent)
    else this.scalar(id, false, false, parentIndent)
    if (this.nodes[id].style != 3 && this.nodes[id].style != 4) this.finishLine()
    this.blockSpace()
    id
}
fun YamlParser.blockSpaceIfNewLine(): void {
    if (this.pos == this.starts[this.lineOf(this.pos)]) this.blockSpace()
}
fun YamlParser.dash(): bool = this.byte() == 45 && (this.pos + 1 == this.source.size || yamlSeparation(this.source[this.pos + 1]))
fun YamlParser.explicitKey(): bool = this.byte() == 63 && (this.pos + 1 == this.source.size || yamlSeparation(this.source[this.pos + 1]))
fun YamlParser.blockNode(depth: int, existing: int = -1): int {
    val indent = this.column()
    val parentIndent = if (depth == 1) -1 else indent - 1
    val id = if (existing >= 0) existing else this.newNode(this.pos, 0, indent, depth)
    if (id < 0 || this.errorCode != "") return id
    if (this.documentMarker(this.pos)) { this.fail("unsupported.documents", "Multiple YAML documents are not supported", this.pos); return id }
    if (this.mappingColon(this.pos) < 0) this.properties(id)
    if (this.nodes[id].anchor != "" && (this.pos >= this.source.size || this.pos == this.endLine() || this.byte() == 35)) {
        this.finishLine()
        this.blockSpace()
        if (this.pos >= this.source.size) return this.closeScalar(id, yamlNull(), this.pos)
        return this.blockNode(depth, id)
    }
    val sequence = this.dash()
    val mapping = !sequence && (this.mappingColon(this.pos) >= 0 || this.explicitKey())
    if (!sequence && !mapping) {
        val c = this.byte()
        if (c == 91 || c == 123) this.flow(id, depth, parentIndent)
        else this.scalar(id, false, false, parentIndent)
        if (this.nodes[id].style != 3 && this.nodes[id].style != 4) this.finishLine()
        this.blockSpace()
        return id
    }
    this.nodes[id].style = if (sequence) 6 else 5
    this.nodes[id].contentBegin = this.pos
    val keys: array<Yaml> = []
    val values: array<Yaml> = []
    val seen: Map<string, int> = Map()
    var end = this.pos
    while (this.pos < this.source.size && this.column() == indent && this.errorCode == "") {
        val begin = this.pos
        var key = -1
        var value = -1
        var colon = -1
        if (sequence) {
            if (!this.dash()) break
            this.pos += 1
            value = this.afterIndicator(indent, depth + 1, true)
        } else {
            val explicit = this.explicitKey()
            colon = this.mappingColon(this.pos)
            if (!explicit && colon < 0) break
            if (explicit) {
                this.pos += 1
                this.spaces()
                if (this.pos == this.endLine() || this.byte() == 35 || this.dash() || this.mappingColon(this.pos) >= 0) {
                    if (this.dash() || this.mappingColon(this.pos) >= 0) this.fail("unsupported.key", "YAML collection keys are not supported", this.pos)
                    key = this.afterIndicator(indent, depth + 1, true)
                    if (this.dash() && this.column() == indent) this.fail("unsupported.key", "YAML collection keys are not supported", this.pos)
                } else {
                    key = this.inlineNode(depth + 1, false, false, indent)
                    if (key >= 0 && this.nodes[key].style != 3 && this.nodes[key].style != 4) {
                        this.spaces()
                        if (this.byte() != 58) this.finishLine()
                    }
                    this.blockSpaceIfNewLine()
                }
                if (this.byte() == 58 && this.column() == indent) colon = this.pos
                else if (this.byte() == 58 && this.lineOf(this.pos) == this.lineOf(begin)) colon = this.pos
                else colon = -1
            } else {
                if (this.pos == colon) key = this.emptyNode(this.pos, depth + 1)
                else key = this.inlineNode(depth + 1, false, true, indent)
                this.spaces()
                if (this.pos != colon) this.fail("syntax.key", "Invalid YAML mapping key", this.pos)
            }
            if (key >= 0 && this.nodes[key].value.kind >= 4) this.fail("unsupported.key", "YAML collection keys are not supported", this.nodes[key].begin)
            if (colon >= 0) {
                this.pos = colon + 1
                value = this.afterIndicator(indent, depth + 1, explicit)
            } else value = this.emptyNode(this.pos, depth + 1)
        }
        // afterIndicator skips gap comments, but entry ranges own only the
        // last value's physical line, never those unrelated gap comments.
        if (value >= 0) {
            end = this.nodes[value].end
            if (end < this.source.size) {
                val line = this.lineOf(end)
                if (end > this.starts[line] || end == begin) end = this.nexts[line]
            }
        }
        this.member(id, key, value, begin, end, colon, keys, values, seen)
    }
    this.nodes[id].value = if (mapping) yamlMapping(keys, values) else yamlSequence(values)
    this.nodes[id].closed = true
    this.nodes[id].end = end
    id
}
fun yamlReadSource(source: string, limits: YamlLimits, keepSource: bool): YamlSourceResult {
    val p = YamlParser(source, limits, keepSource, 0, [], [], [], [], [], Map(), 0, 0, 0, -1, "", "", 0)
    if (!yamlLimitsValid(limits)) p.fail("limit.invalid", "Invalid YAML limits", 0)
    if (source.size > limits.maximumBytes) p.fail("limit.bytes", "YAML input byte limit exceeded", 0)
    if (p.errorCode == "" && !source.isValidUtf8()) p.fail("syntax.utf8", "Invalid YAML UTF-8", 0)
    // Index lines once. Non-printable controls cannot occur literally, even in
    // quoted scalars; their escaped forms are accepted by quoted().
    var i = 0
    while (i <= source.size && p.errorCode == "") {
        val start = i
        var indent = 0
        while (i < source.size && source[i] == 32) { indent += 1; i += 1 }
        while (i < source.size && !yamlBreak(source[i])) {
            val c = source[i]
            if ((c < 32 && c != 9) || c == 127 ||
                (c == 194 && i + 1 < source.size && source[i + 1] >= 128 && source[i + 1] <= 159 && source[i + 1] != 133) ||
                (c == 239 && i + 2 < source.size && source[i + 1] == 191 && source[i + 2] >= 190)) p.fail("syntax.control", "Non-printable YAML character", i)
            i += 1
        }
        val end = i
        if (i < source.size && source[i] == 13) i += 1
        if (i < source.size && source[i] == 10) i += 1
        p.starts.append(start)
        p.ends.append(end)
        p.nexts.append(i)
        p.indents.append(indent)
        if (i == source.size) {
            if (end < i) { p.starts.append(i); p.ends.append(i); p.nexts.append(i); p.indents.append(0) }
            break
        }
    }
    // Keep positional error handling defined even on a rejected input.
    if (p.starts.size == 0) { p.starts.append(0); p.ends.append(0); p.nexts.append(0); p.indents.append(0) }
    if (source.size >= 3 && source[0] == 239 && source[1] == 187 && source[2] == 191) {
        p.pos = 3
        p.starts[0] = 3
    }
    p.blockSpace()
    if (p.byte() == 37 && p.errorCode == "") {
        val directive = source.slice(p.pos, p.endLine())
        if (directive != "%YAML 1.2") {
            if (directive.size >= 4 && directive.slice(0, 4) == "%TAG") p.fail("unsupported.tag", "YAML tags are not supported", p.pos)
            else p.fail("unsupported.directive", "Only the YAML 1.2 directive is supported", p.pos)
        }
        p.pos = p.nexts[p.lineOf(p.pos)]
        p.blockSpace()
        if (p.pos + 3 > source.size || source.slice(p.pos, p.pos + 3) != "---") p.fail("syntax.directive", "YAML directive requires a document start marker", p.pos)
    }
    if (p.pos + 3 <= source.size && source.slice(p.pos, p.pos + 3) == "---" &&
        (p.pos + 3 == source.size || yamlSeparation(source[p.pos + 3]))) {
        p.pos += 3
        p.spaces()
        if (p.pos < source.size && (p.mappingColon(p.pos) >= 0 || p.dash() || p.explicitKey())) p.fail("syntax.document", "Block collections must start after the YAML document marker line", p.pos)
        if (p.pos == source.size || p.pos == p.endLine() || p.byte() == 35) { p.finishLine(); p.blockSpace() }
    }
    var root = -1
    if (p.errorCode == "") {
        if (p.pos >= source.size || (p.pos + 3 <= source.size && source.slice(p.pos, p.pos + 3) == "...")) root = p.emptyNode(p.pos, 1)
        else root = p.blockNode(1)
        p.blockSpace()
        if (p.pos + 3 <= source.size && source.slice(p.pos, p.pos + 3) == "..." &&
            (p.pos + 3 == source.size || yamlSeparation(source[p.pos + 3]))) {
            p.pos += 3
            p.finishLine()
            p.blockSpace()
        }
        if (p.pos < source.size) {
            if (p.pos + 3 <= source.size && source.slice(p.pos, p.pos + 3) == "---") p.fail("unsupported.documents", "Multiple YAML documents are not supported", p.pos)
            else p.fail("syntax.trailing", "Unexpected YAML content or indentation", p.pos)
        }
    }
    val line = p.lineOf(p.errorOffset)
    val error = YamlError(p.errorCode, p.errorMessage, p.errorOffset, line + 1, p.errorOffset - p.starts[line] + 1)
    val value = if (root >= 0 && p.errorCode == "") p.nodes[root].value else yamlNull()
    YamlSourceResult(value, p.nodes, root, p.errorCode == "", error)
}
fun yamlParse(source: string, limits: YamlLimits = yamlDefaultLimits()): YamlParseResult {
    val result = yamlReadSource(source, limits, false)
    YamlParseResult(result.value, result.succeeded, result.error)
}
