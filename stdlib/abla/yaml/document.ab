import "./value.ab"
import "./parser.ab"
import "./emitter.ab"
import "abla/bytes"
import "abla/text"

class YamlDocument(val source: string, val value: Yaml,
    val nodes: array<YamlSourceNode>, val root: int, val limits: YamlLimits,
    val valid: bool)
class YamlDocumentResult(val document: YamlDocument, val succeeded: bool, val error: YamlError)
class YamlPathPart(val indexed: bool, val key: Yaml, val index: int)
fun yamlKey(key: string): YamlPathPart = YamlPathPart(false, yamlString(key), -1)
fun yamlValueKey(key: Yaml): YamlPathPart = YamlPathPart(false, key, -1)
fun yamlIndex(index: int): YamlPathPart = YamlPathPart(true, yamlNull(), index)
fun yamlParseDocument(source: string,
    limits: YamlLimits = yamlDefaultLimits()): YamlDocumentResult {
    val parsed = yamlReadSource(source, limits, true)
    YamlDocumentResult(YamlDocument(source, parsed.value, parsed.nodes, parsed.root, limits,
        parsed.succeeded), parsed.succeeded, parsed.error)
}
fun YamlDocument.toText(): string = this.source
class YamlEditor(val original: YamlDocument, var current: YamlDocument,
    var error: YamlError, var work: int)
fun YamlDocument.edit(): YamlEditor = YamlEditor(this, this, YamlError("", "", 0, 1, 1), 0)
fun YamlEditor.finish(): YamlDocumentResult =
    if (this.error.code != "") YamlDocumentResult(this.original, false, this.error)
    else if (!this.current.valid) YamlDocumentResult(this.original, false,
        YamlError("edit.document", "Cannot edit an invalid YAML document", 0, 1, 1))
    else YamlDocumentResult(this.current, true, this.error)
fun YamlEditor.fail(code: string, message: string, offset: int = 0): void {
    if (this.error.code != "") return
    this.error = yamlErrorAt(this.current.source, code, message, offset)
}
fun YamlEditor.ready(): bool {
    if (!this.current.valid) this.fail("edit.document", "Cannot edit an invalid YAML document")
    this.error.code == ""
}
fun YamlDocument.entryIndex(id: int, part: YamlPathPart): int {
    val node = this.nodes[id]
    if (part.indexed) {
        if (node.value.kind == 4 && part.index >= 0 && part.index <
            node.entries.size) part.index else -1
    } else if (node.value.kind == 5 && part.key.kind < 4) {
        var i = 0
        val identity = yamlScalarKey(part.key)
        while (i < node.entries.size) {
            if (yamlScalarKey(this.nodes[node.entries[i].key].value) == identity) return i
            i += 1
        }
        -1
    } else -1
}
// The final alias occurrence can be replaced/removed locally. Traversal through
// one requires materialize first, so edits never silently fan out via anchors.
fun YamlEditor.resolve(path: array<YamlPathPart>, count: int): int {
    if (!this.ready()) return -1
    var id = this.current.root
    var i = 0
    while (i < count && this.error.code == "") {
        if (this.current.nodes[id].aliasTarget >= 0) {
            this.fail("edit.alias", "Materialize the YAML alias before editing through it",
                this.current.nodes[id].begin)
            return -1
        }
        val entry = this.current.entryIndex(id, path[i])
        if (entry < 0) {
            this.fail("edit.path", "YAML edit parent path does not exist or has the wrong kind",
                this.current.nodes[id].begin)
            return -1
        }
        id = this.current.nodes[id].entries[entry].value
        i += 1
    }
    id
}
fun yamlLineStart(source: string, offset: int): int {
    var i = offset
    while (i > 0 && source[i - 1] != 10 && source[i - 1] != 13) i -= 1
    i
}
fun yamlIndentPrefix(source: string, offset: int): bool {
    var i = yamlLineStart(source, offset)
    while (i < offset) { if (source[i] != 32) return false; i += 1 }
    true
}
fun yamlLineEnd(source: string, offset: int): int {
    var i = offset
    while (i < source.size && source[i] != 10 && source[i] != 13) i += 1
    i
}
fun yamlLineNext(source: string, offset: int): int {
    var i = yamlLineEnd(source, offset)
    if (i < source.size && source[i] == 13) i += 1
    if (i < source.size && source[i] == 10) i += 1
    i
}
fun yamlSourceNewline(source: string): string {
    var i = 0
    while (i < source.size) {
        if (source[i] == 13 && i + 1 < source.size && source[i + 1] == 10) return "\r\n"
        if (source[i] == 10) return "\n"
        if (source[i] == 13) return "\r"
        i += 1
    }
    "\n"
}
fun yamlSpaces(count: int): string {
    val output = byteBuffer()
    var i = 0
    while (i < count) { output.appendText(" "); i += 1 }
    output.toText()
}
fun yamlLeadingIndent(source: string, offset: int): int {
    var i = yamlLineStart(source, offset)
    val begin = i
    while (i < source.size && source[i] == 32) i += 1
    i - begin
}
fun YamlDocument.protectedAnchor(id: int): bool {
    val node = this.nodes[id]
    for (candidate in this.nodes) {
        if (candidate.begin >= node.begin && candidate.end <= node.end && candidate.anchor != "" &&
            candidate.aliasUses > 0) return true
    }
    false
}
fun YamlEditor.patch(begin: int, end: int, text: string): bool {
    if (!this.ready()) return false
    if (begin < 0 || end < begin || end > this.current.source.size) {
        this.fail("edit.span", "Invalid YAML edit source span")
        return false
    }
    this.work += this.current.source.size + text.size + 1
    if (this.work > this.current.limits.maximumWork) {
        this.fail("limit.work", "YAML editing work limit exceeded", begin)
        return false
    }
    if (this.current.source.size - (end - begin) + text.size > this.current.limits.maximumBytes) {
        this.fail("limit.bytes", "YAML edited document byte limit exceeded", begin)
        return false
    }
    val source = this.current.source.slice(0, begin) + text + this.current.source.slice(end,
        this.current.source.size)
    val parsed = yamlParseDocument(source, this.current.limits)
    if (!parsed.succeeded) {
        this.fail("edit.invalid",
            "YAML edit could not preserve valid syntax: " + parsed.error.message, begin)
        return false
    }
    this.current = parsed.document
    true
}
fun yamlEditEmit(value: Yaml, limits: YamlLimits): YamlEmitResult =
    yamlEmit(value, YamlEmitOptions(finalNewline = false, flow = true), limits)
fun yamlSingleQuote(text: string): string {
    val output = byteBuffer()
    output.appendText("'")
    var i = 0
    while (i < text.size) {
        if (text[i] == 39) output.appendText("''") else output.appendText(byteEncode(text[i]))
        i += 1
    }
    output.appendText("'")
    output.toText()
}
fun yamlSingleLinePrintable(text: string): bool {
    var i = 0
    while (i < text.size) {
        if ((text[i] < 32 && text[i] != 9) || text[i] == 127) return false
        if (text[i] == 194 && i + 1 < text.size && text[i + 1] >= 128 && text[i + 1] <= 159 &&
            text[i + 1] != 133) return false
        if (text[i] == 239 && i + 2 < text.size && text[i + 1] == 191 && text[i + 2] >=
            190) return false
        i += 1
    }
    true
}
// A conservative subset of plain style, safe in both block and flow positions.
fun yamlEditPlain(text: string, flow: bool): bool {
    if (text.size == 0 || !yamlSingleLinePrintable(text) || yamlSpace(text[0]) ||
        yamlSpace(text[text.size - 1]) || yamlResolvePlain(text).kind != 1 || text == "---" ||
        text == "...") return false
    val first = text[0]
    if (first == 33 || first == 38 || first == 42 || first == 35 || first == 124 || first == 62 ||
        first == 39 || first == 34 || first == 37 || first == 64 || first == 96 || first == 91 ||
        first == 93 || first == 123 || first == 125 || first == 44) return false
    if ((first == 45 || first == 63 || first == 58) && (text.size == 1 || yamlSpace(text[1]) ||
        (flow && yamlFlowEnd(text[1])))) return false
    var i = 0
    while (i < text.size) {
        val c = text[i]
        if (flow && (c == 44 || c == 91 || c == 93 || c == 123 || c == 125)) return false
        if (c == 58 && (i + 1 == text.size || yamlSpace(text[i + 1]) || (flow &&
            yamlFlowEnd(text[i + 1])))) return false
        if (c == 35 && (i == 0 || yamlSpace(text[i - 1]))) return false
        i += 1
    }
    true
}
fun YamlDocument.inFlow(id: int): bool {
    for (node in this.nodes) {
        if (node.style == 7 || node.style == 8) {
            for (entry in node.entries) { if (entry.value == id) return true }
        }
    }
    false
}
fun YamlDocument.blockText(id: int, text: string): string {
    val node = this.nodes[id]
    val newline = yamlSourceNewline(this.source)
    val indent = yamlLeadingIndent(this.source, node.contentBegin) + 2
    var trailing = 0
    while (trailing < text.size && text[text.size - trailing - 1] == 10) trailing += 1
    val folded = node.style == 4
    val output = byteBuffer()
    output.appendText(if (folded) ">2" else "|2")
    if (trailing == 0) output.appendText("-")
    else if (trailing > 1 || trailing == text.size) output.appendText("+")
    // Keep the header's spacing and inline comment, changing only indicators.
    var suffix = node.contentBegin + 1
    val headerEnd = yamlLineEnd(this.source, node.contentBegin)
    while (suffix < headerEnd && (this.source[suffix] == 43 || this.source[suffix] == 45 ||
        (this.source[suffix] >= 49 && this.source[suffix] <= 57))) suffix += 1
    output.appendText(this.source.slice(suffix, headerEnd))
    output.appendText(newline)
    val lines: array<string> = []
    var begin = 0
    var i = 0
    while (i < text.size) {
        if (text[i] == 10) { lines.append(text.slice(begin, i)); begin = i + 1 }
        i += 1
    }
    if (begin < text.size) lines.append(text.slice(begin, text.size))
    i = 0
    while (i < lines.size) {
        output.appendText(yamlSpaces(indent))
        output.appendText(lines[i])
        val hasBreak = i + 1 < lines.size || trailing > 0 || node.end < this.source.size ||
            (node.end > 0 && yamlBreak(this.source[node.end - 1]))
        if (hasBreak) output.appendText(newline)
        // A blank line prevents folding a desired newline between normal
        // paragraphs. More-indented lines already preserve their breaks.
        if (folded && lines[i].size > 0 && !yamlSpace(lines[i][0])) {
            var next = i + 1
            while (next < lines.size && lines[next].size == 0) next += 1
            if (next < lines.size && !yamlSpace(lines[next][0])) output.appendText(newline)
        }
        i += 1
    }
    output.toText()
}
fun YamlDocument.inlineIndent(id: int): string {
    if (this.nodes[id].style != 6) return ""
    for (node in this.nodes) {
        if (node.style == 5 && node.indent == this.nodes[id].indent) {
            for (entry in node.entries) {
                if (entry.value == id) return "  "
            }
        }
    }
    ""
}
fun YamlDocument.replacement(id: int, value: Yaml, encoded: string): string {
    val node = this.nodes[id]
    if (value.kind != 1) return encoded
    val text = value.stringValue
    if ((node.style == 3 || node.style == 4) && text.isValidUtf8()) {
        // CR and non-printable content require escaped double-quoted style.
        var valid = true
        var i = 0
        while (i < text.size) {
            if (text[i] == 13 || (text[i] < 32 && text[i] != 10 && text[i] != 9) || text[i] ==
                127 ||
                (text[i] == 194 && i + 1 < text.size && text[i + 1] >= 128 && text[i + 1] <= 159 &&
                    text[i + 1] != 133) ||
                (text[i] == 239 && i + 2 < text.size && text[i + 1] == 191 && text[i + 2] >=
                    190)) valid = false
            i += 1
        }
        if (valid) return this.blockText(id, text)
    }
    if (node.style == 1 && yamlSingleLinePrintable(text)) return yamlSingleQuote(text)
    if (node.style == 0 && yamlEditPlain(text, this.inFlow(id))) return text
    encoded
}
// Equality has its own bounded walk, independent of output size. A legal alias
// graph can expand beyond maximumBytes, yet setting that same value is a no-op.
class YamlEquality(val limits: YamlLimits, var nodes: int, var work: int)
fun YamlEquality.same(left: Yaml, right: Yaml, depth: int): bool {
    if (left == right) return true
    this.nodes += 1
    this.work += 1
    if (depth > this.limits.maximumDepth || this.nodes > this.limits.maximumExpandedNodes ||
        this.work > this.limits.maximumWork || left.kind != right.kind) return false
    if (left.kind == 0) return true
    if (left.kind == 1) {
        this.work += left.stringValue.size
        return this.work <= this.limits.maximumWork && left.stringValue == right.stringValue
    }
    if (left.kind == 2) return left.numberValue.text == right.numberValue.text &&
        left.numberValue.integer == right.numberValue.integer && left.numberValue.valid &&
        right.numberValue.valid
    if (left.kind == 3) return left.boolValue == right.boolValue
    if (left.kind != 4 && left.kind != 5) return false
    if (left.values.size != right.values.size) return false
    if (left.kind == 5 && (left.keys.size != left.values.size || right.keys.size !=
        right.values.size)) return false
    var i = 0
    while (i < left.values.size) {
        if (left.kind == 5 && !this.same(left.keys[i], right.keys[i], depth + 1)) return false
        if (!this.same(left.values[i], right.values[i], depth + 1)) return false
        i += 1
    }
    true
}
fun yamlSame(left: Yaml, right: Yaml, limits: YamlLimits): bool = YamlEquality(limits, 0,
    0).same(left, right, 1)
fun YamlEditor.replace(id: int, value: Yaml): bool {
    if (yamlSame(this.current.nodes[id].value, value, this.current.limits)) return true
    val encoded = yamlEditEmit(value, this.current.limits)
    if (!encoded.succeeded) { this.fail(encoded.error.code, encoded.error.message); return false }
    if (this.current.protectedAnchor(id)) { this.fail("edit.anchor",
        "Cannot change a YAML anchor definition with live aliases",
        this.current.nodes[id].begin); return false }
    val begin = this.current.nodes[id].contentBegin
    val end = this.current.nodes[id].end
    var text = this.current.inlineIndent(id) + this.current.replacement(id, value, encoded.text)
    // Replacing a block scalar owns its body, but keeps its header comment even
    // when the replacement must switch to an inline representation.
    if ((this.current.nodes[id].style == 3 || this.current.nodes[id].style == 4) &&
        !(text.size > 0 && (text[0] == 124 || text[0] == 62))) {
        val headerEnd = yamlLineEnd(this.current.source, begin)
        var hash = begin
        while (hash < headerEnd && this.current.source[hash] != 35) hash += 1
        if (hash < headerEnd) {
            var gap = hash
            while (gap > begin && yamlSpace(this.current.source[gap - 1])) gap -= 1
            text += this.current.source.slice(gap, headerEnd)
        }
        if (end > 0 && yamlBreak(this.current.source[end - 1])) text +=
            yamlSourceNewline(this.current.source)
    }
    if ((this.current.nodes[id].style == 5 || this.current.nodes[id].style == 6) && end > 0 &&
        yamlBreak(this.current.source[end - 1])) text += yamlSourceNewline(this.current.source)
    if (this.current.nodes[id].anchor != "" && begin > 0 &&
        !yamlSeparation(this.current.source[begin - 1])) text = " " + text
    if (begin > 0 && (this.current.source[begin - 1] == 58 || this.current.source[begin - 1] ==
        45)) text = " " + text
    if (begin == end && end < this.current.source.size && this.current.source[end] == 35) text +=
        " "
    if (begin == this.current.source.size && begin > 0 && !yamlBreak(this.current.source[begin -
        1]) && this.current.nodes[id].style == 10) text = yamlSourceNewline(this.current.source) +
        text
    this.patch(begin, end, text)
}
fun YamlEditor.verify(path: array<YamlPathPart>, value: Yaml): bool {
    val id = this.resolve(path, path.size)
    if (id < 0) return false
    if (!yamlSame(value, this.current.nodes[id].value, this.current.limits)) {
        this.fail("edit.value", "YAML edit could not preserve the requested value")
        return false
    }
    true
}
fun YamlDocument.newKeyText(parent: int, key: Yaml, encoded: string): string {
    if (key.kind != 1 || key.stringValue == "<<" || this.nodes[parent].entries.size ==
        0) return encoded
    val first = this.nodes[parent].entries[0].key
    if (first < 0) return encoded
    val style = this.nodes[first].style
    if (style == 0 && yamlEditPlain(key.stringValue,
        this.nodes[parent].style == 7)) return key.stringValue
    if (style == 1 &&
        yamlSingleLinePrintable(key.stringValue)) return yamlSingleQuote(key.stringValue)
    encoded
}
fun YamlEditor.insertInto(parent: int, part: YamlPathPart, value: Yaml): bool {
    if (this.current.nodes[parent].aliasTarget >= 0) { this.fail("edit.alias",
        "Materialize the YAML alias before editing through it"); return false }
    val mapping = this.current.nodes[parent].value.kind == 5
    val sequence = this.current.nodes[parent].value.kind == 4
    if ((!mapping && !sequence) || (mapping && (part.indexed || part.key.kind >= 4)) ||
        (sequence && (!part.indexed || part.index < 0 || part.index >
            this.current.nodes[parent].entries.size))) {
        this.fail("edit.path", "YAML insertion path has the wrong kind or index")
        return false
    }
    if (mapping && this.current.entryIndex(parent, part) >= 0) { this.fail("edit.exists",
        "YAML insertion key already exists"); return false }
    val emitted = yamlEditEmit(value, this.current.limits)
    if (!emitted.succeeded) { this.fail(emitted.error.code, emitted.error.message); return false }
    var text = emitted.text
    if (mapping) {
        val key = yamlEditEmit(part.key, this.current.limits)
        if (!key.succeeded) { this.fail(key.error.code, key.error.message); return false }
        text = this.current.newKeyText(parent, part.key, key.text) + ": " + text
    }
    val size = this.current.nodes[parent].entries.size
    val index = if (mapping) size else part.index
    val flow = this.current.nodes[parent].style == 7 || this.current.nodes[parent].style == 8
    if (flow) {
        if (index < size) {
            val begin = this.current.nodes[parent].entries[index].begin
            return this.patch(begin, begin, text + ", ")
        }
        val close = this.current.nodes[parent].end - 1
        var prefix = ""
        if (size > 0) prefix = if (this.current.nodes[parent].entries[size - 1].comma >=
            0) " " else ", "
        // A closing delimiter may be dedented. New content must be indented.
        val lineStart = yamlLineStart(this.current.source, close)
        var onlySpace = true
        var i = lineStart
        while (i < close) { if (!yamlSpace(this.current.source[i])) onlySpace = false; i += 1 }
        if (onlySpace) prefix = yamlSpaces(yamlLeadingIndent(this.current.source,
            this.current.nodes[parent].contentBegin) + 2) + prefix
        return this.patch(close, close, prefix + text)
    }
    val newline = yamlSourceNewline(this.current.source)
    val indent = this.current.nodes[parent].indent
    val marker = if (mapping) "" else "- "
    if (index < size) {
        val entry = this.current.nodes[parent].entries[index]
        val start = yamlLineStart(this.current.source, entry.begin)
        if (yamlIndentPrefix(this.current.source, entry.begin)) return this.patch(start, start,
            yamlSpaces(indent) + marker + text + newline)
        // First compact child (- a: b) keeps its outer prefix and moves the old
        // first child to an ordinary continuation line.
        return this.patch(entry.begin, entry.begin, marker + text + newline + yamlSpaces(indent))
    }
    val end = this.current.nodes[parent].end
    var prefix = ""
    if (end > 0 && !yamlBreak(this.current.source[end - 1])) prefix = newline
    val ending = if (end == this.current.source.size && end > 0 &&
        !yamlBreak(this.current.source[end - 1])) "" else newline
    this.patch(end, end, prefix + yamlSpaces(indent) + marker + text + ending)
}
fun YamlEditor.guardAncestors(path: array<YamlPathPart>, count: int): bool {
    var id = this.current.root
    var i = 0
    while (i <= count) {
        if (this.current.nodes[id].anchor != "" && this.current.nodes[id].aliasUses > 0) {
            this.fail("edit.anchor", "Cannot change a YAML anchor definition with live aliases",
                this.current.nodes[id].begin)
            return false
        }
        if (i == count) break
        val entry = this.current.entryIndex(id, path[i])
        if (entry < 0) return false
        id = this.current.nodes[id].entries[entry].value
        i += 1
    }
    true
}
fun YamlEditor.set(path: array<YamlPathPart>, value: Yaml): bool {
    if (!this.ready()) return false
    if (path.size == 0) {
        if (!this.replace(this.current.root, value)) return false
        return this.verify(path, value)
    }
    val parent = this.resolve(path, path.size - 1)
    if (parent < 0) return false
    if (this.current.nodes[parent].aliasTarget >= 0) { this.fail("edit.alias",
        "Materialize the YAML alias before editing through it"); return false }
    val part = path[path.size - 1]
    val index = this.current.entryIndex(parent, part)
    if (index >= 0) {
        if (yamlSame(this.current.nodes[this.current.nodes[parent].entries[index].value].value,
            value, this.current.limits)) return true
        if (!this.guardAncestors(path, path.size - 1)) return false
        if (!this.replace(this.current.nodes[parent].entries[index].value, value)) return false
    } else {
        if (!this.guardAncestors(path, path.size - 1)) return false
        if (part.indexed) { this.fail("edit.path",
            "YAML set requires an existing sequence index"); return false }
        if (!this.insertInto(parent, part, value)) return false
    }
    this.verify(path, value)
}
fun YamlEditor.insert(path: array<YamlPathPart>, value: Yaml): bool {
    if (!this.ready()) return false
    if (path.size == 0) { this.fail("edit.path",
        "YAML insert requires a mapping key or sequence index"); return false }
    val parent = this.resolve(path, path.size - 1)
    if (parent < 0 || !this.guardAncestors(path, path.size - 1)) return false
    if (!this.insertInto(parent, path[path.size - 1], value)) return false
    this.verify(path, value)
}
fun YamlEditor.remove(path: array<YamlPathPart>): bool {
    if (!this.ready()) return false
    if (path.size == 0) { this.fail("edit.path",
        "Use set to replace the YAML document root"); return false }
    val parent = this.resolve(path, path.size - 1)
    if (parent < 0) return false
    if (this.current.nodes[parent].aliasTarget >= 0) { this.fail("edit.alias",
        "Materialize the YAML alias before editing through it"); return false }
    val index = this.current.entryIndex(parent, path[path.size - 1])
    if (index < 0) { this.fail("edit.path", "YAML removal path does not exist"); return false }
    if (!this.guardAncestors(path, path.size - 1)) return false
    val entry = this.current.nodes[parent].entries[index]
    if (this.current.protectedAnchor(entry.value) || (entry.key >= 0 &&
        this.current.protectedAnchor(entry.key))) {
        this.fail("edit.anchor", "Cannot remove a YAML anchor definition with live aliases",
            entry.begin)
        return false
    }
    val flow = this.current.nodes[parent].style == 7 || this.current.nodes[parent].style == 8
    if (flow) {
        if (entry.comma >= 0) {
            val gap = this.current.source.slice(entry.end, entry.comma)
            return this.patch(entry.begin, entry.comma + 1, gap)
        }
        if (index > 0) {
            val previous = this.current.nodes[parent].entries[index - 1].comma
            val gap = this.current.source.slice(previous + 1, entry.begin)
            return this.patch(previous, entry.end, gap)
        }
        return this.patch(entry.begin, entry.end, "")
    }
    val size = this.current.nodes[parent].entries.size
    if (size == 1) {
        var empty = this.current.inlineIndent(parent) +
            (if (this.current.nodes[parent].value.kind == 5) "{}" else "[]")
        val end = this.current.nodes[parent].end
        if (end > 0 && yamlBreak(this.current.source[end - 1])) empty +=
            yamlSourceNewline(this.current.source)
        return this.patch(this.current.nodes[parent].contentBegin, end, empty)
    }
    val start = yamlLineStart(this.current.source, entry.begin)
    var begin = entry.begin
    if (yamlIndentPrefix(this.current.source, entry.begin)) begin = start
    else if (index == 0) {
        // Keep the compact collection's outer prefix and promote the next item.
        return this.patch(entry.begin, entry.end, yamlSourceNewline(this.current.source))
    }
    this.patch(begin, entry.end, "")
}
fun YamlEditor.materialize(path: array<YamlPathPart>): bool {
    val id = this.resolve(path, path.size)
    if (id < 0) return false
    if (!this.guardAncestors(path, path.size)) return false
    if (this.current.nodes[id].aliasTarget < 0) { this.fail("edit.alias",
        "YAML materialize requires an alias occurrence"); return false }
    val value = yamlCopy(this.current.nodes[id].value)
    val encoded = yamlEditEmit(value, this.current.limits)
    if (!encoded.succeeded) { this.fail(encoded.error.code, encoded.error.message); return false }
    if (!this.patch(this.current.nodes[id].contentBegin, this.current.nodes[id].end,
        encoded.text)) return false
    this.verify(path, value)
}
