// f64 as text and back: the shortest decimal that reads back as exactly the value,
// written the way JavaScript's Number#toString writes it (f64Text), and decimal text
// read as the nearest f64 the way Number() and JSON.parse read it (f64Parse), so text a
// program reads and writes matches what JavaScript does with it.

import "abla/float"

/** `value` as the shortest decimal that reads back as exactly it, written the way
 *  JavaScript's Number#toString writes it: "0.1", "100", "1.5e-7", "1e+21", "-0.25";
 *  NaN, "Infinity", "-Infinity", and "0" for both zeros. */
fun f64Text(value: f64): string {
    if (value != value) return "NaN"
    val bits = f64ToBits(value)
    val negative = bits < 0
    val exponentBits = (bits >> 52) & 2047
    val fractionBits = bits & 4503599627370495
    if (exponentBits == 2047) return if (negative) "-Infinity" else "Infinity"
    if (exponentBits == 0 && fractionBits == 0) return "0"
    // A whole number below 2^53 is its integer.
    val whole = f64ToInt(value)
    if (f64FromInt(whole) == value && whole < 9007199254740992 && whole > -9007199254740992) return "$whole"
    // A short decimal: the fewest decimals k whose integer N = |value|·10^k (below 2^53)
    // reads back as exactly the value, when no other k-decimal integer does — then N's
    // digits are the shortest that round-trip and the nearest, which is what JavaScript
    // writes. One exact IEEE division checks each candidate, so no big integers.
    val magnitude = if (negative) 0.0 - value else value
    if (magnitude >= 0.000001 && magnitude < 1000000000000000000000.0) {
        val short = f64TextShort(magnitude)
        if (short != "") return if (negative) "-$short" else short
    }
    val digits = f64TextDigits(exponentBits, fractionBits)
    // digits[0] is the decimal point's position n (value = 0.d1d2… × 10^n); the rest the digits.
    val n = digits[0]
    var text = ""
    for (i in 1 until digits.size) text = "$text${digits[i]}"
    val count = digits.size - 1
    val sign = if (negative) "-" else ""
    if (count <= n && n <= 21) {
        var zeros = ""
        for (i in 0 until n - count) zeros = "${zeros}0"
        return "$sign$text$zeros"
    }
    if (0 < n && n <= 21) return "$sign${text.slice(0, n)}.${text.slice(n, count)}"
    if (-6 < n && n <= 0) {
        var zeros = ""
        for (i in 0 until 0 - n) zeros = "${zeros}0"
        return "${sign}0.$zeros$text"
    }
    val power = n - 1
    val mantissa = if (count == 1) text else "${text.slice(0, 1)}.${text.slice(1, count)}"
    "$sign${mantissa}e${if (power < 0) "-" else "+"}${if (power < 0) 0 - power else power}"
}

/** |value| (1e-6 <= value < 1e21) as its shortest decimal when a small k finds it, else "". */
fun f64TextShort(value: f64): string {
    var k = 1
    while (k <= 22) {
        val scaled = value * F64_PARSE_TENS[k]
        if (scaled >= 9007199254740992.0) return ""
        val n = f64ToInt(scaled + 0.5)
        val ten = F64_PARSE_TENS[k]
        if (f64FromInt(n) / ten == value) {
            if (f64FromInt(n - 1) / ten == value || f64FromInt(n + 1) / ten == value) return ""
            val digits = "$n"
            val point = digits.size - k
            if (point > 0) return "${digits.slice(0, point)}.${digits.slice(point, digits.size)}"
            var zeros = ""
            for (z in 0 until 0 - point) zeros = "${zeros}0"
            return "0.$zeros$digits"
        }
        k += 1
    }
    ""
}

// The shortest digits (Steele & White / Burger & Dybvig's free-format algorithm on exact
// big integers): [the point's position, digit, digit, …].
fun f64TextDigits(exponentBits: int, fractionBits: int): array<int> {
    val f = if (exponentBits == 0) fractionBits else fractionBits + 4503599627370496
    val e = if (exponentBits == 0) -1074 else exponentBits - 1075
    // The bounds are halfway to the neighbours; at a power of two the one below is closer.
    val unequal = exponentBits > 1 && fractionBits == 0
    var r: array<int> = []
    var s: array<int> = []
    var mPlus: array<int> = []
    var mMinus: array<int> = []
    if (e >= 0) {
        if (!unequal) {
            r = f64BigShift(f64BigOf(f), e + 1)
            s = f64BigOf(2)
            mPlus = f64BigShift(f64BigOf(1), e)
            mMinus = f64BigShift(f64BigOf(1), e)
        } else {
            r = f64BigShift(f64BigOf(f), e + 2)
            s = f64BigOf(4)
            mPlus = f64BigShift(f64BigOf(1), e + 1)
            mMinus = f64BigShift(f64BigOf(1), e)
        }
    } else {
        if (!unequal) {
            r = f64BigOf(f * 2)
            s = f64BigShift(f64BigOf(1), 1 - e)
            mPlus = f64BigOf(1)
            mMinus = f64BigOf(1)
        } else {
            r = f64BigOf(f * 4)
            s = f64BigShift(f64BigOf(1), 2 - e)
            mPlus = f64BigOf(2)
            mMinus = f64BigOf(1)
        }
    }
    // An even significand may land on its bounds (round half to even reads back to it).
    val even = (f & 1) == 0
    // The point's position: start from log10 of the binary exponent, then settle it.
    var bitLength = 0
    var probe = f
    while (probe > 0) {
        bitLength += 1
        probe = probe >> 1
    }
    var k = ((e + bitLength - 1) * 315653) >> 20
    if (k >= 0) s = f64BigTimesTen(s, k)
    else {
        r = f64BigTimesTen(r, 0 - k)
        mPlus = f64BigTimesTen(mPlus, 0 - k)
        mMinus = f64BigTimesTen(mMinus, 0 - k)
    }
    var settling = true
    while (settling) {
        val high = f64BigCompare(f64BigAdd(r, mPlus), s)
        if (high > 0 || (even && high == 0)) {
            s = f64BigTimesTen(s, 1)
            k += 1
        } else settling = false
    }
    settling = true
    while (settling) {
        val high = f64BigCompare(f64BigTimesTen(f64BigAdd(r, mPlus), 1), s)
        if (high < 0 || (!even && high == 0)) {
            r = f64BigTimesTen(r, 1)
            mPlus = f64BigTimesTen(mPlus, 1)
            mMinus = f64BigTimesTen(mMinus, 1)
            k -= 1
        } else settling = false
    }
    val out: array<int> = [k]
    var generating = true
    while (generating) {
        r = f64BigTimesTen(r, 1)
        mPlus = f64BigTimesTen(mPlus, 1)
        mMinus = f64BigTimesTen(mMinus, 1)
        var digit = 0
        while (f64BigCompare(r, s) >= 0) {
            r = f64BigSubtract(r, s)
            digit += 1
        }
        val low = f64BigCompare(r, mMinus)
        val high = f64BigCompare(f64BigAdd(r, mPlus), s)
        val tc1 = low < 0 || (even && low == 0)
        val tc2 = high > 0 || (even && high == 0)
        if (!tc1 && !tc2) out.append(digit)
        else {
            generating = false
            if (tc1 && !tc2) out.append(digit)
            else if (!tc1 && tc2) out.append(digit + 1)
            else {
                // Both ends reach: the nearer digit, the even one on a tie.
                val twice = f64BigCompare(f64BigShift(r, 1), s)
                out.append(if (twice < 0 || (twice == 0 && digit % 2 == 0)) digit else digit + 1)
            }
        }
    }
    out
}

// Little-endian base 2^32 naturals.

fun f64BigOf(value: int): array<int> {
    val out: array<int> = []
    var v = value
    while (v > 0) {
        out.append(v & 4294967295)
        v = v >> 32
    }
    out
}

fun f64BigShift(value: array<int>, bits: int): array<int> {
    val out: array<int> = []
    for (i in 0 until bits / 32) out.append(0)
    val shift = bits % 32
    var carry = 0
    for (limb in value) {
        out.append(((limb << shift) & 4294967295) | carry)
        carry = if (shift == 0) 0 else limb >> (32 - shift)
    }
    if (carry > 0) out.append(carry)
    out
}

fun f64BigTimesTen(value: array<int>, times: int): array<int> {
    val out: array<int> = []
    for (limb in value) out.append(limb)
    for (t in 0 until times) {
        var carry = 0
        for (i in 0 until out.size) {
            val product = out[i] * 10 + carry
            out[i] = product & 4294967295
            carry = product >> 32
        }
        if (carry > 0) out.append(carry)
    }
    out
}

fun f64BigAdd(a: array<int>, b: array<int>): array<int> {
    val out: array<int> = []
    var carry = 0
    var i = 0
    while (i < a.size || i < b.size || carry > 0) {
        val sum = (if (i < a.size) a[i] else 0) + (if (i < b.size) b[i] else 0) + carry
        out.append(sum & 4294967295)
        carry = sum >> 32
        i += 1
    }
    out
}

/** a - b, for a >= b. */
fun f64BigSubtract(a: array<int>, b: array<int>): array<int> {
    val out: array<int> = []
    var borrow = 0
    for (i in 0 until a.size) {
        var difference = a[i] - (if (i < b.size) b[i] else 0) - borrow
        borrow = 0
        if (difference < 0) {
            difference += 4294967296
            borrow = 1
        }
        out.append(difference)
    }
    var size = out.size
    while (size > 0 && out[size - 1] == 0) size -= 1
    if (size == out.size) return out
    val trimmed: array<int> = []
    for (i in 0 until size) trimmed.append(out[i])
    trimmed
}

fun f64BigCompare(a: array<int>, b: array<int>): int {
    var sa = a.size
    while (sa > 0 && a[sa - 1] == 0) sa -= 1
    var sb = b.size
    while (sb > 0 && b[sb - 1] == 0) sb -= 1
    if (sa != sb) return if (sa < sb) -1 else 1
    var i = sa - 1
    while (i >= 0) {
        if (a[i] != b[i]) return if (a[i] < b[i]) -1 else 1
        i -= 1
    }
    0
}

/** The decimal number in `text` as the nearest f64 (round half to even), the way
 *  JavaScript's Number() and JSON.parse read it: "0.1", "-12", "1.5e-7", "1E+21",
 *  ".5", "5."; "Infinity" and "-Infinity"; NaN for anything else (and for "NaN"). */
fun f64Parse(text: string): f64 = f64ParseRange(text, 0, text.size)

/** f64Parse of text[begin, end), without copying it. Up to 18 significant digits scaled
 *  by 10^±22 (any JSON a program writes: coordinates, angles, money) read without
 *  allocating; anything longer or farther out is read exactly on big integers. */
fun f64ParseRange(text: string, begin: int, end: int): f64 {
    var i = begin
    var negative = false
    if (i < end && (text[i] == 45 || text[i] == 43)) {
        negative = text[i] == 45
        i += 1
    }
    if (end - i == 8 && text[i] == 73 && text.slice(i, end) == "Infinity") return if (negative) -1.0 / 0.0 else 1.0 / 0.0
    // The significant digits as an integer (while they fit 18), how many there are, and the
    // power of ten they scale by.
    var m = 0
    var count = 0
    var exponent = 0
    var seen = false
    while (i < end && text[i] >= 48 && text[i] <= 57) {
        if (count > 0 || text[i] != 48) {
            if (count < 18) m = m * 10 + text[i] - 48
            count += 1
        }
        seen = true
        i += 1
    }
    if (i < end && text[i] == 46) {
        i += 1
        while (i < end && text[i] >= 48 && text[i] <= 57) {
            if (count > 0 || text[i] != 48) {
                if (count < 18) m = m * 10 + text[i] - 48
                count += 1
            }
            exponent -= 1
            seen = true
            i += 1
        }
    }
    if (!seen) return 0.0 / 0.0
    if (i < end && (text[i] == 101 || text[i] == 69)) {
        i += 1
        var exponentNegative = false
        if (i < end && (text[i] == 45 || text[i] == 43)) {
            exponentNegative = text[i] == 45
            i += 1
        }
        if (i >= end || text[i] < 48 || text[i] > 57) return 0.0 / 0.0
        var e = 0
        while (i < end && text[i] >= 48 && text[i] <= 57) {
            if (e < 100000) e = e * 10 + text[i] - 48
            i += 1
        }
        exponent += if (exponentNegative) 0 - e else e
    }
    if (i != end) return 0.0 / 0.0
    var magnitude = 0.0
    if (count > 0 && count <= 18) {
        // Trailing zeros carry no precision: fold them into the exponent.
        while (m % 10 == 0) {
            m = m / 10
            exponent += 1
        }
        if (exponent >= 0 && exponent <= 22 && m < 9007199254740992) magnitude = f64FromInt(m) * F64_PARSE_TENS[exponent]
        else if (exponent < 0 && exponent >= -22) magnitude = f64ParseQuotient(m, 0 - exponent)
        else magnitude = f64ParseExact(text, begin, end)
    } else if (count > 18) magnitude = f64ParseExact(text, begin, end)
    if (negative) f64FromBits(f64ToBits(magnitude) | (1 << 63)) else magnitude
}

/** m / 10^k correctly rounded (0 < m < 10^18, 1 <= k <= 22). Below 2^53 that is one exact
 *  IEEE division; above, the division lands within an ulp or so and the exact midpoints
 *  settle which neighbour the quotient rounds to. */
fun f64ParseQuotient(m: int, k: int): f64 {
    if (m < 9007199254740992) return f64FromInt(m) / F64_PARSE_TENS[k]
    var bits = f64ToBits(f64FromInt(m) / F64_PARSE_TENS[k])
    var steps = 0
    while (steps < 4) {
        val above = f64ParseMidpoint(m, k, bits) // the quotient vs the midpoint above `bits`
        val below = f64ParseMidpoint(m, k, bits - 1) // … and the one below
        if (above > 0 || (above == 0 && (bits & 1) == 1)) bits += 1
        else if (below < 0 || (below == 0 && (bits & 1) == 1)) bits -= 1
        else return f64FromBits(bits)
        steps += 1
    }
    f64FromBits(bits)
}

/** m / 10^k against the midpoint between the positive normal f64 `bits` and the next one
 *  up: -1 below, 0 on it, 1 above, exactly in 128-bit integers. With a = ma·2^ea the
 *  midpoint is (2ma + 1)·2^(ea - 1), so compare m·2^(1 - ea - k) with (2ma + 1)·5^k. */
fun f64ParseMidpoint(m: int, k: int, bits: int): int {
    val ma = (bits & 4503599627370495) | 4503599627370496
    val ea = ((bits >> 52) & 2047) - 1075
    val shift = 1 - ea - k
    // (2ma + 1)·5^k: a 64 × 64 → 128-bit product (it fits 106 bits).
    val p = u64(2 * ma + 1)
    val q = u64(F64_PARSE_FIVES[k])
    val mask = u64(4294967295)
    val p00 = (p & mask) * (q & mask)
    val p01 = (p & mask) * (q >>> 32)
    val p10 = (p >>> 32) * (q & mask)
    val p11 = (p >>> 32) * (q >>> 32)
    val mid = (p00 >>> 32) + (p01 & mask) + (p10 & mask)
    var rlo = (p00 & mask) | (mid << 32)
    var rhi = p11 + (p01 >>> 32) + (p10 >>> 32) + (mid >>> 32)
    // m, shifted onto the same scale (whichever side the shift falls on).
    var llo = u64(m)
    var lhi = u64(0)
    if (shift > 0) {
        if (shift >= 64) {
            lhi = llo << (shift - 64)
            llo = u64(0)
        } else {
            lhi = llo >>> (64 - shift)
            llo = llo << shift
        }
    } else if (shift < 0) {
        val t = 0 - shift
        if (t >= 64) {
            rhi = rlo << (t - 64)
            rlo = u64(0)
        } else {
            rhi = (rhi << t) | (rlo >>> (64 - t))
            rlo = rlo << t
        }
    }
    if (lhi != rhi) return if (lhi < rhi) -1 else 1
    if (llo != rlo) return if (llo < rlo) -1 else 1
    0
}

val F64_PARSE_FIVES: array<int> = [1, 5, 25, 125, 625, 3125, 15625, 78125, 390625, 1953125,
    9765625, 48828125, 244140625, 1220703125, 6103515625, 30517578125, 152587890625,
    762939453125, 3814697265625, 19073486328125, 95367431640625, 476837158203125,
    2384185791015625]

/** The exact reading of an already validated number: its digits on big integers. */
fun f64ParseExact(text: string, begin: int, end: int): f64 {
    var i = begin
    if (text[i] == 45 || text[i] == 43) i += 1
    val digits: array<int> = []
    var exponent = 0
    while (i < end && text[i] >= 48 && text[i] <= 57) {
        if (digits.size > 0 || text[i] != 48) digits.append(text[i] - 48)
        i += 1
    }
    if (i < end && text[i] == 46) {
        i += 1
        while (i < end && text[i] >= 48 && text[i] <= 57) {
            if (digits.size > 0 || text[i] != 48) digits.append(text[i] - 48)
            exponent -= 1
            i += 1
        }
    }
    if (i < end) {
        i += 1
        var exponentNegative = false
        if (text[i] == 45 || text[i] == 43) {
            exponentNegative = text[i] == 45
            i += 1
        }
        var e = 0
        while (i < end) {
            if (e < 100000) e = e * 10 + text[i] - 48
            i += 1
        }
        exponent += if (exponentNegative) 0 - e else e
    }
    var count = digits.size
    while (count > 0 && digits[count - 1] == 0) {
        count -= 1
        exponent += 1
    }
    if (count == 0) 0.0 else f64ParseDigits(digits, count, exponent)
}

val F64_PARSE_TENS: array<f64> = [1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0,
    100000000.0, 1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0,
    100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0,
    1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0,
    1000000000000000000000.0, 10000000000000000000000.0]

// digits[0, count) × 10^exponent (count >= 1, no leading or trailing zero digit).
fun f64ParseDigits(digits: array<int>, count: int, exponent: int): f64 {
    // Out of range either way, whatever the digits.
    if (count + exponent > 310) return 1.0 / 0.0
    if (count + exponent < -330) return 0.0
    // Exactly representable operands: one correctly rounded IEEE operation.
    if (count <= 15 && exponent >= -22 && exponent <= 22) {
        var whole = 0
        for (k in 0 until count) whole = whole * 10 + digits[k]
        val w = f64FromInt(whole)
        return if (exponent >= 0) w * F64_PARSE_TENS[exponent] else w / F64_PARSE_TENS[0 - exponent]
    }
    // Exactly, on big integers: the value is n / d.
    var n = f64BigOf(0)
    var chunk = 0
    var chunkDigits = 0
    for (k in 0 until count) {
        chunk = chunk * 10 + digits[k]
        chunkDigits += 1
        if (chunkDigits == 9 || k == count - 1) {
            n = f64BigAdd(f64BigTimesTen(n, chunkDigits), f64BigOf(chunk))
            chunk = 0
            chunkDigits = 0
        }
    }
    var d = f64BigOf(1)
    if (exponent >= 0) n = f64BigTimesTen(n, exponent)
    else d = f64BigTimesTen(d, 0 - exponent)
    // Scale by 2^k so the quotient has 54 bits: q = floor(n·2^k / d), 2^53 <= q < 2^54
    // (the bit lengths put it in (2^52, 2^54); one more bit when it lands below 2^53).
    var k = 53 - (f64BigBits(n) - f64BigBits(d))
    var top = if (k >= 0) f64BigShift(n, k) else n
    var bottom = if (k >= 0) d else f64BigShift(d, 0 - k)
    var q = f64BigQuotient(top, bottom)
    if (q < 9007199254740992) {
        k += 1
        top = if (k >= 0) f64BigShift(n, k) else n
        bottom = if (k >= 0) d else f64BigShift(d, 0 - k)
        q = f64BigQuotient(top, bottom)
    }
    val inexact = !f64BigDivides(top, bottom)
    // q·2^-k keeping 53 bits (fewer below 2^-1022: the lowest kept bit is at least 2^-1074),
    // rounded half to even.
    val drop = if (k - 1074 > 1) k - 1074 else 1
    if (drop > 55) return 0.0
    var out = q >> drop
    val dropped = q & ((1 << drop) - 1)
    val half = 1 << (drop - 1)
    if (dropped > half || (dropped == half && (inexact || (out & 1) == 1))) out += 1
    var scale = drop - k
    if (out >= 9007199254740992) {
        out = out >> 1
        scale += 1
    }
    if (scale > 971) return 1.0 / 0.0
    if (scale < -1022) return f64FromInt(out) * f64ParsePowerOfTwo(scale + 600) * f64ParsePowerOfTwo(-600)
    f64FromInt(out) * f64ParsePowerOfTwo(scale)
}

/** 2^p for a normal exponent (-1022..1023). */
fun f64ParsePowerOfTwo(p: int): f64 = f64FromBits((p + 1023) << 52)

fun f64BigBits(value: array<int>): int {
    var size = value.size
    while (size > 0 && value[size - 1] == 0) size -= 1
    if (size == 0) return 0
    var top = value[size - 1]
    var bits = (size - 1) * 32
    while (top > 0) {
        bits += 1
        top = top >> 1
    }
    bits
}

/** floor(a / b) for a quotient below 2^62. */
fun f64BigQuotient(a: array<int>, b: array<int>): int {
    var q = 0
    var rest = f64BigAdd(a, [])
    var bit = 62
    while (bit >= 0) {
        val shifted = f64BigShift(b, bit)
        if (f64BigCompare(shifted, rest) <= 0) {
            rest = f64BigSubtract(rest, shifted)
            q = q | (1 << bit)
        }
        bit -= 1
    }
    q
}

/** Whether b divides a (for a quotient below 2^62). */
fun f64BigDivides(a: array<int>, b: array<int>): bool {
    var rest = f64BigAdd(a, [])
    var bit = 62
    while (bit >= 0) {
        val shifted = f64BigShift(b, bit)
        if (f64BigCompare(shifted, rest) <= 0) rest = f64BigSubtract(rest, shifted)
        bit -= 1
    }
    f64BigCompare(rest, []) == 0
}
