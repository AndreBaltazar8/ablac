// Native floating-point bit representation without numerical conversion.

// Returns the unchanged f64 bit pattern as a signed 64-bit integer.
noescape extern:"intrinsic" fun ablaBitF64ToI64(value: f64): int
// Returns the f64 whose bit pattern is the 64 bits of `value`.
noescape extern:"intrinsic" fun ablaBitI64ToF64(value: int): f64
// Returns the nearest f64 to the signed integer `value`, rounding ties to even.
noescape extern:"intrinsic" fun ablaConvertI64ToF64(value: int): f64
// Returns the f32 bit pattern in the low 32 bits of the result with zeros in the high bits.
noescape extern:"intrinsic" fun ablaBitF32ToI32(value: f32): int
// Returns the f32 whose bit pattern is the low 32 bits of `value`.
noescape extern:"intrinsic" fun ablaBitI32ToF32(value: int): f32
// Returns the nearest f32 to the unsigned integer `value`, rounding ties to even.
noescape extern:"intrinsic" fun ablaConvertU32ToF32(value: u32): f32
// Returns the nearest f32 to the signed integer `value`, rounding ties to even.
noescape extern:"intrinsic" fun ablaConvertI32ToF32(value: i32): f32
// Returns `value` truncated toward zero and clamped to the u32 range, with NaN returning zero.
noescape extern:"intrinsic" fun ablaConvertF32ToU32(value: f32): u32
// Returns `value` truncated toward zero and clamped to the i32 range, with NaN returning zero.
noescape extern:"intrinsic" fun ablaConvertF32ToI32(value: f32): i32
// Returns `value` rounded to f32 with ties to even, producing signed infinity on overflow.
noescape extern:"intrinsic" fun ablaConvertF64ToF32(value: f64): f32
// Returns `value` widened to f64, preserving every finite value exactly.
noescape extern:"intrinsic" fun ablaConvertF32ToF64(value: f32): f64
// Returns `value` truncated toward zero and clamped to the int range, with NaN returning zero.
noescape extern:"intrinsic" fun ablaConvertF64ToI64(value: f64): int

// Returns the unchanged bit pattern of `value` as a signed 64-bit integer.
fun f64ToBits(value: f64): int = ablaBitF64ToI64(value)

// Interprets the 64 bits of `value` as an f64, without numeric conversion.
fun f64FromBits(value: int): f64 = ablaBitI64ToF64(value)

// Converts `value` to the nearest f64, rounding ties to even.
fun f64FromInt(value: int): f64 = ablaConvertI64ToF64(value)

// Returns the unchanged bit pattern of `value` as an unsigned 32-bit integer.
fun f32ToBits(value: f32): u32 = u32(ablaBitF32ToI32(value))

// Interprets the 32 bits of `value` as an f32, without numeric conversion.
fun f32FromBits(value: u32): f32 = ablaBitI32ToF32(int(value))

// Converts unsigned `value` to the nearest f32, rounding ties to even.
fun f32FromU32(value: u32): f32 = ablaConvertU32ToF32(value)

// Converts signed `value` to the nearest f32, rounding ties to even.
fun f32FromI32(value: i32): f32 = ablaConvertI32ToF32(value)

// Truncates `value` toward zero and saturates to the u32 range. NaN yields zero.
fun f32ToU32(value: f32): u32 = ablaConvertF32ToU32(value)

// Truncates `value` toward zero and saturates to the i32 range. NaN yields zero.
fun f32ToI32(value: f32): i32 = ablaConvertF32ToI32(value)

/** The f32 nearest `value` (ties to even). Past 2^53 an f64 can't hold it, and
 *  rounding twice would be wrong by one unit: the low bits are kept as one
 *  sticky bit, which makes the f64 exact enough for the f32's rounding. */
fun f32FromInt(value: int): f32 {
    val bound = 9007199254740992
    if (value > -bound && value < bound) return ablaConvertF64ToF32(ablaConvertI64ToF64(value))
    val sticky = if ((value & 2047) != 0) 1 else 0
    ablaConvertF64ToF32(ablaConvertI64ToF64((value >> 11) | sticky) * 2048.0)
}

/** Toward zero and saturating, like f64ToInt; NaN gives 0. */
fun f32ToInt(value: f32): int = ablaConvertF64ToI64(ablaConvertF32ToF64(value))

/** Narrow to the nearest f32 (round to nearest even), e.g. for GPU buffers. */
fun f64ToF32(value: f64): f32 = ablaConvertF64ToF32(value)

/** Widen exactly. */
fun f32ToF64(value: f32): f64 = ablaConvertF32ToF64(value)

/** Truncate toward zero, saturating on every target: NaN -> 0, and values
 *  beyond the int range clamp to its ends (Wasm i64.trunc_sat semantics). */
fun f64ToInt(value: f64): int = ablaConvertF64ToI64(value)
