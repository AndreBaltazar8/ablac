// Phase-safe tree and compile-time `$html` parser provider.
// Kinds: 0 missing, 1 element, 2 dynamic/text node.

import "abla/compiler/parser"

class Html(
    val kind: int,
    val tag: string,
    val text: string,
    val children: array<Html>
)

compile fun ablaHtmlUnarySyntaxCall(
    name: string,
    value: SyntaxExpression
): SyntaxExpression {
    val arguments: array<SyntaxExpression> = []
    arguments.append(value)
    syntaxCall(name, arguments)
}

compile fun ablaHtmlParse(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "<")
    val tag = parserRawTakeName(cursor)
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, ">")

    val children: array<SyntaxExpression> = []
    var closed = false
    while (!closed) {
        if (parserRawEnd(cursor)) {
            closed = true
            parserFail(cursor, "unterminated HTML element")
        } else if (parserRawAt(cursor, "</")) {
            closed = true
            parserRawSkipWhitespace(cursor)
        } else if (parserRawAt(cursor, "<")) {
            children.append(ablaHtmlParse(cursor))
        } else if (parserRawAt(cursor, "{")) {
            parserRawExpect(cursor, "{")
            val value = parserParseAblaExpression(cursor)
            parserRawExpect(cursor, "}")
            children.append(ablaHtmlUnarySyntaxCall("ablaHtmlDynamic", value))
        } else {
            val value = parserRawTakeUntil(cursor, "<{")
            if (value != "") {
                children.append(
                    ablaHtmlUnarySyntaxCall("ablaHtmlText", syntaxString(value))
                )
            }
        }
    }

    parserRawExpect(cursor, "</")
    val closingTag = parserRawTakeName(cursor)
    if (closingTag != tag) {
        parserFail(cursor, "closing HTML tag does not match opening tag")
    }
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, ">")

    val arguments: array<SyntaxExpression> = []
    arguments.append(syntaxString(tag))
    arguments.append(syntaxArray(children))
    syntaxCall("ablaHtmlElement", arguments)
}

#compilerRegisterSubparser("html", ablaHtmlParse)

fun ablaHtmlEmpty(): Html = Html(0, "", "", [])

fun ablaHtmlElement(tag: string, children: array<Html>): Html =
    Html(1, tag, "", children)

fun ablaHtmlText(value: string): Html = Html(2, "", value, [])

fun ablaHtmlDynamic(value: any): Html = Html(2, "", "$value", [])

fun Html.querySelector(tag: string): Html {
    var result = ablaHtmlEmpty()
    if (this.tag == tag) result = this
    var index = 0
    while (index < this.children.size) {
        val found = this.children[index].querySelector(tag)
        if (result.tag == "" && found.tag != "") result = found
        index = index + 1
    }
    result
}
