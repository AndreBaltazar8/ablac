// Phase-safe tree and compile-time $html parser provider.

import "abla/bytes"
import "abla/compiler/parser"
import "abla/text"

/// An attribute in rendering order. A null value represents a bare attribute. One that skipsPolicy (ablaHtmlTrustedAttribute) is not held to the URL and event-handler policy.
class HtmlAttribute(val name: string, val value: string?, val sourceQuote: string = "", val skipsPolicy: bool = false)

/// A phase-safe node. Kind 0 is missing, 1 is an element, 2 is text, and 3 is explicit raw markup.
class Html(
    val kind: int,
    val tag: string,
    val text: string,
    val children: array<Html>,
    val attributes: array<HtmlAttribute> = [],
    val selfClosing: bool = false,
    val literalText: bool = false
)

private fun ablaHtmlNameValid(name: string, attribute: bool): bool {
    if (name == "") return false
    val first = name[0]
    if (!attribute && !(first >= 65 && first <= 90) && !(first >= 97 && first <= 122)) return false
    for (b in name) {
        if (!(b >= 65 && b <= 90) && !(b >= 97 && b <= 122) &&
            !(b >= 48 && b <= 57) && b != 45 && b != 46 && b != 58 && b != 95) return false
    }
    true
}

private fun ablaHtmlVoid(tag: string): bool = when (tag) {
    "area", "base", "br", "col", "embed", "hr", "img", "input",
    "link", "meta", "param", "source", "track", "wbr" -> true
    else -> false
}

/// Whether a lowercase attribute name takes a URL that a browser follows or loads (href, src, action, formaction and the like).
fun ablaHtmlUrlAttribute(name: string): bool = when (name) {
    "href", "src", "action", "formaction", "poster", "cite", "xlink:href", "background", "longdesc", "usemap", "codebase",
    "classid", "data", "manifest", "icon", "ping", "lowsrc", "dynsrc", "archive", "profile" -> true
    else -> false
}

/// Whether a lowercase attribute name is an event handler (on...), whose value runs as script.
fun ablaHtmlEventAttribute(name: string): bool = name.size > 2 && name[0] == 111 && name[1] == 110

/// The value written in place of a URL whose scheme runs script or carries a document.
val ablaHtmlUnsafeUrl = "about:invalid#abla-unsafe-url"

// One character reference at `at` (after its "&"): the decoded byte (only ASCII matters to a scheme) and where it ends, or -1.
private fun ablaHtmlReferenceByte(value: string, at: int): array<int> {
    if (at < value.size && value[at] == 35) {
        var i = at + 1
        val hex = i < value.size && (value[i] == 120 || value[i] == 88)
        if (hex) i = i + 1
        var code = 0
        val digits = i
        while (i < value.size && i - digits < 8) {
            val b = value[i]
            val digit = if (b >= 48 && b <= 57) b - 48
                else if (hex && b >= 97 && b <= 102) b - 87
                else if (hex && b >= 65 && b <= 70) b - 55
                else -1
            if (digit < 0) break
            code = code * (if (hex) 16 else 10) + digit
            i = i + 1
        }
        if (i == digits) return [-1, at]
        if (i < value.size && value[i] == 59) i = i + 1
        return [if (code < 128) code else 128, i]
    }
    for (named in [["colon;", "58"], ["tab;", "9"], ["newline;", "10"]]) {
        val name = named[0]
        if (at + name.size <= value.size && value.slice(at, at + name.size).lowercase() == name) return [ablaHtmlDecimal(named[1]), at + name.size]
    }
    [-1, at]
}

private fun ablaHtmlDecimal(text: string): int {
    var value = 0
    for (b in text) value = value * 10 + b - 48
    value
}

/// `value` if it is safe in a URL attribute, else ablaHtmlUnsafeUrl: its scheme, read as a browser does (character references decoded,
/// whitespace and control characters anywhere dropped, any case), must not be javascript:, vbscript: or data:.
fun ablaHtmlSafeUrl(value: string): string {
    // The scheme so far, lowercase; any byte but a letter is "_" (no refused scheme has one).
    var scheme = ""
    val letters = "abcdefghijklmnopqrstuvwxyz"
    var i = 0
    var length = 0
    while (i < value.size && length < 16) {
        var b = value[i]
        i = i + 1
        if (b == 38) {
            val decoded = ablaHtmlReferenceByte(value, i)
            if (decoded[0] >= 0) { b = decoded[0]; i = decoded[1] }
        }
        if (b <= 32 || b == 127) continue
        if (b == 58) return if (scheme == "javascript" || scheme == "vbscript" || scheme == "data") ablaHtmlUnsafeUrl else value
        if (b == 47 || b == 63 || b == 35) return value
        val lower = if (b >= 65 && b <= 90) b + 32 else b
        scheme = if (lower >= 97 && lower <= 122) "$scheme${letters.slice(lower - 97, lower - 96)}" else "${scheme}_"
        length = length + 1
    }
    value
}

private fun ablaHtmlRawText(tag: string): bool = when (tag) {
    "script", "style", "xmp", "iframe", "noembed", "noframes", "noscript", "plaintext" -> true
    else -> false
}

/// Builds an Abla call expression with the supplied name and one argument.
compile fun ablaHtmlUnarySyntaxCall(name: string, value: SyntaxExpression): SyntaxExpression =
    syntaxCall(name, [value])

private compile fun ablaHtmlSkipSpace(cursor: ParserCursor): bool {
    val start = parserRawPosition(cursor)
    parserRawSkipWhitespace(cursor)
    parserRawPosition(cursor) > start
}

private compile fun ablaHtmlTakeName(cursor: ParserCursor): string =
    parserRawTakeUntil(cursor, " \t\r\n=/>{}<\"'")

private compile fun ablaHtmlReadHole(cursor: ParserCursor): SyntaxExpression {
    val value = parserParseAblaExpression(cursor)
    parserRawExpect(cursor, "}")
    value
}

private compile fun ablaHtmlReject(cursor: ParserCursor, message: string): SyntaxExpression {
    parserFail(cursor, message)
    syntaxCall("ablaHtmlEmpty", [])
}

/// Lowers a literal element and reports malformed attributes, tags and children.
compile fun ablaHtmlParse(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    ablaHtmlParseElement(cursor, 0, false)
}

private compile fun ablaHtmlParseElement(cursor: ParserCursor, depth: int, insideForeign: bool): SyntaxExpression {
    if (depth >= 256) return ablaHtmlReject(cursor, "HTML literal exceeds 256 nested elements")
    parserRawExpect(cursor, "<")
    val tag = ablaHtmlTakeName(cursor)
    if (!ablaHtmlNameValid(tag, false)) return ablaHtmlReject(cursor, "expected an HTML tag name")
    val lower = tag.lowercase()
    val foreign = insideForeign || lower == "svg" || lower == "math"
    val voidElement = !foreign && ablaHtmlVoid(lower)

    val groups: array<SyntaxExpression> = []
    val names: array<string> = []
    var separated = ablaHtmlSkipSpace(cursor)
    while (!parserRawAt(cursor, ">") && !parserRawAt(cursor, "/>")) {
        if (!separated || parserRawEnd(cursor)) return ablaHtmlReject(cursor, "expected a space or the end of an HTML start tag")
        if (parserRawConsume(cursor, "{")) {
            groups.append(ablaHtmlReadHole(cursor))
            separated = ablaHtmlSkipSpace(cursor)
        } else {
            val name = ablaHtmlTakeName(cursor)
            if (!ablaHtmlNameValid(name, true)) return ablaHtmlReject(cursor, "expected an HTML attribute name")
            val key = name.lowercase()
            for (previous in names) if (key == previous) return ablaHtmlReject(cursor, "duplicate HTML attribute")
            names.append(key)
            separated = ablaHtmlSkipSpace(cursor)
            val attrName = syntaxString(name)
            val attribute = if (!parserRawConsume(cursor, "=")) {
                ablaHtmlUnarySyntaxCall("ablaHtmlBooleanAttribute", attrName)
            } else {
                parserRawSkipWhitespace(cursor)
                val value = if (parserRawConsume(cursor, "{")) {
                    if (ablaHtmlEventAttribute(key)) return ablaHtmlReject(cursor, "an Abla expression cannot fill the event handler attribute $name: its value runs as script (for a handler the program wrote, put ablaHtmlTrustedAttribute(\"$name\", code) in an attribute group)")
                    syntaxCall("ablaHtmlAttribute", [attrName, ablaHtmlReadHole(cursor)])
                } else {
                    val quote = if (parserRawConsume(cursor, "\"")) "\"" else if (parserRawConsume(cursor, "'")) "'" else ""
                    if (quote == "") return ablaHtmlReject(cursor, "expected a quoted HTML attribute or an Abla expression in braces")
                    val value = parserRawTakeUntil(cursor, quote)
                    if (!parserRawConsume(cursor, quote)) return ablaHtmlReject(cursor, "unterminated HTML attribute")
                    syntaxCall("ablaHtmlLiteralAttribute", [attrName, syntaxString(value), syntaxString(quote)])
                }
                separated = ablaHtmlSkipSpace(cursor)
                value
            }
            groups.append(syntaxArray([attribute]))
        }
    }

    val selfClosing = parserRawConsume(cursor, "/>")
    if (!selfClosing) parserRawExpect(cursor, ">")
    if (selfClosing && !voidElement && !foreign) return ablaHtmlReject(cursor, "only void and foreign HTML elements can self-close")
    val children: array<SyntaxExpression> = []
    if (!voidElement && !selfClosing) {
        while (!parserRawAt(cursor, "</")) {
            if (parserRawEnd(cursor)) return ablaHtmlReject(cursor, "unterminated HTML element")
            if (parserRawAt(cursor, "<")) {
                val begin = parserRawPosition(cursor)
                children.append(ablaHtmlParseElement(cursor, depth + 1, foreign))
                if (parserRawPosition(cursor) == begin) return syntaxCall("ablaHtmlEmpty", [])
            } else if (parserRawConsume(cursor, "{")) {
                children.append(ablaHtmlUnarySyntaxCall("ablaHtmlDynamic", ablaHtmlReadHole(cursor)))
            } else {
                val value = parserRawTakeUntil(cursor, "<{")
                children.append(ablaHtmlUnarySyntaxCall("ablaHtmlLiteralText", syntaxString(value)))
            }
        }
        parserRawExpect(cursor, "</")
        val closingTag = ablaHtmlTakeName(cursor)
        if (closingTag.lowercase() != lower) return ablaHtmlReject(cursor, "closing HTML tag does not match opening tag")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ">")
    }
    if (groups.size == 0 && !selfClosing) return syntaxCall("ablaHtmlElement", [syntaxString(tag), syntaxArray(children)])
    syntaxCall("ablaHtmlElementWithAttributes", [syntaxString(tag), syntaxArray(children), syntaxArray(groups), syntaxBoolean(selfClosing)])
}

/// Builds an Html tree from one element, with checked attributes and Abla expression holes.
#compilerRegisterSubparser("html", ablaHtmlParse)

/// Returns the kind 0 sentinel for a missing HTML node.
fun ablaHtmlEmpty(): Html = Html(0, "", "", [])

/// Creates an element node with the supplied children in order.
fun ablaHtmlElement(tag: string, children: array<Html>): Html = Html(1, tag, "", children)

/// Creates an element node and copies its attribute groups into one ordered list.
fun ablaHtmlElementWithAttributes(tag: string, children: array<Html>, groups: array<array<HtmlAttribute>>, selfClosing: bool = false): Html {
    val attributes: array<HtmlAttribute> = []
    for (group in groups) for (attribute in group) attributes.append(attribute)
    Html(1, tag, "", children, attributes, selfClosing)
}

/// Returns an attribute whose value is escaped on serialization. Invalid names are omitted when rendered.
fun ablaHtmlAttribute(name: string, value: string): HtmlAttribute = HtmlAttribute(name, value)

/// Returns an attribute that skips the URL and event-handler policy (its value is still escaped): the escape hatch for a URL with a scheme the
/// policy refuses, or an event handler. Pass only a value the program wrote or fully checked, never one a user supplied.
fun ablaHtmlTrustedAttribute(name: string, value: string): HtmlAttribute = HtmlAttribute(name, value, "", true)

/// Returns a bare attribute. Invalid names are omitted when rendered.
fun ablaHtmlBooleanAttribute(name: string): HtmlAttribute = HtmlAttribute(name, null)

/// Returns an authored attribute, retaining valid source quotes and character references on serialization.
fun ablaHtmlLiteralAttribute(name: string, value: string, quote: string): HtmlAttribute = HtmlAttribute(name, value, quote)

/// Returns a text node whose contents are escaped on serialization.
fun ablaHtmlText(value: string): Html = Html(2, "", value, [])

/// Returns authored text with character references retained and opening angle brackets escaped.
fun ablaHtmlLiteralText(value: string): Html = Html(2, "", value, [], [], false, true)

/// Returns trusted markup for verbatim insertion. Supply markup generated by a trusted renderer or authored in source.
fun ablaHtmlRaw(value: string): Html = Html(3, "", value, [])

/// Converts an Abla value to escaped HTML text through the normal interpolation conversion.
fun ablaHtmlDynamic(value: any): Html = ablaHtmlText("$value")

/// Returns an existing HTML subtree for insertion without converting it to text.
fun ablaHtmlDynamic(value: Html): Html = value

private fun ablaHtmlWriteEscaped(var output: ByteBuffer, value: string, preserveReferences: bool, sourceQuote: string): void {
    var start = 0
    for (i in 0 until value.size) {
        val byte = value[i]
        val replacement = if (byte == 60) "&lt;"
            else if (byte == 34 && (!preserveReferences || sourceQuote == "\"")) "&quot;"
            else if (byte == 39 && (!preserveReferences || sourceQuote == "'")) "&#39;"
            else if (byte == 38 && !preserveReferences) "&amp;"
            else if (byte == 62 && !preserveReferences) "&gt;"
            else ""
        if (replacement == "") continue
        if (i > start) output.appendText(value.slice(start, i))
        output.appendText(replacement)
        start = i + 1
    }
    if (start < value.size) output.appendText(value.slice(start, value.size))
    return
}

private fun ablaHtmlWriteAttribute(var output: ByteBuffer, attribute: HtmlAttribute): void {
    if (!ablaHtmlNameValid(attribute.name, true)) return
    // A value from Abla (a hole, or ablaHtmlAttribute) is held to the policy; authored and trusted ones are not. An event handler from Abla
    // is left out (a hole in one does not compile); a URL whose scheme runs script or carries a document is replaced.
    val dynamic = attribute.sourceQuote == "" && !attribute.skipsPolicy
    val key = attribute.name.lowercase()
    if (dynamic && attribute.value != null && ablaHtmlEventAttribute(key)) return
    output.appendText(" ")
    output.appendText(attribute.name)
    val written = attribute.value
    if (written == null) return
    val value = if (dynamic && ablaHtmlUrlAttribute(key)) ablaHtmlSafeUrl(written) else written
    val quote = if (attribute.sourceQuote == "'") "'" else "\""
    val preserve = attribute.sourceQuote == "'" || attribute.sourceQuote == "\""
    output.appendText("=")
    output.appendText(quote)
    ablaHtmlWriteEscaped(output, value, preserve, quote)
    output.appendText(quote)
    return
}

private fun ablaHtmlWriteNode(var output: ByteBuffer, node: Html, insideForeign: bool): void {
    if (node.kind == 2) {
        ablaHtmlWriteEscaped(output, node.text, node.literalText, "")
    } else if (node.kind == 3) output.appendText(node.text)
    else if (node.kind == 1 && ablaHtmlNameValid(node.tag, false)) {
        val lower = node.tag.lowercase()
        val foreign = insideForeign || lower == "svg" || lower == "math"
        output.appendText("<")
        output.appendText(node.tag)
        for (attribute in node.attributes) ablaHtmlWriteAttribute(output, attribute)
        if (foreign && node.selfClosing && node.children.size == 0) output.appendText("/>")
        else {
            output.appendText(">")
            if (foreign || !ablaHtmlVoid(lower)) {
                // Text in a raw-text element is written only as trusted markup (kind 3): escaping cannot make it safe there. A script or a style
                // runs inside svg and math too (an svg <script> executes; one under foreignObject is an HTML script again), so theirs is held to
                // the same rule there; the other raw-text elements only outside foreign content, where escaped text in them is inert.
                val rawText = ablaHtmlRawText(lower) && (!foreign || lower == "script" || lower == "style")
                for (child in node.children) {
                    if (!rawText || child.kind == 3) ablaHtmlWriteNode(output, child, foreign)
                }
                output.appendText("</")
                output.appendText(node.tag)
                output.appendText(">")
            }
        }
    }
    return
}

/// Serializes this tree as HTML text, escaping text and dynamic attribute values. Missing nodes and invalid element names render as empty text.
fun Html.render(): string {
    val output = byteBuffer()
    ablaHtmlWriteNode(output, this, false)
    output.toText()
}

/// Searches this tree in preorder for the first element whose tag exactly equals nonempty tag. Returns the missing-node sentinel if none matches.
fun Html.querySelector(tag: string): Html {
    var result = ablaHtmlEmpty()
    if (this.tag == tag) result = this
    var index = 0
    while (index < this.children.size) {
        val found = this.children[index].querySelector(tag)
        if (result.tag == "" && found.tag != "") result = found
        index = index + 1
    }
    result
}
