#import("abla/build")
#import("abla/compiler")

compile fun androidReplaceAll(
    source: string,
    expected: string,
    replacement: string
): string {
    var output = ""
    var segment = 0
    var index = 0
    while (index + expected.size <= source.size) {
        if (source.slice(index, index + expected.size) == expected) {
            output = "$output${source.slice(segment, index)}$replacement"
            index = index + expected.size
            segment = index
        } else index = index + 1
    }
    "$output${source.slice(segment, source.size)}"
}

compile fun androidArm64Target(): bool = defineTarget(
    "android-arm64",
    "aarch64-linux-android24",
    "elf",
    "lld-elf",
    "aarch64linux",
    false,
    false
)

compile fun androidGenerateIntegration(
    packageName: string,
    generatedRoot: string
): bool {
    val packagePath = androidReplaceAll(packageName, ".", "/")
    val jniPackage = androidReplaceAll(packageName, ".", "_")
    val header = "#ifndef ABLA_APP_H\n#define ABLA_APP_H\n#include <stdint.h>\nint64_t abla_app_answer(void);\n#endif\n"
    val jni = "#include <jni.h>\n#include \"abla-app.h\"\nJNIEXPORT jlong JNICALL Java_${jniPackage}_AblaApp_answer(JNIEnv *environment, jclass type) {\n    (void)environment;\n    (void)type;\n    return (jlong)abla_app_answer();\n}\n"
    val kotlin = "package $packageName\n\nobject AblaApp {\n    init { System.loadLibrary(\"abla_jni\") }\n    @JvmStatic external fun answer(): Long\n}\n"
    val cmake = "cmake_minimum_required(VERSION 3.22.1)\nproject(abla_jni C)\nadd_library(abla_app SHARED IMPORTED)\nset_target_properties(abla_app PROPERTIES\n    IMPORTED_LOCATION \${CMAKE_CURRENT_LIST_DIR}/../jniLibs/\${ANDROID_ABI}/libabla_app.so\n    IMPORTED_NO_SONAME TRUE\n)\nadd_library(abla_jni SHARED abla_jni.c)\ntarget_include_directories(abla_jni PRIVATE .)\ntarget_link_libraries(abla_jni PRIVATE abla_app)\n"
    val gradle = "android {\n    defaultConfig {\n        externalNativeBuild { cmake { } }\n    }\n    externalNativeBuild {\n        cmake { path = file(\"src/main/cpp/CMakeLists.txt\") }\n    }\n    sourceSets[\"main\"].jniLibs.srcDir(\"src/main/jniLibs\")\n}\n"
    var written = compilerWriteFile(
        "$generatedRoot/src/main/cpp/abla-app.h",
        header
    )
    if (written) written = compilerWriteFile(
        "$generatedRoot/src/main/cpp/abla_jni.c",
        jni
    )
    if (written) written = compilerWriteFile(
        "$generatedRoot/src/main/kotlin/$packagePath/AblaApp.kt",
        kotlin
    )
    if (written) written = compilerWriteFile(
        "$generatedRoot/src/main/cpp/CMakeLists.txt",
        cmake
    )
    if (written) written = compilerWriteFile(
        "$generatedRoot/abla.gradle.kts",
        gradle
    )
    written
}

compile fun androidBuildArm64Library(
    name: string,
    entry: string,
    generatedRoot: string,
    packageName: string,
    fast: bool,
    cache: bool
): bool {
    val target = androidArm64Target()
    val integration = androidGenerateIntegration(
        packageName,
        generatedRoot
    )
    val program = buildProgram(
        name,
        entry,
        "$generatedRoot/src/main/jniLibs/arm64-v8a/libabla_app.so",
        "android-arm64",
        "shared-library",
        fast,
        cache
    )
    target && integration && program
}
