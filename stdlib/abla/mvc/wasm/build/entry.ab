import "abla/compiler"
import "abla/wasm/build"

compile fun mvcGenerateWasmHostAdapter(generatedRoot: string): bool {
    val adapter = "export async function loadAblaMvc(url) {\n    const response = await fetch(url);\n    if (!response.ok) throw new Error(`Abla module request failed: \${response.status}`);\n    const bytes = await response.arrayBuffer();\n    const { instance } = await WebAssembly.instantiate(bytes, {});\n    const revision = instance.exports.abla_mvc_revision;\n    if (typeof revision !== \"function\") throw new Error(\"Missing abla_mvc_revision export\");\n    return Object.freeze({ revision: () => Number(revision()) });\n}\n"
    compilerWriteFile("$generatedRoot/abla-mvc.js", adapter)
}

compile fun mvcBuildWasmModule(
    name: string,
    entry: string,
    generatedRoot: string,
    fast: bool,
    cache: bool
): bool {
    val adapter = mvcGenerateWasmHostAdapter(generatedRoot)
    val module = wasmBuildModule(
        name,
        entry,
        "$generatedRoot/abla-mvc.wasm",
        fast,
        cache
    )
    adapter && module
}
