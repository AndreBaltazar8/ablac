// The 128- or 256-bit float (hi, the rest's sticky bit, p) rounded to the
// nearest double (pow.h's dint_tod and qint_tod).
fun __mathPowToDouble(hi: int, sticky: bool, p: int): f64 {
    val ex = p >> 1
    val sgn = p & 1
    if (ex < -1022) {
        // a subnormal result: the round bit is at 2^-1075
        val sh = -(1011 + ex)
        var bits = 0
        if (sh == 64) {
            if ((hi << 1) != 0 || sticky) bits = 1
        } else if (sh < 64) {
            bits = hi >>> sh
            val rb = (hi >>> (sh - 1)) & 1
            bits += if ((hi << (65 - sh)) != 0 || sticky) rb else bits & rb
        }
        return f64FromBits(bits | (sgn << 63))
    }
    var r = f64FromBits((hi >>> 11) | (0x3ff << 52) | (sgn << 63))
    var rd = 0.0
    if (((hi >>> 10) & 1) != 0) rd += f64FromBits(4368491638549381120)
    if ((hi & 0x3ff) != 0 || sticky) rd += f64FromBits(4363988038922010624)
    r += if (sgn == 1) -rd else rd
    if (ex > 1023) {
        if (ex == 1024) return r * 2.0 * f64FromBits(9214364837600034816)
        return r * f64FromBits(9218868437227405311) * 2.0
    }
