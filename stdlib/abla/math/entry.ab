fun __mathPow2(x: f64, e: int): f64 {
    if (e > 2046) return x * f64FromBits(9218868437227405311) * 2.0
    if (e < -2100) return x * 0.0
    val half = f64FromBits((((e >> 1) + 0x3ff) & 0x7ff) << 52)
    (if ((e & 1) != 0) x * 2.0 else x) * half * half
