// The largest odd m whose m^n fits in 53 bits, for 1 <= n <= 33.
fun __mathPowMaxBase(n: int): int = when (n) {
    1 -> -1
    2 -> 94906265
    3 -> 208063
    4 -> 9741
    5 -> 1551
    6 -> 455
    7 -> 189
    8 -> 97
    9 -> 59
    10 -> 39
    11 -> 27
    12 -> 21
    13 -> 15
    14 -> 13
    15 -> 11
    16 -> 9
    17 -> 7
    18 -> 7
    19 -> 5
    20 -> 5
    21 -> 5
    22 -> 5
    23 -> 4
    24 -> 3
    else -> if (n <= 33) 3 else 0
}

// Is x^y exact (and a double)? CORE-MATH's is_exact, for x > 0.
@noinline
fun __mathPowIsExact(x: f64, y: f64): bool {
    val v = f64ToBits(x)
    val w = f64ToBits(y)
    // |x| = 1, or the low 42 bits of y are zero
    if ((v << 1) == 0x7fe0000000000000) return true
    if ((w << 22) != 0) return false
    var m = v & 0xfffffffffffff
    var e = ((v << 1) >>> 53) - 0x433
    if (e >= -1074) m = m | (1 << 52) else e += 1
    val tm = __mathCtz(m)
    m = m >>> tm
    e += tm
    // |x| = m 2^e with m odd
    if (y >= 0.0 && __mathIsInt(y)) {
        if (y == 0.0 || y == 1.0) return true
        if (m == 1) return -1074.0 <= y * f64FromInt(e) && y * f64FromInt(e) < 1024.0
        if (y < 0.0 || 33.0 < y) return false
        val yi = f64ToInt(y)
        if (__mathULess(__mathPowMaxBase(yi), m)) return false
        // as CORE-MATH: the bits of m, not of m^y
        val ez = e * yi + 64 - __mathClz(m)
        if (ez <= -1074 || 1024 < ez) return false
        return e * yi >= -1074
    }
    var n = w & 0xfffffffffffff
    var f = ((w << 1) >>> 53) - 0x433
    if (f >= -1074) n = n | (1 << 52) else f += 1
    val tn = __mathCtz(n)
    n = n >>> tn
    f += tn
    // |y| = n 2^f with n odd
    if (y < 0.0) {
        // exact only for x = 2^e with n e 2^f an integer
        if (m != 1) return false
        var ez = 1024
        if (f >= 0) {
            if (f < 12) ez = (-n * e) << f
        } else {
            if (-f > __mathCtz(e)) return false
            ez = (-e >> (-f)) * n
        }
        return -1074 <= ez && ez < 1024
    }
    // y > 0 not an integer: x must be a (2^-f)-th power
    while (f != 0) {
        f += 1
        if ((e & 1) != 0) return false
        e = e / 2
        val dm = f64FromInt(m)
        val root = roundEven(sqrt(dm))
        if (root * root != dm) return false
        m = f64ToInt(root)
    }
    if (m > 1) {
        if (33 < n) return false
        if (m > __mathPowMaxBase(n)) return false
    }
    var my = m
    if (m > 1) {
        var n0 = n
        while (n0 > 1) {
            my = my * m
            n0 -= 1
        }
    }
    -1074 <= e * n && e * n + 64 - __mathClz(my) <= 1024
}

