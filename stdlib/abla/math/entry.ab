        var nv2 = 0
        var nv1 = 0
        var nv0 = 0
        var nvp = 0
        var nvk = 0
        while (nvk < parts) {
            val word = __mathQintMulAdd(v3, v2, v1, v0, vp, g3, g2, g1, g0, gp, v3, v2, v1, v0, vp, nvk)
            nv3 = nv2
            nv2 = nv1
            nv1 = nv0
            nv0 = nvp
            nvp = word
            nvk += 1
        }
        v3 = nv3
        v2 = nv2
        v1 = nv1
        v0 = nv0
        vp = nvp
        step += 1
    }
    val ah = __mathDintFrom(m - 1.0, 0)
    val ap = __mathDintFrom(m - 1.0, 2)
    var s3 = 0
    var s2 = 0
    var s1 = 0
    var s0 = 0
    var sp = 0
    var sk = 0
    while (sk < parts) {
        val word = __mathQintMulAdd(ah, 0, 0, 0, ap, v3, v2, v1, v0, vp, 0, 0, 0, 0, 0, sk)
        s3 = s2
        s2 = s1
        s1 = s0
        s0 = sp
        sp = word
        sk += 1
