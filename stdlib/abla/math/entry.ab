    val up6 = (((up >> 1) - 6) << 1) | (up & 1)
    var e3 = -9223372036854775808
    var e2 = 0
    var e1 = 0
    var e0 = 0
    var ep = 0
    var n = 24
    while (n >= 1) {
        var ud3 = 0
        var ud2 = 0
        var ud1 = 0
        var ud0 = 0
        var udp = 0
        var udk = 0
        while (udk < parts) {
            val word = __mathQintDivInt(u3, u2, u1, u0, up6, n, udk)
            ud3 = ud2
            ud2 = ud1
            ud1 = ud0
            ud0 = udp
            udp = word
