import "abla/float"

fun min(left: int, right: int): int = if (left < right) left else right

fun max(left: int, right: int): int = if (left > right) left else right

fun clamp(value: int, minimum: int, maximum: int): int {
    val lower = if (value < minimum) minimum else value
    if (lower > maximum) maximum else lower
}

// --- f64 ----------------------------------------------------------------------

noescape extern:"intrinsic" fun ablaF64Sqrt(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Floor(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Ceil(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Trunc(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Abs(value: f64): f64
noescape extern:"intrinsic" fun ablaF64RoundEven(value: f64): f64

// pi
val mathPi: f64 = f64FromBits(4614256656552045848)
// pi / 2
val mathHalfPi: f64 = f64FromBits(4609753056924675352)
// pi / 4
val mathQuarterPi: f64 = f64FromBits(4605249457297304856)
// 2 pi
val mathTau: f64 = f64FromBits(4618760256179416344)
// pi - mathPi
val __mathPiLo: f64 = f64FromBits(4368955796522032135)
// 2 / pi
val __mathInvPio2: f64 = f64FromBits(4603909380684499075)
// first 33 bits of pi/2
val __mathPio2_1: f64 = f64FromBits(4609753056924401664)
// pi/2 - __mathPio2_1
val __mathPio2_1t: f64 = f64FromBits(4454258360616903473)
// second 33 bits of pi/2
val __mathPio2_2: f64 = f64FromBits(4454258360616747008)
// pi/2 - (__mathPio2_1 + __mathPio2_2)
val __mathPio2_2t: f64 = f64FromBits(4297306550709743731)
// third 33 bits of pi/2
val __mathPio2_3: f64 = f64FromBits(4297306550709518336)
// pi/2 - (__mathPio2_1 + __mathPio2_2 + __mathPio2_3)
val __mathPio2_3t: f64 = f64FromBits(4142048980368378305)
// sin kernel
val __mathS1: f64 = f64FromBits(-4628199217061079735)
// sin kernel
val __mathS2: f64 = f64FromBits(4575957461383575718)
// sin kernel
val __mathS3: f64 = f64FromBits(-4671919876304969259)
// sin kernel
val __mathS4: f64 = f64FromBits(4523617212983017085)
// sin kernel
val __mathS5: f64 = f64FromBits(-4730215680275931925)
// sin kernel
val __mathS6: f64 = f64FromBits(4460209850635244924)
// cos kernel
val __mathC1: f64 = f64FromBits(4586165620538955084)
// cos kernel
val __mathC2: f64 = f64FromBits(-4659324094485802633)
// cos kernel
val __mathC3: f64 = f64FromBits(4537941361668330896)
// cos kernel
val __mathC4: f64 = f64FromBits(-4714566979978243411)
// cos kernel
val __mathC5: f64 = f64FromBits(4477121870137962948)
// cos kernel
val __mathC6: f64 = f64FromBits(-4780295122622859052)
// atan(0.5) hi
val __mathAtanHi0: f64 = f64FromBits(4602023952714414927)
// atan(1.0) hi
val __mathAtanHi1: f64 = f64FromBits(4605249457297304856)
// atan(1.5) hi
val __mathAtanHi2: f64 = f64FromBits(4607027438436873883)
// atan(inf) hi
val __mathAtanHi3: f64 = f64FromBits(4609753056924675352)
// atan(0.5) lo
val __mathAtanLo0: f64 = f64FromBits(4357843414468748770)
// atan(1.0) lo
val __mathAtanLo1: f64 = f64FromBits(4359948597267291143)
// atan(1.5) lo
val __mathAtanLo2: f64 = f64FromBits(4354989122426817469)
// atan(inf) lo
val __mathAtanLo3: f64 = f64FromBits(4364452196894661639)
// atan polynomial
val __mathAT0: f64 = f64FromBits(4599676419421066509)
// atan polynomial
val __mathAT1: f64 = f64FromBits(-4626998257160492092)
// atan polynomial
val __mathAT2: f64 = f64FromBits(4594314991288484863)
// atan polynomial
val __mathAT3: f64 = f64FromBits(-4630701217362536847)
// atan polynomial
val __mathAT4: f64 = f64FromBits(4591215095208222830)
// atan polynomial
val __mathAT5: f64 = f64FromBits(-4633165035261879699)
// atan polynomial
val __mathAT6: f64 = f64FromBits(4589464229703073105)
// atan polynomial
val __mathAT7: f64 = f64FromBits(-4634804155249132134)
// atan polynomial
val __mathAT8: f64 = f64FromBits(4587333258118041067)
// atan polynomial
val __mathAT9: f64 = f64FromBits(-4637946461342241745)
// atan polynomial
val __mathAT10: f64 = f64FromBits(4580351289466214929)

// IEEE-754 operations that every target rounds identically: these lower to
// single instructions (or LLVM's exact expansions) on x86-64, AArch64 and Wasm.
fun sqrt(value: f64): f64 = ablaF64Sqrt(value)
fun floor(value: f64): f64 = ablaF64Floor(value)
fun ceil(value: f64): f64 = ablaF64Ceil(value)
fun trunc(value: f64): f64 = ablaF64Trunc(value)
fun fabs(value: f64): f64 = ablaF64Abs(value)
/** Round half to even (IEEE roundTiesToEven), e.g. 2.5 -> 2.0, 3.5 -> 4.0. */
fun roundEven(value: f64): f64 = ablaF64RoundEven(value)

fun isNaN(value: f64): bool = value != value
fun isFinite(value: f64): bool = value - value == 0.0

fun fmin(left: f64, right: f64): f64 = if (left < right) left else right
fun fmax(left: f64, right: f64): f64 = if (left > right) left else right
fun fclamp(value: f64, minimum: f64, maximum: f64): f64 {
    val lower = if (value < minimum) minimum else value
    if (lower > maximum) maximum else lower
}
fun lerp(from: f64, to: f64, t: f64): f64 = from + (to - from) * t
fun hypot(x: f64, y: f64): f64 = sqrt(x * x + y * y)

// --- trigonometry -----------------------------------------------------------
// Ports of the FreeBSD msun (fdlibm) kernels, using only +, -, *, / and the
// exact operations above. No libm is involved, so native and Wasm builds return
// bit-identical results: an authoritative server and a predicting client agree.
// Range reduction is the Cody-Waite "medium" path, accurate for
// |x| < 2^20 * pi/2 (about 1.6 million) — far beyond any game angle.

@inline
fun __mathHigh(value: f64): int = f64ToBits(value) >> 32

fun __mathKernelSin(x: f64, y: f64, hasTail: bool): f64 {
    val z = x * x
    val w = z * z
    val r = __mathS2 + z * (__mathS3 + z * __mathS4) +
        z * w * (__mathS5 + z * __mathS6)
    val v = z * x
    if (!hasTail) x + v * (__mathS1 + z * r)
    else x - ((z * (0.5 * y - v * r) - y) - v * __mathS1)
}

fun __mathKernelCos(x: f64, y: f64): f64 {
    val z = x * x
    val w = z * z
    val r = z * (__mathC1 + z * (__mathC2 + z * __mathC3)) +
        w * w * (__mathC4 + z * (__mathC5 + z * __mathC6))
    val hz = 0.5 * z
    val one = 1.0 - hz
    one + (((1.0 - one) - hz) + (z * r - x * y))
}

// sin (cosine = false) or cos (cosine = true) of any finite x.
fun __mathTrig(x: f64, cosine: bool): f64 {
    val ix = __mathHigh(x) & 2147483647
    if (ix <= 1072243195) {
        // |x| <= pi/4: no reduction.
        if (cosine) {
            return if (ix < 1044381696) 1.0 else __mathKernelCos(x, 0.0)
        }
        return if (ix < 1044381696) x else __mathKernelSin(x, 0.0, false)
    }
    if (ix >= 2146435072) return x - x // inf or NaN -> NaN
    val fn = roundEven(x * __mathInvPio2)
    var r = x - fn * __mathPio2_1
    var w = fn * __mathPio2_1t
    var y0 = r - w
    val j = ix >> 20
    var i = j - ((__mathHigh(y0) >> 20) & 2047)
    if (i > 16) {
        var t = r
        w = fn * __mathPio2_2
        r = t - w
        w = fn * __mathPio2_2t - ((t - r) - w)
        y0 = r - w
        i = j - ((__mathHigh(y0) >> 20) & 2047)
        if (i > 49) {
            t = r
            w = fn * __mathPio2_3
            r = t - w
            w = fn * __mathPio2_3t - ((t - r) - w)
            y0 = r - w
        }
    }
    val y1 = (r - y0) - w
    val quadrant = (f64ToInt(fn) + if (cosine) 1 else 0) & 3
    if (quadrant == 0) __mathKernelSin(y0, y1, true)
    else if (quadrant == 1) __mathKernelCos(y0, y1)
    else if (quadrant == 2) -__mathKernelSin(y0, y1, true)
    else -__mathKernelCos(y0, y1)
}

fun sin(x: f64): f64 = __mathTrig(x, false)
fun cos(x: f64): f64 = __mathTrig(x, true)
fun tan(x: f64): f64 = sin(x) / cos(x)

fun atan(value: f64): f64 {
    var x = value
    val hx = __mathHigh(x)
    val ix = hx & 2147483647
    if (ix >= 1141899264) {
        // |x| >= 2^66
        if (isNaN(x)) return x + x
        return if (hx > 0) __mathAtanHi3 + __mathAtanLo3
            else -__mathAtanHi3 - __mathAtanLo3
    }
    var id = -1
    if (ix < 1071382528) {
        // |x| < 0.4375
        if (ix < 1044381696) return x // |x| < 2^-27
    } else {
        x = fabs(x)
        if (ix < 1072889856) {
            // |x| < 1.1875
            if (ix < 1072037888) {
                id = 0
                x = (2.0 * x - 1.0) / (2.0 + x)
            } else {
                id = 1
                x = (x - 1.0) / (x + 1.0)
            }
        } else if (ix < 1073971200) {
            // |x| < 2.4375
            id = 2
            x = (x - 1.5) / (1.0 + 1.5 * x)
        } else {
            id = 3
            x = -1.0 / x
        }
    }
    val z = x * x
    val w = z * z
    val s1 = z * (__mathAT0 + w * (__mathAT2 + w * (__mathAT4 +
        w * (__mathAT6 + w * (__mathAT8 + w * __mathAT10)))))
    val s2 = w * (__mathAT1 + w * (__mathAT3 + w * (__mathAT5 +
        w * (__mathAT7 + w * __mathAT9))))
    if (id < 0) return x - x * (s1 + s2)
    val hi = if (id == 0) __mathAtanHi0 else if (id == 1) __mathAtanHi1
        else if (id == 2) __mathAtanHi2 else __mathAtanHi3
    val lo = if (id == 0) __mathAtanLo0 else if (id == 1) __mathAtanLo1
        else if (id == 2) __mathAtanLo2 else __mathAtanLo3
    val result = hi - ((x * (s1 + s2) - lo) - x)
    if (hx < 0) -result else result
}

/** The angle of the vector (x, y) from the +x axis, in (-pi, pi]. */
fun atan2(y: f64, x: f64): f64 {
    if (isNaN(x) || isNaN(y)) return x + y
    if (x == 1.0) return atan(y)
    val hx = __mathHigh(x)
    val hy = __mathHigh(y)
    // Bit 0: y is negative; bit 1: x is negative (sign bits, so -0.0 counts).
    var m = ((hy >> 31) & 1) | ((hx >> 30) & 2)
    if (y == 0.0) {
        return if (m <= 1) y else if (m == 2) mathPi else -mathPi
    }
    if (x == 0.0) return if (hy < 0) -mathHalfPi else mathHalfPi
    val xInfinite = !isFinite(x)
    val yInfinite = !isFinite(y)
    if (xInfinite) {
        if (yInfinite) {
            return if (m == 0) mathQuarterPi else if (m == 1) -mathQuarterPi
                else if (m == 2) 3.0 * mathQuarterPi else -3.0 * mathQuarterPi
        }
        return if (m == 0) 0.0 else if (m == 1) -0.0
            else if (m == 2) mathPi else -mathPi
    }
    if (yInfinite) return if (hy < 0) -mathHalfPi else mathHalfPi
    val k = (((hy & 2147483647) >> 20) - ((hx & 2147483647) >> 20))
    var z: f64 = 0.0
    if (k > 60) {
        z = mathHalfPi + 0.5 * __mathPiLo
        m = m & 1
    } else if (hx < 0 && k < -60) {
        z = 0.0
    } else z = atan(fabs(y / x))
    if (m == 0) z
    else if (m == 1) -z
    else if (m == 2) mathPi - (z - __mathPiLo)
    else (z - __mathPiLo) - mathPi
}
