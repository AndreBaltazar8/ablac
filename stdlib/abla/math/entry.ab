// --- 256-bit helpers for pow's last phase -----------------------------------

// Limb j (0 lowest) of the 256-bit (a3, a2, a1, a0); 0 outside.
fun __mathLimb(a3: int, a2: int, a1: int, a0: int, j: int): int =
    if (j == 0) a0 else if (j == 1) a1 else if (j == 2) a2 else if (j == 3) a3 else 0

// Limb i of (a3, a2, a1, a0) shifted right by k >= 0 (logically).
fun __mathShr256(a3: int, a2: int, a1: int, a0: int, k: int, i: int): int {
    if (k >= 256) return 0
    val q = k >>> 6
    val r = k & 63
    val low = __mathLimb(a3, a2, a1, a0, i + q)
    if (r == 0) return low
    (low >>> r) | (__mathLimb(a3, a2, a1, a0, i + q + 1) << (64 - r))
}

// Limb i of (a3, a2, a1, a0) shifted left by k >= 0.
fun __mathShl256(a3: int, a2: int, a1: int, a0: int, k: int, i: int): int {
    if (k >= 256) return 0
    val q = k >>> 6
    val r = k & 63
    val high = __mathLimb(a3, a2, a1, a0, i - q)
    if (r == 0) return high
    (high << r) | (__mathLimb(a3, a2, a1, a0, i - q - 1) >>> (64 - r))
}

fun __mathClz256(a3: int, a2: int, a1: int, a0: int): int =
    if (a3 != 0) __mathClz(a3) else if (a2 != 0) 64 + __mathClz(a2)
    else if (a1 != 0) 128 + __mathClz(a1) else 192 + __mathClz(a0)

// |a| compared with |b| for 256-bit floats: -1, 0 or 1 (cmp_qint).
fun __mathQintCompare(a3: int, a2: int, a1: int, a0: int, ap: int, b3: int, b2: int, b1: int, b0: int, bp: int): int {
    if ((ap >> 1) != (bp >> 1)) return if ((ap >> 1) > (bp >> 1)) 1 else -1
    if (a3 != b3) return if (__mathULess(b3, a3)) 1 else -1
    if (a2 != b2) return if (__mathULess(b2, a2)) 1 else -1
    if (a1 != b1) return if (__mathULess(b1, a1)) 1 else -1
    if (a0 != b0) return if (__mathULess(b0, a0)) 1 else -1
    0
}

// The number of trailing zero bits of a nonzero word.
fun __mathCtz(x: int): int = 63 - __mathClz(x & -x)

// pow: 9-bit approximations r of 1/x on [i/2^8, (i+1)/2^8), i from 181 (CORE-MATH pow.h _INVERSE)
