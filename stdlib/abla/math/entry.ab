    val kf = if ((rp >> 1) < -12) 0.0 else roundEven(__mathDintToDouble(r3, rp) * f64FromBits(4609176140021203710))
    val kh = __mathDintFrom(-kf, 0)
    val kp = __mathDintFrom(-kf, 2)
    var u3 = 0
    var u2 = 0
    var u1 = 0
    var u0 = 0
    var up = 0
    var uk = 0
    while (uk < parts) {
        val word = __mathQintMulAdd(kh, 0, 0, 0, kp, -5660435428506895957, -3899075386890062161, 4680158270178506285, -8499111239825556948, -2, r3, r2, r1, r0, rp, uk)
        u3 = u2
        u2 = u1
        u1 = u0
        u0 = up
        up = word
        uk += 1
