import "abla/float"

fun min(left: int, right: int): int = if (left < right) left else right

fun max(left: int, right: int): int = if (left > right) left else right

fun clamp(value: int, minimum: int, maximum: int): int {
    val lower = if (value < minimum) minimum else value
    if (lower > maximum) maximum else lower
}

// --- f64 ----------------------------------------------------------------------

noescape extern:"intrinsic" fun ablaF64Sqrt(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Floor(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Ceil(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Trunc(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Abs(value: f64): f64
noescape extern:"intrinsic" fun ablaF64RoundEven(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Minimum(left: f64, right: f64): f64
noescape extern:"intrinsic" fun ablaF64Maximum(left: f64, right: f64): f64
noescape extern:"intrinsic" fun ablaF64Fma(x: f64, y: f64, z: f64): f64
noescape extern:"intrinsic" fun ablaF64FmaIsFused(): bool

// pi
val mathPi: f64 = f64FromBits(4614256656552045848)
// pi / 2
val mathHalfPi: f64 = f64FromBits(4609753056924675352)
// pi / 4
val mathQuarterPi: f64 = f64FromBits(4605249457297304856)
// 2 pi
val mathTau: f64 = f64FromBits(4618760256179416344)
// pi - mathPi
val __mathPiLo: f64 = f64FromBits(4368955796522032135)

// IEEE-754 operations that every target rounds identically: these lower to
// single instructions (or LLVM's exact expansions) on x86-64, AArch64 and Wasm.
fun sqrt(value: f64): f64 = ablaF64Sqrt(value)
fun floor(value: f64): f64 = ablaF64Floor(value)
fun ceil(value: f64): f64 = ablaF64Ceil(value)
fun trunc(value: f64): f64 = ablaF64Trunc(value)
fun fabs(value: f64): f64 = ablaF64Abs(value)
/** Round half to even (IEEE roundTiesToEven), e.g. 2.5 -> 2.0, 3.5 -> 4.0. */
fun roundEven(value: f64): f64 = ablaF64RoundEven(value)

fun isNaN(value: f64): bool = value != value
fun isFinite(value: f64): bool = value - value == 0.0

/** The smaller of two f64s as IEEE 754-2019 minimum: NaN if either is NaN,
 *  and -0.0 below 0.0. */
fun fmin(left: f64, right: f64): f64 = ablaF64Minimum(left, right)
/** The larger of two f64s as IEEE 754-2019 maximum: NaN if either is NaN,
 *  and 0.0 above -0.0. */
fun fmax(left: f64, right: f64): f64 = ablaF64Maximum(left, right)
/** value held to [minimum, maximum] (maximum wins if they cross), with fmin's
 *  and fmax's rules: NaN if any argument is NaN, and -0.0 below 0.0. */
fun fclamp(value: f64, minimum: f64, maximum: f64): f64 =
    ablaF64Minimum(ablaF64Maximum(value, minimum), maximum)
/** x * y + z rounded once (IEEE 754 fusedMultiplyAdd): the hardware's
 *  instruction where the target has one, an exact software routine elsewhere,
 *  so every target gives the same bits. */
fun fma(x: f64, y: f64, z: f64): f64 =
    if (ablaF64FmaIsFused()) ablaF64Fma(x, y, z) else __mathFmaSoftware(x, y, z)

// x y + z rounded once (IEEE 754 fusedMultiplyAdd), in integers: abla/math's
// fma where the target has no fused multiply-add instruction, and at compile
// time. The exact sum is formed in 128 bits with a sticky bit, then rounded
// once to the nearest double (to even on a tie).
fun __mathFmaSoftware(x: f64, y: f64, z: f64): f64 {
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    val zb = f64ToBits(z)
    val xe = (xb >>> 52) & 0x7ff
    val ye = (yb >>> 52) & 0x7ff
    val ze = (zb >>> 52) & 0x7ff
    // an infinite, NaN or zero x or y: x y is exact
    if (xe == 0x7ff || ye == 0x7ff || (xb << 1) == 0 || (yb << 1) == 0) return x * y + z
    // x y finite and nonzero: an infinite or NaN z is the result
    if (ze == 0x7ff) return z + z
    // a zero z: x y rounded once, keeping its sign if it underflows to zero
    if ((zb << 1) == 0) return x * y
    // |x| = mx 2^ex and so on, with integer significands
    val mx = (xb & 0xfffffffffffff) | (if (xe != 0) 1 << 52 else 0)
    val my = (yb & 0xfffffffffffff) | (if (ye != 0) 1 << 52 else 0)
    val mz = (zb & 0xfffffffffffff) | (if (ze != 0) 1 << 52 else 0)
    val ex = (if (xe != 0) xe else 1) - 1075
    val ey = (if (ye != 0) ye else 1) - 1075
    val ez = (if (ze != 0) ze else 1) - 1075
    // P = mx my 2^ep and Z = mz 2^ezz, each with its top bit moved to bit 125
    val ph0 = __mathMulHigh(mx, my)
    val pl0 = mx * my
    val pshift = (if (ph0 != 0) __mathClz(ph0) else 64 + __mathClz(pl0)) - 2
    val ph = __mathShl128High(ph0, pl0, pshift)
    val pl = __mathShl128Low(pl0, pshift)
    val ep = ex + ey - pshift
    val zshift = 62 + __mathClz(mz)
    val zh = __mathShl128High(0, mz, zshift)
    val zl = __mathShl128Low(mz, zshift)
    val ezz = ez - zshift
    val ps = (xb ^ yb) >>> 63
    val zs = zb >>> 63
    // the larger magnitude first
    val pFirst = if (ep != ezz) ep > ezz else if (ph != zh) __mathULess(zh, ph) else !__mathULess(pl, zl)
    val bh = if (pFirst) ph else zh
    val bl = if (pFirst) pl else zl
    val be = if (pFirst) ep else ezz
    val bs = if (pFirst) ps else zs
    val sh = if (pFirst) zh else ph
    val sl = if (pFirst) zl else pl
    val d = be - (if (pFirst) ezz else ep)
    // the smaller one aligned, the bits shifted out kept as a sticky bit
    var th = __mathShr128High(sh, d)
    var tl = __mathShr128Low(sh, sl, d)
    val lost = if (d >= 128) true
        else __mathShl128High(th, tl, d) != sh || __mathShl128Low(tl, d) != sl
    if (lost) tl = tl | 1
    var rh = 0
    var rl = 0
    if (bs == (if (pFirst) zs else ps)) {
        rl = bl + tl
        rh = bh + th + (if (__mathULess(rl, bl)) 1 else 0)
    } else {
        rl = bl - tl
        rh = bh - th - (if (__mathULess(bl, tl)) 1 else 0)
        // an exact cancellation is +0 when rounding to nearest
        if ((rh | rl) == 0) return 0.0
    }
    // the sum's top 63 bits, the rest as a sticky bit: r 2^e, 2^62 <= r < 2^63
    val lr = if (rh != 0) __mathClz(rh) else 64 + __mathClz(rl)
    val nh = __mathShl128High(rh, rl, lr)
    val nl = __mathShl128Low(rl, lr)
    val r = (nh >>> 1) | (if ((nh & 1) != 0 || nl != 0) 1 else 0)
    val e = be + 65 - lr
    // round to 53 bits, or to the subnormal grid 2^-1074
    val k = if (e >= -1084) 10 else -(e + 1074)
    if (k >= 64) return if (bs == 1) -0.0 else 0.0
    var m = r >>> k
    val rem = r & ((1 << k) - 1)
    val half = 1 << (k - 1)
    if (rem > half || (rem == half && (m & 1) != 0)) m += 1
    if (k > 10) return f64FromBits(m | (bs << 63))
    if (e + 1085 + (m >>> 53) >= 2047) return if (bs == 1) -1.0 / 0.0 else 1.0 / 0.0
    f64FromBits((((e + 1084) << 52) + m) | (bs << 63))
}

fun lerp(from: f64, to: f64, t: f64): f64 = from + (to - from) * t

// --- two-argument arctangent -------------------------------------------------
// atan2 is correctly rounded: a port of CORE-MATH's atan2 (its helpers are below
// with the other correctly rounded functions).

/** The angle of the vector (x, y) from the +x axis, in [-pi, pi], correctly
 *  rounded. */
fun atan2(y: f64, x: f64): f64 {
    // A port of CORE-MATH's atan2.c (copyright 2024-2025 Paul Zimmermann and
    // Alexei Sibidanov, MIT licence: see the end of this file).
    val iy = f64ToBits(y)
    val ix = f64ToBits(x)
    val aiy = iy & 0x7fffffffffffffff
    val aix = ix & 0x7fffffffffffffff
    if (aiy == 0 || aiy >= 0x7ff0000000000000 || aix == 0 || aix >= 0x7ff0000000000000) {
        return __mathAtan2Special(y, x)
    }
    val gt = if (aix < aiy) 1 else 0
    val sx = ix >>> 63
    val sy = iy >>> 63
    // exponents 53 or more apart: the accurate path
    val dxy = if (gt == 1) aiy - aix - 1 else aix - aiy
    if (dxy >= 53 << 52) return __mathAtan2Accurate(y, x)
    // atan2 = offset ± (atan(j / 64) + atan(z)), z = (b - j a / 64) / (a + j b / 64)
    // for the larger and smaller magnitudes a and b
    var a = if (gt == 1) fabs(y) else fabs(x)
    var b = if (gt == 1) fabs(x) else fabs(y)
    val sg = if ((gt ^ sx ^ sy) == 1) -1.0 else 1.0
    val kw = (sx << 2) | (sy << 1) | gt
    val jt = (f64ToBits(b / a + f64FromBits(4611703610613432320)) >>> 45) & 127
    // the offset: a multiple of pi/2
    val quarters = if (kw == 1 || kw == 5) 1.0 else if (kw == 3 || kw == 7) -1.0
        else if (kw == 4) 2.0 else if (kw == 6) -2.0 else 0.0
    var fh = f64FromBits(__mathAtan2High(jt)) * sg + quarters * f64FromBits(4609753056924675352)
    var fl = f64FromBits(__mathAtan2Low(jt)) * sg + quarters * f64FromBits(4364452196894661639)
    // scaled for Dekker's products (CORE-MATH scales only the extremes)
    if (a < f64FromBits(2805742567851819008)) {
        a = a * f64FromBits(7309342195222315008)
        b = b * f64FromBits(7309342195222315008)
    } else if (a > f64FromBits(6408622269748215808)) {
        a = a * f64FromBits(1905022642377719808)
        b = b * f64FromBits(1905022642377719808)
    }
    val t0 = f64FromInt(jt) * 0.015625
    // zn = b - t0 a exactly rounded (CORE-MATH's fma: b - t0 a is exact)
    val p0 = t0 * a
    val zn = (b - p0) - __mathMulLow(t0, a, p0)
    // zd = a + t0 b, rounded once but for 2^-105
    val p1 = t0 * b
    val s1 = a + p1
    val b1 = s1 - a
    val zd = s1 + (((a - (s1 - b1)) + (p1 - b1)) + __mathMulLow(t0, b, p1))
    var z = zn / zd
    var z2 = z * z
    z = z * sg
    val dz = (z * z2) * (f64FromBits(-4623695617433709358) + z2 * (f64FromBits(4596373779673833930) +
        z2 * f64FromBits(-4629057557932522335)))
    // CORE-MATH's bound from 1.1e10 random pairs, plus 2.5%
    var eps = fabs(z) * f64FromBits(4377587898245971968) + f64FromBits(4201858452336672768)
    val rh = fh + z
    val rl = (fl + dz) + (z - (rh - fh))
    var lb = rh + (rl - eps)
    var ub = rh + (rl + eps)
    if (lb != ub) {
        // z = zn / zd to about 2^-100
        var dh = b * t0
        var dl = __mathMulLow(b, t0, dh)
        val ds = a + dh
        dl = dl + (dh - (ds - a))
        dh = ds
        val rdh = 1.0 / dh
        var nh = a * t0
        var nl = __mathMulLow(a, t0, nh)
        val dt = b - nh
        val b2 = dt + nh
        val w = if (b2 == b) -nl else (b - b2) - nl
        nh = dt + w
        nl = w - (nh - dt)
        val zh0 = nh * rdh
        z2 = zh0 * zh0
        // nh - dh zh0 exactly rounded (CORE-MATH's fma: nh - pz is exact)
        val pz = dh * zh0
        var zl = rdh * (((nh - pz) - __mathMulLow(dh, zh0, pz)) + (nl - (nh * rdh) * dl))
        zl = zl + zh0 * z2 * ((f64FromBits(-4623695617433709227) + z2 * f64FromBits(4596373779694318942)) +
            (z2 * z2) * (f64FromBits(-4629057045730584840) + z2 * f64FromBits(4592668304607484866)))
        val zh = zh0 * sg
        zl = zl * sg
        eps = f64FromBits(4383128337338335232) * (fabs(zh) * z2 + f64FromBits(4377498837804122112))
        val sh = fh + zh
        fl = (fl + zl) + (zh - (sh - fh))
        fh = sh
        lb = fh + (fl - eps)
        ub = fh + (fl + eps)
        if (lb != ub) return __mathAtan2Accurate(y, x)
    }
    ub
}

// --- power --------------------------------------------------------------------
// pow is correctly rounded (a port of CORE-MATH's pow, below with the other
// correctly rounded functions); it follows C where C and JavaScript differ:
// pow(1, y) is 1 for every y and pow(-1, ±inf) is 1, where JavaScript gives NaN.

// e
val mathE: f64 = f64FromBits(4613303445314885481)
// ln 2
val mathLn2: f64 = f64FromBits(4604418534313441775)
// 1e300 and 2^-1000, whose squares overflow and underflow
val __mathHuge: f64 = f64FromBits(9094988921128908188)
val __mathTwoM1000: f64 = f64FromBits(103582791429521408)

// --- correctly rounded functions (CORE-MATH) ----------------------------------
// Ports of CORE-MATH (https://core-math.gitlabpages.inria.fr), which returns the
// double nearest the exact result. CORE-MATH's fused multiply-adds become
// Dekker's exact products, so only +, -, *, /, sqrt and integer operations
// remain and every target agrees bit for bit.

// The rounding error of p = a * b: a * b - p exactly (Dekker's product, for
// |a|, |b| < 2^995 and no underflow).
@inline
fun __mathMulLow(a: f64, b: f64, p: f64): f64 {
    // a fused multiply-add gives the same exact error in one instruction
    if (ablaF64FmaIsFused()) return ablaF64Fma(a, b, -p)
    val ca = 134217729.0 * a
    val ah = ca - (ca - a)
    val al = a - ah
    val cb = 134217729.0 * b
    val bh = cb - (cb - b)
    val bl = b - bh
    (((ah * bh - p) + ah * bl) + al * bh) + al * bl
}

// a b + c, rounded once where the target fuses multiply-adds, else twice.
@inline
fun __mathMulAdd(a: f64, b: f64, c: f64): f64 =
    if (ablaF64FmaIsFused()) ablaF64Fma(a, b, c) else a * b + c

// r t - 1 rounded once, for an r of at most 9 significant bits: t is split so
// that both products are exact (one fused multiply-add where there is one).
@inline
fun __mathLogReduce(r: f64, t: f64): f64 {
    if (ablaF64FmaIsFused()) return ablaF64Fma(r, t, -1.0)
    val th = f64FromBits(f64ToBits(t) & -512)
    (r * th - 1.0) + r * (t - th)
}

// The rounding error of p = a * a: a * a - p exactly (as __mathMulLow).
@inline
fun __mathSquareLow(a: f64, p: f64): f64 {
    if (ablaF64FmaIsFused()) return ablaF64Fma(a, a, -p)
    val ca = 134217729.0 * a
    val ah = ca - (ca - a)
    val al = a - ah
    ((ah * ah - p) + 2.0 * ah * al) + al * al
}

// The high 64 bits of the unsigned 128-bit product a * b, from 32-bit halves
// with the carries out of the low word counted. (LLVM fuses the textbook
// form, which sums the middle terms first, into a 128-bit multiplication
// that wasm32 has only as a library call; this form it leaves alone.)
@inline
fun __mathMulHigh(a: int, b: int): int {
    val a0 = a & 0xffffffff
    val a1 = a >>> 32
    val b0 = b & 0xffffffff
    val b1 = b >>> 32
    val p00 = a0 * b0
    val p01 = a0 * b1
    val p10 = a1 * b0
    val t = p00 + (p01 << 32)
    val t2 = t + (p10 << 32)
    a1 * b1 + (p01 >>> 32) + (p10 >>> 32) + (if (__mathULess(t, p00)) 1 else 0) +
        (if (__mathULess(t2, t)) 1 else 0)
}

/** sqrt(x^2 + y^2) correctly rounded, without overflow or underflow in
 *  between; ±inf in either argument gives inf even when the other is NaN. */
fun hypot(x: f64, y: f64): f64 {
    // A port of CORE-MATH's hypot.c (copyright 2022-2026 Alexei Sibidanov,
    // MIT licence: see the end of this file) for round-to-nearest.
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    val exponentMask = 0x7ff << 52
    val ax = fabs(x)
    val ay = fabs(y)
    if ((xb & exponentMask) == exponentMask || (yb & exponentMask) == exponentMask) {
        // A NaN or an infinity: an infinity wins over a quiet NaN.
        val wx = xb << 1
        val wy = yb << 1
        val infinity = exponentMask << 1
        val oneInfinite = (wx == infinity) != (wy == infinity)
        val oneQuiet = ((wx >>> 52) == 0xfff) != ((wy >>> 52) == 0xfff)
        if (oneInfinite && oneQuiet) return if (wx == infinity) ax * ax else ay * ay
        return ax + ay
    }
    val u = if (ax > ay) ax else ay
    val v = if (ax > ay) ay else ax
    var ub = f64ToBits(u)
    var vb = f64ToBits(v)
    if ((vb >>> 52) == 0) {
        // v is subnormal or zero
        if (vb == 0) return u
        if ((ub >>> 52) == 0) return __mathHypotSubnormal(ub, vb)
        // v's encoding as if its exponent field could go below 1
        val zeros = 63 - ((f64ToBits(f64FromInt(vb)) >>> 52) - 1023)
        vb = ((vb << (zeros - 11)) & (-1 >>> 12)) - ((zeros - 12) << 52)
    }
    // v < 2^-27 u: u^2 + v^2 rounds to u^2, and its root to u (unsigned: a
    // subnormal v's encoding above is below zero)
    if (u64(ub - vb) > u64(27 << 52)) return u
    // Scale u to [1, 2) and v by the same power of 2.
    val offset = (0x3ff << 52) - (ub & exponentMask)
    val xs = f64FromBits(ub + offset)
    val ys = f64FromBits(vb + offset)
    val x2 = xs * xs
    val dx2 = __mathSquareLow(xs, x2)
    val y2 = ys * ys
    val dy2 = __mathSquareLow(ys, y2)
    val r2 = x2 + y2
    val ir2 = 0.5 / r2
    val dr2 = ((x2 - r2) + y2) + (dx2 + dy2)
    var th = sqrt(r2)
    val rsqrt = th * ir2
    // th^2 - r2 exactly: th is r2's correctly rounded root
    val th2 = th * th
    val dz = dr2 - ((th2 - r2) + __mathSquareLow(th, th2))
    var tl = rsqrt * dz
    val sum = th + tl
    tl = tl - (sum - th)
    th = sum
    val thb = f64ToBits(th)
    val aidr = f64ToBits(fabs(tl)) + (0x3fe << 52) - (thb & exponentMask)
    val mid = (aidr - 0x3c90000000000000 + 16) >>> 5
    val midm = (aidr - 0x3c80000000000000 + 16) >>> 5
    var result = thb
    if (mid == 0 || midm == 0 || u64(aidr) < u64(0x39b0000000000000) ||
        u64(aidr) > u64(0x3c9fffffffffff80)) {
        // Too close to a rounding boundary: decide it in integers.
        result = f64ToBits(__mathHypotHard(xs, ys))
    }
    result = result - offset
    if (result >= exponentMask) return __mathHuge * __mathHuge
    f64FromBits(result)
}

// hypot of two subnormals from their encodings a >= b > 0: the root of
// a^2 + b^2 found and rounded in integers.
@noinline
fun __mathHypotSubnormal(a: int, b: int): f64 {
    val af = f64FromInt(a)
    val bf = f64FromInt(b)
    val a2 = a << 1
    val b2 = b << 1
    var tm = f64ToInt(sqrt(af * af + bf * bf)) << 1
    // D = a2^2 + b2^2 - tm^2, exact in wrapping 64-bit arithmetic since it is small
    var d = a2 * a2 + b2 * b2 - tm * tm
    while (d > 2 * tm) {
        d = d - (2 * tm + 1)
        tm += 1
    }
    while (d < 0) {
        d = d + (2 * tm - 1)
        tm -= 1
    }
    // tm = floor(sqrt(a2^2 + b2^2)); a midpoint is impossible here
    var rm = tm >> 1
    if (d != 0) rm = rm + (tm & 1)
    f64FromBits(rm)
}

// hypot of x in [1, 2) and y <= x close to a rounding boundary: Newton's
// root refined and rounded by comparing exact squares in integers.
@noinline
fun __mathHypotHard(x: f64, y: f64): f64 {
    val mantissa = -1 >>> 12
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    var bm = (xb & mantissa) | (1 << 52)
    var lm = (yb & mantissa) | (1 << 52)
    val be = xb >>> 52
    val le = yb >>> 52
    val rb = f64ToBits(sqrt(x * x + y * y))
    val bs = 2
    var rm = (rb & mantissa) | (1 << 52)
    var re = (rb >>> 52) - 0x3ff
    var i = 0
    while (i < 3) {
        if (rm == (1 << 52)) {
            rm = -1 >>> 11
            re -= 1
        } else rm -= 1
        i += 1
    }
    bm = bm << bs
    // squares wrap modulo 2^64: only small differences of them are used
    var m2 = bm * bm
    val ls = bs - (be - le)
    if (ls >= 0) {
        lm = lm << ls
        m2 = m2 + lm * lm
    } else {
        // lm^2 as 128 bits, shifted right by -2 ls with a sticky bit
        val shift = -2 * ls
        val high = __mathMulHigh(lm, lm)
        val low = lm * lm
        m2 = m2 + ((low >>> shift) | (high << (64 - shift)))
        if ((low & ((1 << shift) - 1)) != 0) m2 = m2 | 1
    }
    val k = bs + re
    var d = 0
    while (true) {
        rm = rm + 1 + (if (rm >= (1 << 53)) 1 else 0)
        val tm = rm << k
        d = m2 - tm * tm
        if (d <= 0) break
    }
    if (d != 0) {
        val small = if (rm <= (1 << 53)) 1 else 0
        val tm = (rm << k) - (1 << (k - small))
        d = m2 - tm * tm
        if (d != 0) rm = rm + (d >> 63)
        else rm = rm - (rm & (1 << (1 - small)))
    }
    if (rm >= (1 << 53)) {
        rm = rm >> 1
        re += 1
    }
    f64FromBits(((be - 1 + re) << 52) + rm)
}

/** e raised to x, correctly rounded. */
fun exp(x: f64): f64 {
    // A port of CORE-MATH's exp.c (copyright 2022-2026 Alexei Sibidanov, MIT
    // licence: see the end of this file).
    val xb = f64ToBits(x)
    val ax = xb & 0x7fffffffffffffff
    // exp(x) rounds to 1 for |x| <= 2^-54
    if (ax <= 0x3c90000000000000) return 1.0 + x
    if (ax >= 0x40862e42fefa39f0) {
        // |x| >= 0x1.62e42fefa39fp+9
        if (ax > 0x7ff0000000000000) return x + x
        if (ax == 0x7ff0000000000000) return if (xb < 0) 0.0 else x
        if (xb >= 0) return __mathHuge * __mathHuge
        // x <= -0x1.74910d52d3052p+9
        if (ax >= 0x40874910d52d3052) return __mathTwoM1000 * __mathTwoM1000
    }
    // x = (i0 / 2^6 + i1 / 2^12 + ie) log 2 + dx
    val t = roundEven(x * f64FromBits(4663219335549649662))
    val jt = f64ToInt(t)
    val i0 = (jt >> 6) & 0x3f
    val i1 = jt & 0x3f
    val ie = jt >> 12
    val t0h = f64FromBits(__mathExpT0High(i0))
    val t0l = f64FromBits(__mathExpT0Low(i0))
    val t1h = f64FromBits(__mathExpT1High(i1))
    val t1l = f64FromBits(__mathExpT1Low(i1))
    val th = t1h * t0h
    val tl = (t1h * t0l + t1l * t0h) + __mathMulLow(t1h, t0h, th)
    // Cody-Waite: |t| < 2^23 and log2 / 2^12's high part has 29 bits, so
    // its product with t is exact
    val dx = (x - f64FromBits(4550375338785374208) * t) + f64FromBits(4397510237898870310) * t
    val dx2 = dx * dx
    // 1 + dx (c0 + c1 dx + c2 dx^2 + c3 dx^3) approximates exp(dx) to 2^-76.173
    val p = (1.0 + dx * 0.5) +
        dx2 * (f64FromBits(4595172819796382975) + dx * f64FromBits(4586165620537168628))
    var fh = th
    var fl = tl + (th * dx) * p
    val eps = f64FromBits(4328645337158778880)
    if (x < f64FromBits(-4573929700241785646)) {
        // subnormal result: x < -0x1.6232bdd7abcd2p+9
        val bias = f64FromBits((1 - ie) << 52)
        val sum = bias + fh
        fl = fl + (fh - (sum - bias))
        fh = sum
        val lb = fh + (fl - eps)
        if (fh + (fl + eps) != lb) return __mathExpAccurate(x)
        return f64FromBits(f64ToBits(lb) & 0xfffffffffffff)
    }
    val lb = fh + (fl - eps)
    if (fh + (fl + eps) != lb) return __mathExpAccurate(x)
    f64FromBits(f64ToBits(lb) + (ie << 52))
}

// exp(x) for 2^-54 < |x| < 745 to about 2^-110, rounded: the path for
// results the fast path can't round with certainty.
@noinline
fun __mathExpAccurate(x: f64): f64 {
    val t = roundEven(x * f64FromBits(4663219335549649662))
    val jt = f64ToInt(t)
    val i0 = (jt >> 6) & 0x3f
    val i1 = jt & 0x3f
    val ie = jt >> 12
    val t0h = f64FromBits(__mathExpT0High(i0))
    val t0l = f64FromBits(__mathExpT0Low(i0))
    val t1h = f64FromBits(__mathExpT1High(i1))
    val t1l = f64FromBits(__mathExpT1Low(i1))
    val th = t1h * t0h
    val tl = (t1h * t0l + t1l * t0h) + __mathMulLow(t1h, t0h, th)
    // Cody-Waite with log2 / 2^12 in three parts
    val l2l = f64FromBits(4397510237898870310)
    val dx = x - f64FromBits(4550375338785374208) * t
    var dxl = l2l * t
    val dxll = f64FromBits(4150628921061420995) * t + __mathMulLow(l2l, t, dxl)
    val dxh = dx + dxl
    dxl = (dxl - (dxh - dx)) + dxll
    // Horner on double-doubles: (ch, cl) = (ch, cl) (dxh, dxl) + c[i]
    var ch = f64FromBits(__mathExpPoly(12))
    var cl = f64FromBits(__mathExpPoly(13))
    var i = 10
    while (i >= 0) {
        val ah = f64FromBits(__mathExpPoly(i))
        val p = dxh * ch
        val pl = __mathMulLow(dxh, ch, p)
        val s = p + ah
        val back = s - p
        val e = ((p - (s - back)) + (ah - back)) + pl
        val g = dxh * cl + (e + f64FromBits(__mathExpPoly(i + 1)))
        cl = dxl * ch + g
        ch = s
        i -= 2
    }
    // f = (dxh + dxl) (ch + cl), then (th + tl) f
    var fh = ch * dxh
    var fl = (ch * dxl + cl * dxh) + __mathMulLow(ch, dxh, fh)
    val gh = th * fh
    fl = (th * fl + tl * fh) + __mathMulLow(th, fh, gh)
    fh = gh
    // (th + tl) + f
    var sum = th + fh
    fl = (tl + fl) + (fh - (sum - th))
    fh = sum
    if (x < f64FromBits(-4573929700241785646)) {
        // subnormal result
        val bias = f64FromBits((1 - ie) << 52)
        sum = bias + fh
        fl = fl + (fh - (sum - bias))
        fh = sum
        return f64FromBits(f64ToBits(fh + fl) & 0xfffffffffffff)
    }
    sum = fh + fl
    fl = fl - (sum - fh)
    fh = sum
    // a low part within 4 units of 2^-52 or 0 of the high part: a listed exception?
    if (((f64ToBits(fl) + 4) & 0xfffffffffffff) <= 4) fh = __mathExpException(x, fh)
    f64FromBits(f64ToBits(fh) + (ie << 52))
}

// The listed exceptional value for x, or f when x isn't listed.
@noinline
fun __mathExpException(x: f64, f: f64): f64 {
    var a = 0
    var b = 21
    // invariant: table x at a <= x < table x at b
    while (a + 1 < b) {
        val m = (a + b) / 2
        if (x < f64FromBits(__mathExpExceptions(3 * m))) b = m else a = m
    }
    if (x == f64FromBits(__mathExpExceptions(3 * a))) {
        return f64FromBits(__mathExpExceptions(3 * a + 1)) +
            f64FromBits(__mathExpExceptions(3 * a + 2))
    }
    f
}

/** The natural logarithm of x, correctly rounded: -inf at ±0, NaN below. */
fun log(x: f64): f64 {
    // CORE-MATH's pow.c log_1 (copyright 2022-2025 CERN and Inria, MIT licence:
    // see the end of this file), with a rounding test of its own.
    val xb = f64ToBits(x)
    var e = (xb >>> 52) & 0x7ff
    if (e == 0x7ff || xb <= 0) {
        // NaN, inf or x <= 0 (a subnormal goes on below)
        if (x != x || x == 1.0 / 0.0) return x + x
        if (x <= 0.0) return if (x < 0.0) (x - x) / 0.0 else -1.0 / 0.0
    }
    if (xb == 0x3ff0000000000000) return 0.0
    // x = 2^e t with 1 <= t < 2
    var m = xb & 0xfffffffffffff
    var t = 0.0
    if (e != 0) {
        t = f64FromBits(m | (0x3ff << 52))
        m = m + (1 << 52)
        e = e - 0x3ff
    } else {
        val k = __mathClz(m) - 11
        e = -0x3fe - k
        m = m << k
        t = f64FromBits(m | (0x3ff << 52))
    }
    // above sqrt(2), halve t
    val c = if (m >= 0x16a09e667f3bcd) 1 else 0
    e = e + c
    val ee = f64FromInt(e)
    val i = (m >>> (44 + c)) - 181
    t = t * (if (c == 1) 0.5 else 1.0)
    val r = f64FromBits(__mathLogInverse(i))
    // z = r t - 1 exactly
    val z = __mathLogReduce(r, t)
    // e log(2) + l1 is exact
    val logHigh = f64FromBits(__mathLogInverseLogHigh(i))
    val logLow = f64FromBits(__mathLogInverseLogLow(i))
    val th = ee * f64FromBits(4604418534313441280) + logHigh
    val tl = ee * f64FromBits(4408728642709317424) + logLow
    var lh = th + z
    var ll = (z - (lh - th)) + tl
    // log(1 + z) - z ~ ph + pl
    val wh = z * z
    val wl = __mathSquareLow(z, wh)
    val p5 = f64FromBits(-4629700283583108914) * z + f64FromBits(4594315131227032070)
    var u = f64FromBits(-4628199217062666572) * z + f64FromBits(4596373779692778805)
    var v = f64FromBits(-4625196817309499389) * z + f64FromBits(4599676419421066584)
    u = p5 * wh + u
    v = u * wh + v
    u = v * wh
    val ph = -0.5 * wh
    val pl = u * z + (-0.5 * wl)
    val sum = lh + ph
    ll = (ph - (sum - lh)) + (ll + pl)
    lh = sum
    // relative error: CORE-MATH's 2^-73.527 (2^-67.054 for 1/sqrt(2) < x <
    // sqrt(2)), widened for the unfused multiply-adds
    val err = fabs(lh) * (if (e == 0) f64FromBits(4309944843393564672) else f64FromBits(4282923245629341696))
    val left = lh + (ll - err)
    if (left == lh + (ll + err)) return left
    __mathLogAccurate(x, logHigh, logLow)
}

// log(x) for a positive x != 1 to about 2^-124, rounded: log_1's reduction,
// log(1 + z) by its Taylor series and the table's -log r to 2^-151, with the
// out-of-line dint operations (l1 and l2 of -log r as the fast path read them).
@noinline
fun __mathLogAccurate(x: f64, l1: f64, l2: f64): f64 {
    val xb = f64ToBits(x)
    var e = (xb >>> 52) & 0x7ff
    var m = xb & 0xfffffffffffff
    var t = 0.0
    if (e != 0) {
        t = f64FromBits(m | (0x3ff << 52))
        m = m + (1 << 52)
        e = e - 0x3ff
    } else {
        val k = __mathClz(m) - 11
        e = -0x3fe - k
        m = m << k
        t = f64FromBits(m | (0x3ff << 52))
    }
    val c = if (m >= 0x16a09e667f3bcd) 1 else 0
    e = e + c
    val i = (m >>> (44 + c)) - 181
    t = t * (if (c == 1) 0.5 else 1.0)
    val r = f64FromBits(__mathLogInverse(i))
    val z = __mathLogReduce(r, t)
    // P(z) = log(1 + z): Horner from z^17 / 17
    val zh = __mathDintFrom(z, 0)
    val zl = 0
    val zp = __mathDintFrom(z, 2)
    var ph = __mathLogTaylor(48)
    var pl = __mathLogTaylor(49)
    var pp = __mathLogTaylor(50)
    var k = 15
    while (k >= -1) {
        val mh = __mathDintMul(ph, pl, pp, zh, zl, zp, 0)
        val ml = __mathDintMul(ph, pl, pp, zh, zl, zp, 1)
        val mp = __mathDintMul(ph, pl, pp, zh, zl, zp, 2)
        if (k < 0) {
            ph = mh
            pl = ml
            pp = mp
        } else {
            val ch = __mathLogTaylor(3 * k)
            val cl = __mathLogTaylor(3 * k + 1)
            val cp = __mathLogTaylor(3 * k + 2)
            ph = __mathDintAdd(ch, cl, cp, mh, ml, mp, 0)
            pl = __mathDintAdd(ch, cl, cp, mh, ml, mp, 1)
            pp = __mathDintAdd(ch, cl, cp, mh, ml, mp, 2)
        }
        k -= 1
    }
    // + (-log r) = l1 + l2 + l3, smallest first
    var gh = __mathDintFrom(f64FromBits(__mathLogInverseLogThird(i)), 0)
    var gp = __mathDintFrom(f64FromBits(__mathLogInverseLogThird(i)), 2)
    var gl = 0
    val ah = __mathDintFrom(l2, 0)
    val ap = __mathDintFrom(l2, 2)
    var sh = __mathDintAdd(ah, 0, ap, gh, gl, gp, 0)
    var sl = __mathDintAdd(ah, 0, ap, gh, gl, gp, 1)
    var sp = __mathDintAdd(ah, 0, ap, gh, gl, gp, 2)
    val bh = __mathDintFrom(l1, 0)
    val bp = __mathDintFrom(l1, 2)
    val s2h = __mathDintAdd(bh, 0, bp, sh, sl, sp, 0)
    val s2l = __mathDintAdd(bh, 0, bp, sh, sl, sp, 1)
    val s2p = __mathDintAdd(bh, 0, bp, sh, sl, sp, 2)
    val qh = __mathDintAdd(s2h, s2l, s2p, ph, pl, pp, 0)
    val ql = __mathDintAdd(s2h, s2l, s2p, ph, pl, pp, 1)
    val qp = __mathDintAdd(s2h, s2l, s2p, ph, pl, pp, 2)
    // + e log(2)
    val lh = -5660435428506895957
    val ll = -3899075386890062161
    val lp = -2
    val eh = __mathDintMulInt(e, lh, ll, lp, 0)
    val el = __mathDintMulInt(e, lh, ll, lp, 1)
    val ep = __mathDintMulInt(e, lh, ll, lp, 2)
    val resultHigh = __mathDintAdd(qh, ql, qp, eh, el, ep, 0)
    val resultPacked = __mathDintAdd(qh, ql, qp, eh, el, ep, 2)
    __mathDintToDouble(resultHigh, resultPacked)
}


/** The arctangent of x in [-pi/2, pi/2], correctly rounded. */
fun atan(x: f64): f64 {
    // A port of CORE-MATH's atan.c (copyright 2023-2026 Alexei Sibidanov,
    // MIT licence: see the end of this file).
    val xb = f64ToBits(x)
    val at = xb & 0x7fffffffffffffff
    if (at < 0x3f7b21c475e6362a) {
        // |x| < 0x1.b21c475e6362ap-8
        if (at == 0) return x
        // |x| < 2^-27: atan(x) = x - x^3/3 + ... rounds to x
        if (at < 0x3e40000000000000) return x
        val x2 = x * x
        val x3 = x * x2
        val x4 = x2 * x2
        val f = x3 * ((f64FromBits(-4623695617433709227) + x2 * f64FromBits(4596373779694328001)) +
            x4 * (f64FromBits(-4629057045575323968) + x2 * f64FromBits(4592670101477633664)))
        val ub = (f + f * f64FromBits(4383691287291756544)) + x
        if (ub == (f - f * f64FromBits(4379187687664386048)) + x) return ub
        return __mathAtanRefine(x, ub)
    }
    var h = 0.0
    var ah = 0.0
    var al = 0.0
    val sign = if (xb < 0) -1.0 else 1.0
    if (at > 0x4062ded8e34a9035) {
        // |x| > 0x1.2ded8e34a9035p+7: atan(x) = ±pi/2 + atan(-1/x)
        ah = sign * mathHalfPi
        al = sign * f64FromBits(4364452196894661639)
        if (at >= 0x434d02967c31cdb5) {
            // |x| >= 0x1.d02967c31cdb5p+53
            if (at > 0x7ff0000000000000) return x + x
            return ah + al
        }
        h = -1.0 / x
    } else {
        // atan(x) = pi j / 256 + atan((x - t) / (1 + x t)) with t = tan(pi j / 256)
        val r = 3 * ((at >>> 51) - 2030)
        val ut = (xb & (-1 >>> 13)) >>> 35
        val ut2 = (ut * ut) >>> 16
        val j = ((__mathAtanIndex(r) << 16) + ut * __mathAtanIndex(r + 1) -
            ut2 * __mathAtanIndex(r + 2)) >>> 25
        val ta = sign * f64FromBits(__mathAtanTan(j))
        val id = sign * f64FromInt(j)
        al = sign * f64FromBits(__mathAtanTanError(j)) + f64FromBits(4361813860320825712) * id
        h = (x - ta) / (1.0 + x * ta)
        ah = f64FromBits(4578227859533081856) * id
    }
    val h2 = h * h
    val h4 = h2 * h2
    val f = (1.0 + h2 * f64FromBits(-4623695617433709269)) +
        h4 * (f64FromBits(4596373779684695072) + h2 * f64FromBits(-4629057396843197754))
    al = h * f + al
    // CORE-MATH's bound h 0x3.fp-52, widened by h 2^-53 for the unfused h f + al
    val e = h * f64FromBits(4382565387384913920)
    val ub = (al + e) + ah
    if (ub == (al - e) + ah) return ub
    __mathAtanRefine(x, ub)
}

// atan(x) for 2^-27 <= |x| to about 2^-118, rounded; a is the fast path's
// estimate.
@noinline
fun __mathAtanRefine(x: f64, a: f64): f64 {
    val sign = if (x < 0.0) -1.0 else 1.0
    val phi = f64ToBits(fabs(a) * f64FromBits(4635434578076092547) + 256.5)
    // 256.5 < phi < 384.5
    val i = (phi >>> 44) & 0xff
    var h = 0.0
    var hl = 0.0
    if (i == 128) {
        h = -1.0 / x
        val p = h * x
        hl = ((p + 1.0) + __mathMulLow(h, x, p)) * h
    } else {
        val ta = sign * f64FromBits(__mathAtanTan(i))
        val zta = x * ta
        val ztal = __mathMulLow(x, ta, zta)
        val zmta = x - ta
        val v = 1.0 + zta
        val d = 1.0 - v
        val ev = (d + zta) - ((d + v) - 1.0) + ztal
        val r = 1.0 / v
        val rv = r * v
        val rl = (((1.0 - rv) - __mathMulLow(r, v, rv)) - ev * r) * r
        h = r * zmta
        hl = __mathMulLow(r, zmta, h) + rl * zmta
    }
    // h2 = h^2 and h3 = h^3 as double-doubles
    var h2 = h * h
    var h2l = (h * hl + hl * h) + __mathMulLow(h, h, h2)
    var sum = h2 + h2l
    h2l = h2l - (sum - h2)
    h2 = sum
    val h4 = h2 * h2
    var h3 = h2 * h
    var h3l = (h2 * hl + h2l * h) + __mathMulLow(h2, h, h3)
    sum = h3 + h3l
    h3l = h3l - (sum - h3)
    h3 = sum
    // f = (-1/3 + h2/5 - h2^2/7 + ...) as a double-double, then f h3
    var fl = h2 * ((f64FromBits(4592670820000712476) + h2 * f64FromBits(-4632156925824527771)) +
        h4 * (f64FromBits(4590207312473082820) + h2 * f64FromBits(-4633904415723670957)))
    var ch = f64FromBits(-4629057045561531246) + fl
    var cl = (f64FromBits(-4629057045561531246) - ch) + fl + f64FromBits(-4872251427347251178)
    var k = 1
    while (k >= 0) {
        val c0 = if (k == 1) f64FromBits(4596373779694328218) else f64FromBits(-4623695617433709227)
        val c1 = if (k == 1) f64FromBits(-4870192637038445384) else f64FromBits(-4866889997311716011)
        // (ch, cl) (h2, h2l), then + (c0, c1)
        val mh = ch * h2
        val ml = (ch * h2l + cl * h2) + __mathMulLow(ch, h2, mh)
        val mhs = mh + ml
        val mls = ml - (mhs - mh)
        val th = mhs + c0
        val tl = (c0 - th) + mhs
        ch = th
        cl = mls + (tl + c1)
        k -= 1
    }
    var f = ch * h3
    fl = (ch * h3l + cl * h3) + __mathMulLow(ch, h3, f)
    sum = f + fl
    fl = fl - (sum - f)
    f = sum
    var ah = 0.0
    var al = 0.0
    var at = 0.0
    if (i == 0) {
        ah = h
        al = f
        at = fl
    } else {
        val df = if (i < 128) sign * f64FromBits(__mathAtanTanError(i)) else 0.0
        val id = sign * f64FromInt(i)
        ah = f64FromBits(4578227859533081856) * id
        al = f64FromBits(4361813860320825728) * id
        at = f64FromBits(-5080120883755499648) * id
        // (al, at) += df, h + hl, f + fl
        var s = al + df
        var dd = s - al
        at = ((df - dd) + (al + (dd - s))) + at
        al = s
        s = al + h
        dd = s - al
        at = ((h - dd) + (al + (dd - s))) + (at + hl)
        al = s
        s = al + f
        dd = s - al
        at = ((f - dd) + (al + (dd - s))) + (at + fl)
        al = s
    }
    val v0 = ah + al
    var v2 = al - (v0 - ah)
    var v1 = v2 + at
    v2 = at - (v1 - v2)
    val t0 = f64ToBits(v0)
    var t1 = f64ToBits(v1)
    if (((t1 + 1) & 0xfffffffffffff) <= 2 || ((t0 >>> 52) & 0x7ff) - ((t1 >>> 52) & 0x7ff) > 103) {
        val ax = fabs(x)
        var j = 0
        while (j < 12) {
            if (ax == f64FromBits(__mathAtanExceptions(3 * j))) {
                return sign * f64FromBits(__mathAtanExceptions(3 * j + 1)) +
                    sign * f64FromBits(__mathAtanExceptions(3 * j + 2))
            }
            j += 1
        }
        if ((t1 & 0xfffffffffffff) == 0) {
            // v1 a power of 2: move it one ulp toward the sign of v2
            if (((f64ToBits(v2) ^ t1) >>> 63) != 0) t1 -= 1 else t1 += 1
            v1 = f64FromBits(t1)
        }
    }
    v1 + v0
}

/** The sine of x (radians), correctly rounded for every finite x. */
fun sin(x: f64): f64 = __mathSinCos(x, 0)

/** The cosine of x (radians), correctly rounded for every finite x. */
fun cos(x: f64): f64 = __mathSinCos(x, 1)

// sin(x) for quarter 0, cos(x) = sin(|x| + pi/2) for quarter 1: a port of
// CORE-MATH's sin.c (copyright 2022-2026 Paul Zimmermann, Tom Hubrecht and
// Alexei Sibidanov, MIT licence: see the end of this file). Its reduction
// measures x in turns, so cos is the same computation a quarter turn on,
// exactly.
fun __mathSinCos(x: f64, quarter: int): f64 {
    val xb = f64ToBits(x)
    val e = (xb >>> 52) & 0x7ff
    if (quarter == 0) {
        // |x| < 2^-26: sin(x) = x - x^3/6 + ... rounds to x
        if (e < 0x3ff - 26) return x
    } else if (e < 0x3ff - 27) {
        // |x| < 2^-27: cos(x) = 1 - x^2/2 + ... rounds to 1
        return 1.0
    }
    if (e >= 0x3ff + 31) {
        if (e == 0x7ff) return x - x
        return __mathSinCosLarge(x, quarter)
    }
    // |x| < 2^31: x = k pi / 2^14 + r, with 2^14 (pih + pil) = -pi
    val ax = fabs(x)
    val k = roundEven(f64FromBits(4662456175840315523) * ax)
    val pih = f64FromBits(-4672165775085916904)
    val kp = k * pih
    // ax + k pih is exact (CORE-MATH's fma)
    val rh = (ax + kp) + __mathMulLow(k, pih, kp)
    val r = rh + k * f64FromBits(-4917466635115930617)
    val r2 = r * r
    val j = f64ToInt(k) + (quarter << 13)
    // an odd multiple of pi negates
    val sbit = (if (quarter == 0 && xb < 0) 1 else 0) ^ ((j >> 14) & 1)
    val i1 = (j >> 7) & 0x7f
    val i2 = j & 0x7f
    // sin and cos of j pi / 2^14 from j's two 7-bit halves
    val u1sh = f64FromBits(__mathSinU1SinHigh(i1))
    val u1ch = f64FromBits(__mathSinU1CosHigh(i1))
    val u2sh = f64FromBits(__mathSinU2SinHigh(i2))
    val u2ch = f64FromBits(__mathSinU2CosHigh(i2))
    val s1h = u1sh * u2ch
    val s1l = (u1sh * f64FromBits(__mathSinU2CosLow(i2)) +
        f64FromBits(__mathSinU1SinLow(i1)) * u2ch) + __mathMulLow(u1sh, u2ch, s1h)
    val s2h = u2sh * u1ch
    val s2l = (u2sh * f64FromBits(__mathSinU1CosLow(i1)) +
        f64FromBits(__mathSinU2SinLow(i2)) * u1ch) + __mathMulLow(u2sh, u1ch, s2h)
    val sh0 = s1h + s2h
    val sl0 = (s1l + s2l) + (s2h - (sh0 - s1h))
    val ch0 = u1ch * u2ch - u1sh * u2sh
    // sin(r) - r and cos(r) - 1 to 2^-76.494 and 2^-92.723 for |r| <= 2^-13.339
    val sr = r * (1.0 - f64FromBits(4595172819791276272) * r2)
    val cr = r2 * (-0.5 + f64FromBits(4586165620537294128) * r2)
    val sign = if (sbit == 1) -1.0 else 1.0
    val fh = sign * sh0
    val fl = sign * ((sl0 + sh0 * cr) + ch0 * sr)
    val eps = f64FromBits(4322857507950166016)
    val lb = fh + (fl - eps)
    if (lb == fh + (fl + eps)) return lb
    if (quarter == 0 && ax < f64FromBits(4535124824762089472)) return __mathSinSmall(x)
    __mathSinCosAccurate(x, quarter)
}

// The fast path for |x| >= 2^31.
@noinline
fun __mathSinCosLarge(x: f64, quarter: int): f64 {
    // x / (2 pi) mod 1 = j / 2^15 + r + s with 0 <= r < 2^-15, 0 <= s < 2^-67.988
    val xb = f64ToBits(x)
    val e = (xb >>> 52) & 0x7ff
    val m = (1 << 52) | (xb & 0xfffffffffffff)
    val i = (e - 1011) / 64
    val f = (e - 1011) & 0x3f
    var v0 = __mathSinInvTwoPi(i)
    var v1 = __mathSinInvTwoPi(i + 1)
    if (f != 0) {
        v0 = (v0 << f) | (v1 >>> (64 - f))
        v1 = (v1 << f) | (__mathSinInvTwoPi(i + 2) >>> (64 - f))
    }
    // u = m (v0 2^64 + v1) mod 2^128, rounded at bit 60 (CORE-MATH's magic)
    var ul = v1 * m
    var uh = __mathMulHigh(m, v1) + v0 * m + (1 << 48)
    val low = ul + 580964351930793984
    if (__mathULess(low, ul)) uh += 1
    ul = low
    val r = f64FromInt(((ul >>> 60) | (uh << 4)) & 0x1fffffffffffff) *
        f64FromBits(4300937644138823680) - f64FromBits(4535124824762089472)
    val j = ((uh >>> 49) + (quarter << 13)) & 0x7fff
    val sbit = (if (quarter == 0 && xb < 0) 1 else 0) ^ (j >> 14)
    val i1 = (j >> 7) & 0x7f
    val i2 = j & 0x7f
    val r2 = r * r
    val u1sh = f64FromBits(__mathSinU1SinHigh(i1))
    val u1ch = f64FromBits(__mathSinU1CosHigh(i1))
    val u2sh = f64FromBits(__mathSinU2SinHigh(i2))
    val u2ch = f64FromBits(__mathSinU2CosHigh(i2))
    val s1h = u1sh * u2ch
    val s1l = (u1sh * f64FromBits(__mathSinU2CosLow(i2)) +
        f64FromBits(__mathSinU1SinLow(i1)) * u2ch) + __mathMulLow(u1sh, u2ch, s1h)
    val s2h = u2sh * u1ch
    val s2l = (u2sh * f64FromBits(__mathSinU1CosLow(i1)) +
        f64FromBits(__mathSinU2SinLow(i2)) * u1ch) + __mathMulLow(u2sh, u1ch, s2h)
    val sh0 = s1h + s2h
    val sl0 = (s1l + s2l) + (s2h - (sh0 - s1h))
    val ch0 = u1ch * u2ch - u1sh * u2sh
    // r in turns: sin(2 pi r) - 2 pi r and cos(2 pi r) - 1
    val sr = r * (f64FromBits(4618760256179416344) - f64FromBits(4631015144467146449) * r2)
    val cr = r2 * (f64FromBits(-4597122725834766882) + f64FromBits(4634270120108634243) * r2)
    val sign = if (sbit == 1) -1.0 else 1.0
    val fh = sign * sh0
    val fl = sign * ((sl0 + sh0 * cr) + ch0 * sr)
    val eps = f64FromBits(4323473234461720576)
    val lb = fh + (fl - eps)
    if (lb == fh + (fl + eps)) return lb
    __mathSinCosAccurate(x, quarter)
}

// sin(x) for 2^-26 <= |x| < 2^-16 to 2^-112.7 relative, rounded.
@noinline
fun __mathSinSmall(x: f64): f64 {
    val x2h = x * x
    val x2l = __mathMulLow(x, x, x2h)
    // x + (c3h + c3l) x^3 + c5 x^5
    val c3h = f64FromBits(-4628199217061079723)
    var h = f64FromBits(4575957461383545984) * x2h
    h = h + f64FromBits(-4871393599712008216)
    var sum = c3h + h
    var l = h - (sum - c3h)
    h = sum
    var p = h * x2h
    l = (h * x2l + l * x2h) + __mathMulLow(h, x2h, p)
    h = p
    p = h * x
    l = (h * 0.0 + l * x) + __mathMulLow(h, x, p)
    h = p
    sum = x + h
    l = l + (h - (sum - x))
    sum + l
}

// The high 128 bits of the 256-bit product (ah, al) (bh, bl), less the
// low halves' product: word `part` (0 high, 1 low) of CORE-MATH's mhUU.
@noinline
fun __mathMhUU(ah: int, al: int, bh: int, bl: int, part: int): int {
    var hi = __mathMulHigh(ah, bh)
    var lo = ah * bh
    val c1 = __mathMulHigh(ah, bl)
    var sum = lo + c1
    if (__mathULess(sum, lo)) hi += 1
    lo = sum
    val c2 = __mathMulHigh(al, bh)
    sum = lo + c2
    if (__mathULess(sum, lo)) hi += 1
    if (part == 0) hi else sum
}

// sin(x) (quarter 0) or cos(x) (quarter 1) for |x| >= 2^-16, |x| >= 2^-27
// for cos, by 128-bit fixed point: 2^-128 absolute.
@noinline
fun __mathSinCosAccurate(x: f64, quarter: int): f64 {
    // x / (2 pi) mod 1 = k / 2^13 + r / 2^128 + eps with |r / 2^128| <= 2^-14
    val xb = f64ToBits(x)
    val e = (xb >>> 52) & 0x7ff
    val m = (1 << 52) | (xb & 0xfffffffffffff)
    val i = -1 + (e - 947) / 64
    val f = (e - 1011) & 0x3f
    var v0 = if (i >= 0) __mathSinInvTwoPi(i) else 0
    var v1 = __mathSinInvTwoPi(i + 1)
    var v2 = __mathSinInvTwoPi(i + 2)
    if (f != 0) {
        v0 = (v0 << f) | (v1 >>> (64 - f))
        v1 = (v1 << f) | (v2 >>> (64 - f))
        v2 = (v2 << f) | (__mathSinInvTwoPi(i + 3) >>> (64 - f))
    }
    var ul = v1 * m
    var uh = __mathMulHigh(m, v1) + v0 * m
    val vh = __mathMulHigh(m, v2)
    var sum = ul + vh
    if (__mathULess(sum, ul)) uh += 1
    ul = sum
    var k = uh >>> 51
    uh = uh & 0x7ffffffffffff
    // round k to nearest: r negative when its top bit is set
    val neg = (uh >>> 50) & 1
    if (neg == 1) {
        k = (k + 1) & 0x1fff
        val borrow = if (ul != 0) 1 else 0
        ul = -ul
        uh = 0x8000000000000 - uh - borrow
    }
    k = (k + (quarter << 11)) & 0x1fff
    // r = 2 pi r: twopi / 2^128 approximates 2 pi / 2^3, so r << 3 first
    val sh3 = (uh << 3) | (ul >>> 61)
    val sl3 = ul << 3
    val twoPiHigh = -3958705157555305932
    val twoPiLow = -4267615245585081135
    val rh = __mathMhUU(twoPiHigh, twoPiLow, sh3, sl3, 0)
    val rl = __mathMhUU(twoPiHigh, twoPiLow, sh3, sl3, 1)
    val u2h = __mathMhUU(rh, rl, rh, rl, 0)
    val u2l = __mathMhUU(rh, rl, rh, rl, 1)
    val u4h = __mathMhUU(u2h, u2l, u2h, u2l, 0)
    val u4l = __mathMhUU(u2h, u2l, u2h, u2l, 1)
    var sbit = (if (quarter == 0 && xb < 0) 1 else 0) ^ (k >>> 12)
    val i1 = (k >> 6) & 0x3f
    val i2 = k & 0x3f
    // |sin| and |cos| of t1 = pi i1 / 2^6 from S1 (sin(pi - t) = sin t,
    // cos t = sin(t + pi/2)), and of t2 = pi i2 / 2^12 from S2 and C2
    val si = if (i1 <= 32) i1 else 64 - i1
    val ci = if (i1 <= 32) 32 - i1 else i1 - 32
    val s1h = __mathSinS1(2 * si)
    val s1l = __mathSinS1(2 * si + 1)
    val c1h = __mathSinS1(2 * ci)
    val c1l = __mathSinS1(2 * ci + 1)
    val c2h = __mathSinC2(2 * i2)
    val c2l = __mathSinC2(2 * i2 + 1)
    val s2h = __mathSinS2(2 * i2)
    val s2l = __mathSinS2(2 * i2 + 1)
    // sin(t1 + t2) and cos(t1 + t2)
    var sah = __mathMhUU(s1h, s1l, c2h, c2l, 0)
    var sal = __mathMhUU(s1h, s1l, c2h, c2l, 1)
    var th = __mathMhUU(c1h, c1l, s2h, s2l, 0)
    var tl = __mathMhUU(c1h, c1l, s2h, s2l, 1)
    if (i1 < 32) {
        sum = sal + tl
        sah = sah + th + (if (__mathULess(sum, sal)) 1 else 0)
        sal = sum
    } else {
        val borrow = if (__mathULess(sal, tl)) 1 else 0
        sal = sal - tl
        sah = sah - th - borrow
    }
    var cah = __mathMhUU(c1h, c1l, c2h, c2l, 0)
    var cal = __mathMhUU(c1h, c1l, c2h, c2l, 1)
    th = __mathMhUU(s1h, s1l, s2h, s2l, 0)
    tl = __mathMhUU(s1h, s1l, s2h, s2l, 1)
    if (i1 < 32) {
        val borrow = if (__mathULess(cal, tl)) 1 else 0
        cal = cal - tl
        cah = cah - th - borrow
    } else {
        sum = cal + tl
        cah = cah + th + (if (__mathULess(sum, cal)) 1 else 0)
        cal = sum
    }
    // Sr ~ |sin(2 pi r)|: ((PS2 - PS3 u2h) u4 + PS0 - PS1 u2) r
    var ph = 0
    var pl = 0
    val ps3h = __mathMulHigh(3660068251760110, u2h)
    val ps3l = 3660068251760110 * u2h
    var borrow = if (__mathULess(5078804202268594761, ps3l)) 1 else 0
    pl = 5078804202268594761 - ps3l
    ph = 153722867280912928 - ps3h - borrow
    val qh = __mathMhUU(ph, pl, u4h, u4l, 0)
    val ql = __mathMhUU(ph, pl, u4h, u4l, 1)
    var wh = __mathMhUU(3074457345618258602, -6148916092404267218, u2h, u2l, 0)
    var wl = __mathMhUU(3074457345618258602, -6148916092404267218, u2h, u2l, 1)
    borrow = if (__mathULess(-15466, wl)) 1 else 0
    wl = -15466 - wl
    wh = -1 - wh - borrow
    sum = wl + ql
    wh = wh + qh + (if (__mathULess(sum, wl)) 1 else 0)
    wl = sum
    val srh = __mathMhUU(wh, wl, rh, rl, 0)
    val srl = __mathMhUU(wh, wl, rh, rl, 1)
    // Cr ~ cos(2 pi r): PC0 - PC1 u2 + (PC2 - (PC3 - u2h PC4) u2) u4
    val pc4h = __mathMulHigh(u2h, 457505244861708)
    val pc4l = u2h * 457505244861708
    borrow = if (__mathULess(7214788301902850230, pc4l)) 1 else 0
    pl = 7214788301902850230 - pc4l
    ph = 25620477880151066 - pc4h - borrow
    val nh = __mathMhUU(ph, pl, u2h, u2l, 0)
    val nl = __mathMhUU(ph, pl, u2h, u2l, 1)
    borrow = if (__mathULess(-6151131022696553785, nl)) 1 else 0
    pl = -6151131022696553785 - nl
    ph = 768614336404564650 - nh - borrow
    wh = __mathMhUU(9223372036854775807, -90600464, u2h, u2l, 0)
    wl = __mathMhUU(9223372036854775807, -90600464, u2h, u2l, 1)
    borrow = if (__mathULess(-1, wl)) 1 else 0
    wl = -1 - wl
    wh = -1 - wh - borrow
    val mh = __mathMhUU(ph, pl, u4h, u4l, 0)
    val ml = __mathMhUU(ph, pl, u4h, u4l, 1)
    sum = wl + ml
    val crh = wh + mh + (if (__mathULess(sum, wl)) 1 else 0)
    val crl = sum
    // sin(x) ~ sin(t1 + t2) Cr + cos(t1 + t2) Sr
    val ah = __mathMhUU(sah, sal, crh, crl, 0)
    val al = __mathMhUU(sah, sal, crh, crl, 1)
    val bh = __mathMhUU(cah, cal, srh, srl, 0)
    val bl = __mathMhUU(cah, cal, srh, srl, 1)
    var resh = 0
    var resl = 0
    if ((i1 < 32) != (neg == 1)) {
        resl = al + bl
        resh = ah + bh + (if (__mathULess(resl, al)) 1 else 0)
    } else if (__mathULess(ah, bh) || (ah == bh && __mathULess(al, bl))) {
        borrow = if (__mathULess(bl, al)) 1 else 0
        resl = bl - al
        resh = bh - ah - borrow
        sbit = sbit ^ 1
    } else {
        borrow = if (__mathULess(al, bl)) 1 else 0
        resl = al - bl
        resh = ah - bh - borrow
    }
    // round (-1)^sbit res / 2^128: res's top word is never 0 here
    val shift = __mathClz(resh)
    val n = 75 - shift
    val top = if (n < 64) (resl >>> n) | (resh << (64 - n)) else resh >>> (n - 64)
    val roundBit = if (n - 1 < 64) (resl >>> (n - 1)) & 1 else (resh >>> (n - 65)) & 1
    val scale = f64FromBits(
        (if (sbit == 1) -4854880398305394688 else 4368491638549381120) - (shift << 52))
    val a = f64FromInt(top) * scale
    val b = (if (roundBit == 1) f64FromBits(4604930618986332160) else f64FromBits(4600427019358961664)) * scale
    a + b
}

/** The tangent of x (radians), correctly rounded for every finite x. */
fun tan(x: f64): f64 {
    // CORE-MATH's tan.c (copyright 2022-2025 Paul Zimmermann and Tom Hubrecht,
    // MIT licence: see the end of this file) reduces x; sin's tables then give
    // sin and cos of the reduced angle.
    val xb = f64ToBits(x)
    if (((xb >>> 52) & 0x7ff) == 0x7ff) return x - x
    // |x| <= 0x1.d12ed0af1a27ep-27: tan(x) = x + x^3/3 + ... rounds to x
    if ((xb & 0x7fffffffffffffff) <= 0x3e4d12ed0af1a27e) return x
    var neg = if (xb < 0) 1 else 0
    val ax = fabs(x)
    // x / (2 pi) mod 1 = i / 2^11 + h + l, to 2^-104.815
    var h = 0.0
    var l = 0.0
    // h + l is off by below 2^-110.5 turns for x < 2 pi, 2^-104.8 above
    val nearZeroError = if (ax <= f64FromBits(4618760256179416343)) f64FromBits(4115244174752549568)
        else f64FromBits(4140771054780522527)
    if (ax <= f64FromBits(4618760256179416343)) {
        // x < 2 pi: (CH + CL) x with CH + CL = 1/(2 pi) to 2^-110.523
        val ch = f64FromBits(4594902181429758083)
        h = ch * ax
        l = __mathMulLow(ch, ax, h)
        l = f64FromBits(-4871012300749705130) * ax + l
    } else {
        h = __mathTanReduceLarge(xb, 0)
        l = __mathTanReduceLarge(xb, 1)
    }
    val fi = floor(h * f64FromBits(4656722014701092864))
    h = h - fi * f64FromBits(4557642822898941952)
    var i = f64ToInt(fi) & 0x3ff
    // tan(x + pi) = tan(x); tan(x + pi/2) = -cot(x); tan(pi/2 - x) = cot(x)
    var isTan = 1 ^ (i >> 9)
    neg = neg ^ (i >> 9)
    i = i & 0x1ff
    if ((i & 0x100) != 0) {
        isTan = 1 - isTan
        i = 0x1ff - i
        h = f64FromBits(4557642822898941952) - h
        l = -l
    }
    // R = i / 2^11 + h + l turns; j / 2^15 is the nearest point of sin's tables
    val k = roundEven(h * 32768.0)
    val d = h - k * f64FromBits(4539628424389459968)
    val j = (i << 4) + f64ToInt(k)
    val i1 = j >> 7
    val i2 = j & 0x7f
    val u1sh = f64FromBits(__mathSinU1SinHigh(i1))
    val u1sl = f64FromBits(__mathSinU1SinLow(i1))
    val u1ch = f64FromBits(__mathSinU1CosHigh(i1))
    val u1cl = f64FromBits(__mathSinU1CosLow(i1))
    val u2sh = f64FromBits(__mathSinU2SinHigh(i2))
    val u2sl = f64FromBits(__mathSinU2SinLow(i2))
    val u2ch = f64FromBits(__mathSinU2CosHigh(i2))
    val u2cl = f64FromBits(__mathSinU2CosLow(i2))
    // sin a = sin a1 cos a2 + cos a1 sin a2 and cos a = cos a1 cos a2 - sin a1 sin a2
    // as double-doubles (a = 2 pi j / 2^15 <= pi/4, so cos a >= sin a)
    val p1 = u1sh * u2ch
    val p1l = (u1sh * u2cl + u1sl * u2ch) + __mathMulLow(u1sh, u2ch, p1)
    val p2 = u1ch * u2sh
    val p2l = (u1ch * u2sl + u1cl * u2sh) + __mathMulLow(u1ch, u2sh, p2)
    val sah = p1 + p2
    val sb = sah - p1
    val sal = (p1l + p2l) + ((p1 - (sah - sb)) + (p2 - sb))
    val q1 = u1ch * u2ch
    val q1l = (u1ch * u2cl + u1cl * u2ch) + __mathMulLow(u1ch, u2ch, q1)
    val q2 = u1sh * u2sh
    val q2l = (u1sh * u2sl + u1sl * u2sh) + __mathMulLow(u1sh, u2sh, q2)
    val cah = q1 - q2
    val cal = (q1l - q2l) + ((q1 - cah) - q2)
    // delta = 2 pi (d + l) radians, |delta| <= 2^-13.35: sin delta = dh + dl + sr
    // and cos delta = 1 + cr, cr rounded once (2^-80.7)
    val dh = f64FromBits(4618760256179416344) * d
    val dl = __mathMulLow(f64FromBits(4618760256179416344), d, dh) +
        (f64FromBits(4373459396149402631) * d + f64FromBits(4618760256179416344) * l)
    val u = dh * dh
    val ul = __mathSquareLow(dh, u)
    val sr = (dh * u) * (f64FromBits(4575957461383581969) * u - f64FromBits(4595172819793696085)) -
        0.5 * u * dl
    val cr = (u * ((f64FromBits(4586165620538955093) - f64FromBits(4564047942368979991) * u) * u - 0.5) -
        0.5 * ul) - dh * dl
    // S = sin a cos delta + cos a sin delta, C = cos a cos delta - sin a sin delta
    val m1 = cah * dh
    val m1l = __mathMulLow(cah, dh, m1) + (cah * (dl + sr) + cal * dh)
    val sh = sah + m1
    val tb = sh - sah
    val sl = ((sah - (sh - tb)) + (m1 - tb)) + ((sal + sah * cr) + m1l)
    val m2 = sah * dh
    val m2l = __mathMulLow(sah, dh, m2) + (sah * (dl + sr) + sal * dh)
    val ch = cah - m2
    val cl = ((cah - ch) - m2) + ((cal + cah * cr) - m2l)
    // renormalized (their low parts carry cr, far above an ulp), then
    // tan = S / C, cot = C / S (Karp-Markstein)
    val sn = sh + sl
    val sln = sl - (sn - sh)
    val cn = ch + cl
    val cln = cl - (cn - ch)
    val bh = if (isTan == 1) sn else cn
    val bl = if (isTan == 1) sln else cln
    val ah = if (isTan == 1) cn else sn
    val al = if (isTan == 1) cln else sln
    val y = 1.0 / ah
    var qh = bh * y
    val p = ah * qh
    val eh = (bh - p) - __mathMulLow(ah, qh, p)
    val el = bl - al * qh
    var ql = y * (eh + el)
    if (neg == 1) {
        qh = -qh
        ql = -ql
    }
    // relative error: 2^-77 for the arithmetic (cr's and sah cr's roundings
    // dominate), and the reduction's error in R magnified by up to 2.5 / R
    val r = f64FromInt(i) * f64FromBits(4557642822898941952) + h
    if (r >= f64FromBits(4490088828488384512)) {
        // the reduction's share is below 2^-77 too
        val err = fabs(qh) * f64FromBits(4264908847119859712)
        val left = qh + (ql - err)
        if (left == qh + (ql + err)) return left
    } else {
        val err = fabs(qh) * (f64FromBits(4260405247492489216) + nearZeroError / r)
        val left = qh + (ql - err)
        if (left == qh + (ql + err)) return left
    }
    __mathTanAccurate(x)
}

// The fast path's reduction for |x| > 2 pi (tan.c's): x / (2 pi) mod 1 as
// h + l, h for part 0 and l for part 1.
@noinline
fun __mathTanReduceLarge(xb: int, part: int): f64 {
    var h = 0.0
    var l = 0.0
    val e = (xb >>> 52) & 0x7ff
    val m = (1 << 52) | (xb & 0xfffffffffffff)
    var c0 = 0
    var c1 = 0
    var c2 = 0
    var shift = 0
    // tan.c's T[k] is __mathSinInvTwoPi(k + 1)
    if (e <= 1074) {
        // 2^2 <= x < 2^52
        val vh = __mathMulHigh(m, __mathSinInvTwoPi(3))
        val t1 = __mathSinInvTwoPi(2)
        val ul = m * t1
        c0 = ul + vh
        c1 = __mathMulHigh(m, t1) + (if (__mathULess(c0, ul)) 1 else 0)
        val t0 = __mathSinInvTwoPi(1)
        val u0 = m * t0
        c1 = c1 + u0
        c2 = __mathMulHigh(m, t0) + (if (__mathULess(c1, u0)) 1 else 0)
        shift = 1075 - e
    } else {
        val i = (e - 1138 + 63) / 64
        val vh = __mathMulHigh(m, __mathSinInvTwoPi(i + 4))
        val t2 = __mathSinInvTwoPi(i + 3)
        val u2 = m * t2
        c0 = u2 + vh
        c1 = __mathMulHigh(m, t2) + (if (__mathULess(c0, u2)) 1 else 0)
        val t1 = __mathSinInvTwoPi(i + 2)
        val u1 = m * t1
        c1 = c1 + u1
        c2 = __mathMulHigh(m, t1) + (if (__mathULess(c1, u1)) 1 else 0)
        c2 = c2 + m * __mathSinInvTwoPi(i + 1)
        shift = 1139 + (i << 6) - e
    }
    // drop the low `shift` bits (whole-turn bits gone with c2's top)
    if (shift == 64) {
        c0 = c1
        c1 = c2
    } else {
        c0 = (c1 << (64 - shift)) | (c0 >>> shift)
        c1 = (c2 << (64 - shift)) | (c1 >>> shift)
    }
    // h + l = c1 / 2^64 + c0 / 2^128, truncated
    if (c1 != 0) {
        val z = __mathClz(c1)
        if (z != 0) {
            c1 = (c1 << z) | (c0 >>> (64 - z))
            c0 = c0 << z
        }
        val f = 0x3fe - z
        h = f64FromBits((f << 52) | ((c1 << 1) >>> 12))
        c0 = (c1 << 53) | (c0 >>> 11)
        if (c0 != 0) {
            val g = __mathClz(c0)
            if (g != 0) c0 = c0 << g
            l = f64FromBits(((f - 53 - g) << 52) | ((c0 << 1) >>> 12))
        }
    } else if (c0 != 0) {
        val z = __mathClz(c0)
        val f = 0x3fe - 64 - z
        c0 = if (z + 1 < 64) c0 << (z + 1) else 0
        h = f64FromBits((f << 52) | (c0 >>> 12))
        c0 = c0 << 52
        if (c0 != 0) {
            val g = __mathClz(c0)
            c0 = if (g + 1 < 64) c0 << (g + 1) else 0
            l = f64FromBits(((f - 64 - g) << 52) | (c0 >>> 12))
        }
    }

    if (part == 0) h else l
}


// tan's accurate path: tan.c's 128-bit reduction of x, then sin and cos of the
// reduced angle by their Taylor series and the quotient, all with the
// out-of-line dint operations (slow, but rarely needed, and without tables).
@noinline
fun __mathTanAccurate(x: f64): f64 {
    val ax = fabs(x)
    // X = |x| as a dint
    val xbits = f64ToBits(ax)
    var be = (xbits >>> 52) & 0x7ff
    val bm = (xbits & 0xfffffffffffff) + (if (be != 0) 1 << 52 else 0)
    be = be - 0x3fe
    val lz = __mathClz(bm)
    var xh = bm << lz
    var xl = 0
    var xe = be - (if (lz > 11) lz - 12 else 0)
    // X / (2 pi) mod 1, relative error below 2^-126.67 (tan.c's T[k] is
    // __mathSinInvTwoPi(k + 1))
    if (xe <= 1) {
        val t1 = __mathSinInvTwoPi(2)
        val tiny = xh * t1
        xl = __mathMulHigh(xh, t1)
        val t0 = __mathSinInvTwoPi(1)
        val u0 = xh * t0
        xl = xl + u0
        xh = __mathMulHigh(xh, t0) + (if (__mathULess(xl, u0)) 1 else 0)
        // normalize, then fill the vacated low bits from tiny
        val before = xe
        if (xh != 0) {
            val c = __mathClz(xh)
            if (c != 0) {
                xh = (xh << c) | (xl >>> (64 - c))
                xl = xl << c
            }
            xe -= c
        } else if (xl != 0) {
            val c = __mathClz(xl)
            xh = xl << c
            xl = 0
            xe -= 64 + c
        }
        val moved = before - xe
        if (moved != 0) xl = xl | (tiny >>> (64 - moved))
    } else {
        val i = if (xe < 127) 0 else (xe - 127 + 63) / 64
        val ta = __mathSinInvTwoPi(i + 4)
        var c0 = xh * ta
        var c1 = __mathMulHigh(xh, ta)
        val tb = __mathSinInvTwoPi(i + 3)
        var u = xh * tb
        c1 = c1 + u
        var c2 = __mathMulHigh(xh, tb) + (if (__mathULess(c1, u)) 1 else 0)
        val tc = __mathSinInvTwoPi(i + 2)
        u = xh * tc
        c2 = c2 + u
        var c3 = __mathMulHigh(xh, tc) + (if (__mathULess(c2, u)) 1 else 0)
        val td = __mathSinInvTwoPi(i + 1)
        u = xh * td
        c3 = c3 + u
        val c4 = __mathMulHigh(xh, td) + (if (__mathULess(c3, u)) 1 else 0)
        val f = xe - 64 * i
        var tiny = 0
        if (f < 64) {
            xh = (c4 << f) | (c3 >>> (64 - f))
            xl = (c3 << f) | (c2 >>> (64 - f))
            tiny = (c2 << f) | (c1 >>> (64 - f))
        } else if (f == 64) {
            xh = c3
            xl = c2
            tiny = c1
        } else {
            val g = f - 64
            val extra = __mathMulHigh(xh, __mathSinInvTwoPi(i + 5))
            c0 = c0 + extra
            val carry = __mathULess(c0, extra)
            if (carry) c1 += 1
            if (carry && c1 == 0) c2 += 1
            if (carry && c1 == 0 && c2 == 0) c3 += 1
            xh = (c3 << g) | (c2 >>> (64 - g))
            xl = (c2 << g) | (c1 >>> (64 - g))
            tiny = (c1 << g) | (c0 >>> (64 - g))
        }
        xe = 0
        if (xh != 0) {
            val c = __mathClz(xh)
            if (c != 0) {
                xh = (xh << c) | (xl >>> (64 - c))
                xl = xl << c
            }
            xe -= c
        } else if (xl != 0) {
            val c = __mathClz(xl)
            xh = xl << c
            xl = 0
            xe -= 64 + c
        }
        if (xe < 0) xl = xl | (tiny >>> (64 + xe))
    }
    // X = i / 2^11 + X', exactly
    var i = 0
    if (xe > -11) {
        val sh = 64 - 11 - xe
        i = xh >>> sh
        xh = xh & ((1 << sh) - 1)
        if (xh != 0) {
            val c = __mathClz(xh)
            if (c != 0) {
                xh = (xh << c) | (xl >>> (64 - c))
                xl = xl << c
            }
            xe -= c
        } else if (xl != 0) {
            val c = __mathClz(xl)
            xh = xl << c
            xl = 0
            xe -= 64 + c
        }
    }
    var isTan = 1
    var neg = if (x < 0.0) 1 else 0
    i = i & 0x3ff
    if ((i & 0x200) != 0) {
        isTan = 0
        neg = 1 - neg
        i = i & 0x1ff
    }
    // X in the log/pow dint convention (hi / 2^63 * 2^ex): ex one less
    var xp = (xe - 1) << 1
    if ((i & 0x100) != 0) {
        // X = 2^-11 - X
        isTan = 1 - isTan
        val nh = __mathDintAdd(-9223372036854775808, 0, -22, xh, xl, xp | 1, 0)
        val nl = __mathDintAdd(-9223372036854775808, 0, -22, xh, xl, xp | 1, 1)
        xp = __mathDintAdd(-9223372036854775808, 0, -22, xh, xl, xp | 1, 2)
        xh = nh
        xl = nl
        i = 0x1ff - i
    }
    // theta = 2 pi R radians, R = i / 2^11 + X < 1/8 turn
    var ih = 0
    var ip = -1076 << 1
    if (i != 0) {
        val top = 63 - __mathClz(i)
        ih = i << (63 - top)
        ip = (top - 11) << 1
    }
    val il = 0
    val rh = __mathDintAdd(ih, il, ip, xh, xl, xp, 0)
    val rl = __mathDintAdd(ih, il, ip, xh, xl, xp, 1)
    val rp = __mathDintAdd(ih, il, ip, xh, xl, xp, 2)
    val wh = -3958705157555305932
    val wl = -4267615245585081135
    val wp = 4
    val th = __mathDintMul(rh, rl, rp, wh, wl, wp, 0)
    val tl = __mathDintMul(rh, rl, rp, wh, wl, wp, 1)
    val tp = __mathDintMul(rh, rl, rp, wh, wl, wp, 2)
    val uh = __mathDintMul(th, tl, tp, th, tl, tp, 0)
    val ul = __mathDintMul(th, tl, tp, th, tl, tp, 1)
    val up = __mathDintMul(th, tl, tp, th, tl, tp, 2)
    // sin theta = theta P(u) and cos theta = Q(u), Taylor to degree 33 and 32
    // (relative error below 2^-125 for theta <= pi/4)
    var sh = __mathTanTaylor(3 * 16)
    var sl = __mathTanTaylor(3 * 16 + 1)
    var sp = __mathTanTaylor(3 * 16 + 2)
    var ch = __mathTanTaylor(3 * 33)
    var cl = __mathTanTaylor(3 * 33 + 1)
    var cp = __mathTanTaylor(3 * 33 + 2)
    var n = 15
    while (n >= 0) {
        val ah = __mathDintMul(sh, sl, sp, uh, ul, up, 0)
        val al = __mathDintMul(sh, sl, sp, uh, ul, up, 1)
        val ap = __mathDintMul(sh, sl, sp, uh, ul, up, 2)
        val bh = __mathTanTaylor(3 * n)
        val bl = __mathTanTaylor(3 * n + 1)
        val bp = __mathTanTaylor(3 * n + 2)
        val n1h = __mathDintAdd(ah, al, ap, bh, bl, bp, 0)
        val n1l = __mathDintAdd(ah, al, ap, bh, bl, bp, 1)
        sp = __mathDintAdd(ah, al, ap, bh, bl, bp, 2)
        sh = n1h
        sl = n1l
        val eh = __mathDintMul(ch, cl, cp, uh, ul, up, 0)
        val el = __mathDintMul(ch, cl, cp, uh, ul, up, 1)
        val ep = __mathDintMul(ch, cl, cp, uh, ul, up, 2)
        val fh = __mathTanTaylor(3 * (n + 17))
        val fl = __mathTanTaylor(3 * (n + 17) + 1)
        val fp = __mathTanTaylor(3 * (n + 17) + 2)
        val n2h = __mathDintAdd(eh, el, ep, fh, fl, fp, 0)
        val n2l = __mathDintAdd(eh, el, ep, fh, fl, fp, 1)
        cp = __mathDintAdd(eh, el, ep, fh, fl, fp, 2)
        ch = n2h
        cl = n2l
        n -= 1
    }
    val n3h = __mathDintMul(sh, sl, sp, th, tl, tp, 0)
    val n3l = __mathDintMul(sh, sl, sp, th, tl, tp, 1)
    sp = __mathDintMul(sh, sl, sp, th, tl, tp, 2)
    sh = n3h
    sl = n3l
    // tan = S / C or cot = C / S: 1 / den by two Newton steps from a double
    val numh = if (isTan == 1) sh else ch
    val numl = if (isTan == 1) sl else cl
    val nump = if (isTan == 1) sp else cp
    val denh = if (isTan == 1) ch else sh
    val denl = if (isTan == 1) cl else sl
    val denp = if (isTan == 1) cp else sp
    val seed = 1.0 / f64FromBits((((denp >> 1) + 0x3ff) << 52) | ((denh >>> 11) & 0xfffffffffffff))
    var yh = __mathDintFrom(seed, 0)
    var yl = 0
    var yp = __mathDintFrom(seed, 2)
    val oneh = -9223372036854775808
    val onel = 0
    val onep = 0
    var step = 0
    while (step < 2) {
        val gh = __mathDintMul(denh, denl, denp, yh, yl, yp, 0)
        val gl = __mathDintMul(denh, denl, denp, yh, yl, yp, 1)
        val gp = __mathDintMul(denh, denl, denp, yh, yl, yp, 2)
        // 1 - den y
        val vh = __mathDintAdd(oneh, onel, onep, gh, gl, gp ^ 1, 0)
        val vl = __mathDintAdd(oneh, onel, onep, gh, gl, gp ^ 1, 1)
        val vp = __mathDintAdd(oneh, onel, onep, gh, gl, gp ^ 1, 2)
        val zh = __mathDintMul(yh, yl, yp, vh, vl, vp, 0)
        val zl = __mathDintMul(yh, yl, yp, vh, vl, vp, 1)
        val zp = __mathDintMul(yh, yl, yp, vh, vl, vp, 2)
        val n4h = __mathDintAdd(yh, yl, yp, zh, zl, zp, 0)
        val n4l = __mathDintAdd(yh, yl, yp, zh, zl, zp, 1)
        yp = __mathDintAdd(yh, yl, yp, zh, zl, zp, 2)
        yh = n4h
        yl = n4l
        step += 1
    }
    val qh = __mathDintMul(numh, numl, nump, yh, yl, yp, 0)
    val ql = __mathDintMul(numh, numl, nump, yh, yl, yp, 1)
    val qp = __mathDintMul(numh, numl, nump, yh, yl, yp, 2)
    // relative error below 2^-120: 256 ulps of the 128-bit result
    val lo0 = ql - 256
    val hi0 = qh - (if (__mathULess(ql, lo0)) 1 else 0)
    val lo1 = ql + 256
    val hi1 = qh + (if (__mathULess(lo1, ql)) 1 else 0)
    if ((hi0 >>> 10) != (hi1 >>> 10)) {
        // tan.c's two cases with more identical bits after the round bit
        if (fabs(x) == f64FromBits(4512043876671815455)) {
            return if (x > 0.0) f64FromBits(4512043876671816017) + f64FromBits(4269412446747230207)
                else -f64FromBits(4512043876671816017) - f64FromBits(4269412446747230207)
        }
        if (fabs(x) == f64FromBits(4516547476299185276)) {
            return if (x > 0.0) f64FromBits(4516547476299187526) + f64FromBits(-5276432344952675884)
                else -f64FromBits(4516547476299187526) - f64FromBits(-5276432344952675884)
        }
    }
    // to tan.c's convention (hi / 2^64 * 2^ex) for the rounding
    __mathTanDintToDouble(qh, ql, ((((qp >> 1) + 1) << 1) | ((qp & 1) ^ neg)))
}

// A dint rounded to the nearest double (tan.c's dint_tod).
fun __mathTanDintToDouble(hi0: int, lo0: int, p: int): f64 {
    var hi = hi0
    var lo = lo0
    var ex = p >> 1
    val sgn = p & 1
    if (ex <= -1023) {
        // subnormal: round at the right bit, to nearest
        val sh = -(1011 + ex)
        if (sh >= 64) {
            hi = 0
            lo = 0
        } else {
            var top = hi >>> sh
            val md = (hi >>> (sh - 1)) & 1
            // tan.c's sticky test, kept as written (tan never gets here)
            val rest = (hi & (-1 >>> sh)) != 0 || lo != 0
            top = top + (if (rest) md else top & md)
            hi = top << sh
            lo = 0
        }
        if (hi == 0) {
            ex += 1
            hi = 1 << 63
        }
    }
    var r = (hi >>> 11) | (0x3ff << 52)
    var rd = 0.0
    if (((hi >>> 10) & 1) != 0) rd = rd + f64FromBits(4368491638549381120)
    if ((hi & 0x3ff) != 0 || lo != 0) rd = rd + f64FromBits(4363988038922010624)
    if (sgn == 1) rd = -rd
    r = r | (sgn << 63)
    var value = f64FromBits(r) + rd
    var scale = 0.0
    if (ex > -1022) {
        if (ex > 1024) {
            if (ex == 1025) {
                value = value * 2.0
                scale = f64FromBits(9214364837600034816)
            } else {
                value = f64FromBits(9218868437227405311)
                scale = value
            }
        } else scale = f64FromBits(((ex + 1022) & 0x7ff) << 52)
    } else if (ex < -1073) {
        if (ex == -1074) {
            value = value * 0.5
            scale = f64FromBits(1)
        } else {
            value = f64FromBits(1)
            scale = value
        }
    } else scale = f64FromBits(1 << (ex + 1073))
    value * scale
}

// --- pow (CORE-MATH pow.c) ------------------------------------------------------

/** x raised to y, correctly rounded, with IEEE 754's special cases: pow(x, ±0)
 *  and pow(1, y) are 1 even for a NaN, pow(-1, ±inf) is 1, a negative x needs
 *  an integer y (NaN otherwise). */
fun pow(x0: f64, y: f64): f64 {
    // A port of CORE-MATH's pow.c (copyright 2022-2025 CERN and Inria, MIT
    // licence: see the end of this file).
    var x = x0
    var s = 1.0
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    val infBits = 0x7ff0000000000000
    if (u64(xb) >= u64(infBits) || u64(yb) >= u64(infBits)) {
        // a NaN, an infinity, or a negative x
        if (x != x) return if (y == 0.0 && (xb & (1 << 51)) != 0) 1.0 else x + x
        if (y != y) return if (x == 1.0 && (yb & (1 << 51)) != 0) 1.0 else y + y
        if (xb == infBits) {
            if (y == 0.0) return 1.0
            return if (y < 0.0) 0.0 else x
        }
        if (xb == (0xfff << 52)) {
            if (yb == infBits) return y
            if (yb == (0xfff << 52)) return 0.0
            if (__mathIsInt(y) && !__mathIsInt(y * 0.5)) return if (y < 0.0) -0.0 else x
            if (y < 0.0) return 0.0
            if (y > 0.0) return -x
        }
        if (yb == infBits) {
            if (x == 0.0) return 0.0
            if (x == -1.0 || x == 1.0) return 1.0
            return if (-1.0 < x && x < 1.0) 0.0 else y
        }
        if (yb == (0xfff << 52)) {
            if (x == 0.0) return -y
            if (x == -1.0 || x == 1.0) return 1.0
            return if (-1.0 < x && x < 1.0) -y else 0.0
        }
    }
    // x and y finite
    if (x <= 0.0) {
        if (y == 0.0) return 1.0
        val odd = __mathIsInt(y) && !__mathIsInt(y * 0.5)
        if (xb == 0) {
            if (odd) return if (y < 0.0) 1.0 / 0.0 else 0.0
            return if (y > 0.0) 0.0 else 1.0 / 0.0
        }
        if (xb == (1 << 63)) {
            if (odd) return if (y < 0.0) -1.0 / 0.0 else -0.0
            return if (y > 0.0) 0.0 else 1.0 / 0.0
        }
        if (!__mathIsInt(y)) return (x - x) / 0.0
        // the sign: negative for an odd y
        if (fabs(y) < f64FromBits(4845873199050653696) && (f64ToInt(y) & 1) != 0) s = -1.0
        x = -x
    }
    // phase 1: log(x) ~ lh + ll (CORE-MATH's log_1)
    val ub = f64ToBits(x)
    var m = ub & 0xfffffffffffff
    var e = (ub >>> 52) & 0x7ff
    var t = 0.0
    if (e != 0) {
        t = f64FromBits(m | (0x3ff << 52))
        m = m + (1 << 52)
        e = e - 0x3ff
    } else {
        // subnormal x
        val k = __mathClz(m) - 11
        e = -0x3fe - k
        m = m << k
        t = f64FromBits(m | (0x3ff << 52))
    }
    // above sqrt(2), halve t
    val c = if (m >= 0x16a09e667f3bcd) 1 else 0
    e = e + c
    val ee = f64FromInt(e)
    val i = (m >>> (44 + c)) - 181
    t = t * (if (c == 1) 0.5 else 1.0)
    val r = f64FromBits(__mathLogInverse(i))
    // z = r t - 1 exactly
    val z = __mathLogReduce(r, t)
    // e log(2) + l1 is exact
    val logHigh = f64FromBits(__mathLogInverseLogHigh(i))
    val logLow = f64FromBits(__mathLogInverseLogLow(i))
    val th = ee * f64FromBits(4604418534313441280) + logHigh
    val tl = __mathMulAdd(ee, f64FromBits(4408728642709317424), logLow)
    var lh = th + z
    var ll = (z - (lh - th)) + tl
    // log(1 + z) - z ~ ph + pl
    val wh = z * z
    val wl = __mathSquareLow(z, wh)
    val p5 = __mathMulAdd(f64FromBits(-4629700283583108914), z, f64FromBits(4594315131227032070))
    var u = __mathMulAdd(f64FromBits(-4628199217062666572), z, f64FromBits(4596373779692778805))
    var v = __mathMulAdd(f64FromBits(-4625196817309499389), z, f64FromBits(4599676419421066584))
    u = __mathMulAdd(p5, wh, u)
    v = __mathMulAdd(u, wh, v)
    u = v * wh
    val ph = -0.5 * wh
    val pl = __mathMulAdd(u, z, -0.5 * wl)
    var sum = lh + ph
    ll = (ph - (sum - lh)) + (ll + pl)
    lh = sum
    var cancel = 0
    if (e == 0 && fabs(ll) > fabs(lh) * f64FromBits(4499096027743125504)) {
        if (!ablaF64FmaIsFused()) {
            // cancellation: redo the sums with pl rounded once, as CORE-MATH's
            // fma(u, z, -wl / 2) is (pl's rounding error counts most here)
            val uz = u * z
            val half = -0.5 * wl
            val s1 = uz + half
            val b1 = s1 - uz
            val pl1 = s1 + (((uz - (s1 - b1)) + (half - b1)) + __mathMulLow(u, z, uz))
            lh = th + z
            ll = (z - (lh - th)) + tl
            sum = lh + ph
            ll = (ph - (sum - lh)) + (ll + pl1)
            lh = sum
        }
        sum = lh + ll
        ll = ll - (sum - lh)
        lh = sum
        cancel = 1
    }
    // no spurious underflow or overflow in y log(x)
    val ey = (yb >>> 52) & 0x7ff
    if (ey < 0x36 || ey >= 0x7f5) {
        lh = 0.0 / 0.0
        ll = lh
    }
    // y log(x) ~ rh + rl (a huge y is scaled for the exact product)
    val rh = y * lh
    var s0 = 0.0
    if (fabs(y) < f64FromBits(8930638061075693568)) s0 = __mathMulLow(y, lh, rh)
    else {
        val ys = y * f64FromBits(4318952042648305664)
        s0 = __mathMulLow(ys, lh, ys * lh) * f64FromBits(4895412794951729152)
    }
    val rl = __mathMulAdd(y, ll, s0)
    // exp(rh + rl) ~ resh + resl (CORE-MATH's exp_1)
    var resh = 0.0
    var resl = 0.0
    if (rh != rh || rh > f64FromBits(4649454530185505115)) {
        if (rh == rh && rh > f64FromBits(4649454530988760569)) {
            // overflow for sure
            resh = f64FromBits(9218868437227405311) * s
            resl = resh
        } else {
            resh = 0.0 / 0.0
            resl = resh
        }
    } else if (rh < f64FromBits(-4574386491771051601)) {
        if (rh < f64FromBits(-4573606559505020377)) {
            // underflow for sure
            resh = 0.0 * s
            resl = f64FromBits(1) * (0.5 * s)
        } else {
            resh = 0.0 / 0.0
            resl = resh
        }
    } else {
        val k = roundEven(rh * f64FromBits(4663219335549649662))
        val log2h = f64FromBits(4550375338784995823)
        // rh - k log2h is exact (CORE-MATH's fma)
        val kp = log2h * k
        val zh = (rh - kp) - __mathMulLow(log2h, k, kp)
        val zl = __mathMulAdd(f64FromBits(4303959781690409023), -k, rl)
        val kk = f64ToInt(k)
        val i2 = (kk >> 6) & 0x3f
        val i1 = kk & 0x3f
        // exp's tables (their low parts are less exact than CORE-MATH's pow
        // tables, by under 2^-104 of the result: inside the bound's margin)
        val t1h = f64FromBits(__mathExpT0High(i2))
        val t2h = f64FromBits(__mathExpT1High(i1))
        var eh = t2h * t1h
        var el = __mathMulAdd(t2h, f64FromBits(__mathExpT0Low(i2)),
            __mathMulAdd(f64FromBits(__mathExpT1Low(i1)), t1h, __mathMulLow(t2h, t1h, eh)))
        // exp(zh + zl) ~ qh + ql (CORE-MATH's q_1)
        val zz = zh + zl
        var q = __mathMulAdd(f64FromBits(4586165620542053773), zz, f64FromBits(4595172819798161814))
        q = __mathMulAdd(q, zz, 0.5)
        val h0 = __mathMulAdd(q, zz, 1.0)
        val h1 = zz * h0
        val l1 = __mathMulLow(zz, h0, h1)
        val qh = 1.0 + h1
        val ql = (h1 - (qh - 1.0)) + l1
        val p = eh * qh
        el = __mathMulAdd(eh, ql, __mathMulAdd(el, qh, __mathMulLow(eh, qh, p)))
        eh = p
        val scale = f64FromBits(((kk >> 12) + 0x3ff) << 52) * s
        resh = eh * scale
        resl = el * scale
    }
    // relative error 2^-57.579 with cancellation, as CORE-MATH; without,
    // CORE-MATH's 2^-63.797 where multiply-adds are fused (the steps above are
    // CORE-MATH's then), else doubled (y ll and u z each round once more, by up
    // to 2^-67.4 of the result)
    val err = if (cancel == 1) f64FromBits(4347504160598392832)
        else if (ablaF64FmaIsFused()) f64FromBits(4319638137904037888) else f64FromBits(4324141737531408384)
    val resMax = resh + __mathMulAdd(err, resh, resl)
    if (resh + __mathMulAdd(err, -resh, resl) == resMax) return resMax
    if (y == 1.0) return s * x
    if (y == 2.0) return x * x
    if (y == 0.5) return sqrt(x)
    __mathPowAccurate(x, y, s, x0, logHigh, logLow)
}

// x is an integer (x finite).
@inline
fun __mathIsInt(x: f64): bool = x == roundEven(x)

// pow's second phase for x > 0 (s the result's sign, x0 the original x):
// log(x) as log's accurate path computes it, y log(x), then exp in 128 bits
// (2^(k/64) from exp's table with a third part, and the Taylor series of the
// rest), all on the out-of-line operations. The relative error is below
// 2^-111.7: log's below 2^-122 (with |y log(x)| < 2^10 here), the rest below
// 2^-123. Only a result near a midpoint goes on to the exact-result check and
// the third phase.
@noinline
fun __mathPowAccurate(x: f64, y: f64, s: f64, x0: f64, logHigh: f64, logLow: f64): f64 {
    val xb = f64ToBits(x)
    var e = (xb >>> 52) & 0x7ff
    var m = xb & 0xfffffffffffff
    var t = 0.0
    if (e != 0) {
        t = f64FromBits(m | (0x3ff << 52))
        m = m + (1 << 52)
        e = e - 0x3ff
    } else {
        val k = __mathClz(m) - 11
        e = -0x3fe - k
        m = m << k
        t = f64FromBits(m | (0x3ff << 52))
    }
    val c = if (m >= 0x16a09e667f3bcd) 1 else 0
    e = e + c
    val i = (m >>> (44 + c)) - 181
    t = t * (if (c == 1) 0.5 else 1.0)
    val z = __mathLogReduce(f64FromBits(__mathLogInverse(i)), t)
    // log(1 + z) by its Taylor series, Horner from z^17 / 17
    val zh = __mathDintFrom(z, 0)
    val zl = 0
    val zp = __mathDintFrom(z, 2)
    var ph = __mathLogTaylor(48)
    var pl = __mathLogTaylor(49)
    var pp = __mathLogTaylor(50)
    var k = 15
    while (k >= -1) {
        val mh = __mathDintMul(ph, pl, pp, zh, zl, zp, 0)
        val ml = __mathDintMul(ph, pl, pp, zh, zl, zp, 1)
        val mp = __mathDintMul(ph, pl, pp, zh, zl, zp, 2)
        if (k < 0) {
            ph = mh
            pl = ml
            pp = mp
        } else {
            val ch = __mathLogTaylor(3 * k)
            val cl = __mathLogTaylor(3 * k + 1)
            val cp = __mathLogTaylor(3 * k + 2)
            ph = __mathDintAdd(ch, cl, cp, mh, ml, mp, 0)
            pl = __mathDintAdd(ch, cl, cp, mh, ml, mp, 1)
            pp = __mathDintAdd(ch, cl, cp, mh, ml, mp, 2)
        }
        k -= 1
    }
    // + (-log r) = l1 + l2 + l3 (l1 and l2 read by the first phase), smallest
    // first, then + e log(2)
    val l3 = f64FromBits(__mathLogInverseLogThird(i))
    val ah = __mathDintFrom(l3, 0)
    val al = 0
    val ap = __mathDintFrom(l3, 2)
    val bh = __mathDintFrom(logLow, 0)
    val bl = 0
    val bp = __mathDintFrom(logLow, 2)
    val gh = __mathDintAdd(bh, bl, bp, ah, al, ap, 0)
    val gl = __mathDintAdd(bh, bl, bp, ah, al, ap, 1)
    val gp = __mathDintAdd(bh, bl, bp, ah, al, ap, 2)
    val dh = __mathDintFrom(logHigh, 0)
    val dl = 0
    val dp = __mathDintFrom(logHigh, 2)
    val fh = __mathDintAdd(dh, dl, dp, gh, gl, gp, 0)
    val fl = __mathDintAdd(dh, dl, dp, gh, gl, gp, 1)
    val fp = __mathDintAdd(dh, dl, dp, gh, gl, gp, 2)
    val qh = __mathDintAdd(fh, fl, fp, ph, pl, pp, 0)
    val ql = __mathDintAdd(fh, fl, fp, ph, pl, pp, 1)
    val qp = __mathDintAdd(fh, fl, fp, ph, pl, pp, 2)
    val wh = __mathDintMulInt(e, -5660435428506895957, -3899075386890062161, -2, 0)
    val wl = __mathDintMulInt(e, -5660435428506895957, -3899075386890062161, -2, 1)
    val wp = __mathDintMulInt(e, -5660435428506895957, -3899075386890062161, -2, 2)
    val uh = __mathDintAdd(qh, ql, qp, wh, wl, wp, 0)
    val ul = __mathDintAdd(qh, ql, qp, wh, wl, wp, 1)
    val up = __mathDintAdd(qh, ql, qp, wh, wl, wp, 2)
    // R = y log(x)
    val yh = __mathDintFrom(y, 0)
    val yp = __mathDintFrom(y, 2)
    val rh = __mathDintMul(uh, ul, up, yh, 0, yp, 0)
    val rl = __mathDintMul(uh, ul, up, yh, 0, yp, 1)
    val rp = __mathDintMul(uh, ul, up, yh, 0, yp, 2)
    if ((rh | rl) == 0) return s
    // |R| >= 2^10: certain underflow or overflow
    if ((rp >> 1) >= 10) return if ((rp & 1) == 1) 0.5 * (s * f64FromBits(1)) else s * f64FromBits(9218868437227405311) * 2.0
    // exp(R) = 2^(j / 64) exp(v) with v = R - j log(2) / 64, |v| < 2^-7.5
    val jf = if ((rp >> 1) < -12) 0.0 else roundEven(__mathDintToDouble(rh, rp) * f64FromBits(4636197737785426686))
    val j = f64ToInt(jf)
    val nh = __mathDintMulInt(j, -5660435428506895957, -3899075386890062161, -2, 0)
    val nl = __mathDintMulInt(j, -5660435428506895957, -3899075386890062161, -2, 1)
    val np = __mathDintMulInt(j, -5660435428506895957, -3899075386890062161, -2, 2)
    val np2 = ((((np >> 1) - 6) << 1) | (np & 1)) ^ 1
    val vh = __mathDintAdd(rh, rl, rp, nh, nl, np2, 0)
    val vl = __mathDintAdd(rh, rl, rp, nh, nl, np2, 1)
    val vp = __mathDintAdd(rh, rl, rp, nh, nl, np2, 2)
    // exp(v) by its Taylor series to v^12 / 12!, the coefficients from tan's table
    var eh = __mathTanTaylor(69)
    var el = __mathTanTaylor(70)
    var ep = __mathTanTaylor(71) & -2
    var n = 11
    while (n >= 0) {
        val oh = __mathDintMul(eh, el, ep, vh, vl, vp, 0)
        val ol = __mathDintMul(eh, el, ep, vh, vl, vp, 1)
        val op = __mathDintMul(eh, el, ep, vh, vl, vp, 2)
        val ci = if (n % 2 == 1) 3 * (n / 2) else 3 * (17 + n / 2)
        val ch = __mathTanTaylor(ci)
        val cl = __mathTanTaylor(ci + 1)
        val cp = __mathTanTaylor(ci + 2) & -2
        eh = __mathDintAdd(ch, cl, cp, oh, ol, op, 0)
        el = __mathDintAdd(ch, cl, cp, oh, ol, op, 1)
        ep = __mathDintAdd(ch, cl, cp, oh, ol, op, 2)
        n -= 1
    }
    // 2^(i / 64) = high + low + third, smallest first
    val ti = j & 63
    val tah = __mathDintFrom(f64FromBits(__mathExpT0Third(ti)), 0)
    val tal = 0
    val tap = __mathDintFrom(f64FromBits(__mathExpT0Third(ti)), 2)
    val tbh = __mathDintFrom(f64FromBits(__mathExpT0Low(ti)), 0)
    val tbl = 0
    val tbp = __mathDintFrom(f64FromBits(__mathExpT0Low(ti)), 2)
    val tch = __mathDintAdd(tbh, tbl, tbp, tah, tal, tap, 0)
    val tcl = __mathDintAdd(tbh, tbl, tbp, tah, tal, tap, 1)
    val tcp = __mathDintAdd(tbh, tbl, tbp, tah, tal, tap, 2)
    val tdh = __mathDintFrom(f64FromBits(__mathExpT0High(ti)), 0)
    val tdl = 0
    val tdp = __mathDintFrom(f64FromBits(__mathExpT0High(ti)), 2)
    val teh = __mathDintAdd(tdh, tdl, tdp, tch, tcl, tcp, 0)
    val tel = __mathDintAdd(tdh, tdl, tdp, tch, tcl, tcp, 1)
    val tep = __mathDintAdd(tdh, tdl, tdp, tch, tcl, tcp, 2)
    val resh = __mathDintMul(teh, tel, tep, eh, el, ep, 0)
    val resl = __mathDintMul(teh, tel, tep, eh, el, ep, 1)
    val resp = __mathDintMul(teh, tel, tep, eh, el, ep, 2)
    val eex = (resp >> 1) + (j >> 6)
    val sgn = if (s == -1.0) 1 else 0
    if (eex < -1075) return 0.5 * (s * f64FromBits(1))
    // the 64 bits from the round bit on: within 64 units (2^-110 relative) of a
    // midpoint? (2^117 2^-111.7 = 37 units of error, plus the dropped bits)
    var mid = 0
    if (eex < -1022) {
        // subnormal: the round bit moves up by sh bits
        val sh = -(1022 + eex)
        mid = (resh << (53 - sh)) | (if (sh >= 53) 0 else resl >>> (11 + sh))
    } else mid = (resh << 53) | (resl >>> 11)
    if (!__mathULess(mid + (1 << 63) + 64, 129)) return __mathPowToDouble(resh, resl != 0, (eex << 1) | sgn)
    // a midpoint itself?
    val exactValue = __mathPowExact(x0, y, sgn)
    if (exactValue == exactValue) return exactValue
    __mathPowLast(x, y, sgn)
}

// pow's third phase for x > 0 near a midpoint and not one: log(x) and exp in
// 256 bits without tables. log(x) = E log(2) + 2 atanh(s) with
// s = (m - 1) / (m + 1), |s| < 0.1716 (49 terms); exp(R) = 2^k exp(w / 64)^64
// with |w| < 0.35 (24 terms, 6 squarings). The relative error is below 2^-238.8
// (y log(x) carries log's 2^-249 times |R| < 2^10). Each operation is a
// multiply-add a b + c, called for its five words in a loop.
@noinline
fun __mathPowLast(x: f64, y: f64, sgn: int): f64 {
