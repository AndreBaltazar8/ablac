        e2 = ne2
        e1 = ne1
        e0 = ne0
        ep = nep
        n -= 1
    }
    var sq = 0
    while (sq < 6) {
        var se3 = 0
        var se2 = 0
        var se1 = 0
        var se0 = 0
        var sep = 0
        var sek = 0
        while (sek < parts) {
            val word = __mathQintMulAdd(e3, e2, e1, e0, ep, e3, e2, e1, e0, ep, 0, 0, 0, 0, 0, sek)
