            if (((rexp ^ qp) & 1) != 0) {
                rh = 0
                rl = 0
                rp = -1076 << 1
            } else {
                rh = t
                rl = 0
                rp = rexp + 2
            }
        } else {
            // |x| > |y|
            val xh104 = if (order104 > 0) t else qh
            val xl104 = if (order104 > 0) 0 else ql
            val xp104 = if (order104 > 0) rexp else qp
            val yh104 = if (order104 > 0) qh else t
            val yl104 = if (order104 > 0) ql else 0
            val yp104 = if (order104 > 0) qp else rexp
            val k104 = (xp104 >> 1) - (yp104 >> 1)
            var sh104 = yh104
            var sl104 = yl104
            if (k104 != 0) {
                if (k104 < 0 || k104 >= 128) {
                    sh104 = 0
                    sl104 = 0
                } else {
                    sl104 = __mathShr128Low(yh104, yl104, k104)
                    sh104 = __mathShr128High(yh104, k104)
                }
            }
            var ex104 = xp104 >> 1
            var ch104 = 0
            var cl104 = 0
            if (((xp104 ^ yp104) & 1) != 0) {
                cl104 = xl104 - sl104
                ch104 = xh104 - sh104 - (if (__mathULess(xl104, sl104)) 1 else 0)
                var z104 = if (ch104 != 0) __mathClz(ch104) else 64 + __mathClz(cl104)
                if (z104 > 0) {
                    // redo the subtraction with the bits the shift dropped
                    val ph104 = __mathShl128High(xh104, xl104, z104)
                    val pl104 = __mathShl128Low(xl104, z104)
                    val qh104 = if (k104 == 1) __mathShl128High(yh104, yl104, z104 - 1) else __mathShl128High(sh104, sl104, z104)
                    val ql104 = if (k104 == 1) __mathShl128Low(yl104, z104 - 1) else __mathShl128Low(sl104, z104)
                    cl104 = pl104 - ql104
                    ch104 = ph104 - qh104 - (if (__mathULess(pl104, ql104)) 1 else 0)
                    ex104 -= z104
                    z104 = __mathClz(ch104)
                }
                val nh104 = __mathShl128High(ch104, cl104, z104)
                cl104 = __mathShl128Low(cl104, z104)
                ch104 = nh104
                ex104 -= z104
            } else {
                cl104 = xl104 + sl104
                ch104 = xh104 + sh104 + (if (__mathULess(cl104, xl104)) 1 else 0)
                val overflow104 = if (ch104 == xh104) __mathULess(cl104, xl104) else __mathULess(ch104, xh104)
                if (overflow104) {
                    cl104 = (cl104 >>> 1) | (ch104 << 63)
                    ch104 = (ch104 >>> 1) | (1 << 63)
                    ex104 += 1
                }
            }
            rh = ch104
            rl = cl104
            rp = (ex104 << 1) | (xp104 & 1)
        }
    }
    var zh = 0
    var zl = 0
    var zp = 0
    // z = r n
    if (true) {
        var rh105 = __mathMulHigh(rh, nh)
        var rl105 = rh * nh
        val m1105 = __mathMulHigh(rh, nl)
        val s1105 = rl105 + m1105
        if (__mathULess(s1105, rl105)) rh105 += 1
        rl105 = s1105
        val m2105 = __mathMulHigh(rl, nh)
        val s2105 = rl105 + m2105
        if (__mathULess(s2105, rl105)) rh105 += 1
        rl105 = s2105
        val top105 = rh105 >>> 63
        if (top105 == 0) {
            rh105 = (rh105 << 1) | (rl105 >>> 63)
            rl105 = rl105 << 1
        }
        zh = rh105
        zl = rl105
        zp = (((rp >> 1) + (np >> 1) + top105 - 1) << 1) | ((rp ^ np) & 1)
    }
    // within 86 ulps of a rounding boundary: tan.c's two exceptions
    val lo0 = zl - 86
    val hi0 = zh - (if (__mathULess(zl, lo0)) 1 else 0)
    val lo1 = zl + 86
    val hi1 = zh + (if (__mathULess(lo1, zl)) 1 else 0)
    if ((hi0 >>> 10) != (hi1 >>> 10)) {
        val sign = if (x < 0.0) -1.0 else 1.0
        if (ax == f64FromBits(4512043876671815455)) {
            return sign * f64FromBits(4512043876671816017) + sign * f64FromBits(4269412446747230207)
        }
        if (ax == f64FromBits(4516547476299185276)) {
            return sign * f64FromBits(4516547476299187526) + sign * f64FromBits(-5276432344952675884)
        }
    }
    __mathTanDintToDouble(zh, zl, if (neg == 1) zp ^ 1 else zp)
}

// A 64-bit t with t h ~ 2^127 for 2^63 <= h < 2^64, by three Newton steps
// from a 9-bit table (relative error below 2^-62.426).
fun __mathTanInverseSeed(h: int): int {
    var t = __mathTanInverse((h >>> 55) & 0xff)
    var step = 0
    while (step < 3) {
        // e = 2^127 - h t, exact and below 2^119, 2^111, 2^95
        val pl = h * t
        val el = -pl
        val eh = (1 << 63) - __mathMulHigh(h, t) - (if (pl != 0) 1 else 0)
        val down = if (step == 0) 55 else if (step == 1) 47 else 31
        val back = if (step == 0) 8 else if (step == 1) 16 else 32
        // t += t (e >> down) >> (64 + back)
        t = t + (__mathMulHigh(t, (eh << (64 - down)) | (el >>> down)) >>> back)
        step += 1
    }
    t
}

// A dint rounded to the nearest double (tan.c's dint_tod).
fun __mathTanDintToDouble(hi0: int, lo0: int, p: int): f64 {
    var hi = hi0
    var lo = lo0
    var ex = p >> 1
    val sgn = p & 1
    if (ex <= -1023) {
        // subnormal: round at the right bit, to nearest
        val sh = -(1011 + ex)
        if (sh >= 64) {
            hi = 0
            lo = 0
        } else {
            var top = hi >>> sh
            val md = (hi >>> (sh - 1)) & 1
            // tan.c's sticky test, kept as written (tan never gets here)
            val rest = (hi & (-1 >>> sh)) != 0 || lo != 0
            top = top + (if (rest) md else top & md)
            hi = top << sh
            lo = 0
        }
        if (hi == 0) {
            ex += 1
            hi = 1 << 63
        }
    }
    var r = (hi >>> 11) | (0x3ff << 52)
    var rd = 0.0
    if (((hi >>> 10) & 1) != 0) rd = rd + f64FromBits(4368491638549381120)
    if ((hi & 0x3ff) != 0 || lo != 0) rd = rd + f64FromBits(4363988038922010624)
    if (sgn == 1) rd = -rd
    r = r | (sgn << 63)
    var value = f64FromBits(r) + rd
    var scale = 0.0
    if (ex > -1022) {
        if (ex > 1024) {
            if (ex == 1025) {
                value = value * 2.0
                scale = f64FromBits(9214364837600034816)
            } else {
                value = f64FromBits(9218868437227405311)
                scale = value
            }
        } else scale = f64FromBits(((ex + 1022) & 0x7ff) << 52)
    } else if (ex < -1073) {
        if (ex == -1074) {
            value = value * 0.5
            scale = f64FromBits(1)
        } else {
            value = f64FromBits(1)
            scale = value
        }
    } else scale = f64FromBits(1 << (ex + 1073))
    value * scale
}

// --- pow (CORE-MATH pow.c) ------------------------------------------------------

/** x raised to y, correctly rounded, with IEEE 754's special cases: pow(x, ±0)
 *  and pow(1, y) are 1 even for a NaN, pow(-1, ±inf) is 1, a negative x needs
 *  an integer y (NaN otherwise). */
fun pow(x0: f64, y: f64): f64 {
    // A port of CORE-MATH's pow.c (copyright 2022-2025 CERN and Inria, MIT
    // licence: see the end of this file).
    var x = x0
    var s = 1.0
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    val infBits = 0x7ff0000000000000
    if (u64(xb) >= u64(infBits) || u64(yb) >= u64(infBits)) {
        // a NaN, an infinity, or a negative x
        if (x != x) return if (y == 0.0 && (xb & (1 << 51)) != 0) 1.0 else x + x
        if (y != y) return if (x == 1.0 && (yb & (1 << 51)) != 0) 1.0 else y + y
        if (xb == infBits) {
            if (y == 0.0) return 1.0
            return if (y < 0.0) 0.0 else x
        }
        if (xb == (0xfff << 52)) {
            if (yb == infBits) return y
            if (yb == (0xfff << 52)) return 0.0
            if (__mathIsInt(y) && !__mathIsInt(y * 0.5)) return if (y < 0.0) -0.0 else x
            if (y < 0.0) return 0.0
            if (y > 0.0) return -x
        }
        if (yb == infBits) {
            if (x == 0.0) return 0.0
            if (x == -1.0 || x == 1.0) return 1.0
            return if (-1.0 < x && x < 1.0) 0.0 else y
        }
        if (yb == (0xfff << 52)) {
            if (x == 0.0) return -y
            if (x == -1.0 || x == 1.0) return 1.0
            return if (-1.0 < x && x < 1.0) -y else 0.0
        }
    }
    // x and y finite
    if (x <= 0.0) {
        if (y == 0.0) return 1.0
        val odd = __mathIsInt(y) && !__mathIsInt(y * 0.5)
        if (xb == 0) {
            if (odd) return if (y < 0.0) 1.0 / 0.0 else 0.0
            return if (y > 0.0) 0.0 else 1.0 / 0.0
        }
        if (xb == (1 << 63)) {
            if (odd) return if (y < 0.0) -1.0 / 0.0 else -0.0
            return if (y > 0.0) 0.0 else 1.0 / 0.0
        }
        if (!__mathIsInt(y)) return (x - x) / 0.0
        // the sign: negative for an odd y
        if (fabs(y) < f64FromBits(4845873199050653696) && (f64ToInt(y) & 1) != 0) s = -1.0
        x = -x
    }
    // phase 1: log(x) ~ lh + ll (CORE-MATH's log_1)
    val ub = f64ToBits(x)
    var m = ub & 0xfffffffffffff
    var e = (ub >>> 52) & 0x7ff
    var t = 0.0
    if (e != 0) {
        t = f64FromBits(m | (0x3ff << 52))
        m = m + (1 << 52)
        e = e - 0x3ff
    } else {
        // subnormal x
        val k = __mathClz(m) - 11
        e = -0x3fe - k
        m = m << k
        t = f64FromBits(m | (0x3ff << 52))
    }
    // above sqrt(2), halve t
    val c = if (m >= 0x16a09e667f3bcd) 1 else 0
    e = e + c
    val ee = f64FromInt(e)
    val i = (m >>> (44 + c)) - 181
    t = t * (if (c == 1) 0.5 else 1.0)
    val r = f64FromBits(__mathPowInverse(i))
    // z = r t - 1 exactly
    val rt = r * t
    val z = (rt - 1.0) + __mathMulLow(r, t, rt)
    // e log(2) + l1 is exact
    val th = ee * f64FromBits(4604418534313441280) + f64FromBits(__mathPowInverseLogHigh(i))
    val tl = ee * f64FromBits(4408728642709317424) + f64FromBits(__mathPowInverseLogLow(i))
    var lh = th + z
    var ll = (z - (lh - th)) + tl
    // log(1 + z) - z ~ ph + pl
    val wh = z * z
    val wl = __mathMulLow(z, z, wh)
    val p5 = f64FromBits(-4629700283583108914) * z + f64FromBits(4594315131227032070)
    var u = f64FromBits(-4628199217062666572) * z + f64FromBits(4596373779692778805)
    var v = f64FromBits(-4625196817309499389) * z + f64FromBits(4599676419421066584)
    u = p5 * wh + u
    v = u * wh + v
    u = v * wh
    val ph = -0.5 * wh
    val pl = u * z + (-0.5 * wl)
    var sum = lh + ph
    ll = (ph - (sum - lh)) + (ll + pl)
    lh = sum
    var cancel = 0
    if (e == 0 && fabs(ll) > fabs(lh) * f64FromBits(4499096027743125504)) {
        // cancellation: redo the sums with pl rounded once, as CORE-MATH's
        // fma(u, z, -wl / 2) is (pl's rounding error counts most here)
        val uz = u * z
        val half = -0.5 * wl
        val s1 = uz + half
        val b1 = s1 - uz
        val pl1 = s1 + (((uz - (s1 - b1)) + (half - b1)) + __mathMulLow(u, z, uz))
        lh = th + z
        ll = (z - (lh - th)) + tl
        sum = lh + ph
        ll = (ph - (sum - lh)) + (ll + pl1)
        lh = sum
        sum = lh + ll
        ll = ll - (sum - lh)
        lh = sum
        cancel = 1
    }
    // no spurious underflow or overflow in y log(x)
    val ey = (yb >>> 52) & 0x7ff
    if (ey < 0x36 || ey >= 0x7f5) {
        lh = 0.0 / 0.0
        ll = lh
    }
    // y log(x) ~ rh + rl (a huge y is scaled for the exact product)
    val rh = y * lh
    var s0 = 0.0
    if (fabs(y) < f64FromBits(8930638061075693568)) s0 = __mathMulLow(y, lh, rh)
    else {
        val ys = y * f64FromBits(4318952042648305664)
        s0 = __mathMulLow(ys, lh, ys * lh) * f64FromBits(4895412794951729152)
    }
    val rl = y * ll + s0
    // exp(rh + rl) ~ resh + resl (CORE-MATH's exp_1)
    var resh = 0.0
    var resl = 0.0
    if (rh != rh || rh > f64FromBits(4649454530185505115)) {
        if (rh == rh && rh > f64FromBits(4649454530988760569)) {
            // overflow for sure
            resh = f64FromBits(9218868437227405311) * s
            resl = resh
        } else {
            resh = 0.0 / 0.0
            resl = resh
        }
    } else if (rh < f64FromBits(-4574386491771051601)) {
        if (rh < f64FromBits(-4573606559505020377)) {
            // underflow for sure
            resh = 0.0 * s
            resl = f64FromBits(1) * (0.5 * s)
        } else {
            resh = 0.0 / 0.0
            resl = resh
        }
    } else {
        val k = roundEven(rh * f64FromBits(4663219335549649662))
        val log2h = f64FromBits(4550375338784995823)
        // rh - k log2h is exact (CORE-MATH's fma)
        val kp = log2h * k
        val zh = (rh - kp) - __mathMulLow(log2h, k, kp)
        val zl = rl - f64FromBits(4303959781690409023) * k
        val kk = f64ToInt(k)
        val i2 = (kk >> 6) & 0x3f
        val i1 = kk & 0x3f
        val t1h = f64FromBits(__mathPowT1High(i2))
        val t2h = f64FromBits(__mathPowT2High(i1))
        var eh = t2h * t1h
        var el = t2h * f64FromBits(__mathPowT1Low(i2)) +
            (f64FromBits(__mathPowT2Low(i1)) * t1h + __mathMulLow(t2h, t1h, eh))
        // exp(zh + zl) ~ qh + ql (CORE-MATH's q_1)
        val zz = zh + zl
        var q = f64FromBits(4586165620542053773) * zz + f64FromBits(4595172819798161814)
        q = q * zz + 0.5
        val h0 = q * zz + 1.0
        val h1 = zz * h0
        val l1 = __mathMulLow(zz, h0, h1)
        val qh = 1.0 + h1
        val ql = (h1 - (qh - 1.0)) + l1
        val p = eh * qh
        el = eh * ql + (el * qh + __mathMulLow(eh, qh, p))
        eh = p
        val scale = f64FromBits(((kk >> 12) + 0x3ff) << 52) * s
        resh = eh * scale
        resl = el * scale
    }
    // relative error 2^-57.579 with cancellation, as CORE-MATH; without, CORE-MATH's
    // 2^-63.797 doubled for the unfused multiply-adds (y ll and u z each round
    // once more, by up to 2^-67.4 of the result)
    val err = if (cancel == 1) f64FromBits(4347504160598392832) else f64FromBits(4324141737531408384)
    val resMax = resh + (resl + err * resh)
    if (resh + (resl - err * resh) == resMax) return resMax
    if (y == 1.0) return s * x
    if (y == 2.0) return x * x
    if (y == 0.5) return sqrt(x)
    __mathPowAccurate(x, y, s, x0)
}

// x is an integer (x finite).
@inline
fun __mathIsInt(x: f64): bool = x == roundEven(x)

// pow's second phase (CORE-MATH's log_2 and exp_2 in 128 bits) and its
// exact-result check, then its third phase (log_3 and exp_3 in 256 bits), for
// x > 0 (s the result's sign, x0 the original x). The operations are written out
// inline (generated from CORE-MATH's dint.h and qint.h): nothing here allocates.
@noinline
fun __mathPowAccurate(x: f64, y: f64, s: f64, x0: f64): f64 {
    // X = x and Y = y as 128-bit floats (pow's dint_fromd: ex - 0x3ff)
    val xbits = f64ToBits(x)
    var xe = (xbits >>> 52) & 0x7ff
    val xm = (xbits & 0xfffffffffffff) + (if (xe != 0) 1 << 52 else 0)
    xe = xe - 0x3ff
    val xz = __mathClz(xm)
    val xh = xm << xz
    var xex = xe - (if (xz > 11) xz - 12 else 0)
    val ybits = f64ToBits(y)
    var ye = (ybits >>> 52) & 0x7ff
    val ym = (ybits & 0xfffffffffffff) + (if (ye != 0) 1 << 52 else 0)
    ye = ye - 0x3ff
    val yz = __mathClz(ym)
    val yh = ym << yz
    val yl = 0
    val yp = ((ye - (if (yz > 11) yz - 12 else 0)) << 1) | (if (y < 0.0) 1 else 0)
    // log_2: E log(2) + log(x / 2^E), relative error below 2^-122.88
    var big = xex
    var i = 0
    if (__mathULess(-5402926248376769404, xh)) {
        big += 1
        i = xh >>> 57
    } else i = xh >>> 56
    val xl = 0
    val xp = (xex - big) << 1
    var zh = 0
    var zl = 0
    var zp = 0
    // z = x constant (high words only, exact)
    if (true) {
        var rh1001 = __mathMulHigh(xh, __mathPowInverse21(3 * (i - 90)))
        var rl1001 = xh * __mathPowInverse21(3 * (i - 90))
        val top1001 = rh1001 >>> 63
        if (top1001 == 0) {
            rh1001 = (rh1001 << 1) | (rl1001 >>> 63)
            rl1001 = rl1001 << 1
        }
        zh = rh1001
        zl = rl1001
        zp = (((xp >> 1) + (__mathPowInverse21(3 * (i - 90) + 2) >> 1) + top1001) << 1) | ((xp ^ __mathPowInverse21(3 * (i - 90) + 2)) & 1)
    }
    val j = zh >>> (63 - 13 - (zp >> 1))
    // z = z constant (high words only, exact)
    if (true) {
        var rh1002 = __mathMulHigh(zh, __mathPowInverse22(3 * (j - 8128)))
        var rl1002 = zh * __mathPowInverse22(3 * (j - 8128))
        val top1002 = rh1002 >>> 63
        if (top1002 == 0) {
            rh1002 = (rh1002 << 1) | (rl1002 >>> 63)
            rl1002 = rl1002 << 1
        }
        zh = rh1002
        zl = rl1002
        zp = (((zp >> 1) + (__mathPowInverse22(3 * (j - 8128) + 2) >> 1) + top1002) << 1) | ((zp ^ __mathPowInverse22(3 * (j - 8128) + 2)) & 1)
    }
    // z = constant + z
    if ((-9223372036854775808 | 0) == 0) {
        zh = zh
        zl = zl
        zp = zp
    } else {
        var order1 = 0
        if (-9223372036854775808 == 0) order1 = if (zh == 0) 0 else -1
        else if (zh == 0) order1 = 1
        else if ((1 >> 1) != (zp >> 1)) order1 = if ((1 >> 1) > (zp >> 1)) 1 else -1
        else if (-9223372036854775808 != zh) order1 = if (__mathULess(zh, -9223372036854775808)) 1 else -1
        else if (0 != zl) order1 = if (__mathULess(zl, 0)) 1 else -1
        if (order1 == 0) {
            if (((1 ^ zp) & 1) != 0) {
                zh = 0
                zl = 0
                zp = -1076 << 1
            } else {
                zh = -9223372036854775808
                zl = 0
                zp = 1 + 2
            }
        } else {
            // |x| > |y|
            val xh1 = if (order1 > 0) -9223372036854775808 else zh
            val xl1 = if (order1 > 0) 0 else zl
            val xp1 = if (order1 > 0) 1 else zp
            val yh1 = if (order1 > 0) zh else -9223372036854775808
            val yl1 = if (order1 > 0) zl else 0
            val yp1 = if (order1 > 0) zp else 1
            val k1 = (xp1 >> 1) - (yp1 >> 1)
            var sh1 = yh1
            var sl1 = yl1
            if (k1 != 0) {
                if (k1 < 0 || k1 >= 128) {
                    sh1 = 0
                    sl1 = 0
                } else {
                    sl1 = __mathShr128Low(yh1, yl1, k1)
                    sh1 = __mathShr128High(yh1, k1)
                }
            }
            var ex1 = xp1 >> 1
            var ch1 = 0
            var cl1 = 0
            if (((xp1 ^ yp1) & 1) != 0) {
                cl1 = xl1 - sl1
                ch1 = xh1 - sh1 - (if (__mathULess(xl1, sl1)) 1 else 0)
                var z1 = if (ch1 != 0) __mathClz(ch1) else 64 + __mathClz(cl1)
                if (z1 > 0) {
                    // redo the subtraction with the bits the shift dropped
                    val ph1 = __mathShl128High(xh1, xl1, z1)
                    val pl1 = __mathShl128Low(xl1, z1)
                    val qh1 = if (k1 == 1) __mathShl128High(yh1, yl1, z1 - 1) else __mathShl128High(sh1, sl1, z1)
                    val ql1 = if (k1 == 1) __mathShl128Low(yl1, z1 - 1) else __mathShl128Low(sl1, z1)
                    cl1 = pl1 - ql1
                    ch1 = ph1 - qh1 - (if (__mathULess(pl1, ql1)) 1 else 0)
                    ex1 -= z1
                    z1 = __mathClz(ch1)
                }
                val nh1 = __mathShl128High(ch1, cl1, z1)
                cl1 = __mathShl128Low(cl1, z1)
                ch1 = nh1
                ex1 -= z1
            } else {
                cl1 = xl1 + sl1
                ch1 = xh1 + sh1 + (if (__mathULess(cl1, xl1)) 1 else 0)
                val overflow1 = if (ch1 == xh1) __mathULess(cl1, xl1) else __mathULess(ch1, xh1)
                if (overflow1) {
                    cl1 = (cl1 >>> 1) | (ch1 << 63)
                    ch1 = (ch1 >>> 1) | (1 << 63)
                    ex1 += 1
                }
            }
            zh = ch1
            zl = cl1
            zp = (ex1 << 1) | (xp1 & 1)
        }
    }
    var rh = 0
    var rl = 0
    var rp = 0
    // r = constant big (integer)
    if (big == 0) {
        rh = 0
        rl = 0
