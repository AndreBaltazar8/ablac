    var lm2 = 0
    var lm1 = 0
    var lm0 = 0
    var lmp = 0
    var lmk = 0
    while (lmk < parts) {
        val word = __mathQintMulAdd(s3, s2, s1, s0, sp + 2, p3, p2, p1, p0, pp, 0, 0, 0, 0, 0, lmk)
        lm3 = lm2
        lm2 = lm1
        lm1 = lm0
        lm0 = lmp
        lmp = word
        lmk += 1
    }
    val eh = __mathDintFrom(f64FromInt(bigE), 0)
    val ex = __mathDintFrom(f64FromInt(bigE), 2)
    var lx3 = 0
    var lx2 = 0
    var lx1 = 0
    var lx0 = 0
    var lxp = 0
    var lxk = 0
    while (lxk < parts) {
        val word = __mathQintMulAdd(eh, 0, 0, 0, ex, -5660435428506895957, -3899075386890062161, 4680158270178506285, -8499111239825556948, -2, lm3, lm2, lm1, lm0, lmp, lxk)
        lx3 = lx2
        lx2 = lx1
        lx1 = lx0
        lx0 = lxp
        lxp = word
        lxk += 1
    }
    val yh = __mathDintFrom(y, 0)
    val yp = __mathDintFrom(y, 2)
    var r3 = 0
    var r2 = 0
    var r1 = 0
    var r0 = 0
    var rp = 0
    var rk = 0
    while (rk < parts) {
        val word = __mathQintMulAdd(lx3, lx2, lx1, lx0, lxp, yh, 0, 0, 0, yp, 0, 0, 0, 0, 0, rk)
        r3 = r2
        r2 = r1
        r1 = r0
        r0 = rp
        rp = word
        rk += 1
