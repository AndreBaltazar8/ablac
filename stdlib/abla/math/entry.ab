    val sh = if (vex < -1022) -(1022 + vex) else 0
    val q3 = __mathShl256(e3, e2, e1, e0, 53 - sh, 3)
    val q2 = __mathShl256(e3, e2, e1, e0, 53 - sh, 2)
    val q1 = __mathShl256(e3, e2, e1, e0, 53 - sh, 1)
    val close = (q3 == (1 << 63) && q2 == 0 && !__mathULess(128, q1)) ||
        (q3 == (1 << 63) - 1 && q2 == -1 && !__mathULess(q1, -128))
    if (!close) return __mathPowToDouble(e3, (e2 | e1 | e0) != 0, (vex << 1) | sgn)
    // x^y within 2^-55 of 1: one of the doubles around 1
    if ((rp >> 1) < -56) {
        return (if (sgn == 1) -1.0 else 1.0) * (if ((rp & 1) == 0) 1.0 + f64FromBits(4156822456062967808) else 1.0 - f64FromBits(4156822456062967808))
    }
    // no case is known to get here; round what we have
    __mathPowToDouble(e3, (e2 | e1 | e0) != 0, (vex << 1) | sgn)
}

// The 128- or 256-bit float (hi, the rest's sticky bit, p) rounded to the
// nearest double (pow.h's dint_tod and qint_tod).
fun __mathPowToDouble(hi: int, sticky: bool, p: int): f64 {
    val ex = p >> 1
    val sgn = p & 1
    if (ex < -1022) {
        // a subnormal result: the round bit is at 2^-1075
        val sh = -(1011 + ex)
        var bits = 0
        if (sh == 64) {
            if ((hi << 1) != 0 || sticky) bits = 1
        } else if (sh < 64) {
            bits = hi >>> sh
            val rb = (hi >>> (sh - 1)) & 1
            bits += if ((hi << (65 - sh)) != 0 || sticky) rb else bits & rb
        }
        return f64FromBits(bits | (sgn << 63))
    }
    var r = f64FromBits((hi >>> 11) | (0x3ff << 52) | (sgn << 63))
    var rd = 0.0
    if (((hi >>> 10) & 1) != 0) rd += f64FromBits(4368491638549381120)
    if ((hi & 0x3ff) != 0 || sticky) rd += f64FromBits(4363988038922010624)
    r += if (sgn == 1) -rd else rd
    if (ex > 1023) {
        if (ex == 1024) return r * 2.0 * f64FromBits(9214364837600034816)
        return r * f64FromBits(9218868437227405311) * 2.0
    }
    r * f64FromBits((ex + 1023) << 52)
}

// x * 2^e (pow.h's pow2), for an exact x^y.
fun __mathPow2(x: f64, e: int): f64 {
    if (e > 2046) return x * f64FromBits(9218868437227405311) * 2.0
    if (e < -2100) return x * 0.0
    val half = f64FromBits((((e >> 1) + 0x3ff) & 0x7ff) << 52)
    (if ((e & 1) != 0) x * 2.0 else x) * half * half
}

// x^y when it fits in 54 bits (an exact or midpoint result), else NaN, for
// x > 0 (sgn the result's sign): CORE-MATH's exact_pow, with the 2^-F-th root
// of x taken exactly rather than read off an approximation of x^y.
@noinline
fun __mathPowExact(x: f64, y: f64, sgn: int): f64 {
    val nan = 0.0 / 0.0
    val sg = if (sgn == 1) -1 else 1
    // x = 2^bigE m with m odd
    val xb = f64ToBits(x)
    var bigE = (xb >>> 52) & 0x7ff
    var m = (xb & 0xfffffffffffff) + (if (bigE != 0) 1 << 52 else 0)
    val tm = __mathCtz(m)
    m = m >>> tm
    bigE = bigE + tm - (0x433 - (if (bigE == 0) 1 else 0))
    if (m == 1) {
        // x a power of 2
        // E y must be an integer exactly, not after rounding
        val bigG = f64FromInt(bigE) * y
        if (!__mathIsInt(bigG) || __mathMulLow(f64FromInt(bigE), y, bigG) != 0.0) return nan
        if (bigG >= 1024.0) return f64FromInt(sg) * f64FromBits(9218868437227405311) * 2.0
        if (bigG <= -1076.0) return f64FromInt(sg) * 0.0
        return __mathPow2(f64FromInt(sg), f64ToInt(bigG))
    }
    if (y < 0.0 || y > 34.0) return nan
    // y = 2^bigF n with n odd
    val yb = f64ToBits(y)
    var bigF = (yb >>> 52) & 0x7ff
    var n = (yb & 0xfffffffffffff) + (if (bigF != 0) 1 << 52 else 0)
    val tn = __mathCtz(n)
    n = n >>> tn
    bigF = bigF + tn - (0x433 - (if (bigF == 0) 1 else 0))
    if (n > 34 || bigF < -5) return nan
    if (bigF < 0) {
        // y = n / 2^-bigF: m must be a (2^-bigF)-th power and 2^-bigF divide bigE
        if ((bigE & ((1 << -bigF) - 1)) != 0) return nan
        var f = bigF
        while (f < 0) {
            val dm = f64FromInt(m)
            val root = roundEven(sqrt(dm))
            if (root * root != dm) return nan
            m = f64ToInt(root)
            f += 1
        }
        bigE = bigE >> -bigF
        bigF = 0
    }
    // y = n 2^bigF an integer: k = m^y, without overflow
    var t = n << bigF
    var k = 1
    while (t != 0) {
        if ((t & 1) != 0) {
            if (__mathMulHigh(m, k) != 0 || m * k < 0) return nan
            k = m * k
        }
        t = t >>> 1
        if (t != 0) {
            if (__mathMulHigh(m, m) != 0) return nan
            m = m * m
        }
    }
    if ((k >> 54) != 0) return nan
    // k 2^(E y) rounded once (a subnormal result included)
    val c = __mathClz(k)
    __mathPowToDouble(k << c, false, ((bigE * (n << bigF) + 63 - c) << 1) | sgn)
}

// --- atan2 (CORE-MATH atan2.c and tint.h) ---------------------------------------

// atan2 for a zero, infinite or NaN argument.
@noinline
fun __mathAtan2Special(y: f64, x: f64): f64 {
    val iy = f64ToBits(y)
    val ix = f64ToBits(x)
    val aiy = iy << 1
    val aix = ix << 1
    val top = 0x7ff << 53
    val pi = f64FromBits(4614256656552045848)
    val halfPi = f64FromBits(4609753056924675352)
    if (!__mathULess(aiy, top) || !__mathULess(aix, top)) {
        if (__mathULess(top, aiy) || __mathULess(top, aix)) return y + x
        if (aiy == top && aix == top) {
            // ±pi/4, or ±3pi/4 for x = -inf
            val h = if (ix < 0) f64FromBits(4612488097114038738) else f64FromBits(4605249457297304856)
            val l = if (ix < 0) f64FromBits(4363988038922010624) else f64FromBits(4359484439294640128)
            return if (iy < 0) -h - l else h + l
        }
        if (aix == top) {
            if (ix < 0) return if (iy < 0) -pi - f64FromBits(4368955796522032135) else pi + f64FromBits(4368955796522032135)
            return if (iy < 0) -0.0 else 0.0
        }
        return if (iy < 0) -halfPi - f64FromBits(4364452196894661639) else halfPi + f64FromBits(4364452196894661639)
    }
    // a zero
    if (aiy == 0 && aix == 0) {
        if (ix == 0) return y
        return if (iy == 0) pi else -pi
    }
    if (aiy == 0) {
        if (x > 0.0) return y / x
        return if (iy >= 0) pi else -pi
    }
    if (y > 0.0) halfPi else -halfPi
}

// a b == c exactly, for finite nonzero a, b and c.
fun __mathTimesIsExact(a: f64, b: f64, c: f64): bool {
    if ((f64ToBits(a) ^ f64ToBits(b) ^ f64ToBits(c)) < 0) return false
    val ab = f64ToBits(a) & 0x7fffffffffffffff
    val bb = f64ToBits(b) & 0x7fffffffffffffff
    val cb = f64ToBits(c) & 0x7fffffffffffffff
    // odd significands and their exponents
    var ma = (ab & 0xfffffffffffff) | (if ((ab >>> 52) != 0) 1 << 52 else 0)
    var mb = (bb & 0xfffffffffffff) | (if ((bb >>> 52) != 0) 1 << 52 else 0)
    var mc = (cb & 0xfffffffffffff) | (if ((cb >>> 52) != 0) 1 << 52 else 0)
    val ta = __mathCtz(ma)
    val tb = __mathCtz(mb)
    val tc = __mathCtz(mc)
    ma = ma >>> ta
    mb = mb >>> tb
    mc = mc >>> tc
    val ea = (if ((ab >>> 52) != 0) (ab >>> 52) - 1075 else -1074) + ta
    val eb = (if ((bb >>> 52) != 0) (bb >>> 52) - 1075 else -1074) + tb
    val ec = (if ((cb >>> 52) != 0) (cb >>> 52) - 1075 else -1074) + tc
    ea + eb == ec && __mathMulHigh(ma, mb) == 0 && ma * mb == mc
}

// The double v as a 192-bit float (tint_fromd): its high word, then its p.
fun __mathTintHigh(v: f64): int {
    val av = f64ToBits(v) & 0x7fffffffffffffff
    if ((av >>> 52) != 0) return (1 << 63) | (av << 11)
    av << __mathClz(av)
}
fun __mathTintP(v: f64): int {
    val vb = f64ToBits(v)
    val av = vb & 0x7fffffffffffffff
    val ex = if ((av >>> 52) != 0) (av >>> 52) - 0x3fe else -0x3f2 - __mathClz(av)
    (ex << 1) | (vb >>> 63)
}

// The 192-bit float (h, m, l, p) rounded to the nearest double (tint_tod),
// or truncated when exact (it holds a double already).
fun __mathAtan2ToDouble(h: int, m: int, l: int, p: int, exact: bool): f64 {
    var ex = p >> 1
    val s = if ((p & 1) == 1) -1.0 else 1.0
    if (ex >= 1025) return s * f64FromBits(9214364837600034816) * 2.0
    if (ex <= -1074) {
        if (ex < -1074) return s * f64FromBits(1) * 0.5
        val mid = h == (1 << 63) && m == 0 && l == 0
        return s * f64FromBits(1) * (if (mid) 0.5 else 0.75)
    }
    var hh = h
    var mm = m
    var ll = l
    if (ex <= -1022) {
        // subnormal: shift right by sh, the dropped bits kept sticky
        val sh = -1021 - ex
        ll = (mm << (64 - sh)) | (ll >>> sh) | (if (ll != 0) 1 else 0)
        mm = (hh << (64 - sh)) | (mm >>> sh)
        hh = hh >>> sh
        ex += sh
    }
    val low = hh & 0x7ff
    val frac = if (exact) 0.0 else if (low < 0x400) 0.25 else if (low > 0x400) 0.75
        else if (mm == 0 && ll == 0) 0.5 else 0.75
    // frac s + s h rounds once, as CORE-MATH's fma
    val r = (frac * s + s * f64FromInt(hh >>> 11)) * f64FromBits(4372995238176751616)
    r * f64FromBits((ex - 1 + 1023) << 52)
}

// atan2 in 192 bits (CORE-MATH's atan2_accurate): z = y / x (or x / y) by
// div_tint, atan(z) by z P(z) / Q(z), then the quadrant, on the out-of-line
// 192-bit operations below.
@noinline
fun __mathAtan2Accurate(y: f64, x: f64): f64 {
    val t = y / x
    if (t == 0.0) return if (x > 0.0) t else if (y > 0.0) mathPi else -mathPi
    // a tiny exact t = y / x: atan(t) rounds to t
    if (x > 0.0 && fabs(t) <= f64FromBits(4489265212858409599) && __mathTimesIsExact(t, x, y)) return t
    val inv = fabs(y) > fabs(x)
    // not CORE-MATH's: a quotient q = num / den with 2^-400 < |q| < 2^-51 gives
    // atan2 = k + atan(±q) with k = 0, ±pi/2 or ±pi, and atan(q) = q - q^3 / 3 + ...;
    // q to about 2^-104 decides the rounding but for the closest cases
    val num = if (inv) x else y
    val den = if (inv) y else x
    val q = num / den
    if (fabs(q) < f64FromBits(4377498837804122112) && fabs(q) > f64FromBits(2805742567851819008)) {
        var n = num
        var d = den
        if (fabs(d) < f64FromBits(2805742567851819008)) {
            n = n * f64FromBits(7309342195222315008)
            d = d * f64FromBits(7309342195222315008)
        } else if (fabs(d) > f64FromBits(6408622269748215808)) {
            n = n * f64FromBits(1905022642377719808)
            d = d * f64FromBits(1905022642377719808)
        }
        // n - q d is exact, and so is its computation
        val pd = q * d
        val ql = ((n - pd) - __mathMulLow(q, d, pd)) / d
        val corr = ql - q * q * q * 0.3333333333333333
        // the error is below 2^-103 |q|, and k's below 2^-104
        val eps = f64FromBits(4156822456062967808) * (if (!inv && x > 0.0) fabs(q) else 1.0)
        var kh = 0.0
        var v = corr
        if (inv || x < 0.0) {
            // k = ±pi/2 - atan(x / y), or ±pi + atan(y / x)
            val half = if (inv) 0.5 else 1.0
            val sq = if (inv) -1.0 else 1.0
            kh = (if (y < 0.0) -mathPi else mathPi) * half
            val kl = (if (y < 0.0) -__mathPiLo else __mathPiLo) * half
            v = (kl + sq * q) + sq * corr
        } else kh = q
        val lb = kh + (v - eps)
        val ub = kh + (v + eps)
        if (lb == ub) return ub
    }
    // B / A: y / x or x / y, then P / Q
    var bh = 0
    var bm = 0
    var bl = 0
    var bp = 0
    var ah = 0
    var am = 0
    var al = 0
    var ap = 0
    var pass = 0
    var sz = 0
    while (pass < 2) {
        if (pass == 0) {
            bh = __mathTintHigh(num)
            bm = 0
            bl = 0
            bp = __mathTintP(num)
            ah = __mathTintHigh(den)
            am = 0
            al = 0
            ap = __mathTintP(den)
        }
        // div_tint: Y ~ 1 / A by a Newton step from a double, then R = Y B refined
        var a0 = __mathAtan2ToDouble(ah, am, al, ap, true)
        val subnormal = fabs(a0) < f64FromBits(4503599627370496)
        if (subnormal) a0 = a0 * f64FromBits(4845873199050653696)
        val inva = 1.0 / a0
        var gh = __mathTintHigh(inva)
        var gm = 0
        var gl = 0
        var gp = __mathTintP(inva) + (if (subnormal) 106 else 0)
        var qh = __mathTintMul(ah, am, al, ap, gh, gm, gl, gp, 0)
        var qm = __mathTintMul(ah, am, al, ap, gh, gm, gl, gp, 1)
        var ql = __mathTintMul(ah, am, al, ap, gh, gm, gl, gp, 2)
        var qp = __mathTintMul(ah, am, al, ap, gh, gm, gl, gp, 3)
        qp = qp ^ 1
        val t2h = __mathTintAdd(-9223372036854775808, 0, 0, 2, qh, qm, ql, qp, 0)
        val t2m = __mathTintAdd(-9223372036854775808, 0, 0, 2, qh, qm, ql, qp, 1)
        val t2l = __mathTintAdd(-9223372036854775808, 0, 0, 2, qh, qm, ql, qp, 2)
        val t2p = __mathTintAdd(-9223372036854775808, 0, 0, 2, qh, qm, ql, qp, 3)
        qh = t2h
        qm = t2m
        ql = t2l
        qp = t2p
        val t3h = __mathTintMul(gh, gm, gl, gp, qh, qm, ql, qp, 0)
        val t3m = __mathTintMul(gh, gm, gl, gp, qh, qm, ql, qp, 1)
        val t3l = __mathTintMul(gh, gm, gl, gp, qh, qm, ql, qp, 2)
        val t3p = __mathTintMul(gh, gm, gl, gp, qh, qm, ql, qp, 3)
        qh = t3h
        qm = t3m
        ql = t3l
        qp = t3p
        val t4h = __mathTintAdd(gh, gm, gl, gp, qh, qm, ql, qp, 0)
        val t4m = __mathTintAdd(gh, gm, gl, gp, qh, qm, ql, qp, 1)
        val t4l = __mathTintAdd(gh, gm, gl, gp, qh, qm, ql, qp, 2)
        val t4p = __mathTintAdd(gh, gm, gl, gp, qh, qm, ql, qp, 3)
        gh = t4h
        gm = t4m
        gl = t4l
        gp = t4p
        var rh = __mathTintMul(gh, gm, gl, gp, bh, bm, bl, bp, 0)
        var rm = __mathTintMul(gh, gm, gl, gp, bh, bm, bl, bp, 1)
        var rl = __mathTintMul(gh, gm, gl, gp, bh, bm, bl, bp, 2)
        var rp = __mathTintMul(gh, gm, gl, gp, bh, bm, bl, bp, 3)
        var wh = __mathTintMul(ah, am, al, ap, rh, rm, rl, rp, 0)
        var wm = __mathTintMul(ah, am, al, ap, rh, rm, rl, rp, 1)
        var wl = __mathTintMul(ah, am, al, ap, rh, rm, rl, rp, 2)
        var wp = __mathTintMul(ah, am, al, ap, rh, rm, rl, rp, 3)
        wp = wp ^ 1
        val t7h = __mathTintAdd(bh, bm, bl, bp, wh, wm, wl, wp, 0)
        val t7m = __mathTintAdd(bh, bm, bl, bp, wh, wm, wl, wp, 1)
        val t7l = __mathTintAdd(bh, bm, bl, bp, wh, wm, wl, wp, 2)
        val t7p = __mathTintAdd(bh, bm, bl, bp, wh, wm, wl, wp, 3)
        wh = t7h
        wm = t7m
        wl = t7l
        wp = t7p
        val t8h = __mathTintMul(gh, gm, gl, gp, wh, wm, wl, wp, 0)
        val t8m = __mathTintMul(gh, gm, gl, gp, wh, wm, wl, wp, 1)
        val t8l = __mathTintMul(gh, gm, gl, gp, wh, wm, wl, wp, 2)
        val t8p = __mathTintMul(gh, gm, gl, gp, wh, wm, wl, wp, 3)
        wh = t8h
        wm = t8m
        wl = t8l
        wp = t8p
        val t9h = __mathTintAdd(rh, rm, rl, rp, wh, wm, wl, wp, 0)
        val t9m = __mathTintAdd(rh, rm, rl, rp, wh, wm, wl, wp, 1)
        val t9l = __mathTintAdd(rh, rm, rl, rp, wh, wm, wl, wp, 2)
        val t9p = __mathTintAdd(rh, rm, rl, rp, wh, wm, wl, wp, 3)
        rh = t9h
        rm = t9m
        rl = t9l
        rp = t9p
        if (pass == 1) {
            bh = rh
            bm = rm
            bl = rl
            bp = rp
            pass = 2
        } else {
            if (!inv && x > 0.0 && (rp >> 1) <= -96) {
                // |y / x| < 2^-96: atan rounds like y / x nudged toward zero
                rl = rl - 2
                rm = rm - (if (__mathULess(rl, 2)) 1 else 0)
                rh = rh - (if (__mathULess(rm, 1)) 1 else 0)
                return __mathAtan2ToDouble(rh, rm, rl, rp, false)
            }
            // atan(|z|) = |z| P(|z|) / Q(|z|): B = P, A = Q by Horner
            sz = rp & 1
            rp = rp & -2
            // from zero, so that each table is read in one place (0 r + c is c)
            var ph = 0
            var pm = 0
            var pl = 0
            var pp = 0
            var uh = 0
            var um = 0
            var ul = 0
            var up = 0
            var i = 29
            while (i >= 0) {
                val t10h = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 0)
                val t10m = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 1)
                val t10l = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 2)
                val t10p = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 3)
                ph = t10h
                pm = t10m
                pl = t10l
                pp = t10p
                val t11h = __mathTintMul(uh, um, ul, up, rh, rm, rl, rp, 0)
                val t11m = __mathTintMul(uh, um, ul, up, rh, rm, rl, rp, 1)
                val t11l = __mathTintMul(uh, um, ul, up, rh, rm, rl, rp, 2)
                val t11p = __mathTintMul(uh, um, ul, up, rh, rm, rl, rp, 3)
                uh = t11h
                um = t11m
                ul = t11l
                up = t11p
                val t12h = __mathTintAdd(ph, pm, pl, pp, __mathAtan2P(4 * (i) + 0), __mathAtan2P(4 * (i) + 1), __mathAtan2P(4 * (i) + 2), __mathAtan2P(4 * (i) + 3), 0)
                val t12m = __mathTintAdd(ph, pm, pl, pp, __mathAtan2P(4 * (i) + 0), __mathAtan2P(4 * (i) + 1), __mathAtan2P(4 * (i) + 2), __mathAtan2P(4 * (i) + 3), 1)
                val t12l = __mathTintAdd(ph, pm, pl, pp, __mathAtan2P(4 * (i) + 0), __mathAtan2P(4 * (i) + 1), __mathAtan2P(4 * (i) + 2), __mathAtan2P(4 * (i) + 3), 2)
                val t12p = __mathTintAdd(ph, pm, pl, pp, __mathAtan2P(4 * (i) + 0), __mathAtan2P(4 * (i) + 1), __mathAtan2P(4 * (i) + 2), __mathAtan2P(4 * (i) + 3), 3)
                ph = t12h
                pm = t12m
                pl = t12l
                pp = t12p
                val t13h = __mathTintAdd(uh, um, ul, up, __mathAtan2Q(4 * (i) + 0), __mathAtan2Q(4 * (i) + 1), __mathAtan2Q(4 * (i) + 2), __mathAtan2Q(4 * (i) + 3), 0)
                val t13m = __mathTintAdd(uh, um, ul, up, __mathAtan2Q(4 * (i) + 0), __mathAtan2Q(4 * (i) + 1), __mathAtan2Q(4 * (i) + 2), __mathAtan2Q(4 * (i) + 3), 1)
                val t13l = __mathTintAdd(uh, um, ul, up, __mathAtan2Q(4 * (i) + 0), __mathAtan2Q(4 * (i) + 1), __mathAtan2Q(4 * (i) + 2), __mathAtan2Q(4 * (i) + 3), 2)
                val t13p = __mathTintAdd(uh, um, ul, up, __mathAtan2Q(4 * (i) + 0), __mathAtan2Q(4 * (i) + 1), __mathAtan2Q(4 * (i) + 2), __mathAtan2Q(4 * (i) + 3), 3)
                uh = t13h
                um = t13m
                ul = t13l
                up = t13p
                i -= 1
            }
            val t14h = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 0)
            val t14m = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 1)
            val t14l = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 2)
            val t14p = __mathTintMul(ph, pm, pl, pp, rh, rm, rl, rp, 3)
            ph = t14h
            pm = t14m
            pl = t14l
            pp = t14p
            bh = ph
            bm = pm
            bl = pl
            bp = pp
            ah = uh
            am = um
            al = ul
            ap = up
            pass = 1
        }
    }
    // B = atan(|z|): atan(z), then the quadrant
    var zh = bh
    var zm = bm
    var zl = bl
    var zp = (bp & -2) | sz
    if (inv) {
        // pi/2 - atan(x / y), or -(pi/2 + atan(x / y))
        val neg = zp & 1
        zp = zp | 1
    val t15h = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 2, zh, zm, zl, zp, 0)
    val t15m = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 2, zh, zm, zl, zp, 1)
    val t15l = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 2, zh, zm, zl, zp, 2)
    val t15p = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 2, zh, zm, zl, zp, 3)
    zh = t15h
    zm = t15m
    zl = t15l
    zp = t15p
        zp = zp | neg
    }
    if (x < 0.0) {
        // atan(z) - pi or atan(z) + pi
        val pos = 1 - (zp & 1)
        zp = zp | 1
    val t16h = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 4, zh, zm, zl, zp, 0)
    val t16m = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 4, zh, zm, zl, zp, 1)
    val t16l = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 4, zh, zm, zl, zp, 2)
    val t16p = __mathTintAdd(-3958705157555305932, -4267615245585081135, 2955010104097229940, 4, zh, zm, zl, zp, 3)
    zh = t16h
    zm = t16m
    zl = t16l
    zp = t16p
        zp = zp | pos
    }
    __mathAtan2ToDouble(zh, zm, zl, zp, false)
}

// The 192-bit floats a b (CORE-MATH's mul_tint, below 10 ulps), one word at a time
// (high, middle, low, ex << 1 | sign).
@noinline
fun __mathTintMul(ah: int, am: int, al: int, ap: int, bh: int, bm: int, bl: int, bp: int, part: int): int {
    var oh = 0
    var om = 0
    var ol = 0
    var op = 0
    // o = a b
    if (true) {
        var rh2001 = __mathMulHigh(ah, bh)
        var rm2001 = ah * bh
        var rl2001 = ah * bm
        val h12001 = __mathMulHigh(ah, bm)
        rm2001 += h12001
        if (__mathULess(rm2001, h12001)) rh2001 += 1
        val l22001 = am * bh
        val h22001 = __mathMulHigh(am, bh)
        rl2001 += l22001
        var cm2001 = if (__mathULess(rl2001, l22001)) 1 else 0
        rm2001 += h22001
        if (__mathULess(rm2001, h22001)) rh2001 += 1
        // the high words of ah bl, am bm and al bh
        val t12001 = __mathMulHigh(ah, bl)
        val t22001 = __mathMulHigh(am, bm)
        val t32001 = __mathMulHigh(al, bh)
        var sl2001 = t12001 + t22001
        var sh2001 = if (__mathULess(sl2001, t12001)) 1 else 0
        val sl22001 = sl2001 + t32001
        if (__mathULess(sl22001, sl2001)) sh2001 += 1
        cm2001 += sh2001
        rl2001 += sl22001
        if (__mathULess(rl2001, sl22001)) cm2001 += 1
        rm2001 += cm2001
        if (__mathULess(rm2001, cm2001)) rh2001 += 1
        var ex2001 = (ap >> 1) + (bp >> 1)
        if ((rh2001 >>> 63) == 0) {
            rh2001 = (rh2001 << 1) | (rm2001 >>> 63)
            rm2001 = (rm2001 << 1) | (rl2001 >>> 63)
            rl2001 = rl2001 << 1
            ex2001 -= 1
        }
        oh = rh2001
        om = rm2001
        ol = rl2001
        op = (ex2001 << 1) | ((ap ^ bp) & 1)
    }
    if (part == 0) oh else if (part == 1) om else if (part == 2) ol else op
}

// The 192-bit floats a + b (CORE-MATH's add_tint, below 2 ulps, exact when Sterbenz applies), one word at a time
// (high, middle, low, ex << 1 | sign).
@noinline
fun __mathTintAdd(ah: int, am: int, al: int, ap: int, bh: int, bm: int, bl: int, bp: int, part: int): int {
    var oh = 0
    var om = 0
    var ol = 0
    var op = 0
    // o = a + b
    if (true) {
        var order2002 = 0
        if (ah == 0) order2002 = if (bh == 0) 0 else -1
        else if (bh == 0) order2002 = 1
        else if ((ap >> 1) != (bp >> 1)) order2002 = if ((ap >> 1) > (bp >> 1)) 1 else -1
        else if (ah != bh) order2002 = if (__mathULess(bh, ah)) 1 else -1
        else if (am != bm) order2002 = if (__mathULess(bm, am)) 1 else -1
        else if (al != bl) order2002 = if (__mathULess(bl, al)) 1 else -1
        if (order2002 == 0) {
            if (((ap ^ bp) & 1) != 0) {
                oh = 0
                om = 0
                ol = 0
                op = -1076 << 1
            } else {
                oh = ah
                om = am
                ol = al
                op = ap + 2
            }
        } else {
            // |x| > |y|
            val xh2002 = if (order2002 > 0) ah else bh
            val xm2002 = if (order2002 > 0) am else bm
            val xl2002 = if (order2002 > 0) al else bl
            val xp2002 = if (order2002 > 0) ap else bp
            val yh2002 = if (order2002 > 0) bh else ah
            val ym2002 = if (order2002 > 0) bm else am
            val yl2002 = if (order2002 > 0) bl else al
            val yp2002 = if (order2002 > 0) bp else ap
            val sh2002 = (xp2002 >> 1) - (yp2002 >> 1)
            // t = y >> sh
            val th2002 = __mathShr256(yh2002, ym2002, yl2002, 0, sh2002, 3)
            val tm2002 = __mathShr256(yh2002, ym2002, yl2002, 0, sh2002, 2)
            val tl2002 = __mathShr256(yh2002, ym2002, yl2002, 0, sh2002, 1)
            var ch2002 = 0
            var cm2002 = 0
            var cl2002 = 0
            var ex2002 = xp2002 >> 1
            if (((xp2002 ^ yp2002) & 1) != 0) {
                // a subtraction
                cl2002 = xl2002 - tl2002
                var bw2002 = if (__mathULess(xl2002, tl2002)) 1 else 0
                cm2002 = xm2002 - tm2002 - bw2002
                bw2002 = if (__mathULess(xm2002, tm2002) || (xm2002 == tm2002 && bw2002 == 1)) 1 else 0
                ch2002 = xh2002 - th2002 - bw2002
                val z2002 = __mathClz256(ch2002, cm2002, cl2002, 0)
                if (z2002 <= 1 || sh2002 == 0) {
                    val nh2002 = __mathShl256(0, ch2002, cm2002, cl2002, z2002, 2)
                    val nm2002 = __mathShl256(0, ch2002, cm2002, cl2002, z2002, 1)
                    cl2002 = __mathShl256(0, ch2002, cm2002, cl2002, z2002, 0)
                    ch2002 = nh2002
                    cm2002 = nm2002
                    ex2002 -= z2002
                } else {
                    // redo it shifted left by z, keeping the bits of y the shift dropped
                    val ph2002 = __mathShl256(0, xh2002, xm2002, xl2002, z2002, 2)
                    val pm2002 = __mathShl256(0, xh2002, xm2002, xl2002, z2002, 1)
                    val pl2002 = __mathShl256(0, xh2002, xm2002, xl2002, z2002, 0)
                    val qh2002 = __mathShl256(0, yh2002, ym2002, yl2002, z2002 - sh2002, 2)
                    val qm2002 = __mathShl256(0, yh2002, ym2002, yl2002, z2002 - sh2002, 1)
                    val ql2002 = __mathShl256(0, yh2002, ym2002, yl2002, z2002 - sh2002, 0)
                    cl2002 = pl2002 - ql2002
                    bw2002 = if (__mathULess(pl2002, ql2002)) 1 else 0
                    cm2002 = pm2002 - qm2002 - bw2002
                    bw2002 = if (__mathULess(pm2002, qm2002) || (pm2002 == qm2002 && bw2002 == 1)) 1 else 0
                    ch2002 = ph2002 - qh2002 - bw2002
                    val z12002 = __mathClz256(ch2002, cm2002, cl2002, 0)
                    val nh2002 = __mathShl256(0, ch2002, cm2002, cl2002, z12002, 2)
                    val nm2002 = __mathShl256(0, ch2002, cm2002, cl2002, z12002, 1)
                    cl2002 = __mathShl256(0, ch2002, cm2002, cl2002, z12002, 0)
                    ch2002 = nh2002
                    cm2002 = nm2002
                    ex2002 -= z2002 + z12002
                }
            } else {
                // an addition, a carry shifted back in
                cl2002 = xl2002 + tl2002
                var cy2002 = if (__mathULess(cl2002, xl2002)) 1 else 0
                cm2002 = xm2002 + tm2002 + cy2002
                cy2002 = if (__mathULess(cm2002, xm2002) || (cm2002 == xm2002 && cy2002 == 1)) 1 else 0
                ch2002 = xh2002 + th2002 + cy2002
                cy2002 = if (__mathULess(ch2002, xh2002) || (ch2002 == xh2002 && cy2002 == 1)) 1 else 0
                if (cy2002 == 1) {
                    cl2002 = (cm2002 << 63) | (cl2002 >>> 1)
                    cm2002 = (ch2002 << 63) | (cm2002 >>> 1)
                    ch2002 = (1 << 63) | (ch2002 >>> 1)
                    ex2002 += 1
                }
            }
            oh = ch2002
            om = cm2002
            ol = cl2002
            op = (ex2002 << 1) | (xp2002 & 1)
        }
    }
    if (part == 0) oh else if (part == 1) om else if (part == 2) ol else op
}

// --- 128-bit floats for the accurate paths (CORE-MATH dint.h) ------------------
// A dint is (-1)^sgn (hi + lo / 2^64) 2^(ex - 63) with hi's top bit set (or
// zero), held as three words: hi, lo and p = ex << 1 | sgn. An operation
// returns one word of its result (`part` 0: hi, 1: lo, 2: p), so a caller
// asks three times: these paths are rare, and nothing here allocates (an
// allocating callee would cost every fast path a collector frame).

// The number of leading zero bits of a 64-bit word.
fun __mathClz(x: int): int {
    if (x == 0) return 64
    if (x < 0) return 0
    val high = x >>> 32
    // floor(log2) from the exponent of an exactly converted 32-bit half
    if (high != 0) return 31 - ((f64ToBits(f64FromInt(high)) >>> 52) - 1023)
    63 - ((f64ToBits(f64FromInt(x)) >>> 52) - 1023)
}

@inline
fun __mathULess(a: int, b: int): bool = u64(a) < u64(b)

// The 128-bit (hi, lo) shifted left by n >= 0: the high word, then the low word.
fun __mathShl128High(hi: int, lo: int, n: int): int =
    if (n == 0) hi else if (n < 64) (hi << n) | (lo >>> (64 - n)) else if (n < 128) lo << (n - 64) else 0
fun __mathShl128Low(lo: int, n: int): int = if (n < 64) lo << n else 0

// The 128-bit (hi, lo) shifted right by n >= 0 (logically): high word, low word.
fun __mathShr128High(hi: int, n: int): int = if (n < 64) hi >>> n else 0
fun __mathShr128Low(hi: int, lo: int, n: int): int =
    if (n == 0) lo else if (n < 64) (lo >>> n) | (hi << (64 - n)) else if (n < 128) hi >>> (n - 64) else 0

@inline
fun __mathPart(part: int, hi: int, lo: int, ex: int, sgn: int): int =
    if (part == 0) hi else if (part == 1) lo else (ex << 1) | sgn

// The double x as a dint.
fun __mathDintFrom(x: f64, part: int): int {
    val bits = f64ToBits(x)
    var e = (bits >>> 52) & 0x7ff
    val m = (bits & 0xfffffffffffff) + (if (e != 0) 1 << 52 else 0)
    e = e - 0x3ff
    if (m == 0) return 0
    val t = __mathClz(m)
    __mathPart(part, m << t, 0, e - (if (t > 11) t - 12 else 0), if (x < 0.0) 1 else 0)
}

// a's magnitude compared with b's: -1, 0 or 1.
fun __mathDintCompare(ah: int, al: int, aex: int, bh: int, bl: int, bex: int): int {
    if (aex != bex) return if (aex > bex) 1 else -1
    if (ah != bh) return if (__mathULess(bh, ah)) 1 else -1
    if (al != bl) return if (__mathULess(bl, al)) 1 else -1
    0
}

@noinline
fun __mathDintAdd(ah: int, al: int, ap: int, bh: int, bl: int, bp: int, part: int): int {
    if ((ah | al) == 0) return __mathPart(part, bh, bl, bp >> 1, bp & 1)
    if ((bh | bl) == 0) return __mathPart(part, ah, al, ap >> 1, ap & 1)
    val aex = ap >> 1
    val asgn = ap & 1
    val order = __mathDintCompare(ah, al, aex, bh, bl, bp >> 1)
    if (order == 0) {
        if ((asgn ^ (bp & 1)) != 0) return 0
        return __mathPart(part, ah, al, aex + 1, asgn)
    }
    if (order < 0) return __mathDintAdd(bh, bl, bp, ah, al, ap, part)
    // |a| > |b|
    var sh2 = bh
    var sl2 = bl
    var ex = aex
    val bex = bp >> 1
    if (aex > bex) {
        val sh = aex - bex
        var shift = sh
        if (sh <= 128) {
            // CORE-MATH's rounding: the last bit shifted out added at the bottom,
            // except that a carry out of all 128 bits makes the value 2^128
            val bit = if (sh - 1 < 64) (sl2 >>> (sh - 1)) & 1 else (sh2 >>> (sh - 65)) & 1
            val low = sl2 + bit
            if (__mathULess(low, sl2)) {
                sh2 += 1
                if (sh2 == 0) {
                    sh2 = 1 << 63
                    shift = sh - 1
                }
            }
            sl2 = low
        }
        val high = __mathShr128High(sh2, shift)
        sl2 = __mathShr128Low(sh2, sl2, shift)
        sh2 = high
    }
    var ch = 0
    var cl = 0
    if ((asgn ^ (bp & 1)) != 0) {
        cl = al - sl2
        ch = ah - sh2 - (if (__mathULess(al, sl2)) 1 else 0)
    } else {
        cl = al + sl2
        ch = ah + sh2 + (if (__mathULess(cl, al)) 1 else 0)
        val overflow = if (ch == ah) __mathULess(cl, al) else __mathULess(ch, ah)
        if (overflow) {
            // round the dropped bit to nearest, then shift the carry in
            val bit = cl & 1
            cl = cl + bit
            if (__mathULess(cl, bit)) ch += 1
            cl = (cl >>> 1) | (ch << 63)
            ch = (ch >>> 1) | (1 << 63)
            ex += 1
        }
    }
    val shift = if (ch != 0) __mathClz(ch) else 64 + (if (cl != 0) __mathClz(cl) else aex)
    if (shift < 0 || shift >= 128) return __mathPart(part, 0, 0, ex - shift, asgn)
    __mathPart(part, __mathShl128High(ch, cl, shift), __mathShl128Low(cl, shift), ex - shift, asgn)
}

// a b with 126 bits of accuracy.
@noinline
fun __mathDintMul(ah: int, al: int, ap: int, bh: int, bl: int, bp: int, part: int): int {
    var th = __mathMulHigh(ah, bh)
    var tl = ah * bh
    val m1h = __mathMulHigh(ah, bl)
    val m1l = ah * bl
    val m2h = __mathMulHigh(al, bh)
    val m2l = al * bh
    val ml = m1l + m2l
    val mh = m1h + m2h + (if (__mathULess(ml, m1l)) 1 else 0)
    val carry = if (mh == m1h) __mathULess(ml, m1l) else __mathULess(mh, m1h)
    if (carry) th += 1
    val low = tl + mh
    if (__mathULess(low, tl)) th += 1
    tl = low
    // keep the top bit set
    val ex = if ((th >>> 63) == 0) 1 else 0
    if (ex == 1) {
        th = (th << 1) | (tl >>> 63)
        tl = tl << 1
    }
    val rounded = tl + (ml >>> 63)
    if (__mathULess(rounded, tl)) th += 1
    __mathPart(part, th, rounded, (ap >> 1) + (bp >> 1) - ex + 1, (ap ^ bp) & 1)
}

// b a for a small integer b.
@noinline
fun __mathDintMulInt(b: int, ah: int, al: int, ap: int, part: int): int {
    if (b == 0) return 0
    val c = if (b < 0) -b else b
    val sgn = if (b < 0) 1 - (ap & 1) else ap & 1
    var th = __mathMulHigh(ah, c)
    var tl = ah * c
    var m = if (th != 0) __mathClz(th) else 64
    val shiftedHigh = __mathShl128High(th, tl, m)
    tl = __mathShl128Low(tl, m)
    th = shiftedHigh
    // (al c) << (m - 1) >> 63 as 128 bits
    val lh = __mathMulHigh(al, c)
    val ll = al * c
    val sh = __mathShl128High(lh, ll, m - 1)
    val sl = __mathShl128Low(ll, m - 1)
    val l2l = __mathShr128Low(sh, sl, 63)
    val l2h = __mathShr128High(sh, 63)
    var rl = l2l + tl
    var rh = l2h + th + (if (__mathULess(rl, l2l)) 1 else 0)
    val overflow = if (rh == l2h) __mathULess(rl, l2l) else __mathULess(rh, l2h)
    if (overflow) {
        val bit = rl & 1
        rl = rl + bit
        if (__mathULess(rl, bit)) rh += 1
        rl = (rl >>> 1) | (rh << 63)
        rh = (rh >>> 1) | (1 << 63)
        m -= 1
    }
    __mathPart(part, rh, rl, (ap >> 1) + 64 - m, sgn)
}

// A normal-range dint rounded to the nearest double; the bits after the
// rounding bit are never all zero for the results this is used for.
fun __mathDintToDouble(hi: int, p: int): f64 {
    val sgn = p & 1
    var r = (hi >>> 11) | (0x3ff << 52)
    var rd = f64FromBits(4363988038922010624)
    if (((hi >>> 10) & 1) != 0) rd = rd + f64FromBits(4368491638549381120)
    r = r | (sgn << 63)
    val rounded = f64FromBits(r) + (if (sgn == 0) rd else -rd)
    rounded * f64FromBits((((p >> 1) + 1023) & 0x7ff) << 52)
}

