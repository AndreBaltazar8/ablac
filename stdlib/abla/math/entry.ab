// a b + c for 256-bit floats (CORE-MATH's qint: value = w3 / 2^63 2^ex, the
// words high first, p = ex << 1 | sign), one word at a time: the product exact
// to its top 320 bits, then truncated, then the sum truncated (each below
// 2 ulps; a zero factor gives c, a zero c the product).
@noinline
fun __mathQintMulAdd(a3: int, a2: int, a1: int, a0: int, ap: int, b3: int, b2: int, b1: int, b0: int, bp: int, c3: int, c2: int, c1: int, c0: int, cp: int, part: int): int {
    // the product's words r0 (lowest) to r7 by columns, the last five kept
    var w4 = 0
    var w3 = 0
    var w2 = 0
    var w1 = 0
    var w0 = 0
    var lo = 0
    var hi = 0
    var top = 0
    // (part >>> 3 is 0: a bound the optimizer can't see, so the loops stay loops)
    val last = 7 + (part >>> 3)
    var col = 0
    while (col <= last) {
        var i = if (col > 3) col - 3 else 0
        while (i <= 3 && i <= col) {
            val ai = __mathLimb(a3, a2, a1, a0, i)
            val bj = __mathLimb(b3, b2, b1, b0, col - i)
            val pl = ai * bj
            val ph = __mathMulHigh(ai, bj)
            lo = lo + pl
            val c1 = if (__mathULess(lo, pl)) 1 else 0
            val h1 = hi + ph
            val c2 = if (__mathULess(h1, ph)) 1 else 0
            hi = h1 + c1
            top = top + c2 + (if (__mathULess(hi, h1)) 1 else 0)
            i += 1
        }
        w0 = w1
        w1 = w2
        w2 = w3
        w3 = w4
        w4 = lo
        lo = hi
        hi = top
        top = 0
        col += 1
    }
    // normalized: the top bit set
    val sh = if (w4 < 0) 0 else 1
    val m3 = if (sh == 0) w4 else (w4 << 1) | (w3 >>> 63)
    val m2 = if (sh == 0) w3 else (w3 << 1) | (w2 >>> 63)
    val m1 = if (sh == 0) w2 else (w2 << 1) | (w1 >>> 63)
    val m0 = if (sh == 0) w1 else (w1 << 1) | (w0 >>> 63)
    val mp = ((((ap >> 1) + (bp >> 1) + 1 - sh)) << 1) | ((ap ^ bp) & 1)
    if ((m3 | m2 | m1 | m0) == 0) return __mathQintPart(part, c3, c2, c1, c0, cp)
    if ((c3 | c2 | c1 | c0) == 0) return __mathQintPart(part, m3, m2, m1, m0, mp)
    // the sum: x the larger in magnitude, y the other shifted to x's exponent
    val order = __mathQintCompare(m3, m2, m1, m0, mp, c3, c2, c1, c0, cp)
    if (order == 0 && ((mp ^ cp) & 1) != 0) return 0
    val x3 = if (order >= 0) m3 else c3
    val x2 = if (order >= 0) m2 else c2
    val x1 = if (order >= 0) m1 else c1
    val x0 = if (order >= 0) m0 else c0
    val xp = if (order >= 0) mp else cp
    val y3 = if (order >= 0) c3 else m3
    val y2 = if (order >= 0) c2 else m2
    val y1 = if (order >= 0) c1 else m1
    val y0 = if (order >= 0) c0 else m0
    val yp = if (order >= 0) cp else mp
    val k = (xp >> 1) - (yp >> 1)
    val s3 = __mathShr256(y3, y2, y1, y0, k, 3)
    val s2 = __mathShr256(y3, y2, y1, y0, k, 2)
    val s1 = __mathShr256(y3, y2, y1, y0, k, 1)
    val s0 = __mathShr256(y3, y2, y1, y0, k, 0)
    var ex = xp >> 1
    var t3 = 0
    var t2 = 0
    var t1 = 0
    var t0 = 0
    if (((mp ^ cp) & 1) == 0) {
        // x + y, a carry out shifted back in
        t0 = x0 + s0
        var cy = if (__mathULess(t0, x0)) 1 else 0
        t1 = x1 + s1 + cy
        cy = if (__mathULess(t1, x1) || (t1 == x1 && cy == 1)) 1 else 0
        t2 = x2 + s2 + cy
        cy = if (__mathULess(t2, x2) || (t2 == x2 && cy == 1)) 1 else 0
        t3 = x3 + s3 + cy
        cy = if (__mathULess(t3, x3) || (t3 == x3 && cy == 1)) 1 else 0
        if (cy == 1) {
            t0 = (t0 >>> 1) | (t1 << 63)
            t1 = (t1 >>> 1) | (t2 << 63)
            t2 = (t2 >>> 1) | (t3 << 63)
            t3 = (t3 >>> 1) | (1 << 63)
            ex += 1
        }
    } else {
        // x - y, then normalized
        val d0 = x0 - s0
        var bw = if (__mathULess(x0, s0)) 1 else 0
        val d1 = x1 - s1 - bw
        bw = if (__mathULess(x1, s1) || (x1 == s1 && bw == 1)) 1 else 0
        val d2 = x2 - s2 - bw
        bw = if (__mathULess(x2, s2) || (x2 == s2 && bw == 1)) 1 else 0
        val d3 = x3 - s3 - bw
        val z = __mathClz256(d3, d2, d1, d0)
        t3 = __mathShl256(d3, d2, d1, d0, z, 3)
        t2 = __mathShl256(d3, d2, d1, d0, z, 2)
        t1 = __mathShl256(d3, d2, d1, d0, z, 1)
        t0 = __mathShl256(d3, d2, d1, d0, z, 0)
        ex -= z
    }
    __mathQintPart(part, t3, t2, t1, t0, (ex << 1) | (xp & 1))
}

// The 256-bit float a divided by the integer 0 < n < 2^31 (below 2 ulps), one
// word at a time: a long division in 32-bit digits, then normalized.
@noinline
fun __mathQintDivInt(a3: int, a2: int, a1: int, a0: int, ap: int, n: int, part: int): int {
    if ((a3 | a2 | a1 | a0) == 0 || n == 1) return __mathQintPart(part, a3, a2, a1, a0, ap)
    var rem = 0
    var top = 0
    var q3 = 0
    var q2 = 0
    var q1 = 0
    var q0 = 0
    var d = 0
    while (d < 9 + (part >>> 3)) {
        // the digits of a, high first, then one zero digit
        val limb = __mathLimb(a3, a2, a1, a0, 3 - d / 2)
        val digit = if (d == 8) 0 else if ((d & 1) == 0) limb >>> 32 else limb & 0xffffffff
        val cur = (rem << 32) | digit
        val qd = cur / n
        rem = cur - qd * n
        top = (top << 32) | (q3 >>> 32)
        q3 = (q3 << 32) | (q2 >>> 32)
        q2 = (q2 << 32) | (q1 >>> 32)
        q1 = (q1 << 32) | (q0 >>> 32)
        q0 = (q0 << 32) | qd
        d += 1
    }
    // the quotient is top 2^256 + q: 0 < top < 2^32, shifted right by sh
    val sh = 64 - __mathClz(top)
    val o3 = (top << (64 - sh)) | (q3 >>> sh)
    val o2 = (q3 << (64 - sh)) | (q2 >>> sh)
    val o1 = (q2 << (64 - sh)) | (q1 >>> sh)
    val o0 = (q1 << (64 - sh)) | (q0 >>> sh)
    __mathQintPart(part, o3, o2, o1, o0, (((ap >> 1) - 32 + sh) << 1) | (ap & 1))
}

@inline
fun __mathQintPart(part: int, a3: int, a2: int, a1: int, a0: int, p: int): int =
    if (part == 0) a3 else if (part == 1) a2 else if (part == 2) a1 else if (part == 3) a0 else p

