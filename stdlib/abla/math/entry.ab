// IEEE-754 operations that every target rounds identically: these lower to
// single instructions (or LLVM's exact expansions) on x86-64, AArch64 and Wasm.
fun sqrt(value: f64): f64 = ablaF64Sqrt(value)
fun floor(value: f64): f64 = ablaF64Floor(value)
fun ceil(value: f64): f64 = ablaF64Ceil(value)
fun trunc(value: f64): f64 = ablaF64Trunc(value)
fun fabs(value: f64): f64 = ablaF64Abs(value)
/** Round half to even (IEEE roundTiesToEven), e.g. 2.5 -> 2.0, 3.5 -> 4.0. */
fun roundEven(value: f64): f64 = ablaF64RoundEven(value)

fun isNaN(value: f64): bool = value != value
fun isFinite(value: f64): bool = value - value == 0.0

/** The smaller of two f64s as IEEE 754-2019 minimum: NaN if either is NaN,
 *  and -0.0 below 0.0. */
fun fmin(left: f64, right: f64): f64 {
    val smaller = if (left < right) left else right
    // Equal values differ in bits only as ±0.0, whose OR is -0.0.
    val tie = if (left == right) f64FromBits(f64ToBits(left) | f64ToBits(right)) else smaller
    if (left != left || right != right) left + right else tie
}
/** The larger of two f64s as IEEE 754-2019 maximum: NaN if either is NaN,
 *  and 0.0 above -0.0. */
fun fmax(left: f64, right: f64): f64 {
    val larger = if (left > right) left else right
    // Equal values differ in bits only as ±0.0, whose AND is 0.0.
    val tie = if (left == right) f64FromBits(f64ToBits(left) & f64ToBits(right)) else larger
    if (left != left || right != right) left + right else tie
}
fun fclamp(value: f64, minimum: f64, maximum: f64): f64 {
    val lower = if (value < minimum) minimum else value
    if (lower > maximum) maximum else lower
}
fun lerp(from: f64, to: f64, t: f64): f64 = from + (to - from) * t

// --- trigonometry -----------------------------------------------------------
// Ports of the FreeBSD msun (fdlibm) kernels, using only +, -, *, / and the
// exact operations above. No libm is involved, so native and Wasm builds return
// bit-identical results: an authoritative server and a predicting client agree.
// Range reduction is the Cody-Waite "medium" path, accurate for
// |x| < 2^20 * pi/2 (about 1.6 million) — far beyond any game angle.

@inline
fun __mathHigh(value: f64): int = f64ToBits(value) >> 32

fun __mathKernelSin(x: f64, y: f64, hasTail: bool): f64 {
    val z = x * x
    val w = z * z
    val r = __mathS2 + z * (__mathS3 + z * __mathS4) +
        z * w * (__mathS5 + z * __mathS6)
    val v = z * x
    if (!hasTail) x + v * (__mathS1 + z * r)
    else x - ((z * (0.5 * y - v * r) - y) - v * __mathS1)
}

fun __mathKernelCos(x: f64, y: f64): f64 {
    val z = x * x
    val w = z * z
    val r = z * (__mathC1 + z * (__mathC2 + z * __mathC3)) +
        w * w * (__mathC4 + z * (__mathC5 + z * __mathC6))
    val hz = 0.5 * z
    val one = 1.0 - hz
    one + (((1.0 - one) - hz) + (z * r - x * y))
}

// tan(x + y) for |x + y| <= ~pi/4 when odd is false, -1 / tan(x + y) when it
// is true (msun's k_tan.c).
fun __mathKernelTan(value: f64, tail: f64, odd: bool): f64 {
    var x = value
    var y = tail
    val hx = __mathHigh(x)
    val ix = hx & 2147483647
    val big = ix >= 1072010280
    if (big) {
        // |x| >= 0.6744: tan(pi/4 - x') with the pi/4 split in two parts
        if (hx < 0) {
            x = -x
            y = -y
        }
        x = (mathQuarterPi - x) + (__mathAtanLo1 - y)
        y = 0.0
    }
    val z = x * x
    val w = z * z
    var r = __mathT1 + w * (__mathT3 + w * (__mathT5 + w * (__mathT7 +
        w * (__mathT9 + w * __mathT11))))
    var v = z * (__mathT2 + w * (__mathT4 + w * (__mathT6 + w * (__mathT8 +
        w * (__mathT10 + w * __mathT12)))))
    val s = z * x
    r = y + z * (s * (r + v) + y)
    r = r + __mathT0 * s
    val sum = x + r
    if (big) {
        v = if (odd) -1.0 else 1.0
        val sign = if (hx < 0) -1.0 else 1.0
        return sign * (v - 2.0 * (x - (sum * sum / (sum + v) - r)))
    }
    if (!odd) return sum
    // -1 / (x + r), accurately: high parts with their low words cleared
    val sumHigh = __mathClearLow(sum)
    v = r - (sumHigh - x)
    val a = -1.0 / sum
    val t = __mathClearLow(a)
    t + a * ((1.0 + t * sumHigh) + t * v)
}

// sin (function 0), cos (1) or tan (2) of any finite x.
fun __mathTrig(x: f64, function: int): f64 {
    val ix = __mathHigh(x) & 2147483647
    if (ix <= 1072243195) {
        // |x| <= pi/4: no reduction.
        if (function == 1) {
            return if (ix < 1044381696) 1.0 else __mathKernelCos(x, 0.0)
        }
        if (function == 2) {
            return if (ix < 1044381696) x else __mathKernelTan(x, 0.0, false)
        }
        return if (ix < 1044381696) x else __mathKernelSin(x, 0.0, false)
    }
    if (ix >= 2146435072) return x - x // inf or NaN -> NaN
    val fn = roundEven(x * __mathInvPio2)
    var r = x - fn * __mathPio2_1
    var w = fn * __mathPio2_1t
    var y0 = r - w
    val j = ix >> 20
    var i = j - ((__mathHigh(y0) >> 20) & 2047)
    if (i > 16) {
        var t = r
        w = fn * __mathPio2_2
        r = t - w
        w = fn * __mathPio2_2t - ((t - r) - w)
        y0 = r - w
        i = j - ((__mathHigh(y0) >> 20) & 2047)
        if (i > 49) {
            t = r
            w = fn * __mathPio2_3
            r = t - w
            w = fn * __mathPio2_3t - ((t - r) - w)
            y0 = r - w
        }
    }
    val y1 = (r - y0) - w
    if (function == 2) return __mathKernelTan(y0, y1, (f64ToInt(fn) & 1) != 0)
    val quadrant = (f64ToInt(fn) + function) & 3
    if (quadrant == 0) __mathKernelSin(y0, y1, true)
    else if (quadrant == 1) __mathKernelCos(y0, y1)
    else if (quadrant == 2) -__mathKernelSin(y0, y1, true)
    else -__mathKernelCos(y0, y1)
}

fun sin(x: f64): f64 = __mathTrig(x, 0)
fun cos(x: f64): f64 = __mathTrig(x, 1)
fun tan(x: f64): f64 = __mathTrig(x, 2)

fun atan(value: f64): f64 {
    var x = value
    val hx = __mathHigh(x)
    val ix = hx & 2147483647
    if (ix >= 1141899264) {
        // |x| >= 2^66
        if (isNaN(x)) return x + x
        return if (hx > 0) __mathAtanHi3 + __mathAtanLo3
            else -__mathAtanHi3 - __mathAtanLo3
    }
    var id = -1
    if (ix < 1071382528) {
        // |x| < 0.4375
        if (ix < 1044381696) return x // |x| < 2^-27
    } else {
        x = fabs(x)
        if (ix < 1072889856) {
            // |x| < 1.1875
            if (ix < 1072037888) {
                id = 0
                x = (2.0 * x - 1.0) / (2.0 + x)
            } else {
                id = 1
                x = (x - 1.0) / (x + 1.0)
            }
        } else if (ix < 1073971200) {
            // |x| < 2.4375
            id = 2
            x = (x - 1.5) / (1.0 + 1.5 * x)
        } else {
            id = 3
            x = -1.0 / x
        }
    }
    val z = x * x
    val w = z * z
    val s1 = z * (__mathAT0 + w * (__mathAT2 + w * (__mathAT4 +
        w * (__mathAT6 + w * (__mathAT8 + w * __mathAT10)))))
    val s2 = w * (__mathAT1 + w * (__mathAT3 + w * (__mathAT5 +
        w * (__mathAT7 + w * __mathAT9))))
    if (id < 0) return x - x * (s1 + s2)
    val hi = if (id == 0) __mathAtanHi0 else if (id == 1) __mathAtanHi1
        else if (id == 2) __mathAtanHi2 else __mathAtanHi3
    val lo = if (id == 0) __mathAtanLo0 else if (id == 1) __mathAtanLo1
        else if (id == 2) __mathAtanLo2 else __mathAtanLo3
    val result = hi - ((x * (s1 + s2) - lo) - x)
    if (hx < 0) -result else result
}

/** The angle of the vector (x, y) from the +x axis, in (-pi, pi]. */
fun atan2(y: f64, x: f64): f64 {
    if (isNaN(x) || isNaN(y)) return x + y
    if (x == 1.0) return atan(y)
    val hx = __mathHigh(x)
    val hy = __mathHigh(y)
    // Bit 0: y is negative; bit 1: x is negative (sign bits, so -0.0 counts).
    var m = ((hy >> 31) & 1) | ((hx >> 30) & 2)
    if (y == 0.0) {
        return if (m <= 1) y else if (m == 2) mathPi else -mathPi
    }
    if (x == 0.0) return if (hy < 0) -mathHalfPi else mathHalfPi
    val xInfinite = !isFinite(x)
    val yInfinite = !isFinite(y)
    if (xInfinite) {
        if (yInfinite) {
            return if (m == 0) mathQuarterPi else if (m == 1) -mathQuarterPi
                else if (m == 2) 3.0 * mathQuarterPi else -3.0 * mathQuarterPi
        }
        return if (m == 0) 0.0 else if (m == 1) -0.0
            else if (m == 2) mathPi else -mathPi
    }
    if (yInfinite) return if (hy < 0) -mathHalfPi else mathHalfPi
    val k = (((hy & 2147483647) >> 20) - ((hx & 2147483647) >> 20))
    var z: f64 = 0.0
    if (k > 60) {
        z = mathHalfPi + 0.5 * __mathPiLo
        m = m & 1
    } else if (hx < 0 && k < -60) {
        z = 0.0
    } else z = atan(fabs(y / x))
    if (m == 0) z
    else if (m == 1) -z
    else if (m == 2) mathPi - (z - __mathPiLo)
    else (z - __mathPiLo) - mathPi
}

// --- power --------------------------------------------------------------------
// A port of FreeBSD msun's e_pow.c (fdlibm), built like the trigonometry above
// from +, -, *, / and exact operations, so native and Wasm builds agree bit for
// bit. pow follows C where it and JavaScript differ: pow(1, y) is 1 for every y
// and pow(-1, ±inf) is 1, where JavaScript gives NaN. (exp and log are below,
// with the other correctly rounded functions.)

// e
val mathE: f64 = f64FromBits(4613303445314885481)
// ln 2
val mathLn2: f64 = f64FromBits(4604418534313441775)
// 1 / ln 2
val __mathInvLn2: f64 = f64FromBits(4609176140021203710)
// exp polynomial (also pow's)
val __mathP1: f64 = f64FromBits(4595172819793696062)
// exp polynomial
val __mathP2: f64 = f64FromBits(-4654820494858601069)
// exp polynomial
val __mathP3: f64 = f64FromBits(4544508515198557740)
// exp polynomial
val __mathP4: f64 = f64FromBits(-4702957295668925455)
// exp polynomial
val __mathP5: f64 = f64FromBits(4496342204012209360)
// 1e300: squared, an overflow to infinity
val __mathHuge: f64 = f64FromBits(9094988921128908188)
// 1e-300: squared, an underflow to zero
val __mathTiny: f64 = f64FromBits(118622047889322841)
// 2^-1000
val __mathTwoM1000: f64 = f64FromBits(103582791429521408)
// 2^53
val __mathTwo53: f64 = f64FromBits(4845873199050653696)
// 2^-54
val __mathTwoM54: f64 = f64FromBits(4363988038922010624)
// 1/3
val __mathThird: f64 = f64FromBits(4599676419421066581)
// log2(1.5), its high part
val __mathDpH: f64 = f64FromBits(4603444093224222720)
// log2(1.5) - __mathDpH
val __mathDpL: f64 = f64FromBits(4489242115478376454)
// pow's log polynomial
val __mathL1: f64 = f64FromBits(4603579539098120963)
// pow's log polynomial
val __mathL2: f64 = f64FromBits(4601392076422097919)
// pow's log polynomial
val __mathL3: f64 = f64FromBits(4599676419357746765)
// pow's log polynomial
val __mathL4: f64 = f64FromBits(4598584653024936193)
// pow's log polynomial
val __mathL5: f64 = f64FromBits(4597478449480325989)
// pow's log polynomial
val __mathL6: f64 = f64FromBits(4596625081194860271)
// ln 2, its high 21 bits
val __mathLg2H: f64 = f64FromBits(4604418534330597376)
// ln 2 - __mathLg2H
val __mathLg2L: f64 = f64FromBits(-4746692435354555335)
// 2 / (3 ln 2)
val __mathCp: f64 = f64FromBits(4606838314010018813)
// __mathCp rounded to a float
val __mathCpH: f64 = f64FromBits(4606838314073325568)
// __mathCp - __mathCpH
val __mathCpL: f64 = f64FromBits(-4738297118486494731)
// 1 / ln 2, its high 24 bits
val __mathIvLn2H: f64 = f64FromBits(4609176139934466048)
// 1 / ln 2 - __mathIvLn2H
val __mathIvLn2L: f64 = f64FromBits(4491406094830001988)
// pow overflows when its log2 passes 1024 by more than this
val __mathPowOvt: f64 = f64FromBits(4365981760143196926)

@inline
fun __mathLow(value: f64): int = f64ToBits(value) & 0xffffffff

// The f64 whose high and low 32-bit words are these.
fun __mathWords(high: int, low: int): f64 =
    f64FromBits(((high & 0xffffffff) << 32) | (low & 0xffffffff))

// `value` with its low 32 bits cleared.
fun __mathClearLow(value: f64): f64 =
    f64FromBits(f64ToBits(value) & -4294967296)

// x · 2^n for a normal x (msun's scalbn, for the results that need it).
fun __mathScalbn(x: f64, n: int): f64 {
    val hx = __mathHigh(x)
    val k = ((hx & 0x7ff00000) >> 20) + n
    if (k > 0) return __mathWords((hx & 0x800fffff) | (k << 20), __mathLow(x))
    if (k <= -54) return __mathTiny * (if (hx < 0) -__mathTiny else __mathTiny)
    __mathWords((hx & 0x800fffff) | ((k + 54) << 20), __mathLow(x)) * __mathTwoM54
}

/** x raised to y, as C's pow: pow(x, ±0) and pow(1, y) are 1 even for a NaN,
 *  a negative x needs an integer y (NaN otherwise), and integer powers of
 *  integers are exact while representable. */
fun pow(x: f64, y: f64): f64 {
    val hx = __mathHigh(x)
    val lx = __mathLow(x)
    val hy = __mathHigh(y)
    val ly = __mathLow(y)
    var ix = hx & 0x7fffffff
    val iy = hy & 0x7fffffff
    if ((iy | ly) == 0) return 1.0
    if (hx == 0x3ff00000 && lx == 0) return 1.0
    if (ix > 0x7ff00000 || (ix == 0x7ff00000 && lx != 0) ||
        iy > 0x7ff00000 || (iy == 0x7ff00000 && ly != 0)) return x + y
    // For a negative x: 0 when y is not an integer, 1 when odd, 2 when even.
    var yisint = 0
    if (hx < 0) {
        if (iy >= 0x43400000) yisint = 2
        else if (iy >= 0x3ff00000) {
            val e = (iy >> 20) - 0x3ff
            if (e > 20) {
                val j = ly >> (52 - e)
                if ((j << (52 - e)) == ly) yisint = 2 - (j & 1)
            } else if (ly == 0) {
                val j = iy >> (20 - e)
                if ((j << (20 - e)) == iy) yisint = 2 - (j & 1)
            }
        }
    }
    if (ly == 0) {
        if (iy == 0x7ff00000) {
            // y is ±inf
            if (((ix - 0x3ff00000) | lx) == 0) return 1.0
            if (ix >= 0x3ff00000) return if (hy >= 0) y else 0.0
            return if (hy < 0) -y else 0.0
        }
        if (iy == 0x3ff00000) return if (hy < 0) 1.0 / x else x
        if (hy == 0x40000000) return x * x
        if (hy == 0x3fe00000 && hx >= 0) return sqrt(x)
    }
    var ax = fabs(x)
    if (lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000)) {
        // x is ±0, ±inf or ±1
        var z = ax
        if (hy < 0) z = 1.0 / z
        if (hx < 0) {
            if (((ix - 0x3ff00000) | yisint) == 0) z = (z - z) / (z - z)
            else if (yisint == 1) z = -z
        }
        return z
    }
    // n is 0 for a negative x, -1 otherwise
    var n = (if (hx < 0) 1 else 0) - 1
    if ((n | yisint) == 0) return (x - x) / (x - x)
    // the sign of the result: negative for a negative x to an odd power
    val s = if ((n | (yisint - 1)) == 0) -1.0 else 1.0
    // log2(|x|) = t1 + t2
    var t1 = 0.0
    var t2 = 0.0
    if (iy > 0x41e00000) {
        // |y| > 2^31
        if (iy > 0x43f00000) {
            // |y| > 2^64: over- or underflows
            if (ix <= 0x3fefffff) {
                return if (hy < 0) __mathHuge * __mathHuge
                    else __mathTiny * __mathTiny
            }
            if (ix >= 0x3ff00000) {
                return if (hy > 0) __mathHuge * __mathHuge
                    else __mathTiny * __mathTiny
            }
        }
        if (ix < 0x3fefffff) {
            return if (hy < 0) s * __mathHuge * __mathHuge
                else s * __mathTiny * __mathTiny
        }
        if (ix > 0x3ff00000) {
            return if (hy > 0) s * __mathHuge * __mathHuge
                else s * __mathTiny * __mathTiny
        }
        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4
        val t = ax - 1.0
        val w = (t * t) * (0.5 - t * (__mathThird - t * 0.25))
        val u = __mathIvLn2H * t
        val v = t * __mathIvLn2L - w * __mathInvLn2
        t1 = __mathClearLow(u + v)
        t2 = v - (t1 - u)
    } else {
        n = 0
        if (ix < 0x00100000) {
            // subnormal x
            ax = ax * __mathTwo53
            n = n - 53
            ix = __mathHigh(ax)
        }
        n = n + (ix >> 20) - 0x3ff
        val j = ix & 0x000fffff
        ix = j | 0x3ff00000
        // |x| < sqrt(3/2): k = 0; < sqrt(3): k = 1; else halve it
        var k = 0
        if (j > 0x3988E) {
            if (j < 0xBB67A) k = 1
            else {
                n = n + 1
                ix = ix - 0x00100000
            }
        }
        ax = __mathWords(ix, __mathLow(ax))
        val bp = if (k == 0) 1.0 else 1.5
        val dpH = if (k == 0) 0.0 else __mathDpH
        val dpL = if (k == 0) 0.0 else __mathDpL
        // ss = sH + sL = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5)
        var u = ax - bp
        var v = 1.0 / (ax + bp)
        val ss = u * v
        val sH = __mathClearLow(ss)
        var tH = __mathWords(((ix >> 1) | 0x20000000) + 0x00080000 + (k << 18), 0)
        var tL = ax - (tH - bp)
        val sL = v * ((u - sH * tH) - sH * tL)
        // log(ax)
        var s2 = ss * ss
        var r = s2 * s2 * (__mathL1 + s2 * (__mathL2 + s2 * (__mathL3 +
            s2 * (__mathL4 + s2 * (__mathL5 + s2 * __mathL6)))))
        r = r + sL * (sH + ss)
        s2 = sH * sH
        tH = __mathClearLow(3.0 + s2 + r)
        tL = r - ((tH - 3.0) - s2)
        u = sH * tH
        v = sL * tH + tL * ss
        // 2 / (3 log 2) · (ss + ...)
        val logH = __mathClearLow(u + v)
        val logL = v - (logH - u)
        val zH = __mathCpH * logH
        val zL = __mathCpL * logH + logL * __mathCp + dpL
        // log2(ax) = n + dpH + zH + zL
        val tn = f64FromInt(n)
        t1 = __mathClearLow(((zH + zL) + dpH) + tn)
        t2 = zL - (((t1 - tn) - dpH) - zH)
    }
    // (y1 + y2) · (t1 + t2), with y1 the high part of y
    val y1 = __mathClearLow(y)
    val pL = (y - y1) * t1 + y * t2
    var pH = y1 * t1
    var z = pL + pH
    var j = __mathHigh(z)
    val i = __mathLow(z)
    if (j >= 0x40900000) {
        // z >= 1024
        if (((j - 0x40900000) | i) != 0) return s * __mathHuge * __mathHuge
        if (pL + __mathPowOvt > z - pH) return s * __mathHuge * __mathHuge
    } else if ((j & 0x7fffffff) >= 0x4090cc00) {
        // z <= -1075
        if ((((j & 0xffffffff) - 0xc090cc00) | i) != 0) {
            return s * __mathTiny * __mathTiny
        }
        if (pL <= z - pH) return s * __mathTiny * __mathTiny
    }
    // 2^(pH + pL)
    val ia = j & 0x7fffffff
    var k = (ia >> 20) - 0x3ff
    n = 0
    if (ia > 0x3fe00000) {
        // |z| > 0.5: n = [z + 0.5]
        n = j + (0x00100000 >> (k + 1))
        k = ((n & 0x7fffffff) >> 20) - 0x3ff
        val t = __mathWords(n & ~(0x000fffff >> k), 0)
        n = ((n & 0x000fffff) | 0x00100000) >> (20 - k)
        if (j < 0) n = 0 - n
        pH = pH - t
    }
    var t = __mathClearLow(pL + pH)
    val u = t * __mathLg2H
    val v = (pL - (t - pH)) * mathLn2 + t * __mathLg2L
    z = u + v
    val w = v - (z - u)
    t = z * z
    val c = z - t * (__mathP1 + t * (__mathP2 + t * (__mathP3 + t * (__mathP4 +
        t * __mathP5))))
    val r = (z * c) / (c - 2.0) - (w + z * w)
    z = 1.0 - (r - z)
    j = __mathHigh(z) + (n << 20)
    if ((j >> 20) <= 0) z = __mathScalbn(z, n)
    else z = __mathWords(j, __mathLow(z))
    s * z
}

// --- correctly rounded functions (CORE-MATH) ----------------------------------
// Ports of CORE-MATH (https://core-math.gitlabpages.inria.fr), which returns the
// double nearest the exact result. CORE-MATH's fused multiply-adds become
// Dekker's exact products, so only +, -, *, /, sqrt and integer operations
// remain and every target agrees bit for bit.

// The rounding error of p = a * b: a * b - p exactly (Dekker's product, for
// |a|, |b| < 2^995 and no underflow).
@inline
fun __mathMulLow(a: f64, b: f64, p: f64): f64 {
    val ca = 134217729.0 * a
    val ah = ca - (ca - a)
    val al = a - ah
    val cb = 134217729.0 * b
    val bh = cb - (cb - b)
    val bl = b - bh
    (((ah * bh - p) + ah * bl) + al * bh) + al * bl
}

// The rounding error of p = a * a: a * a - p exactly (as __mathMulLow).
@inline
fun __mathSquareLow(a: f64, p: f64): f64 {
    val ca = 134217729.0 * a
    val ah = ca - (ca - a)
    val al = a - ah
    ((ah * ah - p) + 2.0 * ah * al) + al * al
}

// The high 64 bits of the unsigned 128-bit product a * b. The partial
// products go through an opaque call: LLVM would otherwise fuse them into a
// 128-bit multiplication, which wasm32 has only as a library call.
fun __mathMulHigh(a: int, b: int): int {
    val a0 = a & 0xffffffff
    val a1 = a >>> 32
    val b0 = b & 0xffffffff
    val b1 = b >>> 32
    val p01 = __mathMul32(a0, b1)
    val p10 = __mathMul32(a1, b0)
    val middle = (__mathMul32(a0, b0) >>> 32) + (p01 & 0xffffffff) + (p10 & 0xffffffff)
    __mathMul32(a1, b1) + (p01 >>> 32) + (p10 >>> 32) + (middle >>> 32)
}

@noinline
fun __mathMul32(a: int, b: int): int = a * b

/** sqrt(x^2 + y^2) correctly rounded, without overflow or underflow in
 *  between; ±inf in either argument gives inf even when the other is NaN. */
fun hypot(x: f64, y: f64): f64 {
    // A port of CORE-MATH's hypot.c (copyright 2022-2026 Alexei Sibidanov,
    // MIT licence: see the end of this file) for round-to-nearest.
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    val exponentMask = 0x7ff << 52
    val ax = fabs(x)
    val ay = fabs(y)
    if ((xb & exponentMask) == exponentMask || (yb & exponentMask) == exponentMask) {
        // A NaN or an infinity: an infinity wins over a quiet NaN.
        val wx = xb << 1
        val wy = yb << 1
        val infinity = exponentMask << 1
        val oneInfinite = (wx == infinity) != (wy == infinity)
        val oneQuiet = ((wx >>> 52) == 0xfff) != ((wy >>> 52) == 0xfff)
        if (oneInfinite && oneQuiet) return if (wx == infinity) ax * ax else ay * ay
        return ax + ay
    }
    val u = if (ax > ay) ax else ay
    val v = if (ax > ay) ay else ax
    var ub = f64ToBits(u)
    var vb = f64ToBits(v)
    if ((vb >>> 52) == 0) {
        // v is subnormal or zero
        if (vb == 0) return u
        if ((ub >>> 52) == 0) return __mathHypotSubnormal(ub, vb)
        // v's encoding as if its exponent field could go below 1
        val zeros = 63 - ((f64ToBits(f64FromInt(vb)) >>> 52) - 1023)
        vb = ((vb << (zeros - 11)) & (-1 >>> 12)) - ((zeros - 12) << 52)
    }
    // v < 2^-27 u: u^2 + v^2 rounds to u^2, and its root to u (unsigned: a
    // subnormal v's encoding above is below zero)
    if (u64(ub - vb) > u64(27 << 52)) return u
    // Scale u to [1, 2) and v by the same power of 2.
    val offset = (0x3ff << 52) - (ub & exponentMask)
    val xs = f64FromBits(ub + offset)
    val ys = f64FromBits(vb + offset)
    val x2 = xs * xs
    val dx2 = __mathSquareLow(xs, x2)
    val y2 = ys * ys
    val dy2 = __mathSquareLow(ys, y2)
    val r2 = x2 + y2
    val ir2 = 0.5 / r2
    val dr2 = ((x2 - r2) + y2) + (dx2 + dy2)
    var th = sqrt(r2)
    val rsqrt = th * ir2
    // th^2 - r2 exactly: th is r2's correctly rounded root
    val th2 = th * th
    val dz = dr2 - ((th2 - r2) + __mathSquareLow(th, th2))
    var tl = rsqrt * dz
    val sum = th + tl
    tl = tl - (sum - th)
    th = sum
    val thb = f64ToBits(th)
    val aidr = f64ToBits(fabs(tl)) + (0x3fe << 52) - (thb & exponentMask)
    val mid = (aidr - 0x3c90000000000000 + 16) >>> 5
    val midm = (aidr - 0x3c80000000000000 + 16) >>> 5
    var result = thb
    if (mid == 0 || midm == 0 || u64(aidr) < u64(0x39b0000000000000) ||
        u64(aidr) > u64(0x3c9fffffffffff80)) {
        // Too close to a rounding boundary: decide it in integers.
        result = f64ToBits(__mathHypotHard(xs, ys))
    }
    result = result - offset
    if (result >= exponentMask) return __mathHuge * __mathHuge
    f64FromBits(result)
}

// hypot of two subnormals from their encodings a >= b > 0: the root of
// a^2 + b^2 found and rounded in integers.
@noinline
fun __mathHypotSubnormal(a: int, b: int): f64 {
    val af = f64FromInt(a)
    val bf = f64FromInt(b)
    val a2 = a << 1
    val b2 = b << 1
    var tm = f64ToInt(sqrt(af * af + bf * bf)) << 1
    // D = a2^2 + b2^2 - tm^2, exact in wrapping 64-bit arithmetic since it is small
    var d = a2 * a2 + b2 * b2 - tm * tm
    while (d > 2 * tm) {
        d = d - (2 * tm + 1)
        tm += 1
    }
    while (d < 0) {
        d = d + (2 * tm - 1)
        tm -= 1
    }
    // tm = floor(sqrt(a2^2 + b2^2)); a midpoint is impossible here
    var rm = tm >> 1
    if (d != 0) rm = rm + (tm & 1)
    f64FromBits(rm)
}

// hypot of x in [1, 2) and y <= x close to a rounding boundary: Newton's
// root refined and rounded by comparing exact squares in integers.
@noinline
fun __mathHypotHard(x: f64, y: f64): f64 {
    val mantissa = -1 >>> 12
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    var bm = (xb & mantissa) | (1 << 52)
    var lm = (yb & mantissa) | (1 << 52)
    val be = xb >>> 52
    val le = yb >>> 52
    val rb = f64ToBits(sqrt(x * x + y * y))
    val bs = 2
    var rm = (rb & mantissa) | (1 << 52)
    var re = (rb >>> 52) - 0x3ff
    var i = 0
    while (i < 3) {
        if (rm == (1 << 52)) {
            rm = -1 >>> 11
            re -= 1
        } else rm -= 1
        i += 1
    }
    bm = bm << bs
    // squares wrap modulo 2^64: only small differences of them are used
    var m2 = bm * bm
    val ls = bs - (be - le)
    if (ls >= 0) {
        lm = lm << ls
        m2 = m2 + lm * lm
    } else {
        // lm^2 as 128 bits, shifted right by -2 ls with a sticky bit
        val shift = -2 * ls
        val high = __mathMulHigh(lm, lm)
        val low = lm * lm
        m2 = m2 + ((low >>> shift) | (high << (64 - shift)))
        if ((low & ((1 << shift) - 1)) != 0) m2 = m2 | 1
    }
    val k = bs + re
    var d = 0
    while (true) {
        rm = rm + 1 + (if (rm >= (1 << 53)) 1 else 0)
        val tm = rm << k
        d = m2 - tm * tm
        if (d <= 0) break
    }
    if (d != 0) {
        val small = if (rm <= (1 << 53)) 1 else 0
        val tm = (rm << k) - (1 << (k - small))
        d = m2 - tm * tm
        if (d != 0) rm = rm + (d >> 63)
        else rm = rm - (rm & (1 << (1 - small)))
    }
    if (rm >= (1 << 53)) {
        rm = rm >> 1
        re += 1
    }
    f64FromBits(((be - 1 + re) << 52) + rm)
}

/** e raised to x, correctly rounded. */
fun exp(x: f64): f64 {
    // A port of CORE-MATH's exp.c (copyright 2022-2026 Paul Zimmermann and
    // Alexei Sibidanov, MIT licence: see the end of this file).
    val xb = f64ToBits(x)
    val ax = xb & 0x7fffffffffffffff
    // exp(x) rounds to 1 for |x| <= 2^-54
    if (ax <= 0x3c90000000000000) return 1.0 + x
    if (ax >= 0x40862e42fefa39f0) {
        // |x| >= 0x1.62e42fefa39fp+9
        if (ax > 0x7ff0000000000000) return x + x
        if (ax == 0x7ff0000000000000) return if (xb < 0) 0.0 else x
        if (xb >= 0) return __mathHuge * __mathHuge
        // x <= -0x1.74910d52d3052p+9
        if (ax >= 0x40874910d52d3052) return __mathTwoM1000 * __mathTwoM1000
    }
    // x = (i0 / 2^6 + i1 / 2^12 + ie) log 2 + dx
    val t = roundEven(x * f64FromBits(4663219335549649662))
    val jt = f64ToInt(t)
    val i0 = (jt >> 6) & 0x3f
    val i1 = jt & 0x3f
    val ie = jt >> 12
    val t0h = f64FromBits(__mathExpT0High(i0))
    val t0l = f64FromBits(__mathExpT0Low(i0))
    val t1h = f64FromBits(__mathExpT1High(i1))
    val t1l = f64FromBits(__mathExpT1Low(i1))
    val th = t1h * t0h
    val tl = (t1h * t0l + t1l * t0h) + __mathMulLow(t1h, t0h, th)
    // Cody-Waite: |t| < 2^23 and log2 / 2^12's high part has 29 bits, so
    // its product with t is exact
    val dx = (x - f64FromBits(4550375338785374208) * t) + f64FromBits(4397510237898870310) * t
    val dx2 = dx * dx
    // 1 + dx (c0 + c1 dx + c2 dx^2 + c3 dx^3) approximates exp(dx) to 2^-76.173
    val p = (1.0 + dx * 0.5) +
        dx2 * (f64FromBits(4595172819796382975) + dx * f64FromBits(4586165620537168628))
    var fh = th
    var fl = tl + (th * dx) * p
    val eps = f64FromBits(4328645337158778880)
    if (x < f64FromBits(-4573929700241785646)) {
        // subnormal result: x < -0x1.6232bdd7abcd2p+9
        val bias = f64FromBits((1 - ie) << 52)
        val sum = bias + fh
        fl = fl + (fh - (sum - bias))
        fh = sum
        val lb = fh + (fl - eps)
        if (fh + (fl + eps) != lb) return __mathExpAccurate(x)
        return f64FromBits(f64ToBits(lb) & 0xfffffffffffff)
    }
    val lb = fh + (fl - eps)
    if (fh + (fl + eps) != lb) return __mathExpAccurate(x)
    f64FromBits(f64ToBits(lb) + (ie << 52))
}

// exp(x) for 2^-54 < |x| < 745 to about 2^-110, rounded: the path for
// results the fast path can't round with certainty.
@noinline
fun __mathExpAccurate(x: f64): f64 {
    val t = roundEven(x * f64FromBits(4663219335549649662))
    val jt = f64ToInt(t)
    val i0 = (jt >> 6) & 0x3f
    val i1 = jt & 0x3f
    val ie = jt >> 12
    val t0h = f64FromBits(__mathExpT0High(i0))
    val t0l = f64FromBits(__mathExpT0Low(i0))
    val t1h = f64FromBits(__mathExpT1High(i1))
    val t1l = f64FromBits(__mathExpT1Low(i1))
    val th = t1h * t0h
    val tl = (t1h * t0l + t1l * t0h) + __mathMulLow(t1h, t0h, th)
    // Cody-Waite with log2 / 2^12 in three parts
    val l2l = f64FromBits(4397510237898870310)
    val dx = x - f64FromBits(4550375338785374208) * t
    var dxl = l2l * t
    val dxll = f64FromBits(4150628921061420995) * t + __mathMulLow(l2l, t, dxl)
    val dxh = dx + dxl
    dxl = (dxl - (dxh - dx)) + dxll
    // Horner on double-doubles: (ch, cl) = (ch, cl) (dxh, dxl) + c[i]
    var ch = f64FromBits(__mathExpPoly(12))
    var cl = f64FromBits(__mathExpPoly(13))
    var i = 10
    while (i >= 0) {
        val ah = f64FromBits(__mathExpPoly(i))
        val p = dxh * ch
        val pl = __mathMulLow(dxh, ch, p)
        val s = p + ah
        val back = s - p
        val e = ((p - (s - back)) + (ah - back)) + pl
        val g = dxh * cl + (e + f64FromBits(__mathExpPoly(i + 1)))
        cl = dxl * ch + g
        ch = s
        i -= 2
    }
    // f = (dxh + dxl) (ch + cl), then (th + tl) f
    var fh = ch * dxh
    var fl = (ch * dxl + cl * dxh) + __mathMulLow(ch, dxh, fh)
    val gh = th * fh
    fl = (th * fl + tl * fh) + __mathMulLow(th, fh, gh)
    fh = gh
    // (th + tl) + f
    var sum = th + fh
    fl = (tl + fl) + (fh - (sum - th))
    fh = sum
    if (x < f64FromBits(-4573929700241785646)) {
        // subnormal result
        val bias = f64FromBits((1 - ie) << 52)
        sum = bias + fh
        fl = fl + (fh - (sum - bias))
        fh = sum
        return f64FromBits(f64ToBits(fh + fl) & 0xfffffffffffff)
    }
    sum = fh + fl
    fl = fl - (sum - fh)
    fh = sum
    // a low part within 4 units of 2^-52 or 0 of the high part: a listed exception?
    if (((f64ToBits(fl) + 4) & 0xfffffffffffff) <= 4) fh = __mathExpException(x, fh)
    f64FromBits(f64ToBits(fh) + (ie << 52))
}

// The listed exceptional value for x, or f when x isn't listed.
@noinline
fun __mathExpException(x: f64, f: f64): f64 {
    var a = 0
    var b = 21
    // invariant: table x at a <= x < table x at b
    while (a + 1 < b) {
        val m = (a + b) / 2
        if (x < f64FromBits(__mathExpExceptions(3 * m))) b = m else a = m
    }
    if (x == f64FromBits(__mathExpExceptions(3 * a))) {
        return f64FromBits(__mathExpExceptions(3 * a + 1)) +
            f64FromBits(__mathExpExceptions(3 * a + 2))
    }
    f
}

/** The natural logarithm of x, correctly rounded: -inf at ±0, NaN below. */
fun log(x: f64): f64 {
    // A port of CORE-MATH's log.c (copyright 2022-2026 Paul Zimmermann and
    // Tom Hubrecht, MIT licence: see the end of this file).
    var xb = f64ToBits(x)
    var e = (xb >>> 52) - 0x3ff
    if (e >= 0x400 || e == -0x3ff) {
        // x <= 0, NaN, inf or subnormal
        if (e == 0x400 || (e == 0xc00 && xb != (0xfff << 52))) return x + x
        if (x <= 0.0) return if (x < 0.0) (x - x) / 0.0 else -1.0 / 0.0
        xb = f64ToBits(x * f64FromBits(4841369599423283200))
        e = (xb >>> 52) - 0x3ff - 52
    }
    // x = 2^e m with 1 <= m < 2
    val mb = (0x3ff << 52) | (xb & 0xfffffffffffff)
    if (mb == 0x3ff0000000000000 && e == 0) return 0.0
    val m = 0x10000000000000 + (xb & 0xfffffffffffff)
    // above sqrt(2), halve m to avoid cancellation
    val c = if (m >= 0x16a09e667f3bcd) 1 else 0
    e += c
    val i = (m >>> (43 + c)) - 362
    val y = f64FromBits(mb) * (if (c == 1) 0.5 else 1.0)
    val r = f64FromBits(__mathLogInverse(i))
    val l1 = f64FromBits(__mathLogInverseLogHigh(i))
    val l2 = f64FromBits(__mathLogInverseLogLow(i))
    // z = r y - 1 exactly
    val ry = r * y
    val z = (ry - 1.0) + __mathMulLow(r, y, ry)
    // P(z) - z for |z| < 0.00212097167968735
    val z2 = z * z
    val p45 = f64FromBits(-4628201361054494877) * z + f64FromBits(4596373812674080900)
    val p23 = f64FromBits(-4625196817304027658) * z + f64FromBits(4599676419421041880)
    var ph = p45 * z2 + p23
    ph = ph * z + f64FromBits(-4620693217682128902)
    ph = ph * z2
    // e log(2) + l1 is exact: log2's high part and l1 are multiples of 2^-42
    val ee = f64FromInt(e)
    val hh = ee * f64FromBits(4604418534313441280) + l1
    val h = hh + z
    var l = z - (h - hh)
    l = ph + (l + l2)
    l = ee * f64FromBits(4408728642709317424) + l
    // absolute error below 2.8926e-21 (CORE-MATH's Gappa bound 0x1.b6p-69,
    // widened for the unfused multiply-adds)
    val err = f64FromBits(4299671006743625728)
    val left = h + (l - err)
    if (left == h + (l + err)) return left
    __mathLogAccurate(x)
}

// log(x) for a positive normal or subnormal x != 1 to about 2^-122, rounded.
@noinline
fun __mathLogAccurate(x: f64): f64 {
    var vh = __mathDintFrom(x, 0)
    val vp = __mathDintFrom(x, 2)
    var big = vp >> 1
    var i = vh >>> 55
    if (__mathULess(-5402926248376769404, vh)) {
        // above sqrt(2) 2^63
        big += 1
        i = i >> 1
    }
    // v / 2^big, an exponent change only
    val xp = (((vp >> 1) - big) << 1) | (vp & 1)
    // z = v r - 1 with r = 1 / (1 + i / 2^8)
    val j = 3 * (i - 128)
    val rh = __mathLogInverse2(j)
    val rl = __mathLogInverse2(j + 1)
    val rp = __mathLogInverse2(j + 2)
    var zh = __mathDintMul(vh, 0, xp, rh, rl, rp, 0)
    var zl = __mathDintMul(vh, 0, xp, rh, rl, rp, 1)
    var zp = __mathDintMul(vh, 0, xp, rh, rl, rp, 2)
    // minus one: (2^63, 0, ex 0, negative)
    val oh = -9223372036854775808
    val nh = __mathDintAdd(oh, 0, 1, zh, zl, zp, 0)
    val nl = __mathDintAdd(oh, 0, 1, zh, zl, zp, 1)
    zp = __mathDintAdd(oh, 0, 1, zh, zl, zp, 2)
    zh = nh
    zl = nl
    // log(1 + z) by the polynomial, Horner from the highest degree
    var ph = __mathLogPoly2(0)
    var pl = __mathLogPoly2(1)
    var pp = __mathLogPoly2(2)
    var k = 1
    while (k <= 13) {
        val mh = __mathDintMul(ph, pl, pp, zh, zl, zp, 0)
        val ml = __mathDintMul(ph, pl, pp, zh, zl, zp, 1)
        val mp = __mathDintMul(ph, pl, pp, zh, zl, zp, 2)
        if (k == 13) {
            ph = mh
            pl = ml
            pp = mp
        } else {
            val ch = __mathLogPoly2(3 * k)
            val cl = __mathLogPoly2(3 * k + 1)
            val cp = __mathLogPoly2(3 * k + 2)
            ph = __mathDintAdd(ch, cl, cp, mh, ml, mp, 0)
            pl = __mathDintAdd(ch, cl, cp, mh, ml, mp, 1)
            pp = __mathDintAdd(ch, cl, cp, mh, ml, mp, 2)
        }
        k += 1
    }
    // + (-log r)
    val gh = __mathLogInverseLog2(j)
    val gl = __mathLogInverseLog2(j + 1)
    val gp = __mathLogInverseLog2(j + 2)
    val qh = __mathDintAdd(gh, gl, gp, ph, pl, pp, 0)
    val ql = __mathDintAdd(gh, gl, gp, ph, pl, pp, 1)
    val qp = __mathDintAdd(gh, gl, gp, ph, pl, pp, 2)
    // + big log(2)
    val lh = -5660435428506895957
    val ll = -3899075386890062161
    val lp = -2
    val bh = __mathDintMulInt(big, lh, ll, lp, 0)
    val bl = __mathDintMulInt(big, lh, ll, lp, 1)
    val bp = __mathDintMulInt(big, lh, ll, lp, 2)
    val resultHigh = __mathDintAdd(qh, ql, qp, bh, bl, bp, 0)
    val resultPacked = __mathDintAdd(qh, ql, qp, bh, bl, bp, 2)
    __mathDintToDouble(resultHigh, resultPacked)
}


// --- 128-bit floats for the accurate paths (CORE-MATH dint.h) ------------------
// A dint is (-1)^sgn (hi + lo / 2^64) 2^(ex - 63) with hi's top bit set (or
// zero), held as three words: hi, lo and p = ex << 1 | sgn. An operation
// returns one word of its result (`part` 0: hi, 1: lo, 2: p), so a caller
// asks three times: these paths are rare, and nothing here allocates (an
// allocating callee would cost every fast path a collector frame).

// The number of leading zero bits of a 64-bit word.
fun __mathClz(x: int): int {
    if (x == 0) return 64
    if (x < 0) return 0
    val high = x >>> 32
    // floor(log2) from the exponent of an exactly converted 32-bit half
    if (high != 0) return 31 - ((f64ToBits(f64FromInt(high)) >>> 52) - 1023)
    63 - ((f64ToBits(f64FromInt(x)) >>> 52) - 1023)
}

@inline
fun __mathULess(a: int, b: int): bool = u64(a) < u64(b)

// The 128-bit (hi, lo) shifted left by n >= 0: the high word, then the low word.
fun __mathShl128High(hi: int, lo: int, n: int): int =
    if (n == 0) hi else if (n < 64) (hi << n) | (lo >>> (64 - n)) else if (n < 128) lo << (n - 64) else 0
fun __mathShl128Low(lo: int, n: int): int = if (n < 64) lo << n else 0

// The 128-bit (hi, lo) shifted right by n >= 0 (logically): high word, low word.
fun __mathShr128High(hi: int, n: int): int = if (n < 64) hi >>> n else 0
fun __mathShr128Low(hi: int, lo: int, n: int): int =
    if (n == 0) lo else if (n < 64) (lo >>> n) | (hi << (64 - n)) else if (n < 128) hi >>> (n - 64) else 0

@inline
fun __mathPart(part: int, hi: int, lo: int, ex: int, sgn: int): int =
    if (part == 0) hi else if (part == 1) lo else (ex << 1) | sgn

// The double x as a dint.
fun __mathDintFrom(x: f64, part: int): int {
    val bits = f64ToBits(x)
    var e = (bits >>> 52) & 0x7ff
    val m = (bits & 0xfffffffffffff) + (if (e != 0) 1 << 52 else 0)
    e = e - 0x3ff
    val t = __mathClz(m)
    __mathPart(part, m << t, 0, e - (if (t > 11) t - 12 else 0), if (x < 0.0) 1 else 0)
}

// a's magnitude compared with b's: -1, 0 or 1.
fun __mathDintCompare(ah: int, al: int, aex: int, bh: int, bl: int, bex: int): int {
    if (aex != bex) return if (aex > bex) 1 else -1
    if (ah != bh) return if (__mathULess(bh, ah)) 1 else -1
    if (al != bl) return if (__mathULess(bl, al)) 1 else -1
    0
}

@noinline
fun __mathDintAdd(ah: int, al: int, ap: int, bh: int, bl: int, bp: int, part: int): int {
    if ((ah | al) == 0) return __mathPart(part, bh, bl, bp >> 1, bp & 1)
    if ((bh | bl) == 0) return __mathPart(part, ah, al, ap >> 1, ap & 1)
    val aex = ap >> 1
    val asgn = ap & 1
    val order = __mathDintCompare(ah, al, aex, bh, bl, bp >> 1)
    if (order == 0) {
        if ((asgn ^ (bp & 1)) != 0) return 0
        return __mathPart(part, ah, al, aex + 1, asgn)
    }
    if (order < 0) return __mathDintAdd(bh, bl, bp, ah, al, ap, part)
    // |a| > |b|
    var sh2 = bh
    var sl2 = bl
    var ex = aex
    val bex = bp >> 1
    if (aex > bex) {
        val sh = aex - bex
        if (sh <= 128) {
            // round to nearest: add the last bit shifted out
            val bit = if (sh - 1 < 64) (sl2 >>> (sh - 1)) & 1 else (sh2 >>> (sh - 65)) & 1
            val low = sl2 + bit
            if (__mathULess(low, sl2)) sh2 += 1
            sl2 = low
        }
        val high = __mathShr128High(sh2, sh)
        sl2 = __mathShr128Low(sh2, sl2, sh)
        sh2 = high
    }
    var ch = 0
    var cl = 0
    if ((asgn ^ (bp & 1)) != 0) {
        cl = al - sl2
        ch = ah - sh2 - (if (__mathULess(al, sl2)) 1 else 0)
    } else {
        cl = al + sl2
        ch = ah + sh2 + (if (__mathULess(cl, al)) 1 else 0)
        val overflow = if (ch == ah) __mathULess(cl, al) else __mathULess(ch, ah)
        if (overflow) {
            // round the dropped bit to nearest, then shift the carry in
            val bit = cl & 1
            cl = cl + bit
            if (__mathULess(cl, bit)) ch += 1
            cl = (cl >>> 1) | (ch << 63)
            ch = (ch >>> 1) | (1 << 63)
            ex += 1
        }
    }
    val shift = if (ch != 0) __mathClz(ch) else 64 + (if (cl != 0) __mathClz(cl) else aex)
    if (shift < 0 || shift >= 128) return __mathPart(part, 0, 0, ex - shift, asgn)
    __mathPart(part, __mathShl128High(ch, cl, shift), __mathShl128Low(cl, shift), ex - shift, asgn)
}

// a b with 126 bits of accuracy.
@noinline
fun __mathDintMul(ah: int, al: int, ap: int, bh: int, bl: int, bp: int, part: int): int {
    var th = __mathMulHigh(ah, bh)
    var tl = ah * bh
    val m1h = __mathMulHigh(ah, bl)
    val m1l = ah * bl
    val m2h = __mathMulHigh(al, bh)
    val m2l = al * bh
    val ml = m1l + m2l
    val mh = m1h + m2h + (if (__mathULess(ml, m1l)) 1 else 0)
    val carry = if (mh == m1h) __mathULess(ml, m1l) else __mathULess(mh, m1h)
    if (carry) th += 1
    val low = tl + mh
    if (__mathULess(low, tl)) th += 1
    tl = low
    // keep the top bit set
    val ex = if ((th >>> 63) == 0) 1 else 0
    if (ex == 1) {
        th = (th << 1) | (tl >>> 63)
        tl = tl << 1
    }
    val rounded = tl + (ml >>> 63)
    if (__mathULess(rounded, tl)) th += 1
    __mathPart(part, th, rounded, (ap >> 1) + (bp >> 1) - ex + 1, (ap ^ bp) & 1)
}

// b a for a small integer b.
@noinline
fun __mathDintMulInt(b: int, ah: int, al: int, ap: int, part: int): int {
    if (b == 0) return 0
    val c = if (b < 0) -b else b
    val sgn = if (b < 0) 1 - (ap & 1) else ap & 1
    var th = __mathMulHigh(ah, c)
    var tl = ah * c
    var m = if (th != 0) __mathClz(th) else 64
    val shiftedHigh = __mathShl128High(th, tl, m)
    tl = __mathShl128Low(tl, m)
    th = shiftedHigh
    // (al c) << (m - 1) >> 63 as 128 bits
    val lh = __mathMulHigh(al, c)
    val ll = al * c
    val sh = __mathShl128High(lh, ll, m - 1)
    val sl = __mathShl128Low(ll, m - 1)
    val l2l = __mathShr128Low(sh, sl, 63)
    val l2h = __mathShr128High(sh, 63)
    var rl = l2l + tl
    var rh = l2h + th + (if (__mathULess(rl, l2l)) 1 else 0)
    val overflow = if (rh == l2h) __mathULess(rl, l2l) else __mathULess(rh, l2h)
    if (overflow) {
        val bit = rl & 1
        rl = rl + bit
        if (__mathULess(rl, bit)) rh += 1
        rl = (rl >>> 1) | (rh << 63)
        rh = (rh >>> 1) | (1 << 63)
        m -= 1
    }
    __mathPart(part, rh, rl, (ap >> 1) + 64 - m, sgn)
}

// A normal-range dint rounded to the nearest double; the bits after the
// rounding bit are never all zero for the results this is used for.
fun __mathDintToDouble(hi: int, p: int): f64 {
    val sgn = p & 1
    var r = (hi >>> 11) | (0x3ff << 52)
    var rd = f64FromBits(4363988038922010624)
    if (((hi >>> 10) & 1) != 0) rd = rd + f64FromBits(4368491638549381120)
    r = r | (sgn << 63)
    val rounded = f64FromBits(r) + (if (sgn == 0) rd else -rd)
    rounded * f64FromBits((((p >> 1) + 1023) & 0x7ff) << 52)
}

