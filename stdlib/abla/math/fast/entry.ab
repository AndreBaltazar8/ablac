// abla/math with today's fast results: the same declarations as abla/math, so a
// program switches between the two by its import alone. The functions are the
// fdlibm-style ports abla/math had before it became correctly rounded, kept
// bit for bit: within about 1 ulp, smaller and faster. fmin, fmax and fclamp
// follow abla/math's IEEE 754-2019 rules (NaN if any argument is NaN, -0 below
// +0), and fma is abla/math's exact one, so switching the import changes only
// the rounding of the transcendental functions.

import "abla/float"

fun min(left: int, right: int): int = if (left < right) left else right

fun max(left: int, right: int): int = if (left > right) left else right

fun clamp(value: int, minimum: int, maximum: int): int {
    val lower = if (value < minimum) minimum else value
    if (lower > maximum) maximum else lower
}

// --- f64 ----------------------------------------------------------------------

noescape extern:"intrinsic" fun ablaF64Sqrt(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Floor(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Ceil(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Trunc(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Abs(value: f64): f64
noescape extern:"intrinsic" fun ablaF64RoundEven(value: f64): f64
noescape extern:"intrinsic" fun ablaF64Minimum(left: f64, right: f64): f64
noescape extern:"intrinsic" fun ablaF64Maximum(left: f64, right: f64): f64
noescape extern:"intrinsic" fun ablaF64Fma(x: f64, y: f64, z: f64): f64
noescape extern:"intrinsic" fun ablaF64FmaIsFused(): bool

// pi
val mathPi: f64 = f64FromBits(4614256656552045848)
// pi / 2
val mathHalfPi: f64 = f64FromBits(4609753056924675352)
// pi / 4
val mathQuarterPi: f64 = f64FromBits(4605249457297304856)
// 2 pi
val mathTau: f64 = f64FromBits(4618760256179416344)
// pi - mathPi
val __mathPiLo: f64 = f64FromBits(4368955796522032135)
// 2 / pi
val __mathInvPio2: f64 = f64FromBits(4603909380684499075)
// first 33 bits of pi/2
val __mathPio2_1: f64 = f64FromBits(4609753056924401664)
// pi/2 - __mathPio2_1
val __mathPio2_1t: f64 = f64FromBits(4454258360616903473)
// second 33 bits of pi/2
val __mathPio2_2: f64 = f64FromBits(4454258360616747008)
// pi/2 - (__mathPio2_1 + __mathPio2_2)
val __mathPio2_2t: f64 = f64FromBits(4297306550709743731)
// third 33 bits of pi/2
val __mathPio2_3: f64 = f64FromBits(4297306550709518336)
// pi/2 - (__mathPio2_1 + __mathPio2_2 + __mathPio2_3)
val __mathPio2_3t: f64 = f64FromBits(4142048980368378305)
// sin kernel
val __mathS1: f64 = f64FromBits(-4628199217061079735)
// sin kernel
val __mathS2: f64 = f64FromBits(4575957461383575718)
// sin kernel
val __mathS3: f64 = f64FromBits(-4671919876304969259)
// sin kernel
val __mathS4: f64 = f64FromBits(4523617212983017085)
// sin kernel
val __mathS5: f64 = f64FromBits(-4730215680275931925)
// sin kernel
val __mathS6: f64 = f64FromBits(4460209850635244924)
// cos kernel
val __mathC1: f64 = f64FromBits(4586165620538955084)
// cos kernel
val __mathC2: f64 = f64FromBits(-4659324094485802633)
// cos kernel
val __mathC3: f64 = f64FromBits(4537941361668330896)
// cos kernel
val __mathC4: f64 = f64FromBits(-4714566979978243411)
// cos kernel
val __mathC5: f64 = f64FromBits(4477121870137962948)
// cos kernel
val __mathC6: f64 = f64FromBits(-4780295122622859052)
// tan kernel
val __mathT0: f64 = f64FromBits(4599676419421066595)
// tan kernel
val __mathT1: f64 = f64FromBits(4593971859893059194)
// tan kernel
val __mathT2: f64 = f64FromBits(4587938466107703806)
// tan kernel
val __mathT3: f64 = f64FromBits(4581960672245896759)
// tan kernel
val __mathT4: f64 = f64FromBits(4576262931677611155)
// tan kernel
val __mathT5: f64 = f64FromBits(4570429193025094440)
// tan kernel
val __mathT6: f64 = f64FromBits(4564358403679355669)
// tan kernel
val __mathT7: f64 = f64FromBits(4558562946408670465)
// tan kernel
val __mathT8: f64 = f64FromBits(4553182066015801448)
// tan kernel
val __mathT9: f64 = f64FromBits(4545397049192321702)
// tan kernel
val __mathT10: f64 = f64FromBits(4544897349388904425)
// tan kernel
val __mathT11: f64 = f64FromBits(-4687273268743220365)
// tan kernel
val __mathT12: f64 = f64FromBits(4538267711989316308)
// atan(0.5) hi
val __mathAtanHi0: f64 = f64FromBits(4602023952714414927)
// atan(1.0) hi
val __mathAtanHi1: f64 = f64FromBits(4605249457297304856)
// atan(1.5) hi
val __mathAtanHi2: f64 = f64FromBits(4607027438436873883)
// atan(inf) hi
val __mathAtanHi3: f64 = f64FromBits(4609753056924675352)
// atan(0.5) lo
val __mathAtanLo0: f64 = f64FromBits(4357843414468748770)
// atan(1.0) lo
val __mathAtanLo1: f64 = f64FromBits(4359948597267291143)
// atan(1.5) lo
val __mathAtanLo2: f64 = f64FromBits(4354989122426817469)
// atan(inf) lo
val __mathAtanLo3: f64 = f64FromBits(4364452196894661639)
// atan polynomial
val __mathAT0: f64 = f64FromBits(4599676419421066509)
// atan polynomial
val __mathAT1: f64 = f64FromBits(-4626998257160492092)
// atan polynomial
val __mathAT2: f64 = f64FromBits(4594314991288484863)
// atan polynomial
val __mathAT3: f64 = f64FromBits(-4630701217362536847)
// atan polynomial
val __mathAT4: f64 = f64FromBits(4591215095208222830)
// atan polynomial
val __mathAT5: f64 = f64FromBits(-4633165035261879699)
// atan polynomial
val __mathAT6: f64 = f64FromBits(4589464229703073105)
// atan polynomial
val __mathAT7: f64 = f64FromBits(-4634804155249132134)
// atan polynomial
val __mathAT8: f64 = f64FromBits(4587333258118041067)
// atan polynomial
val __mathAT9: f64 = f64FromBits(-4637946461342241745)
// atan polynomial
val __mathAT10: f64 = f64FromBits(4580351289466214929)

// IEEE-754 operations that every target rounds identically: these lower to
// single instructions (or LLVM's exact expansions) on x86-64, AArch64 and Wasm.
fun sqrt(value: f64): f64 = ablaF64Sqrt(value)
fun floor(value: f64): f64 = ablaF64Floor(value)
fun ceil(value: f64): f64 = ablaF64Ceil(value)
fun trunc(value: f64): f64 = ablaF64Trunc(value)
fun fabs(value: f64): f64 = ablaF64Abs(value)
/** Round half to even (IEEE roundTiesToEven), e.g. 2.5 -> 2.0, 3.5 -> 4.0. */
fun roundEven(value: f64): f64 = ablaF64RoundEven(value)

fun isNaN(value: f64): bool = value != value
fun isFinite(value: f64): bool = value - value == 0.0

/** The smaller of two f64s as IEEE 754-2019 minimum: NaN if either is NaN,
 *  and -0.0 below 0.0. */
fun fmin(left: f64, right: f64): f64 = ablaF64Minimum(left, right)
/** The larger of two f64s as IEEE 754-2019 maximum: NaN if either is NaN,
 *  and 0.0 above -0.0. */
fun fmax(left: f64, right: f64): f64 = ablaF64Maximum(left, right)
/** value held to [minimum, maximum] (maximum wins if they cross), with fmin's
 *  and fmax's rules: NaN if any argument is NaN, and -0.0 below 0.0. */
fun fclamp(value: f64, minimum: f64, maximum: f64): f64 =
    ablaF64Minimum(ablaF64Maximum(value, minimum), maximum)
fun lerp(from: f64, to: f64, t: f64): f64 = from + (to - from) * t
/** x * y + z rounded once (IEEE 754 fusedMultiplyAdd): the hardware's
 *  instruction where the target has one, an exact software routine elsewhere,
 *  so every target gives the same bits. */
fun fma(x: f64, y: f64, z: f64): f64 =
    if (ablaF64FmaIsFused()) ablaF64Fma(x, y, z) else __mathFmaSoftware(x, y, z)

// x y + z rounded once (IEEE 754 fusedMultiplyAdd), in integers: fma where the target has no fused multiply-add instruction, and at compile
// time. The exact sum is formed in 128 bits with a sticky bit, then rounded
// once to the nearest double (to even on a tie).
fun __mathFmaSoftware(x: f64, y: f64, z: f64): f64 {
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    val zb = f64ToBits(z)
    val xe = (xb >>> 52) & 0x7ff
    val ye = (yb >>> 52) & 0x7ff
    val ze = (zb >>> 52) & 0x7ff
    // an infinite, NaN or zero x or y: x y is exact
    if (xe == 0x7ff || ye == 0x7ff || (xb << 1) == 0 || (yb << 1) == 0) return x * y + z
    // x y finite and nonzero: an infinite or NaN z is the result
    if (ze == 0x7ff) return z + z
    // a zero z: x y rounded once, keeping its sign if it underflows to zero
    if ((zb << 1) == 0) return x * y
    // |x| = mx 2^ex and so on, with integer significands
    val mx = (xb & 0xfffffffffffff) | (if (xe != 0) 1 << 52 else 0)
    val my = (yb & 0xfffffffffffff) | (if (ye != 0) 1 << 52 else 0)
    val mz = (zb & 0xfffffffffffff) | (if (ze != 0) 1 << 52 else 0)
    val ex = (if (xe != 0) xe else 1) - 1075
    val ey = (if (ye != 0) ye else 1) - 1075
    val ez = (if (ze != 0) ze else 1) - 1075
    // P = mx my 2^ep and Z = mz 2^ezz, each with its top bit moved to bit 125
    val ph0 = __mathMulHigh(mx, my)
    val pl0 = mx * my
    val pshift = (if (ph0 != 0) __mathClz(ph0) else 64 + __mathClz(pl0)) - 2
    val ph = __mathShl128High(ph0, pl0, pshift)
    val pl = __mathShl128Low(pl0, pshift)
    val ep = ex + ey - pshift
    val zshift = 62 + __mathClz(mz)
    val zh = __mathShl128High(0, mz, zshift)
    val zl = __mathShl128Low(mz, zshift)
    val ezz = ez - zshift
    val ps = (xb ^ yb) >>> 63
    val zs = zb >>> 63
    // the larger magnitude first
    val pFirst = if (ep != ezz) ep > ezz else if (ph != zh) __mathULess(zh, ph) else !__mathULess(pl, zl)
    val bh = if (pFirst) ph else zh
    val bl = if (pFirst) pl else zl
    val be = if (pFirst) ep else ezz
    val bs = if (pFirst) ps else zs
    val sh = if (pFirst) zh else ph
    val sl = if (pFirst) zl else pl
    val d = be - (if (pFirst) ezz else ep)
    // the smaller one aligned, the bits shifted out kept as a sticky bit
    var th = __mathShr128High(sh, d)
    var tl = __mathShr128Low(sh, sl, d)
    val lost = if (d >= 128) true
        else __mathShl128High(th, tl, d) != sh || __mathShl128Low(tl, d) != sl
    if (lost) tl = tl | 1
    var rh = 0
    var rl = 0
    if (bs == (if (pFirst) zs else ps)) {
        rl = bl + tl
        rh = bh + th + (if (__mathULess(rl, bl)) 1 else 0)
    } else {
        rl = bl - tl
        rh = bh - th - (if (__mathULess(bl, tl)) 1 else 0)
        // an exact cancellation is +0 when rounding to nearest
        if ((rh | rl) == 0) return 0.0
    }
    // the sum's top 63 bits, the rest as a sticky bit: r 2^e, 2^62 <= r < 2^63
    val lr = if (rh != 0) __mathClz(rh) else 64 + __mathClz(rl)
    val nh = __mathShl128High(rh, rl, lr)
    val nl = __mathShl128Low(rl, lr)
    val r = (nh >>> 1) | (if ((nh & 1) != 0 || nl != 0) 1 else 0)
    val e = be + 65 - lr
    // round to 53 bits, or to the subnormal grid 2^-1074
    val k = if (e >= -1084) 10 else -(e + 1074)
    if (k >= 64) return if (bs == 1) -0.0 else 0.0
    var m = r >>> k
    val rem = r & ((1 << k) - 1)
    val half = 1 << (k - 1)
    if (rem > half || (rem == half && (m & 1) != 0)) m += 1
    if (k > 10) return f64FromBits(m | (bs << 63))
    if (e + 1085 + (m >>> 53) >= 2047) return if (bs == 1) -1.0 / 0.0 else 1.0 / 0.0
    f64FromBits((((e + 1084) << 52) + m) | (bs << 63))
}

// The number of leading zero bits of a 64-bit word.
fun __mathClz(x: int): int {
    if (x == 0) return 64
    if (x < 0) return 0
    val high = x >>> 32
    // floor(log2) from the exponent of an exactly converted 32-bit half
    if (high != 0) return 31 - ((f64ToBits(f64FromInt(high)) >>> 52) - 1023)
    63 - ((f64ToBits(f64FromInt(x)) >>> 52) - 1023)
}

@inline
fun __mathULess(a: int, b: int): bool = u64(a) < u64(b)

// The high 64 bits of the unsigned 128-bit product a * b, from 32-bit halves
// with the carries out of the low word counted. (LLVM fuses the textbook
// form, which sums the middle terms first, into a 128-bit multiplication
// that wasm32 has only as a library call; this form it leaves alone.)
@inline
fun __mathMulHigh(a: int, b: int): int {
    val a0 = a & 0xffffffff
    val a1 = a >>> 32
    val b0 = b & 0xffffffff
    val b1 = b >>> 32
    val p00 = a0 * b0
    val p01 = a0 * b1
    val p10 = a1 * b0
    val t = p00 + (p01 << 32)
    val t2 = t + (p10 << 32)
    a1 * b1 + (p01 >>> 32) + (p10 >>> 32) + (if (__mathULess(t, p00)) 1 else 0) +
        (if (__mathULess(t2, t)) 1 else 0)
}

// The 128-bit (hi, lo) shifted left by n >= 0: the high word, then the low word.
fun __mathShl128High(hi: int, lo: int, n: int): int =
    if (n == 0) hi else if (n < 64) (hi << n) | (lo >>> (64 - n)) else if (n < 128) lo << (n - 64) else 0
fun __mathShl128Low(lo: int, n: int): int = if (n < 64) lo << n else 0

// The 128-bit (hi, lo) shifted right by n >= 0 (logically): high word, low word.
fun __mathShr128High(hi: int, n: int): int = if (n < 64) hi >>> n else 0
fun __mathShr128Low(hi: int, lo: int, n: int): int =
    if (n == 0) lo else if (n < 64) (lo >>> n) | (hi << (64 - n)) else if (n < 128) hi >>> (n - 64) else 0

fun hypot(x: f64, y: f64): f64 = sqrt(x * x + y * y)

// --- trigonometry -----------------------------------------------------------
// Ports of the FreeBSD msun (fdlibm) kernels, using only +, -, *, / and the
// exact operations above. No libm is involved, so native and Wasm builds return
// bit-identical results: an authoritative server and a predicting client agree.
// Range reduction is the Cody-Waite "medium" path, accurate for
// |x| < 2^20 * pi/2 (about 1.6 million) — far beyond any game angle.

@inline
fun __mathHigh(value: f64): int = f64ToBits(value) >> 32

fun __mathKernelSin(x: f64, y: f64, hasTail: bool): f64 {
    val z = x * x
    val w = z * z
    val r = __mathS2 + z * (__mathS3 + z * __mathS4) +
        z * w * (__mathS5 + z * __mathS6)
    val v = z * x
    if (!hasTail) x + v * (__mathS1 + z * r)
    else x - ((z * (0.5 * y - v * r) - y) - v * __mathS1)
}

fun __mathKernelCos(x: f64, y: f64): f64 {
    val z = x * x
    val w = z * z
    val r = z * (__mathC1 + z * (__mathC2 + z * __mathC3)) +
        w * w * (__mathC4 + z * (__mathC5 + z * __mathC6))
    val hz = 0.5 * z
    val one = 1.0 - hz
    one + (((1.0 - one) - hz) + (z * r - x * y))
}

// tan(x + y) for |x + y| <= ~pi/4 when odd is false, -1 / tan(x + y) when it
// is true (msun's k_tan.c).
fun __mathKernelTan(value: f64, tail: f64, odd: bool): f64 {
    var x = value
    var y = tail
    val hx = __mathHigh(x)
    val ix = hx & 2147483647
    val big = ix >= 1072010280
    if (big) {
        // |x| >= 0.6744: tan(pi/4 - x') with the pi/4 split in two parts
        if (hx < 0) {
            x = -x
            y = -y
        }
        x = (mathQuarterPi - x) + (__mathAtanLo1 - y)
        y = 0.0
    }
    val z = x * x
    val w = z * z
    var r = __mathT1 + w * (__mathT3 + w * (__mathT5 + w * (__mathT7 +
        w * (__mathT9 + w * __mathT11))))
    var v = z * (__mathT2 + w * (__mathT4 + w * (__mathT6 + w * (__mathT8 +
        w * (__mathT10 + w * __mathT12)))))
    val s = z * x
    r = y + z * (s * (r + v) + y)
    r = r + __mathT0 * s
    val sum = x + r
    if (big) {
        v = if (odd) -1.0 else 1.0
        val sign = if (hx < 0) -1.0 else 1.0
        return sign * (v - 2.0 * (x - (sum * sum / (sum + v) - r)))
    }
    if (!odd) return sum
    // -1 / (x + r), accurately: high parts with their low words cleared
    val sumHigh = __mathClearLow(sum)
    v = r - (sumHigh - x)
    val a = -1.0 / sum
    val t = __mathClearLow(a)
    t + a * ((1.0 + t * sumHigh) + t * v)
}

// sin (function 0), cos (1) or tan (2) of any finite x.
fun __mathTrig(x: f64, function: int): f64 {
    val ix = __mathHigh(x) & 2147483647
    if (ix <= 1072243195) {
        // |x| <= pi/4: no reduction.
        if (function == 1) {
            return if (ix < 1044381696) 1.0 else __mathKernelCos(x, 0.0)
        }
        if (function == 2) {
            return if (ix < 1044381696) x else __mathKernelTan(x, 0.0, false)
        }
        return if (ix < 1044381696) x else __mathKernelSin(x, 0.0, false)
    }
    if (ix >= 2146435072) return x - x // inf or NaN -> NaN
    val fn = roundEven(x * __mathInvPio2)
    var r = x - fn * __mathPio2_1
    var w = fn * __mathPio2_1t
    var y0 = r - w
    val j = ix >> 20
    var i = j - ((__mathHigh(y0) >> 20) & 2047)
    if (i > 16) {
        var t = r
        w = fn * __mathPio2_2
        r = t - w
        w = fn * __mathPio2_2t - ((t - r) - w)
        y0 = r - w
        i = j - ((__mathHigh(y0) >> 20) & 2047)
        if (i > 49) {
            t = r
            w = fn * __mathPio2_3
            r = t - w
            w = fn * __mathPio2_3t - ((t - r) - w)
            y0 = r - w
        }
    }
    val y1 = (r - y0) - w
    if (function == 2) return __mathKernelTan(y0, y1, (f64ToInt(fn) & 1) != 0)
    val quadrant = (f64ToInt(fn) + function) & 3
    if (quadrant == 0) __mathKernelSin(y0, y1, true)
    else if (quadrant == 1) __mathKernelCos(y0, y1)
    else if (quadrant == 2) -__mathKernelSin(y0, y1, true)
    else -__mathKernelCos(y0, y1)
}

fun sin(x: f64): f64 = __mathTrig(x, 0)
fun cos(x: f64): f64 = __mathTrig(x, 1)
fun tan(x: f64): f64 = __mathTrig(x, 2)

fun atan(value: f64): f64 {
    var x = value
    val hx = __mathHigh(x)
    val ix = hx & 2147483647
    if (ix >= 1141899264) {
        // |x| >= 2^66
        if (isNaN(x)) return x + x
        return if (hx > 0) __mathAtanHi3 + __mathAtanLo3
            else -__mathAtanHi3 - __mathAtanLo3
    }
    var id = -1
    if (ix < 1071382528) {
        // |x| < 0.4375
        if (ix < 1044381696) return x // |x| < 2^-27
    } else {
        x = fabs(x)
        if (ix < 1072889856) {
            // |x| < 1.1875
            if (ix < 1072037888) {
                id = 0
                x = (2.0 * x - 1.0) / (2.0 + x)
            } else {
                id = 1
                x = (x - 1.0) / (x + 1.0)
            }
        } else if (ix < 1073971200) {
            // |x| < 2.4375
            id = 2
            x = (x - 1.5) / (1.0 + 1.5 * x)
        } else {
            id = 3
            x = -1.0 / x
        }
    }
    val z = x * x
    val w = z * z
    val s1 = z * (__mathAT0 + w * (__mathAT2 + w * (__mathAT4 +
        w * (__mathAT6 + w * (__mathAT8 + w * __mathAT10)))))
    val s2 = w * (__mathAT1 + w * (__mathAT3 + w * (__mathAT5 +
        w * (__mathAT7 + w * __mathAT9))))
    if (id < 0) return x - x * (s1 + s2)
    val hi = if (id == 0) __mathAtanHi0 else if (id == 1) __mathAtanHi1
        else if (id == 2) __mathAtanHi2 else __mathAtanHi3
    val lo = if (id == 0) __mathAtanLo0 else if (id == 1) __mathAtanLo1
        else if (id == 2) __mathAtanLo2 else __mathAtanLo3
    val result = hi - ((x * (s1 + s2) - lo) - x)
    if (hx < 0) -result else result
}

/** The angle of the vector (x, y) from the +x axis, in (-pi, pi]. */
fun atan2(y: f64, x: f64): f64 {
    if (isNaN(x) || isNaN(y)) return x + y
    if (x == 1.0) return atan(y)
    val hx = __mathHigh(x)
    val hy = __mathHigh(y)
    // Bit 0: y is negative; bit 1: x is negative (sign bits, so -0.0 counts).
    var m = ((hy >> 31) & 1) | ((hx >> 30) & 2)
    if (y == 0.0) {
        return if (m <= 1) y else if (m == 2) mathPi else -mathPi
    }
    if (x == 0.0) return if (hy < 0) -mathHalfPi else mathHalfPi
    val xInfinite = !isFinite(x)
    val yInfinite = !isFinite(y)
    if (xInfinite) {
        if (yInfinite) {
            return if (m == 0) mathQuarterPi else if (m == 1) -mathQuarterPi
                else if (m == 2) 3.0 * mathQuarterPi else -3.0 * mathQuarterPi
        }
        return if (m == 0) 0.0 else if (m == 1) -0.0
            else if (m == 2) mathPi else -mathPi
    }
    if (yInfinite) return if (hy < 0) -mathHalfPi else mathHalfPi
    val k = (((hy & 2147483647) >> 20) - ((hx & 2147483647) >> 20))
    var z: f64 = 0.0
    if (k > 60) {
        z = mathHalfPi + 0.5 * __mathPiLo
        m = m & 1
    } else if (hx < 0 && k < -60) {
        z = 0.0
    } else z = atan(fabs(y / x))
    if (m == 0) z
    else if (m == 1) -z
    else if (m == 2) mathPi - (z - __mathPiLo)
    else (z - __mathPiLo) - mathPi
}

// --- exponential, logarithm, power -------------------------------------------
// Ports of FreeBSD msun's e_exp.c, e_log.c and e_pow.c (fdlibm), built like the
// trigonometry above from +, -, *, / and exact operations, so native and Wasm
// builds agree bit for bit. V8 computes Math.exp, Math.log and Math.pow with the
// same code, so results match JavaScript's (in V8) exactly; pow follows C where
// the two differ: pow(1, y) is 1 for every y and pow(-1, ±inf) is 1, where
// JavaScript gives NaN.

// e
val mathE: f64 = f64FromBits(4613303445314885481)
// ln 2
val mathLn2: f64 = f64FromBits(4604418534313441775)
// exp overflows above this (709.782712893384)
val __mathExpOverflow: f64 = f64FromBits(4649454530587146735)
// exp underflows below this (-745.1332191019411)
val __mathExpUnderflow: f64 = f64FromBits(-4573606559926636463)
// ln 2, its high part (low 32 bits zero)
val __mathLn2Hi: f64 = f64FromBits(4604418534311723008)
// ln 2 - __mathLn2Hi
val __mathLn2Lo: f64 = f64FromBits(4461442080421002358)
// 1 / ln 2
val __mathInvLn2: f64 = f64FromBits(4609176140021203710)
// exp polynomial (also pow's)
val __mathP1: f64 = f64FromBits(4595172819793696062)
// exp polynomial
val __mathP2: f64 = f64FromBits(-4654820494858601069)
// exp polynomial
val __mathP3: f64 = f64FromBits(4544508515198557740)
// exp polynomial
val __mathP4: f64 = f64FromBits(-4702957295668925455)
// exp polynomial
val __mathP5: f64 = f64FromBits(4496342204012209360)
// 1e300: squared, an overflow to infinity
val __mathHuge: f64 = f64FromBits(9094988921128908188)
// 1e-300: squared, an underflow to zero
val __mathTiny: f64 = f64FromBits(118622047889322841)
// 2^-1000
val __mathTwoM1000: f64 = f64FromBits(103582791429521408)
// 2^54
val __mathTwo54: f64 = f64FromBits(4850376798678024192)
// 2^53
val __mathTwo53: f64 = f64FromBits(4845873199050653696)
// 2^-54
val __mathTwoM54: f64 = f64FromBits(4363988038922010624)
// 2^1023
val __mathTwo1023: f64 = f64FromBits(9214364837600034816)
// 1/3
val __mathThird: f64 = f64FromBits(4599676419421066581)
// log polynomial
val __mathLg1: f64 = f64FromBits(4604180019048437139)
// log polynomial
val __mathLg2: f64 = f64FromBits(4600877379321592324)
// log polynomial
val __mathLg3: f64 = f64FromBits(4598818590951641945)
// log polynomial
val __mathLg4: f64 = f64FromBits(4597174411056806063)
// log polynomial
val __mathLg5: f64 = f64FromBits(4595719342595441630)
// log polynomial
val __mathLg6: f64 = f64FromBits(4594685411790997151)
// log polynomial
val __mathLg7: f64 = f64FromBits(4594499633228436036)
// log2(1.5), its high part
val __mathDpH: f64 = f64FromBits(4603444093224222720)
// log2(1.5) - __mathDpH
val __mathDpL: f64 = f64FromBits(4489242115478376454)
// pow's log polynomial
val __mathL1: f64 = f64FromBits(4603579539098120963)
// pow's log polynomial
val __mathL2: f64 = f64FromBits(4601392076422097919)
// pow's log polynomial
val __mathL3: f64 = f64FromBits(4599676419357746765)
// pow's log polynomial
val __mathL4: f64 = f64FromBits(4598584653024936193)
// pow's log polynomial
val __mathL5: f64 = f64FromBits(4597478449480325989)
// pow's log polynomial
val __mathL6: f64 = f64FromBits(4596625081194860271)
// ln 2, its high 21 bits
val __mathLg2H: f64 = f64FromBits(4604418534330597376)
// ln 2 - __mathLg2H
val __mathLg2L: f64 = f64FromBits(-4746692435354555335)
// 2 / (3 ln 2)
val __mathCp: f64 = f64FromBits(4606838314010018813)
// __mathCp rounded to a float
val __mathCpH: f64 = f64FromBits(4606838314073325568)
// __mathCp - __mathCpH
val __mathCpL: f64 = f64FromBits(-4738297118486494731)
// 1 / ln 2, its high 24 bits
val __mathIvLn2H: f64 = f64FromBits(4609176139934466048)
// 1 / ln 2 - __mathIvLn2H
val __mathIvLn2L: f64 = f64FromBits(4491406094830001988)
// pow overflows when its log2 passes 1024 by more than this
val __mathPowOvt: f64 = f64FromBits(4365981760143196926)

@inline
fun __mathLow(value: f64): int = f64ToBits(value) & 0xffffffff

// The f64 whose high and low 32-bit words are these.
fun __mathWords(high: int, low: int): f64 =
    f64FromBits(((high & 0xffffffff) << 32) | (low & 0xffffffff))

// `value` with its low 32 bits cleared.
fun __mathClearLow(value: f64): f64 =
    f64FromBits(f64ToBits(value) & -4294967296)

// x · 2^n for a normal x (msun's scalbn, for the results that need it).
fun __mathScalbn(x: f64, n: int): f64 {
    val hx = __mathHigh(x)
    val k = ((hx & 0x7ff00000) >> 20) + n
    if (k > 0) return __mathWords((hx & 0x800fffff) | (k << 20), __mathLow(x))
    if (k <= -54) return __mathTiny * (if (hx < 0) -__mathTiny else __mathTiny)
    __mathWords((hx & 0x800fffff) | ((k + 54) << 20), __mathLow(x)) * __mathTwoM54
}

/** e raised to x. */
fun exp(value: f64): f64 {
    var x = value
    val negative = __mathHigh(x) < 0
    val hx = __mathHigh(x) & 0x7fffffff
    if (hx >= 0x40862E42) {
        // |x| >= 709.78...
        if (hx >= 0x7ff00000) {
            if (((hx & 0xfffff) | __mathLow(x)) != 0) return x + x
            return if (negative) 0.0 else x
        }
        if (x > __mathExpOverflow) return __mathHuge * __mathHuge
        if (x < __mathExpUnderflow) return __mathTwoM1000 * __mathTwoM1000
    }
    // The reduction below gives 2.7182818284590455; e itself is closer.
    if (x == 1.0) return mathE
    var hi = 0.0
    var lo = 0.0
    var k = 0
    if (hx > 0x3fd62e42) {
        // |x| > ln2 / 2: x = k·ln2 + r, |r| <= ln2 / 2
        if (hx < 0x3FF0A2B2) {
            if (negative) {
                hi = x + __mathLn2Hi
                lo = -__mathLn2Lo
                k = -1
            } else {
                hi = x - __mathLn2Hi
                lo = __mathLn2Lo
                k = 1
            }
        } else {
            k = f64ToInt(__mathInvLn2 * x + (if (negative) -0.5 else 0.5))
            val kf = f64FromInt(k)
            hi = x - kf * __mathLn2Hi
            lo = kf * __mathLn2Lo
        }
        x = hi - lo
    } else if (hx < 0x3e300000) {
        // |x| < 2^-28
        return 1.0 + x
    }
    val t = x * x
    val c = x - t * (__mathP1 + t * (__mathP2 + t * (__mathP3 + t * (__mathP4 +
        t * __mathP5))))
    if (k == 0) return 1.0 - ((x * c) / (c - 2.0) - x)
    val y = 1.0 - ((lo - (x * c) / (2.0 - c)) - hi)
    if (k >= -1021) {
        if (k == 1024) return y * 2.0 * __mathTwo1023
        return y * __mathWords((0x3ff + k) << 20, 0)
    }
    y * __mathWords((0x3ff + k + 1000) << 20, 0) * __mathTwoM1000
}

/** The natural logarithm of x: -inf at 0, NaN below. */
fun log(value: f64): f64 {
    var x = value
    var hx = __mathHigh(x)
    var k = 0
    if (hx < 0x00100000) {
        // x < 2^-1022: zero, negative or subnormal
        if (((hx & 0x7fffffff) | __mathLow(x)) == 0) return -__mathTwo54 / 0.0
        if (hx < 0) return (x - x) / 0.0
        k = -54
        x = x * __mathTwo54
        hx = __mathHigh(x)
    }
    if (hx >= 0x7ff00000) return x + x
    k = k + (hx >> 20) - 1023
    hx = hx & 0x000fffff
    // x = 2^k · m with m in [sqrt(2)/2, sqrt(2))
    val half = (hx + 0x95f64) & 0x100000
    x = __mathWords(hx | (half ^ 0x3ff00000), __mathLow(x))
    k = k + (half >> 20)
    val f = x - 1.0
    if ((0x000fffff & (2 + hx)) < 3) {
        // -2^-20 <= f < 2^-20
        if (f == 0.0) {
            if (k == 0) return 0.0
            val dk = f64FromInt(k)
            return dk * __mathLn2Hi + dk * __mathLn2Lo
        }
        val r = f * f * (0.5 - __mathThird * f)
        if (k == 0) return f - r
        val dk = f64FromInt(k)
        return dk * __mathLn2Hi - ((r - dk * __mathLn2Lo) - f)
    }
    val s = f / (2.0 + f)
    val dk = f64FromInt(k)
    val z = s * s
    val w = z * z
    val t1 = w * (__mathLg2 + w * (__mathLg4 + w * __mathLg6))
    val t2 = z * (__mathLg1 + w * (__mathLg3 + w * (__mathLg5 + w * __mathLg7)))
    val r = t2 + t1
    if (((hx - 0x6147a) | (0x6b851 - hx)) > 0) {
        val hfsq = 0.5 * f * f
        if (k == 0) return f - (hfsq - s * (hfsq + r))
        return dk * __mathLn2Hi - ((hfsq - (s * (hfsq + r) + dk * __mathLn2Lo)) - f)
    }
    if (k == 0) return f - s * (f - r)
    dk * __mathLn2Hi - ((s * (f - r) - dk * __mathLn2Lo) - f)
}

/** x raised to y, as C's pow: pow(x, ±0) and pow(1, y) are 1 even for a NaN,
 *  a negative x needs an integer y (NaN otherwise), and integer powers of
 *  integers are exact while representable. */
fun pow(x: f64, y: f64): f64 {
    val hx = __mathHigh(x)
    val lx = __mathLow(x)
    val hy = __mathHigh(y)
    val ly = __mathLow(y)
    var ix = hx & 0x7fffffff
    val iy = hy & 0x7fffffff
    if ((iy | ly) == 0) return 1.0
    if (hx == 0x3ff00000 && lx == 0) return 1.0
    if (ix > 0x7ff00000 || (ix == 0x7ff00000 && lx != 0) ||
        iy > 0x7ff00000 || (iy == 0x7ff00000 && ly != 0)) return x + y
    // For a negative x: 0 when y is not an integer, 1 when odd, 2 when even.
    var yisint = 0
    if (hx < 0) {
        if (iy >= 0x43400000) yisint = 2
        else if (iy >= 0x3ff00000) {
            val e = (iy >> 20) - 0x3ff
            if (e > 20) {
                val j = ly >> (52 - e)
                if ((j << (52 - e)) == ly) yisint = 2 - (j & 1)
            } else if (ly == 0) {
                val j = iy >> (20 - e)
                if ((j << (20 - e)) == iy) yisint = 2 - (j & 1)
            }
        }
    }
    if (ly == 0) {
        if (iy == 0x7ff00000) {
            // y is ±inf
            if (((ix - 0x3ff00000) | lx) == 0) return 1.0
            if (ix >= 0x3ff00000) return if (hy >= 0) y else 0.0
            return if (hy < 0) -y else 0.0
        }
        if (iy == 0x3ff00000) return if (hy < 0) 1.0 / x else x
        if (hy == 0x40000000) return x * x
        if (hy == 0x3fe00000 && hx >= 0) return sqrt(x)
    }
    var ax = fabs(x)
    if (lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000)) {
        // x is ±0, ±inf or ±1
        var z = ax
        if (hy < 0) z = 1.0 / z
        if (hx < 0) {
            if (((ix - 0x3ff00000) | yisint) == 0) z = (z - z) / (z - z)
            else if (yisint == 1) z = -z
        }
        return z
    }
    // n is 0 for a negative x, -1 otherwise
    var n = (if (hx < 0) 1 else 0) - 1
    if ((n | yisint) == 0) return (x - x) / (x - x)
    // the sign of the result: negative for a negative x to an odd power
    val s = if ((n | (yisint - 1)) == 0) -1.0 else 1.0
    // log2(|x|) = t1 + t2
    var t1 = 0.0
    var t2 = 0.0
    if (iy > 0x41e00000) {
        // |y| > 2^31
        if (iy > 0x43f00000) {
            // |y| > 2^64: over- or underflows
            if (ix <= 0x3fefffff) {
                return if (hy < 0) __mathHuge * __mathHuge
                    else __mathTiny * __mathTiny
            }
            if (ix >= 0x3ff00000) {
                return if (hy > 0) __mathHuge * __mathHuge
                    else __mathTiny * __mathTiny
            }
        }
        if (ix < 0x3fefffff) {
            return if (hy < 0) s * __mathHuge * __mathHuge
                else s * __mathTiny * __mathTiny
        }
        if (ix > 0x3ff00000) {
            return if (hy > 0) s * __mathHuge * __mathHuge
                else s * __mathTiny * __mathTiny
        }
        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4
        val t = ax - 1.0
        val w = (t * t) * (0.5 - t * (__mathThird - t * 0.25))
        val u = __mathIvLn2H * t
        val v = t * __mathIvLn2L - w * __mathInvLn2
        t1 = __mathClearLow(u + v)
        t2 = v - (t1 - u)
    } else {
        n = 0
        if (ix < 0x00100000) {
            // subnormal x
            ax = ax * __mathTwo53
            n = n - 53
            ix = __mathHigh(ax)
        }
        n = n + (ix >> 20) - 0x3ff
        val j = ix & 0x000fffff
        ix = j | 0x3ff00000
        // |x| < sqrt(3/2): k = 0; < sqrt(3): k = 1; else halve it
        var k = 0
        if (j > 0x3988E) {
            if (j < 0xBB67A) k = 1
            else {
                n = n + 1
                ix = ix - 0x00100000
            }
        }
        ax = __mathWords(ix, __mathLow(ax))
        val bp = if (k == 0) 1.0 else 1.5
        val dpH = if (k == 0) 0.0 else __mathDpH
        val dpL = if (k == 0) 0.0 else __mathDpL
        // ss = sH + sL = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5)
        var u = ax - bp
        var v = 1.0 / (ax + bp)
        val ss = u * v
        val sH = __mathClearLow(ss)
        var tH = __mathWords(((ix >> 1) | 0x20000000) + 0x00080000 + (k << 18), 0)
        var tL = ax - (tH - bp)
        val sL = v * ((u - sH * tH) - sH * tL)
        // log(ax)
        var s2 = ss * ss
        var r = s2 * s2 * (__mathL1 + s2 * (__mathL2 + s2 * (__mathL3 +
            s2 * (__mathL4 + s2 * (__mathL5 + s2 * __mathL6)))))
        r = r + sL * (sH + ss)
        s2 = sH * sH
        tH = __mathClearLow(3.0 + s2 + r)
        tL = r - ((tH - 3.0) - s2)
        u = sH * tH
        v = sL * tH + tL * ss
        // 2 / (3 log 2) · (ss + ...)
        val logH = __mathClearLow(u + v)
        val logL = v - (logH - u)
        val zH = __mathCpH * logH
        val zL = __mathCpL * logH + logL * __mathCp + dpL
        // log2(ax) = n + dpH + zH + zL
        val tn = f64FromInt(n)
        t1 = __mathClearLow(((zH + zL) + dpH) + tn)
        t2 = zL - (((t1 - tn) - dpH) - zH)
    }
    // (y1 + y2) · (t1 + t2), with y1 the high part of y
    val y1 = __mathClearLow(y)
    val pL = (y - y1) * t1 + y * t2
    var pH = y1 * t1
    var z = pL + pH
    var j = __mathHigh(z)
    val i = __mathLow(z)
    if (j >= 0x40900000) {
        // z >= 1024
        if (((j - 0x40900000) | i) != 0) return s * __mathHuge * __mathHuge
        if (pL + __mathPowOvt > z - pH) return s * __mathHuge * __mathHuge
    } else if ((j & 0x7fffffff) >= 0x4090cc00) {
        // z <= -1075
        if ((((j & 0xffffffff) - 0xc090cc00) | i) != 0) {
            return s * __mathTiny * __mathTiny
        }
        if (pL <= z - pH) return s * __mathTiny * __mathTiny
    }
    // 2^(pH + pL)
    val ia = j & 0x7fffffff
    var k = (ia >> 20) - 0x3ff
    n = 0
    if (ia > 0x3fe00000) {
        // |z| > 0.5: n = [z + 0.5]
        n = j + (0x00100000 >> (k + 1))
        k = ((n & 0x7fffffff) >> 20) - 0x3ff
        val t = __mathWords(n & ~(0x000fffff >> k), 0)
        n = ((n & 0x000fffff) | 0x00100000) >> (20 - k)
        if (j < 0) n = 0 - n
        pH = pH - t
    }
    var t = __mathClearLow(pL + pH)
    val u = t * __mathLg2H
    val v = (pL - (t - pH)) * mathLn2 + t * __mathLg2L
    z = u + v
    val w = v - (z - u)
    t = z * z
    val c = z - t * (__mathP1 + t * (__mathP2 + t * (__mathP3 + t * (__mathP4 +
        t * __mathP5))))
    val r = (z * c) / (c - 2.0) - (w + z * w)
    z = 1.0 - (r - z)
    j = __mathHigh(z) + (n << 20)
    if ((j >> 20) <= 0) z = __mathScalbn(z, n)
    else z = __mathWords(j, __mathLow(z))
    s * z
}

// --- f32 --------------------------------------------------------------------
// Each is its f64 namesake's value narrowed to the nearest f32. For sqrt and the
// roundings that is the correctly rounded f32 too; the others can differ from a
// correctly rounded f32 in the last unit, rarely, by rounding twice.

fun __mathF32(value: f32): f64 = ablaConvertF32ToF64(value)
fun __mathToF32(value: f64): f32 = ablaConvertF64ToF32(value)

fun sqrt(value: f32): f32 = __mathToF32(sqrt(__mathF32(value)))
fun floor(value: f32): f32 = __mathToF32(floor(__mathF32(value)))
fun ceil(value: f32): f32 = __mathToF32(ceil(__mathF32(value)))
fun trunc(value: f32): f32 = __mathToF32(trunc(__mathF32(value)))
fun fabs(value: f32): f32 = __mathToF32(fabs(__mathF32(value)))
fun roundEven(value: f32): f32 = __mathToF32(roundEven(__mathF32(value)))
fun isNaN(value: f32): bool = value != value
fun isFinite(value: f32): bool = isFinite(__mathF32(value))
fun fmin(left: f32, right: f32): f32 = __mathToF32(fmin(__mathF32(left), __mathF32(right)))
fun fmax(left: f32, right: f32): f32 = __mathToF32(fmax(__mathF32(left), __mathF32(right)))
fun fclamp(value: f32, minimum: f32, maximum: f32): f32 =
    __mathToF32(fclamp(__mathF32(value), __mathF32(minimum), __mathF32(maximum)))
fun fma(x: f32, y: f32, z: f32): f32 =
    __mathToF32(fma(__mathF32(x), __mathF32(y), __mathF32(z)))
fun lerp(from: f32, to: f32, t: f32): f32 = from + (to - from) * t
fun atan2(y: f32, x: f32): f32 = __mathToF32(atan2(__mathF32(y), __mathF32(x)))
fun hypot(x: f32, y: f32): f32 = __mathToF32(hypot(__mathF32(x), __mathF32(y)))
fun exp(value: f32): f32 = __mathToF32(exp(__mathF32(value)))
fun log(value: f32): f32 = __mathToF32(log(__mathF32(value)))
fun atan(value: f32): f32 = __mathToF32(atan(__mathF32(value)))
fun sin(value: f32): f32 = __mathToF32(sin(__mathF32(value)))
fun cos(value: f32): f32 = __mathToF32(cos(__mathF32(value)))
fun tan(value: f32): f32 = __mathToF32(tan(__mathF32(value)))
fun pow(x: f32, y: f32): f32 = __mathToF32(pow(__mathF32(x), __mathF32(y)))
