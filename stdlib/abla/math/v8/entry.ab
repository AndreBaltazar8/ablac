val __v8L3: f64 = f64FromBits(0x3FD55555518F264D)
val __v8L4: f64 = f64FromBits(0x3FD17460A91D4101)
val __v8L5: f64 = f64FromBits(0x3FCD864A93C9DB65)
val __v8L6: f64 = f64FromBits(0x3FCA7E284A454EEF)
// ln 2, its high 21 bits and the rest
