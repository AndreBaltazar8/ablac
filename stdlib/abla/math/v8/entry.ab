        if (ix < 0x3fefffff) {
            return if (hy < 0) s * __v8Huge * __v8Huge else s * __v8Tiny * __v8Tiny
        }
        if (ix > 0x3ff00000) {
            return if (hy > 0) s * __v8Huge * __v8Huge else s * __v8Tiny * __v8Tiny
        }
        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4
