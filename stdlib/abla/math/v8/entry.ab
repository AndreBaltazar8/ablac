val __v8IvLn2L: f64 = f64FromBits(0x3E54AE0BF85DDF44)

/** Math.pow(x, y), as JavaScript defines it: pow(x, ±0) is 1 for every x,
 *  a NaN anywhere else gives NaN, and so does pow(±1, ±inf). */
fun pow(x: f64, y: f64): f64 {
    val hx = __v8High(x)
    val lx = __v8Low(x)
    val hy = __v8High(y)
    val ly = __v8Low(y)
    var ix = hx & 0x7fffffff
    val iy = hy & 0x7fffffff
