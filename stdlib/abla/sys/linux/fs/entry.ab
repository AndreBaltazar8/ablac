// Linux x86-64 filesystem implementation with no project C host calls.
// Import `abla/fs` for the portable profile or this module explicitly when a
// small raw-kernel binary is preferred.

import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/bytes"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool

class Path(val text: string)

class FileInfo(
    val path: Path,
    val kind: int,
    val size: int,
    val revision: int
) {
    fun exists(): bool = this.kind != 0

    fun isFile(): bool = this.kind == 1

    fun isDirectory(): bool = this.kind == 2
}

class FileWatch(
    val paths: array<Path>,
    var revisions: array<int>
)

fun path(value: string): Path = Path(value)

private fun linuxLoadU16(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) + buffer.load(offset + 1) * 256

private fun linuxLoadU32(buffer: NativeByteBuffer, offset: int): int =
    linuxLoadU16(buffer, offset) +
    linuxLoadU16(buffer, offset + 2) * 65536

fun linuxFileInfo(filePath: Path): FileInfo = linuxStatInfo(filePath, 0)

// newfstatat with `flags`: 0 follows a symbolic link, AT_SYMLINK_NOFOLLOW (256)
// describes the link itself, as kind 4.
private fun linuxStatInfo(filePath: Path, flags: int): FileInfo {
    val status = nativeByteBuffer(144)
    val measured = linuxSyscall4(
        262,
        -100,
        nativeCStringAddress(filePath.text),
        nativePointerAddress(status.address),
        flags
    )
    var kind = 0
    var size = -1
    var revision = 0
    if (measured == 0) {
        val modeKind = linuxLoadU32(status, 24) / 4096
        kind = 3
        if (modeKind == 8) kind = 1
        if (modeKind == 4) kind = 2
        if (modeKind == 10) kind = 4
        size = status.loadI64(48)
        val modifiedSeconds = status.loadI64(88)
        val modifiedNanoseconds = status.loadI64(96)
        revision = modifiedSeconds * 1000000000 + modifiedNanoseconds
    }
    status.close()
    FileInfo(filePath, kind, size, revision)
}

fun currentDirectory(): Path {
    val buffer = nativeByteBuffer(4096)
    val measured = linuxSyscall2(
        79,
        nativePointerAddress(buffer.address),
        buffer.capacity
    )
    var result = "."
    if (measured > 0 && measured <= buffer.capacity) {
        result = buffer.adoptString(measured - 1)
    }
    if (measured <= 0 || measured > buffer.capacity) buffer.close()
    Path(result)
}

// The uid and home fields of /etc/passwd are fields 3 and 6 respectively.
private fun linuxPasswdHome(contents: string, uid: int): string? {
    var begin = 0
    while (begin < contents.size) {
        var end = begin
        while (end < contents.size && contents[end] != 10) end = end + 1
        var field = 0
        var start = begin
        var position = begin
        var parsedUid = -1
        var home = ""
        while (position <= end) {
            if (position == end || contents[position] == 58) {
                if (field == 2 && position > start) {
                    var value = 0
                    var valid = true
                    var digitAt = start
                    while (digitAt < position && valid) {
                        val digit = contents[digitAt] - 48
                        if (digit < 0 || digit > 9 || value > 429496729) valid = false
                        else {
                            value = value * 10 + digit
                            if (value > 4294967295) valid = false
                        }
                        digitAt = digitAt + 1
                    }
                    if (valid) parsedUid = value
                }
                if (field == 5) home = contents.slice(start, position)
                field = field + 1
                start = position + 1
            }
            position = position + 1
        }
        if (parsedUid == uid && home != "") return home
        begin = end + 1
    }
    null
}

/** HOME if set and nonempty, otherwise the effective uid's /etc/passwd home. */
fun homePath(): Path? {
    val environment = linuxEnvironment("HOME")
    if (environment.found && environment.value != "") return Path(environment.value)
    if (ablaHostIsMacOS()) return null
    val passwd = Path("/etc/passwd").readTextResult()
    if (!passwd.succeeded) return null
    val home = linuxPasswdHome(passwd.text, linuxSyscall0(107))
    if (home == null) null else Path(home)
}

fun Path.child(name: string): Path {
    var separator = "/"
    if (this.text.size > 0 && this.text[this.text.size - 1] == 47) {
        separator = ""
    }
    Path("${this.text}$separator$name")
}

private fun linuxParentPath(text: string): string {
    var end = text.size
    while (end > 1 && text[end - 1] == 47) end = end - 1
    var slash = -1
    var index = 0
    while (index < end) {
        if (text[index] == 47) slash = index
        index = index + 1
    }
    var result = "."
    if (slash == 0) result = "/"
    if (slash > 0) result = text.slice(0, slash)
    result
}

fun Path.parent(): Path = Path(linuxParentPath(this.text))

fun Path.name(): string {
    var end = this.text.size
    while (end > 1 && this.text[end - 1] == 47) end = end - 1
    var slash = -1
    var index = 0
    while (index < end) {
        if (this.text[index] == 47) slash = index
        index = index + 1
    }
    this.text.slice(slash + 1, end)
}

fun Path.extension(): string {
    val name = this.name()
    var dot = -1
    var index = 0
    while (index < name.size) {
        if (name[index] == 46) dot = index
        index = index + 1
    }
    var result = ""
    if (dot > 0 && dot + 1 < name.size) {
        result = name.slice(dot + 1, name.size)
    }
    result
}

fun Path.info(): FileInfo = linuxFileInfo(this)

/** What the path names itself: a symbolic link is not followed, and is kind 4
 *  with the size of its target's name. */
fun Path.linkInfo(): FileInfo = linuxStatInfo(this, 256)

fun Path.revision(): int = this.info().revision

fun Path.exists(): bool = this.info().exists()

fun Path.readText(): string {
    val info = this.info()
    var result = ""
    if (info.isFile()) {
        val descriptor = linuxOpen(this.text)
        if (descriptor.descriptor >= 0) {
            val read = linuxReadDescriptorText(descriptor.descriptor, info.size)
            descriptor.close()
            if (read.succeeded) result = read.text
        }
    }
    result
}

// A file's contents, or why they could not be read: `succeeded` is false with
// the system's error number (2: the file does not exist, 13: permission
// denied, 21: a directory), unlike readText's "" for every failure.
class FileReadResult(
    val text: string,
    val succeeded: bool,
    val errorCode: int
)

fun Path.readTextResult(): FileReadResult {
    val descriptor = linuxOpen(this.text)
    if (descriptor.descriptor < 0) {
        return FileReadResult("", false, -descriptor.descriptor)
    }
    val info = this.info()
    var result = FileReadResult("", false, 21)
    if (!info.isDirectory()) {
        result = linuxReadDescriptorText(descriptor.descriptor, info.size)
    }
    descriptor.close()
    result
}

// Reads a descriptor to its end. The stat size `expected` fits the first
// allocation with a byte to spare, so a regular file ends with one more read
// and no copy; what has more than its stat size (a /proc file says 0, a file
// can grow) is read on into a doubled allocation.
private trusted fun linuxReadDescriptorText(descriptor: int, expected: int): FileReadResult {
    var capacity = if (expected > 0) expected + 1 else 4096
    var address = ablaUnsafePointerAddress(ablaUnsafeAllocate(capacity + 1))
    var measured = 0
    var errorCode = 0
    var reading = true
    while (reading) {
        if (measured == capacity) {
            val grown = capacity * 2
            val replacement = ablaUnsafePointerAddress(ablaUnsafeAllocate(grown + 1))
            ablaUnsafeCopyMemory(replacement, address, measured)
            ablaUnsafeFree(nativePointerFromAddress(address))
            address = replacement
            capacity = grown
        }
        val amount = linuxSyscall3(0, descriptor, address + measured, capacity - measured)
        if (amount > 0) measured = measured + amount
        else if (amount == 0) reading = false
        else if (amount != -4) {
            errorCode = -amount
            reading = false
        }
    }
    if (errorCode == 0) FileReadResult(adoptNativeString(address, measured), true, 0)
    else {
        ablaUnsafeFree(nativePointerFromAddress(address))
        FileReadResult("", false, errorCode)
    }
}

fun linuxWriteAll(descriptor: int, contents: string): bool {
    val address = nativeStringDataAddress(contents)
    var written = 0
    var success = true
    while (success && written < contents.size) {
        val amount = linuxSyscall3(
            1,
            descriptor,
            address + written,
            contents.size - written
        )
        if (amount > 0) written = written + amount
        if (amount <= 0) success = false
    }
    success
}

private fun linuxCreateDirectories(text: string, mode: int = 0o777): bool {
    var success = true
    var index = 1
    while (success && index <= text.size) {
        if (index == text.size || text[index] == 47) {
            val component = text.slice(0, index)
            if (component != "" && component != ".") {
                val status = linuxSyscall2(
                    83,
                    nativeCStringAddress(component),
                    mode
                )
                if (status != 0 && status != -17) success = false
            }
        }
        index = index + 1
    }
    success
}

fun Path.createDirectories(mode: int = 0o777): bool = linuxCreateDirectories(this.text, mode)

fun Path.createParentDirectories(): bool {
    linuxCreateDirectories(linuxParentPath(this.text))
}

// Creation mode defaults to 0o666; existing files keep their permissions.
fun Path.writeText(contents: string, mode: int = 0o666): bool {
    if (mode < 0 || mode > 0o777) return false // 0o777 maximum.
    var success = linuxCreateDirectories(linuxParentPath(this.text))
    var descriptor = -1
    if (success) descriptor = linuxOpen(this.text, 577, mode).descriptor
    if (descriptor < 0) success = false
    if (success) success = linuxWriteAll(descriptor, contents)
    if (descriptor >= 0 && linuxSyscall1(3, descriptor) != 0) success = false
    success
}

// Append is a separate operation so buffered portable writers can flush in
// bounded chunks without retaining an open target-specific descriptor.
fun Path.appendText(contents: string): bool {
    var success = linuxCreateDirectories(linuxParentPath(this.text))
    var descriptor = -1
    // O_WRONLY | O_CREAT | O_APPEND.
    if (success) descriptor = linuxOpen(this.text, 1089, 0o666).descriptor
    if (descriptor < 0) success = false
    if (success) success = linuxWriteAll(descriptor, contents)
    if (descriptor >= 0 && linuxSyscall1(3, descriptor) != 0) success = false
    success
}

// New files use mode (default 0o666), filtered by umask. A replacement
// inherits the existing mode on its empty temporary FD before any write.
fun Path.writeTextAtomic(contents: string, mode: int = 0o666): bool {
    if (mode < 0 || mode > 0o777) return false // 0o777 maximum.
    val existingMode = this.permissions()
    val createMode = if (existingMode >= 0) existingMode else mode
    var success = linuxCreateDirectories(linuxParentPath(this.text))
    val temporary = Path("${this.text}.tmp.${linuxProcessId()}")
    var descriptor = -1
    if (success) descriptor = linuxOpen(temporary.text, 705, createMode).descriptor
    if (success && descriptor < 0) {
        temporary.remove()
        descriptor = linuxOpen(temporary.text, 705, createMode).descriptor
    }
    if (descriptor < 0) success = false
    if (success && existingMode >= 0) {
        success = linuxSyscall2(91, descriptor, existingMode) == 0
    }
    if (success) success = linuxWriteAll(descriptor, contents)
    if (success && linuxSyscall1(74, descriptor) != 0) success = false
    if (descriptor >= 0 && linuxSyscall1(3, descriptor) != 0) success = false
    if (success) {
        success = linuxSyscall2(
            82,
            nativeCStringAddress(temporary.text),
            nativeCStringAddress(this.text)
        ) == 0
    }
    if (!success) temporary.remove()
    success
}

// Creates the file with these contents and permissions, failing if anything
// is there already, so a secret is never readable by others on the way or
// written over what another process made.
fun Path.createExclusive(contents: string = "", mode: int = 0o600): bool {
    // O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC.
    val descriptor = linuxOpen(this.text, 524481, mode).descriptor
    if (descriptor < 0) return false
    var success = linuxWriteAll(descriptor, contents)
    if (linuxSyscall1(3, descriptor) != 0) success = false
    success
}

// chmod. Permission bits use octal, for example 0o700 or 0o600.
fun Path.setPermissions(mode: int): bool =
    linuxSyscall2(90, nativeCStringAddress(this.text), mode) == 0

// The permission bits (for example 0o700), or -1 when the path doesn't exist. A
// symbolic link is followed.
fun Path.permissions(): int {
    val status = nativeByteBuffer(144)
    val measured = linuxSyscall4(
        262,
        -100,
        nativeCStringAddress(this.text),
        nativePointerAddress(status.address),
        0
    )
    val mode = if (measured == 0) linuxLoadU32(status, 24) & 0o7777 else -1
    status.close()
    mode
}

// Makes this path a symbolic link to `target`, which is stored as written.
fun Path.linkTo(target: string): bool =
    linuxSyscall2(
        88,
        nativeCStringAddress(target),
        nativeCStringAddress(this.text)
    ) == 0

// What this symbolic link holds, or "" when it isn't one.
fun Path.linkTarget(): string {
    val buffer = nativeByteBuffer(4097)
    val measured = linuxSyscall3(
        89,
        nativeCStringAddress(this.text),
        nativePointerAddress(buffer.address),
        4096
    )
    var result = ""
    if (measured > 0) result = buffer.adoptString(measured)
    else buffer.close()
    result
}

// An advisory lock on a file (flock), across processes. It goes when the
// holding process does. What this process starts inherits it only when asked,
// and then it lasts until they have gone too.
class FileLock(val descriptor: int)

// A lock on this path, creating the file. Not held yet; `descriptor` is
// negative when the file can't be opened.
fun Path.fileLock(inherited: bool = false): FileLock {
    // O_WRONLY | O_CREAT, and O_CLOEXEC unless inherited.
    FileLock(linuxOpen(this.text, if (inherited) 65 else 524353, 0o666).descriptor)
}

// Waits for the lock.
fun FileLock.hold(): bool {
    var status = -4
    // A signal interrupts the wait (EINTR).
    while (status == -4 && this.descriptor >= 0) {
        status = linuxSyscall2(73, this.descriptor, 2)
    }
    status == 0
}

// Takes the lock only if it's free.
fun FileLock.tryHold(): bool =
    this.descriptor >= 0 && linuxSyscall2(73, this.descriptor, 6) == 0

fun FileLock.release(): bool =
    this.descriptor >= 0 && linuxSyscall2(73, this.descriptor, 8) == 0

fun Path.moveTo(destination: Path): bool {
    var success = linuxCreateDirectories(linuxParentPath(destination.text))
    if (success) {
        success = linuxSyscall2(
            82,
            nativeCStringAddress(this.text),
            nativeCStringAddress(destination.text)
        ) == 0
    }
    success
}

// What a path names itself (a symbolic link is not followed): 0 nothing, 1 a
// file, 2 a directory, 4 a symbolic link, 3 something else.
private fun linuxLinkKind(filePath: Path): int {
    val status = nativeByteBuffer(144)
    val measured = linuxSyscall4(
        262,
        -100,
        nativeCStringAddress(filePath.text),
        nativePointerAddress(status.address),
        256
    )
    var kind = 0
    if (measured == 0) {
        val modeKind = linuxLoadU32(status, 24) / 4096
        kind = 3
        if (modeKind == 8) kind = 1
        if (modeKind == 4) kind = 2
        if (modeKind == 10) kind = 4
    }
    status.close()
    kind
}

fun Path.isSymbolicLink(): bool = linuxLinkKind(this) == 4

/** The modification time in milliseconds since the Unix epoch (0 when the
 *  path does not exist). */
fun FileInfo.modifiedMilliseconds(): int = this.revision / 1000000

/** Copies a file's bytes to `destination`, creating its directory. */
fun Path.copyTo(destination: Path): bool =
    this.info().isFile() && destination.createParentDirectories() &&
        destination.writeText(this.readText())

/** Copies a directory and everything in it (or a file) to `destination`:
 *  directories are created, files copied, symbolic links followed. The
 *  number of files copied, or -1 when one could not be. */
fun Path.copyTreeTo(destination: Path): int {
    val info = this.info()
    if (info.isFile()) return if (this.copyTo(destination)) 1 else -1
    if (!info.isDirectory() || !destination.createDirectories()) return -1
    var count = 0
    for (entry in this.entries()) {
        val copied = entry.copyTreeTo(destination.child(entry.name()))
        if (copied < 0) return -1
        count = count + copied
    }
    count
}

/** Removes a file, or a directory and everything in it. A symbolic link is
 *  removed itself, never what it points to. Whether the path is gone. */
fun Path.removeTree(): bool {
    if (linuxLinkKind(this) == 2) {
        for (entry in this.entries()) entry.removeTree()
    }
    this.remove()
    linuxLinkKind(this) == 0
}

fun Path.remove(): bool {
    var status = linuxSyscall1(87, nativeCStringAddress(this.text))
    if (status != 0) status = linuxSyscall1(
        84,
        nativeCStringAddress(this.text)
    )
    status == 0
}

private fun linuxDirectoryEntryName(
    buffer: NativeByteBuffer,
    begin: int,
    end: int
): string {
    var length = 0
    while (begin + length < end && buffer.load(begin + length) != 0) {
        length = length + 1
    }
    val name = nativeByteBuffer(length + 1)
    var index = 0
    while (index < length) {
        name.store(index, buffer.load(begin + index))
        index = index + 1
    }
    name.store(length, 0)
    name.adoptString(length)
}

fun Path.entries(): array<Path> {
    val entries: array<Path> = []
    val descriptor = linuxOpen(this.text, 65536).descriptor
    if (descriptor >= 0) {
        val buffer = nativeByteBuffer(65536)
        var reading = true
        while (reading) {
            val measured = linuxSyscall3(
                217,
                descriptor,
                nativePointerAddress(buffer.address),
                buffer.capacity
            )
            if (measured <= 0) reading = false
            var offset = 0
            while (offset + 19 <= measured) {
                val recordLength = linuxLoadU16(buffer, offset + 16)
                val validRecord = recordLength >= 20 &&
                    offset + recordLength <= measured
                if (!validRecord) {
                    offset = measured
                    reading = false
                }
                if (validRecord) {
                    val name = linuxDirectoryEntryName(
                        buffer,
                        offset + 19,
                        offset + recordLength
                    )
                    if (name != "." && name != "..") {
                        entries.append(this.child(name))
                    }
                    offset = offset + recordLength
                }
            }
        }
        buffer.close()
        linuxSyscall1(3, descriptor)
    }
    entries
}

fun watchFiles(paths: array<Path>): FileWatch {
    val revisions: array<int> = []
    var index = 0
    while (index < paths.size) {
        revisions.append(paths[index].revision())
        index = index + 1
    }
    FileWatch(paths, revisions)
}

fun watchFile(filePath: Path): FileWatch = watchFiles([filePath])

private fun fileWatchUnit(): void {}

fun FileWatch.changed(): bool {
    var changed = this.paths.size != this.revisions.size
    var index = 0
    while (index < this.paths.size && !changed) {
        if (this.paths[index].revision() != this.revisions[index]) {
            changed = true
        }
        index = index + 1
    }
    changed
}

fun FileWatch.refresh(): void {
    val revisions: array<int> = []
    var index = 0
    while (index < this.paths.size) {
        revisions.append(this.paths[index].revision())
        index = index + 1
    }
    this.revisions = revisions
    fileWatchUnit()
}
