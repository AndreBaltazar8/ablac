// Linux x86-64 TCP transport and graceful SIGTERM handling implemented with
// direct syscalls. No libc or project C host capability is required.

import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/net/contracts"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// A peer IP and port; family is 4 or 6, with an IPv6 scope when present.
class SocketPeerAddress(val address: string, val port: int, val family: int, val scopeId: int = 0)

class Ipv4SocketAddress(val address: string, val port: int)

class Ipv6SocketAddress(
    val address: string,
    val port: int,
    val scopeId: int
)

class SocketReadResult(
    val bytes: string,
    val status: string,
    val errorCode: int
) {
    fun hasData(): bool = this.status == "data"
    fun reachedEof(): bool = this.status == "eof"
    fun timedOut(): bool = this.status == "timeout"
    fun failed(): bool = this.status == "error"
}

fun SocketReadResult.networkOutcome(
    operation: string = "read"
): NetworkReadOutcome {
    var state = 6
    if (this.status == "data") state = 1
    if (this.status == "eof") state = 2
    if (this.status == "timeout") state = 3
    if (this.errorCode == 11) state = 5
    NetworkReadOutcome(
        this.bytes,
        state,
        networkError(this.errorCode, operation)
    )
}

class SocketWriteResult(
    val written: int,
    val status: string,
    val errorCode: int
) {
    fun succeeded(): bool = this.status == "written"
    fun timedOut(): bool = this.status == "timeout"
    fun failed(): bool = this.status == "error"
}

fun SocketWriteResult.networkOutcome(
    operation: string = "write"
): NetworkWriteOutcome {
    var state = if (this.status == "written") 1 else 6
    if (this.status == "timeout") state = 3
    if (this.errorCode == 11) state = 5
    NetworkWriteOutcome(
        this.written,
        state,
        networkError(this.errorCode, operation)
    )
}

class SocketPollResult(
    val readable: bool,
    val writable: bool,
    val closed: bool,
    val timedOut: bool,
    val errorCode: int
) {
    fun failed(): bool = this.errorCode != 0
}

class SocketEvent(
    val descriptor: int,
    val readable: bool,
    val writable: bool,
    val closed: bool,
    val error: bool
)

class SocketEvents(
    val events: array<SocketEvent>,
    val timedOut: bool,
    val errorCode: int
) {
    fun failed(): bool = this.errorCode != 0
}

class UdpDatagram(
    val bytes: string,
    val source: Ipv4SocketAddress,
    val received: bool,
    val timedOut: bool,
    val truncated: bool,
    val errorCode: int
)

class UdpDatagramIpv6(
    val bytes: string,
    val source: Ipv6SocketAddress,
    val received: bool,
    val timedOut: bool,
    val truncated: bool,
    val errorCode: int
)

resource class TcpListener(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class TcpConnection(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class UdpSocket(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class SocketPoller(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

private var linuxTcpShutdownDescriptor: int = -1
private var linuxTcpShutdownSeen: bool = false

fun linuxNetStoreU16(
    var buffer: NativeByteBuffer,
    offset: int,
    value: int
): bool = buffer.store(offset, value) &&
    buffer.store(offset + 1, value >> 8)

fun linuxNetStoreU32(
    var buffer: NativeByteBuffer,
    offset: int,
    value: int
): bool = linuxNetStoreU16(buffer, offset, value) &&
    linuxNetStoreU16(buffer, offset + 2, value >> 16)

private fun linuxNetReadU16(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) * 256 + buffer.load(offset + 1)

fun linuxNetReadNativeU16(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) + buffer.load(offset + 1) * 256

fun linuxNetReadNativeU32(buffer: NativeByteBuffer, offset: int): int =
    linuxNetReadNativeU16(buffer, offset) +
    linuxNetReadNativeU16(buffer, offset + 2) * 65536

fun ipv4SocketAddress(address: string, port: int): Ipv4SocketAddress =
    Ipv4SocketAddress(address, port)

fun ipv4Any(port: int): Ipv4SocketAddress =
    Ipv4SocketAddress("0.0.0.0", port)

fun ipv4Loopback(port: int): Ipv4SocketAddress =
    Ipv4SocketAddress("127.0.0.1", port)

fun ipv6SocketAddress(
    address: string,
    port: int,
    scopeId: int = 0
): Ipv6SocketAddress = Ipv6SocketAddress(address, port, scopeId)

fun ipv6Any(port: int): Ipv6SocketAddress = Ipv6SocketAddress("::", port, 0)

fun ipv6Loopback(port: int): Ipv6SocketAddress =
    Ipv6SocketAddress("::1", port, 0)

fun Ipv4SocketAddress.isValid(): bool =
    linuxIpv4Octets(this.address).size == 4 &&
    this.port >= 0 && this.port <= 65535

private fun linuxNetHexDigit(byte: int): int {
    var value = -1
    if (byte >= 48 && byte <= 57) value = byte - 48
    if (byte >= 65 && byte <= 70) value = byte - 55
    if (byte >= 97 && byte <= 102) value = byte - 87
    value
}

private fun linuxIpv6ParseSide(side: string): array<int> {
    val words: array<int> = []
    var begin = 0
    var index = 0
    var valid = side.size > 0
    while (valid && index <= side.size) {
        if (index == side.size || side[index] == 58) {
            val length = index - begin
            if (length < 1 || length > 4) valid = false
            var value = 0
            var digit = begin
            while (valid && digit < index) {
                val decoded = linuxNetHexDigit(side[digit])
                if (decoded < 0) valid = false
                else value = value * 16 + decoded
                digit = digit + 1
            }
            if (valid) words.append(value)
            begin = index + 1
        }
        index = index + 1
    }
    if (!valid) words.append(-1)
    words
}

fun linuxIpv6Words(address: string): array<int> {
    val result: array<int> = []
    var compression = -1
    var duplicateCompression = false
    var index = 0
    while (index + 1 < address.size) {
        if (address[index] == 58 && address[index + 1] == 58) {
            if (compression >= 0) duplicateCompression = true
            else compression = index
            index = index + 1
        }
        index = index + 1
    }
    var left: array<int> = []
    var right: array<int> = []
    if (!duplicateCompression && compression >= 0) {
        if (compression > 0) {
            left = linuxIpv6ParseSide(address.slice(0, compression))
        }
        if (compression + 2 < address.size) {
            right = linuxIpv6ParseSide(
                address.slice(compression + 2, address.size)
            )
        }
        val valid = (left.size == 0 || left[left.size - 1] >= 0) &&
            (right.size == 0 || right[right.size - 1] >= 0) &&
            left.size + right.size < 8
        if (valid) {
            var word = 0
            while (word < left.size) {
                result.append(left[word])
                word = word + 1
            }
            var zero = left.size + right.size
            while (zero < 8) {
                result.append(0)
                zero = zero + 1
            }
            word = 0
            while (word < right.size) {
                result.append(right[word])
                word = word + 1
            }
        }
    } else if (!duplicateCompression && address.size > 0) {
        left = linuxIpv6ParseSide(address)
        if (left.size == 8 && left[7] >= 0) {
            var word = 0
            while (word < 8) {
                result.append(left[word])
                word = word + 1
            }
        }
    }
    result
}

fun Ipv6SocketAddress.isValid(): bool =
    linuxIpv6Words(this.address).size == 8 &&
    this.port >= 0 && this.port <= 65535 && this.scopeId >= 0

private fun linuxNetWriteIpv6Address(
    var buffer: NativeByteBuffer,
    address: Ipv6SocketAddress
): bool {
    val words = linuxIpv6Words(address.address)
    var valid = words.size == 8 && address.port >= 0 &&
        address.port <= 65535 && address.scopeId >= 0
    if (valid) {
        linuxNetStoreU16(buffer, 0, 10)
        buffer.store(2, address.port / 256)
        buffer.store(3, address.port - address.port / 256 * 256)
        linuxNetStoreU32(buffer, 4, 0)
        var word = 0
        while (word < 8) {
            buffer.store(8 + word * 2, words[word] / 256)
            buffer.store(
                9 + word * 2,
                words[word] - words[word] / 256 * 256
            )
            word = word + 1
        }
        linuxNetStoreU32(buffer, 24, address.scopeId)
    }
    valid
}

private fun linuxNetHexWord(value: int): string {
    val digits = "0123456789abcdef"
    var output = ""
    var shift = 12
    var started = false
    while (shift >= 0) {
        val divisor = if (shift == 12) 4096 else if (shift == 8) 256
            else if (shift == 4) 16 else 1
        val digit = value / divisor - value / (divisor * 16) * 16
        if (digit != 0 || started || shift == 0) {
            output = "$output${digits.slice(digit, digit + 1)}"
            started = true
        }
        shift = shift - 4
    }
    output
}

private fun linuxNetReadIpv6Address(buffer: NativeByteBuffer): Ipv6SocketAddress {
    var text = ""
    var word = 0
    while (word < 8) {
        if (word > 0) text = "$text:"
        text = "$text${linuxNetHexWord(
            buffer.load(8 + word * 2) * 256 +
            buffer.load(9 + word * 2)
        )}"
        word = word + 1
    }
    Ipv6SocketAddress(
        text,
        linuxNetReadU16(buffer, 2),
        linuxNetReadNativeU32(buffer, 24)
    )
}

private fun linuxNetWriteIpv4Address(
    var buffer: NativeByteBuffer,
    address: Ipv4SocketAddress
): bool {
    val octets = linuxIpv4Octets(address.address)
    var valid = octets.size == 4 && address.port >= 0 &&
        address.port <= 65535
    if (valid) {
        linuxNetStoreU16(buffer, 0, 2)
        buffer.store(2, address.port / 256)
        buffer.store(3, address.port - address.port / 256 * 256)
        var index = 0
        while (index < 4) {
            valid = buffer.store(4 + index, octets[index]) && valid
            index = index + 1
        }
    }
    valid
}

private fun linuxNetReadIpv4Address(buffer: NativeByteBuffer): Ipv4SocketAddress =
    Ipv4SocketAddress(
        "${buffer.load(4)}.${buffer.load(5)}.${buffer.load(6)}.${buffer.load(7)}",
        linuxNetReadU16(buffer, 2)
    )

fun linuxTcpCloseDescriptor(descriptor: int): bool =
    descriptor >= 0 && linuxSyscall1(3, descriptor) == 0

fun linuxIpv4Octets(address: string): array<int> {
    val octets: array<int> = []
    var valid = address.size >= 7 && address.size <= 15
    var value = 0
    var digits = 0
    var index = 0
    while (valid && index <= address.size) {
        val boundary = index == address.size || address[index] == 46
        if (boundary) {
            if (digits == 0 || value > 255 || octets.size >= 4) {
                valid = false
            } else {
                octets.append(value)
                value = 0
                digits = 0
            }
        } else {
            val digit = address[index] - 48
            if (digit < 0 || digit > 9 || digits >= 3) valid = false
            else {
                value = value * 10 + digit
                digits = digits + 1
            }
        }
        index = index + 1
    }
    // Callers require exactly four elements. Mark an otherwise four-element
    // invalid parse without introducing an aliasing branch result.
    if (!valid && octets.size == 4) octets.append(-1)
    octets
}

fun linuxPollSocket(
    descriptor: int,
    read: bool,
    write: bool,
    timeoutMilliseconds: int
): SocketPollResult {
    var readable = false
    var writable = false
    var closed = false
    var timedOut = false
    var errorCode = 0
    if (descriptor < 0) {
        errorCode = if (descriptor < -1) -descriptor else 9
    } else if (timeoutMilliseconds < 0 || timeoutMilliseconds > 600000) {
        errorCode = 22
    } else {
        var events = 0
        if (read) events = events | 1
        if (write) events = events | 4
        val pollDescriptor = nativeByteBuffer(8)
        linuxNetStoreU32(pollDescriptor, 0, descriptor)
        linuxNetStoreU16(pollDescriptor, 4, events)
        var polled = linuxSyscall3(
            7,
            nativePointerAddress(pollDescriptor.address),
            1,
            timeoutMilliseconds
        )
        while (polled == -4) {
            polled = linuxSyscall3(
                7,
                nativePointerAddress(pollDescriptor.address),
                1,
                timeoutMilliseconds
            )
        }
        if (polled == 0) timedOut = true
        if (polled < 0) errorCode = -polled
        if (polled > 0) {
            val returned = linuxNetReadNativeU16(pollDescriptor, 6)
            readable = (returned & 1) != 0
            writable = (returned & 4) != 0
            closed = (returned & 16) != 0 || (returned & 8192) != 0
            if ((returned & 8) != 0 || (returned & 32) != 0) errorCode = 5
        }
        pollDescriptor.close()
    }
    SocketPollResult(
        readable, writable, closed, timedOut, errorCode
    )
}

fun TcpConnection.poll(
    timeoutMilliseconds: int,
    read: bool = true,
    write: bool = false
): SocketPollResult = linuxPollSocket(
    this.descriptor, read, write, timeoutMilliseconds
)

fun UdpSocket.poll(
    timeoutMilliseconds: int,
    read: bool = true,
    write: bool = false
): SocketPollResult = linuxPollSocket(
    this.descriptor, read, write, timeoutMilliseconds
)

fun socketPoller(): SocketPoller =
    SocketPoller(linuxSyscall1(291, 524288))

fun linuxPollerControl(
    poller: SocketPoller,
    operation: int,
    descriptor: int,
    read: bool,
    write: bool
): bool {
    var succeeded = poller.descriptor >= 0 && descriptor >= 0
    val event = nativeByteBuffer(12)
    if (succeeded && operation != 2) {
        var events = 8192
        if (read) events = events | 1
        if (write) events = events | 4
        linuxNetStoreU32(event, 0, events)
        linuxNetStoreU32(event, 4, descriptor)
    }
    if (succeeded) {
        val pointer = if (operation == 2) 0
            else nativePointerAddress(event.address)
        succeeded = linuxSyscall4(
            233,
            poller.descriptor,
            operation,
            descriptor,
            pointer
        ) == 0
    }
    event.close()
    succeeded
}

fun SocketPoller.watchDescriptor(
    descriptor: int,
    read: bool = true,
    write: bool = false
): bool = linuxPollerControl(this, 1, descriptor, read, write)

fun SocketPoller.modifyDescriptor(
    descriptor: int,
    read: bool = true,
    write: bool = false
): bool = linuxPollerControl(this, 3, descriptor, read, write)

fun SocketPoller.unwatchDescriptor(descriptor: int): bool =
    linuxPollerControl(this, 2, descriptor, false, false)

fun SocketPoller.wait(
    maximumEvents: int = 64,
    timeoutMilliseconds: int = 5000
): SocketEvents {
    val events: array<SocketEvent> = []
    var timedOut = false
    var errorCode = 0
    if (this.descriptor < 0) errorCode = 9
    else if (maximumEvents < 1 || maximumEvents > 1024 ||
        timeoutMilliseconds < 0 || timeoutMilliseconds > 600000) {
        errorCode = 22
    } else {
        val buffer = nativeByteBuffer(maximumEvents * 12)
        var measured = linuxSyscall4(
            232,
            this.descriptor,
            nativePointerAddress(buffer.address),
            maximumEvents,
            timeoutMilliseconds
        )
        while (measured == -4) {
            measured = linuxSyscall4(
                232,
                this.descriptor,
                nativePointerAddress(buffer.address),
                maximumEvents,
                timeoutMilliseconds
            )
        }
        if (measured == 0) timedOut = true
        if (measured < 0) errorCode = -measured
        var index = 0
        while (index < measured) {
            val offset = index * 12
            val returned = linuxNetReadNativeU32(buffer, offset)
            events.append(SocketEvent(
                linuxNetReadNativeU32(buffer, offset + 4),
                (returned & 1) != 0,
                (returned & 4) != 0,
                (returned & 16) != 0 || (returned & 8192) != 0,
                (returned & 8) != 0
            ))
            index = index + 1
        }
        buffer.close()
    }
    SocketEvents(events, timedOut, errorCode)
}

fun SocketPoller.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = linuxTcpCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

// Bounded numeric-IPv4 client connection for low-level and compile-provider
// use. Nonblocking connect + poll prevents an unreachable peer from stalling
// the compiler or a service indefinitely; DNS remains a portable higher layer.
fun tcpConnectIpv4(
    address: string,
    port: int,
    timeoutMilliseconds: int
): TcpConnection {
    val octets = linuxIpv4Octets(address)
    var descriptor = -1
    if (octets.size == 4 && port > 0 && port <= 65535 &&
        timeoutMilliseconds > 0 && timeoutMilliseconds <= 10000) {
        descriptor = linuxSyscall3(41, 2, 526337, 0)
    }
    if (descriptor >= 0) {
        val socketAddress = nativeByteBuffer(16)
        linuxNetStoreU16(socketAddress, 0, 2)
        socketAddress.store(2, port / 256)
        socketAddress.store(3, port - (port / 256) * 256)
        var octet = 0
        while (octet < 4) {
            socketAddress.store(4 + octet, octets[octet])
            octet = octet + 1
        }
        val connected = linuxSyscall3(
            42,
            descriptor,
            nativePointerAddress(socketAddress.address),
            16
        )
        socketAddress.close()
        var ready = connected == 0
        var connectionError = 0
        if (connected == -115) {
            val pollDescriptor = nativeByteBuffer(8)
            linuxNetStoreU32(pollDescriptor, 0, descriptor)
            linuxNetStoreU16(pollDescriptor, 4, 4)
            var polled = linuxSyscall3(
                7,
                nativePointerAddress(pollDescriptor.address),
                1,
                timeoutMilliseconds
            )
            while (polled == -4) {
                polled = linuxSyscall3(
                    7,
                    nativePointerAddress(pollDescriptor.address),
                    1,
                    timeoutMilliseconds
                )
            }
            ready = polled > 0 && pollDescriptor.load(6) != 0
            pollDescriptor.close()
            if (ready) {
                val error = nativeByteBuffer(8)
                val errorLength = nativeByteBuffer(8)
                linuxNetStoreU32(errorLength, 0, 4)
                val inspected = linuxSyscall5(
                    55,
                    descriptor,
                    1,
                    4,
                    nativePointerAddress(error.address),
                    nativePointerAddress(errorLength.address)
                )
                if (inspected == 0) {
                    connectionError = linuxNetReadNativeU32(error, 0)
                } else connectionError = -inspected
                error.close()
                errorLength.close()
                ready = connectionError == 0
            }
        }
        if (ready) {
            // Clear O_NONBLOCK after the bounded connection phase.
            linuxSyscall3(72, descriptor, 4, 0)
        } else {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = if (connectionError > 0) -connectionError else -1
        }
    }
    TcpConnection(descriptor)
}

fun tcpConnect(
    address: Ipv4SocketAddress,
    timeoutMilliseconds: int = 5000
): TcpConnection = tcpConnectIpv4(
    address.address, address.port, timeoutMilliseconds
)

fun tcpConnectIpv6(
    address: Ipv6SocketAddress,
    timeoutMilliseconds: int = 5000
): TcpConnection {
    var descriptor = -22
    if (address.isValid() && timeoutMilliseconds > 0 &&
        timeoutMilliseconds <= 10000) {
        descriptor = linuxSyscall3(41, 10, 526337, 0)
    }
    if (descriptor >= 0) {
        val socketAddress = nativeByteBuffer(28)
        linuxNetWriteIpv6Address(socketAddress, address)
        val connected = linuxSyscall3(
            42,
            descriptor,
            nativePointerAddress(socketAddress.address),
            28
        )
        socketAddress.close()
        var ready = connected == 0
        var connectionError = 0
        if (connected == -115) {
            val readiness = linuxPollSocket(
                descriptor, false, true, timeoutMilliseconds
            )
            ready = readiness.writable && !readiness.failed()
            if (ready) {
                val error = nativeByteBuffer(8)
                val errorLength = nativeByteBuffer(8)
                linuxNetStoreU32(errorLength, 0, 4)
                val inspected = linuxSyscall5(
                    55,
                    descriptor,
                    1,
                    4,
                    nativePointerAddress(error.address),
                    nativePointerAddress(errorLength.address)
                )
                if (inspected == 0) {
                    connectionError = linuxNetReadNativeU32(error, 0)
                } else connectionError = -inspected
                error.close()
                errorLength.close()
                ready = connectionError == 0
            }
        }
        if (ready) linuxSyscall3(72, descriptor, 4, 0)
        else {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = if (connectionError > 0) -connectionError else -1
        }
    }
    TcpConnection(descriptor)
}

fun TcpConnection.readWithTimeout(
    maximum: int,
    timeoutMilliseconds: int
): string {
    var result = ""
    if (this.descriptor >= 0 && maximum > 0 && maximum <= 1048576 &&
        timeoutMilliseconds > 0) {
        val pollDescriptor = nativeByteBuffer(8)
        linuxNetStoreU32(pollDescriptor, 0, this.descriptor)
        linuxNetStoreU16(pollDescriptor, 4, 1)
        // poll(2) takes a 32-bit timeout.
        val wait = if (timeoutMilliseconds > 2147483647) 2147483647 else timeoutMilliseconds
        var polled = linuxSyscall3(
            7,
            nativePointerAddress(pollDescriptor.address),
            1,
            wait
        )
        while (polled == -4) {
            polled = linuxSyscall3(
                7,
                nativePointerAddress(pollDescriptor.address),
                1,
                wait
            )
        }
        val readable = polled > 0 && pollDescriptor.load(6) != 0
        pollDescriptor.close()
        if (readable) result = this.read(maximum)
    }
    result
}

fun TcpConnection.readWithTimeoutResult(
    maximum: int,
    timeoutMilliseconds: int
): SocketReadResult {
    val readiness = this.poll(timeoutMilliseconds)
    var result = SocketReadResult("", "error", readiness.errorCode)
    if (readiness.timedOut) result = SocketReadResult("", "timeout", 0)
    else if (readiness.readable || readiness.closed) {
        result = this.readResult(maximum)
    }
    result
}

fun TcpConnection.readNetwork(
    maximum: int,
    timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50
): NetworkReadOutcome {
    val started = linuxMonotonicMilliseconds()
    var result = NetworkReadOutcome(
        "", 3, networkError(110, "read")
    )
    var waiting = timeoutMilliseconds > 0 &&
        cancellationPollMilliseconds > 0
    while (waiting && linuxMonotonicMilliseconds() - started <
        timeoutMilliseconds) {
        if (cancellation.isRequested()) {
            result = NetworkReadOutcome(
                "", 4, networkError(125, "read")
            )
            waiting = false
        } else {
            var duration = timeoutMilliseconds -
                (linuxMonotonicMilliseconds() - started)
            if (duration > cancellationPollMilliseconds) {
                duration = cancellationPollMilliseconds
            }
            val incoming = this.readWithTimeoutResult(maximum, duration)
            if (!incoming.timedOut()) {
                result = incoming.networkOutcome()
                waiting = false
            }
        }
    }
    result
}

private fun linuxTcpEnableListenerReuse(
    descriptor: int,
    reusePort: bool
): int {
    val enabled = nativeByteBuffer(8)
    linuxNetStoreU32(enabled, 0, 1)
    // SOL_SOCKET=1, SO_REUSEADDR=2, SO_REUSEPORT=15.
    var status = linuxSyscall5(
        54, descriptor, 1, 2,
        nativePointerAddress(enabled.address), 4
    )
    if (status >= 0 && reusePort) status = linuxSyscall5(
        54, descriptor, 1, 15,
        nativePointerAddress(enabled.address), 4
    )
    enabled.close()
    status
}

fun tcpListenAddress(
    socketAddress: Ipv4SocketAddress,
    backlog: int = 128,
    reusePort: bool = false
): TcpListener {
    // AF_INET=2, SOCK_STREAM=1, SOCK_CLOEXEC=0x80000.
    var descriptor = -22
    if (socketAddress.isValid() && backlog > 0 && backlog <= 4096) {
        descriptor = linuxSyscall3(41, 2, 524289, 0)
    }
    if (descriptor >= 0) {
        val reuseStatus = linuxTcpEnableListenerReuse(
            descriptor, reusePort
        )
        if (reuseStatus < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = reuseStatus
        }
    }
    if (descriptor >= 0) {
        val address = nativeByteBuffer(16)
        val encoded = linuxNetWriteIpv4Address(address, socketAddress)
        var bound = -22
        if (encoded) bound = linuxSyscall3(
                49,
                descriptor,
                nativePointerAddress(address.address),
                16
            )
        address.close()
        if (bound < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = bound
        }
    }
    if (descriptor >= 0) {
        val listening = linuxSyscall2(50, descriptor, backlog)
        if (listening < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = listening
        }
    }
    TcpListener(descriptor)
}

fun tcpListenIpv6(
    socketAddress: Ipv6SocketAddress,
    backlog: int = 128,
    dualStack: bool = true,
    reusePort: bool = false
): TcpListener {
    var descriptor = -22
    if (socketAddress.isValid() && backlog > 0 && backlog <= 4096) {
        descriptor = linuxSyscall3(41, 10, 524289, 0)
    }
    if (descriptor >= 0) {
        val reuseStatus = linuxTcpEnableListenerReuse(
            descriptor, reusePort
        )
        if (reuseStatus < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = reuseStatus
        }
    }
    if (descriptor >= 0) {
        val enabled = nativeByteBuffer(8)
        linuxNetStoreU32(enabled, 0, if (dualStack) 0 else 1)
        linuxSyscall5(
            54, descriptor, 41, 26,
            nativePointerAddress(enabled.address), 4
        )
        enabled.close()
        val address = nativeByteBuffer(28)
        linuxNetWriteIpv6Address(address, socketAddress)
        val bound = linuxSyscall3(
            49,
            descriptor,
            nativePointerAddress(address.address),
            28
        )
        address.close()
        if (bound < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = bound
        }
    }
    if (descriptor >= 0) {
        val listening = linuxSyscall2(50, descriptor, backlog)
        if (listening < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = listening
        }
    }
    TcpListener(descriptor)
}

fun tcpListen(
    port: int,
    backlog: int = 128,
    reusePort: bool = false
): TcpListener {
    var descriptor = linuxSyscall3(41, 2, 524289, 0)
    if (descriptor >= 0) {
        val reuseStatus = linuxTcpEnableListenerReuse(
            descriptor, reusePort
        )
        if (reuseStatus < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = reuseStatus
        }
    }
    if (descriptor >= 0) {
        val address = nativeByteBuffer(16)
        linuxNetStoreU16(address, 0, 2)
        address.store(2, port / 256)
        address.store(3, port - (port / 256) * 256)
        address.store(4, 0)
        address.store(5, 0)
        address.store(6, 0)
        address.store(7, 0)
        val bound = linuxSyscall3(
            49,
            descriptor,
            nativePointerAddress(address.address),
            16
        )
        address.close()
        if (bound < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = bound
        }
    }
    if (descriptor >= 0) {
        val listening = linuxSyscall2(50, descriptor, backlog)
        if (listening < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = listening
        }
    }
    TcpListener(descriptor)
}

fun linuxTcpAcceptDescriptor(listenerDescriptor: int): int {
    var descriptor = -1
    if (listenerDescriptor >= 0) {
        descriptor = linuxSyscall4(
            288,
            listenerDescriptor,
            0,
            0,
            524288
        )
        while (descriptor == -4) {
            descriptor = linuxSyscall4(
                288,
                listenerDescriptor,
                0,
                0,
                524288
            )
        }
    }
    descriptor
}

fun TcpListener.accept(): TcpConnection =
    TcpConnection(linuxTcpAcceptDescriptor(this.descriptor))

fun linuxSocketAddress(
    descriptor: int,
    peer: bool
): Ipv4SocketAddress {
    val address = nativeByteBuffer(16)
    val length = nativeByteBuffer(8)
    linuxNetStoreU32(length, 0, 16)
    val status = linuxSyscall3(
        if (peer) 52 else 51,
        descriptor,
        nativePointerAddress(address.address),
        nativePointerAddress(length.address)
    )
    var result = Ipv4SocketAddress("", -1)
    if (status == 0) result = linuxNetReadIpv4Address(address)
    address.close()
    length.close()
    result
}

fun TcpListener.localAddress(): Ipv4SocketAddress =
    linuxSocketAddress(this.descriptor, false)

fun TcpListener.localPort(): int {
    val address = nativeByteBuffer(16)
    val length = nativeByteBuffer(8)
    linuxNetStoreU32(length, 0, 16)
    val status = linuxSyscall3(
        51,
        this.descriptor,
        nativePointerAddress(address.address),
        nativePointerAddress(length.address)
    )
    var port = -1
    if (status == 0) port = linuxNetReadU16(address, 2)
    address.close()
    length.close()
    port
}

fun TcpConnection.localAddress(): Ipv4SocketAddress =
    linuxSocketAddress(this.descriptor, false)

fun TcpConnection.peerAddress(): Ipv4SocketAddress =
    linuxSocketAddress(this.descriptor, true)

fun linuxSocketAddressIpv6(
    descriptor: int,
    peer: bool
): Ipv6SocketAddress {
    val address = nativeByteBuffer(28)
    val length = nativeByteBuffer(8)
    linuxNetStoreU32(length, 0, 28)
    val status = linuxSyscall3(
        if (peer) 52 else 51,
        descriptor,
        nativePointerAddress(address.address),
        nativePointerAddress(length.address)
    )
    var result = Ipv6SocketAddress("", -1, 0)
    if (status == 0 && linuxNetReadNativeU16(address, 0) == 10) {
        result = linuxNetReadIpv6Address(address)
    }
    address.close()
    length.close()
    result
}

fun TcpListener.localAddressIpv6(): Ipv6SocketAddress =
    linuxSocketAddressIpv6(this.descriptor, false)

fun TcpConnection.localAddressIpv6(): Ipv6SocketAddress =
    linuxSocketAddressIpv6(this.descriptor, false)

fun TcpConnection.peerAddressIpv6(): Ipv6SocketAddress =
    linuxSocketAddressIpv6(this.descriptor, true)

// Compress the longest run of at least two zero words, choosing the first
// on a tie. The existing IPv6 address reader retains its old spelling.
private fun linuxPeerIpv6Text(buffer: NativeByteBuffer): string {
    val words: array<int> = []
    for (i in 0 until 8) words.append(buffer.load(8 + i * 2) * 256 + buffer.load(9 + i * 2))
    var bestStart = -1
    var bestLength = 1
    var i = 0
    while (i < 8) {
        if (words[i] == 0) {
            val start = i
            while (i < 8 && words[i] == 0) i = i + 1
            if (i - start > bestLength) { bestStart = start; bestLength = i - start }
        } else i = i + 1
    }
    var text = ""
    i = 0
    while (i < 8) {
        if (i == bestStart) {
            text = "$text::"
            i = i + bestLength
        } else {
            if (text != "" && text[text.size - 1] != 58) text = "$text:"
            text = "$text${linuxNetHexWord(words[i])}"
            i = i + 1
        }
    }
    text
}

/** Peer address from the socket itself, or null for a non-IP socket or error. */
fun socketPeerAddress(descriptor: int): SocketPeerAddress? {
    if (descriptor < 0) return null
    val address = nativeByteBuffer(128)
    val length = nativeByteBuffer(8)
    linuxNetStoreU32(length, 0, 128)
    val status = linuxSyscall3(52, descriptor, nativePointerAddress(address.address),
        nativePointerAddress(length.address))
    var result: SocketPeerAddress? = null
    if (status == 0) {
        val family = linuxNetReadNativeU16(address, 0)
        if (family == 2 && linuxNetReadNativeU32(length, 0) >= 16) {
            val peer = linuxNetReadIpv4Address(address)
            result = SocketPeerAddress(peer.address, peer.port, 4)
        } else if (family == 10 && linuxNetReadNativeU32(length, 0) >= 28) {
            result = SocketPeerAddress(linuxPeerIpv6Text(address), linuxNetReadU16(address, 2), 6,
                linuxNetReadNativeU32(address, 24))
        }
    }
    address.close()
    length.close()
    result
}

fun linuxSocketSetNonblocking(descriptor: int, enabled: bool): bool {
    var succeeded = descriptor >= 0
    var flags = -1
    if (succeeded) flags = linuxSyscall3(72, descriptor, 3, 0)
    if (flags < 0) succeeded = false
    if (succeeded) {
        val next = if (enabled) flags | 2048 else flags & -2049
        succeeded = linuxSyscall3(72, descriptor, 4, next) == 0
    }
    succeeded
}

// SO_RCVTIMEO and SO_SNDTIMEO: how long one blocking read or write of this
// socket may wait, 0 for as long as it takes. It also covers calls made on the
// socket by a library such as OpenSSL.
fun linuxSocketSetTimeouts(
    descriptor: int,
    readMilliseconds: int,
    writeMilliseconds: int
): bool {
    val interval = nativeByteBuffer(16)
    interval.storeI64(0, readMilliseconds / 1000)
    interval.storeI64(8, (readMilliseconds % 1000) * 1000)
    val read = linuxSyscall5(
        54, descriptor, 1, 20, nativePointerAddress(interval.address), 16
    )
    interval.storeI64(0, writeMilliseconds / 1000)
    interval.storeI64(8, (writeMilliseconds % 1000) * 1000)
    val write = linuxSyscall5(
        54, descriptor, 1, 21, nativePointerAddress(interval.address), 16
    )
    interval.close()
    read == 0 && write == 0
}

// SO_RCVTIMEO (20) or SO_SNDTIMEO (21) in milliseconds; 0 for none.
fun linuxSocketTimeout(descriptor: int, option: int): int {
    val value = nativeByteBuffer(24)
    value.storeI64(0, 0)
    value.storeI64(8, 0)
    value.storeI64(16, 16)
    linuxSyscall5(
        55, descriptor, 1, option,
        nativePointerAddress(value.address),
        nativePointerAddress(value.address) + 16
    )
    val milliseconds = value.loadI64(0) * 1000 + value.loadI64(8) / 1000
    value.close()
    milliseconds
}

fun linuxSocketSetTimeout(descriptor: int, option: int, milliseconds: int): bool {
    val interval = nativeByteBuffer(16)
    interval.storeI64(0, milliseconds / 1000)
    interval.storeI64(8, (milliseconds % 1000) * 1000)
    val status = linuxSyscall5(
        54, descriptor, 1, option, nativePointerAddress(interval.address), 16
    )
    interval.close()
    status == 0
}

private fun linuxSocketTimeoutSet(descriptor: int, option: int): bool {
    val value = nativeByteBuffer(24)
    value.storeI64(0, 0)
    value.storeI64(8, 0)
    value.storeI64(16, 16)
    val found = linuxSyscall5(
        55, descriptor, 1, option,
        nativePointerAddress(value.address),
        nativePointerAddress(value.address) + 16
    )
    val set = found == 0 && (value.loadI64(0) != 0 || value.loadI64(8) != 0)
    value.close()
    set
}

// Whether either timeout has been set on this socket.
fun linuxSocketHasTimeouts(descriptor: int): bool =
    linuxSocketTimeoutSet(descriptor, 20) || linuxSocketTimeoutSet(descriptor, 21)

// A write to a socket the peer reset raises SIGPIPE, unless it passes
// MSG_NOSIGNAL, which OpenSSL's write(2) can't. Hold SIGPIPE around such a call
// so that it fails with EPIPE, then release it: the caller's mask and handler,
// which also decide what happens to its own writes to a closed pipe, stay as
// they were. The signal goes to the writing thread, and the mask is per thread.
// (Darwin sockets carry SO_NOSIGPIPE, so nothing is raised there.)
// The result is for linuxBrokenPipeRelease: whether it was blocked already.
fun linuxBrokenPipeHold(): bool {
    val signals = nativeByteBuffer(16)
    signals.storeI64(0, 4096)
    signals.storeI64(8, 0)
    linuxSyscall4(
        14, 0,
        nativePointerAddress(signals.address),
        nativePointerAddress(signals.address) + 8,
        8
    )
    val blocked = signals.loadI64(8) / 4096 % 2 != 0
    signals.close()
    blocked
}

fun linuxBrokenPipeRelease(blockedBefore: bool): void {
    if (!blockedBefore) {
        val signals = nativeByteBuffer(24)
        signals.storeI64(0, 4096)
        signals.storeI64(8, 0)
        signals.storeI64(16, 0)
        // rt_sigtimedwait with a zero timeout takes a signal the call raised.
        linuxSyscall4(
            128,
            nativePointerAddress(signals.address),
            0,
            nativePointerAddress(signals.address) + 8,
            8
        )
        linuxSyscall4(14, 1, nativePointerAddress(signals.address), 0, 8)
        signals.close()
    }
    return
}

fun TcpListener.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)

// Bounds each blocking read and write; see linuxSocketSetTimeouts.
fun TcpConnection.setTimeouts(
    readMilliseconds: int,
    writeMilliseconds: int
): bool = this.descriptor >= 0 && linuxSocketSetTimeouts(
    this.descriptor, readMilliseconds, writeMilliseconds
)

fun TcpConnection.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)

fun UdpSocket.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)

fun TcpListener.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = linuxTcpCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun TcpConnection.readResult(maximum: int = 65536): SocketReadResult {
    var result = SocketReadResult("", "error", 22)
    if (this.descriptor < 0) {
        result = SocketReadResult(
            "", "error", if (this.descriptor < -1) -this.descriptor else 9
        )
    } else if (maximum > 0 && maximum <= 1048576) {
        val buffer = nativeByteBuffer(maximum + 1)
        var measured = linuxSyscall3(
            0,
            this.descriptor,
            nativePointerAddress(buffer.address),
            maximum
        )
        while (measured == -4) {
            measured = linuxSyscall3(
                0,
                this.descriptor,
                nativePointerAddress(buffer.address),
                maximum
            )
        }
        if (measured > 0) {
            result = SocketReadResult(
                buffer.adoptString(measured), "data", 0
            )
        } else {
            buffer.close()
            if (measured == 0) result = SocketReadResult("", "eof", 0)
            else result = SocketReadResult("", "error", -measured)
        }
    }
    result
}

fun ablaLinuxTcpReadCompact(
    descriptor: int,
    maximum: int
): string {
    val buffer = nativeByteBuffer(maximum + 1)
    var measured = linuxSyscall3(
        0, descriptor, nativePointerAddress(buffer.address), maximum
    )
    while (measured == -4) measured = linuxSyscall3(
        0, descriptor, nativePointerAddress(buffer.address), maximum
    )
    var result = ""
    if (measured > 0) result = buffer.adoptString(measured)
    else buffer.close()
    result
}

fun ablaLinuxTcpWriteCompact(
    descriptor: int,
    contents: string,
    offset: int
): int {
    var written = 0
    if (offset < contents.size) {
        // One region-local workspace holds 64 iovecs, 64 pending rope
        // segments, and the 56-byte Linux msghdr. Keeping these together
        // removes two managed resource objects and allocator operations from
        // every large response.
        val workspace = nativeByteBuffer(2104)
        val workspaceAddress = nativePointerAddress(workspace.address)
        val pendingAddress = workspaceAddress + 1024
        val messageAddress = workspaceAddress + 2048
        val count = __ablaRuntimeStringWriteVectors(
            contents,
            workspaceAddress,
            pendingAddress,
            64,
            offset
        )
        if (count > 0) {
            workspace.storeI64(2048, 0)
            workspace.storeI64(2056, 0)
            workspace.storeI64(2064, workspaceAddress)
            workspace.storeI64(2072, count)
            workspace.storeI64(2080, 0)
            workspace.storeI64(2088, 0)
            workspace.storeI64(2096, 0)
            written = linuxSyscall3(
                46,
                descriptor,
                messageAddress,
                16384
            )
            while (written == -4) written = linuxSyscall3(
                46,
                descriptor,
                messageAddress,
                16384
            )
        } else written = count
        workspace.close()
    }
    written
}

// Optimized readiness-loop read with bounded native storage. The buffer is
// allocated dynamically, so it shares the ordinary reader's 1 MiB limit.
// Empty output represents EOF or a nonblocking retry; event poll flags retain
// the detailed close/error state.
fun TcpConnection.readCompact(maximum: int = 4096): string {
    if (this.descriptor >= 0 && maximum > 0 && maximum <= 1048576) {
        ablaLinuxTcpReadCompact(this.descriptor, maximum)
    } else ""
}

fun TcpConnection.writeCompact(
    contents: string,
    offset: int = 0
): SocketWriteResult {
    val amount = if (this.descriptor >= 0 && offset >= 0 &&
        offset <= contents.size) ablaLinuxTcpWriteCompact(
            this.descriptor, contents, offset
        ) else -22
    if (amount >= 0) SocketWriteResult(amount, "written", 0)
    else if (amount == -7) this.writeResult(
        contents.slice(offset, contents.size)
    )
    else SocketWriteResult(0, "error", -amount)
}

fun ablaLinuxPollWaitCompact(
    descriptor: int,
    maximumEvents: int,
    timeoutMilliseconds: int
): string {
    val buffer = nativeByteBuffer(maximumEvents * 12 + 1)
    var measured = linuxSyscall4(
        232,
        descriptor,
        nativePointerAddress(buffer.address),
        maximumEvents,
        timeoutMilliseconds
    )
    while (measured == -4) measured = linuxSyscall4(
        232,
        descriptor,
        nativePointerAddress(buffer.address),
        maximumEvents,
        timeoutMilliseconds
    )
    var result = ""
    if (measured > 0) result = buffer.adoptString(measured * 12)
    else buffer.close()
    result
}

// Packed 12-byte epoll-compatible records for allocation-sensitive event
// loops. The regular wait method remains the structured public interface.
fun SocketPoller.waitCompact(
    maximumEvents: int = 64,
    timeoutMilliseconds: int = 5000
): string {
    if (this.descriptor >= 0 && maximumEvents > 0 && maximumEvents <= 1024 &&
        timeoutMilliseconds >= 0 && timeoutMilliseconds <= 600000) {
        ablaLinuxPollWaitCompact(
            this.descriptor, maximumEvents, timeoutMilliseconds
        )
    } else ""
}

// Keep the compatibility fast path allocation-free. Besides being cheaper for
// HTTP, this lets syscall-only servers remain free of hosted capability
// symbols. Call readResult when EOF/error distinction is required.
fun TcpConnection.read(maximum: int = 65536): string {
    val buffer = nativeByteBuffer(maximum + 1)
    var measured = linuxSyscall3(
        0,
        this.descriptor,
        nativePointerAddress(buffer.address),
        maximum
    )
    while (measured == -4) {
        measured = linuxSyscall3(
            0,
            this.descriptor,
            nativePointerAddress(buffer.address),
            maximum
        )
    }
    var result = ""
    if (measured >= 0) result = buffer.adoptString(measured)
    if (measured < 0) buffer.close()
    result
}

fun TcpConnection.writeResult(contents: string): SocketWriteResult {
    val address = nativeStringDataAddress(contents)
    var written = 0
    var errorCode = if (this.descriptor >= 0) 0 else 9
    while (errorCode == 0 && written < contents.size) {
        val amount = linuxSyscall6(
            44,
            this.descriptor,
            address + written,
            contents.size - written,
            16384,
            0,
            0
        )
        if (amount > 0) written = written + amount
        if (amount == 0) errorCode = 5
        if (amount < 0 && amount != -4) errorCode = -amount
    }
    if (errorCode == 0) SocketWriteResult(written, "written", 0)
    else SocketWriteResult(written, "error", errorCode)
}

// One send that never blocks (MSG_NOSIGNAL | MSG_DONTWAIT), whatever the
// socket's own mode: a bounded write must not wait in the kernel past its
// deadline for a peer that stops reading.
// It sends from `offset` in place, without copying the unsent tail.
private fun TcpConnection.sendWithoutBlocking(contents: string, offset: int): SocketWriteResult {
    var errorCode = if (this.descriptor >= 0) 0 else 9
    var written = 0
    while (errorCode == 0 && written == 0) {
        val amount = linuxSyscall6(
            44, this.descriptor, nativeStringDataAddress(contents) + offset,
            contents.size - offset, 16448, 0, 0
        )
        if (amount > 0) written = amount
        else if (amount == 0) errorCode = 5
        else if (amount != -4) errorCode = -amount
    }
    if (errorCode == 0) SocketWriteResult(written, "written", 0)
    else SocketWriteResult(written, "error", errorCode)
}

fun TcpConnection.writeNetwork(
    contents: string,
    timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50
): NetworkWriteOutcome {
    val started = linuxMonotonicMilliseconds()
    var offset = 0
    var result = NetworkWriteOutcome(
        0, 3, networkError(110, "write")
    )
    var writing = this.descriptor >= 0 && timeoutMilliseconds > 0 &&
        cancellationPollMilliseconds > 0
    if (!writing && this.descriptor < 0) result = NetworkWriteOutcome(
        0, 6, networkError(9, "write")
    )
    while (writing && offset < contents.size &&
        linuxMonotonicMilliseconds() - started < timeoutMilliseconds) {
        if (cancellation.isRequested()) {
            result = NetworkWriteOutcome(
                offset, 4, networkError(125, "write")
            )
            writing = false
        } else {
            var duration = timeoutMilliseconds -
                (linuxMonotonicMilliseconds() - started)
            if (duration > cancellationPollMilliseconds) {
                duration = cancellationPollMilliseconds
            }
            val readiness = this.poll(duration, false, true)
            if (readiness.failed()) {
                result = NetworkWriteOutcome(
                    offset, 6, networkError(readiness.errorCode, "poll")
                )
                writing = false
            } else if (readiness.writable) {
                val attempt = this.sendWithoutBlocking(contents, offset)
                offset = offset + attempt.written
                if (attempt.failed() && attempt.errorCode != 11) {
                    result = NetworkWriteOutcome(
                        offset, 6, networkError(attempt.errorCode, "write")
                    )
                    writing = false
                } else if (offset >= contents.size) {
                    result = NetworkWriteOutcome(
                        offset, 1, networkNoError("write")
                    )
                    writing = false
                }
            }
        }
    }
    // A deadline that expires after a partial write keeps the bytes the
    // socket already accepted, so the caller can resume or report them.
    if (result.timedOut()) result = NetworkWriteOutcome(offset, 3, result.error)
    result
}

fun TcpConnection.write(contents: string): int {
    val address = nativeStringDataAddress(contents)
    var written = 0
    var failed = this.descriptor < 0
    while (!failed && written < contents.size) {
        val amount = linuxSyscall6(
            44,
            this.descriptor,
            address + written,
            contents.size - written,
            16384,
            0,
            0
        )
        if (amount > 0) written = written + amount
        if (amount == 0 || (amount < 0 && amount != -4)) failed = true
    }
    if (failed) -1 else written
}

fun TcpConnection.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = linuxTcpCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun udpBind(
    address: Ipv4SocketAddress,
    reuseAddress: bool = true
): UdpSocket {
    var descriptor = -22
    if (address.isValid()) descriptor = linuxSyscall3(41, 2, 524290, 0)
    // An ephemeral port is used by clients as an identity. Reusing it can
    // route a reply to a different socket, even when both requested port 0.
    if (descriptor >= 0 && reuseAddress && address.port != 0) {
        val enabled = nativeByteBuffer(8)
        linuxNetStoreU32(enabled, 0, 1)
        val configured = linuxSyscall5(
            54,
            descriptor,
            1,
            2,
            nativePointerAddress(enabled.address),
            4
        )
        enabled.close()
        if (configured < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = configured
        }
    }
    if (descriptor >= 0) {
        val socketAddress = nativeByteBuffer(16)
        val encoded = linuxNetWriteIpv4Address(socketAddress, address)
        var bound = -22
        if (encoded) bound = linuxSyscall3(
            49,
            descriptor,
            nativePointerAddress(socketAddress.address),
            16
        )
        socketAddress.close()
        if (bound < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = bound
        }
    }
    UdpSocket(descriptor)
}

fun udpBindPort(port: int): UdpSocket = udpBind(ipv4Any(port))

fun udpBindIpv6(
    address: Ipv6SocketAddress,
    reuseAddress: bool = true,
    dualStack: bool = true
): UdpSocket {
    var descriptor = -22
    if (address.isValid()) descriptor = linuxSyscall3(41, 10, 524290, 0)
    if (descriptor >= 0) {
        val option = nativeByteBuffer(8)
        if (reuseAddress && address.port != 0) {
            linuxNetStoreU32(option, 0, 1)
            linuxSyscall5(
                54, descriptor, 1, 2,
                nativePointerAddress(option.address), 4
            )
        }
        linuxNetStoreU32(option, 0, if (dualStack) 0 else 1)
        linuxSyscall5(
            54, descriptor, 41, 26,
            nativePointerAddress(option.address), 4
        )
        option.close()
        val socketAddress = nativeByteBuffer(28)
        linuxNetWriteIpv6Address(socketAddress, address)
        val bound = linuxSyscall3(
            49,
            descriptor,
            nativePointerAddress(socketAddress.address),
            28
        )
        socketAddress.close()
        if (bound < 0) {
            linuxTcpCloseDescriptor(descriptor)
            descriptor = bound
        }
    }
    UdpSocket(descriptor)
}

fun udpBindPortIpv6(port: int): UdpSocket = udpBindIpv6(ipv6Any(port))

fun UdpSocket.localAddress(): Ipv4SocketAddress {
    val address = nativeByteBuffer(16)
    val length = nativeByteBuffer(8)
    linuxNetStoreU32(length, 0, 16)
    val status = linuxSyscall3(
        51,
        this.descriptor,
        nativePointerAddress(address.address),
        nativePointerAddress(length.address)
    )
    var result = Ipv4SocketAddress("", -1)
    if (status == 0) result = linuxNetReadIpv4Address(address)
    address.close()
    length.close()
    result
}

fun UdpSocket.localPort(): int = this.localAddress().port

fun UdpSocket.localAddressIpv6(): Ipv6SocketAddress =
    linuxSocketAddressIpv6(this.descriptor, false)

fun UdpSocket.sendTo(
    contents: string,
    destination: Ipv4SocketAddress
): SocketWriteResult {
    var written = 0
    var errorCode = if (this.descriptor >= 0) 0 else 9
    val address = nativeByteBuffer(16)
    if (errorCode == 0 && !linuxNetWriteIpv4Address(address, destination)) {
        errorCode = 22
    }
    if (errorCode == 0) {
        val source = nativeStringDataAddress(contents)
        var measured = linuxSyscall6(
            44,
            this.descriptor,
            source,
            contents.size,
            16384,
            nativePointerAddress(address.address),
            16
        )
        while (measured == -4) {
            measured = linuxSyscall6(
                44,
                this.descriptor,
                source,
                contents.size,
                16384,
                nativePointerAddress(address.address),
                16
            )
        }
        if (measured >= 0) written = measured
        else errorCode = -measured
    }
    address.close()
    if (errorCode == 0) SocketWriteResult(written, "written", 0)
    else SocketWriteResult(written, "error", errorCode)
}

fun UdpSocket.sendToIpv6(
    contents: string,
    destination: Ipv6SocketAddress
): SocketWriteResult {
    var written = 0
    var errorCode = if (this.descriptor >= 0) 0 else 9
    val address = nativeByteBuffer(28)
    if (errorCode == 0 && !linuxNetWriteIpv6Address(address, destination)) {
        errorCode = 22
    }
    if (errorCode == 0) {
        var measured = linuxSyscall6(
            44,
            this.descriptor,
            nativeStringDataAddress(contents),
            contents.size,
            16384,
            nativePointerAddress(address.address),
            28
        )
        while (measured == -4) {
            measured = linuxSyscall6(
                44,
                this.descriptor,
                nativeStringDataAddress(contents),
                contents.size,
                16384,
                nativePointerAddress(address.address),
                28
            )
        }
        if (measured >= 0) written = measured
        else errorCode = -measured
    }
    address.close()
    if (errorCode == 0) SocketWriteResult(written, "written", 0)
    else SocketWriteResult(written, "error", errorCode)
}

fun UdpSocket.receiveFromIpv6(maximum: int = 65507): UdpDatagramIpv6 {
    var result = UdpDatagramIpv6(
        "", Ipv6SocketAddress("", -1, 0), false, false, false, 22
    )
    if (this.descriptor >= 0 && maximum > 0 && maximum <= 65507) {
        val buffer = nativeByteBuffer(maximum + 1)
        val source = nativeByteBuffer(28)
        val sourceLength = nativeByteBuffer(8)
        linuxNetStoreU32(sourceLength, 0, 28)
        var measured = linuxSyscall6(
            45,
            this.descriptor,
            nativePointerAddress(buffer.address),
            maximum,
            0,
            nativePointerAddress(source.address),
            nativePointerAddress(sourceLength.address)
        )
        while (measured == -4) {
            measured = linuxSyscall6(
                45,
                this.descriptor,
                nativePointerAddress(buffer.address),
                maximum,
                0,
                nativePointerAddress(source.address),
                nativePointerAddress(sourceLength.address)
            )
        }
        if (measured >= 0) {
            val ipv6 = linuxNetReadIpv6Address(source)
            result = UdpDatagramIpv6(
                buffer.adoptString(measured),
                ipv6,
                true, false, measured == maximum, 0
            )
        } else {
            buffer.close()
            result = UdpDatagramIpv6(
                "", Ipv6SocketAddress("", -1, 0), false, false, false,
                -measured
            )
        }
        source.close()
        sourceLength.close()
    }
    result
}

fun UdpSocket.receiveFrom(maximum: int = 65507): UdpDatagram {
    var result = UdpDatagram(
        "", Ipv4SocketAddress("", -1), false, false, false, 22
    )
    if (this.descriptor < 0) {
        result = UdpDatagram(
            "", Ipv4SocketAddress("", -1), false, false, false, 9
        )
    } else if (maximum > 0 && maximum <= 65535) {
        val buffer = nativeByteBuffer(maximum + 1)
        val source = nativeByteBuffer(16)
        val sourceLength = nativeByteBuffer(8)
        linuxNetStoreU32(sourceLength, 0, 16)
        var measured = linuxSyscall6(
            45,
            this.descriptor,
            nativePointerAddress(buffer.address),
            maximum,
            32,
            nativePointerAddress(source.address),
            nativePointerAddress(sourceLength.address)
        )
        while (measured == -4) {
            measured = linuxSyscall6(
                45,
                this.descriptor,
                nativePointerAddress(buffer.address),
                maximum,
                32,
                nativePointerAddress(source.address),
                nativePointerAddress(sourceLength.address)
            )
        }
        if (measured >= 0) {
            var body = ""
            var copied = measured
            if (copied > maximum) copied = maximum
            if (copied > 0) body = buffer.adoptString(copied)
            else buffer.close()
            result = UdpDatagram(
                body,
                linuxNetReadIpv4Address(source),
                true,
                false,
                measured > maximum,
                0
            )
        } else {
            buffer.close()
            result = UdpDatagram(
                "", Ipv4SocketAddress("", -1), false, false, false,
                -measured
            )
        }
        source.close()
        sourceLength.close()
    }
    result
}

fun UdpSocket.receiveFromWithTimeout(
    maximum: int = 65507,
    timeoutMilliseconds: int = 5000
): UdpDatagram {
    val readiness = this.poll(timeoutMilliseconds)
    var result = UdpDatagram(
        "", Ipv4SocketAddress("", -1), false, false, false,
        readiness.errorCode
    )
    if (readiness.timedOut) result = UdpDatagram(
        "", Ipv4SocketAddress("", -1), false, true, false, 0
    )
    else if (readiness.readable) result = this.receiveFrom(maximum)
    result
}

fun UdpSocket.receiveFromIpv6WithTimeout(
    maximum: int = 65507,
    timeoutMilliseconds: int = 5000
): UdpDatagramIpv6 {
    val readiness = this.poll(timeoutMilliseconds)
    var result = UdpDatagramIpv6(
        "", Ipv6SocketAddress("", -1, 0), false, false, false,
        readiness.errorCode
    )
    if (readiness.timedOut) result = UdpDatagramIpv6(
        "", Ipv6SocketAddress("", -1, 0), false, true, false, 0
    )
    else if (readiness.readable) result = this.receiveFromIpv6(maximum)
    result
}

fun UdpSocket.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = linuxTcpCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun tcpEnableGracefulShutdown(): bool {
    var success = linuxTcpShutdownDescriptor >= 0
    if (!success) {
        // Block SIGTERM (signal 15) and receive it synchronously through a
        // nonblocking close-on-exec signalfd. The kernel x86-64 sigset is 8 B.
        val signals = nativeByteBuffer(8)
        signals.storeI64(0, 16384)
        val blocked = linuxSyscall4(
            14,
            0,
            nativePointerAddress(signals.address),
            0,
            8
        )
        if (blocked == 0) {
            linuxTcpShutdownDescriptor = linuxSyscall4(
                289,
                -1,
                nativePointerAddress(signals.address),
                8,
                526336
            )
            if (linuxTcpShutdownDescriptor < 0) {
                // Do not leave SIGTERM blocked if signalfd creation failed.
                linuxSyscall4(
                    14,
                    1,
                    nativePointerAddress(signals.address),
                    0,
                    8
                )
            }
        }
        signals.close()
        success = linuxTcpShutdownDescriptor >= 0
    }
    success
}

// Wake a readiness loop on SIGTERM instead of waiting for its idle timeout.
// The loop still consumes the notification through tcpShutdownRequested().
fun SocketPoller.watchGracefulShutdown(): bool {
    if (!tcpEnableGracefulShutdown()) return false
    this.watchDescriptor(linuxTcpShutdownDescriptor) ||
        this.modifyDescriptor(linuxTcpShutdownDescriptor)
}

private fun linuxTcpDrainShutdown(): bool {
    if (!linuxTcpShutdownSeen && linuxTcpShutdownDescriptor >= 0) {
        val signal = nativeByteBuffer(128)
        val measured = linuxSyscall3(
            0,
            linuxTcpShutdownDescriptor,
            nativePointerAddress(signal.address),
            128
        )
        if (measured >= 128) linuxTcpShutdownSeen = true
        signal.close()
    }
    linuxTcpShutdownSeen
}

fun tcpShutdownRequested(): bool = linuxTcpDrainShutdown()

fun TcpListener.acceptUntilShutdown(): TcpConnection {
    var connection = TcpConnection(-1)
    var waiting = this.descriptor >= 0 && !linuxTcpShutdownSeen
    while (waiting) {
        val descriptors = nativeByteBuffer(16)
        linuxNetStoreU32(descriptors, 0, this.descriptor)
        linuxNetStoreU16(descriptors, 4, 1)
        linuxNetStoreU16(descriptors, 6, 0)
        linuxNetStoreU32(
            descriptors,
            8,
            linuxTcpShutdownDescriptor
        )
        linuxNetStoreU16(descriptors, 12, 1)
        linuxNetStoreU16(descriptors, 14, 0)
        var ready = linuxSyscall3(
            7,
            nativePointerAddress(descriptors.address),
            2,
            -1
        )
        while (ready == -4) {
            ready = linuxSyscall3(
                7,
                nativePointerAddress(descriptors.address),
                2,
                -1
            )
        }
        val listenerReady = descriptors.load(6) != 0 ||
            descriptors.load(7) != 0
        val signalReady = descriptors.load(14) != 0 ||
            descriptors.load(15) != 0
        descriptors.close()
        if (signalReady) {
            linuxTcpDrainShutdown()
            waiting = false
        }
        if (!signalReady && listenerReady) {
            connection = this.accept()
            waiting = false
        }
        if (ready < 0) waiting = false
    }
    connection
}

// AF_UNIX streams. Path names are bytes; abstract names are Linux-only and
// may contain zero bytes. Closing a listener never unlinks its pathname.
class UnixSocketAddress(val name: string, val abstract: bool) {
    fun isValid(): bool {
        if (this.name.size > 107 || (!this.abstract && this.name.size == 0)) return false
        if (!this.abstract) for (i in 0 until this.name.size) if (this.name[i] == 0) return false
        true
    }
}

fun unixSocketAddress(path: string): UnixSocketAddress = UnixSocketAddress(path, false)
fun unixAbstractAddress(name: string): UnixSocketAddress = UnixSocketAddress(name, true)

resource class UnixListener(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}
resource class UnixConnection(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) linuxSyscall1(3, this.descriptor)
        this.descriptor = -1
        return
    }
}

// The temporary view shares the descriptor only during a call; disarm its
// destructor before returning so the Unix resource keeps sole ownership.
fun UnixConnection.read(maximum: int = 65536): string {
    var view = TcpConnection(this.descriptor)
    val result = view.read(maximum)
    view.descriptor = -1
    result
}
fun UnixConnection.readResult(maximum: int = 65536): SocketReadResult {
    var view = TcpConnection(this.descriptor)
    val result = view.readResult(maximum)
    view.descriptor = -1
    result
}
fun UnixConnection.write(contents: string): int {
    var view = TcpConnection(this.descriptor)
    val result = view.write(contents)
    view.descriptor = -1
    result
}
fun UnixConnection.writeResult(contents: string): SocketWriteResult {
    var view = TcpConnection(this.descriptor)
    val result = view.writeResult(contents)
    view.descriptor = -1
    result
}
fun UnixConnection.readWithTimeout(maximum: int, timeoutMilliseconds: int): string {
    var view = TcpConnection(this.descriptor)
    val result = view.readWithTimeout(maximum, timeoutMilliseconds)
    view.descriptor = -1
    result
}
fun UnixConnection.readWithTimeoutResult(maximum: int, timeoutMilliseconds: int): SocketReadResult {
    var view = TcpConnection(this.descriptor)
    val result = view.readWithTimeoutResult(maximum, timeoutMilliseconds)
    view.descriptor = -1
    result
}
fun UnixConnection.readCompact(maximum: int = 4096): string {
    var view = TcpConnection(this.descriptor)
    val result = view.readCompact(maximum)
    view.descriptor = -1
    result
}
fun UnixConnection.writeCompact(contents: string, offset: int = 0): SocketWriteResult {
    var view = TcpConnection(this.descriptor)
    val result = view.writeCompact(contents, offset)
    view.descriptor = -1
    result
}
fun UnixConnection.readNetwork(maximum: int, timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50): NetworkReadOutcome {
    var view = TcpConnection(this.descriptor)
    val result = view.readNetwork(maximum, timeoutMilliseconds, cancellation,
        cancellationPollMilliseconds)
    view.descriptor = -1
    result
}
fun UnixConnection.writeNetwork(contents: string, timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50): NetworkWriteOutcome {
    var view = TcpConnection(this.descriptor)
    val result = view.writeNetwork(contents, timeoutMilliseconds, cancellation,
        cancellationPollMilliseconds)
    view.descriptor = -1
    result
}
fun UnixConnection.poll(timeoutMilliseconds: int, read: bool = true,
    write: bool = false): SocketPollResult =
    linuxPollSocket(this.descriptor, read, write, timeoutMilliseconds)
fun UnixConnection.setTimeouts(readMilliseconds: int, writeMilliseconds: int): bool =
    this.descriptor >= 0 && linuxSocketSetTimeouts(this.descriptor, readMilliseconds,
        writeMilliseconds)
fun UnixConnection.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)
fun UnixListener.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)
fun UnixConnection.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = linuxTcpCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}
fun UnixListener.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = linuxTcpCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}
fun UnixListener.accept(): UnixConnection =
    UnixConnection(linuxTcpAcceptDescriptor(this.descriptor))

// Linux sockaddr_un: 2-byte family, then pathname plus NUL, or leading NUL
// plus exactly the abstract name bytes. The Darwin shim translates this layout.
private fun unixEncode(address: UnixSocketAddress): NativeByteBuffer {
    val size = address.name.size + 3
    val bytes = nativeByteBuffer(size)
    linuxNetStoreU16(bytes, 0, 1)
    val begin = if (address.abstract) 3 else 2
    if (address.abstract) bytes.store(2, 0)
    for (i in 0 until address.name.size) bytes.store(begin + i, int(address.name[i]))
    if (!address.abstract) bytes.store(begin + address.name.size, 0)
    bytes
}

fun unixListen(address: UnixSocketAddress, backlog: int = 128): UnixListener {
    var descriptor = -22
    if (address.isValid() && backlog > 0 && backlog <= 4096)
        descriptor = linuxSyscall3(41, 1, 524289, 0)
    if (descriptor >= 0) {
        val bytes = unixEncode(address)
        val status = linuxSyscall3(49, descriptor, nativePointerAddress(bytes.address),
            address.name.size + 3)
        bytes.close()
        if (status < 0) { linuxTcpCloseDescriptor(descriptor); descriptor = status }
    }
    if (descriptor >= 0) {
        val status = linuxSyscall2(50, descriptor, backlog)
        if (status < 0) { linuxTcpCloseDescriptor(descriptor); descriptor = status }
    }
    UnixListener(descriptor)
}

fun unixConnect(address: UnixSocketAddress, timeoutMilliseconds: int = 5000): UnixConnection {
    var descriptor = -22
    if (address.isValid() && timeoutMilliseconds > 0 && timeoutMilliseconds <= 10000)
        descriptor = linuxSyscall3(41, 1, 526337, 0)
    if (descriptor >= 0) {
        val bytes = unixEncode(address)
        val status = linuxSyscall3(42, descriptor, nativePointerAddress(bytes.address),
            address.name.size + 3)
        bytes.close()
        var error = if (status < 0) -status else 0
        if (status == -115) {
            val ready = linuxPollSocket(descriptor, false, true, timeoutMilliseconds)
            error = if (ready.timedOut) 110 else if (ready.failed()) ready.errorCode else 0
            if (error == 0) {
                val out = nativeByteBuffer(8)
                val length = nativeByteBuffer(8)
                linuxNetStoreU32(length, 0, 4)
                val inspected = linuxSyscall5(55, descriptor, 1, 4,
                    nativePointerAddress(out.address), nativePointerAddress(length.address))
                error = if (inspected < 0) -inspected else linuxNetReadNativeU32(out, 0)
                if (error == 0 && !ready.writable) error = 111
                out.close()
                length.close()
            }
        }
        if (error == 0) {
            if (!linuxSocketSetNonblocking(descriptor, false)) error = 5
        }
        if (error != 0) { linuxTcpCloseDescriptor(descriptor); descriptor = -error }
    }
    UnixConnection(descriptor)
}
