// Linux process entry information without the project C host adapter.
// Process creation/control will grow on this same explicit raw profile.

import "abla/sys/linux"

noescape extern:"intrinsic" fun ablaLinuxArgumentCount(): int

noescape extern:"intrinsic" fun ablaLinuxArgument(index: int): string

noescape extern:"intrinsic" fun ablaLinuxEnvironmentPointer(): i64*

class LinuxEnvironmentValue(val value: string, val found: bool)

class LinuxProcessResult(val status: int, val output: string)

class LinuxCommand(val arguments: array<string>)

class LinuxChildProcess(val process: int)

fun linuxArgumentCount(): int = ablaLinuxArgumentCount()

fun linuxArgument(index: int): string = ablaLinuxArgument(index)

fun linuxEnvironmentPointer(): i64* = ablaLinuxEnvironmentPointer()

trusted fun linuxEnvironment(name: string): LinuxEnvironmentValue {
    var cursor = linuxEnvironmentPointer()
    var found = false
    var result = ""
    var current = nativeNullPointer()
    if (!pointerIsNull(cursor)) {
        current = NativePointerCell(cursor, false, false).load()
    }
    while (!pointerIsNull(current) && !found) {
        val entry = borrowNativeCString(current)
        if (entry.size > name.size && entry[name.size] == 61 &&
            entry.slice(0, name.size) == name) {
            result = entry.slice(name.size + 1, entry.size)
            found = true
        }
        cursor = ablaUnsafePointerOffset(cursor, 8)
        current = NativePointerCell(cursor, false, false).load()
    }
    LinuxEnvironmentValue(result, found)
}

fun linuxExecutablePath(executable: string): string {
    var hasSlash = false
    var index = 0
    while (index < executable.size) {
        if (executable[index] == 47) hasSlash = true
        index = index + 1
    }
    var result = executable
    if (!hasSlash) {
        val configured = linuxEnvironment("PATH")
        var search = "/usr/local/bin:/usr/bin:/bin"
        if (configured.found) search = configured.value
        var begin = 0
        var searching = true
        while (searching && begin <= search.size) {
            var end = begin
            while (end < search.size && search[end] != 58) end = end + 1
            val directory = search.slice(begin, end)
            var candidate = executable
            if (directory != "") candidate = "$directory/$executable"
            if (linuxSyscall2(
                21,
                nativeCStringAddress(candidate),
                1
            ) == 0) {
                result = candidate
                searching = false
            }
            if (end == search.size) searching = false
            begin = end + 1
        }
    }
    result
}

fun linuxArgumentVector(arguments: array<string>): NativeByteBuffer {
    val vector = nativeByteBuffer((arguments.size + 1) * 8)
    var index = 0
    while (index < arguments.size) {
        val address = nativePointerFromAddress(
            nativeCStringAddress(arguments[index])
        )
        vector.storePointer(index * 8, address)
        index = index + 1
    }
    vector.storePointer(arguments.size * 8, nativeNullPointer())
    vector
}

fun linuxDecodeWaitStatus(encoded: int): int {
    val signal = encoded - encoded / 128 * 128
    var result = 128 + signal
    if (signal == 0) result = encoded / 256 - encoded / 65536 * 256
    result
}

fun linuxWaitProcess(process: int, noHang: bool = false): LinuxProcessResult {
    val statusBuffer = nativeByteBuffer(8)
    statusBuffer.storeI64(0, 0)
    val options = if (noHang) 1 else 0
    val waited = linuxSyscall4(
        61,
        process,
        nativePointerAddress(statusBuffer.address),
        options,
        0
    )
    var status = -1
    if (waited == process) {
        status = linuxDecodeWaitStatus(statusBuffer.loadI64(0))
    }
    statusBuffer.close()
    var state = ""
    if (waited == 0) state = "pending"
    LinuxProcessResult(status, state)
}

fun linuxExecPrepared(
    executable: string,
    vector: NativeByteBuffer
): int {
    linuxSyscall3(
        59,
        nativeCStringAddress(executable),
        nativePointerAddress(vector.address),
        nativePointerAddress(linuxEnvironmentPointer())
    )
    linuxSyscall1(60, 127)
}

fun linuxCommand(executable: string): LinuxCommand =
    LinuxCommand([executable])

fun LinuxCommand.argument(value: string): LinuxCommand {
    this.arguments.append(value)
    this
}

fun LinuxCommand.run(): int {
    var result = 127
    if (this.arguments.size > 0) {
        val executable = linuxExecutablePath(this.arguments[0])
        val vector = linuxArgumentVector(this.arguments)
        val process = linuxSyscall0(57)
        if (process == 0) result = linuxExecPrepared(executable, vector)
        if (process > 0) result = linuxWaitProcess(process).status
        vector.close()
    }
    result
}

fun LinuxCommand.capture(): LinuxProcessResult {
    var result = LinuxProcessResult(127, "")
    if (this.arguments.size > 0) {
        val executable = linuxExecutablePath(this.arguments[0])
        val vector = linuxArgumentVector(this.arguments)
        val descriptors = nativeByteBuffer(8)
        descriptors.storeI64(0, 0)
        val pipeStatus = linuxSyscall2(
            293,
            nativePointerAddress(descriptors.address),
            524288
        )
        if (pipeStatus == 0) {
            val readDescriptor = descriptors.load(0) +
                descriptors.load(1) * 256 +
                descriptors.load(2) * 65536 +
                descriptors.load(3) * 16777216
            val writeDescriptor = descriptors.load(4) +
                descriptors.load(5) * 256 +
                descriptors.load(6) * 65536 +
                descriptors.load(7) * 16777216
            val process = linuxSyscall0(57)
            if (process == 0) {
                linuxSyscall1(3, readDescriptor)
                linuxSyscall2(33, writeDescriptor, 1)
                linuxSyscall1(3, writeDescriptor)
                linuxExecPrepared(executable, vector)
            }
            if (process > 0) {
                linuxSyscall1(3, writeDescriptor)
                var output = ""
                var reading = true
                while (reading) {
                    val chunk = LinuxFileDescriptor(readDescriptor).read(65536)
                    if (chunk.size > 0) output = "$output$chunk"
                    if (chunk.size == 0) reading = false
                }
                linuxSyscall1(3, readDescriptor)
                result = LinuxProcessResult(
                    linuxWaitProcess(process).status,
                    output
                )
            }
        }
        descriptors.close()
        vector.close()
    }
    result
}

fun LinuxCommand.captureText(): string = this.capture().output

fun LinuxCommand.start(): LinuxChildProcess {
    var process = -1
    if (this.arguments.size > 0) {
        val executable = linuxExecutablePath(this.arguments[0])
        val vector = linuxArgumentVector(this.arguments)
        process = linuxSyscall0(57)
        if (process == 0) linuxExecPrepared(executable, vector)
        vector.close()
    }
    LinuxChildProcess(process)
}

// Starts a process in its own process group. Environment entries override the
// inherited environment through the system `env` utility, while directory and
// descriptor setup happen directly in the forked child. Keeping this in Abla
// makes hosted build tools independent of a project-specific C launcher.
fun linuxStartConfiguredProcess(
    directory: string,
    arguments: array<string>,
    environmentNames: array<string> = [],
    environmentValues: array<string> = [],
    outputPath: string = ""
): LinuxChildProcess {
    var process = -1
    if (arguments.size > 0 &&
        environmentNames.size == environmentValues.size) {
        val launched: array<string> = []
        var executable = arguments[0]
        if (environmentNames.size > 0) {
            executable = linuxExecutablePath("env")
            launched.append(executable)
            var environmentIndex = 0
            while (environmentIndex < environmentNames.size) {
                launched.append(
                    "${environmentNames[environmentIndex]}=${environmentValues[environmentIndex]}"
                )
                environmentIndex = environmentIndex + 1
            }
        }
        var argumentIndex = 0
        while (argumentIndex < arguments.size) {
            launched.append(arguments[argumentIndex])
            argumentIndex = argumentIndex + 1
        }
        if (environmentNames.size == 0) {
            executable = linuxExecutablePath(arguments[0])
        }
        val vector = linuxArgumentVector(launched)
        process = linuxSyscall0(57)
        if (process == 0) {
            // setpgid(0, 0): the whole test process tree can be terminated on
            // timeout without affecting the parent test runner.
            linuxSyscall2(109, 0, 0)
            var ready = true
            if (directory != "") {
                ready = linuxSyscall1(
                    80,
                    nativeCStringAddress(directory)
                ) == 0
            }
            if (ready && outputPath != "") {
                val output = linuxOpen(outputPath, 577, 438).descriptor
                ready = output >= 0
                if (ready) {
                    ready = linuxSyscall2(33, output, 1) >= 0 &&
                        linuxSyscall2(33, output, 2) >= 0
                }
                if (output > 2) linuxSyscall1(3, output)
            }
            if (ready) linuxExecPrepared(executable, vector)
            linuxSyscall1(60, 127)
        }
        if (process > 0) linuxSyscall2(109, process, process)
        vector.close()
    }
    LinuxChildProcess(process)
}

fun LinuxChildProcess.poll(): int =
    linuxWaitProcess(this.process, true).status

fun LinuxChildProcess.stopTree(graceMilliseconds: int = 100): int {
    var result = -1
    if (this.process > 0) {
        linuxSyscall2(62, 0 - this.process, 15)
        var remaining = graceMilliseconds
        var waiting = true
        while (waiting && remaining > 0) {
            val observed = linuxWaitProcess(this.process, true)
            if (observed.output != "pending") {
                result = observed.status
                waiting = false
            }
            if (waiting) {
                var slice = 10
                if (remaining < slice) slice = remaining
                linuxSleepMillisecondsChecked(slice)
                remaining = remaining - slice
            }
        }
        if (waiting) {
            linuxSyscall2(62, 0 - this.process, 9)
            result = linuxWaitProcess(this.process).status
        }
    }
    result
}

fun LinuxChildProcess.stop(graceMilliseconds: int = 5000): int {
    var result = -1
    if (this.process > 0) {
        linuxSyscall2(62, this.process, 15)
        var remaining = graceMilliseconds
        var waiting = true
        while (waiting && remaining > 0) {
            val observed = linuxWaitProcess(this.process, true)
            if (observed.output != "pending") {
                result = observed.status
                waiting = false
            }
            if (waiting) {
                var slice = 10
                if (remaining < slice) slice = remaining
                linuxSleepMillisecondsChecked(slice)
                remaining = remaining - slice
            }
        }
        if (waiting) {
            linuxSyscall2(62, this.process, 9)
            result = linuxWaitProcess(this.process).status
        }
    }
    result
}

fun linuxSleepNanosecondsWithBuffers(
    nanoseconds: int,
    var requested: NativeByteBuffer,
    var remaining: NativeByteBuffer
): bool {
    var success = nanoseconds >= 0 && !requested.closed &&
        requested.capacity >= 16 && !remaining.closed &&
        remaining.capacity >= 16
    if (success) {
        requested.storeI64(0, nanoseconds / 1000000000)
        requested.storeI64(
            8,
            nanoseconds - nanoseconds / 1000000000 * 1000000000
        )
        var waiting = true
        while (waiting) {
            val status = linuxSyscall2(
                35,
                nativePointerAddress(requested.address),
                nativePointerAddress(remaining.address)
            )
            if (status == 0) waiting = false
            if (status == -4) {
                requested.storeI64(0, remaining.loadI64(0))
                requested.storeI64(8, remaining.loadI64(8))
            }
            if (status != 0 && status != -4) {
                success = false
                waiting = false
            }
        }
    }
    success
}

fun linuxSleepNanosecondsChecked(nanoseconds: int): bool {
    val requested = nativeByteBuffer(16)
    val remaining = nativeByteBuffer(16)
    val succeeded = linuxSleepNanosecondsWithBuffers(
        nanoseconds,
        requested,
        remaining
    )
    requested.close()
    remaining.close()
    succeeded
}

fun linuxSleepMillisecondsChecked(milliseconds: int): bool =
    milliseconds >= 0 && milliseconds <= 9223372036854 &&
    linuxSleepNanosecondsChecked(milliseconds * 1000000)

fun linuxProcessUnit(): void {}

fun linuxSleep(milliseconds: int): void {
    linuxSleepMillisecondsChecked(milliseconds)
    linuxProcessUnit()
}

fun linuxSleepNanoseconds(nanoseconds: int): bool {
    val succeeded = linuxSleepNanosecondsChecked(nanoseconds)
    linuxProcessUnit()
    succeeded
}

fun linuxMonotonicNanosecondsWithBuffer(
    var timestamp: NativeByteBuffer
): int {
    var result = 0
    if (timestamp.closed || timestamp.capacity < 16) return result
    timestamp.storeI64(0, 0)
    timestamp.storeI64(8, 0)
    val status = linuxSyscall2(
        228,
        1,
        nativePointerAddress(timestamp.address)
    )
    if (status == 0) {
        val seconds = timestamp.loadI64(0)
        val nanoseconds = timestamp.loadI64(8)
        if (seconds >= 0 && seconds <= 9223372035 &&
            nanoseconds >= 0 && nanoseconds < 1000000000 &&
            seconds <= (9223372036854775807 - nanoseconds) / 1000000000) {
            result = seconds * 1000000000 + nanoseconds
        }
    }
    result
}

resource class LinuxMonotonicClock(
    var timestamp: NativeByteBuffer,
    var requested: NativeByteBuffer,
    var remaining: NativeByteBuffer
) {
    fun valid(): bool = !this.timestamp.closed &&
        this.timestamp.capacity >= 16 && !this.requested.closed &&
        this.requested.capacity >= 16 && !this.remaining.closed &&
        this.remaining.capacity >= 16

    fun nanoseconds(): int =
        linuxMonotonicNanosecondsWithBuffer(this.timestamp)

    fun sleepNanoseconds(nanoseconds: int): bool =
        linuxSleepNanosecondsWithBuffers(
            nanoseconds,
            this.requested,
            this.remaining
        )

    fun drop(): void {
        this.timestamp.close()
        this.requested.close()
        this.remaining.close()
        return
    }
}

fun linuxMonotonicClock(): LinuxMonotonicClock = LinuxMonotonicClock(
    nativeByteBuffer(16),
    nativeByteBuffer(16),
    nativeByteBuffer(16)
)

// Ambient providers used by the compiler stay on the same libc-free syscall
// layer as ordinary Abla programs. These helpers expose values, while compile
// capability policy remains the compiler evaluator's responsibility.
fun linuxMonotonicNanoseconds(): int {
    val timestamp = nativeByteBuffer(16)
    val result = linuxMonotonicNanosecondsWithBuffer(timestamp)
    timestamp.close()
    result
}

fun linuxMonotonicMilliseconds(): int =
    linuxMonotonicNanoseconds() / 1000000

fun linuxRandomInteger(maxExclusive: int): int {
    var result = 0
    if (maxExclusive > 0) {
        val bytes = nativeByteBuffer(8)
        val status = linuxSyscall3(
            318,
            nativePointerAddress(bytes.address),
            8,
            0
        )
        if (status == 8) {
            // Seven bytes keep the accumulator positive on a signed i64.
            var index = 0
            while (index < 7) {
                result = result * 256 + bytes.load(index)
                index = index + 1
            }
            result = result - result / maxExclusive * maxExclusive
        }
        bytes.close()
    }
    result
}
