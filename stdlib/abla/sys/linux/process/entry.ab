// Linux process entry information without the project C host adapter.
// On x86-64 Linux a child is made with the fork system call and no libc, so a child
// allocates nothing before exec or _exit: a thread that held the heap lock at the fork
// would leave it held in the child. Everything a child needs is prepared before the
// fork. Other targets keep libc fork (which repairs those locks).

import "abla/sys/linux"
import "abla/bytes"
import "abla/unsafe/memory/raw"
import "abla/unsafe/memory"

private noescape extern:"c" fun fork(): i32
private noescape extern:"c" fun signal(number: int, handler: i64*): i64*
private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool
private noescape extern:"intrinsic" fun ablaHostIsIOS(): bool
private noescape extern:"intrinsic" fun ablaHostOwnsRuntime(): bool
private noescape extern:"intrinsic" fun ablaSimdTargetArch(): int

noescape extern:"intrinsic" fun ablaLinuxArgumentCount(): int

noescape extern:"intrinsic" fun ablaLinuxArgument(index: int): string

noescape extern:"intrinsic" fun ablaLinuxEnvironmentPointer(): i64*

class LinuxEnvironmentValue(val value: string, val found: bool)

class LinuxProcessResult(val status: int, val output: string)

class LinuxCommand(
    val arguments: array<string>,
    val overrides: array<string> = [],
    var workingDirectory: string = "",
    var inputPath: string = "",
    var outputPath: string = "",
    var errorPath: string = "",
    val removed: array<string> = []
)

class LinuxChildProcess(val process: int)

fun linuxArgumentCount(): int = ablaLinuxArgumentCount()

// Argument `index` (0 the first after the program, -1 the program itself), or
// "" past the end: reading past argv used to fault.
fun linuxArgument(index: int): string =
    if (index < -1 || index >= linuxArgumentCount()) "" else ablaLinuxArgument(index)

fun linuxEnvironmentPointer(): i64* = ablaLinuxEnvironmentPointer()

trusted fun linuxEnvironment(name: string): LinuxEnvironmentValue {
    var cursor = linuxEnvironmentPointer()
    var found = false
    var result = ""
    var current = nativeNullPointer()
    if (!pointerIsNull(cursor)) {
        current = NativePointerCell(cursor, false, false).load()
    }
    while (!pointerIsNull(current) && !found) {
        // Read in place: the environment lives as long as the process.
        val entry = borrowNativeCString(current)
        if (entry.size > name.size && entry[name.size] == 61 &&
            entry.slice(0, name.size) == name) {
            result = entry.slice(name.size + 1, entry.size)
            found = true
        }
        cursor = ablaUnsafePointerOffset(cursor, 8)
        current = NativePointerCell(cursor, false, false).load()
    }
    LinuxEnvironmentValue(result, found)
}

fun linuxExecutablePath(executable: string): string {
    var hasSlash = false
    var index = 0
    while (index < executable.size) {
        if (executable[index] == 47) hasSlash = true
        index = index + 1
    }
    var result = executable
    if (!hasSlash) {
        val configured = linuxEnvironment("PATH")
        var search = "/usr/local/bin:/usr/bin:/bin"
        if (configured.found) search = configured.value
        var begin = 0
        var searching = true
        while (searching && begin <= search.size) {
            var end = begin
            while (end < search.size && search[end] != 58) end = end + 1
            val directory = search.slice(begin, end)
            var candidate = executable
            if (directory != "") candidate = "$directory/$executable"
            if (linuxSyscall2(
                21,
                nativeCStringAddress(candidate),
                1
            ) == 0) {
                result = candidate
                searching = false
            }
            if (end == search.size) searching = false
            begin = end + 1
        }
    }
    result
}

// argv for an exec: the pointer table, then each argument's bytes and a NUL, in
// the vector's one native allocation, so the strings live exactly as long as it.
// (Pointers to C-string copies of the arguments were collectible: a collection
// between building the vector and the exec handed the child freed memory.)
private fun linuxArgumentVector(arguments: array<string>): NativeByteBuffer {
    val table = (arguments.size + 1) * 8
    var bytes = 0
    for (argument in arguments) bytes = bytes + argument.size + 1
    val vector = nativeByteBuffer(table + bytes)
    var offset = table
    var index = 0
    while (index < arguments.size) {
        val argument = arguments[index]
        vector.storePointer(index * 8, vector.pointerAt(offset))
        var byte = 0
        while (byte < argument.size) {
            vector.store(offset + byte, argument[byte])
            byte = byte + 1
        }
        vector.store(offset + argument.size, 0)
        offset = offset + argument.size + 1
        index = index + 1
    }
    vector.storePointer(arguments.size * 8, nativeNullPointer())
    vector
}

private fun linuxDecodeWaitStatus(encoded: int): int {
    val signal = encoded - encoded / 128 * 128
    var result = 128 + signal
    if (signal == 0) result = encoded / 256 - encoded / 65536 * 256
    result
}

fun linuxWaitProcess(process: int, noHang: bool = false): LinuxProcessResult {
    val statusBuffer = nativeByteBuffer(8)
    statusBuffer.storeI64(0, 0)
    val options = if (noHang) 1 else 0
    val waited = linuxSyscall4(
        61,
        process,
        nativePointerAddress(statusBuffer.address),
        options,
        0
    )
    var status = -1
    if (waited == process) {
        status = linuxDecodeWaitStatus(statusBuffer.loadI64(0))
    }
    statusBuffer.close()
    var state = ""
    if (waited == 0) state = "pending"
    LinuxProcessResult(status, state)
}

private fun linuxExecPrepared(
    executable: int,
    vector: NativeByteBuffer
): int {
    linuxSyscall3(
        59,
        executable,
        nativePointerAddress(vector.address),
        nativePointerAddress(linuxEnvironmentPointer())
    )
    linuxSyscall1(60, 127)
}

// The stack limits (RLIMIT_STACK) in bytes: [soft, hard], -1 for unlimited,
// or [] when they cannot be read.
fun linuxStackLimits(): array<int> {
    val limits = nativeByteBuffer(16)
    limits.storeI64(0, 0)
    limits.storeI64(8, 0)
    val status = linuxSyscall2(97, 3, nativePointerAddress(limits.address))
    val result: array<int> = []
    if (status == 0) {
        result.append(limits.loadI64(0))
        result.append(limits.loadI64(8))
    }
    limits.close()
    result
}

fun linuxSetStackLimits(soft: int, hard: int): bool {
    val limits = nativeByteBuffer(16)
    limits.storeI64(0, soft)
    limits.storeI64(8, hard)
    val status = linuxSyscall2(160, 3, nativePointerAddress(limits.address))
    limits.close()
    status == 0
}

// Replaces this process with a fresh run of its own executable and the same
// arguments (only returns when that fails).
fun linuxReexecute(): void {
    val arguments: array<string> = []
    var index = -1
    while (index < linuxArgumentCount()) {
        arguments.append(linuxArgument(index))
        index = index + 1
    }
    val vector = linuxArgumentVector(arguments)
    linuxSyscall3(
        59,
        nativeCStringAddress("/proc/self/exe"),
        nativePointerAddress(vector.address),
        nativePointerAddress(linuxEnvironmentPointer())
    )
    vector.close()
    return
}

// Replaces this process with `executable`, given `arguments` as its argv (the
// first is its argv[0]). The standard streams, the working directory and the
// environment carry over. Only returns, with 127, when the exec fails.
fun linuxExecute(executable: string, arguments: array<string>): int {
    val vector = linuxArgumentVector(arguments)
    linuxSyscall3(
        59,
        nativeCStringAddress(executable),
        nativePointerAddress(vector.address),
        nativePointerAddress(linuxEnvironmentPointer())
    )
    vector.close()
    127
}

fun linuxCommand(executable: string): LinuxCommand =
    LinuxCommand([executable])

fun LinuxCommand.argument(value: string): LinuxCommand {
    this.arguments.append(value)
    this
}

// `name` set to `value` for what this command starts, replacing what an
// earlier call set it to; the rest of the environment carries over.
fun LinuxCommand.environment(name: string, value: string): LinuxCommand {
    val entry = "$name=$value"
    var replaced = false
    var index = 0
    while (index < this.overrides.size) {
        val existing = this.overrides[index]
        if (existing.size > name.size && existing[name.size] == 61 &&
            existing.slice(0, name.size) == name) {
            this.overrides[index] = entry
            replaced = true
        }
        index = index + 1
    }
    if (!replaced) this.overrides.append(entry)
    this
}

// `name` taken out of what the command inherits. A later `environment` of that name still sets it.
fun LinuxCommand.removeEnvironment(name: string): LinuxCommand {
    this.removed.append(name)
    this
}

// Where the command runs, instead of this process's working directory.
fun LinuxCommand.directory(path: string): LinuxCommand {
    this.workingDirectory = path
    this
}

// Standard input read from this file.
fun LinuxCommand.input(path: string): LinuxCommand {
    this.inputPath = path
    this
}

// Standard output written to this file, created if missing (with the mode a
// file already there has) and emptied. "/dev/null" discards it.
fun LinuxCommand.output(path: string): LinuxCommand {
    this.outputPath = path
    this
}

// Standard error written to this file, as with `output`.
fun LinuxCommand.errors(path: string): LinuxCommand {
    this.errorPath = path
    this
}

// The inherited environment with this command's overrides on top, as an envp.
private trusted fun LinuxCommand.environmentVector(): NativeByteBuffer {
    val entries: array<string> = []
    var cursor = linuxEnvironmentPointer()
    var current = nativeNullPointer()
    if (!pointerIsNull(cursor)) {
        current = NativePointerCell(cursor, false, false).load()
    }
    while (!pointerIsNull(current)) {
        val entry = borrowNativeCString(current)
        var replaced = false
        for (override in this.overrides) {
            val name = override.slice(0, linuxNameSize(override) + 1)
            if (entry.size >= name.size && entry.slice(0, name.size) == name) {
                replaced = true
            }
        }
        for (name in this.removed) {
            if (entry.size > name.size && entry[name.size] == 61 && entry.slice(0,
                name.size) == name) {
                replaced = true
            }
        }
        if (!replaced) entries.append(entry)
        cursor = ablaUnsafePointerOffset(cursor, 8)
        current = NativePointerCell(cursor, false, false).load()
    }
    for (override in this.overrides) entries.append(override)
    linuxArgumentVector(entries)
}

// This process's environment, as `NAME=value` entries in their order.
trusted fun linuxEnvironmentEntries(): array<string> {
    val entries: array<string> = []
    var cursor = linuxEnvironmentPointer()
    var current = nativeNullPointer()
    if (!pointerIsNull(cursor)) {
        current = NativePointerCell(cursor, false, false).load()
    }
    while (!pointerIsNull(current)) {
        entries.append(borrowNativeCString(current))
        cursor = ablaUnsafePointerOffset(cursor, 8)
        current = NativePointerCell(cursor, false, false).load()
    }
    entries
}

private fun linuxNameSize(entry: string): int {
    var index = 0
    while (index < entry.size && entry[index] != 61) index = index + 1
    index
}

// Per-thread watched mask, original mask bits, then 64 reference counts.
// fork copies the calling thread's state for the child, so it can unblock only
// that thread's watched signals before exec.
trusted fun linuxSignalWatchState(): int =
    nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

trusted fun linuxSignalWatchGet(offset: int): int =
    ablaUnsafeLoadI64(nativePointerFromAddress(linuxSignalWatchState() + offset))

trusted fun linuxSignalWatchSet(offset: int, value: int): void {
    ablaUnsafeStoreI64(nativePointerFromAddress(linuxSignalWatchState() + offset), value)
    return
}

// A child unblocks signals through the thread-local watch state: create it before the
// fork, so the child does not allocate it.
// A test seam (the process-pipeline test cannot interpose libc fork any more): the nth
// fork after linuxFailForkNumber(n) fails as if the process limit were reached.
var linuxForkFailureAt: int = 0
var linuxForkCount: int = 0

fun linuxFailForkNumber(number: int): void {
    linuxForkCount = 0
    linuxForkFailureAt = number
    return
}

private fun linuxFork(): int {
    linuxSignalWatchState()
    if (linuxForkFailureAt > 0) {
        linuxForkCount = linuxForkCount + 1
        if (linuxForkCount == linuxForkFailureAt) return -11
    }
    // The condition is written out here, not behind a helper: --fast does not inline, so a
    // helper would leave the libc fork reachable (and imported) in every --fast program.
    if (ablaHostOwnsRuntime()) return linuxSyscall0(57)
    int(fork())
}

private fun linuxExecUnblockSignals(): void {
    val state = linuxSignalWatchState()
    if (linuxSignalWatchGet(0) != 0) linuxSyscall4(14, 1, state, 0, 8)
    return
}

// C-string addresses of what a child needs. nativeCStringAddress may copy a string that has no
// NUL after it, which allocates: so they are all made before the fork, and a child only uses
// these numbers (0 = none).
class LinuxExecAddresses(
    val executable: int,
    val directory: int,
    val input: int,
    val output: int,
    val error: int
)

private fun LinuxCommand.execAddresses(executable: string): LinuxExecAddresses = LinuxExecAddresses(
    nativeCStringAddress(executable),
    if (this.workingDirectory != "") nativeCStringAddress(this.workingDirectory) else 0,
    if (this.inputPath != "") nativeCStringAddress(this.inputPath) else 0,
    if (this.outputPath != "") nativeCStringAddress(this.outputPath) else 0,
    if (this.errorPath != "") nativeCStringAddress(this.errorPath) else 0
)

private fun linuxRedirect(path: int, flags: int, target: int): bool {
    // openat by system call: the child must not allocate the descriptor object.
    val opened = linuxSyscall4(257, -100, path, flags, 0o666)
    var ready = opened >= 0
    if (ready) ready = linuxSyscall2(33, opened, target) >= 0
    if (opened > 2) linuxSyscall1(3, opened)
    ready
}

// The working directory and redirects, then the exec. Only returns, with 127,
// when one of them fails.
private fun LinuxCommand.execPrepared(
    addresses: LinuxExecAddresses,
    vector: NativeByteBuffer,
    environment: NativeByteBuffer
): int {
    var ready = true
    linuxExecUnblockSignals()
    if (addresses.directory != 0) {
        ready = linuxSyscall1(80, addresses.directory) == 0
    }
    if (ready && addresses.input != 0) {
        ready = linuxRedirect(addresses.input, 0, 0)
    }
    // O_WRONLY | O_CREAT | O_TRUNC.
    if (ready && addresses.output != 0) {
        ready = linuxRedirect(addresses.output, 577, 1)
    }
    if (ready && addresses.error != 0) {
        ready = linuxRedirect(addresses.error, 577, 2)
    }
    if (ready) {
        linuxSyscall3(
            59,
            addresses.executable,
            nativePointerAddress(vector.address),
            nativePointerAddress(environment.address)
        )
    }
    127
}

fun LinuxCommand.run(): int {
    var result = 127
    if (this.arguments.size > 0) {
        val executable = linuxExecutablePath(this.arguments[0])
        val addresses = this.execAddresses(executable)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        val process = linuxFork()
        if (process == 0) {
            this.execPrepared(addresses, vector, environment)
            linuxSyscall1(60, 127)
        }
        if (process > 0) result = linuxWaitProcess(process).status
        environment.close()
        vector.close()
    }
    result
}

// Replaces this process with the command: nothing after it runs, unless it
// fails, when it returns 127.
fun LinuxCommand.execute(): int {
    var result = 127
    if (this.arguments.size > 0) {
        val executable = linuxExecutablePath(this.arguments[0])
        val addresses = this.execAddresses(executable)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        result = this.execPrepared(addresses, vector, environment)
        environment.close()
        vector.close()
    }
    result
}

fun LinuxCommand.capture(): LinuxProcessResult {
    var result = LinuxProcessResult(127, "")
    if (this.arguments.size > 0) {
        val executable = linuxExecutablePath(this.arguments[0])
        val addresses = this.execAddresses(executable)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        val descriptors = nativeByteBuffer(8)
        descriptors.storeI64(0, 0)
        val pipeStatus = linuxSyscall2(
            293,
            nativePointerAddress(descriptors.address),
            524288
        )
        if (pipeStatus == 0) {
            val readDescriptor = descriptors.load(0) +
                descriptors.load(1) * 256 +
                descriptors.load(2) * 65536 +
                descriptors.load(3) * 16777216
            val writeDescriptor = descriptors.load(4) +
                descriptors.load(5) * 256 +
                descriptors.load(6) * 65536 +
                descriptors.load(7) * 16777216
            val process = linuxFork()
            if (process == 0) {
                linuxSyscall1(3, readDescriptor)
                linuxSyscall2(33, writeDescriptor, 1)
                linuxSyscall1(3, writeDescriptor)
                this.execPrepared(addresses, vector, environment)
                linuxSyscall1(60, 127)
            }
            if (process > 0) {
                linuxSyscall1(3, writeDescriptor)
                var output = ""
                var reading = true
                while (reading) {
                    val chunk = LinuxFileDescriptor(readDescriptor).read(65536)
                    if (chunk.size > 0) output = "$output$chunk"
                    if (chunk.size == 0) reading = false
                }
                linuxSyscall1(3, readDescriptor)
                result = LinuxProcessResult(
                    linuxWaitProcess(process).status,
                    output
                )
            }
        }
        descriptors.close()
        environment.close()
        vector.close()
    }
    result
}

fun LinuxCommand.captureText(): string = this.capture().output

fun LinuxCommand.start(): LinuxChildProcess {
    var process = -1
    if (this.arguments.size > 0) {
        val executable = linuxExecutablePath(this.arguments[0])
        val addresses = this.execAddresses(executable)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        process = linuxFork()
        if (process == 0) {
            this.execPrepared(addresses, vector, environment)
            linuxSyscall1(60, 127)
        }
        environment.close()
        vector.close()
    }
    LinuxChildProcess(process)
}

// Starts a process in its own process group. Environment entries override the
// inherited environment through the system `env` utility, while directory and
// descriptor setup happen directly in the forked child. Keeping this in Abla
// makes hosted build tools independent of a project-specific C launcher.
fun linuxStartConfiguredProcess(
    directory: string,
    arguments: array<string>,
    environmentNames: array<string> = [],
    environmentValues: array<string> = [],
    outputPath: string = ""
): LinuxChildProcess {
    var process = -1
    if (arguments.size > 0 &&
        environmentNames.size == environmentValues.size) {
        val launched: array<string> = []
        var executable = arguments[0]
        if (environmentNames.size > 0) {
            executable = linuxExecutablePath("env")
            launched.append(executable)
            var environmentIndex = 0
            while (environmentIndex < environmentNames.size) {
                launched.append(
                    "${environmentNames[environmentIndex]}=${environmentValues[environmentIndex]}"
                )
                environmentIndex = environmentIndex + 1
            }
        }
        var argumentIndex = 0
        while (argumentIndex < arguments.size) {
            launched.append(arguments[argumentIndex])
            argumentIndex = argumentIndex + 1
        }
        if (environmentNames.size == 0) {
            executable = linuxExecutablePath(arguments[0])
        }
        val vector = linuxArgumentVector(launched)
        val executableAddress = nativeCStringAddress(executable)
        val directoryAddress = if (directory != "") nativeCStringAddress(directory) else 0
        val outputAddress = if (outputPath != "") nativeCStringAddress(outputPath) else 0
        process = linuxFork()
        if (process == 0) {
            // setpgid(0, 0): the whole test process tree can be terminated on
            // timeout without affecting the parent test runner.
            linuxSyscall2(109, 0, 0)
            linuxExecUnblockSignals()
            var ready = true
            if (directoryAddress != 0) {
                ready = linuxSyscall1(80, directoryAddress) == 0
            }
            if (ready && outputAddress != 0) {
                val output = linuxSyscall4(257, -100, outputAddress, 577, 0o666)
                ready = output >= 0
                if (ready) {
                    ready = linuxSyscall2(33, output, 1) >= 0 &&
                        linuxSyscall2(33, output, 2) >= 0
                }
                if (output > 2) linuxSyscall1(3, output)
            }
            if (ready) linuxExecPrepared(executableAddress, vector)
            linuxSyscall1(60, 127)
        }
        if (process > 0) linuxSyscall2(109, process, process)
        vector.close()
    }
    LinuxChildProcess(process)
}

fun LinuxChildProcess.poll(): int =
    linuxWaitProcess(this.process, true).status

fun LinuxChildProcess.stopTree(graceMilliseconds: int = 100): int {
    var result = -1
    if (this.process > 0) {
        linuxSyscall2(62, 0 - this.process, 15)
        var remaining = graceMilliseconds
        var waiting = true
        while (waiting && remaining > 0) {
            val observed = linuxWaitProcess(this.process, true)
            if (observed.output != "pending") {
                result = observed.status
                waiting = false
            }
            if (waiting) {
                var slice = 10
                if (remaining < slice) slice = remaining
                linuxSleepMillisecondsChecked(slice)
                remaining = remaining - slice
            }
        }
        if (waiting) {
            linuxSyscall2(62, 0 - this.process, 9)
            result = linuxWaitProcess(this.process).status
        }
    }
    result
}

fun LinuxChildProcess.stop(graceMilliseconds: int = 5000): int {
    var result = -1
    if (this.process > 0) {
        linuxSyscall2(62, this.process, 15)
        var remaining = graceMilliseconds
        var waiting = true
        while (waiting && remaining > 0) {
            val observed = linuxWaitProcess(this.process, true)
            if (observed.output != "pending") {
                result = observed.status
                waiting = false
            }
            if (waiting) {
                var slice = 10
                if (remaining < slice) slice = remaining
                linuxSleepMillisecondsChecked(slice)
                remaining = remaining - slice
            }
        }
        if (waiting) {
            linuxSyscall2(62, this.process, 9)
            result = linuxWaitProcess(this.process).status
        }
    }
    result
}

private fun linuxSleepNanosecondsWithBuffers(
    nanoseconds: int,
    var requested: NativeByteBuffer,
    var remaining: NativeByteBuffer
): bool {
    var success = nanoseconds >= 0 && !requested.closed &&
        requested.capacity >= 16 && !remaining.closed &&
        remaining.capacity >= 16
    if (success) {
        requested.storeI64(0, nanoseconds / 1000000000)
        requested.storeI64(
            8,
            nanoseconds - nanoseconds / 1000000000 * 1000000000
        )
        var waiting = true
        while (waiting) {
            val status = linuxSyscall2(
                35,
                nativePointerAddress(requested.address),
                nativePointerAddress(remaining.address)
            )
            if (status == 0) waiting = false
            if (status == -4) {
                requested.storeI64(0, remaining.loadI64(0))
                requested.storeI64(8, remaining.loadI64(8))
            }
            if (status != 0 && status != -4) {
                success = false
                waiting = false
            }
        }
    }
    success
}

private fun linuxSleepNanosecondsChecked(nanoseconds: int): bool {
    val requested = nativeByteBuffer(16)
    val remaining = nativeByteBuffer(16)
    val succeeded = linuxSleepNanosecondsWithBuffers(
        nanoseconds,
        requested,
        remaining
    )
    requested.close()
    remaining.close()
    succeeded
}

fun linuxSleepMillisecondsChecked(milliseconds: int): bool =
    milliseconds >= 0 && milliseconds <= 9223372036854 &&
    linuxSleepNanosecondsChecked(milliseconds * 1000000)

private fun linuxProcessUnit(): void {}

fun linuxSleep(milliseconds: int): void {
    linuxSleepMillisecondsChecked(milliseconds)
    linuxProcessUnit()
}

fun linuxSleepNanoseconds(nanoseconds: int): bool {
    val succeeded = linuxSleepNanosecondsChecked(nanoseconds)
    linuxProcessUnit()
    succeeded
}

fun linuxMonotonicNanosecondsWithBuffer(
    var timestamp: NativeByteBuffer
): int = linuxClockNanosecondsWithBuffer(1, timestamp)

// clock_gettime of `clock` (0 CLOCK_REALTIME, 1 CLOCK_MONOTONIC) in
// nanoseconds, or 0 when it fails.
private fun linuxClockNanosecondsWithBuffer(
    clock: int,
    var timestamp: NativeByteBuffer
): int {
    var result = 0
    if (timestamp.closed || timestamp.capacity < 16) return result
    timestamp.storeI64(0, 0)
    timestamp.storeI64(8, 0)
    val status = linuxSyscall2(
        228,
        clock,
        nativePointerAddress(timestamp.address)
    )
    if (status == 0) {
        val seconds = timestamp.loadI64(0)
        val nanoseconds = timestamp.loadI64(8)
        if (seconds >= 0 && seconds <= 9223372035 &&
            nanoseconds >= 0 && nanoseconds < 1000000000 &&
            seconds <= (9223372036854775807 - nanoseconds) / 1000000000) {
            result = seconds * 1000000000 + nanoseconds
        }
    }
    result
}

resource class LinuxMonotonicClock(
    var timestamp: NativeByteBuffer,
    var requested: NativeByteBuffer,
    var remaining: NativeByteBuffer
) {
    fun valid(): bool = !this.timestamp.closed &&
        this.timestamp.capacity >= 16 && !this.requested.closed &&
        this.requested.capacity >= 16 && !this.remaining.closed &&
        this.remaining.capacity >= 16

    fun nanoseconds(): int =
        linuxMonotonicNanosecondsWithBuffer(this.timestamp)

    fun sleepNanoseconds(nanoseconds: int): bool =
        linuxSleepNanosecondsWithBuffers(
            nanoseconds,
            this.requested,
            this.remaining
        )

    fun drop(): void {
        this.timestamp.close()
        this.requested.close()
        this.remaining.close()
        return
    }
}

fun linuxMonotonicClock(): LinuxMonotonicClock = LinuxMonotonicClock(
    nativeByteBuffer(16),
    nativeByteBuffer(16),
    nativeByteBuffer(16)
)

// Ambient providers used by the compiler stay on the same libc-free syscall
// layer as ordinary Abla programs. These helpers expose values, while compile
// capability policy remains the compiler evaluator's responsibility.
fun linuxMonotonicNanoseconds(): int {
    val timestamp = nativeByteBuffer(16)
    val result = linuxMonotonicNanosecondsWithBuffer(timestamp)
    timestamp.close()
    result
}

fun linuxMonotonicMilliseconds(): int =
    linuxMonotonicNanoseconds() / 1000000

// Wall-clock time: nanoseconds since 1970-01-01T00:00:00Z.
fun linuxRealtimeNanoseconds(): int {
    val timestamp = nativeByteBuffer(16)
    val result = linuxClockNanosecondsWithBuffer(0, timestamp)
    timestamp.close()
    result
}

fun linuxRandomInteger(maxExclusive: int): int {
    var result = 0
    if (maxExclusive > 0) {
        val bytes = nativeByteBuffer(8)
        val status = linuxSyscall3(
            318,
            nativePointerAddress(bytes.address),
            8,
            0
        )
        if (status == 8) {
            // Seven bytes keep the accumulator positive on a signed i64.
            var index = 0
            while (index < 7) {
                result = result * 256 + bytes.load(index)
                index = index + 1
            }
            result = result - result / maxExclusive * maxExclusive
        }
        bytes.close()
    }
    result
}

// A close-on-exec pipe used for data, the start barrier and exec failure reports.
class LinuxPipelinePipe(val input: int, val output: int)

private fun linuxPipelineSafeDescriptor(descriptor: int): int {
    if (descriptor >= 3) return descriptor
    val replacement = linuxSyscall3(72, descriptor, 0, 3) // F_DUPFD
    linuxSyscall1(3, descriptor)
    if (replacement < 0) return -1
    if (linuxSyscall3(72, replacement, 2, 1) < 0) { // F_SETFD, FD_CLOEXEC
        linuxSyscall1(3, replacement)
        return -1
    }
    replacement
}

private fun linuxPipelinePipe(): LinuxPipelinePipe {
    val descriptors = nativeByteBuffer(8)
    val status = linuxSyscall2(293, nativePointerAddress(descriptors.address), 524288)
    var input = -1
    var output = -1
    if (status == 0) {
        input = descriptors.load(0) + descriptors.load(1) * 256 +
            descriptors.load(2) * 65536 + descriptors.load(3) * 16777216
        output = descriptors.load(4) + descriptors.load(5) * 256 +
            descriptors.load(6) * 65536 + descriptors.load(7) * 16777216
        input = linuxPipelineSafeDescriptor(input)
        output = linuxPipelineSafeDescriptor(output)
        if (input < 0 || output < 0) {
            if (input >= 0) linuxSyscall1(3, input)
            if (output >= 0) linuxSyscall1(3, output)
            input = -1
            output = -1
        }
    }
    descriptors.close()
    LinuxPipelinePipe(input, output)
}

private fun linuxPipelineClose(descriptor: int): void {
    if (descriptor >= 0) linuxSyscall1(3, descriptor)
}

private fun linuxPipelineRead(descriptor: int, maximum: int): string {
    val buffer = nativeByteBuffer(maximum + 1)
    var amount = linuxSyscall3(0, descriptor, nativePointerAddress(buffer.address), maximum)
    while (amount == -4) amount = linuxSyscall3(0, descriptor, nativePointerAddress(buffer.address),
        maximum)
    if (amount < 0) {
        buffer.close()
        return ""
    }
    buffer.adoptString(amount)
}

private fun linuxPipelineWait(process: int): int {
    val status = nativeByteBuffer(8)
    status.storeI64(0, 0)
    var waited = linuxSyscall4(61, process, nativePointerAddress(status.address), 0, 0)
    while (waited == -4) waited = linuxSyscall4(61, process, nativePointerAddress(status.address),
        0, 0)
    val result = if (waited == process) linuxDecodeWaitStatus(status.loadI64(0)) else -1
    status.close()
    result
}

/** A private copy prevents later mutations to a Command changing a pipeline. */
fun LinuxCommand.snapshot(): LinuxCommand {
    val arguments: array<string> = []
    val overrides: array<string> = []
    val removed: array<string> = []
    for (value in this.arguments) arguments.append(value)
    for (value in this.overrides) overrides.append(value)
    for (value in this.removed) removed.append(value)
    LinuxCommand(arguments, overrides, this.workingDirectory, this.inputPath,
        this.outputPath, this.errorPath, removed)
}

class LinuxPipelineResult(
    val statuses: array<int>,
    val output: string,
    val errors: string,
    val launchError: string,
    val status: int
) {
    fun allSucceeded(): bool {
        if (this.launchError != "" || this.statuses.size == 0) return false
        for (status in this.statuses) if (status != 0) return false
        true
    }
}

class LinuxRunningPipeline(
    val processes: array<int>,
    val group: int,
    val outputDescriptor: int,
    val errorDescriptor: int,
    val launchError: string,
    var result: LinuxPipelineResult? = null
)

// Restore SIGPIPE for programs, even when the caller ignores or blocks it.
// `action` is a zeroed kernel sigaction (32 bytes: handler SIG_DFL, no flags or mask) and
// `unblock` a signal set holding SIGPIPE, both made before the fork so that the child
// allocates nothing. Targets without direct system calls use libc signal().
private fun linuxPipelineResetSigpipe(action: NativeByteBuffer, unblock: NativeByteBuffer): void {
    if (ablaHostOwnsRuntime()) linuxSyscall4(13, 13,
        nativePointerAddress(action.address), 0, 8)
    else signal(13, nativeNullPointer())
    linuxSyscall4(14, 1, nativePointerAddress(unblock.address), 0, 8)
    return
}

private fun linuxPipelineConflict(commands: array<LinuxCommand>, capture: bool,
    errors: bool): string {
    if (commands.size == 0) return "empty pipeline"
    var index = 0
    while (index < commands.size) {
        val command = commands[index]
        if (index > 0 && command.inputPath != "") return "pipeline input conflicts with redirect"
        if (index + 1 < commands.size && command.outputPath !=
            "") return "pipeline output conflicts with redirect"
        if (capture && index + 1 == commands.size && command.outputPath !=
            "") return "capture output conflicts with redirect"
        if (errors && command.errorPath != "") return "capture stderr conflicts with redirect"
        index = index + 1
    }
    ""
}

// The parent and each child close every unused pipe end. The barrier keeps the
// first child alive until all stages have joined its process group.
fun linuxPipelineStart(commands: array<LinuxCommand>, grouped: bool, capture: bool,
    captureErrors: bool): LinuxRunningPipeline {
    val processes: array<int> = []
    val pipes: array<LinuxPipelinePipe> = []
    val reports: array<LinuxPipelinePipe> = []
    var problem = linuxPipelineConflict(commands, capture, captureErrors)
    var index = 1
    while (problem == "" && index < commands.size) {
        val pipe = linuxPipelinePipe()
        if (pipe.input < 0) problem = "pipe failed" else pipes.append(pipe)
        index = index + 1
    }
    val stdout = if (problem == "" && capture) linuxPipelinePipe() else LinuxPipelinePipe(-1, -1)
    if (capture && stdout.input < 0 && problem == "") problem = "stdout pipe failed"
    val stderr = if (problem == "" && captureErrors) linuxPipelinePipe() else LinuxPipelinePipe(-1,
        -1)
    if (captureErrors && stderr.input < 0 && problem == "") problem = "stderr pipe failed"
    val barrier = if (problem == "" && grouped) linuxPipelinePipe() else LinuxPipelinePipe(-1, -1)
    if (grouped && barrier.input < 0 && problem == "") problem = "barrier pipe failed"
    index = 0
    while (problem == "" && index < commands.size) {
        val report = linuxPipelinePipe()
        if (report.input < 0) problem = "exec report pipe failed" else reports.append(report)
        index = index + 1
    }
    var group = -1
    // What the children use, made before the first fork.
    val resetAction = nativeByteBuffer(32)
    resetAction.storeI64(0, 0)
    resetAction.storeI64(8, 0)
    resetAction.storeI64(16, 0)
    resetAction.storeI64(24, 0)
    val unblockSet = nativeByteBuffer(8)
    unblockSet.storeI64(0, 4096)
    val barrierRead = nativeByteBuffer(8)
    index = 0
    while (problem == "" && index < commands.size) {
        val command = commands[index]
        val executable = if (command.arguments.size >
            0) linuxExecutablePath(command.arguments[0]) else ""
        val vector = linuxArgumentVector(command.arguments)
        val environment = command.environmentVector()
        val addresses = if (executable !=
            "") command.execAddresses(executable) else LinuxExecAddresses(0, 0, 0, 0, 0)
        val process = linuxFork()
        if (process == 0) {
            var ready = true
            if (grouped) ready = linuxSyscall2(109, 0, if (group < 0) 0 else group) == 0
            if (index > 0 && linuxSyscall2(33, pipes[index - 1].input, 0) < 0) ready = false
            if (index + 1 < commands.size) {
                if (linuxSyscall2(33, pipes[index].output, 1) < 0) ready = false
            } else if (capture && linuxSyscall2(33, stdout.output, 1) < 0) ready = false
            if (captureErrors && linuxSyscall2(33, stderr.output, 2) < 0) ready = false
            var closing = 0
            while (closing < pipes.size) {
                linuxPipelineClose(pipes[closing].input)
                linuxPipelineClose(pipes[closing].output)
                closing = closing + 1
            }
            linuxPipelineClose(stdout.input)
            linuxPipelineClose(stdout.output)
            linuxPipelineClose(stderr.input)
            linuxPipelineClose(stderr.output)
            var reportIndex = 0
            while (reportIndex < reports.size) {
                linuxPipelineClose(reports[reportIndex].input)
                if (reportIndex != index) linuxPipelineClose(reports[reportIndex].output)
                reportIndex = reportIndex + 1
            }
            if (grouped) {
                linuxPipelineClose(barrier.output)
                // Blocks until the parent closes the barrier (read returns 0).
                var waited = linuxSyscall3(0, barrier.input,
                    nativePointerAddress(barrierRead.address), 1)
                while (waited == -4) waited = linuxSyscall3(0, barrier.input,
                    nativePointerAddress(barrierRead.address), 1)
                linuxPipelineClose(barrier.input)
            }
            linuxPipelineResetSigpipe(resetAction, unblockSet)
            if (ready && addresses.executable != 0) command.execPrepared(addresses, vector,
                environment)
            linuxWrite(reports[index].output, "x")
            linuxSyscall1(60, 127)
        }
        environment.close()
        vector.close()
        if (process < 0) problem = "fork failed"
        else {
            processes.append(process)
            if (grouped) {
                if (group < 0) group = process
                linuxSyscall2(109, process, group)
            }
        }
        index = index + 1
    }
    resetAction.close()
    unblockSet.close()
    barrierRead.close()
    for (pipe in pipes) { linuxPipelineClose(pipe.input); linuxPipelineClose(pipe.output) }
    linuxPipelineClose(stdout.output)
    linuxPipelineClose(stderr.output)
    linuxPipelineClose(barrier.input)
    linuxPipelineClose(barrier.output)
    for (report in reports) linuxPipelineClose(report.output)
    if (problem != "") {
        for (process in processes) linuxSyscall2(62, process, 9)
        for (process in processes) linuxPipelineWait(process)
        for (report in reports) linuxPipelineClose(report.input)
        linuxPipelineClose(stdout.input)
        linuxPipelineClose(stderr.input)
        return LinuxRunningPipeline([], -1, -1, -1, problem)
    }
    val failedStages: array<int> = []
    index = 0
    while (index < reports.size) {
        val report = linuxPipelineRead(reports[index].input, 1)
        linuxPipelineClose(reports[index].input)
        if (report != "") {
            failedStages.append(index)
            if (problem == "") problem = "stage $index failed to start"
        }
        index = index + 1
    }
    if (problem != "") {
        var stage = 0
        while (stage < processes.size) {
            var failed = false
            for (item in failedStages) if (item == stage) failed = true
            if (!failed) linuxSyscall2(62, processes[stage], 9)
            stage = stage + 1
        }
    }
    LinuxRunningPipeline(processes, group, stdout.input, stderr.input, problem)
}

// Drain both streams concurrently. A child can fill either pipe before the
// other, so reading one to EOF first can deadlock.
private fun linuxPipelineDrain(output: int, errors: int): array<string> {
    val text = byteBuffer()
    val errorText = byteBuffer()
    val poll = nativeByteBuffer(16)
    var first = output
    var second = errors
    while (first >= 0 || second >= 0) {
        poll.storeI64(0, first + 4294967296)
        poll.storeI64(8, second + 4294967296)
        val ready = linuxSyscall3(7, nativePointerAddress(poll.address), 2, -1)
        if (ready < 0 && ready != -4) {
            linuxPipelineClose(first)
            linuxPipelineClose(second)
            first = -1
            second = -1
        } else if (ready > 0) {
            if (first >= 0 && (poll.load(6) != 0 || poll.load(7) != 0)) {
                val chunk = linuxPipelineRead(first, 65536)
                if (chunk == "") { linuxPipelineClose(first); first = -1 }
                else text.appendText(chunk)
            }
            if (second >= 0 && (poll.load(14) != 0 || poll.load(15) != 0)) {
                val chunk = linuxPipelineRead(second, 65536)
                if (chunk == "") { linuxPipelineClose(second); second = -1 }
                else errorText.appendText(chunk)
            }
        }
    }
    poll.close()
    [text.toText(), errorText.toText()]
}

fun LinuxRunningPipeline.wait(): LinuxPipelineResult {
    val previous = this.result
    if (previous != null) return previous
    val captured = linuxPipelineDrain(this.outputDescriptor, this.errorDescriptor)
    val statuses: array<int> = []
    for (process in this.processes) statuses.append(linuxPipelineWait(process))
    val status = if (statuses.size == 0) -1 else statuses[statuses.size - 1]
    val result = LinuxPipelineResult(statuses, captured[0], captured[1], this.launchError, status)
    this.result = result
    result
}

fun LinuxRunningPipeline.stop(graceMilliseconds: int = 5000): LinuxPipelineResult {
    val previous = this.result
    if (previous != null) return previous
    if (this.group > 0) {
        linuxSyscall2(62, 0 - this.group, 15)
        linuxSleepMillisecondsChecked(graceMilliseconds)
        linuxSyscall2(62, 0 - this.group, 9)
    }
    this.wait()
}
