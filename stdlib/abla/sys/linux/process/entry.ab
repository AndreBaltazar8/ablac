// Linux process entry information without the project C host adapter.
// On x86-64 Linux a child is made with the fork system call and no libc, so a child
// allocates nothing before exec or _exit: a thread that held the heap lock at the fork
// would leave it held in the child. Everything a child needs is prepared before the
// fork. A macOS child is made through the runtime's dispatcher (fork 57), which calls libSystem's fork (#811):
// its fork handlers keep libSystem usable in the child. Other targets keep libc fork (which repairs those locks).

import "abla/sys/linux"
import "abla/bytes"
import "abla/unsafe/memory/raw"
import "abla/unsafe/memory"

private noescape extern:"c" fun fork(): i32
private noescape extern:"c" fun signal(number: int, handler: i64*): i64*
private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool
private noescape extern:"intrinsic" fun ablaHostIsIOS(): bool
private noescape extern:"intrinsic" fun ablaHostOwnsRuntime(): bool
private noescape extern:"intrinsic" fun ablaSimdTargetArch(): int

// Returns the number of command-line arguments excluding the executable.
noescape extern:"intrinsic" fun ablaLinuxArgumentCount(): int

// Returns a program argument by index, with -1 selecting the executable and an empty string for an invalid index.
noescape extern:"intrinsic" fun ablaLinuxArgument(index: int): string

// Returns a borrowed pointer to the process's null-terminated environment vector.
noescape extern:"intrinsic" fun ablaLinuxEnvironmentPointer(): i64*

// Holds the value and a presence flag that distinguishes a missing variable from an empty value.
class LinuxEnvironmentValue(val value: string, val found: bool)

// Holds the child process status and its captured output, if any.
class LinuxProcessResult(val status: int, val output: string, val timedOut: bool = false)

// Describes the arguments, environment changes, working directory, and stream redirections for one command.
class LinuxCommand(
    val arguments: array<string>,
    val overrides: array<string> = [],
    var workingDirectory: string = "",
    var inputPath: string = "",
    var outputPath: string = "",
    var errorPath: string = "",
    val removed: array<string> = []
)

// Holds a child process identifier, with a negative value indicating launch failure.
class LinuxChildProcess(val process: int)

// Returns the number of command-line arguments after the executable.
fun linuxArgumentCount(): int = ablaLinuxArgumentCount()

// Argument `index` (0 the first after the program, -1 the program itself), or
// "" past the end: reading past argv used to fault.
fun linuxArgument(index: int): string =
    if (index < -1 || index >= linuxArgumentCount()) "" else ablaLinuxArgument(index)

// Returns a borrowed pointer to the process's null-terminated environment vector.
fun linuxEnvironmentPointer(): i64* = ablaLinuxEnvironmentPointer()

// Looks up environment variable `name` exactly. Returns its text and found=true when present, including an empty value, or empty text and found=false otherwise.
trusted fun linuxEnvironment(name: string): LinuxEnvironmentValue {
    var cursor = linuxEnvironmentPointer()
    var found = false
    var result = ""
    var current = nativeNullPointer()
    if (!pointerIsNull(cursor)) {
        current = NativePointerCell(cursor, false, false).load()
    }
    while (!pointerIsNull(current) && !found) {
        // Read in place: the environment lives as long as the process.
        val entry = borrowNativeCString(current)
        if (entry.size > name.size && entry[name.size] == 61 &&
            entry.slice(0, name.size) == name) {
            result = entry.slice(name.size + 1, entry.size)
            found = true
        }
        cursor = ablaUnsafePointerOffset(cursor, 8)
        current = NativePointerCell(cursor, false, false).load()
    }
    LinuxEnvironmentValue(result, found)
}

// Returns the first executable match in PATH's absolute directories, the original text for a path containing a slash, or ""
// for a name with no match. A bare name never resolves against the working directory: not through an empty PATH entry
// ("a::b", a leading or trailing ':'), nor "." or another relative entry, nor by handing the bare name to execve when PATH
// has no match (execve reads a name without a slash against the working directory). The compiler starts its tools by bare
// name (ld.lld, clang, llvm-config, codesign, ...) in the directory of the tree it builds, which may carry a file of that
// name; an empty result makes the exec fail (ENOENT) instead.
trusted fun linuxExecutablePath(executable: string): string {
    // Windows searches PATH itself (CreateProcessW, with its ";" separators, drive letters and ".exe"): the name goes through as given
    if (linuxIsWindows()) return executable
    var hasSlash = false
    var index = 0
    while (index < executable.size) {
        if (executable[index] == 47) hasSlash = true
        index = index + 1
    }
    var result = executable
    if (!hasSlash) {
        result = ""
        val configured = linuxEnvironment("PATH")
        var search = "/usr/local/bin:/usr/bin:/bin"
        if (configured.found) search = configured.value
        var begin = 0
        var searching = executable != ""
        while (searching && begin <= search.size) {
            var end = begin
            while (end < search.size && search[end] != 58) end = end + 1
            val directory = search.slice(begin, end)
            val candidate = "$directory/$executable"
            if (directory.size > 0 && directory[0] == 47 && linuxSyscall2(
                21,
                nativeCStringAddress(candidate),
                1
            ) == 0) {
                result = candidate
                searching = false
            }
            if (end == search.size) searching = false
            begin = end + 1
        }
    }
    result
}

// argv for an exec: the pointer table, then each argument's bytes and a NUL, in
// the vector's one native allocation, so the strings live exactly as long as it.
// (Pointers to C-string copies of the arguments were collectible: a collection
// between building the vector and the exec handed the child freed memory.)
private trusted fun linuxArgumentVector(arguments: array<string>): NativeByteBuffer {
    val table = (arguments.size + 1) * 8
    var bytes = 0
    for (argument in arguments) bytes = bytes + argument.size + 1
    val vector = nativeByteBuffer(table + bytes)
    var offset = table
    var index = 0
    while (index < arguments.size) {
        val argument = arguments[index]
        vector.storePointer(index * 8, vector.pointerAt(offset))
        var byte = 0
        while (byte < argument.size) {
            vector.store(offset + byte, argument[byte])
            byte = byte + 1
        }
        vector.store(offset + argument.size, 0)
        offset = offset + argument.size + 1
        index = index + 1
    }
    vector.storePointer(arguments.size * 8, nativeNullPointer())
    vector
}

private fun linuxDecodeWaitStatus(encoded: int): int {
    val signal = encoded - encoded / 128 * 128
    var result = 128 + signal
    if (signal == 0) result = encoded / 256 - encoded / 65536 * 256
    result
}

// Collects `process` and returns its decoded wait status. With `noHang` true, returns status -1 and output pending when the child is still running. A wait error returns status -1 and empty output.
trusted fun linuxWaitProcess(process: int, noHang: bool = false): LinuxProcessResult {
    val statusBuffer = nativeByteBuffer(8)
    statusBuffer.storeI64(0, 0)
    val options = if (noHang) 1 else 0
    val address = nativePointerAddress(statusBuffer.address)
    var waited = linuxSyscall4(61, process, address, options, 0)
    while (waited == -4) waited = linuxSyscall4(61, process, address, options, 0)
    var status = -1
    if (waited == process) {
        status = linuxDecodeWaitStatus(statusBuffer.loadI64(0))
    }
    statusBuffer.close()
    var state = ""
    if (waited == 0) state = "pending"
    LinuxProcessResult(status, state)
}

private trusted fun linuxExecPrepared(
    executable: int,
    vector: NativeByteBuffer
): int {
    linuxSyscall3(
        59,
        executable,
        nativePointerAddress(vector.address),
        nativePointerAddress(linuxEnvironmentPointer())
    )
    linuxSyscall1(60, 127)
}

// The stack limits (RLIMIT_STACK) in bytes: [soft, hard], -1 for unlimited,
// or [] when they cannot be read.
trusted fun linuxStackLimits(): array<int> {
    val limits = nativeByteBuffer(16)
    limits.storeI64(0, 0)
    limits.storeI64(8, 0)
    val status = linuxSyscall2(97, 3, nativePointerAddress(limits.address))
    val result: array<int> = []
    if (status == 0) {
        result.append(limits.loadI64(0))
        result.append(limits.loadI64(8))
    }
    limits.close()
    result
}

// Returns true if the host accepts the requested soft and hard stack limits in bytes.
trusted fun linuxSetStackLimits(soft: int, hard: int): bool {
    val limits = nativeByteBuffer(16)
    limits.storeI64(0, soft)
    limits.storeI64(8, hard)
    val status = linuxSyscall2(160, 3, nativePointerAddress(limits.address))
    limits.close()
    status == 0
}

// Replaces this process with a fresh run of its own executable and the same
// arguments (only returns when that fails).
trusted fun linuxReexecute(): void {
    val arguments: array<string> = []
    var index = -1
    while (index < linuxArgumentCount()) {
        arguments.append(linuxArgument(index))
        index = index + 1
    }
    val vector = linuxArgumentVector(arguments)
    linuxSyscall3(
        59,
        nativeCStringAddress("/proc/self/exe"),
        nativePointerAddress(vector.address),
        nativePointerAddress(linuxEnvironmentPointer())
    )
    vector.close()
    return
}

// linuxReexecute with `environment` (`NAME=value` entries) as the new run's
// whole environment (only returns when the exec fails).
trusted fun linuxReexecuteWithEnvironment(environment: array<string>): void {
    val arguments: array<string> = []
    var index = -1
    while (index < linuxArgumentCount()) {
        arguments.append(linuxArgument(index))
        index = index + 1
    }
    val vector = linuxArgumentVector(arguments)
    val entries = linuxArgumentVector(environment)
    linuxSyscall3(
        59,
        nativeCStringAddress("/proc/self/exe"),
        nativePointerAddress(vector.address),
        nativePointerAddress(entries.address)
    )
    entries.close()
    vector.close()
    return
}

// Replaces this process with `executable`, given `arguments` as its argv (the
// first is its argv[0]). The standard streams, the working directory and the
// environment carry over. Only returns, with 127, when the exec fails.
trusted fun linuxExecute(executable: string, arguments: array<string>): int {
    val vector = linuxArgumentVector(arguments)
    linuxSyscall3(
        59,
        nativeCStringAddress(executable),
        nativePointerAddress(vector.address),
        nativePointerAddress(linuxEnvironmentPointer())
    )
    vector.close()
    127
}

// Creates a command configuration with `executable` as its initial argument. It does not start a process.
fun linuxCommand(executable: string): LinuxCommand =
    LinuxCommand([executable])

// Appends `value` as one argument and returns this command configuration.
fun LinuxCommand.argument(value: string): LinuxCommand {
    this.arguments.append(value)
    this
}

// `name` set to `value` for what this command starts, replacing what an
// earlier call set it to; the rest of the environment carries over.
fun LinuxCommand.environment(name: string, value: string): LinuxCommand {
    val entry = "$name=$value"
    var replaced = false
    var index = 0
    while (index < this.overrides.size) {
        val existing = this.overrides[index]
        if (existing.size > name.size && existing[name.size] == 61 &&
            existing.slice(0, name.size) == name) {
            this.overrides[index] = entry
            replaced = true
        }
        index = index + 1
    }
    if (!replaced) this.overrides.append(entry)
    this
}

// `name` taken out of what the command inherits. A later `environment` of that name still sets it.
fun LinuxCommand.removeEnvironment(name: string): LinuxCommand {
    this.removed.append(name)
    this
}

// Where the command runs, instead of this process's working directory.
fun LinuxCommand.directory(path: string): LinuxCommand {
    this.workingDirectory = path
    this
}

// Standard input read from this file.
fun LinuxCommand.input(path: string): LinuxCommand {
    this.inputPath = path
    this
}

// Standard output written to this file, created if missing (with the mode a
// file already there has) and emptied. "/dev/null" discards it.
fun LinuxCommand.output(path: string): LinuxCommand {
    this.outputPath = path
    this
}

// Standard error written to this file, as with `output`.
fun LinuxCommand.errors(path: string): LinuxCommand {
    this.errorPath = path
    this
}

// The inherited environment with this command's overrides on top, as an envp.
private trusted fun LinuxCommand.environmentVector(): NativeByteBuffer {
    val entries: array<string> = []
    var cursor = linuxEnvironmentPointer()
    var current = nativeNullPointer()
    if (!pointerIsNull(cursor)) {
        current = NativePointerCell(cursor, false, false).load()
    }
    while (!pointerIsNull(current)) {
        val entry = borrowNativeCString(current)
        var replaced = false
        for (override in this.overrides) {
            val name = override.slice(0, linuxNameSize(override) + 1)
            if (entry.size >= name.size && entry.slice(0, name.size) == name) {
                replaced = true
            }
        }
        for (name in this.removed) {
            if (entry.size > name.size && entry[name.size] == 61 && entry.slice(0,
                name.size) == name) {
                replaced = true
            }
        }
        if (!replaced) entries.append(entry)
        cursor = ablaUnsafePointerOffset(cursor, 8)
        current = NativePointerCell(cursor, false, false).load()
    }
    for (override in this.overrides) entries.append(override)
    linuxArgumentVector(entries)
}

// This process's environment, as `NAME=value` entries in their order.
trusted fun linuxEnvironmentEntries(): array<string> {
    val entries: array<string> = []
    var cursor = linuxEnvironmentPointer()
    var current = nativeNullPointer()
    if (!pointerIsNull(cursor)) {
        current = NativePointerCell(cursor, false, false).load()
    }
    while (!pointerIsNull(current)) {
        entries.append(borrowNativeCString(current))
        cursor = ablaUnsafePointerOffset(cursor, 8)
        current = NativePointerCell(cursor, false, false).load()
    }
    entries
}

private fun linuxNameSize(entry: string): int {
    var index = 0
    while (index < entry.size && entry[index] != 61) index = index + 1
    index
}

// Per-thread watched mask, original mask bits, then 64 reference counts.
// fork copies the calling thread's state for the child, so it can unblock only
// that thread's watched signals before exec.
trusted fun linuxSignalWatchState(): int =
    nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")

// Whether `offset` names one of the 66 words of the signal-watch state (528 bytes, 8-aligned).
private fun linuxSignalWatchOffset(offset: int): bool = offset >= 0 && offset <= 520 && offset % 8 == 0

// Returns the native word at byte `offset` in the calling thread's signal-watch state, or 0 when `offset` is not one of its words.
trusted fun linuxSignalWatchGet(offset: int): int =
    if (linuxSignalWatchOffset(offset)) ablaUnsafeLoadI64(nativePointerFromAddress(linuxSignalWatchState() + offset)) else 0

// Writes a native word at byte `offset` in the calling thread's signal-watch state; does nothing when `offset` is not one of its words.
trusted fun linuxSignalWatchSet(offset: int, value: int): void {
    if (linuxSignalWatchOffset(offset)) ablaUnsafeStoreI64(nativePointerFromAddress(linuxSignalWatchState() + offset), value)
    return
}

// A child unblocks signals through the thread-local watch state: create it before the
// fork, so the child does not allocate it.
// A test seam (the process-pipeline test cannot interpose libc fork any more): the nth
// fork after linuxFailForkNumber(n) fails as if the process limit were reached.
var linuxForkFailureAt: int = 0
// Counts fork attempts while simulated fork failure is enabled.
var linuxForkCount: int = 0

// Resets the test counter and makes the selected fork fail, or disables simulated failure for a nonpositive number.
fun linuxFailForkNumber(number: int): void {
    linuxForkCount = 0
    linuxForkFailureAt = number
    return
}

// Whether this is a Windows target (linuxHostIsWindows).
private fun linuxIsWindows(): bool = linuxHostIsWindows()

// A Windows child is made by one call, not by fork and exec (Windows has no fork): the executable, argument and environment vectors,
// working directory and redirect paths of `addresses`, and the descriptors standard input, output and error come from (-1: the
// parent's own); `flags` 1 sends standard error where standard output goes. The process id, or -errno.
private trusted fun linuxWindowsSpawn(
    addresses: LinuxExecAddresses,
    vector: NativeByteBuffer,
    environment: NativeByteBuffer,
    inputDescriptor: int,
    outputDescriptor: int,
    errorDescriptor: int,
    flags: int
): int {
    val block = nativeByteBuffer(80)
    block.storeI64(0, addresses.executable)
    block.storeI64(8, nativePointerAddress(vector.address))
    block.storeI64(16, nativePointerAddress(environment.address))
    block.storeI64(24, addresses.directory)
    block.storeI64(32, addresses.input)
    block.storeI64(40, addresses.output)
    block.storeI64(48, addresses.error)
    block.storeI64(56, (inputDescriptor + 1) + (outputDescriptor + 1) * 65536 + (errorDescriptor + 1) * 4294967296)
    block.storeI64(64, flags)
    val process = linuxSyscall1(4001, nativePointerAddress(block.address))
    block.close()
    process
}

private trusted fun linuxFork(): int {
    linuxSignalWatchState()
    if (linuxForkFailureAt > 0) {
        linuxForkCount = linuxForkCount + 1
        if (linuxForkCount == linuxForkFailureAt) return -11
    }
    // The condition is written out here, not behind a helper: --fast does not inline, so a
    // helper would leave the libc fork reachable (and imported) in every --fast program.
    if (ablaHostOwnsRuntime() || (ablaHostIsMacOS() && !ablaHostIsIOS())) return linuxSyscall0(57)
    int(fork())
}

// setpgid(0, group) in a forked child (group 0: one of its own); its parent sets the group too, which closes the
// fork/exec race. On macOS the two calls can meet and the child's fail with EPERM (arm64 CI run 44865623174) when
// the group is already the one asked for: that is no failure. So is a session leader's EPERM, its group being its
// own. 0, or the negative errno. Allocation-free, as a forked child must be.
trusted fun linuxChildSetProcessGroup(group: int): int {
    val result = linuxSyscall2(109, 0, group)
    if (result >= 0) return result
    // getpid 39, getpgid 121
    val wanted = if (group == 0) linuxSyscall0(39) else group
    if (linuxSyscall1(121, 0) == wanted) 0 else result
}

private trusted fun linuxExecUnblockSignals(): void {
    val state = linuxSignalWatchState()
    if (linuxSignalWatchGet(0) != 0) linuxSyscall4(14, 1, state, 0, 8)
    return
}

// C-string addresses of what a child needs (0 = none), into native memory that execStrings
// copied them to before the fork, so a child only uses these numbers and allocates nothing.
// Not nativeCStringAddress: its copy is on the collected heap, held by nothing but the number,
// so a collection in any allocation before the exec (the argument and environment vectors)
// could take it, and the child exec'd freed bytes (#829).
class LinuxExecAddresses(
    val executable: int,
    val directory: int,
    val input: int,
    val output: int,
    val error: int
)

// The executable, working directory and redirect paths, NUL-terminated in one native buffer
// (laid out as an argument vector); the caller closes it once the child is forked.
private trusted fun LinuxCommand.execStrings(executable: string): NativeByteBuffer =
    linuxArgumentVector([
        executable, this.workingDirectory, this.inputPath, this.outputPath, this.errorPath
    ])

private trusted fun LinuxCommand.execAddresses(strings: NativeByteBuffer): LinuxExecAddresses = LinuxExecAddresses(
    strings.loadI64(0),
    if (this.workingDirectory != "") strings.loadI64(8) else 0,
    if (this.inputPath != "") strings.loadI64(16) else 0,
    if (this.outputPath != "") strings.loadI64(24) else 0,
    if (this.errorPath != "") strings.loadI64(32) else 0
)

private trusted fun linuxRedirect(path: int, flags: int, target: int): bool {
    // openat by system call: the child must not allocate the descriptor object.
    val opened = linuxSyscall4(257, -100, path, flags, 0o666)
    var ready = opened >= 0
    if (ready) ready = linuxSyscall2(33, opened, target) >= 0
    if (opened > 2) linuxSyscall1(3, opened)
    ready
}

// The working directory and redirects, then the exec. Only returns, with 127,
// when one of them fails.
private trusted fun LinuxCommand.execPrepared(
    addresses: LinuxExecAddresses,
    vector: NativeByteBuffer,
    environment: NativeByteBuffer
): int {
    var ready = true
    linuxExecUnblockSignals()
    if (addresses.directory != 0) {
        ready = linuxSyscall1(80, addresses.directory) == 0
    }
    if (ready && addresses.input != 0) {
        ready = linuxRedirect(addresses.input, 0, 0)
    }
    // O_WRONLY | O_CREAT | O_TRUNC.
    if (ready && addresses.output != 0) {
        ready = linuxRedirect(addresses.output, 577, 1)
    }
    if (ready && addresses.error != 0) {
        ready = linuxRedirect(addresses.error, 577, 2)
    }
    if (ready) {
        linuxSyscall3(
            59,
            addresses.executable,
            nativePointerAddress(vector.address),
            nativePointerAddress(environment.address)
        )
    }
    127
}

// Forks the configured command and waits for its status. Returns 127 on launch or child setup failure and -1 when waiting fails.
trusted fun LinuxCommand.run(): int {
    var result = 127
    if (this.arguments.size > 0) {
        val strings = this.execStrings(linuxExecutablePath(this.arguments[0]))
        val addresses = this.execAddresses(strings)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        val windows = linuxIsWindows()
        val process = if (windows) linuxWindowsSpawn(addresses, vector, environment, -1, -1, -1, 0) else linuxFork()
        if (process == 0 && !windows) {
            this.execPrepared(addresses, vector, environment)
            linuxSyscall1(60, 127)
        }
        if (process > 0) result = linuxWaitProcess(process).status
        environment.close()
        vector.close()
        strings.close()
    }
    result
}

// Replaces this process with the command: nothing after it runs, unless it
// fails, when it returns 127.
fun LinuxCommand.execute(): int {
    var result = 127
    if (this.arguments.size > 0) {
        val strings = this.execStrings(linuxExecutablePath(this.arguments[0]))
        val addresses = this.execAddresses(strings)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        result = this.execPrepared(addresses, vector, environment)
        environment.close()
        vector.close()
        strings.close()
    }
    result
}

private trusted fun linuxCaptureWithin(
    process: int, descriptor: int, milliseconds: int, interruptDescriptor: int
): LinuxProcessResult {
    val started = linuxMonotonicMilliseconds()
    val polling = nativeByteBuffer(144)
    polling.storeI64(0, descriptor | (1 << 32)) // pollfd { fd, POLLIN, 0 }.
    polling.storeI64(8, (interruptDescriptor & 4294967295) | (1 << 32))
    val address = nativePointerAddress(polling.address)
    var output = ""
    var reading = true
    var expired = false
    var interrupted = 0
    while (true) {
        if (!reading) {
            val observed = linuxWaitProcess(process, true)
            if (observed.output != "pending") {
                polling.close()
                return LinuxProcessResult(observed.status, output)
            }
        }
        val now = linuxMonotonicMilliseconds()
        if (started == 0 || now < started) break
        val remaining = milliseconds - (now - started)
        if (remaining <= 0) {
            expired = true
            break
        }
        val maximumWait = if (reading) 2147483647 else 10
        val ready = linuxSyscall3(7, address, 2, if (remaining < maximumWait) remaining else maximumWait)
        if (ready < 0 && ready != -4) break
        if (ready > 0) {
            if ((polling.load(14) & 1) != 0 &&
                linuxSyscall3(0, interruptDescriptor, address + 16, 128) == 128) {
                interrupted = polling.load(16)
                break
            }
            if (reading && (polling.load(6) != 0 || polling.load(7) != 0)) {
                // We are the sole reader. Once poll reports data or EOF, read returns
                // without waiting for the writer to fill the buffer or exit.
                val buffer = nativeByteBuffer(65537)
                val amount = linuxSyscall3(0, descriptor, nativePointerAddress(buffer.address), 65536)
                if (amount > 0) output = "$output${linuxExactString(buffer, amount, 65537)}"
                else {
                    buffer.close()
                    if (amount == 0) {
                        reading = false
                        polling.storeI64(0, -1)
                    }
                    else if (amount != -4) break
                }
            }
        }
    }
    polling.close()
    // Git and similar commands may delegate I/O to helper children. Kill the group
    // before waiting or closing the pipe so a helper can't keep the capture alive.
    linuxSyscall2(62, 0 - process, 9)
    linuxWaitProcess(process)
    LinuxProcessResult(if (interrupted > 0) 128 + interrupted else -1, "", expired)
}

// Runs the configured command and returns its status and captured stdout. Launch failure returns 127 and empty output.
// On Linux and macOS a positive timeoutMilliseconds bounds the capture and child wait. Expiry kills the process group and returns timedOut with empty output.
// For a bounded capture, a nonnegative interruptDescriptor reads signal records. An interrupt kills the group and returns 128 plus the signal.
trusted fun LinuxCommand.capture(timeoutMilliseconds: int = 0, interruptDescriptor: int = -1): LinuxProcessResult {
    var result = LinuxProcessResult(127, "")
    if (this.arguments.size > 0) {
        val strings = this.execStrings(linuxExecutablePath(this.arguments[0]))
        val addresses = this.execAddresses(strings)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        val descriptors = nativeByteBuffer(8)
        descriptors.storeI64(0, 0)
        val pipeStatus = linuxSyscall2(
            293,
            nativePointerAddress(descriptors.address),
            524288
        )
        if (pipeStatus == 0) {
            val readDescriptor = descriptors.load(0) +
                descriptors.load(1) * 256 +
                descriptors.load(2) * 65536 +
                descriptors.load(3) * 16777216
            val writeDescriptor = descriptors.load(4) +
                descriptors.load(5) * 256 +
                descriptors.load(6) * 65536 +
                descriptors.load(7) * 16777216
            val windows = linuxIsWindows()
            val timed = timeoutMilliseconds > 0 && !windows
            val process = if (windows) linuxWindowsSpawn(addresses, vector, environment, -1, writeDescriptor, -1, 0) else linuxFork()
            if (process == 0 && !windows) {
                linuxSyscall1(3, readDescriptor)
                if (timed && linuxChildSetProcessGroup(0) < 0) linuxSyscall1(60, 127)
                if (writeDescriptor == 1) {
                    if (linuxSyscall3(72, 1, 2, 0) < 0) linuxSyscall1(60, 127)
                } else {
                    if (linuxSyscall2(33, writeDescriptor, 1) < 0) linuxSyscall1(60, 127)
                    linuxSyscall1(3, writeDescriptor)
                }
                this.execPrepared(addresses, vector, environment)
                linuxSyscall1(60, 127)
            }
            linuxSyscall1(3, writeDescriptor)
            if (process > 0) {
                if (timed) {
                    linuxSyscall2(109, process, process)
                    result = linuxCaptureWithin(process, readDescriptor, timeoutMilliseconds, interruptDescriptor)
                } else {
                    var output = ""
                    var reading = true
                    while (reading) {
                        val chunk = LinuxFileDescriptor(readDescriptor).read(65536)
                        if (chunk.size > 0) output = "$output$chunk"
                        if (chunk.size == 0) reading = false
                    }
                    result = LinuxProcessResult(linuxWaitProcess(process).status, output)
                }
            }
            linuxSyscall1(3, readDescriptor)
        }
        descriptors.close()
        environment.close()
        vector.close()
        strings.close()
    }
    result
}

// Runs the configured command and returns captured stdout. Use capture if you need its status.
fun LinuxCommand.captureText(): string = this.capture().output

// Forks the configured command and returns a child handle. A failed fork gives a negative process ID. Setup or exec errors in the child exit with status 127.
trusted fun LinuxCommand.start(): LinuxChildProcess {
    var process = -1
    if (this.arguments.size > 0) {
        val strings = this.execStrings(linuxExecutablePath(this.arguments[0]))
        val addresses = this.execAddresses(strings)
        val vector = linuxArgumentVector(this.arguments)
        val environment = this.environmentVector()
        val windows = linuxIsWindows()
        process = if (windows) linuxWindowsSpawn(addresses, vector, environment, -1, -1, -1, 0) else linuxFork()
        if (process == 0 && !windows) {
            this.execPrepared(addresses, vector, environment)
            linuxSyscall1(60, 127)
        }
        environment.close()
        vector.close()
        strings.close()
    }
    LinuxChildProcess(process)
}

// Starts a process in its own process group. Environment entries override the
// inherited environment through the system `env` utility, while directory and
// descriptor setup happen directly in the forked child. Keeping this in Abla
// makes hosted build tools independent of a project-specific C launcher.
trusted fun linuxStartConfiguredProcess(
    directory: string,
    arguments: array<string>,
    environmentNames: array<string> = [],
    environmentValues: array<string> = [],
    outputPath: string = ""
): LinuxChildProcess {
    if (linuxIsWindows()) return linuxWindowsStartConfigured(directory, arguments, environmentNames, environmentValues, outputPath)
    var process = -1
    if (arguments.size > 0 &&
        environmentNames.size == environmentValues.size) {
        val launched: array<string> = []
        var executable = arguments[0]
        if (environmentNames.size > 0) {
            executable = linuxExecutablePath("env")
            launched.append(executable)
            var environmentIndex = 0
            while (environmentIndex < environmentNames.size) {
                launched.append(
                    "${environmentNames[environmentIndex]}=${environmentValues[environmentIndex]}"
                )
                environmentIndex = environmentIndex + 1
            }
        }
        var argumentIndex = 0
        while (argumentIndex < arguments.size) {
            launched.append(arguments[argumentIndex])
            argumentIndex = argumentIndex + 1
        }
        if (environmentNames.size == 0) {
            executable = linuxExecutablePath(arguments[0])
        }
        val vector = linuxArgumentVector(launched)
        // In native memory, as LinuxExecAddresses says why.
        val strings = linuxArgumentVector([executable, directory, outputPath])
        val executableAddress = strings.loadI64(0)
        val directoryAddress = if (directory != "") strings.loadI64(8) else 0
        val outputAddress = if (outputPath != "") strings.loadI64(16) else 0
        process = linuxFork()
        if (process == 0) {
            // setpgid(0, 0): the whole test process tree can be terminated on
            // timeout without affecting the parent test runner.
            linuxChildSetProcessGroup(0)
            linuxExecUnblockSignals()
            var ready = true
            if (directoryAddress != 0) {
                ready = linuxSyscall1(80, directoryAddress) == 0
            }
            if (ready && outputAddress != 0) {
                val output = linuxSyscall4(257, -100, outputAddress, 577, 0o666)
                ready = output >= 0
                if (ready) {
                    ready = linuxSyscall2(33, output, 1) >= 0 &&
                        linuxSyscall2(33, output, 2) >= 0
                }
                if (output > 2) linuxSyscall1(3, output)
            }
            if (ready) linuxExecPrepared(executableAddress, vector)
            linuxSyscall1(60, 127)
        }
        if (process > 0) linuxSyscall2(109, process, process)
        vector.close()
        strings.close()
    }
    LinuxChildProcess(process)
}

// Checks the child without blocking. Returns its exit status if collected, or -1 while pending or on wait failure. A completed status is consumed.
fun LinuxChildProcess.poll(): int =
    linuxWaitProcess(this.process, true).status

// Signals the child's process group with TERM and waits up to `graceMilliseconds` before escalating to KILL for the group. Use with a child started in its own group. Returns the child's status or -1 on failure.
trusted fun LinuxChildProcess.stopTree(graceMilliseconds: int = 100): int {
    var result = -1
    if (this.process > 0) {
        linuxSyscall2(62, 0 - this.process, 15)
        var remaining = graceMilliseconds
        var waiting = true
        while (waiting && remaining > 0) {
            val observed = linuxWaitProcess(this.process, true)
            if (observed.output != "pending") {
                result = observed.status
                waiting = false
            }
            if (waiting) {
                var slice = 10
                if (remaining < slice) slice = remaining
                linuxSleepMillisecondsChecked(slice)
                remaining = remaining - slice
            }
        }
        if (waiting) {
            linuxSyscall2(62, 0 - this.process, 9)
            result = linuxWaitProcess(this.process).status
        }
    }
    result
}

// Signals the child with TERM and waits up to `graceMilliseconds` before escalating to KILL. Returns the collected status, or -1 for an invalid child or failed wait.
trusted fun LinuxChildProcess.stop(graceMilliseconds: int = 5000): int {
    var result = -1
    if (this.process > 0) {
        linuxSyscall2(62, this.process, 15)
        var remaining = graceMilliseconds
        var waiting = true
        while (waiting && remaining > 0) {
            val observed = linuxWaitProcess(this.process, true)
            if (observed.output != "pending") {
                result = observed.status
                waiting = false
            }
            if (waiting) {
                var slice = 10
                if (remaining < slice) slice = remaining
                linuxSleepMillisecondsChecked(slice)
                remaining = remaining - slice
            }
        }
        if (waiting) {
            linuxSyscall2(62, this.process, 9)
            result = linuxWaitProcess(this.process).status
        }
    }
    result
}

private trusted fun linuxSleepNanosecondsWithBuffers(
    nanoseconds: int,
    var requested: NativeByteBuffer,
    var remaining: NativeByteBuffer
): bool {
    var success = nanoseconds >= 0 && !requested.closed &&
        requested.capacity >= 16 && !remaining.closed &&
        remaining.capacity >= 16
    if (success) {
        requested.storeI64(0, nanoseconds / 1000000000)
        requested.storeI64(
            8,
            nanoseconds - nanoseconds / 1000000000 * 1000000000
        )
        var waiting = true
        while (waiting) {
            val status = linuxSyscall2(
                35,
                nativePointerAddress(requested.address),
                nativePointerAddress(remaining.address)
            )
            if (status == 0) waiting = false
            if (status == -4) {
                requested.storeI64(0, remaining.loadI64(0))
                requested.storeI64(8, remaining.loadI64(8))
            }
            if (status != 0 && status != -4) {
                success = false
                waiting = false
            }
        }
    }
    success
}

private fun linuxSleepNanosecondsChecked(nanoseconds: int): bool {
    val requested = nativeByteBuffer(16)
    val remaining = nativeByteBuffer(16)
    val succeeded = linuxSleepNanosecondsWithBuffers(
        nanoseconds,
        requested,
        remaining
    )
    requested.close()
    remaining.close()
    succeeded
}

// Sleeps for `milliseconds`, resuming after interruption. Returns false for a negative duration, a duration too large to convert to nanoseconds, or a system error.
fun linuxSleepMillisecondsChecked(milliseconds: int): bool =
    milliseconds >= 0 && milliseconds <= 9223372036854 &&
    linuxSleepNanosecondsChecked(milliseconds * 1000000)

private fun linuxProcessUnit(): void {}

// Sleeps for the requested milliseconds and discards the result of the checked sleep.
fun linuxSleep(milliseconds: int): void {
    linuxSleepMillisecondsChecked(milliseconds)
    linuxProcessUnit()
}

// Sleeps for the requested nanoseconds, returning false for an invalid duration or a system error.
fun linuxSleepNanoseconds(nanoseconds: int): bool {
    val succeeded = linuxSleepNanosecondsChecked(nanoseconds)
    linuxProcessUnit()
    succeeded
}

// Returns a monotonic timestamp in nanoseconds, or zero if the clock read fails or the scratch buffer is unusable.
trusted fun linuxMonotonicNanosecondsWithBuffer(
    var timestamp: NativeByteBuffer
): int = linuxClockNanosecondsWithBuffer(1, timestamp)

// clock_gettime of `clock` (0 CLOCK_REALTIME, 1 CLOCK_MONOTONIC) in
// nanoseconds, or 0 when it fails.
private trusted fun linuxClockNanosecondsWithBuffer(
    clock: int,
    var timestamp: NativeByteBuffer
): int {
    var result = 0
    if (timestamp.closed || timestamp.capacity < 16) return result
    timestamp.storeI64(0, 0)
    timestamp.storeI64(8, 0)
    val status = linuxSyscall2(
        228,
        clock,
        nativePointerAddress(timestamp.address)
    )
    if (status == 0) {
        val seconds = timestamp.loadI64(0)
        val nanoseconds = timestamp.loadI64(8)
        if (seconds >= 0 && seconds <= 9223372035 &&
            nanoseconds >= 0 && nanoseconds < 1000000000 &&
            seconds <= (9223372036854775807 - nanoseconds) / 1000000000) {
            result = seconds * 1000000000 + nanoseconds
        }
    }
    result
}

// Owns scratch buffers for repeated nanosecond clock reads and sleeps.
resource class LinuxMonotonicClock(
    var timestamp: NativeByteBuffer,
    var requested: NativeByteBuffer,
    var remaining: NativeByteBuffer
) {
    // Returns true while all three clock buffers are open and hold at least 16 bytes.
    fun valid(): bool = !this.timestamp.closed &&
        this.timestamp.capacity >= 16 && !this.requested.closed &&
        this.requested.capacity >= 16 && !this.remaining.closed &&
        this.remaining.capacity >= 16

    // Returns a monotonic timestamp in nanoseconds, or zero if the clock read or its scratch buffer fails.
    fun nanoseconds(): int =
        linuxMonotonicNanosecondsWithBuffer(this.timestamp)

    // Sleeps using the clock's scratch buffers and returns false for an invalid duration, unusable buffer, or system error.
    fun sleepNanoseconds(nanoseconds: int): bool =
        linuxSleepNanosecondsWithBuffers(
            nanoseconds,
            this.requested,
            this.remaining
        )

    // Closes all scratch buffers owned by the clock.
    fun drop(): void {
        this.timestamp.close()
        this.requested.close()
        this.remaining.close()
        return
    }
}

// Returns a monotonic clock with reusable buffers for time reads and sleeps.
fun linuxMonotonicClock(): LinuxMonotonicClock = LinuxMonotonicClock(
    nativeByteBuffer(16),
    nativeByteBuffer(16),
    nativeByteBuffer(16)
)

// Ambient providers used by the compiler stay on the same libc-free syscall
// layer as ordinary Abla programs. These helpers expose values, while compile
// capability policy remains the compiler evaluator's responsibility.
fun linuxMonotonicNanoseconds(): int = linuxClockNanosecondsOnStack(1)

private noescape extern:"intrinsic" fun ablaUnsafeCallAddressPointerPointer(address: int, first: i64*, second: i64*): int

// The vDSO's clock_gettime once looked up, in one static 64-bit word: 0 not yet, -1 none (the system call is used), else its
// address. Not a `var`, which a thread could not reach (as linuxHostWindowsCell). Every thread finds the same answer, so a race
// only looks it up twice.
private trusted fun linuxClockVdsoCell(): i64* = nativePointerFromAddress(nativeStaticAllocate(8))

/** The address of the kernel's vDSO clock_gettime (__vdso_clock_gettime at LINUX_2.6 on x86-64, __kernel_clock_gettime at
 *  LINUX_2.6.39 on AArch64), or 0 where there is none to use: at compile time (the evaluator and the compile-time JIT read
 *  the clock by the system call), in a program that does not own its start (the auxiliary vector is found after the
 *  environment only then), on other targets, and where the kernel maps no vDSO or it lacks the symbol (seccomp sandboxes,
 *  qemu-user). Looked up once. */
trusted fun linuxClockVdsoAddress(): int {
    if (ablaAtCompileTime()) return 0
    val cell = linuxClockVdsoCell()
    var known = ablaUnsafeLoadI64(cell)
    if (known == 0) {
        known = linuxVdsoLookup()
        if (known == 0) known = -1
        ablaUnsafeStoreI64(cell, known)
    }
    if (known > 0) known else 0
}

// The vDSO image from the auxiliary vector's AT_SYSINFO_EHDR (33), then its clock_gettime: 0 when either is missing.
private trusted fun linuxVdsoLookup(): int {
    val arch = ablaSimdTargetArch()
    if ((arch != 1 && arch != 2) || ablaHostIsMacOS() || ablaHostIsIOS() || !ablaHostOwnsRuntime() || linuxHostIsWindows()) return 0
    var cursor = nativePointerAddress(ablaLinuxEnvironmentPointer())
    if (cursor == 0) return 0
    while (linuxLoadI64(cursor) != 0) cursor = cursor + 8
    cursor = cursor + 8
    var base = 0
    var type = linuxLoadI64(cursor)
    while (type != 0) {
        if (type == 33) base = linuxLoadI64(cursor + 8)
        cursor = cursor + 16
        type = linuxLoadI64(cursor)
    }
    if (base == 0 || (base & 4095) != 0) return 0
    if (arch == 1) linuxVdsoSymbol(base, "__vdso_clock_gettime", "LINUX_2.6")
    else linuxVdsoSymbol(base, "__kernel_clock_gettime", "LINUX_2.6.39")
}

private trusted fun linuxLoadI64(address: int): int = ablaUnsafeLoadI64(nativePointerFromAddress(address))
private trusted fun linuxLoadU32(address: int): int = ablaUnsafeLoadU32(nativePointerFromAddress(address))
private trusted fun linuxLoadU16(address: int): int = ablaUnsafeLoadU16(nativePointerFromAddress(address))
private trusted fun linuxLoadU8(address: int): int = ablaUnsafeLoadU8(nativePointerFromAddress(address))

// Whether the NUL-terminated string at `address` is `name` (the vDSO's string table: names of a few dozen bytes).
private trusted fun linuxVdsoNameIs(address: int, name: string): bool {
    var index = 0
    while (index < name.size) {
        if (linuxLoadU8(address + index) != name[index]) return false
        index = index + 1
    }
    linuxLoadU8(address + index) == 0
}

/** The address of the function `name` at version `version` in the vDSO image at `base` (a 64-bit ELF shared object the
 *  kernel maps), as the kernel's own parse_vdso.c finds it: the load bias from the first PT_LOAD, the dynamic section's
 *  symbol, string, hash and version tables, then a defined global or weak function of that name whose version (when the
 *  image has versions) is `version`. 0 when the image is not what is expected or has no such function. */
private trusted fun linuxVdsoSymbol(base: int, name: string, version: string): int {
    // ELF magic, ELFCLASS64, little endian, ET_DYN.
    if (linuxLoadU32(base) != 1179403647 || linuxLoadU8(base + 4) != 2 || linuxLoadU8(base + 5) != 1 ||
        linuxLoadU16(base + 16) != 3) return 0
    val programHeaders = base + linuxLoadI64(base + 32)
    val entrySize = linuxLoadU16(base + 54)
    val count = linuxLoadU16(base + 56)
    if (entrySize < 56 || count == 0 || count > 64) return 0
    var bias = 0
    var biasKnown = false
    var dynamic = 0
    var index = 0
    while (index < count) {
        val header = programHeaders + index * entrySize
        val kind = linuxLoadU32(header)
        if (kind == 1 && !biasKnown) {
            // PT_LOAD: where the image's addresses land (p_offset - p_vaddr from the base).
            bias = base + linuxLoadI64(header + 8) - linuxLoadI64(header + 16)
            biasKnown = true
        } else if (kind == 2) dynamic = linuxLoadI64(header + 16)
        index = index + 1
    }
    if (!biasKnown || dynamic == 0) return 0
    var symbols = 0
    var strings = 0
    var hash = 0
    var gnuHash = 0
    var versions = 0
    var definitions = 0
    var entry = bias + dynamic
    var tag = linuxLoadI64(entry)
    var guard = 0
    while (tag != 0 && guard < 256) {
        val value = linuxLoadI64(entry + 8)
        if (tag == 6) symbols = bias + value
        else if (tag == 5) strings = bias + value
        else if (tag == 4) hash = bias + value
        else if (tag == 1879047925) gnuHash = bias + value
        else if (tag == 1879048176) versions = bias + value
        else if (tag == 1879048188) definitions = bias + value
        entry = entry + 16
        tag = linuxLoadI64(entry)
        guard = guard + 1
    }
    if (symbols == 0 || strings == 0) return 0
    val symbolCount = if (hash != 0) linuxLoadU32(hash + 4) else if (gnuHash != 0) linuxVdsoGnuHashCount(gnuHash) else 0
    if (symbolCount <= 0 || symbolCount > 4096) return 0
    // Without version tables any version is taken, as parse_vdso.c does.
    val versionIndex = if (versions != 0 && definitions != 0) linuxVdsoVersionIndex(definitions, strings, version) else -1
    if (versions != 0 && definitions != 0 && versionIndex < 0) return 0
    var symbol = 0
    while (symbol < symbolCount) {
        val record = symbols + symbol * 24
        val information = linuxLoadU8(record + 4)
        val binding = information >> 4
        // STT_FUNC, STB_GLOBAL or STB_WEAK, defined (st_shndx not SHN_UNDEF).
        if ((information & 15) == 2 && (binding == 1 || binding == 2) && linuxLoadU16(record + 6) != 0 &&
            linuxVdsoNameIs(strings + linuxLoadU32(record), name) &&
            (versionIndex < 0 || (linuxLoadU16(versions + symbol * 2) & 32767) == versionIndex)) {
            val value = linuxLoadI64(record + 8)
            return if (value != 0) bias + value else 0
        }
        symbol = symbol + 1
    }
    0
}

// The index (vd_ndx) of the version definition named `version` in the image's Elf64_Verdef list, or -1.
private trusted fun linuxVdsoVersionIndex(definitions: int, strings: int, version: string): int {
    var definition = definitions
    var guard = 0
    while (guard < 64) {
        // vd_version 0, vd_flags 2, vd_ndx 4, vd_cnt 6, vd_hash 8, vd_aux 12, vd_next 16; the first aux names it (vda_name 0).
        val flags = linuxLoadU16(definition + 2)
        val auxiliary = definition + linuxLoadU32(definition + 12)
        // VER_FLG_BASE (1) is the file's own name, not a version.
        if ((flags & 1) == 0 && linuxVdsoNameIs(strings + linuxLoadU32(auxiliary), version)) return linuxLoadU16(definition + 4) & 32767
        val next = linuxLoadU32(definition + 16)
        if (next == 0) return -1
        definition = definition + next
        guard = guard + 1
    }
    -1
}

// The symbol count of a DT_GNU_HASH table (an image without DT_HASH): one past the last symbol any bucket's chain reaches.
private trusted fun linuxVdsoGnuHashCount(table: int): int {
    val buckets = linuxLoadU32(table)
    val offset = linuxLoadU32(table + 4)
    val bloomWords = linuxLoadU32(table + 8)
    if (buckets == 0 || buckets > 4096 || bloomWords > 4096) return 0
    val bucketBase = table + 16 + bloomWords * 8
    val chains = bucketBase + buckets * 4
    var last = 0
    var bucket = 0
    while (bucket < buckets) {
        val start = linuxLoadU32(bucketBase + bucket * 4)
        if (start > last) last = start
        bucket = bucket + 1
    }
    if (last < offset) return offset
    var guard = 0
    while ((linuxLoadU32(chains + (last - offset) * 4) & 1) == 0 && guard < 4096) {
        last = last + 1
        guard = guard + 1
    }
    last + 1
}

// clock_gettime of `clock` into 16 bytes of this frame's stack, in nanoseconds, or 0 when it fails (as
// linuxClockNanosecondsWithBuffer). An event server reads the clock every pass: a heap buffer allocated and freed
// for each read, and its checked stores and loads, were most of the read's instructions.
private trusted fun linuxClockNanosecondsOnStack(clock: int): int =
    linuxClockNanosecondsThrough(clock, linuxClockVdsoAddress())

/** The nanoseconds of `clock` (0 CLOCK_REALTIME, 1 CLOCK_MONOTONIC) read through the kernel's vDSO clock_gettime at
 *  `vdso` (linuxClockVdsoAddress), or by the clock_gettime system call when `vdso` is 0; 0 when the read fails or the
 *  answer is out of range. Both ways give the same clock: the vDSO reads the kernel's time pages without entering the
 *  kernel, and falls back to the system call itself for a clock it cannot read there. */
trusted fun linuxClockNanosecondsThrough(clock: int, vdso: int): int {
    val timestamp = nativeStackAllocate(16)
    ablaUnsafeStoreI64(nativePointerFromAddress(timestamp), 0)
    ablaUnsafeStoreI64(nativePointerFromAddress(timestamp + 8), 0)
    var result = 0
    // The vDSO function returns a C int: only the low 32 bits of the register are its answer.
    val status = if (vdso != 0) ablaUnsafeCallAddressPointerPointer(
        vdso, nativePointerFromAddress(clock), nativePointerFromAddress(timestamp)
    ) & 4294967295 else linuxSyscall2(228, clock, timestamp)
    if (status == 0) {
        val seconds = ablaUnsafeLoadI64(nativePointerFromAddress(timestamp))
        val nanoseconds = ablaUnsafeLoadI64(nativePointerFromAddress(timestamp + 8))
        if (seconds >= 0 && seconds <= 9223372035 &&
            nanoseconds >= 0 && nanoseconds < 1000000000 &&
            seconds <= (9223372036854775807 - nanoseconds) / 1000000000) {
            result = seconds * 1000000000 + nanoseconds
        }
    }
    result
}

// Returns a monotonic timestamp in whole milliseconds, or zero if the clock read fails.
fun linuxMonotonicMilliseconds(): int =
    linuxMonotonicNanoseconds() / 1000000

// Wall-clock time: nanoseconds since 1970-01-01T00:00:00Z.
fun linuxRealtimeNanoseconds(): int = linuxClockNanosecondsOnStack(0)

// Returns a random value below `maxExclusive`, or zero for a nonpositive bound or a failed random read.
trusted fun linuxRandomInteger(maxExclusive: int): int {
    var result = 0
    if (maxExclusive > 0) {
        val bytes = nativeByteBuffer(8)
        val status = linuxSyscall3(
            318,
            nativePointerAddress(bytes.address),
            8,
            0
        )
        if (status == 8) {
            // Seven bytes keep the accumulator positive on a signed i64.
            var index = 0
            while (index < 7) {
                result = result * 256 + bytes.load(index)
                index = index + 1
            }
            result = result - result / maxExclusive * maxExclusive
        }
        bytes.close()
    }
    result
}

// A close-on-exec pipe used for data, the start barrier and exec failure reports.
class LinuxPipelinePipe(val input: int, val output: int)

private trusted fun linuxPipelineSafeDescriptor(descriptor: int): int {
    if (descriptor >= 3) return descriptor
    val replacement = linuxSyscall3(72, descriptor, 0, 3) // F_DUPFD
    linuxSyscall1(3, descriptor)
    if (replacement < 0) return -1
    if (linuxSyscall3(72, replacement, 2, 1) < 0) { // F_SETFD, FD_CLOEXEC
        linuxSyscall1(3, replacement)
        return -1
    }
    replacement
}

private trusted fun linuxPipelinePipe(): LinuxPipelinePipe {
    val descriptors = nativeByteBuffer(8)
    val status = linuxSyscall2(293, nativePointerAddress(descriptors.address), 524288)
    var input = -1
    var output = -1
    if (status == 0) {
        input = descriptors.load(0) + descriptors.load(1) * 256 +
            descriptors.load(2) * 65536 + descriptors.load(3) * 16777216
        output = descriptors.load(4) + descriptors.load(5) * 256 +
            descriptors.load(6) * 65536 + descriptors.load(7) * 16777216
        input = linuxPipelineSafeDescriptor(input)
        output = linuxPipelineSafeDescriptor(output)
        if (input < 0 || output < 0) {
            if (input >= 0) linuxSyscall1(3, input)
            if (output >= 0) linuxSyscall1(3, output)
            input = -1
            output = -1
        }
    }
    descriptors.close()
    LinuxPipelinePipe(input, output)
}

private trusted fun linuxPipelineClose(descriptor: int): void {
    if (descriptor >= 0) linuxSyscall1(3, descriptor)
}

private trusted fun linuxPipelineRead(descriptor: int, maximum: int): string {
    val buffer = nativeByteBuffer(maximum + 1)
    var amount = linuxSyscall3(0, descriptor, nativePointerAddress(buffer.address), maximum)
    while (amount == -4) amount = linuxSyscall3(0, descriptor, nativePointerAddress(buffer.address),
        maximum)
    if (amount < 0) {
        buffer.close()
        return ""
    }
    linuxExactString(buffer, amount, maximum + 1)
}

private trusted fun linuxPipelineWait(process: int): int {
    val status = nativeByteBuffer(8)
    status.storeI64(0, 0)
    var waited = linuxSyscall4(61, process, nativePointerAddress(status.address), 0, 0)
    while (waited == -4) waited = linuxSyscall4(61, process, nativePointerAddress(status.address),
        0, 0)
    val result = if (waited == process) linuxDecodeWaitStatus(status.loadI64(0)) else -1
    status.close()
    result
}

/** A private copy prevents later mutations to a Command changing a pipeline. */
fun LinuxCommand.snapshot(): LinuxCommand {
    val arguments: array<string> = []
    val overrides: array<string> = []
    val removed: array<string> = []
    for (value in this.arguments) arguments.append(value)
    for (value in this.overrides) overrides.append(value)
    for (value in this.removed) removed.append(value)
    LinuxCommand(arguments, overrides, this.workingDirectory, this.inputPath,
        this.outputPath, this.errorPath, removed)
}

// Holds the ordered child statuses, captured streams, and any launch failure from a pipeline.
class LinuxPipelineResult(
    val statuses: array<int>,
    val output: string,
    val errors: string,
    val launchError: string,
    val status: int
) {
    // Returns true if the pipeline launched at least one child with no launch error and every child exited successfully.
    fun allSucceeded(): bool {
        if (this.launchError != "" || this.statuses.size == 0) return false
        for (status in this.statuses) if (status != 0) return false
        true
    }
}

// Tracks the running children and capture descriptors until the pipeline result is collected.
class LinuxRunningPipeline(
    val processes: array<int>,
    val group: int,
    val outputDescriptor: int,
    val errorDescriptor: int,
    val launchError: string,
    var result: LinuxPipelineResult? = null
)

// Restore SIGPIPE for programs, even when the caller ignores or blocks it.
// `action` is a zeroed kernel sigaction (32 bytes: handler SIG_DFL, no flags or mask) and
// `unblock` a signal set holding SIGPIPE, both made before the fork so that the child
// allocates nothing. Targets without direct system calls use libc signal().
private trusted fun linuxPipelineResetSigpipe(action: NativeByteBuffer, unblock: NativeByteBuffer): void {
    if (ablaHostOwnsRuntime()) linuxSyscall4(13, 13,
        nativePointerAddress(action.address), 0, 8)
    else signal(13, nativeNullPointer())
    linuxSyscall4(14, 1, nativePointerAddress(unblock.address), 0, 8)
    return
}

private fun linuxPipelineConflict(commands: array<LinuxCommand>, capture: bool,
    errors: bool): string {
    if (commands.size == 0) return "empty pipeline"
    var index = 0
    while (index < commands.size) {
        val command = commands[index]
        if (index > 0 && command.inputPath != "") return "pipeline input conflicts with redirect"
        if (index + 1 < commands.size && command.outputPath !=
            "") return "pipeline output conflicts with redirect"
        if (capture && index + 1 == commands.size && command.outputPath !=
            "") return "capture output conflicts with redirect"
        if (errors && command.errorPath != "") return "capture stderr conflicts with redirect"
        index = index + 1
    }
    ""
}

// The parent and each child close every unused pipe end. The barrier keeps the
// first child alive until all stages have joined its process group.
trusted fun linuxPipelineStart(commands: array<LinuxCommand>, grouped: bool, capture: bool,
    captureErrors: bool): LinuxRunningPipeline {
    val processes: array<int> = []
    val pipes: array<LinuxPipelinePipe> = []
    val reports: array<LinuxPipelinePipe> = []
    var problem = linuxPipelineConflict(commands, capture, captureErrors)
    var index = 1
    while (problem == "" && index < commands.size) {
        val pipe = linuxPipelinePipe()
        if (pipe.input < 0) problem = "pipe failed" else pipes.append(pipe)
        index = index + 1
    }
    val stdout = if (problem == "" && capture) linuxPipelinePipe() else LinuxPipelinePipe(-1, -1)
    if (capture && stdout.input < 0 && problem == "") problem = "stdout pipe failed"
    val stderr = if (problem == "" && captureErrors) linuxPipelinePipe() else LinuxPipelinePipe(-1,
        -1)
    if (captureErrors && stderr.input < 0 && problem == "") problem = "stderr pipe failed"
    val barrier = if (problem == "" && grouped) linuxPipelinePipe() else LinuxPipelinePipe(-1, -1)
    if (grouped && barrier.input < 0 && problem == "") problem = "barrier pipe failed"
    index = 0
    while (problem == "" && index < commands.size) {
        val report = linuxPipelinePipe()
        if (report.input < 0) problem = "exec report pipe failed" else reports.append(report)
        index = index + 1
    }
    var group = -1
    // What the children use, made before the first fork.
    val resetAction = nativeByteBuffer(32)
    resetAction.storeI64(0, 0)
    resetAction.storeI64(8, 0)
    resetAction.storeI64(16, 0)
    resetAction.storeI64(24, 0)
    val unblockSet = nativeByteBuffer(8)
    unblockSet.storeI64(0, 4096)
    val barrierRead = nativeByteBuffer(8)
    index = 0
    while (problem == "" && index < commands.size) {
        val command = commands[index]
        val executable = if (command.arguments.size >
            0) linuxExecutablePath(command.arguments[0]) else ""
        val vector = linuxArgumentVector(command.arguments)
        val environment = command.environmentVector()
        val strings = command.execStrings(executable)
        val addresses = if (executable !=
            "") command.execAddresses(strings) else LinuxExecAddresses(0, 0, 0, 0, 0)
        val windows = linuxIsWindows()
        var process = 0
        if (windows) {
            // no fork: the stage is spawned with its pipe ends as its standard streams (the other ends are not inherited)
            val inputEnd = if (index > 0) pipes[index - 1].input else -1
            val outputEnd = if (index + 1 < commands.size) pipes[index].output else if (capture) stdout.output else -1
            val errorEnd = if (captureErrors) stderr.output else -1
            if (addresses.executable == 0) process = -2
            else process = linuxWindowsSpawn(addresses, vector, environment, inputEnd, outputEnd, errorEnd, 0)
            if (process < 0) problem = "stage $index failed to start"
        } else process = linuxFork()
        if (process == 0 && !windows) {
            var ready = true
            if (grouped) ready = linuxChildSetProcessGroup(if (group < 0) 0 else group) == 0
            if (index > 0 && linuxSyscall2(33, pipes[index - 1].input, 0) < 0) ready = false
            if (index + 1 < commands.size) {
                if (linuxSyscall2(33, pipes[index].output, 1) < 0) ready = false
            } else if (capture && linuxSyscall2(33, stdout.output, 1) < 0) ready = false
            if (captureErrors && linuxSyscall2(33, stderr.output, 2) < 0) ready = false
            var closing = 0
            while (closing < pipes.size) {
                linuxPipelineClose(pipes[closing].input)
                linuxPipelineClose(pipes[closing].output)
                closing = closing + 1
            }
            linuxPipelineClose(stdout.input)
            linuxPipelineClose(stdout.output)
            linuxPipelineClose(stderr.input)
            linuxPipelineClose(stderr.output)
            var reportIndex = 0
            while (reportIndex < reports.size) {
                linuxPipelineClose(reports[reportIndex].input)
                if (reportIndex != index) linuxPipelineClose(reports[reportIndex].output)
                reportIndex = reportIndex + 1
            }
            if (grouped) {
                linuxPipelineClose(barrier.output)
                // Blocks until the parent closes the barrier (read returns 0).
                var waited = linuxSyscall3(0, barrier.input,
                    nativePointerAddress(barrierRead.address), 1)
                while (waited == -4) waited = linuxSyscall3(0, barrier.input,
                    nativePointerAddress(barrierRead.address), 1)
                linuxPipelineClose(barrier.input)
            }
            linuxPipelineResetSigpipe(resetAction, unblockSet)
            if (ready && addresses.executable != 0) command.execPrepared(addresses, vector,
                environment)
            linuxWrite(reports[index].output, "x")
            linuxSyscall1(60, 127)
        }
        environment.close()
        vector.close()
        strings.close()
        if (process < 0) {
            if (problem == "") problem = "fork failed"
        } else {
            processes.append(process)
            if (grouped) {
                if (group < 0) group = process
                linuxSyscall2(109, process, group)
            }
        }
        index = index + 1
    }
    resetAction.close()
    unblockSet.close()
    barrierRead.close()
    for (pipe in pipes) { linuxPipelineClose(pipe.input); linuxPipelineClose(pipe.output) }
    linuxPipelineClose(stdout.output)
    linuxPipelineClose(stderr.output)
    linuxPipelineClose(barrier.input)
    linuxPipelineClose(barrier.output)
    for (report in reports) linuxPipelineClose(report.output)
    if (problem != "") {
        for (process in processes) linuxSyscall2(62, process, 9)
        for (process in processes) linuxPipelineWait(process)
        for (report in reports) linuxPipelineClose(report.input)
        linuxPipelineClose(stdout.input)
        linuxPipelineClose(stderr.input)
        return LinuxRunningPipeline([], -1, -1, -1, problem)
    }
    val failedStages: array<int> = []
    index = 0
    while (index < reports.size) {
        val report = linuxPipelineRead(reports[index].input, 1)
        linuxPipelineClose(reports[index].input)
        if (report != "") {
            failedStages.append(index)
            if (problem == "") problem = "stage $index failed to start"
        }
        index = index + 1
    }
    if (problem != "") {
        var stage = 0
        while (stage < processes.size) {
            var failed = false
            for (item in failedStages) if (item == stage) failed = true
            if (!failed) linuxSyscall2(62, processes[stage], 9)
            stage = stage + 1
        }
    }
    LinuxRunningPipeline(processes, group, stdout.input, stderr.input, problem)
}

// Drain both streams concurrently. A child can fill either pipe before the
// other, so reading one to EOF first can deadlock.
private trusted fun linuxPipelineDrain(output: int, errors: int): array<string> {
    val text = byteBuffer()
    val errorText = byteBuffer()
    val poll = nativeByteBuffer(16)
    var first = output
    var second = errors
    while (first >= 0 || second >= 0) {
        poll.storeI64(0, first + 4294967296)
        poll.storeI64(8, second + 4294967296)
        val ready = linuxSyscall3(7, nativePointerAddress(poll.address), 2, -1)
        if (ready < 0 && ready != -4) {
            linuxPipelineClose(first)
            linuxPipelineClose(second)
            first = -1
            second = -1
        } else if (ready > 0) {
            if (first >= 0 && (poll.load(6) != 0 || poll.load(7) != 0)) {
                val chunk = linuxPipelineRead(first, 65536)
                if (chunk == "") { linuxPipelineClose(first); first = -1 }
                else text.appendText(chunk)
            }
            if (second >= 0 && (poll.load(14) != 0 || poll.load(15) != 0)) {
                val chunk = linuxPipelineRead(second, 65536)
                if (chunk == "") { linuxPipelineClose(second); second = -1 }
                else errorText.appendText(chunk)
            }
        }
    }
    poll.close()
    [text.toText(), errorText.toText()]
}

// Drains captured streams and returns the child statuses and any launch error, reusing the result on later calls.
fun LinuxRunningPipeline.wait(): LinuxPipelineResult {
    val previous = this.result
    if (previous != null) return previous
    val captured = linuxPipelineDrain(this.outputDescriptor, this.errorDescriptor)
    val statuses: array<int> = []
    for (process in this.processes) statuses.append(linuxPipelineWait(process))
    val status = if (statuses.size == 0) -1 else statuses[statuses.size - 1]
    val result = LinuxPipelineResult(statuses, captured[0], captured[1], this.launchError, status)
    this.result = result
    result
}

// Signals the process group when present, waits for completion, and returns the same result as `wait`.
trusted fun LinuxRunningPipeline.stop(graceMilliseconds: int = 5000): LinuxPipelineResult {
    val previous = this.result
    if (previous != null) return previous
    if (this.group > 0) {
        linuxSyscall2(62, 0 - this.group, 15)
        linuxSleepMillisecondsChecked(graceMilliseconds)
        linuxSyscall2(62, 0 - this.group, 9)
    }
    this.wait()
}

// linuxStartConfiguredProcess on Windows: the environment overrides are built into the child's environment (there is no `env` to
// launch), the output path takes standard output and error, and the child has a process group of its own (as always on Windows).
private fun linuxWindowsStartConfigured(
    directory: string,
    arguments: array<string>,
    environmentNames: array<string>,
    environmentValues: array<string>,
    outputPath: string
): LinuxChildProcess {
    var process = -1
    if (arguments.size > 0 && environmentNames.size == environmentValues.size) {
        val command = linuxCommand(arguments[0])
        var index = 1
        while (index < arguments.size) {
            command.argument(arguments[index])
            index = index + 1
        }
        index = 0
        while (index < environmentNames.size) {
            command.environment(environmentNames[index], environmentValues[index])
            index = index + 1
        }
        if (directory != "") command.directory(directory)
        if (outputPath != "") command.output(outputPath)
        val strings = command.execStrings(linuxExecutablePath(arguments[0]))
        val addresses = command.execAddresses(strings)
        val vector = linuxArgumentVector(command.arguments)
        val environment = command.environmentVector()
        process = linuxWindowsSpawn(addresses, vector, environment, -1, -1, -1, if (outputPath != "") 1 else 0)
        environment.close()
        vector.close()
        strings.close()
    }
    LinuxChildProcess(process)
}
