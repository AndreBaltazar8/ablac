// Opt-in Linux x86-64 raw syscalls. Portable application code should prefer
// abla/fs, abla/net, and abla/process; this module deliberately exposes kernel
// return values (negative errno on failure) and bypasses libc.

#import("abla/unsafe/memory")

noescape extern:"intrinsic" fun ablaLinuxSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int

fun linuxSyscall0(number: int): int =
    ablaLinuxSyscall(number, 0, 0, 0, 0, 0, 0)

fun linuxSyscall1(number: int, argument0: int): int =
    ablaLinuxSyscall(number, argument0, 0, 0, 0, 0, 0)

fun linuxSyscall2(number: int, argument0: int, argument1: int): int =
    ablaLinuxSyscall(number, argument0, argument1, 0, 0, 0, 0)

fun linuxSyscall3(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    0,
    0,
    0
)

fun linuxSyscall4(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    argument3,
    0,
    0
)

fun linuxSyscall5(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    argument3,
    argument4,
    0
)

fun linuxSyscall6(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    argument3,
    argument4,
    argument5
)

class LinuxFileDescriptor(val descriptor: int)

fun linuxWrite(descriptor: int, text: string): int = linuxSyscall3(
    1,
    descriptor,
    nativeCStringAddress(text),
    text.size
)

fun linuxWriteStandardOutput(text: string): int = linuxWrite(1, text)

fun linuxWriteStandardError(text: string): int = linuxWrite(2, text)

fun linuxOpen(path: string, flags: int = 0, mode: int = 0): LinuxFileDescriptor =
    LinuxFileDescriptor(linuxSyscall4(
        257,
        -100,
        nativeCStringAddress(path),
        flags,
        mode
    ))

fun LinuxFileDescriptor.write(text: string): int =
    linuxWrite(this.descriptor, text)

fun LinuxFileDescriptor.read(maximum: int = 65536): string {
    val buffer = nativeByteBuffer(maximum + 1)
    val measured = linuxSyscall3(
        0,
        this.descriptor,
        nativePointerAddress(buffer.address),
        maximum
    )
    var result = ""
    if (measured >= 0) result = buffer.adoptString(measured)
    if (measured < 0) buffer.close()
    result
}

fun LinuxFileDescriptor.close(): int = linuxSyscall1(3, this.descriptor)

fun linuxProcessId(): int = linuxSyscall0(39)

fun linuxReadFile(path: string, maximum: int = 1048576): string {
    val file = linuxOpen(path)
    var result = ""
    if (file.descriptor >= 0) {
        result = file.read(maximum)
        file.close()
    }
    result
}
