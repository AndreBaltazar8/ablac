// Opt-in Linux x86-64 raw syscalls. Portable application code should prefer
// abla/fs, abla/net, and abla/process; this module deliberately exposes kernel
// return values (negative errno on failure) and bypasses libc.

import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// Invokes a Linux-numbered system call through the host adapter and returns its kernel result or a negative errno.
noescape extern:"intrinsic" fun ablaLinuxSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int

// Invokes syscall `number` without arguments. Returns the kernel result, with negative errno on failure.
fun linuxSyscall0(number: int): int =
    ablaLinuxSyscall(number, 0, 0, 0, 0, 0, 0)

// Invokes syscall `number` with `argument0`. Returns the kernel result, with negative errno on failure.
fun linuxSyscall1(number: int, argument0: int): int =
    ablaLinuxSyscall(number, argument0, 0, 0, 0, 0, 0)

// linuxHostIsWindows's answer, in one static 32-bit word (0 until asked, then 1 on Windows, 2 elsewhere): not a `var`, which a
// thread could not reach and which keeps compile-time code that reaches it in the evaluator. Racing threads store the same value.
private trusted fun linuxHostWindowsCell(): i64* = nativePointerFromAddress(nativeStaticAllocate(4))

/** Reports whether the program runs on Windows, where the hosted runtime translates these Linux calls: found out once, by the
 *  Windows runtime's own call 4001 (spawn), which answers a null block with EINVAL where every other target answers ENOSYS. (A
 *  compiler intrinsic would say it at compile time; the pinned bootstrap compiler does not know one yet.) */
trusted fun linuxHostIsWindows(): bool {
    val cell = linuxHostWindowsCell()
    var known = ablaUnsafeLoadU32(cell)
    if (known == 0) {
        known = if (linuxSyscall1(4001, 0) == -22) 1 else 2
        ablaUnsafeStoreU32(cell, known)
    }
    known == 1
}

// Invokes syscall `number` with `argument0` through `argument1`. Returns the kernel result, with negative errno on failure.
fun linuxSyscall2(number: int, argument0: int, argument1: int): int =
    ablaLinuxSyscall(number, argument0, argument1, 0, 0, 0, 0)

// Invokes syscall `number` with `argument0` through `argument2`. Returns the kernel result, with negative errno on failure.
fun linuxSyscall3(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    0,
    0,
    0
)

// Invokes syscall `number` with `argument0` through `argument3`. Returns the kernel result, with negative errno on failure.
fun linuxSyscall4(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    argument3,
    0,
    0
)

// Invokes syscall `number` with `argument0` through `argument4`. Returns the kernel result, with negative errno on failure.
fun linuxSyscall5(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    argument3,
    argument4,
    0
)

// Invokes syscall `number` with `argument0` through `argument5`. Returns the kernel result, with negative errno on failure.
fun linuxSyscall6(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int = ablaLinuxSyscall(
    number,
    argument0,
    argument1,
    argument2,
    argument3,
    argument4,
    argument5
)

// Stores a raw file descriptor or a negative error code. Call close explicitly to release an open descriptor.
class LinuxFileDescriptor(val descriptor: int)

// Attempts one write of `text` to `descriptor`. Returns bytes written, which can be fewer than requested, or negative errno.
fun linuxWrite(descriptor: int, text: string): int = linuxSyscall3(
    1,
    descriptor,
    nativeStringDataAddress(text),
    text.size
)

// Writes to standard output and returns the byte count, which may be short, or a negative errno.
fun linuxWriteStandardOutput(text: string): int = linuxWrite(1, text)

// Writes to standard error and returns the byte count, which may be short, or a negative errno.
fun linuxWriteStandardError(text: string): int = linuxWrite(2, text)

// Opens `path` relative to the working directory using kernel `flags`. `mode` supplies the creation permissions when requested by the flags. Returns a descriptor or a negative errno in the wrapper.
fun linuxOpen(path: string, flags: int = 0, mode: int = 0): LinuxFileDescriptor =
    LinuxFileDescriptor(linuxSyscall4(
        257,
        -100,
        nativeCStringAddress(path),
        flags,
        mode
    ))

// Attempts one write of `text`. Returns bytes written or negative errno. A short write does not consume the remaining bytes.
fun LinuxFileDescriptor.write(text: string): int =
    linuxWrite(this.descriptor, text)

// The first `length` bytes of `buffer` as a string that holds no more memory than that: the buffer itself when the read filled over half of it, else a copy
// (adoptString keeps the whole allocation alive for as long as the string lives, so a 9-byte file read with a 4 MB limit held 4 MB).
fun linuxExactString(var buffer: NativeByteBuffer, length: int, capacity: int): string {
    if (length * 2 >= capacity) return buffer.adoptString(length)
    val exact = nativeByteBuffer(length + 1)
    var offset = 0
    while (offset + 8 <= length) {
        exact.storeI64(offset, buffer.loadI64(offset))
        offset = offset + 8
    }
    while (offset < length) {
        exact.store(offset, buffer.load(offset))
        offset = offset + 1
    }
    buffer.close()
    exact.adoptString(length)
}

// Attempts one read of up to `maximum` bytes. Returns the bytes read or an empty string on EOF or error.
fun LinuxFileDescriptor.read(maximum: int = 65536): string {
    val buffer = nativeByteBuffer(maximum + 1)
    val measured = linuxSyscall3(
        0,
        this.descriptor,
        nativePointerAddress(buffer.address),
        maximum
    )
    var result = ""
    if (measured >= 0) result = linuxExactString(buffer, measured, maximum + 1)
    if (measured < 0) buffer.close()
    result
}

// Closes the raw descriptor and returns zero or negative errno. The wrapper retains the descriptor number.
fun LinuxFileDescriptor.close(): int = linuxSyscall1(3, this.descriptor)

// Returns the process ID reported by the kernel.
fun linuxProcessId(): int = linuxSyscall0(39)

// Opens `path`, reads up to `maximum` bytes in one read, and closes it. Returns an empty string on open or read failure or EOF.
fun linuxReadFile(path: string, maximum: int = 1048576): string {
    val file = linuxOpen(path)
    var result = ""
    if (file.descriptor >= 0) {
        result = file.read(maximum)
        file.close()
    }
    result
}
