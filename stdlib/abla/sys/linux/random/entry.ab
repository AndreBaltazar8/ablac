// Linux cryptographic entropy through getrandom(2), with bounded allocation,
// interrupted-call retry, and explicit failure reporting.

import "abla/sys/linux"
import "abla/random/result"
import "abla/simd/target"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// getrandom's number here, or 0 on a target with none (Wasm, Xtensa: abla/crypto/rsa's cryptoSetRandom is the way there).
// The Darwin adapter takes both numbers.
private fun linuxGetrandomNumber(): int =
    if (simdTargetArch() == SIMD_ARCH_X86_64) 318
    else if (simdTargetArch() == SIMD_ARCH_AARCH64) 278
    else 0

fun secureRandomBytes(count: int): SecureRandomResult {
    var result = SecureRandomResult("", false, 22)
    val number = linuxGetrandomNumber()
    // ENOSYS, as the call would answer.
    if (number == 0) result = SecureRandomResult("", false, 38)
    else if (count > 0 && count <= 1048576) {
        val buffer = nativeByteBuffer(count + 1)
        var offset = 0
        var errorCode = 0
        while (offset < count && errorCode == 0) {
            val measured = linuxSyscall3(
                number,
                nativePointerAddress(buffer.address) + offset,
                count - offset,
                0
            )
            if (measured > 0) offset = offset + measured
            else if (measured < 0 && measured != -4) errorCode = -measured
        }
        if (offset == count) {
            result = SecureRandomResult(buffer.adoptString(count), true, 0)
        } else {
            buffer.close()
            result = SecureRandomResult("", false, errorCode)
        }
    }
    result
}
