// Linux cryptographic entropy through getrandom(2), with bounded allocation,
// interrupted-call retry, and explicit failure reporting.

import "abla/sys/linux"
import "abla/random/result"
import "abla/simd/target"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// getrandom's number here, or 0 on a target with none (Xtensa: abla/crypto/rsa's cryptoSetRandom is the way there; Wasm takes the host's source).
// The Darwin adapter takes both numbers. A freestanding AArch64 guest issues the kernel's own number (278); a build
// that owns its runtime on AArch64 (the aarch64-linux executables, the arm64 Android libraries) translates x86-64's
// numbers, where 278 is vmsplice, so it passes 318.
private noescape extern:"intrinsic" fun ablaHostOwnsRuntime(): bool

private fun linuxGetrandomNumber(): int =
    if (simdTargetArch() == SIMD_ARCH_X86_64) 318
    else if (simdTargetArch() == SIMD_ARCH_AARCH64) (if (ablaHostOwnsRuntime()) 318 else 278)
    else if (simdTargetArch() == SIMD_ARCH_OTHER && ablaHostOwnsRuntime()) 318
    // WebAssembly: the runtime's own number, the host's source (random_get on WASI, abla_host.random on the abla_host ABI); a failing host fails the call.
    else if (simdTargetArch() == SIMD_ARCH_WASM) 318
    else 0

// Requests exactly `count` bytes of system entropy, retrying interrupted reads. On failure returns no bytes and a positive system error code. Supported systems accept 1–1048576 bytes per call. An unsupported target returns error 38.
fun secureRandomBytes(count: int): SecureRandomResult {
    var result = SecureRandomResult("", false, 22)
    val number = linuxGetrandomNumber()
    // ENOSYS, as the call would answer.
    if (number == 0) result = SecureRandomResult("", false, 38)
    else if (count > 0 && count <= 1048576) {
        val buffer = nativeByteBuffer(count + 1)
        var offset = 0
        var errorCode = 0
        while (offset < count && errorCode == 0) {
            val measured = linuxSyscall3(
                number,
                nativePointerAddress(buffer.address) + offset,
                count - offset,
                0
            )
            linuxCheckCount(measured, count - offset)
            if (measured > 0) offset = offset + measured
            else if (measured == 0) errorCode = 5 // a call that gives nothing and no error (a host's): EIO, not a loop that never ends
            else if (measured != -4) errorCode = -measured
        }
        if (offset == count) {
            result = SecureRandomResult(buffer.adoptString(count), true, 0)
        } else {
            buffer.close()
            result = SecureRandomResult("", false, errorCode)
        }
    }
    result
}
