// Backend-neutral networking outcomes and cooperative cancellation policy.

class NetworkError(
    val code: int,
    val operation: string,
    val category: string,
    val retryable: bool
) {
    fun present(): bool = this.code != 0
}

class NetworkReadOutcome(
    val bytes: string,
    val state: int,
    val error: NetworkError
) {
    fun hasData(): bool = this.state == 1
    fun reachedEof(): bool = this.state == 2
    fun timedOut(): bool = this.state == 3
    fun cancelled(): bool = this.state == 4
    fun wouldBlock(): bool = this.state == 5
    fun failed(): bool = this.state == 6
}

class NetworkWriteOutcome(
    val written: int,
    val state: int,
    val error: NetworkError
) {
    fun succeeded(): bool = this.state == 1
    fun timedOut(): bool = this.state == 3
    fun cancelled(): bool = this.state == 4
    fun wouldBlock(): bool = this.state == 5
    fun failed(): bool = this.state == 6
}

class NetworkCancellation(val requested: () -> bool)

fun networkNotCancelled(): bool = false

fun networkCancellation(): NetworkCancellation =
    NetworkCancellation(networkNotCancelled)

fun NetworkCancellation.isRequested(): bool {
    val check = this.requested
    check()
}

fun networkError(code: int, operation: string): NetworkError {
    var category = "system"
    var retryable = false
    if (code == 0) category = "none"
    if (code == 4) {
        category = "interrupted"
        retryable = true
    }
    if (code == 11 || code == 35) {
        category = "would-block"
        retryable = true
    }
    if (code == 60 || code == 110) category = "timeout"
    if (code == 54 || code == 104) category = "connection-reset"
    if (code == 61 || code == 111) category = "connection-refused"
    if (code == 32) category = "broken-pipe"
    if (code == 51 || code == 101) category = "network-unreachable"
    if (code == 65 || code == 113) category = "host-unreachable"
    if (code == 89 || code == 125) category = "cancelled"
    NetworkError(code, operation, category, retryable)
}

fun networkNoError(operation: string): NetworkError =
    networkError(0, operation)
