// Backend-neutral networking outcomes and cooperative cancellation policy.

/// Carries a host error code, operation label, portable category and retryable classification.
class NetworkError(
    val code: int,
    val operation: string,
    val category: string,
    val retryable: bool
) {
    /// Returns whether the error code is nonzero.
    fun present(): bool = this.code != 0
}

/// Carries any read bytes and the resulting status and error.
class NetworkReadOutcome(
    val bytes: string,
    val state: int,
    val error: NetworkError
) {
    /// Returns whether the read produced data.
    fun hasData(): bool = this.state == 1
    /// Returns whether the read reached end of stream.
    fun reachedEof(): bool = this.state == 2
    /// Returns whether the read exceeded its deadline.
    fun timedOut(): bool = this.state == 3
    /// Returns whether the read was canceled.
    fun cancelled(): bool = this.state == 4
    /// Returns whether the read would block pending socket readiness.
    fun wouldBlock(): bool = this.state == 5
    /// Returns whether the read failed with a network error.
    fun failed(): bool = this.state == 6
}

/// Carries the byte count written and the resulting status and error.
class NetworkWriteOutcome(
    val written: int,
    val state: int,
    val error: NetworkError
) {
    /// Returns whether the write reported success.
    fun succeeded(): bool = this.state == 1
    /// Returns whether the write exceeded its deadline.
    fun timedOut(): bool = this.state == 3
    /// Returns whether the write was canceled.
    fun cancelled(): bool = this.state == 4
    /// Returns whether the write would block pending socket readiness.
    fun wouldBlock(): bool = this.state == 5
    /// Returns whether the write failed with a network error.
    fun failed(): bool = this.state == 6
}

/// Wraps a callback checked by networking operations for cooperative cancellation.
class NetworkCancellation(val requested: () -> bool)

private fun networkNotCancelled(): bool = false

/// Returns a cancellation token that always reports no request.
fun networkCancellation(): NetworkCancellation =
    NetworkCancellation(networkNotCancelled)

/// Returns the current result of the cancellation callback.
fun NetworkCancellation.isRequested(): bool {
    val check = this.requested
    check()
}

/// Classifies a host error code and attaches the operation label.
fun networkError(code: int, operation: string): NetworkError {
    var category = "system"
    var retryable = false
    if (code == 0) category = "none"
    if (code == 4) {
        category = "interrupted"
        retryable = true
    }
    if (code == 11 || code == 35) {
        category = "would-block"
        retryable = true
    }
    if (code == 60 || code == 110) category = "timeout"
    if (code == 54 || code == 104) category = "connection-reset"
    if (code == 61 || code == 111) category = "connection-refused"
    if (code == 32) category = "broken-pipe"
    if (code == 51 || code == 101) category = "network-unreachable"
    if (code == 65 || code == 113) category = "host-unreachable"
    if (code == 89 || code == 125) category = "cancelled"
    NetworkError(code, operation, category, retryable)
}

/// Returns a zero-code outcome for the given operation.
fun networkNoError(operation: string): NetworkError =
    networkError(0, operation)
