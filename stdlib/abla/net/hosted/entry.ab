// Portable hosted TCP/UDP and readiness adapter. Linux uses epoll; macOS uses
// kqueue behind the narrow host ABI. Applications keep descriptors affine.

import "abla/platform/host"
import "abla/net/contracts"

class HostedSocketReadResult(
    val bytes: string,
    val status: string,
    val errorCode: int
) {
    fun hasData(): bool = this.status == "data"
    fun reachedEof(): bool = this.status == "eof"
    fun wouldBlock(): bool = this.status == "would-block"
    fun failed(): bool = this.status == "error"
}

fun HostedSocketReadResult.networkOutcome(
    operation: string = "read"
): NetworkReadOutcome {
    var state = 6
    if (this.status == "data") state = 1
    if (this.status == "eof") state = 2
    if (this.status == "would-block") state = 5
    NetworkReadOutcome(
        this.bytes,
        state,
        networkError(this.errorCode, operation)
    )
}

class HostedSocketWriteResult(
    val written: int,
    val wouldBlock: bool,
    val errorCode: int
) {
    fun succeeded(): bool = this.written >= 0
    fun failed(): bool = this.written < 0 && !this.wouldBlock
}

fun HostedSocketWriteResult.networkOutcome(
    operation: string = "write"
): NetworkWriteOutcome {
    var state = if (this.written >= 0) 1 else 6
    if (this.wouldBlock) state = 5
    NetworkWriteOutcome(
        this.written,
        state,
        networkError(this.errorCode, operation)
    )
}

class HostedSocketEvent(
    val descriptor: int,
    val readable: bool,
    val writable: bool,
    val closed: bool,
    val error: bool
)

class HostedSocketEvents(
    val events: array<HostedSocketEvent>,
    val timedOut: bool,
    val errorCode: int
) {
    fun failed(): bool = this.errorCode != 0
}

class HostedUdpDatagram(
    val bytes: string,
    val sourceAddress: string,
    val sourcePort: int,
    val received: bool,
    val wouldBlock: bool,
    val errorCode: int
)

resource class HostedTcpListener(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) ablaHostNetClose(this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class HostedTcpConnection(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) ablaHostNetClose(this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class HostedUdpSocket(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) ablaHostNetClose(this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class HostedSocketPoller(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) ablaHostNetClose(this.descriptor)
        this.descriptor = -1
        return
    }
}

fun hostedTcpConnect(
    host: string,
    port: int,
    timeoutMilliseconds: int = 5000
): HostedTcpConnection = HostedTcpConnection(
    ablaHostNetConnect(host, port, timeoutMilliseconds)
)

fun hostedTcpListen(
    host: string = "::",
    port: int = 0,
    backlog: int = 128,
    dualStack: bool = true
): HostedTcpListener = HostedTcpListener(
    ablaHostNetListen(host, port, backlog, dualStack)
)

fun HostedTcpListener.accept(): HostedTcpConnection =
    HostedTcpConnection(ablaHostNetAccept(this.descriptor))

fun HostedTcpListener.localPort(): int =
    ablaHostNetLocalPort(this.descriptor)

fun HostedTcpListener.setNonblocking(enabled: bool = true): bool =
    ablaHostNetSetNonblocking(this.descriptor, enabled)

fun HostedTcpConnection.setNonblocking(enabled: bool = true): bool =
    ablaHostNetSetNonblocking(this.descriptor, enabled)

fun hostedReadResult(descriptor: int, maximum: int): HostedSocketReadResult {
    val bytes = ablaHostNetRead(descriptor, maximum)
    val state = ablaHostNetStatus()
    val error = ablaHostNetError()
    var status = "error"
    if (state == 0) status = "data"
    if (state == 1) status = "eof"
    if (state == 2) status = "would-block"
    HostedSocketReadResult(bytes, status, error)
}

fun HostedTcpConnection.readResult(
    maximum: int = 65536
): HostedSocketReadResult = hostedReadResult(this.descriptor, maximum)

fun HostedTcpConnection.readNetwork(
    maximum: int,
    timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50
): NetworkReadOutcome {
    val started = ablaHostMonotonicMilliseconds()
    var result = NetworkReadOutcome(
        "", 3, networkError(60, "read")
    )
    val poller = hostedSocketPoller()
    var waiting = poller.descriptor >= 0 && this.descriptor >= 0 &&
        timeoutMilliseconds > 0 && cancellationPollMilliseconds > 0 &&
        poller.watchDescriptor(this.descriptor)
    while (waiting && ablaHostMonotonicMilliseconds() - started <
        timeoutMilliseconds) {
        if (cancellation.isRequested()) {
            result = NetworkReadOutcome(
                "", 4, networkError(89, "read")
            )
            waiting = false
        } else {
            var duration = timeoutMilliseconds -
                (ablaHostMonotonicMilliseconds() - started)
            if (duration > cancellationPollMilliseconds) {
                duration = cancellationPollMilliseconds
            }
            val ready = poller.wait(1, duration)
            if (ready.failed()) {
                result = NetworkReadOutcome(
                    "", 6, networkError(ready.errorCode, "poll")
                )
                waiting = false
            } else if (ready.events.size > 0) {
                result = this.readResult(maximum).networkOutcome()
                waiting = false
            }
        }
    }
    poller.close()
    result
}

fun HostedTcpConnection.writeResult(
    contents: string
): HostedSocketWriteResult {
    val written = ablaHostNetWrite(this.descriptor, contents)
    val error = if (written < 0) -written else 0
    HostedSocketWriteResult(
        written,
        error == 11 || error == 35,
        error
    )
}

fun HostedTcpConnection.writeNetwork(
    contents: string,
    timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50
): NetworkWriteOutcome {
    val started = ablaHostMonotonicMilliseconds()
    var offset = 0
    var result = NetworkWriteOutcome(
        0, 3, networkError(60, "write")
    )
    val poller = hostedSocketPoller()
    var writing = poller.descriptor >= 0 && this.descriptor >= 0 &&
        timeoutMilliseconds > 0 && cancellationPollMilliseconds > 0 &&
        poller.watchDescriptor(this.descriptor, false, true)
    if (!writing && this.descriptor < 0) result = NetworkWriteOutcome(
        0, 6, networkError(9, "write")
    )
    while (writing && offset < contents.size &&
        ablaHostMonotonicMilliseconds() - started < timeoutMilliseconds) {
        if (cancellation.isRequested()) {
            result = NetworkWriteOutcome(
                offset, 4, networkError(89, "write")
            )
            writing = false
        } else {
            var duration = timeoutMilliseconds -
                (ablaHostMonotonicMilliseconds() - started)
            if (duration > cancellationPollMilliseconds) {
                duration = cancellationPollMilliseconds
            }
            val ready = poller.wait(1, duration)
            if (ready.failed()) {
                result = NetworkWriteOutcome(
                    offset, 6, networkError(ready.errorCode, "poll")
                )
                writing = false
            } else if (ready.events.size > 0 && ready.events[0].writable) {
                val attempt = this.writeResult(
                    contents.slice(offset, contents.size)
                )
                if (attempt.written > 0) offset = offset + attempt.written
                if (attempt.failed()) {
                    result = NetworkWriteOutcome(
                        offset, 6, networkError(attempt.errorCode, "write")
                    )
                    writing = false
                } else if (offset >= contents.size) {
                    result = NetworkWriteOutcome(
                        offset, 1, networkNoError("write")
                    )
                    writing = false
                }
            }
        }
    }
    poller.close()
    result
}

fun HostedTcpConnection.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = ablaHostNetClose(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun HostedTcpListener.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = ablaHostNetClose(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun hostedUdpBind(
    host: string = "::",
    port: int = 0,
    dualStack: bool = true
): HostedUdpSocket = HostedUdpSocket(
    ablaHostNetUdpBind(host, port, dualStack)
)

fun HostedUdpSocket.localPort(): int =
    ablaHostNetLocalPort(this.descriptor)

fun HostedUdpSocket.setNonblocking(enabled: bool = true): bool =
    ablaHostNetSetNonblocking(this.descriptor, enabled)

fun HostedUdpSocket.sendTo(
    contents: string,
    host: string,
    port: int
): int = ablaHostNetUdpSend(this.descriptor, host, port, contents)

fun HostedUdpSocket.receiveFrom(
    maximum: int = 65535
): HostedUdpDatagram {
    val bytes = ablaHostNetUdpReceive(this.descriptor, maximum)
    val state = ablaHostNetStatus()
    val error = ablaHostNetError()
    HostedUdpDatagram(
        bytes,
        ablaHostNetSourceAddress(),
        ablaHostNetSourcePort(),
        state == 0,
        state == 2,
        error
    )
}

fun HostedUdpSocket.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = ablaHostNetClose(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun hostedSocketPoller(): HostedSocketPoller =
    HostedSocketPoller(ablaHostNetPollerCreate())

fun HostedSocketPoller.watchDescriptor(
    descriptor: int,
    read: bool = true,
    write: bool = false
): bool = ablaHostNetPollerControl(
    this.descriptor, descriptor, read, write, 0
)

fun HostedSocketPoller.modifyDescriptor(
    descriptor: int,
    read: bool = true,
    write: bool = false
): bool = ablaHostNetPollerControl(
    this.descriptor, descriptor, read, write, 1
)

fun HostedSocketPoller.unwatchDescriptor(descriptor: int): bool =
    ablaHostNetPollerControl(
        this.descriptor, descriptor, false, false, 2
    )

fun hostedNetReadU32(bytes: string, offset: int): int =
    bytes[offset] + bytes[offset + 1] * 256 +
    bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216

fun HostedSocketPoller.wait(
    maximumEvents: int = 64,
    timeoutMilliseconds: int = 5000
): HostedSocketEvents {
    val encoded = ablaHostNetPollerWait(
        this.descriptor, maximumEvents, timeoutMilliseconds
    )
    val error = ablaHostNetError()
    val events: array<HostedSocketEvent> = []
    var offset = 0
    while (offset + 8 <= encoded.size) {
        val flags = hostedNetReadU32(encoded, offset + 4)
        events.append(HostedSocketEvent(
            hostedNetReadU32(encoded, offset),
            (flags & 1) != 0,
            (flags & 2) != 0,
            (flags & 4) != 0,
            (flags & 8) != 0
        ))
        offset = offset + 8
    }
    HostedSocketEvents(events, error == 0 && encoded.size == 0, error)
}

fun HostedSocketPoller.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = ablaHostNetClose(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}
