// Portable hosted TCP/UDP and readiness adapter. Linux uses epoll; macOS uses
// kqueue behind the narrow host ABI. Applications keep descriptors affine.

import "abla/net/contracts"
import "abla/sys/linux/net"
import "abla/sys/linux/process"

fun hostedCloseDescriptor(descriptor: int): bool =
    linuxTcpCloseDescriptor(descriptor)

fun hostedConnectDescriptor(
    host: string,
    port: int,
    timeoutMilliseconds: int
): int {
    var socket = if (linuxIpv6Words(host).size == 8) {
        tcpConnectIpv6(
            ipv6SocketAddress(host, port), timeoutMilliseconds
        )
    } else tcpConnectIpv4(host, port, timeoutMilliseconds)
    val descriptor = socket.descriptor
    socket.descriptor = -1
    descriptor
}

fun hostedListenDescriptor(
    host: string,
    port: int,
    backlog: int,
    dualStack: bool
): int {
    var listener = if (linuxIpv6Words(host).size == 8) {
        tcpListenIpv6(
            ipv6SocketAddress(host, port), backlog, dualStack
        )
    } else tcpListenAddress(ipv4SocketAddress(host, port), backlog)
    val descriptor = listener.descriptor
    listener.descriptor = -1
    descriptor
}

fun hostedLocalPort(descriptor: int): int {
    var listener = TcpListener(descriptor)
    val port = listener.localPort()
    listener.descriptor = -1
    port
}

fun hostedReadRaw(descriptor: int, maximum: int): SocketReadResult {
    var socket = TcpConnection(descriptor)
    val result = socket.readResult(maximum)
    socket.descriptor = -1
    result
}

fun hostedWriteRaw(descriptor: int, contents: string): SocketWriteResult {
    var socket = TcpConnection(descriptor)
    val result = socket.writeResult(contents)
    socket.descriptor = -1
    result
}

class HostedSocketReadResult(
    val bytes: string,
    val status: string,
    val errorCode: int
) {
    fun hasData(): bool = this.status == "data"
    fun reachedEof(): bool = this.status == "eof"
    fun wouldBlock(): bool = this.status == "would-block"
    fun failed(): bool = this.status == "error"
}

fun HostedSocketReadResult.networkOutcome(
    operation: string = "read"
): NetworkReadOutcome {
    var state = 6
    if (this.status == "data") state = 1
    if (this.status == "eof") state = 2
    if (this.status == "would-block") state = 5
    NetworkReadOutcome(
        this.bytes,
        state,
        networkError(this.errorCode, operation)
    )
}

class HostedSocketWriteResult(
    val written: int,
    val wouldBlock: bool,
    val errorCode: int
) {
    fun succeeded(): bool = this.written >= 0
    fun failed(): bool = this.written < 0 && !this.wouldBlock
}

fun HostedSocketWriteResult.networkOutcome(
    operation: string = "write"
): NetworkWriteOutcome {
    var state = if (this.written >= 0) 1 else 6
    if (this.wouldBlock) state = 5
    NetworkWriteOutcome(
        this.written,
        state,
        networkError(this.errorCode, operation)
    )
}

class HostedSocketEvent(
    val descriptor: int,
    val readable: bool,
    val writable: bool,
    val closed: bool,
    val error: bool
)

class HostedSocketEvents(
    val events: array<HostedSocketEvent>,
    val timedOut: bool,
    val errorCode: int
) {
    fun failed(): bool = this.errorCode != 0
}

class HostedUdpDatagram(
    val bytes: string,
    val sourceAddress: string,
    val sourcePort: int,
    val received: bool,
    val wouldBlock: bool,
    val errorCode: int
)

resource class HostedTcpListener(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) hostedCloseDescriptor(this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class HostedTcpConnection(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) hostedCloseDescriptor(this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class HostedUdpSocket(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) hostedCloseDescriptor(this.descriptor)
        this.descriptor = -1
        return
    }
}

resource class HostedSocketPoller(var descriptor: int) {
    fun drop(): void {
        if (this.descriptor >= 0) hostedCloseDescriptor(this.descriptor)
        this.descriptor = -1
        return
    }
}

fun hostedTcpConnect(
    host: string,
    port: int,
    timeoutMilliseconds: int = 5000
): HostedTcpConnection = HostedTcpConnection(
    hostedConnectDescriptor(host, port, timeoutMilliseconds)
)

fun hostedTcpListen(
    host: string = "::",
    port: int = 0,
    backlog: int = 128,
    dualStack: bool = true
): HostedTcpListener = HostedTcpListener(
    hostedListenDescriptor(host, port, backlog, dualStack)
)

fun HostedTcpListener.accept(): HostedTcpConnection =
    HostedTcpConnection(linuxTcpAcceptDescriptor(this.descriptor))

fun HostedTcpListener.localPort(): int =
    hostedLocalPort(this.descriptor)

fun HostedTcpListener.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)

fun HostedTcpConnection.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)

fun hostedReadResult(descriptor: int, maximum: int): HostedSocketReadResult {
    val result = hostedReadRaw(descriptor, maximum)
    HostedSocketReadResult(
        result.bytes,
        if (result.errorCode == 11) "would-block" else result.status,
        result.errorCode
    )
}

fun HostedTcpConnection.readResult(
    maximum: int = 65536
): HostedSocketReadResult = hostedReadResult(this.descriptor, maximum)

fun HostedTcpConnection.readNetwork(
    maximum: int,
    timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50
): NetworkReadOutcome {
    val started = linuxMonotonicMilliseconds()
    var result = NetworkReadOutcome(
        "", 3, networkError(60, "read")
    )
    val poller = hostedSocketPoller()
    var waiting = poller.descriptor >= 0 && this.descriptor >= 0 &&
        timeoutMilliseconds > 0 && cancellationPollMilliseconds > 0 &&
        poller.watchDescriptor(this.descriptor)
    while (waiting && linuxMonotonicMilliseconds() - started <
        timeoutMilliseconds) {
        if (cancellation.isRequested()) {
            result = NetworkReadOutcome(
                "", 4, networkError(89, "read")
            )
            waiting = false
        } else {
            var duration = timeoutMilliseconds -
                (linuxMonotonicMilliseconds() - started)
            if (duration > cancellationPollMilliseconds) {
                duration = cancellationPollMilliseconds
            }
            val ready = poller.wait(1, duration)
            if (ready.failed()) {
                result = NetworkReadOutcome(
                    "", 6, networkError(ready.errorCode, "poll")
                )
                waiting = false
            } else if (ready.events.size > 0) {
                result = this.readResult(maximum).networkOutcome()
                waiting = false
            }
        }
    }
    poller.close()
    result
}

fun HostedTcpConnection.writeResult(
    contents: string
): HostedSocketWriteResult {
    val result = hostedWriteRaw(this.descriptor, contents)
    val written = if (result.failed()) -result.errorCode else result.written
    val error = result.errorCode
    HostedSocketWriteResult(
        written,
        error == 11 || error == 35,
        error
    )
}

fun HostedTcpConnection.writeNetwork(
    contents: string,
    timeoutMilliseconds: int,
    cancellation: NetworkCancellation = networkCancellation(),
    cancellationPollMilliseconds: int = 50
): NetworkWriteOutcome {
    val started = linuxMonotonicMilliseconds()
    var offset = 0
    var result = NetworkWriteOutcome(
        0, 3, networkError(60, "write")
    )
    val poller = hostedSocketPoller()
    var writing = poller.descriptor >= 0 && this.descriptor >= 0 &&
        timeoutMilliseconds > 0 && cancellationPollMilliseconds > 0 &&
        poller.watchDescriptor(this.descriptor, false, true)
    if (!writing && this.descriptor < 0) result = NetworkWriteOutcome(
        0, 6, networkError(9, "write")
    )
    while (writing && offset < contents.size &&
        linuxMonotonicMilliseconds() - started < timeoutMilliseconds) {
        if (cancellation.isRequested()) {
            result = NetworkWriteOutcome(
                offset, 4, networkError(89, "write")
            )
            writing = false
        } else {
            var duration = timeoutMilliseconds -
                (linuxMonotonicMilliseconds() - started)
            if (duration > cancellationPollMilliseconds) {
                duration = cancellationPollMilliseconds
            }
            val ready = poller.wait(1, duration)
            if (ready.failed()) {
                result = NetworkWriteOutcome(
                    offset, 6, networkError(ready.errorCode, "poll")
                )
                writing = false
            } else if (ready.events.size > 0 && ready.events[0].writable) {
                val attempt = this.writeResult(
                    contents.slice(offset, contents.size)
                )
                if (attempt.written > 0) offset = offset + attempt.written
                if (attempt.failed()) {
                    result = NetworkWriteOutcome(
                        offset, 6, networkError(attempt.errorCode, "write")
                    )
                    writing = false
                } else if (offset >= contents.size) {
                    result = NetworkWriteOutcome(
                        offset, 1, networkNoError("write")
                    )
                    writing = false
                }
            }
        }
    }
    poller.close()
    result
}

fun HostedTcpConnection.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = hostedCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun HostedTcpListener.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = hostedCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun hostedUdpBind(
    host: string = "::",
    port: int = 0,
    dualStack: bool = true
): HostedUdpSocket = HostedUdpSocket(
    hostedUdpBindDescriptor(host, port, dualStack)
)

fun hostedUdpBindDescriptor(
    host: string,
    port: int,
    dualStack: bool
): int {
    var socket = if (linuxIpv6Words(host).size == 8) {
        udpBindIpv6(ipv6SocketAddress(host, port), true, dualStack)
    } else udpBind(ipv4SocketAddress(host, port))
    val descriptor = socket.descriptor
    socket.descriptor = -1
    descriptor
}

fun HostedUdpSocket.localPort(): int =
    hostedLocalPort(this.descriptor)

fun HostedUdpSocket.setNonblocking(enabled: bool = true): bool =
    linuxSocketSetNonblocking(this.descriptor, enabled)

fun HostedUdpSocket.sendTo(
    contents: string,
    host: string,
    port: int
): int {
    var socket = UdpSocket(this.descriptor)
    val result = if (linuxIpv6Words(host).size == 8) {
        socket.sendToIpv6(contents, ipv6SocketAddress(host, port))
    } else socket.sendTo(contents, ipv4SocketAddress(host, port))
    socket.descriptor = -1
    if (result.failed()) -result.errorCode else result.written
}

fun HostedUdpSocket.receiveFrom(
    maximum: int = 65535
): HostedUdpDatagram {
    var socket = UdpSocket(this.descriptor)
    val v6 = socket.receiveFromIpv6(maximum)
    socket.descriptor = -1
    val sourceAddress = if (
        v6.source.address == "0:0:0:0:0:0:0:1"
    ) "::1" else v6.source.address
    HostedUdpDatagram(
        v6.bytes,
        sourceAddress,
        v6.source.port,
        v6.received,
        v6.errorCode == 11,
        v6.errorCode
    )
}

fun HostedUdpSocket.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = hostedCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}

fun hostedSocketPoller(): HostedSocketPoller =
    HostedSocketPoller(linuxSyscall1(291, 524288))

fun HostedSocketPoller.watchDescriptor(
    descriptor: int,
    read: bool = true,
    write: bool = false
): bool {
    var poller = SocketPoller(this.descriptor)
    val result = linuxPollerControl(poller, 1, descriptor, read, write)
    poller.descriptor = -1
    result
}

fun HostedSocketPoller.modifyDescriptor(
    descriptor: int,
    read: bool = true,
    write: bool = false
): bool {
    var poller = SocketPoller(this.descriptor)
    val result = linuxPollerControl(poller, 3, descriptor, read, write)
    poller.descriptor = -1
    result
}

fun HostedSocketPoller.unwatchDescriptor(descriptor: int): bool {
    var poller = SocketPoller(this.descriptor)
    val result = linuxPollerControl(poller, 2, descriptor, false, false)
    poller.descriptor = -1
    result
}

fun hostedNetReadU32(bytes: string, offset: int): int =
    bytes[offset] + bytes[offset + 1] * 256 +
    bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216

fun HostedSocketPoller.wait(
    maximumEvents: int = 64,
    timeoutMilliseconds: int = 5000
): HostedSocketEvents {
    var poller = SocketPoller(this.descriptor)
    val ready = poller.wait(maximumEvents, timeoutMilliseconds)
    poller.descriptor = -1
    val events: array<HostedSocketEvent> = []
    var index = 0
    while (index < ready.events.size) {
        val event = ready.events[index]
        events.append(HostedSocketEvent(
            event.descriptor,
            event.readable,
            event.writable,
            event.closed,
            event.error
        ))
        index = index + 1
    }
    HostedSocketEvents(events, ready.timedOut, ready.errorCode)
}

fun HostedSocketPoller.close(): bool {
    var closed = this.descriptor < 0
    if (this.descriptor >= 0) {
        closed = hostedCloseDescriptor(this.descriptor)
        if (closed) this.descriptor = -1
    }
    closed
}
