// public: abla/sql
import "abla/json"
import "abla/float/text"
import "abla/float"

/** One PostgreSQL text-format input, separate from SQL source. */
class SqlParameter(val kind: string, val value: string, val isNull: bool)

/** A checked PostgreSQL-subset template and its separately bound values. */
class SqlStatement(val text: string, val parameters: array<SqlParameter>)

/** Explicit text input for bigint. PostgreSQL validates contents and range. */
class SqlInt8Text(val value: string)

/** Explicit JSON text input. PostgreSQL validates its dynamic contents. */
class SqlJsonText(val value: string)

/// Wraps text for a bigint parameter whose range and format are validated by PostgreSQL.
fun sqlInt8Text(value: string): SqlInt8Text = SqlInt8Text(value)
/// Wraps raw JSON parameter text for PostgreSQL to validate.
fun sqlJsonText(value: string): SqlJsonText = SqlJsonText(value)

/// Returns a SQL null parameter with the supplied binding kind.
fun ablaSqlBindNull(kind: string): SqlParameter = SqlParameter(kind, "", true)

/// Returns a SQL parameter containing the string bytes.
fun ablaSqlBindString(value: string, kind: string): SqlParameter =
    SqlParameter(kind, value, false)
/// Returns a nullable SQL parameter containing the string bytes or SQL null for an absent value.
fun ablaSqlBindString(value: string?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindString(value, kind)

/// Returns a SQL parameter containing the PostgreSQL boolean text.
fun ablaSqlBindBoolean(value: bool, kind: string): SqlParameter =
    SqlParameter(kind, if (value) "true" else "false", false)
/// Returns a nullable SQL parameter containing the PostgreSQL boolean text or SQL null for an absent value.
fun ablaSqlBindBoolean(value: bool?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindBoolean(value, kind)

/// Returns a SQL parameter containing the JSON text.
fun ablaSqlBindJson(value: Json, kind: string): SqlParameter =
    SqlParameter(kind, jsonStringify(value), false)
/// Returns a SQL parameter containing the JSON text.
fun ablaSqlBindJson(value: SqlJsonText, kind: string): SqlParameter =
    SqlParameter(kind, value.value, false)
/// Returns a nullable SQL parameter containing the JSON text or SQL null for an absent value.
fun ablaSqlBindJson(value: Json?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindJson(value, kind)
/// Returns a nullable SQL parameter containing the JSON text or SQL null for an absent value.
fun ablaSqlBindJson(value: SqlJsonText?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindJson(value, kind)

/// Returns a SQL parameter containing the value's bigint text.
fun ablaSqlBindInt8(value: SqlInt8Text, kind: string): SqlParameter =
    SqlParameter(kind, value.value, false)
/// Returns a nullable SQL parameter containing the value's bigint text or SQL null for an absent value.
fun ablaSqlBindInt8(value: SqlInt8Text?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindInt8(value, kind)

private fun ablaSqlFloatText(value: f64): string {
    val text = f64Text(value)
    if (text == "inf" || text == "infinity") "Infinity"
    else if (text == "-inf" || text == "-infinity") "-Infinity"
    else if (text == "nan") "NaN"
    else text
}

/// Returns a SQL parameter containing the integer's decimal text.
fun ablaSqlBindInteger(value: i8, kind: string): SqlParameter =
    SqlParameter(kind, "$value", false)
/// Returns a nullable SQL parameter containing the integer's decimal text or SQL null for an absent value.
fun ablaSqlBindInteger(value: i8?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindInteger(value, kind)
/// Returns a SQL parameter containing the value's bigint text.
fun ablaSqlBindInt8(value: i8, kind: string): SqlParameter =
    ablaSqlBindInteger(value, kind)
/// Returns a nullable SQL parameter containing the value's bigint text or SQL null for an absent value.
fun ablaSqlBindInt8(value: i8?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindInt8(value, kind)

