/// Returns a SQL parameter containing PostgreSQL floating-point text.
fun ablaSqlBindFloat(value: f32, kind: string): SqlParameter =
    SqlParameter(kind, ablaSqlFloatText(f32ToF64(value)), false)
/// Returns a nullable SQL parameter containing PostgreSQL floating-point text or SQL null for an absent value.
fun ablaSqlBindFloat(value: f32?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindFloat(value, kind)

/// Returns a SQL parameter containing PostgreSQL floating-point text.
fun ablaSqlBindFloat(value: f64, kind: string): SqlParameter =
    SqlParameter(kind, ablaSqlFloatText(value), false)
/// Returns a nullable SQL parameter containing PostgreSQL floating-point text or SQL null for an absent value.
fun ablaSqlBindFloat(value: f64?, kind: string): SqlParameter =
    if (value == null) ablaSqlBindNull(kind) else ablaSqlBindFloat(value, kind)
