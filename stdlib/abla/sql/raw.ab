// public: abla/sql
import "abla/compiler/parser"
import "abla/text"
import "parser.ab"

compile class AblaSqlTemplate(
    val parts: array<string> = [],
    val holes: array<SyntaxExpression> = [],
    val positions: array<int> = [],
    var size: int = 0
)

compile fun AblaSqlTemplate.add(text: string): void {
    this.parts.append(text)
    this.size += text.size
}

compile fun AblaSqlTemplate.hole(expression: SyntaxExpression): void {
    this.positions.append(this.size)
    this.holes.append(expression)
    val number = this.holes.size
    this.add("\$$number")
}

compile fun AblaSqlTemplate.withinLimits(cursor: ParserCursor): bool {
    if (this.size <= 65536 && this.holes.size <= 1024) return true
    parserFail(cursor, "SQL literal size or parameter limit exceeded")
    false
}

// Consume a SQL quote without exposing its contents to the Abla parser.
// Escape validation belongs to ablaSqlCheck, which sees all the original bytes.
compile fun ablaSqlRawQuote(cursor: ParserCursor, var template: AblaSqlTemplate,
    quote: string, escaped: bool): bool {
    val delimiters = if (escaped) quote + "\\" else quote
    while (!parserRawEnd(cursor)) {
        template.add(parserRawTakeUntil(cursor, delimiters))
        if (!template.withinLimits(cursor)) return false
        if (parserRawConsume(cursor, quote)) {
            template.add(quote)
            if (!parserRawConsume(cursor, quote)) return true
            template.add(quote)
        } else if (parserRawConsume(cursor, "\\")) {
            template.add("\\")
            // Only the supported escapes can hide the next quote or slash.
            if (parserRawConsume(cursor, quote)) template.add(quote)
            else if (parserRawConsume(cursor, "\\")) template.add("\\")
        }
    }
    parserFail(cursor, "unterminated SQL quote")
    false
}

compile fun ablaSqlRawComment(cursor: ParserCursor, var template: AblaSqlTemplate): bool {
    var depth = 1
    while (depth > 0 && !parserRawEnd(cursor)) {
        template.add(parserRawTakeUntil(cursor, "/*"))
        if (!template.withinLimits(cursor)) return false
        if (parserRawConsume(cursor, "/*")) {
            template.add("/*")
            depth += 1
            if (depth > 64) {
                parserFail(cursor, "SQL comment nesting limit exceeded")
                return false
            }
        } else if (parserRawConsume(cursor, "*/")) {
            template.add("*/")
            depth -= 1
        } else if (parserRawConsume(cursor, "/")) template.add("/")
        else if (parserRawConsume(cursor, "*")) template.add("*")
    }
    if (depth == 0) return true
    parserFail(cursor, "unterminated SQL comment")
    false
}

// The opening dollar was consumed. Scan the potential tag, leaving its
// delimiter untouched unless this is a dollar-quoted string.
compile fun ablaSqlRawDollar(cursor: ParserCursor, var template: AblaSqlTemplate): bool {
    val name = parserRawTakeUntil(cursor, " \t\r\n\x0c!\"#$%&'()*+,-./:;<=>?@[\\]^`{|}~")
    template.add(name)
    if (name.size > 64 || (name.size > 0 && !ablaSqlLetter(name[0]))) return true
    var index = 1
    while (index < name.size) {
        if (!ablaSqlLetter(name[index]) && !ablaSqlDigit(name[index])) return true
        index += 1
    }
    if (!parserRawConsume(cursor, "\$")) return true
    template.add("\$")
    val tag = "\$$name\$"
    template.add(parserRawTakeUntilText(cursor, tag))
    if (!parserRawConsume(cursor, tag)) {
        parserFail(cursor, "unterminated SQL dollar quote")
        return false
    }
    template.add(tag)
    true
}

// The boundary prepass and the handler must consume precisely the same bytes.
compile fun ablaSqlReadBrace(cursor: ParserCursor): AblaSqlTemplate {
    parserRawExpect(cursor, "{")
    val template = AblaSqlTemplate()
    var previousNameByte = false
    while (!parserRawEnd(cursor)) {
        val text = parserRawTakeUntil(cursor, "\"'\$/-}")
        template.add(text)
        if (!template.withinLimits(cursor)) return template
        if (parserRawConsume(cursor, "}")) return template
        val length = text.size
        val afterName = if (length == 0) previousNameByte else ablaSqlNameByte(text[length - 1])
        val escaped = length > 0 && (text[length - 1] == 69 || text[length - 1] == 101) &&
            !(if (length == 1) previousNameByte else ablaSqlNameByte(text[length - 2]))
        previousNameByte = false
        if (parserRawConsume(cursor, "\${")) {
            template.hole(parserParseAblaExpression(cursor))
            parserRawSkipWhitespace(cursor)
            parserRawExpect(cursor, "}")
        } else if (parserRawConsume(cursor, "'")) {
            template.add("'")
            if (!ablaSqlRawQuote(cursor, template, "'", escaped)) return template
        } else if (parserRawConsume(cursor, "\"")) {
            template.add("\"")
            if (!ablaSqlRawQuote(cursor, template, "\"", false)) return template
        } else if (parserRawConsume(cursor, "--")) {
            template.add("--")
            template.add(parserRawTakeUntil(cursor, "\r\n"))
        } else if (parserRawConsume(cursor, "/*")) {
            template.add("/*")
            if (!ablaSqlRawComment(cursor, template)) return template
        } else if (parserRawConsume(cursor, "\$")) {
            template.add("\$")
            if (afterName) previousNameByte = true
            else if (!ablaSqlRawDollar(cursor, template)) return template
        } else if (parserRawConsume(cursor, "/")) template.add("/")
        else if (parserRawConsume(cursor, "-")) template.add("-")
        if (!template.withinLimits(cursor)) return template
    }
    parserFail(cursor, "unterminated SQL brace literal")
    template
}

compile fun ablaSqlRawBoundary(cursor: ParserCursor): SyntaxExpression {
    ablaSqlReadBrace(cursor)
    syntaxNull()
}
