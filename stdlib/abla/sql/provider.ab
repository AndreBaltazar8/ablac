// public: abla/sql
import "abla/compiler/parser"
import "abla/text"
import "runtime.ab"
import "parser.ab"
import "raw.ab"

/// Returns the syntax of the binder call for the checked SQL parameter kind and value.
compile fun ablaSqlBinding(kind: string, value: SyntaxExpression): SyntaxExpression {
    if (syntaxKind(value) == "null") return syntaxCall("ablaSqlBindNull", [syntaxString(kind)])
    val function = if (kind == "text" || kind == "uuid") "ablaSqlBindString"
        else if (kind == "int8") "ablaSqlBindInt8"
        else if (kind == "int2" || kind == "int4") "ablaSqlBindInteger"
        else if (kind == "float4" || kind == "float8") "ablaSqlBindFloat"
        else if (kind == "bool") "ablaSqlBindBoolean"
        else "ablaSqlBindJson"
    syntaxCall(function, [value, syntaxString(kind)])
}

// Inspect the parsed template; never evaluate its string concatenation.
compile fun ablaSqlReadQuoted(cursor: ParserCursor): AblaSqlTemplate {
    parserExpect(cursor, "(")
    val literal = parserParseAblaExpression(cursor)
    val template = AblaSqlTemplate()
    if (syntaxKind(literal) == "string") template.add(syntaxText(literal))
    else if (syntaxKind(literal) == "string.template") {
        var index = 0
        while (index < syntaxChildCount(literal) && template.withinLimits(cursor)) {
            val child = syntaxChild(literal, index)
            if (parserTemplatePartIsText(cursor, literal, index)) template.add(syntaxText(child))
            else template.hole(child)
            index += 1
        }
    } else parserFail(cursor, "SQL expects a quoted string literal or interpolated string literal")
    parserExpect(cursor, ")")
    template
}

/// Returns syntax for a parameterized SQL statement from a quoted or brace template and reports invalid SQL or parameter positions through the cursor.
compile fun ablaSqlParseLiteral(cursor: ParserCursor): SyntaxExpression {
    val parts = if (parserAt(cursor, "{")) ablaSqlReadBrace(cursor) else ablaSqlReadQuoted(cursor)
    val template = parts.parts.join("")
    val parameters: array<SyntaxExpression> = []
    val checked = ablaSqlCheck(template, parts.positions)
    if (checked.message != "") {
        val byte = checked.begin
        parserFail(cursor, "SQL at template byte $byte: " + checked.message)
    } else {
        var index = 0
        while (index < parts.holes.size) {
            parameters.append(ablaSqlBinding(checked.kinds[index], parts.holes[index]))
            index += 1
        }
    }
    syntaxCall("SqlStatement", [syntaxString(template), syntaxArray(parameters)])
}

/// Builds a typed SQL statement from a quoted or brace literal, reporting invalid SQL or interpolation positions at compile time.
#compilerRegisterSubparser("sql", ablaSqlParseLiteral, ablaSqlRawBoundary)
