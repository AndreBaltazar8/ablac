// Transactional variables (docs/language.md#transactions):
//
//   var balance: int by TVar(100)
//   fun transfer(n: int) = atomic { balance -= n }
//
// A program that names `TVar` or `Transactional` gets this module without
// importing it (a program's own declaration of the name wins). A TVar is the
// runtime's transactional variable itself (abla/runtime/self: a 40-byte
// block, tag 14), not an object holding one: making one, reading it and
// writing it are calls of the runtime's functions, which inline their fast
// paths.

/** A delegate whose reads and writes are its transaction's: a binding
 *  delegated to one (`by TVar(…)`, or a library's own transactional
 *  delegate) may be read and written in `atomic`, and threads share it. */
interface Transactional

/** A transactional variable holding a `T`: read and written as the
 *  delegate of a binding (`var balance: int by TVar(100)`), or directly with
 *  getValue and setValue. In `atomic`, a read is the transaction's
 *  (`retry` waits for a TVar it read to change) and a write is kept until
 *  it commits. `T` is no resource: an abandoned attempt would skip its drop
 *  (`stm.resource`). */
//
// (`__abla_runtime_value`, reserved to the standard library: an instance is
// what the first runtime function makes, and each method a call of the
// runtime function named after it, with the instance first.)
@__abla_runtime_value("__ablaRuntimeTVarCreate getValue:__ablaRuntimeStmRead setValue:__ablaRuntimeStmWrite")
class TVar<T : __abla_not_resource>(value: T) : Transactional {
    /** The value: in `atomic`, the transaction's read. */
    fun getValue(): T

    /** Sets the value: in `atomic`, kept until the transaction commits. */
    fun setValue(value: T): void
}
