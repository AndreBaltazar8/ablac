// Opt-in adapters between the HTTP transport model and phase-safe JSON.
// Importing abla/http alone deliberately does not retain this module.

import "abla/http"
import "abla/json"

fun httpJsonLimits(): JsonLimits = JsonLimits(
    1048576,
    64,
    100000,
    1048576,
    10000,
    true
)

fun httpJsonTrim(value: string): string {
    var begin = 0
    var end = value.size
    while (begin < end &&
        (value[begin] == 32 || value[begin] == 9)) {
        begin = begin + 1
    }
    while (end > begin &&
        (value[end - 1] == 32 || value[end - 1] == 9)) {
        end = end - 1
    }
    value.slice(begin, end)
}

fun httpJsonMediaType(value: string): string {
    var end = value.size
    var index = 0
    while (index < value.size) {
        if (value[index] == 59 && end == value.size) end = index
        index = index + 1
    }
    httpJsonTrim(value.slice(0, end))
}

fun httpJsonMediaTypeSupported(value: string): bool {
    val mediaType = httpJsonMediaType(value)
    var slash = false
    var index = 0
    while (index < mediaType.size) {
        if (mediaType[index] == 47) slash = true
        index = index + 1
    }
    httpAsciiEqualInsensitive(mediaType, "application/json") ||
        (slash && mediaType.size > 5 && httpAsciiEqualInsensitive(
            mediaType.slice(mediaType.size - 5, mediaType.size),
            "+json"
        ))
}

fun httpJsonUnsupportedMediaType(): JsonParseResult = JsonParseResult(
    jsonNull(),
    false,
    JsonError(
        "unsupported_media_type",
        "HTTP request Content-Type is not a JSON media type",
        0,
        1,
        1
    )
)

fun HttpRequest.parseJson(
    limits: JsonLimits = httpJsonLimits()
): JsonParseResult {
    val contentType = this.header("Content-Type")
    if (contentType == "" || !httpJsonMediaTypeSupported(contentType)) {
        httpJsonUnsupportedMediaType()
    } else jsonParse(this.body, limits)
}

fun httpJsonResponseHeaders(
    headers: array<HttpHeader>
): array<HttpHeader> {
    val result: array<HttpHeader> = []
    var index = 0
    while (index < headers.size) {
        if (!httpAsciiEqualInsensitive(
            headers[index].name, "Content-Type"
        )) result.append(headers[index])
        index = index + 1
    }
    result.append(HttpHeader(
        "Content-Type", "application/json; charset=utf-8"
    ))
    result
}

fun httpJsonValue(
    value: Json,
    status: int = 200,
    headers: array<HttpHeader> = []
): HttpResponse = HttpResponse(
    status,
    httpJsonResponseHeaders(headers),
    jsonStringify(value)
)

fun httpJsonRequestHeaders(
    headers: array<HttpHeader>
): array<HttpHeader> {
    val result: array<HttpHeader> = []
    var hasAccept = false
    var index = 0
    while (index < headers.size) {
        val header = headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Accept")) {
            hasAccept = true
        }
        if (!httpAsciiEqualInsensitive(header.name, "Content-Type")) {
            result.append(header)
        }
        index = index + 1
    }
    result.append(HttpHeader(
        "Content-Type", "application/json; charset=utf-8"
    ))
    if (!hasAccept) result.append(
        HttpHeader("Accept", "application/json")
    )
    result
}

fun httpPostJson(
    path: string,
    value: Json,
    headers: array<HttpHeader> = []
): HttpRequest = httpPost(
    path,
    jsonStringify(value),
    httpJsonRequestHeaders(headers)
)
