// Nonblocking HTTP/1.1 client for event-loop services. Requests progress only
// inside `step`, so a game loop can issue backend calls (economy, matchmaking)
// without stalling a tick:
//
//     val http = httpAsyncClient()
//     server.watchExternal(http.pollDescriptor())   // optional: wake on replies
//     val id = http.request("POST", "https://api.example.com/v1/grant",
//         [HttpHeader("Content-Type", "application/json")], body)
//     ...each loop iteration:
//     http.step(0)
//     val done = http.takeCompletions()   // HttpAsyncCompletion(id, status, ...)
//
// DNS (A records through abla/dns's DnsAsyncResolver, cached), TCP connect,
// the TLS handshake (abla/tls/pure, with peer, SNI and name verification),
// request writes, and response reads are all nonblocking state machines over
// one poller. Connections are kept alive and pooled per scheme/host/port; a
// request that finds a pooled connection already closed by the peer is retried
// once on a fresh connection.

import "abla/dns"
import "abla/dns/async"
import "abla/bytes"
import "abla/http"
import "abla/http/h2"
import "abla/http/h2/hpack"
import "abla/net"
import "abla/random"
import "abla/text"
import "abla/tls/pure"
import "abla/unsafe/memory/raw"
import "abla/sys/linux"
import "abla/unsafe/memory"
import "abla/sys/linux/process"

class HttpAsyncOptions(
    val maximumConnectionsPerHost: int = 8,
    val maximumResponseBytes: int = 8388608,
    val idleTimeoutMilliseconds: int = 30000,
    val dnsTimeoutMilliseconds: int = 3000,
    val dnsCacheSeconds: int = 60,
    // Empty uses the system trust store.
    val caPath: string = "",
    // TLS 1.3 session resumption: a ticket cache the caller owns (abla/tls/pure/resume: tlsSessionCacheNew), shared by every secure connection of the client; a new
    // connection to a host that has a ticket in it resumes (no certificate), and the tickets servers send are kept in it. null: no resumption.
    val sessions: TlsSessionCache? = null,
    val nameserver: string = "",
    val nameserverPort: int = 53,
    // The resolver's search domains and ndots, and its hosts file.
    val dnsConfigurationPath: string = "/etc/resolv.conf",
    val dnsHostsPath: string = "/etc/hosts",
    // HTTP/2 (RFC 9113): on by default for https: h2 is offered by ALPN and used when the server picks it (one connection is shared by many requests, so
    // maximumConnectionsPerHost does not bound it; header names of an h2 response are lower case; trailers are in `trailers()`). http2 = false keeps HTTP/1.1 on every
    // connection. Plain http:// is HTTP/1.1 unless http2PriorKnowledge speaks h2c on every http:// origin of this client (h2c stays off by default).
    val http2: bool = true,
    val http2PriorKnowledge: bool = false,
    // Concurrent requests on one h2 connection (also bounded by the server's SETTINGS_MAX_CONCURRENT_STREAMS).
    val maximumStreamsPerConnection: int = 100,
    // Header names HPACK never indexes, besides authorization, proxy-authorization, cookie and set-cookie.
    val http2NeverIndex: array<string> = [],
    // An h2 connection idle this long is probed with a PING before a request uses it.
    val http2PingAfterIdleMilliseconds: int = 30000,
    val maximumHeaderListBytes: int = 65536
)

class HttpAsyncCompletion(
    val id: int,
    val status: int,
    val headers: array<HttpHeader>,
    val body: string,
    val error: string,
    val elapsedMilliseconds: int,
    // "h2" or "http/1.1" for a request that got a response, "" otherwise.
    val protocol: string = "",
    val trailerList: array<HttpHeader> = []
) {
    fun succeeded(): bool = this.error == ""

    // Trailer fields an HTTP/2 response carried (lower case names), in order; empty when there were none and for HTTP/1.1.
    fun trailers(): array<HttpHeader> = this.trailerList
}

fun HttpAsyncCompletion.header(name: string): string {
    var result = ""
    var index = 0
    while (index < this.headers.size) {
        if (httpAsciiEqualInsensitive(this.headers[index].name, name)) {
            result = this.headers[index].value
        }
        index = index + 1
    }
    result
}

// Streaming requests (requestStream, getStream): what happened to one, in order. HEADERS: `status` and `headers`; READABLE: bytes wait for readStream (sent when there were none
// waiting; read until it returns ""); WRITABLE: writeBody has room again; END: the response ended well (`trailers`); ERROR: the request failed (`error`; the id is done).
val HTTP_STREAM_HEADERS = 1
val HTTP_STREAM_READABLE = 2
val HTTP_STREAM_WRITABLE = 3
val HTTP_STREAM_END = 4
val HTTP_STREAM_ERROR = 5

class HttpAsyncStreamEvent(val kind: int, val id: int, val status: int = 0, val headers: array<HttpHeader> = [], val trailers: array<HttpHeader> = [], val error: string = "")

// The HTTP/1.1 half of a streaming request (per request slot): the response body framing and what waits for readStream, and the request body's framing.
// framing: 0 response headers not read yet, 1 Content-Length (`left` bytes to come), 2 chunked (phase: 0 size line, 1 data, 2 CRLF after data, 3 after the last chunk), 3 until the close, 4 no body.
class HttpAsyncStreamState(
    var inbox: string = "",
    var framing: int = 0,
    var left: int = 0,
    var phase: int = 0,
    var ended: bool = false,
    var paused: bool = false,
    var blocked: bool = false,
    var bodyDone: bool = false,
    var chunkedRequest: bool = false,
    var keepAlive: bool = true,
    var status: int = 0,
    var headers: array<HttpHeader> = [],
    var trailers: array<HttpHeader> = []
)

class HttpAsyncTarget(
    val secure: bool,
    val host: string,
    val port: int,
    val path: string,
    val valid: bool
)

class HttpAsyncRead(var text: string, var status: int)

// Request states.
private val httpAsyncRequestFree = 0
private val httpAsyncRequestQueued = 1
private val httpAsyncRequestActive = 2

// Connection states.
private val httpAsyncConnectionFree = 0
private val httpAsyncConnectionResolving = 1
private val httpAsyncConnectionConnecting = 2
private val httpAsyncConnectionHandshaking = 3
private val httpAsyncConnectionWriting = 4
private val httpAsyncConnectionReading = 5
private val httpAsyncConnectionIdle = 6
// An HTTP/2 connection past its handshake: many requests, each a stream of the slot's H2Client.
private val httpAsyncConnectionH2 = 7
// An HTTP/1.1 streaming request: the request body is written and the response body read at the same time.
private val httpAsyncConnectionStreaming = 8

// What an origin (scheme, host, port) is known to speak, from the ALPN of its last handshake.
private val httpAsyncOriginUnknown = 0
private val httpAsyncOriginHttp1 = 1
private val httpAsyncOriginH2 = 2

resource class HttpAsyncClient(
    val poller: SocketPoller,
    val options: HttpAsyncOptions,
    val resolver: DnsAsyncResolver,
    val reader: HttpAsyncRead,
    // requests
    val requestIds: array<int>,
    val requestStates: array<int>,
    val requestKeys: array<string>,
    val requestHosts: array<string>,
    val requestPorts: array<int>,
    val requestSecure: array<bool>,
    val requestPayloads: array<string>,
    val requestDeadlines: array<int>,
    val requestStarted: array<int>,
    val requestRetried: array<bool>,
    // The parts of a request, kept for HTTP/2 (HTTP/1.1 uses the rendered payload), the connection slot and stream carrying it, and the response as it arrives.
    val requestMethods: array<string>,
    val requestTargets: array<string>,
    val requestAuthorities: array<string>,
    val requestHeaderLists: array<array<HttpHeader>>,
    val requestBodies: array<string>,
    val requestSlots: array<int>,
    val requestStreams: array<int>,
    val requestStatuses: array<int>,
    val requestResponseHeaders: array<array<HttpHeader>>,
    val requestChunks: array<array<string>>,
    val requestTrailers: array<array<HttpHeader>>,
    val freeRequests: array<int>,
    var freeRequestCount: int,
    // connections
    val connectionDescriptors: array<int>,
    val connectionSessions: array<int>,
    val connectionTls: array<TlsSession>,
    val connectionKeys: array<string>,
    val connectionHosts: array<string>,
    val connectionPorts: array<int>,
    val connectionSecure: array<bool>,
    val connectionStates: array<int>,
    val connectionRequests: array<int>,
    val connectionOutputs: array<string>,
    val connectionOutputOffsets: array<int>,
    val connectionInputs: array<string>,
    val connectionHeaderEnds: array<int>,
    val connectionUsed: array<int>,
    val connectionIdleSince: array<int>,
    // The resolver's query id while resolving, otherwise 0.
    val connectionDnsQueries: array<int>,
    val connectionWriteInterest: array<bool>,
    // 1 HTTP/1.1, 2 HTTP/2 (then connectionH2 is the connection's H2Client; other slots hold an unused one); the last time bytes arrived.
    val connectionProtocols: array<int>,
    val connectionH2: array<H2Client>,
    val connectionActivity: array<int>,
    val freeConnections: array<int>,
    var freeConnectionCount: int,
    // What each origin key speaks (httpAsyncOrigin*), until when that is believed.
    val originKeys: array<string>,
    val originProtocols: array<int>,
    val originExpires: array<int>,
    // descriptor -> connection slot * 2 + role (0 socket, 1 dns)
    val routes: array<int>,
    // DNS cache
    val dnsHosts: array<string>,
    val dnsAddresses: array<string>,
    val dnsExpires: array<int>,
    var completions: array<HttpAsyncCompletion>,
    var nextId: int,
    var activeRequests: int,
    var connectionsOpened: int,
    // Streaming requests, by request slot: whether it is one, its request body length (-1 unknown) and idle timeout; the events not taken yet.
    val requestStreaming: array<bool> = [],
    val requestLengths: array<int> = [],
    val requestIdle: array<int> = [],
    var streamEvents: array<HttpAsyncStreamEvent> = [],
    val streamStates: array<HttpAsyncStreamState> = []
) {
    trusted fun drop(): void {
        var slot = 0
        while (slot < this.connectionStates.size) {
            if (this.connectionStates[slot] != 0) {
                this.tlsFree(slot)
                if (this.connectionDescriptors[slot] >= 0) {
                    linuxTcpCloseDescriptor(this.connectionDescriptors[slot])
                }
                this.connectionStates[slot] = 0
            }
            slot = slot + 1
        }
        this.resolver.close()
        this.poller.close()
        return
    }
}

fun httpAsyncClient(options: HttpAsyncOptions = HttpAsyncOptions()): HttpAsyncClient =
    HttpAsyncClient(
        socketPoller(), options,
        dnsAsyncResolver(DnsAsyncOptions(
            options.dnsTimeoutMilliseconds, 1000, options.nameserver,
            options.nameserverPort, options.dnsConfigurationPath,
            options.dnsHostsPath
        )),
        HttpAsyncRead("", 0),
        [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], 0,
        [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], 0,
        [], [], [],
        [], [], [], [], [], 1, 0, 0
    )

// ---------------------------------------------------------------------------
// Parsing and native helpers

private fun httpAsyncParseUrl(url: string): HttpAsyncTarget {
    var secure = true
    var rest = url
    if (textFindSequence(url, "https://", 0, url.size) == 0) {
        rest = url.slice(8, url.size)
    } else if (textFindSequence(url, "http://", 0, url.size) == 0) {
        secure = false
        rest = url.slice(7, url.size)
    } else return HttpAsyncTarget(true, "", 0, "", false)
    var slash = textFindByte(rest, 47, 0, rest.size)
    if (slash < 0) slash = rest.size
    val authority = rest.slice(0, slash)
    val path = if (slash < rest.size) rest.slice(slash, rest.size) else "/"
    var host = authority
    var port = if (secure) 443 else 80
    val colon = textFindByte(authority, 58, 0, authority.size)
    if (colon >= 0) {
        host = authority.slice(0, colon)
        port = httpDecimalLength(authority.slice(colon + 1, authority.size), 65535)
    }
    HttpAsyncTarget(secure, host, port, path, host != "" && port > 0)
}

// The headers of a streamed HTTP/1.1 request: the caller's, then Content-Length when the body's size is known, else Transfer-Encoding: chunked (a streaming request with
// length 0 sends Content-Length: 0 for methods that carry a body, as a buffered one does).
private fun httpAsyncStreamHeaders(headers: array<HttpHeader>, length: int): array<HttpHeader> {
    val all: array<HttpHeader> = []
    for (header in headers) {
        if (httpAsciiEqualInsensitive(header.name, "Content-Length") || httpAsciiEqualInsensitive(header.name, "Transfer-Encoding")) continue
        all.append(header)
    }
    if (length > 0) all.append(HttpHeader("Content-Length", "$length"))
    else if (length < 0) all.append(HttpHeader("Transfer-Encoding", "chunked"))
    all
}

private fun httpAsyncRender(
    method: string,
    target: HttpAsyncTarget,
    headers: array<HttpHeader>,
    body: string
): string {
    var output = "$method ${target.path} HTTP/1.1\r\n"
    var hasHost = false
    var hasLength = false
    var index = 0
    while (index < headers.size) {
        val header = headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Host")) hasHost = true
        if (httpAsciiEqualInsensitive(header.name, "Content-Length") || httpAsciiEqualInsensitive(header.name, "Transfer-Encoding")) hasLength = true
        output = "$output${header.name}: ${header.value}\r\n"
        index = index + 1
    }
    if (!hasHost) {
        val defaultPort = if (target.secure) 443 else 80
        output = if (target.port == defaultPort) "${output}Host: ${target.host}\r\n"
            else "${output}Host: ${target.host}:${target.port}\r\n"
    }
    if (!hasLength && (body.size > 0 || method == "POST" || method == "PUT" ||
        method == "PATCH")) output = "${output}Content-Length: ${body.size}\r\n"
    "$output\r\n$body"
}

// The :authority of a request: the host, with the port when it is not the scheme's default.
private fun httpAsyncAuthority(target: HttpAsyncTarget): string {
    val defaultPort = if (target.secure) 443 else 80
    if (target.port == defaultPort) target.host else "${target.host}:${target.port}"
}

fun httpAsyncNumericIpv4(host: string): string =
    if (host == "localhost") "127.0.0.1"
    else if (ipv4SocketAddress(host, 1).isValid()) host
    else ""

// Starts a nonblocking IPv4 connect. Returns the descriptor (connected or in
// progress) or a negative errno.
fun httpAsyncConnect(address: string, port: int): int {
    val octets = linuxIpv4Octets(address)
    if (octets.size != 4) return -22
    // AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC
    val descriptor = linuxSyscall3(41, 2, 526337, 0)
    if (descriptor < 0) return descriptor
    val socketAddress = nativeByteBuffer(16)
    linuxNetStoreU16(socketAddress, 0, 2)
    socketAddress.store(2, port / 256)
    socketAddress.store(3, port - port / 256 * 256)
    var octet = 0
    while (octet < 4) {
        socketAddress.store(4 + octet, octets[octet])
        octet = octet + 1
    }
    var connected = linuxSyscall3(
        42, descriptor, nativePointerAddress(socketAddress.address), 16
    )
    while (connected == -4) connected = linuxSyscall3(
        42, descriptor, nativePointerAddress(socketAddress.address), 16
    )
    socketAddress.close()
    if (connected == 0 || connected == -115) {
        // TCP_NODELAY: requests are written in one piece.
        val enabled = nativeByteBuffer(8)
        linuxNetStoreU32(enabled, 0, 1)
        linuxSyscall5(54, descriptor, 6, 1, nativePointerAddress(enabled.address), 4)
        enabled.close()
        descriptor
    } else {
        linuxTcpCloseDescriptor(descriptor)
        connected
    }
}

fun httpAsyncSocketError(descriptor: int): int {
    val error = nativeByteBuffer(8)
    val errorLength = nativeByteBuffer(8)
    linuxNetStoreU32(error, 0, 0)
    linuxNetStoreU32(errorLength, 0, 4)
    val inspected = linuxSyscall5(
        55, descriptor, 1, 4,
        nativePointerAddress(error.address),
        nativePointerAddress(errorLength.address)
    )
    val result = if (inspected == 0) linuxNetReadNativeU32(error, 0) else -inspected
    error.close()
    errorLength.close()
    result
}

trusted fun httpAsyncPlainRead(descriptor: int, var result: HttpAsyncRead): void {
    val stack = nativeStackAllocate(65536)
    var measured = linuxSyscall3(0, descriptor, stack, 65536)
    while (measured == -4) measured = linuxSyscall3(0, descriptor, stack, 65536)
    result.status = measured
    if (measured > 0) {
        val target = nativeByteBuffer(measured + 1)
        ablaUnsafeCopyMemory(nativePointerAddress(target.address), stack, measured)
        result.text = target.adoptString(measured)
    } else result.text = ""
    return
}

// The TLS of a connection is a TlsSession of abla/tls/pure over its socket. A slot without TLS holds a failed placeholder.
fun httpAsyncNoSession(): TlsSession = tlsSessionClient(-1, "", TLS_VERIFY_NONE)

// Status > 0: bytes read. Otherwise -2 = want read, -3 = want write, -6 = clean close, -1 = failure.
fun HttpAsyncClient.tlsRead(slot: int): void {
    val read = this.connectionTls[slot].readReady(16384)
    if (read.status == 1 && read.bytes.size > 0) {
        this.reader.text = read.bytes
        this.reader.status = read.bytes.size
    } else {
        this.reader.text = ""
        this.reader.status = if (read.status == 2) -2 else if (read.status == 3) -3 else if (read.status == 0) -6 else -1
    }
    return
}

// Returns bytes written, -2 or -3 for a socket that must become readable or writable first, -1 for a failure.
fun HttpAsyncClient.tlsWrite(slot: int, contents: string, offset: int): int {
    val sent = this.connectionTls[slot].writeReady(contents, offset)
    if (sent.status == 1 && sent.written > 0) sent.written
    else if (sent.status == 3) -3
    else if (sent.status == 2) -2
    else -1
}

// Returns 1 when complete, -2 or -3 while the socket must become readable or writable, -100 when the certificate was refused,
// -1 for any other failure.
fun HttpAsyncClient.tlsHandshake(slot: int): int {
    val status = this.connectionTls[slot].handshake()
    if (status == 1) return 1
    if (status == 2) return -2
    if (status == 3) return -3
    val client = this.connectionTls[slot].client
    if (client.chain.size > 0 && !client.connected()) -100 else -1
}

// close_notify is offered once, the socket is shut down; the descriptor is closed by the caller.
fun HttpAsyncClient.tlsFree(slot: int): void {
    if (this.connectionSessions[slot] != 0) {
        this.connectionTls[slot].close()
        this.connectionSessions[slot] = 0
    }
    return
}

// ---------------------------------------------------------------------------
// Bookkeeping

fun HttpAsyncClient.route(descriptor: int, value: int): void {
    while (this.routes.size <= descriptor) this.routes.append(-1)
    this.routes[descriptor] = value
    return
}

fun HttpAsyncClient.unroute(descriptor: int): void {
    if (descriptor >= 0 && descriptor < this.routes.size) this.routes[descriptor] = -1
    return
}

fun HttpAsyncClient.complete(
    request: int,
    status: int,
    headers: array<HttpHeader>,
    body: string,
    error: string,
    protocol: string = ""
): void {
    if (request >= 0 && this.requestStates[request] != 0) {
        if (this.requestStreaming[request]) {
            // A streaming request ends in a stream event, not a completion.
            if (error == "") this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_END, this.requestIds[request], status = status, trailers = this.requestTrailers[request]))
            else this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_ERROR, this.requestIds[request], error = error))
        } else this.completions.append(HttpAsyncCompletion(
            this.requestIds[request], status, headers, body, error,
            linuxMonotonicMilliseconds() - this.requestStarted[request], protocol, this.requestTrailers[request]
        ))
        this.requestStreaming[request] = false
        this.requestStates[request] = httpAsyncRequestFree
        this.requestPayloads[request] = ""
        this.requestBodies[request] = ""
        this.requestHeaderLists[request] = []
        this.requestResponseHeaders[request] = []
        this.requestChunks[request] = []
        this.requestTrailers[request] = []
        this.requestSlots[request] = -1
        this.requestStreams[request] = -1
        this.requestStatuses[request] = -1
        if (this.freeRequestCount < this.freeRequests.size) {
            this.freeRequests[this.freeRequestCount] = request
        } else this.freeRequests.append(request)
        this.freeRequestCount = this.freeRequestCount + 1
        this.activeRequests = this.activeRequests - 1
    }
    return
}

fun HttpAsyncClient.closeConnection(slot: int): void {
    if (slot >= 0 && this.connectionStates[slot] != 0) {
        this.tlsFree(slot)
        val descriptor = this.connectionDescriptors[slot]
        if (descriptor >= 0) {
            this.poller.unwatchDescriptor(descriptor)
            this.unroute(descriptor)
            linuxTcpCloseDescriptor(descriptor)
            this.connectionDescriptors[slot] = -1
        }
        val query = this.connectionDnsQueries[slot]
        if (query != 0) {
            this.unwatchQuery(query)
            this.resolver.cancel(query)
            this.connectionDnsQueries[slot] = 0
        }
        this.connectionStates[slot] = httpAsyncConnectionFree
        this.connectionRequests[slot] = -1
        this.connectionOutputs[slot] = ""
        this.connectionInputs[slot] = ""
        if (this.connectionProtocols[slot] == 2) this.connectionH2[slot] = h2ClientNew()
        this.connectionProtocols[slot] = 1
        if (this.freeConnectionCount < this.freeConnections.size) {
            this.freeConnections[this.freeConnectionCount] = slot
        } else this.freeConnections.append(slot)
        this.freeConnectionCount = this.freeConnectionCount + 1
    }
    return
}

// Fails the connection's request (if any) and closes the connection. A
// request whose reused keep-alive connection died before any response byte
// is requeued once instead.
fun HttpAsyncClient.fail(slot: int, error: string): void {
    if (this.connectionProtocols[slot] == 2 && this.connectionStates[slot] == httpAsyncConnectionH2) {
        this.h2Fail(slot, error)
        return
    }
    val request = this.connectionRequests[slot]
    val retry = request >= 0 && this.connectionUsed[slot] > 1 &&
        this.connectionInputs[slot] == "" && !this.requestRetried[request] &&
        this.connectionStates[slot] >= httpAsyncConnectionWriting
    this.closeConnection(slot)
    if (retry) {
        this.requestRetried[request] = true
        this.requestStates[request] = httpAsyncRequestQueued
    } else if (request >= 0) this.complete(request, 0, [], "", error)
    return
}

fun HttpAsyncClient.interest(slot: int, write: bool): void {
    if (this.connectionWriteInterest[slot] != write) {
        this.poller.modifyDescriptor(this.connectionDescriptors[slot], true, write)
        this.connectionWriteInterest[slot] = write
    }
    return
}

fun HttpAsyncClient.allocateConnection(request: int): int {
    var slot = -1
    if (this.freeConnectionCount > 0) {
        this.freeConnectionCount = this.freeConnectionCount - 1
        slot = this.freeConnections[this.freeConnectionCount]
    } else {
        slot = this.connectionStates.size
        this.connectionDescriptors.append(-1)
        this.connectionSessions.append(0)
        this.connectionTls.append(httpAsyncNoSession())
        this.connectionKeys.append("")
        this.connectionHosts.append("")
        this.connectionPorts.append(0)
        this.connectionSecure.append(false)
        this.connectionStates.append(0)
        this.connectionRequests.append(-1)
        this.connectionOutputs.append("")
        this.connectionOutputOffsets.append(0)
        this.connectionInputs.append("")
        this.connectionHeaderEnds.append(-1)
        this.connectionUsed.append(0)
        this.connectionIdleSince.append(0)
        this.connectionDnsQueries.append(0)
        this.connectionWriteInterest.append(false)
        this.connectionProtocols.append(1)
        this.connectionH2.append(h2ClientNew())
        this.connectionActivity.append(0)
    }
    this.connectionProtocols[slot] = 1
    this.connectionActivity[slot] = linuxMonotonicMilliseconds()
    this.connectionDescriptors[slot] = -1
    this.connectionSessions[slot] = 0
    this.connectionKeys[slot] = this.requestKeys[request]
    this.connectionHosts[slot] = this.requestHosts[request]
    this.connectionPorts[slot] = this.requestPorts[request]
    this.connectionSecure[slot] = this.requestSecure[request]
    this.connectionRequests[slot] = -1
    this.connectionOutputs[slot] = ""
    this.connectionOutputOffsets[slot] = 0
    this.connectionInputs[slot] = ""
    this.connectionHeaderEnds[slot] = -1
    this.connectionUsed[slot] = 0
    this.connectionDnsQueries[slot] = 0
    this.connectionWriteInterest[slot] = false
    slot
}

// ---------------------------------------------------------------------------
// Connection state machine

fun HttpAsyncClient.cachedAddress(host: string): string {
    val numeric = httpAsyncNumericIpv4(host)
    if (numeric != "") return numeric
    val now = linuxMonotonicMilliseconds()
    var result = ""
    var index = 0
    while (result == "" && index < this.dnsHosts.size) {
        if (this.dnsHosts[index] == host && this.dnsExpires[index] > now) {
            result = this.dnsAddresses[index]
        }
        index = index + 1
    }
    result
}

fun HttpAsyncClient.remember(host: string, address: string, ttlSeconds: int): void {
    var ttl = ttlSeconds
    if (ttl > this.options.dnsCacheSeconds) ttl = this.options.dnsCacheSeconds
    if (ttl < 1) ttl = 1
    val expires = linuxMonotonicMilliseconds() + ttl * 1000
    var index = 0
    var stored = false
    while (!stored && index < this.dnsHosts.size) {
        if (this.dnsHosts[index] == host) {
            this.dnsAddresses[index] = address
            this.dnsExpires[index] = expires
            stored = true
        }
        index = index + 1
    }
    if (!stored) {
        this.dnsHosts.append(host)
        this.dnsAddresses.append(address)
        this.dnsExpires.append(expires)
    }
    return
}

// Stops watching a query's socket (before the resolver closes it).
fun HttpAsyncClient.unwatchQuery(query: int): void {
    val descriptor = this.resolver.descriptorOf(query)
    if (descriptor >= 0) {
        this.poller.unwatchDescriptor(descriptor)
        this.unroute(descriptor)
    }
    return
}

fun HttpAsyncClient.startResolve(slot: int): void {
    val query = this.resolver.start(this.connectionHosts[slot], 1)
    this.connectionDnsQueries[slot] = query
    this.connectionStates[slot] = httpAsyncConnectionResolving
    val descriptor = this.resolver.descriptorOf(query)
    if (descriptor >= 0) {
        this.route(descriptor, slot * 2 + 1)
        this.poller.watchDescriptor(descriptor)
    }
    // A socket or send failure is ready at once.
    if (this.resolver.done(query)) this.resolved(slot)
    return
}

fun HttpAsyncClient.dnsReady(slot: int): void {
    val query = this.connectionDnsQueries[slot]
    if (this.resolver.receive(this.resolver.descriptorOf(query))) {
        this.resolved(slot)
    }
    return
}

// The slot's query has finished: connect to its first IPv4 address, or fail.
fun HttpAsyncClient.resolved(slot: int): void {
    val query = this.connectionDnsQueries[slot]
    this.unwatchQuery(query)
    val result = this.resolver.take(query)
    this.connectionDnsQueries[slot] = 0
    if (result == null) return
    if (!result.succeeded()) {
        this.fail(slot, result.error)
        return
    }
    val resolution = result.resolution
    var address = ""
    var ttl = 0
    var index = 0
    while (address == "" && index < resolution.addresses.size) {
        if (resolution.addresses[index].family == 4) {
            address = resolution.addresses[index].address
            ttl = resolution.addresses[index].ttlSeconds
        }
        index = index + 1
    }
    if (address == "") this.fail(slot, "dns: no IPv4 address for ${this.connectionHosts[slot]}")
    else {
        this.remember(this.connectionHosts[slot], address, ttl)
        this.startConnect(slot, address)
    }
    return
}

fun HttpAsyncClient.startConnect(slot: int, address: string): void {
    val descriptor = httpAsyncConnect(address, this.connectionPorts[slot])
    if (descriptor < 0) {
        this.fail(slot, "connect failed (errno ${-descriptor})")
        return
    }
    this.connectionDescriptors[slot] = descriptor
    this.connectionsOpened = this.connectionsOpened + 1
    this.connectionStates[slot] = httpAsyncConnectionConnecting
    this.route(descriptor, slot * 2)
    this.poller.watchDescriptor(descriptor, true, true)
    this.connectionWriteInterest[slot] = true
    return
}

fun HttpAsyncClient.connected(slot: int): void {
    if (this.connectionSecure[slot]) {
        // An empty caPath is the system trust store. The name is checked (a DNS name or an IP address, by subjectAltName).
        var alpn: array<string> = []
        if (this.options.http2) alpn = ["h2", "http/1.1"]
        val session = tlsSessionClient(this.connectionDescriptors[slot], this.connectionHosts[slot], TLS_VERIFY_HOST, this.options.caPath, this.options.sessions, alpn)
        if (!session.ok()) {
            this.fail(slot, "tls setup failed")
            return
        }
        this.connectionTls[slot] = move(session)
        this.connectionSessions[slot] = 1
        this.connectionStates[slot] = httpAsyncConnectionHandshaking
        this.handshake(slot)
    } else if (this.options.http2PriorKnowledge) this.startH2(slot)
    else this.beginWrite(slot)
    return
}

fun HttpAsyncClient.handshake(slot: int): void {
    val result = this.tlsHandshake(slot)
    if (result == 1) this.handshakeDone(slot)
    else if (result == -2) this.interest(slot, false)
    else if (result == -3) this.interest(slot, true)
    else if (result == -100) this.fail(slot, "tls certificate verification failed")
    else this.fail(slot, "tls handshake failed")
    return
}

// (readSlot, writeSlot and pumpEvents are not called readReady, writeReady and dispatch: the region check of abla/http/event pairs
// member calls by name, and a TlsSession's readReady/writeReady retain what they are given.)
// Moves a connected (or pooled idle) connection onto its assigned request.
fun HttpAsyncClient.beginWrite(slot: int): void {
    val request = this.connectionRequests[slot]
    if (request < 0) {
        this.connectionStates[slot] = httpAsyncConnectionIdle
        this.connectionIdleSince[slot] = linuxMonotonicMilliseconds()
        this.interest(slot, false)
        return
    }
    if (this.requestStreaming[request]) {
        // HTTP/1.1 streaming: the request body goes out as the caller writes it, the response comes in as the server sends it.
        this.startStream(slot, request)
        return
    }
    this.connectionStates[slot] = httpAsyncConnectionWriting
    this.connectionOutputs[slot] = this.requestPayloads[request]
    this.connectionOutputOffsets[slot] = 0
    this.connectionInputs[slot] = ""
    this.connectionHeaderEnds[slot] = -1
    this.connectionUsed[slot] = this.connectionUsed[slot] + 1
    this.writeSlot(slot)
    return
}

fun HttpAsyncClient.writeSlot(slot: int): void {
    var writing = true
    while (writing && this.connectionStates[slot] == httpAsyncConnectionWriting) {
        val offset = this.connectionOutputOffsets[slot]
        val output = this.connectionOutputs[slot]
        if (offset >= output.size) {
            this.connectionOutputs[slot] = ""
            this.connectionStates[slot] = httpAsyncConnectionReading
            this.interest(slot, false)
            writing = false
        } else if (this.connectionSecure[slot]) {
            val written = this.tlsWrite(slot, output, offset)
            if (written > 0) this.connectionOutputOffsets[slot] = offset + written
            else if (written == -3 || written == -2) {
                this.interest(slot, written == -3)
                writing = false
            } else {
                this.fail(slot, "tls write failed")
                writing = false
            }
        } else {
            var connection = TcpConnection(this.connectionDescriptors[slot])
            val result = connection.writeCompact(output, offset)
            connection.descriptor = -1
            if (result.written > 0) {
                this.connectionOutputOffsets[slot] = offset + result.written
            }
            if (result.status == "error") {
                if (result.errorCode == 11) this.interest(slot, true)
                else this.fail(slot, "write failed")
                writing = false
            }
        }
    }
    return
}

// Inspects buffered response bytes; completes the request when the message
// is whole. Returns true when the response finished.
fun HttpAsyncClient.parseResponse(slot: int, eof: bool): bool {
    var input = this.connectionInputs[slot]
    val finalOffset = httpFinalResponseOffset(input)
    if (finalOffset > 0) {
        // Receiving an interim response proves the peer handled the request.
        // Dropping those bytes must not make EOF look like a stale idle socket
        // on which it would be safe to automatically resend the request.
        val request = this.connectionRequests[slot]
        if (request >= 0) this.requestRetried[request] = true
        input = input.slice(finalOffset, input.size)
        this.connectionInputs[slot] = input
        this.connectionHeaderEnds[slot] = -1
    }
    if (this.connectionHeaderEnds[slot] < 0) {
        this.connectionHeaderEnds[slot] = httpHeaderEnd(input)
        if (this.connectionHeaderEnds[slot] < 0) {
            if (eof) this.fail(slot, "connection closed before response")
            else if (input.size > 65536) this.fail(slot, "response header too large")
            return false
        }
    }
    val headerEnd = this.connectionHeaderEnds[slot]
    val head = httpParseResponseBounded(input.slice(0, headerEnd), 0)
    val response = head.response
    if (httpResponseLengthsDiffer(response.headers)) {
        this.fail(slot, "conflicting Content-Length headers")
        return false
    }
    val bodyBytes = input.size - headerEnd
    val maximum = this.options.maximumResponseBytes
    val transferEncoding = response.header("Transfer-Encoding")
    val chunked = httpCoreHeaderTokenContains(transferEncoding, "chunked")
    val lengthHeader = response.header("Content-Length")
    var complete = false
    var body = ""
    var keepAlive = !httpCoreHeaderTokenContains(response.header("Connection"), "close") &&
        textFindSequence(input, "HTTP/1.1", 0, 8) == 0
    if (response.status == 101) keepAlive = false
    val requestSlot = this.connectionRequests[slot]
    val headRequest = requestSlot >= 0 && httpRequestIsHead(this.requestPayloads[requestSlot])
    if (headRequest || (response.status >= 100 && response.status < 200) ||
        response.status == 204 || response.status == 304) complete = true
    else if (chunked) {
        val decoded = httpCoreDecodeChunked(input.slice(headerEnd, input.size), maximum)
        if (!decoded.valid) {
            this.fail(slot, "invalid chunked response")
            return false
        }
        complete = decoded.complete
        body = decoded.body
    } else if (transferEncoding == "" && lengthHeader != "") {
        val expected = httpDecimalLength(lengthHeader, maximum)
        if (expected < 0) {
            this.fail(slot, "response too large")
            return false
        }
        if (bodyBytes >= expected) {
            complete = true
            body = input.slice(headerEnd, headerEnd + expected)
        }
    } else {
        keepAlive = false
        complete = eof
        body = input.slice(headerEnd, input.size)
    }
    if (!complete) {
        if (eof) this.fail(slot, "connection closed mid-response")
        else if (bodyBytes > maximum) this.fail(slot, "response too large")
        return false
    }
    val request = this.connectionRequests[slot]
    this.connectionRequests[slot] = -1
    this.connectionInputs[slot] = ""
    this.complete(request, response.status, response.headers, body, "", "http/1.1")
    if (keepAlive && !eof) {
        this.connectionStates[slot] = httpAsyncConnectionIdle
        this.connectionIdleSince[slot] = linuxMonotonicMilliseconds()
    } else this.closeConnection(slot)
    true
}

fun HttpAsyncClient.readSlot(slot: int): void {
    var reading = true
    while (reading && this.connectionStates[slot] != 0) {
        if (this.connectionSecure[slot]) {
            this.tlsRead(slot)
        } else httpAsyncPlainRead(this.connectionDescriptors[slot], this.reader)
        val status = this.reader.status
        val chunk = this.reader.text
        this.reader.text = ""
        val state = this.connectionStates[slot]
        if (status > 0) {
            if (state == httpAsyncConnectionIdle) {
                // Unsolicited bytes on a pooled connection: drop it.
                this.closeConnection(slot)
                reading = false
            } else if (state == httpAsyncConnectionReading) {
                this.connectionInputs[slot] = if (this.connectionInputs[slot] == "")
                    chunk else "${this.connectionInputs[slot]}$chunk"
                if (this.parseResponse(slot, false)) reading = false
            }
        } else {
            val secure = this.connectionSecure[slot]
            val wouldBlock = if (secure) status == -2 || status == -3
                else status == -11
            if (wouldBlock) {
                if (secure && status == -3) this.interest(slot, true)
                reading = false
            } else {
                // EOF, clean TLS close, or error.
                if (state == httpAsyncConnectionReading) this.parseResponse(slot, true)
                else if (state == httpAsyncConnectionIdle) this.closeConnection(slot)
                else this.fail(slot, "connection closed")
                reading = false
            }
        }
    }
    return
}

fun HttpAsyncClient.socketReady(slot: int, readable: bool, writable: bool, failed: bool): void {
    val state = this.connectionStates[slot]
    if (state == httpAsyncConnectionConnecting) {
        if (writable || failed) {
            val error = httpAsyncSocketError(this.connectionDescriptors[slot])
            if (error != 0) this.fail(slot, "connect failed (errno $error)")
            else {
                this.interest(slot, false)
                this.connected(slot)
            }
        }
    } else if (state == httpAsyncConnectionHandshaking) this.handshake(slot)
    else if (state == httpAsyncConnectionH2) {
        // Any event: read what arrived (which also writes what that needs), and write what is waiting.
        this.h2Read(slot)
        if (this.connectionStates[slot] == httpAsyncConnectionH2 && (writable || this.connectionH2[slot].wantsWrite())) this.h2Write(slot)
    } else if (state == httpAsyncConnectionStreaming) {
        // A failed socket still has its bytes to read: they are taken past the high-water mark (the kernel holds them anyway), or the event would repeat.
        val streaming = this.connectionRequests[slot]
        if (failed && streaming >= 0) this.streamStates[streaming].paused = false
        if (readable || failed || this.connectionSecure[slot]) this.streamRead(slot)
        if (this.connectionStates[slot] == httpAsyncConnectionStreaming && (writable || (this.connectionSecure[slot] && this.connectionWriteInterest[slot]))) this.streamWrite(slot)
    } else if (state == httpAsyncConnectionWriting) {
        if (this.connectionSecure[slot] || writable) this.writeSlot(slot)
        else if (failed) this.fail(slot, "connection lost")
    } else if (state == httpAsyncConnectionReading ||
        state == httpAsyncConnectionIdle) {
        if (readable || failed) this.readSlot(slot)
        else if (writable && this.connectionSecure[slot]) this.readSlot(slot)
    }
    return
}

// ---------------------------------------------------------------------------
// HTTP/2 connections (abla/http/h2): one H2Client per connection slot, many requests per connection

private fun httpAsyncJoin(chunks: array<string>): string {
    var buffer = byteBuffer()
    for (chunk in chunks) buffer.appendText(chunk)
    buffer.toText()
}

// What the origin of `key` is believed to speak: HTTP/2 when a live connection of it does, else the memory of its last handshake (until it expires with the
// DNS cache), else unknown. Without http2 every origin speaks HTTP/1.1; http2PriorKnowledge makes every plain origin HTTP/2.
fun HttpAsyncClient.originProtocol(key: string, secure: bool): int {
    if (!secure) return if (this.options.http2PriorKnowledge) httpAsyncOriginH2 else httpAsyncOriginHttp1
    if (!this.options.http2) return httpAsyncOriginHttp1
    for (slot in 0 until this.connectionStates.size) {
        if (this.connectionStates[slot] == httpAsyncConnectionH2 && this.connectionKeys[slot] == key) return httpAsyncOriginH2
    }
    val now = linuxMonotonicMilliseconds()
    for (i in 0 until this.originKeys.size) {
        if (this.originKeys[i] == key && this.originExpires[i] > now) return this.originProtocols[i]
    }
    httpAsyncOriginUnknown
}

fun HttpAsyncClient.rememberOrigin(key: string, protocol: int): void {
    val expires = linuxMonotonicMilliseconds() + this.options.dnsCacheSeconds * 1000
    for (i in 0 until this.originKeys.size) {
        if (this.originKeys[i] == key) {
            this.originProtocols[i] = protocol
            this.originExpires[i] = expires
            return
        }
    }
    this.originKeys.append(key)
    this.originProtocols.append(protocol)
    this.originExpires.append(expires)
    return
}

// The TLS handshake is done: what the server chose (ALPN) decides the protocol of the connection and is remembered for the origin.
fun HttpAsyncClient.handshakeDone(slot: int): void {
    if (!this.options.http2) {
        this.beginWrite(slot)
        return
    }
    val h2 = this.connectionTls[slot].alpn() == "h2"
    this.rememberOrigin(this.connectionKeys[slot], if (h2) httpAsyncOriginH2 else httpAsyncOriginHttp1)
    if (h2) this.startH2(slot) else this.beginWrite(slot)
    return
}

// The connection speaks HTTP/2 from here: its request (if any) becomes the first stream.
fun HttpAsyncClient.startH2(slot: int): void {
    this.connectionProtocols[slot] = 2
    this.connectionH2[slot] = h2ClientNew(this.options.maximumStreamsPerConnection, this.options.maximumResponseBytes, this.options.maximumHeaderListBytes, this.options.http2NeverIndex)
    this.connectionStates[slot] = httpAsyncConnectionH2
    this.connectionOutputs[slot] = ""
    this.connectionOutputOffsets[slot] = 0
    this.connectionIdleSince[slot] = linuxMonotonicMilliseconds()
    this.connectionActivity[slot] = linuxMonotonicMilliseconds()
    val request = this.connectionRequests[slot]
    this.connectionRequests[slot] = -1
    if (request >= 0) {
        if (!this.h2Attach(slot, request)) this.requestStates[request] = httpAsyncRequestQueued
    }
    this.h2Pump(slot)
    return
}

// Starts `request` as a stream of the slot's connection; false when the connection has no room.
fun HttpAsyncClient.h2Attach(slot: int, request: int): bool {
    val fields: array<HpackField> = []
    for (header in this.requestHeaderLists[request]) fields.append(HpackField(header.name, header.value, false))
    val scheme = if (this.requestSecure[request]) "https" else "http"
    val stream = if (this.requestStreaming[request])
        this.connectionH2[slot].requestStream(this.requestMethods[request], scheme, this.requestAuthorities[request], this.requestTargets[request], fields, this.requestLengths[request])
        else this.connectionH2[slot].request(this.requestMethods[request], scheme, this.requestAuthorities[request], this.requestTargets[request], fields, this.requestBodies[request])
    if (stream < 0) return false
    this.requestStates[request] = httpAsyncRequestActive
    this.requestSlots[request] = slot
    this.requestStreams[request] = stream
    this.requestStatuses[request] = -1
    this.requestResponseHeaders[request] = []
    this.requestChunks[request] = []
    this.requestTrailers[request] = []
    if (this.requestStreaming[request]) {
        // The request body can start: the first WRITABLE (a request with no body has none).
        this.streamTouch(request)
        if (this.requestLengths[request] != 0) this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_WRITABLE, this.requestIds[request]))
    }
    true
}

fun HttpAsyncClient.requestOnStream(slot: int, stream: int): int {
    for (request in 0 until this.requestStates.size) {
        if (this.requestStates[request] != 0 && this.requestSlots[request] == slot && this.requestStreams[request] == stream) return request
    }
    -1
}

// Takes what the connection's H2Client reports (response headers, data, ends, resets) into the requests; closes the slot when the connection ended.
// `retryUnanswered`: a stream that got no response bytes when the connection broke goes back to the queue once.
fun HttpAsyncClient.h2Events(slot: int, retryUnanswered: bool): void {
    val events = this.connectionH2[slot].takeEvents()
    var closed = false
    var finished = false
    for (event in events) {
        if (event.kind == H2_EVENT_CLOSED) {
            closed = true
            continue
        }
        if (event.kind == H2_EVENT_GOAWAY) continue
        val request = this.requestOnStream(slot, event.stream)
        if (request < 0) continue
        // A streaming request's deadline is an idle one: anything that happens to it moves it.
        if (this.requestStreaming[request] && this.requestIdle[request] > 0) this.requestDeadlines[request] = linuxMonotonicMilliseconds() + this.requestIdle[request]
        if (event.kind == H2_EVENT_READABLE) {
            this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_READABLE, this.requestIds[request]))
        } else if (event.kind == H2_EVENT_WRITABLE) {
            this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_WRITABLE, this.requestIds[request]))
        } else if (event.kind == H2_EVENT_HEADERS) {
            this.requestStatuses[request] = event.status
            val headers: array<HttpHeader> = []
            for (field in event.headers) headers.append(HttpHeader(field.name, field.value))
            this.requestResponseHeaders[request] = headers
            if (this.requestStreaming[request]) this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_HEADERS, this.requestIds[request], status = event.status, headers = headers))
        } else if (event.kind == H2_EVENT_TRAILERS) {
            val kept: array<HttpHeader> = []
            for (field in event.headers) kept.append(HttpHeader(field.name, field.value))
            this.requestTrailers[request] = kept
        } else if (event.kind == H2_EVENT_DATA) {
            this.requestChunks[request].append(event.data)
        } else if (event.kind == H2_EVENT_END) {
            finished = true
            val headers: array<HttpHeader> = []
            for (header in this.requestResponseHeaders[request]) headers.append(header)
            val body = httpAsyncJoin(this.requestChunks[request])
            val status = this.requestStatuses[request]
            this.complete(request, status, headers, body, "", "h2")
        } else if (event.kind == H2_EVENT_RESET) {
            finished = true
            // A streaming request is never retried: its body was written by the caller as it went.
            if ((event.retry || (retryUnanswered && this.requestStatuses[request] < 0)) && !this.requestRetried[request] && !this.requestStreaming[request]) {
                this.requestRetried[request] = true
                this.requestStates[request] = httpAsyncRequestQueued
                this.requestSlots[request] = -1
                this.requestStreams[request] = -1
                this.requestResponseHeaders[request] = []
                this.requestChunks[request] = []
                this.requestTrailers[request] = []
            } else this.complete(request, 0, [], "", event.error)
        }
    }
    // A connection the server announced it will close (GOAWAY) takes no new stream: once its last stream is done it goes, it does not idle.
    if (closed || (this.connectionH2[slot].isDraining() && this.connectionH2[slot].openStreams() == 0)) this.closeConnection(slot)
    else if (finished && this.connectionH2[slot].openStreams() == 0) this.connectionIdleSince[slot] = linuxMonotonicMilliseconds()
    return
}

// Writes what the connection's H2Client has to send (and what is left of the last write), until the socket would block.
fun HttpAsyncClient.h2Write(slot: int): void {
    var writing = true
    while (writing && this.connectionStates[slot] == httpAsyncConnectionH2) {
        val offset = this.connectionOutputOffsets[slot]
        val output = this.connectionOutputs[slot]
        if (offset >= output.size) {
            val more = this.connectionH2[slot].takeOutput()
            if (more.size == 0) {
                this.interest(slot, false)
                writing = false
                if (this.connectionH2[slot].isClosed()) this.closeConnection(slot)
            } else {
                this.connectionOutputs[slot] = more
                this.connectionOutputOffsets[slot] = 0
            }
        } else if (this.connectionSecure[slot]) {
            val written = this.tlsWrite(slot, output, offset)
            if (written > 0) this.connectionOutputOffsets[slot] = offset + written
            else if (written == -3 || written == -2) {
                this.interest(slot, written == -3)
                writing = false
            } else {
                this.fail(slot, "tls write failed")
                writing = false
            }
        } else {
            var connection = TcpConnection(this.connectionDescriptors[slot])
            val result = connection.writeCompact(output, offset)
            connection.descriptor = -1
            if (result.written > 0) this.connectionOutputOffsets[slot] = offset + result.written
            if (result.status == "error") {
                if (result.errorCode == 11) this.interest(slot, true)
                else this.fail(slot, "write failed")
                writing = false
            }
        }
    }
    return
}

fun HttpAsyncClient.h2Pump(slot: int): void {
    this.h2Events(slot, false)
    if (this.connectionStates[slot] == httpAsyncConnectionH2) this.h2Write(slot)
    return
}

fun HttpAsyncClient.h2Read(slot: int): void {
    var reading = true
    while (reading && this.connectionStates[slot] == httpAsyncConnectionH2) {
        if (this.connectionSecure[slot]) this.tlsRead(slot)
        else httpAsyncPlainRead(this.connectionDescriptors[slot], this.reader)
        val status = this.reader.status
        val chunk = this.reader.text
        this.reader.text = ""
        if (status > 0) {
            val now = linuxMonotonicMilliseconds()
            this.connectionActivity[slot] = now
            this.connectionH2[slot].feed(chunk, now)
            this.h2Events(slot, false)
        } else {
            val wouldBlock = if (this.connectionSecure[slot]) status == -2 || status == -3 else status == -11
            if (wouldBlock) {
                if (this.connectionSecure[slot] && status == -3) this.interest(slot, true)
            } else {
                // The socket ended or failed: what has no response yet may go to another connection once.
                this.connectionH2[slot].broken("connection closed")
                this.h2Events(slot, true)
            }
            reading = false
        }
    }
    if (this.connectionStates[slot] == httpAsyncConnectionH2) this.h2Write(slot)
    return
}

// An error on the connection (not the protocol's own): every stream fails with it.
fun HttpAsyncClient.h2Fail(slot: int, error: string): void {
    this.connectionH2[slot].broken(error)
    this.h2Events(slot, false)
    this.closeConnection(slot)
    return
}

// A connection of the origin that can take a request now, or -1. One idle for a while is probed with a PING first and used when it answers.
fun HttpAsyncClient.h2Open(key: string, now: int): int {
    for (slot in 0 until this.connectionStates.size) {
        if (this.connectionStates[slot] == httpAsyncConnectionH2 && this.connectionKeys[slot] == key && this.connectionH2[slot].hasRoom()) {
            if (this.connectionH2[slot].pingOutstanding()) continue
            if (this.connectionH2[slot].openStreams() == 0 && now - this.connectionActivity[slot] >= this.options.http2PingAfterIdleMilliseconds) {
                this.connectionH2[slot].ping(now)
                this.h2Pump(slot)
                continue
            }
            return slot
        }
    }
    -1
}

// True when a live HTTP/2 connection of the origin has room for a stream (even if it is being probed with a PING first): no new connection is opened then.
fun HttpAsyncClient.h2Roomy(key: string): bool {
    for (slot in 0 until this.connectionStates.size) {
        if (this.connectionStates[slot] == httpAsyncConnectionH2 && this.connectionKeys[slot] == key && this.connectionH2[slot].hasRoom()) return true
    }
    false
}

// Connections of the origin that are still on their way (resolving, connecting or handshaking).
fun HttpAsyncClient.connectionsComing(key: string): int {
    var count = 0
    for (slot in 0 until this.connectionStates.size) {
        val state = this.connectionStates[slot]
        if (state != 0 && state < httpAsyncConnectionWriting && this.connectionKeys[slot] == key) count = count + 1
    }
    count
}

fun HttpAsyncClient.openConnectionFor(request: int): void {
    this.requestStates[request] = httpAsyncRequestActive
    val slot = this.allocateConnection(request)
    this.connectionRequests[slot] = request
    val address = this.cachedAddress(this.requestHosts[request])
    if (address != "") this.startConnect(slot, address)
    else this.startResolve(slot)
    return
}

// ---------------------------------------------------------------------------
// Dispatch, timers, and the public API

fun HttpAsyncClient.connectionsFor(key: string): int {
    var count = 0
    var slot = 0
    while (slot < this.connectionStates.size) {
        if (this.connectionStates[slot] != 0 && this.connectionKeys[slot] == key) {
            count = count + 1
        }
        slot = slot + 1
    }
    count
}

fun HttpAsyncClient.idleConnection(key: string): int {
    var found = -1
    var slot = 0
    while (found < 0 && slot < this.connectionStates.size) {
        if (this.connectionStates[slot] == httpAsyncConnectionIdle &&
            this.connectionKeys[slot] == key) found = slot
        slot = slot + 1
    }
    found
}

fun HttpAsyncClient.pumpEvents(): void {
    var request = 0
    while (request < this.requestStates.size) {
        if (this.requestStates[request] == httpAsyncRequestQueued) {
            val key = this.requestKeys[request]
            val protocol = this.originProtocol(key, this.requestSecure[request])
            if (protocol == httpAsyncOriginH2) {
                // One connection carries many requests: a stream on a connection with room, else a new connection only when none is on its way.
                val open = this.h2Open(key, linuxMonotonicMilliseconds())
                if (open >= 0 && this.h2Attach(open, request)) this.h2Pump(open)
                else if (open < 0 && !this.h2Roomy(key) && this.connectionsComing(key) == 0 && this.connectionsFor(key) < this.options.maximumConnectionsPerHost) this.openConnectionFor(request)
                request = request + 1
                continue
            }
            if (protocol == httpAsyncOriginUnknown) {
                // The first connection finds out: nothing else is opened for the origin until its handshake is done.
                if (this.connectionsFor(key) == 0) this.openConnectionFor(request)
                request = request + 1
                continue
            }
            val idle = this.idleConnection(key)
            if (idle >= 0) {
                this.requestStates[request] = httpAsyncRequestActive
                this.connectionRequests[idle] = request
                this.beginWrite(idle)
            } else if (this.connectionsFor(key) < this.options.maximumConnectionsPerHost) {
                this.requestStates[request] = httpAsyncRequestActive
                val slot = this.allocateConnection(request)
                this.connectionRequests[slot] = request
                val address = this.cachedAddress(this.requestHosts[request])
                if (address != "") this.startConnect(slot, address)
                else this.startResolve(slot)
            }
        }
        request = request + 1
    }
    return
}

fun HttpAsyncClient.sweep(now: int): void {
    var request = 0
    while (request < this.requestStates.size) {
        if (this.requestStates[request] != 0 && now >= this.requestDeadlines[request] && this.requestSlots[request] >= 0 &&
            this.connectionStates[this.requestSlots[request]] == httpAsyncConnectionH2) {
            // An HTTP/2 request times out alone: its stream is cancelled and the connection stays.
            val carrier = this.requestSlots[request]
            this.connectionH2[carrier].cancel(this.requestStreams[request])
            if (this.connectionH2[carrier].openStreams() == 0) this.connectionIdleSince[carrier] = now
            this.complete(request, 0, [], "", "timeout")
            this.h2Pump(carrier)
        } else if (this.requestStates[request] != 0 && now >= this.requestDeadlines[request]) {
            var owner = -1
            var slot = 0
            while (owner < 0 && slot < this.connectionStates.size) {
                if (this.connectionStates[slot] != 0 &&
                    this.connectionRequests[slot] == request) owner = slot
                slot = slot + 1
            }
            if (owner >= 0) {
                this.connectionRequests[owner] = -1
                this.closeConnection(owner)
            }
            this.complete(request, 0, [], "", "timeout")
        }
        request = request + 1
    }
    // Resends and timeouts; a query that timed out is done.
    this.resolver.sweep(now)
    var slot = 0
    while (slot < this.connectionStates.size) {
        val state = this.connectionStates[slot]
        if (state == httpAsyncConnectionResolving) {
            if (this.resolver.done(this.connectionDnsQueries[slot])) {
                this.resolved(slot)
            }
        } else if (state == httpAsyncConnectionIdle &&
            now - this.connectionIdleSince[slot] >= this.options.idleTimeoutMilliseconds) {
            this.closeConnection(slot)
        } else if (state == httpAsyncConnectionH2) {
            // Timers of the HTTP/2 connection (our SETTINGS acknowledged, a PING answered), then idleness: GOAWAY(NO_ERROR) and close.
            this.connectionH2[slot].tick(now)
            this.h2Pump(slot)
            if (this.connectionStates[slot] == httpAsyncConnectionH2 && this.connectionH2[slot].openStreams() == 0 &&
                now - this.connectionIdleSince[slot] >= this.options.idleTimeoutMilliseconds) {
                this.connectionH2[slot].shutdown()
                this.h2Pump(slot)
                if (this.connectionStates[slot] != 0) this.closeConnection(slot)
            }
        }
        slot = slot + 1
    }
    return
}

// Queues a request and returns its id; the completion carries the same id.
fun HttpAsyncClient.request(
    method: string,
    url: string,
    headers: array<HttpHeader> = [],
    body: string = "",
    timeoutMilliseconds: int = 10000
): int = this.openRequest(method, url, headers, body, timeoutMilliseconds, false, -1)

private fun HttpAsyncClient.openRequest(
    method: string,
    url: string,
    headers: array<HttpHeader>,
    body: string,
    timeoutMilliseconds: int,
    streaming: bool,
    length: int
): int {
    val id = this.nextId
    this.nextId = this.nextId + 1
    val target = httpAsyncParseUrl(url)
    var slot = -1
    if (this.freeRequestCount > 0) {
        this.freeRequestCount = this.freeRequestCount - 1
        slot = this.freeRequests[this.freeRequestCount]
    } else {
        slot = this.requestStates.size
        this.requestIds.append(0)
        this.requestStates.append(0)
        this.requestKeys.append("")
        this.requestHosts.append("")
        this.requestPorts.append(0)
        this.requestSecure.append(false)
        this.requestPayloads.append("")
        this.requestDeadlines.append(0)
        this.requestStarted.append(0)
        this.requestRetried.append(false)
        this.requestMethods.append("")
        this.requestTargets.append("")
        this.requestAuthorities.append("")
        this.requestHeaderLists.append([])
        this.requestBodies.append("")
        this.requestSlots.append(-1)
        this.requestStreams.append(-1)
        this.requestStatuses.append(-1)
        this.requestResponseHeaders.append([])
        this.requestChunks.append([])
        this.requestTrailers.append([])
        this.requestStreaming.append(false)
        this.requestLengths.append(-1)
        this.requestIdle.append(0)
        this.streamStates.append(HttpAsyncStreamState())
    }
    val now = linuxMonotonicMilliseconds()
    this.requestIds[slot] = id
    this.requestStates[slot] = httpAsyncRequestQueued
    this.requestKeys[slot] =
        "${if (target.secure) "https" else "http"}://${target.host}:${target.port}"
    this.requestHosts[slot] = target.host
    this.requestPorts[slot] = target.port
    this.requestSecure[slot] = target.secure
    this.requestPayloads[slot] = httpAsyncRender(method, target, if (streaming) httpAsyncStreamHeaders(headers, length) else headers, body)
    this.requestDeadlines[slot] = now + timeoutMilliseconds
    this.requestStarted[slot] = now
    this.requestRetried[slot] = streaming
    this.requestMethods[slot] = method
    this.requestTargets[slot] = target.path
    this.requestAuthorities[slot] = httpAsyncAuthority(target)
    this.requestHeaderLists[slot] = headers
    this.requestBodies[slot] = body
    this.requestSlots[slot] = -1
    this.requestStreams[slot] = -1
    this.requestStatuses[slot] = -1
    this.requestResponseHeaders[slot] = []
    this.requestChunks[slot] = []
    this.requestTrailers[slot] = []
    this.requestStreaming[slot] = streaming
    this.requestLengths[slot] = length
    this.requestIdle[slot] = if (streaming) timeoutMilliseconds else 0
    this.streamStates[slot] = HttpAsyncStreamState(chunkedRequest = streaming && length < 0)
    this.activeRequests = this.activeRequests + 1
    if (!target.valid) this.complete(slot, 0, [], "", "invalid URL")
    else this.pumpEvents()
    id
}

fun HttpAsyncClient.get(url: string, headers: array<HttpHeader> = [],
    timeoutMilliseconds: int = 10000): int =
    this.request("GET", url, headers, "", timeoutMilliseconds)

fun HttpAsyncClient.postJson(url: string, json: string, headers: array<HttpHeader> = [],
    timeoutMilliseconds: int = 10000): int {
    val all: array<HttpHeader> = [HttpHeader("Content-Type", "application/json")]
    var index = 0
    while (index < headers.size) {
        all.append(headers[index])
        index = index + 1
    }
    this.request("POST", url, all, json, timeoutMilliseconds)
}

// ---------------------------------------------------------------------------
// HTTP/1.1 streaming requests (docs/design/http-streaming.md): the connection writes the request body and reads the response body at the same time. The response body waits in
// the request's inbox; reading stops while 192 KiB wait (the socket then fills and the peer stops) and goes on as readStream takes them; END comes after the last byte was read.

private val httpAsyncStreamHigh = 196608
private val httpAsyncStreamCap = 262144

private fun httpAsyncHex(value: int): string {
    if (value == 0) return "0"
    var out = ""
    var rest = value
    while (rest > 0) {
        val digit = rest % 16
        out = (if (digit < 10) "${digit}" else if (digit == 10) "a" else if (digit == 11) "b" else if (digit == 12) "c" else if (digit == 13) "d" else if (digit == 14) "e" else "f") + out
        rest = rest / 16
    }
    out
}

// The connection's read interest follows the request: off while its inbox is full.
fun HttpAsyncClient.streamInterest(slot: int, write: bool): void {
    val request = this.connectionRequests[slot]
    val read = !(request >= 0 && this.streamStates[request].paused)
    this.poller.modifyDescriptor(this.connectionDescriptors[slot], read, write)
    this.connectionWriteInterest[slot] = write
    return
}

fun HttpAsyncClient.startStream(slot: int, request: int): void {
    this.connectionStates[slot] = httpAsyncConnectionStreaming
    this.connectionOutputs[slot] = this.requestPayloads[request]
    this.connectionOutputOffsets[slot] = 0
    this.connectionInputs[slot] = ""
    this.connectionHeaderEnds[slot] = -1
    this.connectionUsed[slot] = this.connectionUsed[slot] + 1
    this.requestSlots[request] = slot
    this.streamTouch(request)
    // The request body can start now (a request with length 0 has none).
    if (this.requestLengths[request] != 0) this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_WRITABLE, this.requestIds[request]))
    this.streamWrite(slot)
    return
}

// Writes what is queued until the socket would block; tells a blocked writeBody when half of the cap is free again.
fun HttpAsyncClient.streamWrite(slot: int): void {
    var writing = this.connectionStates[slot] == httpAsyncConnectionStreaming
    while (writing) {
        val offset = this.connectionOutputOffsets[slot]
        val output = this.connectionOutputs[slot]
        if (offset >= output.size) {
            this.connectionOutputs[slot] = ""
            this.connectionOutputOffsets[slot] = 0
            this.streamInterest(slot, false)
            writing = false
        } else if (this.connectionSecure[slot]) {
            val written = this.tlsWrite(slot, output, offset)
            if (written > 0) this.connectionOutputOffsets[slot] = offset + written
            else if (written == -3 || written == -2) {
                this.streamInterest(slot, written == -3)
                writing = false
            } else {
                this.fail(slot, "tls write failed")
                return
            }
        } else {
            var connection = TcpConnection(this.connectionDescriptors[slot])
            val result = connection.writeCompact(output, offset)
            connection.descriptor = -1
            if (result.written > 0) this.connectionOutputOffsets[slot] = offset + result.written
            if (result.status == "error") {
                if (result.errorCode == 11) this.streamInterest(slot, true)
                else {
                    this.fail(slot, "write failed")
                    return
                }
                writing = false
            }
        }
    }
    val request = this.connectionRequests[slot]
    if (request >= 0 && this.streamStates[request].blocked && this.connectionOutputs[slot].size - this.connectionOutputOffsets[slot] <= httpAsyncStreamCap / 2) {
        this.streamStates[request].blocked = false
        this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_WRITABLE, this.requestIds[request]))
    }
    return
}

// Reads what the socket has (until it would block or the inbox is full) and parses it.
fun HttpAsyncClient.streamRead(slot: int): void {
    var reading = true
    while (reading && this.connectionStates[slot] == httpAsyncConnectionStreaming) {
        val request = this.connectionRequests[slot]
        if (request < 0 || this.streamStates[request].paused) return
        if (this.connectionSecure[slot]) this.tlsRead(slot)
        else httpAsyncPlainRead(this.connectionDescriptors[slot], this.reader)
        val status = this.reader.status
        val chunk = this.reader.text
        this.reader.text = ""
        if (status > 0) {
            this.connectionInputs[slot] = if (this.connectionInputs[slot] == "") chunk else "${this.connectionInputs[slot]}$chunk"
            this.streamParse(slot, false)
            this.streamTouch(request)
        } else {
            val secure = this.connectionSecure[slot]
            val wouldBlock = if (secure) status == -2 || status == -3 else status == -11
            if (wouldBlock) {
                if (secure && status == -3) this.streamInterest(slot, true)
            } else this.streamParse(slot, true)
            reading = false
        }
    }
    return
}

// Takes the headers (once) and then the body bytes out of the connection's input into the request's inbox, by the response's framing.
fun HttpAsyncClient.streamParse(slot: int, eof: bool): void {
    val request = this.connectionRequests[slot]
    if (request < 0) return
    var input = this.connectionInputs[slot]
    if (this.streamStates[request].framing == 0) {
        val finalOffset = httpFinalResponseOffset(input)
        if (finalOffset > 0) input = input.slice(finalOffset, input.size)
        val headerEnd = httpHeaderEnd(input)
        if (headerEnd < 0) {
            this.connectionInputs[slot] = input
            if (eof) this.fail(slot, "connection closed before response")
            else if (input.size > 65536) this.fail(slot, "response header too large")
            return
        }
        val response = httpParseResponseBounded(input.slice(0, headerEnd), 0).response
        if (httpResponseLengthsDiffer(response.headers)) {
            this.fail(slot, "conflicting Content-Length headers")
            return
        }
        val transferEncoding = response.header("Transfer-Encoding")
        val lengthHeader = response.header("Content-Length")
        var keepAlive = !httpCoreHeaderTokenContains(response.header("Connection"), "close") && textFindSequence(input, "HTTP/1.1", 0, 8) == 0
        var framing = 3
        var left = 0
        val isHead = httpRequestIsHead(this.requestPayloads[request])
        if (isHead || (response.status >= 100 && response.status < 200) || response.status == 204 || response.status == 304) framing = 4
        else if (httpCoreHeaderTokenContains(transferEncoding, "chunked")) framing = 2
        else if (transferEncoding == "" && lengthHeader != "") {
            left = httpDecimalLength(lengthHeader, 9223372036854775807)
            if (left < 0) {
                this.fail(slot, "invalid Content-Length")
                return
            }
            framing = 1
        }
        if (response.status == 101 || framing == 3) keepAlive = false
        this.streamStates[request].framing = framing
        this.streamStates[request].left = left
        this.streamStates[request].keepAlive = keepAlive
        this.streamStates[request].status = response.status
        this.streamStates[request].headers = response.headers
        this.requestStatuses[request] = response.status
        this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_HEADERS, this.requestIds[request], status = response.status, headers = response.headers))
        input = input.slice(headerEnd, input.size)
    }
    val wasEmpty = this.streamStates[request].inbox.size == 0
    var complete = false
    var broken = false
    var more = true
    while (more && !complete && !broken) {
        val framing = this.streamStates[request].framing
        if (framing == 4) complete = true
        else if (framing == 1) {
            val take = if (input.size < this.streamStates[request].left) input.size else this.streamStates[request].left
            if (take > 0) {
                this.streamStates[request].inbox = this.streamStates[request].inbox + (if (take == input.size) input else input.slice(0, take))
                input = input.slice(take, input.size)
                this.streamStates[request].left = this.streamStates[request].left - take
            }
            if (this.streamStates[request].left == 0) complete = true
            else more = false
        } else if (framing == 3) {
            if (input.size > 0) {
                this.streamStates[request].inbox = this.streamStates[request].inbox + input
                input = ""
            }
            if (eof) complete = true
            more = false
        } else {
            // chunked
            val phase = this.streamStates[request].phase
            if (phase == 0) {
                val lineEnd = textFindSequence(input, "\r\n", 0, input.size)
                if (lineEnd < 0) {
                    if (input.size > 4096) broken = true
                    more = false
                } else {
                    var digits = input.slice(0, lineEnd)
                    val semicolon = digits.indexOf(";")
                    if (semicolon >= 0) digits = digits.slice(0, semicolon)
                    var size = 0
                    var valid = digits.size > 0
                    for (i in 0 until digits.size) {
                        val c = digits[i]
                        val digit = if (c >= 48 && c <= 57) c - 48 else if (c >= 97 && c <= 102) c - 87 else if (c >= 65 && c <= 70) c - 55 else -1
                        if (digit < 0 || size > 1152921504606846975) valid = false
                        else size = size * 16 + digit
                    }
                    if (!valid) broken = true
                    else {
                        input = input.slice(lineEnd + 2, input.size)
                        this.streamStates[request].left = size
                        this.streamStates[request].phase = if (size == 0) 3 else 1
                    }
                }
            } else if (phase == 1) {
                val take = if (input.size < this.streamStates[request].left) input.size else this.streamStates[request].left
                if (take > 0) {
                    this.streamStates[request].inbox = this.streamStates[request].inbox + (if (take == input.size) input else input.slice(0, take))
                    input = input.slice(take, input.size)
                    this.streamStates[request].left = this.streamStates[request].left - take
                }
                if (this.streamStates[request].left == 0) this.streamStates[request].phase = 2
                else more = false
            } else if (phase == 2) {
                if (input.size < 2) more = false
                else if (input[0] != 13 || input[1] != 10) broken = true
                else {
                    input = input.slice(2, input.size)
                    this.streamStates[request].phase = 0
                }
            } else {
                // After the last chunk: trailer fields, then an empty line.
                if (input.size >= 2 && input[0] == 13 && input[1] == 10) {
                    input = input.slice(2, input.size)
                    complete = true
                } else {
                    val end = textFindSequence(input, "\r\n\r\n", 0, input.size)
                    if (end < 0) {
                        if (input.size > 65536) broken = true
                        more = false
                    } else {
                        this.streamStates[request].trailers = httpParseResponseBounded("HTTP/1.1 200 OK\r\n" + input.slice(0, end + 4), 0).response.headers
                        input = input.slice(end + 4, input.size)
                        complete = true
                    }
                }
            }
        }
    }
    this.connectionInputs[slot] = input
    if (broken) {
        this.fail(slot, "invalid chunked response")
        return
    }
    if (!complete && eof) {
        this.fail(slot, "connection closed mid-response")
        return
    }
    if (complete) this.streamStates[request].ended = true
    if (wasEmpty && this.streamStates[request].inbox.size > 0) this.streamEvents.append(HttpAsyncStreamEvent(HTTP_STREAM_READABLE, this.requestIds[request]))
    if (this.streamStates[request].inbox.size >= httpAsyncStreamHigh && !this.streamStates[request].ended) {
        // Enough waits: the socket is not read until readStream takes some.
        this.streamStates[request].paused = true
        this.streamInterest(slot, this.connectionWriteInterest[slot])
    }
    if (this.streamStates[request].ended && this.streamStates[request].inbox.size == 0) this.streamFinish(slot)
    return
}

// The response is whole and was read: END, and the connection is kept for another request when both bodies are done and the server allows it.
fun HttpAsyncClient.streamFinish(slot: int): void {
    val request = this.connectionRequests[slot]
    if (request < 0) return
    val keepAlive = this.streamStates[request].keepAlive
    val bodyDone = this.streamStates[request].bodyDone
    val status = this.streamStates[request].status
    val headers: array<HttpHeader> = []
    for (header in this.streamStates[request].headers) headers.append(header)
    val trailers: array<HttpHeader> = []
    for (header in this.streamStates[request].trailers) trailers.append(header)
    val reusable = keepAlive && (bodyDone || this.requestLengths[request] == 0) && this.connectionOutputs[slot].size == 0 && this.connectionInputs[slot] == ""
    this.connectionRequests[slot] = -1
    this.requestTrailers[request] = trailers
    this.complete(request, status, headers, "", "", "http/1.1")
    if (reusable) {
        this.connectionStates[slot] = httpAsyncConnectionIdle
        this.connectionIdleSince[slot] = linuxMonotonicMilliseconds()
        this.poller.modifyDescriptor(this.connectionDescriptors[slot], true, false)
        this.connectionWriteInterest[slot] = false
    } else this.closeConnection(slot)
    return
}

// ---------------------------------------------------------------------------
// Streaming requests (docs/design/http-streaming.md). Over HTTP/2 for now: the response body waits in the stream (it is read with readStream, and the peer is credited as it is
// read), the request body is written with writeBody. The events (takeStreamEvents) say when: HEADERS, READABLE, WRITABLE, END, ERROR; an id ends with exactly one END or ERROR.
// `idleTimeoutMilliseconds` is not a total: it counts from the last event, read or accepted write. Start writing a body after the first WRITABLE (before it writeBody takes 0).

fun HttpAsyncClient.requestStream(
    method: string,
    url: string,
    headers: array<HttpHeader> = [],
    length: int = -1,
    idleTimeoutMilliseconds: int = 30000
): int = this.openRequest(method, url, headers, "", idleTimeoutMilliseconds, true, length)

fun HttpAsyncClient.getStream(url: string, headers: array<HttpHeader> = [], idleTimeoutMilliseconds: int = 30000): int =
    this.openRequest("GET", url, headers, "", idleTimeoutMilliseconds, true, 0)

// The request slot of a live streaming request, or -1.
private fun HttpAsyncClient.streamRequest(id: int): int {
    for (request in 0 until this.requestStates.size) {
        if (this.requestStates[request] != 0 && this.requestStreaming[request] && this.requestIds[request] == id) return request
    }
    -1
}

// The connection slot whose HTTP/2 connection carries the request's stream, or -1 (not attached yet).
private fun HttpAsyncClient.streamCarrier(request: int): int {
    val slot = this.requestSlots[request]
    if (slot >= 0 && this.requestStreams[request] >= 0 && this.connectionStates[slot] == httpAsyncConnectionH2) slot else -1
}

private fun HttpAsyncClient.streamTouch(request: int): void {
    if (this.requestIdle[request] > 0) this.requestDeadlines[request] = linuxMonotonicMilliseconds() + this.requestIdle[request]
    return
}

// The connection slot of a live HTTP/1.1 streaming request, or -1.
private fun HttpAsyncClient.streamHttp1(request: int): int {
    val slot = this.requestSlots[request]
    if (slot >= 0 && this.connectionStates[slot] == httpAsyncConnectionStreaming && this.connectionRequests[slot] == request) slot else -1
}

private fun HttpAsyncClient.writeBodyHttp1(slot: int, request: int, chunk: string): int {
    if (this.streamStates[request].bodyDone) return -1
    if (chunk.size == 0) return 0
    val unsent = this.connectionOutputs[slot].size - this.connectionOutputOffsets[slot]
    val room = httpAsyncStreamCap - unsent
    if (room <= 0) {
        this.streamStates[request].blocked = true
        return 0
    }
    val taken = if (chunk.size < room) chunk.size else room
    if (taken < chunk.size) this.streamStates[request].blocked = true
    val piece = if (taken == chunk.size) chunk else chunk.slice(0, taken)
    val framed = if (this.streamStates[request].chunkedRequest) "${httpAsyncHex(taken)}\r\n$piece\r\n" else piece
    val kept = if (unsent > 0) this.connectionOutputs[slot].slice(this.connectionOutputOffsets[slot], this.connectionOutputs[slot].size) else ""
    this.connectionOutputs[slot] = kept + framed
    this.connectionOutputOffsets[slot] = 0
    this.streamTouch(request)
    this.streamWrite(slot)
    taken
}

private fun HttpAsyncClient.finishBodyHttp1(slot: int, request: int): void {
    if (this.streamStates[request].bodyDone) return
    this.streamStates[request].bodyDone = true
    if (this.streamStates[request].chunkedRequest) {
        val unsent = this.connectionOutputs[slot].size - this.connectionOutputOffsets[slot]
        val kept = if (unsent > 0) this.connectionOutputs[slot].slice(this.connectionOutputOffsets[slot], this.connectionOutputs[slot].size) else ""
        this.connectionOutputs[slot] = kept + "0\r\n\r\n"
        this.connectionOutputOffsets[slot] = 0
    }
    this.streamTouch(request)
    this.streamWrite(slot)
    return
}

private fun HttpAsyncClient.readStreamHttp1(slot: int, request: int, maximum: int): string {
    val inbox = this.streamStates[request].inbox
    if (inbox.size == 0 || maximum <= 0) return ""
    val count = if (inbox.size < maximum) inbox.size else maximum
    val data = if (count == inbox.size) inbox else inbox.slice(0, count)
    this.streamStates[request].inbox = if (count == inbox.size) "" else inbox.slice(count, inbox.size)
    this.streamTouch(request)
    if (this.streamStates[request].paused && this.streamStates[request].inbox.size < httpAsyncStreamHigh / 2) {
        // Room again: read on (what the TLS session still holds does not announce itself).
        this.streamStates[request].paused = false
        this.streamInterest(slot, this.connectionWriteInterest[slot])
        this.streamRead(slot)
    }
    if (this.connectionRequests[slot] == request && this.streamStates[request].ended && this.streamStates[request].inbox.size == 0) this.streamFinish(slot)
    data
}

/** Writes request body bytes: returns how many were taken (a prefix of `chunk`), 0 when the stream cannot take more now (wait for WRITABLE), -1 when the id is not a live streaming request. */
fun HttpAsyncClient.writeBody(id: int, chunk: string): int {
    val request = this.streamRequest(id)
    if (request < 0) return -1
    val one = this.streamHttp1(request)
    if (one >= 0) return this.writeBodyHttp1(one, request, chunk)
    val carrier = this.streamCarrier(request)
    if (carrier < 0) return 0
    val taken = this.connectionH2[carrier].writeBody(this.requestStreams[request], chunk)
    if (taken > 0) this.streamTouch(request)
    this.h2Pump(carrier)
    taken
}

/** The request body is complete (the stream's END_STREAM follows what is still queued). */
fun HttpAsyncClient.finishBody(id: int): void {
    val request = this.streamRequest(id)
    if (request < 0) return
    val one = this.streamHttp1(request)
    if (one >= 0) {
        this.finishBodyHttp1(one, request)
        return
    }
    val carrier = this.streamCarrier(request)
    if (carrier < 0) return
    this.connectionH2[carrier].finishBody(this.requestStreams[request])
    this.streamTouch(request)
    this.h2Pump(carrier)
    return
}

/** Up to `maximum` bytes of the response body. Reading is what credits the peer: not reading stalls it after one stream window. "" when nothing waits. */
fun HttpAsyncClient.readStream(id: int, maximum: int = 65536): string {
    val request = this.streamRequest(id)
    if (request < 0) return ""
    val one = this.streamHttp1(request)
    if (one >= 0) return this.readStreamHttp1(one, request, maximum)
    val carrier = this.streamCarrier(request)
    if (carrier < 0) return ""
    val data = this.connectionH2[carrier].takeData(this.requestStreams[request], maximum)
    if (data.size > 0) this.streamTouch(request)
    this.h2Pump(carrier)
    data
}

/** The response bytes that wait to be read. */
fun HttpAsyncClient.streamPending(id: int): int {
    val request = this.streamRequest(id)
    if (request < 0) return 0
    if (this.streamHttp1(request) >= 0) return this.streamStates[request].inbox.size
    val carrier = this.streamCarrier(request)
    if (carrier < 0) return 0
    this.connectionH2[carrier].pendingData(this.requestStreams[request])
}

/** The stream events since the last call. */
fun HttpAsyncClient.takeStreamEvents(): array<HttpAsyncStreamEvent> {
    val taken: array<HttpAsyncStreamEvent> = []
    for (event in this.streamEvents) taken.append(event)
    this.streamEvents = []
    taken
}

/** Gives up on a streaming request: RST_STREAM(CANCEL); its last event is an ERROR "cancelled". */
fun HttpAsyncClient.cancelStream(id: int): void {
    val request = this.streamRequest(id)
    if (request < 0) return
    val carrier = this.streamCarrier(request)
    if (carrier >= 0) {
        this.connectionH2[carrier].cancel(this.requestStreams[request])
        if (this.connectionH2[carrier].openStreams() == 0) this.connectionIdleSince[carrier] = linuxMonotonicMilliseconds()
        this.complete(request, 0, [], "", "cancelled")
        this.h2Pump(carrier)
    } else {
        var owner = -1
        var slot = 0
        while (owner < 0 && slot < this.connectionStates.size) {
            if (this.connectionStates[slot] != 0 && this.connectionRequests[slot] == request) owner = slot
            slot = slot + 1
        }
        if (owner >= 0) {
            this.connectionRequests[owner] = -1
            this.closeConnection(owner)
        }
        this.complete(request, 0, [], "", "cancelled")
    }
    return
}

// Progresses every request for up to `timeoutMilliseconds` (0 never blocks).
fun HttpAsyncClient.step(timeoutMilliseconds: int = 0): int {
    var timeout = timeoutMilliseconds
    if (timeout < 0) timeout = 0
    if (this.activeRequests > 0 && timeout > 50) timeout = 50
    val records = this.poller.waitCompact(256, timeout)
    var handled = 0
    var index = 0
    while (index + 12 <= records.size) {
        val flags = textReadU32LittleEndian(records, index)
        val descriptor = textReadU32LittleEndian(records, index + 4)
        if (descriptor >= 0 && descriptor < this.routes.size) {
            val route = this.routes[descriptor]
            if (route >= 0) {
                val slot = route / 2
                val readable = (flags & 1) != 0
                val writable = (flags & 4) != 0
                val failed = (flags & 8) != 0 || (flags & 16) != 0 ||
                    (flags & 8192) != 0
                if (route - slot * 2 == 1) {
                    if (this.connectionStates[slot] == httpAsyncConnectionResolving) {
                        this.dnsReady(slot)
                    }
                } else if (this.connectionStates[slot] != 0) {
                    this.socketReady(slot, readable, writable, failed)
                }
                handled = handled + 1
            }
        }
        index = index + 12
    }
    this.sweep(linuxMonotonicMilliseconds())
    this.pumpEvents()
    handled
}

fun HttpAsyncClient.takeCompletions(): array<HttpAsyncCompletion> {
    val taken: array<HttpAsyncCompletion> = []
    var index = 0
    while (index < this.completions.size) {
        taken.append(this.completions[index])
        index = index + 1
    }
    this.completions = []
    taken
}

fun HttpAsyncClient.pending(): int = this.activeRequests

// The poller descriptor; register it with another event loop (for example
// WebSocketServer.watchExternal) to wake when any request makes progress.
fun HttpAsyncClient.pollDescriptor(): int = this.poller.descriptor
