// OpenSSL calls needed to drive a client session over a nonblocking socket.
// The shared hosted TLS declarations provide the rest (and trigger linking).

import "../../tls/hosted/openssl.ab"

trusted noescape extern:"c" fun SSL_get_error(session: i64*, result: i32): i32
trusted noescape extern:"c" fun SSL_pending(session: i64*): i32
