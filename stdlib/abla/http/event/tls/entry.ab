// An epoll HTTPS server with HTTP/2: the HTTP/1.1 event server's API over TLS (abla/tls/pure, no OpenSSL), and HTTP/2 chosen by ALPN. Each connection starts a TLS
// handshake (nonblocking, bounded by `handshakeTimeoutMilliseconds`); when it is done the ALPN result decides the protocol: "h2" runs the connection as an H2Server
// (abla/http/h2/server: streams, flow control, the Rapid Reset, CONTINUATION and flood limits), anything else is HTTP/1.1 as in abla/http/event (the same framing, limits
// and responses). Without TLS the server speaks plain TCP: HTTP/1.1, and h2c with prior knowledge for a connection that begins with the HTTP/2 preface (no Upgrade: h2c).
//
//     val tls = httpsEventServerTls("fullchain.pem", "privkey.pem")     // null if the certificate or key failed to load
//     val server = httpsEventServer(router, ipv4Any(443), tls)
//     while (true) server.step(1000)
//
// The handler (or router) is the one of HttpEventServer: `(HttpRequest) -> HttpResponse`, called once per request (once per stream over HTTP/2, when the request is whole),
// on the event loop's thread. A handler that is slow stalls every connection, as there.

import "abla/http"
import "abla/http/stream"
import "abla/http/event"
import "abla/http/h2"
import "abla/http/h2/server"
import "abla/net"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/text"
import "abla/tls/pure"
import "abla/tls/pure/server"

class HttpsEventServerOptions(
    val base: HttpEventServerOptions = httpEventServerOptions(),
    // Serve HTTP/2 (ALPN h2, and h2c on plain connections).
    val http2: bool = true,
    // Serve HTTP/1.1. False makes the port HTTP/2 only: a TLS client that does not pick h2 is refused, a plain connection is taken as h2c whatever it sends first.
    val http1: bool = true,
    val maximumStreams: int = 100,
    val maximumHeaderListBytes: int = 65536,
    // A connection that has not finished its TLS handshake after this long is closed.
    val handshakeTimeoutMilliseconds: int = 5000
)

// ---- streaming routes ----
// A route registered with `server.streamRoute(method, path, handler)` is served by an `HttpStreamHandler` instead of the buffered handler: the handler hears of the request when its headers
// arrive and of its body as it comes, and writes the response as it makes it. The callbacks run on the event loop's thread and must not block. Each returns a `HttpStreamStep`, what the server
// is to do next (all of it optional): answer (`respond`), write response bytes (`write`), end the response (`finish`, with `trailers`), pause or resume the request body (`pause`), abort the
// exchange. A step can also be given from outside the callbacks, by id: `server.streamStep(exchange.id, step)` (a server-sent-events producer, a handler that waits for something else).
//
// Backpressure: the body of a request is passed on as it comes and its receive window is credited as each piece is dealt with; a handler that answers `pause` holds the credit back until a step
// with `resume`, and the client stalls after one stream window (HTTP/2) or when the socket fills (HTTP/1.1). Response bytes are accepted up to `exchange.room`; what a handler writes past it is kept by the
// server and sent first, and `onWritable` is called once it is all out. The server holds no more than a window of request body and 256 KiB of response per exchange. A handler that keeps what it is
// given (the body in memory, an unbounded queue of response) is its own memory bound: `maximumStreamBodyBytes` of the route bounds the body, 0 (the default) does not.
// No gzip is applied to a streamed response. HTTP/2 and HTTP/1.1 behave the same.

/** What the server tells a streaming handler about its exchange. `room` is how many response bytes can be written now, `requestBytes` how much of the request body has arrived. */
class HttpStreamExchange(
    val id: int,
    val method: string,
    val path: string,
    val query: string,
    val headers: array<HttpHeader>,
    val peer: SocketPeerAddress?,
    var room: int = 0,
    var requestBytes: int = 0,
    var responded: bool = false,
    var requestEnded: bool = false
)

val HTTP_STREAM_NO_CHANGE = 0
val HTTP_STREAM_PAUSE = 1
val HTTP_STREAM_RESUME = 2
// Pause the request body only if what this step wrote did not fit in the response (the server kept the rest): it is resumed by itself once that is all out. The pattern of an echo or a proxy;
// deciding from `exchange.room` instead races with the room that opens while the step is applied.
val HTTP_STREAM_PAUSE_FOR_ROOM = 3

class HttpStreamStep(
    val respond: bool = false,
    val status: int = 200,
    val headers: array<HttpHeader> = [],
    // The response body's size when known (content-length; 0 ends the response), -1 when not.
    val length: int = -1,
    val write: string = "",
    val finish: bool = false,
    val trailers: array<HttpHeader> = [],
    // HTTP_STREAM_PAUSE: no more credit for the request body until HTTP_STREAM_RESUME.
    val pause: int = 0,
    val abort: bool = false,
    // true: call onWritable once the response has room again (a producer that writes as the client takes it).
    val wantWritable: bool = false
)

interface HttpStreamHandler {
    fun onRequest(exchange: HttpStreamExchange): HttpStreamStep
    fun onData(exchange: HttpStreamExchange, chunk: string): HttpStreamStep
    fun onEnd(exchange: HttpStreamExchange, trailers: array<HttpHeader>): HttpStreamStep
    fun onWritable(exchange: HttpStreamExchange): HttpStreamStep
    fun onAbort(exchange: HttpStreamExchange, reason: string): void
}

class HttpsStreamRoute(val method: string, val path: string, val handler: HttpStreamHandler, val maximumBodyBytes: int)

// One live exchange: where it runs, what is held back for it.
class HttpsExchange(
    val exchange: HttpStreamExchange,
    val slot: int,
    val stream: int,
    val route: int,
    var paused: bool = false,
    // Request bytes the handler paused on: credited at the resume.
    var held: int = 0,
    // Response bytes the handler wrote past the room: sent first.
    var pending: string = "",
    var finishing: bool = false,
    var wantWritable: bool = false,
    var resumeOnDrain: bool = false,
    var blockedWrite: bool = false,
    // HTTP/1.1 (stream 0): the request body's framing (0 none, 1 Content-Length with `reqLeft` to come, 2 chunked with `reqPhase`), the response's (chunked when its length is unknown), and whether the
    // connection stays for another request. `discarding`: the response ended before the request did, the rest of the request is thrown away.
    var h1: bool = false,
    var reqFraming: int = 0,
    var reqLeft: int = 0,
    var reqPhase: int = 0,
    var reqEnded: bool = false,
    var chunkedResponse: bool = false,
    var headResponse: bool = false,
    var responseDone: bool = false,
    var keepAlive: bool = true,
    var discarding: bool = false,
    var requestTrailers: array<HttpHeader> = [],
    var trailers: array<HttpHeader> = []
)

// Connection states.
private val httpsFree = 0
private val httpsHandshaking = 1
// Plain connection whose first bytes decide between HTTP/1.1 and h2c.
private val httpsSniffing = 2
private val httpsHttp1 = 3
private val httpsHttp2 = 4

resource class HttpsEventServer(
    val handler: (HttpRequest) -> HttpResponse,
    val listener: TcpListener,
    val poller: SocketPoller,
    val options: HttpsEventServerOptions,
    val tls: TlsServerConfig?,
    val descriptors: array<int>,
    val descriptorSlots: array<int>,
    val states: array<int>,
    val sessions: array<TlsServerSession>,
    val h2: array<H2Server>,
    val inputs: array<string>,
    val outputs: array<string>,
    val outputOffsets: array<int>,
    val writeWatching: array<bool>,
    val requestCounts: array<int>,
    val closing: array<bool>,
    val lastActivity: array<int>,
    val started: array<int>,
    val peers: array<SocketPeerAddress?>,
    var draining: bool,
    var stopped: bool,
    var drainDeadline: int,
    var pass: int,
    // Streaming routes and their live exchanges (registered with streamRoute).
    val streamRoutes: array<HttpsStreamRoute> = [],
    val exchanges: array<HttpsExchange> = [],
    var nextExchange: int = 1
) {
    fun drop(): void {
        var index = 0
        while (index < this.descriptors.size) {
            if (this.descriptors[index] >= 0) {
                linuxTcpCloseDescriptor(this.descriptors[index])
                this.descriptors[index] = -1
            }
            index = index + 1
        }
        this.poller.close()
        this.listener.close()
        this.stopped = true
        return
    }
}

/** The certificate chain and private key (PEM files, such as an ACME client's fullchain.pem and privkey.pem) as a TLS configuration that offers h2 and http/1.1, or null
 *  when either failed to load. Keep it for the life of the server. */
fun httpsEventServerTls(certificatePath: string, privateKeyPath: string, http2: bool = true): TlsServerConfig? =
    httpsEventServerTlsPem(linuxReadFile(certificatePath, 1048576), linuxReadFile(privateKeyPath, 1048576), http2)

fun httpsEventServerTlsPem(certificatePem: string, privateKeyPem: string, http2: bool = true): TlsServerConfig? {
    val config = tlsServerConfigFromPem(certificatePem, privateKeyPem)
    if (config == null) return null
    tlsServerConfigWithAlpn(config, if (http2) ["h2", "http/1.1"] else ["http/1.1"])
}

private fun httpsRouterHandler(router: HttpRouter): (HttpRequest) -> HttpResponse =
    { request: HttpRequest -> router.dispatch(request) }

fun httpsEventServer(
    router: HttpRouter,
    address: Ipv4SocketAddress,
    tls: TlsServerConfig? = null,
    options: HttpsEventServerOptions = HttpsEventServerOptions(),
    reusePort: bool = false
): HttpsEventServer = httpsEventServerHandler(httpsRouterHandler(router), address, tls, options, reusePort)

fun httpsEventServerHandler(
    handler: (HttpRequest) -> HttpResponse,
    address: Ipv4SocketAddress,
    tls: TlsServerConfig? = null,
    options: HttpsEventServerOptions = HttpsEventServerOptions(),
    reusePort: bool = false
): HttpsEventServer {
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) poller.watchDescriptor(listener.descriptor)
    HttpsEventServer(handler, move(listener), move(poller), options, tls, [], [], [], [], [], [], [], [], [], [], [], [], [], [], false, false, 0, linuxMonotonicMilliseconds())
}

// ---- streaming routes: the server side ----
/** Serves `method` `path` (exactly, no query) with `handler`. `maximumStreamBodyBytes` bounds the request body of the route: 0 is no limit (the handler's memory is its own). Routes are read
 *  when a connection starts: register them before the first `step`. */
fun HttpsEventServer.streamRoute(method: string, path: string, handler: HttpStreamHandler, maximumStreamBodyBytes: int = 0): void {
    this.streamRoutes.append(HttpsStreamRoute(method, path, handler, maximumStreamBodyBytes))
    return
}

private fun HttpsEventServer.routeFor(method: string, path: string): int {
    for (i in 0 until this.streamRoutes.size) {
        if (this.streamRoutes[i].method == method && this.streamRoutes[i].path == path) return i
    }
    -1
}

private fun HttpsEventServer.exchangeAt(slot: int, stream: int): int {
    for (i in 0 until this.exchanges.size) {
        if (this.exchanges[i].slot == slot && this.exchanges[i].stream == stream) return i
    }
    -1
}

private fun HttpsEventServer.exchangeById(id: int): int {
    for (i in 0 until this.exchanges.size) {
        if (this.exchanges[i].exchange.id == id) return i
    }
    -1
}

/** Gives a step to a live exchange from outside the handler's callbacks (see the section above). False when the id is not a live exchange. */
fun HttpsEventServer.streamStep(id: int, step: HttpStreamStep): bool {
    val index = this.exchangeById(id)
    if (index < 0) return false
    val slot = this.exchanges[index].slot
    this.applyStep(id, step)
    this.streamRound(slot)
    this.flush(slot)
    true
}

private fun HttpsEventServer.removeExchange(id: int): void {
    val index = this.exchangeById(id)
    if (index >= 0) this.exchanges.takeAt(index)
    return
}

// ---- the transport of an exchange: HTTP/2 stream or HTTP/1.1 connection ----
private fun HttpsEventServer.xRoom(index: int): int {
    val slot = this.exchanges[index].slot
    if (!this.exchanges[index].h1) return this.h2[slot].responseRoom(this.exchanges[index].stream)
    if (!this.exchanges[index].exchange.responded || this.exchanges[index].responseDone) return 0
    val room = httpsStreamCap - (this.outputs[slot].size - this.outputOffsets[slot])
    if (room < 0) 0 else room
}

// Answers the exchange; false when it cannot be.
private fun HttpsEventServer.xRespond(index: int, status: int, headers: array<HttpHeader>, length: int): bool {
    val slot = this.exchanges[index].slot
    if (!this.exchanges[index].h1) return this.h2[slot].respondStream(this.exchanges[index].stream, status, headers, length)
    if (status < 200 || status > 599 || this.exchanges[index].exchange.responded) return false
    var head = "HTTP/1.1 $status ${httpStatusReason(status)}\r\n"
    for (h in headers) {
        val name = h.name.lowercase()
        if (name == "content-length" || name == "transfer-encoding" || name == "connection") continue
        head = head + "${h.name}: ${h.value}\r\n"
    }
    val noBody = this.exchanges[index].headResponse || status == 204 || status == 304
    if (noBody) { /* no body framing */ }
    else if (length >= 0) head = head + "Content-Length: $length\r\n"
    else {
        head = head + "Transfer-Encoding: chunked\r\n"
        this.exchanges[index].chunkedResponse = true
    }
    head = head + (if (this.exchanges[index].keepAlive) "Connection: keep-alive\r\n\r\n" else "Connection: close\r\n\r\n")
    this.xAppend(slot, head)
    // The response of a HEAD, of length 0 or without a body is complete with its head.
    if (noBody || length == 0) this.exchanges[index].responseDone = true
    true
}

// Appends bytes to the connection's output (the unsent part stays; the sent part goes).
private fun HttpsEventServer.xAppend(slot: int, bytes: string): void {
    val offset = this.outputOffsets[slot]
    val kept = if (offset > 0 && offset < this.outputs[slot].size) this.outputs[slot].slice(offset, this.outputs[slot].size) else if (offset == 0) this.outputs[slot] else ""
    this.outputs[slot] = kept + bytes
    this.outputOffsets[slot] = 0
    return
}

// Writes response bytes; returns how many were taken, 0 when the response is full, -1 when the exchange is not writable.
private fun HttpsEventServer.xWrite(index: int, chunk: string): int {
    val slot = this.exchanges[index].slot
    if (!this.exchanges[index].h1) return this.h2[slot].writeResponse(this.exchanges[index].stream, chunk)
    if (!this.exchanges[index].exchange.responded || (this.exchanges[index].responseDone && !this.exchanges[index].headResponse)) return -1
    // A HEAD response has no body: what is written is dropped.
    if (this.exchanges[index].headResponse) return chunk.size
    val room = this.xRoom(index)
    if (room <= 0) return 0
    val taken = if (chunk.size < room) chunk.size else room
    val piece = if (taken == chunk.size) chunk else chunk.slice(0, taken)
    this.xAppend(slot, if (this.exchanges[index].chunkedResponse) "${httpsHex(taken)}\r\n$piece\r\n" else piece)
    taken
}

private fun HttpsEventServer.xEnd(index: int, trailers: array<HttpHeader>): void {
    val slot = this.exchanges[index].slot
    if (!this.exchanges[index].h1) {
        this.h2[slot].endResponse(this.exchanges[index].stream, trailers)
        return
    }
    if (this.exchanges[index].chunkedResponse && !this.exchanges[index].responseDone) {
        var end = "0\r\n"
        for (t in trailers) end = end + "${t.name}: ${t.value}\r\n"
        this.xAppend(slot, end + "\r\n")
    }
    this.exchanges[index].responseDone = true
    return
}

private fun HttpsEventServer.xAbort(index: int, code: int): void {
    val slot = this.exchanges[index].slot
    if (!this.exchanges[index].h1) this.h2[slot].abortStream(this.exchanges[index].stream, code)
    else this.closeSlot(slot)
    return
}

// The request body credit held back is given: HTTP/2 window credit, HTTP/1.1 reading again.
private fun HttpsEventServer.xRelease(index: int): void {
    val slot = this.exchanges[index].slot
    if (!this.exchanges[index].h1) {
        if (this.exchanges[index].held > 0) {
            this.h2[slot].consumed(this.exchanges[index].stream, this.exchanges[index].held)
            this.exchanges[index].held = 0
        }
    } else this.h1Resume(slot)
    return
}

private val httpsStreamCap = 262144

private fun httpsHex(value: int): string {
    if (value == 0) return "0"
    var out = ""
    var rest = value
    while (rest > 0) {
        val digit = rest % 16
        out = (if (digit < 10) "${digit}" else if (digit == 10) "a" else if (digit == 11) "b" else if (digit == 12) "c" else if (digit == 13) "d" else if (digit == 14) "e" else "f") + out
        rest = rest / 16
    }
    out
}

// Sends what a handler wrote past the room, then the end of the response when it was asked for; updates the room the handler sees.
private fun HttpsEventServer.flushExchange(id: int): void {
    val index = this.exchangeById(id)
    if (index < 0) return
    if (this.exchanges[index].pending.size > 0) {
        val taken = this.xWrite(index, this.exchanges[index].pending)
        if (taken < 0) this.exchanges[index].pending = ""
        else if (taken > 0) this.exchanges[index].pending = this.exchanges[index].pending.slice(taken, this.exchanges[index].pending.size)
    }
    // A pause for room ends by itself once what the handler wrote is all out.
    if (this.exchanges[index].pending.size == 0 && this.exchanges[index].resumeOnDrain && this.exchanges[index].paused) {
        this.exchanges[index].paused = false
        this.exchanges[index].resumeOnDrain = false
        this.xRelease(index)
    }
    if (this.exchanges[index].pending.size == 0 && this.exchanges[index].finishing) {
        val ending: array<HttpHeader> = []
        for (t in this.exchanges[index].trailers) ending.append(t)
        this.xEnd(index, ending)
        this.responseFinished(id)
        return
    }
    if (this.exchanges[index].pending.size > 0) this.exchanges[index].blockedWrite = true
    this.exchanges[index].exchange.room = if (this.exchanges[index].pending.size > 0) 0 else this.xRoom(index)
    return
}

// The response of an exchange is complete. HTTP/2: the exchange is over. HTTP/1.1: it is over once the request is too (what is left of the request is thrown away) and the output is out.
private fun HttpsEventServer.responseFinished(id: int): void {
    val index = this.exchangeById(id)
    if (index < 0) return
    if (!this.exchanges[index].h1) {
        this.removeExchange(id)
        return
    }
    this.exchanges[index].responseDone = true
    if (!this.exchanges[index].reqEnded) this.exchanges[index].discarding = true
    return
}

// Does what a handler's step says, for the exchange `id`.
private fun HttpsEventServer.applyStep(id: int, step: HttpStreamStep): void {
    var index = this.exchangeById(id)
    if (index < 0) return
    if (step.abort) {
        this.xAbort(index, H2_CANCEL)
        this.removeExchange(id)
        return
    }
    if ((step.respond || step.write.size > 0 || step.finish) && !this.exchanges[index].exchange.responded) {
        // A write or a finish before an answer is an answer: 200.
        val ok = if (step.respond) this.xRespond(index, step.status, step.headers, step.length) else this.xRespond(index, 200, [], -1)
        if (!ok) {
            this.xAbort(index, H2_INTERNAL_ERROR)
            this.removeExchange(id)
            return
        }
        this.exchanges[index].exchange.responded = true
        // A response of length 0 (or to a HEAD) is complete: no more writes.
        if (step.respond && (step.length == 0 || this.exchanges[index].responseDone)) {
            this.responseFinished(id)
            return
        }
    }
    if (step.wantWritable) this.exchanges[index].wantWritable = true
    if (step.write.size > 0) this.exchanges[index].pending = this.exchanges[index].pending + step.write
    if (step.finish) {
        this.exchanges[index].finishing = true
        this.exchanges[index].trailers = step.trailers
    }
    this.flushExchange(id)
    index = this.exchangeById(id)
    if (index < 0) return
    if (step.pause == HTTP_STREAM_PAUSE_FOR_ROOM && this.exchanges[index].pending.size > 0) {
        this.exchanges[index].paused = true
        this.exchanges[index].resumeOnDrain = true
        if (this.exchanges[index].h1) this.h1Pause(this.exchanges[index].slot)
    }
    if (step.pause == HTTP_STREAM_PAUSE) {
        this.exchanges[index].paused = true
        if (this.exchanges[index].h1) this.h1Pause(this.exchanges[index].slot)
    } else if (step.pause == HTTP_STREAM_RESUME && this.exchanges[index].paused) {
        this.exchanges[index].paused = false
        this.xRelease(index)
    }
    return
}

// Hands a connection's streaming events to their handlers, and the steps they return to the connection, until nothing is left (bounded).
private fun HttpsEventServer.streamRound(slot: int): void {
    var rounds = 0
    while (rounds < 16 && slot < this.states.size && this.states[slot] == httpsHttp2 && this.descriptors[slot] >= 0) {
        val events = this.h2[slot].takeEvents()
        var progressed = events.size > 0
        for (event in events) this.streamEvent(slot, event)
        // Producers that asked to hear of room (HttpStreamStep.wantWritable) hear of it once half of the response cap is free.
        val asking: array<int> = []
        for (i in 0 until this.exchanges.size) {
            if (this.exchanges[i].slot == slot && this.exchanges[i].wantWritable) asking.append(this.exchanges[i].exchange.id)
        }
        for (id in asking) {
            val index = this.exchangeById(id)
            if (index >= 0 && this.exchanges[index].pending.size == 0 &&
                this.h2[slot].responseRoom(this.exchanges[index].stream) >= H2_SERVER_STREAM_BODY_CAP / 2) {
                this.exchanges[index].wantWritable = false
                this.exchanges[index].exchange.room = this.h2[slot].responseRoom(this.exchanges[index].stream)
                val handler = this.streamRoutes[this.exchanges[index].route].handler
                this.applyStep(id, handler.onWritable(this.exchanges[index].exchange))
                progressed = true
            }
        }
        if (!progressed) return
        // What the handlers wrote goes out now, which may make room for more.
        this.flush(slot)
        rounds = rounds + 1
    }
    return
}

// A producer (wantWritable) whose response has room again but whose round was cut short (a round is bounded): it hears of it at the next pass of the loop, without waiting for the socket.
private fun HttpsEventServer.producerReady(slot: int): bool {
    for (i in 0 until this.exchanges.size) {
        if (this.exchanges[i].slot == slot && this.exchanges[i].wantWritable && this.exchanges[i].pending.size == 0 &&
            this.h2[slot].responseRoom(this.exchanges[i].stream) >= H2_SERVER_STREAM_BODY_CAP / 2) return true
    }
    false
}

private fun HttpsEventServer.streamEvent(slot: int, event: H2ServerEvent): void {
    val stream = event.stream
    if (event.kind == H2_SERVER_EVENT_REQUEST) {
        val request = event.request
        if (request == null) return
        val route = this.routeFor(request.method, request.path)
        if (route < 0) return
        val id = this.nextExchange
        this.nextExchange = this.nextExchange + 1
        val exchange = HttpStreamExchange(id, request.method, request.path, request.query, request.headers, request.peerAddress)
        this.exchanges.append(HttpsExchange(exchange, slot, stream, route))
        val handler = this.streamRoutes[route].handler
        this.applyStep(id, handler.onRequest(exchange))
        return
    }
    var index = this.exchangeAt(slot, stream)
    if (index < 0) return
    val id = this.exchanges[index].exchange.id
    val handler = this.streamRoutes[this.exchanges[index].route].handler
    if (event.kind == H2_SERVER_EVENT_DATA) {
        this.exchanges[index].exchange.requestBytes = this.exchanges[index].exchange.requestBytes + event.data.size
        val step = handler.onData(this.exchanges[index].exchange, event.data)
        this.applyStep(id, step)
        index = this.exchangeById(id)
        if (index < 0) return
        // The piece is dealt with unless the exchange is paused (by this step or before): then its credit waits for the resume.
        if (this.exchanges[index].paused) this.exchanges[index].held = this.exchanges[index].held + event.data.size
        else this.h2[slot].consumed(stream, event.data.size)
    } else if (event.kind == H2_SERVER_EVENT_END) {
        this.exchanges[index].exchange.requestEnded = true
        this.applyStep(id, handler.onEnd(this.exchanges[index].exchange, event.trailers))
    } else if (event.kind == H2_SERVER_EVENT_WRITABLE) {
        this.flushExchange(id)
        index = this.exchangeById(id)
        if (index >= 0 && this.exchanges[index].pending.size == 0) this.applyStep(id, handler.onWritable(this.exchanges[index].exchange))
    } else if (event.kind == H2_SERVER_EVENT_RESET) {
        handler.onAbort(this.exchanges[index].exchange, event.error)
        this.removeExchange(id)
    }
    return
}

// ---- streaming routes over HTTP/1.1 ----
// The request head is read as it arrives and the route's handler hears of it; the body is passed on as it is framed (Content-Length, or chunked) and reading stops while the handler is paused; the response
// goes out as the handler writes it (Content-Length when it says how long, else chunked). The next request of the connection waits until both bodies are done. `Expect: 100-continue` is answered at once.

private fun HttpsEventServer.h1Paused(slot: int): bool {
    val index = this.exchangeAt(slot, 0)
    index >= 0 && this.exchanges[index].h1 && this.exchanges[index].paused
}

private fun HttpsEventServer.setRead(slot: int, read: bool): void {
    if (this.descriptors[slot] >= 0) this.poller.modifyDescriptor(this.descriptors[slot], read, this.writeWatching[slot])
    return
}

private fun HttpsEventServer.h1Pause(slot: int): void {
    this.setRead(slot, false)
    return
}

private fun HttpsEventServer.h1Resume(slot: int): void {
    this.setRead(slot, true)
    return
}

// An HTTP/1.1 exchange of the slot that has something to do without a socket event: input it holds (or its TLS session does) and is not paused, or a producer with room.
private fun HttpsEventServer.h1Ready(slot: int): bool {
    val index = this.exchangeAt(slot, 0)
    if (index < 0 || !this.exchanges[index].h1 || this.states[slot] != httpsHttp1) return false
    // A pause for room ends once what the handler wrote is out: flushExchange (h1Round) sends the rest as the output drains and lifts it. Nothing else wakes a paused connection (its reading is off).
    if (this.exchanges[index].paused) return this.exchanges[index].resumeOnDrain && this.exchanges[index].pending.size > 0 && this.xRoom(index) > 0
    if (!this.exchanges[index].reqEnded && this.exchanges[index].exchange.responded && this.exchanges[index].resumeOnDrain && this.exchanges[index].pending.size == 0) return true
    if (!this.exchanges[index].reqEnded && (this.inputs[slot].size > 0 || (this.tls != null && this.sessions[slot].hasPending()))) return this.outputs[slot].size == 0 || this.exchanges[index].exchange.responded
    if (this.exchanges[index].blockedWrite || this.exchanges[index].wantWritable) return this.xRoom(index) >= httpsStreamCap / 2
    this.exchanges[index].reqEnded && this.exchanges[index].responseDone && this.outputs[slot].size == 0
}

private fun HttpsEventServer.startH1Exchange(slot: int, request: HttpRequest, headerEnd: int, http10: bool, route: int): bool {
    val limit = this.streamRoutes[route].maximumBodyBytes
    val framing = httpRequestFraming(request, http10, if (limit > 0) limit else 4611686018427387903)
    if (framing == -1) {
        // Over the route's limit (a valid Content-Length past it) is 413, anything else is not a request.
        val tooLarge = limit > 0 && httpDecimalLength(request.header("Content-Length"), 4611686018427387903) > limit
        this.outputs[slot] = httpText(if (tooLarge) "request body too large" else "bad request", if (tooLarge) 413 else 400).render()
        this.outputOffsets[slot] = 0
        this.closing[slot] = true
        this.flush(slot)
        return true
    }
    this.requestCounts[slot] = this.requestCounts[slot] + 1
    val keepAlive = (if (http10) httpHeaderTokenContains(request.header("Connection"), "keep-alive") && httpRequestKeepAlive(request) else httpRequestKeepAlive(request)) &&
        !this.draining && this.requestCounts[slot] < this.options.base.maximumRequestsPerConnection
    val id = this.nextExchange
    this.nextExchange = this.nextExchange + 1
    val exchange = HttpStreamExchange(id, request.method, request.path, request.query, request.headers, request.peerAddress)
    val state = HttpsExchange(exchange, slot, 0, route, h1 = true, reqFraming = if (framing == -2) 2 else if (framing > 0) 1 else 0, reqLeft = if (framing > 0) framing else 0,
        keepAlive = keepAlive, headResponse = request.method == "HEAD")
    this.exchanges.append(state)
    this.inputs[slot] = if (headerEnd < this.inputs[slot].size) this.inputs[slot].slice(headerEnd, this.inputs[slot].size) else ""
    if (httpHeaderTokenContains(request.header("Expect"), "100-continue") && framing != 0) this.xAppend(slot, "HTTP/1.1 100 Continue\r\n\r\n")
    if (framing == 0) {
        // No body: the request is whole.
        val index = this.exchangeById(id)
        this.exchanges[index].reqEnded = true
    }
    val handler = this.streamRoutes[route].handler
    this.applyStep(id, handler.onRequest(exchange))
    val index = this.exchangeById(id)
    if (index >= 0 && this.exchanges[index].reqEnded) {
        exchange.requestEnded = true
        this.applyStep(id, handler.onEnd(exchange, []))
    }
    true
}

// A piece of the request body for the handler (or the bin when the response is over).
private fun HttpsEventServer.h1Deliver(id: int, chunk: string): void {
    var index = this.exchangeById(id)
    if (index < 0 || chunk.size == 0) return
    if (this.exchanges[index].discarding) return
    this.exchanges[index].exchange.requestBytes = this.exchanges[index].exchange.requestBytes + chunk.size
    val limit = this.streamRoutes[this.exchanges[index].route].maximumBodyBytes
    if (limit > 0 && this.exchanges[index].exchange.requestBytes > limit) {
        // Past the route's limit: 413 when nothing was answered, the rest of the request is thrown away and the connection closes after.
        this.h1OverLimit(id)
        return
    }
    val handler = this.streamRoutes[this.exchanges[index].route].handler
    this.applyStep(id, handler.onData(this.exchanges[index].exchange, chunk))
    return
}

// Takes the request body out of the slot's input by the exchange's framing, a piece at a time, until the input is used up, the exchange is paused or the request is whole.
private fun HttpsEventServer.h1Feed(slot: int): void {
    var index = this.exchangeAt(slot, 0)
    if (index < 0 || !this.exchanges[index].h1) return
    val id = this.exchanges[index].exchange.id
    var input = this.inputs[slot]
    var more = true
    while (more) {
        index = this.exchangeById(id)
        if (index < 0) {
            this.inputs[slot] = input
            return
        }
        if (this.exchanges[index].reqEnded || (this.exchanges[index].paused && !this.exchanges[index].discarding) || this.exchanges[index].reqFraming == 0) {
            more = false
        } else if (this.exchanges[index].reqFraming == 1) {
            if (input.size == 0) more = false
            else {
                val take = if (input.size < this.exchanges[index].reqLeft) input.size else this.exchanges[index].reqLeft
                val piece = if (take == input.size) input else input.slice(0, take)
                input = if (take == input.size) "" else input.slice(take, input.size)
                this.exchanges[index].reqLeft = this.exchanges[index].reqLeft - take
                if (this.exchanges[index].reqLeft == 0) this.exchanges[index].reqEnded = true
                this.inputs[slot] = input
                this.h1Deliver(id, piece)
                this.h1RequestEnded(id)
            }
        } else {
            // chunked
            val phase = this.exchanges[index].reqPhase
            if (phase == 0) {
                val lineEnd = textFindSequence(input, "\r\n", 0, input.size)
                if (lineEnd < 0) {
                    if (input.size > 4096) {
                        this.closeSlot(slot)
                        return
                    }
                    more = false
                } else {
                    var digits = input.slice(0, lineEnd)
                    val semicolon = digits.indexOf(";")
                    if (semicolon >= 0) digits = digits.slice(0, semicolon)
                    var size = 0
                    var valid = digits.size > 0
                    for (i in 0 until digits.size) {
                        val c = digits[i]
                        val digit = if (c >= 48 && c <= 57) c - 48 else if (c >= 97 && c <= 102) c - 87 else if (c >= 65 && c <= 70) c - 55 else -1
                        if (digit < 0 || size > 1152921504606846975) valid = false
                        else size = size * 16 + digit
                    }
                    if (!valid) {
                        this.closeSlot(slot)
                        return
                    }
                    input = input.slice(lineEnd + 2, input.size)
                    this.exchanges[index].reqLeft = size
                    this.exchanges[index].reqPhase = if (size == 0) 3 else 1
                }
            } else if (phase == 1) {
                if (input.size == 0) more = false
                else {
                    val take = if (input.size < this.exchanges[index].reqLeft) input.size else this.exchanges[index].reqLeft
                    val piece = if (take == input.size) input else input.slice(0, take)
                    input = if (take == input.size) "" else input.slice(take, input.size)
                    this.exchanges[index].reqLeft = this.exchanges[index].reqLeft - take
                    if (this.exchanges[index].reqLeft == 0) this.exchanges[index].reqPhase = 2
                    this.inputs[slot] = input
                    this.h1Deliver(id, piece)
                }
            } else if (phase == 2) {
                if (input.size < 2) more = false
                else if (input[0] != 13 || input[1] != 10) {
                    this.closeSlot(slot)
                    return
                } else {
                    input = input.slice(2, input.size)
                    this.exchanges[index].reqPhase = 0
                }
            } else {
                // After the last chunk: trailer fields, then an empty line.
                if (input.size >= 2 && input[0] == 13 && input[1] == 10) {
                    input = input.slice(2, input.size)
                    this.exchanges[index].reqEnded = true
                    this.inputs[slot] = input
                    this.h1RequestEnded(id)
                } else {
                    val end = textFindSequence(input, "\r\n\r\n", 0, input.size)
                    if (end < 0) {
                        if (input.size > 65536) {
                            this.closeSlot(slot)
                            return
                        }
                        more = false
                    } else {
                        this.exchanges[index].requestTrailers = httpParseResponseBounded("HTTP/1.1 200 OK\r\n" + input.slice(0, end + 4), 0).response.headers
                        input = input.slice(end + 4, input.size)
                        this.exchanges[index].reqEnded = true
                        this.inputs[slot] = input
                        this.h1RequestEnded(id)
                    }
                }
            }
        }
    }
    this.inputs[slot] = input
    return
}

// The request is whole: the handler hears of it (unless the response is over already).
private fun HttpsEventServer.h1RequestEnded(id: int): void {
    val index = this.exchangeById(id)
    if (index < 0 || !this.exchanges[index].reqEnded || this.exchanges[index].exchange.requestEnded) return
    this.exchanges[index].exchange.requestEnded = true
    if (this.exchanges[index].discarding) return
    val handler = this.streamRoutes[this.exchanges[index].route].handler
    val trailers: array<HttpHeader> = []
    for (t in this.exchanges[index].requestTrailers) trailers.append(t)
    this.applyStep(id, handler.onEnd(this.exchanges[index].exchange, trailers))
    return
}

// Producers and writers waiting for room hear of it (HTTP/1.1: the output drained).
private fun HttpsEventServer.h1Round(slot: int): void {
    var rounds = 0
    while (rounds < 16) {
        val index = this.exchangeAt(slot, 0)
        if (index < 0 || !this.exchanges[index].h1) return
        val id = this.exchanges[index].exchange.id
        this.flushExchange(id)
        val after = this.exchangeById(id)
        if (after < 0) return
        if (this.exchanges[after].discarding) return
        if (this.exchanges[after].pending.size > 0 || this.exchanges[after].responseDone) return
        val asking = this.exchanges[after].wantWritable || this.exchanges[after].blockedWrite
        if (!asking || this.xRoom(after) < httpsStreamCap / 2) return
        this.exchanges[after].wantWritable = false
        this.exchanges[after].blockedWrite = false
        this.exchanges[after].exchange.room = this.xRoom(after)
        val handler = this.streamRoutes[this.exchanges[after].route].handler
        this.applyStep(id, handler.onWritable(this.exchanges[after].exchange))
        this.flush(slot)
        rounds = rounds + 1
    }
    return
}

// A request body past the route's limit: 413 when nothing was answered yet (the connection closes after), else the connection is dropped; the handler hears of the abort either way.
private fun HttpsEventServer.h1OverLimit(id: int): void {
    val index = this.exchangeById(id)
    if (index < 0) return
    val slot = this.exchanges[index].slot
    val handler = this.streamRoutes[this.exchanges[index].route].handler
    if (!this.exchanges[index].exchange.responded) {
        this.exchanges[index].keepAlive = false
        this.exchanges[index].discarding = true
        if (this.xRespond(index, 413, [HttpHeader("content-type", "text/plain")], 22)) {
            this.exchanges[index].exchange.responded = true
            this.xWrite(index, "request body too large")
            this.xEnd(index, [])
        }
        handler.onAbort(this.exchanges[index].exchange, "the request body passed the route's limit")
        this.flush(slot)
    } else {
        handler.onAbort(this.exchanges[index].exchange, "the request body passed the route's limit")
        this.removeExchange(id)
        this.closeSlot(slot)
    }
    return
}

// The connection ended: every exchange of the slot hears of it.
private fun HttpsEventServer.abortExchanges(slot: int, reason: string): void {
    var index = 0
    while (index < this.exchanges.size) {
        if (this.exchanges[index].slot == slot) {
            val handler = this.streamRoutes[this.exchanges[index].route].handler
            val taken = this.exchanges.takeAt(index)
            handler.onAbort(taken.exchange, reason)
        } else index = index + 1
    }
    return
}

fun HttpsEventServer.port(): int = this.listener.localPort()

fun HttpsEventServer.activeConnections(): int {
    var active = 0
    for (index in 0 until this.descriptors.size) {
        if (this.descriptors[index] >= 0) active = active + 1
    }
    active
}

private fun HttpsEventServer.slotOf(descriptor: int): int =
    if (descriptor >= 0 && descriptor < this.descriptorSlots.size) this.descriptorSlots[descriptor] else -1

private fun HttpsEventServer.allocate(descriptor: int): int {
    val peer = socketPeerAddress(descriptor)
    var slot = -1
    var index = 0
    while (slot < 0 && index < this.descriptors.size) {
        if (this.descriptors[index] < 0) slot = index
        index = index + 1
    }
    val now = linuxMonotonicMilliseconds()
    val config = this.tls
    if (slot < 0) {
        slot = this.descriptors.size
        this.descriptors.append(descriptor)
        this.states.append(httpsFree)
        if (config != null) this.sessions.append(tlsServerSession(config, -1))
        this.h2.append(h2ServerNew())
        this.inputs.append("")
        this.outputs.append("")
        this.outputOffsets.append(0)
        this.writeWatching.append(false)
        this.requestCounts.append(0)
        this.closing.append(false)
        this.lastActivity.append(now)
        this.started.append(now)
        this.peers.append(peer)
    } else {
        this.descriptors[slot] = descriptor
        this.peers[slot] = peer
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.requestCounts[slot] = 0
        this.closing[slot] = false
        this.lastActivity[slot] = now
        this.started[slot] = now
    }
    while (this.descriptorSlots.size <= descriptor) this.descriptorSlots.append(-1)
    this.descriptorSlots[descriptor] = slot
    slot
}

fun HttpsEventServer.closeSlot(slot: int): void {
    if (slot >= 0 && slot < this.descriptors.size && this.descriptors[slot] >= 0) {
        // (the protocol is read before the slot is marked free: an HTTP/2 connection's state, with the request bodies it buffered, is dropped now, not when the slot is reused)
        val wasHttp2 = this.states[slot] == httpsHttp2
        if (this.states[slot] != httpsFree && this.tls != null && this.states[slot] != httpsSniffing) {
            // close_notify is offered once, best effort (the session ignores a placeholder).
            this.sessions[slot].close()
        }
        if (this.tls == null) {
            // Closing a socket with unread input resets the connection, which can destroy the answer (a GOAWAY) still in flight: what the peer already sent is read and dropped first.
            val connection = TcpConnection(this.descriptors[slot])
            var drained = 0
            while (drained < 8) {
                val rest = connection.readResult(65536)
                drained = if (rest.hasData()) drained + 1 else 8
            }
            connection.descriptor = -1
        }
        this.poller.unwatchDescriptor(this.descriptors[slot])
        if (this.descriptors[slot] < this.descriptorSlots.size) this.descriptorSlots[this.descriptors[slot]] = -1
        linuxTcpCloseDescriptor(this.descriptors[slot])
        this.descriptors[slot] = -1
        this.states[slot] = httpsFree
        this.peers[slot] = null
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.closing[slot] = false
        this.lastActivity[slot] = 0
        this.abortExchanges(slot, "the connection closed")
        if (wasHttp2) {
            this.h2[slot] = h2ServerNew()
        }
    }
    return
}

private fun HttpsEventServer.watchWrite(slot: int, want: bool): void {
    if (this.writeWatching[slot] != want && this.descriptors[slot] >= 0) {
        if (this.poller.modifyDescriptor(this.descriptors[slot], !this.h1Paused(slot), want)) this.writeWatching[slot] = want
    }
    return
}

// ---- bytes in and out of a slot, through TLS or plain ----
// Returns the bytes read ("" with `status` 0 for would-block, 1 closed, -1 failed in `lastStatus`); for TLS: want-write is reported as would-block with the write interest set.
class HttpsRead(var bytes: string, var status: int)

private fun HttpsEventServer.receive(slot: int, var into: HttpsRead): void {
    into.bytes = ""
    into.status = 0
    if (this.tls != null && this.states[slot] != httpsSniffing) {
        val read = this.sessions[slot].readReady(16384)
        if (read.status == 1 && read.bytes.size > 0) {
            into.bytes = read.bytes
        } else if (read.status == 3) {
            this.watchWrite(slot, true)
        } else if (read.status == 0) {
            into.status = 1
        } else if (read.status < 0) {
            into.status = -1
        }
        return
    }
    val connection = TcpConnection(this.descriptors[slot])
    val result = connection.readResult(65536)
    connection.descriptor = -1
    if (result.hasData()) into.bytes = result.bytes
    else if (result.reachedEof()) into.status = 1
    else if (result.errorCode != 11) into.status = -1
    return
}

// Writes what is queued for the slot until the socket would block; closes the slot when a closing connection is done.
private fun HttpsEventServer.flush(slot: int): void {
    var writing = this.descriptors[slot] >= 0
    while (writing) {
        // The H2Server may have more to say (acknowledgements, held-back bodies).
        if (this.outputOffsets[slot] >= this.outputs[slot].size) {
            this.outputs[slot] = ""
            this.outputOffsets[slot] = 0
            if (this.states[slot] == httpsHttp2) {
                val more = this.h2[slot].takeOutput()
                if (more.size > 0) this.outputs[slot] = more
            }
            if (this.outputs[slot].size == 0) {
                this.watchWrite(slot, false)
                writing = false
                if (this.states[slot] == httpsHttp2 && this.h2[slot].finished()) this.closeSlot(slot)
                else if (this.closing[slot]) this.closeSlot(slot)
                continue
            }
        }
        val offset = this.outputOffsets[slot]
        if (this.tls != null && this.states[slot] != httpsSniffing) {
            val sent = this.sessions[slot].writeReady(this.outputs[slot], offset)
            if (sent.status == 1 && sent.written > 0) {
                this.outputOffsets[slot] = offset + sent.written
                this.lastActivity[slot] = this.pass
            } else if (sent.status == 2 || sent.status == 3) {
                this.watchWrite(slot, true)
                writing = false
            } else {
                this.closeSlot(slot)
                writing = false
            }
        } else {
            val connection = TcpConnection(this.descriptors[slot])
            val remaining = if (offset == 0) this.outputs[slot] else this.outputs[slot].slice(offset, this.outputs[slot].size)
            val written = connection.writeResult(remaining)
            connection.descriptor = -1
            if (written.written > 0) {
                this.outputOffsets[slot] = offset + written.written
                this.lastActivity[slot] = this.pass
            }
            if (written.failed() && written.errorCode != 11) {
                this.closeSlot(slot)
                writing = false
            } else if (written.written == 0) {
                this.watchWrite(slot, true)
                writing = false
            }
        }
    }
    return
}

// ---- protocols ----
private fun HttpsEventServer.startProtocol(slot: int, http2: bool): void {
    if (http2 && this.options.http2) {
        this.states[slot] = httpsHttp2
        this.h2[slot] = h2ServerNew(this.options.maximumStreams, this.options.base.maximumBodyBytes, this.options.maximumHeaderListBytes, this.peers[slot])
        for (route in this.streamRoutes) this.h2[slot].streamRoute(route.method, route.path, route.maximumBodyBytes)
        if (this.draining) this.h2[slot].shutdown()
    } else if (!this.options.http1) {
        this.closeSlot(slot)
    } else this.states[slot] = httpsHttp1
    return
}

private fun HttpsEventServer.serveHttp1(slot: int): void {
    var processing = this.states[slot] == httpsHttp1 && this.descriptors[slot] >= 0
    while (processing) {
        val base = this.options.base
        // A streaming exchange of this connection: its request body is fed to its handler, its writers hear of room; the next request waits until both bodies are done.
        if (this.exchangeAt(slot, 0) >= 0) {
            this.h1Feed(slot)
            this.h1Round(slot)
            this.flush(slot)
            if (this.descriptors[slot] < 0) return
            val live = this.exchangeAt(slot, 0)
            if (live >= 0 && this.exchanges[live].reqEnded && this.exchanges[live].responseDone && this.outputs[slot].size == 0) {
                val keep = this.exchanges[live].keepAlive
                this.removeExchange(this.exchanges[live].exchange.id)
                if (!keep) {
                    this.closing[slot] = true
                    this.flush(slot)
                    processing = false
                }
            } else processing = false
            continue
        }
        if (this.outputs[slot].size > 0) {
            processing = false
            continue
        }
        // A request for a streaming route is started from its head, whatever of its body has arrived.
        if (this.streamRoutes.size > 0) {
            val seen = this.inputs[slot]
            val headEnd = httpHeaderEnd(seen)
            if (headEnd > 0 && headEnd <= base.maximumHeaderBytes) {
                val lineEnd = seen.indexOf("\r\n")
                val line = if (lineEnd > 0) seen.slice(0, lineEnd) else ""
                val http11 = line.endsWith(" HTTP/1.1")
                if (http11 || line.endsWith(" HTTP/1.0")) {
                    val head = httpParseRequestFrom(seen, this.peers[slot])
                    val route = this.routeFor(head.method, head.path)
                    if (route >= 0) {
                        this.startH1Exchange(slot, head, headEnd, !http11, route)
                        continue
                    }
                }
            }
        }
        val frame = httpEventFrame(this.inputs[slot], base.maximumHeaderBytes, base.maximumBodyBytes, this.peers[slot])
        val length = frame.length
        if (length < 0) {
            this.outputs[slot] = httpText("bad request", 400).render()
            this.outputOffsets[slot] = 0
            this.closing[slot] = true
            processing = false
            this.flush(slot)
        } else if (length == 0) processing = false
        else {
            if (length < this.inputs[slot].size) this.inputs[slot] = this.inputs[slot].slice(length, this.inputs[slot].size)
            else this.inputs[slot] = ""
            val request = frame.request
            if (request == null) {
                this.closeSlot(slot)
                return
            }
            val eventHandler = this.handler
            val response = eventHandler(request)
            this.requestCounts[slot] = this.requestCounts[slot] + 1
            val keepAlive = (if (frame.http10) httpHeaderTokenContains(request.header("Connection"), "keep-alive") && httpRequestKeepAlive(request) else httpRequestKeepAlive(request)) &&
                !this.draining && this.requestCounts[slot] < base.maximumRequestsPerConnection
            this.outputs[slot] = httpEventResponse(request, response, keepAlive, base.gzipMinimumBytes)
            this.outputOffsets[slot] = 0
            this.closing[slot] = !keepAlive
            if (this.outputs[slot].size > base.maximumPendingBytes) {
                this.closeSlot(slot)
                processing = false
            } else {
                this.flush(slot)
                processing = this.descriptors[slot] >= 0 && this.outputs[slot].size == 0 && !this.closing[slot]
            }
        }
    }
    return
}

private fun HttpsEventServer.serveHttp2(slot: int, data: string): void {
    this.h2[slot].feed(data, this.pass)
    for (r in this.h2[slot].takeRequests()) {
        val eventHandler = this.handler
        val response = eventHandler(r.request)
        // A response the HTTP/1.1 server would send as an upgrade cannot exist here.
        if (response.status == 101 || response.status < 200 || response.status > 599) {
            this.h2[slot].respond(r.stream, 500, [HttpHeader("content-type", "text/plain")], "internal server error")
        } else if (r.request.method == "HEAD" || response.body.size < this.options.base.gzipMinimumBytes) {
            this.h2[slot].respond(r.stream, response.status, response.headers, response.body)
        } else {
            val encoded = httpGzipResponse(r.request, response, this.options.base.gzipMinimumBytes)
            this.h2[slot].respond(r.stream, encoded.status, encoded.headers, encoded.body)
        }
    }
    this.streamRound(slot)
    this.flush(slot)
    return
}

private fun HttpsEventServer.onBytes(slot: int, data: string): void {
    var state = this.states[slot]
    if (state == httpsSniffing) {
        // Plain connection: the start of the HTTP/2 preface means h2c, anything else HTTP/1.1.
        this.inputs[slot] = this.inputs[slot] + data
        val seen = this.inputs[slot]
        // "PRI * HTTP/2.0\r\n" (16 bytes) is not an HTTP/1.1 request line a server should take: from there the connection is HTTP/2 and a wrong rest of the preface ends it.
        val preface = H2_PREFACE.slice(0, 16)
        val compare = if (seen.size < preface.size) seen.size else preface.size
        if (seen.slice(0, compare) == preface.slice(0, compare)) {
            if (seen.size < preface.size) return
            this.startProtocol(slot, true)
        } else if (!this.options.http1 && this.options.http2) {
            this.startProtocol(slot, true)
        } else this.startProtocol(slot, false)
        state = this.states[slot]
        val held = this.inputs[slot]
        this.inputs[slot] = ""
        if (state == httpsHttp2) this.serveHttp2(slot, held)
        else {
            this.inputs[slot] = held
            this.serveHttp1(slot)
        }
        return
    }
    if (state == httpsHttp2) {
        this.serveHttp2(slot, data)
    } else if (state == httpsHttp1) {
        this.inputs[slot] = this.inputs[slot] + data
        if (this.inputs[slot].size > this.options.base.maximumHeaderBytes + this.options.base.maximumBodyBytes &&
            httpEventRequestLength(this.inputs[slot], this.options.base.maximumHeaderBytes, this.options.base.maximumBodyBytes) <= 0) this.closeSlot(slot)
        else this.serveHttp1(slot)
    }
    return
}

private fun HttpsEventServer.handshake(slot: int): void {
    val status = this.sessions[slot].handshake()
    if (status == 1) {
        this.watchWrite(slot, false)
        this.startProtocol(slot, this.sessions[slot].alpn() == "h2")
        this.lastActivity[slot] = this.pass
        // A client that sent its request with its Finished may have data waiting inside the session already.
        this.readSlot(slot)
    } else if (status == 2) this.watchWrite(slot, false)
    else if (status == 3) this.watchWrite(slot, true)
    else this.closeSlot(slot)
    return
}

fun HttpsEventServer.readSlot(slot: int): void {
    var reading = slot >= 0 && this.descriptors[slot] >= 0
    var result = HttpsRead("", 0)
    var rounds = 0
    while (reading && this.descriptors[slot] >= 0 && rounds < 64 && !this.h1Paused(slot)) {
        rounds = rounds + 1
        if (this.states[slot] == httpsHandshaking) {
            this.handshake(slot)
            return
        }
        this.receive(slot, result)
        if (result.status != 0) {
            this.closeSlot(slot)
            reading = false
        } else if (result.bytes.size > 0) {
            this.lastActivity[slot] = this.pass
            this.onBytes(slot, result.bytes)
            // A connection with an unwritten answer reads no further until it is written (backpressure).
            if (this.descriptors[slot] >= 0 && this.outputs[slot].size > 0) reading = false
        } else reading = false
    }
    return
}

fun HttpsEventServer.writeSlot(slot: int): void {
    if (slot >= 0 && this.descriptors[slot] >= 0) {
        if (this.states[slot] == httpsHandshaking) {
            this.handshake(slot)
            return
        }
        this.flush(slot)
        // Room that opened while writing (windows, a drained queue) is for the streaming handlers to hear.
        if (this.descriptors[slot] >= 0 && this.states[slot] == httpsHttp2) {
            this.streamRound(slot)
            this.flush(slot)
        }
        // An answer that was waiting for the socket lets the next request in the input run.
        if (this.descriptors[slot] >= 0 && this.states[slot] == httpsHttp1 && this.outputs[slot].size == 0) this.serveHttp1(slot)
    }
    return
}

fun HttpsEventServer.acceptReady(): void {
    var accepting = !this.draining && this.activeConnections() < this.options.base.maximumConnections
    while (accepting) {
        val connection = this.listener.accept()
        if (connection.descriptor < 0) accepting = false
        else {
            connection.setNonblocking()
            val descriptor = connection.descriptor
            connection.descriptor = -1
            val slot = this.allocate(descriptor)
            val config = this.tls
            if (config != null) {
                this.sessions[slot] = tlsServerSession(config, descriptor, true)
                this.states[slot] = if (this.sessions[slot].ok()) httpsHandshaking else httpsFree
            } else this.states[slot] = httpsSniffing
            this.poller.watchDescriptor(descriptor)
            if (this.states[slot] == httpsFree) this.closeSlot(slot)
            accepting = this.activeConnections() < this.options.base.maximumConnections
        }
    }
    return
}

/** One pass of the loop: waits up to `timeoutMilliseconds` for socket events, serves them, then applies the timeouts. Returns the number of events handled. */
/** Whether the slot's TLS session holds decrypted bytes nobody has taken and the slot can take them (nothing of its own waits to be written). The socket has nothing to
 *  say about them: readSlot reads at most 64 times per event, and what the session had already read from the socket stays in it. */
private fun HttpsEventServer.buffered(slot: int): bool =
    this.tls != null && this.descriptors[slot] >= 0 && this.outputs[slot].size == 0 && !this.h1Paused(slot) &&
    (this.states[slot] == httpsHttp1 || this.states[slot] == httpsHttp2) && this.sessions[slot].hasPending()

fun HttpsEventServer.step(timeoutMilliseconds: int = 1000): int {
    var handled = 0
    var maximumEvents = this.options.base.maximumConnections + 1
    if (maximumEvents > 1024) maximumEvents = 1024
    // Bytes a session still holds are served without waiting for the socket: a request body of 1 MiB or more (64 reads of 16 KiB) whose last bytes arrived with the
    // 64th read would otherwise wait for an event that never comes.
    var waiting = timeoutMilliseconds
    if (this.tls != null) {
        for (slot in 0 until this.descriptors.size) {
            if (this.buffered(slot)) waiting = 0
        }
    }
    if (this.exchanges.size > 0) {
        for (slot in 0 until this.descriptors.size) {
            if (this.descriptors[slot] >= 0 && this.states[slot] == httpsHttp2 && this.producerReady(slot)) waiting = 0
            else if (this.descriptors[slot] >= 0 && this.states[slot] == httpsHttp1 && this.h1Ready(slot)) waiting = 0
        }
    }
    val events = this.poller.waitCompact(maximumEvents, waiting)
    this.pass = linuxMonotonicMilliseconds()
    var index = 0
    while (index + 12 <= events.size) {
        val flags = textReadU32LittleEndian(events, index)
        val descriptor = textReadU32LittleEndian(events, index + 4)
        val readable = (flags & 1) != 0
        val writable = (flags & 4) != 0
        val closed = (flags & 16) != 0 || (flags & 8192) != 0
        val error = (flags & 8) != 0
        if (!this.draining && descriptor == this.listener.descriptor && readable) {
            this.acceptReady()
            handled = handled + 1
        } else {
            val slot = this.slotOf(descriptor)
            if (slot >= 0) {
                if (error) this.closeSlot(slot)
                else {
                    // A half-closed peer may still have sent a request: read before giving up on it.
                    if (readable || closed) this.readSlot(slot)
                    if (writable && slot < this.descriptors.size && this.descriptors[slot] >= 0) this.writeSlot(slot)
                    if (closed && slot < this.descriptors.size && this.descriptors[slot] >= 0 && !readable) this.closeSlot(slot)
                }
                handled = handled + 1
            }
        }
        index = index + 12
    }
    if (this.tls != null) {
        for (slot in 0 until this.descriptors.size) {
            if (this.buffered(slot)) {
                this.readSlot(slot)
                handled = handled + 1
            }
        }
    }
    if (this.exchanges.size > 0) {
        for (slot in 0 until this.descriptors.size) {
            if (this.descriptors[slot] >= 0 && this.states[slot] == httpsHttp2 && this.producerReady(slot)) {
                this.streamRound(slot)
                this.flush(slot)
                handled = handled + 1
            } else if (this.descriptors[slot] >= 0 && this.states[slot] == httpsHttp1 && this.h1Ready(slot)) {
                this.serveHttp1(slot)
                handled = handled + 1
            }
        }
    }
    this.timers()
    handled
}

private fun HttpsEventServer.timers(): void {
    val now = this.pass
    for (slot in 0 until this.descriptors.size) {
        if (this.descriptors[slot] < 0) continue
        if (this.states[slot] == httpsHandshaking && now - this.started[slot] >= this.options.handshakeTimeoutMilliseconds) {
            this.closeSlot(slot)
        } else if (this.states[slot] == httpsHttp2) {
            this.h2[slot].tick(now)
            this.flush(slot)
            if (this.descriptors[slot] >= 0 && this.options.base.idleTimeoutMilliseconds > 0 && now - this.lastActivity[slot] >= this.options.base.idleTimeoutMilliseconds) {
                // Idle: GOAWAY(NO_ERROR), then close with whatever is queued written.
                this.h2[slot].shutdown()
                this.flush(slot)
                if (this.descriptors[slot] >= 0) this.closeSlot(slot)
            }
        } else if (this.options.base.idleTimeoutMilliseconds > 0 && now - this.lastActivity[slot] >= this.options.base.idleTimeoutMilliseconds) {
            this.closeSlot(slot)
        }
    }
    return
}

/** Graceful stop: no new connections, HTTP/2 connections get GOAWAY and finish their streams, idle HTTP/1.1 connections close. */
fun HttpsEventServer.beginDrain(): void {
    if (!this.draining) {
        this.draining = true
        this.drainDeadline = linuxMonotonicMilliseconds() + this.options.base.drainTimeoutMilliseconds
        if (this.listener.descriptor >= 0) {
            this.poller.unwatchDescriptor(this.listener.descriptor)
            this.listener.close()
        }
        for (slot in 0 until this.descriptors.size) {
            if (this.descriptors[slot] < 0) continue
            if (this.states[slot] == httpsHttp2) {
                this.h2[slot].shutdown()
                this.flush(slot)
            } else if (this.outputs[slot].size > 0) this.closing[slot] = true
            else this.closeSlot(slot)
        }
    }
    return
}

fun HttpsEventServer.stop(): void {
    this.beginDrain()
    return
}

fun HttpsEventServer.forceStop(): void {
    for (slot in 0 until this.descriptors.size) this.closeSlot(slot)
    this.stopped = true
    return
}

fun HttpsEventServer.drain(): int {
    this.beginDrain()
    while (this.activeConnections() > 0 && linuxMonotonicMilliseconds() < this.drainDeadline) this.step(50)
    this.forceStop()
    0
}

/** 0 while the server listens; otherwise the errno of the failed bind or listen (98 is an address already in use, 13 no
 *  permission, 22 an invalid address), or of the failed poller. A server like that never accepts: `run()` returns 1 at once. */
fun HttpsEventServer.listenError(): int =
    if (this.listener.descriptor < 0) 0 - this.listener.descriptor
    else if (this.poller.descriptor < 0) 0 - this.poller.descriptor
    else 0

fun HttpsEventServer.run(): int {
    if (!this.stopped && this.listenError() != 0) return 1
    this.poller.watchGracefulShutdown()
    while (!this.stopped && !tcpShutdownRequested()) this.step(1000)
    if (!this.stopped) this.drain() else 0
}
