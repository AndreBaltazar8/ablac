// Single-threaded epoll HTTP/1.1 server with bounded connections, input,
// output backpressure, persistent requests, chunked bodies, and gzip policy.

import "abla/http"
import "abla/http/stream"
import "abla/memory"
import "abla/net"
import "abla/sys/linux/process"
import "abla/text"
import "abla/unsafe/memory"
import "abla/bytes"
import "abla/unsafe/memory/raw"

// Sets maximum connections, input header and body bytes, pending output bytes, requests per connection, idle timeout, minimum size for gzip, and shutdown drain timeout.
class HttpEventServerOptions(
    val maximumConnections: int,
    val maximumHeaderBytes: int,
    val maximumBodyBytes: int,
    val maximumPendingBytes: int,
    val maximumRequestsPerConnection: int,
    val idleTimeoutMilliseconds: int,
    val gzipMinimumBytes: int,
    val drainTimeoutMilliseconds: int
)

// Holds the parsed request, HTTP version flag, and a frame length of zero for incomplete or -1 for invalid input.
class HttpEventFrame(
    val length: int,
    val request: HttpRequest?,
    // An HTTP/1.0 request: its connection closes unless it asks for keep-alive.
    val http10: bool = false
)

// Owns the listener, kernel poller, and per-connection state for an event-driven HTTP server.
resource class HttpEventServer(
    val router: HttpRouter,
    val handler: (HttpRequest) -> HttpResponse,
    val noEscapeHandler: FnNoEscape(HttpRequest) -> HttpResponse,
    val useHandler: bool,
    val useNoEscapeHandler: bool,
    val listener: TcpListener,
    val poller: SocketPoller,
    val options: HttpEventServerOptions,
    val descriptors: array<int>,
    val descriptorSlots: array<int>,
    val inputs: array<string>,
    val outputs: array<string>,
    val outputOffsets: array<int>,
    val writeWatching: array<bool>,
    val requestCounts: array<int>,
    val closing: array<bool>,
    val lastActivityMilliseconds: array<int>,
    var draining: bool,
    var drainDeadlineMilliseconds: int,
    var stopped: bool,
    // The clock when this pass of step began: a request needn't read it again.
    var passMilliseconds: int,
    // One socket lookup per accepted connection, shared by persistent requests.
    val peerAddresses: array<SocketPeerAddress?> = []
) {
    // Closes the open client descriptors when the server is released.
    fun drop(): void {
        var index = 0
        while (index < this.descriptors.size) {
            if (this.descriptors[index] >= 0) {
                linuxTcpCloseDescriptor(this.descriptors[index])
                this.descriptors[index] = -1
            }
            index = index + 1
        }
        this.poller.close()
        this.listener.close()
        this.stopped = true
        return
    }
}

// Returns the default event server limits for connections, headers, request and response bodies, polling, idle time, per-pass work and shutdown drain.
fun httpEventServerOptions(): HttpEventServerOptions =
    HttpEventServerOptions(
        1023, 65536, 1048576, 2097152, 1000, 30000, 256, 5000
    )

// Returns a 500 response for a handler slot that has no assigned handler.
noescape fun httpEventUnusedHandler(request: HttpRequest): HttpResponse =
    httpText("event handler is unavailable", 500)

// A server's collections: what they find unreachable is freed by a helper thread, and four threads mark and sweep
// (ABLA_GC_WORKERS overrides; a program built without a C library starts them with its own clone routine). The pauses of a
// burst of requests halve. The compiler sees these calls in this function (bootstrapProgramWantsBackgroundFree).
fun httpEventServerCollector(): void {
    memorySetBackgroundFree(true)
    memorySetGcWorkers(4)
}

// Creates an IPv4 event server over `router`, at `address`, using `options`. Set `reusePort` to request port sharing. Inspect listenError for bind, listen or poller failures.
fun httpEventServer(
    router: HttpRouter,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    httpEventServerCollector()
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        router, httpEventUnusedHandler, httpEventUnusedHandler, false, false,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false, linuxMonotonicMilliseconds()
    )
}

// Creates an IPv4 event server dispatching each request to `handler`. Sets its address, limits, and optional port sharing from the remaining arguments. Check listenError before running.
fun httpEventServerHandler(
    handler: (HttpRequest) -> HttpResponse,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    httpEventServerCollector()
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        httpRouter(), handler, httpEventUnusedHandler, true, false,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false, linuxMonotonicMilliseconds()
    )
}

// Returns an event server for a handler that cannot retain its request, with an inactive listener on bind failure.
fun httpEventServerNoEscapeHandler(
    handler: FnNoEscape(HttpRequest) -> HttpResponse,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    httpEventServerCollector()
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        httpRouter(), httpEventUnusedHandler, handler, false, true,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false, linuxMonotonicMilliseconds()
    )
}

// Returns the number of connection slots holding open descriptors.
fun HttpEventServer.activeConnections(): int {
    var active = 0
    var index = 0
    while (index < this.descriptors.size) {
        if (this.descriptors[index] >= 0) active = active + 1
        index = index + 1
    }
    active
}

// Returns the connection slot for a registered descriptor, or -1 if none is mapped.
fun HttpEventServer.findDescriptor(descriptor: int): int {
    if (descriptor >= 0 && descriptor < this.descriptorSlots.size) {
        this.descriptorSlots[descriptor]
    } else -1
}

// Registers a connected descriptor in a reusable slot and returns the slot, or -1 when registration fails or the connection limit is reached.
fun HttpEventServer.allocateSlot(descriptor: int): int {
    val peer = socketPeerAddress(descriptor)
    var slot = -1
    var index = 0
    while (slot < 0 && index < this.descriptors.size) {
        if (this.descriptors[index] < 0) slot = index
        index = index + 1
    }
    if (slot < 0) {
        slot = this.descriptors.size
        this.descriptors.append(descriptor)
        this.peerAddresses.append(peer)
        this.inputs.append("")
        this.outputs.append("")
        this.outputOffsets.append(0)
        this.writeWatching.append(false)
        this.requestCounts.append(0)
        this.closing.append(false)
        this.lastActivityMilliseconds.append(linuxMonotonicMilliseconds())
    } else {
        this.descriptors[slot] = descriptor
        this.peerAddresses[slot] = peer
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.requestCounts[slot] = 0
        this.closing[slot] = false
        this.lastActivityMilliseconds[slot] = linuxMonotonicMilliseconds()
    }
    while (this.descriptorSlots.size <= descriptor) {
        this.descriptorSlots.append(-1)
    }
    this.descriptorSlots[descriptor] = slot
    slot
}

// Closes and clears an active connection slot, ignoring invalid or already closed slots.
fun HttpEventServer.closeSlot(slot: int): void {
    if (slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0) {
        this.poller.unwatchDescriptor(this.descriptors[slot])
        if (this.descriptors[slot] < this.descriptorSlots.size) {
            this.descriptorSlots[this.descriptors[slot]] = -1
        }
        linuxTcpCloseDescriptor(this.descriptors[slot])
        this.descriptors[slot] = -1
        this.peerAddresses[slot] = null
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.closing[slot] = false
        this.lastActivityMilliseconds[slot] = 0
    }
    return
}

// HTTP/1.1 keeps the connection unless the request says close; HTTP/1.0 closes unless it says keep-alive.
private fun httpEventKeepAlive(request: HttpRequest, http10: bool): bool =
    if (http10) httpHeaderTokenContains(request.header("Connection"), "keep-alive") &&
        httpRequestKeepAlive(request)
    else httpRequestKeepAlive(request)

// Returns the framed wire byte count, zero for incomplete input, or -1 for malformed framing or exceeded limits.
fun httpEventRequestLength(
    input: string,
    maximumHeader: int,
    maximumBody: int
): int {
    val headerEnd = httpHeaderEnd(input)
    var result = 0
    if ((headerEnd < 0 && input.size > maximumHeader) ||
        headerEnd > maximumHeader) result = -1
    if (headerEnd >= 0 && headerEnd <= maximumHeader) {
        val request = httpParseRequest(input.slice(0, headerEnd))
        val version = httpRequestLineVersion(input, request, headerEnd)
        val framing = httpRequestFraming(request, version == 0, maximumBody)
        if (version < 0 || framing == -1) result = -1
        else if (framing == -2) {
            val decoded = httpDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            if (decoded.error != "") result = -1
            else if (decoded.complete) result = headerEnd + decoded.consumed
        } else if (input.size >= headerEnd + framing) {
            result = headerEnd + framing
        }
    }
    result
}

private fun httpEventRequest(
    framed: string,
    maximumBody: int
): HttpRequest {
    val headerEnd = httpHeaderEnd(framed)
    val request = httpParseRequest(framed)
    var result = request
    if (headerEnd >= 0 && httpHeaderTokenContains(
        request.header("Transfer-Encoding"), "chunked"
    )) {
        val decoded = httpDecodeChunked(
            framed.slice(headerEnd, framed.size), maximumBody
        )
        result = HttpRequest(
            request.method, request.path, request.query, request.headers,
            decoded.body, request.parameterNames, request.parameterValues
        )
    }
    result
}

// Returns the parsed request and consumed length, with zero for incomplete input or -1 for rejected framing.
fun httpEventFrame(
    input: string,
    maximumHeader: int,
    maximumBody: int,
    peer: SocketPeerAddress? = null
): HttpEventFrame {
    val headerEnd = httpHeaderEnd(input)
    var length = 0
    var framedRequest: HttpRequest? = null
    var http10 = false
    if ((headerEnd < 0 && input.size > maximumHeader) ||
        headerEnd > maximumHeader) length = -1
    if (headerEnd >= 0 && headerEnd <= maximumHeader) {
        // Parse the request head once and retain it for dispatch. The previous
        // event path parsed every complete request once to discover framing,
        // discarded that graph, then parsed the same bytes again.
        val request = httpParseRequestFrom(input, peer)
        val version = httpRequestLineVersion(input, request, headerEnd)
        http10 = version == 0
        val framing = httpRequestFraming(request, http10, maximumBody)
        if (version < 0 || framing == -1) length = -1
        else if (framing == -2) {
            val decoded = httpDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            if (decoded.error != "") length = -1
            else if (decoded.complete) {
                length = headerEnd + decoded.consumed
                framedRequest = HttpRequest(
                    request.method, request.path, request.query,
                    request.headers, decoded.body,
                    request.parameterNames, request.parameterValues, peer
                )
            }
        } else {
            val bodyLength = framing
            if (input.size >= headerEnd + bodyLength) {
                length = headerEnd + bodyLength
                if (bodyLength == 0 && length == input.size) {
                    framedRequest = request
                } else framedRequest = HttpRequest(
                    request.method, request.path, request.query,
                    request.headers,
                    input.slice(headerEnd, length),
                    request.parameterNames, request.parameterValues, peer
                )
            }
        }
    }
    HttpEventFrame(length, framedRequest, http10)
}

// Renders a response with request-aware body suppression and optional gzip compression.
fun httpEventResponse(
    request: HttpRequest,
    response: HttpResponse,
    keepAlive: bool,
    gzipMinimumBytes: int
): string {
    var encoded = response
    if (response.body.size >= gzipMinimumBytes) {
        encoded = httpGzipResponse(request, response, gzipMinimumBytes)
    }
    if (ablaCompileTimeNativeHost()) httpEventResponseNative(request, encoded, keepAlive)
    else if (ablaAtCompileTime()) httpEventResponsePortable(request, encoded, keepAlive)
    else httpEventResponseNative(request, encoded, keepAlive)
}

// Renders the HTTP/1.1 status, headers, and permitted body bytes with the requested connection behavior.
@noinline
fun httpEventResponsePortable(
    request: HttpRequest, encoded: HttpResponse, keepAlive: bool
): string {
    var output = "HTTP/1.1 ${encoded.status} ${httpStatusReason(encoded.status)}\r\n"
    var hasLength = false
    var index = 0
    while (index < encoded.headers.size) {
        val header = encoded.headers[index]
        if (!httpAsciiEqualInsensitive(header.name, "Connection")) {
            output = "$output${header.name}: ${header.value}\r\n"
            if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
                hasLength = true
            }
        }
        index = index + 1
    }
    output = "${output}Connection: ${if (keepAlive) "keep-alive" else "close"}\r\n"
    if (!hasLength && encoded.status != 101) {
        output = "${output}Content-Length: ${encoded.body.size}\r\n"
    }
    output = "$output\r\n"
    if (request.method != "HEAD") output = "$output${encoded.body}"
    output
}

// Bounds-check every copy even though the capacity is computed first.
trusted fun httpEventResponseCopy(
    address: int, capacity: int, offset: int, value: string
): int {
    if (offset < 0 || offset > capacity || value.size > capacity - offset) return -1
    ablaUnsafeCopyMemory(address + offset, ablaUnsafeStringAddress(value), value.size)
    offset + value.size
}

// Serialize into one exact-size allocation instead of constructing a chain
// of temporary strings and flattening its ropes at the socket boundary.
trusted fun httpEventResponseNative(
    request: HttpRequest, encoded: HttpResponse, keepAlive: bool
): string {
    val statusText = "${encoded.status}"
    val reason = httpStatusReason(encoded.status)
    val connection = if (keepAlive) "Connection: keep-alive\r\n" else "Connection: close\r\n"
    val body = if (request.method == "HEAD") "" else encoded.body
    var total = 9 + statusText.size + 1 + reason.size + 2 + connection.size + 2 + body.size
    var hasLength = false
    for (header in encoded.headers) {
        if (!httpAsciiEqualInsensitive(header.name, "Connection")) {
            total = total + header.name.size + 2 + header.value.size + 2
            if (httpAsciiEqualInsensitive(header.name, "Content-Length")) hasLength = true
        }
    }
    val addLength = !hasLength && encoded.status != 101
    val lengthText = if (addLength) "${encoded.body.size}" else ""
    if (addLength) total = total + 16 + lengthText.size + 2
    val output = adoptNativeString(
        ablaUnsafePointerAddress(ablaUnsafeAllocate(total + 1)), total
    )
    val address = ablaUnsafeStringAddress(output)
    var offset = httpEventResponseCopy(address, total, 0, "HTTP/1.1 ")
    offset = httpEventResponseCopy(address, total, offset, statusText)
    offset = httpEventResponseCopy(address, total, offset, " ")
    offset = httpEventResponseCopy(address, total, offset, reason)
    offset = httpEventResponseCopy(address, total, offset, "\r\n")
    for (header in encoded.headers) {
        if (!httpAsciiEqualInsensitive(header.name, "Connection")) {
            offset = httpEventResponseCopy(address, total, offset, header.name)
            offset = httpEventResponseCopy(address, total, offset, ": ")
            offset = httpEventResponseCopy(address, total, offset, header.value)
            offset = httpEventResponseCopy(address, total, offset, "\r\n")
        }
    }
    offset = httpEventResponseCopy(address, total, offset, connection)
    if (addLength) {
        offset = httpEventResponseCopy(address, total, offset, "Content-Length: ")
        offset = httpEventResponseCopy(address, total, offset, lengthText)
        offset = httpEventResponseCopy(address, total, offset, "\r\n")
    }
    offset = httpEventResponseCopy(address, total, offset, "\r\n")
    offset = httpEventResponseCopy(address, total, offset, body)
    if (offset == total) output else httpEventResponsePortable(request, encoded, keepAlive)
}

// Process one framed request in the caller's region. Keeping this separate
// lets readReady place the socket buffer, parser graph, handler result, and
// response framing in one allocation region. Only an incomplete input or a
// backpressured output is promoted across that boundary.
fun HttpEventServer.processNoEscapeInputInRegion(
    slot: int,
    input: string
): int {
    var readyToWrite = false
    val frame = httpEventFrame(
        input,
        this.options.maximumHeaderBytes,
        this.options.maximumBodyBytes,
        this.peerAddresses[slot]
    )
    val length = frame.length
    if (length < 0) {
        this.outputs[slot] = memoryPromoteString(
            httpText("bad request", 400).render()
        )
        this.outputOffsets[slot] = 0
        this.closing[slot] = true
        readyToWrite = true
    } else if (length > 0) {
        val framed = if (length < input.size) input.slice(0, length)
            else input
        val availableRequest = frame.request
        // A request the frame parsed already carries the peer; one parsed here (a chunked body
        // completed later) gets it by a copy.
        val request = if (availableRequest != null) availableRequest
            else httpRequestWithAddress(
                httpEventRequest(framed, this.options.maximumBodyBytes),
                this.peerAddresses[slot]
            )
        val eventHandler = this.noEscapeHandler
        val response = eventHandler(request)
        this.requestCounts[slot] = this.requestCounts[slot] + 1
        val keepAlive = httpEventKeepAlive(request, frame.http10) &&
            !this.draining &&
            this.requestCounts[slot] <
                this.options.maximumRequestsPerConnection
        val framedResponse = httpEventResponse(
            request, response, keepAlive,
            this.options.gzipMinimumBytes
        )
        this.closing[slot] = !keepAlive
        if (framedResponse.size > this.options.maximumPendingBytes) {
            this.closeSlot(slot)
        } else if (this.descriptors[slot] >= 0) {
            val connection = TcpConnection(this.descriptors[slot])
            // Scatter/gather avoids copying large segmented bodies, while
            // the contiguous writer remains cheaper for small responses.
            val written = if (framedResponse.size >= 4096) {
                connection.writeCompact(framedResponse)
            } else connection.writeResult(framedResponse)
            connection.descriptor = -1
            if (written.written > 0 &&
                written.written < framedResponse.size) {
                this.lastActivityMilliseconds[slot] =
                    this.passMilliseconds
            }
            if (written.failed() && written.errorCode != 11) {
                this.closeSlot(slot)
            } else if (written.written >= framedResponse.size) {
                this.outputOffsets[slot] = 0
                if (this.closing[slot]) this.closeSlot(slot)
            } else {
                this.outputs[slot] = memoryPromoteString(framedResponse)
                this.outputOffsets[slot] = written.written
                if (!this.writeWatching[slot] &&
                    this.poller.modifyDescriptor(
                        this.descriptors[slot], false, true
                    )) this.writeWatching[slot] = true
            }
        }
    }
    if (readyToWrite) {
        if (this.outputs[slot].size > this.options.maximumPendingBytes) {
            this.closeSlot(slot)
        } else if (this.descriptors[slot] >= 0) this.writeReady(slot)
    }
    length
}

// Dispatches complete requests in a connection slot through the no-escape handler and queues their responses.
fun HttpEventServer.processNoEscapeSlot(slot: int): void {
    var processing = slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
    while (processing) {
        var consumed = 0
        var clearInput = false
        region {
            val input = this.inputs[slot]
            consumed = this.processNoEscapeInputInRegion(slot, input)
            if (consumed < 0 || consumed >= input.size) {
                clearInput = true
            } else if (consumed > 0) {
                this.inputs[slot] = memoryPromoteString(
                    input.slice(consumed, input.size)
                )
            }
            0
        }
        if (clearInput) this.inputs[slot] = ""
        processing = consumed > 0 &&
            this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
    }
    return
}

// Dispatches buffered requests and queues a response when the connection is open and has no pending output.
fun HttpEventServer.processSlot(slot: int): void {
    if (this.useNoEscapeHandler) {
        this.processNoEscapeSlot(slot)
        return
    }
    var processing = slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
    while (processing) {
        val frame = httpEventFrame(
            this.inputs[slot],
            this.options.maximumHeaderBytes,
            this.options.maximumBodyBytes
        )
        val length = frame.length
        if (length < 0) {
            this.outputs[slot] = httpText("bad request", 400).render()
            this.outputOffsets[slot] = 0
            this.closing[slot] = true
            processing = false
            // Written now, as the answer to a good request is: without this it
            // waited for a writable event nothing had asked for, and the
            // connection closed at its idle timeout with no 400.
            this.writeReady(slot)
        } else if (length == 0) processing = false
        else {
            var framed = this.inputs[slot]
            if (length < this.inputs[slot].size) {
                framed = this.inputs[slot].slice(0, length)
                this.inputs[slot] = this.inputs[slot].slice(
                    length, this.inputs[slot].size
                )
            } else this.inputs[slot] = ""
            val availableRequest = frame.request
            val parsed = if (availableRequest != null) availableRequest
                else httpEventRequest(framed, this.options.maximumBodyBytes)
            val request = httpRequestWithAddress(parsed, this.peerAddresses[slot])
            var response = this.router.dispatch(request)
            if (this.useHandler) {
                val eventHandler = this.handler
                response = eventHandler(request)
            }
            this.requestCounts[slot] = this.requestCounts[slot] + 1
            val keepAlive = httpEventKeepAlive(request, frame.http10) &&
                !this.draining &&
                this.requestCounts[slot] <
                    this.options.maximumRequestsPerConnection
            this.outputs[slot] = region {
                memoryPromoteString(httpEventResponse(
                    request, response, keepAlive,
                    this.options.gzipMinimumBytes
                ))
            }
            this.outputOffsets[slot] = 0
            this.closing[slot] = !keepAlive
            if (this.outputs[slot].size >
                this.options.maximumPendingBytes) {
                this.closeSlot(slot)
            } else if (this.descriptors[slot] >= 0) {
                // A small response will normally fit in the socket send
                // buffer immediately. Try it here instead of always paying
                // for a second epoll wake-up; writeReady retains the exact
                // same backpressure path when the write is partial.
                this.writeReady(slot)
            }
            processing = false
        }
    }
    return
}

// Accepts ready clients until accept fails, draining starts, or the connection limit is reached.
fun HttpEventServer.acceptReady(): void {
    var accepting = !this.draining && this.activeConnections() <
        this.options.maximumConnections
    while (accepting) {
        val connection = this.listener.accept()
        if (connection.descriptor < 0) accepting = false
        else {
            connection.setNonblocking()
            connection.setNoDelay()
            val descriptor = connection.descriptor
            connection.descriptor = -1
            this.allocateSlot(descriptor)
            this.poller.watchDescriptor(descriptor)
            accepting = this.activeConnections() <
                this.options.maximumConnections
        }
    }
    return
}

// Reads and processes ready bytes for a valid open slot that has no pending output.
fun HttpEventServer.readReady(slot: int): void {
    var reading = slot >= 0 && this.descriptors[slot] >= 0 &&
        this.outputs[slot].size == 0
    while (reading) {
        if (this.useNoEscapeHandler) {
            var clearInput = false
            reading = region {
                var pending = this.inputs[slot]
                var accumulating = true
                var continueReading = false
                var reads = 0
                // Keep adjacent pieces of an incomplete request in this
                // region. Promote only when yielding back to the event loop,
                // rather than copying every full receive into the GC heap.
                // Bound the region even for a continuously sending client.
                while (accumulating) {
                    val connection = TcpConnection(this.descriptors[slot])
                    var receiveMaximum = this.options.maximumHeaderBytes +
                        this.options.maximumBodyBytes - pending.size + 1
                    if (receiveMaximum > 131072) receiveMaximum = 131072
                    val incoming = connection.readCompact(receiveMaximum)
                    connection.descriptor = -1
                    reads = reads + 1
                    continueReading = false
                    accumulating = false
                    if (incoming.size > 0) {
                        this.lastActivityMilliseconds[slot] =
                            this.passMilliseconds
                        val input = "$pending$incoming"
                        if (input.size >
                            this.options.maximumHeaderBytes +
                            this.options.maximumBodyBytes &&
                            httpEventRequestLength(input,
                                this.options.maximumHeaderBytes,
                                this.options.maximumBodyBytes) <= 0) {
                            this.closeSlot(slot)
                        } else {
                            var consumed = 0
                            var offset = 0
                            var processing = true
                            while (processing) {
                                consumed = this.processNoEscapeInputInRegion(
                                    slot, input.slice(offset, input.size)
                                )
                                if (consumed > 0) offset = offset + consumed
                                processing = consumed > 0 &&
                                    offset < input.size &&
                                    this.descriptors[slot] >= 0 &&
                                    this.outputs[slot].size == 0
                            }
                            pending = if (this.descriptors[slot] >= 0 && offset < input.size) {
                                input.slice(offset, input.size)
                            } else ""
                            accumulating = offset == 0 && consumed == 0 &&
                                reads < 4 &&
                                this.descriptors[slot] >= 0 &&
                                this.outputs[slot].size == 0
                        }
                        continueReading = incoming.size == receiveMaximum &&
                            this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
                    }
                }
                if (this.descriptors[slot] >= 0 && pending.size > 0) {
                    this.inputs[slot] = memoryPromoteString(pending)
                } else clearInput = true
                continueReading
            }
            if (clearInput) this.inputs[slot] = ""
        } else {
            val connection = TcpConnection(this.descriptors[slot])
            // Read a typical API body and its headers in one receive
            // operation, continuing after a full edge-triggered chunk.
            val incoming = connection.readCompact(32768)
            connection.descriptor = -1
            if (incoming.size > 0) {
                this.lastActivityMilliseconds[slot] =
                    this.passMilliseconds
                this.inputs[slot] = memoryPromoteString(
                    "${this.inputs[slot]}$incoming"
                )
                if (this.inputs[slot].size >
                    this.options.maximumHeaderBytes +
                    this.options.maximumBodyBytes &&
                    httpEventRequestLength(this.inputs[slot],
                        this.options.maximumHeaderBytes,
                        this.options.maximumBodyBytes) <= 0) {
                    this.closeSlot(slot)
                } else this.processSlot(slot)
                reading = incoming.size == 32768 &&
                    this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
            } else reading = false
        }
    }
    return
}

// Writes pending response bytes for a valid open slot and updates its progress or closes it on failure.
fun HttpEventServer.writeReady(slot: int): void {
    if (slot >= 0 && this.descriptors[slot] >= 0 &&
        this.outputOffsets[slot] < this.outputs[slot].size) {
        val connection = TcpConnection(this.descriptors[slot])
        val remaining = this.outputs[slot].slice(
            this.outputOffsets[slot], this.outputs[slot].size
        )
        val written = connection.writeResult(remaining)
        connection.descriptor = -1
        if (written.written > 0) {
            this.lastActivityMilliseconds[slot] = this.passMilliseconds
        }
        this.outputOffsets[slot] =
            this.outputOffsets[slot] + written.written
        if (written.failed() && written.errorCode != 11) this.closeSlot(slot)
        else if (this.outputOffsets[slot] >= this.outputs[slot].size) {
            this.outputs[slot] = ""
            this.outputOffsets[slot] = 0
            if (this.closing[slot]) this.closeSlot(slot)
            else if (this.descriptors[slot] >= 0) {
                if (this.writeWatching[slot]) {
                    this.poller.modifyDescriptor(
                        this.descriptors[slot], true, false
                    )
                    this.writeWatching[slot] = false
                }
                this.processSlot(slot)
            }
        } else if (!this.writeWatching[slot]) {
            if (this.poller.modifyDescriptor(
                this.descriptors[slot], false, true
            )) this.writeWatching[slot] = true
        }
    }
    return
}

// Polls for up to `timeoutMilliseconds`, handles ready connections, and expires idle ones. Returns the number of handled readiness events.
fun HttpEventServer.step(timeoutMilliseconds: int = 1000): int {
    var handled = 0
    var maximumEvents = this.options.maximumConnections + 1
    if (maximumEvents > 1024) maximumEvents = 1024
    val events = this.poller.waitCompact(
        maximumEvents,
        timeoutMilliseconds
    )
    this.passMilliseconds = linuxMonotonicMilliseconds()
    var index = 0
    while (index + 12 <= events.size) {
        val flags = textReadU32LittleEndian(events, index)
        val descriptor = textReadU32LittleEndian(events, index + 4)
        val readable = (flags & 1) != 0
        val writable = (flags & 4) != 0
        // Linux reports an orderly peer half-close as EPOLLRDHUP (8192),
        // while an abrupt hangup uses EPOLLHUP (16). The former hosted C
        // adapter normalized both to bit 16; the all-Abla raw epoll path
        // preserves native flags, so handle both without leaking the slot.
        val closed = (flags & 16) != 0 || (flags & 8192) != 0
        val error = (flags & 8) != 0
        if (!this.draining &&
            descriptor == this.listener.descriptor && readable) {
            this.acceptReady()
            handled = handled + 1
        } else {
            val slot = this.findDescriptor(descriptor)
            if (slot >= 0) {
                if (error || closed) this.closeSlot(slot)
                else {
                    if (readable) this.readReady(slot)
                    if (writable && slot < this.descriptors.size &&
                        this.descriptors[slot] >= 0) this.writeReady(slot)
                }
                handled = handled + 1
            }
        }
        index = index + 12
    }
    if (this.options.idleTimeoutMilliseconds > 0) {
        val now = this.passMilliseconds
        index = 0
        while (index < this.descriptors.size) {
            if (this.descriptors[index] >= 0 &&
                now - this.lastActivityMilliseconds[index] >=
                    this.options.idleTimeoutMilliseconds) {
                this.closeSlot(index)
            }
            index = index + 1
        }
    }
    handled
}

// Begins draining by stopping acceptance of new connections. Call drain to service and close the remaining ones.
fun HttpEventServer.stop(): void {
    this.beginDrain()
    return
}

// Stops accepting new clients and starts the configured deadline for completing existing responses.
fun HttpEventServer.beginDrain(): void {
    if (!this.draining) {
        this.draining = true
        this.drainDeadlineMilliseconds = linuxMonotonicMilliseconds() +
            this.options.drainTimeoutMilliseconds
        if (this.listener.descriptor >= 0) {
            this.poller.unwatchDescriptor(this.listener.descriptor)
            this.listener.close()
        }
        var slot = 0
        while (slot < this.descriptors.size) {
            if (this.descriptors[slot] >= 0) {
                if (this.outputs[slot].size > 0) this.closing[slot] = true
                else {
                    val length = httpEventRequestLength(
                        this.inputs[slot],
                        this.options.maximumHeaderBytes,
                        this.options.maximumBodyBytes
                    )
                    if (length > 0) this.processSlot(slot)
                    else this.closeSlot(slot)
                }
            }
            slot = slot + 1
        }
    }
    return
}

// Closes every client slot and marks the server stopped.
fun HttpEventServer.forceStop(): void {
    var slot = 0
    while (slot < this.descriptors.size) {
        this.closeSlot(slot)
        slot = slot + 1
    }
    this.stopped = true
    return
}

// Services active connections until all close or the drain deadline expires, then closes the server. Returns zero.
fun HttpEventServer.drain(): int {
    this.beginDrain()
    while (this.activeConnections() > 0 &&
        linuxMonotonicMilliseconds() < this.drainDeadlineMilliseconds) {
        this.step(50)
    }
    this.forceStop()
    0
}

/** 0 while the server listens; otherwise the errno of the failed bind or listen (98 is an address already in use, 13 no
 *  permission, 22 an invalid address), or of the failed poller. A server like that never accepts: `run()` returns 1 at once. */
fun HttpEventServer.listenError(): int =
    if (this.listener.descriptor < 0) 0 - this.listener.descriptor
    else if (this.poller.descriptor < 0) 0 - this.poller.descriptor
    else 0

// Runs the readiness loop until stop or graceful shutdown. Returns 1 for a startup listen or poller error and zero after shutdown.
fun HttpEventServer.run(): int {
    if (!this.stopped && this.listenError() != 0) return 1
    this.poller.watchGracefulShutdown()
    while (!this.stopped && !tcpShutdownRequested()) this.step(1000)
    if (!this.stopped) this.drain() else 0
}
