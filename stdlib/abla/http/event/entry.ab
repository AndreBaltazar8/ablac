// Single-threaded epoll HTTP/1.1 server with bounded connections, input,
// output backpressure, persistent requests, chunked bodies, and gzip policy.

import "abla/http"
import "abla/http/stream"
import "abla/memory"
import "abla/net"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/text"
import "abla/unsafe/memory"
import "abla/bytes"
import "abla/unsafe/memory/raw"

// Sets maximum connections, input header and body bytes, pending output bytes, requests per connection, idle timeout, minimum size for gzip, and shutdown drain timeout.
// The idle timeout restarts on every byte received or written, so it does not end a peer that trickles bytes. The three deadlines after it do:
// `requestHeadTimeoutMilliseconds` closes a connection whose request head is not complete that long after its first byte (default 30 s: a head is a few
// hundred bytes), `requestTimeoutMilliseconds` one whose whole request (head and body) is not complete that long after its first byte, and
// `responseTimeoutMilliseconds` one that has not taken a queued response that long after it was queued; the last two are 0 (off) by default, since a large upload or
// download on a slow link is legitimate. A connection is closed without an answer. Run a server on an open network behind a proxy that limits connections per address.
class HttpEventServerOptions(
    val maximumConnections: int,
    val maximumHeaderBytes: int,
    val maximumBodyBytes: int,
    val maximumPendingBytes: int,
    val maximumRequestsPerConnection: int,
    val idleTimeoutMilliseconds: int,
    val gzipMinimumBytes: int,
    val drainTimeoutMilliseconds: int,
    val requestHeadTimeoutMilliseconds: int = 30000,
    val requestTimeoutMilliseconds: int = 0,
    val responseTimeoutMilliseconds: int = 0,
    // The request bytes the whole server may hold for requests whose handler has not run yet (their heads and buffered bodies, over all connections, plain, HTTPS and
    // HTTP/2): default 256 MiB, 0 = no limit. The per-connection limits above bound one connection, and a server takes `maximumConnections` of them. At the limit a new HTTP/2 stream
    // is refused (REFUSED_STREAM, a client retries), an HTTP/1 connection holding request bytes is not read until room opens (the request waits; nothing fails), and a connection holding
    // none can still send a request head (up to 16 KiB over the limit each, so a small request is answered while the budget is full of waiting bodies). A server still at the limit after
    // `idleTimeoutMilliseconds` (30 s when that is 0) closes the connection that has been idle longest among those holding request bytes, one per timeout. A request's bytes are released
    // when its handler starts, and when its connection or stream ends for any reason.
    val maximumBufferedRequestBytes: int = 268435456
)

// The most request-head bytes that a connection holding nothing may read when the server's buffered-request budget is used up.
val HTTP_EVENT_HEAD_ALLOWANCE = 16384

// The server-wide budget of `maximumBufferedRequestBytes`: `held` is the request bytes of the open connections (kept as reads and handlers go, and counted afresh at the end of every
// pass that ends with any held, so it cannot drift), `overSince` when the budget was first found used up (0: it is not), `paused` the connections whose read waits for room, and
// `waiting` whether any may (false: none is paused, and the end of a pass need not look).
class HttpEventBudget(var held: int, var overSince: int, val paused: array<bool>, var waiting: bool)

// Creates a budget with nothing held and no connection slots.
fun httpEventBudget(): HttpEventBudget = HttpEventBudget(0, 0, [], false)

// The most bytes a connection that holds `slotHeld` request bytes may read now under `limit` (0: none): the room left, and at least one request head for a connection holding nothing.
// Zero or less: the read waits.
fun HttpEventBudget.room(limit: int, slotHeld: int): int {
    if (limit <= 0) return 2147483647
    var room = limit - this.held
    if (slotHeld == 0 && room < HTTP_EVENT_HEAD_ALLOWANCE) room = HTTP_EVENT_HEAD_ALLOWANCE
    room
}

// The clocks of a server's connections for a request being received and a response being sent: when the request that is being received began
// (0: none), which request that was and whether its head has been seen, and when the queued response began. One per server, indexed by slot;
// `deadlineExpired` says whether a connection has run out of the time the options give it.
class HttpEventDeadlines(
    val requestStarted: array<int>,
    val requestStamp: array<int>,
    val headSeen: array<int>,
    val outputStarted: array<int>
)

// Creates the clocks of a server with no connection slots.
fun httpEventDeadlines(): HttpEventDeadlines = HttpEventDeadlines([], [], [], [])

// Adds the clocks of a new connection slot.
fun HttpEventDeadlines.deadlineGrow(): void {
    this.requestStarted.append(0)
    this.requestStamp.append(0)
    this.headSeen.append(0)
    this.outputStarted.append(0)
    return
}

// Stops the clocks of a slot (its connection closed or a new one took it); stores integers only.
fun HttpEventDeadlines.deadlineReset(slot: int): void {
    this.requestStarted[slot] = 0
    this.requestStamp[slot] = 0
    this.headSeen[slot] = 0
    this.outputStarted[slot] = 0
    return
}

// Records that the head of the request being received on `slot` is complete, `requestsServed` requests having been answered before it.
fun HttpEventDeadlines.deadlineHeadSeen(slot: int, requestsServed: int): void {
    this.headSeen[slot] = requestsServed + 1
    return
}

// Whether the connection of `slot` has used the time `options` give a request it is `receiving` (any byte of one is held) or a response it is
// `sending` (queued output). `headKnown` says that the head of the request is complete by other means (a chunked request being assembled). The clocks
// start on the first call that finds the request or the response, so how finely they measure is how often this is called.
fun HttpEventDeadlines.deadlineExpired(
    slot: int, now: int, options: HttpEventServerOptions, receiving: bool, headKnown: bool, requestsServed: int, sending: bool
): bool {
    var expired = false
    if (!receiving) this.requestStarted[slot] = 0
    else {
        if (this.requestStarted[slot] == 0 || this.requestStamp[slot] != requestsServed + 1) {
            this.requestStarted[slot] = now
            this.requestStamp[slot] = requestsServed + 1
        }
        val elapsed = now - this.requestStarted[slot]
        val head = headKnown || this.headSeen[slot] == requestsServed + 1
        if (!head && options.requestHeadTimeoutMilliseconds > 0 && elapsed >= options.requestHeadTimeoutMilliseconds) expired = true
        if (options.requestTimeoutMilliseconds > 0 && elapsed >= options.requestTimeoutMilliseconds) expired = true
    }
    if (!sending) this.outputStarted[slot] = 0
    else {
        if (this.outputStarted[slot] == 0) this.outputStarted[slot] = now
        if (options.responseTimeoutMilliseconds > 0 && now - this.outputStarted[slot] >= options.responseTimeoutMilliseconds) expired = true
    }
    expired
}

// Holds the parsed request, HTTP version flag, and a frame length of zero for incomplete or -1 for invalid input.
class HttpEventFrame(
    val length: int,
    val request: HttpRequest?,
    // An HTTP/1.0 request: its connection closes unless it asks for keep-alive.
    val http10: bool = false,
    // For incomplete input whose body length is known: the input size at which the request can first be complete
    // (the head and the whole body). Zero when unknown. The server then holds small reads without re-framing them.
    val need: int = 0,
    // A chunked request whose body is not complete: its head, the body decoded so far, and how many bytes of the input are
    // consumed into those (the server drops them and continues with `HttpEventChunkState.assemble`). Length is zero.
    val head: HttpRequest? = null,
    val partial: string = "",
    val trim: int = 0
)

// Owns the listener, kernel poller, and per-connection state for an event-driven HTTP server.
resource class HttpEventServer(
    val router: HttpRouter,
    val handler: (HttpRequest) -> HttpResponse,
    val noEscapeHandler: FnNoEscape(HttpRequest) -> HttpResponse,
    val useHandler: bool,
    val useNoEscapeHandler: bool,
    val listener: TcpListener,
    val poller: SocketPoller,
    val options: HttpEventServerOptions,
    val descriptors: array<int>,
    val descriptorSlots: array<int>,
    val inputs: array<string>,
    val outputs: array<string>,
    val outputOffsets: array<int>,
    val writeWatching: array<bool>,
    val requestCounts: array<int>,
    val closing: array<bool>,
    val lastActivityMilliseconds: array<int>,
    var draining: bool,
    var drainDeadlineMilliseconds: int,
    var stopped: bool,
    // The clock when this pass of step began: a request needn't read it again.
    var passMilliseconds: int,
    // One socket lookup per accepted connection, shared by persistent requests.
    val peerAddresses: array<SocketPeerAddress?> = [],
    // Reads that cannot complete the request yet wait here, unjoined, until `needs[slot]` bytes are held: joining and
    // re-framing the whole buffer on every read made a body sent a byte at a time cost quadratic CPU (#1139 area 4).
    val needs: array<int> = [],
    val tails: array<ByteBuffer> = [],
    // A chunked request whose body is not complete, per connection (see `HttpEventChunkState`).
    val chunkStates: array<HttpEventChunkState> = [],
    // The clocks of the request being received and the response being sent, per connection (see HttpEventServerOptions).
    val deadlines: HttpEventDeadlines = httpEventDeadlines(),
    // The server-wide budget of buffered request bytes (see HttpEventServerOptions.maximumBufferedRequestBytes).
    val budget: HttpEventBudget = httpEventBudget()
) {
    // Closes the open client descriptors when the server is released.
    fun drop(): void {
        var index = 0
        while (index < this.descriptors.size) {
            if (this.descriptors[index] >= 0) {
                linuxTcpCloseDescriptor(this.descriptors[index])
                this.descriptors[index] = -1
            }
            index = index + 1
        }
        this.poller.close()
        this.listener.close()
        this.stopped = true
        return
    }
}

// Returns the default event server limits for connections, headers, request and response bodies, polling, idle time, per-pass work and shutdown drain.
fun httpEventServerOptions(): HttpEventServerOptions =
    HttpEventServerOptions(
        1023, 65536, 1048576, 2097152, 1000, 30000, 256, 5000
    )

// Returns a 500 response for a handler slot that has no assigned handler.
noescape fun httpEventUnusedHandler(request: HttpRequest): HttpResponse =
    httpText("event handler is unavailable", 500)

// A server's collections: what they find unreachable is freed by a helper thread, and four threads mark and sweep
// (ABLA_GC_WORKERS overrides; a program built without a C library starts them with its own clone routine). The pauses of a
// burst of requests halve. The compiler sees these calls in this function (bootstrapProgramWantsBackgroundFree).
fun httpEventServerCollector(): void {
    memorySetBackgroundFree(true)
    memorySetGcWorkers(4)
}

// Creates an IPv4 event server over `router`, at `address`, using `options`. Set `reusePort` to request port sharing. Inspect listenError for bind, listen or poller failures.
fun httpEventServer(
    router: HttpRouter,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    httpEventServerCollector()
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        router, httpEventUnusedHandler, httpEventUnusedHandler, false, false,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false, linuxMonotonicMilliseconds()
    )
}

// Creates an IPv4 event server dispatching each request to `handler`. Sets its address, limits, and optional port sharing from the remaining arguments. Check listenError before running.
fun httpEventServerHandler(
    handler: (HttpRequest) -> HttpResponse,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    httpEventServerCollector()
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        httpRouter(), handler, httpEventUnusedHandler, true, false,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false, linuxMonotonicMilliseconds()
    )
}

// Returns an event server for a handler that cannot retain its request, with an inactive listener on bind failure.
fun httpEventServerNoEscapeHandler(
    handler: FnNoEscape(HttpRequest) -> HttpResponse,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    httpEventServerCollector()
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        httpRouter(), httpEventUnusedHandler, handler, false, true,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false, linuxMonotonicMilliseconds()
    )
}

// Returns the number of connection slots holding open descriptors.
fun HttpEventServer.activeConnections(): int {
    var active = 0
    var index = 0
    while (index < this.descriptors.size) {
        if (this.descriptors[index] >= 0) active = active + 1
        index = index + 1
    }
    active
}

// Returns the connection slot for a registered descriptor, or -1 if none is mapped.
fun HttpEventServer.findDescriptor(descriptor: int): int {
    if (descriptor >= 0 && descriptor < this.descriptorSlots.size) {
        this.descriptorSlots[descriptor]
    } else -1
}

// Registers a connected descriptor in a reusable slot and returns the slot, or -1 when registration fails or the connection limit is reached.
fun HttpEventServer.allocateSlot(descriptor: int): int {
    val peer = socketPeerAddress(descriptor)
    var slot = -1
    var index = 0
    while (slot < 0 && index < this.descriptors.size) {
        if (this.descriptors[index] < 0) slot = index
        index = index + 1
    }
    if (slot < 0) {
        slot = this.descriptors.size
        this.descriptors.append(descriptor)
        this.peerAddresses.append(peer)
        this.inputs.append("")
        this.outputs.append("")
        this.outputOffsets.append(0)
        this.writeWatching.append(false)
        this.requestCounts.append(0)
        this.closing.append(false)
        this.lastActivityMilliseconds.append(linuxMonotonicMilliseconds())
        this.needs.append(0)
        this.tails.append(byteBuffer())
        this.chunkStates.append(httpEventChunkState())
        this.deadlines.deadlineGrow()
        this.budget.paused.append(false)
    } else {
        this.descriptors[slot] = descriptor
        this.peerAddresses[slot] = peer
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.requestCounts[slot] = 0
        this.closing[slot] = false
        this.lastActivityMilliseconds[slot] = linuxMonotonicMilliseconds()
        this.needs[slot] = 0
        this.tails[slot] = byteBuffer()
        this.chunkStates[slot].reset()
        this.deadlines.deadlineReset(slot)
        this.budget.paused[slot] = false
    }
    while (this.descriptorSlots.size <= descriptor) {
        this.descriptorSlots.append(-1)
    }
    this.descriptorSlots[descriptor] = slot
    slot
}

// Closes and clears an active connection slot, ignoring invalid or already closed slots.
fun HttpEventServer.closeSlot(slot: int): void {
    if (slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0) {
        this.poller.unwatchDescriptor(this.descriptors[slot])
        if (this.descriptors[slot] < this.descriptorSlots.size) {
            this.descriptorSlots[this.descriptors[slot]] = -1
        }
        linuxTcpCloseDescriptor(this.descriptors[slot])
        this.descriptors[slot] = -1
        this.peerAddresses[slot] = null
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.closing[slot] = false
        this.lastActivityMilliseconds[slot] = 0
        // Nothing is allocated or stored here (closeSlot runs inside the region the no-escape server reads in): the held reads and the chunked-request
        // state of the closed connection stay until allocateSlot gives the slot fresh ones.
        this.needs[slot] = 0
        this.deadlines.deadlineReset(slot)
        this.budget.paused[slot] = false
    }
    return
}

// The request bytes a connection holds that no handler has taken yet: the input waiting to be framed, the reads held back (see `needs`) and the chunked body assembled so far.
// A closed slot holds none (its buffers stay until the slot is reused, and are not counted).
fun HttpEventServer.slotHeldBytes(slot: int): int =
    if (slot >= 0 && slot < this.descriptors.size && this.descriptors[slot] >= 0)
        this.inputs[slot].size + this.tails[slot].size() + this.chunkStates[slot].body.size()
    else 0

// The request bytes held by all open connections, counted afresh: what `maximumBufferedRequestBytes` limits. Zero when nothing is buffered, whatever came and went.
fun HttpEventServer.heldRequestBytes(): int {
    var total = 0
    var slot = 0
    while (slot < this.descriptors.size) {
        total = total + this.slotHeldBytes(slot)
        slot = slot + 1
    }
    total
}

// Counts the held bytes afresh, lets the connections that waited for room read again once there is some, and closes the connection idle longest among those holding request bytes
// when the budget has stayed used up for a whole idle timeout (one per timeout). Called at the end of every pass.
fun HttpEventServer.budgetEnforce(): void {
    val limit = this.options.maximumBufferedRequestBytes
    if (limit <= 0) return
    // Bytes come in only through readReady, which adds what it took in, so a count of 0 is exact (it can be high, never low):
    // the slots are walked only when it is not, which was most of a plaintext request's pass with 64 connections.
    if (this.budget.held != 0) this.budget.held = this.heldRequestBytes()
    if (this.budget.held < limit) {
        this.budget.overSince = 0
    } else {
        val now = this.passMilliseconds
        var timeout = this.options.idleTimeoutMilliseconds
        if (timeout <= 0) timeout = 30000
        if (this.budget.overSince == 0) this.budget.overSince = now
        else if (now - this.budget.overSince >= timeout) {
            var victim = -1
            var slot = 0
            while (slot < this.descriptors.size) {
                if (this.slotHeldBytes(slot) > 0 &&
                    (victim < 0 || this.lastActivityMilliseconds[slot] < this.lastActivityMilliseconds[victim])) victim = slot
                slot = slot + 1
            }
            if (victim >= 0) this.closeSlot(victim)
            this.budget.overSince = now
            this.budget.held = this.heldRequestBytes()
        }
    }
    if (!this.budget.waiting) return
    this.budget.waiting = false
    var slot = 0
    while (slot < this.budget.paused.size) {
        if (this.budget.paused[slot] && this.descriptors[slot] >= 0 && this.budget.held < limit) {
            this.budget.paused[slot] = false
            this.readReady(slot)
        }
        // (readReady may pause this connection again, or the room may still be short.)
        if (this.budget.paused[slot]) this.budget.waiting = true
        slot = slot + 1
    }
    return
}

// HTTP/1.1 keeps the connection unless the request says close; HTTP/1.0 closes unless it says keep-alive.
private fun httpEventKeepAlive(request: HttpRequest, http10: bool): bool =
    if (http10) httpHeaderTokenContains(request.header("Connection"), "keep-alive") &&
        httpRequestKeepAlive(request)
    else httpRequestKeepAlive(request)

// Returns the framed wire byte count, zero for incomplete input, or -1 for malformed framing or exceeded limits.
fun httpEventRequestLength(
    input: string,
    maximumHeader: int,
    maximumBody: int
): int {
    val headerEnd = httpHeaderEnd(input)
    var result = 0
    if ((headerEnd < 0 && input.size > maximumHeader) ||
        headerEnd > maximumHeader) result = -1
    if (headerEnd >= 0 && headerEnd <= maximumHeader) {
        val request = httpParseRequest(input.slice(0, headerEnd))
        val version = httpRequestLineVersion(input, request, headerEnd)
        val framing = httpRequestFraming(request, version == 0, maximumBody)
        if (version < 0 || framing == -1) result = -1
        else if (framing == -2) {
            val decoded = httpDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            if (decoded.error != "") result = -1
            else if (decoded.complete) result = headerEnd + decoded.consumed
        } else if (input.size >= headerEnd + framing) {
            result = headerEnd + framing
        }
    }
    result
}

private fun httpEventRequest(
    framed: string,
    maximumBody: int
): HttpRequest {
    val headerEnd = httpHeaderEnd(framed)
    val request = httpRequestOriginForm(httpParseRequest(framed))
    var result = request
    if (headerEnd >= 0 && httpHeaderTokenContains(
        request.header("Transfer-Encoding"), "chunked"
    )) {
        val decoded = httpDecodeChunked(
            framed.slice(headerEnd, framed.size), maximumBody
        )
        result = HttpRequest(
            request.method, request.path, request.query, request.headers,
            decoded.body, request.parameterNames, request.parameterValues
        )
    }
    result
}

// Returns the parsed request and consumed length, with zero for incomplete input or -1 for rejected framing.
fun httpEventFrame(
    input: string,
    maximumHeader: int,
    maximumBody: int,
    peer: SocketPeerAddress? = null
): HttpEventFrame {
    val headerEnd = httpHeaderEnd(input)
    var length = 0
    var framedRequest: HttpRequest? = null
    var http10 = false
    var need = 0
    var head: HttpRequest? = null
    var partial = ""
    var trim = 0
    if ((headerEnd < 0 && input.size > maximumHeader) ||
        headerEnd > maximumHeader) length = -1
    if (headerEnd >= 0 && headerEnd <= maximumHeader) {
        // Parse the request head once and retain it for dispatch. The previous
        // event path parsed every complete request once to discover framing,
        // discarded that graph, then parsed the same bytes again.
        val parsed = httpParseRequestFrom(input, peer)
        val version = httpRequestLineVersion(input, parsed, headerEnd)
        http10 = version == 0
        val framing = httpRequestFraming(parsed, http10, maximumBody)
        // An absolute-form target is served by its path, with its authority as the host (RFC 9112 3.2.2).
        val request = httpRequestOriginForm(parsed)
        if (version < 0 || framing == -1) length = -1
        else if (framing == -2) {
            val decoded = httpDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            if (decoded.error != "") length = -1
            else if (decoded.complete) {
                length = headerEnd + decoded.consumed
                framedRequest = HttpRequest(
                    request.method, request.path, request.query,
                    request.headers, decoded.body,
                    request.parameterNames, request.parameterValues, peer
                )
            } else {
                // Incomplete: hand back the head and what was decoded before the first incomplete chunk element, so that
                // the server keeps them and decodes only what arrives next (a chunked body used to be decoded again whole
                // on every read).
                head = request
                partial = decoded.body
                trim = headerEnd + decoded.resume
                if (decoded.need > 0) need = headerEnd + decoded.need
            }
        } else {
            val bodyLength = framing
            if (input.size >= headerEnd + bodyLength) {
                length = headerEnd + bodyLength
                if (bodyLength == 0 && length == input.size) {
                    framedRequest = request
                } else framedRequest = HttpRequest(
                    request.method, request.path, request.query,
                    request.headers,
                    input.slice(headerEnd, length),
                    request.parameterNames, request.parameterValues, peer
                )
            } else need = headerEnd + bodyLength
        }
    }
    HttpEventFrame(length, framedRequest, http10, need, head, partial, trim)
}

// Renders a response with request-aware body suppression and optional gzip compression.
fun httpEventResponse(
    request: HttpRequest,
    response: HttpResponse,
    keepAlive: bool,
    gzipMinimumBytes: int
): string {
    var encoded = response
    if (response.body.size >= gzipMinimumBytes) {
        encoded = httpGzipResponse(request, response, gzipMinimumBytes)
    }
    if (ablaCompileTimeNativeHost()) httpEventResponseNative(request, encoded, keepAlive)
    else if (ablaAtCompileTime()) httpEventResponsePortable(request, encoded, keepAlive)
    else httpEventResponseNative(request, encoded, keepAlive)
}

// Renders the HTTP/1.1 status, headers, and permitted body bytes with the requested connection behavior.
@noinline
fun httpEventResponsePortable(
    request: HttpRequest, encoded: HttpResponse, keepAlive: bool
): string {
    var output = "HTTP/1.1 ${encoded.status} ${httpStatusReason(encoded.status)}\r\n"
    var hasLength = false
    var index = 0
    while (index < encoded.headers.size) {
        val header = encoded.headers[index]
        if (!httpAsciiEqualInsensitive(header.name, "Connection")) {
            output = "$output${header.name}: ${header.value}\r\n"
            if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
                hasLength = true
            }
        }
        index = index + 1
    }
    output = "${output}Connection: ${if (keepAlive) "keep-alive" else "close"}\r\n"
    if (!hasLength && encoded.status != 101) {
        output = "${output}Content-Length: ${encoded.body.size}\r\n"
    }
    output = "$output\r\n"
    if (request.method != "HEAD") output = "$output${encoded.body}"
    output
}

// A slot's reads and small writes go by its descriptor: a TcpConnection made for each call (and disarmed so that its drop
// does not close the socket) and a SocketWriteResult were three allocations a request.

// Reads up to `maximum` bytes from `descriptor`, as TcpConnection.readCompact does.
private fun httpEventRead(descriptor: int, maximum: int): string =
    if (descriptor >= 0 && maximum > 0 && maximum <= 1048576) ablaLinuxTcpReadCompact(descriptor, maximum) else ""

// The written count and the errno a send stopped at, packed in one int (httpEventSendWritten, httpEventSendError).
private val HTTP_EVENT_SEND_ERROR_SHIFT = 1099511627776

/** Sends `contents` to `descriptor` as TcpConnection.writeResult does (MSG_NOSIGNAL, until all of it is written, an error
 *  stops it or the kernel would block: EAGAIN 11), and returns the bytes written plus the errno that stopped it (0: none;
 *  9 for a closed descriptor, 5 for a zero-byte send) times HTTP_EVENT_SEND_ERROR_SHIFT. */
private trusted fun httpEventSend(descriptor: int, contents: string): int {
    val address = nativeStringDataAddress(contents)
    var written = 0
    var errorCode = if (descriptor >= 0) 0 else 9
    while (errorCode == 0 && written < contents.size) {
        val amount = linuxSyscall6(44, descriptor, address + written, contents.size - written, 16384, 0, 0)
        if (amount > 0) written = written + amount
        if (amount == 0) errorCode = 5
        if (amount < 0 && amount != -4) errorCode = -amount
    }
    written + errorCode * HTTP_EVENT_SEND_ERROR_SHIFT
}

private fun httpEventSendWritten(packed: int): int = packed % HTTP_EVENT_SEND_ERROR_SHIFT
private fun httpEventSendError(packed: int): int = packed / HTTP_EVENT_SEND_ERROR_SHIFT

// The decimal digits of a non-negative `value` (a status code, a body length): how many, and written into the response at
// `offset` (-1 when they do not fit, as httpEventResponseCopy), so that neither number needs a string of its own.
private fun httpEventDecimalSize(value: int): int {
    var size = 1
    var rest = value
    while (rest >= 10) {
        rest = rest / 10
        size = size + 1
    }
    size
}

private trusted fun httpEventResponseDecimal(address: int, capacity: int, offset: int, value: int): int {
    val size = httpEventDecimalSize(value)
    if (offset < 0 || offset > capacity || size > capacity - offset) return -1
    var at = offset + size - 1
    var rest = value
    while (at >= offset) {
        ablaUnsafeStoreU8(nativePointerFromAddress(address + at), 48 + rest % 10)
        rest = rest / 10
        at = at - 1
    }
    offset + size
}

// Bounds-check every copy even though the capacity is computed first.
private trusted fun httpEventResponseCopy(
    address: int, capacity: int, offset: int, value: string
): int {
    if (offset < 0 || offset > capacity || value.size > capacity - offset) return -1
    ablaUnsafeCopyMemory(address + offset, ablaUnsafeStringAddress(value), value.size)
    offset + value.size
}

// Serialize into one exact-size allocation instead of constructing a chain
// of temporary strings and flattening its ropes at the socket boundary.
trusted fun httpEventResponseNative(
    request: HttpRequest, encoded: HttpResponse, keepAlive: bool
): string {
    // The status and the body length are written as digits into the response (httpEventResponseDecimal); a negative
    // status (not one a handler should give) keeps its text.
    val statusText = if (encoded.status < 0) "${encoded.status}" else ""
    val statusSize = if (encoded.status < 0) statusText.size else httpEventDecimalSize(encoded.status)
    val reason = httpStatusReason(encoded.status)
    val connection = if (keepAlive) "Connection: keep-alive\r\n" else "Connection: close\r\n"
    val body = if (request.method == "HEAD") "" else encoded.body
    var total = 9 + statusSize + 1 + reason.size + 2 + connection.size + 2 + body.size
    var hasLength = false
    for (header in encoded.headers) {
        if (!httpAsciiEqualInsensitive(header.name, "Connection")) {
            total = total + header.name.size + 2 + header.value.size + 2
            if (httpAsciiEqualInsensitive(header.name, "Content-Length")) hasLength = true
        }
    }
    val addLength = !hasLength && encoded.status != 101
    if (addLength) total = total + 16 + httpEventDecimalSize(encoded.body.size) + 2
    val output = adoptNativeString(
        ablaUnsafePointerAddress(ablaUnsafeAllocate(total + 1)), total
    )
    val address = ablaUnsafeStringAddress(output)
    var offset = httpEventResponseCopy(address, total, 0, "HTTP/1.1 ")
    offset = if (encoded.status < 0) httpEventResponseCopy(address, total, offset, statusText)
        else httpEventResponseDecimal(address, total, offset, encoded.status)
    offset = httpEventResponseCopy(address, total, offset, " ")
    offset = httpEventResponseCopy(address, total, offset, reason)
    offset = httpEventResponseCopy(address, total, offset, "\r\n")
    for (header in encoded.headers) {
        if (!httpAsciiEqualInsensitive(header.name, "Connection")) {
            offset = httpEventResponseCopy(address, total, offset, header.name)
            offset = httpEventResponseCopy(address, total, offset, ": ")
            offset = httpEventResponseCopy(address, total, offset, header.value)
            offset = httpEventResponseCopy(address, total, offset, "\r\n")
        }
    }
    offset = httpEventResponseCopy(address, total, offset, connection)
    if (addLength) {
        offset = httpEventResponseCopy(address, total, offset, "Content-Length: ")
        offset = httpEventResponseDecimal(address, total, offset, encoded.body.size)
        offset = httpEventResponseCopy(address, total, offset, "\r\n")
    }
    offset = httpEventResponseCopy(address, total, offset, "\r\n")
    offset = httpEventResponseCopy(address, total, offset, body)
    if (offset == total) output else httpEventResponsePortable(request, encoded, keepAlive)
}

// Process one framed request in the caller's region. Keeping this separate
// lets readReady place the socket buffer, parser graph, handler result, and
// response framing in one allocation region. Only an incomplete input or a
// backpressured output is promoted across that boundary.
// A chunked request whose body is not complete, kept in pieces: its head, whether it is HTTP/1.0, and the body decoded so far. An
// event server keeps one per connection and frames its input through `assemble`.
class HttpEventChunkState(
    var head: HttpRequest?,
    var http10: bool,
    var body: ByteBuffer
)

// Creates the state of a connection that is not assembling a chunked request.
fun httpEventChunkState(): HttpEventChunkState = HttpEventChunkState(null, false, byteBuffer())

// Forgets the request being assembled.
fun HttpEventChunkState.reset(): void {
    this.head = null
    this.http10 = false
    this.body = byteBuffer()
    return
}

// Frames the input of a connection like `httpEventFrame`, except that a chunked request whose body is not complete is kept in
// this state: its head and the body decoded so far stay here, `trim` bytes of the input (everything before the first incomplete chunk
// element) are the caller's to drop, and the next call decodes only what follows (a body of many chunks sent a piece at a time used to be
// decoded again from its start on every read). `need` is relative to the input once trimmed.
fun HttpEventChunkState.assemble(input: string, maximumHeader: int, maximumBody: int, peer: SocketPeerAddress?): HttpEventFrame {
    val head = this.head
    if (head == null) {
        val frame = httpEventFrame(input, maximumHeader, maximumBody, peer)
        val partialHead = frame.head
        if (frame.length != 0 || partialHead == null) return frame
        val body = byteBuffer()
        body.appendText(frame.partial)
        this.head = partialHead
        this.http10 = frame.http10
        this.body = body
        return HttpEventFrame(0, null, frame.http10, if (frame.need > 0) frame.need - frame.trim else 0, null, "", frame.trim)
    }
    val http10 = this.http10
    val decoded = httpDecodeChunked(input, maximumBody - this.body.size())
    // One chunk element (a size line with its extensions, or the trailers) may not be longer than a request head.
    if (decoded.error != "" || (!decoded.complete && input.size - decoded.resume > maximumHeader)) {
        this.reset()
        return HttpEventFrame(-1, null, http10)
    }
    if (decoded.complete) {
        this.body.appendText(decoded.body)
        val request = HttpRequest(
            head.method, head.path, head.query, head.headers, this.body.toText(),
            head.parameterNames, head.parameterValues, peer
        )
        this.reset()
        return HttpEventFrame(decoded.consumed, request, http10)
    }
    this.body.appendText(decoded.body)
    return HttpEventFrame(0, null, http10, if (decoded.need > 0) decoded.need - decoded.resume else 0, null, "", decoded.resume)
}

// Hands a framed request to the no-escape handler and writes (or queues) its response. Runs inside the region the no-escape server reads in, and
// from `processNoEscapeChunked` outside one: it stores only ints and promoted strings into the server.
fun HttpEventServer.dispatchNoEscape(slot: int, request: HttpRequest, http10: bool): void {
    val eventHandler = this.noEscapeHandler
    val response = eventHandler(request)
    this.requestCounts[slot] = this.requestCounts[slot] + 1
    val keepAlive = httpEventKeepAlive(request, http10) &&
        !this.draining &&
        this.requestCounts[slot] <
            this.options.maximumRequestsPerConnection
    val framedResponse = httpEventResponse(
        request, response, keepAlive,
        this.options.gzipMinimumBytes
    )
    this.closing[slot] = !keepAlive
    if (framedResponse.size > this.options.maximumPendingBytes) {
        this.closeSlot(slot)
    } else if (this.descriptors[slot] >= 0) {
        // Scatter/gather avoids copying large segmented bodies, while
        // the contiguous writer remains cheaper for small responses (by the descriptor: httpEventSend).
        var sent = 0
        var sendError = 0
        if (framedResponse.size >= 4096) {
            val connection = TcpConnection(this.descriptors[slot])
            val written = connection.writeCompact(framedResponse)
            connection.descriptor = -1
            sent = written.written
            if (written.failed()) sendError = written.errorCode
        } else {
            val packed = httpEventSend(this.descriptors[slot], framedResponse)
            sent = httpEventSendWritten(packed)
            sendError = httpEventSendError(packed)
        }
        if (sent > 0 &&
            sent < framedResponse.size) {
            this.lastActivityMilliseconds[slot] =
                this.passMilliseconds
        }
        if (sendError != 0 && sendError != 11) {
            this.closeSlot(slot)
        } else if (sent >= framedResponse.size) {
            this.outputOffsets[slot] = 0
            if (this.closing[slot]) this.closeSlot(slot)
        } else {
            this.outputs[slot] = memoryPromoteString(framedResponse)
            this.outputOffsets[slot] = sent
            if (!this.writeWatching[slot] &&
                this.poller.modifyDescriptor(
                    this.descriptors[slot], false, true
                )) this.writeWatching[slot] = true
        }
    }
    return
}

// Frames one request from a slot's input inside the caller's region, runs the no-escape handler on it and queues the response; returns the bytes consumed, 0 when more input is needed, -3 (nothing consumed) when a chunked request is being assembled and the caller must continue with processNoEscapeChunked outside the region, or another negative value for a malformed request (answered with 400, then closed).
fun HttpEventServer.processNoEscapeInputInRegion(
    slot: int,
    input: string
): int {
    var readyToWrite = false
    // A chunked request is being assembled: its state lives in the server, so it is framed outside the region (-3, nothing consumed).
    if (this.chunkStates[slot].head != null) return -3
    // The stateless framing: what the chunked-request state keeps (a parsed head, a buffer that grows) must not be allocated in a region.
    val frame = httpEventFrame(
        input, this.options.maximumHeaderBytes, this.options.maximumBodyBytes, this.peerAddresses[slot]
    )
    val length = frame.length
    // A chunked request that is not complete yet starts to be assembled outside the region.
    if (length == 0 && frame.head != null) return -3
    this.needs[slot] = if (length == 0) frame.need else 0
    if (length == 0 && (frame.need > 0 || frame.head != null)) this.deadlines.deadlineHeadSeen(slot, this.requestCounts[slot])
    if (length < 0) {
        this.outputs[slot] = memoryPromoteString(
            httpText("bad request", 400).render()
        )
        this.outputOffsets[slot] = 0
        this.closing[slot] = true
        readyToWrite = true
    } else if (length > 0) {
        val framed = if (length < input.size) input.slice(0, length)
            else input
        val availableRequest = frame.request
        // A request the frame parsed already carries the peer; one parsed here (a chunked body
        // completed later) gets it by a copy.
        val request = if (availableRequest != null) availableRequest
            else httpRequestWithAddress(
                httpEventRequest(framed, this.options.maximumBodyBytes),
                this.peerAddresses[slot]
            )
        this.dispatchNoEscape(slot, request, frame.http10)
    }
    if (readyToWrite) {
        if (this.outputs[slot].size > this.options.maximumPendingBytes) {
            this.closeSlot(slot)
        } else if (this.descriptors[slot] >= 0) this.writeReady(slot)
    }
    length
}

// Frames and dispatches what a no-escape connection holds once a chunked request is being assembled: outside any region, where the
// chunk state (a parsed head, a buffer that grows) can be kept in the server. The region path hands over to this when it sees a
// chunked request that is not complete (it returns -3, nothing consumed) and until the connection holds no such request.
fun HttpEventServer.processNoEscapeChunked(slot: int): void {
    var processing = slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
    while (processing) {
        val frame = this.chunkStates[slot].assemble(
            this.inputs[slot], this.options.maximumHeaderBytes, this.options.maximumBodyBytes, this.peerAddresses[slot]
        )
        val length = frame.length
        this.needs[slot] = if (length == 0) frame.need else 0
        if (length == 0 && (frame.need > 0 || frame.head != null)) this.deadlines.deadlineHeadSeen(slot, this.requestCounts[slot])
        if (length == 0 && frame.trim > 0) {
            this.inputs[slot] = this.inputs[slot].slice(frame.trim, this.inputs[slot].size)
        }
        if (length < 0) {
            this.outputs[slot] = httpText("bad request", 400).render()
            this.outputOffsets[slot] = 0
            this.closing[slot] = true
            processing = false
            this.writeReady(slot)
        } else if (length == 0) processing = false
        else {
            val request = frame.request
            if (request == null) {
                this.closeSlot(slot)
                return
            }
            if (length < this.inputs[slot].size) {
                this.inputs[slot] = this.inputs[slot].slice(length, this.inputs[slot].size)
            } else this.inputs[slot] = ""
            this.dispatchNoEscape(slot, request, frame.http10)
            processing = this.inputs[slot].size > 0 &&
                this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
        }
    }
    return
}

// Dispatches complete requests in a connection slot through the no-escape handler and queues their responses.
fun HttpEventServer.processNoEscapeSlot(slot: int): void {
    var processing = slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
    while (processing) {
        var consumed = 0
        var clearInput = false
        region {
            val input = this.inputs[slot]
            consumed = this.processNoEscapeInputInRegion(slot, input)
            if (consumed == -3) {
                // Nothing consumed: a chunked request is framed outside the region (inputs[slot] is already in the heap).
            } else if (consumed < 0 || consumed >= input.size) {
                clearInput = true
            } else if (consumed > 0) {
                this.inputs[slot] = memoryPromoteString(
                    input.slice(consumed, input.size)
                )
            }
            0
        }
        if (clearInput) this.inputs[slot] = ""
        if (consumed == -3) {
            this.processNoEscapeChunked(slot)
            processing = false
        } else processing = consumed > 0 &&
            this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
    }
    return
}

// Dispatches buffered requests and queues a response when the connection is open and has no pending output.
fun HttpEventServer.processSlot(slot: int): void {
    if (this.useNoEscapeHandler) {
        this.processNoEscapeSlot(slot)
        return
    }
    var processing = slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
    while (processing) {
        val frame = this.chunkStates[slot].assemble(this.inputs[slot], this.options.maximumHeaderBytes, this.options.maximumBodyBytes, this.peerAddresses[slot])
        val length = frame.length
        if (length == 0 && frame.trim > 0) {
            // A chunked request still incomplete: what is before its first incomplete chunk element is in the slot's state.
            this.inputs[slot] = this.inputs[slot].slice(frame.trim, this.inputs[slot].size)
        }
        this.needs[slot] = if (length == 0) frame.need else 0
        if (length == 0 && (frame.need > 0 || frame.head != null)) this.deadlines.deadlineHeadSeen(slot, this.requestCounts[slot])
        if (length < 0) {
            this.outputs[slot] = httpText("bad request", 400).render()
            this.outputOffsets[slot] = 0
            this.closing[slot] = true
            processing = false
            // Written now, as the answer to a good request is: without this it
            // waited for a writable event nothing had asked for, and the
            // connection closed at its idle timeout with no 400.
            this.writeReady(slot)
        } else if (length == 0) processing = false
        else {
            var framed = this.inputs[slot]
            if (length < this.inputs[slot].size) {
                framed = this.inputs[slot].slice(0, length)
                this.inputs[slot] = this.inputs[slot].slice(
                    length, this.inputs[slot].size
                )
            } else this.inputs[slot] = ""
            val availableRequest = frame.request
            val parsed = if (availableRequest != null) availableRequest
                else httpEventRequest(framed, this.options.maximumBodyBytes)
            val request = httpRequestWithAddress(parsed, this.peerAddresses[slot])
            var response = this.router.dispatch(request)
            if (this.useHandler) {
                val eventHandler = this.handler
                response = eventHandler(request)
            }
            this.requestCounts[slot] = this.requestCounts[slot] + 1
            val keepAlive = httpEventKeepAlive(request, frame.http10) &&
                !this.draining &&
                this.requestCounts[slot] <
                    this.options.maximumRequestsPerConnection
            this.outputs[slot] = region {
                memoryPromoteString(httpEventResponse(
                    request, response, keepAlive,
                    this.options.gzipMinimumBytes
                ))
            }
            this.outputOffsets[slot] = 0
            this.closing[slot] = !keepAlive
            if (this.outputs[slot].size >
                this.options.maximumPendingBytes) {
                this.closeSlot(slot)
            } else if (this.descriptors[slot] >= 0) {
                // A small response will normally fit in the socket send
                // buffer immediately. Try it here instead of always paying
                // for a second epoll wake-up; writeReady retains the exact
                // same backpressure path when the write is partial.
                this.writeReady(slot)
            }
            processing = false
        }
    }
    return
}

// Accepts ready clients until accept fails, draining starts, or the connection limit is reached.
fun HttpEventServer.acceptReady(): void {
    var accepting = !this.draining && this.activeConnections() <
        this.options.maximumConnections
    while (accepting) {
        val connection = this.listener.accept()
        if (connection.descriptor < 0) accepting = false
        else {
            connection.setNonblocking()
            connection.setNoDelay()
            val descriptor = connection.descriptor
            connection.descriptor = -1
            this.allocateSlot(descriptor)
            this.poller.watchDescriptor(descriptor)
            accepting = this.activeConnections() <
                this.options.maximumConnections
        }
    }
    return
}

// Reads and processes ready bytes for a valid open slot that has no pending output.
fun HttpEventServer.readReady(slot: int): void {
    var reading = slot >= 0 && this.descriptors[slot] >= 0 &&
        this.outputs[slot].size == 0
    while (reading) {
        // The server-wide budget of request bytes (see HttpEventServerOptions.maximumBufferedRequestBytes): with no room this connection is not read; the kernel keeps what the peer
        // sent (the peer's window fills) and budgetEnforce reads it again once there is room.
        // (One count for both: nothing changes the slot between them, and each count walks three of its buffers.)
        val heldBefore = this.slotHeldBytes(slot)
        val budgetRoom = this.budget.room(this.options.maximumBufferedRequestBytes, heldBefore)
        if (budgetRoom <= 0) {
            this.budget.paused[slot] = true
            this.budget.waiting = true
            reading = false
            continue
        }
        if (this.useNoEscapeHandler) {
            var clearInput = false
            // A read held back (see `needs`) and whether the held ones were joined: both are stored after the
            // region, as nothing allocated in it may be kept by the server.
            var heldPiece = ""
            var tailsTaken = false
            // A chunked request met in the region: the rest of the input, promoted, to be assembled after it (see processNoEscapeChunked).
            var handoff = false
            var handoffInput = ""
            reading = region {
                var pending = this.inputs[slot]
                var accumulating = true
                var continueReading = false
                var reads = 0
                var roomLeft = budgetRoom
                // Keep adjacent pieces of an incomplete request in this
                // region. Promote only when yielding back to the event loop,
                // rather than copying every full receive into the GC heap.
                // Bound the region even for a continuously sending client.
                while (accumulating) {
                    var receiveMaximum = this.options.maximumHeaderBytes +
                        this.options.maximumBodyBytes - pending.size + 1
                    if (receiveMaximum > 131072) receiveMaximum = 131072
                    if (receiveMaximum > roomLeft) receiveMaximum = roomLeft
                    val incoming = httpEventRead(this.descriptors[slot], receiveMaximum)
                    reads = reads + 1
                    roomLeft = roomLeft - incoming.size
                    continueReading = false
                    accumulating = false
                    if (incoming.size > 0) {
                        this.lastActivityMilliseconds[slot] =
                            this.passMilliseconds
                        val held = if (tailsTaken) 0 else this.tails[slot].size()
                        if (!tailsTaken && this.needs[slot] > 0 &&
                            pending.size + held + incoming.size < this.needs[slot]) {
                            heldPiece = memoryPromoteString(incoming)
                        } else {
                        if (held > 0) {
                            pending = "$pending${this.tails[slot].toText()}"
                            tailsTaken = true
                        }
                        val input = "$pending$incoming"
                        if (this.chunkStates[slot].head == null && input.size >
                            this.options.maximumHeaderBytes +
                            this.options.maximumBodyBytes &&
                            httpEventRequestLength(input,
                                this.options.maximumHeaderBytes,
                                this.options.maximumBodyBytes) <= 0) {
                            this.closeSlot(slot)
                        } else {
                            var consumed = 0
                            var offset = 0
                            var processing = true
                            while (processing) {
                                consumed = this.processNoEscapeInputInRegion(
                                    slot, input.slice(offset, input.size)
                                )
                                if (consumed == -3) {
                                    handoffInput = memoryPromoteString(input.slice(offset, input.size))
                                    handoff = true
                                }
                                if (consumed > 0) offset = offset + consumed
                                processing = consumed > 0 &&
                                    offset < input.size &&
                                    this.descriptors[slot] >= 0 &&
                                    this.outputs[slot].size == 0
                            }
                            pending = if (!handoff && this.descriptors[slot] >= 0 && offset < input.size) {
                                input.slice(offset, input.size)
                            } else ""
                            accumulating = offset == 0 && consumed == 0 &&
                                reads < 4 && roomLeft > 0 &&
                                this.descriptors[slot] >= 0 &&
                                this.outputs[slot].size == 0
                        }
                        }
                        continueReading = incoming.size == receiveMaximum &&
                            this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
                    }
                }
                if (this.descriptors[slot] >= 0 && pending.size > 0) {
                    this.inputs[slot] = memoryPromoteString(pending)
                } else clearInput = true
                continueReading
            }
            if (clearInput) this.inputs[slot] = ""
            if (tailsTaken && this.descriptors[slot] >= 0) this.tails[slot] = byteBuffer()
            if (heldPiece.size > 0 && this.descriptors[slot] >= 0) this.tails[slot].appendText(heldPiece)
            if (handoff && this.descriptors[slot] >= 0) {
                this.inputs[slot] = handoffInput
                this.processNoEscapeChunked(slot)
                if (this.descriptors[slot] < 0 || this.outputs[slot].size > 0) reading = false
            }
        } else {
            // Read a typical API body and its headers in one receive
            // operation, continuing after a full edge-triggered chunk.
            val plainRead = if (budgetRoom < 32768) budgetRoom else 32768
            val incoming = httpEventRead(this.descriptors[slot], plainRead)
            if (incoming.size > 0) {
                this.lastActivityMilliseconds[slot] =
                    this.passMilliseconds
                val held = this.tails[slot].size()
                if (this.needs[slot] > 0 &&
                    this.inputs[slot].size + held + incoming.size < this.needs[slot]) {
                    // The request cannot be complete yet: keep the piece, parse nothing (a body sent a byte at a time
                    // used to be joined and re-framed whole on every read).
                    this.tails[slot].appendText(memoryPromoteString(incoming))
                    reading = incoming.size == plainRead &&
                        this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
                } else {
                var joined = this.inputs[slot]
                if (held > 0) {
                    joined = "$joined${this.tails[slot].toText()}"
                    this.tails[slot] = byteBuffer()
                }
                this.inputs[slot] = memoryPromoteString(
                    "$joined$incoming"
                )
                if (this.chunkStates[slot].head == null && this.inputs[slot].size >
                    this.options.maximumHeaderBytes +
                    this.options.maximumBodyBytes &&
                    httpEventRequestLength(this.inputs[slot],
                        this.options.maximumHeaderBytes,
                        this.options.maximumBodyBytes) <= 0) {
                    this.closeSlot(slot)
                } else this.processSlot(slot)
                reading = incoming.size == plainRead &&
                    this.descriptors[slot] >= 0 && this.outputs[slot].size == 0
                }
            } else reading = false
        }
        // What this round took in or released (a handler started, the connection closed), so the next round and the other connections see the room.
        this.budget.held = this.budget.held + this.slotHeldBytes(slot) - heldBefore
    }
    return
}

// Writes pending response bytes for a valid open slot and updates its progress or closes it on failure.
fun HttpEventServer.writeReady(slot: int): void {
    if (slot >= 0 && this.descriptors[slot] >= 0 &&
        this.outputOffsets[slot] < this.outputs[slot].size) {
        val remaining = this.outputs[slot].slice(
            this.outputOffsets[slot], this.outputs[slot].size
        )
        val packed = httpEventSend(this.descriptors[slot], remaining)
        val sent = httpEventSendWritten(packed)
        val sendError = httpEventSendError(packed)
        if (sent > 0) {
            this.lastActivityMilliseconds[slot] = this.passMilliseconds
        }
        this.outputOffsets[slot] =
            this.outputOffsets[slot] + sent
        if (sendError != 0 && sendError != 11) this.closeSlot(slot)
        else if (this.outputOffsets[slot] >= this.outputs[slot].size) {
            this.outputs[slot] = ""
            this.outputOffsets[slot] = 0
            if (this.closing[slot]) this.closeSlot(slot)
            else if (this.descriptors[slot] >= 0) {
                if (this.writeWatching[slot]) {
                    this.poller.modifyDescriptor(
                        this.descriptors[slot], true, false
                    )
                    this.writeWatching[slot] = false
                }
                this.processSlot(slot)
            }
        } else if (!this.writeWatching[slot]) {
            if (this.poller.modifyDescriptor(
                this.descriptors[slot], false, true
            )) this.writeWatching[slot] = true
        }
    }
    return
}

// Polls for up to `timeoutMilliseconds`, handles ready connections, and expires idle ones. Returns the number of handled readiness events.
fun HttpEventServer.step(timeoutMilliseconds: int = 1000): int {
    var handled = 0
    var maximumEvents = this.options.maximumConnections + 1
    if (maximumEvents > 1024) maximumEvents = 1024
    val events = this.poller.waitCompact(
        maximumEvents,
        timeoutMilliseconds
    )
    this.passMilliseconds = linuxMonotonicMilliseconds()
    var index = 0
    while (index + 12 <= events.size) {
        val flags = textReadU32LittleEndian(events, index)
        val descriptor = textReadU32LittleEndian(events, index + 4)
        val readable = (flags & 1) != 0
        val writable = (flags & 4) != 0
        // Linux reports an orderly peer half-close as EPOLLRDHUP (8192),
        // while an abrupt hangup uses EPOLLHUP (16). The former hosted C
        // adapter normalized both to bit 16; the all-Abla raw epoll path
        // preserves native flags, so handle both without leaking the slot.
        val closed = (flags & 16) != 0 || (flags & 8192) != 0
        val error = (flags & 8) != 0
        if (!this.draining &&
            descriptor == this.listener.descriptor && readable) {
            this.acceptReady()
            handled = handled + 1
        } else {
            val slot = this.findDescriptor(descriptor)
            if (slot >= 0) {
                if (error || closed) this.closeSlot(slot)
                else {
                    if (readable) this.readReady(slot)
                    if (writable && slot < this.descriptors.size &&
                        this.descriptors[slot] >= 0) this.writeReady(slot)
                }
                handled = handled + 1
            }
        }
        index = index + 12
    }
    if (this.options.idleTimeoutMilliseconds > 0) {
        val now = this.passMilliseconds
        index = 0
        while (index < this.descriptors.size) {
            if (this.descriptors[index] >= 0 &&
                now - this.lastActivityMilliseconds[index] >=
                    this.options.idleTimeoutMilliseconds) {
                this.closeSlot(index)
            }
            index = index + 1
        }
    }
    // The request, request head and response deadlines (see HttpEventServerOptions).
    var slot = 0
    while (slot < this.descriptors.size) {
        if (this.descriptors[slot] >= 0 &&
            this.deadlines.deadlineExpired(
                slot, this.passMilliseconds, this.options,
                this.inputs[slot].size > 0 || this.tails[slot].size() > 0 || this.chunkStates[slot].head != null,
                this.chunkStates[slot].head != null, this.requestCounts[slot], this.outputs[slot].size > 0
            )) this.closeSlot(slot)
        slot = slot + 1
    }
    this.budgetEnforce()
    handled
}

// Begins draining by stopping acceptance of new connections. Call drain to service and close the remaining ones.
fun HttpEventServer.stop(): void {
    this.beginDrain()
    return
}

// Stops accepting new clients and starts the configured deadline for completing existing responses.
fun HttpEventServer.beginDrain(): void {
    if (!this.draining) {
        this.draining = true
        this.drainDeadlineMilliseconds = linuxMonotonicMilliseconds() +
            this.options.drainTimeoutMilliseconds
        if (this.listener.descriptor >= 0) {
            this.poller.unwatchDescriptor(this.listener.descriptor)
            this.listener.close()
        }
        var slot = 0
        while (slot < this.descriptors.size) {
            if (this.descriptors[slot] >= 0) {
                if (this.outputs[slot].size > 0) this.closing[slot] = true
                else {
                    val length = httpEventRequestLength(
                        this.inputs[slot],
                        this.options.maximumHeaderBytes,
                        this.options.maximumBodyBytes
                    )
                    if (length > 0) this.processSlot(slot)
                    else this.closeSlot(slot)
                }
            }
            slot = slot + 1
        }
    }
    return
}

// Closes every client slot and marks the server stopped.
fun HttpEventServer.forceStop(): void {
    var slot = 0
    while (slot < this.descriptors.size) {
        this.closeSlot(slot)
        slot = slot + 1
    }
    this.stopped = true
    return
}

// Services active connections until all close or the drain deadline expires, then closes the server. Returns zero.
fun HttpEventServer.drain(): int {
    this.beginDrain()
    while (this.activeConnections() > 0 &&
        linuxMonotonicMilliseconds() < this.drainDeadlineMilliseconds) {
        this.step(50)
    }
    this.forceStop()
    0
}

/** 0 while the server listens; otherwise the errno of the failed bind or listen (98 is an address already in use, 13 no
 *  permission, 22 an invalid address), or of the failed poller. A server like that never accepts: `run()` returns 1 at once. */
fun HttpEventServer.listenError(): int =
    if (this.listener.descriptor < 0) 0 - this.listener.descriptor
    else if (this.poller.descriptor < 0) 0 - this.poller.descriptor
    else 0

// Runs the readiness loop until stop or graceful shutdown. Returns 1 for a startup listen or poller error and zero after shutdown.
fun HttpEventServer.run(): int {
    if (!this.stopped && this.listenError() != 0) return 1
    this.poller.watchGracefulShutdown()
    while (!this.stopped && !tcpShutdownRequested()) this.step(1000)
    if (!this.stopped) this.drain() else 0
}
