// Single-threaded epoll HTTP/1.1 server with bounded connections, input,
// output backpressure, persistent requests, chunked bodies, and gzip policy.

import "abla/http"
import "abla/http/stream"
import "abla/memory"
import "abla/net"
import "abla/sys/linux/process"
import "abla/text"

class HttpEventServerOptions(
    val maximumConnections: int,
    val maximumHeaderBytes: int,
    val maximumBodyBytes: int,
    val maximumPendingBytes: int,
    val maximumRequestsPerConnection: int,
    val idleTimeoutMilliseconds: int,
    val gzipMinimumBytes: int,
    val drainTimeoutMilliseconds: int
)

class HttpEventFrame(
    val length: int,
    val request: HttpRequest?
)

resource class HttpEventServer(
    val router: HttpRouter,
    val handler: (HttpRequest) -> HttpResponse,
    val noEscapeHandler: FnNoEscape(HttpRequest) -> HttpResponse,
    val useHandler: bool,
    val useNoEscapeHandler: bool,
    val listener: TcpListener,
    val poller: SocketPoller,
    val options: HttpEventServerOptions,
    val descriptors: array<int>,
    val descriptorSlots: array<int>,
    val inputs: array<string>,
    val outputs: array<string>,
    val outputOffsets: array<int>,
    val writeWatching: array<bool>,
    val requestCounts: array<int>,
    val closing: array<bool>,
    val lastActivityMilliseconds: array<int>,
    var draining: bool,
    var drainDeadlineMilliseconds: int,
    var stopped: bool
) {
    fun drop(): void {
        var index = 0
        while (index < this.descriptors.size) {
            if (this.descriptors[index] >= 0) {
                linuxTcpCloseDescriptor(this.descriptors[index])
                this.descriptors[index] = -1
            }
            index = index + 1
        }
        this.poller.close()
        this.listener.close()
        this.stopped = true
        return
    }
}

fun httpEventServerOptions(): HttpEventServerOptions =
    HttpEventServerOptions(
        1023, 65536, 1048576, 2097152, 100, 30000, 256, 5000
    )

noescape fun httpEventUnusedHandler(request: HttpRequest): HttpResponse =
    httpText("event handler is unavailable", 500)

fun httpEventServer(
    router: HttpRouter,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        router, httpEventUnusedHandler, httpEventUnusedHandler, false, false,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false
    )
}

fun httpEventServerHandler(
    handler: (HttpRequest) -> HttpResponse,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        httpRouter(), handler, httpEventUnusedHandler, true, false,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false
    )
}

fun httpEventServerNoEscapeHandler(
    handler: FnNoEscape(HttpRequest) -> HttpResponse,
    address: Ipv4SocketAddress,
    options: HttpEventServerOptions = httpEventServerOptions(),
    reusePort: bool = false
): HttpEventServer {
    val listener = tcpListenAddress(address, 1024, reusePort)
    listener.setNonblocking()
    val poller = socketPoller()
    if (listener.descriptor >= 0 && poller.descriptor >= 0) {
        poller.watchDescriptor(listener.descriptor)
    }
    HttpEventServer(
        httpRouter(), httpEventUnusedHandler, handler, false, true,
        move(listener), move(poller), options,
        [], [], [], [], [], [], [], [], [], false, 0, false
    )
}

fun HttpEventServer.activeConnections(): int {
    var active = 0
    var index = 0
    while (index < this.descriptors.size) {
        if (this.descriptors[index] >= 0) active = active + 1
        index = index + 1
    }
    active
}

fun HttpEventServer.findDescriptor(descriptor: int): int {
    if (descriptor >= 0 && descriptor < this.descriptorSlots.size) {
        this.descriptorSlots[descriptor]
    } else -1
}

fun HttpEventServer.allocateSlot(descriptor: int): int {
    var slot = -1
    var index = 0
    while (slot < 0 && index < this.descriptors.size) {
        if (this.descriptors[index] < 0) slot = index
        index = index + 1
    }
    if (slot < 0) {
        slot = this.descriptors.size
        this.descriptors.append(descriptor)
        this.inputs.append("")
        this.outputs.append("")
        this.outputOffsets.append(0)
        this.writeWatching.append(false)
        this.requestCounts.append(0)
        this.closing.append(false)
        this.lastActivityMilliseconds.append(linuxMonotonicMilliseconds())
    } else {
        this.descriptors[slot] = descriptor
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.requestCounts[slot] = 0
        this.closing[slot] = false
        this.lastActivityMilliseconds[slot] = linuxMonotonicMilliseconds()
    }
    while (this.descriptorSlots.size <= descriptor) {
        this.descriptorSlots.append(-1)
    }
    this.descriptorSlots[descriptor] = slot
    slot
}

fun HttpEventServer.closeSlot(slot: int): void {
    if (slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0) {
        this.poller.unwatchDescriptor(this.descriptors[slot])
        if (this.descriptors[slot] < this.descriptorSlots.size) {
            this.descriptorSlots[this.descriptors[slot]] = -1
        }
        linuxTcpCloseDescriptor(this.descriptors[slot])
        this.descriptors[slot] = -1
        this.inputs[slot] = ""
        this.outputs[slot] = ""
        this.outputOffsets[slot] = 0
        this.writeWatching[slot] = false
        this.closing[slot] = false
        this.lastActivityMilliseconds[slot] = 0
    }
    return
}

fun httpEventRequestLength(
    input: string,
    maximumHeader: int,
    maximumBody: int
): int {
    val headerEnd = httpHeaderEnd(input)
    var result = 0
    if (headerEnd < 0 && input.size > maximumHeader) result = -1
    if (headerEnd >= 0) {
        val request = httpParseRequest(input.slice(0, headerEnd))
        val transfer = request.header("Transfer-Encoding")
        if (httpHeaderTokenContains(transfer, "chunked")) {
            val decoded = httpDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            if (decoded.error != "") result = -1
            else if (decoded.complete) result = headerEnd + decoded.consumed
        } else {
            var length = 0
            val encoded = request.header("Content-Length")
            if (encoded != "") length = httpDecimalLength(
                encoded, maximumBody
            )
            if (length < 0) result = -1
            else if (input.size >= headerEnd + length) {
                result = headerEnd + length
            }
        }
    }
    result
}

fun httpEventRequest(
    framed: string,
    maximumBody: int
): HttpRequest {
    val headerEnd = httpHeaderEnd(framed)
    val request = httpParseRequest(framed)
    var result = request
    if (headerEnd >= 0 && httpHeaderTokenContains(
        request.header("Transfer-Encoding"), "chunked"
    )) {
        val decoded = httpDecodeChunked(
            framed.slice(headerEnd, framed.size), maximumBody
        )
        result = HttpRequest(
            request.method, request.path, request.query, request.headers,
            decoded.body, request.parameterNames, request.parameterValues
        )
    }
    result
}

fun httpEventFrame(
    input: string,
    maximumHeader: int,
    maximumBody: int
): HttpEventFrame {
    val headerEnd = httpHeaderEnd(input)
    var length = 0
    var framedRequest: HttpRequest? = null
    if (headerEnd < 0 && input.size > maximumHeader) length = -1
    if (headerEnd >= 0) {
        // Parse the request head once and retain it for dispatch. The previous
        // event path parsed every complete request once to discover framing,
        // discarded that graph, then parsed the same bytes again.
        val request = httpParseRequest(input)
        val transfer = request.header("Transfer-Encoding")
        if (httpHeaderTokenContains(transfer, "chunked")) {
            val decoded = httpDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            if (decoded.error != "") length = -1
            else if (decoded.complete) {
                length = headerEnd + decoded.consumed
                framedRequest = HttpRequest(
                    request.method, request.path, request.query,
                    request.headers, decoded.body,
                    request.parameterNames, request.parameterValues
                )
            }
        } else {
            var bodyLength = 0
            val encoded = request.header("Content-Length")
            if (encoded != "") {
                bodyLength = httpDecimalLength(encoded, maximumBody)
            }
            if (bodyLength < 0) length = -1
            else if (input.size >= headerEnd + bodyLength) {
                length = headerEnd + bodyLength
                if (bodyLength == 0 && length == input.size) {
                    framedRequest = request
                } else framedRequest = HttpRequest(
                    request.method, request.path, request.query,
                    request.headers,
                    input.slice(headerEnd, length),
                    request.parameterNames, request.parameterValues
                )
            }
        }
    }
    HttpEventFrame(length, framedRequest)
}

fun httpEventResponse(
    request: HttpRequest,
    response: HttpResponse,
    keepAlive: bool,
    gzipMinimumBytes: int
): string {
    var encoded = response
    if (response.body.size >= gzipMinimumBytes) {
        encoded = httpGzipResponse(request, response, gzipMinimumBytes)
    }
    var output = "HTTP/1.1 ${encoded.status} ${httpStatusReason(encoded.status)}\r\n"
    var hasLength = false
    var index = 0
    while (index < encoded.headers.size) {
        val header = encoded.headers[index]
        if (!httpAsciiEqualInsensitive(header.name, "Connection")) {
            output = "$output${header.name}: ${header.value}\r\n"
            if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
                hasLength = true
            }
        }
        index = index + 1
    }
    output = "${output}Connection: ${if (keepAlive) "keep-alive" else "close"}\r\n"
    if (!hasLength && encoded.status != 101) {
        output = "${output}Content-Length: ${encoded.body.size}\r\n"
    }
    output = "$output\r\n"
    if (request.method != "HEAD") output = "$output${encoded.body}"
    output
}

fun HttpEventServer.processNoEscapeSlot(slot: int): void {
    var readyToWrite = false
    var processMore = false
    var clearInput = false
    region {
        val frame = httpEventFrame(
            this.inputs[slot],
            this.options.maximumHeaderBytes,
            this.options.maximumBodyBytes
        )
        val length = frame.length
        if (length < 0) {
            this.outputs[slot] = memoryPromoteString(
                httpText("bad request", 400).render()
            )
            this.closing[slot] = true
            readyToWrite = true
        } else if (length > 0) {
            var framed = this.inputs[slot]
            if (length < this.inputs[slot].size) {
                framed = this.inputs[slot].slice(0, length)
                this.inputs[slot] = memoryPromoteString(
                    this.inputs[slot].slice(length, this.inputs[slot].size)
                )
            } else clearInput = true
            val availableRequest = frame.request
            val request = if (availableRequest != null) availableRequest
                else httpEventRequest(framed, this.options.maximumBodyBytes)
            val eventHandler = this.noEscapeHandler
            val response = eventHandler(request)
            this.requestCounts[slot] = this.requestCounts[slot] + 1
            val keepAlive = httpRequestKeepAlive(request) &&
                !this.draining &&
                this.requestCounts[slot] <
                    this.options.maximumRequestsPerConnection
            val framedResponse = httpEventResponse(
                request, response, keepAlive,
                this.options.gzipMinimumBytes
            )
            this.closing[slot] = !keepAlive
            if (framedResponse.size > this.options.maximumPendingBytes) {
                this.closeSlot(slot)
            } else if (this.descriptors[slot] >= 0) {
                val connection = TcpConnection(this.descriptors[slot])
                // Scatter/gather avoids copying large segmented bodies, while
                // the contiguous writer remains cheaper for small responses.
                val written = if (framedResponse.size >= 4096) {
                    connection.writeCompact(framedResponse)
                } else connection.writeResult(framedResponse)
                connection.descriptor = -1
                if (written.written > 0 &&
                    written.written < framedResponse.size) {
                    this.lastActivityMilliseconds[slot] =
                        linuxMonotonicMilliseconds()
                }
                if (written.failed() && written.errorCode != 11) {
                    this.closeSlot(slot)
                } else if (written.written >= framedResponse.size) {
                    this.outputOffsets[slot] = 0
                    if (this.closing[slot]) this.closeSlot(slot)
                    else processMore = this.descriptors[slot] >= 0
                } else {
                    this.outputs[slot] = memoryPromoteString(framedResponse)
                    this.outputOffsets[slot] = written.written
                    if (!this.writeWatching[slot] &&
                        this.poller.modifyDescriptor(
                            this.descriptors[slot], true, true
                        )) this.writeWatching[slot] = true
                }
            }
        }
        0
    }
    if (clearInput) this.inputs[slot] = ""
    if (readyToWrite) {
        if (this.outputs[slot].size > this.options.maximumPendingBytes) {
            this.closeSlot(slot)
        } else if (this.descriptors[slot] >= 0) this.writeReady(slot)
    }
    if (processMore && this.descriptors[slot] >= 0) this.processSlot(slot)
    return
}

fun HttpEventServer.processSlot(slot: int): void {
    if (this.useNoEscapeHandler) {
        this.processNoEscapeSlot(slot)
        return
    }
    var processing = slot >= 0 && slot < this.descriptors.size &&
        this.descriptors[slot] >= 0 && this.outputs[slot] == ""
    while (processing) {
        val frame = httpEventFrame(
            this.inputs[slot],
            this.options.maximumHeaderBytes,
            this.options.maximumBodyBytes
        )
        val length = frame.length
        if (length < 0) {
            this.outputs[slot] = httpText("bad request", 400).render()
            this.closing[slot] = true
            processing = false
        } else if (length == 0) processing = false
        else {
            var framed = this.inputs[slot]
            if (length < this.inputs[slot].size) {
                framed = this.inputs[slot].slice(0, length)
                this.inputs[slot] = this.inputs[slot].slice(
                    length, this.inputs[slot].size
                )
            } else this.inputs[slot] = ""
            val availableRequest = frame.request
            val request = if (availableRequest != null) availableRequest
                else httpEventRequest(framed, this.options.maximumBodyBytes)
            var response = this.router.dispatch(request)
            if (this.useHandler) {
                val eventHandler = this.handler
                response = eventHandler(request)
            }
            this.requestCounts[slot] = this.requestCounts[slot] + 1
            val keepAlive = httpRequestKeepAlive(request) &&
                !this.draining &&
                this.requestCounts[slot] <
                    this.options.maximumRequestsPerConnection
            this.outputs[slot] = region {
                memoryPromoteString(httpEventResponse(
                    request, response, keepAlive,
                    this.options.gzipMinimumBytes
                ))
            }
            this.outputOffsets[slot] = 0
            this.closing[slot] = !keepAlive
            if (this.outputs[slot].size >
                this.options.maximumPendingBytes) {
                this.closeSlot(slot)
            } else if (this.descriptors[slot] >= 0) {
                // A small response will normally fit in the socket send
                // buffer immediately. Try it here instead of always paying
                // for a second epoll wake-up; writeReady retains the exact
                // same backpressure path when the write is partial.
                this.writeReady(slot)
            }
            processing = false
        }
    }
    return
}

fun HttpEventServer.acceptReady(): void {
    var accepting = !this.draining && this.activeConnections() <
        this.options.maximumConnections
    while (accepting) {
        val connection = this.listener.accept()
        if (connection.descriptor < 0) accepting = false
        else {
            connection.setNonblocking()
            val descriptor = connection.descriptor
            connection.descriptor = -1
            this.allocateSlot(descriptor)
            this.poller.watchDescriptor(descriptor)
            accepting = this.activeConnections() <
                this.options.maximumConnections
        }
    }
    return
}

fun HttpEventServer.readReady(slot: int): void {
    var reading = slot >= 0 && this.descriptors[slot] >= 0
    while (reading) {
        val connection = TcpConnection(this.descriptors[slot])
        // Most HTTP request heads fit in 4 KiB. Allocating the old 64 KiB
        // buffer for every small keep-alive request dominated tracked memory
        // traffic. Continue only after a full chunk so edge-triggered sockets
        // are still drained for large headers and bodies.
        // Read a typical API body and its headers in one receive operation.
        // The compact primitive remains bounded, so this does not introduce a
        // request-sized heap allocation into the hot path.
        val incoming = connection.readCompact(32768)
        connection.descriptor = -1
        if (incoming.size > 0) {
            this.lastActivityMilliseconds[slot] = linuxMonotonicMilliseconds()
            this.inputs[slot] = memoryPromoteString(
                "${this.inputs[slot]}$incoming"
            )
            if (this.inputs[slot].size >
                this.options.maximumHeaderBytes +
                this.options.maximumBodyBytes) {
                this.closeSlot(slot)
            } else this.processSlot(slot)
            reading = incoming.size == 32768 &&
                this.descriptors[slot] >= 0
        } else reading = false
    }
    return
}

fun HttpEventServer.writeReady(slot: int): void {
    if (slot >= 0 && this.descriptors[slot] >= 0 &&
        this.outputOffsets[slot] < this.outputs[slot].size) {
        val connection = TcpConnection(this.descriptors[slot])
        val remaining = this.outputs[slot].slice(
            this.outputOffsets[slot], this.outputs[slot].size
        )
        val written = connection.writeResult(remaining)
        connection.descriptor = -1
        if (written.written > 0) {
            this.lastActivityMilliseconds[slot] = linuxMonotonicMilliseconds()
        }
        this.outputOffsets[slot] =
            this.outputOffsets[slot] + written.written
        if (written.failed() && written.errorCode != 11) this.closeSlot(slot)
        else if (this.outputOffsets[slot] >= this.outputs[slot].size) {
            this.outputs[slot] = ""
            this.outputOffsets[slot] = 0
            if (this.closing[slot]) this.closeSlot(slot)
            else if (this.descriptors[slot] >= 0) {
                if (this.writeWatching[slot]) {
                    this.poller.modifyDescriptor(
                        this.descriptors[slot], true, false
                    )
                    this.writeWatching[slot] = false
                }
                this.processSlot(slot)
            }
        } else if (!this.writeWatching[slot]) {
            if (this.poller.modifyDescriptor(
                this.descriptors[slot], true, true
            )) this.writeWatching[slot] = true
        }
    }
    return
}

fun HttpEventServer.step(timeoutMilliseconds: int = 1000): int {
    var handled = 0
    var maximumEvents = this.options.maximumConnections + 1
    if (maximumEvents > 1024) maximumEvents = 1024
    val events = this.poller.waitCompact(
        maximumEvents,
        timeoutMilliseconds
    )
    var index = 0
    while (index + 12 <= events.size) {
        val flags = textReadU32LittleEndian(events, index)
        val descriptor = textReadU32LittleEndian(events, index + 4)
        val readable = (flags & 1) != 0
        val writable = (flags & 4) != 0
        val closed = (flags & 16) != 0
        val error = (flags & 8) != 0
        if (!this.draining &&
            descriptor == this.listener.descriptor && readable) {
            this.acceptReady()
            handled = handled + 1
        } else {
            val slot = this.findDescriptor(descriptor)
            if (slot >= 0) {
                if (error || closed) this.closeSlot(slot)
                else {
                    if (readable) this.readReady(slot)
                    if (writable && slot < this.descriptors.size &&
                        this.descriptors[slot] >= 0) this.writeReady(slot)
                }
                handled = handled + 1
            }
        }
        index = index + 12
    }
    if (this.options.idleTimeoutMilliseconds > 0) {
        val now = linuxMonotonicMilliseconds()
        index = 0
        while (index < this.descriptors.size) {
            if (this.descriptors[index] >= 0 &&
                now - this.lastActivityMilliseconds[index] >=
                    this.options.idleTimeoutMilliseconds) {
                this.closeSlot(index)
            }
            index = index + 1
        }
    }
    handled
}

fun HttpEventServer.stop(): void {
    this.beginDrain()
    return
}

fun HttpEventServer.beginDrain(): void {
    if (!this.draining) {
        this.draining = true
        this.drainDeadlineMilliseconds = linuxMonotonicMilliseconds() +
            this.options.drainTimeoutMilliseconds
        if (this.listener.descriptor >= 0) {
            this.poller.unwatchDescriptor(this.listener.descriptor)
            this.listener.close()
        }
        var slot = 0
        while (slot < this.descriptors.size) {
            if (this.descriptors[slot] >= 0) {
                if (this.outputs[slot] != "") this.closing[slot] = true
                else {
                    val length = httpEventRequestLength(
                        this.inputs[slot],
                        this.options.maximumHeaderBytes,
                        this.options.maximumBodyBytes
                    )
                    if (length > 0) this.processSlot(slot)
                    else this.closeSlot(slot)
                }
            }
            slot = slot + 1
        }
    }
    return
}

fun HttpEventServer.forceStop(): void {
    var slot = 0
    while (slot < this.descriptors.size) {
        this.closeSlot(slot)
        slot = slot + 1
    }
    this.stopped = true
    return
}

fun HttpEventServer.drain(): int {
    this.beginDrain()
    while (this.activeConnections() > 0 &&
        linuxMonotonicMilliseconds() < this.drainDeadlineMilliseconds) {
        this.step(50)
    }
    this.forceStop()
    0
}

fun HttpEventServer.run(): int {
    tcpEnableGracefulShutdown()
    while (!this.stopped && !tcpShutdownRequested()) this.step(1000)
    if (!this.stopped) this.drain() else 0
}
