// HTTP/2 (RFC 9113) server connection, sans-IO, the counterpart of `H2Client` in abla/http/h2: `H2Server` is one connection's state machine. The caller moves
// bytes (`feed` what the socket gave, `takeOutput` what to write), takes the requests that are whole (`takeRequests`), runs its handler and answers each with
// `respond`. No sockets, no clocks (the caller passes `now` in milliseconds): it runs in process against a scripted peer and under the fuzzer.
//
// What a client can make it do is bounded: a header block (128 KiB raw, 32 CONTINUATION frames, the HPACK decoder's list, field and count limits), the frames in
// flight (16384 bytes), the control frames it makes us answer (100 pending), the run of frames that carry nothing (1000), control frames per second (10000), RST_STREAM
// frames per second (Rapid Reset, CVE-2023-44487: 200), concurrent streams (100: more are refused), the body of a request (`maximumBodyBytes`),
// our output queue (256 KiB: response bodies wait for it). Past a flood limit the connection ends with GOAWAY(ENHANCE_YOUR_CALM); a violation ends it with the RFC's error
// code; a stream error resets only the stream. A request reaches the handler only when whole (END_STREAM), so a stream the client resets earlier costs a header decode.

import "abla/bytes"
import "abla/crypto"
import "abla/text"
import "abla/array"
import "abla/integer"
import "abla/http"
import "abla/net"
import "abla/http/h2"
import "abla/http/h2/hpack"

/// The reset-frame count allowed per rate window before the connection closes.
val H2_MAX_RESETS_PER_SECOND = 200
// Request body bytes buffered for streams whose handler has not run: past it no receive credit is returned until handlers take bodies (RFC 9113 section 5.2: flow control is how a receiver bounds its memory).
val H2_MAX_BUFFERED_BODY_BYTES = 8388608
// Output queued and unread: new streams are refused at twice the output cap and the connection ends at three times it (a client that never reads).
val H2_REFUSE_OUTPUT_BYTES = 524288
/// The queued output threshold that closes the connection when exceeded.
val H2_MAX_OUTPUT_BYTES = 786432

/** A request that is whole: the handler's `HttpRequest` and the stream to answer on. */
class H2ServerRequest(val stream: int, val request: HttpRequest)

// Streaming routes (`streamRoute`): a request of one is reported as events instead of waiting to be whole, and its response is written as it is made. REQUEST: the headers are in
// (`request` has no body); DATA: a piece of the body (credit for it is given by `consumed`); END: the request ended (`trailers`); WRITABLE: `writeResponse` has room again; RESET: the
// stream or the connection ended before the exchange did (`code`, `error`).
val H2_SERVER_EVENT_REQUEST = 1
/// Identifies an event carrying a piece of the request body.
val H2_SERVER_EVENT_DATA = 2
/// Identifies the end of a streaming request, with any trailers.
val H2_SERVER_EVENT_END = 3
/// Identifies a stream whose response can accept more bytes.
val H2_SERVER_EVENT_WRITABLE = 4
/// Identifies a stream or connection reset before the exchange completed.
val H2_SERVER_EVENT_RESET = 5

/// Carries a streaming request, data, end, writability or reset notification for a stream.
class H2ServerEvent(val kind: int, val stream: int, val request: HttpRequest? = null, val data: string = "", val trailers: array<HttpHeader> = [], val code: int = 0, val error: string = "")

/** The response bytes a streamed response holds unsent: `writeResponse` takes in no more (one stream window). */
val H2_SERVER_STREAM_BODY_CAP = 262144

/// Tracks one stream's request, response and flow-control state.
class H2ServerStream(val id: int, var recvWindow: int = 0, var sendWindow: int = 0, var owed: int = 0, var method: string = "", var path: string = "", var query: string = "",
    var authority: string = "", var scheme: string = "", var headers: array<HttpHeader> = [], var chunks: array<string> = [], var received: int = 0, var contentLength: int = -1,
    var requestDone: bool = false, var sawHeaders: bool = false, var responding: bool = false, var responseBody: string = "", var responsePosition: int = 0, var head: bool = false,
    var buffered: int = 0, var abandoned: bool = false,
    // A streaming route's exchange (streamRoute): `bodyLimit` bytes of request body (0: no limit), the response body written with writeResponse until endResponse (`bodyFinished`), `blocked` a writeResponse
    // that took less than it was given, `endSent` the response's END_STREAM is out.
    var streaming: bool = false, var bodyLimit: int = 0, var bodyFinished: bool = true, var blocked: bool = false, var endSent: bool = false,
    var responseTrailers: array<HttpHeader> = [], var requestTrailers: array<HttpHeader> = [])

/// Maintains one HTTP/2 server connection and its streams while the caller handles socket I/O.
class H2Server(
    var streams: array<H2ServerStream> = [],
    var closedIds: array<int> = [],
    var decoder: HpackDecoder,
    var encoder: HpackEncoder,
    var requests: array<H2ServerRequest> = [],
    var output: ByteBuffer,
    var outputBytes: int = 0,
    var input: string = "",
    var peer: SocketPeerAddress? = null,
    var prefaceSeen: bool = false,
    var peerSeen: bool = false,
    var closed: bool = false,
    var draining: bool = false,
    var error: string = "",
    var highestStream: int = 0,
    var connectionSend: int = 65535,
    var connectionReceive: int = 0,
    var connectionOwed: int = 0,
    var peerInitialWindow: int = 65535,
    var peerMaxFrame: int = 16384,
    var maxStreams: int = 100,
    var maximumBodyBytes: int = 1048576,
    var blockStream: int = 0,
    var blockFragments: string = "",
    var blockBytes: int = 0,
    var blockCount: int = 0,
    var blockEndStream: bool = false,
    var blockRefused: bool = false,
    var quiet: int = 0,
    var controlWindowStart: int = 0,
    var controlInWindow: int = 0,
    var resetWindowStart: int = 0,
    var resetsInWindow: int = 0,
    var pendingAcks: int = 0,
    var settingsAckDeadline: int = -2,
    var roundRobin: int = 0,
    var goawaySent: bool = false,
    var now: int = 0,
    var bufferedBytes: int = 0,
    var overflow: bool = false,
    var events: array<H2ServerEvent> = [],
    var streamRoutes: array<string> = [],
    var streamLimits: array<int> = [])

/** A connection with our SETTINGS queued; the peer's preface is expected first. `maximumBodyBytes` caps a request body, `maximumStreams` the concurrent streams. */
fun h2ServerNew(maximumStreams: int = 100, maximumBodyBytes: int = 1048576, maximumHeaderListBytes: int = 65536, peer: SocketPeerAddress? = null): H2Server {
    var server = H2Server(
        decoder = hpackDecoderNew(4096, maximumHeaderListBytes, H2_MAX_FIELD_BYTES, H2_MAX_FIELDS),
        encoder = hpackEncoderNew(4096),
        output = byteBuffer(),
        peer = peer,
        maxStreams = maximumStreams,
        maximumBodyBytes = maximumBodyBytes,
        connectionReceive = H2_CONNECTION_WINDOW)
    server.queue(h2Frame(4, 0, 0, h2Setting(3, maximumStreams) + h2Setting(4, H2_INITIAL_WINDOW) + h2Setting(6, maximumHeaderListBytes)))
    server.queue(h2Frame(8, 0, 0, h2Be32(H2_CONNECTION_WINDOW - 65535)))
    server
}

private fun H2Server.queue(bytes: string): void {
    this.output.appendText(bytes)
    this.outputBytes = this.outputBytes + bytes.size
    // A client that never reads what the server sent (HEAD requests with large headers, resets, acknowledgements): the queue is bounded, the connection ends.
    // (flagged, not failed here: callers of queue still hold stream indexes; the connection ends at the next feed, respond or takeOutput)
    if (this.outputBytes > H2_MAX_OUTPUT_BYTES) this.overflow = true
    return
}

/** The bytes to write to the peer now (response bodies held back by the output cap are moved into the queue for the next call). */
fun H2Server.takeOutput(): string {
    this.endOverflow()
    val bytes = this.output.toText()
    this.output = byteBuffer()
    this.outputBytes = 0
    this.pendingAcks = 0
    this.pump()
    bytes
}

/// Reports whether encoded frames are waiting to be written.
fun H2Server.wantsWrite(): bool = this.outputBytes > 0

/// Drains and returns the queue of complete requests for non-streaming routes.
fun H2Server.takeRequests(): array<H2ServerRequest> {
    this.credit()
    val taken: array<H2ServerRequest> = []
    for (r in this.requests) taken.append(r)
    this.requests = []
    taken
}

// ---- streaming routes ----
/** Makes `method` `path` (no query) a streaming route: its requests are reported as events (takeEvents) as they arrive and answered with respondStream, writeResponse and
 *  endResponse. `maximumBodyBytes` bounds the request body (0: no limit; a bound the handler enforces itself, or memory it chooses to hold, is its own business). */
fun H2Server.streamRoute(method: string, path: string, maximumBodyBytes: int): void {
    this.streamRoutes.append("$method $path")
    this.streamLimits.append(maximumBodyBytes)
    return
}

private fun H2Server.streamRouteIndex(method: string, path: string): int {
    if (this.streamRoutes.size == 0) return -1
    val key = "$method $path"
    for (i in 0 until this.streamRoutes.size) {
        if (this.streamRoutes[i] == key) return i
    }
    -1
}

/** The streaming events since the last call (and the connection window's credit for what arrived). */
fun H2Server.takeEvents(): array<H2ServerEvent> {
    this.credit()
    val taken: array<H2ServerEvent> = []
    for (e in this.events) taken.append(e)
    this.events = []
    taken
}

/** The caller has dealt with `bytes` of the request body of a streaming `stream`: its window is credited for them (once half of it was). Not calling it is the pause: the client stalls
 *  after one stream window. */
fun H2Server.consumed(stream: int, bytes: int): void {
    val at = this.indexOf(stream)
    if (at < 0 || !this.streams[at].streaming || bytes <= 0) return
    this.streams[at].owed = this.streams[at].owed + bytes
    this.credit()
    return
}

/** Starts the response of a streaming `stream`: HEADERS now (content-length when `length` >= 0 and the headers have none; 0 ends the response here, as does a HEAD request), then
 *  writeResponse and endResponse. Returns false for a stream that is not a streaming one, was answered already, or a status outside 200..599. */
fun H2Server.respondStream(stream: int, status: int, headers: array<HttpHeader>, length: int): bool {
    if (this.closed) return false
    val at = this.indexOf(stream)
    if (at < 0 || !this.streams[at].streaming || this.streams[at].responding || status < 200 || status > 599 || this.overflow) return false
    val fields: array<HpackField> = [HpackField(":status", "${status}", false)]
    var hasLength = false
    for (h in headers) {
        val name = h.name.lowercase()
        if (h2Forbidden(name) || name == "host" || name == "te") continue
        if (name == "content-length") hasLength = true
        fields.append(HpackField(name, h.value, false))
    }
    if (!hasLength && length >= 0) fields.append(HpackField("content-length", "$length", false))
    val end = if (length == 0 || this.streams[at].head) 1 else 0
    this.queueHeaderBlock(stream, this.encoder.encode(fields), end)
    this.streams[at].responding = true
    this.streams[at].bodyFinished = end == 1
    if (end == 1) {
        this.streams[at].endSent = true
        this.finishResponse(stream)
    }
    true
}

/** HEADERS (and CONTINUATION frames) for a header block, ending the stream when `end` is 1. */
private fun H2Server.queueHeaderBlock(stream: int, block: string, end: int): void {
    if (block.size <= this.peerMaxFrame) {
        this.queue(h2Frame(1, 4 | end, stream, block))
    } else {
        this.queue(h2Frame(1, end, stream, block.slice(0, this.peerMaxFrame)))
        var from = this.peerMaxFrame
        while (from < block.size) {
            val take = if (block.size - from < this.peerMaxFrame) block.size - from else this.peerMaxFrame
            this.queue(h2Frame(9, if (from + take >= block.size) 4 else 0, stream, block.slice(from, from + take)))
            from = from + take
        }
    }
    return
}

/** Writes response body bytes of a streaming `stream`: returns how many were taken (a prefix of `chunk`), 0 when it holds a window's worth of unsent bytes already (a WRITABLE event follows
 *  when there is room), -1 when the stream is gone, not answered with respondStream, or ended. */
fun H2Server.writeResponse(stream: int, chunk: string): int {
    val at = this.indexOf(stream)
    if (this.closed || at < 0 || !this.streams[at].streaming || !this.streams[at].responding || this.streams[at].bodyFinished) return -1
    if (chunk.size == 0) return 0
    val pending = this.streams[at].responseBody.size - this.streams[at].responsePosition
    val room = H2_SERVER_STREAM_BODY_CAP - pending
    if (room <= 0) {
        this.streams[at].blocked = true
        return 0
    }
    val taken = if (chunk.size < room) chunk.size else room
    if (taken < chunk.size) this.streams[at].blocked = true
    val kept = if (pending > 0) this.streams[at].responseBody.slice(this.streams[at].responsePosition, this.streams[at].responseBody.size) else ""
    this.streams[at].responseBody = kept + (if (taken == chunk.size) chunk else chunk.slice(0, taken))
    this.streams[at].responsePosition = 0
    this.pump()
    taken
}

/** The response of a streaming `stream` is complete: END_STREAM follows what is queued (on a HEADERS frame carrying `trailers` when there are any). */
fun H2Server.endResponse(stream: int, trailers: array<HttpHeader> = []): void {
    val at = this.indexOf(stream)
    if (this.closed || at < 0 || !this.streams[at].streaming || !this.streams[at].responding || this.streams[at].bodyFinished) return
    this.streams[at].bodyFinished = true
    val kept: array<HttpHeader> = []
    for (t in trailers) kept.append(t)
    this.streams[at].responseTrailers = kept
    this.pump()
    return
}

/** Whether a WINDOW_UPDATE for `stream` (0: the connection) belongs to a response still being sent: some stream is answered and not finished. */
private fun H2Server.windowUpdateOpensSomething(stream: int): bool {
    for (s in this.streams) {
        if (!s.responding || s.endSent) continue
        if (stream == 0 || s.id == stream) return true
    }
    false
}

/** The response bytes `writeResponse` would take now for a streaming `stream` (0 before respondStream, when it is full, and for a stream that is gone). */
fun H2Server.responseRoom(stream: int): int {
    val at = this.indexOf(stream)
    if (at < 0 || !this.streams[at].streaming || !this.streams[at].responding || this.streams[at].bodyFinished) return 0
    val room = H2_SERVER_STREAM_BODY_CAP - (this.streams[at].responseBody.size - this.streams[at].responsePosition)
    if (room < 0) 0 else room
}

/** The caller gives up on a streaming `stream`: RST_STREAM(`code`). */
fun H2Server.abortStream(stream: int, code: int): void {
    val at = this.indexOf(stream)
    if (this.closed || at < 0 || !this.streams[at].streaming) return
    this.streams[at].abandoned = true
    this.streamError(stream, code)
    return
}

/** An event for the owner of a streaming exchange: the stream ended before the exchange did. */
private fun H2Server.resetEvent(at: int, code: int, reason: string): void {
    if (this.streams[at].streaming) this.events.append(H2ServerEvent(H2_SERVER_EVENT_RESET, this.streams[at].id, code = code, error = reason))
    return
}


/** A streaming route's request body passed the route's limit: answered 413 when nothing was sent yet, else the stream is reset; the rest of the body is dropped and the handler hears of the abort. */
private fun H2Server.bodyOverLimit(at: int): void {
    val id = this.streams[at].id
    this.streams[at].abandoned = true
    this.events.append(H2ServerEvent(H2_SERVER_EVENT_RESET, id, code = 0, error = "the request body passed the route's limit"))
    if (!this.streams[at].responding) {
        this.respondStream(id, 413, [HttpHeader("content-type", "text/plain")], 22)
        this.writeResponse(id, "request body too large")
        this.endResponse(id)
    } else this.streamError(id, H2_CANCEL)
    return
}
/// Reports whether the connection state machine has closed.
fun H2Server.isClosed(): bool = this.closed
/// Returns the number of currently tracked streams.
fun H2Server.openStreams(): int = this.streams.size
/** Why the connection ended ("" while it is open). */
fun H2Server.reason(): string = this.error

private fun H2Server.indexOf(id: int): int {
    for (i in 0 until this.streams.size) {
        if (this.streams[i].id == id) return i
    }
    -1
}

private fun H2Server.wasClosed(id: int): bool {
    for (r in this.closedIds) {
        if (r == id) return true
    }
    false
}

private fun H2Server.rememberClosed(id: int): void {
    this.closedIds.append(id)
    if (this.closedIds.size > H2_MAX_RESET_REMEMBERED) this.closedIds.removeAt(0)
    return
}

private fun H2Server.fail(code: int, reason: string): void {
    if (this.closed) return
    this.closed = true
    this.error = "${reason} (${h2CodeName(code)})"
    this.queue(h2Frame(7, 0, 0, h2Be32(this.highestStream) + h2Be32(code)))
    for (i in 0 until this.streams.size) this.resetEvent(i, code, reason)
    this.streams = []
    this.bufferedBytes = 0
    return
}

private fun H2Server.streamError(id: int, code: int): void {
    this.queue(h2Frame(3, 0, id, h2Be32(code)))
    val streamAt = this.indexOf(id)
    if (streamAt >= 0 && !this.streams[streamAt].abandoned) this.resetEvent(streamAt, code, "a stream error (${h2CodeName(code)})")
    // The server's own resets count as much as the client's (MadeYouReset).
    this.countReset()
    this.rememberClosed(id)
    val at = this.indexOf(id)
    if (at >= 0) this.dropAt(at)
    return
}

/** Begins a graceful end: GOAWAY with the highest stream accepted so far; requests already taken are still answered, none new is accepted. */
fun H2Server.shutdown(): void {
    if (this.closed || this.goawaySent) return
    this.goawaySent = true
    this.draining = true
    this.queue(h2Frame(7, 0, 0, h2Be32(this.highestStream) + h2Be32(0)))
    return
}

/** The connection is over (nothing more to answer): true once a graceful shutdown has no stream left. */
fun H2Server.finished(): bool = this.closed || (this.draining && this.streams.size == 0)

/** Timeouts: our SETTINGS unacknowledged for 10 s. */
fun H2Server.tick(now: int): void {
    if (this.closed) return
    if (this.settingsAckDeadline == -2) this.settingsAckDeadline = now + 10000
    if (this.settingsAckDeadline >= 0 && now >= this.settingsAckDeadline) this.fail(H2_SETTINGS_TIMEOUT, "the client did not acknowledge our settings")
    return
}

// ---- responses ----
/** Answers `stream`: the status, the headers (names are lower-cased; connection-specific ones are dropped) and the body. A HEAD request gets no body. A status outside
 *  200..599 or a stream that is not waiting is ignored (returns false). */
fun H2Server.respond(stream: int, status: int, headers: array<HttpHeader>, body: string): bool {
    if (this.closed) return false
    val at = this.indexOf(stream)
    if (at < 0 || this.streams[at].responding || status < 200 || status > 599 || this.overflow) return false
    // Answered before the request ended (413, an early answer): the rest of the request is dropped and never reaches a handler.
    if (!this.streams[at].requestDone) {
        this.streams[at].abandoned = true
        this.bufferedBytes = this.bufferedBytes - this.streams[at].buffered
        this.streams[at].buffered = 0
        this.streams[at].chunks = []
    }
    val fields: array<HpackField> = [HpackField(":status", "${status}", false)]
    var hasLength = false
    for (h in headers) {
        val name = h.name.lowercase()
        if (h2Forbidden(name) || name == "host" || (name == "te")) continue
        if (name == "content-length") hasLength = true
        fields.append(HpackField(name, h.value, false))
    }
    if (!hasLength) fields.append(HpackField("content-length", "${body.size}", false))
    val block = this.encoder.encode(fields)
    val head = this.streams[at].head
    val end = if (body.size == 0 || head) 1 else 0
    if (block.size <= this.peerMaxFrame) {
        this.queue(h2Frame(1, 4 | end, stream, block))
    } else {
        this.queue(h2Frame(1, end, stream, block.slice(0, this.peerMaxFrame)))
        var from = this.peerMaxFrame
        while (from < block.size) {
            val take = if (block.size - from < this.peerMaxFrame) block.size - from else this.peerMaxFrame
            this.queue(h2Frame(9, if (from + take >= block.size) 4 else 0, stream, block.slice(from, from + take)))
            from = from + take
        }
    }
    this.streams[at].responding = true
    if (end == 1) {
        this.finishResponse(stream)
    } else {
        this.streams[at].responseBody = body
        this.streams[at].responsePosition = 0
        this.pump()
    }
    true
}

private fun H2Server.finishResponse(id: int): void {
    val at = this.indexOf(id)
    if (at < 0) return
    if (!this.streams[at].requestDone) {
        // Answered before the request ended: stop the upload (RFC 9113 section 8.1).
        this.queue(h2Frame(3, 0, id, h2Be32(H2_NO_ERROR)))
    }
    this.rememberClosed(id)
    this.dropAt(at)
    return
}

private fun H2Server.pump(): void {
    var progress = true
    while (progress && !this.closed) {
        progress = false
        var i = 0
        while (i < this.streams.size) {
            if (this.outputBytes >= H2_OUTPUT_CAP) return
            val remaining = this.streams[i].responseBody.size - this.streams[i].responsePosition
            if (!this.streams[i].responding) {
                i = i + 1
                continue
            }
            if (remaining <= 0) {
                // A streamed response that was ended after its last byte went out: an empty DATA frame (or a HEADERS frame with the trailers) ends the stream.
                if (this.streams[i].bodyFinished && !this.streams[i].endSent) {
                    val id = this.streams[i].id
                    this.streams[i].endSent = true
                    if (this.streams[i].responseTrailers.size > 0) {
                        val fields: array<HpackField> = []
                        for (t in this.streams[i].responseTrailers) fields.append(HpackField(t.name.lowercase(), t.value, false))
                        this.queueHeaderBlock(id, this.encoder.encode(fields), 1)
                    } else this.queue(h2Frame(0, 1, id, ""))
                    progress = true
                    this.finishResponse(id)
                } else i = i + 1
                continue
            }
            var take = remaining
            if (take > this.peerMaxFrame) take = this.peerMaxFrame
            if (take > 65536) take = 65536
            if (take > this.streams[i].sendWindow) take = this.streams[i].sendWindow
            if (take > this.connectionSend) take = this.connectionSend
            if (take <= 0) {
                i = i + 1
                continue
            }
            val id = this.streams[i].id
            val from = this.streams[i].responsePosition
            // The last bytes of a body that is complete end the stream, unless trailers still have to follow them.
            val last = this.streams[i].bodyFinished && from + take >= this.streams[i].responseBody.size && this.streams[i].responseTrailers.size == 0
            this.queue(h2Frame(0, if (last) 1 else 0, id, this.streams[i].responseBody.slice(from, from + take)))
            this.streams[i].responsePosition = from + take
            this.streams[i].sendWindow = this.streams[i].sendWindow - take
            this.connectionSend = this.connectionSend - take
            progress = true
            if (last) {
                this.streams[i].endSent = true
                this.finishResponse(id)
            } else {
                // A writeResponse that was refused hears of the room once half of the cap is free.
                if (this.streams[i].blocked && this.streams[i].responseBody.size - this.streams[i].responsePosition <= H2_SERVER_STREAM_BODY_CAP / 2) {
                    this.streams[i].blocked = false
                    this.events.append(H2ServerEvent(H2_SERVER_EVENT_WRITABLE, id))
                }
                i = i + 1
            }
        }
    }
    return
}

// ---- input ----
/** Bytes from the peer: the connection preface first, then frames. Complete frames are processed; a partial one waits for the next call. */
fun H2Server.feed(data: string, now: int): void {
    if (this.closed) return
    this.now = now
    var buffer = this.input + data
    this.input = ""
    var at = 0
    if (!this.prefaceSeen) {
        if (buffer.size < 24) {
            // A prefix of the preface waits; anything else is not HTTP/2.
            if (buffer != H2_PREFACE.slice(0, buffer.size)) {
                this.fail(H2_PROTOCOL_ERROR, "the connection preface is wrong")
                return
            }
            this.input = buffer
            return
        }
        if (buffer.slice(0, 24) != H2_PREFACE) {
            this.fail(H2_PROTOCOL_ERROR, "the connection preface is wrong")
            return
        }
        this.prefaceSeen = true
        at = 24
    }
    while (!this.closed) {
        if (buffer.size - at < 9) break
        val length = (buffer[at] << 16) | (buffer[at + 1] << 8) | buffer[at + 2]
        if (length > H2_MAX_FRAME_PAYLOAD) {
            this.fail(H2_FRAME_SIZE_ERROR, "a frame over the maximum size")
            return
        }
        if (buffer.size - at < 9 + length) break
        val kind = buffer[at + 3]
        val flags = buffer[at + 4]
        val stream = h2Read32(buffer, at + 5) & 2147483647
        this.frame(kind, flags, stream, buffer.slice(at + 9, at + 9 + length), now)
        at = at + 9 + length
    }
    if (!this.closed) {
        this.input = buffer.slice(at, buffer.size)
        this.credit()
    }
    this.endOverflow()
    this.pump()
    return
}

private fun H2Server.control(now: int): bool {
    this.quiet = this.quiet + 1
    if (now - this.controlWindowStart >= 1000) {
        this.controlWindowStart = now
        this.controlInWindow = 0
    }
    this.controlInWindow = this.controlInWindow + 1
    if (this.quiet > H2_MAX_QUIET_FRAMES || this.controlInWindow > H2_MAX_CONTROL_PER_SECOND) {
        this.fail(H2_ENHANCE_YOUR_CALM, "too many frames with no payload")
        return false
    }
    true
}

private fun H2Server.frame(kind: int, flags: int, stream: int, payload: string, now: int): void {
    if (!this.peerSeen) {
        if (kind != 4 || (flags & 1) != 0) {
            this.fail(H2_PROTOCOL_ERROR, "the first frame is not SETTINGS")
            return
        }
        this.peerSeen = true
    }
    if (this.blockStream != 0 && (kind != 9 || stream != this.blockStream)) {
        this.fail(H2_PROTOCOL_ERROR, "a frame inside a header block")
        return
    }
    if (kind == 0) { this.onData(flags, stream, payload, now); return }
    if (kind == 1) { this.onHeaders(flags, stream, payload); return }
    if (kind == 9) { this.onContinuation(flags, stream, payload); return }
    if (kind == 5) { this.fail(H2_PROTOCOL_ERROR, "PUSH_PROMISE from a client"); return }
    // A window update on a response that is being sent is not a frame that carries nothing: a client that downloads a large response sends nothing else, one update per half window it took,
    // and the quiet-frame and per-second limits would end the download after about 1000 of them (87 MB). What it lets go out is bounded by what it grants.
    if (kind == 8 && this.windowUpdateOpensSomething(stream)) { this.onWindowUpdate(stream, payload); return }
    if (!this.control(now)) return
    if (kind == 2) {
        if (payload.size != 5) { this.streamOrConnection(stream, H2_FRAME_SIZE_ERROR, "a PRIORITY frame of the wrong length"); return }
        if (stream == 0) { this.fail(H2_PROTOCOL_ERROR, "PRIORITY on stream 0"); return }
        // A stream may not depend on itself (RFC 9113 section 5.3.1).
        if ((h2Read32(payload, 0) & 2147483647) == stream) {
            if (stream > this.highestStream) this.fail(H2_PROTOCOL_ERROR, "a PRIORITY that depends on itself, on an idle stream") else this.streamError(stream, H2_PROTOCOL_ERROR)
        }
        return
    }
    if (kind == 3) { this.onReset(stream, payload, now); return }
    if (kind == 4) { this.onSettings(flags, stream, payload); return }
    if (kind == 6) { this.onPing(flags, stream, payload); return }
    if (kind == 7) {
        if (stream != 0) { this.fail(H2_PROTOCOL_ERROR, "GOAWAY on a stream"); return }
        if (payload.size < 8) this.fail(H2_FRAME_SIZE_ERROR, "a GOAWAY frame that is too short")
        return
    }
    if (kind == 8) { this.onWindowUpdate(stream, payload); return }
    return
}

private fun H2Server.streamOrConnection(stream: int, code: int, reason: string): void {
    // A frame of the wrong size is a stream error on a stream, a connection error on stream 0 (RFC 9113 section 4.2) except for frames that change the connection's state.
    if (stream == 0) this.fail(code, reason) else this.streamError(stream, code)
    return
}

private fun H2Server.onSettings(flags: int, stream: int, payload: string): void {
    if (stream != 0) { this.fail(H2_PROTOCOL_ERROR, "SETTINGS on a stream"); return }
    if ((flags & 1) != 0) {
        if (payload.size != 0) { this.fail(H2_FRAME_SIZE_ERROR, "a SETTINGS acknowledgement with a payload"); return }
        this.settingsAckDeadline = -1
        return
    }
    if (payload.size % 6 != 0) { this.fail(H2_FRAME_SIZE_ERROR, "a SETTINGS frame of the wrong length"); return }
    var at = 0
    while (at < payload.size) {
        val id = (payload[at] << 8) | payload[at + 1]
        val value = h2Read32(payload, at + 2) & 4294967295
        at = at + 6
        if (id == 1) {
            this.encoder.setPeerTableSize(value)
        } else if (id == 2) {
            if (value > 1) { this.fail(H2_PROTOCOL_ERROR, "ENABLE_PUSH is not 0 or 1"); return }
        } else if (id == 4) {
            if (value > H2_MAX_WINDOW) { this.fail(H2_FLOW_CONTROL_ERROR, "INITIAL_WINDOW_SIZE above 2^31-1"); return }
            val delta = value - this.peerInitialWindow
            this.peerInitialWindow = value
            for (i in 0 until this.streams.size) {
                this.streams[i].sendWindow = this.streams[i].sendWindow + delta
                if (this.streams[i].sendWindow > H2_MAX_WINDOW) { this.fail(H2_FLOW_CONTROL_ERROR, "a stream window above 2^31-1 after SETTINGS"); return }
            }
        } else if (id == 5) {
            if (value < 16384 || value > 16777215) { this.fail(H2_PROTOCOL_ERROR, "MAX_FRAME_SIZE out of range"); return }
            this.peerMaxFrame = value
        }
    }
    this.pendingAcks = this.pendingAcks + 1
    if (this.pendingAcks > H2_MAX_PENDING_ACKS) { this.fail(H2_ENHANCE_YOUR_CALM, "too many acknowledgements owed"); return }
    this.queue(h2Frame(4, 1, 0, ""))
    return
}

private fun H2Server.onPing(flags: int, stream: int, payload: string): void {
    if (stream != 0) { this.fail(H2_PROTOCOL_ERROR, "PING on a stream"); return }
    if (payload.size != 8) { this.fail(H2_FRAME_SIZE_ERROR, "a PING frame of the wrong length"); return }
    if ((flags & 1) != 0) return
    this.pendingAcks = this.pendingAcks + 1
    if (this.pendingAcks > H2_MAX_PENDING_ACKS) { this.fail(H2_ENHANCE_YOUR_CALM, "too many acknowledgements owed"); return }
    this.queue(h2Frame(6, 1, 0, payload))
    return
}

private fun H2Server.onReset(stream: int, payload: string, now: int): void {
    if (stream == 0) { this.fail(H2_PROTOCOL_ERROR, "RST_STREAM on stream 0"); return }
    if (payload.size != 4) { this.fail(H2_FRAME_SIZE_ERROR, "an RST_STREAM frame of the wrong length"); return }
    // Rapid Reset (CVE-2023-44487): resets cost the sender nothing, so they are budgeted per second; the budget covers every RST_STREAM, whatever stream it names.
    if (!this.countReset()) return
    val at = this.indexOf(stream)
    if (at < 0) {
        if (stream > this.highestStream || stream % 2 == 0) this.fail(H2_PROTOCOL_ERROR, "RST_STREAM on an idle stream")
        return
    }
    if (!this.streams[at].abandoned) this.resetEvent(at, h2Read32(payload, 0), "reset by the client")
    this.rememberClosed(stream)
    this.dropAt(at)
    return
}

private fun H2Server.onWindowUpdate(stream: int, payload: string): void {
    if (payload.size != 4) { this.fail(H2_FRAME_SIZE_ERROR, "a WINDOW_UPDATE frame of the wrong length"); return }
    val increment = h2Read32(payload, 0) & 2147483647
    if (stream == 0) {
        if (increment == 0) { this.fail(H2_PROTOCOL_ERROR, "a zero WINDOW_UPDATE"); return }
        this.connectionSend = this.connectionSend + increment
        if (this.connectionSend > H2_MAX_WINDOW) this.fail(H2_FLOW_CONTROL_ERROR, "the connection window passed 2^31-1")
        return
    }
    val at = this.indexOf(stream)
    if (at < 0) {
        if (stream > this.highestStream || stream % 2 == 0) this.fail(H2_PROTOCOL_ERROR, "WINDOW_UPDATE on an idle stream")
        return
    }
    if (increment == 0) { this.streamError(stream, H2_PROTOCOL_ERROR); return }
    this.streams[at].sendWindow = this.streams[at].sendWindow + increment
    if (this.streams[at].sendWindow > H2_MAX_WINDOW) this.streamError(stream, H2_FLOW_CONTROL_ERROR)
    return
}

// ---- header blocks ----
private fun H2Server.onHeaders(flags: int, stream: int, payload: string): void {
    if (stream == 0 || stream % 2 == 0) { this.fail(H2_PROTOCOL_ERROR, "HEADERS on an invalid stream"); return }
    var begin = 0
    var end = payload.size
    if ((flags & 8) != 0) {
        if (payload.size < 1) { this.fail(H2_FRAME_SIZE_ERROR, "a padded frame with no pad length"); return }
        end = payload.size - payload[0]
        begin = 1
    }
    if ((flags & 32) != 0) {
        begin = begin + 5
        if (end >= begin && (h2Read32(payload, begin - 5) & 2147483647) == stream) { this.fail(H2_PROTOCOL_ERROR, "a stream that depends on itself"); return }
    }
    if (end < begin) { this.fail(H2_PROTOCOL_ERROR, "padding or priority past the end of HEADERS"); return }
    this.quiet = 0
    val at = this.indexOf(stream)
    this.blockRefused = false
    if (at < 0) {
        // A new request: ids rise (a lower id is a closed or idle stream, which may not start one).
        // A lower id: a stream we closed (STREAM_CLOSED), else one the client never opened and may not open now (PROTOCOL_ERROR, RFC 9113 section 5.1.1).
        if (stream <= this.highestStream) {
            if (this.wasClosed(stream)) this.fail(H2_STREAM_CLOSED, "HEADERS on a closed stream") else this.fail(H2_PROTOCOL_ERROR, "a stream id lower than one already used")
            return
        }
        if (this.draining) {
            this.blockRefused = true
        } else if (this.streams.size >= this.maxStreams || this.outputBytes >= H2_REFUSE_OUTPUT_BYTES) {
            this.blockRefused = true
        }
        this.highestStream = stream
        if (!this.blockRefused) this.streams.append(H2ServerStream(stream, recvWindow = H2_INITIAL_WINDOW, sendWindow = this.peerInitialWindow))
    } else if (this.streams[at].requestDone) {
        this.fail(H2_STREAM_CLOSED, "HEADERS after the end of the request")
        return
    } else if (!this.streams[at].sawHeaders) {
        // (cannot happen: a stream is created with its headers) kept for clarity
        this.streams[at].sawHeaders = true
    }
    this.blockStream = stream
    this.blockFragments = payload.slice(begin, end)
    this.blockBytes = end - begin
    this.blockCount = 0
    this.blockEndStream = (flags & 1) != 0
    if ((flags & 4) != 0) this.finishBlock()
    return
}

private fun H2Server.onContinuation(flags: int, stream: int, payload: string): void {
    if (this.blockStream == 0 || stream != this.blockStream) { this.fail(H2_PROTOCOL_ERROR, "CONTINUATION with no header block open"); return }
    this.blockCount = this.blockCount + 1
    this.blockBytes = this.blockBytes + payload.size
    if (this.blockCount > H2_MAX_CONTINUATIONS || this.blockBytes > H2_MAX_BLOCK_BYTES) { this.fail(H2_ENHANCE_YOUR_CALM, "a header block over the limit"); return }
    this.blockFragments = this.blockFragments + payload
    if ((flags & 4) != 0) this.finishBlock()
    return
}

private fun h2ParseMethodOk(name: string): bool {
    if (name.size == 0) return false
    for (i in 0 until name.size) {
        val c = name[i]
        if (c <= 32 || c >= 127 || c == 40 || c == 41 || c == 44 || c == 47 || c == 58 || c == 59 || c == 60 || c == 61 || c == 62 || c == 63 || c == 64 || c == 91 || c == 92 || c == 93 || c == 123 || c == 125 || c == 34) return false
    }
    true
}

private fun H2Server.finishBlock(): void {
    val stream = this.blockStream
    val endStream = this.blockEndStream
    val block = this.blockFragments
    val refused = this.blockRefused
    this.blockStream = 0
    this.blockFragments = ""
    this.blockBytes = 0
    this.blockCount = 0
    // Always decoded, even for a stream we refuse: the HPACK table must stay in step.
    val decoded = this.decoder.decode(block)
    if (!decoded.ok) {
        this.fail(if (decoded.limit) H2_ENHANCE_YOUR_CALM else H2_COMPRESSION_ERROR, decoded.error)
        return
    }
    if (refused) {
        this.queue(h2Frame(3, 0, stream, h2Be32(H2_REFUSED_STREAM)))
        // A refused stream is a reset the server sends for a request it decoded: part of the reset budget.
        this.countReset()
        this.rememberClosed(stream)
        return
    }
    val at = this.indexOf(stream)
    if (at < 0) return
    if (this.streams[at].sawHeaders) {
        // Trailers: a header block after the request's own, which must end the stream, with no pseudo-headers; decoded and dropped (a streaming route's handler gets them with END).
        if (!endStream) { this.streamError(stream, H2_PROTOCOL_ERROR); return }
        for (f in decoded.fields) {
            if (f.name.size > 0 && f.name[0] == 58) { this.streamError(stream, H2_PROTOCOL_ERROR); return }
        }
        if (this.streams[at].streaming) {
            val kept: array<HttpHeader> = []
            for (t in decoded.fields) kept.append(HttpHeader(t.name, t.value))
            this.streams[at].requestTrailers = kept
        }
        this.requestEnded(stream)
        return
    }
    var method = ""
    var scheme = ""
    var path = ""
    var authority = ""
    var seenRegular = false
    var contentLength = -1
    var host = ""
    var headers: array<HttpHeader> = []
    for (f in decoded.fields) {
        // RFC 9113 section 8.2.1: names are tokens (lower case), values have no NUL, CR or LF and no outer whitespace: a request that has any is malformed.
        if (!h2ValidFieldName(f.name) || !h2ValidFieldValue(f.value)) {
            this.streamError(stream, H2_PROTOCOL_ERROR)
            return
        }
        if (f.name.size > 0 && f.name[0] == 58) {
            if (seenRegular) { this.streamError(stream, H2_PROTOCOL_ERROR); return }
            if (f.name == ":method") { if (method != "") { this.streamError(stream, H2_PROTOCOL_ERROR); return }; method = f.value }
            else if (f.name == ":scheme") { if (scheme != "") { this.streamError(stream, H2_PROTOCOL_ERROR); return }; scheme = f.value }
            else if (f.name == ":path") { if (path != "") { this.streamError(stream, H2_PROTOCOL_ERROR); return }; path = f.value }
            else if (f.name == ":authority") { if (authority != "") { this.streamError(stream, H2_PROTOCOL_ERROR); return }; authority = f.value }
            else { this.streamError(stream, H2_PROTOCOL_ERROR); return }
            continue
        }
        seenRegular = true
        if (h2HasUpper(f.name) || f.name.size == 0) { this.streamError(stream, H2_PROTOCOL_ERROR); return }
        if (h2Forbidden(f.name) && f.name != "host") { this.streamError(stream, H2_PROTOCOL_ERROR); return }
        if (f.name == "te" && f.value != "trailers") { this.streamError(stream, H2_PROTOCOL_ERROR); return }
        if (f.name == "host") host = f.value
        if (f.name == "content-length") {
            val parsed = f.value.parseInt()
            if (parsed == null || parsed < 0 || (contentLength >= 0 && contentLength != parsed)) { this.streamError(stream, H2_PROTOCOL_ERROR); return }
            contentLength = parsed
        }
        headers.append(HttpHeader(f.name, f.value))
    }
    if (method == "" || scheme == "" || path == "" || !h2ParseMethodOk(method) || method == "CONNECT") { this.streamError(stream, H2_PROTOCOL_ERROR); return }
    // RFC 9113 section 8.3.1: an http(s) request's :path is an absolute path (or "*" for OPTIONS).
    if (path[0] != 47 && !(method == "OPTIONS" && path == "*")) { this.streamError(stream, H2_PROTOCOL_ERROR); return }
    if (authority == "" && host != "") authority = host
    if (authority != "" && host == "") headers.append(HttpHeader("host", authority))
    // RFC 9113 8.3.1: with both, :authority is the one that counts. A handler reading `host` must not see another origin than the one the
    // request was routed by, so every host field is set to :authority (a mismatch is not an error: the RFC only says Host SHOULD equal it).
    if (authority != "" && host != "" && host != authority) {
        val fixed: array<HttpHeader> = []
        var placed = false
        for (h in headers) {
            if (h.name == "host") {
                if (!placed) fixed.append(HttpHeader("host", authority))
                placed = true
            } else fixed.append(h)
        }
        headers = fixed
    }
    var target = path
    var query = ""
    val q = path.indexOf("?")
    if (q >= 0) {
        target = path.slice(0, q)
        query = path.slice(q + 1, path.size)
    }
    this.streams[at].sawHeaders = true
    this.streams[at].method = method
    this.streams[at].scheme = scheme
    this.streams[at].path = target
    this.streams[at].query = query
    this.streams[at].authority = authority
    this.streams[at].headers = headers
    this.streams[at].contentLength = contentLength
    this.streams[at].head = method == "HEAD"
    // A streaming route: the handler hears of the request now, its body follows as events.
    val route = this.streamRouteIndex(method, target)
    if (route >= 0) {
        this.streams[at].streaming = true
        this.streams[at].bodyLimit = this.streamLimits[route]
        this.events.append(H2ServerEvent(H2_SERVER_EVENT_REQUEST, stream, request = HttpRequest(method, target, query, headers, "", [], [], this.peer)))
    }
    if (endStream) this.requestEnded(stream)
    return
}

/** The request is whole: it goes to the caller. */
private fun H2Server.requestEnded(id: int): void {
    val at = this.indexOf(id)
    if (at < 0 || this.streams[at].abandoned) return
    if (this.streams[at].contentLength >= 0 && this.streams[at].contentLength != this.streams[at].received) {
        this.streamError(id, H2_PROTOCOL_ERROR)
        return
    }
    this.streams[at].requestDone = true
    if (this.streams[at].streaming) {
        this.events.append(H2ServerEvent(H2_SERVER_EVENT_END, id, trailers = this.streams[at].requestTrailers))
        return
    }
    var body = ""
    if (this.streams[at].chunks.size == 1) body = this.streams[at].chunks[0]
    else if (this.streams[at].chunks.size > 1) {
        var buffer = byteBuffer()
        for (c in this.streams[at].chunks) buffer.appendText(c)
        body = buffer.toText()
    }
    val method = this.streams[at].method
    val path = this.streams[at].path
    val query = this.streams[at].query
    val headers: array<HttpHeader> = []
    for (h in this.streams[at].headers) headers.append(h)
    this.streams[at].chunks = []
    this.bufferedBytes = this.bufferedBytes - this.streams[at].buffered
    this.streams[at].buffered = 0
    val peer = this.peer
    this.requests.append(H2ServerRequest(id, HttpRequest(method, path, query, headers, body, [], [], peer)))
    return
}

private fun H2Server.onData(flags: int, stream: int, payload: string, now: int): void {
    if (stream == 0) { this.fail(H2_PROTOCOL_ERROR, "DATA on stream 0"); return }
    this.connectionReceive = this.connectionReceive - payload.size
    if (this.connectionReceive < 0) { this.fail(H2_FLOW_CONTROL_ERROR, "the client sent more than the connection window"); return }
    var begin = 0
    var end = payload.size
    if ((flags & 8) != 0) {
        if (payload.size < 1) { this.fail(H2_FRAME_SIZE_ERROR, "a padded DATA frame with no pad length"); return }
        end = payload.size - payload[0]
        begin = 1
        if (end < begin) { this.fail(H2_PROTOCOL_ERROR, "padding longer than the DATA frame"); return }
    }
    this.connectionOwed = this.connectionOwed + payload.size
    if (payload.size == 0 && (flags & 1) == 0) {
        if (!this.control(now)) return
    } else {
        this.quiet = 0
    }
    val at = this.indexOf(stream)
    if (at < 0) {
        if (stream > this.highestStream || stream % 2 == 0) { this.fail(H2_PROTOCOL_ERROR, "DATA on an idle stream"); return }
        // A stream that is closed: its data is dropped (the connection window was counted above) and the stream is reset with STREAM_CLOSED, which a client that raced our end of it ignores. Counted as a control frame: a flood of them ends the connection.
        if (!this.control(now)) return
        this.queue(h2Frame(3, 0, stream, h2Be32(H2_STREAM_CLOSED)))
        return
    }
    if (!this.streams[at].sawHeaders) { this.fail(H2_PROTOCOL_ERROR, "DATA before HEADERS"); return }
    if (this.streams[at].requestDone) { this.fail(H2_STREAM_CLOSED, "DATA after the end of the request"); return }
    // A stream already answered before its request ended (a 413): the rest of its body is dropped, not buffered and not handed to a handler.
    if (this.streams[at].abandoned) return
    this.streams[at].recvWindow = this.streams[at].recvWindow - payload.size
    if (this.streams[at].recvWindow < 0) { this.streamError(stream, H2_FLOW_CONTROL_ERROR); return }
    this.streams[at].received = this.streams[at].received + (end - begin)
    if (this.streams[at].streaming) {
        // A streaming route: the body is passed on as it comes (its window is credited as the caller takes it: `consumed`); padding is credited at once.
        if (this.streams[at].bodyLimit > 0 && this.streams[at].received > this.streams[at].bodyLimit) {
            this.bodyOverLimit(at)
            return
        }
        if (end > begin) this.events.append(H2ServerEvent(H2_SERVER_EVENT_DATA, stream, data = payload.slice(begin, end)))
        this.streams[at].owed = this.streams[at].owed + (payload.size - (end - begin))
        if ((flags & 1) != 0) this.requestEnded(stream)
        return
    }
    if (this.streams[at].received > this.maximumBodyBytes) {
        // Too large: answered, then the upload is stopped.
        this.streams[at].requestDone = false
        this.respond(stream, 413, [HttpHeader("content-type", "text/plain")], "request body too large")
        return
    }
    if (end > begin) {
        this.streams[at].chunks.append(payload.slice(begin, end))
        this.streams[at].buffered = this.streams[at].buffered + (end - begin)
        this.bufferedBytes = this.bufferedBytes + (end - begin)
    }
    this.streams[at].owed = this.streams[at].owed + payload.size
    if ((flags & 1) != 0) this.requestEnded(stream)
    return
}

/** Receive credit, once per read, after every frame of it was counted (see H2Client.credit). */
private fun H2Server.credit(): void {
    // Request bodies no handler has taken are bounded per connection: past the budget the receive windows are not replenished, so the client cannot send more until handlers take bodies.
    if (this.bufferedBytes >= H2_MAX_BUFFERED_BODY_BYTES) return
    if (this.connectionOwed >= H2_CONNECTION_WINDOW / 4) {
        this.queue(h2Frame(8, 0, 0, h2Be32(this.connectionOwed)))
        this.connectionReceive = this.connectionReceive + this.connectionOwed
        this.connectionOwed = 0
    }
    for (i in 0 until this.streams.size) {
        if (this.streams[i].owed >= H2_INITIAL_WINDOW / 2 && !this.streams[i].requestDone) {
            this.queue(h2Frame(8, 0, this.streams[i].id, h2Be32(this.streams[i].owed)))
            this.streams[i].recvWindow = this.streams[i].recvWindow + this.streams[i].owed
            this.streams[i].owed = 0
        }
    }
    return
}

/** Removes the stream at `at`, with the request body bytes it held. */
private fun H2Server.dropAt(at: int): void {
    this.bufferedBytes = this.bufferedBytes - this.streams[at].buffered
    this.streams.takeAt(at)
    return
}

/** A stream reset, by the client or by the server (a stream error): counted against one budget per second. A reset costs its sender nothing and frees a stream slot, so it is
 *  what Rapid Reset (CVE-2023-44487) and MadeYouReset (CVE-2025-8671, which makes the server send them) are made of. */
private fun H2Server.countReset(): bool {
    if (this.now - this.resetWindowStart >= 1000) {
        this.resetWindowStart = this.now
        this.resetsInWindow = 0
    }
    this.resetsInWindow = this.resetsInWindow + 1
    if (this.resetsInWindow > H2_MAX_RESETS_PER_SECOND) {
        this.fail(H2_ENHANCE_YOUR_CALM, "too many stream resets")
        return false
    }
    true
}

/// Checks for a lowercase HTTP/2 header token with an optional leading pseudo-header colon.
fun h2ValidFieldName(name: string): bool {
    if (name.size == 0) return false
    var i = 0
    if (name[0] == 58) {
        if (name.size == 1) return false
        i = 1
    }
    while (i < name.size) {
        val c = name[i]
        val token = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
        if (!token) return false
        i = i + 1
    }
    true
}

/** RFC 9113 section 8.2.1: a value has no NUL, CR or LF, and does not start or end with a space or tab. */
fun h2ValidFieldValue(value: string): bool {
    if (value.size == 0) return true
    if (value[0] == 32 || value[0] == 9 || value[value.size - 1] == 32 || value[value.size - 1] == 9) return false
    for (i in 0 until value.size) {
        val c = value[i]
        if (c == 0 || c == 10 || c == 13) return false
    }
    true
}

/** The unread output passed its bound: the connection ends with GOAWAY(ENHANCE_YOUR_CALM) and the queue is dropped (what the client did not read for this long is not worth sending). */
private fun H2Server.endOverflow(): void {
    if (this.closed || !this.overflow) return
    this.output = byteBuffer()
    this.outputBytes = 0
    this.fail(H2_ENHANCE_YOUR_CALM, "the client does not read what the server sent")
    return
}
