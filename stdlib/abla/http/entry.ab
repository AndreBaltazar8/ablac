// A small HTTP/1.1 stack and version-aware router written in Abla. Importing
// this module does not pull in JSON, files, TLS, the compiler, or hot reload.

import "abla/net"
import "abla/sys/linux/process"
import "abla/text"
import "abla/bytes"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

class HttpHeader(val name: string, val value: string)

class HttpRequest(
    val method: string,
    val path: string,
    val query: string,
    val headers: array<HttpHeader>,
    val body: string,
    val parameterNames: array<string>,
    val parameterValues: array<string>,
    // Accepted socket peer; never taken from forwarding headers.
    val peerAddress: SocketPeerAddress? = null
)

/** Attach transport metadata to an already parsed request. */
fun httpRequestWithAddress(request: HttpRequest,
    peer: SocketPeerAddress?): HttpRequest = HttpRequest(
        request.method, request.path, request.query, request.headers, request.body,
        request.parameterNames, request.parameterValues, peer
    )

fun httpRequestWithPeer(request: HttpRequest, descriptor: int): HttpRequest =
    httpRequestWithAddress(request, socketPeerAddress(descriptor))

class HttpResponse(
    val status: int,
    val headers: array<HttpHeader>,
    val body: string
)

// HTTP remains independent of TLS policy. A transport receives already-framed
// request bytes and returns bounded response bytes; TLS modules can implement
// the same callback without changing request, response, or client code.
class HttpTransportResult(
    val bytes: string,
    val succeeded: bool,
    // A custom transport returns a complete exchange unless it says otherwise.
    val eof: bool = true
)

class HttpClientResult(
    val response: HttpResponse,
    val succeeded: bool,
    val complete: bool
)

class HttpCoreChunkDecode(
    val body: string,
    val consumed: int,
    val complete: bool,
    val valid: bool
)

class HttpClient(
    val authority: string,
    val exchange: (string, int, int) -> HttpTransportResult,
    val maximumResponseBytes: int,
    val timeoutMilliseconds: int
)

class HttpPathMatch(
    val matched: bool,
    val names: array<string>,
    val values: array<string>
)

class HttpRoute(
    val method: string,
    val pattern: string,
    val version: string,
    val handler: (HttpRequest) -> HttpResponse
)

class HttpRouter(
    val versionHeader: string,
    val routes: array<HttpRoute>,
    val literalRouteBuckets: array<array<int>> = [],
    val parameterizedRouteIndexes: array<int> = [],
    val routeFingerprints: array<int> = [],
    val indexedRouteMarkers: array<int> = []
)

class HttpVersionedRouter(
    val router: HttpRouter,
    val version: string
)

fun httpRouter(versionHeader: string = "Abla-Version"): HttpRouter {
    val literalRouteBuckets: array<array<int>> = []
    var bucket = 0
    while (bucket < 64) {
        literalRouteBuckets.append([])
        bucket = bucket + 1
    }
    HttpRouter(versionHeader, [], literalRouteBuckets, [], [], [])
}

fun httpAsciiEqualInsensitive(left: string, right: string): bool {
    textAsciiEqualInsensitive(left, right)
}

fun HttpRequest.header(name: string): string {
    var result = ""
    var found = false
    var index = this.headers.size
    // The last byte, folded the way `| 32` folds letters, rejects most candidates
    // of the same length before the full comparison (names that differ only in
    // case have the same folded byte, so it never rejects a match).
    val size = name.size
    val tail = if (size > 0) (name[size - 1] | 32) else 0
    // Search backward and stop at the first match. This preserves the existing
    // last-duplicate-wins behavior without scanning the rest of the headers.
    while (!found && index > 0) {
        index = index - 1
        val candidate = this.headers[index]
        val candidateName = candidate.name
        // Reject mismatched lengths before entering the case-folding helper.
        if (candidateName.size == size && (size == 0 || (candidateName[size - 1] | 32) == tail) &&
            httpAsciiEqualInsensitive(candidateName, name)) {
            result = candidate.value
            found = true
        }
    }
    result
}

fun HttpRequest.parameter(name: string): string {
    var result = ""
    var found = false
    var index = this.parameterNames.size
    // Search from the end so duplicate route names retain their existing
    // last-value-wins behavior without traversing earlier entries after a hit.
    while (!found && index > 0) {
        index = index - 1
        val candidateName = this.parameterNames[index]
        val possible = candidateName.size == name.size &&
            (name.size == 0 || candidateName[0] == name[0])
        if (possible && candidateName == name) {
            result = this.parameterValues[index]
            found = true
        }
    }
    if (!found) result = httpQueryParameter(this.query, name)
    result
}

// Route-only lookup for applications that do not want query fallback.
fun HttpRequest.routeParameter(name: string): string {
    var result = ""
    var found = false
    var index = this.parameterNames.size
    while (!found && index > 0) {
        index = index - 1
        val candidateName = this.parameterNames[index]
        val possible = candidateName.size == name.size &&
            (name.size == 0 || candidateName[0] == name[0])
        if (possible && candidateName == name) {
            result = this.parameterValues[index]
            found = true
        }
    }
    result
}

// Query-only lookup for applications that do not need the combined
// route-precedence convenience of parameter().
fun HttpRequest.queryParameter(name: string): string =
    httpQueryParameter(this.query, name)

private trusted fun httpQueryParameter(query: string, name: string): string {
    if (ablaAtCompileTime()) return httpQueryParameterChecked(query, name)
    val size = query.size
    val nameSize = name.size
    if (nameSize >= size) return ""
    // Keep both strings alive until the bounded scan finishes. No call in
    // the scan allocates; only the returned value is sliced afterward.
    val data = ablaUnsafeStringAddress(query)
    val key = ablaUnsafeStringAddress(name)
    var fieldBegin = 0
    while (fieldBegin < size) {
        val nameEnd = fieldBegin + nameSize
        if (nameEnd < size &&
            ablaUnsafeLoadU8(nativePointerFromAddress(data + nameEnd)) == 61 &&
            (nameSize == 0 ||
                ablaUnsafeLoadU8(nativePointerFromAddress(data + nameEnd - 1)) ==
                    ablaUnsafeLoadU8(nativePointerFromAddress(key + nameSize - 1)))) {
            var equal = true
            var offset = 0
            while (equal && offset < nameSize) {
                equal = ablaUnsafeLoadU8(nativePointerFromAddress(data + fieldBegin + offset)) ==
                    ablaUnsafeLoadU8(nativePointerFromAddress(key + offset))
                offset = offset + 1
            }
            if (equal) {
                val valueBegin = nameEnd + 1
                var fieldEnd = valueBegin
                while (fieldEnd < size &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(data + fieldEnd)) != 38) {
                    fieldEnd = fieldEnd + 1
                }
                if (fieldEnd > valueBegin) return query.slice(valueBegin, fieldEnd)
            }
        }
        while (fieldBegin < size &&
            ablaUnsafeLoadU8(nativePointerFromAddress(data + fieldBegin)) != 38) {
            fieldBegin = fieldBegin + 1
        }
        fieldBegin = fieldBegin + 1
    }
    ""
}

private fun httpQueryParameterChecked(query: string, name: string): string {
    var fieldBegin = 0
    while (fieldBegin < query.size) {
        // Only field starts can match. Check the delimiter and final byte
        // before comparing the shared prefixes common in numbered keys.
        val nameEnd = fieldBegin + name.size
        if (nameEnd < query.size && query[nameEnd] == 61 &&
            (name.size == 0 || query[nameEnd - 1] == name[name.size - 1]) &&
            httpCoreRangeEqual(query, fieldBegin, nameEnd, name, 0, name.size)) {
            var fieldEnd = textFindByte(query, 38, nameEnd + 1, query.size)
            if (fieldEnd < 0) fieldEnd = query.size
            val result = query.slice(nameEnd + 1, fieldEnd)
            if (result != "") return result
        }
        val next = textFindByte(query, 38, fieldBegin, query.size)
        if (next < 0) return ""
        fieldBegin = next + 1
    }
    ""
}

private fun httpCoreRangeEqual(
    left: string,
    leftBegin: int,
    leftEnd: int,
    right: string,
    rightBegin: int,
    rightEnd: int
): bool {
    val leftLength = leftEnd - leftBegin
    val rightLength = rightEnd - rightBegin
    var equal = leftLength == rightLength
    var index = 0
    while (equal && index < leftLength) {
        equal = left[leftBegin + index] == right[rightBegin + index]
        index = index + 1
    }
    equal
}

fun httpRequest(
    method: string,
    path: string,
    body: string = "",
    headers: array<HttpHeader> = []
): HttpRequest = HttpRequest(method, path, "", headers, body, [], [])

fun httpGet(path: string, headers: array<HttpHeader> = []): HttpRequest =
    httpRequest("GET", path, "", headers)

fun httpPost(
    path: string,
    body: string,
    headers: array<HttpHeader> = []
): HttpRequest = httpRequest("POST", path, body, headers)

fun httpText(body: string, status: int = 200): HttpResponse = HttpResponse(
    status,
    [HttpHeader("Content-Type", "text/plain; charset=utf-8")],
    body
)

// Low-level helper for a body which is already valid encoded JSON. Import
// abla/http/json and use httpJsonValue when starting from a Json tree.
fun httpJson(body: string, status: int = 200): HttpResponse = HttpResponse(
    status,
    [HttpHeader("Content-Type", "application/json")],
    body
)

fun httpStatusReason(status: int): string {
    var reason = "Unknown Status"
    if (status == 101) reason = "Switching Protocols"
    if (status == 200) reason = "OK"
    if (status == 201) reason = "Created"
    if (status == 204) reason = "No Content"
    if (status == 302) reason = "Found"
    if (status == 303) reason = "See Other"
    if (status == 400) reason = "Bad Request"
    if (status == 401) reason = "Unauthorized"
    if (status == 403) reason = "Forbidden"
    if (status == 404) reason = "Not Found"
    if (status == 405) reason = "Method Not Allowed"
    if (status == 409) reason = "Conflict"
    if (status == 413) reason = "Payload Too Large"
    if (status == 415) reason = "Unsupported Media Type"
    if (status == 422) reason = "Unprocessable Content"
    if (status == 426) reason = "Upgrade Required"
    if (status == 429) reason = "Too Many Requests"
    if (status == 500) reason = "Internal Server Error"
    if (status == 501) reason = "Not Implemented"
    if (status == 502) reason = "Bad Gateway"
    if (status == 503) reason = "Service Unavailable"
    if (status == 504) reason = "Gateway Timeout"
    reason
}

fun HttpResponse.renderHeaders(): string {
    var output = "HTTP/1.1 ${this.status} ${httpStatusReason(this.status)}\r\n"
    var hasLength = false
    var hasConnection = false
    var index = 0
    while (index < this.headers.size) {
        val header = this.headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            hasLength = true
        }
        if (httpAsciiEqualInsensitive(header.name, "Connection")) {
            hasConnection = true
        }
        output = "$output${header.name}: ${header.value}\r\n"
        index = index + 1
    }
    if (!hasLength && this.status != 101) {
        output = "${output}Content-Length: ${this.body.size}\r\n"
    }
    if (!hasConnection && this.status != 101) {
        output = "${output}Connection: close\r\n"
    }
    output
}

fun HttpResponse.render(): string = "${this.renderHeaders()}\r\n${this.body}"

fun HttpResponse.renderHead(): string = "${this.renderHeaders()}\r\n"

fun HttpRequest.renderForClient(authority: string): string {
    var target = this.path
    if (this.query != "") target = "$target?${this.query}"
    var output = "${this.method} $target HTTP/1.1\r\n"
    var hasHost = false
    var hasLength = false
    var hasConnection = false
    var index = 0
    while (index < this.headers.size) {
        val header = this.headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Host")) hasHost = true
        if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            hasLength = true
        }
        if (httpAsciiEqualInsensitive(header.name, "Connection")) {
            hasConnection = true
        }
        output = "$output${header.name}: ${header.value}\r\n"
        index = index + 1
    }
    if (!hasHost) output = "${output}Host: $authority\r\n"
    if (!hasLength) {
        output = "${output}Content-Length: ${this.body.size}\r\n"
    }
    if (!hasConnection) output = "${output}Connection: close\r\n"
    "$output\r\n${this.body}"
}

fun httpLineEnd(input: string, begin: int): int {
    val found = textFindSequence(input, "\r\n", begin, input.size)
    if (found >= 0) found else input.size
}

private fun httpFindByte(input: string, byte: int, begin: int, end: int): int {
    textFindByte(input, byte, begin, end)
}

fun httpHeaderEnd(input: string): int {
    val found = textFindSequence(input, "\r\n\r\n", 0, input.size)
    if (found >= 0) found + 4 else -1
}

// The status at a response start, or 0 until its status line is complete.
fun httpResponseStatusAt(input: string, begin: int): int {
    val end = httpLineEnd(input, begin)
    if (end >= input.size) return 0
    val first = httpFindByte(input, 32, begin, end)
    val second = httpFindByte(input, 32, first + 1, end)
    if (first <= begin || second <= first + 1) return 0
    httpDecimalLength(input.slice(first + 1, second), 999)
}

// Informational responses precede the final response; 101 is the terminal
// upgrade response. Keep an incomplete interim header for the next read.
fun httpFinalResponseOffset(input: string): int {
    var offset = 0
    var scanning = true
    while (scanning && offset < input.size) {
        val status = httpResponseStatusAt(input, offset)
        if (status < 100 || status >= 200 || status == 101) scanning = false
        else {
            val end = textFindSequence(input, "\r\n\r\n", offset, input.size)
            if (end < 0) scanning = false else offset = end + 4
        }
    }
    offset
}

// Whether a Transfer-Encoding value is exactly the one coding "chunked" (spaces and tabs around it allowed).
// Anything else (identity, gzip, "chunked, gzip", an unknown coding) is a body this server cannot frame.
private fun httpTransferIsChunkedOnly(value: string): bool {
    var left = 0
    var right = value.size
    while (left < right && (value[left] == 32 || value[left] == 9)) left = left + 1
    while (right > left && (value[right - 1] == 32 || value[right - 1] == 9)) right = right - 1
    right - left == 7 && httpAsciiEqualInsensitive(value.slice(left, right), "chunked")
}

/** How a request's body is framed: -1 when its framing is malformed and the request is to be refused (400, then
 *  close, nothing of the buffer read again), -2 when it is chunked, else the Content-Length (0 when there is none).
 *  Strict on purpose: a request read with a different length than its sender (or a proxy in front) meant makes the
 *  bytes after it a different request. Refused: an empty or non-digit Content-Length or one over `maximumBody`; two
 *  Content-Lengths that differ; Content-Length together with Transfer-Encoding; a Transfer-Encoding other than exactly
 *  "chunked" (identity, gzip, "chunked, gzip", unknown) or given twice, and any in an HTTP/1.0 request; the look-alike
 *  names Content_Length and Transfer_Encoding (some backends map the underscore to a hyphen); and, whatever the header is
 *  named, whitespace before its colon or a folded line (RFC 9112 5.1, 6.1, 6.3). A refused request is a 400 on purpose,
 *  not a 501 for a coding this server does not know: it closes the connection either way. */
fun httpRequestFraming(request: HttpRequest, http10: bool, maximumBody: int): int {
    var length = 0
    var lengths = 0
    var first = ""
    var transfers = 0
    for (header in request.headers) {
        val name = header.name
        val size = name.size
        if (size == 0) return -1
        val leading = name[0]
        val trailing = name[size - 1]
        if (leading == 32 || leading == 9 || trailing == 32 || trailing == 9) return -1
        if (size == 14) {
            if (httpAsciiEqualInsensitive(name, "Content-Length")) {
                lengths = lengths + 1
                if (lengths == 1) {
                    first = header.value
                    length = httpDecimalLength(first, maximumBody)
                    if (length < 0) return -1
                } else if (header.value != first) return -1
            }
            else if (httpAsciiEqualInsensitive(name, "Content_Length")) return -1
        } else if (size == 17) {
            if (httpAsciiEqualInsensitive(name, "Transfer-Encoding")) {
                transfers = transfers + 1
                if (transfers > 1 || !httpTransferIsChunkedOnly(header.value)) return -1
            } else if (httpAsciiEqualInsensitive(name, "Transfer_Encoding")) return -1
        }
    }
    if (transfers > 0 && (lengths > 0 || http10)) return -1
    if (transfers > 0) -2 else length
}

fun httpDecimalLength(value: string, maximum: int): int {
    var result = 0
    var valid = value.size > 0
    var index = 0
    while (index < value.size && valid) {
        val byte = value[index]
        val digitValid = byte >= 48 && byte <= 57
        if (!digitValid) valid = false
        if (digitValid) {
            result = result * 10 + byte - 48
            if (result > maximum) valid = false
        }
        index = index + 1
    }
    if (valid) result else -1
}

private fun httpCoreHexLength(value: string, maximum: int): int {
    var result = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        var digit = -1
        if (byte >= 48 && byte <= 57) digit = byte - 48
        if (byte >= 65 && byte <= 70) digit = byte - 55
        if (byte >= 97 && byte <= 102) digit = byte - 87
        if (digit < 0 || result > (maximum - digit) / 16) valid = false
        else result = result * 16 + digit
        index = index + 1
    }
    if (valid && result <= maximum) result else -1
}

fun httpCoreHeaderTokenContains(value: string, wanted: string): bool {
    var matched = false
    var begin = 0
    var index = 0
    while (!matched && index <= value.size) {
        if (index == value.size || value[index] == 44) {
            var left = begin
            var right = index
            while (left < right && (value[left] == 32 || value[left] == 9)) {
                left = left + 1
            }
            while (right > left &&
                (value[right - 1] == 32 || value[right - 1] == 9)) {
                right = right - 1
            }
            var semicolon = left
            while (semicolon < right && value[semicolon] != 59) {
                semicolon = semicolon + 1
            }
            matched = httpAsciiEqualInsensitive(
                value.slice(left, semicolon), wanted
            )
            begin = index + 1
        }
        index = index + 1
    }
    matched
}

fun httpCoreDecodeChunked(
    input: string,
    maximumBody: int = 1048576
): HttpCoreChunkDecode {
    var output = ""
    var offset = 0
    var complete = false
    var valid = true
    while (!complete && valid && offset < input.size) {
        val lineEnd = httpLineEnd(input, offset)
        if (lineEnd >= input.size) offset = input.size
        else {
            var extension = offset
            while (extension < lineEnd && input[extension] != 59) {
                extension = extension + 1
            }
            val length = httpCoreHexLength(
                input.slice(offset, extension), maximumBody - output.size
            )
            if (length < 0) valid = false
            else if (length == 0) {
                var trailerEnd = -1
                var cursor = lineEnd + 2
                while (trailerEnd < 0 && cursor + 1 < input.size) {
                    if (input[cursor] == 13 && input[cursor + 1] == 10) {
                        trailerEnd = cursor + 2
                    } else {
                        val next = httpLineEnd(input, cursor)
                        if (next >= input.size) cursor = input.size
                        else cursor = next + 2
                    }
                }
                if (trailerEnd >= 0) {
                    offset = trailerEnd
                    complete = true
                } else offset = input.size
            } else {
                val body = lineEnd + 2
                if (body + length + 2 > input.size) offset = input.size
                else if (input[body + length] != 13 ||
                    input[body + length + 1] != 10) valid = false
                else {
                    output = "$output${input.slice(body, body + length)}"
                    offset = body + length + 2
                }
            }
        }
    }
    HttpCoreChunkDecode(output, offset, complete, valid)
}

fun httpReadRequest(
    connection: TcpConnection,
    maximumHeader: int = 65536,
    maximumBody: int = 1048576
): string {
    var input = connection.read(maximumHeader)
    var headerEnd = httpHeaderEnd(input)
    var readingHeaders = headerEnd < 0 && input.size < maximumHeader
    while (readingHeaders) {
        val remaining = maximumHeader - input.size
        val chunk = connection.read(remaining)
        if (chunk.size > 0) input = "$input$chunk"
        headerEnd = httpHeaderEnd(input)
        readingHeaders = headerEnd < 0 && chunk.size > 0 &&
            input.size < maximumHeader
    }

    if (headerEnd >= 0) {
        val preliminary = httpParseRequest(input)
        val framing = httpRequestFraming(preliminary, false, maximumBody)
        val contentLength = framing
        if (framing == -1) {
            // Malformed framing: nothing of what was read is returned, so the request is refused.
            input = ""
        } else if (framing == -2) {
            var decoded = httpCoreDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            var readingBody = decoded.valid && !decoded.complete &&
                input.size < maximumHeader + maximumBody
            while (readingBody) {
                val remaining = maximumHeader + maximumBody - input.size
                val chunk = connection.read(remaining)
                if (chunk.size > 0) input = "$input$chunk"
                decoded = httpCoreDecodeChunked(
                    input.slice(headerEnd, input.size), maximumBody
                )
                readingBody = chunk.size > 0 && decoded.valid &&
                    !decoded.complete && input.size < maximumHeader + maximumBody
            }
            if (decoded.complete && decoded.valid) {
                input = "${input.slice(0, headerEnd)}${decoded.body}"
            }
        } else {
            val expected = headerEnd + contentLength
            var readingBody = input.size < expected
            while (readingBody) {
                val chunk = connection.read(expected - input.size)
                if (chunk.size > 0) input = "$input$chunk"
                readingBody = chunk.size > 0 && input.size < expected
            }
        }
    }
    input
}

fun httpParseRequest(input: string): HttpRequest = httpParseRequestFrom(input, null)

/** `httpParseRequest` with the accepted socket peer set on the request being built, so no copy
 *  of it is made to attach the peer. */
fun httpParseRequestFrom(input: string, peer: SocketPeerAddress?): HttpRequest =
    if (ablaAtCompileTime()) httpParseRequestChecked(input, peer)
    else httpParseRequestNative(input, peer)

private trusted fun httpParseRequestNative(input: string, peer: SocketPeerAddress?): HttpRequest {
    val sourceSize = input.size
    // No call or allocation occurs between this acquisition and the first
    // substring below. Each byte belongs to one request-line phase.
    val sourceData = if (sourceSize > 0) ablaUnsafeStringAddress(input) else 0
    var requestLineEnd = sourceSize
    var firstSpace = -1
    var secondSpace = -1
    var questionAt = -1
    // A control byte (a bare LF, a CR without its LF, any byte under 32) in the request line: a peer may read a
    // different request line (see httpMalformedLineHeader).
    var lineMalformed = false
    var scan = 0
    // Each hot loop has a valid one-byte lookahead; handle a final lone
    // byte separately so partial inputs keep their original semantics.
    val last = sourceSize - 1
    while (scan < last) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
        if (byte < 33) {
            if (byte == 32) {
                firstSpace = scan
                scan = scan + 1
                break
            }
            if (byte == 13 &&
                ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                requestLineEnd = scan
                break
            }
            lineMalformed = true
        }
        scan = scan + 1
    }
    if (firstSpace < 0 && requestLineEnd == sourceSize && scan < sourceSize) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
        if (byte == 32) firstSpace = scan
        else if (byte < 32) lineMalformed = true
        scan = scan + 1
    }
    if (firstSpace >= 0) {
        while (scan < last) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
            if (byte < 33) {
                if (byte == 32) {
                    secondSpace = scan
                    scan = scan + 1
                    break
                }
                if (byte == 13 &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                    requestLineEnd = scan
                    break
                }
                lineMalformed = true
            } else if (byte == 63) {
                questionAt = scan
                scan = scan + 1
                break
            }
            scan = scan + 1
        }
    }
    if (questionAt >= 0 && secondSpace < 0 && requestLineEnd == sourceSize) {
        // Once '?' is found, query bytes need only the space/CRLF tests.
        while (scan < last) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
            if (byte < 33) {
                if (byte == 32) {
                    secondSpace = scan
                    scan = scan + 1
                    break
                }
                if (byte == 13 &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                    requestLineEnd = scan
                    break
                }
                lineMalformed = true
            }
            scan = scan + 1
        }
    }
    if (firstSpace >= 0 && secondSpace < 0 &&
        requestLineEnd == sourceSize && scan < sourceSize) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
        if (byte == 32) secondSpace = scan
        else if (byte == 63 && questionAt < 0) questionAt = scan
        else if (byte < 32) lineMalformed = true
        scan = scan + 1
    }
    if (secondSpace >= 0) {
        // Version contents remain ignored, exactly as in the checked parser; a control byte in them is flagged.
        while (scan < last) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
            if (byte < 32) {
                if (byte == 13 &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                    requestLineEnd = scan
                    break
                }
                lineMalformed = true
            }
            scan = scan + 1
        }
        if (requestLineEnd == sourceSize && scan < sourceSize &&
            ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan)) < 32) lineMalformed = true
    }
    var method = ""
    var target = "/"
    var question = -1
    if (firstSpace > 0 && secondSpace > firstSpace) {
        method = input.slice(0, firstSpace)
        target = input.slice(firstSpace + 1, secondSpace)
        if (questionAt >= 0) question = questionAt - firstSpace - 1
    }
    var path = target
    var query = ""
    if (question >= 0) {
        path = target.slice(0, question)
        query = target.slice(question + 1, target.size)
    }

    val headers: array<HttpHeader> = []
    if (lineMalformed) headers.append(httpMalformedLineHeader())
    var cursor = requestLineEnd + 2
    var bodyBegin = input.size
    var more = cursor < input.size
    while (more) {
        // Acquire backing storage again after the previous header's allocations.
        // The raw scan ends before any call or header allocation.
        // The table first: its first use may flatten it, an allocation that must not fall after `data` is taken.
        val classes = ablaUnsafeStringAddress(httpNameClasses)
        val data = ablaUnsafeStringAddress(input)
        val size = input.size
        var end = size
        var colon = -1
        // A line end that is not CR LF (a bare LF, or a CR without its LF) inside a line is read as a line end by some
        // peers, and a byte that is not a token character in a name (a space, a control byte, a delimiter, a byte over
        // 127) is skipped or mapped by some: the line is then malformed (see httpMalformedLineHeader).
        var malformed = false
        var scan = cursor
        while (scan < size) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + scan))
            // The class table says at once: 0 a token byte, 1 the colon, 2 a CR, 3 any other byte (not valid in a name).
            val kind = ablaUnsafeLoadU8(nativePointerFromAddress(classes + byte))
            if (kind != 0) {
                if (kind == 1) {
                    colon = scan
                    break
                }
                if (kind == 2 && scan + 1 < size &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(data + scan + 1)) == 10) {
                    end = scan
                    break
                }
                malformed = true
            }
            scan = scan + 1
        }
        var valueBegin = colon + 1
        if (colon >= 0) {
            while (valueBegin < size &&
                ablaUnsafeLoadU8(nativePointerFromAddress(data + valueBegin)) == 32) {
                valueBegin = valueBegin + 1
            }
            // Header values are short: the line end is found by a bounded byte loop here, and
            // by the shared search only past it (the first CRLF at or after the value either way).
            val probeLimit = if (valueBegin + 48 < size) valueBegin + 48 else size
            var probe = valueBegin
            var lineEnd = -1
            while (lineEnd < 0 && probe + 1 < probeLimit) {
                val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + probe))
                if (byte == 13) {
                    val next = ablaUnsafeLoadU8(nativePointerFromAddress(data + probe + 1))
                    if (next == 10) lineEnd = probe
                    else malformed = true
                } else if (byte == 10) malformed = true
                probe = probe + 1
            }
            end = if (lineEnd >= 0) lineEnd else httpLineEnd(input, probe)
            // Past the window the bytes up to the line end are searched once, only by a long value.
            if (lineEnd < 0 && end > probe) {
                if (textFindByte(input, 10, probe, end) >= 0) malformed = true
                else if (textFindByte(input, 13, probe, end) >= 0) malformed = true
            }
        }
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
            cursor = cursor
        } else {
            if (colon > cursor) {
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            if (colon <= cursor || malformed) headers.append(httpMalformedLineHeader())
            cursor = end + 2
            if (cursor >= input.size) more = false
            cursor = cursor
        }
    }
    var body = ""
    if (bodyBegin < input.size) body = input.slice(bodyBegin, input.size)
    HttpRequest(method, path, query, headers, body, [], [], peer)
}

// The byte classes of a request head line's name scan: 0 a token byte, 1 the colon, 2 a CR, 3 any other byte.
private fun httpNameClassTable(): string {
    var table = ""
    var byte = 0
    while (byte < 256) {
        val kind = if (byte == 58) 1 else if (byte == 13) 2 else if (httpTokenByte(byte)) 0 else 3
        table = "$table${utf8Encode(kind)}"
        byte = byte + 1
    }
    table
}

private val httpNameClasses = httpNameClassTable()

/** Whether `byte` may be in a header name: a token character (RFC 9110 5.6.2). */
fun httpTokenByte(byte: int): bool =
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) ||
    byte == 45 || byte == 33 || (byte >= 35 && byte <= 39) || byte == 42 || byte == 43 ||
    byte == 46 || (byte >= 94 && byte <= 96) || byte == 124 || byte == 126

/** What a request head line that no reader can take as a header leaves in `request.headers`: a line without a colon or
 *  with an empty name (a folded line is one), or one with a bare LF or CR in it or a byte in its name that is not a
 *  token character (RFC 9112 2.2, 5.1, 5.2). The line is
 *  dropped from the parse as before, but this marker (a name that begins with a space, which `httpRequestFraming`
 *  refuses, and an empty value) says it was there, so a request with such a line is refused, not read two ways. */
fun httpMalformedLineHeader(): HttpHeader = HttpHeader(" malformed line", "")

/** Whether `input[begin, end)` has a byte under 32. */
fun httpHasControlByte(input: string, begin: int, end: int): bool {
    var at = begin
    var found = false
    while (!found && at < end) {
        if (input[at] < 32) found = true
        at = at + 1
    }
    found
}

/** Whether the header name in `input[begin, end)` has a byte that is not a token character. */
fun httpNameHasNonToken(input: string, begin: int, end: int): bool {
    var at = begin
    var found = false
    while (!found && at < end) {
        if (!httpTokenByte(input[at])) found = true
        at = at + 1
    }
    found
}

private fun httpParseRequestChecked(input: string, peer: SocketPeerAddress?): HttpRequest {
    val requestLineEnd = httpLineEnd(input, 0)
    val firstSpace = httpFindByte(input, 32, 0, requestLineEnd)
    val secondSpace = httpFindByte(input, 32, firstSpace + 1, requestLineEnd)
    var method = ""
    var target = "/"
    if (firstSpace > 0 && secondSpace > firstSpace) {
        method = input.slice(0, firstSpace)
        target = input.slice(firstSpace + 1, secondSpace)
    }
    var path = target
    var query = ""
    val question = httpFindByte(target, 63, 0, target.size)
    if (question >= 0) {
        path = target.slice(0, question)
        query = target.slice(question + 1, target.size)
    }

    val headers: array<HttpHeader> = []
    // The same rule as the native scan: no control byte in the request line.
    if (httpHasControlByte(input, 0, requestLineEnd)) headers.append(httpMalformedLineHeader())
    var cursor = requestLineEnd + 2
    var bodyBegin = input.size
    var more = cursor < input.size
    while (more) {
        val end = httpLineEnd(input, cursor)
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
            cursor = cursor
        } else {
            val colon = httpFindByte(input, 58, cursor, end)
            if (colon > cursor) {
                var valueBegin = colon + 1
                while (valueBegin < end && input[valueBegin] == 32) {
                    valueBegin = valueBegin + 1
                }
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            if (colon <= cursor || textFindByte(input, 10, cursor, end) >= 0 ||
                textFindByte(input, 13, cursor, end) >= 0 ||
                httpNameHasNonToken(input, cursor, colon)) headers.append(httpMalformedLineHeader())
            cursor = end + 2
            if (cursor >= input.size) more = false
            cursor = cursor
        }
    }
    var body = ""
    if (bodyBegin < input.size) body = input.slice(bodyBegin, input.size)
    HttpRequest(method, path, query, headers, body, [], [], peer)
}

fun HttpResponse.header(name: string): string {
    var result = ""
    var index = 0
    while (index < this.headers.size) {
        if (httpAsciiEqualInsensitive(this.headers[index].name, name)) {
            result = this.headers[index].value
        }
        index = index + 1
    }
    result
}

fun httpParseResponseBounded(
    input: string,
    maximumBodyBytes: int,
    responseToHead: bool = false,
    eof: bool = true
): HttpClientResult {
    val offset = httpFinalResponseOffset(input)
    httpParseFinalResponseBounded(
        if (offset == 0) input else input.slice(offset, input.size),
        maximumBodyBytes, responseToHead, eof
    )
}

private fun httpParseFinalResponseBounded(
    input: string, maximumBodyBytes: int, responseToHead: bool, eof: bool
): HttpClientResult {
    val statusLineEnd = httpLineEnd(input, 0)
    val firstSpace = httpFindByte(input, 32, 0, statusLineEnd)
    val secondSpace = httpFindByte(input, 32, firstSpace + 1, statusLineEnd)
    var status = 0
    if (firstSpace > 0 && secondSpace > firstSpace + 1) {
        status = httpDecimalLength(
            input.slice(firstSpace + 1, secondSpace),
            999
        )
    }

    val headers: array<HttpHeader> = []
    var cursor = statusLineEnd + 2
    var bodyBegin = input.size + 1
    var more = statusLineEnd < input.size
    while (more) {
        val end = httpLineEnd(input, cursor)
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
        } else if (end >= input.size) {
            more = false
        } else {
            val colon = httpFindByte(input, 58, cursor, end)
            if (colon > cursor) {
                var valueBegin = colon + 1
                while (valueBegin < end && input[valueBegin] == 32) {
                    valueBegin = valueBegin + 1
                }
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            cursor = end + 2
            if (cursor >= input.size) more = false
        }
    }

    var body = ""
    if (bodyBegin <= input.size) body = input.slice(bodyBegin, input.size)
    val provisional = HttpResponse(status, headers, body)
    val encodedLength = provisional.header("Content-Length")
    val transferEncoding = provisional.header("Transfer-Encoding")
    val chunked = httpCoreHeaderTokenContains(transferEncoding, "chunked")
    var complete = status >= 100 && bodyBegin <= input.size
    val noBody = responseToHead || (status >= 100 && status < 200) ||
        status == 204 || status == 304
    if (noBody) body = ""
    else if (chunked) {
        val decoded = httpCoreDecodeChunked(body, maximumBodyBytes)
        complete = complete && decoded.complete && decoded.valid
        body = decoded.body
    } else if (transferEncoding == "" && encodedLength != "") {
        val expected = httpDecimalLength(encodedLength, maximumBodyBytes)
        complete = complete && expected >= 0 && body.size >= expected
        if (expected >= 0 && body.size > expected) {
            body = body.slice(0, expected)
        }
    } else complete = complete && eof && body.size <= maximumBodyBytes
    HttpClientResult(
        HttpResponse(status, headers, body),
        status >= 100,
        complete && !httpResponseLengthsDiffer(headers)
    )
}

// A response with two Content-Lengths that differ has two answers to where its body ends: it is an error, not a
// guess (RFC 9112 6.3), so a reader stops at once and reports it instead of waiting for more. That holds for a HEAD,
// 204 or 304 response too (ambiguous metadata). With a Transfer-Encoding the Content-Length is not used at all, so
// that case needs no check.
fun httpResponseLengthsDiffer(headers: array<HttpHeader>): bool {
    var lengths = 0
    var first = ""
    var ambiguous = false
    for (header in headers) {
        if (header.name.size == 14 && httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            lengths = lengths + 1
            if (lengths == 1) first = header.value
            else if (header.value != first) ambiguous = true
        }
    }
    ambiguous
}

fun httpParseResponse(input: string): HttpClientResult =
    httpParseResponseBounded(input, 1048576)

// The transport receives a rendered request; HEAD responses end at headers.
fun httpRequestIsHead(request: string): bool =
    request.size >= 5 && request.slice(0, 5) == "HEAD "

fun httpClient(
    authority: string,
    exchange: (string, int, int) -> HttpTransportResult,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000
): HttpClient = HttpClient(
    authority,
    exchange,
    maximumResponseBytes,
    timeoutMilliseconds
)

// When an exchange of at most `deadlineMilliseconds` must end (0: never).
fun httpExchangeDeadline(deadlineMilliseconds: int): int =
    if (deadlineMilliseconds > 0) linuxMonotonicMilliseconds() + deadlineMilliseconds else 0

// How long the next read or write of an exchange may wait: `timeoutMilliseconds`,
// or what is left before `deadline` when that's shorter, and 0 when none is left.
fun httpExchangeWait(deadline: int, timeoutMilliseconds: int): int {
    if (deadline == 0) return timeoutMilliseconds
    val left = deadline - linuxMonotonicMilliseconds()
    if (left <= 0) 0
    else if (timeoutMilliseconds > 0 && timeoutMilliseconds < left) timeoutMilliseconds
    else left
}

private fun httpExchangeIpv4(
    address: string,
    port: int,
    request: string,
    maximumResponseBytes: int,
    timeoutMilliseconds: int,
    deadlineMilliseconds: int
): HttpTransportResult {
    val deadline = httpExchangeDeadline(deadlineMilliseconds)
    // The connector takes at most ten seconds; a longer timeout is still valid
    // for the exchange. It bounds each read and write, which the socket enforces.
    val connection = tcpConnectIpv4(
        address, port,
        if (timeoutMilliseconds > 10000) 10000 else timeoutMilliseconds
    )
    httpExchangeStream(connection, request, maximumResponseBytes, timeoutMilliseconds, deadline)
}

// Consumes the connected stream, including on failure.
private fun httpExchangeStream(
    var connection: TcpConnection,
    request: string,
    maximumResponseBytes: int,
    timeoutMilliseconds: int,
    deadline: int
): HttpTransportResult {
    var succeeded = connection.descriptor >= 0
    if (succeeded) succeeded = connection.setTimeouts(
        timeoutMilliseconds, timeoutMilliseconds
    )
    var written = 0
    while (succeeded && written < request.size) {
        val wait = httpExchangeWait(deadline, timeoutMilliseconds)
        succeeded = wait > 0 && (deadline == 0 || connection.setTimeouts(wait, wait))
        if (succeeded) {
            val end = if (request.size - written < 65536) request.size else written + 65536
            succeeded = connection.write(request.slice(written, end)) == end - written
            written = end
        }
    }
    var response = ""
    var reading = succeeded
    var eof = false
    while (reading && response.size <= maximumResponseBytes) {
        val remaining = maximumResponseBytes - response.size
        // At the limit, one byte distinguishes EOF from an oversized response.
        val readMaximum = if (remaining == 0) 1 else if (remaining < 65536) remaining else 65536
        val wait = httpExchangeWait(deadline, timeoutMilliseconds)
        succeeded = wait > 0 && (deadline == 0 || connection.setTimeouts(wait, wait))
        reading = succeeded
        if (reading) {
            val read = connection.readResult(readMaximum)
            if (read.status == "error") { succeeded = false; reading = false }
            else if (read.status == "eof") { eof = true; reading = false }
            else if (read.bytes.size > remaining) { succeeded = false; reading = false }
            else response = "$response${read.bytes}"
            // A peer that keeps the connection open has finished at its own framing.
            val parsed = httpParseResponseBounded(response, maximumResponseBytes,
                httpRequestIsHead(request), false)
            val ambiguous = httpResponseLengthsDiffer(parsed.response.headers)
            if (parsed.complete || ambiguous) reading = false
        }
    }
    if (connection.descriptor >= 0) connection.close()
    HttpTransportResult(response, succeeded, eof)
}

fun httpIpv4Client(
    authority: string,
    address: string,
    port: int,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000,
    // A limit on the whole exchange (0: none). The timeout bounds each read and
    // write, so a peer sending a byte at a time can otherwise hold the caller.
    deadlineMilliseconds: int = 0
): HttpClient = httpClient(
    authority,
    { request: string, maximum: int, timeout: int ->
        httpExchangeIpv4(address, port, request, maximum, timeout, deadlineMilliseconds)
    },
    maximumResponseBytes,
    timeoutMilliseconds
)

// HTTP/1.1 over a local stream, for services such as Docker's API.
fun httpUnixClient(
    authority: string,
    address: UnixSocketAddress,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000,
    deadlineMilliseconds: int = 0
): HttpClient = httpClient(
    authority,
    { request: string, maximum: int, timeout: int ->
        val deadline = httpExchangeDeadline(deadlineMilliseconds)
        val wait = httpExchangeWait(deadline, timeout)
        var local = unixConnect(address, if (wait > 10000) 10000 else wait)
        val stream = TcpConnection(local.descriptor)
        local.descriptor = -1
        httpExchangeStream(stream, request, maximum, timeout, deadline)
    }, maximumResponseBytes, timeoutMilliseconds
)

fun HttpClient.send(request: HttpRequest): HttpClientResult {
    val transport = this.exchange
    val exchanged = transport(
        request.renderForClient(this.authority),
        this.maximumResponseBytes,
        this.timeoutMilliseconds
    )
    var result = HttpClientResult(HttpResponse(0, [], ""), false, false)
    if (exchanged.succeeded) result = httpParseResponseBounded(
        exchanged.bytes, this.maximumResponseBytes, request.method == "HEAD", exchanged.eof
    )
    result
}

private fun httpPathParts(path: string): array<string> {
    val parts: array<string> = []
    var begin = 0
    if (path.size > 0 && path[0] == 47) begin = 1
    var index = begin
    while (index <= path.size) {
        if (index == path.size || path[index] == 47) {
            parts.append(path.slice(begin, index))
            begin = index + 1
        }
        index = index + 1
    }
    parts
}

fun httpMatchPath(pattern: string, path: string): HttpPathMatch {
    if (pattern == path) HttpPathMatch(true, [], [])
    else {
        val names: array<string> = []
        val values: array<string> = []
        var patternBegin = 0
        var pathBegin = 0
        if (pattern.size > 0 && pattern[0] == 47) patternBegin = 1
        if (path.size > 0 && path[0] == 47) pathBegin = 1
        var matched = true
        var more = true
        while (matched && more) {
            var patternEnd = textFindByte(
                pattern, 47, patternBegin, pattern.size
            )
            var pathEnd = textFindByte(path, 47, pathBegin, path.size)
            if (patternEnd < 0) patternEnd = pattern.size
            if (pathEnd < 0) pathEnd = path.size
            if (patternBegin < patternEnd &&
                pattern[patternBegin] == 58) {
                names.append(pattern.slice(patternBegin + 1, patternEnd))
                values.append(path.slice(pathBegin, pathEnd))
            } else {
                matched = httpCoreRangeEqual(
                    pattern, patternBegin, patternEnd,
                    path, pathBegin, pathEnd
                )
            }
            val patternDone = patternEnd == pattern.size
            val pathDone = pathEnd == path.size
            if (matched && patternDone != pathDone) matched = false
            more = !patternDone && !pathDone
            patternBegin = patternEnd + 1
            pathBegin = pathEnd + 1
        }
        HttpPathMatch(matched, names, values)
    }
}

private fun httpVersionCompare(left: string, right: string): int {
    var result = 0
    var index = 0
    var more = true
    while (index < left.size && index < right.size && more) {
        if (left[index] < right[index]) {
            result = -1
            more = false
        }
        if (left[index] > right[index]) {
            result = 1
            more = false
        }
        index = index + 1
    }
    if (more && left.size < right.size) result = -1
    if (more && left.size > right.size) result = 1
    result
}

fun HttpRouter.get(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("GET", pattern, handler)

private fun httpRoutePatternParameterized(pattern: string): bool {
    var parameterized = pattern.size > 0 && pattern[0] == 58
    var index = 1
    while (!parameterized && index < pattern.size) {
        parameterized = pattern[index] == 58 && pattern[index - 1] == 47
        index = index + 1
    }
    parameterized
}

// A collision only admits a route to the full matcher; it cannot change the
// selected route. Keep the fingerprint bounded so checked integer arithmetic
// remains valid for arbitrarily long paths.
private fun httpRouteFingerprint(path: string): int {
    var fingerprint = 5381
    var index = 0
    while (index < path.size) {
        fingerprint = (
            ((fingerprint << 5) + fingerprint) ^ path[index]
        ) & 2147483647
        index = index + 1
    }
    fingerprint
}

private fun httpRoute(
    method: string,
    pattern: string,
    version: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRoute = HttpRoute(
    method,
    pattern,
    version,
    handler
)

fun HttpRouter.addRoute(
    method: string,
    pattern: string,
    version: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    val route = httpRoute(method, pattern, version, handler)
    val parameterized = httpRoutePatternParameterized(pattern)
    val fingerprint = httpRouteFingerprint(pattern)
    val routeIndex = this.routes.size
    this.routes.append(route)
    this.routeFingerprints.append(fingerprint)
    // Routers constructed through the public two-argument constructor predate
    // the index storage. Keep their registration path valid and let dispatch
    // use its linear compatibility fallback.
    if (this.literalRouteBuckets.size == 64) {
        if (parameterized) {
            this.parameterizedRouteIndexes.append(routeIndex)
        } else {
            val bucket = fingerprint & 63
            this.literalRouteBuckets[bucket].append(routeIndex)
        }
    }
    this.indexedRouteMarkers.append(routeIndex)
    this
}

fun HttpRouter.route(
    method: string,
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.addRoute(method, pattern, "", handler)
}

fun HttpRouter.post(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("POST", pattern, handler)

fun HttpRouter.head(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("HEAD", pattern, handler)

fun HttpRouter.put(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("PUT", pattern, handler)

fun HttpRouter.patch(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("PATCH", pattern, handler)

fun HttpRouter.delete(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("DELETE", pattern, handler)

fun HttpRouter.options(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("OPTIONS", pattern, handler)

fun HttpRouter.version(versionName: string): HttpVersionedRouter =
    HttpVersionedRouter(this, versionName)

fun HttpVersionedRouter.get(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("GET", pattern, this.version, handler)
}

fun HttpVersionedRouter.post(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("POST", pattern, this.version, handler)
}

fun HttpVersionedRouter.head(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("HEAD", pattern, this.version, handler)
}

fun HttpRouter.dispatch(request: HttpRequest): HttpResponse {
    val requestedVersion = request.header(this.versionHeader)
    val indexed = this.routes.size > 8 &&
        this.literalRouteBuckets.size == 64 &&
        this.routeFingerprints.size == this.routes.size &&
        this.indexedRouteMarkers.size == this.routes.size
    val requestFingerprint = if (indexed) {
        httpRouteFingerprint(request.path)
    } else 0
    val literalBucket = requestFingerprint & 63
    val literalCandidateCount = if (indexed) {
        this.literalRouteBuckets[literalBucket].size
    } else 0
    var selected = -1
    var selectedVersion = ""
    var selectedMatch = HttpPathMatch(false, [], [])
    var selectedExactMethod = false
    var routePosition = 0
    var literalPosition = 0
    var parameterizedPosition = 0
    var more = if (indexed) {
        literalCandidateCount > 0 || this.parameterizedRouteIndexes.size > 0
    } else this.routes.size > 0
    while (more) {
        var index = routePosition
        var parameterizedCandidate = false
        if (indexed) {
            val literalIndex = if (literalPosition < literalCandidateCount) {
                this.literalRouteBuckets[literalBucket][literalPosition]
            } else this.routes.size
            val parameterizedIndex = if (
                parameterizedPosition < this.parameterizedRouteIndexes.size
            ) {
                this.parameterizedRouteIndexes[parameterizedPosition]
            } else this.routes.size
            if (literalIndex < parameterizedIndex) {
                index = literalIndex
                literalPosition = literalPosition + 1
            } else {
                index = parameterizedIndex
                parameterizedPosition = parameterizedPosition + 1
                parameterizedCandidate = true
            }
        } else {
            routePosition = routePosition + 1
        }
        val route = this.routes[index]
        val exactMethod = route.method == request.method
        val headFallback = request.method == "HEAD" && route.method == "GET"
        val pathCandidate = !indexed || parameterizedCandidate ||
            this.routeFingerprints[index] == requestFingerprint
        if ((exactMethod || headFallback) && pathCandidate) {
            val match = httpMatchPath(route.pattern, request.path)
            var eligible = match.matched
            if (eligible && requestedVersion != "" && route.version != "" &&
                httpVersionCompare(route.version, requestedVersion) > 0) {
                eligible = false
            }
            val versionComparison = httpVersionCompare(
                route.version,
                selectedVersion
            )
            if (eligible && (selected < 0 || versionComparison > 0 ||
                (versionComparison == 0 && exactMethod &&
                    !selectedExactMethod))) {
                selected = index
                selectedVersion = route.version
                selectedMatch = match
                selectedExactMethod = exactMethod
            }
        }
        more = if (indexed) {
            literalPosition < literalCandidateCount ||
                parameterizedPosition < this.parameterizedRouteIndexes.size
        } else routePosition < this.routes.size
    }
    var response = httpText("not found", 404)
    if (selected >= 0) {
        val routed = HttpRequest(
            request.method,
            request.path,
            request.query,
            request.headers,
            request.body,
            selectedMatch.names,
            selectedMatch.values,
            request.peerAddress
        )
        val handler = this.routes[selected].handler
        response = handler(routed)
    }
    response
}

fun serveHttpOnce(router: HttpRouter, var listener: TcpListener): int {
    val connection = listener.accept()
    val request = httpRequestWithPeer(httpParseRequest(httpReadRequest(connection)),
        connection.descriptor)
    val response = router.dispatch(request)
    var rendered = response.render()
    if (request.method == "HEAD") rendered = response.renderHead()
    val written = connection.write(rendered)
    connection.close()
    written
}

fun serveHttp(router: HttpRouter, port: int): int {
    val listener = tcpListen(port)
    serveHttpOnListener(router, listener)
}

fun serveHttpOnListener(router: HttpRouter, var listener: TcpListener): int {
    tcpEnableGracefulShutdown()
    while (!tcpShutdownRequested()) {
        val connection = listener.acceptUntilShutdown()
        if (connection.descriptor >= 0) {
            val request = httpRequestWithPeer(httpParseRequest(httpReadRequest(connection)),
                connection.descriptor)
            val response = router.dispatch(request)
            var rendered = response.render()
            if (request.method == "HEAD") rendered = response.renderHead()
            connection.write(rendered)
            connection.close()
        }
    }
    listener.close()
    0
}
