// A small HTTP/1.1 stack and version-aware router written in Abla. Importing
// this module does not pull in JSON, files, TLS, the compiler, or hot reload.

import "abla/net"
import "abla/sys/linux/process"
import "abla/text"
import "abla/bytes"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// One header field with its original `name` spelling and `value`.
class HttpHeader(val name: string, val value: string)

// An HTTP request with its method, path, raw query, headers, and body. Route parameters use parallel name and value arrays. The optional peer address identifies the accepted socket peer.
class HttpRequest(
    val method: string,
    val path: string,
    val query: string,
    val headers: array<HttpHeader>,
    val body: string,
    val parameterNames: array<string>,
    val parameterValues: array<string>,
    // Accepted socket peer; never taken from forwarding headers.
    val peerAddress: SocketPeerAddress? = null
)

/** Attach transport metadata to an already parsed request. */
fun httpRequestWithAddress(request: HttpRequest,
    peer: SocketPeerAddress?): HttpRequest = HttpRequest(
        request.method, request.path, request.query, request.headers, request.body,
        request.parameterNames, request.parameterValues, peer
    )

// Returns the request with the socket peer attached, or with no peer if the address lookup fails.
fun httpRequestWithPeer(request: HttpRequest, descriptor: int): HttpRequest =
    httpRequestWithAddress(request, socketPeerAddress(descriptor))

// An HTTP response with the numeric `status`, ordered `headers`, and response `body` bytes.
class HttpResponse(
    val status: int,
    val headers: array<HttpHeader>,
    val body: string
)

// HTTP remains independent of TLS policy. A transport receives already-framed
// request bytes and returns bounded response bytes; TLS modules can implement
// the same callback without changing request, response, or client code.
class HttpTransportResult(
    val bytes: string,
    val succeeded: bool,
    // A custom transport returns a complete exchange unless it says otherwise.
    val eof: bool = true
)

// A response and flags reporting whether parsing succeeded and whether framing identified a complete response.
class HttpClientResult(
    val response: HttpResponse,
    val succeeded: bool,
    val complete: bool,
    // Why the request was not sent (httpClientRequestError names the part), "" otherwise.
    val error: string = ""
)

// Holds decoded body bytes and consumed input length, with separate flags for a complete and a valid chunk stream.
class HttpCoreChunkDecode(
    val body: string,
    val consumed: int,
    val complete: bool,
    val valid: bool,
    // For incomplete input: the offset of the first chunk element (a size line with its data, or the last chunk and its trailers) that is not complete;
    // `body` holds everything before it, so a caller may drop those bytes and decode the rest when more arrives.
    val resume: int = 0,
    // For input that ends inside a chunk's data: the input size at which that chunk is complete (zero otherwise).
    val need: int = 0
)

// A client with a Host authority, transport callback, response byte limit, and timeout. Use send to render requests and parse responses.
class HttpClient(
    val authority: string,
    val exchange: (string, int, int) -> HttpTransportResult,
    val maximumResponseBytes: int,
    val timeoutMilliseconds: int
)

// Reports a path match and the captured parameter names and values in matching order.
class HttpPathMatch(
    val matched: bool,
    val names: array<string>,
    val values: array<string>
)

// Associates an HTTP method, path pattern, and optional API version with a handler.
class HttpRoute(
    val method: string,
    val pattern: string,
    val version: string,
    val handler: (HttpRequest) -> HttpResponse
)

// Holds registered routes, their dispatch indexes, and the header used to select an API version.
class HttpRouter(
    val versionHeader: string,
    val routes: array<HttpRoute>,
    val literalRouteBuckets: array<array<int>> = [],
    val parameterizedRouteIndexes: array<int> = [],
    val routeFingerprints: array<int> = [],
    val indexedRouteMarkers: array<int> = []
)

// Registers handlers on an existing router under one API version.
class HttpVersionedRouter(
    val router: HttpRouter,
    val version: string
)

// Creates an empty router that reads the requested API version from `versionHeader`.
fun httpRouter(versionHeader: string = "Abla-Version"): HttpRouter {
    val literalRouteBuckets: array<array<int>> = []
    var bucket = 0
    while (bucket < 64) {
        literalRouteBuckets.append([])
        bucket = bucket + 1
    }
    HttpRouter(versionHeader, [], literalRouteBuckets, [], [], [])
}

// Returns whether `left` and `right` match after folding ASCII letter case.
fun httpAsciiEqualInsensitive(left: string, right: string): bool {
    textAsciiEqualInsensitive(left, right)
}

// Returns the last matching header's value, comparing `name` without regard to ASCII case. Returns an empty string when absent.
fun HttpRequest.header(name: string): string {
    var result = ""
    var found = false
    var index = this.headers.size
    // The last byte, folded the way `| 32` folds letters, rejects most candidates
    // of the same length before the full comparison (names that differ only in
    // case have the same folded byte, so it never rejects a match).
    val size = name.size
    val tail = if (size > 0) (name[size - 1] | 32) else 0
    // Search backward and stop at the first match. This preserves the existing
    // last-duplicate-wins behavior without scanning the rest of the headers.
    while (!found && index > 0) {
        index = index - 1
        val candidate = this.headers[index]
        val candidateName = candidate.name
        // Reject mismatched lengths before entering the case-folding helper.
        if (candidateName.size == size && (size == 0 || (candidateName[size - 1] | 32) == tail) &&
            httpAsciiEqualInsensitive(candidateName, name)) {
            result = candidate.value
            found = true
        }
    }
    result
}

// Returns the last route parameter named `name`, falling back to a raw query lookup if there is no route match. Returns an empty string when absent.
fun HttpRequest.parameter(name: string): string {
    var result = ""
    var found = false
    var index = this.parameterNames.size
    // Search from the end so duplicate route names retain their existing
    // last-value-wins behavior without traversing earlier entries after a hit.
    while (!found && index > 0) {
        index = index - 1
        val candidateName = this.parameterNames[index]
        val possible = candidateName.size == name.size &&
            (name.size == 0 || candidateName[0] == name[0])
        if (possible && candidateName == name) {
            result = this.parameterValues[index]
            found = true
        }
    }
    if (!found) result = httpQueryParameter(this.query, name)
    result
}

// Route-only lookup for applications that do not want query fallback.
fun HttpRequest.routeParameter(name: string): string {
    var result = ""
    var found = false
    var index = this.parameterNames.size
    while (!found && index > 0) {
        index = index - 1
        val candidateName = this.parameterNames[index]
        val possible = candidateName.size == name.size &&
            (name.size == 0 || candidateName[0] == name[0])
        if (possible && candidateName == name) {
            result = this.parameterValues[index]
            found = true
        }
    }
    result
}

// Query-only lookup for applications that do not need the combined
// route-precedence convenience of parameter().
fun HttpRequest.queryParameter(name: string): string =
    httpQueryParameter(this.query, name)

// The value of a query parameter with its form encoding undone (percentDecode in query mode: %XX escapes and `+` as a
// space), or null when the parameter is absent or empty, or its value is malformed (a bad escape or invalid UTF-8).
// queryParameter returns the raw text; the name is matched as written in both.
fun HttpRequest.queryParameterDecoded(name: string): string? {
    val raw = httpQueryParameter(this.query, name)
    if (raw.size == 0) return null
    percentDecode(raw, true)
}

private trusted fun httpQueryParameter(query: string, name: string): string {
    if (ablaCompileTimeNativeHost()) return httpQueryParameterNative(query, name)
    if (ablaAtCompileTime()) return httpQueryParameterChecked(query, name)
    return httpQueryParameterNative(query, name)
}

private trusted fun httpQueryParameterNative(query: string, name: string): string {
    val size = query.size
    val nameSize = name.size
    if (nameSize >= size) return ""
    // Keep both strings alive until the bounded scan finishes. No call in
    // the scan allocates; only the returned value is sliced afterward.
    val data = ablaUnsafeStringAddress(query)
    val key = ablaUnsafeStringAddress(name)
    var fieldBegin = 0
    while (fieldBegin < size) {
        val nameEnd = fieldBegin + nameSize
        if (nameEnd < size &&
            ablaUnsafeLoadU8(nativePointerFromAddress(data + nameEnd)) == 61 &&
            (nameSize == 0 ||
                ablaUnsafeLoadU8(nativePointerFromAddress(data + nameEnd - 1)) ==
                    ablaUnsafeLoadU8(nativePointerFromAddress(key + nameSize - 1)))) {
            var equal = true
            var offset = 0
            while (equal && offset < nameSize) {
                equal = ablaUnsafeLoadU8(nativePointerFromAddress(data + fieldBegin + offset)) ==
                    ablaUnsafeLoadU8(nativePointerFromAddress(key + offset))
                offset = offset + 1
            }
            if (equal) {
                val valueBegin = nameEnd + 1
                var fieldEnd = valueBegin
                while (fieldEnd < size &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(data + fieldEnd)) != 38) {
                    fieldEnd = fieldEnd + 1
                }
                if (fieldEnd > valueBegin) return query.slice(valueBegin, fieldEnd)
            }
        }
        while (fieldBegin < size &&
            ablaUnsafeLoadU8(nativePointerFromAddress(data + fieldBegin)) != 38) {
            fieldBegin = fieldBegin + 1
        }
        fieldBegin = fieldBegin + 1
    }
    ""
}

private fun httpQueryParameterChecked(query: string, name: string): string {
    var fieldBegin = 0
    while (fieldBegin < query.size) {
        // Only field starts can match. Check the delimiter and final byte
        // before comparing the shared prefixes common in numbered keys.
        val nameEnd = fieldBegin + name.size
        if (nameEnd < query.size && query[nameEnd] == 61 &&
            (name.size == 0 || query[nameEnd - 1] == name[name.size - 1]) &&
            httpCoreRangeEqual(query, fieldBegin, nameEnd, name, 0, name.size)) {
            var fieldEnd = textFindByte(query, 38, nameEnd + 1, query.size)
            if (fieldEnd < 0) fieldEnd = query.size
            val result = query.slice(nameEnd + 1, fieldEnd)
            if (result != "") return result
        }
        val next = textFindByte(query, 38, fieldBegin, query.size)
        if (next < 0) return ""
        fieldBegin = next + 1
    }
    ""
}

private fun httpCoreRangeEqual(
    left: string,
    leftBegin: int,
    leftEnd: int,
    right: string,
    rightBegin: int,
    rightEnd: int
): bool {
    val leftLength = leftEnd - leftBegin
    val rightLength = rightEnd - rightBegin
    var equal = leftLength == rightLength
    var index = 0
    while (equal && index < leftLength) {
        equal = left[leftBegin + index] == right[rightBegin + index]
        index = index + 1
    }
    equal
}

// Constructs a request from `method`, `path`, `body`, and `headers`. The query and route parameters start empty. The path is stored as supplied.
fun httpRequest(
    method: string,
    path: string,
    body: string = "",
    headers: array<HttpHeader> = []
): HttpRequest = HttpRequest(method, path, "", headers, body, [], [])

// Constructs a GET request for `path` with `headers` and an empty body.
fun httpGet(path: string, headers: array<HttpHeader> = []): HttpRequest =
    httpRequest("GET", path, "", headers)

// Constructs a POST request for `path` with the supplied `body` and `headers`.
fun httpPost(
    path: string,
    body: string,
    headers: array<HttpHeader> = []
): HttpRequest = httpRequest("POST", path, body, headers)

// Returns a response with `status`, the supplied `body`, and Content-Type text/plain with UTF-8 charset.
fun httpText(body: string, status: int = 200): HttpResponse = HttpResponse(
    status,
    [HttpHeader("Content-Type", "text/plain; charset=utf-8")],
    body
)

// Low-level helper for a body which is already valid encoded JSON. Import
// abla/http/json and use httpJsonValue when starting from a Json tree.
fun httpJson(body: string, status: int = 200): HttpResponse = HttpResponse(
    status,
    [HttpHeader("Content-Type", "application/json")],
    body
)

// Returns the reason phrase for a recognized HTTP `status`, or Unknown Status when the code has no entry.
fun httpStatusReason(status: int): string {
    var reason = "Unknown Status"
    if (status == 101) reason = "Switching Protocols"
    if (status == 200) reason = "OK"
    if (status == 201) reason = "Created"
    if (status == 204) reason = "No Content"
    if (status == 302) reason = "Found"
    if (status == 303) reason = "See Other"
    if (status == 400) reason = "Bad Request"
    if (status == 401) reason = "Unauthorized"
    if (status == 403) reason = "Forbidden"
    if (status == 404) reason = "Not Found"
    if (status == 405) reason = "Method Not Allowed"
    if (status == 409) reason = "Conflict"
    if (status == 413) reason = "Payload Too Large"
    if (status == 415) reason = "Unsupported Media Type"
    if (status == 422) reason = "Unprocessable Content"
    if (status == 426) reason = "Upgrade Required"
    if (status == 429) reason = "Too Many Requests"
    if (status == 500) reason = "Internal Server Error"
    if (status == 501) reason = "Not Implemented"
    if (status == 502) reason = "Bad Gateway"
    if (status == 503) reason = "Service Unavailable"
    if (status == 504) reason = "Gateway Timeout"
    reason
}

// Serializes the HTTP/1.1 status line and headers, ending each with CRLF. Adds missing Content-Length and Connection headers except for status 101. The blank line and body are left to the caller.
fun HttpResponse.renderHeaders(): string {
    var output = "HTTP/1.1 ${this.status} ${httpStatusReason(this.status)}\r\n"
    var hasLength = false
    var hasConnection = false
    var index = 0
    while (index < this.headers.size) {
        val header = this.headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            hasLength = true
        }
        if (httpAsciiEqualInsensitive(header.name, "Connection")) {
            hasConnection = true
        }
        output = "$output${header.name}: ${header.value}\r\n"
        index = index + 1
    }
    if (!hasLength && this.status != 101) {
        output = "${output}Content-Length: ${this.body.size}\r\n"
    }
    if (!hasConnection && this.status != 101) {
        output = "${output}Connection: close\r\n"
    }
    output
}

// Returns the HTTP/1.1 response bytes, including the blank line and body.
fun HttpResponse.render(): string = "${this.renderHeaders()}\r\n${this.body}"

// Returns the HTTP/1.1 status and headers followed by a blank line. Content-Length still describes the underlying body.
fun HttpResponse.renderHead(): string = "${this.renderHeaders()}\r\n"

// Serializes an HTTP/1.1 request and body. Uses `authority` for Host when absent and fills missing Content-Length and Connection headers.
// Returns "" for a request whose parts cannot be sent as they are (httpClientRequestError): nothing of it is written.
fun HttpRequest.renderForClient(authority: string): string {
    var target = this.path
    if (this.query != "") target = "$target?${this.query}"
    if (httpClientRequestError(this.method, target, authority, this.headers) != "") return ""
    var output = "${this.method} $target HTTP/1.1\r\n"
    var hasHost = false
    var hasLength = false
    var hasConnection = false
    var index = 0
    while (index < this.headers.size) {
        val header = this.headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Host")) hasHost = true
        if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            hasLength = true
        }
        if (httpAsciiEqualInsensitive(header.name, "Connection")) {
            hasConnection = true
        }
        output = "$output${header.name}: ${header.value}\r\n"
        index = index + 1
    }
    if (!hasHost) output = "${output}Host: $authority\r\n"
    if (!hasLength) {
        output = "${output}Content-Length: ${this.body.size}\r\n"
    }
    if (!hasConnection) output = "${output}Connection: close\r\n"
    "$output\r\n${this.body}"
}

// Returns the offset of the first CRLF at or after `begin`, or the input length if none is found.
fun httpLineEnd(input: string, begin: int): int {
    val found = textFindSequence(input, "\r\n", begin, input.size)
    if (found >= 0) found else input.size
}

private fun httpFindByte(input: string, byte: int, begin: int, end: int): int {
    textFindByte(input, byte, begin, end)
}

// Returns the byte offset immediately after the first CRLF CRLF delimiter in `input`, or -1 if the delimiter is absent.
fun httpHeaderEnd(input: string): int {
    val found = textFindSequence(input, "\r\n\r\n", 0, input.size)
    if (found >= 0) found + 4 else -1
}

// The status at a response start, or 0 until its status line is complete.
fun httpResponseStatusAt(input: string, begin: int): int {
    val end = httpLineEnd(input, begin)
    if (end >= input.size) return 0
    val first = httpFindByte(input, 32, begin, end)
    val second = httpFindByte(input, 32, first + 1, end)
    if (first <= begin || second <= first + 1) return 0
    httpDecimalLength(input.slice(first + 1, second), 999)
}

// Informational responses precede the final response; 101 is the terminal
// upgrade response. Keep an incomplete interim header for the next read.
fun httpFinalResponseOffset(input: string): int {
    var offset = 0
    var scanning = true
    while (scanning && offset < input.size) {
        val status = httpResponseStatusAt(input, offset)
        if (status < 100 || status >= 200 || status == 101) scanning = false
        else {
            val end = textFindSequence(input, "\r\n\r\n", offset, input.size)
            if (end < 0) scanning = false else offset = end + 4
        }
    }
    offset
}

// Whether a Transfer-Encoding value is exactly the one coding "chunked" (spaces and tabs around it allowed).
// Anything else (identity, gzip, "chunked, gzip", an unknown coding) is a body this server cannot frame.
private fun httpTransferIsChunkedOnly(value: string): bool {
    var left = 0
    var right = value.size
    while (left < right && (value[left] == 32 || value[left] == 9)) left = left + 1
    while (right > left && (value[right - 1] == 32 || value[right - 1] == 9)) right = right - 1
    right - left == 7 && httpAsciiEqualInsensitive(value.slice(left, right), "chunked")
}

/** How a request's body is framed: -1 when its framing is malformed and the request is to be refused (400, then
 *  close, nothing of the buffer read again), -2 when it is chunked, else the Content-Length (0 when there is none).
 *  Strict on purpose: a request read with a different length than its sender (or a proxy in front) meant makes the
 *  bytes after it a different request. Refused: an empty or non-digit Content-Length or one over `maximumBody`; two
 *  Content-Lengths that differ; Content-Length together with Transfer-Encoding; a Transfer-Encoding other than exactly
 *  "chunked" (identity, gzip, "chunked, gzip", unknown) or given twice, and any in an HTTP/1.0 request; the look-alike
 *  names Content_Length and Transfer_Encoding (some backends map the underscore to a hyphen); and, whatever the header is
 *  named, whitespace before its colon or a folded line (RFC 9112 5.1, 6.1, 6.3). A refused request is a 400 on purpose,
 *  not a 501 for a coding this server does not know: it closes the connection either way. */
fun httpRequestFraming(request: HttpRequest, http10: bool, maximumBody: int): int {
    var length = 0
    var lengths = 0
    var first = ""
    var transfers = 0
    var hosts = 0
    for (header in request.headers) {
        val name = header.name
        val size = name.size
        if (size == 0) return -1
        val leading = name[0]
        val trailing = name[size - 1]
        if (leading == 32 || leading == 9 || trailing == 32 || trailing == 9) return -1
        if (size == 14) {
            if (httpAsciiEqualInsensitive(name, "Content-Length")) {
                lengths = lengths + 1
                if (lengths == 1) {
                    first = header.value
                    length = httpDecimalLength(first, maximumBody)
                    if (length < 0) return -1
                } else if (header.value != first) return -1
            }
            else if (httpAsciiEqualInsensitive(name, "Content_Length")) return -1
        } else if (size == 4) {
            // RFC 9112 3.2: more than one Host line, or a Host value that is not a host (a space, a comma or a control byte in it), is refused:
            // the application and a proxy in front of it could read different hosts. A missing Host is allowed (see docs/http.md).
            if (httpNameIsHost(name)) {
                hosts = hosts + 1
                if (hosts > 1 || !httpHostValueValid(header.value)) return -1
            }
        } else if (size == 17) {
            if (httpAsciiEqualInsensitive(name, "Transfer-Encoding")) {
                transfers = transfers + 1
                if (transfers > 1 || !httpTransferIsChunkedOnly(header.value)) return -1
            } else if (httpAsciiEqualInsensitive(name, "Transfer_Encoding")) return -1
        }
    }
    if (transfers > 0 && (lengths > 0 || http10)) return -1
    if (transfers > 0) -2 else length
}

// Whether a 4-byte header name is Host in any case (httpAsciiEqualInsensitive's answer): every request names one, and the
// general comparison costs a string-data call per side. A byte or'ed with 32 is h, o, s, t only for that letter in either case.
private trusted fun httpNameIsHost(name: string): bool {
    if (name.size != 4) return false
    // No call below allocates while the address is held.
    val data = ablaUnsafeStringAddress(name)
    (ablaUnsafeLoadU8(nativePointerFromAddress(data)) | 32) == 104 &&
        (ablaUnsafeLoadU8(nativePointerFromAddress(data + 1)) | 32) == 111 &&
        (ablaUnsafeLoadU8(nativePointerFromAddress(data + 2)) | 32) == 115 &&
        (ablaUnsafeLoadU8(nativePointerFromAddress(data + 3)) | 32) == 116
}

// Whether a Host value has no space, comma or control byte (an empty value is allowed: an empty authority is a valid uri-host).
// The bytes are read from the string's storage: indexing (value[index]) cost about 14 instructions a byte on every request.
private trusted fun httpHostValueValid(value: string): bool {
    val size = value.size
    if (size == 0) return true
    // No call below allocates while the address is held.
    val data = ablaUnsafeStringAddress(value)
    var index = 0
    while (index < size) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + index))
        if (byte <= 32 || byte == 44 || byte == 127) return false
        index = index + 1
    }
    true
}

/** Why the clients refuse to send a request with these parts, or "" when they may: a method that is not a token, a target with a space or a
 *  control byte, a host that is not a host, a header name that is not a token, or a header value with a control byte other than tab. Each of
 *  these would be written to the wire as it is (a CR LF in a path or a header value from a program's input would start another header or
 *  another request: request splitting); they are what this library's servers refuse. */
fun httpClientRequestError(method: string, target: string, host: string, headers: array<HttpHeader>): string {
    if (method.size == 0) return "the method is empty"
    for (i in 0 until method.size) {
        if (!httpTokenByte(method[i])) return "the method is not a token"
    }
    for (i in 0 until target.size) {
        if (target[i] <= 32 || target[i] == 127) return "the target has a space or a control byte"
    }
    if (!httpHostValueValid(host)) return "the host has a space, a comma or a control byte"
    for (header in headers) {
        if (header.name.size == 0) return "a header name is empty"
        for (i in 0 until header.name.size) {
            if (!httpTokenByte(header.name[i])) return "a header name is not a token"
        }
        for (i in 0 until header.value.size) {
            val byte = header.value[i]
            if ((byte < 32 && byte != 9) || byte == 127) return "a header value has a control byte"
        }
    }
    ""
}

// Reads decimal digits in `value` under the supplied `maximum`. Returns -1 for empty or nondecimal input or when the accumulated length exceeds the bound.
fun httpDecimalLength(value: string, maximum: int): int {
    var result = 0
    var valid = value.size > 0
    var index = 0
    while (index < value.size && valid) {
        val byte = value[index]
        val digitValid = byte >= 48 && byte <= 57
        if (!digitValid) valid = false
        if (digitValid) {
            result = result * 10 + byte - 48
            if (result > maximum) valid = false
        }
        index = index + 1
    }
    if (valid) result else -1
}

private fun httpCoreHexLength(value: string, maximum: int): int {
    var result = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        var digit = -1
        if (byte >= 48 && byte <= 57) digit = byte - 48
        if (byte >= 65 && byte <= 70) digit = byte - 55
        if (byte >= 97 && byte <= 102) digit = byte - 87
        if (digit < 0 || result > (maximum - digit) / 16) valid = false
        else result = result * 16 + digit
        index = index + 1
    }
    if (valid && result <= maximum) result else -1
}

// Returns true if a comma-separated header token matches `wanted` after trimming spaces and tabs and folding ASCII case.
fun httpCoreHeaderTokenContains(value: string, wanted: string): bool {
    var matched = false
    var begin = 0
    var index = 0
    while (!matched && index <= value.size) {
        if (index == value.size || value[index] == 44) {
            var left = begin
            var right = index
            while (left < right && (value[left] == 32 || value[left] == 9)) {
                left = left + 1
            }
            while (right > left &&
                (value[right - 1] == 32 || value[right - 1] == 9)) {
                right = right - 1
            }
            var semicolon = left
            while (semicolon < right && value[semicolon] != 59) {
                semicolon = semicolon + 1
            }
            matched = httpAsciiEqualInsensitive(
                value.slice(left, semicolon), wanted
            )
            begin = index + 1
        }
        index = index + 1
    }
    matched
}

// Whether `input[begin, end)` is what may follow a chunk size on its line: nothing, or extensions `;name`, `;name=token`
// and `;name="quoted string"` (RFC 9112 7.1.1, tabs and spaces allowed after a semicolon). A bare CR, any other control
// byte, an empty name or a value that is neither a token nor a quoted string makes the chunked body malformed: a peer
// that ends the line at a bare CR or LF reads the bytes after it as something else.
fun httpChunkExtensionsValid(input: string, begin: int, end: int): bool {
    var at = begin
    var valid = true
    while (valid && at < end) {
        if (input[at] != 59) {
            valid = false
        } else {
            at = at + 1
            while (at < end && (input[at] == 32 || input[at] == 9)) at = at + 1
            val nameBegin = at
            while (at < end && httpTokenByte(input[at])) at = at + 1
            if (at == nameBegin) valid = false
            else if (at < end && input[at] == 61) {
                at = at + 1
                if (at < end && input[at] == 34) {
                    at = at + 1
                    var closed = false
                    while (valid && !closed) {
                        if (at >= end) {
                            valid = false
                        } else {
                            val byte = input[at]
                            if (byte == 34) {
                                closed = true
                                at = at + 1
                            } else if (byte == 92) {
                                at = at + 1
                                if (at >= end || (input[at] < 32 && input[at] != 9) || input[at] == 127) valid = false
                                else at = at + 1
                            } else if ((byte < 32 && byte != 9) || byte == 127) {
                                valid = false
                            } else {
                                at = at + 1
                            }
                        }
                    }
                } else {
                    val valueBegin = at
                    while (at < end && httpTokenByte(input[at])) at = at + 1
                    if (at == valueBegin) valid = false
                }
            }
        }
    }
    valid
}

// Whether `input[begin, end)` (one line of a chunked body's trailer section, without its CRLF) is a field line a recipient
// may read: a token name, a colon and a value of visible characters, spaces, tabs and bytes over 127. A folded line (one
// that starts with a space or tab), a line without a colon, a control byte, and the fields that frame a message
// (Content-Length, Transfer-Encoding) are not (RFC 9110 6.5.1: they must not be sent in a trailer, and are never applied).
fun httpTrailerLineValid(input: string, begin: int, end: int): bool {
    var at = begin
    while (at < end && httpTokenByte(input[at])) at = at + 1
    var valid = at > begin && at < end && input[at] == 58
    if (valid) {
        val name = input.slice(begin, at)
        if (httpAsciiEqualInsensitive(name, "Content-Length") || httpAsciiEqualInsensitive(name, "Transfer-Encoding")) valid = false
        at = at + 1
        while (valid && at < end) {
            val byte = input[at]
            if ((byte < 32 && byte != 9) || byte == 127) valid = false
            at = at + 1
        }
    }
    valid
}

// Decodes a chunked HTTP body from `input`, limiting decoded data to `maximumBody` bytes. The result includes the body, bytes consumed, and separate flags for valid framing and a complete body.
fun httpCoreDecodeChunked(
    input: string,
    maximumBody: int = 1048576
): HttpCoreChunkDecode {
    var output = ""
    var offset = 0
    var complete = false
    var valid = true
    var resume = -1
    var need = 0
    while (!complete && valid && offset < input.size) {
        val elementStart = offset
        val lineEnd = httpLineEnd(input, offset)
        if (lineEnd >= input.size) {
            offset = input.size
            resume = elementStart
        }
        else {
            var extension = offset
            while (extension < lineEnd && input[extension] != 59) {
                extension = extension + 1
            }
            val length = httpCoreHexLength(
                input.slice(offset, extension), maximumBody - output.size
            )
            if (length < 0 || !httpChunkExtensionsValid(input, extension, lineEnd)) valid = false
            else if (length == 0) {
                var trailerEnd = -1
                var cursor = lineEnd + 2
                while (valid && trailerEnd < 0 && cursor + 1 < input.size) {
                    if (input[cursor] == 13 && input[cursor + 1] == 10) {
                        trailerEnd = cursor + 2
                    } else {
                        val next = httpLineEnd(input, cursor)
                        if (next >= input.size) cursor = input.size
                        else {
                            if (!httpTrailerLineValid(input, cursor, next)) valid = false
                            cursor = next + 2
                        }
                    }
                }
                if (trailerEnd >= 0) {
                    offset = trailerEnd
                    complete = true
                } else {
                    offset = input.size
                    resume = elementStart
                }
            } else {
                val body = lineEnd + 2
                if (body + length + 2 > input.size) {
                    offset = input.size
                    resume = elementStart
                    need = body + length + 2
                }
                else if (input[body + length] != 13 ||
                    input[body + length + 1] != 10) valid = false
                else {
                    output = "$output${input.slice(body, body + length)}"
                    offset = body + length + 2
                }
            }
        }
    }
    HttpCoreChunkDecode(output, offset, complete, valid, if (resume >= 0) resume else offset, need)
}

// Reads request bytes within the supplied bounds and the default deadlines of `httpServeOptions()`, returning empty text for rejected framing or a deadline, or partial bytes when the stream ends early.
fun httpReadRequest(
    connection: TcpConnection,
    maximumHeader: int = 65536,
    maximumBody: int = 1048576
): string {
    val options = httpServeOptions()
    httpReadRequestWithin(connection, HttpServeOptions(options.firstByteTimeoutMilliseconds, options.requestHeadTimeoutMilliseconds, options.requestTimeoutMilliseconds, options.responseTimeoutMilliseconds, maximumHeader, maximumBody)).request
}

// Parses the request line, headers, and available body bytes from `input`, without attaching a peer address. This parser can return partial requests. Use the framing checks when receiving a request from a connection.
fun httpParseRequest(input: string): HttpRequest = httpParseRequestFrom(input, null)

/** `httpParseRequest` with the accepted socket peer set on the request being built, so no copy
 *  of it is made to attach the peer. */
fun httpParseRequestFrom(input: string, peer: SocketPeerAddress?): HttpRequest =
    if (ablaCompileTimeNativeHost()) httpParseRequestNative(input, peer)
    else if (ablaAtCompileTime()) httpParseRequestChecked(input, peer)
    else httpParseRequestNative(input, peer)

private trusted fun httpParseRequestNative(input: string, peer: SocketPeerAddress?): HttpRequest {
    val sourceSize = input.size
    // No call or allocation occurs between this acquisition and the first
    // substring below. Each byte belongs to one request-line phase.
    val sourceData = if (sourceSize > 0) ablaUnsafeStringAddress(input) else 0
    var requestLineEnd = sourceSize
    var firstSpace = -1
    var secondSpace = -1
    var questionAt = -1
    // A control byte (a bare LF, a CR without its LF, any byte under 32) in the request line: a peer may read a
    // different request line (see httpMalformedLineHeader).
    var lineMalformed = false
    var scan = 0
    // Each hot loop has a valid one-byte lookahead; handle a final lone
    // byte separately so partial inputs keep their original semantics.
    val last = sourceSize - 1
    while (scan < last) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
        if (byte < 33) {
            if (byte == 32) {
                firstSpace = scan
                scan = scan + 1
                break
            }
            if (byte == 13 &&
                ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                requestLineEnd = scan
                break
            }
            lineMalformed = true
        }
        scan = scan + 1
    }
    if (firstSpace < 0 && requestLineEnd == sourceSize && scan < sourceSize) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
        if (byte == 32) firstSpace = scan
        else if (byte < 32) lineMalformed = true
        scan = scan + 1
    }
    if (firstSpace >= 0) {
        while (scan < last) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
            if (byte < 33) {
                if (byte == 32) {
                    secondSpace = scan
                    scan = scan + 1
                    break
                }
                if (byte == 13 &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                    requestLineEnd = scan
                    break
                }
                lineMalformed = true
            } else if (byte == 63) {
                questionAt = scan
                scan = scan + 1
                break
            }
            scan = scan + 1
        }
    }
    if (questionAt >= 0 && secondSpace < 0 && requestLineEnd == sourceSize) {
        // Once '?' is found, query bytes need only the space/CRLF tests.
        while (scan < last) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
            if (byte < 33) {
                if (byte == 32) {
                    secondSpace = scan
                    scan = scan + 1
                    break
                }
                if (byte == 13 &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                    requestLineEnd = scan
                    break
                }
                lineMalformed = true
            }
            scan = scan + 1
        }
    }
    if (firstSpace >= 0 && secondSpace < 0 &&
        requestLineEnd == sourceSize && scan < sourceSize) {
        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
        if (byte == 32) secondSpace = scan
        else if (byte == 63 && questionAt < 0) questionAt = scan
        else if (byte < 32) lineMalformed = true
        scan = scan + 1
    }
    if (secondSpace >= 0) {
        // Version contents remain ignored, exactly as in the checked parser; a control byte in them is flagged.
        while (scan < last) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan))
            if (byte < 32) {
                if (byte == 13 &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan + 1)) == 10) {
                    requestLineEnd = scan
                    break
                }
                lineMalformed = true
            }
            scan = scan + 1
        }
        if (requestLineEnd == sourceSize && scan < sourceSize &&
            ablaUnsafeLoadU8(nativePointerFromAddress(sourceData + scan)) < 32) lineMalformed = true
    }
    var method = ""
    var target = "/"
    var question = -1
    if (firstSpace > 0 && secondSpace > firstSpace) {
        method = input.slice(0, firstSpace)
        target = input.slice(firstSpace + 1, secondSpace)
        if (questionAt >= 0) question = questionAt - firstSpace - 1
    }
    var path = target
    var query = ""
    if (question >= 0) {
        path = target.slice(0, question)
        query = target.slice(question + 1, target.size)
    }

    val headers: array<HttpHeader> = []
    if (lineMalformed) headers.append(httpMalformedLineHeader())
    var cursor = requestLineEnd + 2
    var bodyBegin = input.size
    var more = cursor < input.size
    while (more) {
        // Acquire backing storage again after the previous header's allocations.
        // The raw scan ends before any call or header allocation.
        // The table first: its first use may flatten it, an allocation that must not fall after `data` is taken.
        val classes = ablaUnsafeStringAddress(httpNameClasses)
        val data = ablaUnsafeStringAddress(input)
        val size = input.size
        var end = size
        var colon = -1
        // A line end that is not CR LF (a bare LF, or a CR without its LF) inside a line is read as a line end by some
        // peers, and a byte that is not a token character in a name (a space, a control byte, a delimiter, a byte over
        // 127) is skipped or mapped by some: the line is then malformed (see httpMalformedLineHeader).
        var malformed = false
        var scan = cursor
        while (scan < size) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + scan))
            // The class table says at once: 0 a token byte, 1 the colon, 2 a CR, 3 any other byte (not valid in a name).
            val kind = ablaUnsafeLoadU8(nativePointerFromAddress(classes + byte))
            if (kind != 0) {
                if (kind == 1) {
                    colon = scan
                    break
                }
                if (kind == 2 && scan + 1 < size &&
                    ablaUnsafeLoadU8(nativePointerFromAddress(data + scan + 1)) == 10) {
                    end = scan
                    break
                }
                malformed = true
            }
            scan = scan + 1
        }
        var valueBegin = colon + 1
        if (colon >= 0) {
            while (valueBegin < size &&
                ablaUnsafeLoadU8(nativePointerFromAddress(data + valueBegin)) == 32) {
                valueBegin = valueBegin + 1
            }
            // Header values are short: the line end is found by a bounded byte loop here, and
            // by the shared search only past it (the first CRLF at or after the value either way).
            val probeLimit = if (valueBegin + 48 < size) valueBegin + 48 else size
            var probe = valueBegin
            var lineEnd = -1
            while (lineEnd < 0 && probe + 1 < probeLimit) {
                val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + probe))
                if (byte == 13) {
                    val next = ablaUnsafeLoadU8(nativePointerFromAddress(data + probe + 1))
                    if (next == 10) lineEnd = probe
                    else malformed = true
                } else if (byte == 10 || (byte < 32 && byte != 9) || byte == 127) malformed = true
                probe = probe + 1
            }
            end = if (lineEnd >= 0) lineEnd else httpLineEnd(input, probe)
            // Past the window the bytes up to the line end are searched once, only by a long value: a bare LF or CR, or
            // any other control byte but a tab (or DEL), is not a field value byte (RFC 9110 5.5).
            if (lineEnd < 0 && end > probe) {
                if (textFindByte(input, 10, probe, end) >= 0) malformed = true
                else if (textFindByte(input, 13, probe, end) >= 0) malformed = true
                else {
                    var at = probe
                    while (!malformed && at < end) {
                        val byte = ablaUnsafeLoadU8(nativePointerFromAddress(data + at))
                        if ((byte < 32 && byte != 9) || byte == 127) malformed = true
                        at = at + 1
                    }
                }
            }
        }
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
            cursor = cursor
        } else {
            if (colon > cursor) {
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            if (colon <= cursor || malformed) headers.append(httpMalformedLineHeader())
            cursor = end + 2
            if (cursor >= input.size) more = false
            cursor = cursor
        }
    }
    var body = ""
    if (bodyBegin < input.size) body = input.slice(bodyBegin, input.size)
    HttpRequest(method, path, query, headers, body, [], [], peer)
}

// The byte classes of a request head line's name scan: 0 a token byte, 1 the colon, 2 a CR, 3 any other byte.
private trusted fun httpNameClassTable(): string {
    var table = ""
    var byte = 0
    while (byte < 256) {
        val kind = if (byte == 58) 1 else if (byte == 13) 2 else if (httpTokenByte(byte)) 0 else 3
        table = "$table${utf8Encode(kind)}"
        byte = byte + 1
    }
    // Flatten the concatenation here, at initialization. Left to its first use, the flattening is an allocation made inside the
    // allocation region of the first request an event server handles, and the region frees the table at its end: the second
    // request on a connection then read its header lines through garbage (400 for every request after the first).
    ablaUnsafeStringAddress(table)
    table
}

private val httpNameClasses = httpNameClassTable()

/** Whether `byte` may be in a header name: a token character (RFC 9110 5.6.2). */
fun httpTokenByte(byte: int): bool =
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) ||
    byte == 45 || byte == 33 || (byte >= 35 && byte <= 39) || byte == 42 || byte == 43 ||
    byte == 46 || (byte >= 94 && byte <= 96) || byte == 124 || byte == 126

/** What a request head line that no reader can take as a header leaves in `request.headers`: a line without a colon or
 *  with an empty name (a folded line is one), or one with a bare LF or CR in it, a control byte but a tab (or DEL) in its value, or a byte in its name that is not a
 *  token character (RFC 9112 2.2, 5.1, 5.2). The line is
 *  dropped from the parse as before, but this marker (a name that begins with a space, which `httpRequestFraming`
 *  refuses, and an empty value) says it was there, so a request with such a line is refused, not read two ways. */
fun httpMalformedLineHeader(): HttpHeader = HttpHeader(" malformed line", "")

/** Whether `input[begin, end)` has a byte under 32. */
fun httpHasControlByte(input: string, begin: int, end: int): bool {
    var at = begin
    var found = false
    while (!found && at < end) {
        if (input[at] < 32) found = true
        at = at + 1
    }
    found
}

/** Whether the header value in `input[begin, end)` has a control byte other than a tab, or DEL (RFC 9110 5.5). */
fun httpValueHasControl(input: string, begin: int, end: int): bool {
    var at = begin
    var found = false
    while (!found && at < end) {
        val byte = input[at]
        if ((byte < 32 && byte != 9) || byte == 127) found = true
        at = at + 1
    }
    found
}

/** Whether the header name in `input[begin, end)` has a byte that is not a token character. */
fun httpNameHasNonToken(input: string, begin: int, end: int): bool {
    var at = begin
    var found = false
    while (!found && at < end) {
        if (!httpTokenByte(input[at])) found = true
        at = at + 1
    }
    found
}

private fun httpParseRequestChecked(input: string, peer: SocketPeerAddress?): HttpRequest {
    val requestLineEnd = httpLineEnd(input, 0)
    val firstSpace = httpFindByte(input, 32, 0, requestLineEnd)
    val secondSpace = httpFindByte(input, 32, firstSpace + 1, requestLineEnd)
    var method = ""
    var target = "/"
    if (firstSpace > 0 && secondSpace > firstSpace) {
        method = input.slice(0, firstSpace)
        target = input.slice(firstSpace + 1, secondSpace)
    }
    var path = target
    var query = ""
    val question = httpFindByte(target, 63, 0, target.size)
    if (question >= 0) {
        path = target.slice(0, question)
        query = target.slice(question + 1, target.size)
    }

    val headers: array<HttpHeader> = []
    // The same rule as the native scan: no control byte in the request line.
    if (httpHasControlByte(input, 0, requestLineEnd)) headers.append(httpMalformedLineHeader())
    var cursor = requestLineEnd + 2
    var bodyBegin = input.size
    var more = cursor < input.size
    while (more) {
        val end = httpLineEnd(input, cursor)
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
            cursor = cursor
        } else {
            val colon = httpFindByte(input, 58, cursor, end)
            if (colon > cursor) {
                var valueBegin = colon + 1
                while (valueBegin < end && input[valueBegin] == 32) {
                    valueBegin = valueBegin + 1
                }
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            if (colon <= cursor || textFindByte(input, 10, cursor, end) >= 0 ||
                textFindByte(input, 13, cursor, end) >= 0 ||
                httpNameHasNonToken(input, cursor, colon) ||
                httpValueHasControl(input, colon + 1, end)) headers.append(httpMalformedLineHeader())
            cursor = end + 2
            if (cursor >= input.size) more = false
            cursor = cursor
        }
    }
    var body = ""
    if (bodyBegin < input.size) body = input.slice(bodyBegin, input.size)
    HttpRequest(method, path, query, headers, body, [], [], peer)
}

// Returns the last response header matching `name` without regard to ASCII case, or an empty string when absent.
fun HttpResponse.header(name: string): string {
    var result = ""
    var index = 0
    while (index < this.headers.size) {
        if (httpAsciiEqualInsensitive(this.headers[index].name, name)) {
            result = this.headers[index].value
        }
        index = index + 1
    }
    result
}

// Parses the final response from `input` after any interim responses. `responseToHead` suppresses the body and `eof` permits close-delimited completion. `maximumBodyBytes` constrains completion. Check both succeeded and complete before using the response.
fun httpParseResponseBounded(
    input: string,
    maximumBodyBytes: int,
    responseToHead: bool = false,
    eof: bool = true
): HttpClientResult {
    val offset = httpFinalResponseOffset(input)
    httpParseFinalResponseBounded(
        if (offset == 0) input else input.slice(offset, input.size),
        maximumBodyBytes, responseToHead, eof
    )
}

private fun httpParseFinalResponseBounded(
    input: string, maximumBodyBytes: int, responseToHead: bool, eof: bool
): HttpClientResult {
    val statusLineEnd = httpLineEnd(input, 0)
    val firstSpace = httpFindByte(input, 32, 0, statusLineEnd)
    val secondSpace = httpFindByte(input, 32, firstSpace + 1, statusLineEnd)
    var status = 0
    if (firstSpace > 0 && secondSpace > firstSpace + 1) {
        status = httpDecimalLength(
            input.slice(firstSpace + 1, secondSpace),
            999
        )
    }

    val headers: array<HttpHeader> = []
    var cursor = statusLineEnd + 2
    var bodyBegin = input.size + 1
    var more = statusLineEnd < input.size
    while (more) {
        val end = httpLineEnd(input, cursor)
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
        } else if (end >= input.size) {
            more = false
        } else {
            val colon = httpFindByte(input, 58, cursor, end)
            if (colon > cursor) {
                var valueBegin = colon + 1
                while (valueBegin < end && input[valueBegin] == 32) {
                    valueBegin = valueBegin + 1
                }
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            cursor = end + 2
            if (cursor >= input.size) more = false
        }
    }

    var body = ""
    if (bodyBegin <= input.size) body = input.slice(bodyBegin, input.size)
    val provisional = HttpResponse(status, headers, body)
    val encodedLength = provisional.header("Content-Length")
    val transferEncoding = provisional.header("Transfer-Encoding")
    val chunked = httpCoreHeaderTokenContains(transferEncoding, "chunked")
    var complete = status >= 100 && bodyBegin <= input.size
    val noBody = responseToHead || (status >= 100 && status < 200) ||
        status == 204 || status == 304
    if (noBody) body = ""
    else if (chunked) {
        val decoded = httpCoreDecodeChunked(body, maximumBodyBytes)
        complete = complete && decoded.complete && decoded.valid
        body = decoded.body
    } else if (transferEncoding == "" && encodedLength != "") {
        val expected = httpDecimalLength(encodedLength, maximumBodyBytes)
        complete = complete && expected >= 0 && body.size >= expected
        if (expected >= 0 && body.size > expected) {
            body = body.slice(0, expected)
        }
    } else complete = complete && eof && body.size <= maximumBodyBytes
    HttpClientResult(
        HttpResponse(status, headers, body),
        status >= 100,
        complete && !httpResponseLengthsDiffer(headers)
    )
}

// A response with two Content-Lengths that differ has two answers to where its body ends: it is an error, not a
// guess (RFC 9112 6.3), so a reader stops at once and reports it instead of waiting for more. That holds for a HEAD,
// 204 or 304 response too (ambiguous metadata). With a Transfer-Encoding the Content-Length is not used at all, so
// that case needs no check.
fun httpResponseLengthsDiffer(headers: array<HttpHeader>): bool {
    var lengths = 0
    var first = ""
    var ambiguous = false
    for (header in headers) {
        if (header.name.size == 14 && httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            lengths = lengths + 1
            if (lengths == 1) first = header.value
            else if (header.value != first) ambiguous = true
        }
    }
    ambiguous
}

// Parses `input` as a response with a 1 MiB body limit, treating the input as ended. Returns the parsed status, headers and body with success and completeness flags.
fun httpParseResponse(input: string): HttpClientResult =
    httpParseResponseBounded(input, 1048576)

// The transport receives a rendered request; HEAD responses end at headers.
fun httpRequestIsHead(request: string): bool =
    request.size >= 5 && request.slice(0, 5) == "HEAD "

// Creates a client using `authority` for Host and calling `exchange` with serialized request bytes, `maximumResponseBytes`, and `timeoutMilliseconds`. Transport and parse errors are reported by send.
fun httpClient(
    authority: string,
    exchange: (string, int, int) -> HttpTransportResult,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000
): HttpClient = HttpClient(
    authority,
    exchange,
    maximumResponseBytes,
    timeoutMilliseconds
)

// When an exchange of at most `deadlineMilliseconds` must end (0: never).
fun httpExchangeDeadline(deadlineMilliseconds: int): int =
    if (deadlineMilliseconds > 0) linuxMonotonicMilliseconds() + deadlineMilliseconds else 0

// How long the next read or write of an exchange may wait: `timeoutMilliseconds`,
// or what is left before `deadline` when that's shorter, and 0 when none is left.
fun httpExchangeWait(deadline: int, timeoutMilliseconds: int): int {
    if (deadline == 0) return timeoutMilliseconds
    val left = deadline - linuxMonotonicMilliseconds()
    if (left <= 0) 0
    else if (timeoutMilliseconds > 0 && timeoutMilliseconds < left) timeoutMilliseconds
    else left
}

private fun httpExchangeIpv4(
    address: string,
    port: int,
    request: string,
    maximumResponseBytes: int,
    timeoutMilliseconds: int,
    deadlineMilliseconds: int
): HttpTransportResult {
    val deadline = httpExchangeDeadline(deadlineMilliseconds)
    // The connector takes at most ten seconds; a longer timeout is still valid
    // for the exchange. It bounds each read and write, which the socket enforces.
    val connection = tcpConnectIpv4(
        address, port,
        if (timeoutMilliseconds > 10000) 10000 else timeoutMilliseconds
    )
    httpExchangeStream(connection, request, maximumResponseBytes, timeoutMilliseconds, deadline)
}

// Consumes the connected stream, including on failure.
private fun httpExchangeStream(
    var connection: TcpConnection,
    request: string,
    maximumResponseBytes: int,
    timeoutMilliseconds: int,
    deadline: int
): HttpTransportResult {
    var succeeded = connection.descriptor >= 0
    if (succeeded) succeeded = connection.setTimeouts(
        timeoutMilliseconds, timeoutMilliseconds
    )
    var written = 0
    while (succeeded && written < request.size) {
        val wait = httpExchangeWait(deadline, timeoutMilliseconds)
        succeeded = wait > 0 && (deadline == 0 || connection.setTimeouts(wait, wait))
        if (succeeded) {
            val end = if (request.size - written < 65536) request.size else written + 65536
            succeeded = connection.write(request.slice(written, end)) == end - written
            written = end
        }
    }
    var response = ""
    var reading = succeeded
    var eof = false
    while (reading && response.size <= maximumResponseBytes) {
        val remaining = maximumResponseBytes - response.size
        // At the limit, one byte distinguishes EOF from an oversized response.
        val readMaximum = if (remaining == 0) 1 else if (remaining < 65536) remaining else 65536
        val wait = httpExchangeWait(deadline, timeoutMilliseconds)
        succeeded = wait > 0 && (deadline == 0 || connection.setTimeouts(wait, wait))
        reading = succeeded
        if (reading) {
            val read = connection.readResult(readMaximum)
            if (read.status == "error") { succeeded = false; reading = false }
            else if (read.status == "eof") { eof = true; reading = false }
            else if (read.bytes.size > remaining) { succeeded = false; reading = false }
            else response = "$response${read.bytes}"
            // A peer that keeps the connection open has finished at its own framing.
            val parsed = httpParseResponseBounded(response, maximumResponseBytes,
                httpRequestIsHead(request), false)
            val ambiguous = httpResponseLengthsDiffer(parsed.response.headers)
            if (parsed.complete || ambiguous) reading = false
        }
    }
    if (connection.descriptor >= 0) connection.close()
    HttpTransportResult(response, succeeded, eof)
}

// Creates a client sending Host `authority` over IPv4 to `address` and `port`. Caps response bytes at `maximumResponseBytes`, bounds individual waits by `timeoutMilliseconds`, and optionally caps the whole exchange by `deadlineMilliseconds`. Errors are reported by send.
fun httpIpv4Client(
    authority: string,
    address: string,
    port: int,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000,
    // A limit on the whole exchange (0: none). The timeout bounds each read and
    // write, so a peer sending a byte at a time can otherwise hold the caller.
    deadlineMilliseconds: int = 0
): HttpClient = httpClient(
    authority,
    { request: string, maximum: int, timeout: int ->
        httpExchangeIpv4(address, port, request, maximum, timeout, deadlineMilliseconds)
    },
    maximumResponseBytes,
    timeoutMilliseconds
)

// HTTP/1.1 over a local stream, for services such as Docker's API.
fun httpUnixClient(
    authority: string,
    address: UnixSocketAddress,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000,
    deadlineMilliseconds: int = 0
): HttpClient = httpClient(
    authority,
    { request: string, maximum: int, timeout: int ->
        val deadline = httpExchangeDeadline(deadlineMilliseconds)
        val wait = httpExchangeWait(deadline, timeout)
        var local = unixConnect(address, if (wait > 10000) 10000 else wait)
        val stream = TcpConnection(local.descriptor)
        local.descriptor = -1
        httpExchangeStream(stream, request, maximum, timeout, deadline)
    }, maximumResponseBytes, timeoutMilliseconds
)

// Renders `request`, runs the client's transport, and parses the response. Transport failure returns an empty response with status zero and both result flags false.
fun HttpClient.send(request: HttpRequest): HttpClientResult {
    val transport = this.exchange
    val rendered = request.renderForClient(this.authority)
    // A request whose parts can't be sent as they are (httpClientRequestError) is not sent at all.
    if (rendered == "") {
        var target = request.path
        if (request.query != "") target = "$target?${request.query}"
        return HttpClientResult(HttpResponse(0, [], ""), false, false, httpClientRequestError(request.method, target, this.authority, request.headers))
    }
    val exchanged = transport(
        rendered,
        this.maximumResponseBytes,
        this.timeoutMilliseconds
    )
    var result = HttpClientResult(HttpResponse(0, [], ""), false, false)
    if (exchanged.succeeded) result = httpParseResponseBounded(
        exchanged.bytes, this.maximumResponseBytes, request.method == "HEAD", exchanged.eof
    )
    result
}

private fun httpPathParts(path: string): array<string> {
    val parts: array<string> = []
    var begin = 0
    if (path.size > 0 && path[0] == 47) begin = 1
    var index = begin
    while (index <= path.size) {
        if (index == path.size || path[index] == 47) {
            parts.append(path.slice(begin, index))
            begin = index + 1
        }
        index = index + 1
    }
    parts
}

// Matches literal and colon-prefixed path segments and returns any captured parameters with the match result.
fun httpMatchPath(pattern: string, path: string): HttpPathMatch {
    if (pattern == path) HttpPathMatch(true, [], [])
    else {
        val names: array<string> = []
        val values: array<string> = []
        var patternBegin = 0
        var pathBegin = 0
        if (pattern.size > 0 && pattern[0] == 47) patternBegin = 1
        if (path.size > 0 && path[0] == 47) pathBegin = 1
        var matched = true
        var more = true
        while (matched && more) {
            var patternEnd = textFindByte(
                pattern, 47, patternBegin, pattern.size
            )
            var pathEnd = textFindByte(path, 47, pathBegin, path.size)
            if (patternEnd < 0) patternEnd = pattern.size
            if (pathEnd < 0) pathEnd = path.size
            if (patternBegin < patternEnd &&
                pattern[patternBegin] == 58) {
                names.append(pattern.slice(patternBegin + 1, patternEnd))
                values.append(path.slice(pathBegin, pathEnd))
            } else {
                matched = httpCoreRangeEqual(
                    pattern, patternBegin, patternEnd,
                    path, pathBegin, pathEnd
                )
            }
            val patternDone = patternEnd == pattern.size
            val pathDone = pathEnd == path.size
            if (matched && patternDone != pathDone) matched = false
            more = !patternDone && !pathDone
            patternBegin = patternEnd + 1
            pathBegin = pathEnd + 1
        }
        HttpPathMatch(matched, names, values)
    }
}

private fun httpVersionCompare(left: string, right: string): int {
    var result = 0
    var index = 0
    var more = true
    while (index < left.size && index < right.size && more) {
        if (left[index] < right[index]) {
            result = -1
            more = false
        }
        if (left[index] > right[index]) {
            result = 1
            more = false
        }
        index = index + 1
    }
    if (more && left.size < right.size) result = -1
    if (more && left.size > right.size) result = 1
    result
}

// Registers an unversioned GET handler for path `pattern`. Returns this router for chaining.
fun HttpRouter.get(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("GET", pattern, handler)

private fun httpRoutePatternParameterized(pattern: string): bool {
    var parameterized = pattern.size > 0 && pattern[0] == 58
    var index = 1
    while (!parameterized && index < pattern.size) {
        parameterized = pattern[index] == 58 && pattern[index - 1] == 47
        index = index + 1
    }
    parameterized
}

// A collision only admits a route to the full matcher; it cannot change the
// selected route. Keep the fingerprint bounded so checked integer arithmetic
// remains valid for arbitrarily long paths.
private fun httpRouteFingerprint(path: string): int {
    var fingerprint = 5381
    var index = 0
    while (index < path.size) {
        fingerprint = (
            ((fingerprint << 5) + fingerprint) ^ path[index]
        ) & 2147483647
        index = index + 1
    }
    fingerprint
}

private fun httpRoute(
    method: string,
    pattern: string,
    version: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRoute = HttpRoute(
    method,
    pattern,
    version,
    handler
)

// Registers the handler for a method, pattern, and optional version, then returns the same router.
fun HttpRouter.addRoute(
    method: string,
    pattern: string,
    version: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    val route = httpRoute(method, pattern, version, handler)
    val parameterized = httpRoutePatternParameterized(pattern)
    val fingerprint = httpRouteFingerprint(pattern)
    val routeIndex = this.routes.size
    this.routes.append(route)
    this.routeFingerprints.append(fingerprint)
    // Routers constructed through the public two-argument constructor predate
    // the index storage. Keep their registration path valid and let dispatch
    // use its linear compatibility fallback.
    if (this.literalRouteBuckets.size == 64) {
        if (parameterized) {
            this.parameterizedRouteIndexes.append(routeIndex)
        } else {
            val bucket = fingerprint & 63
            this.literalRouteBuckets[bucket].append(routeIndex)
        }
    }
    this.indexedRouteMarkers.append(routeIndex)
    this
}

// Registers `handler` for an unversioned `method` and path `pattern`, then returns the same router for chaining.
fun HttpRouter.route(
    method: string,
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.addRoute(method, pattern, "", handler)
}

// Registers an unversioned POST handler for path `pattern`. Returns this router for chaining.
fun HttpRouter.post(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("POST", pattern, handler)

// Registers an unversioned HEAD handler for path `pattern`. Returns this router for chaining.
fun HttpRouter.head(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("HEAD", pattern, handler)

// Registers an unversioned PUT handler for path `pattern`. Returns this router for chaining.
fun HttpRouter.put(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("PUT", pattern, handler)

// Registers an unversioned PATCH handler for path `pattern`. Returns this router for chaining.
fun HttpRouter.patch(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("PATCH", pattern, handler)

// Registers an unversioned DELETE handler for path `pattern`. Returns this router for chaining.
fun HttpRouter.delete(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("DELETE", pattern, handler)

// Registers an unversioned OPTIONS handler for path `pattern`. Returns this router for chaining.
fun HttpRouter.options(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("OPTIONS", pattern, handler)

// Returns a view of this router that registers handlers under `versionName`.
fun HttpRouter.version(versionName: string): HttpVersionedRouter =
    HttpVersionedRouter(this, versionName)

// Registers a GET handler for path `pattern` under this view's version. Returns the underlying router.
fun HttpVersionedRouter.get(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("GET", pattern, this.version, handler)
}

// Registers a POST handler for path `pattern` under this view's version. Returns the underlying router.
fun HttpVersionedRouter.post(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("POST", pattern, this.version, handler)
}

// Registers a HEAD handler for path `pattern` under this view's version. Returns the underlying router.
fun HttpVersionedRouter.head(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("HEAD", pattern, this.version, handler)
}

// Routes `request` by method, path, and requested version. HEAD can fall back to GET. Passes matched route parameters to the handler and returns its response, or status 404 without a match.
fun HttpRouter.dispatch(request: HttpRequest): HttpResponse {
    val requestedVersion = request.header(this.versionHeader)
    val indexed = this.routes.size > 8 &&
        this.literalRouteBuckets.size == 64 &&
        this.routeFingerprints.size == this.routes.size &&
        this.indexedRouteMarkers.size == this.routes.size
    val requestFingerprint = if (indexed) {
        httpRouteFingerprint(request.path)
    } else 0
    val literalBucket = requestFingerprint & 63
    val literalCandidateCount = if (indexed) {
        this.literalRouteBuckets[literalBucket].size
    } else 0
    var selected = -1
    var selectedVersion = ""
    var selectedMatch = HttpPathMatch(false, [], [])
    var selectedExactMethod = false
    var routePosition = 0
    var literalPosition = 0
    var parameterizedPosition = 0
    var more = if (indexed) {
        literalCandidateCount > 0 || this.parameterizedRouteIndexes.size > 0
    } else this.routes.size > 0
    while (more) {
        var index = routePosition
        var parameterizedCandidate = false
        if (indexed) {
            val literalIndex = if (literalPosition < literalCandidateCount) {
                this.literalRouteBuckets[literalBucket][literalPosition]
            } else this.routes.size
            val parameterizedIndex = if (
                parameterizedPosition < this.parameterizedRouteIndexes.size
            ) {
                this.parameterizedRouteIndexes[parameterizedPosition]
            } else this.routes.size
            if (literalIndex < parameterizedIndex) {
                index = literalIndex
                literalPosition = literalPosition + 1
            } else {
                index = parameterizedIndex
                parameterizedPosition = parameterizedPosition + 1
                parameterizedCandidate = true
            }
        } else {
            routePosition = routePosition + 1
        }
        val route = this.routes[index]
        val exactMethod = route.method == request.method
        val headFallback = request.method == "HEAD" && route.method == "GET"
        val pathCandidate = !indexed || parameterizedCandidate ||
            this.routeFingerprints[index] == requestFingerprint
        if ((exactMethod || headFallback) && pathCandidate) {
            val match = httpMatchPath(route.pattern, request.path)
            var eligible = match.matched
            if (eligible && requestedVersion != "" && route.version != "" &&
                httpVersionCompare(route.version, requestedVersion) > 0) {
                eligible = false
            }
            val versionComparison = httpVersionCompare(
                route.version,
                selectedVersion
            )
            if (eligible && (selected < 0 || versionComparison > 0 ||
                (versionComparison == 0 && exactMethod &&
                    !selectedExactMethod))) {
                selected = index
                selectedVersion = route.version
                selectedMatch = match
                selectedExactMethod = exactMethod
            }
        }
        more = if (indexed) {
            literalPosition < literalCandidateCount ||
                parameterizedPosition < this.parameterizedRouteIndexes.size
        } else routePosition < this.routes.size
    }
    var response = httpText("not found", 404)
    if (selected >= 0) {
        val routed = HttpRequest(
            request.method,
            request.path,
            request.query,
            request.headers,
            request.body,
            selectedMatch.names,
            selectedMatch.values,
            request.peerAddress
        )
        val handler = this.routes[selected].handler
        response = handler(routed)
    }
    response
}

/// Sets the deadlines and bounds of the blocking server (`serveHttp`, `serveHttpOnListener`, `serveHttpOnce`), which reads one connection at a time. In
/// milliseconds, 0 turning a deadline off: `firstByteTimeoutMilliseconds` closes a connection that sends nothing that long after it was accepted (a browser's
/// speculative connection, a probe, an attacker: while a connection waits the server serves no other), `requestHeadTimeoutMilliseconds` one whose request head is
/// not complete that long after its first byte, `requestTimeoutMilliseconds` one whose whole request (head and body) is not complete that long after its first
/// byte, `responseTimeoutMilliseconds` one that does not take the whole response in that time. A connection that runs out of time is closed without an answer.
/// The deadlines bound one connection, not the server: it still serves one connection at a time, so put it behind a proxy that limits connections per address, or use
/// the event server (`abla/http/event`), which reads many connections at once.
class HttpServeOptions(
    val firstByteTimeoutMilliseconds: int = 10000,
    val requestHeadTimeoutMilliseconds: int = 30000,
    val requestTimeoutMilliseconds: int = 120000,
    val responseTimeoutMilliseconds: int = 30000,
    val maximumHeaderBytes: int = 65536,
    val maximumBodyBytes: int = 1048576
)

/// The options `serveHttp` uses: ten seconds to a first byte, thirty to the end of the head, two minutes to the end of the request, thirty to take the response, a
/// 64 KiB head and a 1 MiB body.
fun httpServeOptions(): HttpServeOptions = HttpServeOptions()

/// A request read from a connection (empty when its framing was refused, or when the stream ended before its head), and whether a deadline ended the reading.
class HttpReadOutcome(val request: string, val timedOut: bool)

// How much one read asks for: what is left to read, at most 64 KiB (a read of a socket is limited to 1 MiB).
private fun httpServeReadSize(left: int): int = if (left > 65536) 65536 else if (left < 1) 1 else left

// The shorter of `current` (-1: none yet) and what is left of `limit` since `since` (0: none left); a limit of 0 or less does not apply.
private fun httpServeLeft(current: int, limit: int, since: int, now: int): int {
    if (limit <= 0) return current
    val remaining = since + limit - now
    val left = if (remaining < 1) 0 else remaining
    if (current < 0 || left < current) left else current
}

// How long the connection may wait for its next bytes: what is left before the earliest deadline that applies (0: one has passed), one second when none does.
private fun httpServeWait(options: HttpServeOptions, accepted: int, firstByte: int, headSeen: bool, now: int): int {
    var left = -1
    if (firstByte == 0) left = httpServeLeft(left, options.firstByteTimeoutMilliseconds, accepted, now)
    else {
        if (!headSeen) left = httpServeLeft(left, options.requestHeadTimeoutMilliseconds, firstByte, now)
        left = httpServeLeft(left, options.requestTimeoutMilliseconds, firstByte, now)
    }
    if (left < 0) 1000 else left
}

/// Reads one request from `connection` within the deadlines and bounds of `options`. The head is looked for only in the bytes that arrived since the last read, a
/// body of known length is appended to one buffer, and a chunked body is decoded as its chunks complete (a chunk still arriving is not looked at until all of it has),
/// so the work is proportional to the bytes received, however they are split. The text is empty when the framing is refused, a chunked body is not complete when the
/// stream ends, or a deadline ended the reading; a body of known length that the stream ended early is returned as far as it came.
fun httpReadRequestWithin(connection: TcpConnection, options: HttpServeOptions): HttpReadOutcome {
    val maximumHeader = options.maximumHeaderBytes
    val maximumBody = options.maximumBodyBytes
    val accepted = linuxMonotonicMilliseconds()
    var firstByte = 0
    var timedOut = false
    var ended = false
    val buffer = byteBuffer()
    var tail = ""
    var headerEnd = -1
    while (headerEnd < 0 && !ended && !timedOut && buffer.size() < maximumHeader) {
        val wait = httpServeWait(options, accepted, firstByte, false, linuxMonotonicMilliseconds())
        if (wait == 0) timedOut = true
        else {
            val incoming = connection.readWithTimeoutResult(httpServeReadSize(maximumHeader - buffer.size()), wait)
            if (incoming.hasData()) {
                if (firstByte == 0) {
                    val stamp = linuxMonotonicMilliseconds()
                    firstByte = if (stamp > 0) stamp else 1
                }
                val before = buffer.size()
                buffer.appendText(incoming.bytes)
                val window = "$tail${incoming.bytes}"
                val at = httpHeaderEnd(window)
                if (at >= 0) headerEnd = before - tail.size + at
                tail = window.slice(if (window.size > 3) window.size - 3 else 0, window.size)
            } else if (!incoming.timedOut()) ended = true
        }
    }
    if (timedOut) return HttpReadOutcome("", true)
    var request = buffer.toText()
    if (headerEnd >= 0) {
        val preliminary = httpParseRequest(request)
        val framing = httpRequestFraming(preliminary, false, maximumBody)
        if (framing == -1 || httpRequestLineVersion(request, preliminary, headerEnd) < 0) {
            // Malformed framing or a line that is not a request (an empty or non-token method, no `HTTP/1.x`): nothing of what was
            // read is returned, so the request is refused, as the event servers refuse it.
            request = ""
        } else if (framing == -2) {
            val headText = request.slice(0, headerEnd)
            val decodedBody = byteBuffer()
            var pending = byteBuffer()
            pending.appendText(request.slice(headerEnd, request.size))
            var need = 0
            var complete = false
            var valid = true
            var decodeNow = true
            var received = request.size
            while (valid && !complete && !timedOut && !ended) {
                if (decodeNow) {
                    val text = pending.toText()
                    val decoded = httpCoreDecodeChunked(text, maximumBody - decodedBody.size())
                    if (!decoded.valid) valid = false
                    else {
                        decodedBody.appendText(decoded.body)
                        if (decoded.complete) complete = true
                        else {
                            pending = byteBuffer()
                            pending.appendText(text.slice(decoded.resume, text.size))
                            need = if (decoded.need > 0) decoded.need - decoded.resume else 0
                            // One chunk element (a size line with its extensions, or the trailers) is no longer than a head.
                            if (need == 0 && pending.size() > maximumHeader) valid = false
                        }
                    }
                    decodeNow = false
                }
                if (valid && !complete) {
                    val room = maximumHeader + maximumBody - received
                    val wait = httpServeWait(options, accepted, firstByte, true, linuxMonotonicMilliseconds())
                    if (room < 1) valid = false
                    else if (wait == 0) timedOut = true
                    else {
                        val incoming = connection.readWithTimeoutResult(httpServeReadSize(room), wait)
                        if (incoming.hasData()) {
                            pending.appendText(incoming.bytes)
                            received = received + incoming.bytes.size
                            decodeNow = if (need > 0) pending.size() >= need else httpFindByte(incoming.bytes, 10, 0, incoming.bytes.size) >= 0
                        } else if (!incoming.timedOut()) ended = true
                    }
                }
            }
            request = if (complete && valid && !timedOut) "$headText${decodedBody.toText()}" else ""
        } else {
            val expected = headerEnd + framing
            var received = request.size
            val body = byteBuffer()
            body.appendText(request)
            while (received < expected && !ended && !timedOut) {
                val wait = httpServeWait(options, accepted, firstByte, true, linuxMonotonicMilliseconds())
                if (wait == 0) timedOut = true
                else {
                    val incoming = connection.readWithTimeoutResult(httpServeReadSize(expected - received), wait)
                    if (incoming.hasData()) {
                        body.appendText(incoming.bytes)
                        received = received + incoming.bytes.size
                    } else if (!incoming.timedOut()) ended = true
                }
            }
            request = if (timedOut) "" else body.toText()
        }
    }
    HttpReadOutcome(request, timedOut)
}

// Reads one request from `connection`, answers it through `router` within the response deadline, and returns the bytes written (-1 when the write failed or ran out of
// time); nothing is answered when a deadline ended the reading. The caller closes the connection.
private fun httpServeConnection(router: HttpRouter, connection: TcpConnection, options: HttpServeOptions): int {
    val read = httpReadRequestWithin(connection, options)
    if (read.timedOut) return -1
    val request = httpRequestOriginForm(httpRequestWithPeer(httpParseRequest(read.request), connection.descriptor))
    val response = router.dispatch(request)
    var rendered = response.render()
    if (request.method == "HEAD") rendered = response.renderHead()
    if (options.responseTimeoutMilliseconds > 0) {
        val outcome = connection.writeNetwork(rendered, options.responseTimeoutMilliseconds)
        if (outcome.succeeded()) outcome.written else -1
    } else connection.write(rendered)
}

/// Accepts one connection on `listener`, dispatches through `router` within the deadlines of `options`, writes the response, and closes the connection. Returns the
/// bytes written, or -1 when the response was not written in full.
fun serveHttpOnceWith(router: HttpRouter, var listener: TcpListener, options: HttpServeOptions): int {
    val connection = listener.accept()
    val written = httpServeConnection(router, connection, options)
    connection.close()
    written
}

/// Accepts one connection on `listener`, dispatches through `router`, writes the response, and closes the connection, with the deadlines of `httpServeOptions()`.
fun serveHttpOnce(router: HttpRouter, var listener: TcpListener): int = serveHttpOnceWith(router, listener, httpServeOptions())

/// Listens on `port` and serves requests through `router` with `options` until graceful shutdown. Returns the listener loop's status.
fun serveHttpWith(router: HttpRouter, port: int, options: HttpServeOptions): int {
    val listener = tcpListen(port)
    serveHttpOnListenerWith(router, listener, options)
}

/// Listens on `port` and serves requests through `router`, with the deadlines of `httpServeOptions()`, until graceful shutdown. Returns the listener loop's status.
fun serveHttp(router: HttpRouter, port: int): int = serveHttpWith(router, port, httpServeOptions())

/// Serves requests from `listener` through `router` with `options` until graceful shutdown. Sends only headers on HEAD requests, closes each client and the listener, and returns zero on graceful shutdown.
fun serveHttpOnListenerWith(router: HttpRouter, var listener: TcpListener, options: HttpServeOptions): int {
    tcpEnableGracefulShutdown()
    while (!tcpShutdownRequested()) {
        val connection = listener.acceptUntilShutdown()
        if (connection.descriptor >= 0) {
            httpServeConnection(router, connection, options)
            connection.close()
        }
    }
    listener.close()
    0
}

/// Serves requests from `listener` through `router` with the deadlines of `httpServeOptions()` until graceful shutdown. Sends only headers on HEAD requests, closes each client and the listener, and returns zero on graceful shutdown.
fun serveHttpOnListener(router: HttpRouter, var listener: TcpListener): int = serveHttpOnListenerWith(router, listener, httpServeOptions())

/** The request line must be `method SP target SP HTTP/1.x` and nothing else: returns 1 for HTTP/1.1, 0 for HTTP/1.0
 *  and -1 for anything else, which is refused (a line that is not a request is never routed). The target is an origin
 *  form (`/p`), `*`, or an absolute form (`http://host/p`, which a proxy sends). The parser has already split the
 *  line, so this reads only where the version has to be: after the method, the path and the query. An absolute form must
 *  be `http://` or `https://` with a non-empty authority that is a host (no userinfo, space, comma or control byte):
 *  the servers then use that authority as the host and route by its path (`httpRequestOriginForm`, RFC 9112 3.2.2). */
trusted fun httpRequestLineVersion(
    input: string, request: HttpRequest, headerEnd: int
): int {
    val version = if (ablaCompileTimeNativeHost()) httpLineVersionNative(input, request, headerEnd)
        else if (ablaAtCompileTime()) httpLineVersionChecked(input, request, headerEnd)
        else httpLineVersionNative(input, request, headerEnd)
    if (version >= 0 && !httpAbsoluteTargetValid(request.path)) -1 else version
}

// The authority of an absolute-form target (`scheme://authority/...`, the request's path before any query), or "" for any other form.
// (The origin form, every ordinary request's, is told by its first byte before the path is searched for "://".)
private fun httpAbsoluteAuthority(path: string): string {
    if (path.size == 0 || path[0] == 47 || path[0] == 42) return ""
    val start = path.indexOf("://")
    if (start < 0) return ""
    val rest = path.slice(start + 3, path.size)
    val slash = rest.indexOf("/")
    if (slash < 0) rest else rest.slice(0, slash)
}

// Whether a target that is not an origin form or `*` is an http or https absolute form whose authority is a host.
private fun httpAbsoluteTargetValid(path: string): bool {
    if (path.size == 0 || path[0] == 47 || path[0] == 42) return true
    val start = path.indexOf("://")
    if (start < 0) return false
    val scheme = path.slice(0, start)
    val authority = httpAbsoluteAuthority(path)
    (httpAsciiEqualInsensitive(scheme, "http") || httpAsciiEqualInsensitive(scheme, "https")) && authority.size > 0 && authority.indexOf("@") < 0 && httpHostValueValid(authority)
}

/** RFC 9112 3.2.2: a request whose target is an absolute form (`http://host/p`) is served as `/p` with the target's
 *  authority as its Host (any Host field it sent is replaced), so routes and a Host check see what a proxy routed by.
 *  Any other request is returned as it is. Call it after `httpRequestLineVersion` accepted the line. */
fun httpRequestOriginForm(request: HttpRequest): HttpRequest {
    val authority = httpAbsoluteAuthority(request.path)
    if (authority.size == 0) return request
    val rest = request.path.slice(request.path.indexOf("://") + 3, request.path.size)
    val slash = rest.indexOf("/")
    val path = if (slash < 0) "/" else rest.slice(slash, rest.size)
    val headers: array<HttpHeader> = []
    var placed = false
    for (header in request.headers) {
        if (httpAsciiEqualInsensitive(header.name, "Host")) {
            if (!placed) headers.append(HttpHeader(header.name, authority))
            placed = true
        } else headers.append(header)
    }
    if (!placed) headers.append(HttpHeader("Host", authority))
    HttpRequest(request.method, path, request.query, headers, request.body, request.parameterNames, request.parameterValues, request.peerAddress)
}

private @inline trusted fun httpLineByte(data: int, index: int): int =
    ablaUnsafeLoadU8(nativePointerFromAddress(data + index))

private fun httpLineSchemeChar(byte: int): bool =
    (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
        (byte >= 48 && byte <= 57) || byte == 43 || byte == 45 || byte == 46

// The checked reads, for the compile-time evaluator.
private fun httpLineProtocolChecked(input: string, at: int): bool =
    input[at] == 32 && input[at + 9] == 13 && input[at + 10] == 10 &&
        input[at + 1] == 72 && input[at + 2] == 84 && input[at + 3] == 84 &&
        input[at + 4] == 80 && input[at + 5] == 47 && input[at + 6] == 49 &&
        input[at + 7] == 46 && (input[at + 8] == 48 || input[at + 8] == 49)

private fun httpLineTargetChecked(input: string, first: int, end: int): bool {
    val lead = input[first]
    var accepted = lead == 47 || lead == 42
    if (!accepted && httpLineSchemeChar(lead) && lead > 57) {
        // A scheme, then "://".
        var scan = first + 1
        while (scan < end && httpLineSchemeChar(input[scan])) scan = scan + 1
        accepted = scan + 3 < end && input[scan] == 58 && input[scan + 1] == 47 &&
            input[scan + 2] == 47
    }
    accepted
}

private fun httpLineVersionChecked(
    input: string, request: HttpRequest, headerEnd: int
): int {
    val method = request.method.size
    var after = method + 1 + request.path.size
    var version = -1
    if (method > 0 && request.path.size > 0 && after + 10 <= headerEnd && httpLineMethodToken(input, method) &&
        input[method] == 32) {
        if (input[after] == 63) after = after + 1 + request.query.size
        if (after + 10 <= headerEnd && httpLineProtocolChecked(input, after) &&
            httpLineTargetChecked(input, method + 1, after)) {
            version = if (input[after + 8] == 49) 1 else 0
        }
    }
    version
}

// The same reads through raw loads: a few instructions a request. No allocation between taking the address
// of the input and the last byte read.
private trusted fun httpLineProtocolNative(data: int, at: int): bool =
    httpLineByte(data, at) == 32 && httpLineByte(data, at + 9) == 13 &&
        httpLineByte(data, at + 10) == 10 && httpLineByte(data, at + 1) == 72 &&
        httpLineByte(data, at + 2) == 84 && httpLineByte(data, at + 3) == 84 &&
        httpLineByte(data, at + 4) == 80 && httpLineByte(data, at + 5) == 47 &&
        httpLineByte(data, at + 6) == 49 && httpLineByte(data, at + 7) == 46 &&
        (httpLineByte(data, at + 8) == 48 || httpLineByte(data, at + 8) == 49)

private trusted fun httpLineTargetNative(data: int, first: int, end: int): bool {
    val lead = httpLineByte(data, first)
    var accepted = lead == 47 || lead == 42
    if (!accepted && httpLineSchemeChar(lead) && lead > 57) {
        // A scheme, then "://".
        var scan = first + 1
        while (scan < end && httpLineSchemeChar(httpLineByte(data, scan))) scan = scan + 1
        accepted = scan + 3 < end && httpLineByte(data, scan) == 58 &&
            httpLineByte(data, scan + 1) == 47 && httpLineByte(data, scan + 2) == 47
    }
    accepted
}

private trusted fun httpLineVersionNative(
    input: string, request: HttpRequest, headerEnd: int
): int {
    val data = ablaUnsafeStringAddress(input)
    val method = request.method.size
    var after = method + 1 + request.path.size
    var version = -1
    if (method > 0 && request.path.size > 0 && after + 10 <= headerEnd && httpLineMethodToken(input, method) &&
        httpLineByte(data, method) == 32) {
        if (httpLineByte(data, after) == 63) after = after + 1 + request.query.size
        if (after + 10 <= headerEnd && httpLineProtocolNative(data, after) &&
            httpLineTargetNative(data, method + 1, after)) {
            version = if (httpLineByte(data, after + 8) == 49) 1 else 0
        }
    }
    version
}

// Whether the first `size` bytes of `input` (the method) are all token characters (RFC 9110 9.1: a method is a token).
private fun httpLineMethodToken(input: string, size: int): bool {
    var at = 0
    while (at < size) {
        if (!httpTokenByte(input[at])) return false
        at = at + 1
    }
    true
}
