// A small HTTP/1.1 stack and version-aware router written in Abla. Importing
// this module does not pull in JSON, files, TLS, the compiler, or hot reload.

import "abla/net"
import "abla/text"

class HttpHeader(val name: string, val value: string)

class HttpRequest(
    val method: string,
    val path: string,
    val query: string,
    val headers: array<HttpHeader>,
    val body: string,
    val parameterNames: array<string>,
    val parameterValues: array<string>
)

class HttpResponse(
    val status: int,
    val headers: array<HttpHeader>,
    val body: string
)

// HTTP remains independent of TLS policy. A transport receives already-framed
// request bytes and returns bounded response bytes; TLS modules can implement
// the same callback without changing request, response, or client code.
class HttpTransportResult(
    val bytes: string,
    val succeeded: bool
)

class HttpClientResult(
    val response: HttpResponse,
    val succeeded: bool,
    val complete: bool
)

class HttpCoreChunkDecode(
    val body: string,
    val consumed: int,
    val complete: bool,
    val valid: bool
)

class HttpClient(
    val authority: string,
    val exchange: (string, int, int) -> HttpTransportResult,
    val maximumResponseBytes: int,
    val timeoutMilliseconds: int
)

class HttpPathMatch(
    val matched: bool,
    val names: array<string>,
    val values: array<string>
)

class HttpRoute(
    val method: string,
    val pattern: string,
    val version: string,
    val handler: (HttpRequest) -> HttpResponse
)

class HttpRouter(
    val versionHeader: string,
    val routes: array<HttpRoute>,
    val literalRouteBuckets: array<array<int>> = [],
    val parameterizedRouteIndexes: array<int> = [],
    val routeFingerprints: array<int> = [],
    val indexedRouteMarkers: array<int> = []
)

class HttpVersionedRouter(
    val router: HttpRouter,
    val version: string
)

fun httpRouter(versionHeader: string = "Abla-Version"): HttpRouter {
    val literalRouteBuckets: array<array<int>> = []
    var bucket = 0
    while (bucket < 64) {
        literalRouteBuckets.append([])
        bucket = bucket + 1
    }
    HttpRouter(versionHeader, [], literalRouteBuckets, [], [], [])
}

fun httpAsciiEqualInsensitive(left: string, right: string): bool {
    textAsciiEqualInsensitive(left, right)
}

fun HttpRequest.header(name: string): string {
    var result = ""
    var found = false
    var index = this.headers.size
    // Search backward and stop at the first match. This preserves the existing
    // last-duplicate-wins behavior without scanning the rest of the headers.
    while (!found && index > 0) {
        index = index - 1
        val candidate = this.headers[index]
        val candidateName = candidate.name
        if (httpAsciiEqualInsensitive(candidateName, name)) {
            result = candidate.value
            found = true
        }
    }
    result
}

fun HttpRequest.parameter(name: string): string {
    var result = ""
    var found = false
    var index = this.parameterNames.size
    // Search from the end so duplicate route names retain their existing
    // last-value-wins behavior without traversing earlier entries after a hit.
    while (!found && index > 0) {
        index = index - 1
        val candidateName = this.parameterNames[index]
        val possible = candidateName.size == name.size &&
            (name.size == 0 || candidateName[0] == name[0])
        if (possible && candidateName == name) {
            result = this.parameterValues[index]
            found = true
        }
    }
    var searchBegin = 0
    while (!found && name.size > 0 && searchBegin < this.query.size) {
        val candidate = textFindSequence(
            this.query, name, searchBegin, this.query.size
        )
        if (candidate < 0) searchBegin = this.query.size
        else {
            val valueBegin = candidate + name.size + 1
            val boundary = candidate == 0 || this.query[candidate - 1] == 38
            if (boundary && valueBegin <= this.query.size &&
                this.query[valueBegin - 1] == 61) {
                var fieldEnd = textFindByte(
                    this.query, 38, valueBegin, this.query.size
                )
                if (fieldEnd < 0) fieldEnd = this.query.size
                result = this.query.slice(valueBegin, fieldEnd)
                found = result != ""
            }
            searchBegin = candidate + 1
        }
    }
    var fieldBegin = 0
    while (!found && name.size == 0 && fieldBegin <= this.query.size) {
        var fieldEnd = textFindByte(this.query, 38, fieldBegin, this.query.size)
        if (fieldEnd < 0) fieldEnd = this.query.size
        val equals = textFindByte(this.query, 61, fieldBegin, fieldEnd)
        if (equals == fieldBegin) {
            result = this.query.slice(equals + 1, fieldEnd)
            found = result != ""
        }
        fieldBegin = fieldEnd + 1
    }
    result
}

// Route-only lookup for applications that do not want query fallback.
fun HttpRequest.routeParameter(name: string): string {
    var result = ""
    var found = false
    var index = this.parameterNames.size
    while (!found && index > 0) {
        index = index - 1
        val candidateName = this.parameterNames[index]
        val possible = candidateName.size == name.size &&
            (name.size == 0 || candidateName[0] == name[0])
        if (possible && candidateName == name) {
            result = this.parameterValues[index]
            found = true
        }
    }
    result
}

// Query-only lookup for applications that do not need the combined
// route-precedence convenience of parameter().
fun HttpRequest.queryParameter(name: string): string {
    var result = ""
    var found = false
    var searchBegin = 0
    while (!found && name.size > 0 && searchBegin < this.query.size) {
        val candidate = textFindSequence(
            this.query, name, searchBegin, this.query.size
        )
        if (candidate < 0) searchBegin = this.query.size
        else {
            val valueBegin = candidate + name.size + 1
            val boundary = candidate == 0 || this.query[candidate - 1] == 38
            if (boundary && valueBegin <= this.query.size &&
                this.query[valueBegin - 1] == 61) {
                var fieldEnd = textFindByte(
                    this.query, 38, valueBegin, this.query.size
                )
                if (fieldEnd < 0) fieldEnd = this.query.size
                result = this.query.slice(valueBegin, fieldEnd)
                found = result != ""
            }
            searchBegin = candidate + 1
        }
    }
    var fieldBegin = 0
    while (!found && name.size == 0 && fieldBegin <= this.query.size) {
        var fieldEnd = textFindByte(this.query, 38, fieldBegin, this.query.size)
        if (fieldEnd < 0) fieldEnd = this.query.size
        val equals = textFindByte(this.query, 61, fieldBegin, fieldEnd)
        if (equals == fieldBegin) {
            result = this.query.slice(equals + 1, fieldEnd)
            found = result != ""
        }
        fieldBegin = fieldEnd + 1
    }
    result
}

fun httpCoreRangeEqual(
    left: string,
    leftBegin: int,
    leftEnd: int,
    right: string,
    rightBegin: int,
    rightEnd: int
): bool {
    val leftLength = leftEnd - leftBegin
    val rightLength = rightEnd - rightBegin
    var equal = leftLength == rightLength
    var index = 0
    while (equal && index < leftLength) {
        equal = left[leftBegin + index] == right[rightBegin + index]
        index = index + 1
    }
    equal
}

fun httpRequest(
    method: string,
    path: string,
    body: string = "",
    headers: array<HttpHeader> = []
): HttpRequest = HttpRequest(method, path, "", headers, body, [], [])

fun httpGet(path: string, headers: array<HttpHeader> = []): HttpRequest =
    httpRequest("GET", path, "", headers)

fun httpPost(
    path: string,
    body: string,
    headers: array<HttpHeader> = []
): HttpRequest = httpRequest("POST", path, body, headers)

fun httpText(body: string, status: int = 200): HttpResponse = HttpResponse(
    status,
    [HttpHeader("Content-Type", "text/plain; charset=utf-8")],
    body
)

// Low-level helper for a body which is already valid encoded JSON. Import
// abla/http/json and use httpJsonValue when starting from a Json tree.
fun httpJson(body: string, status: int = 200): HttpResponse = HttpResponse(
    status,
    [HttpHeader("Content-Type", "application/json")],
    body
)

fun httpStatusReason(status: int): string {
    var reason = "Unknown Status"
    if (status == 101) reason = "Switching Protocols"
    if (status == 200) reason = "OK"
    if (status == 201) reason = "Created"
    if (status == 204) reason = "No Content"
    if (status == 302) reason = "Found"
    if (status == 303) reason = "See Other"
    if (status == 400) reason = "Bad Request"
    if (status == 401) reason = "Unauthorized"
    if (status == 403) reason = "Forbidden"
    if (status == 404) reason = "Not Found"
    if (status == 405) reason = "Method Not Allowed"
    if (status == 409) reason = "Conflict"
    if (status == 413) reason = "Payload Too Large"
    if (status == 415) reason = "Unsupported Media Type"
    if (status == 422) reason = "Unprocessable Content"
    if (status == 426) reason = "Upgrade Required"
    if (status == 429) reason = "Too Many Requests"
    if (status == 500) reason = "Internal Server Error"
    if (status == 501) reason = "Not Implemented"
    if (status == 502) reason = "Bad Gateway"
    if (status == 503) reason = "Service Unavailable"
    if (status == 504) reason = "Gateway Timeout"
    reason
}

fun HttpResponse.renderHeaders(): string {
    var output = "HTTP/1.1 ${this.status} ${httpStatusReason(this.status)}\r\n"
    var hasLength = false
    var hasConnection = false
    var index = 0
    while (index < this.headers.size) {
        val header = this.headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            hasLength = true
        }
        if (httpAsciiEqualInsensitive(header.name, "Connection")) {
            hasConnection = true
        }
        output = "$output${header.name}: ${header.value}\r\n"
        index = index + 1
    }
    if (!hasLength && this.status != 101) {
        output = "${output}Content-Length: ${this.body.size}\r\n"
    }
    if (!hasConnection && this.status != 101) {
        output = "${output}Connection: close\r\n"
    }
    output
}

fun HttpResponse.render(): string = "${this.renderHeaders()}\r\n${this.body}"

fun HttpResponse.renderHead(): string = "${this.renderHeaders()}\r\n"

fun HttpRequest.renderForClient(authority: string): string {
    var target = this.path
    if (this.query != "") target = "$target?${this.query}"
    var output = "${this.method} $target HTTP/1.1\r\n"
    var hasHost = false
    var hasLength = false
    var hasConnection = false
    var index = 0
    while (index < this.headers.size) {
        val header = this.headers[index]
        if (httpAsciiEqualInsensitive(header.name, "Host")) hasHost = true
        if (httpAsciiEqualInsensitive(header.name, "Content-Length")) {
            hasLength = true
        }
        if (httpAsciiEqualInsensitive(header.name, "Connection")) {
            hasConnection = true
        }
        output = "$output${header.name}: ${header.value}\r\n"
        index = index + 1
    }
    if (!hasHost) output = "${output}Host: $authority\r\n"
    if (!hasLength) {
        output = "${output}Content-Length: ${this.body.size}\r\n"
    }
    if (!hasConnection) output = "${output}Connection: close\r\n"
    "$output\r\n${this.body}"
}

fun httpLineEnd(input: string, begin: int): int {
    val found = textFindSequence(input, "\r\n", begin, input.size)
    if (found >= 0) found else input.size
}

fun httpFindByte(input: string, byte: int, begin: int, end: int): int {
    textFindByte(input, byte, begin, end)
}

fun httpHeaderEnd(input: string): int {
    val found = textFindSequence(input, "\r\n\r\n", 0, input.size)
    if (found >= 0) found + 4 else -1
}

fun httpDecimalLength(value: string, maximum: int): int {
    var result = 0
    var valid = value.size > 0
    var index = 0
    while (index < value.size && valid) {
        val byte = value[index]
        val digitValid = byte >= 48 && byte <= 57
        if (!digitValid) valid = false
        if (digitValid) {
            result = result * 10 + byte - 48
            if (result > maximum) valid = false
        }
        index = index + 1
    }
    if (valid) result else -1
}

fun httpCoreHexLength(value: string, maximum: int): int {
    var result = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        var digit = -1
        if (byte >= 48 && byte <= 57) digit = byte - 48
        if (byte >= 65 && byte <= 70) digit = byte - 55
        if (byte >= 97 && byte <= 102) digit = byte - 87
        if (digit < 0 || result > (maximum - digit) / 16) valid = false
        else result = result * 16 + digit
        index = index + 1
    }
    if (valid && result <= maximum) result else -1
}

fun httpCoreHeaderTokenContains(value: string, wanted: string): bool {
    var matched = false
    var begin = 0
    var index = 0
    while (!matched && index <= value.size) {
        if (index == value.size || value[index] == 44) {
            var left = begin
            var right = index
            while (left < right && (value[left] == 32 || value[left] == 9)) {
                left = left + 1
            }
            while (right > left &&
                (value[right - 1] == 32 || value[right - 1] == 9)) {
                right = right - 1
            }
            var semicolon = left
            while (semicolon < right && value[semicolon] != 59) {
                semicolon = semicolon + 1
            }
            matched = httpAsciiEqualInsensitive(
                value.slice(left, semicolon), wanted
            )
            begin = index + 1
        }
        index = index + 1
    }
    matched
}

fun httpCoreDecodeChunked(
    input: string,
    maximumBody: int = 1048576
): HttpCoreChunkDecode {
    var output = ""
    var offset = 0
    var complete = false
    var valid = true
    while (!complete && valid && offset < input.size) {
        val lineEnd = httpLineEnd(input, offset)
        if (lineEnd >= input.size) offset = input.size
        else {
            var extension = offset
            while (extension < lineEnd && input[extension] != 59) {
                extension = extension + 1
            }
            val length = httpCoreHexLength(
                input.slice(offset, extension), maximumBody - output.size
            )
            if (length < 0) valid = false
            else if (length == 0) {
                var trailerEnd = -1
                var cursor = lineEnd + 2
                while (trailerEnd < 0 && cursor + 1 < input.size) {
                    if (input[cursor] == 13 && input[cursor + 1] == 10) {
                        trailerEnd = cursor + 2
                    } else {
                        val next = httpLineEnd(input, cursor)
                        if (next >= input.size) cursor = input.size
                        else cursor = next + 2
                    }
                }
                if (trailerEnd >= 0) {
                    offset = trailerEnd
                    complete = true
                } else offset = input.size
            } else {
                val body = lineEnd + 2
                if (body + length + 2 > input.size) offset = input.size
                else if (input[body + length] != 13 ||
                    input[body + length + 1] != 10) valid = false
                else {
                    output = "$output${input.slice(body, body + length)}"
                    offset = body + length + 2
                }
            }
        }
    }
    HttpCoreChunkDecode(output, offset, complete, valid)
}

fun httpReadRequest(
    connection: TcpConnection,
    maximumHeader: int = 65536,
    maximumBody: int = 1048576
): string {
    var input = connection.read(maximumHeader)
    var headerEnd = httpHeaderEnd(input)
    var readingHeaders = headerEnd < 0 && input.size < maximumHeader
    while (readingHeaders) {
        val remaining = maximumHeader - input.size
        val chunk = connection.read(remaining)
        if (chunk.size > 0) input = "$input$chunk"
        headerEnd = httpHeaderEnd(input)
        readingHeaders = headerEnd < 0 && chunk.size > 0 &&
            input.size < maximumHeader
    }

    if (headerEnd >= 0) {
        val preliminary = httpParseRequest(input)
        val encodedLength = preliminary.header("Content-Length")
        val chunked = httpCoreHeaderTokenContains(
            preliminary.header("Transfer-Encoding"), "chunked"
        )
        var contentLength = 0
        if (encodedLength != "") {
            contentLength = httpDecimalLength(encodedLength, maximumBody)
        }
        if (chunked) {
            var decoded = httpCoreDecodeChunked(
                input.slice(headerEnd, input.size), maximumBody
            )
            var readingBody = decoded.valid && !decoded.complete &&
                input.size < maximumHeader + maximumBody
            while (readingBody) {
                val remaining = maximumHeader + maximumBody - input.size
                val chunk = connection.read(remaining)
                if (chunk.size > 0) input = "$input$chunk"
                decoded = httpCoreDecodeChunked(
                    input.slice(headerEnd, input.size), maximumBody
                )
                readingBody = chunk.size > 0 && decoded.valid &&
                    !decoded.complete && input.size < maximumHeader + maximumBody
            }
            if (decoded.complete && decoded.valid) {
                input = "${input.slice(0, headerEnd)}${decoded.body}"
            }
        } else if (contentLength >= 0) {
            val expected = headerEnd + contentLength
            var readingBody = input.size < expected
            while (readingBody) {
                val chunk = connection.read(expected - input.size)
                if (chunk.size > 0) input = "$input$chunk"
                readingBody = chunk.size > 0 && input.size < expected
            }
        }
    }
    input
}

fun httpParseRequest(input: string): HttpRequest {
    val requestLineEnd = httpLineEnd(input, 0)
    val firstSpace = httpFindByte(input, 32, 0, requestLineEnd)
    val secondSpace = httpFindByte(input, 32, firstSpace + 1, requestLineEnd)
    var method = ""
    var target = "/"
    if (firstSpace > 0 && secondSpace > firstSpace) {
        method = input.slice(0, firstSpace)
        target = input.slice(firstSpace + 1, secondSpace)
    }
    var path = target
    var query = ""
    val question = httpFindByte(target, 63, 0, target.size)
    if (question >= 0) {
        path = target.slice(0, question)
        query = target.slice(question + 1, target.size)
    }

    val headers: array<HttpHeader> = []
    var cursor = requestLineEnd + 2
    var bodyBegin = input.size
    var more = cursor < input.size
    while (more) {
        val end = httpLineEnd(input, cursor)
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
            cursor = cursor
        } else {
            val colon = httpFindByte(input, 58, cursor, end)
            if (colon > cursor) {
                var valueBegin = colon + 1
                while (valueBegin < end && input[valueBegin] == 32) {
                    valueBegin = valueBegin + 1
                }
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            cursor = end + 2
            if (cursor >= input.size) more = false
            cursor = cursor
        }
    }
    var body = ""
    if (bodyBegin < input.size) body = input.slice(bodyBegin, input.size)
    HttpRequest(method, path, query, headers, body, [], [])
}

fun HttpResponse.header(name: string): string {
    var result = ""
    var index = 0
    while (index < this.headers.size) {
        if (httpAsciiEqualInsensitive(this.headers[index].name, name)) {
            result = this.headers[index].value
        }
        index = index + 1
    }
    result
}

fun httpParseResponseBounded(
    input: string,
    maximumBodyBytes: int
): HttpClientResult {
    val statusLineEnd = httpLineEnd(input, 0)
    val firstSpace = httpFindByte(input, 32, 0, statusLineEnd)
    val secondSpace = httpFindByte(input, 32, firstSpace + 1, statusLineEnd)
    var status = 0
    if (firstSpace > 0 && secondSpace > firstSpace + 1) {
        status = httpDecimalLength(
            input.slice(firstSpace + 1, secondSpace),
            999
        )
    }

    val headers: array<HttpHeader> = []
    var cursor = statusLineEnd + 2
    var bodyBegin = input.size + 1
    var more = statusLineEnd < input.size
    while (more) {
        val end = httpLineEnd(input, cursor)
        if (end == cursor) {
            bodyBegin = end + 2
            more = false
        } else if (end >= input.size) {
            more = false
        } else {
            val colon = httpFindByte(input, 58, cursor, end)
            if (colon > cursor) {
                var valueBegin = colon + 1
                while (valueBegin < end && input[valueBegin] == 32) {
                    valueBegin = valueBegin + 1
                }
                headers.append(HttpHeader(
                    input.slice(cursor, colon),
                    input.slice(valueBegin, end)
                ))
            }
            cursor = end + 2
            if (cursor >= input.size) more = false
        }
    }

    var body = ""
    if (bodyBegin <= input.size) body = input.slice(bodyBegin, input.size)
    val provisional = HttpResponse(status, headers, body)
    val encodedLength = provisional.header("Content-Length")
    val chunked = httpCoreHeaderTokenContains(
        provisional.header("Transfer-Encoding"), "chunked"
    )
    var complete = status >= 100 && bodyBegin <= input.size
    if (chunked) {
        val decoded = httpCoreDecodeChunked(body, maximumBodyBytes)
        complete = complete && decoded.complete && decoded.valid
        body = decoded.body
    } else if (encodedLength != "") {
        val expected = httpDecimalLength(encodedLength, maximumBodyBytes)
        complete = complete && expected >= 0 && body.size >= expected
        if (expected >= 0 && body.size > expected) {
            body = body.slice(0, expected)
        }
    }
    HttpClientResult(
        HttpResponse(status, headers, body),
        status >= 100,
        complete
    )
}

fun httpParseResponse(input: string): HttpClientResult =
    httpParseResponseBounded(input, 1048576)

fun httpClient(
    authority: string,
    exchange: (string, int, int) -> HttpTransportResult,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000
): HttpClient = HttpClient(
    authority,
    exchange,
    maximumResponseBytes,
    timeoutMilliseconds
)

fun httpExchangeIpv4(
    address: string,
    port: int,
    request: string,
    maximumResponseBytes: int,
    timeoutMilliseconds: int
): HttpTransportResult {
    val connection = tcpConnectIpv4(address, port, timeoutMilliseconds)
    var succeeded = connection.descriptor >= 0
    if (succeeded) succeeded = connection.write(request) == request.size
    var response = ""
    var reading = succeeded
    while (reading && response.size < maximumResponseBytes) {
        val remaining = maximumResponseBytes - response.size
        val readMaximum = if (remaining < 65536) remaining else 65536
        val chunk = connection.readWithTimeout(
            readMaximum,
            timeoutMilliseconds
        )
        if (chunk.size > 0) response = "$response$chunk"
        if (chunk.size == 0) reading = false
    }
    if (connection.descriptor >= 0) connection.close()
    HttpTransportResult(response, succeeded)
}

fun httpIpv4Client(
    authority: string,
    address: string,
    port: int,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000
): HttpClient = httpClient(
    authority,
    { request: string, maximum: int, timeout: int ->
        httpExchangeIpv4(address, port, request, maximum, timeout)
    },
    maximumResponseBytes,
    timeoutMilliseconds
)

fun HttpClient.send(request: HttpRequest): HttpClientResult {
    val transport = this.exchange
    val exchanged = transport(
        request.renderForClient(this.authority),
        this.maximumResponseBytes,
        this.timeoutMilliseconds
    )
    var result = HttpClientResult(HttpResponse(0, [], ""), false, false)
    if (exchanged.succeeded) result = httpParseResponseBounded(
        exchanged.bytes, this.maximumResponseBytes
    )
    result
}

fun httpPathParts(path: string): array<string> {
    val parts: array<string> = []
    var begin = 0
    if (path.size > 0 && path[0] == 47) begin = 1
    var index = begin
    while (index <= path.size) {
        if (index == path.size || path[index] == 47) {
            parts.append(path.slice(begin, index))
            begin = index + 1
        }
        index = index + 1
    }
    parts
}

fun httpMatchPath(pattern: string, path: string): HttpPathMatch {
    if (pattern == path) HttpPathMatch(true, [], [])
    else {
        val names: array<string> = []
        val values: array<string> = []
        var patternBegin = 0
        var pathBegin = 0
        if (pattern.size > 0 && pattern[0] == 47) patternBegin = 1
        if (path.size > 0 && path[0] == 47) pathBegin = 1
        var matched = true
        var more = true
        while (matched && more) {
            var patternEnd = textFindByte(
                pattern, 47, patternBegin, pattern.size
            )
            var pathEnd = textFindByte(path, 47, pathBegin, path.size)
            if (patternEnd < 0) patternEnd = pattern.size
            if (pathEnd < 0) pathEnd = path.size
            if (patternBegin < patternEnd &&
                pattern[patternBegin] == 58) {
                names.append(pattern.slice(patternBegin + 1, patternEnd))
                values.append(path.slice(pathBegin, pathEnd))
            } else {
                matched = httpCoreRangeEqual(
                    pattern, patternBegin, patternEnd,
                    path, pathBegin, pathEnd
                )
            }
            val patternDone = patternEnd == pattern.size
            val pathDone = pathEnd == path.size
            if (matched && patternDone != pathDone) matched = false
            more = !patternDone && !pathDone
            patternBegin = patternEnd + 1
            pathBegin = pathEnd + 1
        }
        HttpPathMatch(matched, names, values)
    }
}

fun httpVersionCompare(left: string, right: string): int {
    var result = 0
    var index = 0
    var more = true
    while (index < left.size && index < right.size && more) {
        if (left[index] < right[index]) {
            result = -1
            more = false
        }
        if (left[index] > right[index]) {
            result = 1
            more = false
        }
        index = index + 1
    }
    if (more && left.size < right.size) result = -1
    if (more && left.size > right.size) result = 1
    result
}

fun HttpRouter.get(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("GET", pattern, handler)

fun httpRoutePatternParameterized(pattern: string): bool {
    var parameterized = pattern.size > 0 && pattern[0] == 58
    var index = 1
    while (!parameterized && index < pattern.size) {
        parameterized = pattern[index] == 58 && pattern[index - 1] == 47
        index = index + 1
    }
    parameterized
}

// A collision only admits a route to the full matcher; it cannot change the
// selected route. Keep the fingerprint bounded so checked integer arithmetic
// remains valid for arbitrarily long paths.
fun httpRouteFingerprint(path: string): int {
    var fingerprint = path.size & 2147483647
    var index = 0
    while (index < path.size) {
        fingerprint = ((fingerprint << 5) ^ path[index]) & 2147483647
        index = index + 1
    }
    fingerprint
}

fun httpRoute(
    method: string,
    pattern: string,
    version: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRoute = HttpRoute(
    method,
    pattern,
    version,
    handler
)

fun HttpRouter.addRoute(
    method: string,
    pattern: string,
    version: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    val route = httpRoute(method, pattern, version, handler)
    val parameterized = httpRoutePatternParameterized(pattern)
    val fingerprint = httpRouteFingerprint(pattern)
    val routeIndex = this.routes.size
    this.routes.append(route)
    this.routeFingerprints.append(fingerprint)
    // Routers constructed through the public two-argument constructor predate
    // the index storage. Keep their registration path valid and let dispatch
    // use its linear compatibility fallback.
    if (this.literalRouteBuckets.size == 64) {
        if (parameterized) {
            this.parameterizedRouteIndexes.append(routeIndex)
        } else {
            val bucket = fingerprint & 63
            this.literalRouteBuckets[bucket].append(routeIndex)
        }
    }
    this.indexedRouteMarkers.append(routeIndex)
    this
}

fun HttpRouter.route(
    method: string,
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.addRoute(method, pattern, "", handler)
}

fun HttpRouter.post(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("POST", pattern, handler)

fun HttpRouter.head(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("HEAD", pattern, handler)

fun HttpRouter.put(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("PUT", pattern, handler)

fun HttpRouter.patch(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("PATCH", pattern, handler)

fun HttpRouter.delete(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("DELETE", pattern, handler)

fun HttpRouter.options(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter = this.route("OPTIONS", pattern, handler)

fun HttpRouter.version(versionName: string): HttpVersionedRouter =
    HttpVersionedRouter(this, versionName)

fun HttpVersionedRouter.get(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("GET", pattern, this.version, handler)
}

fun HttpVersionedRouter.post(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("POST", pattern, this.version, handler)
}

fun HttpVersionedRouter.head(
    pattern: string,
    handler: (HttpRequest) -> HttpResponse
): HttpRouter {
    this.router.addRoute("HEAD", pattern, this.version, handler)
}

fun HttpRouter.dispatch(request: HttpRequest): HttpResponse {
    val requestedVersion = request.header(this.versionHeader)
    val indexed = this.routes.size > 8 &&
        this.literalRouteBuckets.size == 64 &&
        this.routeFingerprints.size == this.routes.size &&
        this.indexedRouteMarkers.size == this.routes.size
    val requestFingerprint = if (indexed) {
        httpRouteFingerprint(request.path)
    } else 0
    val literalBucket = requestFingerprint & 63
    val literalCandidateCount = if (indexed) {
        this.literalRouteBuckets[literalBucket].size
    } else 0
    var selected = -1
    var selectedVersion = ""
    var selectedMatch = HttpPathMatch(false, [], [])
    var selectedExactMethod = false
    var routePosition = 0
    var literalPosition = 0
    var parameterizedPosition = 0
    var more = if (indexed) {
        literalCandidateCount > 0 || this.parameterizedRouteIndexes.size > 0
    } else this.routes.size > 0
    while (more) {
        var index = routePosition
        var parameterizedCandidate = false
        if (indexed) {
            val literalIndex = if (literalPosition < literalCandidateCount) {
                this.literalRouteBuckets[literalBucket][literalPosition]
            } else this.routes.size
            val parameterizedIndex = if (
                parameterizedPosition < this.parameterizedRouteIndexes.size
            ) {
                this.parameterizedRouteIndexes[parameterizedPosition]
            } else this.routes.size
            if (literalIndex < parameterizedIndex) {
                index = literalIndex
                literalPosition = literalPosition + 1
            } else {
                index = parameterizedIndex
                parameterizedPosition = parameterizedPosition + 1
                parameterizedCandidate = true
            }
        } else {
            routePosition = routePosition + 1
        }
        val route = this.routes[index]
        val exactMethod = route.method == request.method
        val headFallback = request.method == "HEAD" && route.method == "GET"
        val pathCandidate = !indexed || parameterizedCandidate ||
            this.routeFingerprints[index] == requestFingerprint
        if ((exactMethod || headFallback) && pathCandidate) {
            val match = httpMatchPath(route.pattern, request.path)
            var eligible = match.matched
            if (eligible && requestedVersion != "" && route.version != "" &&
                httpVersionCompare(route.version, requestedVersion) > 0) {
                eligible = false
            }
            val versionComparison = httpVersionCompare(
                route.version,
                selectedVersion
            )
            if (eligible && (selected < 0 || versionComparison > 0 ||
                (versionComparison == 0 && exactMethod &&
                    !selectedExactMethod))) {
                selected = index
                selectedVersion = route.version
                selectedMatch = match
                selectedExactMethod = exactMethod
            }
        }
        more = if (indexed) {
            literalPosition < literalCandidateCount ||
                parameterizedPosition < this.parameterizedRouteIndexes.size
        } else routePosition < this.routes.size
    }
    var response = httpText("not found", 404)
    if (selected >= 0) {
        val routed = HttpRequest(
            request.method,
            request.path,
            request.query,
            request.headers,
            request.body,
            selectedMatch.names,
            selectedMatch.values
        )
        val handler = this.routes[selected].handler
        response = handler(routed)
    }
    response
}

fun serveHttpOnce(router: HttpRouter, var listener: TcpListener): int {
    val connection = listener.accept()
    val request = httpParseRequest(httpReadRequest(connection))
    val response = router.dispatch(request)
    var rendered = response.render()
    if (request.method == "HEAD") rendered = response.renderHead()
    val written = connection.write(rendered)
    connection.close()
    written
}

fun serveHttp(router: HttpRouter, port: int): int {
    val listener = tcpListen(port)
    serveHttpOnListener(router, listener)
}

fun serveHttpOnListener(router: HttpRouter, var listener: TcpListener): int {
    tcpEnableGracefulShutdown()
    while (!tcpShutdownRequested()) {
        val connection = listener.acceptUntilShutdown()
        if (connection.descriptor >= 0) {
            val request = httpParseRequest(httpReadRequest(connection))
            val response = router.dispatch(request)
            var rendered = response.render()
            if (request.method == "HEAD") rendered = response.renderHead()
            connection.write(rendered)
            connection.close()
        }
    }
    listener.close()
    0
}
