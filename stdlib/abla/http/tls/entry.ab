// HTTPS client transport using the hosted certificate-verified TLS adapter.

import "abla/http"
import "abla/tls/hosted"

private fun httpExchangeTls(
    host: string,
    port: int,
    request: string,
    maximumResponseBytes: int,
    timeoutMilliseconds: int,
    deadlineMilliseconds: int
): HttpTransportResult {
    val deadline = httpExchangeDeadline(deadlineMilliseconds)
    httpExchangeTlsOver(
        tlsConnect(host, port, timeoutMilliseconds, timeoutMilliseconds, deadline),
        request, maximumResponseBytes, timeoutMilliseconds, deadline
    )
}

private fun httpExchangeTlsOver(
    var connection: TlsConnection,
    request: string,
    maximumResponseBytes: int,
    timeoutMilliseconds: int,
    deadline: int
): HttpTransportResult {
    var succeeded = connection.handle != -1
    var written = 0
    while (succeeded && written < request.size) {
        val wait = httpExchangeWait(deadline, timeoutMilliseconds)
        succeeded = wait > 0 && (deadline == 0 || connection.setTimeouts(wait, wait))
        if (succeeded) {
            val end = if (request.size - written < 65536) request.size else written + 65536
            succeeded = connection.write(request.slice(written, end)) == end - written
            written = end
        }
    }
    var response = ""
    var reading = succeeded
    var eof = false
    while (reading && response.size <= maximumResponseBytes) {
        val remaining = maximumResponseBytes - response.size
        val readMaximum = if (remaining == 0) 1 else if (remaining < 65536) remaining else 65536
        val wait = httpExchangeWait(deadline, timeoutMilliseconds)
        succeeded = wait > 0 && (deadline == 0 || connection.setTimeouts(wait, wait))
        reading = succeeded
        if (reading) {
            val chunk = connection.read(readMaximum)
            if (chunk.size > remaining) { succeeded = false; reading = false }
            else if (chunk.size > 0) response = "$response$chunk"
            else {
                succeeded = tlsLastError() == ""
                eof = succeeded
                reading = false
            }
            val parsed = httpParseResponseBounded(response, maximumResponseBytes,
                httpRequestIsHead(request), false)
            val ambiguous = httpResponseLengthsDiffer(parsed.response.headers)
            if (parsed.complete || ambiguous) reading = false
        }
    }
    connection.close()
    HttpTransportResult(response, succeeded, eof)
}

fun httpsClient(
    host: string,
    port: int = 443,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000,
    // A limit on the whole exchange (0: none); see httpIpv4Client.
    deadlineMilliseconds: int = 0
): HttpClient = httpClient(
    if (port == 443) host else "$host:$port",
    { request: string, maximum: int, timeout: int ->
        httpExchangeTls(host, port, request, maximum, timeout, deadlineMilliseconds)
    },
    maximumResponseBytes,
    timeoutMilliseconds
)

// HTTPS clients that present a client certificate (mutual TLS), trusting the CA file
// at caPath if it isn't "". They keep the identity's bytes, and open them for each
// connection: a TlsClientIdentity has one owner, and a client's closure runs many
// times. A bad identity fails each send, and tlsLastError says so.
fun httpsClientWithIdentityPem(
    host: string,
    certificatePem: string,
    keyPem: string,
    passphrase: string = "",
    caPath: string = "",
    port: int = 443,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000,
    deadlineMilliseconds: int = 0
): HttpClient = httpClient(
    if (port == 443) host else "$host:$port",
    { request: string, maximum: int, timeout: int ->
        val deadline = httpExchangeDeadline(deadlineMilliseconds)
        val identity = tlsClientIdentityFromPem(certificatePem, keyPem, passphrase)
        httpExchangeTlsOver(
            tlsConnectWithIdentity(host, identity, caPath, port, timeout, timeout, deadline),
            request, maximum, timeout, deadline
        )
    },
    maximumResponseBytes,
    timeoutMilliseconds
)

fun httpsClientWithIdentityPkcs12(
    host: string,
    der: string,
    password: string,
    caPath: string = "",
    port: int = 443,
    maximumResponseBytes: int = 1048576,
    timeoutMilliseconds: int = 5000,
    deadlineMilliseconds: int = 0
): HttpClient = httpClient(
    if (port == 443) host else "$host:$port",
    { request: string, maximum: int, timeout: int ->
        val deadline = httpExchangeDeadline(deadlineMilliseconds)
        val identity = tlsClientIdentityFromPkcs12(der, password)
        httpExchangeTlsOver(
            tlsConnectWithIdentity(host, identity, caPath, port, timeout, timeout, deadline),
            request, maximum, timeout, deadline
        )
    },
    maximumResponseBytes,
    timeoutMilliseconds
)
