// Private toolchain helper for ablac package. The compiler runs this source
// only for an online index refresh, so TLS stays out of its self-build graph.
import "abla/http"
import "abla/http/tls"
import "abla/sys/linux/io"

fun main(): int {
    // Allow HTTP framing above the catalog parser's 256 KiB limit.
    val client = httpsClient("abla.dev", 443, 272 * 1024, 5000, 20000)
    val result = client.send(httpGet("/packages.toml"))
    if (!result.succeeded || !result.complete) return 1
    val status = result.response.status
    val header = "$status\n"
    val output = if (status == 200) header + result.response.body else header
    if (linuxWriteStandardOutputAll(output)) 0 else 1
}
