// The compiler's front end as a WebAssembly module for a page (#1138): the module graph, parse, semantic analysis and lowering, with no
// LLVM and no native compile-time tier. bootstrapEmitLlvmInstall (LLVM emission, the JIT tiers) and ctNativeOrcInstall (ORC, the
// dynamic loader) are never called here, so no LLVM symbol is reachable from this module: what a native compiler hands to LLVM, this
// hands to browserEmit. The page reads its file system through the host's system-call adapter (the next step).
import "toolchain.ab"
import "parser.ab"
import "backend/llvm/backend.ab"
import "backend/llvm/analysis.ab"
import "backend/wasm/playground.ab"
import "ir.ab"
import "browser_host.ab"
import "module_paths.ab"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "abla/sys/linux"
import "abla/memory"
import "abla/text"

var browserEmitGuest: bool = false

fun browserEmit(program: BootstrapIrProgram, targetTriple: string, requireMain: bool): BootstrapLlvmEmission {
    if (browserEmitGuest) return browserWasmEmit(program)
    var instructions = 0
    for (function in program.functions) instructions = instructions + function.instructions.size
    linuxPrintStandardError("lowered: ${program.functions.size} functions, $instructions instructions\n")
    BootstrapLlvmEmission("", 0, "")
}

fun main: int {
    // The parser recurses on the wasm stack (4 MiB: the toolchain links src/browser_main.ab with it wherever it is built; 1 MiB traps at about 160 nested blocks) and then on
    // the host engine's own stack, which gives out near 450 levels with the release build. The development build (tools/test-browser-frontend.sh) has larger frames and
    // traps near 180 nested parentheses with 4 MiB: the limit is under all of these. tools/playground/frontend-check.mjs checks it on both builds.
    bootstrapParserNestingLimit = 128
    // Collect under pressure during the evaluator's one-shot run. A 24 MiB
    // growth step reduces front-end collections without the larger memory
    // cost measured at 32 MiB. The browser host still caps linear memory.
    memorySetCollectionGrowth(25165824)
    browserEmitGuest = linuxReadFile("/.abla-browser-emit", 4) == "wasm"
    bootstrapEmitProgram = browserEmit
    // The standard library is /stdlib and the working directory is /work (the program's project): no environment names either.
    bootstrapToolchainRootOverride = "/"
    // The program to compile: the path in /work/entry when the page wrote one, else /work/main.ab. A native build of this entry (the
    // debugging harness) takes it from its first argument.
    val named = linuxReadFile("/work/entry").trim()
    var entry = if (named != "") named else "/work/main.ab"
    if (named == "" && linuxArgumentCount() > 0) entry = linuxArgument(0)
    val result = bootstrapCompileHostEmit(entry)
    linuxPrintStandardError("errors=${result.errors} parser=${result.parserErrors} extension=${result.extensionErrors} semantic=${result.semanticErrors} ir=${result.irErrors}\n${result.diagnostics}")
    if (result.errors == 0) 0 else 1
}
