import "analysis_graph.ab"
import "analysis_service.ab"
import "parser.ab"
import "lexer.ab"
import "module_paths.ab"
import "module.ab"
import "ct_tier.ab"
import "abla/json"
import "abla/bytes"
import "abla/text"
import "abla/sys/linux/fs"
import "abla/sys/linux/io"
import "abla/sys/linux/process"

// This is the analysis service's unevaluated module surface. It never loads or
// executes compile-time code, including subparser handlers.
class BootstrapDocumentationModule(val name: string, val files: array<string>)

class BootstrapDocumentationDebt(val path: string, val rows: array<string> = [])

fun BootstrapDocumentationDebt.record(moduleName: string, name: string,
    kind: string, signature: string): void {
    if (this.path == "") return
    val fingerprint = ctContentKey("$kind\n$signature")
    this.rows.append("$moduleName\t$name\t$fingerprint")
}

fun bootstrapDocumentationCollect(path: Path, root: string,
    var modules: array<BootstrapDocumentationModule>): bool {
    if (path.isSymbolicLink()) return true
    if (path.info().isDirectory()) {
        val names: array<string> = []
        for (entry in path.entries()) if (!entry.name().startsWith(".")) names.append(entry.name())
        for (name in sortedStrings(names)) {
            if (!bootstrapDocumentationCollect(path.child(name), root, modules)) return false
        }
    } else if (path.info().isFile() && path.extension() == "ab") {
        var name = path.text.slice(root.size + 1, path.text.size - 3)
        if (name.endsWith("/entry")) name = name.slice(0, name.size - 6)
        var found = false
        for (module in modules) if (module.name == name) {
            module.files.append(path.text)
            found = true
        }
        if (!found) modules.append(BootstrapDocumentationModule(name, [path.text]))
    } else if (!path.info().isFile()) return false
    true
}

fun bootstrapDocumentationFence(text: string): string {
    var fence = "```"
    while (text.indexOf(fence) >= 0) fence = "$fence`"
    fence
}

fun bootstrapDocumentationEntry(var page: ByteBuffer, name: string, kind: string,
    signature: string, documentation: string): void {
    val fence = bootstrapDocumentationFence(signature)
    page.appendText("\n## `$name` ($kind)\n\n${fence}abla\n$signature\n$fence\n")
    if (documentation != "") page.appendText("\n$documentation\n")
}

fun bootstrapDocumentationDeclaration(var page: ByteBuffer, source: string,
    tokens: array<BootstrapToken>, declaration: BootstrapDeclaration, owner: string,
    var counts: array<int>, moduleName: string, var debt: BootstrapDocumentationDebt): void {
    if (declaration.isPrivate || declaration.name.startsWith("__abla_default_")) return
    val signature = bootstrapAnalysisSignature(source, tokens, declaration)
    val offset = bootstrapAnalysisDeclarationBegin(source, tokens, declaration)
    val documentation = bootstrapAnalysisDocumentation(source, offset, 0)
    val prefix = if (owner != "") "$owner." else if (declaration.extensionOwner !=
        "") "${declaration.extensionOwner}." else ""
    val kind = if (owner != "") "method" else if (declaration.extensionOwner !=
        "") "extension ${declaration.kind}" else declaration.kind
    val name = "$prefix${declaration.name}"
    bootstrapDocumentationEntry(page, name, kind, signature, documentation)
    if (documentation == "") debt.record(moduleName, name, kind, signature)
    val bucket = if (documentation != "") 0 else 1
    counts[bucket] = counts[bucket] + 1
    for (method in declaration.methods) bootstrapDocumentationDeclaration(page, source, tokens,
        method,
        name, counts, moduleName, debt)
}

fun bootstrapDocumentationCoverage(name: string, counts: array<int>): Json = $json {
    "module": name,
    "documented": counts[0],
    "undocumented": counts[1],
    "total": counts[0] + counts[1]
}

fun bootstrapDocumentationGenerate(root: string, output: string, debtPath: string): int {
    val modules: array<BootstrapDocumentationModule> = []
    if (!bootstrapDocumentationCollect(Path(root).child("abla"), root, modules)) {
        linuxPrintStandardError("error[E_DOC]: cannot read $root/abla\n")
        return 1
    }
    val coverage: array<Json> = []
    var debt = BootstrapDocumentationDebt(debtPath)
    val totals = [0, 0]
    val index = byteBuffer()
    index
        .appendText("# Standard library reference\n\nGenerated from source by `ablac doc`. Signatures retain source spelling.\n\n| Module | With docs | Without docs |\n|---|---:|---:|\n")
    for (module in modules) {
        val page = byteBuffer()
        page.appendText("# `${module.name}`\n\nGenerated from source.\n")
        var importable = false
        for (file in module.files) if (file.endsWith("/entry.ab")) importable = true
        if (importable) page.appendText("\nImport with `import \"${module.name}\"`.\n")
        else page.appendText("\nSource module; follow its importing module's re-export links.\n")
        val counts = [0, 0]
        for (file in module.files) {
            val source = Path(file).readText()
            val graph = bootstrapAnalysisGraphParse(source, "file://$file", true, file, false)
            if (graph.parsed.errors != 0) {
                linuxPrintStandardError("error[E_DOC]: cannot parse $file\n${graph.parsed.diagnostics}")
                return 1
            }
            page.appendText("\nSource: `${file.slice(root.size + 1, file.size)}`\n")
            for (edge in bootstrapScanImportsWithIdentity(source, file).edges) {
                if (edge.exported && !edge.provider) {
                    var target = edge.source
                    if (target.startsWith(".")) {
                        val relativeSource = file.slice(root.size + 1, file.size)
                        target =
                            bootstrapNormalizeModulePath(Path(relativeSource).parent().child(target)
                                    .text)
                    }
                    if (target.endsWith(".ab")) target = target.slice(0, target.size - 3)
                    if (target.endsWith("/entry")) target = target.slice(0, target.size - 6)
                    var shown = "`${edge.source}`"
                    for (candidate in modules) if (candidate.name == target) {
                        var relative = ""
                        for (part in 1 until module.name.split("/").size) relative = "$relative../"
                        shown = "[`${edge.source}`]($relative$target.md)"
                    }
                    page
                        .appendText("\nRe-exports $shown${if (edge.alias != "") " as `${edge.alias}`" else ""}.\n")
                }
            }
            val tokens = bootstrapLexShared(source)
            for (declaration in graph.parsed.declarations) bootstrapDocumentationDeclaration(page,
                source, tokens, declaration, "", counts, module.name, debt)
            // Registrations are compiler-parsed actions, never text matches or
            // executed handlers. The call itself is the language's signature.
            for (action in graph.parsed.actions) {
                val expression = if (action.kind == "compile" && action.children.size ==
                    1) action.children[0] else action
                if (expression.kind == "call" && expression.text == "compilerRegisterSubparser" &&
                    (expression.children.size == 2 || expression.children.size == 3) &&
                    expression.children[0].kind == "string") {
                    val documentation = bootstrapAnalysisDocumentation(source, action.begin, 0)
                    val name = "$${expression.children[0].text}"
                    val signature = source.slice(action.begin, action.end)
                    bootstrapDocumentationEntry(page, name, "sub-language", signature, documentation)
                    if (documentation == "") debt.record(module.name, name, "sub-language", signature)
                    val bucket = if (documentation != "") 0 else 1
                    counts[bucket] = counts[bucket] + 1
                }
            }
        }
        val destination = Path(output).child("${module.name}.md")
        if (!destination.createParentDirectories() || !destination.writeText(page.toText())) {
            linuxPrintStandardError("error[E_DOC]: cannot write ${destination.text}\n")
            return 1
        }
        index
            .appendText("| [`${module.name}`](${module.name}.md) | ${counts[0]} | ${counts[1]} |\n")
        coverage.append(bootstrapDocumentationCoverage(module.name, counts))
        totals[0] = totals[0] + counts[0]
        totals[1] = totals[1] + counts[1]
        linuxPrintStandardOutput("${module.name}: ${counts[0]} documented, ${counts[1]} undocumented\n")
    }
    val report = $json {
        "schemaVersion": 1,
        "modules": coverage,
        "totals": {
            "documented": totals[0],
            "undocumented": totals[1],
            "total": totals[0] + totals[1]
        }
    }
    if (!Path(output).child("index.md").writeText(index.toText()) ||
        !Path(output).child("coverage.json").writeText("${jsonStringify(report)}\n")) return 1
    if (debtPath != "") {
        val rows = if (debt.rows.size == 0) "" else "${debt.rows.join("\n")}\n"
        if (!Path(debtPath).writeText(rows)) {
            linuxPrintStandardError("error[E_DOC]: cannot write $debtPath\n")
            return 1
        }
    }
    linuxPrintStandardOutput("total: ${totals[0]} documented, ${totals[1]} undocumented\n")
    0
}

fun bootstrapDocumentationCommand(): int {
    var root = bootstrapStandardLibraryRoot()
    var output = "build/docs"
    var debtPath = ""
    var index = 1
    while (index < linuxArgumentCount()) {
        val argument = linuxArgument(index)
        if ((argument == "--stdlib" || argument == "--output" || argument == "--coverage-debt") && index + 1 <
            linuxArgumentCount()) {
            val value = linuxArgument(index + 1)
            if (argument == "--stdlib") root = value
            else if (argument == "--output") output = value
            else debtPath = value
            index = index + 2
        } else {
            linuxPrintStandardError("usage: ablac doc [--stdlib <stdlib-root>] [--output <directory>] [--coverage-debt <file>]\n")
            return 2
        }
    }
    // Remove trailing separators so module identities do not depend on them.
    while (root.endsWith("/") && root.size > 1) root = root.slice(0, root.size - 1)
    bootstrapDocumentationGenerate(root, output, debtPath)
}
