import "abla/unsafe/memory"

// Compile-time evaluation speed: content keys for the JIT object cache (shared
// with `ablac run`, jit_cache.ab) and the tier policy between the interpreter
// and the JIT.

// A 64-bit hash of `text` from `seed` (two seeds give two independent
// fingerprints), as 16 hexadecimal digits: ctHashBytes over its bytes.
fun ctContentHash(text: string, seed: int = -3750763034362895579): string =
    ctHex64(ctHashBytes(text, seed))

// Mixes `text`'s bytes into `hash` eight at a time (a multiply and a shift per
// word, then the tail byte by byte): a compiler image of 5 MB in a few million
// instructions, where indexing the string byte by byte took about 35 per byte.
trusted fun ctHashBytes(text: string, seed: int): int {
    var hash = seed ^ text.size
    val base = nativePointerFromAddress(ablaUnsafeStringAddress(text))
    val words = text.size / 8
    var index = 0
    while (index < words) {
        hash = (hash ^ ablaUnsafeLoadI64(ablaUnsafePointerOffset(base, index * 8))) * 1099511628211
        hash = hash ^ (hash >>> 29)
        index = index + 1
    }
    var offset = words * 8
    while (offset < text.size) {
        hash = (hash ^ ablaUnsafeLoadU8(ablaUnsafePointerOffset(base, offset))) * 1099511628211
        offset = offset + 1
    }
    hash ^ (hash >>> 32)
}

fun ctHex64(value: int): string {
    val digits = "0123456789abcdef"
    var text = ""
    var shift = 60
    while (shift >= 0) {
        val nibble = (value >> shift) & 15
        text = "$text${digits.slice(nibble, nibble + 1)}"
        shift = shift - 4
    }
    text
}

// The fingerprint a cache key records for `text`: its size and two hashes.
fun ctContentKey(text: string): string =
    "${text.size}-${ctContentHash(text)}-${ctContentHash(text, 1469598103934665603 ^ 6148914691236517205)}"
