// Code generation units. A development build's module is optimized whole, as
// before, and then cut into units that child compilers turn into objects at
// once; the objects are combined into the build's one file (a WebAssembly
// object, or an archive of native ones: bootstrapCodegenCombineUnits).
//
// The cut is made after optimization, so inlining and every other module-wide
// decision is the same as for one object; only the code generator runs per
// unit. The parent gives every local function and global a hidden external
// name (bootstrapCodegenUnitPromote: a constant is named after its contents),
// so a unit can reach what another defines, works out the plan
// (bootstrapCodegenUnitPlan) and writes the module once. Unit 0 holds the
// data: every global variable, the module's inline assembly and its `llvm.*`
// arrays. The functions go to the other units by their source file, so an
// edit changes only the units of the files it touches. Each child reads the
// module lazily (function bodies are read when needed), declares what other
// units define (bootstrapCodegenUnitStrip) and moves what is left into a
// module of its own, which reads only its own bodies.
//
// The code generation cache: a unit's object is kept under a key of the
// unit's module itself (its bitcode, with the compiler and LLVM that generate
// it), so a unit nothing changed in is not generated again, by any build of
// any program. Nothing in the cache can be stale: a key names the whole input
// of the code generator.
//
// The number of units is fixed (BOOTSTRAP_CODEGEN_UNITS, or ABLA_CODEGEN_UNITS;
// 1 turns units off), not taken from the machine: the plan, and so the object,
// is the same on every machine. How many children run at once is the
// machine's: ABLA_CODEGEN_JOBS, else the cores, at most one a unit.

import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "abla/platform/host"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/bits"
import "abla/llvm/orc"
import "backend/llvm/bindings.ab"
import "backend/llvm/debug.ab"

noescape extern:"c" fun LLVMGetFirstGlobal(module: i64*): i64*
noescape extern:"c" fun LLVMGetNextGlobal(global: i64*): i64*
noescape extern:"c" fun LLVMGetFirstGlobalAlias(module: i64*): i64*
noescape extern:"c" fun LLVMGetNextGlobalAlias(alias: i64*): i64*
noescape extern:"c" fun LLVMAliasGetAliasee(alias: i64*): i64*
noescape extern:"c" fun LLVMAliasSetAliasee(alias: i64*, aliasee: i64*): void
noescape extern:"c" fun LLVMGlobalClearMetadata(global: i64*): void
noescape extern:"c" fun LLVMDeleteGlobal(global: i64*): void
noescape extern:"c" fun LLVMSetModuleInlineAsm2(module: i64*, assembly: cstring, length: int): void
noescape extern:"c" fun LLVMSetFunctionCallConv(function: i64*, convention: i32): void
noescape extern:"c" fun LLVMGetAttributesAtIndex(function: i64*, index: i32, attributes: i64*): void
noescape extern:"c" fun LLVMIsStringAttribute(attribute: i64*): i32
noescape extern:"c" fun LLVMIsAGlobalValue(value: i64*): i64*
noescape extern:"c" fun LLVMGetModuleContext(module: i64*): i64*
noescape extern:"c" fun LLVMGetBitcodeModuleInContext2(context: i64*, buffer: i64*, module: i64*): i32
noescape extern:"c" fun LLVMLinkModules2(destination: i64*, source: i64*): i32
noescape extern:"c" fun LLVMPrintValueToString(value: i64*): i64*
noescape extern:"c" fun LLVMIsGlobalConstant(global: i64*): i32
noescape extern:"c" fun LLVMGetUnnamedAddress(global: i64*): i32
noescape extern:"c" fun LLVMGetInitializer(global: i64*): i64*
noescape extern:"c" fun LLVMGetAlignment(value: i64*): i32
noescape extern:"c" fun LLVMGetSection(global: i64*): i64*
noescape extern:"c" fun LLVMDIScopeGetFile(scope: i64*): i64*
noescape extern:"c" fun LLVMDIFileGetFilename(file: i64*, length: i64*): i64*
noescape extern:"c" fun LLVMDIFileGetDirectory(file: i64*, length: i64*): i64*

// Units a development build's functions are cut into (ABLA_CODEGEN_UNITS overrides it),
// beside the unit of its data.
val BOOTSTRAP_CODEGEN_UNITS = 8

// The code generation cache's size, in megabytes (ABLA_CODEGEN_CACHE_MB overrides
// it): past it, the oldest objects go.
val BOOTSTRAP_CODEGEN_CACHE_MB = 2048

// Below this many instructions a module is one object: a child compiler costs
// more to start than its share of a small module's code generation.
val BOOTSTRAP_CODEGEN_UNITS_MINIMUM = 150000

/** The value of `text`, one to nine decimal digits, else -1. */
fun bootstrapCodegenDigits(text: string): int {
    if (text.size == 0 || text.size > 9) return -1
    var value = 0
    for (byte in text) {
        if (byte < 48 || byte > 57) return -1
        value = value * 10 + byte - 48
    }
    value
}

/** The decimal value of the environment variable `name`, else `fallback`. */
fun bootstrapCodegenEnvironmentCount(name: string, fallback: int): int {
    val configured = linuxEnvironment(name)
    val value = if (configured.found) bootstrapCodegenDigits(configured.value) else -1
    if (value < 0) fallback else value
}

/** How many units a large development module's functions are cut into; 1 is one object. */
fun bootstrapCodegenUnitCount(): int {
    var units = bootstrapCodegenEnvironmentCount("ABLA_CODEGEN_UNITS", BOOTSTRAP_CODEGEN_UNITS)
    if (units < 1) units = 1
    if (units > 64) units = 64
    units
}

/** The fewest instructions a module needs to be cut (ABLA_CODEGEN_UNITS_MINIMUM). */
fun bootstrapCodegenUnitMinimum(): int =
    bootstrapCodegenEnvironmentCount("ABLA_CODEGEN_UNITS_MINIMUM", BOOTSTRAP_CODEGEN_UNITS_MINIMUM)

/** The machine's cores (`sysctl hw.ncpu` on macOS, `nproc` elsewhere), at least 1. */
fun bootstrapCodegenHostCores(): int {
    val command = if (ablaHostIsMacOS()) {
        val sysctl = linuxCommand("sysctl")
        sysctl.argument("-n")
        sysctl.argument("hw.ncpu")
        sysctl
    } else linuxCommand("nproc")
    var cores = 0
    for (byte in command.captureText()) {
        if (byte >= 48 && byte <= 57) cores = cores * 10 + byte - 48
        else if (cores > 0) return cores
    }
    if (cores < 1) 1 else cores
}

/** How many unit children run at once: ABLA_CODEGEN_JOBS, else the cores, at
 *  most `units`. */
fun bootstrapCodegenJobs(units: int): int {
    var jobs = bootstrapCodegenEnvironmentCount("ABLA_CODEGEN_JOBS", 0)
    if (jobs < 1) jobs = bootstrapCodegenHostCores()
    if (jobs > units) jobs = units
    if (jobs < 1) 1 else jobs
}

/** One step of the hash below: `word` mixed into `hash`. */
fun bootstrapCodegenMix(hash: int, word: int): int {
    var mixed = (hash ^ word) * -7046029254386353131
    mixed = mixed ^ bitShiftRightUnsigned(mixed, 31)
    mixed * -4658895280553007687
}

/** A 64-bit hash of `size` bytes at `address`, from `seed`. */
trusted fun bootstrapCodegenBytesHash(address: i64*, size: int, seed: int): int {
    var hash = bootstrapCodegenMix(seed, size)
    var offset = 0
    while (offset + 8 <= size) {
        hash = bootstrapCodegenMix(hash, ablaUnsafeLoadI64(ablaUnsafePointerOffset(address, offset)))
        offset = offset + 8
    }
    var tail = 0
    var shift = 0
    while (offset < size) {
        tail = tail | bitShiftLeft(ablaUnsafeLoadU8(ablaUnsafePointerOffset(address, offset)), shift)
        shift = shift + 8
        offset = offset + 1
    }
    bootstrapCodegenMix(hash, tail)
}

/** A 64-bit hash of `text`'s bytes, from `seed`. */
fun bootstrapCodegenTextHash(text: string, seed: int): int {
    var hash = bootstrapCodegenMix(seed, text.size)
    for (byte in text) hash = bootstrapCodegenMix(hash, byte)
    hash
}

/** `value` as 16 hexadecimal digits (its 64 bits, unsigned). */
fun bootstrapCodegenHex(value: int): string {
    val digits = "0123456789abcdef"
    var text = ""
    var shift = 60
    while (shift >= 0) {
        val digit = bitAnd(bitShiftRightUnsigned(value, shift), 15)
        text = "$text${digits.slice(digit, digit + 1)}"
        shift = shift - 4
    }
    text
}

/** The instructions of `function`'s body. */
trusted fun bootstrapCodegenFunctionSize(function: i64*): int {
    var count = 0
    var block = LLVMGetFirstBasicBlock(function)
    while (!pointerIsNull(block)) {
        var instruction = LLVMGetFirstInstruction(block)
        while (!pointerIsNull(instruction)) {
            count = count + 1
            instruction = LLVMGetNextInstruction(instruction)
        }
        block = LLVMGetNextBasicBlock(block)
    }
    count
}

/** The instructions of every function `module` defines. */
trusted fun bootstrapCodegenModuleSize(module: i64*): int {
    var total = 0
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == i32(0)) {
            total = total + bootstrapCodegenFunctionSize(function)
        }
        function = LLVMGetNextFunction(function)
    }
    total
}

/** The source file `function`'s debug information names, by the last three
 *  parts of its path (`abla/io/entry.ab`), else "". (Not the whole path: a
 *  WebAssembly module's names the file absolutely, and where the project or
 *  the standard library is doesn't change where a function goes.) */
trusted fun bootstrapCodegenSourceFile(function: i64*): string {
    val subprogram = LLVMGetSubprogram(function)
    if (pointerIsNull(subprogram)) return ""
    val file = LLVMDIScopeGetFile(subprogram)
    if (pointerIsNull(file)) return ""
    val length = nativeByteBuffer(8)
    val name = nativeCString(LLVMDIFileGetFilename(file, length.pointerAt(0)))
    val directory = nativeCString(LLVMDIFileGetDirectory(file, length.pointerAt(0)))
    length.close()
    val path = "$directory/$name"
    var start = path.size
    var parts = 0
    while (start > 0 && parts < 3) {
        start = start - 1
        if (path[start] == 47) parts = parts + 1
    }
    if (parts == 3) path.slice(start + 1, path.size) else path
}

/** Each function `module` defines, in order: its unit, 1 to `units` (unit 0
 *  holds the data). A function goes to the unit of its source file (by a hash
 *  of bootstrapCodegenSourceFile), else of its own name, so where a function
 *  goes depends on nothing an edit elsewhere changes: an edit changes only the
 *  units of the files it touches. (Its line numbers are in its code, so an edit that
 *  moves a function changes its unit too.) */
trusted fun bootstrapCodegenUnitPlan(module: i64*, units: int): array<int> {
    val plan: array<int> = []
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == i32(0)) {
            val file = bootstrapCodegenSourceFile(function)
            val key = if (file != "") file else bootstrapLlvmDebugValueName(function)
            var bucket = bootstrapCodegenTextHash(key, 7) % units
            if (bucket < 0) bucket = bucket + units
            plan.append(bucket + 1)
        }
        function = LLVMGetNextFunction(function)
    }
    plan
}

/** Whether `name` is one of LLVM's own (`llvm.used`, an intrinsic). */
fun bootstrapCodegenLlvmName(name: string): bool =
    name.size >= 5 && name.slice(0, 5) == "llvm."

/** Names every private constant whose address nothing compares
 *  (`unnamed_addr`) after its contents, `__abla_unit.c.<hash>`, and merges the
 *  ones of the same contents into one: a constant's name then doesn't depend
 *  on how many came before it (LLVM numbers names it reuses), so the code that
 *  names it doesn't change when constants elsewhere do. */
trusted fun bootstrapCodegenNameConstants(module: i64*): void {
    // (Contents to the constant kept for them.)
    val kept: Map<string, int> = Map()
    val merged: array<int> = []
    var global = LLVMGetFirstGlobal(module)
    while (!pointerIsNull(global)) {
        if (LLVMIsDeclaration(global) == i32(0) && LLVMGetLinkage(global) == i32(9) &&
            LLVMIsGlobalConstant(global) != i32(0) && LLVMGetUnnamedAddress(global) != i32(0) &&
            !bootstrapCodegenLlvmName(bootstrapLlvmDebugValueName(global))) {
            val printed = LLVMPrintValueToString(LLVMGetInitializer(global))
            val section = LLVMGetSection(global)
            val key = "${int(LLVMGetAlignment(global))} ${if (pointerIsNull(section)) "" else nativeCString(section)} ${nativeCString(printed)}"
            LLVMDisposeMessage(printed)
            val found = kept.get(key)
            if (found != null) {
                merged.append(nativePointerAddress(global))
                merged.append(found)
            } else {
                kept.set(key, nativePointerAddress(global))
                // (bootstrapCodegenPromoteValue then gives it the units' prefix.)
                val name = "c.${bootstrapCodegenHex(bootstrapCodegenTextHash(key, 11))}"
                LLVMSetValueName2(global, name, name.size)
            }
        }
        global = LLVMGetNextGlobal(global)
    }
    var pair = 0
    while (pair < merged.size) {
        val duplicate = nativePointerFromAddress(merged[pair])
        LLVMReplaceAllUsesWith(duplicate, nativePointerFromAddress(merged[pair + 1]))
        LLVMDeleteGlobal(duplicate)
        pair = pair + 2
    }
    return
}

/** Gives every function and global variable with local linkage (internal or
 *  private) a hidden external name, `__abla_unit.<name>`, so a unit can name
 *  what another defines. Hidden symbols stay inside the one image the units
 *  are linked into. */
trusted fun bootstrapCodegenUnitPromote(module: i64*): void {
    bootstrapCodegenNameConstants(module)
    var anonymous = 0
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == i32(0)) {
            anonymous = bootstrapCodegenPromoteValue(function, anonymous)
        }
        function = LLVMGetNextFunction(function)
    }
    var global = LLVMGetFirstGlobal(module)
    while (!pointerIsNull(global)) {
        if (LLVMIsDeclaration(global) == i32(0)) {
            anonymous = bootstrapCodegenPromoteValue(global, anonymous)
        }
        global = LLVMGetNextGlobal(global)
    }
    return
}

trusted fun bootstrapCodegenPromoteValue(value: i64*, anonymous: int): int {
    val linkage = LLVMGetLinkage(value)
    if (linkage != llvmInternalLinkage() && linkage != i32(9)) return anonymous
    val name = bootstrapLlvmDebugValueName(value)
    if (bootstrapCodegenLlvmName(name)) return anonymous
    var next = anonymous
    val promoted = if (name == "") {
        next = next + 1
        "__abla_unit.anonymous.$anonymous"
    } else "__abla_unit.$name"
    LLVMSetValueName2(value, promoted, promoted.size)
    LLVMSetLinkage(value, i32(0))
    LLVMSetVisibility(value, llvmHiddenVisibility())
    next
}

/** A declaration standing for `function` (which is then deleted): its name,
 *  type, calling convention, visibility and attributes (not the string ones,
 *  which describe a body). */
trusted fun bootstrapCodegenDeclareFunction(module: i64*, function: i64*): void {
    val name = bootstrapLlvmDebugValueName(function)
    LLVMSetValueName2(function, "", 0)
    val declaration = LLVMAddFunction(module, name, LLVMGlobalGetValueType(function))
    LLVMSetFunctionCallConv(declaration, LLVMGetFunctionCallConv(function))
    LLVMSetVisibility(declaration, LLVMGetVisibility(function))
    var index = -1
    val parameters = int(LLVMCountParams(function))
    while (index <= parameters) {
        val count = int(LLVMGetAttributeCountAtIndex(function, i32(index)))
        if (count > 0) {
            val attributes = nativeByteBuffer(count * 8)
            LLVMGetAttributesAtIndex(function, i32(index), attributes.pointerAt(0))
            var slot = 0
            while (slot < count) {
                val attribute = nativePointerFromAddress(attributes.loadI64(slot * 8))
                if (LLVMIsStringAttribute(attribute) == i32(0)) {
                    LLVMAddAttributeAtIndex(declaration, i32(index), attribute)
                }
                slot = slot + 1
            }
            attributes.close()
        }
        index = index + 1
    }
    LLVMReplaceAllUsesWith(function, declaration)
    LLVMDeleteFunction(function)
    return
}

/** A private function that never returns: what a dropped alias points at. */
trusted fun bootstrapCodegenAliasStub(module: i64*): i64* {
    val context = LLVMGetModuleContext(module)
    val type = LLVMFunctionType(LLVMVoidTypeInContext(context), nativeNullPointer(), i32(0), i32(0))
    val stub = LLVMAddFunction(module, "__abla_unit.dropped", type)
    LLVMSetLinkage(stub, i32(9))
    val builder = LLVMCreateBuilderInContext(context)
    LLVMPositionBuilderAtEnd(builder, LLVMAppendBasicBlockInContext(context, stub, "entry"))
    LLVMBuildUnreachable(builder)
    LLVMDisposeBuilder(builder)
    stub
}

/** Cuts the module read from the parent down to unit `index` of `plan`
 *  (bootstrapCodegenUnitPlan): the functions of other units become
 *  declarations (their bodies, not read yet, never are), and outside unit 0
 *  every global variable is declared, the `llvm.*` arrays and the inline
 *  assembly go, and an alias of something this unit doesn't define is
 *  dropped (its uses name the alias's symbol, which its own unit defines).
 *  False when the plan doesn't fit the module. */
trusted fun bootstrapCodegenUnitStrip(module: i64*, plan: array<int>, index: int): bool {
    // (Addresses: a function's handle stays valid until it is replaced.)
    val others: array<int> = []
    var defined = 0
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == i32(0)) {
            if (defined >= plan.size) return false
            if (plan[defined] != index) others.append(nativePointerAddress(function))
            defined = defined + 1
        }
        function = LLVMGetNextFunction(function)
    }
    if (defined != plan.size) return false
    for (other in others) bootstrapCodegenDeclareFunction(module, nativePointerFromAddress(other))
    if (index != 0) {
        val arrays: array<int> = []
        var global = LLVMGetFirstGlobal(module)
        while (!pointerIsNull(global)) {
            if (bootstrapCodegenLlvmName(bootstrapLlvmDebugValueName(global))) {
                arrays.append(nativePointerAddress(global))
            } else if (LLVMIsDeclaration(global) == i32(0)) {
                LLVMSetInitializer(global, nativeNullPointer())
                LLVMSetLinkage(global, i32(0))
                LLVMGlobalClearMetadata(global)
            }
            global = LLVMGetNextGlobal(global)
        }
        for (array in arrays) LLVMDeleteGlobal(nativePointerFromAddress(array))
        LLVMSetModuleInlineAsm2(module, "", 0)
    }
    var stub = nativeNullPointer()
    var alias = LLVMGetFirstGlobalAlias(module)
    while (!pointerIsNull(alias)) {
        val aliasee = LLVMAliasGetAliasee(alias)
        val target = LLVMIsAGlobalValue(aliasee)
        val kept = if (pointerIsNull(target)) index == 0
            else LLVMIsDeclaration(target) == i32(0)
        if (!kept) {
            val name = bootstrapLlvmDebugValueName(alias)
            val type = LLVMGlobalGetValueType(alias)
            LLVMSetValueName2(alias, "", 0)
            val declaration = if (LLVMGetTypeKind(type) == i32(9))
                LLVMAddFunction(module, name, type)
                else LLVMAddGlobal(module, type, name)
            LLVMSetVisibility(declaration, LLVMGetVisibility(alias))
            LLVMReplaceAllUsesWith(alias, declaration)
            if (pointerIsNull(stub)) stub = bootstrapCodegenAliasStub(module)
            LLVMAliasSetAliasee(alias, stub)
            LLVMSetLinkage(alias, i32(9))
        }
        alias = LLVMGetNextGlobalAlias(alias)
    }
    true
}

/** Starts the unit child `arguments` (this compiler, `--codegen-unit …`): its
 *  process, or 0 when it can't start. */
fun bootstrapCodegenStartUnit(arguments: array<string>): int {
    val child = linuxCommand("/proc/self/exe")
    for (argument in arguments) child.argument(argument)
    val process = child.start().process
    if (process > 0) process else 0
}

/** Runs the unit children, at most `jobs` at once: 0 when every one succeeds,
 *  else the first failure's status (the rest are still waited for). */
fun bootstrapCodegenRunUnits(commands: array<array<string>>, jobs: int): int {
    var status = 0
    var next = 0
    val running: array<int> = []
    while (next < commands.size && running.size < jobs) {
        val process = bootstrapCodegenStartUnit(commands[next])
        if (process == 0 && status == 0) status = 127
        running.append(process)
        next = next + 1
    }
    var active = 0
    for (process in running) if (process > 0) active = active + 1
    while (active > 0) {
        var progressed = false
        var slot = 0
        while (slot < running.size) {
            if (running[slot] > 0) {
                val observed = linuxWaitProcess(running[slot], true)
                if (observed.output != "pending") {
                    progressed = true
                    if (observed.status != 0 && status == 0) status = observed.status
                    running[slot] = 0
                    active = active - 1
                    // After a failure the remaining units are not started.
                    if (status == 0 && next < commands.size) {
                        val process = bootstrapCodegenStartUnit(commands[next])
                        if (process == 0) status = 127
                        else {
                            running[slot] = process
                            active = active + 1
                        }
                        next = next + 1
                    }
                }
            }
            slot = slot + 1
        }
        if (active > 0 && !progressed) linuxSleepMillisecondsChecked(1)
    }
    status
}

/** Combines the unit objects into `objectPath`: a WebAssembly object by a
 *  relocatable link (`wasm-ld -r`, which links their DWARF too); a native one
 *  as an archive of them (`llvm-ar`, without times or owners), which the link
 *  loads whole (`-force_load`). macOS's relocatable link would turn the units'
 *  DWARF into a debug map naming the unit objects' paths; an executable's
 *  debug map names the archive's members instead (`<object>(unit3.o)`), as it
 *  names a one-object build's object, so the archive holds the debug
 *  information and names no directory. Either way the build cache keeps one
 *  file. */
fun bootstrapCodegenCombineUnits(kind: string, parts: array<string>, objectPath: string): int {
    Path(objectPath).remove()
    val combine = if (kind == "native") linuxCommand("llvm-ar") else linuxCommand("wasm-ld")
    if (kind == "native") {
        combine.argument("rcsD")
        combine.argument("--format=darwin")
        combine.argument(objectPath)
    } else combine.argument("-r")
    for (part in parts) combine.argument(part)
    if (kind != "native") {
        combine.argument("-o")
        combine.argument(objectPath)
    }
    combine.run()
}

// Whether this process is the compiler's own driver (orc_main.ab), whose image
// the unit children run (`/proc/self/exe --codegen-unit`). A program that
// embeds the toolchain emits one object.
var bootstrapCodegenUnitsInCompiler = false

/** Whether a fast build cuts `module` into units: the compiler's driver runs,
 *  more than one unit is configured and the module has at least the minimum
 *  instructions. */
fun bootstrapCodegenUnitsFor(module: i64*): bool =
    bootstrapCodegenUnitsInCompiler && bootstrapCodegenUnitCount() > 1 &&
    bootstrapCodegenModuleSize(module) >= bootstrapCodegenUnitMinimum()

// Where a build's units go: `cache`, the code generation cache's directory ("" when
// it is off: ABLA_CODEGEN_CACHE=0), whose keys `salt` (the compiler and LLVM that
// generate the code) joins.
class BootstrapCodegenUnitPlaces(val cache: string, val salt: string)

/** The code generation cache's directory under the build cache `cacheDirectory`,
 *  or "" when it is off (ABLA_CODEGEN_CACHE=0). */
fun bootstrapCodegenCacheDirectory(cacheDirectory: string): string {
    val configured = linuxEnvironment("ABLA_CODEGEN_CACHE")
    if (configured.found && configured.value == "0") "" else "$cacheDirectory/codegen"
}

/** Removes the oldest objects of the code generation cache `cache` while it
 *  holds more than ABLA_CODEGEN_CACHE_MB (default 2048) megabytes, down to
 *  three quarters of that; never one of `used`, this build's. */
fun bootstrapCodegenSweepCache(cache: string, used: array<string>): void {
    val limit = bootstrapCodegenEnvironmentCount("ABLA_CODEGEN_CACHE_MB", BOOTSTRAP_CODEGEN_CACHE_MB) * 1048576
    val names: array<string> = []
    val sizes: array<int> = []
    val times: array<int> = []
    var total = 0
    for (entry in Path(cache).entries()) {
        val info = entry.info()
        if (info.isFile() && entry.extension() == "o") {
            names.append(entry.text)
            sizes.append(info.size)
            times.append(info.revision)
            total = total + info.size
        }
    }
    if (total <= limit) return
    val protected: Map<string, int> = Map()
    for (path in used) protected.set(path, 1)
    // Oldest first, by selection: a sweep is rare and the cache holds a few
    // thousand objects at most.
    val removed: array<bool> = []
    for (name in names) removed.append(false)
    while (total > limit / 4 * 3) {
        var oldest = -1
        var index = 0
        while (index < names.size) {
            if (!removed[index] && !protected.has(names[index]) &&
                (oldest < 0 || times[index] < times[oldest])) oldest = index
            index = index + 1
        }
        if (oldest < 0) return
        removed[oldest] = true
        Path(names[oldest]).remove()
        total = total - sizes[oldest]
    }
    return
}

/** Gives the optimized `module`'s locals hidden external names, writes it as
 *  bitcode for the unit children (`<objectPath>.units.bc`) and its plan
 *  (`<objectPath>.units.plan`, a unit a line): how many functions each unit
 *  has (the data's counts as one), or [] when they can't be written. The
 *  caller then disposes the module, so the children's copies don't add to it,
 *  and calls bootstrapRunCodegenUnits. */
fun bootstrapWriteCodegenUnits(module: i64*, objectPath: string): array<int> {
    bootstrapCodegenUnitPromote(module)
    val units = bootstrapCodegenUnitCount()
    val counts: array<int> = [1]
    while (counts.size <= units) counts.append(0)
    var plan = ""
    for (unit in bootstrapCodegenUnitPlan(module, units)) {
        plan = "$plan$unit\n"
        counts[unit] = counts[unit] + 1
    }
    if (LLVMWriteBitcodeToFile(module, "$objectPath.units.bc") == i32(0) &&
        Path("$objectPath.units.plan").writeText(plan)) counts else []
}

/** The plan bootstrapWriteCodegenUnits wrote to `path`, or [] when it can't
 *  be read. */
fun bootstrapReadCodegenUnitPlan(path: string): array<int> {
    val plan: array<int> = []
    val text = Path(path).readTextResult()
    if (!text.succeeded) return plan
    var value = 0
    for (byte in text.text) {
        if (byte == 10) {
            plan.append(value)
            value = 0
        } else value = value * 10 + byte - 48
    }
    plan
}

/** Copies the file `source` to `destination` (`cp`; a clone where the file
 *  system makes one): its status. */
fun bootstrapCodegenCopy(source: string, destination: string): int {
    val copy = linuxCommand("cp")
    if (ablaHostIsMacOS()) copy.argument("-c")
    copy.argument(source)
    copy.argument(destination)
    copy.run()
}

/** Writes `objectPath` from the bitcode bootstrapWriteCodegenUnits wrote: one
 *  child a unit, the data's and each of functions that has any (`counts`, as
 *  bootstrapWriteCodegenUnits gave them; `kind`: `native`, `wasm` or
 *  `wasm-eh`; `triple` the target), at most bootstrapCodegenJobs at once,
 *  the objects combined into one file (bootstrapCodegenCombineUnits). A child
 *  writes `unit<n>.o` in `<objectPath>.units` (removed after); with the code
 *  generation cache on, it reuses its unit's object from the cache or adds it
 *  there, and the part is a copy of the cache's object: the result is the
 *  bytes of a build without the cache. */
fun bootstrapRunCodegenUnits(
    kind: string,
    triple: string,
    objectPath: string,
    places: BootstrapCodegenUnitPlaces,
    counts: array<int>
): int {
    val units = counts.size - 1
    val bitcodePath = "$objectPath.units.bc"
    val planPath = "$objectPath.units.plan"
    val directory = "$objectPath.units"
    val cached = places.cache != ""
    Path(directory).removeTree()
    var status = if (Path(directory).createDirectories()) 0 else 145
    if (status == 0 && cached && !Path(places.cache).createDirectories()) status = 145
    val parts: array<string> = []
    val commands: array<array<string>> = []
    var unit = 0
    while (unit <= units) {
        if (counts[unit] > 0) {
            val part = "$directory/unit$unit.o"
            parts.append(part)
            commands.append([
                "--codegen-unit", kind, triple, bitcodePath, planPath, "$unit", part,
                places.cache, places.salt
            ])
        }
        unit = unit + 1
    }
    val count = parts.size
    val jobs = bootstrapCodegenJobs(count)
    if (status == 0) status = bootstrapCodegenRunUnits(commands, jobs)
    Path(bitcodePath).remove()
    Path(planPath).remove()
    // A child that used the cache says which object is its unit's
    // (`<part>.path`: the path, then 1 when it was reused).
    // Its object is copied to the part, so what is combined, and an archive's
    // member names, are those of a build without the cache.
    val entries: array<string> = []
    var reused = 0
    var generated = ""
    if (cached) {
        for (part in parts) {
            val said = Path("$part.path").readText()
            val end = said.size - 2
            if (end > 0 && said[end] == 10) {
                val entry = said.slice(0, end)
                entries.append(entry)
                if (said[end + 1] == 49) reused = reused + 1
                else generated = "$generated ${Path(part).name()}"
                if (status == 0 && bootstrapCodegenCopy(entry, part) != 0) status = 145
            } else if (status == 0) status = 145
        }
    }
    // ABLA_CODEGEN_UNITS_TRACE=1 says so on standard error, and which units the
    // cache didn't have.
    val trace = linuxEnvironment("ABLA_CODEGEN_UNITS_TRACE")
    if (trace.found && trace.value == "1") {
        linuxPrintStandardError(
            "codegen units: $units units and the data, $count with code, $jobs at once ($kind), $reused reused\n"
        )
        if (cached && generated != "") linuxPrintStandardError("codegen units generated:$generated\n")
    }
    if (status == 0) status = bootstrapCodegenCombineUnits(kind, parts, objectPath)
    Path(directory).removeTree()
    if (status == 0 && cached) bootstrapCodegenSweepCache(places.cache, entries)
    status
}
