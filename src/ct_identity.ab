// Transient object-identity indexing. Hashes only choose a bucket: equality
// is checked against retained object references, including hash collisions.
// Nothing derived from an address enters journal bytes or graph IDs.
import "eval.ab"
import "abla/runtime/self"
trusted fun bootstrapIdentityHash(value: BootstrapEvalValue): int = __ablaRuntimeMapHash(value)
class BootstrapIdentityMap(
    val buckets: Map<int, int> = Map(),
    val keys: array<BootstrapEvalValue> = [],
    val values: array<int> = [],
    val next: array<int> = []
) {
    fun get(value: BootstrapEvalValue): int? {
        var entry = this.buckets.get(bootstrapIdentityHash(value)) ?? -1
        while (entry >= 0) {
            if (this.keys[entry] == value && this.values[entry] >= 0) return this.values[entry]
            entry = this.next[entry]
        }
        null
    }
    fun set(value: BootstrapEvalValue, stored: int): void {
        val hash = bootstrapIdentityHash(value)
        val head = this.buckets.get(hash) ?? -1
        var entry = head
        while (entry >= 0) {
            if (this.keys[entry] == value) { this.values[entry] = stored; return }
            entry = this.next[entry]
        }
        this.buckets.set(hash, this.keys.size)
        this.keys.append(value); this.values.append(stored); this.next.append(head)
    }
    fun remove(value: BootstrapEvalValue): void {
        var entry = this.buckets.get(bootstrapIdentityHash(value)) ?? -1
        while (entry >= 0) {
            if (this.keys[entry] == value) { this.values[entry] = -1; return }
            entry = this.next[entry]
        }
    }
}
