// The fixed-width vector types (docs/simd.md): a lane type and a lane count whose
// product is 128, 256 or 512 bits. Their names need no declaration, like `u32`.

import "abla/text"

/** The lane type of vector type `type` (`u32` for `u32x4`), or "" if it isn't one. */
fun bootstrapVectorLaneType(type: string): string {
    val size = type.size
    if (size < 4 || size > 6) return ""
    // The first letter of a lane type, and the `x` after it.
    val first = int(type[0])
    if (first != 105 && first != 117 && first != 102) return ""
    val at = if (int(type[2]) == 120) 2 else if (int(type[3]) == 120) 3 else -1
    if (at < 0) return ""
    val lane = type.slice(0, at)
    val bits = bootstrapLaneBits(lane)
    if (bits == 0) return ""
    val count = bootstrapVectorDigits(type.slice(at + 1, size))
    val width = count * bits
    if (width == 128 || width == 256 || width == 512) lane else ""
}

fun bootstrapLaneBits(lane: string): int =
    if (lane == "i8" || lane == "u8") 8
    else if (lane == "i16" || lane == "u16") 16
    else if (lane == "i32" || lane == "u32" || lane == "f32") 32
    else if (lane == "i64" || lane == "u64" || lane == "f64") 64
    else 0

fun bootstrapVectorDigits(text: string): int {
    var value = 0
    for (at in 0 until text.size) {
        val digit = int(text[at]) - 48
        if (digit < 0 || digit > 9 || (at == 0 && digit == 0)) return 0
        value = value * 10 + digit
    }
    value
}

fun bootstrapIsVectorType(type: string): bool = bootstrapVectorLaneType(type) != ""

fun bootstrapVectorLaneCount(type: string): int {
    val lane = bootstrapVectorLaneType(type)
    if (lane == "") 0 else bootstrapVectorDigits(type.slice(lane.size + 1, type.size))
}

fun bootstrapVectorBits(type: string): int =
    bootstrapLaneBits(bootstrapVectorLaneType(type)) * bootstrapVectorLaneCount(type)

// The secret integers (docs/constant-time.md): `secretU32` is a `u32` to the backend and
// nothing to the rest of the compiler, so no `if`, index, comparison or conversion takes one.

/** The integer type under `type` (`u32` for `secretU32`), or "" if it isn't a secret one. */
fun bootstrapSecretUnderlying(type: string): string =
    if (type == "secretU8") "u8"
    else if (type == "secretU16") "u16"
    else if (type == "secretU32") "u32"
    else if (type == "secretU64") "u64"
    else ""

fun bootstrapIsSecretType(type: string): bool = bootstrapSecretUnderlying(type) != ""

// `uint256` (docs/stdlib/uint256.md): one LLVM i256 in the scalar plan, and like a vector, too
// wide for a slot, so its 32 bytes when boxed. What's done with it is abla/uint256's.

fun bootstrapWideIntBits(type: string): int =
    if (type == "uint256" || type == "int256") 256 else if (type == "uint128" || type ==
        "int128") 128 else 0

/** `uint128`, `int128`, `uint256` and `int256`: an LLVM integer of that width. */
fun bootstrapIsWideIntType(type: string): bool = bootstrapWideIntBits(type) != 0

fun bootstrapWideIntSigned(type: string): bool = type == "int256" || type == "int128"

/** A type wider than a value slot, boxed as a string of its bytes. */
fun bootstrapIsWideValueType(type: string): bool =
    bootstrapIsWideIntType(type) || bootstrapIsVectorType(type)

fun bootstrapWideValueBits(type: string): int =
    if (bootstrapIsWideIntType(type)) bootstrapWideIntBits(type) else bootstrapVectorBits(type)

/** A type the compiler knows by name that isn't one of the language's numbers. */
fun bootstrapIsMachineValueType(type: string): bool =
    bootstrapIsWideValueType(type) || bootstrapIsSecretType(type)

/** The features `@target` names. */
fun bootstrapSimdFeatureKnown(feature: string): bool =
    feature == "aes" || feature == "clmul" || feature == "avx2" ||
    feature == "sse41" || feature == "ssse3" || feature == "avx512f" || feature == "avx512bw"

/** The intrinsics a function can only use under `@target(feature)`: "" for the others. */
fun bootstrapSimdIntrinsicFeature(name: string): string =
    if (name == "aesEncRound" || name == "aesEncLastRound" || name == "aesDecRound" ||
        name == "aesDecLastRound" || name == "aesInvMixColumns") "aes"
    else if (name == "clmul") "clmul"
    else ""

/** The type an `abla<U|I><bits>_op` intrinsic works on (`ablaI128_sdiv`: int128), or "". */
fun bootstrapWideIntrinsicType(name: string): string =
    if (name.startsWith("ablaU256")) "uint256" else if (name.startsWith("ablaI256")) "int256"
    else if (name.startsWith("ablaU128")) "uint128" else if (name
        .startsWith("ablaI128")) "int128" else ""

/** An extern:"intrinsic" lowered by the backend's SIMD file (src/backend/llvm/simd.ab). */
fun bootstrapSimdIntrinsic(name: string): bool =
    name.startsWith("ablaSimd") || name.startsWith("ablaCt") || bootstrapWideIntrinsicType(name) !=
    "" ||
    bootstrapSimdShuffleType(name) != "" ||
    bootstrapSimdIntrinsicFeature(name) != ""

/** The vector type of a shuffle (`u32x4Shuffle`), whose indices are literals; else "". */
fun bootstrapSimdShuffleType(name: string): string {
    if (name.size < 11 || !name.endsWith("Shuffle")) return ""
    val type = name.slice(0, name.size - 7)
    if (bootstrapIsVectorType(type)) type else ""
}

/** Whether `features`, as `@target` wrote them ("aes,clmul"), include `feature`. */
fun bootstrapSimdFeatureListHas(features: string, feature: string): bool {
    for (entry in bootstrapSimdFeatureList(features)) if (entry == feature) return true
    false
}

fun bootstrapSimdFeatureList(features: string): array<string> {
    val result: array<string> = []
    var begin = 0
    for (at in 0 until features.size + 1) {
        if (at == features.size || int(features[at]) == 44) {
            if (at > begin) result.append(features.slice(begin, at))
            begin = at + 1
        }
    }
    result
}

class BootstrapSimdOperation(val operation: string, val type: string, val target: string)

/** Parses the typed SIMD intrinsic grammar shared by LLVM and the evaluator. */
fun bootstrapSimdOperation(name: string): BootstrapSimdOperation? {
    if (!name.startsWith("ablaSimd_")) return null
    var separator = 9
    while (separator < name.size && int(name[separator]) != 95) separator += 1
    if (separator == name.size) return null
    var typeEnd = separator + 1
    while (typeEnd < name.size && int(name[typeEnd]) != 95) typeEnd += 1
    val type = name.slice(separator + 1, typeEnd)
    if (!bootstrapIsVectorType(type)) return null
    val target = if (typeEnd < name.size) name.slice(typeEnd + 1, name.size) else ""
    BootstrapSimdOperation(name.slice(9, separator), type, target)
}

/** The checked and pure SIMD operations that have compile-time semantics. */
fun bootstrapSimdPureIntrinsic(name: string): bool {
    if (bootstrapSimdShuffleType(name) != "") return true
    val parsed = bootstrapSimdOperation(name) ?? return false
    val op = parsed.operation
    op == "make" || op == "splat" || op == "get" || op == "with" ||
        op == "bytes" || op == "fromBytes" || op == "bits" || op == "low" ||
        op == "high" || op == "concat" || op == "swizzle" || op == "swizzle2" ||
        op == "bitmask" || op == "select" || op == "sum" ||
        op == "shl" || op == "shr" || op == "rotl" || op == "rotr" ||
        op == "add" || op == "sub" || op == "mul" || op == "div" ||
        op == "and" || op == "or" || op == "xor" || op == "neg" || op == "not" ||
        op == "min" || op == "max" || op == "abs" || op == "sqrt" ||
        op == "addSat" || op == "subSat" || op == "eq" || op == "ne" ||
        op == "lt" || op == "le" || op == "gt" || op == "ge" ||
        op == "floor" || op == "ceil" || op == "trunc" || op == "roundEven" ||
        op == "convert" || op == "convertLow" || op == "convertHigh" ||
        op == "convertPair" || op == "widenLow" || op == "widenHigh" || op == "narrowSat"
}
