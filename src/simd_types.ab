// The fixed-width vector types (docs/simd.md): a lane type and a lane count whose
// product is 128 or 256 bits. Their names need no declaration, like `u32`.

/** The lane type of vector type `type` (`u32` for `u32x4`), or "" if it isn't one. */
fun bootstrapVectorLaneType(type: string): string {
    val size = type.size
    if (size < 4 || size > 6) return ""
    // The first letter of a lane type, and the `x` after it.
    val first = int(type[0])
    if (first != 105 && first != 117 && first != 102) return ""
    val at = if (int(type[2]) == 120) 2 else if (int(type[3]) == 120) 3 else -1
    if (at < 0) return ""
    val lane = type.slice(0, at)
    val bits = bootstrapLaneBits(lane)
    if (bits == 0) return ""
    val count = bootstrapVectorDigits(type.slice(at + 1, size))
    if (count * bits == 128 || count * bits == 256) lane else ""
}

fun bootstrapLaneBits(lane: string): int =
    if (lane == "i8" || lane == "u8") 8
    else if (lane == "i16" || lane == "u16") 16
    else if (lane == "i32" || lane == "u32" || lane == "f32") 32
    else if (lane == "i64" || lane == "u64" || lane == "f64") 64
    else 0

fun bootstrapVectorDigits(text: string): int {
    var value = 0
    for (at in 0 until text.size) {
        val digit = int(text[at]) - 48
        if (digit < 0 || digit > 9 || (at == 0 && digit == 0)) return 0
        value = value * 10 + digit
    }
    value
}

fun bootstrapIsVectorType(type: string): bool = bootstrapVectorLaneType(type) != ""

fun bootstrapVectorLaneCount(type: string): int {
    val lane = bootstrapVectorLaneType(type)
    if (lane == "") 0 else bootstrapVectorDigits(type.slice(lane.size + 1, type.size))
}

fun bootstrapVectorBits(type: string): int =
    bootstrapLaneBits(bootstrapVectorLaneType(type)) * bootstrapVectorLaneCount(type)

// The secret integers (docs/constant-time.md): `secretU32` is a `u32` to the backend and
// nothing to the rest of the compiler, so no `if`, index, comparison or conversion takes one.

/** The integer type under `type` (`u32` for `secretU32`), or "" if it isn't a secret one. */
fun bootstrapSecretUnderlying(type: string): string =
    if (type == "secretU8") "u8"
    else if (type == "secretU16") "u16"
    else if (type == "secretU32") "u32"
    else if (type == "secretU64") "u64"
    else ""

fun bootstrapIsSecretType(type: string): bool = bootstrapSecretUnderlying(type) != ""

/** A type the compiler knows by name that isn't one of the language's numbers. */
fun bootstrapIsMachineValueType(type: string): bool =
    bootstrapIsVectorType(type) || bootstrapIsSecretType(type)

/** The features `@target` names. */
fun bootstrapSimdFeatureKnown(feature: string): bool =
    feature == "aes" || feature == "clmul" || feature == "avx2" ||
    feature == "sse41" || feature == "ssse3"

/** The intrinsics a function can only use under `@target(feature)`: "" for the others. */
fun bootstrapSimdIntrinsicFeature(name: string): string =
    if (name == "aesEncRound" || name == "aesEncLastRound" || name == "aesDecRound" ||
        name == "aesDecLastRound" || name == "aesInvMixColumns") "aes"
    else if (name == "clmul") "clmul"
    else ""

/** An extern:"intrinsic" lowered by the backend's SIMD file (src/backend/llvm/simd.ab). */
fun bootstrapSimdIntrinsic(name: string): bool =
    name.startsWith("ablaSimd") || name.startsWith("ablaCt") || bootstrapSimdShuffleType(name) != "" ||
    bootstrapSimdIntrinsicFeature(name) != ""

/** The vector type of a shuffle (`u32x4Shuffle`), whose indices are literals; else "". */
fun bootstrapSimdShuffleType(name: string): string {
    if (name.size < 11 || !name.endsWith("Shuffle")) return ""
    val type = name.slice(0, name.size - 7)
    if (bootstrapIsVectorType(type)) type else ""
}

/** Whether `features`, as `@target` wrote them ("aes,clmul"), include `feature`. */
fun bootstrapSimdFeatureListHas(features: string, feature: string): bool {
    for (entry in bootstrapSimdFeatureList(features)) if (entry == feature) return true
    false
}

fun bootstrapSimdFeatureList(features: string): array<string> {
    val result: array<string> = []
    var begin = 0
    for (at in 0 until features.size + 1) {
        if (at == features.size || int(features[at]) == 44) {
            if (at > begin) result.append(features.slice(begin, at))
            begin = at + 1
        }
    }
    result
}
