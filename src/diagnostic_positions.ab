// Diagnostics as a person reads them. A diagnostic's place is a record line,
// `source[kind]:path:begin:end`, in byte offsets of the file (tools read it);
// the compiler's output adds the line and column it names after it:
//
//     error[E_EVAL_EXPRESSION]: compile-time evaluation failed while ...
//     source[eval]:tools/table.ab:812:830
//       --> tools/table.ab:31:9
//
// Columns count characters (UTF-8 sequences), from 1. A record whose file
// can't be read (a generated module) stays as it is.
import "abla/sys/linux/fs"
import "abla/sys/linux/io"
import "generic_types.ab"
import "abla/text"

class BootstrapDiagnosticSources(
    val paths: array<string>,
    val contents: array<string>,
    val readable: array<bool>
)

fun bootstrapDiagnosticDecimal(text: string, begin: int, end: int): int {
    if (begin >= end || end - begin > 18) return -1
    var value = 0
    var index = begin
    while (index < end) {
        val digit = text[index] - 48
        if (digit < 0 || digit > 9) return -1
        value = value * 10 + digit
        index = index + 1
    }
    value
}

fun bootstrapDiagnosticSource(
    var sources: BootstrapDiagnosticSources,
    path: string
): int {
    var index = 0
    while (index < sources.paths.size) {
        if (sources.paths[index] == path) return index
        index = index + 1
    }
    val file = Path(path)
    val readable = file.exists()
    sources.paths.append(path)
    sources.contents.append(if (readable) file.readText() else "")
    sources.readable.append(readable)
    sources.paths.size - 1
}

// `path:line:column` of `offset` in `contents`.
fun bootstrapDiagnosticLineColumn(
    path: string,
    contents: string,
    offset: int
): string {
    var line = 1
    var lineBegin = 0
    var index = 0
    while (index < offset) {
        if (contents[index] == 10) {
            line = line + 1
            lineBegin = index + 1
        }
        index = index + 1
    }
    var column = 1
    index = lineBegin
    while (index < offset) {
        // Continuation bytes (10xxxxxx) belong to the character before.
        if ((contents[index] & 192) != 128) column = column + 1
        index = index + 1
    }
    "$path:$line:$column"
}

/** Diagnostics as the command line prints them: with positions, and a `help:` line that an earlier error of the same
 *  output already printed left out (twenty `println` calls without abla/io are twenty errors and one help line). The
 *  editor's analysis keeps every help line: it shows one error at a time. */
fun bootstrapCommandLineDiagnostics(raw: string): string {
    val positioned = bootstrapDiagnosticPositions(raw)
    val seen: Map<string, bool> = Map()
    var output = ""
    var start = 0
    while (start < positioned.size) {
        var end = start
        while (end < positioned.size && positioned[end] != 10) end = end + 1
        val line = positioned.slice(start, end)
        val repeated = line.startsWith("help: ") && seen.has(line)
        if (line.startsWith("help: ")) seen.set(line, true)
        if (!repeated) output = if (end < positioned.size) "$output$line\n" else "$output$line"
        start = end + 1
    }
    output
}

fun bootstrapDiagnosticPositions(raw: string): string {
    // A place in a generic's instance is its generic's (generic_types.ab).
    val diagnostics = bootstrapGenericDiagnostics(raw)
    var sources = BootstrapDiagnosticSources([], [], [])
    var output = ""
    var lineBegin = 0
    while (lineBegin < diagnostics.size) {
        var lineEnd = lineBegin
        while (lineEnd < diagnostics.size && diagnostics[lineEnd] != 10) {
            lineEnd = lineEnd + 1
        }
        val line = diagnostics.slice(lineBegin, lineEnd)
        output = "$output$line"
        if (lineEnd < diagnostics.size) output = "$output\n"
        if (line.size > 7 && line.slice(0, 7) == "source[") {
            // The path runs from after `]:` to the second colon from the end.
            var close = 7
            while (close < line.size && line[close] != 93) close = close + 1
            var last = line.size - 1
            while (last > close && line[last] != 58) last = last - 1
            var middle = last - 1
            while (middle > close && line[middle] != 58) middle = middle - 1
            val begin = bootstrapDiagnosticDecimal(line, middle + 1, last)
            val kind = line.slice(7, close)
            if (close + 2 < middle && begin >= 0) {
                val path = line.slice(close + 2, middle)
                val source = bootstrapDiagnosticSource(sources, path)
                if (sources.readable[source] &&
                    begin <= sources.contents[source].size) {
                    if (lineEnd >= diagnostics.size) output = "$output\n"
                    val place = bootstrapDiagnosticLineColumn(path, sources.contents[source], begin)
                    // A compile-time failure's `#` site (ir.ab), and the place of one native code stopped in, which
                    // has no line table, so it is the site's (ct_eval.ab, bootstrapCtReportStop).
                    if (kind == "site") {
                        val text = bootstrapDiagnosticSiteText(sources.contents[source], begin,
                            bootstrapDiagnosticDecimal(line, last + 1, line.size))
                        output = "$output  = note: in `$text` at $place\n"
                    } else if (kind.startsWith("frame:")) {
                        // A function the failure was in, innermost first (eval.ab, bootstrapEvalNoteFrame).
                        output = "$output  = note: in `${kind.slice(6, kind.size)}`, declared at $place\n"
                    } else if (kind == "eval-site") {
                        output = "$output  --> $place (its `#` site: the native tier's code has no line table)\n"
                    } else output = "$output  --> $place\n"
                }
            }
        }
        lineBegin = lineEnd + 1
    }
    output
}

// A program's entry file that isn't there is the diagnosis (not a program with
// no `main`): reported, and the command fails.
fun bootstrapSourceFound(sourcePath: string): bool {
    if (sourcePath == "" || Path(sourcePath).exists()) return true
    linuxPrintStandardError("error[E_SOURCE_NOT_FOUND]: no such file: $sourcePath\n")
    false
}

// A `#` site's text on one line (a note, a report): runs of white space are one space, and a long one is cut. A
// parenthesized site's span (`#(a > 0)`) ends at its inner expression's end, so the closing parentheses after it are
// added back.
fun bootstrapDiagnosticSiteText(contents: string, begin: int, siteEnd: int): string {
    if (begin < 0 || siteEnd > contents.size || begin >= siteEnd) return ""
    var open = 0
    var scan = begin
    while (scan < siteEnd) {
        if (contents[scan] == 40) open = open + 1
        else if (contents[scan] == 41) open = open - 1
        scan = scan + 1
    }
    var end = siteEnd
    var after = siteEnd
    while (open > 0 && after < contents.size) {
        val byte = contents[after]
        after = after + 1
        if (byte == 41) {
            open = open - 1
            end = after
        } else if (byte != 32 && byte != 9 && byte != 10 && byte != 13) open = 0
    }
    var text = ""
    var space = false
    var index = begin
    while (index < end) {
        val byte = contents[index]
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) space = true
        else {
            if (space && text.size > 0) text = "$text "
            space = false
            text = "$text${contents.slice(index, index + 1)}"
        }
        index = index + 1
    }
    if (text.size > 60) text = "${text.slice(0, 57)}..."
    text
}
