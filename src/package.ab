import "abla/sys/linux/fs"
import "manifest_grammar.ab"
import "abla/sys/linux/process"
import "eval.ab"
import "module_paths.ab"
import "module.ab"
import "parser.ab"
import "abla/sys/linux"
import "abla/integer"
import "abla/process/signal"
import "sema.ab"
import "abla/text"

// Import providers are evaluated above the module parser. Ordinary builds use
// only stable source identity plus abla.lock; `package update` alone invokes a
// deferred provider resolver or resolves an external Git selector.

fun bootstrapRuntimeRoot(): string =
    Path(bootstrapToolchainRoot()).child("runtime").text

class BootstrapPackageSourceFile(
    val path: string,
    val contents: string
)

class BootstrapPackageDependency(
    val name: string,
    val provider: string,
    val identity: string,
    val source: string,
    val selectorKind: string,
    val selector: string,
    val resolvedRevision: string,
    val resolvedEntry: string,
    val resolvedFiles: array<BootstrapPackageSourceFile>,
    // The modules inside the package that imports name, beside its entry.
    val subpaths: array<string> = []
)

class BootstrapPackageDependencies(
    val values: array<BootstrapPackageDependency>,
    val errors: int,
    val diagnostic: string
)

class BootstrapLockedPackage(
    val name: string,
    val provider: string,
    val identity: string,
    val source: string,
    val selectorKind: string,
    val selector: string,
    val revision: string,
    val digest: string,
    val entry: string
)

class BootstrapPackageLock(
    val packages: array<BootstrapLockedPackage>,
    val valid: bool,
    val diagnostic: string
)

class BootstrapPackageResult(
    val status: int,
    val diagnostic: string
)

class BootstrapPackageContentResult(
    val status: int,
    val diagnostic: string,
    val digest: string,
    val source: string
)

class BootstrapImportProviderResult(
    val dependency: BootstrapPackageDependency,
    val errors: int,
    val diagnostic: string
)

class BootstrapPackageProviderScan(
    val imports: array<string>,
    val providers: array<string>,
    val errors: int
)

fun bootstrapPackageScanImports(source: string): BootstrapPackageProviderScan {
    val imports: array<string> = []
    val providers: array<string> = []
    val scan = bootstrapScanImports(source)
    var index = 0
    while (index < scan.edges.size) {
        val edge = scan.edges[index]
        if (edge.provider) providers.append(edge.source)
        else imports.append(edge.source)
        index = index + 1
    }
    BootstrapPackageProviderScan(imports, providers, scan.errors)
}

fun bootstrapPackageResolveStaticImport(
    importer: string,
    requested: string
): string {
    // Normalised, so a cycle through `../` revisits the same path rather than
    // growing a new one each time round.
    var result = bootstrapNormalizeModulePath(
        Path(importer).parent().child(requested).text
    )
    if (Path(requested).isAbsolute()) result = requested
    if (requested.size >= 5 && requested.slice(0, 5) == "abla/") {
        result = Path(bootstrapStandardLibraryRoot()).child(requested).child(
            "entry.ab"
        ).text
    }
    result
}

class BootstrapPackageProviderCollector(
    val paths: array<string>,
    val declarations: array<BootstrapDeclaration>,
    val providers: array<string>,
    var errors: int,
    var diagnostic: string,
    val overlayPath: string = "",
    val overlaySource: string = ""
) {
    fun contains(path: string): bool {
        var found = false
        var index = 0
        while (index < this.paths.size) {
            if (this.paths[index] == path) found = true
            index = index + 1
        }
        found
    }

    fun collect(modulePath: string): void {
        if (!this.contains(modulePath)) {
            this.paths.append(modulePath)
            val source = if (modulePath == this.overlayPath) this.overlaySource
                else Path(modulePath).readText()
            if (!Path(modulePath).exists()) {
                this.errors = this.errors + 1
                this.diagnostic =
                    "${this.diagnostic}error[E_IMPORT_PROVIDER_MODULE]: missing provider module '$modulePath'\n"
            }
            val scan = bootstrapPackageScanImports(source)
            this.errors = this.errors + scan.errors
            var index = 0
            while (index < scan.imports.size) {
                this.collect(bootstrapPackageResolveStaticImport(
                    modulePath, scan.imports[index]
                ))
                index = index + 1
            }
            val parsed = bootstrapParse(source)
            // This lightweight pass exists only to collect declarations used
            // by ImportSource expressions. Ordinary dependency modules may
            // contain registered subparser syntax (`$json`, `$html`, and so
            // on) that the raw bootstrap parser cannot expand in isolation.
            // Their full staged parse still runs during the normal build. A
            // module that actually contains a provider expression must remain
            // raw-parseable so its provider declarations can be evaluated.
            if (scan.providers.size > 0) {
                this.errors = this.errors + parsed.errors
                this.diagnostic = "${this.diagnostic}${parsed.diagnostics}"
            }
            index = 0
            while (index < parsed.declarations.size) {
                this.declarations.append(parsed.declarations[index])
                index = index + 1
            }
            index = 0
            while (index < scan.providers.size) {
                this.providers.append(scan.providers[index])
                index = index + 1
            }
        }
    }
}

fun bootstrapPackageDiscoverImportProviders(
    entry: string,
    resolve: bool = false,
    resolveEffects: int = 0,
    overlayPath: string = "",
    overlaySource: string = ""
): BootstrapPackageDependencies {
    val collector = BootstrapPackageProviderCollector([], [], [], 0, "", overlayPath, overlaySource)
    collector.collect(entry)
    val dependencies: array<BootstrapPackageDependency> = []
    var index = 0
    while (index < collector.providers.size) {
        val expression = collector.providers[index]
        var requestedExpression = expression
        if (resolve) requestedExpression =
            "__ablaResolveImportSource($expression)"
        val parsed = bootstrapParse("#$requestedExpression")
        val unquoted = bootstrapUnquotedImportDiagnostic(expression)
        if (unquoted != "") {
            collector.errors = collector.errors + 1
            collector.diagnostic = "${collector.diagnostic}$unquoted"
        } else if (parsed.errors == 0 && parsed.actions.size == 1) {
            // Bit 1024 is private authority to invoke a deferred ImportSource
            // resolver; ordinary compile-time evaluation never receives it.
            val allowedEffects = if (resolve) resolveEffects + 1024 else 0
            val evaluated = bootstrapEvaluateWithEffects(
                parsed.actions[0], collector.declarations, allowedEffects
            )
            collector.errors = collector.errors + evaluated.errors
            collector.diagnostic =
                "${collector.diagnostic}${evaluated.diagnostics}"
            if (resolve && evaluated.errors > 0) {
                collector.diagnostic =
                    "${collector.diagnostic}error[E_IMPORT_PROVIDER_EFFECT_DENIED]: deferred resolver failed; authorize any required effects in the root manifest compileCapabilities\n"
            }
            if (evaluated.value.kind == "object" &&
                evaluated.value.owner == "ImportSource") {
                val decoded = bootstrapPackageDependencyFromValue(
                    evaluated.value, resolve
                )
                collector.errors = collector.errors + decoded.errors
                collector.diagnostic =
                    "${collector.diagnostic}${decoded.diagnostic}"
                val existing = bootstrapPackageDependencyIndex(
                    dependencies, decoded.dependency.name
                )
                if (decoded.errors == 0 && existing < 0) {
                    dependencies.append(decoded.dependency)
                }
                if (decoded.errors == 0 && existing >= 0) {
                    bootstrapPackageAddSubpaths(dependencies[existing], decoded.dependency)
                }
                if (decoded.errors == 0 && existing >= 0 &&
                    (dependencies[existing].provider != decoded.dependency.provider ||
                     dependencies[existing].identity != decoded.dependency.identity ||
                     dependencies[existing].source != decoded.dependency.source ||
                     dependencies[existing].selectorKind != decoded.dependency.selectorKind ||
                     dependencies[existing].selector != decoded.dependency.selector)) {
                    collector.errors = collector.errors + 1
                    collector.diagnostic =
                        "${collector.diagnostic}error[E_PACKAGE_COLLISION]: provider expression '$expression' conflicts with dependency '${decoded.dependency.name}'\n"
                }
            } else {
                collector.errors = collector.errors + 1
                collector.diagnostic =
                    "${collector.diagnostic}error[E_IMPORT_PROVIDER_RESULT]: provider expression '$expression' must return ImportSource\n"
            }
        } else {
            collector.errors = collector.errors + 1
            collector.diagnostic =
                "${collector.diagnostic}error[E_IMPORT_PROVIDER_PARSE]: invalid provider expression '$expression'\n"
        }
        index = index + 1
    }
    BootstrapPackageDependencies(
        dependencies, collector.errors, collector.diagnostic
    )
}

fun bootstrapPackageEvalField(
    value: BootstrapEvalValue,
    name: string
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var index = 0
    while (index < value.fieldNames.size && index < value.elements.size) {
        if (value.fieldNames[index] == name) result = value.elements[index]
        index = index + 1
    }
    result
}

fun bootstrapPackageDependencyFromValue(
    value: BootstrapEvalValue,
    resolved: bool
): BootstrapImportProviderResult {
    val nameValue = bootstrapPackageEvalField(value, "name")
    val providerValue = bootstrapPackageEvalField(value, "provider")
    val identityValue = bootstrapPackageEvalField(value, "identity")
    val sourceValue = bootstrapPackageEvalField(value, "source")
    val selectorKindValue = bootstrapPackageEvalField(value, "selectorKind")
    val selectorValue = bootstrapPackageEvalField(value, "selector")
    val resolverValue = bootstrapPackageEvalField(value, "resolver")
    val revisionValue = bootstrapPackageEvalField(value, "resolvedRevision")
    val entryValue = bootstrapPackageEvalField(value, "resolvedEntry")
    val filesValue = bootstrapPackageEvalField(value, "resolvedFiles")
    val subpathValue = bootstrapPackageEvalField(value, "subpath")
    val subpaths: array<string> = []
    val name = nameValue.text
    val provider = providerValue.text
    val identity = identityValue.text
    val source = sourceValue.text
    val selectorKind = selectorKindValue.text
    val selector = selectorValue.text
    val revision = revisionValue.text
    val entry = entryValue.text
    val files: array<BootstrapPackageSourceFile> = []
    var errors = 0
    var diagnostic = ""
    if (value.kind != "object" || value.owner != "ImportSource" ||
        nameValue.kind != "string" || providerValue.kind != "string" ||
        identityValue.kind != "string" || selectorValue.kind != "string" ||
        !bootstrapPackageNameValid(name) ||
        !bootstrapPackageStringSafe(identity) ||
        !bootstrapPackageSelectorValid(selector) ||
        (provider != "git" && provider != "content")) {
        errors = 1
        diagnostic =
            "error[E_IMPORT_PROVIDER_DESCRIPTOR]: ImportSource has invalid identity, selector, or provider fields\n"
    }
    if (errors == 0 && provider == "git" &&
        (sourceValue.kind != "string" ||
         selectorKindValue.kind != "string" ||
         !bootstrapPackageSourceValid(source) ||
         (selectorKind != "rev" && selectorKind != "tag" &&
          selectorKind != "branch" && selectorKind != "head"))) {
        errors = 1
        diagnostic =
            "error[E_IMPORT_PROVIDER_DESCRIPTOR]: Git ImportSource has invalid source or selector kind\n"
    }
    if (errors == 0 && provider == "content" &&
        (sourceValue.kind != "string" || source != "" ||
         selectorKindValue.kind != "string" || selectorKind != "" ||
         (resolverValue.kind != "closure" &&
          resolverValue.kind != "function"))) {
        errors = 1
        diagnostic =
            "error[E_IMPORT_PROVIDER_DESCRIPTOR]: content ImportSource has an invalid deferred resolver\n"
    }
    if (errors == 0 && resolved && provider == "content") {
        if (revisionValue.kind != "string" || entryValue.kind != "string" ||
            filesValue.kind != "array" ||
            !bootstrapPackageStringSafe(revision) ||
            !bootstrapPackageRelativePathValid(entry)) errors = 1
        var index = 0
        while (errors == 0 && index < filesValue.elements.size) {
            val file = filesValue.elements[index]
            val path = bootstrapPackageEvalField(file, "path")
            val contents = bootstrapPackageEvalField(file, "contents")
            if (file.kind != "object" || file.owner != "ImportFile" ||
                path.kind != "string" || contents.kind != "string" ||
                !bootstrapPackageRelativePathValid(path.text)) errors = 1
            if (errors == 0) files.append(BootstrapPackageSourceFile(
                path.text, contents.text
            ))
            index = index + 1
        }
        if (errors != 0) diagnostic =
            "error[E_IMPORT_PROVIDER_RESOLUTION]: resolved ImportSource has invalid revision, entry, or files\n"
    }
    if (errors == 0 && subpathValue.kind == "string" && subpathValue.text != "") {
        if (bootstrapPackageRelativePathValid(subpathValue.text)) subpaths.append(subpathValue.text)
        else {
            errors = 1
            diagnostic =
                "error[E_PACKAGE_SUBPATH_INVALID]: `${subpathValue.text}` isn't a path inside package '$name': it must be relative, with no empty, `.`, `..` or `.git` part\n"
        }
    }
    BootstrapImportProviderResult(
        BootstrapPackageDependency(
            name, provider, identity, source, selectorKind, selector,
            revision, entry, files, subpaths
        ),
        errors,
        diagnostic
    )
}

fun bootstrapPackageTrim(value: string): string {
    var begin = 0
    var end = value.size
    while (begin < end && (value[begin] == 32 || value[begin] == 9 ||
           value[begin] == 10 || value[begin] == 13)) begin = begin + 1
    while (end > begin && (value[end - 1] == 32 || value[end - 1] == 9 ||
           value[end - 1] == 10 || value[end - 1] == 13)) end = end - 1
    value.slice(begin, end)
}

fun bootstrapPackageNameValid(name: string): bool {
    var valid = name.size > 0 && name.size <= 128
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        valid = (byte >= 48 && byte <= 57) ||
            (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 45 || byte == 95
        index = index + 1
    }
    valid
}

fun bootstrapPackageRelativePathValid(path: string): bool {
    var valid = path.size > 0 && path.size <= 4096 && path[0] != 47
    var begin = 0
    var index = 0
    while (valid && index <= path.size) {
        if (index < path.size && path[index] == 0) valid = false
        // A path is the same file on every host: no control character, backslash or colon (a Windows separator, a drive, a stream).
        if (index < path.size && (path[index] < 32 || path[index] == 127 || path[index] == 92 || path[index] == 58)) valid = false
        if (index == path.size || path[index] == 47) {
            val component = path.slice(begin, index)
            if (component == "" || component == "." || component == ".." || component.size > 255 || bootstrapPackageGitName(component)) {
                valid = false
            }
            begin = index + 1
        }
        index = index + 1
    }
    valid
}

// Whether `component` is what git, a case-folding file system or Windows reads as the repository directory: `.git` in any case, with trailing dots or spaces, or its 8.3 name.
fun bootstrapPackageGitName(component: string): bool {
    var end = component.size
    while (end > 0 && (component[end - 1] == 46 || component[end - 1] == 32)) end = end - 1
    val folded = component.slice(0, end).lowercase()
    folded == ".git" || folded == "git~1"
}

// A git source is a place to fetch from, never an option for git: an allow-list of the forms a dependency can
// use (https://, ssh://, git://, file://, an absolute or relative path, scp-style user@host:path). A leading `-` would be read
// by git as an option (`--upload-pack=<command>` runs the command), and `<transport>::<address>` selects a
// remote helper.
fun bootstrapPackageSourceValid(value: string): bool {
    var valid = bootstrapPackageStringSafe(value) && value[0] != 45
    var index = 0
    while (valid && index < value.size) {
        // control characters and spaces have no place in a repository address
        if (value[index] < 33 || value[index] == 127) valid = false
        index = index + 1
    }
    if (valid) {
        val form = value.startsWith("https://") || value.startsWith("ssh://") ||
            value.startsWith("git://") || value.startsWith("file://") || value[0] == 47
        var scp = false
        if (!form) {
            // user@host:path: a colon after an `@`, before any slash
            var at = -1
            var colon = -1
            var cursor = 0
            while (cursor < value.size && value[cursor] != 47) {
                if (value[cursor] == 64 && at < 0) at = cursor
                if (value[cursor] == 58 && colon < 0) colon = cursor
                cursor = cursor + 1
            }
            scp = at > 0 && colon > at + 1 && colon + 1 < value.size && value[colon + 1] != 58
        }
        // a relative path (no colon) names a local repository, as in a lock written by a test
        valid = form || scp || !value.contains(":")
        if (valid && value.contains("::")) valid = false
    }
    valid
}

// A selector names a revision, tag or branch inside a repository: no leading `-`, no `..`, no characters git
// treats as a pattern, a revision expression or an option separator.
fun bootstrapPackageSelectorValid(value: string): bool {
    var valid = bootstrapPackageStringSafe(value) && value[0] != 45 &&
        !value.contains("..")
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        if (byte < 33 || byte == 127 || byte == 58 || byte == 63 || byte == 42 || byte == 91 ||
            byte == 92 || byte == 94 || byte == 126 || byte == 64 && index + 1 < value.size && value[index + 1] == 123) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapPackageStringSafe(value: string): bool {
    var valid = value.size > 0 && value.size <= 4096
    var index = 0
    while (valid && index < value.size) {
        if (value[index] == 34 || value[index] == 10 || value[index] == 13 ||
            value[index] == 0) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapPackageInlineString(line: string, key: string): string {
    var result = ""
    var index = 0
    while (index + key.size < line.size && result == "") {
        if (line.slice(index, index + key.size) == key) {
            var leftValid = index == 0 || line[index - 1] == 32 ||
                line[index - 1] == 9 || line[index - 1] == 123 ||
                line[index - 1] == 44
            var cursor = index + key.size
            while (cursor < line.size &&
                   (line[cursor] == 32 || line[cursor] == 9)) {
                cursor = cursor + 1
            }
            if (cursor >= line.size || line[cursor] != 61) leftValid = false
            cursor = cursor + 1
            while (cursor < line.size &&
                   (line[cursor] == 32 || line[cursor] == 9)) {
                cursor = cursor + 1
            }
            if (leftValid && cursor < line.size && line[cursor] == 34) {
                val begin = cursor + 1
                cursor = begin
                while (cursor < line.size && line[cursor] != 34) {
                    cursor = cursor + 1
                }
                if (cursor < line.size) result = line.slice(begin, cursor)
            }
        }
        index = index + 1
    }
    result
}

fun bootstrapPackageManifestDependencies(
    manifestPath: string
): BootstrapPackageDependencies {
    val dependencies: array<BootstrapPackageDependency> = []
    // A manifest outside the grammar of src/manifest_grammar.ab is refused here, so every caller reports it (its other readers see an empty file).
    val grammar = bootstrapManifestProblem(manifestPath, false)
    if (grammar != "") return BootstrapPackageDependencies(dependencies, 1, grammar)
    val source = bootstrapManifestText(manifestPath, false)
    var errors = 0
    var diagnostic = ""
    var inDependencies = false
    var lineBegin = 0
    while (lineBegin < source.size) {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var contentEnd = lineEnd
        var quote = false
        var cursor = lineBegin
        while (cursor < contentEnd) {
            if (source[cursor] == 34) quote = !quote
            if (source[cursor] == 35 && !quote) contentEnd = cursor
            cursor = cursor + 1
        }
        val line = bootstrapPackageTrim(source.slice(lineBegin, contentEnd))
        if (line.size > 0 && line[0] == 91) {
            inDependencies = line == "[dependencies]"
        } else if (inDependencies && line != "") {
            var equals = 0
            while (equals < line.size && line[equals] != 61) equals = equals + 1
            val name = bootstrapPackageTrim(line.slice(0, equals))
            val git = bootstrapPackageInlineString(line, "git")
            val revision = bootstrapPackageInlineString(line, "rev")
            val tag = bootstrapPackageInlineString(line, "tag")
            val branch = bootstrapPackageInlineString(line, "branch")
            var selectorCount = 0
            var selectorKind = ""
            var selector = ""
            if (revision != "") {
                selectorCount = selectorCount + 1
                selectorKind = "rev"
                selector = revision
            }
            if (tag != "") {
                selectorCount = selectorCount + 1
                selectorKind = "tag"
                selector = tag
            }
            if (branch != "") {
                selectorCount = selectorCount + 1
                selectorKind = "branch"
                selector = branch
            }
            var valid = equals < line.size && bootstrapPackageNameValid(name) &&
                bootstrapPackageSourceValid(git) && selectorCount == 1 &&
                bootstrapPackageSelectorValid(selector)
            var duplicate = false
            var dependency = 0
            while (dependency < dependencies.size) {
                if (dependencies[dependency].name == name) duplicate = true
                dependency = dependency + 1
            }
            if (duplicate) valid = false
            if (valid) {
                dependencies.append(BootstrapPackageDependency(
                    name, "git", "git:$git", git, selectorKind,
                    selector, "", "", []
                ))
            } else {
                errors = errors + 1
                diagnostic =
                    "$diagnostic error[E_PACKAGE_MANIFEST]: invalid dependency '$name' in $manifestPath; expected one git source and exactly one rev, tag, or branch selector\n"
            }
        }
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    BootstrapPackageDependencies(dependencies, errors, diagnostic)
}

fun bootstrapPackageTomlField(line: string, key: string): string {
    var equals = 0
    while (equals < line.size && line[equals] != 61) equals = equals + 1
    val foundKey = bootstrapPackageTrim(line.slice(0, equals))
    var result = ""
    if (equals < line.size && foundKey == key) {
        var begin = equals + 1
        while (begin < line.size && (line[begin] == 32 || line[begin] == 9)) {
            begin = begin + 1
        }
        if (begin < line.size && line[begin] == 34) {
            val valueBegin = begin + 1
            var end = valueBegin
            while (end < line.size && line[end] != 34) end = end + 1
            if (end < line.size) result = line.slice(valueBegin, end)
        }
    }
    result
}

fun bootstrapPackageAppendLockRecord(
    var packages: array<BootstrapLockedPackage>,
    name: string,
    provider: string,
    identity: string,
    source: string,
    selectorKind: string,
    selector: string,
    revision: string,
    digest: string,
    entry: string
): bool {
    val valid = bootstrapPackageNameValid(name) &&
        (provider == "git" || provider == "content") &&
        bootstrapPackageStringSafe(identity) &&
        (provider != "git" || bootstrapPackageSourceValid(source)) &&
        (provider != "git" || selectorKind == "rev" ||
         selectorKind == "tag" || selectorKind == "branch" ||
         selectorKind == "head") &&
        bootstrapPackageSelectorValid(selector) &&
        bootstrapPackageStringSafe(revision) &&
        (provider != "git" || bootstrapPackageHexRevision(revision)) &&
        bootstrapPackageHexRevision(digest) &&
        bootstrapPackageRelativePathValid(entry)
    if (valid) packages.append(BootstrapLockedPackage(
        name, provider, identity, source, selectorKind, selector,
        revision, digest, entry
    ))
    valid
}

fun bootstrapPackageReadLock(lockPath: string): BootstrapPackageLock {
    val packages: array<BootstrapLockedPackage> = []
    val text = bootstrapManifestText(lockPath, true)
    val grammar = bootstrapManifestProblem(lockPath, true)
    var valid = Path(lockPath).exists() && grammar == ""
    var diagnostic = ""
    var name = ""
    var provider = ""
    var identity = ""
    var source = ""
    var selectorKind = ""
    var selector = ""
    var revision = ""
    var digest = ""
    var entry = ""
    var active = false
    var lineBegin = 0
    while (valid && lineBegin < text.size) {
        var lineEnd = lineBegin
        while (lineEnd < text.size && text[lineEnd] != 10 &&
               text[lineEnd] != 13) lineEnd = lineEnd + 1
        val line = bootstrapPackageTrim(text.slice(lineBegin, lineEnd))
        if (line == "[[package]]") {
            if (active) valid = bootstrapPackageAppendLockRecord(
                packages, name, provider, identity, source,
                selectorKind, selector,
                revision, digest, entry
            )
            active = true
            name = ""
            provider = ""
            identity = ""
            source = ""
            selectorKind = ""
            selector = ""
            revision = ""
            digest = ""
            entry = ""
        } else if (active && line != "" && line[0] != 35) {
            val foundName = bootstrapPackageTomlField(line, "name")
            val foundProvider = bootstrapPackageTomlField(line, "provider")
            val foundIdentity = bootstrapPackageTomlField(line, "identity")
            val foundSource = bootstrapPackageTomlField(line, "source")
            val foundKind = bootstrapPackageTomlField(line, "selector-kind")
            val foundSelector = bootstrapPackageTomlField(line, "selector")
            val foundRevision = bootstrapPackageTomlField(line, "revision")
            val foundDigest = bootstrapPackageTomlField(line, "digest")
            val foundEntry = bootstrapPackageTomlField(line, "entry")
            if (foundName != "") name = foundName
            if (foundProvider != "") provider = foundProvider
            if (foundIdentity != "") identity = foundIdentity
            if (foundSource != "") source = foundSource
            if (foundKind != "") selectorKind = foundKind
            if (foundSelector != "") selector = foundSelector
            if (foundRevision != "") revision = foundRevision
            if (foundDigest != "") digest = foundDigest
            if (foundEntry != "") entry = foundEntry
        }
        lineBegin = lineEnd + 1
        if (lineBegin < text.size && text[lineBegin - 1] == 13 &&
            text[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    if (valid && active) valid = bootstrapPackageAppendLockRecord(
        packages, name, provider, identity, source, selectorKind, selector,
        revision, digest, entry
    )
    if (!Path(lockPath).exists()) {
        diagnostic =
            "error[E_PACKAGE_LOCK_MISSING]: dependencies require checked-in lockfile $lockPath; run 'ablac package update --project ${Path(lockPath).parent().text}'\n"
    } else if (grammar != "") {
        diagnostic = grammar
    } else if (!valid) {
        diagnostic = "error[E_PACKAGE_LOCK_INVALID]: invalid package lockfile $lockPath\n"
    }
    BootstrapPackageLock(packages, valid, diagnostic)
}

fun bootstrapPackageLockIndex(
    packages: array<BootstrapLockedPackage>,
    name: string
): int {
    var result = -1
    var index = 0
    while (index < packages.size && result < 0) {
        if (packages[index].name == name) result = index
        index = index + 1
    }
    result
}

fun bootstrapPackageDependencyIndex(
    dependencies: array<BootstrapPackageDependency>,
    name: string
): int {
    var result = -1
    var index = 0
    while (index < dependencies.size && result < 0) {
        if (dependencies[index].name == name) result = index
        index = index + 1
    }
    result
}

fun bootstrapPackageAddSubpaths(
    var dependency: BootstrapPackageDependency,
    other: BootstrapPackageDependency
): void {
    for (subpath in other.subpaths) {
        if (!bootstrapPackageStringsContain(dependency.subpaths, subpath)) {
            dependency.subpaths.append(subpath)
        }
    }
    return
}

fun bootstrapPackageMergeDependencies(
    left: BootstrapPackageDependencies,
    right: BootstrapPackageDependencies
): BootstrapPackageDependencies {
    val values: array<BootstrapPackageDependency> = []
    var errors = left.errors + right.errors
    var diagnostic = "${left.diagnostic}${right.diagnostic}"
    var index = 0
    while (index < left.values.size) {
        values.append(left.values[index])
        index = index + 1
    }
    index = 0
    while (index < right.values.size) {
        val dependency = right.values[index]
        val existing = bootstrapPackageDependencyIndex(values, dependency.name)
        if (existing >= 0) bootstrapPackageAddSubpaths(values[existing], dependency)
        if (existing < 0) values.append(dependency)
        else if (values[existing].provider != dependency.provider ||
            values[existing].identity != dependency.identity ||
            values[existing].source != dependency.source ||
            values[existing].selectorKind != dependency.selectorKind ||
            values[existing].selector != dependency.selector) {
            errors = errors + 1
            diagnostic =
                "${diagnostic}error[E_PACKAGE_COLLISION]: dependency '${dependency.name}' is requested through incompatible import providers\n"
        }
        index = index + 1
    }
    BootstrapPackageDependencies(values, errors, diagnostic)
}

fun bootstrapPackageCacheRoot(): string {
    val configured = linuxEnvironment("ABLA_PACKAGE_CACHE")
    var result = ""
    if (configured.found && configured.value != "") result = configured.value
    if (result == "") {
        val xdg = linuxEnvironment("XDG_CACHE_HOME")
        if (xdg.found && xdg.value != "") result = "${xdg.value}/abla"
    }
    if (result == "") {
        val home = linuxEnvironment("HOME")
        if (home.found && home.value != "") result = "${home.value}/.cache/abla"
    }
    if (result == "") result = ".abla-cache"
    result
}

fun bootstrapPackageCachePath(package: BootstrapLockedPackage): string {
    val key = if (package.provider == "content") package.digest
        else package.revision
    "${bootstrapPackageCacheRoot()}/${package.provider}/${package.name}/$key"
}

// Every git call of the package layer starts here: nothing a caller exported (GIT_DIR and the like) selects another
// repository, git never prompts, hooks do not run, and only the transports a dependency source can name are allowed
// (a `<transport>::` remote helper such as ext is refused).
// A repository that digests or checks out package files reads them as bytes: its info/attributes (which outranks any .gitattributes in the files) unsets every attribute that rewrites content.
fun bootstrapPackageRawAttributes(gitDirectory: string): bool =
    Path("$gitDirectory/info").createDirectories() &&
        Path("$gitDirectory/info/attributes").writeText("* -text -eol -ident -filter -working-tree-encoding\n")

fun bootstrapPackageGit(): LinuxCommand {
    val command = linuxCommand("git")
    for (name in ["GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE",
        "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_NAMESPACE"]) {
        command.removeEnvironment(name)
    }
    command.environment("GIT_TERMINAL_PROMPT", "0")
    command.environment("GIT_ALLOW_PROTOCOL", "https:ssh:git:file")
    command.argument("-c")
    command.argument("core.hooksPath=/dev/null")
    command.argument("-c")
    command.argument("protocol.ext.allow=never")
    command.argument("-c")
    command.argument("core.fsmonitor=false")
    // What is read from a checkout is the blob the digest covers: no user setting or attribute rewrites line endings, expands $Id$ or runs a filter.
    for (setting in ["core.autocrlf=false", "core.safecrlf=false", "core.attributesFile=/dev/null"]) {
        command.argument("-c")
        command.argument(setting)
    }
    command
}

fun bootstrapPackageHexRevision(value: string): bool {
    var valid = value.size == 40
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        valid = (byte >= 48 && byte <= 57) ||
            (byte >= 97 && byte <= 102) || (byte >= 65 && byte <= 70)
        index = index + 1
    }
    valid
}

fun bootstrapPackageFirstRevision(output: string): string {
    var result = ""
    var lineBegin = 0
    while (lineBegin < output.size) {
        var lineEnd = lineBegin
        while (lineEnd < output.size && output[lineEnd] != 10 &&
               output[lineEnd] != 13) lineEnd = lineEnd + 1
        val line = bootstrapPackageTrim(output.slice(lineBegin, lineEnd))
        var end = 0
        while (end < line.size && line[end] != 32 && line[end] != 9) {
            end = end + 1
        }
        val candidate = line.slice(0, end)
        if (bootstrapPackageHexRevision(candidate)) result = candidate
        lineBegin = lineEnd + 1
    }
    result
}

private fun bootstrapPackageGitTimeoutSeconds(): int {
    val configured = linuxEnvironment("ABLA_PACKAGE_GIT_TIMEOUT_SECONDS").value.parseInt() ?? 0
    if (configured >= 1 && configured <= 3600) configured else 120
}

private fun bootstrapPackageCaptureGit(command: LinuxCommand, seconds: int): LinuxProcessResult {
    if (linuxHostIsWindows()) return command.capture()
    val watch = watchSignals([signalInterrupt, signalTerminate, signalHangup])
    val captured = command.capture(seconds * 1000, watch.descriptor)
    watch.close()
    captured
}

private fun bootstrapPackageGitTimeout(
    dependency: BootstrapPackageDependency, operation: string, seconds: int
): string =
    "error[E_PACKAGE_GIT_TIMEOUT]: git $operation for dependency '${dependency.name}', source '${dependency.source}', timed out after $seconds seconds\n"

class BootstrapPackageRevision(val revision: string, val diagnostic: string = "")

fun bootstrapPackageResolveRevision(
    dependency: BootstrapPackageDependency
): BootstrapPackageRevision {
    if (dependency.selectorKind == "rev" &&
        bootstrapPackageHexRevision(dependency.selector)) {
        return BootstrapPackageRevision(dependency.selector)
    }
    val command = bootstrapPackageGit()
    command.argument("ls-remote")
    command.argument("--")
    command.argument(dependency.source)
    if (dependency.selectorKind == "tag") {
        command.argument("refs/tags/${dependency.selector}")
        command.argument("refs/tags/${dependency.selector}^{}")
    } else if (dependency.selectorKind == "branch") {
        command.argument("refs/heads/${dependency.selector}")
    } else if (dependency.selectorKind == "head") {
        command.argument("HEAD")
    } else return BootstrapPackageRevision("")
    val seconds = bootstrapPackageGitTimeoutSeconds()
    val resolved = bootstrapPackageCaptureGit(command, seconds)
    if (resolved.timedOut) return BootstrapPackageRevision(
        "", bootstrapPackageGitTimeout(dependency, "ls-remote", seconds)
    )
    BootstrapPackageRevision(if (resolved.status == 0) bootstrapPackageFirstRevision(resolved.output) else "")
}

// A checkout's own bytes: a symbolic link counts as itself and is not followed,
// out of the checkout or around a cycle.
fun bootstrapPackageDirectorySize(path: Path, limit: int): int {
    val info = path.linkInfo()
    var total = 0
    if (info.isFile() || info.kind == 4) total = info.size
    if (info.isDirectory()) {
        val entries = path.entries()
        var index = 0
        while (index < entries.size && total <= limit) {
            total = total + bootstrapPackageDirectorySize(
                entries[index], limit - total
            )
            index = index + 1
        }
    }
    total
}

fun bootstrapPackageRemoveTree(path: string): bool {
    val command = linuxCommand("rm")
    command.argument("-rf")
    command.argument("--")
    command.argument(path)
    command.run() == 0
}

fun bootstrapPackageCopyTree(source: string, destination: string): bool {
    var valid = Path(destination).parent().createDirectories()
    if (valid) {
        val command = linuxCommand("cp")
        command.argument("-R")
        command.argument("--")
        command.argument(source)
        command.argument(destination)
        valid = command.run() == 0
    }
    valid
}

fun bootstrapPackageGitValue(directory: string, value: string): string {
    val command = bootstrapPackageGit()
    command.argument("-C")
    command.argument(directory)
    command.argument("rev-parse")
    command.argument(value)
    val captured = command.capture()
    var result = ""
    if (captured.status == 0) result = bootstrapPackageTrim(captured.output)
    result
}

fun bootstrapPackageGitWriteTree(directory: string): string {
    val command = bootstrapPackageGit()
    command.argument("-C")
    command.argument(directory)
    command.argument("write-tree")
    val captured = command.capture()
    var result = ""
    if (captured.status == 0) result = bootstrapPackageTrim(captured.output)
    result
}

fun bootstrapPackageCacheValid(package: BootstrapLockedPackage): bool {
    val root = bootstrapPackageCachePath(package)
    val source = "$root/source"
    var valid = Path(source).info().isDirectory() &&
        Path("$root/provider").readText() == package.provider &&
        Path("$root/digest").readText() == package.digest
    if (valid && package.provider == "git") {
        valid = Path("$root/identity").readText() == package.identity &&
            Path("$root/revision").readText() == package.revision &&
            Path("$root/source-url").readText() == package.source
    }
    // The files are the tree the lock names. git inside the entry is not asked: its index, config (core.fsmonitor is a command) and objects are as writable as the files.
    valid && bootstrapPackageDirectoryDigest(source, false) == package.digest
}

// Whether a symbolic link at `linkPath` (relative to the package root) pointing at `target` leaves the package: an
// absolute target, or `..` steps that climb above the root.
fun bootstrapPackageSymlinkEscapes(linkPath: string, target: string): bool {
    if (target.size == 0 || target[0] == 47) return true
    var depth = 0
    val directory = linkPath.split("/")
    var index = 0
    while (index + 1 < directory.size) {
        depth = depth + 1
        index = index + 1
    }
    var escapes = false
    for (part in target.split("/")) {
        if (part == "..") {
            depth = depth - 1
            if (depth < 0) escapes = true
        } else if (part != "." && part != "") {
            depth = depth + 1
        }
    }
    escapes
}

// The root of the dependency copy (`.../.abla/packages/<name>/source` or a checked-in `.../vendor/<name>`) a module path
// lies in, or "".
fun bootstrapPackageCopyRootOf(path: string): string {
    // `lead` makes a relative path (`.abla/packages/x/source/y.ab`, `vendor/x/y.ab`) look like an absolute one.
    val lead = if (path.startsWith("/")) "" else "/"
    val full = "$lead$path"
    var root = ""
    val prepared = full.indexOf("/.abla/packages/")
    if (prepared >= 0) {
        val nameBegin = prepared + 16
        val nameEnd = full.indexOf("/", nameBegin)
        if (nameEnd > nameBegin && full.slice(nameEnd, nameEnd + 8) == "/source/") root = full.slice(0, nameEnd + 7)
    } else {
        val vendor = full.indexOf("/vendor/")
        if (vendor >= 0) {
            val nameBegin = vendor + 8
            val nameEnd = full.indexOf("/", nameBegin)
            if (nameEnd > nameBegin && Path("${full.slice(lead.size, nameEnd)}/.abla-revision").exists()) root = full.slice(0, nameEnd)
        }
    }
    if (root == "") "" else root.slice(lead.size, root.size)
}

// Publishes the finished entry `temporary` as `root` (the cache path of `package`) by rename. An entry already there that is valid is another build's
// identical one: it stays, and `temporary` is dropped (removing it first broke the build reading it, and made the loser of two parallel fills fail). One that
// is not valid is moved aside, then removed. Group and others cannot write what is published, whatever the umask.
fun bootstrapPackagePublishEntry(temporary: string, root: string, package: BootstrapLockedPackage): bool {
    if (!linuxHostIsWindows()) {
        val chmod = linuxCommand("chmod")
        chmod.argument("-R")
        // BSD chmod ends option parsing at the mode.
        chmod.argument("--")
        chmod.argument("go-w")
        chmod.argument(temporary)
        if (chmod.run() != 0) return false
    }
    var aside = ""
    if (Path(root).exists()) {
        if (bootstrapPackageCacheValid(package)) {
            bootstrapPackageRemoveTree(temporary)
            return true
        }
        aside = "$root.old.${linuxProcessId()}"
        bootstrapPackageRemoveTree(aside)
        if (!Path(root).moveTo(Path(aside))) aside = ""
    }
    var moved = Path(temporary).moveTo(Path(root))
    if (!moved && bootstrapPackageCacheValid(package)) {
        bootstrapPackageRemoveTree(temporary)
        moved = true
    }
    if (aside != "") bootstrapPackageRemoveTree(aside)
    moved
}

// Whether the module at `path` is reached through a symbolic link of its dependency copy that leaves the package. An
// import inside a dependency (`import "leak.ab"`, `leak.ab -> /home/me/.ssh/id`) would otherwise read the target as
// source.
fun bootstrapPackageImportThroughEscapingLink(path: string): bool {
    val root = bootstrapPackageCopyRootOf(path)
    var escapes = false
    if (root != "") {
        val relative = path.slice(root.size + 1, path.size)
        var prefix = 0
        while (prefix <= relative.size && !escapes) {
            if (prefix == relative.size || relative[prefix] == 47) {
                val part = relative.slice(0, prefix)
                val link = Path("$root/$part")
                if (part != "" && link.isSymbolicLink() && bootstrapPackageSymlinkEscapes(part, link.linkTarget())) escapes = true
            }
            prefix = prefix + 1
        }
    }
    escapes
}

// A limit from the environment that can only lower the default (the tests use small ones): a value outside 64 KiB .. the default is the default.
private fun bootstrapPackageLimit(name: string, ceiling: int): int {
    val configured = linuxEnvironment(name).value.parseInt() ?? 0
    if (configured >= 65536 && configured <= ceiling) configured else ceiling
}

/** The most a package's files may add up to once checked out: 128 MiB, or ABLA_PACKAGE_CHECKOUT_LIMIT_BYTES when that is lower. */
fun bootstrapPackageCheckoutLimit(): int = bootstrapPackageLimit("ABLA_PACKAGE_CHECKOUT_LIMIT_BYTES", 134217728)

/** The most one file git writes while fetching a dependency may hold (the received pack is one file): 1 GiB, or ABLA_PACKAGE_GIT_MAX_BYTES when that is lower. */
fun bootstrapPackageFetchLimit(): int = bootstrapPackageLimit("ABLA_PACKAGE_GIT_MAX_BYTES", 1073741824)

/** `command` run by a shell that first stops it from writing a file of more than `bytes`: git then dies on the write instead of filling the disk (the units of
 *  sh's ulimit -f are 512-byte blocks in POSIX shells). On Windows the command is as it was. */
fun bootstrapPackageLimitedFiles(command: LinuxCommand, bytes: int): LinuxCommand {
    val prefix: array<string> = if (linuxHostIsWindows()) [] else ["sh", "-c", "ulimit -f ${bytes / 512} 2>/dev/null; exec \"\$@\"", "sh"]
    val wrapped = LinuxCommand(prefix, command.overrides, command.workingDirectory, command.inputPath, command.outputPath, command.errorPath, command.removed)
    for (argument in command.arguments) wrapped.arguments.append(argument)
    wrapped
}

class BootstrapPackageTreeVerdict(val code: string, val reason: string)

val BOOTSTRAP_PACKAGE_TREE_MAX_FILES = 50000
val BOOTSTRAP_PACKAGE_TREE_MAX_PATH = 1024
val BOOTSTRAP_PACKAGE_TREE_MAX_DEPTH = 64
val BOOTSTRAP_PACKAGE_TREE_LISTING_KIB = 65536

// Whether the tree of `revision` in the fetched repository at `repository` may be checked out, decided from the tree's own objects before a byte of it is
// written (a blob of zeros is a few kilobytes in a pack and gigabytes on disk; one tree listed from many parents is a billion files). The listing is
// written to `listingPath` by a git process whose files cannot grow past 32 MiB, so a tree that expands without bound ends the listing, not the build. A
// package's checkout holds at most 50,000 files of at most 128 MiB together, regular files and symbolic links only (a submodule would be an empty directory
// the digest names a commit for), paths of at most 1024 bytes and 64 components with no control character in them.
fun bootstrapPackageTreeVerdict(repository: string, revision: string, listingPath: string): BootstrapPackageTreeVerdict {
    val limit = bootstrapPackageCheckoutLimit()
    val git = bootstrapPackageGit()
    git.argument("-C")
    git.argument(repository)
    git.argument("ls-tree")
    git.argument("-r")
    git.argument("-l")
    git.argument("-z")
    git.argument(revision)
    git.output(listingPath)
    val status = bootstrapPackageLimitedFiles(git, BOOTSTRAP_PACKAGE_TREE_LISTING_KIB * 512).run()
    if (status != 0) {
        return BootstrapPackageTreeVerdict("E_PACKAGE_SIZE", "has a listing that cannot be read or is larger than 32 MiB")
    }
    val records = bootstrapPackageSplitNul(Path(listingPath).readText())
    var files = 0
    var total = 0
    for (record in records) {
        val tab = record.indexOf("\t")
        if (tab < 0) return BootstrapPackageTreeVerdict("E_PACKAGE_TREE", "has an entry git does not list as mode, type, object, size and path")
        val fields = bootstrapPackageTrim(record.slice(0, tab)).split(" ")
        val path = record.slice(tab + 1, record.size)
        val mode = if (fields.size > 0) fields[0] else ""
        if (mode == "160000") return BootstrapPackageTreeVerdict("E_PACKAGE_TREE", "has a submodule ('$path'); a package holds its own files only")
        if (mode != "100644" && mode != "100755" && mode != "120000") {
            return BootstrapPackageTreeVerdict("E_PACKAGE_TREE", "has an entry of mode $mode ('$path'); only regular files and symbolic links are packages' files")
        }
        var depth = 1
        var index = 0
        while (index < path.size) {
            val byte = path[index]
            if (byte < 32 || byte == 127) return BootstrapPackageTreeVerdict("E_PACKAGE_TREE", "has a path with a control character in it")
            if (byte == 47) depth = depth + 1
            index = index + 1
        }
        if (path.size > BOOTSTRAP_PACKAGE_TREE_MAX_PATH || depth > BOOTSTRAP_PACKAGE_TREE_MAX_DEPTH) {
            return BootstrapPackageTreeVerdict("E_PACKAGE_SIZE", "has a path of more than ${BOOTSTRAP_PACKAGE_TREE_MAX_PATH} bytes or ${BOOTSTRAP_PACKAGE_TREE_MAX_DEPTH} levels")
        }
        files = files + 1
        if (files > BOOTSTRAP_PACKAGE_TREE_MAX_FILES) {
            return BootstrapPackageTreeVerdict("E_PACKAGE_SIZE", "has more than ${BOOTSTRAP_PACKAGE_TREE_MAX_FILES} files")
        }
        val sizeText = if (fields.size > 3) fields[fields.size - 1] else ""
        var size = 0
        var place = 0
        while (place < sizeText.size && sizeText[place] >= 48 && sizeText[place] <= 57 && size <= limit) {
            size = size * 10 + sizeText[place] - 48
            place = place + 1
        }
        total = total + size
        if (total > limit) return BootstrapPackageTreeVerdict("E_PACKAGE_SIZE", "holds more than ${limit / 1048576} MiB of files")
    }
    BootstrapPackageTreeVerdict("", "")
}

fun bootstrapPackageFetch(
    dependency: BootstrapPackageDependency,
    revision: string
): BootstrapPackageResult {
    val placeholder = BootstrapLockedPackage(
        dependency.name, "git", dependency.identity, dependency.source,
        dependency.selectorKind, dependency.selector, revision,
        "0000000000000000000000000000000000000000", "entry.ab"
    )
    val root = bootstrapPackageCachePath(placeholder)
    val temporary = "$root.tmp.${linuxProcessId()}"
    bootstrapPackageRemoveTree(temporary)
    var status = 0
    var diagnostic = ""
    if (!Path(temporary).parent().createDirectories(0o755)) status = 1
    if (status == 0) {
        val init = bootstrapPackageGit()
        init.argument("init")
        init.argument("--quiet")
        init.argument("--object-format=sha1")
        init.argument("$temporary/source")
        if (init.run() != 0) status = 1
    }
    if (status == 0) {
        // info/attributes outranks the tree's own .gitattributes: the checkout is the blobs as they are.
        if (!bootstrapPackageRawAttributes("$temporary/source/.git")) status = 1
    }
    if (status == 0) {
        val remote = bootstrapPackageGit()
        remote.argument("-C")
        remote.argument("$temporary/source")
        remote.argument("remote")
        remote.argument("add")
        remote.argument("--")
        remote.argument("origin")
        remote.argument(dependency.source)
        if (remote.run() != 0) status = 1
    }
    if (status == 0) {
        val fetch = bootstrapPackageGit()
        fetch.argument("-C")
        fetch.argument("$temporary/source")
        fetch.argument("-c")
        fetch.argument("transfer.fsckObjects=true")
        fetch.argument("-c")
        fetch.argument("fetch.unpackLimit=1")
        fetch.argument("-c")
        fetch.argument("transfer.unpackLimit=1")
        fetch.argument("fetch")
        fetch.argument("--quiet")
        fetch.argument("--depth")
        fetch.argument("1")
        fetch.argument("--no-tags")
        fetch.argument("--")
        fetch.argument("origin")
        fetch.argument(revision)
        val seconds = bootstrapPackageGitTimeoutSeconds()
        val limited = bootstrapPackageLimitedFiles(fetch, bootstrapPackageFetchLimit())
        val fetched = if (linuxHostIsWindows()) LinuxProcessResult(limited.run(), "")
            else bootstrapPackageCaptureGit(limited, seconds)
        if (fetched.status != 0) {
            status = 1
            // git was stopped by the file limit when what it received (one pack file) reached it.
            if (!fetched.timedOut && bootstrapPackageDirectorySize(Path("$temporary/source/.git/objects"), bootstrapPackageFetchLimit()) >= bootstrapPackageFetchLimit() - 1024) {
                diagnostic = "error[E_PACKAGE_SIZE]: dependency '${dependency.name}', revision '$revision': what the fetch received is larger than ${bootstrapPackageFetchLimit() / 1048576} MiB (ABLA_PACKAGE_GIT_MAX_BYTES lowers the limit)\n"
            }
        }
        if (fetched.timedOut) diagnostic = bootstrapPackageGitTimeout(dependency, "fetch", seconds)
    }
    if (status == 0) {
        val verdict = bootstrapPackageTreeVerdict("$temporary/source", revision, "$temporary/listing")
        if (verdict.code != "") {
            status = 1
            diagnostic = "error[${verdict.code}]: dependency '${dependency.name}', revision '$revision': its tree ${verdict.reason}\n"
        }
        bootstrapPackageRemoveTree("$temporary/listing")
    }
    if (status == 0) {
        val checkout = bootstrapPackageGit()
        checkout.argument("-C")
        checkout.argument("$temporary/source")
        checkout.argument("checkout")
        checkout.argument("--quiet")
        checkout.argument("--detach")
        checkout.argument(revision)
        if (checkout.run() != 0) status = 1
    }
    var digest = ""
    if (status == 0) {
        if (bootstrapPackageGitValue("$temporary/source", "HEAD") != revision) status = 1
        else digest = bootstrapPackageGitValue("$temporary/source", "HEAD^{tree}")
    }
    // A dependency's abla.toml outside the grammar of src/manifest_grammar.ab is refused before it is cached or locked.
    if (status == 0 && Path("$temporary/source/abla.toml").exists()) {
        val grammar = bootstrapManifestGrammarProblem(Path("$temporary/source/abla.toml").readText(), false)
        if (grammar != "") {
            status = 1
            diagnostic =
                "error[E_PACKAGE_MANIFEST]: dependency '${dependency.name}', revision '$revision': its abla.toml, $grammar (the compiler reads only the lines of abla.toml it understands: one-line values, no multi-line strings, escapes or trailing comments, the known keys at the top, once)\n"
        }
    }
    // The checkout must be the revision's tree: on a file system that folds case or Unicode forms, two paths that
    // differ only so collapse to one file, and the digest (the tree's) would then name files the build never reads.
    if (status == 0) {
        val state = bootstrapPackageGit()
        state.argument("-C")
        state.argument("$temporary/source")
        state.argument("status")
        state.argument("--porcelain")
        val observed = state.capture()
        if (observed.status != 0 || bootstrapPackageTrim(observed.output) != "") {
            status = 1
            diagnostic =
                "error[E_PACKAGE_DIGEST_MISMATCH]: dependency '${dependency.name}', revision '$revision': its checkout on this file system is not the revision's tree (paths that differ only in case or Unicode form collapse to one file here, or a file could not be written)\n"
        }
    }
    if (status == 0 && bootstrapPackageDirectorySize(
        Path("$temporary/source"), bootstrapPackageCheckoutLimit()
    ) > bootstrapPackageCheckoutLimit()) {
        status = 1
        diagnostic =
            "error[E_PACKAGE_SIZE]: dependency '${dependency.name}' at ${dependency.source} exceeds the 128 MiB checkout limit\n"
    }
    if (status == 0) {
        var written = Path("$temporary/source-url").writeText(dependency.source)
        if (written) written = Path("$temporary/provider").writeText("git")
        if (written) written = Path("$temporary/identity").writeText(
            dependency.identity
        )
        if (written) written = Path("$temporary/revision").writeText(revision)
        if (written) written = Path("$temporary/digest").writeText(digest)
        if (!written) status = 1
    }
    if (status == 0) {
        val published = BootstrapLockedPackage(
            dependency.name, "git", dependency.identity, dependency.source,
            dependency.selectorKind, dependency.selector, revision, digest, "entry.ab"
        )
        if (!bootstrapPackagePublishEntry(temporary, root, published)) status = 1
    }
    if (status != 0) {
        bootstrapPackageRemoveTree(temporary)
        if (diagnostic == "") {
            diagnostic =
                "error[E_PACKAGE_FETCH]: dependency '${dependency.name}', selector ${dependency.selectorKind}='${dependency.selector}', revision '$revision', source '${dependency.source}' could not be fetched and validated\n"
        }
    }
    BootstrapPackageResult(status, diagnostic)
}

fun bootstrapPackagePublishContent(
    dependency: BootstrapPackageDependency
): BootstrapPackageContentResult {
    val base = "${bootstrapPackageCacheRoot()}/content/${dependency.name}"
    val temporary = "$base/.tmp.${linuxProcessId()}"
    bootstrapPackageRemoveTree(temporary)
    var status = 0
    var diagnostic = ""
    var total = 0
    var entryFound = false
    var manifestFound = false
    var fileIndex = 0
    while (status == 0 && fileIndex < dependency.resolvedFiles.size) {
        val file = dependency.resolvedFiles[fileIndex]
        if (!bootstrapPackageRelativePathValid(file.path)) status = 1
        if (dependency.resolvedFiles.size > BOOTSTRAP_PACKAGE_TREE_MAX_FILES) status = 1
        val folded = file.path.lowercase()
        var previous = 0
        while (status == 0 && previous < fileIndex) {
            if (dependency.resolvedFiles[previous].path == file.path || dependency.resolvedFiles[previous].path.lowercase() == folded) status = 1
            previous = previous + 1
        }
        total = total + file.path.size + file.contents.size
        if (total > bootstrapPackageCheckoutLimit()) status = 1
        if (file.path == dependency.resolvedEntry) entryFound = true
        if (file.path == "abla.toml") manifestFound = true
        if (status == 0 && !Path("$temporary/source/${file.path}").writeText(
            file.contents
        )) status = 1
        fileIndex = fileIndex + 1
    }
    if (!entryFound || !manifestFound ||
        dependency.resolvedFiles.size == 0) status = 1
    if (status == 0) {
        val init = bootstrapPackageGit()
        init.argument("init")
        init.argument("--quiet")
        init.argument("--object-format=sha1")
        init.argument("$temporary/source")
        if (init.run() != 0) status = 1
    }
    if (status == 0 && !bootstrapPackageRawAttributes("$temporary/source/.git")) status = 1
    if (status == 0) {
        val add = bootstrapPackageGit()
        add.argument("-C")
        add.argument("$temporary/source")
        add.argument("add")
        add.argument("--all")
        if (add.run() != 0) status = 1
    }
    // Every file is where the provider put it: a host whose file system folds case or Unicode forms would otherwise hold fewer files than the digest names.
    if (status == 0) {
        val listed = bootstrapPackageGit()
        listed.argument("-C")
        listed.argument("$temporary/source")
        listed.argument("ls-files")
        listed.argument("-z")
        val names = listed.capture()
        if (names.status != 0 || bootstrapPackageSplitNul(names.output).size != dependency.resolvedFiles.size) status = 1
    }
    var digest = ""
    if (status == 0) digest = bootstrapPackageGitWriteTree(
        "$temporary/source"
    )
    if (!bootstrapPackageHexRevision(digest)) status = 1
    if (status == 0) {
        var written = Path("$temporary/provider").writeText("content")
        if (written) written = Path("$temporary/identity").writeText(
            dependency.identity
        )
        if (written) written = Path("$temporary/revision").writeText(
            dependency.resolvedRevision
        )
        if (written) written = Path("$temporary/digest").writeText(digest)
        if (!written) status = 1
    }
    var source = ""
    if (status == 0) {
        val root = "$base/$digest"
        val published = BootstrapLockedPackage(
            dependency.name, "content", dependency.identity, "", "", "",
            dependency.resolvedRevision, digest, dependency.resolvedEntry
        )
        if (!bootstrapPackagePublishEntry(temporary, root, published)) status = 1
        if (status == 0) source = "$root/source"
    }
    if (status != 0) {
        bootstrapPackageRemoveTree(temporary)
        diagnostic =
            "error[E_IMPORT_PROVIDER_RESOLUTION]: provider '${dependency.identity}' returned invalid, duplicate, oversized, or unpublishable source files for dependency '${dependency.name}'\n"
    }
    BootstrapPackageContentResult(status, diagnostic, digest, source)
}

fun bootstrapPackageManifestString(manifestPath: string, key: string): string {
    val source = bootstrapManifestText(manifestPath, false)
    var result = ""
    var lineBegin = 0
    while (lineBegin < source.size && result == "") {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        result = bootstrapPackageTomlField(
            bootstrapPackageTrim(source.slice(lineBegin, lineEnd)), key
        )
        lineBegin = lineEnd + 1
        if (lineBegin < source.size && source[lineBegin - 1] == 13 &&
            source[lineBegin] == 10) lineBegin = lineBegin + 1
    }
    result
}

fun bootstrapPackageManifestStringArray(
    manifestPath: string,
    key: string
): array<string> {
    val values: array<string> = []
    val source = bootstrapManifestText(manifestPath, false)
    var cursor = -1
    var lineBegin = 0
    while (lineBegin < source.size && cursor < 0) {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var equals = lineBegin
        while (equals < lineEnd && source[equals] != 61) equals = equals + 1
        val foundKey = bootstrapPackageTrim(source.slice(lineBegin, equals))
        if (equals < lineEnd && foundKey == key) {
            var value = equals + 1
            while (value < lineEnd &&
                   (source[value] == 32 || source[value] == 9)) {
                value = value + 1
            }
            if (value < lineEnd && source[value] == 91) cursor = value + 1
        }
        lineBegin = lineEnd + 1
    }
    var complete = false
    while (cursor >= 0 && cursor < source.size && !complete) {
        while (cursor < source.size &&
               (source[cursor] == 32 || source[cursor] == 9 ||
                source[cursor] == 10 || source[cursor] == 13 ||
                source[cursor] == 44)) cursor = cursor + 1
        if (cursor < source.size && source[cursor] == 35) {
            while (cursor < source.size && source[cursor] != 10 &&
                   source[cursor] != 13) cursor = cursor + 1
        } else if (cursor < source.size && source[cursor] == 93) {
            complete = true
        } else if (cursor < source.size && source[cursor] == 34) {
            val begin = cursor + 1
            cursor = begin
            while (cursor < source.size && source[cursor] != 34 &&
                   source[cursor] != 10 && source[cursor] != 13) {
                cursor = cursor + 1
            }
            if (cursor < source.size && source[cursor] == 34) {
                values.append(source.slice(begin, cursor))
                cursor = cursor + 1
            } else complete = true
        } else complete = true
    }
    values
}

fun bootstrapPackageStringsContain(
    values: array<string>,
    wanted: string
): bool {
    var found = false
    var index = 0
    while (index < values.size) {
        if (values[index] == wanted) found = true
        index = index + 1
    }
    found
}

fun bootstrapPackageCheckoutValid(
    source: string,
    package: BootstrapLockedPackage
): bool = Path(source).info().isDirectory() && bootstrapPackageDirectoryDigest(source, false) == package.digest

fun bootstrapPackageValidateCapabilityPolicy(
    projectRoot: string,
    packages: array<BootstrapLockedPackage>,
    materialized: bool
): BootstrapPackageResult {
    val manifest = Path(projectRoot).child("abla.toml")
    val authorized = bootstrapPackageManifestStringArray(
        manifest.text, "compileCapabilities"
    )
    var status = 0
    var diagnostic = ""
    var packageIndex = 0
    while (status == 0 && packageIndex < packages.size) {
        val package = packages[packageIndex]
        var source = "${bootstrapPackageCachePath(package)}/source"
        if (materialized) {
            source = "$projectRoot/.abla/packages/${package.name}/source"
        }
        val requested = bootstrapPackageManifestStringArray(
            "$source/abla.toml", "compileCapabilities"
        )
        var capability = 0
        while (status == 0 && capability < requested.size) {
            if (!bootstrapPackageStringsContain(
                authorized, requested[capability]
            )) {
                status = 1
                diagnostic =
                    "error[E_PACKAGE_CAPABILITY_DENIED]: dependency '${package.name}', locked revision '${package.revision}', ImportSource '${package.identity}' requested compile capability '${requested[capability]}' that is not authorized by root manifest '${manifest.text}'\n"
            }
            capability = capability + 1
        }
        packageIndex = packageIndex + 1
    }
    BootstrapPackageResult(status, diagnostic)
}

fun bootstrapPackageAuthorizedEffects(projectRoot: string): int {
    val capabilities = bootstrapPackageManifestStringArray(
        Path(projectRoot).child("abla.toml").text,
        "compileCapabilities"
    )
    var effects = 0
    var index = 0
    while (index < capabilities.size) {
        effects = bootstrapCompileEffectMerge(
            effects,
            bootstrapCompileEffectFromName(capabilities[index])
        )
        index = index + 1
    }
    effects
}

fun bootstrapPackageStackContains(stack: array<string>, name: string): bool {
    var found = false
    var index = 0
    while (index < stack.size) {
        if (stack[index] == name) found = true
        index = index + 1
    }
    found
}

// The `[exports]` table of a package's manifest: which subpaths it makes public,
// and the module each is. `found` says whether it has one.
class BootstrapPackageExports(
    val found: bool,
    val names: array<string>,
    val targets: array<string>
)

fun bootstrapPackageReadExports(manifestPath: string): BootstrapPackageExports {
    val names: array<string> = []
    val targets: array<string> = []
    val source = bootstrapManifestText(manifestPath, false)
    var found = false
    var inExports = false
    var begin = 0
    while (begin < source.size) {
        var end = begin
        while (end < source.size && source[end] != 10 && source[end] != 13) end = end + 1
        val line = bootstrapPackageTrim(source.slice(begin, end))
        if (line.size > 0 && line[0] == 91) {
            inExports = line == "[exports]"
            if (inExports) found = true
        } else if (inExports && line.size > 0 && line[0] == 34) {
            var close = 1
            while (close < line.size && line[close] != 34) close = close + 1
            val rest = if (close < line.size) line.slice(close + 1, line.size) else ""
            var open = 0
            while (open < rest.size && rest[open] != 34) open = open + 1
            var last = rest.size - 1
            while (last > open && rest[last] != 34) last = last - 1
            if (last > open) {
                names.append(line.slice(1, close))
                targets.append(rest.slice(open + 1, last))
            }
        }
        begin = end + 1
    }
    BootstrapPackageExports(found, names, targets)
}

class BootstrapPackageSubpath(val path: string, val diagnostic: string)

// The module `subpath` names in the package at `root`: what `[exports]` says when
// the manifest has that table, otherwise, as in the standard library,
// `<subpath>/entry.ab` and then `<subpath>.ab` beside the package's entry.
fun bootstrapPackageFindSubpath(root: string, name: string,
    subpath: string): BootstrapPackageSubpath {
    val manifest = "$root/abla.toml"
    val exports = bootstrapPackageReadExports(manifest)
    var candidates: array<string> = []
    var looked = ""
    if (exports.found) {
        var target = ""
        for (index in 0 until exports.names.size) {
            if (exports.names[index] == subpath) target = exports.targets[index]
        }
        if (target == "") {
            var public = ""
            for (exported in exports.names) public = if (public ==
                "") exported else "$public, $exported"
            return BootstrapPackageSubpath("",
                "error[E_PACKAGE_SUBPATH_PRIVATE]: package '$name' doesn't export `$subpath`; its [exports] are: $public\n")
        }
        if (!bootstrapPackageRelativePathValid(target)) {
            return BootstrapPackageSubpath("",
                "error[E_PACKAGE_SUBPATH_INVALID]: package '$name' exports `$subpath` as `$target`, which isn't a path inside it\n")
        }
        candidates.append(target)
    } else {
        val entry = bootstrapPackageManifestString(manifest, "entry")
        val written = if (entry == "") "src/$name.ab" else entry
        val directory = Path(written).parent().text
        val base = if (directory == "." || directory == "") subpath else "$directory/$subpath"
        candidates.append("$base/entry.ab")
        candidates.append("$base.ab")
    }
    for (candidate in candidates) {
        looked = if (looked == "") candidate else "$looked, $candidate"
        // A link could lead out of the package, whatever the path says.
        var prefix = 0
        while (prefix <= candidate.size) {
            if (prefix == candidate.size || candidate[prefix] == 47) {
                if (Path("$root/${candidate.slice(0, prefix)}").isSymbolicLink()) {
                    return BootstrapPackageSubpath("",
                        "error[E_PACKAGE_SUBPATH_INVALID]: `$subpath` in package '$name' goes through a symbolic link, `${candidate.slice(0, prefix)}`\n")
                }
            }
            prefix = prefix + 1
        }
        if (Path("$root/$candidate").info().isFile()) {
            return BootstrapPackageSubpath("$root/$candidate", "")
        }
    }
    BootstrapPackageSubpath("",
        "error[E_PACKAGE_SUBPATH_MISSING]: package '$name' has no module `$subpath` (looked for $looked)\n")
}

// The providers that the subpaths a dependency is imported by reach, resolved too:
// its entry doesn't have to import those modules.
fun bootstrapPackageResolveSubpaths(
    dependency: BootstrapPackageDependency,
    cacheSource: string,
    var packages: array<BootstrapLockedPackage>,
    nestedStack: array<string>,
    resolveEffects: int
): BootstrapPackageResult {
    for (subpath in dependency.subpaths) {
        val found = bootstrapPackageFindSubpath(cacheSource, dependency.name, subpath)
        if (found.diagnostic != "") return BootstrapPackageResult(1, found.diagnostic)
        val imported = bootstrapPackageDiscoverImportProviders(found.path, true, resolveEffects)
        if (imported.errors != 0) return BootstrapPackageResult(1, imported.diagnostic)
        for (transitive in imported.values) {
            val resolved = bootstrapPackageResolveOne(transitive, packages, nestedStack,
                resolveEffects)
            if (resolved.status != 0) return resolved
        }
    }
    BootstrapPackageResult(0, "")
}

fun bootstrapPackageResolveOne(
    dependency: BootstrapPackageDependency,
    var packages: array<BootstrapLockedPackage>,
    stack: array<string>,
    resolveEffects: int,
    gitRevision: string = ""
): BootstrapPackageResult {
    var status = 0
    var diagnostic = ""
    val existing = bootstrapPackageLockIndex(packages, dependency.name)
    if (bootstrapPackageStackContains(stack, dependency.name)) {
        status = 1
        diagnostic =
            "error[E_PACKAGE_CYCLE]: dependency cycle reaches '${dependency.name}' from ImportSource '${dependency.identity}' selector '${dependency.selector}'\n"
    }
    if (status == 0 && existing >= 0) {
        val found = packages[existing]
        if (found.provider != dependency.provider ||
            found.identity != dependency.identity ||
            found.source != dependency.source ||
            found.selectorKind != dependency.selectorKind ||
            found.selector != dependency.selector) {
            status = 1
            diagnostic =
                "error[E_PACKAGE_COLLISION]: dependency '${dependency.name}' has incompatible ImportSource identities or selectors ('${found.identity}' versus '${dependency.identity}')\n"
        }
        // Another importer may reach other modules of it, with their own providers.
        if (status == 0) {
            val nestedStack: array<string> = []
            for (name in stack) nestedStack.append(name)
            nestedStack.append(dependency.name)
            val resolved = bootstrapPackageResolveSubpaths(
                dependency, "${bootstrapPackageCachePath(found)}/source",
                packages, nestedStack, resolveEffects
            )
            status = resolved.status
            diagnostic = resolved.diagnostic
        }
    }
    if (status == 0 && existing < 0) {
        val nestedStack: array<string> = []
        var stackIndex = 0
        while (stackIndex < stack.size) {
            nestedStack.append(stack[stackIndex])
            stackIndex = stackIndex + 1
        }
        nestedStack.append(dependency.name)
        var revision = dependency.resolvedRevision
        var digest = ""
        var cacheSource = ""
        var entry = dependency.resolvedEntry
        if (dependency.provider == "git") {
            if (gitRevision != "") revision = gitRevision
            else {
                val resolved = bootstrapPackageResolveRevision(dependency)
                revision = resolved.revision
                diagnostic = resolved.diagnostic
            }
            if (revision == "") {
                status = 1
                if (diagnostic == "") diagnostic =
                    "error[E_PACKAGE_RESOLVE]: dependency '${dependency.name}', selector ${dependency.selectorKind}='${dependency.selector}', source '${dependency.source}' did not resolve to an immutable revision\n"
            }
        }
        if (status == 0 && dependency.provider == "git") {
            val placeholder = BootstrapLockedPackage(
                dependency.name, "git", dependency.identity,
                dependency.source, dependency.selectorKind,
                dependency.selector, revision,
                "0000000000000000000000000000000000000000", "entry.ab"
            )
            cacheSource = "${bootstrapPackageCachePath(placeholder)}/source"
            val cacheRoot = bootstrapPackageCachePath(placeholder)
            if (Path(cacheSource).info().isDirectory() &&
                Path("$cacheRoot/source-url").readText() !=
                    dependency.source) {
                bootstrapPackageRemoveTree(cacheRoot)
            }
            if (!Path(cacheSource).info().isDirectory()) {
                val fetched = bootstrapPackageFetch(dependency, revision)
                status = fetched.status
                diagnostic = fetched.diagnostic
            }
            if (status == 0) digest = bootstrapPackageGitValue(cacheSource, "HEAD^{tree}")
        }
        if (status == 0 && dependency.provider == "content") {
            if (revision == "" || entry == "" ||
                dependency.resolvedFiles.size == 0) {
                status = 1
                diagnostic =
                    "error[E_IMPORT_PROVIDER_RESOLUTION]: ImportSource '${dependency.identity}' did not resolve revision, entry, and files\n"
            }
            if (status == 0) {
                val published = bootstrapPackagePublishContent(dependency)
                status = published.status
                diagnostic = published.diagnostic
                digest = published.digest
                cacheSource = published.source
            }
        }
        val manifest = "$cacheSource/abla.toml"
        var packageName = ""
        if (status == 0) {
            packageName = bootstrapPackageManifestString(manifest, "name")
            val manifestEntry = bootstrapPackageManifestString(
                manifest, "entry"
            )
            if (entry == "") entry = manifestEntry
            if (entry == "") entry = "src/${dependency.name}.ab"
            if (packageName != dependency.name ||
                (manifestEntry != "" && manifestEntry != entry) ||
                !bootstrapPackageRelativePathValid(entry) ||
                !Path("$cacheSource/$entry").exists()) {
                status = 1
                diagnostic =
                    "error[E_PACKAGE_ENTRY]: dependency '${dependency.name}', ImportSource '${dependency.identity}', revision '$revision' has an invalid manifest name or missing entry '$entry'\n"
            }
        }
        if (status == 0) {
            val locked = BootstrapLockedPackage(
                dependency.name, dependency.provider, dependency.identity,
                dependency.source, dependency.selectorKind,
                dependency.selector, revision, digest, entry
            )
            val cacheRoot = bootstrapPackageCachePath(locked)
            Path("$cacheRoot/provider").writeText(dependency.provider)
            Path("$cacheRoot/identity").writeText(dependency.identity)
            Path("$cacheRoot/revision").writeText(revision)
            if (dependency.provider == "git") {
                Path("$cacheRoot/source-url").writeText(dependency.source)
            }
            Path("$cacheRoot/digest").writeText(digest)
            val declared = bootstrapPackageManifestDependencies(manifest)
            val imported = bootstrapPackageDiscoverImportProviders(
                "$cacheSource/$entry", true, resolveEffects
            )
            val transitive = bootstrapPackageMergeDependencies(
                declared, imported
            )
            if (transitive.errors != 0) {
                status = 1
                diagnostic = transitive.diagnostic
            }
            var index = 0
            while (status == 0 && index < transitive.values.size) {
                val resolved = bootstrapPackageResolveOne(
                    transitive.values[index], packages, nestedStack,
                    resolveEffects
                )
                status = resolved.status
                diagnostic = resolved.diagnostic
                index = index + 1
            }
            if (status == 0) {
                val resolved = bootstrapPackageResolveSubpaths(
                    dependency, cacheSource, packages, nestedStack, resolveEffects
                )
                status = resolved.status
                diagnostic = resolved.diagnostic
            }
            if (status == 0) packages.append(locked)
        }
    }
    BootstrapPackageResult(status, diagnostic)
}

fun bootstrapPackageWriteLock(
    lockPath: string,
    packages: array<BootstrapLockedPackage>
): bool {
    var output = "version = 2\n"
    var index = 0
    while (index < packages.size) {
        val package = packages[index]
        output = "$output\n[[package]]\n"
        output = "${output}name = \"${package.name}\"\n"
        output = "${output}provider = \"${package.provider}\"\n"
        output = "${output}identity = \"${package.identity}\"\n"
        output = "${output}source = \"${package.source}\"\n"
        output = "${output}selector-kind = \"${package.selectorKind}\"\n"
        output = "${output}selector = \"${package.selector}\"\n"
        output = "${output}revision = \"${package.revision}\"\n"
        output = "${output}digest = \"${package.digest}\"\n"
        output = "${output}entry = \"${package.entry}\"\n"
        index = index + 1
    }
    Path(lockPath).writeTextAtomic(output)
}

fun bootstrapPackageUpdateWithDependencies(
    projectRoot: string,
    imported: BootstrapPackageDependencies
): BootstrapPackageResult {
    val manifest = Path(projectRoot).child("abla.toml")
    val dependencies = bootstrapPackageMergeDependencies(
        bootstrapPackageManifestDependencies(manifest.text), imported
    )
    val packages: array<BootstrapLockedPackage> = []
    var status = if (dependencies.errors == 0) 0 else 1
    var diagnostic = dependencies.diagnostic
    val resolveEffects = bootstrapPackageAuthorizedEffects(projectRoot)
    var index = 0
    while (status == 0 && index < dependencies.values.size) {
        val stack: array<string> = []
        val resolved = bootstrapPackageResolveOne(
            dependencies.values[index], packages, stack, resolveEffects
        )
        status = resolved.status
        diagnostic = resolved.diagnostic
        index = index + 1
    }
    if (status == 0) {
        val policy = bootstrapPackageValidateCapabilityPolicy(
            projectRoot, packages, false
        )
        status = policy.status
        diagnostic = policy.diagnostic
    }
    if (status == 0 && !bootstrapPackageWriteLock(
        Path(projectRoot).child("abla.lock").text, packages
    )) {
        status = 1
        diagnostic =
            "error[E_PACKAGE_LOCK_WRITE]: could not publish lockfile for project '$projectRoot'\n"
    }
    if (status == 0) {
        val prepared = bootstrapPackagePrepareWithDependencies(
            projectRoot, imported, false
        )
        status = prepared.status
        diagnostic = prepared.diagnostic
    }
    BootstrapPackageResult(status, diagnostic)
}

fun bootstrapPackageDependencyMatches(
    dependency: BootstrapPackageDependency,
    package: BootstrapLockedPackage
): bool = dependency.name == package.name &&
    dependency.provider == package.provider &&
    dependency.identity == package.identity &&
    dependency.source == package.source &&
    dependency.selectorKind == package.selectorKind &&
    dependency.selector == package.selector

fun bootstrapPackageValidateDependencies(
    projectRoot: string,
    dependencies: BootstrapPackageDependencies,
    packages: array<BootstrapLockedPackage>,
    var visited: array<string>,
    stack: array<string>,
    // "package/subpath" for those walked: another importer may name others.
    var walkedSubpaths: array<string>
): BootstrapPackageResult {
    var status = if (dependencies.errors == 0) 0 else 1
    var diagnostic = dependencies.diagnostic
    var index = 0
    while (status == 0 && index < dependencies.values.size) {
        val dependency = dependencies.values[index]
        val lockedIndex = bootstrapPackageLockIndex(packages, dependency.name)
        if (lockedIndex < 0) {
            status = 1
            diagnostic =
                "error[E_PACKAGE_LOCK_DISAGREEMENT]: import provider dependency '${dependency.name}', ImportSource '${dependency.identity}', selector '${dependency.selector}' is absent from abla.lock\n"
        } else if (!bootstrapPackageDependencyMatches(
            dependency, packages[lockedIndex]
        )) {
            status = 1
            diagnostic =
                "error[E_PACKAGE_LOCK_DISAGREEMENT]: import provider dependency '${dependency.name}' does not match locked revision '${packages[lockedIndex].revision}' from ImportSource '${packages[lockedIndex].identity}'\n"
        } else if (bootstrapPackageStackContains(stack, dependency.name)) {
            status = 1
            diagnostic =
                "error[E_PACKAGE_CYCLE]: locked import provider dependency cycle reaches '${dependency.name}'\n"
        } else if (!bootstrapPackageStackContains(visited, dependency.name)) {
            val nestedStack: array<string> = []
            var stackIndex = 0
            while (stackIndex < stack.size) {
                nestedStack.append(stack[stackIndex])
                stackIndex = stackIndex + 1
            }
            nestedStack.append(dependency.name)
            visited.append(dependency.name)
            val package = packages[lockedIndex]
            val source = "$projectRoot/.abla/packages/${package.name}/source"
            val declared = bootstrapPackageManifestDependencies(
                "$source/abla.toml"
            )
            val imported = bootstrapPackageDiscoverImportProviders(
                "$source/${package.entry}"
            )
            val nestedDependencies = bootstrapPackageMergeDependencies(
                declared, imported
            )
            val nested = bootstrapPackageValidateDependencies(
                projectRoot, nestedDependencies, packages, visited, nestedStack, walkedSubpaths
            )
            status = nested.status
            diagnostic = nested.diagnostic
        }
        if (status == 0) {
            for (subpath in dependency.subpaths) {
                val walked = "${dependency.name}/$subpath"
                if (status == 0 && !bootstrapPackageStringsContain(walkedSubpaths, walked)) {
                    walkedSubpaths.append(walked)
                    val found = bootstrapPackageFindSubpath(
                        "$projectRoot/.abla/packages/${dependency.name}/source",
                        dependency.name, subpath
                    )
                    if (found.diagnostic != "") {
                        status = 1
                        diagnostic = found.diagnostic
                    } else {
                        val nestedStack: array<string> = []
                        for (name in stack) nestedStack.append(name)
                        nestedStack.append(dependency.name)
                        val nested = bootstrapPackageValidateDependencies(
                            projectRoot, bootstrapPackageDiscoverImportProviders(found.path),
                            packages, visited, nestedStack, walkedSubpaths
                        )
                        status = nested.status
                        diagnostic = nested.diagnostic
                    }
                }
            }
        }
        index = index + 1
    }
    BootstrapPackageResult(status, diagnostic)
}

// The tree hash of a vendored copy with its two marker files left out: what `git write-tree` gives for the same
// files, so it is the digest abla.lock records. The markers say which revision a copy claims to be; this says
// whether the files are the ones the lock was made from.
// The tree digest of the files of `directory` (as `git add` makes it in a repository of ours with attributes unset, never by git inside the directory,
// whose index, config and objects a writer of the files could set as it likes); `excludeMarkers` leaves out the two marker files of a vendored copy.
fun bootstrapPackageDirectoryDigest(directory: string, excludeMarkers: bool): string {
    // git runs inside the vendored directory, so every path it is given must not depend on the working directory. The
    // scratch repository lives in the package cache: a build of a vendored project creates nothing in the project.
    val cacheRoot = bootstrapPackageCacheRoot()
    val scratchName = "$cacheRoot/vendor-check.${linuxProcessId()}"
    val scratch = if (Path(cacheRoot).isAbsolute()) scratchName else currentDirectory().child(scratchName).text
    bootstrapPackageRemoveTree(scratch)
    var result = ""
    if (Path(scratch).parent().createDirectories()) {
        val init = bootstrapPackageGit()
        init.argument("init")
        init.argument("--quiet")
        init.argument("--bare")
        init.argument("--object-format=sha1")
        init.argument(scratch)
        if (init.run() == 0 && bootstrapPackageRawAttributes(scratch)) {
            val add = bootstrapPackageGit()
            add.workingDirectory = directory
            add.argument("--git-dir=$scratch")
            add.argument("--work-tree=.")
            add.argument("add")
            add.argument("--all")
            add.argument("--force")
            add.argument("--")
            add.argument(".")
            if (excludeMarkers) {
                add.argument(":(exclude).abla-revision")
                add.argument(":(exclude).abla-digest")
            }
            if (add.run() == 0) {
                val write = bootstrapPackageGit()
                write.argument("--git-dir=$scratch")
                write.argument("write-tree")
                val captured = write.capture()
                if (captured.status == 0) result = bootstrapPackageTrim(captured.output)
            }
        }
    }
    bootstrapPackageRemoveTree(scratch)
    result
}

fun bootstrapPackageVendorDigest(projectRoot: string, vendorRoot: string): string = bootstrapPackageDirectoryDigest(vendorRoot, true)

fun bootstrapPackageVendorMarked(vendorRoot: string, package: BootstrapLockedPackage): bool =
    Path("$vendorRoot/.abla-revision").readText() == package.revision &&
        Path("$vendorRoot/.abla-digest").readText() == package.digest &&
        Path(vendorRoot).info().isDirectory()

fun bootstrapPackageVendorMismatch(package: BootstrapLockedPackage): string =
    "error[E_PACKAGE_VENDOR_DIGEST_MISMATCH]: the vendored copy of dependency '${package.name}' (vendor/${package.name}) does not match the digest '${package.digest}' in abla.lock: its files differ from the locked revision; restore them or run 'ablac package vendor' again\n"

// ---- locked dependency data (#1175): compilerReadDependencyFile ---------------------------------------------------

class BootstrapPackageDependencyFile(val found: bool, val text: string, val diagnostic: string)

// The most a compile-time dependency read returns: the same bound as a compile-time write.
val BOOTSTRAP_PACKAGE_FILE_LIMIT: int = 16777216

fun bootstrapPackageDependencyFileFailure(code: string, name: string, relative: string, why: string): BootstrapPackageDependencyFile =
    BootstrapPackageDependencyFile(false, "", "error[$code]: dependency '$name' file '$relative': $why\n")

// A package-relative data path: slash-separated ordinary components (no empty, `.`, `..`, `.git` or `.abla*` one, no
// backslash, colon (a drive), NUL or absolute form).
fun bootstrapPackageDataPathValid(relative: string): bool {
    if (relative.size == 0 || relative.size > 1024) return false
    var valid = true
    var index = 0
    while (valid && index < relative.size) {
        val byte = relative[index]
        if (byte == 0 || byte == 92 || byte == 58 || byte < 32) valid = false
        index = index + 1
    }
    if (!valid) return false
    for (part in relative.split("/")) {
        if (part == "" || part == "." || part == ".." || part == ".git" || part.startsWith(".abla")) valid = false
    }
    valid
}

class BootstrapPackageTreeEntries(val ok: bool, val entries: array<string>)

fun bootstrapPackageSplitNul(text: string): array<string> {
    val parts: array<string> = []
    var begin = 0
    var index = 0
    while (index < text.size) {
        if (text[index] == 0) {
            if (index > begin) parts.append(text.slice(begin, index))
            begin = index + 1
        }
        index = index + 1
    }
    if (begin < text.size) parts.append(text.slice(begin, text.size))
    parts
}

// The entries `git ls-tree` lists under `tree` for each prefix of `relative`, as "mode type sha<TAB>path" records.
fun bootstrapPackageTreeEntries(gitArguments: array<string>, tree: string, relative: string): BootstrapPackageTreeEntries {
    val command = bootstrapPackageGit()
    for (argument in gitArguments) command.argument(argument)
    command.argument("ls-tree")
    command.argument("-z")
    command.argument(tree)
    command.argument("--")
    command.argument(relative)
    val captured = command.capture()
    BootstrapPackageTreeEntries(captured.status == 0, bootstrapPackageSplitNul(captured.output))
}

// The bytes of the regular file `relative` in the git tree `tree` (the locked digest) of the repository the
// arguments select: read from the tree's own objects, never from a working tree, so what is returned is what the
// digest covers. A symbolic link (the leaf or any directory on the way), a submodule and a directory are refused.
fun bootstrapPackageTreeFile(gitArguments: array<string>, tree: string, name: string, relative: string): BootstrapPackageDependencyFile {
    val parts = relative.split("/")
    var prefix = ""
    var index = 0
    var blob = ""
    var failure = ""
    while (index < parts.size && failure == "") {
        prefix = if (prefix == "") parts[index] else "$prefix/${parts[index]}"
        val listed = bootstrapPackageTreeEntries(gitArguments, tree, prefix)
        if (!listed.ok) return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNAVAILABLE", name, relative, "the locked tree cannot be listed")
        var entry = ""
        for (record in listed.entries) {
            val tab = record.indexOf("\t")
            if (tab > 0 && record.slice(tab + 1, record.size) == prefix) entry = record.slice(0, tab)
        }
        val leaf = index + 1 == parts.size
        val fields = entry.split(" ")
        if (entry == "") {
            failure = "is not in the locked tree"
        } else if (fields.size != 3) {
            failure = "has an unreadable tree entry"
        } else if (fields[0] == "120000") {
            failure = "is, or goes through, a symbolic link ('$prefix'), which a dependency read never follows"
        } else if (leaf && fields[1] == "blob" && (fields[0] == "100644" || fields[0] == "100755")) {
            blob = fields[2]
        } else if (leaf) {
            failure = if (fields[1] == "tree") "is a directory, not a file"
                else if (fields[1] == "commit") "is a nested repository, outside the data surface"
                else "is not a regular file"
        } else if (fields[1] != "tree") {
            failure = "goes through '$prefix', which is not a directory"
        }
        index = index + 1
    }
    if (failure != "") return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_INVALID", name, relative, failure)
    if (!bootstrapPackageHexRevision(blob)) return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_INVALID", name, relative, "has an unreadable tree entry")
    val sizeCommand = bootstrapPackageGit()
    for (argument in gitArguments) sizeCommand.argument(argument)
    sizeCommand.argument("cat-file")
    sizeCommand.argument("-s")
    sizeCommand.argument(blob)
    val size = sizeCommand.capture()
    if (size.status != 0) return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNAVAILABLE", name, relative, "the locked tree's file cannot be read")
    val digits = bootstrapPackageTrim(size.output)
    var bytes = 0
    var numeric = digits.size > 0 && digits.size <= 9
    var place = 0
    while (numeric && place < digits.size) {
        if (digits[place] < 48 || digits[place] > 57) numeric = false else bytes = bytes * 10 + digits[place] - 48
        place = place + 1
    }
    if (!numeric || bytes > BOOTSTRAP_PACKAGE_FILE_LIMIT) {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_INVALID", name, relative, "is larger than ${BOOTSTRAP_PACKAGE_FILE_LIMIT} bytes")
    }
    val command = bootstrapPackageGit()
    for (argument in gitArguments) command.argument(argument)
    command.argument("cat-file")
    command.argument("blob")
    command.argument(blob)
    val captured = command.capture()
    if (captured.status != 0) return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNAVAILABLE", name, relative, "the locked tree's file cannot be read")
    BootstrapPackageDependencyFile(true, captured.output, "")
}

// The scratch repository holding the tree of a vendored copy (as bootstrapPackageVendorDigest builds it), or "": the
// bytes then come from the objects `git add` made, whose tree the caller compares with the lock's digest.
fun bootstrapPackageVendorScratch(vendorRoot: string): string {
    val cacheRoot = bootstrapPackageCacheRoot()
    val scratchName = "$cacheRoot/vendor-read.${linuxProcessId()}"
    val scratch = if (Path(cacheRoot).isAbsolute()) scratchName else currentDirectory().child(scratchName).text
    bootstrapPackageRemoveTree(scratch)
    if (!Path(scratch).parent().createDirectories()) return ""
    val init = bootstrapPackageGit()
    init.argument("init")
    init.argument("--quiet")
    init.argument("--bare")
    init.argument("--object-format=sha1")
    init.argument(scratch)
    if (init.run() != 0) return ""
    if (!bootstrapPackageRawAttributes(scratch)) return ""
    val add = bootstrapPackageGit()
    add.workingDirectory = vendorRoot
    add.argument("--git-dir=$scratch")
    add.argument("--work-tree=.")
    add.argument("add")
    add.argument("--all")
    add.argument("--force")
    add.argument("--")
    add.argument(".")
    add.argument(":(exclude).abla-revision")
    add.argument(":(exclude).abla-digest")
    if (add.run() != 0) {
        bootstrapPackageRemoveTree(scratch)
        return ""
    }
    scratch
}

// The file `relative` of the direct dependency `name` of the package `sitePackage` ("" the root project at `root`, whose
// manifest is `rootManifest`), from the root's lock: the dependency must be in that package's own manifest, match a
// lock record that pins a content digest, and be present as a checked-in vendor copy or a prepared copy under
// .abla/packages that holds that digest. Never fetches, installs or resolves.
fun bootstrapPackageReadDependencyFile(
    root: string, rootManifest: string, sitePackage: string, name: string, relative: string
): BootstrapPackageDependencyFile {
    if (!bootstrapPackageNameValid(name)) {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNDECLARED", name, relative, "is not a dependency name")
    }
    if (!bootstrapPackageDataPathValid(relative)) {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_INVALID", name, relative,
            "is not a package-relative file path: use slash-separated components, none empty, `.`, `..`, `.git` or `.abla*`, with no backslash or drive")
    }
    val manifest = if (sitePackage == "") rootManifest
        else "${bootstrapCompilePackageDirectory(root, sitePackage)}/abla.toml"
    val owner = if (sitePackage == "") "the project" else "package '$sitePackage'"
    if (manifest == "" || !Path(manifest).exists()) {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNDECLARED", name, relative, "$owner has no abla.toml declaring it")
    }
    val declared = bootstrapPackageManifestDependencies(manifest)
    if (declared.errors != 0) {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNDECLARED", name, relative, "the manifest of $owner is invalid")
    }
    val declaredIndex = bootstrapPackageDependencyIndex(declared.values, name)
    if (declaredIndex < 0) {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNDECLARED", name, relative,
            "is not a direct dependency in the abla.toml of $owner, which reads it")
    }
    val lockPath = "$root/abla.lock"
    val lock = bootstrapPackageReadLock(lockPath)
    val lockedIndex = if (lock.valid) bootstrapPackageLockIndex(lock.packages, name) else -1
    if (lockedIndex < 0 || !bootstrapPackageDependencyMatches(declared.values[declaredIndex], lock.packages[lockedIndex]) ||
        lock.packages[lockedIndex].digest == "") {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNPINNED", name, relative,
            "is not pinned by abla.lock to the dependency $owner declares (with a content digest); run 'ablac package update'")
    }
    val package = lock.packages[lockedIndex]
    val vendor = "$root/vendor/$name"
    if (bootstrapPackageVendorMarked(vendor, package)) {
        val scratch = bootstrapPackageVendorScratch(vendor)
        if (scratch == "") {
            return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNAVAILABLE", name, relative, "the vendored copy cannot be read")
        }
        val write = bootstrapPackageGit()
        write.argument("--git-dir=$scratch")
        write.argument("write-tree")
        val tree = write.capture()
        if (tree.status != 0 || bootstrapPackageTrim(tree.output) != package.digest) {
            bootstrapPackageRemoveTree(scratch)
            return BootstrapPackageDependencyFile(false, "", bootstrapPackageVendorMismatch(package))
        }
        val read = bootstrapPackageTreeFile(["--git-dir=$scratch"], package.digest, name, relative)
        bootstrapPackageRemoveTree(scratch)
        return read
    }
    val packageRoot = "$root/.abla/packages/$name"
    val source = "$packageRoot/source"
    if (Path("$packageRoot/revision").readText() != package.revision || Path("$packageRoot/digest").readText() != package.digest ||
        !bootstrapPackageCheckoutValid(source, package)) {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNAVAILABLE", name, relative,
            "its locked revision '${package.revision}' is not prepared under the project (a build prepares it from the cache; this read never fetches)")
    }
    val scratch = bootstrapPackageVendorScratch(source)
    if (scratch == "") {
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNAVAILABLE", name, relative, "the prepared copy cannot be read")
    }
    val write = bootstrapPackageGit()
    write.argument("--git-dir=$scratch")
    write.argument("write-tree")
    val tree = write.capture()
    if (tree.status != 0 || bootstrapPackageTrim(tree.output) != package.digest) {
        bootstrapPackageRemoveTree(scratch)
        return bootstrapPackageDependencyFileFailure("E_PACKAGE_FILE_UNAVAILABLE", name, relative, "the prepared copy of '${package.revision}' does not hold the locked files")
    }
    val read = bootstrapPackageTreeFile(["--git-dir=$scratch"], package.digest, name, relative)
    bootstrapPackageRemoveTree(scratch)
    read
}

// What a build journals for a dependency read: the lock's digest and the bytes, or the failure, so a cached build is
// valid only while the same file of the same pin is still there. Neither copy's directory is part of it.
fun bootstrapPackageDependencyFileObservation(
    root: string, rootManifest: string, sitePackage: string, name: string, relative: string
): string {
    val read = bootstrapPackageReadDependencyFile(root, rootManifest, sitePackage, name, relative)
    if (read.found) "ok\n${read.text}" else "error\n${read.diagnostic}"
}

fun bootstrapPackageMaterialize(
    projectRoot: string,
    package: BootstrapLockedPackage,
    offline: bool
): BootstrapPackageResult {
    val cacheRoot = bootstrapPackageCachePath(package)
    val vendorRoot = "$projectRoot/vendor/${package.name}"
    val vendorMarked = bootstrapPackageVendorMarked(vendorRoot, package)
    var status = 0
    var diagnostic = ""
    // A vendored copy that claims the locked revision must also hold the locked files: a mismatch is an error, not
    // a reason to fall back to another copy.
    if (vendorMarked && bootstrapPackageVendorDigest(projectRoot, vendorRoot) != package.digest) {
        return BootstrapPackageResult(1, bootstrapPackageVendorMismatch(package))
    }
    val vendorValid = vendorMarked
    if (!vendorValid && !bootstrapPackageCacheValid(package)) {
        if (offline) {
            status = 1
            diagnostic =
                "error[E_PACKAGE_OFFLINE_MISS]: dependency '${package.name}', ImportSource '${package.identity}', selector '${package.selector}', locked revision '${package.revision}' is unavailable or invalid in cache '$cacheRoot'\n"
        } else if (package.provider == "content") {
            status = 1
            diagnostic =
                "error[E_PACKAGE_CACHE_MISS]: dependency '${package.name}', ImportSource '${package.identity}', locked revision '${package.revision}' is unavailable or invalid in cache '$cacheRoot'; run 'ablac package update' to invoke its resolver\n"
        } else {
            val dependency = BootstrapPackageDependency(
                package.name, package.provider, package.identity,
                package.source, package.selectorKind, package.selector,
                "", "", []
            )
            val fetched = bootstrapPackageFetch(dependency, package.revision)
            status = fetched.status
            diagnostic = fetched.diagnostic
            if (status == 0 && !bootstrapPackageCacheValid(package)) {
                status = 1
                diagnostic =
                    "error[E_PACKAGE_DIGEST_MISMATCH]: dependency '${package.name}', ImportSource '${package.identity}', locked revision '${package.revision}' does not match digest '${package.digest}'\n"
            }
        }
    }
    val packageRoot = "$projectRoot/.abla/packages/${package.name}"
    val sourceRoot = "$packageRoot/source"
    val existing = Path("$packageRoot/revision").readText() == package.revision &&
        Path("$packageRoot/digest").readText() == package.digest &&
        Path(sourceRoot).info().isDirectory() &&
        (vendorValid || bootstrapPackageCheckoutValid(sourceRoot, package))
    if (status == 0 && !existing) {
        val temporary = "$packageRoot.tmp.${linuxProcessId()}"
        bootstrapPackageRemoveTree(temporary)
        val materializationSource = if (vendorValid) vendorRoot
            else "$cacheRoot/source"
        if (!bootstrapPackageCopyTree(materializationSource, "$temporary/source")) {
            status = 1
        }
        // What the build reads is what was hashed: the copy, after it was made, not the entry before (a writer of the cache could swap it in between).
        if (status == 0 && bootstrapPackageDirectoryDigest("$temporary/source", vendorValid) != package.digest) {
            status = 1
            diagnostic =
                "error[E_PACKAGE_DIGEST_MISMATCH]: dependency '${package.name}', locked revision '${package.revision}': the files copied for this build are not the locked tree (the cache entry or the vendored copy changed while it was copied)\n"
        }
        if (status == 0) {
            var written = Path("$temporary/revision").writeText(package.revision)
            if (written) written = Path("$temporary/digest").writeText(package.digest)
            if (written) written = Path("$temporary/source-url").writeText(package.source)
            if (written) written = Path("$temporary/entry.ab").writeText(
                "import \"source/${package.entry}\"\n"
            )
            if (!written) status = 1
        }
        if (status == 0) {
            if (Path(packageRoot).exists()) bootstrapPackageRemoveTree(packageRoot)
            if (!Path(temporary).moveTo(Path(packageRoot))) status = 1
        }
        if (status != 0) bootstrapPackageRemoveTree(temporary)
        if (status != 0 && diagnostic == "") {
            diagnostic =
                "error[E_PACKAGE_MATERIALIZE]: dependency '${package.name}', ImportSource '${package.identity}', locked revision '${package.revision}' could not be materialized transactionally\n"
        }
    }
    BootstrapPackageResult(status, diagnostic)
}

fun bootstrapPackagePrepareWithDependencies(
    projectRoot: string,
    imported: BootstrapPackageDependencies,
    offline: bool
): BootstrapPackageResult {
    val lock = bootstrapPackageReadLock(Path(projectRoot).child("abla.lock").text)
    bootstrapPackagePrepareWithLock(projectRoot, imported, lock, offline)
}

fun bootstrapPackagePrepareWithLock(
    projectRoot: string,
    imported: BootstrapPackageDependencies,
    lock: BootstrapPackageLock,
    offline: bool
): BootstrapPackageResult {
    val manifest = Path(projectRoot).child("abla.toml")
    val direct = bootstrapPackageMergeDependencies(
        bootstrapPackageManifestDependencies(manifest.text), imported
    )
    var status = if (direct.errors == 0) 0 else 1
    var diagnostic = direct.diagnostic
    if (status == 0 && direct.values.size > 0 && !lock.valid) {
        status = 1
        diagnostic = lock.diagnostic
    }
    var packageIndex = 0
    while (status == 0 && direct.values.size > 0 &&
           packageIndex < lock.packages.size) {
        val materialized = bootstrapPackageMaterialize(
            projectRoot, lock.packages[packageIndex], offline
        )
        status = materialized.status
        diagnostic = materialized.diagnostic
        packageIndex = packageIndex + 1
    }
    if (status == 0 && direct.values.size > 0) {
        val policy = bootstrapPackageValidateCapabilityPolicy(
            projectRoot, lock.packages, true
        )
        status = policy.status
        diagnostic = policy.diagnostic
    }
    if (status == 0 && direct.values.size > 0) {
        val visited: array<string> = []
        val stack: array<string> = []
        val walkedSubpaths: array<string> = []
        val graph = bootstrapPackageValidateDependencies(
            projectRoot, direct, lock.packages, visited, stack, walkedSubpaths
        )
        status = graph.status
        diagnostic = graph.diagnostic
        if (status == 0 && visited.size != lock.packages.size) {
            status = 1
            diagnostic =
                "error[E_PACKAGE_LOCK_DISAGREEMENT]: abla.lock contains packages unreachable from root manifest '${manifest.text}'\n"
        }
    }
    BootstrapPackageResult(status, diagnostic)
}

/**
 * Every package the abla.lock at `projectRoot` names, under its .abla/packages at the locked revision: fetched into
 * the cache when absent (never re-resolved: the lock's revision, not the selector's head), then materialized. One
 * already there at that revision and digest is left as it is, so a build that needs nothing reads two small files
 * per package. No lock: nothing to do (decision #85: builds use the committed lock; `package update` moves it).
 */
fun bootstrapPackageInstallLocked(projectRoot: string, offline: bool): BootstrapPackageResult {
    val lockPath = Path(projectRoot).child("abla.lock")
    if (!lockPath.exists()) return BootstrapPackageResult(0, "")
    val lock = bootstrapPackageReadLock(lockPath.text)
    if (!lock.valid) return BootstrapPackageResult(1, lock.diagnostic)
    var installed = false
    for (package in lock.packages) {
        // A checked-in vendor copy at the locked revision is what a build resolves to: nothing to install.
        val vendor = "$projectRoot/vendor/${package.name}"
        if (bootstrapPackageVendorMarked(vendor, package)) {
            if (bootstrapPackageVendorDigest(projectRoot, vendor) != package.digest) {
                return BootstrapPackageResult(1, bootstrapPackageVendorMismatch(package))
            }
            continue
        }
        val root = "$projectRoot/.abla/packages/${package.name}"
        if (Path("$root/revision").readText() == package.revision &&
            Path("$root/digest").readText() == package.digest &&
            Path("$root/source").info().isDirectory()) continue
        val materialized = bootstrapPackageMaterialize(projectRoot, package, offline)
        if (materialized.status != 0) return materialized
        installed = true
    }
    if (installed) return bootstrapPackageValidateCapabilityPolicy(projectRoot, lock.packages, true)
    BootstrapPackageResult(0, "")
}

fun bootstrapPackageVendorWithDependencies(
    projectRoot: string,
    imported: BootstrapPackageDependencies,
    offline: bool
): BootstrapPackageResult {
    val prepared = bootstrapPackagePrepareWithDependencies(
        projectRoot, imported, offline
    )
    var status = prepared.status
    var diagnostic = prepared.diagnostic
    val lock = bootstrapPackageReadLock(Path(projectRoot).child("abla.lock").text)
    val destination = "$projectRoot/vendor"
    val temporary = "$destination.tmp.${linuxProcessId()}"
    if (status == 0) bootstrapPackageRemoveTree(temporary)
    var index = 0
    while (status == 0 && index < lock.packages.size) {
        val package = lock.packages[index]
        val source = "${bootstrapPackageCachePath(package)}/source"
        val target = "$temporary/${package.name}"
        if (!bootstrapPackageCopyTree(source, target)) status = 1
        if (status == 0) bootstrapPackageRemoveTree("$target/.git")
        if (status == 0) {
            var written = Path("$target/.abla-revision").writeText(package.revision)
            if (written) written = Path("$target/.abla-digest").writeText(package.digest)
            if (!written) status = 1
        }
        index = index + 1
    }
    if (status == 0) {
        if (Path(destination).exists()) bootstrapPackageRemoveTree(destination)
        if (!Path(temporary).moveTo(Path(destination))) status = 1
    }
    if (status != 0) {
        bootstrapPackageRemoveTree(temporary)
        if (diagnostic == "") {
            diagnostic =
                "error[E_PACKAGE_VENDOR]: could not publish vendored dependency graph for '$projectRoot'\n"
        }
    }
    BootstrapPackageResult(status, diagnostic)
}

// `package/name` is resolved through the nearest project package graph, from
// the importer's directory upward. Package sources are copied below the
// project, so transitive imports reach the same root while relative imports
// remain inside their package. At each directory:
//
//  - a prepared package (`.abla/packages/name`, materialized by a project build
//    or `package update`) is used, unless that directory's abla.lock locks the
//    name at another revision (a stale copy after the lock moved);
//  - otherwise, where abla.lock locks the name, the checked-in vendor tree
//    (`vendor/name`, from `package vendor`) is used when its revision and digest
//    markers match the lock. This lets a single-file build (no `--project`, so
//    nothing is prepared) of a project that checks its graph in resolve offline,
//    without a cache. A directory whose lock names the package ends the search,
//    except in a dependency's own copy (a prepared package's `source` or a
//    vendored tree): there the dependency's lock only records what it was
//    published against, and its own dependencies were materialized beside it
//    by the enclosing project, so the search continues upward to that project.
fun bootstrapPackageDirectoryIsDependencyCopy(directory: Path): bool {
    val packageRoot = directory.parent()
    val packages = packageRoot.parent()
    val vendored = directory.child(".abla-revision").exists() &&
        directory.parent().name() == "vendor"
    val prepared = directory.name() == "source" &&
        packageRoot.child("revision").exists() &&
        packageRoot.child("entry.ab").exists() &&
        packages.name() == "packages" &&
        packages.parent().name() == ".abla"
    vendored || prepared
}

// The root of the package whose entry `bootstrapResolvePackageImport` found: a
// prepared copy's `source`, or the vendored tree.
fun bootstrapPackageRootOfEntry(entry: string, name: string): string {
    val prepared = "/.abla/packages/$name/entry.ab"
    if (entry.size >= prepared.size && entry.slice(entry.size - prepared.size,
        entry.size) == prepared) {
        return "${entry.slice(0, entry.size - "entry.ab".size)}source"
    }
    if (entry.startsWith(".abla/packages/$name/entry.ab")) return ".abla/packages/$name/source"
    val vendored = "vendor/$name/"
    var index = entry.size - vendored.size
    while (index >= 0) {
        if (entry.slice(index,
            index + vendored.size) == vendored && (index == 0 || entry[index - 1] == 47)) {
            return entry.slice(0, index + vendored.size - 1)
        }
        index = index - 1
    }
    ""
}

fun bootstrapResolvePackageImport(importer: string, requested: string): string {
    var result = ""
    val prefix = "package/"
    if (requested.size > prefix.size &&
        requested.slice(0, prefix.size) == prefix) {
        val name = requested.slice(prefix.size, requested.size)
        if (bootstrapPackageNameValid(name)) {
            var directory = Path(importer).parent()
            var searching = true
            var depth = 0
            while (searching && depth < 128) {
                val prepared = directory.child(".abla").child("packages").child(name)
                val candidate = prepared.child("entry.ab")
                val lockPath = directory.child("abla.lock")
                var lockedIndex = -1
                var lock = BootstrapPackageLock([], false, "")
                if (lockPath.exists()) {
                    lock = bootstrapPackageReadLock(lockPath.text)
                    if (lock.valid) {
                        lockedIndex = bootstrapPackageLockIndex(lock.packages, name)
                    }
                }
                val preparedCurrent = lockedIndex < 0 ||
                    prepared.child("revision").readText() ==
                        lock.packages[lockedIndex].revision
                if (candidate.exists() && preparedCurrent) {
                    result = candidate.text
                    searching = false
                } else if (lockedIndex >= 0) {
                    val package = lock.packages[lockedIndex]
                    val vendored = directory.child("vendor").child(name)
                    val entry = vendored.child(package.entry)
                    if (vendored.child(".abla-revision").readText() ==
                        package.revision &&
                        vendored.child(".abla-digest").readText() ==
                            package.digest &&
                        bootstrapPackageRelativePathValid(package.entry) &&
                        entry.exists()) {
                        result = bootstrapNormalizeModulePath(entry.text)
                        searching = false
                    } else if (bootstrapPackageDirectoryIsDependencyCopy(
                        directory
                    )) {
                        val parent = directory.parent()
                        if (parent.text == directory.text) searching = false
                        directory = parent
                    } else searching = false
                } else {
                    val parent = directory.parent()
                    if (parent.text == directory.text) searching = false
                    directory = parent
                }
                depth = depth + 1
            }
        }
    }
    result
}
