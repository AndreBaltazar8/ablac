// The small TOML catalog served by abla.dev for package discovery.
import "abla/json"
import "abla/text"

private fun packageCatalogComponent(value: string, owner: bool): bool {
    if (value == "" || value == "." || value == ".." || value.size > 100) return false
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        val alphanumeric = (byte >= 48 && byte <= 57) ||
            (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        if (!alphanumeric && byte != 45 && (owner || (byte != 46 && byte != 95))) {
            return false
        }
        index = index + 1
    }
    !owner || (value[0] != 45 && value[value.size - 1] != 45)
}

val packageCatalogMaximumBytes = 262144

fun packageCatalogNameValid(value: string): bool =
    packageCatalogComponent(value, false) && !value.lowercase().endsWith(".git")

fun packageCatalogRepositoryValid(value: string): bool {
    val parts = value.split("/")
    parts.size == 2 && packageCatalogComponent(parts[0], true) &&
        packageCatalogNameValid(parts[1])
}

class PackageCatalogEntry(
    val repository: string,
    val description: string,
    val keywords: array<string>
)

class PackageCatalog(
    val entries: array<PackageCatalogEntry>,
    val error: string = ""
)

/** Whether remote text (a catalog value, a field of a fetched manifest) can be printed as it is: no C0 control or DEL, no C1 control
 *  (U+0080-U+009F, which some terminals act on as escape sequences) and no bidirectional control (U+200E, U+200F, U+202A-U+202E,
 *  U+2066-U+2069, which can make one package name read as another). */
fun packageCatalogDisplaySafe(value: string): bool {
    var index = 0
    while (index < value.size) {
        val byte = value[index]
        if (byte < 32 || byte == 127) return false
        val next = if (index + 1 < value.size) value[index + 1] else -1
        val third = if (index + 2 < value.size) value[index + 2] else -1
        if (byte == 194 && next >= 128 && next <= 159) return false
        if (byte == 226 && next == 128 && (third == 142 || third == 143 || third >= 170 && third <= 174)) return false
        if (byte == 226 && next == 129 && third >= 166 && third <= 169) return false
        index = index + 1
    }
    true
}

private fun packageCatalogTextValid(value: string): bool = value != "" && packageCatalogDisplaySafe(value)

// The catalog uses one [[package]] table per repo and JSON-compatible quoted
// strings and string arrays on single lines. Whole-line comments are allowed.
fun packageCatalogParse(source: string): PackageCatalog {
    if (source.size > packageCatalogMaximumBytes) return PackageCatalog([], "catalog exceeds 256 KiB")
    var entries: array<PackageCatalogEntry> = []
    var repository = ""
    var description = ""
    var keywords: array<string> = []
    var started = false
    var hasKeywords = false
    var lineNumber = 0
    // Closing sentinel publishes the final table through the same path.
    for (line in ("$source\n[[package]]").split("\n")) {
        lineNumber = lineNumber + 1
        val trimmed = line.trim()
        if (trimmed == "" || trimmed.startsWith("#")) continue
        if (trimmed == "[[package]]") {
            if (started) {
                if (!packageCatalogRepositoryValid(repository) ||
                    !packageCatalogTextValid(description) || !hasKeywords) {
                    return PackageCatalog([], "invalid or incomplete package before line $lineNumber")
                }
                for (entry in entries) {
                    if (entry.repository.lowercase() == repository.lowercase()) {
                        return PackageCatalog([], "duplicate repository $repository")
                    }
                }
                entries.append(PackageCatalogEntry(repository, description, keywords))
                repository = ""
                description = ""
                keywords = []
                hasKeywords = false
            }
            started = true
            continue
        }
        val equals = trimmed.indexOf("=")
        if (!started || equals < 1) return PackageCatalog([], "invalid catalog line $lineNumber")
        val field = trimmed.slice(0, equals).trim()
        val parsed = jsonParse(trimmed.slice(equals + 1, trimmed.size))
        if (!parsed.succeeded) return PackageCatalog([], "invalid catalog value on line $lineNumber")
        val value = parsed.value
        if (field == "repository" && repository == "" && value.isString()) {
            repository = value.asString()
            if (packageCatalogRepositoryValid(repository)) continue
        } else if (field == "description" && description == "" && value.isString()) {
            description = value.asString()
            if (packageCatalogTextValid(description)) continue
        } else if (field == "keywords" && !hasKeywords && value.isArray()) {
            hasKeywords = true
            for (item in value.values) {
                val keyword = item.asString()
                if (!item.isString() || !packageCatalogTextValid(keyword)) {
                    return PackageCatalog([], "invalid keyword on line $lineNumber")
                }
                keywords.append(keyword)
            }
            continue
        }
        return PackageCatalog([], "invalid or duplicate catalog field on line $lineNumber")
    }
    if (entries.size == 0) return PackageCatalog([], "catalog contains no packages")
    PackageCatalog(entries)
}
