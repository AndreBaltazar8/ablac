import "abla/llvm/orc"
// Modules this JIT-compiles name the Darwin dispatcher's fork wrapper (src/darwin_fork_export.ab).
import "darwin_fork_export.ab"
import "abla/sys/linux/process"

fun main: int {
    var status = 2
    if (linuxArgumentCount() == 1) {
        status = llvmOrcRunFile(linuxArgument(0))
    }
    status
}
