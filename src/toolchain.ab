        bootstrapLlvmFastInlineThreshold = enclosingInlineThreshold
        bootstrapLlvmHoldModule = enclosingHoldModule
        bootstrapLlvmInitializerChunk = enclosingInitializerChunk
        bootstrapLlvmStackGuard = enclosingStackGuard
        bootstrapLlvmOwnMemoryRoutines = enclosingOwnMemoryRoutines
        bootstrapLlvmFreestandingStart = enclosingFreestandingStart
        bootstrapLlvmCoverage = enclosingCoverage
        bootstrapLlvmStoreBoxes = enclosingStoreBoxes
        bootstrapLlvmAllowBulkObjectZero = enclosingBulkObjectZero
