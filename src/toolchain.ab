    val cacheStem =
        "$cacheDirectory/native-${target.name}-llvm21-v17-$cacheProfile${if (bootstrapStrictImportsRequested) "-strict" else ""}$nativeMode-$compilerImageSize-$compilerFirstHash-$compilerSecondHash-${sourceIdentity.size}-$firstHash-$secondHash"
    val cacheObjectPath = "$cacheStem.o"
    val cacheLlvmPath = "$cacheStem.ll"
    val cacheBitcodePath = "$cacheStem.bc"
    val cacheSourcePath = "$cacheStem.source"
    val cacheLinkLlvmPath = "$cacheStem.link-llvm"
    val cacheLinkHostPath = "$cacheStem.link-host"
    val cacheInputsPath = "$cacheStem.inputs"
    val cacheAbiPath = "$cacheStem.abi.json"
