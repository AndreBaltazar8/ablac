    "globaldce"

// Bootstrap-only object emission. The final compiler replaces this strategy
// with the in-process LLVM implementation from abla/llvm/aot.
fun bootstrapExternalEmitObject(
    llvmPath: string,
    objectPath: string
): int {
    val optimizedPath = "$objectPath.bc"
    val optimize = linuxCommand("opt")
    optimize.argument("-passes=default<O2>,globaldce")
    val verify = bootstrapLlvmToolsVerify()
    optimize.argument(llvmPath)
    optimize.argument("-o")
    optimize.argument(optimizedPath)
    var status = optimize.run()
    if (status == 0) {
        val emitObject = linuxCommand("llc")
        emitObject.argument("-filetype=obj")
        emitObject.argument("-relocation-model=pic")
        emitObject.argument("-O2")
        if (!verify) emitObject.argument("--disable-verify")
        emitObject.argument(optimizedPath)
        emitObject.argument("-o")
        emitObject.argument(objectPath)
        status = emitObject.run()
    }
    status
}

// A build whose program has errors keeps their diagnostics here instead of printing
// them while bootstrapBuildDiagnosticsKept is set (`ablac test` reads which files a
// bundle's errors are in, and leaves reporting them to those files' own builds).
var bootstrapBuildDiagnosticsKept: bool = false
var bootstrapBuildDiagnostics: string = ""

// Where builds and runs keep their caches: `--cache-dir <dir>`, else ABLA_CACHE_DIR, else
// build/.abla-cache under the working directory. A directory outside the tree outlives
// it: a copy of a project built and then deleted finds its earlier entries there (entries
// are keyed by content, so projects and copies can share one).
var bootstrapCacheDirectoryRequest: string = ""

fun bootstrapCacheDirectory(): string {
    if (bootstrapCacheDirectoryRequest != "") return bootstrapCacheDirectoryRequest
    val configured = linuxEnvironment("ABLA_CACHE_DIR")
    if (configured.found && configured.value != "") configured.value
    else "build/.abla-cache"
}

// This namespace certifies raw parsing only, never a successful native
// object/link. No metadata shortcut is used for image or source identity.
fun bootstrapConfigureDiscoveryCache(
    var state: BootstrapModuleState, enabled: bool
): void {
    state.discoveryDirectory = ""
    state.discoveryIdentity = ""
    if (!enabled) return
    bootstrapReadRunningImageIdentity()
    if (bootstrapRunningImageSize <= 0) return
    val identity =
        "${bootstrapRunningImageSize}-${bootstrapRunningImageFirst}-${bootstrapRunningImageSecond}-${bootstrapRunningImageTail}"
    val directory = "${bootstrapCacheDirectory()}/discovery-v1-$identity"
    if (Path(directory).createDirectories()) {
        state.discoveryDirectory = directory
        state.discoveryIdentity = identity
    }
    return
}

fun bootstrapKeepLlvmText(): bool {
    val configured = linuxEnvironment("ABLA_KEEP_LLVM_TEXT")
    configured.found && configured.value == "1"
}

fun bootstrapTargetNeutralPanicRuntime(llvm: string): string {
    val signature =
        "define internal void @abla_runtime_panic(ptr %message, i64 %length) noreturn {\n"
    var begin = -1
    var index = 0
    while (begin < 0 && index + signature.size <= llvm.size) {
        if (llvm.slice(index, index + signature.size) == signature) {
            begin = index
        }
        index = index + 1
    }
    var end = begin
    if (begin >= 0) {
        end = begin + signature.size
        while (end + 2 < llvm.size &&
               llvm.slice(end, end + 3) != "}\n\n") end = end + 1
        if (end + 2 < llvm.size) end = end + 3
    }
    var result = llvm
    if (begin >= 0 && end > begin) {
        result =
            "${llvm.slice(0, begin)}${signature}entry:\n  unreachable\n}\n\n${llvm.slice(end, llvm.size)}"
    }
    result
}

// IR instructions per block of a release WebAssembly module initializer
// (bootstrapLlvmInitializerChunkFor). On a large client, 2000 keeps the module after
// wasm-opt byte-identical and cuts the link's instructions by a fifth; 500 saves a
// little more but grows the module (frame addresses recomputed in each block).
val BOOTSTRAP_INITIALIZER_CHUNK = 2000

// Code generation partitions of a release WebAssembly module's LTO link; wasm-ld runs one
// thread per partition. The partitioning, and so the module, depends only on this count, so
// it is fixed rather than taken from the host: the same build on any machine is the same.
val BOOTSTRAP_WASM_LTO_PARTITIONS = 4

fun bootstrapLlvmOutOfProcess(): bool {
    val configured = linuxEnvironment("ABLA_LLVM_OUT_OF_PROCESS")
    configured.found && configured.value == "1"
}

noescape extern:"c" fun LLVMParseCommandLineOptions(
    argc: i32, argv: i64*, overview: cstring
): void

// LLVM 23's WebAssemblyTargetLowering constructor calls
// setMinimumJumpTableEntries(2), which mutates a process-wide cl::opt rather
// than target-local state (llvm/lib/CodeGen/TargetLoweringBase.cpp). Restore
// LLVM's default of 4 after Wasm, including failed builds, so later native
// optimization and ORC compilation cannot inherit Wasm's switch costs.
// Abla does not expose this LLVM option; compilation here is sequential.
trusted fun bootstrapRestoreLlvmJumpTableDefault(): void {
    val program = "ablac"
    val option = "--min-jump-table-entries=4"
    val arguments = nativeByteBuffer(24)
    arguments.storeI64(0, nativeCStringAddress(program))
    arguments.storeI64(8, nativeCStringAddress(option))
    arguments.storePointer(16, nativeNullPointer())
    LLVMParseCommandLineOptions(2, arguments.address, "")
    arguments.close()
    return
}

// A module that leaves `orElse` attempts by an exception (bootstrapLlvmWasmUnwinding)
// is generated with WebAssembly exception handling, as legacy try/catch_all, which the
// engines without exnref (older Safari, Node 20) run. In process these are LLVM's
// process-wide options: set for that module's code generation and reset after it, so a
// later module in the same process is generated as if they had never been set.
trusted fun bootstrapSetLlvmWasmExceptions(enabled: bool): void {
    val program = "ablac"
    val handling = if (enabled) "--wasm-enable-eh=true" else "--wasm-enable-eh=false"
    val legacy = "--wasm-use-legacy-eh=true"
    val arguments = nativeByteBuffer(32)
    arguments.storeI64(0, nativeCStringAddress(program))
    arguments.storeI64(8, nativeCStringAddress(handling))
    arguments.storeI64(16, nativeCStringAddress(legacy))
    arguments.storePointer(24, nativeNullPointer())
    LLVMParseCommandLineOptions(3, arguments.address, "")
    arguments.close()
    return
}

// The same options for a code generator run as a tool (llc, or wasm-ld's LTO with
// `-mllvm` before each).
fun bootstrapWasmExceptionOptions(): array<string> =
    if (bootstrapLlvmWasmUnwinding) ["--wasm-enable-eh", "--wasm-use-legacy-eh"] else []

// Optimizes the module the backend kept (bootstrapLlvmHoldModule) with a fast build's
// passes and writes its WebAssembly object, as opt and llc -O0 would: the target
// machine's data layout (which opt gives a module without one), static relocations
// (a module links as one static image), no verification (the compiler verified the
// module as it emitted it). The module is disposed either way.
trusted fun bootstrapEmitHeldWasmObject(
    llvmTriple: string,
    objectPath: string,
    places: BootstrapCodegenUnitPlaces
): int {
    val nullPointer = nativeNullPointer()
    var module = bootstrapLlvmHeldModule
    var status = if (pointerIsNull(module)) 165 else 0
    LLVMInitializeWebAssemblyTargetInfo()
    LLVMInitializeWebAssemblyTarget()
    LLVMInitializeWebAssemblyTargetMC()
    LLVMInitializeWebAssemblyAsmPrinter()
    // A module with exception handling defines its tag in module assembly, and the constant-time
    // barrier (abla/ct) is inline assembly.
    LLVMInitializeWebAssemblyAsmParser()
    val triple = LLVMNormalizeTargetTriple(llvmTriple)
    val target = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    if (status == 0 && LLVMGetTargetFromTriple(triple, target.address, message.address) != 0) {
        status = 166
    }
    var machine = nullPointer
    var layout = nullPointer
    var options = nullPointer
    // (Read when the target machine is made: set before it, reset after it is gone.)
    val exceptions = bootstrapLlvmWasmUnwinding
    if (exceptions) bootstrapSetLlvmWasmExceptions(true)
    if (status == 0) {
        machine = LLVMCreateTargetMachine(target.load(), triple, "", "", 0, 1, 0)
        if (pointerIsNull(machine)) status = 166
    }
    if (status == 0) {
        layout = LLVMCreateTargetDataLayout(machine)
        LLVMSetModuleDataLayout(module, layout)
        options = LLVMCreatePassBuilderOptions()
        val optimized = bootstrapOptimizeWasmPanicWrite(
            module, machine, options, bootstrapFastPasses()
        )
        if (pointerIsNull(optimized)) status = 167
        else {
            module = optimized
            bootstrapLlvmHeldModule = optimized
        }
    }
    // A large module is generated as units, by child compilers at once.
    val units = status == 0 && bootstrapCodegenUnitsFor(module)
    if (units) {
        val counts = bootstrapWriteCodegenUnits(module, objectPath)
        bootstrapDisposeHeldModule()
        status = if (counts.size == 0) 145 else bootstrapRunCodegenUnits(
            if (exceptions) "wasm-eh" else "wasm", llvmTriple, objectPath, places, counts
        )
    }
    // Codegen starts from a fresh context: the old one still holds what building
    // and optimizing the module left behind, which kept the tree's peak above
    // that of a separate opt and llc.
    if (status == 0 && !units) status = bootstrapRebuildHeldModule()
    val emitted = bootstrapLlvmHeldModule
    if (status == 0 && !units && LLVMTargetMachineEmitToFile(
        machine, emitted, objectPath, 1, message.address
    ) != 0) status = 168
    if (status != 0 && !pointerIsNull(message.load())) {
        linuxPrintStandardError(
            "error[E_LLVM_CODEGEN]: ${nativeCString(message.load())}\n"
        )
    }
    if (!pointerIsNull(options)) LLVMDisposePassBuilderOptions(options)
    if (!pointerIsNull(layout)) LLVMDisposeTargetData(layout)
    if (!pointerIsNull(machine)) LLVMDisposeTargetMachine(machine)
    if (exceptions) bootstrapSetLlvmWasmExceptions(false)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    LLVMDisposeMessage(triple)
    target.close()
    message.close()
    bootstrapDisposeHeldModule()
    bootstrapRestoreLlvmJumpTableDefault()
    status
}

// A lower bound on LLVM's printed instruction text. Names of instruction results
// and direct operands must appear in it; other syntax and globals only add bytes.
// This avoids rendering a large O1 module just to make the legacy 4 MiB ELF
// section decision. Uncertain/small modules still use its exact printed size.
noescape extern:"c" fun LLVMGetNumOperands(value: i64*): i32

trusted fun bootstrapHeldTextDefinitelyLarge(module: i64*): bool {
    val length = nativeByteBuffer(8)
    var bytes = 0
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        var block = LLVMGetFirstBasicBlock(function)
        while (!pointerIsNull(block)) {
            var instruction = LLVMGetFirstInstruction(block)
            while (!pointerIsNull(instruction)) {
                LLVMGetValueName2(instruction, length.pointerAt(0))
                val named = length.loadI64(0)
                bytes += 4 + if (named > 0) named + 4 else 0
                var operand = 0
                val operands = int(LLVMGetNumOperands(instruction))
                while (operand < operands) {
                    val value = LLVMGetOperand(instruction, i32(operand))
                    if (!pointerIsNull(value)) {
                        LLVMGetValueName2(value, length.pointerAt(0))
                        val size = length.loadI64(0)
                        if (size > 0) bytes += size + 1
                    }
                    operand += 1
                }
                if (bytes > 4194304) {
                    length.close()
                    return true
                }
                instruction = LLVMGetNextInstruction(instruction)
            }
            block = LLVMGetNextBasicBlock(block)
        }
        function = LLVMGetNextFunction(function)
    }
    length.close()
    false
}

// Section selection and optional cache text have consumed local names already.
// Keep user-requested debug/text output intact; optimization need not name the
// new local values created by inlining and scalar cleanup. Global names stay.
trusted fun bootstrapDiscardOptimizedLocalNames(): void {
    if (!bootstrapLlvmDebugInfo && !bootstrapKeepLlvmText()) {
        LLVMContextSetDiscardValueNames(bootstrapLlvmHeldContext, 1)
    }
}

// Mirrors llvmAotEmitObjectFileConfigured's balanced settings, with the module
// the frontend already owns. It is disposed here after optimization/emission.
trusted fun bootstrapEmitHeldBalancedObject(objectPath: string): int {
    val nullPointer = nativeNullPointer()
    val module = bootstrapLlvmHeldModule
    var status = if (pointerIsNull(module)) 130 else llvmInitializeNativeTarget()
    if (status == 0 && !bootstrapHeldTextDefinitelyLarge(module)) {
        val text = bootstrapRenderHeldModule()
        if (text.size <= 4194304) bootstrapHeldElfFunctionSections(module)
    }
    val target = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    val triple = LLVMGetDefaultTargetTriple()
    if (status == 0 && LLVMGetTargetFromTriple(triple, target.address,
        message.address) != 0) status = 132
    var machine = nullPointer
    var layout = nullPointer
    var options = nullPointer
    if (status == 0) {
        machine = LLVMCreateTargetMachine(target.load(), triple, "generic", "", 1, 2, 0)
        if (pointerIsNull(machine)) status = 133
    }
    if (status == 0) {
        LLVMSetTarget(module, triple)
        layout = LLVMCreateTargetDataLayout(machine)
        LLVMSetModuleDataLayout(module, layout)
        options = LLVMCreatePassBuilderOptions()
        bootstrapDiscardOptimizedLocalNames()
        status = llvmConsumeError(LLVMRunPasses(module, llvmPassesBalanced(), machine, options),
            134)
    }
    if (status == 0 && LLVMTargetMachineEmitToFile(machine, module, objectPath, 1,
        message.address) != 0) status = 135
    if (!pointerIsNull(options)) LLVMDisposePassBuilderOptions(options)
    if (!pointerIsNull(layout)) LLVMDisposeTargetData(layout)
    if (!pointerIsNull(machine)) LLVMDisposeTargetMachine(machine)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    LLVMDisposeMessage(triple)
    target.close()
    message.close()
    bootstrapDisposeHeldModule()
    status
}

// Moves the held module into a fresh context through in-memory bitcode and
// disposes the old context (status 169 when LLVM cannot write or read it back).
trusted fun bootstrapRebuildHeldModule(): int {
    val nullPointer = nativeNullPointer()
    val buffer = LLVMWriteBitcodeToMemoryBuffer(bootstrapLlvmHeldModule)
    bootstrapDisposeHeldModule()
    if (pointerIsNull(buffer)) return 169
    val context = LLVMContextCreate()
    LLVMContextSetDiscardValueNames(context, 1)
    val module = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    var status = LLVMParseIRInContext(context, buffer, module.address, message.address)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    bootstrapLlvmHeldContext = context
    bootstrapLlvmHeldModule = if (status == 0) module.load() else nullPointer
    module.close()
    message.close()
    if (status != 0) status = 169
    status
}

// Mirrors bootstrapAddLlvmElfFunctionSections on the text path: boxed ELF
// functions need separate sections so the linker can discard unused wrappers.
// Keep the function selection in these two paths in sync.
trusted fun bootstrapHeldElfFunctionSections(module: i64*): void {
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == 0 && LLVMGetVisibility(function) == 1 &&
            LLVMGetTypeKind(LLVMGetReturnType(LLVMGlobalGetValueType(function))) == 0) {
            val name = bootstrapLlvmDebugValueName(function)
            if (name.startsWith("abla_fn_")) LLVMSetSection(function, ".text.$name")
        }
        function = LLVMGetNextFunction(function)
    }
    return
}

// Writes the native object of the held development module: generic CPU, PIC,
// the fast passes and FastISel, as the text emitter does. A fresh context drops
// frontend LLVM allocation history. An executable may use codegen units; the
// caller loads their archive whole, with the host format's linker arguments.
trusted fun bootstrapEmitHeldNativeObject(
    objectPath: string,
    unitsAllowed: bool,
    places: BootstrapCodegenUnitPlaces
): int {
    val nullPointer = nativeNullPointer()
    var status = if (pointerIsNull(bootstrapLlvmHeldModule)) 165 else 0
    if (status == 0 && llvmInitializeNativeTarget() != 0) status = 166
    if (status == 0 && !ablaHostIsMacOS()) {
        bootstrapHeldElfFunctionSections(bootstrapLlvmHeldModule)
    }
    val module = bootstrapLlvmHeldModule
    val target = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    val triple = LLVMGetDefaultTargetTriple()
    if (status == 0 && LLVMGetTargetFromTriple(triple, target.address, message.address) != 0) {
        status = 166
    }
    var machine = nullPointer
    var layout = nullPointer
    var options = nullPointer
    if (status == 0) {
        machine = LLVMCreateTargetMachine(target.load(), triple, "generic", "", 0, 2, 0)
        if (pointerIsNull(machine)) status = 166
        else LLVMSetTargetMachineGlobalISel(machine, 0)
    }
    if (status == 0) {
        LLVMSetTarget(module, triple)
        layout = LLVMCreateTargetDataLayout(machine)
        LLVMSetModuleDataLayout(module, layout)
        options = LLVMCreatePassBuilderOptions()
        status = llvmConsumeError(
            LLVMRunPasses(module, llvmPassesFast(), machine, options), 167
        )
    }
    // A large module is generated as units, by child compilers at once.
    val units = status == 0 && unitsAllowed && bootstrapCodegenUnitsFor(module)
    if (units) {
        val counts = bootstrapWriteCodegenUnits(module, objectPath)
        bootstrapDisposeHeldModule()
        status = if (counts.size == 0) 145 else bootstrapRunCodegenUnits(
            if (ablaHostIsMacOS()) "native" else "native-elf",
            nativeCString(triple), objectPath, places, counts
        )
    }
    // Unit workers create fresh contexts themselves. Only a single-object
    // code generator needs to drop the frontend's LLVM allocation history here,
    // as bootstrapEmitHeldWasmObject does after choosing its units.
    if (status == 0 && !units) status = bootstrapRebuildHeldModule()
    val emitted = bootstrapLlvmHeldModule
    if (status == 0 && !units && LLVMTargetMachineEmitToFile(
        machine, emitted, objectPath, 1, message.address
    ) != 0) status = 168
    if (status != 0 && !pointerIsNull(message.load())) {
        linuxPrintStandardError(
            "error[E_LLVM_CODEGEN]: ${nativeCString(message.load())}\n"
        )
    }
    if (!pointerIsNull(options)) LLVMDisposePassBuilderOptions(options)
    if (!pointerIsNull(layout)) LLVMDisposeTargetData(layout)
    if (!pointerIsNull(machine)) LLVMDisposeTargetMachine(machine)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    LLVMDisposeMessage(triple)
    target.close()
    message.close()
    bootstrapDisposeHeldModule()
    status
}

// A reader over a WebAssembly binary. Past the end (a truncated or malformed
// module) `at` is one beyond the size and every read gives 0.
class BootstrapWasmReader(val data: string, var at: int)

fun BootstrapWasmReader.ended(): bool = this.at >= this.data.size

fun BootstrapWasmReader.fail(): void {
    this.at = this.data.size + 1
}

fun BootstrapWasmReader.byte(): int {
    if (this.ended()) {
        this.fail()
        return 0
    }
    val value = this.data[this.at]
    this.at = this.at + 1
    value
}

fun BootstrapWasmReader.unsigned(): int {
    var result = 0
    var shift = 0
    var more = true
    while (more) {
        val byte = this.byte()
        result = result | ((byte & 127) << shift)
        shift = shift + 7
        more = (byte & 128) != 0 && shift < 35 && this.at <= this.data.size
    }
    result
}

fun BootstrapWasmReader.name(): string {
    val length = this.unsigned()
    val begin = this.at
    if (length < 0 || begin + length > this.data.size) {
        this.fail()
        return ""
    }
    this.at = begin + length
    this.data.slice(begin, begin + length)
}

// Skips a limits entry: the flags, the minimum and, with bit 0, the maximum.
fun BootstrapWasmReader.limits(): void {
    val flags = this.unsigned()
    this.unsigned()
    if ((flags & 1) != 0) this.unsigned()
}

// Whether the linked WebAssembly module at `path` imports the function
// `write` from `abla_host`: its import section (id 2) is walked entry by
// entry, so bytes of other sections that spell the same names do not count.
fun bootstrapWasmImportsHostWrite(path: string): bool {
    val reader = BootstrapWasmReader(Path(path).readText(), 8)
    val data = reader.data
    var found = false
    if (data.size < 8 || data[0] != 0 || data[1] != 97 || data[2] != 115 || data[3] != 109) {
        return false
    }
    while (!found && !reader.ended()) {
        val id = reader.byte()
        val size = reader.unsigned()
        val end = reader.at + size
        if (id == 2) {
            var count = reader.unsigned()
            while (!found && count > 0 && reader.at <= data.size) {
                count = count - 1
                val module = reader.name()
                val field = reader.name()
                val kind = reader.byte()
                // function: type index; table: reference type, limits;
                // memory: limits; global: value type, mutability; tag: attribute, type
                if (kind == 0) {
                    reader.unsigned()
                    found = module == "abla_host" && field == "write"
                } else if (kind == 1) {
                    reader.byte()
                    reader.limits()
                } else if (kind == 2) reader.limits()
                else if (kind == 3) {
                    reader.byte()
                    reader.byte()
                } else if (kind == 4) {
                    reader.byte()
                    reader.unsigned()
                } else reader.fail()
            }
        }
        if (reader.at <= data.size) reader.at = end
    }
    found
}

fun bootstrapDisposeHeldModule(): void {
    if (!pointerIsNull(bootstrapLlvmHeldModule)) LLVMDisposeModule(bootstrapLlvmHeldModule)
    if (!pointerIsNull(bootstrapLlvmHeldContext)) LLVMContextDispose(bootstrapLlvmHeldContext)
    bootstrapLlvmHeldModule = nativeNullPointer()
    bootstrapLlvmHeldContext = nativeNullPointer()
    return
}

// `ablac --codegen-unit <kind> <triple> <module.bc> <plan> <index> <object> <cache> <salt>`:
// unit `index` of a fast build cut into code generation units (codegen_units.ab) by
// the plan file `plan`. Reads the parent's optimized module lazily, declares what
// other units define, moves the rest into a module of its own (which reads only this
// unit's bodies) and writes its object with the parent's code generation settings:
// `kind` `native` (a generic CPU, PIC, FastISel), or `wasm` / `wasm-eh` (static, with
// exception handling). With the code generation cache `cache` (not ""), the object
// is materialized privately before reporting a hit; newly generated bytes are
// published atomically. `<object>.path` is metadata, never the parent's input.
trusted fun bootstrapEmitCodegenUnit(
    kind: string,
    llvmTriple: string,
    bitcodePath: string,
    planPath: string,
    index: int,
    objectPath: string,
    cache: string,
    salt: string
): int {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    val lazy = nativePointerCell(nullPointer)
    val target = nativePointerCell(nullPointer)
    val context = LLVMContextCreate()
    LLVMContextSetDiscardValueNames(context, 1)
    val wasm = kind == "wasm" || kind == "wasm-eh"
    val exceptions = kind == "wasm-eh"
    val plan = bootstrapReadCodegenUnitPlan(planPath)
    var status = if (index >= 0) 0 else 2
    if (status == 0 && LLVMCreateMemoryBufferWithContentsOfFile(
        bitcodePath, buffer.address, message.address
    ) != 0) status = 145
    // (The module takes the buffer when it is read.)
    if (status == 0 && LLVMGetBitcodeModuleInContext2(
        context, buffer.load(), lazy.address
    ) != 0) {
        LLVMDisposeMemoryBuffer(buffer.load())
        status = 145
    }
    if (status == 0 && wasm) {
        LLVMInitializeWebAssemblyTargetInfo()
        LLVMInitializeWebAssemblyTarget()
        LLVMInitializeWebAssemblyTargetMC()
        LLVMInitializeWebAssemblyAsmPrinter()
        LLVMInitializeWebAssemblyAsmParser()
        if (exceptions) bootstrapSetLlvmWasmExceptions(true)
    } else if (status == 0 && llvmInitializeNativeTarget() != 0) status = 166
    var module = nullPointer
    if (status == 0 && !bootstrapCodegenUnitStrip(lazy.load(), plan, index)) {
        LLVMDisposeModule(lazy.load())
        status = 2
    }
    if (status == 0) {
        // Linking into an empty module reads the bodies it moves, and only those; it
        // takes the target, data layout, module flags and inline assembly along, and
        // leaves out what nothing kept names. (The lazy module is gone either way.)
        module = LLVMModuleCreateWithNameInContext("unit", context)
        if (LLVMLinkModules2(module, lazy.load()) != 0) status = 145
    }
    val triple = LLVMNormalizeTargetTriple(llvmTriple)
    if (status == 0 && LLVMGetTargetFromTriple(triple, target.address, message.address) != 0) {
        status = 166
    }
    var machine = nullPointer
    var layout = nullPointer
    if (status == 0) {
        machine = if (wasm) LLVMCreateTargetMachine(target.load(), triple, "", "", 0, 1, 0)
            else LLVMCreateTargetMachine(target.load(), triple, "generic", "", 0, 2, 0)
        if (pointerIsNull(machine)) status = 166
        else if (!wasm) LLVMSetTargetMachineGlobalISel(machine, 0)
    }
    if (status == 0) {
        layout = LLVMCreateTargetDataLayout(machine)
        LLVMSetModuleDataLayout(module, layout)
    }
    // The cache's key: the unit's whole module as the code generator gets it, and
    // what generates it.
    var entry = ""
    var reused = false
    if (status == 0 && cache != "") {
        val bitcode = LLVMWriteBitcodeToMemoryBuffer(module)
        if (pointerIsNull(bitcode)) status = 169
        else {
            val start = LLVMGetBufferStart(bitcode)
            val size = LLVMGetBufferSize(bitcode)
            val identity = "$kind $llvmTriple $salt"
            val first = bootstrapCodegenBytesHash(start, size, bootstrapCodegenTextHash(identity,
                3))
            val second = bootstrapCodegenBytesHash(start, size, bootstrapCodegenTextHash(identity,
                5))
            LLVMDisposeMemoryBuffer(bitcode)
            entry = "$cache/${bootstrapCodegenHex(first)}${bootstrapCodegenHex(second)}.o"
            reused = Path(entry).info().isFile() &&
                bootstrapCodegenMaterializeHit(entry, objectPath)
        }
    }
    if (status == 0 && !reused && LLVMTargetMachineEmitToFile(
        machine, module, objectPath, 1, message.address
    ) != 0) status = 168
    // Cache publication is optional; a complete private part is sufficient.
    if (status == 0 && entry != "" && !reused) {
        bootstrapCodegenPublish(entry, objectPath)
    }
    if (status == 0 && entry != "" &&
        !Path("$objectPath.path").writeText("$entry\n${if (reused) "1" else "0"}")) status = 145
    if (status != 0 && !pointerIsNull(message.load())) {
        linuxPrintStandardError(
            "error[E_LLVM_CODEGEN]: unit $index: ${nativeCString(message.load())}\n"
        )
    }
    if (!pointerIsNull(layout)) LLVMDisposeTargetData(layout)
    if (!pointerIsNull(machine)) LLVMDisposeTargetMachine(machine)
    if (!pointerIsNull(module)) LLVMDisposeModule(module)
    LLVMContextDispose(context)
    if (exceptions) bootstrapSetLlvmWasmExceptions(false)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    LLVMDisposeMessage(triple)
    buffer.close()
    message.close()
    lazy.close()
    target.close()
    status
}

fun bootstrapExternalEmitObjectForTarget(
    llvmPath: string,
    objectPath: string,
    llvmTriple: string,
    fast: bool
): int {
    val tools = bootstrapXtensaLlvmTools(llvmTriple)
    if (tools.error != "") {
        linuxPrintStandardError(tools.error)
        return 188
    }
    bootstrapExternalEmitObjectForTargetWithTools(llvmPath, objectPath, llvmTriple, fast, tools)
}

fun bootstrapExternalEmitObjectForTargetWithTools(
    llvmPath: string,
    objectPath: string,
    llvmTriple: string,
    fast: bool,
    tools: BootstrapXtensaTools
): int {
    // Cross-target LLVM still contains the complete portable runtime. Even a
    // fast build must prune unreachable host-only implementation details before
    // llc validates target-specific inline assembly and register constraints.
    val targetLlvmPath = "$objectPath.target.ll"
    val mcuTarget = bootstrapTextContains(llvmTriple, "xtensa") ||
        bootstrapTextContains(llvmTriple, "riscv32") ||
        bootstrapTextContains(llvmTriple, "thumb")
    var optimizationSource = llvmPath
    var prepared = true
    var inspectAssembly = tools.root != "" && llvmPath.endsWith(".bc")
    // Bitcode comes straight from the module, which defines no runtime panic to patch.
    val bitcodeInput = llvmPath.size > 3 &&
        llvmPath.slice(llvmPath.size - 3, llvmPath.size) == ".bc"
    if (llvmTriple != "x86_64-unknown-linux-gnu" && !bitcodeInput) {
        val source = bootstrapTargetNeutralPanicRuntime(Path(llvmPath).readText())
        inspectAssembly = tools.root != "" &&
            (bootstrapTextContains(source, "ABLA_XTENSA_") ||
             bootstrapTextContains(source, "WindowVectors"))
        prepared = Path(targetLlvmPath).writeTextAtomic(source)
        if (prepared) optimizationSource = targetLlvmPath
    }
    // GNU-as layout markers must not silently become LLVM-assembler comments.
    // Inspect after dead-code removal, so unused SDK vector helpers don't
    // constrain ordinary programs. Only this uncommon path prints optimized IR.
    val inputPath = "$objectPath.bc"
    val checkedPath = "$objectPath.checked.ll"
    val optimize = bootstrapXtensaCommand(tools, "opt")
    bootstrapXtensaTargetOptions(tools, optimize)
    val passes = if (fast) {
        // Scalar promotion, local cleanup and the inliner (small helpers and
        // column accessors dominate generated code), without O1's loop and
        // global passes: on a large wasm module opt + llc drop from ~13s to ~7s
        // while keeping most of O1's runtime speed. Before inlining only
        // mem2reg + simplifycfg run (SROA and instcombine run after it anyway).
        "-passes=${bootstrapFastPasses()}"
    } else if (mcuTarget) {
        // Freestanding bindings often keep a wide callback ABI for an
        // address-taken entry while ordinary direct calls supply constant
        // trailing slots. Generic IPSCCP specialization clones those direct
        // paths with the constants folded, then dead-argument elimination
        // removes their register/stack setup. The foreign callback remains
        // intact, so this is safe for every MCU target and needs no
        // platform-specific annotation. Size comes from the minsize attribute
        // below (LLVM 23 dropped default<Oz> for O2 on minsize functions).
        "-passes=default<O2>,ipsccp<func-spec>,deadargelim,globaldce"
    } else "-passes=default<O2>,globaldce"
    optimize.argument(if (tools.root != "" && !tools.keepUnwind) "$passes,forceattrs" else passes)
    // Every function is minsize on an MCU (optnone ones keep theirs), so llc's
    // code generation optimizes for size as well.
    if (mcuTarget && !fast) optimize.argument("--force-attribute=minsize")
    // MCU panic traps: emit no unwind tables, rather than stripping them later.
    if (tools.root != "" && !tools.keepUnwind) optimize.argument("--force-attribute=nounwind")
    // LLVM can still expand constant-trip loops under minsize. On MCUs this often
    // duplicates MMIO and call sequences (for example one copy per byte or
    // digit), increasing both flash use and instruction-cache pressure. Make
    // the size policy automatic for every supported MCU target instead of
    // requiring source annotations on individual loops.
    if (mcuTarget && !fast) optimize.argument("--disable-loop-unrolling")
    val verify = bootstrapLlvmToolsVerify()
    if (!verify && bitcodeInput) optimize.argument("--disable-verify")
    // Names of local values are nearly half of opt's output for a large module, and nothing
    // after it reads them (globals keep theirs): the bitcode handoff drops them in opt and llc.
    // A text handoff (ABLA_KEEP_LLVM_TEXT=1) keeps them for whoever reads the IR.
    if (bitcodeInput) optimize.argument("--discard-value-names")
    optimize.argument(optimizationSource)
    optimize.argument("-o")
    optimize.argument(inputPath)
    var status = if (prepared) optimize.run() else 1
    if (status == 0 && inspectAssembly) {
        // Inspect a separate rendering; code generation keeps the original
        // bitcode and its use-list order, exactly as the SDK wrapper does.
        val inspect = bootstrapXtensaCommand(tools, "opt")
        inspect.argument("-S").argument("-passes=no-op-module").argument(inputPath)
        inspect.argument("-o").argument(checkedPath)
        status = inspect.run()
    }
    if (status == 0 && inspectAssembly) {
        val optimized = Path(checkedPath).readText()
        if (bootstrapTextContains(optimized, "ABLA_XTENSA_") ||
            bootstrapTextContains(optimized, "WindowVectors")) {
            linuxPrintStandardError(
                "error[E_XTENSA_EXTERNAL_ASSEMBLER]: retained boot/vector assembly needs the ESP SDK's GNU-as layout step; the companion handles ordinary Abla code generation, not GNU layout directives\n"
            )
            status = 189
        }
    }
    if (status == 0) {
        val emitObject = bootstrapXtensaCommand(tools, "llc")
        bootstrapXtensaTargetOptions(tools, emitObject)
        emitObject.argument(if (tools.root != "") "-filetype=asm" else "-filetype=obj")
        // A WebAssembly module links as one static module (no -pie), so
        // position-independent code only reaches its globals through the GOT,
        // and fast instruction selection gives up on every global address
        // under PIC.
        val staticWasm = fast && bootstrapTextContains(llvmTriple, "wasm")
        emitObject.argument(
            if (staticWasm || tools.root !=
                "") "-relocation-model=static" else "-relocation-model=pic"
        )
        emitObject.argument(if (fast) "-O0" else "-O2")
        emitObject.argument("-mtriple=$llvmTriple")
        if (tools.root != "") {
            if (tools.directCalls) emitObject.argument("-xtensa-direct-calls")
            if (tools.narrowBranches) emitObject.argument("-xtensa-narrow-branches")
            if (tools.textLiterals) emitObject.argument("-xtensa-text-section-literals")
        }
        if (bootstrapTextContains(llvmTriple, "wasm")) {
            for (option in bootstrapWasmExceptionOptions()) emitObject.argument(option)
        }
        if (!verify) emitObject.argument("--disable-verify")
        if (bitcodeInput) emitObject.argument("--discard-value-names")
        if (mcuTarget) {
            emitObject.argument("--function-sections")
            emitObject.argument("--data-sections")
        }
        emitObject.argument(inputPath)
        emitObject.argument("-o")
        val assemblyPath = "$objectPath.xtensa.s"
        emitObject.argument(if (tools.root != "") assemblyPath else objectPath)
        status = emitObject.run()
        if (status == 0 && tools.root != "") {
            val emitted = Path(assemblyPath).readText()
            // Literal placement is required even with instruction narrowing off:
            // llc's text printer can leave the previous jump-table section active.
            val narrowed = bootstrapXtensaNarrowAssembly(emitted, tools.keepUnwind,
                tools.narrowAssembly)
            val aligned = bootstrapXtensaAlignedAssembly(narrowed)
            val modulePath = "$objectPath.assembly.ll"
            if (!Path(modulePath).writeText(bootstrapXtensaAssemblyModule(aligned))) status = 190
            else {
                val assemble = bootstrapXtensaCommand(tools, "llc")
                bootstrapXtensaTargetOptions(tools, assemble)
                assemble.argument("-mtriple=$llvmTriple")
                assemble.argument("-relocation-model=static")
                assemble.argument("-filetype=obj")
                if (tools.textLiterals) assemble.argument("-xtensa-text-section-literals")
                assemble.argument(modulePath).argument("-o").argument(objectPath)
                status = assemble.run()
            }
            if (status !=
                0) linuxPrintStandardError("error[E_XTENSA_ASSEMBLY]: private Xtensa assembly legalization or integrated assembly failed; no object is accepted\n")
            Path(modulePath).remove()
            Path(assemblyPath).remove()
        }
    }
    Path(targetLlvmPath).remove()
    if (inspectAssembly) Path(checkedPath).remove()
    status
}

fun bootstrapNativeCacheHash(
    source: string,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = seed
    var index = 0
    // Four bytes a step: this hashes the whole compiler.
    while (index + 4 <= source.size) {
        hash = hash * factor + textReadU32LittleEndian(source, index) + 1
        hash = hash - (hash / modulus) * modulus
        index = index + 4
    }
    while (index < source.size) {
        hash = hash * factor + source[index] + 1
        hash = hash - (hash / modulus) * modulus
        index = index + 1
    }
    hash
}

// /proc/self/exe names this process's running image, including after its path
// is replaced. Keep only integer fingerprints: a nested build may run inside
// a memory checkpoint, so retaining its allocated image text would be unsafe.
var bootstrapRunningImageSize: int = -1
var bootstrapRunningImageFirst: int = 41
var bootstrapRunningImageSecond: int = 101
var bootstrapRunningImageTail: int = 0

fun bootstrapReadRunningImageIdentity(): void {
    if (bootstrapRunningImageSize >= 0) return
    val image = Path("/proc/self/exe").readText()
    // A failed read is retried, and still disables this build's object cache.
    if (image.size == 0) return
    // Preserve both fingerprints, but fetch each word only once. The image
    // is still read and fully hashed in each process: no file-stat shortcut.
    var first = 41
    var second = 101
    var index = 0
    // Two words a step: x * 269 * 269 + w0 * 269 + w1 is the same residue as two
    // single steps (every term stays far below 2^63), with half the divisions.
    while (index + 8 <= image.size) {
        val low = textReadU32LittleEndian(image, index) + 1
        val high = textReadU32LittleEndian(image, index + 4) + 1
        first = first * 72361 + low * 269 + high
        first = first - (first / 1000000007) * 1000000007
        second = second * 73441 + low * 271 + high
        second = second - (second / 1000000009) * 1000000009
        index = index + 8
    }
    if (index + 4 <= image.size) {
        val word = textReadU32LittleEndian(image, index) + 1
        first = first * 269 + word
        first = first - (first / 1000000007) * 1000000007
        second = second * 271 + word
        second = second - (second / 1000000009) * 1000000009
        index = index + 4
    }
    bootstrapRunningImageFirst = first
    bootstrapRunningImageSecond = second
    val aligned = index
    var tail = 0
    while (index < image.size) {
        tail = tail | (image[index] << ((index - aligned) * 8))
        index = index + 1
    }
    bootstrapRunningImageTail = tail
    bootstrapRunningImageSize = image.size
    return
}

// Preserve bootstrapNativeCacheHash's four-byte grouping across the image /
// backend boundary, even for an executable with one to three trailing bytes.
fun bootstrapRunningImageSuffix(backend: string, tail: int, count: int): string {
    if (count == 0) return "\n$backend"
    val bytes = byteBuffer()
    var remainder = tail
    var index = 0
    while (index < count) {
        bytes.appendByteValue(remainder & 255)
        remainder = remainder / 256
        index = index + 1
    }
    bytes.appendText("\n$backend")
    bytes.toText()
}

fun bootstrapCopyNativeObject(source: string, destination: string): int {
    val copy = linuxCommand("cp")
    copy.argument("--")
    copy.argument(source)
    copy.argument(destination)
    copy.run()
}

// Where a Darwin link finds OpenSSL: ABLA_MACOS_OPENSSL_LIB, else Homebrew's
// openssl@3 on a macOS host; empty when the target is not Darwin.
fun bootstrapMacOpenSslLibraryDirectory(macTarget: bool): string {
    val configured = linuxEnvironment("ABLA_MACOS_OPENSSL_LIB")
    var directory = ""
    if (macTarget && configured.found && configured.value != "") {
        directory = configured.value
    } else if (macTarget && ablaHostIsMacOS()) {
        directory = if (
            bootstrapTripleArchitecture(llvmDefaultTargetTriple()) == "arm64"
        ) "/opt/homebrew/opt/openssl@3/lib"
        else "/usr/local/opt/openssl@3/lib"
    }
    directory
}

fun bootstrapNamesOpenSsl(libraries: array<string>): bool {
    var names = false
    var index = 0
    while (index < libraries.size) {
        if (libraries[index] == "ssl" || libraries[index] == "crypto") {
            names = true
        }
        index = index + 1
    }
    names
}

// A cache member is replaced whole (a copy beside it, then a rename): another
// build that already validated the record reads the old file or the new one,
// never a partial copy.
fun bootstrapPublishCacheFile(source: string, destination: string): int {
    val temporary = "$destination.tmp.${linuxProcessId()}"
    var status = bootstrapCopyNativeObject(source, temporary)
    if (status == 0 && !Path(temporary).moveTo(Path(destination))) status = 145
    if (status != 0) Path(temporary).remove()
    status
}

// Whether no process has id `process` (kill(process, 0): ESRCH).
fun bootstrapProcessGone(process: int): bool = linuxSyscall2(62, process, 0) == -3

// The process id in a temporary's name, from `start` on: the digits after the
// first `.tmp.` or `.publish.`, up to the end of the name or a dot; else -1.
fun bootstrapTemporaryOwner(name: string, start: int): int {
    var index = start
    while (index < name.size) {
        var digits = -1
        if (name.size >= index + 5 && name.slice(index, index + 5) == ".tmp.") digits = index + 5
        if (name.size >= index + 9 && name.slice(index,
            index + 9) == ".publish.") digits = index + 9
        if (digits > 0) {
            var end = digits
            var owner = 0
            while (end < name.size && end - digits < 9 && name[end] >= 48 && name[end] <= 57) {
                owner = owner * 10 + name[end] - 48
                end = end + 1
            }
            if (end > digits && (end == name.size || name[end] == 46)) return owner
        }
        index = index + 1
    }
    -1
}

// Removes what builds of `outputPath` left beside it on their way to publishing
// it: files and directories named after it with `.tmp.<pid>` or `.publish.<pid>`
// in their name, this process's, and those of processes that have gone (a build
// that was stopped).
fun bootstrapRemoveBuildTemporaries(outputPath: string): void {
    val output = Path(outputPath)
    val stem = "${output.name()}."
    val self = linuxProcessId()
    for (entry in output.parent().entries()) {
        val name = entry.name()
        if (name.size > stem.size && name.slice(0, stem.size) == stem) {
            val owner = bootstrapTemporaryOwner(name, stem.size - 1)
            if (owner > 0 && (owner == self || bootstrapProcessGone(owner))) entry.removeTree()
        }
    }
    return
}

// The process id that ends `name` after `prefix` (with `serial`, digits then
// `-` may follow), else -1.
fun bootstrapScratchOwner(name: string, prefix: string, serial: bool): int {
    if (name.size <= prefix.size || name.slice(0, prefix.size) != prefix) return -1
    var end = prefix.size
    var owner = 0
    while (end < name.size && end - prefix.size < 9 && name[end] >= 48 && name[end] <= 57) {
        owner = owner * 10 + name[end] - 48
        end = end + 1
    }
    var matched = end > prefix.size
    if (matched && end < name.size) matched = serial && name[end] == 45
    if (matched) owner else -1
}

// What builds that were stopped left in build/ of the working directory: each
// process's scratch directories, removed once it has gone.
fun bootstrapRemoveAbandonedBuildScratch(): void {
    val scratch = [
        ".abla-compile-outputs-", ".abla-compile-globals-",
        ".abla-program-requests-", ".abla-defined-targets-",
        ".abla-export-requests-", ".abla-artifact-root-requests-",
        ".abla-function-body-replacements-",
        ".abla-function-annotation-additions-",
        ".abla-driver-diagnostics-", ".abla-generated-module-requests-"
    ]
    val self = linuxProcessId()
    for (entry in Path("build").entries()) {
        val name = entry.name()
        var owner = -1
        var kind = 0
        while (owner < 0 && kind < scratch.size) {
            owner = bootstrapScratchOwner(name, scratch[kind], false)
            kind = kind + 1
        }
        if (owner > 0 && owner != self && bootstrapProcessGone(owner)) entry.removeTree()
    }
    return
}

// Clean-up of old build transactions. Compilers up to 0.2.32 moved a build's
// earlier outputs into build/.abla-build-transaction-<pid> (-<pid>-<n> for a few
// builds of master) to put them back if it failed, and a build that was stopped
// left that behind. They go once their process has gone, with nothing put back:
// builds since have made those outputs again. This step goes once no compiler
// that makes them is in use (TODO.md).
fun bootstrapRemoveOldBuildTransactions(): void {
    val self = linuxProcessId()
    for (entry in Path("build").entries()) {
        val owner = bootstrapScratchOwner(entry.name(), ".abla-build-transaction-", true)
        if (owner > 0 && owner != self && bootstrapProcessGone(owner)) entry.removeTree()
    }
    return
}

// An external tool as a cache key sees it: the file a command name runs (found on
// PATH as an exec finds it), its size and modification time. A tool replaced in
// place, or another one ahead of it on PATH, is another identity.
fun bootstrapToolIdentity(command: string): string {
    val path = linuxExecutablePath(command)
    val info = Path(path).info()
    "$path:${info.size}:${info.revision}"
}

// Where the cache keeps an object made from `identity` (everything the object is a
// function of): `<stem>-<size>-<hash>-<hash>.o`.
fun bootstrapToolObjectCachePath(stem: string, identity: string): string {
    val first = bootstrapNativeCacheHash(identity, 239, 317, 1000000007)
    val second = bootstrapNativeCacheHash(identity, 241, 331, 1000000009)
    "$stem-${identity.size}-$first-$second.o"
}

class BootstrapPartitionEmission(
    val status: int,
    val reused: int,
    val refreshed: int
)

// Binaryen's worker threads for a release Wasm module's wasm-opt: ABLA_WASM_OPT_CORES, else the
// online CPUs up to 4. Its output does not depend on how many run; uncapped, it sizes the pool
// from every CPU a sandbox reports, which can be very many.
// A hosted release executable links its own LTO object; its ordinary object, the
// relocatable sidecar (`<output>.o`), is a second optimization and code generation of
// the whole program that nothing in the build reads, so it is built only on request:
// `build --sidecar` (or ABLA_SIDECAR=1). `--no-sidecar` (or ABLA_NO_SIDECAR=1)
// declines it whatever the environment asks; a flag wins over the environment.
// 1 requested, 0 declined, -1 neither flag given.
var bootstrapNativeSidecarRequest: int = -1

fun bootstrapNativeSidecarWanted(): bool {
    if (bootstrapNativeSidecarRequest >= 0) return bootstrapNativeSidecarRequest == 1
    val declined = linuxEnvironment("ABLA_NO_SIDECAR")
    val requested = linuxEnvironment("ABLA_SIDECAR")
    requested.found && requested.value == "1" &&
        !(declined.found && declined.value == "1")
}

// A fast build's optimization pipeline (opt's, or the same passes in process).
fun bootstrapFastPasses(): string =
    "function(mem2reg,simplifycfg),cgscc(inline,function(sroa,early-cse,instcombine<no-verify-fixpoint>,simplifycfg)),globaldce"

// The inliner's threshold in fast builds: ABLA_FAST_INLINE_THRESHOLD, else 100
// (LLVM's default is 225). The inliner's cost analysis is the largest part of a
// fast build's opt, and what it inlines the code generator compiles again. The
// backend gives it to each function (bootstrapLlvmFastInlineThreshold).
fun bootstrapFastInlineThreshold(): int {
    val configured = linuxEnvironment("ABLA_FAST_INLINE_THRESHOLD")
    var threshold = 0
    var digits = 0
    if (configured.found) {
        while (digits < configured.value.size && configured.value[digits] >= 48 &&
               configured.value[digits] <= 57) {
            threshold = threshold * 10 + configured.value[digits] - 48
            digits = digits + 1
        }
    }
    if (digits == 0 || digits != configured.value.size) threshold = 100
    threshold
}

fun bootstrapWasmOptCores(): int {
    val configured = linuxEnvironment("ABLA_WASM_OPT_CORES")
    var detected = if (configured.found) configured.value else ""
    if (detected == "") detected =
        linuxCommand("getconf").argument("_NPROCESSORS_ONLN").captureText()
    var cores = 0
    var index = 0
    while (index < detected.size && detected[index] >= 48 &&
           detected[index] <= 57) {
        cores = cores * 10 + detected[index] - 48
        index = index + 1
    }
    if (cores < 1) cores = 1
    if (!configured.found && cores > 4) cores = 4
    if (cores > 64) cores = 64
    cores
}

fun bootstrapNativeParallelism(): int {
    val configured = linuxEnvironment("ABLA_NATIVE_JOBS")
    var detected = if (configured.found) configured.value else ""
    if (detected == "") detected = linuxCommand("nproc").captureText()
    var jobs = 0
    var index = 0
    while (index < detected.size && detected[index] >= 48 &&
           detected[index] <= 57) {
        jobs = jobs * 10 + detected[index] - 48
        index = index + 1
    }
    if (jobs < 1) jobs = 1
    if (jobs > 32) jobs = 32
    jobs
}

// Cached development partitions only need explicit inline expansion and local
// cleanup. Keeping this preparation light preserves low-latency --fast misses.
fun bootstrapPreparePartitionLlvm(
    llvmPath: string,
    preparedPath: string
): int {
    val prepare = linuxCommand(bootstrapHostLlvmTool("opt"))
    prepare.argument(
        "-passes=always-inline,function(sroa,mem2reg,early-cse,instcombine<no-verify-fixpoint>,simplifycfg,dse,adce),globaldce"
    )
    prepare.argument("-S")
    prepare.argument(llvmPath)
    prepare.argument("-o")
    prepare.argument(preparedPath)
    prepare.run()
}

// The text pruning below, on the held module: function uses lead either to
// their containing function or through constants to a global (an outside root).
// Globals and assembly may also name functions as text, as the old walk did.

trusted fun bootstrapPruneHeldCompilerModule(): void {
    val module = bootstrapLlvmHeldModule
    val functions: array<int> = []
    val slots: Map<string, int> = Map()
    val addresses: Map<int, int> = Map()
    val kept: array<bool> = []
    val pending: array<int> = []
    val edges: array<array<int>> = []
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == 0) {
            val index = functions.size
            val name = bootstrapLlvmDebugValueName(function)
            val local = LLVMGetLinkage(function) == llvmInternalLinkage() ||
                LLVMGetLinkage(function) == llvmPrivateLinkage()
            val generated = name.startsWith("abla_fn_") &&
                (local || LLVMGetVisibility(function) == 1)
            val root = !local && !generated
            functions.append(nativePointerAddress(function))
            slots.set(name, index)
            addresses.set(nativePointerAddress(function), index)
            kept.append(root)
            edges.append([])
            if (root) pending.append(index)
        }
        function = LLVMGetNextFunction(function)
    }
    var index = 0
    while (index < functions.size) {
        val values: array<int> = [functions[index]]
        val seen: Map<int, bool> = Map()
        var head = 0
        while (head < values.size) {
            val value = nativePointerFromAddress(values[head])
            head = head + 1
            var use = LLVMGetFirstUse(value)
            while (!pointerIsNull(use)) {
                val user = LLVMGetUser(use)
                var owner = nativeNullPointer()
                if (!pointerIsNull(LLVMIsAInstruction(user))) {
                    owner = LLVMGetBasicBlockParent(LLVMGetInstructionParent(user))
                } else if (!pointerIsNull(LLVMIsAGlobalValue(user))) owner = user
                if (!pointerIsNull(owner)) {
                    val caller = addresses.get(nativePointerAddress(owner))
                    if (caller != null) edges[caller].append(index)
                    else if (!kept[index]) {
                        kept[index] = true
                        pending.append(index)
                    }
                } else if (seen.get(nativePointerAddress(user)) == null) {
                    seen.set(nativePointerAddress(user), true)
                    values.append(nativePointerAddress(user))
                }
                use = LLVMGetNextUse(use)
            }
        }
        index = index + 1
    }
    var global = LLVMGetFirstGlobal(module)
    while (!pointerIsNull(global)) {
        val initializer = LLVMGetInitializer(global)
        if (!pointerIsNull(initializer) && !pointerIsNull(LLVMIsAConstantDataArray(initializer)) &&
            LLVMGetTypeKind(LLVMTypeOf(initializer)) == 11 &&
            LLVMGetTypeKind(LLVMGetElementType(LLVMTypeOf(initializer))) == 8 &&
            LLVMGetIntTypeWidth(LLVMGetElementType(LLVMTypeOf(initializer))) == 8) {
            val length = nativeByteBuffer(8)
            val data = LLVMGetAsString(initializer, length.pointerAt(0))
            val size = length.loadI64(0)
            length.close()
            bootstrapHeldMarkStringReferences(data, size, slots, kept, pending)
        }
        global = LLVMGetNextGlobal(global)
    }
    for (assembly in bootstrapLlvmInlineAssembly) {
        bootstrapLlvmMarkReferences(assembly, slots, kept, pending)
    }
    var head = 0
    while (head < pending.size) {
        for (callee in edges[pending[head]]) {
            if (!kept[callee]) {
                kept[callee] = true
                pending.append(callee)
            }
        }
        head = head + 1
    }
    index = 0
    while (index < functions.size) {
        if (!kept[index]) {
            function = nativePointerFromAddress(functions[index])
            // All remaining users are in other dead functions. Clear those
            // references before deleting mutually recursive unreachable bodies.
            LLVMReplaceAllUsesWith(function, LLVMGetUndef(LLVMTypeOf(function)))
            LLVMDeleteFunction(function)
        }
        index = index + 1
    }
    return
}

noescape extern:"c" fun LLVMGetAsString(value: i64*, length: i64*): i64*
noescape extern:"c" fun LLVMIsAConstantDataArray(value: i64*): i64*

// Only literal symbol references need a textual walk: pointer-valued global
// initializers were already followed through LLVM uses. Scan bytes in place,
// avoiding rendering and copying every global initializer just to find names.
trusted fun bootstrapHeldMarkStringReferences(
    data: i64*, size: int, slots: Map<string, int>,
    var kept: array<bool>, var pending: array<int>
): void {
    var offset = 0
    while (offset < size) {
        val byte = ablaUnsafeLoadU8(ablaUnsafePointerOffset(data, offset))
        var generated = false
        if (byte == 97 && offset + 8 <= size) {
            generated = true
            var digit = 0
            while (generated && digit < 8) {
                generated = ablaUnsafeLoadU8(ablaUnsafePointerOffset(data,
                    offset + digit)) == "abla_fn_"[digit]
                digit = digit + 1
            }
        }
        if (byte == 64 || generated) {
            var first = if (byte == 64) offset + 1 else offset
            var last = first
            if (last < size && ablaUnsafeLoadU8(ablaUnsafePointerOffset(data, last)) == 34) {
                first = first + 1
                last = first
                while (last < size && ablaUnsafeLoadU8(ablaUnsafePointerOffset(data,
                    last)) != 34) last = last + 1
            } else {
                while (last < size &&
                    bootstrapLlvmNameByte(ablaUnsafeLoadU8(ablaUnsafePointerOffset(data,
                        last)))) last = last + 1
            }
            val buffer = nativeByteBuffer(last - first + 1)
            var digit = first
            while (digit < last) {
                buffer.store(digit - first, ablaUnsafeLoadU8(ablaUnsafePointerOffset(data, digit)))
                digit = digit + 1
            }
            val slot = slots.get(buffer.adoptString(last - first))
            if (slot != null && !kept[slot]) {
                kept[slot] = true
                pending.append(slot)
            }
            offset = if (last > offset) last else offset + 1
        } else offset = offset + 1
    }
    return
}

// Keep whole-module inlining/IPO and the early scalar cleanup, loop-MSSA
// and MemCpyOpt that enable profitable cross-part inlines. Defer reassociate,
// loop-idiom/indvars/loop-deletion/full-unroll, SCCP, BDCE and ADCE to each
// part's O2. Also omit O1's post-IPO function pipeline, three late CGSCC
// InstCombines and post-unroll SROA, as in the earlier preparation screen.
// LLVM 23 bitcode: serial preparation 195.3 -> 173.4 G instructions (-11.2%);
// serial + planner + largest of 20 parts 243.6 -> 220.0 G (-9.7%), all-worker
// work +0.8%. Three matched produced-compiler medians: readers +0.09%, fib
// build -0.04%, own emission -0.29%, with identical IR (2026-11-03).
// An LLVM that rejects this expanded pipeline falls back to default<O1>,globaldce.
val BOOTSTRAP_COMPILER_RELEASE_PASSES =
    "memprof-remove-attributes,annotation2metadata,forceattrs,inferattrs,coro-early,function<eager-inv>(ee-instrument<>,lower-expect,simplifycfg<bonus-inst-threshold=1;no-forward-switch-cond;no-switch-range-to-icmp;no-switch-to-arithmetic;no-switch-to-lookup;keep-loops;no-hoist-common-insts;no-hoist-loads-stores-with-cond-faulting;no-sink-common-insts;speculate-blocks;simplify-cond-branch;no-speculate-unpredictables>,sroa<modify-cfg>,early-cse<>),openmp-opt,ipsccp,called-value-propagation,globalopt,function<eager-inv>(mem2reg,instcombine<max-iterations=1;no-verify-fixpoint>,simplifycfg<bonus-inst-threshold=1;no-forward-switch-cond;switch-range-to-icmp;no-switch-to-arithmetic;no-switch-to-lookup;keep-loops;no-hoist-common-insts;no-hoist-loads-stores-with-cond-faulting;no-sink-common-insts;speculate-blocks;simplify-cond-branch;no-speculate-unpredictables>),always-inline,require<globals-aa>,function(invalidate<aa>),require<profile-summary>,cgscc(devirt<4>(inline,function-attrs<skip-non-recursive-function-attrs>,function<eager-inv;no-rerun>(sroa<modify-cfg>,early-cse<memssa>,simplifycfg<bonus-inst-threshold=1;no-forward-switch-cond;switch-range-to-icmp;no-switch-to-arithmetic;no-switch-to-lookup;keep-loops;no-hoist-common-insts;no-hoist-loads-stores-with-cond-faulting;no-sink-common-insts;speculate-blocks;simplify-cond-branch;no-speculate-unpredictables>,instcombine<max-iterations=1;no-verify-fixpoint>,libcalls-shrinkwrap,simplifycfg<bonus-inst-threshold=1;no-forward-switch-cond;switch-range-to-icmp;no-switch-to-arithmetic;no-switch-to-lookup;keep-loops;no-hoist-common-insts;no-hoist-loads-stores-with-cond-faulting;no-sink-common-insts;speculate-blocks;simplify-cond-branch;no-speculate-unpredictables>,loop-mssa(loop-instsimplify,loop-simplifycfg,licm<no-allowspeculation>,loop-rotate<header-duplication;no-prepare-for-lto;no-check-exit-count>,licm<allowspeculation>,simple-loop-unswitch<no-nontrivial;trivial>),simplifycfg<bonus-inst-threshold=1;no-forward-switch-cond;switch-range-to-icmp;no-switch-to-arithmetic;no-switch-to-lookup;keep-loops;no-hoist-common-insts;no-hoist-loads-stores-with-cond-faulting;no-sink-common-insts;speculate-blocks;simplify-cond-branch;no-speculate-unpredictables>,memcpyopt,coro-elide,simplifycfg<bonus-inst-threshold=1;no-forward-switch-cond;switch-range-to-icmp;no-switch-to-arithmetic;no-switch-to-lookup;keep-loops;no-hoist-common-insts;no-hoist-loads-stores-with-cond-faulting;no-sink-common-insts;speculate-blocks;simplify-cond-branch;no-speculate-unpredictables>),function-attrs,function(require<should-not-run-function-passes>),coro-split,coro-annotation-elide)),deadargelim,coro-cleanup,globalopt,globaldce,elim-avail-extern,rpo-function-attrs,recompute-globalsaa,alloc-token,globaldce,constmerge,cg-profile,rel-lookup-table-converter,lower-comment-string,function(annotation-remarks),globaldce"

fun bootstrapPrepareSplitLlvm(llvmPath: string, preparedPath: string): int {
    val prepare = linuxCommand(bootstrapHostLlvmTool("opt"))
    prepare.argument("-passes=$BOOTSTRAP_COMPILER_RELEASE_PASSES")
    // No consumer of the release bitcode needs temporary value names. The
    // explicit text/debug path keeps them for inspection.
    if (llvmPath.endsWith(".bc")) prepare.argument("--discard-value-names")
    prepare.argument(llvmPath)
    prepare.argument("-o")
    prepare.argument(preparedPath)
    val status = prepare.run()
    // As with the custom O2 profile, an older LLVM may not recognize an option.
    if (status == 0) 0 else {
        val fallback = linuxCommand(bootstrapHostLlvmTool("opt"))
        fallback.argument("-passes=default<O1>,globaldce")
        if (llvmPath.endsWith(".bc")) fallback.argument("--discard-value-names")
        fallback.argument(llvmPath)
        fallback.argument("-o")
        fallback.argument(preparedPath)
        fallback.run()
    }
}

// The LTO input's first step: clang and the LTO link optimize again after it, so it
// only inlines, which needs the wrappers visible. Against O1 and a cleanup here, a
// release build takes about 10% less CPU, and five benchmarks run the same; with only
// always-inline, json-readers runs 33% slower (2026-11-01).
fun bootstrapPrepareParallelLlvm(
    llvmPath: string,
    preparedPath: string,
    text: bool = true
): int {
    val prepare = linuxCommand(bootstrapHostLlvmTool("opt"))
    prepare.argument(
        "-passes=function(sroa,early-cse),always-inline,cgscc(devirt<1>(inline,function(sroa,early-cse,simplifycfg))),globalopt,globaldce"
    )
    if (text) prepare.argument("-S")
    prepare.argument(llvmPath)
    prepare.argument("-o")
    prepare.argument(preparedPath)
    prepare.run()
}

// A hosted Linux executable's optimization, in one opt and one llc: the module already
// holds the runtime, so all an LTO link adds is knowing what is visible, and internalize
// says that from the start. Inlining then counts each function's last call, and half the
// module is gone before the expensive passes run. The threshold is LLVM's O2 default: at 100
// abla-compare's HTTP servers ran 13% more instructions per request, and 300 is 2% faster for
// 3.7% more size over 14 programs. Nothing unwinds through Abla code, so without debug information `nounwind` drops
// its unwind tables, 4 to 6% of a program. Against opt's inlining, clang's O2 and an LTO link
// (2026-11-01, 14 programs): about 40% fewer instructions in those tools, and smaller.
fun bootstrapOptimizeWholeProgram(
    llvmPath: string,
    optimizedPath: string,
    objectPath: string,
    abiManifest: string
): int {
    val optimize = linuxCommand(bootstrapHostLlvmTool("opt"))
    val visible = bootstrapNativeAbiExportSymbols(abiManifest)
    visible.append("main")
    for (name in bootstrapFreestandingRoutineNames()) visible.append(name)
    bootstrapLlvmAssemblyNames(Path(llvmPath).readText(), visible)
    var names = ""
    var index = 0
    while (index < visible.size) {
        names = if (index == 0) visible[index] else "$names,${visible[index]}"
        index = index + 1
    }
    optimize.argument("-internalize-public-api-list=$names")
    optimize.argument("-inline-threshold=225")
    if (!bootstrapLlvmDebugInfo) optimize.argument("-force-attribute=nounwind")
    optimize.argument("-passes=internalize,$BOOTSTRAP_HOST_RELEASE_PASSES")
    optimize.argument(llvmPath)
    optimize.argument("-o")
    optimize.argument(optimizedPath)
    var status = optimize.run()
    if (status == 0) status = bootstrapEmitWholeProgramObject(optimizedPath, objectPath)
    status
}

// The optimized whole program's object, by llc: its loop alignment and sections are code
// generation flags that the C API can't set, so this one stays a tool.
fun bootstrapEmitWholeProgramObject(optimizedPath: string, objectPath: string): int =
    bootstrapWholeProgramObjectCommand(optimizedPath, objectPath).run()

fun bootstrapWholeProgramObjectCommand(optimizedPath: string, objectPath: string): LinuxCommand {
    val emitObject = linuxCommand(bootstrapHostLlvmTool("llc"))
    emitObject.argument("-filetype=obj")
    emitObject.argument("-relocation-model=pic")
    emitObject.argument("-O2")
    emitObject.argument("--function-sections")
    emitObject.argument("--data-sections")
    // Where a hot loop falls within a 32-byte fetch line otherwise decides its speed:
    // fib's code ran 11% slower at another address. Costs about 2% of size.
    emitObject.argument("--align-loops=32")
    if (!bootstrapLlvmToolsVerify()) emitObject.argument("--disable-verify")
    emitObject.argument(optimizedPath)
    emitObject.argument("-o")
    emitObject.argument(objectPath)
    emitObject
}

noescape extern:"c" fun LLVMPassBuilderOptionsSetLoopInterleaving(options: i64*, enabled: i32): void
noescape extern:"c" fun LLVMPassBuilderOptionsSetLoopVectorization(options: i64*,
    enabled: i32): void
noescape extern:"c" fun LLVMPassBuilderOptionsSetSLPVectorization(options: i64*, enabled: i32): void
noescape extern:"c" fun LLVMPassBuilderOptionsSetLoopUnrolling(options: i64*, enabled: i32): void

// bootstrapOptimizeWholeProgram's opt on the module the backend kept (bootstrapLlvmHoldModule),
// in this process: nothing renders its text for opt to parse again, which was a sixth of a
// mid-sized program's build. The same internalize (by hand: its public list is a process-wide
// option), nounwind, data layout, vectorizers and O2; then the same llc on its bitcode. The
// object differs from opt's only where the order of a value's uses steers code generation:
// json-readers' text by 7 of 143,405 bytes. The module is disposed either way.
trusted fun bootstrapOptimizeHeldWholeProgram(
    llvmTriple: string,
    optimizedPath: string,
    objectPath: string,
    abiManifest: string
): int {
    val nullPointer = nativeNullPointer()
    val module = bootstrapLlvmHeldModule
    var status = if (pointerIsNull(module)) 165 else 0
    if (status == 0 && llvmInitializeNativeTarget() != 0) status = 166
    val visible: Map<string, bool> = Map()
    for (symbol in bootstrapNativeAbiExportSymbols(abiManifest)) visible.set(symbol, true)
    visible.set("main", true)
    for (name in bootstrapFreestandingRoutineNames()) visible.set(name, true)
    val assembled: array<string> = []
    for (assembly in bootstrapLlvmInlineAssembly) {
        bootstrapLlvmAssemblyNamesIn(assembly, 0, assembly.size, assembled)
    }
    for (name in assembled) visible.set(name, true)
    if (status == 0) {
        val nounwind = LLVMCreateEnumAttribute(
            bootstrapLlvmHeldContext, bootstrapLlvmAttributeKind("nounwind"), 0
        )
        var function = LLVMGetFirstFunction(module)
        while (!pointerIsNull(function)) {
            // (-1: LLVMAttributeFunctionIndex.)
            if (!bootstrapLlvmDebugInfo) LLVMAddAttributeAtIndex(function, -1, nounwind)
            bootstrapInternalizeHeldValue(function, visible)
            function = LLVMGetNextFunction(function)
        }
        var global = LLVMGetFirstGlobal(module)
        while (!pointerIsNull(global)) {
            bootstrapInternalizeHeldValue(global, visible)
            global = LLVMGetNextGlobal(global)
        }
    }
    val triple = LLVMNormalizeTargetTriple(llvmTriple)
    val target = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    if (status == 0 && LLVMGetTargetFromTriple(triple, target.address, message.address) != 0) {
        status = 166
    }
    var machine = nullPointer
    var layout = nullPointer
    var options = nullPointer
    if (status == 0) {
        // opt's: no CPU, PIC, the default code generation level.
        machine = LLVMCreateTargetMachine(target.load(), triple, "", "", 2, 2, 0)
        if (pointerIsNull(machine)) status = 166
    }
    if (status == 0) {
        layout = LLVMCreateTargetDataLayout(machine)
        LLVMSetModuleDataLayout(module, layout)
        options = LLVMCreatePassBuilderOptions()
        LLVMPassBuilderOptionsSetLoopInterleaving(options, 1)
        LLVMPassBuilderOptionsSetLoopVectorization(options, 1)
        LLVMPassBuilderOptionsSetSLPVectorization(options, 1)
        LLVMPassBuilderOptionsSetLoopUnrolling(options, 1)
        bootstrapDiscardOptimizedLocalNames()
        status = llvmConsumeError(
            LLVMRunPasses(module, BOOTSTRAP_HOST_RELEASE_PASSES, machine, options), 167
        )
        // (A pipeline LLVM can't parse fails before any pass runs.)
        if (status != 0) {
            status = llvmConsumeError(
                LLVMRunPasses(module, "default<O2>,globaldce", machine, options), 167
            )
        }
    }
    val parts = if (status == 0 &&
        bootstrapCodegenModuleSize(module) >= BOOTSTRAP_RELEASE_PARTS_MINIMUM) {
        BOOTSTRAP_RELEASE_PARTS
    } else 1
    if (status == 0 && parts > 1) {
        status = bootstrapWriteReleaseParts(module, optimizedPath, parts)
    } else if (status == 0 && LLVMWriteBitcodeToFile(module, optimizedPath) != 0) status = 164
    if (!pointerIsNull(options)) LLVMDisposePassBuilderOptions(options)
    if (!pointerIsNull(layout)) LLVMDisposeTargetData(layout)
    if (!pointerIsNull(machine)) LLVMDisposeTargetMachine(machine)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    LLVMDisposeMessage(triple)
    target.close()
    message.close()
    bootstrapDisposeHeldModule()
    if (status == 0) {
        status = if (parts > 1) bootstrapEmitReleaseParts(optimizedPath, parts, objectPath)
            else bootstrapEmitWholeProgramObject(optimizedPath, objectPath)
    }
    status
}

// A large release module's code generation runs as several llc at once: the optimized
// module is cut into parts after O2 (as a development build's units are: every local name
// made a hidden global, unit 0 the data, the functions spread over the rest), so inlining
// and every module-wide decision is the module's. The count is fixed, not the machine's, so
// the same sources give the same executable anywhere; how many run at once is the
// machine's. json-megabyte's llc took 2.7 s whole and 1.6 s in two parts, 64 bytes larger.
val BOOTSTRAP_RELEASE_PARTS = 4

// Below this many instructions after O2 a module is generated whole: a part's clone, its
// bitcode and its llc's start cost more than its share of a small module's generation.
val BOOTSTRAP_RELEASE_PARTS_MINIMUM = 20000

noescape extern:"c" fun LLVMCloneModule(module: i64*): i64*

// Unit `index` of each function, 1 to `parts`: each to the part with the fewest
// instructions so far, in the module's order.
trusted fun bootstrapReleasePartPlan(module: i64*, parts: int): array<int> {
    val plan: array<int> = []
    val sizes: array<int> = []
    for (part in 0 until parts) sizes.append(0)
    var function = LLVMGetFirstFunction(module)
    while (!pointerIsNull(function)) {
        if (LLVMIsDeclaration(function) == i32(0)) {
            var lightest = 0
            for (part in 1 until parts) if (sizes[part] < sizes[lightest]) lightest = part
            sizes[lightest] = sizes[lightest] + bootstrapCodegenFunctionSize(function)
            plan.append(lightest + 1)
        }
        function = LLVMGetNextFunction(function)
    }
    plan
}

// Writes the parts of `module` as `<optimizedPath>.<unit>` (units 0 to `parts`).
trusted fun bootstrapWriteReleaseParts(module: i64*, optimizedPath: string, parts: int): int {
    bootstrapCodegenUnitPromote(module)
    val plan = bootstrapReleasePartPlan(module, parts)
    var status = 0
    var unit = 0
    while (status == 0 && unit <= parts) {
        val part = LLVMCloneModule(module)
        if (pointerIsNull(part) || !bootstrapCodegenUnitStrip(part, plan, unit)) status = 164
        else if (LLVMWriteBitcodeToFile(part, "$optimizedPath.$unit") != 0) status = 164
        if (!pointerIsNull(part)) LLVMDisposeModule(part)
        unit = unit + 1
    }
    status
}

// Runs llc on each part at once (at most a core each), then joins their objects into
// `objectPath` (`ld.lld -r`) for the link and the cache, which keep one object.
fun bootstrapEmitReleaseParts(optimizedPath: string, parts: int, objectPath: string,
    compilerParts: bool = false): int {
    var jobs = if (compilerParts) bootstrapNativeParallelism() else bootstrapCodegenJobs(parts + 1)
    if (compilerParts) {
        // Bound resident LLVM contexts even when ABLA_NATIVE_JOBS asks for
        // more. nproc honors the process's CPU affinity; macOS uses sysctl.
        val cores = bootstrapCodegenHostCores()
        if (jobs > cores) jobs = cores
        if (jobs > parts) jobs = parts
        if (jobs < 1) jobs = 1
    }
    var status = 0
    val running: array<int> = []
    var next = 0
    var active = 0
    while (next <= parts || active > 0) {
        while (status == 0 && next <= parts && active < jobs) {
            val process = if (compilerParts)
                bootstrapStartCompilerPart(optimizedPath, "$objectPath.$next", next)
                else bootstrapStartPartObject("$optimizedPath.$next", "$objectPath.$next")
            if (process <= 0) status = 127
            else {
                running.append(process)
                active = active + 1
            }
            next = next + 1
        }
        if (status != 0) next = parts + 1
        var progressed = false
        var slot = 0
        while (slot < running.size) {
            if (running[slot] > 0) {
                val observed = linuxWaitProcess(running[slot], true)
                if (observed.output != "pending") {
                    progressed = true
                    if (observed.status != 0 && status == 0) status = observed.status
                    running[slot] = 0
                    active = active - 1
                }
            }
            slot = slot + 1
        }
        if (active > 0 && !progressed) linuxSleepMillisecondsChecked(1)
    }
    if (status == 0) {
        val join = linuxCommand("ld.lld")
        join.argument("-r")
        if (compilerParts) join.argument("--threads=1")
        join.argument("-o")
        join.argument(objectPath)
        for (unit in 0 .. parts) join.argument("$objectPath.$unit")
        status = join.run()
    }
    for (unit in 0 .. parts) {
        Path("$optimizedPath.$unit").remove()
        Path("$objectPath.$unit").remove()
    }
    if (compilerParts) {
        Path(optimizedPath).remove()
        Path("$optimizedPath.plan").remove()
    }
    status
}

noescape extern:"c" fun LLVMParseBitcodeInContext2(context: i64*, buffer: i64*, module: i64*): i32

// External O1 still prepares the compiler in a fresh process. Read its bitcode
// once to balance functions by instruction count. The shared bitcode stays
// unchanged: each worker promotes the same local names before stripping, so
// planning needs neither serial clones nor another whole-module bitcode write.
trusted fun bootstrapPrepareCompilerParts(inputPath: string, parts: int): int {
    if (parts <= 0 || parts > 256) return 2
    val buffer = nativePointerCell(nativeNullPointer())
    val message = nativePointerCell(nativeNullPointer())
    val module = nativePointerCell(nativeNullPointer())
    val context = LLVMContextCreate()
    LLVMContextSetDiscardValueNames(context, 1)
    var status = 0
    if (LLVMCreateMemoryBufferWithContentsOfFile(inputPath, buffer.address,
        message.address) != 0) status = 145
    if (status == 0 && LLVMParseBitcodeInContext2(context, buffer.load(),
        module.address) != 0) status = 145
    if (status == 0) {
        val plan = byteBuffer()
        for (unit in bootstrapReleasePartPlan(module.load(), parts)) {
            plan.appendInt(unit)
            plan.appendText("\n")
        }
        if (!Path("$inputPath.plan").writeText(plan.toText())) status = 164
    }
    if (!pointerIsNull(module.load())) LLVMDisposeModule(module.load())
    if (!pointerIsNull(buffer.load())) LLVMDisposeMemoryBuffer(buffer.load())
    LLVMContextDispose(context)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    buffer.close()
    message.close()
    module.close()
    bootstrapCollectAndRelease()
    status
}

// The shared bitcode is lazy: declaring other units' functions does not
// materialize their bodies. Link the kept unit into a fresh module, write its
// small bitcode, then use the existing O2 plus native codegen entry point.
trusted fun bootstrapEmitCompilerPart(
    inputPath: string, outputPath: string, planPath: string, index: int
): int {
    val buffer = nativePointerCell(nativeNullPointer())
    val message = nativePointerCell(nativeNullPointer())
    val lazy = nativePointerCell(nativeNullPointer())
    val context = LLVMContextCreate()
    LLVMContextSetDiscardValueNames(context, 1)
    var status = if (index < 0) 2 else 0
    if (status == 0 && LLVMCreateMemoryBufferWithContentsOfFile(inputPath, buffer.address,
        message.address) != 0) status = 145
    if (status == 0 && LLVMGetBitcodeModuleInContext2(context, buffer.load(), lazy.address) != 0) {
        LLVMDisposeMemoryBuffer(buffer.load())
        status = 145
    }
    var module = nativeNullPointer()
    if (status == 0) bootstrapCodegenUnitPromote(lazy.load(), false)
    if (status == 0 && !bootstrapCodegenUnitStrip(lazy.load(),
        bootstrapReadCodegenUnitPlan(planPath), index)) {
        LLVMDisposeModule(lazy.load())
        status = 2
    }
    if (status == 0) {
        module = LLVMModuleCreateWithNameInContext("unit", context)
        if (LLVMLinkModules2(module, lazy.load()) != 0) status = 145
    }
    val partPath = "$outputPath.bc"
    if (status == 0 && LLVMWriteBitcodeToFile(module, partPath) != 0) status = 164
    if (!pointerIsNull(module)) LLVMDisposeModule(module)
    LLVMContextDispose(context)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    buffer.close()
    message.close()
    lazy.close()
    bootstrapCollectAndRelease()
    if (status == 0) status = llvmAotEmitObjectFile(partPath, outputPath)
    Path(partPath).remove()
    status
}

// The LLVM-linked compiler's existing O2 plus codegen child.
fun bootstrapStartCompilerPart(inputPath: string, outputPath: string, index: int): int {
    val child = linuxCommand("/proc/self/exe")
    child.argument("--aot-object")
    child.argument(inputPath)
    child.argument(outputPath)
    child.argument("$inputPath.plan")
    child.argument("$index")
    child.start().process
}

// Starts bootstrapEmitWholeProgramObject's llc on one part: its process, or 0.
fun bootstrapStartPartObject(partPath: string, objectPath: string): int {
    val emitObject = bootstrapWholeProgramObjectCommand(partPath, objectPath)
    emitObject.start().process
}

// What the internalize pass does to a definition outside the public list: an external one
// becomes internal (and loses its visibility). Local, appending (`llvm.*` arrays) and
// available-externally ones stay.
fun bootstrapInternalizeHeldValue(value: i64*, visible: Map<string, bool>): void {
    val linkage = LLVMGetLinkage(value)
    if (LLVMIsDeclaration(value) == 0 && linkage != llvmInternalLinkage() &&
        linkage != llvmPrivateLinkage() && linkage != llvmAppendingLinkage() && linkage != 1 &&
        visible.get(bootstrapLlvmDebugValueName(value)) == null) {
        LLVMSetLinkage(value, llvmInternalLinkage())
        LLVMSetVisibility(value, 0)
    }
    return
}

// Whether the held module can be optimized in process: one with `llvm.used` or
// `llvm.compiler.used` (none is emitted now) goes through opt, which keeps what they name.
fun bootstrapHeldModuleInternalizable(): bool =
    pointerIsNull(LLVMGetNamedGlobal(bootstrapLlvmHeldModule, "llvm.used")) &&
    pointerIsNull(LLVMGetNamedGlobal(bootstrapLlvmHeldModule, "llvm.compiler.used")) &&
    pointerIsNull(LLVMGetFirstGlobalAlias(bootstrapLlvmHeldModule))

// The held module's text, for a build that goes through the tools after all.
trusted fun bootstrapRenderHeldModule(): string {
    var result = ""
    val printed = LLVMPrintModuleToString(bootstrapLlvmHeldModule)
    if (!pointerIsNull(printed)) {
        result = nativeCString(printed)
        LLVMDisposeMessage(printed)
    }
    result
}

// Appends the generated names in the module's inline assembly, which opt doesn't read.
fun bootstrapLlvmAssemblyNames(llvm: string, var names: array<string>): void {
    var found = llvm.indexOf(" asm \"", 0)
    while (found >= 0) {
        val lineEnd = llvm.indexOf("\n", found)
        val end = if (lineEnd < 0) llvm.size else lineEnd
        bootstrapLlvmAssemblyNamesIn(llvm, found, end, names)
        found = llvm.indexOf(" asm \"", end)
    }
    return
}

// Appends the generated names (`abla_...`) in `text` from `begin` to `end`.
fun bootstrapLlvmAssemblyNamesIn(text: string, begin: int, end: int,
    var names: array<string>): void {
    var offset = begin
    while (offset < end) {
        if (text[offset] == 97 && offset + 5 <= end && text.slice(offset, offset + 5) == "abla_" &&
            (offset == 0 || !bootstrapLlvmNameByte(text[offset - 1]))) {
            var last = offset
            while (last < end && bootstrapLlvmNameByte(text[last])) last = last + 1
            names.append(text.slice(offset, last))
            offset = last
        } else offset = offset + 1
    }
    return
}

// The LTO input: the module after the O1 cleanup, its user-function wrappers internal.
// Hosted LTO first specializes the universal ABI wrappers while they are
// visible, then makes them private before whole-program dead-code elimination.
// Doing both at initial IR emission changes LLVM's inlining order and can leave
// boxed runtime work on hot indirect-call paths. Bitcode throughout: printing,
// reading back and parsing well over 100 MB of text cost seconds.
fun bootstrapPrepareLtoLlvm(
    llvmPath: string,
    preparedPath: string
): int {
    val visiblePath = "$preparedPath.visible.bc"
    var status = bootstrapPrepareParallelLlvm(llvmPath, visiblePath, false)
    if (status == 0) {
        status = bootstrapInternalizeLlvmUserFunctionWrapperBitcode(visiblePath, preparedPath)
    }
    Path(visiblePath).remove()
    status
}

// A user function's wrapper becomes internal once whole-module optimization has seen it: every
// `abla_fn_` function the backend defined hidden, with external linkage, the C calling
// convention and a void result and no result attributes, except its direct body
// (`<name>_direct`), which stays visible. (In text, each `define hidden void @abla_fn_...`
// that is no `_direct` becomes `define internal void @abla_fn_...`.) Local value names are
// dropped on the way: nothing after this reads them.
trusted fun bootstrapInternalizeLlvmUserFunctionWrapperBitcode(
    inputPath: string,
    outputPath: string
): int {
    val nullPointer = nativeNullPointer()
    val buffer = nativePointerCell(nullPointer)
    val message = nativePointerCell(nullPointer)
    val module = nativePointerCell(nullPointer)
    val context = LLVMContextCreate()
    LLVMContextSetDiscardValueNames(context, i32(1))
    var status = 0
    if (LLVMCreateMemoryBufferWithContentsOfFile(
        inputPath, buffer.address, message.address
    ) != 0) status = 145
    // (The module takes the buffer.)
    if (status == 0 && LLVMParseIRInContext(
        context, buffer.load(), module.address, message.address
    ) != 0) status = 145
    if (status == 0) {
        var function = LLVMGetFirstFunction(module.load())
        while (!pointerIsNull(function)) {
            val name = bootstrapLlvmDebugValueName(function)
            if (name.size > 8 && name.slice(0, 8) == "abla_fn_" &&
                !(name.size >= 15 && name.slice(name.size - 7, name.size) == "_direct") &&
                LLVMIsDeclaration(function) == i32(0) &&
                LLVMGetLinkage(function) == i32(0) &&
                LLVMGetVisibility(function) == i32(llvmHiddenVisibility()) &&
                LLVMGetDLLStorageClass(function) == i32(0) &&
                LLVMGetFunctionCallConv(function) == i32(0) &&
                LLVMGetAttributeCountAtIndex(function, i32(0)) == i32(0) &&
                LLVMGetTypeKind(LLVMGetReturnType(LLVMGlobalGetValueType(function))) == i32(0)) {
                LLVMSetLinkage(function, i32(llvmInternalLinkage()))
            }
            function = LLVMGetNextFunction(function)
        }
        if (LLVMWriteBitcodeToFile(module.load(), outputPath) != 0) status = 145
    }
    if (!pointerIsNull(module.load())) LLVMDisposeModule(module.load())
    LLVMContextDispose(context)
    if (!pointerIsNull(message.load())) LLVMDisposeMessage(message.load())
    buffer.close()
    message.close()
    module.close()
    status
}

// Balanced function parts of a large release module. What is inlined and placed across a cut
// changes the code, so this count is part of what the build produces and must not follow the
// machine: bootstrapNativeParallelism only says how many parts are generated at once. Checked
// by tools/test-reproducible-elsewhere.sh.
val BOOTSTRAP_NATIVE_PARTS = 20

// Writes `outputPath`; its parts are named after `objectPath`.
fun bootstrapEmitParallelObject(
    llvmPath: string,
    objectPath: string,
    outputPath: string
): int {
    val preparedPath = "$objectPath.prepartition.bc"
    var status = bootstrapPrepareSplitLlvm(llvmPath, preparedPath)
    if (status == 0) {
        val plan = linuxCommand("/proc/self/exe")
        plan.argument("--aot-plan")
        plan.argument(preparedPath)
        plan.argument("$BOOTSTRAP_NATIVE_PARTS")
        status = plan.run()
    }
    if (status == 0) status = bootstrapEmitReleaseParts(
        preparedPath, BOOTSTRAP_NATIVE_PARTS, outputPath, true
    )
    Path(preparedPath).remove()
    Path("$preparedPath.plan").remove()
    status
}

fun bootstrapReplaceAll(
    source: string,
    expected: string,
    replacement: string
): string {
    var output = ""
    var segment = 0
    var index = 0
    while (index + expected.size <= source.size) {
        if (source.slice(index, index + expected.size) == expected) {
            output = "$output${source.slice(segment, index)}$replacement"
            index = index + expected.size
            segment = index
        } else index = index + 1
    }
    "$output${source.slice(segment, source.size)}"
}

fun bootstrapLlvmUserFunctionSymbols(llvm: string): array<string> {
    val symbols: array<string> = []
    val prefix = "define hidden void @abla_fn_"
    var offset = 0
    while (offset + prefix.size < llvm.size) {
        if (llvm.slice(offset, offset + prefix.size) == prefix) {
            val begin = offset + 20
            var end = begin
            while (end < llvm.size && llvm[end] != 40 && llvm[end] != 32 &&
                   llvm[end] != 10 && llvm[end] != 13) end = end + 1
            if (end > begin) symbols.append(llvm.slice(begin, end))
            offset = end
        } else offset = offset + 1
    }
    symbols
}

// ELF linkers can discard unused functions only when code generation places
// them in independent sections. Keep this transformation target-aware and
// bounded: thousands of sections materially increase LLVM's peak memory, and
// large release modules already use the partitioned/global-DCE path. Mach-O
// explicit sections require a segment/section pair and Wasm has a different
// section model, so the platform-neutral backend must not bake in ELF names.
fun bootstrapAddLlvmElfFunctionSections(llvm: string): string {
    val prefix = "define hidden void @abla_fn_"
    val insertionOffsets: array<int> = []
    val insertionNames: array<string> = []
    var extraBytes = 0
    var offset = 0
    while (offset + prefix.size < llvm.size) {
        if (llvm.slice(offset, offset + prefix.size) == prefix) {
            val nameBegin = offset + 20
            var nameEnd = nameBegin
            while (nameEnd < llvm.size && llvm[nameEnd] != 40 &&
                   llvm[nameEnd] != 32 && llvm[nameEnd] != 10 &&
                   llvm[nameEnd] != 13) nameEnd = nameEnd + 1
            var body = nameEnd
            while (body < llvm.size && llvm[body] != 123 &&
                   llvm[body] != 10 && llvm[body] != 13) body = body + 1
            if (nameEnd > nameBegin && body < llvm.size &&
                llvm[body] == 123) {
                val name = llvm.slice(nameBegin, nameEnd)
                // The section goes before metadata attachments (a debug
                // build's `!dbg !N`), which must come last.
                var sectionAt = body
                var attachment = nameEnd
                while (attachment + 5 < body) {
                    if (llvm.slice(attachment, attachment + 5) == " !dbg") {
                        sectionAt = attachment + 1
                    }
                    attachment = attachment + 1
                }
                insertionOffsets.append(sectionAt)
                insertionNames.append(name)
                extraBytes = extraBytes + 17 + name.size
            }
            offset = if (body > offset) body else nameEnd
        } else offset = offset + 1
    }
    val output = nativeByteBuffer(llvm.size + extraBytes + 1)
    var valid = !pointerIsNull(output.address)
    var source = 0
    var destination = 0
    var insertion = 0
    while (valid && source < llvm.size) {
        if (insertion < insertionOffsets.size &&
            source == insertionOffsets[insertion]) {
            val section =
                "section \".text.${insertionNames[insertion]}\" "
            var byte = 0
            while (valid && byte < section.size) {
                valid = output.store(destination, section[byte])
                destination = destination + 1
                byte = byte + 1
            }
            insertion = insertion + 1
        }
        if (valid) valid = output.store(destination, llvm[source])
        destination = destination + 1
        source = source + 1
    }
    var result = ""
    if (valid) result = output.adoptString(destination)
    else output.close()
    result
}

fun bootstrapExtractLlvmFunctions(
    inputPath: string,
    outputPath: string,
    symbols: array<string>,
    deleting: bool
): int {
    val extract = linuxCommand("llvm-extract")
    var symbol = 0
    while (symbol < symbols.size) {
        if (deleting) extract.argument("--delete")
        extract.argument("--func=${symbols[symbol]}")
        symbol = symbol + 1
    }
    extract.argument(inputPath)
    extract.argument("-S")
    extract.argument("-o")
    extract.argument(outputPath)
    extract.run()
}

// A module's text without the generated functions nothing reaches: `abla_fn_` functions that
// aren't referred to from `main`, another function kept, a global or inline assembly. Mostly
// boxed-ABI wrappers whose callers use the direct bodies: they are hidden, so opt can't drop
// them. Half of the compiler's functions, and it comes out 8% smaller. Only for a program
// linking LLVM: in another program, what LLVM inlines changes, and json-readers' readInteger
// ran 54% slower (2026-11-01). A reference this misses is a parse error in opt.
fun bootstrapLlvmWithoutDeadFunctions(llvm: string): string {
    val marker = "\ndefine "
    val names: array<string> = []
    val begins: array<int> = []
    val ends: array<int> = []
    val slots: Map<string, int> = Map()
    val outside = byteBuffer()
    var cursor = 0
    var found = llvm.indexOf(marker, 0)
    while (found >= 0) {
        val begin = found + 1
        val lineEnd = llvm.indexOf("\n", begin)
        val close = llvm.indexOf("\n}\n", begin)
        if (lineEnd < 0 || close < 0) return llvm
        val end = close + 3
        val at = llvm.indexOf("@", begin)
        if (at < 0 || at > lineEnd) return llvm
        var nameEnd = at + 1
        while (nameEnd < lineEnd && llvm[nameEnd] != 40) nameEnd = nameEnd + 1
        val name = llvm.slice(at + 1, nameEnd)
        slots.set(name, names.size)
        names.append(name)
        begins.append(begin)
        ends.append(end)
        outside.appendText(llvm.slice(cursor, begin))
        cursor = end
        found = llvm.indexOf(marker, end - 1)
    }
    outside.appendText(llvm.slice(cursor, llvm.size))
    val kept: array<bool> = []
    val pending: array<int> = []
    var index = 0
    while (index < names.size) {
        val line = llvm.slice(begins[index], begins[index] + 40)
        val generated = names[index].startsWith("abla_fn_") &&
            (line.startsWith("define hidden ") || line.startsWith("define internal ") ||
             line.startsWith("define private "))
        val other = !generated && !line.startsWith("define internal ") &&
            !line.startsWith("define private ")
        kept.append(other)
        if (other) pending.append(index)
        index = index + 1
    }
    bootstrapLlvmMarkReferences(outside.toText(), slots, kept, pending)
    var head = 0
    while (head < pending.size) {
        val function = pending[head]
        head = head + 1
        // (Past its own signature's name is the same walk: a self-reference changes nothing.)
        bootstrapLlvmMarkReferences(llvm.slice(begins[function], ends[function]), slots, kept,
            pending)
    }
    val output = byteBuffer()
    cursor = 0
    index = 0
    while (index < names.size) {
        output.appendText(llvm.slice(cursor, begins[index]))
        if (kept[index]) output.appendText(llvm.slice(begins[index], ends[index]))
        cursor = ends[index]
        index = index + 1
    }
    output.appendText(llvm.slice(cursor, llvm.size))
    output.toText()
}

// Marks what `text` refers to: `@name`, and any generated name, as inline assembly writes it.
fun bootstrapLlvmMarkReferences(
    text: string,
    slots: Map<string, int>,
    var kept: array<bool>,
    var pending: array<int>
): void {
    var offset = 0
    while (offset < text.size) {
        val byte = text[offset]
        val generated = byte == 97 && offset + 8 <= text.size &&
            text[offset + 5] == 102 && text.slice(offset, offset + 8) == "abla_fn_"
        if (byte == 64 || generated) {
            val first = if (byte == 64) offset + 1 else offset
            var last = first
            if (last < text.size && text[last] == 34) {
                // A quoted name, quotes and all, as a definition's is kept.
                last = last + 1
                while (last < text.size && text[last] != 34) last = last + 1
                if (last < text.size) last = last + 1
            } else {
                while (last < text.size && bootstrapLlvmNameByte(text[last])) last = last + 1
            }
            val slot = slots.get(text.slice(first, last))
            if (slot != null && !kept[slot]) {
                kept[slot] = true
                pending.append(slot)
            }
            offset = if (last > offset) last else offset + 1
        } else offset = offset + 1
    }
    return
}

// A byte of an unquoted LLVM name.
fun bootstrapLlvmNameByte(byte: int): bool =
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
    byte == 95 || byte == 46 || byte == 36 || byte == 45

// Writes `outputPath`; its partitions are named after `objectPath` (their text,
// which names its file, keys the partition cache).
fun bootstrapEmitPartitionedObject(
    llvmPath: string,
    objectPath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string,
    cacheNamespace: string,
    allowPartitionCache: bool
): BootstrapPartitionEmission {
    val preparedPath = "$objectPath.prepartition.ll"
    var status = bootstrapPreparePartitionLlvm(llvmPath, preparedPath)
    val llvm = if (status == 0) Path(preparedPath).readText() else ""
    val symbols = bootstrapLlvmUserFunctionSymbols(llvm)
    var reused = 0
    var refreshed = 0
    if (status == 0 && symbols.size <= 1) {
        status = emitObject(preparedPath, outputPath)
    }
    if (symbols.size > 1) {
        var bucketCount = (symbols.size + 31) / 32
        if (bucketCount < 1) bucketCount = 1
        if (bucketCount > 32) bucketCount = 32
        val buckets: array<array<string>> = []
        var bucket = 0
        while (bucket < bucketCount) {
            val values: array<string> = []
            buckets.append(values)
            bucket = bucket + 1
        }
        var symbol = 0
        while (symbol < symbols.size) {
            var hash = bootstrapNativeCacheHash(
                symbols[symbol], 227, 307, 1000000007
            )
            if (hash < 0) hash = 0 - hash
            val destination = hash - (hash / bucketCount) * bucketCount
            buckets[destination].append(symbols[symbol])
            symbol = symbol + 1
        }

        val rootLlvm = "$objectPath.root.ll"
        val rootObject = "$objectPath.root.o"
        status = bootstrapExtractLlvmFunctions(
            preparedPath,
            rootLlvm,
            symbols,
            true
        )
        if (status == 0) {
            val rootSource = Path(rootLlvm).readText()
            if (!Path(rootLlvm).writeTextAtomic(bootstrapReplaceAll(
                rootSource,
                "define internal",
                "define hidden"
            ))) status = 145
        }
        if (status == 0) status = emitObject(rootLlvm, rootObject)

        val partBuckets: array<int> = []
        bucket = 0
        while (status == 0 && bucket < buckets.size) {
            if (buckets[bucket].size > 0) {
                val partLlvm = "$objectPath.part.$bucket.ll"
                val partObject = "$objectPath.part.$bucket.o"
                // Retain only the integer needed to reconstruct the object
                // path during the final link. LLVM text, cache identities,
                // path ropes, and command values are temporary to this
                // partition and can otherwise accumulate across every bucket
                // in a large native build.
                partBuckets.append(bucket)
                val partitionCheckpoint = runtimeMemoryCheckpoint()
                status = bootstrapExtractLlvmFunctions(
                    preparedPath,
                    partLlvm,
                    buckets[bucket],
                    false
                )
                var identity = ""
                if (status == 0) {
                    identity = "partition-v5:$cacheProfile:${Path(
                        partLlvm
                    ).readText()}"
                }
                val first = bootstrapNativeCacheHash(
                    identity, 229, 311, 1000000007
                )
                val second = bootstrapNativeCacheHash(
                    identity, 233, 313, 1000000009
                )
                val cachedObject =
                    "$cacheNamespace-${identity.size}-$first-$second.o"
                val cachedInfo = Path(cachedObject).info()
                var hit = allowPartitionCache && cachedInfo.isFile() &&
                    cachedInfo.size > 0
                if (hit) {
                    status = bootstrapCopyNativeObject(
                        cachedObject,
                        partObject
                    )
                    if (status == 0) reused = reused + 1
                }
                if (!hit) {
                    if (status == 0) status = emitObject(
                        partLlvm,
                        partObject
                    )
                    if (status == 0) refreshed = refreshed + 1
                    if (status == 0 && allowPartitionCache) {
                        val temporary =
                            "$cachedObject.tmp.${linuxProcessId()}"
                        val copyStatus = bootstrapCopyNativeObject(
                            partObject,
                            temporary
                        )
                        if (copyStatus == 0) {
                            Path(temporary).moveTo(Path(cachedObject))
                        }
                        if (copyStatus != 0) Path(temporary).remove()
                    }
                }
                runtimeMemoryReset(partitionCheckpoint)
            }
            bucket = bucket + 1
        }

        if (status == 0) {
            val combine = linuxCommand("ld.lld")
            combine.argument("--threads=1")
            combine.argument("-r")
            combine.argument(rootObject)
            var part = 0
            while (part < partBuckets.size) {
                combine.argument(
                    "$objectPath.part.${partBuckets[part]}.o"
                )
                part = part + 1
            }
            combine.argument("-o")
            combine.argument(outputPath)
            status = combine.run()
        }
    }
    Path(preparedPath).remove()
    BootstrapPartitionEmission(status, reused, refreshed)
}

fun bootstrapGraphCompileCapabilitiesCacheable(
    graph: BootstrapModuleGraph
): bool {
    var cacheable = true
    var module = 0
    while (module < graph.orderedSnapshots.size) {
        val actions = graph.orderedSnapshots[module].discovery.actions
        var action = 0
        while (action < actions.size) {
            val staged = actions[action]
            var grant = false
            var authorization = staged.kind ==
                "compile.capability.authorization"
            // Literal subparser registrations and generated modules are
            // applied from source, which the cache identity covers; they
            // never run as actions.
            var literal = false
            if (staged.kind == "compile" && staged.children.size == 1) {
                val executable = staged.children[0]
                grant = executable.kind == "call" &&
                    executable.text == "compilerGrant"
                literal = executable.kind == "call" &&
                    (executable.text == "compilerRegisterSubparser" ||
                     executable.text == "compilerGenerateModule")
                authorization = executable.kind ==
                    "compile.capability.authorization"
            } else if (staged.kind == "call") {
                grant = staged.text == "compilerGrant"
                literal = staged.text == "compilerRegisterSubparser" ||
                    staged.text == "compilerGenerateModule"
            }
            // Executable top-level actions may stage build graph state. They
            // must run on every root invocation instead of disappearing
            // behind a whole-program native-object cache hit.
            if (!grant && !authorization && !literal) cacheable = false
            if (bootstrapExpressionContainsCall(
                staged,
                "compilerBuildProgram"
            )) cacheable = false
            if (staged.kind == "compile" && staged.children.size == 1) {
                val expression = staged.children[0]
                if (expression.kind == "call" &&
                    expression.text == "compilerGrant") {
                    if (expression.children.size == 1 &&
                        expression.children[0].kind == "string") {
                        // (A change of the standard library is part of the
                        // source the cache identity covers.)
                        if (expression.children[0].text != "filesystem.read" &&
                            expression.children[0].text != "environment" &&
                            expression.children[0].text != "transform.library") {
                            cacheable = false
                        }
                    } else {
                        cacheable = false
                    }
                }
            }
            action = action + 1
        }
        module = module + 1
    }
    if (cacheable && bootstrapGraphCompileCodeReaches(
        graph, "compilerBuildProgram", "compilerCreateXcframework"
    )) {
        cacheable = false
    }
    cacheable
}

fun bootstrapNativeAbiManifest(
    target: BootstrapTargetDescriptor,
    artifact: string,
    exports: string
): string {
    val hosted = if (target.hosted) "true" else "false"
    val libcFree = if (target.libcFree) "true" else "false"
    val panicContainment = if (target.hosted &&
        target.llvmTriple == "x86_64-unknown-linux-gnu") "sjlj" else "none"
    "{\n  \"schema\":\"abla.abi.v1\",\n  \"target\":{\"name\":\"${target.name}\",\"llvmTriple\":\"${target.llvmTriple}\",\"objectFormat\":\"${target.objectFormat}\",\"hosted\":$hosted,\"libcFree\":$libcFree,\"panicContainment\":\"$panicContainment\"},\n  \"artifact\":\"$artifact\",\n  \"exports\":$exports\n}\n"
}

fun bootstrapNativeAbiExportSymbols(abi: string): array<string> {
    val symbols: array<string> = []
    val marker = "\"symbol\":\""
    var begin = 0
    while (begin + marker.size <= abi.size) {
        var matches = true
        var markerIndex = 0
        while (matches && markerIndex < marker.size) {
            if (abi[begin + markerIndex] != marker[markerIndex]) {
                matches = false
            }
            markerIndex = markerIndex + 1
        }
        if (matches) {
            val symbolBegin = begin + marker.size
            var symbolEnd = symbolBegin
            while (symbolEnd < abi.size && abi[symbolEnd] != 34) {
                symbolEnd = symbolEnd + 1
            }
            if (symbolEnd < abi.size) {
                val symbol = abi.slice(symbolBegin, symbolEnd)
                var exists = false
                var existing = 0
                while (!exists && existing < symbols.size) {
                    exists = symbols[existing] == symbol
                    existing = existing + 1
                }
                if (bootstrapExportNameValid(symbol) && !exists) {
                    symbols.append(symbol)
                }
                begin = symbolEnd
            }
        }
        begin = begin + 1
    }
    if (bootstrapTextContains(abi, "\"owned-bytes-handle\"")) {
        symbols.append("abla_owned_bytes_data")
        symbols.append("abla_owned_bytes_length")
        symbols.append("abla_owned_bytes_release")
    }
    symbols
}

fun bootstrapExpressionContainsCall(
    expression: BootstrapExpression,
    name: string
): bool {
    var found = expression.kind == "call" && expression.text == name
    var child = 0
    while (!found && child < expression.children.size) {
        found = bootstrapExpressionContainsCall(
            expression.children[child],
            name
        )
        child = child + 1
    }
    found
}

// Whether code that runs during compilation can call `name`: what the graph's
// top-level actions and its `#` expressions (in any declaration) reach, through
// every declaration they name, by name alone (a method or an overload of that name
// counts; so does a string literal, which may name a finalizer). A declaration that
// merely exists (a library's wrapper no compile code calls) does not count.
fun bootstrapGraphCompileCodeReaches(
    graph: BootstrapModuleGraph,
    name: string,
    alternative: string = ""
): bool {
    val declarations: array<BootstrapDeclaration> = []
    for (snapshot in graph.orderedSnapshots) {
        for (declaration in snapshot.discovery.declarations) {
            declarations.append(declaration)
            for (method in declaration.methods) declarations.append(method)
        }
    }
    val table = bootstrapIrNameTable(declarations.size)
    val next: array<int> = []
    var index = 0
    while (index < declarations.size) {
        next.append(table.find(declarations[index].name, -1))
        table.put(declarations[index].name, index)
        index = index + 1
    }
    val visited = filledArray(declarations.size, false)
    val pending: array<BootstrapExpression> = []
    for (snapshot in graph.orderedSnapshots) {
        for (action in snapshot.discovery.actions) pending.append(action)
    }
    // Every `#` expression is a root; so is everything a root names.
    for (declaration in declarations) bootstrapCollectCompileNodes(declaration, pending)
    var found = false
    while (!found && pending.size > 0) {
        val node = pending[pending.size - 1]
        pending.truncate(pending.size - 1)
        if (node.text == name ||
            (alternative != "" && node.text == alternative)) found = true
        for (child in node.children) pending.append(child)
        if (node.text != "" && node.kind != "integer") {
            var item = table.find(node.text, -1)
            while (item >= 0) {
                if (!visited[item]) {
                    visited[item] = true
                    pending.append(declarations[item].expression)
                    for (fallback in declarations[item].parameterDefaults) pending.append(fallback)
                }
                item = next[item]
            }
        }
    }
    found
}

fun bootstrapCollectCompileNodes(
    declaration: BootstrapDeclaration,
    var into: array<BootstrapExpression>
): void {
    bootstrapCollectCompileExpressions(declaration.expression, into)
    for (fallback in declaration.parameterDefaults) bootstrapCollectCompileExpressions(fallback,
        into)
    return
}

fun bootstrapCollectCompileExpressions(
    expression: BootstrapExpression,
    var into: array<BootstrapExpression>
): void {
    if (expression.kind == "compile") into.append(expression)
    else for (child in expression.children) bootstrapCollectCompileExpressions(child, into)
    return
}

fun bootstrapDeclarationContainsCall(
    declaration: BootstrapDeclaration,
    name: string
): bool {
    var found = bootstrapExpressionContainsCall(declaration.expression, name)
    var defaultIndex = 0
    while (!found && defaultIndex < declaration.parameterDefaults.size) {
        found = bootstrapExpressionContainsCall(
            declaration.parameterDefaults[defaultIndex],
            name
        )
        defaultIndex = defaultIndex + 1
    }
    var method = 0
    while (!found && method < declaration.methods.size) {
        found = bootstrapDeclarationContainsCall(
            declaration.methods[method],
            name
        )
        method = method + 1
    }
    found
}

fun bootstrapParseCacheInteger(text: string, var cursor: array<int>): int {
    var value = 0
    var valid = cursor[0] < text.size
    while (cursor[0] < text.size && text[cursor[0]] != 10) {
        val byte = text[cursor[0]]
        if (byte < 48 || byte > 57) valid = false
        if (valid) value = value * 10 + byte - 48
        cursor[0] = cursor[0] + 1
    }
    if (cursor[0] >= text.size) valid = false
    if (cursor[0] < text.size) cursor[0] = cursor[0] + 1
    if (valid) value else -1
}

fun bootstrapSerializeCompileInputs(
    paths: array<string>,
    inputs: array<string>
): string {
    var output = "abla-inputs-v1\n${paths.size}\n"
    var index = 0
    while (index < paths.size) {
        val path = paths[index]
        val contents = inputs[index]
        val first = bootstrapNativeCacheHash(
            contents, 53, 277, 1000000007
        )
        val second = bootstrapNativeCacheHash(
            contents, 107, 281, 1000000009
        )
        output = "${output}${path.size}\n$path${contents.size}\n$first\n$second\n"
        index = index + 1
    }
    output
}

fun bootstrapValidateCompileInputs(serialized: string): bool {
    val prefix = "abla-inputs-v1\n"
    var valid = serialized.size <= 1048576 &&
        serialized.size >= prefix.size &&
        serialized.slice(0, prefix.size) == prefix
    val cursor: array<int> = [prefix.size]
    var count = -1
    if (valid) count = bootstrapParseCacheInteger(serialized, cursor)
    if (count < 0 || count > 256) valid = false
    var index = 0
    while (valid && index < count) {
        val pathSize = bootstrapParseCacheInteger(serialized, cursor)
        if (pathSize < 0 || cursor[0] + pathSize > serialized.size) {
            valid = false
        }
        var path = ""
        if (valid) {
            path = serialized.slice(cursor[0], cursor[0] + pathSize)
            cursor[0] = cursor[0] + pathSize
        }
        val expectedSize = if (valid) {
            bootstrapParseCacheInteger(serialized, cursor)
        } else -1
        val expectedFirst = if (valid) {
            bootstrapParseCacheInteger(serialized, cursor)
        } else -1
        val expectedSecond = if (valid) {
            bootstrapParseCacheInteger(serialized, cursor)
        } else -1
        if (valid) {
            val contents = bootstrapCompileInputContents(path)
            valid = contents.size == expectedSize &&
                bootstrapNativeCacheHash(
                    contents, 53, 277, 1000000007
                ) == expectedFirst &&
                bootstrapNativeCacheHash(
                    contents, 107, 281, 1000000009
                ) == expectedSecond
        }
        index = index + 1
    }
    valid && cursor[0] == serialized.size
}

fun bootstrapNativeBuildWithEmitterStateCache(
    sourcePath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string,
    var moduleState: BootstrapModuleState,
    var irCache: BootstrapIrCacheState,
    allowCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string,
    targetToolsIdentity: string = ""
): BootstrapNativeBuild {
    val enclosingFloatFormatting = bootstrapFloatFormattingRequested
    val enclosingFloatProbe = bootstrapFloatBridgeProbe
    val enclosingFloatAvailable = bootstrapFloatBridgeAvailable
    // A libc-free target is not necessarily the built-in raw Linux process.
    // An entry symbol identifies the latter; external module formats provide
    // their own loader/runtime contract and must not receive the Linux startup.
    val rawTarget = target.libcFree && target.entrySymbol.size > 0
    val macTarget = target.objectFormat == "macho"
    val appleStatic = macTarget && target.linkerFlavor == "apple-static"
    val needsDarwinAdapter = macTarget && !target.libcFree &&
        (target.hosted || artifact != "object")
    val appleSdk = if (target.sdk != "") target.sdk else "macosx"
    val configuredMacClang = linuxEnvironment("ABLA_MACOS_CLANG")
    val macClang = if (configuredMacClang.found &&
        configuredMacClang.value != "") configuredMacClang.value
        else "clang"
    var macSdkRoot = ""
    if (needsDarwinAdapter) {
        val sdkVariable = if (appleSdk == "macosx") "ABLA_MACOS_SDK"
            else if (appleSdk == "iphoneos") "ABLA_APPLE_SDK_IPHONEOS"
            else "ABLA_APPLE_SDK_IPHONESIMULATOR"
        val configuredSdk = linuxEnvironment(sdkVariable)
        if (configuredSdk.found && configuredSdk.value != "") {
            macSdkRoot = configuredSdk.value
        } else if (ablaHostIsMacOS()) {
            val discoverSdk = linuxCommand("xcrun")
            discoverSdk.argument("--sdk")
            discoverSdk.argument(appleSdk)
            discoverSdk.argument("--show-sdk-path")
            macSdkRoot = discoverSdk.captureText()
        }
        var sdkEnd = macSdkRoot.size
        while (sdkEnd > 0 &&
            (macSdkRoot[sdkEnd - 1] == 10 ||
             macSdkRoot[sdkEnd - 1] == 13)) sdkEnd = sdkEnd - 1
        macSdkRoot = macSdkRoot.slice(0, sdkEnd)
    }
    bootstrapBeginCompileOutputs()
    val modules: array<BootstrapModule> = []
    bootstrapConfigureDiscoveryCache(moduleState, allowCache)
    moduleState.beginBuild()
    irCache.beginBuild()
    val orderedSnapshots: array<BootstrapModuleSnapshot> = []
    val graph = BootstrapModuleGraph(
        modules,
        0,
        moduleState,
        orderedSnapshots,
        [],
        "",
        [],
        bootstrapModuleGraphIndex()
    )
    // Hosted and Wasm targets get the compiler's runtime. So does a target
    // that only lacks the hosted startup but still links a C library (an
    // extension-defined OS or SDK target such as a mobile or MCU toolchain):
    // the libc platform supplies allocation and locking there, and lowering
    // stays demand-driven, so a program that never allocates references none
    // of it. Only a libc-free target is runtime-neutral.
    // A 32-bit target that is not hosted (a microcontroller SDK) gets the
    // runtime Wasm uses instead, which needs no C library: its own allocator
    // and collector over one memory region and four calls to the platform
    // (platform/wasm.ab: abla_host write, exit, clock and random, and outside
    // Wasm abla_host_memory_base/size/grow for the region).
    val linearPlatform = target.objectFormat == "wasm" ||
        (!target.hosted && bootstrapLlvmTargetUses32BitPointers(target.llvmTriple))
    val libcPlatform = !linearPlatform && (target.hosted || !target.libcFree)
    val compilerRuntime = libcPlatform || linearPlatform
    if (compilerRuntime) bootstrapRequireStandardLibrary()
    val selfHostedRuntime = if (compilerRuntime) {
        Path(bootstrapStandardLibraryRoot()).child(
            "abla/runtime/self/entry.ab"
        ).text
    } else ""
    val runtimePlatform = if (linearPlatform) {
        Path(bootstrapStandardLibraryRoot()).child(
            "abla/runtime/platform/wasm.ab"
        ).text
    } else if (libcPlatform) {
        Path(bootstrapStandardLibraryRoot()).child(
            "abla/runtime/platform/host.ab"
        ).text
    } else ""
    bootstrapLlvmTraceMemory("frontend.graph-load.begin")
    graph.load(sourcePath)
    bootstrapLlvmTraceMemory(
        "frontend.graph-load.source:${orderedSnapshots.size}"
    )
    if (runtimePlatform != "") graph.load(runtimePlatform)
    bootstrapLlvmTraceMemory(
        "frontend.graph-load.platform:${orderedSnapshots.size}"
    )
    if (selfHostedRuntime != "") graph.load(selfHostedRuntime)
    bootstrapFloatBridgeAvailable = compilerRuntime && bootstrapFloatBridgeMustPreload(graph)
    bootstrapFloatFormattingRequested = false
    if (bootstrapFloatBridgeAvailable) graph.load(bootstrapFloatBridgeSource(graph, sourcePath))
    bootstrapLlvmTraceMemory(
        "frontend.graph-load.end:${orderedSnapshots.size}"
    )
    val rootManifestPath = bootstrapRootManifestPath(sourcePath)
    val nativeLibraryManifest =
        bootstrapNativeManifestLibraries(rootManifestPath.text)
    val nativeLibraries = nativeLibraryManifest.values
    var nativeLibrariesValid = nativeLibraryManifest.valid &&
        nativeLibraries.size <= 32
    var nativeLibraryIndex = 0
    while (nativeLibrariesValid &&
        nativeLibraryIndex < nativeLibraries.size) {
        nativeLibrariesValid = bootstrapNativeLibraryNameValid(
            nativeLibraries[nativeLibraryIndex]
        )
        var previousNativeLibrary = 0
        while (nativeLibrariesValid &&
            previousNativeLibrary < nativeLibraryIndex) {
            nativeLibrariesValid =
                nativeLibraries[previousNativeLibrary] !=
                nativeLibraries[nativeLibraryIndex]
            previousNativeLibrary = previousNativeLibrary + 1
        }
        nativeLibraryIndex = nativeLibraryIndex + 1
    }
    // Platform libraries remain demand-driven. Detect the narrow TLS ABI in
    // the resolved module graph so programs that do not import hosted TLS do
    // not gain either a dependency or dynamic-loader startup work.
    var linkOpenSsl = false
    var sourceModule = 0
    while (!linkOpenSsl && sourceModule < orderedSnapshots.size) {
        linkOpenSsl = bootstrapTextContains(
            orderedSnapshots[sourceModule].source,
            "fun OpenSSL_version_num()"
        )
        sourceModule = sourceModule + 1
    }
    // Filesystem-read providers have serialized content identities. Other
    // ambient effects remain uncached because they do not yet have a stable
    // deterministic provider contract.
    val compileInputsCacheable =
        bootstrapGraphCompileCapabilitiesCacheable(graph)
    val paths = bootstrapModulePaths(graph)
    val llvmPath = "$outputPath.ll"
    val objectPath = "$outputPath.o"
    val hostPath = "$outputPath.host.o"
    val ltoObjectPath = "$outputPath.lto-program.o"
    val ltoPreparedPath = "$outputPath.lto-prepared.bc"
    val combinedObjectPath = "$outputPath.combined.o"
    // The artifact is written beside its output and renamed over it. Darwin's
    // linker signs an image with its file name as the identifier, and a Wasm
    // module's name section records its file name, so those are written under
    // their final name in a private directory: a temporary name would make
    // every build of the same program differ.
    val privatePublish = macTarget || target.objectFormat == "wasm"
    val publishDirectory = if (privatePublish)
        "$outputPath.publish.${linuxProcessId()}" else ""
    val publishPath = if (privatePublish)
        "$publishDirectory/${Path(outputPath).name()}"
    else "$outputPath.tmp.${linuxProcessId()}"
    // Each file the build publishes is written beside its name and renamed over it,
    // so a stopped build leaves whole files, and temporaries the next one removes.
    // Everything this build writes goes beside the output, so its directory
    // comes first: the in-process optimizer writes its bitcode there before llc.
    Path(outputPath).parent().createDirectories()
    bootstrapRemoveBuildTemporaries(outputPath)
    if (privatePublish) Path(publishDirectory).createDirectories()
    val optimizedWasmPath = "$outputPath.wasm-opt.tmp.${linuxProcessId()}"
    val manifestPath = rootManifestPath
    val manifest = manifestPath.readText()
    val baseTargetIdentity =
        "${target.name}:${target.llvmTriple}:${target.objectFormat}:${target.hosted}:${target.libcFree}:${target.entrySymbol}:${target.linkerFlavor}:${target.linkerEmulation}"
    val targetIdentity = if (target.sdk == "") baseTargetIdentity
        else "$baseTargetIdentity:sdk=${target.sdk}"
    // Cache identity needs stable content identity, not a materialized copy of
    // every imported source. Module snapshots already carry two independent
    // content fingerprints plus size and canonical path.
    var graphIdentity = "abla-module-graph-v2"
    var identityModule = 0
    while (identityModule < orderedSnapshots.size) {
        val snapshot = orderedSnapshots[identityModule]
        graphIdentity =
            "$graphIdentity\n${snapshot.path}:${snapshot.size}:${snapshot.firstFingerprint}:${snapshot.secondFingerprint}"
        identityModule = identityModule + 1
    }
    // A WebAssembly module's DWARF names its sources by absolute path (debug.ab), so the
    // working directory is part of what its object holds; a native object's isn't.
    val debugDirectory = if (bootstrapLlvmDebugInfo && target.objectFormat == "wasm")
        "\nabla-debug-directory:${currentDirectory().text}" else ""
    val sourceIdentity =
        "$graphIdentity\nabla-manifest:${manifest.size}\n$manifest\nabla-target:$targetIdentity\nabla-artifact:$artifact\nabla-debug:$bootstrapLlvmDebugInfo$debugDirectory\nabla-prune:$bootstrapLlvmPruneRuntime"
    // Release hosted executables may keep their ordinary relocatable sidecar
    // (on request), but the executable itself is optimized across the
    // generated program and runtime boundary. LLVM-backed compiler programs
    // remain on the regular path: linking libLLVM into an application-wide
    // LTO unit is both prohibitively expensive and outside this optimization's
    // intended runtime boundary.
    val releaseProfile = cacheProfile == "inprocess-o2" ||
        cacheProfile == "cross-o2" ||
        cacheProfile == "raw-inprocess-o2" ||
        cacheProfile == "raw-cross-o2"
    val balancedProfile = cacheProfile == "inprocess-o1" ||
        cacheProfile == "raw-inprocess-o1"
    val hostedLtoEligible = target.hosted && artifact == "executable" &&
        releaseProfile
    val wasmLtoEligible = target.objectFormat == "wasm" &&
        artifact == "module" && releaseProfile
    val ltoEligible = hostedLtoEligible || wasmLtoEligible
    // A release Wasm module links only its LTO object, rebuilt from the LLVM
    // IR: an ordinary object of the module would be optimized and generated
    // for nothing (most of such a build's time), so none is emitted or cached.
    // (A hosted executable emits it on request: that object is its relocatable
    // sidecar.)
    val wasmObjectUnused = wasmLtoEligible
    // A hosted release executable links its LTO object, so its ordinary object is only the
    // sidecar, built when a build asks for it. (A program that links LLVM links the ordinary
    // object instead and always emits it: that is known once the program is compiled.)
    val sidecarDeclined = hostedLtoEligible && !bootstrapNativeSidecarWanted()
    // A Wasm development build hands its module to opt as bitcode written in process:
    // rendering about 100 MB of LLVM text, reading it back and parsing it again cost
    // seconds, and nothing reads that text. ABLA_KEEP_LLVM_TEXT=1 keeps it (beside the
    // module, as `<module>.ll`).
    val bitcodeHandoff = target.objectFormat == "wasm" && !ltoEligible &&
        (cacheProfile == "cross-fast" || cacheProfile == "raw-cross-fast") &&
        !bootstrapKeepLlvmText()
    val bitcodePath = if (bitcodeHandoff) "$outputPath.input.bc" else ""
    // In-process Wasm codegen avoids the bitcode/opt/llc handoff.
    // ABLA_LLVM_OUT_OF_PROCESS=1 retains the isolated-tool fallback.
    val inProcessCodegen = bitcodeHandoff && !bootstrapLlvmOutOfProcess()
    val fastCross = cacheProfile == "cross-fast" || cacheProfile == "raw-cross-fast"
    val firstHash = bootstrapNativeCacheHash(
        sourceIdentity, 17, 257, 1000000007
    )
    val secondHash = bootstrapNativeCacheHash(
        sourceIdentity, 97, 263, 1000000009
    )
    // Source identity alone is insufficient: an object produced by an older
    // compiler can be invalid after semantic or lowering changes even when the
    // input program is byte-identical. Hash the executable that is performing
    // this build so cache correctness does not depend on remembering a manual
    // version bump for every compiler change.
    //
    // An image that cannot be read has no identity, and keying it as empty
    // would let every such compiler share entries: that build runs uncached.
    // The image does not contain a shared LLVM library, nor the external opt
    // and llc that emit cross-target objects, so their versions join it.
    // Native development builds keep the module for code generation: rendering
    // then parsing its text costs hundreds of MB for a large program. Codegen
    // units can cache their bitcode inputs without that textual handoff.
    // ABLA_KEEP_LLVM_TEXT=1 and ABLA_LLVM_OUT_OF_PROCESS=1 keep the text.
    val nativeFastHeld = target.hosted &&
        (target.objectFormat == "macho" ||
         (target.objectFormat == "elf" && !ablaHostIsMacOS())) && !ltoEligible &&
        cacheProfile == "inprocess-fast" && !bootstrapKeepLlvmText() &&
        !bootstrapLlvmOutOfProcess()
    val balancedHeldCandidate = target.hosted && artifact == "executable" &&
        target.objectFormat == "elf" && !ablaHostIsMacOS() &&
        cacheProfile == "inprocess-o1" && !bootstrapKeepLlvmText() &&
        !bootstrapLlvmOutOfProcess()
    var nativeHeld = nativeFastHeld || balancedHeldCandidate
    // A Linux release executable keeps its module too, optimized in process
    // (bootstrapOptimizeHeldWholeProgram): its text is written only for the cache, or for
    // a program that links LLVM, which is built from the text in parts. A requested
    // sidecar object is made from the text as well. ABLA_KEEP_LLVM_TEXT=1 and
    // ABLA_LLVM_OUT_OF_PROCESS=1 keep the text and opt.
    val wholeProgramHeld = sidecarDeclined && cacheProfile == "inprocess-o2" &&
        target.objectFormat == "elf" && !ablaHostIsMacOS() && !bootstrapKeepLlvmText() &&
        !bootstrapLlvmOutOfProcess()
    // Large LLVM-linked release programs use external opt, but need not print
    // and reparse their module. Keep it until its linkage and size are known.
    // Debug/text/tool-isolation requests retain the existing textual path.
    val compilerBitcodeCandidate = hostedLtoEligible && cacheProfile == "inprocess-o2" &&
        target.objectFormat == "elf" && !ablaHostIsMacOS() &&
        !bootstrapLlvmDebugInfo && !bootstrapKeepLlvmText() &&
        !bootstrapLlvmOutOfProcess()
    val compilerBitcodePath = "$objectPath.preopt.bc"
    var compilerBitcode = false
    // Set once the build has the held module to optimize.
    var optimizeHeld = false
    // Reading and hashing about 10 MB is a sixth of a small build, so only what keys
    // on the image does it: the cache, and code generation units (on for every build).
    val compilerImageUsed = allowCache || inProcessCodegen || nativeFastHeld
    if (compilerImageUsed) bootstrapReadRunningImageIdentity()
    val imageBytes = if (compilerImageUsed && bootstrapRunningImageSize > 0)
        bootstrapRunningImageSize else 0
    val cacheEnabled = allowCache && imageBytes > 0
    // An executable's held module may be generated as code generation units, whose
    // object is an archive of them (codegen_units.ab) that the link loads whole: only an
    // executable's, as an object or library artifact is that object itself. (Its cache
    // entries are its own for that reason.)
    val nativeUnits = nativeFastHeld && artifact == "executable"
    var backendIdentity = ""
    if (cacheEnabled) {
        backendIdentity = "abla-backend\nllvm-library:${llvmLibraryVersion()}"
        if (balancedProfile) {
            backendIdentity =
                "$backendIdentity\nbalanced-passes:${llvmPassesBalanced()}\nbalanced-inline-threshold:${llvmBalancedAotInlineThreshold()}"
        }
        // A cross --fast build gives the inliner ABLA_FAST_INLINE_THRESHOLD (fastCross, below):
        // another value is another object, so it joins the key.
        if (fastCross) {
            backendIdentity =
                "$backendIdentity\nfast-inline-threshold:${bootstrapFastInlineThreshold()}"
        }
        if (targetToolsIdentity != "") {
            backendIdentity = "$backendIdentity\n$targetToolsIdentity"
        } else if (bootstrapTextContains(cacheProfile, "cross-")) {
            backendIdentity =
                "$backendIdentity\nopt:${linuxCommand("opt").argument(
                    "--version"
                ).captureText()}\nllc:${linuxCommand("llc").argument(
                    "--version"
                ).captureText()}"
        }
