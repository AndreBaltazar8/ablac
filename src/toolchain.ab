        val enclosingInlineThreshold = bootstrapLlvmFastInlineThreshold
        val enclosingHoldModule = bootstrapLlvmHoldModule
        val enclosingInitializerChunk = bootstrapLlvmInitializerChunk
        val enclosingStackGuard = bootstrapLlvmStackGuard
        val enclosingOwnMemoryRoutines = bootstrapLlvmOwnMemoryRoutines
        val enclosingFreestandingStart = bootstrapLlvmFreestandingStart
        val enclosingCoverage = bootstrapLlvmCoverage
        bootstrapLlvmCoverage = bootstrapLlvmCoverageRequested &&
