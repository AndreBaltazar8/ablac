    }
    // The LTO object is a function of the cached module and the tools that prepare
    // and compile it: a cache hit takes the one its entry's first build made
    // instead of preparing and compiling the module again.
    var ltoCache = ""
    if (ltoEligible && !linkLlvm && cacheEnabled && compileInputsCacheable) {
        ltoCache = bootstrapToolObjectCachePath(
            "$cacheStem.lto-v2",
            "${target.llvmTriple}\n${bootstrapToolIdentity(bootstrapHostLlvmTool("opt"))}\n${bootstrapToolIdentity(bootstrapHostLlvmTool("llc"))}\n${bootstrapToolIdentity(if (macTarget) macClang else "clang")}\n$macSdkRoot"
        )
    }
    var ltoReused = false
    if (status == 0 && cached && ltoCache != "") {
        val ltoCacheInfo = Path(ltoCache).info()
        ltoReused = ltoCacheInfo.isFile() && ltoCacheInfo.size > 0 &&
            bootstrapCopyNativeObject(ltoCache, ltoObjectPath) == 0
    }
    // A Linux executable is one module holding the runtime, so optimizing it as a whole
    // program needs no linker: see bootstrapOptimizeWholeProgram.
    val wholeProgram = ltoEligible && !linkLlvm && target.objectFormat == "elf"
    if (status == 0 && wholeProgram && !ltoReused) {
        status = if (optimizeHeld) bootstrapOptimizeHeldWholeProgram(
            target.llvmTriple, ltoPreparedPath, ltoObjectPath, abiManifest
        ) else bootstrapOptimizeWholeProgram(llvmPath, ltoPreparedPath, ltoObjectPath, abiManifest)
        if (status == 0 && ltoCache != "" && Path(cacheDirectory).createDirectories()) {
            bootstrapPublishCacheFile(ltoObjectPath, ltoCache)
        }
    }
    // (A build that failed before using it.)
    bootstrapDisposeHeldModule()
    if (status == 0 && ltoEligible && !linkLlvm && !wholeProgram && !ltoReused) {
        status = bootstrapPrepareLtoLlvm(llvmPath, ltoPreparedPath)
        // Preparing read and rewrote the module's text (well over 100 MB for a large
        // program): garbage now, while the LTO compile and link run beside this process.
        bootstrapCollectAndRelease()
    }
    if (status == 0 && ltoEligible && !linkLlvm && !wholeProgram && !ltoReused) {
        val compileLtoProgram = if (macTarget) linuxCommand(macClang)
            else linuxCommand("env")
        if (!macTarget) {
            compileLtoProgram.argument("NIX_HARDENING_ENABLE=")
            compileLtoProgram.argument("clang")
        }
        compileLtoProgram.argument("-O2")
        compileLtoProgram.argument("-flto")
        compileLtoProgram.argument("-Wno-unused-command-line-argument")
        if (wasmLtoEligible) {
            compileLtoProgram.argument("--target=${target.llvmTriple}")
            compileLtoProgram.argument("-ffreestanding")
            compileLtoProgram.argument("-fno-stack-protector")
        }
        if (macTarget) {
            compileLtoProgram.argument("--target=${target.llvmTriple}")
            compileLtoProgram.argument("-isysroot")
            compileLtoProgram.argument(macSdkRoot)
        }
        compileLtoProgram.argument("-c")
        compileLtoProgram.argument(ltoPreparedPath)
        compileLtoProgram.argument("-o")
        compileLtoProgram.argument(ltoObjectPath)
        status = compileLtoProgram.run()
        if (status == 0 && ltoCache != "" && Path(cacheDirectory).createDirectories()) {
            bootstrapPublishCacheFile(ltoObjectPath, ltoCache)
        }
    }
    if (status == 0 && target.hosted && artifact == "executable") {
        // An x86-64 Linux program links without libc (#806): a static-pie image
        // entered at its own abla_start, its threads on abla_clone_create/join,
        // with only the compiler's runtime library (-nolibc keeps it). It links the
        // C library only when it brings one: an OpenSSL import, libLLVM, the
        // manifest's nativeLibraries, extern "host" calls, or a C function the
        // libc-free link can't resolve (lld names it; `--verbose` prints why).
        var libcFree = !macTarget && bootstrapLlvmTargetIsX8664Linux(target.llvmTriple) &&
        !target.libcFree && !linkOpenSsl && !linkLlvm && !hostImports &&
        nativeLibraries.size == 0
        var libcReason = if (macTarget || !bootstrapLlvmTargetIsX8664Linux(target.llvmTriple)) ""
        else if (linkOpenSsl) "it imports OpenSSL (TLS)"
        else if (linkLlvm) "it links libLLVM"
        else if (nativeLibraries.size > 0) "the manifest names nativeLibraries"
        else if (hostImports) "it calls extern \"host\" functions"
        else ""
        var linking = true
        while (linking) {
            val link = bootstrapLinkCommand(if (macTarget) macClang else "clang")
            if (libcFree) {
                link.argument("-nostartfiles")
                link.argument("-nolibc")
                link.argument("-static-pie")
                link.argument("-Wl,-e,abla_start")
                link.argument("-Wl,--defsym=pthread_create=abla_clone_create")
                link.argument("-Wl,--defsym=pthread_join=abla_clone_join")
            } else link.argument("-pthread")
            if (ltoEligible && !linkLlvm && !wholeProgram) {
                link.argument("-O2")
                link.argument("-flto")
            }
            if (macTarget) {
                link.argument("--target=${target.llvmTriple}")
                if (!ablaHostIsMacOS()) {
                    link.argument("-fuse-ld=lld")
                    link.argument("-Wl,--threads=1")
                }
                link.argument("-isysroot")
                link.argument(macSdkRoot)
                link.argument("-Wl,-dead_strip")
            }
            else {
                link.argument("-fuse-ld=lld")
                link.argument("-Wl,--threads=1")
                link.argument("-Wl,--gc-sections")
                link.argument("-Wl,--error-limit=0")
            }
            if (linkLlvm) {
                link.argument(if (macTarget)
                    "-Wl,-export_dynamic"
                    else
                    "-Wl,--export-dynamic"
                )
                // ORC on Darwin lowers JIT'd thread-locals to emulated TLS: keep compiler-rt's
                // ___emutls_get_address in the (exported) host image so `ablac run` resolves it.
                if (macTarget) link.argument("-Wl,-u,___emutls_get_address")
            }
            if (!linkLlvm) {
                val exportedSymbols = bootstrapNativeAbiExportSymbols(
                    abiManifest
                )
                var exportedSymbol = 0
                while (exportedSymbol < exportedSymbols.size) {
                    link.argument(if (macTarget)
                        "-Wl,-exported_symbol,_${exportedSymbols[exportedSymbol]}"
                        else
                        "-Wl,--export-dynamic-symbol=${exportedSymbols[exportedSymbol]}"
                    )
                    exportedSymbol = exportedSymbol + 1
                }
            }
            if (linkLlvm) {
                val configuredLlvm = linuxEnvironment("ABLA_MACOS_LLVM_LIB")
                val llvmConfig = linuxCommand("llvm-config")
                llvmConfig.argument("--libdir")
                var llvmLibraryDirectory = if (macTarget &&
                    configuredLlvm.found && configuredLlvm.value != "") {
                    configuredLlvm.value
                } else llvmConfig.captureText()
                var end = llvmLibraryDirectory.size
                while (end > 0 &&
                    (llvmLibraryDirectory[end - 1] == 10 ||
                        llvmLibraryDirectory[end - 1] == 13)) end = end - 1
                llvmLibraryDirectory = llvmLibraryDirectory.slice(0, end)
                link.argument("-L$llvmLibraryDirectory")
                if (!macTarget || !configuredLlvm.found ||
                    configuredLlvm.value == "") {
                    link.argument("-Wl,-rpath,$llvmLibraryDirectory")
                }
                link.argument("-lLLVM")
            }
            // (An archive of code generation units is loaded whole; ld64 loads an object
            // so named as it loads it plainly.)
            val linkedObject = if (ltoEligible && !linkLlvm) ltoObjectPath else objectPath
            if (nativeUnits && macTarget) link.argument("-Wl,-force_load,$objectPath")
            else if (nativeUnits) {
                link.argument("-Wl,--whole-archive")
                link.argument(objectPath)
                link.argument("-Wl,--no-whole-archive")
            }
            else link.argument(linkedObject)
            if (macTarget) link.argument(hostPath)
            // OpenSSL is not on Darwin's default library path, whether the graph
            // links it for TLS or the manifest names it.
            val openSslLibraryDirectory = bootstrapMacOpenSslLibraryDirectory(
                macTarget
            )
            if (openSslLibraryDirectory != "" && (linkOpenSsl ||
                bootstrapNamesOpenSsl(nativeLibraries))) {
                link.argument("-L$openSslLibraryDirectory")
            }
            if (linkOpenSsl) {
                link.argument("-lssl")
                link.argument("-lcrypto")
            }
            nativeLibraryIndex = 0
            while (nativeLibraryIndex < nativeLibraries.size) {
                val nativeLibrary = nativeLibraries[nativeLibraryIndex]
                link.argument("-l")
                link.argument(nativeLibrary)
                nativeLibraryIndex = nativeLibraryIndex + 1
            }
            // LLVM lowers floor/ceil/trunc/round intrinsics to libm calls on
            // x86-64 without SSE4.1; Darwin's libSystem already carries libm.
            // Only as needed: a program that calls none of it (float `%` is the
            // runtime's own on x86-64 Linux) does not depend on libm (#806).
            if (!macTarget && !libcFree) {
                link.argument("-Wl,--as-needed")
                link.argument("-lm")
                link.argument("-Wl,--no-as-needed")
            }
            link.argument("-o")
            link.argument(publishPath)
            val failures = "$publishPath.libc-free-link"
            if (libcFree) link.errors(failures)
            status = if (macTarget) link.run()
            else bootstrapRunHostLink(link, linkedObject, publishPath)
            if (status == 0 && libcFree) {
                // abla_start applies R_X86_64_RELATIVE relocations only.
                val relocations = linuxCommand("llvm-readelf")
                relocations.argument("-rW")
                relocations.argument(publishPath)
                for (line in relocations.captureText().split("\n")) {
                    if (bootstrapTextContains(line, "R_X86_64_") &&
                        !bootstrapTextContains(line, "R_X86_64_RELATIVE")) {
                        libcReason =
                            "its image needs a relocation abla_start does not apply: ${line.trim()}"
                        status = 1
                    }
                }
            }
            if (libcFree && status != 0) {
                if (libcReason == "") {
                    val undefined: array<string> = []
                    for (line in Path(failures).readText().split("\n")) {
                        val at = line.indexOf("undefined symbol: ")
                        if (at >= 0 && undefined.size < 8) {
                            undefined.append(line.slice(at + 18, line.size).trim())
                        }
                    }
                    libcReason = if (undefined.size >
                        0) "it calls C functions: ${undefined.join(", ")}"
                    else "the libc-free link failed"
                }
                Path(publishPath).remove()
                libcFree = false
                status = 0
            } else linking = false
            Path(failures).remove()
        }
        if (status == 0 && bootstrapBuildVerbose && libcReason != "") {
            linuxPrintStandardError("note: $outputPath links libc: $libcReason\n")
        }
    }
    // The Abla runtime is part of the program LLVM unit, so its ordinary
    // object is already the complete packageable sidecar.
    if (status == 0 && target.hosted && artifact == "executable") {
        Path(ltoObjectPath).remove()
    }
    Path(ltoPreparedPath).remove()
    if (status == 0 && !rawTarget && artifact == "object") {
        status = bootstrapCopyNativeObject(objectPath, publishPath)
        if (status != 0) failureKind = "io"
    }
    if (status == 0 && !rawTarget && artifact == "static-library") {
        val archive = linuxCommand("llvm-ar")
        archive.argument("rcs")
        archive.argument(publishPath)
        archive.argument(objectPath)
        if (appleStatic) archive.argument(hostPath)
        status = archive.run()
    }
    if (status == 0 && target.hosted && artifact == "shared-library") {
        val linkShared = bootstrapLinkCommand(if (macTarget) macClang else "clang")
        linkShared.argument("-pthread")
        if (macTarget) {
            linkShared.argument("--target=${target.llvmTriple}")
            if (!ablaHostIsMacOS()) {
                linkShared.argument("-fuse-ld=lld")
                linkShared.argument("-Wl,--threads=1")
            }
            linkShared.argument("-isysroot")
            linkShared.argument(macSdkRoot)
            linkShared.argument("-dynamiclib")
            // Named for the run-path search, not the transactional publish
            // path it is linked at (which no longer exists once published).
            linkShared.argument(
                "-Wl,-install_name,@rpath/${Path(publishPath).name()}"
            )
            linkShared.argument("-Wl,-dead_strip")
        } else {
            linkShared.argument("-shared")
            linkShared.argument("-fuse-ld=lld")
            linkShared.argument("-Wl,--threads=1")
            linkShared.argument("-Wl,--gc-sections")
        }
        if (linkLlvm) {
            val configuredLlvm = linuxEnvironment("ABLA_MACOS_LLVM_LIB")
            val llvmConfig = linuxCommand("llvm-config")
            llvmConfig.argument("--libdir")
            var llvmLibraryDirectory = if (macTarget &&
                configuredLlvm.found && configuredLlvm.value != "") {
                configuredLlvm.value
            } else llvmConfig.captureText()
            var end = llvmLibraryDirectory.size
            while (end > 0 &&
                (llvmLibraryDirectory[end - 1] == 10 ||
                 llvmLibraryDirectory[end - 1] == 13)) end = end - 1
            llvmLibraryDirectory = llvmLibraryDirectory.slice(0, end)
            linkShared.argument("-L$llvmLibraryDirectory")
            if (!macTarget || !configuredLlvm.found ||
                configuredLlvm.value == "") {
                linkShared.argument("-Wl,-rpath,$llvmLibraryDirectory")
            }
            linkShared.argument("-lLLVM")
        }
        linkShared.argument(objectPath)
        if (macTarget) linkShared.argument(hostPath)
        // OpenSSL is not on Darwin's default library path, whether the graph
        // links it for TLS or the manifest names it.
        val openSslLibraryDirectory = bootstrapMacOpenSslLibraryDirectory(
            macTarget
        )
        if (openSslLibraryDirectory != "" && (linkOpenSsl ||
            bootstrapNamesOpenSsl(nativeLibraries))) {
            linkShared.argument("-L$openSslLibraryDirectory")
        }
        if (linkOpenSsl) {
            linkShared.argument("-lssl")
            linkShared.argument("-lcrypto")
        }
        nativeLibraryIndex = 0
        while (nativeLibraryIndex < nativeLibraries.size) {
            val nativeLibrary = nativeLibraries[nativeLibraryIndex]
            linkShared.argument("-l")
            linkShared.argument(nativeLibrary)
            nativeLibraryIndex = nativeLibraryIndex + 1
        }
        if (!macTarget) linkShared.argument("-lm")
        linkShared.argument("-o")
        linkShared.argument(publishPath)
        status = linkShared.run()
    }
    if (status == 0 && !target.hosted && !rawTarget &&
        artifact == "shared-library") {
        val linkShared = linuxCommand("ld.lld")
        linkShared.argument("--threads=1")
        linkShared.argument("--gc-sections")
        linkShared.argument("-shared")
        linkShared.argument("-m")
        linkShared.argument(target.linkerEmulation)
        linkShared.argument(objectPath)
        linkShared.argument("-o")
        linkShared.argument(publishPath)
        status = linkShared.run()
    }
    if (status == 0 && target.objectFormat == "wasm" &&
        artifact == "module") {
        // A release module is linked without the panic writer first (the
        // import set of a module that never wrote), and again with it only if
        // that link imports the host's write anyway (wasm_panic.ab): the
        // final optimization is inside this link, past where the writer's
        // uses can be counted.
        val withoutPanicWrite = "$ltoObjectPath.nopanic.bc"
        if (wasmLtoEligible) status = bootstrapWriteWithoutWasmPanicWrite(
            ltoObjectPath, withoutPanicWrite
        )
        var panicWriteLinked = !wasmLtoEligible
        var linking = status == 0
        while (linking) {
            linking = false
            val linkModule = linuxCommand("wasm-ld")
            linkModule.argument("--threads=1")
            linkModule.argument("--no-entry")
            linkModule.argument("--gc-sections")
            linkModule.argument("--export-dynamic")
            // Explicit foreign declarations become ordinary WebAssembly imports.
            // The embedding runtime remains responsible for validating and
            // satisfying the module/name/signature allowlist.
            linkModule.argument("--allow-undefined")
            if (wasmLtoEligible) {
                linkModule.argument("--lto-O3")
                linkModule.argument("--lto-partitions=$BOOTSTRAP_WASM_LTO_PARTITIONS")
                for (option in bootstrapWasmExceptionOptions()) {
                    linkModule.argument("-mllvm")
                    linkModule.argument(option)
                }
            }
            linkModule.argument("-z")
            // Keep the module's committed linear-memory floor aligned with
            // ordinary Wasm guests. One MiB remains generous for Abla's
            // iterative runtime paths while avoiding a two-MiB charge before the
            // function handles its first request.
            linkModule.argument("stack-size=1048576")
            // A build without debug information publishes a module without the
            // custom name section; a debug build keeps the name section and DWARF
            // (and gets a source map below).
            if (!bootstrapLlvmDebugInfo) linkModule.argument("--strip-all")
            linkModule.argument(if (!wasmLtoEligible)
                objectPath
                else if (panicWriteLinked) ltoObjectPath
                else withoutPanicWrite)
            linkModule.argument("-o")
            linkModule.argument(publishPath)
            status = linkModule.run()
            if (status == 0 && !panicWriteLinked &&
                bootstrapWasmImportsHostWrite(publishPath)) {
                panicWriteLinked = true
                linking = true
            }
        }
        Path(withoutPanicWrite).remove()
        if (status == 0) {
            Path(ltoObjectPath).remove()
        }
    }
    // Release wasm modules receive a target-aware whole-module pass after
    // LLVM and LLD have exposed the final control-flow and call graph. Fast
    // builds intentionally skip this work to preserve short edit cycles, and
    // so does a release build with debug information: Binaryen's rewrite
    // would not keep the DWARF line tables (or keeps them very slowly).
    if (status == 0 && target.objectFormat == "wasm" &&
        artifact == "module" && releaseProfile && !bootstrapLlvmDebugInfo) {
        val optimizeModule = linuxCommand("env")
        // Binaryen otherwise sizes its worker pool from every visible host
        // CPU, which can deadlock in constrained build sandboxes with a very
        // large reported CPU count: a few workers (bootstrapWasmOptCores).
        optimizeModule.argument("BINARYEN_CORES=${bootstrapWasmOptCores()}")
        optimizeModule.argument("wasm-opt")
        // LLVM's generic wasm32 CPU emits sign-extension, saturating
        // float-to-int (f64ToInt), and bulk-memory instructions, and LLVM 23's
        // wasm-ld exports the mutable __stack_pointer under --export-dynamic.
        // Binaryen releases differ on which standardized features are on by
        // default, so make the module contract explicit. All four are baseline
        // in every engine that ships WebAssembly today.
        optimizeModule.argument("--enable-sign-ext")
        optimizeModule.argument("--enable-nontrapping-float-to-int")
        optimizeModule.argument("--enable-bulk-memory")
        optimizeModule.argument("--enable-simd")
        optimizeModule.argument("--enable-mutable-globals")
        // Only a module that leaves `orElse` attempts by an exception has any.
        if (bootstrapLlvmWasmUnwinding) optimizeModule.argument("--enable-exception-handling")
        // Functions in call-count order first: Binaryen's inlining and the module's size depend
        // on the order the link left them in, which the LTO partitions change. Sorted, a
        // game's client comes out within 0.01% of one size whatever the partitioning, and 0.3%
        // smaller than in link order (the most called functions get the shortest indices).
        optimizeModule.argument("--reorder-functions")
        optimizeModule.argument("-O3")
        optimizeModule.argument(publishPath)
        optimizeModule.argument("-o")
        optimizeModule.argument(optimizedWasmPath)
        status = optimizeModule.run()
        if (status == 0 && !Path(optimizedWasmPath).moveTo(
            Path(publishPath)
        )) {
            status = 143
            failureKind = "io"
        }
    }
    if (status == 0 && target.objectFormat == "wasm" &&
        artifact == "module" && bootstrapLlvmDebugInfo) {
        status = bootstrapWasmDebugArtifacts(publishPath, outputPath)
        if (status != 0) failureKind = "reported"
    } else if (status == 0 && target.objectFormat == "wasm" &&
        artifact == "module") {
        // A module without debug information must not sit beside an earlier
        // build's map and DWARF, which no longer describe it.
        Path("$outputPath.map").remove()
        Path("$outputPath.debug.wasm").remove()
    }
    if (status == 0) {
        if (!Path(publishPath).moveTo(Path(outputPath))) {
            status = 143
            failureKind = "io"
        }
    }
    // (No stale object beside a module that emits none, or a declined sidecar. A program
    // that links LLVM keeps its object: it is the one this build linked, and a macOS
    // compiler's self-rebuild reads it.)
    if (status == 0 && (wasmObjectUnused || (sidecarDeclined && !linkLlvm))) {
        Path(objectPath).remove()
    }
    if (status == 0 && staleLlvm) Path(llvmPath).remove()
    if (status == 0 && !bootstrapCommitCompileOutputs()) {
        status = 144
        failureKind = "io"
    }
    if (status != 0) bootstrapDiscardCompileOutputs()
    // The source marker commits the complete native entry. A downstream
    // tool/link failure must not leave a hit from its earlier frontend phase.
    if (status != 0 && cacheEnabled && compileInputsCacheable) Path(cacheSourcePath).remove()
    if (status != 0) Path(publishPath).remove()
    if (privatePublish) Path(publishDirectory).remove()
    Path(optimizedWasmPath).remove()
    Path(compilerBitcodePath).remove()
    if (status != 0) Path(combinedObjectPath).remove()
    if (status != 0) Path(ltoObjectPath).remove()
    if (status != 0) Path(ltoPreparedPath).remove()
    bootstrapRemoveBuildTemporaries(outputPath)
    if (status != 0 && failureKind == "io") {
        linuxPrintStandardError(
            "error[E_BUILD_IO]: native build could not publish an intermediate or output artifact (status $status)\n"
        )
    }
    if (status != 0 && failureKind == "") {
        linuxPrintStandardError(
            "error[E_NATIVE_TOOLCHAIN]: native toolchain failed with status $status\n"
        )
    }
    bootstrapFloatFormattingRequested = enclosingFloatFormatting
    bootstrapFloatBridgeProbe = enclosingFloatProbe
    bootstrapFloatBridgeAvailable = enclosingFloatAvailable
    BootstrapNativeBuild(
        status,
        paths,
        cached,
        moduleState.reused,
        moduleState.refreshed,
        moduleState.reusedParsed,
        moduleState.refreshedParsed,
        irCache.reused,
        irCache.refreshed,
        reusedNativePartitions,
        refreshedNativePartitions
    )
}

fun bootstrapNativeBuildWithEmitterRetainedState(
    sourcePath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string,
    var moduleState: BootstrapModuleState,
    var irCache: BootstrapIrCacheState
): BootstrapNativeBuild = bootstrapNativeBuildWithEmitterStateCache(
    sourcePath,
    outputPath,
    emitObject,
    cacheProfile,
    moduleState,
    irCache,
    true,
    bootstrapTargetDescriptor(bootstrapHostTargetName()),
    "executable"
)

fun bootstrapNativeBuildWithEmitterState(
    sourcePath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string,
    var moduleState: BootstrapModuleState
): BootstrapNativeBuild {
    val irCache = bootstrapIrTransientState()
    bootstrapNativeBuildWithEmitterRetainedState(
        sourcePath,
        outputPath,
        emitObject,
        cacheProfile,
        moduleState,
        irCache
    )
}

fun bootstrapNativeBuildWithEmitter(
    sourcePath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string
): BootstrapNativeBuild {
    val moduleState = bootstrapModuleState()
    bootstrapNativeBuildWithEmitterState(
        sourcePath,
        outputPath,
        emitObject,
        cacheProfile,
        moduleState
    )
}

fun bootstrapNativeBuildUncachedWithEmitter(
    sourcePath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string
): BootstrapNativeBuild {
    val moduleState = bootstrapModuleState()
    val irCache = bootstrapIrTransientState()
    bootstrapNativeBuildWithEmitterStateCache(
        sourcePath,
        outputPath,
        emitObject,
        cacheProfile,
        moduleState,
        irCache,
        false,
        bootstrapTargetDescriptor(bootstrapHostTargetName()),
        "executable"
    )
}

fun bootstrapNativeArtifactBuildWithEmitter(
    sourcePath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string
): BootstrapNativeBuild {
    val moduleState = bootstrapModuleState()
    bootstrapNativeArtifactBuildWithEmitterModuleState(
        sourcePath, outputPath, emitObject, cacheProfile, useCache, target,
        artifact, moduleState
    )
}

fun bootstrapNativeArtifactBuildWithEmitterModuleState(
    sourcePath: string,
    outputPath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string,
    var moduleState: BootstrapModuleState,
    targetToolsIdentity: string = ""
): BootstrapNativeBuild {
    val irCache = bootstrapIrTransientState()
    bootstrapNativeBuildWithEmitterStateCache(
        sourcePath,
        outputPath,
        emitObject,
        if (target.libcFree) "raw-$cacheProfile" else cacheProfile,
        moduleState,
        irCache,
        useCache,
        target,
        artifact,
        targetToolsIdentity
    )
}

fun bootstrapNativeBuild(
    sourcePath: string,
    outputPath: string
): BootstrapNativeBuild = bootstrapNativeBuildWithEmitter(
    sourcePath,
    outputPath,
    bootstrapExternalEmitObject,
    "external-o2"
)

class BootstrapRunIr(
    val status: int,
    val llvmPath: string,
    val linkHost: bool,
    // With `hold`: the module, kept in memory (bootstrapLlvmHeldModule) instead of
    // written to `llvmPath`, and what a cache record of the run needs.
    val sourcePaths: array<string>,
    val cacheable: bool,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>
)

fun bootstrapPrepareRun(sourcePath: string, hold: bool = false): BootstrapRunIr {
    val enclosingFloatFormatting = bootstrapFloatFormattingRequested
    val enclosingFloatProbe = bootstrapFloatBridgeProbe
    val enclosingFloatAvailable = bootstrapFloatBridgeAvailable
    bootstrapBeginCompileOutputs()
    val llvmPath = "build/.abla-run-${linuxProcessId()}.ll"
    val graph = bootstrapLoadHostModuleGraph(sourcePath)
    var parsed = graph.parse()
    val baseSnapshots = graph.orderedSnapshots.size
    val enclosingHold = bootstrapLlvmHoldModule
    bootstrapLlvmHoldModule = hold
    val irCache = bootstrapIrTransientState()
    bootstrapFloatBridgeProbe = true
    var compilation = bootstrapCompileLlvmParsedCached(parsed, irCache, llvmDefaultTargetTriple(),
        true)
    bootstrapFloatBridgeProbe = false
    if (compilation.floatBridgeNeeded) {
        graph.load(bootstrapFloatBridgeSource(graph, sourcePath))
        bootstrapFloatBridgeAvailable = true
        bootstrapFloatFormattingRequested = true
        parsed = graph.parse()
        compilation = bootstrapCompileLlvmParsedCached(parsed, irCache, llvmDefaultTargetTriple(),
            true)
        var extra = baseSnapshots
        while (extra < graph.orderedSnapshots.size) {
            compilation.compileInputPaths.append(graph.orderedSnapshots[extra].path)
            compilation.compileInputContents.append(graph.orderedSnapshots[extra].source)
            extra = extra + 1
        }
    }
    bootstrapLlvmHoldModule = enclosingHold
    val sourcePaths: array<string> = []
    for (snapshot in graph.orderedSnapshots) sourcePaths.append(snapshot.path)
    sourcePaths.append(bootstrapRootManifestPath(sourcePath).text)
    val cacheable = bootstrapGraphCompileCapabilitiesCacheable(graph) &&
        bootstrapCompileOutputCount == 0
    val requestedPrograms = bootstrapTakeCompileProgramRequests()
    val definedTargets = bootstrapTakeDefinedTargets()
    val artifactRoots = bootstrapTakeArtifactRootRequests()
    val packages = bootstrapTakeApplePackages()
    var status = 1
    if (requestedPrograms.size > 0 || definedTargets.size > 0 ||
        artifactRoots.size > 0 || packages.size > 0) {
        linuxPrintStandardError(
            "error[E_BUILD_COMMAND_UNSUPPORTED]: run cannot execute programmable build nodes; use 'ablac build'\n"
        )
        status = 151
    }
    if (compilation.errors == 0 && requestedPrograms.size == 0 &&
        definedTargets.size == 0 && artifactRoots.size == 0 && packages.size == 0 &&
        (hold || bootstrapWriteBuildFile(Path(llvmPath), compilation.output))) {
        status = 0
    }
    if (status == 0 && !bootstrapCommitCompileOutputs()) status = 144
    if (status != 0) bootstrapDiscardCompileOutputs()
    if (status != 0 && hold) bootstrapDisposeHeldModule()
    if (compilation.errors != 0) {
        linuxPrintStandardError(
            bootstrapDiagnosticPositions(compilation.diagnostics)
        )
        linuxPrintStandardError(
            "LLVM compilation failed: ${compilation.parserErrors} parser, ${compilation.extensionErrors} extension, ${compilation.semanticErrors} semantic, ${compilation.irErrors} IR, ${compilation.errors} total error(s)\n"
        )
    }
    bootstrapFloatFormattingRequested = enclosingFloatFormatting
    bootstrapFloatBridgeProbe = enclosingFloatProbe
    bootstrapFloatBridgeAvailable = enclosingFloatAvailable
    BootstrapRunIr(
        status, llvmPath, compilation.linkHost, sourcePaths, cacheable,
        compilation.compileInputPaths, compilation.compileInputContents
    )
}

fun bootstrapRun(sourcePath: string): int {
    val prepared = bootstrapPrepareRun(sourcePath)
    var status = prepared.status
    if (status == 0) {
        val execute = linuxCommand("build/abla-orc-runner")
        execute.argument(prepared.llvmPath)
        status = execute.run()
    }
    Path(prepared.llvmPath).remove()
    status
}

fun bootstrapServe(sourcePath: string): int {
    bootstrapServeWithEmitter(
        sourcePath,
        bootstrapExternalEmitObject,
        "external-o2"
    )
}

// What the build read of each module, not what is there now: an edit made during
// the build then counts as a change.
fun bootstrapServeWatch(modules: array<Path>, state: BootstrapModuleState): FileWatch {
    val revisions: array<int> = []
    for (module in modules) {
        val known = state.snapshotIndex.get(module.text)
        revisions.append(if (known == null) module.revision() else state.snapshots[known].revision)
    }
    FileWatch(modules, revisions)
}

// A generation's executable and the files its build left beside it.
fun bootstrapServeRemoveGeneration(process: int, generation: int): void {
    val name = ".abla-serve-$process-$generation"
    for (entry in Path("build").entries()) {
        val file = entry.name()
        if (file == name || file.startsWith("$name.")) entry.remove()
    }
    return
}

// What a `serve` that was killed left: it has no chance to, and a process that is
// gone won't need it.
fun bootstrapServeRemoveAbandoned(): void {
    val prefix = ".abla-serve-"
    for (entry in Path("build").entries()) {
        val file = entry.name()
        if (file.startsWith(prefix)) {
            var end = prefix.size
            var process = 0
            while (end < file.size && file[end] >= 48 && file[end] <= 57) {
                process = process * 10 + file[end] - 48
                end = end + 1
            }
            // kill(process, 0): ESRCH, no such process.
            if (end > prefix.size && linuxSyscall2(62, process, 0) == -3) entry.remove()
        }
    }
    return
}

fun bootstrapServeWithEmitter(
    sourcePath: string,
    emitObject: (string, string) -> int,
    cacheProfile: string
): int {
    var child = LinuxChildProcess(-1)
    var running = false
    var generation = 0
    var started = 0
    bootstrapServeRemoveAbandoned()
    var watcher = watchFile(Path(sourcePath))
    val moduleState = bootstrapModuleState()
    val irCache = bootstrapIrCacheState()
    var rebuild = true
    while (true) {
        if (rebuild) {
            // Per process: another `serve` from this directory would replace it
            // between this build and the start below.
            val outputPath = "build/.abla-serve-${linuxProcessId()}-$generation"
            val build = bootstrapNativeBuildWithEmitterRetainedState(
                sourcePath,
                outputPath,
                emitObject,
                cacheProfile,
                moduleState,
                irCache
            )
            val requestedPrograms = bootstrapTakeCompileProgramRequests()
            val definedTargets = bootstrapTakeDefinedTargets()
            val artifactRoots = bootstrapTakeArtifactRootRequests()
            val packages = bootstrapTakeApplePackages()
            var accepted = build.status == 0
            if (requestedPrograms.size > 0 || definedTargets.size > 0 ||
                artifactRoots.size > 0 || packages.size > 0) {
                linuxPrintStandardError(
                    "error[E_BUILD_COMMAND_UNSUPPORTED]: serve cannot execute programmable build nodes; use 'ablac build'\n"
                )
                accepted = false
            }
            watcher = bootstrapServeWatch(build.modules, moduleState)
            generation = generation + 1
            if (accepted) {
                if (child.process >= 0) {
                    if (running) child.stop()
                    bootstrapServeRemoveGeneration(linuxProcessId(), started)
                }
                child = linuxCommand(outputPath).start()
                running = true
                started = generation - 1
                linuxPrintStandardError(
                    "reloaded generation $generation; modules: ${build.refreshedModules} refreshed, ${build.reusedModules} reused; parsed: ${build.refreshedParsedModules} refreshed, ${build.reusedParsedModules} reused; lowered: ${build.refreshedLoweredFunctions} refreshed, ${build.reusedLoweredFunctions} reused; objects: ${build.refreshedNativePartitions} refreshed, ${build.reusedNativePartitions} reused\n"
                )
            } else {
                linuxPrintStandardError(
                    "reload rejected; previous generation remains active\n"
                )
            }
            rebuild = false
        }
        linuxSleep(200)
        // A program that ended is waited for now, not when the next generation replaces it.
        if (running && linuxWaitProcess(child.process, true).output != "pending") running = false
        if (watcher.changed()) rebuild = true
    }
    0
}

// The libc-free entry and thread block routines (exports.ab), which only the
// libc-free link and the clone threads' module assembly reach: LTO must keep them.
fun bootstrapFreestandingRoutineNames(): array<string> =
    ["abla_start", "abla_tls_bytes", "abla_tls_init", "abla_tls_set"]

// The C functions the modules that declare the OpenSSL ABI import (`extern:"c" fun NAME(`).
fun bootstrapOpenSslExternNames(source: string): array<string> {
    val names: array<string> = []
    val marker = "extern:\"c\" fun "
    var index = 0
    while (index + marker.size < source.size) {
        if (source.slice(index, index + marker.size) == marker) {
            var end = index + marker.size
            while (end < source.size && source[end] != 40 && source[end] != 32) end = end + 1
            names.append(source.slice(index + marker.size, end))
            index = end
        } else index = index + 1
    }
    names
}

// Whether the object imports any of those functions: only then does the program reach OpenSSL
// (a program that imports `abla/http` without a TLS connection references none). An object that
// cannot be listed counts as importing them.
fun bootstrapObjectImportsOpenSsl(
    objectPath: string,
    sources: array<string>
): bool {
    if (!Path(objectPath).exists()) return true
    val imported: Map<string, bool> = Map()
    for (source in sources) {
        for (name in bootstrapOpenSslExternNames(source)) imported.set(name, true)
    }
    val listing = linuxCommand("llvm-nm")
    listing.argument("--undefined-only")
    listing.argument(objectPath)
    val text = listing.captureText()
    if (text == "") return true
    for (line in text.split("\n")) {
        var start = line.size
        while (start > 0 && line[start - 1] != 32) start = start - 1
        if (start < line.size && imported.get(line.slice(start, line.size)) != null) return true
    }
    false
}

// Whether a module declares C functions of libssl or libcrypto: the TLS and crypto modules of the
// standard library (by path), or any module that carries the OpenSSL ABI marker.
fun bootstrapDeclaresOpenSslImports(path: string, source: string): bool =
    bootstrapTextContains(source, "fun OpenSSL_version_num()") ||
    bootstrapTextContains(path, "abla/tls/") ||
    bootstrapTextContains(path, "abla/crypto/") ||
    bootstrapTextContains(path, "abla/jwt/") ||
    bootstrapTextContains(path, "abla/websocket/server/tls/") ||
    bootstrapTextContains(path, "abla/http/async/openssl") ||
    bootstrapTextContains(path, "abla/platform/host/tls")
