    }
    val compilerImageSize = imageBytes + 1 + backendIdentity.size
    val compilerSuffix = bootstrapRunningImageSuffix(
        backendIdentity, if (imageBytes > 0) bootstrapRunningImageTail else 0,
        imageBytes % 4
    )
    val compilerFirstHash = if (compilerImageUsed) bootstrapNativeCacheHash(
        compilerSuffix, if (imageBytes > 0) bootstrapRunningImageFirst else 41,
        269, 1000000007
    ) else 0
    val compilerSecondHash = if (compilerImageUsed) bootstrapNativeCacheHash(
        compilerSuffix, if (imageBytes > 0) bootstrapRunningImageSecond else 101,
        271, 1000000009
    ) else 0
    val cacheDirectory = bootstrapCacheDirectory()
    val partitionCacheNamespace =
        "$cacheDirectory/native-partition-${target.name}-llvm21-v5-$cacheProfile${if (bootstrapLlvmDebugInfo) "-g" else ""}-$compilerImageSize-$compilerFirstHash-$compilerSecondHash"
