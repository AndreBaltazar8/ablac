// glibc's; Darwin's comes from the runtime's compatibility adapter, which maps it to
// malloc_zone_pressure_relief.
noescape extern:"c" fun malloc_trim(pad: int): int

// Collects the heap, then hands the pages malloc keeps free back to the system: in a
// large build the allocator otherwise holds hundreds of MB of freed blocks while opt,
// llc or the linker run beside this process.
fun bootstrapCollectAndRelease(): void {
    runtimeMemoryCollect()
    malloc_trim(0)
    return
}

// `ablac build --verbose`: notes on how the build linked (#806: why an x86-64
// Linux executable linked libc).
var bootstrapBuildVerbose: bool = false

class BootstrapTargetDescriptor(
    val name: string,
    val llvmTriple: string,
    val objectFormat: string,
    val hosted: bool,
    val libcFree: bool,
    val entrySymbol: string,
    val linkerFlavor: string,
    val linkerEmulation: string,
    val valid: bool,
    val sdk: string = ""
)

// Direct host LLVM emission uses the same source runtime graph as a normal
// host build. This keeps `--emit-llvm` a faithful diagnostic view instead of
// silently relying on declarations that only the linker path injects.
fun bootstrapParseHostModuleWithRuntime(
    sourcePath: string
): BootstrapParseResult {
    val enclosingFloatFormatting = bootstrapFloatFormattingRequested
    val enclosingFloatAvailable = bootstrapFloatBridgeAvailable
    val parsed = bootstrapLoadHostModuleGraph(sourcePath).parse()
    bootstrapFloatFormattingRequested = enclosingFloatFormatting
    bootstrapFloatBridgeAvailable = enclosingFloatAvailable
    parsed
}

// Without the runtime nothing links, and the linker would only name a symbol it missed.
fun bootstrapRequireStandardLibrary(): void {
    val standardLibrary = Path(bootstrapStandardLibraryRoot())
    if (!standardLibrary.child("abla/runtime/self/entry.ab").exists()) {
        linuxPrintStandardError(
            "error[E_TOOLCHAIN_ROOT]: no standard library at ${standardLibrary.text}: set ABLA_SYSROOT to the toolchain's directory, or start the `ablac` launcher\n"
        )
        linuxSyscall1(60, 2)
    }
    return
}

// The module graph of `sourcePath` with the host runtime, loaded (not yet parsed).
fun bootstrapLoadHostModuleGraph(sourcePath: string): BootstrapModuleGraph {
    val state = bootstrapModuleState()
    val graph = BootstrapModuleGraph([], 0, state, [], [], "", [], bootstrapModuleGraphIndex())
    val standardLibrary = Path(bootstrapStandardLibraryRoot())
    bootstrapRequireStandardLibrary()
    // (The runtime loads first: its imports are remapped as the program's.)
    graph.useRootManifest(bootstrapNormalizeModulePath(sourcePath))
    graph.load(standardLibrary.child("abla/runtime/self/entry.ab").text)
    graph.load(standardLibrary.child("abla/runtime/platform/host.ab").text)
    graph.load(sourcePath)
    bootstrapFloatBridgeAvailable = bootstrapFloatBridgeMustPreload(graph)
    bootstrapFloatFormattingRequested = false
    if (bootstrapFloatBridgeAvailable) graph.load(bootstrapFloatBridgeSource(graph, sourcePath))
    graph
}

fun bootstrapFloatBridgeSource(graph: BootstrapModuleGraph, sourcePath: string): string {
    val root = Path(bootstrapStandardLibraryRoot())
    val text = bootstrapNormalizeModulePath(root.child("abla/float/text/entry.ab").text)
    var unaliased = bootstrapNormalizeModulePath(sourcePath) == text
    for (edge in graph.aliases) {
        if (edge.target == text && edge.alias == "") unaliased = true
    }
    root.child(if (unaliased) "abla/runtime/erased-float/existing.ab"
        else "abla/runtime/erased-float/entry.ab").text
}

// Graph-time transforms can change both types and uses. Load the bridge
// conservatively before parsing them, so the semantic probe never replays
// a user transform to discover the formatter.
fun bootstrapFloatBridgeMustPreload(graph: BootstrapModuleGraph): bool {
    var compilerApi = false
    // ("abla/compiler" contains "compiler": one scan, and none after the first hit.)
    for (snapshot in graph.orderedSnapshots) {
        if (!compilerApi && bootstrapTextContains(snapshot.source, "compiler")) compilerApi = true
    }
    if (!compilerApi) return false
    for (snapshot in graph.orderedSnapshots) {
        if (snapshot.discovery.actions.size > 0) return true
        if (bootstrapTextContains(snapshot.source, "#")) {
            for (token in bootstrapLexShared(snapshot.source)) {
                if (token.kind == BOOTSTRAP_TOKEN_HASH) return true
            }
        }
    }
    false
}

fun bootstrapCompileHostEmit(sourcePath: string): BootstrapLlvmCompilation {
    val enclosingFloatFormatting = bootstrapFloatFormattingRequested
    val enclosingFloatProbe = bootstrapFloatBridgeProbe
    val enclosingFloatAvailable = bootstrapFloatBridgeAvailable
    // The graph is not kept through the first compilation: its snapshots
    // raised the compiler's own --emit-llvm peak by about 70 MB. A program
    // that turns out to need the bridge loads it again.
    var parsed = bootstrapLoadHostModuleGraph(sourcePath).parse()
    bootstrapFloatBridgeProbe = true
    var compilation = bootstrapCompileLlvmEmit(parsed, sourcePath)
    bootstrapFloatBridgeProbe = false
    if (compilation.floatBridgeNeeded) {
        val graph = bootstrapLoadHostModuleGraph(sourcePath)
        graph.load(bootstrapFloatBridgeSource(graph, sourcePath))
        bootstrapFloatBridgeAvailable = true
        bootstrapFloatFormattingRequested = true
        parsed = graph.parse()
        compilation = bootstrapCompileLlvmEmit(parsed, sourcePath)
    }
    bootstrapFloatFormattingRequested = enclosingFloatFormatting
    bootstrapFloatBridgeProbe = enclosingFloatProbe
    bootstrapFloatBridgeAvailable = enclosingFloatAvailable
    compilation
}

// A link run so that the same inputs give the same bytes: Darwin's linkers record
// each object's modification time in the debug map (N_OSO), which feeds the
// image's LC_UUID and so its code signature; ZERO_AR_DATE=1 records 0 instead.
// (ELF links record no times.)
fun bootstrapLinkCommand(linker: string): LinuxCommand {
    val command = linuxCommand("env")
    command.argument("ZERO_AR_DATE=1")
    command.argument(linker)
    command
}

// A Linux link runs the `ld.lld` that clang would run, without clang. Through a Nix shell's
// clang, a small program's link was 60 ms of 330: the wrapper's shell script and clang's own
// start, ahead of 13 ms of linking. The first link asks clang (`-###`) for the command it
// would run and keeps it in the cache directory, under the link's arguments and the
// environment clang and its wrapper read (PATH, LIBRARY_PATH, COMPILER_PATH, NIX_*, …),
// with the object and output as placeholders. A link the kept command fails, or a command
// clang doesn't print as one `ld.lld` run, goes through clang as before (and, failing,
// shows clang's errors). ABLA_LINK_DIRECT=0 always links through clang.
fun bootstrapRunHostLink(link: LinuxCommand, objectPath: string, outputPath: string): int {
    val configured = linuxEnvironment("ABLA_LINK_DIRECT")
    if (configured.found && configured.value == "0") return link.run()
    val directory = Path(bootstrapCacheDirectory()).child("link")
    val probe = directory.child(bootstrapHostLinkKey(link.arguments, objectPath, outputPath))
    var kept = probe.readText()
    if (kept == "" && directory.createDirectories()) {
        kept = bootstrapProbeHostLink(link, objectPath, outputPath)
        if (kept != "") probe.writeTextAtomic(kept)
    }
    if (kept != "") {
        val lines = kept.split("\n")
        val direct = linuxCommand(bootstrapLinkProbeArgument(lines[0], objectPath, outputPath))
        var index = 1
        while (index < lines.size) {
            direct.argument(bootstrapLinkProbeArgument(lines[index], objectPath, outputPath))
            index = index + 1
        }
        val errors = "$outputPath.link-errors"
        direct.errors(errors)
        val status = direct.run()
        Path(errors).remove()
        if (status == 0) return 0
        probe.remove()
    }
    link.run()
}

// A kept argument with its placeholder put back.
fun bootstrapLinkProbeArgument(argument: string, objectPath: string, outputPath: string): string =
    if (argument == "\x01object") objectPath
    else if (argument == "\x01output") outputPath
    else argument

// The key of a link's kept command: its arguments, the object and output as placeholders,
// and what in the environment can change the command clang runs.
fun bootstrapHostLinkKey(
    arguments: array<string>,
    objectPath: string,
    outputPath: string
): string {
    var text = "abla-link-probe 2"
    for (argument in arguments) {
        text = "$text\n${if (argument == objectPath) "\x01object"
            else if (argument == outputPath) "\x01output" else argument}"
    }
    for (entry in linuxEnvironmentEntries()) {
        if (bootstrapLinkReadsEnvironment(entry)) text = "$text\n$entry"
    }
    val first = bootstrapNativeCacheHash(text, 17, 257, 1000000007)
    val second = bootstrapNativeCacheHash(text, 31, 263, 1000000009)
    "$first-$second"
}

// Whether clang, its Nix wrapper or the linker reads this `NAME=value` entry. Not the
// temporary directory a Nix shell names afresh on each entry: nothing in a link command
// comes from it.
fun bootstrapLinkReadsEnvironment(entry: string): bool =
    (entry.startsWith("NIX_") && !entry.startsWith("NIX_BUILD_TOP=")) ||
    entry.startsWith("PATH=") || entry.startsWith("LIBRARY_PATH=") ||
    entry.startsWith("COMPILER_PATH=") || entry.startsWith("GCC_EXEC_PREFIX=") ||
    entry.startsWith("LD_RUN_PATH=") || entry.startsWith("SDKROOT=") ||
    entry.startsWith("CLANG_") || entry.startsWith("CCC_") ||
    entry.startsWith("ZERO_AR_DATE=")

// The command clang runs for `link`, one argument a line with the object and the output as
// placeholders; "" unless clang prints exactly one command, an `ld.lld`, holding each once.
fun bootstrapProbeHostLink(link: LinuxCommand, objectPath: string, outputPath: string): string {
    val probe = linuxCommand(link.arguments[0])
    var index = 1
    while (index < link.arguments.size) {
        probe.argument(link.arguments[index])
        index = index + 1
    }
    probe.argument("-###")
    val printed = "$outputPath.link-probe"
    probe.errors(printed)
    probe.output("/dev/null")
    val status = probe.run()
    val text = Path(printed).readText()
    Path(printed).remove()
    if (status != 0) return ""
    var command: array<string> = []
    var commands = 0
    for (line in text.split("\n")) {
        if (line.startsWith(" \"")) {
            commands = commands + 1
            command = bootstrapLinkProbeWords(line)
        }
    }
    if (commands != 1 || command.size < 2 || !command[0].endsWith("/ld.lld")) return ""
    var objects = 0
    var outputs = 0
    var kept = ""
    index = 0
    while (index < command.size) {
        var argument = command[index]
        if (argument.indexOf("\n", 0) >= 0 || argument.indexOf("\x01", 0) >= 0) return ""
        if (argument == objectPath) {
            objects = objects + 1
            argument = "\x01object"
        } else if (argument == outputPath) {
            outputs = outputs + 1
            argument = "\x01output"
        }
        if (!bootstrapLinkStartupObject(argument)) {
            kept = if (index == 0) argument else "$kept\n$argument"
        }
        index = index + 1
    }
    if (objects != 1 || outputs != 1) "" else kept
}

// Whether `argument` is one of C's start-up objects around a program (crti and crtn's .init
// and .fini, crtbegin and crtend's transactional-memory clone tables and destructor walk),
// which the kept command leaves out: an Abla program has no C++ destructors or clones, its
// own initializers run from .init_array, which glibc runs without them, and unwinding finds
// frames through the linker's --eh-frame-hdr table. Four sections and their code: fib went
// from 15,096 bytes to 13,920. A program whose libraries do need them (`__dso_handle`) fails
// the direct link and links through clang.
fun bootstrapLinkStartupObject(argument: string): bool {
    var start = argument.size
    while (start > 0 && argument[start - 1] != 47) start = start - 1
    val name = argument.slice(start, argument.size)
    name == "crti.o" || name == "crtn.o" || (name.startsWith("crtbegin") && name.endsWith(".o")) ||
        (name.startsWith("crtend") && name.endsWith(".o"))
}

// The words of a command as clang's `-###` prints it: each in double quotes, with `\`
// before a `"`, `\` or `$` inside.
fun bootstrapLinkProbeWords(line: string): array<string> {
    val words: array<string> = []
    var index = 0
    while (index < line.size) {
        if (line[index] == 34) {
            var word = ""
            index = index + 1
            var start = index
            while (index < line.size && line[index] != 34) {
                if (line[index] == 92 && index + 1 < line.size) {
                    word = "$word${line.slice(start, index)}"
                    index = index + 1
                    start = index
                }
                index = index + 1
            }
            words.append("$word${line.slice(start, if (index < line.size) index else line.size)}")
        }
        index = index + 1
    }
    words
}

var bootstrapHostLlvmToolsDirectory: string = ""

// Where a host build's opt and llc are: ABLA_LLVM_TOOLS (shell.nix sets it), else the bin/
// beside a shipped toolchain's libexec/ablac.bin, else the first directory on PATH that holds
// both. Never a lone llc ahead on PATH: abla-embedded puts one there that adds -mcpu=esp32, and
// since a host executable goes through llc, a host build under it failed to make x86_64 code.
// Cross targets still run PATH's llc, as those wrappers are for them.
fun bootstrapHostLlvmTool(name: string): string {
    if (bootstrapHostLlvmToolsDirectory == "") {
        val configured = linuxEnvironment("ABLA_LLVM_TOOLS")
        var directory = if (configured.found) configured.value else ""
        if (directory == "") {
            val shipped = Path(Path("/proc/self/exe").linkTarget()).parent().parent().child("bin")
            if (bootstrapHoldsLlvmTools(shipped.text)) directory = shipped.text
        }
        if (directory == "") {
            val search = linuxEnvironment("PATH")
            if (search.found) {
                for (entry in search.value.split(":")) {
                    if (directory == "" && entry != "" &&
                        bootstrapHoldsLlvmTools(entry)) directory = entry
                }
            }
        }
        bootstrapHostLlvmToolsDirectory = if (directory == "") "-" else directory
    }
    if (bootstrapHostLlvmToolsDirectory == "-") name else "$bootstrapHostLlvmToolsDirectory/$name"
}

fun bootstrapHoldsLlvmTools(directory: string): bool =
    Path("$directory/opt").info().isFile() && Path("$directory/llc").info().isFile()

fun bootstrapTargetDescriptor(name: string): BootstrapTargetDescriptor {
    var result = BootstrapTargetDescriptor(
        name, "", "", false, false, "", "", "", false
    )
    if (name == "x86_64-linux") {
        result = BootstrapTargetDescriptor(
            name,
            "x86_64-unknown-linux-gnu",
            "elf",
            true,
            false,
            "main",
            "host-clang",
            "elf_x86_64",
            true
        )
    }
    if (name == "x86_64-macos" || name == "arm64-macos") {
        result = BootstrapTargetDescriptor(
            name,
            if (name == "arm64-macos") "arm64-apple-macosx11.0.0"
            else "x86_64-apple-macosx11.0.0",
            "macho",
            true,
            false,
            "main",
            "host-clang",
            "",
            true
        )
    }
    result
}

// A raw object target is a generic LLVM emission contract. It deliberately
// carries no hosted ABI, startup sequence, sysroot, or linker behavior; those
// belong to a framework/build program when an executable is requested.
fun bootstrapRawObjectTargetDescriptor(
    llvmTriple: string,
    objectFormat: string
): BootstrapTargetDescriptor = BootstrapTargetDescriptor(
    "raw-object:$llvmTriple:$objectFormat",
    llvmTriple,
    objectFormat,
    false,
    true,
    "",
    "none",
    "none",
    llvmTriple.size > 0 &&
        (objectFormat == "elf" || objectFormat == "macho" ||
         objectFormat == "coff" || objectFormat == "wasm")
)

fun bootstrapTripleArchitecture(triple: string): string {
    var end = 0
    while (end < triple.size && triple[end] != 45) end = end + 1
    triple.slice(0, end)
}

fun bootstrapHostTargetName(): string {
    var result = "x86_64-linux"
    if (ablaHostIsMacOS()) {
        result = "${bootstrapTripleArchitecture(
            llvmDefaultTargetTriple()
        )}-macos"
    }
    result
}

fun bootstrapTargetIsHost(target: BootstrapTargetDescriptor): bool =
    target.name == bootstrapHostTargetName()

fun bootstrapAppleSdkMatchesTriple(sdk: string, triple: string): bool {
    val ios = bootstrapTextContains(triple, "-apple-ios")
    val simulator = triple.endsWith("-simulator")
    if (sdk == "iphoneos") return ios && !simulator
    if (sdk == "iphonesimulator") return ios && simulator
    sdk == "macosx" &&
        (bootstrapTextContains(triple, "-apple-macos") ||
         bootstrapTextContains(triple, "-apple-darwin"))
}

fun bootstrapDefinedTargetDescriptor(
    target: BootstrapDefinedTarget
): BootstrapTargetDescriptor = BootstrapTargetDescriptor(
    target.name,
    target.llvmTriple,
    target.objectFormat,
    target.hosted,
    target.libcFree,
    "",
    target.linkerFlavor,
    target.linkerEmulation,
    ((!target.hosted && target.linkerFlavor == "none" &&
      target.linkerEmulation == "none" &&
      (target.objectFormat == "elf" ||
       target.objectFormat == "macho" ||
       target.objectFormat == "coff" ||
       target.objectFormat == "wasm")) ||
     (target.objectFormat == "elf" && !target.libcFree &&
      ((target.hosted &&
        target.llvmTriple == "x86_64-unknown-linux-gnu" &&
        target.linkerFlavor == "host-clang") ||
       (!target.hosted && target.linkerFlavor == "lld-elf"))) ||
     (target.objectFormat == "wasm" && !target.hosted &&
      target.libcFree && target.linkerFlavor == "wasm-ld") ||
     (target.objectFormat == "macho" && !target.hosted &&
      !target.libcFree && target.linkerFlavor == "apple-static" &&
      target.linkerEmulation == "" &&
      bootstrapAppleSdkMatchesTriple(target.sdk, target.llvmTriple))),
    target.sdk
)

fun bootstrapSupportedTargets(): string =
    "x86_64-linux, x86_64-macos, arm64-macos"

class BootstrapNativeBuild(
    val status: int,
    val modules: array<Path>,
    val cached: bool,
    val reusedModules: int,
    val refreshedModules: int,
    val reusedParsedModules: int,
    val refreshedParsedModules: int,
    val reusedLoweredFunctions: int,
    val refreshedLoweredFunctions: int,
    val reusedNativePartitions: int,
    val refreshedNativePartitions: int
)

fun bootstrapModulePaths(graph: BootstrapModuleGraph): array<Path> {
    val paths: array<Path> = []
    var index = 0
    while (index < graph.modules.size) {
        paths.append(Path(graph.modules[index].path))
        index = index + 1
    }
    if (graph.modules.size > 0) {
        val manifest = Path(graph.modules[0].path).parent().child("abla.toml")
        if (manifest.exists()) paths.append(manifest)
    }
    paths
}

fun bootstrapRootManifestPath(sourcePath: string): Path {
    var directory = Path(sourcePath).parent()
    var result = directory.child("abla.toml")
    var searching = !result.exists()
    var depth = 0
    while (searching && depth < 128) {
        val parent = directory.parent()
        if (parent.text == directory.text) searching = false
        directory = parent
        val candidate = directory.child("abla.toml")
        if (candidate.exists()) {
            result = candidate
            searching = false
        }
        depth = depth + 1
    }
    result
}

fun bootstrapNativeLibraryNameValid(name: string): bool {
    var valid = name.size > 0 && name.size <= 128
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        valid = (byte >= 48 && byte <= 57) ||
            (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) ||
            byte == 43 || byte == 45 || byte == 46 || byte == 95
        index = index + 1
    }
    valid
}

class BootstrapNativeLibraries(
    val values: array<string>,
    val valid: bool
)

fun bootstrapNativeManifestLibraries(
    manifestPath: string
): BootstrapNativeLibraries {
    val values: array<string> = []
    val source = Path(manifestPath).readText()
    val key = "nativeLibraries"
    var cursor = -1
    var occurrences = 0
    var lineBegin = 0
    while (lineBegin < source.size) {
        var lineEnd = lineBegin
        while (lineEnd < source.size && source[lineEnd] != 10 &&
               source[lineEnd] != 13) lineEnd = lineEnd + 1
        var begin = lineBegin
        while (begin < lineEnd &&
               (source[begin] == 32 || source[begin] == 9)) begin = begin + 1
        var keyMatches = begin + key.size <= lineEnd
        var keyIndex = 0
        while (keyMatches && keyIndex < key.size) {
            if (source[begin + keyIndex] != key[keyIndex]) {
                keyMatches = false
            }
            keyIndex = keyIndex + 1
        }
        var equals = begin + key.size
        while (equals < lineEnd &&
               (source[equals] == 32 || source[equals] == 9)) {
            equals = equals + 1
        }
        if (keyMatches && equals < lineEnd && source[equals] == 61) {
            occurrences = occurrences + 1
            var value = equals + 1
            while (value < lineEnd &&
                   (source[value] == 32 || source[value] == 9)) {
                value = value + 1
            }
            if (occurrences == 1 && value < lineEnd &&
                source[value] == 91) cursor = value + 1
        }
        lineBegin = lineEnd + 1
    }
    val present = occurrences > 0
    var valid = !present || (occurrences == 1 && cursor >= 0)
    var complete = false
    var expectingValue = true
    while (valid && cursor >= 0 && cursor < source.size && !complete) {
        while (cursor < source.size &&
               (source[cursor] == 32 || source[cursor] == 9 ||
                source[cursor] == 10 || source[cursor] == 13)) {
            cursor = cursor + 1
        }
        if (cursor < source.size && source[cursor] == 35) {
            while (cursor < source.size && source[cursor] != 10 &&
                   source[cursor] != 13) cursor = cursor + 1
        } else if (cursor < source.size && source[cursor] == 93) {
            complete = true
        } else if (!expectingValue && cursor < source.size &&
            source[cursor] == 44) {
            cursor = cursor + 1
            expectingValue = true
        } else if (expectingValue && cursor < source.size &&
            source[cursor] == 34) {
            val valueBegin = cursor + 1
            cursor = valueBegin
            while (cursor < source.size && source[cursor] != 34 &&
                   source[cursor] != 10 && source[cursor] != 13) {
                cursor = cursor + 1
            }
            if (cursor < source.size && source[cursor] == 34) {
                values.append(source.slice(valueBegin, cursor))
                cursor = cursor + 1
                expectingValue = false
            } else valid = false
        } else valid = false
    }
    if (present && !complete) valid = false
    BootstrapNativeLibraries(values, valid)
}

// The backend verifies every module it emits (backend.ab). Handed over as bitcode, that
// module reaches opt unchanged, so opt does not verify it again (text may have been patched
// since, and is verified); llc does not verify opt's output, which opt verified as it wrote
// it unless its input was that bitcode. ABLA_LLVM_VERIFY=1 turns both back on.
fun bootstrapLlvmToolsVerify(): bool {
    val configured = linuxEnvironment("ABLA_LLVM_VERIFY")
    configured.found && configured.value == "1"
}

// What a Linux release executable is optimized with, after internalizing it: LLVM 23's
// default<O2>,globaldce as `opt -print-pipeline-passes` writes it, without 20 of its passes
// (2026-11-03). Each was dropped in turn over tests/benchmarks, twice over, then each put
// back in turn over abla-compare's server: four of the eight instcombines (those after the
// inliner's first but one), two of the eight simplifycfgs, three of the four LICMs, sccp,
// loop-unroll and loop-unroll-full, called-value propagation, bdce, adce, loop-instsimplify,
// instsimplify, the second tailcallelim, an infer-alignment, a globals-aa `require` and the
// closing `verify`. opt and llc do 14.2% less work; programs come out 0.3% smaller and run
// 0.1% fewer instructions (none more than 0.1% more), and the server 1.6% fewer a request.
// Those whose removal cost run time or size stay: gvn (nbody 13% slower), indvars (matrix
// 5%), the first sroa, dse, slp-vectorizer; constraint elimination, correlated propagation,
// an instcombine and two simplifycfgs, which the benchmarks didn't miss but the server's
// byte loops did (body-16k 13%); and the first tailcallelim, which no count missed but
// without which fib's recursion became a loop of 15% more cycles. Spelled out, the
// pipeline names LLVM's pass options; an LLVM that can't parse it gets default<O2>,globaldce.
// The two late SROAs also do no useful work on the 13 benchmarks, NovaKind's tool,
// the MVC server and QR (2026-11-04): dropping them keeps all 16 executables exact
// and cuts O2 instructions 0.4–0.65% on those three real programs. Keep both early SROAs.
val BOOTSTRAP_HOST_RELEASE_PASSES =
    "memprof-remove-attributes,annotation2metadata,forceattrs,inferattrs,coro-early," +
    "function<eager-inv>(ee-instrument<>,lower-expect," +
