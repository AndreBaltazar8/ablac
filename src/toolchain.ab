            // LLVM-linked release clients still use external opt, and a
            // textual fallback can use llc. A missing/different tool must
            // not share the object cache of the pinned native toolchain.
            backendIdentity =
                "$backendIdentity\nopt:${bootstrapToolIdentity(bootstrapHostLlvmTool("opt"))}\nllc:${bootstrapToolIdentity(bootstrapHostLlvmTool("llc"))}"
