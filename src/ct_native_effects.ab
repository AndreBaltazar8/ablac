// The compile capabilities of abla/platform/host's providers, for the
// semantic effect analysis (sema.ab) and the evaluator (ct_native.ab).

import "parser.ab"
import "abla/text"

// The compile capability of a host provider (0 when `name` is not one).
fun bootstrapCompileHostProviderEffect(name: string): int {
    if (!name.startsWith("ablaHost")) return 0
    val operation = name.slice(8, name.size)
    if (operation == "ReadFile" || operation == "FileKind" ||
        operation == "FileSize" || operation == "ListDirectory" ||
        operation == "CurrentDirectory" || operation == "FileRevision") return 4
    if (operation == "WriteFile" || operation == "WriteFileAtomic" ||
        operation == "CreateParentDirectories" ||
        operation == "CreateDirectories" || operation == "MoveFile" ||
        operation == "RemoveFile") return 8
    if (operation == "ArgumentCount" || operation == "Argument") return 16
    if (operation == "ReadStdinLine" || operation == "StdinLineAvailable" ||
        operation == "WriteStdout" || operation == "WriteStderr" ||
        operation == "ProcessorCount" || operation == "RunProcess" ||
        operation == "CaptureProcess" || operation == "StartProcess" ||
        operation == "StartProcessConfigured" || operation == "PollProcess" ||
        operation == "StopProcessTree" || operation == "StopProcess" ||
        operation == "StopProcessGracefully") return 32
    if (operation.startsWith("Net") || operation.startsWith("Tls")) return 64
    if (operation == "Sleep" || operation == "MonotonicMilliseconds") return 128
    if (operation == "SecureRandom") return 256
    0
}

// Whether a declaration is one of the host API's providers (a function of the
// standard library's abla/platform/host or abla/platform/host/tls).
fun bootstrapCompileHostProvider(declaration: BootstrapDeclaration): bool {
    if (declaration.kind != "fun" || declaration.extensionOwner != "") {
        return false
    }
    val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
    if (bootstrapCompileHostProviderEffect(name) == 0) return false
    var module = declaration.sourceIdentity
    if (module == "") {
        module = bootstrapCanonicalDeclarationModuleIdentity(declaration.name)
    }
    module.endsWith("abla/platform/host/entry.ab") ||
        module.endsWith("abla/platform/host/tls/entry.ab") ||
        module == "abla/platform/host" || module == "abla/platform/host/tls"
}
