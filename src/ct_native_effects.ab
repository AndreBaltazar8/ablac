// Compile-time providers: standard-library entry points whose compile
// capability is fixed by what they do, not inferred from their bodies (which
// reach system calls and raw memory, i.e. trusted.native). The semantic effect
// analysis (sema.ab) gives such a declaration its capability and does not walk
// its body; the evaluator (ct_native.ab) performs the call with the compiler's
// own copy of the same function, journaling what it observes, and the JIT tier
// bridges the same declarations to the evaluator.
//
// A provider is matched by its module (a file of the standard library), its
// receiver type for an extension method, and its name, so a program's own
// function of the same name is never one.

import "parser.ab"
import "abla/text"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"

// The capability of the provider `name` of `module` ("host", "fs", "io",
// "time") with receiver `owner` ("" for a plain function): an effect bit, 0
// for none (output, the compiler's empty process arguments), -1 when it is
// not a provider.
fun bootstrapCompileProviderEffect(module: string, owner: string, name: string): int {
    if (module == "host" && owner == "") return bootstrapCompileHostOperationEffect(name)
    if (module == "fs" && owner == "Path") {
        if (name == "readText" || name == "readTextResult" || name == "exists" ||
            name == "info" || name == "revision" || name == "isSymbolicLink" ||
            name == "entries") return 4
    }
    // Writes, moves and removals are staged (compilerWriteFile's contract:
    // published on success; ct_native.ab's compile-time file view).
    if (module == "fs" && owner == "Path") {
        if (name == "writeText" || name == "writeTextAtomic" || name == "appendText" ||
            name == "createDirectories" || name == "createParentDirectories" ||
            name == "remove" || name == "moveTo") return 8
    }
    if (module == "fs" && owner == "" && name == "currentDirectory") return 4
    if (module == "io" && owner == "") {
        if (name == "print" || name == "println" || name == "eprint" ||
            name == "eprintln") return 0
        if (name == "readLine") return 32
    }
    if (module == "time" && owner == "") {
        if (name == "sleep" || name == "sleepNanoseconds" ||
            name == "monotonicNanoseconds" || name == "monotonicMilliseconds" ||
            name == "realtimeNanoseconds" || name == "realtimeMilliseconds") return 128
    }
    -1
}

fun bootstrapCompileHostOperationEffect(name: string): int {
    if (!name.startsWith("ablaHost")) return -1
    val operation = name.slice(8, name.size)
    if (operation == "ReadFile" || operation == "FileKind" ||
        operation == "FileSize" || operation == "ListDirectory" ||
        operation == "CurrentDirectory" || operation == "FileRevision") return 4
    if (operation == "WriteFile" || operation == "WriteFileAtomic" ||
        operation == "CreateParentDirectories" ||
        operation == "CreateDirectories" ||
        operation == "MoveFile" || operation == "RemoveFile") return 8
    // A compile-time evaluation is a program the compiler runs with no
    // arguments, and what it writes is output, not an input of the build.
    if (operation == "ArgumentCount" || operation == "Argument" ||
        operation == "WriteStdout" || operation == "WriteStderr") return 0
    if (operation == "ReadStdinLine" || operation == "StdinLineAvailable" ||
        operation == "ProcessorCount" || operation == "RunProcess" ||
        operation == "CaptureProcess" || operation == "StartProcess" ||
        operation == "StartProcessConfigured" || operation == "PollProcess" ||
        operation == "StopProcessTree" || operation == "StopProcess" ||
        operation == "StopProcessGracefully") return 32
    if (operation.startsWith("Net") || operation.startsWith("Tls")) return 64
    if (operation == "Sleep" || operation == "MonotonicMilliseconds") return 128
    if (operation == "SecureRandom") return 256
    -1
}

// The provider module a declaration belongs to ("" for none): its source must
// be the named file of the standard library in use.
var bootstrapCompileProviderRoot: string = ""

fun bootstrapCompileProviderStandardLibrary(): string {
    if (bootstrapCompileProviderRoot == "") {
        val configured = linuxEnvironment("ABLA_STDLIB")
        val sysroot = linuxEnvironment("ABLA_SYSROOT")
        var root = Path(if (sysroot.found && sysroot.value != "") sysroot.value else ".").child("stdlib").text
        if (configured.found && configured.value != "") root = configured.value
        bootstrapCompileProviderRoot = root
    }
    bootstrapCompileProviderRoot
}

fun bootstrapCompileProviderModule(declaration: BootstrapDeclaration): string {
    var source = declaration.sourceIdentity
    if (source == "") source = bootstrapCanonicalDeclarationModuleIdentity(declaration.name)
    val root = bootstrapCompileProviderStandardLibrary()
    var relative = ""
    if (source.startsWith("$root/")) relative = source.slice(root.size + 1, source.size)
    if (relative == "abla/platform/host/entry.ab" ||
        relative == "abla/platform/host/tls/entry.ab") "host"
    else if (relative == "abla/sys/linux/fs/entry.ab") "fs"
    else if (relative == "abla/io/entry.ab") "io"
    else if (relative == "abla/process/time/entry.ab") "time"
    else ""
}

// A declaration's provider capability (-1 when it is not a provider).
fun bootstrapCompileDeclarationProviderEffect(declaration: BootstrapDeclaration): int {
    if (declaration.kind != "fun") return -1
    val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
    // Cheap test first: most declarations are no provider's name.
    if (bootstrapCompileProviderEffect("host", "", name) < 0 &&
        bootstrapCompileProviderEffect("fs", declaration.extensionOwner, name) < 0 &&
        bootstrapCompileProviderEffect("io", declaration.extensionOwner, name) < 0 &&
        bootstrapCompileProviderEffect("time", declaration.extensionOwner, name) < 0) return -1
    val module = bootstrapCompileProviderModule(declaration)
    if (module == "") -1
    else bootstrapCompileProviderEffect(module, declaration.extensionOwner, name)
}

fun bootstrapCompileHostProvider(declaration: BootstrapDeclaration): bool =
    bootstrapCompileDeclarationProviderEffect(declaration) >= 0

// The name the evaluator dispatches a provider by: `name`, or `Owner.name`
// for an extension method (whose receiver is then the call's first child).
fun bootstrapCompileProviderKey(declaration: BootstrapDeclaration): string {
    val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
    if (declaration.extensionOwner == "") name else "${declaration.extensionOwner}.$name"
}

// ---- contained raw memory ----
//
// The standard library implements pure computations (byte buffers, JWT
// parsing) with trusted raw memory. That memory is its own, like the
// runtime's, so it does not make the computation native code: a raw-memory
// operation carries the internal effect BOOTSTRAP_COMPILE_RAW_MEMORY instead
// of trusted.native, and where it lands decides what it means. The
// standard library drops it (contained), its unsafe boundary (abla/unsafe,
// abla/runtime) passes it on to whoever calls in, and a program's own code
// turns it into trusted.native. External C functions, function-pointer calls
// and system calls stay trusted.native everywhere.

val BOOTSTRAP_COMPILE_RAW_MEMORY = 1024

// Raw-memory intrinsics: loads, stores, pointer arithmetic, string storage,
// allocation and atomics.
fun bootstrapCompileRawMemoryIntrinsic(name: string): bool =
    (name.startsWith("ablaUnsafeLoad") || name.startsWith("ablaUnsafeStore") ||
     name.startsWith("ablaUnsafeVolatile") || name.startsWith("ablaUnsafeAtomic")) ||
    name == "ablaUnsafeNullPointer" || name == "ablaUnsafePointerIsNull" ||
    name == "ablaUnsafePointerOffset" || name == "ablaUnsafePointerAddress" ||
    name == "ablaUnsafeSetMemory" || name == "ablaUnsafeCopyMemory" ||
    name == "ablaUnsafeCStringAddress" || name == "ablaUnsafeStringAddress" ||
    name == "ablaUnsafeAdoptString" || name == "ablaUnsafeBorrowCString" ||
    name == "ablaRuntimePointerFromAddress" || name == "ablaRuntimePointerAddress" ||
    name == "nativeStackAllocate"

// Where a source sits for that rule: 0 the program's own code, 1 the
// standard library, 2 its unsafe boundary (abla/unsafe), 3 the runtime.
fun bootstrapCompileSourceClass(source: string): int {
    val root = bootstrapCompileProviderStandardLibrary()
    if (!source.startsWith("$root/")) return 0
    val relative = source.slice(root.size + 1, source.size)
    if (relative.startsWith("abla/unsafe/")) 2
    else if (relative.startsWith("abla/runtime/")) 3
    else 1
}

fun bootstrapCompileDeclarationSourceClass(declaration: BootstrapDeclaration): int {
    var source = declaration.sourceIdentity
    if (source == "") source = bootstrapCanonicalDeclarationModuleIdentity(declaration.name)
    bootstrapCompileSourceClass(source)
}

// What an effect mask means in code of `sourceClass`.
fun bootstrapCompileContainEffects(mask: int, sourceClass: int): int {
    if (sourceClass >= 2 ||
        !bootstrapCompileEffectHas(mask, BOOTSTRAP_COMPILE_RAW_MEMORY)) return mask
    val without = mask - BOOTSTRAP_COMPILE_RAW_MEMORY
    if (sourceClass == 1) without
    else if (bootstrapCompileEffectHas(without, 512)) without
    else without + 512
}
