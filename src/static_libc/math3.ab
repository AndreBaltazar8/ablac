@export("lrintf")
fun libcLrintf(x: f32): int = libcToInteger(m.roundEven(f32ToF64(x)))

@export("llrintf")
fun libcLlrintf(x: f32): int = libcToInteger(m.roundEven(f32ToF64(x)))

// ---- the C99 functions of the inverse hyperbolic, complementary error, IEEE remainder and positive difference families
@export("asinh")
fun libcAsinh(x: f64): f64 {
    val a = m.fabs(x)
    if (x != x || a == 0.0 || a == 1.0 / 0.0) return x
    var r = 0.0
    if (a < 0.000000003725290298461914) return x
    if (a > 268435456.0) r = m.log(a) + 0.6931471805599453
    else r = libcLog1p(a + a * a / (1.0 + m.sqrt(1.0 + a * a)))
    libcCopysign(r, x)
}

@export("acosh")
fun libcAcosh(x: f64): f64 {
    if (x != x || x < 1.0) return libcNaN()
    if (x == 1.0) return 0.0
    if (x > 268435456.0) return m.log(x) + 0.6931471805599453
    val t = x - 1.0
    libcLog1p(t + m.sqrt(2.0 * t + t * t))
}

@export("atanh")
fun libcAtanh(x: f64): f64 {
    val a = m.fabs(x)
    if (x != x || a > 1.0) return libcNaN()
    if (a == 1.0) return libcCopysign(1.0 / 0.0, x)
    if (a < 0.000000003725290298461914) return x
    val r = if (a < 0.5) 0.5 * libcLog1p(2.0 * a + 2.0 * a * a / (1.0 - a)) else 0.5 * libcLog1p(2.0 * a / (1.0 - a))
    libcCopysign(r, x)
}

// erfc: 1 - erf up to 2.5 (the loss of digits there is tolerable: erfc(2.5) is 4e-4), then e^(-x^2) over the continued fraction as erf does.
@export("erfc")
fun libcErfc(x: f64): f64 {
    if (x != x) return x
    if (x < 2.5) return 1.0 - libcErf(x)
    if (x > 27.3) return 0.0
    val x2 = x * x
    val low = m.fma(x, x, 0.0 - x2)
    val gauss = m.exp(0.0 - x2) * (1.0 - low)
    var t = x
    var k = 120
    while (k >= 1) {
        t = x + f64FromInt(k) / 2.0 / t
        k -= 1
    }
    gauss / (1.7724538509055159 * t)
}

@export("fdim")
fun libcFdim(x: f64, y: f64): f64 {
    if (x != x) return x
    if (y != y) return y
    if (x > y) x - y else 0.0
}

// remainder: x - n y with n the integer nearest x / y (a tie to the even one), exact, from fmod by 2|y|.
@export("remainder")
fun libcRemainder(x: f64, y: f64): f64 {
    if (x != x || y != y || m.fabs(x) == 1.0 / 0.0 || y == 0.0) return libcNaN()
    if (m.fabs(y) == 1.0 / 0.0) return x
    val ax = m.fabs(x)
    val ay = m.fabs(y)
    val twice = ay * 2.0
    val r = if (twice == 1.0 / 0.0 || ax < twice) ax else libcFmod(ax, twice)
    val half = ay / 2.0
    var result = r
    if (r > half) {
        // q = r / ay is in (0.5, 2): nearest is 1 below 1.5 (r - ay, exact), else 2 (a tie at 1.5 goes to the even 2).
        val d = r - ay
        result = if (d < half) d else r - twice
    }
    if (result == 0.0) return libcCopysign(0.0, x)
    libcCopysign(result, x)
}

@export("exp10f")
fun libcExp10f(x: f32): f32 = f64ToF32(m.pow(10.0, f32ToF64(x)))

@export("logbf")
fun libcLogbf(x: f32): f32 = f64ToF32(libcLogb(f32ToF64(x)))

@export("roundevenf")
fun libcRoundevenf(x: f32): f32 = f64ToF32(m.roundEven(f32ToF64(x)))

@export("asinhf")
fun libcAsinhf(x: f32): f32 = f64ToF32(libcAsinh(f32ToF64(x)))

@export("acoshf")
fun libcAcoshf(x: f32): f32 = f64ToF32(libcAcosh(f32ToF64(x)))

@export("atanhf")
fun libcAtanhf(x: f32): f32 = f64ToF32(libcAtanh(f32ToF64(x)))

@export("erfcf")
fun libcErfcf(x: f32): f32 = f64ToF32(libcErfc(f32ToF64(x)))

@export("fdimf")
fun libcFdimf(x: f32, y: f32): f32 = f64ToF32(libcFdim(f32ToF64(x), f32ToF64(y)))

@export("remainderf")
fun libcRemainderf(x: f32, y: f32): f32 = f64ToF32(libcRemainder(f32ToF64(x), f32ToF64(y)))

@export("frexpf")
trusted fun libcFrexpf(x: f32, exponent: int): f32 = f64ToF32(libcFrexp(f32ToF64(x), exponent))

@export("modff")
trusted fun libcModff(x: f32, whole: int): f32 {
    val t = m.trunc(f32ToF64(x))
    ablaRuntimeStoreI32(whole, int(f32ToBits(f64ToF32(t))))
    f64ToF32(libcCopysign(f32ToF64(x) - t, f32ToF64(x)))
}

@export("sincosf")
trusted fun libcSincosf(x: f32, sine: int, cosine: int): void {
    ablaRuntimeStoreI32(sine, int(f32ToBits(f64ToF32(m.sin(f32ToF64(x))))))
    ablaRuntimeStoreI32(cosine, int(f32ToBits(f64ToF32(m.cos(f32ToF64(x))))))
    return
}
