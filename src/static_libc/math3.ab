fun libcTruncf(x: f32): f32 = f64ToF32(m.trunc(f32ToF64(x)))

@export("roundf")
fun libcRoundf(x: f32): f32 = f64ToF32(libcRound(f32ToF64(x)))

@export("rintf")
fun libcRintf(x: f32): f32 = f64ToF32(m.roundEven(f32ToF64(x)))

@export("nearbyintf")
fun libcNearbyintf(x: f32): f32 = f64ToF32(m.roundEven(f32ToF64(x)))

@export("fabsf")
fun libcFabsf(x: f32): f32 = f64ToF32(m.fabs(f32ToF64(x)))

@export("fmodf")
