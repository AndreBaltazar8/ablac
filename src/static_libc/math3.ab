// The remaining <math.h> functions an optimiser or a program names (#806 step C, #648): the libcalls LLVM introduces (pow(2, x) becomes exp2,
// the roundings and min/max lower to calls without SSE4.1, fma, fmod, the float forms of everything) and the C99 set the other files left out.
// Double functions are exact (the roundings, fmod, ldexp, frexp, modf, copysign, fmin/fmax, fma, the conversions to integers) or built from the
// standard library's correctly rounded exp, log, pow, sqrt and the functions of math.ab / math2.ab (exp2, exp10, cbrt, expm1, hypot); the float
// forms compute the double result and round it to a float once. No errno or exception flag is set, as in math.ab.
import "abla/math" as m
import "abla/float"
import "abla/runtime/scalar"
import "./math.ab"
import "./math2.ab"
import "./fs.ab"

val libcSignMask = -9223372036854775808
val libcExponentMask = 9218868437227405312
val libcMantissaMask = 4503599627370495

fun libcNaN(): f64 = f64FromBits(9221120237041090560)

@export("copysign")
fun libcCopysign(x: f64, y: f64): f64 = f64FromBits((f64ToBits(x) & 9223372036854775807) | (f64ToBits(y) & libcSignMask))

@export("trunc")
fun libcTrunc(x: f64): f64 = m.trunc(x)

@export("rint")
fun libcRint(x: f64): f64 = m.roundEven(x)

@export("nearbyint")
fun libcNearbyint(x: f64): f64 = m.roundEven(x)

@export("roundeven")
fun libcRoundeven(x: f64): f64 = m.roundEven(x)

// fmin and fmax as glibc has them: the other operand when one is a NaN, else the comparison (equal operands: the second).
@export("fmin")
fun libcFmin(x: f64, y: f64): f64 = if (x < y || y != y) x else y

@export("fmax")
fun libcFmax(x: f64, y: f64): f64 = if (x > y || y != y) x else y

@export("fma")
fun libcFma(x: f64, y: f64, z: f64): f64 = m.fma(x, y, z)

@export("hypot")
fun libcHypot(x: f64, y: f64): f64 = m.hypot(x, y)

@export("exp2")
fun libcExp2(x: f64): f64 = m.pow(2.0, x)

@export("exp10")
fun libcExp10(x: f64): f64 = m.pow(10.0, x)

@export("expm1")
fun libcExpm1Export(x: f64): f64 {
    if (x != x) return x
    if (x > 709.78) return 1.0 / 0.0
    if (x < -40.0) return -1.0
    libcExpm1(x)
}

// cbrt: FreeBSD's (a polynomial estimate, one Newton step: below 0.667 ulp).
@export("cbrt")
fun libcCbrt(x: f64): f64 {
    val bits = f64ToBits(x)
    val sign = bits & libcSignMask
    val high = (bits >>> 32) & 2147483647
    if (high >= 2146435072) return x + x
    if (high < 1048576) {
        // zero or subnormal: scale by 2^54, which the result undoes by 2^-18
        if ((bits & 9223372036854775807) == 0) return x
        val magnitude = m.fabs(x) * 18014398509481984.0
        val scaledHigh = (f64ToBits(magnitude) >>> 32) & 2147483647
        return libcCbrtStep(magnitude, f64FromBits((scaledHigh / 3 + 696219795) << 32), sign, true)
    }
    libcCbrtStep(m.fabs(x), f64FromBits((high / 3 + 715094163) << 32), sign, false)
}

// The estimate refined to 23 bits by the polynomial, rounded away from zero, then one Newton step.
fun libcCbrtStep(target: f64, estimate: f64, sign: int, scaled: bool): f64 {
    val r = (estimate * estimate) * (estimate / target)
    var t = estimate * ((1.87595182427177009643 + r * (-1.88497979543377169875 + r * 1.621429720105354466140)) +
        ((r * r) * r) * (-0.758397934778766047437 + r * 0.145996192886612446982))
    t = f64FromBits((f64ToBits(t) + 2147483648) & -1073741824)
    val s = t * t
    val q = target / s
    val w = t + t
    t = t + t * ((q - t) / (w + q))
    // One more correction with the exact residual (the fma gives target - s t and the rounding error of s = t t exactly): the root is then within
    // a few units of 2^-60, so the result is the correctly rounded one all but very rarely.
    val s2 = t * t
    val tail = m.fma(t, t, 0.0 - s2)
    val residual = m.fma(0.0 - s2, t, target) - tail * t
    t = t + residual / (3.0 * s2)
    if (scaled) t = t / 262144.0
    f64FromBits(f64ToBits(t) | sign)
}

// fmod: exact, by binary long division of the significands (musl's algorithm).
@export("fmod")
fun libcFmod(x: f64, y: f64): f64 {
    val xb = f64ToBits(x)
    val yb = f64ToBits(y)
    var ex = (xb >>> 52) & 2047
    var ey = (yb >>> 52) & 2047
    val sx = xb >>> 63
    if ((yb << 1) == 0 || y != y || ex == 2047) return (x * y) / (x * y)
    val ax = xb & 9223372036854775807
    val ay = yb & 9223372036854775807
    if (ax <= ay) {
        if (ax == ay) return 0.0 * x
        return x
    }
    var mx = 0
    var my = 0
    if (ex == 0) {
        // subnormal x: shift the significand up until bit 52 is set, lowering the exponent accordingly.
        mx = ax
        ex = 1
        while (mx < 4503599627370496) {
            mx = mx << 1
            ex = ex - 1
        }
    } else mx = (ax & libcMantissaMask) | 4503599627370496
    if (ey == 0) {
        my = ay
        ey = 1
        while (my < 4503599627370496) {
            my = my << 1
            ey = ey - 1
        }
    } else my = (ay & libcMantissaMask) | 4503599627370496
    while (ex > ey) {
        val d = mx - my
        if (d >= 0) {
            if (d == 0) return 0.0 * x
            mx = d
        }
        mx = mx << 1
        ex = ex - 1
    }
    val last = mx - my
    if (last >= 0) {
        if (last == 0) return 0.0 * x
        mx = last
    }
    while (mx < 4503599627370496) {
        mx = mx << 1
        ex = ex - 1
    }
    var out = 0
    if (ex > 0) out = (mx - 4503599627370496) | (ex << 52) else out = mx >>> (1 - ex)
    f64FromBits(out | (sx << 63))
}

// ldexp: musl's scalbn, the scale applied in at most three exact or single-rounding steps.
@export("ldexp")
fun libcLdexp(x: f64, count: int): f64 {
    var n = libcInt(count)
    var y = x
    if (n > 1023) {
        y = y * 8.98846567431158e307
        n = n - 1023
        if (n > 1023) {
            y = y * 8.98846567431158e307
            n = n - 1023
            if (n > 1023) n = 1023
        }
    } else if (n < -1022) {
        y = y * 2.2250738585072014e-308 * 9007199254740992.0
        n = n + 1022 - 53
        if (n < -1022) {
            y = y * 2.2250738585072014e-308 * 9007199254740992.0
            n = n + 1022 - 53
            if (n < -1022) n = -1022
        }
    }
    y * f64FromBits((1023 + n) << 52)
}

@export("frexp")
trusted fun libcFrexp(x: f64, exponent: int): f64 {
    ablaRuntimeStoreI32(exponent, 0)
    var bits = f64ToBits(x)
    var e = (bits >>> 52) & 2047
    if (x != x || e == 2047 || (bits & 9223372036854775807) == 0) return x
    var adjust = 0
    if (e == 0) {
        bits = f64ToBits(x * 18014398509481984.0)
        e = (bits >>> 52) & 2047
        adjust = -54
    }
    ablaRuntimeStoreI32(exponent, e - 1022 + adjust)
    f64FromBits((bits & -9218868437227405313) | 4602678819172646912)
}

@export("modf")
trusted fun libcModf(x: f64, whole: int): f64 {
    if (x != x) {
        ablaRuntimeStoreI64(whole, f64ToBits(x))
        return x
    }
    if (m.fabs(x) == 1.0 / 0.0) {
        ablaRuntimeStoreI64(whole, f64ToBits(x))
        return libcCopysign(0.0, x)
    }
    val t = m.trunc(x)
    ablaRuntimeStoreI64(whole, f64ToBits(t))
    libcCopysign(x - t, x)
}

@export("sincos")
trusted fun libcSincos(x: f64, sine: int, cosine: int): void {
    ablaRuntimeStoreI64(sine, f64ToBits(m.sin(x)))
    ablaRuntimeStoreI64(cosine, f64ToBits(m.cos(x)))
    return
}

// The conversions to integers: out of range (or NaN) is the integer minimum, as the x86-64 instruction gives it.
@export("lround")
fun libcLround(x: f64): int = libcToInteger(libcRound(x))

@export("llround")
fun libcLlround(x: f64): int = libcToInteger(libcRound(x))

@export("lrint")
fun libcLrint(x: f64): int = libcToInteger(m.roundEven(x))

@export("llrint")
fun libcLlrint(x: f64): int = libcToInteger(m.roundEven(x))

fun libcToInteger(x: f64): int {
    if (x != x || x >= 9223372036854775808.0 || x < -9223372036854775808.0) return -9223372036854775808
    f64ToInt(x)
}

// ---- the float forms
@export("sinf")
fun libcSinf(x: f32): f32 = f64ToF32(m.sin(f32ToF64(x)))

