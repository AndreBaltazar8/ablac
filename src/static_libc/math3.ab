@export("expm1f")
fun libcExpm1f(x: f32): f32 = f64ToF32(libcExpm1Export(f32ToF64(x)))

@export("logf")
fun libcLogf(x: f32): f32 = f64ToF32(m.log(f32ToF64(x)))

