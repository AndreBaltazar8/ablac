fun libcFminf(x: f32, y: f32): f32 = if (x < y || y != y) x else y

@export("fmaxf")
fun libcFmaxf(x: f32, y: f32): f32 = if (x > y || y != y) x else y

@export("copysignf")
fun libcCopysignf(x: f32, y: f32): f32 =
    f32FromBits(u32((int(f32ToBits(x)) & 2147483647) | (int(f32ToBits(y)) & 2147483648)))

@export("ldexpf")
fun libcLdexpf(x: f32, count: int): f32 = f64ToF32(libcLdexp(f32ToF64(x), count))

