// The wide-character strftime (#806 step C): __wcsftime_l(buffer, size, format, tm, locale) is strftime over wchar_t (four bytes). The format's
// conversions are the ones strftime knows (time.ab), each formatted by it on a two-character format of its own, and every other wide character
// of the format is copied through, so a format with characters beyond ASCII keeps them. It returns the wide characters written without the
// terminator, or 0 when the result and its terminator do not fit in `size`.
import "abla/runtime/scalar"
import "./time.ab"
import "./memory.ab"

@export("__wcsftime_l")
trusted fun libcWcsftimeL(buffer: int, size: int, format: int, tm: int, locale: int): int {
    val scratch = libcMalloc(8)
    if (scratch == 0) return 0
    var written = 0
    var at = 0
    var fits = true
    while (fits && ablaRuntimeLoadI32(format + at * 4) != 0) {
        val unit = ablaRuntimeLoadI32(format + at * 4)
        if (unit == 37 && ablaRuntimeLoadI32(format + at * 4 + 4) != 0) {
            val code = ablaRuntimeLoadI32(format + at * 4 + 4)
            at += 2
            ablaRuntimeStoreU8(scratch, 37)
            ablaRuntimeStoreU8(scratch + 1, code & 255)
            ablaRuntimeStoreU8(scratch + 2, 0)
            val text = libcFormatTime(scratch, tm)
            if (code > 127) {
                // A conversion character beyond ASCII is copied as it was written.
                if (written + 2 >= size) fits = false
                else {
                    ablaRuntimeStoreI32(buffer + written * 4, 37)
                    ablaRuntimeStoreI32(buffer + written * 4 + 4, code)
                    written += 2
                }
            } else if (written + text.size >= size) {
                fits = false
            } else {
                var i = 0
                while (i < text.size) {
                    ablaRuntimeStoreI32(buffer + (written + i) * 4, text[i])
                    i += 1
                }
                written += text.size
            }
        } else {
            at += 1
            if (written + 1 >= size) fits = false
            else {
                ablaRuntimeStoreI32(buffer + written * 4, unit)
                written += 1
            }
        }
    }
    libcFree(scratch)
    if (!fits || size == 0) return 0
    ablaRuntimeStoreI32(buffer + written * 4, 0)
    written
}
