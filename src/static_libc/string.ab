// The string and character functions of the statically linked compiler's C library (#806 step C), in the C locale: bytes are characters, the
// classification is ASCII. The memory routines (memcpy and the others) are the backend's own hidden ones.
import "abla/runtime/scalar"
import "abla/unsafe/native"
import "./memory.ab"
import "./fs.ab"
import "./errno.ab"
import "abla/unsafe/memory/raw"

@export("strlen")
trusted fun libcStrlen(text: int): int {
    var at = 0
    while (ablaRuntimeLoadU8(text + at) != 0) at = at + 1
    at
}

@export("memchr")
trusted fun libcMemchr(text: int, byte: int, count: int): int {
    val wanted = byte & 255
    var at = 0
    while (at < count) {
        if (ablaRuntimeLoadU8(text + at) == wanted) return text + at
        at = at + 1
    }
    0
}

@export("strchr")
trusted fun libcStrchr(text: int, byte: int): int {
    val wanted = byte & 255
    var at = 0
    while (true) {
        val found = ablaRuntimeLoadU8(text + at)
        if (found == wanted) return text + at
        if (found == 0) return 0
        at = at + 1
    }
    0
}

@export("strcmp")
trusted fun libcStrcmp(left: int, right: int): int {
    var at = 0
    while (true) {
        val a = ablaRuntimeLoadU8(left + at)
        val b = ablaRuntimeLoadU8(right + at)
        if (a != b) return a - b
        if (a == 0) return 0
        at = at + 1
    }
    0
}

@export("strncmp")
trusted fun libcStrncmp(left: int, right: int, count: int): int {
    var at = 0
    while (at < count) {
        val a = ablaRuntimeLoadU8(left + at)
        val b = ablaRuntimeLoadU8(right + at)
        if (a != b) return a - b
        if (a == 0) return 0
        at = at + 1
    }
    0
}

@export("strncpy")
trusted fun libcStrncpy(destination: int, source: int, count: int): int {
    var at = 0
    while (at < count && ablaRuntimeLoadU8(source + at) != 0) {
        ablaRuntimeStoreU8(destination + at, ablaRuntimeLoadU8(source + at))
        at = at + 1
    }
    while (at < count) {
        ablaRuntimeStoreU8(destination + at, 0)
        at = at + 1
    }
    destination
}

@export("strdup")
trusted fun libcStrdup(text: int): int {
    val size = libcStrlen(text) + 1
    val copy = libcMalloc(size)
    if (copy == 0) return 0
    var at = 0
    while (at < size) {
        ablaRuntimeStoreU8(copy + at, ablaRuntimeLoadU8(text + at))
        at = at + 1
    }
    copy
}

// The C locale's classification: the argument is an unsigned char value or EOF.
@export("isalpha")
fun libcIsalpha(c: int): int {
    val x = c & 4294967295
    if ((x >= 65 && x <= 90) || (x >= 97 && x <= 122)) 1 else 0
}

@export("isalnum")
fun libcIsalnum(c: int): int {
    val x = c & 4294967295
    if ((x >= 48 && x <= 57) || (x >= 65 && x <= 90) || (x >= 97 && x <= 122)) 1 else 0
}

@export("isspace")
fun libcIsspace(c: int): int {
    val x = c & 4294967295
    if (x == 32 || (x >= 9 && x <= 13)) 1 else 0
}

@export("isxdigit")
fun libcIsxdigit(c: int): int {
    val x = c & 4294967295
    if ((x >= 48 && x <= 57) || (x >= 65 && x <= 70) || (x >= 97 && x <= 102)) 1 else 0
}

@export("tolower")
fun libcTolower(c: int): int {
    val x = c & 4294967295
    if (x >= 65 && x <= 90) x + 32 else x
}

// qsort: an introsort (below), the comparison called through the C function pointer. A swap goes 8 bytes a step.
trusted fun libcSwap(base: int, size: int, a: int, b: int): void {
    val left = base + a * size
    val right = base + b * size
    var at = 0
    while (at + 8 <= size) {
        val x = ablaRuntimeLoadI64(left + at)
        ablaRuntimeStoreI64(left + at, ablaRuntimeLoadI64(right + at))
        ablaRuntimeStoreI64(right + at, x)
        at = at + 8
    }
    while (at < size) {
        val x = ablaRuntimeLoadU8(left + at)
        ablaRuntimeStoreU8(left + at, ablaRuntimeLoadU8(right + at))
        ablaRuntimeStoreU8(right + at, x)
        at = at + 1
    }
    return
}

trusted fun libcSiftDown(base: int, size: int, compare: int, start: int, end: int): void {
    var root = start
    while (root * 2 + 1 <= end) {
        var child = root * 2 + 1
        // The comparator returns a C int in eax; the upper half of the word is undefined: take its low 32 bits, signed.
        if (child + 1 <= end &&
            libcInt(ablaUnsafeCallAddressPointerPointer(compare, ablaRuntimePointerFromAddress(base + child * size),
                ablaRuntimePointerFromAddress(base + (child + 1) * size))) < 0) child = child + 1
        if (libcInt(ablaUnsafeCallAddressPointerPointer(compare, ablaRuntimePointerFromAddress(base + root * size),
                ablaRuntimePointerFromAddress(base + child * size))) < 0) {
            libcSwap(base, size, root, child)
            root = child
        } else return
    }
    return
}

// qsort: heapsort over `count` elements from `base`, in place (the introsort's fallback when its partitions go bad).
trusted fun libcHeapsort(base: int, count: int, size: int, compare: int): void {
    if (count < 2) return
    var start = (count - 2) / 2
    while (start >= 0) {
        libcSiftDown(base, size, compare, start, count - 1)
        start = start - 1
    }
    var end = count - 1
    while (end > 0) {
        libcSwap(base, size, end, 0)
        end = end - 1
        libcSiftDown(base, size, compare, 0, end)
    }
    return
}

trusted fun libcCompareAt(base: int, size: int, compare: int, a: int, b: int): int =
    libcInt(ablaUnsafeCallAddressPointerPointer(compare, ablaRuntimePointerFromAddress(base + a * size),
        ablaRuntimePointerFromAddress(base + b * size)))

// Insertion sort of the elements lo to hi (inclusive).
trusted fun libcInsertionSort(base: int, size: int, compare: int, lo: int, hi: int): void {
    var i = lo + 1
    while (i <= hi) {
        var j = i
        while (j > lo && libcCompareAt(base, size, compare, j - 1, j) > 0) {
            libcSwap(base, size, j - 1, j)
            j = j - 1
        }
        i = i + 1
    }
    return
}

// Quicksort of the elements lo to hi (inclusive): the median of three as the pivot, the smaller side by recursion and the larger by the loop, insertion sort for 16 or
// fewer, heapsort once `depth` partitions have gone by (so no input takes more than n log n).
trusted fun libcQuicksort(base: int, size: int, compare: int, lo: int, hi: int, depth: int): void {
    var low = lo
    var high = hi
    var budget = depth
    while (high - low > 16) {
        if (budget == 0) {
            libcHeapsort(base + low * size, high - low + 1, size, compare)
            return
        }
        budget = budget - 1
        val middle = low + (high - low) / 2
        if (libcCompareAt(base, size, compare, low, middle) > 0) libcSwap(base, size, low, middle)
        if (libcCompareAt(base, size, compare, middle, high) > 0) {
            libcSwap(base, size, middle, high)
            if (libcCompareAt(base, size, compare, low, middle) > 0) libcSwap(base, size, low, middle)
        }
        // The pivot goes next to the end; the elements at low and high bound the scans.
        libcSwap(base, size, middle, high - 1)
        val pivot = high - 1
        var i = low
        var j = high - 1
        var scanning = true
        while (scanning) {
            // The scans stop at the partition's ends whatever the comparator says: one that is not consistent (a < b and b < a, or no element
            // ever greater than the pivot) would otherwise walk past them, reading and swapping outside the array (the class glibc's qsort fixed in 2024).
            i = i + 1
            while (i < high && libcCompareAt(base, size, compare, i, pivot) < 0) i = i + 1
            j = j - 1
            while (j > low && libcCompareAt(base, size, compare, j, pivot) > 0) j = j - 1
            if (i >= j) scanning = false else libcSwap(base, size, i, j)
        }
        libcSwap(base, size, i, pivot)
        if (i - low < high - i) {
            libcQuicksort(base, size, compare, low, i - 1, budget)
            low = i + 1
        } else {
            libcQuicksort(base, size, compare, i + 1, high, budget)
            high = i - 1
        }
    }
    libcInsertionSort(base, size, compare, low, high)
    return
}

@export("qsort")
trusted fun libcQsort(base: int, count: int, size: int, compare: int): void {
    if (count < 2) return
    var depth = 0
    var span = count
    while (span > 1) {
        depth = depth + 2
        span = span / 2
    }
    libcQuicksort(base, size, compare, 0, count - 1, depth)
    return
}

// strtol and its relatives in the C locale (the __isoc23_ names are glibc's C23 binary-prefix variants: 0b is accepted the same way here
// as glibc does; the plain names are the pre-C23 ones, with no 0b). Returns the value; *end is set when it is not NULL. Out of range the result is the type's limit (LONG_MAX, LONG_MIN, ULONG_MAX);
// ERANGE is not reported.
trusted fun libcStrto(text: int, end: int, base: int, signed: bool, binary: bool): int {
    var at = 0
    while (libcIsspace(ablaRuntimeLoadU8(text + at)) != 0) at = at + 1
    var negative = false
    val sign = ablaRuntimeLoadU8(text + at)
    if (sign == 45 || sign == 43) {
        negative = sign == 45
        at = at + 1
    }
    var radix = base & 4294967295
    if (radix == 1 || radix > 36) {
        libcSetErrno(22)
        return 0
    }
    val start = at
    if ((radix == 0 || radix == 16) && ablaRuntimeLoadU8(text + at) == 48 && (ablaRuntimeLoadU8(text + at + 1) | 32) == 120 &&
        libcDigitValue(ablaRuntimeLoadU8(text + at + 2)) < 16) {
        at = at + 2
        radix = 16
    } else if (binary && (radix == 0 || radix == 2) && ablaRuntimeLoadU8(text + at) == 48 && (ablaRuntimeLoadU8(text + at + 1) | 32) == 98 &&
        libcDigitValue(ablaRuntimeLoadU8(text + at + 2)) < 2) {
        at = at + 2
        radix = 2
    } else if (radix == 0) radix = if (ablaRuntimeLoadU8(text + at) == 48) 8 else 10
    // The magnitude in an unsigned 64-bit word, with the overflow noted.
    var value = u64(0)
    var digits = 0
    var overflow = false
    val unit = u64(radix)
    val ceiling = u64(18446744073709551615)
    while (true) {
        val digit = libcDigitValue(ablaRuntimeLoadU8(text + at))
        if (digit >= radix) break
        if (value > (ceiling - u64(digit)) / unit) overflow = true
        else value = value * unit + u64(digit)
        digits = digits + 1
        at = at + 1
    }
    if (end != 0) ablaRuntimeStoreI64(end, if (digits == 0) text else text + at)
    if (digits == 0) return 0
    if (signed) {
        // LONG_MAX is 2^63 - 1 and LONG_MIN's magnitude 2^63.
        val limit = if (negative) u64(9223372036854775808) else u64(9223372036854775807)
        if (overflow || value > limit) {
            libcSetErrno(34)
            return if (negative) -9223372036854775808 else 9223372036854775807
        }
        return if (negative) 0 - int(value) else int(value)
    }
    if (overflow) {
        libcSetErrno(34)
        return -1
    }
    if (negative) 0 - int(value) else int(value)
}

// The value of a digit character in any base up to 36, 99 for a character that is none.
fun libcDigitValue(c: int): int {
    if (c >= 48 && c <= 57) return c - 48
    if (c >= 97 && c <= 122) return c - 87
    if (c >= 65 && c <= 90) return c - 55
    99
}

@export("strtol")
trusted fun libcStrtolPlain(text: int, end: int, base: int): int = libcStrto(text, end, base, true, false)

@export("strtoll")
trusted fun libcStrtollPlain(text: int, end: int, base: int): int = libcStrto(text, end, base, true, false)

@export("strtoul")
trusted fun libcStrtoulPlain(text: int, end: int, base: int): int = libcStrto(text, end, base, false, false)

@export("strtoull")
trusted fun libcStrtoullPlain(text: int, end: int, base: int): int = libcStrto(text, end, base, false, false)

@export("__isoc23_strtol")
trusted fun libcStrtol(text: int, end: int, base: int): int = libcStrto(text, end, base, true, true)

@export("__isoc23_strtoll")
trusted fun libcStrtoll(text: int, end: int, base: int): int = libcStrto(text, end, base, true, true)

@export("__isoc23_strtoul")
trusted fun libcStrtoul(text: int, end: int, base: int): int = libcStrto(text, end, base, false, true)

@export("__isoc23_strtoull")
trusted fun libcStrtoull(text: int, end: int, base: int): int = libcStrto(text, end, base, false, true)

// strerror_r (the XSI form the GNU one reduces to here): "Error N", which is all a diagnostic needs.
@export("strerror_r")
trusted fun libcStrerrorR(code: int, buffer: int, size: int): int {
    val message = "Error ${libcInt(code)}"
    var at = 0
    while (at < message.size && at + 1 < size) {
        ablaRuntimeStoreU8(buffer + at, message[at])
        at = at + 1
    }
    if (size > 0) ablaRuntimeStoreU8(buffer + at, 0)
    buffer
}

@export("strsignal")
trusted fun libcStrsignal(signal: int): int = libcStrdupText("Signal ${libcInt(signal)}")

trusted fun libcStrdupText(text: string): int {
    val copy = libcMalloc(text.size + 1)
    var at = 0
    while (at < text.size) {
        ablaRuntimeStoreU8(copy + at, text[at])
        at = at + 1
    }
    ablaRuntimeStoreU8(copy + at, 0)
    copy
}
