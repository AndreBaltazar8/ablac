// The few stdio functions the statically linked compiler's libraries call (libstdc++'s terminate handler, LLVM's explicit-symbol table): writes
// to a descriptor, unbuffered. The FILE objects themselves (stdin, stdout, stderr) are data symbols of the generated assembly file
// (src/toolchain.ab, static mode): a FILE here is its descriptor number in its first word.
import "abla/runtime/scalar"
import "abla/sys/linux"
import "./string.ab"

trusted fun libcWriteAll(descriptor: int, buffer: int, count: int): void {
    var done = 0
    while (done < count) {
        val written = linuxSyscall3(1, descriptor, buffer + done, count - done)
        if (written <= 0) return
        done = done + written
    }
    return
}

@export("fputs")
trusted fun libcFputs(text: int, file: int): int {
    libcWriteAll(ablaRuntimeLoadI64(file), text, libcStrlen(text))
    1
}

@export("fputc")
trusted fun libcFputc(c: int, file: int): int {
    val cell = __ablaRuntimeHostHeapAllocate(16, true)
    ablaRuntimeStoreU8(cell, c & 255)
    libcWriteAll(ablaRuntimeLoadI64(file), cell, 1)
    __ablaRuntimeHostHeapFree(cell)
    c & 255
}

@export("fwrite")
trusted fun libcFwrite(buffer: int, size: int, count: int, file: int): int {
    libcWriteAll(ablaRuntimeLoadI64(file), buffer, size * count)
    count
}

// puts, putchar and fflush (nothing is buffered): what printf("%s\n") and printf("%c") become under the library-call simplifier.
@export("puts")
trusted fun libcPuts(text: int): int {
    libcWriteAll(1, text, libcStrlen(text))
    val cell = __ablaRuntimeHostHeapAllocate(16, true)
    ablaRuntimeStoreU8(cell, 10)
    libcWriteAll(1, cell, 1)
    __ablaRuntimeHostHeapFree(cell)
    1
}

@export("putchar")
trusted fun libcPutchar(c: int): int {
    val cell = __ablaRuntimeHostHeapAllocate(16, true)
    ablaRuntimeStoreU8(cell, c & 255)
    libcWriteAll(1, cell, 1)
    __ablaRuntimeHostHeapFree(cell)
    c & 255
}

@export("fflush")
fun libcFflush(file: int): int = 0
