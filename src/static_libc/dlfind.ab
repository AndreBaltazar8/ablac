// _dl_find_object (#806 step C): glibc 2.35's lookup of the object holding a code address, which libgcc's unwinder calls first. The static
// compiler has no loaded objects to describe and no unwinder that runs (unwind.ab), so every address is "not found", which is -1 and
// makes the unwinder fall back to its own tables.
@export("_dl_find_object")
fun libcDlFindObject(address: int, result: int): int = -1
