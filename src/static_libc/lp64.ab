// The exports of the statically linked compiler's C library whose C types are LP64's (a 64-bit long, read's size_t count) or whose
// behaviour is glibc's (rand's RAND_MAX of 2^31 - 1, printf's System V and AAPCS64 va_list): the Linux compiler's only (src/orc_main_static.ab). Their bodies are the shared
// modules' (fs.ab, string.ab, ctypestr.ab, format.ab); the Windows compiler without the MSVC C library (src/orc_windows_main_crtfree.ab) exports
// the LLP64 forms of the same names from src/static_libc/windows instead, so the shared modules never export these names themselves.
import "./fs.ab"
import "./string.ab"
import "./ctypestr.ab"
import "./format.ab"

@export("read")
trusted fun libcReadLp64(descriptor: int, buffer: int, count: int): int = libcRead(descriptor, buffer, count)

@export("lseek")
trusted fun libcLseekLp64(descriptor: int, offset: int, whence: int): int = libcLseek(descriptor, offset, whence)

@export("strtol")
trusted fun libcStrtolLp64(text: int, end: int, base: int): int = libcStrtolPlain(text, end, base)

@export("strtoul")
trusted fun libcStrtoulLp64(text: int, end: int, base: int): int = libcStrtoulPlain(text, end, base)

@export("srand")
trusted fun libcSrandLp64(seed: int): void = libcSrand(seed)

@export("rand")
trusted fun libcRandLp64(): int = libcRand()

@export("atol")
trusted fun libcAtolLp64(text: int): int = libcAtol(text)

// printf's va_list entry points (format.ab): the System V x86-64, AAPCS64 and RV64 va_list, never Windows' (whose own are
// windows/io.ab's __stdio_common_* functions; VCRuntime defines a vsnprintf of its own there).
@export("vsnprintf")
trusted fun libcVsnprintfLp64(buffer: int, size: int, format: int, list: int): int = libcVsnprintf(buffer, size, format, list)

@export("abla_libc_vprintf")
trusted fun libcVprintfLp64(format: int, list: int): int = libcVprintf(format, list)

@export("vprintf")
trusted fun libcVprintfPlainLp64(format: int, list: int): int = libcVprintf(format, list)

@export("abla_libc_vfprintf")
trusted fun libcVfprintfLp64(file: int, format: int, list: int): int = libcVfprintf(file, format, list)

@export("vfprintf")
trusted fun libcVfprintfPlainLp64(file: int, format: int, list: int): int = libcVfprintf(file, format, list)

@export("__vfprintf_chk")
trusted fun libcVfprintfChkLp64(file: int, flag: int, format: int, list: int): int = libcVfprintf(file, format, list)

@export("__vprintf_chk")
trusted fun libcVprintfChkLp64(flag: int, format: int, list: int): int = libcVprintf(format, list)
