// What the statically linked compiler's C library has no body for (#806 step C): libcMissing, the abort every function not written yet is
// given, which names the function and ends the process with status 127 so a path that reaches one fails loudly. No function is a stub any
// more; the unwinder's entry points (unwind.ab) still use it, because the compiler's libstdc++ never unwinds.
import "abla/sys/linux"
import "abla/unsafe/memory/raw"

trusted fun libcMissing(name: string): int {
    val message = "ablac: the C library function ${name} is not implemented in Abla's own libc yet (#806)\n"
    linuxSyscall3(1, 2, ablaUnsafeStringAddress(message), message.size)
    linuxSyscall1(231, 127)
    0
}























