// The rest of the statically linked compiler's C library (#806 step C): every function the LLVM and libstdc++ archives reference that is not
// implemented yet is an aborting stub that names itself, so a path that reaches one fails loudly (the families of
// ~/agents-memory/abla/ablac-806-step-c-design.md: printf, locale and wide characters, math, posix_spawn, dlopen, threads, strftime ...). Each moves to
// its own file as it is written; what is still a stub is what is listed here.
import "abla/sys/linux"
import "abla/unsafe/memory/raw"

trusted fun libcMissing(name: string): int {
    val message = "ablac: the C library function ${name} is not implemented in Abla's own libc yet (#806)\n"
    linuxSyscall3(1, 2, ablaUnsafeStringAddress(message), message.size)
    linuxSyscall1(231, 127)
    0
}

@export("__duplocale")
trusted fun libcStub5(): int = libcMissing("__duplocale")

@export("__freelocale")
trusted fun libcStub6(): int = libcMissing("__freelocale")

