// The stack protector's failure hook (#806 step C): code built with -fstack-protector calls __stack_chk_fail when a function's canary changed
// on return. As glibc does, it writes one line to standard error and aborts (SIGABRT, then exit status 134 if the signal is handled).
import "abla/runtime/scalar"
import "abla/sys/linux"
import "abla/unsafe/memory/raw"
import "./process.ab"

@export("__stack_chk_fail")
trusted fun libcStackChkFail(): void {
    val message = "*** stack smashing detected ***: terminated\n"
    linuxSyscall3(1, 2, ablaUnsafeStringAddress(message), message.size)
    libcAbort()
    return
}
