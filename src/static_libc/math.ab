// The math functions of the statically linked compiler's C library (#806 step C, step 7): the ones LLVM's constant folder and library-call
// simplifier call at compile time, over the standard library's own routines (abla/math: correctly rounded exp, log, pow, sin, cos, tan, atan,
// atan2, and the hardware's sqrt, floor, ceil), so folding a constant needs nothing from a C library. A function an Abla program cannot
// call (the standard library has no sinh, erf, ...) stays an aborting stub in stubs.ab until it has a port. Not here: fenv (no exception flags).
import "abla/math" as m

@export("sqrt")
fun libcSqrt(x: f64): f64 = m.sqrt(x)

@export("floor")
fun libcFloor(x: f64): f64 = m.floor(x)

@export("ceil")
fun libcCeil(x: f64): f64 = m.ceil(x)

@export("fabs")
fun libcFabs(x: f64): f64 = m.fabs(x)

@export("exp")
fun libcExp(x: f64): f64 = m.exp(x)

@export("log")
fun libcLog(x: f64): f64 = m.log(x)

@export("pow")
fun libcPow(x: f64, y: f64): f64 = m.pow(x, y)

@export("sin")
fun libcSin(x: f64): f64 = m.sin(x)

@export("cos")
fun libcCos(x: f64): f64 = m.cos(x)

@export("tan")
fun libcTan(x: f64): f64 = m.tan(x)

@export("atan")
fun libcAtan(x: f64): f64 = m.atan(x)

@export("atan2")
fun libcAtan2(y: f64, x: f64): f64 = m.atan2(y, x)

// round: halves away from zero (the hardware rounds to even).
@export("round")
fun libcRound(x: f64): f64 {
    val t = m.trunc(x)
    val difference = m.fabs(x - t)
    if (difference >= 0.5) (if (x < 0.0) t - 1.0 else t + 1.0) else t
}

// No floating-point exception flags are kept.
@export("feclearexcept")
fun libcFeclearexcept(mask: int): int = 0

@export("fetestexcept")
fun libcFetestexcept(mask: int): int = 0
