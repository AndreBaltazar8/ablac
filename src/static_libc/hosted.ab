// What the JIT'd hosted programs and compile-time C calls need from a C library, beyond what LLVM and libstdc++ do (#806 step C, step 8): the
// hosted runtime Abla emits for `ablac run`, the REPL and the compile-time jit tier uses pthread keys, mutex and condition initialisation, itimers,
// signal(), utimes, link; and a program's compile-time `extern:"c"` calls reach the ISO C functions they name (abs, labs, waitpid, mmap ...).
// Every export here is abla_libc_NAME and the link binds NAME to it by --defsym (src/toolchain.ab, bootstrapStaticLibcAliases), because the
// compiler's own module may declare the same C name as an import. A shared object of the program's own (nativeLibraries) cannot be loaded.
import "abla/runtime/scalar"
import "abla/sys/linux"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native"
import "./errno.ab"
import "./fs.ab"
import "./string.ab"

// Mutexes and condition variables start zeroed (glibc's static initialiser): the attribute (recursive) is read when it is given.
@export("abla_libc_pthread_mutex_init")
trusted fun libcMutexInit(mutex: int, attributes: int): int {
    var at = 0
    while (at < 5) {
        ablaRuntimeStoreI64(mutex + at * 8, 0)
        at = at + 1
    }
    // The attribute's kind is its first int (PTHREAD_MUTEX_RECURSIVE is 1): copied to the mutex's kind word.
    if (attributes != 0) ablaRuntimeStoreI32(mutex + 16, ablaRuntimeLoadI32(attributes))
    0
}

@export("abla_libc_pthread_mutex_destroy")
fun libcMutexDestroy(mutex: int): int = 0

@export("abla_libc_pthread_cond_init")
trusted fun libcCondInit(condition: int, attributes: int): int {
    var at = 0
    while (at < 6) {
        ablaRuntimeStoreI64(condition + at * 8, 0)
        at = at + 1
    }
    0
}

// Thread-specific data: 128 keys. Each key has a word that is 0 while it is free and its generation (odd, counting up) while it is in use, in
// static storage (no first-use race); a key is claimed by a compare-and-swap of its word. Each thread's values are a table of its own (the
// generation and the value for each key, 16 bytes a key) behind a thread-local cell, made the first time the thread sets one: a value counts only
// while its generation is the key's, so deleting a key (its word cleared) and creating it again forgets every thread's value without visiting
// the threads. (The values used to live in one table of 256 rows found by the thread id modulo 256, which gave threads whose ids differed by
// a multiple of 256 each other's values.) Destructors are not run.
trusted fun libcKeyWords(): int = nativeStaticAllocate(128 * 4)

// The last generation given out, for all keys (31 bits: about a billion creations before one repeats).
trusted fun libcKeyGenerationCell(): int = nativeStaticAllocate(4)

trusted fun libcThreadValuesCell(): int = nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00")

// The generation of `key` while it is in use, 0 for a free key or one out of range.
trusted fun libcKeyGeneration(key: int): int {
    if (key < 0 || key >= 128) return 0
    val word = ablaRuntimeLoadI32(libcKeyWords() + key * 4) & 4294967295
    ablaUnsafeAtomicFence()
    word
}

@export("abla_libc_pthread_key_create")
trusted fun libcKeyCreate(key: int, destructor: int): int {
    var slot = 0
    while (slot < 128) {
        if ((ablaRuntimeLoadI32(libcKeyWords() + slot * 4) & 4294967295) == 0) {
            // A new generation, odd so it is never 0 and never one a deleted key's values carry.
            var generation = 0
            var claimed = false
            while (!claimed) {
                val last = ablaRuntimeLoadI32(libcKeyGenerationCell()) & 4294967295
                generation = ((last + 2) | 1) & 2147483647
                claimed = i64(ablaUnsafeAtomicCompareExchangeU32(libcKeyGenerationCell(), u32(last), u32(generation))) == last
            }
            if (i64(ablaUnsafeAtomicCompareExchangeU32(libcKeyWords() + slot * 4, u32(0), u32(generation))) == 0) {
                ablaRuntimeStoreI32(key, slot)
                return 0
            }
        }
        slot = slot + 1
    }
    11
}

@export("abla_libc_pthread_key_delete")
trusted fun libcKeyDelete(key: int): int {
    val slot = libcInt(key)
    val generation = libcKeyGeneration(slot)
    if (generation == 0) return 22
    ablaUnsafeAtomicCompareExchangeU32(libcKeyWords() + slot * 4, u32(generation), u32(0))
    0
}

@export("abla_libc_pthread_setspecific")
trusted fun libcSetspecific(key: int, value: int): int {
    val slot = libcInt(key)
    val generation = libcKeyGeneration(slot)
    if (generation == 0) return 22
    var values = ablaRuntimeLoadI64(libcThreadValuesCell())
    if (values == 0) {
        values = __ablaRuntimeHostHeapAllocate(128 * 16, true)
        if (values == 0) return 12
        ablaRuntimeStoreI64(libcThreadValuesCell(), values)
    }
    ablaRuntimeStoreI64(values + slot * 16, generation)
    ablaRuntimeStoreI64(values + slot * 16 + 8, value)
    0
}

@export("abla_libc_pthread_getspecific")
trusted fun libcGetspecific(key: int): int {
    val slot = libcInt(key)
    val generation = libcKeyGeneration(slot)
    val values = ablaRuntimeLoadI64(libcThreadValuesCell())
    if (generation == 0 || values == 0 || ablaRuntimeLoadI64(values + slot * 16) != generation) return 0
    ablaRuntimeLoadI64(values + slot * 16 + 8)
}

@export("abla_libc_setitimer")
trusted fun libcSetitimer(which: int, value: int, previous: int): int = libcResult(linuxSyscall3(38, libcInt(which), value, previous))

// signal(): the handler is installed through no sigaction (the compiler keeps its own stack guard): the previous disposition reads as default.
@export("abla_libc_signal")
fun libcSignal(signal: int, handler: int): int = 0

@export("abla_libc_utimes")
trusted fun libcUtimes(path: int, times: int): int = libcResult(linuxSyscall2(235, path, times))

@export("abla_libc_link")
trusted fun libcLink(from: int, to: int): int = libcResult(linuxSyscall2(86, from, to))

@export("abla_libc_waitpid")
trusted fun libcWaitpid(process: int, status: int, options: int): int =
    libcResult(linuxSyscall4(61, libcInt(process), status, libcInt(options), 0))

// The integer helpers of <stdlib.h>.
@export("abla_libc_abs")
fun libcAbs(value: int): int {
    val x = libcInt(value)
    if (x < 0) 0 - x else x
}

@export("abla_libc_labs")
fun libcLabs(value: int): int = if (value < 0) 0 - value else value

@export("abla_libc_llabs")
fun libcLlabs(value: int): int = if (value < 0) 0 - value else value

// atoi is (int) strtol: the long saturates first (glibc), then the low 32 bits are the int, so a text past LONG_MAX reads as -1.
@export("abla_libc_atoi")
trusted fun libcAtoi(text: int): int = libcStrto(text, 0, 10, true, false)
