// dlopen and dlsym for the statically linked compiler (#806 step C, the JIT's process symbols). LLVM's ORC finds the symbols of the running process
// through dlopen(NULL) and dlsym (sys::DynamicLibrary), which a static executable has no loader for; here the process is this image, and its symbols are
// the table the generated assembly file holds (src/toolchain.ab, bootstrapStaticLibcData): every C library function this library defines, the
// runtime's memory and jump routines (hidden, so not otherwise findable) and __emutls_get_address, sorted by name. dlopen of a real shared object
// fails (there is no loader: compile-time nativeLibraries are not available in the static compiler, decision #88).
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "./errno.ab"
import "./fs.ab"
import "./string.ab"

// The table: pairs of (NUL-terminated name, address) sorted by name, and their number (assembly, bootstrapStaticLibcData).
trusted noescape extern:"c" fun abla_libc_symbols_address(): int
trusted noescape extern:"c" fun abla_libc_symbols_count(): int

// The handle for the running program: dlopen(NULL) and dlopen("").
val libcSelfHandle = 1

@export("abla_libc_dlopen")
trusted fun libcDlopen(path: int, mode: int): int {
    if (path == 0 || ablaRuntimeLoadU8(path) == 0) return libcSelfHandle
    libcSetErrno(2)
    0
}

@export("abla_libc_dlsym")
trusted fun libcDlsym(handle: int, name: int): int {
    val table = abla_libc_symbols_address()
    var low = 0
    var high = abla_libc_symbols_count()
    while (low < high) {
        val middle = (low + high) / 2
        val order = libcInt(libcStrcmp(ablaRuntimeLoadI64(table + middle * 16), name))
        if (order == 0) return ablaRuntimeLoadI64(table + middle * 16 + 8)
        if (order < 0) low = middle + 1 else high = middle
    }
    0
}

@export("dlclose")
trusted fun libcDlclose(handle: int): int = 0

@export("dlerror")
trusted fun libcDlerror(): int = ablaUnsafeStringAddress("shared objects cannot be loaded: this is a statically linked program\0")

// A marker the compiler's diagnostics look up (src/ct_native.ab): the symbol exists only in the statically linked compiler.
@export("ablac_static_libc")
fun libcStaticMarker(): int = 1
