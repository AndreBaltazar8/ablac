// printf for the statically linked compiler's C library (#806 step C, the printf family): vsnprintf over the System V x86-64 va_list, and the
// variadic entry points (snprintf, sprintf, __printf_chk, __snprintf_chk) as assembly that builds the va_list and calls it (src/toolchain.ab,
// bootstrapStaticLibcData). Conversions: %d %i %u %x %X %o %b %B %c %s %p %% and %lc %ls (C locale: ASCII only, EILSEQ past it) with flags
// - + space # 0 (' and I change nothing in the C locale), a width and a precision (also *), the length modifiers hh h l ll z j t L and C23's wN.
// Floating-point conversions (%f %F %e %E %g %G %a %A) are exact and correctly rounded as glibc's (floatfmt.ab); a long double is formatted as
// the nearest double. As glibc: a format that ends inside a conversion, and a width, precision or count past INT_MAX, are -1 (EINVAL, EOVERFLOW);
// an unknown conversion is written as it came. Not supported: numbered arguments (%1$d, refused with EINVAL rather than read out of order), %n
// (written as text: no write primitive), %m.
import "abla/runtime/scalar"
import "abla/float"
import "abla/bytes"
import "abla/simd/target"
import "abla/unsafe/memory/raw"
import "./string.ab"
import "./errno.ab"
import "./stdio.ab"
import "./floatfmt.ab"

// The va_list: System V x86-64's gp_offset (4 bytes), fp_offset (4), overflow_arg_area (8), reg_save_area (8); on AArch64 (AAPCS64) the
// stack pointer (8), the end of the general register save area (8), the end of the vector one (8), and the two offsets from those ends as
// negative ints (4 each), which reach 0 when the registers are used up. The target is known when the compiler builds, so only one is compiled.
// ablaRuntimeLoadI32 zero-extends: the AArch64 offsets go through libcSigned32, or no register argument would ever be read (every one came from
// the stack area, and from past its end once the real stack arguments ran out).
fun libcSigned32(word: int): int {
    val low = word & 4294967295
    if (low >= 2147483648) low - 4294967296 else low
}

trusted fun libcVaInt(list: int): int {
    // The RV64 C ABI passes va_list as a pointer. Here list points to the
    // format call's local cursor so integer and floating conversions advance it.
    if (simdTargetArch() == SIMD_ARCH_OTHER) {
        val cursor = ablaRuntimeLoadI64(list)
        ablaRuntimeStoreI64(list, cursor + 8)
        return ablaRuntimeLoadI64(cursor)
    }
    if (simdTargetArch() == SIMD_ARCH_AARCH64) {
        val offset = libcSigned32(ablaRuntimeLoadI32(list + 24))
        if (offset < 0) {
            ablaRuntimeStoreI32(list + 24, offset + 8)
            return ablaRuntimeLoadI64(ablaRuntimeLoadI64(list + 8) + offset)
        }
        val stack = ablaRuntimeLoadI64(list)
        ablaRuntimeStoreI64(list, stack + 8)
        return ablaRuntimeLoadI64(stack)
    }
    val offset = ablaRuntimeLoadI32(list) & 4294967295
    if (offset < 48) {
        ablaRuntimeStoreI32(list, offset + 8)
        return ablaRuntimeLoadI64(ablaRuntimeLoadI64(list + 16) + offset)
    }
    val area = ablaRuntimeLoadI64(list + 8)
    ablaRuntimeStoreI64(list + 8, area + 8)
    ablaRuntimeLoadI64(area)
}

trusted fun libcVaDouble(list: int): f64 {
    if (simdTargetArch() == SIMD_ARCH_OTHER) return f64FromBits(libcVaInt(list))
    if (simdTargetArch() == SIMD_ARCH_AARCH64) {
        val offset = libcSigned32(ablaRuntimeLoadI32(list + 28))
        if (offset < 0) {
            ablaRuntimeStoreI32(list + 28, offset + 16)
            return f64FromBits(ablaRuntimeLoadI64(ablaRuntimeLoadI64(list + 16) + offset))
        }
        val stack = ablaRuntimeLoadI64(list)
        ablaRuntimeStoreI64(list, stack + 8)
        return f64FromBits(ablaRuntimeLoadI64(stack))
    }
    val offset = ablaRuntimeLoadI32(list + 4) & 4294967295
    if (offset < 176) {
        ablaRuntimeStoreI32(list + 4, offset + 16)
        return f64FromBits(ablaRuntimeLoadI64(ablaRuntimeLoadI64(list + 16) + offset))
    }
    val area = ablaRuntimeLoadI64(list + 8)
    ablaRuntimeStoreI64(list + 8, area + 8)
    f64FromBits(ablaRuntimeLoadI64(area))
}

// A long double argument (%Lf and the other floating conversions with L), as the nearest double: x86-64's is the x87 80-bit format, which
// always comes from the overflow area (16 bytes, 16-aligned); AArch64's and RV64's are IEEE binary128, from a vector register's 16-byte slot or
// the stack (16-aligned) on AArch64, from an aligned pair of 8-byte slots on RV64. It is read whole, so the arguments after it are where they
// should be; its value is rounded to a double, so digits past a double's precision differ from glibc's.
trusted fun libcVaLongDouble(list: int): f64 {
    if (simdTargetArch() == SIMD_ARCH_OTHER) {
        val cursor = (ablaRuntimeLoadI64(list) + 15) & -16
        ablaRuntimeStoreI64(list, cursor + 16)
        return libcQuadToF64(ablaRuntimeLoadI64(cursor), ablaRuntimeLoadI64(cursor + 8))
    }
    if (simdTargetArch() == SIMD_ARCH_AARCH64) {
        val offset = libcSigned32(ablaRuntimeLoadI32(list + 28))
        if (offset < 0) {
            ablaRuntimeStoreI32(list + 28, offset + 16)
            val slot = ablaRuntimeLoadI64(list + 16) + offset
            return libcQuadToF64(ablaRuntimeLoadI64(slot), ablaRuntimeLoadI64(slot + 8))
        }
        val stack = (ablaRuntimeLoadI64(list) + 15) & -16
        ablaRuntimeStoreI64(list, stack + 16)
        return libcQuadToF64(ablaRuntimeLoadI64(stack), ablaRuntimeLoadI64(stack + 8))
    }
    val area = (ablaRuntimeLoadI64(list + 8) + 15) & -16
    ablaRuntimeStoreI64(list + 8, area + 16)
    libcX87ToF64(ablaRuntimeLoadI64(area), ablaRuntimeLoadI32(area + 8) & 65535)
}

// The next argument of a Windows va_list (x64 and ARM64 alike): a pointer to the arguments' 8-byte slots, a double's bits in its own
// slot (long double is double there), held at `list` and advanced past the slot it reads.
trusted fun libcVaSlot(list: int): int {
    val cursor = ablaRuntimeLoadI64(list)
    ablaRuntimeStoreI64(list, cursor + 8)
    ablaRuntimeLoadI64(cursor)
}

trusted fun libcVaWord(list: int, windows: bool): int = if (windows) libcVaSlot(list) else libcVaInt(list)

// The double nearest (ties to even) to significand * 2^(exponent - 63), the significand's leading bit at bit 63 and `sticky` set when nonzero
// bits were cut below it: overflow is an infinity, a value below half the smallest subnormal a zero.
fun libcRoundToF64(negative: bool, significand: u64, exponent: int, sticky: bool): f64 {
    val sign = if (negative) -9223372036854775808 else 0
    if (exponent > 1023) return f64FromBits(sign | 9218868437227405312)
    // The bits kept: 53 for a normal double, fewer for a subnormal one (down to the weight 2^-1074).
    val shift = if (exponent >= -1022) 11 else -1011 - exponent
    if (shift > 64) return f64FromBits(sign)
    var kept = u64(0)
    var roundUp = false
    if (shift == 64) roundUp = significand > u64(9223372036854775808) || (significand == u64(9223372036854775808) && sticky)
    else {
        kept = significand >> u64(shift)
        val remainder = significand - (kept << u64(shift))
        val half = u64(1) << u64(shift - 1)
        roundUp = remainder > half || (remainder == half && (sticky || (kept & u64(1)) == u64(1)))
    }
    if (roundUp) kept = kept + u64(1)
    if (exponent < -1022) return f64FromBits(sign | int(kept))
    // A carry out of the 53 bits moves the value to the next binade.
    var biased = exponent + 1023
    if (kept == u64(9007199254740992)) {
        kept = u64(4503599627370496)
        biased = biased + 1
    }
    if (biased >= 2047) return f64FromBits(sign | 9218868437227405312)
    f64FromBits(sign | (biased << 52) | (int(kept) - 4503599627370496))
}

// An x87 extended value (64-bit significand with its integer bit, then the sign and the 15-bit exponent) as the nearest double.
fun libcX87ToF64(significand: int, signExponent: int): f64 {
    val negative = (signExponent & 32768) != 0
    val biased = signExponent & 32767
    val sign = if (negative) -9223372036854775808 else 0
    if (biased == 32767) return f64FromBits(sign | (if ((significand << 1) == 0) 9218868437227405312 else 9221120237041090560))
    // The integer bit clear (a denormal, or an unnormal the x87 no longer makes): far below a double's range, or not a number.
    if (significand >= 0) {
        if (biased == 0 || significand == 0) return f64FromBits(sign)
        return f64FromBits(sign | 9221120237041090560)
    }
    libcRoundToF64(negative, u64(significand), biased - 16383, false)
}

// An IEEE binary128 value (its low and high words) as the nearest double.
fun libcQuadToF64(low: int, high: int): f64 {
    val negative = high < 0
    val biased = (high >>> 48) & 32767
    val sign = if (negative) -9223372036854775808 else 0
    val fractionHigh = high & 281474976710655
    if (biased == 32767) return f64FromBits(sign | (if (fractionHigh == 0 && low == 0) 9218868437227405312 else 9221120237041090560))
    // A binary128 subnormal is below 2^-16382: zero as a double.
    if (biased == 0) return f64FromBits(sign)
    // 1.fraction (113 bits): the top 64 of them, and whether any of the 49 below are set.
    val top = u64(-9223372036854775808) | (u64(fractionHigh) << u64(15)) | (u64(low) >> u64(49))
    libcRoundToF64(negative, top, biased - 16383, (low & 562949953421311) != 0)
}

// The output: a buffer of `size` bytes and the count of bytes the format makes. For snprintf (`descriptor` -1) one byte is kept for the NUL and
// what does not fit is only counted; a size_t of 2^63 or more (sprintf passes SIZE_MAX) is no limit. For printf and fprintf (`descriptor` the
// stream's) the buffer is written out each time it fills, so no length is cut. `error` is the errno of a format glibc refuses (EINVAL 22 for a
// format that ends inside a conversion, EOVERFLOW 75 for a width, precision or count past INT_MAX, EILSEQ 84 for a wide character the C locale cannot
// write): the formatting stops there and the call returns -1.
class LibcOut(val buffer: int, val size: int, var count: int, var error: int, val descriptor: int, var used: int)

trusted fun LibcOut.flush(): void {
    libcWriteAll(this.descriptor, this.buffer, this.used)
    this.used = 0
    return
}

trusted fun LibcOut.put(byte: int): void {
    if (this.descriptor >= 0) {
        if (this.used == this.size) this.flush()
        ablaRuntimeStoreU8(this.buffer + this.used, byte)
        this.used = this.used + 1
    } else if (this.count + 1 < this.size) ablaRuntimeStoreU8(this.buffer + this.count, byte)
    this.count = this.count + 1
    return
}

trusted fun LibcOut.padding(count: int, byte: int): void {
    var done = 0
    if (this.descriptor >= 0) {
        while (done < count) {
            this.put(byte)
            done = done + 1
        }
        return
    }
    while (done < count && this.count + 1 < this.size) {
        ablaRuntimeStoreU8(this.buffer + this.count, byte)
        this.count = this.count + 1
        done = done + 1
    }
    // What does not fit is only counted.
    if (done < count) this.count = this.count + (count - done)
    return
}

trusted fun LibcOut.putText(text: string): void {
    var at = 0
    while (at < text.size) {
        this.put(text[at])
        at = at + 1
    }
    return
}

fun libcDigits(value: int, base: int, upper: bool): string {
    if (value == 0) return "0"
    var text = ""
    var rest = value
    // `value` is an unsigned magnitude held in an int: handle the sign bit by working with unsigned division steps.
    val letters = if (upper) "0123456789ABCDEF" else "0123456789abcdef"
    while (rest != 0) {
        val digit = libcUnsignedRemainder(rest, base)
        text = letters.slice(digit, digit + 1) + text
        rest = libcUnsignedQuotient(rest, base)
    }
    text
}

// Unsigned division of a 64-bit word by a small divisor (the runtime has no unsigned division operator on int).
fun libcUnsignedQuotient(value: int, divisor: int): int {
    if (value >= 0) return value / divisor
    val half = (value >>> 1) / divisor
    var quotient = half * 2
    val remainder = value - quotient * divisor
    if (remainder >= divisor || remainder < 0) quotient = quotient + 1
    quotient
}

fun libcUnsignedRemainder(value: int, divisor: int): int = value - libcUnsignedQuotient(value, divisor) * divisor

// INT_MAX: the largest width, precision and count a C int result can carry.
val libcIntMax = 2147483647

// The decimal width or precision at `start`: a value past INT_MAX is -1 (EOVERFLOW), with no int wrap however many digits follow.
trusted fun libcFormatNumber(format: int, start: int): int {
    var at = start
    var value = 0
    while (ablaRuntimeLoadU8(format + at) >= 48 && ablaRuntimeLoadU8(format + at) <= 57) {
        if (value >= 0) {
            value = value * 10 + ablaRuntimeLoadU8(format + at) - 48
            if (value > libcIntMax) value = -1
        }
        at = at + 1
    }
    value
}

// The offset after the decimal digits at `start`.
trusted fun libcFormatDigitsEnd(format: int, start: int): int {
    var at = start
    while (ablaRuntimeLoadU8(format + at) >= 48 && ablaRuntimeLoadU8(format + at) <= 57) at = at + 1
    at
}

trusted fun libcFormat(var out: LibcOut, format: int, list: int): void = libcFormatFor(out, format, list, false)

// `windows`: the Windows C library's conventions (src/static_libc/windows/io.ab): `list` holds the va_list pointer (libcVaSlot), long is
// 32 bits (l takes the low 32 bits, ll the whole word), long double is double, wchar_t is 2 bytes, the Microsoft length modifiers I64, I32
// and I (a pointer's size) are read (so I is not glibc's locale-digits flag), and %p is the pointer as 16 upper-case hexadecimal digits,
// as Microsoft's printf writes it.
trusted fun libcFormatFor(var out: LibcOut, format: int, list: int, windows: bool): void {
    var at = 0
    while (true) {
        val c = ablaRuntimeLoadU8(format + at)
        if (c == 0) break
        at = at + 1
        if (c != 37) {
            out.put(c)
            continue
        }
        var left = false
        var plus = false
        var space = false
        var alternate = false
        var zero = false
        var flags = true
        while (flags) {
            val f = ablaRuntimeLoadU8(format + at)
            if (f == 45) left = true
            else if (f == 43) plus = true
            else if (f == 32) space = true
            else if (f == 35) alternate = true
            else if (f == 48) zero = true
            // ' (thousands grouping) and I (the locale's digits) change nothing in the C locale.
            else if (f == 39 || (f == 73 && !windows)) flags = true
            else flags = false
            if (flags) at = at + 1
        }
        var width = 0
        if (ablaRuntimeLoadU8(format + at) == 42) {
            width = libcVaWord(list, windows) & 4294967295
            if (width >= 2147483648) {
                // A negative width is the - flag and its magnitude (INT_MIN's is past INT_MAX).
                width = 4294967296 - width
                left = true
            }
            at = at + 1
        } else {
            width = libcFormatNumber(format, at)
            at = libcFormatDigitsEnd(format, at)
            // %1$d: the numbered arguments are not supported; refused rather than read in the wrong order.
            if (ablaRuntimeLoadU8(format + at) == 36) {
                out.error = 22
                return
            }
        }
        if (width < 0 || width > libcIntMax) {
            out.error = 75
            return
        }
        var precision = -1
        if (ablaRuntimeLoadU8(format + at) == 46) {
            at = at + 1
            precision = 0
            if (ablaRuntimeLoadU8(format + at) == 42) {
                precision = libcVaWord(list, windows) & 4294967295
                if (precision >= 2147483648) precision = -1
                at = at + 1
            } else {
                precision = libcFormatNumber(format, at)
                at = libcFormatDigitsEnd(format, at)
                if (precision < 0) {
                    out.error = 75
                    return
                }
            }
        }
        // Length: l ll z j t take the whole word; none, h, hh the low 32, 16, 8 bits; L is a long double for the floating conversions.
        var size = 4
        var long = false
        var longDouble = false
        var scanning = true
        var longs = 0
        while (scanning) {
            val m = ablaRuntimeLoadU8(format + at)
            if (windows && m == 108) {
                longs = longs + 1
                size = if (longs >= 2) 8 else 4
                long = true
            } else if (windows && m == 73) {
                // I64 and I32 name their width; a bare I is a pointer's (size_t, ptrdiff_t).
                val next = ablaRuntimeLoadU8(format + at + 1)
                val after = ablaRuntimeLoadU8(format + at + 2)
                if (next == 54 && after == 52) {
                    size = 8
                    at = at + 2
                } else if (next == 51 && after == 50) {
                    size = 4
                    at = at + 2
                } else size = 8
            } else if (m == 108 || m == 122 || m == 106 || m == 116 || m == 76 || m == 113) {
                size = 8
                if (m == 108) long = true
                if (m == 76) longDouble = true
            } else if (m == 104) size = if (size == 2) 1 else 2
            else if (m == 119) {
                // C23's wN and wfN: an integer of exactly N bits (8, 16, 32 or 64); any other N glibc refuses.
                var next = at + 1
                if (ablaRuntimeLoadU8(format + next) == 102) next = next + 1
                val bits = libcFormatNumber(format, next)
                at = libcFormatDigitsEnd(format, next) - 1
                if (bits == 8) size = 1
                else if (bits == 16) size = 2
                else if (bits == 32) size = 4
                else if (bits == 64) size = 8
                else {
                    out.error = 22
                    return
                }
            } else scanning = false
            if (scanning) at = at + 1
        }
        val conversion = ablaRuntimeLoadU8(format + at)
        // The format ends inside the conversion ("%", "%-5", "%l"): glibc refuses it, and nothing past the terminator is read.
        if (conversion == 0) {
            out.error = 22
            return
        }
        at = at + 1
        val integer = conversion == 100 || conversion == 105 || conversion == 117 || conversion == 120 || conversion == 88 ||
            conversion == 111 || conversion == 112 || conversion == 98 || conversion == 66
        var body = ""
        var sign = ""
        var numeric = false
        if (conversion == 37) {
            out.put(37)
            continue
        } else if (conversion == 100 || conversion == 105) {
            var value = libcVaWord(list, windows)
            if (size == 4) {
                value = value & 4294967295
                if (value >= 2147483648) value = value - 4294967296
            } else if (size == 2) {
                value = value & 65535
                if (value >= 32768) value = value - 65536
            } else if (size == 1) {
                value = value & 255
                if (value >= 128) value = value - 256
            }
            numeric = true
            if (value < 0) {
                sign = "-"
                // The magnitude of the most negative value is itself as an unsigned word.
                body = libcDigits(0 - value, 10, false)
            } else {
                sign = if (plus) "+" else if (space) " " else ""
                body = libcDigits(value, 10, false)
            }
        } else if (conversion == 117 || conversion == 120 || conversion == 88 || conversion == 111 || conversion == 98 || conversion == 66) {
            // %b and %B are C23's binary (glibc 2.35 on): they take an argument, so reading none would put every later one out of place.
            var value = libcVaWord(list, windows)
            if (size == 4) value = value & 4294967295
            else if (size == 2) value = value & 65535
            else if (size == 1) value = value & 255
            numeric = true
            val base = if (conversion == 117) 10 else if (conversion == 111) 8 else if (conversion == 98 || conversion == 66) 2 else 16
            body = libcDigits(value, base, conversion == 88)
            if (alternate && value != 0) {
                if (conversion == 120) sign = "0x"
                else if (conversion == 88) sign = "0X"
                else if (conversion == 98) sign = "0b"
                else if (conversion == 66) sign = "0B"
                else if (conversion == 111) body = "0" + body
            }
        } else if (conversion == 112) {
            // %p is glibc's %#lx (its + and space flags too) and "(nil)" for NULL, which takes no precision or zeros.
            val value = libcVaWord(list, windows)
            if (windows) {
                var digits = libcDigits(value, 16, true)
                while (digits.size < 16) digits = "0" + digits
                body = digits
                precision = -1
            } else if (value == 0) {
                body = "(nil)"
                precision = -1
            } else {
                numeric = true
                sign = (if (plus) "+" else if (space) " " else "") + "0x"
                body = libcDigits(value, 16, false)
            }
        } else if (conversion == 99 || conversion == 67) {
            val value = libcVaWord(list, windows) & 4294967295
            if ((long || conversion == 67) && value > 127) {
                // %lc: a wint_t, one byte in the C locale; a character past 127 has none (EILSEQ).
                out.error = 84
                return
            }
            val byte = value & 255
            out.padding(if (left) 0 else width - 1, 32)
            out.put(byte)
            out.padding(if (left) width - 1 else 0, 32)
            continue
        } else if (conversion == 115 || conversion == 83) {
            val text = libcVaWord(list, windows)
            // A NULL string is "(null)" as glibc writes it, which a precision under its 6 bytes leaves out altogether rather than cutting.
            if (text == 0) body = if (precision >= 0 && precision < 6) "" else "(null)"
            else if (long || conversion == 83) {
                // %ls: wchar_t units (4 bytes; 2 on Windows) to the terminator or the precision's bytes; one byte each in the C locale, EILSEQ
                // past 127.
                var copy = ""
                var i = 0
                while (precision < 0 || i < precision) {
                    val unit = if (windows) ablaRuntimeLoadU8(text + i * 2) + ablaRuntimeLoadU8(text + i * 2 + 1) * 256
                        else ablaRuntimeLoadI32(text + i * 4) & 4294967295
                    if (unit == 0) break
                    if (unit > 127) {
                        out.error = 84
                        return
                    }
                    copy = copy + utf8ByteText(unit)
                    i = i + 1
                }
                body = copy
            } else {
                var length = 0
                while ((precision < 0 || length < precision) && ablaRuntimeLoadU8(text + length) != 0) length = length + 1
                var copy = ""
                var i = 0
                while (i < length) {
                    copy = copy + utf8ByteText(ablaRuntimeLoadU8(text + i))
                    i = i + 1
                }
                body = copy
            }
            precision = -1
        } else if (conversion == 102 || conversion == 70 || conversion == 101 || conversion == 69 || conversion == 103 || conversion == 71 ||
            conversion == 97 || conversion == 65) {
            val value = if (windows) f64FromBits(libcVaSlot(list)) else if (longDouble) libcVaLongDouble(list) else libcVaDouble(list)
            body = libcFloat(value, conversion, precision, alternate)
            if (body.size > 0 && body[0] == 45) {
                sign = "-"
                body = body.slice(1, body.size)
            } else sign = if (plus) "+" else if (space) " " else ""
            // inf and nan are padded with spaces, never zeros; a %a keeps its 0x before the zeros of a zero-padded field.
            numeric = value - value == 0.0
            if (numeric && (conversion == 97 || conversion == 65)) {
                sign = sign + body.slice(0, 2)
                body = body.slice(2, body.size)
            }
        } else {
            // Not a conversion this formatter knows (%y, %m, %n): written as it came, no argument read, as glibc writes the ones it does not
            // know. %n in particular writes nothing anywhere.
            out.put(37)
            out.put(conversion)
            continue
        }
        // C: a zero converted with a precision of 0 has no digits at all (%.0d of 0 writes nothing but its padding); the # flag of %o keeps one 0.
        if (precision == 0 && body == "0" && integer && conversion != 112) body = if (conversion == 111 && alternate) "0" else ""
        // The precision's leading zeros, counted rather than built (a precision may be up to INT_MAX).
        val zeros = if (numeric && integer && precision > body.size) precision - body.size else 0
        val total = sign.size + zeros + body.size
        val fill = if (width > total) width - total else 0
        if (left) {
            out.putText(sign)
            out.padding(zeros, 48)
            out.putText(body)
            out.padding(fill, 32)
        } else if (zero && numeric && !(precision >= 0 && integer)) {
            out.putText(sign)
            out.padding(fill, 48)
            out.putText(body)
        } else {
            out.padding(fill, 32)
            out.putText(sign)
            out.padding(zeros, 48)
            out.putText(body)
        }
        // A count past INT_MAX cannot be returned (glibc: EOVERFLOW).
        if (out.count > libcIntMax) {
            out.error = 75
            return
        }
    }
    return
}

// One byte as a one-byte string (the C strings here are bytes, not UTF-8 text).
fun utf8ByteText(byte: int): string = byteEncode(byte)

// The format over `list`: RV64's va_list is the cursor itself, passed by value, so the conversions advance a local copy of it.
trusted fun libcFormatList(var out: LibcOut, format: int, list: int): void {
    if (simdTargetArch() == SIMD_ARCH_OTHER) {
        val cursor = nativeStackAllocate(8)
        ablaRuntimeStoreI64(cursor, list)
        libcFormat(out, format, cursor)
    } else libcFormat(out, format, list)
    // Plain text after the last conversion can take the count past INT_MAX too.
    if (out.error == 0 && out.count > libcIntMax) out.error = 75
    return
}

// Exported by lp64.ab (its va_list is System V's, AAPCS64's or RV64's; Windows' printf family is in windows/io.ab).
trusted fun libcVsnprintf(buffer: int, size: int, format: int, list: int): int {
    // size is a size_t: 2^63 and more (sprintf's SIZE_MAX) are negative here and mean no limit, not no room.
    val room = if (size < 0) 9223372036854775807 else size
    val out = LibcOut(buffer, room, 0, 0, -1, 0)
    libcFormatList(out, format, list)
    if (room > 0) {
        val end = if (out.count < room - 1) out.count else room - 1
        ablaRuntimeStoreU8(buffer + end, 0)
    }
    if (out.error != 0) {
        libcSetErrno(out.error)
        return -1
    }
    out.count
}

// printf and fprintf: the text goes to the descriptor through a 4096-byte buffer written out each time it fills (it used to be cut at 4095 bytes).
trusted fun libcVprintfTo(descriptor: int, format: int, list: int): int {
    val buffer = __ablaRuntimeHostHeapAllocate(4096, false)
    val out = LibcOut(buffer, 4096, 0, 0, descriptor, 0)
    libcFormatList(out, format, list)
    out.flush()
    __ablaRuntimeHostHeapFree(buffer)
    if (out.error != 0) {
        libcSetErrno(out.error)
        return -1
    }
    out.count
}

// printf to stdout from the assembly shim __printf_chk.
// Exported by lp64.ab (its va_list is System V's, AAPCS64's or RV64's; Windows' printf family is in windows/io.ab).
trusted fun libcVprintf(format: int, list: int): int = libcVprintfTo(1, format, list)

// vprintf (the plain name), vfprintf and the fortified forms: the text goes to the stream's descriptor (first word of its FILE).
// Exported by lp64.ab (its va_list is System V's, AAPCS64's or RV64's; Windows' printf family is in windows/io.ab).
trusted fun libcVprintfPlain(format: int, list: int): int = libcVprintf(format, list)

// Exported by lp64.ab (its va_list is System V's, AAPCS64's or RV64's; Windows' printf family is in windows/io.ab).
trusted fun libcVfprintf(file: int, format: int, list: int): int = libcVprintfTo(ablaRuntimeLoadI64(file), format, list)

// Exported by lp64.ab (its va_list is System V's, AAPCS64's or RV64's; Windows' printf family is in windows/io.ab).
trusted fun libcVfprintfPlain(file: int, format: int, list: int): int = libcVfprintf(file, format, list)

// Exported by lp64.ab (its va_list is System V's, AAPCS64's or RV64's; Windows' printf family is in windows/io.ab).
trusted fun libcVfprintfChk(file: int, flag: int, format: int, list: int): int = libcVfprintf(file, format, list)

// Exported by lp64.ab (its va_list is System V's, AAPCS64's or RV64's; Windows' printf family is in windows/io.ab).
trusted fun libcVprintfChk(flag: int, format: int, list: int): int = libcVprintf(format, list)
