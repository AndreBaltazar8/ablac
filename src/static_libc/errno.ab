// errno for the statically linked compiler's C library: a cell for each thread (#806 step C, step 5), found by the thread id modulo 256 in a
// table made on first use (thread ids of one process are consecutive, so the compiler's few workers never share a cell).
import "abla/runtime/scalar"
import "abla/sys/linux"

var libcErrnoTable: int = 0

trusted fun libcErrnoAddress(): int {
    if (libcErrnoTable == 0) {
        libcErrnoTable = __ablaRuntimeHostHeapAllocate(256 * 16, true)
    }
    libcErrnoTable + (linuxSyscall0(186) & 255) * 16
}

trusted fun libcSetErrno(code: int): void {
    ablaRuntimeStoreI64(libcErrnoAddress(), code)
    return
}

// A system call's result as C returns it: -errno (-4095 to -1) becomes -1 with errno set.
trusted fun libcResult(result: int): int {
    if (result < 0 && result > -4096) {
        libcSetErrno(0 - result)
        return -1
    }
    result
}

@export("__errno_location")
trusted fun libcErrnoLocation(): int = libcErrnoAddress()
