// errno for the statically linked compiler's C library: a cell of each thread's own (#806 step C, step 5, #1139 area 14), the runtime's
// thread-local storage, which every thread of the process has from its start (the runtime's clone threads are pthread_create's). It used to be a
// table of 256 cells found by the thread id modulo 256, which gave two threads whose ids differed by a multiple of 256 one errno between them
// (thread ids are the system's process ids, not consecutive within a process), and was made on first use by whichever threads raced to it.
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"

trusted fun libcErrnoAddress(): int = nativeThreadLocalBytes("\x00\x00\x00\x00\x00\x00\x00\x00")

trusted fun libcSetErrno(code: int): void {
    ablaRuntimeStoreI64(libcErrnoAddress(), code)
    return
}

// A system call's result as C returns it: -errno (-4095 to -1) becomes -1 with errno set.
trusted fun libcResult(result: int): int {
    if (result < 0 && result > -4096) {
        libcSetErrno(0 - result)
        return -1
    }
    result
}

@export("__errno_location")
trusted fun libcErrnoLocation(): int = libcErrnoAddress()
