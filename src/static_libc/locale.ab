// The C locale of the statically linked compiler's C library (#806 step C, step 4): the classification and case tables <ctype.h> macros read
// through __ctype_b_loc, __ctype_tolower_loc and __ctype_toupper_loc (glibc's layout: a pointer to a pointer into a table of 384 entries
// indexed -128..255), built once on first use. Bytes are characters; only ASCII is classified.
import "abla/runtime/scalar"
import "abla/unsafe/native"
import "abla/unsafe/memory/raw"

var libcCtypeClass: int = 0
var libcCtypeLower: int = 0
var libcCtypeUpper: int = 0

// glibc's little-endian mask bits.
trusted fun libcCtypeMask(c: int): int {
    var mask = 0
    val upper = c >= 65 && c <= 90
    val lower = c >= 97 && c <= 122
    val digit = c >= 48 && c <= 57
    if (upper) mask = mask | 256
    if (lower) mask = mask | 512
    if (upper || lower) mask = mask | 1024
    if (digit) mask = mask | 2048
    if (digit || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)) mask = mask | 4096
    if (c == 32 || (c >= 9 && c <= 13)) mask = mask | 8192
    if (c >= 32 && c <= 126) mask = mask | 16384
    if (c >= 33 && c <= 126) mask = mask | 32768
    if (c == 32 || c == 9) mask = mask | 1
    if (c < 32 || c == 127) mask = mask | 2
    if (c >= 33 && c <= 126 && !upper && !lower && !digit) mask = mask | 4
    if (upper || lower || digit) mask = mask | 8
    mask
}

// A cell holding the table pointer (the functions return the address of a pointer).
trusted fun libcCtypeBuild(): void {
    if (libcCtypeClass != 0) return
    val classes = __ablaRuntimeHostHeapAllocate(384 * 2 + 16, true)
    val lower = __ablaRuntimeHostHeapAllocate(384 * 4 + 16, true)
    val upper = __ablaRuntimeHostHeapAllocate(384 * 4 + 16, true)
    var index = 0
    while (index < 384) {
        val c = index - 128
        var folded = c
        var raised = c
        if (c >= 65 && c <= 90) folded = c + 32
        if (c >= 97 && c <= 122) raised = c - 32
        if (c >= 0 && c < 256) {
            val mask = libcCtypeMask(c)
            ablaRuntimeStoreU8(classes + index * 2, mask & 255)
            ablaRuntimeStoreU8(classes + index * 2 + 1, mask >> 8)
        }
        ablaRuntimeStoreI32(lower + index * 4, folded)
        ablaRuntimeStoreI32(upper + index * 4, raised)
        index = index + 1
    }
    // Three cells (class, lower, upper), each the pointer to element 0.
    val cells = __ablaRuntimeHostHeapAllocate(32, true)
    ablaRuntimeStoreI64(cells, classes + 256)
    ablaRuntimeStoreI64(cells + 8, lower + 512)
    ablaRuntimeStoreI64(cells + 16, upper + 512)
    libcCtypeUpper = cells + 16
    libcCtypeLower = cells + 8
    libcCtypeClass = cells
    return
}

@export("__ctype_b_loc")
trusted fun libcCtypeBLoc(): int {
    libcCtypeBuild()
    libcCtypeClass
}

@export("__ctype_tolower_loc")
trusted fun libcCtypeLowerLoc(): int {
    libcCtypeBuild()
    libcCtypeLower
}

@export("__ctype_toupper_loc")
trusted fun libcCtypeUpperLoc(): int {
    libcCtypeBuild()
    libcCtypeUpper
}

// The C locale's multibyte character is one byte.
@export("__ctype_get_mb_cur_max")
trusted fun libcMbCurMax(): int = 1
