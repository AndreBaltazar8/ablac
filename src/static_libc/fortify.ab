// glibc's fortified entry points for the statically linked compiler (#1139 area 14): LLVM and libstdc++ were built with _FORTIFY_SOURCE, and where the
// compiler knew the size of the destination object it calls these with it. A copy, fill, format or path longer than that object is an overflow caught
// here, as glibc's __chk_fail does (they used to forward to the plain routine and drop the size). A size of SIZE_MAX (-1) means "unknown" and checks
// nothing. (Apart from stackprot.ab: these need format.ab and fs.ab, which a program that only calls __stack_chk_fail must not pull in.)
import "abla/runtime/scalar"
import "abla/sys/linux"
import "abla/unsafe/memory/raw"
import "./process.ab"
import "./format.ab"
import "./fs.ab"


/** glibc's __chk_fail: a fortified call would have written past its object. One line to standard error, then abort. */
trusted fun libcChkFail(): void {
    val message = "*** buffer overflow detected ***: terminated\n"
    linuxSyscall3(1, 2, ablaUnsafeStringAddress(message), message.size)
    libcAbort()
    return
}

/** Whether `count` bytes fit an object of `objectSize` bytes, both size_t (unsigned: SIZE_MAX, -1 here, when the compiler did not know the object):
 *  count <= objectSize as unsigned numbers. */
fun libcChkFits(count: int, objectSize: int): bool =
    if (count >= 0 && objectSize >= 0) count <= objectSize
    else if (count >= 0) true
    else if (objectSize >= 0) false
    else count <= objectSize

@export("__memcpy_chk")
trusted fun libcMemcpyChk(destination: int, source: int, count: int, objectSize: int): int {
    if (!libcChkFits(count, objectSize)) libcChkFail()
    ablaUnsafeCopyMemory(destination, source, count)
    destination
}

@export("__memset_chk")
trusted fun libcMemsetChk(destination: int, byte: int, count: int, objectSize: int): int {
    if (!libcChkFits(count, objectSize)) libcChkFail()
    ablaUnsafeSetMemory(ablaRuntimePointerFromAddress(destination), byte & 255, count)
    destination
}

/** __vsnprintf_chk(buffer, size, flag, objectSize, format, list): `size` may not be more than the object holds. The __snprintf_chk entry points
 *  (toolchain.ab's assembly) call this with their own arguments in place. */
@export("__vsnprintf_chk")
trusted fun libcVsnprintfChk(buffer: int, size: int, flag: int, objectSize: int, format: int, list: int): int {
    if (!libcChkFits(size, objectSize)) libcChkFail()
    libcVsnprintf(buffer, size, format, list)
}

/** __realpath_chk(path, resolved, resolvedSize): realpath writes up to PATH_MAX (4096) bytes into `resolved`, so a smaller buffer is refused. */
@export("__realpath_chk")
trusted fun libcRealpathChk(path: int, resolved: int, size: int): int {
    if (resolved != 0 && !libcChkFits(4096, size)) libcChkFail()
    libcRealpath(path, resolved)
}
