// The pthread synchronisation functions of the statically linked compiler's C library, for ONE thread (#806 step C, step 2): every lock is
// free and taken at once, so the compiler must run with a single worker (ABLA_NATIVE_JOBS=1, ABLA_CODEGEN_JOBS=1) until the threads family
// (clone threads, futex locks, thread-local storage) replaces these. pthread_create and pthread_join are the runtime's abla_clone_create and
// abla_clone_join by a link --defsym, as for any libc-free program.
import "abla/runtime/scalar"
import "abla/unsafe/native"
import "abla/sys/linux"

@export("pthread_mutex_lock")
fun libcMutexLock(mutex: int): int = 0

@export("pthread_mutex_unlock")
fun libcMutexUnlock(mutex: int): int = 0

@export("pthread_rwlock_rdlock")
fun libcRwlockRead(lock: int): int = 0

@export("pthread_rwlock_wrlock")
fun libcRwlockWrite(lock: int): int = 0

@export("pthread_rwlock_unlock")
fun libcRwlockUnlock(lock: int): int = 0

@export("pthread_cond_signal")
fun libcCondSignal(condition: int): int = 0

@export("pthread_cond_broadcast")
fun libcCondBroadcast(condition: int): int = 0

@export("pthread_cond_destroy")
fun libcCondDestroy(condition: int): int = 0

// pthread_once: the control word is 0 until the routine has run, once.
@export("pthread_once")
trusted fun libcOnce(control: int, routine: int): int {
    if (ablaRuntimeLoadI32(control) == 0) {
        ablaRuntimeStoreI32(control, 1)
        ablaUnsafeCallAddressI32(routine, 0)
    }
    0
}

// Calls the JIT'd code makes: pause (until a signal), pthread_self (the thread pointer: arch_prctl ARCH_GET_FS), pthread_kill (tgkill of the
// calling thread: only a thread signalling itself is supported until the threads family).
@export("pause")
trusted fun libcPause(): int {
    linuxSyscall0(34)
    -1
}

@export("pthread_self")
trusted fun libcPthreadSelf(): int {
    val cell = __ablaRuntimeHostHeapAllocate(16, true)
    linuxSyscall2(158, 4099, cell)
    val pointer = ablaRuntimeLoadI64(cell)
    __ablaRuntimeHostHeapFree(cell)
    pointer
}

@export("pthread_kill")
trusted fun libcPthreadKill(target: int, signal: int): int {
    val result = linuxSyscall3(234, linuxSyscall0(39), linuxSyscall0(186), signal & 4294967295)
    if (result < 0) 0 - result else 0
}
