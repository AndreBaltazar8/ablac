// The rest of ISO C's character, string and number functions (#806 step C, #648): what a compile-time `extern:"c"` call or a JIT'd program may
// name beyond the ones LLVM and libstdc++ use. Bytes are characters (the C locale); every function is glibc's behaviour in that locale.
import "abla/runtime/scalar"
import "abla/unsafe/native"
import "abla/unsafe/memory/raw"
import "./fs.ab"
import "./errno.ab"
import "./memory.ab"
import "./string.ab"
import "./time.ab"

// ---- <ctype.h>: the argument is an unsigned char value or EOF; every other value is outside the tables (0).
@export("isdigit")
fun libcIsdigit(c: int): int {
    val x = c & 4294967295
    if (x >= 48 && x <= 57) 1 else 0
}

@export("isupper")
fun libcIsupper(c: int): int {
    val x = c & 4294967295
    if (x >= 65 && x <= 90) 1 else 0
}

@export("islower")
fun libcIslower(c: int): int {
    val x = c & 4294967295
    if (x >= 97 && x <= 122) 1 else 0
}

@export("isblank")
fun libcIsblank(c: int): int {
    val x = c & 4294967295
    if (x == 32 || x == 9) 1 else 0
}

@export("iscntrl")
fun libcIscntrl(c: int): int {
    val x = c & 4294967295
    if (x < 32 || x == 127) 1 else 0
}

@export("isgraph")
fun libcIsgraph(c: int): int {
    val x = c & 4294967295
    if (x >= 33 && x <= 126) 1 else 0
}

@export("isprint")
fun libcIsprint(c: int): int {
    val x = c & 4294967295
    if (x >= 32 && x <= 126) 1 else 0
}

@export("ispunct")
fun libcIspunct(c: int): int {
    val x = c & 4294967295
    if (x >= 33 && x <= 126 && !((x >= 48 && x <= 57) || (x >= 65 && x <= 90) || (x >= 97 && x <= 122))) 1 else 0
}

@export("isascii")
fun libcIsascii(c: int): int = if ((c & 4294967295) < 128) 1 else 0

@export("toascii")
fun libcToascii(c: int): int = c & 127

@export("toupper")
fun libcToupper(c: int): int {
    val x = c & 4294967295
    if (x >= 97 && x <= 122) x - 32 else x
}

// ---- <string.h>
@export("strcpy")
trusted fun libcStrcpy(destination: int, source: int): int {
    var at = 0
    while (true) {
        val byte = ablaRuntimeLoadU8(source + at)
        ablaRuntimeStoreU8(destination + at, byte)
        if (byte == 0) return destination
        at = at + 1
    }
    destination
}

@export("strcat")
trusted fun libcStrcat(destination: int, source: int): int {
    libcStrcpy(destination + libcStrlen(destination), source)
    destination
}

@export("strncat")
trusted fun libcStrncat(destination: int, source: int, countSize: int): int {
    val count = libcSizeBound(countSize)
    val end = destination + libcStrlen(destination)
    var at = 0
    while (at < count && ablaRuntimeLoadU8(source + at) != 0) {
        ablaRuntimeStoreU8(end + at, ablaRuntimeLoadU8(source + at))
        at = at + 1
    }
    ablaRuntimeStoreU8(end + at, 0)
    destination
}

@export("strrchr")
trusted fun libcStrrchr(text: int, byte: int): int {
    val wanted = byte & 255
    var found = 0
    var at = 0
    while (true) {
        val c = ablaRuntimeLoadU8(text + at)
        if (c == wanted) found = text + at
        if (c == 0) return found
        at = at + 1
    }
    found
}

@export("memrchr")
trusted fun libcMemrchr(text: int, byte: int, count: int): int {
    val wanted = byte & 255
    var at = count
    while (at > 0) {
        at = at - 1
        if (ablaRuntimeLoadU8(text + at) == wanted) return text + at
    }
    0
}

@export("strnlen")
trusted fun libcStrnlen(text: int, limitSize: int): int {
    val limit = libcSizeBound(limitSize)
    var at = 0
    while (at < limit && ablaRuntimeLoadU8(text + at) != 0) at = at + 1
    at
}

@export("strndup")
trusted fun libcStrndup(text: int, limit: int): int {
    val size = libcStrnlen(text, limit)
    val copy = libcMalloc(size + 1)
    if (copy == 0) return 0
    var at = 0
    while (at < size) {
        ablaRuntimeStoreU8(copy + at, ablaRuntimeLoadU8(text + at))
        at = at + 1
    }
    ablaRuntimeStoreU8(copy + size, 0)
    copy
}

// The set of the bytes of `accept`, as a 256-entry table on the heap (a byte's membership), freed by the caller.
trusted fun libcByteSet(accept: int): int {
    val table = __ablaRuntimeHostHeapAllocate(256, true)
    var at = 0
    while (ablaRuntimeLoadU8(accept + at) != 0) {
        ablaRuntimeStoreU8(table + ablaRuntimeLoadU8(accept + at), 1)
        at = at + 1
    }
    table
}

@export("strspn")
trusted fun libcStrspn(text: int, accept: int): int {
    val table = libcByteSet(accept)
    var at = 0
    while (ablaRuntimeLoadU8(text + at) != 0 && ablaRuntimeLoadU8(table + ablaRuntimeLoadU8(text + at)) != 0) at = at + 1
    __ablaRuntimeHostHeapFree(table)
    at
}

@export("strcspn")
trusted fun libcStrcspn(text: int, reject: int): int {
    val table = libcByteSet(reject)
    var at = 0
    while (ablaRuntimeLoadU8(text + at) != 0 && ablaRuntimeLoadU8(table + ablaRuntimeLoadU8(text + at)) == 0) at = at + 1
    __ablaRuntimeHostHeapFree(table)
    at
}

@export("strpbrk")
trusted fun libcStrpbrk(text: int, accept: int): int {
    val at = libcStrcspn(text, accept)
    if (ablaRuntimeLoadU8(text + at) == 0) 0 else text + at
}

@export("strstr")
trusted fun libcStrstr(text: int, needle: int): int {
    val length = libcStrlen(needle)
    if (length == 0) return text
    var at = 0
    while (ablaRuntimeLoadU8(text + at) != 0) {
        var same = 0
        while (same < length && ablaRuntimeLoadU8(text + at + same) == ablaRuntimeLoadU8(needle + same)) same = same + 1
        if (same == length) return text + at
        // A text that ends inside the needle cannot hold it later either.
        if (ablaRuntimeLoadU8(text + at + same) == 0) return 0
        at = at + 1
    }
    0
}

@export("strcoll")
trusted fun libcStrcoll(left: int, right: int): int = libcStrcmp(left, right)

trusted fun libcFold(c: int): int = if (c >= 65 && c <= 90) c + 32 else c

@export("strcasecmp")
trusted fun libcStrcasecmp(left: int, right: int): int {
    var at = 0
    while (true) {
        val a = libcFold(ablaRuntimeLoadU8(left + at))
        val b = libcFold(ablaRuntimeLoadU8(right + at))
        if (a != b) return a - b
        if (a == 0) return 0
        at = at + 1
    }
    0
}

@export("strncasecmp")
trusted fun libcStrncasecmp(left: int, right: int, countSize: int): int {
    val count = libcSizeBound(countSize)
    var at = 0
    while (at < count) {
        val a = libcFold(ablaRuntimeLoadU8(left + at))
        val b = libcFold(ablaRuntimeLoadU8(right + at))
        if (a != b) return a - b
        if (a == 0) return 0
        at = at + 1
    }
    0
}

// strtok keeps the rest of the text between calls.
var libcTokenRest: int = 0

@export("strtok")
trusted fun libcStrtok(text: int, delimiters: int): int {
    var start = if (text != 0) text else libcTokenRest
    if (start == 0) return 0
    start = start + libcStrspn(start, delimiters)
    if (ablaRuntimeLoadU8(start) == 0) {
        libcTokenRest = 0
        return 0
    }
    val end = start + libcStrcspn(start, delimiters)
    if (ablaRuntimeLoadU8(end) == 0) {
        libcTokenRest = 0
    } else {
        ablaRuntimeStoreU8(end, 0)
        libcTokenRest = end + 1
    }
    start
}

// strerror: glibc's texts for the common errno values; "Unknown error N" for the rest.
@export("strerror")
trusted fun libcStrerror(code: int): int {
    val number = libcInt(code)
    val known = [
        "Success", "Operation not permitted", "No such file or directory", "No such process", "Interrupted system call",
        "Input/output error", "No such device or address", "Argument list too long", "Exec format error", "Bad file descriptor",
        "No child processes", "Resource temporarily unavailable", "Cannot allocate memory", "Permission denied", "Bad address",
        "Block device required", "Device or resource busy", "File exists", "Invalid cross-device link", "No such device",
        "Not a directory", "Is a directory", "Invalid argument", "Too many open files in system", "Too many open files",
        "Inappropriate ioctl for device", "Text file busy", "File too large", "No space left on device", "Illegal seek",
        "Read-only file system", "Too many links", "Broken pipe", "Numerical argument out of domain", "Numerical result out of range"]
    if (number >= 0 && number < known.size) return libcStrdupText(known[number])
    libcStrdupText("Unknown error $number")
}

// ---- <stdlib.h>
@export("atol")
trusted fun libcAtol(text: int): int = libcStrto(text, 0, 10, true, false)

@export("atoll")
trusted fun libcAtoll(text: int): int = libcStrto(text, 0, 10, true, false)

@export("atof")
trusted fun libcAtof(text: int): f64 = libcStrtodAt(text, 0)

// bsearch: the comparison is called through its C function pointer, the key first.
@export("bsearch")
trusted fun libcBsearch(key: int, base: int, count: int, size: int, compare: int): int {
    var low = 0
    var high = count
    while (low < high) {
        val middle = low + (high - low) / 2
        val element = base + middle * size
        val order = libcInt(ablaUnsafeCallAddressPointerPointer(compare, ablaRuntimePointerFromAddress(key),
            ablaRuntimePointerFromAddress(element)))
        if (order == 0) return element
        if (order < 0) high = middle else low = middle + 1
    }
    0
}

// rand and srand: glibc's TYPE_3 additive feedback generator (31 words, taps 3 and 0), so a seeded sequence matches glibc's, which programs
// and tests rely on.
var libcRandState: int = 0
var libcRandFront: int = 3
var libcRandRear: int = 0

trusted fun libcRandSeed(seed: int): void {
    if (libcRandState == 0) libcRandState = __ablaRuntimeHostHeapAllocate(31 * 4, true)
    var word = libcInt(seed & 4294967295)
    if (word == 0) word = 1
    ablaRuntimeStoreI32(libcRandState, word)
    var index = 1
    while (index < 31) {
        val high = word / 127773
        val low = word % 127773
        word = 16807 * low - 2836 * high
        if (word < 0) word = word + 2147483647
        ablaRuntimeStoreI32(libcRandState + index * 4, word)
        index = index + 1
    }
    libcRandFront = 3
    libcRandRear = 0
    // The first 310 outputs are discarded.
    var discard = 0
    while (discard < 310) {
        libcRandNext()
        discard = discard + 1
    }
    return
}

trusted fun libcRandNext(): int {
    val sum = (ablaRuntimeLoadI32(libcRandState + libcRandFront * 4) + ablaRuntimeLoadI32(libcRandState + libcRandRear * 4)) & 4294967295
    ablaRuntimeStoreI32(libcRandState + libcRandFront * 4, sum)
    libcRandFront = if (libcRandFront + 1 >= 31) 0 else libcRandFront + 1
    libcRandRear = if (libcRandRear + 1 >= 31) 0 else libcRandRear + 1
    sum >>> 1
}

@export("srand")
trusted fun libcSrand(seed: int): void {
    libcRandSeed(seed)
    return
}

@export("rand")
trusted fun libcRand(): int {
    if (libcRandState == 0) libcRandSeed(1)
    libcRandNext()
}
