// The C++ unwinder's entry points the statically linked compiler's libstdc++ references (#806 step C). LLVM 23.1.3's archives are built without
// exceptions (no personality routine, no throw, no catch), and libstdc++ throws only where LLVM treats the error as fatal (bad_alloc, length_error),
// so nothing here unwinds: each stub says so and ends the process, as an uncaught exception does. The two frame registration calls that LLVM's
// JIT memory manager makes for generated code are no-ops: with no unwinder there is nothing to register.
import "./stubs.ab"

@export("_Unwind_DeleteException")
trusted fun libcUnwind1(): int = libcMissing("_Unwind_DeleteException (C++ exceptions are not unwound in the static compiler)")

@export("_Unwind_GetDataRelBase")
trusted fun libcUnwind2(): int = libcMissing("_Unwind_GetDataRelBase (C++ exceptions are not unwound in the static compiler)")

