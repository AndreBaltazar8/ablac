trusted fun libcUnwind10(): int = libcMissing("_Unwind_SetGR (C++ exceptions are not unwound in the static compiler)")

@export("_Unwind_SetIP")
trusted fun libcUnwind11(): int = libcMissing("_Unwind_SetIP (C++ exceptions are not unwound in the static compiler)")

