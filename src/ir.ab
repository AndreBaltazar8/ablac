                )
            } else if (bootstrapIsSharedType(owner) &&
                expression.text == "clone") {
                result = this.emit("shared.clone", arguments[0], -1, "")
            } else if (bootstrapIsSharedType(owner) &&
                       expression.text == "get") {
                result = this.emit("shared.get", arguments[0], -1, "")
            } else if (bootstrapIsSharedType(owner) &&
                       expression.text == "downgrade") {
                result = this.emit("weak.create", arguments[0], -1, "")
            } else if (bootstrapIsWeakType(owner) &&
                       expression.text == "clone") {
                result = this.emit("weak.clone", arguments[0], -1, "")
            } else if (bootstrapIsWeakType(owner) &&
                       expression.text == "upgrade") {
                result = this.emit("weak.upgrade", arguments[0], -1, "")
            } else if (bootstrapIsWeakType(owner) &&
                       expression.text == "isAlive") {
                result = this.emit("weak.alive", arguments[0], -1, "")
            } else if (expression.text == "append" &&
                       bootstrapIsArrayType(owner)) {
                result = this.emitMany("array.append", arguments, "")
            } else if (expression.text == "slice" && owner == "string") {
                result = this.emitMany("string.slice", arguments, "")
            } else {
                var methodOwner = owner
                if (methodOwner == "unknown") {
                    methodOwner = this.methodOwner(expression.text)
                }
                val extensionOwner = this.lowerExtensionOwner(
                    methodOwner,
                    expression.text
                )
                if (extensionOwner != "") {
                    result = this.emitMany(
                        "call",
                        arguments,
                        "extension_${extensionOwner}_${expression.text}"
                    )
                } else if (methodOwner == "") this.errors = this.errors + 1
                else result = this.emitMany(
                    "call",
                    arguments,
                    "${methodOwner}_${expression.text}"
                )
            }
        }
        if (expression.kind == "member.assign") {
            val ownerPlace = this.lowerPlacePath(expression.children[0])
            val place = if (ownerPlace == "") ""
                else "$ownerPlace.${expression.text}"
            val receiver = if (place != "") {
                this.lowerPlaceProjection(expression.children[0])
            } else this.lowerExpression(expression.children[0])
            val value = this.lowerExpression(expression.children[1])
            val ownerType = this.lowerExpressionType(expression.children[0])
            val fieldType = this.lowerFieldType(
                ownerType,
                expression.text
            )
            if (this.lowerTypeIsAffine(fieldType)) {
                val previous = this.emitFieldGet(
                    receiver,
                    ownerType,
                    expression.text
                )
                this.emitAffineValueDrop(previous, fieldType)
            }
            result = this.emitFieldSet(
                receiver,
                value,
                ownerType,
                expression.text
            )
            if (place != "") {
                this.emitControl("place.set", -1, -1, -1, place)
            }
        }
        if (expression.kind == "unary-" || expression.kind == "unary!" ||
            expression.kind == "unary~") {
            val operand = this.lowerExpression(expression.children[0])
            var opcode = if (expression.kind == "unary-") "neg" else "not"
            if (expression.kind == "unary~") opcode = "bit.not"
            result = this.emit(opcode, operand, -1, "")
        }
        if (expression.kind == "unary+") {
            result = this.lowerExpression(expression.children[0])
        }
        if (
            expression.kind == "+" || expression.kind == "-" ||
            expression.kind == "*" || expression.kind == "/" ||
            expression.kind == "&" || expression.kind == "|" ||
            expression.kind == "^" || expression.kind == "<<" ||
            expression.kind == ">>" || expression.kind == ">>>" ||
            expression.kind == "==" || expression.kind == "!=" ||
            expression.kind == "<" || expression.kind == "<=" ||
            expression.kind == ">" || expression.kind == ">="
        ) {
            var opcode = expression.kind
            if ((expression.kind == "==" || expression.kind == "!=") &&
                this.lowerExpressionType(expression.children[0]) == "string" &&
                this.lowerExpressionType(expression.children[1]) == "string") {
                opcode = if (expression.kind == "==") {
                    "string.equal"
                } else "string.not.equal"
            }
            val left = this.lowerExpression(expression.children[0])
            val right = this.lowerExpression(expression.children[1])
            result = this.emit(opcode, left, right, "")
        }
        if (expression.kind == "&&" || expression.kind == "||") {
            result = this.lowerLogicalExpression(expression)
        }
        if (expression.kind == "if") {
            // Reserve the result name before lowering the condition. The
            // condition may itself contain an if expression; deriving both
            // names from the unchanged nextLabel created duplicate locals and
            // made otherwise valid nested conditionals fail IR verification.
            val temporaryId = this.allocateLabel()
            val temporary = "if_result_$temporaryId"
            this.emitControl(
                bootstrapIrLocalZeroOpcode(bootstrapIrRuntimeType(
                    this.declarations, this.lowerExpressionType(expression)
                )),
                -1, -1, -1, temporary
            )
            val condition = this.lowerExpression(expression.children[0])
            val thenLabel = this.allocateLabel()
            val elseLabel = this.allocateLabel()
            val mergeLabel = this.allocateLabel()
            this.emitControl("branch", condition, thenLabel, elseLabel, "")
            this.emitControl("label", -1, thenLabel, -1, "")
            val previousThenScope = this.enterLocalScope()
            this.addNullableRefinements(expression.children[0], true)
            val thenValue = this.lowerExpression(expression.children[1])
            this.leaveLocalScope(previousThenScope)
            this.emitControl("local.set", thenValue, -1, -1, temporary)
            this.emitControl("jump", -1, mergeLabel, -1, "")
            this.emitControl("label", -1, elseLabel, -1, "")
            var elseValue = -1
            if (expression.children[2].kind == "missing") {
                elseValue = this.emit("const.i64", -1, -1, "0")
            } else {
                val previousElseScope = this.enterLocalScope()
                this.addNullableRefinements(expression.children[0], false)
                elseValue = this.lowerExpression(expression.children[2])
                this.leaveLocalScope(previousElseScope)
            }
            this.emitControl("local.set", elseValue, -1, -1, temporary)
            this.emitControl("jump", -1, mergeLabel, -1, "")
            this.emitControl("label", -1, mergeLabel, -1, "")
            result = this.emit("local.load", -1, -1, temporary)
        }
        if (expression.kind == "while") {
            val conditionLabel = this.allocateLabel()
            val bodyLabel = this.allocateLabel()
            val mergeLabel = this.allocateLabel()
            val previousBreakLabel = this.breakLabel
            val previousContinueLabel = this.continueLabel
            val previousBreakScope = this.breakScope
            val previousContinueScope = this.continueScope
            this.breakLabel = mergeLabel
            this.continueLabel = conditionLabel
            this.breakScope = this.currentScope
            this.continueScope = this.currentScope
            this.emitControl("jump", -1, conditionLabel, -1, "")
            this.emitControl("label", -1, conditionLabel, -1, "")
            val condition = this.lowerExpression(expression.children[0])
            this.emitControl("branch", condition, bodyLabel, mergeLabel, "")
            this.emitControl("label", -1, bodyLabel, -1, "")
            this.lowerExpression(expression.children[1])
            this.emitControl("jump", -1, conditionLabel, -1, "")
            this.breakLabel = previousBreakLabel
            this.continueLabel = previousContinueLabel
            this.breakScope = previousBreakScope
            this.continueScope = previousContinueScope
            this.emitControl("label", -1, mergeLabel, -1, "")
            result = this.emit("const.void", -1, -1, "")
        }
        if (expression.kind == "do.while") {
            val bodyLabel = this.allocateLabel()
            val conditionLabel = this.allocateLabel()
            val mergeLabel = this.allocateLabel()
            val previousBreakLabel = this.breakLabel
            val previousContinueLabel = this.continueLabel
            val previousBreakScope = this.breakScope
            val previousContinueScope = this.continueScope
            this.breakLabel = mergeLabel
            this.continueLabel = conditionLabel
            this.breakScope = this.currentScope
            this.continueScope = this.currentScope
            this.emitControl("jump", -1, bodyLabel, -1, "")
            this.emitControl("label", -1, bodyLabel, -1, "")
            this.lowerExpression(expression.children[0])
            this.emitControl("jump", -1, conditionLabel, -1, "")
            this.emitControl("label", -1, conditionLabel, -1, "")
            val condition = this.lowerExpression(expression.children[1])
            this.emitControl("branch", condition, bodyLabel, mergeLabel, "")
            this.breakLabel = previousBreakLabel
            this.continueLabel = previousContinueLabel
            this.breakScope = previousBreakScope
            this.continueScope = previousContinueScope
            this.emitControl("label", -1, mergeLabel, -1, "")
            result = this.emit("const.void", -1, -1, "")
        }
        if (expression.kind == "for") {
            val sourceType = this.lowerExpressionType(expression.children[0])
            var elementType = bootstrapArrayElementType(sourceType)
            if (sourceType == "string") elementType = "i64"
            if (bootstrapIsGeneratorType(sourceType)) {
                elementType = bootstrapGeneratorElementType(sourceType)
            }
            val source = this.lowerExpression(expression.children[0])
            if (bootstrapIsGeneratorType(sourceType)) {
                this.emitResultMove(expression.children[0])
            }
            var length = -1
            var indexStorage = ""
            if (!bootstrapIsGeneratorType(sourceType)) {
                val lengthOpcode = if (sourceType == "string") {
                    "string.length"
                } else "array.length"
                length = this.emit(lengthOpcode, source, -1, "")
                indexStorage = "for_index_${this.nextLabel}"
                this.emitControl(
                    "local.zero.i64", -1, -1, -1, indexStorage
                )
                val zero = this.emit("const.i64", -1, -1, "0")
                this.emitControl("local.set", zero, -1, -1, indexStorage)
            }
            val conditionLabel = this.allocateLabel()
            val bodyLabel = this.allocateLabel()
            val incrementLabel = this.allocateLabel()
            val mergeLabel = this.allocateLabel()
            val previousBreakLabel = this.breakLabel
            val previousContinueLabel = this.continueLabel
            val previousBreakScope = this.breakScope
            val previousContinueScope = this.continueScope
            val loopScope = this.currentScope
            this.breakLabel = mergeLabel
            this.continueLabel = incrementLabel
            this.breakScope = loopScope
            this.continueScope = loopScope
            val previousScope = this.enterLocalScope()
            val iteratorStorage =
                "for_value_${this.nextValue}_${expression.text}"
            val iteratorCaptured = this.capturedByLambda(
                expression.children[1],
                expression.text
            )
            this.locals.append(expression.text)
            if (iteratorCaptured) {
                this.localTypes.append("cell:$elementType")
            } else this.localTypes.append(elementType)
            this.localStorage.append(iteratorStorage)
            this.localScopes.append(this.currentScope)
            this.localBorrowSources.append("")
            this.emitControl("jump", -1, conditionLabel, -1, "")
            this.emitControl("label", -1, conditionLabel, -1, "")
            var index = -1
            var more = -1
            if (bootstrapIsGeneratorType(sourceType)) {
                more = this.emit("generator.next", source, -1, "")
            } else {
                index = this.emit("local.load", -1, -1, indexStorage)
                more = this.emit("<", index, length, "")
            }
            this.emitControl("branch", more, bodyLabel, mergeLabel, "")
            this.emitControl("label", -1, bodyLabel, -1, "")
            val value = if (bootstrapIsGeneratorType(sourceType))
                this.emit("generator.value", source, -1, "")
            else if (sourceType == "string")
                this.emit("string.get", source, index, "")
            else this.emit("array.get", source, index, "")
            var iteratorValue = value
            if (iteratorCaptured) {
                iteratorValue = this.emit("cell.create", value, -1, "")
            }
            this.emit("local.declare", iteratorValue, -1, iteratorStorage)
            this.lowerExpression(expression.children[1])
            this.emitControl("jump", -1, incrementLabel, -1, "")
            this.breakLabel = previousBreakLabel
            this.continueLabel = previousContinueLabel
            this.breakScope = previousBreakScope
            this.continueScope = previousContinueScope
            this.leaveLocalScope(previousScope)
            this.emitControl("label", -1, incrementLabel, -1, "")
            if (!bootstrapIsGeneratorType(sourceType)) {
                val current = this.emit("local.load", -1, -1, indexStorage)
                val one = this.emit("const.i64", -1, -1, "1")
                val next = this.emit("+", current, one, "")
                this.emitControl("local.set", next, -1, -1, indexStorage)
            }
            this.emitControl("jump", -1, conditionLabel, -1, "")
            this.emitControl("label", -1, mergeLabel, -1, "")
            if (bootstrapIsGeneratorType(sourceType)) {
                this.emit("generator.drop", source, -1, "")
            }
            result = this.emit("const.void", -1, -1, "")
        }
        if (expression.kind == "break") {
            this.emitDropsThroughScope(this.breakScope)
            this.emitControl("jump", -1, this.breakLabel, -1, "")
            result = this.emit("const.void", -1, -1, "")
        }
        if (expression.kind == "continue") {
            this.emitDropsThroughScope(this.continueScope)
            this.emitControl("jump", -1, this.continueLabel, -1, "")
            result = this.emit("const.void", -1, -1, "")
        }
        if (expression.kind == "when") {
            val temporaryId = this.allocateLabel()
            val temporary = "when_result_$temporaryId"
            this.emitControl(
                bootstrapIrLocalZeroOpcode(bootstrapIrRuntimeType(
                    this.declarations, this.lowerExpressionType(expression)
                )),
                -1, -1, -1, temporary
            )
            val subject = this.lowerExpression(expression.children[0])
            val mergeLabel = this.allocateLabel()
            var branch = 1
            var hasElse = false
            while (branch + 1 < expression.children.size) {
                val match = expression.children[branch]
                val body = expression.children[branch + 1]
                if (match.kind == "missing") {
                    hasElse = true
                    val bodyValue = this.lowerExpression(body)
                    this.emitControl(
                        "local.set",
                        bodyValue,
                        -1,
                        -1,
                        temporary
                    )
                    this.emitControl("jump", -1, mergeLabel, -1, "")
                } else {
                    val matchValue = this.lowerExpression(match)
                    val condition = this.emit("==", subject, matchValue, "")
                    val bodyLabel = this.allocateLabel()
                    val nextLabel = this.allocateLabel()
                    this.emitControl(
                        "branch",
                        condition,
                        bodyLabel,
                        nextLabel,
                        ""
                    )
                    this.emitControl("label", -1, bodyLabel, -1, "")
                    val bodyValue = this.lowerExpression(body)
                    this.emitControl(
                        "local.set",
                        bodyValue,
                        -1,
                        -1,
                        temporary
                    )
                    this.emitControl("jump", -1, mergeLabel, -1, "")
                    this.emitControl("label", -1, nextLabel, -1, "")
                }
                branch = branch + 2
            }
            if (!hasElse) {
                this.emitControl("unreachable", -1, -1, -1, "")
            }
            this.emitControl("label", -1, mergeLabel, -1, "")
            result = this.emit("local.load", -1, -1, temporary)
        }
        // Do not recompute the type of every lowered node here. Type lookup is
        // intentionally simple during bootstrap and scans declaration tables;
        // doing it unconditionally amplifies whole-compiler memory use. Only
        // calls and the two loop forms can introduce a fresh diverging path at
        // this node. Divergence in an operand or branch has already emitted a
        // terminator while that child was lowered.
        var diverges = false
        if (expression.kind == "call" ||
            expression.kind == "member.call") {
            diverges = this.lowerCallDiverges(expression)
        }
        if (expression.kind == "while" &&
            expression.children[0].kind == "true" &&
            !bootstrapExpressionBreaksCurrentLoop(
                expression.children[1],
                0
            )) diverges = true
        if (expression.kind == "do.while" &&
            expression.children[1].kind == "true" &&
            !bootstrapExpressionBreaksCurrentLoop(
                expression.children[0],
                0
            )) diverges = true
        if (result >= 0 && diverges) {
            this.emitControl("unreachable", -1, -1, -1, "")
        }
        if (result < 0) {
            this.errors = this.errors + 1
            result = this.emit("invalid", -1, -1, expression.kind)
        }
        result
    }

    fun lowerFunctionDeclaration(
        declaration: BootstrapDeclaration,
        validationOnly: bool
    ): int {
        val functionSink: array<BootstrapIrFunction> = []
        val body: array<BootstrapInstruction> = []
        val functionLocals: array<string> = []
        val functionLocalTypes: array<string> = []
        val functionStorage: array<string> = []
        val functionScopes: array<int> = []
        val functionEvaluatedValues: array<BootstrapEvalValue> = []
        val functionEvaluatedResults: array<int> = []
        val functionImplicitResults: array<BootstrapExpression> = []
        this.collectImplicitResults(
            declaration.expression,
            functionImplicitResults
        )
        val functionParameters: array<string> = []
        val functionParameterTypes: array<string> = []
        val functionOwnedParameters: array<string> = []
        var defaultOffset = 0
        if (declaration.extensionOwner != "") {
            functionParameters.append("this")
            functionParameterTypes.append(declaration.extensionOwner)
            defaultOffset = 1
        }
        var functionParameter = 0
        while (functionParameter < declaration.parameters.size) {
            functionParameters.append(
                declaration.parameters[functionParameter]
            )
            functionParameterTypes.append(
                declaration.parameterTypes[functionParameter]
            )
            if (functionParameter < declaration.parameterKinds.size &&
                declaration.parameterKinds[functionParameter] == "own") {
                functionOwnedParameters.append(
                    declaration.parameters[functionParameter]
                )
            }
            functionParameter = functionParameter + 1
        }
        val functionLowerer = BootstrapLowerer(
            body,
            functionSink,
            functionParameters,
            functionParameterTypes,
            functionOwnedParameters,
            [],
            functionLocals,
            functionLocalTypes,
            functionStorage,
            functionScopes,
            [],
            [],
            [],
            [-1],
            0,
            this.declarations,
            this.affineTypes,
            this.neverCallNames,
            this.mutableReceivers,
            this.managedAliasBegins,
            this.managedAliasEnds,
            this.managedAliasSources,
            [],
            [],
            [],
            functionImplicitResults,
            "",
            functionEvaluatedValues,
            functionEvaluatedResults,
            this.compileInputPaths,
            this.compileInputContents,
            0,
            0,
            -1,
            -1,
            -1,
            -1,
            validationOnly,
            this.errors
        )
        var defaultIndex = 0
        while (defaultIndex < declaration.parameterDefaults.size) {
            val defaultValue = declaration.parameterDefaults[defaultIndex]
            if (defaultValue.kind != "missing") {
                val loweredDefault = functionLowerer.lowerExpression(
                    defaultValue
                )
                functionLowerer.emit(
                    "parameter.default",
                    loweredDefault,
                    defaultIndex + defaultOffset,
                    declaration.parameters[defaultIndex]
                )
            }
            defaultIndex = defaultIndex + 1
        }
        val result = functionLowerer.lowerExpression(declaration.expression)
        functionLowerer.emitOwnedParameterDrops()
        var functionName = declaration.name
        if (declaration.extensionOwner != "") {
            functionName =
                "extension_${declaration.extensionOwner}_${declaration.name}"
        } else functionName = functionName
        val loweredFunction = bootstrapFinalizeIrFunction(
            functionName,
            functionParameters,
            body,
            result,
            bootstrapIrRuntimeTypes(
                this.declarations, functionParameterTypes
            ),
            if (declaration.resultType == "inferred") {
                "unknown"
            } else bootstrapIrRuntimeType(
                this.declarations, declaration.resultType
            ),
            functionLowerer.localStorage,
            bootstrapIrRuntimeTypes(
                this.declarations, functionLowerer.localTypes
            ),
            bootstrapDeclarationHasAnnotation(declaration, "inline"),
            bootstrapDeclarationHasAnnotation(declaration, "noinline"),
            bootstrapDeclarationHasAnnotation(declaration, "naked"),
            bootstrapDeclarationStringAnnotation(declaration, "section")
        )
        val loweringErrors = functionLowerer.errors - this.errors
        val reportedFunction = BootstrapIrFunction(
            loweredFunction.name,
            loweredFunction.parameters,
            loweredFunction.instructions,
            loweredFunction.result,
            loweredFunction.blocks,
            loweredFunction.locals,
            loweredFunction.localTypes,
            loweredFunction.parameterTypes,
            loweredFunction.resultType,
            loweredFunction.inlineHint,
            loweredFunction.noinlineHint,
            loweredFunction.naked,
            loweredFunction.section,
            loweredFunction.verificationErrors + loweringErrors
        )
        functionSink.append(reportedFunction)
        if (!validationOnly) {
            var emitted = 0
            while (emitted < functionSink.size) {
                this.functions.append(functionSink[emitted])
                emitted = emitted + 1
            }
        }
        this.errors + reportedFunction.verificationErrors
    }

    fun lowerMethodDeclaration(
        owner: BootstrapDeclaration,
        method: BootstrapDeclaration,
        validationOnly: bool
    ): int {
        val functionSink: array<BootstrapIrFunction> = []
        val body: array<BootstrapInstruction> = []
        val functionLocals: array<string> = []
        val functionLocalTypes: array<string> = []
        val functionStorage: array<string> = []
        val functionScopes: array<int> = []
        val functionEvaluatedValues: array<BootstrapEvalValue> = []
        val functionEvaluatedResults: array<int> = []
        val methodImplicitResults: array<BootstrapExpression> = []
        this.collectImplicitResults(method.expression, methodImplicitResults)
        val methodParameters: array<string> = ["this"]
        val methodParameterTypes: array<string> = [owner.name]
        val methodOwnedParameters: array<string> = []
        var parameter = 0
        while (parameter < method.parameters.size) {
            methodParameters.append(method.parameters[parameter])
            methodParameterTypes.append(method.parameterTypes[parameter])
            if (parameter < method.parameterKinds.size &&
                method.parameterKinds[parameter] == "own") {
                methodOwnedParameters.append(method.parameters[parameter])
            }
            parameter = parameter + 1
        }
        val methodLowerer = BootstrapLowerer(
            body,
            functionSink,
            methodParameters,
            methodParameterTypes,
            methodOwnedParameters,
            [],
            functionLocals,
            functionLocalTypes,
            functionStorage,
            functionScopes,
            [],
            [],
            [],
            [-1],
            0,
            this.declarations,
            this.affineTypes,
            this.neverCallNames,
            this.mutableReceivers,
            this.managedAliasBegins,
            this.managedAliasEnds,
            this.managedAliasSources,
            [],
            [],
            [],
            methodImplicitResults,
            owner.name,
            functionEvaluatedValues,
            functionEvaluatedResults,
            this.compileInputPaths,
            this.compileInputContents,
            0,
            0,
            -1,
            -1,
            -1,
            -1,
            validationOnly,
            this.errors
        )
        var defaultIndex = 0
        while (defaultIndex < method.parameterDefaults.size) {
            val defaultValue = method.parameterDefaults[defaultIndex]
            if (defaultValue.kind != "missing") {
                val loweredDefault = methodLowerer.lowerExpression(
                    defaultValue
                )
                methodLowerer.emit(
                    "parameter.default",
                    loweredDefault,
                    defaultIndex + 1,
                    method.parameters[defaultIndex]
                )
            }
            defaultIndex = defaultIndex + 1
        }
        val methodResult = methodLowerer.lowerExpression(method.expression)
        methodLowerer.emitOwnedParameterDrops()
        val loweredMethod = bootstrapFinalizeIrFunction(
            "${owner.name}_${method.name}",
            methodParameters,
            body,
            methodResult,
            bootstrapIrRuntimeTypes(
                this.declarations, methodParameterTypes
            ),
            if (method.resultType == "inferred") {
                "unknown"
            } else bootstrapIrRuntimeType(
                this.declarations, method.resultType
            ),
            methodLowerer.localStorage,
            bootstrapIrRuntimeTypes(
                this.declarations, methodLowerer.localTypes
            ),
            bootstrapDeclarationHasAnnotation(method, "inline")
        )
        val loweringErrors = methodLowerer.errors - this.errors
        val reportedMethod = BootstrapIrFunction(
            loweredMethod.name,
            loweredMethod.parameters,
            loweredMethod.instructions,
            loweredMethod.result,
            loweredMethod.blocks,
            loweredMethod.locals,
            loweredMethod.localTypes,
            loweredMethod.parameterTypes,
            loweredMethod.resultType,
            loweredMethod.inlineHint,
            loweredMethod.noinlineHint,
            loweredMethod.naked,
            loweredMethod.section,
            loweredMethod.verificationErrors + loweringErrors
        )
        functionSink.append(reportedMethod)
        if (!validationOnly) {
            var emitted = 0
            while (emitted < functionSink.size) {
                this.functions.append(functionSink[emitted])
                emitted = emitted + 1
            }
        }
        this.errors + reportedMethod.verificationErrors
    }

    fun lowerCachedFunction(
        declaration: BootstrapDeclaration,
        key: string,
        contextFirst: int,
        contextSecond: int,
        var cache: BootstrapIrCacheState
    ): int {
        val first = bootstrapIrHashDeclaration(
            declaration, 17, 257, 1000000007
        )
        val second = bootstrapIrHashDeclaration(
            declaration, 97, 263, 1000000009
        )
        var existing = -1
        if (cache.enabled && this.errors == 0) existing = cache.find(
            key, first, second, contextFirst, contextSecond
        )
        var result = this.errors
        if (existing >= 0) {
            val functions = cache.snapshots[existing].functions
            var function = 0
            while (function < functions.size) {
                this.functions.append(bootstrapCloneIrFunction(
                    functions[function]
                ))
                function = function + 1
            }
            cache.reused = cache.reused + functions.size
        } else {
            val begin = this.functions.size
            result = this.lowerFunctionDeclaration(declaration, false)
            if (cache.enabled && result == 0) {
                val functions: array<BootstrapIrFunction> = []
                var function = begin
                while (function < this.functions.size) {
                    functions.append(bootstrapCloneIrFunction(
                        this.functions[function]
                    ))
                    function = function + 1
                }
                cache.publish(BootstrapIrFunctionSnapshot(
                    key,
                    first,
                    second,
                    contextFirst,
                    contextSecond,
                    functions
                ))
            }
        }
        result
    }

    fun lowerCachedMethod(
        owner: BootstrapDeclaration,
        method: BootstrapDeclaration,
        key: string,
        contextFirst: int,
        contextSecond: int,
        var cache: BootstrapIrCacheState
    ): int {
        val first = bootstrapIrHashDeclaration(
            method, 17, 257, 1000000007
        )
        val second = bootstrapIrHashDeclaration(
            method, 97, 263, 1000000009
        )
        var existing = -1
        if (cache.enabled && this.errors == 0) existing = cache.find(
            key, first, second, contextFirst, contextSecond
        )
        var result = this.errors
        if (existing >= 0) {
            val functions = cache.snapshots[existing].functions
            var function = 0
            while (function < functions.size) {
                this.functions.append(bootstrapCloneIrFunction(
                    functions[function]
                ))
                function = function + 1
            }
            cache.reused = cache.reused + functions.size
        } else {
            val begin = this.functions.size
            result = this.lowerMethodDeclaration(owner, method, false)
            if (cache.enabled && result == 0) {
                val functions: array<BootstrapIrFunction> = []
                var function = begin
                while (function < this.functions.size) {
                    functions.append(bootstrapCloneIrFunction(
                        this.functions[function]
                    ))
                    function = function + 1
                }
                cache.publish(BootstrapIrFunctionSnapshot(
                    key,
                    first,
                    second,
                    contextFirst,
                    contextSecond,
                    functions
                ))
            }
        }
        result
    }

    fun lower(
        parsed: BootstrapParseResult,
        contextFirst: int,
        contextSecond: int,
        var cache: BootstrapIrCacheState
    ): BootstrapIrProgram {
        val classes: array<BootstrapIrClass> = []
        val natives: array<BootstrapIrNative> = []
        var index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            if (declaration.kind == "class") {
                val fields: array<string> = []
                val fieldParameters: array<int> = []
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[parameter] == "val" ||
                         declaration.parameterKinds[parameter] == "var")) {
                        fields.append(declaration.parameters[parameter])
                        fieldParameters.append(parameter)
                    }
                    parameter = parameter + 1
                }
                classes.append(BootstrapIrClass(
                    declaration.name,
                    classes.size,
                    fields,
                    fieldParameters
                ))
            }
            // Native signatures are also the scalar ABI source of truth for
            // compiler intrinsics.  Keeping only C declarations here forced
            // inferred intrinsic results through the universal boxed-value
            // path even when the declaration returned int or bool.
            if (declaration.kind == "extern" &&
                (declaration.externalLibrary == "c" ||
                 declaration.externalLibrary == "intrinsic")) {
                val nativeParameters: array<string> = []
                var nativeParameter = 0
                while (nativeParameter < declaration.parameterTypes.size) {
                    nativeParameters.append(bootstrapIrRuntimeType(
                        parsed.declarations,
                        declaration.parameterTypes[nativeParameter]
                    ))
                    nativeParameter = nativeParameter + 1
                }
                natives.append(BootstrapIrNative(
                    declaration.name,
                    nativeParameters,
                    bootstrapIrRuntimeType(
                        parsed.declarations, declaration.resultType
                    ),
                    declaration.isNoEscape
                ))
            }
            index = index + 1
        }
        index = 0
        val borrowReturnCallNames = bootstrapBuildBorrowReturnCallNames(
            parsed.declarations
        )
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.expression.kind != "missing" &&
                (bootstrapDeclarationMayBindBorrow(
                    declaration,
                    borrowReturnCallNames
                ) || this.declarationHasManagedAlias(declaration))) {
                val checkpoint = runtimeMemoryCheckpoint()
                val validationErrors = this.lowerFunctionDeclaration(
                    declaration,
                    true
                )
                bootstrapSemanticUnit()
                this.errors = validationErrors
            }
            var validationMethodIndex = 0
            while (validationMethodIndex < declaration.methods.size) {
                val method = declaration.methods[validationMethodIndex]
                if (method.expression.kind != "missing" &&
                    bootstrapDeclarationMayBindBorrow(
                        method,
                        borrowReturnCallNames
                    ) || this.declarationHasManagedAlias(method)) {
                    val checkpoint = runtimeMemoryCheckpoint()
                    val validationErrors = this.lowerMethodDeclaration(
                        declaration,
                        method,
                        true
                    )
                    bootstrapSemanticUnit()
                    this.errors = validationErrors
                }
                validationMethodIndex = validationMethodIndex + 1
            }
            index = index + 1
        }
        index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            if (declaration.kind == "val" || declaration.kind == "var") {
                val value = this.lowerExpression(declaration.expression)
                this.emit("global.store", value, -1, declaration.name)
            }
            if (
                declaration.kind == "fun" &&
                declaration.expression.kind != "missing"
            ) {
                this.errors = this.lowerCachedFunction(
                    declaration,
                    "function:${declaration.extensionOwner}:${declaration.name}",
                    contextFirst,
                    contextSecond,
                    cache
                )
            }
            var methodIndex = 0
            while (methodIndex < declaration.methods.size) {
                val method = declaration.methods[methodIndex]
                if (method.expression.kind != "missing") {
                    this.errors = this.lowerCachedMethod(
                        declaration,
                        method,
                        "method:${declaration.name}:${method.name}",
                        contextFirst,
                        contextSecond,
                        cache
                    )
                }
                methodIndex = methodIndex + 1
            }
            index = index + 1
        }
        if (this.functions.size > 0 && this.instructions.size > 0) {
            val result = this.emit("const.void", -1, -1, "")
            val globalParameters: array<string> = []
            val globalFunction = bootstrapFinalizeIrFunction(
                "__bootstrap_globals",
                globalParameters,
                this.instructions,
                result,
                [],
                "void"
            )
            this.errors = this.errors + globalFunction.verificationErrors
            this.functions.append(globalFunction)
        }
        this.errors = this.errors + bootstrapAppendDropFunctions(
            this.functions,
            parsed.declarations,
            this.affineTypes
        )
        val globalNames: array<string> = []
        val globalTypes: array<string> = []
        val globalKinds: array<string> = []
        var global = 0
        while (global < parsed.declarations.size) {
            val declaration = parsed.declarations[global]
            if (declaration.kind == "val" || declaration.kind == "var") {
                globalNames.append(declaration.name)
                globalKinds.append(declaration.kind)
                // A delegated binding exposes the getter result but stores
                // its delegate object. The backend must size and classify the
                // global from that storage type, not the exposed scalar type.
                globalTypes.append(bootstrapIrRuntimeType(
                    parsed.declarations,
                    this.lowerStorageType(declaration.name)
                ))
            }
            global = global + 1
        }
        val runtimeFunctions: array<BootstrapIrFunction> = []
        var runtimeFunction = 0
        while (runtimeFunction < this.functions.size) {
            val function = this.functions[runtimeFunction]
            runtimeFunctions.append(BootstrapIrFunction(
                function.name,
                function.parameters,
                function.instructions,
                function.result,
                function.blocks,
                function.locals,
                bootstrapIrRuntimeTypes(
                    parsed.declarations, function.localTypes
                ),
                bootstrapIrRuntimeTypes(
                    parsed.declarations, function.parameterTypes
                ),
                bootstrapIrRuntimeType(
                    parsed.declarations, function.resultType
                ),
                function.inlineHint,
                function.noinlineHint,
                function.naked,
                function.section,
                function.verificationErrors
            ))
            runtimeFunction = runtimeFunction + 1
        }
        BootstrapIrProgram(
            this.instructions,
            runtimeFunctions,
            classes,
            natives,
            globalNames,
            globalTypes,
            globalKinds,
            this.compileInputPaths,
            this.compileInputContents,
            this.errors
        )
    }
}

fun bootstrapExpressionHasContractCall(
    expression: BootstrapExpression,
    names: array<string>
): bool {
    var found = false
    if (expression.kind == "call") {
        var name = 0
        while (!found && name < names.size) {
            if (expression.text == names[name]) found = true
            name = name + 1
        }
    }
    var child = 0
    while (!found && child < expression.children.size) {
        found = bootstrapExpressionHasContractCall(
            expression.children[child], names
        )
        child = child + 1
    }
    found
}

fun bootstrapParsedHasContractCall(parsed: BootstrapParseResult): bool {
    val names: array<string> = []
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val current = parsed.declarations[declaration]
        if (current.kind == "extern" && current.externalLibrary.size >= 9 &&
            current.externalLibrary.slice(0, 9) == "contract:") {
            names.append(current.name)
        }
        declaration = declaration + 1
    }
    var found = false
    declaration = 0
    while (!found && declaration < parsed.declarations.size) {
        val current = parsed.declarations[declaration]
        found = bootstrapExpressionHasContractCall(current.expression, names)
        var method = 0
        while (!found && method < current.methods.size) {
            found = bootstrapExpressionHasContractCall(
                current.methods[method].expression, names
            )
            method = method + 1
        }
        declaration = declaration + 1
    }
    found
}

fun bootstrapLowerParsedCached(
    parsed: BootstrapParseResult,
    analyzed: BootstrapSemanticResult,
    var cache: BootstrapIrCacheState
): BootstrapIrProgram {
    val instructions: array<BootstrapInstruction> = []
    val functions: array<BootstrapIrFunction> = []
    val parameters: array<string> = []
    val parameterTypes: array<string> = []
    val locals: array<string> = []
    val localTypes: array<string> = []
    val localStorage: array<string> = []
    val localScopes: array<int> = []
    val evaluatedValues: array<BootstrapEvalValue> = []
    val evaluatedResults: array<int> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    bootstrapMergeCompileInputs(
        compileInputPaths,
        compileInputContents,
        parsed.compileInputPaths,
        parsed.compileInputContents
    )
    val contextFirst = bootstrapIrContextFingerprint(
        parsed, analyzed, 31, 269, 1000000007
    )
    val contextSecond = bootstrapIrContextFingerprint(
        parsed, analyzed, 103, 271, 1000000009
    )
    if (bootstrapParsedHasContractCall(parsed)) BootstrapIrProgram(
        instructions,
        functions,
        [],
        [],
        [],
        [],
        [],
        compileInputPaths,
        compileInputContents,
        analyzed.errors
    ) else BootstrapLowerer(
        instructions,
        functions,
        parameters,
        parameterTypes,
        [],
        [],
        locals,
        localTypes,
        localStorage,
        localScopes,
        [],
        [],
        [],
        [-1],
        0,
        parsed.declarations,
        bootstrapBuildAffineTypeNames(parsed.declarations),
        bootstrapBuildNeverCallNames(parsed.declarations),
        analyzed.mutableReceivers,
        analyzed.managedAliasBegins,
        analyzed.managedAliasEnds,
        analyzed.managedAliasSources,
        [],
        [],
        [],
        [],
        "",
        evaluatedValues,
        evaluatedResults,
        compileInputPaths,
        compileInputContents,
        0,
        0,
        -1,
        -1,
        -1,
        -1,
        false,
        analyzed.errors
    ).lower(parsed, contextFirst, contextSecond, cache)
}

fun bootstrapLowerParsed(
    parsed: BootstrapParseResult,
    analyzed: BootstrapSemanticResult
): BootstrapIrProgram {
    val cache = bootstrapIrTransientState()
    bootstrapLowerParsedCached(parsed, analyzed, cache)
}

fun bootstrapLower(source: string): BootstrapIrProgram {
    val parsed = bootstrapParseStaged(source)
    bootstrapLowerParsed(parsed, bootstrapAnalyzeParsed(parsed))
}

fun bootstrapIrGeneratedProvenance(
    parsed: BootstrapParseResult,
    functionName: string
): string {
    var provenance = ""
    var declaration = 0
    while (declaration < parsed.declarations.size && provenance == "") {
        val candidate = parsed.declarations[declaration]
        if (candidate.name == functionName &&
            candidate.generatedNamespace != "") {
            provenance =
                "context[generated-namespace]: ${candidate.generatedNamespace}\nsource[generated-origin]:${candidate.generatedNamespace}:${candidate.generatedOriginBegin}:${candidate.generatedOriginEnd}\n"
        }
        declaration = declaration + 1
    }
    provenance
}

fun bootstrapExpressionContainsDelegateReplacement(
    expression: BootstrapExpression
): bool {
    var found = expression.kind == "delegate.assign"
    var child = 0
    while (!found && child < expression.children.size) {
        found = bootstrapExpressionContainsDelegateReplacement(
            expression.children[child]
        )
        child = child + 1
    }
    found
}

fun bootstrapIrFunctionContainsDelegateReplacement(
    parsed: BootstrapParseResult,
    functionName: string
): bool {
    var found = false
    var declaration = 0
    while (!found && declaration < parsed.declarations.size) {
        val candidate = parsed.declarations[declaration]
        if (candidate.name == functionName) {
            found = bootstrapExpressionContainsDelegateReplacement(
                candidate.expression
            )
        }
        var method = 0
        while (!found && method < candidate.methods.size) {
            val candidateMethod = candidate.methods[method]
            if ("${candidate.name}_${candidateMethod.name}" == functionName) {
                found = bootstrapExpressionContainsDelegateReplacement(
                    candidateMethod.expression
                )
            }
            method = method + 1
        }
        declaration = declaration + 1
    }
    found
}

fun bootstrapIrVerificationDiagnostics(
    program: BootstrapIrProgram,
    parsed: BootstrapParseResult,
    previousErrors: int,
    totalIrErrors: int
): string {
    var diagnostics = ""
    var classified = 0
    var index = 0
    while (index < program.functions.size) {
        val function = program.functions[index]
        val delegatedReplacement =
            bootstrapIrFunctionContainsDelegateReplacement(
                parsed,
                function.name
            )
        var functionError = 0
        while (functionError < function.verificationErrors &&
            classified < totalIrErrors) {
            if (delegatedReplacement && functionError == 0) {
                diagnostics =
                    "${diagnostics}error[E_DELEGATE_BORROW_CONFLICT]: delegate replacement in `${function.name}` conflicts with a live projected view\n"
            } else diagnostics =
                    "${diagnostics}error[E_IR_FUNCTION_VERIFICATION]: function `${function.name}` violated a typed IR invariant (failure ${functionError + 1} of ${function.verificationErrors})\n"
            diagnostics =
                "$diagnostics${bootstrapIrGeneratedProvenance(
                    parsed, function.name
                )}"
            functionError = functionError + 1
            classified = classified + 1
        }
        index = index + 1
    }
    val loweringErrors = program.errors - previousErrors - classified
    var loweringError = 0
    while (loweringError < loweringErrors && classified < totalIrErrors) {
        diagnostics =
            "${diagnostics}error[E_IR_UNCLASSIFIED]: typed IR lowering failed without a named function invariant (failure ${loweringError + 1} of $loweringErrors)\n"
        loweringError = loweringError + 1
        classified = classified + 1
    }
    while (classified < totalIrErrors) {
        diagnostics =
            "${diagnostics}error[E_IR_EMISSION]: LLVM IR emission or module verification failed (failure ${classified + 1} of $totalIrErrors)\n"
        classified = classified + 1
    }
    diagnostics
}

fun bootstrapPrintIr(program: BootstrapIrProgram): string {
    var output = ""
    var index = 0
    while (index < program.instructions.size) {
        val instruction = program.instructions[index]
        output = "$output%${instruction.result} = ${instruction.opcode}"
        if (instruction.text != "") output = "$output ${instruction.text}"
        if (instruction.left >= 0) output = "$output %${instruction.left}"
        if (instruction.right >= 0) output = "$output %${instruction.right}"
        output = "$output\n"
        index = index + 1
    }
    output
}
