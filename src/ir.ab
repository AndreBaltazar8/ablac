import "eval.ab"
import "staged_parser.ab"
import "abla/runtime/memory"

fun bootstrapGlobalCallResultType(
    declarations: array<BootstrapDeclaration>,
    name: string
): string {
    var result = name
    var index = 0
    while (index < declarations.size) {
        val declaration = declarations[index]
        if (declaration.extensionOwner == "" &&
            declaration.name == name &&
            (declaration.kind == "fun" || declaration.kind == "extern") &&
            declaration.resultType != "inferred") {
            result = bootstrapNormalizeType(declaration.resultType)
        }
        index = index + 1
    }
    result
}

fun bootstrapGlobalMethodResultType(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    name: string
): string {
    var result = "unknown"
    var index = 0
    while (index < declarations.size) {
        val declaration = declarations[index]
        if ((declaration.kind == "fun" || declaration.kind == "extern") &&
            declaration.extensionOwner == owner && declaration.name == name &&
            declaration.resultType != "inferred") {
            result = bootstrapNormalizeType(declaration.resultType)
        }
        if ((declaration.kind == "class" ||
             declaration.kind == "interface") &&
            declaration.name == owner) {
            var method = 0
            while (method < declaration.methods.size) {
                val candidate = declaration.methods[method]
                if (candidate.name == name &&
                    candidate.resultType != "inferred") {
                    result = bootstrapNormalizeType(candidate.resultType)
                }
                method = method + 1
            }
        }
        index = index + 1
    }
    result
}

fun bootstrapGlobalExpressionType(
    declarations: array<BootstrapDeclaration>,
    expression: BootstrapExpression,
    depth: int
): string {
    var result = "unknown"
    if (expression.kind == "integer") result = "i64"
    if (expression.kind == "float") result = "f64"
    if (expression.kind == "true" || expression.kind == "false") {
        result = "bool"
    }
    if (expression.kind == "string" ||
        expression.kind == "string.template") result = "string"
    if (expression.kind == "identifier" && depth < 64) {
        result = bootstrapGlobalValueTypeDepth(
            declarations, expression.text, depth + 1
        )
    }
    if (expression.kind == "call") result = bootstrapGlobalCallResultType(
        declarations, expression.text
    )
    if (expression.kind == "member.call" &&
        expression.children.size > 0 && depth < 64) {
        val owner = bootstrapGlobalExpressionType(
            declarations, expression.children[0], depth + 1
        )
        result = bootstrapGlobalMethodResultType(
            declarations, owner, expression.text
        )
    }
    if (expression.kind == "array") {
        result = "array:unknown"
        if (expression.children.size > 0) result =
            "array:${bootstrapGlobalExpressionType(
                declarations, expression.children[0], depth + 1
            )}"
    }
    if ((expression.kind == "unary-" || expression.kind == "unary+") &&
        expression.children.size > 0 && depth < 64) {
        val operand = bootstrapGlobalExpressionType(
            declarations, expression.children[0], depth + 1
        )
        val underlying = bootstrapScalarTypeUnderlying(
            declarations, operand
        )
        if (bootstrapIsNumericScalarType(underlying)) {
            result = underlying
        } else if (bootstrapIsNumericScalarType(operand)) result = operand
    }
    if (expression.kind == "unary~" &&
        expression.children.size > 0 && depth < 64) {
        val operand = bootstrapGlobalExpressionType(
            declarations, expression.children[0], depth + 1
        )
        val underlying = bootstrapScalarTypeUnderlying(
            declarations, operand
        )
        if (bootstrapIsIntegerScalarType(operand)) result = operand
        else if (bootstrapIsIntegerScalarType(underlying)) {
            result = underlying
        }
    }
    if (expression.kind == "unary!" && expression.children.size > 0) {
        result = "bool"
    }
    if ((expression.kind == "+" || expression.kind == "-" ||
         expression.kind == "*" || expression.kind == "/") &&
        expression.children.size > 1 && depth < 64) {
        val left = bootstrapGlobalExpressionType(
            declarations, expression.children[0], depth + 1
        )
        val right = bootstrapGlobalExpressionType(
            declarations, expression.children[1], depth + 1
        )
        val leftUnderlying = bootstrapScalarTypeUnderlying(
            declarations, left
        )
        val rightUnderlying = bootstrapScalarTypeUnderlying(
            declarations, right
        )
        val leftScalar = if (leftUnderlying == "") left else leftUnderlying
        val rightScalar = if (rightUnderlying == "") right else rightUnderlying
        if (leftScalar == rightScalar &&
            bootstrapIsNumericScalarType(leftScalar)) {
            result = leftScalar
        }
    }
    if ((expression.kind == "&" || expression.kind == "|" ||
         expression.kind == "^" || expression.kind == "<<" ||
         expression.kind == ">>" || expression.kind == ">>>") &&
        expression.children.size > 1) {
        val left = bootstrapGlobalExpressionType(
            declarations, expression.children[0], depth + 1
        )
        val right = bootstrapGlobalExpressionType(
            declarations, expression.children[1], depth + 1
        )
        val leftUnderlying = bootstrapScalarTypeUnderlying(
            declarations, left
        )
        val rightUnderlying = bootstrapScalarTypeUnderlying(
            declarations, right
        )
        val leftScalar = if (leftUnderlying == "") left else leftUnderlying
        val rightScalar = if (rightUnderlying == "") right else rightUnderlying
        if (leftScalar == rightScalar &&
            bootstrapIsIntegerScalarType(leftScalar)) result = leftScalar
    }
    if (expression.kind == "==" || expression.kind == "!=" ||
        expression.kind == "<" || expression.kind == "<=" ||
        expression.kind == ">" || expression.kind == ">=" ||
        expression.kind == "&&" || expression.kind == "||") {
        result = "bool"
    }
    result
}

fun bootstrapGlobalValueTypeDepth(
    declarations: array<BootstrapDeclaration>,
    name: string,
    depth: int
): string {
    var result = bootstrapGlobalFunctionType(declarations, name)
    var index = 0
    while (result == "unknown" && index < declarations.size && depth < 64) {
        val declaration = declarations[index]
        if ((declaration.kind == "val" || declaration.kind == "var" ||
             declaration.kind == "compile.val" ||
             declaration.kind == "compile.var") &&
            declaration.name == name) {
            if (declaration.resultType != "inferred") {
                result = bootstrapNormalizeType(declaration.resultType)
            } else result = bootstrapGlobalExpressionType(
                declarations, declaration.expression, depth + 1
            )
        }
        index = index + 1
    }
    result
}

fun bootstrapGlobalValueType(
    declarations: array<BootstrapDeclaration>,
    name: string
): string = bootstrapGlobalValueTypeDepth(declarations, name, 0)

// Nominal scalar types remain distinct through parsing, semantic analysis,
// overload resolution, and extension lookup. Once calls have been resolved,
// their IR storage is exactly the declared primitive representation.
fun bootstrapIrRuntimeType(
    declarations: array<BootstrapDeclaration>,
    type: string
): string {
    val normalized = bootstrapNormalizeType(type)
    val underlying = bootstrapScalarTypeUnderlying(
        declarations, normalized
    )
    if (underlying == "") normalized else underlying
}

fun bootstrapIrRuntimeTypes(
    declarations: array<BootstrapDeclaration>,
    types: array<string>
): array<string> {
    val result: array<string> = []
    var index = 0
    while (index < types.size) {
        result.append(bootstrapIrRuntimeType(declarations, types[index]))
        index = index + 1
    }
    result
}

class BootstrapInstruction(
    val opcode: string,
    val result: int,
    val left: int,
    val right: int,
    val text: string,
    val target: int,
    val alternate: int,
    val operands: array<int>,
    // Structured string operands avoid flattening and re-slicing large text
    // payloads such as architecture-owned assembly blocks.
    val texts: array<string>
)

class BootstrapIrProgram(
    val instructions: array<BootstrapInstruction>,
    val functions: array<BootstrapIrFunction>,
    val classes: array<BootstrapIrClass>,
    val natives: array<BootstrapIrNative>,
    val globalNames: array<string>,
    val globalTypes: array<string>,
    val globalKinds: array<string>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    val errors: int
)

class BootstrapIrNative(
    val name: string,
    val parameterTypes: array<string>,
    val resultType: string,
    val isNoEscape: bool
)

class BootstrapIrBlock(
    val label: int,
    val begin: int,
    val end: int,
    val successors: array<int>,
    val predecessors: array<int>,
    var reachable: bool
)

class BootstrapIrLocal(
    val name: string,
    val declaration: int,
    val block: int,
    val initialized: bool
)

class BootstrapIrFunction(
    val name: string,
    val parameters: array<string>,
    val instructions: array<BootstrapInstruction>,
    val result: int,
    val blocks: array<BootstrapIrBlock>,
    val locals: array<BootstrapIrLocal>,
    // Declared source types aligned with `locals`. Keeping this information
    // through lowering lets backends represent scalar locals natively instead
    // of rediscovering their type from whichever control-flow path happens to
    // initialize them first.
    val localTypes: array<string>,
    val parameterTypes: array<string>,
    val resultType: string,
    val inlineHint: bool,
    val noinlineHint: bool,
    // Function code-generation policy is independent from body operations and
    // from symbol linkage/export policy.
    val naked: bool,
    // Optional target object-file section. This is a generic linker/codegen
    // property; target packages choose section names and policies.
    val section: string,
    val verificationErrors: int
)

class BootstrapIrFunctionSnapshot(
    val key: string,
    val declarationFirst: int,
    val declarationSecond: int,
    val contextFirst: int,
    val contextSecond: int,
    val functions: array<BootstrapIrFunction>
)

// Long-lived commands retain lowered functions, not evaluator state. Cache
// keys include the complete declaration tree and every graph-wide fact that
// can affect lowering. This keeps reuse sound while stable function names let
// the LLVM emitter assign fresh graph-local numeric IDs on every build.
class BootstrapIrCacheState(
    val snapshots: array<BootstrapIrFunctionSnapshot>,
    val enabled: bool,
    var reused: int,
    var refreshed: int
) {
    fun beginBuild(): void {
        this.reused = 0
        this.refreshed = 0
        bootstrapSemanticUnit()
    }

    fun find(
        key: string,
        declarationFirst: int,
        declarationSecond: int,
        contextFirst: int,
        contextSecond: int
    ): int {
        var result = -1
        var index = 0
        while (index < this.snapshots.size && result < 0) {
            val snapshot = this.snapshots[index]
            if (snapshot.key == key &&
                snapshot.declarationFirst == declarationFirst &&
                snapshot.declarationSecond == declarationSecond &&
                snapshot.contextFirst == contextFirst &&
                snapshot.contextSecond == contextSecond) result = index
            index = index + 1
        }
        result
    }

    fun publish(snapshot: BootstrapIrFunctionSnapshot): void {
        var existing = -1
        var index = 0
        while (index < this.snapshots.size && existing < 0) {
            if (this.snapshots[index].key == snapshot.key) existing = index
            index = index + 1
        }
        if (existing >= 0) {
            this.snapshots[existing] = snapshot
            0
        } else {
            this.snapshots.append(snapshot)
            0
        }
        this.refreshed = this.refreshed + snapshot.functions.size
        bootstrapSemanticUnit()
    }
}

fun bootstrapIrCacheState(): BootstrapIrCacheState =
    BootstrapIrCacheState([], true, 0, 0)

fun bootstrapIrTransientState(): BootstrapIrCacheState =
    BootstrapIrCacheState([], false, 0, 0)

fun bootstrapCloneIrIntegers(values: array<int>): array<int> {
    val result: array<int> = []
    var index = 0
    while (index < values.size) {
        result.append(values[index])
        index = index + 1
    }
    result
}

fun bootstrapCloneIrStrings(values: array<string>): array<string> {
    val result: array<string> = []
    var index = 0
    while (index < values.size) {
        result.append(values[index])
        index = index + 1
    }
    result
}

fun bootstrapCloneIrFunction(
    function: BootstrapIrFunction
): BootstrapIrFunction {
    val parameters: array<string> = []
    var index = 0
    while (index < function.parameters.size) {
        parameters.append(function.parameters[index])
        index = index + 1
    }
    val instructions: array<BootstrapInstruction> = []
    index = 0
    while (index < function.instructions.size) {
        val instruction = function.instructions[index]
        instructions.append(BootstrapInstruction(
            instruction.opcode,
            instruction.result,
            instruction.left,
            instruction.right,
            instruction.text,
            instruction.target,
            instruction.alternate,
            bootstrapCloneIrIntegers(instruction.operands),
            bootstrapCloneIrStrings(instruction.texts)
        ))
        index = index + 1
    }
    val blocks: array<BootstrapIrBlock> = []
    index = 0
    while (index < function.blocks.size) {
        val block = function.blocks[index]
        blocks.append(BootstrapIrBlock(
            block.label,
            block.begin,
            block.end,
            bootstrapCloneIrIntegers(block.successors),
            bootstrapCloneIrIntegers(block.predecessors),
            block.reachable
        ))
        index = index + 1
    }
    val locals: array<BootstrapIrLocal> = []
    index = 0
    while (index < function.locals.size) {
        val local = function.locals[index]
        locals.append(BootstrapIrLocal(
            local.name,
            local.declaration,
            local.block,
            local.initialized
        ))
        index = index + 1
    }
    BootstrapIrFunction(
        function.name,
        parameters,
        instructions,
        function.result,
        blocks,
        locals,
        bootstrapCloneIrStrings(function.localTypes),
        bootstrapCloneIrStrings(function.parameterTypes),
        function.resultType,
        function.inlineHint,
        function.noinlineHint,
        function.naked,
        function.section,
        function.verificationErrors
    )
}

fun bootstrapIrHashText(
    hash: int,
    text: string,
    factor: int,
    modulus: int
): int {
    var result = hash
    var index = 0
    while (index < text.size) {
        result = result * factor + text[index] + 1
        result = result - (result / modulus) * modulus
        index = index + 1
    }
    result
}

fun bootstrapIrHashExpression(
    expression: BootstrapExpression,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = bootstrapIrHashText(
        bootstrapIrHashText(seed, expression.kind, factor, modulus),
        expression.text,
        factor,
        modulus
    )
    hash = hash * factor + expression.begin + 1
    hash = hash - (hash / modulus) * modulus
    hash = hash * factor + expression.end + 1
    hash = hash - (hash / modulus) * modulus
    var child = 0
    while (child < expression.children.size) {
        hash = bootstrapIrHashExpression(
            expression.children[child],
            hash,
            factor,
            modulus
        )
        child = child + 1
    }
    hash
}

fun bootstrapIrHashDeclaration(
    declaration: BootstrapDeclaration,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = bootstrapIrHashText(seed, declaration.kind, factor, modulus)
    hash = bootstrapIrHashText(hash, declaration.name, factor, modulus)
    hash = bootstrapIrHashText(hash, declaration.extensionOwner, factor, modulus)
    hash = bootstrapIrHashText(hash, declaration.resultType, factor, modulus)
    hash = bootstrapIrHashText(hash, declaration.externalLibrary, factor, modulus)
    if (declaration.isTrusted) {
        hash = bootstrapIrHashText(hash, "trusted", factor, modulus)
    }
    if (declaration.isResource) {
        hash = bootstrapIrHashText(hash, "resource", factor, modulus)
    }
    if (declaration.isNoEscape) {
        hash = bootstrapIrHashText(hash, "noescape", factor, modulus)
    }
    var annotation = 0
    while (annotation < declaration.annotations.size) {
        hash = bootstrapIrHashText(
            hash,
            declaration.annotations[annotation],
            factor,
            modulus
        )
        if (annotation < declaration.annotationArguments.size) {
            hash = bootstrapIrHashExpression(
                declaration.annotationArguments[annotation],
                hash,
                factor,
                modulus
            )
        }
        annotation = annotation + 1
    }
    hash = bootstrapIrHashExpression(
        declaration.expression,
        hash,
        factor,
        modulus
    )
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        hash = bootstrapIrHashText(
            hash,
            declaration.parameters[parameter],
            factor,
            modulus
        )
        if (parameter < declaration.parameterTypes.size) {
            hash = bootstrapIrHashText(
                hash,
                declaration.parameterTypes[parameter],
                factor,
                modulus
            )
        }
        if (parameter < declaration.parameterKinds.size) {
            hash = bootstrapIrHashText(
                hash,
                declaration.parameterKinds[parameter],
                factor,
                modulus
            )
        }
        if (parameter < declaration.parameterDefaults.size) {
            hash = bootstrapIrHashExpression(
                declaration.parameterDefaults[parameter],
                hash,
                factor,
                modulus
            )
        }
        parameter = parameter + 1
    }
    hash
}

fun bootstrapDeclarationHasAnnotation(
    declaration: BootstrapDeclaration,
    name: string
): bool {
    var found = false
    var index = 0
    while (index < declaration.annotations.size) {
        if (declaration.annotations[index] == name) found = true
        index = index + 1
    }
    found
}

fun bootstrapDeclarationStringAnnotation(
    declaration: BootstrapDeclaration,
    name: string
): string {
    var result = ""
    var index = 0
    while (index < declaration.annotations.size) {
        if (declaration.annotations[index] == name &&
            index < declaration.annotationArguments.size &&
            declaration.annotationArguments[index].kind == "string") {
            result = declaration.annotationArguments[index].text
        }
        index = index + 1
    }
    result
}

fun bootstrapIrContextFingerprint(
    parsed: BootstrapParseResult,
    analyzed: BootstrapSemanticResult,
    seed: int,
    factor: int,
    modulus: int
): int {
    var hash = seed
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        hash = bootstrapIrHashText(hash, found.kind, factor, modulus)
        hash = bootstrapIrHashText(hash, found.name, factor, modulus)
        hash = bootstrapIrHashText(hash, found.extensionOwner, factor, modulus)
        hash = bootstrapIrHashText(hash, found.resultType, factor, modulus)
        hash = bootstrapIrHashText(
            hash,
            found.externalLibrary,
            factor,
            modulus
        )
        if (found.isTrusted) {
            hash = bootstrapIrHashText(hash, "trusted", factor, modulus)
        }
        if (found.isResource) {
            hash = bootstrapIrHashText(hash, "resource", factor, modulus)
        }
        if (found.isNoEscape) {
            hash = bootstrapIrHashText(hash, "noescape", factor, modulus)
        }
        var annotation = 0
        while (annotation < found.annotations.size) {
            hash = bootstrapIrHashText(
                hash,
                found.annotations[annotation],
                factor,
                modulus
            )
            if (annotation < found.annotationArguments.size) {
                hash = bootstrapIrHashExpression(
                    found.annotationArguments[annotation],
                    hash,
                    factor,
                    modulus
                )
            }
            annotation = annotation + 1
        }
        var parameter = 0
        while (parameter < found.parameterTypes.size) {
            hash = bootstrapIrHashText(
                hash,
                found.parameterTypes[parameter],
                factor,
                modulus
            )
            if (parameter < found.parameterKinds.size) {
                hash = bootstrapIrHashText(
                    hash,
                    found.parameterKinds[parameter],
                    factor,
                    modulus
                )
            }
            parameter = parameter + 1
        }
        // Global initializer types and class layouts are graph ABI inputs.
        if (found.kind == "val" || found.kind == "var" ||
            found.kind == "class" || found.kind == "resource.class") {
            hash = bootstrapIrHashDeclaration(
                found,
                hash,
                factor,
                modulus
            )
        }
        var method = 0
        while (method < found.methods.size) {
            val member = found.methods[method]
            hash = bootstrapIrHashText(hash, member.name, factor, modulus)
            annotation = 0
            while (annotation < member.annotations.size) {
                hash = bootstrapIrHashText(
                    hash,
                    member.annotations[annotation],
                    factor,
                    modulus
                )
                if (annotation < member.annotationArguments.size) {
                    hash = bootstrapIrHashExpression(
                        member.annotationArguments[annotation],
                        hash,
                        factor,
                        modulus
                    )
                }
                annotation = annotation + 1
            }
            hash = bootstrapIrHashText(
                hash,
                member.resultType,
                factor,
                modulus
            )
            parameter = 0
            while (parameter < member.parameterTypes.size) {
                hash = bootstrapIrHashText(
                    hash,
                    member.parameterTypes[parameter],
                    factor,
                    modulus
                )
                if (parameter < member.parameterKinds.size) {
                    hash = bootstrapIrHashText(
                        hash,
                        member.parameterKinds[parameter],
                        factor,
                        modulus
                    )
                }
                parameter = parameter + 1
            }
            method = method + 1
        }
        declaration = declaration + 1
    }
    var mutable = 0
    while (mutable < analyzed.mutableReceivers.owners.size) {
        hash = bootstrapIrHashText(
            hash,
            analyzed.mutableReceivers.owners[mutable],
            factor,
            modulus
        )
        hash = bootstrapIrHashText(
            hash,
            analyzed.mutableReceivers.methods[mutable],
            factor,
            modulus
        )
        mutable = mutable + 1
    }
    var alias = 0
    while (alias < analyzed.managedAliasBegins.size) {
        hash = hash * factor + analyzed.managedAliasBegins[alias] + 1
        hash = hash - (hash / modulus) * modulus
        hash = hash * factor + analyzed.managedAliasEnds[alias] + 1
        hash = hash - (hash / modulus) * modulus
        hash = bootstrapIrHashText(
            hash,
            analyzed.managedAliasSources[alias],
            factor,
            modulus
        )
        alias = alias + 1
    }
    hash
}

class BootstrapIrClass(
    val name: string,
    val id: int,
    val fields: array<string>,
    val fieldParameters: array<int>
)

fun bootstrapIrIsTerminator(opcode: string): bool =
    opcode == "jump" || opcode == "branch" || opcode == "return" ||
    opcode == "unreachable"

fun bootstrapIrBlockForLabel(
    blocks: array<BootstrapIrBlock>,
    label: int
): int {
    var found = -1
    var index = 0
    while (index < blocks.size) {
        if (blocks[index].label == label) found = index
        index = index + 1
    }
    found
}

fun bootstrapBuildIrBlocks(
    instructions: array<BootstrapInstruction>
): array<BootstrapIrBlock> {
    val begins: array<int> = [0]
    val labels: array<int> = [-1]
    var index = 0
    while (index < instructions.size) {
        val instruction = instructions[index]
        if (instruction.opcode == "label") {
            if (index == 0) {
                labels[0] = instruction.target
                bootstrapSemanticUnit()
            } else {
                begins.append(index)
                labels.append(instruction.target)
                bootstrapSemanticUnit()
            }
        }
        index = index + 1
    }

    val blocks: array<BootstrapIrBlock> = []
    var block = 0
    while (block < begins.size) {
        val begin = begins[block]
        var end = instructions.size
        if (block + 1 < begins.size) end = begins[block + 1]
        val successors: array<int> = []
        if (end > begin) {
            val terminator = instructions[end - 1]
            if (terminator.opcode == "jump") {
                successors.append(terminator.target)
            }
            if (terminator.opcode == "branch") {
                successors.append(terminator.target)
                successors.append(terminator.alternate)
            }
        }
        blocks.append(BootstrapIrBlock(
            labels[block],
            begin,
            end,
            successors,
            [],
            false
        ))
        block = block + 1
    }

    var maximumLabel = -1
    block = 0
    while (block < blocks.size) {
        if (blocks[block].label > maximumLabel) {
            maximumLabel = blocks[block].label
        }
        block = block + 1
    }
    val labelBlocks: array<int> = []
    var label = 0
    while (label <= maximumLabel) {
        labelBlocks.append(-1)
        label = label + 1
    }
    block = 0
    while (block < blocks.size) {
        if (blocks[block].label >= 0) {
            labelBlocks[blocks[block].label] = block
        }
        block = block + 1
    }
    block = 0
    while (block < blocks.size) {
        var successor = 0
        while (successor < blocks[block].successors.size) {
            val successorLabel = blocks[block].successors[successor]
            if (successorLabel >= 0 && successorLabel < labelBlocks.size) {
                val target = labelBlocks[successorLabel]
                if (target >= 0) blocks[target].predecessors.append(block)
            }
            successor = successor + 1
        }
        block = block + 1
    }

    if (blocks.size > 0) blocks[0].reachable = true
    var changed = true
    while (changed) {
        changed = false
        block = 0
        while (block < blocks.size) {
            if (blocks[block].reachable) {
                var successor = 0
                while (successor < blocks[block].successors.size) {
                    val successorLabel =
                        blocks[block].successors[successor]
                    var target = -1
                    if (successorLabel >= 0 &&
                        successorLabel < labelBlocks.size) {
                        target = labelBlocks[successorLabel]
                    }
                    if (target >= 0 && !blocks[target].reachable) {
                        blocks[target].reachable = true
                        changed = true
                    }
                    successor = successor + 1
                }
            }
            block = block + 1
        }
    }
    blocks
}

fun bootstrapIrHasValue(definitions: array<bool>, value: int): bool {
    value < 0 || (value < definitions.size && definitions[value])
}

fun bootstrapIrValueDominates(
    used: int,
    block: int,
    instructionIndex: int,
    definitionBlocks: array<int>,
    definitionInstructions: array<int>,
    immediateDominators: array<int>
): bool {
    var valid = used >= 0 && used < definitionBlocks.size &&
        definitionBlocks[used] >= 0
    if (valid) {
        val definitionBlock = definitionBlocks[used]
        if (definitionBlock == block) {
            valid = definitionInstructions[used] < instructionIndex
        } else {
            var cursor = block
            while (cursor >= 0 && cursor != definitionBlock &&
                cursor < immediateDominators.size &&
                immediateDominators[cursor] != cursor) {
                cursor = immediateDominators[cursor]
            }
            valid = cursor == definitionBlock
        }
    }
    valid
}

fun bootstrapIrIntersectDominators(
    left: int,
    right: int,
    immediateDominators: array<int>,
    reversePostorder: array<int>
): int {
    var leftFinger = left
    var rightFinger = right
    while (leftFinger != rightFinger) {
        while (reversePostorder[leftFinger] > reversePostorder[rightFinger]) {
            leftFinger = immediateDominators[leftFinger]
        }
        while (reversePostorder[rightFinger] > reversePostorder[leftFinger]) {
            rightFinger = immediateDominators[rightFinger]
        }
    }
    leftFinger
}

fun bootstrapBuildImmediateDominators(
    blocks: array<BootstrapIrBlock>
): array<int> {
    var maximumLabel = -1
    var block = 0
    while (block < blocks.size) {
        if (blocks[block].label > maximumLabel) {
            maximumLabel = blocks[block].label
        }
        block = block + 1
    }

    val labelBlocks: array<int> = []
    var label = 0
    while (label <= maximumLabel) {
        labelBlocks.append(-1)
        label = label + 1
    }
    block = 0
    while (block < blocks.size) {
        if (blocks[block].label >= 0) {
            labelBlocks[blocks[block].label] = block
        }
        block = block + 1
    }

    val visited: array<bool> = []
    val stackBlocks: array<int> = []
    val stackEdges: array<int> = []
    block = 0
    while (block < blocks.size) {
        visited.append(false)
        stackBlocks.append(0)
        stackEdges.append(0)
        block = block + 1
    }
    val postorder: array<int> = []
    var stackSize = 0
    if (blocks.size > 0) {
        visited[0] = true
        stackBlocks[0] = 0
        stackEdges[0] = 0
        stackSize = 1
    }
    while (stackSize > 0) {
        val top = stackSize - 1
        val source = stackBlocks[top]
        val edge = stackEdges[top]
        if (edge < blocks[source].successors.size) {
            stackEdges[top] = edge + 1
            val successorLabel = blocks[source].successors[edge]
            var target = -1
            if (successorLabel >= 0 && successorLabel < labelBlocks.size) {
                target = labelBlocks[successorLabel]
            }
            if (target >= 0 && !visited[target]) {
                visited[target] = true
                stackBlocks[stackSize] = target
                stackEdges[stackSize] = 0
                stackSize = stackSize + 1
            }
            bootstrapSemanticUnit()
        } else {
            postorder.append(source)
            stackSize = stackSize - 1
            bootstrapSemanticUnit()
        }
    }

    val reversePostorderBlocks: array<int> = []
    val reversePostorder: array<int> = []
    block = 0
    while (block < blocks.size) {
        reversePostorder.append(-1)
        block = block + 1
    }
    var position = 0
    while (position < postorder.size) {
        val source = postorder[postorder.size - position - 1]
        reversePostorderBlocks.append(source)
        reversePostorder[source] = position
        position = position + 1
    }

    val immediateDominators: array<int> = []
    block = 0
    while (block < blocks.size) {
        immediateDominators.append(-1)
        block = block + 1
    }
    if (reversePostorderBlocks.size > 0) {
        val entry = reversePostorderBlocks[0]
        immediateDominators[entry] = entry
    }
    var changed = true
    while (changed) {
        changed = false
        position = 1
        while (position < reversePostorderBlocks.size) {
            block = reversePostorderBlocks[position]
            var newDominator = -1
            var predecessor = 0
            while (predecessor < blocks[block].predecessors.size) {
                val source = blocks[block].predecessors[predecessor]
                if (source >= 0 && source < immediateDominators.size &&
                    immediateDominators[source] >= 0) {
                    if (newDominator < 0) newDominator = source
                    else newDominator = bootstrapIrIntersectDominators(
                        source,
                        newDominator,
                        immediateDominators,
                        reversePostorder
                    )
                }
                predecessor = predecessor + 1
            }
            if (newDominator >= 0 &&
                immediateDominators[block] != newDominator) {
                immediateDominators[block] = newDominator
                changed = true
            }
            position = position + 1
        }
    }
    immediateDominators
}

fun bootstrapVerifyIrDominance(
    instructions: array<BootstrapInstruction>,
    blocks: array<BootstrapIrBlock>,
    immediateDominators: array<int>
): int {
    var errors = 0
    var maximumValue = -1
    var instructionIndex = 0
    while (instructionIndex < instructions.size) {
        if (instructions[instructionIndex].result > maximumValue) {
            maximumValue = instructions[instructionIndex].result
        }
        instructionIndex = instructionIndex + 1
    }
    val definitionBlocks: array<int> = []
    val definitionInstructions: array<int> = []
    var value = 0
    while (value <= maximumValue) {
        definitionBlocks.append(-1)
        definitionInstructions.append(-1)
        value = value + 1
    }
    var block = 0
    while (block < blocks.size) {
        instructionIndex = blocks[block].begin
        while (instructionIndex < blocks[block].end) {
            val result = instructions[instructionIndex].result
            if (result >= 0) {
                definitionBlocks[result] = block
                definitionInstructions[result] = instructionIndex
            }
            instructionIndex = instructionIndex + 1
        }
        block = block + 1
    }
    block = 0
    while (block < blocks.size) {
        instructionIndex = blocks[block].begin
        while (instructionIndex < blocks[block].end) {
            val instruction = instructions[instructionIndex]
            if (instruction.operands.size > 0) {
                var operand = 0
                while (operand < instruction.operands.size) {
                    if (!bootstrapIrValueDominates(
                        instruction.operands[operand],
                        block,
                        instructionIndex,
                        definitionBlocks,
                        definitionInstructions,
                        immediateDominators
                    )) errors = errors + 1
                    operand = operand + 1
                }
            } else {
                if (instruction.left >= 0 &&
                    !bootstrapIrValueDominates(
                        instruction.left,
                        block,
                        instructionIndex,
                        definitionBlocks,
                        definitionInstructions,
                        immediateDominators
                    )) errors = errors + 1
                if (instruction.right >= 0 &&
                    instruction.opcode != "parameter.default" &&
                    !bootstrapIrValueDominates(
                        instruction.right,
                        block,
                        instructionIndex,
                        definitionBlocks,
                        definitionInstructions,
                        immediateDominators
                    )) errors = errors + 1
            }
            instructionIndex = instructionIndex + 1
        }
        block = block + 1
    }
    errors
}

fun bootstrapIrIsLocalZero(opcode: string): bool =
    opcode == "local.zero" || opcode == "local.zero.i64" ||
    opcode == "local.zero.u64" || opcode == "local.zero.i32" ||
    opcode == "local.zero.u32" || opcode == "local.zero.i16" ||
    opcode == "local.zero.u16" || opcode == "local.zero.i8" ||
    opcode == "local.zero.u8" || opcode == "local.zero.char" ||
    opcode == "local.zero.bool"

fun bootstrapIrLocalZeroOpcode(type: string): string {
    val normalized = bootstrapNormalizeType(type)
    if (bootstrapIsIntegerScalarType(normalized)) {
        "local.zero.$normalized"
    }
    else if (normalized == "bool") "local.zero.bool"
    else "local.zero"
}

fun bootstrapIrDeclaresLocal(opcode: string): bool =
    opcode == "local.declare" || bootstrapIrIsLocalZero(opcode) ||
    opcode == "local.allocate"

fun bootstrapIrWritesLocal(opcode: string): bool =
    opcode == "local.declare" || bootstrapIrIsLocalZero(opcode) ||
    opcode == "local.set" || opcode == "local.assign"

fun bootstrapBuildIrLocals(
    instructions: array<BootstrapInstruction>,
    blocks: array<BootstrapIrBlock>,
    parameters: array<string>
): array<BootstrapIrLocal> {
    val locals: array<BootstrapIrLocal> = []
    var parameter = 0
    while (parameter < parameters.size) {
        locals.append(BootstrapIrLocal(parameters[parameter], -1, 0, true))
        parameter = parameter + 1
    }
    var block = 0
    while (block < blocks.size) {
        var instructionIndex = blocks[block].begin
        while (instructionIndex < blocks[block].end) {
            val instruction = instructions[instructionIndex]
            if (bootstrapIrDeclaresLocal(instruction.opcode)) {
                locals.append(BootstrapIrLocal(
                    instruction.text,
                    instructionIndex,
                    block,
                    instruction.opcode != "local.allocate"
                ))
            }
            instructionIndex = instructionIndex + 1
        }
        block = block + 1
    }
    locals
}

fun bootstrapIrLocalIndex(
    locals: array<BootstrapIrLocal>,
    name: string
): int {
    var found = -1
    var index = 0
    while (index < locals.size) {
        if (locals[index].name == name) found = index
        index = index + 1
    }
    found
}

fun bootstrapIrBlockDominates(
    dominator: int,
    block: int,
    immediateDominators: array<int>
): bool {
    var cursor = block
    while (cursor >= 0 && cursor != dominator &&
        cursor < immediateDominators.size &&
        immediateDominators[cursor] != cursor) {
        cursor = immediateDominators[cursor]
    }
    cursor == dominator
}

fun bootstrapIrHasUninitializedPath(
    local: BootstrapIrLocal,
    loadBlock: int,
    loadInstruction: int,
    instructions: array<BootstrapInstruction>,
    blocks: array<BootstrapIrBlock>,
    var visited: array<bool>,
    var stack: array<int>
): bool {
    var block = 0
    while (block < visited.size) {
        visited[block] = false
        block = block + 1
    }
    visited[loadBlock] = true
    stack[0] = loadBlock
    var stackSize = 1
    var uninitialized = false
    while (stackSize > 0 && !uninitialized) {
        stackSize = stackSize - 1
        block = stack[stackSize]
        var instructionIndex = blocks[block].end - 1
        if (block == loadBlock) instructionIndex = loadInstruction - 1
        var stopped = false
        while (instructionIndex >= blocks[block].begin && !stopped) {
            val instruction = instructions[instructionIndex]
            if (instruction.text == local.name &&
                instruction.opcode == "local.move") {
                uninitialized = true
                stopped = true
            }
            if (instruction.text == local.name &&
                bootstrapIrWritesLocal(instruction.opcode)) {
                stopped = true
            }
            if (instructionIndex == local.declaration) {
                uninitialized = !local.initialized
                stopped = true
            }
            instructionIndex = instructionIndex - 1
        }
        if (!stopped) {
            var predecessor = 0
            while (predecessor < blocks[block].predecessors.size) {
                val source = blocks[block].predecessors[predecessor]
                if (!visited[source]) {
                    visited[source] = true
                    stack[stackSize] = source
                    stackSize = stackSize + 1
                }
                predecessor = predecessor + 1
            }
        }
    }
    uninitialized
}

fun bootstrapIrPlaceRoot(place: string): string {
    var end = place.size
    var index = 0
    while (index < place.size && end == place.size) {
        if (place[index] == 46 || place[index] == 91) end = index
        index = index + 1
    }
    place.slice(0, end)
}

fun bootstrapIrPlacePrefix(left: string, right: string): bool {
    var prefix = left.size <= right.size
    var index = 0
    while (prefix && index < left.size) {
        if (left[index] != right[index]) prefix = false
        index = index + 1
    }
    prefix
}

class BootstrapIrPlaceSegment(
    val kind: int,
    val value: string,
    val next: int
)

fun bootstrapIrNextPlaceSegment(
    place: string,
    begin: int
): BootstrapIrPlaceSegment {
    var kind = 0
    var valueBegin = begin
    var end = begin
    var next = begin
    if (begin < place.size && place[begin] == 46) {
        kind = 1
        valueBegin = begin + 1
        end = valueBegin
        while (end < place.size && place[end] != 46 && place[end] != 91) {
            end = end + 1
        }
        next = end
        bootstrapSemanticUnit()
    } else if (begin < place.size && place[begin] == 91) {
        kind = 2
        valueBegin = begin + 1
        end = valueBegin
        while (end < place.size && place[end] != 93) end = end + 1
        next = end
        if (next < place.size) next = next + 1
        bootstrapSemanticUnit()
    }
    BootstrapIrPlaceSegment(kind, place.slice(valueBegin, end), next)
}

fun bootstrapIrPlaceHasWildcard(place: string): bool {
    var found = false
    var index = 0
    while (!found && index + 2 < place.size) {
        if (place[index] == 91 && place[index + 1] == 42 &&
            place[index + 2] == 93) found = true
        index = index + 1
    }
    found
}

fun bootstrapIrPlacesConflict(moved: string, requested: string): bool {
    val movedRoot = bootstrapIrPlaceRoot(moved)
    val requestedRoot = bootstrapIrPlaceRoot(requested)
    var conflict = movedRoot == requestedRoot
    var movedAt = movedRoot.size
    var requestedAt = requestedRoot.size
    var decided = !conflict
    while (!decided) {
        if (movedAt >= moved.size || requestedAt >= requested.size) {
            decided = true
            bootstrapSemanticUnit()
        } else {
            val movedSegment = bootstrapIrNextPlaceSegment(moved, movedAt)
            val requestedSegment = bootstrapIrNextPlaceSegment(
                requested,
                requestedAt
            )
            if (movedSegment.kind == 0 || requestedSegment.kind == 0 ||
                movedSegment.kind != requestedSegment.kind) {
                decided = true
                bootstrapSemanticUnit()
            } else if (movedSegment.kind == 1 &&
                       movedSegment.value != requestedSegment.value) {
                conflict = false
                decided = true
                bootstrapSemanticUnit()
            } else if (movedSegment.kind == 2 &&
                       movedSegment.value != "*" &&
                       requestedSegment.value != "*" &&
                       movedSegment.value != requestedSegment.value) {
                conflict = false
                decided = true
                bootstrapSemanticUnit()
            } else {
                movedAt = movedSegment.next
                requestedAt = requestedSegment.next
                bootstrapSemanticUnit()
            }
            bootstrapSemanticUnit()
        }
    }
    conflict
}

class BootstrapIrBorrowBinding(
    val storage: string,
    val source: string,
    val instruction: int
)

fun bootstrapIrBorrowSeparator(text: string): int {
    var separator = -1
    var index = 0
    while (separator < 0 && index < text.size) {
        if (text[index] == 124) separator = index
        index = index + 1
    }
    separator
}

fun bootstrapIrBorrowStorage(text: string): string {
    val separator = bootstrapIrBorrowSeparator(text)
    if (separator > 0) text.slice(0, separator) else ""
}

fun bootstrapIrBorrowSource(text: string): string {
    val separator = bootstrapIrBorrowSeparator(text)
    if (separator >= 0 && separator + 1 < text.size) {
        text.slice(separator + 1, text.size)
    } else ""
}

fun bootstrapPrepareIrBorrowMetadata(
    instructions: array<BootstrapInstruction>
): void {
    var instructionIndex = 0
    while (instructionIndex < instructions.size) {
        val instruction = instructions[instructionIndex]
        if (instruction.opcode == "borrow.bind") {
            val separator = bootstrapIrBorrowSeparator(instruction.text)
            if (separator < 0) bootstrapSemanticUnit()
        }
        instructionIndex = instructionIndex + 1
    }
}

fun bootstrapIrInstructionUsesBorrow(
    instruction: BootstrapInstruction,
    storage: string
): bool = (instruction.opcode == "local.load" ||
    instruction.opcode == "parameter.load" ||
    instruction.opcode == "place.root") && instruction.text == storage

fun bootstrapIrInstructionInvalidatesBorrow(
    instruction: BootstrapInstruction,
    source: string
): bool {
    var changed = ""
    if (instruction.opcode == "local.move" ||
        instruction.opcode == "local.assign" ||
        instruction.opcode == "local.set" ||
        instruction.opcode == "resource.clear" ||
        instruction.opcode == "place.move" ||
        instruction.opcode == "place.set" ||
        instruction.opcode == "borrow.mutate") changed = instruction.text
    changed != "" && bootstrapIrPlacesConflict(source, changed)
}

fun bootstrapBuildBorrowReturnCallNames(
    declarations: array<BootstrapDeclaration>
): array<string> {
    val names: array<string> = []
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if ((declaration.kind == "fun" ||
             declaration.kind == "compile.fun") &&
            bootstrapBorrowResultSource(declaration.resultType) != "") {
            names.append(declaration.name)
        }
        var method = 0
        while (method < declaration.methods.size) {
            if (bootstrapBorrowResultSource(
                declaration.methods[method].resultType
            ) != "") names.append(declaration.methods[method].name)
            method = method + 1
        }
        declarationIndex = declarationIndex + 1
    }
    var changed = true
    var round = 0
    while (changed && round <= declarations.size) {
        changed = false
        declarationIndex = 0
        while (declarationIndex < declarations.size) {
            val declaration = declarations[declarationIndex]
            if ((declaration.kind == "val" ||
                 declaration.kind == "var") &&
                !bootstrapAffineNamesContain(names, declaration.name) &&
                bootstrapExpressionIsBorrowCallable(
                    declaration.expression,
                    names
                )) {
                names.append(declaration.name)
                changed = true
            }
            declarationIndex = declarationIndex + 1
        }
        round = round + 1
    }
    names
}

fun bootstrapExpressionContainsBorrowProducer(
    expression: BootstrapExpression,
    borrowCallNames: array<string>
): bool {
    var found = expression.kind == "member.call" &&
        expression.text == "get"
    if (!found && (expression.kind == "call" ||
        expression.kind == "member.call")) {
        found = bootstrapAffineNamesContain(
            borrowCallNames,
            expression.text
        )
    }
    var child = 0
    while (!found && child < expression.children.size) {
        found = bootstrapExpressionContainsBorrowProducer(
            expression.children[child],
            borrowCallNames
        )
        child = child + 1
    }
    found
}

fun bootstrapExpressionIsBorrowCallable(
    expression: BootstrapExpression,
    names: array<string>
): bool {
    var found = expression.kind == "identifier" &&
        bootstrapAffineNamesContain(names, expression.text)
    if (!found && expression.kind == "block" &&
        expression.children.size > 0) {
        found = bootstrapExpressionIsBorrowCallable(
            expression.children[expression.children.size - 1],
            names
        )
    }
    if (!found && expression.kind == "if" &&
        expression.children.size > 2) {
        found = bootstrapExpressionIsBorrowCallable(
            expression.children[1],
            names
        ) && bootstrapExpressionIsBorrowCallable(
            expression.children[2],
            names
        )
    }
    found
}

fun bootstrapCollectBorrowCallableNames(
    expression: BootstrapExpression,
    var names: array<string>
): void {
    if (expression.kind == "local.val" &&
        expression.children.size > 0) {
        var callable = bootstrapExpressionIsBorrowCallable(
            expression.children[0],
            names
        )
        if (!callable && expression.children.size > 1 &&
            expression.children[1].text != "inferred") {
            callable = bootstrapFunctionBorrowResultParameter(
                bootstrapNormalizeType(expression.children[1].text)
            ) >= 0
        }
        if (callable && !bootstrapAffineNamesContain(
            names,
            expression.text
        )) names.append(expression.text)
    }
    if (expression.kind != "lambda" &&
        expression.kind != "lambda.move") {
        var child = 0
        while (child < expression.children.size) {
            bootstrapCollectBorrowCallableNames(
                expression.children[child],
                names
            )
            child = child + 1
        }
    }
}

fun bootstrapDeclarationMayBindBorrow(
    declaration: BootstrapDeclaration,
    globalNames: array<string>
): bool {
    val checkpoint = runtimeMemoryCheckpoint()
    val names: array<string> = []
    var index = 0
    while (index < globalNames.size) {
        names.append(globalNames[index])
        index = index + 1
    }
    index = 0
    while (index < declaration.parameters.size &&
        index < declaration.parameterTypes.size) {
        if (bootstrapFunctionBorrowResultParameter(
            bootstrapNormalizeType(declaration.parameterTypes[index])
        ) >= 0) names.append(declaration.parameters[index])
        index = index + 1
    }
    bootstrapCollectBorrowCallableNames(declaration.expression, names)
    val result = bootstrapExpressionMayBindBorrow(
        declaration.expression,
        names
    )
    bootstrapSemanticUnit()
    result
}

fun bootstrapExpressionMayBindBorrow(
    expression: BootstrapExpression,
    borrowCallNames: array<string>
): bool {
    var found = expression.kind == "local.val" &&
        expression.children.size > 0 &&
        bootstrapExpressionContainsBorrowProducer(
            expression.children[0],
            borrowCallNames
        )
    var child = 0
    while (!found && child < expression.children.size) {
        found = bootstrapExpressionMayBindBorrow(
            expression.children[child],
            borrowCallNames
        )
        child = child + 1
    }
    found
}

fun bootstrapVerifyIrBorrows(
    instructions: array<BootstrapInstruction>,
    blocks: array<BootstrapIrBlock>,
    locals: array<BootstrapIrLocal>
): int {
    val bindings: array<BootstrapIrBorrowBinding> = []
    var errors = 0
    var instructionIndex = 0
    while (instructionIndex < instructions.size) {
        val instruction = instructions[instructionIndex]
        if (instruction.opcode == "borrow.bind") {
            val storage = bootstrapIrBorrowStorage(instruction.text)
            val source = bootstrapIrBorrowSource(instruction.text)
            val sourceRoot = bootstrapIrPlaceRoot(source)
            if (storage == "" || source == "" || storage == sourceRoot ||
                bootstrapIrLocalIndex(locals, storage) < 0 ||
                bootstrapIrLocalIndex(locals, sourceRoot) < 0) {
                errors = errors + 1
                bootstrapSemanticUnit()
            } else {
                bindings.append(BootstrapIrBorrowBinding(
                    storage,
                    source,
                    instructionIndex
                ))
                bootstrapSemanticUnit()
            }
        }
        instructionIndex = instructionIndex + 1
    }

    var bindingIndex = 0
    while (bindingIndex < bindings.size) {
        val binding = bindings[bindingIndex]
        val liveIn: array<bool> = []
        val liveOut: array<bool> = []
        var block = 0
        while (block < blocks.size) {
            liveIn.append(false)
            liveOut.append(false)
            block = block + 1
        }
        var changed = true
        while (changed) {
            changed = false
            block = blocks.size
            while (block > 0) {
                block = block - 1
                var outgoing = false
                var successor = 0
                while (successor < blocks[block].successors.size) {
                    val target = bootstrapIrBlockForLabel(
                        blocks,
                        blocks[block].successors[successor]
                    )
                    if (target >= 0 && liveIn[target]) outgoing = true
                    successor = successor + 1
                }
                var live = outgoing
                instructionIndex = blocks[block].end
                while (instructionIndex > blocks[block].begin) {
                    instructionIndex = instructionIndex - 1
                    val instruction = instructions[instructionIndex]
                    if (instruction.opcode == "borrow.bind" &&
                        bootstrapIrBorrowStorage(instruction.text) ==
                            binding.storage) {
                        live = false
                        bootstrapSemanticUnit()
                    } else if (bootstrapIrInstructionUsesBorrow(
                        instruction,
                        binding.storage
                    )) {
                        live = true
                        bootstrapSemanticUnit()
                    }
                }
                if (liveIn[block] != live || liveOut[block] != outgoing) {
                    liveIn[block] = live
                    liveOut[block] = outgoing
                    changed = true
                }
            }
        }

        block = 0
        while (block < blocks.size) {
            var live = liveOut[block]
            instructionIndex = blocks[block].end
            while (instructionIndex > blocks[block].begin) {
                instructionIndex = instructionIndex - 1
                val instruction = instructions[instructionIndex]
                if (bootstrapIrInstructionInvalidatesBorrow(
                    instruction,
                    binding.source
                ) && live) errors = errors + 1
                if (instruction.opcode == "borrow.bind" &&
                    bootstrapIrBorrowStorage(instruction.text) ==
                        binding.storage) {
                    live = false
                    bootstrapSemanticUnit()
                } else if (bootstrapIrInstructionUsesBorrow(
                    instruction,
                    binding.storage
                )) {
                    live = true
                    bootstrapSemanticUnit()
                }
            }
            block = block + 1
        }
        bindingIndex = bindingIndex + 1
    }
    errors
}

class BootstrapIrPlaceState(var values: array<string>)

fun bootstrapIrPlaceStateContains(
    state: BootstrapIrPlaceState,
    place: string
): bool {
    var found = false
    var index = 0
    while (index < state.values.size) {
        if (state.values[index] == place) found = true
        index = index + 1
    }
    found
}

fun bootstrapIrPlaceStateAdd(
    var state: BootstrapIrPlaceState,
    place: string
): void {
    if (!bootstrapIrPlaceStateContains(state, place)) {
        state.values.append(place)
    }
}

fun bootstrapIrPlaceStatesEqual(
    left: BootstrapIrPlaceState,
    right: BootstrapIrPlaceState
): bool {
    var equal = left.values.size == right.values.size
    var index = 0
    while (equal && index < left.values.size) {
        if (!bootstrapIrPlaceStateContains(right, left.values[index])) {
            equal = false
        }
        index = index + 1
    }
    equal
}

fun bootstrapIrPlaceRestored(moved: string, place: string): bool {
    var restored = false
    if (!bootstrapIrPlaceHasWildcard(place)) {
        restored = moved == place
        if (!restored &&
            bootstrapIrPlacePrefix("$place.", "$moved.")) restored = true
        if (!restored &&
            bootstrapIrPlacePrefix("$place[", "$moved[")) restored = true
    }
    restored
}

fun bootstrapIrApplyPlaceInstruction(
    var state: BootstrapIrPlaceState,
    instruction: BootstrapInstruction
): void {
    if (instruction.opcode == "local.declare" ||
        instruction.opcode == "local.assign" ||
        instruction.opcode == "local.set") {
        val retained: array<string> = []
        var index = 0
        while (index < state.values.size) {
            if (bootstrapIrPlaceRoot(state.values[index]) != instruction.text) {
                retained.append(state.values[index])
            }
            index = index + 1
        }
        state.values = retained
    }
    if (instruction.opcode == "place.set") {
        val retained: array<string> = []
        var index = 0
        while (index < state.values.size) {
            if (!bootstrapIrPlaceRestored(
                state.values[index],
                instruction.text
            )) {
                retained.append(state.values[index])
            }
            index = index + 1
        }
        state.values = retained
    }
    if (instruction.opcode == "place.move") {
        bootstrapIrPlaceStateAdd(state, instruction.text)
    }
}

fun bootstrapVerifyIrPlaces(
    instructions: array<BootstrapInstruction>,
    blocks: array<BootstrapIrBlock>
): int {
    val inputs: array<BootstrapIrPlaceState> = []
    val outputs: array<BootstrapIrPlaceState> = []
    var block = 0
    while (block < blocks.size) {
        inputs.append(BootstrapIrPlaceState([]))
        outputs.append(BootstrapIrPlaceState([]))
        block = block + 1
    }
    var changed = true
    while (changed) {
        changed = false
        block = 0
        while (block < blocks.size) {
            val merged = BootstrapIrPlaceState([])
            var predecessor = 0
            while (predecessor < blocks[block].predecessors.size) {
                val source = blocks[block].predecessors[predecessor]
                var place = 0
                while (place < outputs[source].values.size) {
                    bootstrapIrPlaceStateAdd(
                        merged,
                        outputs[source].values[place]
                    )
                    place = place + 1
                }
                predecessor = predecessor + 1
            }
            val next = BootstrapIrPlaceState([])
            var place = 0
            while (place < merged.values.size) {
                next.values.append(merged.values[place])
                place = place + 1
            }
            var instructionIndex = blocks[block].begin
            while (instructionIndex < blocks[block].end) {
                bootstrapIrApplyPlaceInstruction(
                    next,
                    instructions[instructionIndex]
                )
                instructionIndex = instructionIndex + 1
            }
            if (!bootstrapIrPlaceStatesEqual(inputs[block], merged) ||
                !bootstrapIrPlaceStatesEqual(outputs[block], next)) {
                changed = true
            }
            inputs[block].values = merged.values
            outputs[block].values = next.values
            block = block + 1
        }
    }
    var errors = 0
    block = 0
    while (block < blocks.size) {
        val state = BootstrapIrPlaceState([])
        var place = 0
        while (place < inputs[block].values.size) {
            state.values.append(inputs[block].values[place])
            place = place + 1
        }
        var instructionIndex = blocks[block].begin
        while (instructionIndex < blocks[block].end) {
            val instruction = instructions[instructionIndex]
            var requested = ""
            if (instruction.opcode == "place.load" ||
                instruction.opcode == "place.move") {
                requested = instruction.text
            }
            if (instruction.opcode == "local.load" ||
                instruction.opcode == "parameter.load" ||
                instruction.opcode == "local.move") {
                requested = instruction.text
            }
            if (instruction.opcode == "borrow.bind") {
                requested = bootstrapIrBorrowSource(instruction.text)
            }
            if (requested != "") {
                place = 0
                while (place < state.values.size) {
                    if (bootstrapIrPlacesConflict(
                        state.values[place],
                        requested
                    )) errors = errors + 1
                    place = place + 1
                }
            }
            bootstrapIrApplyPlaceInstruction(state, instruction)
            instructionIndex = instructionIndex + 1
        }
        block = block + 1
    }
    errors
}

fun bootstrapVerifyIrLocals(
    instructions: array<BootstrapInstruction>,
    blocks: array<BootstrapIrBlock>,
    locals: array<BootstrapIrLocal>,
    immediateDominators: array<int>
): int {
    var errors = 0
    var localIndex = 0
    while (localIndex < locals.size) {
        var previous = 0
        while (previous < localIndex) {
            if (locals[previous].name == locals[localIndex].name) {
                errors = errors + 1
            }
            previous = previous + 1
        }
        localIndex = localIndex + 1
    }

    val visited: array<bool> = []
    val stack: array<int> = []
    var block = 0
    while (block < blocks.size) {
        visited.append(false)
        stack.append(0)
        block = block + 1
    }
    block = 0
    while (block < blocks.size) {
        var instructionIndex = blocks[block].begin
        while (instructionIndex < blocks[block].end) {
            val instruction = instructions[instructionIndex]
            if (instruction.opcode == "local.load" ||
                instruction.opcode == "parameter.load" ||
                instruction.opcode == "place.root" ||
                instruction.opcode == "resource.peek" ||
                instruction.opcode == "resource.clear" ||
                instruction.opcode == "local.set" ||
                instruction.opcode == "local.assign" ||
                instruction.opcode == "local.move") {
                localIndex = bootstrapIrLocalIndex(locals, instruction.text)
                if (localIndex < 0) {
                    errors = errors + 1
                    bootstrapSemanticUnit()
                }
                else {
                    val local = locals[localIndex]
                    var inLifetime = false
                    if (local.block == block) {
                        inLifetime = local.declaration < instructionIndex
                    } else inLifetime = bootstrapIrBlockDominates(
                        local.block,
                        block,
                        immediateDominators
                    )
                    if (!inLifetime) errors = errors + 1
                    if (inLifetime &&
                        (instruction.opcode == "local.load" ||
                         instruction.opcode == "parameter.load" ||
                         instruction.opcode == "place.root" ||
                         instruction.opcode == "local.move") &&
                        bootstrapIrHasUninitializedPath(
                            local,
                            block,
                            instructionIndex,
                            instructions,
                            blocks,
                            visited,
                            stack
                        )) errors = errors + 1
                    bootstrapSemanticUnit()
                }
            }
            instructionIndex = instructionIndex + 1
        }
        block = block + 1
    }
    errors
}

fun bootstrapVerifyIrFunction(
    instructions: array<BootstrapInstruction>,
    blocks: array<BootstrapIrBlock>
): int {
    var errors = 0
    var maximumLabel = -1
    var leftBlock = 0
    while (leftBlock < blocks.size) {
        if (blocks[leftBlock].label > maximumLabel) {
            maximumLabel = blocks[leftBlock].label
        }
        leftBlock = leftBlock + 1
    }
    val labels: array<bool> = []
    var label = 0
    while (label <= maximumLabel) {
        labels.append(false)
        label = label + 1
    }
    leftBlock = 0
    while (leftBlock < blocks.size) {
        val blockLabel = blocks[leftBlock].label
        if (blockLabel >= 0) {
            if (labels[blockLabel]) errors = errors + 1
            labels[blockLabel] = true
        }
        leftBlock = leftBlock + 1
    }
    leftBlock = 0
    while (leftBlock < blocks.size) {
        if (blocks[leftBlock].end <= blocks[leftBlock].begin ||
            !bootstrapIrIsTerminator(
                instructions[blocks[leftBlock].end - 1].opcode
            )) errors = errors + 1
        var successor = 0
        while (successor < blocks[leftBlock].successors.size) {
            val successorLabel = blocks[leftBlock].successors[successor]
            if (successorLabel < 0 || successorLabel >= labels.size ||
                !labels[successorLabel]) errors = errors + 1
            successor = successor + 1
        }
        leftBlock = leftBlock + 1
    }

    var maximumValue = -1
    var instructionIndex = 0
    while (instructionIndex < instructions.size) {
        val instruction = instructions[instructionIndex]
        if (instruction.result > maximumValue) maximumValue = instruction.result
        instructionIndex = instructionIndex + 1
    }
    val definitions: array<bool> = []
    var value = 0
    while (value <= maximumValue) {
        definitions.append(false)
        value = value + 1
    }
    instructionIndex = 0
    while (instructionIndex < instructions.size) {
        val instruction = instructions[instructionIndex]
        if (instruction.result >= 0) {
            if (definitions[instruction.result]) errors = errors + 1
            definitions[instruction.result] = true
        }
        instructionIndex = instructionIndex + 1
    }
    instructionIndex = 0
    while (instructionIndex < instructions.size) {
        val instruction = instructions[instructionIndex]
        if (!bootstrapIrHasValue(definitions, instruction.left)) {
            errors = errors + 1
        }
        if (instruction.opcode != "parameter.default" &&
            !bootstrapIrHasValue(definitions, instruction.right)) {
            errors = errors + 1
        }
        var operand = 0
        while (operand < instruction.operands.size) {
            if (!bootstrapIrHasValue(
                definitions,
                instruction.operands[operand]
            )) errors = errors + 1
            operand = operand + 1
        }
        instructionIndex = instructionIndex + 1
    }
    errors
}

fun bootstrapFinalizeIrFunction(
    name: string,
    parameters: array<string>,
    lowered: array<BootstrapInstruction>,
    result: int,
    parameterTypes: array<string> = [],
    resultType: string = "unknown",
    declaredLocalNames: array<string> = [],
    declaredLocalTypes: array<string> = [],
    inlineHint: bool = false,
    noinlineHint: bool = false,
    naked: bool = false,
    section: string = ""
): BootstrapIrFunction {
    val canonical: array<BootstrapInstruction> = []
    var terminated = false
    var index = 0
    while (index < lowered.size) {
        val instruction = lowered[index]
        if (instruction.opcode == "label") {
            if (canonical.size > 0 && !terminated) {
                canonical.append(BootstrapInstruction(
                    "jump", -1, -1, -1, "", instruction.target, -1, [], []
                ))
            }
            canonical.append(instruction)
            terminated = false
            bootstrapSemanticUnit()
        } else {
            if (!terminated) {
                canonical.append(instruction)
                if (bootstrapIrIsTerminator(instruction.opcode)) {
                    terminated = true
                }
            }
            bootstrapSemanticUnit()
        }
        index = index + 1
    }
    if (!terminated) canonical.append(BootstrapInstruction(
        "return", -1, result, -1, "", -1, -1, [], []
    ))

    val initialBlocks = bootstrapBuildIrBlocks(canonical)
    val initialVerificationCheckpoint = runtimeMemoryCheckpoint()
    val initialErrors = bootstrapVerifyIrFunction(canonical, initialBlocks)
    bootstrapSemanticUnit()
    val reachableInstructions: array<BootstrapInstruction> = []
    var block = 0
    while (block < initialBlocks.size) {
        if (initialBlocks[block].reachable) {
            index = initialBlocks[block].begin
            while (index < initialBlocks[block].end) {
                reachableInstructions.append(canonical[index])
                index = index + 1
            }
        }
        block = block + 1
    }
    val blocks = bootstrapBuildIrBlocks(reachableInstructions)
    val locals = bootstrapBuildIrLocals(
        reachableInstructions,
        blocks,
        parameters
    )
    val localTypes: array<string> = []
    var local = 0
    while (local < locals.size) {
        var localType = "unknown"
        var declared = 0
        while (declared < declaredLocalNames.size) {
            if (declaredLocalNames[declared] == locals[local].name &&
                declared < declaredLocalTypes.size) {
                localType = bootstrapNormalizeType(
                    declaredLocalTypes[declared]
                )
            }
            declared = declared + 1
        }
        localTypes.append(localType)
        local = local + 1
    }
    var errors = initialErrors
    val verificationCheckpoint = runtimeMemoryCheckpoint()
    errors = errors + bootstrapVerifyIrFunction(
        reachableInstructions,
        blocks
    )
    bootstrapSemanticUnit()
    val immediateDominators = bootstrapBuildImmediateDominators(blocks)
    errors = errors + bootstrapVerifyIrDominance(
        reachableInstructions,
        blocks,
        immediateDominators
    )
    errors = errors + bootstrapVerifyIrLocals(
        reachableInstructions,
        blocks,
        locals,
        immediateDominators
    )
    bootstrapPrepareIrBorrowMetadata(reachableInstructions)
    val placeVerificationCheckpoint = runtimeMemoryCheckpoint()
    errors = errors + bootstrapVerifyIrPlaces(
        reachableInstructions,
        blocks
    )
    bootstrapSemanticUnit()
    errors = errors + bootstrapVerifyIrBorrows(
        reachableInstructions,
        blocks,
        locals
    )
    if (naked) {
        var assemblyCount = 0
        var nakedValid = true
        index = 0
        while (index < reachableInstructions.size) {
            val instruction = reachableInstructions[index]
            if (instruction.opcode == "inline.assembly") {
                assemblyCount = assemblyCount + 1
                if (instruction.operands.size != 0) nakedValid = false
            } else if (instruction.opcode != "return") {
                nakedValid = false
            }
            index = index + 1
        }
        if (!nakedValid || assemblyCount != 1) errors = errors + 1
    }
    BootstrapIrFunction(
        name,
        parameters,
        reachableInstructions,
        result,
        blocks,
        locals,
        localTypes,
        parameterTypes,
        bootstrapNormalizeType(resultType),
        inlineHint,
        noinlineHint,
        naked,
        section,
        errors
    )
}

fun bootstrapDropFunctionName(type: string): string {
    val normalized = bootstrapNormalizeType(type)
    var name = "__abla_drop"
    var index = 0
    while (index < normalized.size) {
        name = "${name}_${normalized[index]}"
        index = index + 1
    }
    name
}

fun bootstrapClosureDropFunctionName(name: string): string =
    "__abla_closure_drop_$name"

fun bootstrapDropDeclarationIndex(
    declarations: array<BootstrapDeclaration>,
    name: string
): int {
    var result = -1
    var index = 0
    while (index < declarations.size) {
        if (declarations[index].kind == "class" &&
            declarations[index].name == name) result = index
        index = index + 1
    }
    result
}

fun bootstrapCollectDropType(
    type: string,
    declarations: array<BootstrapDeclaration>,
    affineTypes: array<string>,
    var types: array<string>
): void {
    val normalized = bootstrapNormalizeType(type)
    if (!bootstrapSummaryTypeIsAffine(normalized, affineTypes) ||
        bootstrapAffineNamesContain(types, normalized)) {
        bootstrapSemanticUnit()
    } else {
        types.append(normalized)
        if (bootstrapIsNullableType(normalized)) {
            bootstrapCollectDropType(
                bootstrapNullableElementType(normalized),
                declarations,
                affineTypes,
                types
            )
        }
        if (bootstrapIsArrayType(normalized)) {
            bootstrapCollectDropType(
                bootstrapArrayElementType(normalized),
                declarations,
                affineTypes,
                types
            )
        }
        if (bootstrapIsSharedType(normalized)) {
            bootstrapCollectDropType(
                bootstrapSharedElementType(normalized),
                declarations,
                affineTypes,
                types
            )
        }
        if (bootstrapIsMutexType(normalized)) {
            bootstrapCollectDropType(
                bootstrapMutexElementType(normalized),
                declarations,
                affineTypes,
                types
            )
        }
        if (bootstrapIsGeneratorType(normalized)) {
            bootstrapCollectDropType(
                bootstrapGeneratorElementType(normalized),
                declarations,
                affineTypes,
                types
            )
        }
        val declarationIndex = bootstrapDropDeclarationIndex(
            declarations,
            normalized
        )
        if (declarationIndex >= 0) {
            val declaration = declarations[declarationIndex]
            var field = 0
            while (field < declaration.parameterTypes.size) {
                if (field < declaration.parameterKinds.size &&
                    (declaration.parameterKinds[field] == "val" ||
                     declaration.parameterKinds[field] == "var")) {
                    bootstrapCollectDropType(
                        declaration.parameterTypes[field],
                        declarations,
                        affineTypes,
                        types
                    )
                }
                field = field + 1
            }
        }
    }
}

class BootstrapDropBuilder(
    val instructions: array<BootstrapInstruction>,
    var nextValue: int,
    var nextLabel: int
) {
    fun emit(opcode: string, left: int, right: int, text: string): int {
        val result = this.nextValue
        this.nextValue = this.nextValue + 1
        this.instructions.append(BootstrapInstruction(
            opcode, result, left, right, text, -1, -1, [], []
        ))
        result
    }

    fun emitMany(opcode: string, operands: array<int>, text: string): int {
        val result = this.nextValue
        this.nextValue = this.nextValue + 1
        var left = -1
        var right = -1
        if (operands.size > 0) left = operands[0]
        if (operands.size > 1) right = operands[1]
        this.instructions.append(BootstrapInstruction(
            opcode, result, left, right, text, -1, -1, operands, []
        ))
        result
    }

    fun emitControl(
        opcode: string,
        value: int,
        target: int,
        alternate: int,
        text: string
    ): void {
        this.instructions.append(BootstrapInstruction(
            opcode, -1, value, -1, text, target, alternate, [], []
        ))
    }

    fun label(): int {
        val result = this.nextLabel
        this.nextLabel = this.nextLabel + 1
        result
    }
}

fun bootstrapBuildDropFunction(
    type: string,
    declarations: array<BootstrapDeclaration>,
    affineTypes: array<string>
): BootstrapIrFunction {
    val instructions: array<BootstrapInstruction> = []
    val builder = BootstrapDropBuilder(instructions, 0, 0)
    val value = builder.emit("parameter.load", -1, -1, "value")
    val nullValue = builder.emit("const.null", -1, -1, "")
    val active = builder.emit("!=", value, nullValue, "")
    val activeLabel = builder.label()
    val doneLabel = builder.label()
    builder.emitControl("branch", active, activeLabel, doneLabel, "")
    builder.emitControl("label", -1, activeLabel, -1, "")

    val normalized = bootstrapNormalizeType(type)
    if (bootstrapIsOnceFunctionType(normalized) ||
        bootstrapIsMutableFunctionType(normalized)) {
        builder.emitControl("closure.drop", value, -1, -1, "")
        bootstrapSemanticUnit()
    } else if (bootstrapIsSharedType(normalized)) {
        val elementType = bootstrapSharedElementType(normalized)
        val released = builder.emit(
            "shared.release",
            value,
            -1,
            elementType
        )
        if (bootstrapSummaryTypeIsAffine(elementType, affineTypes)) {
            builder.emitMany(
                "call",
                [released],
                bootstrapDropFunctionName(elementType)
            )
        }
        bootstrapSemanticUnit()
    } else if (bootstrapIsMutexType(normalized)) {
        val elementType = bootstrapMutexElementType(normalized)
        val released = builder.emit(
            "shared.release",
            value,
            -1,
            elementType
        )
        if (bootstrapSummaryTypeIsAffine(elementType, affineTypes)) {
            builder.emitMany(
                "call",
                [released],
                bootstrapDropFunctionName(elementType)
            )
        }
        bootstrapSemanticUnit()
    } else if (bootstrapIsWeakType(normalized)) {
        builder.emit("weak.release", value, -1, "")
        bootstrapSemanticUnit()
    } else if (bootstrapIsGeneratorType(normalized)) {
        builder.emit("generator.drop", value, -1, "")
        bootstrapSemanticUnit()
    } else if (bootstrapIsTaskType(normalized)) {
        builder.emit("task.drop", value, -1, "")
        bootstrapSemanticUnit()
    } else if (bootstrapIsThreadType(normalized)) {
        builder.emit("thread.drop", value, -1, "")
        bootstrapSemanticUnit()
    } else if (bootstrapIsNullableType(normalized)) {
        builder.emitMany(
            "call",
            [value],
            bootstrapDropFunctionName(bootstrapNullableElementType(normalized))
        )
        bootstrapSemanticUnit()
    } else if (bootstrapIsArrayType(normalized)) {
        val length = builder.emit("array.length", value, -1, "")
        val indexStorage = "drop_index"
        builder.emitControl("local.zero.i64", -1, -1, -1, indexStorage)
        val conditionLabel = builder.label()
        val bodyLabel = builder.label()
        val incrementLabel = builder.label()
        builder.emitControl("jump", -1, conditionLabel, -1, "")
        bootstrapSemanticUnit()
        builder.emitControl("label", -1, conditionLabel, -1, "")
        val index = builder.emit("local.load", -1, -1, indexStorage)
        val more = builder.emit("<", index, length, "")
        builder.emitControl("branch", more, bodyLabel, doneLabel, "")
        builder.emitControl("label", -1, bodyLabel, -1, "")
        val element = builder.emit("array.get", value, index, "")
        builder.emitMany(
            "call",
            [element],
            bootstrapDropFunctionName(bootstrapArrayElementType(normalized))
        )
        builder.emitControl("jump", -1, incrementLabel, -1, "")
        builder.emitControl("label", -1, incrementLabel, -1, "")
        val current = builder.emit("local.load", -1, -1, indexStorage)
        val one = builder.emit("const.i64", -1, -1, "1")
        val next = builder.emit("+", current, one, "")
        builder.emitControl("local.set", next, -1, -1, indexStorage)
        builder.emitControl("jump", -1, conditionLabel, -1, "")
    } else {
        val declarationIndex = bootstrapDropDeclarationIndex(
            declarations,
            normalized
        )
        if (declarationIndex >= 0) {
            val declaration = declarations[declarationIndex]
            if (declaration.isResource) {
                var method = 0
                while (method < declaration.methods.size) {
                    if (declaration.methods[method].name == "drop") {
                        builder.emitMany(
                            "call",
                            [value],
                            "${declaration.name}_drop"
                        )
                    }
                    method = method + 1
                }
            }
            var field = declaration.parameters.size
            while (field > 0) {
                field = field - 1
                if (field < declaration.parameterKinds.size &&
                    field < declaration.parameterTypes.size &&
                    (declaration.parameterKinds[field] == "val" ||
                     declaration.parameterKinds[field] == "var") &&
                    bootstrapSummaryTypeIsAffine(
                        declaration.parameterTypes[field],
                        affineTypes
                    )) {
                    val fieldValue = builder.emit(
                        "field.get",
                        value,
                        -1,
                        declaration.parameters[field]
                    )
                    builder.emitMany(
                        "call",
                        [fieldValue],
                        bootstrapDropFunctionName(
                            declaration.parameterTypes[field]
                        )
                    )
                }
            }
        }
        bootstrapSemanticUnit()
    }
    if (!bootstrapIsArrayType(normalized)) {
        builder.emitControl("jump", -1, doneLabel, -1, "")
    }
    builder.emitControl("label", -1, doneLabel, -1, "")
    val result = builder.emit("const.void", -1, -1, "")
    bootstrapFinalizeIrFunction(
        bootstrapDropFunctionName(normalized),
        ["value"],
        instructions,
        result,
        [normalized],
        "void"
    )
}

fun bootstrapBuildClosureDropFunction(
    name: string,
    captureNames: array<string>,
    captureTypes: array<string>,
    affineTypes: array<string>
): BootstrapIrFunction {
    val instructions: array<BootstrapInstruction> = []
    val builder = BootstrapDropBuilder(instructions, 0, 0)
    var capture = captureNames.size
    while (capture > 0) {
        capture = capture - 1
        if (capture < captureTypes.size &&
            bootstrapSummaryTypeIsAffine(
                captureTypes[capture],
                affineTypes
            )) {
            val value = builder.emit(
                "parameter.load",
                -1,
                -1,
                captureNames[capture]
            )
            builder.emitControl(
                "resource.drop",
                value,
                -1,
                -1,
                bootstrapNormalizeType(captureTypes[capture])
            )
        }
    }
    val result = builder.emit("const.void", -1, -1, "")
    bootstrapFinalizeIrFunction(
        bootstrapClosureDropFunctionName(name),
        captureNames,
        instructions,
        result,
        captureTypes,
        "void"
    )
}

fun bootstrapAppendDropFunctions(
    var functions: array<BootstrapIrFunction>,
    declarations: array<BootstrapDeclaration>,
    affineTypes: array<string>
): int {
    val types: array<string> = []
    var function = 0
    while (function < functions.size) {
        var instruction = 0
        while (instruction < functions[function].instructions.size) {
            val found = functions[function].instructions[instruction]
            if (found.opcode == "resource.drop") {
                bootstrapCollectDropType(
                    found.text,
                    declarations,
                    affineTypes,
                    types
                )
            }
            instruction = instruction + 1
        }
        function = function + 1
    }
    var errors = 0
    var typeIndex = 0
    while (typeIndex < types.size) {
        val drop = bootstrapBuildDropFunction(
            types[typeIndex],
            declarations,
            affineTypes
        )
        errors = errors + drop.verificationErrors
        functions.append(drop)
        typeIndex = typeIndex + 1
    }
    errors
}

fun bootstrapBuildNeverCallNames(
    declarations: array<BootstrapDeclaration>
): array<string> {
    val names: array<string> = []
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if ((declaration.kind == "fun" ||
             declaration.kind == "compile.fun" ||
             declaration.kind == "extern") &&
            bootstrapNormalizeType(declaration.resultType) == "never") {
            if (declaration.extensionOwner == "") {
                names.append(declaration.name)
            } else {
                names.append("${bootstrapNormalizeType(
                    declaration.extensionOwner
                )}.${declaration.name}")
            }
        }
        var methodIndex = 0
        while (methodIndex < declaration.methods.size) {
            val method = declaration.methods[methodIndex]
            if (bootstrapNormalizeType(method.resultType) == "never") {
                names.append("${declaration.name}.${method.name}")
            }
            methodIndex = methodIndex + 1
        }
        declarationIndex = declarationIndex + 1
    }
    names
}

class BootstrapLowerer(
    val instructions: array<BootstrapInstruction>,
    val functions: array<BootstrapIrFunction>,
    val parameters: array<string>,
    val parameterTypes: array<string>,
    val ownedParameters: array<string>,
    val capturedParameters: array<string>,
    val locals: array<string>,
    val localTypes: array<string>,
    val localStorage: array<string>,
    val localScopes: array<int>,
    val localBorrowSources: array<string>,
    val deferredScopes: array<int>,
    val deferredStorage: array<string>,
    var scopeParents: array<int>,
    var currentScope: int,
    val declarations: array<BootstrapDeclaration>,
    val affineTypes: array<string>,
    val neverCallNames: array<string>,
    val mutableReceivers: BootstrapMutableReceiverSummary,
    val managedAliasBegins: array<int>,
    val managedAliasEnds: array<int>,
    val managedAliasSources: array<string>,
    val refinementNames: array<string>,
    val refinementTypes: array<string>,
    val refinementScopes: array<int>,
    val implicitResults: array<BootstrapExpression>,
    val currentOwner: string,
    val evaluatedValues: array<BootstrapEvalValue>,
    val evaluatedResults: array<int>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    var nextValue: int,
    var nextLabel: int,
    var breakLabel: int,
    var continueLabel: int,
    var breakScope: int,
    var continueScope: int,
    val validationOnly: bool,
    var errors: int
) {
    fun isManagedAlias(expression: BootstrapExpression): bool {
        var found = false
        var index = 0
        while (!found && index < this.managedAliasBegins.size &&
               index < this.managedAliasEnds.size) {
            if (this.managedAliasBegins[index] == expression.begin &&
                this.managedAliasEnds[index] == expression.end) found = true
            index = index + 1
        }
        found
    }

    fun managedAliasSource(expression: BootstrapExpression): string {
        var source = ""
        var index = 0
        while (index < this.managedAliasBegins.size &&
               index < this.managedAliasEnds.size &&
               index < this.managedAliasSources.size) {
            if (this.managedAliasBegins[index] == expression.begin &&
                this.managedAliasEnds[index] == expression.end) {
                source = this.managedAliasSources[index]
            }
            index = index + 1
        }
        source
    }

    fun declarationHasManagedAlias(
        declaration: BootstrapDeclaration
    ): bool {
        var found = false
        var index = 0
        while (!found && index < this.managedAliasBegins.size) {
            if (this.managedAliasBegins[index] >= declaration.begin &&
                this.managedAliasBegins[index] <= declaration.end) {
                found = true
            }
            index = index + 1
        }
        found
    }

    fun recordCompileInputs(evaluated: BootstrapEvalResult): void {
        var input = 0
        while (input < evaluated.compileInputPaths.size) {
            val path = evaluated.compileInputPaths[input]
            var found = -1
            var existing = 0
            while (existing < this.compileInputPaths.size) {
                if (this.compileInputPaths[existing] == path) found = existing
                existing = existing + 1
            }
            if (found >= 0) {
                this.compileInputContents[found] =
                    evaluated.compileInputContents[input]
            } else {
                this.compileInputPaths.append(path)
                this.compileInputContents.append(
                    evaluated.compileInputContents[input]
                )
            }
            input = input + 1
        }
    }

    fun collectImplicitResults(
        expression: BootstrapExpression,
        var results: array<BootstrapExpression>
    ): void {
        if (expression.kind == "block" && expression.children.size > 0) {
            this.collectImplicitResults(
                expression.children[expression.children.size - 1],
                results
            )
        } else if (expression.kind == "if") {
            this.collectImplicitResults(expression.children[1], results)
            if (expression.children[2].kind != "missing") {
                this.collectImplicitResults(expression.children[2], results)
            }
        } else if (expression.kind == "when") {
            var branch = 2
            while (branch < expression.children.size) {
                this.collectImplicitResults(expression.children[branch], results)
                branch = branch + 2
            }
        } else results.append(expression)
    }

    fun isImplicitResult(expression: BootstrapExpression): bool {
        var found = false
        var index = 0
        while (index < this.implicitResults.size) {
            val candidate = this.implicitResults[index]
            if (candidate.kind == expression.kind &&
                candidate.begin == expression.begin &&
                candidate.end == expression.end) found = true
            index = index + 1
        }
        found
    }

    fun emitResultMove(expression: BootstrapExpression) {
        if (expression.kind == "identifier") {
            val name = expression.text
            var type = "unknown"
            if (this.isLocal(name)) type = this.lowerLocalType(name)
            if (this.isParameter(name)) type = this.lowerParameterType(name)
            if (this.lowerTypeIsAffine(type) &&
                (this.isLocal(name) || this.parameterIsOwned(name))) {
                this.emitControl(
                    "local.move",
                    -1,
                    -1,
                    -1,
                    this.storageFor(name)
                )
            }
        }
    }

    fun parameterIsOwned(name: string): bool {
        var found = false
        var index = 0
        while (index < this.ownedParameters.size) {
            if (this.ownedParameters[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun emitAffineDrop(storage: string, type: string) {
        val normalized = bootstrapNormalizeType(type)
        if (this.lowerTypeIsAffine(normalized)) {
            val value = this.emit("resource.peek", -1, -1, storage)
            this.emitControl("resource.drop", value, -1, -1, normalized)
            this.emitControl("resource.clear", -1, -1, -1, storage)
        }
    }

    fun emitAffineValueDrop(value: int, type: string) {
        val normalized = bootstrapNormalizeType(type)
        if (this.lowerTypeIsAffine(normalized)) {
            this.emitControl("resource.drop", value, -1, -1, normalized)
        }
    }

    fun emitScopeDrops(scope: int) {
        var deferred = this.deferredScopes.size
        while (deferred > 0) {
            deferred = deferred - 1
            if (this.deferredScopes[deferred] == scope) {
                val callable = this.emit(
                    "local.load", -1, -1, this.deferredStorage[deferred]
                )
                this.emitMany("call.indirect.once", [callable], "")
                this.emitControl(
                    "local.move", -1, -1, -1,
                    this.deferredStorage[deferred]
                )
            }
        }
        var index = this.locals.size
        while (index > 0) {
            index = index - 1
            if (this.localScopes[index] == scope &&
                this.localTypes[index].size >= 5 &&
                this.localTypes[index].slice(0, 5) != "cell:" &&
                (this.localStorage[index].size < 10 ||
                 this.localStorage[index].slice(0, 10) != "for_value_")) {
                this.emitAffineDrop(
                    this.localStorage[index],
                    bootstrapDelegatedStorageOrSelf(this.localTypes[index])
                )
            }
        }
    }

    fun emitDropsThroughScope(parent: int) {
        var scope = this.currentScope
        while (scope >= 0 && scope != parent) {
            this.emitScopeDrops(scope)
            scope = this.scopeParents[scope]
        }
    }

    fun emitOwnedParameterDrops() {
        var index = this.ownedParameters.size
        while (index > 0) {
            index = index - 1
            this.emitAffineDrop(
                this.ownedParameters[index],
                this.lowerStorageType(this.ownedParameters[index])
            )
        }
    }

    fun lowerParameterType(name: string): string {
        var result = "unknown"
        var index = 0
        while (index < this.parameters.size) {
            if (this.parameters[index] == name &&
                index < this.parameterTypes.size) {
                result = bootstrapNormalizeType(this.parameterTypes[index])
            }
            index = index + 1
        }
        if (bootstrapIsDelegatedType(result)) {
            result = bootstrapDelegatedExposedType(result)
        }
        val refined = this.lowerRefinedType(name)
        if (refined != "unknown") result = refined
        result
    }

    fun lowerRefinedType(name: string): string {
        var result = "unknown"
        var index = 0
        while (index < this.refinementNames.size) {
            if (this.refinementNames[index] == name &&
                index < this.refinementTypes.size &&
                index < this.refinementScopes.size &&
                this.localScopeVisible(this.refinementScopes[index])) {
                result = this.refinementTypes[index]
            }
            index = index + 1
        }
        result
    }

    fun addNullableRefinement(
        expression: BootstrapExpression,
        conditionIsTrue: bool
    ): void {
        val name = bootstrapNullableRefinementName(expression)
        if (name != "" &&
            (this.isLocal(name) || this.isParameter(name))) {
            var type = "unknown"
            if (this.isLocal(name)) type = this.lowerLocalType(name)
            else type = this.lowerParameterType(name)
            val nonNullWhenTrue =
                bootstrapNullableRefinementNonNullWhenTrue(expression)
            if (bootstrapIsNullableType(type) &&
                conditionIsTrue == nonNullWhenTrue) {
                this.refinementNames.append(name)
                this.refinementTypes.append(
                    bootstrapNullableElementType(type)
                )
                this.refinementScopes.append(this.currentScope)
            }
        }
    }

    fun addNullableRefinements(
        expression: BootstrapExpression,
        conditionIsTrue: bool
    ): void {
        if (expression.kind == "unary!" &&
            expression.children.size == 1) {
            this.addNullableRefinements(
                expression.children[0],
                !conditionIsTrue
            )
        } else if (expression.kind == "&&" && conditionIsTrue &&
                   expression.children.size == 2) {
            this.addNullableRefinements(expression.children[0], true)
            this.addNullableRefinements(expression.children[1], true)
        } else if (expression.kind == "||" && !conditionIsTrue &&
                   expression.children.size == 2) {
            this.addNullableRefinements(expression.children[0], false)
            this.addNullableRefinements(expression.children[1], false)
        } else this.addNullableRefinement(expression, conditionIsTrue)
    }

    fun lowerLocalType(name: string): string {
        var result = "unknown"
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index] == name &&
                index < this.localTypes.size &&
                this.localScopeVisible(this.localScopes[index])) {
                result = this.localTypes[index]
                if (result.size > 5 && result.slice(0, 5) == "cell:") {
                    result = result.slice(5, result.size)
                }
                if (bootstrapIsDelegatedType(result)) {
                    result = bootstrapDelegatedExposedType(result)
                }
            }
            index = index + 1
        }
        val refined = this.lowerRefinedType(name)
        if (refined != "unknown") result = refined
        result
    }

    fun lowerLocalMetadataType(name: string): string {
        var result = "unknown"
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index] == name &&
                index < this.localTypes.size &&
                this.localScopeVisible(this.localScopes[index])) {
                result = this.localTypes[index]
                if (result.size > 5 && result.slice(0, 5) == "cell:") {
                    result = result.slice(5, result.size)
                }
            }
            index = index + 1
        }
        result
    }

    fun lowerParameterMetadataType(name: string): string {
        var result = "unknown"
        var index = 0
        while (index < this.parameters.size) {
            if (this.parameters[index] == name &&
                index < this.parameterTypes.size) {
                result = bootstrapNormalizeType(this.parameterTypes[index])
            }
            index = index + 1
        }
        result
    }

    fun lowerGlobalMetadataType(name: string): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if ((declaration.kind == "val" || declaration.kind == "var" ||
                 declaration.kind == "compile.val" ||
                 declaration.kind == "compile.var") &&
                declaration.name == name &&
                declaration.expression.kind == "delegate.initializer" &&
                declaration.expression.children.size > 1) {
                val storage = this.lowerExpressionType(
                    declaration.expression.children[0]
                )
                var exposed = this.lowerMethodResultType(
                    storage,
                    "getValue"
                )
                if (declaration.resultType != "inferred") {
                    exposed = bootstrapNormalizeType(declaration.resultType)
                }
                result = bootstrapDelegatedType(
                    declaration.kind == "var" ||
                        declaration.kind == "compile.var",
                    storage,
                    exposed
                )
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerDelegatedMetadataType(name: string): string {
        var result = "unknown"
        if (this.isLocal(name)) result = this.lowerLocalMetadataType(name)
        else if (this.isParameter(name)) {
            result = this.lowerParameterMetadataType(name)
        } else if (this.isGlobal(name)) result = this.lowerGlobalMetadataType(name)
        result
    }

    fun lowerNameIsDelegated(name: string): bool =
        bootstrapIsDelegatedType(this.lowerDelegatedMetadataType(name))

    fun lowerStorageType(name: string): string {
        val metadata = this.lowerDelegatedMetadataType(name)
        if (bootstrapIsDelegatedType(metadata)) {
            bootstrapDelegatedStorageType(metadata)
        } else if (this.isLocal(name)) this.lowerLocalType(name)
        else if (this.isParameter(name)) this.lowerParameterType(name)
        else bootstrapGlobalValueType(this.declarations, name)
    }

    fun lowerFieldType(owner: string, field: string): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.name == owner) {
                var fieldIndex = 0
                while (fieldIndex < declaration.parameters.size) {
                    if (declaration.parameters[fieldIndex] == field &&
                        fieldIndex < declaration.parameterTypes.size) {
                        result = bootstrapNormalizeType(
                            declaration.parameterTypes[fieldIndex]
                        )
                    }
                    fieldIndex = fieldIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerFieldIndex(owner: string, field: string): int {
        val normalizedOwner = bootstrapBorrowElementType(
            bootstrapNormalizeType(owner)
        )
        var result = -1
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.kind == "class" &&
                declaration.name == normalizedOwner) {
                var parameter = 0
                var runtimeIndex = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[parameter] == "val" ||
                         declaration.parameterKinds[parameter] == "var")) {
                        if (declaration.parameters[parameter] == field) {
                            result = runtimeIndex
                        }
                        runtimeIndex = runtimeIndex + 1
                    }
                    parameter = parameter + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerFunctionResultType(name: string): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.extensionOwner == "" &&
                declaration.name == name &&
                (declaration.kind == "fun" ||
                 declaration.kind == "extern")) {
                result = bootstrapNormalizeType(declaration.resultType)
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerFunctionType(name: string): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.extensionOwner == "" &&
                declaration.name == name &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun")) {
                result = bootstrapDeclarationFunctionType(declaration)
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerMethodResultType(owner: string, name: string): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == name) {
                result = bootstrapNormalizeType(declaration.resultType)
            }
            if (declaration.name == owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val method = declaration.methods[methodIndex]
                    if (method.name == name) {
                        result = bootstrapNormalizeType(method.resultType)
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerExtensionOwner(owner: string, name: string): string {
        var result = ""
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == name) {
                result = declaration.extensionOwner
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerExpressionType(expression: BootstrapExpression): string {
        var result = "unknown"
        if (expression.kind == "integer") result = "i64"
        if (expression.kind == "float") result = "f64"
        if (expression.kind == "true" || expression.kind == "false") {
            result = "bool"
        }
        if (expression.kind == "string" ||
            expression.kind == "string.template") result = "string"
        if (expression.kind == "null") result = "null"
        if (expression.kind == "delegate.initializer" &&
            expression.children.size > 0) {
            result = this.lowerExpressionType(expression.children[0])
        }
        if (expression.kind == "compile") {
            result = this.lowerExpressionType(expression.children[0])
        }
        if (expression.kind == "region") {
            result = this.lowerExpressionType(expression.children[0])
        }
        if (expression.kind == "generator") {
            result = "generator:${this.lowerGeneratorElementType(
                expression.children[0]
            )}"
        }
        if (expression.kind == "task" || expression.kind == "thread") {
            result = "${expression.kind}:${this.lowerExpressionType(
                expression.children[0]
            )}"
        }
        if (expression.kind == "await") {
            val operation = this.lowerExpressionType(expression.children[0])
            if (bootstrapIsTaskType(operation)) {
                result = bootstrapTaskResultType(operation)
            }
            if (bootstrapIsThreadType(operation)) {
                result = bootstrapThreadResultType(operation)
            }
        }
        if (expression.kind == "yield" || expression.kind == "defer") {
            result = "void"
        }
        if (expression.kind == "identifier") {
            if (this.isParameter(expression.text)) {
                result = this.lowerParameterType(expression.text)
            } else if (this.isLocal(expression.text)) {
                result = this.lowerLocalType(expression.text)
            } else if (this.isGlobal(expression.text)) {
                result = bootstrapGlobalValueType(
                    this.declarations,
                    expression.text
                )
            } else if (this.isField(expression.text)) {
                result = this.lowerFieldType(this.currentOwner, expression.text)
            } else if (this.isFunction(expression.text)) {
                result = this.lowerFunctionType(expression.text)
            } else result = this.lowerFunctionResultType(expression.text)
            if (this.lowerNameIsDelegated(expression.text)) {
                result = bootstrapDelegatedExposedType(
                    this.lowerDelegatedMetadataType(expression.text)
                )
            }
        }
        if (expression.kind == "delegate.project" &&
            expression.children.size == 1 &&
            expression.children[0].kind == "identifier") {
            result = bootstrapDelegatedStorageType(
                this.lowerDelegatedMetadataType(
                    expression.children[0].text
                )
            )
        }
        if (expression.kind == "delegate.assign" &&
            expression.children.size == 2) {
            result = this.lowerExpressionType(expression.children[1])
        }
        if (expression.kind == "call") {
            if (expression.text == "move" && expression.children.size == 1) {
                result = this.lowerExpressionType(expression.children[0])
            }
            else if (expression.text == "Shared" &&
                     expression.children.size == 1) {
                result = "shared:${this.lowerExpressionType(
                    expression.children[0]
                )}"
            }
            else if (expression.text == "Mutex" &&
                     expression.children.size == 1) {
                result = "mutex:${this.lowerExpressionType(
                    expression.children[0]
                )}"
            }
            else if (expression.text == "Cell" &&
                     expression.children.size == 1) {
                result = "cell:${this.lowerExpressionType(
                    expression.children[0]
                )}"
            }
            else if (this.isClass(expression.text) ||
                     this.isScalarType(expression.text)) {
                result = expression.text
            }
            else if (this.isParameter(expression.text)) {
                result = bootstrapFunctionResultType(
                    this.lowerParameterType(expression.text)
                )
            } else if (this.isLocal(expression.text)) {
                result = bootstrapFunctionResultType(
                    this.lowerLocalType(expression.text)
                )
            } else if (this.isGlobal(expression.text)) {
                result = bootstrapFunctionResultType(
                    bootstrapGlobalFunctionType(
                        this.declarations,
                        expression.text
                    )
                )
            } else result = this.lowerFunctionResultType(expression.text)
        }
        if (expression.kind == "array") {
            var element = "unknown"
            if (expression.children.size > 0) {
                element = this.lowerExpressionType(expression.children[0])
            }
            result = "array:$element"
        }
        if (expression.kind == "range.closed" ||
            expression.kind == "range.until") result = "array:i64"
        if (expression.kind == "index") {
            val rawReceiver = this.lowerExpressionType(expression.children[0])
            val receiver = bootstrapBorrowElementType(rawReceiver)
            if (receiver == "string") result = "i64"
            else {
                result = bootstrapArrayElementType(receiver)
                if (bootstrapIsBorrowType(rawReceiver) &&
                    !bootstrapRegionResultIsIndependent(result)) {
                    result = "borrow:$result"
                }
                result = result
            }
        }
        if (expression.kind == "member") {
            val rawOwner = this.lowerExpressionType(expression.children[0])
            val owner = bootstrapBorrowElementType(rawOwner)
            if (expression.text == "size" &&
                (owner == "string" || bootstrapIsArrayType(owner))) {
                result = "i64"
            }
            else {
                result = this.lowerFieldType(owner, expression.text)
                if (bootstrapIsBorrowType(rawOwner) &&
                    !bootstrapRegionResultIsIndependent(result)) {
                    result = "borrow:$result"
                }
                result = result
            }
        }
        if (expression.kind == "member.call") {
            val owner = bootstrapBorrowElementType(
                this.lowerExpressionType(expression.children[0])
            )
            if (bootstrapIsMutexType(owner) &&
                expression.text == "clone") result = owner
            else if (bootstrapIsCellType(owner) &&
                    expression.text == "get") {
                result = bootstrapCellElementType(owner)
            }
            else if (bootstrapIsCellType(owner) &&
                    expression.text == "set") result = "void"
            else if (bootstrapIsMutexType(owner) &&
                    expression.text == "with" &&
                    expression.children.size > 1) {
                result = bootstrapFunctionResultType(
                    this.lowerExpressionType(expression.children[1])
                )
            }
            else if (bootstrapIsSharedType(owner) &&
                expression.text == "clone") result = owner
            else if (bootstrapIsSharedType(owner) &&
                    expression.text == "get") {
                result = "borrow:${bootstrapSharedElementType(owner)}"
            }
            else if (bootstrapIsSharedType(owner) &&
                    expression.text == "downgrade") {
                result = "weak:${bootstrapSharedElementType(owner)}"
            }
            else if (bootstrapIsWeakType(owner) &&
                    expression.text == "clone") result = owner
            else if (bootstrapIsWeakType(owner) &&
                    expression.text == "upgrade") {
                result = "nullable:shared:${bootstrapWeakElementType(owner)}"
            }
            else if (bootstrapIsWeakType(owner) &&
                    expression.text == "isAlive") result = "bool"
            else if (expression.text == "append" &&
                     bootstrapIsArrayType(owner)) {
                result = "void"
            } else if (expression.text == "slice" && owner == "string") {
                result = "string"
            }
            else result = this.lowerMethodResultType(owner, expression.text)
        }
        if (expression.kind == "unary-" || expression.kind == "unary+" ||
            expression.kind == "unary~") {
            result = this.lowerExpressionType(expression.children[0])
        }
        if (expression.kind == "unary!" ||
            expression.kind == "==" || expression.kind == "!=" ||
            expression.kind == "<" || expression.kind == "<=" ||
            expression.kind == ">" || expression.kind == ">=" ||
            expression.kind == "&&" || expression.kind == "||") {
            result = "bool"
        }
        if (expression.kind == "+" || expression.kind == "-" ||
            expression.kind == "*" || expression.kind == "/") {
            val operand = this.lowerExpressionType(expression.children[0])
            val underlying = this.scalarTypeUnderlying(operand)
            result = if (underlying == "") operand else underlying
        }
        if (expression.kind == "&" || expression.kind == "|" ||
            expression.kind == "^" || expression.kind == "<<" ||
            expression.kind == ">>" || expression.kind == ">>>") {
            val operand = this.lowerExpressionType(expression.children[0])
            val underlying = this.scalarTypeUnderlying(operand)
            result = if (underlying == "") operand else underlying
        }
        if (expression.kind == "block" && expression.children.size > 0) {
            result = this.lowerExpressionType(
                expression.children[expression.children.size - 1]
            )
        }
        if (expression.kind == "when") {
            var branchType = "unknown"
            var branch = 2
            while (branch < expression.children.size) {
                branchType = bootstrapJoinTypes(
                    branchType,
                    this.lowerExpressionType(expression.children[branch])
                )
                branch = branch + 2
            }
            result = branchType
        }
        if (expression.kind == "if") {
            val previousThenScope = this.enterLocalScope()
            this.addNullableRefinements(expression.children[0], true)
            val thenType = this.lowerExpressionType(expression.children[1])
            this.leaveLocalScope(previousThenScope)
            if (expression.children[2].kind == "missing") result = "void"
            else {
                val previousElseScope = this.enterLocalScope()
                this.addNullableRefinements(expression.children[0], false)
                val elseType = this.lowerExpressionType(expression.children[2])
                this.leaveLocalScope(previousElseScope)
                result = bootstrapJoinTypes(thenType, elseType)
            }
        }
        if (expression.kind == "lambda") {
            if (this.lambdaRequiresMutableCall(expression)) {
                result = "mut:function:unknown"
            } else result = "function:unknown"
        }
        if (expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            result = "once:function:unknown"
        }
        result
    }

    fun lowerGeneratorElementType(expression: BootstrapExpression): string {
        var result = "unknown"
        if (expression.kind == "yield" && expression.children.size == 1) {
            result = this.lowerExpressionType(expression.children[0])
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move" &&
            expression.kind != "lambda.generator" &&
            expression.kind != "generator" &&
            expression.kind != "task" && expression.kind != "thread") {
            var child = 0
            while (child < expression.children.size) {
                val found = this.lowerGeneratorElementType(
                    expression.children[child]
                )
                if (result == "unknown") result = found
                child = child + 1
            }
        }
        result
    }

    fun lowerCallDiverges(expression: BootstrapExpression): bool {
        var diverges = false
        if (expression.kind == "call") {
            if (this.isParameter(expression.text)) {
                diverges = bootstrapFunctionResultType(
                    this.lowerParameterType(expression.text)
                ) == "never"
            } else if (this.isLocal(expression.text)) {
                diverges = bootstrapFunctionResultType(
                    this.lowerLocalType(expression.text)
                ) == "never"
            } else {
                diverges = bootstrapAffineNamesContain(
                    this.neverCallNames,
                    expression.text
                )
            }
        }
        if (expression.kind == "member.call" &&
            this.neverCallNames.size > 0) {
            val owner = bootstrapBorrowElementType(
                this.lowerExpressionType(expression.children[0])
            )
            diverges = bootstrapAffineNamesContain(
                this.neverCallNames,
                "$owner.${expression.text}"
            )
        }
        diverges
    }

    fun lowerFunctionParameterKind(name: string, parameter: int): string {
        var result = "parameter"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.extensionOwner == "" &&
                declaration.name == name &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun" ||
                 declaration.kind == "extern") &&
                parameter < declaration.parameterKinds.size) {
                result = declaration.parameterKinds[parameter]
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun lowerMethodParameterKind(
        owner: string,
        name: string,
        parameter: int
    ): string {
        var result = "parameter"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == name &&
                parameter < declaration.parameterKinds.size) {
                result = declaration.parameterKinds[parameter]
            }
            if (declaration.name == owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val method = declaration.methods[methodIndex]
                    if (method.name == name &&
                        parameter < method.parameterKinds.size) {
                        result = method.parameterKinds[parameter]
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun emitBorrowMutation(expression: BootstrapExpression): void {
        val place = this.lowerPlacePath(expression)
        if (place != "") {
            this.emitControl("borrow.mutate", -1, -1, -1, place)
        }
    }

    fun localScopeVisible(scope: int): bool {
        var candidate = this.currentScope
        var visible = false
        while (candidate >= 0) {
            if (candidate == scope) visible = true
            candidate = this.scopeParents[candidate]
        }
        visible
    }

    fun enterLocalScope(): int {
        val previous = this.currentScope
        this.scopeParents.append(previous)
        this.currentScope = this.scopeParents.size - 1
        previous
    }

    fun leaveLocalScope(previous: int) {
        this.currentScope = previous
    }

    fun isParameter(name: string): bool {
        var found = false
        var index = 0
        while (index < this.parameters.size) {
            if (this.parameters[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun isCapturedParameter(name: string): bool {
        var found = false
        var index = 0
        while (index < this.capturedParameters.size) {
            if (this.capturedParameters[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun localIsCell(name: string): bool {
        var found = false
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index] == name &&
                this.localScopeVisible(this.localScopes[index]) &&
                this.localTypes[index].size > 5 &&
                this.localTypes[index].slice(0, 5) == "cell:") {
                found = true
            }
            index = index + 1
        }
        found
    }

    fun captureCell(name: string): int {
        var result = -1
        if (this.isCapturedParameter(name)) {
            result = this.emit("parameter.load", -1, -1, name)
        } else if (this.isLocal(name)) {
            var localIndex = 0
            while (localIndex < this.locals.size) {
                if (this.locals[localIndex] == name &&
                    this.localScopeVisible(this.localScopes[localIndex])) {
                    val storage = this.localStorage[localIndex]
                    val loaded = this.emit("local.load", -1, -1, storage)
                    if (this.localTypes[localIndex].size > 5 &&
                        this.localTypes[localIndex].slice(0, 5) == "cell:") {
                        result = loaded
                    } else {
                        val cell = this.emit("cell.create", loaded, -1, "")
                        this.emit("local.assign", cell, -1, storage)
                        this.localTypes[localIndex] =
                            "cell:${this.localTypes[localIndex]}"
                        result = cell
                    }
                }
                localIndex = localIndex + 1
            }
            result = result
        } else if (this.isParameter(name)) {
            val loaded = this.emit("parameter.load", -1, -1, name)
            result = this.emit("cell.create", loaded, -1, "")
        } else result = result
        result
    }

    fun lowerTypeIsAffine(type: string): bool =
        bootstrapSummaryTypeIsAffine(type, this.affineTypes)

    fun captureOwned(name: string): int {
        var result = -1
        if (this.isParameter(name)) {
            result = this.emit("parameter.load", -1, -1, name)
            this.emitControl("local.move", -1, -1, -1, name)
            result = result
        } else if (this.isLocal(name)) {
            val storage = this.storageFor(name)
            result = this.emit("local.load", -1, -1, storage)
            this.emitControl("local.move", -1, -1, -1, storage)
            result = result
        } else result = result
        result
    }

    fun appendUniqueName(var names: array<string>, name: string) {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        if (!found) names.append(name)
    }

    fun collectLambdaLocals(
        expression: BootstrapExpression,
        var names: array<string>
    ): void {
        if (expression.kind == "local.val" ||
            expression.kind == "local.var") {
            this.appendUniqueName(names, expression.text)
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move" &&
            expression.kind != "lambda.generator") {
            var child = 0
            while (child < expression.children.size) {
                this.collectLambdaLocals(expression.children[child], names)
                child = child + 1
            }
        }
    }

    fun nameIsBound(names: array<string>, name: string): bool {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun collectLambdaFreeNames(
        expression: BootstrapExpression,
        bound: array<string>,
        var free: array<string>
    ): void {
        var nested = false
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            nested = true
            val nestedBound: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nestedBound.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                this.appendUniqueName(
                    nestedBound,
                    expression.children[parameter].text
                )
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaLocals(body, nestedBound)
            this.collectLambdaFreeNames(body, nestedBound, free)
        }
        if (!nested) {
            if (expression.kind == "identifier" &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            if ((expression.kind == "call" || expression.kind == "assign") &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            var child = 0
            while (child < expression.children.size) {
                this.collectLambdaFreeNames(
                    expression.children[child],
                    bound,
                    free
                )
                child = child + 1
            }
        }
    }

    fun lambdaMutatesCapturedPlace(
        expression: BootstrapExpression,
        bound: array<string>
    ): bool {
        var mutates = false
        if (expression.kind == "assign" &&
            !this.nameIsBound(bound, expression.text) &&
            (this.isLocal(expression.text) ||
             this.isParameter(expression.text) ||
             this.isField(expression.text))) mutates = true
        if (expression.kind == "identifier" &&
            !this.nameIsBound(bound, expression.text) &&
            this.lowerNameIsDelegated(expression.text) &&
            bootstrapMutableReceiverContains(
                this.mutableReceivers,
                this.lowerStorageType(expression.text),
                "getValue"
            )) mutates = true
        if (expression.kind == "delegate.assign" &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.nameIsBound(bound, root) &&
                (this.isLocal(root) || this.isParameter(root))) mutates = true
        }
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.nameIsBound(bound, root) &&
                (this.isLocal(root) || this.isParameter(root) ||
                 root == "this")) mutates = true
        }
        if (expression.kind == "call" &&
            !this.nameIsBound(bound, expression.text)) {
            var type = "unknown"
            if (this.isLocal(expression.text)) {
                type = this.lowerLocalType(expression.text)
            }
            if (this.isParameter(expression.text)) {
                type = this.lowerParameterType(expression.text)
            }
            if (bootstrapIsMutableFunctionType(type)) mutates = true
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.nameIsBound(bound, root) &&
                (this.isLocal(root) || this.isParameter(root)) &&
                bootstrapMutableReceiverContains(
                    this.mutableReceivers,
                    bootstrapBorrowElementType(
                        this.lowerExpressionType(expression.children[0])
                    ),
                    expression.text
                )) mutates = true
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move" &&
            expression.kind != "lambda.generator") {
            var child = 0
            while (!mutates && child < expression.children.size) {
                mutates = this.lambdaMutatesCapturedPlace(
                    expression.children[child],
                    bound
                )
                child = child + 1
            }
        }
        mutates
    }

    fun lambdaRequiresMutableCall(
        expression: BootstrapExpression
    ): bool {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        this.collectLambdaLocals(body, bound)
        this.lambdaMutatesCapturedPlace(body, bound)
    }

    fun capturedByLambda(
        expression: BootstrapExpression,
        name: string
    ): bool {
        var captured = false
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            val bound: array<string> = []
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                bound.append(expression.children[parameter].text)
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaLocals(body, bound)
            val free: array<string> = []
            this.collectLambdaFreeNames(body, bound, free)
            captured = this.nameIsBound(free, name)
        } else {
            var child = 0
            while (!captured && child < expression.children.size) {
                captured = this.capturedByLambda(
                    expression.children[child],
                    name
                )
                child = child + 1
            }
            captured = captured
        }
        captured
    }

    fun isLocal(name: string): bool {
        var found = false
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index] == name &&
                this.localScopeVisible(this.localScopes[index])) found = true
            index = index + 1
        }
        found
    }

    fun storageFor(name: string): string {
        var result = name
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index] == name &&
                this.localScopeVisible(this.localScopes[index])) {
                result = this.localStorage[index]
            }
            index = index + 1
        }
        result
    }

    fun lowerDelegateSlot(name: string): int {
        var result = -1
        if (this.isParameter(name)) {
            result = this.emit("parameter.load", -1, -1, name)
            if (this.isCapturedParameter(name)) {
                result = this.emit("cell.get", result, -1, "")
            }
        } else if (this.isLocal(name)) {
            result = this.emit(
                "local.load",
                -1,
                -1,
                this.storageFor(name)
            )
            if (this.localIsCell(name)) {
                result = this.emit("cell.get", result, -1, "")
            }
        } else if (this.isGlobal(name)) {
            result = this.emit("global.load", -1, -1, name)
        }
        result
    }

    fun emitDelegatedMethod(
        name: string,
        method: string,
        arguments: array<int>,
        begin: int,
        end: int
    ): int {
        val owner = bootstrapDelegatedStorageType(
            this.lowerDelegatedMetadataType(name)
        )
        val operands: array<int> = [this.lowerDelegateSlot(name)]
        var argument = 0
        while (argument < arguments.size) {
            operands.append(arguments[argument])
            argument = argument + 1
        }
        if (bootstrapMutableReceiverContains(
            this.mutableReceivers,
            owner,
            method
        )) this.emitBorrowMutation(BootstrapExpression(
            "delegate.project",
            "",
            begin,
            end,
            [BootstrapExpression("identifier", name, begin, end, [])]
        ))
        val extensionOwner = this.lowerExtensionOwner(owner, method)
        if (extensionOwner != "") {
            this.emitMany(
                "call",
                operands,
                "extension_${extensionOwner}_$method"
            )
        } else this.emitMany("call", operands, "${owner}_$method")
    }

    fun lowerPlacePath(expression: BootstrapExpression): string {
        var result = ""
        if (expression.kind == "delegate.project" &&
            expression.children.size == 1) {
            result = this.lowerPlacePath(expression.children[0])
        }
        if (expression.kind == "identifier" &&
            (this.isLocal(expression.text) ||
             this.isParameter(expression.text))) {
            result = this.storageFor(expression.text)
        }
        if (expression.kind == "member" &&
            expression.children.size > 0) {
            val owner = this.lowerPlacePath(expression.children[0])
            if (owner != "") result = "$owner.${expression.text}"
        }
        if (expression.kind == "index" &&
            expression.children.size > 1) {
            val owner = this.lowerPlacePath(expression.children[0])
            if (owner != "") {
                var index = "*"
                if (expression.children[1].kind == "integer") {
                    index = expression.children[1].text
                }
                result = "$owner[$index]"
            }
        }
        result
    }

    fun lowerBorrowArgumentSource(
        expression: BootstrapExpression
    ): string {
        var source = this.lowerBorrowSource(expression)
        if (source == "") source = this.lowerPlacePath(expression)
        source
    }

    fun lowerManagedAliasSource(
        expression: BootstrapExpression,
        sourceKey: string
    ): string {
        var source = ""
        if (sourceKey != "" &&
            bootstrapOwnershipPlaceKey(expression) == sourceKey) {
            source = this.lowerBorrowArgumentSource(expression)
        }
        var child = 0
        while (source == "" && child < expression.children.size) {
            source = this.lowerManagedAliasSource(
                expression.children[child],
                sourceKey
            )
            child = child + 1
        }
        if (source == "") source = this.lowerBorrowSource(expression)
        source
    }

    fun lowerBorrowSource(expression: BootstrapExpression): string {
        var source = ""
        if (expression.kind == "identifier" &&
            this.lowerNameIsDelegated(expression.text) &&
            bootstrapIsBorrowType(this.lowerExpressionType(expression))) {
            source = this.lowerPlacePath(BootstrapExpression(
                "delegate.project",
                "",
                expression.begin,
                expression.end,
                [expression]
            ))
        }
        if (expression.kind == "member.call" && expression.text == "get" &&
            expression.children.size == 1 && bootstrapIsSharedType(
                bootstrapBorrowElementType(this.lowerExpressionType(
                    expression.children[0]
                ))
            )) {
            source = this.lowerPlacePath(expression.children[0])
        }
        if (expression.kind == "call") {
            val contract = bootstrapBorrowCallResultSource(
                this.declarations,
                "",
                expression.text
            )
            val parameter = bootstrapBorrowCallResultParameter(
                this.declarations,
                "",
                expression.text,
                contract
            )
            if (contract != "" && parameter >= 0 &&
                parameter < expression.children.size) {
                source = this.lowerBorrowArgumentSource(
                    expression.children[parameter]
                )
            }
            if (source == "") {
                var functionType = "unknown"
                if (this.isParameter(expression.text)) {
                    functionType = this.lowerParameterType(expression.text)
                }
                if (this.isLocal(expression.text)) {
                    functionType = this.lowerLocalType(expression.text)
                }
                if (this.isGlobal(expression.text)) {
                    functionType = bootstrapGlobalFunctionType(
                        this.declarations,
                        expression.text
                    )
                }
                val indirectSource =
                    bootstrapFunctionBorrowResultParameter(functionType)
                if (indirectSource >= 0 &&
                    indirectSource < expression.children.size) {
                    source = this.lowerBorrowArgumentSource(
                        expression.children[indirectSource]
                    )
                }
            }
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0 && expression.text != "get") {
            val owner = bootstrapBorrowElementType(
                this.lowerExpressionType(expression.children[0])
            )
            val contract = bootstrapBorrowCallResultSource(
                this.declarations,
                owner,
                expression.text
            )
            if (contract == "this") {
                source = this.lowerBorrowArgumentSource(
                    expression.children[0]
                )
            }
            if (contract != "" && contract != "this") {
                val parameter = bootstrapBorrowCallResultParameter(
                    this.declarations,
                    owner,
                    expression.text,
                    contract
                )
                if (parameter >= 0 &&
                    parameter + 1 < expression.children.size) {
                    source = this.lowerBorrowArgumentSource(
                        expression.children[parameter + 1]
                    )
                }
            }
        }
        if (expression.kind == "identifier" &&
            this.isLocal(expression.text) &&
            bootstrapIsBorrowType(this.lowerLocalType(expression.text))) {
            var localIndex = 0
            while (localIndex < this.locals.size) {
                if (this.locals[localIndex] == expression.text &&
                    this.localScopeVisible(this.localScopes[localIndex]) &&
                    localIndex < this.localBorrowSources.size) {
                    source = this.localBorrowSources[localIndex]
                }
                localIndex = localIndex + 1
            }
        }
        if ((expression.kind == "member" || expression.kind == "index") &&
            expression.children.size > 0) {
            source = this.lowerBorrowSource(expression.children[0])
        }
        if (expression.kind == "block" && expression.children.size > 0) {
            source = this.lowerBorrowSource(
                expression.children[expression.children.size - 1]
            )
        }
        if (expression.kind == "if" && expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            val thenSource = this.lowerBorrowSource(expression.children[1])
            val elseSource = this.lowerBorrowSource(expression.children[2])
            if (thenSource != "" && thenSource == elseSource) {
                source = thenSource
            } else source = ""
        }
        if (expression.kind == "when") {
            var joinedSource = ""
            var valid = true
            var branch = 2
            while (branch < expression.children.size) {
                val branchSource = this.lowerBorrowSource(
                    expression.children[branch]
                )
                if (branchSource == "") valid = false
                if (joinedSource == "") {
                    joinedSource = branchSource
                    valid = valid
                } else {
                    if (joinedSource != branchSource) valid = false
                    valid = valid
                }
                branch = branch + 2
            }
            if (valid) source = joinedSource
            else source = ""
        }
        source
    }

    fun lowerPlaceProjection(expression: BootstrapExpression): int {
        var result = -1
        if (expression.kind == "identifier" &&
            (this.isLocal(expression.text) ||
             this.isParameter(expression.text))) {
            result = this.emit(
                "place.root",
                -1,
                -1,
                this.storageFor(expression.text)
            )
            if ((this.isLocal(expression.text) &&
                 this.localIsCell(expression.text)) ||
                (this.isParameter(expression.text) &&
                 this.isCapturedParameter(expression.text))) {
                result = this.emit("cell.get", result, -1, "")
            }
            result = result
        } else if (expression.kind == "member") {
            val receiver = this.lowerPlaceProjection(expression.children[0])
            result = this.emitFieldGet(
                receiver,
                this.lowerExpressionType(expression.children[0]),
                expression.text
            )
        } else if (expression.kind == "index") {
            val receiver = this.lowerPlaceProjection(expression.children[0])
            val index = this.lowerExpression(expression.children[1])
            val receiverType = bootstrapBorrowElementType(
                this.lowerExpressionType(expression.children[0])
            )
            val opcode = this.lowerIndexGetOpcode(receiverType)
            result = this.emit(opcode, receiver, index, "")
        } else result = this.lowerExpression(expression)
        result
    }

    fun isClass(name: string): bool {
        var found = false
        var index = 0
        while (index < this.declarations.size) {
            if (this.declarations[index].kind == "class" &&
                this.declarations[index].name == name) found = true
            index = index + 1
        }
        found
    }

    fun isScalarType(name: string): bool =
        bootstrapScalarTypeUnderlying(this.declarations, name) != "" ||
        bootstrapScalarTypeUnderlyingValid(bootstrapNormalizeType(name))

    fun scalarTypeUnderlying(name: string): string {
        val underlying = bootstrapScalarTypeUnderlying(
            this.declarations, name
        )
        if (underlying == "") bootstrapNormalizeType(name) else underlying
    }

    fun isExternal(name: string): bool {
        var found = false
        var index = 0
        while (index < this.declarations.size) {
            if (this.declarations[index].extensionOwner == "" &&
                this.declarations[index].kind == "extern" &&
                this.declarations[index].name == name) found = true
            index = index + 1
        }
        found
    }

    fun isFunction(name: string): bool {
        var found = false
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if (declaration.extensionOwner == "" &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.name == name) found = true
            index = index + 1
        }
        found
    }

    fun isNativeInterruptHandler(name: string): bool {
        var found = false
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if (declaration.extensionOwner == "" &&
                declaration.kind == "fun" &&
                declaration.name == name &&
                declaration.parameters.size == 0 &&
                bootstrapNormalizeType(declaration.resultType) == "void") {
                found = true
            }
            index = index + 1
        }
        found
    }

    fun isNativeAddressableFunction(name: string): bool {
        var found = false
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if (declaration.extensionOwner == "" &&
                declaration.kind == "fun" && declaration.name == name) {
                var valid = declaration.resultType == "void" ||
                    bootstrapExportScalarTypeValid(
                        bootstrapExportRuntimeType(
                            this.declarations, declaration.resultType
                        )
                    )
                var parameter = 0
                while (valid && parameter < declaration.parameterTypes.size) {
                    valid = bootstrapExportScalarTypeValid(
                        bootstrapExportRuntimeType(
                            this.declarations,
                            declaration.parameterTypes[parameter]
                        )
                    )
                    parameter = parameter + 1
                }
                if (valid) found = true
            }
            index = index + 1
        }
        found
    }

    fun isGlobal(name: string): bool {
        var found = false
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if ((declaration.kind == "val" || declaration.kind == "var" ||
                 declaration.kind == "compile.val" ||
                 declaration.kind == "compile.var") &&
                declaration.name == name) found = true
            index = index + 1
        }
        found
    }

    fun externalLibrary(name: string): string {
        var result = ""
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if (declaration.extensionOwner == "" &&
                declaration.kind == "extern" && declaration.name == name) {
                result = declaration.externalLibrary
            }
            index = index + 1
        }
        result
    }

    fun isField(name: string): bool {
        var found = false
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.name == this.currentOwner) {
                var fieldIndex = 0
                while (fieldIndex < declaration.parameters.size) {
                    if (declaration.parameters[fieldIndex] == name &&
                        fieldIndex < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[fieldIndex] == "val" ||
                         declaration.parameterKinds[fieldIndex] == "var")) {
                        found = true
                    }
                    fieldIndex = fieldIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        found
    }

    fun methodOwner(name: string): string {
        var result = ""
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            var methodIndex = 0
            while (methodIndex < declaration.methods.size) {
                if (declaration.methods[methodIndex].name == name) {
                    result = declaration.name
                }
                methodIndex = methodIndex + 1
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun allocateLabel(): int {
        val label = this.nextLabel
        this.nextLabel = this.nextLabel + 1
        label
    }

    fun emit(opcode: string, left: int, right: int, text: string): int {
        val result = this.nextValue
        this.nextValue = this.nextValue + 1
        this.instructions.append(BootstrapInstruction(
            opcode,
            result,
            left,
            right,
            text,
            -1,
            -1,
            [],
            []
        ))
        result
    }

    fun emitControl(
        opcode: string,
        value: int,
        target: int,
        alternate: int,
        text: string
    ) {
        this.instructions.append(BootstrapInstruction(
            opcode,
            -1,
            value,
            -1,
            text,
            target,
            alternate,
            [],
            []
        ))
    }

    fun emitMany(
        opcode: string,
        operands: array<int>,
        text: string
    ): int {
        val result = this.nextValue
        this.nextValue = this.nextValue + 1
        var left = -1
        var right = -1
        if (operands.size > 0) left = operands[0]
        if (operands.size > 1) right = operands[1]
        this.instructions.append(BootstrapInstruction(
            opcode,
            result,
            left,
            right,
            text,
            -1,
            -1,
            operands,
            []
        ))
        result
    }

    fun emitManyTexts(
        opcode: string,
        operands: array<int>,
        text: string,
        texts: array<string>
    ): int {
        val result = this.nextValue
        this.nextValue = this.nextValue + 1
        var left = -1
        var right = -1
        if (operands.size > 0) left = operands[0]
        if (operands.size > 1) right = operands[1]
        this.instructions.append(BootstrapInstruction(
            opcode,
            result,
            left,
            right,
            text,
            -1,
            -1,
            operands,
            texts
        ))
        result
    }

    fun emitIndexed(
        opcode: string,
        operands: array<int>,
        text: string,
        index: int
    ): int {
        val result = this.nextValue
        this.nextValue = this.nextValue + 1
        var left = -1
        var right = -1
        if (operands.size > 0) left = operands[0]
        if (operands.size > 1) right = operands[1]
        this.instructions.append(BootstrapInstruction(
            opcode,
            result,
            left,
            right,
            text,
            index,
            -1,
            operands,
            []
        ))
        result
    }

    fun emitFieldGet(receiver: int, owner: string, field: string): int {
        val index = this.lowerFieldIndex(owner, field)
        if (index >= 0) {
            val fieldType = this.lowerFieldType(
                bootstrapBorrowElementType(owner), field
            )
            var opcode = "field.get.indexed"
            if (fieldType == "i64") opcode = "field.get.indexed.i64"
            if (fieldType == "bool") opcode = "field.get.indexed.bool"
            if (fieldType == "f64") opcode = "field.get.indexed.f64"
            this.emitIndexed(opcode, [receiver], field, index)
        } else this.emit("field.get", receiver, -1, field)
    }

    fun emitFieldSet(
        receiver: int,
        value: int,
        owner: string,
        field: string
    ): int {
        val index = this.lowerFieldIndex(owner, field)
        if (index >= 0) {
            val fieldType = this.lowerFieldType(
                bootstrapBorrowElementType(owner), field
            )
            var opcode = "field.set.indexed"
            if (fieldType == "i64") opcode = "field.set.indexed.i64"
            if (fieldType == "bool") opcode = "field.set.indexed.bool"
            if (fieldType == "f64") opcode = "field.set.indexed.f64"
            this.emitIndexed(
                opcode, [receiver, value], field, index
            )
        } else this.emitMany("field.set", [receiver, value], field)
    }

    fun lowerIndexGetOpcode(receiverType: string): string {
        val receiver = bootstrapBorrowElementType(receiverType)
        var opcode = "index.get"
        if (receiver == "string") opcode = "string.get"
        if (bootstrapIsArrayType(receiver)) {
            val element = bootstrapArrayElementType(receiver)
            if (element == "i64") opcode = "array.get.i64"
            else if (element == "bool") opcode = "array.get.bool"
            else if (element == "f64") opcode = "array.get.f64"
            else opcode = "array.get"
        }
        opcode
    }

    fun emitEvaluated(value: BootstrapEvalValue): int {
        var result = -1
        var seen = -1
        var seenIndex = 0
        while (seenIndex < this.evaluatedValues.size) {
            if (this.evaluatedValues[seenIndex] == value) seen = seenIndex
            seenIndex = seenIndex + 1
        }
        if (seen >= 0) result = this.evaluatedResults[seen]
        if (value.kind == "integer") {
            result = this.emit("const.i64", -1, -1, "${value.integer}")
        }
        if (value.kind == "boolean") {
            var booleanText = "false"
            if (value.boolean) booleanText = "true"
            else booleanText = booleanText
            result = this.emit("const.bool", -1, -1, booleanText)
        }
        if (value.kind == "string") {
            result = this.emit("const.string", -1, -1, value.text)
        }
        if (value.kind == "null") {
            result = this.emit("const.null", -1, -1, "")
        }
        if (value.kind == "array" && seen < 0) {
            val empty: array<int> = []
            result = this.emitMany("array.create", empty, "")
            this.evaluatedValues.append(value)
            this.evaluatedResults.append(result)
            var element = 0
            while (element < value.elements.size) {
                val elementValue = this.emitEvaluated(value.elements[element])
                val appendOperands: array<int> = [result, elementValue]
                this.emitMany("array.append", appendOperands, "")
                element = element + 1
            }
        }
        if (value.kind == "object" && seen < 0) {
            result = this.emit("object.allocate", -1, -1, value.owner)
            this.evaluatedValues.append(value)
            this.evaluatedResults.append(result)
            var field = 0
            while (field < value.fieldNames.size &&
                   field < value.elements.size) {
                val fieldValue = this.emitEvaluated(value.elements[field])
                val fieldOperands: array<int> = [result, fieldValue]
                this.emitMany(
                    "field.set",
                    fieldOperands,
                    value.fieldNames[field]
                )
                field = field + 1
            }
        }
        if (result < 0) this.errors = this.errors + 1
        result
    }

    fun appendLogicalOperands(
        expression: BootstrapExpression,
        operation: string,
        var operands: array<BootstrapExpression>
    ): void {
        if (expression.kind == operation && expression.children.size == 2) {
            this.appendLogicalOperands(
                expression.children[0], operation, operands
            )
            this.appendLogicalOperands(
                expression.children[1], operation, operands
            )
        } else operands.append(expression)
    }

    // Generated syntax may associate binary chains differently from the
    // parser. Flatten either shape, then lower left-to-right without recursing
    // through lowerExpression's large general-purpose stack frame.
    fun lowerLogicalExpression(expression: BootstrapExpression): int {
        val operation = expression.kind
        val operands: array<BootstrapExpression> = []
        this.appendLogicalOperands(expression, operation, operands)

        val temporaryId = this.allocateLabel()
        val temporary = "logical_result_$temporaryId"
        this.emitControl("local.zero.bool", -1, -1, -1, temporary)
        val shortcutLabel = this.allocateLabel()
        val mergeLabel = this.allocateLabel()
        var current = this.lowerExpression(operands[0])
        val previousLogicalScope = this.enterLocalScope()
        var operand = 1
        while (operand < operands.size) {
            val evaluateLabel = this.allocateLabel()
            if (operation == "&&") {
                this.emitControl(
                    "branch", current, evaluateLabel, shortcutLabel, ""
                )
            } else {
                this.emitControl(
                    "branch", current, shortcutLabel, evaluateLabel, ""
                )
            }
            this.emitControl("label", -1, evaluateLabel, -1, "")
            this.addNullableRefinements(
                operands[operand - 1], operation == "&&"
            )
            current = this.lowerExpression(operands[operand])
            operand = operand + 1
        }
        this.leaveLocalScope(previousLogicalScope)
        this.emitControl("local.set", current, -1, -1, temporary)
        this.emitControl("jump", -1, mergeLabel, -1, "")
        this.emitControl("label", -1, shortcutLabel, -1, "")
        val shortcut = this.emit(
            "const.bool", -1, -1, if (operation == "&&") "false" else "true"
        )
        this.emitControl("local.set", shortcut, -1, -1, temporary)
        this.emitControl("jump", -1, mergeLabel, -1, "")
        this.emitControl("label", -1, mergeLabel, -1, "")
        this.emit("local.load", -1, -1, temporary)
    }

    fun lowerExpression(expression: BootstrapExpression): int {
        var result = -1
        if (expression.kind == "integer") {
            result = this.emit("const.i64", -1, -1, expression.text)
        }
        if (expression.kind == "float") {
            result = this.emit("const.f64", -1, -1, expression.text)
        }
        if (expression.kind == "true" || expression.kind == "false") {
            result = this.emit("const.bool", -1, -1, expression.text)
        }
        if (expression.kind == "string") {
            result = this.emit("const.string", -1, -1, expression.text)
        }
        if (expression.kind == "string.template") {
            result = this.emit("const.string", -1, -1, "")
            var part = 0
            while (part < expression.children.size) {
                val child = expression.children[part]
                val value = this.lowerExpression(child)
                val text = if (this.lowerExpressionType(child) == "string") {
                    value
                } else this.emit("to.string", value, -1, "")
                result = this.emit("string.concat", result, text, "")
                part = part + 1
            }
        }
        if (expression.kind == "array") {
            val elements: array<int> = []
            var element = 0
            while (element < expression.children.size) {
                elements.append(this.lowerExpression(expression.children[element]))
                element = element + 1
            }
            result = this.emitMany("array.create", elements, "")
        }
        if (expression.kind == "range.closed" ||
            expression.kind == "range.until") {
            val begin = this.lowerExpression(expression.children[0])
            val end = this.lowerExpression(expression.children[1])
            val elements: array<int> = []
            result = this.emitMany("array.create", elements, "")
            val temporary = "range_current_${this.nextLabel}"
            this.emitControl("local.zero.i64", -1, -1, -1, temporary)
            this.emitControl("local.set", begin, -1, -1, temporary)
            val conditionLabel = this.allocateLabel()
            val bodyLabel = this.allocateLabel()
            val incrementLabel = this.allocateLabel()
            val mergeLabel = this.allocateLabel()
            this.emitControl("jump", -1, conditionLabel, -1, "")
            this.emitControl("label", -1, conditionLabel, -1, "")
            val current = this.emit("local.load", -1, -1, temporary)
            var operation = "<"
            if (expression.kind == "range.closed") operation = "<="
            val more = this.emit(operation, current, end, "")
            this.emitControl("branch", more, bodyLabel, mergeLabel, "")
            this.emitControl("label", -1, bodyLabel, -1, "")
            val appendOperands: array<int> = [result, current]
            this.emitMany("array.append", appendOperands, "")
            if (expression.kind == "range.closed") {
                val complete = this.emit("==", current, end, "")
                this.emitControl(
                    "branch",
                    complete,
                    mergeLabel,
                    incrementLabel,
                    ""
                )
            } else {
                this.emitControl("jump", -1, incrementLabel, -1, "")
            }
            this.emitControl("label", -1, incrementLabel, -1, "")
            val one = this.emit("const.i64", -1, -1, "1")
            val next = this.emit("+", current, one, "")
            this.emitControl("local.set", next, -1, -1, temporary)
            this.emitControl("jump", -1, conditionLabel, -1, "")
            this.emitControl("label", -1, mergeLabel, -1, "")
        }
        if (expression.kind == "null") {
            result = this.emit("const.null", -1, -1, "")
        }
        if (expression.kind == "delegate.initializer" &&
            expression.children.size > 0) {
            result = this.lowerExpression(expression.children[0])
        }
        if (expression.kind == "compile") {
            if (this.validationOnly) {
                result = this.emit("const.void", -1, -1, "")
            } else {
                val evaluated = bootstrapEvaluate(
                    expression.children[0],
                    this.declarations
                )
                this.recordCompileInputs(evaluated)
                if (evaluated.diagnostics != "") {
                    bootstrapStageDriverDiagnostic(evaluated.diagnostics)
                }
                this.errors = this.errors + evaluated.errors
                result = this.emitEvaluated(evaluated.value)
            }
        }
        if (expression.kind == "region") {
            val checkpoint = this.emitMany(
                "call",
                [],
                "__ablaRuntimePlatformRegionBegin"
            )
            result = this.lowerExpression(expression.children[0])
            this.emitMany(
                "call",
                [checkpoint],
                "__ablaRuntimePlatformRegionEnd"
            )
        }
        if (expression.kind == "identifier") {
            if (this.lowerNameIsDelegated(expression.text)) {
                result = this.emitDelegatedMethod(
                    expression.text,
                    "getValue",
                    [],
                    expression.begin,
                    expression.end
                )
            } else if (this.isField(expression.text) &&
                !this.isParameter(expression.text) &&
                !this.isLocal(expression.text)) {
                val receiver = this.emit(
                    "parameter.load",
                    -1,
                    -1,
                    "this"
                )
                var object = receiver
                if (this.isCapturedParameter("this")) {
                    object = this.emit("cell.get", receiver, -1, "")
                }
                result = this.emitFieldGet(
                    object,
                    this.currentOwner,
                    expression.text
                )
            } else if (this.isParameter(expression.text) ||
                       this.isLocal(expression.text) ||
                       this.isGlobal(expression.text)) {
                val opcode =
                    if (this.isParameter(expression.text)) "parameter.load"
                    else if (this.isLocal(expression.text)) "local.load"
                    else "global.load"
                val storage =
                    if (opcode == "local.load") this.storageFor(expression.text)
                    else expression.text
                result = this.emit(opcode, -1, -1, storage)
                if ((opcode == "local.load" &&
                     this.localIsCell(expression.text)) ||
                    (opcode == "parameter.load" &&
                     this.isCapturedParameter(expression.text))) {
                    result = this.emit("cell.get", result, -1, "")
                } else result = result
            } else if (this.isFunction(expression.text)) {
                result = this.emit("function.ref", -1, -1, expression.text)
            } else {
                this.errors = this.errors + 1
                result = this.emit("invalid", -1, -1, expression.text)
            }
            if (this.isImplicitResult(expression)) {
                this.emitResultMove(expression)
            }
        }
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            val lambdaInstructions: array<BootstrapInstruction> = []
            val lambdaParameters: array<string> = []
            val lambdaParameterTypes: array<string> = []
            val lambdaAbiParameterTypes: array<string> = []
            val explicitParameters: array<string> = []
            val explicitParameterTypes: array<string> = []
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                val found = expression.children[parameter]
                explicitParameters.append(found.text)
                if (found.children.size > 0) {
                    explicitParameterTypes.append(found.children[0].text)
                } else explicitParameterTypes.append("unknown")
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            val bound: array<string> = []
            parameter = 0
            while (parameter < explicitParameters.size) {
                bound.append(explicitParameters[parameter])
                parameter = parameter + 1
            }
            this.collectLambdaLocals(body, bound)
            val free: array<string> = []
            this.collectLambdaFreeNames(body, bound, free)
            val captureNames: array<string> = []
            val capturedCells: array<string> = []
            val ownedCaptures: array<string> = []
            val captureValues: array<int> = []
            var freeIndex = 0
            while (freeIndex < free.size) {
                var captureName = free[freeIndex]
                if (this.isField(captureName) && this.currentOwner != "") {
                    captureName = "this"
                }
                if ((this.isParameter(captureName) ||
                     this.isLocal(captureName)) &&
                    !this.nameIsBound(captureNames, captureName)) {
                    captureNames.append(captureName)
                    var captureType = this.lowerLocalType(captureName)
                    if (this.isParameter(captureName)) {
                        captureType = this.lowerParameterType(captureName)
                    }
                    if (this.lowerNameIsDelegated(captureName)) {
                        captureType = this.lowerDelegatedMetadataType(
                            captureName
                        )
                    }
                    val captureStorageType =
                        bootstrapDelegatedStorageOrSelf(captureType)
                    if (this.lowerTypeIsAffine(captureStorageType) &&
                        (expression.kind == "lambda.move" ||
                         expression.kind == "lambda.generator")) {
                        captureValues.append(this.captureOwned(captureName))
                        ownedCaptures.append(captureName)
                        lambdaAbiParameterTypes.append(captureType)
                    } else {
                        if (this.lowerTypeIsAffine(captureStorageType)) {
                            this.errors = this.errors + 1
                        }
                        capturedCells.append(captureName)
                        captureValues.append(this.captureCell(captureName))
                        // Ordinary captures are passed as cell objects even
                        // when the captured source value is scalar.
                        lambdaAbiParameterTypes.append("unknown")
                    }
                    lambdaParameterTypes.append(captureType)
                    lambdaParameters.append(captureName)
                }
                freeIndex = freeIndex + 1
            }
            parameter = 0
            while (parameter < explicitParameters.size) {
                lambdaParameters.append(explicitParameters[parameter])
                lambdaParameterTypes.append(explicitParameterTypes[parameter])
                lambdaAbiParameterTypes.append(
                    explicitParameterTypes[parameter]
                )
                parameter = parameter + 1
            }
            val lambdaLocals: array<string> = []
            val lambdaLocalTypes: array<string> = []
            val lambdaStorage: array<string> = []
            val lambdaScopes: array<int> = []
            val lambdaEvaluatedValues: array<BootstrapEvalValue> = []
            val lambdaEvaluatedResults: array<int> = []
            val lambdaImplicitResults: array<BootstrapExpression> = []
            this.collectImplicitResults(body, lambdaImplicitResults)
            val lambdaLowerer = BootstrapLowerer(
                lambdaInstructions,
                this.functions,
                lambdaParameters,
                lambdaParameterTypes,
                ownedCaptures,
                capturedCells,
                lambdaLocals,
                lambdaLocalTypes,
                lambdaStorage,
                lambdaScopes,
                [],
                [],
                [],
                [-1],
                0,
                this.declarations,
                this.affineTypes,
                this.neverCallNames,
                this.mutableReceivers,
                this.managedAliasBegins,
                this.managedAliasEnds,
                this.managedAliasSources,
                [],
                [],
                [],
                lambdaImplicitResults,
                this.currentOwner,
                lambdaEvaluatedValues,
                lambdaEvaluatedResults,
                this.compileInputPaths,
                this.compileInputContents,
                0,
                0,
                -1,
                -1,
                -1,
                -1,
                this.validationOnly,
                this.errors
            )
            val lambdaResult = lambdaLowerer.lowerExpression(body)
            lambdaLowerer.emitOwnedParameterDrops()
            this.errors = lambdaLowerer.errors
            // Transactional declaration sinks restart their local function
            // index. Source spans keep lambda symbols deterministic and unique
            // across independently committed declarations.
            val lambdaName =
                "lambda_${expression.begin}_${expression.end}_${this.functions.size}"
            val lambdaFunction = bootstrapFinalizeIrFunction(
                lambdaName,
                lambdaParameters,
                lambdaInstructions,
                lambdaResult,
                bootstrapIrRuntimeTypes(
                    this.declarations, lambdaAbiParameterTypes
                ),
                "unknown",
                lambdaLowerer.localStorage,
                bootstrapIrRuntimeTypes(
                    this.declarations, lambdaLowerer.localTypes
                )
            )
            this.errors = this.errors + lambdaFunction.verificationErrors
            this.functions.append(lambdaFunction)
            if (expression.kind == "lambda.move" ||
                expression.kind == "lambda.generator") {
                val lambdaDropTypes: array<string> = []
                var dropType = 0
                while (dropType < lambdaParameterTypes.size) {
                    lambdaDropTypes.append(bootstrapDelegatedStorageOrSelf(
                        lambdaParameterTypes[dropType]
                    ))
                    dropType = dropType + 1
                }
                val closureDrop = bootstrapBuildClosureDropFunction(
                    lambdaName,
