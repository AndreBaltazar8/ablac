// Program changes that compile-time code requests through
// compilerGenerateModule. The staged parser applies them as a transaction
// after the compiler.transform handlers have run; like the other staged
// requests they live in a private per-process directory, and only their count
// is global.

var bootstrapGeneratedModuleRequestCount: int = 0

class BootstrapGeneratedModuleRequest(
    val namespace: string,
    val source: string
)

fun bootstrapGeneratedModuleRequestRoot(): string =
    "build/.abla-generated-module-requests-${linuxProcessId()}"

// Stages one generated module. Only a compiler.transform handler runs before
// the program is analyzed, so only there can a new module still join it.
fun bootstrapStageGeneratedModule(
    request: BootstrapGeneratedModuleRequest
): bool {
    var valid = bootstrapCompilerTransformActive &&
        request.namespace.size > 0 && request.namespace.size <= 256 &&
        request.source.size <= 65536 &&
        bootstrapGeneratedModuleRequestCount < 64
    val root = bootstrapGeneratedModuleRequestRoot()
    var index = 0
    while (valid && index < bootstrapGeneratedModuleRequestCount) {
        if (Path("$root/$index.namespace").readText() == request.namespace) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val slot = bootstrapGeneratedModuleRequestCount
    if (valid) valid = Path("$root/$slot.namespace").writeTextAtomic(
        request.namespace
    )
    if (valid) valid = Path("$root/$slot.source").writeTextAtomic(
        request.source
    )
    if (valid) bootstrapGeneratedModuleRequestCount = slot + 1
    if (!valid) {
        Path("$root/$slot.namespace").remove()
        Path("$root/$slot.source").remove()
    }
    valid
}

fun bootstrapTakeGeneratedModules(): array<BootstrapGeneratedModuleRequest> {
    val requests: array<BootstrapGeneratedModuleRequest> = []
    val root = bootstrapGeneratedModuleRequestRoot()
    var index = 0
    while (index < bootstrapGeneratedModuleRequestCount) {
        requests.append(BootstrapGeneratedModuleRequest(
            Path("$root/$index.namespace").readText(),
            Path("$root/$index.source").readText()
        ))
        Path("$root/$index.namespace").remove()
        Path("$root/$index.source").remove()
        index = index + 1
    }
    if (bootstrapGeneratedModuleRequestCount > 0) Path(root).remove()
    bootstrapGeneratedModuleRequestCount = 0
    requests
}
