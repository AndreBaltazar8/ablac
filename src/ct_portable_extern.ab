import "parser.ab"

// A user extern may share a host-runtime name only when its complete source
// contract agrees. Defaults or annotations need a separate proof, so reject them.
fun bootstrapCtSameExtern(left: BootstrapDeclaration, right: BootstrapDeclaration): bool {
    if (left.kind != "extern" || right.kind != "extern" ||
        left.name != right.name || left.extensionOwner != right.extensionOwner ||
        left.externalLibrary != right.externalLibrary || left.resultType != right.resultType ||
        left.isTrusted != right.isTrusted || left.isNoEscape != right.isNoEscape ||
        left.isResource != right.isResource || left.isPrivate != right.isPrivate ||
        left.annotations.size != 0 || right.annotations.size != 0 ||
        left.typeParameters.size != 0 || right.typeParameters.size != 0 ||
        left.parameters.size != right.parameters.size ||
        left.parameterTypes.size != right.parameterTypes.size ||
        left.parameterKinds.size != right.parameterKinds.size ||
        left.parameterDefaults.size != right.parameterDefaults.size) return false
    var index = 0
    while (index < left.parameters.size) {
        if (left.parameters[index] != right.parameters[index]) return false
        index += 1
    }
    index = 0
    while (index < left.parameterTypes.size) {
        if (left.parameterTypes[index] != right.parameterTypes[index]) return false
        index += 1
    }
    index = 0
    while (index < left.parameterKinds.size) {
        if (left.parameterKinds[index] != right.parameterKinds[index]) return false
        index += 1
    }
    index = 0
    while (index < left.parameterDefaults.size) {
        if (left.parameterDefaults[index].kind != "missing" ||
            right.parameterDefaults[index].kind != "missing") return false
        index += 1
    }
    true
}

// Two declarations of one compiler intrinsic: the same name, parameter and
// result types. An intrinsic has no symbol, so a private or trusted prototype
// in one module and a public one in another are the same operation (the
// hosted platform declares ablaHostIsMacOS privately, abla/platform/host
// publicly).
fun bootstrapCtSameIntrinsic(left: BootstrapDeclaration, right: BootstrapDeclaration): bool {
    if (left.kind != "extern" || right.kind != "extern" ||
        left.externalLibrary != "intrinsic" || right.externalLibrary != "intrinsic" ||
        left.name != right.name || left.extensionOwner != right.extensionOwner ||
        left.resultType != right.resultType ||
        left.parameterTypes.size != right.parameterTypes.size) return false
    var index = 0
    while (index < left.parameterTypes.size) {
        if (left.parameterTypes[index] != right.parameterTypes[index]) return false
        index += 1
    }
    true
}
