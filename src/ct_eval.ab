// Compile-time evaluation as native code: the calls (ABLA_COMPILE_EVAL=jit|auto).
//
// ct_jit.ab prepares, per compile pass, one generation of native code with an entry
// per compile-time site; this file runs those entries where the interpreter would
// run the site, in the same order, and needs nothing of LLVM to do it: entries,
// the guard and the support functions are addresses resolved when the generation
// was added. A site with no entry runs in the interpreter.
//
// JIT code has a runtime of its own, so no heap pointer crosses: an entry encodes
// its result with the value codec's encoder (ct_lift.ab) as `[length:i64][bytes]`
// in its own memory and returns the address; the compiler copies the bytes, frees
// them there and decodes them with the static type (bootstrapCtLiftDecode), as the
// interpreter's lift would have built the value.

import "eval.ab"
import "ct_lift.ab"
import "abla/unsafe/memory"
import "abla/bytes"

trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I64_I64(
    address: int,
    argument: int
): int
trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I64_I64_I64(
    address: int,
    first: int,
    second: int
): int

// A place the interpreter would evaluate: `expression` (the operand of a
// `compile` node, or a top-level action), the node itself (actions: the action),
// and, once prepared, the entry's number or why the site stays interpreted.
class BootstrapCtSite(
    val expression: BootstrapExpression,
    val node: BootstrapExpression,
    val sourceIdentity: string,
    val action: bool,
    var type: string,
    var id: int,
    var reason: string,
    // The entry's address in the live generation (0: none).
    var entry: int,
    // Whether its entry encodes a value (false: an action, or a void or null
    // result, which the entry only runs).
    var encodes: bool = false
)

val BOOTSTRAP_CT_UNPREPARED = "the program has semantic errors"

// A compile global the live generation holds (`compile val` / `compile var`): its
// declaration, keep-store key, type, the journal text last exchanged with the
// keep-store (which an interpreted evaluation may have changed since), and the
// addresses of the generation's getter for it and, for an int or bool `compile var`,
// its setter (0: none), through which a value the evaluator changed goes back in.
// A delegated global (`delegate`: "val" or "var", the binding's kind) is kept as the
// evaluator keeps it, as its delegate: its getter reads `^name`, of type `any`.
class BootstrapCtGlobal(
    val declaration: int,
    val key: string,
    val type: string,
    var exchanged: string,
    var getter: int,
    var setter: int = 0,
    val delegate: string = ""
)

// A guarded native call's result, or how it stopped: 1 an abort, 2 a failed runtime
// check (trap), 3 the time limit, 4 a bad access (the stack ran past its end), 5 a
// runtime panic (its message is in the generation's panic buffer).
class BootstrapCtCallResult(val value: int, val how: int)

class BootstrapCtOutcome(
    val taken: bool,
    val reason: string,
    val result: BootstrapEvalResult
)

var bootstrapCtTraceValue: int = -1
// The live generation's support entries (0: none) and why it takes no more calls
// ("" while it does): its guard, free, and its SIGALRM (the time limit) and
// SIGSEGV/SIGBUS (a stack run past its end) handlers.
var bootstrapCtFreeAddress: int = 0
var bootstrapCtGuardAddress: int = 0
var bootstrapCtAlarmAddress: int = 0
var bootstrapCtFaultAddress: int = 0
// Where a caught runtime panic leaves its message (0: the slice has no panic catcher).
var bootstrapCtPanicTextAddress: int = 0
var bootstrapCtPanicSizeAddress: int = 0
var bootstrapCtGenerationSpent: string = ""
var bootstrapCtCurrentLive: bool = false
var bootstrapCtCurrent: BootstrapEvaluator = BootstrapEvaluator(
    [], [], bootstrapEvalNoContext(),
    [], [], [], [], [], [], [], [], [], [], [], [], [], 0, 0, 0, "", ""
)
var bootstrapCtSites: array<BootstrapCtSite> = []
// The live generation's functions by runtime id: a native result's closures name
// their function by it.
var bootstrapCtFunctions: BootstrapCtFunctionTable = bootstrapCtNoFunctions()
var bootstrapCtGlobals: array<BootstrapCtGlobal> = []
// Set while the slice itself is lowered: a `compile` node met there is compile
// code being compiled, so its operand is lowered, never evaluated.
var bootstrapCtLoweringSlice: bool = false
// Set while the slice is analyzed: a declaration without a source there is the
// support the compiler generated (bootstrapRuntimeInternalCaller).
var bootstrapCtAnalyzingSlice: bool = false

// "interp" (the default), "jit" or "auto". Until the tier policy lands, auto is jit.
// (Cached as a number: a string first read inside a region would not outlive it.)
var bootstrapCtModeCode: int = -1

fun bootstrapCtMode(): string {
    if (bootstrapCtModeCode < 0) {
        val configured = linuxEnvironment("ABLA_COMPILE_EVAL")
        bootstrapCtModeCode = if (configured.found && configured.value == "jit") 1
            else if (configured.found && configured.value == "auto") 2
            else 0
    }
    if (bootstrapCtModeCode == 1) "jit" else if (bootstrapCtModeCode == 2) "auto" else "interp"
}

// Inside a `region` (the REPL compiles each line in one) every allocation is freed at
// its end, so the tier's state assigned there would point into freed memory:
// compile-time code then stays in the interpreter, which keeps no such state.
fun bootstrapCtRegionActive(): bool = __ablaRuntimePlatformRegionActive()

fun bootstrapCtTrace(): bool {
    if (bootstrapCtTraceValue < 0) {
        val configured = linuxEnvironment("ABLA_COMPILE_EVAL_TRACE")
        bootstrapCtTraceValue =
            if (configured.found && configured.value == "1") 1 else 0
    }
    bootstrapCtTraceValue == 1
}

fun bootstrapCtNote(message: string): void {
    if (bootstrapCtTrace()) linuxPrintStandardError("note[ct-jit]: $message\n")
}

fun bootstrapCtSiteLabel(site: BootstrapCtSite): string =
    "${if (site.sourceIdentity == "") "<root>" else site.sourceIdentity}:${site.node.begin}"

// A caught runtime panic's message ("" when the slice has no panic catcher).
trusted fun bootstrapCtPanicMessage(): string {
    if (bootstrapCtPanicSizeAddress == 0 || bootstrapCtPanicTextAddress == 0) return ""
    val size = ablaUnsafeLoadI64(nativePointerFromAddress(bootstrapCtPanicSizeAddress))
    val text = nativePointerFromAddress(bootstrapCtPanicTextAddress)
    val bytes = byteBuffer()
    var index = 0
    while (index < size) {
        bytes.appendByteValue(ablaUnsafeLoadU8(ablaUnsafePointerOffset(text, index)))
        index = index + 1
    }
    bytes.toText()
}

// A native call that stopped, reported as the interpreter reports the same failure:
// a panic with its code and text (bootstrapEvalRuntimePanic), placed at the site.
fun bootstrapCtReportStop(var evaluator: BootstrapEvaluator, site: BootstrapCtSite, how: int): void {
    val label = bootstrapCtSiteLabel(site)
    if (how == 5 && bootstrapCtPanicMessage() != "") {
        val text = bootstrapCtPanicMessage()
        val code = if (text == "division by zero") "E_EVAL_DIVISION_BY_ZERO"
            else if (bootstrapTextContains(text, "out of bounds") ||
                     bootstrapTextContains(text, "negative size")) "E_EVAL_OUT_OF_BOUNDS"
            else "E_CT_PANIC"
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(code, text)
        if (site.sourceIdentity != "") {
            evaluator.diagnostics =
                "${evaluator.diagnostics}source[eval]:${site.sourceIdentity}:${site.node.begin}:${site.node.end}\n"
        }
    } else if (how == 3) {
        evaluator.recordEvaluatorDiagnostic(
            "E_CT_TIME_LIMIT",
            "compile-time evaluation at $label ran past the time limit (${bootstrapCtTimeLimitSeconds()} s; ABLA_COMPILE_EVAL_TIME_LIMIT)"
        )
        evaluator.errors = evaluator.errors + 1
    } else if (how == 4) {
        evaluator.recordEvaluatorDiagnostic(
            "E_CT_STOPPED",
            "compile-time evaluation at $label stopped: a bad memory access (recursion deeper than the compiler's stack?)"
        )
        evaluator.errors = evaluator.errors + 1
    } else {
        evaluator.recordEvaluatorDiagnostic(
            "E_CT_STOPPED",
            "compile-time evaluation at $label stopped: a runtime check failed or the code aborted"
        )
        evaluator.errors = evaluator.errors + 1
    }
    return
}

trusted fun bootstrapCtReadReply(address: int): string {
    val pointer = nativePointerFromAddress(address)
    val size = ablaUnsafeLoadI64(pointer)
    val bytes = byteBuffer()
    var index = 0
    while (index < size) {
        bytes.appendByteValue(ablaUnsafeLoadU8(ablaUnsafePointerOffset(pointer, 8 + index)))
        index = index + 1
    }
    bytes.toText()
}

fun bootstrapCtNotTaken(reason: string): BootstrapCtOutcome = BootstrapCtOutcome(
    false, reason, BootstrapEvalResult(bootstrapEvalInvalid(), 0, "", [], [], [])
)

// Runs `expression`'s entry when it has one; not taken leaves it to the interpreter.
trusted fun bootstrapCtTryEvaluate(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapCtOutcome {
    var found = -1
    var index = 0
    while (found < 0 && index < bootstrapCtSites.size) {
        if (bootstrapCtSites[index].expression == expression) found = index
        index = index + 1
    }
    if (found < 0) return bootstrapCtNotTaken("not a prepared site")
    val site = bootstrapCtSites[found]
    if (site.reason != "") return bootstrapCtNotTaken(site.reason)
    if (site.entry == 0) return bootstrapCtNotTaken("the site has no entry")
    if (bootstrapCtGenerationSpent != "") return bootstrapCtNotTaken(bootstrapCtGenerationSpent)
    // The generation's compile globals are the keep-store's: an interpreted evaluation
    // that changed one since leaves this generation's copy stale.
    // A changed int or bool `compile var` goes back in through its setter; any other
    // change leaves the generation stale.
    for (global in bootstrapCtGlobals) {
        if (global.getter != 0) {
            val kept = bootstrapCompileGlobalLoad(global.key, declarations, [])
            if (bootstrapCompileGlobalEncode(kept) != global.exchanged &&
                !bootstrapCtPushGlobal(global, kept)) {
                bootstrapCtGenerationSpent =
                    "compile global ${global.key} changed in an interpreted evaluation"
                return bootstrapCtNotTaken(bootstrapCtGenerationSpent)
            }
        }
    }
    // The evaluation's context, as the interpreter builds it: compiler callbacks
    // made during the call act on it, and the result reports from it.
    var evaluator = bootstrapCtEvaluator(declarations, allowedCompileEffects)
    val enclosing = bootstrapCtCurrent
    val enclosingLive = bootstrapCtCurrentLive
    bootstrapCtCurrent = evaluator
    bootstrapCtCurrentLive = true
    // Compiler API calls the entry makes (bridge shims) run on this evaluator.
    val bridge = ctBridgeEnter(evaluator, site.expression.begin, site.expression.end)
    val called = bootstrapCtCall(site.entry)
    evaluator = ctBridgeFrames[ctBridgeTopIndex()].evaluator
    ctBridgeLeave(bridge)
    bootstrapCtCurrent = enclosing
    bootstrapCtCurrentLive = enclosingLive
    val reply = called.value
    var value = bootstrapEvalInvalid()
    var syntax: array<BootstrapExpression> = []
    var memo: BootstrapLiftMemo? = null
    if (called.how != 0) {
        bootstrapCtReportStop(evaluator, site, called.how)
    } else {
        val text = bootstrapCtReadReply(reply)
        ablaUnsafeCallExact_I64_I64(bootstrapCtFreeAddress, reply)
        if (!site.encodes) {
            value = if (site.type == "null") bootstrapEvalNull() else bootstrapEvalVoid()
            bootstrapCtNote("native at ${bootstrapCtSiteLabel(site)}")
        } else {
            val decoded = bootstrapCtLiftDecode(text, site.type, declarations, bootstrapCtFunctions)
            // The entry has run: a reply that cannot be read is an error, not a retry.
            if (!decoded.ok) {
                evaluator.diagnostics = "${evaluator.diagnostics}${decoded.diagnostic}"
                evaluator.errors = evaluator.errors + 1
            } else {
                value = decoded.value
                syntax = decoded.syntax
                memo = decoded.memo
                bootstrapCtNote("native at ${bootstrapCtSiteLabel(site)}")
            }
        }
    }
    if (called.how == 0) bootstrapCtExchangeGlobals(evaluator, site)
    bootstrapCompileGlobalsKeep(
        evaluator.globalKeys, evaluator.globalValues,
        evaluator.syntax, evaluator.declarations
    )
    BootstrapCtOutcome(true, "", BootstrapEvalResult(
        value,
        evaluator.errors,
        evaluator.diagnostics,
        evaluator.compileInputPaths,
        evaluator.compileInputContents,
        evaluator.generatedDeclarations,
        syntax,
        memo
    ))
}

// After a call: the generation's compile globals as they now are, kept like the
// interpreter keeps the globals an evaluation used.
trusted fun bootstrapCtExchangeGlobals(var evaluator: BootstrapEvaluator, site: BootstrapCtSite): void {
    var index = 0
    while (index < bootstrapCtGlobals.size) {
        val global = bootstrapCtGlobals[index]
        // (A global no entry of the generation reaches has no getter.)
        val called = if (global.getter == 0) BootstrapCtCallResult(-1, 0)
            else bootstrapCtCall(global.getter)
        val reply = called.value
        if (called.how != 0 || reply == 0) {
            bootstrapCtGenerationSpent = "compile global ${global.key} could not be read back"
            evaluator.recordEvaluatorDiagnostic(
                "E_CT_JIT_RESULT",
                "compile global ${global.key} could not be read back after ${bootstrapCtSiteLabel(site)}"
            )
            evaluator.errors = evaluator.errors + 1
        } else if (reply > 0) {
            val text = bootstrapCtReadReply(reply)
            ablaUnsafeCallExact_I64_I64(bootstrapCtFreeAddress, reply)
            val decoded = bootstrapCtLiftDecode(
                text, global.type, evaluator.declarations, bootstrapCtFunctions
            )
            if (decoded.ok) {
                val kept = if (global.delegate == "") decoded.value
                    else bootstrapEvalDelegate(decoded.value, global.delegate == "var")
                evaluator.globalKeys.append(global.key)
                evaluator.globalValues.append(kept)
                global.exchanged = bootstrapCompileGlobalEncode(kept)
            }
        }
        index = index + 1
    }
    return
}

// What a setter can store: an int, bool, f64 or string, or an array of those; ""
// for another type.
fun bootstrapCtSetterKind(type: string): string {
    if (type == "int" || type == "i64" || type == "bool" || type == "f64" || type == "string") {
        return if (type == "int") "i64" else type
    }
    if (type.size > 6 && type.slice(0, 6) == "array:") {
        val element = bootstrapCtSetterKind(type.slice(6, type.size))
        if (element != "" && !bootstrapTextContains(element, "array")) return "array:$element"
    }
    ""
}

// Stores `value` into the generation's copy of `global` through its setter, written
// as the setter reads it (bootstrapCtSetterSource): an int, bool or f64 as one word,
// a string as [size][bytes], an array as [count] and its elements so. False when
// the global has no setter or the value doesn't fit its kind.
trusted fun bootstrapCtPushGlobal(var global: BootstrapCtGlobal, value: BootstrapEvalValue): bool {
    if (global.setter == 0) return false
    val kind = bootstrapCtSetterKind(global.type)
    val words: array<int> = []
    val texts: array<string> = []
    var fits = true
    if (kind.size > 6 && kind.slice(0, 6) == "array:") {
        if (value.kind != "array") return false
        val element = kind.slice(6, kind.size)
        for (item in value.elements) {
            if (!bootstrapCtPushPart(element, item, words, texts)) fits = false
        }
    } else fits = bootstrapCtPushPart(kind, value, words, texts)
    if (!fits) return false
    val array = kind.size > 6 && kind.slice(0, 6) == "array:"
    val text = kind == "string" || kind == "array:string"
    // [count] for an array, then each part: a word, or [size][bytes].
    var size = if (array) 8 else 0
    var part = 0
    while (part < words.size) {
        size = size + 8
        if (text) size = size + texts[-1 - words[part]].size
        part = part + 1
    }
    // (Zeroed in words: rounded up to one.)
    val buffer = bootstrapCtZeroed((size + 15) / 8 * 8)
    var at = buffer
    if (array) {
        ablaRuntimeStoreI64(at, words.size)
        at = at + 8
    }
    part = 0
    while (part < words.size) {
        if (!text) {
            ablaRuntimeStoreI64(at, words[part])
            at = at + 8
        } else {
            val bytes = texts[-1 - words[part]]
            ablaRuntimeStoreI64(at, bytes.size)
            var byte = 0
            while (byte < bytes.size) {
                ablaRuntimeStoreU8(at + 8 + byte, bytes[byte])
                byte = byte + 1
            }
            at = at + 8 + bytes.size
        }
        part = part + 1
    }
    val stored = ablaUnsafeCallExact_I64_I64_I64(global.setter, buffer, size)
    __ablaRuntimeFree(buffer)
    global.exchanged = bootstrapCompileGlobalEncode(value)
    bootstrapCtNote("compile global ${global.key} changed in an interpreted evaluation: passed in")
    true
}

// One part of a pushed value: a word for an int, bool or f64, or (for a string) a
// negative index into `texts`.
fun bootstrapCtPushPart(
    kind: string,
    value: BootstrapEvalValue,
    var words: array<int>,
    var texts: array<string>
): bool {
    if ((kind == "i64" && value.kind == "integer") || (kind == "f64" && value.kind == "f64")) {
        words.append(value.integer)
    } else if (kind == "bool" && value.kind == "boolean") {
        words.append(if (value.boolean) 1 else 0)
    } else if (kind == "string" && value.kind == "string") {
        texts.append(value.text)
        words.append(-texts.size)
    } else return false
    true
}

// A fresh evaluation context, exactly as bootstrapEvaluateWithEffectsIn makes one.
fun bootstrapCtEvaluator(
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapEvaluator {
    val context = bootstrapEvalContext(declarations)
    BootstrapEvaluator(
        declarations, context.affineTypes, context,
        [], [], [], [], [], [], [], [], [], [], [], [], [],
        allowedCompileEffects, 0, 0, "", ""
    )
}

// The evaluation a native call is running (compiler callbacks act on it).
fun bootstrapCtCurrentEvaluator(): BootstrapEvaluator = bootstrapCtCurrent

// The interpreter entry points' JIT-first forms (the hooks at the evaluation sites).
fun bootstrapCtEvaluateWithEffects(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    if (bootstrapCtMode() != "interp") {
        val outcome = bootstrapCtTryEvaluate(
            expression, declarations, allowedCompileEffects
        )
        if (outcome.taken) return outcome.result
        bootstrapCtNote("interpreted at ${expression.begin}: ${outcome.reason}")
    }
    bootstrapEvaluateWithEffects(expression, declarations, allowedCompileEffects)
}

// `source`: the file being lowered, which an interpreted evaluation's failures name.
// bootstrapCtEvaluate under the program's own compile-effect grants
// (ct_native.ab): the native tier gets the same mask, and the interpreter
// fallback evaluates with it.
fun bootstrapCtEvaluateGranted(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int,
    source: string = ""
): BootstrapEvalResult {
    if (bootstrapCtMode() != "interp") {
        val outcome = bootstrapCtTryEvaluate(
            expression, declarations, allowedCompileEffects
        )
        if (outcome.taken) return outcome.result
        bootstrapCtNote("interpreted at ${expression.begin}: ${outcome.reason}")
    }
    bootstrapEvaluateWithEffectsIn(
        bootstrapEvalContext(declarations),
        expression,
        declarations,
        allowedCompileEffects,
        source
    )
}

fun bootstrapCtEvaluate(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    source: string = ""
): BootstrapEvalResult {
    if (bootstrapCtMode() != "interp") {
        val outcome = bootstrapCtTryEvaluate(expression, declarations, 1023)
        if (outcome.taken) return outcome.result
        bootstrapCtNote("interpreted at ${expression.begin}: ${outcome.reason}")
    }
    bootstrapEvaluate(expression, declarations, source)
}

// Calls `entry` of the live generation under its guard, the time limit and the stack
// fault handler. A stop spends the generation: frames the jump back skipped never
// popped their collector roots, so nothing more may run on it.
trusted fun bootstrapCtCall(entry: int): BootstrapCtCallResult {
    // The guard writes how the call stopped here (0: it returned).
    val stopped = nativeI64Cell(0)
    val limit = bootstrapCtTimeLimitSeconds()
    val timer = limit > 0 && bootstrapCtAlarmAddress != 0 &&
        bootstrapCtArmAlarm(bootstrapCtAlarmAddress, limit)
    val faults = bootstrapCtFaultAddress != 0 && bootstrapCtArmFaults(bootstrapCtFaultAddress)
    val value = ablaUnsafeCallExact_I64_I64_I64(
        bootstrapCtGuardAddress, entry, nativePointerAddress(stopped.address)
    )
    if (timer) bootstrapCtDisarmAlarm()
    if (faults) bootstrapCtDisarmFaults()
    val how = stopped.load()
    val closed = stopped.close()
    if (how != 0) {
        bootstrapCtGenerationSpent = "an earlier compile-time evaluation of this pass stopped"
    }
    BootstrapCtCallResult(if (how != 0) 0 else value, how)
}

// --- the time limit -------------------------------------------------------------

noescape extern:"c" fun sigaction(signal: i32, action: i64*, previous: i64*): i32
noescape extern:"c" fun setitimer(which: i32, value: i64*, previous: i64*): i32
noescape extern:"c" fun sigaltstack(stack: i64*, previous: i64*): i32

// ABLA_COMPILE_EVAL_TIME_LIMIT: seconds one native evaluation may run (default 600;
// 0: no limit). The interpreter's bound is its step limit; native code has no steps.
var bootstrapCtTimeLimitValue: int = -1
// Set with the session (ct_jit.ab): the signal structs' layouts differ by host.
var bootstrapCtHostIsDarwin: bool = false

fun bootstrapCtTimeLimitSeconds(): int {
    if (bootstrapCtTimeLimitValue < 0) {
        val configured = linuxEnvironment("ABLA_COMPILE_EVAL_TIME_LIMIT")
        bootstrapCtTimeLimitValue = 600
        if (configured.found && configured.value.size > 0 && configured.value.size <= 9) {
            var parsed = 0
            var valid = true
            for (byte in configured.value) {
                if (byte < 48 || byte > 57) valid = false
                else parsed = parsed * 10 + byte - 48
            }
            if (valid) bootstrapCtTimeLimitValue = parsed
        }
    }
    bootstrapCtTimeLimitValue
}

// A zeroed buffer of `size` bytes (a multiple of 8) the caller frees.
trusted fun bootstrapCtZeroed(size: int): int {
    val address = __ablaRuntimeAllocateLayout(size, 10)
    var offset = 0
    while (offset < size) {
        ablaRuntimeStoreI64(address + offset, 0)
        offset = offset + 8
    }
    address
}

// SIGALRM runs `handler` (SA_NODEFER, so the jump back leaves the signal unblocked)
// after `seconds`. struct sigaction: Darwin {handler, mask u32, flags i32}; Linux
// {handler, mask[128], flags i32, restorer}.
trusted fun bootstrapCtArmAlarm(handler: int, seconds: int): bool {
    val action = bootstrapCtZeroed(160)
    ablaRuntimeStoreI64(action, handler)
    if (bootstrapCtHostIsDarwin) ablaRuntimeStoreI64(action + 8, 16 * 4294967296)
    else ablaRuntimeStoreI64(action + 136, 1073741824)
    val installed = sigaction(14, ablaRuntimePointerFromAddress(action), nativeNullPointer()) == 0
    __ablaRuntimeFree(action)
    var armed = false
    if (installed) {
        val timer = bootstrapCtZeroed(32)
        ablaRuntimeStoreI64(timer + 16, seconds)
        armed = setitimer(0, ablaRuntimePointerFromAddress(timer), nativeNullPointer()) == 0
        __ablaRuntimeFree(timer)
    }
    armed
}

trusted fun bootstrapCtDisarmAlarm(): void {
    val timer = bootstrapCtZeroed(32)
    val stopped = setitimer(0, ablaRuntimePointerFromAddress(timer), nativeNullPointer())
    __ablaRuntimeFree(timer)
    // Back to the default action, so no handler of a removed generation stays.
    val action = bootstrapCtZeroed(160)
    val restored = sigaction(14, ablaRuntimePointerFromAddress(action), nativeNullPointer())
    __ablaRuntimeFree(action)
    return
}

// --- a stack run past its end -------------------------------------------------------

// The alternate signal stack the fault handler runs on (a fault from a stack run past
// its end cannot run on that stack), set up once for the process, and the fault
// signals' actions before a call, put back after it.
var bootstrapCtSignalStack: int = 0
var bootstrapCtSavedSegv: int = 0
var bootstrapCtSavedBus: int = 0

fun bootstrapCtBusSignal(): int = if (bootstrapCtHostIsDarwin) 10 else 7

// SIGSEGV and SIGBUS run `handler` on the alternate stack until bootstrapCtDisarmFaults.
// stack_t: Darwin {sp, size, flags i32}; Linux {sp, flags i32, size}. SA_ONSTACK:
// Darwin 0x1, Linux 0x08000000; SA_NODEFER as for the alarm.
trusted fun bootstrapCtArmFaults(handler: int): bool {
    val darwin = bootstrapCtHostIsDarwin
    if (bootstrapCtSignalStack == 0) {
        val size = 262144
        val memory = __ablaRuntimeAllocateLayout(size, 10)
        val stack = bootstrapCtZeroed(32)
        ablaRuntimeStoreI64(stack, memory)
        if (darwin) ablaRuntimeStoreI64(stack + 8, size) else ablaRuntimeStoreI64(stack + 16, size)
        if (sigaltstack(ablaRuntimePointerFromAddress(stack), nativeNullPointer()) == 0) {
            bootstrapCtSignalStack = memory
        }
        __ablaRuntimeFree(stack)
        if (bootstrapCtSignalStack == 0) return false
    }
    if (bootstrapCtSavedSegv == 0) bootstrapCtSavedSegv = bootstrapCtZeroed(160)
    if (bootstrapCtSavedBus == 0) bootstrapCtSavedBus = bootstrapCtZeroed(160)
    val action = bootstrapCtZeroed(160)
    ablaRuntimeStoreI64(action, handler)
    if (darwin) ablaRuntimeStoreI64(action + 8, 17 * 4294967296)
    else ablaRuntimeStoreI64(action + 136, 1073741824 + 134217728)
    val segv = sigaction(11, ablaRuntimePointerFromAddress(action),
        ablaRuntimePointerFromAddress(bootstrapCtSavedSegv)) == 0
    val bus = sigaction(i32(bootstrapCtBusSignal()), ablaRuntimePointerFromAddress(action),
        ablaRuntimePointerFromAddress(bootstrapCtSavedBus)) == 0
    __ablaRuntimeFree(action)
    segv && bus
}

trusted fun bootstrapCtDisarmFaults(): void {
    val segv = sigaction(11, ablaRuntimePointerFromAddress(bootstrapCtSavedSegv), nativeNullPointer())
    val bus = sigaction(i32(bootstrapCtBusSignal()), ablaRuntimePointerFromAddress(bootstrapCtSavedBus),
        nativeNullPointer())
    return
}
