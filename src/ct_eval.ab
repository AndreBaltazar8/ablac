import "ct_global_graph.ab"
// Compile-time evaluation as native code: the calls (ABLA_COMPILE_EVAL=jit|auto).
//
// ct_jit.ab prepares, per compile pass, one generation of native code with an entry
// per compile-time site; this file runs those entries where the interpreter would
// run the site, in the same order, and needs nothing of LLVM to do it: entries,
// the guard and the support functions are addresses resolved when the generation
// was added. A site with no entry runs in the interpreter.
//
// JIT code has a runtime of its own, so no heap pointer crosses: an entry encodes
// its result with the value codec's encoder (ct_lift.ab) as `[length:i64][bytes]`
// in its own memory and returns the address; the compiler copies the bytes, frees
// them there and decodes them with the static type (bootstrapCtLiftDecode), as the
// interpreter's lift would have built the value.

import "eval.ab"
import "ct_lift.ab"
import "abla/unsafe/memory"
import "abla/runtime/memory"
import "abla/bytes"
import "parser.ab"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/sys/linux/io"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native/function-address"
import "ct_native_effects.ab"
import "ct_native.ab"
import "ct_bridge.ab"
import "sema.ab"
import "abla/text"

trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I64_I64(
    address: int,
    argument: int
): int
trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I64_I64_I64(
    address: int,
    first: int,
    second: int
): int

// A place the interpreter would evaluate: `expression` (the operand of a
// `compile` node, or a top-level action), the node itself (actions: the action),
// and, once prepared, the entry's number or why the site stays interpreted.
class BootstrapCtSite(
    val expression: BootstrapExpression,
    val node: BootstrapExpression,
    val sourceIdentity: string,
    val action: bool,
    var type: string,
    var id: int,
    var reason: string,
    // The entry's address in the live generation (0: none).
    var entry: int,
    // Whether its entry encodes a value (false: an action, or a void or null
    // result, which the entry only runs).
    var encodes: bool = false,
    // Under auto: whether the site can run long (ct_jit.ab, bootstrapCtMayRunLong; true until asked); a pass whose
    // ready sites all can't is interpreted without a native generation.
    var long: bool = true,
    // Under auto: why the site gets no trial (ct_jit.ab, bootstrapCtTrials), "" when it may: its walk reaches
    // code that acts outside the compiler (an extern:"c" declaration, a compile-time provider: files, the clock,
    // output…) or a compile global ("unasked" until the walk is asked). A trial's result, kept in `tried`, is the
    // one lowering takes.
    var noTrial: string = "unasked",
    var tried: BootstrapEvalResult? = null,
    // Whether the slice keeps the site's `#` node (in a kept global's initializer or function's body): then the node
    // and the site's entry both call one accessor that runs the site's code once (ct_jit.ab, bootstrapCtOnceSource).
    var once: bool = false
)

val BOOTSTRAP_CT_UNPREPARED = "the program has semantic errors"

// A compile global the live generation holds (`compile val` / `compile var`): its
// declaration, keep-store key, type, the journal text last exchanged with the
// keep-store (which an interpreted evaluation may have changed since), and the
// addresses of the generation's getter for it and, for an int or bool `compile var`,
// its setter (0: none), through which a value the evaluator changed goes back in.
// A delegated global (`delegate`: "val" or "var", the binding's kind) is kept as the
// evaluator keeps it, as its delegate: its getter reads `^name`, of type `any`.
class BootstrapCtGlobal(
    val declaration: int,
    val key: string,
    val type: string,
    var exchanged: string,
    var getter: int,
    var setter: int = 0,
    val delegate: string = ""
)

// A guarded native call's result, or how it stopped: 1 an abort, 2 a failed runtime
// check (trap), 3 the time limit, 4 a bad access (the stack ran past its end), 5 a
// runtime panic (its message is in the generation's panic buffer).
class BootstrapCtCallResult(val value: int, val how: int)

class BootstrapCtOutcome(
    val taken: bool,
    val reason: string,
    val result: BootstrapEvalResult
)

var bootstrapCtTraceValue: int = -1
// The live generation's support entries (0: none) and why it takes no more calls
// ("" while it does): its guard, free, and its SIGALRM (the time limit) and
// SIGSEGV/SIGBUS (a stack run past its end) handlers.
var bootstrapCtFreeAddress: int = 0
var bootstrapCtGuardAddress: int = 0
var bootstrapCtAlarmAddress: int = 0
var bootstrapCtFaultAddress: int = 0
// Whether the live generation can start threads (ct_jit.ab): before a call into one, the compiler's heap is shared.
var bootstrapCtGenerationThreads: bool = false
// Where a caught runtime panic leaves its message (0: the slice has no panic catcher).
var bootstrapCtPanicTextAddress: int = 0
var bootstrapCtPanicSizeAddress: int = 0
// Where the slice leaves the name of the function whose trap or abort stopped a call (ct_jit.ab, bootstrapCtMarkStopSites).
var bootstrapCtStopSiteAddress: int = 0
var bootstrapCtGenerationSpent: string = ""
var bootstrapCtCurrentLive: bool = false
var bootstrapCtCurrent: BootstrapEvaluator = BootstrapEvaluator(
    [], [], bootstrapEvalNoContext(),
    [], [], [], [], [], [], [], [], [], [], [], [], [], 0, 0, 0, "", ""
)
var bootstrapCtSites: array<BootstrapCtSite> = []
// The live generation's functions by runtime id: a native result's closures name
// their function by it.
var bootstrapCtFunctions: BootstrapCtFunctionTable = bootstrapCtNoFunctions()
var bootstrapCtGlobals: array<BootstrapCtGlobal> = []
// Set while the slice itself is lowered: a `compile` node met there is compile
// code being compiled, so its operand is lowered, never evaluated.
var bootstrapCtLoweringSlice: bool = false
// Set while the slice is analyzed: a declaration without a source there is the
// support the compiler generated (bootstrapRuntimeInternalCaller).
var bootstrapCtAnalyzingSlice: bool = false

// The tier compile-time code runs on: "auto" (the default), "interp" or "jit"
// (ABLA_COMPILE_EVAL; "bridge" is the interpreter with its loopback, ct_bridge.ab).
// auto and jit choose per site and before running it: a site the native tier can
// take (bootstrapCtPrepare: its reach, globals and result proven) runs natively, any
// other runs in the interpreter, and ABLA_COMPILE_EVAL_TRACE=1 gives the reason. No
// site runs twice to choose. The action journal (ABLA_ACTION_JOURNAL, eval.ab)
// records interpreted actions only, so with it on and no tier named the tier is
// the interpreter.
// (Cached as a number: a string first read inside a region would not outlive it.)
var bootstrapCtModeCode: int = -1

fun bootstrapCtMode(): string {
    if (bootstrapCtModeCode < 0) {
        val configured = linuxEnvironment("ABLA_COMPILE_EVAL")
        val named = configured.found && configured.value != ""
        val journal = linuxEnvironment("ABLA_ACTION_JOURNAL")
        val journaled = journal.found && journal.value != "" && journal.value != "0"
        bootstrapCtModeCode = if (named && configured.value == "jit") 1
            else if (named && (configured.value == "interp" || configured.value == "bridge")) 0
            else if (!named && journaled) 0
            else 2
    }
    if (bootstrapCtModeCode == 1) "jit" else if (bootstrapCtModeCode == 2) "auto" else "interp"
}

// Inside a `region` (the REPL compiles each line in one) every allocation is freed at
// its end, so the tier's state assigned there would point into freed memory:
// compile-time code then stays in the interpreter, which keeps no such state.
fun bootstrapCtRegionActive(): bool = __ablaRuntimePlatformRegionActive()

fun bootstrapCtTrace(): bool {
    if (bootstrapCtTraceValue < 0) {
        val configured = linuxEnvironment("ABLA_COMPILE_EVAL_TRACE")
        bootstrapCtTraceValue =
            if (configured.found && configured.value == "1") 1 else 0
    }
    bootstrapCtTraceValue == 1
}

fun bootstrapCtNote(message: string): void {
    if (bootstrapCtTrace()) linuxPrintStandardError("note[ct-jit]: $message\n")
}

/** How a native result was typed back: its aggregates and the searches of the program's declarations that took. */
fun bootstrapCtNoteTypedBack(label: string, aggregates: int, searches: int): void {
    if (aggregates > 0) bootstrapCtNote("typed back $aggregates aggregates at $label with $searches declaration searches")
}

fun bootstrapCtSiteLabel(site: BootstrapCtSite): string =
    "${if (site.sourceIdentity == "") "<root>" else site.sourceIdentity}:${site.node.begin}"

// A caught runtime panic's message ("" when the slice has no panic catcher).
trusted fun bootstrapCtPanicMessage(): string {
    if (bootstrapCtPanicSizeAddress == 0 || bootstrapCtPanicTextAddress == 0) return ""
    val size = ablaUnsafeLoadI64(nativePointerFromAddress(bootstrapCtPanicSizeAddress))
    val text = nativePointerFromAddress(bootstrapCtPanicTextAddress)
    val bytes = byteBuffer()
    var index = 0
    while (index < size) {
        bytes.appendByteValue(ablaUnsafeLoadU8(ablaUnsafePointerOffset(text, index)))
        index = index + 1
    }
    bytes.toText()
}

// How a call stopped by a trap (2) or an abort (1) is told, with the function it was in when the slice recorded it:
// " in churn". The slice's names are the backend's, with a module's prefix (__abla_module_<hex>__) left out.
trusted fun bootstrapCtStopWhat(how: int): string {
    val what = if (how == 2) "a runtime check failed" else "the code aborted"
    if (bootstrapCtStopSiteAddress == 0) return what
    val name = ablaUnsafeLoadI64(nativePointerFromAddress(bootstrapCtStopSiteAddress))
    if (name == 0) return what
    val bytes = byteBuffer()
    var index = 0
    while (index < 512) {
        val byte = ablaUnsafeLoadU8(ablaUnsafePointerOffset(nativePointerFromAddress(name), index))
        if (byte == 0) break
        bytes.appendByteValue(byte)
        index = index + 1
    }
    var text = bytes.toText()
    if (text.startsWith("__abla_module_")) {
        var at = 14
        while (at + 1 < text.size && !(text[at] == 95 && text[at + 1] == 95)) at = at + 1
        if (at + 2 < text.size) text = text.slice(at + 2, text.size)
    }
    "$what in `$text`"
}

// A native call that stopped, reported as the interpreter reports the same failure:
// a panic with its code and text (bootstrapEvalRuntimePanic), placed at the site.
fun bootstrapCtReportStop(var evaluator: BootstrapEvaluator, site: BootstrapCtSite,
    how: int): void {
    val label = bootstrapCtSiteLabel(site)
    if (how == 5 && bootstrapCtPanicMessage() != "") {
        var text = bootstrapCtPanicMessage()
        var code = bootstrapCompilePanicCode(text)
        // `exit(code)`, which the slice turns into a panic with the marked
        // message (ct_bridge.ab, ctBridgeExitSource).
        if (text.startsWith(BOOTSTRAP_COMPILE_EXIT_MARK)) {
            code = "E_CT_STOPPED"
            text = text.slice(BOOTSTRAP_COMPILE_EXIT_MARK.size, text.size)
        }
        evaluator.errors = evaluator.errors + 1
        evaluator.recordEvaluatorDiagnostic(code, text)
        if (site.sourceIdentity != "") {
            evaluator.diagnostics =
                "${evaluator.diagnostics}source[eval]:${site.sourceIdentity}:${site.node.begin}:${site.node.end}\n"
        }
    } else if (how == 3) {
        evaluator.recordEvaluatorDiagnostic(
            "E_CT_TIME_LIMIT",
            "compile-time evaluation at $label ran past the time limit (${bootstrapCtTimeLimitSeconds()} s; ABLA_COMPILE_EVAL_TIME_LIMIT)"
        )
        evaluator.errors = evaluator.errors + 1
    } else if (how == 4) {
        evaluator.recordEvaluatorDiagnostic(
            "E_CT_STOPPED",
            "compile-time evaluation at $label stopped: a bad memory access (recursion deeper than the compiler's stack?)"
        )
        evaluator.errors = evaluator.errors + 1
    } else {
        evaluator.recordEvaluatorDiagnostic(
            "E_CT_STOPPED",
            "compile-time evaluation at $label stopped: ${bootstrapCtStopWhat(how)}"
        )
        evaluator.errors = evaluator.errors + 1
    }
    return
}

trusted fun bootstrapCtReadReply(address: int): string {
    val pointer = nativePointerFromAddress(address)
    val size = ablaUnsafeLoadI64(pointer)
    val bytes = byteBuffer()
    var index = 0
    while (index < size) {
        bytes.appendByteValue(ablaUnsafeLoadU8(ablaUnsafePointerOffset(pointer, 8 + index)))
        index = index + 1
    }
    bytes.toText()
}

fun bootstrapCtNotTaken(reason: string): BootstrapCtOutcome = BootstrapCtOutcome(
    false, reason, BootstrapEvalResult(bootstrapEvalInvalid(), 0, "", [], [], [])
)

// Runs `expression`'s entry when it has one; not taken leaves it to the interpreter.
trusted fun bootstrapCtTryEvaluate(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapCtOutcome {
    var found = -1
    var index = 0
    while (found < 0 && index < bootstrapCtSites.size) {
        if (bootstrapCtSites[index].expression == expression) found = index
        index = index + 1
    }
    if (found < 0) return bootstrapCtNotTaken("not a prepared site")
    val site = bootstrapCtSites[found]
    // A trial finished it before the pass's lowering (ct_jit.ab, bootstrapCtTrials): that result, once.
    val tried = site.tried
    if (tried != null) {
        site.tried = null
        bootstrapCtNote("interpreted at ${expression.begin}: ${site.reason}")
        return BootstrapCtOutcome(true, "", tried)
    }
    if (site.reason != "") return bootstrapCtNotTaken(site.reason)
    if (site.entry == 0) return bootstrapCtNotTaken("the site has no entry")
    if (bootstrapCtGenerationSpent != "") return bootstrapCtNotTaken(bootstrapCtGenerationSpent)
    if (bootstrapCtFunctions.epoch != bootstrapCompileDeclarationEpoch) {
        bootstrapCtGenerationSpent =
            "the native generation predates a compile-time declaration change"
        return bootstrapCtNotTaken(bootstrapCtGenerationSpent)
    }
    // The generation's compile globals are the keep-store's: an interpreted evaluation
    // that changed one since leaves this generation's copy stale.
    // A changed int or bool `compile var` goes back in through its setter; any other
    // change leaves the generation stale.
    // (Globals still pending were neither read nor written since: either would have fetched them first.)
    for (global in bootstrapCtGlobals) {
        if (!bootstrapCtPendingLive() && global.getter != 0) {
            val kept = bootstrapCompileGlobalLoad(global.key, declarations, [])
            if (bootstrapCompileGlobalEncode(kept) != global.exchanged &&
                !bootstrapCtPushGlobal(global, kept)) {
                bootstrapCtGenerationSpent =
                    "compile global ${global.key} changed in an interpreted evaluation"
                return bootstrapCtNotTaken(bootstrapCtGenerationSpent)
            }
        }
    }
    // The evaluation's context, as the interpreter builds it: compiler callbacks
    // made during the call act on it, and the result reports from it.
    var evaluator = bootstrapCtEvaluator(declarations, allowedCompileEffects)
    val enclosing = bootstrapCtCurrent
    val enclosingLive = bootstrapCtCurrentLive
    bootstrapCtCurrent = evaluator
    bootstrapCtCurrentLive = true
    // Compiler API calls the entry makes (bridge shims) run on this evaluator.
    val bridge = ctBridgeEnter(evaluator, site.expression.begin, site.expression.end)
    val called = bootstrapCtCall(site.entry, bootstrapCtSiteLabel(site))
    evaluator = ctBridgeFrames[ctBridgeTopIndex()].evaluator
    ctBridgeLeave(bridge)
    bootstrapCtCurrent = enclosing
    bootstrapCtCurrentLive = enclosingLive
    val reply = called.value
    var value = bootstrapEvalInvalid()
    var syntax: array<BootstrapExpression> = []
    var memo: BootstrapLiftMemo? = null
    if (called.how != 0) {
        bootstrapCtReportStop(evaluator, site, called.how)
    } else {
        val text = bootstrapCtReadReply(reply)
        ablaUnsafeCallExact_I64_I64(bootstrapCtFreeAddress, reply)
        if (!site.encodes) {
            value = if (site.type == "null") bootstrapEvalNull() else bootstrapEvalVoid()
            bootstrapCtNote("native at ${bootstrapCtSiteLabel(site)}")
        } else {
            val decoded = bootstrapCtLiftDecode(text, site.type, declarations, bootstrapCtFunctions)
            // The entry has run: a reply that cannot be read is an error, not a retry.
            if (!decoded.ok) {
                evaluator.diagnostics = "${evaluator.diagnostics}${decoded.diagnostic}"
                evaluator.errors = evaluator.errors + 1
            } else {
                value = decoded.value
                syntax = decoded.syntax
                memo = decoded.memo
                bootstrapCtNote("native at ${bootstrapCtSiteLabel(site)}")
                bootstrapCtNoteTypedBack(bootstrapCtSiteLabel(site), decoded.memo.raw.size, decoded.searches)
            }
        }
    }
    // (Kept first: the journal write would fetch what the call just left pending.)
    bootstrapKeepEvaluatorGlobals(evaluator)
    if (called.how == 0) bootstrapCtLeavePending(declarations, site)
    BootstrapCtOutcome(true, "", BootstrapEvalResult(
        value,
        evaluator.errors,
        evaluator.diagnostics,
        evaluator.compileInputPaths,
        evaluator.compileInputContents,
        evaluator.generatedDeclarations,
        syntax,
        memo
    ))
}

// The generation's compile globals as a native call left them, which the interpreter's journal hasn't fetched yet
// (bootstrapCtFetchPending): the site they were left after, and the declarations to type them back with ("": none
// pending). The journal is only read at compile time (a run-time program starts from its globals' initializers), so
// what no later evaluation reads is never encoded: the game client's offscreen run at compile time left the engine's
// loaded models in `models`, gigabytes the build read back after its last site and never used (#1022).
var bootstrapCtPendingSite: string = ""
var bootstrapCtPendingDeclarations: array<BootstrapDeclaration> = []
// Their keys: the journal fetches them when it reads or writes one.
var bootstrapCtPendingKeys: array<string> = []
// Why the pending globals can no longer be fetched ("" while they can): a later call of the generation stopped, or
// the compilation ended (its generation went); a later read of one is then an error, not a stale value.
var bootstrapCtPendingLost: string = ""
// The `exchanged` text of a global whose pending value was dropped (a journal reset or rollback): no encoding is
// this, so the next native site finds the journal's value changed and pushes it in, or leaves the generation.
val BOOTSTRAP_CT_DROPPED = "!dropped"

// After a call that returned: its compile globals are left pending, fetched when the journal is next read or written.
fun bootstrapCtLeavePending(declarations: array<BootstrapDeclaration>, site: BootstrapCtSite): void {
    val keys: array<string> = []
    for (global in bootstrapCtGlobals) {
        // (A global no entry of the generation reaches has no getter.)
        if (global.getter != 0) keys.append(global.key)
    }
    if (keys.size == 0) return
    bootstrapCtPendingSite = bootstrapCtSiteLabel(site)
    bootstrapCtPendingDeclarations = declarations
    bootstrapCtPendingKeys = keys
    bootstrapCtPendingLost = ""
    return
}

// Whether globals are pending that the journal can still fetch (the site-start check skips them).
fun bootstrapCtPendingLive(): bool = bootstrapCtPendingSite != "" && bootstrapCtPendingLost == ""

// The pending globals are forgotten without fetching them: the journal they would go to was reset or rolled back.
fun bootstrapCtDropPending(): void {
    if (bootstrapCtPendingSite == "") return
    bootstrapCtPendingSite = ""
    bootstrapCtPendingDeclarations = []
    bootstrapCtPendingKeys = []
    bootstrapCtPendingLost = ""
    for (global in bootstrapCtGlobals) {
        if (global.getter != 0) global.exchanged = BOOTSTRAP_CT_DROPPED
    }
    return
}

// bootstrapCtFetchPending when the journal reads or writes one of `keys` that is pending: other keys' values are the
// interpreter's own, which no native value can share. (The build's other evaluations, constant initializers among
// them, read and keep globals of their own.)
trusted fun bootstrapCtFetchPendingFor(keys: array<string>): string {
    if (bootstrapCtPendingSite == "") return ""
    for (pending in bootstrapCtPendingKeys) {
        for (key in keys) {
            if (key == pending) return bootstrapCtFetchPending("the journal's use of $key")
        }
    }
    ""
}

// A compilation or one of its rounds is over and its generation goes (ct_jit.ab, bootstrapCtFinishPass). `another`:
// a round or pass of the same compilation follows, which reads the journal, so what is pending is fetched now; else
// it is lost (a later read of it is an error). "" or the problem.
trusted fun bootstrapCtRetirePending(another: bool): string {
    if (!bootstrapCtPendingLive()) return ""
    if (another) return bootstrapCtFetchPending("the next pass")
    bootstrapCtPendingLost = "the compilation that left them ended first"
    ""
}

// The pending globals go to the journal, all in one keep as after each call before, so values they share stay
// shared: read through their getters and typed back. "" or the problem (the journal is then not written).
trusted fun bootstrapCtFetchPending(cause: string): string {
    if (bootstrapCtPendingSite == "") return ""
    val site = bootstrapCtPendingSite
    val declarations = bootstrapCtPendingDeclarations
    bootstrapCtPendingSite = ""
    bootstrapCtPendingDeclarations = []
    bootstrapCtPendingKeys = []
    if (bootstrapCtGuardAddress == 0 && bootstrapCtPendingLost == "")
        bootstrapCtPendingLost = "the generation was retired first"
    if (bootstrapCtPendingLost != "") {
        bootstrapCtGenerationSpent = "compile globals could not be read back"
        return "compile globals could not be read back after $site: $bootstrapCtPendingLost"
    }
    val keys: array<string> = []
    val values: array<BootstrapEvalValue> = []
    var index = 0
    while (index < bootstrapCtGlobals.size) {
        val global = bootstrapCtGlobals[index]
        val called = if (global.getter == 0) BootstrapCtCallResult(-1, 0)
            else bootstrapCtCall(global.getter)
        val reply = called.value
        if (called.how != 0 || reply == 0) {
            bootstrapCtGenerationSpent = "compile global ${global.key} could not be read back"
            return "compile global ${global.key} could not be read back after $site: ${bootstrapCtReadBackWhy(called.how)}"
        } else if (reply > 0) {
            val text = bootstrapCtReadReply(reply)
            ablaUnsafeCallExact_I64_I64(bootstrapCtFreeAddress, reply)
            val decoded = bootstrapCtLiftDecode(text, global.type, declarations, bootstrapCtFunctions)
            if (decoded.ok) {
                val kept = if (global.delegate == "") decoded.value
                    else bootstrapEvalDelegate(decoded.value, global.delegate == "var")
                keys.append(global.key)
                values.append(kept)
                global.exchanged = bootstrapCompileGlobalEncode(kept)
            }
        }
        index = index + 1
    }
    bootstrapCtNote("read back ${keys.size} compile globals left after $site, for $cause")
    if (!bootstrapCompileGlobalsKeep(keys, values, [], declarations))
        return "compile globals left after $site could not be kept"
    ""
}

// Why a global's getter gave no value: how its call stopped (bootstrapCtCall's codes, told as a site's stop is), or
// that it returned none. A getter encodes the whole value at once, so a large one can stop at the memory limit.
trusted fun bootstrapCtReadBackWhy(how: int): string {
    if (how == 0) return "its getter returned no value"
    if (how == 5 && bootstrapCtPanicMessage() != "") return "its getter panicked: ${bootstrapCtPanicMessage()}"
    if (how == 3) return "its getter ran past the time limit (${bootstrapCtTimeLimitSeconds()} s; ABLA_COMPILE_EVAL_TIME_LIMIT)"
    if (how == 4) return "its getter made a bad memory access (a value deeper than the compiler's stack?)"
    "its getter stopped: ${bootstrapCtStopWhat(how)}"
}

// What a setter can store: an int, bool, f64 or string, or an array of those; ""
// for another type.
fun bootstrapCtSetterKind(type: string): string {
    if (type == "int" || type == "i64" || type == "bool" || type == "f64" || type == "string") {
        return if (type == "int") "i64" else type
    }
    if (type.size > 6 && type.slice(0, 6) == "array:") {
        val element = bootstrapCtSetterKind(type.slice(6, type.size))
        if (element != "" && !bootstrapTextContains(element, "array")) return "array:$element"
    }
    ""
}

// Stores `value` into the generation's copy of `global` through its setter, written
// as the setter reads it (bootstrapCtSetterSource): an int, bool or f64 as one word,
// a string as [size][bytes], an array as [count] and its elements so. False when
// the global has no setter or the value doesn't fit its kind.
trusted fun bootstrapCtPushGlobal(var global: BootstrapCtGlobal, value: BootstrapEvalValue): bool {
    if (global.setter == 0) return false
    val kind = bootstrapCtSetterKind(global.type)
    val words: array<int> = []
    val texts: array<string> = []
    var fits = true
    if (kind.size > 6 && kind.slice(0, 6) == "array:") {
        if (value.kind != "array") return false
        val element = kind.slice(6, kind.size)
        for (item in value.elements) {
            if (!bootstrapCtPushPart(element, item, words, texts)) fits = false
        }
    } else fits = bootstrapCtPushPart(kind, value, words, texts)
    if (!fits) return false
    val array = kind.size > 6 && kind.slice(0, 6) == "array:"
    val text = kind == "string" || kind == "array:string"
    // [count] for an array, then each part: a word, or [size][bytes].
    var size = if (array) 8 else 0
    var part = 0
    while (part < words.size) {
        size = size + 8
        if (text) size = size + texts[-1 - words[part]].size
        part = part + 1
    }
    // (Zeroed in words: rounded up to one.)
    val buffer = bootstrapCtZeroed((size + 15) / 8 * 8)
    var at = buffer
    if (array) {
        ablaRuntimeStoreI64(at, words.size)
        at = at + 8
    }
    part = 0
    while (part < words.size) {
        if (!text) {
            ablaRuntimeStoreI64(at, words[part])
            at = at + 8
        } else {
            val bytes = texts[-1 - words[part]]
            ablaRuntimeStoreI64(at, bytes.size)
            var byte = 0
            while (byte < bytes.size) {
                ablaRuntimeStoreU8(at + 8 + byte, bytes[byte])
                byte = byte + 1
            }
            at = at + 8 + bytes.size
        }
        part = part + 1
    }
    val stored = ablaUnsafeCallExact_I64_I64_I64(global.setter, buffer, size)
    __ablaRuntimeFree(buffer)
    global.exchanged = bootstrapCompileGlobalEncode(value)
    bootstrapCtNote("compile global ${global.key} changed in an interpreted evaluation: passed in")
    true
}

// One part of a pushed value: a word for an int, bool or f64, or (for a string) a
// negative index into `texts`.
fun bootstrapCtPushPart(
    kind: string,
    value: BootstrapEvalValue,
    var words: array<int>,
    var texts: array<string>
): bool {
    if ((kind == "i64" && value.kind == "integer") || (kind == "f64" && value.kind == "f64")) {
        words.append(value.integer)
    } else if (kind == "bool" && value.kind == "boolean") {
        words.append(if (value.boolean) 1 else 0)
    } else if (kind == "string" && value.kind == "string") {
        texts.append(value.text)
        words.append(-texts.size)
    } else return false
    true
}

// A fresh evaluation context, exactly as bootstrapEvaluateWithEffectsIn makes one.
fun bootstrapCtEvaluator(
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapEvaluator {
    val context = bootstrapEvalContext(declarations)
    BootstrapEvaluator(
        declarations, context.affineTypes, context,
        [], [], [], [], [], [], [], [], [], [], [], [], [],
        allowedCompileEffects, 0, 0, "", ""
    )
}

// The evaluation a native call is running (compiler callbacks act on it).
fun bootstrapCtCurrentEvaluator(): BootstrapEvaluator = bootstrapCtCurrent

// The interpreter entry points' JIT-first forms (the hooks at the evaluation sites).
fun bootstrapCtEvaluateWithEffects(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    if (bootstrapCtMode() != "interp") {
        val outcome = bootstrapCtTryEvaluate(
            expression, declarations, allowedCompileEffects
        )
        if (outcome.taken) return outcome.result
        bootstrapCtNote("interpreted at ${expression.begin}: ${outcome.reason}")
    }
    val timed = bootstrapCtInterpretBegin()
    val result = bootstrapEvaluateWithEffects(expression, declarations, allowedCompileEffects)
    bootstrapCtInterpretEnd(timed)
    result
}

// `source`: the file being lowered, which an interpreted evaluation's failures name.
// bootstrapCtEvaluate under the program's own compile-effect grants
// (ct_native.ab): the native tier gets the same mask, and the interpreter
// fallback evaluates with it.
fun bootstrapCtEvaluateGranted(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int,
    source: string = "",
    // The site's value key (eval.ab, bootstrapCompileSiteKey): the interpreter keeps its value with the globals it read.
    siteKey: string = ""
): BootstrapEvalResult {
    if (bootstrapCtMode() != "interp") {
        val outcome = bootstrapCtTryEvaluate(
            expression, declarations, allowedCompileEffects
        )
        if (outcome.taken) return outcome.result
        bootstrapCtNote("interpreted at ${expression.begin}: ${outcome.reason}")
    }
    val timed = bootstrapCtInterpretBegin()
    bootstrapCompileSiteEvaluating = siteKey
    val result = bootstrapEvaluateWithEffectsIn(
        bootstrapEvalContext(declarations),
        expression,
        declarations,
        allowedCompileEffects,
        source
    )
    bootstrapCtInterpretEnd(timed)
    result
}

fun bootstrapCtEvaluate(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    source: string = ""
): BootstrapEvalResult {
    if (bootstrapCtMode() != "interp") {
        val outcome = bootstrapCtTryEvaluate(expression, declarations, 1023)
        if (outcome.taken) return outcome.result
        bootstrapCtNote("interpreted at ${expression.begin}: ${outcome.reason}")
    }
    val timed = bootstrapCtInterpretBegin()
    val result = bootstrapEvaluate(expression, declarations, source)
    bootstrapCtInterpretEnd(timed)
    result
}

// An interpreted site runs under the same time limit as a native call (ct_native.ab, ctNativeDeadline); nested
// sites share the outermost one's. Begin returns whether this site set it, for End.
fun bootstrapCtInterpretBegin(): bool {
    val limit = bootstrapCtTimeLimitSeconds()
    if (limit <= 0 || ctNativeDeadline != 0) return false
    ctNativeDeadline = linuxMonotonicMilliseconds() + limit * 1000
    ctNativeDeadlineSeconds = limit
    ctNativeTimedOut = false
    bootstrapCtArmInterpreterAlarm(limit)
    true
}

fun bootstrapCtInterpretEnd(timed: bool): void {
    if (!timed) return
    bootstrapCtDisarmAlarm()
    ctNativeDeadline = 0
    ctNativeTimedOut = false
    return
}

// A handler that only returns, so that SIGALRM interrupts a blocked system call (EINTR) and nothing else. The
// bytes are `ret` on x86-64 and `add x3, x6, #0; ret` on AArch64 (x3 is a scratch register): one body for every
// compiler host, as bootstrapCtSigreturn is written in bytes.
@naked
trusted fun bootstrapCtAlarmReturn(): void =
    bootstrapCtSigreturnAssembly(".byte 0xc3, 0x00, 0x00, 0x91, 0xc0, 0x03, 0x5f, 0xd6", "")

// SIGALRM for an interpreted site: first after `seconds`, then every second (ITIMER_REAL's interval), without
// SA_RESTART so a blocked call returns EINTR; the evaluator then sees the deadline passed.
trusted fun bootstrapCtArmInterpreterAlarm(seconds: int): bool {
    val handler = nativeFunctionAddress(bootstrapCtAlarmReturn)
    // (ablaHostIsMacOS, not bootstrapCtHostIsDarwin: that is set only once a native session exists.)
    val action = if (ablaHostIsMacOS()) bootstrapCtZeroed(160) else bootstrapCtKernelAction(handler, 0)
    if (ablaHostIsMacOS()) ablaRuntimeStoreI64(action, handler)
    val installed = bootstrapCtSigaction(14, action, 0)
    __ablaRuntimeFree(action)
    var armed = false
    if (installed) {
        val timer = bootstrapCtZeroed(32)
        ablaRuntimeStoreI64(timer, 1)
        ablaRuntimeStoreI64(timer + 16, seconds)
        armed = bootstrapCtSetTimer(timer)
        __ablaRuntimeFree(timer)
    }
    armed
}

// Calls `entry` of the live generation under its guard, the time limit and the stack
// fault handler. A stop spends the generation: frames the jump back skipped never
// popped their collector roots, so nothing more may run on it.
trusted fun bootstrapCtCall(entry: int, label: string = ""): BootstrapCtCallResult {
    // The process's threads before the call (Linux and macOS; -1 elsewhere), to tell whether a stop leaves any the
    // call started still running.
    val threadsBefore = bootstrapCtThreadCount()
    // A generation that can start threads: their thread-locals are emulated by the compiler's own
    // `__emutls_get_address` (src/emutls_export.ab), which takes each thread's table and copies from the compiler's
    // heap. That heap's lock must be live before the first of them exists, as `ablac run` makes it before a program's
    // main (abla/llvm/orc, llvmOrcCallMain): without it two threads starting together allocated from the heap at once,
    // and could be given overlapping blocks for their root-frame cells. The build then stopped at random under load
    // ("a runtime check failed" in the root-frame unlink, or a bad access; thread-heap-mutex in the parity sample).
    // Once on, the lock stays on (as a program's does after its first thread).
    if (bootstrapCtGenerationThreads) runtimeMemoryEnableSharing()
    // The guard writes how the call stopped here (0: it returned).
    val stopped = nativeI64Cell(0)
    val limit = bootstrapCtTimeLimitSeconds()
    val timer = limit > 0 && bootstrapCtAlarmAddress != 0 &&
        bootstrapCtArmAlarm(bootstrapCtAlarmAddress, limit)
    val faults = bootstrapCtFaultAddress != 0 && bootstrapCtArmFaults(bootstrapCtFaultAddress)
    val value = ablaUnsafeCallExact_I64_I64_I64(
        bootstrapCtGuardAddress, entry, nativePointerAddress(stopped.address)
    )
    if (timer) bootstrapCtDisarmAlarm()
    // A native call inside an interpreted site: the site's own alarm again, for what is left of its time.
    if (timer && ctNativeDeadline != 0) {
        val left = (ctNativeDeadline - linuxMonotonicMilliseconds() + 999) / 1000
        bootstrapCtArmInterpreterAlarm(if (left > 0) left else 1)
    }
    if (faults) bootstrapCtDisarmFaults()
    val how = stopped.load()
    val closed = stopped.close()
    if (how != 0) {
        // (Its globals left pending by an earlier call can't be read from a spent generation. The stop is an error
        // of its own, so the build fails whether or not a later evaluation would have read them.)
        if (bootstrapCtPendingLive()) bootstrapCtPendingLost = "a later call of the generation stopped"
        bootstrapCtGenerationSpent = "an earlier compile-time evaluation of this pass stopped"
        if (threadsBefore > 0) bootstrapCtStopBesideThreads(threadsBefore, how, label)
    }
    BootstrapCtCallResult(if (how != 0) 0 else value, how)
}

// The number of threads the process has, or -1 where it cannot be read: the Threads: line of /proc/self/status on
// Linux; on macOS proc_info (system call 336, PROC_INFO_CALL_PIDINFO 2, PROC_PIDTASKINFO 4), whose 96-byte struct
// proc_taskinfo has pti_threadnum at 84, the high half of the little-endian word at 80. A raw system call keeps it
// out of the compiler's libSystem imports. It returned -1 there before, so a stop beside a running thread let the
// compiler go on beside it and crash (#831 on macOS: "Segmentation fault: 11").
trusted fun bootstrapCtThreadCount(): int {
    if (ablaHostIsMacOS()) {
        val info = nativeByteBuffer(96)
        val size = ablaDarwinSyscall(336, 2, linuxProcessId(), 4, 0, nativePointerAddress(info.address), 96)
        val count = if (size == 96) (info.loadI64(80) >> 32) & 4294967295 else -1
        info.close()
        return if (count > 0) count else -1
    }
    val status = linuxOpen("/proc/self/status", 524288)
    if (status.descriptor < 0) return -1
    val text = status.read(8192)
    status.close()
    val key = "\nThreads:"
    var at = 0
    while (at + key.size <= text.size && text.slice(at, at + key.size) != key) at = at + 1
    if (at + key.size > text.size) return -1
    var index = at + key.size
    while (index < text.size && (text[index] == 9 || text[index] == 32)) index = index + 1
    var count = 0
    var digits = 0
    while (index < text.size && text[index] >= 48 && text[index] <= 57) {
        count = count * 10 + text[index] - 48
        index = index + 1
        digits = digits + 1
    }
    if (digits == 0) -1 else count
}

// A native call stopped (a panic, an abort, the time limit, a bad access) while threads it started may still
// run its code: the jump back left them running beside the compiler, which then crashed at random (#831: its
// collector roots and heap, used from both sides). Give a thread that is just ending a moment; if any is still
// there, the build ends here with the stop's reason, before the compiler goes on.
trusted fun bootstrapCtStopBesideThreads(threadsBefore: int, how: int, label: string): void {
    var waited = 0
    var running = bootstrapCtThreadCount() - threadsBefore
    while (running > 0 && waited < 500) {
        linuxSleep(10)
        waited = waited + 10
        running = bootstrapCtThreadCount() - threadsBefore
    }
    if (running <= 0) return
    val reason = if (how == 5 && bootstrapCtPanicMessage() != "") "panicked: ${bootstrapCtPanicMessage()}"
        else if (how == 3) "ran past the time limit"
        else if (how == 4) "made a bad memory access"
        else "stopped: ${bootstrapCtStopWhat(how)}"
    val site = if (label == "") "" else " at $label"
    linuxWriteStandardError(
        "error[E_CT_STOPPED]: compile-time evaluation$site $reason, while $running thread(s) it started still " +
        "run; the compiler can't go on beside them, so the build stops here (await every thread before code " +
        "that can stop, or evaluate the site with ABLA_COMPILE_EVAL=interp)\n"
    )
    linuxSyscall1(231, 1)
    return
}

// --- the time limit -------------------------------------------------------------

noescape extern:"c" fun sigaction(signal: i32, action: i64*, previous: i64*): i32
noescape extern:"c" fun setitimer(which: i32, value: i64*, previous: i64*): i32
private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool
private noescape extern:"intrinsic" fun ablaDarwinSyscall(
    number: int,
    argument0: int,
    argument1: int,
    argument2: int,
    argument3: int,
    argument4: int,
    argument5: int
): int

// The compiler hosts are x86-64 Linux and macOS. x86-64 Linux arms the timer with
// the system call (38), so the compiler needs no libc setitimer there (#806); macOS keeps libSystem's.
trusted fun bootstrapCtSetTimer(value: int): bool =
    if (ablaHostIsMacOS()) setitimer(0, ablaRuntimePointerFromAddress(value),
        nativeNullPointer()) == 0
    else linuxSyscall3(38, 0, value, 0) == 0
noescape extern:"c" fun sigaltstack(stack: i64*, previous: i64*): i32

// x86-64 Linux talks to the kernel (#806): rt_sigaction (13) with the kernel's struct
// {handler, flags, restorer, mask} and sigaltstack (131), so the compiler needs no
// libc sigaction/sigaltstack there; macOS keeps libSystem's.
trusted noescape extern:"inline-assembly" fun bootstrapCtSigreturnAssembly(
    template: string,
    constraints: string
): void

// The trampoline a returning handler goes through (SA_RESTORER): rt_sigreturn.
// The x86-64 Linux rt_sigreturn trampoline, `movq $15, %rax; syscall` (48 c7 c0 0f 00 00 00 0f 05),
// written as bytes because this module is compiled for every host, and the bootstrap compiler
// must assemble the same source on arm64 macOS: mnemonics there are assembler errors. Off
// x86-64 Linux the bytes are never executed: bootstrapCtSigaction takes libSystem's sigaction
// on macOS, so nothing there installs this address as a signal restorer.
@naked
trusted fun bootstrapCtSigreturn(): void =
    bootstrapCtSigreturnAssembly(".byte 0x48, 0xc7, 0xc0, 0x0f, 0x00, 0x00, 0x00, 0x0f, 0x05", "")

// The kernel's struct sigaction (a zeroed 160-byte buffer) for `handler` and `flags`
// (SA_RESTORER added); the handler returns through bootstrapCtSigreturn.
trusted fun bootstrapCtKernelAction(handler: int, flags: int): int {
    val action = bootstrapCtZeroed(160)
    ablaRuntimeStoreI64(action, handler)
    ablaRuntimeStoreI64(action + 8, flags + 67108864)
    ablaRuntimeStoreI64(action + 16, nativeFunctionAddress(bootstrapCtSigreturn))
    action
}

trusted fun bootstrapCtSigaction(signal: int, action: int, previous: int): bool =
    if (ablaHostIsMacOS()) sigaction(i32(signal), ablaRuntimePointerFromAddress(action),
        ablaRuntimePointerFromAddress(previous)) == 0
    else linuxSyscall4(13, signal, action, previous, 8) == 0

trusted fun bootstrapCtSigaltstack(stack: int): bool =
    if (ablaHostIsMacOS()) sigaltstack(ablaRuntimePointerFromAddress(stack),
        nativeNullPointer()) == 0
    else linuxSyscall2(131, stack, 0) == 0

// ABLA_COMPILE_EVAL_TIME_LIMIT: seconds one native evaluation may run (default 600;
// 0: no limit). The interpreter's bound is its step limit; native code has no steps.
var bootstrapCtTimeLimitValue: int = -1
// Set with the session (ct_jit.ab): the signal structs' layouts differ by host.
var bootstrapCtHostIsDarwin: bool = false

fun bootstrapCtTimeLimitSeconds(): int {
    if (bootstrapCtTimeLimitValue < 0) {
        val configured = linuxEnvironment("ABLA_COMPILE_EVAL_TIME_LIMIT")
        bootstrapCtTimeLimitValue = 600
        if (configured.found && configured.value.size > 0 && configured.value.size <= 9) {
            var parsed = 0
            var valid = true
            for (byte in configured.value) {
                if (byte < 48 || byte > 57) valid = false
                else parsed = parsed * 10 + byte - 48
            }
            if (valid) bootstrapCtTimeLimitValue = parsed
        }
    }
    bootstrapCtTimeLimitValue
}

// A zeroed buffer of `size` bytes (a multiple of 8) the caller frees.
trusted fun bootstrapCtZeroed(size: int): int {
    val address = __ablaRuntimeAllocateLayout(size, 10)
    var offset = 0
    while (offset < size) {
        ablaRuntimeStoreI64(address + offset, 0)
        offset = offset + 8
    }
    address
}

// SIGALRM runs `handler` (SA_NODEFER, so the jump back leaves the signal unblocked)
// after `seconds`. struct sigaction: Darwin {handler, mask u32, flags i32}; Linux
// {handler, mask[128], flags i32, restorer}.
trusted fun bootstrapCtArmAlarm(handler: int, seconds: int): bool {
    var action = 0
    if (bootstrapCtHostIsDarwin) {
        action = bootstrapCtZeroed(160)
        ablaRuntimeStoreI64(action, handler)
        ablaRuntimeStoreI64(action + 8, 16 * 4294967296)
    } else action = bootstrapCtKernelAction(handler, 1073741824)
    val installed = bootstrapCtSigaction(14, action, 0)
    __ablaRuntimeFree(action)
    var armed = false
    if (installed) {
        val timer = bootstrapCtZeroed(32)
        ablaRuntimeStoreI64(timer + 16, seconds)
        armed = bootstrapCtSetTimer(timer)
        __ablaRuntimeFree(timer)
    }
    armed
}

trusted fun bootstrapCtDisarmAlarm(): void {
    val timer = bootstrapCtZeroed(32)
    val stopped = bootstrapCtSetTimer(timer)
    __ablaRuntimeFree(timer)
    // Back to the default action, so no handler of a removed generation stays.
    val action = bootstrapCtZeroed(160)
    val restored = bootstrapCtSigaction(14, action, 0)
    __ablaRuntimeFree(action)
    return
}

// --- a stack run past its end -------------------------------------------------------

// The alternate signal stack the fault handler runs on (a fault from a stack run past
// its end cannot run on that stack), set up once for the process, and the fault
// signals' actions before a call, put back after it.
var bootstrapCtSignalStack: int = 0
var bootstrapCtSavedSegv: int = 0
var bootstrapCtSavedBus: int = 0

fun bootstrapCtBusSignal(): int = if (bootstrapCtHostIsDarwin) 10 else 7

// SIGSEGV and SIGBUS run `handler` on the alternate stack until bootstrapCtDisarmFaults.
// stack_t: Darwin {sp, size, flags i32}; Linux {sp, flags i32, size}. SA_ONSTACK:
// Darwin 0x1, Linux 0x08000000; SA_NODEFER as for the alarm.
trusted fun bootstrapCtArmFaults(handler: int): bool {
    val darwin = bootstrapCtHostIsDarwin
    if (bootstrapCtSignalStack == 0) {
        val size = 262144
        val memory = __ablaRuntimeAllocateLayout(size, 10)
        val stack = bootstrapCtZeroed(32)
        ablaRuntimeStoreI64(stack, memory)
        if (darwin) ablaRuntimeStoreI64(stack + 8, size) else ablaRuntimeStoreI64(stack + 16, size)
        if (bootstrapCtSigaltstack(stack)) {
            bootstrapCtSignalStack = memory
        }
        __ablaRuntimeFree(stack)
        if (bootstrapCtSignalStack == 0) return false
    }
    if (bootstrapCtSavedSegv == 0) bootstrapCtSavedSegv = bootstrapCtZeroed(160)
    if (bootstrapCtSavedBus == 0) bootstrapCtSavedBus = bootstrapCtZeroed(160)
    var action = 0
    if (darwin) {
        action = bootstrapCtZeroed(160)
        ablaRuntimeStoreI64(action, handler)
        ablaRuntimeStoreI64(action + 8, 17 * 4294967296)
    } else action = bootstrapCtKernelAction(handler, 1073741824 + 134217728)
    val segv = bootstrapCtSigaction(11, action, bootstrapCtSavedSegv)
    val bus = bootstrapCtSigaction(bootstrapCtBusSignal(), action, bootstrapCtSavedBus)
    __ablaRuntimeFree(action)
    segv && bus
}

trusted fun bootstrapCtDisarmFaults(): void {
    val segv = bootstrapCtSigaction(11, bootstrapCtSavedSegv, 0)
    val bus = bootstrapCtSigaction(bootstrapCtBusSignal(), bootstrapCtSavedBus, 0)
    return
}
