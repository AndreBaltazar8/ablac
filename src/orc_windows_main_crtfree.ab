// The compiler for Windows without Microsoft's C library (decision #163, steps 2 to 6 of
// docs/design/windows-crt-free-compiler.md): src/orc_windows_main.ab with Abla's own C library under the C++ in LLVM's and lld's
// archives, as src/orc_main_static.ab has on Linux. Only the ablac-crt-candidate inventory link uses it until the plan's switch;
// the shipped compiler is src/orc_windows_main.ab, linked with /MT.
//
// The modules of src/static_libc whose functions compute (math, strings, number parsing, printf's conversions) are the Linux ones:
// their C names and arguments are the same on Windows. What differs (32-bit long, 2-byte wchar_t, the descriptor and stdio names,
// start-up and locale) is in src/static_libc/windows; src/static_libc/lp64.ab, the Linux forms of those names, is not imported here.
import "orc_main.ab" as orc
import "static_lld.ab"
import "static_libc/math.ab"
import "static_libc/math2.ab"
import "static_libc/math3.ab"
import "static_libc/string.ab"
import "static_libc/ctypestr.ab"
import "static_libc/strtof.ab"
import "static_libc/windows/process.ab"
import "static_libc/windows/io.ab"
import "static_libc/windows/locale.ab"
import "static_libc/windows/string.ab"

fun main: int {
    staticLldInstall()
    orc.main()
}
