// Keep this order in sync with the state definition in the LLVM backend.
private val bootstrapFastRuntimeStateFields = [
    "HostHeapMutex",
    "HostSmallBytes",
    "HostRegistry",
    "HostRegistrySlots",
    "HostRegistryCapacity",
    "HostLimit",
    "HostLiveBytes",
    "HostSmallClassHeaderWidth"
]

val BOOTSTRAP_FAST_RUNTIME_STATE_SYMBOL = "abla_fast_runtime_alloc_state"
// The scalar fields above and the 65 small-block list heads.
val BOOTSTRAP_FAST_RUNTIME_STATE_WORDS = bootstrapFastRuntimeStateFields.size + 65
val BOOTSTRAP_FAST_RUNTIME_LIMIT_WORD = 5

private val BOOTSTRAP_FAST_RUNTIME_PREFIX = "__ablaRuntime"
private val BOOTSTRAP_FAST_RUNTIME_BASE = "__ablaRuntimeRoAllocBase"
private val BOOTSTRAP_FAST_RUNTIME_BASE_CALL = "__ablaRuntimeRoAllocState()"

class BootstrapFastRuntimeView(
    val source: string,
    val exports: array<string>,
    val error: string = ""
)

class BootstrapFastRuntimePartition(
    val declarations: array<BootstrapDeclaration>,
    val objectGlobals: Map<string, bool>,
    val dependentFunctions: Map<string, bool>,
    val error: string = ""
)

private class BootstrapFastRuntimeEdit(val begin: int, val end: int, val text: string)

private fun bootstrapFastRuntimeShort(name: string): string =
    if (name.startsWith(BOOTSTRAP_FAST_RUNTIME_PREFIX))
        name.slice(BOOTSTRAP_FAST_RUNTIME_PREFIX.size, name.size)
    else ""

private fun bootstrapFastRuntimeHas(names: array<string>, name: string): bool {
    for (candidate in names) if (candidate == name) return true
    false
}

private fun bootstrapFastRuntimeInlineAllocation(short: string): bool =
    short == "PlatformAllocateLayout" || short == "HostAllocateBody" ||
    short == "HostTrackedAllocate" || short == "HostBlockAllocate" ||
    short == "HostRegister" || short == "HostHeapLock"

private fun bootstrapFastRuntimeField(name: string): int {
    val short = bootstrapFastRuntimeShort(name)
    for (index in 0 until bootstrapFastRuntimeStateFields.size) {
        if (bootstrapFastRuntimeStateFields[index] == short) return index
    }
    -1
}

// Traverse expressions in source order. The assignment prefix and suffix
// leave the right-hand side available for the same field substitutions.
private fun bootstrapFastRuntimeFieldEdits(
    expression: BootstrapExpression,
    var edits: array<BootstrapFastRuntimeEdit>
): bool {
    val field = bootstrapFastRuntimeField(expression.text)
    val base = BOOTSTRAP_FAST_RUNTIME_BASE
    if (field >= 0 && expression.kind == "identifier") {
        edits.append(BootstrapFastRuntimeEdit(expression.begin, expression.end,
            "ablaRuntimeLoadI64($base + ${field * 8})"))
        return true
    }
    if (field >= 0 && expression.kind == "assign") {
        val value = expression.children[0]
        // A compound assignment's synthesized RHS starts at the original
        // place. Reject it instead of applying overlapping source edits.
        if (value.begin <= expression.begin) return false
        edits.append(BootstrapFastRuntimeEdit(expression.begin, value.begin,
            "ablaRuntimeStoreI64($base + ${field * 8}, "))
        if (!bootstrapFastRuntimeFieldEdits(value, edits)) return false
        edits.append(BootstrapFastRuntimeEdit(expression.end, expression.end, ")"))
        return true
    }
    if (expression.kind == "call" && expression.text == "__ablaRuntimeHostSmallLists") {
        edits.append(BootstrapFastRuntimeEdit(expression.begin, expression.end,
            "($base + ${bootstrapFastRuntimeStateFields.size * 8})"))
        return true
    }
    for (child in expression.children) {
        if (!bootstrapFastRuntimeFieldEdits(child, edits)) return false
    }
    true
}

private fun bootstrapFastRuntimeFunctionSource(
    source: string, declaration: BootstrapDeclaration
): string? {
    val expression = declaration.expression
    val edits: array<BootstrapFastRuntimeEdit> = []
    if (!bootstrapFastRuntimeFieldEdits(expression, edits)) return null
    if (edits.size == 0) return source.slice(declaration.begin, declaration.end)
    val text = byteBuffer()
    val start = expression.begin
    val base = BOOTSTRAP_FAST_RUNTIME_BASE
    var cursor = start
    if (expression.kind == "block") {
        text.appendText(source.slice(declaration.begin, start + 1))
        text.appendText("\n    val $base = $BOOTSTRAP_FAST_RUNTIME_BASE_CALL\n")
        cursor = start + 1
    } else {
        val header = source.slice(declaration.begin, start).trim()
        if (!header.endsWith("=")) return null
        text.appendText(header.slice(0, header.size - 1))
        text.appendText("{\n    val $base = $BOOTSTRAP_FAST_RUNTIME_BASE_CALL\n    ")
    }
    for (edit in edits) {
        if (edit.begin < cursor || edit.end > expression.end) return null
        text.appendText(source.slice(cursor, edit.begin))
        text.appendText(edit.text)
        cursor = edit.end
    }
    text.appendText(source.slice(cursor, expression.end))
    if (expression.kind != "block") text.appendText("\n}")
    text.appendText(source.slice(expression.end, declaration.end))
    text.toText()
}

private fun bootstrapFastRuntimeNativeDeclaration(
    declaration: BootstrapDeclaration,
    name: string,
    wrapper: bool
): string {
    val parameters: array<string> = []
    for (index in 0 until declaration.parameters.size) {
        parameters.append("${declaration.parameters[index]}: ${declaration.parameterTypes[index]}")
    }
    val signature = "(${parameters.join(", ")}): ${declaration.resultType}"
    val external = "trusted noescape extern:\"c\" fun $name$signature\n"
    if (!wrapper) return external
    "$external" + "trusted fun ${declaration.name}$signature = $name(${declaration.parameters.join(", ")})\n"
}

private fun bootstrapFastRuntimeSpecial(short: string, producer: bool): string {
    if (short == "HostGetenv" && producer) return """
trusted noescape extern:"c" fun abla_ro_getenv(name: int): int
trusted fun __ablaRuntimeHostGetenv(name: i64*): i64* =
    ablaRuntimePointerFromAddress(abla_ro_getenv(ablaRuntimePointerAddress(name)))
"""
    if (producer) return ""
    if (short == "HostFree") return """
trusted noescape extern:"c" fun abla_ro_free(address: int): void
trusted fun __ablaRuntimeHostFree(pointer: i64*): void =
    abla_ro_free(ablaRuntimePointerAddress(pointer))
"""
    if (short == "HostFreezeBody") return bootstrapFastRuntimeFrozenBridge()
    if (short == "HostStwTrace") return """
trusted noescape extern:"c" fun abla_ro_trace(message: int, length: int, number: int, tail: int, tailLength: int): void
private trusted fun __ablaRuntimeHostStwTrace(message: string, length: int, number: int, tail: string, tailLength: int): void {
    abla_ro_trace(__ablaRuntimeWord0(message), length, number, __ablaRuntimeWord0(tail), tailLength)
}
"""
    ""
}

/**
 * What a program with the prebuilt runtime compiles for the freeze (stdlib/abla/runtime/platform/frozen.ab, which the
 * object holds and exports as abla_ro_freeze): the source bootstrapFastRuntimeApply gives frozen.ab's module.
 */
fun bootstrapFastRuntimeFrozenBridge(): string = """
trusted noescape extern:"c" fun abla_ro_freeze(input: int, output: int): void
trusted fun __ablaRuntimeHostFreezeBody(value: any): any {
    val output = nativeStackAllocate(24)
    abla_ro_freeze(ablaRuntimeValueAddress(value), output)
    __ablaRuntimeValueAt(output)
}
"""

private fun bootstrapFastRuntimeBridges(producer: bool): string {
    if (!producer) return """
@export("abla_ro_getenv")
trusted fun abla_ro_getenv(name: int): int =
    ablaRuntimePointerAddress(__ablaRuntimeHostGetenv(ablaRuntimePointerFromAddress(name)))
"""
    """
@export("abla_ro_free")
trusted fun abla_ro_free(address: int): void =
    __ablaRuntimeHostFree(ablaRuntimePointerFromAddress(address))

@export("abla_ro_freeze")
trusted fun abla_ro_freeze(input: int, output: int): void {
    __ablaRuntimeCopyValue(__ablaRuntimeHostFreezeBody(__ablaRuntimeValueAt(input)), output)
}

@export("abla_ro_trace")
trusted fun abla_ro_trace(message: int, length: int, number: int, tail: int, tailLength: int): void {
    if (!__ablaRuntimeHostGcTrace) return
    __ablaRuntimeHostWrite(2, message, length)
    __ablaRuntimeHostStwWriteNumber(number)
    val discarded = __ablaRuntimeHostWrite(2, tail, tailLength)
}
"""
}

private fun bootstrapFastRuntimeForwarder(
    short: string, declaration: BootstrapDeclaration, moved: bool
): string {
    if (short == "MemoryPressure") return "abla_ro_pressure"
    if (short == "MemoryPressureLoop") return "abla_ro_pressure_loop"
    // Keep the Abla callable surface for non-private runtime hooks,
    // including calls from code outside the standard library.
    if ((moved && !declaration.isPrivate &&
        short != "HostFree" && short != "HostFreezeBody" && short != "HostStwTrace") ||
        bootstrapFastRuntimeHas(bootstrapFastRuntimeCrossModule, short)) return "abla_ro_$short"
    ""
}

private fun bootstrapFastRuntimeProgramOwns(short: string): bool =
    short == "HostStmCell" || short == "HostRootFrameAddress" || short == "HostGetenv"

private fun bootstrapFastRuntimeUsesObjectGlobal(
    expression: BootstrapExpression, objectGlobals: Map<string, bool>
): bool {
    if ((expression.kind == "identifier" || expression.kind == "assign") &&
        objectGlobals.has(expression.text)) return true
    for (child in expression.children) {
        if (bootstrapFastRuntimeUsesObjectGlobal(child, objectGlobals)) return true
    }
    false
}

fun bootstrapFastRuntimePartition(source: string): BootstrapFastRuntimePartition {
    val parsed = bootstrapParse(source)
    val objectGlobals: Map<string, bool> = Map()
    val dependentFunctions: Map<string, bool> = Map()
    if (parsed.errors != 0) return BootstrapFastRuntimePartition([], objectGlobals,
        dependentFunctions, "cannot parse host runtime")
    for (short in bootstrapFastRuntimeObjectGlobals) {
        objectGlobals.set(BOOTSTRAP_FAST_RUNTIME_PREFIX + short, true)
    }
    // An initializer that reads object-owned state must run with that state.
    // Close over these dependencies before choosing where function bodies go.
    var changed = true
    while (changed) {
        changed = false
        for (declaration in parsed.declarations) {
            if ((declaration.kind == "val" || declaration.kind == "var") &&
                !objectGlobals.has(declaration.name) &&
                bootstrapFastRuntimeUsesObjectGlobal(declaration.expression, objectGlobals)) {
                objectGlobals.set(declaration.name, true)
                changed = true
            }
        }
    }
    // Keep each accessor with its state. Other functions can still call it
    // through the existing native bridge, so callers need not move with it.
    for (declaration in parsed.declarations) {
        if (declaration.kind != "fun" ||
            !bootstrapFastRuntimeUsesObjectGlobal(declaration.expression, objectGlobals)) continue
        val short = bootstrapFastRuntimeShort(declaration.name)
        if (bootstrapFastRuntimeInlineAllocation(short) || bootstrapFastRuntimeProgramOwns(short)) {
            return BootstrapFastRuntimePartition([], objectGlobals, dependentFunctions,
                "program-owned runtime function reads object-owned state: ${declaration.name}")
        }
        if (!bootstrapFastRuntimeHas(bootstrapFastRuntimeMovedFunctions, short)) {
            dependentFunctions.set(declaration.name, true)
        }
    }
    BootstrapFastRuntimePartition(parsed.declarations, objectGlobals, dependentFunctions)
}

private fun bootstrapFastRuntimeAppendExport(
    var text: ByteBuffer, var exports: array<string>, symbol: string
): void {
    text.appendText("@export(\"$symbol\")\n")
    exports.append(symbol)
}

// The parser marks a declaration private without including the modifier
// in the declaration range. Find it so that the object can export the
// original private helpers under their explicit, linker-only names.
private fun bootstrapFastRuntimePrivateStart(source: string, declaration: BootstrapDeclaration): int {
    var at = declaration.begin
    if (!declaration.isPrivate) return at
    while (at > 0 && (source[at - 1] == 32 || source[at - 1] == 9)) at = at - 1
    if (at >= 7 && source.slice(at - 7, at) == "private") at - 7
    else declaration.begin
}

fun bootstrapFastRuntimeView(
    source: string, partition: BootstrapFastRuntimePartition, producer: bool
): BootstrapFastRuntimeView {
    val text = byteBuffer()
    val exports: array<string> = []
    var limit = ""
    var cursor = 0
    for (declaration in partition.declarations) {
        val short = bootstrapFastRuntimeShort(declaration.name)
        val dependent = partition.dependentFunctions.has(declaration.name)
        val objectGlobal = partition.objectGlobals.has(declaration.name)
        if (short == "" && !dependent && !objectGlobal) continue
        val privateStart = bootstrapFastRuntimePrivateStart(source, declaration)
        var begin = privateStart
        for (annotation in declaration.annotationBegins) {
            if (annotation < begin) begin = annotation
        }
        val end = declaration.end
        val special = bootstrapFastRuntimeSpecial(short, producer)
        val stateField = bootstrapFastRuntimeField(declaration.name)
        val isSmallLists = short == "HostSmallLists"
        val moved = dependent || (bootstrapFastRuntimeHas(bootstrapFastRuntimeMovedFunctions, short) &&
            !bootstrapFastRuntimeInlineAllocation(short))
        val forwarder = bootstrapFastRuntimeForwarder(short, declaration, moved)
        val symbol = if (forwarder == "") declaration.name else forwarder
        val cut = if (producer) bootstrapFastRuntimeProgramOwns(short) else moved
        val export = if (producer) !isSmallLists &&
            (dependent || bootstrapFastRuntimeHas(bootstrapFastRuntimeExports, short) || forwarder != "")
        else short == "HostRootFrameAddress" || short == "HostStmCell"
        val drop = stateField >= 0 || isSmallLists || (!producer && objectGlobal)
        if (!drop && special == "" && !cut && !export && declaration.kind != "fun") continue
        if (begin < cursor || end < begin) return BootstrapFastRuntimeView("", [], "invalid host runtime declaration range")
        text.appendText(source.slice(cursor, begin))
        cursor = end
        if (stateField == BOOTSTRAP_FAST_RUNTIME_LIMIT_WORD) {
            limit = source.slice(declaration.expression.begin, declaration.expression.end)
        }
        if (drop) continue
        if (special != "") {
            text.appendText(special)
            continue
        }
        if (cut) {
            if (declaration.isPrivate && forwarder == "") text.appendText("private ")
            text.appendText(bootstrapFastRuntimeNativeDeclaration(declaration, symbol, symbol != declaration.name))
            continue
        }
        if (export) bootstrapFastRuntimeAppendExport(text, exports, symbol)
        if (!producer && short == "HostRegister") text.appendText("@inline\n")
        text.appendText(source.slice(begin, if (export) privateStart else declaration.begin))
        val rewritten = bootstrapFastRuntimeFunctionSource(source, declaration)
        if (rewritten == null) return BootstrapFastRuntimeView("", [], "unsupported shared allocator field use in ${declaration.name}")
        text.appendText(rewritten)
    }
    if (limit == "") return BootstrapFastRuntimeView("", [], "missing host allocation limit")
    text.appendText(source.slice(cursor, source.size))
    if (producer) {
        text.appendText("\ntrusted noescape extern:\"intrinsic\" fun __ablaFastRuntimeDefineState(limit: int): int\n")
        text.appendText("@inline\ntrusted fun __ablaRuntimeRoAllocState(): int = __ablaFastRuntimeDefineState($limit)\n")
    } else {
        text.appendText("\n@inline\ntrusted fun __ablaRuntimeRoAllocState(): int = nativeLinkerSymbolAddress(\"$BOOTSTRAP_FAST_RUNTIME_STATE_SYMBOL\")\n")
    }
    text.appendText(bootstrapFastRuntimeBridges(producer))
    if (producer) {
        exports.append("abla_ro_free")
        exports.append("abla_ro_freeze")
        exports.append("abla_ro_trace")
        exports.append(BOOTSTRAP_FAST_RUNTIME_STATE_SYMBOL)
    } else exports.append("abla_ro_getenv")
    BootstrapFastRuntimeView(text.toText(), exports)
}
