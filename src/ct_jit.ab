import "ct_global_graph.ab"
import "ct_state.ab"
// Compile-time evaluation as native code: the generations (ABLA_COMPILE_EVAL=jit|auto).
//
// The interpreter (eval.ab) runs `#expr` and top-level compile actions by walking
// the syntax tree. This tier runs them as machine code instead: after semantic
// analysis, every site of a compile pass becomes an exported entry function of one
// *slice program* (the program's own declarations, compile-phase ones lowered as
// ordinary code, plus the entries), lowered and emitted through the same IR and
// LLVM path as runtime code, and added to the process's LLVM ORC session as one
// generation; ct_eval.ab calls the entries where the interpreter would have run.
//
// A site the tier cannot take yet (a result the value codec cannot carry, a compiler
// API or provider signature, a cross-target site not proven portable) runs in the interpreter;
// ABLA_COMPILE_EVAL_TRACE=1 says why.

import "backend/llvm/coverage.ab"
import "ct_eval.ab"
import "backend/llvm/backend.ab"
import "abla/llvm/orc"
import "abla/unsafe/memory/raw"
import "parser.ab"
import "sema.ab"
import "ir.ab"
import "ct_bridge.ab"
import "ct_native_effects.ab"
import "ct_native.ab"
import "ct_lift.ab"
import "ct_portable_extern.ab"
import "call_targets.ab"
import "eval.ab"
import "abla/sys/linux/process"
import "abla/sys/linux/fs"
import "backend/llvm/debug.ab"
import "backend/llvm/bindings.ab"
import "backend/llvm/analysis.ab"
import "abla/text"
import "abla/sys/linux"
import "codegen_units.ab"
import "toolchain.ab"
import "jit_cache.ab"
import "ct_tier.ab"
import "abla/runtime/memory"

// One ORC session for the process; one generation per compile pass that has sites.
var bootstrapCtSessionLive: bool = false
var bootstrapCtSessionState: LlvmOrcSession = LlvmOrcSession(
    nativeNullPointer(), nativeNullPointer(), 128, true
)
var bootstrapCtGenerationLive: bool = false
var bootstrapCtGenerationState: LlvmOrcGeneration = LlvmOrcGeneration(
    nativeNullPointer(), 128, true
)
var bootstrapCtGenerationNumber: int = 0
// A pass's sites are live from its analysis to the end of its compilation; a
// compilation started inside it (compile-time code building another program) is
// counted and interpreted, so the outer pass keeps its sites and generation.
var bootstrapCtPassActive: bool = false
var bootstrapCtNestedPasses: int = 0
var bootstrapCtNextSite: int = 0

// --- sites -------------------------------------------------------------------

fun bootstrapCtIsAction(expression: BootstrapExpression): bool {
    val transform = expression.kind == "member.call" &&
        expression.text == "transform" &&
        expression.children.size > 0 &&
        expression.children[0].kind == "identifier" &&
        expression.children[0].text == "compiler"
    val authorization = expression.kind == "compile.capability.authorization"
    val grant = expression.kind == "call" && expression.text == "compilerGrant"
    // Literal subparser registrations and generated modules are applied from source and never run (eval.ab,
    // toolchain.ab): as sites, abla/json's two registrations made every program importing it, the compiler among
    // them, keep the checker's call targets and prepare a pass for code that never runs, ~45 MB over interp at the
    // self-build's peak (tools/test-compiler-memory-peak.sh).
    val literal = expression.kind == "call" &&
        (expression.text == "compilerRegisterSubparser" || expression.text == "compilerGenerateModule")
    !transform && !authorization && !grant && !literal
}

fun bootstrapCtCollectNodes(
    expression: BootstrapExpression,
    sourceIdentity: string
): void {
    if (expression.kind == "compile" && expression.children.size == 1) {
        // Compile code nested in it runs as part of it: one site.
        bootstrapCtSites.append(BootstrapCtSite(
            expression.children[0], expression, sourceIdentity, false,
            "unknown", -1, BOOTSTRAP_CT_UNPREPARED, 0
        ))
    } else {
        for (child in expression.children) {
            bootstrapCtCollectNodes(child, sourceIdentity)
        }
    }
}

fun bootstrapCtCollectDeclaration(
    declaration: BootstrapDeclaration,
    sourceIdentity: string
): void {
    // A compile declaration's `compile` nodes run inside the interpreter when the
    // declaration runs, never at lowering: not sites.
    if (declaration.kind == "compile.fun" || declaration.kind == "compile.val" ||
        declaration.kind == "compile.var" || declaration.kind == "extern") return
    bootstrapCtCollectNodes(declaration.expression, sourceIdentity)
    for (parameterDefault in declaration.parameterDefaults) {
        bootstrapCtCollectNodes(parameterDefault, sourceIdentity)
    }
    for (method in declaration.methods) {
        bootstrapCtCollectDeclaration(method, sourceIdentity)
    }
}

fun bootstrapCtCollectSites(parsed: BootstrapParseResult): void {
    bootstrapCtSites = []
    for (action in parsed.actions) {
        var expression = action
        if (expression.kind == "compile" && expression.children.size == 1) {
            expression = expression.children[0]
        }
        if (bootstrapCtIsAction(expression)) {
            bootstrapCtSites.append(BootstrapCtSite(
                expression, action, "", true, "void", -1, BOOTSTRAP_CT_UNPREPARED, 0
            ))
        }
    }
    for (declaration in parsed.declarations) {
        bootstrapCtCollectDeclaration(declaration, declaration.sourceIdentity)
    }
}

// Semantic analysis of the program, with each site's static type recorded (typed
// requests for its `compile` node) when the tier is on; then the pass's slice.
fun bootstrapCtAnalyze(
    parsed: BootstrapParseResult,
    targetTriple: string
): BootstrapSemanticResult {
    // The outermost build's target, for the target queries the interpreter answers (a nested pass compiles a site for the host).
    if (!bootstrapCtPassActive) ctNativeSetBuildTarget(targetTriple)
    if (bootstrapCtMode() == "interp" || bootstrapCtRegionActive()) {
        return bootstrapAnalyzeParsed(parsed)
    }
    if (bootstrapCtPassActive) {
        bootstrapCtNestedPasses = bootstrapCtNestedPasses + 1
        return bootstrapAnalyzeParsed(parsed)
    }
    bootstrapCtFinishPass()
    bootstrapCtPassActive = true
    bootstrapCtCollectSites(parsed)
    if (bootstrapCtSites.size == 0) return bootstrapAnalyzeParsed(parsed)
    val begins: array<int> = []
    val ends: array<int> = []
    val kinds: array<string> = []
    val sources: array<string> = []
    for (site in bootstrapCtSites) {
        if (!site.action) {
            begins.append(site.node.begin)
            ends.append(site.node.end)
            kinds.append("compile")
            sources.append(site.sourceIdentity)
        }
    }
    // The checker's resolved method and operator targets are kept for every target: the
    // cross-target reach narrows by them, and so does the ordinary-global write analysis
    // (ct_state.ab), which a host build runs too (#828).
    val analyzed = bootstrapAnalyzeRequestedSourceSpans(
        parsed, begins, ends, kinds, sources, true
    )
    for (site in bootstrapCtSites) {
        if (!site.action) {
            for (typed in analyzed.typedCalls) {
                if (typed.kind == "compile" && typed.begin == site.node.begin &&
                    typed.end == site.node.end &&
                    typed.sourceIdentity == site.sourceIdentity) {
                    site.type = typed.type
                }
            }
        }
    }
    // An erased float in a string template is written by the erased-float formatter when the program
    // demands it (backend.ab decides after this analysis, for the program's own lowering): the slice is
    // lowered here, before that, so it is told now. Else `"${x}"` of an `any` holding 2.5 printed the
    // float's bits natively, where the evaluator and the program print 2.5.
    val outerFormatting = bootstrapFloatFormattingRequested
    if (bootstrapFloatDemandActive && bootstrapFloatBridgeAvailable &&
        bootstrapFloatDemandOrigin && bootstrapFloatDemandText) bootstrapFloatFormattingRequested = true
    if (analyzed.errors == 0) bootstrapCtPrepare(parsed, targetTriple, analyzed.methodTargets)
    bootstrapFloatFormattingRequested = outerFormatting
    analyzed
}

// Cross-target slices execute with host layout. Only this conservative portable
// subset may cross that boundary; adding a construct requires evaluator parity.
fun bootstrapCtCrossNodeAllowed(node: BootstrapExpression): bool {
    val kind = node.kind
    kind == "missing" || kind == "type" || kind == "integer" || kind == "string" || kind ==
        "char" || kind == "true" ||
        kind == "false" || kind == "null" || kind == "identifier" || kind == "call" ||
        kind == "member.call" || kind == "member" || kind == "index" || kind == "array" ||
        kind == "block" || kind == "local.val" || kind == "local.var" || kind == "assign" ||
        kind == "member.assign" || kind == "index.assign" || kind == "return" ||
        kind == "break" || kind == "continue" || kind == "if" || kind == "when" ||
        kind == "while" || kind == "do.while" || kind == "for" ||
        kind == "range.closed" || kind == "range.until" || kind == "string.template" ||
        kind == "compile" || kind == "unary-" || kind == "unary+" || kind == "unary!" ||
        kind == "unary~" || kind == "+" || kind == "-" || kind == "*" || kind == "/" ||
        kind == "%" || kind == "&" || kind == "|" || kind == "^" || kind == "<<" ||
        kind == ">>" || kind == ">>>" || kind == "==" || kind == "!=" || kind == "<" ||
        kind == "<=" || kind == ">" || kind == ">=" || kind == "&&" || kind == "||"
}

fun bootstrapCtCrossBuiltin(node: BootstrapExpression): bool {
    val name = node.text
    if (node.kind == "call") {
        return name == "filledArray" || name == "int" || name == "bool" ||
            name == "i8" || name == "u8" ||
            name == "i16" || name == "u16" || name == "i32" || name == "u32" ||
            name == "i64" || name == "u64"
    }
    node.kind == "member.call" && (name == "append" || name == "slice" ||
        name == "truncate" || name == "clear" || name == "removeAt" ||
        name == "removeLast" || name == "takeAt")
}

// ablaAtCompileTime is true in the evaluator and in its native bridge shim.
// Ignore only code neither tier executes; the ordinary reach walk still keeps
// full bodies for slice analysis and lowering. No target probe is folded here.
fun bootstrapCtCrossPhaseIf(node: BootstrapExpression): bool =
    node.kind == "if" && node.children.size == 3 &&
    node.children[0].kind == "call" && node.children[0].text == "ablaAtCompileTime" &&
    node.children[0].children.size == 0

fun bootstrapCtCrossReturns(node: BootstrapExpression): bool =
    node.kind == "return" ||
    (node.kind == "block" && node.children.size > 0 &&
     bootstrapCtCrossReturns(node.children[node.children.size - 1]))

fun bootstrapCtCrossChildren(node: BootstrapExpression): array<BootstrapExpression> {
    if (bootstrapCtCrossPhaseIf(node)) return [node.children[0], node.children[1]]
    val children: array<BootstrapExpression> = []
    for (child in node.children) {
        children.append(child)
        if (node.kind == "block" && (bootstrapCtCrossReturns(child) ||
            (bootstrapCtCrossPhaseIf(child) && bootstrapCtCrossReturns(child.children[1])))) {
            return children
        }
    }
    children
}

// Two compiler-owned formatter tables are portable literal data. Only
// initializer validation may use this exception; a user's read still faces the
// ordinary type/annotation checks. No callable initializer may inherit it.
fun bootstrapCtCrossLiteralTable(declaration: BootstrapDeclaration): bool {
    val source = "${bootstrapCompileProviderStandardLibrary()}/abla/float/text/entry.ab"
    val floats = declaration.name == "F64_PARSE_TENS" ||
        declaration.name.endsWith("__F64_PARSE_TENS")
    val integers = declaration.name == "F64_PARSE_FIVES" ||
        declaration.name.endsWith("__F64_PARSE_FIVES")
    if (declaration.sourceIdentity != source || declaration.kind != "val" ||
        (!floats && !integers) || declaration.expression.kind != "array") return false
    for (element in declaration.expression.children) {
        if (element.kind != (if (floats) "float" else "integer")) return false
    }
    declaration.expression.children.size > 0
}

// Compiler-owned abla/json roots that carry @threadShared: immutable scalar records and the shared empty array
// and number every parsed scalar points at. Only this exact set (name and source) may carry the annotation across
// the boundary; the initializers are walked like any other, and the ordinary-global write analysis still sends a site
// that can write one of them (jsonNull().keys.append(x)) to the interpreter, so a native slice only reads them.
fun bootstrapCtCrossJsonShared(declaration: BootstrapDeclaration): bool {
    if (declaration.sourceIdentity != "${bootstrapCompileProviderStandardLibrary()}/abla/json/entry.ab" ||
        declaration.kind != "val") return false
    val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
    name == "jsonStandardLimits" || name == "jsonPermissiveLimits" || name == "jsonNoKeys" ||
        name == "jsonNoValues" || name == "jsonNoNumber" || name == "jsonEmitPlaceholder"
}

// The compiler bridge performs the same named host read in either tier. Keep
// this exception tied to the compiler-owned prototype, including its full ABI.
fun bootstrapCtCrossEnvironment(declaration: BootstrapDeclaration): bool {
    if (declaration.name != "compilerEnvironment" || declaration.sourceIdentity !=
        "${bootstrapCompileProviderStandardLibrary()}/abla/compiler/entry.ab") return false
    val expected = bootstrapParse(
        "compile extern:\"compiler\" fun compilerEnvironment(name: string): string"
    )
    expected.errors == 0 && expected.declarations.size == 1 &&
        bootstrapCtSameExtern(declaration, expected.declarations[0])
}

fun bootstrapCtCrossDeclarationReason(declaration: BootstrapDeclaration,
    owner: BootstrapDeclaration): string {
    val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
    var source = declaration.sourceIdentity
    if (source == "") source = owner.sourceIdentity
    val root = bootstrapCompileProviderStandardLibrary()
    val library = source.startsWith("$root/")
    val module = if (library) source.slice(root.size + 1, source.size) else ""
    // Only known capability providers are a portable boundary: their existing
    // shim performs the evaluator's host operation. Compiler/parser queries may
    // inspect target-specific declarations, so keep them interpreted for now.
    val bridged = bootstrapCompileDeclarationProviderEffect(declaration) > 0
    var reason = ""
    if (bridged || bootstrapCtCrossEnvironment(declaration)) return ""
    if (declaration.kind == "extern") {
        val portable = declaration.externalLibrary == "intrinsic" &&
            (((module == "abla/bytes/entry.ab" || module == "abla/crypto/entry.ab") &&
              (name == "ablaByteEncode" || name == "ablaByteChunksJoin" ||
               name == "ablaBase64Encode" || name == "ablaBase64Decode")) ||
             (module == "abla/text/entry.ab" && (name == "ablaTextFindSequence" ||
              name == "ablaTextIsValidUtf8" || name == "ablaTextReadU32LittleEndian" ||
              name == "ablaTextFindByte" || name == "ablaTextAsciiEqualInsensitive" ||
              name == "ablaUtf8EncodeScalar")) ||
             (module == "abla/json/entry.ab" && (name == "ablaJsonFindPlainStringEnd" ||
              name == "ablaJsonMatchCompactObjectField" || name == "ablaJsonCompactArrayNext" ||
              name == "ablaJsonAvailableIntegerEnd" || name == "ablaJsonIntegerValueAt" ||
              name == "ablaJsonWhitespaceEnd" || name == "ablaJsonStringIsPlain")))
        if (!portable) reason = "extern is not in the portable intrinsic allow-list"
    } else if (declaration.kind != "fun" && declaration.kind != "compile.fun" &&
        declaration.kind != "val" && declaration.kind != "var" &&
        declaration.kind != "compile.val" && declaration.kind != "compile.var" &&
        declaration.kind != "class" && declaration.kind != "interface") reason =
        "declaration kind ${declaration.kind} is not proven portable"
    if (reason == "" && library && module != "abla/bytes/entry.ab" &&
        module != "abla/crypto/entry.ab" && module != "abla/text/entry.ab" && module != "abla/json/entry.ab" &&
        module != "abla/sys/linux/fs/entry.ab" &&
        !(module == "abla/float/text/entry.ab" && bootstrapDeclarationIsValue(declaration.kind))) {
        reason = "module $module is not in the portable library allow-list"
    }
    if (reason == "" && declaration.isResource) reason = "resource lifetime is not proven portable"
    for (annotation in declaration.annotations) {
        if (reason == "" && annotation != "inline" && annotation != "noinline" &&
            annotation != "operator" &&
            !(annotation == "threadShared" && bootstrapCtCrossJsonShared(declaration))) {
            reason = "annotation $annotation is not proven portable"
        }
    }
    val types: array<string> = [declaration.resultType, declaration.extensionOwner]
    for (type in declaration.parameterTypes) types.append(type)
    // An interface is its method signatures (#813): they must be as portable as a function's own.
    if (declaration.kind == "interface") {
        for (method in declaration.methods) {
            types.append(method.resultType)
            for (type in method.parameterTypes) types.append(type)
        }
    }
    for (type in types) {
        if (reason == "" && bootstrapTextContains(type, "*")) {
            reason = "pointer layout is not portable"
        }
        if (reason == "" &&
            (bootstrapTextContains(type, "f32") || bootstrapTextContains(type, "f64"))) {
            reason = "floating-point behavior is not proven bit-identical"
        }
    }
    if (reason == "") "" else "cross-target site reaches $name: $reason"
}

// Match the public standard-library prototypes for these two compiler-owned
// raw primitives. Their native effects remain enforced; `trusted` on the
// hosted platform's private prototype must not invalidate ordinary syscall wrappers.
fun bootstrapCtHostPrimitive(declaration: BootstrapDeclaration): BootstrapDeclaration {
    if (declaration.kind != "extern" || declaration.externalLibrary != "intrinsic" ||
        (declaration.name != "ablaLinuxSyscall" && declaration.name != "ablaSimdTargetArch")) {
        return declaration
    }
    BootstrapDeclaration(
        declaration.kind, declaration.name, declaration.begin, declaration.end,
        declaration.expression, declaration.parameters, declaration.parameterTypes,
        declaration.resultType, declaration.methods, declaration.parameterDefaults,
        declaration.externalLibrary, declaration.parameterKinds, declaration.extensionOwner,
        false, declaration.isResource, declaration.isNoEscape, declaration.generatedNamespace,
        declaration.generatedOriginBegin, declaration.generatedOriginEnd, declaration.annotations,
        declaration.annotationArguments, declaration.annotationBegins, declaration.annotationEnds,
        declaration.sourceIdentity, declaration.conformances, declaration.isSealed,
        declaration.isPrivate, declaration.typeParameters
    )
}

// Cross-target source carries its target allocator/platform. A CT generation
// needs the same hosted platform as a normal host JIT generation instead.
// This parses compiler-owned support only, never reloads the user's modules.
fun bootstrapCtHostPlatform(var declarations: array<BootstrapDeclaration>): string {
    val root = bootstrapCompileProviderStandardLibrary()
    val wasm = "$root/abla/runtime/platform/wasm.ab"
    var replace = false
    for (declaration in declarations) {
        if (declaration.sourceIdentity == wasm) replace = true
    }
    if (!replace) return "cross-target Wasm platform runtime is unavailable"
    val kept: array<BootstrapDeclaration> = []
    for (declaration in declarations) {
        if (declaration.sourceIdentity != wasm) kept.append(declaration)
    }
    val files = ["abla/runtime/platform/host.ab", "abla/unsafe/native/function-address/entry.ab",
        "abla/unsafe/memory/raw/entry.ab"]
    // The BSD system calls of a macOS host (a Linux host never parses them).
    if (ablaHostIsMacOS()) files.append("abla/runtime/platform/darwin/entry.ab")
    for (file in files) {
        val path = "$root/$file"
        if (!Path(path).exists()) return "cross-target host runtime file unavailable: $file"
        val parsed = bootstrapParseWithIdentity(Path(path).readText(), path)
        if (parsed.errors > 0 || parsed.declarations.size == 0) {
            return "cross-target host runtime empty or invalid: $file"
        }
        for (original in parsed.declarations) {
            if (file == "abla/unsafe/memory/raw/entry.ab" &&
                original.name != "nativeThreadLocalBytes" && original.name !=
                "nativeStaticAllocate") continue
            val declaration = if (file == "abla/runtime/platform/host.ab")
                bootstrapCtHostPrimitive(original) else original
            var duplicate = false
            for (existing in kept) {
                if (existing.name == declaration.name &&
                    existing.extensionOwner == declaration.extensionOwner) {
                    val same = bootstrapCtSameExtern(existing, declaration) ||
                        bootstrapCtSameIntrinsic(existing, declaration)
                    if (!same) return "cross-target host runtime declaration collision: ${declaration.name}"
                    duplicate = true
                }
            }
            if (!duplicate) kept.append(declaration)
        }
    }
    declarations.clear()
    for (declaration in kept) declarations.append(declaration)
    ""
}

// --- reachability: what a site's code can reach, by name ---------------------

class BootstrapCtReach(
    val declarations: array<BootstrapDeclaration>,
    val table: BootstrapIrNameTable,
    val itemDeclarations: array<int>,
    val itemMethods: array<int>,
    val itemNext: array<int>,
    val visited: array<bool>,
    // Every declaration some ready site reaches: the slice is these and the runtime.
    val kept: array<bool>,
    val methodTargets: BootstrapResolvedMethodTargets = bootstrapResolvedMethodTargets(),
    val itemHandles: array<int> = [],
    val itemIdentities: array<string> = [],
    val concreteReceivers: BootstrapIrNameTable = bootstrapIrNameTable(16),
    val replayVisited: array<bool> = [],
    // Globals whose initializer a native slice may replay although it reads the environment:
    // an immutable scalar `val` no compile-time code can write (ct_state.ab), so the replay
    // reads the same journaled environment value the evaluator saw.
    val replaySafe: Map<string, bool> = Map()
) {
    fun add(name: string, declaration: int, method: int, handle: int): void {
        this.itemDeclarations.append(declaration)
        this.itemMethods.append(method)
        this.itemNext.append(this.table.find(name, -1))
        this.visited.append(false)
        this.replayVisited.append(false)
        this.itemHandles.append(handle)
        val owner = this.declarations[declaration]
        this.itemIdentities.append(if (!this.methodTargets.enabled) ""
            else if (method < 0) bootstrapResolvedDeclarationIdentity(owner)
            else bootstrapResolvedDeclarationIdentity(owner.methods[method], owner.sourceIdentity))
        this.table.put(name, this.itemDeclarations.size - 1)
    }

    fun exactMethodTarget(source: string, node: BootstrapExpression): int {
        val fact = this.methodTargets.find(source, node)
        if (fact < 0) return -1
        val selected = this.methodTargets.targets[fact]
        if (selected.target < 0 || selected.identity == "") return -1
        // Class receivers have a single static implementation, and an extension function is
        // bound statically whatever its receiver (#828). Interface, generic, unknown and
        // dynamic receivers of a method keep every possible candidate.
        val concrete = this.concreteReceivers.find(selected.receiver, -1) >= 0
        var candidate = this.table.find(node.text, -1)
        while (candidate >= 0) {
            if (this.itemHandles[candidate] == selected.target &&
                this.itemIdentities[candidate] == selected.identity) {
                val owner = this.declarations[this.itemDeclarations[candidate]]
                val extension = this.itemMethods[candidate] < 0 && owner.extensionOwner != ""
                if (!concrete && !extension) return -1
                val declaration = if (this.itemMethods[candidate] < 0) owner
                    else owner.methods[this.itemMethods[candidate]]
                if (declaration.typeParameters.size > 0) return -1
                return selected.target
            }
            candidate = this.itemNext[candidate]
        }
        -1
    }

    // The names in a declaration's signature types (a class named only in a parameter
    // or result type is still part of its program).
    fun pendTypes(
        declaration: BootstrapDeclaration,
        var pending: array<BootstrapExpression>,
        var pendingLibrary: array<bool>,
        var pendingSources: array<string>,
        var pendingReplays: array<string>,
        replay: string,
        library: bool
    ): void {
        // An extension's receiver is a type of it too (a method kept by name brings
        // its class).
        val types: array<string> = [declaration.resultType, declaration.extensionOwner]
        for (type in declaration.parameterTypes) types.append(type)
        // A class brings the interfaces it declares (#813): its conformances are types of it too.
        for (conformance in declaration.conformances) types.append(conformance)
        for (type in types) {
            var begin = 0
            var index = 0
            while (index <= type.size) {
                val byte = if (index < type.size) type[index] else 32
                val word = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
                    (byte >= 48 && byte <= 57) || byte == 95
                if (!word) {
                    if (index > begin) {
                        pending.append(BootstrapExpression(
                            "type", type.slice(begin, index), 0, 0, []
                        ))
                        pendingLibrary.append(library)
                        pendingReplays.append(replay)
                        pendingSources.append(declaration.sourceIdentity)
                    }
                    begin = index + 1
                }
                index = index + 1
            }
        }
        return
    }

    fun reset(): void {
        var item = 0
        while (item < this.visited.size) {
            this.visited[item] = false
            this.replayVisited[item] = false
            item = item + 1
        }
    }

    // The first construct `expression` reaches that the tier cannot run yet, or "".
    fun unsupported(
        expression: BootstrapExpression,
        var globals: array<int>,
        crossTarget: bool = false,
        source: string = ""
    ): string = this.walk(expression, globals, false, false, crossTarget, source)

    // What the runtime's own declarations reach is part of every slice.
    fun keepFrom(expression: BootstrapExpression, source: string = ""): void {
        val unused: array<int> = []
        val ignored = this.walk(expression, unused, true, true, false, source)
        return
    }

    // Walks what `expression` reaches. Code of the standard library never names a
    // program's values, so a library body's identifiers resolve only to library values
    // (a runtime local named like a program global is not that global).
    fun walk(
        expression: BootstrapExpression,
        var globals: array<int>,
        keepOnly: bool,
        fromLibrary: bool,
        crossTarget: bool = false,
        source: string = ""
    ): string {
        val pending: array<BootstrapExpression> = [expression]
        val pendingLibrary: array<bool> = [fromLibrary]
        val pendingSources: array<string> = [source]
        val pendingReplays: array<string> = [""]
        var reason = ""
        while (reason == "" && pending.size > 0) {
            val node = pending[pending.size - 1]
            val library = pendingLibrary[pendingLibrary.size - 1]
            val nodeSource = pendingSources[pendingSources.size - 1]
            val replay = pendingReplays[pendingReplays.size - 1]
            pending.truncate(pending.size - 1)
            pendingLibrary.truncate(pendingLibrary.size - 1)
            pendingSources.truncate(pendingSources.size - 1)
            pendingReplays.truncate(pendingReplays.size - 1)
            if (crossTarget && !bootstrapCtCrossNodeAllowed(node)) {
                return "cross-target site reaches expression ${node.kind} `${node.text}`: not proven portable"
            }
            if (crossTarget && node.kind == "type" && bootstrapTextContains(node.text, "*")) {
                return "cross-target site reaches type ${node.text}: pointer layout is not portable"
            }
            val children = if (crossTarget) bootstrapCtCrossChildren(node) else node.children
            for (child in children) {
                pending.append(child)
                pendingLibrary.append(library)
                pendingReplays.append(replay)
                pendingSources.append(nodeSource)
            }
            val literal = node.kind == "string" || node.kind == "integer" ||
                node.kind == "float" || node.kind == "float32" || node.kind == "char"
            if (!literal && node.text != "") {
                var item = this.table.find(node.text, -1)
                val exactTarget = this.exactMethodTarget(nodeSource, node)
                if (crossTarget && item < 0 &&
                    (node.kind == "call" || node.kind == "member.call") &&
                    !bootstrapCtCrossBuiltin(node)) {
                    return "cross-target site reaches callable `${node.text}`: not proven portable"
                }
                // A call names a value (a global holding a function) when no function
                // or other declaration has that name.
                var callsValue = node.kind == "call"
                var other = item
                while (callsValue && other >= 0) {
                    if (this.itemMethods[other] < 0 && !bootstrapDeclarationIsValue(
                        this.declarations[this.itemDeclarations[other]].kind
                    )) callsValue = false
                    other = this.itemNext[other]
                }
                while (reason == "" && item >= 0) {
                    val owner = this.declarations[this.itemDeclarations[item]]
                    // A value is named by an identifier or an assignment (or a call
                    // nothing else answers); a member of that name is something else.
                    val valueItem = this.itemMethods[item] < 0 &&
                        bootstrapDeclarationIsValue(owner.kind)
                    val ownerLibrary = bootstrapCtLibraryDeclaration(owner)
                    // Only callable/member syntax can denote a method; local
                    // binding/assignment names and bare values cannot. Implicit
                    // receiver members were rewritten before this pass.
                    // A member read (`x.text`) is a field or an extension field: the
                    // type checker resolves it with fieldType or rejects it, a delegated
                    // property reads through getValue and an extension field's default
                    // is __abla_default_<name>. So it never denotes a method or an
                    // extension function of that name (#797: an uncalled
                    // `GpuBytes.text(value)` was reached from a read of Path's `text`).
                    // Both hold for the ordinary slice too: there a name-matched method
                    // kept unrelated declarations (LinuxCommand.output from a local
                    // `output`), and a kept global outside the runtime sent the site to
                    // the interpreter.
                    val function = this.itemMethods[item] >= 0 ||
                        (owner.extensionOwner != "" && (owner.kind == "fun" ||
                         owner.kind == "compile.fun" || owner.kind == "extern"))
                    val bareMethod =
                        (this.itemMethods[item] >= 0 || owner.extensionOwner != "") &&
                        ((node.kind != "call" && node.kind != "member.call" &&
                          node.kind != "member") ||
                         ((node.kind == "member" || node.kind == "call") && function))
                    val selected = exactTarget < 0 || this.itemHandles[item] == exactTarget
                    // Library code never names a program's function or class by a call or a
                    // bare identifier (a local `text` is not the program's `fun text`); only a
                    // member or a type can reach a program's method through an interface.
                    val libraryNamesProgram = library && !ownerLibrary && !valueItem &&
                        (node.kind == "call" || node.kind == "identifier")
                    // A free function is named by a call or as a value (a bare identifier), never
                    // assigned to or read as a member: `stack = ...` is not `fun stack`.
                    val freeFunction = this.itemMethods[item] < 0 && owner.extensionOwner == "" &&
                        (owner.kind == "fun" || owner.kind == "compile.fun" || owner.kind == "extern")
                    val namedAsFunction = !freeFunction || node.kind == "call" ||
                        node.kind == "identifier"
                    val names = selected && !bareMethod && !libraryNamesProgram && namedAsFunction &&
                        (!valueItem ||
                        ((node.kind == "identifier" || node.kind == "assign" || callsValue) &&
                         (!library || ownerLibrary)))
                    // A replayed initializer is a separate proof context: a helper
                    // already proved for a direct call must be checked again here.
                    val nextReplay = if (crossTarget && valueItem && replay == "")
                        owner.name else replay
                    val replaying = crossTarget && nextReplay != ""
                    val alreadyVisited = if (replaying) this.replayVisited[item]
                        else this.visited[item]
                    if (names && !alreadyVisited) {
                        if (replaying) this.replayVisited[item] = true
                        else this.visited[item] = true
                        this.kept[this.itemDeclarations[item]] = true
                        this.pendTypes(owner, pending, pendingLibrary, pendingSources,
                            pendingReplays, nextReplay, ownerLibrary)
                        val declaration = if (this.itemMethods[item] < 0) owner
                            else owner.methods[this.itemMethods[item]]
                        if (crossTarget) {
                            if (replaying && bootstrapCtCrossEnvironment(declaration) &&
                                (this.replaySafe.get(nextReplay) ?? false) != true) {
                                return "cross-target site replays global $nextReplay initializer reaching compilerEnvironment: shared-global replay is not proven equivalent"
                            }
                            reason = bootstrapCtCrossDeclarationReason(declaration, owner)
                            if (reason != "") return reason
                        }
                        var follow = true
                        if (keepOnly) {
                            follow = declaration.kind != "extern"
                        } else if (declaration.kind == "extern" &&
                            ctBridgeRoutesExtern(declaration)) {
                            // Called through the compiler bridge: the slice gets a shim
                            // that runs the interpreter's implementation.
                            val shim = ctBridgeReplacementSource(declaration)
                            if (shim == "") {
                                reason =
                                    "reaches extern:\"${declaration.externalLibrary}\" fun ${declaration.name}, whose types don't cross the compiler bridge"
                            } else if (bootstrapTextContains(shim, "ablaCtBridgeArgFunction(")) {
                                reason =
                                    "reaches extern:\"${declaration.externalLibrary}\" fun ${declaration.name}, which takes a function (not passed through the compiler bridge yet)"
                            }
                            follow = false
                        } else if (bootstrapCompileExitProvider(declaration)) {
                            // The slice's own `exit` (ct_bridge.ab, ctBridgeExitSource)
                            // reaches only the panic hook the slice catches.
                            pending.append(BootstrapExpression(
                                "call", "__ablaPanicContain", 0, 0, []
                            ))
                            pendingLibrary.append(true)
                            pendingReplays.append(nextReplay)
                            pendingSources.append("")
                            follow = false
                        } else if (bootstrapCompileDeclarationProviderEffect(declaration) > 0) {
                            // A capability provider (files, environment,
                            // processes, the clock) is performed by the
                            // evaluator through the compiler bridge: staged,
                            // journaled, checked (ct_native.ab). Natively it
                            // would act on the host directly. Output (print)
                            // needs no capability and stays native.
                            if (ctBridgeSliceSource(declaration) == "") {
                                reason =
                                    "reaches provider ${bootstrapCompileProviderKey(declaration)}, whose types don't cross the compiler bridge"
                            }
                            follow = false
                        } else if (declaration.kind == "compile.val" ||
                                   declaration.kind == "compile.var") {
                            val type = bootstrapNormalizeType(declaration.resultType)
                            val typeReason = bootstrapLiftTypeReasonIn(this.declarations, type)
                            // Native code starts from the value an earlier evaluation
                            // kept: a scalar as its initializer, any other value a
                            // settable global can hold through its setter.
                            val kept = bootstrapCompileGlobalLoad(
                                bootstrapCompileGlobalKey(declaration), this.declarations, []
                            )
                            if (typeReason != "" || type == "void" || type == "null") {
                                reason =
                                    "reaches compile global ${declaration.name} of type ${declaration.resultType}, which native code cannot hand back"
                            } else if (kept.kind != "invalid" &&
                                bootstrapCtLiftScalar(kept, 0, 0).kind == "missing" &&
                                !bootstrapCtSettable(declaration, this.declarations)) {
                                reason =
                                    "reaches compile global ${declaration.name}, which holds a kept ${kept.kind} native code cannot take in yet"
                            } else globals.append(this.itemDeclarations[item])
                        }
                        if (reason == "" && follow) {
                            pending.append(declaration.expression)
                            pendingLibrary.append(ownerLibrary)
                            pendingReplays.append(nextReplay)
                            pendingSources.append(if (declaration.sourceIdentity != "")
                                declaration.sourceIdentity else owner.sourceIdentity)
                            for (parameterDefault in declaration.parameterDefaults) {
                                pending.append(parameterDefault)
                                pendingLibrary.append(ownerLibrary)
                                pendingReplays.append(nextReplay)
                                pendingSources.append(if (declaration.sourceIdentity != "")
                                    declaration.sourceIdentity else owner.sourceIdentity)
                            }
                            if (this.itemMethods[item] >= 0) {
                                // The slice carries the whole class a method belongs
                                // to, so every method of it is reached.
                                pending.append(BootstrapExpression("type", owner.name, 0, 0, []))
                                pendingLibrary.append(ownerLibrary)
                                pendingReplays.append(nextReplay)
                                pendingSources.append(owner.sourceIdentity)
                            } else {
                                for (method in declaration.methods) {
                                    pending.append(method.expression)
                                    pendingLibrary.append(ownerLibrary)
                                    pendingReplays.append(nextReplay)
                                    pendingSources.append(if (method.sourceIdentity != "")
                                        method.sourceIdentity else owner.sourceIdentity)
                                    for (parameterDefault in method.parameterDefaults) {
                                        pending.append(parameterDefault)
                                        pendingLibrary.append(ownerLibrary)
                                        pendingReplays.append(nextReplay)
                                        pendingSources.append(if (method.sourceIdentity != "")
                                            method.sourceIdentity else owner.sourceIdentity)
                                    }
                                }
                            }
                        }
                    }
                    item = this.itemNext[item]
                }
            }
        }
        reason
    }
}

// --- the auto tier's cost rule -------------------------------------------------

// A construct whose work the code's size doesn't bound: a loop, a lambda (a local function
// can call itself through one), an atomic block (it retries), or a call through a value. And a
// call through a C function pointer the interpreter can't make (only three typed calls are
// ctNativeIntrinsic): code that reaches C libraries by dlsym and calls them with
// `ablaUnsafeCallExact_*` (a game engine's window and GPU, #1022) failed in the interpreter when
// it held no loop.
fun bootstrapCtLongNode(node: BootstrapExpression): bool {
    val kind = node.kind
    kind == "while" || kind == "do.while" || kind == "for" || kind == "lambda" ||
        kind == "lambda.move" || kind == "atomic" || kind == "stm.orElse" || kind == "call.value" ||
        (kind == "call" && node.text.startsWith("ablaUnsafeCall") && !ctNativeIntrinsic(node.text))
}

// Scans `expression`: true when it holds a long construct, else the names it mentions are
// appended to `names`.
fun bootstrapCtScanBody(expression: BootstrapExpression, var names: array<string>): bool {
    val pending: array<BootstrapExpression> = [expression]
    while (pending.size > 0) {
        val node = pending[pending.size - 1]
        pending.truncate(pending.size - 1)
        if (bootstrapCtLongNode(node)) return true
        val literal = node.kind == "string" || node.kind == "integer" ||
            node.kind == "float" || node.kind == "float32" || node.kind == "char"
        if (!literal && node.text != "") names.append(node.text)
        for (child in node.children) pending.append(child)
    }
    false
}

// Whether a site can run long (the work under ABLA_COMPILE_EVAL=auto that pays for a native
// generation): what its walk just visited (reach.visited, after reach.unsupported) or the site
// itself holds a long construct (bootstrapCtLongNode), or the visited declarations call each
// other in a cycle (recursion). Otherwise the interpreter's steps are bounded by the size of the
// code the site reaches. A class's methods count for loops (an operator or an implicit call can
// reach one no name names) but give no call edges: a method called by name is visited itself.
fun bootstrapCtMayRunLong(reach: BootstrapCtReach, expression: BootstrapExpression): bool {
    val unused: array<string> = []
    if (bootstrapCtScanBody(expression, unused)) return true
    // Each visited item's outgoing edges, as the visited items its body names.
    val nodes: array<int> = []
    val position: array<int> = []
    var item = 0
    while (item < reach.visited.size) {
        position.append(-1)
        if (reach.visited[item]) {
            position[item] = nodes.size
            nodes.append(item)
        }
        item = item + 1
    }
    // A node's edges are edgeTo[edgeStart[node] until edgeStart[node + 1]].
    val edgeStart: array<int> = []
    val edgeTo: array<int> = []
    val indegree: array<int> = []
    for (node in nodes) indegree.append(0)
    var index = 0
    while (index < nodes.size) {
        edgeStart.append(edgeTo.size)
        val visitedItem = nodes[index]
        val owner = reach.declarations[reach.itemDeclarations[visitedItem]]
        val method = reach.itemMethods[visitedItem]
        val declaration = if (method < 0) owner else owner.methods[method]
        val names: array<string> = []
        if (bootstrapCtScanBody(declaration.expression, names)) return true
        for (parameterDefault in declaration.parameterDefaults) {
            if (bootstrapCtScanBody(parameterDefault, names)) return true
        }
        if (method < 0) {
            for (member in declaration.methods) {
                val ignored: array<string> = []
                if (bootstrapCtScanBody(member.expression, ignored)) return true
            }
        }
        for (name in names) {
            var target = reach.table.find(name, -1)
            while (target >= 0) {
                if (reach.visited[target]) {
                    edgeTo.append(position[target])
                    indegree[position[target]] = indegree[position[target]] + 1
                }
                target = reach.itemNext[target]
            }
        }
        index = index + 1
    }
    edgeStart.append(edgeTo.size)
    // Kahn's order: a node left with an incoming edge lies on (or after) a cycle.
    val ready: array<int> = []
    index = 0
    while (index < nodes.size) {
        if (indegree[index] == 0) ready.append(index)
        index = index + 1
    }
    var removed = 0
    while (ready.size > 0) {
        val node = ready[ready.size - 1]
        ready.truncate(ready.size - 1)
        removed = removed + 1
        var edge = edgeStart[node]
        while (edge < edgeStart[node + 1]) {
            indegree[edgeTo[edge]] = indegree[edgeTo[edge]] - 1
            if (indegree[edgeTo[edge]] == 0) ready.append(edgeTo[edge])
            edge = edge + 1
        }
    }
    removed < nodes.size
}

// `expression` with each `#e` as `e`: inside compile-time code, compile-time code
// runs where it stands.
fun bootstrapCtWithoutCompileNodes(expression: BootstrapExpression): BootstrapExpression {
    if (expression.kind == "compile" && expression.children.size == 1) {
        return bootstrapCtWithoutCompileNodes(expression.children[0])
    }
    if (!bootstrapCtHasCompileNode(expression)) return expression
    val children: array<BootstrapExpression> = []
    for (child in expression.children) children.append(bootstrapCtWithoutCompileNodes(child))
    BootstrapExpression(expression.kind, expression.text, expression.begin, expression.end,
        children)
}

fun bootstrapCtHasCompileNode(expression: BootstrapExpression): bool {
    if (expression.kind == "compile") return true
    for (child in expression.children) {
        if (bootstrapCtHasCompileNode(child)) return true
    }
    false
}

// A declaration of the standard library in use: a module under its root, the one every
// other root test uses (ABLA_STDLIB, else the toolchain root's stdlib, lexically
// normalized). A bare compiler without ABLA_SYSROOT has the relative root "stdlib", and
// its modules are "stdlib/..." with no leading slash: matching "/stdlib/abla/" anywhere
// in the identity then found no library declaration at all, and a compile-time global
// initializer ran twice (#810).
fun bootstrapCtLibraryDeclaration(declaration: BootstrapDeclaration): bool =
    declaration.sourceIdentity.startsWith("${bootstrapCompileProviderStandardLibrary()}/")

// The value runtime's own modules: every slice carries them whole.
// Whether the slice replaces `declaration` with its bridge shim: the compiler API
// externs, the opaque compiler classes and ablaAtCompileTime. (`ablaHost*` functions
// with bodies of their own stay as they are.)
fun bootstrapCtBridged(declaration: BootstrapDeclaration): bool =
    declaration.kind == "extern" || declaration.kind == "class" ||
        declaration.name == "ablaAtCompileTime" ||
        bootstrapCompileDeclarationProviderEffect(declaration) > 0 ||
        bootstrapCompileExitProvider(declaration)

// The trusted helpers bridge shims call (abla/compiler/bridge), with what they reach
// kept in the slice; none when they can't be read, or when the program imports the
// module and so has them already (kept here).
fun bootstrapCtBridgeImported(parsed: BootstrapParseResult): bool {
    for (declaration in parsed.declarations) {
        if (bootstrapTextContains(declaration.sourceIdentity, "/abla/compiler/bridge/")) {
            return true
        }
    }
    false
}

fun bootstrapCtBridgeHelpers(
    parsed: BootstrapParseResult,
    var reach: BootstrapCtReach
): array<BootstrapDeclaration> {
    var index = 0
    while (index < parsed.declarations.size) {
        if (bootstrapTextContains(parsed.declarations[index].sourceIdentity,
            "/abla/compiler/bridge/")) {
            reach.kept[index] = true
            reach.keepFrom(parsed.declarations[index].expression)
        }
        index = index + 1
    }
    if (bootstrapCtBridgeImported(parsed)) return []
    val path = "${bootstrapCompileProviderStandardLibrary()}/abla/compiler/bridge/entry.ab"
    val text = Path(path).readText()
    if (text == "") return []
    val helpers = bootstrapParseWithIdentity(text, path)
    if (helpers.errors > 0) return []
    val result: array<BootstrapDeclaration> = []
    for (declaration in helpers.declarations) {
        reach.keepFrom(declaration.expression)
        result.append(declaration)
    }
    result
}

fun bootstrapCtRuntimeDeclaration(declaration: BootstrapDeclaration): bool =
    bootstrapTextContains(declaration.sourceIdentity, "/abla/runtime/") ||
    // An extension field and its default function: reads and writes lower
    // through both, though no call in the source names the function.
    bootstrapIsExtensionFieldKind(declaration.kind) ||
    (declaration.kind == "fun" && declaration.extensionOwner != "" &&
     declaration.name.startsWith(bootstrapExtensionFieldDefaultName("")))

fun bootstrapCtReach(declarations: array<BootstrapDeclaration>,
    methodTargets: BootstrapResolvedMethodTargets =
    bootstrapResolvedMethodTargets()): BootstrapCtReach {
    var count = declarations.size
    for (declaration in declarations) count = count + declaration.methods.size
    val kept: array<bool> = []
    for (declaration in declarations) kept.append(false)
    val reach = BootstrapCtReach(
        declarations, bootstrapIrNameTable(count), [], [], [], [], kept, methodTargets,
        [], [], bootstrapIrNameTable(declarations.size + 5)
    )
    for (type in ["string", "i64", "bool", "f32", "f64"]) reach.concreteReceivers.put(type, 1)
    for (declaration in declarations) {
        if (declaration.kind == "class" && declaration.typeParameters.size == 0) {
            reach.concreteReceivers.put(declaration.name, 1)
        }
    }
    var index = 0
    var handle = declarations.size
    while (index < declarations.size) {
        reach.add(declarations[index].name, index, -1, index)
        var method = 0
        while (method < declarations[index].methods.size) {
            reach.add(declarations[index].methods[method].name, index, method, handle)
            handle += 1
            method = method + 1
        }
        index = index + 1
    }
    reach
}

// --- the slice -----------------------------------------------------------------

// The generation's support: the empty reply of an entry that only runs its site,
// the free entry, and the value codec's encoder (ct_lift.ab), which every value
// entry and global getter calls: it walks the runtime's value, whatever its type.
fun bootstrapCtSupportSource(generation: int, declarations: array<BootstrapDeclaration>): string {
    val g = "$generation"
    bootstrapCtLiftEncoder("i64", declarations, g).source +
    bootstrapCtSetterSupport(g, declarations) +
    "trusted fun __abla_ct_reply_$g(bytes: string): int {\n" +
    // A manual block, as the encoder's reply (ct_lift.ab, bootstrapCtLiftEncoder): only an int holds it.
    "    val address = __ablaRuntimeAllocateLayout(bytes.size + 8, 10)\n" +
    "    ablaRuntimeStoreI64(address, bytes.size)\n" +
    "    var index = 0\n" +
    "    while (index < bytes.size) {\n" +
    "        ablaRuntimeStoreU8(address + 8 + index, bytes[index])\n" +
    "        index = index + 1\n" +
    "    }\n" +
    "    address\n" +
    "}\n" +
    "@export(\"abla_ct_free_$g\")\n" +
    "trusted fun __abla_ct_free_$g(address: int): int {\n" +
    "    __ablaRuntimeFree(address)\n" +
    "    0\n" +
    "}\n"
}

// What setters use: a string made from bytes the compiler wrote, and the
// intrinsics that need, unless `declarations` (what the slice keeps) has them.
fun bootstrapCtSetterSupport(g: string, declarations: array<BootstrapDeclaration>): string {
    var intrinsics = ""
    if (!bootstrapCtDeclares(declarations, "ablaUnsafeAdoptString")) {
        intrinsics =
            "${intrinsics}trusted noescape extern:\"intrinsic\" fun ablaUnsafeAdoptString(address: i64*, length: int): string\n"
    }
    if (!bootstrapCtDeclares(declarations, "ablaBitI64ToF64")) {
        intrinsics =
            "${intrinsics}noescape extern:\"intrinsic\" fun ablaBitI64ToF64(value: int): f64\n"
    }
    "$intrinsics" +
    // (The setters are ordinary compile code: their raw reads go through here.)
    "trusted fun __abla_ct_word_$g(address: int): int = ablaRuntimeLoadI64(address)\n" +
    "trusted fun __abla_ct_text_$g(address: int, size: int): string {\n" +
    "    val data = __ablaRuntimeAllocateLayout(size + 1, 1)\n" +
    "    var index = 0\n" +
    "    while (index < size) {\n" +
    "        ablaRuntimeStoreU8(data + index, ablaRuntimeLoadU8(address + index))\n" +
    "        index = index + 1\n" +
    "    }\n" +
    "    ablaRuntimeStoreU8(data + size, 0)\n" +
    "    ablaUnsafeAdoptString(ablaRuntimePointerFromAddress(data), size)\n" +
    "}\n"
}

fun bootstrapCtDeclares(declarations: array<BootstrapDeclaration>, name: string): bool {
    for (declaration in declarations) {
        if (declaration.name == name) return true
    }
    false
}

fun bootstrapCtEntrySource(site: BootstrapCtSite, generation: int): string {
    val id = "${site.id}"
    val header = "@export(\"abla_ct_eval_$id\")\ncompile fun __abla_ct_eval_$id(): int"
    if (!site.encodes) {
        "$header {\n    __abla_ct_site_$id()\n    __abla_ct_reply_$generation(\"\")\n}\n"
    } else if (site.once) {
        "$header =\n    __abla_lift_reply_$generation(__abla_ct_once_get_$id())\n${bootstrapCtOnceSource(site)}"
    } else {
        "$header =\n    __abla_lift_reply_$generation(__abla_ct_site_$id())\n"
    }
}

// A site the slice keeps the `#` node of has one value for the build, as everywhere (docs/compile-time.md): the slice
// lowers the node (a kept global's initializer, a function's body) as a call of this accessor, and the site's entry
// calls it too, so the site's code runs once, whichever gets there first. `val shot = #ctShot()` ran the game client's
// whole offscreen run when the slice initialized its globals and again at its site (#1022). The cell is an array so
// any type, nullable ones too, has an empty state.
fun bootstrapCtOnceSource(site: BootstrapCtSite): string {
    val id = "${site.id}"
    "val __abla_ct_once_$id: array<${site.type}> = []\n" +
    "compile fun __abla_ct_once_get_$id(): ${site.type} {\n" +
    "    if (__abla_ct_once_$id.size == 0) __abla_ct_once_$id.append(__abla_ct_site_$id())\n" +
    "    __abla_ct_once_$id[0]\n" +
    "}\n"
}

// Whether a site can be a once site: one that runs natively and gives a value. (Its own `encodes` is set while the
// sites are prepared, so a later site's isn't yet: this asks its type.)
fun bootstrapCtOnceCandidate(site: BootstrapCtSite): bool =
    site.reason == "" && !site.action && site.type != "void" && site.type != "null" && site.type != "unknown"

// Marks the sites whose `#` nodes `expression` (a kept declaration's, in `sourceIdentity`) holds (BootstrapCtSite.once).
// (A `#` nested in another is part of that site: bootstrapCtCollectNodes.)
fun bootstrapCtMarkOnce(expression: BootstrapExpression, sourceIdentity: string): void {
    if (expression.kind == "compile") {
        for (site in bootstrapCtSites) {
            if (bootstrapCtOnceCandidate(site) && site.sourceIdentity == sourceIdentity &&
                site.node.begin == expression.begin && site.node.end == expression.end) site.once = true
        }
        return
    }
    for (child in expression.children) bootstrapCtMarkOnce(child, sourceIdentity)
    return
}

// `expression` with the code of each `#` node of a once site replaced by a call of its accessor (bootstrapCtOnceSource), at
// template positions so its facts meet no source node's; the same node where there is none.
fun bootstrapCtOnceRewrite(expression: BootstrapExpression, sourceIdentity: string): BootstrapExpression {
    if (expression.kind == "compile") {
        for (site in bootstrapCtSites) {
            if (site.once && site.sourceIdentity == sourceIdentity &&
                site.node.begin == expression.begin && site.node.end == expression.end) {
                // (Still a `#` node: only compile-time code may call the accessor, a compile fun, and the slice
                // lowers the node's code as it stands, bootstrapLowerCompile.)
                return BootstrapExpression("compile", expression.text, expression.begin, expression.end, [
                    BootstrapExpression("call", "__abla_ct_once_get_${site.id}",
                        expression.begin + BOOTSTRAP_CT_TEMPLATE_OFFSET, expression.end + BOOTSTRAP_CT_TEMPLATE_OFFSET, [])
                ])
            }
        }
        return expression
    }
    if (!bootstrapCtHasCompileNode(expression)) return expression
    val children: array<BootstrapExpression> = []
    for (child in expression.children) children.append(bootstrapCtOnceRewrite(child, sourceIdentity))
    BootstrapExpression(expression.kind, expression.text, expression.begin, expression.end, children)
}

// Whether `expression` holds a `#` node no site of the pass can run natively (no site for it, or one that runs in the
// evaluator): the slice would lower that node as its code and run it again (bootstrapCtOnceSource covers the rest).
fun bootstrapCtUnheldCompileNode(expression: BootstrapExpression, sourceIdentity: string): bool {
    if (expression.kind == "compile") {
        var held = false
        for (site in bootstrapCtSites) {
            if (bootstrapCtOnceCandidate(site) && site.sourceIdentity == sourceIdentity &&
                site.node.begin == expression.begin && site.node.end == expression.end) held = true
        }
        return !held
    }
    for (child in expression.children) {
        if (bootstrapCtUnheldCompileNode(child, sourceIdentity)) return true
    }
    false
}

// Template positions move far past any source offset (still below 2^32, which
// positions pack the file index above), so position-keyed analysis facts of the
// spliced site expression never meet a template node's.
val BOOTSTRAP_CT_TEMPLATE_OFFSET = 2147483648

/** Up to this many functions a slice is optimized with the --o1 pipeline (llvmPassesBalanced), above it with the fast one. */
val BOOTSTRAP_CT_BALANCED_SLICE_FUNCTIONS = 700

/** The IR pipeline of a slice of `functions` functions. Compile-time code that works hard (a loop over bytes: tests/cases/modules/
 *  json-ascii-spans) runs several times faster optimized, and a small slice (the usual one: 450 functions, 1 s of code generation)
 *  pays about 15% for it: that program's `#` build took 122 s with the fast pipeline and 21 s with this one. A large slice
 *  (a TLS stack: 1,387 functions) pays twice, 3.6 s to 7.7 s of code generation, so keeps the fast one.
 *  `ABLA_COMPILE_EVAL_PASSES=fast|balanced` chooses for every slice. */
fun bootstrapCtSlicePasses(functions: int): string {
    val chosen = linuxEnvironment("ABLA_COMPILE_EVAL_PASSES")
    if (chosen.found && chosen.value == "fast") return llvmPassesFast()
    if (chosen.found && chosen.value == "balanced") return llvmPassesBalanced()
    if (functions <= BOOTSTRAP_CT_BALANCED_SLICE_FUNCTIONS) llvmPassesBalanced() else llvmPassesFast()
}

fun bootstrapCtSplice(
    node: BootstrapExpression,
    placeholder: string,
    replacement: BootstrapExpression
): BootstrapExpression {
    if (node.kind == "call" && node.text == placeholder &&
        node.children.size == 0) return replacement
    val children: array<BootstrapExpression> = []
    for (child in node.children) {
        children.append(bootstrapCtSplice(child, placeholder, replacement))
    }
    BootstrapExpression(
        node.kind, node.text,
        node.begin + BOOTSTRAP_CT_TEMPLATE_OFFSET,
        node.end + BOOTSTRAP_CT_TEMPLATE_OFFSET,
        children
    )
}

fun bootstrapCtDeclarationWith(
    declaration: BootstrapDeclaration,
    kind: string,
    expression: BootstrapExpression,
    shift: int,
    sourceIdentity: string
): BootstrapDeclaration = BootstrapDeclaration(
    kind,
    declaration.name,
    declaration.begin + shift,
    declaration.end + shift,
    expression,
    declaration.parameters,
    declaration.parameterTypes,
    declaration.resultType,
    declaration.methods,
    declaration.parameterDefaults,
    declaration.externalLibrary,
    declaration.parameterKinds,
    declaration.extensionOwner,
    declaration.isTrusted,
    declaration.isResource,
    declaration.isNoEscape,
    declaration.generatedNamespace,
    declaration.generatedOriginBegin,
    declaration.generatedOriginEnd,
    declaration.annotations,
    declaration.annotationArguments,
    declaration.annotationBegins,
    declaration.annotationEnds,
    sourceIdentity,
    declaration.conformances,
    declaration.isSealed,
    declaration.isPrivate
)

fun bootstrapCtGlobalSource(index: int, generation: int): string =
    "@export(\"abla_ct_global_${generation}_$index\")\ncompile fun __abla_ct_global_${generation}_$index(): int =\n    __abla_lift_reply_$generation(__abla_ct_value_$index())\n"

// A delegated global's binding kind ("val" or "var"), "" for any other.
fun bootstrapCtDelegateKind(declaration: BootstrapDeclaration): string =
    if (declaration.expression.kind == "delegate.initializer") declaration.expression.text
    else ""

fun bootstrapCtStateHas(values: array<int>, wanted: int): bool {
    for (value in values) {
        if (value == wanted) return true
    }
    false
}

// An ordinary global's type: the declared one, or a literal initializer's (`var failures = 0`), or a non-generic
// class constructor's (`val box = Box(1)`); "" when none says.
fun bootstrapCtOrdinaryTypeIn(
    declarations: array<BootstrapDeclaration>,
    declaration: BootstrapDeclaration,
    depth: int = 0
): string {
    val simple = bootstrapCtOrdinaryType(declaration)
    if (simple != "") return simple
    var initializer = declaration.expression
    // Another global's value (abla-forge's `var uiNextFieldAlign = ALIGN_LEFT`, the client's
    // `var combatTarget = NO_TARGET`): that global's type, when one plain val or var has the name.
    if (initializer.kind == "identifier") {
        if (depth >= 8) return ""
        var found: BootstrapDeclaration? = null
        var named = 0
        for (other in declarations) {
            if (other.name == initializer.text) {
                named = named + 1
                found = other
            }
        }
        val target = found
        if (named != 1 || target == null || (target.kind != "val" && target.kind != "var")) return ""
        return bootstrapCtOrdinaryTypeIn(declarations, target, depth + 1)
    }
    // A call that leaves defaults out is a block by now: a local for each default, then the call
    // (named_arguments.ab). abla-forge's `val nativeWindow = NativeWindow(...)` (two defaulted
    // fields) wasn't typed, so a site that wrote it ran in the interpreter (#1022).
    if (initializer.kind == "block" && initializer.children.size > 0) {
        initializer = initializer.children[initializer.children.size - 1]
    }
    if (initializer.kind != "call" || initializer.text == "") return ""
    var classes = 0
    var named = 0
    var returned = ""
    for (other in declarations) {
        if (other.name == initializer.text) {
            named = named + 1
            if (other.kind == "class" && other.typeParameters.size == 0) classes = classes + 1
            // A non-generic function's declared result (`var bootstrapGenericMethods = bootstrapStringSet()`).
            if (other.kind == "fun" && other.extensionOwner == "" && other.typeParameters.size == 0) {
                val result = bootstrapNormalizeType(other.resultType)
                if (result != "inferred") returned = result
            }
        }
    }
    if (named != 1) "" else if (classes == 1) initializer.text else returned
}

fun bootstrapCtOrdinaryType(declaration: BootstrapDeclaration): string {
    val declared = bootstrapNormalizeType(declaration.resultType)
    if (declared != "" && declared != "inferred") return declared
    bootstrapCtLiteralType(declaration.expression)
}

// The type of a literal initializer: a bool, a string or template, a number (bootstrapCtLiteralNumberType), or an
// array literal whose elements all have one such type (abla-forge's `val __LENGTH_EXTRA = [0, 0, 1, ...]`) or that
// names its element type; "" otherwise (an empty `[]` names none).
fun bootstrapCtLiteralType(expression: BootstrapExpression): string {
    val kind = expression.kind
    if (kind == "true" || kind == "false") return "bool"
    if (kind == "string" || kind == "string.template") return "string"
    if (kind == "array") {
        if (expression.text != "") return bootstrapNormalizeType(expression.text)
        if (expression.children.size == 0) return ""
        val element = bootstrapCtLiteralType(expression.children[0])
        if (element == "") return ""
        for (child in expression.children) {
            if (bootstrapCtLiteralType(child) != element) return ""
        }
        return bootstrapNormalizeType("array<$element>")
    }
    bootstrapCtLiteralNumberType(expression)
}

// "int" or "f64" for a decimal integer or float literal, or arithmetic over literals of one kind (abla-forge's
// `var vkxTimerPeriod = 0.0`, `-2.0`, `0 - 1`); "" otherwise. A float literal with no declared type is an f64
// (f32_literal.ab).
fun bootstrapCtLiteralNumberType(expression: BootstrapExpression): string {
    val kind = expression.kind
    if (kind == "float") return "f64"
    if (kind == "integer") {
        if (expression.text.size == 0) return ""
        for (byte in expression.text) {
            if (byte < 48 || byte > 57) return ""
        }
        return "int"
    }
    if ((kind == "unary-" || kind == "unary+") && expression.children.size == 1) {
        return bootstrapCtLiteralNumberType(expression.children[0])
    }
    if ((kind == "+" || kind == "-" || kind == "*" || kind == "/" || kind == "%") && expression.children.size == 2) {
        val left = bootstrapCtLiteralNumberType(expression.children[0])
        return if (left != "" && left == bootstrapCtLiteralNumberType(expression.children[1])) left else ""
    }
    ""
}

// Why a written ordinary global can't be owned by the native tier for a pass, "" when it can. The generation's copy
// starts from the initializer, so the interpreter's journal must hold no value of it yet (an earlier pass's would be
// lost); its value goes back to the journal after every native call, so its type must be one the lift carries back,
// and hold no closure (the journal keeps none: bootstrapCompileGlobalEncode) unless one of the pass's `sites` alone
// reaches it. Delegated globals keep their delegate in the interpreter.
fun bootstrapCtOwnableReason(
    declarations: array<BootstrapDeclaration>,
    index: int,
    edits: bool,
    sites: int
): string {
    val declaration = declarations[index]
    if (declaration.kind != "val" && declaration.kind != "var") return "not a plain val or var"
    if (bootstrapCtDelegateKind(declaration) != "") {
        // A TVar-delegated global (`var cache: T by TVar(...)`): the interpreter keeps no TVar between evaluations
        // (each starts it afresh), so its journal never holds one, and the generation's TVar is the one value for
        // the pass. Nothing goes back to the journal (bootstrapCtTVarDelegate). Other delegates stay interpreted.
        return if (bootstrapCtTVarDelegate(declaration)) "" else
            "a delegated global (by ${bootstrapCtDelegateText(declaration)})"
    }
    val type = bootstrapCtOrdinaryTypeIn(declarations, declaration)
    if (type == "") return "its type is not written out"
    if (type == "void" || type == "null") return "of type $type"
    // A global whose value may hold resources (abla/tls/pure's `pureTlsHandleTable: array<TlsConnection>`) isn't
    // handed back, and needn't be: the interpreter keeps no such value between evaluations (a resource is acquired
    // and released by the code that runs). Like a TVar it is the generation's for the pass (bootstrapCtUnexchanged),
    // so neither a value native code can't describe nor a closure in it stops it, unless this pass edits
    // declarations: a native closure made before an edit would run the edited body. So is a raw pointer (the
    // compiler's own `bootstrapLlvmHeldContext: i64*`: the interpreter has no raw memory, so it can neither make one
    // nor do anything with one), and a value that always holds a closure, which the journal never keeps
    // (bootstrapCtGenerationOnly).
    val holdsResource = bootstrapCtGenerationOnly(declarations, type)
    val typeReason = bootstrapLiftTypeReasonIn(declarations, type)
    if (typeReason != "" && !holdsResource) return "of type $type, which native code cannot hand back: $typeReason"
    // A value one site alone reaches (abla-forge's `engineApp: App`, whose schedules hold the systems) may hold
    // closures: the site's one evaluation starts from the initializer in either tier, no other site of the pass reads
    // what it leaves, and what goes back to the journal after it is kept only if it holds no closure, as the
    // interpreter's own value would be (#1022). With two sites the second would read the first's closures from the
    // generation's copy; that stays declined.
    if ((!holdsResource || edits) && (edits || sites > 1) && bootstrapCtStateMayHoldClosure(declarations, type))
        return if (edits) "of type $type, which may hold a closure" else
            "of type $type, which may hold a closure, and $sites sites reach it"
    val kept = bootstrapCompileGlobalLoad(bootstrapCompileGlobalKey(declaration), declarations, [])
    if (kept.kind != "invalid") return "an earlier evaluation kept a value of it"
    ""
}

// Whether a value of `type` may hold an instance of a resource class (directly, in an array, map, nullable or shared
// wrapper, or in a field of a class it holds), or of a resource interface. Each class is searched once (a class that
// refers to itself, or two that refer to each other, add nothing the first visit did not), so the answer is exact: a
// resource at any depth is found. (A depth cap that answered "no" at 6 took a resource held seven fields down for
// plain data.)
fun bootstrapCtMayHoldResource(declarations: array<BootstrapDeclaration>, type: string): bool {
    val indexed = bootstrapCtTypeIndexFor(declarations)
    if (indexed) {
        val known = bootstrapCtResourceAnswers.get(type)
        if (known != null) return known
    }
    var visited: array<string> = []
    val answer = bootstrapCtMayHoldResourceIn(declarations, type, visited)
    if (indexed) bootstrapCtResourceAnswers.set(type, answer)
    answer
}

// While bootstrapCtPrepare runs, the classes and interfaces of its declarations by name, and what
// bootstrapCtMayHoldResource answered for each type: it asks for every written global (bootstrapCtOwnableReason,
// bootstrapCtUnexchanged), and each question searched all the declarations per name (#1022: 20% of the client's
// slice analysis). Any other declarations, or none while no pass is prepared, are searched as before.
var bootstrapCtTypeIndexDeclarations: array<BootstrapDeclaration> = []
var bootstrapCtTypeIndexByName: Map<string, array<int>> = Map()
var bootstrapCtResourceAnswers: Map<string, bool> = Map()

fun bootstrapCtTypeIndexBegin(declarations: array<BootstrapDeclaration>): void {
    bootstrapCtTypeIndexDeclarations = declarations
    bootstrapCtTypeIndexByName = Map()
    bootstrapCtResourceAnswers = Map()
    var index = 0
    while (index < declarations.size) {
        val declaration = declarations[index]
        if (declaration.kind == "class" || declaration.kind == "interface") {
            val list = bootstrapCtTypeIndexByName.get(declaration.name) ?? []
            list.append(index)
            bootstrapCtTypeIndexByName.set(declaration.name, list)
        }
        index = index + 1
    }
    return
}

fun bootstrapCtTypeIndexEnd(): void {
    bootstrapCtTypeIndexDeclarations = []
    bootstrapCtTypeIndexByName = Map()
    bootstrapCtResourceAnswers = Map()
    return
}

fun bootstrapCtTypeIndexFor(declarations: array<BootstrapDeclaration>): bool =
    declarations.size > 0 && declarations == bootstrapCtTypeIndexDeclarations
// (`seen` holds the names of the classes and interfaces searched; an array, since a chain is a handful of classes and
// most calls name none, so most calls allocate nothing.)
fun bootstrapCtMayHoldResourceIn(
    declarations: array<BootstrapDeclaration>,
    type: string,
    var seen: array<string>
): bool {
    val normalized = bootstrapNormalizeType(type)
    var begin = 0
    var index = 0
    while (index <= normalized.size) {
        val byte = if (index < normalized.size) normalized[index] else 32
        val word = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            byte == 95
        if (!word) {
            if (index > begin) {
                val name = normalized.slice(begin, index)
                var known = false
                for (searched in seen) {
                    if (searched == name) known = true
                }
                if (!known) {
                    var recorded = false
                    val candidates: array<BootstrapDeclaration> = []
                    if (bootstrapCtTypeIndexFor(declarations)) {
                        for (found in bootstrapCtTypeIndexByName.get(name) ?? []) candidates.append(declarations[found])
                    }
                    for (declaration in if (bootstrapCtTypeIndexFor(declarations)) candidates else declarations) {
                        if (declaration.name == name && (declaration.kind == "class" || declaration.kind == "interface")) {
                            if (!recorded) {
                                recorded = true
                                seen.append(name)
                            }
                            if (declaration.isResource) return true
                            if (declaration.kind == "class") {
                                for (field in declaration.parameterTypes) {
                                    if (bootstrapCtMayHoldResourceIn(declarations, field, seen)) return true
                                }
                            }
                        }
                    }
                }
            }
            begin = index + 1
        }
        index = index + 1
    }
    false
}

// An owned global that stays the generation's alone for the pass: a TVar delegate, a global whose value holds
// resources, a raw pointer or a closure (bootstrapCtGenerationOnly). The interpreter keeps none of them between evaluations, so nothing goes back to the journal after a native
// call (the others do: bootstrapCtFetchPending).
fun bootstrapCtUnexchanged(declarations: array<BootstrapDeclaration>, index: int): bool {
    val declaration = declarations[index]
    if (bootstrapCtTVarDelegate(declaration)) return true
    if (bootstrapCtDelegateKind(declaration) != "") return false
    val type = bootstrapCtOrdinaryTypeIn(declarations, declaration)
    type != "" && bootstrapCtGenerationOnly(declarations, type)
}

// Whether a global's type is a raw pointer (`i64*`, `u8*`): it addresses memory of the process that made it, so
// it never goes back to the interpreter's journal, which can't hold one anyway (the interpreter has no raw memory).
fun bootstrapCtRawPointer(type: string): bool {
    val normalized = bootstrapNormalizeType(type)
    normalized.size > 1 && normalized[normalized.size - 1] == 42
}

// Whether every value of `type` holds a closure: a function type, or a class with a field that always does (the
// compiler's `bootstrapStrictVisibilityTable: BootstrapStrictVisibility`, whose importFor is a lambda). The
// interpreter's journal keeps no such value (bootstrapCompileGlobalEncode: data only), so each evaluation makes it
// afresh; nothing would go back to it after a native call either. (A nullable, generic or interface type, an
// array or map, may hold none: bootstrapCtStateMayHoldClosure.)
fun bootstrapCtAlwaysHoldsClosure(declarations: array<BootstrapDeclaration>, type: string): bool {
    var seen: Map<string, bool> = Map()
    bootstrapCtAlwaysHoldsClosureIn(declarations, type, seen)
}

fun bootstrapCtAlwaysHoldsClosureIn(
    declarations: array<BootstrapDeclaration>,
    type: string,
    var seen: Map<string, bool>
): bool {
    val normalized = bootstrapNormalizeType(type)
    if (normalized == "") return false
    // bootstrapNormalizeType spells a function type `function:(…)->R`, with `once:`, `mut:` or `noescape:` before
    // it for those families, and a nullable one `nullable:…`.
    for (prefix in ["function:", "once:", "mut:", "noescape:"]) {
        if (normalized.size > prefix.size && normalized.slice(0, prefix.size) == prefix) return true
    }
    for (byte in normalized) {
        val word = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            byte == 95
        if (!word) return false
    }
    if (seen.get(normalized) ?? false) return false
    seen.set(normalized, true)
    var found: BootstrapDeclaration? = null
    var named = 0
    for (declaration in declarations) {
        if (declaration.name == normalized) {
            named = named + 1
            found = declaration
        }
    }
    val declaration = found
    if (named != 1 || declaration == null || declaration.kind != "class" ||
        declaration.typeParameters.size != 0) return false
    for (field in declaration.parameterTypes) {
        if (bootstrapCtAlwaysHoldsClosureIn(declarations, field, seen)) return true
    }
    false
}

// A global the generation keeps alone for the pass, handing nothing back to the interpreter's journal, which keeps
// no value of it between evaluations anyway: one that may hold resources, a raw pointer, or one that always holds a
// closure (bootstrapCtOwnableReason, bootstrapCtUnexchanged).
fun bootstrapCtGenerationOnly(declarations: array<BootstrapDeclaration>, type: string): bool =
    bootstrapCtMayHoldResource(declarations, type) || bootstrapCtRawPointer(type) ||
        bootstrapCtAlwaysHoldsClosure(declarations, type)

// A `compile var` of a settable type whose name no other declaration has: a value
// the evaluator gives it goes back into the generation's copy through its setter.
// (Assigning a delegated one would call its setValue, not replace its delegate.)
fun bootstrapCtSettable(
    declaration: BootstrapDeclaration,
    declarations: array<BootstrapDeclaration>
): bool {
    if (declaration.kind != "compile.var" || bootstrapCtDelegateKind(declaration) !=
        "") return false
    if (bootstrapCtSetterKind(bootstrapNormalizeType(declaration.resultType)) == "") return false
    var named = 0
    for (other in declarations) {
        if (other.name == declaration.name) named = named + 1
    }
    named == 1
}

// One value read from the setter's buffer at `at` (advanced past it), as source.
fun bootstrapCtSetterRead(kind: string, generation: int): string {
    val word = "__abla_ct_word_$generation(at)"
    if (kind == "string") "__abla_ct_text_$generation(at + 8, $word)"
    else if (kind == "f64") "ablaBitI64ToF64($word)"
    else if (kind == "bool") "$word != 0"
    else word
}

// The setter of a settable global: `(address, size)` addresses the value as the
// compiler wrote it (bootstrapCtPushGlobal): an int, bool or f64 as one word, a
// string as [size][bytes], an array as [count] and then each element so.
fun bootstrapCtSetterSource(
    global: BootstrapCtGlobal,
    declarations: array<BootstrapDeclaration>,
    index: int,
    generation: int
): string {
    val declaration = declarations[global.declaration]
    if (!bootstrapCtSettable(declaration, declarations)) return ""
    val kind = bootstrapCtSetterKind(global.type)
    val header =
        "@export(\"abla_ct_set_${generation}_$index\")\ncompile fun __abla_ct_set_${generation}_$index(address: int, size: int): int {\n    var at = address\n"
    val body = if (kind.size > 6 && kind.slice(0, 6) == "array:") {
        val element = kind.slice(6, kind.size)
        val advance = if (element == "string") "at = at + 8 + __abla_ct_word_$generation(at)"
            else "at = at + 8"
        "    val count = __abla_ct_word_$generation(at)\n    at = at + 8\n" +
        "    val values: array<$element> = []\n    var index = 0\n" +
        "    while (index < count) {\n        values.append(${bootstrapCtSetterRead(element, generation)})\n" +
        "        $advance\n        index = index + 1\n    }\n" +
        "    ${declaration.name} = values\n"
    } else "    ${declaration.name} = ${bootstrapCtSetterRead(kind, generation)}\n"
    "$header$body    0\n}\n"
}

// A kept scalar as a literal initializer ("missing" when there is none).
fun bootstrapCtLiftScalar(value: BootstrapEvalValue, begin: int, end: int): BootstrapExpression =
    if (value.kind == "integer") BootstrapExpression("integer", "${value.integer}", begin, end, [])
    else if (value.kind == "boolean")
        BootstrapExpression(if (value.boolean) "true" else "false", "", begin, end, [])
    else if (value.kind == "string") BootstrapExpression("string", value.text, begin, end, [])
    else BootstrapExpression("missing", "", begin, end, [])

fun bootstrapCtFailReady(reason: string): void {
    for (site in bootstrapCtSites) {
        if (site.reason == "") site.reason = reason
    }
}

// After a site's walk: the program's own definition (under @export) of each extern:"c" function the walk kept is
// walked too, as the site's code, until no kept extern is left without its definition; their names go in
// `selfDefined`, which the slice exports. Why the site can't run natively, or "".
fun bootstrapCtKeepSelfDefined(
    declarations: array<BootstrapDeclaration>,
    var reach: BootstrapCtReach,
    var reached: array<int>,
    var selfDefined: Map<string, bool>
): string {
    var added = true
    while (added) {
        added = false
        val keptExterns: Map<string, bool> = Map()
        var externIndex = 0
        while (externIndex < declarations.size) {
            if (reach.kept[externIndex] && declarations[externIndex].kind == "extern") {
                keptExterns.set(declarations[externIndex].name, true)
            }
            externIndex = externIndex + 1
        }
        // (Whether a definition is kept, not whether an earlier site named it: a refused site's walk is undone.)
        var exporter = 0
        while (exporter < declarations.size) {
            val declaration = declarations[exporter]
            if (declaration.kind == "fun" && !reach.kept[exporter]) {
                for (name in bootstrapCtExportNames(declaration)) {
                    if ((keptExterns.get(name) ?? false) && !reach.kept[exporter]) {
                        selfDefined.set(name, true)
                        added = true
                        val reason = reach.unsupported(BootstrapExpression(
                            "call", declaration.name, declaration.begin, declaration.end, []
                        ), reached, false, declaration.sourceIdentity)
                        if (reason != "") return reason
                        // (The walk kept it; set here too, so the loop ends whatever the call resolved to.)
                        reach.kept[exporter] = true
                    }
                }
            }
            exporter = exporter + 1
        }
    }
    ""
}

// The names a function's @export or @exportChecked gives it (`@export("a")`, `@export(["a", "b"])`).
fun bootstrapCtExportNames(declaration: BootstrapDeclaration): array<string> {
    val names: array<string> = []
    var annotation = 0
    while (annotation < declaration.annotations.size && annotation < declaration.annotationArguments.size) {
        val kind = declaration.annotations[annotation]
        if (kind == "export" || kind == "exportChecked") {
            val argument = declaration.annotationArguments[annotation]
            if (argument.kind == "string") names.append(argument.text)
            if (argument.kind == "array") {
                for (child in argument.children) {
                    if (child.kind == "string") names.append(child.text)
                }
            }
        }
        annotation = annotation + 1
    }
    names
}

fun bootstrapCtFirstLine(text: string): string {
    var end = 0
    while (end < text.size && text[end] != 10) end = end + 1
    text.slice(0, end)
}

fun bootstrapCtSession(): bool {
    if (!bootstrapCtSessionLive) {
        bootstrapCtSessionState = llvmOrcCreateSession()
        bootstrapCtHostIsDarwin = bootstrapTextContains(llvmDefaultTargetTriple(), "apple")
        bootstrapCtSessionLive = bootstrapCtSessionState.status == 0
    }
    bootstrapCtSessionLive
}

fun bootstrapCtTripleFamily(triple: string): string {
    var end = 0
    while (end < triple.size && triple[end] != 45) end = end + 1
    var architecture = triple.slice(0, end)
    if (architecture == "aarch64") architecture = "arm64"
    val system = if (bootstrapTextContains(triple, "apple")) "apple"
        else if (bootstrapTextContains(triple, "linux")) "linux"
        else triple
    "$architecture:$system"
}

// A host build needs no additional portability proof for its native slice.
fun bootstrapCtTripleIsHost(triple: string): bool =
    bootstrapCtTripleFamily(triple) == bootstrapCtTripleFamily(llvmDefaultTargetTriple())

// What a site's walk (reach.visited, after reach.unsupported) reaches that acts outside the compiler, "" when
// nothing: a program's extern:"c" declaration or a compile-time provider (files, output, the clock, the
// environment, …). The standard library's own C declarations (its allocator's malloc, which nearly every walk
// reaches) don't count: what a trial would call of them, ctNativeTrialStop stops before the call.
fun bootstrapCtReachActs(reach: BootstrapCtReach): string {
    var item = 0
    while (item < reach.visited.size) {
        if (reach.visited[item] && reach.itemMethods[item] < 0) {
            val declaration = reach.declarations[reach.itemDeclarations[item]]
            if (declaration.kind == "extern" && declaration.externalLibrary == "c" &&
                !bootstrapCtLibraryDeclaration(declaration)) {
                return "it reaches extern:\"c\" ${declaration.name}"
            }
            if (bootstrapCompileDeclarationProviderEffect(declaration) >= 0) {
                return "it reaches the compile-time provider ${declaration.name}"
            }
        }
        item = item + 1
    }
    ""
}

// ABLA_COMPILE_EVAL_TRIAL_STEPS: the interpreter steps a pass's trials may take together under auto (default
// 1000000, about a tenth of a second; 0: no trials).
var bootstrapCtTrialStepsValue: int = -1

fun bootstrapCtTrialSteps(): int {
    if (bootstrapCtTrialStepsValue < 0) {
        val configured = linuxEnvironment("ABLA_COMPILE_EVAL_TRIAL_STEPS")
        bootstrapCtTrialStepsValue = 1000000
        if (configured.found && configured.value.size > 0 && configured.value.size <= 12) {
            var parsed = 0
            var valid = true
            for (byte in configured.value) {
                if (byte < 48 || byte > 57) valid = false
                else parsed = parsed * 10 + byte - 48
            }
            if (valid) bootstrapCtTrialStepsValue = parsed
        }
    }
    bootstrapCtTrialStepsValue
}

// Under auto, before the pass's native generation is built: each ready site that can act on nothing outside the
// interpreter runs there first, within what is left of the pass's step budget (bootstrapCtTrialSteps). Such a
// site is not a top-level action, reaches no compile global and no ordinary global compile-time code writes, and
// its walk reaches no extern:"c" code and no provider (bootstrapCtReachActs); and the pass changes no declaration,
// so where in it the site runs makes no difference. Running it twice is then harmless, and the interpreter
// stops it before anything that would not be (ct_native.ab, ctNativeTrialStop). A site the trial finishes keeps
// that result for lowering and needs no generation; one it doesn't (out of steps, stopped before an effect, an
// error) runs natively, as it would have. Returns how many sites finished. A pass whose ready sites all finish
// builds no generation: the cost auto saves on a program whose compile-time work is small.
fun bootstrapCtTrials(parsed: BootstrapParseResult, state: BootstrapCtStateResult): int {
    var left = bootstrapCtTrialSteps()
    if (left <= 0 || state.edits) return 0
    val shared = bootstrapEvalContext(parsed.declarations)
    val grants = bootstrapBuildCompileEffectGrants(
        bootstrapBuildCompileEffectRequests(parsed),
        bootstrapBuildCompileEffectAuthorizations(parsed)
    )
    var finished = 0
    var index = 0
    while (index < bootstrapCtSites.size && left > 0) {
        val site = bootstrapCtSites[index]
        var noTrial = if (site.action) "a top-level action" else site.noTrial
        if (site.reason == "" && noTrial == "") {
            for (global in state.reached[index]) {
                if (noTrial == "" && state.writers[global] != "") {
                    noTrial = "it reaches ${parsed.declarations[global].name}, which compile-time code writes"
                }
            }
        }
        if (site.reason == "" && noTrial != "") {
            bootstrapCtNote("no trial at ${bootstrapCtSiteLabel(site)}: $noTrial")
        }
        if (site.reason == "" && noTrial == "") {
            val context = BootstrapEvalContext(
                shared.size, shared.affineTypes, shared.index, shared.check, left
            )
            ctNativeTrial = true
            val result = bootstrapEvaluateWithEffectsIn(
                context, site.expression, parsed.declarations, grants, site.sourceIdentity
            )
            ctNativeTrial = false
            val spent = bootstrapEvalLastSteps
            left = left - spent
            if (result.errors == 0) {
                site.tried = result
                site.reason = "auto: finished in the interpreter in $spent steps (a trial), so it needs no native generation"
                finished = finished + 1
            } else {
                bootstrapCtNote("trial at ${bootstrapCtSiteLabel(site)} did not finish after $spent steps: ${bootstrapCtFirstLine(result.diagnostics)}; it runs natively")
            }
        }
        index = index + 1
    }
    finished
}

fun bootstrapCtPrepare(parsed: BootstrapParseResult, targetTriple: string,
    methodTargets: BootstrapResolvedMethodTargets = bootstrapResolvedMethodTargets()): void {
    bootstrapCtTypeIndexBegin(parsed.declarations)
    bootstrapCtRaiseCollectionGrowth()
    bootstrapCtPrepareWith(parsed, targetTriple, methodTargets)
    bootstrapCtRestoreCollectionGrowth()
    bootstrapCtTypeIndexEnd()
    return
}

// The compiler's collection step (orc_main.ab sets it with the runtime's; 0 when it collects only on request, as in the
// editor). While a generation is prepared, analyzed and lowered, the step is what the last collection kept, if more:
// the outer program's analysis stays live through all of it, and each collection marks and sweeps it again. The client
// of #1022 (about 350 MB kept) collected 12 times in those phases with the 256 MB step, 4.4 to 5.1 s of the 8.6 to
// 9.9 s they took. (What the heap holds now would count the garbage since that collection: up to a step more.)
var bootstrapCtCollectionGrowth: int = 0
var bootstrapCtCollectionGrowthRaised = false

fun bootstrapCtRaiseCollectionGrowth(): void {
    if (bootstrapCtCollectionGrowth <= 0 || bootstrapCtCollectionGrowthRaised) return
    val live = runtimeMemoryHeapStat(13)
    if (live <= bootstrapCtCollectionGrowth) return
    runtimeMemorySetCollectionGrowth(live)
    bootstrapCtCollectionGrowthRaised = true
    return
}

fun bootstrapCtRestoreCollectionGrowth(): void {
    if (!bootstrapCtCollectionGrowthRaised) return
    bootstrapCtCollectionGrowthRaised = false
    runtimeMemorySetCollectionGrowth(bootstrapCtCollectionGrowth)
    return
}

fun bootstrapCtPrepareWith(parsed: BootstrapParseResult, targetTriple: string,
    methodTargets: BootstrapResolvedMethodTargets): void {
    val started = linuxMonotonicMilliseconds()
    for (site in bootstrapCtSites) {
        if (site.reason == BOOTSTRAP_CT_UNPREPARED) site.reason = ""
    }
    // Declarations from the standard library's files must be recognized as such: when
    // some sit outside the root this compiler believes in (identities written another
    // way than the root), no native slice is trusted: every site is interpreted, with
    // the reason in the trace, instead of a wrong compile-time result (#810).
    var recognized = 0
    var stray = ""
    for (declaration in parsed.declarations) {
        if (bootstrapCtLibraryDeclaration(declaration)) recognized = recognized + 1
        else if (stray == "" && bootstrapTextContains(declaration.sourceIdentity, "stdlib/abla/"))
            stray = declaration.sourceIdentity
    }
    if (recognized == 0 && stray != "") {
        bootstrapCtFailReady(
            "the standard library's modules are not under its root ${bootstrapCompileProviderStandardLibrary()} (for example $stray): set ABLA_SYSROOT to the toolchain's directory"
        )
        return
    }
    val crossTarget = !bootstrapCtTripleIsHost(targetTriple)
    var implicitReason = if (crossTarget && !targetTriple.startsWith("wasm32-"))
        "cross-target triple $targetTriple is not in the portable JIT target allow-list" else ""
    if (crossTarget) {
        val runtimeRoot = "${bootstrapCompileProviderStandardLibrary()}/abla/runtime/"
        for (declaration in parsed.declarations) {
            if (implicitReason == "" && bootstrapCtRuntimeDeclaration(declaration) &&
                !declaration.sourceIdentity.startsWith(runtimeRoot)) {
                // Extension defaults join every slice, even if the site does not
                // name them. Until these implicit roots have their own proof, no
                // cross-target site may activate their initializers or bodies.
                implicitReason =
                    "cross-target implicit runtime dependency ${declaration.name}: not proven portable"
            }
        }
    }
    // Which ordinary globals compile-time code can write (ct_state.ab): a site reaching one
    // runs in the interpreter, whose copy of it is the only one a change reaches.
    val libraryFlags: array<bool> = []
    for (declaration in parsed.declarations) {
        libraryFlags.append(bootstrapCtLibraryDeclaration(declaration))
    }
    val siteExpressions: array<BootstrapExpression> = []
    val siteNodes: array<BootstrapExpression> = []
    val siteTypes: array<string> = []
    val siteSources: array<string> = []
    for (site in bootstrapCtSites) {
        siteExpressions.append(site.expression)
        siteSources.append(site.sourceIdentity)
        siteNodes.append(site.node)
        siteTypes.append(site.type)
    }
    val stateStarted = linuxMonotonicMilliseconds()
    val state = bootstrapCtStateAnalyze(
        parsed.declarations, libraryFlags, siteExpressions, siteSources, siteNodes, siteTypes,
        methodTargets
    )
    bootstrapCtNote("ordinary-global write analysis ${linuxMonotonicMilliseconds() - stateStarted} ms")
    // A written ordinary global the native tier can own (bootstrapCtOwnableReason): its sites stay native unless
    // one of them can't (the fixed point after the sites are prepared, below).
    // (How many of the pass's sites reach each global: a closure in one that a single site reaches can be owned.)
    val reaching: array<int> = []
    for (declaration in parsed.declarations) reaching.append(0)
    for (reachedBySite in state.reached) {
        for (global in reachedBySite) reaching[global] = reaching[global] + 1
    }
    val ownable: array<bool> = []
    var ownableIndex = 0
    while (ownableIndex < parsed.declarations.size) {
        ownable.append(state.writers[ownableIndex] != "" &&
            bootstrapCtOwnableReason(parsed.declarations, ownableIndex, state.edits, reaching[ownableIndex]) == "")
        ownableIndex = ownableIndex + 1
    }
    var stateSite = 0
    for (site in bootstrapCtSites) {
        // Native closures are positional: one made before an edit would run the edited body.
        if (site.reason == "" && state.edits && site.type != "void" &&
            bootstrapCtStateMayHoldClosure(parsed.declarations, site.type)) {
            site.reason =
                "result type ${site.type} may hold a closure, and this pass changes declarations: a native closure would run the edited body"
        }
        if (site.reason == "") {
            for (global in state.reached[stateSite]) {
                if (site.reason == "" && state.writers[global] != "" && !ownable[global]) {
                    site.reason =
                        "ordinary mutable global ${parsed.declarations[global].name} may be written at ${state.writers[global]} (${bootstrapCtOwnableReason(parsed.declarations, global, state.edits, reaching[global])})"
                }
            }
        }
        stateSite = stateSite + 1
    }
    val reach = bootstrapCtReach(parsed.declarations, methodTargets)
    // Separate visitation: proving only portable executed code must not prune the
    // full declaration bodies the ordinary slice's analysis and lowering require.
    val portable = if (crossTarget) bootstrapCtReach(parsed.declarations, methodTargets) else reach
    if (crossTarget) {
        val named: Map<string, int> = Map()
        for (declaration in parsed.declarations) {
            named.set(declaration.name, (named.get(declaration.name) ?? 0) + 1)
        }
        var snapshotIndex = 0
        while (snapshotIndex < parsed.declarations.size) {
            val declaration = parsed.declarations[snapshotIndex]
            if (state.snapshot[snapshotIndex] && (named.get(declaration.name) ?? 0) == 1) {
                portable.replaySafe.set(declaration.name, true)
            }
            snapshotIndex = snapshotIndex + 1
        }
    }
    for (declaration in parsed.declarations) {
        if (bootstrapCtRuntimeDeclaration(declaration)) {
            reach.keepFrom(declaration.expression, declaration.sourceIdentity)
            // An extension field is kept in every slice, so its owner type is too: without it the
            // slice is refused (field.extension-owner), as jwt's was by CryptoPassword's fields (#828).
            if (bootstrapIsExtensionFieldKind(declaration.kind) && declaration.extensionOwner != "") {
                val owner = bootstrapNormalizeType(declaration.extensionOwner)
                val angle = owner.indexOf("<")
                reach.keepFrom(BootstrapExpression("type", if (angle > 0) owner.slice(0, angle) else owner, 0, 0, []),
                    declaration.sourceIdentity)
            }
            for (method in declaration.methods) reach.keepFrom(method.expression,
                if (method.sourceIdentity !=
                    "") method.sourceIdentity else declaration.sourceIdentity)
        }
    }
    // A float in a string template is written by abla/float/text's f64Text (an f32
    // widened by abla/float's f32ToF64 first), which no site names: kept when the
    // program has them, so such templates type-check and lower.
    // So are a wide integer's comparisons (`a < b` on two int128s calls abla/int128's int128Less) and its text in a
    // template (int128Text): the game client's exchange code compares int128s (#1022).
    val wideNames: Map<string, bool> = Map()
    for (wide in ["int128", "uint128", "int256", "uint256"]) {
        for (suffix in ["Equal", "NotEqual", "Less", "LessEqual", "Greater", "GreaterEqual", "Text"]) {
            wideNames.set("$wide$suffix", true)
        }
    }
    for (declaration in parsed.declarations) {
        if ((declaration.name == "f64Text" || declaration.name == "f32ToF64" ||
            (wideNames.get(declaration.name) ?? false)) && declaration.kind == "fun") {
            reach.keepFrom(BootstrapExpression("call", declaration.name, 0, 0, []))
        }
    }
    // An extern:"c" function the program defines itself, under @export (abla-forge's `host_option`, `gfx_submit`
    // and the rest, which native/linux/host.ab exports): the linker resolves one to the other, so the slice keeps
    // the exporting function and exports it under that name too (below), or the generation's link fails on the
    // missing symbols (#1022). Each site's walk follows them (bootstrapCtKeepSelfDefined), as the site's own code.
    val selfDefined: Map<string, bool> = Map()
    // The slice's analysis sees the program's top-level grants (they decide what its
    // compile code may do): the declaration they call is part of it.
    for (action in parsed.actions) {
        if (action.kind == "compile" && action.children.size == 1 &&
            action.children[0].kind == "call" && action.children[0].text == "compilerGrant") {
            reach.keepFrom(action)
        }
    }
    if (crossTarget && implicitReason == "") {
        val runtimeRoot = "${bootstrapCompileProviderStandardLibrary()}/abla/runtime/"
        var value = 0
        while (implicitReason == "" && value < parsed.declarations.size) {
            val declaration = parsed.declarations[value]
            if (reach.kept[value] && bootstrapDeclarationIsValue(declaration.kind) &&
                !declaration.sourceIdentity.startsWith(runtimeRoot) &&
                !bootstrapCtCrossLiteralTable(declaration)) {
                portable.reset()
                val ignoredGlobals: array<int> = []
                implicitReason = portable.unsupported(BootstrapExpression(
                    "identifier", declaration.name, declaration.begin, declaration.end, []
                ), ignoredGlobals, true)
            }
            value = value + 1
        }
    }
    var ready = 0
    val auto = bootstrapCtMode() == "auto"
    var anyLong = false
    for (site in bootstrapCtSites) {
        if (site.reason == "" && implicitReason != "") site.reason = implicitReason
        site.encodes = !site.action && site.type != "void" && site.type != "null"
        if (site.reason == "" && site.encodes) {
            val typeReason = bootstrapLiftTypeReasonIn(parsed.declarations,
                bootstrapNormalizeType(site.type))
            if (typeReason != "") site.reason = "result type ${site.type}: $typeReason"
        }
        if (site.reason == "") {
            reach.reset()
            // A site the tier can't take adds nothing to the slice: what its walk
            // kept before the reason was found (code naming what the slice won't
            // carry) would fail the slice's analysis for every other site.
            val keptBefore: array<bool> = []
            for (kept in reach.kept) keptBefore.append(kept)
            val reached: array<int> = []
            if (crossTarget) {
                portable.reset()
                val ignoredGlobals: array<int> = []
                site.reason = portable.unsupported(site.expression, ignoredGlobals, true,
                    site.sourceIdentity)
            }
            if (site.reason == "") site.reason = reach.unsupported(site.expression, reached, false,
                site.sourceIdentity)
            if (site.reason == "") site.reason = bootstrapCtKeepSelfDefined(parsed.declarations, reach, reached, selfDefined)
            // Under auto, whether the site can run long, while reach.visited is its walk (once one site
            // can, the pass has a generation whatever the others are, so they are not asked).
            if (site.reason == "" && auto && !anyLong) {
                site.long = bootstrapCtMayRunLong(reach, site.expression)
                anyLong = site.long
            }
            // Under auto, what decides a trial (bootstrapCtTrials), while the walk is the site's.
            if (site.reason == "" && auto) {
                site.noTrial = bootstrapCtReachActs(reach)
                if (site.noTrial == "" && reached.size > 0) {
                    site.noTrial = "it reaches compile global ${parsed.declarations[reached[0]].name}"
                }
            }
            if (crossTarget && site.reason == "") {
                // Whole bodies are kept even where the phase proof skips an arm.
                // A global reached only from that arm would nevertheless initialize
                // when the native slice starts: prove every newly kept initializer too.
                var global = 0
                while (site.reason == "" && global < parsed.declarations.size) {
                    val declaration = parsed.declarations[global]
                    if (reach.kept[global] && !keptBefore[global] &&
                        bootstrapDeclarationIsValue(declaration.kind) &&
                        !bootstrapCtCrossLiteralTable(declaration)) {
                        portable.reset()
                        val ignoredGlobals: array<int> = []
                        site.reason = portable.unsupported(BootstrapExpression(
                            "identifier", declaration.name, declaration.begin, declaration.end, []
                        ), ignoredGlobals, true)
                    }
                    global = global + 1
                }
            }
            if (site.reason == "") {
                // A `#` site has one value for the build (docs/compile-time.md), which the lowering and the evaluator
                // share (eval.ab, bootstrapEvaluateCompileSite). The slice calls one accessor for a site it can run
                // (bootstrapCtOnceSource); a `#` node in a kept global's initializer or function's body that no native
                // site holds would be lowered as its code and run again, so a site that reaches one runs in the
                // evaluator.
                var global = 0
                while (site.reason == "" && global < parsed.declarations.size) {
                    val declaration = parsed.declarations[global]
                    if (reach.kept[global] && !keptBefore[global] &&
                        (declaration.kind == "val" || declaration.kind == "var" || declaration.kind == "fun") &&
                        bootstrapCtUnheldCompileNode(declaration.expression, declaration.sourceIdentity)) {
                        site.reason = if (declaration.kind == "fun")
                            "reaches ${declaration.name}, whose body has a `#` site (its one value is the evaluator's)"
                            else "reaches global ${declaration.name}, which a `#` site initializes (its one compile-time value is the evaluator's)"
                    }
                    global = global + 1
                }
            }
            if (site.reason != "") {
                var restored = 0
                while (restored < keptBefore.size) {
                    reach.kept[restored] = keptBefore[restored]
                    restored = restored + 1
                }
            }
            if (site.reason == "") {
                for (global in reached) {
                    if (site.reason == "" && state.edits && bootstrapCtStateMayHoldClosure(
                        parsed.declarations, parsed.declarations[global].resultType)) {
                        site.reason =
                            "reaches compile global ${parsed.declarations[global].name}, which may hold a closure, and this pass changes declarations: a native closure would run the edited body"
                    }
                }
            }
            if (site.reason == "") {
                for (global in reached) {
                    var known = false
                    for (existing in bootstrapCtGlobals) {
                        if (existing.declaration == global) known = true
                    }
                    if (!known) {
                        val delegate = bootstrapCtDelegateKind(parsed.declarations[global])
                        bootstrapCtGlobals.append(BootstrapCtGlobal(
                            global,
                            bootstrapCompileGlobalKey(parsed.declarations[global]),
                            if (delegate != "") "any"
                            else bootstrapNormalizeType(parsed.declarations[global].resultType),
                            "", 0, 0, delegate
                        ))
                    }
                }
            }
        }
        if (site.reason == "") {
            site.id = bootstrapCtNextSite
            bootstrapCtNextSite = bootstrapCtNextSite + 1
            ready = ready + 1
        }
    }
    // An ownable global is native for the pass only if every site that reaches it runs natively: one that runs in
    // the interpreter would see the interpreter's copy while the others change the generation's. A site refused here
    // refuses, in turn, the other globals it reaches, so this repeats until nothing changes. (A refused site's walk
    // kept only code the slice supports, so what it kept stays.)
    var settled = false
    while (!settled) {
        settled = true
        var owned = 0
        while (owned < parsed.declarations.size) {
            if (ownable[owned]) {
                var refusal = ""
                var reaching = 0
                while (refusal == "" && reaching < bootstrapCtSites.size) {
                    if (bootstrapCtSites[reaching].reason != "" &&
                        bootstrapCtStateHas(state.reached[reaching], owned)) {
                        refusal = bootstrapCtSiteLabel(bootstrapCtSites[reaching])
                    }
                    reaching = reaching + 1
                }
                if (refusal != "") {
                    ownable[owned] = false
                    settled = false
                    var other = 0
                    while (other < bootstrapCtSites.size) {
                        val site = bootstrapCtSites[other]
                        if (site.reason == "" && bootstrapCtStateHas(state.reached[other], owned)) {
                            site.reason =
                                "ordinary mutable global ${parsed.declarations[owned].name} may be written at ${state.writers[owned]}, and the site at $refusal that reaches it runs in the interpreter"
                            ready = ready - 1
                        }
                        other = other + 1
                    }
                }
            }
            owned = owned + 1
        }
    }
    // Under auto, a pass none of whose native-ready sites can run long (bootstrapCtMayRunLong) is
    // interpreted whole: the interpreter's steps for each are bounded by the size of its code, which costs
    // less than the native generation (hundreds of milliseconds of code generation). Decided before any
    // site runs, and the whole pass, so no global is shared between the tiers.
    if (auto && ready > 0) {
        var long = false
        for (site in bootstrapCtSites) {
            if (site.reason == "" && site.long) long = true
        }
        if (!long) {
            for (site in bootstrapCtSites) {
                if (site.reason == "") {
                    site.reason =
                        "auto: no site of this pass reaches a loop, a lambda, recursion or a call through a C function pointer, so the interpreter runs them without a native generation"
                }
            }
            ready = 0
        }
    }
    if (auto && ready > 0) ready = ready - bootstrapCtTrials(parsed, state)
    // The owned globals go back to the interpreter's journal when it next needs them after a native call, as compile
    // globals do (bootstrapCtFetchPending): a later pass, or an interpreted evaluation of this one, reads the one value.
    var ownedIndex = 0
    while (ownedIndex < parsed.declarations.size) {
        var reachedByNative = false
        var siteIndex = 0
        while (siteIndex < bootstrapCtSites.size) {
            if (bootstrapCtSites[siteIndex].reason == "" &&
                bootstrapCtStateHas(state.reached[siteIndex], ownedIndex)) reachedByNative = true
            siteIndex = siteIndex + 1
        }
        // (The write analysis's reach is wider than the slice's: a global no native call can touch, which the slice
        // leaves out, stays the interpreter's. Exchanging it would name a declaration the slice hasn't.)
        if (!reach.kept[ownedIndex]) reachedByNative = false
        if (ownable[ownedIndex] && reachedByNative && bootstrapCtUnexchanged(parsed.declarations, ownedIndex)) {
            val ownedType = bootstrapCtOrdinaryTypeIn(parsed.declarations, parsed.declarations[ownedIndex])
            val what = if (bootstrapCtTVarDelegate(parsed.declarations[ownedIndex])) "a TVar"
                else if (bootstrapCtMayHoldResource(parsed.declarations, ownedType)) "it holds resources"
                else if (bootstrapCtRawPointer(ownedType)) "a raw pointer"
                else "it holds a closure"
            bootstrapCtNote("ordinary global ${parsed.declarations[ownedIndex].name} ($what) is native for this pass")
        } else if (ownable[ownedIndex] && reachedByNative) {
            var known = false
            for (existing in bootstrapCtGlobals) {
                if (existing.declaration == ownedIndex) known = true
            }
            if (!known) {
                bootstrapCtGlobals.append(BootstrapCtGlobal(
                    ownedIndex, bootstrapCompileGlobalKey(parsed.declarations[ownedIndex]),
                    bootstrapCtOrdinaryTypeIn(parsed.declarations, parsed.declarations[ownedIndex]), "", 0, 0, ""
                ))
                bootstrapCtNote("ordinary global ${parsed.declarations[ownedIndex].name} is native for this pass")
            }
        }
        ownedIndex = ownedIndex + 1
    }
    if (ready > 0 && !bootstrapCtSession()) {
        bootstrapCtFailReady("the ORC session could not be created")
        ready = 0
    }
    if (ready == 0) return
    bootstrapCtGenerationNumber = bootstrapCtGenerationNumber + 1
    val generation = bootstrapCtGenerationNumber
    // A kept compiler API extern (and an opaque compiler class, ablaAtCompileTime)
    // is its bridge shim, whose helpers come from abla/compiler/bridge.
    var bridged = false
    var bridgeIndex = 0
    while (bridgeIndex < parsed.declarations.size) {
        val declaration = parsed.declarations[bridgeIndex]
        if (reach.kept[bridgeIndex] &&
            ((declaration.kind == "extern" && ctBridgeRoutesExtern(declaration)) ||
             bootstrapCompileDeclarationProviderEffect(declaration) > 0)) bridged = true
        bridgeIndex = bridgeIndex + 1
    }
    val helpers = if (bridged) bootstrapCtBridgeHelpers(parsed, reach) else []
    if (bridged && helpers.size == 0 && !bootstrapCtBridgeImported(parsed)) {
        bootstrapCtFailReady("the compiler bridge's helpers (abla/compiler/bridge) could not be read")
        return
    }
    // The support declares the intrinsics it needs unless the slice keeps them.
    val kept: array<BootstrapDeclaration> = []
    for (helper in helpers) kept.append(helper)
    var keptIndex = 0
    while (keptIndex < parsed.declarations.size) {
        if (reach.kept[keptIndex] ||
            bootstrapCtRuntimeDeclaration(parsed.declarations[keptIndex])) {
            kept.append(parsed.declarations[keptIndex])
        }
        keptIndex = keptIndex + 1
    }
    var source = bootstrapCtSupportSource(generation, kept)
    // The sites whose `#` nodes the slice keeps run through one accessor (bootstrapCtOnceSource).
    for (site in bootstrapCtSites) site.once = false
    var onceIndex = 0
    while (onceIndex < parsed.declarations.size) {
        val declaration = parsed.declarations[onceIndex]
        if (reach.kept[onceIndex] &&
            (declaration.kind == "val" || declaration.kind == "var" || declaration.kind == "fun")) {
            bootstrapCtMarkOnce(declaration.expression, declaration.sourceIdentity)
        }
        onceIndex = onceIndex + 1
    }
    for (site in bootstrapCtSites) {
        if (site.reason == "") source = "$source${bootstrapCtEntrySource(site, generation)}"
    }
    var globalIndex = 0
    while (globalIndex < bootstrapCtGlobals.size) {
        source =
            "$source${bootstrapCtGlobalSource(globalIndex, generation)}${bootstrapCtSetterSource(
            bootstrapCtGlobals[globalIndex], parsed.declarations, globalIndex, generation
        )}"
        globalIndex = globalIndex + 1
    }
    val template = bootstrapParse(source)
    if (template.errors > 0) {
        bootstrapCtFailReady("slice template: ${bootstrapCtFirstLine(template.diagnostics)}")
        return
    }
    // The program's declarations as they are (analysis sees the phases it knows),
    // then the support declarations and one entry per site.
    val sliceDeclarations: array<BootstrapDeclaration> = []
    var declarationIndex = 0
    while (declarationIndex < parsed.declarations.size) {
        val declaration = parsed.declarations[declarationIndex]
        if (reach.kept[declarationIndex] || bootstrapCtRuntimeDeclaration(declaration)) {
            val shims = if (bootstrapCtBridged(declaration))
                bootstrapCtSliceShims(declaration) else []
            // (A once site's `#` node calls its accessor: bootstrapCtOnceSource.)
            val held = if (shims.size == 1 || !bootstrapCtHasCompileNode(declaration.expression)) declaration
                else bootstrapCtDeclarationWith(declaration, declaration.kind,
                    bootstrapCtOnceRewrite(declaration.expression, declaration.sourceIdentity), 0,
                    declaration.sourceIdentity)
            sliceDeclarations.append(if (shims.size == 1) shims[0] else held)
        }
        declarationIndex = declarationIndex + 1
    }
    for (helper in helpers) sliceDeclarations.append(helper)
    if (crossTarget) {
        val runtimeReason = bootstrapCtHostPlatform(sliceDeclarations)
        if (runtimeReason != "") {
            bootstrapCtFailReady(runtimeReason)
            return
        }
    }
    val exports: array<BootstrapExportRequest> = []
    for (declaration in template.declarations) {
        var sourceIdentity = ""
        var expression = bootstrapCtSplice(declaration.expression, "", declaration.expression)
        for (site in bootstrapCtSites) {
            if (site.reason == "" && (declaration.name == "__abla_ct_eval_${site.id}" ||
                declaration.name == "__abla_ct_once_get_${site.id}" ||
                declaration.name == "__abla_ct_once_${site.id}")) {
                sourceIdentity = site.sourceIdentity
                expression = bootstrapCtSplice(
                    declaration.expression, "__abla_ct_site_${site.id}", site.expression
                )
            }
        }
        globalIndex = 0
        while (globalIndex < bootstrapCtGlobals.size) {
            if (declaration.name == "__abla_ct_set_${generation}_$globalIndex") {
                sourceIdentity =
                    parsed.declarations[bootstrapCtGlobals[globalIndex].declaration].sourceIdentity
            }
            if (declaration.name == "__abla_ct_global_${generation}_$globalIndex") {
                val global = parsed.declarations[bootstrapCtGlobals[globalIndex].declaration]
                sourceIdentity = global.sourceIdentity
                val named = BootstrapExpression(
                    "identifier", global.name, global.begin, global.end, []
                )
                expression = bootstrapCtSplice(
                    declaration.expression, "__abla_ct_value_$globalIndex",
                    if (bootstrapCtGlobals[globalIndex].delegate == "") named
                    // (As in source, `^` begins before the name it projects.)
                    else BootstrapExpression(
                        "delegate.project", "", global.begin - 1, global.end, [named]
                    )
                )
            }
            globalIndex = globalIndex + 1
        }
        sliceDeclarations.append(bootstrapCtDeclarationWith(
            declaration, declaration.kind, expression,
            BOOTSTRAP_CT_TEMPLATE_OFFSET, sourceIdentity
        ))
        if (declaration.annotations.size > 0 && declaration.annotations[0] == "export") {
            val parameterNames: array<string> = []
            val parameterTypes: array<string> = []
            for (parameter in declaration.parameters) {
                parameterNames.append(parameter)
                parameterTypes.append("i64")
            }
            exports.append(BootstrapExportRequest(
                declaration.name,
                declaration.annotationArguments[0].text,
                "i64", parameterNames, parameterTypes, false, false, false
            ))
        }
    }
    // The sites stand for the program's top-level actions; its analysis sees only
    // the grants and authorizations, which decide what compile code may do (a
    // subparser registration names compile code the slice doesn't carry).
    val sliceActions: array<BootstrapExpression> = []
    for (action in parsed.actions) {
        val executable = if (action.kind == "compile" && action.children.size == 1)
            action.children[0] else action
        if (executable.kind == "compile.capability.authorization" ||
            (executable.kind == "call" && executable.text == "compilerGrant")) {
            sliceActions.append(action)
        }
    }
    val slice = BootstrapParseResult(
        sliceDeclarations, sliceActions, 0, 0,
        parsed.compileInputPaths, parsed.compileInputContents, ""
    )
    // (The generation's note splits its time here: preparing the slice, which includes the write analysis noted on
    // its own, then analyzing it. One figure from the start counted the write analysis twice in reading.)
    val prepared = linuxMonotonicMilliseconds()
    val analyzingSlice = bootstrapCtAnalyzingSlice
    val targetsWasm = bootstrapSemanticTargetsWasm
    val wasmUnwinds = bootstrapSemanticWasmUnwinds
    bootstrapCtAnalyzingSlice = true
    bootstrapSemanticTargetsWasm = false
    bootstrapSemanticWasmUnwinds = false
    val analyzed = bootstrapAnalyzeParsed(slice)
    bootstrapCtAnalyzingSlice = analyzingSlice
    bootstrapSemanticTargetsWasm = targetsWasm
    bootstrapSemanticWasmUnwinds = wasmUnwinds
    val analysisDone = linuxMonotonicMilliseconds()
    if (analyzed.errors > 0) {
        bootstrapCtNote("slice analysis failed:\n${analyzed.diagnostics}")
        bootstrapCtFailReady("slice analysis: ${bootstrapCtFirstLine(analyzed.diagnostics)}")
        return
    }
    // Lowered as one runtime program: compile declarations become ordinary ones.
    val loweredDeclarations: array<BootstrapDeclaration> = []
    for (declaration in sliceDeclarations) {
        var kind = if (declaration.kind == "compile.fun") "fun" else declaration.kind
        var initializer = declaration.expression
        if (kind == "compile.val" || kind == "compile.var") {
            // One value for the compilation: what an earlier evaluation kept, if any.
            kind = "var"
            val kept = bootstrapCompileGlobalLoad(
                bootstrapCompileGlobalKey(declaration), parsed.declarations, []
            )
            val lifted = bootstrapCtLiftScalar(kept, declaration.begin, declaration.end)
            if (lifted.kind != "missing") initializer = lifted
        } else if (bootstrapDeclarationIsValue(kind) &&
            bootstrapCtHasCompileNode(initializer)) {
            // A global whose initializer is compile-time code (`val x = #f()`):
            // read at compile time, that code runs where it stands, as the
            // evaluator runs it on the global's first read (analysis saw the
            // original, where `#` makes the call compile-time code).
            initializer = bootstrapCtWithoutCompileNodes(initializer)
        }
        loweredDeclarations.append(
            if (kind == declaration.kind && initializer == declaration.expression) declaration
            else bootstrapCtDeclarationWith(
                declaration, kind, initializer, 0, declaration.sourceIdentity
            )
        )
    }
    val lowered = BootstrapParseResult(
        loweredDeclarations, [], 0, 0,
        parsed.compileInputPaths, parsed.compileInputContents, ""
    )
    // The outer program's staged exports and diagnostics are set aside while the
    // slice uses the same staging, then put back.
    val outerExports = bootstrapTakeExportRequests()
    val outerDiagnostics = bootstrapTakeDriverDiagnostics()
    for (request in exports) bootstrapStageExportRequest(request)
    // The program's own definitions of the externs it calls (selfDefined, above), exported under those names.
    // (One generation is live at a time: bootstrapCtFinishPass removes the last before the next is made.)
    for (declaration in sliceDeclarations) {
        if (declaration.kind == "fun") {
            for (name in bootstrapCtExportNames(declaration)) {
                if (selfDefined.get(name) ?? false) {
                    val parameterTypes: array<string> = []
                    for (type in declaration.parameterTypes) {
                        parameterTypes.append(bootstrapExportRuntimeType(sliceDeclarations, type))
                    }
                    val staged = bootstrapStageExportRequest(BootstrapExportRequest(
                        declaration.name, name, bootstrapExportRuntimeType(sliceDeclarations, declaration.resultType),
                        declaration.parameters, parameterTypes, false, false, false
                    ))
                }
            }
        }
    }
    bootstrapCtLoweringSlice = true
    val program = bootstrapLowerParsedCached(
        lowered, analyzed, bootstrapIrTransientState(), true
    )
    bootstrapCtLoweringSlice = false
    bootstrapCtRestoreCollectionGrowth()
    val loweringDone = linuxMonotonicMilliseconds()
    var context = nativeNullPointer()
    var module = nativeNullPointer()
    var failure = ""
    if (program.errors > 0) {
        failure = "slice lowering: ${program.errors} error(s)"
        val discarded = bootstrapTakeExportRequests()
    } else {
        val holdModule = bootstrapLlvmHoldModule
        val bitcodePath = bootstrapLlvmBitcodePath
        val debugInfo = bootstrapLlvmDebugInfo
        val pruneRuntime = bootstrapLlvmPruneRuntime
        // Compile-time slices are never instrumented, and must not reassign the coverage tables of an
        // outer flagged emission (the slices run before it).
        val coverage = bootstrapLlvmCoverage
        bootstrapLlvmCoverage = false
        bootstrapLlvmHoldModule = true
        // A missed edge in code that runs in this process would fail at run time, not at link.
        bootstrapLlvmPruneRuntime = false
        bootstrapLlvmBitcodePath = ""
        bootstrapLlvmDebugInfo = false
        // The entries run compile-time code as a hosted program's main runs it:
        // collected under pressure, with the globals as roots.
        bootstrapLlvmExportsAreEntries = true
        val emitted = bootstrapEmitLlvmProgram(program, llvmDefaultTargetTriple(), false)
        bootstrapLlvmExportsAreEntries = false
        if (emitted.errors > 0) {
            failure = "slice emission: ${emitted.errors} error(s)"
        } else {
            context = bootstrapLlvmHeldContext
            module = bootstrapLlvmHeldModule
        }
        bootstrapLlvmHeldContext = nativeNullPointer()
        bootstrapLlvmHeldModule = nativeNullPointer()
        bootstrapLlvmHoldModule = holdModule
        bootstrapLlvmBitcodePath = bitcodePath
        bootstrapLlvmDebugInfo = debugInfo
        bootstrapLlvmPruneRuntime = pruneRuntime
        bootstrapLlvmCoverage = coverage
    }
    val sliceDiagnostics = bootstrapTakeDriverDiagnostics()
    if (sliceDiagnostics != "") bootstrapCtNote("slice diagnostics:\n$sliceDiagnostics")
    for (request in outerExports) bootstrapStageExportRequest(request)
    if (outerDiagnostics != "") bootstrapStageDriverDiagnostic(outerDiagnostics)
    if (failure != "") {
        bootstrapCtFailReady(failure)
        return
    }
    val emissionDone = linuxMonotonicMilliseconds()
    bootstrapCtInstallGuard(context, module, generation)
    bootstrapCtSetEnvironment(context, module, bootstrapBuildCompileEffectGrants(
        bootstrapBuildCompileEffectRequests(parsed),
        bootstrapBuildCompileEffectAuthorizations(parsed)
    ))
    // ABLA_COMPILE_EVAL_DUMP=<directory> keeps each generation's module as text.
    val dump = linuxEnvironment("ABLA_COMPILE_EVAL_DUMP")
    if (dump.found && dump.value != "") {
        Path(dump.value).createDirectories()
        val dumped = LlvmOwnedModule(context, module, 0, false)
        val written = dumped.writeText("${dump.value}/generation-$generation.ll")
        dumped.closed = true
    }
    // Whether the generation can start threads (its runtime creates them with pthread_create): ct_eval.ab enables the
    // compiler heap's lock before calling into it.
    bootstrapCtGenerationThreads = !pointerIsNull(LLVMGetNamedFunction(module, "pthread_create"))
    // The root manifest's nativeLibraries, loaded into the process's global scope (when the program holds
    // the trusted.native grant), where the session's process generator resolves the slice's extern:"c"
    // symbols as the interpreter's calls find them (ct_native.ab). Else a site calling one failed the
    // generation: "Symbols not found".
    val libraries = bootstrapCtNativeLibraries(parsed)
    val added = bootstrapCtAddGeneration(context, module, bootstrapCtSlicePasses(program.functions.size), generation)
    if (added.status != 0) {
        bootstrapCtFailReady("ORC rejected the slice (status ${added.status})")
        return
    }
    bootstrapCtGenerationState = added
    bootstrapCtGenerationLive = true
    // A native result's closure names its function by runtime id.
    val functionIds = bootstrapLlvmFunctionIdentities(program).runtimeIds
    val functionNames: array<string> = []
    for (function in program.functions) {
        functionNames.append(function.name)
    }
    bootstrapCtFunctions = BootstrapCtFunctionTable(functionIds, functionNames, [])
    for (global in bootstrapCtGlobals) {
        global.exchanged = bootstrapCompileGlobalEncode(
            bootstrapCompileGlobalLoad(global.key, parsed.declarations, [])
        )
    }
    bootstrapCtFreeAddress = bootstrapCtLookup("abla_ct_free_$generation")
    bootstrapCtGuardAddress = bootstrapCtLookup("abla_ct_guard_$generation")
    bootstrapCtAlarmAddress = bootstrapCtLookup("abla_ct_alarm_$generation")
    bootstrapCtFaultAddress = bootstrapCtLookup("abla_ct_fault_$generation")
    if (bootstrapCtPanicCaught) {
        bootstrapCtPanicTextAddress = bootstrapCtLookup("abla_ct_panic_text_$generation")
        bootstrapCtPanicSizeAddress = bootstrapCtLookup("abla_ct_panic_size_$generation")
    }
    bootstrapCtStopSiteAddress = bootstrapCtLookup("abla_ct_stop_site_$generation")
    bootstrapCtGenerationSpent = ""
    if (bootstrapCtFreeAddress == 0 || bootstrapCtGuardAddress == 0) {
        bootstrapCtFailReady("the slice's support entries are missing")
    }
    var missing = false
    for (site in bootstrapCtSites) {
        if (site.reason == "") {
            site.entry = bootstrapCtLookup("abla_ct_eval_${site.id}")
            if (site.entry == 0) missing = true
        }
    }
    // Every site or none: the sites share the globals the native tier owns for the pass (G1), so one site left to
    // the interpreter would read the interpreter's copy while the others change the generation's.
    if (missing) bootstrapCtFailReady("a site's entry is missing")
    var getter = 0
    while (getter < bootstrapCtGlobals.size) {
        bootstrapCtGlobals[getter].getter =
            bootstrapCtLookup("abla_ct_global_${generation}_$getter")
        if (bootstrapCtSetterSource(
            bootstrapCtGlobals[getter], parsed.declarations, getter, generation
        ) != "") {
            bootstrapCtGlobals[getter].setter =
                bootstrapCtLookup("abla_ct_set_${generation}_$getter")
            // A kept value no literal can carry (an f64, an array) goes in now,
            // before any site reads it.
            val kept = bootstrapCompileGlobalLoad(
                bootstrapCtGlobals[getter].key, parsed.declarations, []
            )
            if (kept.kind != "invalid" && bootstrapCtLiftScalar(kept, 0, 0).kind == "missing" &&
                !bootstrapCtPushGlobal(bootstrapCtGlobals[getter], kept)) {
                bootstrapCtFailReady("compile global ${bootstrapCtGlobals[getter].key} could not be passed in")
            }
        }
        getter = getter + 1
    }
    // What the slice cost, by phase (LLJIT compiles the module at its first lookup,
    // so "code" is machine code generation and linking).
    bootstrapCtNote("generation $generation: ${sliceDeclarations.size} declarations, ${program.functions.size} functions; preparation ${prepared - started} ms (with the write analysis), analysis ${analysisDone - prepared} ms, lowering ${loweringDone - analysisDone} ms, emission ${emissionDone - loweringDone} ms, code ${linuxMonotonicMilliseconds() - emissionDone} ms")
}

// A large generation is generated as code generation units (codegen_units.ab), by child compilers at once, and its
// objects are loaded into the session; a small one is added as one module, which LLJIT generates on this thread.
// LLJIT generated the client of #1022 (5,326 functions) in 9.5 s on one thread; split into 8 units at the same level,
// in about 2 s. The cut is made after the slice's passes, as an ordinary build's is after its optimization, and a
// unit's object goes to the code generation cache under a key of its module and of this host's machine (`native-jit`:
// never an ordinary build's). ABLA_COMPILE_EVAL_UNITS=0 keeps every generation one module.
//
// Below BOOTSTRAP_CT_UNITS_MINIMUM instructions a generation is one module. Measured with chains of N functions
// (code phase, cache off, one module against units): 24k-47k instructions (N 25-200, balanced passes) cost the same
// either way, since the passes dominate; 72k went from 1.9 s to 0.6 s, 124k from 3.3 s to 0.7 s, 227k from 6.9 s to
// 1.4 s. An ordinary build's minimum (150k) would leave the middle on one thread.
val BOOTSTRAP_CT_UNITS_MINIMUM = 60000

fun bootstrapCtAddGeneration(context: i64*, module: i64*, passes: string, generation: int): LlvmOrcGeneration {
    val configured = linuxEnvironment("ABLA_COMPILE_EVAL_UNITS")
    val wanted = !(configured.found && configured.value == "0")
    val size = if (wanted) bootstrapCodegenModuleSize(module) else 0
    val minimum = bootstrapCodegenEnvironmentCount("ABLA_CODEGEN_UNITS_MINIMUM", BOOTSTRAP_CT_UNITS_MINIMUM)
    if (!wanted || bootstrapCodegenUnitCount() < 2 || size < minimum ||
        !bootstrapCodegenThreadLocalUsers(module).supported) {
        return bootstrapCtSessionState.addModule(context, module, passes)
    }
    val started = linuxMonotonicMilliseconds()
    val nullPointer = nativeNullPointer()
    var status = 0
    if (passes != "") {
        val options = LLVMCreatePassBuilderOptions()
        status = llvmConsumeError(LLVMRunPasses(module, passes, nullPointer, options), 129)
        LLVMDisposePassBuilderOptions(options)
    }
    val directory = "${bootstrapCacheDirectory()}/ct-units/${linuxProcessId()}-$generation"
    Path(directory).removeTree()
    if (status == 0 && !Path(directory).createDirectories()) status = 145
    val objectPath = "$directory/generation"
    // (The functions that use a thread-local go to one more unit, which this process cuts and the session generates:
    // JITLink takes no TLS relocation, and LLJIT emulates thread-locals.)
    val unitCounts = if (status == 0) bootstrapWriteCodegenUnits(module, objectPath, true) else []
    if (status == 0 && unitCounts.size == 0) status = 145
    LLVMDisposeModule(module)
    LLVMContextDispose(context)
    val counts: array<int> = []
    var index = 0
    while (index + 1 < unitCounts.size) {
        counts.append(unitCounts[index])
        index = index + 1
    }
    var session = BootstrapCodegenSessionUnit(0, nullPointer, nullPointer)
    if (status == 0 && unitCounts[unitCounts.size - 1] > 0) {
        session = bootstrapCodegenSessionUnit(objectPath, counts.size)
        status = session.status
    }
    val written = linuxMonotonicMilliseconds()
    val salt = "ct-${ctContentKey(jitCacheCompilerIdentity())}"
    val places = BootstrapCodegenUnitPlaces(bootstrapCodegenCacheDirectory(bootstrapCacheDirectory()), salt)
    var parts: array<string> = []
    var entries: array<string> = []
    if (status == 0) {
        val generated = bootstrapGenerateCodegenUnits(
            "native-jit", llvmDefaultTargetTriple(), objectPath, places, counts
        )
        status = generated.status
        parts = generated.parts
        entries = generated.entries
    }
    val unitsDone = linuxMonotonicMilliseconds()
    val added = if (status == 0) bootstrapCtSessionState.addObjectFilesWith(parts, session.context, session.module)
        else {
            if (!pointerIsNull(session.module)) {
                LLVMDisposeModule(session.module)
                LLVMContextDispose(session.context)
            }
            LlvmOrcGeneration(nullPointer, status, true)
        }
    Path(directory).removeTree()
    if (added.status == 0 && entries.size > 0) bootstrapCodegenSweepCache(places.cache, entries)
    val inSession = if (unitCounts.size > 0) unitCounts[unitCounts.size - 1] else 0
    bootstrapCtNote("generation $generation ($size instructions) in ${parts.size} units and $inSession functions in the session: passes and writing ${written - started} ms, units ${unitsDone - written} ms, loading ${linuxMonotonicMilliseconds() - unitsDone} ms${if (added.status != 0) " (failed: status ${added.status})" else ""}")
    added
}

fun bootstrapCtLookup(symbol: string): int {
    val found = bootstrapCtSessionState.lookup(symbol)
    if (found.status == 0) found.address else 0
}

// A compiled program's entry hands its runtime the environment; the slice has no entry,
// so it gets the compiler's, as the evaluator gives it: under the `environment`
// capability only (a command found on PATH, linuxEnvironment).
fun bootstrapCtSetEnvironment(context: i64*, module: i64*, grants: int): void {
    val global = LLVMGetNamedGlobal(module, "abla_runtime_environment_vector")
    if (pointerIsNull(global) || !bootstrapCompileEffectHas(grants, 16)) return
    LLVMSetInitializer(global, LLVMConstIntToPtr(
        LLVMConstInt(LLVMInt64TypeInContext(context),
            nativePointerAddress(linuxEnvironmentPointer()), 0),
        LLVMPointerTypeInContext(context, 0)
    ))
}

// --- the guard: a fatal stop in compile-time code returns to the compiler ------------

// A failed check traps, `abort` aborts, and a runtime panic prints its message and
// exits (bootstrapCtCatchPanic); a call past the time limit gets SIGALRM, and one
// that runs its stack past the end SIGSEGV or SIGBUS. In the slice each of them
// becomes a jump back to the entry's guard (`_setjmp`/`_longjmp`, no signal mask),
// so the compiler reports the failure and goes on. The generation is spent
// afterwards: frames the jump skipped never popped their collector roots, so no
// later entry may run on it.
private noescape extern:"c" fun LLVMGetInstructionParent(instruction: i64*): i64*

// Before each call of `callee` (llvm.trap, abort) the name of the function it is in goes to `site`, so a stop names
// where it happened: "a runtime check failed in churn" rather than only that something did. A call in a function of
// the guard itself (the catchers) is left alone. Racing threads store names of their own: the stop names the last.
fun bootstrapCtMarkStopSites(builder: i64*, callee: i64*, site: i64*): void {
    val names: Map<string, i64*> = Map()
    var use = LLVMGetFirstUse(callee)
    while (!pointerIsNull(use)) {
        val user = LLVMGetUser(use)
        use = LLVMGetNextUse(use)
        if (pointerIsNull(LLVMIsACallInst(user))) continue
        val function = LLVMGetBasicBlockParent(LLVMGetInstructionParent(user))
        val name = bootstrapLlvmDebugValueName(function)
        if (name == "" || name.startsWith("abla.ct.")) continue
        LLVMPositionBuilderBefore(builder, user)
        val known = names.get(name)
        val text = if (known != null) known else {
            val made = LLVMBuildGlobalStringPtr(builder, name, "abla.ct.site.name")
            names.set(name, made)
            made
        }
        LLVMBuildStore(builder, text, site)
    }
    return
}

fun bootstrapCtInstallGuard(context: i64*, module: i64*, generation: int): bool {
    val builder = LLVMCreateBuilderInContext(context)
    val voidType = LLVMVoidTypeInContext(context)
    val i1 = LLVMInt1TypeInContext(context)
    val i32Type = LLVMInt32TypeInContext(context)
    val i64Type = LLVMInt64TypeInContext(context)
    val pointer = LLVMPointerTypeInContext(context, 0)
    // 512 bytes hold any supported host's jmp_buf.
    val bufferType = LLVMArrayType2(i64Type, 64)
    val jump = LLVMAddGlobal(module, bufferType, "abla.ct.jump")
    LLVMSetInitializer(jump, LLVMConstNull(bufferType))
    LLVMSetLinkage(jump, llvmInternalLinkage())
    LLVMSetAlignment(jump, 16)
    val armed = LLVMAddGlobal(module, i1, "abla.ct.armed")
    LLVMSetInitializer(armed, LLVMConstInt(i1, 0, 0))
    LLVMSetLinkage(armed, llvmInternalLinkage())
    val returnsTwice = LLVMCreateEnumAttribute(
        context, LLVMGetEnumAttributeKindForName("returns_twice", 13), 0
    )
    val noReturn = LLVMCreateEnumAttribute(
        context, LLVMGetEnumAttributeKindForName("noreturn", 8), 0
    )
    val oneParameter = llvmPointerVector(1)
    oneParameter.set(0, pointer)
    val setjmpType = LLVMFunctionType(i32Type, oneParameter.pointer(), 1, 0)
    var setjmp = LLVMGetNamedFunction(module, "_setjmp")
    if (pointerIsNull(setjmp)) setjmp = LLVMAddFunction(module, "_setjmp", setjmpType)
    LLVMAddAttributeAtIndex(setjmp, -1, returnsTwice)
    val twoParameters = llvmPointerVector(2)
    twoParameters.set(0, pointer)
    twoParameters.set(1, i32Type)
    val longjmpType = LLVMFunctionType(voidType, twoParameters.pointer(), 2, 0)
    var systemLongjmp = LLVMGetNamedFunction(module, "_longjmp")
    if (pointerIsNull(systemLongjmp)) systemLongjmp = LLVMAddFunction(module, "_longjmp", longjmpType)
    LLVMAddAttributeAtIndex(systemLongjmp, -1, noReturn)
    // The thread that called the guard, and a stop another thread asked it for (0: none).
    val guardThread = LLVMAddGlobal(module, i64Type, "abla.ct.guard.thread")
    LLVMSetInitializer(guardThread, LLVMConstInt(i64Type, 0, 0))
    LLVMSetLinkage(guardThread, llvmInternalLinkage())
    val pending = LLVMAddGlobal(module, i32Type, "abla.ct.pending")
    LLVMSetInitializer(pending, LLVMConstInt(i32Type, 0, 0))
    LLVMSetLinkage(pending, llvmInternalLinkage())
    // The function whose trap or abort stopped the call (bootstrapCtMarkStopSites), read by the report (ct_eval.ab).
    val stopSite = LLVMAddGlobal(module, pointer, "abla_ct_stop_site_$generation")
    LLVMSetInitializer(stopSite, LLVMConstNull(pointer))
    val selfType = LLVMFunctionType(i64Type, nativeNullPointer(), 0, 0)
    var pthreadSelf = LLVMGetNamedFunction(module, "pthread_self")
    if (pointerIsNull(pthreadSelf)) pthreadSelf = LLVMAddFunction(module, "pthread_self", selfType)
    // Every jump back to the guard (the trap, abort and panic catchers, the alarm and fault handlers) goes through
    // abla.ct.jump, with _longjmp's type: a jmp_buf is only good on the thread that set it, and a thread the site
    // started can fail too (#831: a fault or a panic in a `thread {}` body jumped onto the compiler's stack from
    // its own thread, which then ran the compiler's code with that thread's state). On the guard's thread it jumps
    // back (with a stop another thread asked for, if any). On another thread it asks the guard's thread to stop
    // (the code in abla.ct.pending, then SIGSEGV to it, whose fault handler jumps back) and parks for good: the
    // compiler ends the build when a stop leaves a thread of the site running (ct_eval.ab, bootstrapCtCall).
    val longjmp = LLVMAddFunction(module, "abla.ct.jump", longjmpType)
    LLVMSetLinkage(longjmp, llvmInternalLinkage())
    LLVMAddAttributeAtIndex(longjmp, -1, noReturn)
    val jumpEntry = LLVMAppendBasicBlockInContext(context, longjmp, "entry")
    val jumpHere = LLVMAppendBasicBlockInContext(context, longjmp, "here")
    val jumpElsewhere = LLVMAppendBasicBlockInContext(context, longjmp, "elsewhere")
    val jumpPark = LLVMAppendBasicBlockInContext(context, longjmp, "park")
    LLVMPositionBuilderAtEnd(builder, jumpEntry)
    val self = LLVMBuildCall2(builder, selfType, pthreadSelf, nativeNullPointer(), 0, "self")
    val owner = LLVMBuildLoad2(builder, i64Type, guardThread, "owner")
    val onGuard = LLVMBuildICmp(builder, llvmIntEqual(), self, owner, "on.guard")
    LLVMBuildCondBr(builder, onGuard, jumpHere, jumpElsewhere)
    LLVMPositionBuilderAtEnd(builder, jumpHere)
    val asked = LLVMBuildLoad2(builder, i32Type, pending, "asked")
    val wasAsked = LLVMBuildICmp(builder, llvmIntNotEqual(), asked, LLVMConstInt(i32Type, 0, 0), "was.asked")
    val code = LLVMBuildSelect(builder, wasAsked, asked, LLVMGetParam(longjmp, 1), "code")
    val realJump = llvmPointerVector(2)
    realJump.set(0, LLVMGetParam(longjmp, 0))
    realJump.set(1, code)
    LLVMBuildCall2(builder, longjmpType, systemLongjmp, realJump.pointer(), 2, "")
    realJump.drop()
    LLVMBuildUnreachable(builder)
    LLVMPositionBuilderAtEnd(builder, jumpElsewhere)
    LLVMBuildStore(builder, LLVMGetParam(longjmp, 1), pending)
    val killParameters = llvmPointerVector(2)
    killParameters.set(0, i64Type)
    killParameters.set(1, i32Type)
    val killType = LLVMFunctionType(i32Type, killParameters.pointer(), 2, 0)
    killParameters.drop()
    var pthreadKill = LLVMGetNamedFunction(module, "pthread_kill")
    if (pointerIsNull(pthreadKill)) pthreadKill = LLVMAddFunction(module, "pthread_kill", killType)
    val killArguments = llvmPointerVector(2)
    killArguments.set(0, owner)
    killArguments.set(1, LLVMConstInt(i32Type, 11, 0))
    LLVMBuildCall2(builder, killType, pthreadKill, killArguments.pointer(), 2, "")
    killArguments.drop()
    LLVMBuildBr(builder, jumpPark)
    LLVMPositionBuilderAtEnd(builder, jumpPark)
    val pauseType = LLVMFunctionType(i32Type, nativeNullPointer(), 0, 0)
    var pause = LLVMGetNamedFunction(module, "pause")
    if (pointerIsNull(pause)) pause = LLVMAddFunction(module, "pause", pauseType)
    LLVMBuildCall2(builder, pauseType, pause, nativeNullPointer(), 0, "")
    LLVMBuildBr(builder, jumpPark)
    // A failed runtime check traps (llvm.trap): it stops the same way.
    val trap = LLVMGetNamedFunction(module, "llvm.trap")
    if (!pointerIsNull(trap)) {
        val trapType = LLVMGlobalGetValueType(trap)
        val catcher = LLVMAddFunction(module, "abla.ct.trap", trapType)
        LLVMSetLinkage(catcher, llvmInternalLinkage())
        bootstrapCtMarkStopSites(builder, trap, stopSite)
        LLVMReplaceAllUsesWith(trap, catcher)
        val entry = LLVMAppendBasicBlockInContext(context, catcher, "entry")
        val back = LLVMAppendBasicBlockInContext(context, catcher, "back")
        val stop = LLVMAppendBasicBlockInContext(context, catcher, "stop")
        LLVMPositionBuilderAtEnd(builder, entry)
        val isArmed = LLVMBuildLoad2(builder, i1, armed, "armed")
        LLVMBuildCondBr(builder, isArmed, back, stop)
        LLVMPositionBuilderAtEnd(builder, back)
        val jumpArguments = llvmPointerVector(2)
        jumpArguments.set(0, jump)
        jumpArguments.set(1, LLVMConstInt(i32Type, 2, 0))
        LLVMBuildCall2(builder, longjmpType, longjmp, jumpArguments.pointer(), 2, "")
        jumpArguments.drop()
        LLVMBuildUnreachable(builder)
        LLVMPositionBuilderAtEnd(builder, stop)
        LLVMBuildCall2(builder, trapType, trap, nativeNullPointer(), 0, "")
        LLVMBuildUnreachable(builder)
    }
    val abort = LLVMGetNamedFunction(module, "abort")
    if (!pointerIsNull(abort)) {
        val abortType = LLVMGlobalGetValueType(abort)
        val catcher = LLVMAddFunction(module, "abla.ct.abort", abortType)
        LLVMSetLinkage(catcher, llvmInternalLinkage())
        bootstrapCtMarkStopSites(builder, abort, stopSite)
        LLVMReplaceAllUsesWith(abort, catcher)
        val entry = LLVMAppendBasicBlockInContext(context, catcher, "entry")
        val back = LLVMAppendBasicBlockInContext(context, catcher, "back")
        val stop = LLVMAppendBasicBlockInContext(context, catcher, "stop")
        LLVMPositionBuilderAtEnd(builder, entry)
        val isArmed = LLVMBuildLoad2(builder, i1, armed, "armed")
        LLVMBuildCondBr(builder, isArmed, back, stop)
        LLVMPositionBuilderAtEnd(builder, back)
        val jumpArguments = llvmPointerVector(2)
        jumpArguments.set(0, jump)
        jumpArguments.set(1, LLVMConstInt(i32Type, 1, 0))
        LLVMBuildCall2(builder, longjmpType, longjmp, jumpArguments.pointer(), 2, "")
        jumpArguments.drop()
        LLVMBuildUnreachable(builder)
        LLVMPositionBuilderAtEnd(builder, stop)
        LLVMBuildCall2(builder, abortType, abort, nativeNullPointer(), 0, "")
        LLVMBuildUnreachable(builder)
    }
    bootstrapCtPanicCaught =
        bootstrapCtCatchPanic(context, module, builder, generation, jump, armed, longjmpType,
            longjmp)
    // void abla_ct_alarm_<g>(i32 signal), the time limit, and void
    // abla_ct_fault_<g>(i32 signal), a bad access (a stack run past its end, on the
    // alternate signal stack): while a call runs each jumps back; otherwise the
    // alarm does nothing and the fault is fatal.
    val signalParameter = llvmPointerVector(1)
    signalParameter.set(0, i32Type)
    val handlerType = LLVMFunctionType(voidType, signalParameter.pointer(), 1, 0)
    signalParameter.drop()
    var handler = 0
    while (handler < 2) {
        val fault = handler == 1
        val function = LLVMAddFunction(
            module, if (fault) "abla_ct_fault_$generation" else "abla_ct_alarm_$generation",
            handlerType
        )
        val handlerEntry = LLVMAppendBasicBlockInContext(context, function, "entry")
        val handlerBack = LLVMAppendBasicBlockInContext(context, function, "back")
        val handlerIdle = LLVMAppendBasicBlockInContext(context, function, "idle")
        LLVMPositionBuilderAtEnd(builder, handlerEntry)
        val handlerArmed = LLVMBuildLoad2(builder, i1, armed, "armed")
        LLVMBuildCondBr(builder, handlerArmed, handlerBack, handlerIdle)
        LLVMPositionBuilderAtEnd(builder, handlerBack)
        val handlerJump = llvmPointerVector(2)
        handlerJump.set(0, jump)
        handlerJump.set(1, LLVMConstInt(i32Type, if (fault) 4 else 3, 0))
        LLVMBuildCall2(builder, longjmpType, longjmp, handlerJump.pointer(), 2, "")
        handlerJump.drop()
        LLVMBuildUnreachable(builder)
        LLVMPositionBuilderAtEnd(builder, handlerIdle)
        if (fault) {
            var fatal = LLVMGetNamedFunction(module, "abort")
            if (pointerIsNull(fatal)) {
                fatal = LLVMAddFunction(module, "abort", LLVMFunctionType(voidType,
                    nativeNullPointer(), 0, 0))
            }
            LLVMBuildCall2(builder, LLVMGlobalGetValueType(fatal), fatal, nativeNullPointer(), 0,
                "")
            LLVMBuildUnreachable(builder)
        } else LLVMBuildRetVoid(builder)
        handler = handler + 1
    }
    // i64 abla_ct_guard_<g>(ptr entry, ptr stopped): the entry's reply with
    // *stopped = 0, or 0 with *stopped = how the call stopped (the jump's value: 1
    // an abort, 2 a trap, 3 the time limit, 4 a bad access, 5 a runtime panic).
    val guardParameters = llvmPointerVector(2)
    guardParameters.set(0, pointer)
    guardParameters.set(1, pointer)
    val guardType = LLVMFunctionType(i64Type, guardParameters.pointer(), 2, 0)
    guardParameters.drop()
    val guard = LLVMAddFunction(module, "abla_ct_guard_$generation", guardType)
    val entry = LLVMAppendBasicBlockInContext(context, guard, "entry")
    val run = LLVMAppendBasicBlockInContext(context, guard, "run")
    val caught = LLVMAppendBasicBlockInContext(context, guard, "caught")
    LLVMPositionBuilderAtEnd(builder, entry)
    val setjmpArguments = llvmPointerVector(1)
    setjmpArguments.set(0, jump)
    val marked = LLVMBuildCall2(
        builder, setjmpType, setjmp, setjmpArguments.pointer(), 1, "marked"
    )
    setjmpArguments.drop()
    LLVMAddCallSiteAttribute(marked, -1, returnsTwice)
    val first = LLVMBuildICmp(
        builder, llvmIntEqual(), marked, LLVMConstInt(i32Type, 0, 0), "first"
    )
    LLVMBuildCondBr(builder, first, run, caught)
    LLVMPositionBuilderAtEnd(builder, run)
    LLVMBuildStore(builder, LLVMConstInt(i64Type, 0, 0), LLVMGetParam(guard, 1))
    LLVMBuildStore(builder,
        LLVMBuildCall2(builder, selfType, pthreadSelf, nativeNullPointer(), 0, "guard.self"), guardThread)
    LLVMBuildStore(builder, LLVMConstInt(i32Type, 0, 0), pending)
    LLVMBuildStore(builder, LLVMConstNull(pointer), stopSite)
    LLVMBuildStore(builder, LLVMConstInt(i1, 1, 0), armed)
    val entryType = LLVMFunctionType(i64Type, nativeNullPointer(), 0, 0)
    val reply = LLVMBuildCall2(
        builder, entryType, LLVMGetParam(guard, 0), nativeNullPointer(), 0, "reply"
    )
    LLVMBuildStore(builder, LLVMConstInt(i1, 0, 0), armed)
    LLVMBuildRet(builder, reply)
    LLVMPositionBuilderAtEnd(builder, caught)
    LLVMBuildStore(builder, LLVMConstInt(i1, 0, 0), armed)
    LLVMBuildStore(builder, LLVMBuildZExt(builder, marked, i64Type, "how"), LLVMGetParam(guard, 1))
    LLVMBuildRet(builder, LLVMConstInt(i64Type, 0, 0))
    oneParameter.drop()
    twoParameters.drop()
    LLVMDisposeBuilder(builder)
    true
}

// A runtime panic (an index out of bounds, a division by zero, ...) prints
// "panic: <message>" and exits with status 101. In the slice it stops the same way
// as `abort`, and its message is kept for the diagnostic: the panic's body, the one
// call in abla_platform_panic, takes the message's address and size, which the
// catcher copies (up to 1 KiB) into abla_ct_panic_text_<g> / abla_ct_panic_size_<g>.
fun bootstrapCtCatchPanic(
    context: i64*,
    module: i64*,
    builder: i64*,
    generation: int,
    jump: i64*,
    armed: i64*,
    longjmpType: i64*,
    longjmp: i64*
): bool {
    val platformPanic = LLVMGetNamedFunction(module, "abla_platform_panic")
    if (pointerIsNull(platformPanic)) return false
    val i1 = LLVMInt1TypeInContext(context)
    val i32Type = LLVMInt32TypeInContext(context)
    val i64Type = LLVMInt64TypeInContext(context)
    val pointer = LLVMPointerTypeInContext(context, 0)
    var body = nativeNullPointer()
    var instruction = LLVMGetFirstInstruction(LLVMGetEntryBasicBlock(platformPanic))
    while (!pointerIsNull(instruction) && pointerIsNull(body)) {
        if (!pointerIsNull(LLVMIsACallInst(instruction))) {
            val callee = LLVMGetCalledValue(instruction)
            if (LLVMCountParams(callee) == 2 &&
                bootstrapCtIsI64(LLVMTypeOf(LLVMGetParam(callee, 0))) &&
                bootstrapCtIsI64(LLVMTypeOf(LLVMGetParam(callee, 1)))) body = callee
        }
        instruction = LLVMGetNextInstruction(instruction)
    }
    if (pointerIsNull(body)) return false
    val textType = LLVMArrayType2(LLVMInt8TypeInContext(context), 1024)
    val text = LLVMAddGlobal(module, textType, "abla_ct_panic_text_$generation")
    LLVMSetInitializer(text, LLVMConstNull(textType))
    val size = LLVMAddGlobal(module, i64Type, "abla_ct_panic_size_$generation")
    LLVMSetInitializer(size, LLVMConstInt(i64Type, 0, 0))
    val bodyType = LLVMGlobalGetValueType(body)
    val catcher = LLVMAddFunction(module, "abla.ct.panic", bodyType)
    LLVMSetLinkage(catcher, llvmInternalLinkage())
    LLVMReplaceAllUsesWith(body, catcher)
    val entry = LLVMAppendBasicBlockInContext(context, catcher, "entry")
    val back = LLVMAppendBasicBlockInContext(context, catcher, "back")
    val stop = LLVMAppendBasicBlockInContext(context, catcher, "stop")
    LLVMPositionBuilderAtEnd(builder, entry)
    val isArmed = LLVMBuildLoad2(builder, i1, armed, "armed")
    LLVMBuildCondBr(builder, isArmed, back, stop)
    LLVMPositionBuilderAtEnd(builder, back)
    val limit = LLVMConstInt(i64Type, 1024, 0)
    val length = LLVMGetParam(catcher, 1)
    val over = LLVMBuildICmp(builder, llvmIntUnsignedGreaterThan(), length, limit, "over")
    val kept = LLVMBuildSelect(builder, over, limit, length, "kept")
    val source = LLVMBuildIntToPtr(builder, LLVMGetParam(catcher, 0), pointer, "message")
    LLVMBuildMemCpy(builder, text, 1, source, 1, kept)
    LLVMBuildStore(builder, kept, size)
    val jumpArguments = llvmPointerVector(2)
    jumpArguments.set(0, jump)
    jumpArguments.set(1, LLVMConstInt(i32Type, 5, 0))
    LLVMBuildCall2(builder, longjmpType, longjmp, jumpArguments.pointer(), 2, "")
    jumpArguments.drop()
    LLVMBuildUnreachable(builder)
    LLVMPositionBuilderAtEnd(builder, stop)
    val arguments = llvmPointerVector(2)
    arguments.set(0, LLVMGetParam(catcher, 0))
    arguments.set(1, length)
    val result = LLVMBuildCall2(builder, bodyType, body, arguments.pointer(), 2, "result")
    arguments.drop()
    LLVMBuildRet(builder, result)
    true
}

// Whether this generation's slice has the panic catcher (its message buffers).
var bootstrapCtPanicCaught: bool = false

fun bootstrapCtIsI64(type: i64*): bool =
    LLVMGetTypeKind(type) == 8 && LLVMGetIntTypeWidth(type) == 64

// A compile pass is over: its generation's code and memory go. `another`: a round or pass of the same compilation
// follows, so what the generation left pending goes to the journal first; at the compilation's end it is left
// unread (bootstrapCtRetirePending).
fun bootstrapCtFinishPass(another: bool = true): void {
    if (bootstrapCtNestedPasses > 0) {
        bootstrapCtNestedPasses = bootstrapCtNestedPasses - 1
        return
    }
    bootstrapCtPassActive = false
    val fetched = bootstrapCtRetirePending(another)
    if (fetched != "") bootstrapStageDriverDiagnostic("error[E_CT_JIT_RESULT]: $fetched\n")
    if (bootstrapCtGenerationLive) {
        val removed = bootstrapCtGenerationState.remove()
        bootstrapCtGenerationLive = false
    }
    bootstrapCtFreeAddress = 0
    bootstrapCtGuardAddress = 0
    bootstrapCtAlarmAddress = 0
    bootstrapCtFaultAddress = 0
    bootstrapCtFunctions = bootstrapCtNoFunctions()
    bootstrapCtPanicTextAddress = 0
    bootstrapCtPanicSizeAddress = 0
    bootstrapCtStopSiteAddress = 0
    // (No fresh array where there is nothing to drop: inside a region it would not
    // outlive it.)
    if (bootstrapCtSites.size > 0) bootstrapCtSites = []
    if (bootstrapCtGlobals.size > 0) bootstrapCtGlobals = []
    return
}

private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool

// A global delegated to a TVar: `by TVar(...)` or `by TVar<T>(...)`.
fun bootstrapCtTVarDelegate(declaration: BootstrapDeclaration): bool {
    val initializer = declaration.expression
    if (initializer.kind != "delegate.initializer" || initializer.children.size == 0) return false
    val delegate = initializer.children[0]
    if (delegate.kind != "call") return false
    // The callee, without type arguments or the module prefix a library's names carry (`__abla_module_<hex>__TVar`).
    val angle = delegate.text.indexOf("<")
    var callee = if (angle >= 0) delegate.text.slice(0, angle) else delegate.text
    // (A generic instantiation's name carries its arguments: `TVar__abla_generic_nullable_cX509TrustStore`.)
    val generic = callee.indexOf("__abla_generic")
    if (generic > 0) callee = callee.slice(0, generic)
    callee == "TVar" || callee.endsWith("__TVar")
}

// What a delegated global is delegated to, for the trace (`call TVar<int>`).
fun bootstrapCtDelegateText(declaration: BootstrapDeclaration): string {
    val initializer = declaration.expression
    if (initializer.kind != "delegate.initializer" || initializer.children.size == 0) return initializer.kind
    "${initializer.children[0].kind} ${initializer.children[0].text}"
}
