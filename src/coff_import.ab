// The import library of a Windows DLL, written without an SDK, `llvm-dlltool` or `llvm-lib` (the Windows target's design,
// docs/design/windows-target.md): an `ar` archive of short import objects (the PE specification's "Import Library Format"),
// one per imported function, with the archive's symbol table (the first linker member) naming `__imp_<name>` and `<name>`
// for each. lld-link reads it as any import library: a reference to `<name>` becomes a call through the import address
// table, and the DLL is named in the executable's import directory. Only functions (the CODE import type, imported by
// name) are written: the runtime imports no variables, and an ordinal import is no use to a program that must run on
// every Windows version of its baseline.
//
// Pure functions of their arguments: the same names give the same bytes (the header's time stamp is 0), which the
// reproducible link of a Windows program relies on.
import "abla/bytes"
import "abla/text"

// IMAGE_FILE_MACHINE_AMD64 and IMAGE_FILE_MACHINE_ARM64.
fun bootstrapCoffMachine(architecture: string): int =
    if (architecture == "x86_64") 34404 else if (architecture == "aarch64") 43620 else 0

fun bootstrapCoffLittle16(value: int): string = byteEncode(value & 255) + byteEncode((value >> 8) & 255)

fun bootstrapCoffLittle32(value: int): string =
    bootstrapCoffLittle16(value & 65535) + bootstrapCoffLittle16((value >> 16) & 65535)

fun bootstrapCoffBig32(value: int): string =
    byteEncode((value >> 24) & 255) + byteEncode((value >> 16) & 255) + byteEncode((value >> 8) & 255) + byteEncode(value & 255)

// One short import object: IMPORT_OBJECT_HEADER (20 bytes), the function's name and the DLL's, each NUL-ended. The type
// word is 4: import type CODE (0) and name type NAME (1, shifted by 2).
fun bootstrapCoffImportObject(dll: string, name: string, machine: int): string {
    val names = name + "\u0000" + dll + "\u0000"
    bootstrapCoffLittle16(0) + bootstrapCoffLittle16(65535) + bootstrapCoffLittle16(0) + bootstrapCoffLittle16(machine) +
        bootstrapCoffLittle32(0) + bootstrapCoffLittle32(names.size) + bootstrapCoffLittle16(0) + bootstrapCoffLittle16(4) + names
}

// An archive member: the 60-byte header (name, date, owner, group, mode, size, end marker), the data, and a newline to
// reach an even offset.
fun bootstrapCoffArchiveMember(name: string, data: string): string {
    val field = (name + "/").padEnd(16, " ")
    val size = "${data.size}".padEnd(10, " ")
    val header = field + "0".padEnd(12, " ") + "0".padEnd(6, " ") + "0".padEnd(6, " ") + "0".padEnd(8, " ") + size + "`\n"
    if (data.size % 2 == 1) header + data + "\n" else header + data
}

// The archive: "!<arch>\n", the symbol table member, then the import objects in the order of `names`. The symbol table is
// the first linker member's layout (big-endian count and member offsets, then the NUL-ended names), two symbols per
// object, each at its object's offset.
fun bootstrapCoffImportLibrary(dll: string, architecture: string, names: array<string>): string {
    val machine = bootstrapCoffMachine(architecture)
    if (machine == 0) return ""
    val objects: array<string> = []
    val members: array<string> = []
    for (name in names) {
        val data = bootstrapCoffImportObject(dll, name, machine)
        objects.append(data)
        members.append(bootstrapCoffArchiveMember("i${objects.size}", data))
    }
    var strings = ""
    for (name in names) strings = strings + "__imp_" + name + "\u0000" + name + "\u0000"
    val count = names.size * 2
    val tableSize = 4 + count * 4 + strings.size
    val tableMember = 60 + tableSize + (if (tableSize % 2 == 1) 1 else 0)
    var offset = 8 + tableMember
    var offsets = ""
    for (member in members) {
        offsets = offsets + bootstrapCoffBig32(offset) + bootstrapCoffBig32(offset)
        offset = offset + member.size
    }
    val table = bootstrapCoffBig32(count) + offsets + strings
    var result = "!<arch>\n" + bootstrapCoffArchiveMember("", table)
    for (member in members) result = result + member
    result
}

// ---- the exports of a Windows executable that links LLVM (docs/design/windows-jit.md §2) ----
// Code the compiler JIT-compiles calls the runtime and the compiler bridge in the compiler's own image, which its process symbol
// generator finds in the loaded modules' export tables: ablac.exe exports every external definition of its object, as the Linux
// compiler does with --export-dynamic.

fun bootstrapCoffU16(bytes: string, at: int): int = bytes[at] + bytes[at + 1] * 256

fun bootstrapCoffU32(bytes: string, at: int): int = bootstrapCoffU16(bytes, at) + bootstrapCoffU16(bytes, at + 2) * 65536

// The names of the symbols a COFF object (the ordinary format, or the big-object one past 65,279 sections) defines and exports:
// storage class EXTERNAL (2) with a section, or WEAK_EXTERNAL (105: defined by its default, as the runtime's routines under C
// library names are, src/backend/llvm/windows.ab), each with " DATA" after it unless its type says function (0x20), in the symbol
// table's order; [] for a file that is not a COFF object.
fun bootstrapCoffDefinedExternals(bytes: string): array<string> {
    val names: array<string> = []
    if (bytes.size < 20) return names
    val big = bootstrapCoffU16(bytes, 0) == 0 && bootstrapCoffU16(bytes, 2) == 65535
    if (big && bytes.size < 56) return names
    val table = bootstrapCoffU32(bytes, if (big) 48 else 8)
    val count = bootstrapCoffU32(bytes, if (big) 52 else 12)
    val record = if (big) 20 else 18
    val strings = table + count * record
    if (table <= 0 || strings + 4 > bytes.size) return names
    var index = 0
    while (index < count) {
        val at = table + index * record
        val section = if (big) bootstrapCoffU32(bytes, at + 12) else bootstrapCoffU16(bytes, at + 12)
        // (A section number is signed: 0 undefined, -1 absolute, -2 debugging; in the ordinary format 16 bits wide.)
        val defined = section > 0 && section < (if (big) 2147483648 else 32768)
        val type = bootstrapCoffU16(bytes, at + (if (big) 16 else 14))
        val storage = bytes[at + (if (big) 18 else 16)]
        if ((defined && storage == 2) || storage == 105) {
            var name = ""
            if (bootstrapCoffU32(bytes, at) == 0) {
                val start = strings + bootstrapCoffU32(bytes, at + 4)
                var end = start
                while (end < bytes.size && bytes[end] != 0) end = end + 1
                name = bytes.slice(start, end)
            } else {
                var end = at
                while (end < at + 8 && bytes[end] != 0) end = end + 1
                name = bytes.slice(at, end)
            }
            if (name != "") names.append(if ((type & 240) == 32) name else "$name DATA")
        }
        index = index + 1 + bytes[at + record - 1]
    }
    names
}

// A module-definition file that exports `names` (bootstrapCoffDefinedExternals' lines) from an executable.
fun bootstrapCoffExportsDefinition(names: array<string>): string =
    if (names.size == 0) "EXPORTS\n" else "EXPORTS\n    ${names.join("\n    ")}\n"
