// Non-annotation names of the static JIT table. These are defined outside
// Abla functions, so compiler.exportedNames cannot discover them.
fun bootstrapStaticLibcExtraSymbolNames(): array<string> = [
    "__ashlti3", // compiler-rt/libgcc: signed wide shift left.
    "__ashrti3", // compiler-rt/libgcc: signed wide shift right.
    "__divti3", // compiler-rt/libgcc: signed wide division.
    "__extendhfsf2", // compiler-rt/libgcc: half to float conversion (x86 only).
    "__fixdfti", // compiler-rt/libgcc: double to signed wide integer.
    "__fixsfti", // compiler-rt/libgcc: float to signed wide integer.
    "__fixunsdfti", // compiler-rt/libgcc: double to unsigned wide integer.
    "__fixunssfti", // compiler-rt/libgcc: float to unsigned wide integer.
    "__floattidf", // compiler-rt/libgcc: signed wide integer to double.
    "__floattisf", // compiler-rt/libgcc: signed wide integer to float.
    "__floatuntidf", // compiler-rt/libgcc: unsigned wide integer to double.
    "__floatuntisf", // compiler-rt/libgcc: unsigned wide integer to float.
    "__lshrti3", // compiler-rt/libgcc: unsigned wide shift right.
    "__modti3", // compiler-rt/libgcc: signed wide remainder.
    "__powidf2", // compiler-rt/libgcc: double raised to an integer power.
    "__powisf2", // compiler-rt/libgcc: float raised to an integer power.
    "__truncdfhf2", // compiler-rt/libgcc: double to half conversion (x86 only).
    "__truncsfhf2", // compiler-rt/libgcc: float to half conversion (x86 only).
    "__udivti3", // compiler-rt/libgcc: unsigned wide division.
    "__umodti3", // compiler-rt/libgcc: unsigned wide remainder.
    "__fprintf_chk", // toolchain.ab: variadic assembly entry to vfprintf.
    "__printf_chk", // toolchain.ab: variadic assembly entry to vprintf.
    "__snprintf_chk", // toolchain.ab: variadic assembly entry to vsnprintf.
    "__libc_single_threaded", // toolchain.ab: one-byte data object.
    "__longjmp_chk", // toolchain.ab: assembly jump to the runtime's _longjmp.
    "_longjmp", // runtime assembly: restore saved registers and stack.
    "_setjmp", // runtime assembly: save registers and stack.
    "bcmp", // runtime assembly: memory comparison alias.
    "memcmp", // runtime assembly: memory comparison.
    "memcpy", // runtime assembly: memory copy.
    "memmove", // runtime assembly: overlapping memory copy.
    "memset", // runtime assembly: memory fill.
    "environ", // toolchain.ab: pointer data object populated at startup.
    "fprintf", // toolchain.ab: variadic assembly entry to vfprintf.
    "printf", // toolchain.ab: variadic assembly entry to vprintf.
    "sprintf", // toolchain.ab: variadic assembly entry to vsnprintf.
    "pthread_create", // toolchain.ab: linker alias to assembly abla_clone_create.
    "pthread_join", // toolchain.ab: linker alias to assembly abla_clone_join.
    "stderr", // toolchain.ab: FILE pointer data object for descriptor 2.
    "stdin", // toolchain.ab: FILE pointer data object for descriptor 0.
    "stdout" // toolchain.ab: FILE pointer data object for descriptor 1.
]

// The original table contained these four names twice. Keep the multiplicity
// so replacing it with reflection leaves both targets' assembly byte-identical.
fun bootstrapStaticLibcLegacyRepeatedNames(): array<string> = [
    "__freelocale", "__memcpy_chk", "__memset_chk", "__realpath_chk"
]

// AArch64's libgcc has no half-float helpers (its instructions do the work).
fun bootstrapStaticLibcExtraSymbolsNotOnAarch64(): array<string> = ["__extendhfsf2", "__truncdfhf2",
    "__truncsfhf2"]
