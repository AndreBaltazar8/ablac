// Temporary code-density legalization for the private Xtensa companion only.
// Exact mappings and raw-region/literal placement follow abla-embedded da5a939
// tools/esp-llvm-bin/narrow-xtensa-assembly, SHA-256 below. Keep the offline
// differential green; replace this stage with native selection in revision 2.
import "abla/bytes"
import "abla/array"
import "abla/text"
import "abla/integer"

val BOOTSTRAP_XTENSA_NARROW_IDENTITY =
    "xtensa-assembly-v3:sdk-da5a939:a2fd95380faf9c54d500cfed1795cad53c557fabd031df31c008e324db2a10c3"

private fun bootstrapXtensaAssemblySpace(byte: int): bool =
    byte == 32 || (byte >= 9 && byte <= 13)

fun bootstrapXtensaAssemblyWords(code: string): array<string> {
    val words: array<string> = []
    var index = 0
    while (index < code.size) {
        if (bootstrapXtensaAssemblySpace(code[index])) index += 1
        else if (code[index] == 44) {
            words.append(",")
            index += 1
        } else {
            val begin = index
            while (index < code.size && !bootstrapXtensaAssemblySpace(code[index]) && code[index] !=
                44) index += 1
            words.append(code.slice(begin, index))
        }
    }
    words
}

fun bootstrapXtensaRegister(word: string): bool {
    if (word.size == 2) return word[0] == 97 && word[1] >= 48 && word[1] <= 57
    word.size == 3 && word[0] == 97 && word[1] == 49 && word[2] >= 48 && word[2] <= 53
}

private fun bootstrapXtensaDecimal(word: string): int? {
    var index = if (word.startsWith("-")) 1 else 0
    if (index == word.size) return null
    while (index < word.size) {
        if (word[index] < 48 || word[index] > 57) return null
        index += 1
    }
    word.parseInt()
}

fun bootstrapXtensaNarrowLine(code: string): string {
    val words = bootstrapXtensaAssemblyWords(code)
    if (words.size != 4 && words.size != 6) return code
    if (!bootstrapXtensaRegister(words[1]) || words[2] != ",") return code
    val op = words[0]
    var indent = 0
    while (indent < code.size && bootstrapXtensaAssemblySpace(code[indent])) indent += 1
    val prefix = code.slice(0, indent)
    if (words.size == 4 && op == "movi") {
        val value = bootstrapXtensaDecimal(words[3])
        if (value != null && value >= -32 && value <=
            95) return "${prefix}movi.n\t${words[1]}, ${words[3]}"
    }
    if (words.size != 6 || !bootstrapXtensaRegister(words[3]) || words[4] != ",") return code
    if (op == "or" && words[3] == words[5]) return "${prefix}mov.n\t${words[1]}, ${words[3]}"
    if (op == "add" &&
        bootstrapXtensaRegister(words[5])) return "${prefix}add.n\t${words[1]}, ${words[3]}, ${words[5]}"
    val value = bootstrapXtensaDecimal(words[5])
    if (value != null) {
        if ((op == "l32i" || op == "s32i") && value >= 0 && value <= 60 && value % 4 == 0) {
            return "$prefix$op.n\t${words[1]}, ${words[3]}, ${words[5]}"
        }
        if (op == "addi" && (value == -1 || (value >= 1 && value <= 15))) {
            return "${prefix}addi.n\t${words[1]}, ${words[3]}, ${words[5]}"
        }
    }
    code
}

fun bootstrapXtensaNarrowAssembly(
    source: string, keepUnwind: bool, narrowInstructions: bool = true
): string {
    val output = byteBuffer()
    val held: array<string> = []
    var verbatim = 0
    var begin = 0
    while (begin < source.size) {
        var end = begin
        while (end < source.size && source[end] != 10) end += 1
        val line = source.slice(begin, end)
        begin = end + 1
        val stripped = line.trim()
        if (!keepUnwind && stripped.startsWith(".cfi_")) continue
        if (verbatim == 0 && (stripped.startsWith(".literal_position") ||
            stripped.startsWith(".literal "))) {
            held.append(line)
            continue
        }
        if (held.size > 0) {
            if (stripped == "" || stripped.startsWith("#") || stripped.startsWith(".section")) {
                output.appendText("$line\n")
                continue
            }
            for (literal in held) output.appendText("$literal\n")
            held.truncate(0)
        }
        var rewritten = line
        if (stripped.startsWith("#APP") || (stripped.startsWith(".begin") &&
            stripped.contains("no-transform"))) verbatim += 1
        else if (stripped.startsWith("#NO_APP") || (stripped.startsWith(".end") &&
            stripped.contains("no-transform"))) {
            if (verbatim > 0) verbatim -= 1
        } else if (narrowInstructions && verbatim == 0 && !stripped.startsWith(".")) {
            var comment = 0
            while (comment < line.size && line[comment] != 35) comment += 1
            val code = line.slice(0, comment).trimEnd()
            val narrowed = bootstrapXtensaNarrowLine(code)
            if (narrowed != code) rewritten = if (comment <
                line.size) "$narrowed ${line.slice(comment, line.size)}" else narrowed
        }
        output.appendText("$rewritten\n")
    }
    for (literal in held) output.appendText("$literal\n")
    output.toText()
}

// Literal pools made by inline-assembly MOVI take emitLiteral's path, whose
// section lacks an alignment declaration in LLVM 23.1.3. Declare it in assembly
// before object emission; never patch object bytes or their section headers.
fun bootstrapXtensaAlignedAssembly(source: string): string {
    val pools: array<string> = []
    var section = ".text"
    var previous = ".text"
    val sections: array<string> = []
    for (line in source.split("\n")) {
        val words = bootstrapXtensaAssemblyWords(line)
        if (words.size >= 2 && (words[0] == ".section" || words[0] == ".pushsection")) {
            if (words[0] == ".pushsection") sections.append(section)
            previous = section
            section = words[1]
            if (section.startsWith("\"") && section.endsWith("\"")) section = section.slice(1,
                section.size - 1)
        } else if (words.size >= 1) {
            val directive = words[0]
            if (directive == ".popsection" && sections.size > 0) {
                previous = section
                section = sections.removeLast()
            } else if (directive == ".previous") {
                val saved = section
                section = previous
                previous = saved
            } else if (directive == ".text" || directive == ".data" || directive == ".bss") {
                previous = section
                section = directive
            }
        }
        var literal = words.size >= 1 && words[0] == ".literal"
        if (words.size >= 4 && words[0] == "movi" && words[2] == ",") {
            val value = if (words.size == 4) bootstrapXtensaDecimal(words[3]) else null
            literal = value == null || value < -2048 || value > 2047
        }
        if (literal) {
            var pos = 0
            while (pos < section.size && !section.slice(pos,
                section.size).startsWith(".text")) pos += 1
            val pool = if (pos == section.size) "$section.literal"
                else "${section.slice(0, pos)}${if (pos > 0) ".text" else ""}.literal${section.slice(pos + 5, section.size)}"
            var found = false
            for (existing in pools) if (pool == existing) found = true
            if (!found) pools.append(pool)
        }
    }
    val output = byteBuffer()
    output.appendText(source)
    for (pool in pools) output
        .appendText(".pushsection $pool,\"ax\",@progbits\n.p2align 2\n.popsection\n")
    output.toText()
}

fun bootstrapXtensaAssemblyModule(source: string): string {
    val output = byteBuffer()
    val hex = "0123456789ABCDEF"
    // The empty module must not acquire the temporary filename/PID as an
    // ELF file symbol. Its one canonical file directive replaces llc's initial
    // unnumbered directive; numbered DWARF file directives stay untouched.
    val initialFile = "\t.file\t\"abla\"\n"
    val assembly = if (source.startsWith(initialFile)) source.slice(initialFile.size,
        source.size) else source
    output
        .appendText("source_filename = \"abla\"\ntarget triple = \"xtensa-esp-unknown-elf\"\nmodule asm \"")
    for (byte in assembly) {
        if (byte >= 32 && byte < 127 && byte != 34 && byte != 92) output.appendByteValue(byte)
        else {
            output.appendText("\\")
            output.appendByteValue(hex[byte / 16])
            output.appendByteValue(hex[byte % 16])
        }
    }
    output.appendText("\"\n")
    output.toText()
}
