// Fixed-width integers in the compile-time evaluator. An evaluated integer
// carries its scalar type in its value's `owner` ("" for int/i64, else i8,
// i16, i32, u8, u16, u32, u64 or char) and a nominal scalar's name (`type Pin
// = int`) in its `text`. A value is kept canonical: the exact value in its
// type's range, except u64, which keeps its 64-bit pattern. Every operation
// wraps its result to its operands' width the way the program's fixed-width
// code does, so a computation under `#` gives what it gives at run time.

import "abla/bits"

/** `type`'s width tag when it is a builtin integer type ("" for int and
 *  i64), else "-". */
fun bootstrapEvalIntegerWidth(type: string): string =
    if (type == "int" || type == "i64") ""
    else if (type == "i8" || type == "i16" || type == "i32" ||
             type == "u8" || type == "u16" || type == "u32" ||
             type == "u64" || type == "char") type
    else "-"

fun bootstrapEvalWidthBits(width: string): int =
    if (width == "i8" || width == "u8" || width == "char") 8
    else if (width == "i16" || width == "u16") 16
    else if (width == "i32" || width == "u32") 32
    else 64

fun bootstrapEvalWidthSigned(width: string): bool =
    width == "" || width == "i8" || width == "i16" || width == "i32"

/** `value` wrapped into `width`'s range (two's complement truncation). */
fun bootstrapEvalWrap(value: int, width: string): int {
    val bits = bootstrapEvalWidthBits(width)
    if (bits == 64) return value
    val mask = (1 << bits) - 1
    val low = bitAnd(value, mask)
    if (bootstrapEvalWidthSigned(width)) {
        val sign = 1 << (bits - 1)
        bitXor(low, sign) - sign
    } else low
}

/** The width of a binary operation: its typed operand's (a literal adopts
 *  the other operand's type). */
fun bootstrapEvalOperationWidth(left: string, right: string): string =
    if (left != "") left else right

/** `left < right` over u64 bit patterns. */
fun bootstrapEvalUnsignedLess(left: int, right: int): bool =
    bitXor(left, -9223372036854775807 - 1) < bitXor(right, -9223372036854775807 - 1)

fun bootstrapEvalUnsignedCompare(operation: string, left: int, right: int): bool =
    if (operation == "<") bootstrapEvalUnsignedLess(left, right)
    else if (operation == "<=") !bootstrapEvalUnsignedLess(right, left)
    else if (operation == ">") bootstrapEvalUnsignedLess(right, left)
    else !bootstrapEvalUnsignedLess(left, right)

/** `left / right` over u64 bit patterns (`right` nonzero). */
fun bootstrapEvalUnsignedDivide(left: int, right: int): int {
    if (right < 0) return if (bootstrapEvalUnsignedLess(left, right)) 0 else 1
    if (left >= 0) return left / right
    var quotient = bitShiftLeft(bitShiftRightUnsigned(left, 1) / right, 1)
    val remainder = left - quotient * right
    if (!bootstrapEvalUnsignedLess(remainder, right)) quotient = quotient + 1
    quotient
}

fun bootstrapEvalUnsignedRemainder(left: int, right: int): int =
    left - bootstrapEvalUnsignedDivide(left, right) * right

/** `left op right` for integer arithmetic at `width`. */
fun bootstrapEvalIntegerArithmetic(
    operation: string,
    left: int,
    right: int,
    width: string
): int {
    var value = left + right
    if (operation == "-") value = left - right
    if (operation == "*") value = left * right
    if (operation == "/") {
        value = if (width == "u64") bootstrapEvalUnsignedDivide(left, right)
            else left / right
    }
    if (operation == "%") {
        value = if (width == "u64") bootstrapEvalUnsignedRemainder(left, right)
            else left - (left / right) * right
    }
    bootstrapEvalWrap(value, width)
}

/** `left op right` for the bitwise and shift operators at `width`: `>>` is
 *  logical for unsigned types and `>>>` logical at every width. */
fun bootstrapEvalIntegerBitwise(
    operation: string,
    left: int,
    right: int,
    width: string
): int {
    val bits = bootstrapEvalWidthBits(width)
    // A shift count converts to the shifted value's width first; one below
    // zero or not below the width gives zero.
    val count = bootstrapEvalWrap(right, width)
    val shiftOut = count < 0 || count >= bits
    var value = bitAnd(left, right)
    if (operation == "|") value = bitOr(left, right)
    if (operation == "^") value = bitXor(left, right)
    if (operation == "<<") value = if (shiftOut) 0 else bitShiftLeft(left, count)
    if (operation == ">>") {
        value = if (shiftOut) 0
            else if (width == "u64") bitShiftRightUnsigned(left, count)
            else bitShiftRight(left, count)
    }
    if (operation == ">>>") {
        val pattern = if (bits == 64) left else bitAnd(left, (1 << bits) - 1)
        value = if (shiftOut) 0 else bitShiftRightUnsigned(pattern, count)
    }
    bootstrapEvalWrap(value, width)
}

/** `value` as decimal text, unsigned for u64. */
fun bootstrapEvalIntegerText(value: int, width: string): string {
    if (width != "u64" || value >= 0) return "$value"
    // The u64 pattern's value is 2^64 + value: halve it unsigned, then
    // append the last digit.
    val half = bitShiftRightUnsigned(value, 1) / 5
    val digit = value - half * 10
    "$half$digit"
}
