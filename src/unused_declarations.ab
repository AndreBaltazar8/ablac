// W_UNUSED_DECLARATION (opt-in: --warn-unused-declarations, the editor's initialize `unusedDeclarations`): a top-level `fun` or
// `val`/`var` that nothing in the build refers to. The references are what lowering's reachability reads (calls, names, a
// global that holds a function, `findFunction("name")`), taken from every body and not only from the roots, so a cluster of
// unused functions that call each other is not found (a function's own recursion is not a use of it).
import "sema.ab"
import "ir.ab"
import "parser.ab"
import "module_paths.ab"
import "abla/text"

/** The annotations that leave a declaration to the linker, a caller or a test runner: it has uses the source does not show. */
fun bootstrapUnusedDeclarationExempt(declaration: BootstrapDeclaration): bool {
    for (annotation in declaration.annotations) {
        if (annotation != "noinline" && annotation != "inline") return true
    }
    declaration.name == "main" || declaration.generatedNamespace != "" ||
        declaration.extensionOwner != "" || declaration.externalLibrary != ""
}

/** Whether `expression` calls anything: a global whose initializer does runs for its effect (`val started = startServer()`). */
fun bootstrapUnusedDeclarationCalls(expression: BootstrapExpression): bool {
    if (expression.kind == "call" || expression.kind == "member.call") return true
    for (child in expression.children) {
        if (bootstrapUnusedDeclarationCalls(child)) return true
    }
    false
}

/** Every identifier of `text` is mentioned by declaration `owner` (-3: the program's top-level actions): the first mentioner is
 *  kept, and -2 once two differ. A type is used when something other than its own declaration mentions its name. */
fun bootstrapUnusedMention(text: string, owner: int, var mentions: Map<string, int>): void {
    var index = 0
    while (index < text.size) {
        val byte = text[index]
        if (((byte >= 65 && byte <= 90) || byte == 95 || (byte >= 97 && byte <= 122))) {
            val begin = index
            while (index < text.size && ((text[index] >= 48 && text[index] <= 57) || (text[index] >= 65 && text[index] <= 90) ||
                text[index] == 95 || (text[index] >= 97 && text[index] <= 122))) index = index + 1
            val name = text.slice(begin, index)
            val known = mentions.get(name)
            if (known == null) mentions.set(name, owner)
            else if (known != owner && known != -2) mentions.set(name, -2)
        } else index = index + 1
    }
    return
}

fun bootstrapUnusedMentionExpression(expression: BootstrapExpression, owner: int, var mentions: Map<string, int>): void {
    bootstrapUnusedMention(expression.text, owner, mentions)
    for (child in expression.children) bootstrapUnusedMentionExpression(child, owner, mentions)
    return
}

/** What `declaration` (and its methods) writes of other names: its types, conformances, annotations and bodies (not its own name). */
fun bootstrapUnusedMentionDeclaration(declaration: BootstrapDeclaration, owner: int, var mentions: Map<string, int>): void {
    for (type in declaration.parameterTypes) bootstrapUnusedMention(type, owner, mentions)
    for (type in declaration.conformances) bootstrapUnusedMention(type, owner, mentions)
    for (type in declaration.typeParameters) bootstrapUnusedMention(type, owner, mentions)
    for (annotation in declaration.annotations) bootstrapUnusedMention(annotation, owner, mentions)
    for (argument in declaration.annotationArguments) bootstrapUnusedMentionExpression(argument, owner, mentions)
    for (fallback in declaration.parameterDefaults) bootstrapUnusedMentionExpression(fallback, owner, mentions)
    bootstrapUnusedMention(declaration.resultType, owner, mentions)
    bootstrapUnusedMention(declaration.extensionOwner, owner, mentions)
    // `extend Square : Printable` names the type it extends.
    if (declaration.kind == "extend") bootstrapUnusedMention(declaration.name, owner, mentions)
    bootstrapUnusedMentionExpression(declaration.expression, owner, mentions)
    for (method in declaration.methods) bootstrapUnusedMentionDeclaration(method, owner, mentions)
    return
}

/** Records the unused declarations of `parsed` (see bootstrapUnusedDeclarationList): `shadowed` and `implicitNames` are the
 *  analysis's (locals named like a global; calls lowering inserts). Whether a declaration is public is the module's to say:
 *  in a build with a `main` every declaration nothing refers to is reported (bootstrapUnusedDeclarationWarnings drops the public
 *  ones of a project that is a package, whose users this build cannot see). */
fun bootstrapNoteUnusedDeclarations(
    parsed: BootstrapParseResult,
    shadowed: BootstrapStringSet,
    implicitNames: array<string>
): void {
    val declarations = parsed.declarations
    val functions = bootstrapFunctionDeclarationIndex(declarations)
    val types = bootstrapTypeDeclarationIndex(declarations)
    val values = bootstrapValueDeclarationIndex(declarations)
    val methods = bootstrapMethodDeclarationIndex(declarations)
    val referenced: array<bool> = []
    val scratch: array<bool> = []
    var hasMain = false
    for (declaration in declarations) {
        referenced.append(false)
        scratch.append(false)
        if (declaration.kind == "fun" && declaration.name == "main") hasMain = true
    }
    for (name in implicitNames) {
        val index = functions.find(name)
        if (index >= 0) referenced[index] = true
    }
    // What each declaration's bodies refer to, other than itself; then what the program's top-level actions refer to.
    for (index in 0 until declarations.size) {
        val declaration = declarations[index]
        val pending: array<int> = []
        bootstrapCollectSourceReachability(declaration.expression, declarations, functions, types, values, methods,
            scratch, pending, declaration.sourceIdentity, shadowed)
        for (fallback in declaration.parameterDefaults) {
            bootstrapCollectSourceReachability(fallback, declarations, functions, types, values, methods,
                scratch, pending, declaration.sourceIdentity, shadowed)
        }
        for (method in declaration.methods) {
            bootstrapCollectSourceReachability(method.expression, declarations, functions, types, values, methods,
                scratch, pending, method.sourceIdentity, shadowed)
            for (fallback in method.parameterDefaults) {
                bootstrapCollectSourceReachability(fallback, declarations, functions, types, values, methods,
                    scratch, pending, method.sourceIdentity, shadowed)
            }
        }
        for (reached in pending) {
            if (reached != index) referenced[reached] = true
            scratch[reached] = false
        }
    }
    val pending: array<int> = []
    for (action in parsed.actions) {
        bootstrapCollectSourceReachability(action, declarations, functions, types, values, methods, scratch, pending, "", shadowed)
    }
    for (reached in pending) referenced[reached] = true
    // The types: one named by anything but its own declaration (a parameter, result or field type, an `is`, an annotation, a string
    // naming it to compile-time reflection, an extension) is used.
    val mentions: Map<string, int> = Map()
    for (index in 0 until declarations.size) bootstrapUnusedMentionDeclaration(declarations[index], index, mentions)
    for (action in parsed.actions) bootstrapUnusedMentionExpression(action, -3, mentions)
    bootstrapUnusedDeclarationList = []
    for (index in 0 until declarations.size) {
        val declaration = declarations[index]
        val isType = declaration.kind == "class" || declaration.kind == "interface" || declaration.kind == "type"
        if (isType) {
            val mentioned = mentions.get(declaration.name)
            referenced[index] = mentioned != null && mentioned != index
        }
        if (referenced[index] || bootstrapUnusedDeclarationExempt(declaration)) continue
        // A private name carries its module's prefix (bootstrapAppendPrivateNames): the name as written is what is reported.
        // (`__abla_module_<hex of the path>__`: the hex has no underscore.)
        var written = declaration.name
        if (written.startsWith("__abla_module_")) {
            val end = written.indexOf("__", 14)
            if (end >= 0) written = written.slice(end + 2, written.size)
        }
        if (written.startsWith("_")) continue
        if (!isType && declaration.kind != "fun" && declaration.kind != "val" && declaration.kind != "var") continue
        if (!hasMain && !declaration.isPrivate) continue
        if (!isType && declaration.kind != "fun" && bootstrapUnusedDeclarationCalls(declaration.expression)) continue
        bootstrapUnusedDeclarationList.append(BootstrapUnusedLocal(
            "abla:${bootstrapSourceKey(declaration.sourceIdentity)}:${declaration.begin}:declaration:${declaration.name}",
            written, declaration.sourceIdentity, declaration.begin, declaration.end,
            (if (declaration.isPrivate) "private " else "") + (if (declaration.kind == "fun") "function" else if (isType) declaration.kind else "value")))
    }
    return
}
