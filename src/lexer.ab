// Self-hosted compiler lexer, built and executed by stage 0 during bootstrap.
// Token kinds are strings in this first portable representation so snapshots
// remain readable before enum and tagged-union support lands.

class BootstrapToken(
    val kind: string,
    val begin: int,
    val end: int
)

fun bootstrapTokenText(source: string, token: BootstrapToken): string =
    source.slice(token.begin, token.end)

fun bootstrapAt(source: string, offset: int, byte: int): bool =
    offset >= 0 && offset < source.size && source[offset] == byte

fun bootstrapIsAlpha(byte: int): bool =
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122) ||
    byte == 95

fun bootstrapIsDigit(byte: int): bool = byte >= 48 && byte <= 57

fun bootstrapIsHexDigit(byte: int): bool =
    bootstrapIsDigit(byte) || (byte >= 65 && byte <= 70) ||
    (byte >= 97 && byte <= 102)

fun bootstrapIsAlphaNumeric(byte: int): bool =
    bootstrapIsAlpha(byte) || bootstrapIsDigit(byte)

fun bootstrapRegionEquals(
    source: string,
    begin: int,
    end: int,
    expected: string
): bool {
    var equal = end - begin == expected.size
    var index = 0
    while (equal && index < expected.size) {
        if (source[begin + index] != expected[index]) equal = false
        index = index + 1
    }
    equal
}

fun bootstrapKeyword(source: string, begin: int, end: int): string {
    var kind = "identifier"
    if (bootstrapRegionEquals(source, begin, end, "abstract")) kind = "abstract"
    if (bootstrapRegionEquals(source, begin, end, "await")) kind = "await"
    if (bootstrapRegionEquals(source, begin, end, "break")) kind = "break"
    if (bootstrapRegionEquals(source, begin, end, "class")) kind = "class"
    if (bootstrapRegionEquals(source, begin, end, "compile")) kind = "compile"
    if (bootstrapRegionEquals(source, begin, end, "constructor")) kind = "constructor"
    if (bootstrapRegionEquals(source, begin, end, "continue")) kind = "continue"
    if (bootstrapRegionEquals(source, begin, end, "defer")) kind = "defer"
    if (bootstrapRegionEquals(source, begin, end, "do")) kind = "do"
    if (bootstrapRegionEquals(source, begin, end, "else")) kind = "else"
    if (bootstrapRegionEquals(source, begin, end, "extern")) kind = "extern"
    if (bootstrapRegionEquals(source, begin, end, "false")) kind = "false"
    if (bootstrapRegionEquals(source, begin, end, "for")) kind = "for"
    if (bootstrapRegionEquals(source, begin, end, "fun")) kind = "fun"
    if (bootstrapRegionEquals(source, begin, end, "generator")) kind = "generator"
    if (bootstrapRegionEquals(source, begin, end, "if")) kind = "if"
    if (bootstrapRegionEquals(source, begin, end, "in")) kind = "in"
    if (bootstrapRegionEquals(source, begin, end, "interface")) kind = "interface"
    if (bootstrapRegionEquals(source, begin, end, "import")) kind = "import"
    if (bootstrapRegionEquals(source, begin, end, "null")) kind = "null"
    if (bootstrapRegionEquals(source, begin, end, "noescape")) kind = "noescape"
    if (bootstrapRegionEquals(source, begin, end, "own")) kind = "own"
    if (bootstrapRegionEquals(source, begin, end, "resource")) kind = "resource"
    if (bootstrapRegionEquals(source, begin, end, "region")) kind = "region"
    if (bootstrapRegionEquals(source, begin, end, "return")) kind = "return"
    if (bootstrapRegionEquals(source, begin, end, "task")) kind = "task"
    if (bootstrapRegionEquals(source, begin, end, "thread")) kind = "thread"
    if (bootstrapRegionEquals(source, begin, end, "true")) kind = "true"
    if (bootstrapRegionEquals(source, begin, end, "until")) kind = "until"
    if (bootstrapRegionEquals(source, begin, end, "trusted")) kind = "trusted"
    if (bootstrapRegionEquals(source, begin, end, "val")) kind = "val"
    if (bootstrapRegionEquals(source, begin, end, "var")) kind = "var"
    if (bootstrapRegionEquals(source, begin, end, "when")) kind = "when"
    if (bootstrapRegionEquals(source, begin, end, "while")) kind = "while"
    if (bootstrapRegionEquals(source, begin, end, "yield")) kind = "yield"
    kind
}

fun bootstrapPunctuation(byte: int): string {
    var kind = "invalid"
    if (byte == 46) kind = "."
    if (byte == 58) kind = ":"
    if (byte == 44) kind = ","
    if (byte == 35) kind = "#"
    if (byte == 36) kind = "$"
    if (byte == 40) kind = "("
    if (byte == 41) kind = ")"
    if (byte == 91) kind = "["
    if (byte == 93) kind = "]"
    if (byte == 123) kind = "{"
    if (byte == 125) kind = "}"
    if (byte == 59) kind = ";"
    if (byte == 64) kind = "@"
    if (byte == 63) kind = "?"
    if (byte == 94) kind = "^"
    if (byte == 38) kind = "&"
    if (byte == 124) kind = "|"
    if (byte == 126) kind = "~"
    if (byte == 43) kind = "+"
    if (byte == 45) kind = "-"
    if (byte == 42) kind = "*"
    if (byte == 47) kind = "/"
    if (byte == 37) kind = "%"
    if (byte == 61) kind = "="
    if (byte == 33) kind = "!"
    if (byte == 60) kind = "<"
    if (byte == 62) kind = ">"
    kind
}

fun bootstrapFindInterpolationEnd(source: string, begin: int): int {
    var offset = begin
    var depth = 1
    var quoted = false
    while (offset < source.size && depth > 0) {
        val byte = source[offset]
        if (quoted) {
            if (byte == 92 && offset + 1 < source.size) offset = offset + 2
            else {
                if (byte == 34) quoted = false
                else quoted = quoted
                offset = offset + 1
            }
        } else {
            if (byte == 34) quoted = true
            else quoted = quoted
            if (byte == 123) depth = depth + 1
            else depth = depth
            if (byte == 125) depth = depth - 1
            else depth = depth
            if (depth > 0) offset = offset + 1
            else offset = offset
        }
    }
    offset
}

fun bootstrapLex(source: string): array<BootstrapToken> {
    val tokens: array<BootstrapToken> = []
    var offset = 0
    while (offset < source.size) {
        val begin = offset
        val byte = source[offset]
        var handled = false

        if (!handled && (byte == 32 || byte == 9 || byte == 12)) {
            offset = offset + 1
            handled = true
        }

        if (!handled && (byte == 10 || byte == 13)) {
            offset = offset + 1
            if (byte == 13 && bootstrapAt(source, offset, 10)) offset = offset + 1
            tokens.append(BootstrapToken("newline", begin, offset))
            handled = true
        }

        if (!handled && bootstrapIsAlpha(byte)) {
            offset = offset + 1
            while (
                offset < source.size &&
                bootstrapIsAlphaNumeric(source[offset])
            ) offset = offset + 1
            tokens.append(BootstrapToken(
                bootstrapKeyword(source, begin, offset),
                begin,
                offset
            ))
            handled = true
        }

        if (!handled && bootstrapIsDigit(byte)) {
            offset = offset + 1
            var floating = false
            if (byte == 48 && offset < source.size &&
                (source[offset] == 120 || source[offset] == 88)) {
                offset = offset + 1
                while (offset < source.size &&
                    (bootstrapIsHexDigit(source[offset]) ||
                     source[offset] == 95)) offset = offset + 1
            } else {
                while (offset < source.size &&
                    (bootstrapIsDigit(source[offset]) ||
                     source[offset] == 95)) offset = offset + 1
                if (offset + 1 < source.size && source[offset] == 46 &&
                    bootstrapIsDigit(source[offset + 1])) {
                    floating = true
                    offset = offset + 2
                    while (offset < source.size &&
                        (bootstrapIsDigit(source[offset]) ||
                         source[offset] == 95)) offset = offset + 1
                }
                if (offset < source.size &&
                    (source[offset] == 101 || source[offset] == 69)) {
                    var exponent = offset + 1
                    if (exponent < source.size &&
                        (source[exponent] == 43 ||
                         source[exponent] == 45)) exponent = exponent + 1
                    if (exponent < source.size &&
                        bootstrapIsDigit(source[exponent])) {
                        floating = true
                        offset = exponent + 1
                        while (offset < source.size &&
                            (bootstrapIsDigit(source[offset]) ||
                             source[offset] == 95)) offset = offset + 1
                    }
                }
            }
            tokens.append(BootstrapToken(
                if (floating) "float" else "integer", begin, offset
            ))
            handled = true
        }

        if (!handled && byte == 47 && bootstrapAt(source, offset + 1, 47)) {
            offset = offset + 2
            while (
                offset < source.size &&
                source[offset] != 10 &&
                source[offset] != 13
            ) offset = offset + 1
            handled = true
        }

        if (!handled && byte == 47 && bootstrapAt(source, offset + 1, 42)) {
            offset = offset + 2
            var depth = 1
            while (offset < source.size && depth > 0) {
                if (
                    bootstrapAt(source, offset, 47) &&
                    bootstrapAt(source, offset + 1, 42)
                ) {
                    depth = depth + 1
                    offset = offset + 2
                } else if (
                    bootstrapAt(source, offset, 42) &&
                    bootstrapAt(source, offset + 1, 47)
                ) {
                    depth = depth - 1
                    offset = offset + 2
                } else offset = offset + 1
            }
            handled = true
        }

        if (!handled && byte == 34) {
            offset = offset + 1
            tokens.append(BootstrapToken("string-start", begin, offset))
            var textBegin = offset
            while (offset < source.size && source[offset] != 34) {
                if (source[offset] == 92 && offset + 1 < source.size) {
                    offset = offset + 2
                } else if (
                    source[offset] == 36 &&
                    bootstrapAt(source, offset + 1, 123)
                ) {
                    if (textBegin < offset) {
                        tokens.append(BootstrapToken(
                            "string-text",
                            textBegin,
                            offset
                        ))
                    }
                    val interpolation = offset
                    val expressionBegin = offset + 2
                    val expressionEnd = bootstrapFindInterpolationEnd(
                        source,
                        expressionBegin
                    )
                    tokens.append(BootstrapToken(
                        "interpolation-start",
                        interpolation,
                        expressionBegin
                    ))
                    val nested = bootstrapLex(
                        source.slice(expressionBegin, expressionEnd)
                    )
                    var nestedIndex = 0
                    while (nestedIndex + 1 < nested.size) {
                        tokens.append(BootstrapToken(
                            nested[nestedIndex].kind,
                            expressionBegin + nested[nestedIndex].begin,
                            expressionBegin + nested[nestedIndex].end
                        ))
                        nestedIndex = nestedIndex + 1
                    }
                    if (bootstrapAt(source, expressionEnd, 125)) {
                        tokens.append(BootstrapToken(
                            "interpolation-end",
                            expressionEnd,
                            expressionEnd + 1
                        ))
                        offset = expressionEnd + 1
                    } else {
                        tokens.append(BootstrapToken(
                            "invalid",
                            interpolation,
                            expressionEnd
                        ))
                        offset = expressionEnd
                    }
                    textBegin = offset
                } else if (
                    source[offset] == 36 &&
                    offset + 1 < source.size &&
                    bootstrapIsAlpha(source[offset + 1])
                ) {
                    if (textBegin < offset) {
                        tokens.append(BootstrapToken(
                            "string-text",
                            textBegin,
                            offset
                        ))
                    }
                    val identifierBegin = offset + 1
                    offset = identifierBegin + 1
                    while (offset < source.size &&
                           bootstrapIsAlphaNumeric(source[offset])) {
                        offset = offset + 1
                    }
                    tokens.append(BootstrapToken(
                        "interpolation-identifier",
                        identifierBegin,
                        offset
                    ))
                    textBegin = offset
                } else offset = offset + 1
            }
            if (textBegin < offset) {
                tokens.append(BootstrapToken("string-text", textBegin, offset))
            }
            if (bootstrapAt(source, offset, 34)) {
                val quote = offset
                offset = offset + 1
                tokens.append(BootstrapToken("string-end", quote, offset))
            } else tokens.append(BootstrapToken("invalid", begin, offset))
            handled = true
        }

        if (!handled) {
            var kind = bootstrapPunctuation(byte)
            var width = 1
            if (byte == 45 && bootstrapAt(source, offset + 1, 62)) {
                kind = "->"
                width = 2
            }
            if (byte == 46 && bootstrapAt(source, offset + 1, 46)) {
                kind = ".."
                width = 2
            }
            if (byte == 61 && bootstrapAt(source, offset + 1, 61)) {
                kind = "=="
                width = 2
            }
            if (byte == 33 && bootstrapAt(source, offset + 1, 61)) {
                kind = "!="
                width = 2
            }
            if (byte == 60 && bootstrapAt(source, offset + 1, 61)) {
                kind = "<="
                width = 2
            }
            if (byte == 62 && bootstrapAt(source, offset + 1, 61)) {
                kind = ">="
                width = 2
            }
            if (byte == 60 && bootstrapAt(source, offset + 1, 60)) {
                kind = "<<"
                width = 2
            }
            if (byte == 62 && bootstrapAt(source, offset + 1, 62)) {
                kind = ">>"
                width = 2
                if (bootstrapAt(source, offset + 2, 62)) {
                    kind = ">>>"
                    width = 3
                }
            }
            if (byte == 38 && bootstrapAt(source, offset + 1, 38)) {
                kind = "&&"
                width = 2
            }
            if (byte == 124 && bootstrapAt(source, offset + 1, 124)) {
                kind = "||"
                width = 2
            }
            offset = offset + width
            tokens.append(BootstrapToken(kind, begin, offset))
        }
    }
    tokens.append(BootstrapToken("end", offset, offset))
    tokens
}
