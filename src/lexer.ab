import "abla/unsafe/memory/raw"

// Self-hosted compiler lexer, built and executed by stage 0 during bootstrap.
// Integer token kinds avoid string dispatch and managed fields on every token.
// Names remain available for diagnostics, subparser grammars and AST construction.

val BOOTSTRAP_TOKEN_INVALID = 0
val BOOTSTRAP_TOKEN_END = 1
val BOOTSTRAP_TOKEN_NEWLINE = 2
val BOOTSTRAP_TOKEN_IDENTIFIER = 3
val BOOTSTRAP_TOKEN_INTEGER = 4
val BOOTSTRAP_TOKEN_FLOAT = 5
val BOOTSTRAP_TOKEN_STRING_START = 6
val BOOTSTRAP_TOKEN_STRING_TEXT = 7
val BOOTSTRAP_TOKEN_STRING_END = 8
val BOOTSTRAP_TOKEN_INTERPOLATION_BEGIN = 9
val BOOTSTRAP_TOKEN_INTERPOLATION_END = 10
val BOOTSTRAP_TOKEN_INTERPOLATION_IDENTIFIER = 11
val BOOTSTRAP_TOKEN_AWAIT = 12
val BOOTSTRAP_TOKEN_BREAK = 13
val BOOTSTRAP_TOKEN_CLASS = 14
val BOOTSTRAP_TOKEN_COMPILE = 15
val BOOTSTRAP_TOKEN_CONTINUE = 16
val BOOTSTRAP_TOKEN_DEFER = 17
val BOOTSTRAP_TOKEN_DO = 18
val BOOTSTRAP_TOKEN_ELSE = 19
val BOOTSTRAP_TOKEN_EXTERN = 20
val BOOTSTRAP_TOKEN_FALSE = 21
val BOOTSTRAP_TOKEN_FOR = 22
val BOOTSTRAP_TOKEN_FUN = 23
val BOOTSTRAP_TOKEN_GENERATOR = 24
val BOOTSTRAP_TOKEN_IF = 25
val BOOTSTRAP_TOKEN_IN = 26
val BOOTSTRAP_TOKEN_INTERFACE = 27
val BOOTSTRAP_TOKEN_IMPORT = 28
val BOOTSTRAP_TOKEN_NULL = 29
val BOOTSTRAP_TOKEN_NOESCAPE = 30
val BOOTSTRAP_TOKEN_RESOURCE = 31
val BOOTSTRAP_TOKEN_RETURN = 32
val BOOTSTRAP_TOKEN_TASK = 33
val BOOTSTRAP_TOKEN_THREAD = 34
val BOOTSTRAP_TOKEN_TRUE = 35
val BOOTSTRAP_TOKEN_TRUSTED = 36
val BOOTSTRAP_TOKEN_UNTIL = 37
val BOOTSTRAP_TOKEN_VAL = 38
val BOOTSTRAP_TOKEN_VAR = 39
val BOOTSTRAP_TOKEN_WHEN = 40
val BOOTSTRAP_TOKEN_WHILE = 41
val BOOTSTRAP_TOKEN_YIELD = 42
val BOOTSTRAP_TOKEN_DOT = 43
val BOOTSTRAP_TOKEN_COLON = 44
val BOOTSTRAP_TOKEN_COMMA = 45
val BOOTSTRAP_TOKEN_HASH = 46
val BOOTSTRAP_TOKEN_DOLLAR = 47
val BOOTSTRAP_TOKEN_LPAREN = 48
val BOOTSTRAP_TOKEN_RPAREN = 49
val BOOTSTRAP_TOKEN_LBRACKET = 50
val BOOTSTRAP_TOKEN_RBRACKET = 51
val BOOTSTRAP_TOKEN_LBRACE = 52
val BOOTSTRAP_TOKEN_RBRACE = 53
val BOOTSTRAP_TOKEN_SEMICOLON = 54
val BOOTSTRAP_TOKEN_AT = 55
val BOOTSTRAP_TOKEN_QUESTION = 56
val BOOTSTRAP_TOKEN_XOR = 57
val BOOTSTRAP_TOKEN_AMP = 58
val BOOTSTRAP_TOKEN_PIPE = 59
val BOOTSTRAP_TOKEN_TILDE = 60
val BOOTSTRAP_TOKEN_PLUS = 61
val BOOTSTRAP_TOKEN_MINUS = 62
val BOOTSTRAP_TOKEN_STAR = 63
val BOOTSTRAP_TOKEN_SLASH = 64
val BOOTSTRAP_TOKEN_PERCENT = 65
val BOOTSTRAP_TOKEN_EQUAL = 66
val BOOTSTRAP_TOKEN_BANG = 67
val BOOTSTRAP_TOKEN_LESS = 68
val BOOTSTRAP_TOKEN_GREATER = 69
val BOOTSTRAP_TOKEN_INTERPOLATION_START = 70
val BOOTSTRAP_TOKEN_ARROW = 71
val BOOTSTRAP_TOKEN_RANGE = 72
val BOOTSTRAP_TOKEN_EQUAL_EQUAL = 73
val BOOTSTRAP_TOKEN_NOT_EQUAL = 74
val BOOTSTRAP_TOKEN_LESS_EQUAL = 75
val BOOTSTRAP_TOKEN_GREATER_EQUAL = 76
val BOOTSTRAP_TOKEN_SHIFT_LEFT = 77
val BOOTSTRAP_TOKEN_SHIFT_RIGHT = 78
val BOOTSTRAP_TOKEN_SHIFT_UNSIGNED = 79
val BOOTSTRAP_TOKEN_AND_AND = 80
val BOOTSTRAP_TOKEN_OR_OR = 81
val BOOTSTRAP_TOKEN_PLUS_EQUAL = 82
val BOOTSTRAP_TOKEN_MINUS_EQUAL = 83
val BOOTSTRAP_TOKEN_STAR_EQUAL = 84
val BOOTSTRAP_TOKEN_SLASH_EQUAL = 85
val BOOTSTRAP_TOKEN_PERCENT_EQUAL = 86

val BOOTSTRAP_TOKEN_AS = 87

val BOOTSTRAP_TOKEN_NAMES: array<string> = [
    "invalid",
    "end",
    "newline",
    "identifier",
    "integer",
    "float",
    "string-start",
    "string-text",
    "string-end",
    "interpolation-begin",
    "interpolation-end",
    "interpolation-identifier",
    "await",
    "break",
    "class",
    "compile",
    "continue",
    "defer",
    "do",
    "else",
    "extern",
    "false",
    "for",
    "fun",
    "generator",
    "if",
    "in",
    "interface",
    "import",
    "null",
    "noescape",
    "resource",
    "return",
    "task",
    "thread",
    "true",
    "trusted",
    "until",
    "val",
    "var",
    "when",
    "while",
    "yield",
    ".",
    ":",
    ",",
    "#",
    "$",
    "(",
    ")",
    "[",
    "]",
    "{",
    "}",
    ";",
    "@",
    "?",
    "^",
    "&",
    "|",
    "~",
    "+",
    "-",
    "*",
    "/",
    "%",
    "=",
    "!",
    "<",
    ">",
    "interpolation-start",
    "->",
    "..",
    "==",
    "!=",
    "<=",
    ">=",
    "<<",
    ">>",
    ">>>",
    "&&",
    "||",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "as"
]

@inline
fun bootstrapTokenKindName(kind: int): string =
    if (kind >= 0 && kind < BOOTSTRAP_TOKEN_NAMES.size) BOOTSTRAP_TOKEN_NAMES[kind]
    else "invalid"

fun bootstrapTokenKindFromName(name: string): int {
    var index = 0
    while (index < BOOTSTRAP_TOKEN_NAMES.size) {
        if (BOOTSTRAP_TOKEN_NAMES[index] == name) return index
        index = index + 1
    }
    -1
}

class BootstrapToken(
    val kind: int,
    val begin: int,
    val end: int
)

// A build reads each module's tokens three times or more: its discovery parse when the
// graph loads it, the strict-imports check, and its staged parse. From a graph's first
// load to the end of its parse (BootstrapModuleGraph), bootstrapLexShared lexes each
// source once, keyed by its text; nothing changes a token array once lexed. Only the first
// BOOTSTRAP_LEX_MEMO_BYTES of source are kept. Even with scalar token kinds,
// retaining every stream in a large firmware graph would retain too much memory.
// Sources past this budget are lexed each time, as before the memo.
var bootstrapLexMemoActive = false
var bootstrapLexMemo: Map<string, array<BootstrapToken>> = Map()
var bootstrapLexMemoBytes = 0
val BOOTSTRAP_LEX_MEMO_BYTES = 4194304

fun bootstrapLexShared(source: string): array<BootstrapToken> {
    if (!bootstrapLexMemoActive) return bootstrapLex(source)
    val known = bootstrapLexMemo.get(source)
    if (known != null) return known
    val tokens = bootstrapLex(source)
    if (bootstrapLexMemoBytes + source.size <= BOOTSTRAP_LEX_MEMO_BYTES) {
        bootstrapLexMemo.set(source, tokens)
        bootstrapLexMemoBytes = bootstrapLexMemoBytes + source.size
    }
    tokens
}

fun bootstrapLexMemoEnd(): void {
    bootstrapLexMemoActive = false
    bootstrapLexMemo = Map()
    bootstrapLexMemoBytes = 0
    return
}

fun bootstrapTokenText(source: string, token: BootstrapToken): string =
    source.slice(token.begin, token.end)

@inline
fun bootstrapAt(source: string, offset: int, byte: int): bool =
    offset >= 0 && offset < source.size && source[offset] == byte

fun bootstrapIsAlpha(byte: int): bool =
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122) ||
    byte == 95

fun bootstrapIsDigit(byte: int): bool = byte >= 48 && byte <= 57

fun bootstrapIsHexDigit(byte: int): bool =
    bootstrapIsDigit(byte) || (byte >= 65 && byte <= 70) ||
    (byte >= 97 && byte <= 102)

fun bootstrapIsAlphaNumeric(byte: int): bool =
    bootstrapIsAlpha(byte) || bootstrapIsDigit(byte)

// Compare a bounded source span without allocating a substring. All lexer and
// parser callers supply token boundaries within source; no native load extends
// beyond either string, including an empty span.
@inline
trusted fun bootstrapRegionEquals(
    source: string,
    begin: int,
    end: int,
    expected: string
): bool {
    val size = expected.size
    if (end - begin != size || begin < 0 || end > source.size) return false
    val sourceBytes = ablaUnsafeStringAddress(source) + begin
    val expectedBytes = ablaUnsafeStringAddress(expected)
    var index = 0
    while (index < size) {
        if (ablaUnsafeLoadU8(nativePointerFromAddress(sourceBytes + index)) !=
            ablaUnsafeLoadU8(nativePointerFromAddress(expectedBytes + index))) return false
        index = index + 1
    }
    true
}

fun bootstrapKeyword(source: string, begin: int, end: int): int {
    // Only the keywords starting with the word's first letter are compared.
    if (end - begin < 2 || end - begin > 9) return BOOTSTRAP_TOKEN_IDENTIFIER
    val first = source[begin]
    if (first == 97) {
        if (bootstrapRegionEquals(source, begin, end, "await")) return BOOTSTRAP_TOKEN_AWAIT
    }
    if (first == 98) {
        if (bootstrapRegionEquals(source, begin, end, "break")) return BOOTSTRAP_TOKEN_BREAK
    }
    if (first == 99) {
        if (bootstrapRegionEquals(source, begin, end, "class")) return BOOTSTRAP_TOKEN_CLASS
        if (bootstrapRegionEquals(source, begin, end, "compile")) return BOOTSTRAP_TOKEN_COMPILE
        if (bootstrapRegionEquals(source, begin, end, "continue")) return BOOTSTRAP_TOKEN_CONTINUE
    }
    if (first == 100) {
        if (bootstrapRegionEquals(source, begin, end, "defer")) return BOOTSTRAP_TOKEN_DEFER
        if (bootstrapRegionEquals(source, begin, end, "do")) return BOOTSTRAP_TOKEN_DO
    }
    if (first == 101) {
        if (bootstrapRegionEquals(source, begin, end, "else")) return BOOTSTRAP_TOKEN_ELSE
        if (bootstrapRegionEquals(source, begin, end, "extern")) return BOOTSTRAP_TOKEN_EXTERN
    }
    if (first == 102) {
        if (bootstrapRegionEquals(source, begin, end, "false")) return BOOTSTRAP_TOKEN_FALSE
        if (bootstrapRegionEquals(source, begin, end, "for")) return BOOTSTRAP_TOKEN_FOR
        if (bootstrapRegionEquals(source, begin, end, "fun")) return BOOTSTRAP_TOKEN_FUN
    }
    if (first == 103) {
        if (bootstrapRegionEquals(source, begin, end, "generator")) return BOOTSTRAP_TOKEN_GENERATOR
    }
    if (first == 105) {
        if (bootstrapRegionEquals(source, begin, end, "if")) return BOOTSTRAP_TOKEN_IF
        if (bootstrapRegionEquals(source, begin, end, "in")) return BOOTSTRAP_TOKEN_IN
        if (bootstrapRegionEquals(source, begin, end, "interface")) return BOOTSTRAP_TOKEN_INTERFACE
        if (bootstrapRegionEquals(source, begin, end, "import")) return BOOTSTRAP_TOKEN_IMPORT
    }
    if (first == 110) {
        if (bootstrapRegionEquals(source, begin, end, "null")) return BOOTSTRAP_TOKEN_NULL
        if (bootstrapRegionEquals(source, begin, end, "noescape")) return BOOTSTRAP_TOKEN_NOESCAPE
    }
    if (first == 114) {
        if (bootstrapRegionEquals(source, begin, end, "resource")) return BOOTSTRAP_TOKEN_RESOURCE
        if (bootstrapRegionEquals(source, begin, end, "return")) return BOOTSTRAP_TOKEN_RETURN
    }
    if (first == 116) {
        if (bootstrapRegionEquals(source, begin, end, "task")) return BOOTSTRAP_TOKEN_TASK
        if (bootstrapRegionEquals(source, begin, end, "thread")) return BOOTSTRAP_TOKEN_THREAD
        if (bootstrapRegionEquals(source, begin, end, "true")) return BOOTSTRAP_TOKEN_TRUE
        if (bootstrapRegionEquals(source, begin, end, "trusted")) return BOOTSTRAP_TOKEN_TRUSTED
    }
    if (first == 117) {
        if (bootstrapRegionEquals(source, begin, end, "until")) return BOOTSTRAP_TOKEN_UNTIL
    }
    if (first == 118) {
        if (bootstrapRegionEquals(source, begin, end, "val")) return BOOTSTRAP_TOKEN_VAL
        if (bootstrapRegionEquals(source, begin, end, "var")) return BOOTSTRAP_TOKEN_VAR
    }
    if (first == 119) {
        if (bootstrapRegionEquals(source, begin, end, "when")) return BOOTSTRAP_TOKEN_WHEN
        if (bootstrapRegionEquals(source, begin, end, "while")) return BOOTSTRAP_TOKEN_WHILE
    }
    if (first == 121) {
        if (bootstrapRegionEquals(source, begin, end, "yield")) return BOOTSTRAP_TOKEN_YIELD
    }
    BOOTSTRAP_TOKEN_IDENTIFIER
}

fun bootstrapPunctuation(byte: int): int {
    var kind = BOOTSTRAP_TOKEN_INVALID
    if (byte == 46) kind = BOOTSTRAP_TOKEN_DOT
    if (byte == 58) kind = BOOTSTRAP_TOKEN_COLON
    if (byte == 44) kind = BOOTSTRAP_TOKEN_COMMA
    if (byte == 35) kind = BOOTSTRAP_TOKEN_HASH
    if (byte == 36) kind = BOOTSTRAP_TOKEN_DOLLAR
    if (byte == 40) kind = BOOTSTRAP_TOKEN_LPAREN
    if (byte == 41) kind = BOOTSTRAP_TOKEN_RPAREN
    if (byte == 91) kind = BOOTSTRAP_TOKEN_LBRACKET
    if (byte == 93) kind = BOOTSTRAP_TOKEN_RBRACKET
    if (byte == 123) kind = BOOTSTRAP_TOKEN_LBRACE
    if (byte == 125) kind = BOOTSTRAP_TOKEN_RBRACE
    if (byte == 59) kind = BOOTSTRAP_TOKEN_SEMICOLON
    if (byte == 64) kind = BOOTSTRAP_TOKEN_AT
    if (byte == 63) kind = BOOTSTRAP_TOKEN_QUESTION
    if (byte == 94) kind = BOOTSTRAP_TOKEN_XOR
    if (byte == 38) kind = BOOTSTRAP_TOKEN_AMP
    if (byte == 124) kind = BOOTSTRAP_TOKEN_PIPE
    if (byte == 126) kind = BOOTSTRAP_TOKEN_TILDE
    if (byte == 43) kind = BOOTSTRAP_TOKEN_PLUS
    if (byte == 45) kind = BOOTSTRAP_TOKEN_MINUS
    if (byte == 42) kind = BOOTSTRAP_TOKEN_STAR
    if (byte == 47) kind = BOOTSTRAP_TOKEN_SLASH
    if (byte == 37) kind = BOOTSTRAP_TOKEN_PERCENT
    if (byte == 61) kind = BOOTSTRAP_TOKEN_EQUAL
    if (byte == 33) kind = BOOTSTRAP_TOKEN_BANG
    if (byte == 60) kind = BOOTSTRAP_TOKEN_LESS
    if (byte == 62) kind = BOOTSTRAP_TOKEN_GREATER
    kind
}

fun bootstrapFindInterpolationEnd(source: string, begin: int): int {
    var offset = begin
    var depth = 1
    var quoted = false
    while (offset < source.size && depth > 0) {
        val byte = source[offset]
        if (quoted) {
            if (byte == 92 && offset + 1 < source.size) offset = offset + 2
            else {
                if (byte == 34) quoted = false
                else quoted = quoted
                offset = offset + 1
            }
        } else {
            // A raw text block inside an interpolation may contain `}` and
            // ordinary quotes; none of them closes the surrounding expression.
            if (byte == 34 && bootstrapAt(source, offset + 1, 34) && bootstrapAt(source, offset + 2, 34)) {
                offset = offset + 3
                while (offset < source.size && !(bootstrapAt(source, offset, 34) &&
                    bootstrapAt(source, offset + 1, 34) && bootstrapAt(source, offset + 2, 34))) offset = offset + 1
                if (offset < source.size) offset = offset + 3
                continue
            }
            if (byte == 34) quoted = true
            else quoted = quoted
            if (byte == 123) depth = depth + 1
            else depth = depth
            if (byte == 125) depth = depth - 1
            else depth = depth
            if (depth > 0) offset = offset + 1
            else offset = offset
        }
    }
    offset
}

fun bootstrapLex(source: string): array<BootstrapToken> {
    val tokens: array<BootstrapToken> = []
    var offset = 0
    while (offset < source.size) {
        val begin = offset
        val byte = source[offset]
        var handled = false

        if (!handled && (byte == 32 || byte == 9 || byte == 12)) {
            offset = offset + 1
            handled = true
        }

        if (!handled && (byte == 10 || byte == 13)) {
            offset = offset + 1
            if (byte == 13 && bootstrapAt(source, offset, 10)) offset = offset + 1
            tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_NEWLINE, begin, offset))
            handled = true
        }

        if (!handled && bootstrapIsAlpha(byte)) {
            offset = offset + 1
            while (
                offset < source.size &&
                bootstrapIsAlphaNumeric(source[offset])
            ) offset = offset + 1
            tokens.append(BootstrapToken(
                bootstrapKeyword(source, begin, offset),
                begin,
                offset
            ))
            handled = true
        }

        if (!handled && bootstrapIsDigit(byte)) {
            offset = offset + 1
            var floating = false
            if (byte == 48 && offset < source.size &&
                (source[offset] == 120 || source[offset] == 88)) {
                offset = offset + 1
                while (offset < source.size &&
                    (bootstrapIsHexDigit(source[offset]) ||
                     source[offset] == 95)) offset = offset + 1
            } else if (byte == 48 && offset < source.size &&
                (source[offset] == 111 || source[offset] == 79)) {
                offset = offset + 1
                // Consume 8 and 9 too, so the parser reports the malformed
                // octal as one literal instead of two adjacent expressions.
                while (offset < source.size &&
                    (bootstrapIsDigit(source[offset]) || source[offset] == 95)) offset = offset + 1
            } else {
                while (offset < source.size &&
                    (bootstrapIsDigit(source[offset]) ||
                     source[offset] == 95)) offset = offset + 1
                if (offset + 1 < source.size && source[offset] == 46 &&
                    bootstrapIsDigit(source[offset + 1])) {
                    floating = true
                    offset = offset + 2
                    while (offset < source.size &&
                        (bootstrapIsDigit(source[offset]) ||
                         source[offset] == 95)) offset = offset + 1
                }
                if (offset < source.size &&
                    (source[offset] == 101 || source[offset] == 69)) {
                    var exponent = offset + 1
                    if (exponent < source.size &&
                        (source[exponent] == 43 ||
                         source[exponent] == 45)) exponent = exponent + 1
                    if (exponent < source.size &&
                        bootstrapIsDigit(source[exponent])) {
                        floating = true
                        offset = exponent + 1
                        while (offset < source.size &&
                            (bootstrapIsDigit(source[offset]) ||
                             source[offset] == 95)) offset = offset + 1
                    }
                }
            }
            tokens.append(BootstrapToken(
                if (floating) BOOTSTRAP_TOKEN_FLOAT else BOOTSTRAP_TOKEN_INTEGER, begin, offset
            ))
            handled = true
        }

        if (!handled && byte == 47 && bootstrapAt(source, offset + 1, 47)) {
            offset = offset + 2
            while (
                offset < source.size &&
                source[offset] != 10 &&
                source[offset] != 13
            ) offset = offset + 1
            handled = true
        }

        if (!handled && byte == 47 && bootstrapAt(source, offset + 1, 42)) {
            offset = offset + 2
            var depth = 1
            while (offset < source.size && depth > 0) {
                if (
                    bootstrapAt(source, offset, 47) &&
                    bootstrapAt(source, offset + 1, 42)
                ) {
                    depth = depth + 1
                    offset = offset + 2
                } else if (
                    bootstrapAt(source, offset, 42) &&
                    bootstrapAt(source, offset + 1, 47)
                ) {
                    depth = depth - 1
                    offset = offset + 2
                } else offset = offset + 1
            }
            handled = true
        }

        if (!handled && byte == 34 && bootstrapAt(source, offset + 1, 34) && bootstrapAt(source, offset + 2, 34)) {
            offset = offset + 3
            tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_START, begin, offset))
            val textBegin = offset
            while (offset < source.size && !(bootstrapAt(source, offset, 34) &&
                bootstrapAt(source, offset + 1, 34) && bootstrapAt(source, offset + 2, 34))) offset = offset + 1
            if (textBegin < offset) tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_TEXT, textBegin, offset))
            if (offset < source.size) {
                val endBegin = offset
                offset = offset + 3
                tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_END, endBegin, offset))
            } else tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_INVALID, begin, offset))
            handled = true
        }

        if (!handled && byte == 34) {
            offset = offset + 1
            tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_START, begin, offset))
            var textBegin = offset
            while (offset < source.size && source[offset] != 34) {
                if (source[offset] == 92 && offset + 1 < source.size) {
                    offset = offset + 2
                } else if (
                    source[offset] == 36 &&
                    bootstrapAt(source, offset + 1, 123)
                ) {
                    if (textBegin < offset) {
                        tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_TEXT,
                            textBegin,
                            offset
                        ))
                    }
                    val interpolation = offset
                    val expressionBegin = offset + 2
                    val expressionEnd = bootstrapFindInterpolationEnd(
                        source,
                        expressionBegin
                    )
                    tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_INTERPOLATION_START,
                        interpolation,
                        expressionBegin
                    ))
                    val nested = bootstrapLex(
                        source.slice(expressionBegin, expressionEnd)
                    )
                    var nestedIndex = 0
                    while (nestedIndex + 1 < nested.size) {
                        tokens.append(BootstrapToken(
                            nested[nestedIndex].kind,
                            expressionBegin + nested[nestedIndex].begin,
                            expressionBegin + nested[nestedIndex].end
                        ))
                        nestedIndex = nestedIndex + 1
                    }
                    if (bootstrapAt(source, expressionEnd, 125)) {
                        tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_INTERPOLATION_END,
                            expressionEnd,
                            expressionEnd + 1
                        ))
                        offset = expressionEnd + 1
                    } else {
                        tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_INVALID,
                            interpolation,
                            expressionEnd
                        ))
                        offset = expressionEnd
                    }
                    textBegin = offset
                } else if (
                    source[offset] == 36 &&
                    offset + 1 < source.size &&
                    bootstrapIsAlpha(source[offset + 1])
                ) {
                    if (textBegin < offset) {
                        tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_TEXT,
                            textBegin,
                            offset
                        ))
                    }
                    val identifierBegin = offset + 1
                    offset = identifierBegin + 1
                    while (offset < source.size &&
                           bootstrapIsAlphaNumeric(source[offset])) {
                        offset = offset + 1
                    }
                    tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_INTERPOLATION_IDENTIFIER,
                        identifierBegin,
                        offset
                    ))
                    textBegin = offset
                } else offset = offset + 1
            }
            if (textBegin < offset) {
                tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_TEXT, textBegin, offset))
            }
            if (bootstrapAt(source, offset, 34)) {
                val quote = offset
                offset = offset + 1
                tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_STRING_END, quote, offset))
            } else tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_INVALID, begin, offset))
            handled = true
        }

        if (!handled) {
            var kind = bootstrapPunctuation(byte)
            var width = 1
            if (byte == 45 && bootstrapAt(source, offset + 1, 62)) {
                kind = BOOTSTRAP_TOKEN_ARROW
                width = 2
            }
            if (byte == 46 && bootstrapAt(source, offset + 1, 46)) {
                kind = BOOTSTRAP_TOKEN_RANGE
                width = 2
            }
            if (byte == 61 && bootstrapAt(source, offset + 1, 61)) {
                kind = BOOTSTRAP_TOKEN_EQUAL_EQUAL
                width = 2
            }
            if (byte == 33 && bootstrapAt(source, offset + 1, 61)) {
                kind = BOOTSTRAP_TOKEN_NOT_EQUAL
                width = 2
            }
            if (byte == 60 && bootstrapAt(source, offset + 1, 61)) {
                kind = BOOTSTRAP_TOKEN_LESS_EQUAL
                width = 2
            }
            if (byte == 62 && bootstrapAt(source, offset + 1, 61)) {
                kind = BOOTSTRAP_TOKEN_GREATER_EQUAL
                width = 2
            }
            if (byte == 60 && bootstrapAt(source, offset + 1, 60)) {
                kind = BOOTSTRAP_TOKEN_SHIFT_LEFT
                width = 2
            }
            if (byte == 62 && bootstrapAt(source, offset + 1, 62)) {
                kind = BOOTSTRAP_TOKEN_SHIFT_RIGHT
                width = 2
                if (bootstrapAt(source, offset + 2, 62)) {
                    kind = BOOTSTRAP_TOKEN_SHIFT_UNSIGNED
                    width = 3
                }
            }
            if (byte == 38 && bootstrapAt(source, offset + 1, 38)) {
                kind = BOOTSTRAP_TOKEN_AND_AND
                width = 2
            }
            // Compound assignment: `+=` `-=` `*=` `/=` `%=`.
            if ((byte == 43 || byte == 45 || byte == 42 || byte == 47 || byte == 37) &&
                bootstrapAt(source, offset + 1, 61)) {
                kind = if (byte == 43) BOOTSTRAP_TOKEN_PLUS_EQUAL
                    else if (byte == 45) BOOTSTRAP_TOKEN_MINUS_EQUAL
                    else if (byte == 42) BOOTSTRAP_TOKEN_STAR_EQUAL
                    else if (byte == 47) BOOTSTRAP_TOKEN_SLASH_EQUAL else BOOTSTRAP_TOKEN_PERCENT_EQUAL
                width = 2
            }
            if (byte == 124 && bootstrapAt(source, offset + 1, 124)) {
                kind = BOOTSTRAP_TOKEN_OR_OR
                width = 2
            }
            offset = offset + width
            tokens.append(BootstrapToken(kind, begin, offset))
        }
    }
    tokens.append(BootstrapToken(BOOTSTRAP_TOKEN_END, offset, offset))
    tokens
}
