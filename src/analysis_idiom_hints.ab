// Editor-only suggestions. Match the written AST using the resolved types
// already exported by graph analysis. There is no second parse or type pass.
import "analysis_service.ab"
import "frontend_diagnostics.ab"
import "module.ab"
import "parser.ab"
import "sema.ab"
import "abla/text"

private fun idiomOccurrenceAt(occurrences: BootstrapAnalysisOccurrenceSet, begin: int, end: int): int {
    var low = 0
    var high = occurrences.begins.size
    while (low < high) {
        val middle = low + (high - low) / 2
        if (occurrences.begins[middle] < begin) low = middle + 1
        else high = middle
    }
    if (low < occurrences.begins.size && occurrences.begins[low] == begin &&
        occurrences.ends[low] == end && occurrences.ids[low] != "") low else -1
}

private fun idiomTypeAt(occurrences: BootstrapAnalysisOccurrenceSet,
    name: BootstrapExpression): string {
    val index = idiomOccurrenceAt(occurrences, name.begin, name.end)
    if (index >= 0) occurrences.types[index] else ""
}

private fun idiomOneStatement(expression: BootstrapExpression): BootstrapExpression =
    if (expression.kind == "block" && expression.children.size == 1) expression.children[0]
    else expression

private fun idiomHasComment(source: string): bool = source.contains("//") || source.contains("/*")

private fun idiomScalar(type: string): bool =
    type == "i64" || type == "int" || type == "string" || type == "bool"

private fun idiomNullableEdit(source: string, local: BootstrapExpression, guard: BootstrapExpression,
    occurrences: BootstrapAnalysisOccurrenceSet): string {
    val initializer = local.children[0]
    if (local.children[1].text != "inferred" || guard.text != "" || guard.children.size != 3 ||
        guard.children[2].kind != "missing") return ""
    // These expression forms bind tighter than ??. The gap check refuses a
    // trailing closer that the initializer's AST range does not include.
    if (initializer.kind != "identifier" && initializer.kind != "call" &&
        initializer.kind != "member" && initializer.kind != "member.call" &&
        initializer.kind != "index") return ""
    val condition = guard.children[0]
    if (condition.kind != "==" || condition.children.size != 2) return ""
    val left = condition.children[0]
    val right = condition.children[1]
    val name = if (left.kind == "null") right else left
    if (name.kind != "identifier" || name.text != local.text ||
        (left.kind != "null" && right.kind != "null")) return ""
    val type = idiomTypeAt(occurrences, name)
    if (!bootstrapIsNullableType(type) || !idiomScalar(bootstrapNullableElementType(type))) return ""
    val exit = idiomOneStatement(guard.children[1])
    if (exit.kind != "return" && exit.kind != "continue") return ""
    val exitText = source.slice(exit.begin, exit.end)
    if (exit.kind == "return") {
        val value = exit.children[0]
        if (value.kind != "missing" && value.kind != "integer" && value.kind != "string" &&
            value.kind != "true" && value.kind != "false" && value.kind != "null") return ""
        // Parentheses around a return value are outside its AST range.
        if (value.kind != "missing" && source.slice(exit.begin + 6, value.begin).trim() != "") return ""
    } else if (exitText != "continue") return ""
    val gap = source.slice(local.end, guard.begin).trim()
    if (gap != "" && gap != ";") return ""
    if (idiomHasComment(source.slice(local.end, guard.end))) return ""
    val head = source.slice(local.begin, local.end).trim()
    "$head ?? $exitText"
}

// These transforms use only the loop item and built-in scalar operations.
// No closure capture, user operator, mutation or call moves into the block.
private fun idiomIntegerTransform(expression: BootstrapExpression, name: string): bool {
    if (expression.kind == "identifier") return expression.text == name
    if (expression.kind == "integer") return true
    if (expression.kind != "+" && expression.kind != "-" && expression.kind != "*") return false
    expression.children.size == 2 && idiomIntegerTransform(expression.children[0], name) &&
        idiomIntegerTransform(expression.children[1], name)
}

private fun idiomMappedTransform(expression: BootstrapExpression, name: string,
    input: string, output: string): bool {
    if (output == "int" || output == "i64") {
        return (input == "int" || input == "i64") && idiomIntegerTransform(expression, name)
    }
    if (output != "string") return false
    if (expression.kind == "string") return true
    if (expression.kind != "string.template") return false
    for (part in expression.children) {
        if (part.kind != "string" && (part.kind != "identifier" || part.text != name)) return false
    }
    true
}

private fun idiomMappedEdit(source: string, local: BootstrapExpression, loop: BootstrapExpression,
    occurrences: BootstrapAnalysisOccurrenceSet): string {
    val empty = local.children[0]
    if (empty.kind != "array" || empty.children.size != 0 ||
        loop.children.size != 2 || bootstrapLoopLabel(loop) != "") return ""
    val input = loop.children[0]
    val append = idiomOneStatement(loop.children[1])
    if (input.kind != "identifier" || input.text == local.text ||
        append.kind != "member.call" || append.text != "append" || append.children.size != 2) return ""
    val output = append.children[0]
    if (output.kind != "identifier" || output.text != local.text) return ""
    val inputType = idiomTypeAt(occurrences, input)
    val outputType = idiomTypeAt(occurrences, output)
    if (!bootstrapIsArrayType(inputType) || !bootstrapIsArrayType(outputType)) return ""
    val item = bootstrapArrayElementType(inputType)
    if (!idiomScalar(item) ||
        !idiomMappedTransform(append.children[1], loop.text, item, bootstrapArrayElementType(outputType))) return ""
    if (idiomHasComment(source.slice(local.begin, loop.end))) return ""
    // Keep the whole argument as written, including parentheses omitted by
    // its AST. The call span ends just before the token following its closer.
    val suffix = source.slice(output.end, append.end).trim()
    if (!suffix.startsWith(".append(") || !suffix.endsWith(")")) return ""
    val argument = suffix.slice(8, suffix.size - 1).trim()
    if (argument.endsWith(",")) return ""
    val head = source.slice(local.begin, empty.begin)
    val gap = source.slice(empty.end, loop.begin).trim()
    if (!head.trimEnd().endsWith("=") || (gap != "" && gap != ";")) return ""
    "${head}${input.text}.mapped { ${loop.text} -> $argument }"
}

private fun idiomArithmeticOperator(kind: string): bool =
    kind == "+" || kind == "-" || kind == "*" || kind == "/" || kind == "%"

// `x op= e` parses to the same tree as `x = x op e` (parseExpressionBody), so
// the edit changes only spelling. A top-level operator whose left operand is
// the name itself has every tighter or parenthesized operand on its right:
// `x = x - a - b` is `(x - a) - b` and is left alone.
// The resolved local identity distinguishes ordinary locals from globals,
// delegated bindings and similarly named shadowing declarations.
private fun idiomUpdateAssignment(source: string, path: string,
    expression: BootstrapExpression, occurrences: BootstrapAnalysisOccurrenceSet,
    locals: Map<string, bool>, var diagnostics: array<BootstrapFrontendDiagnostic>): void {
    val rhs = expression.children[0]
    val logical = rhs.kind == "&&" || rhs.kind == "||"
    if ((!logical && !idiomArithmeticOperator(rhs.kind)) || rhs.text != rhs.kind || rhs.children.size != 2) return
    val read = rhs.children[0]
    if (read.kind != "identifier" || read.text != expression.text) return
    val begin = expression.begin
    val nameEnd = begin + expression.text.size
    if (begin < 0 || read.end > source.size || read.begin < nameEnd || read.end - begin > 4096) return
    if (source.slice(begin, nameEnd) != expression.text ||
        source.slice(nameEnd, read.begin).trim() != "=") return
    val written = idiomOccurrenceAt(occurrences, begin, nameEnd)
    val repeated = idiomOccurrenceAt(occurrences, read.begin, read.end)
    if (written < 0 || repeated < 0 || (logical && occurrences.types[written] != "bool") ||
        occurrences.types[written] == "" ||
        occurrences.ids[written] != occurrences.ids[repeated] ||
        locals.get(occurrences.ids[written]) == null) return
    var operator = read.end
    while (operator < source.size &&
        (source[operator] == 32 || source[operator] == 9)) operator = operator + 1
    val end = operator + rhs.kind.size
    if (end > source.size || source.slice(operator, end) != rhs.kind) return
    // `x = x+1` becomes `x += 1`, not `x +=1`.
    val spaced = end < source.size && source[end] != 32 && source[end] != 9 &&
        source[end] != 10 && source[end] != 13
    val gap = if (spaced) " " else ""
    val text = "${expression.text} ${rhs.kind}=$gap"
    val code = if (logical) "W_LOGICAL_ASSIGNMENT" else "W_COMPOUND_ASSIGNMENT"
    val title = if (logical) "Use the ${rhs.kind}= Boolean assignment" else "Use ${rhs.kind}="
    diagnostics.append(BootstrapFrontendDiagnostic(code, title, path, begin, end,
        fixes = [BootstrapFrontendFix(title, "replace", begin, end, text)], severity = "warning"))
}

private fun idiomAppend(source: string, expression: BootstrapExpression,
    occurrences: BootstrapAnalysisOccurrenceSet, nullable: bool, mapped: bool,
    var diagnostics: array<BootstrapFrontendDiagnostic>, path: string, updates: bool, var locals: Map<string, bool>): void {
    if (updates) {
        if (expression.kind == "local.var" && expression.children[0].kind != "delegate.initializer") {
            val begin = expression.children[1].begin
            val declaration = idiomOccurrenceAt(occurrences, begin, begin + expression.text.size)
            if (declaration >= 0) locals.set(occurrences.ids[declaration], true)
        } else if (expression.kind == "assign") {
            idiomUpdateAssignment(source, path, expression, occurrences, locals, diagnostics)
        }
    }
    if ((nullable || mapped) && expression.kind == "block") {
        // Leave the block's result expression in place.
        for (index in 0 until expression.children.size - 2) {
            val local = expression.children[index]
            if (local.kind != "local.val" || local.children.size != 2) continue
            val next = expression.children[index + 1]
            val early = nullable && next.kind == "if"
            if (!early && (!mapped || next.kind != "for")) continue
            if (local.begin < 0 || local.begin >= local.end || local.end > next.begin ||
                next.begin >= next.end || next.end > source.size || next.end - local.begin > 4096) continue
            // A trailing closer omitted by the AST would stay after the edit.
            var after = next.end
            while (after < source.size && (source[after] == 32 || source[after] == 9)) after = after + 1
            if (after < source.size && source[after] != 10 && source[after] != 13 &&
                source[after] != 59 && source[after] != 125) continue
            val replacement = if (early) idiomNullableEdit(source, local, next, occurrences)
                else idiomMappedEdit(source, local, next, occurrences)
            if (replacement != "") {
                val code = if (early) "W_NULLABLE_EARLY_EXIT" else "W_ARRAY_MAPPED"
                val title = if (early) "Combine the binding and null guard with ??" else "Replace the append loop with array.mapped"
                diagnostics.append(BootstrapFrontendDiagnostic(code, title, path, local.begin, next.end,
                    fixes = [BootstrapFrontendFix(title, "replace", local.begin, next.end, replacement)],
                    severity = "warning"))
            }
        }
    }
    for (child in expression.children) idiomAppend(source, child, occurrences, nullable, mapped, diagnostics, path, updates, locals)
}

private fun idiomMentions(expression: BootstrapExpression, name: string): bool {
    if (expression.kind == "identifier" && expression.text == name) return true
    // A nested loop or lambda that rebinds the name is still counted: the
    // hint is skipped rather than proving the shadowing.
    for (child in expression.children) if (idiomMentions(child, name)) return true
    false
}

// How often `name` is declared as a local, or assigned (`assign` names
// its target; a compound assignment is an `assign` too).
private fun idiomBindings(expression: BootstrapExpression, name: string): int {
    var count = 0
    if ((expression.kind == "local.val" || expression.kind == "local.var" || expression.kind == "assign" ||
        expression.kind == "lambda.parameter" || expression.kind == "for") &&
        bootstrapForName(expression) == name) count = 1
    for (child in expression.children) count = count + idiomBindings(child, name)
    count
}

private fun idiomPlainElement(type: string): bool =
    idiomScalar(type) || type == "f64" || type == "f32" || type == "i32" || type == "u32" ||
        type == "u64" || type == "i16" || type == "u16" || type == "i8" || type == "u8"

// `for (i in 0 until xs.size) { val x = xs[i] ... }` with no other use of
// `i` becomes `for (x in xs) { ... }`. Both forms read the size once and
// each element when its iteration starts, bounds-checked, so a body that
// grows or shrinks xs behaves the same. xs must be a parameter or a single
// `val` that nothing reassigns, holding a string or plain scalars.
private fun idiomIndexLoopEdit(source: string, loop: BootstrapExpression,
    declaration: BootstrapDeclaration, occurrences: BootstrapAnalysisOccurrenceSet): string {
    if (loop.children.size != 2 || bootstrapLoopLabel(loop) != "") return ""
    val range = loop.children[0]
    val body = loop.children[1]
    if (range.kind != "range.until" || range.children.size != 2 || body.kind != "block" ||
        body.children.size < 2) return ""
    val start = range.children[0]
    val size = range.children[1]
    if (start.kind != "integer" || start.text != "0" || size.kind != "member" || size.text != "size" ||
        size.children.size != 1 || size.children[0].kind != "identifier") return ""
    val items = size.children[0]
    val binding = body.children[0]
    if (binding.kind != "local.val" || binding.children.size != 2 ||
        binding.children[1].text != "inferred") return ""
    val read = binding.children[0]
    if (read.kind != "index" || read.children.size != 2 || read.children[0].kind != "identifier" ||
        read.children[0].text != items.text || read.children[1].kind != "identifier" ||
        read.children[1].text != loop.text || binding.text == items.text) return ""
    for (index in 1 until body.children.size) if (idiomMentions(body.children[index], loop.text)) return ""
    val type = idiomTypeAt(occurrences, items)
    if (type != "string" && (!bootstrapIsArrayType(type) || !idiomPlainElement(bootstrapArrayElementType(type)))) return ""
    var parameter = false
    for (index in 0 until declaration.parameters.size) {
        if (declaration.parameters[index] == items.text) parameter = declaration.parameterKinds[index] == "parameter"
    }
    val bindings = idiomBindings(declaration.expression, items.text)
    if (if (parameter) bindings != 0 else bindings != 1) return ""
    if (!parameter) {
        // The single binding has to be a `val`, not a `var` or an assignment.
        if (!idiomDeclaresVal(declaration.expression, items.text)) return ""
    }
    // The block opens with `{`, then only whitespace before the binding.
    if (body.begin < 0 || body.begin >= source.size || source[body.begin] != 123 ||
        source.slice(body.begin + 1, binding.begin).trim() != "" ||
        idiomHasComment(source.slice(loop.begin, binding.end))) return ""
    "for (${binding.text} in ${items.text}) {"
}

private fun idiomDeclaresVal(expression: BootstrapExpression, name: string): bool {
    if (expression.kind == "local.val" && expression.text == name) return true
    for (child in expression.children) if (idiomDeclaresVal(child, name)) return true
    false
}

private fun idiomIndexLoops(source: string, expression: BootstrapExpression, declaration: BootstrapDeclaration,
    occurrences: BootstrapAnalysisOccurrenceSet, var diagnostics: array<BootstrapFrontendDiagnostic>, path: string): void {
    if (expression.kind == "for" && expression.begin >= 0 && expression.end <= source.size &&
        expression.children.size == 2 && expression.children[1].children.size > 0) {
        val replacement = idiomIndexLoopEdit(source, expression, declaration, occurrences)
        if (replacement != "") {
            val end = expression.children[1].children[0].end
            val title = "Iterate over the values directly"
            diagnostics.append(BootstrapFrontendDiagnostic("W_INDEX_LOOP", title, path, expression.begin, end,
                fixes = [BootstrapFrontendFix(title, "replace", expression.begin, end, replacement)],
                severity = "warning"))
        }
    }
    for (child in expression.children) idiomIndexLoops(source, child, declaration, occurrences, diagnostics, path)
}

private fun idiomDeclaration(source: string, declaration: BootstrapDeclaration,
    occurrences: BootstrapAnalysisOccurrenceSet, nullable: bool, mapped: bool,
    var diagnostics: array<BootstrapFrontendDiagnostic>, path: string, updates: bool, var locals: Map<string, bool>): void {
    // A resolved occurrence in an instantiated generic body does not prove
    // that the edit is valid for every substitution.
    if (declaration.typeParameters.size != 0 || declaration.sourceIdentity != path) return
    idiomAppend(source, declaration.expression, occurrences, nullable, mapped, diagnostics, path, updates, locals)
    if (updates) idiomIndexLoops(source, declaration.expression, declaration, occurrences, diagnostics, path)
    for (method in declaration.methods) idiomDeclaration(source, method, occurrences, nullable, mapped, diagnostics, path, updates, locals)
}

/** The standard extension is the only possible target of the introduced
 * member call. If another extension named mapped is loaded, skip the hint. */
fun bootstrapAnalysisMappedProvider(declarations: array<BootstrapDeclaration>, provider: string): bool {
    var found = false
    for (declaration in declarations) {
        if (declaration.extensionOwner == "") continue
        if (bootstrapCanonicalDeclarationHasSourceName(declaration.name, "mapped")) {
            if (declaration.sourceIdentity != provider) return false
            found = true
        }
        // Even an extension on a type alias can overload a scalar operator.
        // Without an operator-resolution proof at every site, leave it alone.
        if (bootstrapCanonicalDeclarationHasSourceName(declaration.name, "plus") ||
            bootstrapCanonicalDeclarationHasSourceName(declaration.name, "minus") ||
            bootstrapCanonicalDeclarationHasSourceName(declaration.name, "times")) return false
    }
    found
}

/** Append edits for recognized idioms in a checked, written module. */
fun bootstrapAnalysisIdiomHints(source: string, path: string, parsed: BootstrapParseResult,
    occurrences: BootstrapAnalysisOccurrenceSet, mappedProvider: bool,
    var diagnostics: array<BootstrapFrontendDiagnostic>): void {
    if (parsed.errors != 0 || parsed.extensionErrors != 0) return
    val nullable = source.contains("==") && source.contains("null")
    var mapped = false
    if (mappedProvider && source.contains(".append(") && source.contains("\"abla/array\"")) {
        for (edge in bootstrapScanImports(source).edges) {
            if (edge.source == "abla/array" && edge.alias == "" && !edge.provider && !edge.contractOnly) mapped = true
        }
    }
    // Boolean and arithmetic updates: `x = x && e`, `x = x + e`, ...
    val updates = source.contains("=")
    if (!nullable && !mapped && !updates) return
    for (diagnostic in diagnostics) if (diagnostic.severity == "error") return
    val locals: Map<string, bool> = Map()
    for (declaration in parsed.declarations) {
        idiomDeclaration(source, declaration, occurrences, nullable, mapped, diagnostics, path, updates, locals)
    }
}
