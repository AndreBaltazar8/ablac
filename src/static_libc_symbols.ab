// The C names the statically linked compiler's dlsym finds (#806 step C, src/static_libc/dl.ab): every symbol of tools/compiler-libc-needs.txt (the C library
// functions and data the compiler's LLVM and libstdc++ archives use, all defined by src/static_libc or the generated assembly file) and the routines
// the JIT's generated code calls that nothing else exports: the runtime's own memory and jump routines (hidden in the image), the emulated
// thread-local accessor, the thread entry points and the few calls made from JIT'd modules (pause, pthread_self, pthread_kill). Sorted by byte order.
// tools/test-static-compiler.sh checks the list covers the needs file.
fun bootstrapStaticLibcSymbolNames(): array<string> = [
    "__ctype_b_loc", "__ctype_get_mb_cur_max", "__ctype_tolower_loc", "__ctype_toupper_loc", "__cxa_atexit", "__duplocale",
    "__emutls_get_address", "__errno_location", "__freelocale", "__isoc23_strtol", "__isoc23_strtoll", "__isoc23_strtoul",
    "__isoc23_strtoull", "__iswctype_l", "__libc_single_threaded", "__memcpy_chk", "__memset_chk", "__newlocale",
    "__nl_langinfo_l", "__printf_chk", "__realpath_chk", "__snprintf_chk", "__stack_chk_fail", "__strcoll_l",
    "__strftime_l", "__strtod_l", "__strtof_l", "__strxfrm_l", "__towlower_l", "__towupper_l",
    "__uselocale", "__vsnprintf_chk", "__wcscoll_l", "__wcsftime_l", "__wcsxfrm_l", "__wctype_l",
    "_dl_find_object", "_exit", "_longjmp", "_setjmp", "abort", "access",
    "acos", "alarm", "arc4random", "asin", "atan", "atan2",
    "atexit", "bcmp", "bind_textdomain_codeset", "btowc", "calloc", "ceil",
    "chdir", "clock_gettime", "close", "closedir", "cos", "cosh",
    "dgettext", "dlclose", "dlerror", "dlopen", "dlsym", "dup2",
    "environ", "erf", "execv", "execve", "exit", "exp",
    "fabs", "fcntl", "feclearexcept", "fetestexcept", "floor", "fork",
    "fputc", "fputs", "free", "fstat", "fstat64", "fwrite",
    "getauxval", "getcwd", "getenv", "getpid", "getpwnam_r", "getpwuid_r",
    "getrlimit", "getrusage", "gettext", "gettimeofday", "getuid", "iconv",
    "iconv_close", "iconv_open", "isalnum", "isalpha", "isatty", "isspace",
    "isxdigit", "kill", "localtime_r", "log", "log10", "log1p",
    "log2", "log2f", "logb", "lseek", "lstat", "lstat64",
    "mallinfo2", "malloc", "malloc_trim", "mbrtowc", "mbsnrtowcs", "mbsrtowcs",
    "memchr", "memcmp", "memcpy", "memmove", "memset", "mkdir",
    "mknod", "mmap", "mprotect", "munmap", "open", "opendir",
    "pause", "posix_madvise", "posix_memalign", "posix_spawn", "posix_spawn_file_actions_adddup2", "posix_spawn_file_actions_addopen",
    "posix_spawn_file_actions_destroy", "posix_spawn_file_actions_init", "pow", "pread", "pthread_cond_broadcast", "pthread_cond_destroy",
    "pthread_cond_signal", "pthread_cond_wait", "pthread_create", "pthread_detach", "pthread_join", "pthread_kill",
    "pthread_mutex_lock", "pthread_mutex_unlock", "pthread_once", "pthread_rwlock_rdlock", "pthread_rwlock_unlock", "pthread_rwlock_wrlock",
    "pthread_self", "pthread_sigmask", "qsort", "raise", "read", "readdir",
    "readlink", "realloc", "remove", "round", "secure_getenv", "setrlimit",
    "setsid", "sigaction", "sigaltstack", "sigemptyset", "sigfillset", "sigprocmask",
    "sin", "sinh", "sprintf", "sqrt", "stat", "stat64",
    "statfs", "stderr", "stdin", "stdout", "strchr", "strcmp",
    "strdup", "strerror_r", "strftime", "strncmp", "strncpy", "strsignal",
    "strtod", "strtold_l", "syscall", "sysconf", "tan", "tanh",
    "time", "tolower", "uname", "unlink", "vsnprintf", "wait",
    "wait4", "wcrtomb", "wcscmp", "wcslen", "wcsnrtombs", "wctob",
    "wmemchr", "wmemcpy", "wmemmove", "wmemset", "write"
]
