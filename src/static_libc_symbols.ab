// The C names src/static_libc/hosted.ab exports as abla_libc_NAME (the compiler's own module may declare NAME as an import): the link binds each
// by --defsym (bootstrapStaticLibcAliases is read by src/toolchain.ab), and the dlsym table lists NAME.
fun bootstrapStaticLibcAliases(): array<string> = [
    "abs", "atoi", "labs", "link", "llabs", "pthread_cond_init", "pthread_getspecific",
    "pthread_key_create", "pthread_mutex_destroy", "pthread_mutex_init", "pthread_setspecific", "setitimer", "signal", "utimes", "waitpid"
]

// Names of the table that an AArch64 static link cannot define: compiler-rt's half-float conversions. LLVM never calls them on AArch64 (the conversions are
// instructions there), libgcc.a of AArch64 does not define them, and the table would reference undefined symbols (the link failed: "undefined symbol:
// __truncdfhf2"). The AArch64 table (src/toolchain.ab) leaves them out; tools/test-libcall-coverage.sh checks that every other compiler-rt name of the table
// is in an AArch64 libgcc.a and that AArch64 code generation introduces none of these.
fun bootstrapStaticLibcSymbolsNotOnAarch64(): array<string> = ["__extendhfsf2", "__truncdfhf2", "__truncsfhf2"]
