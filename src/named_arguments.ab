import "named_overload.ab"
// Named arguments become positional before analysis
// (bootstrapNormalizeNamedArguments), and compile-time code's edits are
// committed to the raw program (bootstrapCommitEdits), which a new body's named
// arguments are normalized with.
import "f32_literal.ab"
import "expected_types.ab"
import "receiver_names.ab"
import "staged_parser.ab"
import "abla/sys/linux/process"
import "parser.ab"
import "sema.ab"
import "eval.ab"
import "generic_types.ab"

class BootstrapNamedTargetIndex(
    val names: array<string>,
    var values: array<int>,
    val slots: array<int>
) {
    fun find(name: string): int {
        var result = -1
        if (this.slots.size > 0) {
            var slot = bootstrapNamedTargetHash(name)
            slot = slot - slot / this.slots.size * this.slots.size
            var probes = 0
            while (result == -1 && probes < this.slots.size &&
                   this.slots[slot] >= 0) {
                val entry = this.slots[slot]
                if (this.names[entry] == name) {
                    result = this.values[entry]
                } else {
                    slot = slot + 1
                    if (slot == this.slots.size) slot = 0
                }
                probes = probes + 1
            }
        }
        result
    }
}

fun bootstrapNamedTargetHash(name: string): int {
    var hash = 0
    var index = 0
    while (index < name.size) {
        hash = hash * 131 + name[index]
        hash = hash - hash / 2147483647 * 2147483647
        index = index + 1
    }
    hash
}

fun bootstrapNamedTargetIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapNamedTargetIndex {
    val names: array<string> = []
    val values: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner == "" &&
            (candidate.kind == "fun" ||
             candidate.kind == "compile.fun" ||
             candidate.kind == "class")) {
            names.append(candidate.name)
            values.append(declaration)
        }
        declaration = declaration + 1
    }
    var capacity = 8
    while (capacity < names.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    var entry = 0
    while (entry < names.size) {
        slot = bootstrapNamedTargetHash(names[entry])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0) {
                slots[slot] = entry
                placed = true
            } else if (names[existing] == names[entry]) {
                // Preserve the normalizer's existing ambiguity result without
                // retaining or rescanning a list of duplicate declarations.
                values[existing] = -2
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    BootstrapNamedTargetIndex(names, values, slots)
}

class BootstrapNamedArgumentNormalizer(
    val declarations: array<BootstrapDeclaration>,
    val targets: BootstrapNamedTargetIndex,
    var errors: int,
    var diagnostics: string,
    // The module of the declaration being normalized, for source records.
    var sourceIdentity: string = "",
    // The class or type whose members the body being normalized reaches by
    // plain name ("" outside a method or extension function).
    var receiver: string = "",
    // Inside a method's or extension function's body, whose plain names
    // bootstrapResolveReceiverNames then reaches for the receiver's members.
    var inReceiverBody: bool = false,
    // The names the declaration being normalized binds itself: its parameters
    // and locals, anywhere in it.
    var callerNames: array<string> = [],
    // Functions that read a global a caller's name hides (globalAccessor).
    val accessors: array<BootstrapDeclaration> = [],
    val affineTypes: array<string> = [],
    var typeProbe: BootstrapNamedProbe? = null,
    // The parameters and locals in scope where the normalizer is: a plain
    // call of one of them is that local's, not a constructor's or function's.
    var visibleLocals: array<string> = []
) {
    fun fail(code: string, message: string, expression: BootstrapExpression) {
        this.errors = this.errors + 1
        this.diagnostics =
            "${this.diagnostics}error[E_NAMED_ARGUMENT_$code]: $message\n"
        this.diagnostics =
            "${this.diagnostics}source[named-argument]:${this.sourceIdentity}:${expression.begin}:${expression.end}\n"
    }

    // Pin a selected free overload before defaults are inserted: defaults
    // must not change the winner in the later positional overload pass.
    fun selectedOverload(target: int): BootstrapDeclaration {
        val declaration = this.declarations[target]
        if (declaration.kind != "fun" && declaration.kind != "compile.fun") return declaration
        val base = "__abla_named_selected_${declaration.name}_$target"
        var name = base
        var serial = 0
        while (this.target(name) != -1) {
            serial = serial + 1
            name = "${base}_$serial"
        }
        for (accessor in this.accessors) if (accessor.name == name) return accessor
        val copies = bootstrapNamedFunctionCopies([declaration], declaration.name, name)
        this.accessors.append(copies[0])
        copies[0]
    }

    fun target(name: string): int = this.targets.find(name)

    // Whether a plain `name` in the code being normalized means the caller's
    // own: something it binds, or a field of its receiver.
    fun callerHides(name: string): bool {
        if (bootstrapReceiverNameIn(this.callerNames, name)) return true
        if (this.receiver == "") return false
        for (declaration in this.declarations) {
            if (declaration.kind == "class" && declaration.name == this.receiver &&
                this.ownerField(declaration, name)) return true
            if (bootstrapIsExtensionFieldKind(declaration.kind) &&
                declaration.extensionOwner == this.receiver &&
                declaration.name == name) return true
        }
        false
    }

    // The name of a function reading the global `global`, which a default can
    // call from where a local or field of that name hides it.
    fun globalAccessor(global: BootstrapDeclaration): string {
        val name = "__abla_global_${global.name}"
        for (accessor in this.accessors) if (accessor.name == name) return name
        // (Already there from an earlier round of compile-time edits.)
        if (this.target(name) >= 0) return name
        this.accessors.append(BootstrapDeclaration(
            "fun", name, global.begin, global.end,
            BootstrapExpression("identifier", global.name, global.begin, global.end, []),
            [], [], if (global.resultType == "") "inferred" else global.resultType,
            [], [], "", [], "", false, false, false, "", 0, 0, [], [], [], [],
            global.sourceIdentity
        ))
        name
    }

    // Whether a local, or a function-typed field, of this name takes a call of it.
    fun callerCalls(name: string): bool {
        if (bootstrapReceiverNameIn(this.callerNames, name)) return true
        if (this.receiver == "") return false
        for (declaration in this.declarations) {
            if (declaration.kind == "class" && declaration.name == this.receiver) {
                var index = 0
                while (index < declaration.parameters.size) {
                    if (declaration.parameters[index] == name && this.ownerField(declaration,
                        name) &&
                        index < declaration.parameterTypes.size &&
                        bootstrapIsFunctionType(bootstrapNormalizeType(declaration
                            .parameterTypes[index]))) {
                        return true
                    }
                    index = index + 1
                }
            }
        }
        false
    }

    // The name of a copy of the top-level function `function`, every overload of
    // it, for a default to call where a local of that name hides it. Overload
    // resolution then chooses among the copies as it would among the originals.
    fun functionAccessor(function: string): string {
        val name = "__abla_function_$function"
        for (accessor in this.accessors) if (accessor.name == name) return name
        if (this.target(name) != -1) return name
        for (copy in bootstrapNamedFunctionCopies(this.declarations, function, name)) {
            this.accessors.append(copy)
        }
        name
    }

    // The callable top-level declaration a call of `name` reaches when it can't
    // be copied (a constructor, a function value or a foreign function).
    fun uncopiableCallable(name: string): bool {
        for (declaration in this.declarations) {
            if (declaration.name == name && declaration.extensionOwner == "" &&
                (declaration.kind == "class" || declaration.kind == "extern" ||
                 declaration.kind == "val" || declaration.kind == "var")) return true
        }
        false
    }

    // Whether a generated function can compute `declaration`'s default for
    // `parameter`: every type parameter its type mentions is one that an earlier
    // parameter gives, so a call of it infers that.
    fun defaultFunctionInfers(declaration: BootstrapDeclaration, parameter: int): bool {
        for (typeParameter in declaration.typeParameters) {
            if (!bootstrapNamedTypeMentions(declaration.parameterTypes[parameter],
                typeParameter)) continue
            var inferred = false
            var earlier = 0
            while (earlier < parameter) {
                if (bootstrapNamedTypeMentions(declaration.parameterTypes[earlier],
                    typeParameter)) {
                    inferred = true
                }
                earlier = earlier + 1
            }
            if (!inferred) return false
        }
        true
    }

    // Keep generic defaults in the declaration's scope until the wrapper is
    // instantiated. Its supplied arguments have already been evaluated in
    // the caller, in source order; defaults run afterwards, in parameter order.
    fun genericDefaultWrapper(
        declaration: BootstrapDeclaration,
        supplied: array<bool>,
        at: BootstrapExpression,
        method: bool,
        owner: int,
        existingName: string = ""
    ): string {
        val parameters: array<string> = []
        val types: array<string> = []
        val kinds: array<string> = []
        val statements: array<BootstrapExpression> = []
        val arguments: array<BootstrapExpression> = []
        val replacementNames: array<string> = []
        var index = 0
        while (index < declaration.parameters.size) {
            replacementNames.append("__abla_default_arg_$index")
            index = index + 1
        }
        val classTypes: array<string> = if (method && owner >=
            0) this.declarations[owner].typeParameters else []
        val typeParameters: array<string> = []
        for (name in classTypes) typeParameters.append(name)
        for (name in declaration.typeParameters) typeParameters.append(name)
        val receiver = BootstrapExpression("identifier", "this", at.begin, at.end, [])
        if (method) arguments.append(receiver)
        index = 0
        while (index < declaration.parameters.size) {
            val name = replacementNames[index]
            val declaredKind = if (index <
                declaration.parameterKinds.size) declaration.parameterKinds[index] else ""
            val kind = if (declaration.kind == "class" && (declaredKind == "val" || declaredKind ==
                "var"))
                "own" else declaredKind
            if (supplied[index]) {
                parameters.append(name)
                types.append(declaration.parameterTypes[index])
                kinds.append(kind)
            } else {
                var value = this.replaceParameterReferences(
                    declaration.parameterDefaults[index], declaration.parameters, replacementNames
                )
                if (method) value = this.qualifyReceiver(value, receiver, owner)
                statements.append(this.local(name, value))
            }
            var value = BootstrapExpression("identifier", name, at.begin, at.end, [])
            if (kind == "own") value = BootstrapExpression("named.transfer", "", at.begin, at.end,
                [value])
            arguments.append(value)
            index = index + 1
        }
        val names = bootstrapGenericParameterNames(declaration)
        val target = if (names.size == 0) declaration.name
            else "${declaration.name}<${bootstrapNamedTypeList(names)}>"
        statements.append(BootstrapExpression(if (method) "member.call" else "call", target,
            at.begin, at.end, arguments))
        val body = BootstrapExpression("block", "", at.begin, at.end, statements)
        var serial = 0
        var name = "__abla_named_defaults_${declaration.name}_$serial"
        if (existingName != "") name = existingName
        else {
            while (this.target(name) != -1 || this.hasAccessor(name)) {
                serial = serial + 1
                name = "__abla_named_defaults_${declaration.name}_$serial"
            }
        }
        val classNames: array<string> = []
        for (parameter in classTypes) classNames.append(bootstrapGenericParameterName(parameter))
        val extensionOwner = if (!method) "" else if (owner < 0) declaration.extensionOwner
            else if (classNames.size == 0) this.declarations[owner].name
            else "${this.declarations[owner].name}<${bootstrapNamedTypeList(classNames)}>"
        var resultType = if (declaration.kind == "class")
            "${declaration.name}<${bootstrapNamedTypeList(names)}>" else declaration.resultType
        if (bootstrapIsBorrowResultContract(resultType)) {
            val source = bootstrapBorrowResultSource(resultType)
            var replacement = source
            var parameter = 0
            while (parameter < declaration.parameters.size) {
                if (declaration.parameters[parameter] == source) replacement =
                    replacementNames[parameter]
                parameter = parameter + 1
            }
            resultType = "borrow($replacement) ${bootstrapBorrowResultElementType(resultType)}"
        }
        this.accessors.append(BootstrapDeclaration(
            if (declaration.kind == "compile.fun") "compile.fun" else "fun", name, at.begin, at.end,
            body, parameters, types,
            resultType,
            [], [], "", kinds, extensionOwner, false, false, false, "", 0, 0, [], [], [], [],
            declaration.sourceIdentity, [], false, false, typeParameters
        ))
        name
    }

    // Whether `expression` (a default) calls a constructor, function value or
    // foreign function of a name the caller hides.
    fun callsHiddenUncopiable(expression: BootstrapExpression, own: array<string>): bool {
        val called = bootstrapNamedCallBase(expression.text)
        if (expression.kind == "call" && !bootstrapReceiverNameIn(own, called) &&
            this.callerHides(called) && this.uncopiableCallable(called)) return true
        for (child in expression.children) {
            if (this.callsHiddenUncopiable(child, own)) return true
        }
        false
    }

    // A call of a new top-level function that computes `declaration`'s default
    // for parameter `parameter`, out of the caller's reach. It takes the earlier
    // parameters the default reads, which `arguments` names in the caller.
    fun defaultFunctionCall(
        declaration: BootstrapDeclaration,
        parameter: int,
        arguments: array<string>,
        at: BootstrapExpression,
        method: bool,
        owner: int,
        receiver: BootstrapExpression
    ): BootstrapExpression {
        val written = declaration.parameterDefaults[parameter]
        val parameterName = "__abla_receiver"
        // Renamed first, as a parameter hides a field of its name.
        val value = if (method) this.qualifyReceiver(
            this.replaceParameterReferences(written, declaration.parameters, arguments),
            BootstrapExpression("identifier", parameterName, at.begin, at.end, []), owner
        ) else written
        var used: array<string> = []
        bootstrapNamedIdentifiers(value, used)
        val parameters: array<string> = []
        val types: array<string> = []
        val kinds: array<string> = []
        val passed: array<BootstrapExpression> = []
        // A generic class's receiver goes along always: it says what its type
        // parameters are, which the default's type may mention.
        val classTypes: array<string> = if (owner >=
            0) this.declarations[owner].typeParameters else []
        if (method && (classTypes.size > 0 || bootstrapReceiverNameIn(used, parameterName))) {
            parameters.append(parameterName)
            types.append(if (owner < 0) declaration.extensionOwner
                else if (classTypes.size == 0) this.declarations[owner].name
                else "${this.declarations[owner].name}<${bootstrapNamedTypeList(classTypes)}>")
            kinds.append("")
            passed.append(receiver)
        }
        var earlier = 0
        while (earlier < parameter) {
            val earlierName = if (method) arguments[earlier] else declaration.parameters[earlier]
            var gives = false
            for (typeParameter in declaration.typeParameters) {
                if (bootstrapNamedTypeMentions(declaration.parameterTypes[parameter],
                    typeParameter) &&
                    bootstrapNamedTypeMentions(declaration.parameterTypes[earlier],
                        typeParameter)) gives = true
            }
            if (gives || bootstrapReceiverNameIn(used, earlierName)) {
                parameters.append(earlierName)
                types.append(declaration.parameterTypes[earlier])
                kinds.append("")
                passed.append(BootstrapExpression(
                    "identifier", arguments[earlier], at.begin, at.end, []
                ))
            }
            earlier = earlier + 1
        }
        // Those a call of it infers: the rest aren't the default's concern.
        val typeParameters: array<string> = []
        for (typeParameter in classTypes) typeParameters.append(typeParameter)
        for (typeParameter in declaration.typeParameters) {
            var mentioned = false
            for (type in types) if (bootstrapNamedTypeMentions(type,
                typeParameter)) mentioned = true
            if (mentioned) typeParameters.append(typeParameter)
        }
        var serial = 0
        var name = "__abla_default_${declaration.name}_${parameter}_$serial"
        while (this.target(name) != -1 || this.hasAccessor(name)) {
            serial = serial + 1
            name = "__abla_default_${declaration.name}_${parameter}_$serial"
        }
        this.accessors.append(BootstrapDeclaration(
            "fun", name, value.begin, value.end, value,
            parameters, types, declaration.parameterTypes[parameter],
            [], [], "", kinds, "", false, false, false, "", 0, 0, [], [], [], [],
            declaration.sourceIdentity, [], false, false, typeParameters
        ))
        BootstrapExpression("call", name, at.begin, at.end, passed)
    }

    fun hasAccessor(name: string): bool {
        for (accessor in this.accessors) if (accessor.name == name) return true
        false
    }

    // `expression` (a default, now in a caller's body) with each global it reads
    // or function it calls that the caller hides reached through an accessor. `own` are the names that
    // are the default's: what it binds, and the arguments put in for parameters.
    fun readCalleeGlobals(
        expression: BootstrapExpression,
        own: array<string>
    ): BootstrapExpression {
        if (expression.kind == "identifier" && !bootstrapReceiverNameIn(own, expression.text) &&
            this.callerHides(expression.text)) {
            for (declaration in this.declarations) {
                if ((declaration.kind == "val" || declaration.kind == "var") &&
                    declaration.extensionOwner == "" && declaration.name == expression.text) {
                    return BootstrapExpression(
                        "call", this.globalAccessor(declaration),
                        expression.begin, expression.end, []
                    )
                }
            }
        }
        val children: array<BootstrapExpression> = []
        for (child in expression.children) children.append(this.readCalleeGlobals(child, own))
        var text = expression.text
        val called = bootstrapNamedCallBase(text)
        // A call with type arguments names a declaration: no local takes them.
        if (expression.kind == "call" && called == text &&
            !bootstrapReceiverNameIn(own, called) && this.callerHides(called)) {
            for (declaration in this.declarations) {
                if ((declaration.kind == "val" || declaration.kind == "var") &&
                    declaration.extensionOwner == "" && declaration.name == text) {
                    // The accessor hands back the global function value itself.
                    val arguments: array<BootstrapExpression> = [BootstrapExpression(
                        "call", this.globalAccessor(declaration),
                        expression.begin, expression.end, []
                    )]
                    for (child in children) arguments.append(child)
                    return BootstrapExpression(
                        "call.value", "", expression.begin, expression.end, arguments
                    )
                }
            }
            if (this.uncopiableCallable(called)) {
                if (this.callerCalls(called)) this.fail(
                    "HIDDEN",
                    "a default left out of this call calls `$text`, which a local or field here hides, and it can't run elsewhere (its type has a type parameter no earlier parameter gives): pass that argument, or rename the local",
                    expression
                )
            } else if (this.target(text) != -1) text = this.functionAccessor(text)
        }
        BootstrapExpression(expression.kind, text, expression.begin, expression.end, children)
    }

    // `expression` (a top-level function's or constructor's default, now in a
    // caller's method body) keeps the top-level meaning of the calls in it.
    fun keepTopLevelCalls(expression: BootstrapExpression): BootstrapExpression {
        val children: array<BootstrapExpression> = []
        for (child in expression.children) children.append(this.keepTopLevelCalls(child))
        BootstrapExpression(
            if (expression.kind == "call") "call.top-level" else expression.kind,
            expression.text, expression.begin, expression.end, children
        )
    }

    // The class methods and extension functions named `name` that have a
    // parameter for every named argument in `children` (a member call's).
    fun methodTargets(
        name: string,
        children: array<BootstrapExpression>,
        // Only this type's methods ("" any type's).
        owner: string = ""
    ): BootstrapNamedMethodTargets {
        val owners: array<int> = []
        val methods: array<int> = []
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if (declaration.kind == "class" && (owner == "" || declaration.name == owner)) {
                var method = 0
                while (method < declaration.methods.size) {
                    if (declaration.methods[method].name == name &&
                        this.acceptsNamed(declaration.methods[method], children)) {
                        owners.append(index)
                        methods.append(method)
                    }
                    method = method + 1
                }
            } else if (declaration.name == name &&
                declaration.extensionOwner != "" &&
                (owner == "" || declaration.extensionOwner == owner) &&
                (declaration.kind == "fun" || declaration.kind == "compile.fun") &&
                this.acceptsNamed(declaration, children)) {
                owners.append(index)
                methods.append(-1)
            }
            index = index + 1
        }
        BootstrapNamedMethodTargets(owners, methods)
    }

    fun acceptsNamed(
        declaration: BootstrapDeclaration,
        children: array<BootstrapExpression>
    ): bool {
        var argument = 1
        while (argument < children.size) {
            if (children[argument].kind == "named.argument" &&
                this.parameter(declaration, children[argument].text) < 0) return false
            argument = argument + 1
        }
        true
    }

    fun methodDeclaration(
        targets: BootstrapNamedMethodTargets,
        target: int
    ): BootstrapDeclaration {
        val owner = this.declarations[targets.owners[target]]
        if (targets.methods[target] >= 0) owner.methods[targets.methods[target]]
        else owner
    }

    // Whether every target takes the same parameters in the same order, so
    // the arguments line up whichever the receiver's type selects.
    fun sameParameters(targets: BootstrapNamedMethodTargets): bool {
        val first = this.methodDeclaration(targets, 0)
        var target = 1
        while (target < targets.owners.size) {
            val other = this.methodDeclaration(targets, target)
            if (other.parameters.size != first.parameters.size) return false
            var parameter = 0
            while (parameter < first.parameters.size) {
                if (other.parameters[parameter] != first.parameters[parameter]) return false
                parameter = parameter + 1
            }
            target = target + 1
        }
        true
    }

    fun differentOmittedDefaults(targets: BootstrapNamedMethodTargets,
        children: array<BootstrapExpression>): bool {
        if (targets.owners.size < 2) return false
        val first = this.methodDeclaration(targets, 0)
        var parameter = 0
        while (parameter < first.parameters.size) {
            var supplied = false
            var positional = 0
            var child = 1
            while (child < children.size) {
                val argument = children[child]
                if (argument.kind == "named.argument") {
                    if (argument.text == first.parameters[parameter]) supplied = true
                } else {
                    if (positional == parameter) supplied = true
                    positional = positional + 1
                }
                child = child + 1
            }
            if (!supplied) {
                var other = 1
                while (other < targets.owners.size) {
                    val declaration = this.methodDeclaration(targets, other)
                    val firstHas = parameter < first.parameterDefaults.size
                    val otherHas = parameter < declaration.parameterDefaults.size
                    if (firstHas != otherHas) return true
                    if (firstHas && !bootstrapSameExpression(first.parameterDefaults[parameter],
                        declaration.parameterDefaults[parameter])) return true
                    other = other + 1
                }
            }
            parameter = parameter + 1
        }
        false
    }

    // The class a target's defaults read the members of: a method's own
    // class, or an extension's receiver class (-1 when it is not a class).
    // The class whose members a target's default may name without `this`: a
    // class method's; an extension reaches them only through `this`.
    fun methodClass(targets: BootstrapNamedMethodTargets, target: int): int =
        if (targets.methods[target] >= 0) targets.owners[target] else -1

    // `expression` (a method's default) read in the receiver's context:
    // `this` is `receiver`, and a field or method of `owner` written without a
    // receiver is reached through it, never through a caller's variable.
    fun qualifyReceiver(
        expression: BootstrapExpression,
        receiver: BootstrapExpression,
        owner: int
    ): BootstrapExpression {
        if (expression.kind == "identifier" && expression.text == "this") return receiver
        val children: array<BootstrapExpression> = []
        for (child in expression.children) {
            children.append(this.qualifyReceiver(child, receiver, owner))
        }
        if (owner >= 0) {
            val declaration = this.declarations[owner]
            if (expression.kind == "identifier" &&
                this.ownerField(declaration, expression.text)) {
                return BootstrapExpression(
                    "member", expression.text, expression.begin, expression.end,
                    [receiver]
                )
            }
            if (expression.kind == "call") {
                for (method in declaration.methods) {
                    if (method.name == expression.text) {
                        val arguments: array<BootstrapExpression> = [receiver]
                        for (child in children) arguments.append(child)
                        return BootstrapExpression(
                            "member.call", expression.text, expression.begin,
                            expression.end, arguments
                        )
                    }
                }
            }
        }
        BootstrapExpression(
            expression.kind, expression.text, expression.begin, expression.end,
            children
        )
    }

    fun ownerField(declaration: BootstrapDeclaration, name: string): bool {
        var index = 0
        while (index < declaration.parameters.size) {
            if (declaration.parameters[index] == name &&
                index < declaration.parameterKinds.size &&
                (declaration.parameterKinds[index] == "val" ||
                 declaration.parameterKinds[index] == "var")) return true
            index = index + 1
        }
        false
    }

    fun parameter(declaration: BootstrapDeclaration, name: string): int {
        var result = -1
        var index = 0
        while (index < declaration.parameters.size) {
            if (declaration.parameters[index] == name) result = index
            index = index + 1
        }
        result
    }

    fun requiresNormalization(expression: BootstrapExpression): bool {
        var required = false
        var child = 0
        while (!required && child < expression.children.size) {
            required = this.requiresNormalization(
                expression.children[child]
            )
            child = child + 1
        }
        var hasNamed = false
        child = 0
        while ((expression.kind == "call" ||
                expression.kind == "member.call") &&
               child < expression.children.size) {
            if (expression.children[child].kind == "named.argument") {
                hasNamed = true
            }
            child = child + 1
        }
        if (hasNamed) required = true
        if (!required && expression.kind == "call") {
            val selectedTarget = this.target(bootstrapNamedCallBase(expression.text))
            if (selectedTarget >= 0 &&
                this.declarations[selectedTarget].kind == "class" &&
                (expression.children.size <
                    this.declarations[selectedTarget].parameters.size ||
                 bootstrapHasAnyDelegatedProperty(this.declarations[selectedTarget]))) {
                required = true
            }
        }
        required
    }

    // The parameter the `position`th positional argument fills: a delegated
    // property takes no argument, so positions skip it.
    fun positionalParameter(declaration: BootstrapDeclaration, position: int): int {
        var remaining = position
        var index = 0
        while (index < declaration.parameters.size) {
            if (!bootstrapIsAnyDelegatedProperty(declaration, index)) {
                if (remaining == 0) return index
                remaining = remaining - 1
            }
            index = index + 1
        }
        declaration.parameters.size
    }

    // Match supplied syntax to parameters once, before either lowering or the
    // early evaluator binds values. Neither path reimplements name/order rules.
    fun suppliedParameters(
        declaration: BootstrapDeclaration,
        call: BootstrapExpression
    ): array<int> {
        val selectedParameters: array<int> = []
        val seen: array<bool> = []
        for (name in declaration.parameters) seen.append(false)
        var positional = 0
        var namedSeen = false
        var argument = if (call.kind == "member.call") 1 else 0
        while (argument < call.children.size) {
            val supplied = call.children[argument]
            var selected = this.positionalParameter(declaration, positional)
            if (supplied.kind == "named.argument") {
                namedSeen = true
                selected = this.parameter(declaration, supplied.text)
                if (selected < 0) this.fail(
                    "UNKNOWN", "`${supplied.text}` is not a parameter of `${call.text}`", supplied
                )
                if (selected >= 0 && bootstrapIsAnyDelegatedProperty(declaration, selected)) {
                    this.fail(
                        "DELEGATED",
                        "`${supplied.text}` is a delegated property of `${call.text}`: its delegate comes from `by`, not from an argument",
                        supplied
                    )
                    selected = -1
                }
                if (supplied.children.size != 1) this.fail(
                    "VALUE", "named argument `${supplied.text}` requires one value", supplied
                )
            } else {
                if (namedSeen) this.fail(
                    "ORDER", "positional arguments must precede named arguments", supplied
                )
                positional = positional + 1
            }
            if (selected >= declaration.parameters.size) this.fail(
                "ARITY", "too many arguments for `${call.text}`", supplied
            )
            if (selected >= 0 && selected < seen.size) {
                if (seen[selected]) this.fail(
                    "DUPLICATE",
                    "parameter `${declaration.parameters[selected]}` is supplied more than once",
                    supplied
                )
                seen[selected] = true
            }
            selectedParameters.append(selected)
            argument = argument + 1
        }
        selectedParameters
    }

    fun replaceParameterReferences(
        expression: BootstrapExpression,
        names: array<string>,
        replacements: array<string>
    ): BootstrapExpression {
        var replacement = ""
        var index = 0
        while (expression.kind == "identifier" && index < names.size) {
            if (names[index] == expression.text &&
                index < replacements.size) replacement = replacements[index]
            index = index + 1
        }
        val children: array<BootstrapExpression> = []
        index = 0
        while (index < expression.children.size) {
            children.append(this.replaceParameterReferences(
                expression.children[index], names, replacements
            ))
            index = index + 1
        }
        BootstrapExpression(
            expression.kind,
            if (replacement == "") expression.text else replacement,
            expression.begin,
            expression.end,
            children
        )
    }

    fun local(name: string, value: BootstrapExpression): BootstrapExpression =
        BootstrapExpression(
            "local.val", name, value.begin, value.end,
            [
                value,
                BootstrapExpression(
                    "type", "inferred", value.begin, value.begin, []
                )
            ]
        )

    // `visibleLocals` cut back to its first `size` names.
    fun leaveScope(size: int): void {
        val kept: array<string> = []
        var index = 0
        while (index < size) {
            kept.append(this.visibleLocals[index])
            index = index + 1
        }
        this.visibleLocals = kept
    }

    fun normalize(expression: BootstrapExpression): BootstrapExpression {
        val normalizedChildren: array<BootstrapExpression> = []
        val scope = this.visibleLocals.size
        if (expression.kind == "for") this.visibleLocals.append(bootstrapForName(expression))
        val lambda = (expression.kind == "lambda" || expression.kind == "lambda.move") &&
            expression.children.size > 0
        var child = 0
        while (child < expression.children.size) {
            // A lambda's parameters are in scope in its body, its last child.
            if (lambda && child + 1 < expression.children.size) {
                this.visibleLocals.append(expression.children[child].text)
            }
            normalizedChildren.append(this.normalize(
                expression.children[child]
            ))
            // A block's local is in scope in the statements after it.
            val statement = expression.children[child]
            if (expression.kind == "block" &&
                (statement.kind == "local.val" || statement.kind == "local.var")) {
                this.visibleLocals.append(statement.text)
            }
            child = child + 1
        }
        if (this.visibleLocals.size > scope) this.leaveScope(scope)
        var result = BootstrapExpression(
            expression.kind,
            expression.text,
            expression.begin,
            expression.end,
            normalizedChildren
        )
        var hasNamed = false
        child = 0
        while ((result.kind == "call" || result.kind == "member.call") &&
            child < result.children.size) {
            if (result.children[child].kind == "named.argument") {
                hasNamed = true
            }
            child = child + 1
        }
        var normalizeCall = hasNamed
        var selectedTarget = -1
        var selectedOverload = -1
        var memberTargets = BootstrapNamedMethodTargets([], [])
        // A local of the called name hides every declaration of it; type
        // arguments only follow a declared function or constructor.
        val localCall = result.kind == "call" &&
            bootstrapNamedCallBase(result.text) == result.text &&
            bootstrapReceiverNameIn(this.visibleLocals, result.text)
        // A plain call in a method that the receiver's method takes is that
        // method's, before any top-level declaration of the name.
        if (result.kind == "call" && hasNamed && this.receiver != "" && !localCall) {
            val arguments: array<BootstrapExpression> = [
                BootstrapExpression("identifier", "this", result.begin, result.begin, [])
            ]
            for (argument in result.children) arguments.append(argument)
            val own = this.methodTargets(bootstrapNamedCallBase(result.text), arguments,
                this.receiver)
            if (own.owners.size > 0) {
                result = BootstrapExpression(
                    "member.call", result.text, result.begin, result.end, arguments
                )
                memberTargets = own
            }
        }
        if (result.kind == "call" && !localCall) {
            selectedTarget = this.target(bootstrapNamedCallBase(result.text))
        }
        if (result.kind == "member.call" && hasNamed) {
            if (memberTargets.owners.size == 0) {
                memberTargets = this.methodTargets(bootstrapNamedCallBase(result.text),
                    result.children)
            }
            selectedTarget = if (memberTargets.owners.size == 0) -1
                else if (this.sameParameters(memberTargets)) 0
                else -2
        }
        if (hasNamed && (selectedTarget == -2 ||
            (result.kind == "member.call" && selectedTarget >= 0 &&
             this.differentOmittedDefaults(memberTargets, result.children)))) {
            if (this.typeProbe == null) this.typeProbe = bootstrapBuildNamedProbe(this.declarations)
            val probe = this.typeProbe
            val choice = if (probe != null) probe.find(this.sourceIdentity, expression) else null
            if (choice != null && choice.declaration >= 0) {
                selectedTarget = choice.declaration
                if (!choice.member) selectedOverload = choice.declaration
                if (choice.member) {
                    memberTargets = BootstrapNamedMethodTargets([choice.declaration],
                        [choice.method])
                    selectedTarget = 0
                }
            }
        }
        if (!normalizeCall && selectedTarget >= 0 &&
            this.declarations[selectedTarget].kind == "class" &&
            (result.children.size <
                this.declarations[selectedTarget].parameters.size ||
             bootstrapHasAnyDelegatedProperty(this.declarations[selectedTarget]))) {
            normalizeCall = true
        }
        if (normalizeCall) {
            val target = selectedTarget
            val method = result.kind == "member.call"
            if (target < 0) {
                this.fail(
                    "TARGET",
                    if (target == -2 && method)
                        "named call `${result.text}` matches methods whose parameters differ: pass its arguments by position"
                    else if (target == -2)
                        "named call `${result.text}` is ambiguous"
                    else if (method)
                        "named call `${result.text}` has no method or extension with those parameters"
                    else "named call `${result.text}` has no declared function or constructor target",
                    result
                )
            }
            if (target >= 0) {
                val declaration = if (method) this.methodDeclaration(memberTargets, 0)
                    else if (selectedOverload >= 0) this.selectedOverload(selectedOverload)
                    else this.declarations[target]
                val generic = declaration.typeParameters.size > 0 ||
                    (method && this.declarations[memberTargets.owners[0]].typeParameters.size > 0)
                val values: array<BootstrapExpression> = []
                val temporaryNames: array<string> = []
                val generatedTemporaries: array<bool> = []
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    values.append(BootstrapExpression(
                        "missing", "", result.begin, result.begin, []
                    ))
                    temporaryNames.append("")
                    generatedTemporaries.append(false)
                    parameter = parameter + 1
                }
                val statements: array<BootstrapExpression> = []
                // A method call's receiver is evaluated once, first; a place
                // (`name`, `name.field`) is read again where it is needed.
                var receiver = result
                if (method) {
                    receiver = result.children[0]
                    if (!bootstrapNamedArgumentPlace(receiver)) {
                        val temporary = "__abla_named_${result.begin}_receiver"
                        statements.append(this.local(temporary, receiver))
                        receiver = BootstrapExpression(
                            "identifier", temporary, receiver.begin, receiver.end, []
                        )
                    }
                }
                val selectedParameters = this.suppliedParameters(declaration, result)
                val argumentBegin = if (result.kind == "member.call") 1 else 0
                var argument = argumentBegin
                while (argument < result.children.size) {
                    val supplied = result.children[argument]
                    val selected = selectedParameters[argument - argumentBegin]
                    val value = if (supplied.kind == "named.argument" && supplied.children.size ==
                        1)
                        supplied.children[0] else supplied
                    if (selected >= 0 && selected < declaration.parameters.size) {
                        // A `var` parameter borrows the caller's place
                        // itself; through a `val` temporary it borrowed a
                        // borrow and failed ownership.borrow-exclusive.
                        val borrowsPlace = selected <
                            declaration.parameterKinds.size &&
                            declaration.parameterKinds[selected] == "var" &&
                            bootstrapNamedArgumentPlace(value)
                        if (temporaryNames[selected] == "" && borrowsPlace) {
                            // A default naming this parameter reads the
                            // variable; a member place has no such name.
                            temporaryNames[selected] =
                                if (value.kind == "identifier") value.text
                                else "__abla_named_${result.begin}_place_$argument"
                            values[selected] = value
                        }
                        if (temporaryNames[selected] == "") {
                            val temporary =
                                "__abla_named_${result.begin}_${argument}"
                            temporaryNames[selected] = temporary
                            generatedTemporaries[selected] = true
                            values[selected] = BootstrapExpression(
                                "identifier", temporary,
                                value.begin, value.end, []
                            )
                            var initializer = bootstrapNamedTypedLiteral(
                                value, declaration.parameterTypes[selected], generic
                            )
                            // Borrow an affine place at its original evaluation
                            // point, rather than moving it into the temporary.
                            // Generic parameters are decided after inference.
                            if (declaration.kind != "class" &&
                                declaration.parameterKinds[selected] != "own" &&
                                bootstrapNamedBorrowPlace(value) &&
                                (generic || bootstrapSummaryTypeIsAffine(
                                    declaration.parameterTypes[selected], this.affineTypes
                                ))) {
                                initializer = BootstrapExpression(
                                    "named.borrow", "", value.begin, value.end, [initializer]
                                )
                            }
                            statements.append(this.local(temporary, initializer))
                        }
                    }
                    argument = argument + 1
                }
                val supplied: array<bool> = []
                var wrapGenericDefaults = false
                val wrapperOwner = if (method) this.methodClass(memberTargets, 0) else -1
                val wrapperParameters: array<string> = []
                if (method && wrapperOwner >= 0) {
                    for (typeParameter in this.declarations[wrapperOwner].typeParameters)
                        wrapperParameters.append(bootstrapGenericParameterName(typeParameter))
                }
                for (typeParameter in bootstrapGenericParameterNames(declaration)) wrapperParameters
                    .append(typeParameter)
                var canWrap = (declaration.kind == "fun" || declaration.kind == "compile.fun" ||
                    declaration.kind == "class") &&
                    wrapperParameters.size > 0 && !bootstrapHasAnyDelegatedProperty(declaration)
                parameter = 0
                while (parameter < declaration.parameters.size) {
                    val present = temporaryNames[parameter] != ""
                    supplied.append(present)
                    if (!present) {
                        if (parameter >= declaration.parameterDefaults.size ||
                            declaration.parameterDefaults[parameter].kind == "missing") canWrap =
                            false
                        else {
                            if (method) {
                                var other = 1
                                while (other < memberTargets.owners.size) {
                                    val alternative = this.methodDeclaration(memberTargets, other)
                                    if (parameter >= alternative.parameterDefaults.size ||
                                        !bootstrapSameExpression(alternative
                                            .parameterDefaults[parameter],
                                            declaration.parameterDefaults[parameter])) canWrap =
                                        false
                                    other = other + 1
                                }
                            }
                            for (typeParameter in wrapperParameters) {
                                if (bootstrapNamedTypeMentions(declaration
                                    .parameterTypes[parameter], typeParameter) ||
                                    bootstrapGenericDefaultMentions(declaration
                                        .parameterDefaults[parameter], typeParameter))
                                    wrapGenericDefaults = true
                            }
                        }
                    }
                    parameter = parameter + 1
                }
                wrapGenericDefaults = wrapGenericDefaults && canWrap
                val wrapper = if (wrapGenericDefaults) this.genericDefaultWrapper(declaration,
                    supplied, result, method, wrapperOwner) else ""
                if (wrapGenericDefaults && method) {
                    var other = 1
                    while (other < memberTargets.owners.size) {
                        this.genericDefaultWrapper(
                            this.methodDeclaration(memberTargets, other), supplied, result, true,
                            this.methodClass(memberTargets, other), wrapper
                        )
                        other = other + 1
                    }
                    // An interface-typed receiver dispatches through the
                    // interface, not any one implementing class. Give that
                    // receiver an extension when it declares the same defaults.
                    var owner = 0
                    while (owner < this.declarations.size) {
                        val candidate = this.declarations[owner]
                        if (candidate.kind == "interface") {
                            for (found in candidate.methods) {
                                if (found.name == declaration.name && found.parameters.size ==
                                    declaration.parameters.size) {
                                    var matches = true
                                    var item = 0
                                    while (item < declaration.parameters.size) {
                                        if (found.parameters[item] !=
                                            declaration.parameters[item]) matches = false
                                        if (!supplied[item] && (item >=
                                            found.parameterDefaults.size ||
                                            !bootstrapSameExpression(found.parameterDefaults[item],
                                                declaration.parameterDefaults[item]))) matches =
                                            false
                                        item = item + 1
                                    }
                                    if (matches) this.genericDefaultWrapper(found, supplied, result,
                                        true, owner, wrapper)
                                }
                            }
                        }
                        owner = owner + 1
                    }
                }
                parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (temporaryNames[parameter] == "" && !wrapGenericDefaults) {
                        var defaultValue = BootstrapExpression(
                            "missing", "", result.begin, result.begin, []
                        )
                        if (parameter < declaration.parameterDefaults.size) {
                            defaultValue = declaration.parameterDefaults[parameter]
                        }
                        // A delegated property's field holds the delegate.
                        if ((defaultValue.kind == "delegate.initializer" ||
                             defaultValue.kind == "delegate.field") &&
                            defaultValue.children.size > 0) {
                            defaultValue = defaultValue.children[0]
                        }
                        if (defaultValue.kind == "missing") this.fail(
                            "REQUIRED",
                            "required parameter `${declaration.parameters[parameter]}` is missing from `${result.text}`",
                            result
                        )
                        if (defaultValue.kind != "missing" && method) {
                            // Every method the receiver may select must
                            // fill the omitted parameter the same way.
                            var other = 1
                            while (other < memberTargets.owners.size) {
                                val alternative = this.methodDeclaration(memberTargets, other)
                                if (parameter >= alternative.parameterDefaults.size ||
                                    !bootstrapSameExpression(
                                        alternative.parameterDefaults[parameter],
                                        defaultValue
                                    )) {
                                    this.fail(
                                        "TARGET",
                                        "named call `${result.text}` matches methods whose default for `${declaration.parameters[parameter]}` differs: pass it",
                                        result
                                    )
                                    other = memberTargets.owners.size
                                }
                                other = other + 1
                            }
                        }
                        if (defaultValue.kind != "missing") {
                            val temporary =
                                "__abla_named_${result.begin}_default_$parameter"
                            var substituted = this.replaceParameterReferences(
                                defaultValue,
                                declaration.parameters,
                                temporaryNames
                            )
                            val defaultOwner = if (method) this.methodClass(memberTargets,
                                0) else -1
                            // A method's default reads the receiver's
                            // members, not the caller's names.
                            if (method) substituted = this.qualifyReceiver(
                                substituted, receiver, this.methodClass(memberTargets, 0)
                            )
                            // Without a wrapper (a delegated property rules it
                            // out) a generic default is spelled with the type
                            // arguments the call gives explicitly.
                            if (generic && !method) {
                                val typeArguments = bootstrapNamedCallTypeArguments(result.text)
                                val typeParameters = bootstrapGenericParameterNames(declaration)
                                if (typeArguments.size > 0 &&
                                    typeArguments.size == typeParameters.size) {
                                    substituted = bootstrapGenericDefaultSubstitute(
                                        substituted, typeParameters, typeArguments
                                    )
                                }
                            }
                            // The default means what it does at its callee,
                            // where none of the caller's locals is in scope.
                            val callerVisible: array<string> = []
                            for (name in this.visibleLocals) callerVisible.append(name)
                            this.visibleLocals = []
                            val calleeDefault = this.normalize(substituted)
                            this.visibleLocals = callerVisible
                            var normalizedDefault = bootstrapNamedTypedLiteral(
                                calleeDefault,
                                declaration.parameterTypes[parameter],
                                generic
                            )
                            var own: array<string> = []
                            for (name in temporaryNames) own.append(name)
                            bootstrapReceiverBoundNames(normalizedDefault, own)
                            if (this.defaultFunctionInfers(declaration, parameter) &&
                                !bootstrapIsAnyDelegatedProperty(declaration, parameter) &&
                                this.callsHiddenUncopiable(normalizedDefault, own)) {
                                // No accessor reaches these: the whole default
                                // runs where it was written.
                                normalizedDefault = this.defaultFunctionCall(
                                    declaration, parameter, temporaryNames, result,
                                    method, defaultOwner, receiver
                                )
                            } else {
                                normalizedDefault = this.readCalleeGlobals(normalizedDefault, own)
                            }
                            if (!method && this.inReceiverBody) {
                                normalizedDefault = this.keepTopLevelCalls(normalizedDefault)
                            }
                            temporaryNames[parameter] = temporary
                            if (bootstrapIsAnyDelegatedProperty(declaration, parameter)) {
                                // The delegate goes straight into its field: it
                                // may be a resource, which a temporary would
                                // have to move.
                                values[parameter] = normalizedDefault
                            } else {
                                values[parameter] = BootstrapExpression(
                                    "identifier", temporary,
                                    defaultValue.begin, defaultValue.end, []
                                )
                                statements.append(this.local(
                                    temporary, normalizedDefault
                                ))
                                generatedTemporaries[parameter] = true
                            }
                        }
                    }
                    parameter = parameter + 1
                }
                val normalizedValues: array<BootstrapExpression> = []
                if (method) normalizedValues.append(receiver)
                val typeNames = bootstrapGenericParameterNames(declaration)
                val typeArguments = bootstrapGenericCalleeArguments(result.text)
                parameter = 0
                while (parameter < values.size) {
                    var value = values[parameter]
                    // The caller's expression has already been checked when
                    // stored in this temporary. Transfer that temporary to an
                    // owning parameter after all defaults have read it.
                    val owns = (!method && declaration.kind == "class" &&
                        parameter < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[parameter] == "val" ||
                         declaration.parameterKinds[parameter] == "var" ||
                         declaration.parameterKinds[parameter] == "own")) ||
                        (parameter < declaration.parameterKinds.size &&
                         declaration.parameterKinds[parameter] == "own")
                    var parameterType = if (parameter < declaration.parameterTypes.size)
                        declaration.parameterTypes[parameter] else "unknown"
                    if (typeNames.size > 0 && typeNames.size == typeArguments.size) {
                        parameterType = bootstrapGenericSubstituteWords(parameterType, typeNames,
                            typeArguments)
                    }
                    if (owns && generatedTemporaries[parameter] && value.kind == "identifier" &&
                        bootstrapSummaryTypeIsAffine(parameterType, this.affineTypes)) {
                        value = BootstrapExpression("call", "move", value.begin, value.end, [value])
                    } else if (owns && generatedTemporaries[parameter] && value.kind ==
                        "identifier" &&
                        typeNames.size > 0) {
                        // Its concrete type is learned by generic inference.
                        // The analyzer and lowerer move this temporary only if
                        // that inferred type is affine.
                        value = BootstrapExpression("named.transfer", "", value.begin, value.end,
                            [value])
                    }
                    if (!wrapGenericDefaults || supplied[parameter]) normalizedValues.append(value)
                    parameter = parameter + 1
                }
                // Its names chose the top-level target, which positional
                // arguments alone wouldn't tell a receiver's method from.
                statements.append(BootstrapExpression(
                    if (!method && hasNamed && this.inReceiverBody) "call.top-level"
                    else result.kind,
                    if (wrapGenericDefaults)
                        "$wrapper${result.text.slice(bootstrapNamedCallBase(result.text).size, result.text.size)}"
                    else if (selectedOverload >= 0)
                        "${declaration.name}${result.text.slice(bootstrapNamedCallBase(result.text).size, result.text.size)}"
                    else result.text,
                    result.begin,
                    result.end,
                    normalizedValues
                ))
                result = BootstrapExpression(
                    "block", "", result.begin, result.end, statements
                )
            }
        }
        result
    }
}

/** The names `expression` reads. */
fun bootstrapNamedIdentifiers(expression: BootstrapExpression, var names: array<string>): void {
    if (expression.kind == "identifier") names.append(expression.text)
    for (child in expression.children) bootstrapNamedIdentifiers(child, names)
    return
}

/** A call's name without its type arguments: `Box<T>` is a call of `Box`. */
/** The type arguments a call spells (`Box<string, Map<K, V>>`), or none. */
fun bootstrapNamedCallTypeArguments(text: string): array<string> {
    val arguments: array<string> = []
    val open = bootstrapNamedCallBase(text).size
    if (open + 2 > text.size || text[text.size - 1] != 62) return arguments
    var depth = 0
    var begin = open + 1
    var index = begin
    while (index < text.size - 1) {
        val byte = text[index]
        if (byte == 60 || byte == 40) depth = depth + 1
        if (byte == 62 || byte == 41) depth = depth - 1
        if (byte == 44 && depth == 0) {
            arguments.append(text.slice(begin, index).trim())
            begin = index + 1
        }
        index = index + 1
    }
    arguments.append(text.slice(begin, text.size - 1).trim())
    arguments
}

fun bootstrapNamedCallBase(text: string): string {
    var index = 0
    while (index < text.size && text[index] != 60) index = index + 1
    text.slice(0, index)
}

/** Whether a type's text names `word` whole. */
fun bootstrapNamedTypeMentions(type: string, word: string): bool {
    var index = 0
    while (index + word.size <= type.size) {
        if (type.slice(index, index + word.size) == word &&
            (index == 0 || !bootstrapNamedTypeWordByte(type[index - 1])) &&
            (index + word.size == type.size || !bootstrapNamedTypeWordByte(type[index +
                word.size]))) {
            return true
        }
        index = index + 1
    }
    false
}

fun bootstrapNamedTypeWordByte(byte: int): bool =
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
    byte == 95

fun bootstrapNamedTypeList(names: array<string>): string {
    var text = ""
    for (name in names) text = if (text == "") name else "$text,$name"
    text
}

/** Copies, named `name`, of the top-level functions named `function`. */
fun bootstrapNamedFunctionCopies(
    declarations: array<BootstrapDeclaration>,
    function: string,
    name: string
): array<BootstrapDeclaration> {
    val copies: array<BootstrapDeclaration> = []
    for (each in declarations) {
        if (each.name == function && each.extensionOwner == "" &&
            (each.kind == "fun" || each.kind == "compile.fun")) {
            copies.append(BootstrapDeclaration(
                each.kind, name, each.begin, each.end, each.expression,
                each.parameters, each.parameterTypes, each.resultType,
                each.methods, each.parameterDefaults, each.externalLibrary,
                each.parameterKinds, each.extensionOwner, each.isTrusted,
                each.isResource, each.isNoEscape, each.generatedNamespace,
                each.generatedOriginBegin, each.generatedOriginEnd,
                each.annotations, each.annotationArguments,
                each.annotationBegins, each.annotationEnds, each.sourceIdentity,
                each.conformances, each.isSealed, each.isPrivate,
                each.typeParameters
            ))
        }
    }
    copies
}

// The declarations a named member call may name: `methods[i]` indexes the
// methods of class `owners[i]`, or is -1 for the extension function `owners[i]`.
class BootstrapNamedMethodTargets(val owners: array<int>, val methods: array<int>)

// Whether two parsed expressions are the same syntax (positions aside).
fun bootstrapSameExpression(left: BootstrapExpression, right: BootstrapExpression): bool {
    if (left.kind != right.kind || left.text != right.text ||
        left.children.size != right.children.size) return false
    var child = 0
    while (child < left.children.size) {
        if (!bootstrapSameExpression(left.children[child], right.children[child])) return false
        child = child + 1
    }
    true
}

// `name` or `name.field…`: reading it again at the call has no effects.
fun bootstrapNamedArgumentPlace(expression: BootstrapExpression): bool =
    expression.kind == "identifier" ||
    (expression.kind == "member" && expression.children.size == 1 &&
     bootstrapNamedArgumentPlace(expression.children[0]))

fun bootstrapNamedBorrowPlace(expression: BootstrapExpression): bool =
    expression.kind == "identifier" ||
    (expression.kind == "member" && expression.children.size == 1 &&
     bootstrapNamedBorrowPlace(expression.children[0])) ||
    (expression.kind == "index" && expression.children.size == 2 &&
     bootstrapNamedBorrowPlace(expression.children[0]))

fun bootstrapNormalizeNamedDeclaration(
    var normalizer: BootstrapNamedArgumentNormalizer,
    declaration: BootstrapDeclaration
): BootstrapDeclaration {
    val enclosing = normalizer.receiver
    val enclosingNames: array<string> = []
    for (name in normalizer.callerNames) enclosingNames.append(name)
    val enclosingVisible: array<string> = []
    for (name in normalizer.visibleLocals) enclosingVisible.append(name)
    if (declaration.kind != "class") {
        var names: array<string> = []
        for (name in enclosingNames) names.append(name)
        for (name in declaration.parameters) names.append(name)
        bootstrapReceiverBoundNames(declaration.expression, names)
        normalizer.callerNames = names
    }
    if (declaration.kind == "class") normalizer.receiver = declaration.name
    else if (declaration.extensionOwner != "") normalizer.receiver = declaration.extensionOwner
    val defaults: array<BootstrapExpression> = []
    var defaultIndex = 0
    while (defaultIndex < declaration.parameterDefaults.size) {
        defaults.append(normalizer.normalize(
            declaration.parameterDefaults[defaultIndex]
        ))
        defaultIndex = defaultIndex + 1
    }
    val methods: array<BootstrapDeclaration> = []
    var method = 0
    while (method < declaration.methods.size) {
        methods.append(bootstrapNormalizeNamedDeclaration(
            normalizer, declaration.methods[method]
        ))
        method = method + 1
    }
    val enclosingBody = normalizer.inReceiverBody
    normalizer.inReceiverBody = normalizer.receiver != "" && declaration.kind != "class"
    if (declaration.kind != "class") {
        val visible: array<string> = []
        for (name in enclosingVisible) visible.append(name)
        for (name in declaration.parameters) visible.append(name)
        normalizer.visibleLocals = visible
    }
    val body = normalizer.normalize(declaration.expression)
    val restoredVisible: array<string> = []
    for (name in enclosingVisible) restoredVisible.append(name)
    normalizer.visibleLocals = restoredVisible
    normalizer.inReceiverBody = enclosingBody
    normalizer.receiver = enclosing
    val restoredNames: array<string> = []
    for (name in enclosingNames) restoredNames.append(name)
    normalizer.callerNames = restoredNames
    BootstrapDeclaration(
        declaration.kind,
        declaration.name,
        declaration.begin,
        declaration.end,
        body,
        declaration.parameters,
        declaration.parameterTypes,
        declaration.resultType,
        methods,
        defaults,
        declaration.externalLibrary,
        declaration.parameterKinds,
        declaration.extensionOwner,
        declaration.isTrusted,
        declaration.isResource,
        declaration.isNoEscape,
        declaration.generatedNamespace,
        declaration.generatedOriginBegin,
        declaration.generatedOriginEnd,
        declaration.annotations,
        declaration.annotationArguments,
        declaration.annotationBegins,
        declaration.annotationEnds,
        declaration.sourceIdentity,
        declaration.conformances,
        declaration.isSealed,
        declaration.isPrivate,
        declaration.typeParameters
    )
}

fun bootstrapDeclarationRequiresNamedNormalization(
    normalizer: BootstrapNamedArgumentNormalizer,
    declaration: BootstrapDeclaration
): bool {
    var required = normalizer.requiresNormalization(
        declaration.expression
    )
    var defaultIndex = 0
    while (!required &&
           defaultIndex < declaration.parameterDefaults.size) {
        required = normalizer.requiresNormalization(
            declaration.parameterDefaults[defaultIndex]
        )
        defaultIndex = defaultIndex + 1
    }
    var method = 0
    while (!required && method < declaration.methods.size) {
        required = bootstrapDeclarationRequiresNamedNormalization(
            normalizer, declaration.methods[method]
        )
        method = method + 1
    }
    required
}

fun bootstrapCommitEditOrder(edit: BootstrapDeclarationEdit): string =
    "${bootstrapEditTargetText(edit)}\u{1F}${edit.kind}\u{1F}${edit.origin}\u{1F}${edit.payload}"

/** Commits `edits` (made by compile-time code in a round of lowering, or by
 *  transforms) to the raw program `parsed`: the declarations as parsed,
 *  before any of the rewrites bootstrapPreSemanticPipeline makes, which the
 *  caller runs again over the whole result before it analyzes it again.
 *  Errors (a target that isn't one declaration, two bodies for one function)
 *  join the result's. */
fun bootstrapCommitEdits(
    parsed: BootstrapParseResult,
    edits: array<BootstrapDeclarationEdit>
): BootstrapParseResult {
    val declarations: array<BootstrapDeclaration> = []
    for (declaration in parsed.declarations) declarations.append(declaration)
    // In a fixed order (target, kind, origin), whatever order the sites ran in.
    val ordered: array<BootstrapDeclarationEdit> = []
    for (edit in edits) {
        val key = bootstrapCommitEditOrder(edit)
        var at = ordered.size
        while (at > 0 && bootstrapTextBefore(key, bootstrapCommitEditOrder(ordered[at - 1]))) {
            at = at - 1
        }
        ordered.append(edit)
        var move = ordered.size - 1
        while (move > at) {
            ordered[move] = ordered[move - 1]
            move = move - 1
        }
        ordered[at] = edit
    }
    val outcome = bootstrapApplyDeclarationEdits(declarations, ordered)
    // A new body may name arguments: normalized as the parse's were.
    bootstrapNormalizeNamedArguments(BootstrapParseResult(
        declarations,
        parsed.actions,
        parsed.errors + outcome.errors,
        parsed.extensionErrors + outcome.errors,
        parsed.compileInputPaths,
        parsed.compileInputContents,
        "${parsed.diagnostics}${outcome.diagnostics}",
        parsed.declarationEdits
    ))
}

fun bootstrapNormalizeNamedArguments(
    parsed: BootstrapParseResult
): BootstrapParseResult {
    var normalizer = BootstrapNamedArgumentNormalizer(
        parsed.declarations,
        bootstrapNamedTargetIndex(parsed.declarations),
        0,
        "", "", "", false, [], [], bootstrapBuildAffineTypeNames(parsed.declarations)
    )
    val declarations: array<BootstrapDeclaration> = []
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val candidate = parsed.declarations[declaration]
        if (bootstrapDeclarationRequiresNamedNormalization(
            normalizer, candidate
        )) {
            normalizer.sourceIdentity = candidate.sourceIdentity
            declarations.append(bootstrapNormalizeNamedDeclaration(
                normalizer, candidate
            ))
        } else declarations.append(candidate)
        declaration = declaration + 1
    }
    // (A copied function's body may name arguments, and ask for more accessors.)
    var accessor = 0
    while (accessor < normalizer.accessors.size) {
        val candidate = normalizer.accessors[accessor]
        normalizer.sourceIdentity = candidate.sourceIdentity
        declarations.append(
            if (bootstrapDeclarationRequiresNamedNormalization(normalizer, candidate))
                bootstrapNormalizeNamedDeclaration(normalizer, candidate)
            else candidate
        )
        accessor = accessor + 1
    }
    val actions: array<BootstrapExpression> = []
    var action = 0
    while (action < parsed.actions.size) {
        val candidate = parsed.actions[action]
        if (normalizer.requiresNormalization(candidate)) {
            actions.append(normalizer.normalize(candidate))
        } else actions.append(candidate)
        action = action + 1
    }
    bootstrapNoteNamedArgumentErrors(normalizer.errors)
    BootstrapParseResult(
        declarations,
        actions,
        parsed.errors + normalizer.errors,
        parsed.extensionErrors,
        parsed.compileInputPaths,
        parsed.compileInputContents,
        "${parsed.diagnostics}${normalizer.diagnostics}"
    )
}

/** A float literal as `value`, being passed for a parameter of `type`. */
/** A temporary has no declared type to give a literal: it takes its parameter's here. A generic
 *  parameter's `array<T>` isn't a type yet, so its literal stays as it is. */
fun bootstrapNamedTypedLiteral(value: BootstrapExpression, type: string,
    generic: bool): BootstrapExpression =
    if (type == "f32" && bootstrapIsFloatLiteralExpression(value)) bootstrapF32Literals(value)
    else if (generic) value
    else bootstrapExpectType(value, type)
