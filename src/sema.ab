import "ct_native_effects.ab"
import "module_paths.ab"
import "subparser.ab"
import "ct_lift.ab"
import "generator.ab"
import "ct_infer.ab"
import "ct_init.ab"
import "generic_types.ab"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "abla/sys/linux/fs"

fun bootstrapSemanticUnit(): void {}

class BootstrapStaticString(
    val text: string,
    val valid: bool
)

// Inline assembly requires compile-time text, but source authors should be
// able to split a long template or constraint list into adjacent constant
// additions for readability. This remains a compile-time value and introduces
// no runtime string work in the emitted program.
fun bootstrapStaticString(expression: BootstrapExpression): BootstrapStaticString {
    var result = BootstrapStaticString("", false)
    if (expression.kind == "string") {
        result = BootstrapStaticString(expression.text, true)
    } else if (expression.kind == "+" && expression.children.size == 2) {
        val left = bootstrapStaticString(expression.children[0])
        val right = bootstrapStaticString(expression.children[1])
        if (left.valid && right.valid) {
            result = BootstrapStaticString("${left.text}${right.text}", true)
        }
    }
    result
}

fun bootstrapPlaceRootName(expression: BootstrapExpression): string {
    var root = ""
    if (expression.kind == "identifier") root = expression.text
    if (expression.kind == "delegate.project" &&
        expression.children.size == 1) {
        root = bootstrapPlaceRootName(expression.children[0])
    }
    if ((expression.kind == "member" || expression.kind == "index") &&
        expression.children.size > 0) {
        root = bootstrapPlaceRootName(expression.children[0])
    }
    root
}

// The name a place key (`rows`, `h.items[0]`, `b.list`) starts with.
fun bootstrapOwnershipKeyRoot(key: string): string {
    var end = 0
    while (end < key.size && key[end] != 46 && key[end] != 91) end = end + 1
    key.slice(0, end)
}

fun bootstrapOwnershipPlaceKey(expression: BootstrapExpression): string {
    var key = ""
    var place = expression
    if (place.kind == "call" && place.text == "move" &&
        place.children.size == 1) place = place.children[0]
    if (place.kind == "delegate.project" &&
        place.children.size == 1) place = place.children[0]
    if (place.kind == "identifier") key = place.text
    if (place.kind == "member" && place.children.size > 0) {
        val owner = bootstrapOwnershipPlaceKey(place.children[0])
        if (owner != "") key = "$owner.${place.text}"
    }
    if (place.kind == "index" && place.children.size > 1) {
        val owner = bootstrapOwnershipPlaceKey(place.children[0])
        var index = "*"
        if (place.children[1].kind == "integer") {
            index = place.children[1].text
        }
        if (owner != "") key = "$owner[$index]"
    }
    key
}

fun bootstrapOwnershipPlaceKeyPrefix(left: string, right: string): bool {
    var prefix = left.size <= right.size
    var index = 0
    while (prefix && index < left.size) {
        if (left[index] != right[index]) prefix = false
        index = index + 1
    }
    if (prefix && left.size < right.size) {
        prefix = right[left.size] == 46 || right[left.size] == 91
    }
    prefix
}

fun bootstrapOwnershipWildcardPrefix(place: string): string {
    var result = ""
    var index = 0
    while (result == "" && index + 2 < place.size) {
        if (place[index] == 91 && place[index + 1] == 42 &&
            place[index + 2] == 93) result = place.slice(0, index + 1)
        index = index + 1
    }
    result
}

fun bootstrapOwnershipPlaceKeysConflict(
    left: string,
    right: string
): bool {
    var conflict = left != "" && right != "" &&
        (bootstrapOwnershipPlaceKeyPrefix(left, right) ||
         bootstrapOwnershipPlaceKeyPrefix(right, left))
    val leftWildcard = bootstrapOwnershipWildcardPrefix(left)
    val rightWildcard = bootstrapOwnershipWildcardPrefix(right)
    if (!conflict && leftWildcard != "") {
        conflict = bootstrapOwnershipPlaceKeyPrefix(leftWildcard, right)
    }
    if (!conflict && rightWildcard != "") {
        conflict = bootstrapOwnershipPlaceKeyPrefix(rightWildcard, left)
    }
    conflict
}

fun bootstrapCollectOwnershipPlace(
    expression: BootstrapExpression,
    var kinds: array<int>,
    var values: array<string>
): void {
    var place = expression
    if (place.kind == "call" && place.text == "move" &&
        place.children.size == 1) {
        place = place.children[0]
    }
    if (place.kind == "delegate.project" &&
        place.children.size == 1) place = place.children[0]
    if (place.kind == "identifier") {
        kinds.append(0)
        values.append(place.text)
    }
    if (place.kind == "member" && place.children.size > 0) {
        bootstrapCollectOwnershipPlace(place.children[0], kinds, values)
        kinds.append(1)
        values.append(place.text)
    }
    if (place.kind == "index" && place.children.size > 1) {
        bootstrapCollectOwnershipPlace(place.children[0], kinds, values)
        var index = "*"
        if (place.children[1].kind == "integer") {
            index = place.children[1].text
        }
        kinds.append(2)
        values.append(index)
    }
}

fun bootstrapOwnershipPlacesConflict(
    left: BootstrapExpression,
    right: BootstrapExpression
): bool {
    val leftKinds: array<int> = []
    val leftValues: array<string> = []
    val rightKinds: array<int> = []
    val rightValues: array<string> = []
    bootstrapCollectOwnershipPlace(left, leftKinds, leftValues)
    bootstrapCollectOwnershipPlace(right, rightKinds, rightValues)
    var conflict = leftValues.size > 0 && rightValues.size > 0 &&
        leftValues[0] == rightValues[0]
    var index = 1
    while (conflict && index < leftValues.size &&
           index < rightValues.size) {
        if (leftKinds[index] != rightKinds[index]) {
            index = leftValues.size + rightValues.size
            bootstrapSemanticUnit()
        } else if (leftKinds[index] == 1 &&
                   leftValues[index] != rightValues[index]) {
            conflict = false
            bootstrapSemanticUnit()
        } else if (leftKinds[index] == 2 &&
                   leftValues[index] != "*" &&
                   rightValues[index] != "*" &&
                   leftValues[index] != rightValues[index]) {
            conflict = false
            bootstrapSemanticUnit()
        }
        index = index + 1
    }
    conflict
}

// `this`, or a bare field name no parameter or local shadows here.
// `aliases` are loop variables over the receiver's arrays (`for (n in
// this.nodes)`): mutating through them mutates the receiver.
fun bootstrapReceiverPlaceRoot(
    expression: BootstrapExpression,
    fields: BootstrapSummaryFields,
    owner: string,
    shadowed: array<string>,
    aliases: array<string>
): bool {
    val root = bootstrapPlaceRootName(expression)
    root == "this" || (!bootstrapAffineNamesContain(shadowed, root) &&
        (bootstrapAffineNamesContain(aliases, root) ||
         fields.stored.contains("$owner\n$root")))
}

fun bootstrapNamesWith(names: array<string>, more: array<string>): array<string> {
    val result: array<string> = []
    for (name in names) result.append(name)
    for (name in more) result.append(name)
    result
}

// The fields of every declaration by `owner\nfield`: the normalized type of
// the field (the last declaration and field of the name decide) and whether a
// declaration of that name has it as a `val`/`var` field. The receiver-mutation
// summary asks for every member of every body, every pass.
class BootstrapSummaryFields(
    val typed: BootstrapStringSet,
    val types: array<string>,
    val stored: BootstrapStringSet
)

fun bootstrapSummaryFields(
    declarations: array<BootstrapDeclaration>
): BootstrapSummaryFields {
    val typed = bootstrapStringSet()
    val types: array<string> = []
    val stored = bootstrapStringSet()
    for (candidate in declarations) {
        var index = 0
        while (index < candidate.parameters.size) {
            val key = "${candidate.name}\n${candidate.parameters[index]}"
            if (index < candidate.parameterTypes.size) {
                val known = typed.keys.size
                typed.add(key)
                if (typed.keys.size > known) types.append("")
                types[typed.indexOf(key)] = bootstrapNormalizeType(
                    candidate.parameterTypes[index]
                )
            }
            if (index < candidate.parameterKinds.size &&
                (candidate.parameterKinds[index] == "val" ||
                 candidate.parameterKinds[index] == "var")) stored.add(key)
            index = index + 1
        }
    }
    BootstrapSummaryFields(typed, types, stored)
}

fun bootstrapSummaryFieldType(
    fields: BootstrapSummaryFields,
    owner: string,
    field: string
): string {
    val key = fields.typed.indexOf("$owner\n$field")
    if (key >= 0) fields.types[key] else "unknown"
}

fun bootstrapSummaryReceiverType(
    expression: BootstrapExpression,
    fields: BootstrapSummaryFields,
    owner: string
): string {
    var result = "unknown"
    if (expression.kind == "identifier" && expression.text == "this") {
        result = owner
    }
    if (expression.kind == "member" && expression.children.size > 0) {
        val receiver = bootstrapSummaryReceiverType(
            expression.children[0],
            fields,
            owner
        )
        if (receiver != "unknown") {
            result = bootstrapSummaryFieldType(
                fields,
                receiver,
                expression.text
            )
        }
    }
    bootstrapBorrowElementType(result)
}

// The owner and method pairs whose receiver may be mutated, in the order they were
// found. `keys` holds their bootstrapMethodDeclarationKey and `slots` an open-addressed
// table of them that grows in place, so a membership question needs no scan.
// ABLA_RECEIVER_INDEX_CHECK=1 checks each answer against one.
class BootstrapMutableReceiverSummary(
    val owners: array<string>,
    val methods: array<string>,
    val keys: array<string>,
    val slots: array<int>,
    val check: bool
)

/** The slot of `key` in `summary`'s table, or the empty one where it would go. */
fun bootstrapMutableReceiverSlot(
    summary: BootstrapMutableReceiverSummary,
    key: string
): int {
    var slot = bootstrapFunctionDeclarationHash(key)
    slot = slot - slot / summary.slots.size * summary.slots.size
    while (summary.slots[slot] >= 0 && summary.keys[summary.slots[slot]] != key) {
        slot = slot + 1
        if (slot == summary.slots.size) slot = 0
    }
    slot
}

fun bootstrapMutableReceiverAdd(
    var summary: BootstrapMutableReceiverSummary,
    owner: string,
    method: string
): void {
    summary.owners.append(owner)
    summary.methods.append(method)
    if ((summary.keys.size + 1) * 2 >= summary.slots.size) {
        val capacity = summary.slots.size * 2
        while (summary.slots.size < capacity) summary.slots.append(-1)
        var slot = 0
        while (slot < summary.slots.size) {
            summary.slots[slot] = -1
            slot = slot + 1
        }
        var entry = 0
        while (entry < summary.keys.size) {
            summary.slots[
                bootstrapMutableReceiverSlot(summary, summary.keys[entry])
            ] = entry
            entry = entry + 1
        }
    }
    val key = bootstrapMethodDeclarationKey(owner, method)
    val slot = bootstrapMutableReceiverSlot(summary, key)
    if (summary.slots[slot] < 0) {
        summary.slots[slot] = summary.keys.size
        summary.keys.append(key)
    }
    return
}

fun bootstrapMutableReceiverContains(
    summary: BootstrapMutableReceiverSummary,
    owner: string,
    method: string
): bool {
    val found = summary.slots[bootstrapMutableReceiverSlot(
        summary, bootstrapMethodDeclarationKey(owner, method)
    )] >= 0
    if (summary.check) {
        var scanned = false
        var index = 0
        while (!scanned && index < summary.owners.size) {
            if (summary.owners[index] == owner &&
                summary.methods[index] == method) scanned = true
            index = index + 1
        }
        if (scanned != found) {
            linuxPrintStandardError(
                "error[E_INTERNAL]: receiver.index-check: `$owner`.`$method` is $found, a scan finds $scanned\n"
            )
        }
    }
    found
}

fun bootstrapMutableReceiverContainsMethod(
    summary: BootstrapMutableReceiverSummary,
    method: string
): bool {
    var found = false
    var index = 0
    while (!found && index < summary.methods.size) {
        if (summary.methods[index] == method) found = true
        index = index + 1
    }
    found
}

fun bootstrapFunctionArgumentIsExclusive(
    declarations: array<BootstrapDeclaration>,
    name: string,
    argument: int
): bool {
    var exclusive = false
    var declaration = 0
    while (!exclusive && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner == "" && candidate.name == name &&
            argument < candidate.parameterKinds.size &&
            (candidate.parameterKinds[argument] == "var" ||
             candidate.parameterKinds[argument] == "own")) {
            exclusive = true
        }
        declaration = declaration + 1
    }
    exclusive
}

fun bootstrapMethodArgumentIsExclusive(
    declarations: array<BootstrapDeclaration>,
    name: string,
    argument: int
): bool {
    var exclusive = false
    var declaration = 0
    while (!exclusive && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner != "" && candidate.name == name &&
            argument < candidate.parameterKinds.size &&
            (candidate.parameterKinds[argument] == "var" ||
             candidate.parameterKinds[argument] == "own")) {
            exclusive = true
        }
        var method = 0
        while (!exclusive && method < candidate.methods.size) {
            val found = candidate.methods[method]
            if (found.name == name && argument < found.parameterKinds.size &&
                (found.parameterKinds[argument] == "var" ||
                 found.parameterKinds[argument] == "own")) {
                exclusive = true
            }
            method = method + 1
        }
        declaration = declaration + 1
    }
    exclusive
}

// Which argument positions of each function / method name take `var` or `own`
// (a bitmask per name; positions past 61 fall back to the scans above).
class BootstrapExclusiveArguments(
    val functionNames: array<string>,
    val functionMasks: array<int>,
    val functionSlots: array<int>,
    val methodNames: array<string>,
    val methodMasks: array<int>,
    val methodSlots: array<int>
)

fun bootstrapExclusiveMask(kinds: array<string>): int {
    var mask = 0
    var argument = 0
    while (argument < kinds.size && argument < 62) {
        if (kinds[argument] == "var" || kinds[argument] == "own") {
            mask = mask | (1 << argument)
        }
        argument = argument + 1
    }
    mask
}

fun bootstrapExclusiveSlot(names: array<string>, slots: array<int>, name: string): int {
    var slot = bootstrapFunctionDeclarationHash(name)
    slot = slot - slot / slots.size * slots.size
    var probes = 0
    while (probes < slots.size && slots[slot] >= 0 &&
           names[slots[slot]] != name) {
        slot = slot + 1
        if (slot == slots.size) slot = 0
        probes = probes + 1
    }
    slot
}

fun bootstrapExclusiveAdd(var names: array<string>, var masks: array<int>, var slots: array<int>, name: string, mask: int): void {
    val slot = bootstrapExclusiveSlot(names, slots, name)
    if (slots[slot] >= 0) {
        masks[slots[slot]] = masks[slots[slot]] | mask
    } else {
        slots[slot] = names.size
        names.append(name)
        masks.append(mask)
    }
    return
}

fun bootstrapExclusiveArgumentsOf(
    declarations: array<BootstrapDeclaration>
): BootstrapExclusiveArguments {
    var capacity = 8
    while (capacity < declarations.size * 4 + 1) capacity = capacity * 2
    var functionNames: array<string> = []
    var functionMasks: array<int> = []
    var functionSlots: array<int> = []
    var methodNames: array<string> = []
    var methodMasks: array<int> = []
    var methodSlots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        functionSlots.append(-1)
        methodSlots.append(-1)
        slot = slot + 1
    }
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        // A class's `var` parameters are mutable fields, not arguments it
        // borrows mutably: constructing `V(this.x)` leaves `this` alone.
        val mask = if (candidate.kind == "class") 0
            else bootstrapExclusiveMask(candidate.parameterKinds)
        if (candidate.extensionOwner == "") {
            bootstrapExclusiveAdd(functionNames, functionMasks, functionSlots, candidate.name, mask)
        } else {
            bootstrapExclusiveAdd(methodNames, methodMasks, methodSlots, candidate.name, mask)
        }
        var method = 0
        while (method < candidate.methods.size) {
            val found = candidate.methods[method]
            bootstrapExclusiveAdd(methodNames, methodMasks, methodSlots, found.name,
                bootstrapExclusiveMask(found.parameterKinds))
            method = method + 1
        }
        declaration = declaration + 1
    }
    BootstrapExclusiveArguments(functionNames, functionMasks, functionSlots, methodNames, methodMasks, methodSlots)
}

fun bootstrapFunctionArgumentIsExclusiveIn(
    exclusive: BootstrapExclusiveArguments,
    declarations: array<BootstrapDeclaration>,
    name: string,
    argument: int
): bool {
    if (argument >= 62) return bootstrapFunctionArgumentIsExclusive(declarations, name, argument)
    val slot = bootstrapExclusiveSlot(exclusive.functionNames, exclusive.functionSlots, name)
    val entry = exclusive.functionSlots[slot]
    entry >= 0 && ((exclusive.functionMasks[entry] >> argument) & 1) != 0
}

fun bootstrapMethodArgumentIsExclusiveIn(
    exclusive: BootstrapExclusiveArguments,
    declarations: array<BootstrapDeclaration>,
    name: string,
    argument: int
): bool {
    if (argument >= 62) return bootstrapMethodArgumentIsExclusive(declarations, name, argument)
    val slot = bootstrapExclusiveSlot(exclusive.methodNames, exclusive.methodSlots, name)
    val entry = exclusive.methodSlots[slot]
    entry >= 0 && ((exclusive.methodMasks[entry] >> argument) & 1) != 0
}

fun bootstrapExpressionMayMutateReceiver(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    owner: string,
    summary: BootstrapMutableReceiverSummary,
    exclusive: BootstrapExclusiveArguments,
    fields: BootstrapSummaryFields,
    // The names in scope that shadow a field, and those aliasing the
    // receiver's array: each node adds its own and takes them out again.
    var shadowed: array<string>,
    var aliases: array<string>
): bool {
    var mutates = expression.kind == "assign" &&
        !bootstrapAffineNamesContain(shadowed, expression.text) &&
        fields.stored.contains("$owner\n${expression.text}")
    if (!mutates && expression.kind == "member.assign" &&
        expression.children.size > 0) {
        mutates = bootstrapReceiverPlaceRoot(
            expression.children[0],
            fields,
            owner,
            shadowed,
            aliases
        )
    }
    if (!mutates && expression.kind == "index.assign" &&
        expression.children.size > 0) {
        mutates = bootstrapReceiverPlaceRoot(
            expression.children[0],
            fields,
            owner,
            shadowed,
            aliases
        )
    }
    if (!mutates && expression.kind == "member.call" &&
        expression.children.size > 0) {
        val receiverType = bootstrapSummaryReceiverType(
            expression.children[0],
            fields,
            owner
        )
        if ((expression.text == "append" || expression.text == "truncate" ||
             expression.text == "clear" ||
             (bootstrapIsMapType(receiverType) &&
              (expression.text == "set" || expression.text == "remove")) ||
             bootstrapMutableReceiverContains(
                summary,
                receiverType,
                expression.text
             )) &&
            bootstrapReceiverPlaceRoot(
                expression.children[0],
                fields,
                owner,
                shadowed,
                aliases
            )) mutates = true
        var argument = 1
        while (!mutates && argument < expression.children.size) {
            if (bootstrapMethodArgumentIsExclusiveIn(
                    exclusive,
                    declarations,
                    expression.text,
                    argument - 1
                ) && bootstrapReceiverPlaceRoot(
                    expression.children[argument],
                    fields,
                    owner,
                    shadowed,
                    aliases
                )) mutates = true
            argument = argument + 1
        }
    }
    if (!mutates && expression.kind == "call") {
        var argument = 0
        while (!mutates && argument < expression.children.size) {
            if (bootstrapFunctionArgumentIsExclusiveIn(
                    exclusive,
                    declarations,
                    expression.text,
                    argument
                ) && bootstrapReceiverPlaceRoot(
                    expression.children[argument],
                    fields,
                    owner,
                    shadowed,
                    aliases
                )) mutates = true
            argument = argument + 1
        }
    }
    // A parameter or local named like a field shadows it from its
    // declaration on: `val keys = []; keys.append(k)` leaves `this` alone.
    // A loop over the receiver's array aliases it; any other loop variable
    // shadows a field of its name.
    val aliasing = expression.kind == "for" && expression.children.size > 1 &&
        bootstrapReceiverPlaceRoot(
            expression.children[0], fields, owner, shadowed, aliases
        )
    val mark = shadowed.size
    var child = 0
    val lambda = expression.kind == "lambda" ||
        expression.kind == "lambda.move" ||
        expression.kind == "lambda.generator"
    if (lambda) {
        while (child + 1 < expression.children.size) {
            shadowed.append(expression.children[child].text)
            child = child + 1
        }
    }
    while (!mutates && child < expression.children.size) {
        val found = expression.children[child]
        val body = expression.kind == "for" && child == 1
        val bodyMark = shadowed.size
        val aliasMark = aliases.size
        if (body && !aliasing) shadowed.append(expression.text)
        if (body && aliasing) aliases.append(expression.text)
        mutates = bootstrapExpressionMayMutateReceiver(
            found,
            declarations,
            owner,
            summary,
            exclusive,
            fields,
            shadowed,
            aliases
        )
        shadowed.truncate(bodyMark)
        aliases.truncate(aliasMark)
        if (expression.kind == "block" &&
            (found.kind == "local.val" || found.kind == "local.var")) {
            shadowed.append(found.text)
        }
        child = child + 1
    }
    shadowed.truncate(mark)
    mutates
}

fun bootstrapBuildMutableReceiverSummary(
    declarations: array<BootstrapDeclaration>,
    affineTypes: array<string>
): BootstrapMutableReceiverSummary {
    val check = linuxEnvironment("ABLA_RECEIVER_INDEX_CHECK")
    val summary = BootstrapMutableReceiverSummary(
        [], [], [], [-1, -1, -1, -1, -1, -1, -1, -1],
        check.found && check.value == "1"
    )
    // Asked for every declaration on every pass: index the class/interface names
    // and the exclusive argument positions once.
    val managedTypes = bootstrapManagedTypeIndex(declarations)
    val exclusive = bootstrapExclusiveArgumentsOf(declarations)
    val fields = bootstrapSummaryFields(declarations)
    // A body is walked again only once a method it calls joins the summary
    // (BootstrapBodySchedule).
    val declarationOf: array<int> = []
    val methodOf: array<int> = []
    val callers = bootstrapCallersOf(declarations, declarationOf, methodOf)
    var schedule = bootstrapBodySchedule(declarationOf.size)
    var round = true
    while (round) {
        var body = schedule.take()
        while (body >= 0) {
            val candidate = declarations[declarationOf[body]]
            val method = methodOf[body]
            if (method < 0) {
                val extensionOwner = bootstrapNormalizeType(
                    candidate.extensionOwner
                )
                if (extensionOwner != "" &&
                    (bootstrapSummaryTypeIsAffine(extensionOwner, affineTypes) ||
                     bootstrapSummaryTypeIsManagedReferenceIn(
                        extensionOwner,
                        managedTypes,
                        0
                     )) &&
                    !bootstrapMutableReceiverContains(
                        summary,
                        extensionOwner,
                        candidate.name
                    ) && bootstrapExpressionMayMutateReceiver(
                        candidate.expression,
                        declarations,
                        extensionOwner,
                        summary,
                        exclusive,
                        fields,
                        bootstrapNamesWith(candidate.parameters, []),
                        []
                    )) {
                    bootstrapMutableReceiverAdd(summary, extensionOwner, candidate.name)
                    callers.touch(candidate.name, schedule)
                }
            } else if (bootstrapSummaryTypeIsAffine(candidate.name, affineTypes) ||
                bootstrapSummaryTypeIsManagedReferenceIn(
                    candidate.name,
                    managedTypes,
                    0
                )) {
                val found = candidate.methods[method]
                if (!bootstrapMutableReceiverContains(
                        summary,
                        candidate.name,
                        found.name
                    ) && bootstrapExpressionMayMutateReceiver(
                        found.expression,
                        declarations,
                        candidate.name,
                        summary,
                        exclusive,
                        fields,
                        bootstrapNamesWith(found.parameters, []),
                        []
                    )) {
                    bootstrapMutableReceiverAdd(summary, candidate.name, found.name)
                    callers.touch(found.name, schedule)
                }
            }
            body = schedule.take()
        }
        round = schedule.nextRound()
    }
    summary
}

fun bootstrapIsArrayType(type: string): bool =
    type.size >= 6 && type.slice(0, 6) == "array:"

fun bootstrapArrayElementType(type: string): string {
    if (bootstrapIsArrayType(type)) type.slice(6, type.size)
    else "unknown"
}

fun bootstrapIsGeneratorType(type: string): bool =
    type.size >= 10 && type.slice(0, 10) == "generator:"

fun bootstrapGeneratorElementType(type: string): string {
    if (bootstrapIsGeneratorType(type)) type.slice(10, type.size)
    else "unknown"
}

fun bootstrapIsTaskType(type: string): bool =
    type.size >= 5 && type.slice(0, 5) == "task:"

fun bootstrapTaskResultType(type: string): string {
    if (bootstrapIsTaskType(type)) type.slice(5, type.size)
    else "unknown"
}

fun bootstrapIsThreadType(type: string): bool =
    type.size >= 7 && type.slice(0, 7) == "thread:"

fun bootstrapThreadResultType(type: string): string {
    if (bootstrapIsThreadType(type)) type.slice(7, type.size)
    else "unknown"
}

fun bootstrapFunctionClose(type: string, begin: int): int {
    var close = -1
    var depth = 0
    var index = begin
    while (close < 0 && index < type.size) {
        if (type[index] == 40) depth = depth + 1
        if (type[index] == 41) {
            depth = depth - 1
            if (depth == 0) close = index
        }
        index = index + 1
    }
    close
}

fun bootstrapNormalizeFunctionType(type: string): string {
    val close = bootstrapFunctionClose(type, 0)
    var parameters = ""
    var resultBegin = close + 1
    while (resultBegin < type.size && type[resultBegin] == 32) {
        resultBegin = resultBegin + 1
    }
    var arrow = resultBegin + 1 < type.size && type[resultBegin] == 45 &&
        type[resultBegin + 1] == 62
    if (arrow) {
        resultBegin = resultBegin + 2
        while (resultBegin < type.size && type[resultBegin] == 32) {
            resultBegin = resultBegin + 1
        }
    }
    if (close > 0 && arrow && resultBegin < type.size) {
        var parameterBegin = 1
        var index = 1
        var angles = 0
        var parentheses = 0
        while (index <= close) {
            val separator = index == close ||
                (type[index] == 44 && angles == 0 && parentheses == 0)
            if (separator) {
                if (parameterBegin < index) {
                    if (parameters != "") parameters = "$parameters,"
                    parameters = "$parameters${bootstrapNormalizeType(
                        type.slice(parameterBegin, index)
                    )}"
                }
                parameterBegin = index + 1
                parameters = parameters
            } else {
                if (type[index] == 60) angles = angles + 1
                if (type[index] == 62) angles = angles - 1
                if (type[index] == 40) parentheses = parentheses + 1
                if (type[index] == 41) parentheses = parentheses - 1
                parameters = parameters
            }
            index = index + 1
        }
        val rawResult = type.slice(resultBegin, type.size)
        var result = bootstrapNormalizeType(rawResult)
        if (bootstrapIsBorrowResultContract(rawResult)) {
            val source = bootstrapBorrowResultSource(rawResult)
            val sourceIndex = bootstrapDecimalIndex(source)
            if (sourceIndex >= 0) {
                result = bootstrapIndexedBorrowType(
                    sourceIndex,
                    bootstrapBorrowResultElementType(rawResult)
                )
            }
        }
        "function:($parameters)->$result"
    } else "unknown"
}

fun bootstrapStartsBorrowResultContract(type: string): bool =
    type.size >= 7 && type[0] == 98 && type[1] == 111 &&
    type[2] == 114 && type[3] == 114 && type[4] == 111 &&
    type[5] == 119 && type[6] == 40

fun bootstrapIsBorrowResultContract(type: string): bool =
    bootstrapStartsBorrowResultContract(type) &&
    bootstrapFunctionClose(type, 6) > 6

fun bootstrapBorrowResultSource(type: string): string {
    var result = ""
    if (bootstrapStartsBorrowResultContract(type)) {
        val close = bootstrapFunctionClose(type, 6)
        if (close > 6) result = type.slice(7, close)
    }
    result
}

fun bootstrapBorrowResultElementType(type: string): string {
    var result = "unknown"
    if (bootstrapStartsBorrowResultContract(type)) {
        val close = bootstrapFunctionClose(type, 6)
        if (close > 6 && close + 1 < type.size) {
            result = bootstrapNormalizeType(type.slice(close + 1, type.size))
        }
    }
    result
}

fun bootstrapDecimalIndex(text: string): int {
    var result = -1
    var valid = text.size > 0
    var value = 0
    var index = 0
    while (valid && index < text.size) {
        val digit = text[index] - 48
        if (digit < 0 || digit > 9) {
            valid = false
            valid = valid
        } else {
            value = value * 10 + digit
            valid = valid
        }
        index = index + 1
    }
    if (valid) result = value
    result
}

fun bootstrapIndexedBorrowType(source: int, element: string): string =
    "borrow@$source:$element"

fun bootstrapIsIndexedBorrowType(type: string): bool =
    type.size >= 9 && type[0] == 98 && type[1] == 111 &&
    type[2] == 114 && type[3] == 114 && type[4] == 111 &&
    type[5] == 119 && type[6] == 64

fun bootstrapIndexedBorrowSeparator(type: string): int {
    var separator = -1
    var index = 7
    while (separator < 0 && index < type.size) {
        if (type[index] == 58) separator = index
        index = index + 1
    }
    separator
}

fun bootstrapIndexedBorrowSource(type: string): int {
    var source = -1
    if (bootstrapIsIndexedBorrowType(type)) {
        val separator = bootstrapIndexedBorrowSeparator(type)
        if (separator > 7) {
            source = bootstrapDecimalIndex(type.slice(7, separator))
        }
    }
    source
}

fun bootstrapIndexedBorrowElementType(type: string): string {
    var element = "unknown"
    if (bootstrapIsIndexedBorrowType(type)) {
        val separator = bootstrapIndexedBorrowSeparator(type)
        if (separator >= 0 && separator + 1 < type.size) {
            element = type.slice(separator + 1, type.size)
        }
    }
    element
}

fun bootstrapBorrowSourceMatchesContract(
    source: string,
    contract: string
): bool {
    var matches = source == contract
    if (!matches && contract != "" && source.size > contract.size) {
        val separator = source[contract.size]
        if ((separator == 46 || separator == 91) &&
            source.slice(0, contract.size) == contract) matches = true
    }
    matches
}

/** What `declaration` makes bootstrapBorrowCallResultSource's `source` (a later match wins). */
fun bootstrapBorrowCallResultSourceAt(
    declaration: BootstrapDeclaration,
    owner: string,
    name: string,
    source: string
): string {
    var result = source
    if (owner == "" && declaration.extensionOwner == "" &&
        declaration.name == name && (declaration.kind == "fun" ||
        declaration.kind == "compile.fun")) {
        result = bootstrapBorrowResultSource(declaration.resultType)
    }
    if (owner != "" && declaration.name == name &&
        bootstrapNormalizeType(declaration.extensionOwner) == owner) {
        result = bootstrapBorrowResultSource(declaration.resultType)
    }
    if (owner != "" && declaration.name == owner) {
        var method = 0
        while (method < declaration.methods.size) {
            if (declaration.methods[method].name == name) {
                result = bootstrapBorrowResultSource(
                    declaration.methods[method].resultType
                )
            }
            method = method + 1
        }
    }
    result
}

fun bootstrapBorrowCallResultSource(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    name: string
): string {
    var source = ""
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        source = bootstrapBorrowCallResultSourceAt(
            declarations[declarationIndex], owner, name, source
        )
        declarationIndex = declarationIndex + 1
    }
    source
}

/** The index of `parameters`' last entry equal to `source`, else `result`. */
fun bootstrapBorrowParameterMatch(
    parameters: array<string>,
    source: string,
    result: int
): int {
    var found = result
    var parameter = 0
    while (parameter < parameters.size) {
        if (parameters[parameter] == source) found = parameter
        parameter = parameter + 1
    }
    found
}

/** What `declaration` makes bootstrapBorrowCallResultParameter's `result` (a later match wins). */
fun bootstrapBorrowCallResultParameterAt(
    declaration: BootstrapDeclaration,
    owner: string,
    name: string,
    source: string,
    result: int
): int {
    var found = result
    if (owner == "" && declaration.extensionOwner == "" &&
        declaration.name == name && (declaration.kind == "fun" ||
        declaration.kind == "compile.fun")) {
        found = bootstrapBorrowParameterMatch(
            declaration.parameters, source, found
        )
    }
    if (owner != "" && declaration.name == name &&
        bootstrapNormalizeType(declaration.extensionOwner) == owner) {
        found = bootstrapBorrowParameterMatch(
            declaration.parameters, source, found
        )
    }
    if (owner != "" && declaration.name == owner) {
        var method = 0
        while (method < declaration.methods.size) {
            val candidate = declaration.methods[method]
            if (candidate.name == name) {
                found = bootstrapBorrowParameterMatch(
                    candidate.parameters, source, found
                )
            }
            method = method + 1
        }
    }
    found
}

fun bootstrapBorrowCallResultParameter(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    name: string,
    source: string
): int {
    var result = -1
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        result = bootstrapBorrowCallResultParameterAt(
            declarations[declarationIndex], owner, name, source, result
        )
        declarationIndex = declarationIndex + 1
    }
    result
}

// A declaration matters to a call's borrow result only when it is named like
// the call or like its owner, so the indexed lookups visit just those two
// lists of `names`, merged in declaration order: the scans' order, so a later
// match still wins.
class BootstrapBorrowCandidates(
    val names: BootstrapDeclarationNameIndex,
    var nameNode: int,
    var ownerNode: int
) {
    /** The next candidate's declaration index, or -1. */
    fun next(): int {
        var node = this.nameNode
        if (node < 0 || (this.ownerNode >= 0 &&
            this.names.nodeDeclarations[this.ownerNode] <
                this.names.nodeDeclarations[node])) {
            node = this.ownerNode
            if (node >= 0) this.ownerNode = this.names.nodeNexts[node]
        } else this.nameNode = this.names.nodeNexts[node]
        if (node >= 0) this.names.nodeDeclarations[node] else -1
    }
}

fun bootstrapBorrowCandidates(
    names: BootstrapDeclarationNameIndex,
    owner: string,
    name: string
): BootstrapBorrowCandidates = BootstrapBorrowCandidates(
    names,
    names.first(name),
    if (owner != "" && owner != name) names.first(owner) else -1
)

/** bootstrapBorrowCallResultSource through `names`, the index of `declarations`. */
fun bootstrapBorrowCallResultSourceIndexed(
    declarations: array<BootstrapDeclaration>,
    names: BootstrapDeclarationNameIndex,
    owner: string,
    name: string
): string {
    var source = ""
    val candidates = bootstrapBorrowCandidates(names, owner, name)
    var declaration = candidates.next()
    while (declaration >= 0) {
        source = bootstrapBorrowCallResultSourceAt(
            declarations[declaration], owner, name, source
        )
        declaration = candidates.next()
    }
    source
}

/** bootstrapBorrowCallResultParameter through `names`, the index of `declarations`. */
fun bootstrapBorrowCallResultParameterIndexed(
    declarations: array<BootstrapDeclaration>,
    names: BootstrapDeclarationNameIndex,
    owner: string,
    name: string,
    source: string
): int {
    var result = -1
    val candidates = bootstrapBorrowCandidates(names, owner, name)
    var declaration = candidates.next()
    while (declaration >= 0) {
        result = bootstrapBorrowCallResultParameterAt(
            declarations[declaration], owner, name, source, result
        )
        declaration = candidates.next()
    }
    result
}

fun bootstrapNormalizeTypeSlow(type: string): string {
    var result = type
    var trimBegin = 0
    var trimEnd = type.size
    while (trimBegin < trimEnd && type[trimBegin] == 32) {
        trimBegin = trimBegin + 1
    }
    while (trimEnd > trimBegin && type[trimEnd - 1] == 32) {
        trimEnd = trimEnd - 1
    }
    if (trimBegin > 0 || trimEnd < type.size) {
        result = bootstrapNormalizeType(type.slice(trimBegin, trimEnd))
    } else {
    if (type == "int") result = "i64"
    if (type.size > 12 && type.slice(0, 11) == "FnNoEscape(") {
        result = "noescape:${bootstrapNormalizeFunctionType(
            type.slice(10, type.size)
        )}"
    }
    if (type.size > 9 && type[0] == 70 && type[1] == 110 &&
        type[2] == 79 && type[3] == 110 && type[4] == 99 &&
        type[5] == 101 && type[6] == 40) {
        result = "once:${bootstrapNormalizeFunctionType(
            type.slice(6, type.size)
        )}"
    }
    if (type.size > 8 && type[0] == 70 && type[1] == 110 &&
        type[2] == 77 && type[3] == 117 && type[4] == 116 &&
        type[5] == 40) {
        result = "mut:${bootstrapNormalizeFunctionType(
            type.slice(5, type.size)
        )}"
    }
    if (type.size > 5 && type[0] == 70 && type[1] == 110 &&
        type[2] == 40) {
        result = bootstrapNormalizeFunctionType(type.slice(2, type.size))
    }
    if (type.size > 3 && type[0] == 40) {
        result = bootstrapNormalizeFunctionType(type)
    }
    if (type.size > 1 && type.slice(type.size - 1, type.size) == "?") {
        result = "nullable:${bootstrapNormalizeType(type.slice(0, type.size - 1))}"
    }
    if (type.size >= 7 && type.slice(0, 6) == "array<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(6, type.size - 1))
        result = "array:$element"
    }
    if (type.size >= 9 && type.slice(0, 7) == "Shared<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(7, type.size - 1))
        result = "shared:$element"
    }
    if (type.size >= 7 && type.slice(0, 5) == "Weak<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(5, type.size - 1))
        result = "weak:$element"
    }
    if (type.size >= 8 && type[0] == 77 && type[1] == 117 &&
        type[2] == 116 && type[3] == 101 && type[4] == 120 &&
        type[5] == 60 && type[type.size - 1] == 62) {
        val element = bootstrapNormalizeType(type.slice(6, type.size - 1))
        result = "mutex:$element"
    }
    if (type.size >= 7 && type.slice(0, 5) == "Cell<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(5, type.size - 1))
        result = "cell:$element"
    }
    if (type.size >= 8 && type.slice(0, 4) == "Map<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val comma = bootstrapTypeArgumentComma(type, 4, type.size - 1)
        if (comma > 4) {
            val key = bootstrapNormalizeType(type.slice(4, comma))
            val value = bootstrapNormalizeType(
                type.slice(comma + 1, type.size - 1)
            )
            result = "map:$key:$value"
        }
    }
    if (type.size >= 12 && type.slice(0, 10) == "Generator<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(10, type.size - 1))
        result = "generator:$element"
    }
    if (type.size >= 7 && type.slice(0, 5) == "Task<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(5, type.size - 1))
        result = "task:$element"
    }
    if (type.size >= 9 && type.slice(0, 7) == "Thread<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(7, type.size - 1))
        result = "thread:$element"
    }
    if (type.size >= 9 && type[0] == 66 && type[1] == 111 &&
        type[2] == 114 && type[3] == 114 && type[4] == 111 &&
        type[5] == 119 && type[6] == 60 &&
        type[type.size - 1] == 62) {
        val element = bootstrapNormalizeType(type.slice(7, type.size - 1))
        result = "borrow:$element"
    }
    if (bootstrapIsBorrowResultContract(type)) {
        result = "borrow:${bootstrapBorrowResultElementType(type)}"
    }
    }
    result
}

fun ablaCompilerTypeNeedsNormalization(type: string): bool {
    if (type.size == 0) return false
    val first = type[0]
    val last = type[type.size - 1]
    if (first == 32 || last == 32 || last == 63 || first == 70 || first == 40) return true
    // Each other spelling to normalize starts with its own letter: a type
    // starting with none of them (most class names) is answered by it.
    if (first == 105) return type == "int"
    if (first == 97) return bootstrapTypeHasPrefix(type, "array<")
    if (first == 83) return bootstrapTypeHasPrefix(type, "Shared<")
    if (first == 87) return bootstrapTypeHasPrefix(type, "Weak<")
    if (first == 77) {
        return bootstrapTypeHasPrefix(type, "Mutex<") || bootstrapTypeHasPrefix(type, "Map<")
    }
    if (first == 67) return bootstrapTypeHasPrefix(type, "Cell<")
    if (first == 71) return bootstrapTypeHasPrefix(type, "Generator<")
    if (first == 84) {
        return bootstrapTypeHasPrefix(type, "Task<") || bootstrapTypeHasPrefix(type, "Thread<")
    }
    if (first == 66) return bootstrapTypeHasPrefix(type, "Borrow<")
    if (first == 98) return bootstrapTypeHasPrefix(type, "borrow(")
    false
}

/** Whether `type` starts with `prefix`, compared in place (no slice made). */
fun bootstrapTypeHasPrefix(type: string, prefix: string): bool {
    if (type.size < prefix.size) return false
    var index = 0
    while (index < prefix.size) {
        if (type[index] != prefix[index]) return false
        index = index + 1
    }
    true
}

fun bootstrapNormalizeType(type: string): string =
    if (ablaCompilerTypeNeedsNormalization(type))
        bootstrapNormalizeTypeSlow(type)
    else type

// Delegated bindings store the delegate type while ordinary lookup exposes a
// different type. Length-prefixing keeps nested array/function type syntax
// unambiguous without introducing a runtime wrapper.
fun bootstrapDelegatedType(
    mutable: bool,
    storageType: string,
    exposedType: string
): string = "delegate@${if (mutable) 1 else 0}@${storageType.size}:$storageType$exposedType"

fun bootstrapIsDelegatedType(type: string): bool =
    type.size > 12 && type.slice(0, 9) == "delegate@" &&
    (type[9] == 48 || type[9] == 49) && type[10] == 64

fun bootstrapDelegatedTypeSeparator(type: string): int {
    var separator = -1
    var index = 11
    while (separator < 0 && index < type.size) {
        if (type[index] == 58) separator = index
        index = index + 1
    }
    separator
}

fun bootstrapDelegatedStorageType(type: string): string {
    var result = "unknown"
    if (bootstrapIsDelegatedType(type)) {
        val separator = bootstrapDelegatedTypeSeparator(type)
        if (separator > 11) {
            val length = bootstrapDecimalIndex(type.slice(11, separator))
            val begin = separator + 1
            if (length >= 0 && begin + length <= type.size) {
                result = type.slice(begin, begin + length)
            }
        }
    }
    result
}

fun bootstrapDelegatedExposedType(type: string): string {
    var result = "unknown"
    if (bootstrapIsDelegatedType(type)) {
        val separator = bootstrapDelegatedTypeSeparator(type)
        if (separator > 11) {
            val length = bootstrapDecimalIndex(type.slice(11, separator))
            val begin = separator + 1
            if (length >= 0 && begin + length <= type.size) {
                result = type.slice(begin + length, type.size)
            }
        }
    }
    result
}

fun bootstrapDelegatedIsMutable(type: string): bool =
    bootstrapIsDelegatedType(type) && type[9] == 49

fun bootstrapDelegatedStorageOrSelf(type: string): string =
    if (bootstrapIsDelegatedType(type)) bootstrapDelegatedStorageType(type)
    else type

// Whether the class `declaration`'s parameter `index` is a delegated property
// (`var balance: int by TVar(0)`): its default is the `by` initializer.
fun bootstrapIsDelegatedProperty(declaration: BootstrapDeclaration, index: int): bool =
    declaration.kind == "class" && index < declaration.parameterDefaults.size &&
        declaration.parameterDefaults[index].kind == "delegate.initializer"

// After the rewrite (delegated_properties.ab), a delegated property's default
// is "delegate.field": its `by` expression and its type (what it reads as),
// kept for reflection. Its field is then an ordinary one.
fun bootstrapIsRewrittenDelegatedProperty(declaration: BootstrapDeclaration, index: int): bool =
    declaration.kind == "class" && index < declaration.parameterDefaults.size &&
        declaration.parameterDefaults[index].kind == "delegate.field"

fun bootstrapIsAnyDelegatedProperty(declaration: BootstrapDeclaration, index: int): bool =
    bootstrapIsDelegatedProperty(declaration, index) ||
        bootstrapIsRewrittenDelegatedProperty(declaration, index)

/** A delegated property's type (what it reads as), before or after the
 *  rewrite; "inferred" before it when it isn't written. */
fun bootstrapDelegatedPropertyType(declaration: BootstrapDeclaration, index: int): string {
    val initializer = declaration.parameterDefaults[index]
    if (initializer.children.size < 2) return "unknown"
    val type = initializer.children[1].text
    if (type == "inferred") type else bootstrapNormalizeType(type)
}

fun bootstrapHasAnyDelegatedProperty(declaration: BootstrapDeclaration): bool {
    if (declaration.kind != "class") return false
    for (fallback in declaration.parameterDefaults) {
        if (fallback.kind == "delegate.initializer" || fallback.kind == "delegate.field") return true
    }
    false
}

fun bootstrapHasDelegatedProperty(declaration: BootstrapDeclaration): bool {
    if (declaration.kind != "class") return false
    for (fallback in declaration.parameterDefaults) {
        if (fallback.kind == "delegate.initializer") return true
    }
    false
}

/** A delegated property access the probe found (delegated_properties.ab), by
 *  node: `action` says what plain code it becomes ("read", "assign",
 *  "project", "replace"; "self." first for a bare name in a method). */
class BootstrapDelegatedRewrite(
    val sourceIdentity: string,
    val begin: int,
    val end: int,
    val kind: string,
    val text: string,
    val action: string,
    // An assignment's: the property's type, which the assigned value takes.
    val type: string
)

/** Whether the normalized `type` names `word` (`unknown`, `inferred`). */
fun bootstrapTypeMentions(type: string, word: string): bool {
    var index = 0
    while (index + word.size <= type.size) {
        if (type.slice(index, index + word.size) == word) return true
        index = index + 1
    }
    false
}

fun bootstrapIsNullableType(type: string): bool =
    type.size >= 9 && type.slice(0, 9) == "nullable:"

fun bootstrapNullableElementType(type: string): string {
    if (bootstrapIsNullableType(type)) type.slice(9, type.size)
    else "unknown"
}

fun bootstrapNullableRefinementName(
    expression: BootstrapExpression
): string {
    var result = ""
    if ((expression.kind == "==" || expression.kind == "!=") &&
        expression.children.size == 2) {
        val left = expression.children[0]
        val right = expression.children[1]
        if (left.kind == "identifier" && right.kind == "null") {
            result = left.text
        }
        if (right.kind == "identifier" && left.kind == "null") {
            result = right.text
        }
    }
    result
}

fun bootstrapNullableRefinementNonNullWhenTrue(
    expression: BootstrapExpression
): bool = expression.kind == "!="

/** The first arm (its match's index in `when`'s children) after the arm
 *  matching `null`, from which the arms see the subject (a name) not null;
 *  -1 when there is none. Matches sharing the `null` arm's body share its
 *  type. */
fun bootstrapWhenNotNullFrom(expression: BootstrapExpression): int {
    if (expression.children.size == 0 ||
        expression.children[0].kind != "identifier") return -1
    var branch = 1
    while (branch + 1 < expression.children.size) {
        if (expression.children[branch].kind == "null") {
            while (bootstrapWhenSharesBody(expression, branch)) branch = branch + 2
            return branch + 2
        }
        branch = branch + 2
    }
    -1
}

/** `subject != null` for a `when`'s subject, which its arms after the
 *  `null` arm are refined by. */
fun bootstrapWhenNotNullCondition(expression: BootstrapExpression): BootstrapExpression {
    val subject = expression.children[0]
    BootstrapExpression("!=", "", subject.begin, subject.end, [
        subject,
        BootstrapExpression("null", "", subject.begin, subject.end, [])
    ])
}

fun bootstrapRegionResultIsIndependent(type: string): bool {
    val normalized = bootstrapNormalizeType(type)
    normalized == "void" || normalized == "never" || normalized == "null" ||
    normalized == "bool" || normalized == "char" ||
    normalized == "i8" || normalized == "i16" ||
    normalized == "i32" || normalized == "i64" ||
    normalized == "u8" || normalized == "u16" ||
    normalized == "u32" || normalized == "u64" ||
    normalized == "f32" || normalized == "f64"
}

fun bootstrapIsSharedType(type: string): bool =
    type.size >= 7 && type.slice(0, 7) == "shared:"

fun bootstrapSharedElementType(type: string): string {
    if (bootstrapIsSharedType(type)) type.slice(7, type.size)
    else "unknown"
}

fun bootstrapIsWeakType(type: string): bool =
    type.size >= 5 && type.slice(0, 5) == "weak:"

fun bootstrapWeakElementType(type: string): string {
    if (bootstrapIsWeakType(type)) type.slice(5, type.size)
    else "unknown"
}

fun bootstrapIsMutexType(type: string): bool =
    type.size >= 6 && type[0] == 109 && type[1] == 117 &&
    type[2] == 116 && type[3] == 101 && type[4] == 120 &&
    type[5] == 58

fun bootstrapMutexElementType(type: string): string {
    if (bootstrapIsMutexType(type)) type.slice(6, type.size)
    else "unknown"
}

fun bootstrapIsCellType(type: string): bool =
    type.size >= 5 && type.slice(0, 5) == "cell:"

// ---- Runtime-valued classes ----
// A class annotated `@__abla_runtime_value("<make> <method>:<function> …")`
// (abla/stm's TVar; the annotation is the standard library's alone) has the
// runtime's own values for instances: `TVar(1)` is `<make>(1)`, and each
// listed method, declared without a body, is a call of its runtime function
// with the instance first (ir.ab). Everything else about it is a class's.
fun bootstrapRuntimeValueSpec(declaration: BootstrapDeclaration): string {
    var index = 0
    while (index < declaration.annotations.size) {
        if (declaration.annotations[index] == "__abla_runtime_value" &&
            index < declaration.annotationArguments.size &&
            declaration.annotationArguments[index].kind == "string") {
            return declaration.annotationArguments[index].text
        }
        index = index + 1
    }
    ""
}

/** The runtime function that makes an instance (the spec's first word). */
fun bootstrapRuntimeValueConstructor(spec: string): string {
    var end = 0
    while (end < spec.size && spec[end] != 32) end = end + 1
    spec.slice(0, end)
}

/** The runtime function the spec names for `method`, else "". */
fun bootstrapRuntimeValueMethod(spec: string, method: string): string {
    var begin = 0
    while (begin < spec.size) {
        var end = begin
        while (end < spec.size && spec[end] != 32) end = end + 1
        val word = spec.slice(begin, end)
        if (word.size > method.size + 1 && word.slice(0, method.size) == method &&
            word[method.size] == 58) return word.slice(method.size + 1, word.size)
        begin = end + 1
    }
    ""
}
// ---- end of runtime-valued classes ----

// Map<K, V> is `map:K:V`; K is string or i64 (or unknown for an untyped
// `Map()`), so the colon after it always ends the key.
fun bootstrapIsMapType(type: string): bool =
    type.size >= 4 && type.slice(0, 4) == "map:"

fun bootstrapMapKeyEnd(type: string): int {
    var index = 4
    while (index < type.size && type[index] != 58) index = index + 1
    index
}

fun bootstrapMapKeyType(type: string): string =
    if (bootstrapIsMapType(type)) type.slice(4, bootstrapMapKeyEnd(type))
    else "unknown"

fun bootstrapMapValueType(type: string): string {
    val end = bootstrapMapKeyEnd(type)
    if (bootstrapIsMapType(type) && end < type.size) {
        type.slice(end + 1, type.size)
    } else "unknown"
}

// The comma between a two-argument type's arguments in type[begin, end), or
// -1: the first one outside nested <> and ().
fun bootstrapTypeArgumentComma(type: string, begin: int, end: int): int {
    var depth = 0
    var found = -1
    var index = begin
    while (index < end && found < 0) {
        val byte = type[index]
        if (byte == 60 || byte == 40) depth = depth + 1
        if (byte == 62 || byte == 41) depth = depth - 1
        if (byte == 44 && depth == 0) found = index
        index = index + 1
    }
    found
}

fun bootstrapCellElementType(type: string): string {
    if (bootstrapIsCellType(type)) type.slice(5, type.size)
    else "unknown"
}

fun bootstrapCellElementIsCopy(type: string): bool {
    val normalized = bootstrapNormalizeType(type)
    bootstrapRegionResultIsIndependent(normalized) &&
        normalized != "void" && normalized != "never" &&
        normalized != "null"
}

fun bootstrapIsBorrowType(type: string): bool =
    type.size >= 7 && type.slice(0, 7) == "borrow:"

/** Whether one of `expression`'s children from `first` on is an invalid
 *  node, which only stands where an error was already reported. */
fun bootstrapHasInvalidChild(expression: BootstrapExpression, first: int): bool {
    var index = first
    while (index < expression.children.size) {
        if (expression.children[index].kind == "invalid") return true
        index = index + 1
    }
    false
}

fun bootstrapBorrowElementType(type: string): string {
    if (bootstrapIsBorrowType(type)) type.slice(7, type.size)
    else type
}

fun bootstrapIsOnceFunctionType(type: string): bool =
    type.size >= 14 && type[0] == 111 && type[1] == 110 &&
    type[2] == 99 && type[3] == 101 && type[4] == 58 &&
    type[5] == 102 && type[6] == 117 && type[7] == 110 &&
    type[8] == 99 && type[9] == 116 && type[10] == 105 &&
    type[11] == 111 && type[12] == 110 && type[13] == 58

fun bootstrapIsMutableFunctionType(type: string): bool =
    type.size >= 13 && type[0] == 109 && type[1] == 117 &&
    type[2] == 116 && type[3] == 58 && type[4] == 102 &&
    type[5] == 117 && type[6] == 110 && type[7] == 99 &&
    type[8] == 116 && type[9] == 105 && type[10] == 111 &&
    type[11] == 110 && type[12] == 58

fun bootstrapIsNoEscapeFunctionType(type: string): bool =
    type.size >= 18 && type.slice(0, 18) == "noescape:function:"

fun bootstrapFunctionCoreType(type: string): string {
    if (bootstrapIsNoEscapeFunctionType(type)) type.slice(9, type.size)
    else if (bootstrapIsOnceFunctionType(type)) type.slice(5, type.size)
    else if (bootstrapIsMutableFunctionType(type)) type.slice(4, type.size)
    else type
}

fun bootstrapIsFunctionType(type: string): bool {
    val core = bootstrapFunctionCoreType(type)
    core.size >= 9 && core.slice(0, 9) == "function:"
}

fun bootstrapFunctionRawResultType(type: string): string {
    val core = bootstrapFunctionCoreType(type)
    var result = "unknown"
    if (bootstrapIsFunctionType(core)) {
        if (core.size > 9 && core[9] == 40) {
            val close = bootstrapFunctionClose(core, 9)
            if (close >= 0 && close + 3 <= core.size) {
                result = core.slice(close + 3, core.size)
            } else result = result
        } else result = core.slice(9, core.size)
    }
    result
}

fun bootstrapFunctionResultType(type: string): string {
    val raw = bootstrapFunctionRawResultType(type)
    if (bootstrapIsIndexedBorrowType(raw)) {
        "borrow:${bootstrapIndexedBorrowElementType(raw)}"
    } else raw
}

fun bootstrapFunctionBorrowResultParameter(type: string): int =
    bootstrapIndexedBorrowSource(bootstrapFunctionRawResultType(type))

fun bootstrapFunctionParameterCount(type: string): int {
    val core = bootstrapFunctionCoreType(type)
    var count = -1
    if (bootstrapIsFunctionType(core) && core.size > 10 && core[9] == 40) {
        val close = bootstrapFunctionClose(core, 9)
        count = 0
        if (close > 10) {
            count = 1
            var index = 10
            var angles = 0
            var parentheses = 0
            while (index < close) {
                if (core[index] == 60) angles = angles + 1
                if (core[index] == 62) angles = angles - 1
                if (core[index] == 40) parentheses = parentheses + 1
                if (core[index] == 41) parentheses = parentheses - 1
                if (core[index] == 44 && angles == 0 && parentheses == 0) {
                    count = count + 1
                }
                index = index + 1
            }
        }
    }
    count
}

fun bootstrapFunctionParameterType(type: string, parameter: int): string {
    val core = bootstrapFunctionCoreType(type)
    var result = "unknown"
    if (bootstrapIsFunctionType(core) && core.size > 10 && core[9] == 40) {
        val close = bootstrapFunctionClose(core, 9)
        var current = 0
        var begin = 10
        var index = 10
        var angles = 0
        var parentheses = 0
        while (index <= close) {
            val separator = index == close ||
                (core[index] == 44 && angles == 0 && parentheses == 0)
            if (separator) {
                if (current == parameter && begin < index) {
                    result = core.slice(begin, index)
                    if (result.size > 4 &&
                        (result.slice(0, 4) == "own:" ||
                         result.slice(0, 4) == "var:")) {
                        result = result.slice(4, result.size)
                    }
                }
                current = current + 1
                begin = index + 1
                result = result
            } else {
                if (core[index] == 60) angles = angles + 1
                if (core[index] == 62) angles = angles - 1
                if (core[index] == 40) parentheses = parentheses + 1
                if (core[index] == 41) parentheses = parentheses - 1
                result = result
            }
            index = index + 1
        }
    }
    result
}

fun bootstrapFunctionParameterKind(type: string, parameter: int): string {
    val core = bootstrapFunctionCoreType(type)
    var result = "parameter"
    if (bootstrapIsFunctionType(core) && core.size > 10 && core[9] == 40) {
        val close = bootstrapFunctionClose(core, 9)
        var current = 0
        var begin = 10
        var index = 10
        var angles = 0
        var parentheses = 0
        while (index <= close) {
            val separator = index == close ||
                (core[index] == 44 && angles == 0 && parentheses == 0)
            if (separator) {
                if (current == parameter && begin + 4 < index &&
                    core.slice(begin, begin + 4) == "own:") {
                    result = "own"
                }
                if (current == parameter && begin + 4 < index &&
                    core.slice(begin, begin + 4) == "var:") {
                    result = "var"
                }
                current = current + 1
                begin = index + 1
                bootstrapSemanticUnit()
            } else {
                if (core[index] == 60) angles = angles + 1
                if (core[index] == 62) angles = angles - 1
                if (core[index] == 40) parentheses = parentheses + 1
                if (core[index] == 41) parentheses = parentheses - 1
                bootstrapSemanticUnit()
            }
            index = index + 1
        }
    }
    result
}

fun bootstrapDeclarationFunctionType(
    declaration: BootstrapDeclaration
): string {
    var parameters = ""
    var index = 0
    while (index < declaration.parameterTypes.size) {
        if (index > 0) parameters = "$parameters,"
        if (index < declaration.parameterKinds.size &&
            declaration.parameterKinds[index] == "own") {
            parameters = "${parameters}own:"
        }
        if (index < declaration.parameterKinds.size &&
            declaration.parameterKinds[index] == "var") {
            parameters = "${parameters}var:"
        }
        parameters = "$parameters${bootstrapNormalizeType(
            declaration.parameterTypes[index]
        )}"
        index = index + 1
    }
    var result = bootstrapNormalizeType(declaration.resultType)
    val source = bootstrapBorrowResultSource(declaration.resultType)
    var sourceParameter = -1
    index = 0
    while (index < declaration.parameters.size) {
        if (declaration.parameters[index] == source) sourceParameter = index
        index = index + 1
    }
    if (sourceParameter >= 0) {
        result = bootstrapIndexedBorrowType(
            sourceParameter,
            bootstrapBorrowResultElementType(declaration.resultType)
        )
    }
    "${if (declaration.isNoEscape)
        "noescape:" else ""}function:($parameters)->$result"
}

fun bootstrapExpressionFunctionReferenceName(
    expression: BootstrapExpression
): string {
    var result = ""
    if (expression.kind == "identifier") result = expression.text
    if (expression.kind == "block" && expression.children.size > 0) {
        result = bootstrapExpressionFunctionReferenceName(
            expression.children[expression.children.size - 1]
        )
    }
    if (expression.kind == "if" && expression.children.size > 2 &&
        expression.children[2].kind != "missing") {
        val thenName = bootstrapExpressionFunctionReferenceName(
            expression.children[1]
        )
        val elseName = bootstrapExpressionFunctionReferenceName(
            expression.children[2]
        )
        if (thenName != "" && thenName == elseName) result = thenName
    }
    result
}

fun bootstrapDeclarationIsValue(kind: string): bool =
    kind == "val" || kind == "var" ||
    kind == "compile.val" || kind == "compile.var"

fun bootstrapScalarTypeUnderlying(
    declarations: array<BootstrapDeclaration>,
    name: string
): string {
    // Only a plain identifier can name a scalar type declaration: builtin and
    // compound types (array:…, function:…, nullable) skip the scan.
    if (!bootstrapCouldNameScalarType(name)) return ""
    var result = ""
    var index = 0
    while (index < declarations.size) {
        val declaration = declarations[index]
        if (declaration.kind == "type" && declaration.name == name) {
            result = bootstrapNormalizeType(declaration.resultType)
        }
        index = index + 1
    }
    result
}

/** bootstrapScalarTypeUnderlying through `scalarTypes`, the index of `declarations`' `type` declarations. */
fun bootstrapScalarTypeUnderlyingIndexed(
    declarations: array<BootstrapDeclaration>,
    scalarTypes: BootstrapFunctionDeclarationIndex,
    name: string
): string {
    if (!bootstrapCouldNameScalarType(name)) return ""
    val declaration = scalarTypes.find(name)
    if (declaration < 0) "" else bootstrapNormalizeType(declarations[declaration].resultType)
}

fun bootstrapCouldNameScalarType(name: string): bool {
    if (name.size == 0 || bootstrapScalarTypeUnderlyingValid(name)) return false
    if (name == "int" || name == "string" || name == "void" || name == "unknown" || name == "float") return false
    var index = 0
    while (index < name.size) {
        val c = name[index]
        val letter = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 46 || c == 36
        val digit = c >= 48 && c <= 57
        if (!letter && !(digit && index > 0)) return false
        index = index + 1
    }
    true
}

fun bootstrapScalarTypeUnderlyingValid(type: string): bool =
    type == "bool" || type == "char" ||
    type == "i8" || type == "u8" ||
    type == "i16" || type == "u16" ||
    type == "i32" || type == "u32" ||
    type == "i64" || type == "u64" ||
    type == "f32" || type == "f64"

fun bootstrapIsIntegerScalarType(type: string): bool {
    val normalized = bootstrapNormalizeType(type)
    normalized == "char" || normalized == "i8" || normalized == "u8" ||
    normalized == "i16" || normalized == "u16" ||
    normalized == "i32" || normalized == "u32" ||
    normalized == "i64" || normalized == "u64"
}

fun bootstrapIsNumericScalarType(type: string): bool =
    bootstrapIsIntegerScalarType(type) ||
    bootstrapNormalizeType(type) == "f32" ||
    bootstrapNormalizeType(type) == "f64"

fun bootstrapScalarConversionCompatible(
    target: string,
    source: string
): bool = (bootstrapIsIntegerScalarType(target) &&
    bootstrapIsIntegerScalarType(source)) ||
    bootstrapNormalizeType(target) == bootstrapNormalizeType(source)

fun bootstrapGlobalFunctionType(
    declarations: array<BootstrapDeclaration>,
    name: string
): string {
    var result = "unknown"
    var current = name
    var round = 0
    while (result == "unknown" && current != "" &&
           round <= declarations.size) {
        var next = ""
        var index = 0
        while (index < declarations.size) {
            val declaration = declarations[index]
            if (declaration.name == current &&
                declaration.extensionOwner == "" &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun")) {
                result = bootstrapDeclarationFunctionType(declaration)
            }
            if (bootstrapDeclarationIsValue(declaration.kind) &&
                declaration.name == current) {
                next = bootstrapExpressionFunctionReferenceName(
                    declaration.expression
                )
            }
            index = index + 1
        }
        current = next
        round = round + 1
    }
    result
}

/** Whether a class's method implements an interface member: the same
 *  parameter types and modes, and the same result unless the method's is
 *  left to inference. */
fun bootstrapConformanceSignatureMatches(
    member: BootstrapDeclaration,
    method: BootstrapDeclaration
): bool {
    if (member.parameterTypes.size != method.parameterTypes.size) return false
    var index = 0
    while (index < member.parameterTypes.size) {
        if (bootstrapNormalizeType(member.parameterTypes[index]) !=
            bootstrapNormalizeType(method.parameterTypes[index])) return false
        val memberKind = if (index < member.parameterKinds.size)
            member.parameterKinds[index] else "parameter"
        val methodKind = if (index < method.parameterKinds.size)
            method.parameterKinds[index] else "parameter"
        if (memberKind != methodKind) return false
        index = index + 1
    }
    method.resultType == "inferred" ||
        bootstrapNormalizeType(member.resultType) ==
            bootstrapNormalizeType(method.resultType)
}

fun bootstrapTypesCompatible(expected: string, actual: string): bool {
    var compatible = expected == actual || expected == "unknown" ||
        actual == "unknown" || actual == "never" || expected == "any"
    if (bootstrapIsBorrowType(actual) &&
        expected == bootstrapBorrowElementType(actual)) compatible = true
    // An immutable-repeatable callable can safely satisfy a mutable-repeatable
    // callback slot: it supports every call that FnMut permits, while simply
    // declining to mutate its captures.
    if (bootstrapIsMutableFunctionType(expected) &&
        bootstrapIsFunctionType(actual) &&
        !bootstrapIsMutableFunctionType(actual) &&
        !bootstrapIsOnceFunctionType(actual) &&
        bootstrapFunctionCoreType(expected) ==
            bootstrapFunctionCoreType(actual)) compatible = true
    if (!bootstrapIsNoEscapeFunctionType(expected) &&
        bootstrapIsNoEscapeFunctionType(actual) &&
        bootstrapFunctionCoreType(expected) ==
            bootstrapFunctionCoreType(actual)) compatible = true
    // A string passed to a cstring native parameter is adapted at the ABI
    // boundary. The reverse conversion is never implicit because ownership of
    // a returned native pointer is unknown.
    if (expected == "cstring" && actual == "string") compatible = true
    if (expected == "i64" &&
        (actual == "i8" || actual == "u8" || actual == "char" ||
         actual == "i16" || actual == "u16" ||
         actual == "i32" || actual == "u32" || actual == "u64")) {
        compatible = true
    }
    if ((expected == "i8" || expected == "u8" || expected == "char" ||
         expected == "i16" || expected == "u16" ||
         expected == "i32" || expected == "u32") && actual == "i64") {
        compatible = true
    }
    if (bootstrapIsArrayType(expected) && bootstrapIsArrayType(actual)) {
        val expectedElement = bootstrapArrayElementType(expected)
        val actualElement = bootstrapArrayElementType(actual)
        if (expectedElement == "unknown" || actualElement == "unknown") {
            compatible = true
        }
    }
    // `Map()` is a map of nothing yet: it takes the declared map type.
    if (bootstrapIsMapType(expected) && actual == "map:unknown:unknown") {
        compatible = true
    }
    if (bootstrapIsNullableType(expected)) {
        val element = bootstrapNullableElementType(expected)
        if (actual == "null" || actual == element) compatible = true
        if (bootstrapIsNullableType(actual) &&
            bootstrapNullableElementType(actual) == element) compatible = true
    }
    compatible
}

/** An int (i64) argument for a narrower integer parameter, which would keep
 *  only its low bits: it must be converted explicitly (`u8(value)`). An
 *  integer literal that fits the parameter's type needs no conversion. */
fun bootstrapImplicitIntegerNarrowing(
    expected: string,
    actual: string,
    argument: BootstrapExpression
): bool {
    if (actual != "i64") return false
    var minimum = 0
    var maximum = 0
    if (expected == "i8") {
        minimum = -128
        maximum = 127
    } else if (expected == "u8" || expected == "char") maximum = 255
    else if (expected == "i16") {
        minimum = -32768
        maximum = 32767
    } else if (expected == "u16") maximum = 65535
    else if (expected == "i32") {
        minimum = -2147483648
        maximum = 2147483647
    } else if (expected == "u32") maximum = 4294967295
    else return false
    !bootstrapIntegerLiteralFits(argument, minimum, maximum)
}

/** Whether `expression` is an integer literal in [minimum, maximum], or an
 *  `if` whose results all are. */
fun bootstrapIntegerLiteralFits(
    expression: BootstrapExpression,
    minimum: int,
    maximum: int
): bool {
    if (expression.kind == "block" && expression.children.size == 1) {
        return bootstrapIntegerLiteralFits(expression.children[0], minimum, maximum)
    }
    if (expression.kind == "if" && expression.children.size == 3) {
        return bootstrapIntegerLiteralFits(expression.children[1], minimum, maximum) &&
            bootstrapIntegerLiteralFits(expression.children[2], minimum, maximum)
    }
    var literal = expression
    val negative = literal.kind == "unary-" && literal.children.size == 1
    if (negative) literal = literal.children[0]
    if (literal.kind != "integer" || literal.text.size == 0 ||
        literal.text[0] == 45 || literal.text.size > 10) return false
    var value = 0
    for (byte in literal.text) value = value * 10 + byte - 48
    if (negative) value = 0 - value
    value >= minimum && value <= maximum
}

fun bootstrapTypesCompatibleWithInferredNoEscape(
    expected: string,
    actual: string,
    expression: BootstrapExpression,
    regionCalls: BootstrapRegionCallSummary,
    declarations: array<BootstrapDeclaration>
): bool {
    var compatible = bootstrapTypesCompatible(expected, actual)
    if (!compatible) {
        val scalarUnderlying = bootstrapScalarTypeUnderlying(
            declarations, actual
        )
        if (scalarUnderlying != "") {
            compatible = bootstrapTypesCompatible(expected, scalarUnderlying)
        }
    }
    if (!compatible && bootstrapIsNoEscapeFunctionType(expected) &&
        bootstrapIsFunctionType(actual) &&
        bootstrapFunctionCoreType(expected) ==
            bootstrapFunctionCoreType(actual)) {
        val reference = bootstrapExpressionFunctionReferenceName(expression)
        if (reference != "" && bootstrapGlobalFunctionCanInferNoEscape(
            reference, declarations, regionCalls
        )) compatible = true
        if (!compatible && expression.kind == "lambda" &&
            expression.children.size > 0) {
            val parameterNames: array<string> = []
            val parameterTypes: array<string> = []
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                val found = expression.children[parameter]
                parameterNames.append(found.text)
                var parameterType = "unknown"
                if (found.children.size > 0) {
                    parameterType = bootstrapNormalizeType(
                        found.children[0].text
                    )
                }
                parameterTypes.append(parameterType)
                parameter = parameter + 1
            }
            compatible = bootstrapLambdaInferredNoEscape(
                expression,
                parameterNames,
                parameterTypes,
                declarations,
                regionCalls
            )
        }
    }
    compatible
}

fun bootstrapCopyRegionCallSummary(
    source: BootstrapRegionCallSummary
): BootstrapRegionCallSummary {
    val unsafeNames: array<string> = []
    val retainingReceiverNames: array<string> = []
    val retainingParameterKeys: array<string> = []
    var index = 0
    while (index < source.unsafeNames.size) {
        unsafeNames.append(source.unsafeNames[index])
        index = index + 1
    }
    index = 0
    while (index < source.retainingReceiverNames.size) {
        retainingReceiverNames.append(source.retainingReceiverNames[index])
        index = index + 1
    }
    index = 0
    while (index < source.retainingParameterKeys.size) {
        retainingParameterKeys.append(source.retainingParameterKeys[index])
        index = index + 1
    }
    BootstrapRegionCallSummary(
        unsafeNames, retainingReceiverNames, retainingParameterKeys,
        bootstrapStringSetCopy(source.unsafe),
        bootstrapStringSetCopy(source.unsafeMembers),
        bootstrapStringSetCopy(source.retainingReceivers),
        bootstrapStringSetCopy(source.retainingParameters),
        bootstrapStringSetCopy(source.heapFields)
    )
}

fun bootstrapCollectExpressionLocalNames(
    expression: BootstrapExpression,
    var localNames: array<string>
): void {
    if ((expression.kind == "local.val" ||
         expression.kind == "local.var") &&
        !bootstrapAffineNamesContain(localNames, expression.text)) {
        localNames.append(expression.text)
    }
    // A nested closure has its own locals. Its captures and calls are already
    // handled conservatively by the region-call analysis.
    if (expression.kind != "lambda") {
        var child = 0
        while (child < expression.children.size) {
            bootstrapCollectExpressionLocalNames(
                expression.children[child], localNames
            )
            child = child + 1
        }
    }
}

fun bootstrapCollectParameterAliases(
    expression: BootstrapExpression,
    localNames: array<string>,
    var aliases: array<string>
): void {
    if ((expression.kind == "local.val" ||
         expression.kind == "local.var") &&
        expression.children.size > 0 &&
        (expression.children[0].kind == "identifier" ||
         expression.children[0].kind == "member" ||
         expression.children[0].kind == "index") &&
        bootstrapAffineNamesContain(
            aliases,
            bootstrapPlaceRootName(expression.children[0])
        ) && !bootstrapAffineNamesContain(aliases, expression.text)) {
        aliases.append(expression.text)
    }
    if (expression.kind == "assign" &&
        bootstrapAffineNamesContain(localNames, expression.text) &&
        expression.children.size > 0 &&
        (expression.children[0].kind == "identifier" ||
         expression.children[0].kind == "member" ||
         expression.children[0].kind == "index") &&
        bootstrapAffineNamesContain(
            aliases,
            bootstrapPlaceRootName(expression.children[0])
        ) && !bootstrapAffineNamesContain(aliases, expression.text)) {
        aliases.append(expression.text)
    }
    if (expression.kind != "lambda") {
        var child = 0
        while (child < expression.children.size) {
            bootstrapCollectParameterAliases(
                expression.children[child], localNames, aliases
            )
            child = child + 1
        }
    }
}

fun bootstrapLambdaParameterStoredOutside(
    expression: BootstrapExpression,
    parameters: array<string>,
    localNames: array<string>
): bool {
    var stored = false
    if (expression.kind == "assign" &&
        !bootstrapAffineNamesContain(localNames, expression.text) &&
        expression.children.size > 0 &&
        bootstrapRegionParameterIndex(
            parameters,
            bootstrapPlaceRootName(expression.children[0])
        ) >= 0) stored = true
    if ((expression.kind == "member.assign" ||
         expression.kind == "index.assign") &&
        expression.children.size > 1) {
        val valueIndex = expression.children.size - 1
        if (bootstrapRegionParameterIndex(
            parameters,
            bootstrapPlaceRootName(expression.children[valueIndex])
        ) >= 0) stored = true
    }
    if (expression.kind == "member.call" &&
        (expression.text == "append" || expression.text == "set") &&
        expression.children.size > 1 &&
        !bootstrapAffineNamesContain(
            localNames,
            bootstrapPlaceRootName(expression.children[0])
        )) {
        var argument = 1
        while (!stored && argument < expression.children.size) {
            if (bootstrapRegionParameterIndex(
                parameters,
                bootstrapPlaceRootName(expression.children[argument])
            ) >= 0) stored = true
            argument = argument + 1
        }
    }
    var child = 0
    while (!stored && child < expression.children.size) {
        stored = bootstrapLambdaParameterStoredOutside(
            expression.children[child], parameters, localNames
        )
        child = child + 1
    }
    stored
}

fun bootstrapExpressionParameterStoredOutside(
    expression: BootstrapExpression,
    parameters: array<string>
): bool {
    val localNames: array<string> = []
    bootstrapCollectExpressionLocalNames(expression, localNames)
    val aliases: array<string> = []
    var parameter = 0
    while (parameter < parameters.size) {
        aliases.append(parameters[parameter])
        parameter = parameter + 1
    }
    // Alias discovery is monotonic. Repeating at most once per local handles
    // declarations and assignments encountered before their source alias.
    var round = 0
    while (round <= localNames.size) {
        bootstrapCollectParameterAliases(expression, localNames, aliases)
        round = round + 1
    }
    bootstrapLambdaParameterStoredOutside(
        expression, aliases, localNames
    )
}

fun bootstrapGlobalFunctionCanInferNoEscape(
    name: string,
    declarations: array<BootstrapDeclaration>,
    regionCalls: BootstrapRegionCallSummary
): bool {
    var inferred = false
    var index = 0
    while (index < declarations.size) {
        val declaration = declarations[index]
        if (declaration.name == name &&
            declaration.extensionOwner == "" &&
            (declaration.kind == "fun" ||
             declaration.kind == "compile.fun")) {
            inferred = !bootstrapRegionCallIsUnsafe(regionCalls, name) &&
                !bootstrapRegionFunctionRetainsAnyParameter(
                    regionCalls, name, declaration.parameters.size
                )
        }
        index = index + 1
    }
    inferred
}

fun bootstrapLambdaInferredNoEscape(
    expression: BootstrapExpression,
    parameters: array<string>,
    parameterTypes: array<string>,
    declarations: array<BootstrapDeclaration>,
    regionCalls: BootstrapRegionCallSummary
): bool {
    var inferred = expression.kind == "lambda" &&
        expression.children.size > 0
    if (inferred) {
        val body = expression.children[expression.children.size - 1]
        val summary = bootstrapCopyRegionCallSummary(regionCalls)
        val name = "__inferred_lambda"
        bootstrapRegionExpressionRetainsParameters(
            body,
            name,
            parameters,
            parameterTypes,
            declarations,
            summary
        )
        inferred = !bootstrapRegionExpressionCallsUnsafe(body, summary) &&
            !bootstrapExpressionParameterStoredOutside(body, parameters) &&
            !bootstrapRegionExpressionCallsFunctionParameter(
                body, parameters, parameterTypes
            ) && !bootstrapRegionFunctionRetainsAnyParameter(
                summary, name, parameters.size
            )
    }
    inferred
}

/** A `void` function or method may end in an assignment, as a void lambda may: it
 *  returns nothing rather than the assigned value (a trailing `return` is added). */
fun bootstrapEndVoidBodyAfterAssignment(resultType: string, var body: BootstrapExpression): void {
    if (resultType != "inferred" && bootstrapNormalizeType(resultType) == "void" &&
        body.kind == "block" && body.children.size > 0 &&
        bootstrapIsAssignment(body.children[body.children.size - 1])) {
        val end = body.children[body.children.size - 1].end
        body.children.append(BootstrapExpression(
            "return", "", end, end,
            [BootstrapExpression("missing", "return", end, end, [])]
        ))
    }
}

// The methods a Map has itself; any other name on a map is an extension
// function (`fun Map<string, int>.bump(...)`), called like any other.
fun bootstrapIsMapBuiltinMethod(name: string): bool =
    name == "get" || name == "has" || name == "set" || name == "remove" ||
    name == "keys" || name == "values" || name == "clear" || name == "take"

/** Whether a function was published as a member `name__<types>` of an overload set. */
fun bootstrapHasOverloadMember(declarations: array<BootstrapDeclaration>, name: string): bool {
    val prefix = "${name}__"
    var found = false
    var index = 0
    while (!found && index < declarations.size) {
        val candidate = declarations[index].name
        if (candidate.size > prefix.size && candidate.slice(0, prefix.size) == prefix) found = true
        index = index + 1
    }
    found
}

fun bootstrapIsComparisonKind(kind: string): bool =
    kind == "==" || kind == "!=" || kind == "<" || kind == "<=" ||
    kind == ">" || kind == ">="

fun bootstrapIsRegionValueOperator(kind: string): bool =
    kind == "+" || kind == "-" || kind == "*" || kind == "/" || kind == "%"

/** The assignments in `expression` whose value is used (`used`: whether its
 *  own value is): every position but a block's statement before its last, a
 *  loop's body and a lambda's body (whose result the syntax doesn't tell;
 *  contextualizeLambdaParameters marks it where the expected type does),
 *  which pass their position on to a block's last expression and an `if`'s
 *  or `when`'s branches. */
fun bootstrapCollectUsedAssignments(
    expression: BootstrapExpression,
    used: bool,
    var begins: array<int>
): void {
    val kind = expression.kind
    if (bootstrapIsAssignment(expression) && used) begins.append(expression.begin)
    var index = 0
    while (index < expression.children.size) {
        val child = expression.children[index]
        val last = index == expression.children.size - 1
        val childUsed = if (kind == "block") used && last
            else if (kind == "if") index == 0 || used
            else if (kind == "when") used
            else if (kind == "while" || kind == "for") index == 0
            else if (kind == "lambda" || kind == "lambda.move" ||
                kind == "lambda.generator") !last
            else true
        bootstrapCollectUsedAssignments(child, childUsed, begins)
        index = index + 1
    }
    return
}

/** Whether a function's body ends in a value its callers receive: a declared
 *  result other than `void`, or an inferred one from an expression body
 *  (`fun f() = x`). A block body without a declared result is taken as
 *  statements (`fun reset() { n = 0 }`). */
fun bootstrapResultIsUsed(declaration: BootstrapDeclaration): bool =
    if (declaration.resultType == "inferred") declaration.expression.kind != "block"
    else bootstrapNormalizeType(declaration.resultType) != "void"

fun bootstrapIsAssignment(expression: BootstrapExpression): bool =
    expression.kind == "assign" || expression.kind == "member.assign" ||
    expression.kind == "index.assign"

// The runtime's address-yielding intrinsics and field-slot accessors. What
// they return (an object's, a field's or a value's own memory) or the alias
// tag their access carries is sound only under the runtime's layout
// invariants, so only the runtime and the code the compiler generates for it
// call them, whether the caller is trusted or not.
fun bootstrapRuntimeInternalFunction(name: string): bool =
    name == "ablaRuntimeValueAddress" ||
    name == "ablaRuntimeValueWord0" ||
    name == "__ablaRuntimeWord0" ||
    name == "__ablaRuntimeWord1" ||
    name == "__ablaRuntimeObjectAddress" ||
    name == "__ablaRuntimeFieldAddressScan" ||
    name == "__ablaRuntimeFieldAddress" ||
    name == "__ablaRuntimeFieldAddressIndexed" ||
    name == "__ablaRuntimeCellAddress" ||
    name == "__ablaRuntimeArrayAddress" ||
    name == "ablaRuntimeLoadSlotI32" ||
    name == "ablaRuntimeLoadSlotI64" ||
    name == "ablaRuntimeStoreSlotI32" ||
    name == "ablaRuntimeStoreSlotI64"

// Code that may call them: a module under abla/runtime in the standard library,
// or the support the compile-time slice generates (its declarations carry no
// source; the program's own declarations in the slice keep theirs, and the
// program's analysis has already checked them).
fun bootstrapRuntimeInternalCaller(sourceIdentity: string): bool =
    bootstrapRuntimeModuleSource(sourceIdentity) ||
    (sourceIdentity == "" && bootstrapCtAnalyzingSlice)

// The runtime's directory as module identities spell it: the standard
// library's root as imports resolve it, normalized as they are (a root given
// as `/a//b/../c/` names its modules `/a/c/…`).
var bootstrapRuntimeModulePrefix = ""

// The standard library's directory as module identities spell it (as
// bootstrapRuntimeModulePrefix).
var bootstrapStandardLibraryModulePrefix = ""

fun bootstrapStandardLibraryModuleSource(sourceIdentity: string): bool {
    if (bootstrapStandardLibraryModulePrefix == "") {
        bootstrapStandardLibraryModulePrefix = "${bootstrapCanonicalEscapingPath(
            bootstrapNormalizeModulePath(bootstrapStandardLibraryRoot())
        )}/"
    }
    sourceIdentity.startsWith(bootstrapStandardLibraryModulePrefix)
}

fun bootstrapRuntimeModuleSource(sourceIdentity: string): bool {
    if (bootstrapRuntimeModulePrefix == "") {
        bootstrapRuntimeModulePrefix = "${bootstrapCanonicalEscapingPath(
            bootstrapNormalizeModulePath(
                Path(bootstrapStandardLibraryRoot()).child("abla").child("runtime").text
            )
        )}/"
    }
    sourceIdentity.startsWith(bootstrapRuntimeModulePrefix)
}

// An identifier, call or assignment by where it is: `source:begin:name`.
fun bootstrapIdentifierKey(source: string, expression: BootstrapExpression): string =
    "$source:${expression.begin}:${expression.text}"

// The identifier a place (`rows`, `h.items[0]`) starts with, else a missing node.
fun bootstrapPlaceRoot(expression: BootstrapExpression): BootstrapExpression {
    if (expression.kind == "identifier") return expression
    if ((expression.kind == "delegate.project" || expression.kind == "member" ||
         expression.kind == "index") && expression.children.size > 0) {
        return bootstrapPlaceRoot(expression.children[0])
    }
    BootstrapExpression("missing", "", expression.begin, expression.end, [])
}

// What an ownership diagnostic means and the usual fix, as a `help:` line
// after it ("" for a code without one).
fun bootstrapSemanticHelp(code: string): string {
    var colon = 0
    while (colon < code.size && code[colon] != 58) colon = colon + 1
    when (code.slice(0, colon)) {
        "library.program-global" ->
            "the standard library reads only its own globals, never a program's: this name is the library's local or a missing declaration"
        "interface.missing-member" ->
            "the class declares the interface but has no method of this name; add it (or give the interface member a default body)"
        "interface.member-signature" ->
            "the class's method of this name must take the interface member's parameter types and modes and return its result type"
        "interface.unknown" ->
            "a class conforms only to interfaces; this name isn't one"
        "interface.resource-into-plain" ->
            "a plain interface's values copy freely, so a resource class can't conform to one"
        "interface.cast" ->
            "`as?` takes an interface value to a class that conforms to that interface"
        "interface.member-untyped" ->
            "an interface member without a body declares its result type (`fun area(): f64`); write `: void` for none"
        "interface.extend-unknown" ->
            "`extend` adds interfaces to a class; this name isn't a class"
        "interface.inheritance-cycle" ->
            "an interface can't extend itself, directly or through its parents"
        "interface.inheritance-resource" ->
            "a resource interface extends only resource interfaces, and a plain one only plain ones"
        "interface.member-conflict" ->
            "a member declared again in an interface keeps its parent's parameter types, modes and result"
        "interface.default-ambiguous" ->
            "two interfaces the class conforms to give this member a default and neither extends the other: give the class its own method"
        "interface.plain-into-resource" ->
            "every class conforming to a resource interface is a resource class"
        "interface.cast-resource" ->
            "`as?` would leave two owners of one resource: a resource interface's value isn't cast back yet"
        "private.export" ->
            "`@export` publishes a function under a foreign symbol, so it can't be private"
        "name.private" ->
            "a `private` declaration is visible only in the module that declares it"
        "interface.sealed-foreign" ->
            "a sealed interface's classes (and the interfaces extending it) are declared in its own module"
        "when.is-type" ->
            "`is` tests for a class conforming to the subject's interface, or an interface extending it"
        "interface.drop-member" ->
            "`drop` is each resource class's own; an interface value's drop runs its class's"
        "threadShared.library" ->
            "`@threadShared` is the standard library's reviewed promise that a global never changes once built; a program shares one between threads through Shared<T> or Mutex<T>"
        "thread.shared-global" ->
            "a thread reaches this global (in its body or through what it calls) while other threads may use it: wrap it in Shared<T> or Mutex<T>, or give the thread its own copy"
        "native.runtime-internal" ->
            "this intrinsic exposes the runtime's own memory layout, so only the runtime (abla/runtime) calls it, even from trusted code: use the typed operation it backs (a field, an index, a function value's `ablaRuntimeFunctionId`), or `abla/unsafe` for raw memory you allocate"
        "subparser.unknown" ->
            "no imported module registers this `\$name` subparser: import the module that does (for example `import \"abla/json\"` for `\$json` and `\$jsons`)"
        "generator.yield-position" ->
            "a `yield` is a statement of the generator's body: of a block, a branch of a statement `if` or `when`, or a loop body; it has no value, so it cannot be part of an expression. Nor can it be inside a `region`: while the generator is suspended its consumer runs, and what the consumer allocates would land in the region and be freed with it"
        "null-default.non-null" ->
            "the left side of `??` is never null, so the default is never used: drop the `?? ...`"
        "null-default.type" ->
            "`a ?? b` is a's non-null value or b, so b must have that type (an integer literal is an `int`: write `i32(0)` for an `i32`), or be `null`, which makes the result nullable"
        "safe-call.non-null" ->
            "the receiver of `?.` is never null here: use `.` (after a `?.`, the rest of the chain already runs only when the receiver is not null)"
        "integer.narrowing" ->
            "an int does not narrow implicitly where a narrower integer is expected: convert it explicitly, e.g. u8(value), which keeps the low bits; an integer literal that fits needs no conversion"
        "ownership.assignment-value" ->
            "an assignment's value is the value it stored, which the assigned place now owns: using it too would drop it twice; write the value to a local first, or return the variable after assigning"
        "ownership.borrow-mutation" ->
            "it is borrowed here (reached through a parameter or another alias), so it cannot be changed: declare the parameter `var` to change the caller's value, or change a copy"
        "ownership.borrow-store" ->
            "a borrowed value (reached through a parameter or an alias) cannot be stored where it would outlive the borrow: store a new value built from it, or pass and store its owner"
        "ownership.managed-return-borrow-contract" ->
            "a returned reference must be a new value, rooted in a global, or come from one parameter or `this` (the result is then a view of it, and the caller cannot change that argument while it uses the result); this one's source could not be followed (several sources, or a local): return a place under one parameter, declare the result `borrow(name) T`, or build and return a new value"
        "ownership.borrow-return-source" ->
            "every value a `borrow(name) T` result returns must come from `name` (or be new): return a place under `name`, or change the contract"
        "ownership.stored-reference-multiple" ->
            "the new object would keep references that come from more than one argument, which ownership cannot track: create the values inline in the call, or pass copies"
        "ownership.stored-reference-provenance" ->
            "the new object would keep a reference whose source cannot be traced: pass a value created in the call, or a parameter"
        "ownership.mutable-alias" ->
            "the same value reaches this call twice while one use changes it: pass two different values, or a copy"
        "ownership.borrow-own-alias" ->
            "the same value is given away and used again in this call: pass a different value, or a copy"
        "ownership.move-required" ->
            "this value has a single owner: give it away with move(name), after which the name can no longer be used"
        "ownership.borrow-escape" ->
            "a borrowed parameter cannot leave the function unless the result says it is a view of it: declare the result `borrow(name) T`, return or store a new value built from it, or take the parameter as `own`"
        "ownership.borrow-exclusive" ->
            "an `own` parameter takes ownership: pass move(name) of a value you own, not a borrowed one"
        "ownership.fnmut-parameter-mode" ->
            "a function value that changes what it captured (FnMut) is passed as a `var` parameter"
        "ownership.fnonce-parameter-mode" ->
            "a function value that can run only once (FnOnce) is passed as an `own` parameter"
        "ownership.capture-move-required" ->
            "the lambda captures a value with a single owner: write move { ... } to move it into the lambda"
        "ownership.borrow-capture" ->
            "a lambda cannot capture a borrowed value: capture a copy, or its owner"
        "ownership.use-after-move" ->
            "a move gives the value a new owner and leaves the name empty: use the value before the move, move a copy, or assign the name a new value before using it again"
        "ownership.use-after-conditional-move" ->
            "the value is moved on some paths (a branch, or an earlier turn of a loop), and the name is empty on those: move it on every path, or assign it a new value after the move"
        "ownership.partial-move" ->
            "a part was moved out, so the whole is incomplete: assign that part a new value on every path before using the whole, or use only the other parts"
        "ownership.once-called-again" ->
            "a lambda that moves what it captured (`move { ... }`) runs at most once: call it once, or capture a copy so it can run again"
        "assignment.unassigned" ->
            "a variable declared without a value must be assigned on every path before it is read: give it an initial value, or assign it in every branch"
        "global.initialization-cycle" ->
            "each of these top-level values needs the next one initialized first (its initializer reads it, directly or through the functions it calls): compute one of them later, for example in a function called from `main`"
        "function.result-cycle" ->
            "the function calls itself (directly or through other functions without a result type) before its result type is known: give it a result type, as in `fun f(n: int): int`"
        else -> ""
    }
}

/** The interface declaration named `name`, or -1. */
fun bootstrapInterfaceIndexIn(
    declarations: array<BootstrapDeclaration>,
    name: string
): int {
    var index = 0
    while (index < declarations.size) {
        if (declarations[index].kind == "interface" &&
            declarations[index].name == name) return index
        index = index + 1
    }
    -1
}

/** The interfaces `name` extends, directly or through others, each once,
 *  nearest first (`name` itself left out, and a cycle followed once). */
fun bootstrapInterfaceAncestors(
    declarations: array<BootstrapDeclaration>,
    name: string
): array<string> {
    val result: array<string> = []
    var next = 0
    var current = name
    var more = true
    while (more) {
        val found = bootstrapInterfaceIndexIn(declarations, current)
        if (found >= 0) {
            for (parent in declarations[found].conformances) {
                val parentName = bootstrapNormalizeType(parent)
                var seen = parentName == name
                for (previous in result) {
                    if (previous == parentName) seen = true
                }
                if (!seen) result.append(parentName)
            }
        }
        more = next < result.size
        if (more) {
            current = result[next]
            next = next + 1
        }
    }
    result
}

/** The interfaces the class `name` conforms to: those it declares, then those
 *  `extend name : I` adds, then the interfaces those extend, each once. */
fun bootstrapClassInterfaces(
    declarations: array<BootstrapDeclaration>,
    name: string
): array<string> {
    val result: array<string> = []
    for (declaration in declarations) {
        if ((declaration.kind == "class" || declaration.kind == "extend") &&
            declaration.name == name) {
            for (conformance in declaration.conformances) {
                bootstrapAppendInterfaceOnce(result, bootstrapNormalizeType(conformance))
            }
        }
    }
    val direct = result.size
    var index = 0
    while (index < direct) {
        for (ancestor in bootstrapInterfaceAncestors(declarations, result[index])) {
            bootstrapAppendInterfaceOnce(result, ancestor)
        }
        index = index + 1
    }
    result
}

fun bootstrapAppendInterfaceOnce(var names: array<string>, name: string): void {
    for (previous in names) {
        if (previous == name) return
    }
    names.append(name)
    return
}

/** Whether `type` (a class or an interface) is, or conforms to, the
 *  interface `interfaceName`. */
fun bootstrapTypeConformsIn(
    declarations: array<BootstrapDeclaration>,
    type: string,
    interfaceName: string
): bool {
    if (type == interfaceName) return bootstrapInterfaceIndexIn(declarations, type) >= 0
    val interfaces = if (bootstrapInterfaceIndexIn(declarations, type) >= 0)
        bootstrapInterfaceAncestors(declarations, type)
        else bootstrapClassInterfaces(declarations, type)
    for (candidate in interfaces) {
        if (candidate == interfaceName) return true
    }
    false
}

/** Whether the class `owner` is `type` or conforms to it. */
fun bootstrapTypeConformsOrIs(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    type: string
): bool = owner == type || bootstrapTypeConformsIn(declarations, owner, type)

/** Every member of the interface `name`: its own, then those it inherits
 *  that it doesn't declare again. */
fun bootstrapInterfaceAllMembers(
    declarations: array<BootstrapDeclaration>,
    name: string
): array<BootstrapDeclaration> {
    val result: array<BootstrapDeclaration> = []
    val names = [name]
    for (ancestor in bootstrapInterfaceAncestors(declarations, name)) {
        names.append(ancestor)
    }
    for (owner in names) {
        val found = bootstrapInterfaceIndexIn(declarations, owner)
        if (found >= 0) {
            for (member in bootstrapInterfaceMembers(declarations[found])) {
                var seen = false
                for (previous in result) {
                    if (previous.name == member.name) seen = true
                }
                if (!seen) result.append(member)
            }
        }
    }
    result
}

/** The interface declaring the member `member` that `name` has (itself, or
 *  the nearest ancestor that declares it), or "". */
fun bootstrapInterfaceDeclaringOwner(
    declarations: array<BootstrapDeclaration>,
    name: string,
    member: string
): string {
    val names = [name]
    for (ancestor in bootstrapInterfaceAncestors(declarations, name)) {
        names.append(ancestor)
    }
    for (owner in names) {
        val found = bootstrapInterfaceIndexIn(declarations, owner)
        if (found >= 0) {
            for (candidate in bootstrapInterfaceMembers(declarations[found])) {
                if (candidate.name == member) return owner
            }
        }
    }
    ""
}

/** The interface whose default body answers `member` for the class `owner`:
 *  among the interfaces it conforms to that give `member` a body, the one no
 *  other of them extends. "" when none does, "?" when two unrelated ones do. */
fun bootstrapDefaultInterface(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    member: string
): string {
    val candidates: array<string> = []
    for (interfaceName in bootstrapClassInterfaces(declarations, owner)) {
        val found = bootstrapInterfaceIndexIn(declarations, interfaceName)
        if (found >= 0) {
            for (candidate in bootstrapInterfaceMembers(declarations[found])) {
                if (candidate.name == member &&
                    bootstrapInterfaceMemberHasDefault(declarations[found], candidate)) {
                    candidates.append(interfaceName)
                }
            }
        }
    }
    val specific: array<string> = []
    for (candidate in candidates) {
        var extended = false
        for (other in candidates) {
            if (other != candidate) {
                for (ancestor in bootstrapInterfaceAncestors(declarations, other)) {
                    if (ancestor == candidate) extended = true
                }
            }
        }
        if (!extended) specific.append(candidate)
    }
    if (specific.size == 1) specific[0]
    else if (specific.size == 0) ""
    else "?"
}

/** The first of the class's interfaces that declares `member`, or "". */
fun bootstrapFirstInterfaceWithMember(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    member: string
): string {
    for (interfaceName in bootstrapClassInterfaces(declarations, owner)) {
        val found = bootstrapInterfaceIndexIn(declarations, interfaceName)
        if (found >= 0) {
            for (candidate in bootstrapInterfaceMembers(declarations[found])) {
                if (candidate.name == member) return interfaceName
            }
        }
    }
    ""
}

/** Whether the interface `name` extends itself, through any parents. */
fun bootstrapInterfaceInCycle(
    declarations: array<BootstrapDeclaration>,
    name: string
): bool {
    val found = bootstrapInterfaceIndexIn(declarations, name)
    if (found < 0) return false
    val reached: array<string> = []
    for (parent in declarations[found].conformances) {
        bootstrapAppendInterfaceOnce(reached, bootstrapNormalizeType(parent))
    }
    var index = 0
    while (index < reached.size) {
        if (reached[index] == name) return true
        val next = bootstrapInterfaceIndexIn(declarations, reached[index])
        if (next >= 0) {
            for (parent in declarations[next].conformances) {
                bootstrapAppendInterfaceOnce(reached, bootstrapNormalizeType(parent))
            }
        }
        index = index + 1
    }
    false
}

/** An interface's members as written: once lowering made each member a
 *  dispatcher (interfaces.ab), its default body's copy is left out. */
fun bootstrapInterfaceMembers(
    interfaceDeclaration: BootstrapDeclaration
): array<BootstrapDeclaration> {
    val result: array<BootstrapDeclaration> = []
    for (member in interfaceDeclaration.methods) {
        if (!bootstrapInterfaceDefaultCopy(interfaceDeclaration, member)) {
            result.append(member)
        }
    }
    result
}

/** Whether `member` is the copy of a default body lowering keeps beside the
 *  member's dispatcher (`name__default`). */
fun bootstrapInterfaceDefaultCopy(
    interfaceDeclaration: BootstrapDeclaration,
    member: BootstrapDeclaration
): bool {
    if (member.name.size <= 9 ||
        member.name.slice(member.name.size - 9, member.name.size) != "__default") {
        return false
    }
    val name = member.name.slice(0, member.name.size - 9)
    for (other in interfaceDeclaration.methods) {
        if (other.name == name &&
            other.expression.kind == "interface.dispatch") return true
    }
    false
}

/** Whether the interface gives `member` a default body (before or after
 *  lowering made the member a dispatcher). */
fun bootstrapInterfaceMemberHasDefault(
    interfaceDeclaration: BootstrapDeclaration,
    member: BootstrapDeclaration
): bool {
    if (member.expression.kind != "missing" &&
        member.expression.kind != "interface.dispatch") return true
    for (other in interfaceDeclaration.methods) {
        if (other.name == "${member.name}__default") return true
    }
    false
}

/** What answers `member` of `interfaceDeclaration` for the class `owner`:
 *  "method" (the class's own), "extension" (an extension function
 *  `fun Owner.member`), "default" (the interface's body) or "" (nothing). */
fun bootstrapWitnessKind(
    declarations: array<BootstrapDeclaration>,
    owner: BootstrapDeclaration,
    interfaceDeclaration: BootstrapDeclaration,
    member: BootstrapDeclaration
): string {
    for (method in owner.methods) {
        if (method.name == member.name &&
            bootstrapConformanceSignatureMatches(member, method)) return "method"
    }
    for (candidate in declarations) {
        if (candidate.kind == "fun" && candidate.name == member.name &&
            bootstrapNormalizeType(candidate.extensionOwner) == owner.name &&
            bootstrapConformanceSignatureMatches(member, candidate)) return "extension"
    }
    val provider = bootstrapDefaultInterface(declarations, owner.name, member.name)
    if (provider != "" && provider != "?") "default" else ""
}

/** bootstrapJoinTypes, where two classes (or a class and an interface it
 *  conforms to) also join to the one interface both are: `if (round)
 *  Circle(2) else Square(3)` is a `Shape` when that is the only interface
 *  they share. */
fun bootstrapJoinTypesWith(
    left: string,
    right: string,
    declarations: array<BootstrapDeclaration>,
    // `declarations`' bootstrapTypeDeclarationIndex.
    types: BootstrapFunctionDeclarationIndex
): string {
    val joined = bootstrapJoinTypes(left, right)
    if (joined != "void" || left == right) return joined
    val leftDeclaration = bootstrapLastClassOrInterface(declarations, types, left)
    if (leftDeclaration < 0) return joined
    val rightDeclaration = bootstrapLastClassOrInterface(declarations, types, right)
    if (rightDeclaration < 0) return joined
    val leftInterfaces = bootstrapDeclaredInterfaces(declarations, declarations[leftDeclaration])
    val rightInterfaces = bootstrapDeclaredInterfaces(declarations, declarations[rightDeclaration])
    val shared: array<string> = []
    for (candidate in leftInterfaces) {
        for (other in rightInterfaces) {
            if (candidate == other) shared.append(candidate)
        }
    }
    // The most specific: one no other shared interface extends.
    var result = ""
    var count = 0
    for (candidate in shared) {
        var extended = false
        for (other in shared) {
            if (other != candidate) {
                for (ancestor in bootstrapInterfaceAncestors(declarations, other)) {
                    if (ancestor == candidate) extended = true
                }
            }
        }
        if (!extended) {
            result = candidate
            count = count + 1
        }
    }
    if (count == 1) result else joined
}

/** The last class or interface of `declarations` named `name`, or -1:
 *  `types` (bootstrapTypeDeclarationIndex) has the last class, interface or
 *  `type` of the name, and only a `type` after it makes a scan back needed. */
fun bootstrapLastClassOrInterface(
    declarations: array<BootstrapDeclaration>,
    types: BootstrapFunctionDeclarationIndex,
    name: string
): int {
    var index = types.find(name)
    while (index >= 0 && (declarations[index].name != name ||
        (declarations[index].kind != "class" && declarations[index].kind != "interface"))) {
        index = index - 1
    }
    index
}

/** A class's interfaces, or an interface itself. */
fun bootstrapDeclaredInterfaces(
    declarations: array<BootstrapDeclaration>,
    declaration: BootstrapDeclaration
): array<string> {
    if (declaration.kind != "interface") {
        return bootstrapClassInterfaces(declarations, declaration.name)
    }
    val result = [declaration.name]
    for (ancestor in bootstrapInterfaceAncestors(declarations, declaration.name)) {
        result.append(ancestor)
    }
    result
}

// Compute the narrowest type that can represent either branch of an
// expression. In particular, `null` joined with `T` is `T?`; treating that
// pair as `void` made otherwise valid nullable expression bodies fail their
// declared result type.
fun bootstrapJoinTypes(left: string, right: string): string {
    var result = "void"
    if (left == "never") result = right
    if (right == "never") result = left
    if (left == right) result = left
    if (left == "unknown") result = right
    if (right == "unknown") result = left
    if (left == "null" && right != "null" && right != "void") {
        if (bootstrapIsNullableType(right)) result = right
        else result = "nullable:$right"
    }
    if (right == "null" && left != "null" && left != "void") {
        if (bootstrapIsNullableType(left)) result = left
        else result = "nullable:$left"
    }
    if (bootstrapIsNullableType(left) &&
        bootstrapNullableElementType(left) == right) result = left
    if (bootstrapIsNullableType(right) &&
        bootstrapNullableElementType(right) == left) result = right
    // `[]` is an array of nothing yet: it takes the other branch's type.
    if (left == "array:unknown" && bootstrapIsArrayType(right)) result = right
    if (right == "array:unknown" && bootstrapIsArrayType(left)) result = left
    result
}

fun bootstrapWhenLiteralKey(expression: BootstrapExpression): string {
    var key = ""
    if (expression.kind == "integer" || expression.kind == "float" ||
        expression.kind == "true" ||
        expression.kind == "false" || expression.kind == "null" ||
        expression.kind == "string") {
        key = "${expression.kind}:${expression.text}"
    }
    key
}

fun bootstrapExpressionBreaksCurrentLoop(
    expression: BootstrapExpression,
    nestedLoops: int
): bool {
    var breaks = expression.kind == "break" && nestedLoops == 0
    var childLoops = nestedLoops
    if (expression.kind == "while" || expression.kind == "do.while" ||
        expression.kind == "for") childLoops = nestedLoops + 1
    if (expression.kind == "lambda" || expression.kind == "lambda.move") {
        breaks = false
        bootstrapSemanticUnit()
    } else {
        var child = 0
        while (!breaks && child < expression.children.size) {
            breaks = bootstrapExpressionBreaksCurrentLoop(
                expression.children[child],
                childLoops
            )
            child = child + 1
        }
        bootstrapSemanticUnit()
    }
    breaks
}

// Whether `expression`'s value is a new one that nothing else holds: a call's
// result, or what an `if` (with `else`), a `when` or a block hands on from
// such values (a block also hands on a local of its own, which leaves the
// block with its value). Where such a value is discarded (a statement that
// isn't a block's last, a loop's body, an `if` without `else`), lowering and
// the evaluator drop it when it is a resource. Leaving branches count: they
// hand nothing on.
fun bootstrapExpressionYieldsFreshValue(expression: BootstrapExpression): bool {
    val kind = expression.kind
    if (kind == "call" || kind == "member.call" || kind == "call.value" ||
        kind == "return" || kind == "break" || kind == "continue") return true
    if (kind == "if") {
        return expression.children.size == 3 &&
            expression.children[2].kind != "missing" &&
            bootstrapExpressionYieldsFreshValue(expression.children[1]) &&
            bootstrapExpressionYieldsFreshValue(expression.children[2])
    }
    if (kind == "when") {
        if (expression.children.size < 3) return false
        var branch = 2
        while (branch < expression.children.size) {
            if (!bootstrapExpressionYieldsFreshValue(expression.children[branch])) return false
            branch = branch + 2
        }
        return true
    }
    if (kind == "block" && expression.children.size > 0) {
        val tail = expression.children[expression.children.size - 1]
        if (bootstrapExpressionYieldsFreshValue(tail)) return true
        if (tail.kind == "identifier") {
            for (statement in expression.children) {
                if (bootstrapStatementDeclaresLocal(statement) &&
                    statement.text == tail.text) return true
            }
        }
    }
    false
}

// `return`, `break` or `continue`, alone or ending a block, or an `if`
// whose branches both end so: control never reaches the next statement.
fun bootstrapStatementLeaves(expression: BootstrapExpression): bool =
    expression.kind == "return" || expression.kind == "break" ||
    expression.kind == "continue" ||
    (expression.kind == "block" && expression.children.size > 0 &&
     bootstrapStatementLeaves(
        expression.children[expression.children.size - 1]
     )) ||
    (expression.kind == "if" && expression.children.size == 3 &&
     expression.children[2].kind != "missing" &&
     bootstrapStatementLeaves(expression.children[1]) &&
     bootstrapStatementLeaves(expression.children[2]))

// What the statements after `if (c) …` know of `c`: "false" when only its
// then branch leaves (`if (x == null) return 0`), "true" when only its else
// branch does, "" otherwise.
fun bootstrapConditionAfterIf(statement: BootstrapExpression): string {
    if (statement.kind != "if" || statement.children.size != 3) return ""
    val thenLeaves = bootstrapStatementLeaves(statement.children[1])
    val elseLeaves = statement.children[2].kind != "missing" &&
        bootstrapStatementLeaves(statement.children[2])
    if (thenLeaves && !elseLeaves) "false"
    else if (elseLeaves && !thenLeaves) "true"
    else ""
}

// Whether `name` is assigned (`name = …`, `name += …`) anywhere under
// `expression`, closures included.
fun bootstrapExpressionAssigns(expression: BootstrapExpression, name: string): bool {
    if (expression.kind == "assign" && expression.text == name) return true
    var child = 0
    while (child < expression.children.size) {
        if (bootstrapExpressionAssigns(expression.children[child], name)) return true
        child = child + 1
    }
    false
}

// References to `name` under `expression` starting at or after `from`
// (`from` 0: all of them). A node without a source position counts as late.
fun bootstrapNameReferences(
    expression: BootstrapExpression,
    name: string,
    from: int
): int {
    var count = if (expression.kind == "identifier" && expression.text == name &&
        (expression.begin >= from || expression.begin <= 0)) 1 else 0
    for (child in expression.children) {
        count = count + bootstrapNameReferences(child, name, from)
    }
    count
}

// Where the last `val name` before `before` is declared under `expression`.
fun bootstrapLocalDeclarationBefore(
    expression: BootstrapExpression,
    name: string,
    before: int
): int {
    var found = if (expression.kind == "local.val" && expression.text == name &&
        expression.begin < before) expression.begin else -1
    for (child in expression.children) {
        val inner = bootstrapLocalDeclarationBefore(child, name, before)
        if (inner > found) found = inner
    }
    found
}

// A loop or lambda that encloses `call` but starts after `declared`: it can
// run the call more than once with the same local.
fun bootstrapRepeatsBetween(
    expression: BootstrapExpression,
    declared: int,
    call: BootstrapExpression
): bool {
    val repeats = expression.kind == "while" || expression.kind == "do.while" ||
        expression.kind == "for" || expression.kind == "lambda" ||
        expression.kind == "lambda.move" || expression.kind == "lambda.generator"
    if (repeats && expression.begin > declared &&
        expression.begin <= call.begin && call.end <= expression.end) return true
    for (child in expression.children) {
        if (bootstrapRepeatsBetween(child, declared, call)) return true
    }
    false
}

fun bootstrapExpressionContainsDeferredControl(
    expression: BootstrapExpression
): bool {
    var found = expression.kind == "return" || expression.kind == "break" ||
        expression.kind == "continue"
    if (expression.kind == "lambda" || expression.kind == "lambda.move") {
        found = false
        bootstrapSemanticUnit()
    } else {
        var child = 0
        while (!found && child < expression.children.size) {
            found = bootstrapExpressionContainsDeferredControl(
                expression.children[child]
            )
            child = child + 1
        }
        bootstrapSemanticUnit()
    }
    found
}

fun bootstrapAffineNamesContain(
    names: array<string>,
    name: string
): bool {
    var found = false
    var index = 0
    while (index < names.size) {
        if (names[index] == name) found = true
        index = index + 1
    }
    found
}

fun bootstrapSummaryTypeIsAffineAt(
    type: string,
    names: array<string>,
    depth: int
): bool {
    val normalized = bootstrapNormalizeType(type)
    var affine = bootstrapIsOnceFunctionType(normalized) ||
        bootstrapIsMutableFunctionType(normalized) ||
        bootstrapIsSharedType(normalized) ||
        bootstrapIsWeakType(normalized) ||
        bootstrapIsMutexType(normalized) ||
        bootstrapIsGeneratorType(normalized) ||
        bootstrapIsTaskType(normalized) ||
        bootstrapIsThreadType(normalized) ||
        bootstrapAffineNamesContain(names, normalized)
    if (!affine && depth < 32 && bootstrapIsNullableType(normalized)) {
        affine = bootstrapSummaryTypeIsAffineAt(
            bootstrapNullableElementType(normalized),
            names,
            depth + 1
        )
    }
    if (!affine && depth < 32 && bootstrapIsArrayType(normalized)) {
        affine = bootstrapSummaryTypeIsAffineAt(
            bootstrapArrayElementType(normalized),
            names,
            depth + 1
        )
    }
    // A map owns its values: affine values make it affine.
    if (!affine && depth < 32 && bootstrapIsMapType(normalized)) {
        affine = bootstrapSummaryTypeIsAffineAt(
            bootstrapMapValueType(normalized),
            names,
            depth + 1
        )
    }
    affine
}

fun bootstrapSummaryTypeIsAffine(
    type: string,
    names: array<string>
): bool = bootstrapSummaryTypeIsAffineAt(type, names, 0)

fun bootstrapSummaryTypeIsManagedReferenceAt(
    type: string,
    declarations: array<BootstrapDeclaration>,
    depth: int
): bool {
    val normalized = bootstrapNormalizeType(type)
    var managed = bootstrapIsArrayType(normalized) ||
        bootstrapIsCellType(normalized) || bootstrapIsMapType(normalized)
    var declaration = 0
    while (!managed && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if ((candidate.kind == "class" || candidate.kind == "interface") &&
            candidate.name == normalized) managed = true
        declaration = declaration + 1
    }
    if (!managed && depth < 32 && bootstrapIsNullableType(normalized)) {
        managed = bootstrapSummaryTypeIsManagedReferenceAt(
            bootstrapNullableElementType(normalized),
            declarations,
            depth + 1
        )
    }
    managed
}

fun bootstrapSummaryTypeIsManagedReference(
    type: string,
    declarations: array<BootstrapDeclaration>
): bool = bootstrapSummaryTypeIsManagedReferenceAt(type, declarations, 0)

/** bootstrapSummaryTypeIsManagedReferenceAt over an index of the class and
 *  interface names (bootstrapManagedTypeIndex). */
fun bootstrapSummaryTypeIsManagedReferenceIn(
    type: string,
    managedTypes: BootstrapFunctionDeclarationIndex,
    depth: int
): bool {
    val normalized = bootstrapNormalizeType(type)
    var managed = bootstrapIsArrayType(normalized) ||
        bootstrapIsCellType(normalized) || bootstrapIsMapType(normalized) ||
        managedTypes.find(normalized) >= 0
    if (!managed && depth < 32 && bootstrapIsNullableType(normalized)) {
        managed = bootstrapSummaryTypeIsManagedReferenceIn(
            bootstrapNullableElementType(normalized),
            managedTypes,
            depth + 1
        )
    }
    managed
}

/** The class and interface declarations by name. */
fun bootstrapManagedTypeIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapFunctionDeclarationIndex {
    val names: array<string> = []
    val declarationIndices: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.kind == "class" || candidate.kind == "interface") {
            names.append(candidate.name)
            declarationIndices.append(declaration)
        }
        declaration = declaration + 1
    }
    var capacity = 8
    while (capacity < names.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    var entry = 0
    while (entry < names.size) {
        slot = bootstrapFunctionDeclarationHash(names[entry])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0 || names[existing] == names[entry]) {
                slots[slot] = entry
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    BootstrapFunctionDeclarationIndex(names, declarationIndices, slots)
}

// A stable alias must become a source-linked read-only view whenever mutation
// can be observed through nested class fields. `val` remains Kotlin-like (the
// field binding is fixed, not recursively frozen). Root arrays are tracked by
// the same query; arrays stored inside val fields need lifetime propagation
// through stored/returned references before they can safely join this rule.
// Cell is deliberately not expanded: its mutation is explicit, scalar-only
// interior mutability and is legal through shared views.
fun bootstrapSummaryTypeNeedsManagedAliasTrackingAt(
    type: string,
    declarations: array<BootstrapDeclaration>,
    depth: int
): bool {
    var normalized = bootstrapNormalizeType(type)
    var nullableDepth = 0
    while (nullableDepth < 32 && bootstrapIsNullableType(normalized)) {
        normalized = bootstrapNullableElementType(normalized)
        nullableDepth = nullableDepth + 1
    }
    var tracked = depth == 0 && bootstrapIsArrayType(normalized)
    var declaration = 0
    while (!tracked && depth < 32 && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.kind == "class" && candidate.name == normalized) {
            var field = 0
            while (!tracked && field < candidate.parameterTypes.size) {
                if (field < candidate.parameterKinds.size &&
                    candidate.parameterKinds[field] == "var") {
                    tracked = true
                } else if (!bootstrapIsArrayType(bootstrapNormalizeType(
                    candidate.parameterTypes[field]
                )) && bootstrapSummaryTypeNeedsManagedAliasTrackingAt(
                        candidate.parameterTypes[field],
                        declarations,
                        depth + 1
                    )) tracked = true
                field = field + 1
            }
        }
        declaration = declaration + 1
    }
    tracked
}

fun bootstrapSummaryTypeNeedsManagedAliasTracking(
    type: string,
    declarations: array<BootstrapDeclaration>
): bool = bootstrapSummaryTypeNeedsManagedAliasTrackingAt(
    type,
    declarations,
    0
)

fun bootstrapBuildAffineTypeNames(
    declarations: array<BootstrapDeclaration>
): array<string> {
    val names: array<string> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val found = declarations[declaration]
        // A resource interface's values are resources too.
        if ((found.kind == "class" || found.kind == "interface") &&
            found.isResource &&
            !bootstrapAffineNamesContain(names, found.name)) {
            names.append(found.name)
        }
        declaration = declaration + 1
    }
    var changed = true
    var round = 0
    while (changed && round <= declarations.size) {
        changed = false
        declaration = 0
        while (declaration < declarations.size) {
            val found = declarations[declaration]
            if (found.kind == "class" &&
                !bootstrapAffineNamesContain(names, found.name)) {
                var field = 0
                while (field < found.parameterTypes.size &&
                       !bootstrapAffineNamesContain(names, found.name)) {
                    if (field < found.parameterKinds.size &&
                        (found.parameterKinds[field] == "val" ||
                         found.parameterKinds[field] == "var") &&
                        bootstrapSummaryTypeIsAffine(
                            found.parameterTypes[field],
                            names
                        )) {
                        names.append(found.name)
                        changed = true
                    }
                    field = field + 1
                }
            }
            declaration = declaration + 1
        }
        round = round + 1
    }
    names
}

class BootstrapSymbol(
    val name: string,
    val kind: string,
    val type: string,
    val scope: int,
    val borrowSource: string,
    val identity: string
)

// Compact, pointer-free semantic record retained only for expressions named by
// deferred compiler-extension requests. Declaration handles use the public
// deterministic handle numbering; argument metadata is in source order.
class BootstrapTypedCall(
    val sourceIdentity: string,
    val begin: int,
    val end: int,
    val kind: string,
    val name: string,
    val type: string,
    val receiverType: string,
    val target: int,
    val argumentTypes: array<string>,
    val parameterTypes: array<string>,
    val parameterKinds: array<string>,
    val argumentParameters: array<int>,
    val argumentConversions: array<string>,
    val insertedDefaults: int,
    val isCompileOnly: bool,
    val isTrusted: bool,
    val isContract: bool
)

class BootstrapResolvedName(
    val sourceIdentity: string,
    val begin: int,
    val end: int,
    val name: string,
    val declarationIdentity: string,
    val type: string,
    val kind: string
)

class BootstrapSemanticResult(
    val symbols: array<BootstrapSymbol>,
    val errors: int,
    val extensionErrors: int,
    val diagnostics: string,
    val mutableReceivers: BootstrapMutableReceiverSummary,
    val compileEffects: BootstrapCompileEffectSummary,
    val typedCalls: array<BootstrapTypedCall>,
    val resolvedNames: array<BootstrapResolvedName>,
    val managedAliasBegins: array<int>,
    val managedAliasEnds: array<int>,
    val managedAliasSources: array<string>,
    // The file of each managed alias (its source identity): offsets alone
    // name a place in any file.
    val managedAliasFiles: array<string>,
    // Result types inferred from bodies, which lowering types calls with.
    val inferredResults: BootstrapInferredResultTypes = bootstrapNoInferredResultTypes(),
    // Array literals typed from an inferred receiver, which lowering types.
    val contextualLiterals: BootstrapContextualLiterals = bootstrapNoContextualLiterals(),
    // The identifiers and calls that named a local while a top-level
    // declaration has the name (BootstrapAnalyzer.shadowedIdentifiers), which
    // lowering's name scans skip (bootstrapIdentifierKey keys).
    val shadowedIdentifiers: array<string> = []
)

// Compile-time effects are deliberately represented as a compact bitset. The
// complete compiler graph contains thousands of calls, so retaining an object
// per call edge would make hermeticity analysis compete with code generation
// for watchdog memory.
class BootstrapCompileEffectSummary(
    val names: array<string>,
    val methodNames: array<string>,
    val masks: array<int>,
    val nameSlots: array<int>,
    val nameNext: array<int>,
    val methodSlots: array<int>,
    val methodNext: array<int>
)

fun bootstrapCompileEffectHas(mask: int, effect: int): bool =
    mask / effect - (mask / effect / 2) * 2 == 1

fun bootstrapCompileEffectMerge(left: int, right: int): int {
    var merged = left
    var effect = 1
    while (effect <= BOOTSTRAP_COMPILE_TRANSFORM_LIBRARY) {
        if (bootstrapCompileEffectHas(right, effect) &&
            !bootstrapCompileEffectHas(merged, effect)) {
            merged = merged + effect
        }
        effect = effect * 2
    }
    merged
}

fun bootstrapTextContains(text: string, needle: string): bool {
    var found = needle.size == 0
    var begin = 0
    while (!found && begin + needle.size <= text.size) {
        var equal = true
        var index = 0
        while (equal && index < needle.size) {
            if (text[begin + index] != needle[index]) equal = false
            index = index + 1
        }
        if (equal) found = true
        begin = begin + 1
    }
    found
}

fun bootstrapCompileBuiltinEffect(name: string): int {
    var effect = 0
    if (bootstrapTextContains(name, "compiler") ||
        bootstrapTextContains(name, "Parser") ||
        bootstrapTextContains(name, "parser") ||
        bootstrapTextContains(name, "Syntax") ||
        bootstrapTextContains(name, "syntax")) effect = 2
    effect
}

// The float intrinsics of abla/float and abla/math that compile-time code
// evaluates (eval.ab computes them; sema admits them at compile time).
fun bootstrapEvalFloatIntrinsic(name: string): bool =
    name == "ablaBitF64ToI64" || name == "ablaBitI64ToF64" ||
    name == "ablaConvertI64ToF64" || name == "ablaConvertF64ToI64" ||
    name == "ablaBitF32ToI32" || name == "ablaBitI32ToF32" ||
    name == "ablaConvertU32ToF32" || name == "ablaConvertI32ToF32" ||
    name == "ablaConvertF32ToU32" || name == "ablaConvertF32ToI32" ||
    name == "ablaConvertF64ToF32" || name == "ablaConvertF32ToF64" ||
    name == "ablaF64Sqrt" || name == "ablaF64Floor" ||
    name == "ablaF64Ceil" || name == "ablaF64Trunc" ||
    name == "ablaF64Abs" || name == "ablaF64RoundEven"

fun bootstrapCompileArgumentIntrinsic(name: string): bool =
    name == "ablaLinuxArgumentCount" || name == "ablaLinuxArgument" ||
    name == "ablaHostArgumentCount" || name == "ablaHostArgument"

fun bootstrapCompileExternalEffect(
    declaration: BootstrapDeclaration
): int {
    val name = declaration.name
    var effect = 0
    if (name == "compilerEnvironment") effect = 16
    else if (name == "compilerWriteFile") effect = 8
    else if (name == "compilerRunProcess") effect = 32
    else if (name == "compilerTcpExchange") effect = 64
    else if (name == "compilerClockMilliseconds") effect = 128
    else if (name == "compilerRandomInteger") effect = 256
    else if (declaration.externalLibrary == "compiler" ||
        declaration.externalLibrary == "parser") effect = 2
    else if (bootstrapCompileRawMemoryIntrinsic(name) &&
             declaration.externalLibrary == "intrinsic") {
        effect = BOOTSTRAP_COMPILE_RAW_MEMORY
    }
    else if (bootstrapTextContains(name, "RuntimeMemory")) effect = 1
    else if (bootstrapTextContains(name, "ReadFile") ||
             bootstrapTextContains(name, "FileKind") ||
             bootstrapTextContains(name, "FileSize") ||
             bootstrapTextContains(name, "ListDirectory") ||
             bootstrapTextContains(name, "CurrentDirectory") ||
             bootstrapTextContains(name, "FileRevision")) effect = 4
    else if (bootstrapTextContains(name, "WriteFile") ||
             bootstrapTextContains(name, "CreateDirector") ||
             bootstrapTextContains(name, "MoveFile") ||
             bootstrapTextContains(name, "RemoveFile")) effect = 8
    // Compile-time code is a program the compiler runs with no arguments: its
    // argument count is 0, deterministic, so reading it needs no grant.
    else if (bootstrapCompileArgumentIntrinsic(name)) effect = 0
    else if (bootstrapTextContains(name, "Argument") ||
             bootstrapTextContains(name, "Environment")) effect = 16
    else if (bootstrapTextContains(name, "Sleep") ||
             bootstrapTextContains(name, "Clock") ||
             bootstrapTextContains(name, "Time")) effect = 128
    else if (bootstrapTextContains(name, "Random")) effect = 256
    else if (bootstrapTextContains(name, "Tcp") ||
             bootstrapTextContains(name, "Socket") ||
             bootstrapTextContains(name, "Network") ||
             bootstrapTextContains(name, "Poll")) effect = 64
    else if (bootstrapTextContains(name, "Process") ||
             bootstrapTextContains(name, "Stdin") ||
             bootstrapTextContains(name, "Stdout") ||
             bootstrapTextContains(name, "Stderr")) effect = 32
    else if (bootstrapTextContains(declaration.name, "ablaBit") &&
             declaration.externalLibrary == "intrinsic") effect = 0
    // A trap ends the evaluation with a diagnostic (ct_native.ab).
    else if (declaration.name == "ablaRuntimeTrap" &&
             declaration.externalLibrary == "intrinsic") effect = 0
    else if ((declaration.name == "ablaUtf8EncodeScalar" ||
             declaration.name == "ablaBase64Encode" ||
             declaration.name == "ablaBase64Decode" ||
             declaration.name == "ablaByteChunksJoin" ||
             declaration.name == "ablaByteEncode" ||
             declaration.name == "ablaTextFindSequence" ||
             declaration.name == "ablaTextFindByte" ||
             declaration.name == "ablaTextAsciiEqualInsensitive" ||
             declaration.name == "ablaTextReadU32LittleEndian" ||
             declaration.name == "ablaTextIsValidUtf8" ||
             declaration.name == "ablaJsonFindPlainStringEnd" ||
             declaration.name == "ablaJsonMatchCompactObjectField" ||
             declaration.name == "ablaJsonCompactArrayNext" ||
             declaration.name == "ablaJsonAvailableIntegerEnd" ||
             declaration.name == "ablaJsonIntegerValueAt" ||
             declaration.name == "ablaJsonWhitespaceEnd" ||
             declaration.name == "ablaJsonStringIsPlain") &&
             declaration.externalLibrary == "intrinsic") effect = 0
    // The float conversions and abla/math's rounding and square root are
    // computed by the compile-time evaluator.
    else if (bootstrapEvalFloatIntrinsic(declaration.name) &&
             declaration.externalLibrary == "intrinsic") effect = 0
    // The compiler bridge's entry points (abla/compiler/bridge, called by the
    // shims native compile-time code has for the compiler API) perform each call
    // with the evaluator's grants, so they need none of their own.
    else if (declaration.externalLibrary == "c" && name.startsWith("abla_ct_bridge_") &&
             declaration.sourceIdentity.startsWith(
                 "${bootstrapCompileProviderStandardLibrary()}/abla/compiler/bridge/")) effect = 0
    else if (declaration.isTrusted || declaration.externalLibrary == "c" ||
             declaration.externalLibrary == "intrinsic" ||
             declaration.externalLibrary == "host") effect = 512
    effect
}

// While a compile-effect summary is built, the entry whose body is being
// walked (-1 otherwise), and each entry read during the first pass as edges
// (reader, read), at most once per pair: bootstrapBuildCompileEffectSummary
// walks again only the readers of an entry whose effects grew.
var bootstrapCompileEffectReading: int = -1
var bootstrapCompileEffectLastReader: array<int> = []
var bootstrapCompileEffectEdgeReaders: array<int> = []
var bootstrapCompileEffectEdgeReads: array<int> = []

fun bootstrapCompileEffectLookup(
    summary: BootstrapCompileEffectSummary,
    name: string,
    method: bool
): int {
    var mask = bootstrapCompileBuiltinEffect(name)
    val runtimeMemoryBuiltin = !method &&
        (name == "runtimeMemoryCheckpoint" ||
         name == "runtimeMemoryReset" ||
         name == "runtimeMemoryLiveBytes" ||
         name == "runtimeMemoryLimit" ||
         name == "runtimeMemorySetLimit" ||
         name == "runtimeMemoryCollect")
    if (runtimeMemoryBuiltin) return 1
    val slots = if (method) summary.methodSlots else summary.nameSlots
    val next = if (method) summary.methodNext else summary.nameNext
    if (slots.size == 0) return mask
    var slot = bootstrapFunctionDeclarationHash(name)
    slot = slot - slot / slots.size * slots.size
    var index = slots[slot]
    while (index >= 0) {
        val matches = if (method) summary.methodNames[index] == name
            else summary.names[index] == name
        if (matches) {
            mask = bootstrapCompileEffectMerge(mask, summary.masks[index])
            val reader = bootstrapCompileEffectReading
            if (reader >= 0 && bootstrapCompileEffectLastReader[index] != reader) {
                bootstrapCompileEffectLastReader[index] = reader
                bootstrapCompileEffectEdgeReaders.append(reader)
                bootstrapCompileEffectEdgeReads.append(index)
            }
        }
        index = next[index]
    }
    mask
}

/** How many of `expression`'s children compile-time evaluation can reach:
 *  of `if (ablaAtCompileTime()) a else b` only the test and `a`, since the
 *  evaluator answers the test with true. */
@inline
fun bootstrapCompileTimeChildEnd(expression: BootstrapExpression): int {
    if (expression.kind == "if" && expression.children.size > 2) {
        val test = expression.children[0]
        if (test.kind == "call" && test.text == "ablaAtCompileTime" &&
            test.children.size == 0) return 2
    }
    expression.children.size
}

fun bootstrapExpressionCompileEffects(
    expression: BootstrapExpression,
    summary: BootstrapCompileEffectSummary
): int {
    var mask = 0
    if (expression.kind == "call" && expression.text != "move" &&
        expression.text != "Shared" && expression.text != "Mutex" &&
        expression.text != "Cell" && expression.text != "Map") {
        mask = bootstrapCompileEffectLookup(
            summary,
            expression.text,
            false
        )
    }
    if (expression.kind == "member.call") {
        mask = bootstrapCompileEffectLookup(
            summary,
            expression.text,
            true
        )
    }
    var child = 0
    while (child < bootstrapCompileTimeChildEnd(expression)) {
        mask = bootstrapCompileEffectMerge(
            mask,
            bootstrapExpressionCompileEffects(
                expression.children[child],
                summary
            )
        )
        child = child + 1
    }
    mask
}

// Syntactic receiver typing for compile-effect summaries. Method effects were
// merged across every method sharing a name, so ByteBuffer.appendText (used
// by jsonStringify) inherited Path.appendText's native filesystem effect and
// `#$jsons` was denied whenever abla/fs was in the graph. When a receiver's
// type can be read from syntax (this, typed parameters and locals, fields,
// constructor or declared-result calls) and names a concrete class or a
// builtin, the summary now resolves exactly `Type.method`; anything else
// (interfaces, generics, lambdas) keeps the conservative name-wide merge.
class BootstrapEffectTypeMap(
    val keys: array<string>,
    val values: array<string>,
    val slots: array<int>,
    val next: array<int>
)

fun bootstrapEffectTypeMapGet(map: BootstrapEffectTypeMap, key: string): string {
    var result = ""
    if (map.slots.size > 0) {
        var slot = bootstrapFunctionDeclarationHash(key)
        slot = slot - slot / map.slots.size * map.slots.size
        var index = map.slots[slot]
        while (index >= 0) {
            if (map.keys[index] == key) result = map.values[index]
            index = map.next[index]
        }
    }
    result
}

// Records key -> value in a hashed map that grows by rehashing; a key seen
// with two different values becomes ambiguous ("?") so it never resolves.
fun bootstrapEffectTypeMapPut(var map: BootstrapEffectTypeMap, key: string, value: string): void {
    if (map.keys.size * 2 + 1 > map.slots.size) {
        var capacity = if (map.slots.size == 0) 64 else map.slots.size * 2
        while (map.slots.size < capacity) map.slots.append(-1)
        var slot = 0
        while (slot < map.slots.size) {
            map.slots[slot] = -1
            slot = slot + 1
        }
        var entry = 0
        while (entry < map.keys.size) {
            var hashed = bootstrapFunctionDeclarationHash(map.keys[entry])
            hashed = hashed - hashed / map.slots.size * map.slots.size
            map.next[entry] = map.slots[hashed]
            map.slots[hashed] = entry
            entry = entry + 1
        }
    }
    var slot = bootstrapFunctionDeclarationHash(key)
    slot = slot - slot / map.slots.size * map.slots.size
    var index = map.slots[slot]
    var found = false
    while (!found && index >= 0) {
        if (map.keys[index] == key) {
            found = true
            if (map.values[index] != value) map.values[index] = "?"
        }
        index = map.next[index]
    }
    if (!found) {
        map.keys.append(key)
        map.values.append(value)
        map.next.append(map.slots[slot])
        map.slots[slot] = map.keys.size - 1
    }
    return
}

fun bootstrapEffectNormalizeType(type: string): string {
    var result = type
    while (result.size > 0 && (result[result.size - 1] == 63 ||
        result[result.size - 1] == 32)) result = result.slice(0, result.size - 1)
    while (result.size > 0 && result[0] == 32) result = result.slice(1, result.size)
    result
}

fun bootstrapBuildEffectTypeMap(
    declarations: array<BootstrapDeclaration>
): BootstrapEffectTypeMap {
    val map = BootstrapEffectTypeMap([], [], [], [])
    var index = 0
    while (index < declarations.size) {
        val declaration = declarations[index]
        if (declaration.kind == "class" || declaration.kind == "interface" ||
            declaration.kind == "type") {
            bootstrapEffectTypeMapPut(map, "type:${declaration.name}", declaration.kind)
            var field = 0
            while (field < declaration.parameters.size &&
                field < declaration.parameterTypes.size) {
                if (field < declaration.parameterKinds.size &&
                    (declaration.parameterKinds[field] == "val" ||
                     declaration.parameterKinds[field] == "var")) {
                    bootstrapEffectTypeMapPut(
                        map,
                        "field:${declaration.name}.${declaration.parameters[field]}",
                        bootstrapEffectNormalizeType(declaration.parameterTypes[field])
                    )
                }
                field = field + 1
            }
            var method = 0
            while (method < declaration.methods.size) {
                bootstrapEffectTypeMapPut(
                    map,
                    "method:${declaration.name}.${declaration.methods[method].name}",
                    bootstrapEffectNormalizeType(declaration.methods[method].resultType)
                )
                method = method + 1
            }
        }
        if (declaration.kind == "fun" || declaration.kind == "compile.fun" ||
            declaration.kind == "extern") {
            val result = bootstrapEffectNormalizeType(declaration.resultType)
            if (declaration.extensionOwner != "") {
                bootstrapEffectTypeMapPut(
                    map,
                    "method:${declaration.extensionOwner}.${declaration.name}", result
                )
            } else bootstrapEffectTypeMapPut(map, "fun:${declaration.name}", result)
        }
        index = index + 1
    }
    map
}

fun bootstrapEffectUsableType(type: string): bool =
    type != "" && type != "?" && type != "any" && type != "void"

// Concrete receivers whose method calls dispatch statically.
fun bootstrapEffectPreciseType(map: BootstrapEffectTypeMap, type: string): bool {
    if (!bootstrapEffectUsableType(type)) return false
    val kind = bootstrapEffectTypeMapGet(map, "type:$type")
    if (kind == "class" || kind == "type") return true
    type == "string" || type == "int" || type == "bool" || type == "char" ||
        type == "i8" || type == "i16" || type == "i32" || type == "i64" ||
        type == "u8" || type == "u16" || type == "u32" || type == "u64" ||
        type == "f32" || type == "f64" ||
        (type.size > 6 && type.slice(0, 6) == "array<")
}

fun bootstrapEffectScopeType(names: array<string>, types: array<string>, name: string): string {
    var result = ""
    var index = 0
    while (index < names.size) {
        if (names[index] == name) {
            result = if (result == "" || result == types[index]) types[index] else "?"
        }
        index = index + 1
    }
    result
}

fun bootstrapEffectExpressionType(
    expression: BootstrapExpression,
    map: BootstrapEffectTypeMap,
    names: array<string>,
    types: array<string>,
    owner: string
): string {
    var result = ""
    if (expression.kind == "identifier") {
        result = if (expression.text == "this") owner
            else bootstrapEffectScopeType(names, types, expression.text)
    } else if (expression.kind == "string" || expression.kind == "string.template") {
        result = "string"
    } else if (expression.kind == "member" && expression.children.size == 1) {
        val base = bootstrapEffectExpressionType(expression.children[0], map, names, types, owner)
        if (bootstrapEffectUsableType(base)) {
            result = bootstrapEffectTypeMapGet(map, "field:$base.${expression.text}")
        }
    } else if (expression.kind == "call") {
        val kind = bootstrapEffectTypeMapGet(map, "type:${expression.text}")
        result = if (kind == "class") expression.text
            else bootstrapEffectTypeMapGet(map, "fun:${expression.text}")
    } else if (expression.kind == "member.call" && expression.children.size > 0) {
        val base = bootstrapEffectExpressionType(expression.children[0], map, names, types, owner)
        if (bootstrapEffectUsableType(base)) {
            result = bootstrapEffectTypeMapGet(map, "method:$base.${expression.text}")
        }
    }
    if (bootstrapEffectUsableType(result)) result else ""
}

// Parameters plus every local of a body with a declared or inferable type.
fun bootstrapCollectEffectLocals(
    expression: BootstrapExpression,
    map: BootstrapEffectTypeMap,
    var names: array<string>,
    var types: array<string>,
    owner: string
): void {
    if ((expression.kind == "local.val" || expression.kind == "local.var") &&
        expression.children.size >= 2) {
        var type = bootstrapEffectNormalizeType(expression.children[1].text)
        if (type == "") {
            type = bootstrapEffectExpressionType(expression.children[0], map, names, types, owner)
        }
        names.append(expression.text)
        types.append(if (type == "") "?" else type)
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapCollectEffectLocals(expression.children[child], map, names, types, owner)
        child = child + 1
    }
}

fun bootstrapCollectDelegatedNames(
    expression: BootstrapExpression,
    var names: array<string>
): void {
    if ((expression.kind == "local.val" ||
         expression.kind == "local.var") &&
        expression.children.size > 0 &&
        expression.children[0].kind == "delegate.initializer" &&
        !bootstrapAffineNamesContain(names, expression.text)) {
        names.append(expression.text)
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapCollectDelegatedNames(expression.children[child], names)
        child = child + 1
    }
}

// The bindings in scope at a node, as bootstrapEffectBind keys: each name's
// keys ("\n"-separated), and an undo log, so a block binds each local in O(1)
// and drops them all when it ends (truncate) instead of copying its scope.
class BootstrapEffectScope(
    val names: Map<string, string>,
    val undoNames: array<string>,
    // What each logged name meant before ("" none).
    val undoValues: array<string>
) {
    /** Binds `keys`: each replaces what its name meant before. */
    fun bind(keys: array<string>): void {
        var index = 0
        while (index < keys.size) {
            val name = bootstrapEffectKeyName(keys[index])
            // (Keys of one name bound together are all bound.)
            var value = ""
            var same = 0
            while (same < keys.size) {
                if (bootstrapEffectKeyName(keys[same]) == name) {
                    value = if (value == "") keys[same] else "$value\n${keys[same]}"
                }
                same = same + 1
            }
            val before = this.names.get(name)
            this.undoNames.append(name)
            this.undoValues.append(if (before != null) before else "")
            this.names.set(name, value)
            index = index + 1
        }
        return
    }

    /** Whether `key` (of `name`) is bound. */
    fun binds(name: string, key: string): bool {
        val value = this.names.get(name)
        if (value == null) return false
        if (value == key) return true
        // (Several keys: one per line.)
        var begin = 0
        while (begin <= value.size) {
            var end = begin
            while (end < value.size && value[end] != 10) end = end + 1
            if (value.slice(begin, end) == key) return true
            begin = end + 1
        }
        false
    }

    /** Undoes the bindings made since the log had `mark` entries. */
    fun truncate(mark: int): void {
        while (this.undoNames.size > mark) {
            val last = this.undoNames.size - 1
            if (this.undoValues[last] == "") this.names.remove(this.undoNames[last])
            else this.names.set(this.undoNames[last], this.undoValues[last])
            this.undoNames.truncate(last)
            this.undoValues.truncate(last)
        }
        return
    }
}

fun bootstrapExpressionDelegatedCompileEffects(
    expression: BootstrapExpression,
    summary: BootstrapCompileEffectSummary,
    delegatedNames: array<string>,
    typeMap: BootstrapEffectTypeMap = BootstrapEffectTypeMap([], [], [], []),
    scopeNames: array<string> = [],
    scopeTypes: array<string> = [],
    owner: string = "",
    bound: array<string> = []
): int {
    val scope = BootstrapEffectScope(Map(), [], [])
    scope.bind(bound)
    bootstrapDelegatedCompileEffectsIn(
        expression, summary, delegatedNames, typeMap, scopeNames, scopeTypes,
        owner, scope
    )
}

fun bootstrapDelegatedCompileEffectsIn(
    expression: BootstrapExpression,
    summary: BootstrapCompileEffectSummary,
    delegatedNames: array<string>,
    typeMap: BootstrapEffectTypeMap,
    scopeNames: array<string>,
    scopeTypes: array<string>,
    owner: string,
    var bound: BootstrapEffectScope
): int {
    var mask = 0
    if (expression.kind == "identifier" &&
        bootstrapAffineNamesContain(delegatedNames, expression.text)) {
        mask = bootstrapCompileEffectLookup(summary, "getValue", true)
    }
    if (expression.kind == "assign" &&
        bootstrapAffineNamesContain(delegatedNames, expression.text)) {
        mask = bootstrapCompileEffectLookup(summary, "setValue", true)
    }
    // A call that a function-typed name in scope there takes (a parameter,
    // an earlier local of the block, a lambda parameter, with that many
    // parameters) calls that value, not the top-level function of that name.
    if (expression.kind == "call" && expression.text != "move" &&
        expression.text != "Shared" && expression.text != "Mutex" &&
        expression.text != "Cell" && expression.text != "Map" &&
        !bound.binds(expression.text, "${expression.text}#${expression.children.size}")) {
        mask = bootstrapCompileEffectMerge(mask, bootstrapCompileEffectLookup(
            summary,
            expression.text,
            false
        ))
    }
    if (expression.kind == "member.call") {
        val receiver = if (expression.children.size > 0) bootstrapEffectExpressionType(
            expression.children[0], typeMap, scopeNames, scopeTypes, owner
        ) else ""
        if (bootstrapEffectPreciseType(typeMap, receiver)) {
            mask = bootstrapCompileEffectMerge(mask, bootstrapCompileEffectMerge(
                bootstrapCompileBuiltinEffect(expression.text),
                bootstrapCompileEffectLookup(summary, "$receiver.${expression.text}", false)
            ))
        } else mask = bootstrapCompileEffectMerge(mask, bootstrapCompileEffectLookup(
            summary,
            expression.text,
            true
        ))
    }
    var begin = 0
    var end = bootstrapCompileTimeChildEnd(expression)
    if (expression.kind == "delegate.project") end = 0
    if (expression.kind == "delegate.assign") begin = 1
    if (expression.kind == "delegate.initializer") end = 1
    // What the children see: a lambda's parameters and a loop's variable in
    // its body, and each local from the statement after it on. Read only once
    // a binder extends it (a new array), so it starts as no array of its own.
    // (Bound while the children are walked, and undone after.)
    val mark = bound.undoNames.size
    var parameters = 0
    if (expression.kind == "lambda" || expression.kind == "lambda.move") {
        parameters = expression.children.size - 1
        bound.bind(bootstrapEffectBinderKeys(expression.children, parameters))
    }
    var child = begin
    while (child < end) {
        if (child == 1 && expression.kind == "for") {
            bound.bind(bootstrapEffectBinderKeys([expression], 1))
        }
        if (child >= parameters) {
            val childMask = bootstrapDelegatedCompileEffectsIn(
                expression.children[child], summary, delegatedNames, typeMap,
                scopeNames, scopeTypes, owner, bound
            )
            mask = bootstrapCompileEffectMerge(mask, childMask)
        }
        val statement = expression.children[child]
        if (statement.kind == "local.val" || statement.kind == "local.var") {
            bound.bind(bootstrapEffectBinderKeys([statement], 1))
        }
        child = child + 1
    }
    bound.truncate(mark)
    mask
}

/** `name#arity` for a binding of function type by its syntax, else `name#-`
 *  (the name, but nothing a call can be sure to reach). */
fun bootstrapEffectBindingKey(name: string, type: string): string {
    val normalized = bootstrapNormalizeType(type)
    if (bootstrapIsFunctionType(normalized)) {
        return "$name#${bootstrapFunctionParameterCount(normalized)}"
    }
    "$name#-"
}

/** What the first `count` of `binders` bind: a lambda parameter or local by
 *  its declared type (a local initialized with a lambda by that lambda's
 *  parameters), a loop variable as no function. */
fun bootstrapEffectBinderKey(binder: BootstrapExpression): string {
    if (binder.kind == "lambda.parameter" && binder.children.size > 0) {
        return bootstrapEffectBindingKey(binder.text, binder.children[0].text)
    }
    if ((binder.kind == "local.val" || binder.kind == "local.var") &&
        binder.children.size > 1 && binder.children[1].text != "inferred") {
        return bootstrapEffectBindingKey(binder.text, binder.children[1].text)
    }
    if ((binder.kind == "local.val" || binder.kind == "local.var") &&
        binder.children.size > 0 &&
        (binder.children[0].kind == "lambda" || binder.children[0].kind == "lambda.move")) {
        return "${binder.text}#${binder.children[0].children.size - 1}"
    }
    "${binder.text}#-"
}

/** `bound` with the first `count` of `binders` bound: each replaces what its
 *  name meant before. */
/** What the first `count` of `binders` bind, as keys. */
fun bootstrapEffectBinderKeys(
    binders: array<BootstrapExpression>,
    count: int
): array<string> {
    val keys: array<string> = []
    var index = 0
    while (index < count && index < binders.size) {
        keys.append(bootstrapEffectBinderKey(binders[index]))
        index = index + 1
    }
    keys
}

fun bootstrapEffectKeyName(key: string): string {
    var index = key.size - 1
    while (index > 0 && key[index] != 35) index = index - 1
    key.slice(0, index)
}

/** What `declaration`'s parameters bind, as bootstrapEffectBind keys. */
fun bootstrapEffectParameterKeys(declaration: BootstrapDeclaration): array<string> {
    val keys: array<string> = []
    var index = 0
    while (index < declaration.parameters.size) {
        keys.append(bootstrapEffectBindingKey(
            declaration.parameters[index],
            if (index < declaration.parameterTypes.size) declaration.parameterTypes[index] else ""
        ))
        index = index + 1
    }
    keys
}

fun bootstrapBuildCompileEffectSummary(
    declarations: array<BootstrapDeclaration>
): BootstrapCompileEffectSummary {
    val names: array<string> = []
    val methodNames: array<string> = []
    val masks: array<int> = []
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (declaration.kind == "fun" ||
            declaration.kind == "compile.fun" ||
            declaration.kind == "extern") {
            var name = declaration.name
            var methodName = ""
            if (declaration.extensionOwner != "") {
                name = "${declaration.extensionOwner}.${declaration.name}"
                methodName = declaration.name
            }
            names.append(name)
            methodNames.append(methodName)
            var mask = 0
            if (declaration.kind == "extern") {
                mask = bootstrapCompileExternalEffect(declaration)
            } else if (bootstrapCompileHostProvider(declaration)) {
                mask = bootstrapCompileDeclarationProviderEffect(declaration)
            } else if (bootstrapCompileDeclarationSourceClass(declaration) == 3) {
                // The runtime's own code: its memory, its platform calls.
                mask = BOOTSTRAP_COMPILE_RAW_MEMORY
            }
            masks.append(mask)
        }
        var methodIndex = 0
        while (methodIndex < declaration.methods.size) {
            val method = declaration.methods[methodIndex]
            names.append("${declaration.name}.${method.name}")
            methodNames.append(method.name)
            var mask = 0
            if (method.kind == "extern") {
                mask = bootstrapCompileExternalEffect(method)
            } else if ((if (method.sourceIdentity != "")
                bootstrapCompileDeclarationSourceClass(method)
                else bootstrapCompileDeclarationSourceClass(declaration)) == 3) {
                mask = BOOTSTRAP_COMPILE_RAW_MEMORY
            }
            masks.append(mask)
            methodIndex = methodIndex + 1
        }
        declarationIndex = declarationIndex + 1
    }
    var effectIndexCapacity = 8
    while (effectIndexCapacity < names.size * 2 + 1) {
        effectIndexCapacity = effectIndexCapacity * 2
    }
    val nameSlots: array<int> = []
    val methodSlots: array<int> = []
    var effectSlot = 0
    while (effectSlot < effectIndexCapacity) {
        nameSlots.append(-1)
        methodSlots.append(-1)
        effectSlot = effectSlot + 1
    }
    val nameNext: array<int> = []
    val methodNext: array<int> = []
    var effectEntry = 0
    while (effectEntry < names.size) {
        var nameSlot = bootstrapFunctionDeclarationHash(names[effectEntry])
        nameSlot = nameSlot - nameSlot / effectIndexCapacity *
            effectIndexCapacity
        nameNext.append(nameSlots[nameSlot])
        nameSlots[nameSlot] = effectEntry

        var methodNextEntry = -1
        if (methodNames[effectEntry] != "") {
            var methodSlot = bootstrapFunctionDeclarationHash(
                methodNames[effectEntry]
            )
            methodSlot = methodSlot - methodSlot / effectIndexCapacity *
                effectIndexCapacity
            methodNextEntry = methodSlots[methodSlot]
            methodSlots[methodSlot] = effectEntry
        }
        methodNext.append(methodNextEntry)
        effectEntry = effectEntry + 1
    }
    val summary = BootstrapCompileEffectSummary(
        names,
        methodNames,
        masks,
        nameSlots,
        nameNext,
        methodSlots,
        methodNext
    )
    val globalDelegatedNames: array<string> = []
    declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (bootstrapDeclarationIsValue(declaration.kind) &&
            declaration.expression.kind == "delegate.initializer") {
            globalDelegatedNames.append(declaration.name)
        }
        declarationIndex = declarationIndex + 1
    }
    // Receiver-typing scopes, one per summary entry (same order as `masks`).
    val typeMap = bootstrapBuildEffectTypeMap(declarations)
    val entryScopeNames: array<array<string>> = []
    val entryScopeTypes: array<array<string>> = []
    val entryOwners: array<string> = []
    val entryExpressions: array<BootstrapExpression> = []
    val entryWalked: array<bool> = []
    val entryParameters: array<array<string>> = []
    val entryClasses: array<int> = []
    declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (declaration.kind == "fun" ||
            declaration.kind == "compile.fun" ||
            declaration.kind == "extern") {
            val scopeNames: array<string> = []
            val scopeTypes: array<string> = []
            var parameter = 0
            while (parameter < declaration.parameters.size &&
                parameter < declaration.parameterTypes.size) {
                scopeNames.append(declaration.parameters[parameter])
                scopeTypes.append(bootstrapEffectNormalizeType(declaration.parameterTypes[parameter]))
                parameter = parameter + 1
            }
            if (declaration.kind != "extern") {
                bootstrapCollectEffectLocals(
                    declaration.expression, typeMap, scopeNames, scopeTypes,
                    declaration.extensionOwner
                )
            }
            entryScopeNames.append(scopeNames)
            entryScopeTypes.append(scopeTypes)
            entryOwners.append(declaration.extensionOwner)
            entryExpressions.append(declaration.expression)
            entryClasses.append(bootstrapCompileDeclarationSourceClass(declaration))
            entryWalked.append(declaration.kind != "extern" &&
                !bootstrapCompileHostProvider(declaration) &&
                entryClasses[entryClasses.size - 1] != 3)
            entryParameters.append(bootstrapEffectParameterKeys(declaration))
        }
        var methodIndex = 0
        while (methodIndex < declaration.methods.size) {
            val method = declaration.methods[methodIndex]
            val scopeNames: array<string> = []
            val scopeTypes: array<string> = []
            var parameter = 0
            while (parameter < method.parameters.size &&
                parameter < method.parameterTypes.size) {
                scopeNames.append(method.parameters[parameter])
                scopeTypes.append(bootstrapEffectNormalizeType(method.parameterTypes[parameter]))
                parameter = parameter + 1
            }
            // Class fields are in scope inside methods, as `this.x` or `x`.
            var field = 0
            while (field < declaration.parameters.size &&
                field < declaration.parameterTypes.size) {
                scopeNames.append(declaration.parameters[field])
                scopeTypes.append(bootstrapEffectNormalizeType(declaration.parameterTypes[field]))
                field = field + 1
            }
            if (method.kind != "extern") {
                bootstrapCollectEffectLocals(
                    method.expression, typeMap, scopeNames, scopeTypes, declaration.name
                )
            }
            entryScopeNames.append(scopeNames)
            entryScopeTypes.append(scopeTypes)
            entryOwners.append(declaration.name)
            entryExpressions.append(method.expression)
            val methodClass = if (method.sourceIdentity != "")
                bootstrapCompileDeclarationSourceClass(method)
            else bootstrapCompileDeclarationSourceClass(declaration)
            entryClasses.append(methodClass)
            entryWalked.append(method.kind != "extern" && methodClass != 3)
            entryParameters.append(bootstrapEffectParameterKeys(method))
            methodIndex = methodIndex + 1
        }
        declarationIndex = declarationIndex + 1
    }
    // Effects flow from callees to their callers until nothing changes. The
    // first pass walks every body in order and records which entries each
    // walk read; after it, only the readers of an entry whose effects grew
    // are walked again. A walk only merges what it reads, so this reaches the
    // fixed point that walking every body until a pass changes nothing does.
    val entries = masks.size
    bootstrapCompileEffectLastReader = []
    bootstrapCompileEffectEdgeReaders = []
    bootstrapCompileEffectEdgeReads = []
    val schedule: array<int> = []
    val queued: array<bool> = []
    var entry = 0
    while (entry < entries) {
        bootstrapCompileEffectLastReader.append(-1)
        schedule.append(entry)
        queued.append(true)
        entry = entry + 1
    }
    val grewFirst: array<int> = []
    val readerStarts: array<int> = []
    val readers: array<int> = []
    var head = 0
    while (head < schedule.size) {
        entry = schedule[head]
        head = head + 1
        queued[entry] = false
        var grew = false
        if (entryWalked[entry]) {
            bootstrapCompileEffectReading = if (head <= entries) entry else -1
            val expression = entryExpressions[entry]
            val delegatedNames: array<string> = []
            var globalDelegate = 0
            while (globalDelegate < globalDelegatedNames.size) {
                delegatedNames.append(globalDelegatedNames[globalDelegate])
                globalDelegate = globalDelegate + 1
            }
            bootstrapCollectDelegatedNames(expression, delegatedNames)
            val inferred = bootstrapExpressionDelegatedCompileEffects(
                expression,
                summary,
                delegatedNames,
                typeMap,
                entryScopeNames[entry],
                entryScopeTypes[entry],
                entryOwners[entry],
                entryParameters[entry]
            )
            val merged = bootstrapCompileContainEffects(
                bootstrapCompileEffectMerge(masks[entry], inferred),
                entryClasses[entry]
            )
            grew = merged != masks[entry]
            masks[entry] = merged
        }
        if (grew && head <= entries) grewFirst.append(entry)
        else if (grew) {
            var reader = readerStarts[entry]
            while (reader < readerStarts[entry + 1]) {
                if (!queued[readers[reader]]) {
                    queued[readers[reader]] = true
                    schedule.append(readers[reader])
                }
                reader = reader + 1
            }
        }
        if (head == entries) {
            // The first pass is over: index the readers of each entry, then
            // queue those of the entries that grew in it.
            bootstrapCompileEffectReading = -1
            var start = 0
            while (start <= entries) {
                readerStarts.append(0)
                start = start + 1
            }
            var edge = 0
            while (edge < bootstrapCompileEffectEdgeReads.size) {
                val read = bootstrapCompileEffectEdgeReads[edge]
                readerStarts[read + 1] = readerStarts[read + 1] + 1
                edge = edge + 1
            }
            start = 0
            while (start < entries) {
                readerStarts[start + 1] = readerStarts[start + 1] + readerStarts[start]
                start = start + 1
            }
            val filled: array<int> = []
            start = 0
            while (start < entries) {
                filled.append(readerStarts[start])
                start = start + 1
            }
            edge = 0
            while (edge < bootstrapCompileEffectEdgeReads.size) {
                readers.append(0)
                edge = edge + 1
            }
            edge = 0
            while (edge < bootstrapCompileEffectEdgeReads.size) {
                val read = bootstrapCompileEffectEdgeReads[edge]
                readers[filled[read]] = bootstrapCompileEffectEdgeReaders[edge]
                filled[read] = filled[read] + 1
                edge = edge + 1
            }
            for (first in grewFirst) {
                var reader = readerStarts[first]
                while (reader < readerStarts[first + 1]) {
                    if (!queued[readers[reader]]) {
                        queued[readers[reader]] = true
                        schedule.append(readers[reader])
                    }
                    reader = reader + 1
                }
            }
        }
    }
    bootstrapCompileEffectReading = -1
    bootstrapCompileEffectLastReader = []
    bootstrapCompileEffectEdgeReaders = []
    bootstrapCompileEffectEdgeReads = []
    summary
}

fun bootstrapCompileEffectName(mask: int): string {
    var name = ""
    if (bootstrapCompileEffectHas(mask, 4)) name = "filesystem.read"
    else if (bootstrapCompileEffectHas(mask, 8)) name = "filesystem.write"
    else if (bootstrapCompileEffectHas(mask, 16)) name = "environment"
    else if (bootstrapCompileEffectHas(mask, 32)) name = "process.io"
    else if (bootstrapCompileEffectHas(mask, 64)) name = "network"
    else if (bootstrapCompileEffectHas(mask, 128)) name = "clock"
    else if (bootstrapCompileEffectHas(mask, 256)) name = "random"
    else if (bootstrapCompileEffectHas(mask, 512)) name = "trusted.native"
    else if (bootstrapCompileEffectHas(mask, BOOTSTRAP_COMPILE_TRANSFORM_LIBRARY)) {
        name = "transform.library"
    }
    name
}

// The capability to change the standard library's code from compile-time code
// (a body replaced, an extension field removed): checked when the change is
// asked for, since its target is known only then.
val BOOTSTRAP_COMPILE_TRANSFORM_LIBRARY = 2048

fun bootstrapFirstCompileEffect(mask: int): int {
    var result = 0
    var effect = 4
    while (result == 0 && effect <= 512) {
        if (bootstrapCompileEffectHas(mask, effect)) result = effect
        effect = effect * 2
    }
    result
}

// Search a call graph rather than expanding every recursive call path. A
// declaration reached at an equal or greater depth cannot reveal a new path;
// revisit it only when a shorter route leaves more of the diagnostic depth budget.
// For a call path's diagnostic: trusted.native is also reached through raw
// memory a program's code takes from the unsafe boundary.
fun bootstrapCompileEffectReaches(mask: int, effect: int): bool =
    bootstrapCompileEffectHas(mask, effect) ||
    (effect == 512 && bootstrapCompileEffectHas(mask, BOOTSTRAP_COMPILE_RAW_MEMORY))

fun bootstrapCompileEffectPathVisit(
    key: string,
    depth: int,
    var keys: array<string>,
    var depths: array<int>
): bool {
    var index = 0
    while (index < keys.size) {
        if (keys[index] == key) {
            if (depth >= depths[index]) return false
            depths[index] = depth
            return true
        }
        index = index + 1
    }
    keys.append(key)
    depths.append(depth)
    true
}

fun bootstrapCompileEffectPath(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    summary: BootstrapCompileEffectSummary,
    effect: int,
    depth: int
): string = bootstrapCompileEffectPathSearch(
    expression, declarations, summary, effect, depth, [], []
)

fun bootstrapCompileEffectPathSearch(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    summary: BootstrapCompileEffectSummary,
    effect: int,
    depth: int,
    var visitedKeys: array<string>,
    var visitedDepths: array<int>
): string {
    var path = ""
    if (depth < 32 && expression.kind == "call") {
        var declaration = 0
        while (path == "" && declaration < declarations.size) {
            val candidate = declarations[declaration]
            if (candidate.extensionOwner == "" &&
                candidate.name == expression.text) {
                if (candidate.kind == "extern" &&
                    bootstrapCompileEffectReaches(
                        bootstrapCompileExternalEffect(candidate),
                        effect
                    )) path = candidate.name
                val provider = bootstrapCompileHostProvider(candidate)
                if (provider && bootstrapCompileEffectReaches(
                    bootstrapCompileDeclarationProviderEffect(candidate), effect
                )) path = candidate.name
                if (!provider && (candidate.kind == "fun" ||
                     candidate.kind == "compile.fun") &&
                    bootstrapCompileEffectReaches(
                        bootstrapCompileEffectLookup(
                            summary,
                            candidate.name,
                            false
                        ),
                        effect
                    ) && bootstrapCompileEffectPathVisit(
                        "function:$declaration", depth, visitedKeys, visitedDepths
                    )) {
                    val nested = bootstrapCompileEffectPathSearch(
                        candidate.expression,
                        declarations,
                        summary,
                        effect,
                        depth + 1,
                        visitedKeys,
                        visitedDepths
                    )
                    if (nested != "") path = "${candidate.name}->$nested"
                }
            }
            declaration = declaration + 1
        }
    }
    if (depth < 32 && path == "" &&
        expression.kind == "member.call") {
        var declaration = 0
        while (path == "" && declaration < declarations.size) {
            val owner = declarations[declaration]
            var method = 0
            while (path == "" && method < owner.methods.size) {
                val candidate = owner.methods[method]
                if (candidate.name == expression.text &&
                    bootstrapCompileEffectReaches(
                        bootstrapCompileEffectLookup(
                            summary,
                            candidate.name,
                            true
                        ),
                        effect
                    ) && bootstrapCompileEffectPathVisit(
                        "method:$declaration:$method", depth, visitedKeys, visitedDepths
                    )) {
                    val nested = bootstrapCompileEffectPathSearch(
                        candidate.expression,
                        declarations,
                        summary,
                        effect,
                        depth + 1,
                        visitedKeys,
                        visitedDepths
                    )
                    if (nested != "") {
                        path = "${owner.name}.${candidate.name}->$nested"
                    }
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
    }
    // An extension function called as a method (`root.createDirectories()`),
    // named as its owner's method in the path.
    if (depth < 32 && path == "" &&
        expression.kind == "member.call") {
        var declaration = 0
        while (path == "" && declaration < declarations.size) {
            val candidate = declarations[declaration]
            if (candidate.extensionOwner != "" && candidate.name == expression.text) {
                val name = "${candidate.extensionOwner}.${candidate.name}"
                val provider = bootstrapCompileHostProvider(candidate)
                if (candidate.kind == "extern" &&
                    bootstrapCompileEffectReaches(
                        bootstrapCompileExternalEffect(candidate), effect
                    )) path = name
                if (provider && bootstrapCompileEffectReaches(
                    bootstrapCompileDeclarationProviderEffect(candidate), effect
                )) path = name
                if (!provider && (candidate.kind == "fun" ||
                     candidate.kind == "compile.fun") &&
                    bootstrapCompileEffectReaches(
                        bootstrapCompileEffectLookup(summary, name, false), effect
                    ) && bootstrapCompileEffectPathVisit(
                        "extension:$declaration", depth, visitedKeys, visitedDepths
                    )) {
                    val nested = bootstrapCompileEffectPathSearch(
                        candidate.expression,
                        declarations,
                        summary,
                        effect,
                        depth + 1,
                        visitedKeys,
                        visitedDepths
                    )
                    if (nested != "") path = "$name->$nested"
                }
            }
            declaration = declaration + 1
        }
    }
    var child = 0
    while (path == "" && child < bootstrapCompileTimeChildEnd(expression)) {
        path = bootstrapCompileEffectPathSearch(
            expression.children[child],
            declarations,
            summary,
            effect,
            depth,
            visitedKeys,
            visitedDepths
        )
        child = child + 1
    }
    path
}

fun bootstrapCompileEffectFromName(name: string): int {
    var effect = 0
    if (name == "filesystem.read") effect = 4
    else if (name == "filesystem.write") effect = 8
    else if (name == "environment") effect = 16
    else if (name == "process.io") effect = 32
    else if (name == "network") effect = 64
    else if (name == "clock") effect = 128
    else if (name == "random") effect = 256
    else if (name == "trusted.native") effect = 512
    else if (name == "transform.library") effect = BOOTSTRAP_COMPILE_TRANSFORM_LIBRARY
    effect
}

fun bootstrapBuildCompileEffectRequests(
    parsed: BootstrapParseResult
): int {
    var requests = 0
    var action = 0
    while (action < parsed.actions.size) {
        val expression = parsed.actions[action]
        if (expression.kind == "compile" &&
            expression.children.size == 1) {
            val call = expression.children[0]
            if (call.kind == "call" && call.text == "compilerGrant" &&
                call.children.size == 1 &&
                call.children[0].kind == "string") {
                requests = bootstrapCompileEffectMerge(
                    requests,
                    bootstrapCompileEffectFromName(call.children[0].text)
                )
            }
        }
        action = action + 1
    }
    requests
}

fun bootstrapBuildCompileEffectAuthorizations(
    parsed: BootstrapParseResult
): int {
    var authorizations = 0
    var action = 0
    while (action < parsed.actions.size) {
        val expression = parsed.actions[action]
        if (expression.kind == "compile.capability.authorization") {
            authorizations = bootstrapCompileEffectMerge(
                authorizations,
                bootstrapCompileEffectFromName(expression.text)
            )
        }
        action = action + 1
    }
    authorizations
}

fun bootstrapBuildCompileEffectGrants(
    requests: int,
    authorizations: int
): int {
    var grants = 0
    var effect = 4
    while (effect <= BOOTSTRAP_COMPILE_TRANSFORM_LIBRARY) {
        if (bootstrapCompileEffectHas(requests, effect) &&
            bootstrapCompileEffectHas(authorizations, effect)) {
            grants = grants + effect
        }
        effect = effect * 2
    }
    grants
}

fun bootstrapDeniedCompileEffects(effects: int, grants: int): int {
    var denied = 0
    var effect = 4
    while (effect <= 512) {
        if (bootstrapCompileEffectHas(effects, effect) &&
            !bootstrapCompileEffectHas(grants, effect)) {
            denied = denied + effect
        }
        effect = effect * 2
    }
    denied
}

// A set of strings, open-addressed (keys in insertion order, slots hold their indices).
class BootstrapStringSet(val keys: array<string>, var slots: array<int>) {
    fun slotOf(key: string): int {
        var slot = bootstrapFunctionDeclarationHash(key)
        slot = slot - slot / this.slots.size * this.slots.size
        while (this.slots[slot] >= 0 && this.keys[this.slots[slot]] != key) {
            slot = slot + 1
            if (slot == this.slots.size) slot = 0
        }
        slot
    }

    fun contains(key: string): bool = this.slots[this.slotOf(key)] >= 0

    /** The index of `key` in `keys`, or -1. */
    fun indexOf(key: string): int = this.slots[this.slotOf(key)]

    fun add(key: string): void {
        if ((this.keys.size + 1) * 2 >= this.slots.size) {
            val grown: array<int> = []
            var slot = 0
            while (slot < this.slots.size * 2) {
                grown.append(-1)
                slot = slot + 1
            }
            this.slots = grown
            var entry = 0
            while (entry < this.keys.size) {
                this.slots[this.slotOf(this.keys[entry])] = entry
                entry = entry + 1
            }
        }
        val slot = this.slotOf(key)
        if (this.slots[slot] < 0) {
            this.slots[slot] = this.keys.size
            this.keys.append(key)
        }
        return
    }
}

fun bootstrapStringSet(): BootstrapStringSet =
    BootstrapStringSet([], [-1, -1, -1, -1, -1, -1, -1, -1])

fun bootstrapStringSetCopy(source: BootstrapStringSet): BootstrapStringSet {
    val keys: array<string> = []
    for (key in source.keys) keys.append(key)
    val slots: array<int> = []
    for (slot in source.slots) slots.append(slot)
    BootstrapStringSet(keys, slots)
}

/** The bodies a pass to a fixed point walks, numbered in program order, in
 *  rounds. Walking every body in order each round until one changes nothing
 *  walks again bodies whose answer cannot change: only a body touched since
 *  its last walk (something it calls changed) is walked. One touched ahead of
 *  the body being walked is walked later in the same round, one at or behind
 *  it in the next round, so the bodies are walked, and the summary grows, in
 *  the order walking every body would give. `current` is a min-heap. */
class BootstrapBodySchedule(
    val pending: array<bool>,
    val current: array<int>,
    val next: array<int>,
    var at: int
) {
    /** The next body of this round, or -1 once the round is over. */
    fun take(): int {
        if (this.current.size == 0) return -1
        val body = this.current[0]
        val last = this.current[this.current.size - 1]
        this.current.truncate(this.current.size - 1)
        if (this.current.size > 0) {
            var slot = 0
            var settled = false
            while (!settled) {
                var child = slot * 2 + 1
                if (child + 1 < this.current.size &&
                    this.current[child + 1] < this.current[child]) child = child + 1
                if (child < this.current.size && this.current[child] < last) {
                    this.current[slot] = this.current[child]
                    slot = child
                } else settled = true
            }
            this.current[slot] = last
        }
        this.pending[body] = false
        this.at = body
        body
    }

    fun touch(body: int): void {
        if (!this.pending[body]) {
            this.pending[body] = true
            if (body > this.at) {
                this.current.append(body)
                var slot = this.current.size - 1
                while (slot > 0 && this.current[(slot - 1) / 2] > body) {
                    this.current[slot] = this.current[(slot - 1) / 2]
                    slot = (slot - 1) / 2
                }
                this.current[slot] = body
            } else this.next.append(body)
        }
        return
    }

    /** Starts the next round: false when no body is left to walk. */
    fun nextRound(): bool {
        // (Behind none of them, each goes to this round.)
        this.at = -1
        var index = 0
        while (index < this.next.size) {
            val body = this.next[index]
            this.pending[body] = false
            this.touch(body)
            index = index + 1
        }
        this.next.truncate(0)
        this.current.size > 0
    }
}

/** A schedule whose first round walks every one of `bodies` bodies. */
fun bootstrapBodySchedule(bodies: int): BootstrapBodySchedule {
    val current: array<int> = []
    var body = 0
    while (body < bodies) {
        current.append(body)
        body = body + 1
    }
    BootstrapBodySchedule(filledArray(bodies, true), current, [], -1)
}

/** The bodies that call each name (a call's or a member call's text): once a
 *  body's summary changes, only the bodies calling it can answer differently.
 *  A name's bodies form a chain from `heads`. */
class BootstrapCallers(
    val names: BootstrapStringSet,
    val heads: array<int>,
    val bodies: array<int>,
    val next: array<int>
) {
    fun add(name: string, body: int): void {
        var index = this.names.indexOf(name)
        if (index < 0) {
            this.names.add(name)
            index = this.names.keys.size - 1
            this.heads.append(-1)
        }
        // (A body's calls are added together: one entry per name is enough.)
        if (this.heads[index] < 0 || this.bodies[this.heads[index]] != body) {
            this.bodies.append(body)
            this.next.append(this.heads[index])
            this.heads[index] = this.bodies.size - 1
        }
        return
    }

    fun collect(expression: BootstrapExpression, body: int): void {
        if (expression.kind == "call" || expression.kind == "member.call") {
            this.add(expression.text, body)
        }
        for (child in expression.children) this.collect(child, body)
        return
    }

    /** Touches every body that calls `name`, or (a method's name being
     *  `Owner.method`) any part of it after a dot. */
    fun touch(name: string, var schedule: BootstrapBodySchedule): void {
        this.touchName(name, schedule)
        var dot = 1
        while (dot < name.size) {
            if (name[dot] == 46) this.touchName(name.slice(dot + 1, name.size), schedule)
            dot = dot + 1
        }
        return
    }

    fun touchName(name: string, var schedule: BootstrapBodySchedule): void {
        val index = this.names.indexOf(name)
        if (index >= 0) {
            var entry = this.heads[index]
            while (entry >= 0) {
                schedule.touch(this.bodies[entry])
                entry = this.next[entry]
            }
        }
        return
    }
}

fun bootstrapCallers(): BootstrapCallers =
    BootstrapCallers(bootstrapStringSet(), [], [], [])

/** The callers of every body of `declarations` (each declaration's body, then
 *  each of its methods', numbered in that order), with `declarationOf` and
 *  `methodOf` (-1: the declaration's own body) filled in for each body. */
fun bootstrapCallersOf(
    declarations: array<BootstrapDeclaration>,
    var declarationOf: array<int>,
    var methodOf: array<int>
): BootstrapCallers {
    val callers = bootstrapCallers()
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        callers.collect(declaration.expression, declarationOf.size)
        declarationOf.append(declarationIndex)
        methodOf.append(-1)
        var method = 0
        while (method < declaration.methods.size) {
            callers.collect(declaration.methods[method].expression, declarationOf.size)
            declarationOf.append(declarationIndex)
            methodOf.append(method)
            method = method + 1
        }
        declarationIndex = declarationIndex + 1
    }
    callers
}

// The names lists keep their order; the sets beside them answer membership:
// `unsafe` holds unsafeNames, `unsafeMembers` every part of one after a dot
// (a member call `x.name` is unsafe when some unsafe `….name` is), and
// `heapFields` the `owner\nfield` pairs whose field holds heap memory
// (bootstrapRegionHeapFields).
class BootstrapRegionCallSummary(
    val unsafeNames: array<string>,
    val retainingReceiverNames: array<string>,
    val retainingParameterKeys: array<string>,
    val unsafe: BootstrapStringSet,
    val unsafeMembers: BootstrapStringSet,
    val retainingReceivers: BootstrapStringSet,
    val retainingParameters: BootstrapStringSet,
    val heapFields: BootstrapStringSet
)

fun bootstrapRegionAddUnsafe(var summary: BootstrapRegionCallSummary, name: string): void {
    summary.unsafeNames.append(name)
    summary.unsafe.add(name)
    var dot = 1
    while (dot < name.size) {
        if (name[dot] == 46) summary.unsafeMembers.add(name.slice(dot + 1, name.size))
        dot = dot + 1
    }
    return
}

fun bootstrapRegionAddRetainingReceiver(var summary: BootstrapRegionCallSummary, name: string): void {
    summary.retainingReceiverNames.append(name)
    summary.retainingReceivers.add(name)
    return
}

fun bootstrapRegionCallIsUnsafe(
    summary: BootstrapRegionCallSummary,
    name: string
): bool = summary.unsafe.contains(name)

fun bootstrapRegionMemberCallIsUnsafe(
    summary: BootstrapRegionCallSummary,
    name: string
): bool = summary.unsafeMembers.contains(name)

fun bootstrapRegionReceiverCallIsRetaining(
    summary: BootstrapRegionCallSummary,
    owner: string,
    method: string
): bool = summary.retainingReceivers.contains("$owner.$method")

fun bootstrapRegionParameterKey(name: string, parameter: int): string =
    "$name#$parameter"

fun bootstrapRegionParameterIsRetaining(
    summary: BootstrapRegionCallSummary,
    name: string,
    parameter: int
): bool = summary.retainingParameters.contains(
    bootstrapRegionParameterKey(name, parameter)
)

fun bootstrapRegionMarkRetainingParameter(
    var summary: BootstrapRegionCallSummary,
    name: string,
    parameter: int
): bool {
    val key = bootstrapRegionParameterKey(name, parameter)
    val changed = !summary.retainingParameters.contains(key)
    if (changed) {
        summary.retainingParameterKeys.append(key)
        summary.retainingParameters.add(key)
    }
    changed
}

fun bootstrapRegionFunctionRetainsAnyParameter(
    summary: BootstrapRegionCallSummary,
    name: string,
    parameterCount: int
): bool {
    var retaining = false
    var parameter = 0
    while (parameter < parameterCount) {
        if (bootstrapRegionParameterIsRetaining(
            summary,
            name,
            parameter
        )) retaining = true
        parameter = parameter + 1
    }
    retaining
}

fun bootstrapRegionParameterIndex(
    parameters: array<string>,
    name: string
): int {
    var result = -1
    var index = 0
    while (index < parameters.size) {
        if (parameters[index] == name) result = index
        index = index + 1
    }
    result
}

// Every `owner\nfield` pair whose field holds heap memory (a `val`/`var` field
// whose type is not independent of a region): the last declaration of that
// name and its last field of that name decide.
fun bootstrapRegionHeapFields(
    declarations: array<BootstrapDeclaration>
): BootstrapStringSet {
    val pairs = bootstrapStringSet()
    val heap: array<bool> = []
    for (declaration in declarations) {
        var fieldIndex = 0
        while (fieldIndex < declaration.parameters.size) {
            if (fieldIndex < declaration.parameterTypes.size &&
                fieldIndex < declaration.parameterKinds.size &&
                (declaration.parameterKinds[fieldIndex] == "val" ||
                 declaration.parameterKinds[fieldIndex] == "var")) {
                val key = "${declaration.name}\n${declaration.parameters[fieldIndex]}"
                val known = pairs.keys.size
                pairs.add(key)
                if (pairs.keys.size > known) heap.append(false)
                heap[pairs.slots[pairs.slotOf(key)]] =
                    !bootstrapRegionResultIsIndependent(
                        bootstrapNormalizeType(
                            declaration.parameterTypes[fieldIndex]
                        )
                    )
            }
            fieldIndex = fieldIndex + 1
        }
    }
    val result = bootstrapStringSet()
    var pair = 0
    while (pair < pairs.keys.size) {
        if (heap[pair]) result.add(pairs.keys[pair])
        pair = pair + 1
    }
    result
}

fun bootstrapRegionFieldIsHeap(
    summary: BootstrapRegionCallSummary,
    owner: string,
    field: string
): bool = summary.heapFields.contains("$owner\n$field")

fun bootstrapRegionExpressionRetainsParameters(
    expression: BootstrapExpression,
    declarationName: string,
    parameters: array<string>,
    parameterTypes: array<string>,
    declarations: array<BootstrapDeclaration>,
    var summary: BootstrapRegionCallSummary
): bool {
    var changed = false
    if (expression.kind == "member.assign") {
        val root = bootstrapPlaceRootName(expression.children[0])
        val parameter = bootstrapRegionParameterIndex(parameters, root)
        if (parameter >= 0 && parameter < parameterTypes.size &&
            bootstrapRegionFieldIsHeap(
                summary,
                bootstrapNormalizeType(parameterTypes[parameter]),
                expression.text
            )) {
            changed = bootstrapRegionMarkRetainingParameter(
                summary,
                declarationName,
                parameter
            ) || changed
        }
    }
    if (expression.kind == "index.assign") {
        val root = bootstrapPlaceRootName(expression.children[0])
        val parameter = bootstrapRegionParameterIndex(parameters, root)
        if (parameter >= 0 && parameter < parameterTypes.size) {
            val type = bootstrapNormalizeType(parameterTypes[parameter])
            if (bootstrapIsArrayType(type) &&
                !bootstrapRegionResultIsIndependent(
                    bootstrapArrayElementType(type)
                )) {
                changed = bootstrapRegionMarkRetainingParameter(
                    summary,
                    declarationName,
                    parameter
                ) || changed
            }
        }
    }
    if (expression.kind == "call") {
        var argument = 0
        while (argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                expression.text,
                argument
            )) {
                val root = bootstrapPlaceRootName(
                    expression.children[argument]
                )
                val parameter = bootstrapRegionParameterIndex(
                    parameters,
                    root
                )
                if (parameter >= 0) {
                    changed = bootstrapRegionMarkRetainingParameter(
                        summary,
                        declarationName,
                        parameter
                    ) || changed
                }
            }
            argument = argument + 1
        }
    }
    if (expression.kind == "member.call") {
        val receiverRoot = bootstrapPlaceRootName(expression.children[0])
        val receiverParameter = bootstrapRegionParameterIndex(
            parameters,
            receiverRoot
        )
        var receiverType = "unknown"
        if (receiverParameter >= 0 &&
            receiverParameter < parameterTypes.size) {
            receiverType = bootstrapNormalizeType(
                parameterTypes[receiverParameter]
            )
            if ((expression.text == "append" &&
                 bootstrapIsArrayType(receiverType) &&
                 !bootstrapRegionResultIsIndependent(
                     bootstrapArrayElementType(receiverType)
                 )) ||
                (expression.text == "set" &&
                 bootstrapIsMapType(receiverType) &&
                 !bootstrapRegionResultIsIndependent(
                     bootstrapMapValueType(receiverType)
                 ))) {
                changed = bootstrapRegionMarkRetainingParameter(
                    summary,
                    declarationName,
                    receiverParameter
                ) || changed
            }
            if (bootstrapRegionReceiverCallIsRetaining(
                summary,
                receiverType,
                expression.text
            )) {
                changed = bootstrapRegionMarkRetainingParameter(
                    summary,
                    declarationName,
                    receiverParameter
                ) || changed
            }
        }
        val methodName = "$receiverType.${expression.text}"
        var argument = 1
        while (argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                methodName,
                argument - 1
            )) {
                val root = bootstrapPlaceRootName(
                    expression.children[argument]
                )
                val parameter = bootstrapRegionParameterIndex(
                    parameters,
                    root
                )
                if (parameter >= 0) {
                    changed = bootstrapRegionMarkRetainingParameter(
                        summary,
                        declarationName,
                        parameter
                    ) || changed
                }
            }
            argument = argument + 1
        }
    }
    var child = 0
    while (child < expression.children.size) {
        changed = bootstrapRegionExpressionRetainsParameters(
            expression.children[child],
            declarationName,
            parameters,
            parameterTypes,
            declarations,
            summary
        ) || changed
        child = child + 1
    }
    changed
}

fun bootstrapRegionExpressionRetainsReceiver(
    expression: BootstrapExpression,
    owner: string,
    declarations: array<BootstrapDeclaration>,
    summary: BootstrapRegionCallSummary
): bool {
    var retaining = false
    if (expression.kind == "assign" &&
        bootstrapRegionFieldIsHeap(
            summary,
            owner,
            expression.text
        )) retaining = true
    if (expression.kind == "member.assign" &&
        bootstrapPlaceRootName(expression.children[0]) == "this" &&
        bootstrapRegionFieldIsHeap(
            summary,
            owner,
            expression.text
        )) retaining = true
    if (expression.kind == "index.assign" &&
        bootstrapPlaceRootName(expression.children[0]) == "this") {
        retaining = true
    }
    if (expression.kind == "member.call" &&
        bootstrapPlaceRootName(expression.children[0]) == "this") {
        // A map field's set keeps its value too (a method named set is
        // treated the same way: conservative).
        if (expression.text == "append" || expression.text == "set") {
            retaining = true
        }
        if (bootstrapRegionReceiverCallIsRetaining(
            summary,
            owner,
            expression.text
        )) retaining = true
    }
    if (expression.kind == "call") {
        var argument = 0
        while (!retaining && argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                expression.text,
                argument
            ) && bootstrapPlaceRootName(
                expression.children[argument]
            ) == "this") retaining = true
            argument = argument + 1
        }
    }
    if (expression.kind == "member.call") {
        val receiverRoot = bootstrapPlaceRootName(expression.children[0])
        var receiverType = "unknown"
        if (receiverRoot == "this") receiverType = owner
        val methodName = "$receiverType.${expression.text}"
        var argument = 1
        while (!retaining && argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                methodName,
                argument - 1
            ) && bootstrapPlaceRootName(
                expression.children[argument]
            ) == "this") retaining = true
            argument = argument + 1
        }
    }
    var child = 0
    while (!retaining && child < expression.children.size) {
        retaining = bootstrapRegionExpressionRetainsReceiver(
            expression.children[child],
            owner,
            declarations,
            summary
        )
        child = child + 1
    }
    retaining
}

fun bootstrapRegionExpressionCallsUnsafe(
    expression: BootstrapExpression,
    summary: BootstrapRegionCallSummary
): bool {
    var unsafe = false
    if (expression.kind == "call" && expression.text != "move" &&
        expression.text != "Shared") {
        unsafe = bootstrapRegionCallIsUnsafe(summary, expression.text)
    }
    if (expression.kind == "member.call" &&
        expression.text != "append" && expression.text != "slice" &&
        expression.text != "truncate" && expression.text != "clear" &&
        expression.text != "clone" && expression.text != "get" &&
        expression.text != "downgrade" &&
        expression.text != "upgrade" &&
        expression.text != "isAlive") {
        unsafe = bootstrapRegionMemberCallIsUnsafe(
            summary,
            expression.text
        )
    }
    var child = 0
    while (!unsafe && child < expression.children.size) {
        unsafe = bootstrapRegionExpressionCallsUnsafe(
            expression.children[child],
            summary
        )
        child = child + 1
    }
    unsafe
}

fun bootstrapRegionExpressionCallsFunctionParameter(
    expression: BootstrapExpression,
    parameters: array<string>,
    parameterTypes: array<string>
): bool {
    var unsafe = false
    if (expression.kind == "call") {
        val parameter = bootstrapRegionParameterIndex(
            parameters,
            expression.text
        )
        if (parameter >= 0 && parameter < parameterTypes.size &&
            bootstrapIsFunctionType(
                bootstrapNormalizeType(parameterTypes[parameter])
            ) && !bootstrapIsNoEscapeFunctionType(
                bootstrapNormalizeType(parameterTypes[parameter])
            )) unsafe = true
    }
    var child = 0
    while (!unsafe && child < expression.children.size) {
        unsafe = bootstrapRegionExpressionCallsFunctionParameter(
            expression.children[child],
            parameters,
            parameterTypes
        )
        child = child + 1
    }
    unsafe
}

// The module values (`var`/`val` declarations) by name, with their normalized
// types: "unknown" for one whose type is left to inference and whose
// initializer is not a scalar literal.
fun bootstrapRegionModuleValues(
    declarations: array<BootstrapDeclaration>
): Map<string, string> {
    val values: Map<string, string> = Map()
    for (declaration in declarations) {
        if (declaration.kind == "var" || declaration.kind == "val") {
            var type = bootstrapNormalizeType(declaration.resultType)
            if (declaration.resultType == "" ||
                declaration.resultType == "inferred" || type == "unknown") {
                type = if (bootstrapRegionScalarLiteral(declaration.expression)) {
                    "i64"
                } else "unknown"
            }
            values.set(declaration.name, type)
        }
    }
    values
}

// A literal number or boolean, or one negated: what an untyped module value's
// initializer must be for the value to hold no heap memory (the summary runs
// before inference).
fun bootstrapRegionScalarLiteral(expression: BootstrapExpression): bool {
    var scalar = expression.kind == "integer" || expression.kind == "float" ||
        expression.kind == "true" || expression.kind == "false"
    if ((expression.kind == "unary-" || expression.kind == "unary!") &&
        expression.children.size == 1) {
        scalar = bootstrapRegionScalarLiteral(expression.children[0])
    }
    scalar
}

// Whether a module value of `type` keeps what its `append`, `set` or
// `x[i] = v` stores: an array or map of heap elements, or a type the summary
// can't see into.
fun bootstrapRegionModuleValueKeepsElements(type: string): bool {
    var keeps = true
    if (bootstrapIsArrayType(type)) {
        keeps = !bootstrapRegionResultIsIndependent(
            bootstrapArrayElementType(type)
        )
    } else if (bootstrapIsMapType(type)) {
        keeps = !bootstrapRegionResultIsIndependent(bootstrapMapKeyType(type)) ||
            !bootstrapRegionResultIsIndependent(bootstrapMapValueType(type))
    }
    keeps
}

// The module value `root` names, or "" when it is no module value or a
// parameter, field or local of that name shadows it here.
fun bootstrapRegionModuleValueType(
    root: string,
    values: Map<string, string>,
    shadowed: array<string>
): string {
    var type = ""
    val found = values.get(root)
    if (found != null && !bootstrapAffineNamesContain(shadowed, root)) {
        type = found
    }
    type
}

// Whether a body stores into a module value what may be region memory: a heap
// value assigned to it or to one of its heap fields, an element appended, set
// or indexed into a heap-element array or map, or a call to one of its type's
// methods that keeps an argument. A function that does is unsafe in a region:
// the region frees what the module value still refers to. `shadowed` is a
// stack of the names bound around the expression (it comes back as it went
// in); `methodCalls` counts the other method calls on module values, whose
// answer can change as the summary learns which methods keep an argument.
fun bootstrapRegionExpressionStoresModuleValue(
    expression: BootstrapExpression,
    values: Map<string, string>,
    var shadowed: array<string>,
    summary: BootstrapRegionCallSummary,
    var methodCalls: array<int>
): bool {
    var stores = false
    if (expression.kind == "assign") {
        val type = bootstrapRegionModuleValueType(
            expression.text, values, shadowed
        )
        if (type != "" && !bootstrapRegionResultIsIndependent(type)) {
            stores = true
        }
    }
    if ((expression.kind == "member.assign" ||
         expression.kind == "index.assign" ||
         expression.kind == "member.call") &&
        expression.children.size > 0) {
        val type = bootstrapRegionModuleValueType(
            bootstrapPlaceRootName(expression.children[0]), values, shadowed
        )
        if (type != "") {
            if (expression.kind == "member.assign" &&
                (type == "unknown" ||
                 bootstrapRegionFieldIsHeap(summary, type, expression.text))) {
                stores = true
            }
            if (expression.kind == "index.assign" &&
                bootstrapRegionModuleValueKeepsElements(type)) {
                stores = true
            }
            if (expression.kind == "member.call") {
                if ((expression.text == "append" || expression.text == "set") &&
                    bootstrapRegionModuleValueKeepsElements(type)) stores = true
                methodCalls[0] = methodCalls[0] + 1
                if (bootstrapRegionReceiverCallIsRetaining(
                    summary, type, expression.text
                )) stores = true
            }
        }
    }
    // A lambda's parameters, a loop's variable in its body and a block's
    // local from its declaration on shadow a module value of their name.
    val mark = shadowed.size
    var child = 0
    val lambda = expression.kind == "lambda" ||
        expression.kind == "lambda.move" ||
        expression.kind == "lambda.generator"
    if (lambda) {
        while (child + 1 < expression.children.size) {
            shadowed.append(expression.children[child].text)
            child = child + 1
        }
    }
    while (!stores && child < expression.children.size) {
        val found = expression.children[child]
        val body = expression.kind == "for" && child == 1
        val bodyMark = shadowed.size
        if (body) shadowed.append(expression.text)
        stores = bootstrapRegionExpressionStoresModuleValue(
            found, values, shadowed, summary, methodCalls
        )
        if (body) shadowed.truncate(bodyMark)
        if (expression.kind == "block" &&
            (found.kind == "local.val" || found.kind == "local.var")) {
            shadowed.append(found.text)
        }
        child = child + 1
    }
    shadowed.truncate(mark)
    stores
}

// Marks a body that stores into a module value unsafe, and keeps for the
// fixed point the name of one whose answer may change (see above).
fun bootstrapRegionCheckModuleStores(
    name: string,
    expression: BootstrapExpression,
    values: Map<string, string>,
    var shadowed: array<string>,
    var summary: BootstrapRegionCallSummary,
    var recheck: BootstrapStringSet
): void {
    if (!bootstrapRegionCallIsUnsafe(summary, name)) {
        val methodCalls = [0]
        if (bootstrapRegionExpressionStoresModuleValue(
            expression, values, shadowed, summary, methodCalls
        )) {
            bootstrapRegionAddUnsafe(summary, name)
        } else if (methodCalls[0] > 0) recheck.add(name)
    }
    return
}

fun bootstrapBuildRegionCallSummary(
    declarations: array<BootstrapDeclaration>
): BootstrapRegionCallSummary {
    val summary = BootstrapRegionCallSummary(
        [], [], [], bootstrapStringSet(), bootstrapStringSet(),
        bootstrapStringSet(), bootstrapStringSet(),
        bootstrapRegionHeapFields(declarations)
    )
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (declaration.kind == "extern" && !declaration.isNoEscape) {
            bootstrapRegionAddUnsafe(summary, declaration.name)
        }
        if (bootstrapRegionExpressionCallsFunctionParameter(
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes
        )) bootstrapRegionAddUnsafe(summary, declaration.name)
        var methodIndex = 0
        while (methodIndex < declaration.methods.size) {
            val method = declaration.methods[methodIndex]
            if (method.kind == "extern" && !method.isNoEscape) {
                bootstrapRegionAddUnsafe(
                    summary, "${declaration.name}.${method.name}"
                )
            }
            if (bootstrapRegionExpressionCallsFunctionParameter(
                method.expression,
                method.parameters,
                method.parameterTypes
            )) bootstrapRegionAddUnsafe(
                summary, "${declaration.name}.${method.name}"
            )
            methodIndex = methodIndex + 1
        }
        declarationIndex = declarationIndex + 1
    }
    // Each body is walked for module-value stores once; one that calls a
    // method on a module value is walked again on each pass, as that method may
    // turn out to keep its argument.
    val moduleValues = bootstrapRegionModuleValues(declarations)
    val moduleRecheck = bootstrapStringSet()
    declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (declaration.kind == "fun" || declaration.kind == "compile.fun") {
            bootstrapRegionCheckModuleStores(
                declaration.name, declaration.expression, moduleValues,
                bootstrapNamesWith(declaration.parameters, []),
                summary, moduleRecheck
            )
        }
        for (method in declaration.methods) {
            bootstrapRegionCheckModuleStores(
                "${declaration.name}.${method.name}", method.expression,
                moduleValues,
                // The type's fields shadow module values too.
                bootstrapNamesWith(declaration.parameters, method.parameters),
                summary, moduleRecheck
            )
        }
        declarationIndex = declarationIndex + 1
    }
    // A body is walked again only once something it calls changes in the
    // summary (BootstrapBodySchedule).
    val declarationOf: array<int> = []
    val methodOf: array<int> = []
    val callers = bootstrapCallersOf(declarations, declarationOf, methodOf)
    var schedule = bootstrapBodySchedule(declarationOf.size)
    var round = true
    while (round) {
        var body = schedule.take()
        while (body >= 0) {
            val declaration = declarations[declarationOf[body]]
            val methodIndex = methodOf[body]
            var changed = false
            if (methodIndex < 0) {
                if ((declaration.kind == "fun" ||
                     declaration.kind == "compile.fun") &&
                    !bootstrapRegionCallIsUnsafe(summary, declaration.name) &&
                    moduleRecheck.contains(declaration.name) &&
                    bootstrapRegionExpressionStoresModuleValue(
                        declaration.expression,
                        moduleValues,
                        bootstrapNamesWith(declaration.parameters, []),
                        summary,
                        [0]
                    )) {
                    bootstrapRegionAddUnsafe(summary, declaration.name)
                    changed = true
                }
                if (bootstrapRegionExpressionRetainsParameters(
                    declaration.expression,
                    declaration.name,
                    declaration.parameters,
                    declaration.parameterTypes,
                    declarations,
                    summary
                )) changed = true
                if ((declaration.kind == "fun" ||
                     declaration.kind == "compile.fun") &&
                    !bootstrapRegionCallIsUnsafe(summary, declaration.name) &&
                    bootstrapRegionExpressionCallsUnsafe(
                        declaration.expression,
                        summary
                    )) {
                    bootstrapRegionAddUnsafe(summary, declaration.name)
                    changed = true
                }
                if (changed) callers.touch(declaration.name, schedule)
            } else {
                val method = declaration.methods[methodIndex]
                val name = "${declaration.name}.${method.name}"
                if (bootstrapRegionExpressionRetainsParameters(
                    method.expression,
                    name,
                    method.parameters,
                    method.parameterTypes,
                    declarations,
                    summary
                )) changed = true
                if (!summary.retainingReceivers.contains(name) &&
                    bootstrapRegionExpressionRetainsReceiver(
                    method.expression,
                    declaration.name,
                    declarations,
                    summary
                )) {
                    bootstrapRegionAddRetainingReceiver(summary, name)
                    changed = true
                }
                if (!bootstrapRegionCallIsUnsafe(summary, name) &&
                    (bootstrapRegionExpressionCallsUnsafe(
                        method.expression,
                        summary
                    ) || (moduleRecheck.contains(name) &&
                    bootstrapRegionExpressionStoresModuleValue(
                        method.expression,
                        moduleValues,
                        bootstrapNamesWith(
                            declaration.parameters, method.parameters
                        ),
                        summary,
                        [0]
                    )))) {
                    bootstrapRegionAddUnsafe(summary, name)
                    changed = true
                }
                if (changed) callers.touch(name, schedule)
            }
            body = schedule.take()
        }
        round = schedule.nextRound()
    }
    summary
}

class BootstrapFunctionDeclarationIndex(
    val names: array<string>,
    val declarationIndices: array<int>,
    val slots: array<int>
) {
    fun find(name: string): int {
        var result = -1
        if (this.slots.size > 0) {
            var slot = bootstrapFunctionDeclarationHash(name)
            slot = slot - slot / this.slots.size * this.slots.size
            var probes = 0
            while (result < 0 && probes < this.slots.size &&
                   this.slots[slot] >= 0) {
                val entry = this.slots[slot]
                if (this.names[entry] == name) {
                    result = this.declarationIndices[entry]
                } else {
                    slot = slot + 1
                    if (slot == this.slots.size) slot = 0
                }
                probes = probes + 1
            }
        }
        result
    }
}

// A name's slot hash for the compiler's tables (bootstrapIrLookupHash too):
// 64-bit FNV-1a, one xor and one wrapping multiply a byte, made non-negative
// for the callers' `slot % size`. Only slots depend on it, never an output.
fun bootstrapFunctionDeclarationHash(name: string): int {
    var hash = -3750763034362895579
    var index = 0
    while (index < name.size) {
        hash = (hash ^ name[index]) * 1099511628211
        index = index + 1
    }
    hash & 9223372036854775807
}

// The hash of `owner` and `name` taken together (a method's), without making
// the string of them: the owner's bytes, its length, then the name's.
fun bootstrapMethodDeclarationHash(owner: string, name: string): int {
    var hash = -3750763034362895579
    var index = 0
    while (index < owner.size) {
        hash = (hash ^ owner[index]) * 1099511628211
        index = index + 1
    }
    hash = (hash ^ owner.size) * 1099511628211
    index = 0
    while (index < name.size) {
        hash = (hash ^ name[index]) * 1099511628211
        index = index + 1
    }
    hash & 9223372036854775807
}

// Every declaration's index by name, in declaration order. A lookup walks a name's
// list where it scanned every declaration (the evaluator's globals, the borrow
// checker's call results); each still checks its own kinds, so it meets the same
// declarations in the same order.
class BootstrapDeclarationNameIndex(
    val names: array<string>,
    val firsts: array<int>,
    val lasts: array<int>,
    val nodeDeclarations: array<int>,
    val nodeNexts: array<int>,
    val slots: array<int>
) {
    /** The first node of `name`'s list, or -1. */
    fun first(name: string): int {
        var result = -1
        if (this.slots.size > 0) {
            var slot = bootstrapFunctionDeclarationHash(name)
            slot = slot - slot / this.slots.size * this.slots.size
            var probes = 0
            while (result < 0 && probes < this.slots.size &&
                   this.slots[slot] >= 0) {
                val entry = this.slots[slot]
                if (this.names[entry] == name) {
                    result = this.firsts[entry]
                } else {
                    slot = slot + 1
                    if (slot == this.slots.size) slot = 0
                }
                probes = probes + 1
            }
        }
        result
    }
}

fun bootstrapDeclarationNameIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapDeclarationNameIndex {
    var capacity = 8
    while (capacity < declarations.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    val names: array<string> = []
    val firsts: array<int> = []
    val lasts: array<int> = []
    val nodeDeclarations: array<int> = []
    val nodeNexts: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val name = declarations[declaration].name
        val node = nodeDeclarations.size
        nodeDeclarations.append(declaration)
        nodeNexts.append(-1)
        slot = bootstrapFunctionDeclarationHash(name)
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0) {
                slots[slot] = names.size
                names.append(name)
                firsts.append(node)
                lasts.append(node)
                placed = true
            } else if (names[existing] == name) {
                nodeNexts[lasts[existing]] = node
                lasts[existing] = node
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        declaration = declaration + 1
    }
    BootstrapDeclarationNameIndex(names, firsts, lasts, nodeDeclarations, nodeNexts, slots)
}

// Top-level (non-extension) declarations by name: how many share each name and
// the index of the first. Name resolution asks this for every identifier.
class BootstrapTopLevelNameIndex(
    val names: array<string>,
    val firsts: array<int>,
    val counts: array<int>,
    val slots: array<int>
) {
    fun find(name: string): int {
        var result = -1
        if (this.slots.size > 0) {
            var slot = bootstrapFunctionDeclarationHash(name)
            slot = slot - slot / this.slots.size * this.slots.size
            var probes = 0
            while (result < 0 && probes < this.slots.size &&
                   this.slots[slot] >= 0) {
                val entry = this.slots[slot]
                if (this.names[entry] == name) {
                    result = entry
                } else {
                    slot = slot + 1
                    if (slot == this.slots.size) slot = 0
                }
                probes = probes + 1
            }
        }
        result
    }
}

fun bootstrapTopLevelNameIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapTopLevelNameIndex {
    var capacity = 8
    while (capacity < declarations.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    val names: array<string> = []
    val firsts: array<int> = []
    val counts: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner == "") {
            slot = bootstrapFunctionDeclarationHash(candidate.name)
            slot = slot - slot / capacity * capacity
            var placed = false
            while (!placed) {
                val existing = slots[slot]
                if (existing < 0) {
                    slots[slot] = names.size
                    names.append(candidate.name)
                    firsts.append(declaration)
                    counts.append(1)
                    placed = true
                } else if (names[existing] == candidate.name) {
                    counts[existing] = counts[existing] + 1
                    placed = true
                } else {
                    slot = slot + 1
                    if (slot == capacity) slot = 0
                }
            }
        }
        declaration = declaration + 1
    }
    BootstrapTopLevelNameIndex(names, firsts, counts, slots)
}

fun bootstrapFunctionDeclarationIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapFunctionDeclarationIndex {
    val names: array<string> = []
    val declarationIndices: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner == "" &&
            (candidate.kind == "fun" || candidate.kind == "extern" ||
             candidate.kind == "compile.fun")) {
            names.append(candidate.name)
            declarationIndices.append(declaration)
        }
        declaration = declaration + 1
    }
    var capacity = 8
    while (capacity < names.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    var entry = 0
    while (entry < names.size) {
        slot = bootstrapFunctionDeclarationHash(names[entry])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0 || names[existing] == names[entry]) {
                slots[slot] = entry
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    BootstrapFunctionDeclarationIndex(names, declarationIndices, slots)
}

fun bootstrapTypeDeclarationIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapFunctionDeclarationIndex {
    val names: array<string> = []
    val declarationIndices: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.kind == "class" || candidate.kind == "interface" ||
            candidate.kind == "type") {
            names.append(candidate.name)
            declarationIndices.append(declaration)
        }
        declaration = declaration + 1
    }
    bootstrapFunctionDeclarationIndexOf(names, declarationIndices)
}

// The `type` declarations alone (a later one of a name wins, as in a scan of
// every declaration): what bootstrapScalarTypeUnderlyingIndexed looks names up in.
fun bootstrapScalarTypeDeclarationIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapFunctionDeclarationIndex {
    val names: array<string> = []
    val declarationIndices: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.kind == "type") {
            names.append(candidate.name)
            declarationIndices.append(declaration)
        }
        declaration = declaration + 1
    }
    bootstrapFunctionDeclarationIndexOf(names, declarationIndices)
}

/** The index of `names` (a later entry of a name replaces an earlier one). */
fun bootstrapFunctionDeclarationIndexOf(
    names: array<string>,
    declarationIndices: array<int>
): BootstrapFunctionDeclarationIndex {
    var capacity = 8
    while (capacity < names.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    var entry = 0
    while (entry < names.size) {
        slot = bootstrapFunctionDeclarationHash(names[entry])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0 || names[existing] == names[entry]) {
                slots[slot] = entry
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    BootstrapFunctionDeclarationIndex(names, declarationIndices, slots)
}

fun bootstrapValueDeclarationIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapFunctionDeclarationIndex {
    val names: array<string> = []
    val declarationIndices: array<int> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (bootstrapDeclarationIsValue(candidate.kind)) {
            names.append(candidate.name)
            declarationIndices.append(declaration)
        }
        declaration = declaration + 1
    }
    var capacity = 8
    while (capacity < names.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    var entry = 0
    while (entry < names.size) {
        slot = bootstrapFunctionDeclarationHash(names[entry])
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0 || names[existing] == names[entry]) {
                slots[slot] = entry
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    BootstrapFunctionDeclarationIndex(names, declarationIndices, slots)
}

class BootstrapMethodDeclarationIndex(
    val keys: array<string>,
    val owners: array<string>,
    val declarations: array<BootstrapDeclaration>,
    val handles: array<int>,
    val inherentCompileOnly: array<bool>,
    val inherentTrusted: array<bool>,
    val slots: array<int>,
    val nameSlots: array<int>,
    val nameNext: array<int>
) {
    fun find(owner: string, name: string): int {
        var result = -1
        if (this.slots.size > 0) {
            var slot = bootstrapMethodDeclarationHash(owner, name)
            slot = slot - slot / this.slots.size * this.slots.size
            var probes = 0
            while (result < 0 && probes < this.slots.size &&
                   this.slots[slot] >= 0) {
                val entry = this.slots[slot]
                // As the keys compare: the owner and the method's name.
                if (this.owners[entry] == owner &&
                    this.declarations[entry].name == name) {
                    result = entry
                } else {
                    slot = slot + 1
                    if (slot == this.slots.size) slot = 0
                }
                probes = probes + 1
            }
        }
        result
    }
}

fun bootstrapMethodDeclarationKey(owner: string, name: string): string =
    "${owner.size}:$owner$name"

fun bootstrapMethodDeclarationIndex(
    declarations: array<BootstrapDeclaration>
): BootstrapMethodDeclarationIndex {
    val keys: array<string> = []
    val owners: array<string> = []
    val methods: array<BootstrapDeclaration> = []
    val handles: array<int> = []
    val inherentCompileOnly: array<bool> = []
    val inherentTrusted: array<bool> = []
    var nextMethodHandle = declarations.size
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner != "" &&
            (candidate.kind == "fun" ||
             candidate.kind == "compile.fun")) {
            keys.append(bootstrapMethodDeclarationKey(
                bootstrapNormalizeType(candidate.extensionOwner),
                candidate.name
            ))
            owners.append(bootstrapNormalizeType(candidate.extensionOwner))
            methods.append(candidate)
            handles.append(declaration)
        }
        var method = 0
        while (method < candidate.methods.size) {
            keys.append(bootstrapMethodDeclarationKey(
                bootstrapNormalizeType(candidate.name),
                candidate.methods[method].name
            ))
            owners.append(bootstrapNormalizeType(candidate.name))
            methods.append(candidate.methods[method])
            handles.append(nextMethodHandle)
            inherentCompileOnly.append(
                candidate.methods[method].kind == "compile.fun"
            )
            inherentTrusted.append(candidate.methods[method].isTrusted)
            nextMethodHandle = nextMethodHandle + 1
            method = method + 1
        }
        declaration = declaration + 1
    }
    // An interface's inherited members, under the interface: a call on a
    // `Solid` finds `Shape`'s `area` (with `Shape`'s handle).
    declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.kind == "interface" && candidate.conformances.size > 0) {
            val owner = bootstrapNormalizeType(candidate.name)
            for (member in bootstrapInterfaceAllMembers(declarations, candidate.name)) {
                val key = bootstrapMethodDeclarationKey(owner, member.name)
                var present = false
                for (existing in keys) {
                    if (existing == key) present = true
                }
                if (!present) {
                    val declaringKey = bootstrapMethodDeclarationKey(
                        bootstrapInterfaceDeclaringOwner(
                            declarations, candidate.name, member.name
                        ),
                        member.name
                    )
                    var handle = -1
                    var entry = 0
                    while (entry < keys.size) {
                        if (keys[entry] == declaringKey) handle = handles[entry]
                        entry = entry + 1
                    }
                    keys.append(key)
                    owners.append(owner)
                    methods.append(member)
                    handles.append(handle)
                }
            }
        }
        declaration = declaration + 1
    }
    // A class's members only an interface's default body answers, under the
    // class: `square.label()` finds `Shape`'s `label` (with its handle), and
    // is lowered as a call of that body (bootstrapLowerMemberCall).
    var defaulted = false
    for (candidate in declarations) {
        if (candidate.kind == "interface") {
            for (member in candidate.methods) if (member.expression.kind != "missing") defaulted = true
        }
    }
    if (defaulted) {
        var known = bootstrapStringSetOf(keys)
        for (candidate in declarations) {
            if (candidate.kind != "class") continue
            val owner = bootstrapNormalizeType(candidate.name)
            for (interfaceName in bootstrapClassInterfaces(declarations, candidate.name)) {
                for (member in bootstrapInterfaceAllMembers(declarations, interfaceName)) {
                    val key = bootstrapMethodDeclarationKey(owner, member.name)
                    if (known.contains(key)) continue
                    val provider = bootstrapDefaultInterface(declarations, candidate.name, member.name)
                    if (provider == "" || provider == "?") continue
                    val declaringKey = bootstrapMethodDeclarationKey(bootstrapNormalizeType(provider), member.name)
                    var entry = 0
                    while (entry < keys.size) {
                        if (keys[entry] == declaringKey) {
                            known.add(key)
                            keys.append(key)
                            owners.append(owner)
                            methods.append(methods[entry])
                            handles.append(handles[entry])
                            entry = keys.size
                        }
                        entry = entry + 1
                    }
                }
            }
        }
    }
    var capacity = 8
    while (capacity < keys.size * 2 + 1) capacity = capacity * 2
    val slots: array<int> = []
    var slot = 0
    while (slot < capacity) {
        slots.append(-1)
        slot = slot + 1
    }
    var entry = 0
    while (entry < keys.size) {
        slot = bootstrapMethodDeclarationHash(owners[entry], methods[entry].name)
        slot = slot - slot / capacity * capacity
        var placed = false
        while (!placed) {
            val existing = slots[slot]
            if (existing < 0 || keys[existing] == keys[entry]) {
                // The pre-indexed resolver, like the previous linear scan,
                // selects the last matching inherent/extension declaration.
                slots[slot] = entry
                placed = true
            } else {
                slot = slot + 1
                if (slot == capacity) slot = 0
            }
        }
        entry = entry + 1
    }
    val nameSlots: array<int> = []
    var nameSlot = 0
    while (nameSlot < capacity) {
        nameSlots.append(-1)
        nameSlot = nameSlot + 1
    }
    val nameNext: array<int> = []
    entry = 0
    while (entry < methods.size) {
        nameSlot = bootstrapFunctionDeclarationHash(methods[entry].name)
        nameSlot = nameSlot - nameSlot / capacity * capacity
        nameNext.append(nameSlots[nameSlot])
        nameSlots[nameSlot] = entry
        entry = entry + 1
    }
    BootstrapMethodDeclarationIndex(
        keys,
        owners,
        methods,
        handles,
        inherentCompileOnly,
        inherentTrusted,
        slots,
        nameSlots,
        nameNext
    )
}

// Overloads and operator functions, for the probe pass of overload.ab. Each
// candidate is one declaration under its final (possibly mangled) name; `key`
// is the source spelling it answers to: `name` for a free function,
// `Owner.name` for a method or extension; `spelling` is its `name` part.
// With `bodies` (filtered), the probe types just the bodies whose
// `bootstrapOverloadBodyKey` it holds (bootstrapOverloadProbedBodies).
class BootstrapOverloadTable(
    val keys: array<string>,
    val names: array<string>,
    val owners: array<string>,
    val operators: array<bool>,
    val spellings: array<string>,
    val filtered: bool = false,
    val bodies: BootstrapStringSet = bootstrapStringSet()
) {
    fun has(key: string, operatorOnly: bool): bool {
        var index = 0
        while (index < this.keys.size) {
            if (this.keys[index] == key && (!operatorOnly || this.operators[index])) return true
            index = index + 1
        }
        false
    }

    /** Whether `expression` holds a node the probe may resolve: a call spelled
     *  like a free candidate, a method call named like a method candidate, or
     *  an operator an operator function is named for. Whatever the operand
     *  types, nothing else is resolved. */
    fun mayResolve(expression: BootstrapExpression): bool {
        val operator = bootstrapOperatorFunctionName(expression.kind)
        val call = expression.kind == "call"
        val methodCall = expression.kind == "member.call"
        if (operator != "" || call || methodCall) {
            var index = 0
            while (index < this.keys.size) {
                if (operator != "") {
                    if (this.operators[index] && this.spellings[index] == operator) return true
                } else if (this.spellings[index] == expression.text &&
                    (this.owners[index] == "") == call) return true
                index = index + 1
            }
        }
        for (child in expression.children) if (this.mayResolve(child)) return true
        false
    }

    /** Whether the probe types a function's body (with its parameter
     *  defaults): only where it may resolve something. A body is typed apart
     *  from every other, so one it skips changes no other's types. */
    fun probes(declaration: BootstrapDeclaration): bool {
        if (this.filtered) return this.bodies.contains(bootstrapOverloadBodyKey(declaration))
        if (this.mayResolve(declaration.expression)) return true
        for (value in declaration.parameterDefaults) if (this.mayResolve(value)) return true
        false
    }
}

/** A function's place in its source, which names its body for the probe. */
fun bootstrapOverloadBodyKey(declaration: BootstrapDeclaration): string =
    "${declaration.sourceIdentity}:${declaration.begin}:${declaration.end}"

fun bootstrapNoOverloads(): BootstrapOverloadTable =
    BootstrapOverloadTable([], [], [], [], [])

// A call (or an operator on a non-scalar operand) the probe pass resolved: the
// node at `begin..end` in `sourceIdentity` becomes `kind` naming `name`.
class BootstrapOverloadResolution(
    val sourceIdentity: string,
    val begin: int,
    val end: int,
    val originalKind: string,
    val originalText: string,
    val kind: string,
    val name: string
)

/** Two functions of one name whose parameter types differ: an overload. */
fun bootstrapDeclarationsOverload(
    first: BootstrapDeclaration,
    second: BootstrapDeclaration
): bool {
    if (first.kind != "fun" || second.kind != "fun") return false
    if (first.parameterTypes.size != second.parameterTypes.size) return true
    var index = 0
    while (index < first.parameterTypes.size) {
        if (bootstrapNormalizeType(first.parameterTypes[index]) !=
            bootstrapNormalizeType(second.parameterTypes[index])) return true
        index = index + 1
    }
    false
}

// The operator a binary or unary expression may name, or "".
fun bootstrapOperatorFunctionName(kind: string): string = when (kind) {
    "+" -> "plus"
    "-" -> "minus"
    "*" -> "times"
    "/" -> "div"
    "%" -> "rem"
    "unary-" -> "unaryMinus"
    else -> ""
}

// A function's locals by name: the last local of each name, and for each local
// the one of its name before it (-1 none), for the first `count` locals.
class BootstrapLocalIndex(
    val last: Map<string, int>,
    val previous: array<int>,
    var count: int
)

fun bootstrapLocalIndex(): BootstrapLocalIndex = BootstrapLocalIndex(Map(), [], 0)

class BootstrapAnalyzer(
    val symbols: array<BootstrapSymbol>,
    var symbolSlots: array<int>,
    var errors: int,
    var extensionErrors: int,
    var locals: array<BootstrapSymbol>,
    val declarations: array<BootstrapDeclaration>,
    val functionDeclarations: BootstrapFunctionDeclarationIndex,
    val typeDeclarations: BootstrapFunctionDeclarationIndex,
    val methodDeclarations: BootstrapMethodDeclarationIndex,
    // Every declaration by name; ABLA_BORROW_INDEX_CHECK=1 checks the borrow
    // lookups that use it against a scan of every declaration.
    val declarationNames: BootstrapDeclarationNameIndex,
    val borrowIndexCheck: bool,
    val affineTypes: array<string>,
    val mutableReceivers: BootstrapMutableReceiverSummary,
    val regionCalls: BootstrapRegionCallSummary,
    val compileEffects: BootstrapCompileEffectSummary,
    val compileEffectGrants: int,
    val compileEffectAuthorizations: int,
    val typedRequestBegins: array<int>,
    val typedRequestEnds: array<int>,
    val typedRequestKinds: array<string>,
    val typedRequestSources: array<string>,
    val typedCalls: array<BootstrapTypedCall>,
    val resolvedNames: array<BootstrapResolvedName>,
    val managedAliasBegins: array<int>,
    val managedAliasEnds: array<int>,
    val managedAliasSources: array<string>,
    var refinementNames: array<string>,
    var refinementTypes: array<string>,
    var refinementScopes: array<int>,
    var regionOwnedNames: array<string>,
    var regionOwnedScopes: array<int>,
    var diagnostics: string,
    var scopeParents: array<int>,
    var currentScope: int,
    var currentOwner: string,
    var currentResultType: string,
    var currentBorrowResultSource: string,
    var returnedType: string,
    var currentGeneratedNamespace: string,
    var currentGeneratedOriginBegin: int,
    var currentGeneratedOriginEnd: int,
    var currentSourceIdentity: string,
    var loopDepth: int,
    var trustedDepth: int,
    var regionDepth: int,
    var regionScope: int,
    var compileDepth: int,
    var generatorDepth: int,
    var yieldedType: string,
    val allowContractCalls: bool,
    val topLevelNames: BootstrapTopLevelNameIndex,
    val overloads: BootstrapOverloadTable = bootstrapNoOverloads(),
    val overloadResolutions: array<BootstrapOverloadResolution> = [],
    var overloadFailures: string = "",
    // Where inference last was: a diagnostic without its own `@offset`
    // points there instead of at the start of the file.
    var inferBegin: int = 0,
    var inferSource: string = "",
    // The body being checked (a function's, a method's or a lambda's): a
    // fresh local passed to a constructor is moved when this body never
    // reads it again.
    var currentBody: BootstrapExpression =
        BootstrapExpression("missing", "", 0, 0, []),
    // Inside a `#` expression reached from run-time code: the locals before
    // this index are the run-time code's, which don't exist when it runs.
    var compileLocalBarrier: int = -1,
    // Result types inferred from bodies (ct_infer.ab).
    val inferredResults: BootstrapInferredResults = bootstrapNoInferredResults(),
    // What each body reads, for the globals' initialization order (ct_init.ab).
    val initEdges: BootstrapInitEdges = bootstrapNoInitEdges(),
    // The assignments (by begin) of the body being analyzed whose value is
    // used: bootstrapCollectUsedAssignments.
    var usedAssignments: array<int> = [],
    // Array literals typed from a store's inferred receiver (expected_types.ab).
    val contextualLiterals: BootstrapContextualLiterals = bootstrapNoContextualLiterals(),
    // The member expressions a mutation goes through (`n.items` in
    // `n.items.append(x)`): an extension field the object doesn't have takes
    // its default there, stored, so the mutation stays (bootstrapLowerer).
    val mutationPlaceSources: array<string> = [],
    val mutationPlaceBegins: array<int> = [],
    val mutationPlaceEnds: array<int> = [],
    // The file of each managed alias (managedAliasBegins), which lowering
    // matches with the offsets.
    val managedAliasFiles: array<string> = [],
    // By identifier, call or assignment (bootstrapIdentifierKey): those that
    // named a local or field while a top-level declaration has the same name,
    // recorded while the local's scope was live. A check that runs after the
    // scope is left (a body's result) and lowering's name scans read this
    // rather than looking the name up again, where the local is gone and a
    // global of the same name (of any module) would answer.
    val shadowedIdentifiers: BootstrapStringSet = bootstrapStringSet(),
    // Delegated class properties: each one's `Owner.field` and its delegated
    // type (bootstrapDelegatedType), "" while it is being worked out.
    val delegatedFieldKeys: array<string> = [],
    val delegatedFieldTypes: array<string> = [],
    // The accesses of delegated properties found, and the diagnostics only
    // they produce, for the rewrite into plain code (delegated_properties.ab).
    val delegatedRewrites: array<BootstrapDelegatedRewrite> = [],
    var delegatedFailures: string = "",
    // The names a `by` expression may not read (checkDelegatedInitializerScope).
    val delegatedFailedInitializers: array<BootstrapExpression> = [],
    val delegatedFailedReplacements: array<BootstrapExpression> = [],
    // The `atomic` bodies being analyzed, innermost last (0: none). A lambda
    // inside one starts again from 0: it may run anywhere.
    var atomicDepth: int = 0,
    // Transactions' checks (bootstrapCheckStm): whether the program has an
    // `atomic` or a TVar at all; the lambdas (other than transaction bodies)
    // being analyzed; the lambda that is the next transaction body; the first
    // scope inside the innermost transaction body.
    var stmEnabled: bool = false,
    var stmLambdaDepth: int = 0,
    var stmBodyPending: int = -1,
    var stmScopeFloor: int = -1,
    // What the checks need of each body: a TVar access or `retry`
    // ("access"), a call or read of a declaration ("call", its handle), a
    // thread or task started ("thread"), a global changed ("global"), with
    // the body (stmOwner), whether it is inside a transaction, and where.
    val stmKinds: array<string> = [],
    val stmOwners: array<int> = [],
    val stmInside: array<bool> = [],
    val stmTargets: array<int> = [],
    val stmBegins: array<int> = [],
    val stmSources: array<string> = [],
    val stmTexts: array<string> = [],
    // Whether any declaration is a private extension member: -1 not known yet.
    var privateExtensionsKnown: int = -1,
    // The generics probe (generics.ab): the generics, and the calls of them
    // it typed, the instances those name, and the calls it couldn't bind.
    val generics: BootstrapGenericTable = bootstrapNoGenerics(),
    val genericResolutions: array<BootstrapOverloadResolution> = [],
    val genericRequests: array<string> = [],
    var genericFailures: string = "",
    // The calls genericFailures reports, which become invalid nodes when
    // the last probe still can't bind them.
    val genericFailedCalls: array<BootstrapOverloadResolution> = [],
    // The type expected of the expression at genericExpectedBegin (a typed
    // local's initializer, a returned value): a generic's call there binds
    // its type parameters from it first.
    var genericExpected: string = "",
    var genericExpectedBegin: int = -1,
    var genericExpectedEnd: int = -1,
    // The locals by name (localIndex.last, then .previous): a name's lookup
    // walks only the locals of that name, not every local of the function.
    var localIndex: BootstrapLocalIndex = bootstrapLocalIndex(),
    // The classes conforming to Transactional (isTransactionalType) and the
    // runtime-valued ones (isRuntimeValueType).
    val transactionalNames: BootstrapStringSet = bootstrapStringSet(),
    val runtimeValueNames: BootstrapStringSet = bootstrapStringSet()
) {
    /** Whether `type` is a class conforming to Transactional (a TVar, or a
     *  library's transactional delegate): reads and writes through it are
     *  its transaction's. */
    fun isTransactionalType(type: string): bool =
        this.transactionalNames.keys.size > 0 &&
            this.transactionalNames.contains(bootstrapBorrowElementType(bootstrapNormalizeType(type)))

    /** Whether `type` is a runtime-valued class (bootstrapRuntimeValueSpec). */
    fun isRuntimeValueType(type: string): bool =
        this.runtimeValueNames.keys.size > 0 &&
            this.runtimeValueNames.contains(bootstrapBorrowElementType(bootstrapNormalizeType(type)))

    fun prepareSymbolIndex(expectedSymbols: int): void {
        var capacity = 8
        while (capacity < expectedSymbols * 2 + 1) {
            capacity = capacity * 2
        }
        val slots: array<int> = []
        var slot = 0
        while (slot < capacity) {
            slots.append(-1)
            slot = slot + 1
        }
        this.symbolSlots = slots
        return
    }

    fun indexSymbol(symbol: int): void {
        if (this.symbolSlots.size == 0) {
            this.prepareSymbolIndex(this.symbols.size)
        }
        var slot = bootstrapFunctionDeclarationHash(
            this.symbols[symbol].name
        )
        slot = slot - slot / this.symbolSlots.size *
            this.symbolSlots.size
        var placed = false
        while (!placed) {
            val existing = this.symbolSlots[slot]
            if (existing < 0 ||
                this.symbols[existing].name ==
                    this.symbols[symbol].name) {
                this.symbolSlots[slot] = symbol
                placed = true
            } else {
                slot = slot + 1
                if (slot == this.symbolSlots.size) slot = 0
            }
        }
        return
    }

    fun appendSymbol(symbol: BootstrapSymbol): void {
        this.symbols.append(symbol)
        this.indexSymbol(this.symbols.size - 1)
        return
    }

    fun rebuildSymbolIndex(): void {
        this.prepareSymbolIndex(this.symbols.size)
        var symbol = 0
        while (symbol < this.symbols.size) {
            this.indexSymbol(symbol)
            symbol = symbol + 1
        }
        return
    }

    fun symbolIndex(name: string): int {
        var result = -1
        if (this.symbolSlots.size > 0) {
            var slot = bootstrapFunctionDeclarationHash(name)
            slot = slot - slot / this.symbolSlots.size *
                this.symbolSlots.size
            var probes = 0
            while (result < 0 && probes < this.symbolSlots.size &&
                   this.symbolSlots[slot] >= 0) {
                val candidate = this.symbolSlots[slot]
                if (this.symbols[candidate].name == name) {
                    result = candidate
                } else {
                    slot = slot + 1
                    if (slot == this.symbolSlots.size) slot = 0
                }
                probes = probes + 1
            }
        } else {
            var candidate = 0
            while (candidate < this.symbols.size && result < 0) {
                if (this.symbols[candidate].name == name) result = candidate
                candidate = candidate + 1
            }
        }
        result
    }

    fun typesCompatible(expected: string, actual: string): bool {
        var compatible = bootstrapTypesCompatible(expected, actual)
        if (!compatible) {
            val underlying = this.scalarTypeUnderlying(actual)
            if (underlying != "") {
                compatible = bootstrapTypesCompatible(expected, underlying)
            }
        }
        if (!compatible) compatible = this.upcastsToInterface(expected, actual)
        compatible
    }

    /** bootstrapTypesCompatible, plus the class-to-interface upcast. */
    fun typesOrUpcast(expected: string, actual: string): bool =
        bootstrapTypesCompatible(expected, actual) ||
            this.upcastsToInterface(expected, actual)

    /** The interface declaration named `name`, or -1. */
    fun interfaceDeclaration(name: string): int {
        val found = this.typeDeclarations.find(name)
        if (found >= 0 && this.declarations[found].kind == "interface" &&
            this.declarations[found].name == name) found
        else -1
    }

    /** Whether the class `type` conforms to `interfaceName`: it declares so,
     *  or an `extend type : interfaceName` does. */
    fun conformsTo(type: string, interfaceName: string): bool {
        if (this.interfaceDeclaration(interfaceName) < 0) return false
        val found = this.typeDeclarations.find(type)
        if (found < 0) return false
        val declaration = this.declarations[found]
        if ((declaration.kind != "class" && declaration.kind != "interface") ||
            declaration.name != type) return false
        bootstrapTypeConformsIn(this.declarations, type, interfaceName)
    }

    /** A class value where an interface it conforms to is expected (and `C?`
     *  where `I?` is): the implicit upcast. */
    fun upcastsToInterface(expected: string, actual: string): bool {
        var target = expected
        var source = actual
        if (bootstrapIsNullableType(target)) {
            target = bootstrapNullableElementType(target)
            if (bootstrapIsNullableType(source)) {
                source = bootstrapNullableElementType(source)
            }
        }
        this.conformsTo(source, target)
    }

    /** A class's `: I, J` (or `extend C : I, J`): each names an interface,
     *  once, which the class implements: each member by a method or an
     *  extension function of the same name and signature, or by the
     *  interface's default body. An interface's own parents are not supported
     *  yet. */
    fun validateConformances(declaration: BootstrapDeclaration): void {
        if (declaration.kind == "interface") {
            this.validateInterface(declaration)
            return
        }
        if (declaration.kind != "class" && declaration.kind != "extend") return
        val ownerIndex = this.typeDeclarations.find(declaration.name)
        if (ownerIndex < 0 || this.declarations[ownerIndex].kind != "class" ||
            this.declarations[ownerIndex].name != declaration.name) {
            this.failAtOffset("interface.extend-unknown:${declaration.name}", declaration.begin)
            return
        }
        val owner = this.declarations[ownerIndex]
        // What earlier declarations already made the class conform to.
        val seen: array<string> = []
        if (declaration.kind == "extend") {
            for (conformance in owner.conformances) {
                seen.append(bootstrapNormalizeType(conformance))
            }
            for (other in this.declarations) {
                if (other.kind == "extend" && other.name == declaration.name &&
                    (other.sourceIdentity != declaration.sourceIdentity ||
                     other.begin < declaration.begin)) {
                    for (conformance in other.conformances) {
                        seen.append(bootstrapNormalizeType(conformance))
                    }
                }
            }
        }
        for (written in declaration.conformances) {
            val interfaceName = bootstrapNormalizeType(written)
            val found = this.interfaceDeclaration(interfaceName)
            var duplicate = false
            for (previous in seen) {
                if (previous == interfaceName) duplicate = true
            }
            seen.append(interfaceName)
            if (found < 0) {
                this.failAtOffset("interface.unknown:${declaration.name}:$interfaceName", declaration.begin)
            } else if (duplicate) {
                this.failAtOffset("interface.duplicate:${declaration.name}:$interfaceName", declaration.begin)
            } else {
                // A plain interface's values copy freely: no resource behind
                // one. A resource interface's are resources: only resources.
                if (owner.isResource && !this.declarations[found].isResource) {
                    this.failAtOffset("interface.resource-into-plain:$interfaceName:${declaration.name}", declaration.begin)
                }
                if (!owner.isResource && this.declarations[found].isResource) {
                    this.failAtOffset("interface.plain-into-resource:$interfaceName:${declaration.name}", declaration.begin)
                }
                val sealed = this.foreignSealed(interfaceName, declaration.sourceIdentity)
                if (sealed != "") {
                    this.failAtOffset("interface.sealed-foreign:$sealed:${declaration.name}", declaration.begin)
                }
                for (member in bootstrapInterfaceAllMembers(this.declarations, interfaceName)) {
                    this.validateConformanceMember(
                        declaration, ownerIndex, found, member
                    )
                }
            }
        }
        return
    }

    /** `value as? Square`: an interface value (or a nullable one) to a class
     *  that conforms to that interface, as `Square?`. A cast that can never
     *  succeed is an error. */
    fun inferInterfaceCast(expression: BootstrapExpression): string {
        val operand = bootstrapBorrowElementType(this.infer(expression.children[0]))
        val source = if (bootstrapIsNullableType(operand))
            bootstrapNullableElementType(operand) else operand
        val target = bootstrapNormalizeType(expression.text)
        if (operand != "unknown" && !this.conformsTo(target, source)) {
            this.fail("interface.cast@${expression.begin}:$operand:$target")
        } else if (this.interfaceDeclaration(source) >= 0 &&
            this.declarations[this.interfaceDeclaration(source)].isResource) {
            // It would leave two owners of one resource.
            this.fail("interface.cast-resource@${expression.begin}:$source")
        }
        "nullable:$target"
    }

    /** fail, with the diagnostic placed at `begin` of the current source. */
    fun failAtOffset(code: string, begin: int) {
        val previousBegin = this.inferBegin
        val previousSource = this.inferSource
        this.inferBegin = begin
        this.inferSource = this.currentSourceIdentity
        this.fail(code)
        this.inferBegin = previousBegin
        this.inferSource = previousSource
    }

    /** One interface member, against the class's methods and extension
     *  functions of that name. */
    fun validateConformanceMember(
        declaration: BootstrapDeclaration,
        ownerIndex: int,
        interfaceIndex: int,
        member: BootstrapDeclaration
    ): void {
        val owner = this.declarations[ownerIndex]
        val interfaceDeclaration = this.declarations[interfaceIndex]
        val interfaceName = interfaceDeclaration.name
        val wanted = bootstrapDeclarationFunctionType(member)
        var named = false
        var matches = false
        var methodBegin = declaration.begin
        for (method in owner.methods) {
            if (method.name == member.name) {
                named = true
                methodBegin = method.begin
                if (bootstrapConformanceSignatureMatches(member, method)) {
                    matches = true
                }
            }
        }
        if (!named) {
            for (candidate in this.declarations) {
                if (candidate.kind == "fun" && candidate.name == member.name &&
                    bootstrapNormalizeType(candidate.extensionOwner) == owner.name) {
                    named = true
                    if (candidate.sourceIdentity == this.currentSourceIdentity) {
                        methodBegin = candidate.begin
                    }
                    if (bootstrapConformanceSignatureMatches(member, candidate)) {
                        matches = true
                    }
                }
            }
        }
        // A method whose result is inferred matches once its body's type does.
        if (matches && member.resultType != "inferred") {
            val expected = bootstrapNormalizeType(member.resultType)
            val actual = this.methodResultType(owner.name, member.name)
            if (actual != "unknown" && actual != expected &&
                !bootstrapTypesCompatible(expected, actual)) {
                matches = false
            }
        }
        if (named && !matches) {
            this.failAtOffset(
                "interface.member-signature:$interfaceName.${member.name}:${owner.name}:$wanted",
                methodBegin
            )
        } else if (!named) {
            val provider = bootstrapDefaultInterface(
                this.declarations, owner.name, member.name
            )
            if (provider == "?") {
                // Once, from the first of the class's interfaces with the member.
                if (bootstrapInterfaceDeclaringOwner(
                    this.declarations, interfaceName, member.name
                ) == bootstrapFirstInterfaceWithMember(
                    this.declarations, owner.name, member.name
                )) this.failAtOffset("interface.default-ambiguous:${member.name}:${owner.name}", declaration.begin)
            } else if (provider == "") {
                this.failAtOffset("interface.missing-member:$interfaceName.${member.name}:${owner.name}", declaration.begin)
            }
        }
        return
    }

    /** The sealed interface among `interfaceName` and its ancestors declared
     *  in another module than `sourceIdentity`, or "". */
    fun foreignSealed(interfaceName: string, sourceIdentity: string): string {
        val names = [interfaceName]
        for (ancestor in bootstrapInterfaceAncestors(this.declarations, interfaceName)) {
            names.append(ancestor)
        }
        for (name in names) {
            val found = this.interfaceDeclaration(name)
            // An instance of a generic is its generic's module's.
            if (found >= 0 && this.declarations[found].isSealed &&
                bootstrapGenericSourceFile(this.declarations[found].sourceIdentity) !=
                    bootstrapGenericSourceFile(sourceIdentity)) return name
        }
        ""
    }

    /** An interface: its parents are interfaces, once, with no cycle and of
     *  its own kind (resource or plain); a member it declares again has its
     *  parent's signature; each member without a body names its result; and
     *  `drop` is a class's own. */
    fun validateInterface(declaration: BootstrapDeclaration): void {
        val seen: array<string> = []
        for (written in declaration.conformances) {
            val parentName = bootstrapNormalizeType(written)
            val found = this.interfaceDeclaration(parentName)
            var duplicate = false
            for (previous in seen) {
                if (previous == parentName) duplicate = true
            }
            seen.append(parentName)
            if (found < 0) {
                this.failAtOffset("interface.unknown:${declaration.name}:$parentName", declaration.begin)
            } else if (duplicate) {
                this.failAtOffset("interface.duplicate:${declaration.name}:$parentName", declaration.begin)
            } else if (this.declarations[found].isResource != declaration.isResource) {
                this.failAtOffset("interface.inheritance-resource:${declaration.name}:$parentName", declaration.begin)
            } else {
                val sealed = this.foreignSealed(parentName, declaration.sourceIdentity)
                if (sealed != "") {
                    this.failAtOffset("interface.sealed-foreign:$sealed:${declaration.name}", declaration.begin)
                }
            }
        }
        if (bootstrapInterfaceInCycle(this.declarations, declaration.name)) {
            this.failAtOffset("interface.inheritance-cycle:${declaration.name}", declaration.begin)
        }
        for (member in bootstrapInterfaceMembers(declaration)) {
            // A member without a body names its result: no body to infer it from.
            if (member.expression.kind == "missing" &&
                member.resultType == "inferred") {
                this.failAtOffset(
                    "interface.member-untyped:${declaration.name}.${member.name}",
                    member.begin
                )
            }
            if (member.name == "drop") {
                this.failAtOffset("interface.drop-member:${declaration.name}", member.begin)
            }
            for (ancestor in bootstrapInterfaceAncestors(this.declarations, declaration.name)) {
                val ancestorIndex = this.interfaceDeclaration(ancestor)
                if (ancestorIndex >= 0) {
                    for (inherited in bootstrapInterfaceMembers(this.declarations[ancestorIndex])) {
                        if (inherited.name == member.name &&
                            !bootstrapConformanceSignatureMatches(inherited, member)) {
                            this.failAtOffset(
                                "interface.member-conflict:${declaration.name}.${member.name}:$ancestor",
                                member.begin
                            )
                        }
                    }
                }
            }
        }
        return
    }

    fun scalarTypeUnderlying(name: string): string {
        var result = ""
        val declaration = this.typeDeclarations.find(name)
        if (declaration >= 0 &&
            this.declarations[declaration].kind == "type") {
            result = bootstrapNormalizeType(
                this.declarations[declaration].resultType
            )
        }
        result
    }

    fun scalarValueType(type: string): string {
        val normalized = bootstrapNormalizeType(type)
        if (bootstrapScalarTypeUnderlyingValid(normalized)) normalized else {
            val underlying = this.scalarTypeUnderlying(normalized)
            if (underlying == "") normalized else underlying
        }
    }

    fun expressionCompileEffects(expression: BootstrapExpression): int {
        val delegatedNames: array<string> = []
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (bootstrapDeclarationIsValue(candidate.kind) &&
                candidate.expression.kind == "delegate.initializer") {
                delegatedNames.append(candidate.name)
            }
            declaration = declaration + 1
        }
        bootstrapCollectDelegatedNames(expression, delegatedNames)
        // A `#` expression is the program's own code: raw memory it reaches
        // outside the standard library is trusted.native.
        bootstrapCompileContainEffects(bootstrapExpressionDelegatedCompileEffects(
            expression,
            this.compileEffects,
            delegatedNames
        ), 0)
    }

    fun fail(code: string) {
        this.errors = this.errors + 1
        if (code.size >= 27 &&
            code.slice(0, 27) == "contract.call.not-consumed:") {
            this.diagnostics =
                "${this.diagnostics}error[E_CONTRACT_CALL_NOT_CONSUMED]: contract-only function `${code.slice(27, code.size)}` has no local implementation\n"
        } else if (code.size >= 24 &&
            code.slice(0, 24) == "delegate.getter-missing:") {
            this.diagnostics =
                "${this.diagnostics}error[E_DELEGATE_GETTER_MISSING]: ${code.slice(24, code.size)}\n"
        } else if (code.size >= 24 &&
            code.slice(0, 24) == "delegate.setter-missing:") {
            this.diagnostics =
                "${this.diagnostics}error[E_DELEGATE_SETTER_MISSING]: ${code.slice(24, code.size)}\n"
        } else if (code.size >= 23 &&
            code.slice(0, 23) == "delegate.not-delegated:") {
            this.diagnostics =
                "${this.diagnostics}error[E_NOT_DELEGATED]: ${code.slice(23, code.size)}\n"
        } else if (code.size >= 21 &&
            code.slice(0, 21) == "delegate.replace-val:") {
            this.diagnostics =
                "${this.diagnostics}error[E_DELEGATE_REPLACE_VAL]: ${code.slice(21, code.size)}\n"
        } else if (code.size >= 22 &&
            code.slice(0, 22) == "delegate.affine-value:") {
            this.diagnostics =
                "${this.diagnostics}error[E_DELEGATE_AFFINE_VALUE]: ${code.slice(22, code.size)}\n"
        } else if (code.size >= 23 &&
            code.slice(0, 23) == "delegate.type-mismatch:") {
            this.diagnostics =
                "${this.diagnostics}error[E_DELEGATE_TYPE_MISMATCH]: ${code.slice(23, code.size)}\n"
        } else if (code.size >= 27 &&
            code.slice(0, 27) == "delegate.initializer-scope:") {
            this.diagnostics =
                "${this.diagnostics}error[E_DELEGATE_INITIALIZER_SCOPE]: ${code.slice(27, code.size)}\n"
        } else if (code == "delegate.move-projection") {
            this.diagnostics =
                "${this.diagnostics}error[E_DELEGATE_MOVE_PROJECTION]: a delegate projection cannot be consumed with `move`\n"
        } else if (this.currentGeneratedNamespace != "") {
            this.extensionErrors = this.extensionErrors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_EXT_GENERATED_SEMANTIC]: $code\n"
            this.diagnostics =
                "${this.diagnostics}source[generated-origin]:${this.currentGeneratedNamespace}:${this.currentGeneratedOriginBegin}:${this.currentGeneratedOriginEnd}\n"
        } else this.diagnostics =
            "${this.diagnostics}error[E_SEMANTIC]: $code\n"
        if (this.currentSourceIdentity != "") {
            var begin = if (this.inferSource == this.currentSourceIdentity) {
                this.inferBegin
            } else 0
            var marker = -1
            var cursor = 0
            while (marker < 0 && cursor < code.size) {
                if (code[cursor] == 64) marker = cursor + 1
                cursor = cursor + 1
            }
            if (marker >= 0) {
                begin = 0
                cursor = marker
                while (cursor < code.size && code[cursor] >= 48 &&
                    code[cursor] <= 57) {
                    begin = begin * 10 + code[cursor] - 48
                    cursor = cursor + 1
                }
            }
            this.diagnostics =
                "${this.diagnostics}source[semantic]:${this.currentSourceIdentity}:$begin:${begin + 1}\n"
        }
        val help = bootstrapSemanticHelp(code)
        if (help != "") this.diagnostics = "${this.diagnostics}help: $help\n"
        // The hidden local of `??` or `?.` (parser.ab, nullGuard).
        if (bootstrapTextContains(code, "__abla_null_default_")) this.diagnostics =
            "${this.diagnostics}help: `a ?? b` takes `a` to hand it on: a resource there must be given away, as `move(a) ?? b`\n"
        if (bootstrapTextContains(code, "__abla_safe_call_")) this.diagnostics =
            "${this.diagnostics}help: `a?.b` keeps `a` in a hidden `val` unless it is a parameter or a `val`, so a resource there would be moved into it: read it through a parameter or a `val`\n"
        bootstrapSemanticUnit()
    }

    // Keep location-rich scalar diagnostics out of the recursive inference
    // frame. Recovered low-level modules can contain very deep expression
    // trees, so building the diagnostic only on the failing edge avoids
    // increasing the normal-path stack and allocation cost.
    fun failScalarExpression(
        code: string,
        expression: BootstrapExpression,
        left: string,
        right: string
    ): void {
        // An unknown operand follows an error already reported (an unknown
        // name or method): one mistake, one error.
        if ((left == "unknown" || right == "unknown") && this.errors > 0) return
        this.fail("$code@${expression.begin}:$left:$right")
        // `x & 1 == 0` parses as `x & (1 == 0)`: bitwise operators bind looser than
        // comparisons, as in C. Say so when an operand is a comparison.
        if (code == "bitwise.type" && expression.children.size == 2 &&
            (bootstrapIsComparisonKind(expression.children[0].kind) ||
             bootstrapIsComparisonKind(expression.children[1].kind))) {
            this.diagnostics =
                "${this.diagnostics}help: `${expression.kind}` binds more loosely than a comparison; parenthesize the bitwise part, e.g. `(x & 1) == 0`\n"
        }
        return
    }

    fun contractModuleForFunction(name: string): string {
        var moduleIdentity = ""
        val index = this.functionDeclarations.find(name)
        if (index >= 0) {
            val declaration = this.declarations[index]
            val prefix = "contract:"
            if (declaration.extensionOwner == "" &&
                declaration.name == name && declaration.kind == "extern" &&
                declaration.externalLibrary.size >= prefix.size &&
                declaration.externalLibrary.slice(0, prefix.size) == prefix) {
                moduleIdentity = declaration.externalLibrary.slice(
                    prefix.size, declaration.externalLibrary.size
                )
            }
        }
        moduleIdentity
    }

    fun scopeIsVisible(scope: int): bool {
        var candidate = this.currentScope
        var visible = scope < 0
        while (candidate >= 0) {
            if (candidate == scope) visible = true
            candidate = this.scopeParents[candidate]
        }
        visible
    }

    fun enterScope(): int {
        val previous = this.currentScope
        this.scopeParents.append(previous)
        this.currentScope = this.scopeParents.size - 1
        previous
    }

    fun leaveScope(previous: int) {
        this.currentScope = previous
    }
    fun findType(name: string): string {
        var result = "unknown"
        var binding = ""
        val local = this.visibleLocalIndex(name)
        if (local >= 0) {
            result = this.locals[local].type
            binding = bootstrapRefinementBinding(this.locals[local])
        }
        // A refinement narrows the declaration it was made for, never a
        // local that shadows it in a nested block.
        var refinementIndex = 0
        while (binding != "" &&
               refinementIndex < this.refinementNames.size) {
            if (this.refinementNames[refinementIndex] == binding &&
                refinementIndex < this.refinementTypes.size &&
                refinementIndex < this.refinementScopes.size &&
                this.scopeIsVisible(
                    this.refinementScopes[refinementIndex]
                )) {
                result = this.refinementTypes[refinementIndex]
            }
            refinementIndex = refinementIndex + 1
        }
        // In a method, a field shadows a top-level binding of its name.
        if (result == "unknown" && this.currentOwner != "") {
            result = this.fieldType(this.currentOwner, name)
        }
        if (result == "unknown") result = this.findTopLevelType(name)
        else if (bootstrapIsDelegatedType(result)) {
            result = bootstrapDelegatedExposedType(result)
        }
        result
    }

    /** The type of the top-level binding `name`, past any local or field. */
    fun findTopLevelType(name: string): string {
        var result = "unknown"
        val index = this.symbolIndex(name)
        if (index >= 0) {
            result = this.symbols[index].type
            if (this.initEdges.owner >= 0 || this.initEdges.threadBody >= 0) {
                bootstrapInitRecordSymbol(this, index)
            }
            if (bootstrapFunctionTypeIsInferred(result)) {
                result = bootstrapResolvedSymbolType(this, index)
            }
        }
        if (result == "unknown" && name == "github") {
            result = "function:(string)->ImportSource"
        }
        if (result == "unknown" && name == "gitImportSource") {
            result = "function:(string,string,string,string)->ImportSource"
        }
        if (result == "unknown" && name == "importFile") {
            result = "function:(string,string)->ImportFile"
        }
        if (result == "unknown" && name == "resolvedImport") {
            result = "function:(string,string,array:ImportFile)->ResolvedImport"
        }
        if (result == "unknown" && name == "importSource") {
            result = "function:(string,string,string,function:()->ResolvedImport)->ImportSource"
        }
        if (result == "unknown" && !this.inferredResults.settled) {
            result = bootstrapLaterGlobalType(this, name)
        }
        if (bootstrapIsDelegatedType(result)) {
            result = bootstrapDelegatedExposedType(result)
        }
        result
    }

    fun topLevelDeclarationIdentity(name: string): string {
        val entry = this.topLevelNames.find(name)
        if (entry < 0 || this.topLevelNames.counts[entry] != 1) return ""
        val declaration = this.declarations[this.topLevelNames.firsts[entry]]
        "abla:${declaration.sourceIdentity}:${declaration.begin}:${declaration.name}"
    }

    fun recordResolvedName(
        expression: BootstrapExpression,
        type: string
    ): void {
        var identity = this.visibleLocalIdentity(expression.text)
        var kind = this.visibleLocalKind(expression.text)
        val fieldIdentity = if (this.currentOwner != "") {
            this.fieldDeclarationIdentity(
                this.currentOwner, expression.text
            )
        } else ""
        if (identity == "" && fieldIdentity != "") {
            identity = fieldIdentity
            kind = "field"
        }
        if (identity == "") {
            identity = this.topLevelDeclarationIdentity(expression.text)
            kind = this.findKind(expression.text)
        }
        if (identity != "") {
            this.resolvedNames.append(
                BootstrapResolvedName(
                    this.currentSourceIdentity,
                    expression.begin,
                    expression.begin + expression.text.size,
                    expression.text,
                    identity,
                    bootstrapNormalizeType(type),
                    kind
                )
            )
        }
    }

    fun findStorageType(name: string): string {
        var result = "unknown"
        val local = this.visibleLocalIndex(name)
        if (local >= 0) result = this.locals[local].type
        // A field is stored as itself (a delegated property as its delegate),
        // whatever a top-level delegate of its name stores.
        if (result == "unknown" && this.currentOwner != "") {
            result = this.fieldStorageType(this.currentOwner, name)
        }
        if (result == "unknown") {
            val index = this.symbolIndex(name)
            if (index >= 0) result = this.symbols[index].type
        }
        result
    }

    fun nameIsDelegated(name: string): bool =
        bootstrapIsDelegatedType(this.findStorageType(name))

    fun delegateType(name: string): string =
        bootstrapDelegatedStorageType(this.findStorageType(name))

    fun delegatedNameIsMutable(name: string): bool =
        bootstrapDelegatedIsMutable(this.findStorageType(name))

    fun replaceSymbolType(name: string, type: string): void {
        var index = 0
        while (index < this.symbols.size) {
            val symbol = this.symbols[index]
            if (symbol.name == name) {
                this.symbols[index] = BootstrapSymbol(
                    symbol.name,
                    symbol.kind,
                    type,
                    symbol.scope,
                    symbol.borrowSource,
                    symbol.identity
                )
            }
            index = index + 1
        }
    }

    fun addNullableRefinement(
        expression: BootstrapExpression,
        conditionIsTrue: bool
    ): void {
        val name = bootstrapNullableRefinementName(expression)
        if (name != "" && this.hasVisibleLocal(name) &&
            this.visibleLocalKind(name) != "var") {
            // A local read from a managed field (an array, a class with
            // `var` fields) is a borrow of it: narrow what it borrows.
            val type = this.findType(name)
            val borrowed = bootstrapIsBorrowType(type)
            val element = bootstrapBorrowElementType(type)
            val nonNullWhenTrue =
                bootstrapNullableRefinementNonNullWhenTrue(expression)
            if (bootstrapIsNullableType(element) &&
                conditionIsTrue == nonNullWhenTrue) {
                val refined = bootstrapNullableElementType(element)
                this.refinementNames.append(this.visibleRefinementBinding(name))
                this.refinementTypes.append(
                    if (borrowed) "borrow:$refined" else refined
                )
                this.refinementScopes.append(this.currentScope)
            }
        }
    }

    /** In an `is` arm: the subject (a local or parameter that isn't `var`)
     *  has the type tested. */
    fun addTypeRefinement(expression: BootstrapExpression, type: string): void {
        if (expression.kind != "identifier") return
        val name = expression.text
        if (this.hasVisibleLocal(name) && this.visibleLocalKind(name) != "var") {
            val borrowed = bootstrapIsBorrowType(this.findType(name))
            this.refinementNames.append(this.visibleRefinementBinding(name))
            this.refinementTypes.append(if (borrowed) "borrow:$type" else type)
            this.refinementScopes.append(this.currentScope)
        }
        return
    }

    fun visibleRefinementBinding(name: string): string {
        val index = this.visibleLocalIndex(name)
        if (index >= 0) bootstrapRefinementBinding(this.locals[index]) else ""
    }

    // A local redeclaring a parameter in the block that is the body of its
    // function or lambda, the scope the parameters are declared for.
    fun redeclaresParameter(name: string): bool {
        var kind = ""
        var scope = -1
        val index = this.visibleLocalIndex(name)
        if (index >= 0) {
            kind = this.locals[index].kind
            scope = this.locals[index].scope
        }
        (kind == "parameter" || kind == "owned.parameter" ||
         kind == "mutable.parameter") &&
            this.currentScope > 0 &&
            this.scopeParents[this.currentScope] == scope
    }

    fun addNullableRefinements(
        expression: BootstrapExpression,
        conditionIsTrue: bool
    ): void {
        if (expression.kind == "unary!" &&
            expression.children.size == 1) {
            this.addNullableRefinements(
                expression.children[0],
                !conditionIsTrue
            )
        } else if (expression.kind == "&&" && conditionIsTrue &&
                   expression.children.size == 2) {
            this.addNullableRefinements(expression.children[0], true)
            this.addNullableRefinements(expression.children[1], true)
        } else if (expression.kind == "||" && !conditionIsTrue &&
                   expression.children.size == 2) {
            this.addNullableRefinements(expression.children[0], false)
            this.addNullableRefinements(expression.children[1], false)
        } else this.addNullableRefinement(expression, conditionIsTrue)
    }

    fun hasLocal(name: string): bool {
        var index = this.lastLocalNamed(name)
        while (index >= 0 && this.locals[index].scope != this.currentScope) {
            index = this.localIndex.previous[index]
        }
        index >= 0
    }

    /** Whether `name` here is a visible local or (in a method) a field: then it
     *  isn't the top-level binding of that name, in any module. */
    /** Whether a call `name(...)` calls a visible local or parameter: one of
     *  function type that takes `arguments` arguments (or of a type not known
     *  yet). A local of another type or arity leaves the call to the top-level
     *  declarations; a receiver member that
     *  takes the call was made `this.name(...)` already (receiver_names.ab). */
    fun callsLocal(name: string, arguments: int): bool {
        if (!this.hasVisibleLocal(name)) return false
        val type = bootstrapBorrowElementType(this.findType(name))
        type == "unknown" || (bootstrapIsFunctionType(type) &&
            (bootstrapFunctionParameterCount(type) < 0 ||
             bootstrapFunctionParameterCount(type) == arguments))
    }

    /** Records that the identifier, call or assignment names a local or
     *  field, when a top-level declaration has its name (shadowedIdentifiers). */
    fun recordShadowed(expression: BootstrapExpression): void {
        if (this.symbolIndex(expression.text) >= 0) {
            this.shadowedIdentifiers.add(
                bootstrapIdentifierKey(this.currentSourceIdentity, expression)
            )
        }
        return
    }

    /** The kind of the global the identifier, call or assignment names: ""
     *  when it named a local or field where it was analyzed
     *  (shadowedIdentifiers) or names one in scope now. */
    fun globalKindNamed(expression: BootstrapExpression): string {
        if (expression.kind == "missing" || expression.text == "") return ""
        if (this.shadowedIdentifiers.contains(
            bootstrapIdentifierKey(this.currentSourceIdentity, expression)
        )) return ""
        if (this.shadowsGlobal(expression.text)) return ""
        this.findKind(expression.text)
    }

    /** Fails when standard-library code names a global `val` or `var` of a
     *  program's module: the library never reads the program's globals, so
     *  such a name is a leak (a local the library meant, or a missing one). */
    fun validateGlobalVisible(expression: BootstrapExpression): void {
        if (!bootstrapStandardLibraryModuleSource(this.currentSourceIdentity) ||
            this.shadowsGlobal(expression.text)) return
        val entry = this.topLevelNames.find(expression.text)
        if (entry < 0 || this.topLevelNames.counts[entry] != 1) return
        val declaration = this.declarations[this.topLevelNames.firsts[entry]]
        if (bootstrapDeclarationIsValue(declaration.kind) &&
            !bootstrapStandardLibraryModuleSource(declaration.sourceIdentity)) {
            this.fail("library.program-global:${expression.text}@${expression.begin}")
        }
        return
    }

    /** Whether the identifier names a global `val` or `var` (globalKindNamed). */
    fun namesGlobal(expression: BootstrapExpression): bool {
        val globalKind = this.globalKindNamed(expression)
        globalKind == "val" || globalKind == "var"
    }

    fun shadowsGlobal(name: string): bool =
        this.hasVisibleLocal(name) || (this.currentOwner != "" &&
            this.fieldType(this.currentOwner, name) != "unknown")

    /** Starts the locals index afresh: `locals` is another function's now. */
    fun resetLocalIndex(): void {
        this.localIndex = bootstrapLocalIndex()
    }

    /** The last local named `name` (localIndex.previous gives the one of its
     *  name before it), -1 none. */
    fun lastLocalNamed(name: string): int {
        // Indexes the locals appended since the last lookup.
        if (this.localIndex.count > this.locals.size) this.resetLocalIndex()
        while (this.localIndex.count < this.locals.size) {
            val local = this.localIndex.count
            val before = this.localIndex.last.get(this.locals[local].name)
            this.localIndex.previous.append(if (before != null) before else -1)
            this.localIndex.last.set(this.locals[local].name, local)
            this.localIndex.count = local + 1
        }
        val last = this.localIndex.last.get(name)
        if (last != null) last else -1
    }

    /** The visible local named `name` (the last declared of those visible),
     *  -1 none. */
    fun visibleLocalIndex(name: string): int {
        var index = this.lastLocalNamed(name)
        while (index >= 0 && !this.scopeIsVisible(this.locals[index].scope)) {
            index = this.localIndex.previous[index]
        }
        index
    }

    fun hasVisibleLocal(name: string): bool = this.visibleLocalIndex(name) >= 0

    fun visibleLocalKind(name: string): string {
        val index = this.visibleLocalIndex(name)
        if (index >= 0) this.locals[index].kind else "unknown"
    }

    fun visibleLocalIdentity(name: string): string {
        val index = this.visibleLocalIndex(name)
        if (index >= 0) this.locals[index].identity else ""
    }

    fun visibleBorrowSource(name: string): string {
        val index = this.visibleLocalIndex(name)
        if (index >= 0) this.locals[index].borrowSource else ""
    }

    fun hasMovableLocal(name: string): bool =
        this.hasVisibleLocal(name) &&
        this.visibleLocalKind(name) != "parameter" &&
        this.visibleLocalKind(name) != "mutable.parameter" &&
        !bootstrapIsBorrowType(this.findType(name)) &&
        !this.isArrayLoopElement(name)

    /** Whether the local `name` is a loop's affine element of an array (borrowed from it). */
    fun isArrayLoopElement(name: string): bool {
        val source = this.visibleBorrowSource(name)
        source.size >= 8 && source.slice(0, 8) == "element:"
    }

    fun isBorrowedParameter(name: string): bool =
        this.hasVisibleLocal(name) &&
        (this.visibleLocalKind(name) == "parameter" ||
         this.visibleLocalKind(name) == "mutable.parameter")

    fun isMutableBorrowParameter(name: string): bool =
        this.hasVisibleLocal(name) &&
        this.visibleLocalKind(name) == "mutable.parameter"

    fun localIsMutable(name: string): bool {
        val index = this.visibleLocalIndex(name)
        index >= 0 && (this.locals[index].kind == "var" ||
            bootstrapDelegatedIsMutable(this.locals[index].type))
    }

    fun visibleLocalScope(name: string): int {
        val index = this.visibleLocalIndex(name)
        if (index >= 0) this.locals[index].scope else -1
    }

    fun scopeIsWithin(scope: int, ancestor: int): bool {
        var current = scope
        var result = false
        while (current >= 0) {
            if (current == ancestor) result = true
            current = this.scopeParents[current]
        }
        result
    }

    fun regionNameIsOwned(name: string): bool {
        var owned = false
        var index = 0
        while (index < this.regionOwnedNames.size) {
            if (this.regionOwnedNames[index] == name &&
                index < this.regionOwnedScopes.size &&
                this.scopeIsVisible(this.regionOwnedScopes[index])) {
                owned = true
            }
            index = index + 1
        }
        owned
    }

    fun markRegionOwned(name: string, scope: int): void {
        this.regionOwnedNames.append(name)
        this.regionOwnedScopes.append(scope)
    }

    fun regionExpressionIsPromotion(
        expression: BootstrapExpression
    ): bool {
        var promoted = expression.kind == "call" &&
            expression.text == "memoryPromoteString"
        if (expression.kind == "block" && expression.children.size > 0) {
            promoted = this.regionExpressionIsPromotion(
                expression.children[expression.children.size - 1]
            )
        }
        if (expression.kind == "if" &&
            expression.children.size >= 3) {
            promoted = this.regionExpressionIsPromotion(
                expression.children[1]
            ) && expression.children[2].kind != "missing" &&
                this.regionExpressionIsPromotion(expression.children[2])
        }
        promoted
    }

    fun regionExpressionIsOwned(expression: BootstrapExpression): bool {
        var owned = false
        if (this.regionDepth > 0) {
            if (expression.kind == "identifier") {
                owned = this.regionNameIsOwned(expression.text)
            }
            if (expression.kind == "string" ||
                expression.kind == "string.template" ||
                expression.kind == "array" ||
                expression.kind == "lambda" ||
                expression.kind == "lambda.move") owned = true
            if (expression.kind == "call") {
                val moving = expression.text == "move" &&
                    expression.children.size == 1
                val promoting = expression.text == "memoryPromoteString"
                val constructing = expression.text == "Shared" ||
                    expression.text == "Cell" || expression.text == "Map" ||
                    this.findKind(expression.text) == "class"
                if (moving) {
                    owned = this.regionExpressionIsOwned(
                        expression.children[0]
                    )
                }
                if (constructing) owned = true
                if (!moving && !constructing && !promoting) {
                    val functionType = this.findType(expression.text)
                    if (bootstrapIsFunctionType(functionType) &&
                        !bootstrapRegionResultIsIndependent(
                            bootstrapFunctionResultType(functionType)
                        )) owned = true
                }
            }
            if (expression.kind == "member") {
                val receiverType = bootstrapBorrowElementType(
                    this.infer(expression.children[0])
                )
                var resultType = this.fieldType(
                    receiverType,
                    expression.text
                )
                // A builtin property (a string's or array's `size`) is no declared
                // field: take the member's inferred type instead of "unknown".
                if (resultType == "unknown") resultType = this.infer(expression)
                owned = !bootstrapRegionResultIsIndependent(resultType) &&
                    this.regionExpressionIsOwned(expression.children[0])
            }
            if (expression.kind == "index") {
                val receiverType = bootstrapBorrowElementType(
                    this.infer(expression.children[0])
                )
                var resultType = "unknown"
                if (receiverType == "string") resultType = "i64"
                if (bootstrapIsArrayType(receiverType)) {
                    resultType = bootstrapArrayElementType(receiverType)
                }
                owned = !bootstrapRegionResultIsIndependent(resultType) &&
                    this.regionExpressionIsOwned(expression.children[0])
            }
            if (expression.kind == "member.call") {
                val receiverType = this.infer(expression.children[0])
                val resultType = if (bootstrapIsSharedType(receiverType) &&
                    expression.text == "get") {
                    bootstrapSharedElementType(receiverType)
                } else this.methodResultType(receiverType, expression.text)
                if (!bootstrapRegionResultIsIndependent(resultType)) {
                    owned = true
                }
            }
            if (expression.kind == "if") {
                owned = this.regionExpressionIsOwned(expression.children[1])
                if (expression.children[2].kind != "missing" &&
                    this.regionExpressionIsOwned(expression.children[2])) {
                    owned = true
                }
            }
            if (expression.kind == "block" &&
                expression.children.size > 0) {
                owned = this.regionExpressionIsOwned(
                    expression.children[expression.children.size - 1]
                )
            }
            if (expression.kind == "compile") {
                owned = this.regionExpressionIsOwned(expression.children[0])
            }
            // An operator's result is allocated where it is computed when its type
            // lives on the heap: a string concatenation, an overloaded operator
            // returning an object. Inside a region that is the region's memory.
            if (bootstrapIsRegionValueOperator(expression.kind) &&
                expression.children.size == 2 &&
                !bootstrapRegionResultIsIndependent(this.infer(expression))) {
                owned = true
            }
            // Any branch of a `when` (its bodies follow each match).
            if (expression.kind == "when") {
                var branch = 2
                while (branch < expression.children.size) {
                    if (this.regionExpressionIsOwned(expression.children[branch])) {
                        owned = true
                    }
                    branch = branch + 2
                }
            }
        }
        owned
    }

    fun regionTargetIsOutside(expression: BootstrapExpression): bool {
        val root = bootstrapPlaceRootName(expression)
        var outside = true
        if (root != "" && this.hasVisibleLocal(root)) {
            outside = !this.scopeIsWithin(
                this.visibleLocalScope(root),
                this.regionScope
            )
        }
        outside
    }

    fun validateRegionStore(
        target: BootstrapExpression,
        value: BootstrapExpression,
        context: string
    ): void {
        if (this.regionDepth > 0 &&
            this.regionExpressionIsOwned(value) &&
            this.regionTargetIsOutside(target)) {
            this.fail("region.escape:$context")
        }
    }

    fun hasMutableHeapGlobal(): bool {
        var found = false
        var index = 0
        while (index < this.symbols.size) {
            val symbol = this.symbols[index]
            if ((symbol.kind == "var" || symbol.kind == "val") &&
                !bootstrapRegionResultIsIndependent(symbol.type) &&
                !(symbol.kind == "val" && symbol.type == "string")) {
                found = true
            }
            index = index + 1
        }
        found
    }

    /** Whether a local (a parameter, a block's `val`) named `name` is in
     *  scope. */
    fun localVisible(name: string): bool = this.visibleLocalIndex(name) >= 0

    fun findKind(name: string): string {
        var result = "unknown"
        val index = this.symbolIndex(name)
        if (index >= 0) result = this.symbols[index].kind
        if (result == "unknown" &&
            (name == "github" || name == "gitImportSource" ||
             name == "importFile" || name == "resolvedImport" ||
             name == "importSource")) {
            result = "compile.fun"
        }
        result
    }

    fun fieldType(owner: string, field: string): string {
        var result = "unknown"
        val declarationIndex = this.typeDeclarations.find(owner)
        if (declarationIndex >= 0) {
            val declaration = this.declarations[declarationIndex]
            if ((declaration.kind == "class" ||
                 declaration.kind == "interface") &&
                declaration.name == owner) {
                var fieldIndex = 0
                while (fieldIndex < declaration.parameters.size) {
                    if (declaration.parameters[fieldIndex] == field &&
                        fieldIndex < declaration.parameterTypes.size &&
                        fieldIndex < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[fieldIndex] == "val" ||
                         declaration.parameterKinds[fieldIndex] == "var")) {
                        result = if (bootstrapIsDelegatedProperty(declaration, fieldIndex))
                            bootstrapDelegatedExposedType(
                                this.delegatedFieldType(declaration, fieldIndex)
                            )
                        else bootstrapNormalizeType(
                            declaration.parameterTypes[fieldIndex]
                        )
                    }
                    fieldIndex = fieldIndex + 1
                }
            }
        }
        if (result == "unknown") {
            val extension = this.extensionFieldSymbol(owner, field)
            if (extension >= 0) result = this.symbols[extension].type
        }
        result
    }

    /** The delegated type (bootstrapDelegatedType) of `owner`'s delegated
     *  property `field`, "" when it is not one. */
    fun delegatedField(owner: string, field: string): string {
        val declarationIndex = this.typeDeclarations.find(owner)
        if (declarationIndex < 0) return ""
        val declaration = this.declarations[declarationIndex]
        if (declaration.kind != "class" || declaration.name != owner) return ""
        var fieldIndex = 0
        while (fieldIndex < declaration.parameters.size) {
            if (declaration.parameters[fieldIndex] == field &&
                bootstrapIsDelegatedProperty(declaration, fieldIndex)) {
                return this.delegatedFieldType(declaration, fieldIndex)
            }
            fieldIndex = fieldIndex + 1
        }
        ""
    }

    /** What `field` stores: a delegated property's delegated type, else its
     *  type. */
    fun fieldStorageType(owner: string, field: string): string {
        val delegated = this.delegatedField(owner, field)
        if (delegated != "") delegated else this.fieldType(owner, field)
    }

    /** The delegated type of the class `declaration`'s delegated property
     *  `index`: its `by` expression typed where it runs, at construction,
     *  with only the earlier parameters in scope. Worked out once. */
    fun delegatedFieldType(declaration: BootstrapDeclaration, index: int): string {
        val key = "${declaration.name}.${declaration.parameters[index]}"
        var entry = 0
        while (entry < this.delegatedFieldKeys.size) {
            if (this.delegatedFieldKeys[entry] == key) {
                // "" is one that names itself while it is worked out.
                return if (this.delegatedFieldTypes[entry] == "") "unknown"
                    else this.delegatedFieldTypes[entry]
            }
            entry = entry + 1
        }
        this.delegatedFieldKeys.append(key)
        this.delegatedFieldTypes.append("")
        val savedScope = this.currentScope
        val savedOwner = this.currentOwner
        val savedSource = this.currentSourceIdentity
        this.currentScope = -1
        this.enterScope()
        this.currentOwner = ""
        this.currentSourceIdentity = declaration.sourceIdentity
        var parameter = 0
        while (parameter < index) {
            this.locals.append(BootstrapSymbol(
                declaration.parameters[parameter],
                if (parameter < declaration.parameterKinds.size &&
                    declaration.parameterKinds[parameter] == "var") "var" else "val",
                if (bootstrapIsDelegatedProperty(declaration, parameter))
                    this.delegatedFieldType(declaration, parameter)
                else bootstrapNormalizeType(declaration.parameterTypes[parameter]),
                this.currentScope,
                "",
                "abla:${declaration.sourceIdentity}:${declaration.begin}:field:${declaration.parameters[parameter]}"
            ))
            parameter = parameter + 1
        }
        val before = this.diagnostics.size
        // Its diagnostics point at the `by`.
        this.inferBegin = declaration.parameterDefaults[index].begin
        this.inferSource = declaration.sourceIdentity
        if (declaration.parameterDefaults[index].children.size > 0) {
            this.checkDelegatedInitializerScope(
                declaration, index, declaration.parameterDefaults[index].children[0], key
            )
        }
        val type = this.delegatedInitializerType(declaration.parameterDefaults[index], key)
        this.keepDelegatedFailures(before)
        this.currentScope = savedScope
        this.currentOwner = savedOwner
        this.currentSourceIdentity = savedSource
        this.delegatedFieldTypes[entry] = type
        type
    }

    /** A delegated property's `by` runs at construction, after the parameters
     *  before it: it may not read itself, a later parameter, an earlier
     *  delegated property (its field holds the delegate) or `this`. */
    fun checkDelegatedInitializerScope(
        declaration: BootstrapDeclaration,
        index: int,
        expression: BootstrapExpression,
        key: string
    ): void {
        if (expression.kind == "identifier") {
            var reason = if (expression.text == "this") "`this`, which isn't made yet" else ""
            var type = "unknown"
            var parameter = 0
            while (reason == "" && parameter < declaration.parameters.size) {
                if (declaration.parameters[parameter] == expression.text) {
                    type = if (bootstrapIsDelegatedProperty(declaration, parameter))
                        bootstrapDelegatedPropertyType(declaration, parameter)
                    else bootstrapNormalizeType(declaration.parameterTypes[parameter])
                    if (parameter == index) reason = "`${expression.text}` itself"
                    else if (parameter > index) {
                        reason = "`${expression.text}`, a later parameter"
                    } else if (bootstrapIsDelegatedProperty(declaration, parameter)) {
                        reason = "`${expression.text}`, a delegated property"
                    }
                }
                parameter = parameter + 1
            }
            if (reason != "") {
                // Where a construction filled the `by` in, the name becomes a
                // value of its type (an integer's 0, a bool's false) or, for
                // any other, an expression that never completes, so the
                // filled-in `by` reports nothing more.
                this.delegatedFailedInitializers.append(expression)
                val stand = BootstrapExpression("while", "", expression.begin, expression.end, [
                    BootstrapExpression("true", "true", expression.begin, expression.end, []),
                    BootstrapExpression("block", "", expression.begin, expression.end, [])
                ])
                this.delegatedFailedReplacements.append(
                    if (bootstrapIsIntegerScalarType(type))
                        BootstrapExpression("integer", "0", expression.begin, expression.end, [])
                    else if (type == "bool")
                        BootstrapExpression("false", "false", expression.begin, expression.end, [])
                    else stand
                )
                this.inferBegin = expression.begin
                this.fail(
                    "delegate.initializer-scope:the `by` of `$key` reads $reason: it may read only the parameters before it"
                )
            }
        }
        for (child in expression.children) {
            this.checkDelegatedInitializerScope(declaration, index, child, key)
        }
        return
    }

    /** Keeps the delegate diagnostics reported since `before` for the
     *  property rewrite: the rest are reported again over the plain code. */
    fun keepDelegatedFailures(before: int): void {
        val added = this.diagnostics.slice(before, this.diagnostics.size)
        var keeping = false
        var begin = 0
        while (begin < added.size) {
            var end = begin
            while (end < added.size && added[end] != 10) end = end + 1
            val line = added.slice(begin, end)
            // An error's own lines (its source, its help) follow it.
            if (line.size >= 6 && line.slice(0, 6) == "error[") {
                keeping = (line.size >= 16 && line.slice(0, 16) == "error[E_DELEGATE") ||
                    (line.size >= 21 && line.slice(0, 21) == "error[E_NOT_DELEGATED")
            }
            if (keeping) this.delegatedFailures = "${this.delegatedFailures}$line\n"
            begin = end + 1
        }
        return
    }

    /** Whether the delegated type's delegate takes assignments
     *  (`setValue(T): void`); one that doesn't was reported with its property. */
    fun delegatedHasSetter(delegated: string): bool {
        val delegate = bootstrapDelegatedStorageType(delegated)
        this.methodParameterCount(delegate, "setValue") == 1 &&
            this.methodResultType(delegate, "setValue") == "void"
    }

    /** A delegated property's diagnostic: kept for the rewrite. */
    fun failProperty(code: string): void {
        val before = this.diagnostics.size
        this.fail(code)
        this.delegatedFailures =
            "${this.delegatedFailures}${this.diagnostics.slice(before, this.diagnostics.size)}"
        return
    }

    /** Whether `name` here is a delegated property of the method's class (no
     *  local hides it): the bare-name forms of the accesses. */
    fun namesDelegatedField(name: string): bool =
        this.currentOwner != "" && this.visibleLocalIndex(name) < 0 &&
            this.delegatedField(this.currentOwner, name) != ""

    fun recordDelegatedRewrite(expression: BootstrapExpression, action: string, type: string = ""): void {
        this.delegatedRewrites.append(BootstrapDelegatedRewrite(
            this.currentSourceIdentity, expression.begin, expression.end,
            expression.kind, expression.text, action, type
        ))
        return
    }

    /** The body a transaction check event belongs to: a lambda's (-2: it may
     *  run anywhere), a declaration's or method's handle, or -3 (an action). */
    fun stmOwner(): int =
        if (this.stmLambdaDepth > 0) -2
        else if (this.initEdges.owner >= 0) this.initEdges.owner
        else -3

    fun stmNote(kind: string, target: int, begin: int, text: string): void {
        if (!this.stmEnabled) return
        this.stmKinds.append(kind)
        this.stmOwners.append(this.stmOwner())
        this.stmInside.append(this.atomicDepth > 0)
        this.stmTargets.append(target)
        this.stmBegins.append(begin)
        this.stmSources.append(this.currentSourceIdentity)
        this.stmTexts.append(text)
        return
    }

    /** Inside a transaction, a change through `place` (`name`, `name.f…`,
     *  `name[i]…`) must reach a TVar or what the transaction made: a local
     *  declared inside it. A captured outer local, a global or an outside
     *  object is stm.outside-mutation, as an abandoned attempt would leave
     *  it changed. */
    fun stmCheckMutation(place: BootstrapExpression, at: int, what: string): void {
        if (!this.stmEnabled) return
        val root = bootstrapPlaceRootName(place)
        val global = root != "" && !this.hasVisibleLocal(root) &&
            (this.currentOwner == "" || this.fieldType(this.currentOwner, root) == "unknown") &&
            (this.findKind(root) == "var" || this.findKind(root) == "val")
        // (The runtime's own globals, a collection's bookkeeping, aren't the
        // program's state.)
        if (global && !this.isTransactionalType(this.delegateType(root)) &&
            !bootstrapRuntimeModuleSource(this.currentSourceIdentity)) {
            this.stmNote("global", -1, at, root)
        }
        if (this.atomicDepth == 0) return
        if (root != "" && this.hasVisibleLocal(root) &&
            this.visibleLocalScope(root) >= this.stmScopeFloor) return
        this.fail("stm.outside-mutation:${if (what == "") root else what}@$at")
        return
    }

    /** The module that declares `name` privately, when the current module
     *  can't see it (its declarations carry their module's prefix), or "". */
    fun privateModuleOf(name: string): string {
        for (declaration in this.declarations) {
            if (declaration.isPrivate && declaration.extensionOwner == "" &&
                declaration.name != name &&
                bootstrapSourceVisibleType(declaration.name) == name &&
                bootstrapGenericSourceFile(declaration.sourceIdentity) !=
                    bootstrapGenericSourceFile(this.currentSourceIdentity)) {
                return bootstrapGenericSourceFile(declaration.sourceIdentity)
            }
        }
        ""
    }

    /** The module of another module's private extension function or field
     *  `owner.name`, or "". */
    fun privateExtensionModule(owner: string, name: string): string {
        if (this.privateExtensionsKnown < 0) {
            this.privateExtensionsKnown = 0
            for (declaration in this.declarations) {
                if (declaration.isPrivate && declaration.extensionOwner != "") {
                    this.privateExtensionsKnown = 1
                }
            }
        }
        if (this.privateExtensionsKnown == 0) return ""
        for (declaration in this.declarations) {
            if (declaration.isPrivate && declaration.name == name &&
                declaration.extensionOwner != "" &&
                bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                bootstrapGenericSourceFile(declaration.sourceIdentity) !=
                    bootstrapGenericSourceFile(this.currentSourceIdentity)) {
                return bootstrapGenericSourceFile(declaration.sourceIdentity)
            }
        }
        ""
    }

    /** The symbol of the extension field `owner.field` (`var Owner.field: T`),
     *  -1 when there is none. A declared field of the class comes first. */
    fun extensionFieldSymbol(owner: string, field: string): int {
        val index = this.symbolIndex("$owner.$field")
        if (index >= 0 && bootstrapIsExtensionFieldKind(this.symbols[index].kind)) index
        else -1
    }

    /** An extension field's declaration: a typed default, no delegate, a class
     *  as its owner and no member of that class with its name. */
    fun validateExtensionField(declaration: BootstrapDeclaration): void {
        val name = "${declaration.extensionOwner}.${declaration.name}"
        if (declaration.resultType == "inferred") {
            this.fail("field.extension-untyped:$name")
        }
        if (declaration.expression.kind == "missing") {
            this.fail("field.extension-default:$name")
        }
        if (declaration.expression.kind == "delegate.initializer") {
            this.fail("field.extension-delegate:$name@${declaration.expression.begin}")
        }
        val ownerIndex = this.typeDeclarations.find(declaration.extensionOwner)
        val owner = if (ownerIndex >= 0) this.declarations[ownerIndex]
            else declaration
        if (ownerIndex < 0 || owner.kind != "class" ||
            owner.name != declaration.extensionOwner) {
            this.fail("field.extension-owner:${declaration.extensionOwner}")
        } else {
            var shadows = false
            var parameter = 0
            while (parameter < owner.parameters.size) {
                if (owner.parameters[parameter] == declaration.name &&
                    parameter < owner.parameterKinds.size &&
                    (owner.parameterKinds[parameter] == "val" ||
                     owner.parameterKinds[parameter] == "var")) shadows = true
                parameter = parameter + 1
            }
            for (method in owner.methods) {
                if (method.name == declaration.name) shadows = true
            }
            if (shadows) this.fail("field.extension-shadows:$name")
            // A field never changes what its class is to modules that don't
            // see it: an affine one (a resource, Shared, Weak, Mutex…) only on
            // a class that is affine already.
            if (declaration.resultType != "inferred" &&
                this.typeIsAffine(bootstrapNormalizeType(declaration.resultType)) &&
                !this.typeIsAffine(declaration.extensionOwner)) {
                this.fail("field.extension-resource:$name")
            }
        }
        return
    }

    fun fieldDeclarationIdentity(owner: string, field: string): string {
        var identity = ""
        val declarationIndex = this.typeDeclarations.find(owner)
        if (declarationIndex >= 0) {
            val declaration = this.declarations[declarationIndex]
            var fieldIndex = 0
            while (fieldIndex < declaration.parameters.size) {
                if (declaration.parameters[fieldIndex] == field &&
                    fieldIndex < declaration.parameterKinds.size &&
                    (declaration.parameterKinds[fieldIndex] == "val" ||
                     declaration.parameterKinds[fieldIndex] == "var")) {
                    identity = "abla:${declaration.sourceIdentity}:${declaration.begin}:field:$fieldIndex:$field"
                }
                fieldIndex = fieldIndex + 1
            }
        }
        if (identity == "") {
            val extension = this.extensionFieldSymbol(owner, field)
            if (extension >= 0) identity = this.symbols[extension].identity
        }
        identity
    }

    fun fieldIsMutable(owner: string, field: string): bool {
        var result = false
        val declarationIndex = this.typeDeclarations.find(owner)
        if (declarationIndex >= 0) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.name == owner) {
                var fieldIndex = 0
                while (fieldIndex < declaration.parameters.size) {
                    if (declaration.parameters[fieldIndex] == field &&
                        fieldIndex < declaration.parameterKinds.size) {
                        result = declaration.parameterKinds[fieldIndex] == "var"
                    }
                    fieldIndex = fieldIndex + 1
                }
            }
        }
        // An extension `val` is assigned once per object (a second assignment
        // traps when the program runs), so both kinds take assignments.
        if (!result && this.extensionFieldSymbol(owner, field) >= 0) result = true
        result
    }

    fun typeHasDrop(type: string): bool {
        val normalized = bootstrapNormalizeType(type)
        var found = false
        val declarationIndex = this.typeDeclarations.find(normalized)
        if (declarationIndex >= 0) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.kind == "class" &&
                declaration.name == normalized) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    if (declaration.methods[methodIndex].name == "drop") {
                        found = true
                    }
                    methodIndex = methodIndex + 1
                }
            }
        }
        found
    }

    fun methodResultType(owner: string, method: string, at: int = -1): string {
        var result = "unknown"
        val entry = this.methodDeclarations.find(owner, method)
        if (entry >= 0) {
            val declaration = this.methodDeclarations.declarations[entry]
            if (this.initEdges.owner >= 0 || this.initEdges.threadBody >= 0) {
                bootstrapInitRecord(this, this.methodDeclarations.handles[entry])
            }
            if (declaration.resultType != "inferred") {
                result = bootstrapNormalizeType(declaration.resultType)
            } else result = bootstrapResolvedResultType(
                this,
                declaration,
                this.methodDeclarations.handles[entry],
                if (declaration.extensionOwner == "") owner else "",
                at
            )
        }
        result
    }

    fun methodParameterCount(owner: string, method: string): int {
        var result = -1
        val entry = this.methodDeclarations.find(owner, method)
        if (entry >= 0) {
            result = this.methodDeclarations.declarations[entry].parameters.size
        }
        result
    }

    fun methodRequiredParameterCount(owner: string, method: string): int {
        var result = -1
        val entry = this.methodDeclarations.find(owner, method)
        if (entry >= 0) {
            val declaration = this.methodDeclarations.declarations[entry]
            result = 0
            var parameter = 0
            while (parameter < declaration.parameters.size) {
                if (parameter >= declaration.parameterDefaults.size ||
                    declaration.parameterDefaults[parameter].kind ==
                        "missing") {
                    result = result + 1
                }
                parameter = parameter + 1
            }
        }
        result
    }

    fun methodParameterType(
        owner: string,
        method: string,
        parameter: int
    ): string {
        var result = "unknown"
        val entry = this.methodDeclarations.find(owner, method)
        if (entry >= 0) {
            val declaration = this.methodDeclarations.declarations[entry]
            if (parameter < declaration.parameterTypes.size) {
                result = bootstrapNormalizeType(
                    declaration.parameterTypes[parameter]
                )
            }
        }
        result
    }

    fun methodParameterKind(
        owner: string,
        method: string,
        parameter: int
    ): string {
        var result = "parameter"
        val entry = this.methodDeclarations.find(owner, method)
        if (entry >= 0) {
            val declaration = this.methodDeclarations.declarations[entry]
            if (parameter < declaration.parameterKinds.size) {
                result = declaration.parameterKinds[parameter]
            }
        }
        result
    }

    // The probe pass of overload.ab: which candidate an overloaded call, or an
    // operator on an operand with operator functions, selects. Candidates are
    // read through the same declaration tables as ordinary calls; `owner` is
    // "" for a free function.
    fun overloadDeclarationIndex(owner: string, name: string): int =
        if (owner == "") this.functionDeclarations.find(name)
        else this.methodDeclarations.find(owner, name)

    fun overloadDeclaration(owner: string, index: int): BootstrapDeclaration =
        if (owner == "") this.declarations[index]
        else this.methodDeclarations.declarations[index]

    /** The candidate for `key` (as spelled at the call) accepting
     *  `argumentTypes`, preferring the most exact parameter matches; "" when
     *  none fits or two fit equally (recorded in overloadFailures, at the
     *  call `at`). */
    fun chooseOverload(
        at: BootstrapExpression,
        owner: string,
        key: string,
        argumentTypes: array<string>,
        operatorOnly: bool
    ): string {
        var best = ""
        var bestExact = -1
        var ambiguous = false
        var candidate = 0
        while (candidate < this.overloads.keys.size) {
            val name = this.overloads.names[candidate]
            val index = this.overloadDeclarationIndex(owner, name)
            if (this.overloads.keys[candidate] == key && index >= 0 &&
                (!operatorOnly || this.overloads.operators[candidate])) {
                val declaration = this.overloadDeclaration(owner, index)
                var required = 0
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter >= declaration.parameterDefaults.size ||
                        declaration.parameterDefaults[parameter].kind == "missing") {
                        required = required + 1
                    }
                    parameter = parameter + 1
                }
                var fits = argumentTypes.size >= required &&
                    argumentTypes.size <= declaration.parameterTypes.size
                var exact = 0
                var argument = 0
                while (fits && argument < argumentTypes.size) {
                    val expected = bootstrapNormalizeType(declaration.parameterTypes[argument])
                    val actual = bootstrapBorrowElementType(argumentTypes[argument])
                    // An operator applies only to operands known to fit it.
                    if (expected == actual) exact = exact + 1
                    else if ((operatorOnly && (actual == "unknown" || actual == "any")) ||
                             !this.typesOrUpcast(expected, actual)) fits = false
                    argument = argument + 1
                }
                if (fits && exact > bestExact) {
                    best = name
                    bestExact = exact
                    ambiguous = false
                } else if (fits && exact == bestExact) ambiguous = true
            }
            candidate = candidate + 1
        }
        if (ambiguous || (best == "" && !operatorOnly)) {
            var types = ""
            for (type in argumentTypes) types = if (types == "") type else "$types,$type"
            val reason = if (ambiguous) "ambiguous" else "no-match"
            this.overloadFailures = "${this.overloadFailures}error[E_SEMANTIC]: call.overload-$reason:$key($types)\nsource[semantic]:${this.currentSourceIdentity}:${at.begin}:${if (at.end > at.begin) at.end else at.begin + 1}\n"
            // The `\$json` subparser wraps each value in this helper: say what the
            // literal accepts rather than naming the helper alone.
            if (!ambiguous && key == "ablaJsonValue") {
                this.overloadFailures = "${this.overloadFailures}help: \$json can't convert a value of type $types: a value must be a Json, string, int, bool, f64 or JsonNumber, or an array of Json, string, int, f64 or bool\n"
            }
            return ""
        }
        best
    }

    /** Record that the node `expression` becomes `kind` calling `name`, and
     *  return that call's type. */
    fun resolveOverload(
        expression: BootstrapExpression,
        kind: string,
        owner: string,
        name: string,
        children: array<BootstrapExpression>
    ): string {
        this.overloadResolutions.append(BootstrapOverloadResolution(
            this.currentSourceIdentity, expression.begin, expression.end,
            expression.kind, expression.text, kind, name
        ))
        val index = this.overloadDeclarationIndex(owner, name)
        val declaration = this.overloadDeclaration(owner, index)
        // An inferred result is its body's (ct_infer.ab).
        bootstrapResolvedResultType(
            this,
            declaration,
            if (owner == "") index else this.methodDeclarations.handles[index],
            if (owner != "" && declaration.extensionOwner == "") owner else "",
            expression.begin
        )
    }

    /** The type of an overloaded free call, else "" (nothing inferred). */
    fun inferOverloadedCall(expression: BootstrapExpression): string {
        if (!this.overloads.has(expression.text, false) ||
            this.hasVisibleLocal(expression.text)) return ""
        val types: array<string> = []
        for (child in expression.children) types.append(this.infer(child))
        // An invalid argument stands for an error already reported (a failed
        // subparser's stand-in): it picks no candidate, and is no new error.
        if (bootstrapHasInvalidChild(expression, 0)) return "unknown"
        val chosen = this.chooseOverload(expression, "", expression.text, types, false)
        if (chosen == "") return "unknown"
        this.resolveOverload(expression, "call", "", chosen, expression.children)
    }

    /** The type of an overloaded method call on `receiver` (already inferred),
     *  else "" (nothing more inferred). */
    fun inferOverloadedMethodCall(expression: BootstrapExpression, receiver: string): string {
        val key = "$receiver.${expression.text}"
        if (!this.overloads.has(key, false)) return ""
        val types: array<string> = []
        var argument = 1
        while (argument < expression.children.size) {
            types.append(this.infer(expression.children[argument]))
            argument = argument + 1
        }
        if (bootstrapHasInvalidChild(expression, 1)) return "unknown"
        val chosen = this.chooseOverload(expression, receiver, key, types, false)
        if (chosen == "") return "unknown"
        this.resolveOverload(expression, "member.call", receiver, chosen, expression.children)
    }

    /** An operator on operand types with an operator function: `a + b` calls
     *  `A.plus(b)`, `-a` calls `A.unaryMinus()`. "" when no operator applies. */
    fun inferOperatorCall(expression: BootstrapExpression, operandTypes: array<string>): string {
        val operator = bootstrapOperatorFunctionName(expression.kind)
        if (operator == "" || this.overloads.keys.size == 0) return ""
        val receiver = bootstrapBorrowElementType(operandTypes[0])
        val key = "$receiver.$operator"
        if (!this.overloads.has(key, true)) return ""
        val arguments: array<string> = []
        var operand = 1
        while (operand < operandTypes.size) {
            arguments.append(operandTypes[operand])
            operand = operand + 1
        }
        val chosen = this.chooseOverload(expression, receiver, key, arguments, true)
        if (chosen == "") return ""
        this.resolveOverload(expression, "member.call", receiver, chosen, expression.children)
    }

    fun delegatedInitializerType(
        expression: BootstrapExpression,
        binding: string
    ): string {
        var delegateType = "unknown"
        var exposedType = "unknown"
        if (expression.children.size != 2) {
            this.fail("delegate.getter-missing:$binding has no delegate initializer")
        } else {
            val rawDelegateType = this.infer(expression.children[0])
            delegateType = bootstrapBorrowElementType(rawDelegateType)
            if (bootstrapIsBorrowType(rawDelegateType)) {
                this.fail("ownership.borrow-store:delegate.$binding")
            }
            // Checking the contract calls nothing: the getter and setter run
            // where the binding is read and written (validateDelegatedRead,
            // the assignment), inside a transaction for a transactional one.
            val stmEnabled = this.stmEnabled
            this.stmEnabled = false
            val getterParameters = this.methodParameterCount(
                delegateType,
                "getValue"
            )
            val getterResult = this.methodResultType(
                delegateType,
                "getValue"
            )
            if (getterParameters != 0 || getterResult == "unknown" ||
                getterResult == "void") {
                this.fail(
                    "delegate.getter-missing:`$delegateType` does not provide `getValue()` required by `$binding`"
                )
            }
            exposedType = getterResult
            val declared = expression.children[1].text
            if (declared != "inferred") {
                exposedType = bootstrapNormalizeType(declared)
                if (!bootstrapTypesCompatible(exposedType, getterResult)) {
                    this.fail(
                        "delegate.getter-missing:`$delegateType.getValue()` does not return `$exposedType` required by `$binding`"
                    )
                }
            }
            if (!bootstrapIsBorrowType(getterResult) &&
                this.typeIsAffine(getterResult)) {
                this.fail(
                    "delegate.affine-value:`$binding` getter returns owned affine `$getterResult`"
                )
            }
            if (expression.text == "var") {
                val setterParameters = this.methodParameterCount(
                    delegateType,
                    "setValue"
                )
                val setterResult = this.methodResultType(
                    delegateType,
                    "setValue"
                )
                val setterInput = this.methodParameterType(
                    delegateType,
                    "setValue",
                    0
                )
                if (setterParameters != 1 || setterResult != "void" ||
                    !bootstrapTypesCompatible(setterInput, exposedType)) {
                    this.fail(
                        "delegate.setter-missing:mutable `$binding` requires `$delegateType.setValue($exposedType) -> void`"
                    )
                }
            }
            val getter = this.selectedMethodHandle(
                delegateType,
                "getValue"
            )
            if (getter >= 0 && this.selectedHandleIsCompileOnly(getter) &&
                this.compileDepth == 0) {
                this.fail("compile.call-runtime:$delegateType.getValue")
            }
            this.stmEnabled = stmEnabled
        }
        bootstrapDelegatedType(
            expression.text == "var",
            delegateType,
            exposedType
        )
    }

    fun validateDelegatedRead(
        expression: BootstrapExpression,
        name: string
    ): void {
        val owner = this.delegateType(name)
        // The getter runs here (the transactions' checks: bootstrapCheckStm);
        // a runtime-valued class's (a TVar's) is the runtime's.
        if (!this.isRuntimeValueType(owner)) {
            this.stmNote("call", this.selectedMethodHandle(owner, "getValue"), expression.begin, "")
        }
        val receiverKind = this.methodReceiverKind(owner, "getValue")
        if (receiverKind == "var" && this.hasVisibleLocal(name)) {
            this.validateMutableBorrowArgument(
                BootstrapExpression(
                    "delegate.project",
                    "",
                    expression.begin,
                    expression.end,
                    [BootstrapExpression(
                        "identifier",
                        name,
                        expression.begin,
                        expression.end,
                        []
                    )]
                ),
                owner,
                "delegate.get.$name"
            )
        }
        this.recordTypedCall(
            expression,
            this.findType(name),
            owner,
            this.selectedMethodHandle(owner, "getValue"),
            [],
            [],
            [],
            0
        )
    }

    fun functionParameterCount(name: string): int {
        var result = -1
        val index = this.functionDeclarations.find(name)
        if (index >= 0) {
            result = this.declarations[index].parameters.size
        }
        result
    }

    /** Whether `name` is the compiler's own API (`extern:"compiler"` or
     *  `extern:"parser"`), which exists only while the program compiles. */
    fun functionIsCompilerApi(name: string): bool {
        val index = this.functionDeclarations.find(name)
        if (index < 0) return false
        val declaration = this.declarations[index]
        declaration.kind == "extern" &&
            (declaration.externalLibrary == "compiler" || declaration.externalLibrary == "parser")
    }

    fun functionRequiresTrust(name: string): bool {
        var requiresTrust = false
        val index = this.functionDeclarations.find(name)
        if (index >= 0) {
            val declaration = this.declarations[index]
            if (declaration.kind == "extern" &&
                declaration.isTrusted) {
                requiresTrust = true
            }
        }
        requiresTrust
    }

    fun functionExternalLibrary(name: string): string {
        var library = ""
        val index = this.functionDeclarations.find(name)
        if (index >= 0 && this.declarations[index].kind == "extern") {
            library = this.declarations[index].externalLibrary
        }
        library
    }

    fun functionIsNoEscape(name: string): bool {
        var noEscape = false
        val index = this.functionDeclarations.find(name)
        if (index >= 0 && this.declarations[index].kind == "extern") {
            noEscape = this.declarations[index].isNoEscape
        }
        noEscape
    }

    fun typeIsAffine(type: string): bool =
        bootstrapSummaryTypeIsAffine(type, this.affineTypes)

    fun typeIsManagedReferenceAt(type: string, depth: int): bool {
        val normalized = bootstrapNormalizeType(type)
        if (bootstrapScalarTypeUnderlyingValid(normalized) ||
            normalized == "void" || normalized == "never" ||
            normalized == "unknown" || normalized == "string" ||
            normalized == "cstring" ||
            bootstrapIsFunctionType(normalized) ||
            bootstrapIsBorrowType(normalized)) return false
        if (bootstrapIsArrayType(normalized) ||
            bootstrapIsCellType(normalized) ||
            bootstrapIsMapType(normalized)) return true
        val declaration = this.typeDeclarations.find(normalized)
        if (declaration >= 0) {
            val kind = this.declarations[declaration].kind
            if (kind == "class" || kind == "interface") return true
        }
        if (depth < 32 && bootstrapIsNullableType(normalized)) {
            return this.typeIsManagedReferenceAt(
                bootstrapNullableElementType(normalized), depth + 1
            )
        }
        false
    }

    fun typeIsManagedReference(type: string): bool =
        this.typeIsManagedReferenceAt(type, 0)

    fun typeNeedsManagedAliasTrackingAt(type: string, depth: int): bool {
        val normalized = bootstrapNormalizeType(type)
        if (bootstrapScalarTypeUnderlyingValid(normalized) ||
            normalized == "void" || normalized == "never" ||
            normalized == "unknown" || normalized == "string" ||
            normalized == "cstring" ||
            bootstrapIsFunctionType(normalized) ||
            bootstrapIsBorrowType(normalized)) return false
        var element = normalized
        var nullableDepth = 0
        while (nullableDepth < 32 && bootstrapIsNullableType(element)) {
            element = bootstrapNullableElementType(element)
            nullableDepth = nullableDepth + 1
        }
        if (depth == 0 && bootstrapIsArrayType(element)) return true
        if (depth >= 32) return false
        val declaration = this.typeDeclarations.find(element)
        if (declaration < 0 ||
            this.declarations[declaration].kind != "class") return false
        val candidate = this.declarations[declaration]
        var field = 0
        while (field < candidate.parameterTypes.size) {
            if (field < candidate.parameterKinds.size &&
                candidate.parameterKinds[field] == "var") return true
            val fieldType = bootstrapNormalizeType(
                candidate.parameterTypes[field]
            )
            if (!bootstrapIsArrayType(fieldType) &&
                this.typeNeedsManagedAliasTrackingAt(
                    fieldType, depth + 1
                )) return true
            field = field + 1
        }
        false
    }

    fun typeNeedsManagedAliasTracking(type: string): bool =
        this.typeNeedsManagedAliasTrackingAt(type, 0)

    fun typeIsBorrowTracked(type: string): bool {
        this.typeIsAffine(type) || this.typeIsManagedReference(type)
    }

    fun methodReceiverKind(owner: string, method: string): string {
        if (bootstrapMutableReceiverContains(
                this.mutableReceivers,
                owner,
                method
        )) "var" else "parameter"
    }

    // A fresh `val` passed to a constructor moves into it when the body never
    // reads it again: it appears once among the arguments, nothing refers to
    // it after the call, and no loop or lambda between its declaration and
    // the call could run the call again. `val x = M("x"); Pair(x, y)` then
    // stores fresh objects instead of borrowing two locals.
    fun localMovesInto(
        call: BootstrapExpression,
        argument: BootstrapExpression
    ): bool {
        if (argument.kind != "identifier" ||
            !this.hasVisibleLocal(argument.text) ||
            this.visibleLocalKind(argument.text) != "val" ||
            this.visibleBorrowSource(argument.text) != "managed.fresh" ||
            this.currentBody.kind == "missing" || call.end <= call.begin) {
            return false
        }
        val name = argument.text
        if (bootstrapNameReferences(call, name, 0) != 1) return false
        if (bootstrapNameReferences(this.currentBody, name, call.end) > 0) {
            return false
        }
        val declared = bootstrapLocalDeclarationBefore(
            this.currentBody, name, call.begin
        )
        declared >= 0 && !bootstrapRepeatsBetween(this.currentBody, declared, call)
    }

    fun constructorStoredBorrowSource(
        expression: BootstrapExpression
    ): string {
        var source = ""
        val declaration = this.typeDeclarations.find(expression.text)
        if (declaration >= 0) {
            val candidate = this.declarations[declaration]
            if (candidate.kind == "class" && !candidate.isResource) {
                var mutableContainer = false
                var field = 0
                while (!mutableContainer &&
                       field < candidate.parameterKinds.size) {
                    if (candidate.parameterKinds[field] == "var") {
                        mutableContainer = true
                    }
                    field = field + 1
                }
                var parameter = 0
                while (!mutableContainer &&
                       parameter < candidate.parameterTypes.size &&
                       parameter < expression.children.size) {
                    val expected = bootstrapNormalizeType(
                        candidate.parameterTypes[parameter]
                    )
                    if (!this.typeIsAffine(expected) &&
                        !bootstrapIsArrayType(expected) &&
                        this.typeNeedsManagedAliasTracking(expected) &&
                        !this.expressionProducesFreshManagedReference(
                            expression.children[parameter],
                            0,
                            false
                        ) && !this.localMovesInto(
                            expression, expression.children[parameter]
                        )) {
                        var found = this.borrowArgumentSource(
                            expression.children[parameter]
                        )
                        if (found == "") found = "managed.unknown"
                        if (source == "") source = found
                        else if (source != found) source = "managed.multiple"
                    }
                    parameter = parameter + 1
                }
            }
        }
        source
    }

    /** Whether `name` (an identifier at the tail of `block`, or an argument of
     *  its tail call) is a `val` of that block initialized with a fresh managed
     *  reference — the block's locals are out of scope once its value is checked. */
    fun blockLocalIsFresh(
        block: BootstrapExpression,
        name: BootstrapExpression,
        depth: int
    ): bool {
        var fresh = false
        if (name.kind == "identifier") {
            var statement = block.children.size - 1
            while (!fresh && statement > 0) {
                statement = statement - 1
                val candidate = block.children[statement]
                // A `var` the block never assigns again (`var b = [..]`,
                // then only `b[i] = ..`) holds its fresh initializer too.
                if ((candidate.kind == "local.val" ||
                     (candidate.kind == "local.var" &&
                      !bootstrapExpressionAssigns(block, name.text))) &&
                    candidate.text == name.text &&
                    candidate.children.size > 0) {
                    fresh = this.expressionProducesFreshManagedReference(
                        candidate.children[0], depth, false
                    )
                }
            }
        }
        fresh
    }

    /** A constructor (at the tail of `block`, or `block` itself) whose stored
     *  references are all fresh: constructed inline, or fresh locals — visible
     *  ones, or `val`s of the block (see constructorStoredBorrowSource for
     *  which arguments count as stored). */
    fun constructorStoresOnlyFreshLocals(
        block: BootstrapExpression,
        call: BootstrapExpression,
        depth: int,
        allowLocals: bool,
        allowParameters: bool
    ): bool {
        val declaration = this.typeDeclarations.find(call.text)
        if (declaration < 0) return false
        val candidate = this.declarations[declaration]
        if (candidate.kind != "class" || candidate.isResource) return false
        var fresh = true
        var parameter = 0
        while (fresh &&
               parameter < candidate.parameterTypes.size &&
               parameter < call.children.size) {
            val expected = bootstrapNormalizeType(
                candidate.parameterTypes[parameter]
            )
            if (!this.typeIsAffine(expected) &&
                !bootstrapIsArrayType(expected) &&
                this.typeNeedsManagedAliasTracking(expected)) {
                val argument = call.children[parameter]
                fresh = this.expressionProducesFreshManagedReference(
                    argument, depth + 1, true
                ) || (allowLocals &&
                    this.blockLocalIsFresh(block, argument, depth + 1)) ||
                    (allowParameters && this.placeOfParameter(block, argument))
            }
            parameter = parameter + 1
        }
        fresh
    }

    /** A returned borrow that is a new object storing only the function's own
     *  fresh locals (`val box = Box(); Pair(box, 1)`): they end at the return,
     *  so the borrow is not an escape. One storing a parameter is a view of
     *  it, which needs a `borrow(parameter)` result (borrow_inference.ab infers
     *  it for `B(root)` and `val b = B(root); b`). */
    fun returnedBorrowIsOwned(expression: BootstrapExpression): bool {
        var call = expression
        var allowLocals = true
        if (expression.kind == "block" && expression.children.size > 0) {
            call = expression.children[expression.children.size - 1]
            // `val b = B(root); b`: the block's own `val` holding such an object.
            // Its locals may be used after the constructor, so only parameters
            // and fresh values count there.
            if (call.kind == "identifier") {
                allowLocals = false
                var statement = expression.children.size - 1
                while (statement > 0) {
                    statement = statement - 1
                    val candidate = expression.children[statement]
                    if (candidate.kind == "local.val" &&
                        candidate.text == call.text &&
                        candidate.children.size > 0) {
                        call = candidate.children[0]
                        statement = 0
                    }
                }
            }
        }
        call.kind == "call" && this.findKind(call.text) == "class" &&
            this.constructorStoresOnlyFreshLocals(
                expression, call, 0, allowLocals, false
            )
    }

    /** Whether `expression`, at the tail of `block`, is a parameter, the
     *  receiver, or a place under one (`h.n`, `h.items[i]`), borrowed shared
     *  or owned but not `var`, and not shadowed by a local of the block. */
    fun placeOfParameter(
        block: BootstrapExpression,
        expression: BootstrapExpression
    ): bool {
        val root = bootstrapPlaceRootName(expression)
        if (root == "") return false
        if (block.kind == "block") {
            for (statement in block.children) {
                if ((statement.kind == "local.val" ||
                     statement.kind == "local.var") &&
                    statement.text == root) return false
            }
        }
        val kind = this.visibleLocalKind(root)
        kind == "parameter" || kind == "owned.parameter"
    }

    // A block's value is fresh when it is fresh itself, a fresh local of the
    // block, or a branching value each of whose branches is
    // (`val out = make(); if (ok) out else []`).
    fun blockValueIsFresh(
        block: BootstrapExpression,
        value: BootstrapExpression,
        depth: int,
        allowVisibleLocals: bool
    ): bool {
        if (this.expressionProducesFreshManagedReference(
            value, depth, allowVisibleLocals
        )) return true
        if (value.kind == "identifier") {
            return this.blockLocalIsFresh(block, value, depth)
        }
        // `val x = M(); val y = M(); Pair(x, y)`: the locals move into it.
        if (value.kind == "call" && this.findKind(value.text) == "class") {
            return this.constructorStoresOnlyFreshLocals(
                block, value, depth, true, false
            )
        }
        if (value.kind == "if" && value.children.size > 2 &&
            value.children[2].kind != "missing") {
            return this.blockValueIsFresh(
                block, value.children[1], depth, allowVisibleLocals
            ) && this.blockValueIsFresh(
                block, value.children[2], depth, allowVisibleLocals
            )
        }
        if (value.kind == "block" && value.children.size > 0) {
            return this.blockValueIsFresh(
                block, value.children[value.children.size - 1],
                depth, allowVisibleLocals
            )
        }
        false
    }

    fun expressionProducesFreshManagedReference(
        expression: BootstrapExpression,
        depth: int,
        allowVisibleLocals: bool
    ): bool {
        var fresh = expression.kind == "array" ||
            expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            (expression.kind == "call" && expression.text == "filledArray")
        if (!fresh && allowVisibleLocals &&
            expression.kind == "identifier" &&
            this.hasVisibleLocal(expression.text)) {
            var local = this.locals.size - 1
            while (!fresh && local >= 0) {
                val candidate = this.locals[local]
                if (candidate.name == expression.text &&
                    this.scopeIsVisible(candidate.scope) &&
                    candidate.borrowSource == "managed.fresh") fresh = true
                local = local - 1
            }
        }
        if (!fresh && expression.kind == "call" &&
            this.findKind(expression.text) == "class") {
            fresh = this.constructorStoredBorrowSource(expression) == ""
        }
        if (!fresh && expression.kind == "block" &&
            expression.children.size > 0) {
            val tail = expression.children[expression.children.size - 1]
            fresh = this.blockValueIsFresh(
                expression, tail, depth, allowVisibleLocals
            )
        }
        if (!fresh && expression.kind == "if" &&
            expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            fresh = this.expressionProducesFreshManagedReference(
                expression.children[1],
                depth,
                allowVisibleLocals
            ) && this.expressionProducesFreshManagedReference(
                expression.children[2],
                depth,
                allowVisibleLocals
            )
        }
        if (!fresh && expression.kind == "when") {
            var branch = 2
            var allFresh = branch < expression.children.size
            while (allFresh && branch < expression.children.size) {
                allFresh = this.expressionProducesFreshManagedReference(
                    expression.children[branch],
                    depth,
                    allowVisibleLocals
                )
                branch = branch + 2
            }
            fresh = allFresh
        }
        if (!fresh &&
            (expression.kind == "compile" || expression.kind == "region") &&
            expression.children.size > 0) {
            fresh = this.expressionProducesFreshManagedReference(
                expression.children[0], depth, allowVisibleLocals
            )
        }
        // A view of a new value is that value (borrowResultOfFreshSource).
        if (!fresh && (expression.kind == "call" ||
            expression.kind == "member.call") && depth < 32) {
            val result = if (expression.kind == "call") {
                this.borrowResultOfFreshSource(
                    bootstrapFunctionResultType(this.findType(expression.text)),
                    "", expression, 0
                )
            } else {
                val receiver = bootstrapBorrowElementType(
                    this.ownershipExpressionType(expression.children[0])
                )
                this.borrowResultOfFreshSource(
                    this.methodResultType(receiver, expression.text),
                    receiver, expression, 1
                )
            }
            val declared = if (expression.kind == "call") {
                bootstrapFunctionResultType(this.findType(expression.text))
            } else this.methodResultType(
                bootstrapBorrowElementType(
                    this.ownershipExpressionType(expression.children[0])
                ),
                expression.text
            )
            fresh = bootstrapIsBorrowType(declared) && !bootstrapIsBorrowType(result)
        }
        if (!fresh && expression.kind == "call" && depth < 32) {
            val declaration = this.functionDeclarations.find(
                expression.text
            )
            if (declaration >= 0) {
                val candidate = this.declarations[declaration]
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun") &&
                    candidate.extensionOwner == "" &&
                    candidate.name == expression.text) {
                    fresh = this.expressionProducesFreshManagedReference(
                        candidate.expression,
                        depth + 1,
                        false
                    )
                }
            }
        }
        // A method building its result (`fun V.copy(): V = V(this.x)`) is
        // fresh like the same body as a free function.
        if (!fresh && expression.kind == "member.call" && depth < 32) {
            fresh = this.memberCallProducesFreshManagedReference(
                expression, this.ownershipExpressionType(expression), depth + 1
            )
        }
        fresh
    }

    fun ownershipExpressionType(expression: BootstrapExpression): string {
        var result = "unknown"
        if (expression.kind == "identifier") {
            result = this.findType(expression.text)
        }
        if (expression.kind == "delegate.project" &&
            expression.children.size == 1 &&
            expression.children[0].kind == "identifier") {
            result = this.delegateType(expression.children[0].text)
        }
        if (expression.kind == "call") {
            if (this.findKind(expression.text) == "class") {
                result = expression.text
            } else {
                result = bootstrapFunctionResultType(
                    this.findType(expression.text)
                )
            }
        }
        if (expression.kind == "member" &&
            expression.children.size > 0) {
            val owner = bootstrapBorrowElementType(
                this.ownershipExpressionType(expression.children[0])
            )
            result = this.fieldType(owner, expression.text)
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            val owner = bootstrapBorrowElementType(
                this.ownershipExpressionType(expression.children[0])
            )
            result = this.methodResultType(owner, expression.text)
        }
        bootstrapNormalizeType(result)
    }

    fun memberCallProducesFreshManagedReference(
        expression: BootstrapExpression,
        expected: string,
        depth: int = 0
    ): bool {
        var fresh = false
        var owner = "unknown"
        if (expression.children.size > 0) {
            owner = bootstrapBorrowElementType(
                this.ownershipExpressionType(expression.children[0])
            )
        }
        val entry = this.methodDeclarations.find(owner, expression.text)
        if (entry >= 0) {
            val found = this.methodDeclarations.declarations[entry]
            if (bootstrapTypesCompatible(
                    expected,
                    this.methodResultType(owner, expression.text)
                )) {
                fresh = this.expressionProducesFreshManagedReference(
                    found.expression,
                    depth,
                    false
                )
                if (!fresh && this.expressionReturnsReceiver(
                        found.expression
                    )) {
                    val receiver = expression.children[0]
                    fresh = this.expressionProducesFreshManagedReference(
                        receiver,
                        0,
                        true
                    )
                    if (!fresh && receiver.kind == "member.call") {
                        fresh = this.memberCallProducesFreshManagedReference(
                            receiver,
                            owner
                        )
                    }
                }
            }
        }
        fresh
    }

    fun expressionReturnsReceiver(
        expression: BootstrapExpression
    ): bool {
        var returnsReceiver = expression.kind == "identifier" &&
            expression.text == "this"
        if (!returnsReceiver && expression.kind == "return" &&
            expression.children.size > 0) {
            returnsReceiver = this.expressionReturnsReceiver(
                expression.children[0]
            )
        }
        if (!returnsReceiver && expression.kind == "block" &&
            expression.children.size > 0) {
            returnsReceiver = this.expressionReturnsReceiver(
                expression.children[expression.children.size - 1]
            )
        }
        if (!returnsReceiver && expression.kind == "if" &&
            expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            returnsReceiver = this.expressionReturnsReceiver(
                expression.children[1]
            ) && this.expressionReturnsReceiver(expression.children[2])
        }
        returnsReceiver
    }

    fun validateMutableBorrowArgument(
        expression: BootstrapExpression,
        expected: string,
        context: string
    ): void {
        // Lent to be changed: inside a transaction, it must be its own.
        this.stmCheckMutation(expression, expression.begin, "")
        val kinds: array<int> = []
        val values: array<string> = []
        bootstrapCollectOwnershipPlace(expression, kinds, values)
        var valid = values.size > 0 && expression.kind != "call"
        if (values.size > 0 && this.hasVisibleLocal(values[0])) {
            val rootKind = this.visibleLocalKind(values[0])
            if (rootKind == "parameter") valid = false
            if (bootstrapIsBorrowType(this.findType(values[0]))) valid = false
            if (this.isSharedLoopElement(values[0])) valid = false
        } else if (values.size > 0) {
            val rootKind = this.findKind(values[0])
            valid = rootKind == "val" || rootKind == "var"
        }
        if (!valid && expression.kind == "array") valid = true
        if (!valid && expression.kind == "lambda") valid = true
        if (!valid && expression.kind == "call" &&
            this.findKind(expression.text) == "class") valid = true
        if (!valid && expression.kind == "call" &&
            this.expressionProducesFreshManagedReference(
                expression,
                0,
                true
            )) {
            valid = true
        }
        if (!valid && expression.kind == "member.call" &&
            this.memberCallProducesFreshManagedReference(
                expression,
                expected
            )) valid = true
        if (!this.typeIsBorrowTracked(expected)) valid = false
        if (!valid) this.fail("ownership.mutable-borrow:$context")
    }

    /** Whether the local `name` is a loop element of a shared parameter. */
    fun isSharedLoopElement(name: string): bool {
        val source = this.visibleBorrowSource(name)
        source.size > 7 && source.slice(0, 7) == "shared:"
    }

    /** The shared (not `var`) parameter or receiver that `place` reads from,
     *  through borrowed locals and loop elements (`val b = rows; for (r in b)`),
     *  or "" when it reads from none. */
    fun sharedParameterRoot(place: BootstrapExpression): string {
        var root = bootstrapPlaceRootName(place)
        var depth = 0
        while (root != "" && depth < 16 && this.hasVisibleLocal(root) &&
               this.visibleLocalKind(root) != "parameter") {
            val source = this.visibleBorrowSource(root)
            if (source.size > 7 && source.slice(0, 7) == "shared:") {
                root = source.slice(7, source.size)
            } else if (bootstrapIsBorrowType(this.findType(root))) {
                root = bootstrapOwnershipKeyRoot(source)
            } else root = ""
            depth = depth + 1
        }
        if (root != "" && this.hasVisibleLocal(root) &&
            this.visibleLocalKind(root) == "parameter" &&
            this.typeIsBorrowTracked(this.findType(root))) root else ""
    }

    fun validateBorrowMutation(
        receiver: BootstrapExpression,
        context: string
    ): void {
        var place = receiver
        while ((place.kind == "member" || place.kind == "index" ||
                place.kind == "delegate.project") && place.children.size > 0) {
            if (place.kind == "member") {
                this.mutationPlaceSources.append(this.currentSourceIdentity)
                this.mutationPlaceBegins.append(place.begin)
                this.mutationPlaceEnds.append(place.end)
            }
            place = place.children[0]
        }
        // A field of `this` named alone (in a method or extension function).
        if (place.kind == "identifier") {
            this.mutationPlaceSources.append(this.currentSourceIdentity)
            this.mutationPlaceBegins.append(place.begin)
            this.mutationPlaceEnds.append(place.end)
        }
        val root = bootstrapPlaceRootName(receiver)
        if (root != "" && this.hasVisibleLocal(root) &&
            ((this.visibleLocalKind(root) == "parameter" &&
              this.typeIsBorrowTracked(this.findType(root))) ||
             this.isSharedLoopElement(root))) {
            this.fail("ownership.borrow-mutation:$context:$root")
        }
    }

    fun validateOwnershipTransfer(
        expected: string,
        expression: BootstrapExpression,
        context: string
    ): void {
        if (this.typeIsAffine(expected)) {
            val returning = context == "return" ||
                (context.size >= 9 && context.slice(0, 9) == "function.") ||
                (context.size >= 7 && context.slice(0, 7) == "method.")
            if (expression.kind == "identifier" &&
                this.hasMovableLocal(expression.text) && !returning) {
                this.fail(
                    "ownership.move-required:$context:${expression.text}"
                )
            }
            if (expression.kind == "identifier" &&
                this.isBorrowedParameter(expression.text)) {
                this.fail(
                    "ownership.borrow-escape:$context:${expression.text}"
                )
            }
            // A module global cannot give up its value: the global would still
            // be live (and dropped again at exit) after the receiver drops it.
            // `move(global)` is already rejected; this closes the implicit form
            // (`val local = global`, `return global`, owned arguments, fields).
            if (expression.kind == "identifier" && this.namesGlobal(expression)) {
                this.fail(
                    "ownership.global-move:$context:${expression.text}"
                )
            }
            if (expression.kind == "member" ||
                expression.kind == "index") {
                this.fail("ownership.place-move-required:$context")
            }
            if (expression.kind == "if") {
                this.validateOwnershipTransfer(
                    expected,
                    expression.children[1],
                    context
                )
                if (expression.children[2].kind != "missing") {
                    this.validateOwnershipTransfer(
                        expected,
                        expression.children[2],
                        context
                    )
                }
            }
            if (expression.kind == "block" && expression.children.size > 0) {
                this.validateOwnershipTransfer(
                    expected,
                    expression.children[expression.children.size - 1],
                    context
                )
            }
            if (bootstrapIsArrayType(bootstrapNormalizeType(expected)) &&
                expression.kind == "array") {
                val elementType = bootstrapArrayElementType(
                    bootstrapNormalizeType(expected)
                )
                var element = 0
                while (element < expression.children.size) {
                    this.validateOwnershipTransfer(
                        elementType,
                        expression.children[element],
                        context
                    )
                    element = element + 1
                }
            }
        }
    }

    fun functionRequiredParameterCount(name: string): int {
        var result = -1
        val index = this.functionDeclarations.find(name)
        if (index >= 0) {
            val declaration = this.declarations[index]
            result = 0
            var parameter = 0
            while (parameter < declaration.parameters.size) {
                if (parameter >= declaration.parameterDefaults.size ||
                    declaration.parameterDefaults[parameter].kind ==
                        "missing") {
                    result = result + 1
                }
                parameter = parameter + 1
            }
        }
        result
    }

    fun functionParameterType(name: string, parameter: int): string {
        var result = "unknown"
        val index = this.functionDeclarations.find(name)
        if (index >= 0) {
            val declaration = this.declarations[index]
            if (parameter < declaration.parameterTypes.size) {
                result = bootstrapNormalizeType(
                    declaration.parameterTypes[parameter]
                )
            }
        }
        result
    }

    fun functionParameterKind(name: string, parameter: int): string {
        var result = "parameter"
        val index = this.functionDeclarations.find(name)
        if (index >= 0) {
            val declaration = this.declarations[index]
            if (parameter < declaration.parameterKinds.size) {
                result = declaration.parameterKinds[parameter]
            }
        }
        result
    }

    fun typedRequestIndex(expression: BootstrapExpression): int {
        var matched = -1
        var request = 0
        while (matched < 0 && request < this.typedRequestBegins.size &&
               request < this.typedRequestEnds.size &&
               request < this.typedRequestKinds.size) {
            var same = this.typedRequestBegins[request] == expression.begin &&
                this.typedRequestEnds[request] == expression.end &&
                this.typedRequestKinds[request] == expression.kind
            if (same && this.typedRequestSources.size > request &&
                this.typedRequestSources[request] != "" &&
                this.typedRequestSources[request] !=
                    this.currentSourceIdentity) same = false
            if (!same && expression.begin < 0 &&
                this.typedRequestKinds[request] == expression.kind &&
                expression.children.size > 0) {
                same = true
                var child = 0
                while (same && child < expression.children.size) {
                    val candidate = expression.children[child]
                    if (candidate.begin < this.typedRequestBegins[request] ||
                        candidate.end > this.typedRequestEnds[request]) {
                        same = false
                    }
                    child = child + 1
                }
            }
            if (same) matched = request
            request = request + 1
        }
        matched
    }

    fun topLevelFunctionHandle(name: string): int {
        this.functionDeclarations.find(name)
    }

    fun inherentMethodHandle(owner: int, method: int): int {
        var handle = this.declarations.size
        var declaration = 0
        while (declaration < owner) {
            handle = handle + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        handle + method
    }

    fun selectedMethodHandle(owner: string, name: string): int {
        val entry = this.methodDeclarations.find(owner, name)
        if (entry < 0) -1 else this.methodDeclarations.handles[entry]
    }

    fun selectedHandleIsCompileOnly(handle: int): bool {
        var result = false
        if (handle >= 0 && handle < this.declarations.size) {
            result = this.declarations[handle].kind == "compile.fun"
        }
        if (handle >= this.declarations.size) {
            val method = handle - this.declarations.size
            if (method >= 0 &&
                method < this.methodDeclarations.inherentCompileOnly.size) {
                result = this.methodDeclarations.inherentCompileOnly[method]
            }
        }
        result
    }

    fun selectedHandleIsTrusted(handle: int): bool {
        var result = false
        if (handle >= 0 && handle < this.declarations.size) {
            result = this.declarations[handle].isTrusted
        }
        if (handle >= this.declarations.size) {
            val method = handle - this.declarations.size
            if (method >= 0 &&
                method < this.methodDeclarations.inherentTrusted.size) {
                result = this.methodDeclarations.inherentTrusted[method]
            }
        }
        result
    }

    fun selectedHandleIsContract(handle: int): bool {
        var result = false
        if (handle >= 0 && handle < this.declarations.size) {
            val library = this.declarations[handle].externalLibrary
            result = library.size >= 9 &&
                library.slice(0, 9) == "contract:"
        }
        result
    }

    fun typedArgumentConversion(expected: string, actual: string): string {
        var result = "none"
        if (expected == "cstring" && actual == "string") {
            result = "string.to-cstring"
        } else if (bootstrapIsBorrowType(actual) &&
                   expected == bootstrapBorrowElementType(actual)) {
            result = "borrow.read"
        } else if (bootstrapIsNullableType(expected) &&
                   !bootstrapIsNullableType(actual)) {
            result = "nullable.inject"
        } else if (expected == "i64" && actual != "i64") {
            result = "integer.widen"
        } else if (expected != "i64" && actual == "i64" &&
                   (expected == "i8" || expected == "u8" ||
                    expected == "char" || expected == "i16" ||
                    expected == "u16" || expected == "i32" ||
                    expected == "u32")) {
            result = "integer.narrow"
        }
        result
    }

    fun recordTypedCall(
        expression: BootstrapExpression,
        resultType: string,
        receiverType: string,
        target: int,
        argumentTypes: array<string>,
        parameterTypes: array<string>,
        parameterKinds: array<string>,
        insertedDefaults: int
    ): void {
        if (this.typedRequestBegins.size == 0) return
        val request = this.typedRequestIndex(expression)
        var already = false
        var existing = 0
        while (existing < this.typedCalls.size) {
            val candidate = this.typedCalls[existing]
            if (request >= 0 &&
                candidate.sourceIdentity == this.currentSourceIdentity &&
                candidate.begin == this.typedRequestBegins[request] &&
                candidate.end == this.typedRequestEnds[request] &&
                candidate.kind == expression.kind &&
                candidate.name == expression.text) already = true
            existing = existing + 1
        }
        if (!already && request >= 0 && target >= 0) {
            val bindings: array<int> = []
            val conversions: array<string> = []
            var argument = 0
            while (argument < argumentTypes.size &&
                   argument < parameterTypes.size) {
                bindings.append(argument)
                conversions.append(this.typedArgumentConversion(
                    parameterTypes[argument], argumentTypes[argument]
                ))
                argument = argument + 1
            }
            this.typedCalls.append(BootstrapTypedCall(
                this.currentSourceIdentity,
                this.typedRequestBegins[request],
                this.typedRequestEnds[request],
                expression.kind,
                expression.text,
                bootstrapNormalizeType(resultType),
                bootstrapNormalizeType(receiverType),
                target,
                argumentTypes,
                parameterTypes,
                parameterKinds,
                bindings,
                conversions,
                insertedDefaults,
                this.selectedHandleIsCompileOnly(target),
                this.selectedHandleIsTrusted(target),
                this.selectedHandleIsContract(target)
            ))
        }
    }

    fun recordTypedExpression(
        expression: BootstrapExpression,
        type: string
    ): void {
        if (this.typedRequestBegins.size == 0) return
        val request = this.typedRequestIndex(expression)
        var already = false
        var existing = 0
        while (existing < this.typedCalls.size) {
            val candidate = this.typedCalls[existing]
            if (request >= 0 &&
                candidate.sourceIdentity == this.currentSourceIdentity &&
                candidate.begin == this.typedRequestBegins[request] &&
                candidate.end == this.typedRequestEnds[request] &&
                candidate.kind == expression.kind) already = true
            existing = existing + 1
        }
        if (request >= 0 && !already && type != "unknown") {
            this.typedCalls.append(BootstrapTypedCall(
                this.currentSourceIdentity,
                this.typedRequestBegins[request],
                this.typedRequestEnds[request],
                expression.kind,
                expression.text,
                bootstrapNormalizeType(type),
                "unknown",
                -1,
                [],
                [],
                [],
                [],
                [],
                0,
                false,
                false,
                false
            ))
        }
    }

    fun validateCallAliases(
        arguments: array<BootstrapExpression>,
        kinds: array<string>,
        types: array<string>,
        context: string
    ): void {
        var exclusive = 0
        while (exclusive < arguments.size && exclusive < kinds.size &&
               exclusive < types.size) {
            val owning = kinds[exclusive] == "own" &&
                this.typeIsAffine(types[exclusive])
            val mutable = kinds[exclusive] == "var" &&
                this.typeIsBorrowTracked(types[exclusive])
            if (owning || mutable) {
                var borrowed = 0
                while (borrowed < arguments.size &&
                       borrowed < kinds.size && borrowed < types.size) {
                    val tracked = if (owning) {
                        this.typeIsAffine(types[borrowed])
                    } else this.typeIsBorrowTracked(types[borrowed])
                    var aliases = borrowed != exclusive && tracked &&
                        bootstrapOwnershipPlacesConflict(
                            arguments[exclusive],
                            arguments[borrowed]
                        )
                    if (borrowed != exclusive && tracked) {
                        val borrowSource = this.borrowExpressionSource(
                            arguments[borrowed]
                        )
                        val exclusivePlace = bootstrapOwnershipPlaceKey(
                            arguments[exclusive]
                        )
                        if (bootstrapOwnershipPlaceKeysConflict(
                            borrowSource,
                            exclusivePlace
                        )) aliases = true
                    }
                    if (aliases) {
                        if (owning) {
                            this.fail("ownership.borrow-own-alias:$context")
                        } else {
                            this.fail("ownership.mutable-alias:$context")
                        }
                    }
                    borrowed = borrowed + 1
                }
            }
            exclusive = exclusive + 1
        }
    }

    fun hasSymbol(name: string): bool = this.symbolIndex(name) >= 0

    fun appendUniqueCaptureName(var names: array<string>, name: string) {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        if (!found) names.append(name)
    }

    fun captureNameIsBound(names: array<string>, name: string): bool {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun collectLambdaCaptureNames(
        expression: BootstrapExpression,
        bound: array<string>,
        var captures: array<string>
    ): void {
        var nested = false
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            nested = true
            val nestedBound: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nestedBound.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                this.appendUniqueCaptureName(
                    nestedBound,
                    expression.children[parameter].text
                )
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaCaptureNames(body, nestedBound, captures)
        }
        if (!nested) {
            if (expression.kind == "identifier" &&
                !this.captureNameIsBound(bound, expression.text)) {
                this.appendUniqueCaptureName(captures, expression.text)
            }
            if ((expression.kind == "call" || expression.kind == "assign") &&
                !this.captureNameIsBound(bound, expression.text)) {
                this.appendUniqueCaptureName(captures, expression.text)
            }
            if (expression.kind == "block") {
                val scoped = bootstrapCopyBoundNames(bound)
                var child = 0
                while (child < expression.children.size) {
                    val statement = expression.children[child]
                    this.collectLambdaCaptureNames(statement, scoped, captures)
                    if (bootstrapStatementDeclaresLocal(statement)) {
                        scoped.append(statement.text)
                    }
                    child = child + 1
                }
            } else {
                var child = 0
                while (child < expression.children.size) {
                    this.collectLambdaCaptureNames(
                        expression.children[child],
                        bound,
                        captures
                    )
                    child = child + 1
                }
            }
        }
    }

    fun lambdaMutatesCapturedPlace(
        expression: BootstrapExpression,
        bound: array<string>
    ): bool {
        var mutates = false
        if (expression.kind == "assign" &&
            !this.captureNameIsBound(bound, expression.text) &&
            (this.hasVisibleLocal(expression.text) ||
             (this.currentOwner != "" && this.fieldType(
                this.currentOwner,
                expression.text
             ) != "unknown"))) mutates = true
        if (expression.kind == "identifier" &&
            !this.captureNameIsBound(bound, expression.text) &&
            this.nameIsDelegated(expression.text) &&
            bootstrapMutableReceiverContains(
                this.mutableReceivers,
                this.delegateType(expression.text),
                "getValue"
            )) mutates = true
        if (expression.kind == "delegate.assign" &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.captureNameIsBound(bound, root) &&
                this.hasVisibleLocal(root)) mutates = true
        }
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.captureNameIsBound(bound, root) &&
                (this.hasVisibleLocal(root) || root == "this")) {
                mutates = true
            }
        }
        if (expression.kind == "call" &&
            !this.captureNameIsBound(bound, expression.text) &&
            this.hasVisibleLocal(expression.text) &&
            bootstrapIsMutableFunctionType(
                this.findType(expression.text)
            )) mutates = true
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.captureNameIsBound(bound, root) &&
                this.hasVisibleLocal(root) &&
                bootstrapMutableReceiverContains(
                    this.mutableReceivers,
                    if (this.nameIsDelegated(root) &&
                        expression.children[0].kind == "delegate.project") {
                        this.delegateType(root)
                    } else bootstrapBorrowElementType(this.findType(root)),
                    expression.text
                )) mutates = true
        }
        if (expression.kind == "block") {
            val scoped = bootstrapCopyBoundNames(bound)
            var child = 0
            while (!mutates && child < expression.children.size) {
                val statement = expression.children[child]
                mutates = this.lambdaMutatesCapturedPlace(statement, scoped)
                if (bootstrapStatementDeclaresLocal(statement)) {
                    scoped.append(statement.text)
                }
                child = child + 1
            }
        } else if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (!mutates && child < expression.children.size) {
                mutates = this.lambdaMutatesCapturedPlace(
                    expression.children[child],
                    bound
                )
                child = child + 1
            }
        }
        mutates
    }

    fun lambdaRequiresMutableCall(
        expression: BootstrapExpression
    ): bool {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        this.lambdaMutatesCapturedPlace(body, bound)
    }

    fun validateLambdaCaptures(expression: BootstrapExpression): void {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        val captures: array<string> = []
        this.collectLambdaCaptureNames(body, bound, captures)
        var capture = 0
        while (capture < captures.size) {
            var name = captures[capture]
            if (!this.hasVisibleLocal(name) && this.currentOwner != "" &&
                this.fieldType(this.currentOwner, name) != "unknown") {
                name = "this"
            }
            var captureType = this.findType(name)
            if (this.nameIsDelegated(name)) {
                captureType = this.delegateType(name)
            }
            if (this.hasVisibleLocal(name) &&
                this.typeIsAffine(captureType)) {
                if (expression.kind != "lambda.move" &&
                    expression.kind != "lambda.generator") {
                    this.fail("ownership.capture-move-required:$name")
                }
                if ((expression.kind == "lambda.move" ||
                     expression.kind == "lambda.generator") &&
                    !this.hasMovableLocal(name)) {
                    this.fail("ownership.borrow-capture:$name")
                }
            }
            if (this.hasVisibleLocal(name) &&
                bootstrapIsBorrowType(this.findType(name))) {
                this.fail("ownership.borrow-capture:$name")
            }
            capture = capture + 1
        }
    }

    fun threadCaptureTypeIsSend(type: string): bool {
        val normalized = bootstrapNormalizeType(type)
        bootstrapIsSharedType(normalized) ||
            bootstrapIsMutexType(normalized) ||
            bootstrapIsWeakType(normalized) ||
            this.isTransactionalType(normalized)
    }

    fun validateThreadCaptures(body: BootstrapExpression): void {
        val bound: array<string> = []
        if (this.lambdaMutatesCapturedPlace(body, bound)) {
            this.fail("thread.capture-mutation")
        }
        val captures: array<string> = []
        this.collectLambdaCaptureNames(body, bound, captures)
        var capture = 0
        while (capture < captures.size) {
            val name = captures[capture]
            var captureType = this.findType(name)
            if (this.nameIsDelegated(name)) {
                captureType = this.delegateType(name)
            }
            if (this.hasVisibleLocal(name) &&
                !this.threadCaptureTypeIsSend(captureType)) {
                this.fail(
                    "thread.capture-type:$name:$captureType"
                )
            }
            capture = capture + 1
        }
    }

    // Whether the analyzed thread body names a global `var`: not a local or
    // field of the code starting the thread, nor a local of the body itself
    // (globalKindNamed reads what each name was where it was analyzed).
    fun threadUsesMutableGlobal(expression: BootstrapExpression): bool {
        var found = false
        // A global delegated to a TVar is read and written through its
        // transactions; replacing its delegate changes the global.
        if ((expression.kind == "identifier" ||
             expression.kind == "assign") &&
            this.globalKindNamed(expression) == "var" &&
            !this.isTransactionalType(this.delegateType(expression.text))) found = true
        if (expression.kind == "delegate.assign" && expression.children.size > 0 &&
            expression.children[0].kind == "identifier" &&
            this.globalKindNamed(expression.children[0]) == "var") found = true
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0 &&
            this.globalKindNamed(bootstrapPlaceRoot(expression.children[0])) == "var") {
            found = true
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (!found && child < expression.children.size) {
                found = this.threadUsesMutableGlobal(expression.children[child])
                child = child + 1
            }
        }
        found
    }

    // A call's borrow result contract and the parameter it names, through
    // declarationNames while it covers every declaration (else by a scan).
    fun borrowCallResultSource(owner: string, name: string): string {
        val indexed =
            this.declarationNames.nodeDeclarations.size == this.declarations.size
        val source = if (indexed) bootstrapBorrowCallResultSourceIndexed(
            this.declarations, this.declarationNames, owner, name
        ) else bootstrapBorrowCallResultSource(this.declarations, owner, name)
        if (this.borrowIndexCheck) {
            val scanned =
                bootstrapBorrowCallResultSource(this.declarations, owner, name)
            if (scanned != source) {
                linuxPrintStandardError(
                    "error[E_INTERNAL]: borrow.index-check: the result source of `$owner`.`$name` is `$source`, a scan finds `$scanned`\n"
                )
            }
        }
        source
    }

    fun borrowCallResultParameter(
        owner: string,
        name: string,
        source: string
    ): int {
        val indexed =
            this.declarationNames.nodeDeclarations.size == this.declarations.size
        val parameter = if (indexed) bootstrapBorrowCallResultParameterIndexed(
            this.declarations, this.declarationNames, owner, name, source
        ) else bootstrapBorrowCallResultParameter(
            this.declarations, owner, name, source
        )
        if (this.borrowIndexCheck) {
            val scanned = bootstrapBorrowCallResultParameter(
                this.declarations, owner, name, source
            )
            if (scanned != parameter) {
                linuxPrintStandardError(
                    "error[E_INTERNAL]: borrow.index-check: the result parameter of `$owner`.`$name` for `$source` is $parameter, a scan finds $scanned\n"
                )
            }
        }
        parameter
    }

    fun borrowArgumentSource(expression: BootstrapExpression): string {
        var source = this.borrowExpressionSource(expression)
        if (source == "") {
            val root = bootstrapPlaceRootName(expression)
            if (root != "" && this.hasVisibleLocal(root) &&
                !bootstrapIsBorrowType(this.findType(root))) {
                source = bootstrapOwnershipPlaceKey(expression)
            }
        }
        source
    }

    fun borrowExpressionSource(expression: BootstrapExpression): string {
        var source = ""
        if (expression.kind == "identifier" &&
            this.nameIsDelegated(expression.text) &&
            bootstrapIsBorrowType(this.findType(expression.text))) {
            source = expression.text
        }
        if (expression.kind == "member.call" &&
            expression.text == "get" && expression.children.size == 1) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && this.hasVisibleLocal(root) &&
                !bootstrapIsBorrowType(this.findType(root))) {
                source = bootstrapOwnershipPlaceKey(expression.children[0])
            }
        }
        if (expression.kind == "call") {
            val contract = this.borrowCallResultSource("", expression.text)
            // With no contract the parameter is never read.
            val parameter = if (contract != "") this.borrowCallResultParameter(
                "", expression.text, contract
            ) else -1
            if (contract != "" && parameter >= 0 &&
                parameter < expression.children.size) {
                source = this.borrowArgumentSource(
                    expression.children[parameter]
                )
            }
            if (source == "") {
                val functionType = this.findType(expression.text)
                val indirectSource =
                    bootstrapFunctionBorrowResultParameter(functionType)
                if (indirectSource >= 0 &&
                    indirectSource < expression.children.size) {
                    source = this.borrowArgumentSource(
                        expression.children[indirectSource]
                    )
                }
            }
            if (source == "" && this.findKind(expression.text) == "class") {
                val stored = this.constructorStoredBorrowSource(expression)
                if (stored != "managed.unknown" &&
                    stored != "managed.multiple") source = stored
            }
        }
        // An affine value a map lends (`get`, `values`) is borrowed from it.
        if (expression.kind == "member.call" &&
            (expression.text == "get" || expression.text == "values") &&
            expression.children.size > 0 &&
            bootstrapIsMapType(bootstrapBorrowElementType(
                this.infer(expression.children[0])
            ))) {
            source = this.borrowArgumentSource(expression.children[0])
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0 && expression.text != "get") {
            val receiverType = bootstrapBorrowElementType(
                this.infer(expression.children[0])
            )
            val contract =
                this.borrowCallResultSource(receiverType, expression.text)
            if (contract == "this") {
                source = this.borrowArgumentSource(expression.children[0])
            }
            if (contract != "" && contract != "this") {
                val parameter = this.borrowCallResultParameter(
                    receiverType, expression.text, contract
                )
                if (parameter >= 0 &&
                    parameter + 1 < expression.children.size) {
                    source = this.borrowArgumentSource(
                        expression.children[parameter + 1]
                    )
                }
            }
        }
        if (expression.kind == "identifier" &&
            this.hasVisibleLocal(expression.text) &&
            bootstrapIsBorrowType(this.findType(expression.text))) {
            source = this.visibleBorrowSource(expression.text)
        }
        if ((expression.kind == "member" || expression.kind == "index") &&
            expression.children.size > 0) {
            source = this.borrowExpressionSource(expression.children[0])
        }
        if (expression.kind == "block" && expression.children.size > 0) {
            source = this.borrowExpressionSource(
                expression.children[expression.children.size - 1]
            )
        }
        if (expression.kind == "if" && expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            val thenSource = this.borrowExpressionSource(
                expression.children[1]
            )
            val elseSource = this.borrowExpressionSource(
                expression.children[2]
            )
            if (thenSource != "" && thenSource == elseSource) {
                source = thenSource
            } else source = ""
        }
        if (expression.kind == "when") {
            var joinedSource = ""
            var valid = true
            var branch = 2
            while (branch < expression.children.size) {
                val branchSource = this.borrowExpressionSource(
                    expression.children[branch]
                )
                if (branchSource == "") valid = false
                if (joinedSource == "") {
                    joinedSource = branchSource
                    valid = valid
                } else {
                    if (joinedSource != branchSource) valid = false
                    valid = valid
                }
                branch = branch + 2
            }
            if (valid) source = joinedSource
            else source = ""
        }
        source
    }

    fun validateBorrowResultDeclaration(
        declaration: BootstrapDeclaration,
        receiverAllowed: bool,
        context: string
    ): void {
        val contract = bootstrapBorrowResultSource(declaration.resultType)
        val startsContract = bootstrapStartsBorrowResultContract(
            declaration.resultType
        )
        if (startsContract && !bootstrapIsBorrowResultContract(
            declaration.resultType
        )) this.fail("ownership.borrow-return-contract:$context")
        if (contract != "") {
            if (declaration.kind == "extern") {
                this.fail("ownership.borrow-return-extern:$context")
            }
            var valid = receiverAllowed && contract == "this"
            var parameter = 0
            while (parameter < declaration.parameters.size) {
                if (declaration.parameters[parameter] == contract) {
                    valid = true
                    // A view of an ordinary class may come from a `var`
                    // parameter: the call has ended when the view exists.
                    if (parameter < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[parameter] == "own" ||
                         (declaration.parameterKinds[parameter] == "var" &&
                          this.typeIsAffine(bootstrapBorrowResultElementType(
                              declaration.resultType
                          ))))) {
                        this.fail(
                            "ownership.borrow-return-source-mode:$context:$contract"
                        )
                    }
                    if (parameter < declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[parameter].kind !=
                            "missing") {
                        this.fail(
                            "ownership.borrow-return-source-default:$context:$contract"
                        )
                    }
                }
                parameter = parameter + 1
            }
            if (!valid) this.fail(
                "ownership.borrow-return-source-name:$context:$contract"
            )
        }
    }

    fun validateBorrowReturn(
        expression: BootstrapExpression,
        actual: string,
        context: string
    ): void {
        if (bootstrapIsBorrowType(actual)) {
            if (this.currentBorrowResultSource == "") {
                if (!this.returnedBorrowIsOwned(expression) &&
                    !this.managedReferenceIsStatic(expression)) {
                    this.fail("ownership.borrow-escape:$context")
                }
            } else {
                var source = this.borrowExpressionSource(expression)
                // `val b = B(p); b`: the block's locals are out of scope by
                // now, so read the `val`'s initializer.
                if (source == "" && expression.kind == "block" &&
                    expression.children.size > 0) {
                    val tail = expression.children[expression.children.size - 1]
                    for (statement in expression.children) {
                        if (tail.kind == "identifier" &&
                            statement.kind == "local.val" &&
                            statement.text == tail.text &&
                            statement.children.size > 0) {
                            source = this.borrowExpressionSource(
                                statement.children[0]
                            )
                        }
                    }
                }
                if (!bootstrapBorrowSourceMatchesContract(
                    source,
                    this.currentBorrowResultSource
                )) this.fail(
                    "ownership.borrow-return-source:$context:${this.currentBorrowResultSource}"
                )
            }
        } else if (this.currentBorrowResultSource != "" &&
                   actual != "never" && !this.typeIsAffine(actual)) {
            if (!this.managedReferenceMatchesContract(
                expression,
                this.currentBorrowResultSource
            )) this.fail(
                "ownership.borrow-return-source:$context:${this.currentBorrowResultSource}"
            )
        } else if (this.currentBorrowResultSource == "" &&
                   !this.typeIsAffine(actual) &&
                   this.typeNeedsManagedAliasTracking(actual) &&
                   !this.expressionProducesFreshManagedReference(
                       expression,
                       0,
                       true
                   ) && !this.managedReferenceIsStatic(expression)) {
            var source = this.managedReturnParameterSource(expression)
            if (source == "") source = "nonfresh"
            this.fail(
                "ownership.managed-return-borrow-contract:$context:$source"
            )
        }
    }

    // A call's `borrow(source)` result whose source argument (`this`: the
    // receiver, at 0) is a new value is that value: nothing else names it.
    // Views of affine values stay views (the temporary owner is dropped).
    fun borrowResultOfFreshSource(
        result: string,
        owner: string,
        call: BootstrapExpression,
        firstArgument: int
    ): string {
        if (!bootstrapIsBorrowType(result) ||
            this.typeIsAffine(bootstrapBorrowElementType(result))) return result
        val contract = this.borrowCallResultSource(owner, call.text)
        if (contract == "") return result
        var index = 0
        if (contract != "this") {
            val parameter = this.borrowCallResultParameter(owner, call.text, contract)
            if (parameter < 0) return result
            index = parameter + firstArgument
        }
        if (index < call.children.size &&
            this.expressionProducesFreshManagedReference(
                call.children[index], 0, false
            )) bootstrapBorrowElementType(result) else result
    }

    // A `borrow(source) T` result of an ordinary (non-affine) type returns the
    // T itself; validateBorrowReturn checks that it comes from the source.
    fun borrowResultAccepts(declared: string, actual: string): bool =
        this.currentBorrowResultSource != "" &&
            bootstrapIsBorrowType(declared) && !bootstrapIsBorrowType(actual) &&
            !this.typeIsAffine(actual) &&
            this.typesCompatible(bootstrapBorrowElementType(declared), actual)

    // Whether every value `expression` can produce is fresh or a place rooted
    // at `contract`: a parameter, or `this` (also through an implicit field).
    fun managedReferenceMatchesContract(
        expression: BootstrapExpression,
        contract: string
    ): bool {
        if (expression.kind == "block" && expression.children.size > 0) {
            return this.managedReferenceMatchesContract(
                expression.children[expression.children.size - 1], contract
            )
        }
        if (expression.kind == "if") {
            return expression.children.size > 2 &&
                expression.children[2].kind != "missing" &&
                this.managedReferenceMatchesContract(
                    expression.children[1], contract
                ) && this.managedReferenceMatchesContract(
                    expression.children[2], contract
                )
        }
        if (expression.kind == "when") {
            var matches = true
            var branch = 2
            while (matches && branch < expression.children.size) {
                matches = this.managedReferenceMatchesContract(
                    expression.children[branch], contract
                )
                branch = branch + 2
            }
            return matches
        }
        if ((expression.kind == "compile" || expression.kind == "region") &&
            expression.children.size > 0) {
            return this.managedReferenceMatchesContract(
                expression.children[0], contract
            )
        }
        if (expression.kind == "identifier" || expression.kind == "member" ||
            expression.kind == "index") {
            val root = bootstrapPlaceRootName(expression)
            if (root != "" && this.hasVisibleLocal(root)) {
                val kind = this.visibleLocalKind(root)
                if (kind == "parameter" || kind == "mutable.parameter") {
                    return root == contract
                }
                // A `for` variable over the source's elements, or a fresh local.
                val source = this.visibleBorrowSource(root)
                if (source.size > 7 && source.slice(0, 7) == "shared:") {
                    return bootstrapBorrowSourceMatchesContract(
                        source.slice(7, source.size), contract
                    )
                }
                return source == "managed.fresh"
            }
            if (root != "" && contract == "this" && this.currentOwner != "" &&
                this.fieldType(this.currentOwner, root) != "unknown") {
                return true
            }
        }
        this.expressionProducesFreshManagedReference(expression, 0, true) ||
            this.managedReferenceIsStatic(expression)
    }

    // A place rooted in a global (`store.rows[i]`), or in a local read from
    // one: the global outlives every call, so a reference into it may be
    // returned without a borrow contract.
    fun managedReferenceIsStatic(expression: BootstrapExpression): bool {
        if (expression.kind == "block" && expression.children.size > 0) {
            return this.blockValueIsStatic(
                expression, expression.children[expression.children.size - 1]
            )
        }
        if (expression.kind == "if" && expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            return this.managedReferenceIsStatic(expression.children[1]) &&
                this.managedReferenceIsStatic(expression.children[2])
        }
        var root = ""
        if (expression.kind == "identifier" || expression.kind == "member" ||
            expression.kind == "index") {
            root = bootstrapPlaceRootName(expression)
        }
        if (root == "") false
        else if (this.hasVisibleLocal(root)) {
            this.visibleBorrowSource(root) == "managed.static"
        } else this.namesGlobal(bootstrapPlaceRoot(expression))
    }

    // A block's value read, through its own `val` locals, from a global.
    fun blockValueIsStatic(
        block: BootstrapExpression,
        value: BootstrapExpression
    ): bool {
        if (value.kind == "identifier" || value.kind == "member" ||
            value.kind == "index") {
            val root = bootstrapPlaceRootName(value)
            var statement = block.children.size - 1
            while (statement >= 0) {
                val found = block.children[statement]
                if (found.kind == "local.val" && found.text == root &&
                    found.children.size > 0) {
                    return this.blockValueIsStatic(block, found.children[0])
                }
                if (found.kind == "local.var" && found.text == root) {
                    return false
                }
                statement = statement - 1
            }
        }
        this.managedReferenceIsStatic(value)
    }

    fun managedReturnParameterSource(
        expression: BootstrapExpression
    ): string {
        var source = ""
        if (expression.kind == "identifier" ||
            expression.kind == "member" ||
            expression.kind == "index") {
            val root = bootstrapPlaceRootName(expression)
            if (root != "" && this.hasVisibleLocal(root)) {
                val kind = this.visibleLocalKind(root)
                if (kind == "parameter" || kind == "mutable.parameter") {
                    source = root
                }
            }
        }
        if (source == "" && expression.kind == "block" &&
            expression.children.size > 0) {
            source = this.managedReturnParameterSource(
                expression.children[expression.children.size - 1]
            )
        }
        if (source == "" && expression.kind == "if") {
            var branch = 1
            while (source == "" && branch < expression.children.size) {
                if (expression.children[branch].kind != "missing") {
                    source = this.managedReturnParameterSource(
                        expression.children[branch]
                    )
                }
                branch = branch + 1
            }
        }
        if (source == "" && expression.kind == "when") {
            var branch = 2
            while (source == "" && branch < expression.children.size) {
                source = this.managedReturnParameterSource(
                    expression.children[branch]
                )
                branch = branch + 2
            }
        }
        if (source == "" &&
            (expression.kind == "compile" || expression.kind == "region") &&
            expression.children.size > 0) {
            source = this.managedReturnParameterSource(expression.children[0])
        }
        source
    }

    fun validateHygiene(expression: BootstrapExpression): void {
        // Parsed source spans are never negative. Only the compiler-owned
        // generated-declaration reference builders can mint this marker.
        if (expression.end < 0) {
            var matched = false
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (candidate.generatedNamespace != "" &&
                    candidate.name == expression.text) matched = true
                declaration = declaration + 1
            }
            if (!matched) this.fail("generated.hygiene")
        }
    }

    // A Map<K, V> method: get (V or null), has, set, remove, keys, values,
    // clear. The map's own type must be known (declared) and its key a string
    // or an int.
    fun inferMapCall(
        expression: BootstrapExpression,
        rawReceiver: string,
        receiver: string
    ): string {
        val key = bootstrapMapKeyType(receiver)
        val value = bootstrapMapValueType(receiver)
        val method = expression.text
        if (key == "unknown") {
            this.fail(
                "map.untyped: declare its type, as in val m: Map<string, int> = Map()"
            )
        } else if (key != "string" && key != "i64" &&
                   // A generic's `K` (generics.ab): each instance checks its own.
                   !bootstrapIsGenericParameterClass(key)) {
            this.fail("map.key-type:$key")
        }
        if (method == "set" || method == "remove" || method == "clear" ||
            method == "take") {
            if (bootstrapIsBorrowType(rawReceiver)) {
                this.fail("ownership.borrow-mutation:map.$method")
            }
            this.validateBorrowMutation(expression.children[0], "map.$method")
            this.stmCheckMutation(
                expression.children[0], expression.begin,
                "${bootstrapPlaceRootName(expression.children[0])}.$method()"
            )
        }
        val arity = if (method == "set") 3
            else if (method == "get" || method == "has" ||
                method == "remove" || method == "take") 2
            else 1
        var result = "unknown"
        if (!bootstrapIsMapBuiltinMethod(method)) {
            this.fail("map.member:$method")
        } else if (expression.children.size != arity) {
            this.fail("map.$method.arity")
        } else {
            if (arity >= 2) {
                val keyType = this.infer(expression.children[1])
                if (!bootstrapTypesCompatible(key, keyType)) {
                    this.fail("map.$method.key:$key:$keyType")
                }
            }
            if (method == "set") {
                // A lambda takes its parameter types from the value type.
                this.contextualizeLambdaParameters(expression.children[2], value)
                this.contextualizeArrayLiteral(expression.children[2], value)
                val stored = this.infer(expression.children[2])
                if (bootstrapIsBorrowType(stored)) {
                    this.fail("ownership.borrow-store:map.set")
                }
                if (!bootstrapTypesCompatible(value, stored)) {
                    this.fail("map.set.value:$value:$stored")
                }
                this.validateOwnershipTransfer(
                    value, expression.children[2], "argument.map.set"
                )
            }
            val nullable = if (bootstrapIsNullableType(value)) value
                else "nullable:$value"
            // Like an array's elements, a map's affine values stay the
            // map's: `get` and `values` lend them, `take` moves one out.
            val lent = if (this.typeIsAffine(value)) "borrow:" else ""
            result = when (method) {
                "get" -> "$lent$nullable"
                "take" -> nullable
                "has" -> "bool"
                "remove" -> "bool"
                "keys" -> "array:$key"
                "values" -> "${lent}array:$value"
                else -> "void"
            }
        }
        return result
    }

    /** An untyped array literal stored where `expected` is known only here
     *  (an inferred receiver's `append`, `set`, `[i] =`, `=`, a field or a
     *  method argument) takes `expected` as its type, as one whose context
     *  the syntax declares does (expected_types.ab): analysis checks its
     *  elements against it and lowering builds it as that type. */
    fun contextualizeArrayLiteral(value: BootstrapExpression, expected: string): void {
        val array = if (bootstrapIsNullableType(expected))
            bootstrapNullableElementType(expected) else expected
        if (!bootstrapIsArrayType(array) || bootstrapTypeMentions(array, "unknown") ||
            bootstrapTypeMentions(array, "inferred")) return
        val text = bootstrapLiftTypeText(array)
        if (bootstrapNormalizeType(text) != array) return
        this.recordContextualLiteral(value, text)
        return
    }

    /** Records `type` (source text) for the untyped literal `value` is, or
     *  that the block or `if` it is ends in. */
    fun recordContextualLiteral(value: BootstrapExpression, type: string): void {
        if (value.kind == "array" && value.text == "") {
            val array = bootstrapExpectedArrayType(type)
            if (array != "") {
                this.contextualLiterals.add(this.currentSourceIdentity, value.begin, value.end, array)
            }
        } else if (value.kind == "block" && value.children.size > 0) {
            this.recordContextualLiteral(value.children[value.children.size - 1], type)
        } else if (value.kind == "if" && value.children.size == 3) {
            this.recordContextualLiteral(value.children[1], type)
            this.recordContextualLiteral(value.children[2], type)
        }
        return
    }

    fun contextualizeLambdaParameters(
        expression: BootstrapExpression,
        expected: string
    ): void {
        // A nullable function type gives its function's parameters.
        if (bootstrapIsNullableType(expected)) {
            this.contextualizeLambdaParameters(
                expression, bootstrapNullableElementType(expected)
            )
            return
        }
        // An array literal's lambdas take the element type's parameters.
        if (expression.kind == "array" && bootstrapIsArrayType(expected)) {
            val element = bootstrapArrayElementType(expected)
            for (item in expression.children) {
                this.contextualizeLambdaParameters(item, element)
            }
        }
        if ((expression.kind == "lambda" ||
             expression.kind == "lambda.move") &&
            bootstrapIsFunctionType(expected)) {
            val parameterCount = expression.children.size - 1
            if (parameterCount ==
                bootstrapFunctionParameterCount(expected)) {
                var parameter = 0
                while (parameter < parameterCount) {
                    val found = expression.children[parameter]
                    if (found.kind == "lambda.parameter" &&
                        found.children.size > 0 &&
                        bootstrapNormalizeType(found.children[0].text) ==
                            "unknown") {
                        val contextual = bootstrapFunctionParameterType(
                            expected,
                            parameter
                        )
                        if (contextual != "unknown") {
                            found.children[0] = BootstrapExpression(
                                "type",
                                contextual,
                                found.children[0].begin,
                                found.children[0].end,
                                []
                            )
                        }
                    }
                    parameter = parameter + 1
                }
            }
            // A lambda where a `void` function is expected may end in an
            // assignment: it returns nothing rather than the assigned value.
            val body = expression.children[expression.children.size - 1]
            val statements = body.children.size
            if (bootstrapFunctionResultType(expected) == "void" &&
                body.kind == "block" && statements > 0 &&
                bootstrapIsAssignment(body.children[statements - 1])) {
                val end = body.children[statements - 1].end
                body.children.append(BootstrapExpression(
                    "return", "", end, end,
                    [BootstrapExpression("missing", "return", end, end, [])]
                ))
            }
            // One where a result is expected hands its last expression out:
            // an assignment there is used (ownership.assignment-value).
            val result = bootstrapFunctionResultType(expected)
            if (result != "void" && result != "unknown") {
                bootstrapCollectUsedAssignments(body, true, this.usedAssignments)
            }
        }
    }

    fun appendLogicalOperands(
        expression: BootstrapExpression,
        operation: string,
        var operands: array<BootstrapExpression>
    ): void {
        if (expression.kind == operation && expression.children.size == 2) {
            this.appendLogicalOperands(
                expression.children[0], operation, operands
            )
            this.appendLogicalOperands(
                expression.children[1], operation, operands
            )
        } else operands.append(expression)
    }

    fun inferLogicalExpression(expression: BootstrapExpression): string {
        val operation = expression.kind
        val operands: array<BootstrapExpression> = []
        this.appendLogicalOperands(expression, operation, operands)
        var inferred = this.infer(operands[0])
        if (inferred != "bool") this.fail("logical.type")
        val previousScope = this.enterScope()
        var operand = 1
        while (operand < operands.size) {
            this.addNullableRefinements(
                operands[operand - 1], operation == "&&"
            )
            inferred = this.infer(operands[operand])
            if (inferred != "bool") this.fail("logical.type")
            operand = operand + 1
        }
        this.leaveScope(previousScope)
        "bool"
    }

    fun scalarBinaryExpression(expression: BootstrapExpression): bool =
        expression.kind == "+" || expression.kind == "-" ||
        expression.kind == "*" || expression.kind == "/" ||
        expression.kind == "%" ||
        expression.kind == "&" || expression.kind == "|" ||
        expression.kind == "^" || expression.kind == "<<" ||
        expression.kind == ">>" || expression.kind == ">>>"

    // Reconstructed low-level sources naturally contain long address and mask
    // expressions. Re-entering infer() for every binary node also re-enters
    // its complete semantic implementation and, in the self-hosted compiler,
    // reserves that large function's stack frame at every level. Walk binary
    // subtrees through this focused helper instead. Expression grouping and
    // per-node typed records remain identical, while only non-binary leaves
    // enter the general inference function.
    fun inferScalarBinaryExpression(
        expression: BootstrapExpression
    ): string {
        this.validateHygiene(expression)
        if (expression.children.size != 2) {
            this.fail("binary.arity")
            return "unknown"
        }
        val leftExpression = expression.children[0]
        val rightExpression = expression.children[1]
        val rawLeft = if (this.scalarBinaryExpression(leftExpression))
            this.inferScalarBinaryExpression(leftExpression)
        else this.infer(leftExpression)
        val rawRight = if (this.scalarBinaryExpression(rightExpression))
            this.inferScalarBinaryExpression(rightExpression)
        else this.infer(rightExpression)
        if (this.overloads.keys.size > 0) {
            val operated = this.inferOperatorCall(expression, [rawLeft, rawRight])
            if (operated != "") return operated
        }
        // `a + b` of two strings concatenates them (folded when both are
        // static text).
        val staticStringConcatenation = expression.kind == "+" &&
            bootstrapBorrowElementType(rawLeft) == "string" &&
            bootstrapBorrowElementType(rawRight) == "string"
        val left = this.scalarValueType(rawLeft)
        val right = this.scalarValueType(rawRight)
        val arithmetic = expression.kind == "+" ||
            expression.kind == "-" || expression.kind == "*" ||
            expression.kind == "/" || expression.kind == "%"
        val shift = expression.kind == "<<" ||
            expression.kind == ">>" || expression.kind == ">>>"
        var result = "unknown"
        if (staticStringConcatenation) {
            result = "string"
        } else if (arithmetic) {
            if (left != right || !bootstrapIsNumericScalarType(left)) {
                this.failScalarExpression(
                    "arithmetic.type", expression, left, right
                )
            } else if ((expression.kind == "/" || expression.kind == "%") &&
                       bootstrapIsIntegerScalarType(left)) {
                // A divisor that is always zero would always panic.
                val divisor = bootstrapStaticInteger(this, rightExpression, 0)
                if (divisor.known && divisor.value == 0) {
                    this.fail("division.zero@${rightExpression.begin}")
                }
            }
            result = left
        } else {
            if (!bootstrapIsIntegerScalarType(left) ||
                (!shift && left != right) ||
                (shift && !bootstrapIsIntegerScalarType(right))) {
                this.failScalarExpression(
                    "bitwise.type", expression, left, right
                )
            }
            result = left
        }
        this.recordTypedExpression(expression, result)
        result
    }

    fun infer(expression: BootstrapExpression): string {
        if (expression.begin > 0) {
            this.inferBegin = expression.begin
            this.inferSource = this.currentSourceIdentity
        }
        this.validateHygiene(expression)
        if (this.scalarBinaryExpression(expression)) {
            return this.inferScalarBinaryExpression(expression)
        }
        // Each larger case is a @noinline function of its own, so an expression
        // nested N deep holds N frames of this dispatch rather than of every
        // case's locals.
        var result = "unknown"
        if (expression.kind == "integer") result = "i64"
        if (expression.kind == "float") result = "f64"
        if (expression.kind == "true" || expression.kind == "false") result = "bool"
        if (expression.kind == "null") result = "null"
        if (expression.kind == "string") result = "string"
        if (expression.kind == "declaration.block") {
            result = bootstrapInferDeclarationBlock(this, expression, result)
        }
        if (expression.kind == "string.template") {
            result = bootstrapInferStringTemplate(this, expression, result)
        }
        if (expression.kind == "compile") {
            result = bootstrapInferCompile(this, expression, result)
        }
        if (expression.kind == "region") {
            result = bootstrapInferRegion(this, expression, result)
        }
        if (expression.kind == "array") {
            result = bootstrapInferArray(this, expression, result)
        }
        if (expression.kind == "range.closed" ||
            expression.kind == "range.until") {
            result = bootstrapInferRange(this, expression, result)
        }
        if (expression.kind == "identifier") {
            // A generic function is called, not passed as a value (generics.ab).
            if (this.generics.probing && this.generics.findFree(expression.text) >= 0 &&
                !this.generics.isClass(expression.text) && !this.hasVisibleLocal(expression.text)) {
                bootstrapGenericFailure(this, expression, "generic.reference:${bootstrapSourceVisibleType(expression.text)}")
                return "unknown"
            }
            result = bootstrapInferIdentifier(this, expression, result)
        }
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            result = bootstrapInferLambda(this, expression, result)
        }
        if (expression.kind == "call" && expression.text == "move") {
            result = bootstrapInferCallMove(this, expression, result)
        }
        if (expression.kind == "call" && expression.text == "Shared") {
            result = bootstrapInferCallShared(this, expression, result)
        }
        if (expression.kind == "call" && expression.text == "Mutex") {
            result = bootstrapInferCallMutex(this, expression, result)
        }
        // `Map()` is an empty map whose type comes from where it is stored
        // (a declared local, field, parameter or result).
        if (expression.kind == "call" && expression.text == "Map") {
            result = bootstrapInferCallMap(this, expression, result)
        }
        if (expression.kind == "call" && expression.text == "Cell") {
            result = bootstrapInferCallCell(this, expression, result)
        }
        if (expression.kind == "call" && expression.text == "filledArray") {
            result = bootstrapInferCallFilledArray(this, expression, result)
        }
        if (expression.kind == "call" && expression.text != "move" &&
            expression.text != "Shared" && expression.text != "Mutex" &&
            expression.text != "Cell" && expression.text != "filledArray" &&
            expression.text != "Map") {
            if (this.overloads.keys.size > 0) {
                val overloaded = this.inferOverloadedCall(expression)
                if (overloaded != "") return overloaded
            }
            if (this.generics.probing) {
                val generic = bootstrapGenericInferCall(this, expression)
                if (generic != "") return generic
            }
            result = bootstrapInferCall(this, expression, result)
        }
        if (expression.kind == "call.value") {
            result = bootstrapInferCallValue(this, expression, result)
        }
        if (expression.kind == "member") {
            result = bootstrapInferMember(this, expression, result)
        }
        if (expression.kind == "index") {
            result = bootstrapInferIndex(this, expression, result)
        }
        if (expression.kind == "index.assign") {
            result = bootstrapInferIndexAssign(this, expression, result)
        }
        if (expression.kind == "member.call") {
            val rawReceiver = this.infer(expression.children[0])
            val receiver = bootstrapBorrowElementType(rawReceiver)
            if (this.overloads.keys.size > 0) {
                val overloaded = this.inferOverloadedMethodCall(expression, receiver)
                if (overloaded != "") return overloaded
            }
            if (this.generics.probing) {
                val generic = bootstrapGenericInferMemberCall(this, expression, receiver)
                if (generic != "") return generic
            }
            result = bootstrapInferMemberCall(
                this, expression, rawReceiver, receiver, result
            )
        }
        if (expression.kind == "member.assign") {
            result = bootstrapInferMemberAssign(this, expression, result)
        }
        if (expression.kind == "block") {
            result = bootstrapInferBlock(this, expression, result)
        }
        if (expression.kind == "defer") {
            result = bootstrapInferDefer(this, expression, result)
        }
        if (expression.kind == "generator") {
            result = bootstrapInferGenerator(this, expression, result)
        }
        // A `$name` no registered subparser expanded: nothing imported registers it.
        if (expression.kind == "subparser.placeholder") {
            this.fail("subparser.unknown:${expression.text}@${expression.begin}")
            result = "unknown"
        }
        if (expression.kind == "yield") {
            result = bootstrapInferYield(this, expression, result)
        }
        if (expression.kind == "task" || expression.kind == "thread") {
            result = bootstrapInferTask(this, expression, result)
        }
        if (expression.kind == "await") {
            result = bootstrapInferAwait(this, expression, result)
        }
        if (expression.kind == "as?") result = this.inferInterfaceCast(expression)
        if (expression.kind == "return") {
            result = bootstrapInferReturn(this, expression, result)
        }
        if (
            expression.kind == "local.val" ||
            expression.kind == "local.var"
        ) {
            result = bootstrapInferLocal(this, expression, result)
        }
        if (expression.kind == "assign") {
            result = bootstrapInferAssign(this, expression, result)
        }
        if (expression.kind == "delegate.project") {
            result = bootstrapInferDelegateProject(this, expression, result)
        }
        if (expression.kind == "atomic") {
            result = bootstrapInferAtomic(this, expression, result)
        }
        if (expression.kind == "stm.orElse") {
            result = bootstrapInferOrElse(this, expression, result)
        }
        if (expression.kind == "delegate.assign") {
            result = bootstrapInferDelegateAssign(this, expression, result)
        }
        if (
            expression.kind == "unary-" ||
            expression.kind == "unary+"
        ) {
            val operand = this.infer(expression.children[0])
            if (this.overloads.keys.size > 0) {
                val operated = this.inferOperatorCall(expression, [operand])
                if (operated != "") return operated
            }
            result = bootstrapInferNegate(this, expression, operand, result)
        }
        if (expression.kind == "unary!") {
            result = this.infer(expression.children[0])
            if (result != "bool") this.fail("unary.boolean")
            result = "bool"
        }
        if (expression.kind == "unary~") {
            result = bootstrapInferComplement(this, expression, result)
        }
        if (expression.kind == "&&" || expression.kind == "||") {
            result = this.inferLogicalExpression(expression)
        }
        if (expression.kind == "if") {
            result = bootstrapInferIf(this, expression, result)
        }
        if (expression.kind == "while") {
            result = bootstrapInferWhile(this, expression, result)
        }
        if (expression.kind == "do.while") {
            result = bootstrapInferDoWhile(this, expression, result)
        }
        if (expression.kind == "for") {
            result = bootstrapInferFor(this, expression, result)
        }
        if (expression.kind == "break" || expression.kind == "continue") {
            result = bootstrapInferBreak(this, expression, result)
        }
        if (expression.kind == "when") {
            result = bootstrapInferWhen(this, expression, result)
        }
        if (
            expression.kind == "==" || expression.kind == "!=" ||
            expression.kind == "<" || expression.kind == "<=" ||
            expression.kind == ">" || expression.kind == ">="
        ) {
            result = bootstrapInferComparison(this, expression, result)
        }
        // Using an assignment's value would hand out what the place now owns.
        if (bootstrapIsAssignment(expression) && this.typeIsAffine(result)) {
            for (begin in this.usedAssignments) {
                if (begin == expression.begin) {
                    this.inferBegin = expression.begin
                    this.inferSource = this.currentSourceIdentity
                    this.fail("ownership.assignment-value")
                }
            }
        }
        this.recordTypedExpression(expression, result)
        result
    }

    fun analyze(parsed: BootstrapParseResult): BootstrapSemanticResult {
        this.errors = this.errors + parsed.errors
        this.prepareSymbolIndex(parsed.declarations.size)
        var capabilityAction = 0
        while (capabilityAction < parsed.actions.size) {
            val staged = parsed.actions[capabilityAction]
            if (staged.kind == "compile" && staged.children.size == 1) {
                val request = staged.children[0]
                if (request.kind == "call" &&
                    request.text == "compilerGrant" &&
                    request.children.size == 1 &&
                    request.children[0].kind == "string") {
                    val name = request.children[0].text
                    val effect = bootstrapCompileEffectFromName(name)
                    if (effect == 0) {
                        this.fail("compile.capability-unknown:$name")
                    } else if (!bootstrapCompileEffectHas(
                        this.compileEffectAuthorizations,
                        effect
                    )) this.fail(
                        "compile.capability-not-authorized:$name"
                    )
                }
            }
            capabilityAction = capabilityAction + 1
        }
        // Publish declaration signatures before inferring any initializer or
        // body. Module flattening order must not make a later imported
        // function or nominal class invisible to an earlier view module.
        var index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            this.currentSourceIdentity = declaration.sourceIdentity
            var symbolName = declaration.name
            if (declaration.extensionOwner != "") {
                symbolName = "${declaration.extensionOwner}.${declaration.name}"
            }
            var type = "unknown"
            var publish = false
            if (bootstrapDeclarationIsValue(declaration.kind) &&
                declaration.resultType != "inferred") {
                val exposed = bootstrapNormalizeType(declaration.resultType)
                type = if (declaration.expression.kind ==
                    "delegate.initializer") {
                    bootstrapDelegatedType(
                        declaration.kind == "var" ||
                            declaration.kind == "compile.var",
                        "unknown",
                        exposed
                    )
                } else exposed
                publish = true
            }
            if (declaration.kind == "fun" ||
                declaration.kind == "extern" ||
                declaration.kind == "compile.fun") {
                type = bootstrapDeclarationFunctionType(declaration)
                publish = true
            }
            if (declaration.kind == "class" ||
                declaration.kind == "interface") {
                type = declaration.name
                publish = true
            }
            if (declaration.kind == "type") {
                type = declaration.name
                publish = true
            }
            if (bootstrapIsExtensionFieldKind(declaration.kind)) {
                if (declaration.resultType != "inferred") {
                    type = bootstrapNormalizeType(declaration.resultType)
                }
                publish = true
            }
            // An overload (same name, other parameter types) is published by
            // overload.ab under its own name before the build's analysis; a
            // module analyzed on its own keeps the first one.
            var overload = false
            if (publish && this.hasSymbol(symbolName)) {
                var previousSource = "unknown"
                var previous = 0
                while (previous < index && previousSource == "unknown") {
                    val candidate = parsed.declarations[previous]
                    var candidateName = candidate.name
                    if (candidate.extensionOwner != "") {
                        candidateName =
                            "${candidate.extensionOwner}.${candidate.name}"
                    }
                    if (candidateName == symbolName) {
                        previousSource = candidate.sourceIdentity
                        overload = bootstrapDeclarationsOverload(candidate, declaration)
                    }
                    previous = previous + 1
                }
                // A duplicate extension field is reported once, not again for
                // its default function.
                if (!overload && !(declaration.extensionOwner != "" &&
                    declaration.name.startsWith(bootstrapExtensionFieldDefaultName("")))) {
                    this.fail(
                        "symbol.duplicate:$symbolName:$previousSource:${declaration.sourceIdentity}"
                    )
                }
            }
            if (publish && !overload) {
                this.appendSymbol(BootstrapSymbol(
                    symbolName,
                    declaration.kind,
                    type,
                    -1,
                    "",
                    "abla:${declaration.sourceIdentity}:${declaration.begin}:${declaration.name}"
                ))
            }
            index = index + 1
        }
        index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            this.currentSourceIdentity = declaration.sourceIdentity
            this.currentGeneratedNamespace = declaration.generatedNamespace
            this.currentGeneratedOriginBegin =
                declaration.generatedOriginBegin
            this.currentGeneratedOriginEnd = declaration.generatedOriginEnd
            this.initEdges.owner =
                if (bootstrapDeclarationIsValue(declaration.kind)) index else -1
            this.initEdges.declaration =
                if (bootstrapDeclarationIsValue(declaration.kind)) index else -1
            var symbolName = declaration.name
            if (declaration.extensionOwner != "") {
                symbolName = "${declaration.extensionOwner}.${declaration.name}"
            }
            val predeclared = declaration.kind == "fun" ||
                declaration.kind == "extern" ||
                declaration.kind == "compile.fun" ||
                declaration.kind == "class" ||
                declaration.kind == "interface" ||
                declaration.kind == "type" ||
                // `extend C : I` names a class, and declares no symbol.
                declaration.kind == "extend" ||
                bootstrapIsExtensionFieldKind(declaration.kind) ||
                (bootstrapDeclarationIsValue(declaration.kind) &&
                 declaration.resultType != "inferred")
            if (!predeclared && this.hasSymbol(symbolName)) {
                this.fail("symbol.duplicate:$symbolName")
            }
            var type = "unknown"
            if (bootstrapDeclarationIsValue(declaration.kind)) {
                if (declaration.kind == "compile.val" ||
                    declaration.kind == "compile.var") {
                    this.compileDepth = this.compileDepth + 1
                }
                var inferredType = "unknown"
                if (declaration.expression.kind == "delegate.initializer") {
                    inferredType = this.delegatedInitializerType(
                        declaration.expression,
                        declaration.name
                    )
                    val delegateType = bootstrapDelegatedStorageType(
                        inferredType
                    )
                    this.validateOwnershipTransfer(
                        delegateType,
                        declaration.expression.children[0],
                        "delegate.global.${declaration.name}"
                    )
                } else {
                    // A lambda takes its parameter types from the declared type.
                    if (declaration.resultType != "inferred") {
                        this.contextualizeLambdaParameters(
                            declaration.expression,
                            bootstrapNormalizeType(declaration.resultType)
                        )
                    }
                    inferredType = this.infer(declaration.expression)
                }
                if (declaration.kind == "compile.val" ||
                    declaration.kind == "compile.var") {
                    this.compileDepth = this.compileDepth - 1
                }
                type = inferredType
                if (declaration.resultType != "inferred" &&
                    declaration.expression.kind != "delegate.initializer") {
                    val declaredType = bootstrapNormalizeType(
                        declaration.resultType
                    )
                    if (!this.typesOrUpcast(
                        declaredType,
                        inferredType
                    )) this.fail("global.type:${declaration.name}")
                    type = declaredType
                }
                if (bootstrapIsBorrowType(type)) {
                    this.fail("ownership.borrow-store:global.${declaration.name}")
                }
                if (bootstrapIsMutableFunctionType(type) ||
                    bootstrapIsOnceFunctionType(type)) {
                    this.fail(
                        "ownership.affine-callable-global:${declaration.name}"
                    )
                }
                if (predeclared &&
                    declaration.expression.kind == "delegate.initializer") {
                    this.replaceSymbolType(symbolName, type)
                }
            }
            if (declaration.kind == "fun" || declaration.kind == "extern" ||
                declaration.kind == "compile.fun") {
                type = bootstrapDeclarationFunctionType(declaration)
            }
            if (
                declaration.kind == "class" ||
                declaration.kind == "interface"
            ) type = declaration.name
            if (declaration.kind == "type") {
                type = declaration.name
                val underlying = bootstrapNormalizeType(
                    declaration.resultType
                )
                if (!bootstrapScalarTypeUnderlyingValid(underlying)) {
                    this.fail("type.underlying:${declaration.name}:$underlying")
                }
            }
            if (bootstrapIsExtensionFieldKind(declaration.kind)) {
                this.validateExtensionField(declaration)
            }
            if (declaration.kind == "class" || declaration.kind == "interface" ||
                declaration.kind == "extend") {
                this.validateConformances(declaration)
            }
            // The standard library's own annotation (runtime-valued classes).
            for (annotation in declaration.annotations) {
                if (annotation == "__abla_runtime_value" &&
                    !bootstrapStandardLibraryModuleSource(bootstrapGenericSourceFile(declaration.sourceIdentity))) {
                    this.failAtOffset("annotation.reserved:$annotation", declaration.begin)
                }
            }
            // Exporting publishes a function: never a private one.
            if (declaration.isPrivate) {
                for (annotation in declaration.annotations) {
                    if (annotation == "export" || annotation == "exportChecked") {
                        this.failAtOffset(
                            "private.export:${bootstrapSourceVisibleType(declaration.name)}",
                            declaration.begin
                        )
                    }
                }
            }
            if (!predeclared) {
                this.appendSymbol(BootstrapSymbol(
                    symbolName,
                    declaration.kind,
                    type,
                    -1,
                    "",
                    "abla:${declaration.sourceIdentity}:${declaration.begin}:${declaration.name}"
                ))
            }
            if (declaration.kind == "fun" ||
                declaration.kind == "compile.fun" ||
                declaration.kind == "extern") {
                this.validateBorrowResultDeclaration(
                    declaration,
                    declaration.extensionOwner != "",
                    symbolName
                )
            }
            var borrowMethod = 0
            while (borrowMethod < declaration.methods.size) {
                val method = declaration.methods[borrowMethod]
                this.validateBorrowResultDeclaration(
                    method,
                    true,
                    "${declaration.name}.${method.name}"
                )
                borrowMethod = borrowMethod + 1
            }
            var ownershipParameter = 0
            while (ownershipParameter < declaration.parameterKinds.size &&
                   ownershipParameter < declaration.parameterTypes.size) {
                val parameterType = bootstrapNormalizeType(
                    declaration.parameterTypes[ownershipParameter]
                )
                if ((declaration.kind == "fun" ||
                     declaration.kind == "compile.fun" ||
                     declaration.kind == "extern") &&
                    bootstrapIsMutableFunctionType(parameterType) &&
                    declaration.parameterKinds[ownershipParameter] != "var") {
                    this.fail("ownership.fnmut-parameter-mode:$symbolName")
                }
                if ((declaration.kind == "fun" ||
                     declaration.kind == "compile.fun" ||
                     declaration.kind == "extern") &&
                    bootstrapIsOnceFunctionType(parameterType) &&
                    declaration.parameterKinds[ownershipParameter] != "own") {
                    this.fail("ownership.fnonce-parameter-mode:$symbolName")
                }
                if (declaration.parameterKinds[ownershipParameter] == "own") {
                    if (declaration.kind == "class") {
                        this.fail(
                            "ownership.owned-constructor-parameter:${declaration.name}"
                        )
                    } else if (!this.typeIsAffine(
                        bootstrapNormalizeType(
                            declaration.parameterTypes[ownershipParameter]
                        )
                    ) && !bootstrapGenericSourceIsInstance(declaration.sourceIdentity)) {
                        // `own value: T` in a generic owns a resource and
                        // copies any other value (generics.ab).
                        this.fail(
                            "ownership.owned-parameter-type:$symbolName"
                        )
                    }
                }
                ownershipParameter = ownershipParameter + 1
            }
            var ownershipMethod = 0
            while (ownershipMethod < declaration.methods.size) {
                val method = declaration.methods[ownershipMethod]
                ownershipParameter = 0
                while (ownershipParameter < method.parameterKinds.size &&
                       ownershipParameter < method.parameterTypes.size) {
                    val parameterType = bootstrapNormalizeType(
                        method.parameterTypes[ownershipParameter]
                    )
                    if (bootstrapIsMutableFunctionType(parameterType) &&
                        method.parameterKinds[ownershipParameter] != "var") {
                        this.fail(
                            "ownership.fnmut-parameter-mode:${declaration.name}.${method.name}"
                        )
                    }
                    if (bootstrapIsOnceFunctionType(parameterType) &&
                        method.parameterKinds[ownershipParameter] != "own") {
                        this.fail(
                            "ownership.fnonce-parameter-mode:${declaration.name}.${method.name}"
                        )
                    }
                    if (method.parameterKinds[ownershipParameter] == "own" &&
                        !this.typeIsAffine(parameterType) &&
                        !bootstrapGenericSourceIsInstance(method.sourceIdentity)) {
                        this.fail(
                            "ownership.owned-parameter-type:${declaration.name}.${method.name}"
                        )
                    }
                    ownershipParameter = ownershipParameter + 1
                }
                ownershipMethod = ownershipMethod + 1
            }
            if (declaration.kind == "extern") {
                var externParameter = 0
                while (externParameter < declaration.parameterKinds.size) {
                    if (declaration.parameterKinds[externParameter] == "var") {
                        this.fail(
                            "ownership.mutable-borrow-extern:${declaration.name}"
                        )
                    }
                    externParameter = externParameter + 1
                }
            }
            if (declaration.isNoEscape &&
                (bootstrapRegionCallIsUnsafe(
                    this.regionCalls,
                    declaration.name
                ) || bootstrapRegionFunctionRetainsAnyParameter(
                    this.regionCalls,
                    declaration.name,
                    declaration.parameters.size
                ))) {
                this.fail("region.noescape-effect:${declaration.name}")
            }
            index = index + 1
        }
        val registry = bootstrapBuildSubparserRegistry(parsed)
        var registryError = 0
        while (registryError < registry.errors) {
            this.fail("subparser.registration")
            registryError = registryError + 1
        }
        this.initEdges.owner = -1
        this.initEdges.declaration = -1
        this.locals = []
        this.resetLocalIndex()
        this.refinementNames = []
        this.refinementTypes = []
        this.refinementScopes = []
        this.regionOwnedNames = []
        this.regionOwnedScopes = []
        this.scopeParents = [-1]
        this.currentScope = 0
        this.currentOwner = ""
        this.currentResultType = ""
        this.currentBorrowResultSource = ""
        this.returnedType = "unknown"
        this.loopDepth = 0
        this.trustedDepth = 0
        this.regionDepth = 0
        this.regionScope = -1
        this.compileDepth = 0
        // Every global is published: a result inferred from here on is final.
        this.inferredResults.settled = true
        var actionIndex = 0
        while (actionIndex < parsed.actions.size) {
            this.currentSourceIdentity = ""
            if (parsed.actions[actionIndex].kind == "compile") {
                bootstrapLiftDiscardedAction = 1
            }
            this.infer(parsed.actions[actionIndex])
            bootstrapLiftDiscardedAction = 0
            actionIndex = actionIndex + 1
        }
        index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            this.currentSourceIdentity = declaration.sourceIdentity
            this.initEdges.owner = index
            this.initEdges.declaration = index
            var nakedAnnotation = -1
            var inlineAnnotation = -1
            var noinlineAnnotation = -1
            var annotation = 0
            while (annotation < declaration.annotations.size) {
                if (declaration.annotations[annotation] == "naked") {
                    nakedAnnotation = annotation
                }
                if (declaration.annotations[annotation] == "inline") {
                    inlineAnnotation = annotation
                }
                if (declaration.annotations[annotation] == "noinline") {
                    noinlineAnnotation = annotation
                }
                // A library's reviewed promise that a global never changes
                // once built, which threads may then share (ct_init.ab).
                if (declaration.annotations[annotation] == "threadShared") {
                    if (declaration.kind != "val") {
                        this.fail("threadShared.val:${declaration.name}")
                    } else if (!bootstrapStandardLibraryModuleSource(
                        declaration.sourceIdentity
                    )) this.fail("threadShared.library:${declaration.name}")
                }
                if (declaration.annotations[annotation] == "section") {
                    if (declaration.kind != "fun" ||
                        declaration.extensionOwner != "") {
                        this.fail("section.function:${declaration.name}")
                    }
                    if (annotation >= declaration.annotationArguments.size ||
                        declaration.annotationArguments[annotation].kind !=
                            "string" ||
                        declaration.annotationArguments[annotation].text ==
                            "") {
                        this.fail("section.arguments:${declaration.name}")
                    }
                }
                if (declaration.annotations[annotation] == "wasmImport") {
                    if (declaration.kind != "extern" ||
                        declaration.externalLibrary != "c") {
                        this.fail("wasmImport.extern:${declaration.name}")
                    }
                    var wasmImportValid = false
                    if (annotation < declaration.annotationArguments.size) {
                        val wasmImport =
                            declaration.annotationArguments[annotation]
                        if (wasmImport.kind == "string") {
                            wasmImportValid = wasmImport.text != ""
                        }
                        if (wasmImport.kind == "array" &&
                            wasmImport.children.size >= 1 &&
                            wasmImport.children.size <= 2) {
                            wasmImportValid = true
                            var part = 0
                            while (part < wasmImport.children.size) {
                                if (wasmImport.children[part].kind !=
                                        "string" ||
                                    wasmImport.children[part].text == "") {
                                    wasmImportValid = false
                                }
                                part = part + 1
                            }
                        }
                    }
                    if (!wasmImportValid) {
                        this.fail("wasmImport.arguments:${declaration.name}")
                    }
                }
                annotation = annotation + 1
            }
            if (noinlineAnnotation >= 0) {
                if (declaration.kind != "fun" ||
                    declaration.extensionOwner != "") {
                    this.fail("noinline.function:${declaration.name}")
                }
                if (noinlineAnnotation >=
                    declaration.annotationArguments.size ||
                    declaration.annotationArguments[noinlineAnnotation].kind !=
                        "missing") {
                    this.fail("noinline.arguments:${declaration.name}")
                }
                if (inlineAnnotation >= 0) {
                    this.fail("noinline.inline:${declaration.name}")
                }
            }
            if (nakedAnnotation >= 0) {
                if (declaration.kind != "fun" ||
                    declaration.extensionOwner != "") {
                    this.fail("naked.function:${declaration.name}")
                }
                if (nakedAnnotation >=
                    declaration.annotationArguments.size ||
                    declaration.annotationArguments[nakedAnnotation].kind !=
                        "missing") {
                    this.fail("naked.arguments:${declaration.name}")
                }
                if (!declaration.isTrusted) {
                    this.fail("naked.trusted:${declaration.name}")
                }
                if (inlineAnnotation >= 0) {
                    this.fail("naked.inline:${declaration.name}")
                }
                var nakedBody = declaration.expression
                if (nakedBody.kind == "block" &&
                    nakedBody.children.size == 1) {
                    nakedBody = nakedBody.children[0]
                }
                if (nakedBody.kind != "call" ||
                    this.functionExternalLibrary(
                        nakedBody.text
                    ) != "inline-assembly" ||
                    nakedBody.children.size != 2) {
                    this.fail("naked.inline-assembly-body:${declaration.name}")
                }
            }
            // The probe (overload.ab) types only the bodies it may resolve in.
            if (
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.expression.kind != "missing" &&
                (this.overloads.keys.size == 0 || this.overloads.probes(declaration)) &&
                (!this.generics.probing || this.generics.probes(declaration))
            ) {
                val functionLocals: array<BootstrapSymbol> = []
                if (declaration.extensionOwner != "") {
                    var receiverKind = "parameter"
                    if (this.methodReceiverKind(
                            bootstrapNormalizeType(declaration.extensionOwner),
                            declaration.name
                        ) == "var") {
                        receiverKind = "mutable.parameter"
                    }
                    functionLocals.append(BootstrapSymbol(
                        "this",
                        receiverKind,
                        bootstrapNormalizeType(declaration.extensionOwner),
                        0,
                        "",
                        ""
                    ))
                }
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    var parameterType = "unknown"
                    var parameterKind = "parameter"
                    if (parameter < declaration.parameterTypes.size) {
                        parameterType = bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                    }
                    if (parameter < declaration.parameterKinds.size &&
                        declaration.parameterKinds[parameter] == "own") {
                        parameterKind = "owned.parameter"
                    }
                    if (parameter < declaration.parameterKinds.size &&
                        declaration.parameterKinds[parameter] == "var") {
                        parameterKind = "mutable.parameter"
                        if (!this.typeIsBorrowTracked(parameterType)) {
                            this.fail("ownership.mutable-borrow-type:${declaration.name}")
                        }
                        if (parameter < declaration.parameterDefaults.size &&
                            declaration.parameterDefaults[parameter].kind !=
                                "missing") {
                            this.fail("ownership.mutable-borrow-default:${declaration.name}")
                        }
                    }
                    functionLocals.append(BootstrapSymbol(
                        declaration.parameters[parameter],
                        parameterKind,
                        parameterType,
                        0,
                        "",
                        "abla:${declaration.sourceIdentity}:${declaration.begin}:parameter:$parameter:${declaration.parameters[parameter]}"
                    ))
                    parameter = parameter + 1
                }
                this.locals = functionLocals
                this.resetLocalIndex()
                this.refinementNames = []
                this.refinementTypes = []
                this.refinementScopes = []
                this.regionOwnedNames = []
                this.regionOwnedScopes = []
                this.scopeParents = [-1]
                this.currentScope = 0
                this.currentOwner = ""
                this.currentBody = declaration.expression
                this.currentResultType = "inferred"
                this.currentBorrowResultSource = bootstrapBorrowResultSource(
                    declaration.resultType
                )
                if (declaration.resultType != "inferred") {
                    this.currentResultType = bootstrapNormalizeType(
                        declaration.resultType
                    )
                }
                this.returnedType = "unknown"
                this.loopDepth = 0
                this.trustedDepth = 0
                this.regionDepth = 0
                this.regionScope = -1
                if (declaration.isTrusted) this.trustedDepth = 1
                if (declaration.kind == "compile.fun") {
                    this.compileDepth = 1
                } else this.compileDepth = 0
                parameter = 0
                while (parameter < declaration.parameterDefaults.size) {
                    val defaultValue = declaration.parameterDefaults[parameter]
                    if (defaultValue.kind != "missing") {
                        val defaultType = this.infer(defaultValue)
                        val parameterType = bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                        if (!this.typesCompatible(
                            parameterType,
                            defaultType
                        )) this.fail(
                            "function.default:${declaration.name}"
                        )
                    }
                    parameter = parameter + 1
                }
                bootstrapEndVoidBodyAfterAssignment(declaration.resultType, declaration.expression)
                this.usedAssignments = []
                bootstrapCollectUsedAssignments(
                    declaration.expression,
                    bootstrapResultIsUsed(declaration),
                    this.usedAssignments
                )
                bootstrapGenericExpect(this, this.currentResultType, declaration.expression)
                val actual = this.infer(declaration.expression)
                bootstrapRecordBodyResult(this, declaration, index, actual)
                this.validateBorrowReturn(
                    declaration.expression,
                    actual,
                    "function.${declaration.name}"
                )
                if (declaration.resultType != "inferred" &&
                    !this.typesCompatible(
                        bootstrapNormalizeType(declaration.resultType),
                        actual
                    ) && !this.borrowResultAccepts(
                        bootstrapNormalizeType(declaration.resultType),
                        actual
                    )) {
                    val defaultPrefix = bootstrapExtensionFieldDefaultName("")
                    this.fail(
                        if (declaration.extensionOwner != "" &&
                            declaration.name.startsWith(defaultPrefix)) {
                            // An extension field's default (its default function).
                            "field.extension-type:${declaration.extensionOwner}.${declaration.name.slice(defaultPrefix.size, declaration.name.size)}:${bootstrapNormalizeType(declaration.resultType)}:$actual"
                        } else "function.result:${declaration.name}:${bootstrapNormalizeType(declaration.resultType)}:$actual"
                    )
                }
                if (declaration.resultType != "inferred" &&
                    !bootstrapIsBorrowType(bootstrapNormalizeType(
                        declaration.resultType
                    ))) {
                    this.validateOwnershipTransfer(
                        bootstrapNormalizeType(declaration.resultType),
                        declaration.expression,
                        "function.${declaration.name}"
                    )
                }
            }
            index = index + 1
        }
        index = 0
        while (index < parsed.declarations.size) {
            val owner = parsed.declarations[index]
            if (owner.isResource) {
                var dropCount = 0
                var dropIndex = 0
                while (dropIndex < owner.methods.size) {
                    val drop = owner.methods[dropIndex]
                    if (drop.name == "drop") {
                        dropCount = dropCount + 1
                        if (drop.parameters.size != 0 ||
                            bootstrapNormalizeType(drop.resultType) != "void") {
                            this.fail("resource.drop-signature:${owner.name}")
                        }
                    }
                    dropIndex = dropIndex + 1
                }
                if (dropCount > 1) {
                    this.fail("resource.drop-duplicate:${owner.name}")
                }
            }
            var methodIndex = 0
            while (methodIndex < owner.methods.size) {
                val method = owner.methods[methodIndex]
                this.currentSourceIdentity = method.sourceIdentity
                this.initEdges.owner = this.selectedMethodHandle(owner.name, method.name)
                this.initEdges.declaration = index
                var methodAnnotation = 0
                while (methodAnnotation < method.annotations.size) {
                    if (method.annotations[methodAnnotation] == "naked") {
                        this.fail("naked.function:${owner.name}.${method.name}")
                    }
                    methodAnnotation = methodAnnotation + 1
                }
                if ((this.overloads.keys.size > 0 && !this.overloads.probes(method)) ||
                    (this.generics.probing && !this.generics.probes(method))) {
                    methodIndex = methodIndex + 1
                    continue
                }
                val methodLocals: array<BootstrapSymbol> = []
                var receiverKind = "parameter"
                if (this.methodReceiverKind(owner.name, method.name) == "var") {
                    receiverKind = "mutable.parameter"
                }
                methodLocals.append(BootstrapSymbol(
                    "this",
                    receiverKind,
                    owner.name,
                    0,
                    "",
                    ""
                ))
                var parameter = 0
                while (parameter < method.parameters.size) {
                    var parameterType = "unknown"
                    var parameterKind = "parameter"
                    if (parameter < method.parameterTypes.size) {
                        parameterType = bootstrapNormalizeType(
                            method.parameterTypes[parameter]
                        )
                    }
                    if (parameter < method.parameterKinds.size &&
                        method.parameterKinds[parameter] == "own") {
                        parameterKind = "owned.parameter"
                    }
                    if (parameter < method.parameterKinds.size &&
                        method.parameterKinds[parameter] == "var") {
                        parameterKind = "mutable.parameter"
                        if (!this.typeIsBorrowTracked(parameterType)) {
                            this.fail("ownership.mutable-borrow-type:${owner.name}.${method.name}")
                        }
                        if (parameter < method.parameterDefaults.size &&
                            method.parameterDefaults[parameter].kind !=
                                "missing") {
                            this.fail("ownership.mutable-borrow-default:${owner.name}.${method.name}")
                        }
                    }
                    methodLocals.append(BootstrapSymbol(
                        method.parameters[parameter],
                        parameterKind,
                        parameterType,
                        0,
                        "",
                        "abla:${method.sourceIdentity}:${method.begin}:parameter:$parameter:${method.parameters[parameter]}"
                    ))
                    parameter = parameter + 1
                }
                this.locals = methodLocals
                this.resetLocalIndex()
                this.refinementNames = []
                this.refinementTypes = []
                this.refinementScopes = []
                this.regionOwnedNames = []
                this.regionOwnedScopes = []
                this.scopeParents = [-1]
                this.currentScope = 0
                this.currentOwner = owner.name
                this.currentBody = method.expression
                this.currentResultType = "inferred"
                this.currentBorrowResultSource = bootstrapBorrowResultSource(
                    method.resultType
                )
                if (method.resultType != "inferred") {
                    this.currentResultType = bootstrapNormalizeType(
                        method.resultType
                    )
                }
                this.returnedType = "unknown"
                this.loopDepth = 0
                this.trustedDepth = 0
                this.regionDepth = 0
                this.regionScope = -1
                if (method.isTrusted) this.trustedDepth = 1
                if (method.kind == "compile.fun") {
                    this.compileDepth = 1
                } else this.compileDepth = 0
                parameter = 0
                while (parameter < method.parameterDefaults.size) {
                    val defaultValue = method.parameterDefaults[parameter]
                    if (defaultValue.kind != "missing") {
                        val defaultType = this.infer(defaultValue)
                        val parameterType = bootstrapNormalizeType(
                            method.parameterTypes[parameter]
                        )
                        if (!this.typesCompatible(
                            parameterType,
                            defaultType
                        )) this.fail(
                            "method.default:${owner.name}.${method.name}"
                        )
                    }
                    parameter = parameter + 1
                }
                bootstrapEndVoidBodyAfterAssignment(method.resultType, method.expression)
                this.usedAssignments = []
                bootstrapCollectUsedAssignments(
                    method.expression,
                    bootstrapResultIsUsed(method),
                    this.usedAssignments
                )
                bootstrapGenericExpect(this, this.currentResultType, method.expression)
                val actual = this.infer(method.expression)
                bootstrapRecordBodyResult(
                    this, method, this.selectedMethodHandle(owner.name, method.name), actual
                )
                val methodName = "${owner.name}.${method.name}"
                if (method.isNoEscape &&
                    (bootstrapRegionCallIsUnsafe(
                        this.regionCalls,
                        methodName
                    ) || bootstrapRegionReceiverCallIsRetaining(
                        this.regionCalls,
                        owner.name,
                        method.name
                    ) || bootstrapRegionFunctionRetainsAnyParameter(
                        this.regionCalls,
                        methodName,
                        method.parameters.size
                    ))) {
                    this.fail("region.noescape-effect:$methodName")
                }
                this.validateBorrowReturn(
                    method.expression,
                    actual,
                    "method.${owner.name}.${method.name}"
                )
                if (method.resultType != "inferred" &&
                    !this.typesCompatible(
                        bootstrapNormalizeType(method.resultType),
                        actual
                    ) && !this.borrowResultAccepts(
                        bootstrapNormalizeType(method.resultType),
                        actual
                    )) {
                    this.fail("method.result:${owner.name}.${method.name}")
                }
                if (method.resultType != "inferred" &&
                    !bootstrapIsBorrowType(bootstrapNormalizeType(
                        method.resultType
                    ))) {
                    this.validateOwnershipTransfer(
                        bootstrapNormalizeType(method.resultType),
                        method.expression,
                        "method.${owner.name}.${method.name}"
                    )
                }
                methodIndex = methodIndex + 1
            }
            index = index + 1
        }
        this.initEdges.owner = -1
        this.initEdges.declaration = -1
        // The overload probe types only some bodies: the build's analysis checks.
        val probe = this.overloads.keys.size > 0 || this.generics.probing
        val initialization = if (!probe)
            bootstrapCheckInitialization(this) else BootstrapInitialization([], [], [], [])
        if (!probe) bootstrapCheckThreadGlobals(this)
        if (!probe && this.stmEnabled) bootstrapCheckStm(this)
        if (!probe) bootstrapPublishInferredResults(this)
        BootstrapSemanticResult(
            this.symbols,
            this.errors,
            this.extensionErrors,
            this.diagnostics,
            this.mutableReceivers,
            this.compileEffects,
            this.typedCalls,
            this.resolvedNames,
            this.managedAliasBegins,
            this.managedAliasEnds,
            this.managedAliasSources,
            this.managedAliasFiles,
            BootstrapInferredResultTypes(
                this.inferredResults.sources,
                this.inferredResults.begins,
                this.inferredResults.results,
                initialization.order,
                this.initEdges.implicitDeclarations,
                this.initEdges.implicitNames,
                initialization.dependencyStarts,
                initialization.dependencies,
                this.mutationPlaceSources,
                this.mutationPlaceBegins,
                this.mutationPlaceEnds
            ),
            this.contextualLiterals,
            this.shadowedIdentifiers.keys
        )
    }
}

@noinline
fun bootstrapInferDeclarationBlock(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    result = "DeclarationBlock"
    if (analyzer.compileDepth == 0) {
        analyzer.fail("declaration.block.compile-only")
    }
    result
}

@noinline
fun bootstrapInferStringTemplate(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    var part = 0
    while (part < expression.children.size) {
        // A borrowed part (a field read through an alias) is copied
        // into the text there and then, so it is its element type.
        val inferredPart = bootstrapBorrowElementType(
            analyzer.infer(expression.children[part])
        )
        // A nominal scalar is written as the value it wraps.
        val partUnderlying = analyzer.scalarTypeUnderlying(inferredPart)
        val partType = if (partUnderlying != "") partUnderlying else inferredPart
        // A float is written by abla/float/text's f64Text, the
        // shortest text that reads back as it (as JavaScript does).
        val float = partType == "f64" || partType == "f32"
        if (float && analyzer.findKind("f64Text") != "fun") {
            analyzer.fail(
                "string.interpolation:$partType: import \"abla/float/text\" to interpolate a float"
            )
        }
        // The text is written by calls lowering inserts (bootstrapLowerStringTemplate):
        // the body calls them as if it named them.
        if (float) bootstrapInitRecordImplicitCall(analyzer, "f64Text")
        if (partType == "f32") bootstrapInitRecordImplicitCall(analyzer, "f32ToF64")
        if (partType == "u64") bootstrapInitRecordImplicitCall(analyzer, "__ablaRuntimeU64Text")
        if (partType == "char") bootstrapInitRecordImplicitCall(analyzer, "__ablaRuntimeCharText")
        // A fixed-width integer is written as its decimal value, a char as
        // its character.
        val integer = bootstrapIsIntegerScalarType(partType)
        // An unknown part follows an error already reported (an unknown
        // method or name): one mistake, one error.
        if (!float && !integer && partType != "string" &&
            partType != "bool" && partType != "null" &&
            partType != "any" &&
            !(partType == "unknown" && analyzer.errors > 0)) {
            analyzer.fail("string.interpolation:$partType")
        }
        part = part + 1
    }
    result = "string"
    result
}

@noinline
fun bootstrapInferCompile(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val effects = analyzer.expressionCompileEffects(
        expression.children[0]
    )
    val deniedEffects = bootstrapDeniedCompileEffects(
        effects,
        analyzer.compileEffectGrants
    )
    val denied = bootstrapCompileEffectName(deniedEffects)
    if (denied != "") {
        val path = bootstrapCompileEffectPath(
            expression.children[0],
            analyzer.declarations,
            analyzer.compileEffects,
            bootstrapFirstCompileEffect(deniedEffects),
            0
        )
        analyzer.fail("compile.effect-denied:$denied:$path")
    }
    // A top-level compile action's result is discarded; any other one
    // becomes a program value (ct_lift.ab).
    val lifted = bootstrapLiftDiscardedAction == 0
    bootstrapLiftDiscardedAction = 0
    val previousBarrier = analyzer.compileLocalBarrier
    if (analyzer.compileDepth == 0) analyzer.compileLocalBarrier = analyzer.locals.size
    analyzer.compileDepth = analyzer.compileDepth + 1
    result = analyzer.infer(expression.children[0])
    analyzer.compileDepth = analyzer.compileDepth - 1
    analyzer.compileLocalBarrier = previousBarrier
    val problem = if (lifted) bootstrapLiftTypeProblem(analyzer, result) else ""
    if (problem != "") analyzer.fail("compile.result: $problem")
    result
}

@noinline
fun bootstrapInferRegion(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val previousScope = analyzer.enterScope()
    val previousRegionScope = analyzer.regionScope
    analyzer.regionDepth = analyzer.regionDepth + 1
    analyzer.regionScope = analyzer.currentScope
    result = analyzer.infer(expression.children[0])
    analyzer.regionScope = previousRegionScope
    analyzer.regionDepth = analyzer.regionDepth - 1
    analyzer.leaveScope(previousScope)
    if (!bootstrapRegionResultIsIndependent(result) &&
        !analyzer.regionExpressionIsPromotion(expression.children[0])) {
        analyzer.fail("region.result:$result")
    }
    result
}

@noinline
fun bootstrapInferArray(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // A literal of a named or expected type (`array<T>()`, or one that
    // expected_types.ab typed from its context) checks its elements against
    // it; any other takes the type its elements share, `[]` and `null` taking
    // the others' (`[[1], []]`, `["x", null]`). One a store typed from its
    // inferred receiver (contextualizeArrayLiteral) types its elements so.
    var declared = expression.text
    val contextual = declared == "" && analyzer.contextualLiterals.begins.size > 0
    if (contextual) {
        declared = analyzer.contextualLiterals.find(
            analyzer.currentSourceIdentity, expression.begin, expression.end
        )
    }
    val typed = declared != ""
    val type = if (typed) bootstrapNormalizeType(declared) else ""
    var elementType = if (typed) bootstrapArrayElementType(type) else "unknown"
    var element = 0
    while (element < expression.children.size) {
        if (typed) analyzer.contextualizeLambdaParameters(expression.children[element], elementType)
        if (contextual && typed) {
            analyzer.recordContextualLiteral(
                expression.children[element], declared.slice(6, declared.size - 1)
            )
        }
        val found = analyzer.infer(expression.children[element])
        if (bootstrapIsBorrowType(found)) {
            analyzer.fail("ownership.borrow-store:array")
        }
        if (typed) {
            if (!analyzer.typesOrUpcast(elementType, found)) analyzer.fail("array.element-type")
        } else if (elementType == "unknown") {
            elementType = found
        } else if (elementType != found) {
            val joined = bootstrapJoinTypesWith(
                elementType, found, analyzer.declarations, analyzer.typeDeclarations
            )
            if (joined == "void") analyzer.fail("array.element-type")
            else elementType = joined
        }
        element = element + 1
    }
    result = if (typed) type else "array:$elementType"
    result
}

@noinline
fun bootstrapInferRange(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val beginType = analyzer.infer(expression.children[0])
    val endType = analyzer.infer(expression.children[1])
    if (beginType != "i64" || endType != "i64") {
        analyzer.fail("range.bound-type")
    }
    result = "array:i64"
    result
}

@noinline
fun bootstrapInferIdentifier(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    result = analyzer.findType(expression.text)
    val kind = analyzer.findKind(expression.text)
    // A local of the same name (in any module) is the local, not the global.
    if ((kind == "compile.val" || kind == "compile.var") &&
        analyzer.compileDepth == 0 && !analyzer.shadowsGlobal(expression.text)) {
        analyzer.fail("compile.value-runtime:${expression.text}")
    }
    // `#(n * 2)` in run-time code: `n` is computed when the program runs, after
    // the compile-time expression was evaluated.
    if (analyzer.compileDepth > 0 && analyzer.compileLocalBarrier >= 0 &&
        analyzer.visibleLocalIndex(expression.text) >= 0 &&
        analyzer.visibleLocalIndex(expression.text) < analyzer.compileLocalBarrier) {
        analyzer.fail("compile.runtime-local:${expression.text}@${expression.begin}")
    }
    // `retry`, where nothing else has the name: a transaction's (never
    // completes: the transaction runs again once what it read changes).
    if (result == "unknown" && expression.text == "retry") {
        return bootstrapInferRetry(analyzer, expression)
    }
    if (result == "unknown") {
        val privateModule = analyzer.privateModuleOf(expression.text)
        analyzer.fail(
            if (privateModule != "")
                "name.private:${expression.text}:$privateModule@${expression.begin}"
            else "identifier:${expression.text}@${expression.begin}"
        )
    }
    // A runtime-internal function taken as a value is called later, anywhere.
    if (bootstrapRuntimeInternalFunction(expression.text) &&
        analyzer.visibleLocalIndex(expression.text) < 0 &&
        !bootstrapRuntimeInternalCaller(analyzer.currentSourceIdentity)) {
        analyzer.fail("native.runtime-internal:${expression.text}")
    }
    // A local named like a global (of this module or another): remembered as
    // the local, for checks that run once its scope is gone (namesGlobal).
    if (result != "unknown" && analyzer.shadowsGlobal(expression.text)) {
        analyzer.recordShadowed(expression)
    }
    if (result != "unknown") analyzer.validateGlobalVisible(expression)
    if (result != "unknown" &&
        analyzer.nameIsDelegated(expression.text)) {
        analyzer.validateDelegatedRead(expression, expression.text)
        if (analyzer.isTransactionalType(analyzer.delegateType(expression.text))) {
            analyzer.stmNote("access", -1, expression.begin, expression.text)
        }
        // (A property without a getter, reported with it, stays a field read.)
        if (analyzer.namesDelegatedField(expression.text) && result != "unknown") {
            analyzer.recordDelegatedRewrite(expression, "self.read")
        }
    }
    if (result != "unknown") {
        analyzer.recordResolvedName(expression, result)
    }
    result
}

@noinline
fun bootstrapInferLambda(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    analyzer.validateLambdaCaptures(expression)
    // A transaction body stays inside its transaction; any other lambda may
    // run anywhere (bootstrapCheckStm).
    val transactionBody = expression.begin == analyzer.stmBodyPending
    analyzer.stmBodyPending = -1
    val previousAtomicDepth = analyzer.atomicDepth
    if (!transactionBody) {
        analyzer.atomicDepth = 0
        analyzer.stmLambdaDepth = analyzer.stmLambdaDepth + 1
    }
    val previousScope = analyzer.enterScope()
    val previousResultType = analyzer.currentResultType
    val previousBorrowResultSource =
        analyzer.currentBorrowResultSource
    val previousReturnedType = analyzer.returnedType
    val previousLoopDepth = analyzer.loopDepth
    val previousGeneratorDepth = analyzer.generatorDepth
    val previousYieldedType = analyzer.yieldedType
    val previousBody = analyzer.currentBody
    analyzer.currentBody = expression
    analyzer.currentResultType = "inferred"
    analyzer.currentBorrowResultSource = ""
    analyzer.returnedType = "unknown"
    analyzer.loopDepth = 0
    if (expression.kind != "lambda.generator") {
        analyzer.generatorDepth = 0
        analyzer.yieldedType = "unknown"
    }
    var parameters = ""
    var parameter = 0
    while (parameter + 1 < expression.children.size) {
        val found = expression.children[parameter]
        var parameterType = "unknown"
        if (found.kind == "lambda.parameter" &&
            found.children.size > 0) {
            parameterType = bootstrapNormalizeType(
                found.children[0].text
            )
            if (parameter > 0) parameters = "$parameters,"
            parameters = "$parameters$parameterType"
            analyzer.locals.append(BootstrapSymbol(
                found.text,
                "parameter",
                parameterType,
                analyzer.currentScope,
                "",
                "abla:${analyzer.currentSourceIdentity}:${found.begin}:parameter:${found.text}"
            ))
        }
        parameter = parameter + 1
    }
    val body = expression.children[expression.children.size - 1]
    var bodyType = analyzer.infer(body)
    if (bootstrapIsBorrowType(bodyType)) {
        analyzer.fail("ownership.borrow-escape:lambda")
    }
    if (bodyType == "never") {
        // A generator whose body never ends (`while (true) { yield … }`)
        // yields forever; its consumer decides when to stop.
        bodyType = if (expression.kind == "lambda.generator" &&
                       analyzer.returnedType == "unknown") "void"
            else analyzer.returnedType
    } else {
        if (analyzer.returnedType != "unknown") {
            bodyType = bootstrapJoinTypes(bodyType, analyzer.returnedType)
        } else bodyType = bodyType
    }
    analyzer.currentResultType = previousResultType
    analyzer.currentBody = previousBody
    analyzer.currentBorrowResultSource = previousBorrowResultSource
    analyzer.returnedType = previousReturnedType
    analyzer.loopDepth = previousLoopDepth
    if (expression.kind != "lambda.generator") {
        analyzer.generatorDepth = previousGeneratorDepth
        analyzer.yieldedType = previousYieldedType
    }
    analyzer.leaveScope(previousScope)
    analyzer.atomicDepth = previousAtomicDepth
    if (!transactionBody) analyzer.stmLambdaDepth = analyzer.stmLambdaDepth - 1
    val functionType = "function:($parameters)->$bodyType"
    if (expression.kind == "lambda.move" ||
        expression.kind == "lambda.generator") {
        result = "once:$functionType"
    } else if (analyzer.lambdaRequiresMutableCall(expression)) {
        result = "mut:$functionType"
    } else result = functionType
    result
}

@noinline
fun bootstrapInferCallMove(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (expression.children.size != 1) {
        analyzer.fail("move.arity")
        result = "unknown"
    } else {
        val moved = expression.children[0]
        if (moved.kind == "identifier") {
            if (bootstrapIsBorrowType(analyzer.findType(moved.text))) {
                analyzer.fail("ownership.borrow-move:${moved.text}")
            } else if (!analyzer.hasMovableLocal(moved.text)) {
                analyzer.fail("move.local")
            }
        } else if (moved.kind == "delegate.project") {
            analyzer.fail("delegate.move-projection")
        } else if (moved.kind == "member" ||
                   moved.kind == "index") {
            val root = bootstrapPlaceRootName(moved)
            if (root == "" || !analyzer.hasMovableLocal(root)) {
                analyzer.fail("ownership.place-owner:$root")
            }
            if (root != "" && analyzer.typeHasDrop(analyzer.findType(root))) {
                analyzer.fail("ownership.place-drop:$root")
            }
        } else {
            analyzer.fail("move.local-or-place")
        }
        result = analyzer.infer(moved)
        if ((moved.kind == "member" || moved.kind == "index") &&
            !analyzer.typeIsAffine(result)) {
            analyzer.fail("ownership.place-non-affine")
        }
        result = result
    }
    result
}

@noinline
fun bootstrapInferCallShared(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (expression.children.size != 1) {
        analyzer.fail("shared.arity")
        result = "unknown"
    } else {
        val element = analyzer.infer(expression.children[0])
        if (bootstrapIsBorrowType(element)) {
            analyzer.fail("ownership.borrow-store:Shared")
        }
        if (!analyzer.typeIsAffine(element)) {
            analyzer.fail("shared.element-affine:$element")
        }
        analyzer.validateOwnershipTransfer(
            element,
            expression.children[0],
            "argument.Shared"
        )
        result = "shared:$element"
    }
    result
}

@noinline
fun bootstrapInferCallMutex(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (expression.children.size != 1) {
        analyzer.fail("mutex.arity")
        result = "unknown"
    } else {
        val element = analyzer.infer(expression.children[0])
        if (bootstrapIsBorrowType(element)) {
            analyzer.fail("ownership.borrow-store:Mutex")
        }
        if (!analyzer.typeIsAffine(element)) {
            analyzer.fail("mutex.element-affine:$element")
        }
        analyzer.validateOwnershipTransfer(
            element,
            expression.children[0],
            "argument.Mutex"
        )
        result = "mutex:$element"
    }
    result
}

@noinline
fun bootstrapInferCallMap(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // `Map<K, V>()` names its type.
    val typed = expression.children.size == 1 && expression.children[0].kind == "type"
    if (typed) {
        result = bootstrapNormalizeType(expression.children[0].text)
        if (!bootstrapIsMapType(result)) {
            analyzer.fail("map.type:$result")
            result = "unknown"
        }
    } else if (expression.children.size != 0) {
        analyzer.fail("map.arity")
        result = "unknown"
    } else result = "map:unknown:unknown"
    result
}

@noinline
fun bootstrapInferCallCell(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (expression.children.size != 1) {
        analyzer.fail("cell.arity")
        result = "unknown"
    } else {
        val element = analyzer.infer(expression.children[0])
        if (!bootstrapCellElementIsCopy(element)) {
            analyzer.fail("cell.element-copy:$element")
        }
        result = "cell:$element"
    }
    result
}

@noinline
fun bootstrapInferCallFilledArray(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // `filledArray(count, value)`: count copies of a value, in one
    // allocation. Every slot holds the same value, so it must be one
    // without identity: a number, a bool or a string.
    if (expression.children.size != 2) {
        analyzer.fail("filledArray.arity")
        result = "unknown"
    } else {
        if (analyzer.infer(expression.children[0]) != "i64") {
            analyzer.fail("filledArray.count")
        }
        val element = bootstrapNormalizeType(
            analyzer.infer(expression.children[1])
        )
        if (element == "void" || element == "never" ||
            element == "null" ||
            (element != "string" &&
             !bootstrapRegionResultIsIndependent(element))) {
            analyzer.fail("filledArray.element:$element")
        }
        result = "array:$element"
    }
    result
}

/** `receiver.name(arguments)` as a call of the value of `receiver.name`. */
fun bootstrapMemberCallAsValueCall(expression: BootstrapExpression): BootstrapExpression {
    val children: array<BootstrapExpression> = [BootstrapExpression(
        "member", expression.text, expression.begin, expression.end,
        [expression.children[0]]
    )]
    var argument = 1
    while (argument < expression.children.size) {
        children.append(expression.children[argument])
        argument = argument + 1
    }
    BootstrapExpression("call.value", "", expression.begin, expression.end, children)
}

/** A call of a value: `f(1)(2)`, `handlers[0]()`, `(holder.callback)(5)`; the
 *  callee is any expression of function type, called with its parameters. */
@noinline
fun bootstrapInferCallValue(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val calleeType = bootstrapBorrowElementType(analyzer.infer(expression.children[0]))
    val parameterCount = bootstrapFunctionParameterCount(calleeType)
    if (!bootstrapIsFunctionType(calleeType)) {
        if (calleeType != "unknown") analyzer.fail("call.value-target:$calleeType")
    } else if (parameterCount < 0 || expression.children.size - 1 != parameterCount) {
        analyzer.fail("function.arity:value")
    }
    var argument = 1
    while (argument < expression.children.size) {
        val expected = if (bootstrapIsFunctionType(calleeType))
            bootstrapFunctionParameterType(calleeType, argument - 1) else "unknown"
        analyzer.contextualizeLambdaParameters(expression.children[argument], expected)
        val actual = analyzer.infer(expression.children[argument])
        if (!analyzer.typesOrUpcast(expected, actual)) {
            analyzer.fail("function.argument:value@${expression.children[argument].begin}:$expected:$actual")
        }
        if (bootstrapIsFunctionType(calleeType)) {
            val kind = bootstrapFunctionParameterKind(calleeType, argument - 1)
            if (kind == "var") {
                analyzer.validateMutableBorrowArgument(
                    expression.children[argument], expected, "function.value"
                )
            }
            if (kind == "own") {
                analyzer.validateOwnershipTransfer(
                    expected, expression.children[argument], "argument.function.value"
                )
            }
        }
        argument = argument + 1
    }
    result = if (bootstrapIsFunctionType(calleeType))
        bootstrapFunctionResultType(calleeType) else "unknown"
    result
}

@noinline
fun bootstrapInferCall(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // A local or parameter of function type is called as itself: no
    // top-level declaration of the same name describes it.
    val localCallable = analyzer.callsLocal(expression.text, expression.children.size)
    if (localCallable) analyzer.recordShadowed(expression)
    else analyzer.validateGlobalVisible(expression)
    if (!localCallable && analyzer.regionDepth > 0 &&
        bootstrapRegionCallIsUnsafe(
            analyzer.regionCalls,
            expression.text
        )) {
        analyzer.fail("region.call-retention:${expression.text}")
    }
    if (!localCallable && analyzer.regionDepth > 0) {
        var retainedParameter = 0
        while (retainedParameter < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                analyzer.regionCalls,
                expression.text,
                retainedParameter
            ) && !analyzer.regionExpressionIsOwned(
                expression.children[retainedParameter]
            )) {
                analyzer.fail(
                    "region.parameter-retention:${expression.text}#$retainedParameter"
                )
            }
            retainedParameter = retainedParameter + 1
        }
    }
    if (!localCallable && analyzer.functionRequiresTrust(expression.text) &&
        analyzer.trustedDepth == 0) {
        analyzer.fail("native.trust:${expression.text}")
    }
    if (!localCallable && bootstrapRuntimeInternalFunction(expression.text) &&
        !bootstrapRuntimeInternalCaller(analyzer.currentSourceIdentity)) {
        analyzer.fail("native.runtime-internal:${expression.text}")
    }
    // A call no local takes goes to the top-level declaration of its name,
    // past a local or field of the same name that isn't a function.
    val functionType = if (localCallable) analyzer.findType(expression.text)
        else analyzer.findTopLevelType(expression.text)
    val externalLibrary = if (localCallable) "" else analyzer.functionExternalLibrary(
        expression.text
    )
    if (externalLibrary == "inline-assembly") {
        val assemblyTemplate = if (expression.children.size > 0) {
            bootstrapStaticString(expression.children[0])
        } else BootstrapStaticString("", false)
        val assemblyConstraints = if (expression.children.size > 1) {
            bootstrapStaticString(expression.children[1])
        } else BootstrapStaticString("", false)
        if (!analyzer.functionRequiresTrust(expression.text) ||
            !analyzer.functionIsNoEscape(expression.text)) {
            analyzer.fail("inline-assembly.trusted-noescape")
        }
        if (expression.children.size < 2 ||
            !assemblyTemplate.valid || !assemblyConstraints.valid) {
            analyzer.fail("inline-assembly.literal-template-constraints")
        }
        val assemblyResult = bootstrapNormalizeType(
            bootstrapFunctionResultType(functionType)
        )
        if (!bootstrapScalarTypeUnderlyingValid(assemblyResult) &&
            assemblyResult != "void") {
            analyzer.fail("inline-assembly.scalar-result")
        }
        var assemblyParameter = 2
        while (assemblyParameter <
               bootstrapFunctionParameterCount(functionType)) {
            if (!bootstrapScalarTypeUnderlyingValid(
                bootstrapNormalizeType(
                    bootstrapFunctionParameterType(
                        functionType, assemblyParameter
                    )
                )
            )) {
                analyzer.fail("inline-assembly.scalar-parameter")
            }
            assemblyParameter = assemblyParameter + 1
        }
    }
    val symbolKind = if (localCallable) "local" else analyzer.findKind(expression.text)
    // A `compile fun`, like the compiler's own API, runs while the program is
    // compiled, so run-time code reaches it only through `#`.
    if ((symbolKind == "compile.fun" ||
         symbolKind == "extern" && analyzer.functionIsCompilerApi(expression.text)) &&
        analyzer.compileDepth == 0 && !localCallable) {
        analyzer.fail("compile.call-runtime:${expression.text}@${expression.begin}")
    }
    val primitiveType = if (!localCallable && bootstrapScalarTypeUnderlyingValid(
        bootstrapNormalizeType(expression.text)
    )) bootstrapNormalizeType(expression.text) else ""
    val contractModule = if (localCallable) "" else analyzer.contractModuleForFunction(
        expression.text
    )
    if (contractModule != "" && !analyzer.allowContractCalls) {
        analyzer.fail(
            "contract.call.not-consumed:$contractModule::${bootstrapCanonicalDeclarationSourceName(expression.text)}"
        )
    }
    if (analyzer.regionDepth > 0 &&
        bootstrapIsFunctionType(functionType) &&
        symbolKind != "fun" && symbolKind != "extern" &&
        symbolKind != "compile.fun" &&
        !bootstrapIsNoEscapeFunctionType(functionType) &&
        !analyzer.regionNameIsOwned(expression.text)) {
        analyzer.fail("region.indirect-call-retention:${expression.text}")
    }
    // An overloaded name is published only as its `name__<types>` members; a call
    // the overload probe couldn't resolve was reported there (ambiguous or no
    // match), so it isn't also a missing target.
    if (!bootstrapIsFunctionType(functionType) &&
        symbolKind != "class" && symbolKind != "type" &&
        primitiveType == "" &&
        !bootstrapHasOverloadMember(analyzer.declarations, expression.text)) {
        val privateModule = analyzer.privateModuleOf(expression.text)
        analyzer.fail(
            if (privateModule != "")
                "name.private:${expression.text}:$privateModule@${expression.begin}"
            else "call.target:${expression.text}"
        )
    }
    var argument = 0
    val resolvedArgumentTypes: array<string> = []
    val resolvedParameterTypes: array<string> = []
    val resolvedParameterKinds: array<string> = []
    var resolvedInsertedDefaults = 0
    val classDeclarationIndex = if (symbolKind == "class")
        analyzer.typeDeclarations.find(expression.text)
    else -1
    while (argument < expression.children.size) {
        var expectedArgument = "unknown"
        if (bootstrapIsFunctionType(functionType)) {
            val declaredParameterCount =
                (if (localCallable) -1 else analyzer.functionParameterCount(expression.text))
            if (declaredParameterCount < 0) {
                expectedArgument = bootstrapFunctionParameterType(
                    functionType,
                    argument
                )
            } else if (argument < declaredParameterCount) {
                expectedArgument = analyzer.functionParameterType(
                    expression.text,
                    argument
                )
            }
        } else if (symbolKind == "class") {
            if (classDeclarationIndex >= 0) {
                val declaration =
                    analyzer.declarations[classDeclarationIndex]
                if (argument < declaration.parameterTypes.size) {
                    expectedArgument = bootstrapNormalizeType(
                        declaration.parameterTypes[argument]
                    )
                }
            }
        } else if (symbolKind == "type" || primitiveType != "") {
            expectedArgument = analyzer.scalarTypeUnderlying(
                expression.text
            )
            if (primitiveType != "") expectedArgument = primitiveType
        }
        analyzer.contextualizeLambdaParameters(
            expression.children[argument],
            expectedArgument
        )
        resolvedArgumentTypes.append(
            analyzer.infer(expression.children[argument])
        )
        argument = argument + 1
    }
    if (bootstrapIsFunctionType(functionType)) {
        val parameterCount = (if (localCallable) -1 else analyzer.functionParameterCount(expression.text))
        var effectiveParameterCount = parameterCount
        var requiredCount = analyzer.functionRequiredParameterCount(
            expression.text
        )
        if (effectiveParameterCount < 0) {
            effectiveParameterCount =
                bootstrapFunctionParameterCount(functionType)
            requiredCount = effectiveParameterCount
        }
        if (effectiveParameterCount < 0 ||
            expression.children.size > effectiveParameterCount ||
            expression.children.size < requiredCount) {
            analyzer.fail("function.arity:${expression.text}")
        }
        resolvedInsertedDefaults =
            effectiveParameterCount - expression.children.size
        argument = 0
        val argumentKinds: array<string> = []
        val argumentTypes: array<string> = []
        while (argument < expression.children.size &&
               argument < effectiveParameterCount) {
            val actual = resolvedArgumentTypes[argument]
            var expected = analyzer.functionParameterType(
                expression.text,
                argument
            )
            if (parameterCount < 0) {
                expected = bootstrapFunctionParameterType(
                    functionType,
                    argument
                )
            }
            if (bootstrapImplicitIntegerNarrowing(
                expected, analyzer.scalarValueType(actual),
                expression.children[argument]
            )) {
                analyzer.fail("integer.narrowing:${expression.text}@${expression.children[argument].begin}:$expected:$actual")
            } else if (!bootstrapTypesCompatibleWithInferredNoEscape(
                expected,
                actual,
                expression.children[argument],
                analyzer.regionCalls,
                analyzer.declarations
            ) &&
                !analyzer.upcastsToInterface(expected, actual)) analyzer.fail("function.argument:${expression.text}@${expression.children[argument].begin}:$expected:$actual")
            var parameterKind = "parameter"
            if (parameterCount >= 0) {
                parameterKind = analyzer.functionParameterKind(
                    expression.text,
                    argument
                )
            } else {
                parameterKind = bootstrapFunctionParameterKind(
                    functionType,
                    argument
                )
            }
            if (parameterKind == "own") {
                if (bootstrapIsBorrowType(actual)) {
                    analyzer.fail("ownership.borrow-exclusive:${expression.text}")
                }
                analyzer.validateOwnershipTransfer(
                    expected,
                    expression.children[argument],
                    "argument.function.${expression.text}"
                )
            }
            if (parameterKind == "var") {
                if (bootstrapIsBorrowType(actual)) {
                    analyzer.fail("ownership.borrow-exclusive:${expression.text}")
                }
                analyzer.validateMutableBorrowArgument(
                    expression.children[argument],
                    expected,
                    "function.${expression.text}"
                )
            }
            argumentKinds.append(parameterKind)
            argumentTypes.append(expected)
            resolvedParameterKinds.append(parameterKind)
            resolvedParameterTypes.append(expected)
            argument = argument + 1
        }
        analyzer.validateCallAliases(
            expression.children,
            argumentKinds,
            argumentTypes,
            "function.${expression.text}"
        )
    }
    if (symbolKind == "class" && classDeclarationIndex >= 0) {
        val declaration = analyzer.declarations[classDeclarationIndex]
        if (declaration.parameters.size !=
            expression.children.size) {
            analyzer.fail("constructor.arity:${expression.text}")
        }
        var parameter = 0
        while (parameter < declaration.parameters.size &&
               parameter < expression.children.size) {
            val actual = resolvedArgumentTypes[parameter]
            val expected = bootstrapNormalizeType(
                declaration.parameterTypes[parameter]
            )
            if (bootstrapImplicitIntegerNarrowing(
                expected, analyzer.scalarValueType(actual),
                expression.children[parameter]
            )) {
                analyzer.fail("integer.narrowing:${expression.text}@${expression.children[parameter].begin}:$expected:$actual")
            } else if (!analyzer.typesOrUpcast(expected, actual)) {
                analyzer.fail("constructor.argument:${expression.text}")
            }
            if (parameter < declaration.parameterKinds.size &&
                (declaration.parameterKinds[parameter] == "val" ||
                 declaration.parameterKinds[parameter] == "var" ||
                 declaration.parameterKinds[parameter] == "own")) {
                if (bootstrapIsBorrowType(actual) &&
                    (analyzer.typeIsAffine(expected) ||
                     !analyzer.typeNeedsManagedAliasTracking(expected))) {
                    analyzer.fail(
                        "ownership.borrow-store:${expression.text}"
                    )
                }
                analyzer.validateOwnershipTransfer(
                    expected,
                    expression.children[parameter],
                    "argument.constructor.${expression.text}"
                )
            }
            parameter = parameter + 1
        }
    }
    if (symbolKind == "type" || primitiveType != "") {
        var underlying = analyzer.scalarTypeUnderlying(expression.text)
        if (primitiveType != "") underlying = primitiveType
        if (expression.children.size != 1) {
            analyzer.fail("type.constructor-arity:${expression.text}")
        }
        // A nominal scalar converts as the value it wraps.
        if (expression.children.size == 1 &&
            !bootstrapScalarConversionCompatible(
                underlying, analyzer.scalarValueType(resolvedArgumentTypes[0])
            )) {
            analyzer.fail("type.constructor-argument:${expression.text}")
        }
        result = if (primitiveType == "") expression.text
            else primitiveType
    } else if (symbolKind == "class") {
        result = expression.text
        val storedSource = analyzer.constructorStoredBorrowSource(
            expression
        )
        if (storedSource == "managed.unknown") {
            analyzer.fail(
                "ownership.stored-reference-provenance:${expression.text}"
            )
        } else if (storedSource == "managed.multiple") {
            analyzer.fail(
                "ownership.stored-reference-multiple:${expression.text}"
            )
        } else if (storedSource != "") {
            result = "borrow:$result"
        }
    } else {
        result = bootstrapFunctionResultType(functionType)
        if (symbolKind == "fun" || symbolKind == "compile.fun") {
            result = analyzer.borrowResultOfFreshSource(result, "", expression, 0)
        }
        if (bootstrapIsBorrowType(result) &&
            symbolKind != "fun" &&
            symbolKind != "compile.fun") {
            val sourceParameter =
                bootstrapFunctionBorrowResultParameter(functionType)
            if (sourceParameter < 0 ||
                sourceParameter >= expression.children.size) {
                analyzer.fail(
                    "ownership.borrow-return-indirect-source:${expression.text}"
                )
            }
            if (sourceParameter >= 0 &&
                bootstrapFunctionParameterKind(
                    functionType,
                    sourceParameter
                ) != "parameter") {
                analyzer.fail(
                    "ownership.borrow-return-indirect-mode:${expression.text}"
                )
            }
        }
        result = result
    }
    if (bootstrapIsFunctionType(functionType)) {
        analyzer.recordTypedCall(
            expression,
            result,
            "",
            if (localCallable) -1 else analyzer.topLevelFunctionHandle(expression.text),
            resolvedArgumentTypes,
            resolvedParameterTypes,
            resolvedParameterKinds,
            resolvedInsertedDefaults
        )
    }
    result
}

@noinline
fun bootstrapInferMember(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val rawReceiver = analyzer.infer(expression.children[0])
    val receiver = bootstrapBorrowElementType(rawReceiver)
    // Another module's private extension field.
    val privateField = analyzer.privateExtensionModule(receiver, expression.text)
    if (privateField != "") {
        analyzer.fail("name.private:${receiver}.${expression.text}:$privateField@${expression.begin}")
    }
    if (expression.text == "size" &&
        (receiver == "string" || bootstrapIsArrayType(receiver) ||
         bootstrapIsMapType(receiver))) {
        result = "i64"
    } else {
        result = analyzer.fieldType(receiver, expression.text)
        if (result == "unknown") {
            analyzer.fail("member:${receiver}.${expression.text}")
        }
        // (A property without a getter, reported with it, stays a field read.)
        if (analyzer.delegatedField(receiver, expression.text) != "" && result != "unknown") {
            analyzer.recordDelegatedRewrite(expression, "read")
        }
        // An extension field the object doesn't have reads its default: the
        // read calls the default function.
        if (analyzer.initEdges.owner >= 0 &&
            analyzer.extensionFieldSymbol(receiver, expression.text) >= 0) {
            val defaultFunction = analyzer.symbolIndex(
                "$receiver.${bootstrapExtensionFieldDefaultName(expression.text)}"
            )
            if (defaultFunction >= 0) bootstrapInitRecordSymbol(analyzer, defaultFunction)
        }
        if (bootstrapIsBorrowType(rawReceiver) &&
            !bootstrapRegionResultIsIndependent(result)) {
            result = "borrow:$result"
        }
        result = result
    }
    val identity = analyzer.fieldDeclarationIdentity(
        receiver, expression.text
    )
    if (identity != "") analyzer.resolvedNames.append(
        BootstrapResolvedName(
            analyzer.currentSourceIdentity,
            expression.end - expression.text.size,
            expression.end,
            expression.text,
            identity,
            bootstrapNormalizeType(result),
            "field"
        )
    )
    result
}

@noinline
fun bootstrapInferIndex(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val rawReceiver = analyzer.infer(expression.children[0])
    val receiver = bootstrapBorrowElementType(rawReceiver)
    val index = analyzer.infer(expression.children[1])
    if (index != "i64") analyzer.fail("index.type")
    if (receiver == "string") result = "i64"
    else if (bootstrapIsArrayType(receiver)) {
        result = bootstrapArrayElementType(receiver)
        if (bootstrapIsBorrowType(rawReceiver) &&
            !bootstrapRegionResultIsIndependent(result)) {
            result = "borrow:$result"
        }
        result = result
    } else {
        analyzer.fail("index.receiver:$receiver")
        result = "unknown"
    }
    result
}

@noinline
fun bootstrapInferIndexAssign(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    analyzer.validateBorrowMutation(
        expression.children[0],
        "index.assign"
    )
    analyzer.stmCheckMutation(
        expression.children[0], expression.begin,
        "${bootstrapPlaceRootName(expression.children[0])}[]"
    )
    val rawReceiver = analyzer.infer(expression.children[0])
    if (bootstrapIsBorrowType(rawReceiver)) {
        analyzer.fail("ownership.borrow-mutation:index.assign")
    }
    val receiver = bootstrapBorrowElementType(rawReceiver)
    val index = analyzer.infer(expression.children[1])
    // A lambda takes its parameter types from the element type.
    if (bootstrapIsArrayType(receiver)) {
        analyzer.contextualizeLambdaParameters(
            expression.children[2],
            bootstrapArrayElementType(receiver)
        )
        analyzer.contextualizeArrayLiteral(expression.children[2], bootstrapArrayElementType(receiver))
    }
    val value = analyzer.infer(expression.children[2])
    if (bootstrapIsBorrowType(value)) {
        analyzer.fail("ownership.borrow-store:index.assign")
    }
    if (index != "i64") analyzer.fail("index.assign-index")
    if (!bootstrapIsArrayType(receiver) ||
        !bootstrapTypesCompatible(
            bootstrapArrayElementType(receiver),
            value
        )) {
        analyzer.fail("index.assign-value")
    }
    analyzer.validateRegionStore(
        expression.children[0],
        expression.children[2],
        "index.assign"
    )
    result = value
    result
}

@noinline
fun bootstrapInferMemberCall(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    rawReceiver: string,
    receiver: string,
    initial: string
): string {
    var result = initial
    if (analyzer.regionDepth > 0 &&
        bootstrapRegionMemberCallIsUnsafe(
            analyzer.regionCalls,
            expression.text
        )) {
        analyzer.fail("region.call-retention:${expression.text}")
    }
    if (analyzer.regionDepth > 0 &&
        bootstrapRegionReceiverCallIsRetaining(
            analyzer.regionCalls,
            receiver,
            expression.text
        ) &&
        !analyzer.regionExpressionIsOwned(expression.children[0])) {
        analyzer.fail(
            "region.receiver-retention:${receiver}.${expression.text}"
        )
    }
    if (analyzer.regionDepth > 0) {
        val methodName = "$receiver.${expression.text}"
        var retainedParameter = 1
        while (retainedParameter < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                analyzer.regionCalls,
                methodName,
                retainedParameter - 1
            ) && !analyzer.regionExpressionIsOwned(
                expression.children[retainedParameter]
            )) {
                analyzer.fail(
                    "region.parameter-retention:$methodName#${retainedParameter - 1}"
                )
            }
            retainedParameter = retainedParameter + 1
        }
    }
    if (bootstrapIsMapType(receiver) &&
        (bootstrapIsMapBuiltinMethod(expression.text) ||
         analyzer.methodParameterCount(receiver, expression.text) < 0)) {
        result = analyzer.inferMapCall(expression, rawReceiver, receiver)
    } else if (bootstrapIsCellType(receiver)) {
        val element = bootstrapCellElementType(receiver)
        if (expression.text == "get") {
            if (expression.children.size != 1) {
                analyzer.fail("cell.get.arity")
            }
            result = element
        } else if (expression.text == "set") {
            analyzer.stmCheckMutation(
                expression.children[0], expression.begin,
                "${bootstrapPlaceRootName(expression.children[0])}.set()"
            )
            if (expression.children.size != 2) {
                analyzer.fail("cell.set.arity")
            } else {
                analyzer.contextualizeLambdaParameters(expression.children[1], element)
                analyzer.contextualizeArrayLiteral(expression.children[1], element)
                val value = analyzer.infer(expression.children[1])
                if (!bootstrapTypesCompatible(element, value)) {
                    analyzer.fail("cell.set.value:$element:$value")
                }
            }
            result = "void"
        } else {
            analyzer.fail("cell.member:${expression.text}")
            result = "unknown"
        }
    } else if (bootstrapIsMutexType(receiver)) {
        if (expression.text == "clone") {
            if (expression.children.size != 1) {
                analyzer.fail("mutex.clone.arity")
            }
            result = receiver
        } else if (expression.text == "with") {
            if (expression.children.size != 2) {
                analyzer.fail("mutex.with.arity")
                result = "unknown"
            } else {
                val callbackExpression = expression.children[1]
                val callback = analyzer.infer(callbackExpression)
                if (callbackExpression.kind != "identifier" ||
                    !bootstrapIsFunctionType(callback) ||
                    bootstrapFunctionParameterCount(callback) != 1) {
                    analyzer.fail("mutex.with.callback")
                }
                if (bootstrapIsFunctionType(callback) &&
                    bootstrapFunctionParameterCount(callback) == 1) {
                    if (bootstrapFunctionParameterKind(callback, 0) !=
                        "var") {
                        analyzer.fail("mutex.with.callback-mode")
                    }
                    if (!bootstrapTypesCompatible(
                        bootstrapMutexElementType(receiver),
                        bootstrapFunctionParameterType(callback, 0)
                    )) analyzer.fail("mutex.with.callback-type")
                    result = bootstrapFunctionResultType(callback)
                    if (!bootstrapRegionResultIsIndependent(result)) {
                        analyzer.fail("mutex.with.result:$result")
                    }
                }
            }
        } else {
            analyzer.fail("mutex.member:${expression.text}")
            result = "unknown"
        }
    } else if (bootstrapIsSharedType(receiver)) {
        if (expression.children.size != 1) {
            analyzer.fail("shared.${expression.text}.arity")
        }
        if (expression.text == "clone") result = receiver
        else if (expression.text == "get") {
            result = "borrow:${bootstrapSharedElementType(receiver)}"
        } else if (expression.text == "downgrade") {
            result = "weak:${bootstrapSharedElementType(receiver)}"
        } else {
            analyzer.fail("shared.member:${expression.text}")
            result = "unknown"
        }
    } else if (bootstrapIsWeakType(receiver)) {
        if (expression.children.size != 1) {
            analyzer.fail("weak.${expression.text}.arity")
        }
        if (expression.text == "clone") result = receiver
        else if (expression.text == "upgrade") {
            result = "nullable:shared:${bootstrapWeakElementType(receiver)}"
        } else if (expression.text == "isAlive") result = "bool"
        else {
            analyzer.fail("weak.member:${expression.text}")
            result = "unknown"
        }
    } else
    if (expression.text == "append" &&
        bootstrapIsArrayType(receiver)) {
        if (bootstrapIsBorrowType(rawReceiver)) {
            analyzer.fail("ownership.borrow-mutation:append")
        }
        analyzer.validateBorrowMutation(
            expression.children[0],
            "append"
        )
        analyzer.stmCheckMutation(
            expression.children[0], expression.begin,
            "${bootstrapPlaceRootName(expression.children[0])}.append()"
        )
        if (expression.children.size != 2) {
            analyzer.fail("append.arity")
        } else {
            // A lambda takes its parameter types from the element type.
            analyzer.contextualizeLambdaParameters(
                expression.children[1],
                bootstrapArrayElementType(receiver)
            )
            analyzer.contextualizeArrayLiteral(expression.children[1], bootstrapArrayElementType(receiver))
            val value = analyzer.infer(expression.children[1])
            if (bootstrapIsBorrowType(value)) {
                analyzer.fail("ownership.borrow-store:append")
            }
            if (!analyzer.typesOrUpcast(
                bootstrapArrayElementType(receiver),
                value
            )) {
                analyzer.fail("append.value")
            }
            analyzer.validateOwnershipTransfer(
                bootstrapArrayElementType(receiver),
                expression.children[1],
                "append"
            )
            analyzer.validateRegionStore(
                expression.children[0],
                expression.children[1],
                "append"
            )
        }
        result = "void"
    } else if ((expression.text == "truncate" ||
                expression.text == "clear") &&
               bootstrapIsArrayType(receiver)) {
        // `items.truncate(n)` keeps the first n elements (0 <= n <=
        // size, else a trap) and `items.clear()` keeps none; the
        // array keeps its capacity for what is appended next.
        if (bootstrapIsBorrowType(rawReceiver)) {
            analyzer.fail("ownership.borrow-mutation:${expression.text}")
        }
        analyzer.validateBorrowMutation(
            expression.children[0],
            expression.text
        )
        analyzer.stmCheckMutation(
            expression.children[0], expression.begin,
            "${bootstrapPlaceRootName(expression.children[0])}.${expression.text}()"
        )
        val arity = if (expression.text == "clear") 1 else 2
        if (expression.children.size != arity) {
            analyzer.fail("${expression.text}.arity")
        } else if (arity == 2 &&
                   analyzer.infer(expression.children[1]) != "i64") {
            analyzer.fail("truncate.size")
        }
        if (analyzer.typeIsAffine(bootstrapArrayElementType(receiver))) {
            analyzer.fail("ownership.affine-drop:${expression.text}")
        }
        result = "void"
    } else if (expression.text == "slice" && receiver == "string") {
        if (expression.children.size != 3) {
            analyzer.fail("slice.arity")
        } else {
            val begin = analyzer.infer(expression.children[1])
            val end = analyzer.infer(expression.children[2])
            if (begin != "i64" || end != "i64") {
                analyzer.fail("slice.index")
            }
        }
        result = "string"
    } else if (analyzer.methodParameterCount(receiver, expression.text) < 0 &&
        bootstrapIsFunctionType(bootstrapBorrowElementType(
            analyzer.fieldType(receiver, expression.text)
        ))) {
        // A function-typed property called like a method (`holder.callback(4)`)
        // when no method has that name: the property's value is called.
        result = bootstrapInferCallValue(
            analyzer, bootstrapMemberCallAsValueCall(expression), result
        )
    } else {
        // A TVar's getValue and setValue are its transaction's reads and
        // writes (any transactional delegate's).
        if (analyzer.isTransactionalType(receiver)) {
            analyzer.stmNote("access", -1, expression.begin, "${expression.text}()")
        }
        val receiverKind = analyzer.methodReceiverKind(
            receiver,
            expression.text
        )
        if (receiverKind == "var") {
            if (bootstrapIsBorrowType(rawReceiver)) {
                analyzer.fail(
                    "ownership.borrow-exclusive:${receiver}.${expression.text}"
                )
            }
            analyzer.validateMutableBorrowArgument(
                expression.children[0],
                receiver,
                "receiver.${receiver}.${expression.text}"
            )
        }
        val parameterCount = analyzer.methodParameterCount(
            receiver,
            expression.text
        )
        val requiredCount = analyzer.methodRequiredParameterCount(
            receiver,
            expression.text
        )
        val suppliedCount = expression.children.size - 1
        // Another module's private extension function.
        val privateExtension = if (parameterCount >= 0)
            analyzer.privateExtensionModule(receiver, expression.text) else ""
        if (privateExtension != "") {
            analyzer.fail(
                "name.private:${receiver}.${expression.text}:$privateExtension@${expression.begin}"
            )
        }
        if (parameterCount < 0) {
            analyzer.fail(
                "method.unknown:${receiver}.${expression.text}@${expression.begin}"
            )
            val module = bootstrapStandardMethodModule(
                receiver, expression.text
            )
            if (module != "") {
                analyzer.diagnostics =
                    "${analyzer.diagnostics}help: `${expression.text}` is declared in $module; add `import \"$module\"`\n"
            }
        } else if (suppliedCount > parameterCount ||
                   suppliedCount < requiredCount) {
            analyzer.fail("method.arity:${receiver}.${expression.text}")
        }
        var argument = 1
        val resolvedArgumentTypes: array<string> = []
        val resolvedParameterTypes: array<string> = []
        val resolvedParameterKinds: array<string> = []
        val methodArguments: array<BootstrapExpression> = [
            expression.children[0]
        ]
        val methodKinds: array<string> = [receiverKind]
        val methodTypes: array<string> = [receiver]
        while (argument < expression.children.size) {
            val expected = analyzer.methodParameterType(
                receiver,
                expression.text,
                argument - 1
            )
            analyzer.contextualizeLambdaParameters(
                expression.children[argument],
                expected
            )
            analyzer.contextualizeArrayLiteral(expression.children[argument], expected)
            val actual = analyzer.infer(expression.children[argument])
            if (bootstrapImplicitIntegerNarrowing(
                expected, analyzer.scalarValueType(actual),
                expression.children[argument]
            )) {
                analyzer.fail("integer.narrowing:${receiver}.${expression.text}@${expression.children[argument].begin}:$expected:$actual")
            } else if (!bootstrapTypesCompatibleWithInferredNoEscape(
                expected,
                actual,
                expression.children[argument],
                analyzer.regionCalls,
                analyzer.declarations
            ) &&
                !analyzer.upcastsToInterface(expected, actual)) {
                analyzer.fail("method.argument:${receiver}.${expression.text}@${expression.children[argument].begin}:$expected:$actual")
            }
            if (analyzer.methodParameterKind(
                    receiver,
                    expression.text,
                    argument - 1
                ) == "own") {
                if (bootstrapIsBorrowType(actual)) {
                    analyzer.fail(
                        "ownership.borrow-exclusive:${receiver}.${expression.text}"
                    )
                }
                analyzer.validateOwnershipTransfer(
                    expected,
                    expression.children[argument],
                    "argument.method.${receiver}.${expression.text}"
                )
            }
            if (analyzer.methodParameterKind(
                    receiver,
                    expression.text,
                    argument - 1
                ) == "var") {
                if (bootstrapIsBorrowType(actual)) {
                    analyzer.fail(
                        "ownership.borrow-exclusive:${receiver}.${expression.text}"
                    )
                }
                analyzer.validateMutableBorrowArgument(
                    expression.children[argument],
                    expected,
                    "method.${receiver}.${expression.text}"
                )
            }
            methodArguments.append(expression.children[argument])
            val selectedKind = analyzer.methodParameterKind(
                receiver,
                expression.text,
                argument - 1
            )
            methodKinds.append(selectedKind)
            methodTypes.append(expected)
            resolvedArgumentTypes.append(actual)
            resolvedParameterTypes.append(expected)
            resolvedParameterKinds.append(selectedKind)
            argument = argument + 1
        }
        analyzer.validateCallAliases(
            methodArguments,
            methodKinds,
            methodTypes,
            "method.${receiver}.${expression.text}"
        )
        result = analyzer.borrowResultOfFreshSource(
            analyzer.methodResultType(receiver, expression.text, expression.begin),
            receiver,
            expression,
            1
        )
        analyzer.recordTypedCall(
            expression,
            result,
            receiver,
            analyzer.selectedMethodHandle(receiver, expression.text),
            resolvedArgumentTypes,
            resolvedParameterTypes,
            resolvedParameterKinds,
            parameterCount - suppliedCount
        )
    }
    result
}

@noinline
fun bootstrapInferMemberAssign(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    analyzer.validateBorrowMutation(
        expression.children[0],
        "member.assign.${expression.text}"
    )
    analyzer.stmCheckMutation(
        expression.children[0], expression.begin,
        "${bootstrapPlaceRootName(expression.children[0])}.${expression.text}"
    )
    val rawReceiver = analyzer.infer(expression.children[0])
    if (bootstrapIsBorrowType(rawReceiver)) {
        analyzer.fail("ownership.borrow-mutation:member.assign")
    }
    val receiver = bootstrapBorrowElementType(rawReceiver)
    val expected = analyzer.fieldType(receiver, expression.text)
    analyzer.contextualizeLambdaParameters(expression.children[1], expected)
    analyzer.contextualizeArrayLiteral(expression.children[1], expected)
    val actual = analyzer.infer(expression.children[1])
    // `account.balance = v` calls the delegate's setValue (rewritten).
    val delegated = analyzer.delegatedField(receiver, expression.text)
    // One that can't be made is reported once: it becomes its value alone.
    if (delegated != "") {
        var action = "assign"
        if (!bootstrapDelegatedIsMutable(delegated)) {
            analyzer.failProperty("member.immutable:${receiver}.${expression.text}")
            action = "drop.assign"
        } else if (!bootstrapTypesCompatible(expected, actual)) {
            analyzer.failProperty("member.assign:${receiver}.${expression.text}")
            action = "drop.assign"
        } else if (!analyzer.delegatedHasSetter(delegated)) action = "drop.assign"
        analyzer.recordDelegatedRewrite(expression, action, expected)
        return actual
    }
    if (bootstrapIsBorrowType(actual)) {
        analyzer.fail("ownership.borrow-store:field.${expression.text}")
    }
    if (expected == "unknown" ||
        !analyzer.typesOrUpcast(expected, actual)) {
        analyzer.fail("member.assign:${receiver}.${expression.text}")
    }
    analyzer.validateOwnershipTransfer(
        expected,
        expression.children[1],
        "field.${expression.text}"
    )
    if (!analyzer.fieldIsMutable(receiver, expression.text)) {
        analyzer.fail("member.immutable:${receiver}.${expression.text}")
    }
    analyzer.validateRegionStore(
        expression.children[0],
        expression.children[1],
        "field.${expression.text}"
    )
    result = actual
    result
}

@noinline
fun bootstrapInferBlock(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // What the block is expected to be, its last expression is.
    val expected = bootstrapGenericExpectedOf(analyzer, expression)
    val previousScope = analyzer.enterScope()
    result = "void"
    var statement = 0
    while (statement < expression.children.size) {
        val inferred = expression.children[statement]
        if (statement + 1 == expression.children.size) bootstrapGenericExpect(analyzer, expected, inferred)
        result = analyzer.infer(inferred)
        // After `if (x == null) return …` the rest of the block knows
        // x is not null.
        val after = bootstrapConditionAfterIf(inferred)
        if (after != "") analyzer.addNullableRefinements(
            inferred.children[0], after == "true"
        )
        statement = statement + 1
    }
    analyzer.leaveScope(previousScope)
    result
}

@noinline
fun bootstrapInferDefer(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (expression.children.size != 1 ||
        expression.children[0].kind == "missing") {
        analyzer.fail("defer.body")
    }
    if (expression.children.size == 1 &&
        bootstrapExpressionContainsDeferredControl(
            expression.children[0]
        )) analyzer.fail("defer.control")
    var deferredType = "once:function:()->void"
    if (expression.children.size == 1 &&
        expression.children[0].kind != "missing") {
        deferredType = analyzer.infer(BootstrapExpression(
            "lambda.move",
            "",
            expression.begin,
            expression.end,
            [expression.children[0]]
        ))
    }
    if (deferredType != "once:function:()->void") {
        analyzer.fail("defer.result")
    }
    result = "void"
    result
}

@noinline
fun bootstrapInferGenerator(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (expression.children.size != 1 ||
        expression.children[0].kind == "missing") {
        analyzer.fail("generator.body")
        result = "generator:unknown"
    } else {
        val previousGeneratorDepth = analyzer.generatorDepth
        val previousYieldedType = analyzer.yieldedType
        analyzer.generatorDepth = analyzer.generatorDepth + 1
        analyzer.yieldedType = "unknown"
        val callable = analyzer.infer(BootstrapExpression(
            "lambda.generator",
            "",
            expression.begin,
            expression.end,
            [expression.children[0]]
        ))
        val element = analyzer.yieldedType
        analyzer.generatorDepth = previousGeneratorDepth
        analyzer.yieldedType = previousYieldedType
        if (bootstrapFunctionResultType(callable) != "void") {
            analyzer.fail("generator.result")
        }
        if (element == "unknown") analyzer.fail("generator.empty")
        // What the state machine cannot keep across a `yield` (generator.ab).
        val expansion = bootstrapGeneratorExpand(expression, [])
        if (expansion.error != "") {
            analyzer.fail("${expansion.error}@${expansion.errorBegin}")
        }
        result = "generator:$element"
    }
    result
}

@noinline
fun bootstrapInferYield(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (analyzer.generatorDepth <= 0) analyzer.fail("yield.outside-generator")
    var found = "unknown"
    if (expression.children.size == 1) {
        found = analyzer.infer(expression.children[0])
    } else analyzer.fail("yield.value")
    if (bootstrapIsBorrowType(found) || analyzer.typeIsAffine(found)) {
        analyzer.fail("yield.affine:$found")
    }
    if (analyzer.yieldedType == "unknown") analyzer.yieldedType = found
    else if (!bootstrapTypesCompatible(analyzer.yieldedType, found)) {
        analyzer.fail("yield.type")
    }
    result = "void"
    result
}

@noinline
fun bootstrapInferTask(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // A transaction could start it again, and an abandoned one couldn't stop it.
    if (analyzer.atomicDepth > 0) analyzer.fail("stm.effect:thread@${expression.begin}")
    analyzer.stmNote("thread", -1, expression.begin, expression.kind)
    if (expression.children.size != 1 ||
        expression.children[0].kind == "missing") {
        analyzer.fail("${expression.kind}.body")
        result = "${expression.kind}:unknown"
    } else {
        if (expression.kind == "thread") {
            analyzer.validateThreadCaptures(expression.children[0])
        }
        // What a thread's body reads and calls is recorded for it as well
        // (bootstrapCheckThreadGlobals); a task runs on its starter's thread.
        val previousThread = analyzer.initEdges.threadBody
        if (expression.kind == "thread") {
            analyzer.initEdges.threadBody = analyzer.initEdges.threadSources.size
            analyzer.initEdges.threadSources.append(analyzer.currentSourceIdentity)
            analyzer.initEdges.threadBegins.append(expression.begin)
        }
        val callable = analyzer.infer(BootstrapExpression(
            "lambda.move",
            "",
            expression.begin,
            expression.end,
            [expression.children[0]]
        ))
        analyzer.initEdges.threadBody = previousThread
        val found = bootstrapFunctionResultType(callable)
        if (bootstrapIsBorrowType(found) || analyzer.typeIsAffine(found)) {
            analyzer.fail("${expression.kind}.affine-result:$found")
        }
        if (expression.kind == "thread" &&
            analyzer.threadUsesMutableGlobal(expression.children[0])) {
            analyzer.fail("thread.mutable-global")
        }
        result = "${expression.kind}:$found"
    }
    result
}

@noinline
fun bootstrapInferAwait(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    var operation = "unknown"
    if (expression.children.size == 1) {
        operation = analyzer.infer(expression.children[0])
        // `await` consumes its task or thread: a borrowed one (a parameter, a loop's
        // element of an array, an element or field read in place) would be dropped again
        // by its owner. `move(...)` extracts a place first.
        val awaited = expression.children[0]
        if (awaited.kind == "identifier" &&
            analyzer.hasVisibleLocal(awaited.text) &&
            !analyzer.hasMovableLocal(awaited.text)) {
            analyzer.fail("ownership.await-borrow:${awaited.text}")
        } else if (awaited.kind == "member" || awaited.kind == "index") {
            analyzer.fail("ownership.await-borrow:${bootstrapPlaceRootName(awaited)}")
        }
    } else analyzer.fail("await.operation")
    if (bootstrapIsTaskType(operation)) {
        result = bootstrapTaskResultType(operation)
    } else if (bootstrapIsThreadType(operation)) {
        result = bootstrapThreadResultType(operation)
    } else {
        analyzer.fail("await.type:$operation")
        result = "unknown"
    }
    result
}

// package.ab's bootstrapStandardLibraryRoot, without importing it: programs
// that import sema alone (the compiler's own tests) don't have module.ab.
fun bootstrapHintStandardLibraryRoot(): string {
    val stdlib = linuxEnvironment("ABLA_STDLIB")
    val sysroot = linuxEnvironment("ABLA_SYSROOT")
    var result = "./stdlib"
    if (sysroot.found && sysroot.value != "") result = "${sysroot.value}/stdlib"
    if (stdlib.found && stdlib.value != "") result = stdlib.value
    result
}

// The standard-library module that declares the extension method
// `<receiver>.<method>` on a built-in type, for a hint when it isn't imported
// ("" when none does). Only read on that error path.
fun bootstrapStandardMethodModule(receiver: string, method: string): string {
    val surface = if (receiver == "i64") "int" else receiver
    var result = ""
    if (surface == "string" || surface == "int" || surface == "f64" ||
        surface == "bool") {
        val needle = "fun $surface.$method"
        val modules = ["abla/text", "abla/core"]
        var index = 0
        while (result == "" && index < modules.size) {
            val path = Path(bootstrapHintStandardLibraryRoot()).child(
                modules[index]
            ).child("entry.ab")
            if (path.info().exists()) {
                val source = path.readText()
                var at = 0
                while (result == "" && at + needle.size < source.size) {
                    val next = source[at + needle.size]
                    if (source.slice(at, at + needle.size) == needle &&
                        (at == 0 || source[at - 1] == 10) &&
                        (next == 40 || next == 58 || next == 32)) {
                        result = modules[index]
                    }
                    at = at + 1
                }
            }
            index = index + 1
        }
    }
    result
}

@noinline
fun bootstrapInferReturn(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (analyzer.regionDepth > 0) analyzer.fail("region.control:return")
    // A transaction's body is a closure: `return` would leave only it.
    if (analyzer.atomicDepth > 0) analyzer.fail("stm.control:return@${expression.begin}")
    var returned = "void"
    if (expression.children[0].kind != "missing") {
        if (analyzer.generics.probing && analyzer.currentResultType != "inferred") {
            analyzer.genericExpected = analyzer.currentResultType
            analyzer.genericExpectedBegin = expression.children[0].begin
            analyzer.genericExpectedEnd = expression.children[0].end
        }
        returned = analyzer.infer(expression.children[0])
    }
    analyzer.validateBorrowReturn(
        expression.children[0],
        returned,
        "return"
    )
    if (analyzer.currentResultType == "") {
        analyzer.fail("return.outside-function")
    }
    if (analyzer.currentResultType != "" &&
        analyzer.currentResultType != "inferred" &&
        !analyzer.typesCompatible(analyzer.currentResultType, returned) &&
        !analyzer.borrowResultAccepts(analyzer.currentResultType, returned)) {
        analyzer.fail(
            "return.type@${expression.begin}:${analyzer.currentResultType}:$returned"
        )
        // A closure that changes what it captured is an FnMut (one that
        // consumes a capture, an FnOnce): a plain function type can't hold it.
        val expected = analyzer.currentResultType
        if (returned.size > 4 && returned.slice(0, 4) == "mut:" &&
            !(expected.size > 4 && expected.slice(0, 4) == "mut:")) {
            analyzer.diagnostics =
                "${analyzer.diagnostics}help: the returned closure changes what it captured, so its type is `FnMut`: declare the result as `FnMut(...) -> T`\n"
        } else if (returned.size > 5 && returned.slice(0, 5) == "once:" &&
                   !(expected.size > 5 && expected.slice(0, 5) == "once:")) {
            analyzer.diagnostics =
                "${analyzer.diagnostics}help: the returned closure consumes what it captured, so its type is `FnOnce`: declare the result as `FnOnce(...) -> T`\n"
        }
    }
    if (analyzer.currentResultType != "" &&
        analyzer.currentResultType != "inferred" &&
        !bootstrapIsBorrowType(analyzer.currentResultType)) {
        analyzer.validateOwnershipTransfer(
            analyzer.currentResultType,
            expression.children[0],
            "return"
        )
    }
    if (analyzer.returnedType == "unknown") analyzer.returnedType = returned
    else analyzer.returnedType = bootstrapJoinTypes(
        analyzer.returnedType,
        returned
    )
    result = "never"
    result
}

@noinline
fun bootstrapInferLocal(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (analyzer.hasLocal(expression.text)) {
        analyzer.fail("local.duplicate:${expression.text}")
    } else if (analyzer.redeclaresParameter(expression.text)) {
        analyzer.fail("local.shadows-parameter:${expression.text}")
    }
    val delegated = expression.children.size > 0 &&
        expression.children[0].kind == "delegate.initializer"
    if (delegated) {
        val initializer = expression.children[0]
        val type = analyzer.delegatedInitializerType(
            initializer,
            expression.text
        )
        val delegateType = bootstrapDelegatedStorageType(type)
        analyzer.validateOwnershipTransfer(
            delegateType,
            initializer.children[0],
            "delegate.${expression.text}"
        )
        val kind = if (expression.kind == "local.var") "var" else "val"
        analyzer.locals.append(BootstrapSymbol(
            expression.text,
            kind,
            type,
            analyzer.currentScope,
            "",
            "abla:${analyzer.currentSourceIdentity}:${expression.begin}:local:${expression.text}"
        ))
        if (analyzer.regionDepth > 0 &&
            analyzer.regionExpressionIsOwned(initializer.children[0])) {
            analyzer.markRegionOwned(expression.text, analyzer.currentScope)
        }
        result = "void"
    } else {
    val hasInitializer = expression.children[0].kind != "missing"
    var initializerType = "unknown"
    var borrowSource = ""
    if (hasInitializer) {
        // A lambda takes its parameter types from a declared
        // function type, as an argument does from its parameter.
        if (expression.children.size > 1 &&
            expression.children[1].text != "inferred") {
            analyzer.contextualizeLambdaParameters(
                expression.children[0],
                bootstrapNormalizeType(expression.children[1].text)
            )
        }
        if (analyzer.generics.probing && expression.children.size > 1 &&
            expression.children[1].text != "inferred") {
            analyzer.genericExpected = bootstrapNormalizeType(expression.children[1].text)
            analyzer.genericExpectedBegin = expression.children[0].begin
            analyzer.genericExpectedEnd = expression.children[0].end
        }
        initializerType = analyzer.infer(expression.children[0])
        if (!bootstrapIsBorrowType(initializerType) &&
            analyzer.typeNeedsManagedAliasTracking(initializerType) &&
            (expression.children[0].kind == "identifier" ||
             expression.children[0].kind == "member" ||
             expression.children[0].kind == "index" ||
             expression.children[0].kind == "delegate.project")) {
            val managedSource = analyzer.borrowArgumentSource(
                expression.children[0]
            )
            if (managedSource != "") {
                initializerType = "borrow:$initializerType"
                borrowSource = managedSource
                analyzer.managedAliasBegins.append(expression.begin)
                analyzer.managedAliasEnds.append(expression.end)
                analyzer.managedAliasSources.append(managedSource)
                analyzer.managedAliasFiles.append(analyzer.currentSourceIdentity)
            }
        }
        if (bootstrapIsBorrowType(initializerType) &&
            expression.kind == "local.var") {
            analyzer.fail(
                "ownership.borrow-mutable-local:${expression.text}"
            )
        }
        if (bootstrapIsBorrowType(initializerType)) {
            if (borrowSource == "" &&
                expression.children[0].kind == "identifier" &&
                analyzer.nameIsDelegated(
                    expression.children[0].text
                )) {
                borrowSource = expression.children[0].text
            }
            if (borrowSource == "") {
                borrowSource = analyzer.borrowExpressionSource(
                    expression.children[0]
                )
            }
            if (borrowSource == "") {
                analyzer.fail("ownership.borrow-source:${expression.text}")
            }
            if (expression.children[0].kind == "call" &&
                analyzer.findKind(expression.children[0].text) == "class") {
                analyzer.managedAliasBegins.append(expression.begin)
                analyzer.managedAliasEnds.append(expression.end)
                analyzer.managedAliasSources.append(borrowSource)
                analyzer.managedAliasFiles.append(analyzer.currentSourceIdentity)
            }
        }
    }
    var type = initializerType
    if (expression.children.size > 1 &&
        expression.children[1].text != "inferred") {
        val declaredType = bootstrapNormalizeType(
            expression.children[1].text
        )
        if (bootstrapIsBorrowType(initializerType)) {
            if (declaredType != initializerType &&
                declaredType != bootstrapBorrowElementType(
                    initializerType
                )) {
                analyzer.fail(
                    "ownership.borrow-annotation:${expression.text}"
                )
            }
            type = initializerType
            bootstrapSemanticUnit()
        } else {
            type = declaredType
            if (hasInitializer &&
                !analyzer.typesCompatible(type, initializerType)) {
                analyzer.fail("local.initializer:${expression.text}")
            }
            bootstrapSemanticUnit()
        }
        type = type
    }
    if (hasInitializer) {
        if (expression.kind == "local.val" &&
            !bootstrapIsBorrowType(type) &&
            analyzer.typeNeedsManagedAliasTracking(type) &&
            analyzer.expressionProducesFreshManagedReference(
                expression.children[0],
                0,
                true
            )) borrowSource = "managed.fresh"
        if (borrowSource == "" && expression.kind == "local.val" &&
            !bootstrapIsBorrowType(type) &&
            analyzer.managedReferenceIsStatic(expression.children[0])) {
            borrowSource = "managed.static"
        }
        analyzer.validateOwnershipTransfer(
            type,
            expression.children[0],
            "local.${expression.text}"
        )
    }
    if (!hasInitializer) {
        if (expression.kind != "local.var") {
            analyzer.fail("local.uninitialized-val:${expression.text}")
        }
        if (expression.children.size < 2 ||
            expression.children[1].text == "inferred") {
            analyzer.fail("local.uninitialized-type:${expression.text}")
        }
    }
    val kind = if (expression.kind == "local.var") "var" else "val"
    // An abandoned attempt skips the drops of what its body owned.
    if (analyzer.atomicDepth > 0 && analyzer.typeIsAffine(type)) {
        analyzer.fail("stm.resource:${expression.text}@${expression.begin}")
    }
    analyzer.locals.append(BootstrapSymbol(
        expression.text,
        kind,
        type,
        analyzer.currentScope,
        borrowSource,
        "abla:${analyzer.currentSourceIdentity}:${expression.begin}:local:${expression.text}"
    ))
    if (analyzer.regionDepth > 0 && hasInitializer &&
        analyzer.regionExpressionIsOwned(expression.children[0])) {
        analyzer.markRegionOwned(expression.text, analyzer.currentScope)
    }
    result = "void"
    }
    result
}

@noinline
fun bootstrapInferAssign(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val delegated = analyzer.nameIsDelegated(expression.text)
    val target = analyzer.findType(expression.text)
    analyzer.contextualizeLambdaParameters(
        expression.children[0], bootstrapBorrowElementType(target)
    )
    analyzer.contextualizeArrayLiteral(expression.children[0], target)
    val value = analyzer.infer(expression.children[0])
    if (target != "unknown") {
        analyzer.recordResolvedName(expression, target)
    }
    if (bootstrapIsBorrowType(value)) {
        analyzer.fail("ownership.borrow-store:assignment.${expression.text}")
    }
    val property = delegated && analyzer.namesDelegatedField(expression.text)
    var propertyAction = "self.assign"
    if (delegated && analyzer.isTransactionalType(analyzer.delegateType(expression.text))) {
        analyzer.stmNote("access", -1, expression.begin, expression.text)
    } else analyzer.stmCheckMutation(
        BootstrapExpression("identifier", expression.text, expression.begin, expression.end, []),
        expression.begin, ""
    )
    if (target == "unknown" ||
        !analyzer.typesCompatible(target, value)) {
        if (property) {
            analyzer.failProperty("assignment.type:${expression.text}@${expression.begin}")
            propertyAction = "drop.assign"
        } else analyzer.fail(
            "assignment.type:${expression.text}@${expression.begin}"
        )
    }
    if (delegated) {
        val delegateType = analyzer.delegateType(expression.text)
        if (!analyzer.isRuntimeValueType(delegateType)) analyzer.stmNote(
            "call", analyzer.selectedMethodHandle(delegateType, "setValue"), expression.begin, ""
        )
        val setterInput = analyzer.methodParameterType(
            delegateType,
            "setValue",
            0
        )
        analyzer.validateOwnershipTransfer(
            setterInput,
            expression.children[0],
            "delegate.setter.${expression.text}"
        )
        analyzer.validateBorrowMutation(
            BootstrapExpression(
                "identifier",
                expression.text,
                expression.begin,
                expression.end,
                []
            ),
            "delegate.setter.${expression.text}"
        )
        analyzer.recordTypedCall(
            expression,
            "void",
            delegateType,
            analyzer.selectedMethodHandle(delegateType, "setValue"),
            [value],
            [setterInput],
            [analyzer.methodParameterKind(
                delegateType,
                "setValue",
                0
            )],
            0
        )
    } else analyzer.validateOwnershipTransfer(
            target,
            expression.children[0],
            "assignment.${expression.text}"
        )
    if (analyzer.hasVisibleLocal(expression.text) &&
        !analyzer.localIsMutable(expression.text)) {
        analyzer.fail("assignment.immutable:${expression.text}")
    }
    if (!analyzer.hasVisibleLocal(expression.text) &&
        analyzer.currentOwner != "" &&
        analyzer.fieldType(analyzer.currentOwner, expression.text) != "unknown" &&
        !analyzer.fieldIsMutable(analyzer.currentOwner, expression.text)) {
        if (property) {
            analyzer.failProperty("field.immutable:${expression.text}")
            propertyAction = "drop.assign"
        } else analyzer.fail("field.immutable:${expression.text}")
    }
    if (property) {
        if (!analyzer.delegatedHasSetter(analyzer.findStorageType(expression.text))) {
            propertyAction = "drop.assign"
        }
        analyzer.recordDelegatedRewrite(expression, propertyAction, target)
    }
    if (!analyzer.shadowsGlobal(expression.text) &&
        analyzer.findKind(expression.text) == "val") {
        analyzer.fail("global.immutable:${expression.text}")
    }
    if (analyzer.shadowsGlobal(expression.text)) analyzer.recordShadowed(expression)
    analyzer.validateGlobalVisible(expression)
    val assignmentTarget = BootstrapExpression(
        "identifier",
        expression.text,
        expression.begin,
        expression.end,
        []
    )
    if (!delegated) analyzer.validateRegionStore(
            assignmentTarget,
            expression.children[0],
            "assignment.${expression.text}"
        )
    if (analyzer.regionDepth > 0 &&
        analyzer.hasVisibleLocal(expression.text) &&
        analyzer.scopeIsWithin(
            analyzer.visibleLocalScope(expression.text),
            analyzer.regionScope
        ) && analyzer.regionExpressionIsOwned(expression.children[0])) {
        analyzer.markRegionOwned(
            expression.text,
            analyzer.visibleLocalScope(expression.text)
        )
    }
    result = value
    result
}

/** `atomic { … }`: its body's type. The body is a closure of no parameters
 *  (what the runtime runs, again after a conflict). */
@noinline
fun bootstrapInferAtomic(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    if (expression.children.size != 1) return "unknown"
    val outermost = analyzer.atomicDepth == 0
    analyzer.stmNote("atomic", -1, expression.begin, "")
    val previousFloor = analyzer.stmScopeFloor
    analyzer.stmScopeFloor = analyzer.scopeParents.size
    analyzer.atomicDepth = analyzer.atomicDepth + 1
    analyzer.stmBodyPending = expression.children[0].begin
    val body = analyzer.infer(expression.children[0])
    analyzer.atomicDepth = analyzer.atomicDepth - 1
    analyzer.stmScopeFloor = previousFloor
    // What the body may do, through what it calls too: nothing an abandoned
    // attempt could not take back (the outermost transaction checks all).
    if (outermost && analyzer.compileEffects.names.size > 0) {
        val effect = bootstrapStmEffectName(
            analyzer.expressionCompileEffects(expression.children[0])
        )
        if (effect != "") analyzer.fail("stm.effect:$effect@${expression.begin}")
    }
    bootstrapFunctionResultType(body)
}

/** An effect a transaction may not have (`stm.effect:<effect>`), of an
 *  effect mask: I/O, the file system, the network or a native call. "" when
 *  none (reading the environment, the clock or random numbers is allowed). */
fun bootstrapStmEffectName(mask: int): string =
    if (bootstrapCompileEffectHas(mask, 32)) "io"
    else if (bootstrapCompileEffectHas(mask, 4) || bootstrapCompileEffectHas(mask, 8)) "filesystem"
    else if (bootstrapCompileEffectHas(mask, 64)) "network"
    else if (bootstrapCompileEffectHas(mask, 512)) "native"
    else ""

// Whether the program being analyzed is built for WebAssembly (backend.ab sets
// it around the analysis).
var bootstrapSemanticTargetsWasm = false

// Whether that WebAssembly program has an `orElse` whose first alternative can
// reach `retry` (bootstrapCheckStm): the alternative is then left by a
// WebAssembly exception (the backend's bootstrapLlvmWasmUnwinding), and only
// then is the module built with exception handling.
var bootstrapSemanticWasmUnwinds = false

/** `a orElse b` (in an `atomic`): the alternatives' shared type. */
@noinline
fun bootstrapInferOrElse(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    if (expression.children.size != 2) return "unknown"
    // On WebAssembly a retry the first alternative reaches leaves it by an
    // exception (bootstrapCheckStm): its span, for the check.
    if (bootstrapSemanticTargetsWasm) {
        analyzer.stmNote("orelse", expression.children[0].end, expression.children[0].begin, "")
    }
    analyzer.stmBodyPending = expression.children[0].begin
    val first = bootstrapFunctionResultType(analyzer.infer(expression.children[0]))
    analyzer.stmBodyPending = expression.children[1].begin
    val second = bootstrapFunctionResultType(analyzer.infer(expression.children[1]))
    if (first == "never") return second
    if (second == "never" || bootstrapTypesCompatible(first, second)) return first
    if (bootstrapTypesCompatible(second, first)) return second
    analyzer.fail("stm.orElse-type:$first:$second@${expression.begin}")
    "unknown"
}

/** `retry`: leaves the transaction's attempt until a TVar it read changes. */
@noinline
fun bootstrapInferRetry(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression
): string {
    // In a program with no transaction at all, no `retry` is in one.
    if (!analyzer.stmEnabled) analyzer.fail("stm.outside-atomic:retry@${expression.begin}")
    analyzer.stmNote("access", -1, expression.begin, "retry")
    "never"
}

@noinline
fun bootstrapInferDelegateProject(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (expression.children.size == 1 &&
        expression.children[0].kind == "member" &&
        expression.children[0].children.size == 1) {
        // `account.^balance`: a delegated property's delegate.
        val member = expression.children[0]
        val receiver = bootstrapBorrowElementType(analyzer.infer(member.children[0]))
        val delegated = analyzer.delegatedField(receiver, member.text)
        if (delegated == "") {
            analyzer.fail("delegate.not-delegated:`$receiver.${member.text}` has ordinary storage")
            result = "unknown"
        } else {
            analyzer.recordDelegatedRewrite(expression, "project")
            result = bootstrapDelegatedStorageType(delegated)
        }
    } else if (expression.children.size != 1 ||
        expression.children[0].kind != "identifier") {
        analyzer.fail(
            "delegate.not-delegated:delegate projection requires an addressable delegated binding"
        )
        result = "unknown"
    } else {
        val name = expression.children[0].text
        if (!analyzer.nameIsDelegated(name)) {
            analyzer.fail("delegate.not-delegated:`$name` has ordinary storage")
            result = "unknown"
        } else {
            result = analyzer.delegateType(name)
            if (analyzer.namesDelegatedField(name)) {
                analyzer.recordDelegatedRewrite(expression, "self.project")
            }
        }
    }
    result
}

@noinline
fun bootstrapInferDelegateAssign(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    var name = ""
    if (expression.children.size == 2 &&
        expression.children[0].kind == "identifier") {
        name = expression.children[0].text
    }
    if (expression.children.size == 2 &&
        expression.children[0].kind == "member" &&
        expression.children[0].children.size == 1) {
        // `account.^balance = Box(1)`: replaces a delegated property's delegate.
        val member = expression.children[0]
        val receiver = bootstrapBorrowElementType(analyzer.infer(member.children[0]))
        val delegated = analyzer.delegatedField(receiver, member.text)
        val actual = analyzer.infer(expression.children[1])
        if (delegated == "") {
            analyzer.fail("delegate.not-delegated:`$receiver.${member.text}` has ordinary storage")
        } else {
            val expected = bootstrapDelegatedStorageType(delegated)
            var action = "replace"
            if (!bootstrapDelegatedIsMutable(delegated)) {
                analyzer.failProperty("delegate.replace-val:`$receiver.${member.text}` is declared `val`")
                action = "drop.replace"
            } else if (!bootstrapTypesCompatible(expected, actual)) {
                analyzer.failProperty(
                    "delegate.type-mismatch:`$receiver.^${member.text}` stores `$expected`, not `$actual`"
                )
                action = "drop.replace"
            }
            analyzer.recordDelegatedRewrite(expression, action)
        }
        return actual
    }
    if (name != "" && analyzer.namesDelegatedField(name)) {
        val expected = analyzer.delegateType(name)
        val actual = analyzer.infer(expression.children[1])
        var action = "self.replace"
        if (!analyzer.delegatedNameIsMutable(name)) {
            analyzer.failProperty("delegate.replace-val:`$name` is declared `val`")
            action = "drop.replace"
        } else if (!bootstrapTypesCompatible(expected, actual)) {
            analyzer.failProperty(
                "delegate.type-mismatch:`^$name` stores `$expected`, not `$actual`"
            )
            action = "drop.replace"
        }
        analyzer.recordDelegatedRewrite(expression, action)
        return actual
    }
    if (name == "" || !analyzer.nameIsDelegated(name)) {
        analyzer.fail("delegate.not-delegated:projection target has ordinary storage")
        if (expression.children.size > 1) {
            result = analyzer.infer(expression.children[1])
        }
    } else {
        val expected = analyzer.delegateType(name)
        val actual = analyzer.infer(expression.children[1])
        if (!analyzer.delegatedNameIsMutable(name)) {
            analyzer.fail("delegate.replace-val:`$name` is declared `val`")
        }
        if (!bootstrapTypesCompatible(expected, actual)) {
            analyzer.fail(
                "delegate.type-mismatch:`^$name` stores `$expected`, not `$actual`"
            )
        }
        analyzer.validateOwnershipTransfer(
            expected,
            expression.children[1],
            "delegate.replace.$name"
        )
        analyzer.validateBorrowMutation(
            expression.children[0],
            "delegate.replace.$name"
        )
        analyzer.stmCheckMutation(expression.children[0], expression.begin, "^$name")
        analyzer.validateRegionStore(
            expression.children[0],
            expression.children[1],
            "delegate.replace.$name"
        )
        result = actual
    }
    result
}

@noinline
fun bootstrapInferNegate(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    operand: string,
    initial: string
): string {
    var result = initial
    result = analyzer.scalarValueType(operand)
    if (!bootstrapIsNumericScalarType(result)) {
        analyzer.failScalarExpression(
            "unary.numeric", expression, result, ""
        )
    }
    result
}

@noinline
fun bootstrapInferComplement(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    result = analyzer.scalarValueType(analyzer.infer(expression.children[0]))
    if (!bootstrapIsIntegerScalarType(result)) {
        analyzer.fail("bitwise.type")
    }
    result
}

@noinline
fun bootstrapInferIf(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // What the `if` is expected to be, each branch is (generics' inference).
    val expected = bootstrapGenericExpectedOf(analyzer, expression)
    val condition = analyzer.infer(expression.children[0])
    if (condition != "bool") analyzer.fail("if.condition")
    val previousThenScope = analyzer.enterScope()
    analyzer.addNullableRefinements(expression.children[0], true)
    bootstrapGenericExpect(analyzer, expected, expression.children[1])
    val thenType = analyzer.infer(expression.children[1])
    analyzer.leaveScope(previousThenScope)
    if (expression.children[2].kind == "missing") {
        result = "void"
    } else {
        val previousElseScope = analyzer.enterScope()
        analyzer.addNullableRefinements(expression.children[0], false)
        bootstrapGenericExpect(analyzer, expected, expression.children[2])
        val elseType = analyzer.infer(expression.children[2])
        analyzer.leaveScope(previousElseScope)
        result = bootstrapJoinTypesWith(
            thenType, elseType, analyzer.declarations, analyzer.typeDeclarations
        )
        // `a ?? b` (parser.ab, nullGuard) whose sides have no common type.
        if (expression.text == "??" && result == "void" &&
            thenType != "void" && elseType != "void") {
            analyzer.inferBegin = expression.children[0].begin
            analyzer.inferSource = analyzer.currentSourceIdentity
            analyzer.fail(
                "null-default.type:${bootstrapNormalizeType(thenType)}:${bootstrapNormalizeType(elseType)}"
            )
            result = "unknown"
        }
    }
    result
}

@noinline
fun bootstrapInferWhile(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    val condition = analyzer.infer(expression.children[0])
    if (condition != "bool") analyzer.fail("while.condition")
    analyzer.loopDepth = analyzer.loopDepth + 1
    analyzer.infer(expression.children[1])
    analyzer.loopDepth = analyzer.loopDepth - 1
    result = "void"
    if (expression.children[0].kind == "true" &&
        !bootstrapExpressionBreaksCurrentLoop(
            expression.children[1],
            0
        )) result = "never"
    result
}

@noinline
fun bootstrapInferDoWhile(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    analyzer.loopDepth = analyzer.loopDepth + 1
    analyzer.infer(expression.children[0])
    analyzer.loopDepth = analyzer.loopDepth - 1
    val condition = analyzer.infer(expression.children[1])
    if (condition != "bool") analyzer.fail("do-while.condition")
    result = "void"
    if (expression.children[1].kind == "true" &&
        !bootstrapExpressionBreaksCurrentLoop(
            expression.children[0],
            0
        )) result = "never"
    result
}

@noinline
fun bootstrapInferFor(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // `val b = a; for (n in b)`: a borrowed array iterates as one.
    val rawSourceType = analyzer.infer(expression.children[0])
    val sourceType = bootstrapBorrowElementType(rawSourceType)
    var elementType = "unknown"
    if (bootstrapIsArrayType(sourceType)) {
        elementType = bootstrapArrayElementType(sourceType)
    }
    if (bootstrapIsGeneratorType(sourceType)) {
        elementType = bootstrapGeneratorElementType(sourceType)
    }
    if (sourceType == "string") elementType = "i64"
    if (elementType == "unknown") analyzer.fail("for.source")
    // An element of a global's array is as lasting as the global; one
    // of a shared parameter's array is read-only like the parameter
    // (`for (row in rows) row.append(x)` mutates the caller's rows).
    val sharedRoot = analyzer.sharedParameterRoot(expression.children[0])
    // An affine element of an array in place stays the array's: the loop borrows it, so
    // moving or awaiting it (the array would drop it again) is rejected. Iterating
    // `move(array)` (or a fresh array) owns its elements.
    val elementSource =
        if (analyzer.managedReferenceIsStatic(expression.children[0])) {
            "managed.static"
        } else if (sharedRoot != "" &&
                   analyzer.typeNeedsManagedAliasTracking(elementType)) {
            "shared:$sharedRoot"
        } else if (bootstrapIsArrayType(sourceType) &&
                   analyzer.typeIsAffine(elementType) &&
                   (expression.children[0].kind == "identifier" ||
                    expression.children[0].kind == "member" ||
                    expression.children[0].kind == "index" ||
                    bootstrapIsBorrowType(rawSourceType))) {
            "element:${bootstrapPlaceRootName(expression.children[0])}"
        } else ""
    val previousScope = analyzer.enterScope()
    analyzer.locals.append(BootstrapSymbol(
        expression.text,
        "val",
        elementType,
        analyzer.currentScope,
        elementSource,
        "abla:${analyzer.currentSourceIdentity}:${expression.begin}:for:${expression.text}"
    ))
    analyzer.loopDepth = analyzer.loopDepth + 1
    analyzer.infer(expression.children[1])
    analyzer.loopDepth = analyzer.loopDepth - 1
    analyzer.leaveScope(previousScope)
    result = "void"
    result
}

@noinline
fun bootstrapInferBreak(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    if (analyzer.regionDepth > 0) {
        analyzer.fail("region.control:${expression.kind}")
    }
    if (analyzer.loopDepth <= 0) analyzer.fail(
        "${expression.kind}.outside-loop"
    )
    result = "never"
    result
}

@noinline
fun bootstrapInferWhen(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // What the `when` is expected to be, each arm's value is (generics' inference).
    val expected = bootstrapGenericExpectedOf(analyzer, expression)
    val subject = analyzer.infer(expression.children[0])
    var branchType = "unknown"
    var hasElse = false
    var hasTrue = false
    var hasFalse = false
    val literalKeys: array<string> = []
    // `is` arms: the classes and interfaces they test, and whether `null` is matched.
    val isTargets: array<string> = []
    var hasNull = false
    val subjectElement = bootstrapWhenSubjectElement(subject)
    if (expression.children.size == 1) analyzer.fail("when.empty")
    val notNullFrom = bootstrapWhenNotNullFrom(expression)
    var notNullScope = -1
    var branch = 1
    while (branch + 1 < expression.children.size) {
        if (branch == notNullFrom) {
            notNullScope = analyzer.enterScope()
            analyzer.addNullableRefinement(bootstrapWhenNotNullCondition(expression), true)
        }
        val match = expression.children[branch]
        if (match.kind == "missing") {
            if (hasElse) analyzer.fail("when.else-duplicate")
            if (branch + 2 < expression.children.size) {
                analyzer.fail("when.else-last")
            }
            hasElse = true
            bootstrapSemanticUnit()
        } else if (match.kind == "is") {
            val target = bootstrapNormalizeType(match.text)
            if (target == subjectElement ||
                !bootstrapTypeConformsIn(analyzer.declarations, target, subjectElement)) {
                analyzer.fail("when.is-type@${match.begin}:$subjectElement:$target")
            }
            if (bootstrapAffineNamesContain(isTargets, target)) {
                analyzer.fail("when.duplicate:is $target")
            } else isTargets.append(target)
            bootstrapSemanticUnit()
        } else {
            if (match.kind == "null") hasNull = true
            val matchType = analyzer.infer(match)
            if (!bootstrapTypesCompatible(subject, matchType)) {
                analyzer.fail("when.match")
            }
            if (match.kind == "true") hasTrue = true
            if (match.kind == "false") hasFalse = true
            val key = bootstrapWhenLiteralKey(match)
            if (key != "") {
                if (bootstrapAffineNamesContain(literalKeys, key)) {
                    analyzer.fail("when.duplicate:$key")
                } else literalKeys.append(key)
            }
            bootstrapSemanticUnit()
        }
        // In an `is` arm the subject (a local or parameter) is the type tested.
        val tested = match.kind == "is" && !bootstrapWhenArmShared(expression, branch)
        val previousScope = if (tested) analyzer.enterScope() else 0
        if (tested) {
            analyzer.addTypeRefinement(
                expression.children[0], bootstrapNormalizeType(match.text)
            )
        }
        bootstrapGenericExpect(analyzer, expected, expression.children[branch + 1])
        val found = analyzer.infer(expression.children[branch + 1])
        if (tested) analyzer.leaveScope(previousScope)
        branchType = bootstrapJoinTypesWith(
            branchType, found, analyzer.declarations, analyzer.typeDeclarations
        )
        branch = branch + 2
    }
    if (notNullScope >= 0) analyzer.leaveScope(notNullScope)
    // A sealed interface's classes are all known: `is` arms covering each
    // (and `null`, for a nullable subject) need no `else`.
    val sealedCovered = isTargets.size > 0 &&
        (!bootstrapIsNullableType(bootstrapBorrowElementType(subject)) || hasNull) &&
        bootstrapWhenCoversSealed(analyzer.declarations, subjectElement, isTargets)
    if (!hasElse && !(subject == "bool" && hasTrue && hasFalse) && !sealedCovered) {
        analyzer.fail("when.non-exhaustive:$subject")
    }
    result = branchType
    result
}

/** Whether the `when` arm after `branch` is another match of the same `a, b -> body` arm. */
fun bootstrapWhenSharesBody(expression: BootstrapExpression, branch: int): bool {
    if (branch + 3 >= expression.children.size) return false
    if (expression.children[branch + 2].kind == "missing") return false
    val body = expression.children[branch + 1]
    val next = expression.children[branch + 3]
    next.begin == body.begin && next.end == body.end && next.kind == body.kind
}

/** Whether the `when` arm at `branch` shares its body with a neighbour
 *  (`a, b -> body`). */
fun bootstrapWhenArmShared(expression: BootstrapExpression, branch: int): bool =
    bootstrapWhenSharesBody(expression, branch) ||
        (branch >= 3 && bootstrapWhenSharesBody(expression, branch - 2))

/** A `when` subject's type without a borrow or `?`: what `is` arms test. */
fun bootstrapWhenSubjectElement(subject: string): string {
    val element = bootstrapBorrowElementType(subject)
    if (bootstrapIsNullableType(element)) bootstrapNullableElementType(element)
    else element
}

/** Whether `subject` is a sealed interface and every class conforming to it
 *  is, or conforms to, one of `targets`. */
fun bootstrapWhenCoversSealed(
    declarations: array<BootstrapDeclaration>,
    subject: string,
    targets: array<string>
): bool {
    val found = bootstrapInterfaceIndexIn(declarations, subject)
    if (found < 0 || !declarations[found].isSealed) return false
    for (candidate in declarations) {
        if (candidate.kind == "class" &&
            bootstrapTypeConformsIn(declarations, candidate.name, subject)) {
            var covered = false
            for (target in targets) {
                if (target == candidate.name ||
                    bootstrapTypeConformsIn(declarations, candidate.name, target)) {
                    covered = true
                }
            }
            if (!covered) return false
        }
    }
    true
}

class BootstrapStaticInteger(val known: bool, val value: int)

// An integer expression's value when it is a constant: a literal, a constant
// negated, converted to an integer type or combined by `+`, `-`, `*`, or a
// top-level `val` (not shadowed by a local) initialized with one.
fun bootstrapStaticInteger(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    depth: int
): BootstrapStaticInteger {
    var result = BootstrapStaticInteger(false, 0)
    if (depth > 16) return result
    if (expression.kind == "integer") {
        // The parser leaves a literal's text in decimal.
        var value = 0
        for (digit in expression.text) value = value * 10 + digit - 48
        result = BootstrapStaticInteger(true, value)
    } else if (expression.kind == "unary-" && expression.children.size == 1) {
        val operand = bootstrapStaticInteger(
            analyzer, expression.children[0], depth + 1
        )
        if (operand.known) result = BootstrapStaticInteger(true, -operand.value)
    } else if ((expression.kind == "+" || expression.kind == "-" ||
                expression.kind == "*") && expression.children.size == 2) {
        val left = bootstrapStaticInteger(
            analyzer, expression.children[0], depth + 1
        )
        val right = bootstrapStaticInteger(
            analyzer, expression.children[1], depth + 1
        )
        if (left.known && right.known) {
            result = BootstrapStaticInteger(
                true,
                if (expression.kind == "+") left.value + right.value
                else if (expression.kind == "-") left.value - right.value
                else left.value * right.value
            )
        }
    } else if (expression.kind == "call" && expression.children.size == 1 &&
               bootstrapIsIntegerScalarType(expression.text)) {
        // Zero stays zero at every width.
        val operand = bootstrapStaticInteger(
            analyzer, expression.children[0], depth + 1
        )
        if (operand.known && operand.value == 0) result = operand
    } else if (expression.kind == "identifier" &&
               !analyzer.localVisible(expression.text) &&
               analyzer.findKind(expression.text) == "val") {
        var node = analyzer.declarationNames.first(expression.text)
        while (node >= 0) {
            val declaration = analyzer.declarations[
                analyzer.declarationNames.nodeDeclarations[node]
            ]
            if (declaration.kind == "val" && declaration.extensionOwner == "" &&
                declaration.name == expression.text) {
                result = bootstrapStaticInteger(
                    analyzer, declaration.expression, depth + 1
                )
                node = -1
            } else node = analyzer.declarationNames.nodeNexts[node]
        }
    }
    result
}

// A type `<` can order: a number or a string (`any` in low-level code, and
// an operand whose type is already in error).
fun bootstrapOrderedComparisonType(type: string): bool =
    bootstrapIsNumericScalarType(type) || type == "string" ||
    type == "any" || type == "unknown"

@noinline
fun bootstrapInferComparison(
    var analyzer: BootstrapAnalyzer,
    expression: BootstrapExpression,
    initial: string
): string {
    var result = initial
    // A borrow compares as what it borrows (`borrowed != null`).
    val left = bootstrapBorrowElementType(analyzer.infer(expression.children[0]))
    val right = bootstrapBorrowElementType(analyzer.infer(expression.children[1]))
    // The test of `a ?? b` or `a?.b` (parser.ab, nullGuard): `a` must be
    // able to be null.
    if (expression.text == "??" || expression.text == "?.") {
        if (left != "unknown" && left != "null" && !bootstrapIsNullableType(left)) {
            analyzer.inferBegin = expression.begin
            analyzer.inferSource = analyzer.currentSourceIdentity
            analyzer.fail(
                "${if (expression.text == "??") "null-default" else "safe-call"}.non-null:${bootstrapNormalizeType(left)}"
            )
        }
        return "bool"
    }
    if (!analyzer.typesCompatible(left, right) &&
        !analyzer.typesCompatible(right, left)) {
        analyzer.fail("comparison.type")
    } else if (expression.kind != "==" && expression.kind != "!=" &&
               (!bootstrapOrderedComparisonType(analyzer.scalarValueType(left)) ||
                !bootstrapOrderedComparisonType(analyzer.scalarValueType(right)))) {
        // `<`, `<=`, `>`, `>=` order numbers and strings (by their bytes);
        // nothing else has an order.
        analyzer.fail("comparison.type")
    }
    result = "bool"
    result
}

// The names a block's statements see bound: the enclosing ones, then each
// local the block declares, from the statement after it to the block's end,
// the scope the checker gives a local.
fun bootstrapCopyBoundNames(bound: array<string>): array<string> {
    val names: array<string> = []
    var index = 0
    while (index < bound.size) {
        names.append(bound[index])
        index = index + 1
    }
    names
}

fun bootstrapStatementDeclaresLocal(statement: BootstrapExpression): bool =
    statement.kind == "local.val" || statement.kind == "local.var"

// The key a nullable refinement is recorded under: the declaration it
// narrows, so a same-named local of a nested block is not narrowed with it.
fun bootstrapRefinementBinding(symbol: BootstrapSymbol): string =
    if (symbol.identity != "") symbol.identity else "name:${symbol.name}"

fun bootstrapAnalyzeParsed(parsed: BootstrapParseResult): BootstrapSemanticResult {
    val typedRequestBegins: array<int> = []
    val typedRequestEnds: array<int> = []
    val typedRequestKinds: array<string> = []
    bootstrapAnalyzeRequestedSpans(
        parsed,
        typedRequestBegins,
        typedRequestEnds,
        typedRequestKinds
    )
}

fun bootstrapAnalyzeRequestedSpans(
    parsed: BootstrapParseResult,
    typedRequestBegins: array<int>,
    typedRequestEnds: array<int>,
    typedRequestKinds: array<string>
): BootstrapSemanticResult = bootstrapAnalyzeRequestedSourceSpans(
    parsed,
    typedRequestBegins,
    typedRequestEnds,
    typedRequestKinds,
    []
)

fun bootstrapAnalyzeRequestedSourceSpans(
    parsed: BootstrapParseResult,
    typedRequestBegins: array<int>,
    typedRequestEnds: array<int>,
    typedRequestKinds: array<string>,
    typedRequestSources: array<string>
): BootstrapSemanticResult {
    var analyzer = bootstrapAnalyzer(
        parsed,
        typedRequestBegins,
        typedRequestEnds,
        typedRequestKinds,
        typedRequestSources,
        bootstrapNoOverloads()
    )
    analyzer.analyze(parsed)
}

fun bootstrapAnalyzer(
    parsed: BootstrapParseResult,
    typedRequestBegins: array<int>,
    typedRequestEnds: array<int>,
    typedRequestKinds: array<string>,
    typedRequestSources: array<string>,
    overloads: BootstrapOverloadTable,
    // Without them (the overload probe: overload.ab), no compile effect, and
    // no region retention, is reported.
    effects: bool = true,
    regions: bool = true,
    generics: BootstrapGenericTable = bootstrapNoGenerics()
): BootstrapAnalyzer {
    val none: array<BootstrapDeclaration> = []
    val symbols: array<BootstrapSymbol> = []
    val locals: array<BootstrapSymbol> = []
    val affineTypes = bootstrapBuildAffineTypeNames(parsed.declarations)
    val mutableReceivers = bootstrapBuildMutableReceiverSummary(
        parsed.declarations,
        affineTypes
    )
    val regionCalls = bootstrapBuildRegionCallSummary(
        if (regions) parsed.declarations else none
    )
    val compileEffects = bootstrapBuildCompileEffectSummary(
        if (effects) parsed.declarations else none
    )
    val compileEffectRequests = bootstrapBuildCompileEffectRequests(parsed)
    val compileEffectAuthorizations =
        bootstrapBuildCompileEffectAuthorizations(parsed)
    val compileEffectGrants = bootstrapBuildCompileEffectGrants(
        compileEffectRequests,
        compileEffectAuthorizations
    )
    val functionDeclarations = bootstrapFunctionDeclarationIndex(
        parsed.declarations
    )
    val typeDeclarations = bootstrapTypeDeclarationIndex(
        parsed.declarations
    )
    val methodDeclarations = bootstrapMethodDeclarationIndex(
        parsed.declarations
    )
    val borrowIndexCheck = linuxEnvironment("ABLA_BORROW_INDEX_CHECK")
    BootstrapAnalyzer(
        symbols,
        [],
        0,
        0,
        locals,
        parsed.declarations,
        functionDeclarations,
        typeDeclarations,
        methodDeclarations,
        bootstrapDeclarationNameIndex(parsed.declarations),
        borrowIndexCheck.found && borrowIndexCheck.value == "1",
        affineTypes,
        mutableReceivers,
        regionCalls,
        compileEffects,
        compileEffectGrants,
        compileEffectAuthorizations,
        typedRequestBegins,
        typedRequestEnds,
        typedRequestKinds,
        typedRequestSources,
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        parsed.diagnostics,
        [-1],
        0,
        "",
        "",
        "",
        "",
        "",
        -1,
        -1,
        "",
        0,
        0,
        0,
        -1,
        0,
        0,
        "unknown",
        typedRequestBegins.size > 0,
        bootstrapTopLevelNameIndex(parsed.declarations),
        overloads,
        [],
        "",
        0,
        "",
        BootstrapExpression("missing", "", 0, 0, []),
        -1,
        bootstrapNoInferredResults(),
        bootstrapNoInitEdges(),
        stmEnabled = bootstrapProgramUsesStm(parsed.declarations),
        generics = generics,
        transactionalNames = bootstrapTransactionalClasses(parsed.declarations, false),
        runtimeValueNames = bootstrapTransactionalClasses(parsed.declarations, true)
    )
}

/** The classes among `declarations` conforming to Transactional, or with
 *  `runtimeValued` the runtime-valued ones (bootstrapRuntimeValueSpec). */
fun bootstrapTransactionalClasses(declarations: array<BootstrapDeclaration>, runtimeValued: bool): BootstrapStringSet {
    val names = bootstrapStringSet()
    val transactional = bootstrapInterfaceIndexIn(declarations, "Transactional") >= 0
    for (declaration in declarations) {
        if (transactional && declaration.kind == "class" &&
            (if (runtimeValued) bootstrapRuntimeValueSpec(declaration) != ""
             else bootstrapTypeConformsIn(declarations, declaration.name, "Transactional"))) {
            names.add(declaration.name)
        }
    }
    names
}

/** Whether a program has an `atomic` or transactional delegates (abla/stm,
 *  which a program naming TVar has): only then are the transactions'
 *  checks recorded (bootstrapCheckStm). */
fun bootstrapProgramUsesStm(declarations: array<BootstrapDeclaration>): bool {
    for (declaration in declarations) {
        if (declaration.kind == "interface" && declaration.name == "Transactional") return true
        if (bootstrapExpressionUsesStm(declaration.expression)) return true
        for (fallback in declaration.parameterDefaults) {
            if (bootstrapExpressionUsesStm(fallback)) return true
        }
        for (method in declaration.methods) {
            if (bootstrapExpressionUsesStm(method.expression)) return true
        }
    }
    false
}

fun bootstrapExpressionUsesStm(expression: BootstrapExpression): bool {
    if (expression.kind == "atomic") return true
    for (child in expression.children) {
        if (bootstrapExpressionUsesStm(child)) return true
    }
    false
}

fun bootstrapStringSetOf(keys: array<string>): BootstrapStringSet {
    val set = bootstrapStringSet()
    for (key in keys) set.add(key)
    set
}


fun bootstrapAnalyze(source: string): BootstrapSemanticResult =
    bootstrapAnalyzeParsed(bootstrapParse(source))

/** The transactions' checks that need the whole program (language design
 *  §3b), from what each body recorded (BootstrapAnalyzer.stmNote):
 *  - a function or method that reaches a TVar (or `retry`) outside an
 *    `atomic`, itself or through what it calls, runs only inside a
 *    transaction: reaching one from where no transaction can run (`main`, a
 *    global's initializer, a lambda) is stm.outside-atomic;
 *  - a transaction may not call what starts a thread (stm.effect:thread) or
 *    changes a global (stm.outside-mutation). */
fun bootstrapCheckStm(var analyzer: BootstrapAnalyzer): void {
    val declarations = analyzer.declarations
    var nodes = declarations.size
    for (handle in analyzer.methodDeclarations.handles) {
        if (handle + 1 > nodes) nodes = handle + 1
    }
    val names: array<string> = []
    val callable: array<bool> = []
    while (names.size < nodes) {
        val index = names.size
        var name = ""
        if (index < declarations.size &&
            (declarations[index].kind == "fun" || declarations[index].kind == "compile.fun")) {
            name = "${declarations[index].name}"
        }
        names.append(name)
        callable.append(name != "")
    }
    var method = 0
    while (method < analyzer.methodDeclarations.handles.size) {
        val handle = analyzer.methodDeclarations.handles[method]
        if (handle >= 0 && handle < nodes) {
            names[handle] = "${analyzer.methodDeclarations.owners[method]}.${analyzer.methodDeclarations.declarations[method].name}"
            callable[handle] = true
        }
        method = method + 1
    }
    // Whether each body may run inside a transaction: a function's or a
    // method's, never `main`'s.
    val transacting: array<bool> = []
    var node = 0
    while (node < nodes) {
        transacting.append(callable[node] && names[node] != "main")
        node = node + 1
    }
    val transactional: array<bool> = []
    val threads: array<bool> = []
    val inputs: array<bool> = []
    val retries: array<bool> = []
    val globals: array<string> = []
    while (transactional.size < nodes) {
        retries.append(false)
        // Printing or reading the standard streams: I/O no attempt takes back.
        val index = transactional.size
        inputs.append(index < declarations.size && bootstrapStmStreamFunction(declarations[index]))
        transactional.append(false)
        threads.append(false)
        globals.append("")
    }
    val events = analyzer.stmKinds.size
    var event = 0
    while (event < events) {
        val owner = analyzer.stmOwners[event]
        if (owner >= 0 && owner < nodes) {
            val kind = analyzer.stmKinds[event]
            if (kind == "access" && !analyzer.stmInside[event] && transacting[owner]) {
                transactional[owner] = true
            }
            if (kind == "thread") threads[owner] = true
            if (kind == "access" && analyzer.stmTexts[event] == "retry") retries[owner] = true
            if (kind == "global" && globals[owner] == "") globals[owner] = analyzer.stmTexts[event]
        }
        event = event + 1
    }
    // What the callees reach, the callers reach (a call outside a
    // transaction, for running only inside one).
    var changed = true
    while (changed) {
        changed = false
        event = 0
        while (event < events) {
            val owner = analyzer.stmOwners[event]
            val target = analyzer.stmTargets[event]
            if (analyzer.stmKinds[event] == "call" && owner >= 0 && owner < nodes &&
                target >= 0 && target < nodes && callable[target]) {
                if (transactional[target] && !transactional[owner] &&
                    !analyzer.stmInside[event] && transacting[owner]) {
                    transactional[owner] = true
                    changed = true
                }
                if (threads[target] && !threads[owner]) {
                    threads[owner] = true
                    changed = true
                }
                if (inputs[target] && !inputs[owner]) {
                    inputs[owner] = true
                    changed = true
                }
                if (retries[target] && !retries[owner]) {
                    retries[owner] = true
                    changed = true
                }
                if (globals[target] != "" && globals[owner] == "") {
                    globals[owner] = globals[target]
                    changed = true
                }
            }
            event = event + 1
        }
    }
    val source = analyzer.currentSourceIdentity
    // Each mistake once, though a call is recorded at each lookup.
    val reported = bootstrapStringSet()
    // Where a TVar access outside a transaction is reported: a transactional
    // delegate's getter or setter called there is that same mistake.
    val accessed = bootstrapStringSet()
    event = 0
    while (event < events) {
        if (analyzer.stmKinds[event] == "access" && !analyzer.stmInside[event]) {
            accessed.add("${analyzer.stmSources[event]}:${analyzer.stmBegins[event]}")
        }
        event = event + 1
    }
    event = 0
    while (event < events) {
        val owner = analyzer.stmOwners[event]
        val target = analyzer.stmTargets[event]
        val kind = analyzer.stmKinds[event]
        val inside = analyzer.stmInside[event]
        val anywhere = owner < 0 || owner >= nodes || !transacting[owner]
        val at = analyzer.stmBegins[event]
        var code = ""
        if (kind == "access" && !inside && anywhere) {
            code = "stm.outside-atomic:${analyzer.stmTexts[event]}"
        }
        if (kind == "call" && target >= 0 && target < nodes && callable[target]) {
            if (!inside && anywhere && transactional[target]) {
                if (!accessed.contains("${analyzer.stmSources[event]}:$at")) code = "stm.outside-atomic:${names[target]}"
            } else if (inside && inputs[target]) {
                code = "stm.effect:io:${names[target]}"
            } else if (inside && threads[target]) {
                code = "stm.effect:thread:${names[target]}"
            } else if (inside && globals[target] != "") {
                code = "stm.outside-mutation:${names[target]}:${globals[target]}"
            }
        }
        // (A call is recorded at each lookup of its callee: once per body.)
        val key = "${analyzer.stmSources[event]}:$owner:$code"
        if (code != "" && (kind == "access" || !reported.contains(key))) {
            reported.add(key)
            analyzer.currentSourceIdentity = analyzer.stmSources[event]
            analyzer.fail("$code@$at")
        }
        event = event + 1
    }
    // On WebAssembly an `orElse` alternative that reaches a `retry` (itself,
    // through a nested transaction or what it calls) is left part-way by an
    // exception: the module is built with exception handling.
    event = 0
    while (event < events) {
        if (analyzer.stmKinds[event] == "orelse") {
            val begin = analyzer.stmBegins[event]
            val end = analyzer.stmTargets[event]
            val file = analyzer.stmSources[event]
            var reaches = false
            var inner = 0
            while (!reaches && inner < events) {
                val target = analyzer.stmTargets[inner]
                val at = analyzer.stmBegins[inner]
                if (analyzer.stmSources[inner] == file && at >= begin && at < end) {
                    if (analyzer.stmKinds[inner] == "access" && analyzer.stmTexts[inner] == "retry") {
                        reaches = true
                    }
                    if (analyzer.stmKinds[inner] == "call" && target >= 0 && target < nodes &&
                        callable[target] && retries[target]) reaches = true
                }
                inner = inner + 1
            }
            if (reaches) bootstrapSemanticWasmUnwinds = true
        }
        event = event + 1
    }
    analyzer.currentSourceIdentity = source
    return
}

/** abla/io's printing and reading, and the standard streams under them. */
fun bootstrapStmStreamFunction(declaration: BootstrapDeclaration): bool {
    if (declaration.kind != "fun" || declaration.extensionOwner != "") return false
    val name = bootstrapCanonicalDeclarationSourceName(declaration.name)
    if ((name == "print" || name == "println" || name == "eprint" ||
         name == "eprintln" || name == "readLine") &&
        bootstrapCompileProviderModule(declaration) == "io") return true
    name.startsWith("linuxPrintStandard") || name.startsWith("linuxWriteStandard") ||
        name.startsWith("linuxReadStandard")
}
