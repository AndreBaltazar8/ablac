#import("subparser.ab")

fun bootstrapSemanticUnit(): void {}

fun bootstrapPlaceRootName(expression: BootstrapExpression): string {
    var root = ""
    if (expression.kind == "identifier") root = expression.text
    if ((expression.kind == "member" || expression.kind == "index") &&
        expression.children.size > 0) {
        root = bootstrapPlaceRootName(expression.children[0])
    }
    root
}

fun bootstrapOwnershipPlaceKey(expression: BootstrapExpression): string {
    var key = ""
    var place = expression
    if (place.kind == "call" && place.text == "move" &&
        place.children.size == 1) place = place.children[0]
    if (place.kind == "identifier") key = place.text
    if (place.kind == "member" && place.children.size > 0) {
        val owner = bootstrapOwnershipPlaceKey(place.children[0])
        if (owner != "") key = "$owner.${place.text}"
    }
    if (place.kind == "index" && place.children.size > 1) {
        val owner = bootstrapOwnershipPlaceKey(place.children[0])
        var index = "*"
        if (place.children[1].kind == "integer") {
            index = place.children[1].text
        }
        if (owner != "") key = "$owner[$index]"
    }
    key
}

fun bootstrapOwnershipPlaceKeyPrefix(left: string, right: string): bool {
    var prefix = left.size <= right.size
    var index = 0
    while (prefix && index < left.size) {
        if (left[index] != right[index]) prefix = false
        index = index + 1
    }
    if (prefix && left.size < right.size) {
        prefix = right[left.size] == 46 || right[left.size] == 91
    }
    prefix
}

fun bootstrapOwnershipWildcardPrefix(place: string): string {
    var result = ""
    var index = 0
    while (result == "" && index + 2 < place.size) {
        if (place[index] == 91 && place[index + 1] == 42 &&
            place[index + 2] == 93) result = place.slice(0, index + 1)
        index = index + 1
    }
    result
}

fun bootstrapOwnershipPlaceKeysConflict(
    left: string,
    right: string
): bool {
    var conflict = left != "" && right != "" &&
        (bootstrapOwnershipPlaceKeyPrefix(left, right) ||
         bootstrapOwnershipPlaceKeyPrefix(right, left))
    val leftWildcard = bootstrapOwnershipWildcardPrefix(left)
    val rightWildcard = bootstrapOwnershipWildcardPrefix(right)
    if (!conflict && leftWildcard != "") {
        conflict = bootstrapOwnershipPlaceKeyPrefix(leftWildcard, right)
    }
    if (!conflict && rightWildcard != "") {
        conflict = bootstrapOwnershipPlaceKeyPrefix(rightWildcard, left)
    }
    conflict
}

fun bootstrapCollectOwnershipPlace(
    expression: BootstrapExpression,
    var kinds: array<int>,
    var values: array<string>
): void {
    var place = expression
    if (place.kind == "call" && place.text == "move" &&
        place.children.size == 1) {
        place = place.children[0]
    }
    if (place.kind == "identifier") {
        kinds.append(0)
        values.append(place.text)
    }
    if (place.kind == "member" && place.children.size > 0) {
        bootstrapCollectOwnershipPlace(place.children[0], kinds, values)
        kinds.append(1)
        values.append(place.text)
    }
    if (place.kind == "index" && place.children.size > 1) {
        bootstrapCollectOwnershipPlace(place.children[0], kinds, values)
        var index = "*"
        if (place.children[1].kind == "integer") {
            index = place.children[1].text
        }
        kinds.append(2)
        values.append(index)
    }
}

fun bootstrapOwnershipPlacesConflict(
    left: BootstrapExpression,
    right: BootstrapExpression
): bool {
    val leftKinds: array<int> = []
    val leftValues: array<string> = []
    val rightKinds: array<int> = []
    val rightValues: array<string> = []
    bootstrapCollectOwnershipPlace(left, leftKinds, leftValues)
    bootstrapCollectOwnershipPlace(right, rightKinds, rightValues)
    var conflict = leftValues.size > 0 && rightValues.size > 0 &&
        leftValues[0] == rightValues[0]
    var index = 1
    while (conflict && index < leftValues.size &&
           index < rightValues.size) {
        if (leftKinds[index] != rightKinds[index]) {
            index = leftValues.size + rightValues.size
            bootstrapSemanticUnit()
        } else if (leftKinds[index] == 1 &&
                   leftValues[index] != rightValues[index]) {
            conflict = false
            bootstrapSemanticUnit()
        } else if (leftKinds[index] == 2 &&
                   leftValues[index] != "*" &&
                   rightValues[index] != "*" &&
                   leftValues[index] != rightValues[index]) {
            conflict = false
            bootstrapSemanticUnit()
        }
        index = index + 1
    }
    conflict
}

fun bootstrapOwnerHasField(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    name: string
): bool {
    var found = false
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.name == owner) {
            var field = 0
            while (field < candidate.parameters.size) {
                if (candidate.parameters[field] == name &&
                    field < candidate.parameterKinds.size &&
                    (candidate.parameterKinds[field] == "val" ||
                     candidate.parameterKinds[field] == "var")) {
                    found = true
                }
                field = field + 1
            }
        }
        declaration = declaration + 1
    }
    found
}

fun bootstrapReceiverPlaceRoot(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    owner: string
): bool {
    val root = bootstrapPlaceRootName(expression)
    root == "this" || bootstrapOwnerHasField(declarations, owner, root)
}

fun bootstrapSummaryFieldType(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    field: string
): string {
    var result = "unknown"
    var declaration = 0
    while (declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.name == owner) {
            var index = 0
            while (index < candidate.parameters.size &&
                   index < candidate.parameterTypes.size) {
                if (candidate.parameters[index] == field) {
                    result = bootstrapNormalizeType(
                        candidate.parameterTypes[index]
                    )
                }
                index = index + 1
            }
        }
        declaration = declaration + 1
    }
    result
}

fun bootstrapSummaryReceiverType(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    owner: string
): string {
    var result = "unknown"
    if (expression.kind == "identifier" && expression.text == "this") {
        result = owner
    }
    if (expression.kind == "member" && expression.children.size > 0) {
        val receiver = bootstrapSummaryReceiverType(
            expression.children[0],
            declarations,
            owner
        )
        if (receiver != "unknown") {
            result = bootstrapSummaryFieldType(
                declarations,
                receiver,
                expression.text
            )
        }
    }
    bootstrapBorrowElementType(result)
}

class BootstrapMutableReceiverSummary(
    val owners: array<string>,
    val methods: array<string>
)

fun bootstrapMutableReceiverContains(
    summary: BootstrapMutableReceiverSummary,
    owner: string,
    method: string
): bool {
    var found = false
    var index = 0
    while (!found && index < summary.owners.size) {
        if (summary.owners[index] == owner &&
            summary.methods[index] == method) found = true
        index = index + 1
    }
    found
}

fun bootstrapMutableReceiverContainsMethod(
    summary: BootstrapMutableReceiverSummary,
    method: string
): bool {
    var found = false
    var index = 0
    while (!found && index < summary.methods.size) {
        if (summary.methods[index] == method) found = true
        index = index + 1
    }
    found
}

fun bootstrapFunctionArgumentIsExclusive(
    declarations: array<BootstrapDeclaration>,
    name: string,
    argument: int
): bool {
    var exclusive = false
    var declaration = 0
    while (!exclusive && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner == "" && candidate.name == name &&
            argument < candidate.parameterKinds.size &&
            (candidate.parameterKinds[argument] == "var" ||
             candidate.parameterKinds[argument] == "own")) {
            exclusive = true
        }
        declaration = declaration + 1
    }
    exclusive
}

fun bootstrapMethodArgumentIsExclusive(
    declarations: array<BootstrapDeclaration>,
    name: string,
    argument: int
): bool {
    var exclusive = false
    var declaration = 0
    while (!exclusive && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.extensionOwner != "" && candidate.name == name &&
            argument < candidate.parameterKinds.size &&
            (candidate.parameterKinds[argument] == "var" ||
             candidate.parameterKinds[argument] == "own")) {
            exclusive = true
        }
        var method = 0
        while (!exclusive && method < candidate.methods.size) {
            val found = candidate.methods[method]
            if (found.name == name && argument < found.parameterKinds.size &&
                (found.parameterKinds[argument] == "var" ||
                 found.parameterKinds[argument] == "own")) {
                exclusive = true
            }
            method = method + 1
        }
        declaration = declaration + 1
    }
    exclusive
}

fun bootstrapExpressionMayMutateReceiver(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    owner: string,
    summary: BootstrapMutableReceiverSummary
): bool {
    var mutates = expression.kind == "assign" &&
        bootstrapOwnerHasField(declarations, owner, expression.text)
    if (!mutates && expression.kind == "member.assign" &&
        expression.children.size > 0) {
        mutates = bootstrapReceiverPlaceRoot(
            expression.children[0],
            declarations,
            owner
        )
    }
    if (!mutates && expression.kind == "index.assign" &&
        expression.children.size > 0) {
        mutates = bootstrapReceiverPlaceRoot(
            expression.children[0],
            declarations,
            owner
        )
    }
    if (!mutates && expression.kind == "member.call" &&
        expression.children.size > 0) {
        val receiverType = bootstrapSummaryReceiverType(
            expression.children[0],
            declarations,
            owner
        )
        if ((expression.text == "append" ||
             bootstrapMutableReceiverContains(
                summary,
                receiverType,
                expression.text
             )) &&
            bootstrapReceiverPlaceRoot(
                expression.children[0],
                declarations,
                owner
            )) mutates = true
        var argument = 1
        while (!mutates && argument < expression.children.size) {
            if (bootstrapMethodArgumentIsExclusive(
                    declarations,
                    expression.text,
                    argument - 1
                ) && bootstrapReceiverPlaceRoot(
                    expression.children[argument],
                    declarations,
                    owner
                )) mutates = true
            argument = argument + 1
        }
    }
    if (!mutates && expression.kind == "call") {
        var argument = 0
        while (!mutates && argument < expression.children.size) {
            if (bootstrapFunctionArgumentIsExclusive(
                    declarations,
                    expression.text,
                    argument
                ) && bootstrapReceiverPlaceRoot(
                    expression.children[argument],
                    declarations,
                    owner
                )) mutates = true
            argument = argument + 1
        }
    }
    var child = 0
    while (!mutates && child < expression.children.size) {
        mutates = bootstrapExpressionMayMutateReceiver(
            expression.children[child],
            declarations,
            owner,
            summary
        )
        child = child + 1
    }
    mutates
}

fun bootstrapBuildMutableReceiverSummary(
    declarations: array<BootstrapDeclaration>,
    affineTypes: array<string>
): BootstrapMutableReceiverSummary {
    val summary = BootstrapMutableReceiverSummary([], [])
    var changed = true
    while (changed) {
        changed = false
        var declaration = 0
        while (declaration < declarations.size) {
            val candidate = declarations[declaration]
            val extensionOwner = bootstrapNormalizeType(
                candidate.extensionOwner
            )
            if (extensionOwner != "" &&
                (bootstrapSummaryTypeIsAffine(extensionOwner, affineTypes) ||
                 bootstrapSummaryTypeIsManagedReference(
                    extensionOwner,
                    declarations
                 )) &&
                !bootstrapMutableReceiverContains(
                    summary,
                    extensionOwner,
                    candidate.name
                ) && bootstrapExpressionMayMutateReceiver(
                    candidate.expression,
                    declarations,
                    extensionOwner,
                    summary
                )) {
                summary.owners.append(extensionOwner)
                summary.methods.append(candidate.name)
                changed = true
            }
            if (bootstrapSummaryTypeIsAffine(candidate.name, affineTypes) ||
                bootstrapSummaryTypeIsManagedReference(
                    candidate.name,
                    declarations
                )) {
                var method = 0
                while (method < candidate.methods.size) {
                    val found = candidate.methods[method]
                    if (!bootstrapMutableReceiverContains(
                            summary,
                            candidate.name,
                            found.name
                        ) && bootstrapExpressionMayMutateReceiver(
                            found.expression,
                            declarations,
                            candidate.name,
                            summary
                        )) {
                        summary.owners.append(candidate.name)
                        summary.methods.append(found.name)
                        changed = true
                    }
                    method = method + 1
                }
            }
            declaration = declaration + 1
        }
    }
    summary
}

fun bootstrapIsArrayType(type: string): bool =
    type.size >= 6 && type.slice(0, 6) == "array:"

fun bootstrapArrayElementType(type: string): string {
    if (bootstrapIsArrayType(type)) type.slice(6, type.size)
    else "unknown"
}

fun bootstrapIsGeneratorType(type: string): bool =
    type.size >= 10 && type.slice(0, 10) == "generator:"

fun bootstrapGeneratorElementType(type: string): string {
    if (bootstrapIsGeneratorType(type)) type.slice(10, type.size)
    else "unknown"
}

fun bootstrapIsTaskType(type: string): bool =
    type.size >= 5 && type.slice(0, 5) == "task:"

fun bootstrapTaskResultType(type: string): string {
    if (bootstrapIsTaskType(type)) type.slice(5, type.size)
    else "unknown"
}

fun bootstrapIsThreadType(type: string): bool =
    type.size >= 7 && type.slice(0, 7) == "thread:"

fun bootstrapThreadResultType(type: string): string {
    if (bootstrapIsThreadType(type)) type.slice(7, type.size)
    else "unknown"
}

fun bootstrapFunctionClose(type: string, begin: int): int {
    var close = -1
    var depth = 0
    var index = begin
    while (close < 0 && index < type.size) {
        if (type[index] == 40) depth = depth + 1
        if (type[index] == 41) {
            depth = depth - 1
            if (depth == 0) close = index
        }
        index = index + 1
    }
    close
}

fun bootstrapNormalizeFunctionType(type: string): string {
    val close = bootstrapFunctionClose(type, 0)
    var parameters = ""
    var resultBegin = close + 1
    while (resultBegin < type.size && type[resultBegin] == 32) {
        resultBegin = resultBegin + 1
    }
    var arrow = resultBegin + 1 < type.size && type[resultBegin] == 45 &&
        type[resultBegin + 1] == 62
    if (arrow) {
        resultBegin = resultBegin + 2
        while (resultBegin < type.size && type[resultBegin] == 32) {
            resultBegin = resultBegin + 1
        }
    }
    if (close > 0 && arrow && resultBegin < type.size) {
        var parameterBegin = 1
        var index = 1
        var angles = 0
        var parentheses = 0
        while (index <= close) {
            val separator = index == close ||
                (type[index] == 44 && angles == 0 && parentheses == 0)
            if (separator) {
                if (parameterBegin < index) {
                    if (parameters != "") parameters = "$parameters,"
                    parameters = "$parameters${bootstrapNormalizeType(
                        type.slice(parameterBegin, index)
                    )}"
                }
                parameterBegin = index + 1
                parameters = parameters
            } else {
                if (type[index] == 60) angles = angles + 1
                if (type[index] == 62) angles = angles - 1
                if (type[index] == 40) parentheses = parentheses + 1
                if (type[index] == 41) parentheses = parentheses - 1
                parameters = parameters
            }
            index = index + 1
        }
        val rawResult = type.slice(resultBegin, type.size)
        var result = bootstrapNormalizeType(rawResult)
        if (bootstrapIsBorrowResultContract(rawResult)) {
            val source = bootstrapBorrowResultSource(rawResult)
            val sourceIndex = bootstrapDecimalIndex(source)
            if (sourceIndex >= 0) {
                result = bootstrapIndexedBorrowType(
                    sourceIndex,
                    bootstrapBorrowResultElementType(rawResult)
                )
            }
        }
        "function:($parameters)->$result"
    } else "unknown"
}

fun bootstrapStartsBorrowResultContract(type: string): bool =
    type.size >= 7 && type[0] == 98 && type[1] == 111 &&
    type[2] == 114 && type[3] == 114 && type[4] == 111 &&
    type[5] == 119 && type[6] == 40

fun bootstrapIsBorrowResultContract(type: string): bool =
    bootstrapStartsBorrowResultContract(type) &&
    bootstrapFunctionClose(type, 6) > 6

fun bootstrapBorrowResultSource(type: string): string {
    var result = ""
    if (bootstrapStartsBorrowResultContract(type)) {
        val close = bootstrapFunctionClose(type, 6)
        if (close > 6) result = type.slice(7, close)
    }
    result
}

fun bootstrapBorrowResultElementType(type: string): string {
    var result = "unknown"
    if (bootstrapStartsBorrowResultContract(type)) {
        val close = bootstrapFunctionClose(type, 6)
        if (close > 6 && close + 1 < type.size) {
            result = bootstrapNormalizeType(type.slice(close + 1, type.size))
        }
    }
    result
}

fun bootstrapDecimalIndex(text: string): int {
    var result = -1
    var valid = text.size > 0
    var value = 0
    var index = 0
    while (valid && index < text.size) {
        val digit = text[index] - 48
        if (digit < 0 || digit > 9) {
            valid = false
            valid = valid
        } else {
            value = value * 10 + digit
            valid = valid
        }
        index = index + 1
    }
    if (valid) result = value
    result
}

fun bootstrapIndexedBorrowType(source: int, element: string): string =
    "borrow@$source:$element"

fun bootstrapIsIndexedBorrowType(type: string): bool =
    type.size >= 9 && type[0] == 98 && type[1] == 111 &&
    type[2] == 114 && type[3] == 114 && type[4] == 111 &&
    type[5] == 119 && type[6] == 64

fun bootstrapIndexedBorrowSeparator(type: string): int {
    var separator = -1
    var index = 7
    while (separator < 0 && index < type.size) {
        if (type[index] == 58) separator = index
        index = index + 1
    }
    separator
}

fun bootstrapIndexedBorrowSource(type: string): int {
    var source = -1
    if (bootstrapIsIndexedBorrowType(type)) {
        val separator = bootstrapIndexedBorrowSeparator(type)
        if (separator > 7) {
            source = bootstrapDecimalIndex(type.slice(7, separator))
        }
    }
    source
}

fun bootstrapIndexedBorrowElementType(type: string): string {
    var element = "unknown"
    if (bootstrapIsIndexedBorrowType(type)) {
        val separator = bootstrapIndexedBorrowSeparator(type)
        if (separator >= 0 && separator + 1 < type.size) {
            element = type.slice(separator + 1, type.size)
        }
    }
    element
}

fun bootstrapBorrowSourceMatchesContract(
    source: string,
    contract: string
): bool {
    var matches = source == contract
    if (!matches && contract != "" && source.size > contract.size) {
        val separator = source[contract.size]
        if ((separator == 46 || separator == 91) &&
            source.slice(0, contract.size) == contract) matches = true
    }
    matches
}

fun bootstrapBorrowCallResultSource(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    name: string
): string {
    var source = ""
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (owner == "" && declaration.extensionOwner == "" &&
            declaration.name == name && (declaration.kind == "fun" ||
            declaration.kind == "compile.fun")) {
            source = bootstrapBorrowResultSource(declaration.resultType)
        }
        if (owner != "" &&
            bootstrapNormalizeType(declaration.extensionOwner) == owner &&
            declaration.name == name) {
            source = bootstrapBorrowResultSource(declaration.resultType)
        }
        if (owner != "" && declaration.name == owner) {
            var method = 0
            while (method < declaration.methods.size) {
                if (declaration.methods[method].name == name) {
                    source = bootstrapBorrowResultSource(
                        declaration.methods[method].resultType
                    )
                }
                method = method + 1
            }
        }
        declarationIndex = declarationIndex + 1
    }
    source
}

fun bootstrapBorrowCallResultParameter(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    name: string,
    source: string
): int {
    var result = -1
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (owner == "" && declaration.extensionOwner == "" &&
            declaration.name == name && (declaration.kind == "fun" ||
            declaration.kind == "compile.fun")) {
            var parameter = 0
            while (parameter < declaration.parameters.size) {
                if (declaration.parameters[parameter] == source) {
                    result = parameter
                }
                parameter = parameter + 1
            }
        }
        if (owner != "" &&
            bootstrapNormalizeType(declaration.extensionOwner) == owner &&
            declaration.name == name) {
            var parameter = 0
            while (parameter < declaration.parameters.size) {
                if (declaration.parameters[parameter] == source) {
                    result = parameter
                }
                parameter = parameter + 1
            }
        }
        if (owner != "" && declaration.name == owner) {
            var method = 0
            while (method < declaration.methods.size) {
                val found = declaration.methods[method]
                if (found.name == name) {
                    var parameter = 0
                    while (parameter < found.parameters.size) {
                        if (found.parameters[parameter] == source) {
                            result = parameter
                        }
                        parameter = parameter + 1
                    }
                }
                method = method + 1
            }
        }
        declarationIndex = declarationIndex + 1
    }
    result
}

fun bootstrapNormalizeTypeSlow(type: string): string {
    var result = type
    var trimBegin = 0
    var trimEnd = type.size
    while (trimBegin < trimEnd && type[trimBegin] == 32) {
        trimBegin = trimBegin + 1
    }
    while (trimEnd > trimBegin && type[trimEnd - 1] == 32) {
        trimEnd = trimEnd - 1
    }
    if (trimBegin > 0 || trimEnd < type.size) {
        result = bootstrapNormalizeType(type.slice(trimBegin, trimEnd))
    } else {
    if (type == "int") result = "i64"
    if (type.size > 9 && type[0] == 70 && type[1] == 110 &&
        type[2] == 79 && type[3] == 110 && type[4] == 99 &&
        type[5] == 101 && type[6] == 40) {
        result = "once:${bootstrapNormalizeFunctionType(
            type.slice(6, type.size)
        )}"
    }
    if (type.size > 8 && type[0] == 70 && type[1] == 110 &&
        type[2] == 77 && type[3] == 117 && type[4] == 116 &&
        type[5] == 40) {
        result = "mut:${bootstrapNormalizeFunctionType(
            type.slice(5, type.size)
        )}"
    }
    if (type.size > 5 && type[0] == 70 && type[1] == 110 &&
        type[2] == 40) {
        result = bootstrapNormalizeFunctionType(type.slice(2, type.size))
    }
    if (type.size > 3 && type[0] == 40) {
        result = bootstrapNormalizeFunctionType(type)
    }
    if (type.size > 1 && type.slice(type.size - 1, type.size) == "?") {
        result = "nullable:${bootstrapNormalizeType(type.slice(0, type.size - 1))}"
    }
    if (type.size >= 7 && type.slice(0, 6) == "array<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(6, type.size - 1))
        result = "array:$element"
    }
    if (type.size >= 9 && type.slice(0, 7) == "Shared<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(7, type.size - 1))
        result = "shared:$element"
    }
    if (type.size >= 7 && type.slice(0, 5) == "Weak<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(5, type.size - 1))
        result = "weak:$element"
    }
    if (type.size >= 8 && type[0] == 77 && type[1] == 117 &&
        type[2] == 116 && type[3] == 101 && type[4] == 120 &&
        type[5] == 60 && type[type.size - 1] == 62) {
        val element = bootstrapNormalizeType(type.slice(6, type.size - 1))
        result = "mutex:$element"
    }
    if (type.size >= 7 && type.slice(0, 5) == "Cell<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(5, type.size - 1))
        result = "cell:$element"
    }
    if (type.size >= 12 && type.slice(0, 10) == "Generator<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(10, type.size - 1))
        result = "generator:$element"
    }
    if (type.size >= 7 && type.slice(0, 5) == "Task<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(5, type.size - 1))
        result = "task:$element"
    }
    if (type.size >= 9 && type.slice(0, 7) == "Thread<" &&
        type.slice(type.size - 1, type.size) == ">") {
        val element = bootstrapNormalizeType(type.slice(7, type.size - 1))
        result = "thread:$element"
    }
    if (type.size >= 9 && type[0] == 66 && type[1] == 111 &&
        type[2] == 114 && type[3] == 114 && type[4] == 111 &&
        type[5] == 119 && type[6] == 60 &&
        type[type.size - 1] == 62) {
        val element = bootstrapNormalizeType(type.slice(7, type.size - 1))
        result = "borrow:$element"
    }
    if (bootstrapIsBorrowResultContract(type)) {
        result = "borrow:${bootstrapBorrowResultElementType(type)}"
    }
    }
    result
}

noescape extern:"c" fun ablaCompilerTypeNeedsNormalization(
    type: cstring,
    length: i64
): i8

fun bootstrapNormalizeType(type: string): string =
    if (ablaCompilerTypeNeedsNormalization(type, type.size) != 0)
        bootstrapNormalizeTypeSlow(type)
    else type

fun bootstrapIsNullableType(type: string): bool =
    type.size >= 9 && type.slice(0, 9) == "nullable:"

fun bootstrapNullableElementType(type: string): string {
    if (bootstrapIsNullableType(type)) type.slice(9, type.size)
    else "unknown"
}

fun bootstrapNullableRefinementName(
    expression: BootstrapExpression
): string {
    var result = ""
    if ((expression.kind == "==" || expression.kind == "!=") &&
        expression.children.size == 2) {
        val left = expression.children[0]
        val right = expression.children[1]
        if (left.kind == "identifier" && right.kind == "null") {
            result = left.text
        }
        if (right.kind == "identifier" && left.kind == "null") {
            result = right.text
        }
    }
    result
}

fun bootstrapNullableRefinementNonNullWhenTrue(
    expression: BootstrapExpression
): bool = expression.kind == "!="

fun bootstrapRegionResultIsIndependent(type: string): bool {
    val normalized = bootstrapNormalizeType(type)
    normalized == "void" || normalized == "never" || normalized == "null" ||
    normalized == "bool" || normalized == "char" ||
    normalized == "i8" || normalized == "i16" ||
    normalized == "i32" || normalized == "i64" ||
    normalized == "u8" || normalized == "u16" ||
    normalized == "u32" || normalized == "u64" ||
    normalized == "f32" || normalized == "f64"
}

fun bootstrapIsSharedType(type: string): bool =
    type.size >= 7 && type.slice(0, 7) == "shared:"

fun bootstrapSharedElementType(type: string): string {
    if (bootstrapIsSharedType(type)) type.slice(7, type.size)
    else "unknown"
}

fun bootstrapIsWeakType(type: string): bool =
    type.size >= 5 && type.slice(0, 5) == "weak:"

fun bootstrapWeakElementType(type: string): string {
    if (bootstrapIsWeakType(type)) type.slice(5, type.size)
    else "unknown"
}

fun bootstrapIsMutexType(type: string): bool =
    type.size >= 6 && type[0] == 109 && type[1] == 117 &&
    type[2] == 116 && type[3] == 101 && type[4] == 120 &&
    type[5] == 58

fun bootstrapMutexElementType(type: string): string {
    if (bootstrapIsMutexType(type)) type.slice(6, type.size)
    else "unknown"
}

fun bootstrapIsCellType(type: string): bool =
    type.size >= 5 && type.slice(0, 5) == "cell:"

fun bootstrapCellElementType(type: string): string {
    if (bootstrapIsCellType(type)) type.slice(5, type.size)
    else "unknown"
}

fun bootstrapCellElementIsCopy(type: string): bool {
    val normalized = bootstrapNormalizeType(type)
    bootstrapRegionResultIsIndependent(normalized) &&
        normalized != "void" && normalized != "never" &&
        normalized != "null"
}

fun bootstrapIsBorrowType(type: string): bool =
    type.size >= 7 && type.slice(0, 7) == "borrow:"

fun bootstrapBorrowElementType(type: string): string {
    if (bootstrapIsBorrowType(type)) type.slice(7, type.size)
    else type
}

fun bootstrapIsOnceFunctionType(type: string): bool =
    type.size >= 14 && type[0] == 111 && type[1] == 110 &&
    type[2] == 99 && type[3] == 101 && type[4] == 58 &&
    type[5] == 102 && type[6] == 117 && type[7] == 110 &&
    type[8] == 99 && type[9] == 116 && type[10] == 105 &&
    type[11] == 111 && type[12] == 110 && type[13] == 58

fun bootstrapIsMutableFunctionType(type: string): bool =
    type.size >= 13 && type[0] == 109 && type[1] == 117 &&
    type[2] == 116 && type[3] == 58 && type[4] == 102 &&
    type[5] == 117 && type[6] == 110 && type[7] == 99 &&
    type[8] == 116 && type[9] == 105 && type[10] == 111 &&
    type[11] == 110 && type[12] == 58

fun bootstrapFunctionCoreType(type: string): string {
    if (bootstrapIsOnceFunctionType(type)) type.slice(5, type.size)
    else if (bootstrapIsMutableFunctionType(type)) type.slice(4, type.size)
    else type
}

fun bootstrapIsFunctionType(type: string): bool {
    val core = bootstrapFunctionCoreType(type)
    core.size >= 9 && core.slice(0, 9) == "function:"
}

fun bootstrapFunctionRawResultType(type: string): string {
    val core = bootstrapFunctionCoreType(type)
    var result = "unknown"
    if (bootstrapIsFunctionType(core)) {
        if (core.size > 9 && core[9] == 40) {
            val close = bootstrapFunctionClose(core, 9)
            if (close >= 0 && close + 3 <= core.size) {
                result = core.slice(close + 3, core.size)
            } else result = result
        } else result = core.slice(9, core.size)
    }
    result
}

fun bootstrapFunctionResultType(type: string): string {
    val raw = bootstrapFunctionRawResultType(type)
    if (bootstrapIsIndexedBorrowType(raw)) {
        "borrow:${bootstrapIndexedBorrowElementType(raw)}"
    } else raw
}

fun bootstrapFunctionBorrowResultParameter(type: string): int =
    bootstrapIndexedBorrowSource(bootstrapFunctionRawResultType(type))

fun bootstrapFunctionParameterCount(type: string): int {
    val core = bootstrapFunctionCoreType(type)
    var count = -1
    if (bootstrapIsFunctionType(core) && core.size > 10 && core[9] == 40) {
        val close = bootstrapFunctionClose(core, 9)
        count = 0
        if (close > 10) {
            count = 1
            var index = 10
            var angles = 0
            var parentheses = 0
            while (index < close) {
                if (core[index] == 60) angles = angles + 1
                if (core[index] == 62) angles = angles - 1
                if (core[index] == 40) parentheses = parentheses + 1
                if (core[index] == 41) parentheses = parentheses - 1
                if (core[index] == 44 && angles == 0 && parentheses == 0) {
                    count = count + 1
                }
                index = index + 1
            }
        }
    }
    count
}

fun bootstrapFunctionParameterType(type: string, parameter: int): string {
    val core = bootstrapFunctionCoreType(type)
    var result = "unknown"
    if (bootstrapIsFunctionType(core) && core.size > 10 && core[9] == 40) {
        val close = bootstrapFunctionClose(core, 9)
        var current = 0
        var begin = 10
        var index = 10
        var angles = 0
        var parentheses = 0
        while (index <= close) {
            val separator = index == close ||
                (core[index] == 44 && angles == 0 && parentheses == 0)
            if (separator) {
                if (current == parameter && begin < index) {
                    result = core.slice(begin, index)
                    if (result.size > 4 &&
                        (result.slice(0, 4) == "own:" ||
                         result.slice(0, 4) == "var:")) {
                        result = result.slice(4, result.size)
                    }
                }
                current = current + 1
                begin = index + 1
                result = result
            } else {
                if (core[index] == 60) angles = angles + 1
                if (core[index] == 62) angles = angles - 1
                if (core[index] == 40) parentheses = parentheses + 1
                if (core[index] == 41) parentheses = parentheses - 1
                result = result
            }
            index = index + 1
        }
    }
    result
}

fun bootstrapFunctionParameterKind(type: string, parameter: int): string {
    val core = bootstrapFunctionCoreType(type)
    var result = "parameter"
    if (bootstrapIsFunctionType(core) && core.size > 10 && core[9] == 40) {
        val close = bootstrapFunctionClose(core, 9)
        var current = 0
        var begin = 10
        var index = 10
        var angles = 0
        var parentheses = 0
        while (index <= close) {
            val separator = index == close ||
                (core[index] == 44 && angles == 0 && parentheses == 0)
            if (separator) {
                if (current == parameter && begin + 4 < index &&
                    core.slice(begin, begin + 4) == "own:") {
                    result = "own"
                }
                if (current == parameter && begin + 4 < index &&
                    core.slice(begin, begin + 4) == "var:") {
                    result = "var"
                }
                current = current + 1
                begin = index + 1
                bootstrapSemanticUnit()
            } else {
                if (core[index] == 60) angles = angles + 1
                if (core[index] == 62) angles = angles - 1
                if (core[index] == 40) parentheses = parentheses + 1
                if (core[index] == 41) parentheses = parentheses - 1
                bootstrapSemanticUnit()
            }
            index = index + 1
        }
    }
    result
}

fun bootstrapDeclarationFunctionType(
    declaration: BootstrapDeclaration
): string {
    var parameters = ""
    var index = 0
    while (index < declaration.parameterTypes.size) {
        if (index > 0) parameters = "$parameters,"
        if (index < declaration.parameterKinds.size &&
            declaration.parameterKinds[index] == "own") {
            parameters = "${parameters}own:"
        }
        if (index < declaration.parameterKinds.size &&
            declaration.parameterKinds[index] == "var") {
            parameters = "${parameters}var:"
        }
        parameters = "$parameters${bootstrapNormalizeType(
            declaration.parameterTypes[index]
        )}"
        index = index + 1
    }
    var result = bootstrapNormalizeType(declaration.resultType)
    val source = bootstrapBorrowResultSource(declaration.resultType)
    var sourceParameter = -1
    index = 0
    while (index < declaration.parameters.size) {
        if (declaration.parameters[index] == source) sourceParameter = index
        index = index + 1
    }
    if (sourceParameter >= 0) {
        result = bootstrapIndexedBorrowType(
            sourceParameter,
            bootstrapBorrowResultElementType(declaration.resultType)
        )
    }
    "function:($parameters)->$result"
}

fun bootstrapExpressionFunctionReferenceName(
    expression: BootstrapExpression
): string {
    var result = ""
    if (expression.kind == "identifier") result = expression.text
    if (expression.kind == "block" && expression.children.size > 0) {
        result = bootstrapExpressionFunctionReferenceName(
            expression.children[expression.children.size - 1]
        )
    }
    if (expression.kind == "if" && expression.children.size > 2 &&
        expression.children[2].kind != "missing") {
        val thenName = bootstrapExpressionFunctionReferenceName(
            expression.children[1]
        )
        val elseName = bootstrapExpressionFunctionReferenceName(
            expression.children[2]
        )
        if (thenName != "" && thenName == elseName) result = thenName
    }
    result
}

fun bootstrapDeclarationIsValue(kind: string): bool =
    kind == "val" || kind == "var" ||
    kind == "compile.val" || kind == "compile.var"

fun bootstrapGlobalFunctionType(
    declarations: array<BootstrapDeclaration>,
    name: string
): string {
    var result = "unknown"
    var current = name
    var round = 0
    while (result == "unknown" && current != "" &&
           round <= declarations.size) {
        var next = ""
        var index = 0
        while (index < declarations.size) {
            val declaration = declarations[index]
            if (declaration.name == current &&
                declaration.extensionOwner == "" &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun")) {
                result = bootstrapDeclarationFunctionType(declaration)
            }
            if (bootstrapDeclarationIsValue(declaration.kind) &&
                declaration.name == current) {
                next = bootstrapExpressionFunctionReferenceName(
                    declaration.expression
                )
            }
            index = index + 1
        }
        current = next
        round = round + 1
    }
    result
}

fun bootstrapTypesCompatible(expected: string, actual: string): bool {
    var compatible = expected == actual || expected == "unknown" ||
        actual == "unknown" || actual == "never" || expected == "any"
    if (bootstrapIsBorrowType(actual) &&
        expected == bootstrapBorrowElementType(actual)) compatible = true
    // A string passed to a cstring native parameter is adapted at the ABI
    // boundary. The reverse conversion is never implicit because ownership of
    // a returned native pointer is unknown.
    if (expected == "cstring" && actual == "string") compatible = true
    if (expected == "i64" &&
        (actual == "i8" || actual == "u8" || actual == "char" ||
         actual == "i16" || actual == "u16" ||
         actual == "i32" || actual == "u32" || actual == "u64")) {
        compatible = true
    }
    if ((expected == "i8" || expected == "u8" || expected == "char" ||
         expected == "i16" || expected == "u16" ||
         expected == "i32" || expected == "u32") && actual == "i64") {
        compatible = true
    }
    if (bootstrapIsArrayType(expected) && bootstrapIsArrayType(actual)) {
        val expectedElement = bootstrapArrayElementType(expected)
        val actualElement = bootstrapArrayElementType(actual)
        if (expectedElement == "unknown" || actualElement == "unknown") {
            compatible = true
        }
    }
    if (bootstrapIsNullableType(expected)) {
        val element = bootstrapNullableElementType(expected)
        if (actual == "null" || actual == element) compatible = true
        if (bootstrapIsNullableType(actual) &&
            bootstrapNullableElementType(actual) == element) compatible = true
    }
    compatible
}

// Compute the narrowest type that can represent either branch of an
// expression. In particular, `null` joined with `T` is `T?`; treating that
// pair as `void` made otherwise valid nullable expression bodies fail their
// declared result type.
fun bootstrapJoinTypes(left: string, right: string): string {
    var result = "void"
    if (left == "never") result = right
    if (right == "never") result = left
    if (left == right) result = left
    if (left == "unknown") result = right
    if (right == "unknown") result = left
    if (left == "null" && right != "null" && right != "void") {
        if (bootstrapIsNullableType(right)) result = right
        else result = "nullable:$right"
    }
    if (right == "null" && left != "null" && left != "void") {
        if (bootstrapIsNullableType(left)) result = left
        else result = "nullable:$left"
    }
    if (bootstrapIsNullableType(left) &&
        bootstrapNullableElementType(left) == right) result = left
    if (bootstrapIsNullableType(right) &&
        bootstrapNullableElementType(right) == left) result = right
    result
}

fun bootstrapWhenLiteralKey(expression: BootstrapExpression): string {
    var key = ""
    if (expression.kind == "integer" || expression.kind == "true" ||
        expression.kind == "false" || expression.kind == "null" ||
        expression.kind == "string") {
        key = "${expression.kind}:${expression.text}"
    }
    key
}

fun bootstrapExpressionBreaksCurrentLoop(
    expression: BootstrapExpression,
    nestedLoops: int
): bool {
    var breaks = expression.kind == "break" && nestedLoops == 0
    var childLoops = nestedLoops
    if (expression.kind == "while" || expression.kind == "do.while" ||
        expression.kind == "for") childLoops = nestedLoops + 1
    if (expression.kind == "lambda" || expression.kind == "lambda.move") {
        breaks = false
        bootstrapSemanticUnit()
    } else {
        var child = 0
        while (!breaks && child < expression.children.size) {
            breaks = bootstrapExpressionBreaksCurrentLoop(
                expression.children[child],
                childLoops
            )
            child = child + 1
        }
        bootstrapSemanticUnit()
    }
    breaks
}

fun bootstrapExpressionContainsDeferredControl(
    expression: BootstrapExpression
): bool {
    var found = expression.kind == "return" || expression.kind == "break" ||
        expression.kind == "continue"
    if (expression.kind == "lambda" || expression.kind == "lambda.move") {
        found = false
        bootstrapSemanticUnit()
    } else {
        var child = 0
        while (!found && child < expression.children.size) {
            found = bootstrapExpressionContainsDeferredControl(
                expression.children[child]
            )
            child = child + 1
        }
        bootstrapSemanticUnit()
    }
    found
}

fun bootstrapAffineNamesContain(
    names: array<string>,
    name: string
): bool {
    var found = false
    var index = 0
    while (index < names.size) {
        if (names[index] == name) found = true
        index = index + 1
    }
    found
}

fun bootstrapSummaryTypeIsAffineAt(
    type: string,
    names: array<string>,
    depth: int
): bool {
    val normalized = bootstrapNormalizeType(type)
    var affine = bootstrapIsOnceFunctionType(normalized) ||
        bootstrapIsMutableFunctionType(normalized) ||
        bootstrapIsSharedType(normalized) ||
        bootstrapIsWeakType(normalized) ||
        bootstrapIsMutexType(normalized) ||
        bootstrapIsGeneratorType(normalized) ||
        bootstrapIsTaskType(normalized) ||
        bootstrapIsThreadType(normalized) ||
        bootstrapAffineNamesContain(names, normalized)
    if (!affine && depth < 32 && bootstrapIsNullableType(normalized)) {
        affine = bootstrapSummaryTypeIsAffineAt(
            bootstrapNullableElementType(normalized),
            names,
            depth + 1
        )
    }
    if (!affine && depth < 32 && bootstrapIsArrayType(normalized)) {
        affine = bootstrapSummaryTypeIsAffineAt(
            bootstrapArrayElementType(normalized),
            names,
            depth + 1
        )
    }
    affine
}

fun bootstrapSummaryTypeIsAffine(
    type: string,
    names: array<string>
): bool = bootstrapSummaryTypeIsAffineAt(type, names, 0)

fun bootstrapSummaryTypeIsManagedReferenceAt(
    type: string,
    declarations: array<BootstrapDeclaration>,
    depth: int
): bool {
    val normalized = bootstrapNormalizeType(type)
    var managed = bootstrapIsArrayType(normalized) ||
        bootstrapIsCellType(normalized)
    var declaration = 0
    while (!managed && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if ((candidate.kind == "class" || candidate.kind == "interface") &&
            candidate.name == normalized) managed = true
        declaration = declaration + 1
    }
    if (!managed && depth < 32 && bootstrapIsNullableType(normalized)) {
        managed = bootstrapSummaryTypeIsManagedReferenceAt(
            bootstrapNullableElementType(normalized),
            declarations,
            depth + 1
        )
    }
    managed
}

fun bootstrapSummaryTypeIsManagedReference(
    type: string,
    declarations: array<BootstrapDeclaration>
): bool = bootstrapSummaryTypeIsManagedReferenceAt(type, declarations, 0)

// A stable alias must become a source-linked read-only view whenever mutation
// can be observed through nested class fields. `val` remains Kotlin-like (the
// field binding is fixed, not recursively frozen). Root arrays are tracked by
// the same query; arrays stored inside val fields need lifetime propagation
// through stored/returned references before they can safely join this rule.
// Cell is deliberately not expanded: its mutation is explicit, scalar-only
// interior mutability and is legal through shared views.
fun bootstrapSummaryTypeNeedsManagedAliasTrackingAt(
    type: string,
    declarations: array<BootstrapDeclaration>,
    depth: int
): bool {
    var normalized = bootstrapNormalizeType(type)
    var nullableDepth = 0
    while (nullableDepth < 32 && bootstrapIsNullableType(normalized)) {
        normalized = bootstrapNullableElementType(normalized)
        nullableDepth = nullableDepth + 1
    }
    var tracked = depth == 0 && bootstrapIsArrayType(normalized)
    var declaration = 0
    while (!tracked && depth < 32 && declaration < declarations.size) {
        val candidate = declarations[declaration]
        if (candidate.kind == "class" && candidate.name == normalized) {
            var field = 0
            while (!tracked && field < candidate.parameterTypes.size) {
                if (field < candidate.parameterKinds.size &&
                    candidate.parameterKinds[field] == "var") {
                    tracked = true
                } else if (!bootstrapIsArrayType(bootstrapNormalizeType(
                    candidate.parameterTypes[field]
                )) && bootstrapSummaryTypeNeedsManagedAliasTrackingAt(
                        candidate.parameterTypes[field],
                        declarations,
                        depth + 1
                    )) tracked = true
                field = field + 1
            }
        }
        declaration = declaration + 1
    }
    tracked
}

fun bootstrapSummaryTypeNeedsManagedAliasTracking(
    type: string,
    declarations: array<BootstrapDeclaration>
): bool = bootstrapSummaryTypeNeedsManagedAliasTrackingAt(
    type,
    declarations,
    0
)

fun bootstrapBuildAffineTypeNames(
    declarations: array<BootstrapDeclaration>
): array<string> {
    val names: array<string> = []
    var declaration = 0
    while (declaration < declarations.size) {
        val found = declarations[declaration]
        if (found.kind == "class" && found.isResource &&
            !bootstrapAffineNamesContain(names, found.name)) {
            names.append(found.name)
        }
        declaration = declaration + 1
    }
    var changed = true
    var round = 0
    while (changed && round <= declarations.size) {
        changed = false
        declaration = 0
        while (declaration < declarations.size) {
            val found = declarations[declaration]
            if (found.kind == "class" &&
                !bootstrapAffineNamesContain(names, found.name)) {
                var field = 0
                while (field < found.parameterTypes.size &&
                       !bootstrapAffineNamesContain(names, found.name)) {
                    if (field < found.parameterKinds.size &&
                        (found.parameterKinds[field] == "val" ||
                         found.parameterKinds[field] == "var") &&
                        bootstrapSummaryTypeIsAffine(
                            found.parameterTypes[field],
                            names
                        )) {
                        names.append(found.name)
                        changed = true
                    }
                    field = field + 1
                }
            }
            declaration = declaration + 1
        }
        round = round + 1
    }
    names
}

class BootstrapSymbol(
    val name: string,
    val kind: string,
    val type: string,
    val scope: int,
    val borrowSource: string
)

// Compact, pointer-free semantic record retained only for expressions named by
// deferred compiler-extension requests. Declaration handles use the public
// deterministic handle numbering; argument metadata is in source order.
class BootstrapTypedCall(
    val begin: int,
    val end: int,
    val kind: string,
    val name: string,
    val type: string,
    val receiverType: string,
    val target: int,
    val argumentTypes: array<string>,
    val parameterTypes: array<string>,
    val parameterKinds: array<string>,
    val argumentParameters: array<int>,
    val argumentConversions: array<string>,
    val insertedDefaults: int,
    val isCompileOnly: bool,
    val isTrusted: bool
)

class BootstrapSemanticResult(
    val symbols: array<BootstrapSymbol>,
    val errors: int,
    val extensionErrors: int,
    val diagnostics: string,
    val mutableReceivers: BootstrapMutableReceiverSummary,
    val compileEffects: BootstrapCompileEffectSummary,
    val typedCalls: array<BootstrapTypedCall>,
    val managedAliasBegins: array<int>,
    val managedAliasEnds: array<int>,
    val managedAliasSources: array<string>
)

// Compile-time effects are deliberately represented as a compact bitset. The
// complete compiler graph contains thousands of calls, so retaining an object
// per call edge would make hermeticity analysis compete with code generation
// for watchdog memory.
class BootstrapCompileEffectSummary(
    val names: array<string>,
    val methodNames: array<string>,
    val masks: array<int>
)

fun bootstrapCompileEffectHas(mask: int, effect: int): bool =
    mask / effect - (mask / effect / 2) * 2 == 1

fun bootstrapCompileEffectMerge(left: int, right: int): int {
    var merged = left
    var effect = 1
    while (effect <= 512) {
        if (bootstrapCompileEffectHas(right, effect) &&
            !bootstrapCompileEffectHas(merged, effect)) {
            merged = merged + effect
        }
        effect = effect * 2
    }
    merged
}

fun bootstrapTextContains(text: string, needle: string): bool {
    var found = needle.size == 0
    var begin = 0
    while (!found && begin + needle.size <= text.size) {
        var equal = true
        var index = 0
        while (equal && index < needle.size) {
            if (text[begin + index] != needle[index]) equal = false
            index = index + 1
        }
        if (equal) found = true
        begin = begin + 1
    }
    found
}

fun bootstrapCompileBuiltinEffect(name: string): int {
    var effect = 0
    if (bootstrapTextContains(name, "compiler") ||
        bootstrapTextContains(name, "Parser") ||
        bootstrapTextContains(name, "parser") ||
        bootstrapTextContains(name, "Syntax") ||
        bootstrapTextContains(name, "syntax")) effect = 2
    effect
}

fun bootstrapCompileExternalEffect(
    declaration: BootstrapDeclaration
): int {
    val name = declaration.name
    var effect = 0
    if (name == "compilerEnvironment") effect = 16
    else if (name == "compilerWriteFile") effect = 8
    else if (name == "compilerRunProcess") effect = 32
    else if (name == "compilerTcpExchange") effect = 64
    else if (name == "compilerClockMilliseconds") effect = 128
    else if (name == "compilerRandomInteger") effect = 256
    else if (declaration.externalLibrary == "compiler" ||
        declaration.externalLibrary == "parser") effect = 2
    else if (bootstrapTextContains(name, "RuntimeMemory")) effect = 1
    else if (bootstrapTextContains(name, "ReadFile") ||
             bootstrapTextContains(name, "FileKind") ||
             bootstrapTextContains(name, "FileSize") ||
             bootstrapTextContains(name, "ListDirectory") ||
             bootstrapTextContains(name, "CurrentDirectory") ||
             bootstrapTextContains(name, "FileRevision")) effect = 4
    else if (bootstrapTextContains(name, "WriteFile") ||
             bootstrapTextContains(name, "CreateDirector") ||
             bootstrapTextContains(name, "MoveFile") ||
             bootstrapTextContains(name, "RemoveFile")) effect = 8
    else if (bootstrapTextContains(name, "Argument") ||
             bootstrapTextContains(name, "Environment")) effect = 16
    else if (bootstrapTextContains(name, "Sleep") ||
             bootstrapTextContains(name, "Clock") ||
             bootstrapTextContains(name, "Time")) effect = 128
    else if (bootstrapTextContains(name, "Random")) effect = 256
    else if (bootstrapTextContains(name, "Tcp") ||
             bootstrapTextContains(name, "Socket") ||
             bootstrapTextContains(name, "Network") ||
             bootstrapTextContains(name, "Poll")) effect = 64
    else if (bootstrapTextContains(name, "Process") ||
             bootstrapTextContains(name, "Stdin") ||
             bootstrapTextContains(name, "Stdout") ||
             bootstrapTextContains(name, "Stderr")) effect = 32
    else if (declaration.isTrusted || declaration.externalLibrary == "c" ||
             declaration.externalLibrary == "intrinsic" ||
             declaration.externalLibrary == "host") effect = 512
    effect
}

fun bootstrapCompileEffectLookup(
    summary: BootstrapCompileEffectSummary,
    name: string,
    method: bool
): int {
    var mask = bootstrapCompileBuiltinEffect(name)
    var index = 0
    while (index < summary.names.size) {
        val matches = if (method) {
            summary.methodNames[index] == name
        } else summary.names[index] == name
        if (matches) mask = bootstrapCompileEffectMerge(
            mask,
            summary.masks[index]
        )
        index = index + 1
    }
    mask
}

fun bootstrapExpressionCompileEffects(
    expression: BootstrapExpression,
    summary: BootstrapCompileEffectSummary
): int {
    var mask = 0
    if (expression.kind == "call" && expression.text != "move" &&
        expression.text != "Shared" && expression.text != "Mutex" &&
        expression.text != "Cell") {
        mask = bootstrapCompileEffectLookup(
            summary,
            expression.text,
            false
        )
    }
    if (expression.kind == "member.call") {
        mask = bootstrapCompileEffectLookup(
            summary,
            expression.text,
            true
        )
    }
    var child = 0
    while (child < expression.children.size) {
        mask = bootstrapCompileEffectMerge(
            mask,
            bootstrapExpressionCompileEffects(
                expression.children[child],
                summary
            )
        )
        child = child + 1
    }
    mask
}

fun bootstrapBuildCompileEffectSummary(
    declarations: array<BootstrapDeclaration>
): BootstrapCompileEffectSummary {
    val names: array<string> = []
    val methodNames: array<string> = []
    val masks: array<int> = []
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (declaration.kind == "fun" ||
            declaration.kind == "compile.fun" ||
            declaration.kind == "extern") {
            var name = declaration.name
            var methodName = ""
            if (declaration.extensionOwner != "") {
                name = "${declaration.extensionOwner}.${declaration.name}"
                methodName = declaration.name
            }
            names.append(name)
            methodNames.append(methodName)
            var mask = 0
            if (declaration.kind == "extern") {
                mask = bootstrapCompileExternalEffect(declaration)
            }
            masks.append(mask)
        }
        var methodIndex = 0
        while (methodIndex < declaration.methods.size) {
            val method = declaration.methods[methodIndex]
            names.append("${declaration.name}.${method.name}")
            methodNames.append(method.name)
            var mask = 0
            if (method.kind == "extern") {
                mask = bootstrapCompileExternalEffect(method)
            }
            masks.append(mask)
            methodIndex = methodIndex + 1
        }
        declarationIndex = declarationIndex + 1
    }
    val summary = BootstrapCompileEffectSummary(names, methodNames, masks)
    var changed = true
    var round = 0
    while (changed && round <= names.size) {
        changed = false
        var entry = 0
        declarationIndex = 0
        while (declarationIndex < declarations.size) {
            val declaration = declarations[declarationIndex]
            if (declaration.kind == "fun" ||
                declaration.kind == "compile.fun" ||
                declaration.kind == "extern") {
                if (declaration.kind != "extern") {
                    val inferred = bootstrapExpressionCompileEffects(
                        declaration.expression,
                        summary
                    )
                    val merged = bootstrapCompileEffectMerge(
                        masks[entry],
                        inferred
                    )
                    if (merged != masks[entry]) changed = true
                    masks[entry] = merged
                }
                entry = entry + 1
            }
            var methodIndex = 0
            while (methodIndex < declaration.methods.size) {
                val method = declaration.methods[methodIndex]
                if (method.kind != "extern") {
                    val inferred = bootstrapExpressionCompileEffects(
                        method.expression,
                        summary
                    )
                    val merged = bootstrapCompileEffectMerge(
                        masks[entry],
                        inferred
                    )
                    if (merged != masks[entry]) changed = true
                    masks[entry] = merged
                }
                entry = entry + 1
                methodIndex = methodIndex + 1
            }
            declarationIndex = declarationIndex + 1
        }
        round = round + 1
    }
    summary
}

fun bootstrapCompileEffectName(mask: int): string {
    var name = ""
    if (bootstrapCompileEffectHas(mask, 4)) name = "filesystem.read"
    else if (bootstrapCompileEffectHas(mask, 8)) name = "filesystem.write"
    else if (bootstrapCompileEffectHas(mask, 16)) name = "environment"
    else if (bootstrapCompileEffectHas(mask, 32)) name = "process.io"
    else if (bootstrapCompileEffectHas(mask, 64)) name = "network"
    else if (bootstrapCompileEffectHas(mask, 128)) name = "clock"
    else if (bootstrapCompileEffectHas(mask, 256)) name = "random"
    else if (bootstrapCompileEffectHas(mask, 512)) name = "trusted.native"
    name
}

fun bootstrapFirstCompileEffect(mask: int): int {
    var result = 0
    var effect = 4
    while (result == 0 && effect <= 512) {
        if (bootstrapCompileEffectHas(mask, effect)) result = effect
        effect = effect * 2
    }
    result
}

fun bootstrapCompileEffectPath(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    summary: BootstrapCompileEffectSummary,
    effect: int,
    depth: int
): string {
    var path = ""
    if (depth < 32 && expression.kind == "call") {
        var declaration = 0
        while (path == "" && declaration < declarations.size) {
            val candidate = declarations[declaration]
            if (candidate.extensionOwner == "" &&
                candidate.name == expression.text) {
                if (candidate.kind == "extern" &&
                    bootstrapCompileEffectHas(
                        bootstrapCompileExternalEffect(candidate),
                        effect
                    )) path = candidate.name
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun") &&
                    bootstrapCompileEffectHas(
                        bootstrapCompileEffectLookup(
                            summary,
                            candidate.name,
                            false
                        ),
                        effect
                    )) {
                    val nested = bootstrapCompileEffectPath(
                        candidate.expression,
                        declarations,
                        summary,
                        effect,
                        depth + 1
                    )
                    if (nested != "") path = "${candidate.name}->$nested"
                }
            }
            declaration = declaration + 1
        }
    }
    if (depth < 32 && path == "" &&
        expression.kind == "member.call") {
        var declaration = 0
        while (path == "" && declaration < declarations.size) {
            val owner = declarations[declaration]
            var method = 0
            while (path == "" && method < owner.methods.size) {
                val candidate = owner.methods[method]
                if (candidate.name == expression.text &&
                    bootstrapCompileEffectHas(
                        bootstrapCompileEffectLookup(
                            summary,
                            candidate.name,
                            true
                        ),
                        effect
                    )) {
                    val nested = bootstrapCompileEffectPath(
                        candidate.expression,
                        declarations,
                        summary,
                        effect,
                        depth + 1
                    )
                    if (nested != "") {
                        path = "${owner.name}.${candidate.name}->$nested"
                    }
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
    }
    var child = 0
    while (path == "" && child < expression.children.size) {
        path = bootstrapCompileEffectPath(
            expression.children[child],
            declarations,
            summary,
            effect,
            depth
        )
        child = child + 1
    }
    path
}

fun bootstrapCompileEffectFromName(name: string): int {
    var effect = 0
    if (name == "filesystem.read") effect = 4
    else if (name == "filesystem.write") effect = 8
    else if (name == "environment") effect = 16
    else if (name == "process.io") effect = 32
    else if (name == "network") effect = 64
    else if (name == "clock") effect = 128
    else if (name == "random") effect = 256
    else if (name == "trusted.native") effect = 512
    effect
}

fun bootstrapBuildCompileEffectRequests(
    parsed: BootstrapParseResult
): int {
    var requests = 0
    var action = 0
    while (action < parsed.actions.size) {
        val expression = parsed.actions[action]
        if (expression.kind == "compile" &&
            expression.children.size == 1) {
            val call = expression.children[0]
            if (call.kind == "call" && call.text == "compilerGrant" &&
                call.children.size == 1 &&
                call.children[0].kind == "string") {
                requests = bootstrapCompileEffectMerge(
                    requests,
                    bootstrapCompileEffectFromName(call.children[0].text)
                )
            }
        }
        action = action + 1
    }
    requests
}

fun bootstrapBuildCompileEffectAuthorizations(
    parsed: BootstrapParseResult
): int {
    var authorizations = 0
    var action = 0
    while (action < parsed.actions.size) {
        val expression = parsed.actions[action]
        if (expression.kind == "compile.capability.authorization") {
            authorizations = bootstrapCompileEffectMerge(
                authorizations,
                bootstrapCompileEffectFromName(expression.text)
            )
        }
        action = action + 1
    }
    authorizations
}

fun bootstrapBuildCompileEffectGrants(
    requests: int,
    authorizations: int
): int {
    var grants = 0
    var effect = 4
    while (effect <= 512) {
        if (bootstrapCompileEffectHas(requests, effect) &&
            bootstrapCompileEffectHas(authorizations, effect)) {
            grants = grants + effect
        }
        effect = effect * 2
    }
    grants
}

fun bootstrapDeniedCompileEffects(effects: int, grants: int): int {
    var denied = 0
    var effect = 4
    while (effect <= 512) {
        if (bootstrapCompileEffectHas(effects, effect) &&
            !bootstrapCompileEffectHas(grants, effect)) {
            denied = denied + effect
        }
        effect = effect * 2
    }
    denied
}

class BootstrapRegionCallSummary(
    val unsafeNames: array<string>,
    val retainingReceiverNames: array<string>,
    val retainingParameterKeys: array<string>
)

fun bootstrapRegionCallIsUnsafe(
    summary: BootstrapRegionCallSummary,
    name: string
): bool {
    var unsafe = false
    var index = 0
    while (index < summary.unsafeNames.size) {
        if (summary.unsafeNames[index] == name) unsafe = true
        index = index + 1
    }
    unsafe
}

fun bootstrapRegionMemberCallIsUnsafe(
    summary: BootstrapRegionCallSummary,
    name: string
): bool {
    var unsafe = false
    var index = 0
    while (index < summary.unsafeNames.size) {
        val candidate = summary.unsafeNames[index]
        val suffix = ".$name"
        if (candidate.size > suffix.size &&
            candidate.slice(candidate.size - suffix.size, candidate.size) ==
                suffix) unsafe = true
        index = index + 1
    }
    unsafe
}

fun bootstrapRegionReceiverCallIsRetaining(
    summary: BootstrapRegionCallSummary,
    owner: string,
    method: string
): bool = bootstrapAffineNamesContain(
    summary.retainingReceiverNames,
    "$owner.$method"
)

fun bootstrapRegionParameterKey(name: string, parameter: int): string =
    "$name#$parameter"

fun bootstrapRegionParameterIsRetaining(
    summary: BootstrapRegionCallSummary,
    name: string,
    parameter: int
): bool = bootstrapAffineNamesContain(
    summary.retainingParameterKeys,
    bootstrapRegionParameterKey(name, parameter)
)

fun bootstrapRegionMarkRetainingParameter(
    var summary: BootstrapRegionCallSummary,
    name: string,
    parameter: int
): bool {
    val key = bootstrapRegionParameterKey(name, parameter)
    val changed = !bootstrapAffineNamesContain(
        summary.retainingParameterKeys,
        key
    )
    if (changed) summary.retainingParameterKeys.append(key)
    changed
}

fun bootstrapRegionFunctionRetainsAnyParameter(
    summary: BootstrapRegionCallSummary,
    name: string,
    parameterCount: int
): bool {
    var retaining = false
    var parameter = 0
    while (parameter < parameterCount) {
        if (bootstrapRegionParameterIsRetaining(
            summary,
            name,
            parameter
        )) retaining = true
        parameter = parameter + 1
    }
    retaining
}

fun bootstrapRegionParameterIndex(
    parameters: array<string>,
    name: string
): int {
    var result = -1
    var index = 0
    while (index < parameters.size) {
        if (parameters[index] == name) result = index
        index = index + 1
    }
    result
}

fun bootstrapRegionOwnerFieldIsHeap(
    declarations: array<BootstrapDeclaration>,
    owner: string,
    field: string
): bool {
    var heap = false
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (declaration.name == owner) {
            var fieldIndex = 0
            while (fieldIndex < declaration.parameters.size) {
                if (declaration.parameters[fieldIndex] == field &&
                    fieldIndex < declaration.parameterTypes.size &&
                    fieldIndex < declaration.parameterKinds.size &&
                    (declaration.parameterKinds[fieldIndex] == "val" ||
                     declaration.parameterKinds[fieldIndex] == "var")) {
                    heap = !bootstrapRegionResultIsIndependent(
                        bootstrapNormalizeType(
                            declaration.parameterTypes[fieldIndex]
                        )
                    )
                }
                fieldIndex = fieldIndex + 1
            }
        }
        declarationIndex = declarationIndex + 1
    }
    heap
}

fun bootstrapRegionExpressionRetainsParameters(
    expression: BootstrapExpression,
    declarationName: string,
    parameters: array<string>,
    parameterTypes: array<string>,
    declarations: array<BootstrapDeclaration>,
    var summary: BootstrapRegionCallSummary
): bool {
    var changed = false
    if (expression.kind == "member.assign") {
        val root = bootstrapPlaceRootName(expression.children[0])
        val parameter = bootstrapRegionParameterIndex(parameters, root)
        if (parameter >= 0 && parameter < parameterTypes.size &&
            bootstrapRegionOwnerFieldIsHeap(
                declarations,
                bootstrapNormalizeType(parameterTypes[parameter]),
                expression.text
            )) {
            changed = bootstrapRegionMarkRetainingParameter(
                summary,
                declarationName,
                parameter
            ) || changed
        }
    }
    if (expression.kind == "index.assign") {
        val root = bootstrapPlaceRootName(expression.children[0])
        val parameter = bootstrapRegionParameterIndex(parameters, root)
        if (parameter >= 0 && parameter < parameterTypes.size) {
            val type = bootstrapNormalizeType(parameterTypes[parameter])
            if (bootstrapIsArrayType(type) &&
                !bootstrapRegionResultIsIndependent(
                    bootstrapArrayElementType(type)
                )) {
                changed = bootstrapRegionMarkRetainingParameter(
                    summary,
                    declarationName,
                    parameter
                ) || changed
            }
        }
    }
    if (expression.kind == "call") {
        var argument = 0
        while (argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                expression.text,
                argument
            )) {
                val root = bootstrapPlaceRootName(
                    expression.children[argument]
                )
                val parameter = bootstrapRegionParameterIndex(
                    parameters,
                    root
                )
                if (parameter >= 0) {
                    changed = bootstrapRegionMarkRetainingParameter(
                        summary,
                        declarationName,
                        parameter
                    ) || changed
                }
            }
            argument = argument + 1
        }
    }
    if (expression.kind == "member.call") {
        val receiverRoot = bootstrapPlaceRootName(expression.children[0])
        val receiverParameter = bootstrapRegionParameterIndex(
            parameters,
            receiverRoot
        )
        var receiverType = "unknown"
        if (receiverParameter >= 0 &&
            receiverParameter < parameterTypes.size) {
            receiverType = bootstrapNormalizeType(
                parameterTypes[receiverParameter]
            )
            if (expression.text == "append" &&
                bootstrapIsArrayType(receiverType) &&
                !bootstrapRegionResultIsIndependent(
                    bootstrapArrayElementType(receiverType)
                )) {
                changed = bootstrapRegionMarkRetainingParameter(
                    summary,
                    declarationName,
                    receiverParameter
                ) || changed
            }
            if (bootstrapRegionReceiverCallIsRetaining(
                summary,
                receiverType,
                expression.text
            )) {
                changed = bootstrapRegionMarkRetainingParameter(
                    summary,
                    declarationName,
                    receiverParameter
                ) || changed
            }
        }
        val methodName = "$receiverType.${expression.text}"
        var argument = 1
        while (argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                methodName,
                argument - 1
            )) {
                val root = bootstrapPlaceRootName(
                    expression.children[argument]
                )
                val parameter = bootstrapRegionParameterIndex(
                    parameters,
                    root
                )
                if (parameter >= 0) {
                    changed = bootstrapRegionMarkRetainingParameter(
                        summary,
                        declarationName,
                        parameter
                    ) || changed
                }
            }
            argument = argument + 1
        }
    }
    var child = 0
    while (child < expression.children.size) {
        changed = bootstrapRegionExpressionRetainsParameters(
            expression.children[child],
            declarationName,
            parameters,
            parameterTypes,
            declarations,
            summary
        ) || changed
        child = child + 1
    }
    changed
}

fun bootstrapRegionExpressionRetainsReceiver(
    expression: BootstrapExpression,
    owner: string,
    declarations: array<BootstrapDeclaration>,
    summary: BootstrapRegionCallSummary
): bool {
    var retaining = false
    if (expression.kind == "assign" &&
        bootstrapRegionOwnerFieldIsHeap(
            declarations,
            owner,
            expression.text
        )) retaining = true
    if (expression.kind == "member.assign" &&
        bootstrapPlaceRootName(expression.children[0]) == "this" &&
        bootstrapRegionOwnerFieldIsHeap(
            declarations,
            owner,
            expression.text
        )) retaining = true
    if (expression.kind == "index.assign" &&
        bootstrapPlaceRootName(expression.children[0]) == "this") {
        retaining = true
    }
    if (expression.kind == "member.call" &&
        bootstrapPlaceRootName(expression.children[0]) == "this") {
        if (expression.text == "append") retaining = true
        if (bootstrapRegionReceiverCallIsRetaining(
            summary,
            owner,
            expression.text
        )) retaining = true
    }
    if (expression.kind == "call") {
        var argument = 0
        while (!retaining && argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                expression.text,
                argument
            ) && bootstrapPlaceRootName(
                expression.children[argument]
            ) == "this") retaining = true
            argument = argument + 1
        }
    }
    if (expression.kind == "member.call") {
        val receiverRoot = bootstrapPlaceRootName(expression.children[0])
        var receiverType = "unknown"
        if (receiverRoot == "this") receiverType = owner
        val methodName = "$receiverType.${expression.text}"
        var argument = 1
        while (!retaining && argument < expression.children.size) {
            if (bootstrapRegionParameterIsRetaining(
                summary,
                methodName,
                argument - 1
            ) && bootstrapPlaceRootName(
                expression.children[argument]
            ) == "this") retaining = true
            argument = argument + 1
        }
    }
    var child = 0
    while (!retaining && child < expression.children.size) {
        retaining = bootstrapRegionExpressionRetainsReceiver(
            expression.children[child],
            owner,
            declarations,
            summary
        )
        child = child + 1
    }
    retaining
}

fun bootstrapRegionExpressionCallsUnsafe(
    expression: BootstrapExpression,
    summary: BootstrapRegionCallSummary
): bool {
    var unsafe = false
    if (expression.kind == "call" && expression.text != "move" &&
        expression.text != "Shared") {
        unsafe = bootstrapRegionCallIsUnsafe(summary, expression.text)
    }
    if (expression.kind == "member.call" &&
        expression.text != "append" && expression.text != "slice" &&
        expression.text != "clone" && expression.text != "get" &&
        expression.text != "downgrade" &&
        expression.text != "upgrade" &&
        expression.text != "isAlive") {
        unsafe = bootstrapRegionMemberCallIsUnsafe(
            summary,
            expression.text
        )
    }
    var child = 0
    while (!unsafe && child < expression.children.size) {
        unsafe = bootstrapRegionExpressionCallsUnsafe(
            expression.children[child],
            summary
        )
        child = child + 1
    }
    unsafe
}

fun bootstrapRegionExpressionCallsFunctionParameter(
    expression: BootstrapExpression,
    parameters: array<string>,
    parameterTypes: array<string>
): bool {
    var unsafe = false
    if (expression.kind == "call") {
        val parameter = bootstrapRegionParameterIndex(
            parameters,
            expression.text
        )
        if (parameter >= 0 && parameter < parameterTypes.size &&
            bootstrapIsFunctionType(
                bootstrapNormalizeType(parameterTypes[parameter])
            )) unsafe = true
    }
    var child = 0
    while (!unsafe && child < expression.children.size) {
        unsafe = bootstrapRegionExpressionCallsFunctionParameter(
            expression.children[child],
            parameters,
            parameterTypes
        )
        child = child + 1
    }
    unsafe
}

fun bootstrapBuildRegionCallSummary(
    declarations: array<BootstrapDeclaration>
): BootstrapRegionCallSummary {
    val summary = BootstrapRegionCallSummary([], [], [])
    var declarationIndex = 0
    while (declarationIndex < declarations.size) {
        val declaration = declarations[declarationIndex]
        if (declaration.kind == "extern" && !declaration.isNoEscape) {
            summary.unsafeNames.append(declaration.name)
        }
        if (bootstrapRegionExpressionCallsFunctionParameter(
            declaration.expression,
            declaration.parameters,
            declaration.parameterTypes
        )) summary.unsafeNames.append(declaration.name)
        var methodIndex = 0
        while (methodIndex < declaration.methods.size) {
            val method = declaration.methods[methodIndex]
            if (method.kind == "extern" && !method.isNoEscape) {
                summary.unsafeNames.append(
                    "${declaration.name}.${method.name}"
                )
            }
            if (bootstrapRegionExpressionCallsFunctionParameter(
                method.expression,
                method.parameters,
                method.parameterTypes
            )) summary.unsafeNames.append(
                "${declaration.name}.${method.name}"
            )
            methodIndex = methodIndex + 1
        }
        declarationIndex = declarationIndex + 1
    }
    var changed = true
    while (changed) {
        changed = false
        declarationIndex = 0
        while (declarationIndex < declarations.size) {
            val declaration = declarations[declarationIndex]
            if (bootstrapRegionExpressionRetainsParameters(
                declaration.expression,
                declaration.name,
                declaration.parameters,
                declaration.parameterTypes,
                declarations,
                summary
            )) changed = true
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                !bootstrapRegionCallIsUnsafe(summary, declaration.name) &&
                bootstrapRegionExpressionCallsUnsafe(
                    declaration.expression,
                    summary
                )) {
                summary.unsafeNames.append(declaration.name)
                changed = true
            }
            var methodIndex = 0
            while (methodIndex < declaration.methods.size) {
                val method = declaration.methods[methodIndex]
                val name = "${declaration.name}.${method.name}"
                if (bootstrapRegionExpressionRetainsParameters(
                    method.expression,
                    name,
                    method.parameters,
                    method.parameterTypes,
                    declarations,
                    summary
                )) changed = true
                if (!bootstrapAffineNamesContain(
                    summary.retainingReceiverNames,
                    name
                ) && bootstrapRegionExpressionRetainsReceiver(
                    method.expression,
                    declaration.name,
                    declarations,
                    summary
                )) {
                    summary.retainingReceiverNames.append(name)
                    changed = true
                }
                if (!bootstrapRegionCallIsUnsafe(summary, name) &&
                    bootstrapRegionExpressionCallsUnsafe(
                        method.expression,
                        summary
                    )) {
                    summary.unsafeNames.append(name)
                    changed = true
                }
                methodIndex = methodIndex + 1
            }
            declarationIndex = declarationIndex + 1
        }
    }
    summary
}

class BootstrapAnalyzer(
    val symbols: array<BootstrapSymbol>,
    var errors: int,
    var extensionErrors: int,
    var locals: array<BootstrapSymbol>,
    val declarations: array<BootstrapDeclaration>,
    val affineTypes: array<string>,
    val mutableReceivers: BootstrapMutableReceiverSummary,
    val regionCalls: BootstrapRegionCallSummary,
    val compileEffects: BootstrapCompileEffectSummary,
    val compileEffectGrants: int,
    val compileEffectAuthorizations: int,
    val typedRequestBegins: array<int>,
    val typedRequestEnds: array<int>,
    val typedRequestKinds: array<string>,
    val typedCalls: array<BootstrapTypedCall>,
    val managedAliasBegins: array<int>,
    val managedAliasEnds: array<int>,
    val managedAliasSources: array<string>,
    var refinementNames: array<string>,
    var refinementTypes: array<string>,
    var refinementScopes: array<int>,
    var regionOwnedNames: array<string>,
    var regionOwnedScopes: array<int>,
    var diagnostics: string,
    var scopeParents: array<int>,
    var currentScope: int,
    var currentOwner: string,
    var currentResultType: string,
    var currentBorrowResultSource: string,
    var returnedType: string,
    var currentGeneratedNamespace: string,
    var currentGeneratedOriginBegin: int,
    var currentGeneratedOriginEnd: int,
    var loopDepth: int,
    var trustedDepth: int,
    var regionDepth: int,
    var regionScope: int,
    var compileDepth: int,
    var generatorDepth: int,
    var yieldedType: string
) {
    fun fail(code: string) {
        this.errors = this.errors + 1
        if (this.currentGeneratedNamespace != "") {
            this.extensionErrors = this.extensionErrors + 1
            this.diagnostics =
                "${this.diagnostics}error[E_EXT_GENERATED_SEMANTIC]: $code\n"
            this.diagnostics =
                "${this.diagnostics}source[generated-origin]:${this.currentGeneratedNamespace}:${this.currentGeneratedOriginBegin}:${this.currentGeneratedOriginEnd}\n"
        } else this.diagnostics =
            "${this.diagnostics}error[E_SEMANTIC]: $code\n"
        bootstrapSemanticUnit()
    }

    fun scopeIsVisible(scope: int): bool {
        var candidate = this.currentScope
        var visible = scope < 0
        while (candidate >= 0) {
            if (candidate == scope) visible = true
            candidate = this.scopeParents[candidate]
        }
        visible
    }

    fun enterScope(): int {
        val previous = this.currentScope
        this.scopeParents.append(previous)
        this.currentScope = this.scopeParents.size - 1
        previous
    }

    fun leaveScope(previous: int) {
        this.currentScope = previous
    }
    fun findType(name: string): string {
        var result = "unknown"
        var localIndex = 0
        while (localIndex < this.locals.size) {
            if (this.locals[localIndex].name == name &&
                this.scopeIsVisible(this.locals[localIndex].scope)) {
                result = this.locals[localIndex].type
            }
            localIndex = localIndex + 1
        }
        var refinementIndex = 0
        while (refinementIndex < this.refinementNames.size) {
            if (this.refinementNames[refinementIndex] == name &&
                refinementIndex < this.refinementTypes.size &&
                refinementIndex < this.refinementScopes.size &&
                this.scopeIsVisible(
                    this.refinementScopes[refinementIndex]
                )) {
                result = this.refinementTypes[refinementIndex]
            }
            refinementIndex = refinementIndex + 1
        }
        var index = 0
        while (index < this.symbols.size) {
            if (result == "unknown" && this.symbols[index].name == name) {
                result = this.symbols[index].type
            }
            index = index + 1
        }
        if (result == "unknown" && this.currentOwner != "") {
            result = this.fieldType(this.currentOwner, name)
        }
        if (result == "unknown" && name == "github") {
            result = "function:(string)->ImportSource"
        }
        if (result == "unknown" && name == "gitImportSource") {
            result = "function:(string,string,string,string)->ImportSource"
        }
        if (result == "unknown" && name == "importFile") {
            result = "function:(string,string)->ImportFile"
        }
        if (result == "unknown" && name == "resolvedImport") {
            result = "function:(string,string,array:ImportFile)->ResolvedImport"
        }
        if (result == "unknown" && name == "importSource") {
            result = "function:(string,string,string,function:()->ResolvedImport)->ImportSource"
        }
        result
    }

    fun addNullableRefinement(
        expression: BootstrapExpression,
        conditionIsTrue: bool
    ): void {
        val name = bootstrapNullableRefinementName(expression)
        if (name != "" && this.hasVisibleLocal(name) &&
            this.visibleLocalKind(name) != "var") {
            val type = this.findType(name)
            val nonNullWhenTrue =
                bootstrapNullableRefinementNonNullWhenTrue(expression)
            if (bootstrapIsNullableType(type) &&
                conditionIsTrue == nonNullWhenTrue) {
                this.refinementNames.append(name)
                this.refinementTypes.append(
                    bootstrapNullableElementType(type)
                )
                this.refinementScopes.append(this.currentScope)
            }
        }
    }

    fun addNullableRefinements(
        expression: BootstrapExpression,
        conditionIsTrue: bool
    ): void {
        if (expression.kind == "unary!" &&
            expression.children.size == 1) {
            this.addNullableRefinements(
                expression.children[0],
                !conditionIsTrue
            )
        } else if (expression.kind == "&&" && conditionIsTrue &&
                   expression.children.size == 2) {
            this.addNullableRefinements(expression.children[0], true)
            this.addNullableRefinements(expression.children[1], true)
        } else if (expression.kind == "||" && !conditionIsTrue &&
                   expression.children.size == 2) {
            this.addNullableRefinements(expression.children[0], false)
            this.addNullableRefinements(expression.children[1], false)
        } else this.addNullableRefinement(expression, conditionIsTrue)
    }

    fun hasLocal(name: string): bool {
        var found = false
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index].name == name &&
                this.locals[index].scope == this.currentScope) found = true
            index = index + 1
        }
        found
    }

    fun hasVisibleLocal(name: string): bool {
        var found = false
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index].name == name &&
                this.scopeIsVisible(this.locals[index].scope)) found = true
            index = index + 1
        }
        found
    }

    fun visibleLocalKind(name: string): string {
        var result = "unknown"
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index].name == name &&
                this.scopeIsVisible(this.locals[index].scope)) {
                result = this.locals[index].kind
            }
            index = index + 1
        }
        result
    }

    fun visibleBorrowSource(name: string): string {
        var result = ""
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index].name == name &&
                this.scopeIsVisible(this.locals[index].scope)) {
                result = this.locals[index].borrowSource
            }
            index = index + 1
        }
        result
    }

    fun hasMovableLocal(name: string): bool =
        this.hasVisibleLocal(name) &&
        this.visibleLocalKind(name) != "parameter" &&
        this.visibleLocalKind(name) != "mutable.parameter" &&
        !bootstrapIsBorrowType(this.findType(name))

    fun isBorrowedParameter(name: string): bool =
        this.hasVisibleLocal(name) &&
        (this.visibleLocalKind(name) == "parameter" ||
         this.visibleLocalKind(name) == "mutable.parameter")

    fun isMutableBorrowParameter(name: string): bool =
        this.hasVisibleLocal(name) &&
        this.visibleLocalKind(name) == "mutable.parameter"

    fun localIsMutable(name: string): bool {
        var mutable = false
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index].name == name &&
                this.scopeIsVisible(this.locals[index].scope)) {
                mutable = this.locals[index].kind == "var"
            }
            index = index + 1
        }
        mutable
    }

    fun visibleLocalScope(name: string): int {
        var result = -1
        var index = 0
        while (index < this.locals.size) {
            if (this.locals[index].name == name &&
                this.scopeIsVisible(this.locals[index].scope)) {
                result = this.locals[index].scope
            }
            index = index + 1
        }
        result
    }

    fun scopeIsWithin(scope: int, ancestor: int): bool {
        var current = scope
        var result = false
        while (current >= 0) {
            if (current == ancestor) result = true
            current = this.scopeParents[current]
        }
        result
    }

    fun regionNameIsOwned(name: string): bool {
        var owned = false
        var index = 0
        while (index < this.regionOwnedNames.size) {
            if (this.regionOwnedNames[index] == name &&
                index < this.regionOwnedScopes.size &&
                this.scopeIsVisible(this.regionOwnedScopes[index])) {
                owned = true
            }
            index = index + 1
        }
        owned
    }

    fun markRegionOwned(name: string, scope: int): void {
        this.regionOwnedNames.append(name)
        this.regionOwnedScopes.append(scope)
    }

    fun regionExpressionIsOwned(expression: BootstrapExpression): bool {
        var owned = false
        if (this.regionDepth > 0) {
            if (expression.kind == "identifier") {
                owned = this.regionNameIsOwned(expression.text)
            }
            if (expression.kind == "string" ||
                expression.kind == "string.template" ||
                expression.kind == "array" ||
                expression.kind == "lambda" ||
                expression.kind == "lambda.move") owned = true
            if (expression.kind == "call") {
                val moving = expression.text == "move" &&
                    expression.children.size == 1
                val constructing = expression.text == "Shared" ||
                    expression.text == "Cell" ||
                    this.findKind(expression.text) == "class"
                if (moving) {
                    owned = this.regionExpressionIsOwned(
                        expression.children[0]
                    )
                }
                if (constructing) owned = true
                if (!moving && !constructing) {
                    val functionType = this.findType(expression.text)
                    if (bootstrapIsFunctionType(functionType) &&
                        !bootstrapRegionResultIsIndependent(
                            bootstrapFunctionResultType(functionType)
                        )) owned = true
                }
            }
            if (expression.kind == "member") {
                val receiverType = bootstrapBorrowElementType(
                    this.infer(expression.children[0])
                )
                val resultType = this.fieldType(
                    receiverType,
                    expression.text
                )
                owned = !bootstrapRegionResultIsIndependent(resultType) &&
                    this.regionExpressionIsOwned(expression.children[0])
            }
            if (expression.kind == "index") {
                val receiverType = bootstrapBorrowElementType(
                    this.infer(expression.children[0])
                )
                var resultType = "unknown"
                if (receiverType == "string") resultType = "i64"
                if (bootstrapIsArrayType(receiverType)) {
                    resultType = bootstrapArrayElementType(receiverType)
                }
                owned = !bootstrapRegionResultIsIndependent(resultType) &&
                    this.regionExpressionIsOwned(expression.children[0])
            }
            if (expression.kind == "member.call") {
                val receiverType = this.infer(expression.children[0])
                val resultType = if (bootstrapIsSharedType(receiverType) &&
                    expression.text == "get") {
                    bootstrapSharedElementType(receiverType)
                } else this.methodResultType(receiverType, expression.text)
                if (!bootstrapRegionResultIsIndependent(resultType)) {
                    owned = true
                }
            }
            if (expression.kind == "if") {
                owned = this.regionExpressionIsOwned(expression.children[1])
                if (expression.children[2].kind != "missing" &&
                    this.regionExpressionIsOwned(expression.children[2])) {
                    owned = true
                }
            }
            if (expression.kind == "block" &&
                expression.children.size > 0) {
                owned = this.regionExpressionIsOwned(
                    expression.children[expression.children.size - 1]
                )
            }
            if (expression.kind == "compile") {
                owned = this.regionExpressionIsOwned(expression.children[0])
            }
        }
        owned
    }

    fun regionTargetIsOutside(expression: BootstrapExpression): bool {
        val root = bootstrapPlaceRootName(expression)
        var outside = true
        if (root != "" && this.hasVisibleLocal(root)) {
            outside = !this.scopeIsWithin(
                this.visibleLocalScope(root),
                this.regionScope
            )
        }
        outside
    }

    fun validateRegionStore(
        target: BootstrapExpression,
        value: BootstrapExpression,
        context: string
    ): void {
        if (this.regionDepth > 0 &&
            this.regionExpressionIsOwned(value) &&
            this.regionTargetIsOutside(target)) {
            this.fail("region.escape:$context")
        }
    }

    fun hasMutableHeapGlobal(): bool {
        var found = false
        var index = 0
        while (index < this.symbols.size) {
            val symbol = this.symbols[index]
            if ((symbol.kind == "var" || symbol.kind == "val") &&
                !bootstrapRegionResultIsIndependent(symbol.type) &&
                !(symbol.kind == "val" && symbol.type == "string")) {
                found = true
            }
            index = index + 1
        }
        found
    }

    fun findKind(name: string): string {
        var result = "unknown"
        var index = 0
        while (index < this.symbols.size) {
            if (this.symbols[index].name == name) {
                result = this.symbols[index].kind
            }
            index = index + 1
        }
        if (result == "unknown" &&
            (name == "github" || name == "gitImportSource" ||
             name == "importFile" || name == "resolvedImport" ||
             name == "importSource")) {
            result = "compile.fun"
        }
        result
    }

    fun fieldType(owner: string, field: string): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if ((declaration.kind == "class" ||
                 declaration.kind == "interface") &&
                declaration.name == owner) {
                var fieldIndex = 0
                while (fieldIndex < declaration.parameters.size) {
                    if (declaration.parameters[fieldIndex] == field &&
                        fieldIndex < declaration.parameterTypes.size &&
                        fieldIndex < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[fieldIndex] == "val" ||
                         declaration.parameterKinds[fieldIndex] == "var")) {
                        result = bootstrapNormalizeType(
                            declaration.parameterTypes[fieldIndex]
                        )
                    }
                    fieldIndex = fieldIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun fieldIsMutable(owner: string, field: string): bool {
        var result = false
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.name == owner) {
                var fieldIndex = 0
                while (fieldIndex < declaration.parameters.size) {
                    if (declaration.parameters[fieldIndex] == field &&
                        fieldIndex < declaration.parameterKinds.size) {
                        result = declaration.parameterKinds[fieldIndex] == "var"
                    }
                    fieldIndex = fieldIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun typeHasDrop(type: string): bool {
        val normalized = bootstrapNormalizeType(type)
        var found = false
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.kind == "class" &&
                declaration.name == normalized) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    if (declaration.methods[methodIndex].name == "drop") {
                        found = true
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        found
    }

    fun methodResultType(owner: string, method: string): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == method) {
                if (declaration.resultType != "inferred") {
                    result = bootstrapNormalizeType(declaration.resultType)
                }
            }
            if (declaration.name == owner &&
                (declaration.kind == "class" ||
                 declaration.kind == "interface")) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val found = declaration.methods[methodIndex]
                    if (found.name == method) {
                        if (found.resultType != "inferred") {
                            result = bootstrapNormalizeType(found.resultType)
                        }
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun methodParameterCount(owner: string, method: string): int {
        var result = -1
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == method) {
                result = declaration.parameters.size
            }
            if (declaration.name == owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    if (declaration.methods[methodIndex].name == method) {
                        result = declaration.methods[methodIndex].parameters.size
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun methodRequiredParameterCount(owner: string, method: string): int {
        var result = -1
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == method) {
                result = 0
                var extensionParameter = 0
                while (extensionParameter < declaration.parameters.size) {
                    if (extensionParameter >=
                            declaration.parameterDefaults.size ||
                        declaration.parameterDefaults[extensionParameter].kind ==
                            "missing") {
                        result = result + 1
                    }
                    extensionParameter = extensionParameter + 1
                }
            }
            if (declaration.name == owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val found = declaration.methods[methodIndex]
                    if (found.name == method) {
                        result = 0
                        var parameter = 0
                        while (parameter < found.parameters.size) {
                            if (parameter >= found.parameterDefaults.size ||
                                found.parameterDefaults[parameter].kind ==
                                    "missing") {
                                result = result + 1
                            }
                            parameter = parameter + 1
                        }
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun methodParameterType(
        owner: string,
        method: string,
        parameter: int
    ): string {
        var result = "unknown"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == method &&
                parameter < declaration.parameterTypes.size) {
                result = bootstrapNormalizeType(
                    declaration.parameterTypes[parameter]
                )
            }
            if (declaration.name == owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val found = declaration.methods[methodIndex]
                    if (found.name == method &&
                        parameter < found.parameterTypes.size) {
                        result = bootstrapNormalizeType(
                            found.parameterTypes[parameter]
                        )
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun methodParameterKind(
        owner: string,
        method: string,
        parameter: int
    ): string {
        var result = "parameter"
        var declarationIndex = 0
        while (declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (bootstrapNormalizeType(declaration.extensionOwner) == owner &&
                declaration.name == method &&
                parameter < declaration.parameterKinds.size) {
                result = declaration.parameterKinds[parameter]
            }
            if (declaration.name == owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val found = declaration.methods[methodIndex]
                    if (found.name == method &&
                        parameter < found.parameterKinds.size) {
                        result = found.parameterKinds[parameter]
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        result
    }

    fun functionParameterCount(name: string): int {
        var result = -1
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "extern" ||
                 declaration.kind == "compile.fun") &&
                declaration.name == name) {
                result = declaration.parameters.size
            }
            index = index + 1
        }
        result
    }

    fun functionRequiresTrust(name: string): bool {
        var requiresTrust = false
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if (declaration.name == name && declaration.kind == "extern" &&
                declaration.isTrusted) {
                requiresTrust = true
            }
            index = index + 1
        }
        requiresTrust
    }

    fun typeIsAffine(type: string): bool =
        bootstrapSummaryTypeIsAffine(type, this.affineTypes)

    fun typeIsManagedReference(type: string): bool {
        bootstrapSummaryTypeIsManagedReference(type, this.declarations)
    }

    fun typeNeedsManagedAliasTracking(type: string): bool {
        bootstrapSummaryTypeNeedsManagedAliasTracking(
            type,
            this.declarations
        )
    }

    fun typeIsBorrowTracked(type: string): bool {
        this.typeIsAffine(type) || this.typeIsManagedReference(type)
    }

    fun methodReceiverKind(owner: string, method: string): string {
        if (bootstrapMutableReceiverContains(
                this.mutableReceivers,
                owner,
                method
        )) "var" else "parameter"
    }

    fun constructorStoredBorrowSource(
        expression: BootstrapExpression
    ): string {
        var source = ""
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (candidate.kind == "class" &&
                !candidate.isResource &&
                candidate.name == expression.text) {
                var mutableContainer = false
                var field = 0
                while (!mutableContainer &&
                       field < candidate.parameterKinds.size) {
                    if (candidate.parameterKinds[field] == "var") {
                        mutableContainer = true
                    }
                    field = field + 1
                }
                var parameter = 0
                while (!mutableContainer &&
                       parameter < candidate.parameterTypes.size &&
                       parameter < expression.children.size) {
                    val expected = bootstrapNormalizeType(
                        candidate.parameterTypes[parameter]
                    )
                    if (!this.typeIsAffine(expected) &&
                        !bootstrapIsArrayType(expected) &&
                        this.typeNeedsManagedAliasTracking(expected) &&
                        !this.expressionProducesFreshManagedReference(
                            expression.children[parameter],
                            0,
                            false
                        )) {
                        var found = this.borrowArgumentSource(
                            expression.children[parameter]
                        )
                        if (found == "") found = "managed.unknown"
                        if (source == "") source = found
                        else if (source != found) source = "managed.multiple"
                    }
                    parameter = parameter + 1
                }
            }
            declaration = declaration + 1
        }
        source
    }

    fun expressionProducesFreshManagedReference(
        expression: BootstrapExpression,
        depth: int,
        allowVisibleLocals: bool
    ): bool {
        var fresh = expression.kind == "array" ||
            expression.kind == "lambda" ||
            expression.kind == "lambda.move"
        if (!fresh && allowVisibleLocals &&
            expression.kind == "identifier" &&
            this.hasVisibleLocal(expression.text)) {
            var local = this.locals.size - 1
            while (!fresh && local >= 0) {
                val candidate = this.locals[local]
                if (candidate.name == expression.text &&
                    this.scopeIsVisible(candidate.scope) &&
                    candidate.borrowSource == "managed.fresh") fresh = true
                local = local - 1
            }
        }
        if (!fresh && expression.kind == "call" &&
            this.findKind(expression.text) == "class") {
            fresh = this.constructorStoredBorrowSource(expression) == ""
        }
        if (!fresh && expression.kind == "block" &&
            expression.children.size > 0) {
            val tail = expression.children[expression.children.size - 1]
            fresh = this.expressionProducesFreshManagedReference(
                tail, depth, allowVisibleLocals
            )
            if (!fresh && tail.kind == "identifier") {
                var statement = expression.children.size - 1
                while (!fresh && statement > 0) {
                    statement = statement - 1
                    val candidate = expression.children[statement]
                    if (candidate.kind == "local.val" &&
                        candidate.text == tail.text &&
                        candidate.children.size > 0) {
                        fresh = this.expressionProducesFreshManagedReference(
                            candidate.children[0], depth, false
                        )
                    }
                }
            }
        }
        if (!fresh && expression.kind == "if" &&
            expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            fresh = this.expressionProducesFreshManagedReference(
                expression.children[1],
                depth,
                allowVisibleLocals
            ) && this.expressionProducesFreshManagedReference(
                expression.children[2],
                depth,
                allowVisibleLocals
            )
        }
        if (!fresh && expression.kind == "when") {
            var branch = 2
            var allFresh = branch < expression.children.size
            while (allFresh && branch < expression.children.size) {
                allFresh = this.expressionProducesFreshManagedReference(
                    expression.children[branch],
                    depth,
                    allowVisibleLocals
                )
                branch = branch + 2
            }
            fresh = allFresh
        }
        if (!fresh &&
            (expression.kind == "compile" || expression.kind == "region") &&
            expression.children.size > 0) {
            fresh = this.expressionProducesFreshManagedReference(
                expression.children[0], depth, allowVisibleLocals
            )
        }
        if (!fresh && expression.kind == "call" && depth < 32) {
            var declaration = 0
            while (!fresh && declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun") &&
                    candidate.extensionOwner == "" &&
                    candidate.name == expression.text) {
                    fresh = this.expressionProducesFreshManagedReference(
                        candidate.expression,
                        depth + 1,
                        false
                    )
                }
                declaration = declaration + 1
            }
        }
        fresh
    }

    fun ownershipExpressionType(expression: BootstrapExpression): string {
        var result = "unknown"
        if (expression.kind == "identifier") {
            result = this.findType(expression.text)
        }
        if (expression.kind == "call") {
            if (this.findKind(expression.text) == "class") {
                result = expression.text
            } else {
                result = bootstrapFunctionResultType(
                    this.findType(expression.text)
                )
            }
        }
        if (expression.kind == "member" &&
            expression.children.size > 0) {
            val owner = bootstrapBorrowElementType(
                this.ownershipExpressionType(expression.children[0])
            )
            result = this.fieldType(owner, expression.text)
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            val owner = bootstrapBorrowElementType(
                this.ownershipExpressionType(expression.children[0])
            )
            result = this.methodResultType(owner, expression.text)
        }
        bootstrapNormalizeType(result)
    }

    fun memberCallProducesFreshManagedReference(
        expression: BootstrapExpression,
        expected: string
    ): bool {
        var fresh = false
        var owner = "unknown"
        if (expression.children.size > 0) {
            owner = bootstrapBorrowElementType(
                this.ownershipExpressionType(expression.children[0])
            )
        }
        var declaration = 0
        while (!fresh && declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (candidate.extensionOwner != "" &&
                bootstrapNormalizeType(candidate.extensionOwner) == owner &&
                candidate.name == expression.text &&
                bootstrapTypesCompatible(
                    expected,
                    bootstrapNormalizeType(candidate.resultType)
                )) {
                fresh = this.expressionProducesFreshManagedReference(
                    candidate.expression,
                    0,
                    false
                )
                if (!fresh && this.expressionReturnsReceiver(
                        candidate.expression
                    )) {
                    val receiver = expression.children[0]
                    fresh = this.expressionProducesFreshManagedReference(
                        receiver,
                        0,
                        true
                    )
                    if (!fresh && receiver.kind == "member.call") {
                        fresh = this.memberCallProducesFreshManagedReference(
                            receiver,
                            owner
                        )
                    }
                }
            }
            var method = 0
            while (!fresh && candidate.name == owner &&
                   method < candidate.methods.size) {
                val found = candidate.methods[method]
                if (found.name == expression.text &&
                    bootstrapTypesCompatible(
                        expected,
                        bootstrapNormalizeType(found.resultType)
                    )) {
                    fresh = this.expressionProducesFreshManagedReference(
                        found.expression,
                        0,
                        false
                    )
                    if (!fresh && this.expressionReturnsReceiver(
                            found.expression
                        )) {
                        val receiver = expression.children[0]
                        fresh = this.expressionProducesFreshManagedReference(
                            receiver,
                            0,
                            true
                        )
                        if (!fresh && receiver.kind == "member.call") {
                            fresh = this.memberCallProducesFreshManagedReference(
                                receiver,
                                owner
                            )
                        }
                    }
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
        fresh
    }

    fun expressionReturnsReceiver(
        expression: BootstrapExpression
    ): bool {
        var returnsReceiver = expression.kind == "identifier" &&
            expression.text == "this"
        if (!returnsReceiver && expression.kind == "return" &&
            expression.children.size > 0) {
            returnsReceiver = this.expressionReturnsReceiver(
                expression.children[0]
            )
        }
        if (!returnsReceiver && expression.kind == "block" &&
            expression.children.size > 0) {
            returnsReceiver = this.expressionReturnsReceiver(
                expression.children[expression.children.size - 1]
            )
        }
        if (!returnsReceiver && expression.kind == "if" &&
            expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            returnsReceiver = this.expressionReturnsReceiver(
                expression.children[1]
            ) && this.expressionReturnsReceiver(expression.children[2])
        }
        returnsReceiver
    }

    fun validateMutableBorrowArgument(
        expression: BootstrapExpression,
        expected: string,
        context: string
    ): void {
        val kinds: array<int> = []
        val values: array<string> = []
        bootstrapCollectOwnershipPlace(expression, kinds, values)
        var valid = values.size > 0 && expression.kind != "call"
        if (values.size > 0 && this.hasVisibleLocal(values[0])) {
            val rootKind = this.visibleLocalKind(values[0])
            if (rootKind == "parameter") valid = false
            if (bootstrapIsBorrowType(this.findType(values[0]))) valid = false
        } else if (values.size > 0) valid = false
        if (!valid && expression.kind == "array") valid = true
        if (!valid && expression.kind == "lambda") valid = true
        if (!valid && expression.kind == "call" &&
            this.findKind(expression.text) == "class") valid = true
        if (!valid && expression.kind == "call" &&
            this.expressionProducesFreshManagedReference(
                expression,
                0,
                true
            )) {
            valid = true
        }
        if (!valid && expression.kind == "member.call" &&
            this.memberCallProducesFreshManagedReference(
                expression,
                expected
            )) valid = true
        if (!this.typeIsBorrowTracked(expected)) valid = false
        if (!valid) this.fail("ownership.mutable-borrow:$context")
    }

    fun validateBorrowMutation(
        receiver: BootstrapExpression,
        context: string
    ): void {
        val root = bootstrapPlaceRootName(receiver)
        if (root != "" && this.hasVisibleLocal(root) &&
            this.visibleLocalKind(root) == "parameter" &&
            this.typeIsBorrowTracked(this.findType(root))) {
            this.fail("ownership.borrow-mutation:$context:$root")
        }
    }

    fun validateOwnershipTransfer(
        expected: string,
        expression: BootstrapExpression,
        context: string
    ): void {
        if (this.typeIsAffine(expected)) {
            val returning = context == "return" ||
                (context.size >= 9 && context.slice(0, 9) == "function.") ||
                (context.size >= 7 && context.slice(0, 7) == "method.")
            if (expression.kind == "identifier" &&
                this.hasMovableLocal(expression.text) && !returning) {
                this.fail(
                    "ownership.move-required:$context:${expression.text}"
                )
            }
            if (expression.kind == "identifier" &&
                this.isBorrowedParameter(expression.text)) {
                this.fail(
                    "ownership.borrow-escape:$context:${expression.text}"
                )
            }
            if (expression.kind == "member" ||
                expression.kind == "index") {
                this.fail("ownership.place-move-required:$context")
            }
            if (expression.kind == "if") {
                this.validateOwnershipTransfer(
                    expected,
                    expression.children[1],
                    context
                )
                if (expression.children[2].kind != "missing") {
                    this.validateOwnershipTransfer(
                        expected,
                        expression.children[2],
                        context
                    )
                }
            }
            if (expression.kind == "block" && expression.children.size > 0) {
                this.validateOwnershipTransfer(
                    expected,
                    expression.children[expression.children.size - 1],
                    context
                )
            }
            if (bootstrapIsArrayType(bootstrapNormalizeType(expected)) &&
                expression.kind == "array") {
                val elementType = bootstrapArrayElementType(
                    bootstrapNormalizeType(expected)
                )
                var element = 0
                while (element < expression.children.size) {
                    this.validateOwnershipTransfer(
                        elementType,
                        expression.children[element],
                        context
                    )
                    element = element + 1
                }
            }
        }
    }

    fun functionRequiredParameterCount(name: string): int {
        var result = -1
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "extern" ||
                 declaration.kind == "compile.fun") &&
                declaration.name == name) {
                result = 0
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter >= declaration.parameterDefaults.size ||
                        declaration.parameterDefaults[parameter].kind ==
                            "missing") {
                        result = result + 1
                    }
                    parameter = parameter + 1
                }
            }
            index = index + 1
        }
        result
    }

    fun functionParameterType(name: string, parameter: int): string {
        var result = "unknown"
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "extern" ||
                 declaration.kind == "compile.fun") &&
                declaration.name == name &&
                parameter < declaration.parameterTypes.size) {
                result = bootstrapNormalizeType(
                    declaration.parameterTypes[parameter]
                )
            }
            index = index + 1
        }
        result
    }

    fun functionParameterKind(name: string, parameter: int): string {
        var result = "parameter"
        var index = 0
        while (index < this.declarations.size) {
            val declaration = this.declarations[index]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "extern" ||
                 declaration.kind == "compile.fun") &&
                declaration.name == name &&
                parameter < declaration.parameterKinds.size) {
                result = declaration.parameterKinds[parameter]
            }
            index = index + 1
        }
        result
    }

    fun typedRequestIndex(expression: BootstrapExpression): int {
        var matched = -1
        var request = 0
        while (matched < 0 && request < this.typedRequestBegins.size &&
               request < this.typedRequestEnds.size &&
               request < this.typedRequestKinds.size) {
            var same = this.typedRequestBegins[request] == expression.begin &&
                this.typedRequestEnds[request] == expression.end &&
                this.typedRequestKinds[request] == expression.kind
            if (!same && expression.begin < 0 &&
                this.typedRequestKinds[request] == expression.kind &&
                expression.children.size > 0) {
                same = true
                var child = 0
                while (same && child < expression.children.size) {
                    val candidate = expression.children[child]
                    if (candidate.begin < this.typedRequestBegins[request] ||
                        candidate.end > this.typedRequestEnds[request]) {
                        same = false
                    }
                    child = child + 1
                }
            }
            if (same) matched = request
            request = request + 1
        }
        matched
    }

    fun topLevelFunctionHandle(name: string): int {
        var handle = -1
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if ((candidate.kind == "fun" || candidate.kind == "extern" ||
                 candidate.kind == "compile.fun") &&
                candidate.name == name) handle = declaration
            declaration = declaration + 1
        }
        handle
    }

    fun inherentMethodHandle(owner: int, method: int): int {
        var handle = this.declarations.size
        var declaration = 0
        while (declaration < owner) {
            handle = handle + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        handle + method
    }

    fun selectedMethodHandle(owner: string, name: string): int {
        var handle = -1
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (bootstrapNormalizeType(candidate.extensionOwner) == owner &&
                candidate.name == name) handle = declaration
            if (candidate.name == owner) {
                var method = 0
                while (method < candidate.methods.size) {
                    if (candidate.methods[method].name == name) {
                        handle = this.inherentMethodHandle(declaration, method)
                    }
                    method = method + 1
                }
            }
            declaration = declaration + 1
        }
        handle
    }

    fun selectedHandleIsCompileOnly(handle: int): bool {
        var result = false
        if (handle >= 0 && handle < this.declarations.size) {
            result = this.declarations[handle].kind == "compile.fun"
        }
        if (handle >= this.declarations.size) {
            var cursor = this.declarations.size
            var owner = 0
            while (owner < this.declarations.size) {
                val next = cursor + this.declarations[owner].methods.size
                if (handle >= cursor && handle < next) {
                    result = this.declarations[owner].methods[handle - cursor].kind == "compile.fun"
                }
                cursor = next
                owner = owner + 1
            }
        }
        result
    }

    fun selectedHandleIsTrusted(handle: int): bool {
        var result = false
        if (handle >= 0 && handle < this.declarations.size) {
            result = this.declarations[handle].isTrusted
        }
        if (handle >= this.declarations.size) {
            var cursor = this.declarations.size
            var owner = 0
            while (owner < this.declarations.size) {
                val next = cursor + this.declarations[owner].methods.size
                if (handle >= cursor && handle < next) {
                    result = this.declarations[owner].methods[handle - cursor].isTrusted
                }
                cursor = next
                owner = owner + 1
            }
        }
        result
    }

    fun typedArgumentConversion(expected: string, actual: string): string {
        var result = "none"
        if (expected == "cstring" && actual == "string") {
            result = "string.to-cstring"
        } else if (bootstrapIsBorrowType(actual) &&
                   expected == bootstrapBorrowElementType(actual)) {
            result = "borrow.read"
        } else if (bootstrapIsNullableType(expected) &&
                   !bootstrapIsNullableType(actual)) {
            result = "nullable.inject"
        } else if (expected == "i64" && actual != "i64") {
            result = "integer.widen"
        } else if (expected != "i64" && actual == "i64" &&
                   (expected == "i8" || expected == "u8" ||
                    expected == "char" || expected == "i16" ||
                    expected == "u16" || expected == "i32" ||
                    expected == "u32")) {
            result = "integer.narrow"
        }
        result
    }

    fun recordTypedCall(
        expression: BootstrapExpression,
        resultType: string,
        receiverType: string,
        target: int,
        argumentTypes: array<string>,
        parameterTypes: array<string>,
        parameterKinds: array<string>,
        insertedDefaults: int
    ): void {
        val request = this.typedRequestIndex(expression)
        var already = false
        var existing = 0
        while (existing < this.typedCalls.size) {
            val candidate = this.typedCalls[existing]
            if (request >= 0 &&
                candidate.begin == this.typedRequestBegins[request] &&
                candidate.end == this.typedRequestEnds[request] &&
                candidate.kind == expression.kind &&
                candidate.name == expression.text) already = true
            existing = existing + 1
        }
        if (!already && request >= 0 && target >= 0) {
            val bindings: array<int> = []
            val conversions: array<string> = []
            var argument = 0
            while (argument < argumentTypes.size &&
                   argument < parameterTypes.size) {
                bindings.append(argument)
                conversions.append(this.typedArgumentConversion(
                    parameterTypes[argument], argumentTypes[argument]
                ))
                argument = argument + 1
            }
            this.typedCalls.append(BootstrapTypedCall(
                this.typedRequestBegins[request],
                this.typedRequestEnds[request],
                expression.kind,
                expression.text,
                bootstrapNormalizeType(resultType),
                bootstrapNormalizeType(receiverType),
                target,
                argumentTypes,
                parameterTypes,
                parameterKinds,
                bindings,
                conversions,
                insertedDefaults,
                this.selectedHandleIsCompileOnly(target),
                this.selectedHandleIsTrusted(target)
            ))
        }
    }

    fun validateCallAliases(
        arguments: array<BootstrapExpression>,
        kinds: array<string>,
        types: array<string>,
        context: string
    ): void {
        var exclusive = 0
        while (exclusive < arguments.size && exclusive < kinds.size &&
               exclusive < types.size) {
            val owning = kinds[exclusive] == "own" &&
                this.typeIsAffine(types[exclusive])
            val mutable = kinds[exclusive] == "var" &&
                this.typeIsBorrowTracked(types[exclusive])
            if (owning || mutable) {
                var borrowed = 0
                while (borrowed < arguments.size &&
                       borrowed < kinds.size && borrowed < types.size) {
                    val tracked = if (owning) {
                        this.typeIsAffine(types[borrowed])
                    } else this.typeIsBorrowTracked(types[borrowed])
                    var aliases = borrowed != exclusive && tracked &&
                        bootstrapOwnershipPlacesConflict(
                            arguments[exclusive],
                            arguments[borrowed]
                        )
                    if (borrowed != exclusive && tracked) {
                        val borrowSource = this.borrowExpressionSource(
                            arguments[borrowed]
                        )
                        val exclusivePlace = bootstrapOwnershipPlaceKey(
                            arguments[exclusive]
                        )
                        if (bootstrapOwnershipPlaceKeysConflict(
                            borrowSource,
                            exclusivePlace
                        )) aliases = true
                    }
                    if (aliases) {
                        if (owning) {
                            this.fail("ownership.borrow-own-alias:$context")
                        } else {
                            this.fail("ownership.mutable-alias:$context")
                        }
                    }
                    borrowed = borrowed + 1
                }
            }
            exclusive = exclusive + 1
        }
    }

    fun hasSymbol(name: string): bool = this.findType(name) != "unknown"

    fun appendUniqueCaptureName(var names: array<string>, name: string) {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        if (!found) names.append(name)
    }

    fun collectLambdaLocalNames(
        expression: BootstrapExpression,
        var names: array<string>
    ): void {
        if (expression.kind == "local.val" ||
            expression.kind == "local.var") {
            this.appendUniqueCaptureName(names, expression.text)
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move" &&
            expression.kind != "lambda.generator") {
            var child = 0
            while (child < expression.children.size) {
                this.collectLambdaLocalNames(expression.children[child], names)
                child = child + 1
            }
        }
    }

    fun captureNameIsBound(names: array<string>, name: string): bool {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun collectLambdaCaptureNames(
        expression: BootstrapExpression,
        bound: array<string>,
        var captures: array<string>
    ): void {
        var nested = false
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            nested = true
            val nestedBound: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nestedBound.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                this.appendUniqueCaptureName(
                    nestedBound,
                    expression.children[parameter].text
                )
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaLocalNames(body, nestedBound)
            this.collectLambdaCaptureNames(body, nestedBound, captures)
        }
        if (!nested) {
            if (expression.kind == "identifier" &&
                !this.captureNameIsBound(bound, expression.text)) {
                this.appendUniqueCaptureName(captures, expression.text)
            }
            if ((expression.kind == "call" || expression.kind == "assign") &&
                !this.captureNameIsBound(bound, expression.text)) {
                this.appendUniqueCaptureName(captures, expression.text)
            }
            var child = 0
            while (child < expression.children.size) {
                this.collectLambdaCaptureNames(
                    expression.children[child],
                    bound,
                    captures
                )
                child = child + 1
            }
        }
    }

    fun lambdaMutatesCapturedPlace(
        expression: BootstrapExpression,
        bound: array<string>
    ): bool {
        var mutates = false
        if (expression.kind == "assign" &&
            !this.captureNameIsBound(bound, expression.text) &&
            (this.hasVisibleLocal(expression.text) ||
             (this.currentOwner != "" && this.fieldType(
                this.currentOwner,
                expression.text
             ) != "unknown"))) mutates = true
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.captureNameIsBound(bound, root) &&
                (this.hasVisibleLocal(root) || root == "this")) {
                mutates = true
            }
        }
        if (expression.kind == "call" &&
            !this.captureNameIsBound(bound, expression.text) &&
            this.hasVisibleLocal(expression.text) &&
            bootstrapIsMutableFunctionType(
                this.findType(expression.text)
            )) mutates = true
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.captureNameIsBound(bound, root) &&
                this.hasVisibleLocal(root) &&
                bootstrapMutableReceiverContains(
                    this.mutableReceivers,
                    bootstrapBorrowElementType(this.findType(root)),
                    expression.text
                )) mutates = true
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (!mutates && child < expression.children.size) {
                mutates = this.lambdaMutatesCapturedPlace(
                    expression.children[child],
                    bound
                )
                child = child + 1
            }
        }
        mutates
    }

    fun lambdaRequiresMutableCall(
        expression: BootstrapExpression
    ): bool {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        this.collectLambdaLocalNames(body, bound)
        this.lambdaMutatesCapturedPlace(body, bound)
    }

    fun validateLambdaCaptures(expression: BootstrapExpression): void {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        this.collectLambdaLocalNames(body, bound)
        val captures: array<string> = []
        this.collectLambdaCaptureNames(body, bound, captures)
        var capture = 0
        while (capture < captures.size) {
            var name = captures[capture]
            if (!this.hasVisibleLocal(name) && this.currentOwner != "" &&
                this.fieldType(this.currentOwner, name) != "unknown") {
                name = "this"
            }
            if (this.hasVisibleLocal(name) &&
                this.typeIsAffine(this.findType(name))) {
                if (expression.kind != "lambda.move" &&
                    expression.kind != "lambda.generator") {
                    this.fail("ownership.capture-move-required:$name")
                }
                if ((expression.kind == "lambda.move" ||
                     expression.kind == "lambda.generator") &&
                    !this.hasMovableLocal(name)) {
                    this.fail("ownership.borrow-capture:$name")
                }
            }
            if (this.hasVisibleLocal(name) &&
                bootstrapIsBorrowType(this.findType(name))) {
                this.fail("ownership.borrow-capture:$name")
            }
            capture = capture + 1
        }
    }

    fun threadCaptureTypeIsSend(type: string): bool {
        val normalized = bootstrapNormalizeType(type)
        bootstrapIsSharedType(normalized) ||
            bootstrapIsMutexType(normalized) ||
            bootstrapIsWeakType(normalized)
    }

    fun validateThreadCaptures(body: BootstrapExpression): void {
        val bound: array<string> = []
        this.collectLambdaLocalNames(body, bound)
        if (this.lambdaMutatesCapturedPlace(body, bound)) {
            this.fail("thread.capture-mutation")
        }
        val captures: array<string> = []
        this.collectLambdaCaptureNames(body, bound, captures)
        var capture = 0
        while (capture < captures.size) {
            val name = captures[capture]
            if (this.hasVisibleLocal(name) &&
                !this.threadCaptureTypeIsSend(this.findType(name))) {
                this.fail(
                    "thread.capture-type:$name:${this.findType(name)}"
                )
            }
            capture = capture + 1
        }
        if (this.threadUsesMutableGlobal(body)) {
            this.fail("thread.mutable-global")
        }
    }

    fun threadUsesMutableGlobal(expression: BootstrapExpression): bool {
        var found = false
        if ((expression.kind == "identifier" ||
             expression.kind == "assign") &&
            this.findKind(expression.text) == "var") found = true
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && this.findKind(root) == "var") found = true
        }
        if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (!found && child < expression.children.size) {
                found = this.threadUsesMutableGlobal(
                    expression.children[child]
                )
                child = child + 1
            }
        }
        found
    }

    fun borrowArgumentSource(expression: BootstrapExpression): string {
        var source = this.borrowExpressionSource(expression)
        if (source == "") {
            val root = bootstrapPlaceRootName(expression)
            if (root != "" && this.hasVisibleLocal(root) &&
                !bootstrapIsBorrowType(this.findType(root))) {
                source = bootstrapOwnershipPlaceKey(expression)
            }
        }
        source
    }

    fun borrowExpressionSource(expression: BootstrapExpression): string {
        var source = ""
        if (expression.kind == "member.call" &&
            expression.text == "get" && expression.children.size == 1) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && this.hasVisibleLocal(root) &&
                !bootstrapIsBorrowType(this.findType(root))) {
                source = bootstrapOwnershipPlaceKey(expression.children[0])
            }
        }
        if (expression.kind == "call") {
            val contract = bootstrapBorrowCallResultSource(
                this.declarations,
                "",
                expression.text
            )
            val parameter = bootstrapBorrowCallResultParameter(
                this.declarations,
                "",
                expression.text,
                contract
            )
            if (contract != "" && parameter >= 0 &&
                parameter < expression.children.size) {
                source = this.borrowArgumentSource(
                    expression.children[parameter]
                )
            }
            if (source == "") {
                val functionType = this.findType(expression.text)
                val indirectSource =
                    bootstrapFunctionBorrowResultParameter(functionType)
                if (indirectSource >= 0 &&
                    indirectSource < expression.children.size) {
                    source = this.borrowArgumentSource(
                        expression.children[indirectSource]
                    )
                }
            }
            if (source == "" && this.findKind(expression.text) == "class") {
                val stored = this.constructorStoredBorrowSource(expression)
                if (stored != "managed.unknown" &&
                    stored != "managed.multiple") source = stored
            }
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0 && expression.text != "get") {
            val receiverType = bootstrapBorrowElementType(
                this.infer(expression.children[0])
            )
            val contract = bootstrapBorrowCallResultSource(
                this.declarations,
                receiverType,
                expression.text
            )
            if (contract == "this") {
                source = this.borrowArgumentSource(expression.children[0])
            }
            if (contract != "" && contract != "this") {
                val parameter = bootstrapBorrowCallResultParameter(
                    this.declarations,
                    receiverType,
                    expression.text,
                    contract
                )
                if (parameter >= 0 &&
                    parameter + 1 < expression.children.size) {
                    source = this.borrowArgumentSource(
                        expression.children[parameter + 1]
                    )
                }
            }
        }
        if (expression.kind == "identifier" &&
            this.hasVisibleLocal(expression.text) &&
            bootstrapIsBorrowType(this.findType(expression.text))) {
            source = this.visibleBorrowSource(expression.text)
        }
        if ((expression.kind == "member" || expression.kind == "index") &&
            expression.children.size > 0) {
            source = this.borrowExpressionSource(expression.children[0])
        }
        if (expression.kind == "block" && expression.children.size > 0) {
            source = this.borrowExpressionSource(
                expression.children[expression.children.size - 1]
            )
        }
        if (expression.kind == "if" && expression.children.size > 2 &&
            expression.children[2].kind != "missing") {
            val thenSource = this.borrowExpressionSource(
                expression.children[1]
            )
            val elseSource = this.borrowExpressionSource(
                expression.children[2]
            )
            if (thenSource != "" && thenSource == elseSource) {
                source = thenSource
            } else source = ""
        }
        if (expression.kind == "when") {
            var joinedSource = ""
            var valid = true
            var branch = 2
            while (branch < expression.children.size) {
                val branchSource = this.borrowExpressionSource(
                    expression.children[branch]
                )
                if (branchSource == "") valid = false
                if (joinedSource == "") {
                    joinedSource = branchSource
                    valid = valid
                } else {
                    if (joinedSource != branchSource) valid = false
                    valid = valid
                }
                branch = branch + 2
            }
            if (valid) source = joinedSource
            else source = ""
        }
        source
    }

    fun validateBorrowResultDeclaration(
        declaration: BootstrapDeclaration,
        receiverAllowed: bool,
        context: string
    ): void {
        val contract = bootstrapBorrowResultSource(declaration.resultType)
        val startsContract = bootstrapStartsBorrowResultContract(
            declaration.resultType
        )
        if (startsContract && !bootstrapIsBorrowResultContract(
            declaration.resultType
        )) this.fail("ownership.borrow-return-contract:$context")
        if (contract != "") {
            if (declaration.kind == "extern") {
                this.fail("ownership.borrow-return-extern:$context")
            }
            var valid = receiverAllowed && contract == "this"
            var parameter = 0
            while (parameter < declaration.parameters.size) {
                if (declaration.parameters[parameter] == contract) {
                    valid = true
                    if (parameter < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[parameter] == "own" ||
                         declaration.parameterKinds[parameter] == "var")) {
                        this.fail(
                            "ownership.borrow-return-source-mode:$context:$contract"
                        )
                    }
                    if (parameter < declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[parameter].kind !=
                            "missing") {
                        this.fail(
                            "ownership.borrow-return-source-default:$context:$contract"
                        )
                    }
                }
                parameter = parameter + 1
            }
            if (!valid) this.fail(
                "ownership.borrow-return-source-name:$context:$contract"
            )
        }
    }

    fun validateBorrowReturn(
        expression: BootstrapExpression,
        actual: string,
        context: string
    ): void {
        if (bootstrapIsBorrowType(actual)) {
            if (this.currentBorrowResultSource == "") {
                this.fail("ownership.borrow-escape:$context")
            } else {
                val source = this.borrowExpressionSource(expression)
                if (!bootstrapBorrowSourceMatchesContract(
                    source,
                    this.currentBorrowResultSource
                )) this.fail(
                    "ownership.borrow-return-source:$context:${this.currentBorrowResultSource}"
                )
            }
        } else if (this.currentBorrowResultSource == "" &&
                   !this.typeIsAffine(actual) &&
                   this.typeNeedsManagedAliasTracking(actual) &&
                   !this.expressionProducesFreshManagedReference(
                       expression,
                       0,
                       true
                   )) {
            var source = this.managedReturnParameterSource(expression)
            if (source == "") source = "nonfresh"
            this.fail(
                "ownership.managed-return-borrow-contract:$context:$source"
            )
        }
    }

    fun managedReturnParameterSource(
        expression: BootstrapExpression
    ): string {
        var source = ""
        if (expression.kind == "identifier" ||
            expression.kind == "member" ||
            expression.kind == "index") {
            val root = bootstrapPlaceRootName(expression)
            if (root != "" && this.hasVisibleLocal(root)) {
                val kind = this.visibleLocalKind(root)
                if (kind == "parameter" || kind == "mutable.parameter") {
                    source = root
                }
            }
        }
        if (source == "" && expression.kind == "block" &&
            expression.children.size > 0) {
            source = this.managedReturnParameterSource(
                expression.children[expression.children.size - 1]
            )
        }
        if (source == "" && expression.kind == "if") {
            var branch = 1
            while (source == "" && branch < expression.children.size) {
                if (expression.children[branch].kind != "missing") {
                    source = this.managedReturnParameterSource(
                        expression.children[branch]
                    )
                }
                branch = branch + 1
            }
        }
        if (source == "" && expression.kind == "when") {
            var branch = 2
            while (source == "" && branch < expression.children.size) {
                source = this.managedReturnParameterSource(
                    expression.children[branch]
                )
                branch = branch + 2
            }
        }
        if (source == "" &&
            (expression.kind == "compile" || expression.kind == "region") &&
            expression.children.size > 0) {
            source = this.managedReturnParameterSource(expression.children[0])
        }
        source
    }

    fun validateHygiene(expression: BootstrapExpression): void {
        // Parsed source spans are never negative. Only the compiler-owned
        // generated-declaration reference builders can mint this marker.
        if (expression.end < 0) {
            var matched = false
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (candidate.generatedNamespace != "" &&
                    candidate.name == expression.text) matched = true
                declaration = declaration + 1
            }
            if (!matched) this.fail("generated.hygiene")
        }
    }

    fun infer(expression: BootstrapExpression): string {
        this.validateHygiene(expression)
        var result = "unknown"
        if (expression.kind == "integer") result = "i64"
        if (expression.kind == "true" || expression.kind == "false") result = "bool"
        if (expression.kind == "null") result = "null"
        if (expression.kind == "string") result = "string"
        if (expression.kind == "string.template") {
            var part = 0
            while (part < expression.children.size) {
                val partType = this.infer(expression.children[part])
                if (partType != "string" && partType != "i64" &&
                    partType != "bool" && partType != "null" &&
                    partType != "any") {
                    this.fail("string.interpolation:$partType")
                }
                part = part + 1
            }
            result = "string"
        }
        if (expression.kind == "compile") {
            val effects = bootstrapExpressionCompileEffects(
                expression.children[0],
                this.compileEffects
            )
            val deniedEffects = bootstrapDeniedCompileEffects(
                effects,
                this.compileEffectGrants
            )
            val denied = bootstrapCompileEffectName(deniedEffects)
            if (denied != "") {
                val path = bootstrapCompileEffectPath(
                    expression.children[0],
                    this.declarations,
                    this.compileEffects,
                    bootstrapFirstCompileEffect(deniedEffects),
                    0
                )
                this.fail("compile.effect-denied:$denied:$path")
            }
            this.compileDepth = this.compileDepth + 1
            result = this.infer(expression.children[0])
            this.compileDepth = this.compileDepth - 1
        }
        if (expression.kind == "region") {
            if (this.hasMutableHeapGlobal()) {
                this.fail("region.mutable-heap-global")
            }
            val previousScope = this.enterScope()
            val previousRegionScope = this.regionScope
            this.regionDepth = this.regionDepth + 1
            this.regionScope = this.currentScope
            result = this.infer(expression.children[0])
            this.regionScope = previousRegionScope
            this.regionDepth = this.regionDepth - 1
            this.leaveScope(previousScope)
            if (!bootstrapRegionResultIsIndependent(result)) {
                this.fail("region.result:$result")
            }
        }
        if (expression.kind == "array") {
            var elementType = "unknown"
            var element = 0
            while (element < expression.children.size) {
                val found = this.infer(expression.children[element])
                if (bootstrapIsBorrowType(found)) {
                    this.fail("ownership.borrow-store:array")
                }
                if (elementType != "unknown" && elementType != found) {
                    this.fail("array.element-type")
                }
                if (elementType == "unknown") elementType = found
                element = element + 1
            }
            result = "array:$elementType"
        }
        if (expression.kind == "range.closed" ||
            expression.kind == "range.until") {
            val beginType = this.infer(expression.children[0])
            val endType = this.infer(expression.children[1])
            if (beginType != "i64" || endType != "i64") {
                this.fail("range.bound-type")
            }
            result = "array:i64"
        }
        if (expression.kind == "identifier") {
            result = this.findType(expression.text)
            val kind = this.findKind(expression.text)
            if ((kind == "compile.val" || kind == "compile.var") &&
                this.compileDepth == 0) {
                this.fail("compile.value-runtime:${expression.text}")
            }
            if (result == "unknown") this.fail(
                "identifier:${expression.text}@${expression.begin}"
            )
        }
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move" ||
            expression.kind == "lambda.generator") {
            this.validateLambdaCaptures(expression)
            val previousScope = this.enterScope()
            val previousResultType = this.currentResultType
            val previousBorrowResultSource =
                this.currentBorrowResultSource
            val previousReturnedType = this.returnedType
            val previousLoopDepth = this.loopDepth
            val previousGeneratorDepth = this.generatorDepth
            val previousYieldedType = this.yieldedType
            this.currentResultType = "inferred"
            this.currentBorrowResultSource = ""
            this.returnedType = "unknown"
            this.loopDepth = 0
            if (expression.kind != "lambda.generator") {
                this.generatorDepth = 0
                this.yieldedType = "unknown"
            }
            var parameters = ""
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                val found = expression.children[parameter]
                var parameterType = "unknown"
                if (found.kind == "lambda.parameter" &&
                    found.children.size > 0) {
                    parameterType = bootstrapNormalizeType(
                        found.children[0].text
                    )
                    if (parameter > 0) parameters = "$parameters,"
                    parameters = "$parameters$parameterType"
                    this.locals.append(BootstrapSymbol(
                        found.text,
                        "parameter",
                        parameterType,
                        this.currentScope,
                        ""
                    ))
                }
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            var bodyType = this.infer(body)
            if (bootstrapIsBorrowType(bodyType)) {
                this.fail("ownership.borrow-escape:lambda")
            }
            if (bodyType == "never") {
                bodyType = this.returnedType
            } else {
                if (this.returnedType != "unknown") {
                    bodyType = bootstrapJoinTypes(bodyType, this.returnedType)
                } else bodyType = bodyType
            }
            this.currentResultType = previousResultType
            this.currentBorrowResultSource = previousBorrowResultSource
            this.returnedType = previousReturnedType
            this.loopDepth = previousLoopDepth
            if (expression.kind != "lambda.generator") {
                this.generatorDepth = previousGeneratorDepth
                this.yieldedType = previousYieldedType
            }
            this.leaveScope(previousScope)
            val functionType = "function:($parameters)->$bodyType"
            if (expression.kind == "lambda.move" ||
                expression.kind == "lambda.generator") {
                result = "once:$functionType"
            } else if (this.lambdaRequiresMutableCall(expression)) {
                result = "mut:$functionType"
            } else result = functionType
        }
        if (expression.kind == "call" && expression.text == "move") {
            if (expression.children.size != 1) {
                this.fail("move.arity")
                result = "unknown"
            } else {
                val moved = expression.children[0]
                if (moved.kind == "identifier") {
                    if (bootstrapIsBorrowType(this.findType(moved.text))) {
                        this.fail("ownership.borrow-move:${moved.text}")
                    } else if (!this.hasMovableLocal(moved.text)) {
                        this.fail("move.local")
                    }
                } else if (moved.kind == "member" ||
                           moved.kind == "index") {
                    val root = bootstrapPlaceRootName(moved)
                    if (root == "" || !this.hasMovableLocal(root)) {
                        this.fail("ownership.place-owner:$root")
                    }
                    if (root != "" && this.typeHasDrop(this.findType(root))) {
                        this.fail("ownership.place-drop:$root")
                    }
                } else {
                    this.fail("move.local-or-place")
                }
                result = this.infer(moved)
                if ((moved.kind == "member" || moved.kind == "index") &&
                    !this.typeIsAffine(result)) {
                    this.fail("ownership.place-non-affine")
                }
                result = result
            }
        }
        if (expression.kind == "call" && expression.text == "Shared") {
            if (expression.children.size != 1) {
                this.fail("shared.arity")
                result = "unknown"
            } else {
                val element = this.infer(expression.children[0])
                if (bootstrapIsBorrowType(element)) {
                    this.fail("ownership.borrow-store:Shared")
                }
                if (!this.typeIsAffine(element)) {
                    this.fail("shared.element-affine:$element")
                }
                this.validateOwnershipTransfer(
                    element,
                    expression.children[0],
                    "argument.Shared"
                )
                result = "shared:$element"
            }
        }
        if (expression.kind == "call" && expression.text == "Mutex") {
            if (expression.children.size != 1) {
                this.fail("mutex.arity")
                result = "unknown"
            } else {
                val element = this.infer(expression.children[0])
                if (bootstrapIsBorrowType(element)) {
                    this.fail("ownership.borrow-store:Mutex")
                }
                if (!this.typeIsAffine(element)) {
                    this.fail("mutex.element-affine:$element")
                }
                this.validateOwnershipTransfer(
                    element,
                    expression.children[0],
                    "argument.Mutex"
                )
                result = "mutex:$element"
            }
        }
        if (expression.kind == "call" && expression.text == "Cell") {
            if (expression.children.size != 1) {
                this.fail("cell.arity")
                result = "unknown"
            } else {
                val element = this.infer(expression.children[0])
                if (!bootstrapCellElementIsCopy(element)) {
                    this.fail("cell.element-copy:$element")
                }
                result = "cell:$element"
            }
        }
        if (expression.kind == "call" && expression.text != "move" &&
            expression.text != "Shared" && expression.text != "Mutex" &&
            expression.text != "Cell") {
            if (this.regionDepth > 0 &&
                bootstrapRegionCallIsUnsafe(
                    this.regionCalls,
                    expression.text
                )) {
                this.fail("region.call-retention:${expression.text}")
            }
            if (this.regionDepth > 0) {
                var retainedParameter = 0
                while (retainedParameter < expression.children.size) {
                    if (bootstrapRegionParameterIsRetaining(
                        this.regionCalls,
                        expression.text,
                        retainedParameter
                    ) && !this.regionExpressionIsOwned(
                        expression.children[retainedParameter]
                    )) {
                        this.fail(
                            "region.parameter-retention:${expression.text}#$retainedParameter"
                        )
                    }
                    retainedParameter = retainedParameter + 1
                }
            }
            if (this.functionRequiresTrust(expression.text) &&
                this.trustedDepth == 0) {
                this.fail("native.trust:${expression.text}")
            }
            val functionType = this.findType(expression.text)
            val symbolKind = this.findKind(expression.text)
            if (this.regionDepth > 0 &&
                bootstrapIsFunctionType(functionType) &&
                symbolKind != "fun" && symbolKind != "extern" &&
                symbolKind != "compile.fun" &&
                !this.regionNameIsOwned(expression.text)) {
                this.fail("region.indirect-call-retention:${expression.text}")
            }
            if (!bootstrapIsFunctionType(functionType) &&
                symbolKind != "class") {
                this.fail("call.target:${expression.text}")
            }
            var argument = 0
            val resolvedArgumentTypes: array<string> = []
            val resolvedParameterTypes: array<string> = []
            val resolvedParameterKinds: array<string> = []
            var resolvedInsertedDefaults = 0
            while (argument < expression.children.size) {
                resolvedArgumentTypes.append(
                    this.infer(expression.children[argument])
                )
                argument = argument + 1
            }
            if (bootstrapIsFunctionType(functionType)) {
                val parameterCount = this.functionParameterCount(
                    expression.text
                )
                var effectiveParameterCount = parameterCount
                var requiredCount = this.functionRequiredParameterCount(
                    expression.text
                )
                if (effectiveParameterCount < 0) {
                    effectiveParameterCount =
                        bootstrapFunctionParameterCount(functionType)
                    requiredCount = effectiveParameterCount
                }
                if (effectiveParameterCount < 0 ||
                    expression.children.size > effectiveParameterCount ||
                    expression.children.size < requiredCount) {
                    this.fail("function.arity:${expression.text}")
                }
                resolvedInsertedDefaults =
                    effectiveParameterCount - expression.children.size
                argument = 0
                val argumentKinds: array<string> = []
                val argumentTypes: array<string> = []
                while (argument < expression.children.size &&
                       argument < effectiveParameterCount) {
                    val actual = resolvedArgumentTypes[argument]
                    var expected = this.functionParameterType(
                        expression.text,
                        argument
                    )
                    if (parameterCount < 0) {
                        expected = bootstrapFunctionParameterType(
                            functionType,
                            argument
                        )
                    }
                    if (!bootstrapTypesCompatible(expected, actual)) {
                        this.fail("function.argument:${expression.text}")
                    }
                    var parameterKind = "parameter"
                    if (parameterCount >= 0) {
                        parameterKind = this.functionParameterKind(
                            expression.text,
                            argument
                        )
                    } else {
                        parameterKind = bootstrapFunctionParameterKind(
                            functionType,
                            argument
                        )
                    }
                    if (parameterKind == "own") {
                        if (bootstrapIsBorrowType(actual)) {
                            this.fail("ownership.borrow-exclusive:${expression.text}")
                        }
                        this.validateOwnershipTransfer(
                            expected,
                            expression.children[argument],
                            "argument.function.${expression.text}"
                        )
                    }
                    if (parameterKind == "var") {
                        if (bootstrapIsBorrowType(actual)) {
                            this.fail("ownership.borrow-exclusive:${expression.text}")
                        }
                        this.validateMutableBorrowArgument(
                            expression.children[argument],
                            expected,
                            "function.${expression.text}"
                        )
                    }
                    argumentKinds.append(parameterKind)
                    argumentTypes.append(expected)
                    resolvedParameterKinds.append(parameterKind)
                    resolvedParameterTypes.append(expected)
                    argument = argument + 1
                }
                this.validateCallAliases(
                    expression.children,
                    argumentKinds,
                    argumentTypes,
                    "function.${expression.text}"
                )
            }
            if (symbolKind == "class") {
                var declarationIndex = 0
                while (declarationIndex < this.declarations.size) {
                    val declaration = this.declarations[declarationIndex]
                    if (declaration.kind == "class" &&
                        declaration.name == expression.text) {
                        if (declaration.parameters.size !=
                            expression.children.size) {
                            this.fail("constructor.arity:${expression.text}")
                        }
                        var parameter = 0
                        while (parameter < declaration.parameters.size &&
                               parameter < expression.children.size) {
                            val actual = this.infer(
                                expression.children[parameter]
                            )
                            val expected = bootstrapNormalizeType(
                                declaration.parameterTypes[parameter]
                            )
                            if (!bootstrapTypesCompatible(expected, actual)) {
                                this.fail("constructor.argument:${expression.text}")
                            }
                            if (parameter < declaration.parameterKinds.size &&
                                (declaration.parameterKinds[parameter] == "val" ||
                                 declaration.parameterKinds[parameter] == "var" ||
                                 declaration.parameterKinds[parameter] == "own")) {
                                if (bootstrapIsBorrowType(actual) &&
                                    (this.typeIsAffine(expected) ||
                                     !this.typeNeedsManagedAliasTracking(
                                         expected
                                     ))) {
                                    this.fail(
                                        "ownership.borrow-store:${expression.text}"
                                    )
                                }
                                this.validateOwnershipTransfer(
                                    expected,
                                    expression.children[parameter],
                                    "argument.constructor.${expression.text}"
                                )
                            }
                            parameter = parameter + 1
                        }
                    }
                    declarationIndex = declarationIndex + 1
                }
            }
            if (symbolKind == "class") {
                result = expression.text
                val storedSource = this.constructorStoredBorrowSource(
                    expression
                )
                if (storedSource == "managed.unknown") {
                    this.fail(
                        "ownership.stored-reference-provenance:${expression.text}"
                    )
                } else if (storedSource == "managed.multiple") {
                    this.fail(
                        "ownership.stored-reference-multiple:${expression.text}"
                    )
                } else if (storedSource != "") {
                    result = "borrow:$result"
                }
            } else {
                result = bootstrapFunctionResultType(functionType)
                if (bootstrapIsBorrowType(result) &&
                    symbolKind != "fun" &&
                    symbolKind != "compile.fun") {
                    val sourceParameter =
                        bootstrapFunctionBorrowResultParameter(functionType)
                    if (sourceParameter < 0 ||
                        sourceParameter >= expression.children.size) {
                        this.fail(
                            "ownership.borrow-return-indirect-source:${expression.text}"
                        )
                    }
                    if (sourceParameter >= 0 &&
                        bootstrapFunctionParameterKind(
                            functionType,
                            sourceParameter
                        ) != "parameter") {
                        this.fail(
                            "ownership.borrow-return-indirect-mode:${expression.text}"
                        )
                    }
                }
                result = result
            }
            if (bootstrapIsFunctionType(functionType)) {
                this.recordTypedCall(
                    expression,
                    result,
                    "",
                    this.topLevelFunctionHandle(expression.text),
                    resolvedArgumentTypes,
                    resolvedParameterTypes,
                    resolvedParameterKinds,
                    resolvedInsertedDefaults
                )
            }
        }
        if (expression.kind == "member") {
            val rawReceiver = this.infer(expression.children[0])
            val receiver = bootstrapBorrowElementType(rawReceiver)
            if (expression.text == "size" &&
                (receiver == "string" || bootstrapIsArrayType(receiver))) {
                result = "i64"
            } else {
                result = this.fieldType(receiver, expression.text)
                if (result == "unknown") {
                    this.fail("member:${receiver}.${expression.text}")
                }
                if (bootstrapIsBorrowType(rawReceiver) &&
                    !bootstrapRegionResultIsIndependent(result)) {
                    result = "borrow:$result"
                }
                result = result
            }
        }
        if (expression.kind == "index") {
            val rawReceiver = this.infer(expression.children[0])
            val receiver = bootstrapBorrowElementType(rawReceiver)
            val index = this.infer(expression.children[1])
            if (index != "i64") this.fail("index.type")
            if (receiver == "string") result = "i64"
            else if (bootstrapIsArrayType(receiver)) {
                result = bootstrapArrayElementType(receiver)
                if (bootstrapIsBorrowType(rawReceiver) &&
                    !bootstrapRegionResultIsIndependent(result)) {
                    result = "borrow:$result"
                }
                result = result
            } else {
                this.fail("index.receiver:$receiver")
                result = "unknown"
            }
        }
        if (expression.kind == "index.assign") {
            this.validateBorrowMutation(
                expression.children[0],
                "index.assign"
            )
            val rawReceiver = this.infer(expression.children[0])
            if (bootstrapIsBorrowType(rawReceiver)) {
                this.fail("ownership.borrow-mutation:index.assign")
            }
            val receiver = bootstrapBorrowElementType(rawReceiver)
            val index = this.infer(expression.children[1])
            val value = this.infer(expression.children[2])
            if (bootstrapIsBorrowType(value)) {
                this.fail("ownership.borrow-store:index.assign")
            }
            if (index != "i64") this.fail("index.assign-index")
            if (!bootstrapIsArrayType(receiver) ||
                !bootstrapTypesCompatible(
                    bootstrapArrayElementType(receiver),
                    value
                )) {
                this.fail("index.assign-value")
            }
            this.validateRegionStore(
                expression.children[0],
                expression.children[2],
                "index.assign"
            )
            result = value
        }
        if (expression.kind == "member.call") {
            val rawReceiver = this.infer(expression.children[0])
            val receiver = bootstrapBorrowElementType(rawReceiver)
            if (this.regionDepth > 0 &&
                bootstrapRegionMemberCallIsUnsafe(
                    this.regionCalls,
                    expression.text
                )) {
                this.fail("region.call-retention:${expression.text}")
            }
            if (this.regionDepth > 0 &&
                bootstrapRegionReceiverCallIsRetaining(
                    this.regionCalls,
                    receiver,
                    expression.text
                ) &&
                !this.regionExpressionIsOwned(expression.children[0])) {
                this.fail(
                    "region.receiver-retention:${receiver}.${expression.text}"
                )
            }
            if (this.regionDepth > 0) {
                val methodName = "$receiver.${expression.text}"
                var retainedParameter = 1
                while (retainedParameter < expression.children.size) {
                    if (bootstrapRegionParameterIsRetaining(
                        this.regionCalls,
                        methodName,
                        retainedParameter - 1
                    ) && !this.regionExpressionIsOwned(
                        expression.children[retainedParameter]
                    )) {
                        this.fail(
                            "region.parameter-retention:$methodName#${retainedParameter - 1}"
                        )
                    }
                    retainedParameter = retainedParameter + 1
                }
            }
            if (bootstrapIsCellType(receiver)) {
                val element = bootstrapCellElementType(receiver)
                if (expression.text == "get") {
                    if (expression.children.size != 1) {
                        this.fail("cell.get.arity")
                    }
                    result = element
                } else if (expression.text == "set") {
                    if (expression.children.size != 2) {
                        this.fail("cell.set.arity")
                    } else {
                        val value = this.infer(expression.children[1])
                        if (!bootstrapTypesCompatible(element, value)) {
                            this.fail("cell.set.value:$element:$value")
                        }
                    }
                    result = "void"
                } else {
                    this.fail("cell.member:${expression.text}")
                    result = "unknown"
                }
            } else if (bootstrapIsMutexType(receiver)) {
                if (expression.text == "clone") {
                    if (expression.children.size != 1) {
                        this.fail("mutex.clone.arity")
                    }
                    result = receiver
                } else if (expression.text == "with") {
                    if (expression.children.size != 2) {
                        this.fail("mutex.with.arity")
                        result = "unknown"
                    } else {
                        val callbackExpression = expression.children[1]
                        val callback = this.infer(callbackExpression)
                        if (callbackExpression.kind != "identifier" ||
                            !bootstrapIsFunctionType(callback) ||
                            bootstrapFunctionParameterCount(callback) != 1) {
                            this.fail("mutex.with.callback")
                        }
                        if (bootstrapIsFunctionType(callback) &&
                            bootstrapFunctionParameterCount(callback) == 1) {
                            if (bootstrapFunctionParameterKind(callback, 0) !=
                                "var") {
                                this.fail("mutex.with.callback-mode")
                            }
                            if (!bootstrapTypesCompatible(
                                bootstrapMutexElementType(receiver),
                                bootstrapFunctionParameterType(callback, 0)
                            )) this.fail("mutex.with.callback-type")
                            result = bootstrapFunctionResultType(callback)
                            if (!bootstrapRegionResultIsIndependent(result)) {
                                this.fail("mutex.with.result:$result")
                            }
                        }
                    }
                } else {
                    this.fail("mutex.member:${expression.text}")
                    result = "unknown"
                }
            } else if (bootstrapIsSharedType(receiver)) {
                if (expression.children.size != 1) {
                    this.fail("shared.${expression.text}.arity")
                }
                if (expression.text == "clone") result = receiver
                else if (expression.text == "get") {
                    result = "borrow:${bootstrapSharedElementType(receiver)}"
                } else if (expression.text == "downgrade") {
                    result = "weak:${bootstrapSharedElementType(receiver)}"
                } else {
                    this.fail("shared.member:${expression.text}")
                    result = "unknown"
                }
            } else if (bootstrapIsWeakType(receiver)) {
                if (expression.children.size != 1) {
                    this.fail("weak.${expression.text}.arity")
                }
                if (expression.text == "clone") result = receiver
                else if (expression.text == "upgrade") {
                    result = "nullable:shared:${bootstrapWeakElementType(receiver)}"
                } else if (expression.text == "isAlive") result = "bool"
                else {
                    this.fail("weak.member:${expression.text}")
                    result = "unknown"
                }
            } else
            if (expression.text == "append" &&
                bootstrapIsArrayType(receiver)) {
                if (bootstrapIsBorrowType(rawReceiver)) {
                    this.fail("ownership.borrow-mutation:append")
                }
                this.validateBorrowMutation(
                    expression.children[0],
                    "append"
                )
                if (expression.children.size != 2) {
                    this.fail("append.arity")
                } else {
                    val value = this.infer(expression.children[1])
                    if (bootstrapIsBorrowType(value)) {
                        this.fail("ownership.borrow-store:append")
                    }
                    if (!bootstrapTypesCompatible(
                        bootstrapArrayElementType(receiver),
                        value
                    )) {
                        this.fail("append.value")
                    }
                    this.validateOwnershipTransfer(
                        bootstrapArrayElementType(receiver),
                        expression.children[1],
                        "append"
                    )
                    this.validateRegionStore(
                        expression.children[0],
                        expression.children[1],
                        "append"
                    )
                }
                result = "void"
            } else if (expression.text == "slice" && receiver == "string") {
                if (expression.children.size != 3) {
                    this.fail("slice.arity")
                } else {
                    val begin = this.infer(expression.children[1])
                    val end = this.infer(expression.children[2])
                    if (begin != "i64" || end != "i64") {
                        this.fail("slice.index")
                    }
                }
                result = "string"
            } else {
                val receiverKind = this.methodReceiverKind(
                    receiver,
                    expression.text
                )
                if (receiverKind == "var") {
                    if (bootstrapIsBorrowType(rawReceiver)) {
                        this.fail(
                            "ownership.borrow-exclusive:${receiver}.${expression.text}"
                        )
                    }
                    this.validateMutableBorrowArgument(
                        expression.children[0],
                        receiver,
                        "receiver.${receiver}.${expression.text}"
                    )
                }
                val parameterCount = this.methodParameterCount(
                    receiver,
                    expression.text
                )
                val requiredCount = this.methodRequiredParameterCount(
                    receiver,
                    expression.text
                )
                val suppliedCount = expression.children.size - 1
                if (parameterCount < 0 || suppliedCount > parameterCount ||
                    suppliedCount < requiredCount) {
                    this.fail("method.arity:${receiver}.${expression.text}")
                }
                var argument = 1
                val resolvedArgumentTypes: array<string> = []
                val resolvedParameterTypes: array<string> = []
                val resolvedParameterKinds: array<string> = []
                val methodArguments: array<BootstrapExpression> = [
                    expression.children[0]
                ]
                val methodKinds: array<string> = [receiverKind]
                val methodTypes: array<string> = [receiver]
                while (argument < expression.children.size) {
                    val actual = this.infer(expression.children[argument])
                    val expected = this.methodParameterType(
                        receiver,
                        expression.text,
                        argument - 1
                    )
                    if (!bootstrapTypesCompatible(expected, actual)) {
                        this.fail("method.argument:${receiver}.${expression.text}")
                    }
                    if (this.methodParameterKind(
                            receiver,
                            expression.text,
                            argument - 1
                        ) == "own") {
                        if (bootstrapIsBorrowType(actual)) {
                            this.fail(
                                "ownership.borrow-exclusive:${receiver}.${expression.text}"
                            )
                        }
                        this.validateOwnershipTransfer(
                            expected,
                            expression.children[argument],
                            "argument.method.${receiver}.${expression.text}"
                        )
                    }
                    if (this.methodParameterKind(
                            receiver,
                            expression.text,
                            argument - 1
                        ) == "var") {
                        if (bootstrapIsBorrowType(actual)) {
                            this.fail(
                                "ownership.borrow-exclusive:${receiver}.${expression.text}"
                            )
                        }
                        this.validateMutableBorrowArgument(
                            expression.children[argument],
                            expected,
                            "method.${receiver}.${expression.text}"
                        )
                    }
                    methodArguments.append(expression.children[argument])
                    val selectedKind = this.methodParameterKind(
                        receiver,
                        expression.text,
                        argument - 1
                    )
                    methodKinds.append(selectedKind)
                    methodTypes.append(expected)
                    resolvedArgumentTypes.append(actual)
                    resolvedParameterTypes.append(expected)
                    resolvedParameterKinds.append(selectedKind)
                    argument = argument + 1
                }
                this.validateCallAliases(
                    methodArguments,
                    methodKinds,
                    methodTypes,
                    "method.${receiver}.${expression.text}"
                )
                result = this.methodResultType(receiver, expression.text)
                this.recordTypedCall(
                    expression,
                    result,
                    receiver,
                    this.selectedMethodHandle(receiver, expression.text),
                    resolvedArgumentTypes,
                    resolvedParameterTypes,
                    resolvedParameterKinds,
                    parameterCount - suppliedCount
                )
            }
        }
        if (expression.kind == "member.assign") {
            this.validateBorrowMutation(
                expression.children[0],
                "member.assign.${expression.text}"
            )
            val rawReceiver = this.infer(expression.children[0])
            if (bootstrapIsBorrowType(rawReceiver)) {
                this.fail("ownership.borrow-mutation:member.assign")
            }
            val receiver = bootstrapBorrowElementType(rawReceiver)
            val expected = this.fieldType(receiver, expression.text)
            val actual = this.infer(expression.children[1])
            if (bootstrapIsBorrowType(actual)) {
                this.fail("ownership.borrow-store:field.${expression.text}")
            }
            if (expected == "unknown" ||
                !bootstrapTypesCompatible(expected, actual)) {
                this.fail("member.assign:${receiver}.${expression.text}")
            }
            this.validateOwnershipTransfer(
                expected,
                expression.children[1],
                "field.${expression.text}"
            )
            if (!this.fieldIsMutable(receiver, expression.text)) {
                this.fail("member.immutable:${receiver}.${expression.text}")
            }
            this.validateRegionStore(
                expression.children[0],
                expression.children[1],
                "field.${expression.text}"
            )
            result = actual
        }
        if (expression.kind == "block") {
            val previousScope = this.enterScope()
            result = "void"
            var statement = 0
            while (statement < expression.children.size) {
                result = this.infer(expression.children[statement])
                statement = statement + 1
            }
            this.leaveScope(previousScope)
        }
        if (expression.kind == "defer") {
            if (expression.children.size != 1 ||
                expression.children[0].kind == "missing") {
                this.fail("defer.body")
            }
            if (expression.children.size == 1 &&
                bootstrapExpressionContainsDeferredControl(
                    expression.children[0]
                )) this.fail("defer.control")
            var deferredType = "once:function:()->void"
            if (expression.children.size == 1 &&
                expression.children[0].kind != "missing") {
                deferredType = this.infer(BootstrapExpression(
                    "lambda.move",
                    "",
                    expression.begin,
                    expression.end,
                    [expression.children[0]]
                ))
            }
            if (deferredType != "once:function:()->void") {
                this.fail("defer.result")
            }
            result = "void"
        }
        if (expression.kind == "generator") {
            if (expression.children.size != 1 ||
                expression.children[0].kind == "missing") {
                this.fail("generator.body")
                result = "generator:unknown"
            } else {
                val previousGeneratorDepth = this.generatorDepth
                val previousYieldedType = this.yieldedType
                this.generatorDepth = this.generatorDepth + 1
                this.yieldedType = "unknown"
                val callable = this.infer(BootstrapExpression(
                    "lambda.generator",
                    "",
                    expression.begin,
                    expression.end,
                    [expression.children[0]]
                ))
                val element = this.yieldedType
                this.generatorDepth = previousGeneratorDepth
                this.yieldedType = previousYieldedType
                if (bootstrapFunctionResultType(callable) != "void") {
                    this.fail("generator.result")
                }
                if (element == "unknown") this.fail("generator.empty")
                result = "generator:$element"
            }
        }
        if (expression.kind == "yield") {
            if (this.generatorDepth <= 0) this.fail("yield.outside-generator")
            var found = "unknown"
            if (expression.children.size == 1) {
                found = this.infer(expression.children[0])
            } else this.fail("yield.value")
            if (bootstrapIsBorrowType(found) || this.typeIsAffine(found)) {
                this.fail("yield.affine:$found")
            }
            if (this.yieldedType == "unknown") this.yieldedType = found
            else if (!bootstrapTypesCompatible(this.yieldedType, found)) {
                this.fail("yield.type")
            }
            result = "void"
        }
        if (expression.kind == "task" || expression.kind == "thread") {
            if (expression.children.size != 1 ||
                expression.children[0].kind == "missing") {
                this.fail("${expression.kind}.body")
                result = "${expression.kind}:unknown"
            } else {
                if (expression.kind == "thread") {
                    this.validateThreadCaptures(expression.children[0])
                }
                val callable = this.infer(BootstrapExpression(
                    "lambda.move",
                    "",
                    expression.begin,
                    expression.end,
                    [expression.children[0]]
                ))
                val found = bootstrapFunctionResultType(callable)
                if (bootstrapIsBorrowType(found) || this.typeIsAffine(found)) {
                    this.fail("${expression.kind}.affine-result:$found")
                }
                result = "${expression.kind}:$found"
            }
        }
        if (expression.kind == "await") {
            var operation = "unknown"
            if (expression.children.size == 1) {
                operation = this.infer(expression.children[0])
            } else this.fail("await.operation")
            if (bootstrapIsTaskType(operation)) {
                result = bootstrapTaskResultType(operation)
            } else if (bootstrapIsThreadType(operation)) {
                result = bootstrapThreadResultType(operation)
            } else {
                this.fail("await.type:$operation")
                result = "unknown"
            }
        }
        if (expression.kind == "return") {
            if (this.regionDepth > 0) this.fail("region.control:return")
            var returned = "void"
            if (expression.children[0].kind != "missing") {
                returned = this.infer(expression.children[0])
            }
            this.validateBorrowReturn(
                expression.children[0],
                returned,
                "return"
            )
            if (this.currentResultType == "") {
                this.fail("return.outside-function")
            }
            if (this.currentResultType != "" &&
                this.currentResultType != "inferred" &&
                !bootstrapTypesCompatible(this.currentResultType, returned)) {
                this.fail("return.type")
            }
            if (this.currentResultType != "" &&
                this.currentResultType != "inferred" &&
                !bootstrapIsBorrowType(this.currentResultType)) {
                this.validateOwnershipTransfer(
                    this.currentResultType,
                    expression.children[0],
                    "return"
                )
            }
            if (this.returnedType == "unknown") this.returnedType = returned
            else this.returnedType = bootstrapJoinTypes(
                this.returnedType,
                returned
            )
            result = "never"
        }
        if (
            expression.kind == "local.val" ||
            expression.kind == "local.var"
        ) {
            if (this.hasLocal(expression.text)) {
                this.fail("local.duplicate:${expression.text}")
            }
            val hasInitializer = expression.children[0].kind != "missing"
            var initializerType = "unknown"
            var borrowSource = ""
            if (hasInitializer) {
                initializerType = this.infer(expression.children[0])
                if (!bootstrapIsBorrowType(initializerType) &&
                    this.typeNeedsManagedAliasTracking(initializerType) &&
                    (expression.children[0].kind == "identifier" ||
                     expression.children[0].kind == "member" ||
                     expression.children[0].kind == "index")) {
                    val managedSource = this.borrowArgumentSource(
                        expression.children[0]
                    )
                    if (managedSource != "") {
                        initializerType = "borrow:$initializerType"
                        borrowSource = managedSource
                        this.managedAliasBegins.append(expression.begin)
                        this.managedAliasEnds.append(expression.end)
                        this.managedAliasSources.append(managedSource)
                    }
                }
                if (bootstrapIsBorrowType(initializerType) &&
                    expression.kind == "local.var") {
                    this.fail(
                        "ownership.borrow-mutable-local:${expression.text}"
                    )
                }
                if (bootstrapIsBorrowType(initializerType)) {
                    if (borrowSource == "") {
                        borrowSource = this.borrowExpressionSource(
                            expression.children[0]
                        )
                    }
                    if (borrowSource == "") {
                        this.fail("ownership.borrow-source:${expression.text}")
                    }
                    if (expression.children[0].kind == "call" &&
                        this.findKind(expression.children[0].text) == "class") {
                        this.managedAliasBegins.append(expression.begin)
                        this.managedAliasEnds.append(expression.end)
                        this.managedAliasSources.append(borrowSource)
                    }
                }
            }
            var type = initializerType
            if (expression.children.size > 1 &&
                expression.children[1].text != "inferred") {
                val declaredType = bootstrapNormalizeType(
                    expression.children[1].text
                )
                if (bootstrapIsBorrowType(initializerType)) {
                    if (declaredType != initializerType &&
                        declaredType != bootstrapBorrowElementType(
                            initializerType
                        )) {
                        this.fail(
                            "ownership.borrow-annotation:${expression.text}"
                        )
                    }
                    type = initializerType
                    bootstrapSemanticUnit()
                } else {
                    type = declaredType
                    if (hasInitializer &&
                        !bootstrapTypesCompatible(type, initializerType)) {
                        this.fail("local.initializer:${expression.text}")
                    }
                    bootstrapSemanticUnit()
                }
                type = type
            }
            if (hasInitializer) {
                if (expression.kind == "local.val" &&
                    !bootstrapIsBorrowType(type) &&
                    this.typeNeedsManagedAliasTracking(type) &&
                    this.expressionProducesFreshManagedReference(
                        expression.children[0],
                        0,
                        true
                    )) borrowSource = "managed.fresh"
                this.validateOwnershipTransfer(
                    type,
                    expression.children[0],
                    "local.${expression.text}"
                )
            }
            if (!hasInitializer) {
                if (expression.kind != "local.var") {
                    this.fail("local.uninitialized-val:${expression.text}")
                }
                if (expression.children.size < 2 ||
                    expression.children[1].text == "inferred") {
                    this.fail("local.uninitialized-type:${expression.text}")
                }
            }
            val kind = if (expression.kind == "local.var") "var" else "val"
            this.locals.append(BootstrapSymbol(
                expression.text,
                kind,
                type,
                this.currentScope,
                borrowSource
            ))
            if (this.regionDepth > 0 && hasInitializer &&
                this.regionExpressionIsOwned(expression.children[0])) {
                this.markRegionOwned(expression.text, this.currentScope)
            }
            result = "void"
        }
        if (expression.kind == "assign") {
            val target = this.findType(expression.text)
            val value = this.infer(expression.children[0])
            if (bootstrapIsBorrowType(value)) {
                this.fail("ownership.borrow-store:assignment.${expression.text}")
            }
            if (target == "unknown" ||
                !bootstrapTypesCompatible(target, value)) {
                this.fail(
                    "assignment.type:${expression.text}@${expression.begin}"
                )
            }
            this.validateOwnershipTransfer(
                target,
                expression.children[0],
                "assignment.${expression.text}"
            )
            if (this.hasVisibleLocal(expression.text) &&
                !this.localIsMutable(expression.text)) {
                this.fail("assignment.immutable:${expression.text}")
            }
            if (!this.hasVisibleLocal(expression.text) &&
                this.currentOwner != "" &&
                this.fieldType(this.currentOwner, expression.text) != "unknown" &&
                !this.fieldIsMutable(this.currentOwner, expression.text)) {
                this.fail("field.immutable:${expression.text}")
            }
            if (!this.hasVisibleLocal(expression.text) &&
                this.findKind(expression.text) == "val") {
                this.fail("global.immutable:${expression.text}")
            }
            val assignmentTarget = BootstrapExpression(
                "identifier",
                expression.text,
                expression.begin,
                expression.end,
                []
            )
            this.validateRegionStore(
                assignmentTarget,
                expression.children[0],
                "assignment.${expression.text}"
            )
            if (this.regionDepth > 0 &&
                this.hasVisibleLocal(expression.text) &&
                this.scopeIsWithin(
                    this.visibleLocalScope(expression.text),
                    this.regionScope
                ) && this.regionExpressionIsOwned(expression.children[0])) {
                this.markRegionOwned(
                    expression.text,
                    this.visibleLocalScope(expression.text)
                )
            }
            result = value
        }
        if (
            expression.kind == "unary-" ||
            expression.kind == "unary+"
        ) {
            result = this.infer(expression.children[0])
            if (result != "i64") this.fail("unary.numeric")
        }
        if (expression.kind == "unary!") {
            result = this.infer(expression.children[0])
            if (result != "bool") this.fail("unary.boolean")
            result = "bool"
        }
        if (expression.kind == "&&" || expression.kind == "||") {
            val left = this.infer(expression.children[0])
            val previousScope = this.enterScope()
            this.addNullableRefinements(
                expression.children[0],
                expression.kind == "&&"
            )
            val right = this.infer(expression.children[1])
            this.leaveScope(previousScope)
            if (left != "bool" || right != "bool") this.fail("logical.type")
            result = "bool"
        }
        if (expression.kind == "if") {
            val condition = this.infer(expression.children[0])
            if (condition != "bool") this.fail("if.condition")
            val previousThenScope = this.enterScope()
            this.addNullableRefinements(expression.children[0], true)
            val thenType = this.infer(expression.children[1])
            this.leaveScope(previousThenScope)
            if (expression.children[2].kind == "missing") {
                result = "void"
            } else {
                val previousElseScope = this.enterScope()
                this.addNullableRefinements(expression.children[0], false)
                val elseType = this.infer(expression.children[2])
                this.leaveScope(previousElseScope)
                result = bootstrapJoinTypes(thenType, elseType)
            }
        }
        if (expression.kind == "while") {
            val condition = this.infer(expression.children[0])
            if (condition != "bool") this.fail("while.condition")
            this.loopDepth = this.loopDepth + 1
            this.infer(expression.children[1])
            this.loopDepth = this.loopDepth - 1
            result = "void"
            if (expression.children[0].kind == "true" &&
                !bootstrapExpressionBreaksCurrentLoop(
                    expression.children[1],
                    0
                )) result = "never"
        }
        if (expression.kind == "do.while") {
            this.loopDepth = this.loopDepth + 1
            this.infer(expression.children[0])
            this.loopDepth = this.loopDepth - 1
            val condition = this.infer(expression.children[1])
            if (condition != "bool") this.fail("do-while.condition")
            result = "void"
            if (expression.children[1].kind == "true" &&
                !bootstrapExpressionBreaksCurrentLoop(
                    expression.children[0],
                    0
                )) result = "never"
        }
        if (expression.kind == "for") {
            val sourceType = this.infer(expression.children[0])
            var elementType = "unknown"
            if (bootstrapIsArrayType(sourceType)) {
                elementType = bootstrapArrayElementType(sourceType)
            }
            if (bootstrapIsGeneratorType(sourceType)) {
                elementType = bootstrapGeneratorElementType(sourceType)
            }
            if (sourceType == "string") elementType = "i64"
            if (elementType == "unknown") this.fail("for.source")
            val previousScope = this.enterScope()
            this.locals.append(BootstrapSymbol(
                expression.text,
                "val",
                elementType,
                this.currentScope,
                ""
            ))
            this.loopDepth = this.loopDepth + 1
            this.infer(expression.children[1])
            this.loopDepth = this.loopDepth - 1
            this.leaveScope(previousScope)
            result = "void"
        }
        if (expression.kind == "break" || expression.kind == "continue") {
            if (this.regionDepth > 0) {
                this.fail("region.control:${expression.kind}")
            }
            if (this.loopDepth <= 0) this.fail(
                "${expression.kind}.outside-loop"
            )
            result = "never"
        }
        if (expression.kind == "when") {
            val subject = this.infer(expression.children[0])
            var branchType = "unknown"
            var hasElse = false
            var hasTrue = false
            var hasFalse = false
            val literalKeys: array<string> = []
            if (expression.children.size == 1) this.fail("when.empty")
            var branch = 1
            while (branch + 1 < expression.children.size) {
                val match = expression.children[branch]
                if (match.kind == "missing") {
                    if (hasElse) this.fail("when.else-duplicate")
                    if (branch + 2 < expression.children.size) {
                        this.fail("when.else-last")
                    }
                    hasElse = true
                    bootstrapSemanticUnit()
                } else {
                    val matchType = this.infer(match)
                    if (!bootstrapTypesCompatible(subject, matchType)) {
                        this.fail("when.match")
                    }
                    if (match.kind == "true") hasTrue = true
                    if (match.kind == "false") hasFalse = true
                    val key = bootstrapWhenLiteralKey(match)
                    if (key != "") {
                        if (bootstrapAffineNamesContain(literalKeys, key)) {
                            this.fail("when.duplicate:$key")
                        } else literalKeys.append(key)
                    }
                    bootstrapSemanticUnit()
                }
                val found = this.infer(expression.children[branch + 1])
                branchType = bootstrapJoinTypes(branchType, found)
                branch = branch + 2
            }
            if (!hasElse && !(subject == "bool" && hasTrue && hasFalse)) {
                this.fail("when.non-exhaustive:$subject")
            }
            result = branchType
        }
        if (
            expression.kind == "+" || expression.kind == "-" ||
            expression.kind == "*" || expression.kind == "/"
        ) {
            val left = this.infer(expression.children[0])
            val right = this.infer(expression.children[1])
            if (left != "i64" || right != "i64") this.fail("arithmetic.type")
            result = "i64"
        }
        if (
            expression.kind == "==" || expression.kind == "!=" ||
            expression.kind == "<" || expression.kind == "<=" ||
            expression.kind == ">" || expression.kind == ">="
        ) {
            val left = this.infer(expression.children[0])
            val right = this.infer(expression.children[1])
            if (!bootstrapTypesCompatible(left, right) &&
                !bootstrapTypesCompatible(right, left)) {
                this.fail("comparison.type")
            }
            result = "bool"
        }
        result
    }

    fun analyze(parsed: BootstrapParseResult): BootstrapSemanticResult {
        this.errors = this.errors + parsed.errors
        var capabilityAction = 0
        while (capabilityAction < parsed.actions.size) {
            val staged = parsed.actions[capabilityAction]
            if (staged.kind == "compile" && staged.children.size == 1) {
                val request = staged.children[0]
                if (request.kind == "call" &&
                    request.text == "compilerGrant" &&
                    request.children.size == 1 &&
                    request.children[0].kind == "string") {
                    val name = request.children[0].text
                    val effect = bootstrapCompileEffectFromName(name)
                    if (effect == 0) {
                        this.fail("compile.capability-unknown:$name")
                    } else if (!bootstrapCompileEffectHas(
                        this.compileEffectAuthorizations,
                        effect
                    )) this.fail(
                        "compile.capability-not-authorized:$name"
                    )
                }
            }
            capabilityAction = capabilityAction + 1
        }
        // Publish declaration signatures before inferring any initializer or
        // body. Module flattening order must not make a later imported
        // function or nominal class invisible to an earlier view module.
        var index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            var symbolName = declaration.name
            if (declaration.extensionOwner != "") {
                symbolName = "${declaration.extensionOwner}.${declaration.name}"
            }
            var type = "unknown"
            var publish = false
            if (bootstrapDeclarationIsValue(declaration.kind) &&
                declaration.resultType != "inferred") {
                type = bootstrapNormalizeType(declaration.resultType)
                publish = true
            }
            if (declaration.kind == "fun" ||
                declaration.kind == "extern" ||
                declaration.kind == "compile.fun") {
                type = bootstrapDeclarationFunctionType(declaration)
                publish = true
            }
            if (declaration.kind == "class" ||
                declaration.kind == "interface") {
                type = declaration.name
                publish = true
            }
            if (publish) {
                if (this.hasSymbol(symbolName)) {
                    this.fail("symbol.duplicate:$symbolName")
                }
                this.symbols.append(BootstrapSymbol(
                    symbolName,
                    declaration.kind,
                    type,
                    -1,
                    ""
                ))
            }
            index = index + 1
        }
        index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            this.currentGeneratedNamespace = declaration.generatedNamespace
            this.currentGeneratedOriginBegin =
                declaration.generatedOriginBegin
            this.currentGeneratedOriginEnd = declaration.generatedOriginEnd
            var symbolName = declaration.name
            if (declaration.extensionOwner != "") {
                symbolName = "${declaration.extensionOwner}.${declaration.name}"
            }
            val predeclared = declaration.kind == "fun" ||
                declaration.kind == "extern" ||
                declaration.kind == "compile.fun" ||
                declaration.kind == "class" ||
                declaration.kind == "interface" ||
                (bootstrapDeclarationIsValue(declaration.kind) &&
                 declaration.resultType != "inferred")
            if (!predeclared && this.hasSymbol(symbolName)) {
                this.fail("symbol.duplicate:$symbolName")
            }
            var type = "unknown"
            if (bootstrapDeclarationIsValue(declaration.kind)) {
                if (declaration.kind == "compile.val" ||
                    declaration.kind == "compile.var") {
                    this.compileDepth = this.compileDepth + 1
                }
                val inferredType = this.infer(declaration.expression)
                if (declaration.kind == "compile.val" ||
                    declaration.kind == "compile.var") {
                    this.compileDepth = this.compileDepth - 1
                }
                type = inferredType
                if (declaration.resultType != "inferred") {
                    val declaredType = bootstrapNormalizeType(
                        declaration.resultType
                    )
                    if (!bootstrapTypesCompatible(
                        declaredType,
                        inferredType
                    )) this.fail("global.type:${declaration.name}")
                    type = declaredType
                }
                if (bootstrapIsBorrowType(type)) {
                    this.fail("ownership.borrow-store:global.${declaration.name}")
                }
                if (bootstrapIsMutableFunctionType(type) ||
                    bootstrapIsOnceFunctionType(type)) {
                    this.fail(
                        "ownership.affine-callable-global:${declaration.name}"
                    )
                }
            }
            if (declaration.kind == "fun" || declaration.kind == "extern" ||
                declaration.kind == "compile.fun") {
                type = bootstrapDeclarationFunctionType(declaration)
            }
            if (
                declaration.kind == "class" ||
                declaration.kind == "interface"
            ) type = declaration.name
            if (!predeclared) {
                this.symbols.append(BootstrapSymbol(
                    symbolName,
                    declaration.kind,
                    type,
                    -1,
                    ""
                ))
            }
            if (declaration.kind == "fun" ||
                declaration.kind == "compile.fun" ||
                declaration.kind == "extern") {
                this.validateBorrowResultDeclaration(
                    declaration,
                    declaration.extensionOwner != "",
                    symbolName
                )
            }
            var borrowMethod = 0
            while (borrowMethod < declaration.methods.size) {
                val method = declaration.methods[borrowMethod]
                this.validateBorrowResultDeclaration(
                    method,
                    true,
                    "${declaration.name}.${method.name}"
                )
                borrowMethod = borrowMethod + 1
            }
            var ownershipParameter = 0
            while (ownershipParameter < declaration.parameterKinds.size &&
                   ownershipParameter < declaration.parameterTypes.size) {
                val parameterType = bootstrapNormalizeType(
                    declaration.parameterTypes[ownershipParameter]
                )
                if ((declaration.kind == "fun" ||
                     declaration.kind == "compile.fun" ||
                     declaration.kind == "extern") &&
                    bootstrapIsMutableFunctionType(parameterType) &&
                    declaration.parameterKinds[ownershipParameter] != "var") {
                    this.fail("ownership.fnmut-parameter-mode:$symbolName")
                }
                if ((declaration.kind == "fun" ||
                     declaration.kind == "compile.fun" ||
                     declaration.kind == "extern") &&
                    bootstrapIsOnceFunctionType(parameterType) &&
                    declaration.parameterKinds[ownershipParameter] != "own") {
                    this.fail("ownership.fnonce-parameter-mode:$symbolName")
                }
                if (declaration.parameterKinds[ownershipParameter] == "own") {
                    if (declaration.kind == "class") {
                        this.fail(
                            "ownership.owned-constructor-parameter:${declaration.name}"
                        )
                    } else if (!this.typeIsAffine(
                        bootstrapNormalizeType(
                            declaration.parameterTypes[ownershipParameter]
                        )
                    )) {
                        this.fail(
                            "ownership.owned-parameter-type:$symbolName"
                        )
                    }
                }
                ownershipParameter = ownershipParameter + 1
            }
            var ownershipMethod = 0
            while (ownershipMethod < declaration.methods.size) {
                val method = declaration.methods[ownershipMethod]
                ownershipParameter = 0
                while (ownershipParameter < method.parameterKinds.size &&
                       ownershipParameter < method.parameterTypes.size) {
                    val parameterType = bootstrapNormalizeType(
                        method.parameterTypes[ownershipParameter]
                    )
                    if (bootstrapIsMutableFunctionType(parameterType) &&
                        method.parameterKinds[ownershipParameter] != "var") {
                        this.fail(
                            "ownership.fnmut-parameter-mode:${declaration.name}.${method.name}"
                        )
                    }
                    if (bootstrapIsOnceFunctionType(parameterType) &&
                        method.parameterKinds[ownershipParameter] != "own") {
                        this.fail(
                            "ownership.fnonce-parameter-mode:${declaration.name}.${method.name}"
                        )
                    }
                    if (method.parameterKinds[ownershipParameter] == "own" &&
                        !this.typeIsAffine(parameterType)) {
                        this.fail(
                            "ownership.owned-parameter-type:${declaration.name}.${method.name}"
                        )
                    }
                    ownershipParameter = ownershipParameter + 1
                }
                ownershipMethod = ownershipMethod + 1
            }
            if (declaration.kind == "extern") {
                var externParameter = 0
                while (externParameter < declaration.parameterKinds.size) {
                    if (declaration.parameterKinds[externParameter] == "var") {
                        this.fail(
                            "ownership.mutable-borrow-extern:${declaration.name}"
                        )
                    }
                    externParameter = externParameter + 1
                }
            }
            if (declaration.isNoEscape &&
                (bootstrapRegionCallIsUnsafe(
                    this.regionCalls,
                    declaration.name
                ) || bootstrapRegionFunctionRetainsAnyParameter(
                    this.regionCalls,
                    declaration.name,
                    declaration.parameters.size
                ))) {
                this.fail("region.noescape-effect:${declaration.name}")
            }
            index = index + 1
        }
        val registry = bootstrapBuildSubparserRegistry(parsed)
        var registryError = 0
        while (registryError < registry.errors) {
            this.fail("subparser.registration")
            registryError = registryError + 1
        }
        this.locals = []
        this.refinementNames = []
        this.refinementTypes = []
        this.refinementScopes = []
        this.regionOwnedNames = []
        this.regionOwnedScopes = []
        this.scopeParents = [-1]
        this.currentScope = 0
        this.currentOwner = ""
        this.currentResultType = ""
        this.currentBorrowResultSource = ""
        this.returnedType = "unknown"
        this.loopDepth = 0
        this.trustedDepth = 0
        this.regionDepth = 0
        this.regionScope = -1
        this.compileDepth = 0
        var actionIndex = 0
        while (actionIndex < parsed.actions.size) {
            this.infer(parsed.actions[actionIndex])
            actionIndex = actionIndex + 1
        }
        index = 0
        while (index < parsed.declarations.size) {
            val declaration = parsed.declarations[index]
            if (
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.expression.kind != "missing"
            ) {
                val functionLocals: array<BootstrapSymbol> = []
                if (declaration.extensionOwner != "") {
                    var receiverKind = "parameter"
                    if (this.methodReceiverKind(
                            bootstrapNormalizeType(declaration.extensionOwner),
                            declaration.name
                        ) == "var") {
                        receiverKind = "mutable.parameter"
                    }
                    functionLocals.append(BootstrapSymbol(
                        "this",
                        receiverKind,
                        bootstrapNormalizeType(declaration.extensionOwner),
                        0,
                        ""
                    ))
                }
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    var parameterType = "unknown"
                    var parameterKind = "parameter"
                    if (parameter < declaration.parameterTypes.size) {
                        parameterType = bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                    }
                    if (parameter < declaration.parameterKinds.size &&
                        declaration.parameterKinds[parameter] == "own") {
                        parameterKind = "owned.parameter"
                    }
                    if (parameter < declaration.parameterKinds.size &&
                        declaration.parameterKinds[parameter] == "var") {
                        parameterKind = "mutable.parameter"
                        if (!this.typeIsBorrowTracked(parameterType)) {
                            this.fail("ownership.mutable-borrow-type:${declaration.name}")
                        }
                        if (parameter < declaration.parameterDefaults.size &&
                            declaration.parameterDefaults[parameter].kind !=
                                "missing") {
                            this.fail("ownership.mutable-borrow-default:${declaration.name}")
                        }
                    }
                    functionLocals.append(BootstrapSymbol(
                        declaration.parameters[parameter],
                        parameterKind,
                        parameterType,
                        0,
                        ""
                    ))
                    parameter = parameter + 1
                }
                this.locals = functionLocals
                this.refinementNames = []
                this.refinementTypes = []
                this.refinementScopes = []
                this.regionOwnedNames = []
                this.regionOwnedScopes = []
                this.scopeParents = [-1]
                this.currentScope = 0
                this.currentOwner = ""
                this.currentResultType = "inferred"
                this.currentBorrowResultSource = bootstrapBorrowResultSource(
                    declaration.resultType
                )
                if (declaration.resultType != "inferred") {
                    this.currentResultType = bootstrapNormalizeType(
                        declaration.resultType
                    )
                }
                this.returnedType = "unknown"
                this.loopDepth = 0
                this.trustedDepth = 0
                this.regionDepth = 0
                this.regionScope = -1
                if (declaration.isTrusted) this.trustedDepth = 1
                if (declaration.kind == "compile.fun") {
                    this.compileDepth = 1
                } else this.compileDepth = 0
                parameter = 0
                while (parameter < declaration.parameterDefaults.size) {
                    val defaultValue = declaration.parameterDefaults[parameter]
                    if (defaultValue.kind != "missing") {
                        val defaultType = this.infer(defaultValue)
                        val parameterType = bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                        if (!bootstrapTypesCompatible(
                            parameterType,
                            defaultType
                        )) this.fail(
                            "function.default:${declaration.name}"
                        )
                    }
                    parameter = parameter + 1
                }
                val actual = this.infer(declaration.expression)
                this.validateBorrowReturn(
                    declaration.expression,
                    actual,
                    "function.${declaration.name}"
                )
                if (declaration.resultType != "inferred" &&
                    !bootstrapTypesCompatible(
                        bootstrapNormalizeType(declaration.resultType),
                        actual
                    )) {
                    this.fail(
                        "function.result:${declaration.name}:${bootstrapNormalizeType(declaration.resultType)}:$actual"
                    )
                }
                if (declaration.resultType != "inferred" &&
                    !bootstrapIsBorrowType(bootstrapNormalizeType(
                        declaration.resultType
                    ))) {
                    this.validateOwnershipTransfer(
                        bootstrapNormalizeType(declaration.resultType),
                        declaration.expression,
                        "function.${declaration.name}"
                    )
                }
            }
            index = index + 1
        }
        index = 0
        while (index < parsed.declarations.size) {
            val owner = parsed.declarations[index]
            if (owner.isResource) {
                var dropCount = 0
                var dropIndex = 0
                while (dropIndex < owner.methods.size) {
                    val drop = owner.methods[dropIndex]
                    if (drop.name == "drop") {
                        dropCount = dropCount + 1
                        if (drop.parameters.size != 0 ||
                            bootstrapNormalizeType(drop.resultType) != "void") {
                            this.fail("resource.drop-signature:${owner.name}")
                        }
                    }
                    dropIndex = dropIndex + 1
                }
                if (dropCount > 1) {
                    this.fail("resource.drop-duplicate:${owner.name}")
                }
            }
            var methodIndex = 0
            while (methodIndex < owner.methods.size) {
                val method = owner.methods[methodIndex]
                val methodLocals: array<BootstrapSymbol> = []
                var receiverKind = "parameter"
                if (this.methodReceiverKind(owner.name, method.name) == "var") {
                    receiverKind = "mutable.parameter"
                }
                methodLocals.append(BootstrapSymbol(
                    "this",
                    receiverKind,
                    owner.name,
                    0,
                    ""
                ))
                var parameter = 0
                while (parameter < method.parameters.size) {
                    var parameterType = "unknown"
                    var parameterKind = "parameter"
                    if (parameter < method.parameterTypes.size) {
                        parameterType = bootstrapNormalizeType(
                            method.parameterTypes[parameter]
                        )
                    }
                    if (parameter < method.parameterKinds.size &&
                        method.parameterKinds[parameter] == "own") {
                        parameterKind = "owned.parameter"
                    }
                    if (parameter < method.parameterKinds.size &&
                        method.parameterKinds[parameter] == "var") {
                        parameterKind = "mutable.parameter"
                        if (!this.typeIsBorrowTracked(parameterType)) {
                            this.fail("ownership.mutable-borrow-type:${owner.name}.${method.name}")
                        }
                        if (parameter < method.parameterDefaults.size &&
                            method.parameterDefaults[parameter].kind !=
                                "missing") {
                            this.fail("ownership.mutable-borrow-default:${owner.name}.${method.name}")
                        }
                    }
                    methodLocals.append(BootstrapSymbol(
                        method.parameters[parameter],
                        parameterKind,
                        parameterType,
                        0,
                        ""
                    ))
                    parameter = parameter + 1
                }
                this.locals = methodLocals
                this.refinementNames = []
                this.refinementTypes = []
                this.refinementScopes = []
                this.regionOwnedNames = []
                this.regionOwnedScopes = []
                this.scopeParents = [-1]
                this.currentScope = 0
                this.currentOwner = owner.name
                this.currentResultType = "inferred"
                this.currentBorrowResultSource = bootstrapBorrowResultSource(
                    method.resultType
                )
                if (method.resultType != "inferred") {
                    this.currentResultType = bootstrapNormalizeType(
                        method.resultType
                    )
                }
                this.returnedType = "unknown"
                this.loopDepth = 0
                this.trustedDepth = 0
                this.regionDepth = 0
                this.regionScope = -1
                if (method.isTrusted) this.trustedDepth = 1
                if (method.kind == "compile.fun") {
                    this.compileDepth = 1
                } else this.compileDepth = 0
                parameter = 0
                while (parameter < method.parameterDefaults.size) {
                    val defaultValue = method.parameterDefaults[parameter]
                    if (defaultValue.kind != "missing") {
                        val defaultType = this.infer(defaultValue)
                        val parameterType = bootstrapNormalizeType(
                            method.parameterTypes[parameter]
                        )
                        if (!bootstrapTypesCompatible(
                            parameterType,
                            defaultType
                        )) this.fail(
                            "method.default:${owner.name}.${method.name}"
                        )
                    }
                    parameter = parameter + 1
                }
                val actual = this.infer(method.expression)
                val methodName = "${owner.name}.${method.name}"
                if (method.isNoEscape &&
                    (bootstrapRegionCallIsUnsafe(
                        this.regionCalls,
                        methodName
                    ) || bootstrapRegionReceiverCallIsRetaining(
                        this.regionCalls,
                        owner.name,
                        method.name
                    ) || bootstrapRegionFunctionRetainsAnyParameter(
                        this.regionCalls,
                        methodName,
                        method.parameters.size
                    ))) {
                    this.fail("region.noescape-effect:$methodName")
                }
                this.validateBorrowReturn(
                    method.expression,
                    actual,
                    "method.${owner.name}.${method.name}"
                )
                if (method.resultType != "inferred" &&
                    !bootstrapTypesCompatible(
                        bootstrapNormalizeType(method.resultType),
                        actual
                    )) {
                    this.fail("method.result:${owner.name}.${method.name}")
                }
                if (method.resultType != "inferred" &&
                    !bootstrapIsBorrowType(bootstrapNormalizeType(
                        method.resultType
                    ))) {
                    this.validateOwnershipTransfer(
                        bootstrapNormalizeType(method.resultType),
                        method.expression,
                        "method.${owner.name}.${method.name}"
                    )
                }
                methodIndex = methodIndex + 1
            }
            index = index + 1
        }
        BootstrapSemanticResult(
            this.symbols,
            this.errors,
            this.extensionErrors,
            this.diagnostics,
            this.mutableReceivers,
            this.compileEffects,
            this.typedCalls,
            this.managedAliasBegins,
            this.managedAliasEnds,
            this.managedAliasSources
        )
    }
}

fun bootstrapAnalyzeParsed(parsed: BootstrapParseResult): BootstrapSemanticResult {
    val typedRequestBegins: array<int> = []
    val typedRequestEnds: array<int> = []
    val typedRequestKinds: array<string> = []
    bootstrapAnalyzeRequestedSpans(
        parsed,
        typedRequestBegins,
        typedRequestEnds,
        typedRequestKinds
    )
}

fun bootstrapAnalyzeRequestedSpans(
    parsed: BootstrapParseResult,
    typedRequestBegins: array<int>,
    typedRequestEnds: array<int>,
    typedRequestKinds: array<string>
): BootstrapSemanticResult {
    val symbols: array<BootstrapSymbol> = []
    val locals: array<BootstrapSymbol> = []
    val affineTypes = bootstrapBuildAffineTypeNames(parsed.declarations)
    val mutableReceivers = bootstrapBuildMutableReceiverSummary(
        parsed.declarations,
        affineTypes
    )
    val regionCalls = bootstrapBuildRegionCallSummary(parsed.declarations)
    val compileEffects = bootstrapBuildCompileEffectSummary(
        parsed.declarations
    )
    val compileEffectRequests = bootstrapBuildCompileEffectRequests(parsed)
    val compileEffectAuthorizations =
        bootstrapBuildCompileEffectAuthorizations(parsed)
    val compileEffectGrants = bootstrapBuildCompileEffectGrants(
        compileEffectRequests,
        compileEffectAuthorizations
    )
    BootstrapAnalyzer(
        symbols,
        0,
        0,
        locals,
        parsed.declarations,
        affineTypes,
        mutableReceivers,
        regionCalls,
        compileEffects,
        compileEffectGrants,
        compileEffectAuthorizations,
        typedRequestBegins,
        typedRequestEnds,
        typedRequestKinds,
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        parsed.diagnostics,
        [-1],
        0,
        "",
        "",
        "",
        "",
        "",
        -1,
        -1,
        0,
        0,
        0,
        -1,
        0,
        0,
        "unknown"
    ).analyze(parsed)
}

fun bootstrapAnalyze(source: string): BootstrapSemanticResult =
    bootstrapAnalyzeParsed(bootstrapParse(source))
