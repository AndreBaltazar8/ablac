import "module.ab"
import "module_paths.ab"
import "parser.ab"
import "sema.ab"
import "generic_types.ab"
import "expected_types.ab"
import "named_arguments.ab"
import "receiver_names.ab"

fun bootstrapHasCopyCall(expression: BootstrapExpression): bool {
    if (expression.kind == "member.call" && expression.text == "copy") return true
    for (child in expression.children) if (bootstrapHasCopyCall(child)) return true
    false
}

// A syntax-only proof for ordinary zero-argument calls to a written member.
// Unknown receiver expressions still use the typed probe.
fun bootstrapWrittenCopyResult(normalizer: BootstrapNamedArgumentNormalizer, type: string): string {
    val target = normalizer.targets.find(type)
    if (target < 0 || normalizer.declarations[target].kind != "class") return ""
    val owner = normalizer.declarations[target]
    if (owner.typeParameters.size > 0) return ""
    var result = ""
    for (method in owner.methods) {
        if (method.name != "copy") continue
        if (result != "" || method.parameters.size != 0 || method.typeParameters.size > 0)
            return ""
        result = "${method.resultType}"
    }
    result
}

fun bootstrapWrittenCopyType(normalizer: BootstrapNamedArgumentNormalizer,
    world: BootstrapExpectedWorld, expression: BootstrapExpression): string {
    val names = normalizer.visibleLocals
    val ownerName = normalizer.receiver
    val kind = expression.kind
    if (kind == "identifier") {
        var local = names.size - 1
        while (local >= 0) {
            if (names[local] == expression.text) return "${normalizer.copyTypes[local]}"
            local = local - 1
        }
        if (expression.text == "this") return "${ownerName}"
        val owner = world.classes.find(ownerName)
        if (owner >= 0 && world.classes.fields[owner].find(expression.text) >= 0)
            return world.classes.fields[owner].typeOf(expression.text)
        return world.globals.typeOf(expression.text)
    }
    if (kind == "call" && !bootstrapReceiverNameIn(names, expression.text)) {
        val constructor = normalizer.targets.find(expression.text)
        if (constructor < 0 || normalizer.declarations[constructor].kind != "class") return ""
        if (ownerName != "") {
            val receiver = normalizer.targets.find(ownerName)
            if (receiver < 0 || normalizer.declarations[receiver].kind != "class") return ""
            val fields = world.classes.find(ownerName)
            if (fields < 0 || world.classes.fields[fields].find(expression.text) >= 0) return ""
            for (method in normalizer.declarations[receiver].methods)
                if (method.name == expression.text) return ""
            for (extension in normalizer.declarations)
                if (extension.extensionOwner != "" && extension.name == expression.text) return ""
        }
        return "${normalizer.declarations[constructor].name}"
    }
    if (kind == "member" && expression.children.size == 1) {
        val owner = world.classes.find(bootstrapWrittenCopyType(normalizer, world, expression.children[0]))
        if (owner >= 0) return world.classes.fields[owner].typeOf(expression.text)
    }
    if (kind == "member.call" && expression.text == "copy" && expression.children.size == 1)
        return bootstrapWrittenCopyResult(normalizer,
            bootstrapWrittenCopyType(normalizer, world, expression.children[0]))
    if (kind == "if" && expression.children.size == 3 &&
        expression.children[2].kind == "null") return bootstrapWrittenCopyType(normalizer, world, expression.children[1])
    if (kind == "block" && expression.children.size > 0) {
        // Resolve a branch result only if the block doesn't shadow it.
        // The self-contained constructor expression needs no local lookup.
        val result = expression.children[expression.children.size - 1]
        if (result.kind == "call") {
            for (statement in expression.children) {
                if ((statement.kind == "local.val" || statement.kind == "local.var") &&
                    statement.text == result.text) return ""
            }
            return bootstrapWrittenCopyType(normalizer, world, result)
        }
    }
    ""
}

// The graph's resolved edges, used only when a copy call needs a fallback.
var bootstrapAutoCopyImports: array<BootstrapModuleAlias> = []

private fun bootstrapCopyAliasExposes(
    declarations: array<BootstrapDeclaration>, target: string, owner: BootstrapDeclaration
): bool {
    val source = bootstrapGenericSourceFile(owner.sourceIdentity)
    val name = bootstrapSourceVisibleType(owner.name)
    // Qualified source rewriting uses the target's own name first, then
    // the first declaring module in the export traversal.
    for (module in bootstrapAliasReachedModules(target, bootstrapAutoCopyImports)) {
        for (declaration in declarations) {
            if (declaration.extensionOwner == "" && !declaration.isPrivate &&
                bootstrapGenericSourceFile(declaration.sourceIdentity) == module &&
                bootstrapSourceVisibleType(declaration.name) == name) return module == source
        }
    }
    false
}

private fun bootstrapCopyConstructorVisible(
    declarations: array<BootstrapDeclaration>, caller: string, owner: BootstrapDeclaration
): bool {
    val from = bootstrapGenericSourceFile(caller)
    val to = bootstrapGenericSourceFile(owner.sourceIdentity)
    if (from == to) return true
    if (owner.isPrivate) return false
    // A qualification may expose a class that a bare import does not.
    // Use the actual exported edges, not the wider extension visibility.
    for (edge in bootstrapAutoCopyImports) {
        if (edge.importer == from && edge.alias != "" &&
            bootstrapCopyAliasExposes(declarations, edge.target, owner)) return true
    }
    val visibility = bootstrapStrictHidden(caller, owner.sourceIdentity)
    if (visibility == 1) return false
    if (owner.name == bootstrapSourceVisibleType(owner.name)) return true
    for (edge in bootstrapAutoCopyImports) {
        if (edge.importer == from && edge.alias == "" &&
            bootstrapCopyAliasExposes(declarations, edge.target, owner)) return true
    }
    false
}

fun bootstrapAutoCopyUnavailable(analyzer: BootstrapAnalyzer, owner: BootstrapDeclaration): string {
    if (!bootstrapCopyConstructorVisible(analyzer.declarations, analyzer.currentSourceIdentity, owner))
        return "the primary constructor of `${bootstrapSourceVisibleType(owner.name)}` is not visible here"
    if (owner.isResource)
        return "the receiver has affine ownership"
    if (owner.typeParameters.size != 0)
        return "the receiver must be a non-generic class"
    for (field in 0 until owner.parameters.size) {
        val name = owner.parameters[field]
        val type = owner.parameterTypes[field]
        if (bootstrapIsAnyDelegatedProperty(owner, field))
            return "delegated field `$name` is not a primary constructor argument"
        if (owner.parameterKinds[field] == "own" || analyzer.typeIsAffine(type) || bootstrapIsBorrowType(type))
            return "field `$name` cannot be copied from a borrowed receiver"
        if (owner.parameterKinds[field] != "val" && owner.parameterKinds[field] != "var")
            return "constructor parameter `$name` does not name a readable field"
    }
    if (analyzer.typeIsAffine(owner.name)) return "the receiver has affine ownership"
    ""
}
