// `ablac fix-imports [file.ab | --project <dir>] [--dry-run]`: adds the imports a program is missing, in one command.
// Each round builds the program with a --visibility-report: the strict-import rows name a project module's missing
// import of another, and sema's `standard` rows a standard-library module the program never imported (`println`,
// abla/io: the same rule as the help line, one declaring module). The imports go in after each file's last `import`
// (before its first line of code when it has none), each once, as tools/fix-imports.ab puts them; then the next round
// builds again, until a round adds nothing. A file outside the project (the entry's directory, or the project
// directory) is never touched, nor a package's vendored copy; a name several standard modules declare, or that the
// programs sharing a module see declared differently, is listed and left for the user. The last line counts what
// changed and what is left; the exit status is 1 when a name is left unresolved, 0 otherwise. `--dry-run` writes nothing, so it
// lists the first round only (a strict-import error stops a build before the standard-library names are seen).

import "abla/sys/linux"
import "abla/sys/linux/fs"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "abla/text"
import "module_paths.ab"
import "sema.ab"
import "sourcemap.ab"

val BOOTSTRAP_FIX_IMPORTS_ROUNDS = 4

class BootstrapFixImportsPlan(
    val files: array<string>,
    val imports: array<array<string>>,
    val unresolved: array<string>
)

// The quoted module of an import line (`import "abla/math" as m` -> `"abla/math"`), quotes kept.
fun bootstrapFixImportSpec(line: string): string {
    val open = line.indexOf("\"")
    if (open < 0) return line
    val close = line.slice(open + 1, line.size).indexOf("\"")
    if (close < 0) return line
    line.slice(open, open + close + 2)
}

// Whether `lines` import `spec` in any form: plain, under an alias or exported.
fun bootstrapFixImportsHas(lines: array<string>, spec: string): bool {
    for (line in lines) {
        val trimmed = line.trim()
        if ((trimmed.startsWith("import ") || trimmed.startsWith("export import ")) &&
            bootstrapFixImportSpec(trimmed) == spec) return true
    }
    false
}

fun bootstrapFixImportsAbsolute(path: string): string =
    if (Path(path).isAbsolute()) bootstrapNormalizeModulePath(path)
    else bootstrapNormalizeModulePath("${currentDirectory().text}/$path")

/** What one report asks for, within `root`: the imports per file, and the names left for the user (with why). */
fun bootstrapFixImportsPlan(report: string, root: string): BootstrapFixImportsPlan {
    val files: array<string> = []
    val imports: array<array<string>> = []
    val unresolved: array<string> = []
    val seen: Map<string, string> = Map()
    val listed: Map<string, bool> = Map()
    val rows: array<array<string>> = []
    for (line in Path(report).readText().split("\n")) {
        // file, line, column, name, declaring module, import line[, kind]: module.ab's strict rows have no kind.
        val fields = line.split("\t")
        if (fields.size < 6) continue
        rows.append(fields)
        // One name, two different imports (programs sharing a module that each declare it): no import says that.
        if (fields[5] != "") {
            val key = "${fields[0]}\t${fields[3]}"
            val first = seen.get(key) ?? ""
            if (first == "") seen.set(key, fields[5])
            else if (first != fields[5]) listed.set(key, true)
        }
    }
    val reported: Map<string, bool> = Map()
    for (fields in rows) {
        val file = fields[0]
        val name = fields[3]
        val key = "$file\t$name"
        val why = if (fields[5] == "") "declared in several standard modules (${fields[4]}): import the one you mean"
            else if (listed.has(key)) "declared differently by the programs that share this module"
            else if (!bootstrapPathUnder(root, bootstrapFixImportsAbsolute(file))) "in a file outside the project ($root), not changed"
            else if (fields[5].contains(".abla/packages/")) "declared in a package file its entry doesn't pass on (the package's entry should `export import` it)"
            else ""
        if (why != "") {
            if (!reported.has(key)) {
                reported.set(key, true)
                unresolved.append("$file: `$name` $why")
            }
            continue
        }
        var index = 0
        while (index < files.size && files[index] != file) index = index + 1
        if (index == files.size) {
            files.append(file)
            imports.append([])
        }
        var known = false
        for (wanted in imports[index]) if (wanted == fields[5]) known = true
        if (!known) imports[index].append(fields[5])
    }
    BootstrapFixImportsPlan(files, imports, unresolved)
}

/** Adds `wanted` (import lines) to `file` that it doesn't already import; how many. Writes nothing when `dryRun`. */
fun bootstrapFixImportsApply(file: string, wanted: array<string>, dryRun: bool): int {
    val path = Path(file)
    val lines = path.readText().split("\n")
    var last = -1
    var firstCode = -1
    var index = 0
    while (index < lines.size) {
        val trimmed = lines[index].trim()
        if (trimmed.startsWith("import ") || trimmed.startsWith("export import ")) last = index
        if (firstCode < 0 && trimmed != "" && !trimmed.startsWith("//")) firstCode = index
        index = index + 1
    }
    val added: array<string> = []
    for (line in wanted) {
        if (!bootstrapFixImportsHas(lines, bootstrapFixImportSpec(line))) added.append(line)
    }
    if (added.size == 0) return 0
    for (line in added) linuxPrintStandardOutput("$file: ${if (dryRun) "would add" else "added"} $line\n")
    if (dryRun) return added.size
    val at = if (last >= 0) last + 1 else if (firstCode >= 0) firstCode else 0
    var output = ""
    index = 0
    while (index < lines.size) {
        if (index == at) {
            for (line in added) output = "$output$line\n"
            if (last < 0) output = "$output\n"
        }
        output = if (index + 1 < lines.size) "$output${lines[index]}\n" else "$output${lines[index]}"
        index = index + 1
    }
    path.writeTextAtomic(output)
    added.size
}

fun bootstrapFixImportsCommand(arguments: array<string>): int {
    var source = ""
    var project = ""
    var dryRun = false
    var prune = false
    var index = 0
    while (index < arguments.size) {
        val value = arguments[index]
        if (value == "--dry-run") dryRun = true
        else if (value == "--prune") prune = true
        else if (value == "--project" && index + 1 < arguments.size) {
            project = arguments[index + 1]
            index = index + 1
        } else if (source == "" && !value.startsWith("-")) source = value
        else {
            linuxPrintStandardError("usage: ablac fix-imports [file.ab | --project <dir>] [--prune] [--dry-run]\n")
            return 2
        }
        index = index + 1
    }
    // The project a file belongs to: its abla.toml's directory (a test under tests/ fixes the src/ it reaches, as the
    // build's W_UNUSED_IMPORT warns there), else the file's own.
    val manifest = if (source != "") bootstrapCompileManifestFor(bootstrapFixImportsAbsolute(source)) else ""
    val root = if (manifest != "") Path(manifest).parent().text
        else if (source != "") Path(bootstrapFixImportsAbsolute(source)).parent().text
        else bootstrapFixImportsAbsolute(if (project != "") project else ".")
    // (TMPDIR on POSIX; Windows names its temporary directory TEMP or TMP.)
    var temporaryDirectory = "/tmp"
    for (name in ["TMP", "TEMP", "TMPDIR"]) {
        val temporary = linuxEnvironment(name)
        if (temporary.found && temporary.value != "") temporaryDirectory = temporary.value
    }
    val scratch = "$temporaryDirectory/abla-fix-imports-${linuxProcessId()}"
    Path(scratch).createDirectories()
    if (prune) {
        val status = bootstrapFixImportsPruneCommand(source, project, root, scratch, dryRun)
        Path(scratch).removeTree()
        return status
    }
    var added = 0
    val changed: Map<string, bool> = Map()
    var unresolved: array<string> = []
    var round = 0
    while (round < BOOTSTRAP_FIX_IMPORTS_ROUNDS) {
        val report = "$scratch/report-$round.tsv"
        Path(report).writeText("")
        val build = linuxCommand("/proc/self/exe").argument("build")
        if (source != "") build.argument(source)
        if (project != "") build.argument("--project").argument(project)
        build.argument("-o").argument("$scratch/program").argument("--fast")
            .argument("--visibility-report").argument(report)
            .output("/dev/null").errors("/dev/null")
        build.run()
        val plan = bootstrapFixImportsPlan(report, root)
        unresolved = plan.unresolved
        var addedThisRound = 0
        var file = 0
        while (file < plan.files.size) {
            val count = bootstrapFixImportsApply(plan.files[file], plan.imports[file], dryRun)
            if (count > 0) changed.set(plan.files[file], true)
            addedThisRound = addedThisRound + count
            file = file + 1
        }
        added = added + addedThisRound
        round = round + 1
        if (addedThisRound == 0 || dryRun) break
    }
    Path(scratch).removeTree()
    for (line in unresolved) linuxPrintStandardOutput("$line\n")
    linuxPrintStandardOutput(
        "fix-imports: ${if (dryRun) "would add" else "added"} $added import(s) in ${changed.keys().size} file(s); ${unresolved.size} name(s) left unresolved\n"
    )
    if (unresolved.size > 0) 1 else 0
}

// `ablac fix-imports --prune`: removes the imports W_UNUSED_IMPORT names (module.ab's bootstrapUnusedImportWarnings),
// within the project only. An import a package's entry neither uses nor passes on is listed, never removed (it may be
// meant as `export import`), and a file with a `#compilerGrant` keeps its last import. After removing, it builds
// again: a file whose build got worse (more errors naming it, or a build that passed and now fails) gets its imports
// back, and that round repeats until nothing more is restored.

class BootstrapFixImportsUnused(val file: string, val line: int, val text: string)

class BootstrapFixImportsBuild(val status: int, val diagnostics: string)

fun bootstrapFixImportsBuild(source: string, project: string, scratch: string, warn: bool): BootstrapFixImportsBuild {
    val log = "$scratch/build.log"
    val build = linuxCommand("/proc/self/exe").argument("build")
    if (source != "") build.argument(source)
    if (project != "") build.argument("--project").argument(project)
    build.argument("-o").argument("$scratch/program").argument("--fast")
    if (warn) build.argument("--warn-unused-imports")
    build.output("/dev/null").errors(log)
    val status = build.run()
    BootstrapFixImportsBuild(status, Path(log).readText())
}

/** The prunable warnings of a build's diagnostics; the package-entry ones go to `listed`. */
fun bootstrapFixImportsUnused(diagnostics: string, root: string, var listed: array<string>): array<BootstrapFixImportsUnused> {
    val found: array<BootstrapFixImportsUnused> = []
    val lines = diagnostics.split("\n")
    var index = 0
    while (index < lines.size) {
        val line = lines[index]
        index = index + 1
        if (!line.startsWith("warning[W_UNUSED_IMPORT]: ")) continue
        val open = line.indexOf("`")
        if (open < 0) continue
        val close = line.slice(open + 1, line.size).indexOf("`")
        if (close < 0) continue
        val text = line.slice(open + 1, open + 1 + close)
        // The `-->` line after it gives the import's line.
        var at = index
        var file = ""
        var number = 0
        while (at < lines.size && at < index + 3 && file == "") {
            val place = lines[at].trim()
            if (place.startsWith("--> ")) {
                val parts = place.slice(4, place.size).split(":")
                if (parts.size >= 2) {
                    file = parts[0]
                    number = bootstrapSourceMapParseInt(parts[1], 0, parts[1].size)
                }
            }
            at = at + 1
        }
        if (file == "" || number <= 0) continue
        // Only the project's own files, listed or pruned.
        val absolute = bootstrapFixImportsAbsolute(file)
        if (!bootstrapProjectOwnsPath(root, absolute)) continue
        if (line.endsWith("(W_UNUSED_IMPORT entry)")) {
            listed.append("$file: `$text` left: the package's entry neither uses nor passes it on (`export import` it, or remove it)")
            continue
        }
        found.append(BootstrapFixImportsUnused(file, number, text))
    }
    found
}

/** How many error diagnostics name each file. */
fun bootstrapFixImportsErrors(diagnostics: string): Map<string, int> {
    val counts: Map<string, int> = Map()
    var inError = false
    for (line in diagnostics.split("\n")) {
        if (line.startsWith("error")) inError = true
        else if (line.startsWith("warning")) inError = false
        val place = line.trim()
        if (inError && place.startsWith("--> ")) {
            val file = bootstrapFixImportsAbsolute(place.slice(4, place.size).split(":")[0])
            counts.set(file, (counts.get(file) ?? 0) + 1)
            inError = false
        }
    }
    counts
}

fun bootstrapFixImportsErrorTotal(counts: Map<string, int>): int {
    var total = 0
    for (file in counts.keys()) total = total + (counts.get(file) ?? 0)
    total
}

fun bootstrapFixImportsPruneCommand(source: string, project: string, root: string, scratch: string, dryRun: bool): int {
    val baseline = bootstrapFixImportsBuild(source, project, scratch, true)
    // A front end that stopped at an error never recorded every use, and the compiler gives no warnings then; say so
    // rather than "removed 0". The build's summary line splits its errors: parser, extension and semantic ones are the
    // front end's; an IR error (a library's E_NO_MAIN) or a failed link (E_NATIVE_TOOLCHAIN) comes after every use is
    // known. Without a summary line, any error but a failed link counts.
    var frontEndErrors = 0
    var summarized = false
    for (line in baseline.diagnostics.split("\n")) {
        if (line.startsWith("LLVM compilation failed: ")) {
            summarized = true
            val counts = line.slice(25, line.size).split(", ")
            for (part in counts) {
                if (part.endsWith(" parser") || part.endsWith(" extension") || part.endsWith(" semantic")) {
                    frontEndErrors = frontEndErrors + bootstrapSourceMapParseInt(part, 0, part.size)
                }
            }
        }
    }
    if (!summarized) {
        for (line in baseline.diagnostics.split("\n")) {
            if (line.startsWith("error[") && !line.startsWith("error[E_NATIVE_TOOLCHAIN]")) frontEndErrors = frontEndErrors + 1
        }
    }
    if (frontEndErrors > 0) {
        linuxPrintStandardOutput(
            "fix-imports: the build stops at $frontEndErrors error(s) before every use is known; fix those first, nothing pruned\n"
        )
        return 1
    }
    val before = bootstrapFixImportsErrors(baseline.diagnostics)
    var listed: array<string> = []
    val unused = bootstrapFixImportsUnused(baseline.diagnostics, root, listed)
    // Per file: its original text, and the line numbers to remove.
    val files: array<string> = []
    val removals: array<array<int>> = []
    for (entry in unused) {
        var index = 0
        while (index < files.size && files[index] != entry.file) index = index + 1
        if (index == files.size) {
            files.append(entry.file)
            removals.append([])
        }
        removals[index].append(entry.line)
    }
    val originals: Map<string, string> = Map()
    val pruned: Map<string, int> = Map()
    var kept = 0
    var file = 0
    while (file < files.size) {
        val path = Path(files[file])
        val text = path.readText()
        val lines = text.split("\n")
        val drop: Map<int, bool> = Map()
        for (number in removals[file]) {
            if (number > lines.size) continue
            val trimmed = lines[number - 1].trim()
            if (!trimmed.startsWith("import ") || trimmed.contains(" as ")) continue
            var wanted: string = ""
            for (entry in unused) if (entry.file == files[file] && entry.line == number) wanted = entry.text
            if (bootstrapFixImportSpec(trimmed) != bootstrapFixImportSpec(wanted)) continue
            drop.set(number - 1, true)
        }
        var imports = 0
        var lastDropped = -1
        var index = 0
        while (index < lines.size) {
            val trimmed = lines[index].trim()
            if (trimmed.startsWith("import ") || trimmed.startsWith("export import ")) imports = imports + 1
            if (drop.has(index)) lastDropped = index
            index = index + 1
        }
        // A file with a #compilerGrant keeps its last import: the grant names what the file's compile actions may do.
        if (text.contains("#compilerGrant") && lastDropped >= 0 && drop.keys().size == imports) {
            drop.remove(lastDropped)
            kept = kept + 1
            listed.append("${files[file]}:${lastDropped + 1}: `${lines[lastDropped].trim()}` kept: the last import of a file with a #compilerGrant")
        }
        if (drop.keys().size > 0) {
            for (line in removals[file]) {
                if (drop.has(line - 1))
                    linuxPrintStandardOutput("${files[file]}:$line: ${if (dryRun) "would remove" else "removed"} ${lines[line - 1].trim()}\n")
            }
            pruned.set(files[file], drop.keys().size)
            if (!dryRun) {
                originals.set(files[file], text)
                var output = ""
                index = 0
                while (index < lines.size) {
                    if (!drop.has(index)) output = if (index + 1 < lines.size) "$output${lines[index]}\n" else "$output${lines[index]}"
                    index = index + 1
                }
                path.writeTextAtomic(output)
            }
        }
        file = file + 1
    }
    // Rebuild; give back the imports of any file whose build got worse.
    var restored = 0
    var round = 0
    while (!dryRun && originals.keys().size > 0 && round < BOOTSTRAP_FIX_IMPORTS_ROUNDS) {
        val after = bootstrapFixImportsBuild(source, project, scratch, false)
        val counts = bootstrapFixImportsErrors(after.diagnostics)
        val worse: array<string> = []
        for (changed in originals.keys()) {
            val absolute = bootstrapFixImportsAbsolute(changed)
            if ((counts.get(absolute) ?? 0) > (before.get(absolute) ?? 0)) worse.append(changed)
        }
        // Worse, but no error names a pruned file: put them all back.
        val failedNow = after.status != 0 && baseline.status == 0
        val moreErrors = bootstrapFixImportsErrorTotal(counts) > bootstrapFixImportsErrorTotal(before)
        if (worse.size == 0 && (failedNow || moreErrors)) for (changed in originals.keys()) worse.append(changed)
        if (worse.size == 0) break
        for (changed in worse) {
            Path(changed).writeTextAtomic(originals.get(changed) ?? "")
            linuxPrintStandardOutput("$changed: restored: its build got worse without the imports\n")
            restored = restored + (pruned.get(changed) ?? 0)
            pruned.remove(changed)
            originals.remove(changed)
        }
        round = round + 1
    }
    var removed = 0
    for (changed in pruned.keys()) removed = removed + (pruned.get(changed) ?? 0)
    for (line in listed) linuxPrintStandardOutput("$line\n")
    linuxPrintStandardOutput(
        "fix-imports: ${if (dryRun) "would remove" else "removed"} $removed unused import(s) in ${pruned.keys().size} file(s); $restored restored, ${listed.size} left\n"
    )
    0
}
