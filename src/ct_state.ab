// Which ordinary globals compile-time code can write (#796).
//
// A native compile-time slice has its own copy of every ordinary global (`val` and
// `var` that are not `compile val`/`compile var`), made by its initializer, and the
// interpreter has another. Nothing exchanges a change to one with the other, so a
// site that reads a global some site (or code it reaches) may write must run in the
// interpreter, every site that reaches it, whatever their order or number: a
// syntactic site can run again through a compile function, a generic instantiation
// or a rebuilt module. A global nothing can write (a table) stays native.
//
// The analysis is flow-insensitive and conservative. It follows which globals a value
// may alias: an expression's *origins* are the ordinary globals whose heap it may be
// part of. A read keeps the origins of what it reads from (containment: writing
// `g.f` writes `g`), a store into a field or element adds the stored origins to that
// field name or to the elements (field-based, so `Json(keys, ...)` taints `.keys`),
// a call binds arguments to the parameters of every callable of that name and
// returns what those return, and a local keeps the union of what is assigned to it.
// A write is an assignment to a `var` global, a store into a field or element, one
// of the built-in mutators, or a value handed to code the analysis cannot follow (an
// extern, a closure called as a value). Whatever it writes through is the origins of
// the place. Fresh values have none, so writing a container a function made itself
// writes no global even when that function also reads one.
import "parser.ab"
import "sema.ab"
import "call_targets.ab"
import "abla/text"

class BootstrapCtStateResult(
    // Per site: the ordinary globals (declaration indexes) its code can reach.
    val reached: array<array<int>>,
    // Per declaration: "" when nothing in the pass's compile-time code can write
    // it, else where something can (`name at source:begin`).
    val writers: array<string>,
    // Whether compile-time code of the pass can change a declaration (an edit or a transform).
    val edits: bool,
    // Per declaration: an ordinary immutable scalar `val` (string, int, bool, …) that no
    // compile-time code of the pass can write: its value is the same wherever it is computed.
    val snapshot: array<bool>
)

// Adds the values of `source` to `target`; true when `target` grew. Both are kept in ascending order (every set here
// starts empty and grows through this function), so a small source is bisected into a large target and inserted in
// place, and a source of comparable size is merged by one linear scan; the sets reach thousands of origins (#1022).
fun bootstrapCtStateMerge(var target: array<int>, source: array<int>): bool {
    if (source.size == 0) return false
    if (target.size == 0) {
        for (value in source) target.append(value)
        return true
    }
    if (source.size * 16 <= target.size) {
        var changed = false
        for (value in source) {
            var low = 0
            var high = target.size
            while (low < high) {
                val middle = (low + high) / 2
                if (target[middle] < value) low = middle + 1 else high = middle
            }
            if (low >= target.size || target[low] != value) {
                target.append(value)
                var shift = target.size - 1
                while (shift > low) {
                    target[shift] = target[shift - 1]
                    shift = shift - 1
                }
                target[low] = value
                changed = true
            }
        }
        return changed
    }
    // Is every value of the source already there?
    var grows = false
    var at = 0
    for (value in source) {
        while (at < target.size && target[at] < value) at = at + 1
        if (at >= target.size || target[at] != value) {
            grows = true
            break
        }
    }
    if (!grows) return false
    // In place, from the back: count what the source adds, grow the target by that much, then fill it from its end
    // (no second array built and copied back: #1022, most of the write analysis's time was its merges).
    var added = 0
    var left = 0
    var right = 0
    while (right < source.size) {
        while (left < target.size && target[left] < source[right]) left = left + 1
        if (left >= target.size || target[left] != source[right]) added = added + 1
        right = right + 1
    }
    var old = target.size - 1
    var grow = 0
    while (grow < added) {
        target.append(0)
        grow = grow + 1
    }
    var write = target.size - 1
    right = source.size - 1
    while (right >= 0) {
        if (old >= 0 && target[old] > source[right]) {
            target[write] = target[old]
            old = old - 1
        } else {
            if (old >= 0 && target[old] == source[right]) old = old - 1
            target[write] = source[right]
            right = right - 1
        }
        write = write - 1
    }
    true
}

/** Adds `value` to the sorted set `target` (bootstrapCtStateMerge of one value, without making an array of it). */
fun bootstrapCtStateInsert(var target: array<int>, value: int): bool {
    var low = 0
    var high = target.size
    while (low < high) {
        val middle = (low + high) / 2
        if (target[middle] < value) low = middle + 1 else high = middle
    }
    if (low < target.size && target[low] == value) return false
    target.append(value)
    var shift = target.size - 1
    while (shift > low) {
        target[shift] = target[shift - 1]
        shift = shift - 1
    }
    target[low] = value
    true
}

/** The union of two sorted sets, as a new one (neither is changed). */
fun bootstrapCtStateUnion(first: array<int>, second: array<int>): array<int> {
    // Made at its largest size and cut down: no growth while it is filled.
    val result = filledArray(first.size + second.size, 0)
    var size = 0
    var left = 0
    var right = 0
    while (left < first.size || right < second.size) {
        if (right >= second.size || (left < first.size && first[left] < second[right])) {
            result[size] = first[left]
            left = left + 1
        } else if (left >= first.size || second[right] < first[left]) {
            result[size] = second[right]
            right = right + 1
        } else {
            result[size] = first[left]
            left = left + 1
            right = right + 1
        }
        size = size + 1
    }
    result.truncate(size)
    result
}

fun bootstrapCtStateCopy(values: array<int>): array<int> {
    val result = filledArray(values.size, 0)
    var index = 0
    while (index < values.size) {
        result[index] = values[index]
        index = index + 1
    }
    result
}

// Whether a declared type is a scalar or a string.
fun bootstrapCtStateImmutableType(type: string): bool =
    type == "int" || type == "bool" || type == "string" || type == "char" ||
    type == "f32" || type == "f64" || type == "i8" || type == "u8" || type == "i16" ||
    type == "u16" || type == "i32" || type == "u32" || type == "i64" || type == "u64"

// Whether a global of this type (or, when it is inferred, with this initializer) holds a
// scalar or string: a value that cannot be aliased or written in place.
fun bootstrapCtStateImmutable(type: string, initializer: BootstrapExpression): bool {
    val kind = initializer.kind
    if (bootstrapCtStateImmutableType(type)) return true
    (type == "" || type == "inferred") &&
        (kind == "integer" || kind == "string" || kind == "float" || kind == "float32" ||
         kind == "char" || kind == "true" || kind == "false" || kind == "string.template")
}

// The compiler API functions that change a declaration: an edit, a transform, an added
// field, conformance or interface.
fun bootstrapCtStateEditsDeclarations(name: string): bool =
    name == "compilerReplaceFunctionBody" || name == "compilerApplyTransform" ||
    name == "compilerAddFunctionAnnotation" || name == "compilerAddExtensionField" ||
    name == "compilerRemoveExtensionField" || name == "compilerDeclareInterface" ||
    name == "compilerAddConformance" || name == "compilerExportFunction" ||
    name == "compilerInternalFunction" || name == "compilerRequiredInternalFunction" ||
    name == "compilerExportCheckedFunction" || name == "compilerInstantiate" ||
    name == "compilerGenerateModule"

fun bootstrapCtStateMutator(name: string): bool =
    name == "append" || name == "takeAt" || name == "truncate" || name == "clear" ||
    name == "set" || name == "remove" || name == "take" || name == "removeAt" ||
    name == "removeLast" || name == "removeFirst" || name == "insert" || name == "push" ||
    name == "pop" || name == "sort" || name == "reverse" || name == "fill" ||
    name == "swap" || name == "addAll" || name == "extend" || name == "put" ||
    name == "delete" || name == "retain" || name == "removeIf" || name == "sortBy" ||
    name == "shuffle" || name == "setAt" || name == "resize" || name == "replace"

class BootstrapCtState(
    val declarations: array<BootstrapDeclaration>,
    // Per declaration: whether it is the standard library's.
    val library: array<bool>,
    // Items: 0..declarations.size-1 are the declarations (a value's item is its
    // initializer), then every method, then one per site.
    val itemDeclaration: array<int>,
    val itemMethod: array<int>,
    val byName: Map<string, array<int>>,
    val itemSource: array<string>,
    val itemLibrary: array<bool>,
    val reachedItems: array<bool>,
    val itemGlobals: array<array<int>>,
    val itemCallees: array<array<int>>,
    val globalTaint: array<array<int>>,
    val variables: Map<string, array<int>>,
    val returns: array<array<int>>,
    val fields: Map<string, array<int>>,
    val elements: array<int>,
    val writers: array<string>,
    val ordinary: array<bool>,
    // Per declaration: whether a value of its type can alias heap (not a scalar or string).
    val component: array<bool>,
    var changed: bool,
    var editing: bool,
    var current: int,
    val scope: array<string>,
    val lambdaValues: array<array<int>>,
    // Locals bound by a delegate (`val x by D(...)`), keyed "item:name".
    val delegatedLocals: Map<string, bool>,
    // The type checker's resolved targets of member calls on a class receiver, and the
    // receiver types with a single static implementation (as ct_jit.ab's reach uses them).
    val methodTargets: BootstrapResolvedMethodTargets,
    val concrete: Map<string, bool>,
    // Field names every declaration of which (a class's constructor field, an extension field) has a scalar or
    // string type, and `size` when no class declares a field of that name (#829): such a field's value is no part
    // of any global's heap, so storing into it or reading it carries no origins.
    val scalarFields: Map<string, bool>,
    // Locals ("item:name") the checker typed as a scalar or a string (#829): what is assigned to them carries no origins.
    val scalarLocals: Map<string, bool>,
    // Field names every declaration of which has type array<T> with T a scalar or a string (#829).
    val scalarArrayFields: Map<string, bool>,
    // What each item must be walked again for (#1022): an item is walked when something it reads changed. Per item: whether
    // it is waiting for a walk; per declaration the items that read its taint; per item the items that call it (read its
    // returns); the items that read each field name, and the elements.
    val dirty: array<bool>,
    val globalReaders: array<array<int>>,
    val callers: array<array<int>>,
    val fieldReaders: Map<string, array<int>>,
    val elementReaders: array<int>
) {
    fun variable(name: string): array<int> =
        bootstrapCtStateCopy(this.variables.get("${this.current}:$name") ?? [])

    fun markDirty(item: int): void {
        this.dirty[item] = true
        return
    }

    fun markReaders(items: array<int>): void {
        for (reader in items) this.dirty[reader] = true
        return
    }

    fun markGlobalReaders(declaration: int): void {
        for (reader in this.globalReaders[declaration]) this.dirty[reader] = true
        return
    }

    fun markCallers(item: int): void {
        for (caller in this.callers[item]) this.dirty[caller] = true
        return
    }

    fun markElementReaders(): void {
        for (reader in this.elementReaders) this.dirty[reader] = true
        return
    }

    // A change to what `item` knows about its parameters (or `this`, or a local): it is walked again.
    fun mergeVariable(item: int, key: string, taint: array<int>): void {
        val existing = this.variables.get(key) ?? []
        if (bootstrapCtStateMerge(existing, taint)) {
            this.changed = true
            this.dirty[item] = true
        }
        this.variables.set(key, existing)
        return
    }

    fun bind(name: string, taint: array<int>): void {
        this.mergeVariable(this.current, "${this.current}:$name", taint)
        return
    }

    fun bound(name: string): bool {
        var index = this.scope.size
        while (index > 0) {
            index = index - 1
            if (this.scope[index] == name) return true
        }
        false
    }

    fun reach(item: int): void {
        if (!this.reachedItems[item]) {
            this.reachedItems[item] = true
            this.changed = true
            this.dirty[item] = true
        }
        bootstrapCtStateInsert(this.itemCallees[this.current], item)
        // The caller reads the callee's returns.
        bootstrapCtStateInsert(this.callers[item], this.current)
        return
    }

    // The current item reads the field `name`.
    fun noteFieldRead(name: string): void {
        val readers = this.fieldReaders.get(name) ?? []
        bootstrapCtStateInsert(readers, this.current)
        this.fieldReaders.set(name, readers)
        return
    }

    fun storeField(name: string, taint: array<int>): void {
        if (this.scalarFields.get(name) ?? false) return
        val existing = this.fields.get(name) ?? []
        if (bootstrapCtStateMerge(existing, taint)) {
            this.changed = true
            this.markReaders(this.fieldReaders.get(name) ?? [])
        }
        this.fields.set(name, existing)
        return
    }

    // The current item reads the elements.
    fun noteElementsRead(): void {
        bootstrapCtStateInsert(this.elementReaders, this.current)
        return
    }

    fun storeElement(taint: array<int>): void {
        if (bootstrapCtStateMerge(this.elements, taint)) {
            this.changed = true
            this.markElementReaders()
        }
        return
    }

    fun write(origins: array<int>, node: BootstrapExpression): void {
        for (global in origins) {
            if (global >= 0 && global < this.writers.size && this.writers[global] == "") {
                this.writers[global] =
                    "${this.itemName(this.current)} at ${this.itemSource[this.current]}:${node.begin}"
                this.changed = true
            }
        }
        return
    }

    fun itemName(item: int): string {
        if (item < this.declarations.size) return this.declarations[item].name
        val declaration = this.itemDeclaration[item]
        if (declaration < 0) return "compile-time site"
        val method = this.itemMethod[item]
        if (method < 0) this.declarations[declaration].name
        else "${this.declarations[declaration].name}.${this.declarations[declaration].methods[method].name}"
    }

    // The items a name can denote as a callable or value, visible from the current body.
    fun candidates(name: string): array<int> {
        val found = bootstrapCtStateCopy(this.byName.get(name) ?? [])
        if (!this.itemLibrary[this.current]) return found
        val visible: array<int> = []
        for (item in found) {
            val declaration = this.itemDeclaration[item]
            if (declaration >= 0 && this.library[declaration]) visible.append(item)
        }
        visible
    }

    // The one item a member call resolves to by the checker's facts, else -1: every candidate
    // stays. The target must be present among `known` and not generic, and either an extension
    // function, which is bound statically whatever its receiver (`secretU64.minus`, #828), or a
    // method of a class receiver with a single implementation.
    fun exactTarget(expression: BootstrapExpression, known: array<int>): int {
        val fact = this.methodTargets.find(this.itemSource[this.current], expression)
        if (fact < 0) return -1
        val selected = this.methodTargets.targets[fact]
        if (selected.target < 0 || selected.identity == "") return -1
        val concrete = this.concrete.get(selected.receiver) ?? false
        for (item in known) {
            if (item == selected.target) {
                val declaration = this.itemDeclaration[item]
                if (declaration < 0) return -1
                val owner = this.declarations[declaration]
                val method = this.itemMethod[item]
                val extension = method < 0 && owner.extensionOwner != ""
                if (!concrete && !extension) return -1
                val target = if (method < 0) owner else owner.methods[method]
                val identity = if (method < 0) bootstrapResolvedDeclarationIdentity(owner)
                    else bootstrapResolvedDeclarationIdentity(target, owner.sourceIdentity)
                if (target.typeParameters.size > 0 || identity != selected.identity) return -1
                return item
            }
        }
        -1
    }

    // Whether the body being walked is a generic function's instantiation (`go__abla_generic_B`).
    fun inGenericInstantiation(): bool {
        val declaration = this.itemDeclaration[this.current]
        declaration >= 0 && bootstrapTextContains(this.declarations[declaration].name, "__abla_generic_")
    }

    // What the checker found for a binary arithmetic operator node: -2 the built-in operator
    // of scalar or string operands (no user function runs), an item when it resolved the node
    // to one operator function of a class with a single implementation, else -1 (every
    // implementation of the name stays a candidate).
    fun operatorFact(expression: BootstrapExpression, known: array<int>): int {
        val fact = this.methodTargets.find(this.itemSource[this.current], expression)
        if (fact < 0) return -1
        val selected = this.methodTargets.targets[fact]
        if (selected.target == bootstrapBuiltinOperatorTarget() && selected.identity == "builtin") {
            // Not inside a generic instantiation: that copy's operands were seen with one
            // type argument, and a use whose instantiation the checker never saw would be
            // narrowed on its word alone.
            if (this.inGenericInstantiation()) return -1
            return -2
        }
        this.exactTarget(expression, known)
    }

    // Whether the checker found the local declared by `expression` to be a scalar or a string: nothing is dropped at the end
    // of its scope, so no drop is reached for it (#813). Not inside a generic instantiation: its copies were seen with
    // one type argument each, and a copy the checker never saw would be narrowed on another copy's word.
    fun localHasNoDrop(expression: BootstrapExpression): bool {
        if (this.inGenericInstantiation()) return false
        val fact = this.methodTargets.find(this.itemSource[this.current], expression)
        if (fact < 0) return false
        val selected = this.methodTargets.targets[fact]
        selected.target == bootstrapBuiltinOperatorTarget() && selected.identity == "builtin"
    }

    // The methods and extension functions of a name, from any module: a member call, an operator
    // or a drop reaches a user type's implementation even when library code makes the call (a
    // generic bound, a callback by name).
    fun methodCandidates(name: string): array<int> {
        val found: array<int> = []
        for (item in this.byName.get(name) ?? []) {
            if (item >= this.declarations.size || this.declarations[item].extensionOwner != "") {
                found.append(item)
            }
        }
        found
    }

    // A call the source does not write as one (an operator function, an index or delegate
    // accessor, a drop): every implementation of `name`, with the operands as its receiver and
    // arguments.
    fun implicitCall(name: string, taints: array<array<int>>): array<int> =
        this.implicitCallOn(this.methodCandidates(name), taints)

    // The same call, to `items` alone.
    fun implicitCallOn(items: array<int>, taints: array<array<int>>): array<int> {
        val result: array<int> = []
        for (item in items) {
            this.reach(item)
            if (taints.size > 0) {
                this.mergeVariable(item, "$item:this", taints[0])
            }
            this.bindArguments(item, taints, 1)
            bootstrapCtStateMerge(result, this.returns[item])
        }
        result
    }

    fun parameterName(item: int, index: int): string {
        val declaration = this.itemDeclaration[item]
        if (declaration < 0) return ""
        val owner = this.declarations[declaration]
        val method = this.itemMethod[item]
        val target = if (method < 0) owner else owner.methods[method]
        if (index < target.parameters.size) target.parameters[index] else ""
    }

    // A parameter of a scalar or string type takes no origins: such a value is no part of
    // any global's heap, whatever it was computed from (`bnLoad(address: int)` reached with
    // an offset derived from a global does not make its raw load write that global, #828).
    fun parameterIsValue(item: int, index: int): bool {
        val declaration = this.itemDeclaration[item]
        if (declaration < 0) return false
        val owner = this.declarations[declaration]
        val method = this.itemMethod[item]
        val target = if (method < 0) owner else owner.methods[method]
        index < target.parameterTypes.size &&
            bootstrapCtStateImmutableType(bootstrapNormalizeType(target.parameterTypes[index]))
    }

    fun bindArguments(item: int, taints: array<array<int>>, from: int): void {
        var index = 0
        while (from + index < taints.size) {
            val name = this.parameterName(item, index)
            if (name != "" && !this.parameterIsValue(item, index)) {
                this.mergeVariable(item, "$item:$name", taints[from + index])
            }
            index = index + 1
        }
        return
    }

    fun union(taints: array<array<int>>): array<int> {
        val result: array<int> = []
        for (taint in taints) bootstrapCtStateMerge(result, taint)
        result
    }

    fun isValue(kind: string): bool = bootstrapDeclarationIsValue(kind)

    // What `expression` may alias; its writes and stores are recorded as it goes.
    fun evaluate(expression: BootstrapExpression): array<int> {
        val kind = expression.kind
        val children = expression.children
        if (kind == "identifier") return this.evaluateIdentifier(expression)
        if (kind == "string" || kind == "integer" || kind == "float" || kind == "float32" ||
            kind == "char" || kind == "true" || kind == "false" || kind == "null" ||
            kind == "type" || kind == "missing" || kind == "invalid") return []
        if (kind == "assign") {
            val value = this.evaluate(children[0])
            if (this.bound(expression.text)) {
                val scalarLocal = this.scalarLocals.get("${this.current}:${expression.text}") ?? false
                // A local bound by a delegate assigns through its setValue.
                if ((this.delegatedLocals.get("${this.current}:${expression.text}") ?? false) ==
                    true) {
                    val place = this.variable(expression.text)
                    this.write(place, expression)
                    this.implicitCall("setValue", [place, value])
                }
                if (!scalarLocal) this.bind(expression.text, value)
            } else {
                for (item in this.candidates(expression.text)) {
                    if (item < this.declarations.size &&
                        this.isValue(this.declarations[item].kind)) {
                        this.noteGlobal(item)
                        if (this.ordinary[item]) this.write([item], expression)
                        if (this.declarations[item].expression.kind == "delegate.initializer") {
                            // A delegated global assigns through its setValue.
                            this.implicitCall("setValue",
                                [bootstrapCtStateCopy(this.globalTaint[item]), value])
                        }
                        if (bootstrapCtStateMerge(this.globalTaint[item], value)) {
                            this.changed = true
                            this.markGlobalReaders(item)
                        }
                    }
                }
            }
            return []
        }
        if (kind == "member" && children.size > 0) {
            val result = this.evaluate(children[0])
            if (this.scalarFields.get(expression.text) ?? false) return []
            this.noteFieldRead(expression.text)
            bootstrapCtStateMerge(result, this.fields.get(expression.text) ?? [])
            return result
        }
        if (kind == "member.assign" && children.size > 1) {
            val receiver = this.evaluate(children[0])
            val value = this.evaluate(children[1])
            this.write(receiver, expression)
            this.storeField(expression.text, value)
            return []
        }
        if (kind == "index" && children.size > 1) {
            if (this.scalarElements(children[0])) {
                this.evaluate(children[0])
                this.evaluate(children[1])
                return []
            }
            val result = this.evaluate(children[0])
            this.evaluate(children[1])
            this.noteElementsRead()
            bootstrapCtStateMerge(result, this.elements)
            return result
        }
        if (kind == "index.assign" && children.size > 2) {
            val base = this.evaluate(children[0])
            this.evaluate(children[1])
            val value = this.evaluate(children[2])
            this.write(base, expression)
            this.storeElement(value)
            return []
        }
        if (kind == "member.call" && children.size > 0) return this.evaluateMemberCall(expression)
        if (kind == "call") return this.evaluateCall(expression)
        if (kind == "call.value") return this.evaluateValueCall(expression)
        if (kind == "lambda") return this.evaluateLambda(expression, [])
        if (kind == "block") {
            val mark = this.scope.size
            var value: array<int> = []
            for (statement in children) value = this.evaluate(statement)
            this.scope.truncate(mark)
            return bootstrapCtStateCopy(value)
        }
        if (kind == "local.val" || kind == "local.var") {
            val value = if (children.size > 0) this.evaluate(children[0]) else []
            this.scope.append(expression.text)
            // A local the checker typed as a scalar or a string takes no origins, now or when assigned (#829).
            val scalar = this.localHasNoDrop(expression)
            if (scalar) this.scalarLocals.set("${this.current}:${expression.text}", true)
            this.bind(expression.text, if (scalar) [] else value)
            if (children.size > 0 && children[0].kind == "delegate.initializer") {
                this.delegatedLocals.set("${this.current}:${expression.text}", true)
                // Reading it calls getValue; it is dropped with its scope.
                this.implicitCall("getValue", [bootstrapCtStateCopy(value)])
            }
            // A resource local is dropped at its scope's end (its drop is reached, not given a receiver).
            if (!this.localHasNoDrop(expression)) this.implicitCall("drop", [])
            return []
        }
        if (kind == "for" && children.size > 1) {
            val source = this.evaluate(children[0])
            val mark = this.scope.size
            val name = bootstrapForName(expression)
            this.scope.append(name)
            this.noteElementsRead()
            val element = bootstrapCtStateUnion(source, this.elements)
            this.bind(name, if (this.scalarElements(children[0])) [] else element)
            this.evaluate(children[1])
            this.scope.truncate(mark)
            return []
        }
        if (kind == "return") {
            val value = if (children.size > 0) this.evaluate(children[0]) else []
            if (this.lambdaValues.size > 0) {
                bootstrapCtStateMerge(this.lambdaValues[this.lambdaValues.size - 1], value)
            } else if (bootstrapCtStateMerge(this.returns[this.current], value)) {
                this.changed = true
                this.markCallers(this.current)
            }
            return []
        }
        if (kind == "string.template") {
            for (child in children) this.evaluate(child)
            return []
        }
        // A comparison, a boolean operator or a type test gives a bool: no part of any global's heap (#829).
        if (kind == "==" || kind == "!=" || kind == "<" || kind == "<=" || kind == ">" || kind == ">=" ||
            kind == "&&" || kind == "||" || kind == "unary!" || kind == "is") {
            for (child in children) this.evaluate(child)
            return []
        }
        // Operator functions, and delegate reads and writes, are calls the source does not write.
        val operator = bootstrapOperatorFunctionName(kind)
        if (operator != "") {
            val operands: array<array<int>> = []
            for (child in children) operands.append(this.evaluate(child))
            val result = this.union(operands)
            val known = this.methodCandidates(operator)
            val fact = this.operatorFact(expression, known)
            // The built-in operator of scalar or string operands (-2) gives a scalar or a fresh string (#829).
            if (fact == -2) return []
            if (fact >= 0) bootstrapCtStateMerge(result, this.implicitCallOn([fact], operands))
            else bootstrapCtStateMerge(result, this.implicitCallOn(known, operands))
            return result
        }
        if (kind == "delegate.assign" && children.size > 1) {
            val place = this.evaluate(children[0])
            val value = this.evaluate(children[1])
            this.write(place, expression)
            this.implicitCall("setValue", [place, value])
            return []
        }
        if (kind == "delegate.project" && children.size > 0) {
            val place = this.evaluate(children[0])
            val result = bootstrapCtStateCopy(place)
            bootstrapCtStateMerge(result, this.implicitCall("getValue", [place]))
            return result
        }
        if (kind == "array") {
            val elements: array<int> = []
            for (child in children) bootstrapCtStateMerge(elements, this.evaluate(child))
            this.storeElement(elements)
            return []
        }
        // Anything else: the union of its parts (a value may alias any of them), with
        // each part's own writes recorded.
        val result: array<int> = []
        for (child in children) bootstrapCtStateMerge(result, this.evaluate(child))
        result
    }

    fun noteGlobal(declaration: int): void {
        bootstrapCtStateInsert(this.itemGlobals[this.current], declaration)
        // The current item reads the declaration's taint.
        bootstrapCtStateInsert(this.globalReaders[declaration], this.current)
        this.reach(declaration)
        return
    }

    // Whether `expression` is an array whose declared element type is a scalar or a string: a global, a parameter or a
    // field declared `array<T>` (#829). An element read from it, or a `for` over it, gives no origins.
    fun scalarElements(expression: BootstrapExpression): bool {
        if (expression.kind == "identifier") {
            if (this.bound(expression.text)) {
                val declaration = this.itemDeclaration[this.current]
                if (declaration < 0) return false
                val owner = this.declarations[declaration]
                val method = this.itemMethod[this.current]
                val target = if (method < 0) owner else owner.methods[method]
                var index = 0
                while (index < target.parameters.size) {
                    if (target.parameters[index] == expression.text) {
                        return index < target.parameterTypes.size &&
                            bootstrapCtStateScalarArrayType(target.parameterTypes[index])
                    }
                    index = index + 1
                }
                return false
            }
            var found = false
            var all = true
            for (item in this.candidates(expression.text)) {
                if (item < this.declarations.size && this.isValue(this.declarations[item].kind)) {
                    found = true
                    if (!bootstrapCtStateScalarArrayType(this.declarations[item].resultType)) all = false
                }
            }
            return found && all
        }
        if (expression.kind == "member") return this.scalarArrayFields.get(expression.text) ?? false
        false
    }

    fun evaluateIdentifier(expression: BootstrapExpression): array<int> {
        val name = expression.text
        if (this.bound(name)) {
            val held = this.variable(name)
            if ((this.delegatedLocals.get("${this.current}:$name") ?? false) == true) {
                bootstrapCtStateMerge(held, this.implicitCall("getValue",
                    [bootstrapCtStateCopy(held)]))
            }
            return held
        }
        val result: array<int> = []
        for (item in this.candidates(name)) {
            if (item < this.declarations.size) {
                val declaration = this.declarations[item]
                if (this.isValue(declaration.kind)) {
                    this.noteGlobal(item)
                    if (this.component[item]) bootstrapCtStateInsert(result, item)
                    bootstrapCtStateMerge(result, this.globalTaint[item])
                    if (declaration.expression.kind == "delegate.initializer") {
                        // Reading a delegated global calls its getValue.
                        bootstrapCtStateMerge(result, this.implicitCall("getValue",
                            [bootstrapCtStateCopy(result)]))
                    }
                } else if (declaration.kind == "extern") {
                    if (bootstrapCtStateEditsDeclarations(declaration.name)) this.editing = true
                } else if ((declaration.kind == "fun" || declaration.kind == "compile.fun") &&
                    declaration.extensionOwner == "") {
                    // A function used as a value is called by code this analysis
                    // does not connect to it: its body is part of the pass.
                    this.reach(item)
                }
            }
        }
        result
    }

    // The origins of the arguments an extern call can write through: those whose parameter, in some declaration
    // of that name, is not a scalar or a string.
    fun writableArguments(taints: array<array<int>>, externs: array<int>): array<array<int>> {
        val writable: array<array<int>> = []
        var index = 0
        while (index < taints.size) {
            var scalar = true
            for (item in externs) {
                val types = this.declarations[item].parameterTypes
                if (index >= types.size || !bootstrapCtStateImmutableType(bootstrapNormalizeType(types[index]))) scalar = false
            }
            if (!scalar) writable.append(taints[index])
            index = index + 1
        }
        writable
    }

    fun evaluateArguments(expression: BootstrapExpression, from: int): array<array<int>> {
        val taints: array<array<int>> = []
        var index = from
        while (index < expression.children.size) {
            taints.append(this.evaluate(expression.children[index]))
            index = index + 1
        }
        taints
    }

    fun lambdaArgument(expression: BootstrapExpression, from: int): bool {
        var index = from
        while (index < expression.children.size) {
            if (expression.children[index].kind == "lambda") return true
            index = index + 1
        }
        false
    }

    fun evaluateLambda(expression: BootstrapExpression, parameters: array<int>): array<int> {
        val mark = this.scope.size
        val values: array<int> = []
        this.lambdaValues.append(values)
        var value: array<int> = []
        var index = 0
        while (index < expression.children.size) {
            val child = expression.children[index]
            if (index == expression.children.size - 1) {
                value = this.evaluate(child)
            } else {
                this.scope.append(child.text)
                this.bind(child.text, parameters)
            }
            index = index + 1
        }
        this.lambdaValues.truncate(this.lambdaValues.size - 1)
        this.scope.truncate(mark)
        bootstrapCtStateMerge(value, values)
        bootstrapCtStateCopy(value)
    }

    // A lambda handed to a call this analysis cannot follow is called with whatever
    // the call's other values reach.
    fun evaluateArgumentsWith(
        expression: BootstrapExpression,
        from: int,
        parameters: array<int>
    ): array<array<int>> {
        val taints: array<array<int>> = []
        var index = from
        while (index < expression.children.size) {
            val child = expression.children[index]
            taints.append(if (child.kind == "lambda") this.evaluateLambda(child, parameters)
                else this.evaluate(child))
            index = index + 1
        }
        taints
    }

    fun evaluateMemberCall(expression: BootstrapExpression): array<int> {
        val receiver = this.evaluate(expression.children[0])
        val name = expression.text
        var known = this.methodCandidates(name)
        val exact = this.exactTarget(expression, known)
        if (exact >= 0) known = [exact]
        // The receiver and the elements, built once (#1022: copying the receiver, merging the elements into the copy and
        // copying that again for the result was most of the write analysis). It is the result: the arguments are
        // evaluated (a lambda argument's parameters merged from it) before anything is added to it.
        this.noteElementsRead()
        val result = bootstrapCtStateUnion(receiver, this.elements)
        val mutator = bootstrapCtStateMutator(name)
        val taints = if (known.size == 0 || mutator)
            this.evaluateArgumentsWith(expression, 1, result)
            else this.evaluateArguments(expression, 1)
        if (known.size == 0 || mutator) {
            val arguments = this.union(taints)
            if (mutator) {
                this.write(receiver, expression)
                this.storeElement(arguments)
            }
            bootstrapCtStateMerge(result, arguments)
        }
        for (item in known) {
            this.reach(item)
            this.mergeVariable(item, "$item:this", receiver)
            this.bindArguments(item, taints, 0)
            bootstrapCtStateMerge(result, this.returns[item])
        }
        result
    }

    fun evaluateCall(expression: BootstrapExpression): array<int> {
        val name = expression.text
        val children = expression.children
        if (this.bound(name)) {
            // A closure held in a local, called by value.
            val callee = this.variable(name)
            val taints = this.evaluateArguments(expression, 0)
            val arguments = this.union(taints)
            this.write(arguments, expression)
            bootstrapCtStateMerge(callee, arguments)
            return callee
        }
        val callables: array<int> = []
        var constructor = -1
        var foreign = false
        val externs: array<int> = []
        for (item in this.candidates(name)) {
            if (item < this.declarations.size) {
                val declaration = this.declarations[item]
                if (declaration.kind == "class") constructor = item
                else if (declaration.kind == "extern") {
                    foreign = true
                    externs.append(item)
                    if (bootstrapCtStateEditsDeclarations(declaration.name)) this.editing = true
                }
                else if ((declaration.kind == "fun" || declaration.kind == "compile.fun") &&
                    declaration.extensionOwner == "") callables.append(item)
                else if (this.isValue(declaration.kind)) {
                    // A global holding a function, called by value.
                    this.noteGlobal(item)
                }
            }
        }
        val taints = this.evaluateArguments(expression, 0)
        val arguments = this.union(taints)
        val result: array<int> = []
        if (constructor >= 0) {
            this.reach(constructor)
            if (this.declarations[constructor].isResource) this.implicitCall("drop", [[]])
            var index = 0
            while (index < taints.size) {
                val field = this.parameterName(constructor, index)
                if (field != "") this.storeField(field, taints[index])
                index = index + 1
            }
        }
        for (item in callables) {
            this.reach(item)
            this.bindArguments(item, taints, 0)
            bootstrapCtStateMerge(result, this.returns[item])
        }
        if (foreign || (constructor < 0 && callables.size == 0)) {
            // A foreign or built-in function: it may write what it is given, and
            // its result may be part of it.
            // An argument of a scalar or string type is a value the callee cannot write through, whatever it was
            // read from (a string field of a global does not make the global written).
            if (foreign) this.write(this.union(this.writableArguments(taints, externs)), expression)
            // An extern that returns a scalar or a string returns no part of what it was given.
            var scalarResult = foreign
            for (item in externs) {
                if (!bootstrapCtStateImmutableType(bootstrapNormalizeType(this.declarations[item].resultType))) scalarResult = false
            }
            // An extern's result can be part of an argument it could write through, never of a scalar or string one (#829).
            if (!scalarResult) bootstrapCtStateMerge(result,
                if (foreign) this.union(this.writableArguments(taints, externs)) else arguments)
        }
        result
    }

    fun evaluateValueCall(expression: BootstrapExpression): array<int> {
        val callee = if (expression.children.size > 0) this.evaluate(expression.children[0]) else []
        val taints = this.evaluateArguments(expression, 1)
        val arguments = this.union(taints)
        this.write(arguments, expression)
        bootstrapCtStateMerge(callee, arguments)
        callee
    }

    // Walks one item's body: its parameters (and `this`) are the names it binds.
    fun walk(item: int, body: BootstrapExpression): void {
        this.current = item
        this.scope.truncate(0)
        val declaration = this.itemDeclaration[item]
        if (declaration >= 0) {
            val owner = this.declarations[declaration]
            val method = this.itemMethod[item]
            val target = if (method < 0) owner else owner.methods[method]
            if (method >= 0 || owner.extensionOwner != "") this.scope.append("this")
            for (name in target.parameters) this.scope.append(name)
            for (parameterDefault in target.parameterDefaults) this.evaluate(parameterDefault)
        }
        val value = this.evaluate(body)
        if (item < this.declarations.size && this.isValue(this.declarations[item].kind)) {
            if (bootstrapCtStateMerge(this.globalTaint[item], value)) {
                this.changed = true
                this.markGlobalReaders(item)
            }
        } else if (bootstrapCtStateMerge(this.returns[item], value)) {
            this.changed = true
            this.markCallers(item)
        }
        return
    }
}

fun bootstrapCtStateAnalyze(
    declarations: array<BootstrapDeclaration>,
    library: array<bool>,
    siteExpressions: array<BootstrapExpression>,
    siteSources: array<string>,
    siteNodes: array<BootstrapExpression>,
    siteTypes: array<string>,
    methodTargets: BootstrapResolvedMethodTargets = bootstrapResolvedMethodTargets()
): BootstrapCtStateResult {
    val itemDeclaration: array<int> = []
    val itemMethod: array<int> = []
    val byName: Map<string, array<int>> = Map()
    val itemBody: array<BootstrapExpression> = []
    val itemSource: array<string> = []
    val itemLibrary: array<bool> = []
    val ordinary: array<bool> = []
    val component: array<bool> = []
    val writers: array<string> = []
    var index = 0
    while (index < declarations.size) {
        val declaration = declarations[index]
        itemDeclaration.append(index)
        itemMethod.append(-1)
        itemBody.append(declaration.expression)
        itemSource.append(declaration.sourceIdentity)
        itemLibrary.append(library[index])
        ordinary.append((declaration.kind == "val" || declaration.kind == "var") &&
            !bootstrapTextContains(declaration.sourceIdentity, "/abla/runtime/"))
        // `val X = #site` has the site's type.
        var declaredType = declaration.resultType
        if ((declaredType == "" || declaredType == "inferred") && declaration.expression.kind ==
            "compile") {
            var siteIndex = 0
            while (siteIndex < siteNodes.size) {
                if (siteNodes[siteIndex] == declaration.expression) declaredType =
                    siteTypes[siteIndex]
                siteIndex = siteIndex + 1
            }
        }
        component.append(ordinary[index] &&
            (declaration.expression.kind == "delegate.initializer" ||
             !bootstrapCtStateImmutable(declaredType, declaration.expression)))
        writers.append("")
        val list = byName.get(declaration.name) ?? []
        list.append(index)
        byName.set(declaration.name, list)
        index = index + 1
    }
    index = 0
    while (index < declarations.size) {
        var method = 0
        while (method < declarations[index].methods.size) {
            val found = declarations[index].methods[method]
            val item = itemDeclaration.size
            itemDeclaration.append(index)
            itemMethod.append(method)
            itemBody.append(found.expression)
            itemSource.append(if (found.sourceIdentity != "") found.sourceIdentity
                else declarations[index].sourceIdentity)
            itemLibrary.append(library[index])
            val list = byName.get(found.name) ?? []
            list.append(item)
            byName.set(found.name, list)
            method = method + 1
        }
        index = index + 1
    }
    val siteBase = itemDeclaration.size
    var site = 0
    while (site < siteExpressions.size) {
        itemDeclaration.append(-1)
        itemMethod.append(-1)
        itemBody.append(siteExpressions[site])
        itemSource.append(siteSources[site])
        itemLibrary.append(false)
        site = site + 1
    }
    val count = itemDeclaration.size
    val reachedItems: array<bool> = []
    val itemGlobals: array<array<int>> = []
    val itemCallees: array<array<int>> = []
    val returns: array<array<int>> = []
    val globalTaint: array<array<int>> = []
    index = 0
    while (index < count) {
        reachedItems.append(index >= siteBase)
        itemGlobals.append([])
        itemCallees.append([])
        returns.append([])
        index = index + 1
    }
    index = 0
    while (index < declarations.size) {
        globalTaint.append([])
        index = index + 1
    }
    val concrete: Map<string, bool> = Map()
    for (type in ["string", "i64", "int", "bool", "f32", "f64"]) concrete.set(type, true)
    for (declaration in declarations) {
        if (declaration.kind == "class" && declaration.typeParameters.size == 0) {
            concrete.set(declaration.name, true)
        }
    }
    // Which items wait for a walk: the sites, until their first one; then whatever something they read changed.
    val dirty: array<bool> = []
    val globalReaders: array<array<int>> = []
    val callers: array<array<int>> = []
    index = 0
    while (index < count) {
        dirty.append(reachedItems[index])
        globalReaders.append([])
        callers.append([])
        index = index + 1
    }
    val state = BootstrapCtState(
        declarations, library, itemDeclaration, itemMethod, byName, itemSource,
        itemLibrary, reachedItems, itemGlobals, itemCallees, globalTaint, Map(), returns,
        Map(), [], writers, ordinary, component, true, false, 0, [], [], Map(),
        methodTargets, concrete, bootstrapCtStateScalarFields(declarations), Map(),
        bootstrapCtStateScalarFields(declarations, true), dirty, globalReaders, callers, Map(), []
    )
    // A pass walks the items that wait for a walk (what an item reads is recorded as it is walked, and a change to it
    // marks the item): the walks that would find nothing new are not made (#1022).
    var passes = 0
    var pending = true
    while (pending && passes < 64) {
        var item = 0
        while (item < count) {
            if (state.reachedItems[item] && state.dirty[item]) {
                state.dirty[item] = false
                state.walk(item, itemBody[item])
            }
            item = item + 1
        }
        passes = passes + 1
        pending = false
        item = 0
        while (item < count) {
            if (state.reachedItems[item] && state.dirty[item]) pending = true
            item = item + 1
        }
    }
    // Not converged: no write is ruled out.
    if (pending) {
        var unconverged = 0
        while (unconverged < declarations.size) {
            if (ordinary[unconverged] && writers[unconverged] == "") {
                writers[unconverged] = "the write analysis did not converge"
            }
            unconverged = unconverged + 1
        }
    }
    // What each site reaches: the closure of its references and callees.
    val reached: array<array<int>> = []
    site = 0
    while (site < siteExpressions.size) {
        val seen: array<bool> = []
        index = 0
        while (index < count) {
            seen.append(false)
            index = index + 1
        }
        val pending: array<int> = [siteBase + site]
        seen[siteBase + site] = true
        val globals: array<int> = []
        while (pending.size > 0) {
            val item = pending[pending.size - 1]
            pending.truncate(pending.size - 1)
            for (global in state.itemGlobals[item]) {
                if (state.ordinary[global]) bootstrapCtStateInsert(globals, global)
            }
            for (callee in state.itemCallees[item]) {
                if (!seen[callee]) {
                    seen[callee] = true
                    pending.append(callee)
                }
            }
        }
        reached.append(globals)
        site = site + 1
    }
    val snapshot: array<bool> = []
    index = 0
    while (index < declarations.size) {
        snapshot.append(state.ordinary[index] && !state.component[index] &&
            declarations[index].kind == "val" && state.writers[index] == "")
        index = index + 1
    }
    BootstrapCtStateResult(reached, state.writers, state.editing, snapshot)
}

// Whether a value of `type` may hold a closure: a function type, an unknown or `any` type, an
// interface, or a class with a field that may (searched through constructor parameter types,
// array/map/nullable wrappers, each class once per question: a class met again adds nothing, since the
// first visit either found a closure or is still being searched). Scalars, strings and arrays of them cannot.
fun bootstrapCtStateMayHoldClosure(declarations: array<BootstrapDeclaration>, type: string): bool {
    var visited: Map<string, bool> = Map()
    bootstrapCtStateMayHoldClosureIn(declarations, type, visited)
}

// The search itself; `seen` is the question's set of class names already entered.
fun bootstrapCtStateMayHoldClosureIn(
    declarations: array<BootstrapDeclaration>,
    type: string,
    var seen: Map<string, bool>
): bool {
    val normalized = bootstrapNormalizeType(type)
    if (normalized == "" || normalized == "inferred" || normalized == "any" ||
        normalized == "unknown") return true
    if (bootstrapTextContains(normalized, "->")) return true
    var begin = 0
    var index = 0
    while (index <= normalized.size) {
        val byte = if (index < normalized.size) normalized[index] else 32
        val word = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
            (byte >= 48 && byte <= 57) || byte == 95
        if (!word) {
            if (index > begin) {
                val name = normalized.slice(begin, index)
                val scalar = name == "int" || name == "bool" || name == "string" || name ==
                    "char" ||
                    name == "f32" || name == "f64" || name == "i8" || name == "u8" ||
                    name == "i16" || name == "u16" || name == "i32" || name == "u32" ||
                    name == "i64" || name == "u64" || name == "void" || name == "null" ||
                    name == "array" || name == "map" || name == "set"
                if (!scalar && !(seen.get(name) ?? false)) {
                    seen.set(name, true)
                    for (declaration in declarations) {
                        if (declaration.name == name) {
                            if (declaration.kind == "interface") return true
                            if (declaration.kind == "class") {
                                for (field in declaration.parameterTypes) {
                                    if (bootstrapCtStateMayHoldClosureIn(declarations, field,
                                        seen)) return true
                                }
                            }
                        }
                    }
                }
            }
            begin = index + 1
        }
        index = index + 1
    }
    false
}

// See BootstrapCtState.scalarFields.
// With `arrays`, the field names every declaration of which is array<T> of a scalar or string T instead.
fun bootstrapCtStateScalarFields(declarations: array<BootstrapDeclaration>, arrays: bool = false): Map<string, bool> {
    val scalar: Map<string, bool> = Map()
    for (declaration in declarations) {
        if (bootstrapIsExtensionFieldKind(declaration.kind)) {
            val value = if (arrays) bootstrapCtStateScalarArrayType(declaration.resultType)
                else bootstrapCtStateImmutableType(bootstrapNormalizeType(declaration.resultType))
            scalar.set(declaration.name, (scalar.get(declaration.name) ?? true) && value)
        } else {
            // A class's parameters all count (a non-field one only narrows the set); of another declaration, its
            // `val`/`var` ones (bootstrapRegionHeapFields reads them the same way). A function has no fields.
            var field = 0
            while (field < declaration.parameters.size) {
                val kind = if (field < declaration.parameterKinds.size) declaration.parameterKinds[field] else ""
                if (declaration.kind == "class" || kind == "val" || kind == "var") {
                    val name = declaration.parameters[field]
                    val type = if (field < declaration.parameterTypes.size)
                        bootstrapNormalizeType(declaration.parameterTypes[field]) else ""
                    scalar.set(name, (scalar.get(name) ?? true) &&
                        (if (arrays) bootstrapCtStateScalarArrayType(type) else bootstrapCtStateImmutableType(type)))
                }
                field = field + 1
            }
        }
    }
    if (!arrays && !scalar.has("size")) scalar.set("size", true)
    scalar
}

// array<T> with T a scalar or a string (normalized, `array:T`).
fun bootstrapCtStateScalarArrayType(type: string): bool {
    val normal = bootstrapNormalizeType(type)
    normal.startsWith("array:") && bootstrapCtStateImmutableType(normal.slice(6, normal.size))
}
