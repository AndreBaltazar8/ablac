// The compiler's side of `ablac run --live` (docs/design/live-jit.md): `ablac_live_reload`, which a
// live program reaches through abla/live (`ablaLiveHost()` is its address, the base module's
// `abla_live_host`). It compiles the program's sources again as the next generation, which the live
// pass (src/backend/llvm/live.ab) cuts down to the bodies that changed; refused, nothing is added and
// the program keeps running its code. Applied, the module goes into the program's session and one
// release store publishes a new table array: the old entries with the changed ones replaced and new
// functions appended. Old code is never removed (a thread may still be in it), and nor is an old
// array (a thread may have loaded it).
import "abla/llvm/orc"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/unsafe/native"
import "backend/llvm/core.ab"
import "backend/llvm/bindings.ab"
import "backend/llvm/debug.ab"
import "backend/llvm/live.ab"
import "backend/llvm/live_globals.ab"
import "toolchain.ab"
import "module_paths.ab"
import "abla/text"
import "abla/sys/linux/process"
import "abla/sys/linux/io"
import "sema.ab"
import "ir.ab"

// The running program's session and how it was built, set by bootstrapRunInProcess for a live run.
var bootstrapLiveSession = LlvmOrcSession(nativeNullPointer(), nativeNullPointer(), 128, true)
var bootstrapLiveSource = ""
var bootstrapLivePasses = ""
// Entries in the published array.
var bootstrapLiveTableSize = 0
// A word that is 1 while a reload runs (a second one at the same time is refused).
var bootstrapLiveBusy = 0
// The program's own source files of the last compile, the ones `ablac run --watch` watches (live_watch.ab): set by
// bootstrapRunInProcess and by each reload that compiled.
var bootstrapLiveWatchPaths: array<string> = []

// The paths that are not the standard library's.
fun bootstrapLiveOwnPaths(paths: array<string>): array<string> {
    val root = bootstrapStandardLibraryRoot()
    val own: array<string> = []
    for (path in paths) if (root == "" || !path.startsWith("$root/")) own.append(path)
    own
}

trusted fun bootstrapLiveBegin(session: LlvmOrcSession, source: string, passes: string): void {
    bootstrapLiveSession = session
    bootstrapLiveSource = source
    bootstrapLivePasses = passes
    bootstrapLiveTableSize = bootstrapLlvmLiveTableSize
    bootstrapLiveCodeBytes = 0
    bootstrapLiveNoted = false
    bootstrapLlvmLiveGeneration = 0
    if (bootstrapLiveBusy == 0) bootstrapLiveBusy = nativePointerAddress(ablaUnsafeAllocate(8))
    ablaUnsafeStoreI64(nativePointerFromAddress(bootstrapLiveBusy), 0)
    return
}

// Old generations are never freed (docs/design/live-jit.md, "Freeing old generations": measured, not worth it yet):
// the session counts the objects its reloads added, and once they pass a limit (256 MB; ABLA_LIVE_NOTE_BYTES sets
// another, for the test) says so on standard error, once a session.
var bootstrapLiveCodeBytes = 0
var bootstrapLiveNoted = false

fun bootstrapLiveNoteLimit(): int {
    val configured = linuxEnvironment("ABLA_LIVE_NOTE_BYTES")
    if (configured.found) {
        val bytes = bootstrapDecimalIndex(configured.value)
        if (bytes >= 0) return bytes
    }
    268435456
}

fun bootstrapLiveNoteGrowth(): void {
    if (bootstrapLiveNoted || bootstrapLiveCodeBytes < bootstrapLiveNoteLimit()) return
    bootstrapLiveNoted = true
    val size = if (bootstrapLiveCodeBytes >= 1048576) "${bootstrapLiveCodeBytes / 1048576} MB" else "${bootstrapLiveCodeBytes / 1024} kB"
    linuxPrintStandardError("ablac run: the reloads of this live run have added $size of code, which is never freed; restart the run to give it back\n")
    return
}

// The reply in the program's buffer: its length (8 bytes), then its bytes, as many as fit.
trusted fun bootstrapLiveReply(buffer: int, capacity: int, message: string): void {
    if (buffer == 0 || capacity < 8) return
    val room = capacity - 8
    val length = if (message.size < room) message.size else room
    ablaUnsafeStoreI64(nativePointerFromAddress(buffer), length)
    var index = 0
    while (index < length) {
        ablaUnsafeStoreU8(nativePointerFromAddress(buffer + 8 + index), message[index])
        index = index + 1
    }
    return
}

// 0: applied (the reply names what changed); 1: refused (the reply says why); 2: the program did not
// compile (its diagnostics are on standard error); 3: not available.
@export("ablac_live_reload")
trusted fun bootstrapLiveReloadEntry(buffer: int, capacity: int): int {
    if (bootstrapLiveBusy == 0 || bootstrapLiveSession.status != 0) {
        bootstrapLiveReply(buffer, capacity, "E_LIVE_UNAVAILABLE: no live session")
        return 3
    }
    if (int(ablaUnsafeAtomicCompareExchangeU32(bootstrapLiveBusy, u32(0), u32(1))) != 0) {
        bootstrapLiveReply(buffer, capacity, "E_LIVE_BUSY: another reload is running")
        return 1
    }
    val status = bootstrapLiveReload(buffer, capacity)
    ablaUnsafeAtomicFence()
    ablaUnsafeStoreI64(nativePointerFromAddress(bootstrapLiveBusy), 0)
    status
}

trusted fun bootstrapLiveDisposeHeld(): void {
    if (!pointerIsNull(bootstrapLlvmHeldModule)) LLVMDisposeModule(bootstrapLlvmHeldModule)
    if (!pointerIsNull(bootstrapLlvmHeldContext)) LLVMContextDispose(bootstrapLlvmHeldContext)
    bootstrapLlvmHeldModule = nativeNullPointer()
    bootstrapLlvmHeldContext = nativeNullPointer()
    return
}

trusted fun bootstrapLiveReload(buffer: int, capacity: int): int {
    val generation = bootstrapLlvmLiveGeneration + 1
    val enclosingLive = bootstrapLlvmLiveRun
    bootstrapLlvmLiveRun = true
    bootstrapLlvmLiveGeneration = generation
    bootstrapIrLiveReload = true
    val prepared = bootstrapPrepareRun(bootstrapLiveSource, true)
    bootstrapIrLiveReload = false
    bootstrapLlvmLiveRun = enclosingLive
    if (prepared.status != 0 || pointerIsNull(bootstrapLlvmHeldModule)) {
        bootstrapLlvmLiveGeneration = generation - 1
        bootstrapLiveDisposeHeld()
        bootstrapLiveReply(buffer, capacity,
            "E_LIVE_COMPILE: the program does not compile (its diagnostics are on standard error)")
        return 2
    }
    bootstrapLiveWatchPaths = bootstrapLiveOwnPaths(prepared.sourcePaths)
    if (bootstrapLlvmLiveRefusals.size > 0) {
        bootstrapLlvmLiveGeneration = generation - 1
        bootstrapLiveDisposeHeld()
        var message = ""
        for (refusal in bootstrapLlvmLiveRefusals) message = message + refusal + "\n"
        bootstrapLiveReply(buffer, capacity, message)
        return 1
    }
    if (bootstrapLlvmLiveChangedIndices.size == 0) {
        bootstrapLlvmLiveGeneration = generation - 1
        bootstrapLiveDisposeHeld()
        bootstrapLiveReply(buffer, capacity, "applied: nothing changed")
        return 0
    }
    bootstrapLiveDumpDispatcher(bootstrapLlvmHeldModule, generation)
    val added = bootstrapLiveSession.addModule(bootstrapLlvmHeldContext, bootstrapLlvmHeldModule,
        bootstrapLivePasses)
    bootstrapLlvmHeldContext = nativeNullPointer()
    bootstrapLlvmHeldModule = nativeNullPointer()
    if (added.status != 0) {
        bootstrapLlvmLiveGeneration = generation - 1
        bootstrapLiveReply(buffer, capacity,
            "E_LIVE_LINK: the new code could not be added (status ${added.status})")
        return 2
    }
    // The bodies first: looking one up links the module.
    val addresses: array<int> = []
    for (body in bootstrapLlvmLiveChangedBodies) {
        val found = bootstrapLiveSession.lookupMeasuring(body)
        if (found.status != 0 || found.address == 0) {
            bootstrapLiveReply(buffer, capacity,
                "E_LIVE_LINK: $body was not found (status ${found.status})")
            return 2
        }
        bootstrapLiveCodeBytes = bootstrapLiveCodeBytes + found.bytes
        addresses.append(found.address)
        if (bootstrapLiveTracing()) linuxPrintStandardError("live: generation $generation $body at ${bootstrapLiveHex(found.address)}\n")
    }
    bootstrapLiveNoteGrowth()
    val table = bootstrapLiveSession.lookup("abla_live_table")
    if (table.status != 0 || table.address == 0) {
        bootstrapLiveReply(buffer, capacity, "E_LIVE_LINK: abla_live_table was not found")
        return 2
    }
    val old = ablaUnsafeLoadI64(nativePointerFromAddress(table.address))
    var size = bootstrapLiveTableSize
    for (slot in bootstrapLlvmLiveChangedIndices) if (slot + 1 > size) size = slot + 1
    val entries = nativePointerAddress(ablaUnsafeAllocate(size * 8))
    var slot = 0
    while (slot < size) {
        ablaUnsafeStoreI64(nativePointerFromAddress(entries + slot * 8),
            if (slot < bootstrapLiveTableSize) ablaUnsafeLoadI64(nativePointerFromAddress(old +
                slot * 8)) else 0)
        slot = slot + 1
    }
    var change = 0
    while (change < addresses.size) {
        ablaUnsafeStoreI64(nativePointerFromAddress(entries +
            bootstrapLlvmLiveChangedIndices[change] * 8),
            addresses[change])
        change = change + 1
    }
    // The new variables' initializers (live_globals.ab), once, before the table is published (so code that reads
    // one finds it initialized), with the functions this reload adds published first: an initializer may call one
    // (their slots are past the running table's end, so no running code reaches them), while a redefined function
    // keeps its running body until the table below.
    if (bootstrapLlvmLiveNewGlobalNames.size > 0) {
        val provisional = nativePointerAddress(ablaUnsafeAllocate(size * 8))
        var at = 0
        while (at < size) {
            ablaUnsafeStoreI64(nativePointerFromAddress(provisional + at * 8),
                ablaUnsafeLoadI64(nativePointerFromAddress((if (at < bootstrapLiveTableSize) old else entries) + at * 8)))
            at = at + 1
        }
        ablaUnsafeAtomicFence()
        ablaUnsafeStoreI64(nativePointerFromAddress(table.address), provisional)
        val initializing = bootstrapLiveSession.lookup(bootstrapLlvmLiveGlobalsEntryName(generation))
        if (initializing.status != 0 || initializing.address == 0) {
            ablaUnsafeStoreI64(nativePointerFromAddress(table.address), old)
            bootstrapLiveReply(buffer, capacity,
                "E_LIVE_LINK: the new variables' initializer was not found (status ${initializing.status})")
            return 2
        }
        // A panic in one is contained (the entry's recovery frame): this generation goes, nothing is published, and
        // the program keeps running its code with its variables as they were.
        val panicCapacity = 4096
        val panicBuffer = nativeByteBuffer(panicCapacity)
        panicBuffer.storeI64(0, 0)
        val panicked = ablaUnsafeCallExact_I64_Pointer_I64(initializing.address, panicBuffer.pointerAt(0),
            panicCapacity)
        if (panicked != 0) {
            var length = panicBuffer.loadI64(0)
            if (length < 0) length = 0
            if (length > panicCapacity - 8) length = panicCapacity - 8
            var text = ""
            if (length > 0) {
                val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(length + 1))
                ablaUnsafeCopyMemory(address, ablaUnsafePointerAddress(panicBuffer.pointerAt(8)), length)
                ablaUnsafeStoreU8(nativePointerFromAddress(address + length), 0)
                text = adoptNativeString(address, length)
            }
            panicBuffer.close()
            ablaUnsafeStoreI64(nativePointerFromAddress(table.address), old)
            added.remove()
            bootstrapLlvmLiveGeneration = generation - 1
            bootstrapLiveReply(buffer, capacity,
                "E_LIVE_PANIC: a new variable's initializer panicked (${bootstrapLlvmLiveNewGlobalNames.join(", ")}): ${text.trim()}")
            return 2
        }
        panicBuffer.close()
    }
    // Release: the entries are written before the array is published.
    ablaUnsafeAtomicFence()
    ablaUnsafeStoreI64(nativePointerFromAddress(table.address), entries)
    bootstrapLiveTableSize = size
    // The lambdas this generation added: code that was not redefined finds their dispatchers here.
    if (bootstrapLlvmLiveLambdaNewIds.size > 0) {
        val registry = bootstrapLiveSession.lookup("abla_live_lambdas")
        val call = bootstrapLiveSession.lookup(bootstrapLlvmLiveLambdaCallDispatcher)
        val drop = if (bootstrapLlvmLiveLambdaDropDispatcher == "") 0 else {
            val found = bootstrapLiveSession.lookup(bootstrapLlvmLiveLambdaDropDispatcher)
            if (found.status == 0) found.address else 0
        }
        if (registry.status != 0 || registry.address == 0 || call.status != 0 || call.address ==
            0) {
            bootstrapLiveReply(buffer, capacity,
                "E_LIVE_LINK: the new lambdas' dispatcher was not found")
            return 2
        }
        val previous = ablaUnsafeLoadI64(nativePointerFromAddress(registry.address))
        val known = if (previous == 0) 0 else ablaUnsafeLoadI64(nativePointerFromAddress(previous))
        val total = known + bootstrapLlvmLiveLambdaNewIds.size
        val lambdas = nativePointerAddress(ablaUnsafeAllocate(8 + total * 24))
        ablaUnsafeStoreI64(nativePointerFromAddress(lambdas), total)
        var word = 0
        while (word < known * 3) {
            ablaUnsafeStoreI64(nativePointerFromAddress(lambdas + 8 + word * 8),
                ablaUnsafeLoadI64(nativePointerFromAddress(previous + 8 + word * 8)))
            word = word + 1
        }
        var added = 0
        while (added < bootstrapLlvmLiveLambdaNewIds.size) {
            val at = lambdas + 8 + (known + added) * 24
            // As the dispatchers compare it: the 32-bit id, sign-extended.
            val id = bootstrapLlvmLiveLambdaNewIds[added] & 4294967295
            ablaUnsafeStoreI64(nativePointerFromAddress(at),
                if (id >= 2147483648) id - 4294967296 else id)
            ablaUnsafeStoreI64(nativePointerFromAddress(at + 8), call.address)
            ablaUnsafeStoreI64(nativePointerFromAddress(at + 16), drop)
            if (bootstrapLiveTracing()) linuxPrintStandardError("live: generation $generation registry entry ${known + added}: id ${ablaUnsafeLoadI64(nativePointerFromAddress(at))} (${bootstrapLlvmLiveNewSymbols[added]}), call ${bootstrapLiveHex(call.address)} ($bootstrapLlvmLiveLambdaCallDispatcher), drop ${bootstrapLiveHex(drop)}, registry ${bootstrapLiveHex(registry.address)} -> ${bootstrapLiveHex(lambdas)}\n")
            added = added + 1
        }
        ablaUnsafeAtomicFence()
        ablaUnsafeStoreI64(nativePointerFromAddress(registry.address), lambdas)
    }
    bootstrapLlvmLiveApplied()
    var message = "applied:"
    for (label in bootstrapLlvmLiveChangedLabels) message = message + " " + label
    bootstrapLiveReply(buffer, capacity, message)
    0
}

// Where `ablac run` is live by default (decision #65): an x86-64 Linux host and macOS (arm64 and Intel), where live
// mode is tested (tools/test-live-jit.sh, tools/test-live-watch.sh; the Macs in CI). Elsewhere `run` is as it was
// unless --live asks.
private trusted noescape extern:"intrinsic" fun ablaUnsafeCallExact_I64_Pointer_I64(address: int, buffer: i64*,
    capacity: int): int
private noescape extern:"intrinsic" fun ablaSimdTargetArch(): int
private noescape extern:"intrinsic" fun ablaHostIsMacOS(): bool

fun bootstrapLiveRunSupported(): bool = ablaHostIsMacOS() || ablaSimdTargetArch() == 1

// ABLA_LIVE_TRACE: where the code is, so an address a debugger or a crash report gives can be named (the table's
// entries as loaded, then each reload's bodies, dispatchers and registry entries).
fun bootstrapLiveTracing(): bool = linuxEnvironment("ABLA_LIVE_TRACE").found

fun bootstrapLiveHex(value: int): string {
    val digits = "0123456789abcdef"
    var text = ""
    var rest = value
    if (rest == 0) return "0x0"
    while (rest != 0) {
        text = digits.slice(rest & 15, (rest & 15) + 1) + text
        rest = (rest >> 4) & 1152921504606846975
    }
    "0x$text"
}

trusted fun bootstrapLiveTraceTable(session: LlvmOrcSession): void {
    if (!bootstrapLiveTracing()) return
    val table = session.lookup("abla_live_table")
    if (table.status != 0 || table.address == 0) return
    val entries = ablaUnsafeLoadI64(nativePointerFromAddress(table.address))
    var slot = 0
    while (slot < bootstrapLlvmLiveTableSize && entries != 0) {
        val name = if (slot < bootstrapLlvmLiveNames.size) bootstrapLlvmLiveNames[slot] else "?"
        linuxPrintStandardError("live: entry $slot $name at ${bootstrapLiveHex(ablaUnsafeLoadI64(nativePointerFromAddress(entries + slot * 8)))}\n")
        slot = slot + 1
    }
    for (name in ["main", "abla_live_lambdas"]) {
        val found = session.lookup(name)
        if (found.status == 0) linuxPrintStandardError("live: $name at ${bootstrapLiveHex(found.address)}\n")
    }
    return
}

private noescape extern:"c" fun LLVMPrintValueToString(value: i64*): i64*

// ABLA_LIVE_DUMP_DISPATCHER (any value): a reload that adds functions prints its call dispatcher's IR and theirs on
// standard error before the module is compiled, to see what the dispatcher has for a new lambda.
trusted fun bootstrapLiveDumpDispatcher(module: i64*, generation: int): void {
    // ABLA_LIVE_DUMP_MODULE=<prefix>: the whole reload module, as it goes to the JIT, in <prefix>-<generation>.ll.
    val whole = linuxEnvironment("ABLA_LIVE_DUMP_MODULE")
    if (whole.found && whole.value != "") {
        val error = nativeByteBuffer(8)
        error.storeI64(0, 0)
        LLVMPrintModuleToFile(module, "${whole.value}-$generation.ll", error.pointerAt(0))
        error.close()
    }
    if (!linuxEnvironment("ABLA_LIVE_DUMP_DISPATCHER").found || bootstrapLlvmLiveLambdaCallDispatcher == "") return
    val names: array<string> = [bootstrapLlvmLiveLambdaCallDispatcher]
    for (symbol in bootstrapLlvmLiveNewSymbols) {
        names.append(symbol)
        names.append("__abla_unit.${symbol}_direct")
    }
    for (name in names) {
        val function = LLVMGetNamedFunction(module, name)
        if (pointerIsNull(function)) {
            linuxPrintStandardError("live: generation $generation: no function $name in the module\n")
        } else {
            val text = LLVMPrintValueToString(function)
            linuxPrintStandardError("live: generation $generation IR of $name:\n${borrowNativeCString(text)}\n")
            LLVMDisposeMessage(text)
        }
    }
    return
}
