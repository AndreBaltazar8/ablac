import "abla/io"
import "abla/process"
import "abla/llvm/orc"

fun main: int {
    if (ablaHostArgumentCount() != 2) {
        ablaHostWriteStderr(
            "usage: abla-orc-session-runner first.ll second.ll\n"
        )
        2
    } else {
        // A generated main installs its own argc/argv in the shared runtime,
        // so retain all runner arguments before entering JIT code.
        val firstPath = ablaHostArgument(0)
        val secondPath = ablaHostArgument(1)
        val session = llvmOrcCreateSession()
        val first = session.addFile(firstPath)
        var status = first.status
        if (status == 0) {
            val lookup = session.lookup("main")
            status = lookup.status
            if (status == 0 && callNativeMain(lookup.address) != 41) {
                status = 140
            }
        }
        if (status == 0) status = first.remove()
        val second = session.addFile(secondPath)
        if (status == 0) status = second.status
        if (status == 0) {
            val lookup = session.lookup("main")
            status = lookup.status
            if (status == 0) status = callNativeMain(lookup.address)
        }
        if (second.status == 0) {
            val removeStatus = second.remove()
            if (status == 0 && removeStatus != 0) status = removeStatus
        }
        val closeStatus = session.close()
        if (status == 0 && closeStatus != 0) status = closeStatus
        status
    }
}
