// The page's system-call adapter for the compiler's own module (browser_main.ab): every raw Linux system call goes to one host import,
// abla_host.syscall, which the page answers over an in-memory file system (tools/playground/vfs.mjs). The wasm backend uses this function
// in place of the runtime's fallback (which answers write, exit, the clocks and random bytes and says ENOSYS to the rest) when a bare
// wasm32 program defines it; no other program does.
@wasmImport(["abla_host", "syscall"])
trusted noescape extern:"c" fun __ablaBrowserHostSyscall(number: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64): i64

trusted fun __ablaRuntimeBrowserSyscall(number: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int): int =
    int(__ablaBrowserHostSyscall(i64(number), i64(a0), i64(a1), i64(a2), i64(a3), i64(a4), i64(a5)))
