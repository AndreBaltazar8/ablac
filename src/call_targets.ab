// Compact facts from the type checker's existing method selection. A missing,
// conflicting or dynamically selected observation never narrows reachability.
import "parser.ab"

// The expression kinds the checker records a target for: a method call and the
// operators an operator function is named for. A target of BOOTSTRAP_BUILTIN_OPERATOR is an operator the
// checker found to be the built-in one (scalar operands): no user function is called.
fun bootstrapResolvedKindAllowed(kind: string): bool =
    kind == "member.call" || kind == "+" || kind == "-" || kind == "*" || kind == "/" ||
    kind == "%" || kind == "&" || kind == "|" || kind == "^" || kind == "<<" || kind == ">>" ||
    kind == "unary-" || kind == "unary~"

fun bootstrapBuiltinOperatorTarget(): int = -2

class BootstrapResolvedMethodTarget(
    val receiver: string,
    val target: int,
    val identity: string
)

fun bootstrapResolvedDeclarationIdentity(declaration: BootstrapDeclaration,
    source: string = ""): string =
    "${if (declaration.sourceIdentity != "") declaration.sourceIdentity else source}\n${declaration.begin}\n${declaration.end}\n${declaration.kind}\n${declaration.name}\n${declaration.extensionOwner}"

fun bootstrapResolvedTargetIdentity(declarations: array<BootstrapDeclaration>,
    target: int): string {
    if (target < 0) return ""
    if (target <
        declarations.size) return bootstrapResolvedDeclarationIdentity(declarations[target])
    var handle = declarations.size
    for (owner in declarations) {
        for (method in owner.methods) {
            if (handle == target) return bootstrapResolvedDeclarationIdentity(method,
                owner.sourceIdentity)
            handle += 1
        }
    }
    ""
}

class BootstrapResolvedMethodTargets(
    val enabled: bool,
    val indices: Map<string, int>,
    val targets: array<BootstrapResolvedMethodTarget>
) {
    fun key(source: string, expression: BootstrapExpression): string =
        "$source\n${expression.begin}\n${expression.end}\n${expression.text}"

    fun record(declarations: array<BootstrapDeclaration>, source: string,
        expression: BootstrapExpression, receiver: string,
        target: int): void {
        if (!this.enabled || !bootstrapResolvedKindAllowed(expression.kind) || source == "" ||
            expression.begin < 0) return
        val key = this.key(source, expression)
        val builtin = target == bootstrapBuiltinOperatorTarget()
        val identity = if (builtin) "builtin" else bootstrapResolvedTargetIdentity(declarations, target)
        if (this.indices.has(key)) {
            val index = this.indices.get(key) ?? -1
            if (index < 0) return
            val existing = this.targets[index]
            if (existing.receiver != receiver || existing.target != target ||
                existing.identity != identity) {
                this.targets[index] = BootstrapResolvedMethodTarget(existing.receiver, -1,
                    existing.identity)
            }
        } else {
            this.indices.set(key, this.targets.size)
            this.targets.append(BootstrapResolvedMethodTarget(receiver,
                if (identity == "") -1 else target, identity))
        }
    }

    fun find(source: string, expression: BootstrapExpression): int {
        if (!this.enabled || !bootstrapResolvedKindAllowed(expression.kind) || source == "" ||
            expression.begin < 0) return -1
        val key = this.key(source, expression)
        this.indices.get(key) ?? -1
    }
}

fun bootstrapResolvedMethodTargets(enabled: bool = false): BootstrapResolvedMethodTargets =
    BootstrapResolvedMethodTargets(enabled, Map(), [])
