// The LLVM half of ct_native.ab: ORC's JIT for the thunks and callbacks of compile-time extern:"c" calls, and LLVM's dynamic loader.
// A native compiler imports this and calls ctNativeOrcInstall() first; a compiler built without LLVM (the browser's) does not.
import "ct_native.ab"
import "abla/llvm/orc"
import "ct_signal_trampolines.ab"

var ctNativeOrcSessions: array<LlvmOrcSession> = []

// The thunk JIT, created on the first extern:"c" call.
fun ctNativeOrcSession(): LlvmOrcSession {
    if (ctNativeOrcSessions.size == 0) {
        ctNativeOrcSessions.append(llvmOrcCreateSession())
    }
    ctNativeOrcSessions[0]
}

fun ctNativeOrcCompile(symbol: string, text: string): int {
    val session = ctNativeOrcSession()
    if (session.status != 0) return session.status
    session.addText(symbol, text).status
}

fun ctNativeOrcLookup(symbol: string): int {
    val session = ctNativeOrcSession()
    if (session.status != 0) return -session.status
    val lookup = session.lookup(symbol)
    if (lookup.status != 0) return -lookup.status
    lookup.address
}

fun ctNativeOrcInstall(): void {
    bootstrapCtSignalInstall()
    ctNativeJitCompile = ctNativeOrcCompile
    ctNativeJitLookup = ctNativeOrcLookup
    ctNativeHookLoad = llvmLoadLibraryPermanently
    ctNativeSearchSymbol = llvmSearchForAddressOfSymbol
    ctNativeDefaultTriple = llvmDefaultTargetTriple
}
