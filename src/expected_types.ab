// Expected types flow into array literals. Where a literal stands for a value
// of a declared type (a typed local or top-level value, a function's result or
// a `return` in it, an argument of a top-level function or a constructor), an
// array literal takes that type as `array<T>()` names its own, and each
// element literal in it takes `T` the same way: `[[1], []]` as an
// `array<array<int>>`, `["x", null]` as an `array<string?>`. Analysis then
// checks each element against `T`, and lowering and compile-time evaluation
// see the same typed literal.
//
// A store into a receiver whose type the syntax declares (a typed parameter,
// local, field or top-level value) expects its element or value type too:
// `xs.append(v)`, `xs[i] = v`, `m.set(k, v)`, `x = v`, `o.f = v`.
//
// The pass is syntax to syntax before semantic analysis. A store whose
// receiver's type only analysis knows (an inferred local:
// `val rows = makeRows()` then `rows.append([null])`) has analysis record the
// literal's type (BootstrapContextualLiterals), and lowering writes it in the
// same way first (bootstrapApplyContextualLiterals). A literal with no such
// context keeps its type from its elements. A float literal takes f32 the same
// way (f32_literal.ab).
import "parser.ab"
import "f32_literal.ab"
import "overload.ab"
import "staged_parser.ab"
import "abla/sys/linux/process"
import "sema.ab"
import "abla/sys/linux/io"

/** The array type `type` names once a trailing `?` is dropped, else "". */
fun bootstrapExpectedArrayType(type: string): string {
    var text = type
    if (text.size > 0 && text[text.size - 1] == 63) text = text.slice(0, text.size - 1)
    if (text.size < 7 || text.slice(0, 6) != "array<" || text[text.size - 1] != 62) return ""
    text
}

/** `expression` as a value of type `type`. */
fun bootstrapExpectType(expression: BootstrapExpression, type: string): BootstrapExpression {
    if ((type == "f32" || type == "f32?") && bootstrapIsFloatLiteralExpression(expression)) {
        return bootstrapF32Literals(expression)
    }
    if (expression.kind == "array" && expression.text == "") {
        val array = bootstrapExpectedArrayType(type)
        if (array == "") return expression
        val element = array.slice(6, array.size - 1)
        val children: array<BootstrapExpression> = []
        for (child in expression.children) children.append(bootstrapExpectType(child, element))
        return BootstrapExpression("array", array, expression.begin, expression.end, children)
    }
    if (expression.kind == "block" && expression.children.size > 0) {
        val last = expression.children.size - 1
        val result = bootstrapExpectType(expression.children[last], type)
        if (result == expression.children[last]) return expression
        val children: array<BootstrapExpression> = []
        var index = 0
        while (index < last) {
            children.append(expression.children[index])
            index = index + 1
        }
        children.append(result)
        return BootstrapExpression("block", expression.text, expression.begin, expression.end, children)
    }
    if (expression.kind == "if" && expression.children.size == 3) {
        val taken = bootstrapExpectType(expression.children[1], type)
        val otherwise = bootstrapExpectType(expression.children[2], type)
        if (taken == expression.children[1] && otherwise == expression.children[2]) return expression
        return BootstrapExpression(
            "if", expression.text, expression.begin, expression.end,
            [expression.children[0], taken, otherwise]
        )
    }
    expression
}

// ---- name lookups ----
//
// The tables below are looked up once per call, identifier and member a body
// holds, so a scan of every name would make the pass quadratic in the
// program's size. Past a few names, each table keeps an open-addressing index
// over its names array (a slot holds an entry's position, -1 none); an entry
// is never removed, and a name's first entry is found first, as by a scan. A
// table with a blanked entry ("", a name declared twice) is still found by its
// slots for every other name; "" itself is looked up by a scan.
// ABLA_EXPECTED_INDEX_CHECK=1 checks every lookup against a scan.

val BOOTSTRAP_EXPECTED_INDEXED = 8

var bootstrapExpectedIndexCheckValue: int = -1

fun bootstrapExpectedIndexCheck(): bool {
    if (bootstrapExpectedIndexCheckValue < 0) {
        val configured = linuxEnvironment("ABLA_EXPECTED_INDEX_CHECK")
        bootstrapExpectedIndexCheckValue = if (configured.found && configured.value == "1") 1 else 0
    }
    bootstrapExpectedIndexCheckValue == 1
}

fun bootstrapExpectedScan(names: array<string>, name: string): int {
    var index = 0
    while (index < names.size) {
        if (names[index] == name) return index
        index = index + 1
    }
    -1
}

/** The first entry of `name` in `names`, by `slots` once it has them. */
fun bootstrapExpectedFind(slots: array<int>, names: array<string>, name: string): int {
    var found = -1
    if (slots.size == 0 || name == "") found = bootstrapExpectedScan(names, name)
    else {
        var slot = bootstrapFunctionDeclarationHash(name)
        slot = slot - slot / slots.size * slots.size
        while (found < 0 && slots[slot] >= 0) {
            if (names[slots[slot]] == name) found = slots[slot]
            else {
                slot = slot + 1
                if (slot == slots.size) slot = 0
            }
        }
    }
    if (bootstrapExpectedIndexCheck() && found != bootstrapExpectedScan(names, name)) {
        linuxPrintStandardError(
            "error[E_INTERNAL]: expected.index-check: `$name` found at $found, a scan says ${bootstrapExpectedScan(names, name)}\n"
        )
    }
    found
}

fun bootstrapExpectedPlace(var slots: array<int>, names: array<string>, entry: int): void {
    var slot = bootstrapFunctionDeclarationHash(names[entry])
    slot = slot - slot / slots.size * slots.size
    while (slots[slot] >= 0) {
        slot = slot + 1
        if (slot == slots.size) slot = 0
    }
    slots[slot] = entry
    return
}

/** Indexes `names[entry]`, just appended: past BOOTSTRAP_EXPECTED_INDEXED
 *  names the table gets slots, rebuilt at four times its size whenever it is
 *  half full. */
fun bootstrapExpectedIndex(var slots: array<int>, names: array<string>, entry: int): void {
    if (names.size <= BOOTSTRAP_EXPECTED_INDEXED) return
    if (slots.size < 2 * names.size) {
        slots.clear()
        while (slots.size < 4 * names.size) slots.append(-1)
        var placed = 0
        while (placed < names.size) {
            bootstrapExpectedPlace(slots, names, placed)
            placed = placed + 1
        }
    } else bootstrapExpectedPlace(slots, names, entry)
    return
}

/** The parameter types of the top-level functions and constructors a plain
 *  call can name: one entry per name declared once. */
class BootstrapExpectedCallees(
    val names: array<string>,
    val parameters: array<array<string>>,
    val types: array<array<string>>,
    val results: array<string>,
    val slots: array<int>
) {
    fun find(name: string): int = bootstrapExpectedFind(this.slots, this.names, name)

    fun add(name: string, parameters: array<string>, types: array<string>, result: string): void {
        this.names.append(name)
        this.parameters.append(parameters)
        this.types.append(types)
        this.results.append(result)
        bootstrapExpectedIndex(this.slots, this.names, this.names.size - 1)
        return
    }
}

fun bootstrapExpectedCallees(declarations: array<BootstrapDeclaration>): BootstrapExpectedCallees {
    var callees = BootstrapExpectedCallees([], [], [], [], [])
    val repeated: array<string> = []
    for (declaration in declarations) {
        val callable = ((declaration.kind == "fun" || declaration.kind == "compile.fun" ||
            declaration.kind == "extern") && declaration.extensionOwner == "") ||
            declaration.kind == "class"
        if (callable) {
            if (callees.find(declaration.name) >= 0) repeated.append(declaration.name)
            else callees.add(
                declaration.name, declaration.parameters, declaration.parameterTypes,
                if (declaration.kind == "class") declaration.name else declaration.resultType
            )
        }
    }
    for (name in repeated) {
        val index = callees.find(name)
        if (index >= 0) callees.names[index] = ""
    }
    callees
}

/** The type the callee gives its argument `argument` (at `position`), or "". */
fun bootstrapExpectedArgumentType(
    callees: BootstrapExpectedCallees,
    callee: int,
    argument: BootstrapExpression,
    position: int
): string {
    val parameters = callees.parameters[callee]
    val types = callees.types[callee]
    var index = position
    if (argument.kind == "named.argument") {
        index = -1
        var parameter = 0
        while (parameter < parameters.size) {
            if (parameters[parameter] == argument.text) index = parameter
            parameter = parameter + 1
        }
    }
    if (index < 0 || index >= types.size) return ""
    "${types[index]}"
}

/** Declared type texts by name; a name declared without a type, or twice
 *  with different types, has "". */
class BootstrapExpectedNames(
    val names: array<string>,
    val types: array<string>,
    val slots: array<int>
) {
    fun find(name: string): int = bootstrapExpectedFind(this.slots, this.names, name)

    fun add(name: string, type: string): void {
        val index = this.find(name)
        if (index < 0) {
            this.names.append(name)
            this.types.append(type)
            bootstrapExpectedIndex(this.slots, this.names, this.names.size - 1)
        } else if (this.types[index] != type) this.types[index] = ""
        return
    }

    fun typeOf(name: string): string {
        val index = this.find(name)
        if (index < 0) return ""
        "${this.types[index]}"
    }
}

/** Each class's fields with their declared types. */
class BootstrapExpectedClasses(
    val names: array<string>,
    val fields: array<BootstrapExpectedNames>,
    val slots: array<int>
) {
    fun find(name: string): int = bootstrapExpectedFind(this.slots, this.names, name)

    fun add(name: string, fields: BootstrapExpectedNames): void {
        this.names.append(name)
        this.fields.append(fields)
        bootstrapExpectedIndex(this.slots, this.names, this.names.size - 1)
        return
    }
}

/** What a body's names are declared as: its own parameters and locals, the
 *  receiver's fields (`owner`, in a method or extension function), the
 *  top-level values. */
class BootstrapExpectedScope(
    val locals: BootstrapExpectedNames,
    val owner: string,
    val classes: BootstrapExpectedClasses,
    val globals: BootstrapExpectedNames
)

/** The type a local declaration names: its annotation, or the type of
 *  `array<T>()` or `Map<K, V>()` it is initialized with; else "". */
fun bootstrapExpectedLocalType(expression: BootstrapExpression): string {
    if (expression.children.size > 1 && expression.children[1].kind == "type" &&
        expression.children[1].text != "inferred") return "${expression.children[1].text}"
    if (expression.children.size > 0) {
        val initializer = expression.children[0]
        if (initializer.kind == "array" && initializer.text != "") return "${initializer.text}"
        if (initializer.kind == "call" && initializer.text == "Map" &&
            initializer.children.size == 1 && initializer.children[0].kind == "type") {
            return "${initializer.children[0].text}"
        }
    }
    ""
}

/** Every name `expression` binds, with the type it declares. */
fun bootstrapExpectedLocals(expression: BootstrapExpression, var names: BootstrapExpectedNames): void {
    if (expression.kind == "local.val" || expression.kind == "local.var") {
        names.add(expression.text, bootstrapExpectedLocalType(expression))
    }
    if (expression.kind == "for") names.add(bootstrapForName(expression), "")
    if (expression.kind == "lambda" || expression.kind == "lambda.move" ||
        expression.kind == "lambda.generator") {
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            names.add(expression.children[parameter].text, "")
            parameter = parameter + 1
        }
    }
    for (child in expression.children) bootstrapExpectedLocals(child, names)
    return
}

/** The declared type of `expression` where the syntax names it, else "". */
fun bootstrapExpectedTypeOf(expression: BootstrapExpression, scope: BootstrapExpectedScope): string {
    if (expression.kind == "identifier") {
        if (scope.locals.find(expression.text) >= 0) return scope.locals.typeOf(expression.text)
        if (expression.text == "this") return "${scope.owner}"
        val owner = scope.classes.find(scope.owner)
        if (owner >= 0 && scope.classes.fields[owner].find(expression.text) >= 0) {
            return scope.classes.fields[owner].typeOf(expression.text)
        }
        return scope.globals.typeOf(expression.text)
    }
    if (expression.kind == "member" && expression.children.size == 1) {
        val owner = scope.classes.find(bootstrapExpectedTypeOf(expression.children[0], scope))
        if (owner >= 0) return scope.classes.fields[owner].typeOf(expression.text)
        return ""
    }
    if (expression.kind == "index" && expression.children.size == 2) {
        val array = bootstrapExpectedArrayType(bootstrapExpectedTypeOf(expression.children[0], scope))
        if (array != "") return array.slice(6, array.size - 1)
    }
    ""
}

/** `V` of `Map<K, V>` (or `Map<K, V>?`), else "". */
fun bootstrapExpectedMapValueType(type: string): string {
    var text = type
    if (text.size > 0 && text[text.size - 1] == 63) text = text.slice(0, text.size - 1)
    if (text.size < 6 || text.slice(0, 4) != "Map<" || text[text.size - 1] != 62) return ""
    var depth = 0
    var index = 4
    while (index < text.size - 1) {
        val code = text[index]
        if (code == 60 || code == 40) depth = depth + 1
        if (code == 62 || code == 41) depth = depth - 1
        if (code == 44 && depth == 0) return text.slice(index + 1, text.size - 1)
        index = index + 1
    }
    ""
}

/** `children[at]` as a value of `type`; whether it changed. */
fun bootstrapExpectChild(var children: array<BootstrapExpression>, at: int, type: string): bool {
    if (type == "" || at >= children.size) return false
    val typed = bootstrapExpectType(children[at], type)
    if (typed == children[at]) return false
    children[at] = typed
    true
}

/** `expression` with the expected types written into the literals inside it;
 *  `result` is the enclosing function's result type ("" outside one). */
fun bootstrapExpectTypesIn(
    expression: BootstrapExpression,
    callees: BootstrapExpectedCallees,
    scope: BootstrapExpectedScope,
    result: string
): BootstrapExpression {
    // A lambda's `return` leaves the lambda, whose result isn't declared here.
    val inner = if (expression.kind == "lambda" || expression.kind == "lambda.move" ||
        expression.kind == "lambda.generator") "" else result
    var children: array<BootstrapExpression> = []
    var changed = false
    for (child in expression.children) {
        val rewritten = bootstrapExpectTypesIn(child, callees, scope, inner)
        if (rewritten != child) changed = true
        children.append(rewritten)
    }
    val kind = expression.kind
    if ((kind == "local.val" || kind == "local.var") &&
        children.size > 1 && children[1].kind == "type" && children[1].text != "inferred") {
        if (bootstrapExpectChild(children, 0, children[1].text)) changed = true
    }
    if (kind == "return" && result != "" && children.size == 1) {
        if (bootstrapExpectChild(children, 0, result)) changed = true
    }
    // Stores into a receiver whose type is declared: `xs.append(v)`,
    // `xs[i] = v`, `m.set(k, v)`, `x = v`, `o.f = v`.
    if (kind == "member.call" && children.size == 2 && expression.text == "append") {
        val array = bootstrapExpectedArrayType(bootstrapExpectedTypeOf(children[0], scope))
        if (array != "" && bootstrapExpectChild(children, 1, array.slice(6, array.size - 1))) changed = true
    }
    if (kind == "member.call" && children.size == 3 && expression.text == "set") {
        val value = bootstrapExpectedMapValueType(bootstrapExpectedTypeOf(children[0], scope))
        if (bootstrapExpectChild(children, 2, value)) changed = true
    }
    if (kind == "index.assign" && children.size == 3) {
        val array = bootstrapExpectedArrayType(bootstrapExpectedTypeOf(children[0], scope))
        if (array != "" && bootstrapExpectChild(children, 2, array.slice(6, array.size - 1))) changed = true
    }
    if (kind == "assign" && children.size == 1) {
        val target = BootstrapExpression("identifier", expression.text, expression.begin, expression.begin, [])
        if (bootstrapExpectChild(children, 0, bootstrapExpectedTypeOf(target, scope))) changed = true
    }
    if (kind == "member.assign" && children.size == 2) {
        val target = BootstrapExpression("member", expression.text, expression.begin, expression.begin, [children[0]])
        if (bootstrapExpectChild(children, 1, bootstrapExpectedTypeOf(target, scope))) changed = true
    }
    if (kind == "call" && scope.locals.find(expression.text) < 0) {
        val callee = callees.find(expression.text)
        if (callee >= 0) {
            var position = 0
            while (position < children.size) {
                val argument = children[position]
                val type = bootstrapExpectedArgumentType(callees, callee, argument, position)
                if (type != "") {
                    if (argument.kind == "named.argument" && argument.children.size == 1) {
                        val value = bootstrapExpectType(argument.children[0], type)
                        if (value != argument.children[0]) {
                            children[position] = BootstrapExpression(
                                argument.kind, argument.text, argument.begin, argument.end, [value]
                            )
                            changed = true
                        }
                    } else if (argument.kind != "named.argument") {
                        if (bootstrapExpectChild(children, position, type)) changed = true
                    }
                }
                position = position + 1
            }
        }
    }
    if (!changed) return expression
    BootstrapExpression(expression.kind, expression.text, expression.begin, expression.end, children)
}

/** A function's or top-level value's body with the expected types written in;
 *  `owner` is the receiver's type in a method or extension function. */
fun bootstrapExpectTypesBody(
    declaration: BootstrapDeclaration,
    callees: BootstrapExpectedCallees,
    owner: string,
    classes: BootstrapExpectedClasses,
    globals: BootstrapExpectedNames
): BootstrapDeclaration {
    val scope = bootstrapExpectedBodyScope(declaration, owner, classes, globals)
    val function = declaration.kind == "fun" || declaration.kind == "compile.fun"
    val result = if (function) declaration.resultType else ""
    var body = bootstrapExpectTypesIn(declaration.expression, callees, scope, result)
    val value = declaration.kind == "val" || declaration.kind == "var" ||
        declaration.kind == "compile.val" || declaration.kind == "compile.var"
    if (declaration.resultType != "" && (function || value)) {
        body = bootstrapExpectType(body, declaration.resultType)
    }
    val typed = if (body == declaration.expression) declaration
        else bootstrapDeclarationWithExpression(declaration, body)
    bootstrapExpectF32Defaults(typed)
}

/** `declaration` with a float literal as an f32 parameter's default being an f32. */
fun bootstrapExpectF32Defaults(declaration: BootstrapDeclaration): BootstrapDeclaration {
    var changed = false
    val defaults: array<BootstrapExpression> = []
    var parameter = 0
    while (parameter < declaration.parameterDefaults.size) {
        var value = declaration.parameterDefaults[parameter]
        if (parameter < declaration.parameterTypes.size &&
            declaration.parameterTypes[parameter] == "f32" &&
            bootstrapIsFloatLiteralExpression(value)) {
            value = bootstrapF32Literals(value)
            changed = true
        }
        defaults.append(value)
        parameter = parameter + 1
    }
    if (changed) bootstrapDeclarationWithParameterDefaults(declaration, defaults) else declaration
}

/** What a body's names are declared as (see BootstrapExpectedScope). */
fun bootstrapExpectedBodyScope(
    declaration: BootstrapDeclaration,
    owner: string,
    classes: BootstrapExpectedClasses,
    globals: BootstrapExpectedNames
): BootstrapExpectedScope {
    var locals = BootstrapExpectedNames([], [], [])
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        locals.add(
            declaration.parameters[parameter],
            if (parameter < declaration.parameterTypes.size) "${declaration.parameterTypes[parameter]}" else ""
        )
        parameter = parameter + 1
    }
    bootstrapExpectedLocals(declaration.expression, locals)
    BootstrapExpectedScope(locals, owner, classes, globals)
}

/** The classes' declared fields and the top-level values' declared types. */
class BootstrapExpectedWorld(
    val classes: BootstrapExpectedClasses,
    val globals: BootstrapExpectedNames
)

fun bootstrapExpectedWorld(declarations: array<BootstrapDeclaration>): BootstrapExpectedWorld {
    var classes = BootstrapExpectedClasses([], [], [])
    var globals = BootstrapExpectedNames([], [], [])
    for (declaration in declarations) {
        if (declaration.kind == "class" && classes.find(declaration.name) < 0) {
            var fields = BootstrapExpectedNames([], [], [])
            var parameter = 0
            while (parameter < declaration.parameters.size &&
                parameter < declaration.parameterTypes.size) {
                if (parameter < declaration.parameterKinds.size &&
                    (declaration.parameterKinds[parameter] == "val" ||
                     declaration.parameterKinds[parameter] == "var")) {
                    fields.add(declaration.parameters[parameter], "${declaration.parameterTypes[parameter]}")
                }
                parameter = parameter + 1
            }
            classes.add(declaration.name, fields)
        }
        if (declaration.kind == "val" || declaration.kind == "var") {
            globals.add(declaration.name, "${declaration.resultType}")
        }
    }
    BootstrapExpectedWorld(classes, globals)
}

/** The type the syntax shows for `expression`, or "": a literal's, a declared
 *  name's or field's (bootstrapExpectedTypeOf), a constructor's class, a
 *  top-level function's declared result. */
fun bootstrapExpectedValueType(
    expression: BootstrapExpression,
    scope: BootstrapExpectedScope,
    callees: BootstrapExpectedCallees
): string {
    val kind = expression.kind
    if (kind == "integer") return "int"
    if (kind == "float") return "f64"
    if (kind == "float32") return "f32"
    if (kind == "string" || kind == "string.template") return "string"
    if (kind == "true" || kind == "false") return "bool"
    if (kind == "null") return "null"
    if (kind == "array" && expression.text != "") return "${expression.text}"
    if (kind == "call") {
        if (scope.locals.find(expression.text) >= 0) return ""
        val callee = callees.find(expression.text)
        if (callee >= 0) return "${callees.results[callee]}"
        return ""
    }
    bootstrapExpectedTypeOf(expression, scope)
}

fun bootstrapResolveExpectedTypes(parsed: BootstrapParseResult): BootstrapParseResult {
    val callees = bootstrapExpectedCallees(parsed.declarations)
    val world = bootstrapExpectedWorld(parsed.declarations)
    val classes = world.classes
    val globals = world.globals
    val declarations: array<BootstrapDeclaration> = []
    var changed = false
    for (declaration in parsed.declarations) {
        var rewritten = bootstrapExpectTypesBody(
            declaration, callees, declaration.extensionOwner, classes, globals
        )
        if (declaration.methods.size > 0) {
            val methods: array<BootstrapDeclaration> = []
            var methodsChanged = false
            for (method in declaration.methods) {
                val typed = bootstrapExpectTypesBody(method, callees, declaration.name, classes, globals)
                if (typed != method) methodsChanged = true
                methods.append(typed)
            }
            if (methodsChanged) rewritten = bootstrapDeclarationWithMethods(rewritten, methods)
        }
        if (rewritten != declaration) changed = true
        declarations.append(rewritten)
    }
    if (!changed) return parsed
    BootstrapParseResult(
        declarations, parsed.actions, parsed.errors, parsed.extensionErrors,
        parsed.compileInputPaths, parsed.compileInputContents, parsed.diagnostics
    )
}

/** Array literals typed from a context only analysis knows (a store into a
 *  receiver whose type is inferred): each one's source, span and source
 *  array type. */
class BootstrapContextualLiterals(
    val sources: array<string>,
    val begins: array<int>,
    val ends: array<int>,
    val types: array<string>
) {
    /** The type recorded for the literal at `source`:`begin`..`end`, or "". */
    fun find(source: string, begin: int, end: int): string {
        var index = 0
        while (index < this.begins.size) {
            if (this.begins[index] == begin && this.ends[index] == end &&
                this.sources[index] == source) return "${this.types[index]}"
            index = index + 1
        }
        ""
    }

    fun add(source: string, begin: int, end: int, type: string): void {
        if (this.find(source, begin, end) != "") return
        this.sources.append(source)
        this.begins.append(begin)
        this.ends.append(end)
        this.types.append(type)
        return
    }
}

fun bootstrapNoContextualLiterals(): BootstrapContextualLiterals =
    BootstrapContextualLiterals([], [], [], [])

/** `expression` (in `source`) with the recorded literal types written in. */
fun bootstrapContextualLiteralsIn(
    expression: BootstrapExpression,
    source: string,
    literals: BootstrapContextualLiterals
): BootstrapExpression {
    var children: array<BootstrapExpression> = []
    var changed = false
    for (child in expression.children) {
        val rewritten = bootstrapContextualLiteralsIn(child, source, literals)
        if (rewritten != child) changed = true
        children.append(rewritten)
    }
    var text = expression.text
    if (expression.kind == "array" && text == "") {
        text = literals.find(source, expression.begin, expression.end)
        if (text != "") changed = true
    }
    if (expression.kind == "float" &&
        literals.find(source, expression.begin, expression.end) == "f32") {
        return BootstrapExpression("float32", text, expression.begin, expression.end, children)
    }
    if (!changed) return expression
    BootstrapExpression(expression.kind, text, expression.begin, expression.end, children)
}

/** `parsed` with the literal types analysis recorded (`literals`) written
 *  in, as bootstrapResolveExpectedTypes writes the ones the syntax shows. */
fun bootstrapApplyContextualLiterals(
    parsed: BootstrapParseResult,
    literals: BootstrapContextualLiterals
): BootstrapParseResult {
    if (literals.begins.size == 0) return parsed
    val declarations: array<BootstrapDeclaration> = []
    var changed = false
    for (declaration in parsed.declarations) {
        var rewritten = declaration
        val body = bootstrapContextualLiteralsIn(declaration.expression, declaration.sourceIdentity, literals)
        if (body != declaration.expression) rewritten = bootstrapDeclarationWithExpression(declaration, body)
        if (declaration.methods.size > 0) {
            val methods: array<BootstrapDeclaration> = []
            var methodsChanged = false
            for (method in declaration.methods) {
                val methodBody = bootstrapContextualLiteralsIn(method.expression, method.sourceIdentity, literals)
                if (methodBody != method.expression) {
                    methodsChanged = true
                    methods.append(bootstrapDeclarationWithExpression(method, methodBody))
                } else methods.append(method)
            }
            if (methodsChanged) rewritten = bootstrapDeclarationWithMethods(rewritten, methods)
        }
        if (rewritten != declaration) changed = true
        declarations.append(rewritten)
    }
    if (!changed) return parsed
    BootstrapParseResult(
        declarations, parsed.actions, parsed.errors, parsed.extensionErrors,
        parsed.compileInputPaths, parsed.compileInputContents, parsed.diagnostics
    )
}
