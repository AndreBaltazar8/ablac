// Where the compiler's sources and modules are: the toolchain's and the
// standard library's roots, and the lexical normalization that gives each
// module its identity. Kept apart so semantic analysis can use them without
// the module graph (sema.ab is compiled alone by some tools and tests).
import "abla/sys/linux/fs"
import "abla/fs/path"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "generic_types.ab"
import "diagnostic_positions.ab"
import "abla/text"

// Compiler-owned sources must not depend on the directory from which ablac was
// invoked. The public launcher supplies ABLA_SYSROOT automatically; the
// narrower ABLA_STDLIB override is retained for custom toolchains and bootstrap
// compatibility. A relative fallback keeps direct development binaries usable
// from the repository root. Windows has no launcher script: ablac.exe finds the
// toolchain beside its own image (bootstrapWindowsToolchainRoot).
// A compiler with no environment (the page's) names its toolchain root here; "" otherwise.
var bootstrapToolchainRootOverride: string = ""

fun bootstrapToolchainRoot(): string {
    if (bootstrapToolchainRootOverride != "") return bootstrapToolchainRootOverride
    val configured = linuxEnvironment("ABLA_SYSROOT")
    var result = "."
    if (configured.found && configured.value != "") result = configured.value
    else if (pathHostIsWindows()) {
        val found = bootstrapWindowsToolchainRoot()
        if (found != "") result = found
    }
    result
}

// The root of the files the toolchain itself ships, links and runs: runtime/ (the package-index helper, import lists, C
// sources), the prebuilt fast runtimes (fast-runtime-v1), the release collector (release-collector-v1) and the stdlib's
// discovery records (stdlib-discovery-v1). The override, ABLA_SYSROOT (even "."), the toolchain beside the running image,
// else the directory holding an ABLA_STDLIB that names one; "" when there is none. Never bootstrapToolchainRoot's implicit
// ".": that is whatever directory ablac runs in, and a checkout's files there would be linked into its programs (their
// records are digests anyone can compute). Without a root a build makes these objects itself.
fun bootstrapTrustedToolchainRoot(): string {
    if (bootstrapToolchainRootOverride != "") return bootstrapToolchainRootOverride
    val configured = linuxEnvironment("ABLA_SYSROOT")
    if (configured.found && configured.value != "") return configured.value
    val image = if (pathHostIsWindows()) bootstrapWindowsToolchainRoot() else bootstrapImageToolchainRoot()
    if (image != "") return image
    // (A relative ABLA_STDLIB, `ABLA_STDLIB=stdlib`, names the working directory's: then that directory is the one its
    // user configured, as with ABLA_SYSROOT=.)
    val stdlib = linuxEnvironment("ABLA_STDLIB")
    if (stdlib.found && stdlib.value != "") return Path(stdlib.value).parent().text
    ""
}

// `name` under the trusted toolchain root (bootstrapTrustedToolchainRoot), or "" when there is no such root.
fun bootstrapTrustedToolchainPath(name: string): string {
    val root = bootstrapTrustedToolchainRoot()
    if (root == "") "" else Path(root).child(name).text
}

// The toolchain of the running image on Linux (/proc/self/exe), the first of these that has a stdlib: an install's
// (bin/ or libexec/ beside share/abla), a source tree's (build/ablac.bin under the tree) or a flat one (the image beside
// stdlib); "" for none. A parent directory counts only for those layouts, so a copy of the compiler in some directory of
// /tmp never takes /tmp's files.
fun bootstrapImageToolchainRoot(): string {
    val image = Path("/proc/self/exe").linkTarget()
    if (image == "") return ""
    val directory = Path(image).parent()
    val name = directory.name()
    val candidates: array<Path> = []
    if (name == "bin" || name == "libexec") candidates.append(directory.parent().child("share").child("abla"))
    if (name == "build") candidates.append(directory.parent())
    candidates.append(directory)
    for (candidate in candidates) {
        if (candidate.child("stdlib").info().isDirectory()) return candidate.text
    }
    ""
}

// The toolchain of the running ablac.exe (its image's path, /proc/self/exe on the Windows runtime): the package's layout
// (bin/ablac.exe beside share/abla) or a flat one (ablac.exe beside stdlib), the first that has a stdlib; "" for none.
fun bootstrapWindowsToolchainRoot(): string {
    val image = Path("/proc/self/exe").linkTarget()
    if (image == "") return ""
    val directory = Path(image).parent()
    for (candidate in [directory.parent().child("share").child("abla"), directory]) {
        if (candidate.child("stdlib").info().isDirectory()) return candidate.text
    }
    ""
}

fun bootstrapStandardLibraryRoot(): string {
    val configured = linuxEnvironment("ABLA_STDLIB")
    var result = Path(bootstrapToolchainRoot()).child("stdlib").text
    if (configured.found && configured.value != "") result = configured.value
    result
}

// Where the prebuilt fast runtime's DWARF says the standard library is (toolchain.ab, bootstrapFastRuntimeProduce): not a path on
// any machine, so that the object does not depend on where it was built. `ablac symbolize` puts the installed standard library back.
val BOOTSTRAP_FAST_RUNTIME_DEBUG_STDLIB = "/abla-toolchain/stdlib"

// The standard library root as a build's DWARF names its files: absolute, normalized.
fun bootstrapFastRuntimeStandardLibraryRoot(): string {
    val root = bootstrapStandardLibraryRoot()
    bootstrapNormalizeModulePath(if (root.startsWith("/")) root else "${currentDirectory().text}/$root")
}

// The prefix every path under `root` starts with: "$root/", or `root` itself when it already ends with the separator (the file system root "/",
// a Windows drive "C:/", a share "//server/share/"): "$root/" would be "//" there and nothing would be under it.
fun bootstrapPathUnderPrefix(root: string): string = if (root.endsWith("/")) root else "$root/"

/** Whether `path` is under `root` (not `root` itself), lexically; both read in the canonical `/`-separated form. */
fun bootstrapPathUnder(root: string, path: string): bool {
    val prefix = bootstrapPathUnderPrefix(root)
    path.size > prefix.size && path.startsWith(prefix)
}

/** The part of `path` under `root`, without a leading separator: `path` must be under it (bootstrapPathUnder). */
fun bootstrapPathBelow(root: string, path: string): string = path.slice(bootstrapPathUnderPrefix(root).size, path.size)

// Module identity is lexical and deterministic: it does not consult the host
// filesystem or resolve symlinks. This keeps absent generated inputs, caches,
// and watched builds reproducible while collapsing path aliases.
// The root is the host's (abla/fs/path): `/` on POSIX; on Windows a drive (`C:/`), a UNC share (`//server/share/`) or `/`,
// the path read in its `/`-separated canonical form, so `C:\a\..\b` and `C:/b` are one module.
fun bootstrapNormalizeModulePath(original: string): string = bootstrapNormalizeModulePathIn(original, pathHostIsWindows())

// bootstrapNormalizeModulePath by the POSIX (`windows` false) or the Windows syntax, whatever the host.
fun bootstrapNormalizeModulePathIn(original: string, windows: bool): string {
    val value = if (windows) pathToCanonical(original, true) else original
    val root = pathRootLength(value, windows)
    val absolute = root > 0
    var output = value.slice(0, root)
    var index = root
    while (index < value.size) {
        while (index < value.size && value[index] == 47) index = index + 1
        val begin = index
        while (index < value.size && value[index] != 47) index = index + 1
        if (begin < index) {
            val segment = value.slice(begin, index)
            if (segment == "..") {
                var lastBegin = output.size
                while (lastBegin > root && output[lastBegin - 1] != 47) {
                    lastBegin = lastBegin - 1
                }
                val last = output.slice(lastBegin, output.size)
                if (last != "" && last != "..") {
                    var end = lastBegin
                    if (end > root && end > 1 && output[end - 1] == 47) end = end - 1
                    if (end < root) end = root
                    output = output.slice(0, end)
                } else if (!absolute) {
                    if (output != "") output = "$output/"
                    output = "${output}.."
                }
            } else if (segment != ".") {
                if (output.size > root && output[output.size - 1] != 47) output = "$output/"
                output = "$output$segment"
            }
        }
    }
    if (output == "") output = "."
    output
}

// A relative path that climbs above its base ("../…") can name the same file in
// several lexically different ways (`../../ecs/x.ab` and `../../../engine/ecs/x.ab`
// from `src/engine/examples/app` are one file). Resolve such a path against the
// working directory, normalise it, and express it relative to that directory
// again, so equal files always get equal identities (still relative, still
// independent of symlinks).
var bootstrapWorkingDirectory = ""

fun bootstrapCanonicalEscapingPath(path: string): string {
    if (path.size < 2 || path.slice(0, 2) != "..") return path
    if (bootstrapWorkingDirectory == "") bootstrapWorkingDirectory = currentDirectory().text
    val base = bootstrapWorkingDirectory
    if (base.size == 0 || base[0] != 47) return path
    bootstrapRelativeToWorkingDirectory(bootstrapNormalizeModulePath("$base/$path"))
}

/** `absolute` (a normalised absolute path) as a path relative to the working
 *  directory, as the modules of a program started by a relative path are named;
 *  `absolute` itself when the working directory isn't known. */
fun bootstrapRelativeToWorkingDirectory(absolute: string): string {
    if (bootstrapWorkingDirectory == "") bootstrapWorkingDirectory = currentDirectory().text
    val base = bootstrapWorkingDirectory
    if (base.size == 0 || base[0] != 47 || absolute.size == 0 || absolute[0] != 47) return absolute
    // Relative path from `base` to `absolute`, segment by segment.
    val baseParts = bootstrapPathSegments(base)
    val targetParts = bootstrapPathSegments(absolute)
    var common = 0
    while (common < baseParts.size && common < targetParts.size &&
           baseParts[common] == targetParts[common]) common = common + 1
    var output = ""
    var up = common
    while (up < baseParts.size) {
        output = if (output == "") ".." else "$output/.."
        up = up + 1
    }
    var down = common
    while (down < targetParts.size) {
        output = if (output == "") targetParts[down] else "$output/${targetParts[down]}"
        down = down + 1
    }
    if (output == "") "." else output
}

// Scoped to graph preparation, and restored after nested compile-time builds.
// Nothing is added to AST nodes or retained in the semantic module cache.
var bootstrapModuleIdentityRoot = ""
var bootstrapModuleIdentityStdlib = ""
var bootstrapModuleIdentityPrefixes: Map<string, string> = Map()

fun bootstrapModuleIdentityProjectRoot(entry: string): string {
    if (entry.startsWith("<")) return ""
    // The path a module was reached through determines its sibling imports
    // and package. Resolve only lexical dots, never filesystem symlinks.
    val absolute = bootstrapNormalizeModulePath(
        if (Path(entry).isAbsolute()) entry else "${currentDirectory().text}/$entry"
    )
    val start = Path(absolute).parent()
    var directory = start
    var depth = 0
    while (depth < 128) {
        if (directory.child("abla.toml").exists()) return directory.text
        val parent = directory.parent()
        if (parent.text == directory.text) return start.text
        directory = parent
        depth += 1
    }
    start.text
}

fun bootstrapModuleRelativeIdentity(path: string, root: string): string {
    val base = bootstrapPathSegments(root)
    val target = bootstrapPathSegments(path)
    var common = 0
    while (common < base.size && common < target.size &&
        base[common] == target[common]) common += 1
    var result = ""
    var index = common
    while (index < base.size) {
        result = "$result../"
        index += 1
    }
    index = common
    while (index < target.size) {
        if (index > common) result = "$result/"
        result = "$result${target[index]}"
        index += 1
    }
    result
}

// Project private/alias/type identities are package-relative before rewriting,
// so every later consumer (including LLVM hashes and runtime type strings)
// sees the same name. Keep stdlib's established portable LLVM spelling.
fun bootstrapModuleCanonicalPrefix(modulePath: string): string {
    if (bootstrapModuleIdentityRoot == "" || modulePath.startsWith("<")) {
        return bootstrapEncodeModulePrefix(modulePath)
    }
    val known = bootstrapModuleIdentityPrefixes.get(modulePath)
    if (known != null) return known
    val absolute = bootstrapNormalizeModulePath(
        if (Path(modulePath).isAbsolute()) modulePath
        else "${currentDirectory().text}/$modulePath"
    )
    // Keep a dependency's lexical path within the project, even when a package
    // directory is a symlink into a shared download cache outside the checkout.
    val identity = if (absolute == bootstrapModuleIdentityStdlib ||
        bootstrapPathUnder(bootstrapModuleIdentityStdlib, absolute)) modulePath
        else "project/${bootstrapModuleRelativeIdentity(absolute, bootstrapModuleIdentityRoot)}"
    val prefix = bootstrapEncodeModulePrefix(identity)
    bootstrapModuleIdentityPrefixes.set(modulePath, prefix)
    prefix
}

fun bootstrapEncodeModulePrefix(modulePath: string): string {
    val digits = "0123456789abcdef"
    var prefix = "__abla_module_"
    var index = 0
    while (index < modulePath.size) {
        val byte = modulePath[index]
        prefix = "$prefix${digits.slice(byte / 16, byte / 16 + 1)}"
        prefix = "$prefix${digits.slice(byte - (byte / 16) * 16,
            byte - (byte / 16) * 16 + 1)}"
        index = index + 1
    }
    "${prefix}__"
}

fun bootstrapPathSegments(path: string): array<string> {
    val parts: array<string> = []
    var index = 0
    while (index < path.size) {
        while (index < path.size && path[index] == 47) index = index + 1
        val begin = index
        while (index < path.size && path[index] != 47) index = index + 1
        if (begin < index) parts.append(path.slice(begin, index))
    }
    parts
}

// The imports that bring each module into a program, for a diagnostic about
// two modules' declarations: each module's first import (its module and
// range) and how many imports it has. module.ab starts a new table for each
// graph it parses, and an analyzer keeps the one current when it was made,
// so a program built at compile time inside another doesn't change it.
class BootstrapModuleImports(
    val slots: Map<string, int>,
    val importers: array<string>,
    val begins: array<int>,
    val ends: array<int>,
    val counts: array<int>
)

fun bootstrapModuleImportsEmpty(): BootstrapModuleImports =
    BootstrapModuleImports(Map(), [], [], [], [])

var bootstrapModuleImportsCurrent: BootstrapModuleImports = bootstrapModuleImportsEmpty()

/** The table of the graph parsed last (an analyzer's default). */
fun bootstrapModuleImportsNow(): BootstrapModuleImports = bootstrapModuleImportsCurrent

fun bootstrapModuleImportsBegin(): void {
    bootstrapModuleImportsCurrent = bootstrapModuleImportsEmpty()
}

fun bootstrapModuleImportRecord(
    target: string,
    importer: string,
    begin: int,
    end: int
): void {
    val imports = bootstrapModuleImportsCurrent
    val slot = imports.slots.get(target)
    if (slot != null) {
        imports.counts[slot] = imports.counts[slot] + 1
    } else {
        imports.slots.set(target, imports.importers.size)
        imports.importers.append(importer)
        imports.begins.append(begin)
        imports.ends.append(end)
        imports.counts.append(1)
    }
}

/** Where two modules whose declarations clash come into the program: a
 *  `note:` and the import's range for each, and how to keep them apart.
 *  `explained` holds the pairs an analyzer has explained (once per pair). */
fun bootstrapModuleClashNotes(
    imports: BootstrapModuleImports,
    var explained: Map<string, int>,
    first: string,
    second: string
): string {
    if (first == second || first == "" || second == "") return ""
    if (explained.get("$first\n$second") != null) return ""
    explained.set("$first\n$second", 1)
    explained.set("$second\n$first", 1)
    var notes = ""
    for (module in [first, second]) {
        val slot = imports.slots.get(module)
        if (slot != null) {
            val others = imports.counts[slot] - 1
            val more = if (others == 0) "" else
                if (others == 1) " (and 1 more import)" else " (and $others more imports)"
            notes =
                "${notes}note: `$module` is imported by `${imports.importers[slot]}`$more\nsource[import]:${imports.importers[slot]}:${imports.begins[slot]}:${imports.ends[slot]}\n"
        }
    }
    "${notes}help: both modules' names are program-wide: alias one of the imports (`import \"…\" as name`), or, if one module stands in for the other, remap it in the root abla.toml (`[imports]`)\n"
}

// What to say of an import whose path lost its quotes (`import abla/io`), which
// would otherwise be evaluated as a provider expression, a division of two
// names; "" for anything else.
fun bootstrapUnquotedImportDiagnostic(expression: string): string {
    var hasSeparator = false
    var index = 0
    while (index < expression.size) {
        val byte = expression[index]
        if (byte == 47) hasSeparator = true
        val inPath = byte == 47 || byte == 46 || byte == 45 || byte == 95 ||
            (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122)
        if (!inPath) return ""
        index = index + 1
    }
    if (hasSeparator) "error[E_IMPORT_PATH_UNQUOTED]: an import path needs quotes\nhelp: write `import \"$expression\"`\n"
    else ""
}

/** What strict imports let each module see, for the checks sema makes once a call's target is known (an extension
 *  function or operator, an overload): set by bootstrapValidateStrictImports for every build. `modes[m]` is 0 for a
 *  module not checked, 1 for a strict one (a hidden target is an error), 2 for a flat one whose uses
 *  `--visibility-report` lists, 3 for one `--strict-imports=warn` covers (flat, each hidden use a warning, and listed
 *  as 2's are); `visible[m]` holds, for a checked module, which modules it sees. `importFor(m, d)` is
 *  the import line module `m` adds to see module `d`. */
// `--visibility-report <path>` (module.ab writes the names, sema the members and overloads).
var bootstrapVisibilityReportPath: string = ""

// W_UNUSED_IMPORT (on by default; --no-warn-unused-imports or ABLA_WARN_UNUSED_IMPORTS=0 turns it off): which modules
// each checked module used a declaration of, "importer\tdeclaring" by file, from the strict-import scan's names and
// sema's member and operator resolution (module.ab's bootstrapUnusedImportWarnings compares them with the imports).
var bootstrapUnusedImportsRequested: bool = false
var bootstrapUnusedImportsDeclined: bool = false

/**
 * Whether `absolute` (normalized) lies in the project at `root` itself: under it, not in a package's vendored copy
 * (.abla/packages/), and not reached through a symbolic link below the root (`engine -> ../abla-forge` is another
 * project's checkout, though its path reads as this one's).
 */
fun bootstrapProjectOwnsPath(root: string, absolute: string): bool {
    if (absolute.contains("/.abla/packages/") || !bootstrapPathUnder(root, absolute)) return false
    var prefix = root
    val segments = absolute.slice(root.size + 1, absolute.size).split("/")
    var index = 0
    // Every directory between the root and the file (the file itself may be a link: it is still this project's name).
    while (index + 1 < segments.size) {
        prefix = "$prefix/${segments[index]}"
        if (Path(prefix).isSymbolicLink()) return false
        index = index + 1
    }
    true
}
// The entry the build started from (toolchain.ab, frontend.ab), whose project bounds the modules warned about.
var bootstrapUnusedImportEntry: string = ""

// The environment's answer, read once (0 not yet read, 1 yes, 2 no): the question is asked for every import a build meets.
var bootstrapUnusedImportsConfigured: int = 0

fun bootstrapUnusedImportsWanted(): bool {
    // On by default (decision #86). `--warn-unused-imports` asks for it whatever the environment says;
    // `--no-warn-unused-imports` or ABLA_WARN_UNUSED_IMPORTS=0 turns it off.
    if (bootstrapUnusedImportsRequested) return true
    if (bootstrapUnusedImportsDeclined) return false
    // The environment is read once: 1 on (the default), 2 off (ABLA_WARN_UNUSED_IMPORTS=0).
    if (bootstrapUnusedImportsConfigured == 0) {
        val configured = linuxEnvironment("ABLA_WARN_UNUSED_IMPORTS")
        bootstrapUnusedImportsConfigured = if (configured.found && configured.value == "0") 2 else 1
    }
    bootstrapUnusedImportsConfigured == 1
}

// W_UNUSED_LOCAL (opt-in: --warn-unused-locals, or an editor client's initialize `unusedLocals`): every `val`/`var` statement
// of a function sema checked (identity "abla:<source>:<begin>:local:<name>", by place), and the identities some lookup found.
// A lookup that isn't a use (a shadow check) also marks: a missed warning, never a false one.
var bootstrapUnusedLocalsRequested: bool = false
class BootstrapUnusedLocal(val identity: string, val name: string, val source: string, val begin: int, val end: int, val function: string = "")
var bootstrapUnusedLocalDeclared: array<BootstrapUnusedLocal> = []
// W_UNUSED_PARAMETER (opt-in: --warn-unused-parameters, the editor's initialize `unusedParameters`): the parameters of the
// project's functions and methods, checked with the same lookups as the locals (bootstrapUnusedLocalUsed).
var bootstrapUnusedParametersRequested: bool = false
var bootstrapUnusedParameterDeclared: array<BootstrapUnusedLocal> = []
// The functions the program names as a value (`sort(items, compare)`): the callee fixes their signature, so their parameters are exempt.
// W_UNUSED_DECLARATION (opt-in: --warn-unused-declarations, the editor's initialize `unusedDeclarations`): see unused_declarations.ab.
var bootstrapUnusedDeclarationsRequested: bool = false
var bootstrapUnusedDeclarationList: array<BootstrapUnusedLocal> = []
var bootstrapFunctionValueUses: Map<string, bool> = Map()
var bootstrapUnusedLocalUsed: Map<string, bool> = Map()

var bootstrapImportUses: Map<string, bool> = Map()

fun bootstrapImportUseRecord(importer: string, declaring: string): void {
    bootstrapImportUses.set("${bootstrapGenericSourceFile(importer)}\t${bootstrapGenericSourceFile(declaring)}", true)
    return
}
var bootstrapVisibilityReportStarted: bool = false

// `--strict-imports=warn`: the modules `--strict-imports` would make strict stay flat, and each diagnostic strict
// imports would give them is printed as a warning (the same text and help line, `warning[…]`), once per build.
var bootstrapStrictImportsWarn: bool = false

// `--stdlib-internals`: the standard library's own tests and tools (never a program) see the names of the library's internal files
// (a module's other files than its entry, `// public: none`), which they import by file name (`import "abla/crypto/p256/core.ab"`). The command line sets it, and nothing
// else can: not a manifest key, an environment variable, a source comment or the analysis service. A build with it is never cached.
var bootstrapStdlibInternals: bool = false
val bootstrapStrictImportWarningsShown: Map<string, int> = Map()

/** Prints `diagnostic` (one or more `error[…]` entries with their `source[…]` and `help:` lines) as warnings, unless
 *  this process printed it already: a build may check its module graph, and sema a call, more than once. */
fun bootstrapStrictImportWarning(diagnostic: string): void {
    if (diagnostic == "") return
    var text = ""
    for (line in diagnostic.split("\n")) {
        if (line != "") {
            text = if (line.startsWith("error[")) "${text}warning[${line.slice(6, line.size)}\n" else "$text$line\n"
        }
    }
    // (Each of a generic's instances reports its generic's place: printed once.)
    val shown = bootstrapDiagnosticPositions(text)
    if (bootstrapStrictImportWarningsShown.has(shown)) return
    bootstrapStrictImportWarningsShown.set(shown, 1)
    linuxPrintStandardError(shown)
    return
}

// The modules of this build that are strict only by default (bootstrapModuleStrictByDefault, set where the
// strict-visibility table is made): their E_NAME_NOT_IMPORTED gets a second help line, how to opt out.
var bootstrapStrictOptOutModules: Map<string, bool> = Map()

/** The opt-out help line for an E_NAME_NOT_IMPORTED in `modulePath`, or "". */
fun bootstrapStrictOptOutHelp(modulePath: string): string =
    if (bootstrapStrictOptOutModules.has(modulePath))
        "help: imports are strict by default; to build this package flat while its imports are added: " +
            "--flat-imports, or visibility = \"flat\" in its abla.toml (tools/fix-imports.ab adds them)\n"
    else ""

/** The warning for a use sema found hidden from a module `--strict-imports=warn` covers. */
fun bootstrapStrictImportHiddenWarning(caller: string, at: int, shown: string, declaring: string): void =
    bootstrapStrictImportWarning(
        "error[E_NAME_NOT_IMPORTED]: `$shown` is declared in $declaring, which this module doesn't import\nsource[semantic]:$caller:$at:${at + 1}\nhelp: add: ${bootstrapStrictImportLine(caller, declaring)}\n"
    )

class BootstrapStrictVisibility(
    val modules: Map<string, int>,
    val modes: array<int>,
    // Bitsets (bootstrapStrictBits): one bit a module.
    val visible: array<array<int>>,
    // As `visible`, with the modules imported under an alias too (for extension functions and operators).
    val memberVisible: array<array<int>>,
    val sources: array<string>,
    val importFor: (int, int) -> string
)

// Each source identity a lookup met (a generic instance's too) to its module in the table (-1: none),
// emptied with each new table: a lookup is per call and per overload candidate, and a generic instance's
// module is a slice of its identity, which would be a new path-long string each time.
var bootstrapStrictIdentityModules: Map<string, int> = Map()

fun bootstrapStrictVisibilityEmpty(): BootstrapStrictVisibility =
    BootstrapStrictVisibility(Map(), [], [], [], [], { caller: int, declaring: int -> "" })

var bootstrapStrictVisibilityTable: BootstrapStrictVisibility = bootstrapStrictVisibilityEmpty()

// The member and overload lines sema added to the report in this process, each once.
val bootstrapVisibilityReportMemberLines: Map<string, int> = Map()

/** How module `caller` sees a declaration of module `declaring` (both source identities, a generic instance's
 *  included): 0 visible or not checked, 1 hidden from a strict module, 2 hidden from a module the report covers. */
fun bootstrapStrictHidden(caller: string, declaring: string, member: bool = false): int {
    val table = bootstrapStrictVisibilityTable
    if (table.modes.size == 0) return 0
    val from = bootstrapStrictModuleOf(table, caller)
    if (from < 0 || table.modes[from] == 0) return 0
    val to = bootstrapStrictModuleOf(table, declaring)
    if (to < 0) return 0
    val mode = table.modes[from]
    val seen = if (member) table.memberVisible[from] else table.visible[from]
    if (mode == 0 || seen.size == 0 || bootstrapStrictBit(seen, to)) 0 else mode
}

/** `flags` as a bitset, 64 to a word: the table keeps one for each checked module's view of every module. */
fun bootstrapStrictBits(flags: array<bool>): array<int> {
    val words = filledArray((flags.size + 63) / 64, 0)
    var index = 0
    while (index < flags.size) {
        if (flags[index]) words[index / 64] = words[index / 64] | (1 << (index % 64))
        index = index + 1
    }
    words
}

fun bootstrapStrictBit(bits: array<int>, index: int): bool =
    index / 64 < bits.size && ((bits[index / 64] >> (index % 64)) & 1) != 0

/** The module (its index in the table) of a source identity, -1 for one no checked build module has. */
fun bootstrapStrictModuleOf(table: BootstrapStrictVisibility, identity: string): int {
    val known = bootstrapStrictIdentityModules.get(identity)
    if (known != null) return known
    val found = table.modules.get(bootstrapGenericSourceFile(identity)) ?? -1
    bootstrapStrictIdentityModules.set(identity, found)
    found
}

/** The import `caller` adds to see `declaring`'s declarations (`import "…"`), "" when unknown. */
fun bootstrapStrictImportLine(caller: string, declaring: string): string {
    val table = bootstrapStrictVisibilityTable
    val from = table.modules.get(bootstrapGenericSourceFile(caller))
    val to = table.modules.get(bootstrapGenericSourceFile(declaring))
    if (from == null || to == null) return ""
    val importFor = table.importFor
    importFor(from, to)
}

/** Adds a report line for a use sema found (`kind` is `member` or `overload`): the module, the line and column of
 *  `offset` in it, what is used, the declaring module, the import to add and the kind. */
/** A name `caller` uses that only the standard library declares (sema's import hint): a `standard` row with the
 *  import to add when one module declares it, else a `standard-ambiguous` row naming the modules, with no import
 *  (the user picks). Line and column are 0: what applies the report needs the module and the import. */
fun bootstrapVisibilityReportStandard(caller: string, name: string, modules: array<string>): void {
    if (bootstrapVisibilityReportPath == "" || modules.size == 0) return
    val file = bootstrapGenericSourceFile(caller)
    var declaring = ""
    for (module in modules) declaring = if (declaring == "") module else "$declaring,$module"
    val text = if (modules.size == 1) "$file\t0\t0\t$name\t$declaring\timport \"$declaring\"\tstandard\n"
        else "$file\t0\t0\t$name\t$declaring\t\tstandard-ambiguous\n"
    if (bootstrapVisibilityReportMemberLines.has(text)) return
    bootstrapVisibilityReportMemberLines.set(text, 1)
    Path(bootstrapVisibilityReportPath).appendText(text)
    return
}

fun bootstrapVisibilityReportUse(caller: string, offset: int, name: string, declaring: string, kind: string): void {
    val path = bootstrapVisibilityReportPath
    val table = bootstrapStrictVisibilityTable
    val from = table.modules.get(bootstrapGenericSourceFile(caller))
    if (path == "" || from == null) return
    val source = table.sources[from]
    var line = 1
    var column = 1
    var cursor = 0
    while (cursor < offset && cursor < source.size) {
        if (source[cursor] == 10) {
            line = line + 1
            column = 1
        } else column = column + 1
        cursor = cursor + 1
    }
    val text = "${bootstrapGenericSourceFile(caller)}\t$line\t$column\t$name\t${bootstrapGenericSourceFile(declaring)}\t${bootstrapStrictImportLine(caller, declaring)}\t$kind\n"
    if (bootstrapVisibilityReportMemberLines.has(text)) return
    bootstrapVisibilityReportMemberLines.set(text, 1)
    Path(path).appendText(text)
    return
}
