// The run-time checks of compiled code, as compile-time evaluation applies
// them. Where a compiled program panics (division by zero, an index out of
// bounds), evaluation under `#` stops with a positioned error carrying the
// same text; MIN / -1 wraps in both (eval_scalar.ab here). The runtime's
// side is stdlib/abla/runtime/self/entry.ab (bounds) and the backend's
// bootstrapLlvmEmitIntegerDivision (division).

/** The text of a run-time panic for an index outside a string or an array
 *  (`what`). */
fun bootstrapEvalIndexPanicText(index: int, size: int, what: string): string =
    "index $index out of bounds for $what of size $size"

fun bootstrapEvalSlicePanicText(begin: int, end: int, size: int): string =
    "slice $begin..$end out of bounds for string of size $size"

fun bootstrapEvalTruncatePanicText(count: int): string =
    "truncate to a negative size ($count)"

fun bootstrapEvalFilledPanicText(count: int): string =
    "filledArray with a negative size ($count)"

/** Two strings in byte-wise lexicographic order (as the runtime's
 *  __ablaRuntimeStringCompare): negative when `left` comes first, 0 when
 *  equal, positive when `right` does; a prefix comes first. */
fun bootstrapEvalStringOrder(left: string, right: string): int {
    val common = if (left.size < right.size) left.size else right.size
    var index = 0
    var order = 0
    while (order == 0 && index < common) {
        order = left[index] - right[index]
        index = index + 1
    }
    if (order == 0) left.size - right.size else order
}

fun bootstrapEvalOrdered(operation: string, order: int): bool =
    if (operation == "<") order < 0
    else if (operation == "<=") order <= 0
    else if (operation == ">") order > 0
    else order >= 0
