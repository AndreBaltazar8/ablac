import "package_catalog.ab"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "abla/text"

fun bootstrapPackageSearch(query: string): int {
    val term = query.trim().lowercase()
    if (term == "") {
        linuxPrintStandardError("usage: ablac package search <term>\n")
        return 2
    }

    val url = "https://abla.dev/packages.toml"
    val fetch = linuxCommand("curl")
    fetch.argument("-q")
    fetch.argument("--fail")
    fetch.argument("--silent")
    fetch.argument("--show-error")
    fetch.argument("--max-time")
    fetch.argument("20")
    fetch.argument("--max-filesize")
    fetch.argument("262144")
    fetch.argument("--proto")
    fetch.argument("=https")
    fetch.argument(url)
    val downloaded = fetch.capture()
    if (downloaded.status != 0) {
        linuxPrintStandardError("error[E_PACKAGE_SEARCH]: cannot fetch $url (requires curl and network access)\n")
        return 1
    }
    val catalog = packageCatalogParse(downloaded.output)
    if (catalog.error != "") {
        linuxPrintStandardError("error[E_PACKAGE_SEARCH]: ${catalog.error}\n")
        return 1
    }

    var found = false
    for (entry in catalog.entries) {
        var words = "${entry.repository} ${entry.description}".lowercase()
        for (keyword in entry.keywords) words = "$words ${keyword.lowercase()}"
        if (words.indexOf(term) >= 0) {
            linuxPrintStandardOutput("${entry.repository}\t${entry.description}\n")
            found = true
        }
    }
    if (!found) linuxPrintStandardOutput("No packages found.\n")
    0
}
