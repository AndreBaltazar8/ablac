import "package_index.ab"
import "abla/sys/linux/process"
import "abla/sys/linux/io"
import "abla/text"

private fun bootstrapPackageSearchUsage(): int {
    linuxPrintStandardError("usage: ablac package search <words> [--offline]\n")
    2
}

private fun packageSearchWords(query: string): array<string> {
    var terms: array<string> = []
    var start = 0
    var end = 0
    while (end < query.size) {
        val byte = query[end]
        if (byte == 32 || (byte >= 9 && byte <= 13)) {
            if (end > start) terms.append(query.slice(start, end).lowercase())
            start = end + 1
        }
        end = end + 1
    }
    if (end > start) terms.append(query.slice(start, end).lowercase())
    terms
}

fun bootstrapPackageSearchCommand(): int {
    var offline = false
    var terms: array<string> = []
    var index = 2
    while (index < linuxArgumentCount()) {
        val argument = linuxArgument(index)
        if (argument == "--offline" && !offline) offline = true
        else if (argument.startsWith("--")) return bootstrapPackageSearchUsage()
        else for (term in packageSearchWords(argument)) terms.append(term)
        index = index + 1
    }
    if (terms.size == 0) return bootstrapPackageSearchUsage()

    val catalog = bootstrapPackageIndex(offline)
    if (catalog.error != "") {
        linuxPrintStandardError("error[E_PACKAGE_SEARCH]: ${catalog.error}\n")
        return 1
    }

    var found = false
    for (entry in catalog.entries) {
        var words = "${entry.repository} ${entry.description}".lowercase()
        for (keyword in entry.keywords) words = "$words ${keyword.lowercase()}"
        var matches = true
        for (term in terms) {
            if (words.indexOf(term) < 0) {
                matches = false
                break
            }
        }
        if (matches) {
            linuxPrintStandardOutput("${entry.repository}\t${entry.description}\n")
            found = true
        }
    }
    if (!found) linuxPrintStandardOutput("No packages found.\n")
    0
}
