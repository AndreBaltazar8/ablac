import "abla/io"
import "abla/process"
import "abla/llvm/aot"

fun main: int {
    if (ablaHostArgumentCount() != 2) {
        ablaHostWriteStderr("usage: abla-aot-runner input.ll output.o\n")
        2
    } else {
        llvmAotEmitObjectFile(
            ablaHostArgument(0),
            ablaHostArgument(1)
        )
    }
}
