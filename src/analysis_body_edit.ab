// Replay checked results across a narrowly verified, type-inert body edit.
// Prove that both sources reduce to the same text and check the parsed body.
// Other edits go through the ordinary checker.
import "analysis_service.ab"
import "module.ab"
import "parser.ab"
import "lexer.ab"
import "abla/text"

class BootstrapAnalysisBodyInsert(
    val at: int,
    val size: int,
    val declarationBegin: int,
    val name: string,
    val nameBegin: int,
    val nameEnd: int,
    val line: string,
    val removed: int = 0,
    val previousLine: string = ""
)

fun bootstrapAnalysisBodyDecimal(text: string): bool {
    if (text.size == 0 || text.size >= 10) return false
    for (index in 0 until text.size) {
        if (text[index] < 48 || text[index] > 57) return false
    }
    true
}

fun bootstrapAnalysisBodyInsertion(before: string, after: string): BootstrapAnalysisBodyInsert? {
    val size = after.size - before.size
    if (size <= 0 || size > 256) return null
    var common = 0
    while (common < before.size && before[common] == after[common]) common = common + 1
    var at = bootstrapAnalysisLineStart(before, common)
    // An inserted line can share its entire prefix with the following line.
    while (at <= common && at + size <= after.size) {
        if (after[at + size - 1] == 10 &&
            after.slice(at + size, after.size) == before.slice(at, before.size)) {
            val line = after.slice(at, at + size)
            val tokens = bootstrapLexShared(line.slice(0, line.size - 1))
            if (tokens.size == 5 &&
                bootstrapTokenText(line, tokens[0]) == "val" &&
                tokens[1].kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
                tokens[2].kind == BOOTSTRAP_TOKEN_EQUAL &&
                tokens[3].kind == BOOTSTRAP_TOKEN_INTEGER) {
                val name = bootstrapTokenText(line, tokens[1])
                val digits = bootstrapTokenText(line, tokens[3])
                // Require the single new name to be fresh throughout the
                // source, including quoted text and interpolation.
                if (bootstrapAnalysisBodyDecimal(digits) && before.indexOf(name) < 0 && !name.startsWith("__abla_") &&
                    !line.contains("//") && !line.contains("/*")) {
                    return BootstrapAnalysisBodyInsert(at, size, at + tokens[0].begin, name,
                        at + tokens[1].begin, at + tokens[1].end, line)
                }
            }
            return null
        }
        val end = before.indexOf("\n", at)
        if (end < 0) return null
        at = end + 1
    }
    null
}

// Match a replacement by proving that both sides add the same unused
// binding to one exact base source.
fun bootstrapAnalysisBodyReplacement(before: string, after: string): BootstrapAnalysisBodyInsert? {
    var first = 0
    while (first < before.size && first < after.size && before[first] == after[first]) first = first + 1
    if (first == before.size || first == after.size) return null
    val start = bootstrapAnalysisLineStart(before, first)
    val oldEnd = before.indexOf("\n", first)
    val newEnd = after.indexOf("\n", first)
    if (oldEnd < 0 || newEnd < 0 || oldEnd - start >= 256 || newEnd - start >= 256) return null
    val left = before.slice(0, start)
    val right = before.slice(oldEnd + 1, before.size)
    val base = "$left$right"
    val old = bootstrapAnalysisBodyInsertion(base, before)
    val fresh = bootstrapAnalysisBodyInsertion(base, after)
    if (old == null || fresh == null || old.at != fresh.at || old.name != fresh.name) return null
    BootstrapAnalysisBodyInsert(fresh.at, fresh.size, fresh.declarationBegin, fresh.name,
        fresh.nameBegin, fresh.nameEnd, fresh.line, old.size, old.line)
}

// Only the digits of a standalone decimal literal may change. The parsed
// body check below establishes that this line is the function's result.
fun bootstrapAnalysisBodyResult(before: string, after: string): BootstrapAnalysisBodyInsert? {
    var first = 0
    while (first < before.size && first < after.size && before[first] == after[first]) first = first + 1
    val start = bootstrapAnalysisLineStart(before, first)
    val oldEnd = before.indexOf("\n", first)
    val newEnd = after.indexOf("\n", first)
    if (oldEnd < 0 || newEnd < 0 || oldEnd - start >= 256 || newEnd - start >= 256 ||
        before.slice(oldEnd, before.size) != after.slice(newEnd, after.size)) return null
    var begin = start
    while (begin < first && (after[begin] == 32 || after[begin] == 9)) begin = begin + 1
    if (begin == start) return null
    val oldDigits = before.slice(begin, oldEnd)
    val newDigits = after.slice(begin, newEnd)
    if (!bootstrapAnalysisBodyDecimal(oldDigits) || !bootstrapAnalysisBodyDecimal(newDigits) ||
        (oldDigits.size > 1 && oldDigits[0] == 48) ||
        (newDigits.size > 1 && newDigits[0] == 48)) return null
    BootstrapAnalysisBodyInsert(begin, newDigits.size, begin, "", 0, 0, newDigits, oldDigits.size, oldDigits)
}

fun bootstrapAnalysisBodyChange(before: string, after: string): BootstrapAnalysisBodyInsert? {
    val insertion = bootstrapAnalysisBodyInsertion(before, after)
    if (insertion != null) return insertion
    val replacement = bootstrapAnalysisBodyReplacement(before, after)
    if (replacement != null) return replacement
    bootstrapAnalysisBodyResult(before, after)
}

fun bootstrapAnalysisPlainBodyChange(parsed: BootstrapParseResult, change: BootstrapAnalysisBodyInsert): bool {
    if (parsed.errors != 0 || parsed.extensionErrors != 0) return false
    for (declaration in parsed.declarations) {
        val body = declaration.expression
        if (declaration.kind != "fun" || declaration.resultType == "inferred" ||
            declaration.typeParameters.size != 0 || declaration.annotations.size != 0 ||
            declaration.extensionOwner != "" || declaration.generatedNamespace != "" ||
            body.kind != "block" || body.begin >= change.at || body.end <= change.at + change.size ||
            body.children.size == 0) continue
        if (change.name == "") {
            val result = body.children[body.children.size - 1]
            if (declaration.resultType == "int" && result.kind == "integer" &&
                result.begin == change.at && result.end == change.at + change.size) return true
            continue
        }
        if (body.children.size < 2) continue
        val added = body.children[0]
        if (added.kind == "local.val" && added.text == change.name && added.begin == change.declarationBegin &&
            added.end <= change.at + change.size && added.children.size == 2 &&
            added.children[0].kind == "integer" && added.children[1].text == "inferred") return true
    }
    false
}

class BootstrapAnalysisReplayInputs(
    val syntax: BootstrapModuleSyntaxInputs,
    val metadata: array<string>,
    val syntaxImportUses: array<string> = [],
    val checkedImportUses: array<string> = []
)

fun bootstrapAnalysisReplayStrings(left: array<string>, right: array<string>): bool {
    if (left.size != right.size) return false
    for (index in 0 until left.size) {
        if (left[index] != right[index]) return false
    }
    true
}

fun bootstrapAnalysisReplayInputsAgree(before: BootstrapAnalysisReplayInputs,
    after: BootstrapAnalysisReplayInputs, path: string, change: BootstrapAnalysisBodyInsert): bool {
    val left = before.syntax
    val right = after.syntax
    if (!left.replayable || !right.replayable ||
        !bootstrapAnalysisReplayStrings(before.metadata, after.metadata) ||
        !bootstrapAnalysisReplayStrings(before.syntaxImportUses, after.syntaxImportUses) ||
        !bootstrapAnalysisReplayStrings(left.paths, right.paths) ||
        !bootstrapAnalysisReplayStrings(left.hosts, right.hosts) ||
        !bootstrapAnalysisReplayStrings(left.aliases, right.aliases) ||
        !bootstrapAnalysisReplayStrings(left.expansions, right.expansions)) return false
    var changed = false
    for (index in 0 until left.paths.size) {
        if (left.sources[index] == right.sources[index]) continue
        if (changed || left.paths[index] != path || left.hosts[index] != "") return false
        val prepared = bootstrapAnalysisBodyChange(left.sources[index], right.sources[index])
        if (prepared == null || prepared.line != change.line || prepared.previousLine != change.previousLine) return false
        changed = true
    }
    changed
}

fun bootstrapAnalysisReplayOccurrence(set: BootstrapAnalysisOccurrenceSet,
    change: BootstrapAnalysisBodyInsert, id: string): BootstrapAnalysisOccurrenceSet? {
    val begins: array<int> = []
    val ends: array<int> = []
    val ids: array<string> = []
    val types: array<string> = []
    var inserted = id == ""
    var replaced = false
    for (i in 0 until set.begins.size) {
        val begin = set.begins[i]
        val end = set.ends[i]
        if (begin < change.at && end > change.at) return null
        if (begin >= change.at && !inserted) {
            begins.append(change.nameBegin)
            ends.append(change.nameEnd)
            ids.append(id)
            types.append("")
            inserted = true
        }
        if (begin >= change.at && begin < change.at + change.removed) {
            if (id == "" || replaced || end > change.at + change.removed || set.ids[i] != id || set.types[i] != "") return null
            replaced = true
            continue
        }
        val shift = if (begin < change.at) 0 else change.size - change.removed
        begins.append(begin + shift)
        ends.append(end + shift)
        ids.append(set.ids[i])
        types.append(set.types[i])
    }
    if (!inserted || (id != "" && change.removed != 0 && !replaced)) return null
    BootstrapAnalysisOccurrenceSet(begins, ends, ids, types)
}
