// Replay checked results across a narrowly verified, type-inert body edit.
// Prove that both sources reduce to the same text and check the parsed body.
// Other edits go through the ordinary checker.
import "analysis_service.ab"
import "module.ab"
import "parser.ab"
import "lexer.ab"
import "abla/text"
import "overload.ab"

class BootstrapAnalysisBodyInsert(
    val at: int,
    val size: int,
    val declarationBegin: int,
    val name: string,
    val nameBegin: int,
    val nameEnd: int,
    val line: string,
    val removed: int = 0,
    val previousLine: string = "",
    val comment: bool = false
)

fun bootstrapAnalysisBodyDecimal(text: string): bool {
    if (text.size == 0 || text.size >= 10) return false
    for (index in 0 until text.size) {
        if (text[index] < 48 || text[index] > 57) return false
    }
    true
}

fun bootstrapAnalysisBodyInsertion(before: string, after: string): BootstrapAnalysisBodyInsert? {
    val size = after.size - before.size
    if (size <= 0 || size > 256) return null
    var common = 0
    while (common < before.size && before[common] == after[common]) common = common + 1
    var at = bootstrapAnalysisLineStart(before, common)
    // An inserted line can share its entire prefix with the following line.
    while (at <= common && at + size <= after.size) {
        if (after[at + size - 1] == 10 &&
            after.slice(at + size, after.size) == before.slice(at, before.size)) {
            val line = after.slice(at, at + size)
            val tokens = bootstrapLexShared(line.slice(0, line.size - 1))
            if (tokens.size == 1 && line.trim().startsWith("// ")) {
                return BootstrapAnalysisBodyInsert(at, size, at, "", 0, 0, line, 0, "", true)
            }
            if (tokens.size == 5 &&
                bootstrapTokenText(line, tokens[0]) == "val" &&
                tokens[1].kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
                tokens[2].kind == BOOTSTRAP_TOKEN_EQUAL &&
                tokens[3].kind == BOOTSTRAP_TOKEN_INTEGER) {
                val name = bootstrapTokenText(line, tokens[1])
                val digits = bootstrapTokenText(line, tokens[3])
                // Require the single new name to be fresh throughout the
                // source, including quoted text and interpolation.
                if (bootstrapAnalysisBodyDecimal(digits) && before.indexOf(name) < 0 && !name.startsWith("__abla_") &&
                    !line.contains("//") && !line.contains("/*")) {
                    return BootstrapAnalysisBodyInsert(at, size, at + tokens[0].begin, name,
                        at + tokens[1].begin, at + tokens[1].end, line)
                }
            }
            return null
        }
        val end = before.indexOf("\n", at)
        if (end < 0) return null
        at = end + 1
    }
    null
}

// Both sources must add the same kind of line to one exact base source.
fun bootstrapAnalysisBodyReplacement(before: string, after: string): BootstrapAnalysisBodyInsert? {
    var first = 0
    while (first < before.size && first < after.size && before[first] == after[first]) first = first + 1
    if (first == before.size || first == after.size) return null
    val start = bootstrapAnalysisLineStart(before, first)
    val oldEnd = before.indexOf("\n", first)
    val newEnd = after.indexOf("\n", first)
    if (oldEnd < 0 || newEnd < 0 || oldEnd - start >= 256 || newEnd - start >= 256) return null
    val left = before.slice(0, start)
    val right = before.slice(oldEnd + 1, before.size)
    val base = "$left$right"
    val old = bootstrapAnalysisBodyInsertion(base, before)
    val fresh = bootstrapAnalysisBodyInsertion(base, after)
    if (old == null || fresh == null || old.at != fresh.at || old.name != fresh.name ||
        old.comment != fresh.comment) return null
    BootstrapAnalysisBodyInsert(fresh.at, fresh.size, fresh.declarationBegin, fresh.name,
        fresh.nameBegin, fresh.nameEnd, fresh.line, old.size, old.line, fresh.comment)
}

// Only the digits of a standalone decimal literal may change. The parsed
// body check below establishes that this line is the function's result.
fun bootstrapAnalysisBodyResult(before: string, after: string): BootstrapAnalysisBodyInsert? {
    var first = 0
    while (first < before.size && first < after.size && before[first] == after[first]) first = first + 1
    val start = bootstrapAnalysisLineStart(before, first)
    val oldEnd = before.indexOf("\n", first)
    val newEnd = after.indexOf("\n", first)
    if (oldEnd < 0 || newEnd < 0 || oldEnd - start >= 256 || newEnd - start >= 256 ||
        before.slice(oldEnd, before.size) != after.slice(newEnd, after.size)) return null
    var begin = start
    while (begin < first && (after[begin] == 32 || after[begin] == 9)) begin = begin + 1
    if (begin == start) return null
    val oldDigits = before.slice(begin, oldEnd)
    val newDigits = after.slice(begin, newEnd)
    if (!bootstrapAnalysisBodyDecimal(oldDigits) || !bootstrapAnalysisBodyDecimal(newDigits) ||
        (oldDigits.size > 1 && oldDigits[0] == 48) ||
        (newDigits.size > 1 && newDigits[0] == 48)) return null
    BootstrapAnalysisBodyInsert(begin, newDigits.size, begin, "", 0, 0, newDigits, oldDigits.size, oldDigits)
}

fun bootstrapAnalysisBodyChange(before: string, after: string): BootstrapAnalysisBodyInsert? {
    val insertion = bootstrapAnalysisBodyInsertion(before, after)
    if (insertion != null) return insertion
    val replacement = bootstrapAnalysisBodyReplacement(before, after)
    if (replacement != null) return replacement
    val result = bootstrapAnalysisBodyResult(before, after)
    if (result != null) return result
    val removed = bootstrapAnalysisBodyInsertion(after, before)
    if (removed == null || !removed.comment) return null
    BootstrapAnalysisBodyInsert(removed.at, 0, removed.at, "", 0, 0, "", removed.size, removed.line, true)
}

fun bootstrapAnalysisPlainBodyChange(parsed: BootstrapParseResult, change: BootstrapAnalysisBodyInsert): bool {
    if (parsed.errors != 0 || parsed.extensionErrors != 0) return false
    for (declaration in parsed.declarations) {
        val body = declaration.expression
        if (declaration.kind != "fun" || declaration.resultType == "inferred" ||
            declaration.typeParameters.size != 0 || declaration.annotations.size != 0 ||
            declaration.extensionOwner != "" || declaration.generatedNamespace != "" ||
            body.kind != "block" || body.begin >= change.at || body.end <= change.at + change.size ||
            body.children.size == 0) continue
        // At the first line after the opening brace, the comment and its
        // newline only extend the separators consumed by parseBlockBody.
        // This excludes raw strings, continuations and subparser bodies.
        if (change.comment) {
            if (body.begin + 2 == change.at && body.children[0].begin >= change.at + change.size) return true
            continue
        }
        if (change.name == "") {
            val result = body.children[body.children.size - 1]
            if (declaration.resultType == "int" && result.kind == "integer" &&
                result.begin == change.at && result.end == change.at + change.size) return true
            continue
        }
        if (body.children.size < 2) continue
        val added = body.children[0]
        if (added.kind == "local.val" && added.text == change.name && added.begin == change.declarationBegin &&
            added.end <= change.at + change.size && added.children.size == 2 &&
            added.children[0].kind == "integer" && added.children[1].text == "inferred") return true
    }
    false
}

// `records`: the project's classes whose fields the body reads (bootstrapAnalysisScalarRecord), the functions of other modules it calls
// (bootstrapAnalysisScalarSignature), and the document's global values it reads (bootstrapAnalysisScalarGlobal).
class BootstrapAnalysisScalarEdit(val splice: BootstrapAnalysisBodyInsert, val declaration: int, val callees: array<int>,
    val records: array<BootstrapDeclaration> = [])

fun bootstrapAnalysisScalarType(type: string): bool =
    type == "int" || type == "i64" || type == "f64" || type == "bool"

// No global reads. Direct calls, when admitted, still need a separate proof
// for their complete lookup bucket and the callee's checking interface.
// `strings` are the names of string and scalar-array parameters: read as values and through `.size`, an index and a `for`. `members`
// are the scalar and string fields of class parameters, as `p.x`, their string and scalar-array fields again as `seq:p.x`
// (bootstrapAnalysisSequence), and the global values it may read, as `global:name`.
fun bootstrapAnalysisScalarExpression(expression: BootstrapExpression, parameters: array<string>, depth: int, calls: bool,
    strings: array<string> = [], members: array<string> = []): bool {
    if (depth > 24) return false
    val kind = expression.kind
    if (kind == "identifier") {
        for (name in parameters) if (name == expression.text) return true
        // A string or scalar-array parameter as a value: compared, or passed to a function of the module.
        for (name in strings) if (name == expression.text) return true
        // A class parameter as a value: passed to a function, listed as `p.`.
        for (member in members) if (member == "${expression.text}.") return true
        // A global value of the document (bootstrapAnalysisScalarGlobal), listed as `global:name`.
        for (member in members) if (member == "global:${expression.text}") return true
        return false
    }
    if (kind == "integer" || kind == "float" || kind == "true" || kind == "false") return true
    // A plain string literal (a template reads what it interpolates).
    if (kind == "string" && expression.children.size == 0) return true
    // A block of statements (bootstrapAnalysisScalarStatement) and a scalar result, which may be a `return`.
    if (kind == "block" && expression.children.size >= 1) {
        val scope: array<string> = []
        for (name in parameters) scope.append(name)
        for (index in 0 until expression.children.size - 1) {
            if (!bootstrapAnalysisScalarStatement(expression.children[index], scope, depth + 1, calls, strings, members)) return false
        }
        val result = expression.children[expression.children.size - 1]
        return if (result.kind == "return") bootstrapAnalysisScalarReturn(result, scope, depth + 1, calls, strings, members)
            else bootstrapAnalysisScalarExpression(result, scope, depth + 1, calls, strings, members)
    }
    // `when (subject) { v -> body … else -> body }`: value matches only (no `is`), each body a scalar expression.
    if (kind == "when") return bootstrapAnalysisScalarWhen(expression, parameters, depth + 1, calls, strings, members, false)
    val arity = if (kind == "if") 3
        else if (kind == "block" || kind == "unary-" || kind == "unary!") 1
        else if (kind == "+" || kind == "-" || kind == "*" || kind == "<" || kind == ">" ||
            kind == "<=" || kind == ">=" || kind == "==" || kind == "!=" || kind == "&&" || kind == "||") 2
        // The primitive arithmetic and bit operators: the operand types choose the primitive, and an operator declaration anywhere in
        // the project already sends the edit to full typing (bootstrapAnalysisScalarChange).
        else if (kind == "/" || kind == "%" || kind == "&" || kind == "|" || kind == "^" ||
            kind == "<<" || kind == ">>" || kind == ">>>") 2
        else if (calls && kind == "call") expression.children.size
        else -1
    // A string parameter's size and bytes: `s.size`, `s[i]`. A project that extends `string` or declares a type of that name leaves them to
    // full typing (bootstrapAnalysisScalarChange).
    // A class parameter's scalar field: `p.x`. The class is the document's, unchanged by the edit, and its name has no other
    // declaration and no extension in the project (bootstrapAnalysisScalarChange).
    if (kind == "member" && expression.children.size == 1) {
        val read = bootstrapAnalysisMemberPath(expression)
        var known = false
        if (read != "") for (member in members) if (member == read) known = true
        // An element's field: its index must be admissible too.
        if (known) return !read.contains("[]") || bootstrapAnalysisScalarIndexes(expression, parameters, depth + 1, calls, strings, members)
    }
    // A call of its scalar method with scalar arguments: `p.m(a)`, listed as `p.m(1` (bootstrapAnalysisScalarMethod).
    if (kind == "member.call" && expression.children.size >= 1 && expression.children[0].kind == "identifier") {
        val call = "${expression.children[0].text}.${expression.text}(${expression.children.size - 1}"
        var known = false
        for (member in members) if (member == call) known = true
        if (!known) return false
        for (index in 1 until expression.children.size) {
            if (!bootstrapAnalysisScalarExpression(expression.children[index], parameters, depth + 1, calls, strings, members)) return false
        }
        return true
    }
    if (kind == "member" && expression.text == "size" && expression.children.size == 1) return bootstrapAnalysisSequence(expression.children[0], strings, members)
    if (kind == "index" && expression.children.size == 2) {
        return bootstrapAnalysisSequence(expression.children[0], strings, members) &&
            bootstrapAnalysisScalarExpression(expression.children[1], parameters, depth + 1, calls, strings, members)
    }
    if (arity < 0 || expression.children.size != arity) return false
    for (child in expression.children) {
        if (!bootstrapAnalysisScalarExpression(child, parameters, depth + 1, calls, strings, members)) return false
    }
    true
}

fun bootstrapAnalysisScalarFunction(declaration: BootstrapDeclaration, calls: bool = false,
    classes: Map<string, BootstrapDeclaration> = Map(), globals: Map<string, BootstrapDeclaration> = Map()): bool {
    if (declaration.kind != "fun" || !bootstrapAnalysisScalarType(declaration.resultType) ||
        declaration.isTrusted || declaration.isResource || declaration.isNoEscape ||
        declaration.annotations.size != 0 || declaration.typeParameters.size != 0 ||
        declaration.extensionOwner != "" || declaration.externalLibrary != "" ||
        declaration.generatedNamespace != "" || declaration.name == "main" ||
        declaration.name.startsWith("__abla_")) return false
    // Scalar parameters, and string ones read through their size and bytes.
    val scalars: array<string> = []
    val strings: array<string> = []
    val members: array<string> = []
    for (index in 0 until declaration.parameterTypes.size) {
        val type = declaration.parameterTypes[index]
        val name = declaration.parameters[index]
        val record = classes.get(type)
        if (bootstrapAnalysisScalarType(type)) scalars.append(name)
        // A string or an array of scalars: read through its size, an index and a `for`.
        else if (type == "string" || bootstrapAnalysisScalarArray(type)) strings.append(name)
        // An array of a class: read through its size, an element's fields (`ds[i].x`, listed as `ds[].x`) and a `for`, whose variable
        // reads the same fields (bootstrapAnalysisScalarStatement).
        else if (bootstrapAnalysisRecordArray(type, classes) != "") {
            strings.append(name)
            val element = classes.get(bootstrapAnalysisRecordArray(type, classes))
            if (element != null) bootstrapAnalysisScalarFields("$name[]", element, classes, members, 1)
        }
        else if (record != null) {
            // The parameter's own name, so that no local shadows it.
            members.append("$name.")
            bootstrapAnalysisScalarFields(name, record, classes, members, 0)
            for (method in record.methods) {
                if (bootstrapAnalysisScalarMethod(record, method)) members.append("$name.${method.name}(${method.parameters.size}")
            }
        } else return false
    }
    // The global values it names.
    if (globals.size > 0) {
        val names: Map<string, int> = Map()
        bootstrapAnalysisScalarIdentifierNames(declaration.expression, names)
        for (name in names.keys()) if (globals.has(name)) members.append("global:$name")
    }
    for (kind in declaration.parameterKinds) if (kind != "parameter") return false
    for (defaultValue in declaration.parameterDefaults) if (defaultValue.kind != "missing") return false
    bootstrapAnalysisScalarExpression(declaration.expression, scalars, 0, calls, strings, members)
}

/** Whether `method` of `record` is one a checked body may call: a function of written scalar parameter and result types without
 *  defaults, type parameters or annotations, the only method of its name. The checker is given its interface with a placeholder body
 *  (bootstrapAnalysisCheckScalarBody), as for a called function of the module. */
fun bootstrapAnalysisScalarMethod(record: BootstrapDeclaration, method: BootstrapDeclaration): bool {
    if (method.kind != "fun" || !bootstrapAnalysisScalarType(method.resultType) || method.typeParameters.size != 0 ||
        method.annotations.size != 0 || method.isTrusted || method.isResource || method.isNoEscape ||
        method.externalLibrary != "" || method.generatedNamespace != "" || method.name.startsWith("__abla_") ||
        bootstrapIsOperatorDeclaration(method)) return false
    for (type in method.parameterTypes) if (!bootstrapAnalysisScalarType(type)) return false
    for (kind in method.parameterKinds) if (kind != "parameter") return false
    for (value in method.parameterDefaults) if (value.kind != "missing") return false
    var named = 0
    for (other in record.methods) if (other.name == method.name) named = named + 1
    named == 1
}

/** Whether `declaration` is a class whose fields a checked body may read: no type parameters, conformances, annotations or ownership;
 *  every constructor parameter a `val` or `var` field of scalar or string type, defaulted at most by a constant; no method named
 *  like a field. The checker is given it with only the methods a body may call (bootstrapAnalysisScalarMethod), their bodies placeholders
 *  (bootstrapAnalysisCheckScalarBody). */
fun bootstrapAnalysisScalarRecord(declaration: BootstrapDeclaration): bool {
    if (declaration.kind != "class" || declaration.typeParameters.size != 0 || declaration.conformances.size != 0 ||
        declaration.annotations.size != 0 || declaration.isTrusted || declaration.isResource || declaration.isNoEscape ||
        declaration.isSealed || declaration.extensionOwner != "" || declaration.externalLibrary != "" ||
        declaration.generatedNamespace != "" || declaration.parameters.size == 0 ||
        declaration.parameterKinds.size != declaration.parameters.size ||
        declaration.parameterDefaults.size != declaration.parameters.size) return false
    for (index in 0 until declaration.parameters.size) {
        val kind = declaration.parameterKinds[index]
        val type = declaration.parameterTypes[index]
        val value = declaration.parameterDefaults[index]
        // A delegated property is rewritten into other declarations (delegated_properties.ab).
        if ((kind != "val" && kind != "var") || value.kind == "delegate.initializer") return false
        // A field of another type is never read; the checker is given it as an `int` without a default (bootstrapAnalysisScalarRecordView).
        if ((bootstrapAnalysisScalarType(type) || type == "string") && value.kind != "missing" &&
            !bootstrapAnalysisScalarExpression(value, [], 0, false) &&
            !(type == "string" && value.kind == "string" && value.children.size == 0)) return false
        for (method in declaration.methods) if (method.name == declaration.parameters[index]) return false
    }
    true
}

/** Whether `declaration`, a function of another module, is one a checked body may call: a public plain function of scalar, string or
 *  scalar-array parameters without defaults and a scalar result. (With a class parameter, the checker leaves its call's occurrence
 *  untyped, which the splice refuses.) */
fun bootstrapAnalysisScalarSignature(declaration: BootstrapDeclaration): bool {
    if (declaration.kind != "fun" || !bootstrapAnalysisScalarType(declaration.resultType) || declaration.isPrivate ||
        declaration.isTrusted || declaration.isResource || declaration.isNoEscape || declaration.annotations.size != 0 ||
        declaration.typeParameters.size != 0 || declaration.extensionOwner != "" || declaration.externalLibrary != "" ||
        declaration.generatedNamespace != "" || declaration.name.startsWith("__abla_") ||
        declaration.parameterKinds.size != declaration.parameters.size ||
        declaration.parameterDefaults.size != declaration.parameters.size) return false
    for (index in 0 until declaration.parameters.size) {
        val type = declaration.parameterTypes[index]
        if (declaration.parameterKinds[index] != "parameter" || declaration.parameterDefaults[index].kind != "missing" ||
            (!bootstrapAnalysisScalarType(type) && type != "string" && !bootstrapAnalysisScalarArray(type))) return false
    }
    true
}

/** Whether `record` (bootstrapAnalysisScalarRecord) is one a checked body may construct: each of its fields of a scalar or string type, so
 *  that the checker is given it as it is (bootstrapAnalysisScalarRecordView). */
fun bootstrapAnalysisScalarPlainRecord(record: BootstrapDeclaration): bool {
    for (type in record.parameterTypes) if (!bootstrapAnalysisScalarType(type) && type != "string") return false
    true
}

/** Whether every call of `name` in `expression` passes `count` arguments. */
fun bootstrapAnalysisScalarCallArity(expression: BootstrapExpression, name: string, count: int): bool {
    if (expression.kind == "call" && expression.text == name && expression.children.size != count) return false
    for (child in expression.children) if (!bootstrapAnalysisScalarCallArity(child, name, count)) return false
    true
}

/** The modules `source` (the module at `path`) imports directly, by path: neither under an alias nor only for their contract. */
fun bootstrapAnalysisDirectImports(source: string, path: string): Map<string, bool> {
    val modules: Map<string, bool> = Map()
    val scan = bootstrapScanImportsWithIdentity(source, path)
    for (edge in scan.edges) {
        if (edge.alias == "" && !edge.contractOnly && !edge.provider) modules.set(bootstrapResolveImport(path, edge.source), true)
    }
    modules
}

/** Whether `declaration` is a global value a checked body may read: a plain top-level `val` or `var` of a written scalar type, or of an
 *  inferred one with a literal initializer. The checker is given it with a placeholder initializer (bootstrapAnalysisCheckScalarBody). */
fun bootstrapAnalysisScalarGlobal(declaration: BootstrapDeclaration): bool {
    if ((declaration.kind != "val" && declaration.kind != "var") || declaration.extensionOwner != "" ||
        declaration.annotations.size != 0 || declaration.typeParameters.size != 0 || declaration.isTrusted ||
        declaration.isResource || declaration.isNoEscape || declaration.externalLibrary != "" ||
        declaration.generatedNamespace != "" || declaration.name.startsWith("__abla_")) return false
    val value = declaration.expression
    if (value.kind == "delegate.initializer") return false
    if (bootstrapAnalysisScalarType(declaration.resultType)) return true
    declaration.resultType == "inferred" && value.children.size == 0 &&
        (value.kind == "integer" || value.kind == "float" || value.kind == "true" || value.kind == "false")
}

/** The identifiers `expression` reads. */
fun bootstrapAnalysisScalarIdentifierNames(expression: BootstrapExpression, var names: Map<string, int>): void {
    if (expression.kind == "identifier") names.set(expression.text, 0)
    for (child in expression.children) bootstrapAnalysisScalarIdentifierNames(child, names)
    return
}

fun bootstrapAnalysisScalarCallNames(expression: BootstrapExpression, var names: Map<string, int>): void {
    if (expression.kind == "call") names.set(expression.text, 0)
    for (child in expression.children) bootstrapAnalysisScalarCallNames(child, names)
    return
}

fun bootstrapAnalysisScalarInterfaceMatches(surface: BootstrapDeclaration, prepared: BootstrapDeclaration, calls: bool,
    classes: Map<string, BootstrapDeclaration> = Map(), globals: Map<string, BootstrapDeclaration> = Map()): bool =
    bootstrapAnalysisScalarFunction(prepared, calls, classes, globals) && surface.sourceIdentity == prepared.sourceIdentity &&
    surface.resultType == prepared.resultType &&
    bootstrapAnalysisReplayStrings(surface.parameters, prepared.parameters) &&
    bootstrapAnalysisReplayStrings(surface.parameterTypes, prepared.parameterTypes) &&
    bootstrapAnalysisReplayStrings(surface.parameterKinds, prepared.parameterKinds)

fun bootstrapAnalysisCommonPrefix(before: string, after: string): int {
    var same = 0
    while (same < before.size && same < after.size && before[same] == after[same]) same = same + 1
    same
}

// Keep offsets fixed in the first interface slice. Admit only an explicit
// result-type change on a nullary scalar function, with an ordinary scalar
// body and unchanged text outside the result annotation and body.
fun bootstrapAnalysisScalarResultChange(before: string, after: string,
    parsed: BootstrapParseResult): BootstrapAnalysisBodyInsert? {
    if (before.size != after.size) return null
    val changed = bootstrapAnalysisCommonPrefix(before, after)
    if (changed == after.size) return null
    for (declaration in parsed.declarations) {
        val body = declaration.expression
        if (changed < declaration.begin || changed >= body.begin || body.end - declaration.begin > 1024 ||
            declaration.parameters.size != 0 || declaration.isPrivate ||
            !bootstrapAnalysisScalarFunction(declaration) ||
            before.slice(body.end, before.size) != after.slice(body.end, after.size)) continue
        val old = bootstrapParseWithIdentity(before.slice(declaration.begin, body.end), declaration.sourceIdentity)
        if (old.errors != 0 || old.extensionErrors != 0 || old.declarations.size != 1) return null
        val prior = old.declarations[0]
        val from = prior.resultType
        val to = declaration.resultType
        if (from == to || from.size != to.size || prior.parameters.size != 0 || prior.name != declaration.name ||
            prior.expression.begin != body.begin - declaration.begin ||
            prior.expression.end != body.end - declaration.begin ||
            !bootstrapAnalysisScalarFunction(prior)) return null
        val header = after.slice(declaration.begin, body.begin)
        val annotation = header.indexOf(": $to =")
        if (annotation < 0) return null
        val at = declaration.begin + annotation + 2
        if (changed < at || changed >= at + to.size || before.slice(at, at + from.size) != from ||
            before.slice(at + from.size, body.begin) != after.slice(at + to.size, body.begin)) return null
        return BootstrapAnalysisBodyInsert(at, body.end - at, declaration.begin, "", 0, 0,
            after.slice(at, body.end), body.end - at, before.slice(at, body.end))
    }
    null
}

fun bootstrapAnalysisScalarChange(before: string, after: string,
    parsed: BootstrapParseResult, project: BootstrapParseResult): BootstrapAnalysisScalarEdit? {
    if (parsed.errors != 0 || parsed.extensionErrors != 0) return null
    val changed = bootstrapAnalysisCommonPrefix(before, after)
    val shift = after.size - before.size
    // The project's classes a checked body may read fields of, by name, as prepared: only this document changed (the caller), and its
    // text outside the edited body is the same before and after, so their fields are the same now. Each is the only top-level declaration
    // of its name in the project.
    val classes: Map<string, BootstrapDeclaration> = Map()
    val names: Map<string, int> = Map()
    for (candidate in project.declarations) {
        if (candidate.extensionOwner != "") continue
        // By source name: a module-private declaration is prepared as `__abla_module_<hex>__name`.
        val name = bootstrapCanonicalDeclarationSourceName(candidate.name)
        names.set(name, (names.get(name) ?? 0) + 1)
        if (bootstrapAnalysisScalarRecord(candidate)) classes.set(candidate.name, candidate)
    }
    for (name in classes.keys()) if ((names.get(name) ?? 0) != 1) classes.remove(name)
    // The document's global values a checked body may read, as parsed now (their offsets, after the edited body, have moved), each the
    // only top-level declaration of its name in the project. Another module's would need its import, which the body's reads keep used.
    val globals: Map<string, BootstrapDeclaration> = Map()
    for (candidate in parsed.declarations) {
        if (bootstrapAnalysisScalarGlobal(candidate) && (names.get(candidate.name) ?? 0) == 1) globals.set(candidate.name, candidate)
    }
    for (index in 0 until parsed.declarations.size) {
        val declaration = parsed.declarations[index]
        val body = declaration.expression
        val start = bootstrapAnalysisBodyStart(after, body.begin)
        val end = bootstrapAnalysisBodyEnd(after, start, body.end)
        val oldEnd = end - shift
        if (changed < start || changed >= end || end - start > 1024 ||
            oldEnd <= start || oldEnd > before.size || oldEnd - start > 1024 ||
            before.slice(oldEnd, before.size) != after.slice(end, after.size) ||
            !bootstrapAnalysisScalarFunction(declaration, true, classes, globals)) continue
        val old = bootstrapParseWithIdentity(before.slice(declaration.begin, oldEnd), declaration.sourceIdentity)
        if (old.errors != 0 || old.extensionErrors != 0 || old.declarations.size != 1 ||
            !bootstrapAnalysisScalarFunction(old.declarations[0], true, classes, globals) ||
            bootstrapAnalysisBodyStart(before.slice(declaration.begin, oldEnd), old.declarations[0].expression.begin) != start - declaration.begin ||
            bootstrapAnalysisBodyEnd(before.slice(declaration.begin, oldEnd), start - declaration.begin,
                old.declarations[0].expression.end) != oldEnd - declaration.begin) return null
        val candidates: Map<string, int> = Map()
        bootstrapAnalysisScalarCallNames(old.declarations[0].expression, candidates)
        bootstrapAnalysisScalarCallNames(body, candidates)
        if (candidates.has(declaration.name)) return null
        // A local named like a function the body calls, or like the function itself, leaves the call's target to the full checker.
        // The locals are the document's symbols too: an edit that adds, removes or renames one rebuilds them through full typing.
        val oldLocals: Map<string, int> = Map()
        val locals: Map<string, int> = Map()
        bootstrapAnalysisScalarLocalNames(old.declarations[0].expression, oldLocals)
        bootstrapAnalysisScalarLocalNames(body, locals)
        if (!bootstrapAnalysisReplayStrings(oldLocals.keys(), locals.keys())) return null
        for (name in locals.keys()) if (candidates.has(name) || name == declaration.name) return null
        candidates.set(declaration.name, 0)
        // The classes of its parameters: each is the only top-level declaration of its name in the project (above) and must be extended
        // by nothing, so `p.x` names its field.
        val used: Map<string, int> = Map()
        for (type in declaration.parameterTypes) {
            if (classes.has(type)) used.set(type, 0)
            val element = bootstrapAnalysisRecordArray(type, classes)
            if (element != "") used.set(element, 0)
        }
        // A constructor call of a plain class (bootstrapAnalysisScalarPlainRecord): the class, not a function, is what the name is.
        for (name in candidates.keys()) {
            val record = classes.get(name)
            if (record == null) continue
            // Every field passed: the full pipeline fills in defaulted arguments before typing, the checker does not.
            if (!bootstrapAnalysisScalarPlainRecord(record) || !bootstrapAnalysisScalarCallArity(body, name, record.parameters.size)) return null
            used.set(name, 0)
            candidates.remove(name)
        }
        for (name in used.keys()) if (candidates.has(name) || locals.has(name)) return null
        // Require exactly one global candidate for each spelling and no
        // operator selection. A generic or alias owner could name a scalar.
        val readsStrings = bootstrapAnalysisReadsString(old.declarations[0].expression) || bootstrapAnalysisReadsString(body)
        for (item in 0 until project.declarations.size) {
            val candidate = project.declarations[item]
            if (bootstrapIsOperatorDeclaration(candidate)) return null
            // What `s.size` and `s[i]` could also name: a `size` extension of string or an array, or a type of either name (an indexing
            // operator is an operator declaration, refused above). A function so named, or another type's member, changes neither.
            if (readsStrings && (((candidate.extensionOwner == "string" || candidate.extensionOwner.startsWith("array")) &&
                candidate.name == "size") || ((candidate.name == "string" || candidate.name == "array") &&
                candidate.extensionOwner == "" && candidate.kind != "fun"))) return null
            for (method in candidate.methods) if (bootstrapIsOperatorDeclaration(method)) return null
            if (used.has(candidate.extensionOwner)) return null
            // By source name, the standard library's declarations included: a module-private one is prepared under its mangled name.
            val sourceName = bootstrapCanonicalDeclarationSourceName(candidate.name)
            val known = candidates.get(sourceName)
            if (candidate.extensionOwner == "" && known != null) {
                if (known != 0) return null
                candidates.set(sourceName, item + 1)
            }
        }
        val own = candidates.get(declaration.name) ?? 0
        if (own == 0 || !bootstrapAnalysisScalarInterfaceMatches(declaration, project.declarations[own - 1], true, classes, globals)) return null
        // Only a same-module, call-free scalar function can be reused as a
        // signature. It has no outgoing lookup, imported use or global effect.
        val callees: array<int> = []
        val local: Map<string, int> = Map()
        local.set(declaration.name, 0)
        for (item in 0 until parsed.declarations.size) {
            val callee = parsed.declarations[item]
            if (item == index || !candidates.has(callee.name)) continue
            val target = candidates.get(callee.name) ?? 0
            if (target == 0 || callee.sourceIdentity != declaration.sourceIdentity ||
                !bootstrapAnalysisScalarFunction(callee, false, classes) ||
                !bootstrapAnalysisScalarInterfaceMatches(callee, project.declarations[target - 1], false, classes)) return null
            callees.append(item)
            local.set(callee.name, 0)
            for (type in callee.parameterTypes) if (classes.has(type)) used.set(type, 0)
        }
        // A function of another module: one of a module this document imports directly (no alias, not only its contract), so the name
        // resolves as in full typing and its import is used by name (the syntax use facts, compared by the caller). Its interface, as
        // prepared (its document is unchanged), is what the checker gets; its body is not read.
        val external: array<BootstrapDeclaration> = []
        var imports: Map<string, bool>? = null
        for (name in candidates.keys()) {
            if (local.has(name)) continue
            val target = candidates.get(name) ?? 0
            if (target == 0) return null
            val callee = project.declarations[target - 1]
            if (callee.sourceIdentity == declaration.sourceIdentity || !bootstrapAnalysisScalarSignature(callee)) return null
            if (imports == null) imports = bootstrapAnalysisDirectImports(after, declaration.sourceIdentity)
            if (!(imports?.has(callee.sourceIdentity) ?? false)) return null
            external.append(callee)
        }
        // The classes of their fields, which a chain `p.f.x` reads.
        bootstrapAnalysisScalarUsedClasses(classes, used)
        // The classes the module's callees take: extended by nothing either, and named by no local.
        for (name in used.keys()) if (locals.has(name)) return null
        for (candidate in project.declarations) if (used.has(candidate.extensionOwner)) return null
        val splice = BootstrapAnalysisBodyInsert(start, end - start, start, "", 0, 0,
            after.slice(start, end), oldEnd - start, before.slice(start, oldEnd))
        val records: array<BootstrapDeclaration> = []
        for (name in used.keys()) {
            val record = classes.get(name)
            if (record == null) return null
            // Another module's: a private one is not this module's to name, which full typing reports.
            if (record.sourceIdentity != declaration.sourceIdentity) {
                if (record.isPrivate) return null
                records.append(record)
                continue
            }
            // One of this document: as parsed now, where its offsets (in its field ids) are, after the edited body.
            var found = false
            for (candidate in parsed.declarations) {
                if (candidate.name != name || candidate.extensionOwner != "" || !bootstrapAnalysisScalarRecord(candidate)) continue
                records.append(candidate)
                found = true
                break
            }
            if (!found) return null
        }
        for (callee in external) records.append(callee)
        // The global values it reads.
        val read: Map<string, int> = Map()
        bootstrapAnalysisScalarIdentifierNames(body, read)
        for (name in read.keys()) {
            val global = globals.get(name)
            if (global != null) records.append(global)
        }
        return BootstrapAnalysisScalarEdit(splice, index, callees, records)
    }
    null
}

// The same entire expression must be present in both prepared snapshots;
// transformations or a shift of anything outside it void the proof.
fun bootstrapAnalysisPreparedScalarChange(before: string, after: string, change: BootstrapAnalysisBodyInsert): bool {
    val at = bootstrapAnalysisCommonPrefix(before, after) - bootstrapAnalysisCommonPrefix(change.previousLine, change.line)
    at >= 0 && at + change.removed <= before.size && at + change.size <= after.size &&
        before.slice(at, at + change.removed) == change.previousLine &&
        after.slice(at, at + change.size) == change.line &&
        before.slice(at + change.removed, before.size) == after.slice(at + change.size, after.size)
}

class BootstrapAnalysisReplayInputs(
    val syntax: BootstrapModuleSyntaxInputs,
    val metadata: array<string>,
    val syntaxImportUses: array<string> = [],
    val checkedImportUses: array<string> = []
)

fun bootstrapAnalysisReplayStrings(left: array<string>, right: array<string>): bool {
    if (left.size != right.size) return false
    for (index in 0 until left.size) {
        if (left[index] != right[index]) return false
    }
    true
}

fun bootstrapAnalysisReplayInputsAgree(before: BootstrapAnalysisReplayInputs,
    after: BootstrapAnalysisReplayInputs, path: string, change: BootstrapAnalysisBodyInsert, scalar: bool = false): bool {
    val left = before.syntax
    val right = after.syntax
    if (!left.replayable || !right.replayable ||
        !bootstrapAnalysisReplayStrings(before.metadata, after.metadata) ||
        !bootstrapAnalysisReplayStrings(before.syntaxImportUses, after.syntaxImportUses) ||
        !bootstrapAnalysisReplayStrings(left.paths, right.paths) ||
        !bootstrapAnalysisReplayStrings(left.hosts, right.hosts) ||
        !bootstrapAnalysisReplayStrings(left.aliases, right.aliases) ||
        !bootstrapAnalysisReplayStrings(left.expansions, right.expansions)) return false
    var changed = false
    for (index in 0 until left.paths.size) {
        if (left.sources[index] == right.sources[index]) continue
        if (changed || left.paths[index] != path || left.hosts[index] != "") return false
        if (scalar) {
            if (!bootstrapAnalysisPreparedScalarChange(left.sources[index], right.sources[index], change)) return false
        } else {
            val prepared = bootstrapAnalysisBodyChange(left.sources[index], right.sources[index])
            if (prepared == null || prepared.comment != change.comment ||
                prepared.line != change.line || prepared.previousLine != change.previousLine) return false
        }
        changed = true
    }
    changed
}

fun bootstrapAnalysisReplayOccurrence(set: BootstrapAnalysisOccurrenceSet,
    change: BootstrapAnalysisBodyInsert, id: string): BootstrapAnalysisOccurrenceSet? {
    val begins: array<int> = []
    val ends: array<int> = []
    val ids: array<string> = []
    val types: array<string> = []
    var inserted = id == ""
    var replaced = false
    for (i in 0 until set.begins.size) {
        val begin = set.begins[i]
        val end = set.ends[i]
        if (begin < change.at && end > change.at) return null
        if (begin >= change.at && !inserted) {
            begins.append(change.nameBegin)
            ends.append(change.nameEnd)
            ids.append(id)
            types.append("")
            inserted = true
        }
        if (begin >= change.at && begin < change.at + change.removed) {
            if (id == "" || replaced || end > change.at + change.removed || set.ids[i] != id || set.types[i] != "") return null
            replaced = true
            continue
        }
        val shift = if (begin < change.at) 0 else change.size - change.removed
        begins.append(begin + shift)
        ends.append(end + shift)
        ids.append(set.ids[i])
        types.append(set.types[i])
    }
    if (!inserted || (id != "" && change.removed != 0 && !replaced)) return null
    BootstrapAnalysisOccurrenceSet(begins, ends, ids, types)
}

fun bootstrapAnalysisReplayScalarOccurrence(old: BootstrapAnalysisOccurrenceSet, fresh: BootstrapAnalysisOccurrenceSet,
    change: BootstrapAnalysisBodyInsert, requireTypes: bool = true): BootstrapAnalysisOccurrenceSet? {
    val begins: array<int> = []
    val ends: array<int> = []
    val ids: array<string> = []
    val types: array<string> = []
    val oldEnd = change.at + change.removed
    val newEnd = change.at + change.size
    val shift = newEnd - oldEnd
    var inserted = false
    for (index in 0 until (old.begins.size + 1)) {
        val atEnd = index == old.begins.size
        if (!inserted && (atEnd || old.begins[index] >= change.at)) {
            for (item in 0 until fresh.begins.size) {
                if (fresh.begins[item] < change.at || fresh.begins[item] >= newEnd) continue
                // A local's or loop variable's own name and a written built-in type carry no type in any analysis (the full one neither):
                // they are a binding and a type, not typed expressions.
                if (fresh.ends[item] > newEnd || fresh.ids[item] == "" ||
                    (requireTypes && fresh.types[item] == "" && !fresh.ids[item].contains("/local:") &&
                     !fresh.ids[item].contains("/for:") && !fresh.ids[item].contains("/abla/builtins/declarations.ab#"))) return null
                begins.append(fresh.begins[item])
                ends.append(fresh.ends[item])
                ids.append(fresh.ids[item])
                types.append(fresh.types[item])
            }
            inserted = true
        }
        if (atEnd) break
        val begin = old.begins[index]
        val end = old.ends[index]
        if (begin < change.at && end > change.at) return null
        if (begin >= change.at && begin < oldEnd) {
            if (end > oldEnd) return null
            continue
        }
        val delta = if (begin >= oldEnd) shift else 0
        begins.append(begin + delta)
        ends.append(end + delta)
        ids.append(old.ids[index])
        types.append(old.types[index])
    }
    BootstrapAnalysisOccurrenceSet(begins, ends, ids, types)
}

/** Where a written function body starts in `text` whose parsed expression begins at `begin`: there, or, when only opening parentheses
 *  and spaces stand between the header's `=` and it, at the first of them (a parenthesized expression begins inside its parentheses). */
fun bootstrapAnalysisBodyStart(text: string, begin: int): int {
    var cursor = begin
    while (cursor > 0 && (text[cursor - 1] == 40 || text[cursor - 1] == 32 || text[cursor - 1] == 9)) cursor = cursor - 1
    if (cursor == 0 || text[cursor - 1] != 61 || cursor == begin) return begin
    while (cursor < begin && (text[cursor] == 32 || text[cursor] == 9)) cursor = cursor + 1
    cursor
}

/** Where a written function body that starts at `start` in `text` (bootstrapAnalysisBodyStart) and whose parsed expression ends at `end`
 *  ends: past the closing parentheses that follow, as many as the body leaves open (a parenthesized expression ends inside its
 *  parentheses: `= (n)`, `= a >= (b)`). Only a `)` of the body can follow it there; a miscount (a parenthesis in a comment) only ends it
 *  early, which the caller's checks refuse. */
fun bootstrapAnalysisBodyEnd(text: string, start: int, end: int): int {
    var open = 0
    for (index in start until end) {
        if (text[index] == 40) open = open + 1
        else if (text[index] == 41) open = open - 1
    }
    var cursor = end
    var closed = end
    while (open > 0 && cursor < text.size) {
        val byte = text[cursor]
        if (byte == 41) {
            open = open - 1
            cursor = cursor + 1
            closed = cursor
        } else if (byte == 32 || byte == 9 || byte == 10 || byte == 13) cursor = cursor + 1
        else break
    }
    if (open == 0) closed else end
}

/** The names of the locals and loop variables in `expression`. */
fun bootstrapAnalysisScalarLocalNames(expression: BootstrapExpression, var names: Map<string, int>): void {
    if (expression.kind == "local.val" || expression.kind == "local.var") names.set(expression.text, 0)
    if (expression.kind == "for") names.set(bootstrapForName(expression), 0)
    for (child in expression.children) bootstrapAnalysisScalarLocalNames(child, names)
    return
}

/** Whether `statement`, in a block of a checked body, is one the subset checker types alone, adding the names it declares to `scope`:
 *  - `val` or `var` of a new name (no shadowing) of inferred, written scalar or `string` type, initialized from the names in scope; a
 *    `var` is listed as `var:name` as well;
 *  - an assignment (or compound assignment) of a `var` in scope;
 *  - `return` of a scalar expression;
 *  - `if` with statement branches, the else optional;
 *  - an unlabeled `while`, `do … while` or `for` over `a until b`, `a..b` or a string or scalar-array parameter, with a new name,
 *    and a statement body;
 *  - an unlabeled `break` or `continue`;
 *  - a `when` of value matches with statement bodies;
 *  - a block of these.
 *  A nested body's declarations end with it. */
fun bootstrapAnalysisScalarStatement(statement: BootstrapExpression, var scope: array<string>, depth: int, calls: bool,
    strings: array<string> = [], members: array<string> = []): bool {
    if (depth > 24) return false
    val kind = statement.kind
    if (kind == "local.val" || kind == "local.var") {
        if (statement.children.size != 2 || statement.children[1].kind != "type") return false
        val declared = statement.children[1].text
        if (declared != "inferred" && declared != "string" && !bootstrapAnalysisScalarType(declared)) return false
        if (!bootstrapAnalysisScalarNewName(statement.text, scope, strings, members) ||
            !bootstrapAnalysisScalarExpression(statement.children[0], scope, depth + 1, calls, strings, members)) return false
        scope.append(statement.text)
        if (kind == "local.var") scope.append("var:${statement.text}")
        return true
    }
    if (kind == "assign") {
        if (statement.children.size != 1) return false
        var mutable = false
        for (name in scope) if (name == "var:${statement.text}") mutable = true
        return mutable && bootstrapAnalysisScalarExpression(statement.children[0], scope, depth + 1, calls, strings, members)
    }
    if (kind == "return") return bootstrapAnalysisScalarReturn(statement, scope, depth + 1, calls, strings, members)
    if (kind == "if" && statement.children.size == 3) {
        return bootstrapAnalysisScalarExpression(statement.children[0], scope, depth + 1, calls, strings, members) &&
            bootstrapAnalysisScalarBody(statement.children[1], scope, depth + 1, calls, strings, members) &&
            (statement.children[2].kind == "missing" ||
             bootstrapAnalysisScalarBody(statement.children[2], scope, depth + 1, calls, strings, members))
    }
    if (kind == "while" && statement.children.size == 2 && statement.text == "") {
        return bootstrapAnalysisScalarExpression(statement.children[0], scope, depth + 1, calls, strings, members) &&
            bootstrapAnalysisScalarBody(statement.children[1], scope, depth + 1, calls, strings, members)
    }
    // The condition sees only the names outside the body.
    if (kind == "do.while" && statement.children.size == 2 && statement.text == "") {
        return bootstrapAnalysisScalarBody(statement.children[0], scope, depth + 1, calls, strings, members) &&
            bootstrapAnalysisScalarExpression(statement.children[1], scope, depth + 1, calls, strings, members)
    }
    // A range is built in: its bounds must be `i64`, whatever the project declares (bootstrapInferRange). So is iterating a string (its
    // bytes) or an array (bootstrapInferFor).
    if (kind == "for" && statement.children.size == 2 && bootstrapForLabelAt(statement.text) < 0) {
        val source = statement.children[0]
        val range = (source.kind == "range.until" || source.kind == "range.closed") && source.children.size == 2 &&
            bootstrapAnalysisScalarExpression(source.children[0], scope, depth + 1, calls, strings, members) &&
            bootstrapAnalysisScalarExpression(source.children[1], scope, depth + 1, calls, strings, members)
        if ((!range && !bootstrapAnalysisSequence(source, strings, members)) ||
            !bootstrapAnalysisScalarNewName(statement.text, scope, strings, members)) return false
        val inner: array<string> = []
        for (name in scope) inner.append(name)
        inner.append(statement.text)
        // Over an array of a class: the variable reads an element's fields (`ds[].x` as `d.x`), in the body only.
        val elements: array<string> = []
        for (member in members) elements.append(member)
        if (source.kind == "identifier") {
            val prefix = "${source.text}[]."
            // The element as a value too, when the array is of a class.
            for (member in members) if (member.startsWith(prefix)) {
                elements.append("${statement.text}.")
                break
            }
            for (member in members) {
                if (member.startsWith(prefix)) elements.append("${statement.text}.${member.slice(prefix.size, member.size)}")
                if (member.startsWith("seq:$prefix")) elements.append("seq:${statement.text}.${member.slice(prefix.size + 4, member.size)}")
            }
        }
        return bootstrapAnalysisScalarBody(statement.children[1], inner, depth + 1, calls, strings, elements)
    }
    if (kind == "break" || kind == "continue") return statement.text == "" && statement.children.size == 0
    if (kind == "when") return bootstrapAnalysisScalarWhen(statement, scope, depth + 1, calls, strings, members, true)
    if (kind == "block") return bootstrapAnalysisScalarBody(statement, scope, depth + 1, calls, strings, members)
    false
}

/** Whether `body`, a branch or loop body, is a statement or a block of them (bootstrapAnalysisScalarStatement), in a scope of its own. */
fun bootstrapAnalysisScalarBody(body: BootstrapExpression, scope: array<string>, depth: int, calls: bool,
    strings: array<string> = [], members: array<string> = []): bool {
    val inner: array<string> = []
    for (name in scope) inner.append(name)
    if (body.kind != "block") return bootstrapAnalysisScalarStatement(body, inner, depth + 1, calls, strings, members)
    for (statement in body.children) {
        if (!bootstrapAnalysisScalarStatement(statement, inner, depth + 1, calls, strings, members)) return false
    }
    true
}

/** Whether `expression`, a `when`, has an admissible subject and matches (values or `else`, no `is`) and bodies: scalar expressions, or
 *  statements (bootstrapAnalysisScalarBody) when it is one. Its children are the subject, then a match and its body for each match. */
fun bootstrapAnalysisScalarWhen(expression: BootstrapExpression, scope: array<string>, depth: int, calls: bool,
    strings: array<string>, members: array<string>, statement: bool): bool {
    if (depth > 24 || expression.children.size < 3 || expression.children.size % 2 != 1 ||
        !bootstrapAnalysisScalarExpression(expression.children[0], scope, depth + 1, calls, strings, members)) return false
    var index = 1
    while (index < expression.children.size) {
        val match = expression.children[index]
        val body = expression.children[index + 1]
        if (!(match.kind == "missing" && match.text == "else") &&
            !bootstrapAnalysisScalarExpression(match, scope, depth + 1, calls, strings, members)) return false
        if (statement && !bootstrapAnalysisScalarBody(body, scope, depth + 1, calls, strings, members)) return false
        if (!statement && !bootstrapAnalysisScalarExpression(body, scope, depth + 1, calls, strings, members)) return false
        index = index + 2
    }
    true
}

/** Whether a local may be named `name`: no parameter, local or loop variable in scope has that name, nor a class parameter. A global
 *  value of that name is shadowed where the local is in scope, as the identifier lookup has it (scope first). */
fun bootstrapAnalysisScalarNewName(name: string, scope: array<string>, strings: array<string>, members: array<string>): bool {
    for (other in scope) if (other == name) return false
    for (other in strings) if (other == name) return false
    for (member in members) if (member.startsWith("$name.")) return false
    true
}

/** Whether `statement` is `return <scalar expression>`, alone or as the one statement of a block. */
fun bootstrapAnalysisScalarReturn(statement: BootstrapExpression, scope: array<string>, depth: int, calls: bool,
    strings: array<string> = [], members: array<string> = []): bool {
    if (statement.kind == "block" && statement.children.size == 1) return bootstrapAnalysisScalarReturn(statement.children[0], scope, depth + 1, calls, strings, members)
    statement.kind == "return" && statement.children.size == 1 && statement.children[0].kind != "missing" &&
        bootstrapAnalysisScalarExpression(statement.children[0], scope, depth + 1, calls, strings, members)
}

/** Whether `type` is an array of a scalar type or of strings (an element is a value: compared, passed on, not read further). */
fun bootstrapAnalysisScalarArray(type: string): bool =
    type == "array<int>" || type == "array<i64>" || type == "array<f64>" || type == "array<bool>" || type == "array<string>"

/** Whether `expression` is a string or scalar array the body may read through `.size`, an index or a `for`: a parameter
 *  (bootstrapAnalysisStringName), or such a field of a class parameter, listed as `seq:p.x`. */
fun bootstrapAnalysisSequence(expression: BootstrapExpression, strings: array<string>, members: array<string>): bool {
    if (bootstrapAnalysisStringName(expression, strings)) return true
    val path = bootstrapAnalysisMemberPath(expression)
    if (expression.kind != "member" || path == "") return false
    val field = "seq:$path"
    for (member in members) if (member == field) return true
    false
}

/** The class of the elements of `type`, an array of one of `classes`, or "". */
fun bootstrapAnalysisRecordArray(type: string, classes: Map<string, BootstrapDeclaration>): string {
    if (!type.startsWith("array<") || !type.endsWith(">")) return ""
    val element = type.slice(6, type.size - 1)
    if (classes.has(element)) element else ""
}

/** `p.x`, `p.f.x` or `ds[i].x` (as `ds[].x`) as that text, or "" for any other expression. */
fun bootstrapAnalysisMemberPath(expression: BootstrapExpression): string {
    if (expression.kind == "identifier") return expression.text
    if (expression.kind == "index" && expression.children.size == 2 && expression.children[0].kind == "identifier") {
        return "${expression.children[0].text}[]"
    }
    if (expression.kind != "member" || expression.children.size != 1) return ""
    val receiver = bootstrapAnalysisMemberPath(expression.children[0])
    if (receiver == "") "" else "$receiver.${expression.text}"
}

/** Whether the indexes in the member chain `expression` (`ds[i].x`) are admissible expressions. */
fun bootstrapAnalysisScalarIndexes(expression: BootstrapExpression, parameters: array<string>, depth: int, calls: bool,
    strings: array<string>, members: array<string>): bool {
    if (expression.kind == "index") return bootstrapAnalysisScalarExpression(expression.children[1], parameters, depth + 1, calls, strings, members)
    if (expression.kind == "member" && expression.children.size == 1) {
        return bootstrapAnalysisScalarIndexes(expression.children[0], parameters, depth + 1, calls, strings, members)
    }
    true
}

/** Lists the fields of `record` a checked body may read through `prefix`: scalar and string ones as `prefix.x`, string and scalar-array
 *  ones again as `seq:prefix.x`, and, one level down, those of a field whose type is one of `classes` (given to the checker too:
 *  bootstrapAnalysisScalarUsedClasses). */
fun bootstrapAnalysisScalarFields(prefix: string, record: BootstrapDeclaration, classes: Map<string, BootstrapDeclaration>,
    var members: array<string>, depth: int): void {
    for (field in 0 until record.parameters.size) {
        val type = record.parameterTypes[field]
        val path = "$prefix.${record.parameters[field]}"
        if (bootstrapAnalysisScalarType(type) || type == "string") members.append(path)
        if (type == "string" || bootstrapAnalysisScalarArray(type)) members.append("seq:$path")
        val nested = classes.get(type)
        if (nested != null && depth == 0) bootstrapAnalysisScalarFields(path, nested, classes, members, depth + 1)
    }
    return
}

/** Adds to `used` the classes of the fields of the classes in it, one level down (bootstrapAnalysisScalarFields). */
fun bootstrapAnalysisScalarUsedClasses(classes: Map<string, BootstrapDeclaration>, var used: Map<string, int>): void {
    for (name in used.keys()) {
        val record = classes.get(name)
        if (record == null) continue
        for (type in record.parameterTypes) if (classes.has(type)) used.set(type, 0)
    }
    return
}

/** Whether `expression` is the name of a string or scalar-array parameter. */
fun bootstrapAnalysisStringName(expression: BootstrapExpression, strings: array<string>): bool {
    if (expression.kind != "identifier") return false
    for (name in strings) if (name == expression.text) return true
    false
}

/** Whether `expression` reads a member or an index (here, a string or array parameter's size or elements). */
fun bootstrapAnalysisReadsString(expression: BootstrapExpression): bool {
    if (expression.kind == "member" || expression.kind == "index") return true
    for (child in expression.children) if (bootstrapAnalysisReadsString(child)) return true
    false
}
