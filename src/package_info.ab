import "package.ab"
import "abla/integer"
import "abla/json"
import "package_catalog.ab"
import "package_index.ab"
import "abla/sys/linux/fs"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "abla/text"

private fun bootstrapPackageInfoString(line: string, key: string): string {
    val equals = line.indexOf("=")
    if (equals < 0 || bootstrapPackageTrim(line.slice(0, equals)) != key) return ""
    val value = bootstrapPackageTrim(line.slice(equals + 1, line.size))
    if (value.size < 2 || value.startsWith("\"\"\"") || value.startsWith("'''")) return ""
    val quote = value[0]
    if (quote != 34 && quote != 39) return ""
    var end = 1
    while (end < value.size && value[end] != quote) {
        if (quote == 34 && value[end] == 92) end = end + 1
        end = end + 1
    }
    if (end >= value.size) return ""
    val suffix = bootstrapPackageTrim(value.slice(end + 1, value.size))
    if (suffix != "" && !suffix.startsWith("#")) return ""
    if (quote == 39) return value.slice(1, end)
    val decoded = jsonParse(value.slice(0, end + 1))
    if (!decoded.succeeded || !decoded.value.isString()) return ""
    decoded.value.asString()
}

fun bootstrapPackageInfoField(manifest: string, key: string): string {
    for (line in manifest.split("\n")) {
        val trimmed = bootstrapPackageTrim(line)
        if (trimmed.startsWith("[")) return ""
        val field = bootstrapPackageInfoString(trimmed, key)
        if (field != "") return field
    }
    ""
}

// Preserve Unicode and keep control characters from remote metadata out of the CLI.
fun bootstrapPackageInfoDisplay(value: string, missing: string): string {
    if (value == "" || !packageCatalogDisplaySafe(value)) missing else value
}

fun bootstrapPackageLookupGit(directory: string): LinuxCommand {
    val command = bootstrapPackageGit()
    command.workingDirectory = directory
    command.argument("-c")
    command.argument("credential.interactive=false")
    // What a lookup receives is checked as the fetch path checks it.
    command.argument("-c")
    command.argument("transfer.fsckObjects=true")
    command
}

private fun bootstrapPackageInfoError(message: string): int {
    linuxPrintStandardError("error[E_PACKAGE_INFO]: $message\n")
    1
}

// Both views use disposable bare repositories. History is only needed to
// compare a locked revision with the commits behind the tags.
fun bootstrapPackageLookupClone(
    projectRoot: string, source: string, repoDir: string, history: bool
): bool {
    val clone = bootstrapPackageLookupGit(projectRoot)
    clone.argument("clone")
    clone.argument("--quiet")
    clone.argument("--bare")
    clone.argument("--no-local")
    clone.argument("--filter=blob:none")
    if (!history) {
        clone.argument("--depth=1")
        clone.argument("--no-tags")
    }
    clone.argument("--")
    clone.argument(source)
    clone.argument(repoDir)
    bootstrapPackageRunLimitedGit(clone).status == 0
}

fun bootstrapPackageLookupOutput(
    var command: LinuxCommand, file: Path, maximum: int
): LinuxProcessResult {
    command.outputPath = file.text
    val status = bootstrapPackageRunLimitedGit(command).status
    if (status != 0) return LinuxProcessResult(if (status == -1) 1 else status, "")
    if (file.info().size > maximum) return LinuxProcessResult(-1, "")
    val read = file.readTextResult()
    LinuxProcessResult(if (read.succeeded) 0 else 1, read.text)
}

fun bootstrapPackageLookupManifest(repoDir: string, revision: string): LinuxProcessResult {
    // The size first: a manifest over 64 KiB is refused before a byte of it is written (a partial clone fetches the blob for either).
    val sized = bootstrapPackageLookupGit(repoDir)
    sized.argument("cat-file")
    sized.argument("-s")
    sized.argument("$revision:abla.toml")
    sized.errorPath = "/dev/null"
    val size = bootstrapPackageRunLimitedGit(sized)
    if (size.status != 0) return LinuxProcessResult(1, "")
    val bytes = bootstrapPackageTrim(size.output).parseInt() ?? -1
    if (bytes < 0) return LinuxProcessResult(1, "")
    if (bytes > 65536) return LinuxProcessResult(-1, "")
    val command = bootstrapPackageLookupGit(repoDir)
    command.argument("cat-file")
    command.argument("blob")
    command.argument("$revision:abla.toml")
    command.errorPath = "/dev/null"
    bootstrapPackageLookupOutput(command, Path(repoDir).child("abla-info-manifest"), 65536)
}

fun bootstrapPackageLookupRevision(repoDir: string, ref: string): string {
    val command = bootstrapPackageLookupGit(repoDir)
    command.argument("rev-parse")
    command.argument("--verify")
    command.argument("--quiet")
    command.argument("$ref^{commit}")
    val resolved = command.capture()
    val revision = bootstrapPackageTrim(resolved.output)
    if (resolved.status == 0 && bootstrapPackageHexRevision(revision)) revision else ""
}

private fun bootstrapPackageInfoRead(repository: string, directory: string): int {
    val url = "https://github.com/$repository.git"
    val repoDir = "$directory/package.git"
    if (!bootstrapPackageLookupClone(directory, url, repoDir, false)) {
        return bootstrapPackageInfoError("cannot read $repository from GitHub")
    }
    val revision = bootstrapPackageLookupRevision(repoDir, "HEAD")
    if (revision == "") return bootstrapPackageInfoError("$repository has no default-branch commit")
    val read = bootstrapPackageLookupManifest(repoDir, revision)
    if (read.status == -1) return bootstrapPackageInfoError("abla.toml exceeds 64 KiB")
    if (read.status != 0) {
        return bootstrapPackageInfoError("$repository has no readable abla.toml at its default-branch HEAD")
    }
    val manifest = read.output
    val name = bootstrapPackageInfoField(manifest, "name")
    if (!bootstrapPackageNameValid(name)) return bootstrapPackageInfoError("abla.toml has no valid package name")

    val tagsFile = Path(directory).child("tags")
    val tags = bootstrapPackageLookupGit(directory)
    tags.argument("ls-remote")
    tags.argument("--tags")
    tags.argument("--refs")
    tags.argument("--sort=-version:refname")
    tags.argument("--")
    tags.argument(url)
    val listedTags = bootstrapPackageLookupOutput(tags, tagsFile, 1048576)
    if (listedTags.status == -1) return bootstrapPackageInfoError("Git tag listing exceeds 1 MiB")
    if (listedTags.status != 0) return bootstrapPackageInfoError("cannot list Git tags for $repository")

    bootstrapPackageInfoPrint(name, url, "default branch", revision, manifest)
    linuxPrintStandardOutput("Git tags:\n")
    var listed = false
    for (line in listedTags.output.split("\n")) {
        val marker = line.indexOf("\trefs/tags/")
        if (marker >= 0) {
            val tag = bootstrapPackageInfoDisplay(line.slice(marker + 11, line.size), "")
            if (tag != "") {
                linuxPrintStandardOutput("  $tag\n")
                listed = true
            }
        }
    }
    if (!listed) linuxPrintStandardOutput("  (none)\n")
    0
}

private fun bootstrapPackageInfo(repository: string): int {
    val directory = bootstrapPackageLookupTemporary()
    if (directory == "") return bootstrapPackageInfoError("cannot create a temporary directory")
    val status = bootstrapPackageInfoRead(repository, directory)
    bootstrapPackageRemoveTree(directory)
    status
}

fun bootstrapPackageLookupTemporary(): string {
    val temporary = linuxCommand("mktemp")
    temporary.argument("-d")
    val created = temporary.capture()
    if (created.status != 0) return ""
    // Drop only mktemp's newline, preserving spaces in the directory name.
    var path = created.output
    if (path.endsWith("\n")) path = path.slice(0, path.size - 1)
    if (path == "" || Path(path).isAbsolute()) return path
    currentDirectory().text + "/" + path
}

fun bootstrapPackageInfoPrint(
    name: string, url: string, refLabel: string, revision: string, manifest: string
): void {
    val description = bootstrapPackageInfoDisplay(bootstrapPackageInfoField(manifest, "description"), "(not declared)")
    val licence = bootstrapPackageInfoDisplay(bootstrapPackageInfoField(manifest, "license"), "(not declared)")
    val compiler = bootstrapPackageInfoDisplay(bootstrapPackageInfoField(manifest, "compiler"), "(not declared)")
    val version = bootstrapPackageInfoDisplay(bootstrapPackageInfoField(manifest, "version"), "(not declared)")
    linuxPrintStandardOutput("Name: $name\nSource: $url\nMetadata: $refLabel at $revision\nDescription: $description\nLicence: $licence\nManifest version: $version\nDeclared compiler range: $compiler\n")
    return
}

private fun bootstrapPackageInfoUsage(): int {
    linuxPrintStandardError("usage: ablac package info <name|owner/repo> [--offline]\n")
    2
}

fun bootstrapPackageInfoCommand(): int {
    var name = ""
    var offline = false
    var index = 2
    while (index < linuxArgumentCount()) {
        val argument = linuxArgument(index)
        if (argument == "--offline" && !offline) offline = true
        else if (name == "" && argument != "" && !argument.startsWith("--")) name = argument
        else return bootstrapPackageInfoUsage()
        index = index + 1
    }
    val qualified = packageCatalogRepositoryValid(name)
    if (!qualified && !packageCatalogNameValid(name)) return bootstrapPackageInfoUsage()
    if (qualified && !offline) return bootstrapPackageInfo(name)

    val match = bootstrapPackageIndexResolve(name, offline)
    val entry = match.entry ?? return bootstrapPackageInfoError(match.error)
    val keywords = if (entry.keywords.size == 0) "(none)" else entry.keywords.join(", ")
    linuxPrintStandardOutput("Repository: ${entry.repository}\nCatalog description: ${entry.description}\nKeywords: $keywords\n")
    if (offline) return 0
    bootstrapPackageInfo(entry.repository)
}
