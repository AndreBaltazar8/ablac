// The guarded compiler launcher already supplies its process memory budget.
// Feed a conservative portion of the same budget to Abla's tracked allocator
// so its precise root collector is active during large whole-program builds.
// Without this, short-lived parser/evaluator graphs are reference-released but
// cyclic garbage and allocator high-water pages accumulate until the outer OS
// address-space limit is reached.
fun bootstrapCompilerTrackedMemoryLimit(): int {
    val configured = linuxEnvironment("ABLA_MAX_MEMORY_MB")
    var megabytes = 0
    var valid = configured.found && configured.value.size > 0
    var index = 0
    while (valid && index < configured.value.size) {
        val byte = configured.value[index]
        if (byte < 48 || byte > 57) valid = false
        else if (megabytes > 1048575) valid = false
        else megabytes = megabytes * 10 + byte - 48
        index = index + 1
    }
    if (valid && megabytes > 0) {
        (megabytes - megabytes / 4) * 1048576
    } else 0
}

// The compiler collects whenever its heap has grown by this much since what the last
// collection kept (ABLA_COMPILER_COLLECT_GROWTH_MB; 0: the runtime's own step under a
// launcher budget, else never collects).
val BOOTSTRAP_COMPILER_COLLECTION_GROWTH_MB = 256

fun bootstrapCompilerCollectionGrowth(): int {
    val configured = linuxEnvironment("ABLA_COMPILER_COLLECT_GROWTH_MB")
    var megabytes = BOOTSTRAP_COMPILER_COLLECTION_GROWTH_MB
    if (configured.found && configured.value.size > 0) {
        var parsed = 0
        var valid = true
        var index = 0
        while (index < configured.value.size) {
            val byte = configured.value[index]
            if (byte < 48 || byte > 57 || parsed > 1048575) valid = false
            else parsed = parsed * 10 + byte - 48
            index = index + 1
        }
        if (valid) megabytes = parsed
    }
    megabytes * 1048576
}

fun bootstrapOrcEmit(sourcePath: string): int {
    bootstrapBeginCompileOutputs()
    var status = 1
    val compilation = bootstrapCompileHostEmit(sourcePath)
    // Only after a front end without errors: one that stopped early never recorded every use (toolchain.ab).
    if (bootstrapUnusedImportsWanted() &&
        compilation.parserErrors + compilation.extensionErrors + compilation.semanticErrors == 0) {
        val unused = bootstrapUnusedImportWarnings()
        if (unused != "") linuxPrintStandardError(bootstrapCommandLineDiagnostics(unused))
    }
    if (bootstrapUnusedLocalsRequested &&
        compilation.parserErrors + compilation.extensionErrors + compilation.semanticErrors == 0) {
        val unusedLocals = bootstrapUnusedLocalWarnings()
        if (unusedLocals != "") linuxPrintStandardError(bootstrapCommandLineDiagnostics(unusedLocals))
    }
    if (bootstrapUnusedParametersRequested &&
        compilation.parserErrors + compilation.extensionErrors + compilation.semanticErrors == 0) {
        val unusedParameters = bootstrapUnusedParameterWarnings()
        if (unusedParameters != "") linuxPrintStandardError(bootstrapCommandLineDiagnostics(unusedParameters))
    }
    if (bootstrapUnusedDeclarationsRequested &&
        compilation.parserErrors + compilation.extensionErrors + compilation.semanticErrors == 0) {
        val unusedDeclarations = bootstrapUnusedDeclarationWarnings()
        if (unusedDeclarations != "") linuxPrintStandardError(bootstrapCommandLineDiagnostics(unusedDeclarations))
    }
    val requestedPrograms = bootstrapTakeCompileProgramRequests()
    val definedTargets = bootstrapTakeDefinedTargets()
    val artifactRoots = bootstrapTakeArtifactRootRequests()
    val packages = bootstrapTakeApplePackages()
    if (compilation.errors == 0 && requestedPrograms.size == 0 &&
        definedTargets.size == 0 && artifactRoots.size == 0 && packages.size == 0) {
        linuxPrintStandardOutput(compilation.output)
        status = 0
    }
    if (requestedPrograms.size > 0 || definedTargets.size > 0 ||
        artifactRoots.size > 0 || packages.size > 0) {
        linuxPrintStandardError(
            "error[E_BUILD_COMMAND_UNSUPPORTED]: --emit-llvm cannot execute programmable build nodes; use 'ablac build'\n"
        )
    }
    if (compilation.errors != 0) {
        linuxPrintStandardError(
            bootstrapCommandLineDiagnostics(compilation.diagnostics)
        )
        if (!bootstrapDiagnosticInEntry()) linuxPrintStandardError(
            bootstrapCompilationFailedLine(compilation.parserErrors, compilation.extensionErrors, compilation.semanticErrors, compilation.irErrors, compilation.errors)
        )
    }
    if (status == 0 && !bootstrapCommitCompileOutputs()) status = 144
    if (status != 0) bootstrapDiscardCompileOutputs()
    status
}

// `ablac run` (the default, and --jit): compiles the program in process, runs
// the IR pipeline `passes` on it (the --o1 one unless --fast), and calls it
// there through LLVM ORC. The object goes through the JIT object cache
// (jit_cache.ab): an unchanged program reruns without compiling.
fun bootstrapRunInProcess(
    sourcePath: string,
    arguments: array<string> = [],
    passes: string = "",
    live: bool = false,
    watch: bool = false,
    repl: bool = false
): int {
    // A live run (`--live`, live.ab) is another object (its calls go through the table), and a reload
    // needs the compiler's record of the program as built: a cached one keeps it beside the object.
    val key = jitRunKey(sourcePath, if (live) "$passes\nlive" else passes)
    val session = llvmOrcCreateSession()
    var status = session.status
    var generation = LlvmOrcGeneration(nativeNullPointer(), 128, true)
    var entry = 0
    var cached = if (status == 0) jitRunCachedObject(key) else ""
    if (cached != "" && live && !bootstrapLlvmLiveRecordLoad(Path("$cached.live").readText())) cached = ""
    if (cached != "") {
        generation = session.addObjectFile(cached)
        if (generation.status == 0) {
            val lookup = session.lookup("main")
            if (lookup.status == 0) {
                entry = lookup.address
                if (live) bootstrapLiveBegin(session, sourcePath, passes)
                if (watch) bootstrapLiveWatchPaths = bootstrapLiveOwnPaths(jitRunRecordedPaths(key))
            } else {
                // An object the JIT cannot link is compiled afresh.
                val _removed = generation.remove()
                generation = LlvmOrcGeneration(nativeNullPointer(), 128, true)
            }
        }
    }
    if (status == 0 && entry == 0) {
        val enclosingLive = bootstrapLlvmLiveRun
        bootstrapLlvmLiveRun = live
        val prepared = bootstrapPrepareRun(sourcePath, true)
        bootstrapLlvmLiveRun = enclosingLive
        if (watch) bootstrapLiveWatchPaths = bootstrapLiveOwnPaths(prepared.sourcePaths)
        if (live && linuxEnvironment("ABLA_LIVE_TRACE").found) {
            linuxPrintStandardError("live: ${bootstrapLlvmLiveCount} functions through the table\n")
        }
        status = prepared.status
        if (status == 0) {
            // The session owns the held module from here on.
            generation = session.addModule(bootstrapLlvmHeldContext, bootstrapLlvmHeldModule,
                passes)
            bootstrapLlvmHeldContext = nativeNullPointer()
            bootstrapLlvmHeldModule = nativeNullPointer()
            status = generation.status
            if (status == 0 && live) bootstrapLiveBegin(session, sourcePath, passes)
        }
        if (status == 0 && key.valid && !prepared.cacheable) {
            jitCacheTrace("uncacheable (a top-level compile action, a nondeterministic grant or a staged output)")
        }
        if (status == 0 && key.valid && prepared.cacheable &&
            Path(bootstrapCacheDirectory()).createDirectories()) {
            val objectPath = jitRunObjectPath(key, prepared.sourcePaths)
            val lookup = session.lookupCapturing("main", objectPath)
            status = lookup.status
            entry = lookup.address
            if (!lookup.captured) jitCacheTrace("uncaptured (not exactly one module compiled)")
            // A live object is published only with its record (and a run that finds the object without
            // one compiles afresh).
            val recorded = !live || Path("$objectPath.live").writeText(bootstrapLlvmLiveRecordText())
            if (lookup.captured && recorded) {
                val _published = jitRunPublish(key, jitRunRecord(
                    objectPath, prepared.sourcePaths,
                    prepared.compileInputPaths, prepared.compileInputContents
                ), objectPath)
            }
        } else if (status == 0) {
            val lookup = session.lookup("main")
            status = lookup.status
            entry = lookup.address
        }
    }
    if (status == 0 && live) bootstrapLiveTraceTable(session)
    if (status == 0) {
        val frame = ctBridgeRunFrameBegin(sourcePath)
        session.installThreadEnd()
        if (watch) {
            bootstrapLiveWatchStart()
            status = llvmOrcCallMainWatched(entry, sourcePath, arguments, { bootstrapLiveWatchStep() })
            bootstrapLiveWatchClose()
        } else if (repl) {
            // `ablac repl` (live_repl.ab): main waits; this thread reads and reloads the lines.
            status = llvmOrcCallMainWatched(entry, sourcePath, arguments, { bootstrapReplStep() })
        } else status = llvmOrcCallMain(entry, sourcePath, arguments)
        ctBridgeRunFrameEnd(frame)
    }
    val removeStatus = generation.remove()
    if (status == 0 && removeStatus != 0) status = removeStatus
    val closeStatus = session.close()
    if (status == 0 && closeStatus != 0) status = closeStatus
    status
}

// The executable `ablac run` keeps for an entry: build/.abla-run/ and the
// source path with every byte outside [A-Za-z0-9._-] as '_'.
fun bootstrapRunExecutablePath(sourcePath: string): string {
    val name = byteBuffer()
    var index = 0
    while (index < sourcePath.size) {
        val byte = sourcePath[index]
        val kept = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 46 || byte == 45 || byte == 95
        name.appendByteValue(if (kept) byte else 95)
        index = index + 1
    }
    "build/.abla-run/${name.toText()}"
}

// `ablac run --built`: builds the entry through the build cache, in the --o1
// profile unless `profile` is "fast" or "release", and execs the result.
// The object cache is keyed by the compiler's image, the LLVM library and the
// profile, so an unchanged program skips compiling, and a new compiler or
// profile never reuses an old object. The executable is linked under a name
// of this process's own and renamed into place: a run that overlaps another
// of the same entry never rewrites a binary that is executing. The program
// replaces this process, so it keeps the standard streams, the working
// directory and the environment, and none of the compiler's memory; its
// argv[0] is the source path, as under --jit.
fun bootstrapRunBuilt(
    sourcePath: string,
    arguments: array<string>,
    profile: string
): int {
    val output = bootstrapRunExecutablePath(sourcePath)
    val staged = "$output.${linuxProcessId()}"
    bootstrapOrcBalanced = profile == "o1"
    bootstrapNativeSidecarRequest = 0
    // (Uncached for `--strict-imports=warn`: its warnings come from the front end.)
    var status = bootstrapOrcBuild(
        sourcePath, staged, profile == "fast", !bootstrapStrictImportsWarn,
        bootstrapTargetDescriptor(bootstrapHostTargetName()), "executable"
    )
    for (suffix in [".abi.json", ".ll", ".o", ".host.o", ".runtime.o",
                    ".raw-runtime.o", ".o.bc"]) {
        Path("$staged$suffix").remove()
    }
    // ELF builds can split the object into a root and up to 32 partitions.
    // These belong to this process's staging path, just like the main object.
    Path("$staged.o.root.ll").remove()
    Path("$staged.o.root.o").remove()
    var partition = 0
    while (partition < 32) {
        Path("$staged.o.part.$partition.ll").remove()
        Path("$staged.o.part.$partition.o").remove()
        partition = partition + 1
    }
    if (status == 0 && !Path(staged).moveTo(Path(output))) {
        linuxPrintStandardError("error: cannot place the program at $output\n")
        status = 1
    }
    if (status != 0) {
        Path(staged).remove()
        return status
    }
    val argv: array<string> = [sourcePath]
    for (argument in arguments) argv.append(argument)
    status = linuxExecute(output, argv)
    linuxPrintStandardError("error: cannot execute $output\n")
    status
}

// `--o1`: the whole build (and the programs its build definition registers)
// takes the middle profile, between --fast and the release default.
var bootstrapOrcBalanced = false

// `ablac test <file.ab|directory>... [--fast] [--no-cache] [--cache-dir <dir>] [--each] [-v]
//  [--strict-imports | --flat-imports | --strict-imports=warn]`:
// builds the test programs (--o1, as `ablac run`; or --fast) into build/abla-test and runs
// each. A test suite's time is mostly its programs running: abla-qr's tests built --fast
// took 8.5 G instructions to build and their slowest ran 2,975 G; --o1, 25.7 G and 276 G
// (2026-11-03). --fast is for tests that run for less than their build takes. One
// passes when it exits 0 (see abla/test's testsPassed). A directory names its files
// ending in `test.ab`. Several files build as few programs as they can (test_runner.ab:
// bundles, each run once per test in a process of its own); --each, or a single file,
// builds every file on its own. -v lists each bundle's files and what fell back. 0 when
// every test passed.
/** Whether `value` is an import mode, which `ablac build`, `test` and `run` all take (and then sets it):
 *  - `--strict-imports`: modules whose package doesn't set `visibility` see only their imports, the default
 *    (#66 step 3) said explicitly;
 *  - `--flat-imports`: they see every name the program declares, as before strict imports were the default (a
 *    package whose abla.toml says `visibility = "imports"` declares itself strict and stays strict);
 *  - `--strict-imports=warn`: they stay flat, and what strict imports would report is printed as warnings, by the
 *    front end (so the caller builds uncached). */
fun bootstrapStrictImportsOption(value: string): bool {
    if (value != "--strict-imports" && value != "--flat-imports" && value != "--strict-imports=warn") return false
    bootstrapStrictImportsRequested = value == "--strict-imports"
    bootstrapStrictImportsByDefault = false
    bootstrapStrictImportsWarn = value == "--strict-imports=warn"
    // (Here, not where modules are found flat: a cached build doesn't run the front end.)
    if (value == "--flat-imports") bootstrapFlatImportsDeprecationWarning("--flat-imports")
    true
}

/**
 * The locked packages of the project `source` belongs to (the nearest abla.toml up from it, with an abla.lock beside
 * it), installed at their locked revisions (package.ab: bootstrapPackageInstallLocked): what `build --project` does
 * through its prepare, for a single-file build, run or test. Prints the diagnostic and returns false on failure.
 */
fun bootstrapOrcInstallLockedFor(source: string, offline: bool): bool {
    val manifest = bootstrapCompileManifestFor(source)
    if (manifest == "") return true
    var root = Path(manifest).parent().text
    if (root == "") root = "."
    val installed = bootstrapPackageInstallLocked(root, offline)
    if (installed.status != 0) linuxPrintStandardError(installed.diagnostic)
    installed.status == 0
}

fun bootstrapOrcTest(argumentCount: int): int {
    val arguments: array<string> = []
    var useCache = true
    var each = false
    var verbose = false
    var watch = false
    val forwarded: array<string> = []
    var option = 1
    bootstrapOrcBalanced = true
    while (option < argumentCount) {
        val value = linuxArgument(option)
        if (value != "--watch") forwarded.append(value)
        if (value == "--o1") bootstrapOrcBalanced = true
        else if (value == "--fast") bootstrapOrcBalanced = false
        else if (value == "--no-cache") useCache = false
        else if (value == "--each") each = true
        else if (value == "-v" || value == "--verbose") verbose = true
        else if (value == "--watch") watch = true
        else if (bootstrapStrictImportsOption(value)) {
            if (bootstrapStrictImportsWarn) useCache = false
        } else if (value == "--cache-dir" && option + 1 < argumentCount) {
            option = option + 1
            bootstrapCacheDirectoryRequest = linuxArgument(option)
            forwarded.append(linuxArgument(option))
        } else arguments.append(value)
        option = option + 1
    }
    val sources = bootstrapTestSources(arguments)
    if (sources.size == 0) return 2
    // Their projects' locked packages, once per project.
    val installedRoots: Map<string, bool> = Map()
    for (source in sources) {
        val manifest = bootstrapCompileManifestFor(source)
        if (manifest == "" || installedRoots.has(manifest)) continue
        installedRoots.set(manifest, true)
        if (!bootstrapOrcInstallLockedFor(source, false)) return 1
    }
    // --watch: the same run, again after each change to a file the tests read (test_watch.ab).
    if (watch) return bootstrapTestWatch(forwarded, sources)
    val target = bootstrapTargetDescriptor(bootstrapHostTargetName())
    Path("build/abla-test").createDirectories()
    var failed = 0
    if (each || sources.size == 1) {
        for (source in sources) {
            if (!bootstrapOrcTestAlone(source, useCache, target)) failed = failed + 1
        }
    } else {
        val started = linuxMonotonicMilliseconds()
        val discoveryState = bootstrapModuleState()
        bootstrapConfigureDiscoveryCache(discoveryState, useCache)
        val partition = bootstrapTestBundlePartitionWithCache(
            sources, discoveryState.discoveryDirectory, discoveryState.discoveryIdentity
        )
        val bundles = partition.bundles
        var count = 0
        for (chosen in bundles) {
            if (chosen + 1 > count) count = chosen + 1
        }
        if (verbose) {
            linuxPrintStandardOutput(
                "${sources.size} files, $count bundles (${partition.modulesRead} modules read, ${linuxMonotonicMilliseconds() - started} ms)\n"
            )
        }
        var bundle = 0
        while (bundle < count) {
            val members: array<string> = []
            var index = 0
            while (index < sources.size) {
                if (bundles[index] == bundle) members.append(sources[index])
                index = index + 1
            }
            failed = failed + bootstrapOrcTestBundle(
                bundle, members, useCache, target, verbose, partition.preparedStates
            )
            bundle = bundle + 1
        }
    }
    linuxPrintStandardOutput(
        "${sources.size - failed} passed, $failed failed\n"
    )
    if (failed == 0) 0 else 1
}

// Builds `source` on its own into build/abla-test and runs it; whether it passed.
fun bootstrapOrcTestAlone(
    source: string,
    useCache: bool,
    target: BootstrapTargetDescriptor
): bool {
    val output = Path("build/abla-test").child(bootstrapTestAloneName(source)).text
    var result = bootstrapOrcBuild(
        source, output, !bootstrapOrcBalanced, useCache, target,
        "executable"
    )
    val built = result == 0
    if (built) result = linuxCommand(output).run()
    bootstrapOrcTestReport(source, built, result)
}

fun bootstrapOrcTestReport(source: string, built: bool, result: int): bool {
    if (result == 0) linuxPrintStandardOutput("PASS $source\n")
    else {
        linuxPrintStandardOutput(
            if (built) "FAIL $source (exit $result)\n"
            else "FAIL $source (build)\n"
        )
    }
    result == 0
}

// Builds `members` as bundle `index` and runs each test in it; the failures. A build
// that fails is retried without the files its errors are in or reach them through
// their imports (at most twice), and those files are built and run on their own (which
// reports their errors); when the errors can't be placed, every member is.
fun bootstrapOrcTestBundle(
    index: int,
    members: array<string>,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    verbose: bool,
    var preparedStates: array<BootstrapModuleState>
): int {
    // Consume the handoff before any test body or failed-build retry can
    // change inputs. It is never a process-global or cross-invocation cache.
    val moduleState = if (preparedStates.size > 0) preparedStates[0]
        else bootstrapModuleState()
    preparedStates.clear()
    val remaining: array<string> = []
    for (member in members) remaining.append(member)
    val alone: array<string> = []
    if (verbose && members.size == 1) {
        linuxPrintStandardOutput("bundle $index: one file, built on its own: ${members[0]}\n")
    }
    var output = ""
    var built = false
    var round = 0
    while (!built && remaining.size > 1 && round < 3) {
        output = "build/abla-test/${bootstrapTestBundleName(remaining)}"
        val root = "$output.ab"
        val bundleSource = bootstrapTestBundleRoot(2, remaining)
        // A stable generated input keeps its identity on an unchanged run.
        // Compare contents: size and timestamps are not a validity check.
        if (Path(root).readText() != bundleSource) {
            Path(root).writeTextAtomic(bundleSource)
        }
        bootstrapBuildDiagnosticsKept = true
        bootstrapBuildDiagnostics = ""
        val status = if (round == 0) bootstrapOrcBuildModuleState(
            root, output, !bootstrapOrcBalanced, useCache, target, "executable",
            moduleState
        ) else bootstrapOrcBuild(
            root, output, !bootstrapOrcBalanced, useCache, target, "executable"
        )
        bootstrapBuildDiagnosticsKept = false
        if (status == 0) built = true
        else {
            val paths = bootstrapTestDiagnosticPaths(bootstrapBuildDiagnostics)
            val kept: array<string> = []
            val dropped: array<string> = []
            for (member in remaining) {
                var hit = false
                for (reached in bootstrapTestReach(member)) {
                    for (path in paths) {
                        if (path == reached) hit = true
                    }
                }
                if (hit) dropped.append(member) else kept.append(member)
            }
            if (dropped.size == 0 || kept.size == 0) {
                for (member in remaining) alone.append(member)
                if (verbose) {
                    linuxPrintStandardOutput(
                        "bundle $index: its errors are in no one file; its ${remaining.size} files build on their own\n"
                    )
                }
                remaining.truncate(0)
            } else {
                for (member in dropped) alone.append(member)
                if (verbose) {
                    linuxPrintStandardOutput(
                        "bundle $index: ${dropped.size} files build on their own (their errors):\n"
                    )
                    for (member in dropped) linuxPrintStandardOutput("  $member\n")
                }
                remaining.truncate(0)
                for (member in kept) remaining.append(member)
            }
        }
        round = round + 1
    }
    if (!built) {
        for (member in remaining) alone.append(member)
        remaining.truncate(0)
    }
    if (verbose && remaining.size > 0) {
        linuxPrintStandardOutput("bundle $index (${remaining.size} files, $output):\n")
        for (member in remaining) linuxPrintStandardOutput("  $member\n")
    }
    var failed = 0
    var entry = 0
    while (entry < remaining.size) {
        val result = linuxCommand(output).argument("$entry").run()
        if (!bootstrapOrcTestReport(remaining[entry], true, result)) failed = failed + 1
        entry = entry + 1
    }
    for (member in alone) {
        if (!bootstrapOrcTestAlone(member, useCache, target)) failed = failed + 1
    }
    failed
}

// Debug information for `build`: "on" (-g / --debug), "off" (--no-debug) or
// "" for the default, which ABLA_DEBUG=1/0 overrides: on for development
// (--fast) builds, off for release builds.
var bootstrapOrcDebugRequest: string = ""

fun bootstrapOrcDebugInfo(fast: bool): bool {
    var request = bootstrapOrcDebugRequest
    if (request == "") {
        val configured = linuxEnvironment("ABLA_DEBUG")
        if (configured.found && configured.value == "1") request = "on"
        if (configured.found && configured.value == "0") request = "off"
    }
    if (request == "on") true else if (request == "off") false else fast
}

// Whether a --fast build emits only the runtime functions its program reaches on Linux hosts; ABLA_FAST_PRUNE=0 turns it off.
fun bootstrapOrcPruneRuntime(fast: bool): bool {
    val configured = linuxEnvironment("ABLA_FAST_PRUNE")
    fast && !(configured.found && configured.value == "0")
}

fun bootstrapOrcBuildSingle(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string
): int {
    bootstrapLlvmDebugInfo = bootstrapOrcDebugInfo(fast)
    bootstrapLlvmDebugOptimized = !fast
    bootstrapLlvmPruneRuntime = bootstrapOrcPruneRuntime(fast)
    bootstrapLlvmDebugEntry = sourcePath
    val status = bootstrapOrcBuildSingleWith(
        sourcePath, outputPath, fast, useCache, target, artifact
    )
    bootstrapLlvmDebugInfo = false
    bootstrapLlvmDebugOptimized = false
    bootstrapLlvmPruneRuntime = false
    bootstrapLlvmPruneBridgesFinal = false
    bootstrapLlvmPruneActive = false
    status
}

fun bootstrapOrcBuildSingleWith(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string
): int {
    val moduleState = bootstrapModuleState()
    bootstrapOrcBuildSingleWithModuleState(
        sourcePath, outputPath, fast, useCache, target, artifact, moduleState
    )
}

fun bootstrapOrcBuildSingleWithModuleState(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string,
    var moduleState: BootstrapModuleState
): int {
    var status = 1
    if (fast && bootstrapTargetIsHost(target)) {
        status = bootstrapNativeArtifactBuildWithEmitterModuleState(
            sourcePath,
            outputPath,
            llvmAotEmitObjectFileFast,
            "inprocess-fast",
            useCache,
            target,
            artifact,
            moduleState
        ).status
    }
    if (!fast && bootstrapOrcBalanced && bootstrapTargetIsHost(target)) {
        status = bootstrapNativeArtifactBuildWithEmitterModuleState(
            sourcePath,
            outputPath,
            llvmAotEmitObjectFileBalanced,
            "inprocess-o1",
            useCache,
            target,
            artifact,
            moduleState
        ).status
    }
    if (!fast && !bootstrapOrcBalanced && bootstrapTargetIsHost(target)) {
        status = bootstrapNativeArtifactBuildWithEmitterModuleState(
            sourcePath,
            outputPath,
            llvmAotEmitObjectFile,
            "inprocess-o2",
            useCache,
            target,
            artifact,
            moduleState
        ).status
    }
    if (!bootstrapTargetIsHost(target)) {
        val targetTriple = target.llvmTriple
        val targetFast = fast
        val targetTools = bootstrapXtensaLlvmTools(targetTriple)
        if (targetTools.error != "") {
            linuxPrintStandardError(targetTools.error)
            return 188
        }
        val targetEmitter: (string, string) -> int = {
            input: string,
            output: string ->
            bootstrapExternalEmitObjectForTargetWithTools(
                input,
                output,
                targetTriple,
                targetFast,
                targetTools
            )
        }
        status = bootstrapNativeArtifactBuildWithEmitterModuleState(
            sourcePath,
            outputPath,
            targetEmitter,
            if (fast) "cross-fast" else "cross-o2",
            useCache,
            target,
            artifact,
            moduleState,
            targetTools.identity
        ).status
        if (status == 0 && targetTools.root != "" &&
            !Path("$outputPath.xtensa-tools.json")
            .writeTextAtomic(bootstrapXtensaBuildManifest(targetTools))) {
            linuxPrintStandardError("error[E_XTENSA_MANIFEST]: could not record the selected code-generation stages\n")
            status = 190
        }
    }
    status
}

fun bootstrapAppendDefinedTargets(
    var targets: array<BootstrapDefinedTarget>,
    additions: array<BootstrapDefinedTarget>
): int {
    var status = 0
    var addition = 0
    while (status == 0 && addition < additions.size) {
        val candidate = additions[addition]
        val descriptor = bootstrapDefinedTargetDescriptor(candidate)
        var duplicate = bootstrapTargetDescriptor(candidate.name).valid
        var previous = 0
        while (!duplicate && previous < targets.size) {
            if (targets[previous].name == candidate.name) duplicate = true
            previous = previous + 1
        }
        if (!descriptor.valid) {
            linuxPrintStandardError(
                "error[E_BUILD_TARGET_DEFINITION]: target '${candidate.name}' requested an unsupported object format or linker flavor\n"
            )
            status = 148
        }
        if (status == 0 && duplicate) {
            linuxPrintStandardError(
                "error[E_BUILD_TARGET_DEFINITION]: duplicate target '${candidate.name}'\n"
            )
            status = 146
        }
        if (status == 0 && targets.size >= 32) {
            linuxPrintStandardError(
                "error[E_BUILD_GRAPH_LIMIT]: programmable build exceeds 32 target descriptions\n"
            )
            status = 150
        }
        if (status == 0) targets.append(candidate)
        addition = addition + 1
    }
    status
}

fun bootstrapArtifactSliceSourcePath(sourcePath: string): string {
    var result = sourcePath
    if (sourcePath.size > 0 && sourcePath[0] != 47) {
        result = currentDirectory().child(sourcePath).text
    }
    result
}

fun bootstrapAppendArtifactSlices(
    var queued: array<BootstrapCompileProgramRequest>,
    roots: array<BootstrapArtifactRootRequest>,
    sourcePath: string,
    var sliceEntries: array<string>
): int {
    var status = 0
    val emitted: array<string> = []
    val importedSource = bootstrapArtifactSliceSourcePath(sourcePath)
    var safeSource = importedSource.size > 0
    var sourceByte = 0
    while (safeSource && sourceByte < importedSource.size) {
        if (importedSource[sourceByte] == 10 ||
            importedSource[sourceByte] == 13 ||
            importedSource[sourceByte] == 34 ||
            importedSource[sourceByte] == 92) safeSource = false
        sourceByte = sourceByte + 1
    }
    if (!safeSource && roots.size > 0) {
        linuxPrintStandardError(
            "error[E_ARTIFACT_ROOT_SOURCE]: source path cannot be represented safely in a generated artifact entry\n"
        )
        status = 158
    }
    var root = 0
    while (status == 0 && root < roots.size) {
        val request = roots[root]
        var alreadyEmitted = false
        var emittedIndex = 0
        while (emittedIndex < emitted.size) {
            if (emitted[emittedIndex] == request.name) {
                alreadyEmitted = true
            }
            emittedIndex = emittedIndex + 1
        }
        if (!alreadyEmitted) {
            var source =
                "import \"$importedSource\"\nimport \"abla/compiler\"\ncompile fun __abla_export_slice(): void {\n"
            var contribution = 0
            val contributionKeys: array<string> = []
            while (contribution < roots.size) {
                val selected = roots[contribution]
                if (selected.name == request.name) {
                    var duplicateContribution = false
                    val contributionKey = "${selected.functionName}:${selected.exportName}"
                    var keyIndex = 0
                    while (!duplicateContribution &&
                           keyIndex < contributionKeys.size) {
                        if (contributionKeys[keyIndex] == contributionKey) {
                            duplicateContribution = true
                        }
                        keyIndex = keyIndex + 1
                    }
                    if (!duplicateContribution) {
                        source =
                            "${source}    val __abla_slice_handle_${contribution} = compiler.findFunction(\"${selected.functionName}\")\n"
                        source =
                            "${source}    compiler.exportFunction(__abla_slice_handle_${contribution}, \"${selected.exportName}\")\n"
                        contributionKeys.append(contributionKey)
                    }
                }
                contribution = contribution + 1
            }
            source = "${source}    return\n}\n#compiler.transform(__abla_export_slice)\n"
            val entry = "${request.output}.abla-slice.ab"
            var valid = Path(entry).parent().createDirectories()
            if (valid) valid = Path(entry).writeTextAtomic(source)
            if (!valid) {
                linuxPrintStandardError(
                    "error[E_ARTIFACT_ROOT_ENTRY]: cannot stage generated entry for artifact '${request.name}'\n"
                )
                status = 159
            } else {
                emitted.append(request.name)
                sliceEntries.append(entry)
                queued.append(BootstrapCompileProgramRequest(
                    request.name,
                    entry,
                    request.output,
                    request.target,
                    request.artifact,
                    request.fast,
                    request.cache
                ))
            }
        }
        root = root + 1
    }
    status
}

// Compile one root normally, then drain any program nodes registered by its
// compile-time build definition. Child compilations may register more nodes;
// the bounded queue makes that recursion explicit and cycle diagnosable. Each
// node publishes its own outputs when it builds: a failed one leaves its
// earlier outputs (or none), and the nodes built before it keep theirs.
fun bootstrapOrcBuild(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string
): int {
    val moduleState = bootstrapModuleState()
    bootstrapOrcBuildModuleState(
        sourcePath, outputPath, fast, useCache, target, artifact, moduleState
    )
}

fun bootstrapOrcBuildModuleState(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string,
    var moduleState: BootstrapModuleState
): int {
    bootstrapIndependentModules = []
    bootstrapTakeApplePackages()
    bootstrapTakeCompileProgramRequests()
    bootstrapTakeDefinedTargets()
    bootstrapTakeArtifactRootRequests()
    bootstrapRemoveAbandonedBuildScratch()
    bootstrapRemoveOldBuildTransactions()
    bootstrapLlvmDebugInfo = bootstrapOrcDebugInfo(fast)
    bootstrapLlvmDebugOptimized = !fast
    bootstrapLlvmPruneRuntime = bootstrapOrcPruneRuntime(fast)
    bootstrapLlvmDebugEntry = sourcePath
    var status = bootstrapOrcBuildSingleWithModuleState(
        sourcePath, outputPath, fast, useCache, target, artifact, moduleState
    )
    bootstrapLlvmDebugInfo = false
    bootstrapLlvmDebugOptimized = false
    bootstrapLlvmPruneRuntime = false
    bootstrapLlvmPruneBridgesFinal = false
    bootstrapLlvmPruneActive = false
    val queued = bootstrapTakeCompileProgramRequests()
    val artifactRoots = bootstrapTakeArtifactRootRequests()
    val sliceEntries: array<string> = []
    if (status == 0) status = bootstrapAppendArtifactSlices(
        queued,
        artifactRoots,
        sourcePath,
        sliceEntries
    )
    val targets: array<BootstrapDefinedTarget> = []
    val rootTargets = bootstrapTakeDefinedTargets()
    if (status == 0) {
        status = bootstrapAppendDefinedTargets(targets, rootTargets)
    }
    val names: array<string> = []
    val outputs: array<string> = []
    var cursor = 0
    while (status == 0 && cursor < queued.size && cursor < 64) {
        val request = queued[cursor]
        var unique = true
        var previous = 0
        while (previous < names.size) {
            if (names[previous] == request.name ||
                outputs[previous] == request.output) unique = false
            previous = previous + 1
        }
        val requestedTargetName = if (request.target == "host") {
            bootstrapHostTargetName()
        } else request.target
        var requestedTarget = bootstrapTargetDescriptor(requestedTargetName)
        var definedTarget = 0
        while (!requestedTarget.valid && definedTarget < targets.size) {
            if (targets[definedTarget].name == request.target) {
                requestedTarget = bootstrapDefinedTargetDescriptor(
                    targets[definedTarget]
                )
            }
            definedTarget = definedTarget + 1
        }
        if (!unique) {
            linuxPrintStandardError(
                "error[E_BUILD_GRAPH_DUPLICATE]: duplicate program name or output for '${request.name}'\n"
            )
            status = 146
        }
        if (status == 0 && request.artifact != "executable" &&
            request.artifact != "object" &&
            request.artifact != "static-library" &&
            request.artifact != "shared-library" &&
            request.artifact != "module") {
            linuxPrintStandardError(
                "error[E_BUILD_ARTIFACT_UNSUPPORTED]: program '${request.name}' requested unsupported artifact '${request.artifact}'; supported artifacts: executable, object, static-library, shared-library, module\n"
            )
            status = 147
        }
        if (status == 0 && !requestedTarget.valid) {
            linuxPrintStandardError(
                "error[E_BUILD_TARGET_UNSUPPORTED]: program '${request.name}' requested target '${request.target}', which is neither built in nor defined by this build graph\n"
            )
            status = 148
        }
        if (status == 0 && !Path(request.output).parent().createDirectories()) {
            linuxPrintStandardError(
                "error[E_BUILD_OUTPUT]: cannot create output directory for program '${request.name}'\n"
            )
            status = 149
        }
        if (status == 0) {
            names.append(request.name)
            outputs.append(request.output)
            var slice = false
            var sliceEntry = 0
            while (sliceEntry < sliceEntries.size) {
                if (sliceEntries[sliceEntry] == request.entry) slice = true
                sliceEntry = sliceEntry + 1
            }
            bootstrapArtifactSliceActive = slice ||
                bootstrapIndependentEntryIdentity(request.entry)
            // A program's entry (a path, read against the working directory) that isn't there fails the build; it used to
            // compile as an empty program, a 54-byte Wasm module with exit status 0.
            val entryMissing = !bootstrapArtifactSliceActive && !Path(request.entry).exists()
            if (entryMissing) {
                linuxPrintStandardError(
                    "error[E_SOURCE_NOT_FOUND]: program '${request.name}': no such file: ${request.entry} (looked for it from ${currentDirectory().text})\n"
                )
            }
            val coverageSupported = bootstrapLlvmCoverageTarget(requestedTarget.llvmTriple,
                requestedTarget.objectFormat, requestedTarget.libcFree, request.artifact)
            if (bootstrapLlvmCoverageRequested && !coverageSupported) {
                linuxPrintStandardError(
                    "warning[W_COVERAGE_TARGET]: program '${request.name}' target '${request.target}' artifact '${request.artifact}' built without function coverage\n"
                )
            }
            status = if (entryMissing) 161 else bootstrapOrcBuildSingle(
                request.entry,
                request.output,
                request.fast,
                request.cache && !(bootstrapLlvmCoverageRequested && coverageSupported),
                requestedTarget,
                request.artifact
            )
            bootstrapArtifactSliceActive = false
            val recursiveArtifactRoots = bootstrapTakeArtifactRootRequests()
            if (status == 0 && recursiveArtifactRoots.size > 0) {
                linuxPrintStandardError(
                    "error[E_ARTIFACT_ROOT_RECURSION]: child program contributed artifact roots outside a generated slice\n"
                )
                status = 160
            }
            val nested = bootstrapTakeCompileProgramRequests()
            val nestedTargets = bootstrapTakeDefinedTargets()
            if (status == 0) {
                status = bootstrapAppendDefinedTargets(
                    targets,
                    nestedTargets
                )
            }
            var nestedIndex = 0
            while (nestedIndex < nested.size && queued.size < 64) {
                queued.append(nested[nestedIndex])
                nestedIndex = nestedIndex + 1
            }
            if (nestedIndex < nested.size) {
                linuxPrintStandardError(
                    "error[E_BUILD_GRAPH_LIMIT]: programmable build exceeds 64 program nodes\n"
                )
                status = 150
            }
        }
        cursor = cursor + 1
    }
    if (status == 0 && cursor < queued.size) {
        linuxPrintStandardError(
            "error[E_BUILD_GRAPH_LIMIT]: programmable build exceeds 64 program nodes\n"
        )
        status = 150
    }
    val packages = bootstrapTakeApplePackages()
    var package = 0
    while (status == 0 && package < packages.size) {
        status = bootstrapRunApplePackage(packages[package])
        package = package + 1
    }
    status
}

// One REPL line compiled by a child compiler (`--emit-llvm`): its LLVM IR,
// or a failed status once the child has printed the line's diagnostics. The
// compiler keeps tables in module values from one compilation to the next, so
// neither a region nor the collector can give a line's memory back; the
// child's goes back to the system when it exits.
// The entry takes bytes `begin` to `end` of the source, and a place after it up to `limit` is its end
// (diagnostic_positions.ab: the child names places in the entry, not in the file).
fun bootstrapReplCompile(sourcePath: string, begin: int, end: int, limit: int): LinuxProcessResult {
    val child = linuxCommand("/proc/self/exe")
    child.argument("--emit-llvm")
    child.argument(sourcePath)
    child.environment("ABLA_REPL_ENTRY", "$begin:$end:$limit:$sourcePath")
    child.capture()
}

// `ablac repl`: a live session (live_repl.ab) where live mode runs; elsewhere the REPL below.
fun bootstrapRepl(): int = if (bootstrapLiveRunSupported()) bootstrapReplLive() else bootstrapReplChildren()

// The live session: its program runs with bootstrapReplStep reading the lines, again after each :reset. 0, or the run's
// status when it failed.
fun bootstrapReplLive(): int {
    bootstrapReplSourcePath = "build/.abla-repl-source.${linuxProcessId()}.ab"
    bootstrapDiagnosticEntryPath = bootstrapReplSourcePath
    Path("build").createDirectories()
    var status = 0
    var running = true
    while (running) {
        bootstrapReplDeclarations = []
        bootstrapReplLines = 0
        bootstrapReplEnding = false
        bootstrapReplQuit = false
        if (!Path(bootstrapReplSourcePath).writeTextAtomic(bootstrapReplSource([], ""))) return 141
        status = bootstrapRunInProcess(bootstrapReplSourcePath, [], llvmPassesBalanced(), true, false, true)
        if (bootstrapReplQuit || status != 0) running = false
    }
    Path(bootstrapReplSourcePath).remove()
    status
}

// The REPL where there is no live mode, one line a run, so nothing persists but declarations:
// Persistent language REPL. Definitions are retained as source and included
// in later expression generations. Publication is transactional: a malformed
// definition is diagnosed without changing the accepted declaration set.
// Machine code remains a reclaimable ORC generation in one LLJIT session.
// Each line compiles in a child compiler (bootstrapReplCompile).
fun bootstrapReplChildren(): int {
    val session = llvmOrcCreateSession()
    val standardInput = linuxStandardInput()
    val sourcePath = "build/.abla-repl-source.${linuxProcessId()}.ab"
    var declarations = ""
    var status = session.status
    var running = status == 0
    while (running) {
        linuxPrintStandardOutput("abla> ")
        val inputLine = bootstrapReplReadEntry(standardInput)
        val line = inputLine.text
        val command = if (inputLine.available) bootstrapReplCommandName(line) else ""
        if (!inputLine.available || command == ":quit") {
            running = false
        } else if (command == ":reset") {
            declarations = ""
            linuxPrintStandardOutput("reset\n")
        } else if (command != "") {
            bootstrapReplOtherCommand(command)
        } else if (line != "" && bootstrapReplDeclaration(line)) {
            val source = "$declarations$line\nfun main: int = 0\n"
            if (!Path(sourcePath).writeTextAtomic(source)) {
                status = 141
                running = false
            } else {
                if (bootstrapReplCompile(sourcePath, declarations.size, declarations.size + line.size,
                    declarations.size + line.size).status == 0) {
                    declarations = "$declarations$line\n"
                    linuxPrintStandardOutput("defined\n")
                }
            }
        } else if (line != "") {
            val source = "$declarations\nfun main: int = $line\n"
            if (!Path(sourcePath).writeTextAtomic(source)) {
                status = 141
                running = false
            } else {
                // "\nfun main: int = " is 17 bytes.
                val begin = declarations.size + 17
                val compilation = bootstrapReplCompile(sourcePath, begin, begin + line.size, source.size)
                if (compilation.status == 0) {
                    val llvmPath = "build/.abla-repl.${linuxProcessId()}.ll"
                    if (!Path(llvmPath).writeTextAtomic(
                        compilation.output
                    )) {
                        status = 141
                        running = false
                    } else {
                        val generation = session.addFile(llvmPath)
                        if (generation.status != 0) {
                            status = generation.status
                            running = false
                        } else {
                            val lookup = session.lookup("main")
                            if (lookup.status != 0) {
                                status = lookup.status
                                running = false
                            } else {
                                val value = callNativeMain(lookup.address)
                                linuxPrintStandardOutput("$value\n")
                            }
                            val removeStatus = generation.remove()
                            if (status == 0 && removeStatus != 0) {
                                status = removeStatus
                                running = false
                            }
                        }
                    }
                }
            }
        }
    }
    // (Per process, so REPLs in one project don't overwrite each other's source.)
    Path(sourcePath).remove()
    Path("build/.abla-repl.${linuxProcessId()}.ll").remove()
    val closeStatus = session.close()
    if (status == 0 && closeStatus != 0) status = closeStatus
    status
}

fun bootstrapOrcUsage(): int {
    linuxPrintStandardError(
        "usage: ablac build [<file.ab> | --project <dir>] [-o output] [--emit executable|object|static-library|shared-library] [--fast | --o1] [-g | --debug | --no-debug] [--no-cache] [--sidecar | --no-sidecar] [--offline] [--strict-imports | --flat-imports | --strict-imports=warn] [--visibility-report <file>] [--warn-unused-imports | --no-warn-unused-imports] [--warn-unused-locals] [--warn-unused-parameters] [--warn-unused-declarations] [--target <name> | --target-triple <triple> --object-format <elf|macho|coff|wasm>]\n       targets: ${bootstrapSupportedTargets()}\n       --flat-imports sets only packages that do not say visibility: one with visibility = \"imports\" in its abla.toml stays strict\n       ablac package update [--project <dir>]\n       ablac package vendor [--project <dir>] [--offline]\n       ablac package install [--project <dir>] [--offline] # the lock's packages at their locked revisions (build, run and test do this themselves)\n       ablac test <file.ab>... [--fast] [--no-cache] [--watch] [--strict-imports | --flat-imports | --strict-imports=warn] # build (--o1) and run test programs (abla/test)\n       ablac run [--o1 | --fast] [--built | --release] [--live | --no-live | --watch] [--strict-imports | --flat-imports | --strict-imports=warn] [<file.ab> | --project <dir>] [--offline] [-- <program arguments>] # in-process LLVM ORC (--built: cached build, exec'd; live, its functions redefinable while it runs, by default on x86-64 Linux and macOS: --no-live opts out, --live asks elsewhere; --watch: live, reloaded when a source file changes)\n       ablac repl                                # persistent definitions + expressions\n       ablac serve [<file.ab> | --project <dir>] # watched fast-build service\n       ablac fix-imports [<file.ab> | --project <dir>] [--prune] [--dry-run] # add the imports the program is missing (project modules and the standard library); --prune removes the unused ones\n       ablac fmt [--check] [--width 100] <file.ab|directory|->...\n       ablac analyze --stdio                     # persistent JSON-lines analysis service\n       ablac --emit-llvm <file.ab>\n"
    )
    2
}

// The frontend and the compile-time evaluator hold about 30 KB of stack per
// level of nesting: an expression a few hundred levels deep fits the default
// 8 MB stack, but a large program's deepest paths (a game server's economy
// test) may not. Run with the launcher's stack instead: raise the
// soft limit to 128 MB (or the hard limit, if lower) and start over, so a
// direct `ablac.bin` call behaves as one through build/ablac.
fun bootstrapEnsureCompilerStack(): void {
    val wanted = 134217728
    val limits = linuxStackLimits()
    if (limits.size == 2 && limits[0] >= 0) {
        val target = if (limits[1] >= 0 && limits[1] < wanted) limits[1]
            else wanted
        if (limits[0] < target &&
            linuxSetStackLimits(target, limits[1])) {
            // Start over only once the new limit reads back (no exec loop).
            val raised = linuxStackLimits()
            if (raised.size == 2 && raised[0] >= target) linuxReexecute()
        }
    }
    return
}

fun main: int {
    bootstrapEnsureCompilerStack()
    // This image runs `--codegen-unit`: a fast build may start it for units.
    bootstrapCodegenUnitsInCompiler = true
    // The compiler collects each time its heap grows by a fixed step: a step large enough
    // that collecting costs little, small enough that a large build's peak stays a
    // fraction of what it allocates. Under its launcher's budget (which the launcher
    // always sets) the same step, the budget being a hard cap besides: the runtime's own
    // 64 MiB step had a large build collect every 150 ms while its heap was small.
    val trackedMemoryLimit = bootstrapCompilerTrackedMemoryLimit()
    val collectionGrowth = bootstrapCompilerCollectionGrowth()
    if (trackedMemoryLimit > 0) runtimeMemorySetLimit(trackedMemoryLimit)
    if (collectionGrowth > 0) {
        runtimeMemorySetCollectionGrowth(collectionGrowth)
        bootstrapCtCollectionGrowth = collectionGrowth
    } else if (trackedMemoryLimit == 0) runtimeMemorySetManualCollection()
    // Freed small blocks kept for reuse: a program's up to 128 MB took an Xtensa build past
    // the launcher's 4 GB, as the compiler's sizes change from phase to phase.
    runtimeMemorySetFreeBlockLimit(33554432)
    // What a collection finds unreachable (millions of blocks in a large build) is
    // freed by the runtime's helper thread while compiling goes on.
    runtimeMemorySetBackgroundFree(true)
    val argumentCount = linuxArgumentCount()
    var argument0 = ""
    var argument1 = ""
    if (argumentCount > 0) argument0 = linuxArgument(0)
    if (argumentCount > 1) argument1 = linuxArgument(1)
    var status = 2
    if (argumentCount == 1 && argument0 == "--version") {
        linuxPrintStandardOutput("ablac ${ABLA_COMPILER_VERSION}\n")
        status = 0
    }
    if (argumentCount >= 1 && argument0 == "fmt") return bootstrapFormatCommand()
    if (argumentCount == 1 && argument0 == "repl") {
        status = bootstrapRepl()
    }
    if (argumentCount == 2 && argument0 == "analyze" &&
        argument1 == "--stdio") {
        status = bootstrapAnalysisService()
    }
    if (argumentCount == 2 && argument0 == "--emit-llvm") {
        status = if (bootstrapSourceFound(argument1)) bootstrapOrcEmit(argument1) else 1
    }
    if (argumentCount == 9 && argument0 == "--codegen-unit") {
        status = bootstrapEmitCodegenUnit(
            argument1,
            linuxArgument(2),
            linuxArgument(3),
            linuxArgument(4),
            bootstrapCodegenDigits(linuxArgument(5)),
            linuxArgument(6),
            linuxArgument(7),
            linuxArgument(8)
        )
    }
    if (argumentCount == 3 && argument0 == "--aot-plan") {
        status = bootstrapPrepareCompilerParts(
            argument1, bootstrapCodegenDigits(linuxArgument(2))
        )
    }
    if (argumentCount == 5 && argument0 == "--aot-object") {
        status = bootstrapEmitCompilerPart(
            argument1, linuxArgument(2), linuxArgument(3),
            bootstrapCodegenDigits(linuxArgument(4))
        )
    }
    if (argumentCount == 3 && argument0 == "--aot-object") {
        status = llvmAotEmitObjectFile(
            argument1,
            linuxArgument(2)
        )
    }
    if (argumentCount >= 2 && argument0 == "package") {
        val operation = argument1
        var projectRoot = "."
        var offline = false
        var valid = operation == "update" || operation == "vendor" || operation == "install"
        var option = 2
        while (option < argumentCount) {
            val value = linuxArgument(option)
            if (value == "--project" && option + 1 < argumentCount) {
                projectRoot = linuxArgument(option + 1)
                option = option + 1
            } else if (value == "--offline" && (operation == "vendor" || operation == "install")) {
                offline = true
                0
            } else {
                valid = false
                0
            }
            option = option + 1
        }
        val project = bootstrapProjectDescriptor(projectRoot)
        if (!project.valid) {
            linuxPrintStandardError("${project.diagnostic}\n")
            valid = false
        }
        if (valid && operation == "install") {
            // The lock's packages at their locked revisions, as a build would install them (never re-resolved).
            val installed = bootstrapPackageInstallLocked(projectRoot, offline)
            if (installed.diagnostic != "") linuxPrintStandardError(installed.diagnostic)
            status = installed.status
            valid = false
        }
        if (valid) {
            val resolveEffects = bootstrapPackageAuthorizedEffects(
                projectRoot
            )
            val imported = bootstrapDiscoverImportProviders(
                project.entry, operation == "update", resolveEffects
            )
            var result = BootstrapPackageResult(1, imported.diagnostic)
            if (imported.errors == 0 && operation == "update") {
                result = bootstrapPackageUpdateWithDependencies(
                    projectRoot, imported
                )
            }
            if (imported.errors == 0 && operation == "vendor") {
                result = bootstrapPackageVendorWithDependencies(
                    projectRoot, imported, offline
                )
            }
            if (result.diagnostic != "") {
                linuxPrintStandardError(result.diagnostic)
            }
            status = result.status
        }
    }
    if (argumentCount >= 1 && argument0 == "build") {
        var sourcePath = ""
        var outputPath = "build/abla-out"
        var outputExplicit = false
        // ABLA_TEST_FAST_BUILDS=1 (tools/run-tests.sh): --fast, for a build of the host.
        var fast = false
        val fastBuilds = linuxEnvironment("ABLA_TEST_FAST_BUILDS")
        if (fastBuilds.found && fastBuilds.value == "1") {
            fast = true
            var argument = 1
            while (argument < argumentCount) {
                val value = linuxArgument(argument)
                if (value.startsWith("--target") || value == "--project") fast = false
                argument = argument + 1
            }
        }
        var useCache = true
        var offline = false
        var targetName = bootstrapHostTargetName()
        var namedTarget = ""
        var targetTriple = ""
        var targetObjectFormat = ""
        var artifact = "default"
        var valid = true
        var option = 1
        var projectRoot = ""
        if (argumentCount > 1) {
            val possibleSource = linuxArgument(1)
            if (possibleSource != "--project" &&
                possibleSource.size > 0 && possibleSource[0] != 45) {
                sourcePath = possibleSource
                option = 2
            }
        }
        while (option < argumentCount) {
            val value = linuxArgument(option)
            if (value == "--fast") {
                fast = true
                0
            } else if (value == "--o1") {
                bootstrapOrcBalanced = true
                0
            } else if (value == "--no-cache") {
                useCache = false
                0
            } else if (value == "--cache-dir" && option + 1 < argumentCount) {
                bootstrapCacheDirectoryRequest = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "-g" || value == "--debug") {
                bootstrapOrcDebugRequest = "on"
                0
            } else if (value == "--no-debug") {
                bootstrapOrcDebugRequest = "off"
                0
            } else if (value == "--sidecar") {
                bootstrapNativeSidecarRequest = 1
                0
            } else if (value == "--no-sidecar") {
                bootstrapNativeSidecarRequest = 0
                0
            } else if (bootstrapStrictImportsOption(value)) {
                // (The warnings come from the front end, which a cached build skips.)
                if (bootstrapStrictImportsWarn) useCache = false
                0
            } else if (value == "--warn-unused-imports") {
                // W_UNUSED_IMPORT is on by default; this asks for it over ABLA_WARN_UNUSED_IMPORTS=0. A cache hit
                // prints the lines its entry kept (toolchain.ab).
                bootstrapUnusedImportsRequested = true
                0
            } else if (value == "--warn-unused-locals") {
                // W_UNUSED_LOCAL, opt-in: found by the front end, which a cached build skips.
                bootstrapUnusedLocalsRequested = true
                useCache = false
                0
            } else if (value == "--warn-unused-parameters") {
                // W_UNUSED_PARAMETER, opt-in: found by the front end, which a cached build skips.
                bootstrapUnusedParametersRequested = true
                useCache = false
                0
            } else if (value == "--warn-unused-declarations") {
                // W_UNUSED_DECLARATION, opt-in: found by the front end, which a cached build skips.
                bootstrapUnusedDeclarationsRequested = true
                useCache = false
                0
            } else if (value == "--no-warn-unused-imports") {
                bootstrapUnusedImportsDeclined = true
                0
            } else if (value == "--visibility-report" && option + 1 < argumentCount) {
                // Written by the front end, which a cached build skips.
                bootstrapVisibilityReportPath = linuxArgument(option + 1)
                useCache = false
                option = option + 1
                0
            } else if (value == "--coverage-functions") {
                // Which source files the program ran (backend/llvm/coverage.ab); never cached.
                bootstrapLlvmCoverageRequested = true
                useCache = false
                0
            } else if (value == "--wasm-imports") {
                // Lists a WebAssembly module's imports; written at the link, which a cached build still runs.
                bootstrapWasmImportsReport = true
                0
            } else if (value == "-v" || value == "--verbose") {
                // Notes on how the build linked (#806: why it links libc).
                bootstrapBuildVerbose = true
                0
            } else if (value == "--offline") {
                offline = true
                0
            } else if (value == "--target" &&
                option + 1 < argumentCount) {
                targetName = linuxArgument(option + 1)
                namedTarget = targetName
                option = option + 1
                0
            } else if (value == "--target-triple" &&
                option + 1 < argumentCount) {
                targetTriple = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "--object-format" &&
                option + 1 < argumentCount) {
                targetObjectFormat = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "--emit" &&
                option + 1 < argumentCount) {
                artifact = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "--project" &&
                option + 1 < argumentCount && sourcePath == "") {
                projectRoot = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "-o" && option + 1 < argumentCount) {
                outputPath = linuxArgument(option + 1)
                outputExplicit = true
                option = option + 1
                0
            } else {
                valid = false
                0
            }
            option = option + 1
        }
        if (valid && sourcePath == "") {
            if (projectRoot == "") projectRoot = "."
            val project = bootstrapProjectDescriptor(projectRoot)
            if (project.valid) {
                sourcePath = project.entry
                if (!outputExplicit) outputPath = project.output
                val imported = bootstrapDiscoverImportProviders(project.entry)
                if (imported.errors != 0) {
                    linuxPrintStandardError(imported.diagnostic)
                    valid = false
                }
                if (valid) {
                    val prepared = bootstrapPackagePrepareWithDependencies(
                        projectRoot, imported, offline
                    )
                    if (prepared.status != 0) {
                        linuxPrintStandardError(prepared.diagnostic)
                        valid = false
                    }
                }
            } else {
                linuxPrintStandardError("${project.diagnostic}\n")
                valid = false
            }
        } else if (valid && projectRoot == "" && !bootstrapOrcInstallLockedFor(sourcePath, offline)) {
            valid = false
        }
        val rawTarget = targetTriple != "" || targetObjectFormat != ""
        if (artifact == "default") {
            artifact = if (rawTarget) "object" else "executable"
        }
        if (rawTarget && (namedTarget != "" || targetTriple == "" ||
            targetObjectFormat == "" ||
            (artifact != "object" && artifact != "static-library"))) {
            linuxPrintStandardError(
                "a raw target requires --target-triple and --object-format, cannot be combined with --target, and emits only object or static-library artifacts\n"
            )
            valid = false
        }
        val target = if (rawTarget) bootstrapRawObjectTargetDescriptor(
            targetTriple, targetObjectFormat
        ) else bootstrapTargetDescriptor(targetName)
        if (!target.valid) {
            linuxPrintStandardError(
                if (rawTarget)
                    "unsupported raw target '$targetTriple' with object format '$targetObjectFormat'\n"
                else "unsupported target '$targetName'; supported targets: ${bootstrapSupportedTargets()}\n"
            )
            valid = false
        }
        if (valid && bootstrapLlvmCoverageRequested && !bootstrapLlvmCoverageTarget(target.llvmTriple,
            target.objectFormat, target.libcFree, artifact)) {
            linuxPrintStandardError(
                "error[E_COVERAGE_TARGET]: --coverage-functions builds a Linux executable, shared library or object or a macOS executable; this target or artifact is not one\n"
            )
            valid = false
            status = 2
        }
        if (valid && !bootstrapSourceFound(sourcePath)) {
            valid = false
            status = 1
        }
        if (valid) {
            status = bootstrapOrcBuild(
                sourcePath,
                outputPath,
                fast,
                useCache,
                target,
                artifact
            )
        }
    }
    if (argumentCount >= 1 && argument0 == "test") {
        status = bootstrapOrcTest(argumentCount)
    }
    if (argumentCount >= 1 && argument0 == "run") {
        var runSource = ""
        var runValid = true
        var runProject = ""
        var runOffline = false
        // `ablac run [--o1|--fast|--release|--jit|--built] <file> -- a b …`:
        // everything after `--` is the program's own arguments
        // (processArgument(0…)); the run options come before it. The program is
        // compiled in process with the --o1 IR pipeline (--fast: the fast one)
        // and called there (bootstrapRunInProcess; --jit names that default).
        // --built builds it through the build cache and execs it
        // (bootstrapRunBuilt), as --release always does.
        var runCount = argumentCount
        val runArguments: array<string> = []
        var scan = 1
        while (scan < argumentCount && runCount == argumentCount) {
            if (linuxArgument(scan) == "--") runCount = scan
            scan = scan + 1
        }
        scan = runCount + 1
        while (scan < argumentCount) {
            runArguments.append(linuxArgument(scan))
            scan = scan + 1
        }
        var runProfile = "o1"
        var runBuilt = false
        // Live (live.ab) by default where it is supported, x86-64 Linux and macOS (decision #65); --no-live opts out and
        // --live asks for it anywhere.
        var runLive = bootstrapLiveRunSupported()
        // --watch: live, and reloaded when one of the program's own source files changes (live_watch.ab).
        var runWatch = false
        val runOptions: array<string> = []
        scan = 1
        while (scan < runCount) {
            val option = linuxArgument(scan)
            if (option == "--o1") runProfile = "o1"
            else if (option == "--fast") runProfile = "fast"
            else if (option == "--release") {
                runProfile = "release"
                runBuilt = true
            } else if (option == "--built") runBuilt = true
            else if (option == "--live") runLive = true
            else if (option == "--no-live") runLive = false
            else if (option == "--watch") {
                runWatch = true
                runLive = true
            }
            else if (option == "--jit") runBuilt = false
            else if (bootstrapStrictImportsOption(option)) 0
            else if (option == "--cache-dir" && scan + 1 < runCount) {
                scan = scan + 1
                bootstrapCacheDirectoryRequest = linuxArgument(scan)
            } else runOptions.append(option)
            scan = scan + 1
        }
        if (runOptions.size == 1) runSource = runOptions[0]
        if (runOptions.size == 0) {
            val project = bootstrapProjectDescriptor(".")
            runValid = project.valid
            runSource = project.entry
            runProject = "."
            if (!runValid) linuxPrintStandardError("${project.diagnostic}\n")
        }
        if (runOptions.size == 2 && runOptions[0] == "--project") {
            val project = bootstrapProjectDescriptor(runOptions[1])
            runValid = project.valid
            runSource = project.entry
            runProject = runOptions[1]
            if (!runValid) linuxPrintStandardError("${project.diagnostic}\n")
        }
        if (runOptions.size == 3 && runOptions[0] == "--project" &&
            runOptions[2] == "--offline") {
            val project = bootstrapProjectDescriptor(runOptions[1])
            runValid = project.valid
            runSource = project.entry
            runProject = runOptions[1]
            runOffline = true
            if (!runValid) linuxPrintStandardError("${project.diagnostic}\n")
        }
        if (runOptions.size > 3 || runSource == "") runValid = false
        if (runValid && !bootstrapSourceFound(runSource)) {
            runValid = false
            status = 1
        }
        if (runValid && runProject == "" && runSource != "" && !bootstrapOrcInstallLockedFor(runSource, runOffline)) {
            runValid = false
        }
        if (runValid && runProject != "") {
            val imported = bootstrapDiscoverImportProviders(runSource)
            if (imported.errors != 0) {
                linuxPrintStandardError(imported.diagnostic)
                runValid = false
            }
            if (runValid) {
                val prepared = bootstrapPackagePrepareWithDependencies(
                    runProject, imported, runOffline
                )
                if (prepared.status != 0) {
                    linuxPrintStandardError(prepared.diagnostic)
                    runValid = false
                }
            }
        }
        if (runValid && runWatch && (runBuilt || !runLive)) {
            linuxPrintStandardError("ablac run: --watch reloads a live in-process run; it does not go with --built, --release or --no-live\n")
            runValid = false
            status = 2
        }
        if (runValid && !runBuilt) {
            status = bootstrapRunInProcess(
                runSource, runArguments,
                if (runProfile == "fast") llvmPassesFast() else llvmPassesBalanced(),
                runLive,
                runWatch
            )
        } else if (runValid) {
            status = bootstrapRunBuilt(runSource, runArguments, runProfile)
        }
    }
    if (argumentCount >= 1 && argument0 == "fix-imports") {
        val fixArguments: array<string> = []
        var fixIndex = 1
        while (fixIndex < argumentCount) {
            fixArguments.append(linuxArgument(fixIndex))
            fixIndex = fixIndex + 1
        }
        return bootstrapFixImportsCommand(fixArguments)
    }
    if (argumentCount >= 1 && argument0 == "serve") {
        var serveSource = ""
        var serveValid = true
        if (argumentCount == 2) serveSource = argument1
        if (argumentCount == 1) {
            val project = bootstrapProjectDescriptor(".")
            serveValid = project.valid
            serveSource = project.entry
            if (!serveValid) {
                linuxPrintStandardError("${project.diagnostic}\n")
            }
        }
        if (argumentCount == 3 && argument1 == "--project") {
            val project = bootstrapProjectDescriptor(linuxArgument(2))
            serveValid = project.valid
            serveSource = project.entry
            if (!serveValid) {
                linuxPrintStandardError("${project.diagnostic}\n")
            }
        }
        if (argumentCount > 3 || serveSource == "") serveValid = false
        if (serveValid) {
            status = bootstrapServeWithEmitter(
                serveSource,
                llvmAotEmitObjectFileFast,
                "inprocess-fast"
            )
        }
    }
    if (status == 2) status = bootstrapOrcUsage()
    status
}
