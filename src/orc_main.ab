// The guarded compiler launcher already supplies its process memory budget.
// Feed a conservative portion of the same budget to Abla's tracked allocator
// so its precise root collector is active during large whole-program builds.
// Without this, short-lived parser/evaluator graphs are reference-released but
// cyclic garbage and allocator high-water pages accumulate until the outer OS
// address-space limit is reached.
fun bootstrapCompilerTrackedMemoryLimit(): int {
    val configured = linuxEnvironment("ABLA_MAX_MEMORY_MB")
    var megabytes = 0
    var valid = configured.found && configured.value.size > 0
    var index = 0
    while (valid && index < configured.value.size) {
        val byte = configured.value[index]
        if (byte < 48 || byte > 57) valid = false
        else if (megabytes > 1048575) valid = false
        else megabytes = megabytes * 10 + byte - 48
        index = index + 1
    }
    if (valid && megabytes > 0) {
        (megabytes - megabytes / 4) * 1048576
    } else 0
}

// The compiler collects whenever its heap has grown by this much since what the last
// collection kept (ABLA_COMPILER_COLLECT_GROWTH_MB; 0: the runtime's own step under a
// launcher budget, else never collects).
val BOOTSTRAP_COMPILER_COLLECTION_GROWTH_MB = 256

fun bootstrapCompilerCollectionGrowth(): int {
    val configured = linuxEnvironment("ABLA_COMPILER_COLLECT_GROWTH_MB")
    var megabytes = BOOTSTRAP_COMPILER_COLLECTION_GROWTH_MB
    if (configured.found && configured.value.size > 0) {
        var parsed = 0
        var valid = true
        var index = 0
        while (index < configured.value.size) {
            val byte = configured.value[index]
            if (byte < 48 || byte > 57 || parsed > 1048575) valid = false
            else parsed = parsed * 10 + byte - 48
            index = index + 1
        }
        if (valid) megabytes = parsed
    }
    megabytes * 1048576
}

fun bootstrapOrcEmit(sourcePath: string): int {
    bootstrapBeginCompileOutputs()
    val parsed = bootstrapParseHostModuleWithRuntime(sourcePath)
    var status = 1
    val compilation = bootstrapCompileLlvmParsed(parsed)
    val requestedPrograms = bootstrapTakeCompileProgramRequests()
    val definedTargets = bootstrapTakeDefinedTargets()
    val artifactRoots = bootstrapTakeArtifactRootRequests()
    if (compilation.errors == 0 && requestedPrograms.size == 0 &&
        definedTargets.size == 0 && artifactRoots.size == 0) {
        linuxPrintStandardOutput(compilation.output)
        status = 0
    }
    if (requestedPrograms.size > 0 || definedTargets.size > 0 ||
        artifactRoots.size > 0) {
        linuxPrintStandardError(
            "error[E_BUILD_COMMAND_UNSUPPORTED]: --emit-llvm cannot execute programmable build nodes; use 'ablac build'\n"
        )
    }
    if (compilation.errors != 0) {
        linuxPrintStandardError(
            bootstrapDiagnosticPositions(compilation.diagnostics)
        )
        linuxPrintStandardError(
            "LLVM compilation failed: ${compilation.parserErrors} parser, ${compilation.extensionErrors} extension, ${compilation.semanticErrors} semantic, ${compilation.irErrors} IR, ${compilation.errors} total error(s)\n"
        )
    }
    if (status == 0 && !bootstrapCommitCompileOutputs()) status = 144
    if (status != 0) bootstrapDiscardCompileOutputs()
    status
}

// `ablac run` (the default, and --jit): compiles the program in process, runs
// the IR pipeline `passes` on it (the --o1 one unless --fast), and calls it
// there through LLVM ORC. The object goes through the JIT object cache
// (jit_cache.ab): an unchanged program reruns without compiling.
fun bootstrapRunInProcess(
    sourcePath: string,
    arguments: array<string> = [],
    passes: string = ""
): int {
    val key = jitRunKey(sourcePath, passes)
    val session = llvmOrcCreateSession()
    var status = session.status
    var generation = LlvmOrcGeneration(nativeNullPointer(), 128, true)
    var entry = 0
    val cached = if (status == 0) jitRunCachedObject(key) else ""
    if (cached != "") {
        generation = session.addObjectFile(cached)
        if (generation.status == 0) {
            val lookup = session.lookup("main")
            if (lookup.status == 0) entry = lookup.address
            else {
                // An object the JIT cannot link is compiled afresh.
                val removed = generation.remove()
                generation = LlvmOrcGeneration(nativeNullPointer(), 128, true)
            }
        }
    }
    if (status == 0 && entry == 0) {
        val prepared = bootstrapPrepareRun(sourcePath, true)
        status = prepared.status
        if (status == 0) {
            // The session owns the held module from here on.
            generation = session.addModule(bootstrapLlvmHeldContext, bootstrapLlvmHeldModule, passes)
            bootstrapLlvmHeldContext = nativeNullPointer()
            bootstrapLlvmHeldModule = nativeNullPointer()
            status = generation.status
        }
        if (status == 0 && key.valid && !prepared.cacheable) {
            jitCacheTrace("uncacheable (a top-level compile action, a nondeterministic grant or a staged output)")
        }
        if (status == 0 && key.valid && prepared.cacheable &&
            Path(JIT_CACHE_DIRECTORY).createDirectories()) {
            val objectPath = jitRunObjectPath(key, prepared.sourcePaths)
            val lookup = session.lookupCapturing("main", objectPath)
            status = lookup.status
            entry = lookup.address
            if (!lookup.captured) jitCacheTrace("uncaptured (not exactly one module compiled)")
            if (lookup.captured) {
                val published = jitRunPublish(key, jitRunRecord(
                    objectPath, prepared.sourcePaths,
                    prepared.compileInputPaths, prepared.compileInputContents
                ), objectPath)
            }
        } else if (status == 0) {
            val lookup = session.lookup("main")
            status = lookup.status
            entry = lookup.address
        }
    }
    if (status == 0) {
        val frame = ctBridgeRunFrameBegin(sourcePath)
        status = llvmOrcCallMain(entry, sourcePath, arguments)
        ctBridgeRunFrameEnd(frame)
    }
    val removeStatus = generation.remove()
    if (status == 0 && removeStatus != 0) status = removeStatus
    val closeStatus = session.close()
    if (status == 0 && closeStatus != 0) status = closeStatus
    status
}

// The executable `ablac run` keeps for an entry: build/.abla-run/ and the
// source path with every byte outside [A-Za-z0-9._-] as '_'.
fun bootstrapRunExecutablePath(sourcePath: string): string {
    val name = byteBuffer()
    var index = 0
    while (index < sourcePath.size) {
        val byte = sourcePath[index]
        val kept = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 46 || byte == 45 || byte == 95
        name.appendByteValue(if (kept) byte else 95)
        index = index + 1
    }
    "build/.abla-run/${name.toText()}"
}

// `ablac run --built`: builds the entry through the build cache, in the --o1
// profile unless `profile` is "fast" or "release", and execs the result.
// The object cache is keyed by the compiler's image, the LLVM library and the
// profile, so an unchanged program skips compiling, and a new compiler or
// profile never reuses an old object. The executable is linked under a name
// of this process's own and renamed into place: a run that overlaps another
// of the same entry never rewrites a binary that is executing. The program
// replaces this process, so it keeps the standard streams, the working
// directory and the environment, and none of the compiler's memory; its
// argv[0] is the source path, as under --jit.
fun bootstrapRunBuilt(
    sourcePath: string,
    arguments: array<string>,
    profile: string
): int {
    val output = bootstrapRunExecutablePath(sourcePath)
    val staged = "$output.${linuxProcessId()}"
    bootstrapOrcBalanced = profile == "o1"
    bootstrapNativeSidecarRequest = 0
    var status = bootstrapOrcBuild(
        sourcePath, staged, profile == "fast", true,
        bootstrapTargetDescriptor(bootstrapHostTargetName()), "executable"
    )
    for (suffix in [".abi.json", ".ll", ".o", ".host.o", ".runtime.o",
                    ".raw-runtime.o", ".o.bc"]) {
        Path("$staged$suffix").remove()
    }
    // ELF builds can split the object into a root and up to 32 partitions.
    // These belong to this process's staging path, just like the main object.
    Path("$staged.o.root.ll").remove()
    Path("$staged.o.root.o").remove()
    var partition = 0
    while (partition < 32) {
        Path("$staged.o.part.$partition.ll").remove()
        Path("$staged.o.part.$partition.o").remove()
        partition = partition + 1
    }
    if (status == 0 && !Path(staged).moveTo(Path(output))) {
        linuxPrintStandardError("error: cannot place the program at $output\n")
        status = 1
    }
    if (status != 0) {
        Path(staged).remove()
        return status
    }
    val argv: array<string> = [sourcePath]
    for (argument in arguments) argv.append(argument)
    status = linuxExecute(output, argv)
    linuxPrintStandardError("error: cannot execute $output\n")
    status
}

// `--o1`: the whole build (and the programs its build definition registers)
// takes the middle profile, between --fast and the release default.
var bootstrapOrcBalanced = false

// `ablac test <file.ab>... [--o1] [--no-cache]`: builds each test program
// (--fast, or --o1) into build/abla-test and runs it; one passes when it
// exits 0 (see abla/test's testsPassed). 0 when every one passed.
fun bootstrapOrcTest(argumentCount: int): int {
    val sources: array<string> = []
    var useCache = true
    var option = 1
    while (option < argumentCount) {
        val value = linuxArgument(option)
        if (value == "--o1") bootstrapOrcBalanced = true
        else if (value == "--no-cache") useCache = false
        else sources.append(value)
        option = option + 1
    }
    if (sources.size == 0) return 2
    val target = bootstrapTargetDescriptor(bootstrapHostTargetName())
    val directory = Path("build/abla-test")
    directory.createDirectories()
    var failed = 0
    var index = 0
    while (index < sources.size) {
        val source = sources[index]
        var name = Path(source).name()
        if (name.size > 3 && name.slice(name.size - 3, name.size) == ".ab") {
            name = name.slice(0, name.size - 3)
        }
        val output = directory.child(name).text
        var result = bootstrapOrcBuild(
            source, output, !bootstrapOrcBalanced, useCache, target,
            "executable"
        )
        val built = result == 0
        if (built) result = linuxCommand(output).run()
        if (result == 0) {
            linuxPrintStandardOutput("PASS $source\n")
        } else {
            failed = failed + 1
            linuxPrintStandardOutput(
                if (built) "FAIL $source (exit $result)\n"
                else "FAIL $source (build)\n"
            )
        }
        index = index + 1
    }
    linuxPrintStandardOutput(
        "${sources.size - failed} passed, $failed failed\n"
    )
    if (failed == 0) 0 else 1
}

// Debug information for `build`: "on" (-g / --debug), "off" (--no-debug) or
// "" for the default, which ABLA_DEBUG=1/0 overrides: on for development
// (--fast) builds, off for release builds.
var bootstrapOrcDebugRequest: string = ""

fun bootstrapOrcDebugInfo(fast: bool): bool {
    var request = bootstrapOrcDebugRequest
    if (request == "") {
        val configured = linuxEnvironment("ABLA_DEBUG")
        if (configured.found && configured.value == "1") request = "on"
        if (configured.found && configured.value == "0") request = "off"
    }
    if (request == "on") true else if (request == "off") false else fast
}

fun bootstrapOrcBuildSingle(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string
): int {
    bootstrapLlvmDebugInfo = bootstrapOrcDebugInfo(fast)
    bootstrapLlvmDebugOptimized = !fast
    bootstrapLlvmDebugEntry = sourcePath
    val status = bootstrapOrcBuildSingleWith(
        sourcePath, outputPath, fast, useCache, target, artifact
    )
    bootstrapLlvmDebugInfo = false
    bootstrapLlvmDebugOptimized = false
    status
}

fun bootstrapOrcBuildSingleWith(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string
): int {
    var status = 1
    if (fast && bootstrapTargetIsHost(target)) {
        status = bootstrapNativeArtifactBuildWithEmitter(
            sourcePath,
            outputPath,
            llvmAotEmitObjectFileFast,
            "inprocess-fast",
            useCache,
            target,
            artifact
        ).status
    }
    if (!fast && bootstrapOrcBalanced && bootstrapTargetIsHost(target)) {
        status = bootstrapNativeArtifactBuildWithEmitter(
            sourcePath,
            outputPath,
            llvmAotEmitObjectFileBalanced,
            "inprocess-o1",
            useCache,
            target,
            artifact
        ).status
    }
    if (!fast && !bootstrapOrcBalanced && bootstrapTargetIsHost(target)) {
        status = bootstrapNativeArtifactBuildWithEmitter(
            sourcePath,
            outputPath,
            llvmAotEmitObjectFile,
            "inprocess-o2",
            useCache,
            target,
            artifact
        ).status
    }
    if (!bootstrapTargetIsHost(target)) {
        val targetTriple = target.llvmTriple
        val targetFast = fast
        val targetEmitter: (string, string) -> int = {
            input: string,
            output: string ->
            bootstrapExternalEmitObjectForTarget(
                input,
                output,
                targetTriple,
                targetFast
            )
        }
        status = bootstrapNativeArtifactBuildWithEmitter(
            sourcePath,
            outputPath,
            targetEmitter,
            if (fast) "cross-fast" else "cross-o2",
            useCache,
            target,
            artifact
        ).status
    }
    status
}

fun bootstrapAppendDefinedTargets(
    var targets: array<BootstrapDefinedTarget>,
    additions: array<BootstrapDefinedTarget>
): int {
    var status = 0
    var addition = 0
    while (status == 0 && addition < additions.size) {
        val candidate = additions[addition]
        val descriptor = bootstrapDefinedTargetDescriptor(candidate)
        var duplicate = bootstrapTargetDescriptor(candidate.name).valid
        var previous = 0
        while (!duplicate && previous < targets.size) {
            if (targets[previous].name == candidate.name) duplicate = true
            previous = previous + 1
        }
        if (!descriptor.valid) {
            linuxPrintStandardError(
                "error[E_BUILD_TARGET_DEFINITION]: target '${candidate.name}' requested an unsupported object format or linker flavor\n"
            )
            status = 148
        }
        if (status == 0 && duplicate) {
            linuxPrintStandardError(
                "error[E_BUILD_TARGET_DEFINITION]: duplicate target '${candidate.name}'\n"
            )
            status = 146
        }
        if (status == 0 && targets.size >= 32) {
            linuxPrintStandardError(
                "error[E_BUILD_GRAPH_LIMIT]: programmable build exceeds 32 target descriptions\n"
            )
            status = 150
        }
        if (status == 0) targets.append(candidate)
        addition = addition + 1
    }
    status
}

fun bootstrapRecordNativeOutputSet(output: string): bool {
    var recorded = bootstrapRecordBuildTransactionPath(output)
    if (recorded) recorded = bootstrapRecordBuildTransactionPath(
        "$output.abi.json"
    )
    if (recorded) recorded = bootstrapRecordBuildTransactionPath("$output.ll")
    if (recorded) recorded = bootstrapRecordBuildTransactionPath("$output.o")
    if (recorded) recorded = bootstrapRecordBuildTransactionPath(
        "$output.host.o"
    )
    if (recorded) recorded = bootstrapRecordBuildTransactionPath(
        "$output.raw-runtime.o"
    )
    if (recorded) recorded = bootstrapRecordBuildTransactionPath(
        "$output.o.bc"
    )
    recorded
}

fun bootstrapArtifactSliceSourcePath(sourcePath: string): string {
    var result = sourcePath
    if (sourcePath.size > 0 && sourcePath[0] != 47) {
        result = currentDirectory().child(sourcePath).text
    }
    result
}

fun bootstrapAppendArtifactSlices(
    var queued: array<BootstrapCompileProgramRequest>,
    roots: array<BootstrapArtifactRootRequest>,
    sourcePath: string,
    var sliceEntries: array<string>
): int {
    var status = 0
    val emitted: array<string> = []
    val importedSource = bootstrapArtifactSliceSourcePath(sourcePath)
    var safeSource = importedSource.size > 0
    var sourceByte = 0
    while (safeSource && sourceByte < importedSource.size) {
        if (importedSource[sourceByte] == 10 ||
            importedSource[sourceByte] == 13 ||
            importedSource[sourceByte] == 34 ||
            importedSource[sourceByte] == 92) safeSource = false
        sourceByte = sourceByte + 1
    }
    if (!safeSource && roots.size > 0) {
        linuxPrintStandardError(
            "error[E_ARTIFACT_ROOT_SOURCE]: source path cannot be represented safely in a generated artifact entry\n"
        )
        status = 158
    }
    var root = 0
    while (status == 0 && root < roots.size) {
        val request = roots[root]
        var alreadyEmitted = false
        var emittedIndex = 0
        while (emittedIndex < emitted.size) {
            if (emitted[emittedIndex] == request.name) {
                alreadyEmitted = true
            }
            emittedIndex = emittedIndex + 1
        }
        if (!alreadyEmitted) {
            var source = "import \"$importedSource\"\nimport \"abla/compiler\"\ncompile fun __abla_export_slice(): void {\n"
            var contribution = 0
            val contributionKeys: array<string> = []
            while (contribution < roots.size) {
                val selected = roots[contribution]
                if (selected.name == request.name) {
                    var duplicateContribution = false
                    val contributionKey = "${selected.functionName}:${selected.exportName}"
                    var keyIndex = 0
                    while (!duplicateContribution &&
                           keyIndex < contributionKeys.size) {
                        if (contributionKeys[keyIndex] == contributionKey) {
                            duplicateContribution = true
                        }
                        keyIndex = keyIndex + 1
                    }
                    if (!duplicateContribution) {
                        source = "${source}    val __abla_slice_handle_${contribution} = compiler.findFunction(\"${selected.functionName}\")\n"
                        source = "${source}    compiler.exportFunction(__abla_slice_handle_${contribution}, \"${selected.exportName}\")\n"
                        contributionKeys.append(contributionKey)
                    }
                }
                contribution = contribution + 1
            }
            source = "${source}    return\n}\n#compiler.transform(__abla_export_slice)\n"
            val entry = "${request.output}.abla-slice.ab"
            var valid = Path(entry).parent().createDirectories()
            if (valid) valid = bootstrapRecordBuildTransactionPath(entry)
            if (valid) valid = Path(entry).writeTextAtomic(source)
            if (!valid) {
                linuxPrintStandardError(
                    "error[E_ARTIFACT_ROOT_ENTRY]: cannot stage generated entry for artifact '${request.name}'\n"
                )
                status = 159
            } else {
                emitted.append(request.name)
                sliceEntries.append(entry)
                queued.append(BootstrapCompileProgramRequest(
                    request.name,
                    entry,
                    request.output,
                    request.target,
                    request.artifact,
                    request.fast,
                    request.cache
                ))
            }
        }
        root = root + 1
    }
    status
}

// Compile one root normally, then drain any program nodes registered by its
// compile-time build definition. Child compilations may register more nodes;
// the bounded queue makes that recursion explicit and cycle diagnosable.
fun bootstrapOrcBuild(
    sourcePath: string,
    outputPath: string,
    fast: bool,
    useCache: bool,
    target: BootstrapTargetDescriptor,
    artifact: string
): int {
    bootstrapIndependentModules = []
    bootstrapTakeCompileProgramRequests()
    bootstrapTakeDefinedTargets()
    bootstrapTakeArtifactRootRequests()
    bootstrapBeginBuildTransaction()
    var status = 0
    if (!bootstrapRecordNativeOutputSet(outputPath)) {
        linuxPrintStandardError(
            "error[E_BUILD_GRAPH_TRANSACTION]: cannot journal root build outputs within bounded transaction limits\n"
        )
        status = 156
    }
    if (status == 0) status = bootstrapOrcBuildSingle(
            sourcePath,
            outputPath,
            fast,
            useCache,
            target,
            artifact
        )
    val queued = bootstrapTakeCompileProgramRequests()
    val artifactRoots = bootstrapTakeArtifactRootRequests()
    val sliceEntries: array<string> = []
    if (status == 0) status = bootstrapAppendArtifactSlices(
        queued,
        artifactRoots,
        sourcePath,
        sliceEntries
    )
    val targets: array<BootstrapDefinedTarget> = []
    val rootTargets = bootstrapTakeDefinedTargets()
    if (status == 0) {
        status = bootstrapAppendDefinedTargets(targets, rootTargets)
    }
    val names: array<string> = []
    val outputs: array<string> = []
    var cursor = 0
    while (status == 0 && cursor < queued.size && cursor < 64) {
        val request = queued[cursor]
        var unique = true
        var previous = 0
        while (previous < names.size) {
            if (names[previous] == request.name ||
                outputs[previous] == request.output) unique = false
            previous = previous + 1
        }
        val requestedTargetName = if (request.target == "host") {
            bootstrapHostTargetName()
        } else request.target
        var requestedTarget = bootstrapTargetDescriptor(requestedTargetName)
        var definedTarget = 0
        while (!requestedTarget.valid && definedTarget < targets.size) {
            if (targets[definedTarget].name == request.target) {
                requestedTarget = bootstrapDefinedTargetDescriptor(
                    targets[definedTarget]
                )
            }
            definedTarget = definedTarget + 1
        }
        if (!unique) {
            linuxPrintStandardError(
                "error[E_BUILD_GRAPH_DUPLICATE]: duplicate program name or output for '${request.name}'\n"
            )
            status = 146
        }
        if (status == 0 && request.artifact != "executable" &&
            request.artifact != "object" &&
            request.artifact != "static-library" &&
            request.artifact != "shared-library" &&
            request.artifact != "module") {
            linuxPrintStandardError(
                "error[E_BUILD_ARTIFACT_UNSUPPORTED]: program '${request.name}' requested unsupported artifact '${request.artifact}'; supported artifacts: executable, object, static-library, shared-library, module\n"
            )
            status = 147
        }
        if (status == 0 && !requestedTarget.valid) {
            linuxPrintStandardError(
                "error[E_BUILD_TARGET_UNSUPPORTED]: program '${request.name}' requested target '${request.target}', which is neither built in nor defined by this build graph\n"
            )
            status = 148
        }
        if (status == 0 && !Path(request.output).parent().createDirectories()) {
            linuxPrintStandardError(
                "error[E_BUILD_OUTPUT]: cannot create output directory for program '${request.name}'\n"
            )
            status = 149
        }
        if (status == 0 && !bootstrapRecordNativeOutputSet(request.output)) {
            linuxPrintStandardError(
                "error[E_BUILD_GRAPH_TRANSACTION]: cannot journal outputs for program '${request.name}' within bounded transaction limits\n"
            )
            status = 156
        }
        if (status == 0) {
            names.append(request.name)
            outputs.append(request.output)
            var slice = false
            var sliceEntry = 0
            while (sliceEntry < sliceEntries.size) {
                if (sliceEntries[sliceEntry] == request.entry) slice = true
                sliceEntry = sliceEntry + 1
            }
            bootstrapArtifactSliceActive = slice ||
                bootstrapIndependentEntryIdentity(request.entry)
            status = bootstrapOrcBuildSingle(
                request.entry,
                request.output,
                request.fast,
                request.cache,
                requestedTarget,
                request.artifact
            )
            bootstrapArtifactSliceActive = false
            val recursiveArtifactRoots = bootstrapTakeArtifactRootRequests()
            if (status == 0 && recursiveArtifactRoots.size > 0) {
                linuxPrintStandardError(
                    "error[E_ARTIFACT_ROOT_RECURSION]: child program contributed artifact roots outside a generated slice\n"
                )
                status = 160
            }
            val nested = bootstrapTakeCompileProgramRequests()
            val nestedTargets = bootstrapTakeDefinedTargets()
            if (status == 0) {
                status = bootstrapAppendDefinedTargets(
                    targets,
                    nestedTargets
                )
            }
            var nestedIndex = 0
            while (nestedIndex < nested.size && queued.size < 64) {
                queued.append(nested[nestedIndex])
                nestedIndex = nestedIndex + 1
            }
            if (nestedIndex < nested.size) {
                linuxPrintStandardError(
                    "error[E_BUILD_GRAPH_LIMIT]: programmable build exceeds 64 program nodes\n"
                )
                status = 150
            }
        }
        cursor = cursor + 1
    }
    if (status == 0 && cursor < queued.size) {
        linuxPrintStandardError(
            "error[E_BUILD_GRAPH_LIMIT]: programmable build exceeds 64 program nodes\n"
        )
        status = 150
    }
    if (status == 0) {
        bootstrapCommitBuildTransaction()
    } else if (!bootstrapRollbackBuildTransaction()) {
        linuxPrintStandardError(
            "error[E_BUILD_GRAPH_ROLLBACK]: failed to restore one or more outputs after graph failure\n"
        )
        status = 157
    }
    status
}

fun bootstrapReplDeclaration(line: string): bool {
    var declaration = line.size >= 4 && line.slice(0, 4) == "fun "
    if (line.size >= 6 && line.slice(0, 6) == "class ") declaration = true
    if (line.size >= 10 && line.slice(0, 10) == "interface ") {
        declaration = true
    }
    if (line.size >= 15 && line.slice(0, 15) == "resource class ") {
        declaration = true
    }
    if (line.size >= 4 && line.slice(0, 4) == "val ") declaration = true
    if (line.size >= 4 && line.slice(0, 4) == "var ") declaration = true
    declaration
}

// One REPL line compiled by a child compiler (`--emit-llvm`): its LLVM IR,
// or a failed status once the child has printed the line's diagnostics. The
// compiler keeps tables in module values from one compilation to the next, so
// neither a region nor the collector can give a line's memory back; the
// child's goes back to the system when it exits.
fun bootstrapReplCompile(sourcePath: string): LinuxProcessResult {
    val child = linuxCommand("/proc/self/exe")
    child.argument("--emit-llvm")
    child.argument(sourcePath)
    child.capture()
}

// Persistent language REPL. Definitions are retained as source and included
// in later expression generations. Publication is transactional: a malformed
// definition is diagnosed without changing the accepted declaration set.
// Machine code remains a reclaimable ORC generation in one LLJIT session.
// Each line compiles in a child compiler (bootstrapReplCompile).
fun bootstrapRepl(): int {
    val session = llvmOrcCreateSession()
    val standardInput = linuxStandardInput()
    val sourcePath = "build/.abla-repl-source.ab"
    var declarations = ""
    var status = session.status
    var running = status == 0
    while (running) {
        linuxPrintStandardOutput("abla> ")
        val inputLine = standardInput.readLine()
        val line = inputLine.text
        if (!inputLine.available || line == ":quit") {
            running = false
        } else if (line == ":reset") {
            declarations = ""
            linuxPrintStandardOutput("reset\n")
        } else if (line != "" && bootstrapReplDeclaration(line)) {
            val source = "$declarations$line\nfun main: int = 0\n"
            if (!Path(sourcePath).writeTextAtomic(source)) {
                status = 141
                running = false
            } else {
                if (bootstrapReplCompile(sourcePath).status == 0) {
                    declarations = "$declarations$line\n"
                    linuxPrintStandardOutput("defined\n")
                }
            }
        } else if (line != "") {
            val source = "$declarations\nfun main: int = $line\n"
            if (!Path(sourcePath).writeTextAtomic(source)) {
                status = 141
                running = false
            } else {
                val compilation = bootstrapReplCompile(sourcePath)
                if (compilation.status == 0) {
                    val llvmPath = "build/.abla-repl.ll"
                    if (!Path(llvmPath).writeTextAtomic(
                        compilation.output
                    )) {
                        status = 141
                        running = false
                    } else {
                        val generation = session.addFile(llvmPath)
                        if (generation.status != 0) {
                            status = generation.status
                            running = false
                        } else {
                            val lookup = session.lookup("main")
                            if (lookup.status != 0) {
                                status = lookup.status
                                running = false
                            } else {
                                val value = callNativeMain(lookup.address)
                                linuxPrintStandardOutput("$value\n")
                            }
                            val removeStatus = generation.remove()
                            if (status == 0 && removeStatus != 0) {
                                status = removeStatus
                                running = false
                            }
                        }
                    }
                }
            }
        }
    }
    val closeStatus = session.close()
    if (status == 0 && closeStatus != 0) status = closeStatus
    status
}

fun bootstrapOrcUsage(): int {
    linuxPrintStandardError(
        "usage: ablac build [<file.ab> | --project <dir>] [-o output] [--emit executable|object|static-library|shared-library] [--fast | --o1] [-g | --debug | --no-debug] [--no-cache] [--sidecar | --no-sidecar] [--offline] [--strict-imports] [--visibility-report <file>] [--target <name> | --target-triple <triple> --object-format <elf|macho|coff|wasm>]\n       targets: ${bootstrapSupportedTargets()}\n       ablac package update [--project <dir>]\n       ablac package vendor [--project <dir>] [--offline]\n       ablac test <file.ab>... [--o1] [--no-cache]  # build and run test programs (abla/test)\n       ablac run [--o1 | --fast] [--built | --release] [<file.ab> | --project <dir>] [--offline] [-- <program arguments>] # in-process LLVM ORC (--built: cached build, exec'd)\n       ablac repl                                # persistent definitions + expressions\n       ablac serve [<file.ab> | --project <dir>] # watched fast-build service\n       ablac analyze --stdio                     # persistent JSON-lines analysis service\n       ablac --emit-llvm <file.ab>\n"
    )
    2
}

// The frontend and the compile-time evaluator hold about 30 KB of stack per
// level of nesting: an expression a few hundred levels deep fits the default
// 8 MB stack, but a large program's deepest paths (a game server's economy
// test) may not. Run with the launcher's stack instead: raise the
// soft limit to 128 MB (or the hard limit, if lower) and start over, so a
// direct `ablac.bin` call behaves as one through build/ablac.
fun bootstrapEnsureCompilerStack(): void {
    val wanted = 134217728
    val limits = linuxStackLimits()
    if (limits.size == 2 && limits[0] >= 0) {
        val target = if (limits[1] >= 0 && limits[1] < wanted) limits[1]
            else wanted
        if (limits[0] < target &&
            linuxSetStackLimits(target, limits[1])) {
            // Start over only once the new limit reads back (no exec loop).
            val raised = linuxStackLimits()
            if (raised.size == 2 && raised[0] >= target) linuxReexecute()
        }
    }
    return
}

fun main: int {
    bootstrapEnsureCompilerStack()
    // The compiler collects each time its heap grows by a fixed step: a step large enough
    // that collecting costs little, small enough that a large build's peak stays a
    // fraction of what it allocates. Under its launcher's budget (which the launcher
    // always sets) the same step, the budget being a hard cap besides: the runtime's own
    // 64 MiB step had a large build collect every 150 ms while its heap was small.
    val trackedMemoryLimit = bootstrapCompilerTrackedMemoryLimit()
    val collectionGrowth = bootstrapCompilerCollectionGrowth()
    if (trackedMemoryLimit > 0) runtimeMemorySetLimit(trackedMemoryLimit)
    if (collectionGrowth > 0) runtimeMemorySetCollectionGrowth(collectionGrowth)
    else if (trackedMemoryLimit == 0) runtimeMemorySetManualCollection()
    // What a collection finds unreachable (millions of blocks in a large build) is
    // freed by the runtime's helper thread while compiling goes on.
    runtimeMemorySetBackgroundFree(true)
    val argumentCount = linuxArgumentCount()
    var argument0 = ""
    var argument1 = ""
    if (argumentCount > 0) argument0 = linuxArgument(0)
    if (argumentCount > 1) argument1 = linuxArgument(1)
    var status = 2
    if (argumentCount == 1 && argument0 == "--version") {
        linuxPrintStandardOutput("ablac ${ABLA_COMPILER_VERSION}\n")
        status = 0
    }
    if (argumentCount == 1 && argument0 == "repl") {
        status = bootstrapRepl()
    }
    if (argumentCount == 2 && argument0 == "analyze" &&
        argument1 == "--stdio") {
        status = bootstrapAnalysisService()
    }
    if (argumentCount == 2 && argument0 == "--emit-llvm") {
        status = if (bootstrapSourceFound(argument1)) bootstrapOrcEmit(argument1) else 1
    }
    if (argumentCount == 3 && argument0 == "--aot-object") {
        status = llvmAotEmitObjectFile(
            argument1,
            linuxArgument(2)
        )
    }
    if (argumentCount >= 2 && argument0 == "package") {
        val operation = argument1
        var projectRoot = "."
        var offline = false
        var valid = operation == "update" || operation == "vendor"
        var option = 2
        while (option < argumentCount) {
            val value = linuxArgument(option)
            if (value == "--project" && option + 1 < argumentCount) {
                projectRoot = linuxArgument(option + 1)
                option = option + 1
            } else if (value == "--offline" && operation == "vendor") {
                offline = true
                0
            } else {
                valid = false
                0
            }
            option = option + 1
        }
        val project = bootstrapProjectDescriptor(projectRoot)
        if (!project.valid) {
            linuxPrintStandardError("${project.diagnostic}\n")
            valid = false
        }
        if (valid) {
            val resolveEffects = bootstrapPackageAuthorizedEffects(
                projectRoot
            )
            val imported = bootstrapDiscoverImportProviders(
                project.entry, operation == "update", resolveEffects
            )
            var result = BootstrapPackageResult(1, imported.diagnostic)
            if (imported.errors == 0 && operation == "update") {
                result = bootstrapPackageUpdateWithDependencies(
                    projectRoot, imported
                )
            }
            if (imported.errors == 0 && operation == "vendor") {
                result = bootstrapPackageVendorWithDependencies(
                    projectRoot, imported, offline
                )
            }
            if (result.diagnostic != "") {
                linuxPrintStandardError(result.diagnostic)
            }
            status = result.status
        }
    }
    if (argumentCount >= 1 && argument0 == "build") {
        var sourcePath = ""
        var outputPath = "build/abla-out"
        var outputExplicit = false
        var fast = false
        var useCache = true
        var offline = false
        var targetName = bootstrapHostTargetName()
        var namedTarget = ""
        var targetTriple = ""
        var targetObjectFormat = ""
        var artifact = "default"
        var valid = true
        var option = 1
        var projectRoot = ""
        if (argumentCount > 1) {
            val possibleSource = linuxArgument(1)
            if (possibleSource != "--project" &&
                possibleSource.size > 0 && possibleSource[0] != 45) {
                sourcePath = possibleSource
                option = 2
            }
        }
        while (option < argumentCount) {
            val value = linuxArgument(option)
            if (value == "--fast") {
                fast = true
                0
            } else if (value == "--o1") {
                bootstrapOrcBalanced = true
                0
            } else if (value == "--no-cache") {
                useCache = false
                0
            } else if (value == "-g" || value == "--debug") {
                bootstrapOrcDebugRequest = "on"
                0
            } else if (value == "--no-debug") {
                bootstrapOrcDebugRequest = "off"
                0
            } else if (value == "--sidecar") {
                bootstrapNativeSidecarRequest = 1
                0
            } else if (value == "--no-sidecar") {
                bootstrapNativeSidecarRequest = 0
                0
            } else if (value == "--strict-imports") {
                // Modules whose package doesn't set `visibility` see only their imports.
                bootstrapStrictImportsRequested = true
                0
            } else if (value == "--visibility-report" && option + 1 < argumentCount) {
                // Written by the front end, which a cached build skips.
                bootstrapVisibilityReportPath = linuxArgument(option + 1)
                useCache = false
                option = option + 1
                0
            } else if (value == "--offline") {
                offline = true
                0
            } else if (value == "--target" &&
                option + 1 < argumentCount) {
                targetName = linuxArgument(option + 1)
                namedTarget = targetName
                option = option + 1
                0
            } else if (value == "--target-triple" &&
                option + 1 < argumentCount) {
                targetTriple = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "--object-format" &&
                option + 1 < argumentCount) {
                targetObjectFormat = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "--emit" &&
                option + 1 < argumentCount) {
                artifact = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "--project" &&
                option + 1 < argumentCount && sourcePath == "") {
                projectRoot = linuxArgument(option + 1)
                option = option + 1
                0
            } else if (value == "-o" && option + 1 < argumentCount) {
                outputPath = linuxArgument(option + 1)
                outputExplicit = true
                option = option + 1
                0
            } else {
                valid = false
                0
            }
            option = option + 1
        }
        if (valid && sourcePath == "") {
            if (projectRoot == "") projectRoot = "."
            val project = bootstrapProjectDescriptor(projectRoot)
            if (project.valid) {
                sourcePath = project.entry
                if (!outputExplicit) outputPath = project.output
                val imported = bootstrapDiscoverImportProviders(project.entry)
                if (imported.errors != 0) {
                    linuxPrintStandardError(imported.diagnostic)
                    valid = false
                }
                if (valid) {
                    val prepared = bootstrapPackagePrepareWithDependencies(
                        projectRoot, imported, offline
                    )
                    if (prepared.status != 0) {
                        linuxPrintStandardError(prepared.diagnostic)
                        valid = false
                    }
                }
            } else {
                linuxPrintStandardError("${project.diagnostic}\n")
                valid = false
            }
        }
        val rawTarget = targetTriple != "" || targetObjectFormat != ""
        if (artifact == "default") {
            artifact = if (rawTarget) "object" else "executable"
        }
        if (rawTarget && (namedTarget != "" || targetTriple == "" ||
            targetObjectFormat == "" ||
            (artifact != "object" && artifact != "static-library"))) {
            linuxPrintStandardError(
                "a raw target requires --target-triple and --object-format, cannot be combined with --target, and emits only object or static-library artifacts\n"
            )
            valid = false
        }
        val target = if (rawTarget) bootstrapRawObjectTargetDescriptor(
            targetTriple, targetObjectFormat
        ) else bootstrapTargetDescriptor(targetName)
        if (!target.valid) {
            linuxPrintStandardError(
                if (rawTarget)
                    "unsupported raw target '$targetTriple' with object format '$targetObjectFormat'\n"
                else "unsupported target '$targetName'; supported targets: ${bootstrapSupportedTargets()}\n"
            )
            valid = false
        }
        if (valid && !bootstrapSourceFound(sourcePath)) {
            valid = false
            status = 1
        }
        if (valid) {
            status = bootstrapOrcBuild(
                sourcePath,
                outputPath,
                fast,
                useCache,
                target,
                artifact
            )
        }
    }
    if (argumentCount >= 1 && argument0 == "test") {
        status = bootstrapOrcTest(argumentCount)
    }
    if (argumentCount >= 1 && argument0 == "run") {
        var runSource = ""
        var runValid = true
        var runProject = ""
        var runOffline = false
        // `ablac run [--o1|--fast|--release|--jit|--built] <file> -- a b …`:
        // everything after `--` is the program's own arguments
        // (processArgument(0…)); the run options come before it. The program is
        // compiled in process with the --o1 IR pipeline (--fast: the fast one)
        // and called there (bootstrapRunInProcess; --jit names that default).
        // --built builds it through the build cache and execs it
        // (bootstrapRunBuilt), as --release always does.
        var runCount = argumentCount
        val runArguments: array<string> = []
        var scan = 1
        while (scan < argumentCount && runCount == argumentCount) {
            if (linuxArgument(scan) == "--") runCount = scan
            scan = scan + 1
        }
        scan = runCount + 1
        while (scan < argumentCount) {
            runArguments.append(linuxArgument(scan))
            scan = scan + 1
        }
        var runProfile = "o1"
        var runBuilt = false
        val runOptions: array<string> = []
        scan = 1
        while (scan < runCount) {
            val option = linuxArgument(scan)
            if (option == "--o1") runProfile = "o1"
            else if (option == "--fast") runProfile = "fast"
            else if (option == "--release") {
                runProfile = "release"
                runBuilt = true
            } else if (option == "--built") runBuilt = true
            else if (option == "--jit") runBuilt = false
            else runOptions.append(option)
            scan = scan + 1
        }
        if (runOptions.size == 1) runSource = runOptions[0]
        if (runOptions.size == 0) {
            val project = bootstrapProjectDescriptor(".")
            runValid = project.valid
            runSource = project.entry
            runProject = "."
            if (!runValid) linuxPrintStandardError("${project.diagnostic}\n")
        }
        if (runOptions.size == 2 && runOptions[0] == "--project") {
            val project = bootstrapProjectDescriptor(runOptions[1])
            runValid = project.valid
            runSource = project.entry
            runProject = runOptions[1]
            if (!runValid) linuxPrintStandardError("${project.diagnostic}\n")
        }
        if (runOptions.size == 3 && runOptions[0] == "--project" &&
            runOptions[2] == "--offline") {
            val project = bootstrapProjectDescriptor(runOptions[1])
            runValid = project.valid
            runSource = project.entry
            runProject = runOptions[1]
            runOffline = true
            if (!runValid) linuxPrintStandardError("${project.diagnostic}\n")
        }
        if (runOptions.size > 3 || runSource == "") runValid = false
        if (runValid && !bootstrapSourceFound(runSource)) {
            runValid = false
            status = 1
        }
        if (runValid && runProject != "") {
            val imported = bootstrapDiscoverImportProviders(runSource)
            if (imported.errors != 0) {
                linuxPrintStandardError(imported.diagnostic)
                runValid = false
            }
            if (runValid) {
                val prepared = bootstrapPackagePrepareWithDependencies(
                    runProject, imported, runOffline
                )
                if (prepared.status != 0) {
                    linuxPrintStandardError(prepared.diagnostic)
                    runValid = false
                }
            }
        }
        if (runValid && !runBuilt) {
            status = bootstrapRunInProcess(
                runSource, runArguments,
                if (runProfile == "fast") llvmPassesFast() else llvmPassesBalanced()
            )
        } else if (runValid) {
            status = bootstrapRunBuilt(runSource, runArguments, runProfile)
        }
    }
    if (argumentCount >= 1 && argument0 == "serve") {
        var serveSource = ""
        var serveValid = true
        if (argumentCount == 2) serveSource = argument1
        if (argumentCount == 1) {
            val project = bootstrapProjectDescriptor(".")
            serveValid = project.valid
            serveSource = project.entry
            if (!serveValid) {
                linuxPrintStandardError("${project.diagnostic}\n")
            }
        }
        if (argumentCount == 3 && argument1 == "--project") {
            val project = bootstrapProjectDescriptor(linuxArgument(2))
            serveValid = project.valid
            serveSource = project.entry
            if (!serveValid) {
                linuxPrintStandardError("${project.diagnostic}\n")
            }
        }
        if (argumentCount > 3 || serveSource == "") serveValid = false
        if (serveValid) {
            status = bootstrapServeWithEmitter(
                serveSource,
                llvmAotEmitObjectFileFast,
                "inprocess-fast"
            )
        }
    }
    if (status == 2) status = bootstrapOrcUsage()
    status
}
