import "sema.ab"
import "abla/sys/linux/io"
import "abla/sys/linux/fs"
import "abla/sys/linux/process"
import "abla/sys/linux/net"
import "abla/text"
import "abla/bits"
import "abla/bytes"
import "abla/float"
import "abla/float/text"
import "abla/math"

// Parser handlers, finalizers, and ordinary staged expressions use separate
// evaluator objects. Keep their transaction in a private per-process staging
// directory; only scalar counters are global, so scoped-region safety remains
// independent from compile-driver bookkeeping.
var bootstrapCompileOutputCount: int = 0
var bootstrapCompileOutputBytes: int = 0
// Compile-time globals kept between evaluations (bootstrapCompileGlobalsKeep): how many
// the per-process journal holds.
var bootstrapCompileGlobalCount: int = 0
var bootstrapBuildTransactionActive: bool = false
// Lowering errors already explained by a staged driver diagnostic (a failed
// compile-time evaluation or lift): the driver neither emits nor reports
// them again as IR failures.
var bootstrapDiagnosedLoweringErrors: int = 0
var bootstrapBuildTransactionCount: int = 0

class BootstrapCompileProgramRequest(
    val name: string,
    val entry: string,
    val output: string,
    val target: string,
    val artifact: string,
    val fast: bool,
    val cache: bool
)

class BootstrapFunctionBodyReplacement(
    val handle: int,
    val body: string
)

class BootstrapFunctionAnnotationAddition(
    val handle: int,
    val annotation: string
)

class BootstrapIndependentModuleState(
    val name: string,
    val functionNames: array<string>,
    val sourceIdentities: array<string>,
    val functionAnnotations: array<array<string>>,
    val declarationSources: array<string>,
    val declarationSourceIdentities: array<string>,
    val generatedDeclarationSources: array<string>,
    val exportSourceNames: array<string>,
    val exportNames: array<string>,
    val checkedExports: array<bool>,
    var emitted: bool
)

class BootstrapArtifactRootRequest(
    val name: string,
    val target: string,
    val artifact: string,
    val output: string,
    val functionName: string,
    val exportName: string,
    val fast: bool,
    val cache: bool
)

class BootstrapExportRequest(
    val source: string,
    val name: string,
    val resultType: string,
    val parameterNames: array<string>,
    val parameterTypes: array<string>,
    val checked: bool,
    val internal: bool,
    // Backend lowering can introduce calls after source reachability closes.
    // Required definitions stay local, but must still be materialized.
    val required: bool
)

class BootstrapDefinedTarget(
    val name: string,
    val llvmTriple: string,
    val objectFormat: string,
    val linkerFlavor: string,
    val linkerEmulation: string,
    val hosted: bool,
    val libcFree: bool
)

var bootstrapCompileProgramRequestCount: int = 0
var bootstrapDriverDiagnosticCount: int = 0
var bootstrapExportRequestCount: int = 0
var bootstrapDefinedTargetCount: int = 0
var bootstrapFunctionBodyReplacementCount: int = 0
var bootstrapFunctionAnnotationAdditionCount: int = 0
var bootstrapCompilerTransformActive: bool = false
var bootstrapArtifactRootRequestCount: int = 0
var bootstrapArtifactSliceActive: bool = false
var bootstrapIndependentModules: array<BootstrapIndependentModuleState> = []
var bootstrapPendingFunctionAnnotationKeys: array<string> = []
var bootstrapPendingFunctionAnnotationNames: array<string> = []

fun bootstrapArtifactRootRequestRoot(): string =
    "build/.abla-artifact-root-requests-${linuxProcessId()}"

fun bootstrapStageArtifactRootRequest(
    request: BootstrapArtifactRootRequest
): bool {
    var valid = !bootstrapArtifactSliceActive &&
        bootstrapArtifactRootRequestCount < 64 &&
        bootstrapTargetTokenValid(request.name) &&
        bootstrapTargetTokenValid(request.target) &&
        bootstrapTargetTokenValid(request.artifact) &&
        bootstrapCompileOutputPathValid(request.output) &&
        bootstrapExportNameValid(request.exportName) &&
        request.functionName.size > 0 && request.functionName.size <= 128
    val root = bootstrapArtifactRootRequestRoot()
    var index = 0
    var duplicate = false
    while (valid && index < bootstrapArtifactRootRequestCount) {
        val sameArtifact = Path("$root/$index.name").readText() ==
            request.name
        val sameArtifactSettings = sameArtifact &&
            Path("$root/$index.target").readText() == request.target &&
            Path("$root/$index.artifact").readText() == request.artifact &&
            Path("$root/$index.output").readText() == request.output &&
            Path("$root/$index.fast").readText() ==
                (if (request.fast) "1" else "0") &&
            Path("$root/$index.cache").readText() ==
                (if (request.cache) "1" else "0")
        val existingFunction = Path("$root/$index.function").readText()
        val existingExport = Path("$root/$index.export").readText()
        if (sameArtifact && sameArtifactSettings &&
            existingFunction == request.functionName &&
            existingExport == request.exportName) {
            duplicate = true
            valid = false
        }
        if (sameArtifact && sameArtifactSettings && (
            existingFunction == request.functionName ||
            existingExport == request.exportName)) valid = false
        if (sameArtifact && !sameArtifactSettings) valid = false
        index = index + 1
    }
    if (duplicate) return true
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapArtifactRootRequestCount
    if (valid) valid = Path("$root/$requestIndex.name").writeTextAtomic(
        request.name
    )
    if (valid) valid = Path("$root/$requestIndex.target").writeTextAtomic(
        request.target
    )
    if (valid) valid = Path("$root/$requestIndex.artifact").writeTextAtomic(
        request.artifact
    )
    if (valid) valid = Path("$root/$requestIndex.output").writeTextAtomic(
        request.output
    )
    if (valid) valid = Path("$root/$requestIndex.function").writeTextAtomic(
        request.functionName
    )
    if (valid) valid = Path("$root/$requestIndex.export").writeTextAtomic(
        request.exportName
    )
    if (valid) valid = Path("$root/$requestIndex.fast").writeTextAtomic(
        if (request.fast) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.cache").writeTextAtomic(
        if (request.cache) "1" else "0"
    )
    if (valid) bootstrapArtifactRootRequestCount = requestIndex + 1
    if (!valid) {
        Path("$root/$requestIndex.name").remove()
        Path("$root/$requestIndex.target").remove()
        Path("$root/$requestIndex.artifact").remove()
        Path("$root/$requestIndex.output").remove()
        Path("$root/$requestIndex.function").remove()
        Path("$root/$requestIndex.export").remove()
        Path("$root/$requestIndex.fast").remove()
        Path("$root/$requestIndex.cache").remove()
    }
    valid
}

fun bootstrapTakeArtifactRootRequests(): array<BootstrapArtifactRootRequest> {
    val requests: array<BootstrapArtifactRootRequest> = []
    val root = bootstrapArtifactRootRequestRoot()
    var index = 0
    while (index < bootstrapArtifactRootRequestCount) {
        requests.append(BootstrapArtifactRootRequest(
            Path("$root/$index.name").readText(),
            Path("$root/$index.target").readText(),
            Path("$root/$index.artifact").readText(),
            Path("$root/$index.output").readText(),
            Path("$root/$index.function").readText(),
            Path("$root/$index.export").readText(),
            Path("$root/$index.fast").readText() == "1",
            Path("$root/$index.cache").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.target").remove()
        Path("$root/$index.artifact").remove()
        Path("$root/$index.output").remove()
        Path("$root/$index.function").remove()
        Path("$root/$index.export").remove()
        Path("$root/$index.fast").remove()
        Path("$root/$index.cache").remove()
        index = index + 1
    }
    bootstrapArtifactRootRequestCount = 0
    Path(root).remove()
    requests
}

fun bootstrapFunctionBodyReplacementRoot(): string =
    "build/.abla-function-body-replacements-${linuxProcessId()}"

fun bootstrapStageFunctionBodyReplacement(
    replacement: BootstrapFunctionBodyReplacement
): bool {
    var valid = bootstrapCompilerTransformActive &&
        replacement.handle >= 0 && replacement.body.size > 0 &&
        replacement.body.size <= 65536 &&
        bootstrapFunctionBodyReplacementCount < 32
    val root = bootstrapFunctionBodyReplacementRoot()
    var index = 0
    while (valid && index < bootstrapFunctionBodyReplacementCount) {
        if (Path("$root/$index.handle").readText() ==
            "${replacement.handle}") valid = false
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val request = bootstrapFunctionBodyReplacementCount
    if (valid) valid = Path("$root/$request.handle").writeTextAtomic(
        "${replacement.handle}"
    )
    if (valid) valid = Path("$root/$request.body").writeTextAtomic(
        replacement.body
    )
    if (valid) bootstrapFunctionBodyReplacementCount = request + 1
    if (!valid) {
        Path("$root/$request.handle").remove()
        Path("$root/$request.body").remove()
    }
    valid
}

fun bootstrapTakeFunctionBodyReplacements(
): array<BootstrapFunctionBodyReplacement> {
    val replacements: array<BootstrapFunctionBodyReplacement> = []
    val root = bootstrapFunctionBodyReplacementRoot()
    var index = 0
    while (index < bootstrapFunctionBodyReplacementCount) {
        replacements.append(BootstrapFunctionBodyReplacement(
            bootstrapDecimalIndex(Path("$root/$index.handle").readText()),
            Path("$root/$index.body").readText()
        ))
        Path("$root/$index.handle").remove()
        Path("$root/$index.body").remove()
        index = index + 1
    }
    bootstrapFunctionBodyReplacementCount = 0
    Path(root).remove()
    replacements
}

fun bootstrapFunctionAnnotationAdditionRoot(): string =
    "build/.abla-function-annotation-additions-${linuxProcessId()}"

fun bootstrapStageFunctionAnnotationAddition(
    addition: BootstrapFunctionAnnotationAddition
): bool {
    var valid = bootstrapCompilerTransformActive && addition.handle >= 0 &&
        bootstrapTargetTokenValid(addition.annotation) &&
        bootstrapFunctionAnnotationAdditionCount < 128
    val root = bootstrapFunctionAnnotationAdditionRoot()
    var index = 0
    while (valid && index < bootstrapFunctionAnnotationAdditionCount) {
        if (Path("$root/$index.handle").readText() == "${addition.handle}" &&
            Path("$root/$index.annotation").readText() ==
                addition.annotation) valid = false
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val request = bootstrapFunctionAnnotationAdditionCount
    if (valid) valid = Path("$root/$request.handle").writeTextAtomic(
        "${addition.handle}"
    )
    if (valid) valid = Path("$root/$request.annotation").writeTextAtomic(
        addition.annotation
    )
    if (valid) bootstrapFunctionAnnotationAdditionCount = request + 1
    if (!valid) {
        Path("$root/$request.handle").remove()
        Path("$root/$request.annotation").remove()
    }
    valid
}

fun bootstrapTakeFunctionAnnotationAdditions(
): array<BootstrapFunctionAnnotationAddition> {
    val additions: array<BootstrapFunctionAnnotationAddition> = []
    val root = bootstrapFunctionAnnotationAdditionRoot()
    var index = 0
    while (index < bootstrapFunctionAnnotationAdditionCount) {
        additions.append(BootstrapFunctionAnnotationAddition(
            bootstrapDecimalIndex(Path("$root/$index.handle").readText()),
            Path("$root/$index.annotation").readText()
        ))
        Path("$root/$index.handle").remove()
        Path("$root/$index.annotation").remove()
        index = index + 1
    }
    bootstrapFunctionAnnotationAdditionCount = 0
    Path(root).remove()
    additions
}

fun bootstrapDefinedTargetRoot(): string =
    "build/.abla-defined-targets-${linuxProcessId()}"

fun bootstrapTargetTokenValid(value: string): bool {
    var valid = value.size > 0 && value.size <= 128
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122)
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !digit && byte != 45 && byte != 46 && byte != 95) {
            valid = false
        }
        index = index + 1
    }
    valid
}

fun bootstrapIndependentModuleHandleValid(handle: int): bool =
    handle >= 0 && handle < bootstrapIndependentModules.size

fun bootstrapIndependentModuleSourceValid(source: string): bool {
    var valid = source.size > 0 && source.size <= 4096 && source[0] != 60
    var index = 0
    while (valid && index < source.size) {
        if (source[index] == 0 || source[index] == 10 ||
            source[index] == 13) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapIndependentModuleHasSource(
    sources: array<string>,
    source: string
): bool {
    var found = false
    var index = 0
    while (index < sources.size) {
        if (sources[index] == source) found = true
        index = index + 1
    }
    found
}

fun bootstrapIndependentModuleSourcePath(source: string): string {
    var result = source
    if (source.size > 0 && source[0] != 47) {
        result = currentDirectory().child(source).text
    }
    result
}

fun bootstrapIndependentDeclarationNameValid(name: string): bool {
    var valid = name.size > 0 && name.size <= 128
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !(index > 0 && digit)) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapStageDefinedTarget(target: BootstrapDefinedTarget): bool {
    var valid = bootstrapDefinedTargetCount < 16 &&
        bootstrapTargetTokenValid(target.name) &&
        bootstrapTargetTokenValid(target.llvmTriple) &&
        bootstrapTargetTokenValid(target.objectFormat) &&
        bootstrapTargetTokenValid(target.linkerFlavor) &&
        bootstrapTargetTokenValid(target.linkerEmulation) &&
        !(target.hosted && target.libcFree)
    val root = bootstrapDefinedTargetRoot()
    var index = 0
    while (valid && index < bootstrapDefinedTargetCount) {
        if (Path("$root/$index.name").readText() == target.name) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val targetIndex = bootstrapDefinedTargetCount
    if (valid) valid = Path("$root/$targetIndex.name").writeTextAtomic(
        target.name
    )
    if (valid) valid = Path("$root/$targetIndex.triple").writeTextAtomic(
        target.llvmTriple
    )
    if (valid) valid = Path("$root/$targetIndex.format").writeTextAtomic(
        target.objectFormat
    )
    if (valid) valid = Path("$root/$targetIndex.linker").writeTextAtomic(
        target.linkerFlavor
    )
    if (valid) valid = Path("$root/$targetIndex.emulation").writeTextAtomic(
        target.linkerEmulation
    )
    if (valid) valid = Path("$root/$targetIndex.hosted").writeTextAtomic(
        if (target.hosted) "1" else "0"
    )
    if (valid) valid = Path("$root/$targetIndex.libc-free").writeTextAtomic(
        if (target.libcFree) "1" else "0"
    )
    if (valid) bootstrapDefinedTargetCount = targetIndex + 1
    if (!valid) {
        Path("$root/$targetIndex.name").remove()
        Path("$root/$targetIndex.triple").remove()
        Path("$root/$targetIndex.format").remove()
        Path("$root/$targetIndex.linker").remove()
        Path("$root/$targetIndex.emulation").remove()
        Path("$root/$targetIndex.hosted").remove()
        Path("$root/$targetIndex.libc-free").remove()
    }
    valid
}

fun bootstrapTakeDefinedTargets(): array<BootstrapDefinedTarget> {
    val targets: array<BootstrapDefinedTarget> = []
    val root = bootstrapDefinedTargetRoot()
    var index = 0
    while (index < bootstrapDefinedTargetCount) {
        targets.append(BootstrapDefinedTarget(
            Path("$root/$index.name").readText(),
            Path("$root/$index.triple").readText(),
            Path("$root/$index.format").readText(),
            Path("$root/$index.linker").readText(),
            Path("$root/$index.emulation").readText(),
            Path("$root/$index.hosted").readText() == "1",
            Path("$root/$index.libc-free").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.triple").remove()
        Path("$root/$index.format").remove()
        Path("$root/$index.linker").remove()
        Path("$root/$index.emulation").remove()
        Path("$root/$index.hosted").remove()
        Path("$root/$index.libc-free").remove()
        index = index + 1
    }
    bootstrapDefinedTargetCount = 0
    Path(root).remove()
    targets
}

fun bootstrapExportRequestRoot(): string =
    "build/.abla-export-requests-${linuxProcessId()}"

fun bootstrapForeignSymbolNameAvailable(name: string): bool =
    name != "main" &&
    name != "abla_owned_bytes_data" &&
    name != "abla_owned_bytes_length" &&
    name != "abla_owned_bytes_release"

fun bootstrapExportNameValid(name: string): bool {
    // LLVM and native object formats permit long linker identifiers; C++
    // template mangling routinely exceeds 128 bytes. Keep input bounded for
    // compile-time evaluation without rejecting valid ABI names.
    var valid = name.size > 0 && name.size <= 4096 &&
        bootstrapForeignSymbolNameAvailable(name)
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !(index > 0 && digit)) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapLinkerSymbolNameValid(name: string): bool {
    // internalFunction names an object-format symbol, not a C declaration.
    // Accept the portable unquoted ELF/assembler spelling shared by LLVM and
    // GNU-family assemblers. In particular, compiler-created local helpers
    // conventionally contain `.` and `$`. Keep whitespace, quoting, version
    // suffixes, and assembler punctuation out so this remains data, never
    // injected syntax.
    var valid = name.size > 0 && name.size <= 4096 &&
        bootstrapForeignSymbolNameAvailable(name)
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95
        val digit = byte >= 48 && byte <= 57
        val linkerPunctuation = byte == 46 || byte == 36
        if (!alpha && !linkerPunctuation && !(index > 0 && digit)) {
            valid = false
        }
        index = index + 1
    }
    valid
}

fun bootstrapExportScalarTypeValid(type: string): bool =
    type == "bool" || type == "i8" || type == "u8" ||
    type == "char" || type == "i16" || type == "u16" ||
    type == "i32" || type == "u32" || type == "i64" || type == "u64" ||
    type == "f32" || type == "f64"

fun bootstrapExportResultTypeValid(type: string): bool =
    type == "void" || type == "string" ||
    bootstrapExportScalarTypeValid(type)

fun bootstrapExportParameterTypeValid(type: string): bool =
    type == "string" || type == "function:(i64)->i64" ||
    bootstrapExportScalarTypeValid(type)

fun bootstrapExportRuntimeType(
    declarations: array<BootstrapDeclaration>,
    type: string
): string {
    val normalized = bootstrapNormalizeType(type)
    val underlying = bootstrapScalarTypeUnderlying(
        declarations, normalized
    )
    if (underlying == "") normalized else underlying
}

fun bootstrapExportCallbackUseValidAt(
    expression: BootstrapExpression,
    name: string,
    nestedFunction: bool
): bool {
    var valid = true
    if (expression.text == name) {
        valid = expression.kind == "call" && !nestedFunction
    }
    val nested = nestedFunction || expression.kind == "lambda" ||
        expression.kind == "lambda.move"
    var child = 0
    while (valid && child < expression.children.size) {
        valid = bootstrapExportCallbackUseValidAt(
            expression.children[child],
            name,
            nested
        )
        child = child + 1
    }
    valid
}

// A callback borrowed from a foreign caller is valid only for the duration of
// the exported call. Restrict its source uses to immediate invocations in the
// exported function itself: it cannot be stored, returned, captured, or passed
// to another function that might retain it.
fun bootstrapExportCallbackUseValid(
    expression: BootstrapExpression,
    name: string
): bool = bootstrapExportCallbackUseValidAt(expression, name, false)

fun bootstrapStageAnnotatedExports(parsed: BootstrapParseResult): int {
    var errors = 0
    var declarationIndex = 0
    while (declarationIndex < parsed.declarations.size) {
        val declaration = parsed.declarations[declarationIndex]
        var annotation = 0
        while (annotation < declaration.annotations.size) {
            val annotationName = declaration.annotations[annotation]
            if (annotationName == "export" ||
                annotationName == "exportChecked") {
                val exportNames: array<string> = []
                var valid = annotation < declaration.annotationArguments.size
                if (valid) {
                    val argument = declaration.annotationArguments[annotation]
                    if (argument.kind == "string") {
                        exportNames.append(argument.text)
                    } else if (argument.kind == "array" &&
                               argument.children.size > 0) {
                        var exportArgument = 0
                        while (valid && exportArgument <
                               argument.children.size) {
                            val candidate =
                                argument.children[exportArgument]
                            valid = candidate.kind == "string"
                            if (valid) exportNames.append(candidate.text)
                            exportArgument = exportArgument + 1
                        }
                    } else valid = false
                }
                valid = valid && declaration.kind == "fun" &&
                    declaration.extensionOwner == "" &&
                    declaration.parameters.size <= 16 &&
                    exportNames.size > 0
                var exportNameIndex = 0
                while (valid && exportNameIndex < exportNames.size) {
                    valid = bootstrapExportNameValid(
                        exportNames[exportNameIndex]
                    )
                    exportNameIndex = exportNameIndex + 1
                }
                val resultType = bootstrapExportRuntimeType(
                    parsed.declarations, declaration.resultType
                )
                valid = valid && bootstrapExportResultTypeValid(resultType)
                val parameterNames: array<string> = []
                val parameterTypes: array<string> = []
                var parameter = 0
                while (valid && parameter < declaration.parameters.size) {
                    val parameterType = bootstrapExportRuntimeType(
                        parsed.declarations,
                        declaration.parameterTypes[parameter]
                    )
                    valid = declaration.parameterKinds[parameter] ==
                        "parameter" &&
                        bootstrapExportParameterTypeValid(parameterType)
                    if (valid &&
                        parameterType == "function:(i64)->i64") {
                        valid = bootstrapExportCallbackUseValid(
                            declaration.expression,
                            declaration.parameters[parameter]
                        )
                    }
                    if (valid) {
                        parameterNames.append(
                            declaration.parameters[parameter]
                        )
                        parameterTypes.append(parameterType)
                    }
                    parameter = parameter + 1
                }
                val exportRequestBegin = bootstrapExportRequestCount
                exportNameIndex = 0
                while (valid && exportNameIndex < exportNames.size) {
                    valid = bootstrapStageExportRequest(
                        BootstrapExportRequest(
                            declaration.name,
                            exportNames[exportNameIndex],
                            resultType,
                            parameterNames,
                            parameterTypes,
                            annotationName == "exportChecked",
                            false,
                            false
                        )
                    )
                    exportNameIndex = exportNameIndex + 1
                }
                if (!valid) {
                    bootstrapExportRequestCount = exportRequestBegin
                }
                if (!valid) {
                    errors = errors + 1
                    bootstrapStageDriverDiagnostic(
                        "error[E_EXPORT_ANNOTATION]: @${annotationName} on `${declaration.name}` requires unique non-reserved string name(s) and a supported top-level export signature\n"
                    )
                }
            }
            annotation = annotation + 1
        }
        declarationIndex = declarationIndex + 1
    }
    errors
}

fun bootstrapExportRequestsEqual(
    left: BootstrapExportRequest,
    right: BootstrapExportRequest
): bool {
    var equal = left.source == right.source &&
        left.name == right.name &&
        left.resultType == right.resultType &&
        left.checked == right.checked &&
        left.internal == right.internal &&
        left.required == right.required &&
        left.parameterNames.size == right.parameterNames.size &&
        left.parameterTypes.size == right.parameterTypes.size
    var index = 0
    while (equal && index < left.parameterNames.size) {
        equal = left.parameterNames[index] == right.parameterNames[index]
        index = index + 1
    }
    index = 0
    while (equal && index < left.parameterTypes.size) {
        equal = left.parameterTypes[index] == right.parameterTypes[index]
        index = index + 1
    }
    equal
}

fun bootstrapExportRequestAt(
    root: string,
    index: int
): BootstrapExportRequest {
    val parameterNames: array<string> = []
    val parameterTypes: array<string> = []
    val parameterCount = bootstrapDecimalIndex(
        Path("$root/$index.parameters").readText()
    )
    var parameter = 0
    while (parameter < parameterCount) {
        parameterNames.append(Path(
            "$root/$index.parameter-$parameter-name"
        ).readText())
        parameterTypes.append(Path(
            "$root/$index.parameter-$parameter-type"
        ).readText())
        parameter = parameter + 1
    }
    BootstrapExportRequest(
        Path("$root/$index.source").readText(),
        Path("$root/$index.name").readText(),
        Path("$root/$index.result").readText(),
        parameterNames,
        parameterTypes,
        Path("$root/$index.checked").readText() == "1",
        Path("$root/$index.internal").readText() == "1",
        Path("$root/$index.required").readText() == "1"
    )
}

fun bootstrapStageExportRequest(request: BootstrapExportRequest): bool {
    var valid = if (request.internal) {
        bootstrapLinkerSymbolNameValid(request.name)
    } else bootstrapExportNameValid(request.name)
    val root = bootstrapExportRequestRoot()
    var index = 0
    while (valid && index < bootstrapExportRequestCount) {
        if (Path("$root/$index.name").readText() == request.name) {
            // Framework aggregators may independently discover the same
            // monolithic link edge. Repeating an identical request is
            // idempotent; a different source, ABI, or linkage for the same
            // object symbol remains a real collision.
            if (bootstrapExportRequestsEqual(
                bootstrapExportRequestAt(root, index), request
            )) return true
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapExportRequestCount
    if (valid) valid = Path("$root/$requestIndex.source").writeTextAtomic(
        request.source
    )
    if (valid) valid = Path("$root/$requestIndex.name").writeTextAtomic(
        request.name
    )
    if (valid) valid = Path("$root/$requestIndex.result").writeTextAtomic(
        request.resultType
    )
    if (valid) valid = Path("$root/$requestIndex.checked").writeTextAtomic(
        if (request.checked) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.internal").writeTextAtomic(
        if (request.internal) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.required").writeTextAtomic(
        if (request.required) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.parameters").writeTextAtomic(
        "${request.parameterTypes.size}"
    )
    var parameter = 0
    while (valid && parameter < request.parameterTypes.size) {
        valid = Path(
            "$root/$requestIndex.parameter-$parameter-name"
        ).writeTextAtomic(request.parameterNames[parameter])
        if (valid) valid = Path(
            "$root/$requestIndex.parameter-$parameter-type"
        ).writeTextAtomic(request.parameterTypes[parameter])
        parameter = parameter + 1
    }
    if (valid) bootstrapExportRequestCount = requestIndex + 1
    if (!valid) {
        Path("$root/$requestIndex.source").remove()
        Path("$root/$requestIndex.name").remove()
        Path("$root/$requestIndex.result").remove()
        Path("$root/$requestIndex.checked").remove()
        Path("$root/$requestIndex.internal").remove()
        Path("$root/$requestIndex.required").remove()
        Path("$root/$requestIndex.parameters").remove()
        parameter = 0
        while (parameter < request.parameterTypes.size) {
            Path("$root/$requestIndex.parameter-$parameter-name").remove()
            Path("$root/$requestIndex.parameter-$parameter-type").remove()
            parameter = parameter + 1
        }
    }
    valid
}

fun bootstrapTakeExportRequests(): array<BootstrapExportRequest> {
    val requests: array<BootstrapExportRequest> = []
    val root = bootstrapExportRequestRoot()
    var index = 0
    while (index < bootstrapExportRequestCount) {
        val parameterNames: array<string> = []
        val parameterTypes: array<string> = []
        val parameterCount = bootstrapDecimalIndex(
            Path("$root/$index.parameters").readText()
        )
        var parameter = 0
        while (parameter < parameterCount) {
            parameterNames.append(Path(
                "$root/$index.parameter-$parameter-name"
            ).readText())
            parameterTypes.append(Path(
                "$root/$index.parameter-$parameter-type"
            ).readText())
            Path("$root/$index.parameter-$parameter-name").remove()
            Path("$root/$index.parameter-$parameter-type").remove()
            parameter = parameter + 1
        }
        requests.append(BootstrapExportRequest(
            Path("$root/$index.source").readText(),
            Path("$root/$index.name").readText(),
            Path("$root/$index.result").readText(),
            parameterNames,
            parameterTypes,
            Path("$root/$index.checked").readText() == "1",
            Path("$root/$index.internal").readText() == "1",
            Path("$root/$index.required").readText() == "1"
        ))
        Path("$root/$index.source").remove()
        Path("$root/$index.name").remove()
        Path("$root/$index.result").remove()
        Path("$root/$index.checked").remove()
        Path("$root/$index.internal").remove()
        Path("$root/$index.required").remove()
        Path("$root/$index.parameters").remove()
        index = index + 1
    }
    bootstrapExportRequestCount = 0
    Path(root).remove()
    requests
}

// Required internal definitions must enter source lowering before the LLVM
// reachability pass consumes the staged requests. Ordinary internalFunction
// mappings deliberately do not become roots here: their native/assembly edges
// remain responsible for retaining them.
fun bootstrapRequiredInternalFunctionSources(): array<string> {
    val sources: array<string> = []
    val root = bootstrapExportRequestRoot()
    var index = 0
    while (index < bootstrapExportRequestCount) {
        if (Path("$root/$index.required").readText() == "1") {
            sources.append(Path("$root/$index.source").readText())
        }
        index = index + 1
    }
    sources
}

fun bootstrapDriverDiagnosticRoot(): string =
    "build/.abla-driver-diagnostics-${linuxProcessId()}"

fun bootstrapNoteDiagnosedLoweringErrors(count: int): void {
    bootstrapDiagnosedLoweringErrors = bootstrapDiagnosedLoweringErrors + count
    bootstrapSemanticUnit()
}

// Named-argument errors of the current compilation (module.ab's normalizer):
// semantic mistakes the parse result counts, which code generation must not
// lower into verifier noise.
var bootstrapNamedArgumentErrors: int = 0

fun bootstrapNoteNamedArgumentErrors(count: int): void {
    bootstrapNamedArgumentErrors = bootstrapNamedArgumentErrors + count
    bootstrapSemanticUnit()
}

fun bootstrapTakeNamedArgumentErrors(): int {
    val count = bootstrapNamedArgumentErrors
    bootstrapNamedArgumentErrors = 0
    count
}

fun bootstrapTakeDiagnosedLoweringErrors(): int {
    val count = bootstrapDiagnosedLoweringErrors
    bootstrapDiagnosedLoweringErrors = 0
    count
}

fun bootstrapStageDriverDiagnostic(diagnostic: string): void {
    if (diagnostic.size <= 8192 && bootstrapDriverDiagnosticCount < 64) {
        val root = bootstrapDriverDiagnosticRoot()
        if (Path(root).createDirectories() && Path(
            "$root/$bootstrapDriverDiagnosticCount"
        ).writeTextAtomic(diagnostic)) {
            bootstrapDriverDiagnosticCount =
                bootstrapDriverDiagnosticCount + 1
        }
    }
    bootstrapSemanticUnit()
}

fun bootstrapTakeDriverDiagnostics(): string {
    var diagnostics = ""
    val root = bootstrapDriverDiagnosticRoot()
    var index = 0
    while (index < bootstrapDriverDiagnosticCount) {
        val path = Path("$root/$index")
        diagnostics = "$diagnostics${path.readText()}"
        path.remove()
        index = index + 1
    }
    bootstrapDriverDiagnosticCount = 0
    Path(root).remove()
    diagnostics
}

fun bootstrapCompileProgramRequestRoot(): string =
    "build/.abla-program-requests-${linuxProcessId()}"

fun bootstrapStageCompileProgramRequest(
    request: BootstrapCompileProgramRequest
): bool {
    var valid = bootstrapCompileProgramRequestCount < 32
    val root = bootstrapCompileProgramRequestRoot()
    var index = 0
    while (valid && index < bootstrapCompileProgramRequestCount) {
        if (Path("$root/$index.name").readText() == request.name ||
            Path("$root/$index.output").readText() == request.output) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapCompileProgramRequestCount
    if (valid) valid = Path("$root/$requestIndex.name").writeTextAtomic(
        request.name
    )
    if (valid) valid = Path("$root/$requestIndex.entry").writeTextAtomic(
        request.entry
    )
    if (valid) valid = Path("$root/$requestIndex.output").writeTextAtomic(
        request.output
    )
    if (valid) valid = Path("$root/$requestIndex.target").writeTextAtomic(
        request.target
    )
    if (valid) valid = Path("$root/$requestIndex.artifact").writeTextAtomic(
        request.artifact
    )
    if (valid) valid = Path("$root/$requestIndex.fast").writeTextAtomic(
        if (request.fast) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.cache").writeTextAtomic(
        if (request.cache) "1" else "0"
    )
    if (valid) bootstrapCompileProgramRequestCount = requestIndex + 1
    if (!valid) {
        Path("$root/$requestIndex.name").remove()
        Path("$root/$requestIndex.entry").remove()
        Path("$root/$requestIndex.output").remove()
        Path("$root/$requestIndex.target").remove()
        Path("$root/$requestIndex.artifact").remove()
        Path("$root/$requestIndex.fast").remove()
        Path("$root/$requestIndex.cache").remove()
    }
    valid
}

fun bootstrapTakeCompileProgramRequests(
): array<BootstrapCompileProgramRequest> {
    val requests: array<BootstrapCompileProgramRequest> = []
    val root = bootstrapCompileProgramRequestRoot()
    var index = 0
    while (index < bootstrapCompileProgramRequestCount) {
        requests.append(BootstrapCompileProgramRequest(
            Path("$root/$index.name").readText(),
            Path("$root/$index.entry").readText(),
            Path("$root/$index.output").readText(),
            Path("$root/$index.target").readText(),
            Path("$root/$index.artifact").readText(),
            Path("$root/$index.fast").readText() == "1",
            Path("$root/$index.cache").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.entry").remove()
        Path("$root/$index.output").remove()
        Path("$root/$index.target").remove()
        Path("$root/$index.artifact").remove()
        Path("$root/$index.fast").remove()
        Path("$root/$index.cache").remove()
        index = index + 1
    }
    bootstrapCompileProgramRequestCount = 0
    Path(root).remove()
    requests
}

fun bootstrapCompileOutputRoot(): string =
    "build/.abla-compile-outputs-${linuxProcessId()}"

fun bootstrapBuildTransactionRoot(): string =
    "build/.abla-build-transaction-${linuxProcessId()}"

fun bootstrapClearBuildTransactionJournal(): void {
    val root = bootstrapBuildTransactionRoot()
    var index = 0
    while (index < bootstrapBuildTransactionCount) {
        Path("$root/$index.path").remove()
        Path("$root/$index.existed").remove()
        Path("$root/$index.data").remove()
        Path("$root/$index.dropped").remove()
        index = index + 1
    }
    Path(root).remove()
    bootstrapBuildTransactionCount = 0
    bootstrapSemanticUnit()
}

fun bootstrapBeginBuildTransaction(): void {
    bootstrapBuildTransactionActive = false
    bootstrapClearBuildTransactionJournal()
    bootstrapBuildTransactionActive = true
    bootstrapSemanticUnit()
}

fun bootstrapRecordBuildTransactionPath(path: string): bool {
    // Callers only journal while a transaction is active. Keeping the active
    // flag out of this leaf also avoids making filesystem safety depend on a
    // managed global surviving a compiler memory-region boundary.
    var valid = path.size > 0 && path.size <= 4096
    val root = bootstrapBuildTransactionRoot()
    var recorded = false
    var index = 0
    while (valid && !recorded && index < bootstrapBuildTransactionCount) {
        if (Path("$root/$index.path").readText() == path) recorded = true
        index = index + 1
    }
    if (recorded) return true
    if (bootstrapBuildTransactionCount >= BOOTSTRAP_COMPILE_OUTPUT_LIMIT) valid = false
    val destination = Path(path)
    val existed = destination.exists()
    val journalIndex = bootstrapBuildTransactionCount
    if (valid) valid = Path(root).createDirectories()
    if (valid) valid = Path("$root/$journalIndex.path").writeTextAtomic(path)
    if (valid) valid = Path("$root/$journalIndex.existed").writeTextAtomic(
        if (existed) "1" else "0"
    )
    if (valid && existed) valid = destination.moveTo(
        Path("$root/$journalIndex.data")
    )
    if (valid) {
        bootstrapBuildTransactionCount = journalIndex + 1
    } else {
        Path("$root/$journalIndex.path").remove()
        Path("$root/$journalIndex.existed").remove()
    }
    valid
}

/** A journaled output the build removed on purpose: committing leaves it removed (a rollback
 *  still restores it). */
fun bootstrapDropBuildTransactionPath(path: string): void {
    val root = bootstrapBuildTransactionRoot()
    var index = 0
    while (index < bootstrapBuildTransactionCount) {
        if (Path("$root/$index.path").readText() == path) {
            Path("$root/$index.dropped").writeTextAtomic("1")
        }
        index = index + 1
    }
    return
}

fun bootstrapCommitBuildTransaction(): void {
    bootstrapBuildTransactionActive = false
    val root = bootstrapBuildTransactionRoot()
    var index = 0
    while (index < bootstrapBuildTransactionCount) {
        val path = Path("$root/$index.path").readText()
        if (Path("$root/$index.existed").readText() == "1" &&
            !Path(path).exists() && !Path("$root/$index.dropped").exists()) {
            Path("$root/$index.data").moveTo(Path(path))
        }
        index = index + 1
    }
    bootstrapClearBuildTransactionJournal()
    bootstrapSemanticUnit()
}

fun bootstrapRollbackBuildTransaction(): bool {
    bootstrapBuildTransactionActive = false
    var restored = true
    val root = bootstrapBuildTransactionRoot()
    var index = bootstrapBuildTransactionCount
    while (index > 0) {
        index = index - 1
        val path = Path("$root/$index.path").readText()
        if (Path("$root/$index.existed").readText() == "1") {
            Path(path).remove()
            if (!Path("$root/$index.data").moveTo(Path(path))) {
                restored = false
            }
        } else if (!Path(path).remove() && Path(path).exists()) {
            restored = false
        }
    }
    bootstrapClearBuildTransactionJournal()
    restored
}

/** A compilation starts: no outputs staged, no compile-time globals kept. */
fun bootstrapBeginCompileOutputs(): void {
    bootstrapClearCompileOutputs()
    bootstrapForgetCompileGlobals()
    bootstrapSemanticUnit()
}

fun bootstrapClearCompileOutputs(): void {
    val root = bootstrapCompileOutputRoot()
    var index = 0
    while (index < bootstrapCompileOutputCount) {
        Path("$root/$index.path").remove()
        Path("$root/$index.data").remove()
        index = index + 1
    }
    Path(root).remove()
    bootstrapCompileOutputCount = 0
    bootstrapCompileOutputBytes = 0
    bootstrapSemanticUnit()
}

// --- compile-time globals ------------------------------------------------------
//
// A `compile val` / `compile var` holds one value for a whole compilation: the first
// reference evaluates its initializer, and what any evaluation changes through it (an
// object's fields, an array's elements, a var's assignment) is what every later one sees —
// parser handlers, finalizers, transforms and compile expressions alike, across modules.
// Between evaluations the values live in a per-process journal (like the compile outputs:
// only scalar counters are process globals), so a kept value holds data only — integers,
// booleans, strings, null, arrays and objects. A value holding anything else (a closure,
// a handle) is evaluated afresh at each evaluation, as before.

fun bootstrapCompileGlobalRoot(): string =
    "build/.abla-compile-globals-${linuxProcessId()}"

fun bootstrapCompileGlobalKey(declaration: BootstrapDeclaration): string =
    "${declaration.sourceIdentity}:${declaration.name}"

fun bootstrapForgetCompileGlobals(): void {
    val root = bootstrapCompileGlobalRoot()
    var index = 0
    while (index < bootstrapCompileGlobalCount) {
        Path("$root/$index.key").remove()
        Path("$root/$index.value").remove()
        index = index + 1
    }
    Path(root).remove()
    bootstrapCompileGlobalCount = 0
    bootstrapSemanticUnit()
}

fun bootstrapCompileGlobalSlot(key: string): int {
    val root = bootstrapCompileGlobalRoot()
    var found = -1
    var index = 0
    while (found < 0 && index < bootstrapCompileGlobalCount) {
        if (Path("$root/$index.key").readText() == key) found = index
        index = index + 1
    }
    found
}

/** What an earlier evaluation kept under `key` (invalid when none). */
fun bootstrapCompileGlobalLoad(key: string): BootstrapEvalValue {
    val slot = bootstrapCompileGlobalSlot(key)
    if (slot < 0) return bootstrapEvalInvalid()
    val reader = BootstrapCompileGlobalReader(
        Path("${bootstrapCompileGlobalRoot()}/$slot.value").readText(), 0, true
    )
    val value = reader.value()
    if (!reader.ok) return bootstrapEvalInvalid()
    value
}

/** Keep the globals an evaluation read (and possibly changed) for the next ones. */
fun bootstrapCompileGlobalsKeep(
    keys: array<string>,
    values: array<BootstrapEvalValue>
): void {
    val root = bootstrapCompileGlobalRoot()
    var index = 0
    while (index < keys.size) {
        val encoded = bootstrapCompileGlobalEncode(values[index])
        var slot = bootstrapCompileGlobalSlot(keys[index])
        if (encoded == "") {
            if (slot >= 0) Path("$root/$slot.value").writeTextAtomic("")
        } else {
            var written = true
            if (slot < 0) {
                slot = bootstrapCompileGlobalCount
                written = Path(root).createDirectories() &&
                    Path("$root/$slot.key").writeTextAtomic(keys[index])
                if (written) bootstrapCompileGlobalCount = slot + 1
            }
            if (written) Path("$root/$slot.value").writeTextAtomic(encoded)
        }
        index = index + 1
    }
    bootstrapSemanticUnit()
}

fun bootstrapCompileGlobalToken(text: string): string = "${text.size}:$text"

/** Bytewise `a < b`. */
fun bootstrapTextBefore(a: string, b: string): bool {
    var index = 0
    while (index < a.size && index < b.size) {
        if (a[index] != b[index]) return a[index] < b[index]
        index = index + 1
    }
    a.size < b.size
}

/** The names in directory `path` ("." and ".." left out), sorted bytewise. */
fun bootstrapSortedEntryNames(path: string): array<string> {
    val names: array<string> = []
    for (entry in Path(path).entries()) {
        val name = entry.name()
        if (name != "." && name != "..") {
            names.append(name)
            var at = names.size - 1
            while (at > 0 && bootstrapTextBefore(names[at], names[at - 1])) {
                val swap = names[at - 1]
                names[at - 1] = names[at]
                names[at] = swap
                at = at - 1
            }
        }
    }
    names
}

/** A data value's journal text: "" when it holds anything but data. */
fun bootstrapCompileGlobalEncode(value: BootstrapEvalValue): string {
    val kind = value.kind
    if (kind != "integer" && kind != "boolean" && kind != "string" &&
        kind != "null" && kind != "void" && kind != "array" &&
        kind != "object" && kind != "f64" && kind != "f32" &&
        kind != "map") return ""
    var out = "${bootstrapCompileGlobalToken(kind)}${bootstrapCompileGlobalToken("${value.integer}")}${bootstrapCompileGlobalToken(if (value.boolean) "1" else "0")}${bootstrapCompileGlobalToken(value.text)}${bootstrapCompileGlobalToken(value.owner)}${bootstrapCompileGlobalToken("${value.fieldNames.size}")}"
    var index = 0
    while (index < value.fieldNames.size) {
        out = "$out${bootstrapCompileGlobalToken(value.fieldNames[index])}"
        index = index + 1
    }
    out = "$out${bootstrapCompileGlobalToken("${value.elements.size}")}"
    index = 0
    while (index < value.elements.size) {
        val element = bootstrapCompileGlobalEncode(value.elements[index])
        if (element == "") return ""
        out = "$out$element"
        index = index + 1
    }
    out
}

class BootstrapCompileGlobalReader(val text: string, var at: int, var ok: bool) {
    fun token(): string {
        var length = 0
        var digits = 0
        while (this.ok && this.at < this.text.size && this.text[this.at] != 58) {
            val digit = this.text[this.at] - 48
            if (digit < 0 || digit > 9) this.ok = false
            length = length * 10 + digit
            digits = digits + 1
            this.at = this.at + 1
        }
        if (digits == 0 || this.at >= this.text.size) this.ok = false
        if (!this.ok || this.at + 1 + length > this.text.size) {
            this.ok = false
            return ""
        }
        val begin = this.at + 1
        this.at = begin + length
        this.text.slice(begin, begin + length)
    }

    fun number(): int {
        val text = this.token()
        var negative = false
        var value = 0
        var index = 0
        if (text.size > 0 && text[0] == 45) {
            negative = true
            index = 1
        }
        if (index >= text.size) this.ok = false
        while (index < text.size) {
            val digit = text[index] - 48
            if (digit < 0 || digit > 9) this.ok = false
            value = value * 10 + digit
            index = index + 1
        }
        if (negative) 0 - value else value
    }

    fun value(): BootstrapEvalValue {
        val kind = this.token()
        val integer = this.number()
        val boolean = this.token() == "1"
        val text = this.token()
        val owner = this.token()
        val fieldNames: array<string> = []
        var count = this.number()
        while (this.ok && count > 0) {
            fieldNames.append(this.token())
            count = count - 1
        }
        val elements: array<BootstrapEvalValue> = []
        count = this.number()
        while (this.ok && count > 0) {
            elements.append(this.value())
            count = count - 1
        }
        BootstrapEvalValue(kind, integer, boolean, text, elements, owner, fieldNames)
    }
}

/** A compilation ends (committed or not): the staged outputs and the kept globals go. */
fun bootstrapDiscardCompileOutputs(): void {
    bootstrapClearCompileOutputs()
    bootstrapForgetCompileGlobals()
    bootstrapSemanticUnit()
}

fun bootstrapCompileOutputPathValid(path: string): bool {
    var valid = path.size > 0 && path.size <= 4096 && path[0] != 47
    var begin = 0
    var index = 0
    while (valid && index <= path.size) {
        val boundary = index == path.size || path[index] == 47
        if (boundary) {
            val length = index - begin
            if (length == 0 ||
                (length == 1 && path[begin] == 46) ||
                (length == 2 && path[begin] == 46 &&
                 path[begin + 1] == 46)) valid = false
            begin = index + 1
        } else if (path[index] == 0) valid = false
        index = index + 1
    }
    valid
}

// How many distinct paths one compilation may stage, and how many bytes in all.
val BOOTSTRAP_COMPILE_OUTPUT_LIMIT = 4096
val BOOTSTRAP_COMPILE_OUTPUT_BYTES = 268435456

/** The slot already staging `path`, -1 none. */
fun bootstrapCompileOutputSlot(path: string): int {
    val root = bootstrapCompileOutputRoot()
    var found = -1
    var index = 0
    while (found < 0 && index < bootstrapCompileOutputCount) {
        if (Path("$root/$index.path").readText() == path) found = index
        index = index + 1
    }
    found
}

fun bootstrapStageCompileOutput(path: string, contents: string): bool {
    var valid = bootstrapCompileOutputPathValid(path) &&
        contents.size <= 16777216
    // A path written again in the same compilation: the last contents win, in its slot.
    val slot = if (valid) bootstrapCompileOutputSlot(path) else -1
    if (slot >= 0) {
        val dataFile = Path("${bootstrapCompileOutputRoot()}/$slot.data")
        val previous = dataFile.readText().size
        val nextBytes = bootstrapCompileOutputBytes - previous + contents.size
        if (nextBytes > BOOTSTRAP_COMPILE_OUTPUT_BYTES) return false
        if (!dataFile.writeTextAtomic(contents)) return false
        bootstrapCompileOutputBytes = nextBytes
        return true
    }
    val nextBytes = bootstrapCompileOutputBytes + contents.size
    if (nextBytes > BOOTSTRAP_COMPILE_OUTPUT_BYTES) valid = false
    if (bootstrapCompileOutputCount >= BOOTSTRAP_COMPILE_OUTPUT_LIMIT) valid = false
    if (valid) {
        val root = bootstrapCompileOutputRoot()
        valid = Path(root).createDirectories()
        val pathFile = Path("$root/$bootstrapCompileOutputCount.path")
        val dataFile = Path("$root/$bootstrapCompileOutputCount.data")
        valid = pathFile.writeTextAtomic(path)
        if (valid) valid = dataFile.writeTextAtomic(contents)
        if (!valid) {
            pathFile.remove()
            dataFile.remove()
        }
    }
    if (valid) {
        bootstrapCompileOutputCount = bootstrapCompileOutputCount + 1
        bootstrapCompileOutputBytes = nextBytes
    }
    valid
}

// Toolchain-owned sidecars inherit the already validated/authorized artifact
// output path, which may be absolute for a root CLI build. Keep this separate
// from compilerWriteFile so staged user code remains project-relative.
fun bootstrapStageToolchainOutput(path: string, contents: string): bool {
    var valid = path.size > 0 && path.size <= 4096 &&
        contents.size <= 16777216
    var index = 0
    while (valid && index < path.size) {
        if (path[index] == 0) valid = false
        index = index + 1
    }
    val nextBytes = bootstrapCompileOutputBytes + contents.size
    if (nextBytes > BOOTSTRAP_COMPILE_OUTPUT_BYTES) valid = false
    if (bootstrapCompileOutputCount >= BOOTSTRAP_COMPILE_OUTPUT_LIMIT) valid = false
    if (valid) {
        val root = bootstrapCompileOutputRoot()
        val pathFile = Path("$root/$bootstrapCompileOutputCount.path")
        val dataFile = Path("$root/$bootstrapCompileOutputCount.data")
        valid = pathFile.writeTextAtomic(path)
        if (valid) valid = dataFile.writeTextAtomic(contents)
        if (!valid) {
            pathFile.remove()
            dataFile.remove()
        }
    }
    if (valid) {
        bootstrapCompileOutputCount = bootstrapCompileOutputCount + 1
        bootstrapCompileOutputBytes = nextBytes
    }
    valid
}

fun bootstrapCommitCompileOutputs(): bool {
    var committed = true
    var index = 0
    val root = bootstrapCompileOutputRoot()
    while (committed && index < bootstrapCompileOutputCount) {
        val pathFile = Path("$root/$index.path")
        val dataFile = Path("$root/$index.data")
        committed = pathFile.exists() && dataFile.exists()
        if (committed && bootstrapBuildTransactionActive) {
            committed = bootstrapRecordBuildTransactionPath(
                pathFile.readText()
            )
        }
        if (committed) committed = Path(pathFile.readText()).writeTextAtomic(
            dataFile.readText()
        )
        index = index + 1
    }
    bootstrapDiscardCompileOutputs()
    committed
}

class BootstrapEvalValue(
    val kind: string,
    val integer: int,
    val boolean: bool,
    val text: string,
    val elements: array<BootstrapEvalValue>,
    val owner: string,
    val fieldNames: array<string>
)

class BootstrapEvalResult(
    val value: BootstrapEvalValue,
    val errors: int,
    val diagnostics: string,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    val generatedDeclarations: array<BootstrapDeclaration>,
    // The syntax closure values index (`value.integer`): lifting a closure
    // into the program lowers its lambda from here (ct_lift.ab).
    val syntax: array<BootstrapExpression> = []
)

fun bootstrapEvalInvalid(): BootstrapEvalValue =
    BootstrapEvalValue("invalid", 0, false, "", [], "", [])

fun bootstrapEvalInteger(value: int): BootstrapEvalValue =
    BootstrapEvalValue("integer", value, false, "", [], "", [])

fun bootstrapEvalBoolean(value: bool): BootstrapEvalValue =
    BootstrapEvalValue("boolean", 0, value, "", [], "", [])

fun bootstrapEvalString(value: string): BootstrapEvalValue =
    BootstrapEvalValue("string", 0, false, value, [], "", [])

fun bootstrapEvalBase64Encode(value: string): string {
    val alphabet =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var output = ""
    var index = 0
    while (index < value.size) {
        val remaining = value.size - index
        val first = value[index]
        val second = if (remaining > 1) value[index + 1] else 0
        val third = if (remaining > 2) value[index + 2] else 0
        val combined = (first << 16) | (second << 8) | third
        output = "$output${alphabet.slice(
            (combined >>> 18) & 63,
            ((combined >>> 18) & 63) + 1
        )}${alphabet.slice(
            (combined >>> 12) & 63,
            ((combined >>> 12) & 63) + 1
        )}"
        if (remaining > 1) output = "$output${alphabet.slice(
            (combined >>> 6) & 63,
            ((combined >>> 6) & 63) + 1
        )}"
        else output = "${output}="
        if (remaining > 2) output = "$output${alphabet.slice(
            combined & 63,
            (combined & 63) + 1
        )}"
        else output = "${output}="
        index = index + 3
    }
    output
}

fun bootstrapEvalBase64DecodeDigit(value: int): int {
    if (value >= 65 && value <= 90) value - 65
    else if (value >= 97 && value <= 122) value - 71
    else if (value >= 48 && value <= 57) value + 4
    else if (value == 43) 62
    else if (value == 47) 63
    else -1
}

fun bootstrapEvalBase64Decode(value: string): string {
    var output = ""
    var valid = value.size > 0 && (value.size & 3) == 0
    var index = 0
    while (valid && index < value.size) {
        val byte2 = value[index + 2]
        val byte3 = value[index + 3]
        val padded2 = byte2 == 61
        val padded3 = byte3 == 61
        val a = bootstrapEvalBase64DecodeDigit(value[index])
        val b = bootstrapEvalBase64DecodeDigit(value[index + 1])
        val c = if (padded2) 0 else bootstrapEvalBase64DecodeDigit(byte2)
        val d = if (padded3) 0 else bootstrapEvalBase64DecodeDigit(byte3)
        valid = a >= 0 && b >= 0 && c >= 0 && d >= 0 &&
            (!padded2 || padded3) &&
            (!(padded2 || padded3) || index + 4 == value.size)
        if (valid) {
            val combined = (a << 18) | (b << 12) | (c << 6) | d
            output = "$output${byteEncode((combined >>> 16) & 255)}"
            if (!padded2) {
                output = "$output${byteEncode((combined >>> 8) & 255)}"
            }
            if (!padded3) output = "$output${byteEncode(combined & 255)}"
        }
        index = index + 4
    }
    if (valid) output else ""
}

fun bootstrapEvalByteChunksJoin(
    chunks: BootstrapEvalValue,
    byteCount: int
): BootstrapEvalValue {
    val values = bootstrapEvalUnwrapBorrow(chunks)
    var output = ""
    var valid = values.kind == "array" && byteCount >= 0
    var index = 0
    while (valid && index < values.elements.size) {
        val chunk = bootstrapEvalUnwrapBorrow(values.elements[index])
        valid = chunk.kind == "string" &&
            output.size + chunk.text.size <= byteCount
        if (valid) output = "$output${chunk.text}"
        index = index + 1
    }
    if (valid && output.size == byteCount) bootstrapEvalString(output)
    else bootstrapEvalInvalid()
}

fun bootstrapEvalNull(): BootstrapEvalValue =
    BootstrapEvalValue("null", 0, false, "", [], "", [])

fun bootstrapEvalVoid(): BootstrapEvalValue =
    BootstrapEvalValue("void", 0, false, "", [], "", [])

// The evaluation steps a build may take at compile time: enough for tables
// of tens of thousands of computed entries, while an endless loop still
// stops (in seconds).
val BOOTSTRAP_EVAL_STEP_LIMIT = 50000000

// A float at compile time keeps its IEEE bits in `integer` (an f32's in the
// low 32), so arithmetic on it is the target's own f64/f32 arithmetic.
fun bootstrapEvalF64(value: f64): BootstrapEvalValue =
    BootstrapEvalValue("f64", ablaBitF64ToI64(value), false, "", [], "", [])

fun bootstrapEvalF32(value: f32): BootstrapEvalValue =
    BootstrapEvalValue("f32", ablaBitF32ToI32(value), false, "", [], "", [])

fun bootstrapEvalAsF64(value: BootstrapEvalValue): f64 =
    ablaBitI64ToF64(value.integer)

fun bootstrapEvalAsF32(value: BootstrapEvalValue): f32 =
    ablaBitI32ToF32(value.integer)

fun bootstrapEvalFloat(value: BootstrapEvalValue): bool =
    value.kind == "f64" || value.kind == "f32"

fun bootstrapEvalEqual(
    left: BootstrapEvalValue,
    right: BootstrapEvalValue
): bool {
    var equal = left.kind == right.kind
    if (left.kind == "integer") {
        equal = equal && left.integer == right.integer
    }
    if (left.kind == "f64" && right.kind == "f64") {
        equal = bootstrapEvalAsF64(left) == bootstrapEvalAsF64(right)
    }
    if (left.kind == "f32" && right.kind == "f32") {
        equal = bootstrapEvalAsF32(left) == bootstrapEvalAsF32(right)
    }
    if (left.kind == "boolean") {
        equal = equal && left.boolean == right.boolean
    }
    if (left.kind == "string") equal = equal && left.text == right.text
    if (left.kind == "shared" || left.kind == "weak") {
        equal = equal && left.elements[0] == right.elements[0]
    }
    equal
}

fun bootstrapEvalF64Arithmetic(operation: string, left: f64, right: f64): f64 =
    when (operation) {
        "+" -> left + right
        "-" -> left - right
        "*" -> left * right
        "/" -> left / right
        else -> left % right
    }

fun bootstrapEvalF32Arithmetic(operation: string, left: f32, right: f32): f32 =
    when (operation) {
        "+" -> left + right
        "-" -> left - right
        "*" -> left * right
        "/" -> left / right
        else -> left % right
    }

// An f32 widens to f64 exactly, so comparing the widened values is the same.
fun bootstrapEvalF64Compare(operation: string, left: f64, right: f64): bool =
    when (operation) {
        "<" -> left < right
        "<=" -> left <= right
        ">" -> left > right
        else -> left >= right
    }

// The float intrinsics of abla/float and abla/math at compile time, computed
// by the same operations the compiled program uses.
fun bootstrapEvalFloatCall(
    name: string,
    argument: BootstrapEvalValue
): BootstrapEvalValue {
    val integer = argument.kind == "integer"
    val double = argument.kind == "f64"
    val single = argument.kind == "f32"
    var result = BootstrapEvalValue("invalid", 0, false, "", [], "", [])
    if (name == "ablaBitF64ToI64" && double) {
        result = bootstrapEvalInteger(argument.integer)
    }
    if (name == "ablaBitI64ToF64" && integer) {
        result = BootstrapEvalValue(
            "f64", argument.integer, false, "", [], "", []
        )
    }
    if (name == "ablaConvertI64ToF64" && integer) {
        result = bootstrapEvalF64(ablaConvertI64ToF64(argument.integer))
    }
    if (name == "ablaConvertF64ToI64" && double) {
        result = bootstrapEvalInteger(
            ablaConvertF64ToI64(bootstrapEvalAsF64(argument))
        )
    }
    if (name == "ablaBitF32ToI32" && single) {
        result = bootstrapEvalInteger(argument.integer)
    }
    if (name == "ablaBitI32ToF32" && integer) {
        result = bootstrapEvalF32(ablaBitI32ToF32(argument.integer))
    }
    if (name == "ablaConvertU32ToF32" && integer) {
        result = bootstrapEvalF32(ablaConvertU32ToF32(u32(argument.integer)))
    }
    if (name == "ablaConvertI32ToF32" && integer) {
        result = bootstrapEvalF32(ablaConvertI32ToF32(i32(argument.integer)))
    }
    if (name == "ablaConvertF32ToU32" && single) {
        result = bootstrapEvalInteger(
            i64(ablaConvertF32ToU32(bootstrapEvalAsF32(argument)))
        )
    }
    if (name == "ablaConvertF32ToI32" && single) {
        result = bootstrapEvalInteger(
            i64(ablaConvertF32ToI32(bootstrapEvalAsF32(argument)))
        )
    }
    if (name == "ablaConvertF64ToF32" && double) {
        result = bootstrapEvalF32(
            ablaConvertF64ToF32(bootstrapEvalAsF64(argument))
        )
    }
    if (name == "ablaConvertF32ToF64" && single) {
        result = bootstrapEvalF64(
            ablaConvertF32ToF64(bootstrapEvalAsF32(argument))
        )
    }
    if (double) {
        val value = bootstrapEvalAsF64(argument)
        if (name == "ablaF64Sqrt") result = bootstrapEvalF64(ablaF64Sqrt(value))
        if (name == "ablaF64Floor") result = bootstrapEvalF64(ablaF64Floor(value))
        if (name == "ablaF64Ceil") result = bootstrapEvalF64(ablaF64Ceil(value))
        if (name == "ablaF64Trunc") result = bootstrapEvalF64(ablaF64Trunc(value))
        if (name == "ablaF64Abs") result = bootstrapEvalF64(ablaF64Abs(value))
        if (name == "ablaF64RoundEven") {
            result = bootstrapEvalF64(ablaF64RoundEven(value))
        }
    }
    result
}

fun bootstrapEvalReturn(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("return", 0, false, "", [value], "", [])

fun bootstrapEvalLoopControl(kind: string): BootstrapEvalValue =
    BootstrapEvalValue(kind, 0, false, "", [], "", [])

fun bootstrapEvalFunction(name: string): BootstrapEvalValue =
    BootstrapEvalValue("function", 0, false, name, [], "", [])

fun bootstrapEvalClosure(
    expression: int,
    family: string,
    captures: array<BootstrapEvalValue>,
    names: array<string>
): BootstrapEvalValue = BootstrapEvalValue(
    "closure",
    expression,
    family == "once",
    "",
    captures,
    family,
    names
)

fun bootstrapEvalArray(
    elements: array<BootstrapEvalValue>
): BootstrapEvalValue = BootstrapEvalValue(
    "array",
    0,
    false,
    "",
    elements,
    "",
    []
)

fun bootstrapEvalObject(
    owner: string,
    fieldNames: array<string>,
    fields: array<BootstrapEvalValue>
): BootstrapEvalValue = BootstrapEvalValue(
    "object",
    0,
    false,
    "",
    fields,
    owner,
    fieldNames
)

fun bootstrapEvalShared(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = BootstrapEvalValue(
        "shared.control",
        0,
        false,
        "",
        [value, bootstrapEvalInteger(1), bootstrapEvalInteger(1)],
        "",
        []
    )
    BootstrapEvalValue("shared", 0, false, "", [control], "", [])
}

fun bootstrapEvalSharedClone(
    value: BootstrapEvalValue
): BootstrapEvalValue {
    val control = value.elements[0]
    control.elements[1] = bootstrapEvalInteger(
        control.elements[1].integer + 1
    )
    BootstrapEvalValue("shared", 0, false, "", [control], "", [])
}

fun bootstrapEvalBorrow(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("borrow", 0, false, "", [value], "", [])

fun bootstrapEvalCell(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("cell", 0, false, "", [value], "", [])

fun bootstrapEvalDelegate(
    value: BootstrapEvalValue,
    mutable: bool
): BootstrapEvalValue = BootstrapEvalValue(
    "delegate", 0, mutable, "", [value], "", []
)

fun bootstrapEvalUnwrapBorrow(value: BootstrapEvalValue): BootstrapEvalValue {
    var result = value
    while (result.kind == "borrow" && result.elements.size == 1) {
        result = result.elements[0]
    }
    result
}

// Compiler-owned, pointer-free dependency metadata. Paths are materialized as
// opaque evaluator values only while a finalizer is inspecting one typed
// snapshot; generated/runtime programs never retain these records.
class BootstrapAccessPath(
    val rootKind: string,
    val rootIdentity: string,
    val rootParameter: int,
    val segmentKinds: array<string>,
    val segmentNames: array<string>,
    val segmentIndexes: array<int>
)

class BootstrapAccessSummary(
    val reads: array<BootstrapAccessPath>,
    val writes: array<BootstrapAccessPath>,
    val consumes: array<BootstrapAccessPath>,
    var readsUnknown: bool,
    var writesUnknown: bool
)

class BootstrapLiftValidity(val valid: Cell<bool>)

fun bootstrapAccessSummary(): BootstrapAccessSummary =
    BootstrapAccessSummary([], [], [], false, false)

fun bootstrapAccessClonePath(path: BootstrapAccessPath): BootstrapAccessPath {
    val kinds: array<string> = []
    val names: array<string> = []
    val indexes: array<int> = []
    var segment = 0
    while (segment < path.segmentKinds.size) {
        kinds.append(path.segmentKinds[segment])
        names.append(path.segmentNames[segment])
        indexes.append(path.segmentIndexes[segment])
        segment = segment + 1
    }
    BootstrapAccessPath(
        path.rootKind,
        path.rootIdentity,
        path.rootParameter,
        kinds,
        names,
        indexes
    )
}

fun bootstrapAccessPathKey(path: BootstrapAccessPath): string {
    var key = "${path.rootKind}:${path.rootIdentity}:${path.rootParameter}"
    var segment = 0
    while (segment < path.segmentKinds.size) {
        key = "$key/${path.segmentKinds[segment]}:${path.segmentNames[segment]}:${path.segmentIndexes[segment]}"
        segment = segment + 1
    }
    key
}

fun bootstrapAccessAppendUnique(
    var paths: array<BootstrapAccessPath>,
    path: BootstrapAccessPath
): void {
    val key = bootstrapAccessPathKey(path)
    var found = false
    var index = 0
    while (index < paths.size) {
        if (bootstrapAccessPathKey(paths[index]) == key) found = true
        index = index + 1
    }
    if (!found && paths.size < 64) paths.append(path)
}

fun bootstrapAccessPathAppend(
    path: BootstrapAccessPath,
    kind: string,
    name: string,
    index: int
): BootstrapAccessPath {
    val result = bootstrapAccessClonePath(path)
    if (result.segmentKinds.size < 8) {
        result.segmentKinds.append(kind)
        result.segmentNames.append(name)
        result.segmentIndexes.append(index)
    } else if (result.segmentKinds.size == 8 &&
        result.segmentKinds[7] != "wildcard") {
        result.segmentKinds[7] = "wildcard"
        result.segmentNames[7] = ""
        result.segmentIndexes[7] = -1
    }
    result
}

fun bootstrapAccessPathsIntersect(
    left: BootstrapAccessPath,
    right: BootstrapAccessPath
): bool {
    var intersects = left.rootKind == right.rootKind &&
        left.rootIdentity == right.rootIdentity &&
        (left.rootParameter == right.rootParameter ||
         left.rootParameter < 0 || right.rootParameter < 0)
    var segment = 0
    val shared = if (left.segmentKinds.size < right.segmentKinds.size) {
        left.segmentKinds.size
    } else right.segmentKinds.size
    while (intersects && segment < shared) {
        val leftKind = left.segmentKinds[segment]
        val rightKind = right.segmentKinds[segment]
        if (leftKind == "wildcard" || rightKind == "wildcard") {
            segment = shared
        } else if ((leftKind == "index.dynamic" &&
                    (rightKind == "index.dynamic" ||
                     rightKind == "index.constant")) ||
                   (rightKind == "index.dynamic" &&
                    leftKind == "index.constant")) {
            intersects = intersects
        } else if (leftKind != rightKind) intersects = false
        else if (leftKind == "field" &&
            left.segmentNames[segment] != right.segmentNames[segment]) {
            intersects = false
        } else if (leftKind == "index.constant" &&
            left.segmentIndexes[segment] != right.segmentIndexes[segment]) {
            intersects = false
        }
        segment = segment + 1
    }
    intersects
}

fun bootstrapEvalValueNeedsBorrow(value: BootstrapEvalValue): bool =
    value.kind == "object" || value.kind == "array" ||
    value.kind == "string" || value.kind == "shared" ||
    value.kind == "weak" || value.kind == "closure" || value.kind == "cell"

fun bootstrapEvalSharedGet(value: BootstrapEvalValue): BootstrapEvalValue =
    bootstrapEvalBorrow(value.elements[0].elements[0])

fun bootstrapEvalWeak(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = value.elements[0]
    control.elements[2] = bootstrapEvalInteger(
        control.elements[2].integer + 1
    )
    BootstrapEvalValue("weak", 0, false, "", [control], "", [])
}

fun bootstrapEvalWeakClone(value: BootstrapEvalValue): BootstrapEvalValue =
    bootstrapEvalWeak(value)

fun bootstrapEvalWeakUpgrade(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = value.elements[0]
    var result = bootstrapEvalNull()
    if (control.elements[1].integer > 0) {
        control.elements[1] = bootstrapEvalInteger(
            control.elements[1].integer + 1
        )
        result = BootstrapEvalValue(
            "shared", 0, false, "", [control], "", []
        )
    }
    result
}

// What every evaluation over one declarations array shares: its affine type names and
// its name index. A caller that evaluates many times reuses a context while the array
// keeps its size (bootstrapEvalContextFor); a subparser stage that grows it gets a new
// one. ABLA_EVAL_INDEX_CHECK=1 checks each lookup against a scan of every declaration.
class BootstrapEvalContext(
    val size: int,
    val affineTypes: array<string>,
    val index: BootstrapDeclarationNameIndex,
    val check: bool,
    val stepLimit: int
)

// ABLA_EVAL_STEP_LIMIT lowers the step limit (never raises it), so a test can
// pin how many steps a program takes without running fifty million of them.
fun bootstrapEvalStepLimit(): int {
    val configured = linuxEnvironment("ABLA_EVAL_STEP_LIMIT")
    var limit = BOOTSTRAP_EVAL_STEP_LIMIT
    if (configured.found && configured.value.size <= 9) {
        val parsed = bootstrapDecimalIndex(configured.value)
        if (parsed > 0 && parsed < limit) limit = parsed
    }
    limit
}

fun bootstrapEvalContext(
    declarations: array<BootstrapDeclaration>
): BootstrapEvalContext {
    val configured = linuxEnvironment("ABLA_EVAL_INDEX_CHECK")
    BootstrapEvalContext(
        declarations.size,
        bootstrapBuildAffineTypeNames(declarations),
        bootstrapDeclarationNameIndex(declarations),
        configured.found && configured.value == "1",
        bootstrapEvalStepLimit()
    )
}

/** Under ABLA_EVAL_INDEX_CHECK, a lookup that a scan of every declaration contradicts. */
fun bootstrapEvalIndexCheckFailed(message: string): void {
    linuxPrintStandardError("error[E_INTERNAL]: eval.index-check: $message\n")
}

/** No context yet: its size never matches an array's. */
fun bootstrapEvalNoContext(): BootstrapEvalContext =
    BootstrapEvalContext(-1, [], BootstrapDeclarationNameIndex([], [], [], [], [], []), false, BOOTSTRAP_EVAL_STEP_LIMIT)

/** `context` while it was built for `declarations`' size, else a new one. */
fun bootstrapEvalContextFor(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>
): BootstrapEvalContext =
    if (context.size == declarations.size) context
    else bootstrapEvalContext(declarations)

class BootstrapEvaluator(
    val declarations: array<BootstrapDeclaration>,
    val affineTypes: array<string>,
    val context: BootstrapEvalContext,
    val names: array<string>,
    val values: array<BootstrapEvalValue>,
    val mutable: array<bool>,
    val cursors: array<BootstrapSubparserCursor>,
    val syntax: array<BootstrapExpression>,
    val typedCalls: array<BootstrapTypedCall>,
    val reflectedTypes: array<string>,
    val generatedDeclarations: array<BootstrapDeclaration>,
    val extensionRequests: array<BootstrapExtensionRequest>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    // The compile-time globals this evaluation has read (`compile val` / `compile var`), by
    // key, shared with the evaluations it calls; kept for the compilation at its end.
    val globalKeys: array<string>,
    val globalValues: array<BootstrapEvalValue>,
    val allowedCompileEffects: int,
    var errors: int,
    var steps: int,
    var diagnostics: string
) {
    /** Whether `name` is a field of the method receiver `this`. */
    fun receiverHasField(name: string): bool {
        val index = this.find("this")
        if (index < 0) return false
        var receiver = this.values[index]
        if (receiver.kind == "cell") receiver = receiver.elements[0]
        if (receiver.kind != "object") return false
        for (field in receiver.fieldNames) {
            if (field == name) return true
        }
        false
    }

    fun recordEvaluatorDiagnostic(code: string, message: string): void {
        this.diagnostics =
            "${this.diagnostics}error[$code]: $message\n"
        bootstrapSemanticUnit()
    }

    fun functionHandleLimit(): int {
        var limit = this.declarations.size
        var declaration = 0
        while (declaration < this.declarations.size) {
            limit = limit + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        limit
    }

    fun recordInvalidFunctionHandle(operation: string, handle: int): void {
        val limit = this.functionHandleLimit()
        var classification = "wrong declaration kind"
        var code = "E_EXT_FUNCTION_HANDLE_WRONG_KIND"
        if (handle < 0) classification = "unknown"
        if (handle < 0) code = "E_EXT_FUNCTION_HANDLE_UNKNOWN"
        if (handle >= limit) {
            classification = "out of range"
            code = "E_EXT_FUNCTION_HANDLE_OUT_OF_RANGE"
        }
        val domain =
            "compilation-scoped function declaration handle in [0, $limit)"
        val message =
            "compiler API `$operation` received invalid function handle $handle ($classification; expected a $domain)"
        this.recordEvaluatorDiagnostic(code, message)
    }

    fun accessContainingHandle(expression: BootstrapExpression): int {
        var result = -1
        var bestSpan = 2147483647
        var bestPriority = 2
        var sourceIdentity = ""
        var request = 0
        while (request < this.extensionRequests.size) {
            val candidate = this.extensionRequests[request]
            if (candidate.expression.begin == expression.begin &&
                candidate.expression.end == expression.end &&
                candidate.expression.kind == expression.kind) {
                sourceIdentity = candidate.sourceIdentity
            }
            request = request + 1
        }
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            val moduleIdentity =
                bootstrapCanonicalDeclarationModuleIdentity(candidate.name)
            var priority = 2
            if (sourceIdentity != "" &&
                candidate.sourceIdentity == sourceIdentity) priority = 0
            else if (sourceIdentity != "" &&
                candidate.sourceIdentity == "" &&
                moduleIdentity == sourceIdentity) priority = 0
            else if (candidate.sourceIdentity == "" &&
                moduleIdentity == "") priority = 1
            if ((candidate.kind == "fun" ||
                 candidate.kind == "compile.fun") &&
                candidate.generatedNamespace == "" &&
                priority < 2 &&
                candidate.expression.begin <= expression.begin &&
                candidate.expression.end >= expression.end) {
                val span = candidate.expression.end - candidate.expression.begin
                if (priority < bestPriority ||
                    (priority == bestPriority && span < bestSpan)) {
                    result = declaration
                    bestSpan = span
                    bestPriority = priority
                }
            }
            var method = 0
            while (priority < 2 && method < candidate.methods.size) {
                val found = candidate.methods[method]
                if (found.expression.begin <= expression.begin &&
                    found.expression.end >= expression.end) {
                    val span = found.expression.end - found.expression.begin
                    if (priority < bestPriority ||
                        (priority == bestPriority && span < bestSpan)) {
                        result = this.methodHandle(declaration, method)
                        bestSpan = span
                        bestPriority = priority
                    }
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
        result
    }

    fun accessAliasIndex(names: array<string>, name: string): int {
        var result = -1
        var index = 0
        while (index < names.size) {
            if (names[index] == name) result = index
            index = index + 1
        }
        result
    }

    fun accessDelegatedTypeInExpression(
        expression: BootstrapExpression,
        name: string,
        before: int
    ): string {
        var result = "unknown"
        if ((expression.kind == "local.val" ||
             expression.kind == "local.var") && expression.text == name &&
            expression.begin < before && expression.children.size > 0 &&
            expression.children[0].kind == "delegate.initializer" &&
            expression.children[0].children.size > 0) {
            result = this.staticSyntaxType(
                expression.children[0].children[0]
            )
        }
        var child = 0
        while (child < expression.children.size) {
            val found = this.accessDelegatedTypeInExpression(
                expression.children[child], name, before
            )
            if (found != "unknown") result = found
            child = child + 1
        }
        result
    }

    fun accessDelegatedType(
        name: string,
        context: int,
        before: int
    ): string {
        var result = "unknown"
        var declarationNode = this.firstNamed(name)
        while (declarationNode >= 0) {
            val declaration = this.namedDeclaration(declarationNode)
            val candidate = this.declarations[declaration]
            if (bootstrapDeclarationIsValue(candidate.kind) &&
                candidate.name == name &&
                candidate.expression.kind == "delegate.initializer" &&
                candidate.expression.children.size > 0) {
                result = this.staticSyntaxType(
                    candidate.expression.children[0]
                )
            }
            declarationNode = this.nextNamed(declarationNode)
        }
        if (context >= 0 && this.functionHandleValid(context)) {
            val local = this.accessDelegatedTypeInExpression(
                this.functionHandleDeclaration(context).expression,
                name,
                before
            )
            if (local != "unknown") result = local
        }
        result
    }

    fun accessMethodHandle(ownerName: string, name: string): int {
        var result = -1
        var declaration = 0
        while (declaration < this.declarations.size) {
            val owner = this.declarations[declaration]
            if (owner.kind == "class" && owner.name == ownerName) {
                var method = 0
                while (method < owner.methods.size) {
                    if (owner.methods[method].name == name) {
                        result = this.methodHandle(declaration, method)
                    }
                    method = method + 1
                }
            }
            if (result < 0 && owner.extensionOwner != "" &&
                owner.name == name &&
                bootstrapNormalizeType(owner.extensionOwner) == ownerName) result = declaration
            declaration = declaration + 1
        }
        result
    }

    fun accessRootPath(
        name: string,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): BootstrapAccessPath {
        val alias = this.accessAliasIndex(aliasNames, name)
        if (alias >= 0 && alias < aliasPaths.size) {
            bootstrapAccessClonePath(aliasPaths[alias])
        } else {
            var rootKind = "unknown"
            var identity = name
            var parameter = -1
            if (context >= 0 && this.functionHandleValid(context)) {
                val declaration = this.functionHandleDeclaration(context)
                var index = 0
                while (index < declaration.parameters.size) {
                    if (declaration.parameters[index] == name) {
                        rootKind = "parameter"
                        identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                            declaration.name
                        )}:${declaration.name}#$index"
                        parameter = index
                    }
                    index = index + 1
                }
                if (name == "this" && this.functionHandleOwner(context) >= 0) {
                    rootKind = "receiver"
                    val ownerName = this.declarations[
                        this.functionHandleOwner(context)
                    ].name
                    identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                        ownerName
                    )}:$ownerName"
                    parameter = -1
                }
            }
            var declarationIndexNode = this.firstNamed(name)
            while (rootKind == "unknown" &&
                declarationIndexNode >= 0) {
                val declarationIndex = this.namedDeclaration(declarationIndexNode)
                val declaration = this.declarations[declarationIndex]
                if (bootstrapDeclarationIsValue(declaration.kind) &&
                    declaration.name == name) {
                    rootKind = "global"
                    identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                        declaration.name
                    )}:${declaration.name}"
                }
                declarationIndexNode = this.nextNamed(declarationIndexNode)
            }
            if (rootKind == "unknown" && context >= 0 &&
                this.functionHandleOwner(context) >= 0) {
                val ownerIndex = this.functionHandleOwner(context)
                val owner = this.declarations[ownerIndex]
                var field = 0
                while (field < owner.parameters.size) {
                    if (owner.parameters[field] == name &&
                        field < owner.parameterKinds.size &&
                        (owner.parameterKinds[field] == "val" ||
                         owner.parameterKinds[field] == "var")) {
                        rootKind = "receiver"
                        identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                            owner.name
                        )}:${owner.name}"
                        parameter = -1
                    }
                    field = field + 1
                }
                if (rootKind == "receiver") {
                    val receiver = BootstrapAccessPath(
                        rootKind, identity, parameter, [], [], []
                    )
                    return bootstrapAccessPathAppend(
                        receiver, "field", name, -1
                    )
                }
            }
            if (rootKind == "unknown" && context >= 0) {
                rootKind = "local"
                val declaration = this.functionHandleDeclaration(context)
                identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                    declaration.name
                )}:${declaration.name}:$name"
            }
            BootstrapAccessPath(
                rootKind,
                identity,
                parameter,
                [],
                [],
                []
            )
        }
    }

    fun accessPathForPlace(
        expression: BootstrapExpression,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): BootstrapAccessPath {
        var result = BootstrapAccessPath("unknown", "", -1, [], [], [])
        if (expression.kind == "identifier") {
            result = this.accessRootPath(
                expression.text,
                context,
                aliasNames,
                aliasPaths
            )
        }
        if (expression.kind == "member" && expression.children.size > 0) {
            result = bootstrapAccessPathAppend(
                this.accessPathForPlace(
                    expression.children[0],
                    context,
                    aliasNames,
                    aliasPaths
                ),
                "field",
                expression.text,
                -1
            )
        }
        if (expression.kind == "index" && expression.children.size > 1) {
            var kind = "index.dynamic"
            var index = -1
            if (expression.children[1].kind == "integer") {
                kind = "index.constant"
                index = bootstrapDecimalIndex(expression.children[1].text)
            }
            result = bootstrapAccessPathAppend(
                this.accessPathForPlace(
                    expression.children[0],
                    context,
                    aliasNames,
                    aliasPaths
                ),
                kind,
                "",
                index
            )
        }
        if (expression.kind == "delegate.project" &&
            expression.children.size == 1) {
            result = bootstrapAccessPathAppend(
                this.accessPathForPlace(
                    expression.children[0],
                    context,
                    aliasNames,
                    aliasPaths
                ),
                "delegate",
                "",
                -1
            )
        }
        result
    }

    fun accessTypeIsScalar(type: string): bool {
        val normalized = bootstrapNormalizeType(type)
        normalized == "bool" || normalized == "char" ||
        normalized == "i8" || normalized == "i16" ||
        normalized == "i32" || normalized == "i64" ||
        normalized == "u8" || normalized == "u16" ||
        normalized == "u32" || normalized == "u64" ||
        normalized == "f32" || normalized == "f64" ||
        normalized == "cstring" || bootstrapIsNullableType(normalized)
    }

    fun accessNameIsClass(name: string): bool {
        var found = false
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].kind == "class" &&
                this.declarations[declaration].name == name) found = true
            declaration = declaration + 1
        }
        found
    }

    fun accessSubstitutedPath(
        path: BootstrapAccessPath,
        call: BootstrapExpression,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): BootstrapAccessPath {
        var base = bootstrapAccessClonePath(path)
        var argument = -1
        if (path.rootKind == "receiver" && call.kind == "member.call" &&
            call.children.size > 0) argument = 0
        if (path.rootKind == "parameter") {
            argument = path.rootParameter
            if (call.kind == "member.call") argument = argument + 1
        }
        if (argument >= 0 && argument < call.children.size) {
            val supplied = this.accessPathForPlace(
                call.children[argument],
                context,
                aliasNames,
                aliasPaths
            )
            if (supplied.rootKind != "unknown") {
                base = supplied
                var segment = 0
                while (segment < path.segmentKinds.size) {
                    base = bootstrapAccessPathAppend(
                        base,
                        path.segmentKinds[segment],
                        path.segmentNames[segment],
                        path.segmentIndexes[segment]
                    )
                    segment = segment + 1
                }
            } else base = BootstrapAccessPath(
                "value", "", -1, [], [], []
            )
        }
        base
    }

    fun accessMergeCallSummary(
        var summary: BootstrapAccessSummary,
        call: BootstrapExpression,
        callee: BootstrapAccessSummary,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): void {
        var index = 0
        while (index < callee.reads.size) {
            val path = this.accessSubstitutedPath(
                callee.reads[index], call, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.readsUnknown = true
            else if (callee.reads[index].rootKind != "local") {
                if (path.rootKind != "value") {
                    bootstrapAccessAppendUnique(summary.reads, path)
                }
            }
            index = index + 1
        }
        index = 0
        while (index < callee.writes.size) {
            val path = this.accessSubstitutedPath(
                callee.writes[index], call, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else if (callee.writes[index].rootKind != "local") {
                if (path.rootKind != "value") {
                    bootstrapAccessAppendUnique(summary.writes, path)
                }
            }
            index = index + 1
        }
        index = 0
        while (index < callee.consumes.size) {
            val path = this.accessSubstitutedPath(
                callee.consumes[index], call, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else if (callee.consumes[index].rootKind != "local") {
                if (path.rootKind != "value") {
                    bootstrapAccessAppendUnique(summary.consumes, path)
                }
            }
            index = index + 1
        }
        if (callee.readsUnknown) summary.readsUnknown = true
        if (callee.writesUnknown) summary.writesUnknown = true
    }

    fun accessSummaryForFunctionAt(
        handle: int,
        depth: int,
        visited: array<int>
    ): BootstrapAccessSummary {
        val summary = bootstrapAccessSummary()
        if (!this.functionHandleValid(handle)) {
            summary.readsUnknown = true
            summary.writesUnknown = true
        } else if (depth >= 8 || this.intArrayContains(visited, handle)) {
            summary.readsUnknown = true
            summary.writesUnknown = true
        } else {
            val declaration = this.functionHandleDeclaration(handle)
            if (declaration.kind == "extern") {
                summary.readsUnknown = true
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter < declaration.parameterKinds.size &&
                        declaration.parameterKinds[parameter] == "var") {
                        val wildcard = bootstrapAccessPathAppend(
                            this.accessRootPath(
                                declaration.parameters[parameter],
                                handle,
                                [],
                                []
                            ),
                            "wildcard",
                            "",
                            -1
                        )
                        bootstrapAccessAppendUnique(summary.writes, wildcard)
                    }
                    parameter = parameter + 1
                }
            } else if (declaration.expression.kind == "missing") {
                summary.readsUnknown = true
                summary.writesUnknown = true
            } else {
                val nestedVisited: array<int> = []
                var seen = 0
                while (seen < visited.size) {
                    nestedVisited.append(visited[seen])
                    seen = seen + 1
                }
                nestedVisited.append(handle)
                this.accessAnalyzeExpression(
                    declaration.expression,
                    summary,
                    handle,
                    [],
                    [],
                    depth,
                    nestedVisited,
                    true
                )
            }
        }
        summary
    }

    fun accessAnalyzeExpression(
        expression: BootstrapExpression,
        var summary: BootstrapAccessSummary,
        context: int,
        var aliasNames: array<string>,
        var aliasPaths: array<BootstrapAccessPath>,
        depth: int,
        visited: array<int>,
        valueRead: bool
    ): void {
        if (summary.reads.size >= 64 || summary.writes.size >= 64) {
            summary.readsUnknown = true
            summary.writesUnknown = true
            return
        }
        if (expression.kind == "identifier" && valueRead) {
            val path = this.accessPathForPlace(
                expression, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.readsUnknown = true
            else bootstrapAccessAppendUnique(summary.reads, path)
            val delegateType = this.accessDelegatedType(
                expression.text,
                context,
                expression.begin
            )
            val getter = this.accessMethodHandle(delegateType, "getValue")
            if (getter >= 0) {
                val projected = BootstrapExpression(
                    "delegate.project", "", expression.begin,
                    expression.end, [expression]
                )
                val call = BootstrapExpression(
                    "member.call", "getValue", expression.begin,
                    expression.end, [projected]
                )
                this.accessMergeCallSummary(
                    summary,
                    call,
                    this.accessSummaryForFunctionAt(
                        getter, depth + 1, visited
                    ),
                    context,
                    aliasNames,
                    aliasPaths
                )
            }
        } else if ((expression.kind == "member" ||
                    expression.kind == "index" ||
                    expression.kind == "delegate.project") && valueRead) {
            val path = this.accessPathForPlace(
                expression, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.readsUnknown = true
            else bootstrapAccessAppendUnique(summary.reads, path)
            if (expression.kind == "index" &&
                expression.children.size > 1 &&
                expression.children[1].kind != "integer") {
                this.accessAnalyzeExpression(
                    expression.children[1], summary, context,
                    aliasNames, aliasPaths, depth, visited, true
                )
            }
        } else if (expression.kind == "assign") {
            val path = this.accessRootPath(
                expression.text, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else bootstrapAccessAppendUnique(summary.writes, path)
            if (expression.children.size > 0) this.accessAnalyzeExpression(
                expression.children[0], summary, context,
                aliasNames, aliasPaths, depth, visited, true
            )
            val delegateType = this.accessDelegatedType(
                expression.text,
                context,
                expression.begin
            )
            val setter = this.accessMethodHandle(delegateType, "setValue")
            if (setter >= 0 && expression.children.size > 0) {
                val receiver = BootstrapExpression(
                    "delegate.project", "", expression.begin,
                    expression.end, [BootstrapExpression(
                        "identifier", expression.text, expression.begin,
                        expression.end, []
                    )]
                )
                val call = BootstrapExpression(
                    "member.call", "setValue", expression.begin,
                    expression.end, [receiver, expression.children[0]]
                )
                this.accessMergeCallSummary(
                    summary,
                    call,
                    this.accessSummaryForFunctionAt(
                        setter, depth + 1, visited
                    ),
                    context,
                    aliasNames,
                    aliasPaths
                )
            }
        } else if ((expression.kind == "member.assign" ||
                    expression.kind == "index.assign" ||
                    expression.kind == "delegate.assign") &&
            expression.children.size > 0) {
            val target = if (expression.kind == "delegate.assign") {
                BootstrapExpression(
                    "delegate.project", "", expression.begin,
                    expression.end, [expression.children[0]]
                )
            } else if (expression.kind == "index.assign" &&
                expression.children.size > 1) {
                BootstrapExpression(
                    "index", "", expression.begin, expression.end,
                    [expression.children[0], expression.children[1]]
                )
            } else expression.children[0]
            var path = this.accessPathForPlace(
                target, context, aliasNames, aliasPaths
            )
            if (expression.kind == "member.assign") {
                path = bootstrapAccessPathAppend(
                    path, "field", expression.text, -1
                )
            }
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else bootstrapAccessAppendUnique(summary.writes, path)
            val valueIndex = expression.children.size - 1
            this.accessAnalyzeExpression(
                expression.children[valueIndex], summary, context,
                aliasNames, aliasPaths, depth, visited, true
            )
        } else if ((expression.kind == "local.val" ||
                    expression.kind == "local.var") &&
            expression.children.size > 0) {
            val initializer = expression.children[0]
            val aliasPath = this.accessPathForPlace(
                initializer, context, aliasNames, aliasPaths
            )
            if (aliasPath.rootKind == "unknown" ||
                this.accessTypeIsScalar(this.staticSyntaxType(initializer))) {
                this.accessAnalyzeExpression(
                    initializer, summary, context,
                    aliasNames, aliasPaths, depth, visited, true
                )
            }
            if (aliasPath.rootKind != "unknown") {
                aliasNames.append(expression.text)
                aliasPaths.append(aliasPath)
            }
        } else if (expression.kind == "call" &&
            expression.text == "move" && expression.children.size == 1) {
            val path = this.accessPathForPlace(
                expression.children[0], context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else bootstrapAccessAppendUnique(summary.consumes, path)
        } else if ((expression.kind == "call" ||
                    expression.kind == "member.call")) {
            val cellReceiver = expression.kind == "member.call" &&
                expression.children.size > 0 && bootstrapIsCellType(
                    this.staticSyntaxType(expression.children[0])
                )
            if (cellReceiver && expression.text == "get") {
                val cell = bootstrapAccessPathAppend(
                    this.accessPathForPlace(
                        expression.children[0], context,
                        aliasNames, aliasPaths
                    ),
                    "cell",
                    "",
                    -1
                )
                if (cell.rootKind == "unknown") summary.readsUnknown = true
                else bootstrapAccessAppendUnique(summary.reads, cell)
            } else if (cellReceiver && expression.text == "set") {
                val cell = bootstrapAccessPathAppend(
                    this.accessPathForPlace(
                        expression.children[0], context,
                        aliasNames, aliasPaths
                    ),
                    "cell",
                    "",
                    -1
                )
                if (cell.rootKind == "unknown") summary.writesUnknown = true
                else bootstrapAccessAppendUnique(summary.writes, cell)
                if (expression.children.size > 1) {
                    this.accessAnalyzeExpression(
                        expression.children[1], summary, context,
                        aliasNames, aliasPaths, depth, visited, true
                    )
                }
            } else {
                val target = this.directCallTarget(expression, 0)
                var offset = 0
                if (expression.kind == "member.call") offset = 1
                var argument = offset
                while (argument < expression.children.size) {
                    var readArgument = target < 0
                    val parameter = argument - offset
                    if (target >= 0 && this.accessTypeIsScalar(
                        this.functionHandleParameterType(target, parameter)
                    )) readArgument = true
                    if (readArgument) this.accessAnalyzeExpression(
                        expression.children[argument], summary, context,
                        aliasNames, aliasPaths, depth, visited, true
                    )
                    argument = argument + 1
                }
                if (target >= 0) {
                    val callee = this.accessSummaryForFunctionAt(
                        target, depth + 1, visited
                    )
                    this.accessMergeCallSummary(
                        summary, expression, callee, context,
                        aliasNames, aliasPaths
                    )
                } else if (!this.accessNameIsClass(expression.text)) {
                    summary.readsUnknown = true
                    summary.writesUnknown = true
                }
            }
        } else {
            var child = 0
            while (child < expression.children.size) {
                this.accessAnalyzeExpression(
                    expression.children[child], summary, context,
                    aliasNames, aliasPaths, depth, visited, true
                )
                child = child + 1
            }
        }
    }

    fun accessSummaryForExpression(
        expression: BootstrapExpression
    ): BootstrapAccessSummary {
        val summary = bootstrapAccessSummary()
        val aliases: array<string> = []
        val aliasPaths: array<BootstrapAccessPath> = []
        val visited: array<int> = []
        this.accessAnalyzeExpression(
            expression,
            summary,
            this.accessContainingHandle(expression),
            aliases,
            aliasPaths,
            0,
            visited,
            true
        )
        summary
    }

    fun accessExpressionEffectMask(expression: BootstrapExpression): int {
        val effects = bootstrapBuildCompileEffectSummary(this.declarations)
        val delegatedNames: array<string> = []
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (bootstrapDeclarationIsValue(candidate.kind) &&
                candidate.expression.kind == "delegate.initializer") {
                delegatedNames.append(candidate.name)
            }
            declaration = declaration + 1
        }
        bootstrapCollectDelegatedNames(expression, delegatedNames)
        bootstrapExpressionDelegatedCompileEffects(
            expression,
            effects,
            delegatedNames
        )
    }

    fun accessFunctionEffectMask(handle: int): int {
        var mask = 0
        if (this.functionHandleValid(handle)) {
            val declaration = this.functionHandleDeclaration(handle)
            val effects = bootstrapBuildCompileEffectSummary(this.declarations)
            mask = bootstrapCompileEffectLookup(
                effects,
                declaration.name,
                this.functionHandleOwner(handle) >= 0
            )
        }
        mask
    }

    fun accessPathValue(path: BootstrapAccessPath): BootstrapEvalValue {
        val segments: array<BootstrapEvalValue> = []
        var segment = 0
        while (segment < path.segmentKinds.size) {
            segments.append(BootstrapEvalValue(
                "typed.access.segment",
                path.segmentIndexes[segment],
                false,
                path.segmentNames[segment],
                [],
                path.segmentKinds[segment],
                []
            ))
            segment = segment + 1
        }
        BootstrapEvalValue(
            "typed.access.path",
            path.rootParameter,
            false,
            path.rootIdentity,
            segments,
            path.rootKind,
            []
        )
    }

    fun accessValuePath(value: BootstrapEvalValue): BootstrapAccessPath {
        val kinds: array<string> = []
        val names: array<string> = []
        val indexes: array<int> = []
        if (value.kind == "typed.access.path") {
            var segment = 0
            while (segment < value.elements.size) {
                val found = value.elements[segment]
                kinds.append(found.owner)
                names.append(found.text)
                indexes.append(found.integer)
                segment = segment + 1
            }
        }
        BootstrapAccessPath(
            if (value.kind == "typed.access.path") value.owner else "unknown",
            if (value.kind == "typed.access.path") value.text else "",
            if (value.kind == "typed.access.path") value.integer else -1,
            kinds,
            names,
            indexes
        )
    }

    fun recordCompileInput(path: string, contents: string): void {
        var found = -1
        var index = 0
        while (index < this.compileInputPaths.size) {
            if (this.compileInputPaths[index] == path) found = index
            index = index + 1
        }
        if (found >= 0) {
            this.compileInputContents[found] = contents
        } else {
            this.compileInputPaths.append(path)
            this.compileInputContents.append(contents)
        }
    }

    fun uninitializedValue(): BootstrapEvalValue = BootstrapEvalValue(
        "uninitialized",
        0,
        false,
        "",
        [],
        "",
        []
    )

    fun directResourceHasDrop(value: BootstrapEvalValue): bool {
        var found = false
        if (value.kind == "object") {
            var declarationIndex = 0
            while (declarationIndex < this.declarations.size) {
                val declaration = this.declarations[declarationIndex]
                if (declaration.kind == "class" && declaration.isResource &&
                    declaration.name == value.owner) {
                    var methodIndex = 0
                    while (methodIndex < declaration.methods.size) {
                        if (declaration.methods[methodIndex].name == "drop") {
                            found = true
                        }
                        methodIndex = methodIndex + 1
                    }
                }
                declarationIndex = declarationIndex + 1
            }
        }
        found
    }

    fun valueIsAffine(value: BootstrapEvalValue): bool {
        var affine = value.kind == "object" &&
            bootstrapAffineNamesContain(this.affineTypes, value.owner)
        if (value.kind == "shared") affine = true
        if (value.kind == "weak") affine = true
        if (value.kind == "closure" &&
            (value.owner == "mut" || value.owner == "once")) affine = true
        if (value.kind == "generator" || value.kind == "task" ||
            value.kind == "thread") affine = true
        if (value.kind == "array") {
            var element = 0
            while (element < value.elements.size && !affine) {
                affine = this.valueIsAffine(value.elements[element])
                element = element + 1
            }
        }
        if (value.kind == "delegate" && value.elements.size == 1) {
            affine = this.valueIsAffine(value.elements[0])
        }
        affine
    }

    fun dropValue(var value: BootstrapEvalValue): void {
        if (value.kind == "delegate" && value.elements.size == 1 &&
            value.elements[0].kind != "uninitialized") {
            this.dropValue(value.elements[0])
            value.elements[0] = this.uninitializedValue()
        }
        if (value.kind == "shared" && value.elements.size == 1) {
            val control = value.elements[0]
            val next = control.elements[1].integer - 1
            control.elements[1] = bootstrapEvalInteger(next)
            if (next == 0 &&
                control.elements[0].kind != "uninitialized") {
                this.dropValue(control.elements[0])
                control.elements[0] = this.uninitializedValue()
                control.elements[2] = bootstrapEvalInteger(
                    control.elements[2].integer - 1
                )
            }
        }
        if (value.kind == "weak" && value.elements.size == 1) {
            val control = value.elements[0]
            control.elements[2] = bootstrapEvalInteger(
                control.elements[2].integer - 1
            )
        }
        if (value.kind == "closure" &&
            (value.owner == "mut" || value.owner == "once")) {
            var capture = value.elements.size
            while (capture > 0) {
                capture = capture - 1
                if (value.elements[capture].kind != "uninitialized") {
                    this.dropValue(value.elements[capture])
                    value.elements[capture] = this.uninitializedValue()
                }
            }
        }
        if ((value.kind == "generator" || value.kind == "task" ||
             value.kind == "thread") && value.elements.size == 1 &&
            value.elements[0].kind != "uninitialized") {
            this.dropValue(value.elements[0])
            value.elements[0] = this.uninitializedValue()
        }
        if (value.kind == "array" && this.valueIsAffine(value)) {
            var element = value.elements.size
            while (element > 0) {
                element = element - 1
                if (value.elements[element].kind != "uninitialized") {
                    this.dropValue(value.elements[element])
                    value.elements[element] = this.uninitializedValue()
                }
            }
        }
        if (value.kind == "object" &&
            bootstrapAffineNamesContain(this.affineTypes, value.owner)) {
            if (this.directResourceHasDrop(value)) {
                this.evaluateMethod(value, BootstrapExpression(
                    "member.call",
                    "drop",
                    0,
                    0,
                    []
                ))
            }
            var field = value.elements.size
            while (field > 0) {
                field = field - 1
                if (value.elements[field].kind != "uninitialized") {
                    this.dropValue(value.elements[field])
                    value.elements[field] = this.uninitializedValue()
                }
            }
        }
    }

    fun dropOwnedParameters(
        parameterKinds: array<string>,
        returned: BootstrapEvalValue,
        offset: int
    ): void {
        var parameter = parameterKinds.size
        while (parameter > 0) {
            parameter = parameter - 1
            val valueIndex = parameter + offset
            if (parameterKinds[parameter] == "own" &&
                valueIndex < this.values.size &&
                this.values[valueIndex].kind != "uninitialized" &&
                this.values[valueIndex] != returned) {
                val owned = this.values[valueIndex]
                this.dropValue(owned)
                this.values[valueIndex] = this.uninitializedValue()
            }
        }
    }

    /** A `compile val` / `compile var`'s value: one for the whole compilation. The first
     *  reference evaluates its initializer (or takes what an earlier evaluation kept);
     *  changes through it last for every later evaluation. */
    fun compileGlobal(declaration: BootstrapDeclaration): BootstrapEvalValue {
        val key = bootstrapCompileGlobalKey(declaration)
        var index = 0
        while (index < this.globalKeys.size) {
            if (this.globalKeys[index] == key) return this.globalValues[index]
            index = index + 1
        }
        var value = bootstrapCompileGlobalLoad(key)
        if (value.kind == "invalid") value = this.evaluate(declaration.expression)
        this.globalKeys.append(key)
        this.globalValues.append(value)
        value
    }

    /** The `compile var` declaration named `name`, -1 none. */
    fun compileVar(name: string): int {
        var result = -1
        var index = 0
        while (index < this.declarations.size) {
            if (this.declarations[index].kind == "compile.var" &&
                this.declarations[index].name == name) result = index
            index = index + 1
        }
        result
    }

    // The last binding of `name`: scanned from the end, the first match.
    fun find(name: string): int {
        var result = -1
        var index = this.names.size - 1
        while (result < 0 && index >= 0) {
            if (this.names[index] == name) result = index
            index = index - 1
        }
        if (this.context.check) {
            var scanned = -1
            index = 0
            while (index < this.names.size) {
                if (this.names[index] == name) scanned = index
                index = index + 1
            }
            if (scanned != result) {
                bootstrapEvalIndexCheckFailed("find `$name`: $result, a scan finds $scanned")
            }
        }
        result
    }

    // The first node of the declarations named `name` (BootstrapDeclarationNameIndex); walk on
    // with nextNamed and read each with namedDeclaration.
    fun firstNamed(name: string): int {
        val first = this.context.index.first(name)
        if (this.context.check) {
            var node = first
            var declaration = 0
            var same = this.context.size == this.declarations.size
            while (same && declaration < this.declarations.size) {
                if (this.declarations[declaration].name == name) {
                    same = node >= 0 &&
                        this.context.index.nodeDeclarations[node] == declaration
                    if (same) node = this.context.index.nodeNexts[node]
                }
                declaration = declaration + 1
            }
            if (!same || node >= 0) {
                bootstrapEvalIndexCheckFailed("the declarations named `$name` differ from a scan")
            }
        }
        first
    }

    fun nextNamed(node: int): int = this.context.index.nodeNexts[node]

    fun namedDeclaration(node: int): int = this.context.index.nodeDeclarations[node]


    fun invokeDelegateMethod(
        delegate: BootstrapEvalValue,
        name: string,
        argument: BootstrapEvalValue,
        hasArgument: bool,
        begin: int,
        end: int
    ): BootstrapEvalValue {
        val children: array<BootstrapExpression> = []
        if (hasArgument) {
            val temporary = "__delegate_argument_${this.steps}_${this.names.size}"
            this.names.append(temporary)
            this.values.append(argument)
            this.mutable.append(false)
            children.append(BootstrapExpression(
                "invalid", "delegate-receiver", begin, begin, []
            ))
            children.append(BootstrapExpression(
                "identifier", temporary, begin, end, []
            ))
            val result = this.evaluateMethod(
                bootstrapEvalUnwrapBorrow(delegate),
                BootstrapExpression(
                    "member.call", name, begin, end, children
                )
            )
            this.values[this.values.size - 1] = this.uninitializedValue()
            this.names[this.names.size - 1] = ""
            result
        } else this.evaluateMethod(
            bootstrapEvalUnwrapBorrow(delegate),
            BootstrapExpression("member.call", name, begin, end, children)
        )
    }

    fun delegatedSlot(name: string): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        val found = this.find(name)
        if (found >= 0) {
            result = this.values[found]
            if (result.kind == "cell" && result.elements.size == 1) {
                result = result.elements[0]
            }
        }
        val cacheName = "delegate.global@$name"
        val cached = this.find(cacheName)
        if (result.kind == "invalid" && cached >= 0) {
            result = this.values[cached]
        }
        if (result.kind == "invalid") {
            var declarationNode = this.firstNamed(name)
            while (declarationNode >= 0) {
                val declaration = this.namedDeclaration(declarationNode)
                val candidate = this.declarations[declaration]
                if (bootstrapDeclarationIsValue(candidate.kind) &&
                    candidate.name == name &&
                    candidate.expression.kind == "delegate.initializer") {
                    result = this.evaluate(candidate.expression)
                    this.names.append(cacheName)
                    this.values.append(result)
                    this.mutable.append(false)
                }
                declarationNode = this.nextNamed(declarationNode)
            }
        }
        result
    }

    fun printable(value: BootstrapEvalValue): string {
        var result = value.text
        if (value.kind == "integer") result = "${value.integer}"
        if (value.kind == "f64") result = f64Text(bootstrapEvalAsF64(value))
        if (value.kind == "f32") {
            result = f64Text(f32ToF64(bootstrapEvalAsF32(value)))
        }
        if (value.kind == "boolean") {
            result = if (value.boolean) "true" else "false"
        }
        if (value.kind == "null") result = "null"
        result
    }

    fun syntaxValue(expression: BootstrapExpression): BootstrapEvalValue {
        val handle = this.syntax.size
        this.syntax.append(expression)
        BootstrapEvalValue("syntax", handle, false, "", [], "", [])
    }

    fun reflectedTypeHandle(type: string): int {
        val normalized = bootstrapNormalizeType(type)
        var found = -1
        var index = 0
        while (index < this.reflectedTypes.size) {
            if (this.reflectedTypes[index] == normalized) found = index
            index = index + 1
        }
        if (found < 0 && normalized != "" && normalized != "unknown" &&
            this.reflectedTypes.size < 4096) {
            this.reflectedTypes.append(normalized)
            found = this.reflectedTypes.size - 1
        }
        found
    }

    fun reflectedTypeValid(handle: int): bool =
        handle >= 0 && handle < this.reflectedTypes.size

    fun reflectedTypeKind(type: string): string {
        var kind = "nominal"
        if (type == "void" || type == "never" || type == "null" ||
            type == "bool" || type == "char" || type == "string" ||
            type == "i8" || type == "i16" || type == "i32" ||
            type == "i64" || type == "u8" || type == "u16" ||
            type == "u32" || type == "u64" || type == "f32" ||
            type == "f64") kind = "primitive"
        if (bootstrapIsNullableType(type)) kind = "nullable"
        if (bootstrapIsArrayType(type)) kind = "array"
        if (bootstrapIsSharedType(type)) kind = "shared"
        if (bootstrapIsWeakType(type)) kind = "weak"
        if (bootstrapIsMutexType(type)) kind = "mutex"
        if (bootstrapIsBorrowType(type)) kind = "borrow"
        if (bootstrapIsFunctionType(type)) kind = "function"
        if (bootstrapIsOnceFunctionType(type)) kind = "function.once"
        if (bootstrapIsMutableFunctionType(type)) kind = "function.mutable"
        if (type.size > 0 && type[type.size - 1] == 42) kind = "pointer"
        kind
    }

    fun reflectedTypeElement(type: string): string {
        var element = "unknown"
        if (bootstrapIsNullableType(type)) {
            element = bootstrapNullableElementType(type)
        }
        if (bootstrapIsArrayType(type)) element = bootstrapArrayElementType(type)
        if (bootstrapIsSharedType(type)) element = bootstrapSharedElementType(type)
        if (bootstrapIsWeakType(type)) element = bootstrapWeakElementType(type)
        if (bootstrapIsMutexType(type)) element = bootstrapMutexElementType(type)
        if (bootstrapIsBorrowType(type)) element = bootstrapBorrowElementType(type)
        if (type.size > 0 && type[type.size - 1] == 42) {
            element = type.slice(0, type.size - 1)
        }
        element
    }

    fun generatedIdentifierPart(text: string): string {
        var result = ""
        var index = 0
        while (index < text.size) {
            val byte = text[index]
            if ((byte >= 65 && byte <= 90) ||
                (byte >= 97 && byte <= 122) ||
                (byte >= 48 && byte <= 57) || byte == 95) {
                result = "$result${text.slice(index, index + 1)}"
            } else result = "${result}_"
            index = index + 1
        }
        if (result == "") result = "generated"
        result
    }

    fun generatedStringLiteral(text: string): string {
        var result = "\""
        var index = 0
        while (index < text.size) {
            val byte = text[index]
            if (byte == 34) result = "${result}\\\""
            else if (byte == 92) result = "${result}\\\\"
            else if (byte == 10) result = "${result}\\n"
            else if (byte == 13) result = "${result}\\r"
            else if (byte == 9) result = "${result}\\t"
            else result = "$result${text.slice(index, index + 1)}"
            index = index + 1
        }
        "$result\""
    }

    fun generatedSyntaxSource(
        expression: BootstrapExpression,
        depth: int
    ): string {
        var result = ""
        if (depth <= 128) {
        if (expression.kind == "integer") result = expression.text
        if (expression.kind == "string") {
            result = this.generatedStringLiteral(expression.text)
        }
        if (expression.kind == "identifier") result = expression.text
        if (expression.kind == "true" || expression.kind == "false" ||
            expression.kind == "null") result = expression.kind
        if (expression.kind == "if" && expression.children.size == 3) {
            result = "if (${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}) ${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )} else ${this.generatedSyntaxSource(
                expression.children[2], depth + 1
            )}"
        }
        if (expression.kind == "array") {
            result = "["
            var element = 0
            while (element < expression.children.size) {
                if (element > 0) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[element], depth + 1
                )}"
                element = element + 1
            }
            result = "$result]"
        }
        if (expression.kind == "call") {
            var name = expression.text
            if (expression.begin < 0) {
                val handle = 0 - expression.begin - 1
                if (this.functionHandleValid(handle)) {
                    val owner = this.functionHandleOwner(handle)
                    if (owner < 0) name = this.declarations[handle].name
                }
            }
            result = "$name("
            var argument = 0
            while (argument < expression.children.size) {
                if (argument > 0) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[argument], depth + 1
                )}"
                argument = argument + 1
            }
            result = "$result)"
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}.${expression.text}("
            var argument = 1
            while (argument < expression.children.size) {
                if (argument > 1) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[argument], depth + 1
                )}"
                argument = argument + 1
            }
            result = "$result)"
        }
        if (expression.kind == "member" && expression.children.size == 1) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}.${expression.text}"
        }
        if (expression.kind == "index" && expression.children.size == 2) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}[${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )}]"
        }
        if (expression.children.size == 2 && expression.text != "" &&
            result == "") {
            result = "(${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )} ${expression.text} ${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )})"
        }
        if (expression.kind == "return") {
            result = "return"
            if (expression.children.size > 0) {
                result = "$result ${this.generatedSyntaxSource(
                    expression.children[0], depth + 1
                )}"
            }
        }
        if (expression.kind == "defer" && expression.children.size == 1) {
            result = "defer ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if ((expression.kind == "generator" || expression.kind == "task" ||
             expression.kind == "thread") && expression.children.size == 1) {
            result = "${expression.kind} ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if ((expression.kind == "await" || expression.kind == "yield") &&
            expression.children.size == 1) {
            result = "${expression.kind} ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if (expression.kind == "assign" &&
            expression.children.size == 1) {
            result = "${expression.text} = ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if ((expression.kind == "local.val" ||
             expression.kind == "local.var") &&
            expression.children.size > 0) {
            val keyword = if (expression.kind == "local.val") "val" else "var"
            result = "$keyword ${expression.text}"
            if (expression.children.size > 1 &&
                expression.children[1].text != "inferred") {
                result = "$result: ${expression.children[1].text}"
            }
            result = "$result = ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if (expression.kind == "block") {
            result = "{\n"
            var statement = 0
            while (statement < expression.children.size) {
                result = "$result${this.generatedSyntaxSource(
                    expression.children[statement], depth + 1
                )}\n"
                statement = statement + 1
            }
            result = "$result}"
        }
        if ((expression.kind == "lambda" ||
             expression.kind == "lambda.move") &&
            expression.children.size > 0) {
            result = ""
            if (expression.kind == "lambda.move") result = "move "
            result = "$result{"
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                if (parameter > 0) result = "$result, "
                val found = expression.children[parameter]
                result = "$result${found.text}: ${found.children[0].text}"
                parameter = parameter + 1
            }
            result = "$result -> ${this.generatedSyntaxSource(
                expression.children[expression.children.size - 1],
                depth + 1
            )}}"
        }
        }
        result
    }

    fun liftedCaptureIndex(names: array<string>, name: string): int {
        var result = -1
        var index = 0
        while (index < names.size) {
            if (names[index] == name) result = index
            index = index + 1
        }
        result
    }

    fun liftedNameIsDeclaration(name: string): bool {
        var found = false
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].name == name) found = true
            declaration = declaration + 1
        }
        found
    }

    fun rewriteLiftedExpression(
        expression: BootstrapExpression,
        captureNames: array<string>,
        parameterNames: array<string>,
        var bound: array<string>,
        validity: BootstrapLiftValidity
    ): BootstrapExpression {
        var text = expression.text
        val children: array<BootstrapExpression> = []
        if (expression.kind == "block") {
            var statement = 0
            while (statement < expression.children.size) {
                val child = expression.children[statement]
                children.append(this.rewriteLiftedExpression(
                    child,
                    captureNames,
                    parameterNames,
                    bound,
                    validity
                ))
                if (child.kind == "local.val" || child.kind == "local.var") {
                    bound.append(child.text)
                }
                statement = statement + 1
            }
        } else if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            val nested: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nested.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                nested.append(expression.children[parameter].text)
                children.append(expression.children[parameter])
                parameter = parameter + 1
            }
            children.append(this.rewriteLiftedExpression(
                expression.children[expression.children.size - 1],
                captureNames,
                parameterNames,
                nested,
                validity
            ))
        } else {
            var child = 0
            while (child < expression.children.size) {
                children.append(this.rewriteLiftedExpression(
                    expression.children[child],
                    captureNames,
                    parameterNames,
                    bound,
                    validity
                ))
                child = child + 1
            }
        }
        if (expression.kind == "identifier" ||
            expression.kind == "assign" || expression.kind == "call") {
            val capture = this.liftedCaptureIndex(captureNames, text)
            if (capture >= 0 && capture < parameterNames.size &&
                !this.nameIsBound(bound, text)) {
                text = parameterNames[capture]
            } else if (expression.kind == "identifier" &&
                !this.nameIsBound(bound, text) &&
                !this.liftedNameIsDeclaration(text)) {
                validity.valid.set(false)
            }
            if (expression.kind == "assign" &&
                !this.nameIsBound(bound, text) &&
                !this.liftedNameIsDeclaration(text) && capture < 0) {
                validity.valid.set(false)
            }
        }
        BootstrapExpression(
            expression.kind,
            text,
            expression.begin,
            expression.end,
            children
        )
    }

    fun generatedDeclarationName(
        module: BootstrapEvalValue,
        hint: string
    ): string {
        val namespace = this.generatedIdentifierPart(module.text)
        val readable = this.generatedIdentifierPart(hint)
        val base = "__abla_generated_${namespace}_${module.integer}_${module.elements.size}_${readable}"
        var result = base
        var suffix = 0
        var collision = true
        while (collision && suffix < 1024) {
            collision = false
            var declaration = 0
            while (declaration < this.declarations.size) {
                if (this.declarations[declaration].name == result) {
                    collision = true
                }
                declaration = declaration + 1
            }
            var generated = 0
            while (generated < module.fieldNames.size) {
                if (module.fieldNames[generated] == result) collision = true
                generated = generated + 1
            }
            if (collision) {
                suffix = suffix + 1
                result = "${base}_$suffix"
            }
        }
        if (collision) "" else result
    }

    fun generatedExportName(
        module: BootstrapEvalValue,
        name: string
    ): string {
        var available = name != "" &&
            this.generatedIdentifierPart(name) == name
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].name == name) available = false
            declaration = declaration + 1
        }
        var generated = 0
        while (generated < module.fieldNames.size) {
            if (module.fieldNames[generated] == name) available = false
            generated = generated + 1
        }
        if (available) name else ""
    }

    fun methodHandle(owner: int, method: int): int {
        var handle = this.declarations.size
        var declaration = 0
        while (declaration < owner) {
            handle = handle + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        handle + method
    }

    fun functionHandleOwner(handle: int): int {
        var owner = -1
        if (handle >= this.declarations.size) {
            var cursor = this.declarations.size
            var declaration = 0
            while (owner < 0 && declaration < this.declarations.size) {
                val next = cursor +
                    this.declarations[declaration].methods.size
                if (handle >= cursor && handle < next) owner = declaration
                cursor = next
                declaration = declaration + 1
            }
        }
        owner
    }

    fun functionHandleMethod(handle: int): int {
        val owner = this.functionHandleOwner(handle)
        var method = -1
        if (owner >= 0) method = handle - this.methodHandle(owner, 0)
        method
    }

    fun functionHandleValid(handle: int): bool {
        var valid = handle >= 0 && handle < this.declarations.size &&
            (this.declarations[handle].kind == "fun" ||
             this.declarations[handle].kind == "compile.fun" ||
             this.declarations[handle].kind == "extern")
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size) valid = true
        valid
    }

    fun functionHandleResultType(handle: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size) {
            result = bootstrapNormalizeType(
                this.declarations[handle].resultType
            )
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size) {
            result = bootstrapNormalizeType(
                this.declarations[owner].methods[method].resultType
            )
        }
        result
    }

    fun generatedDeclarationCount(module: BootstrapEvalValue): int {
        var count = 0
        var element = 0
        if (module.kind == "generated.module") {
            while (element < module.elements.size) {
                if (module.elements[element].kind ==
                    "generated.declaration") count = count + 1
                element = element + 1
            }
        }
        count
    }

    fun generatedDeclarationAt(
        module: BootstrapEvalValue,
        ordinal: int
    ): int {
        var result = -1
        var current = 0
        var element = 0
        if (module.kind == "generated.module" && ordinal >= 0) {
            while (element < module.elements.size) {
                val candidate = module.elements[element]
                if (candidate.kind == "generated.declaration") {
                    if (current == ordinal) result = candidate.integer
                    current = current + 1
                }
                element = element + 1
            }
        }
        if (result < 0 || result >= this.generatedDeclarations.size) {
            result = -1
        }
        result
    }

    fun functionHandleParameterType(handle: int, parameter: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size && parameter >= 0 &&
            parameter < this.declarations[handle].parameterTypes.size) {
            result = bootstrapNormalizeType(
                this.declarations[handle].parameterTypes[parameter]
            )
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size && parameter >= 0 &&
            parameter <
                this.declarations[owner].methods[method].parameterTypes.size) {
            result = bootstrapNormalizeType(
                this.declarations[owner].methods[method].parameterTypes[parameter]
            )
        }
        result
    }

    fun functionHandleParameterKind(handle: int, parameter: int): string {
        var result = "parameter"
        if (handle >= 0 && handle < this.declarations.size && parameter >= 0 &&
            parameter < this.declarations[handle].parameterKinds.size) {
            result = this.declarations[handle].parameterKinds[parameter]
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size && parameter >= 0 &&
            parameter <
                this.declarations[owner].methods[method].parameterKinds.size) {
            val declaration = this.declarations[owner].methods[method]
            result = declaration.parameterKinds[parameter]
        }
        result
    }

    fun functionHandleDeclaration(handle: int): BootstrapDeclaration {
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0) {
            this.declarations[owner].methods[method]
        } else this.declarations[handle]
    }

    fun bindingHandleValid(handle: int): bool =
        handle >= 0 && handle < this.declarations.size &&
        bootstrapDeclarationIsValue(this.declarations[handle].kind)

    fun bindingIsDelegated(handle: int): bool =
        this.bindingHandleValid(handle) &&
        this.declarations[handle].expression.kind == "delegate.initializer" &&
        this.declarations[handle].expression.children.size == 2

    fun bindingDelegateType(handle: int): string {
        var result = "unknown"
        if (this.bindingIsDelegated(handle)) {
            result = this.staticSyntaxType(
                this.declarations[handle].expression.children[0]
            )
        }
        result
    }

    fun bindingMethodHandle(handle: int, name: string): int {
        var result = -1
        val ownerName = this.bindingDelegateType(handle)
        var declaration = 0
        while (declaration < this.declarations.size) {
            val owner = this.declarations[declaration]
            if (owner.kind == "class" && owner.name == ownerName) {
                var method = 0
                while (method < owner.methods.size) {
                    if (owner.methods[method].name == name) {
                        result = this.methodHandle(declaration, method)
                    }
                    method = method + 1
                }
            }
            if (result < 0 && owner.extensionOwner != "" &&
                owner.name == name &&
                bootstrapNormalizeType(owner.extensionOwner) == ownerName) result = declaration
            declaration = declaration + 1
        }
        result
    }

    fun bindingExposedType(handle: int): string {
        var result = "unknown"
        if (this.bindingHandleValid(handle)) {
            val declaration = this.declarations[handle]
            if (declaration.resultType != "inferred") {
                result = bootstrapNormalizeType(declaration.resultType)
            } else if (this.bindingIsDelegated(handle)) {
                val getter = this.bindingMethodHandle(handle, "getValue")
                if (getter >= 0) result = this.functionHandleResultType(getter)
            } else result = this.staticSyntaxType(declaration.expression)
        }
        result
    }

    fun classFieldType(handle: int, wanted: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size &&
            this.declarations[handle].kind == "class" && wanted >= 0) {
            val declaration = this.declarations[handle]
            var field = 0
            var parameter = 0
            while (parameter < declaration.parameterKinds.size) {
                if (declaration.parameterKinds[parameter] == "val" ||
                    declaration.parameterKinds[parameter] == "var") {
                    if (field == wanted &&
                        parameter < declaration.parameterTypes.size) {
                        result = bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                    }
                    field = field + 1
                }
                parameter = parameter + 1
            }
        }
        result
    }

    fun lexicalTypeInExpression(
        container: BootstrapExpression,
        name: string,
        position: int,
        depth: int
    ): string {
        var result = "unknown"
        if (depth < 32 && container.kind == "block") {
            var child = 0
            while (child < container.children.size) {
                val statement = container.children[child]
                if ((statement.kind == "local.val" ||
                     statement.kind == "local.var") &&
                    statement.text == name && statement.begin < position) {
                    if (statement.children.size > 1 &&
                        statement.children[1].text != "inferred") {
                        result = bootstrapNormalizeType(
                            statement.children[1].text
                        )
                    } else if (statement.children.size > 0) {
                        result = this.staticSyntaxTypeAt(
                            statement.children[0], depth + 1
                        )
                    }
                }
                if (statement.begin <= position &&
                    statement.end >= position) {
                    val nested = this.lexicalTypeInExpression(
                        statement, name, position, depth + 1
                    )
                    if (nested != "unknown") result = nested
                }
                child = child + 1
            }
        } else if (depth < 32 &&
            container.begin <= position && container.end >= position) {
            if (container.kind == "lambda" ||
                container.kind == "lambda.move") {
                var parameter = 0
                while (parameter + 1 < container.children.size) {
                    val found = container.children[parameter]
                    if (found.kind == "lambda.parameter" &&
                        found.text == name && found.children.size > 0) {
                        result = bootstrapNormalizeType(
                            found.children[0].text
                        )
                    }
                    parameter = parameter + 1
                }
            }
            var child = 0
            while (child < container.children.size) {
                val nested = this.lexicalTypeInExpression(
                    container.children[child],
                    name,
                    position,
                    depth + 1
                )
                if (nested != "unknown") result = nested
                child = child + 1
            }
        }
        result
    }

    fun lexicalSyntaxType(name: string, position: int, depth: int): string {
        var result = "unknown"
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (candidate.expression.begin <= position &&
                candidate.expression.end >= position) {
                var parameter = 0
                while (parameter < candidate.parameters.size &&
                    parameter < candidate.parameterTypes.size) {
                    if (candidate.parameters[parameter] == name) {
                        result = bootstrapNormalizeType(
                            candidate.parameterTypes[parameter]
                        )
                    }
                    parameter = parameter + 1
                }
                if (candidate.extensionOwner != "" && name == "this") {
                    result = bootstrapNormalizeType(candidate.extensionOwner)
                }
                val local = this.lexicalTypeInExpression(
                    candidate.expression,
                    name,
                    position,
                    depth
                )
                if (local != "unknown") result = local
            }
            var method = 0
            while (method < candidate.methods.size) {
                val member = candidate.methods[method]
                if (member.expression.begin <= position &&
                    member.expression.end >= position) {
                    if (name == "this") result = candidate.name
                    var parameter = 0
                    while (parameter < member.parameters.size &&
                        parameter < member.parameterTypes.size) {
                        if (member.parameters[parameter] == name) {
                            result = bootstrapNormalizeType(
                                member.parameterTypes[parameter]
                            )
                        }
                        parameter = parameter + 1
                    }
                    val local = this.lexicalTypeInExpression(
                        member.expression,
                        name,
                        position,
                        depth
                    )
                    if (local != "unknown") result = local
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
        result
    }

    fun directCallTarget(
        expression: BootstrapExpression,
        depth: int
    ): int {
        var handle = -1
        if ((expression.kind == "call" ||
             expression.kind == "member.call") && expression.begin < 0) {
            val marked = 0 - expression.begin - 1
            if (this.functionHandleValid(marked)) handle = marked
        }
        if (handle < 0 && expression.kind == "call") {
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun" ||
                     candidate.kind == "extern") &&
                    candidate.name == expression.text) {
                    if (handle >= 0) handle = -2
                    if (handle == -1) handle = declaration
                }
                declaration = declaration + 1
            }
        }
        if (handle < 0 && expression.kind == "member.call" &&
            expression.children.size > 0) {
            val receiver = bootstrapBorrowElementType(
                this.staticSyntaxTypeAt(expression.children[0], depth + 1)
            )
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (candidate.name == expression.text &&
                    bootstrapNormalizeType(candidate.extensionOwner) == receiver) {
                    if (handle >= 0) handle = -2
                    if (handle == -1) handle = declaration
                }
                if (candidate.kind == "class" &&
                    candidate.name == receiver) {
                    var method = 0
                    while (method < candidate.methods.size) {
                        if (candidate.methods[method].name == expression.text) {
                            if (handle >= 0) handle = -2
                            if (handle == -1) {
                                handle = this.methodHandle(declaration, method)
                            }
                        }
                        method = method + 1
                    }
                }
                declaration = declaration + 1
            }
        }
        handle
    }

    fun staticSyntaxTypeAt(
        expression: BootstrapExpression,
        depth: int
    ): string {
        var result = "unknown"
        if (depth >= 8) result = "unknown"
        if (expression.kind == "integer") result = "i64"
        if (expression.kind == "true" || expression.kind == "false") {
            result = "bool"
        }
        if (expression.kind == "string") result = "string"
        if (expression.kind == "null") result = "null"
        if (expression.kind == "+" || expression.kind == "-" ||
            expression.kind == "*" || expression.kind == "/" ||
            expression.kind == "%" ||
            expression.kind == "&" || expression.kind == "|" ||
            expression.kind == "^" || expression.kind == "<<" ||
            expression.kind == ">>" || expression.kind == ">>>" ||
            expression.kind == "unary~") {
            result = "i64"
        }
        if (expression.kind == "==" || expression.kind == "!=" ||
            expression.kind == "<" || expression.kind == "<=" ||
            expression.kind == ">" || expression.kind == ">=") {
            result = "bool"
        }
        if (depth < 8 && expression.kind == "identifier") {
            result = this.lexicalSyntaxType(
                expression.text,
                expression.begin,
                depth + 1
            )
            var declarationNode = this.firstNamed(expression.text)
            while (declarationNode >= 0) {
                val declaration = this.namedDeclaration(declarationNode)
                val candidate = this.declarations[declaration]
                if (bootstrapDeclarationIsValue(candidate.kind) &&
                    candidate.name == expression.text && result == "unknown") {
                    if (candidate.resultType == "inferred") {
                        result = this.staticSyntaxTypeAt(
                            candidate.expression,
                            depth + 1
                        )
                    } else result = bootstrapNormalizeType(
                        candidate.resultType
                    )
                }
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun" ||
                    candidate.kind == "extern") &&
                    candidate.name == expression.text && result == "unknown") {
                    result = bootstrapDeclarationFunctionType(candidate)
                }
                declarationNode = this.nextNamed(declarationNode)
            }
        }
        if (depth < 8 && expression.kind == "array") {
            var elementType = "unknown"
            var element = 0
            while (element < expression.children.size) {
                val found = this.staticSyntaxTypeAt(
                    expression.children[element], depth + 1
                )
                if (elementType == "unknown") elementType = found
                if (elementType != found) elementType = "unknown"
                element = element + 1
            }
            result = "array:$elementType"
        }
        if (depth < 8 && expression.kind == "member" &&
            expression.children.size > 0) {
            val receiver = bootstrapBorrowElementType(
                this.staticSyntaxTypeAt(expression.children[0], depth + 1)
            )
            if (expression.text == "size" &&
                (receiver == "string" || bootstrapIsArrayType(receiver))) {
                result = "i64"
            }
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (candidate.kind == "class" &&
                    candidate.name == receiver) {
                    var field = 0
                    while (field < candidate.parameters.size) {
                        if (candidate.parameters[field] == expression.text &&
                            field < candidate.parameterKinds.size &&
                            (candidate.parameterKinds[field] == "val" ||
                             candidate.parameterKinds[field] == "var") &&
                            field < candidate.parameterTypes.size) {
                            result = bootstrapNormalizeType(
                                candidate.parameterTypes[field]
                            )
                        }
                        field = field + 1
                    }
                }
                declaration = declaration + 1
            }
        }
        if (depth < 8) {
            val target = this.directCallTarget(expression, depth)
            if (target >= 0) result = this.functionHandleResultType(target)
            if (expression.kind == "call" && target < 0) {
                var declaration = 0
                while (declaration < this.declarations.size) {
                    if (this.declarations[declaration].kind == "class" &&
                        this.declarations[declaration].name == expression.text) {
                        result = this.declarations[declaration].name
                    }
                    declaration = declaration + 1
                }
            }
        }
        result
    }

    fun staticSyntaxType(expression: BootstrapExpression): string =
        this.staticSyntaxTypeAt(expression, 0)

    fun typedCallIndex(expression: BootstrapExpression): int {
        var result = -1
        var index = 0
        while (result < 0 && index < this.typedCalls.size) {
            val candidate = this.typedCalls[index]
            if (candidate.begin == expression.begin &&
                candidate.end == expression.end &&
                candidate.kind == expression.kind &&
                candidate.name == expression.text) result = index
            index = index + 1
        }
        result
    }

    fun appendUniqueName(var names: array<string>, name: string): void {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        if (!found) names.append(name)
    }

    fun nameIsBound(names: array<string>, name: string): bool {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun collectLambdaFreeNames(
        expression: BootstrapExpression,
        bound: array<string>,
        var free: array<string>
    ): void {
        var nested = false
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            nested = true
            val nestedBound: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nestedBound.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                this.appendUniqueName(
                    nestedBound,
                    expression.children[parameter].text
                )
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaFreeNames(body, nestedBound, free)
        }
        if (!nested) {
            if (expression.kind == "identifier" &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            if ((expression.kind == "call" ||
                 expression.kind == "assign") &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            if (expression.kind == "block") {
                val scoped = bootstrapCopyBoundNames(bound)
                var child = 0
                while (child < expression.children.size) {
                    val statement = expression.children[child]
                    this.collectLambdaFreeNames(statement, scoped, free)
                    if (bootstrapStatementDeclaresLocal(statement)) {
                        scoped.append(statement.text)
                    }
                    child = child + 1
                }
            } else {
                var child = 0
                while (child < expression.children.size) {
                    this.collectLambdaFreeNames(
                        expression.children[child],
                        bound,
                        free
                    )
                    child = child + 1
                }
            }
        }
    }

    fun declarationIndexByName(name: string): int {
        var result = -1
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].name == name) {
                result = declaration
            }
            declaration = declaration + 1
        }
        result
    }

    fun nameArrayContains(values: array<string>, value: string): bool {
        var found = false
        var index = 0
        while (index < values.size) {
            if (values[index] == value) found = true
            index = index + 1
        }
        found
    }

    fun intArrayContains(values: array<int>, value: int): bool {
        var found = false
        var index = 0
        while (index < values.size) {
            if (values[index] == value) found = true
            index = index + 1
        }
        found
    }

    fun intArrayAppendUnique(var values: array<int>, value: int): void {
        if (!this.intArrayContains(values, value)) values.append(value)
    }

    fun sliceCollectReferencedDeclarations(
        expression: BootstrapExpression,
        var bound: array<string>,
        var references: array<int>
    ): void {
        var processChildren = true
        if (expression.kind == "local.val" ||
            expression.kind == "local.var") {
            processChildren = false
            if (expression.children.size > 0) {
                this.sliceCollectReferencedDeclarations(
                    expression.children[0],
                    bound,
                    references
                )
                if (expression.children.size > 1) {
                    this.sliceCollectReferencedDeclarations(
                        expression.children[1],
                        bound,
                        references
                    )
                }
            }
            this.appendUniqueName(bound, expression.text)
        }
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            processChildren = false
            val nested: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nested.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                nested.append(expression.children[parameter].text)
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.sliceCollectReferencedDeclarations(body, nested, references)
        }
        if ((expression.kind == "identifier" &&
             !this.nameIsBound(bound, expression.text)) ||
            (expression.kind == "call" &&
             !this.nameIsBound(bound, expression.text)) ||
            (expression.kind == "assign" &&
             !this.nameIsBound(bound, expression.text))) {
            val declaration = this.declarationIndexByName(expression.text)
            if (declaration >= 0 && declaration < this.declarations.size) {
                this.intArrayAppendUnique(
                    references,
                    declaration
                )
            }
        }
        if (processChildren && expression.kind == "block") {
            // A block's locals stay bound to its end only.
            val scoped = bootstrapCopyBoundNames(bound)
            var child = 0
            while (child < expression.children.size) {
                this.sliceCollectReferencedDeclarations(
                    expression.children[child],
                    scoped,
                    references
                )
                child = child + 1
            }
        } else if (processChildren) {
            var child = 0
            while (child < expression.children.size) {
                this.sliceCollectReferencedDeclarations(
                    expression.children[child],
                    bound,
                    references
                )
                child = child + 1
            }
        }
    }

    fun slicePathFromReachableUnsupported(
        declaration: int,
        var seen: array<int>,
        path: string
    ): string {
        var result = ""
        if (declaration >= 0 && declaration < this.declarations.size &&
            !this.intArrayContains(seen, declaration)) {
            seen.append(declaration)
            val root = this.declarations[declaration]
            if (root.kind == "var" ||
                (root.kind == "val" &&
                 root.expression.kind != "compile")) result = path
            val references: array<int> = []
            var bound: array<string> = []
            if (result == "" &&
                (root.kind == "fun" || root.kind == "compile.fun")) {
                var parameter = 0
                while (parameter < root.parameters.size) {
                    bound.append(root.parameters[parameter])
                    parameter = parameter + 1
                }
            }
            if (result == "" &&
                (root.kind == "fun" || root.kind == "compile.fun" ||
                 root.kind == "val")) {
                this.sliceCollectReferencedDeclarations(
                    root.expression,
                    bound,
                    references
                )
            }
            var dependency = 0
            while (result == "" && dependency < references.size) {
                val handle = references[dependency]
                result = this.slicePathFromReachableUnsupported(
                    handle,
                    seen,
                    "$path -> ${this.declarations[handle].name}"
                )
                dependency = dependency + 1
            }
        }
        result
    }

    fun lambdaMutatesCapturedPlace(
        expression: BootstrapExpression,
        bound: array<string>
    ): bool {
        var mutates = false
        if (expression.kind == "assign" &&
            !this.nameIsBound(bound, expression.text) &&
            (this.find(expression.text) >= 0 ||
             this.find("this") >= 0)) mutates = true
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.nameIsBound(bound, root) &&
                this.find(root) >= 0) mutates = true
        }
        if (expression.kind == "call" &&
            !this.nameIsBound(bound, expression.text)) {
            val target = this.find(expression.text)
            if (target >= 0 && this.values[target].kind == "closure" &&
                this.values[target].owner == "mut") mutates = true
        }
        if (expression.kind == "block") {
            val scoped = bootstrapCopyBoundNames(bound)
            var child = 0
            while (!mutates && child < expression.children.size) {
                val statement = expression.children[child]
                mutates = this.lambdaMutatesCapturedPlace(statement, scoped)
                if (bootstrapStatementDeclaresLocal(statement)) {
                    scoped.append(statement.text)
                }
                child = child + 1
            }
        } else if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (!mutates && child < expression.children.size) {
                mutates = this.lambdaMutatesCapturedPlace(
                    expression.children[child],
                    bound
                )
                child = child + 1
            }
        }
        mutates
    }

    fun lambdaRequiresMutableCall(
        expression: BootstrapExpression
    ): bool {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        this.lambdaMutatesCapturedPlace(body, bound)
    }

    fun evaluateCall(expression: BootstrapExpression): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        var targetName = expression.text
        val target = this.find(expression.text)
        var callable = bootstrapEvalInvalid()
        if (target >= 0) callable = this.values[target]
        if (target < 0) callable = bootstrapEvalGlobalCallable(this, expression.text)
        if (callable.kind == "function") targetName = callable.text
        if (callable.kind == "closure") {
            result = bootstrapEvaluateClosureCall(
                this, expression, callable, target
            )
        }
        result = bootstrapEvaluateIntrinsicCall(
            this, expression, targetName, result
        )
        var declarationIndexNode = this.firstNamed(targetName)
        while (result.kind == "invalid" &&
               declarationIndexNode >= 0) {
            val declarationIndex = this.namedDeclaration(declarationIndexNode)
            val declaration = this.declarations[declarationIndex]
            if (declaration.kind == "class" &&
                declaration.name == targetName) {
                result = bootstrapEvaluateConstruction(
                    this, expression, declaration
                )
            }
            if (declaration.name == targetName &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner == "") {
                val callNames: array<string> = []
                val callValues: array<BootstrapEvalValue> = []
                val callMutable: array<bool> = []
                var argument = 0
                while (argument < declaration.parameters.size) {
                    // A default sees the parameters bound before it: the name
                    // joins once its value is there (bootstrapEvalDefaultArgument).
                    if (argument < expression.children.size) {
                        callValues.append(this.evaluate(
                            expression.children[argument]
                        ))
                        argument = argument
                    } else if (argument < declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[argument].kind !=
                            "missing") {
                        callValues.append(bootstrapEvalDefaultArgument(
                            this,
                            declaration.parameterDefaults[argument],
                            callNames,
                            callValues,
                            callMutable
                        ))
                    } else {
                        callValues.append(bootstrapEvalInvalid())
                        this.errors = this.errors + 1
                    }
                    callNames.append(declaration.parameters[argument])
                    callMutable.append(false)
                    argument = argument + 1
                }
                val invocation = bootstrapEvalInvocation(
                    this, callNames, callValues, callMutable
                )
                result = bootstrapEvaluateFrom(
                    invocation, declaration.sourceIdentity, declaration.expression
                )
                if (result.kind == "return" && result.elements.size == 1) {
                    result = result.elements[0]
                }
                invocation.dropOwnedParameters(
                    declaration.parameterKinds,
                    result,
                    0
                )
                this.errors = invocation.errors
                this.steps = invocation.steps
                this.diagnostics = invocation.diagnostics
            }
            declarationIndexNode = this.nextNamed(declarationIndexNode)
        }
        if (result.kind == "invalid") this.errors = this.errors + 1
        result
    }

    fun evaluateMethod(
        receiver: BootstrapEvalValue,
        expression: BootstrapExpression
    ): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        var receiverType = receiver.owner
        if (receiver.kind == "string") receiverType = "string"
        if (receiver.kind == "integer") receiverType = "i64"
        if (receiver.kind == "boolean") receiverType = "bool"
        if (receiver.owner == "Compiler") {
            var target = ""
            if (expression.text == "functions") {
                target = "compilerFunctions"
            }
            if (expression.text == "functionsAnnotated") {
                target = "compilerFunctionsAnnotated"
            }
            if (expression.text == "findFunction") {
                target = "compilerFindFunction"
            }
            if (expression.text == "functionName") {
                target = "compilerFunctionName"
            }
            if (expression.text == "functionIdentity") {
                target = "compilerFunctionCanonicalIdentity"
            }
            if (expression.text == "functionModuleIdentity") {
                target = "compilerFunctionModuleIdentity"
            }
            if (expression.text == "functionOwner") {
                target = "compilerFunctionOwner"
            }
            if (expression.text == "parameterCount") {
                target = "compilerFunctionParameterCount"
            }
            if (expression.text == "parameterName") {
                target = "compilerFunctionParameterName"
            }
            if (expression.text == "parameterType") {
                target = "compilerFunctionParameterType"
            }
            if (expression.text == "resultType") {
                target = "compilerFunctionResultType"
            }
            if (expression.text == "annotationCount") {
                target = "compilerFunctionAnnotationCount"
            }
            if (expression.text == "annotation") {
                target = "compilerFunctionAnnotation"
            }
            if (expression.text == "isCompileOnly") {
                target = "compilerFunctionIsCompileOnly"
            }
            if (expression.text == "isTrusted") {
                target = "compilerFunctionIsTrusted"
            }
            if (expression.text == "isExternal") {
                target = "compilerFunctionIsExternal"
            }
            if (expression.text == "replaceFunctionBody") {
                target = "compilerReplaceFunctionBody"
            }
            if (expression.text == "addFunctionAnnotation") {
                target = "compilerAddFunctionAnnotation"
            }
            if (expression.text == "generateModule") {
                target = "compilerGenerateModule"
            }
            if (expression.text == "writeFile") {
                target = "compilerWriteFile"
            }
            if (expression.text == "buildProgram") {
                target = "compilerBuildProgram"
            }
            if (expression.text == "defineTarget") {
                target = "compilerDefineTarget"
            }
            if (expression.text == "contributeArtifactRoot") {
                target = "compilerContributeArtifactRoot"
            }
            if (expression.text == "exportFunction") {
                target = "compilerExportFunction"
            }
            if (expression.text == "internalFunction") {
                target = "compilerInternalFunction"
            }
            if (expression.text == "requiredInternalFunction") {
                target = "compilerRequiredInternalFunction"
            }
            if (expression.text == "exportCheckedFunction") {
                target = "compilerExportCheckedFunction"
            }
            if (target != "") {
                val arguments: array<BootstrapExpression> = []
                var argument = 1
                while (argument < expression.children.size) {
                    arguments.append(expression.children[argument])
                    argument = argument + 1
                }
                result = this.evaluateCall(BootstrapExpression(
                    "call",
                    target,
                    expression.begin,
                    expression.end,
                    arguments
                ))
            }
        }
        var declarationIndex = 0
        while (result.kind == "invalid" &&
               declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner == receiverType &&
                declaration.name == expression.text) {
                val extensionNames: array<string> = ["this"]
                val extensionValues: array<BootstrapEvalValue> = [receiver]
                val extensionMutable: array<bool> = [false]
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter + 1 < expression.children.size) {
                        extensionValues.append(this.evaluate(
                            expression.children[parameter + 1]
                        ))
                    } else if (parameter <
                            declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[parameter].kind !=
                            "missing") {
                        val defaults = BootstrapEvaluator(
                            this.declarations,
                            this.affineTypes,
                            this.context,
                            extensionNames,
                            extensionValues,
                            extensionMutable,
                            this.cursors,
                            this.syntax,
                            this.typedCalls,
                            this.reflectedTypes,
                            this.generatedDeclarations,
                            this.extensionRequests,
                            this.compileInputPaths,
                            this.compileInputContents,
                            this.globalKeys,
                            this.globalValues,
                            this.allowedCompileEffects,
                            this.errors,
                            this.steps,
                            this.diagnostics
                        )
                        extensionValues.append(defaults.evaluate(
                            declaration.parameterDefaults[parameter]
                        ))
                        this.errors = defaults.errors
                        this.steps = defaults.steps
                        this.diagnostics = defaults.diagnostics
                    } else {
                        extensionValues.append(bootstrapEvalInvalid())
                        this.errors = this.errors + 1
                    }
                    extensionNames.append(declaration.parameters[parameter])
                    extensionMutable.append(false)
                    parameter = parameter + 1
                }
                val invocation = BootstrapEvaluator(
                    this.declarations,
                    this.affineTypes,
                    this.context,
                    extensionNames,
                    extensionValues,
                    extensionMutable,
                    this.cursors,
                    this.syntax,
                    this.typedCalls,
                    this.reflectedTypes,
                    this.generatedDeclarations,
                    this.extensionRequests,
                    this.compileInputPaths,
                    this.compileInputContents,
                    this.globalKeys,
                    this.globalValues,
                    this.allowedCompileEffects,
                    this.errors,
                    this.steps,
                    this.diagnostics
                )
                result = bootstrapEvaluateFrom(
                    invocation, declaration.sourceIdentity, declaration.expression
                )
                if (result.kind == "return" && result.elements.size == 1) {
                    result = result.elements[0]
                }
                invocation.dropOwnedParameters(
                    declaration.parameterKinds,
                    result,
                    1
                )
                this.errors = invocation.errors
                this.steps = invocation.steps
                this.diagnostics = invocation.diagnostics
            }
            if (declaration.kind == "class" &&
                declaration.name == receiver.owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val method = declaration.methods[methodIndex]
                    if (method.name == expression.text) {
                        val methodNames: array<string> = ["this"]
                        val methodValues: array<BootstrapEvalValue> = [receiver]
                        val methodMutable: array<bool> = [false]
                        var parameter = 0
                        while (parameter < method.parameters.size) {
                            if (parameter + 1 < expression.children.size) {
                                methodValues.append(this.evaluate(
                                    expression.children[parameter + 1]
                                ))
                                this.steps = this.steps
                            } else if (parameter <
                                    method.parameterDefaults.size &&
                                method.parameterDefaults[parameter].kind !=
                                    "missing") {
                                val defaults = BootstrapEvaluator(
                                    this.declarations,
                                    this.affineTypes,
                                    this.context,
                                    methodNames,
                                    methodValues,
                                    methodMutable,
                                    this.cursors,
                                    this.syntax,
                                    this.typedCalls,
                                    this.reflectedTypes,
                                    this.generatedDeclarations,
                                    this.extensionRequests,
                                    this.compileInputPaths,
                                    this.compileInputContents,
                                    this.globalKeys,
                                    this.globalValues,
                                    this.allowedCompileEffects,
                                    this.errors,
                                    this.steps,
                                    this.diagnostics
                                )
                                methodValues.append(defaults.evaluate(
                                    method.parameterDefaults[parameter]
                                ))
                                this.errors = defaults.errors
                                this.steps = defaults.steps
                                this.diagnostics = defaults.diagnostics
                            } else {
                                methodValues.append(bootstrapEvalInvalid())
                                this.errors = this.errors + 1
                            }
                            methodNames.append(method.parameters[parameter])
                            methodMutable.append(false)
                            parameter = parameter + 1
                        }
                        val invocation = BootstrapEvaluator(
                            this.declarations,
                            this.affineTypes,
                            this.context,
                            methodNames,
                            methodValues,
                            methodMutable,
                        this.cursors,
                        this.syntax,
                        this.typedCalls,
                        this.reflectedTypes,
                        this.generatedDeclarations,
                        this.extensionRequests,
                            this.compileInputPaths,
                            this.compileInputContents,
                            this.globalKeys,
                            this.globalValues,
                            this.allowedCompileEffects,
                            this.errors,
                            this.steps,
                            this.diagnostics
                        )
                        result = bootstrapEvaluateFrom(
                            invocation,
                            if (method.sourceIdentity != "") method.sourceIdentity
                            else declaration.sourceIdentity,
                            method.expression
                        )
                        if (result.kind == "return" &&
                            result.elements.size == 1) {
                            result = result.elements[0]
                        }
                        invocation.dropOwnedParameters(
                            method.parameterKinds,
                            result,
                            1
                        )
                        this.errors = invocation.errors
                        this.steps = invocation.steps
                        this.diagnostics = invocation.diagnostics
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        if (result.kind == "invalid") this.errors = this.errors + 1
        result
    }

    fun evaluateMapCall(
        map: BootstrapEvalValue,
        expression: BootstrapExpression
    ): BootstrapEvalValue {
        val keys = map.elements[0]
        val values = map.elements[1]
        val method = expression.text
        val key = if (expression.children.size > 1) {
            bootstrapEvalUnwrapBorrow(this.evaluate(expression.children[1]))
        } else bootstrapEvalNull()
        var entry = -1
        var index = 0
        while (expression.children.size > 1 && entry < 0 &&
            index < keys.elements.size) {
            if (bootstrapEvalEqual(keys.elements[index], key)) entry = index
            index = index + 1
        }
        var result = bootstrapEvalVoid()
        if (method == "get") {
            result = if (entry >= 0) values.elements[entry] else bootstrapEvalNull()
        } else if (method == "has") {
            result = bootstrapEvalBoolean(entry >= 0)
        } else if (method == "set" && expression.children.size == 3) {
            val value = this.evaluate(expression.children[2])
            if (entry >= 0) values.elements[entry] = value
            else {
                keys.elements.append(key)
                values.elements.append(value)
            }
        } else if (method == "remove") {
            if (entry >= 0) {
                var shift = entry
                while (shift + 1 < keys.elements.size) {
                    keys.elements[shift] = keys.elements[shift + 1]
                    values.elements[shift] = values.elements[shift + 1]
                    shift = shift + 1
                }
                keys.elements.truncate(keys.elements.size - 1)
                values.elements.truncate(values.elements.size - 1)
            }
            result = bootstrapEvalBoolean(entry >= 0)
        } else if (method == "keys" || method == "values") {
            val source = if (method == "keys") keys else values
            val copy: array<BootstrapEvalValue> = []
            var element = 0
            while (element < source.elements.size) {
                copy.append(source.elements[element])
                element = element + 1
            }
            result = bootstrapEvalArray(copy)
        } else if (method == "clear") {
            keys.elements.truncate(0)
            values.elements.truncate(0)
        } else {
            this.errors = this.errors + 1
            result = bootstrapEvalInvalid()
        }
        result
    }

    fun evaluate(expression: BootstrapExpression): BootstrapEvalValue {
        val errorsBefore = this.errors
        val diagnosticsBefore = this.diagnostics.size
        this.steps = this.steps + 1
        if (this.steps > this.context.stepLimit) {
            // Past the limit nothing is evaluated: a loop the limit cut short
            // leaves values no later code expects (a slice out of range).
            bootstrapEvalStepLimitReached(this)
            return bootstrapEvalInvalid()
        }
        // The cases are @noinline functions of their own, so a nested
        // evaluation holds a small frame per level, not every case's locals.
        val form = bootstrapEvalCase(expression)
        var result = when (form) {
            1 -> bootstrapEvaluateInteger(this, expression)
            2 -> bootstrapEvalBoolean(expression.kind == "true")
            3 -> bootstrapEvalString(expression.text)
            8 -> bootstrapEvaluateIdentifier(this, expression)
            15 -> this.evaluateCall(expression)
            16 -> this.evaluate(expression.children[0])
            17 -> this.evaluate(expression.children[0])
            21 -> bootstrapEvaluateTemplate(this, expression)
            22 -> bootstrapEvaluateBlock(this, expression)
            24 -> bootstrapEvaluateReturn(this, expression)
            26 -> bootstrapEvaluateLocal(this, expression)
            27 -> bootstrapEvaluateAssign(this, expression)
            30 -> bootstrapEvaluateArrayLiteral(this, expression)
            32 -> bootstrapEvaluateMember(this, expression)
            34 -> bootstrapEvaluateIndex(this, expression)
            36 -> bootstrapEvaluateMemberCall(this, expression)
            41 -> bootstrapEvaluateArithmetic(this, expression)
            43 -> bootstrapEvaluateEquality(this, expression)
            44 -> bootstrapEvaluateComparison(this, expression)
            45 -> bootstrapEvaluateAnd(this, expression)
            46 -> bootstrapEvaluateOr(this, expression)
            47 -> bootstrapEvaluateIf(this, expression)
            48 -> bootstrapEvaluateWhen(this, expression)
            49 -> bootstrapEvaluateWhile(this, expression)
            51 -> bootstrapEvaluateFor(this, expression)
            else -> bootstrapEvaluateUncommon(this, expression, form)
        }
        if (this.errors > errorsBefore &&
            this.diagnostics.size == diagnosticsBefore) {
            bootstrapEvalExpressionFailed(this, expression)
        }
        result
    }
}

// The compiler's builtins, by family: each family's cases (and their locals)
// live in a frame of their own, entered only for a name of that family.
@noinline
fun bootstrapEvaluateIntrinsicCall(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName.startsWith("__abla") ||
        targetName.startsWith("git") ||
        targetName.startsWith("import") ||
        targetName.startsWith("resolved")) {
        result = bootstrapEvaluateCallImports(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("compiler") ||
        targetName.startsWith("typed")) {
        result = bootstrapEvaluateCallReflection(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("abla") ||
        targetName.startsWith("runtime")) {
        result = bootstrapEvaluateCallText(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("compiler")) {
        result = bootstrapEvaluateCallCompiler(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("abla") ||
        targetName.startsWith("compiler")) {
        result = bootstrapEvaluateCallHost(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("parser")) {
        result = bootstrapEvaluateCallParser(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("syntax")) {
        result = bootstrapEvaluateCallSyntax(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("compilerGenerated")) {
        result = bootstrapEvaluateCallGenerated(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("typed")) {
        result = bootstrapEvaluateCallTyped(
            evaluator, expression, targetName, result
        )
    }
    result
}

@noinline
fun bootstrapEvalGlobalCallable(
    var evaluator: BootstrapEvaluator,
    name: string
): BootstrapEvalValue {
    var callable = bootstrapEvalInvalid()
    var globalNode = evaluator.firstNamed(name)
    while (callable.kind == "invalid" &&
           globalNode >= 0) {
        val global = evaluator.namedDeclaration(globalNode)
        val declaration = evaluator.declarations[global]
        if (bootstrapDeclarationIsValue(declaration.kind) &&
            declaration.name == name) {
            callable = bootstrapEvaluateFrom(
                evaluator, declaration.sourceIdentity, declaration.expression
            )
        }
        globalNode = evaluator.nextNamed(globalNode)
    }
    callable
}

@noinline
fun bootstrapEvaluateConstruction(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    declaration: BootstrapDeclaration
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val fields: array<BootstrapEvalValue> = []
    val fieldNames: array<string> = []
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        var value = bootstrapEvalInvalid()
        if (parameter < expression.children.size) {
            value = evaluator.evaluate(expression.children[parameter])
        } else if (parameter < declaration.parameterDefaults.size &&
            declaration.parameterDefaults[parameter].kind !=
                "missing") {
            value = evaluator.evaluate(
                declaration.parameterDefaults[parameter]
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            value = value
        }
        if (parameter < declaration.parameterKinds.size &&
            (declaration.parameterKinds[parameter] == "val" ||
             declaration.parameterKinds[parameter] == "var")) {
            fieldNames.append(declaration.parameters[parameter])
            fields.append(value)
        }
        parameter = parameter + 1
    }
    result = bootstrapEvalObject(
        declaration.name,
        fieldNames,
        fields
    )
    result
}

/** An evaluator for a call's body: the caller's declarations and shared
 *  state, the callee's bindings, and the caller's error and step counts. */
@noinline
fun bootstrapEvalInvocation(
    var evaluator: BootstrapEvaluator,
    names: array<string>,
    values: array<BootstrapEvalValue>,
    mutable: array<bool>
): BootstrapEvaluator = BootstrapEvaluator(
    evaluator.declarations,
    evaluator.affineTypes,
    evaluator.context,
    names,
    values,
    mutable,
    evaluator.cursors,
    evaluator.syntax,
    evaluator.typedCalls,
    evaluator.reflectedTypes,
    evaluator.generatedDeclarations,
    evaluator.extensionRequests,
    evaluator.compileInputPaths,
    evaluator.compileInputContents,
    evaluator.globalKeys,
    evaluator.globalValues,
    evaluator.allowedCompileEffects,
    evaluator.errors,
    evaluator.steps,
    evaluator.diagnostics
)

/** A default argument, evaluated with the parameters bound before it. */
@noinline
fun bootstrapEvalDefaultArgument(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    names: array<string>,
    values: array<BootstrapEvalValue>,
    mutable: array<bool>
): BootstrapEvalValue {
    val defaults = bootstrapEvalInvocation(evaluator, names, values, mutable)
    val value = defaults.evaluate(expression)
    evaluator.errors = defaults.errors
    evaluator.steps = defaults.steps
    evaluator.diagnostics = defaults.diagnostics
    value
}

// The evaluator's diagnostics are built apart from `evaluate`, whose frame
// every level of a nested evaluation holds.
@noinline
fun bootstrapEvalStepLimitReached(var evaluator: BootstrapEvaluator): void {
    val stepLimit = evaluator.context.stepLimit
    evaluator.errors = evaluator.errors + 1
    if (evaluator.steps == stepLimit + 1) {
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_STEP_LIMIT",
            "compile-time evaluation ran past $stepLimit steps (an endless loop?)"
        )
    }
}

@noinline
fun bootstrapEvalExpressionFailed(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): void {
    var source = ""
    var slot = evaluator.names.size
    while (source == "" && slot > 0) {
        slot = slot - 1
        if (evaluator.names[slot] == "#source" &&
            evaluator.values[slot].kind == "string") source = evaluator.values[slot].text
    }
    if (source == "") {
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_EXPRESSION",
            "compile-time evaluation failed while evaluating `${expression.kind}` `${expression.text}` at ${expression.begin}:${expression.end}"
        )
    } else {
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_EXPRESSION",
            "compile-time evaluation failed while evaluating `${expression.kind}` `${expression.text}`"
        )
        evaluator.diagnostics =
            "${evaluator.diagnostics}source[eval]:$source:${expression.begin}:${expression.end}\n"
    }
}

// Evaluates a declaration's body as code of the source it came from: a local
// the code can't name (`#source`) holds the path an evaluation failure names.
@noinline
fun bootstrapEvaluateFrom(
    var evaluator: BootstrapEvaluator,
    source: string,
    expression: BootstrapExpression
): BootstrapEvalValue {
    if (source == "") return evaluator.evaluate(expression)
    val slot = evaluator.names.size
    evaluator.names.append("#source")
    evaluator.values.append(bootstrapEvalString(source))
    evaluator.mutable.append(false)
    val result = evaluator.evaluate(expression)
    evaluator.names[slot] = ""
    evaluator.values[slot] = evaluator.uninitializedValue()
    result
}

// A program global (`val` / `var`) read by compile-time code: like a `compile val`,
// one value for the whole compilation, so what compile-time code changes through
// it or assigns to it is what every later evaluation reads, as within one run of
// the program. The program itself starts from its own initializer; nothing leaks
// into it. The program initializes its globals before anything changes them, so
// an initializer here reads the others' initial values (`initial:` keys), not
// what the evaluation has changed since: a global first read after another was
// assigned still starts where the program's does.
fun bootstrapRuntimeGlobalKey(declaration: BootstrapDeclaration): string =
    "runtime:${bootstrapCompileGlobalKey(declaration)}"

fun bootstrapEvalGlobalSlot(evaluator: BootstrapEvaluator, key: string): int {
    var index = 0
    while (index < evaluator.globalKeys.size) {
        if (evaluator.globalKeys[index] == key) return index
        index = index + 1
    }
    -1
}

@noinline
fun bootstrapRuntimeGlobal(
    var evaluator: BootstrapEvaluator,
    declaration: BootstrapDeclaration
): BootstrapEvalValue {
    var initializing = false
    var binding = evaluator.names.size
    while (!initializing && binding > 0) {
        binding = binding - 1
        if (evaluator.names[binding] == "#initial") initializing = true
    }
    val key = if (initializing) "initial:${bootstrapCompileGlobalKey(declaration)}"
        else bootstrapRuntimeGlobalKey(declaration)
    val slot = bootstrapEvalGlobalSlot(evaluator, key)
    if (slot >= 0) return evaluator.globalValues[slot]
    var value = bootstrapCompileGlobalLoad(key)
    if (value.kind == "invalid" && !initializing) {
        value = bootstrapRuntimeGlobalInitial(evaluator, declaration)
    } else if (value.kind == "invalid") {
        // In a scope of its own: the initializer sees globals, not the locals
        // of the code that first read it.
        var initializer = bootstrapEvalInvocation(
            evaluator, ["#initial"], [bootstrapEvalVoid()], [false]
        )
        value = bootstrapEvaluateFrom(
            initializer, declaration.sourceIdentity, declaration.expression
        )
        evaluator.errors = initializer.errors
        evaluator.steps = initializer.steps
        evaluator.diagnostics = initializer.diagnostics
    }
    evaluator.globalKeys.append(key)
    evaluator.globalValues.append(value)
    value
}

// A global's initial value: its initializer, reading the initial values of
// the globals it names. The live value starts as this same value (an object
// stays one object, whichever way it is reached).
fun bootstrapRuntimeGlobalInitial(
    var evaluator: BootstrapEvaluator,
    declaration: BootstrapDeclaration
): BootstrapEvalValue {
    var initializer = bootstrapEvalInvocation(
        evaluator, ["#initial"], [bootstrapEvalVoid()], [false]
    )
    val value = bootstrapRuntimeGlobal(initializer, declaration)
    evaluator.errors = initializer.errors
    evaluator.steps = initializer.steps
    evaluator.diagnostics = initializer.diagnostics
    value
}

/** The program `var` global named `name`, -1 none. */
fun bootstrapRuntimeVar(evaluator: BootstrapEvaluator, name: string): int {
    var result = -1
    var index = 0
    while (index < evaluator.declarations.size) {
        if (evaluator.declarations[index].kind == "var" &&
            evaluator.declarations[index].name == name) result = index
        index = index + 1
    }
    result
}

// A failed `#` expression of the program: its diagnostics, counted as one error
// per `error[` line (bootstrapDiagnosedLoweringErrors).
fun bootstrapStageEvaluationFailure(diagnostics: string): void {
    var text = diagnostics
    if (text == "") {
        text = "error[E_EVAL_EXPRESSION]: compile-time evaluation failed\n"
    }
    var lines = 0
    var index = 0
    while (index + 6 <= text.size) {
        if ((index == 0 || text[index - 1] == 10) &&
            text.slice(index, index + 6) == "error[") lines = lines + 1
        index = index + 1
    }
    if (lines == 0) {
        text = "error[E_EVAL_EXPRESSION]: compile-time evaluation failed\n$text"
        lines = 1
    }
    bootstrapStageDriverDiagnostic(text)
    bootstrapNoteDiagnosedLoweringErrors(lines)
    return
}

// The kinds `evaluate` dispatches through here are the ones that rarely nest
// deeply; each case `evaluate` handles itself costs its frame a few slots.
@noinline
fun bootstrapEvaluateUncommon(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    form: int
): BootstrapEvalValue = when (form) {
    4 -> bootstrapEvaluateDeclarationBlock(evaluator, expression)
    5 -> bootstrapEvalNull()
    6 -> bootstrapEvaluateDelegateInitializer(evaluator, expression)
    7 -> bootstrapEvaluateLambda(evaluator, expression)
    9 -> bootstrapEvaluateMove(evaluator, expression)
    10 -> bootstrapEvaluateCallShared(evaluator, expression)
    11 -> bootstrapEvaluateCallMutex(evaluator, expression)
    // A compile-time map: its keys and values in insertion order.
    12 -> bootstrapEvaluateCallMap(evaluator, expression)
    13 -> bootstrapEvaluateCallCell(evaluator, expression)
    14 -> bootstrapEvaluateFilledArray(evaluator, expression)
    18 -> bootstrapEvaluateTask(evaluator, expression)
    19 -> bootstrapEvaluateAwait(evaluator, expression)
    20 -> bootstrapEvaluateGenerator(evaluator, expression)
    23 -> bootstrapEvalVoid()
    25 -> bootstrapEvalLoopControl(expression.kind)
    28 -> bootstrapEvaluateDelegateProject(evaluator, expression)
    29 -> bootstrapEvaluateDelegateAssign(evaluator, expression)
    31 -> bootstrapEvaluateRange(evaluator, expression)
    33 -> bootstrapEvaluateMemberAssign(evaluator, expression)
    35 -> bootstrapEvaluateIndexAssign(evaluator, expression)
    37 -> bootstrapEvaluateNegate(evaluator, expression)
    38 -> bootstrapEvalF64(f64Parse(expression.text))
    39 -> bootstrapEvaluateNot(evaluator, expression)
    40 -> bootstrapEvaluateComplement(evaluator, expression)
    42 -> bootstrapEvaluateBitwise(evaluator, expression)
    50 -> bootstrapEvaluateDoWhile(evaluator, expression)
    else -> bootstrapEvalInvalid()
}

/** Which case of BootstrapEvaluator.evaluate handles `expression`: one
 *  test of its kind (and a call's name) here keeps the comparisons out
 *  of the evaluator's recursive frames. 0: none. */
@noinline
fun bootstrapEvalCase(expression: BootstrapExpression): int {
    if (expression.kind == "integer") return 1
    if (expression.kind == "true" || expression.kind == "false") return 2
    if (expression.kind == "string") return 3
    if (expression.kind == "declaration.block") return 4
    if (expression.kind == "null") return 5
    if (expression.kind == "delegate.initializer" &&
        expression.children.size > 0) return 6
    if (expression.kind == "lambda" ||
        expression.kind == "lambda.move") return 7
    if (expression.kind == "identifier") return 8
    if (expression.kind == "call" && expression.text == "move") return 9
    if (expression.kind == "call" && expression.text == "Shared") return 10
    if (expression.kind == "call" && expression.text == "Mutex") return 11
    if (expression.kind == "call" && expression.text == "Map") return 12
    if (expression.kind == "call" && expression.text == "Cell") return 13
    if (expression.kind == "call" && expression.text == "filledArray") return 14
    if (expression.kind == "call" && expression.text != "move" &&
        expression.text != "Shared" && expression.text != "Mutex" &&
        expression.text != "Cell" && expression.text != "filledArray" &&
        expression.text != "Map") return 15
    if (expression.kind == "compile") return 16
    if (expression.kind == "region") return 17
    if ((expression.kind == "task" || expression.kind == "thread") &&
        expression.children.size == 1) return 18
    if (expression.kind == "await" && expression.children.size == 1) return 19
    if (expression.kind == "generator" || expression.kind == "yield") return 20
    if (expression.kind == "string.template") return 21
    if (expression.kind == "block") return 22
    if (expression.kind == "defer") return 23
    if (expression.kind == "return") return 24
    if (expression.kind == "break" || expression.kind == "continue") return 25
    if (expression.kind == "local.val" ||
        expression.kind == "local.var") return 26
    if (expression.kind == "assign") return 27
    if (expression.kind == "delegate.project" &&
        expression.children.size == 1 &&
        expression.children[0].kind == "identifier") return 28
    if (expression.kind == "delegate.assign" &&
        expression.children.size == 2 &&
        expression.children[0].kind == "identifier") return 29
    if (expression.kind == "array") return 30
    if (expression.kind == "range.closed" ||
        expression.kind == "range.until") return 31
    if (expression.kind == "member") return 32
    if (expression.kind == "member.assign") return 33
    if (expression.kind == "index") return 34
    if (expression.kind == "index.assign") return 35
    if (expression.kind == "member.call") return 36
    if (expression.kind == "unary-" || expression.kind == "unary+") return 37
    if (expression.kind == "float") return 38
    if (expression.kind == "unary!") return 39
    if (expression.kind == "unary~") return 40
    if (expression.kind == "+" || expression.kind == "-" ||
        expression.kind == "*" || expression.kind == "/" ||
        expression.kind == "%") return 41
    if (expression.kind == "&" || expression.kind == "|" ||
        expression.kind == "^" || expression.kind == "<<" ||
        expression.kind == ">>" || expression.kind == ">>>") return 42
    if (expression.kind == "==" || expression.kind == "!=") return 43
    if (expression.kind == "<" || expression.kind == "<=" ||
        expression.kind == ">" || expression.kind == ">=") return 44
    if (expression.kind == "&&") return 45
    if (expression.kind == "||") return 46
    if (expression.kind == "if") return 47
    if (expression.kind == "when") return 48
    if (expression.kind == "while") return 49
    if (expression.kind == "do.while") return 50
    if (expression.kind == "for") return 51
    0
}

@noinline
fun bootstrapEvaluateInteger(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var value = 0
    var index = 0
    // The parser writes a literal's value in decimal; 9223372036854775808 (the
    // magnitude of the smallest integer) wraps to text with a leading `-`.
    val negative = expression.text.size > 0 && expression.text[0] == 45
    if (negative) index = 1
    while (index < expression.text.size) {
        val byte = expression.text[index]
        if (byte != 95) {
            value = if (negative) value * 10 - (byte - 48)
                else value * 10 + byte - 48
        }
        index = index + 1
    }
    result = bootstrapEvalInteger(value)
    result
}

@noinline
fun bootstrapEvaluateDeclarationBlock(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var sourceIdentity = ""
    if (expression.children.size == 1 &&
        expression.children[0].kind == "declaration.block.source") {
        sourceIdentity = expression.children[0].text
    }
    result = BootstrapEvalValue(
        "declaration.block",
        0,
        false,
        expression.text,
        [],
        sourceIdentity,
        []
    )
    result
}

@noinline
fun bootstrapEvaluateDelegateInitializer(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    result = bootstrapEvalDelegate(
        evaluator.evaluate(expression.children[0]),
        expression.text == "var"
    )
    result
}

