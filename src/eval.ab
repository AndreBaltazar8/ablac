                }
            } else this.recordEvaluatorDiagnostic(
                "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
                "typed access reflection requires a resolved deferred expression"
            )
        }
        if (targetName == "typedFunctionReadCount" ||
            targetName == "typedFunctionRead" ||
            targetName == "typedFunctionWriteCount" ||
            targetName == "typedFunctionWrite" ||
            targetName == "typedFunctionReadsUnknown" ||
            targetName == "typedFunctionWritesUnknown") {
            val handle = this.evaluate(expression.children[0]).integer
            if (this.functionHandleValid(handle)) {
                val summary = this.accessSummaryForFunctionAt(
                    handle,
                    0,
                    []
                )
                if (targetName == "typedFunctionReadCount") {
                    result = bootstrapEvalInteger(summary.reads.size)
                }
                if (targetName == "typedFunctionWriteCount") {
                    result = bootstrapEvalInteger(summary.writes.size)
                }
                if (targetName == "typedFunctionReadsUnknown") {
                    result = bootstrapEvalBoolean(summary.readsUnknown)
                }
                if (targetName == "typedFunctionWritesUnknown") {
                    result = bootstrapEvalBoolean(summary.writesUnknown)
                }
                if (targetName == "typedFunctionRead" ||
                    targetName == "typedFunctionWrite") {
                    val index = this.evaluate(expression.children[1]).integer
                    val paths = if (targetName == "typedFunctionRead") {
                        summary.reads
                    } else summary.writes
                    if (index >= 0 && index < paths.size) {
                        result = this.accessPathValue(paths[index])
                    } else this.errors = this.errors + 1
                }
            } else this.recordInvalidFunctionHandle(targetName, handle)
        }
        if (targetName == "typedExpressionHasEffect") {
            val handle = this.evaluate(expression.children[0]).integer
            val effectName = this.evaluate(expression.children[1])
            if (handle >= 0 && handle < this.syntax.size &&
                this.typedCallIndex(this.syntax[handle]) >= 0 &&
                effectName.kind == "string") {
                val effect = bootstrapCompileEffectFromName(effectName.text)
                if (effect > 0) result = bootstrapEvalBoolean(
                    bootstrapCompileEffectHas(
                        this.accessExpressionEffectMask(this.syntax[handle]),
                        effect
                    )
                )
                else this.errors = this.errors + 1
            } else this.recordEvaluatorDiagnostic(
                "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
                "typed effect reflection requires a resolved deferred expression"
            )
        }
        if (targetName == "typedFunctionHasEffect") {
            val handle = this.evaluate(expression.children[0]).integer
            val effectName = this.evaluate(expression.children[1])
            if (this.functionHandleValid(handle) &&
                effectName.kind == "string") {
                val effect = bootstrapCompileEffectFromName(effectName.text)
                if (effect > 0) result = bootstrapEvalBoolean(
                    bootstrapCompileEffectHas(
                        this.accessFunctionEffectMask(handle),
                        effect
                    )
                )
                else this.errors = this.errors + 1
            } else this.recordInvalidFunctionHandle(targetName, handle)
        }
        if (targetName == "typedAccessRootKind" ||
            targetName == "typedAccessRootIdentity" ||
            targetName == "typedAccessRootParameter" ||
            targetName == "typedAccessSegmentCount" ||
            targetName == "typedAccessSegmentKind" ||
            targetName == "typedAccessSegmentName" ||
            targetName == "typedAccessSegmentIndex") {
            val path = this.evaluate(expression.children[0])
            if (path.kind == "typed.access.path") {
                if (targetName == "typedAccessRootKind") {
                    result = bootstrapEvalString(path.owner)
                }
                if (targetName == "typedAccessRootIdentity") {
                    result = bootstrapEvalString(path.text)
                }
                if (targetName == "typedAccessRootParameter") {
                    result = bootstrapEvalInteger(path.integer)
                }
                if (targetName == "typedAccessSegmentCount") {
                    result = bootstrapEvalInteger(path.elements.size)
                }
                if (targetName == "typedAccessSegmentKind" ||
                    targetName == "typedAccessSegmentName" ||
                    targetName == "typedAccessSegmentIndex") {
                    val index = this.evaluate(expression.children[1]).integer
                    if (index >= 0 && index < path.elements.size) {
                        val segment = path.elements[index]
                        if (targetName == "typedAccessSegmentKind") {
                            result = bootstrapEvalString(segment.owner)
                        }
                        if (targetName == "typedAccessSegmentName") {
                            result = bootstrapEvalString(segment.text)
                        }
                        if (targetName == "typedAccessSegmentIndex") {
                            result = bootstrapEvalInteger(segment.integer)
                        }
                    } else this.errors = this.errors + 1
                }
            } else this.recordEvaluatorDiagnostic(
                "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
                "typed access query received a stale or invalid path handle"
            )
        }
        if (targetName == "typedAccessPathsIntersect") {
            val left = this.evaluate(expression.children[0])
            val right = this.evaluate(expression.children[1])
            if (left.kind == "typed.access.path" &&
                right.kind == "typed.access.path") {
                result = bootstrapEvalBoolean(bootstrapAccessPathsIntersect(
                    this.accessValuePath(left),
                    this.accessValuePath(right)
                ))
            } else this.errors = this.errors + 1
        }
        if (targetName == "typedExpressionType" ||
            targetName == "typedExpressionKind") {
            val handle = this.evaluate(expression.children[0]).integer
            if (handle >= 0 && handle < this.syntax.size) {
                if (targetName == "typedExpressionType") {
                    val typed = this.typedCallIndex(this.syntax[handle])
                    if (typed >= 0) {
                        result = bootstrapEvalString(
                            this.typedCalls[typed].type
                        )
                    } else this.errors = this.errors + 1
                } else result = bootstrapEvalString(
                    this.syntax[handle].kind
                )
            } else this.errors = this.errors + 1
        }
        if (targetName == "typedCallTarget") {
            val handle = this.evaluate(expression.children[0]).integer
            if (handle >= 0 && handle < this.syntax.size) {
                val typed = this.typedCallIndex(this.syntax[handle])
                if (typed >= 0) {
                    result = bootstrapEvalInteger(this.typedCalls[typed].target)
                } else this.recordEvaluatorDiagnostic(
                    "E_EXT_TYPED_QUERY_BEFORE_RESOLUTION",
                    "compiler API `typedCallTarget` requires a resolved deferred expression"
                )
            } else this.recordEvaluatorDiagnostic(
                "E_EXT_EXPRESSION_HANDLE_INVALID",
                "compiler API `typedCallTarget` received invalid expression handle $handle"
            )
        }
        if (targetName == "typedCallArgumentType") {
            val handle = this.evaluate(expression.children[0]).integer
            val argument = this.evaluate(expression.children[1]).integer
            var typed = -1
            if (handle >= 0 && handle < this.syntax.size) {
                typed = this.typedCallIndex(this.syntax[handle])
            }
            if (typed >= 0 && argument >= 0 &&
                argument < this.typedCalls[typed].argumentTypes.size) {
                result = bootstrapEvalString(
                    this.typedCalls[typed].argumentTypes[argument]
                )
            } else this.errors = this.errors + 1
        }
        if (targetName == "typedCallArgumentCount") {
            val handle = this.evaluate(expression.children[0]).integer
            if (handle >= 0 && handle < this.syntax.size &&
                (this.syntax[handle].kind == "call" ||
                 this.syntax[handle].kind == "member.call")) {
                var count = this.syntax[handle].children.size
                if (this.syntax[handle].kind == "member.call") {
                    count = count - 1
                }
                result = bootstrapEvalInteger(count)
            } else this.errors = this.errors + 1
        }
        if (targetName == "typedCallArgument") {
            val handle = this.evaluate(expression.children[0]).integer
            val argument = this.evaluate(expression.children[1]).integer
            var offset = 0
            if (handle >= 0 && handle < this.syntax.size &&
                this.syntax[handle].kind == "member.call") offset = 1
            if (handle >= 0 && handle < this.syntax.size &&
                (this.syntax[handle].kind == "call" ||
                 this.syntax[handle].kind == "member.call") &&
                argument >= 0 &&
                argument + offset < this.syntax[handle].children.size) {
                val child = this.syntax[handle].children[argument + offset]
                result = this.syntaxValue(child)
            } else this.errors = this.errors + 1
        }
        if (targetName == "typedCallReceiverType") {
            val handle = this.evaluate(expression.children[0]).integer
            if (handle >= 0 && handle < this.syntax.size &&
                this.syntax[handle].kind == "member.call" &&
                this.syntax[handle].children.size > 0) {
                val typed = this.typedCallIndex(this.syntax[handle])
                if (typed >= 0) result = bootstrapEvalString(
                    this.typedCalls[typed].receiverType
                )
                else this.errors = this.errors + 1
            } else this.errors = this.errors + 1
        }
        if (targetName == "typedCallParameterTypeHandle" ||
            targetName == "typedCallResultTypeHandle" ||
            targetName == "typedCallArgumentParameter" ||
            targetName == "typedCallArgumentConversion" ||
            targetName == "typedCallInsertedDefaultCount" ||
            targetName == "typedCallParameterOwnership" ||
            targetName == "typedCallIsCompileOnly" ||
            targetName == "typedCallIsTrusted" ||
            targetName == "typedCallIsContract") {
            val syntaxHandle = this.evaluate(expression.children[0]).integer
            var typed = -1
            if (syntaxHandle >= 0 && syntaxHandle < this.syntax.size) {
                typed = this.typedCallIndex(this.syntax[syntaxHandle])
            }
            if (typed >= 0) {
                val call = this.typedCalls[typed]
                if (targetName == "typedCallResultTypeHandle") {
                    result = bootstrapEvalInteger(this.reflectedTypeHandle(
                        call.type
                    ))
                }
                if (targetName == "typedCallInsertedDefaultCount") {
                    result = bootstrapEvalInteger(call.insertedDefaults)
                }
                if (targetName == "typedCallIsCompileOnly") {
                    result = bootstrapEvalBoolean(call.isCompileOnly)
                }
                if (targetName == "typedCallIsTrusted") {
                    result = bootstrapEvalBoolean(call.isTrusted)
                }
                if (targetName == "typedCallIsContract") {
                    result = bootstrapEvalBoolean(call.isContract)
                }
                if (targetName == "typedCallParameterTypeHandle" ||
                    targetName == "typedCallArgumentParameter" ||
                    targetName == "typedCallArgumentConversion" ||
                    targetName == "typedCallParameterOwnership") {
                    val selected = this.evaluate(
                        expression.children[1]
                    ).integer
                    if (selected >= 0) {
                        if (targetName ==
                                "typedCallParameterTypeHandle" &&
                            selected < call.parameterTypes.size) {
                            result = bootstrapEvalInteger(
                                this.reflectedTypeHandle(
                                    call.parameterTypes[selected]
                                )
                            )
                        }
                        if (targetName == "typedCallArgumentParameter" &&
                            selected < call.argumentParameters.size) {
                            result = bootstrapEvalInteger(
                                call.argumentParameters[selected]
                            )
                        }
                        if (targetName == "typedCallArgumentConversion" &&
                            selected < call.argumentConversions.size) {
                            result = bootstrapEvalString(
                                call.argumentConversions[selected]
                            )
                        }
                        if (targetName ==
                                "typedCallParameterOwnership" &&
                            selected < call.parameterKinds.size) {
                            result = bootstrapEvalString(
                                call.parameterKinds[selected]
                            )
                        }
                        if (result.kind == "invalid") {
                            this.errors = this.errors + 1
                        }
                    } else this.errors = this.errors + 1
                }
            } else this.errors = this.errors + 1
        }
        var declarationIndex = 0
        while (result.kind == "invalid" &&
               declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if (declaration.kind == "class" &&
                declaration.name == targetName) {
                val fields: array<BootstrapEvalValue> = []
                val fieldNames: array<string> = []
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    var value = bootstrapEvalInvalid()
                    if (parameter < expression.children.size) {
                        value = this.evaluate(expression.children[parameter])
                    } else if (parameter < declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[parameter].kind !=
                            "missing") {
                        value = this.evaluate(
                            declaration.parameterDefaults[parameter]
                        )
                    } else {
                        this.errors = this.errors + 1
                        value = value
                    }
                    if (parameter < declaration.parameterKinds.size &&
                        (declaration.parameterKinds[parameter] == "val" ||
                         declaration.parameterKinds[parameter] == "var")) {
                        fieldNames.append(declaration.parameters[parameter])
                        fields.append(value)
                    }
                    parameter = parameter + 1
                }
                result = bootstrapEvalObject(
                    declaration.name,
                    fieldNames,
                    fields
                )
            }
            if (declaration.name == targetName &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner == "") {
                val callNames: array<string> = []
                val callValues: array<BootstrapEvalValue> = []
                val callMutable: array<bool> = []
                var argument = 0
                while (argument < declaration.parameters.size) {
                    callNames.append(declaration.parameters[argument])
                    if (argument < expression.children.size) {
                        callValues.append(this.evaluate(
                            expression.children[argument]
                        ))
                        argument = argument
                    } else if (argument < declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[argument].kind !=
                            "missing") {
                        val defaults = BootstrapEvaluator(
                            this.declarations,
                            this.affineTypes,
                            callNames,
                            callValues,
                            callMutable,
                            this.cursors,
                            this.syntax,
                            this.typedCalls,
                            this.reflectedTypes,
                            this.generatedDeclarations,
                            this.extensionRequests,
                            this.compileInputPaths,
                            this.compileInputContents,
                            this.allowedCompileEffects,
                            this.errors,
                            this.steps,
                            this.diagnostics
                        )
                        callValues.append(defaults.evaluate(
                            declaration.parameterDefaults[argument]
                        ))
                        this.errors = defaults.errors
                        this.steps = defaults.steps
                        this.diagnostics = defaults.diagnostics
                    } else {
                        callValues.append(bootstrapEvalInvalid())
                        this.errors = this.errors + 1
                    }
                    callMutable.append(false)
                    argument = argument + 1
                }
                val invocation = BootstrapEvaluator(
                    this.declarations,
                    this.affineTypes,
                    callNames,
                    callValues,
                    callMutable,
                    this.cursors,
                    this.syntax,
                    this.typedCalls,
                    this.reflectedTypes,
                    this.generatedDeclarations,
                    this.extensionRequests,
                    this.compileInputPaths,
                    this.compileInputContents,
                    this.allowedCompileEffects,
                    this.errors,
                    this.steps,
                    this.diagnostics
                )
                result = invocation.evaluate(declaration.expression)
                if (result.kind == "return" && result.elements.size == 1) {
                    result = result.elements[0]
                }
                invocation.dropOwnedParameters(
                    declaration.parameterKinds,
                    result,
                    0
                )
                this.errors = invocation.errors
                this.steps = invocation.steps
                this.diagnostics = invocation.diagnostics
            }
            declarationIndex = declarationIndex + 1
        }
        if (result.kind == "invalid") this.errors = this.errors + 1
        result
    }

    fun evaluateMethod(
        receiver: BootstrapEvalValue,
        expression: BootstrapExpression
    ): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        var receiverType = receiver.owner
        if (receiver.kind == "string") receiverType = "string"
        if (receiver.kind == "integer") receiverType = "i64"
        if (receiver.kind == "boolean") receiverType = "bool"
        if (receiver.owner == "Compiler") {
            var target = ""
            if (expression.text == "functions") {
                target = "compilerFunctions"
            }
            if (expression.text == "functionsAnnotated") {
                target = "compilerFunctionsAnnotated"
            }
            if (expression.text == "findFunction") {
                target = "compilerFindFunction"
            }
            if (expression.text == "functionName") {
                target = "compilerFunctionName"
            }
            if (expression.text == "functionIdentity") {
                target = "compilerFunctionCanonicalIdentity"
            }
            if (expression.text == "functionModuleIdentity") {
                target = "compilerFunctionModuleIdentity"
            }
            if (expression.text == "functionOwner") {
                target = "compilerFunctionOwner"
            }
            if (expression.text == "parameterCount") {
                target = "compilerFunctionParameterCount"
            }
            if (expression.text == "parameterName") {
                target = "compilerFunctionParameterName"
            }
            if (expression.text == "parameterType") {
                target = "compilerFunctionParameterType"
            }
            if (expression.text == "resultType") {
                target = "compilerFunctionResultType"
            }
            if (expression.text == "annotationCount") {
                target = "compilerFunctionAnnotationCount"
            }
            if (expression.text == "annotation") {
                target = "compilerFunctionAnnotation"
            }
            if (expression.text == "isCompileOnly") {
                target = "compilerFunctionIsCompileOnly"
            }
            if (expression.text == "isTrusted") {
                target = "compilerFunctionIsTrusted"
            }
            if (expression.text == "isExternal") {
                target = "compilerFunctionIsExternal"
            }
            if (expression.text == "replaceFunctionBody") {
                target = "compilerReplaceFunctionBody"
            }
            if (expression.text == "generateModule") {
                target = "compilerGenerateModule"
            }
            if (expression.text == "writeFile") {
                target = "compilerWriteFile"
            }
            if (expression.text == "buildProgram") {
                target = "compilerBuildProgram"
            }
            if (expression.text == "defineTarget") {
                target = "compilerDefineTarget"
            }
            if (expression.text == "contributeArtifactRoot") {
                target = "compilerContributeArtifactRoot"
            }
            if (expression.text == "exportFunction") {
                target = "compilerExportFunction"
            }
            if (expression.text == "exportCheckedFunction") {
                target = "compilerExportCheckedFunction"
            }
            if (target != "") {
                val arguments: array<BootstrapExpression> = []
                var argument = 1
                while (argument < expression.children.size) {
                    arguments.append(expression.children[argument])
                    argument = argument + 1
                }
                result = this.evaluateCall(BootstrapExpression(
                    "call",
                    target,
                    expression.begin,
                    expression.end,
                    arguments
                ))
            }
        }
        var declarationIndex = 0
        while (result.kind == "invalid" &&
               declarationIndex < this.declarations.size) {
            val declaration = this.declarations[declarationIndex]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner == receiverType &&
                declaration.name == expression.text) {
                val extensionNames: array<string> = ["this"]
                val extensionValues: array<BootstrapEvalValue> = [receiver]
                val extensionMutable: array<bool> = [false]
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    extensionNames.append(declaration.parameters[parameter])
                    if (parameter + 1 < expression.children.size) {
                        extensionValues.append(this.evaluate(
                            expression.children[parameter + 1]
                        ))
                    } else if (parameter <
                            declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[parameter].kind !=
                            "missing") {
                        val defaults = BootstrapEvaluator(
                            this.declarations,
                            this.affineTypes,
                            extensionNames,
                            extensionValues,
                            extensionMutable,
                            this.cursors,
                            this.syntax,
                            this.typedCalls,
                            this.reflectedTypes,
                            this.generatedDeclarations,
                            this.extensionRequests,
                            this.compileInputPaths,
                            this.compileInputContents,
                            this.allowedCompileEffects,
                            this.errors,
                            this.steps,
                            this.diagnostics
                        )
                        extensionValues.append(defaults.evaluate(
                            declaration.parameterDefaults[parameter]
                        ))
                        this.errors = defaults.errors
                        this.steps = defaults.steps
                        this.diagnostics = defaults.diagnostics
                    } else {
                        extensionValues.append(bootstrapEvalInvalid())
                        this.errors = this.errors + 1
                    }
                    extensionMutable.append(false)
                    parameter = parameter + 1
                }
                val invocation = BootstrapEvaluator(
                    this.declarations,
                    this.affineTypes,
                    extensionNames,
                    extensionValues,
                    extensionMutable,
                    this.cursors,
                    this.syntax,
                    this.typedCalls,
                    this.reflectedTypes,
                    this.generatedDeclarations,
                    this.extensionRequests,
                    this.compileInputPaths,
                    this.compileInputContents,
                    this.allowedCompileEffects,
                    this.errors,
                    this.steps,
                    this.diagnostics
                )
                result = invocation.evaluate(declaration.expression)
                if (result.kind == "return" && result.elements.size == 1) {
                    result = result.elements[0]
                }
                invocation.dropOwnedParameters(
                    declaration.parameterKinds,
                    result,
                    1
                )
                this.errors = invocation.errors
                this.steps = invocation.steps
                this.diagnostics = invocation.diagnostics
            }
            if (declaration.kind == "class" &&
                declaration.name == receiver.owner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val method = declaration.methods[methodIndex]
                    if (method.name == expression.text) {
                        val methodNames: array<string> = ["this"]
                        val methodValues: array<BootstrapEvalValue> = [receiver]
                        val methodMutable: array<bool> = [false]
                        var parameter = 0
                        while (parameter < method.parameters.size) {
                            methodNames.append(method.parameters[parameter])
                            if (parameter + 1 < expression.children.size) {
                                methodValues.append(this.evaluate(
                                    expression.children[parameter + 1]
                                ))
                                this.steps = this.steps
                            } else if (parameter <
                                    method.parameterDefaults.size &&
                                method.parameterDefaults[parameter].kind !=
                                    "missing") {
                                val defaults = BootstrapEvaluator(
                                    this.declarations,
                                    this.affineTypes,
                                    methodNames,
                                    methodValues,
                                    methodMutable,
                                    this.cursors,
                                    this.syntax,
                                    this.typedCalls,
                                    this.reflectedTypes,
                                    this.generatedDeclarations,
                                    this.extensionRequests,
                                    this.compileInputPaths,
                                    this.compileInputContents,
                                    this.allowedCompileEffects,
                                    this.errors,
                                    this.steps,
                                    this.diagnostics
                                )
                                methodValues.append(defaults.evaluate(
                                    method.parameterDefaults[parameter]
                                ))
                                this.errors = defaults.errors
                                this.steps = defaults.steps
                                this.diagnostics = defaults.diagnostics
                            } else {
                                methodValues.append(bootstrapEvalInvalid())
                                this.errors = this.errors + 1
                            }
                            methodMutable.append(false)
                            parameter = parameter + 1
                        }
                        val invocation = BootstrapEvaluator(
                            this.declarations,
                            this.affineTypes,
                            methodNames,
                            methodValues,
                            methodMutable,
                        this.cursors,
                        this.syntax,
                        this.typedCalls,
                        this.reflectedTypes,
                        this.generatedDeclarations,
                        this.extensionRequests,
                            this.compileInputPaths,
                            this.compileInputContents,
                            this.allowedCompileEffects,
                            this.errors,
                            this.steps,
                            this.diagnostics
                        )
                        result = invocation.evaluate(method.expression)
                        if (result.kind == "return" &&
                            result.elements.size == 1) {
                            result = result.elements[0]
                        }
                        invocation.dropOwnedParameters(
                            method.parameterKinds,
                            result,
                            1
                        )
                        this.errors = invocation.errors
                        this.steps = invocation.steps
                        this.diagnostics = invocation.diagnostics
                    }
                    methodIndex = methodIndex + 1
                }
            }
            declarationIndex = declarationIndex + 1
        }
        if (result.kind == "invalid") this.errors = this.errors + 1
        result
    }

    fun evaluate(expression: BootstrapExpression): BootstrapEvalValue {
        val errorsBefore = this.errors
        val diagnosticsBefore = this.diagnostics.size
        this.steps = this.steps + 1
        if (this.steps > 100000) this.errors = this.errors + 1
        var result = bootstrapEvalInvalid()
        if (expression.kind == "integer") {
            var value = 0
            var index = 0
            while (index < expression.text.size) {
                val byte = expression.text[index]
                if (byte != 95) value = value * 10 + byte - 48
                index = index + 1
            }
            result = bootstrapEvalInteger(value)
        }
        if (expression.kind == "true" || expression.kind == "false") {
            result = bootstrapEvalBoolean(expression.kind == "true")
        }
        if (expression.kind == "string") {
            result = bootstrapEvalString(expression.text)
        }
        if (expression.kind == "null") result = bootstrapEvalNull()
        if (expression.kind == "delegate.initializer" &&
            expression.children.size > 0) {
            result = bootstrapEvalDelegate(
                this.evaluate(expression.children[0]),
                expression.text == "var"
            )
        }
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            var family = "fn"
            if (expression.kind == "lambda.move") family = "once"
            if (expression.kind == "lambda" &&
                this.lambdaRequiresMutableCall(expression)) family = "mut"
            val bound: array<string> = []
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                bound.append(expression.children[parameter].text)
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaLocals(body, bound)
            val free: array<string> = []
            this.collectLambdaFreeNames(body, bound, free)
            val captureNames: array<string> = []
            val captureValues: array<BootstrapEvalValue> = []
            var capture = 0
            while (capture < free.size) {
                val found = this.find(free[capture])
                if (found >= 0 &&
                    !this.nameIsBound(captureNames, free[capture])) {
                    var value = this.values[found]
                    captureNames.append(free[capture])
                    if (!(expression.kind == "lambda.move" &&
                          this.valueIsAffine(value))) {
                        if (value.kind != "cell") {
                            value = bootstrapEvalCell(value)
                            this.values[found] = value
