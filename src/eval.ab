}

@noinline
fun bootstrapEvaluateCallMap(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    result = BootstrapEvalValue(
        "map", 0, false, "", [bootstrapEvalArray([]),
            bootstrapEvalArray([])], "", []
    )
    result
}

@noinline
fun bootstrapEvaluateCallCell(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.children.size == 1) {
        result = bootstrapEvalCell(
            evaluator.evaluate(expression.children[0])
        )
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

// A generator runs as the runtime's does: its body is a move closure, run whole
// the first time the generator is iterated, and `yield` appends to the values
// the iteration then walks. Its defers run as the body finishes. The values
// live in a local the body can't name (`#yield`), so a generator iterated
// inside another collects into its own.
@noinline
fun bootstrapEvaluateGenerator(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.kind == "generator" && expression.children.size == 1) {
        val closure = evaluator.evaluate(BootstrapExpression(
            "lambda.move",
            "",
            expression.begin,
            expression.end,
            [expression.children[0]]
        ))
        result = BootstrapEvalValue(
            "generator", 0, false, "", [closure], "", []
        )
    }
    if (expression.kind == "yield" && expression.children.size == 1) {
        val value = evaluator.evaluate(expression.children[0])
        var slot = evaluator.names.size
        var found = -1
        while (slot > 0 && found < 0) {
            slot = slot - 1
            if (evaluator.names[slot] == "#yield") found = slot
        }
        if (found >= 0 && value.kind != "invalid") {
            evaluator.values[found].elements.append(value)
            result = bootstrapEvalVoid()
        }
    }
    if (result.kind == "invalid") evaluator.errors = evaluator.errors + 1
    result
}

// Runs a generator's body once, the first time it is iterated, and keeps what
// it yielded beside its spent closure (`elements[1]`).
@noinline
fun bootstrapRunGenerator(
    var evaluator: BootstrapEvaluator,
    var source: BootstrapEvalValue
): void {
    if (source.elements.size != 1 || source.elements[0].kind != "closure") {
        if (source.elements.size != 2) evaluator.errors = evaluator.errors + 1
        return
    }
    val yielded: array<BootstrapEvalValue> = []
    val lambda = evaluator.syntax[source.elements[0].integer]
    val callNames: array<string> = ["#yield"]
    val callValues: array<BootstrapEvalValue> = [bootstrapEvalArray(yielded)]
    val callMutable: array<bool> = [false]
    var capture = 0
    while (capture < source.elements[0].fieldNames.size) {
        callNames.append(source.elements[0].fieldNames[capture])
        callValues.append(source.elements[0].elements[capture])
        callMutable.append(source.elements[0].owner == "mut")
        capture = capture + 1
    }
    val invocation = BootstrapEvaluator(
        evaluator.declarations,
        evaluator.affineTypes,
        evaluator.context,
        callNames,
        callValues,
        callMutable,
        evaluator.cursors,
        evaluator.syntax,
        evaluator.typedCalls,
        evaluator.reflectedTypes,
        evaluator.generatedDeclarations,
        evaluator.extensionRequests,
        evaluator.compileInputPaths,
        evaluator.compileInputContents,
        evaluator.globalKeys,
        evaluator.globalValues,
        evaluator.allowedCompileEffects,
        evaluator.errors,
        evaluator.steps,
        evaluator.diagnostics
    )
    val ignored = invocation.evaluate(
        lambda.children[lambda.children.size - 1]
    )
    evaluator.errors = invocation.errors
    evaluator.steps = invocation.steps
    evaluator.diagnostics = invocation.diagnostics
    source.elements[0] = evaluator.uninitializedValue()
    source.elements.append(invocation.values[0])
    return
}

@noinline
fun bootstrapEvaluateReturn(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var value = bootstrapEvalVoid()
    if (expression.children.size > 0 &&
        expression.children[0].kind != "missing") {
        value = evaluator.evaluate(expression.children[0])
    }
    result = bootstrapEvalReturn(value)
    result
}

@noinline
fun bootstrapEvaluateNot(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val value = evaluator.evaluate(expression.children[0])
    result = bootstrapEvalBoolean(!value.boolean)
    result
}

@noinline
fun bootstrapEvaluateComplement(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val value = evaluator.evaluate(expression.children[0]).integer
    result = bootstrapEvalInteger(bitNot(value))
    result
}

@noinline
fun bootstrapEvaluateLambda(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var family = "fn"
    if (expression.kind == "lambda.move") family = "once"
    if (expression.kind == "lambda" &&
        evaluator.lambdaRequiresMutableCall(expression)) family = "mut"
    val bound: array<string> = []
    var parameter = 0
    while (parameter + 1 < expression.children.size) {
        bound.append(expression.children[parameter].text)
        parameter = parameter + 1
    }
    val body = expression.children[expression.children.size - 1]
    val free: array<string> = []
    evaluator.collectLambdaFreeNames(body, bound, free)
    val captureNames: array<string> = []
    val captureValues: array<BootstrapEvalValue> = []
    var capture = 0
    while (capture < free.size) {
        var name = free[capture]
        var found = evaluator.find(name)
        // A field read inside a method's lambda captures the receiver, as
        // lowering does.
        if (found < 0 && evaluator.receiverHasField(name)) {
            name = "this"
            found = evaluator.find(name)
        }
        if (found >= 0 &&
            !evaluator.nameIsBound(captureNames, name)) {
            var value = evaluator.values[found]
            captureNames.append(name)
            // The receiver binding never changes: it is captured as is.
            if (name != "this" && !(expression.kind == "lambda.move" &&
                  evaluator.valueIsAffine(value))) {
                if (value.kind != "cell") {
                    value = bootstrapEvalCell(value)
                    evaluator.values[found] = value
                }
            }
            captureValues.append(value)
            if (expression.kind == "lambda.move" &&
                evaluator.valueIsAffine(value)) {
                evaluator.values[found] = evaluator.uninitializedValue()
            }
        }
        capture = capture + 1
    }
    val handle = evaluator.syntax.size
    evaluator.syntax.append(expression)
    result = bootstrapEvalClosure(
        handle,
        family,
        captureValues,
        captureNames
    )
    result
}

@noinline
fun bootstrapEvaluateIdentifier(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val found = evaluator.find(expression.text)
    if (found >= 0) {
        result = evaluator.values[found]
        if (result.kind == "cell" && result.elements.size == 1) {
            result = result.elements[0]
        }
        if (result.kind == "uninitialized") {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
        evaluator.errors = evaluator.errors
    }
    else {
        val receiverIndex = evaluator.find("this")
        // A closure made in a method holds its receiver in a cell.
        val receiverValue = if (receiverIndex < 0) bootstrapEvalInvalid()
            else if (evaluator.values[receiverIndex].kind == "cell")
                evaluator.values[receiverIndex].elements[0]
            else evaluator.values[receiverIndex]
        if (receiverValue.kind == "object") {
            val receiver = receiverValue
            var field = 0
            while (field < receiver.fieldNames.size) {
                if (receiver.fieldNames[field] == expression.text) {
                    result = receiver.elements[field]
                }
                field = field + 1
            }
        }
        var declarationIndexNode = evaluator.firstNamed(expression.text)
        while (result.kind == "invalid" &&
               declarationIndexNode >= 0) {
            val declarationIndex = evaluator.namedDeclaration(declarationIndexNode)
            val declaration = evaluator.declarations[declarationIndex]
            if (bootstrapDeclarationIsValue(declaration.kind) &&
                declaration.name == expression.text) {
                if (declaration.expression.kind ==
                    "delegate.initializer") {
                    result = evaluator.delegatedSlot(expression.text)
                } else if (declaration.kind == "compile.val" ||
                    declaration.kind == "compile.var") {
                    result = evaluator.compileGlobal(declaration)
                } else result = bootstrapRuntimeGlobal(evaluator, declaration)
            }
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.name == expression.text) {
                result = bootstrapEvalFunction(declaration.name)
            }
            declarationIndexNode = evaluator.nextNamed(declarationIndexNode)
        }
        if (result.kind == "invalid") {
            evaluator.errors = evaluator.errors + 1
        } else evaluator.errors = evaluator.errors
    }
    if (result.kind == "delegate" &&
        result.elements.size == 1) {
        result = evaluator.invokeDelegateMethod(
            result.elements[0],
            "getValue",
            bootstrapEvalInvalid(),
            false,
            expression.begin,
            expression.end
        )
    }
    result
}

@noinline
fun bootstrapEvaluateMove(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.children.size == 1 &&
        expression.children[0].kind == "identifier") {
        val found = evaluator.find(expression.children[0].text)
        if (found >= 0 && evaluator.values[found].kind != "uninitialized") {
            result = evaluator.values[found]
            evaluator.values[found] = evaluator.uninitializedValue()
            bootstrapSemanticUnit()
        } else {
            evaluator.errors = evaluator.errors + 1
            bootstrapSemanticUnit()
        }
        bootstrapSemanticUnit()
    } else if (expression.children.size == 1 &&
        (expression.children[0].kind == "member" ||
         expression.children[0].kind == "index")) {
        val place = expression.children[0]
        if (place.kind == "member") {
            val receiver = evaluator.evaluate(place.children[0])
            var field = 0
            while (field < receiver.fieldNames.size) {
                if (receiver.fieldNames[field] == place.text) {
                    result = receiver.elements[field]
                    receiver.elements[field] = evaluator.uninitializedValue()
                }
                field = field + 1
            }
        } else {
            val receiver = evaluator.evaluate(place.children[0])
            val index = evaluator.evaluate(place.children[1]).integer
            if (receiver.kind == "array" && index >= 0 &&
                index < receiver.elements.size) {
                result = receiver.elements[index]
                receiver.elements[index] = evaluator.uninitializedValue()
                bootstrapSemanticUnit()
            } else {
                evaluator.errors = evaluator.errors + 1
                bootstrapSemanticUnit()
            }
        }
        if (result.kind == "uninitialized") {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
            bootstrapSemanticUnit()
        }
        bootstrapSemanticUnit()
    } else {
        evaluator.errors = evaluator.errors + 1
        bootstrapSemanticUnit()
    }
    result
}

@noinline
fun bootstrapEvaluateFilledArray(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val count = if (expression.children.size == 2) {
        evaluator.evaluate(expression.children[0])
    } else bootstrapEvalInvalid()
    if (count.kind == "integer" && count.integer >= 0) {
        val value = evaluator.evaluate(expression.children[1])
        val elements: array<BootstrapEvalValue> = []
        var index = 0
        while (index < count.integer) {
            elements.append(value)
            index = index + 1
        }
        result = bootstrapEvalArray(elements)
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateTask(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val closure = evaluator.evaluate(BootstrapExpression(
        "lambda.move",
        "",
        expression.begin,
        expression.end,
        [expression.children[0]]
    ))
    result = BootstrapEvalValue(
        expression.kind, 0, false, "", [closure], "", []
    )
    result
}

@noinline
fun bootstrapEvaluateAwait(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val operation = evaluator.evaluate(expression.children[0])
    if ((operation.kind == "task" || operation.kind == "thread") &&
        operation.elements.size == 1 &&
        operation.elements[0].kind != "uninitialized") {
        val name = "await_${expression.begin}_${evaluator.steps}"
        evaluator.names.append(name)
        evaluator.values.append(operation.elements[0])
        evaluator.mutable.append(false)
        result = evaluator.evaluate(BootstrapExpression(
            "call", name, expression.begin, expression.end, []
        ))
        operation.elements[0] = evaluator.uninitializedValue()
        evaluator.values[evaluator.values.size - 1] = evaluator.uninitializedValue()
        evaluator.names[evaluator.names.size - 1] = ""
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateTemplate(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var text = ""
    var part = 0
    while (part < expression.children.size) {
        text = "$text${evaluator.printable(evaluator.evaluate(
            expression.children[part]
        ))}"
        part = part + 1
    }
    result = bootstrapEvalString(text)
    result
}

@noinline
fun bootstrapEvaluateBlock(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    val scopeBegin = evaluator.names.size
    val deferred: array<string> = []
    var result = BootstrapEvalValue("void", 0, false, "", [], "", [])
    var statement = 0
    while (statement < expression.children.size &&
           result.kind != "return" && result.kind != "break" &&
           result.kind != "continue") {
        val current = expression.children[statement]
        if (current.kind == "defer" && current.children.size == 1) {
            result = bootstrapEvalDeferStatement(evaluator, current, deferred)
        } else result = evaluator.evaluate(current)
        statement = statement + 1
    }
    bootstrapEvalCloseScope(evaluator, expression, scopeBegin, deferred, result)
    result
}

/** A block's `defer`: its body becomes a closure the block calls on exit. */
@noinline
fun bootstrapEvalDeferStatement(
    var evaluator: BootstrapEvaluator,
    current: BootstrapExpression,
    var deferred: array<string>
): BootstrapEvalValue {
    val name = "defer_${current.begin}_${deferred.size}"
    val closure = evaluator.evaluate(BootstrapExpression(
        "lambda.move",
        "",
        current.begin,
        current.end,
        [current.children[0]]
    ))
    evaluator.names.append(name)
    evaluator.values.append(closure)
    evaluator.mutable.append(false)
    deferred.append(name)
    bootstrapEvalVoid()
}

/** A block ends: its deferred closures run, last first, and its locals are
 *  dropped, except an affine value it hands on. */
@noinline
fun bootstrapEvalCloseScope(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    scopeBegin: int,
    deferred: array<string>,
    result: BootstrapEvalValue
): void {
    var deferredIndex = deferred.size
    while (deferredIndex > 0) {
        deferredIndex = deferredIndex - 1
        evaluator.evaluate(BootstrapExpression(
            "call",
            deferred[deferredIndex],
            expression.end,
            expression.end,
            []
        ))
    }
    var transferred = result
    if (result.kind == "return" && result.elements.size == 1) {
        transferred = result.elements[0]
    }
    var local = evaluator.names.size
    while (local > scopeBegin) {
        local = local - 1
        val value = evaluator.values[local]
        if (value.kind != "uninitialized" && value == transferred &&
            evaluator.valueIsAffine(value)) {
            evaluator.values[local] = evaluator.uninitializedValue()
            bootstrapSemanticUnit()
        } else if (value.kind != "uninitialized") {
            evaluator.dropValue(value)
            evaluator.values[local] = evaluator.uninitializedValue()
            bootstrapSemanticUnit()
        }
        evaluator.names[local] = ""
    }
}

@noinline
fun bootstrapEvaluateLocal(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var value = BootstrapEvalValue(
        "uninitialized",
        0,
        false,
        "",
        [],
        "",
        []
    )
    if (expression.children[0].kind != "missing") {
        value = evaluator.evaluate(expression.children[0])
    }
    evaluator.names.append(expression.text)
    evaluator.values.append(value)
    evaluator.mutable.append(expression.kind == "local.var")
    result = BootstrapEvalValue("void", 0, false, "", [], "", [])
    result
}

@noinline
fun bootstrapEvaluateAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.kind == "assign" && evaluator.find(expression.text) < 0 &&
        evaluator.compileVar(expression.text) >= 0) {
        // A `compile var` takes the new value for the rest of the compilation.
        val declaration = evaluator.declarations[evaluator.compileVar(expression.text)]
        val key = bootstrapCompileGlobalKey(declaration)
        val value = evaluator.evaluate(expression.children[0])
        var slot = -1
        var index = 0
        while (index < evaluator.globalKeys.size) {
            if (evaluator.globalKeys[index] == key) slot = index
            index = index + 1
        }
        if (slot >= 0) evaluator.globalValues[slot] = value
        else {
            evaluator.globalKeys.append(key)
            evaluator.globalValues.append(value)
        }
        result = value
    } else if (expression.kind == "assign" && evaluator.find(expression.text) < 0 &&
        evaluator.delegatedSlot(expression.text).kind != "delegate" &&
        bootstrapRuntimeVar(evaluator, expression.text) >= 0) {
        // A program `var` assigned by compile-time code: its value for the rest
        // of the compilation (bootstrapRuntimeGlobal).
        val declaration =
            evaluator.declarations[bootstrapRuntimeVar(evaluator, expression.text)]
        val key = bootstrapRuntimeGlobalKey(declaration)
        val value = evaluator.evaluate(expression.children[0])
        var slot = -1
        var index = 0
        while (index < evaluator.globalKeys.size) {
            if (evaluator.globalKeys[index] == key) slot = index
            index = index + 1
        }
        if (slot >= 0) evaluator.globalValues[slot] = value
        else {
            evaluator.globalKeys.append(key)
            evaluator.globalValues.append(value)
        }
        result = value
    } else if (expression.kind == "assign") {
        var found = evaluator.find(expression.text)
        if (found < 0) {
            val global = evaluator.delegatedSlot(expression.text)
            if (global.kind == "delegate") {
                evaluator.names.append(expression.text)
                evaluator.values.append(global)
                evaluator.mutable.append(global.boolean)
                found = evaluator.values.size - 1
            }
        }
        val value = evaluator.evaluate(expression.children[0])
        var slot = bootstrapEvalInvalid()
        if (found >= 0) slot = evaluator.values[found]
        if (slot.kind == "cell" && slot.elements.size == 1) {
            slot = slot.elements[0]
        }
        if (slot.kind == "delegate" && slot.elements.size == 1) {
            if (slot.boolean) {
                evaluator.invokeDelegateMethod(
                    slot.elements[0],
                    "setValue",
                    value,
                    true,
                    expression.begin,
                    expression.end
                )
                result = value
            } else {
                evaluator.errors = evaluator.errors + 1
                result = value
            }
        } else if (found >= 0 && evaluator.mutable[found]) {
            if (evaluator.values[found].kind == "cell" &&
                evaluator.values[found].elements.size == 1) {
                val cell = evaluator.values[found]
                if (cell.elements[0].kind != "uninitialized") {
                    evaluator.dropValue(cell.elements[0])
                }
                cell.elements[0] = value
            } else {
                if (evaluator.values[found].kind != "uninitialized") {
                    val previous = evaluator.values[found]
                    evaluator.dropValue(previous)
                }
                evaluator.values[found] = value
            }
            result = value
        } else {
            var fieldAssigned = false
            val receiverIndex = evaluator.find("this")
            if (receiverIndex >= 0 &&
                evaluator.values[receiverIndex].kind == "object") {
                val receiver = evaluator.values[receiverIndex]
                var field = 0
                while (field < receiver.fieldNames.size) {
                    if (receiver.fieldNames[field] == expression.text) {
                        if (receiver.elements[field].kind !=
                            "uninitialized") {
                            evaluator.dropValue(receiver.elements[field])
                        }
                        receiver.elements[field] = value
                        fieldAssigned = true
                    }
                    field = field + 1
                }
            }
            if (!fieldAssigned) evaluator.errors = evaluator.errors + 1
            result = value
        }
    }
    result
}

@noinline
fun bootstrapEvaluateDelegateProject(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val slot = evaluator.delegatedSlot(expression.children[0].text)
    if (slot.kind == "delegate" && slot.elements.size == 1) {
        result = slot.elements[0]
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateDelegateAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val slot = evaluator.delegatedSlot(expression.children[0].text)
    val value = evaluator.evaluate(expression.children[1])
    if (slot.kind == "delegate" && slot.elements.size == 1 &&
        slot.boolean) {
        if (slot.elements[0].kind != "uninitialized") {
            evaluator.dropValue(slot.elements[0])
        }
        slot.elements[0] = value
        result = value
    } else {
        evaluator.errors = evaluator.errors + 1
        result = value
    }
    result
}

@noinline
fun bootstrapEvaluateArrayLiteral(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val elements: array<BootstrapEvalValue> = []
    var element = 0
    while (element < expression.children.size) {
        elements.append(evaluator.evaluate(expression.children[element]))
        element = element + 1
    }
    result = bootstrapEvalArray(elements)
    result
}

@noinline
fun bootstrapEvaluateRange(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val begin = evaluator.evaluate(expression.children[0]).integer
    val end = evaluator.evaluate(expression.children[1]).integer
    val elements: array<BootstrapEvalValue> = []
    var current = begin
    var more = current < end
    if (expression.kind == "range.closed") more = current <= end
    while (more && evaluator.steps <= evaluator.context.stepLimit) {
        elements.append(bootstrapEvalInteger(current))
        current = current + 1
        more = current < end
        if (expression.kind == "range.closed") more = current <= end
        evaluator.steps = evaluator.steps + 1
    }
    result = bootstrapEvalArray(elements)
    result
}

@noinline
fun bootstrapEvaluateMember(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val rawReceiver = evaluator.evaluate(expression.children[0])
    val receiver = bootstrapEvalUnwrapBorrow(rawReceiver)
    if (expression.text == "size") {
        if (receiver.kind == "string") {
            result = bootstrapEvalInteger(receiver.text.size)
        } else if (receiver.kind == "array") {
            result = bootstrapEvalInteger(receiver.elements.size)
        } else if (receiver.kind == "map") {
            result = bootstrapEvalInteger(
                receiver.elements[0].elements.size
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            result = result
        }
    } else if (receiver.kind == "object") {
        var field = 0
        while (field < receiver.fieldNames.size) {
            if (receiver.fieldNames[field] == expression.text) {
                result = receiver.elements[field]
            }
            field = field + 1
        }
        result = result
    } else result = result
    if (rawReceiver.kind == "borrow" &&
        bootstrapEvalValueNeedsBorrow(result)) {
        result = bootstrapEvalBorrow(result)
    }
    result
}

@noinline
fun bootstrapEvaluateMemberAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val receiver = bootstrapEvalUnwrapBorrow(
        evaluator.evaluate(expression.children[0])
    )
    val value = evaluator.evaluate(expression.children[1])
    var assigned = false
    var field = 0
    while (field < receiver.fieldNames.size) {
        if (receiver.fieldNames[field] == expression.text) {
            if (receiver.elements[field].kind != "uninitialized") {
                evaluator.dropValue(receiver.elements[field])
            }
            receiver.elements[field] = value
            assigned = true
        }
        field = field + 1
    }
    if (!assigned) evaluator.errors = evaluator.errors + 1
    result = value
    result
}

@noinline
fun bootstrapEvaluateIndex(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val rawReceiver = evaluator.evaluate(expression.children[0])
    val receiver = bootstrapEvalUnwrapBorrow(rawReceiver)
    val index = evaluator.evaluate(expression.children[1]).integer
    if (receiver.kind == "string" && index >= 0 &&
        index < receiver.text.size) {
        result = bootstrapEvalInteger(receiver.text[index])
    } else if (receiver.kind == "array" && index >= 0 &&
        index < receiver.elements.size) {
        result = receiver.elements[index]
    } else {
        evaluator.errors = evaluator.errors + 1
        result = result
    }
    if (rawReceiver.kind == "borrow" &&
        bootstrapEvalValueNeedsBorrow(result)) {
        result = bootstrapEvalBorrow(result)
    }
    result
}

@noinline
fun bootstrapEvaluateIndexAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val receiver = bootstrapEvalUnwrapBorrow(
        evaluator.evaluate(expression.children[0])
    )
    val index = evaluator.evaluate(expression.children[1]).integer
    val value = evaluator.evaluate(expression.children[2])
    if (receiver.kind == "array" && index >= 0 &&
        index < receiver.elements.size) {
        if (receiver.elements[index].kind != "uninitialized") {
            evaluator.dropValue(receiver.elements[index])
        }
        receiver.elements[index] = value
        result = value
    } else {
        evaluator.errors = evaluator.errors + 1
        result = value
    }
    result
}

@noinline
fun bootstrapEvaluateMemberCall(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val receiver = bootstrapEvalUnwrapBorrow(
        evaluator.evaluate(expression.children[0])
    )
    if (receiver.kind == "cell" || receiver.kind == "shared" ||
        receiver.kind == "weak") {
        result = bootstrapEvaluateReferenceMethod(evaluator, expression, receiver)
    } else if (receiver.kind == "map") {
        result = evaluator.evaluateMapCall(receiver, expression)
    } else if (expression.text == "append" &&
        receiver.kind == "array" &&
        expression.children.size == 2) {
        receiver.elements.append(evaluator.evaluate(expression.children[1]))
        result = BootstrapEvalValue(
            "void", 0, false, "", [], "", []
        )
    } else if ((expression.text == "truncate" ||
                expression.text == "clear") &&
        receiver.kind == "array") {
        val count = if (expression.text == "clear") 0
            else evaluator.evaluate(expression.children[1]).integer
        if (count < 0 || count > receiver.elements.size) {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        } else {
            receiver.elements.truncate(count)
            result = BootstrapEvalValue(
                "void", 0, false, "", [], "", []
            )
        }
    } else if (expression.text == "slice" &&
        receiver.kind == "string" &&
        expression.children.size == 3) {
        val begin = evaluator.evaluate(expression.children[1]).integer
        val end = evaluator.evaluate(expression.children[2]).integer
        result = bootstrapEvalString(receiver.text.slice(begin, end))
    } else if (receiver.kind == "object" ||
               receiver.kind == "string" ||
               receiver.kind == "integer" ||
               receiver.kind == "boolean") {
        result = evaluator.evaluateMethod(receiver, expression)
    } else result = result
    result
}

/** `get`/`set` of a Cell, `with`/`clone`/`get`/`downgrade` of a Shared and
 *  `clone`/`upgrade`/`isAlive` of a weak reference. */
@noinline
fun bootstrapEvaluateReferenceMethod(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    var receiver: BootstrapEvalValue
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (receiver.kind == "cell" && expression.text == "get" &&
        expression.children.size == 1) {
        result = receiver.elements[0]
    } else if (receiver.kind == "cell" &&
               expression.text == "set" &&
               expression.children.size == 2) {
        receiver.elements[0] = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalVoid()
    } else if (receiver.kind == "shared" && expression.text == "with" &&
        expression.children.size == 2 &&
        expression.children[1].kind == "identifier") {
        val temporary = "__mutex_payload_${evaluator.steps}"
        evaluator.names.append(temporary)
        evaluator.values.append(receiver.elements[0].elements[0])
        evaluator.mutable.append(false)
        result = evaluator.evaluateCall(BootstrapExpression(
            "call",
            expression.children[1].text,
            expression.begin,
            expression.end,
            [BootstrapExpression(
                "identifier",
                temporary,
                expression.begin,
                expression.end,
                []
            )]
        ))
        evaluator.values[evaluator.values.size - 1] = evaluator.uninitializedValue()
        evaluator.names[evaluator.names.size - 1] = ""
    } else if (receiver.kind == "shared" &&
        expression.text == "clone" &&
        expression.children.size == 1) {
        result = bootstrapEvalSharedClone(receiver)
    } else if (receiver.kind == "shared" &&
               expression.text == "get" &&
               expression.children.size == 1) {
        result = bootstrapEvalSharedGet(receiver)
    } else if (receiver.kind == "shared" &&
               expression.text == "downgrade" &&
               expression.children.size == 1) {
        result = bootstrapEvalWeak(receiver)
    } else if (receiver.kind == "weak" &&
               expression.text == "clone" &&
               expression.children.size == 1) {
        result = bootstrapEvalWeakClone(receiver)
    } else if (receiver.kind == "weak" &&
               expression.text == "upgrade" &&
               expression.children.size == 1) {
        result = bootstrapEvalWeakUpgrade(receiver)
    } else if (receiver.kind == "weak" &&
               expression.text == "isAlive" &&
               expression.children.size == 1) {
        result = bootstrapEvalBoolean(
            receiver.elements[0].elements[1].integer > 0
        )
    }
    result
}


@noinline
fun bootstrapEvaluateNegate(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val value = evaluator.evaluate(expression.children[0])
    var integer = value.integer
    if (expression.kind == "unary-") integer = -integer
    result = if (value.kind == "f64") {
        if (expression.kind == "unary-") {
            bootstrapEvalF64(-bootstrapEvalAsF64(value))
        } else value
    } else if (value.kind == "f32") {
        if (expression.kind == "unary-") {
            bootstrapEvalF32(-bootstrapEvalAsF32(value))
        } else value
    } else bootstrapEvalInteger(integer)
    result
}

@noinline
fun bootstrapEvaluateArithmetic(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val leftValue = evaluator.evaluate(expression.children[0])
    val rightValue = evaluator.evaluate(expression.children[1])
    result = if (expression.kind == "+" && leftValue.kind == "string" &&
        rightValue.kind == "string") {
        bootstrapEvalString("${leftValue.text}${rightValue.text}")
    } else if (leftValue.kind == "f64" && rightValue.kind == "f64") {
        bootstrapEvalF64(bootstrapEvalF64Arithmetic(
            expression.kind,
            bootstrapEvalAsF64(leftValue),
            bootstrapEvalAsF64(rightValue)
        ))
    } else if (leftValue.kind == "f32" && rightValue.kind == "f32") {
        bootstrapEvalF32(bootstrapEvalF32Arithmetic(
            expression.kind,
            bootstrapEvalAsF32(leftValue),
            bootstrapEvalAsF32(rightValue)
        ))
    } else {
        // Float payloads are IEEE bits, not integers. In particular a
        // floating zero must never reach an integer division first.
        val left = leftValue.integer
        val right = rightValue.integer
        var value = left + right
        if (expression.kind == "-") value = left - right
        if (expression.kind == "*") value = left * right
        if (expression.kind == "/") value = left / right
        if (expression.kind == "%") value = left - (left / right) * right
        bootstrapEvalInteger(value)
    }
    result
}

@noinline
fun bootstrapEvaluateBitwise(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val left = evaluator.evaluate(expression.children[0]).integer
    val right = evaluator.evaluate(expression.children[1]).integer
    var value = bitAnd(left, right)
    if (expression.kind == "|") value = bitOr(left, right)
    if (expression.kind == "^") value = bitXor(left, right)
    if (expression.kind == "<<") value = bitShiftLeft(left, right)
    if (expression.kind == ">>") value = bitShiftRight(left, right)
    if (expression.kind == ">>>") {
        value = bitShiftRightUnsigned(left, right)
    }
    result = bootstrapEvalInteger(value)
    result
}

@noinline
fun bootstrapEvaluateEquality(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val left = evaluator.evaluate(expression.children[0])
    val right = evaluator.evaluate(expression.children[1])
    var equal = bootstrapEvalEqual(left, right)
    if (expression.kind == "!=") equal = !equal
    result = bootstrapEvalBoolean(equal)
    result
}

@noinline
fun bootstrapEvaluateComparison(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val leftValue = evaluator.evaluate(expression.children[0])
    val rightValue = evaluator.evaluate(expression.children[1])
    val left = leftValue.integer
    val right = rightValue.integer
    var value = left < right
    if (expression.kind == "<=") value = left <= right
    if (expression.kind == ">") value = left > right
    if (expression.kind == ">=") value = left >= right
    if (bootstrapEvalFloat(leftValue) && bootstrapEvalFloat(rightValue)) {
        value = bootstrapEvalF64Compare(
            expression.kind,
            if (leftValue.kind == "f32") {
                f32ToF64(bootstrapEvalAsF32(leftValue))
            } else bootstrapEvalAsF64(leftValue),
            if (rightValue.kind == "f32") {
                f32ToF64(bootstrapEvalAsF32(rightValue))
            } else bootstrapEvalAsF64(rightValue)
        )
    }
    result = bootstrapEvalBoolean(value)
    result
}

@noinline
fun bootstrapEvaluateAnd(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val pending: array<BootstrapExpression> = []
    val operands: array<BootstrapExpression> = []
    pending.append(expression)
    var pendingSize = 1
    while (pendingSize > 0) {
        pendingSize = pendingSize - 1
        val current = pending[pendingSize]
        if (current.kind == "&&" && current.children.size == 2) {
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[1]
            } else pending.append(current.children[1])
            pendingSize = pendingSize + 1
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[0]
            } else pending.append(current.children[0])
            pendingSize = pendingSize + 1
        } else operands.append(current)
    }
    var operand = 0
    result = bootstrapEvalBoolean(true)
    while (result.boolean && operand < operands.size) {
        result = evaluator.evaluate(operands[operand])
        operand = operand + 1
    }
    result
}

@noinline
fun bootstrapEvaluateOr(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val pending: array<BootstrapExpression> = []
    val operands: array<BootstrapExpression> = []
    pending.append(expression)
    var pendingSize = 1
    while (pendingSize > 0) {
        pendingSize = pendingSize - 1
        val current = pending[pendingSize]
        if (current.kind == "||" && current.children.size == 2) {
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[1]
            } else pending.append(current.children[1])
            pendingSize = pendingSize + 1
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[0]
            } else pending.append(current.children[0])
            pendingSize = pendingSize + 1
        } else operands.append(current)
    }
    var operand = 0
    result = bootstrapEvalBoolean(false)
    while (!result.boolean && operand < operands.size) {
        result = evaluator.evaluate(operands[operand])
        operand = operand + 1
    }
    result
}

// An `else if` chain is walked here, not through `evaluate` for each link,
// so a long chain holds one frame; each link counts as the step `evaluate`
// would count for it.
@noinline
fun bootstrapEvaluateIf(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var current = expression
    var pending = true
    while (pending) {
        pending = false
        if (evaluator.evaluate(current.children[0]).boolean) {
            result = evaluator.evaluate(current.children[1])
        } else if (current.children[2].kind == "missing") {
            result = BootstrapEvalValue("void", 0, false, "", [], "", [])
        } else if (current.children[2].kind != "if") {
            result = evaluator.evaluate(current.children[2])
        } else {
            current = current.children[2]
            evaluator.steps = evaluator.steps + 1
            if (evaluator.steps > evaluator.context.stepLimit) {
                bootstrapEvalStepLimitReached(evaluator)
            } else pending = true
        }
    }
    result
}

@noinline
fun bootstrapEvaluateWhen(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val subject = evaluator.evaluate(expression.children[0])
    var selected = false
    var branch = 1
    while (!selected && branch + 1 < expression.children.size) {
        val match = expression.children[branch]
        if (match.kind == "missing" || bootstrapEvalEqual(
            subject,
            evaluator.evaluate(match)
        )) {
            result = evaluator.evaluate(expression.children[branch + 1])
            selected = true
        }
        branch = branch + 2
    }
    if (!selected) {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateWhile(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var looping = true
    result = bootstrapEvalVoid()
    while (looping &&
           evaluator.evaluate(expression.children[0]).boolean &&
           evaluator.steps <= evaluator.context.stepLimit) {
        result = evaluator.evaluate(expression.children[1])
        if (result.kind == "return") looping = false
        if (result.kind == "break") {
            result = bootstrapEvalVoid()
            looping = false
        }
        if (result.kind == "continue") {
            result = bootstrapEvalVoid()
        }
    }
    result
}

@noinline
fun bootstrapEvaluateDoWhile(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var more = true
    var looping = true
    result = bootstrapEvalVoid()
    while (more && looping && evaluator.steps <= evaluator.context.stepLimit) {
        result = evaluator.evaluate(expression.children[0])
        if (result.kind == "return") looping = false
        if (result.kind == "break") {
            result = bootstrapEvalVoid()
            looping = false
        }
        if (result.kind == "continue") {
            result = bootstrapEvalVoid()
        }
        if (looping) {
            more = evaluator.evaluate(expression.children[1]).boolean
        }
    }
    result
}

@noinline
fun bootstrapEvaluateFor(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var source = evaluator.evaluate(expression.children[0])
    val iteratorIndex = evaluator.names.size
    evaluator.names.append(expression.text)
    evaluator.values.append(bootstrapEvalInvalid())
    evaluator.mutable.append(false)
    var element = 0
    var looping = true
    result = bootstrapEvalVoid()
    if (source.kind == "generator") bootstrapRunGenerator(evaluator, source)
    var count = source.elements.size
    if (source.kind == "string") count = source.text.size
    if (source.kind == "generator") {
        count = 0
        if (source.elements.size == 2) count = source.elements[1].elements.size
    }
    while (element < count && looping && evaluator.steps <= evaluator.context.stepLimit) {
        if (source.kind == "string") {
            evaluator.values[iteratorIndex] = bootstrapEvalInteger(
                source.text[element]
            )
        } else if (source.kind == "generator") {
            evaluator.values[iteratorIndex] = source.elements[1].elements[element]
        } else {
            evaluator.values[iteratorIndex] = source.elements[element]
        }
        result = evaluator.evaluate(expression.children[1])
        if (result.kind == "return") looping = false
        if (result.kind == "break") {
            result = bootstrapEvalVoid()
            looping = false
        }
        if (result.kind == "continue") {
            result = bootstrapEvalVoid()
        }
        element = element + 1
    }
    evaluator.values[iteratorIndex] = evaluator.uninitializedValue()
    evaluator.names[iteratorIndex] = ""
    result
}

@noinline
fun bootstrapEvaluateClosureCall(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    callable: BootstrapEvalValue,
    target: int
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val closure = callable
    val lambda = evaluator.syntax[closure.integer]
    val callNames: array<string> = []
    val callValues: array<BootstrapEvalValue> = []
    val callMutable: array<bool> = []
    var capture = 0
    while (capture < closure.fieldNames.size) {
        callNames.append(closure.fieldNames[capture])
        callValues.append(closure.elements[capture])
        callMutable.append(closure.owner == "mut")
        capture = capture + 1
    }
    var parameter = 0
    while (parameter + 1 < lambda.children.size) {
        callNames.append(lambda.children[parameter].text)
        var argumentValue = bootstrapEvalInvalid()
        if (parameter < expression.children.size) {
            argumentValue = evaluator.evaluate(
                expression.children[parameter]
            )
            bootstrapSemanticUnit()
        } else {
            evaluator.errors = evaluator.errors + 1
            bootstrapSemanticUnit()
        }
        callValues.append(argumentValue)
        callMutable.append(false)
        parameter = parameter + 1
    }
    val invocation = BootstrapEvaluator(
        evaluator.declarations,
        evaluator.affineTypes,
        evaluator.context,
        callNames,
        callValues,
        callMutable,
        evaluator.cursors,
        evaluator.syntax,
        evaluator.typedCalls,
        evaluator.reflectedTypes,
        evaluator.generatedDeclarations,
        evaluator.extensionRequests,
        evaluator.compileInputPaths,
        evaluator.compileInputContents,
        evaluator.globalKeys,
        evaluator.globalValues,
        evaluator.allowedCompileEffects,
        evaluator.errors,
        evaluator.steps,
        evaluator.diagnostics
    )
    result = invocation.evaluate(
        lambda.children[lambda.children.size - 1]
    )
    if (result.kind == "return" && result.elements.size == 1) {
        result = result.elements[0]
    }
    if (closure.boolean) {
        capture = closure.elements.size
        while (capture > 0) {
            capture = capture - 1
            val captured = invocation.values[capture]
            if (captured.kind != "uninitialized" &&
                captured != result) {
                invocation.dropValue(captured)
            }
            invocation.values[capture] =
                invocation.uninitializedValue()
            closure.elements[capture] = evaluator.uninitializedValue()
        }
        if (target >= 0) {
            evaluator.values[target] = evaluator.uninitializedValue()
        }
    }
    evaluator.errors = invocation.errors
    evaluator.steps = invocation.steps
    evaluator.diagnostics = invocation.diagnostics
    result
}

@noinline
fun bootstrapEvaluateCallImports(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    // Import providers construct typed, deferred sources. Normal discovery
    // evaluates the source value but never invokes its resolver closure.
    if (targetName == "importFile" && expression.children.size == 2) {
        val path = evaluator.evaluate(expression.children[0])
        val contents = evaluator.evaluate(expression.children[1])
        if (path.kind == "string" && contents.kind == "string") {
            result = bootstrapEvalObject(
                "ImportFile", ["path", "contents"], [path, contents]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "resolvedImport" &&
        expression.children.size == 3) {
        val revision = evaluator.evaluate(expression.children[0])
        val entry = evaluator.evaluate(expression.children[1])
        val files = evaluator.evaluate(expression.children[2])
        if (revision.kind == "string" && entry.kind == "string" &&
            files.kind == "array") {
            result = bootstrapEvalObject(
                "ResolvedImport",
                ["revision", "entry", "files"],
                [revision, entry, files]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "importSource" &&
        expression.children.size == 4) {
        val name = evaluator.evaluate(expression.children[0])
        val identity = evaluator.evaluate(expression.children[1])
        val selector = evaluator.evaluate(expression.children[2])
        val resolver = evaluator.evaluate(expression.children[3])
        if (name.kind == "string" && identity.kind == "string" &&
            selector.kind == "string" &&
            (resolver.kind == "closure" || resolver.kind == "function")) {
            result = bootstrapEvalObject(
                "ImportSource",
                [
                    "name", "identity", "selector", "provider",
                    "source", "selectorKind", "resolver",
                    "resolvedRevision", "resolvedEntry", "resolvedFiles"
                ],
                [
                    name, identity, selector,
                    bootstrapEvalString("content"),
                    bootstrapEvalString(""), bootstrapEvalString(""),
                    resolver, bootstrapEvalString(""),
                    bootstrapEvalString(""), bootstrapEvalArray([])
                ]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    // This evaluator-only operation is intentionally absent from semantic
    // builtins: package update may synthesize it, user programs cannot.
    if (targetName == "__ablaResolveImportSource" &&
        bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 1024) &&
        expression.children.size == 1) {
        val source = evaluator.evaluate(expression.children[0])
        if (source.kind == "object" && source.owner == "ImportSource" &&
            source.elements.size == 10 &&
            (source.elements[6].kind == "closure" ||
             source.elements[6].kind == "function")) {
            val resolverName = "__abla_import_resolver_${evaluator.steps}"
            evaluator.names.append(resolverName)
            evaluator.values.append(source.elements[6])
            evaluator.mutable.append(false)
            val resolved = evaluator.evaluateCall(BootstrapExpression(
                "call", resolverName, expression.begin,
                expression.end, []
            ))
            if (resolved.kind == "object" &&
                resolved.owner == "ResolvedImport" &&
                resolved.elements.size == 3) {
                result = bootstrapEvalObject(
                    "ImportSource",
                    source.fieldNames,
                    [
                        source.elements[0], source.elements[1],
                        source.elements[2], source.elements[3],
                        source.elements[4], source.elements[5],
                        source.elements[6], resolved.elements[0],
                        resolved.elements[1], resolved.elements[2]
                    ]
                )
            } else evaluator.errors = evaluator.errors + 1
        } else if (source.kind == "object" &&
            source.owner == "ImportSource" && source.elements.size == 10 &&
            source.elements[3].kind == "string" &&
            source.elements[3].text == "git") {
            result = source
        } else evaluator.errors = evaluator.errors + 1
    }
    // Git remains one provider implementation of the generic source
    // contract. The package updater owns Git/network authority.
    if (targetName == "gitImportSource" &&
        expression.children.size == 4) {
        val name = evaluator.evaluate(expression.children[0])
        val source = evaluator.evaluate(expression.children[1])
        val selectorKind = evaluator.evaluate(expression.children[2])
        val selector = evaluator.evaluate(expression.children[3])
        if (name.kind == "string" && source.kind == "string" &&
            selectorKind.kind == "string" && selector.kind == "string") {
            result = bootstrapEvalObject(
                "ImportSource",
                [
                    "name", "identity", "selector", "provider",
                    "source", "selectorKind", "resolver",
                    "resolvedRevision", "resolvedEntry", "resolvedFiles"
                ],
                [
                    name, bootstrapEvalString("git:${source.text}"),
                    selector, bootstrapEvalString("git"), source,
                    selectorKind, bootstrapEvalNull(),
                    bootstrapEvalString(""), bootstrapEvalString(""),
                    bootstrapEvalArray([])
                ]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "github" && expression.children.size == 1) {
        val repository = evaluator.evaluate(expression.children[0])
        if (repository.kind == "string") {
            var slash = -1
            var index = 0
            while (index < repository.text.size) {
                if (repository.text[index] == 47) slash = index
                index = index + 1
            }
            val name = repository.text.slice(slash + 1, repository.text.size)
            val source = bootstrapEvalString(
                "https://github.com/${repository.text}.git"
            )
            result = bootstrapEvalObject(
                "ImportSource",
                [
                    "name", "identity", "selector", "provider",
                    "source", "selectorKind", "resolver",
                    "resolvedRevision", "resolvedEntry", "resolvedFiles"
                ],
                [
                    bootstrapEvalString(name),
                    bootstrapEvalString("github:${repository.text}"),
                    bootstrapEvalString("HEAD"),
                    bootstrapEvalString("git"), source,
                    bootstrapEvalString("head"), bootstrapEvalNull(),
                    bootstrapEvalString(""), bootstrapEvalString(""),
                    bootstrapEvalArray([])
                ]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
fun bootstrapEvaluateCallReflection(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    // Compiler reflection handles are declaration indexes. They are
    // stable for one compilation and need no host state, so reflection
    // works identically in the self-hosted compile-time evaluator.
    if (targetName == "compilerFindType") {
        val name = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalInteger(evaluator.reflectedTypeHandle(name.text))
    }
    if (targetName == "typedExpressionTypeHandle") {
        val syntaxHandle = evaluator.evaluate(expression.children[0]).integer
        if (syntaxHandle >= 0 && syntaxHandle < evaluator.syntax.size) {
            val syntaxExpression = evaluator.syntax[syntaxHandle]
            val typed = evaluator.typedCallIndex(syntaxExpression)
            var type = evaluator.staticSyntaxType(syntaxExpression)
            if (typed >= 0) type = evaluator.typedCalls[typed].type
            if ((syntaxExpression.kind == "call" ||
                 syntaxExpression.kind == "member.call") && typed < 0) {
                evaluator.errors = evaluator.errors + 1
            } else result = bootstrapEvalInteger(
                evaluator.reflectedTypeHandle(type)
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctionParameterTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val parameter = evaluator.evaluate(expression.children[1]).integer
        val type = evaluator.functionHandleParameterType(handle, parameter)
        val typeHandle = evaluator.reflectedTypeHandle(type)
        if (evaluator.functionHandleValid(handle) && typeHandle >= 0) {
            result = bootstrapEvalInteger(typeHandle)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctionResultTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val typeHandle = evaluator.reflectedTypeHandle(
            evaluator.functionHandleResultType(handle)
        )
        if (evaluator.functionHandleValid(handle) && typeHandle >= 0) {
            result = bootstrapEvalInteger(typeHandle)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerClassFieldTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val field = evaluator.evaluate(expression.children[1]).integer
        val typeHandle = evaluator.reflectedTypeHandle(
            evaluator.classFieldType(handle, field)
        )
        if (typeHandle >= 0) result = bootstrapEvalInteger(typeHandle)
        else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerTypeName" ||
        targetName == "compilerTypeModuleIdentity" ||
        targetName == "compilerTypeKind" ||
        targetName == "compilerTypeIsNullable" ||
        targetName == "compilerTypeIsAffine" ||
        targetName == "compilerTypeArgumentCount" ||
        targetName == "compilerTypeElement" ||
        targetName == "compilerTypeResult" ||
        targetName == "compilerTypeDeclaration") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.reflectedTypeValid(handle)) {
            val type = evaluator.reflectedTypes[handle]
            val kind = evaluator.reflectedTypeKind(type)
            if (targetName == "compilerTypeName") {
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(type)
                )
            }
            if (targetName == "compilerTypeModuleIdentity") {
                var nominal = type
                if (bootstrapIsNullableType(nominal)) {
                    nominal = bootstrapNullableElementType(nominal)
                }
                result = bootstrapEvalString(
                    bootstrapCanonicalDeclarationModuleIdentity(nominal)
                )
            }
            if (targetName == "compilerTypeKind") {
                result = bootstrapEvalString(kind)
            }
            if (targetName == "compilerTypeIsNullable") {
                result = bootstrapEvalBoolean(bootstrapIsNullableType(type))
            }
            if (targetName == "compilerTypeIsAffine") {
                result = bootstrapEvalBoolean(bootstrapSummaryTypeIsAffine(
                    type,
                    evaluator.affineTypes
                ))
            }
            if (targetName == "compilerTypeArgumentCount") {
                var count = 0
                if (kind == "nullable" || kind == "array" ||
                    kind == "shared" || kind == "weak" ||
                    kind == "mutex" || kind == "borrow" ||
                    kind == "pointer") count = 1
                if (bootstrapIsFunctionType(type)) {
                    count = bootstrapFunctionParameterCount(type)
                }
                result = bootstrapEvalInteger(count)
            }
            if (targetName == "compilerTypeElement") {
                val element = evaluator.reflectedTypeHandle(
                    evaluator.reflectedTypeElement(type)
                )
                if (element >= 0) result = bootstrapEvalInteger(element)
                else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerTypeResult") {
                val resultType = evaluator.reflectedTypeHandle(
                    bootstrapFunctionResultType(type)
                )
                if (bootstrapIsFunctionType(type) && resultType >= 0) {
                    result = bootstrapEvalInteger(resultType)
                } else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerTypeDeclaration") {
                var declaration = -1
                var candidate = 0
                while (candidate < evaluator.declarations.size) {
                    if (evaluator.declarations[candidate].kind == "class" &&
                        bootstrapNormalizeType(
                            evaluator.declarations[candidate].name
                        ) == type) declaration = candidate
                    candidate = candidate + 1
                }
                result = bootstrapEvalInteger(declaration)
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerTypeArgument") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val argument = evaluator.evaluate(expression.children[1]).integer
        if (evaluator.reflectedTypeValid(handle)) {
            val type = evaluator.reflectedTypes[handle]
            var argumentType = "unknown"
            val kind = evaluator.reflectedTypeKind(type)
            if (argument == 0 && (kind == "nullable" || kind == "array" ||
                kind == "shared" || kind == "weak" || kind == "mutex" ||
                kind == "borrow" || kind == "pointer")) {
                argumentType = evaluator.reflectedTypeElement(type)
            }
            if (bootstrapIsFunctionType(type) && argument >= 0 &&
                argument < bootstrapFunctionParameterCount(type)) {
                argumentType = bootstrapFunctionParameterType(type, argument)
            }
            val argumentHandle = evaluator.reflectedTypeHandle(argumentType)
            if (argumentHandle >= 0) {
                result = bootstrapEvalInteger(argumentHandle)
            } else evaluator.errors = evaluator.errors + 1
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctions") {
        val handles: array<BootstrapEvalValue> = []
        var declarationIndex = 0
        while (declarationIndex < evaluator.declarations.size) {
            val declaration = evaluator.declarations[declarationIndex]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner != "Compiler" &&
                declaration.extensionOwner != "FunctionReference" &&
                declaration.extensionOwner != "IndependentModule") {
                handles.append(bootstrapEvalInteger(declarationIndex))
            }
            var method = 0
            while (method < declaration.methods.size) {
                handles.append(bootstrapEvalInteger(
                    evaluator.methodHandle(declarationIndex, method)
                ))
                method = method + 1
            }
            declarationIndex = declarationIndex + 1
        }
        result = bootstrapEvalArray(handles)
    }
    if (targetName == "compilerBindings") {
        val handles: array<BootstrapEvalValue> = []
        var declaration = 0
        while (declaration < evaluator.declarations.size) {
            if (bootstrapDeclarationIsValue(
                evaluator.declarations[declaration].kind
            )) handles.append(bootstrapEvalInteger(declaration))
            declaration = declaration + 1
        }
        result = bootstrapEvalArray(handles)
    }
    if (targetName == "compilerFunctionsAnnotated") {
        val annotation = evaluator.evaluate(expression.children[0])
        val handles: array<BootstrapEvalValue> = []
        if (annotation.kind == "string") {
            var declarationIndex = 0
            while (declarationIndex < evaluator.declarations.size) {
                val declaration = evaluator.declarations[declarationIndex]
                var matched = false
                var annotationIndex = 0
                while (annotationIndex < declaration.annotations.size) {
                    if (declaration.annotations[annotationIndex] ==
                        annotation.text) matched = true
                    annotationIndex = annotationIndex + 1
                }
                if (matched && declaration.kind == "fun" &&
                    declaration.extensionOwner == "") {
                    handles.append(bootstrapEvalInteger(declarationIndex))
                }
                declarationIndex = declarationIndex + 1
            }
            result = bootstrapEvalArray(handles)
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
fun bootstrapEvaluateCallText(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "ablaUtf8EncodeScalar") {
        val scalar = evaluator.evaluate(expression.children[0])
        if (scalar.kind == "integer") {
            result = bootstrapEvalString(utf8Encode(scalar.integer))
        } else evaluator.errors = evaluator.errors + 1
    }
    // Compile-time code is a program the compiler runs with no arguments: no
    // arguments, and an empty program path (index -1).
    if (expression.children.size == 0 &&
        (targetName == "ablaLinuxArgumentCount" ||
         targetName == "ablaHostArgumentCount")) {
        result = bootstrapEvalInteger(0)
    }
    if (expression.children.size == 1 &&
        (targetName == "ablaLinuxArgument" || targetName == "ablaHostArgument")) {
        evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString("")
    }
    // Compile-time code cannot reach raw memory; ablaAtCompileTime lets the
    // standard library take a plain path here.
    if (targetName == "ablaAtCompileTime") result = bootstrapEvalBoolean(true)
    // Compile-time code runs in the compiler's memory, not in a program
    // heap, so the runtime memory API (the builtins sema admits at compile
    // time) answers as an empty, unbounded heap: nothing live, nothing
    // collected, no limit.
    if (expression.children.size == 0 &&
        (targetName == "runtimeMemoryCollect" ||
         targetName == "runtimeMemoryLiveBytes" ||
         targetName == "runtimeMemoryCheckpoint" ||
         targetName == "runtimeMemoryLimit")) {
        result = bootstrapEvalInteger(0)
    }
    if (expression.children.size == 1 &&
        (targetName == "runtimeMemoryReset" ||
         targetName == "runtimeMemorySetLimit")) {
        evaluator.evaluate(expression.children[0])
        result = bootstrapEvalVoid()
    }
    val floatIntrinsic = bootstrapEvalFloatIntrinsic(targetName)
    if (floatIntrinsic && expression.children.size == 1) {
        result = bootstrapEvalFloatCall(
            targetName, evaluator.evaluate(expression.children[0])
        )
        if (result.kind == "invalid") {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "$targetName expected a number"
            )
        }
    }
    if (targetName == "ablaByteEncode") {
        val byte = evaluator.evaluate(expression.children[0])
        if (byte.kind == "integer") {
            result = bootstrapEvalString(byteEncode(byte.integer))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "ablaTextFindSequence") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val sequence = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[1])
        )
        val begin = evaluator.evaluate(expression.children[2])
        val end = evaluator.evaluate(expression.children[3])
        if (text.kind == "string" && sequence.kind == "string" &&
            begin.kind == "integer" && end.kind == "integer") {
            var found = -1
            val beginOffset = begin.integer
            val endOffset = end.integer
            val sequenceLength = sequence.text.size
            if (beginOffset >= 0 && endOffset >= beginOffset &&
                endOffset <= text.text.size) {
                if (sequenceLength == 0) found = beginOffset
                else if (sequenceLength <= endOffset - beginOffset) {
                    var offset = beginOffset
                    val last = endOffset - sequenceLength
                    while (found < 0 && offset <= last) {
                        var equal = true
                        var index = 0
                        while (equal && index < sequenceLength) {
                            equal = text.text[offset + index] ==
                                sequence.text[index]
                            index = index + 1
                        }
                        if (equal) found = offset
                        offset = offset + 1
                    }
                }
            }
            result = bootstrapEvalInteger(found)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextFindSequence expected two strings and two integer bounds"
            )
        }
    }
    if (targetName == "ablaTextFindByte") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val byte = evaluator.evaluate(expression.children[1])
        val begin = evaluator.evaluate(expression.children[2])
        val end = evaluator.evaluate(expression.children[3])
        if (text.kind == "string" && byte.kind == "integer" &&
            begin.kind == "integer" && end.kind == "integer") {
            var found = -1
            var offset = begin.integer
            if (byte.integer >= 0 && byte.integer <= 255 &&
                offset >= 0 && end.integer >= offset &&
                end.integer <= text.text.size) {
                while (found < 0 && offset < end.integer) {
                    if (text.text[offset] == byte.integer) found = offset
                    offset = offset + 1
                }
            }
            result = bootstrapEvalInteger(found)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextFindByte expected a string and three integer arguments"
            )
        }
    }
    if (targetName == "ablaTextAsciiEqualInsensitive") {
        val left = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val right = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[1])
        )
        if (left.kind == "string" && right.kind == "string") {
            var equal = left.text.size == right.text.size
            var index = 0
            while (equal && index < left.text.size) {
                var leftByte = left.text[index]
                var rightByte = right.text[index]
                if (leftByte >= 65 && leftByte <= 90) {
                    leftByte = leftByte + 32
                }
                if (rightByte >= 65 && rightByte <= 90) {
                    rightByte = rightByte + 32
                }
                equal = leftByte == rightByte
                index = index + 1
            }
            result = bootstrapEvalBoolean(equal)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextAsciiEqualInsensitive expected two strings"
            )
        }
    }
    if (targetName == "ablaTextReadU32LittleEndian") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val offset = evaluator.evaluate(expression.children[1])
        if (text.kind == "string" && offset.kind == "integer") {
            var value = -1
            if (offset.integer >= 0 &&
                offset.integer + 4 <= text.text.size) {
                value = bitOr(
                    bitOr(
                        text.text[offset.integer],
                        bitShiftLeft(text.text[offset.integer + 1], 8)
                    ),
                    bitOr(
                        bitShiftLeft(text.text[offset.integer + 2], 16),
                        bitShiftLeft(text.text[offset.integer + 3], 24)
                    )
                )
            }
            result = bootstrapEvalInteger(value)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextReadU32LittleEndian expected a string and integer offset"
            )
        }
    }
    if (targetName == "ablaBase64Encode") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            result = bootstrapEvalString(
                bootstrapEvalBase64Encode(text.text)
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaBase64Encode expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaBase64Decode") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            result = bootstrapEvalString(
                bootstrapEvalBase64Decode(text.text)
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaBase64Decode expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaByteChunksJoin") {
        val chunks = evaluator.evaluate(expression.children[0])
        val byteCount = evaluator.evaluate(expression.children[1])
        if (byteCount.kind == "integer") {
            result = bootstrapEvalByteChunksJoin(
                chunks, byteCount.integer
            )
            if (result.kind == "invalid") {
                evaluator.errors = evaluator.errors + 1
                evaluator.recordEvaluatorDiagnostic(
                    "E_EVAL_INTRINSIC_ARGUMENT",
                    "ablaByteChunksJoin received inconsistent chunks"
                )
            }
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaByteChunksJoin expected integer byte count, got ${byteCount.kind}"
            )
        }
    }
    if (targetName == "ablaTextIsValidUtf8") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            result = bootstrapEvalBoolean(utf8Info(text.text).valid)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextIsValidUtf8 expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaJsonFindPlainStringEnd") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        val end = evaluator.evaluate(expression.children[2])
        if (text.kind == "string" && begin.kind == "integer" &&
            end.kind == "integer") {
            var found = -1
            var offset = begin.integer
            var plain = offset >= 0 && end.integer >= offset &&
                end.integer <= text.text.size
            while (plain && found < 0 && offset < end.integer) {
                val lead = text.text[offset]
                if (lead == 34) found = offset
                else if (lead == 92 || lead < 32) plain = false
                else if (lead < 128) offset = offset + 1
                else {
                    var count = 0
                    if (lead >= 194 && lead <= 223) count = 2
                    if (lead >= 224 && lead <= 239) count = 3
                    if (lead >= 240 && lead <= 244) count = 4
                    plain = count > 0 && offset + count <= end.integer
                    var index = 1
                    while (plain && index < count) {
                        val byte = text.text[offset + index]
                        plain = byte >= 128 && byte <= 191
                        index = index + 1
                    }
                    if (plain && count == 3 && lead == 224) {
                        plain = text.text[offset + 1] >= 160
                    }
                    if (plain && count == 3 && lead == 237) {
                        plain = text.text[offset + 1] <= 159
                    }
                    if (plain && count == 4 && lead == 240) {
                        plain = text.text[offset + 1] >= 144
                    }
                    if (plain && count == 4 && lead == 244) {
                        plain = text.text[offset + 1] <= 143
                    }
                    if (plain) offset = offset + count
                }
            }
            result = bootstrapEvalInteger(found)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonFindPlainStringEnd expected a string and two integer bounds"
            )
        }
    }
    if (targetName == "ablaJsonStringIsPlain") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            var plain = utf8Info(text.text).valid
            var index = 0
            while (plain && index < text.text.size) {
                val byte = text.text[index]
                plain = byte >= 32 && byte != 34 && byte != 92
                index = index + 1
            }
            result = bootstrapEvalBoolean(plain)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonStringIsPlain expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaJsonMatchCompactObjectField") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val offset = evaluator.evaluate(expression.children[1])
        val name = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[2])
        )
        val comma = evaluator.evaluate(expression.children[3])
        if (text.kind == "string" && offset.kind == "integer" &&
            name.kind == "string" && comma.kind == "boolean") {
            var cursor = offset.integer
            var matches = cursor >= 0 && cursor <= text.text.size
            if (matches && comma.boolean) {
                matches = cursor < text.text.size &&
                    text.text[cursor] == 44
                cursor = cursor + 1
            }
            val end = cursor + 1 + name.text.size
            matches = matches && cursor < text.text.size &&
                text.text[cursor] == 34 && end + 1 < text.text.size &&
                text.text.slice(cursor + 1, end) == name.text &&
                text.text[end] == 34 && text.text[end + 1] == 58
            result = bootstrapEvalInteger(if (matches) end + 2 else -1)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonMatchCompactObjectField expected two strings, an integer offset, and a boolean"
            )
        }
    }
    if (targetName == "ablaJsonCompactArrayNext") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val offset = evaluator.evaluate(expression.children[1])
        val first = evaluator.evaluate(expression.children[2])
        if (text.kind == "string" && offset.kind == "integer" &&
            first.kind == "boolean") {
            var cursor = offset.integer
            var compact = cursor >= 0 && cursor < text.text.size
            if (compact && !first.boolean) {
                compact = text.text[cursor] == 44
                cursor = cursor + 1
                compact = compact && cursor < text.text.size
            }
            var encoded = 0
            if (compact) {
                val byte = text.text[cursor]
                if (byte == 93) {
                    if (first.boolean) encoded = 0 - cursor - 2
                } else if (byte != 32 && byte != 9 && byte != 10 &&
                           byte != 13) encoded = cursor + 1
            }
            result = bootstrapEvalInteger(encoded)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonCompactArrayNext expected a string, integer offset, and boolean"
            )
        }
    }
    if (targetName == "ablaJsonAvailableIntegerEnd") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        if (text.kind == "string" && begin.kind == "integer") {
            var cursor = begin.integer
            var negative = false
            var valid = cursor >= 0 && cursor < text.text.size
            if (valid && text.text[cursor] == 45) {
                negative = true
                cursor = cursor + 1
            }
            val digitBegin = cursor
            if (valid && cursor < text.text.size &&
                text.text[cursor] == 48) {
                cursor = cursor + 1
                if (cursor < text.text.size &&
                    text.text[cursor] >= 48 &&
                    text.text[cursor] <= 57) valid = false
            } else if (valid && cursor < text.text.size &&
                text.text[cursor] >= 49 && text.text[cursor] <= 57) {
                while (cursor < text.text.size &&
                       text.text[cursor] >= 48 &&
                       text.text[cursor] <= 57) cursor = cursor + 1
            } else valid = false
            if (valid && cursor < text.text.size &&
                (text.text[cursor] == 43 || text.text[cursor] == 45 ||
                 text.text[cursor] == 46 || text.text[cursor] == 101 ||
                 text.text[cursor] == 69)) valid = false
            val digits = cursor - digitBegin
            if (valid && digits > 19) valid = false
            if (valid && digits == 19) {
                var accumulator = 0
                var index = digitBegin
                while (valid && index < cursor) {
                    val digit = text.text[index] - 48
                    if (accumulator < -922337203685477580 ||
                        (accumulator == -922337203685477580 &&
                         digit > (if (negative) 8 else 7))) valid = false
                    else accumulator = accumulator * 10 - digit
                    index = index + 1
                }
            }
            result = bootstrapEvalInteger(if (valid) cursor else -1)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonAvailableIntegerEnd expected a string and integer offset"
            )
        }
    }
    if (targetName == "ablaJsonIntegerValueAt") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        val end = evaluator.evaluate(expression.children[2])
        if (text.kind == "string" && begin.kind == "integer" &&
            end.kind == "integer" && begin.integer >= 0 &&
            end.integer > begin.integer &&
            end.integer <= text.text.size) {
            val negative = text.text[begin.integer] == 45
            var cursor = if (negative) begin.integer + 1
                else begin.integer
            var value = 0
            while (cursor < end.integer) {
                value = value * 10 - (text.text[cursor] - 48)
                cursor = cursor + 1
            }
            result = bootstrapEvalInteger(if (negative) value else 0 - value)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonIntegerValueAt expected a string and two integer bounds"
            )
        }
    }
    if (targetName == "ablaJsonWhitespaceEnd") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        if (text.kind == "string" && begin.kind == "integer") {
            var cursor = begin.integer
            var scanning = cursor >= 0 && cursor <= text.text.size
            while (scanning && cursor < text.text.size) {
                val byte = text.text[cursor]
                scanning = byte == 32 || byte == 9 || byte == 10 ||
                    byte == 13
                if (scanning) cursor = cursor + 1
            }
            result = bootstrapEvalInteger(cursor)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonWhitespaceEnd expected a string and integer offset"
            )
        }
    }
    result
}

@noinline
fun bootstrapEvaluateCallCompiler(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "compilerFindFunction") {
        val name = evaluator.evaluate(expression.children[0])
        var handle = -1
        var declarationIndex = 0
        while (declarationIndex < evaluator.declarations.size) {
            val declaration = evaluator.declarations[declarationIndex]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun" ||
                 declaration.kind == "extern") &&
                declaration.extensionOwner == "" &&
                declaration.name == name.text) handle = declarationIndex
            if (declaration.extensionOwner != "" &&
                "${declaration.extensionOwner}.${declaration.name}" ==
                    name.text) handle = declarationIndex
            var method = 0
            while (method < declaration.methods.size) {
                if ("${declaration.name}.${declaration.methods[method].name}" ==
                    name.text) {
                    handle = evaluator.methodHandle(declarationIndex, method)
                }
                method = method + 1
            }
            declarationIndex = declarationIndex + 1
        }
        result = bootstrapEvalInteger(handle)
    }
    if (targetName == "compilerFindBinding") {
        val name = evaluator.evaluate(expression.children[0])
        var handle = -1
        var declaration = 0
        while (declaration < evaluator.declarations.size) {
            val candidate = evaluator.declarations[declaration]
            if (bootstrapDeclarationIsValue(candidate.kind) &&
                candidate.name == name.text) handle = declaration
            declaration = declaration + 1
        }
        result = bootstrapEvalInteger(handle)
    }
    if (targetName == "compilerBindingName" ||
        targetName == "compilerBindingIsDelegated" ||
        targetName == "compilerBindingExposedType" ||
        targetName == "compilerBindingDelegateType" ||
        targetName == "compilerBindingIsMutable" ||
        targetName == "compilerBindingGetter" ||
        targetName == "compilerBindingSetter" ||
        targetName == "compilerBindingCanReplaceDelegate" ||
        targetName == "compilerBindingByBegin" ||
        targetName == "compilerBindingByEnd") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.bindingHandleValid(handle)) {
            val declaration = evaluator.declarations[handle]
            val delegated = evaluator.bindingIsDelegated(handle)
            val mutable = declaration.kind == "var" ||
                declaration.kind == "compile.var"
            if (targetName == "compilerBindingName") {
                result = bootstrapEvalString(declaration.name)
            }
            if (targetName == "compilerBindingIsDelegated") {
                result = bootstrapEvalBoolean(delegated)
            }
            if (targetName == "compilerBindingExposedType") {
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(
                        evaluator.bindingExposedType(handle)
                    )
                )
            }
            if (targetName == "compilerBindingDelegateType") {
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(
                        evaluator.bindingDelegateType(handle)
                    )
                )
            }
            if (targetName == "compilerBindingIsMutable") {
                result = bootstrapEvalBoolean(mutable)
            }
            if (targetName == "compilerBindingGetter") {
                result = bootstrapEvalInteger(
                    evaluator.bindingMethodHandle(handle, "getValue")
                )
            }
            if (targetName == "compilerBindingSetter") {
                result = bootstrapEvalInteger(
                    evaluator.bindingMethodHandle(handle, "setValue")
                )
            }
            if (targetName == "compilerBindingCanReplaceDelegate") {
                result = bootstrapEvalBoolean(delegated && mutable)
            }
            if (targetName == "compilerBindingByBegin") {
                result = bootstrapEvalInteger(
                    if (delegated) declaration.expression.begin else -1
                )
            }
            if (targetName == "compilerBindingByEnd") {
                result = bootstrapEvalInteger(
                    if (delegated) declaration.expression.end else -1
                )
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctionName" ||
        targetName == "compilerFunctionCanonicalIdentity" ||
        targetName == "compilerFunctionModuleIdentity" ||
        targetName == "compilerFunctionOwner" ||
        targetName == "compilerFunctionParameterCount" ||
        targetName == "compilerFunctionParameterName" ||
        targetName == "compilerFunctionParameterType" ||
        targetName == "compilerFunctionResultType" ||
        targetName == "compilerFunctionAnnotationCount" ||
        targetName == "compilerFunctionAnnotation" ||
        targetName == "compilerFunctionIsCompileOnly" ||
        targetName == "compilerFunctionIsTrusted" ||
        targetName == "compilerFunctionIsExternal") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val validHandle = evaluator.functionHandleValid(handle)
        if (validHandle) {
            val owner = evaluator.functionHandleOwner(handle)
            val method = evaluator.functionHandleMethod(handle)
            var declarationIndex = handle
            if (owner >= 0) declarationIndex = owner
            var declaration = evaluator.declarations[declarationIndex]
            if (owner >= 0) {
                declaration = evaluator.declarations[owner].methods[method]
            }
            if (targetName == "compilerFunctionName") {
                result = bootstrapEvalString(
                    bootstrapCanonicalDeclarationSourceName(
                        declaration.name
                    )
                )
            }
            if (targetName == "compilerFunctionModuleIdentity") {
                var canonicalName = declaration.name
                if (owner >= 0) {
                    canonicalName = evaluator.declarations[owner].name
                }
                result = bootstrapEvalString(
                    bootstrapCanonicalDeclarationModuleIdentity(
                        canonicalName
                    )
                )
            }
            if (targetName == "compilerFunctionOwner") {
                var ownerName = declaration.extensionOwner
                if (owner >= 0) {
                    ownerName = evaluator.declarations[owner].name
                }
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(ownerName)
                )
            }
            if (targetName == "compilerFunctionCanonicalIdentity") {
                var identity = declaration.name
                if (owner >= 0) {
                    identity = "${evaluator.declarations[owner].name}.${declaration.name}"
                } else if (declaration.extensionOwner != "") {
                    identity = "${bootstrapNormalizeType(
                        declaration.extensionOwner
                    )}.${declaration.name}"
                }
                result = bootstrapEvalString(identity)
            }
            if (targetName == "compilerFunctionParameterCount") {
                result = bootstrapEvalInteger(declaration.parameters.size)
            }
            if (targetName == "compilerFunctionParameterName") {
                val parameter = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (parameter >= 0 &&
                    parameter < declaration.parameters.size) {
                    result = bootstrapEvalString(
                        declaration.parameters[parameter]
                    )
                } else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerFunctionParameterType") {
                val parameter = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (parameter >= 0 &&
                    parameter < declaration.parameterTypes.size) {
                    result = bootstrapEvalString(bootstrapSourceVisibleType(
                        bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                    ))
                } else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerFunctionResultType") {
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(bootstrapNormalizeType(
                        declaration.resultType
                    ))
                )
            }
            if (targetName == "compilerFunctionAnnotationCount") {
                result = bootstrapEvalInteger(declaration.annotations.size)
            }
            if (targetName == "compilerFunctionAnnotation") {
                val annotation = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (annotation >= 0 &&
                    annotation < declaration.annotations.size) {
                    result = bootstrapEvalString(
                        declaration.annotations[annotation]
                    )
                } else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerFunctionIsCompileOnly") {
                result = bootstrapEvalBoolean(
                    declaration.kind == "compile.fun"
                )
            }
            if (targetName == "compilerFunctionIsTrusted") {
                result = bootstrapEvalBoolean(declaration.isTrusted)
            }
            if (targetName == "compilerFunctionIsExternal") {
                result = bootstrapEvalBoolean(
                    declaration.kind == "extern"
                )
            }
        }
        if (!validHandle) {
            evaluator.recordInvalidFunctionHandle(targetName, handle)
        }
    }
    if (targetName == "compilerFunctionGenericSubstitutionCount" ||
        targetName == "compilerFunctionGenericSubstitutionName" ||
        targetName == "compilerFunctionGenericSubstitutionTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.functionHandleValid(handle)) {
            if (targetName ==
                "compilerFunctionGenericSubstitutionCount") {
                result = bootstrapEvalInteger(0)
            } else {
                evaluator.evaluate(expression.children[1])
                evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFindClass") {
        val name = evaluator.evaluate(expression.children[0]).text
        var handle = -1
        var declaration = 0
        while (declaration < evaluator.declarations.size) {
            if (evaluator.declarations[declaration].kind == "class" &&
                evaluator.declarations[declaration].name == name) {
                handle = declaration
            }
            declaration = declaration + 1
        }
        result = bootstrapEvalInteger(handle)
    }
    if (targetName == "compilerClassFieldCount" ||
        targetName == "compilerClassFieldName" ||
        targetName == "compilerClassFieldType" ||
        targetName == "compilerClassFieldIsMutable") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val valid = handle >= 0 && handle < evaluator.declarations.size &&
            evaluator.declarations[handle].kind == "class"
        if (valid) {
            val declaration = evaluator.declarations[handle]
            if (targetName == "compilerClassFieldCount") {
                var count = 0
                var parameter = 0
                while (parameter < declaration.parameterKinds.size) {
                    if (declaration.parameterKinds[parameter] == "val" ||
                        declaration.parameterKinds[parameter] == "var") {
                        count = count + 1
                    }
                    parameter = parameter + 1
                }
                result = bootstrapEvalInteger(count)
            } else {
                val wanted = evaluator.evaluate(
                    expression.children[1]
                ).integer
                var field = -1
                var count = 0
                var parameter = 0
                while (parameter < declaration.parameterKinds.size) {
                    if (declaration.parameterKinds[parameter] == "val" ||
                        declaration.parameterKinds[parameter] == "var") {
                        if (count == wanted) field = parameter
                        count = count + 1
                    }
                    parameter = parameter + 1
                }
                if (field >= 0) {
                    if (targetName == "compilerClassFieldName") {
                        result = bootstrapEvalString(
                            declaration.parameters[field]
                        )
                    }
                    if (targetName == "compilerClassFieldType") {
                        result = bootstrapEvalString(bootstrapNormalizeType(
                            declaration.parameterTypes[field]
                        ))
                    }
                    if (targetName == "compilerClassFieldIsMutable") {
                        result = bootstrapEvalBoolean(
                            declaration.parameterKinds[field] == "var"
                        )
                    }
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerRegisterSubparser") {
        var argument = 0
        while (argument < expression.children.size) {
            evaluator.evaluate(expression.children[argument])
            argument = argument + 1
        }
        result = bootstrapEvalVoid()
    }
    if (targetName == "compilerGrant") {
        evaluator.evaluate(expression.children[0])
        result = bootstrapEvalVoid()
    }
    if (targetName == "compilerGenerateModule") {
        evaluator.evaluate(expression.children[0])
        evaluator.evaluate(expression.children[1])
        result = bootstrapEvalVoid()
    }
    if (targetName == "compilerReplaceFunctionBody") {
        val reflected = evaluator.evaluate(expression.children[0])
        val body = evaluator.evaluate(expression.children[1])
        var valid = reflected.kind == "integer" &&
            body.kind == "string" &&
            evaluator.functionHandleValid(reflected.integer) &&
            reflected.integer < evaluator.declarations.size &&
            evaluator.declarations[reflected.integer].kind == "fun"
        if (valid) valid = bootstrapStageFunctionBodyReplacement(
            BootstrapFunctionBodyReplacement(
                reflected.integer,
                body.text
            )
        )
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_REQUEST",
                "compiler.replaceFunctionBody requires one unique top-level runtime function handle and a bounded body inside compiler.transform"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerAddFunctionAnnotation") {
        val reflected = evaluator.evaluate(expression.children[0])
        val annotation = evaluator.evaluate(expression.children[1])
        var valid = reflected.kind == "integer" &&
            annotation.kind == "string" &&
            evaluator.functionHandleValid(reflected.integer) &&
            reflected.integer < evaluator.declarations.size &&
            evaluator.declarations[reflected.integer].kind == "fun"
        if (valid) valid = bootstrapStageFunctionAnnotationAddition(
            BootstrapFunctionAnnotationAddition(
                reflected.integer,
                annotation.text
            )
        )
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_ANNOTATION",
                "compiler.addFunctionAnnotation requires a unique top-level runtime function, a valid annotation name, and compiler.transform context"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerApplyTransform") {
        // This marker is consumed before final semantic analysis. Reaching
        // it in an ordinary evaluator is always a staging error.
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILER_TRANSFORM_PHASE",
            "compiler.transform is only valid as a top-level compile action"
        )
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalBoolean(false)
    }
    if (targetName == "compilerContributeArtifactRoot") {
        val name = evaluator.evaluate(expression.children[0])
        val target = evaluator.evaluate(expression.children[1])
        val artifact = evaluator.evaluate(expression.children[2])
        val output = evaluator.evaluate(expression.children[3])
        val reflected = evaluator.evaluate(expression.children[4])
        val exportName = evaluator.evaluate(expression.children[5])
        val fast = evaluator.evaluate(expression.children[6])
        val cache = evaluator.evaluate(expression.children[7])
        var valid = name.kind == "string" && target.kind == "string" &&
            artifact.kind == "string" && output.kind == "string" &&
            reflected.kind == "integer" &&
            exportName.kind == "string" && fast.kind == "boolean" &&
            cache.kind == "boolean" &&
            reflected.integer >= 0 &&
            reflected.integer < evaluator.declarations.size &&
            evaluator.declarations[reflected.integer].kind == "fun"
        var conflict = false
        var functionName = ""
        if (valid) {
            val declaration = evaluator.declarations[reflected.integer]
            functionName = declaration.name
            val resultType = bootstrapNormalizeType(
                declaration.resultType
            )
            valid = declaration.extensionOwner == "" &&
                (resultType == "void" || resultType == "bool" ||
                 resultType == "i64")
            var parameter = 0
            while (valid && parameter < declaration.parameters.size) {
                val parameterType = bootstrapNormalizeType(
                    declaration.parameterTypes[parameter]
                )
                valid = declaration.parameterKinds[parameter] ==
                    "parameter" &&
                    (parameterType == "bool" || parameterType == "i64")
                parameter = parameter + 1
            }
            var matches = 0
            var candidate = 0
            while (candidate < evaluator.declarations.size) {
                if (evaluator.declarations[candidate].name == functionName &&
                    (evaluator.declarations[candidate].kind == "fun" ||
                     evaluator.declarations[candidate].kind == "extern" ||
                     evaluator.declarations[candidate].kind == "compile.fun")) {
                    matches = matches + 1
                }
                candidate = candidate + 1
            }
            if (matches != 1) valid = false
        }
        if (valid && !bootstrapArtifactSliceActive) {
            valid = bootstrapStageArtifactRootRequest(
                BootstrapArtifactRootRequest(
                    name.text,
                    target.text,
                    artifact.text,
                    output.text,
                    functionName,
                    exportName.text,
                    fast.boolean,
                    cache.boolean
                )
            )
            if (!valid) conflict = true
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            if (conflict) {
                evaluator.recordEvaluatorDiagnostic(
                    "E_ARTIFACT_ROOT_CONFLICT",
                    "compiler.contributeArtifactRoot conflicts with an existing contribution for artifact `${name.text}`; one artifact requires consistent settings and one declaration/export mapping"
                )
            } else {
                evaluator.recordEvaluatorDiagnostic(
                    "E_ARTIFACT_ROOT_REQUEST",
                    "compiler.contributeArtifactRoot requires a unique top-level bool/int function and one consistent bounded artifact contribution"
                )
            }
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerNewIndependentModule") {
        val name = evaluator.evaluate(expression.children[0])
        var handle = -1
        var valid = bootstrapArtifactSliceActive ||
            (name.kind == "string" &&
             bootstrapTargetTokenValid(name.text) &&
             bootstrapIndependentModules.size < 32)
        var module = 0
        while (valid && !bootstrapArtifactSliceActive &&
               module < bootstrapIndependentModules.size) {
            if (bootstrapIndependentModules[module].name == name.text) {
                valid = false
            }
            module = module + 1
        }
        if (valid && !bootstrapArtifactSliceActive) {
            handle = bootstrapIndependentModules.size
            bootstrapIndependentModules.append(
                BootstrapIndependentModuleState(
                    name.text,
                    [], [], [], [], [], [], [], [], [],
                    false
                )
            )
        }
        if (valid) {
            result = bootstrapEvalInteger(handle)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_CREATE",
                "compiler.newModule requires a unique bounded module name"
            )
            evaluator.errors = evaluator.errors + 1
        }
    }
    if (targetName == "compilerIndependentModuleUse") {
        val module = evaluator.evaluate(expression.children[0])
        val reflected = evaluator.evaluate(expression.children[1])
        val annotations = evaluator.evaluate(expression.children[2])
        val exportName = evaluator.evaluate(expression.children[3])
        val checkedExport = evaluator.evaluate(expression.children[4])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             reflected.kind == "integer" &&
             annotations.kind == "array" &&
             exportName.kind == "string" &&
             checkedExport.kind == "boolean" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             reflected.integer >= 0 &&
             reflected.integer < evaluator.declarations.size)
        var functionName = ""
        var sourceIdentity = ""
        if (valid && !bootstrapArtifactSliceActive) {
            val declaration = evaluator.declarations[reflected.integer]
            functionName = declaration.name
            sourceIdentity = declaration.sourceIdentity
            valid = declaration.kind == "fun" &&
                declaration.extensionOwner == "" &&
                bootstrapIndependentModuleSourceValid(sourceIdentity)
            if (valid && exportName.text != "") {
                valid = bootstrapExportNameValid(exportName.text)
            }
            var matches = 0
            var candidate = 0
            while (candidate < evaluator.declarations.size) {
                val found = evaluator.declarations[candidate]
                if ((found.kind == "fun" || found.kind == "extern" ||
                     found.kind == "compile.fun") &&
                    found.extensionOwner == "" &&
                    found.name == functionName) matches = matches + 1
                candidate = candidate + 1
            }
            valid = valid && matches == 1
            var annotation = 0
            while (valid && annotation < annotations.elements.size) {
                val addition = annotations.elements[annotation]
                valid = addition.kind == "string" &&
                    bootstrapTargetTokenValid(addition.text)
                var existing = 0
                while (valid && existing < declaration.annotations.size) {
                    if (declaration.annotations[existing] == addition.text) {
                        valid = false
                    }
                    existing = existing + 1
                }
                var previous = 0
                while (valid && previous < annotation) {
                    if (annotations.elements[previous].text ==
                        addition.text) valid = false
                    previous = previous + 1
                }
                annotation = annotation + 1
            }
        }
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && state.functionNames.size < 128
            var exported = 0
            while (valid && exportName.text != "" &&
                   exported < state.exportNames.size) {
                if (state.exportNames[exported] == exportName.text) {
                    valid = false
                }
                exported = exported + 1
            }
            if (valid) {
                val additions: array<string> = []
                var annotation = 0
                while (annotation < annotations.elements.size) {
                    additions.append(annotations.elements[annotation].text)
                    annotation = annotation + 1
                }
                state.functionNames.append(functionName)
                state.sourceIdentities.append(sourceIdentity)
                state.functionAnnotations.append(additions)
                if (exportName.text != "") {
                    state.exportSourceNames.append(functionName)
                    state.exportNames.append(exportName.text)
                    state.checkedExports.append(checkedExport.boolean)
                }
            }
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_USE",
                "independent module use requires a live module, one unique top-level runtime function reference, new annotation identifiers, and an optional unique valid export"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleExport") {
        val module = evaluator.evaluate(expression.children[0])
        val sourceName = evaluator.evaluate(expression.children[1])
        val exportName = evaluator.evaluate(expression.children[2])
        val checked = evaluator.evaluate(expression.children[3])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             sourceName.kind == "string" &&
             bootstrapIndependentDeclarationNameValid(sourceName.text) &&
             exportName.kind == "string" &&
             bootstrapExportNameValid(exportName.text) &&
             checked.kind == "boolean")
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && state.exportNames.size < 128
            var existing = 0
            while (valid && existing < state.exportNames.size) {
                if (state.exportNames[existing] == exportName.text) {
                    valid = false
                }
                existing = existing + 1
            }
            if (valid) {
                state.exportSourceNames.append(sourceName.text)
                state.exportNames.append(exportName.text)
                state.checkedExports.append(checked.boolean)
            }
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_EXPORT",
                "independent module export requires a live un-emitted module, one declaration identifier, and one unique valid foreign export name"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleDeclare") {
        val module = evaluator.evaluate(expression.children[0])
        val declarations = evaluator.evaluate(expression.children[1])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             declarations.kind == "declaration.block" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             declarations.text.size > 0 &&
             declarations.text.size <= 1048576 &&
             bootstrapIndependentModuleSourceValid(declarations.owner))
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && state.declarationSources.size < 32
            if (valid) {
                state.declarationSources.append(declarations.text)
                state.declarationSourceIdentities.append(declarations.owner)
            }
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_DECLARE",
                "independent module declare requires a declaration block owned by compile-time source and a live un-emitted module"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleDeclareGenerated") {
        val module = evaluator.evaluate(expression.children[0])
        val declarations = evaluator.evaluate(expression.children[1])
        var source = ""
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             declarations.kind == "generated.module" &&
             bootstrapIndependentModuleHandleValid(module.integer))
        if (valid && !bootstrapArtifactSliceActive) {
            var declaration = 0
            while (declaration < declarations.elements.size) {
                if (declarations.elements[declaration].kind ==
                    "generated.declaration") {
                    source = "$source${declarations.elements[declaration].text}"
                }
                declaration = declaration + 1
            }
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && source.size > 0 &&
                source.size <= 1048576 &&
                state.generatedDeclarationSources.size < 32
            if (valid) state.generatedDeclarationSources.append(source)
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_DECLARE_GENERATED",
                "independent module generated declarations require a non-empty compiler-owned builder and a live un-emitted module"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleEmit") {
        val module = evaluator.evaluate(expression.children[0])
        val output = evaluator.evaluate(expression.children[1])
        val target = evaluator.evaluate(expression.children[2])
        val artifact = evaluator.evaluate(expression.children[3])
        val fast = evaluator.evaluate(expression.children[4])
        val cache = evaluator.evaluate(expression.children[5])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             output.kind == "string" &&
             bootstrapCompileOutputPathValid(output.text) &&
             target.kind == "string" &&
             bootstrapTargetTokenValid(target.text) &&
             artifact.kind == "string" &&
             bootstrapTargetTokenValid(artifact.text) &&
             fast.kind == "boolean" && cache.kind == "boolean")
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted &&
                (state.declarationSources.size > 0 ||
                 state.generatedDeclarationSources.size > 0 ||
                 state.exportNames.size > 0)
            val sources: array<string> = []
            var used = 0
            while (valid && used < state.sourceIdentities.size) {
                val source = bootstrapIndependentModuleSourcePath(
                    state.sourceIdentities[used]
                )
                if (!bootstrapIndependentModuleHasSource(sources, source)) {
                    sources.append(source)
                }
                used = used + 1
            }
            var block = 0
            while (valid && block <
                   state.declarationSourceIdentities.size) {
                val source = bootstrapIndependentModuleSourcePath(
                    state.declarationSourceIdentities[block]
                )
                if (!bootstrapIndependentModuleHasSource(sources, source)) {
                    sources.append(source)
                }
                block = block + 1
            }
            var source = ""
            var imported = 0
            while (valid && imported < sources.size) {
                source = "${source}import ${evaluator.generatedStringLiteral(sources[imported])}\n"
                imported = imported + 1
            }
            var annotationCount = 0
            used = 0
            while (used < state.functionAnnotations.size) {
                annotationCount = annotationCount +
                    state.functionAnnotations[used].size
                used = used + 1
            }
            if (annotationCount > 0 || state.exportNames.size > 0) {
                source = "${source}import \"abla/compiler\"\n"
            }
            if (annotationCount > 0) {
                source = "${source}compile fun __abla_independent_annotations(): void {\n"
                used = 0
                while (used < state.functionNames.size) {
                    var annotation = 0
                    while (annotation <
                           state.functionAnnotations[used].size) {
                        val functionLiteral = evaluator.generatedStringLiteral(
                            state.functionNames[used]
                        )
                        val annotationLiteral = evaluator.generatedStringLiteral(
                            state.functionAnnotations[used][annotation]
                        )
                        source = "${source}    compiler.addFunctionAnnotation(compiler.findFunction($functionLiteral), $annotationLiteral)\n"
                        annotation = annotation + 1
                    }
                    used = used + 1
                }
                source = "${source}    return\n}\n#compiler.transform(__abla_independent_annotations)\n"
            }
            block = 0
            while (block < state.declarationSources.size) {
                source = "${source}${state.declarationSources[block]}\n"
                block = block + 1
            }
            block = 0
            while (block < state.generatedDeclarationSources.size) {
                source = "${source}${state.generatedDeclarationSources[block]}\n"
                block = block + 1
            }
            if (state.exportNames.size > 0) {
                var exported = 0
                while (exported < state.exportNames.size) {
                    val sourceLiteral = evaluator.generatedStringLiteral(
                        state.exportSourceNames[exported]
                    )
                    val exportLiteral = evaluator.generatedStringLiteral(
                        state.exportNames[exported]
                    )
                    var method = "exportFunction"
                    if (state.checkedExports[exported]) {
                        method = "exportCheckedFunction"
                    }
                    source = "${source}#compiler.$method(compiler.findFunction($sourceLiteral), $exportLiteral)\n"
                    exported = exported + 1
                }
            }
            val entry =
                "build/.abla-independent/${state.name}.abla-independent.ab"
            if (valid) valid = bootstrapStageToolchainOutput(entry, source)
            if (valid) valid = bootstrapStageCompileProgramRequest(
                BootstrapCompileProgramRequest(
                    state.name, entry, output.text, target.text,
                    artifact.text, fast.boolean, cache.boolean
                )
            )
            if (valid) state.emitted = true
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_EMIT",
                "independent module emit requires a live module with declarations and one valid, unique program output"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerBuildProgram") {
        val name = evaluator.evaluate(expression.children[0])
        val entry = evaluator.evaluate(expression.children[1])
        val output = evaluator.evaluate(expression.children[2])
        val target = evaluator.evaluate(expression.children[3])
        val artifact = evaluator.evaluate(expression.children[4])
        val fast = evaluator.evaluate(expression.children[5])
        val cache = evaluator.evaluate(expression.children[6])
        var valid = name.kind == "string" && name.text.size > 0 &&
            name.text.size <= 128 && entry.kind == "string" &&
            bootstrapCompileOutputPathValid(entry.text) &&
            output.kind == "string" &&
            bootstrapCompileOutputPathValid(output.text) &&
            target.kind == "string" && target.text.size > 0 &&
            target.text.size <= 128 && artifact.kind == "string" &&
            artifact.text.size > 0 && artifact.text.size <= 64 &&
            fast.kind == "boolean" && cache.kind == "boolean"
        if (valid) {
            valid = bootstrapStageCompileProgramRequest(
                BootstrapCompileProgramRequest(
                    name.text, entry.text, output.text, target.text,
                    artifact.text, fast.boolean, cache.boolean
                )
            )
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            bootstrapStageDriverDiagnostic(
                "error[E_BUILD_PROGRAM_REQUEST]: compilerBuildProgram received an invalid or duplicate program node\n"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerDefineTarget") {
        val name = evaluator.evaluate(expression.children[0])
        val triple = evaluator.evaluate(expression.children[1])
        val format = evaluator.evaluate(expression.children[2])
        val linker = evaluator.evaluate(expression.children[3])
        val emulation = evaluator.evaluate(expression.children[4])
        val hosted = evaluator.evaluate(expression.children[5])
        val libcFree = evaluator.evaluate(expression.children[6])
        var valid = name.kind == "string" &&
            triple.kind == "string" && format.kind == "string" &&
            linker.kind == "string" && emulation.kind == "string" &&
            hosted.kind == "boolean" && libcFree.kind == "boolean"
        if (valid && !bootstrapArtifactSliceActive) {
            valid = bootstrapStageDefinedTarget(
            BootstrapDefinedTarget(
                name.text,
                triple.text,
                format.text,
                linker.text,
                emulation.text,
                hosted.boolean,
                libcFree.boolean
            )
            )
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            bootstrapStageDriverDiagnostic(
                "error[E_BUILD_TARGET_DEFINITION]: compilerDefineTarget received an invalid or duplicate bounded target descriptor\n"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerExportFunction" ||
        targetName == "compilerInternalFunction" ||
        targetName == "compilerRequiredInternalFunction" ||
        targetName == "compilerExportCheckedFunction") {
        val reflected = evaluator.evaluate(expression.children[0])
        val exportName = evaluator.evaluate(expression.children[1])
        var valid = reflected.kind == "integer" &&
            exportName.kind == "string" &&
            (if (targetName == "compilerInternalFunction" ||
                targetName == "compilerRequiredInternalFunction") {
                bootstrapLinkerSymbolNameValid(exportName.text)
            } else bootstrapExportNameValid(exportName.text)) &&
            evaluator.functionHandleValid(reflected.integer) &&
            reflected.integer >= 0 &&
            reflected.integer < evaluator.declarations.size
        var source = ""
        var resultType = ""
        var reflectedKind = reflected.kind
        var declarationKind = "out-of-range"
        if (reflected.integer >= 0 &&
            reflected.integer < evaluator.declarations.size) {
            declarationKind =
                evaluator.declarations[reflected.integer].kind
        }
        val parameterNames: array<string> = []
        val parameterTypes: array<string> = []
        if (valid) {
            val declaration = evaluator.declarations[reflected.integer]
            source = declaration.name
            resultType = bootstrapExportRuntimeType(
                evaluator.declarations, declaration.resultType
            )
            valid = declaration.kind == "fun" &&
                declaration.parameters.size <= 16 &&
                bootstrapExportResultTypeValid(resultType)
            var parameter = 0
            while (valid && parameter < declaration.parameters.size) {
                val parameterType = bootstrapExportRuntimeType(
                    evaluator.declarations,
                    declaration.parameterTypes[parameter]
                )
                valid = declaration.parameterKinds[parameter] ==
                    "parameter" &&
                    bootstrapExportParameterTypeValid(parameterType)
                if (valid &&
                    parameterType == "function:(i64)->i64") {
                    valid = bootstrapExportCallbackUseValid(
                        declaration.expression,
                        declaration.parameters[parameter]
                    )
                }
                if (valid) {
                    parameterNames.append(
                        declaration.parameters[parameter]
                    )
                    parameterTypes.append(parameterType)
                }
                parameter = parameter + 1
            }
        }
        var declarationPath = ""
        if (bootstrapArtifactSliceActive) {
            val path = evaluator.slicePathFromReachableUnsupported(
                reflected.integer,
                [],
                evaluator.declarations[reflected.integer].name
            )
            if (path != "") {
                declarationPath = path
                valid = false
            }
        }
        if (valid) valid = bootstrapStageExportRequest(
            BootstrapExportRequest(
                source,
                exportName.text,
                resultType,
                parameterNames,
                parameterTypes,
                targetName == "compilerExportCheckedFunction",
                targetName == "compilerInternalFunction" ||
                    targetName == "compilerRequiredInternalFunction",
                targetName == "compilerRequiredInternalFunction"
            )
        )
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            if (declarationPath == "") {
                val symbolRequirement =
                    if (targetName == "compilerInternalFunction" ||
                        targetName == "compilerRequiredInternalFunction") {
                        "a unique bounded linker symbol name"
                    } else "a unique non-reserved C identifier"
                bootstrapStageDriverDiagnostic(
                    "error[E_EXPORT_SIGNATURE_UNSUPPORTED]: $targetName rejected $reflectedKind handle ${reflected.integer} (declaration `$declarationKind`, source `$source`, result `$resultType`, export `${exportName.text}`); it requires $symbolRequirement and a top-level function with at most 16 value bool, fixed-width integer/char/f32/f64, copied borrowed-string, or direct non-escaping (i64)->i64 callback parameters, returning void, a supported scalar, or owned string\n"
                )
            } else {
                bootstrapStageDriverDiagnostic(
                    "error[E_ARTIFACT_SLICE_REACHABILITY]: compilerExportFunction rejected $reflectedKind handle ${reflected.integer} (declaration `$declarationKind`, source `$source`, result `$resultType`, export `${exportName.text}`); selected root `${source}` cannot be included because it reaches unsupported declaration `${declarationPath}`\n"
                )
            }
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerRecordExtensionRequest" ||
        targetName == "compilerRecordGeneratedExtensionRequest") {
        val namespace = evaluator.evaluate(expression.children[0])
        val payload = evaluator.evaluate(expression.children[1])
        val syntaxHandle = evaluator.evaluate(expression.children[2])
        val finalizer = evaluator.evaluate(expression.children[3])
        var sourceIdentity = "<unknown>"
        if (evaluator.cursors.size > 0) {
            sourceIdentity = evaluator.cursors[0].sourceIdentity
        }
        if (namespace.kind == "string" && namespace.text != "" &&
            payload.kind == "string" && syntaxHandle.kind == "syntax" &&
            syntaxHandle.integer >= 0 &&
            syntaxHandle.integer < evaluator.syntax.size &&
            finalizer.kind == "function" &&
            evaluator.extensionRequests.size < 256) {
            evaluator.extensionRequests.append(BootstrapExtensionRequest(
                namespace.text,
                payload.text,
                evaluator.syntax[syntaxHandle.integer],
                finalizer.text,
                targetName == "compilerRecordGeneratedExtensionRequest",
                sourceIdentity,
                ""
            ))
        } else {
            var reason = "request limit exceeded"
            if (finalizer.kind != "function") {
                reason = "finalizer is not a compile-time function"
            }
            if (syntaxHandle.kind != "syntax" ||
                syntaxHandle.integer < 0 ||
                syntaxHandle.integer >= evaluator.syntax.size) {
                reason = "expression is not a live syntax handle"
            }
            if (payload.kind != "string") {
                reason = "payload is not a string"
            }
            if (namespace.kind != "string" || namespace.text == "") {
                reason = "namespace must be a non-empty string"
            }
            var origin = BootstrapExpression(
                "invalid", "", expression.begin, expression.end, []
            )
            if (syntaxHandle.kind == "syntax" &&
                syntaxHandle.integer >= 0 &&
                syntaxHandle.integer < evaluator.syntax.size) {
                origin = evaluator.syntax[syntaxHandle.integer]
            }
            evaluator.extensionRequests.append(BootstrapExtensionRequest(
                if (namespace.kind == "string") namespace.text
                    else "<invalid>",
                if (payload.kind == "string") payload.text else "",
                origin,
                if (finalizer.kind == "function") finalizer.text else "",
                targetName == "compilerRecordGeneratedExtensionRequest",
                sourceIdentity,
                "extension.request:${if (namespace.kind == "string") namespace.text else "<invalid>"}:$sourceIdentity:${origin.begin}:${origin.end}:$reason\n"
            ))
            evaluator.errors = evaluator.errors + 1
        }
        result = bootstrapEvalVoid()
    }
    result
}

@noinline
fun bootstrapEvaluateCallHost(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "ablaHostReadFile") {
        if (bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 4)) {
            val path = evaluator.evaluate(expression.children[0])
            val contents = Path(path.text).readText()
            evaluator.recordCompileInput(path.text, contents)
            result = bootstrapEvalString(contents)
        } else {
            // Parser staging precedes full semantic analysis. Reject the
            // invocation here so an unauthorized handler cannot touch the
            // host merely because its eventual program would be denied.
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "ablaHostListDirectory") {
        // A directory's entry names, sorted (bytewise) so a build sees the same order
        // on every host; [] when it doesn't exist.
        if (bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 4)) {
            val path = evaluator.evaluate(expression.children[0])
            val names = bootstrapSortedEntryNames(path.text)
            var listing = ""
            val elements: array<BootstrapEvalValue> = []
            var index = 0
            while (index < names.size) {
                elements.append(bootstrapEvalString(names[index]))
                listing = "$listing${names[index]}\n"
                index = index + 1
            }
            evaluator.recordCompileInput("abla-input:directory:${path.text}", listing)
            result = bootstrapEvalArray(elements)
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerWriteFile") {
        val path = evaluator.evaluate(expression.children[0])
        val contents = evaluator.evaluate(expression.children[1])
        if (path.kind == "string" && contents.kind == "string" &&
            bootstrapCompileEffectHas(
                evaluator.allowedCompileEffects,
                8
            )) {
            result = bootstrapEvalBoolean(bootstrapStageCompileOutput(
                path.text,
                contents.text
            ))
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerEnvironment") {
        val name = evaluator.evaluate(expression.children[0])
        var valid = name.kind == "string" && name.text.size > 0 &&
            name.text.size <= 256
        var index = 0
        while (valid && index < name.text.size) {
            if (name.text[index] == 0 || name.text[index] == 61) {
                valid = false
            }
            index = index + 1
        }
        if (valid && bootstrapCompileEffectHas(
            evaluator.allowedCompileEffects,
            16
        )) {
            val observed = linuxEnvironment(name.text)
            val contents = if (observed.found) observed.value else ""
            evaluator.recordCompileInput(
                "abla-input:environment:${name.text}",
                contents
            )
            result = bootstrapEvalString(contents)
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerClockMilliseconds") {
        if (bootstrapCompileEffectHas(
            evaluator.allowedCompileEffects,
            128
        )) {
            result = bootstrapEvalInteger(linuxMonotonicMilliseconds())
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerRandomInteger") {
        val maximum = evaluator.evaluate(expression.children[0])
        if (maximum.kind == "integer" && maximum.integer > 0 &&
            bootstrapCompileEffectHas(
                evaluator.allowedCompileEffects,
                256
            )) {
            result = bootstrapEvalInteger(
                linuxRandomInteger(maximum.integer)
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerRunProcess") {
        val arguments = evaluator.evaluate(expression.children[0])
        var valid = arguments.kind == "array" &&
            arguments.elements.size > 0 &&
            arguments.elements.size <= 128
        var argument = 0
        while (valid && argument < arguments.elements.size) {
            val value = arguments.elements[argument]
            if (value.kind != "string" || value.text.size > 4096) {
                valid = false
            }
            argument = argument + 1
        }
        if (valid && bootstrapCompileEffectHas(
            evaluator.allowedCompileEffects,
            32
        )) {
            val command = linuxCommand(arguments.elements[0].text)
            argument = 1
            while (argument < arguments.elements.size) {
                command.argument(arguments.elements[argument].text)
                argument = argument + 1
            }
            result = bootstrapEvalInteger(command.run())
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerTcpExchange") {
        val address = evaluator.evaluate(expression.children[0])
        val port = evaluator.evaluate(expression.children[1])
        val request = evaluator.evaluate(expression.children[2])
        val maximum = evaluator.evaluate(expression.children[3])
        val timeout = evaluator.evaluate(expression.children[4])
        var valid = address.kind == "string" &&
            port.kind == "integer" && request.kind == "string" &&
            maximum.kind == "integer" && timeout.kind == "integer" &&
            request.text.size <= 1048576 && maximum.integer > 0 &&
            maximum.integer <= 1048576 && timeout.integer > 0 &&
            timeout.integer <= 10000 &&
            bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 64)
        if (valid) {
            val connection = tcpConnectIpv4(
                address.text,
                port.integer,
                timeout.integer
            )
            var response = ""
            if (connection.descriptor >= 0) {
                val written = connection.write(request.text)
                if (written == request.text.size) {
                    response = connection.readWithTimeout(
                        maximum.integer,
                        timeout.integer
                    )
                }
                connection.close()
            }
            result = bootstrapEvalString(response)
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    result
}

@noinline
fun bootstrapEvaluateCallParser(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "parserExpect") {
        val cursor = evaluator.evaluate(expression.children[0])
        val expected = evaluator.evaluate(expression.children[1])
        evaluator.cursors[cursor.integer].expect(expected.text)
        result = bootstrapEvalVoid()
    }
    if (targetName == "parserAt") {
        val cursor = evaluator.evaluate(expression.children[0])
        val expected = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].at(expected.text)
        )
    }
    if (targetName == "parserConsume") {
        val cursor = evaluator.evaluate(expression.children[0])
        val expected = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].consume(expected.text)
        )
    }
    if (targetName == "parserCurrentText") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].currentText()
        )
    }
    if (targetName == "parserTextAhead") {
        val cursor = evaluator.evaluate(expression.children[0])
        val ahead = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].textAhead(ahead.integer)
        )
    }
    if (targetName == "parserRawAt") {
        val cursor = evaluator.evaluate(expression.children[0])
        val text = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].rawAt(text.text)
        )
    }
    if (targetName == "parserRawConsume") {
        val cursor = evaluator.evaluate(expression.children[0])
        val text = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].rawConsume(text.text)
        )
    }
    if (targetName == "parserRawExpect") {
        val cursor = evaluator.evaluate(expression.children[0])
        val text = evaluator.evaluate(expression.children[1])
        evaluator.cursors[cursor.integer].rawExpect(text.text)
        result = bootstrapEvalVoid()
    }
    if (targetName == "parserRawTakeUntil") {
        val cursor = evaluator.evaluate(expression.children[0])
        val delimiters = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeUntil(delimiters.text)
        )
    }
    if (targetName == "parserRawTakeUntilText") {
        val cursor = evaluator.evaluate(expression.children[0])
        val delimiter = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeUntilText(delimiter.text)
        )
    }
    if (targetName == "parserRawLineRecordsValid") {
        val source = evaluator.evaluate(expression.children[0])
        val directiveCatalog = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(bootstrapRawLineRecordsValid(
            source.text, directiveCatalog.text
        ))
    }
    if (targetName == "parserRawInsertAfterTopLevelRecord") {
        val source = evaluator.evaluate(expression.children[0])
        val record = evaluator.evaluate(expression.children[1])
        val insertion = evaluator.evaluate(expression.children[2])
        result = bootstrapEvalString(
            bootstrapRawInsertAfterTopLevelRecord(
                source.text, record.text, insertion.text
            )
        )
    }
    if (targetName == "parserRawInsertBeforeTopLevelRecord") {
        val source = evaluator.evaluate(expression.children[0])
        val record = evaluator.evaluate(expression.children[1])
        val insertion = evaluator.evaluate(expression.children[2])
        result = bootstrapEvalString(
            bootstrapRawInsertBeforeTopLevelRecord(
                source.text, record.text, insertion.text
            )
        )
    }
    if (targetName == "parserRawGuardNestedEntries") {
        val source = evaluator.evaluate(expression.children[0])
        val entryRecord = evaluator.evaluate(expression.children[1])
        val beforeEntry = evaluator.evaluate(expression.children[2])
        val afterEntry = evaluator.evaluate(expression.children[3])
        result = bootstrapEvalString(
            bootstrapRawGuardNestedEntries(
                source.text,
                entryRecord.text,
                beforeEntry.text,
                afterEntry.text
            )
        )
    }
    if (targetName == "parserRawWrapTopLevelRecord") {
        val source = evaluator.evaluate(expression.children[0])
        val record = evaluator.evaluate(expression.children[1])
        val beforeRecord = evaluator.evaluate(expression.children[2])
        val afterRecord = evaluator.evaluate(expression.children[3])
        result = bootstrapEvalString(
            bootstrapRawWrapTopLevelRecord(
                source.text,
                record.text,
                beforeRecord.text,
                afterRecord.text
            )
        )
    }
    if (targetName == "parserRawTakeName") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeName()
        )
    }
    if (targetName == "parserRawTakeSymbol") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeSymbol()
        )
    }
    if (targetName == "parserRawSkipWhitespace") {
        val cursor = evaluator.evaluate(expression.children[0])
        evaluator.cursors[cursor.integer].rawSkipWhitespace()
        result = bootstrapEvalVoid()
    }
    if (targetName == "parserRawEnd") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].rawEnd()
        )
    }
    if (targetName == "parserRawPosition") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalInteger(
            evaluator.cursors[cursor.integer].rawPosition
        )
    }
    if (targetName == "parserSourceIdentity") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].sourceIdentity
        )
    }
    if (targetName == "parserFail") {
        val cursor = evaluator.evaluate(expression.children[0])
        val message = evaluator.evaluate(expression.children[1])
        evaluator.recordEvaluatorDiagnostic(
            "E_SUBPARSER_FAILURE",
            if (message.kind == "string" && message.text != "")
                message.text
            else "subparser reported a failure"
        )
        evaluator.diagnostics =
            "${evaluator.diagnostics}source[subparser]:${evaluator.cursors[cursor.integer].sourceIdentity}:${evaluator.cursors[cursor.integer].rawPosition}:${evaluator.cursors[cursor.integer].rawPosition}\n"
        evaluator.cursors[cursor.integer].errors =
            evaluator.cursors[cursor.integer].errors + 1
        result = bootstrapEvalVoid()
    }
    if (targetName == "parserParseAblaExpression") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(
            evaluator.cursors[cursor.integer].parseAblaExpression()
        )
    }
    result
}

@noinline
fun bootstrapEvaluateCallSyntax(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "syntaxKind" || targetName == "syntaxText" ||
        targetName == "syntaxChildCount" ||
        targetName == "syntaxBegin" || targetName == "syntaxEnd") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size) {
            val inspected = evaluator.syntax[handle]
            if (targetName == "syntaxKind") {
                result = bootstrapEvalString(inspected.kind)
            }
            if (targetName == "syntaxText") {
                result = bootstrapEvalString(inspected.text)
            }
            if (targetName == "syntaxChildCount") {
                result = bootstrapEvalInteger(inspected.children.size)
            }
            if (targetName == "syntaxBegin") {
                result = bootstrapEvalInteger(inspected.begin)
            }
            if (targetName == "syntaxEnd") {
                result = bootstrapEvalInteger(inspected.end)
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxChild") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val index = evaluator.evaluate(expression.children[1]).integer
        if (handle >= 0 && handle < evaluator.syntax.size && index >= 0 &&
            index < evaluator.syntax[handle].children.size) {
            val child = evaluator.syntax[handle].children[index]
            result = evaluator.syntaxValue(child)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxInteger") {
        val value = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(bootstrapSyntaxInteger(value.integer))
    }
    if (targetName == "syntaxString") {
        val value = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(bootstrapSyntaxString(value.text))
    }
    if (targetName == "syntaxBoolean") {
        val value = evaluator.evaluate(expression.children[0])
        if (value.kind == "boolean") {
            val literal = if (value.boolean) "true" else "false"
            result = evaluator.syntaxValue(BootstrapExpression(
                literal,
                literal,
                0,
                0,
                []
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxNull") {
        result = evaluator.syntaxValue(BootstrapExpression(
            "null", "", 0, 0, []
        ))
    }
    if (targetName == "syntaxIdentifier") {
        val value = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(bootstrapSyntaxIdentifier(value.text))
    }
    if (targetName == "syntaxBinary") {
        val operation = evaluator.evaluate(expression.children[0])
        val left = evaluator.evaluate(expression.children[1])
        val right = evaluator.evaluate(expression.children[2])
        result = evaluator.syntaxValue(bootstrapSyntaxBinary(
            operation.text,
            evaluator.syntax[left.integer],
            evaluator.syntax[right.integer]
        ))
    }
    if (targetName == "syntaxArray") {
        val values = evaluator.evaluate(expression.children[0])
        val elements: array<BootstrapExpression> = []
        var element = 0
        while (element < values.elements.size) {
            elements.append(evaluator.syntax[values.elements[element].integer])
            element = element + 1
        }
        result = evaluator.syntaxValue(bootstrapSyntaxArray(elements))
    }
    if (targetName == "syntaxCall") {
        val name = evaluator.evaluate(expression.children[0])
        val values = evaluator.evaluate(expression.children[1])
        val arguments: array<BootstrapExpression> = []
        var argument = 0
        while (argument < values.elements.size) {
            arguments.append(evaluator.syntax[values.elements[argument].integer])
            argument = argument + 1
        }
        result = evaluator.syntaxValue(bootstrapSyntaxCall(name.text, arguments))
    }
    if (targetName == "syntaxCallTarget" ||
        targetName == "syntaxMethodCallTarget") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        var receiver = bootstrapEvalInvalid()
        var valuesIndex = 1
        if (targetName == "syntaxMethodCallTarget") {
            receiver = evaluator.evaluate(expression.children[1])
            valuesIndex = 2
        }
        val values = evaluator.evaluate(expression.children[valuesIndex])
        val owner = evaluator.functionHandleOwner(handle)
        val method = evaluator.functionHandleMethod(handle)
        var valid = evaluator.functionHandleValid(handle) &&
            values.kind == "array"
        if (targetName == "syntaxCallTarget" && owner >= 0) valid = false
        if (targetName == "syntaxMethodCallTarget" &&
            (receiver.kind != "syntax" || receiver.integer < 0 ||
             receiver.integer >= evaluator.syntax.size)) valid = false
        var declarationIndex = handle
        if (owner >= 0) declarationIndex = owner
        var declarationName = ""
        var extensionOwner = ""
        if (valid) {
            declarationName = evaluator.declarations[declarationIndex].name
            extensionOwner =
                evaluator.declarations[declarationIndex].extensionOwner
            if (owner >= 0) {
                declarationName =
                    evaluator.declarations[owner].methods[method].name
                extensionOwner = evaluator.declarations[owner].name
            }
            if (targetName == "syntaxMethodCallTarget" && owner < 0 &&
                extensionOwner == "") valid = false
            if (targetName == "syntaxCallTarget" &&
                extensionOwner != "") valid = false
        }
        val arguments: array<BootstrapExpression> = []
        var argument = 0
        while (valid && argument < values.elements.size) {
            val syntaxHandle = values.elements[argument].integer
            if (values.elements[argument].kind != "syntax" ||
                syntaxHandle < 0 || syntaxHandle >= evaluator.syntax.size) {
                valid = false
            } else arguments.append(evaluator.syntax[syntaxHandle])
            argument = argument + 1
        }
        if (valid && targetName == "syntaxCallTarget") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "call",
                declarationName,
                0 - handle - 1,
                0,
                arguments
            ))
        }
        if (valid && targetName == "syntaxMethodCallTarget") {
            val children: array<BootstrapExpression> = [
                evaluator.syntax[receiver.integer]
            ]
            argument = 0
            while (argument < arguments.size) {
                children.append(arguments[argument])
                argument = argument + 1
            }
            result = evaluator.syntaxValue(BootstrapExpression(
                "member.call",
                declarationName,
                0 - handle - 1,
                0,
                children
            ))
        }
        if (!valid) evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxMember") {
        val receiver = evaluator.evaluate(expression.children[0])
        val name = evaluator.evaluate(expression.children[1])
        if (receiver.kind == "syntax" &&
            evaluator.generatedIdentifierPart(name.text) == name.text) {
            result = evaluator.syntaxValue(BootstrapExpression(
                "member",
                name.text,
                0,
                0,
                [evaluator.syntax[receiver.integer]]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxIndex") {
        val receiver = evaluator.evaluate(expression.children[0])
        val index = evaluator.evaluate(expression.children[1])
        if (receiver.kind == "syntax" && index.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "index",
                "",
                0,
                0,
                [evaluator.syntax[receiver.integer], evaluator.syntax[index.integer]]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxIf") {
        val condition = evaluator.evaluate(expression.children[0])
        val thenExpression = evaluator.evaluate(expression.children[1])
        val elseExpression = evaluator.evaluate(expression.children[2])
        if (condition.kind == "syntax" &&
            thenExpression.kind == "syntax" &&
            elseExpression.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "if",
                "",
                0,
                0,
                [
                    evaluator.syntax[condition.integer],
                    evaluator.syntax[thenExpression.integer],
                    evaluator.syntax[elseExpression.integer]
                ]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxReturn") {
        val value = evaluator.evaluate(expression.children[0])
        if (value.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "return", "", 0, 0, [evaluator.syntax[value.integer]]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxBlock") {
        val values = evaluator.evaluate(expression.children[0])
        val statements: array<BootstrapExpression> = []
        var statement = 0
        var valid = values.kind == "array"
        while (valid && statement < values.elements.size) {
            val value = values.elements[statement]
            if (value.kind == "syntax" && value.integer >= 0 &&
                value.integer < evaluator.syntax.size) {
                statements.append(evaluator.syntax[value.integer])
            } else valid = false
            statement = statement + 1
        }
        if (valid) {
            result = evaluator.syntaxValue(BootstrapExpression(
                "block", "", 0, 0, statements
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxLocal" ||
        targetName == "syntaxVariable") {
        val name = evaluator.evaluate(expression.children[0])
        val typeHandle = evaluator.evaluate(expression.children[1]).integer
        val initializer = evaluator.evaluate(expression.children[2])
        if (name.kind == "string" &&
            evaluator.generatedIdentifierPart(name.text) == name.text &&
            evaluator.reflectedTypeValid(typeHandle) &&
            initializer.kind == "syntax") {
            var kind = "local.val"
            if (targetName == "syntaxVariable") kind = "local.var"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind,
                name.text,
                0,
                0,
                [
                    evaluator.syntax[initializer.integer],
                    BootstrapExpression(
                        "type", evaluator.reflectedTypes[typeHandle], 0, 0, []
                    )
                ]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxAssign") {
        val name = evaluator.evaluate(expression.children[0])
        val value = evaluator.evaluate(expression.children[1])
        if (name.kind == "string" &&
            evaluator.generatedIdentifierPart(name.text) == name.text &&
            value.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "assign", name.text, 0, 0,
                [evaluator.syntax[value.integer]]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxLambda") {
        val names = evaluator.evaluate(expression.children[0])
        val types = evaluator.evaluate(expression.children[1])
        val body = evaluator.evaluate(expression.children[2])
        val moving = evaluator.evaluate(expression.children[3])
        var valid = names.kind == "array" && types.kind == "array" &&
            names.elements.size == types.elements.size &&
            body.kind == "syntax" && moving.kind == "boolean"
        val children: array<BootstrapExpression> = []
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val name = names.elements[parameter]
            val type = types.elements[parameter]
            if (name.kind != "string" ||
                evaluator.generatedIdentifierPart(name.text) != name.text ||
                type.kind != "integer" ||
                !evaluator.reflectedTypeValid(type.integer)) {
                valid = false
            } else children.append(BootstrapExpression(
                "lambda.parameter", name.text, 0, 0,
                [BootstrapExpression(
                    "type", evaluator.reflectedTypes[type.integer], 0, 0, []
                )]
            ))
            parameter = parameter + 1
        }
        if (valid) {
            children.append(evaluator.syntax[body.integer])
            var kind = "lambda"
            if (moving.boolean) kind = "lambda.move"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind, "", 0, 0, children
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxInferredLambda") {
        val names = evaluator.evaluate(expression.children[0])
        val body = evaluator.evaluate(expression.children[1])
        val moving = evaluator.evaluate(expression.children[2])
        var valid = names.kind == "array" && body.kind == "syntax" &&
            moving.kind == "boolean"
        val children: array<BootstrapExpression> = []
        val used: array<string> = []
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val name = names.elements[parameter]
            var duplicate = false
            var previous = 0
            while (!duplicate && previous < used.size) {
                if (used[previous] == name.text) duplicate = true
                previous = previous + 1
            }
            if (name.kind != "string" ||
                evaluator.generatedIdentifierPart(name.text) != name.text ||
                duplicate) {
                valid = false
            } else {
                used.append(name.text)
                children.append(BootstrapExpression(
                    "lambda.parameter", name.text, 0, 0,
                    [BootstrapExpression("type", "unknown", 0, 0, [])]
                ))
            }
            parameter = parameter + 1
        }
        if (valid) {
            children.append(evaluator.syntax[body.integer])
            var kind = "lambda"
            if (moving.boolean) kind = "lambda.move"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind, "", 0, 0, children
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
fun bootstrapEvaluateCallGenerated(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "compilerGeneratedModule") {
        val namespace = evaluator.evaluate(expression.children[0])
        val origin = evaluator.evaluate(expression.children[1])
        if (namespace.kind == "string" && namespace.text != "" &&
            origin.kind == "syntax" && origin.integer >= 0 &&
            origin.integer < evaluator.syntax.size) {
            result = BootstrapEvalValue(
                "generated.module",
                evaluator.syntax[origin.integer].begin,
                false,
                namespace.text,
                [BootstrapEvalValue(
                    "generated.origin",
                    evaluator.syntax[origin.integer].end,
                    false,
                    "",
                    [],
                    "",
                    []
                )],
                "",
                []
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedLiftedFunction") {
        val module = evaluator.evaluate(expression.children[0])
        val hint = evaluator.evaluate(expression.children[1])
        val captures = evaluator.evaluate(expression.children[2])
        val names = evaluator.evaluate(expression.children[3])
        val types = evaluator.evaluate(expression.children[4])
        val mutableCaptures = evaluator.evaluate(expression.children[5])
        val resultType = evaluator.evaluate(expression.children[6]).integer
        val body = evaluator.evaluate(expression.children[7])
        var valid = module.kind == "generated.module" &&
            hint.kind == "string" && captures.kind == "array" &&
            names.kind == "array" && types.kind == "array" &&
            mutableCaptures.kind == "array" &&
            captures.elements.size == names.elements.size &&
            names.elements.size == types.elements.size &&
            types.elements.size == mutableCaptures.elements.size &&
            evaluator.reflectedTypeValid(resultType) && body.kind == "syntax" &&
            module.elements.size < 256
        var ownershipValid = true
        var mutableValid = true
        val captureNames: array<string> = []
        val parameterNames: array<string> = []
        val parameterTypes: array<string> = []
        val parameterKinds: array<string> = []
        val parameterDefaults: array<BootstrapExpression> = []
        var source = ""
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val capture = captures.elements[parameter]
            val name = names.elements[parameter]
            val type = types.elements[parameter]
            val mutable = mutableCaptures.elements[parameter]
            if (capture.kind != "string" || name.kind != "string" ||
                type.kind != "integer" || mutable.kind != "boolean" ||
                evaluator.generatedIdentifierPart(capture.text) != capture.text ||
                evaluator.generatedIdentifierPart(name.text) != name.text ||
                !evaluator.reflectedTypeValid(type.integer)) {
                valid = false
            } else {
                val typeName = evaluator.reflectedTypes[type.integer]
                if (bootstrapIsBorrowType(typeName) ||
                    bootstrapSummaryTypeIsAffine(
                        typeName,
                        evaluator.affineTypes
                    )) {
                    valid = false
                    ownershipValid = false
                }
                captureNames.append(capture.text)
                parameterNames.append(name.text)
                parameterTypes.append(typeName)
                parameterKinds.append(
                    if (mutable.boolean) "var" else "parameter"
                )
                parameterDefaults.append(BootstrapExpression(
                    "missing", "", module.integer, module.integer, []
                ))
                if (parameter > 0) source = "$source, "
                if (mutable.boolean) source = "${source}var "
                source = "$source${name.text}: $typeName"
            }
            parameter = parameter + 1
        }
        if (valid) {
            val bodyExpression = evaluator.syntax[body.integer]
            val bodySummary = evaluator.accessSummaryForExpression(
                bodyExpression
            )
            val bodyContext = evaluator.accessContainingHandle(bodyExpression)
            var capture = 0
            while (capture < captureNames.size &&
                capture < mutableCaptures.elements.size) {
                if (!mutableCaptures.elements[capture].boolean) {
                    val root = evaluator.accessRootPath(
                        captureNames[capture],
                        bodyContext,
                        [],
                        []
                    )
                    var write = 0
                    while (write < bodySummary.writes.size) {
                        val candidate = bodySummary.writes[write]
                        if (candidate.rootKind == root.rootKind &&
                            candidate.rootIdentity == root.rootIdentity &&
                            candidate.rootParameter == root.rootParameter) {
                            mutableValid = false
                        }
                        write = write + 1
                    }
                    if (bodySummary.writesUnknown) mutableValid = false
                }
                capture = capture + 1
            }
            if (!mutableValid) valid = false
        }
        val bound: array<string> = []
        val validity = BootstrapLiftValidity(Cell(valid))
        var rewritten = BootstrapExpression(
            "invalid", "lift", module.integer, module.integer, []
        )
        if (valid) rewritten = evaluator.rewriteLiftedExpression(
            evaluator.syntax[body.integer],
            captureNames,
            parameterNames,
            bound,
            validity
        )
        valid = validity.valid.get()
        val generatedName = evaluator.generatedDeclarationName(
            module,
            hint.text
        )
        if (generatedName == "") valid = false
        if (valid) {
            val resultName = evaluator.reflectedTypes[resultType]
            var rendered = "fun $generatedName($source): $resultName "
            if (rewritten.kind != "block") rendered = "$rendered= "
            rendered = "$rendered${evaluator.generatedSyntaxSource(
                rewritten,
                0
            )}\n"
            if (rendered.size > 65536) valid = false
            if (valid) {
                var originEnd = module.integer
                if (module.elements.size > 0 &&
                    module.elements[0].kind == "generated.origin") {
                    originEnd = module.elements[0].integer
                }
                val declarationIndex = evaluator.generatedDeclarations.size
                evaluator.generatedDeclarations.append(BootstrapDeclaration(
                    "fun",
                    generatedName,
                    module.integer,
                    originEnd,
                    rewritten,
                    parameterNames,
                    parameterTypes,
                    evaluator.reflectedTypes[resultType],
                    [],
                    parameterDefaults,
                    "",
                    parameterKinds,
                    "",
                    false,
                    false,
                    false,
                    module.text,
                    module.integer,
                    originEnd,
                    [],
                    [],
                    [],
                    [],
                    ""
                ))
                module.elements.append(BootstrapEvalValue(
                    "generated.declaration",
                    declarationIndex,
                    false,
                    rendered,
                    [],
                    "",
                    []
                ))
                module.fieldNames.append(generatedName)
                result = bootstrapEvalString(generatedName)
            }
        }
        if (!valid) {
            if (!ownershipValid) evaluator.recordEvaluatorDiagnostic(
                "E_REACTIVE_LIFT_OWNERSHIP",
                "generated lifted function cannot capture a borrowed or affine value"
            )
            else if (!mutableValid) evaluator.recordEvaluatorDiagnostic(
                "E_REACTIVE_HANDLER_CAPTURE",
                "generated lifted function writes through a capture that was not declared mutable"
            )
            else evaluator.recordEvaluatorDiagnostic(
                "E_REACTIVE_LIFT_FREE_VARIABLE",
                "generated lifted function has an invalid or unlisted free variable"
            )
        }
    }
    if (targetName == "compilerGeneratedFunction" ||
        targetName == "compilerGeneratedExportFunction") {
        val module = evaluator.evaluate(expression.children[0])
        val hint = evaluator.evaluate(expression.children[1])
        val names = evaluator.evaluate(expression.children[2])
        val types = evaluator.evaluate(expression.children[3])
        val resultType = evaluator.evaluate(expression.children[4]).integer
        val body = evaluator.evaluate(expression.children[5])
        var valid = module.kind == "generated.module" &&
            hint.kind == "string" && names.kind == "array" &&
            types.kind == "array" &&
            names.elements.size == types.elements.size &&
            evaluator.reflectedTypeValid(resultType) && body.kind == "syntax" &&
            module.elements.size < 256
        var generatedName = evaluator.generatedDeclarationName(module, hint.text)
        if (targetName == "compilerGeneratedExportFunction") {
            generatedName = evaluator.generatedExportName(module, hint.text)
        }
        if (generatedName == "") valid = false
        var source = "fun $generatedName("
        val generatedParameterNames: array<string> = []
        val generatedParameterTypes: array<string> = []
        val generatedParameterDefaults: array<BootstrapExpression> = []
        val generatedParameterKinds: array<string> = []
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val parameterName = names.elements[parameter]
            val parameterType = types.elements[parameter]
            if (parameterName.kind != "string" ||
                evaluator.generatedIdentifierPart(parameterName.text) !=
                    parameterName.text ||
                parameterType.kind != "integer" ||
                !evaluator.reflectedTypeValid(parameterType.integer)) {
                valid = false
            } else {
                if (parameter > 0) source = "$source, "
                val parameterTypeName =
                    evaluator.reflectedTypes[parameterType.integer]
                generatedParameterNames.append(parameterName.text)
                generatedParameterTypes.append(parameterTypeName)
                generatedParameterDefaults.append(BootstrapExpression(
                    "missing", "", module.integer, module.integer, []
                ))
                generatedParameterKinds.append("parameter")
                source = "$source${parameterName.text}: $parameterTypeName"
            }
            parameter = parameter + 1
        }
        if (valid) {
            val generatedResultType = evaluator.reflectedTypes[resultType]
            source = "$source): $generatedResultType "
            val bodyExpression = evaluator.syntax[body.integer]
            if (bodyExpression.kind != "block") source = "$source= "
            source = "$source${evaluator.generatedSyntaxSource(
                bodyExpression, 0
            )}\n"
            if (source.size > 65536) valid = false
        }
        if (valid) {
            var originEnd = module.integer
            if (module.elements.size > 0 &&
                module.elements[0].kind == "generated.origin") {
                originEnd = module.elements[0].integer
            }
            val declarationIndex = evaluator.generatedDeclarations.size
            evaluator.generatedDeclarations.append(BootstrapDeclaration(
                "fun",
                generatedName,
                module.integer,
                originEnd,
                evaluator.syntax[body.integer],
                generatedParameterNames,
                generatedParameterTypes,
                evaluator.reflectedTypes[resultType],
                [],
                generatedParameterDefaults,
                "",
                generatedParameterKinds,
                "",
                false,
                false,
                false,
                module.text,
                module.integer,
                originEnd,
                [],
                [],
                [],
                [],
                ""
            ))
            module.elements.append(BootstrapEvalValue(
                "generated.declaration",
                declarationIndex,
                false,
                source,
                [],
                "",
                []
            ))
            module.fieldNames.append(generatedName)
            result = bootstrapEvalString(generatedName)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedValue") {
        val module = evaluator.evaluate(expression.children[0])
        val hint = evaluator.evaluate(expression.children[1])
        val typeHandle = evaluator.evaluate(expression.children[2]).integer
        val initializer = evaluator.evaluate(expression.children[3])
        var valid = module.kind == "generated.module" &&
            hint.kind == "string" &&
            evaluator.reflectedTypeValid(typeHandle) &&
            initializer.kind == "syntax" && module.elements.size < 256
        val generatedName = evaluator.generatedDeclarationName(module, hint.text)
        if (generatedName == "") valid = false
        if (valid) {
            val typeName = evaluator.reflectedTypes[typeHandle]
            val initializerSource = evaluator.generatedSyntaxSource(
                evaluator.syntax[initializer.integer], 0
            )
            val source = "val $generatedName: $typeName = $initializerSource\n"
            if (source.size <= 65536) {
                var originEnd = module.integer
                if (module.elements.size > 0 &&
                    module.elements[0].kind == "generated.origin") {
                    originEnd = module.elements[0].integer
                }
                val declarationIndex = evaluator.generatedDeclarations.size
                evaluator.generatedDeclarations.append(BootstrapDeclaration(
                    "val",
                    generatedName,
                    module.integer,
                    originEnd,
                    evaluator.syntax[initializer.integer],
                    [],
                    [],
                    typeName,
                    [],
                    [],
                    "",
                    [],
                    "",
                    false,
                    false,
                    false,
                    module.text,
                    module.integer,
                    originEnd,
                    [],
                    [],
                    [],
                    [],
                    ""
                ))
                module.elements.append(BootstrapEvalValue(
                    "generated.declaration",
                    declarationIndex,
                    false,
                    source,
                    [],
                    "",
                    []
                ))
                module.fieldNames.append(generatedName)
                result = bootstrapEvalString(generatedName)
            } else valid = false
        }
        if (!valid) evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedModuleSource") {
        val module = evaluator.evaluate(expression.children[0])
        if (module.kind == "generated.module") {
            var source = ""
            var declaration = 0
            while (declaration < module.elements.size) {
                source = "$source${module.elements[declaration].text}"
                declaration = declaration + 1
            }
            result = bootstrapEvalString(source)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedDeclarationCount") {
        val module = evaluator.evaluate(expression.children[0])
        if (module.kind == "generated.module") {
            result = bootstrapEvalInteger(
                evaluator.generatedDeclarationCount(module)
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedDeclarationNamespace" ||
        targetName == "compilerGeneratedDeclarationOriginBegin" ||
        targetName == "compilerGeneratedDeclarationOriginEnd") {
        val module = evaluator.evaluate(expression.children[0])
        val ordinal = evaluator.evaluate(expression.children[1]).integer
        val declarationIndex = evaluator.generatedDeclarationAt(
            module,
            ordinal
        )
        if (declarationIndex >= 0) {
            val declaration = evaluator.generatedDeclarations[declarationIndex]
            if (targetName ==
                "compilerGeneratedDeclarationNamespace") {
                result = bootstrapEvalString(
                    declaration.generatedNamespace
                )
            }
            if (targetName ==
                "compilerGeneratedDeclarationOriginBegin") {
                result = bootstrapEvalInteger(
                    declaration.generatedOriginBegin
                )
            }
            if (targetName ==
                "compilerGeneratedDeclarationOriginEnd") {
                result = bootstrapEvalInteger(
                    declaration.generatedOriginEnd
                )
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedDeclarationReference" ||
        targetName == "compilerGeneratedDeclarationCall") {
        val module = evaluator.evaluate(expression.children[0])
        val ordinal = evaluator.evaluate(expression.children[1]).integer
        val declarationIndex = evaluator.generatedDeclarationAt(
            module, ordinal
        )
        val arguments: array<BootstrapExpression> = []
        var valid = declarationIndex >= 0
        if (targetName == "compilerGeneratedDeclarationCall") {
            val values = evaluator.evaluate(expression.children[2])
            valid = valid && values.kind == "array"
            var argument = 0
            while (valid && argument < values.elements.size) {
                val value = values.elements[argument]
                if (value.kind == "syntax" && value.integer >= 0 &&
                    value.integer < evaluator.syntax.size) {
                    arguments.append(evaluator.syntax[value.integer])
                } else valid = false
                argument = argument + 1
            }
        }
        if (valid) {
            val declaration = evaluator.generatedDeclarations[declarationIndex]
            var kind = "identifier"
            if (targetName ==
                "compilerGeneratedDeclarationCall") kind = "call"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind,
                declaration.name,
                0,
                -1,
                arguments
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
fun bootstrapEvaluateCallTyped(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "typedExpressionReadCount" ||
        targetName == "typedExpressionRead" ||
        targetName == "typedExpressionWriteCount" ||
        targetName == "typedExpressionWrite" ||
        targetName == "typedExpressionConsumeCount" ||
        targetName == "typedExpressionConsume" ||
        targetName == "typedExpressionReadsUnknown" ||
        targetName == "typedExpressionWritesUnknown") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.typedCallIndex(evaluator.syntax[handle]) >= 0) {
            val summary = evaluator.accessSummaryForExpression(
                evaluator.syntax[handle]
            )
            if (targetName == "typedExpressionReadCount") {
                result = bootstrapEvalInteger(summary.reads.size)
            }
            if (targetName == "typedExpressionWriteCount") {
                result = bootstrapEvalInteger(summary.writes.size)
            }
            if (targetName == "typedExpressionConsumeCount") {
                result = bootstrapEvalInteger(summary.consumes.size)
            }
            if (targetName == "typedExpressionReadsUnknown") {
                result = bootstrapEvalBoolean(summary.readsUnknown)
            }
            if (targetName == "typedExpressionWritesUnknown") {
                result = bootstrapEvalBoolean(summary.writesUnknown)
            }
            if (targetName == "typedExpressionRead" ||
                targetName == "typedExpressionWrite" ||
                targetName == "typedExpressionConsume") {
                val index = evaluator.evaluate(expression.children[1]).integer
                var valid = false
                if (targetName == "typedExpressionRead" && index >= 0 &&
                    index < summary.reads.size) {
                    result = evaluator.accessPathValue(summary.reads[index])
                    valid = true
                }
                if (targetName == "typedExpressionWrite" && index >= 0 &&
                    index < summary.writes.size) {
                    result = evaluator.accessPathValue(summary.writes[index])
                    valid = true
                }
                if (targetName == "typedExpressionConsume" && index >= 0 &&
                    index < summary.consumes.size) {
                    result = evaluator.accessPathValue(summary.consumes[index])
                    valid = true
                }
                if (!valid) evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.recordEvaluatorDiagnostic(
            "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
            "typed access reflection requires a resolved deferred expression"
        )
    }
    if (targetName == "typedFunctionReadCount" ||
        targetName == "typedFunctionRead" ||
        targetName == "typedFunctionWriteCount" ||
        targetName == "typedFunctionWrite" ||
        targetName == "typedFunctionReadsUnknown" ||
        targetName == "typedFunctionWritesUnknown") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.functionHandleValid(handle)) {
            val summary = evaluator.accessSummaryForFunctionAt(
                handle,
                0,
                []
            )
            if (targetName == "typedFunctionReadCount") {
                result = bootstrapEvalInteger(summary.reads.size)
            }
            if (targetName == "typedFunctionWriteCount") {
                result = bootstrapEvalInteger(summary.writes.size)
            }
            if (targetName == "typedFunctionReadsUnknown") {
                result = bootstrapEvalBoolean(summary.readsUnknown)
            }
            if (targetName == "typedFunctionWritesUnknown") {
                result = bootstrapEvalBoolean(summary.writesUnknown)
            }
            if (targetName == "typedFunctionRead" ||
                targetName == "typedFunctionWrite") {
                val index = evaluator.evaluate(expression.children[1]).integer
                val paths = if (targetName == "typedFunctionRead") {
                    summary.reads
                } else summary.writes
                if (index >= 0 && index < paths.size) {
                    result = evaluator.accessPathValue(paths[index])
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.recordInvalidFunctionHandle(targetName, handle)
    }
    if (targetName == "typedExpressionHasEffect") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val effectName = evaluator.evaluate(expression.children[1])
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.typedCallIndex(evaluator.syntax[handle]) >= 0 &&
            effectName.kind == "string") {
            val effect = bootstrapCompileEffectFromName(effectName.text)
            if (effect > 0) result = bootstrapEvalBoolean(
                bootstrapCompileEffectHas(
                    evaluator.accessExpressionEffectMask(evaluator.syntax[handle]),
                    effect
                )
            )
            else evaluator.errors = evaluator.errors + 1
        } else evaluator.recordEvaluatorDiagnostic(
            "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
            "typed effect reflection requires a resolved deferred expression"
        )
    }
    if (targetName == "typedFunctionHasEffect") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val effectName = evaluator.evaluate(expression.children[1])
        if (evaluator.functionHandleValid(handle) &&
            effectName.kind == "string") {
            val effect = bootstrapCompileEffectFromName(effectName.text)
            if (effect > 0) result = bootstrapEvalBoolean(
                bootstrapCompileEffectHas(
                    evaluator.accessFunctionEffectMask(handle),
                    effect
                )
            )
            else evaluator.errors = evaluator.errors + 1
        } else evaluator.recordInvalidFunctionHandle(targetName, handle)
    }
    if (targetName == "typedAccessRootKind" ||
        targetName == "typedAccessRootIdentity" ||
        targetName == "typedAccessRootParameter" ||
        targetName == "typedAccessSegmentCount" ||
        targetName == "typedAccessSegmentKind" ||
        targetName == "typedAccessSegmentName" ||
        targetName == "typedAccessSegmentIndex") {
        val path = evaluator.evaluate(expression.children[0])
        if (path.kind == "typed.access.path") {
            if (targetName == "typedAccessRootKind") {
                result = bootstrapEvalString(path.owner)
            }
            if (targetName == "typedAccessRootIdentity") {
                result = bootstrapEvalString(path.text)
            }
            if (targetName == "typedAccessRootParameter") {
                result = bootstrapEvalInteger(path.integer)
            }
            if (targetName == "typedAccessSegmentCount") {
                result = bootstrapEvalInteger(path.elements.size)
            }
            if (targetName == "typedAccessSegmentKind" ||
                targetName == "typedAccessSegmentName" ||
                targetName == "typedAccessSegmentIndex") {
                val index = evaluator.evaluate(expression.children[1]).integer
                if (index >= 0 && index < path.elements.size) {
                    val segment = path.elements[index]
                    if (targetName == "typedAccessSegmentKind") {
                        result = bootstrapEvalString(segment.owner)
                    }
                    if (targetName == "typedAccessSegmentName") {
                        result = bootstrapEvalString(segment.text)
                    }
                    if (targetName == "typedAccessSegmentIndex") {
                        result = bootstrapEvalInteger(segment.integer)
                    }
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.recordEvaluatorDiagnostic(
            "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
            "typed access query received a stale or invalid path handle"
        )
    }
    if (targetName == "typedAccessPathsIntersect") {
        val left = evaluator.evaluate(expression.children[0])
        val right = evaluator.evaluate(expression.children[1])
        if (left.kind == "typed.access.path" &&
            right.kind == "typed.access.path") {
            result = bootstrapEvalBoolean(bootstrapAccessPathsIntersect(
                evaluator.accessValuePath(left),
                evaluator.accessValuePath(right)
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedExpressionType" ||
        targetName == "typedExpressionKind") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size) {
            if (targetName == "typedExpressionType") {
                val typed = evaluator.typedCallIndex(evaluator.syntax[handle])
                if (typed >= 0) {
                    result = bootstrapEvalString(
                        evaluator.typedCalls[typed].type
                    )
                } else evaluator.errors = evaluator.errors + 1
            } else result = bootstrapEvalString(
                evaluator.syntax[handle].kind
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallTarget") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size) {
            val typed = evaluator.typedCallIndex(evaluator.syntax[handle])
            if (typed >= 0) {
                result = bootstrapEvalInteger(evaluator.typedCalls[typed].target)
            } else evaluator.recordEvaluatorDiagnostic(
                "E_EXT_TYPED_QUERY_BEFORE_RESOLUTION",
                "compiler API `typedCallTarget` requires a resolved deferred expression"
            )
        } else evaluator.recordEvaluatorDiagnostic(
            "E_EXT_EXPRESSION_HANDLE_INVALID",
            "compiler API `typedCallTarget` received invalid expression handle $handle"
        )
    }
    if (targetName == "typedCallArgumentType") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val argument = evaluator.evaluate(expression.children[1]).integer
        var typed = -1
        if (handle >= 0 && handle < evaluator.syntax.size) {
            typed = evaluator.typedCallIndex(evaluator.syntax[handle])
        }
        if (typed >= 0 && argument >= 0 &&
            argument < evaluator.typedCalls[typed].argumentTypes.size) {
            result = bootstrapEvalString(
                evaluator.typedCalls[typed].argumentTypes[argument]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallArgumentCount") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size &&
            (evaluator.syntax[handle].kind == "call" ||
             evaluator.syntax[handle].kind == "member.call")) {
            var count = evaluator.syntax[handle].children.size
            if (evaluator.syntax[handle].kind == "member.call") {
                count = count - 1
            }
            result = bootstrapEvalInteger(count)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallArgument") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val argument = evaluator.evaluate(expression.children[1]).integer
        var offset = 0
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.syntax[handle].kind == "member.call") offset = 1
        if (handle >= 0 && handle < evaluator.syntax.size &&
            (evaluator.syntax[handle].kind == "call" ||
             evaluator.syntax[handle].kind == "member.call") &&
            argument >= 0 &&
            argument + offset < evaluator.syntax[handle].children.size) {
            val child = evaluator.syntax[handle].children[argument + offset]
            result = evaluator.syntaxValue(child)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallReceiverType") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.syntax[handle].kind == "member.call" &&
            evaluator.syntax[handle].children.size > 0) {
            val typed = evaluator.typedCallIndex(evaluator.syntax[handle])
            if (typed >= 0) result = bootstrapEvalString(
                evaluator.typedCalls[typed].receiverType
            )
            else evaluator.errors = evaluator.errors + 1
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallParameterTypeHandle" ||
        targetName == "typedCallResultTypeHandle" ||
        targetName == "typedCallArgumentParameter" ||
        targetName == "typedCallArgumentConversion" ||
        targetName == "typedCallInsertedDefaultCount" ||
        targetName == "typedCallParameterOwnership" ||
        targetName == "typedCallIsCompileOnly" ||
        targetName == "typedCallIsTrusted" ||
        targetName == "typedCallIsContract") {
        val syntaxHandle = evaluator.evaluate(expression.children[0]).integer
        var typed = -1
        if (syntaxHandle >= 0 && syntaxHandle < evaluator.syntax.size) {
            typed = evaluator.typedCallIndex(evaluator.syntax[syntaxHandle])
        }
        if (typed >= 0) {
            val call = evaluator.typedCalls[typed]
            if (targetName == "typedCallResultTypeHandle") {
                result = bootstrapEvalInteger(evaluator.reflectedTypeHandle(
                    call.type
                ))
            }
            if (targetName == "typedCallInsertedDefaultCount") {
                result = bootstrapEvalInteger(call.insertedDefaults)
            }
            if (targetName == "typedCallIsCompileOnly") {
                result = bootstrapEvalBoolean(call.isCompileOnly)
            }
            if (targetName == "typedCallIsTrusted") {
                result = bootstrapEvalBoolean(call.isTrusted)
            }
            if (targetName == "typedCallIsContract") {
                result = bootstrapEvalBoolean(call.isContract)
            }
            if (targetName == "typedCallParameterTypeHandle" ||
                targetName == "typedCallArgumentParameter" ||
                targetName == "typedCallArgumentConversion" ||
                targetName == "typedCallParameterOwnership") {
                val selected = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (selected >= 0) {
                    if (targetName ==
                            "typedCallParameterTypeHandle" &&
                        selected < call.parameterTypes.size) {
                        result = bootstrapEvalInteger(
                            evaluator.reflectedTypeHandle(
                                call.parameterTypes[selected]
                            )
                        )
                    }
                    if (targetName == "typedCallArgumentParameter" &&
                        selected < call.argumentParameters.size) {
                        result = bootstrapEvalInteger(
                            call.argumentParameters[selected]
                        )
                    }
                    if (targetName == "typedCallArgumentConversion" &&
                        selected < call.argumentConversions.size) {
                        result = bootstrapEvalString(
                            call.argumentConversions[selected]
                        )
                    }
                    if (targetName ==
                            "typedCallParameterOwnership" &&
                        selected < call.parameterKinds.size) {
                        result = bootstrapEvalString(
                            call.parameterKinds[selected]
                        )
                    }
                    if (result.kind == "invalid") {
                        evaluator.errors = evaluator.errors + 1
                    }
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

fun bootstrapEvaluateWithEffects(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapEvalResult = bootstrapEvaluateWithEffectsIn(
    bootstrapEvalContext(declarations), expression, declarations, allowedCompileEffects
)

fun bootstrapEvaluateWithEffectsIn(
    context: BootstrapEvalContext,
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int,
    source: string = ""
): BootstrapEvalResult {
    val names: array<string> = []
    val values: array<BootstrapEvalValue> = []
    val mutable: array<bool> = []
    // The source the expression is in, which an evaluation failure names.
    if (source != "") {
        names.append("#source")
        values.append(bootstrapEvalString(source))
        mutable.append(false)
    }
    val cursors: array<BootstrapSubparserCursor> = []
    val syntax: array<BootstrapExpression> = []
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        names,
        values,
        mutable,
        cursors,
        syntax,
        [],
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(expression)
    bootstrapCompileGlobalsKeep(globalKeys, globalValues)
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations,
        syntax
    )
}

fun bootstrapEvaluate(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    source: string = ""
): BootstrapEvalResult = bootstrapEvaluateWithEffectsIn(
    bootstrapEvalContext(declarations), expression, declarations, 1023, source
)

class BootstrapSubparserInvocation(
    val expression: BootstrapExpression,
    val errors: int,
    val diagnostics: string,
    val extensionRequests: array<BootstrapExtensionRequest>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>
)

fun bootstrapInvokeSubparserHandler(
    declarations: array<BootstrapDeclaration>,
    handler: string,
    cursor: BootstrapSubparserCursor,
    allowedCompileEffects: int
): BootstrapSubparserInvocation = bootstrapInvokeSubparserHandlerIn(
    bootstrapEvalContext(declarations), declarations, handler, cursor, allowedCompileEffects
)

fun bootstrapInvokeSubparserHandlerIn(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>,
    handler: string,
    cursor: BootstrapSubparserCursor,
    allowedCompileEffects: int
): BootstrapSubparserInvocation {
    val names: array<string> = ["cursor"]
    val values: array<BootstrapEvalValue> = [BootstrapEvalValue(
        "cursor",
        0,
        false,
        "",
        [],
        "",
        []
    )]
    val mutable: array<bool> = [false]
    val cursors: array<BootstrapSubparserCursor> = [cursor]
    val syntax: array<BootstrapExpression> = []
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        names,
        values,
        mutable,
        cursors,
        syntax,
        [],
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        handler,
        cursor.rawPosition,
        cursor.rawPosition,
        [BootstrapExpression(
            "identifier",
            "cursor",
            cursor.rawPosition,
            cursor.rawPosition,
            []
        )]
    ))
    var expression = BootstrapExpression(
        "invalid",
        "subparser-result",
        cursor.rawPosition,
        cursor.rawPosition,
        []
    )
    if (result.kind == "syntax" && result.integer >= 0 &&
        result.integer < syntax.size) {
        expression = syntax[result.integer]
    }
    bootstrapCompileGlobalsKeep(globalKeys, globalValues)
    BootstrapSubparserInvocation(
        expression,
        evaluator.errors + cursor.errors,
        evaluator.diagnostics,
        extensionRequests,
        compileInputPaths,
        compileInputContents
    )
}

fun bootstrapInvokeExtensionFinalizer(
    declarations: array<BootstrapDeclaration>,
    request: BootstrapExtensionRequest,
    typedCalls: array<BootstrapTypedCall>,
    allowedCompileEffects: int
): BootstrapEvalResult = bootstrapInvokeExtensionFinalizerIn(
    bootstrapEvalContext(declarations), declarations, request, typedCalls, allowedCompileEffects
)

fun bootstrapInvokeExtensionFinalizerIn(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>,
    request: BootstrapExtensionRequest,
    typedCalls: array<BootstrapTypedCall>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    val names: array<string> = ["payload", "expression"]
    val values: array<BootstrapEvalValue> = [
        bootstrapEvalString(request.payload),
        BootstrapEvalValue("syntax", 0, false, "", [], "", [])
    ]
    val mutable: array<bool> = [false, false]
    val cursors: array<BootstrapSubparserCursor> = []
    val syntax: array<BootstrapExpression> = [request.expression]
    val generatedDeclarations: array<BootstrapDeclaration> = []
    // Access/effect reflection must resolve the deferred syntax inside the
    // module that produced it. Preserve the active request in the evaluator;
    // an empty list forced ambiguous source-offset fallback after flattening.
    val extensionRequests: array<BootstrapExtensionRequest> = [request]
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        names,
        values,
        mutable,
        cursors,
        syntax,
        typedCalls,
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        request.finalizer,
        request.expression.begin,
        request.expression.end,
        [
            BootstrapExpression(
                "identifier", "payload", request.expression.begin,
                request.expression.begin, []
            ),
            BootstrapExpression(
                "identifier", "expression", request.expression.begin,
                request.expression.end, []
            )
        ]
    ))
    bootstrapCompileGlobalsKeep(globalKeys, globalValues)
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations
    )
}

fun bootstrapInvokeCompilerTransform(
    declarations: array<BootstrapDeclaration>,
    handler: string,
    begin: int,
    end: int,
    allowedCompileEffects: int
): BootstrapEvalResult = bootstrapInvokeCompilerTransformIn(
    bootstrapEvalContext(declarations), declarations, handler, begin, end, allowedCompileEffects
)

fun bootstrapInvokeCompilerTransformIn(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>,
    handler: string,
    begin: int,
    end: int,
    allowedCompileEffects: int
): BootstrapEvalResult {
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        generatedDeclarations,
        [],
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    bootstrapCompilerTransformActive = true
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        handler,
        begin,
        end,
        []
    ))
    bootstrapCompilerTransformActive = false
    bootstrapCompileGlobalsKeep(globalKeys, globalValues)
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations
    )
}
