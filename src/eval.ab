// Parser handlers, finalizers, and ordinary staged expressions use separate
// evaluator objects. Keep their transaction in a private per-process staging
// directory; only scalar counters are global, so scoped-region safety remains
// independent from compile-driver bookkeeping. The directory is this process's
// scratch: its files are written plainly (no fsync, no rename).
var bootstrapCompileOutputCount: int = 0
var bootstrapCompileOutputBytes: int = 0
// Compile-time globals kept between evaluations (bootstrapCompileGlobalsKeep): how many
// the per-process journal holds.
var bootstrapCompileGlobalCount: int = 0
var bootstrapBuildTransactionActive: bool = false
// Lowering errors already explained by a staged driver diagnostic (a failed
// compile-time evaluation or lift): the driver neither emits nor reports
// them again as IR failures.
var bootstrapDiagnosedLoweringErrors: int = 0
var bootstrapBuildTransactionCount: int = 0

class BootstrapCompileProgramRequest(
    val name: string,
    val entry: string,
    val output: string,
    val target: string,
    val artifact: string,
    val fast: bool,
    val cache: bool
)

class BootstrapFunctionBodyReplacement(
    val handle: int,
    val body: string,
    // The transform action that asked for it (bootstrapCompilerTransformOrigin).
    val origin: string = ""
)

class BootstrapFunctionAnnotationAddition(
    val handle: int,
    val annotation: string
)

class BootstrapIndependentModuleState(
    val name: string,
    val functionNames: array<string>,
    val sourceIdentities: array<string>,
    val functionAnnotations: array<array<string>>,
    val declarationSources: array<string>,
    val declarationSourceIdentities: array<string>,
    val generatedDeclarationSources: array<string>,
    val exportSourceNames: array<string>,
    val exportNames: array<string>,
    val checkedExports: array<bool>,
    var emitted: bool
)

class BootstrapArtifactRootRequest(
    val name: string,
    val target: string,
    val artifact: string,
    val output: string,
    val functionName: string,
    val exportName: string,
    val fast: bool,
    val cache: bool
)

class BootstrapExportRequest(
    val source: string,
    val name: string,
    val resultType: string,
    val parameterNames: array<string>,
    val parameterTypes: array<string>,
    val checked: bool,
    val internal: bool,
    // Backend lowering can introduce calls after source reachability closes.
    // Required definitions stay local, but must still be materialized.
    val required: bool
)

class BootstrapDefinedTarget(
    val name: string,
    val llvmTriple: string,
    val objectFormat: string,
    val linkerFlavor: string,
    val linkerEmulation: string,
    val hosted: bool,
    val libcFree: bool
)

var bootstrapCompileProgramRequestCount: int = 0
var bootstrapDriverDiagnosticCount: int = 0
// Set while lowering a program the front end already rejected (a denied
// compile-time effect among its errors): its `#` expressions aren't evaluated,
// so denied code never runs and the diagnosis isn't held up by it.
var bootstrapStagedEvaluationBlocked: bool = false
var bootstrapExportRequestCount: int = 0
var bootstrapDefinedTargetCount: int = 0
var bootstrapFunctionBodyReplacementCount: int = 0
var bootstrapFunctionAnnotationAdditionCount: int = 0
var bootstrapCompilerTransformActive: bool = false
var bootstrapArtifactRootRequestCount: int = 0
var bootstrapArtifactSliceActive: bool = false
var bootstrapIndependentModules: array<BootstrapIndependentModuleState> = []
// The edits the running transform stage made to other modules' declarations,
// taken with its parse result (bootstrapTakeTransformEdits).
var bootstrapTransformEdits: array<BootstrapDeclarationEdit> = []
// The running transform's action, "<sourceIdentity>:<begin>:<end>": the
// origin of the edits it makes.
var bootstrapCompilerTransformOrigin: string = ""
// While a round of lowering evaluates `#` sites (bootstrapCompileLlvmParsedCached):
// its number, the raw declarations its program was rewritten from (an edit
// names a declaration as parsed), and the edits its compile-time code made,
// which the driver commits before the next round.
var bootstrapCompileEditRound: int = -1
var bootstrapCompileRoundRaw: array<BootstrapDeclaration> = []
var bootstrapCompileRoundEdits: array<BootstrapDeclarationEdit> = []
// The `#` site being evaluated while a program is lowered, "<file>:<begin>:<end>"
// ("" between sites): the origin an edit names, wherever in the compiler API
// the request is made.
var bootstrapCompileRoundSite: string = ""

/** Where a `#` site's edit was asked for: the site being lowered (not the
 *  compiler API code the request goes through), else the request itself (in
 *  its generic's file when it is an instance's code). */
fun bootstrapCompileEditOrigin(evaluator: BootstrapEvaluator, expression: BootstrapExpression): string =
    if (bootstrapCompileRoundSite != "") bootstrapCompileRoundSite
    else "${bootstrapGenericSourceFile(evaluator.sourceIdentity)}:${expression.begin}:${expression.end}"

fun bootstrapTakeCompileRoundEdits(): array<BootstrapDeclarationEdit> {
    val edits = bootstrapCompileRoundEdits
    bootstrapCompileRoundEdits = []
    edits
}

/** Records compile-time code's change to the declaration at `handle` (of the
 *  round's rewritten program) as an edit of its raw declaration; false outside
 *  a round, or inside a region (the REPL), where it couldn't outlive the line. */
fun bootstrapStageCompileRoundEdit(
    declarations: array<BootstrapDeclaration>,
    handle: int,
    kind: string,
    payload: string,
    origin: string
): bool {
    if (bootstrapCompileEditRound < 0 || __ablaRuntimePlatformRegionActive() ||
        handle < 0 || handle >= declarations.size) return false
    var target = declarations[handle]
    // The rewrites rename overloads and add `this.`: the raw declaration is the
    // one parsed at the same place.
    for (raw in bootstrapCompileRoundRaw) {
        if (raw.sourceIdentity == target.sourceIdentity && raw.begin == target.begin &&
            raw.kind == target.kind) target = raw
    }
    if (bootstrapRuntimeModuleSource(target.sourceIdentity)) return false
    bootstrapCompileRoundEdits.append(BootstrapDeclarationEdit(
        kind,
        target.sourceIdentity,
        target.extensionOwner,
        target.name,
        bootstrapEditSignature(target),
        payload,
        [],
        origin,
        "round ${bootstrapCompileEditRound + 1}: $origin"
    ))
    true
}

fun bootstrapArtifactRootRequestRoot(): string =
    "build/.abla-artifact-root-requests-${linuxProcessId()}"

fun bootstrapStageArtifactRootRequest(
    request: BootstrapArtifactRootRequest
): bool {
    var valid = !bootstrapArtifactSliceActive &&
        bootstrapArtifactRootRequestCount < 64 &&
        bootstrapTargetTokenValid(request.name) &&
        bootstrapTargetTokenValid(request.target) &&
        bootstrapTargetTokenValid(request.artifact) &&
        bootstrapCompileOutputPathValid(request.output) &&
        bootstrapExportNameValid(request.exportName) &&
        request.functionName.size > 0 && request.functionName.size <= 128
    val root = bootstrapArtifactRootRequestRoot()
    var index = 0
    var duplicate = false
    while (valid && index < bootstrapArtifactRootRequestCount) {
        val sameArtifact = Path("$root/$index.name").readText() ==
            request.name
        val sameArtifactSettings = sameArtifact &&
            Path("$root/$index.target").readText() == request.target &&
            Path("$root/$index.artifact").readText() == request.artifact &&
            Path("$root/$index.output").readText() == request.output &&
            Path("$root/$index.fast").readText() ==
                (if (request.fast) "1" else "0") &&
            Path("$root/$index.cache").readText() ==
                (if (request.cache) "1" else "0")
        val existingFunction = Path("$root/$index.function").readText()
        val existingExport = Path("$root/$index.export").readText()
        if (sameArtifact && sameArtifactSettings &&
            existingFunction == request.functionName &&
            existingExport == request.exportName) {
            duplicate = true
            valid = false
        }
        if (sameArtifact && sameArtifactSettings && (
            existingFunction == request.functionName ||
            existingExport == request.exportName)) valid = false
        if (sameArtifact && !sameArtifactSettings) valid = false
        index = index + 1
    }
    if (duplicate) return true
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapArtifactRootRequestCount
    if (valid) valid = Path("$root/$requestIndex.name").writeTextAtomic(
        request.name
    )
    if (valid) valid = Path("$root/$requestIndex.target").writeTextAtomic(
        request.target
    )
    if (valid) valid = Path("$root/$requestIndex.artifact").writeTextAtomic(
        request.artifact
    )
    if (valid) valid = Path("$root/$requestIndex.output").writeTextAtomic(
        request.output
    )
    if (valid) valid = Path("$root/$requestIndex.function").writeTextAtomic(
        request.functionName
    )
    if (valid) valid = Path("$root/$requestIndex.export").writeTextAtomic(
        request.exportName
    )
    if (valid) valid = Path("$root/$requestIndex.fast").writeTextAtomic(
        if (request.fast) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.cache").writeTextAtomic(
        if (request.cache) "1" else "0"
    )
    if (valid) bootstrapArtifactRootRequestCount = requestIndex + 1
    if (!valid) {
        Path("$root/$requestIndex.name").remove()
        Path("$root/$requestIndex.target").remove()
        Path("$root/$requestIndex.artifact").remove()
        Path("$root/$requestIndex.output").remove()
        Path("$root/$requestIndex.function").remove()
        Path("$root/$requestIndex.export").remove()
        Path("$root/$requestIndex.fast").remove()
        Path("$root/$requestIndex.cache").remove()
    }
    valid
}

fun bootstrapTakeArtifactRootRequests(): array<BootstrapArtifactRootRequest> {
    val requests: array<BootstrapArtifactRootRequest> = []
    val root = bootstrapArtifactRootRequestRoot()
    var index = 0
    while (index < bootstrapArtifactRootRequestCount) {
        requests.append(BootstrapArtifactRootRequest(
            Path("$root/$index.name").readText(),
            Path("$root/$index.target").readText(),
            Path("$root/$index.artifact").readText(),
            Path("$root/$index.output").readText(),
            Path("$root/$index.function").readText(),
            Path("$root/$index.export").readText(),
            Path("$root/$index.fast").readText() == "1",
            Path("$root/$index.cache").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.target").remove()
        Path("$root/$index.artifact").remove()
        Path("$root/$index.output").remove()
        Path("$root/$index.function").remove()
        Path("$root/$index.export").remove()
        Path("$root/$index.fast").remove()
        Path("$root/$index.cache").remove()
        index = index + 1
    }
    bootstrapArtifactRootRequestCount = 0
    Path(root).remove()
    requests
}

fun bootstrapFunctionBodyReplacementRoot(): string =
    "build/.abla-function-body-replacements-${linuxProcessId()}"

// The declarations a running transform may change (its own module's, by
// handle); empty outside the staged parse, which then checks nothing here.
var bootstrapCompilerTransformEditable: array<bool> = []

/** Why a transform may not change the declaration at `handle` ("" when it
 *  may): the runtime's functions never (its guarantees rest on them). Another
 *  module's change is an edit the module graph applies
 *  (bootstrapApplyDeclarationEdits). */
fun bootstrapCompilerTransformTarget(
    declarations: array<BootstrapDeclaration>,
    handle: int,
    operation: string,
    ownModule: bool
): string {
    if (handle < 0 || handle >= declarations.size) return ""
    val declaration = declarations[handle]
    if (bootstrapRuntimeModuleSource(declaration.sourceIdentity)) {
        return "error[E_COMPILER_TRANSFORM_RUNTIME]: $operation can't change `${declaration.name}`: it is the runtime's (abla/runtime), whose guarantees rest on its code as written\n"
    }
    ""
}

/** Whether compile-time code may change the declaration at `handle` (""), or
 *  why not: a standard library declaration not in the transform's own module
 *  needs the `transform.library` capability. Under ABLA_COMPILE_EVAL_TRACE=1
 *  each change of the standard library is noted. */
fun bootstrapCompilerLibraryChange(
    var evaluator: BootstrapEvaluator,
    handle: int,
    operation: string,
    origin: string
): bool {
    if (handle < 0 || handle >= evaluator.declarations.size) return true
    val declaration = evaluator.declarations[handle]
    if (!bootstrapStandardLibraryModuleSource(declaration.sourceIdentity) ||
        (bootstrapCompilerTransformActive && bootstrapCompilerTransformOwns(handle))) return true
    if (!ctNativeAllowed(evaluator, BOOTSTRAP_COMPILE_TRANSFORM_LIBRARY)) {
        val denied = ctNativeDenied(
            evaluator, "$operation of the standard library's `${declaration.name}`",
            BOOTSTRAP_COMPILE_TRANSFORM_LIBRARY
        )
        return false
    }
    val trace = linuxEnvironment("ABLA_COMPILE_EVAL_TRACE")
    if (trace.found && trace.value == "1") linuxPrintStandardError(
        "note[transform]: $origin changes the standard library's `${declaration.name}` (${declaration.sourceIdentity})\n"
    )
    true
}

/** Whether the running transform's own module declares the declaration at
 *  `handle` (its change is then made in place, not as an edit). */
fun bootstrapCompilerTransformOwns(handle: int): bool =
    bootstrapCompilerTransformEditable.size == 0 ||
    (handle >= 0 && handle < bootstrapCompilerTransformEditable.size &&
     bootstrapCompilerTransformEditable[handle])

// Extension fields a transform removed (`Owner.name`), taken by the staged
// parse when it copies the module back (bootstrapRemoveExtensionFields).
var bootstrapExtensionFieldRemovals: array<string> = []

/** The extension fields of the class `owner`, as declaration indices. */
fun bootstrapEvalExtensionFields(
    declarations: array<BootstrapDeclaration>,
    owner: string
): array<int> {
    val fields: array<int> = []
    var index = 0
    while (index < declarations.size) {
        if (bootstrapIsExtensionFieldKind(declarations[index].kind) &&
            bootstrapNormalizeType(declarations[index].extensionOwner) == owner) {
            fields.append(index)
        }
        index = index + 1
    }
    fields
}

fun bootstrapStageFunctionBodyReplacement(
    replacement: BootstrapFunctionBodyReplacement
): bool {
    var valid = bootstrapCompilerTransformActive &&
        replacement.handle >= 0 && replacement.body.size > 0 &&
        replacement.body.size <= 65536 &&
        bootstrapFunctionBodyReplacementCount < 32
    val root = bootstrapFunctionBodyReplacementRoot()
    var index = 0
    while (valid && index < bootstrapFunctionBodyReplacementCount) {
        if (Path("$root/$index.handle").readText() ==
            "${replacement.handle}") valid = false
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val request = bootstrapFunctionBodyReplacementCount
    if (valid) valid = Path("$root/$request.handle").writeTextAtomic(
        "${replacement.handle}"
    )
    if (valid) valid = Path("$root/$request.body").writeTextAtomic(
        replacement.body
    )
    if (valid) valid = Path("$root/$request.origin").writeTextAtomic(
        bootstrapCompilerTransformOrigin
    )
    if (valid) bootstrapFunctionBodyReplacementCount = request + 1
    if (!valid) {
        Path("$root/$request.handle").remove()
        Path("$root/$request.body").remove()
        Path("$root/$request.origin").remove()
    }
    valid
}

fun bootstrapTakeFunctionBodyReplacements(
): array<BootstrapFunctionBodyReplacement> {
    val replacements: array<BootstrapFunctionBodyReplacement> = []
    val root = bootstrapFunctionBodyReplacementRoot()
    var index = 0
    while (index < bootstrapFunctionBodyReplacementCount) {
        replacements.append(BootstrapFunctionBodyReplacement(
            bootstrapDecimalIndex(Path("$root/$index.handle").readText()),
            Path("$root/$index.body").readText(),
            Path("$root/$index.origin").readText()
        ))
        Path("$root/$index.handle").remove()
        Path("$root/$index.body").remove()
        Path("$root/$index.origin").remove()
        index = index + 1
    }
    bootstrapFunctionBodyReplacementCount = 0
    Path(root).remove()
    replacements
}

fun bootstrapFunctionAnnotationAdditionRoot(): string =
    "build/.abla-function-annotation-additions-${linuxProcessId()}"

fun bootstrapStageFunctionAnnotationAddition(
    addition: BootstrapFunctionAnnotationAddition
): bool {
    var valid = bootstrapCompilerTransformActive && addition.handle >= 0 &&
        bootstrapTargetTokenValid(addition.annotation) &&
        bootstrapFunctionAnnotationAdditionCount < 128
    val root = bootstrapFunctionAnnotationAdditionRoot()
    var index = 0
    while (valid && index < bootstrapFunctionAnnotationAdditionCount) {
        if (Path("$root/$index.handle").readText() == "${addition.handle}" &&
            Path("$root/$index.annotation").readText() ==
                addition.annotation) valid = false
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val request = bootstrapFunctionAnnotationAdditionCount
    if (valid) valid = Path("$root/$request.handle").writeTextAtomic(
        "${addition.handle}"
    )
    if (valid) valid = Path("$root/$request.annotation").writeTextAtomic(
        addition.annotation
    )
    if (valid) bootstrapFunctionAnnotationAdditionCount = request + 1
    if (!valid) {
        Path("$root/$request.handle").remove()
        Path("$root/$request.annotation").remove()
    }
    valid
}

fun bootstrapTakeFunctionAnnotationAdditions(
): array<BootstrapFunctionAnnotationAddition> {
    val additions: array<BootstrapFunctionAnnotationAddition> = []
    val root = bootstrapFunctionAnnotationAdditionRoot()
    var index = 0
    while (index < bootstrapFunctionAnnotationAdditionCount) {
        additions.append(BootstrapFunctionAnnotationAddition(
            bootstrapDecimalIndex(Path("$root/$index.handle").readText()),
            Path("$root/$index.annotation").readText()
        ))
        Path("$root/$index.handle").remove()
        Path("$root/$index.annotation").remove()
        index = index + 1
    }
    bootstrapFunctionAnnotationAdditionCount = 0
    Path(root).remove()
    additions
}

fun bootstrapDefinedTargetRoot(): string =
    "build/.abla-defined-targets-${linuxProcessId()}"

fun bootstrapTargetTokenValid(value: string): bool {
    var valid = value.size > 0 && value.size <= 128
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122)
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !digit && byte != 45 && byte != 46 && byte != 95) {
            valid = false
        }
        index = index + 1
    }
    valid
}

fun bootstrapIndependentModuleHandleValid(handle: int): bool =
    handle >= 0 && handle < bootstrapIndependentModules.size

fun bootstrapIndependentModuleSourceValid(source: string): bool {
    var valid = source.size > 0 && source.size <= 4096 && source[0] != 60
    var index = 0
    while (valid && index < source.size) {
        if (source[index] == 0 || source[index] == 10 ||
            source[index] == 13) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapIndependentModuleHasSource(
    sources: array<string>,
    source: string
): bool {
    var found = false
    var index = 0
    while (index < sources.size) {
        if (sources[index] == source) found = true
        index = index + 1
    }
    found
}

fun bootstrapIndependentModuleSourcePath(source: string): string {
    var result = source
    if (source.size > 0 && source[0] != 47) {
        result = currentDirectory().child(source).text
    }
    result
}

fun bootstrapIndependentDeclarationNameValid(name: string): bool {
    var valid = name.size > 0 && name.size <= 128
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !(index > 0 && digit)) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapStageDefinedTarget(target: BootstrapDefinedTarget): bool {
    var valid = bootstrapDefinedTargetCount < 16 &&
        bootstrapTargetTokenValid(target.name) &&
        bootstrapTargetTokenValid(target.llvmTriple) &&
        bootstrapTargetTokenValid(target.objectFormat) &&
        bootstrapTargetTokenValid(target.linkerFlavor) &&
        bootstrapTargetTokenValid(target.linkerEmulation) &&
        !(target.hosted && target.libcFree)
    val root = bootstrapDefinedTargetRoot()
    var index = 0
    while (valid && index < bootstrapDefinedTargetCount) {
        if (Path("$root/$index.name").readText() == target.name) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val targetIndex = bootstrapDefinedTargetCount
    if (valid) valid = Path("$root/$targetIndex.name").writeTextAtomic(
        target.name
    )
    if (valid) valid = Path("$root/$targetIndex.triple").writeTextAtomic(
        target.llvmTriple
    )
    if (valid) valid = Path("$root/$targetIndex.format").writeTextAtomic(
        target.objectFormat
    )
    if (valid) valid = Path("$root/$targetIndex.linker").writeTextAtomic(
        target.linkerFlavor
    )
    if (valid) valid = Path("$root/$targetIndex.emulation").writeTextAtomic(
        target.linkerEmulation
    )
    if (valid) valid = Path("$root/$targetIndex.hosted").writeTextAtomic(
        if (target.hosted) "1" else "0"
    )
    if (valid) valid = Path("$root/$targetIndex.libc-free").writeTextAtomic(
        if (target.libcFree) "1" else "0"
    )
    if (valid) bootstrapDefinedTargetCount = targetIndex + 1
    if (!valid) {
        Path("$root/$targetIndex.name").remove()
        Path("$root/$targetIndex.triple").remove()
        Path("$root/$targetIndex.format").remove()
        Path("$root/$targetIndex.linker").remove()
        Path("$root/$targetIndex.emulation").remove()
        Path("$root/$targetIndex.hosted").remove()
        Path("$root/$targetIndex.libc-free").remove()
    }
    valid
}

fun bootstrapTakeDefinedTargets(): array<BootstrapDefinedTarget> {
    val targets: array<BootstrapDefinedTarget> = []
    val root = bootstrapDefinedTargetRoot()
    var index = 0
    while (index < bootstrapDefinedTargetCount) {
        targets.append(BootstrapDefinedTarget(
            Path("$root/$index.name").readText(),
            Path("$root/$index.triple").readText(),
            Path("$root/$index.format").readText(),
            Path("$root/$index.linker").readText(),
            Path("$root/$index.emulation").readText(),
            Path("$root/$index.hosted").readText() == "1",
            Path("$root/$index.libc-free").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.triple").remove()
        Path("$root/$index.format").remove()
        Path("$root/$index.linker").remove()
        Path("$root/$index.emulation").remove()
        Path("$root/$index.hosted").remove()
        Path("$root/$index.libc-free").remove()
        index = index + 1
    }
    bootstrapDefinedTargetCount = 0
    Path(root).remove()
    targets
}

fun bootstrapExportRequestRoot(): string =
    "build/.abla-export-requests-${linuxProcessId()}"

fun bootstrapForeignSymbolNameAvailable(name: string): bool =
    name != "main" &&
    name != "abla_owned_bytes_data" &&
    name != "abla_owned_bytes_length" &&
    name != "abla_owned_bytes_release"

fun bootstrapExportNameValid(name: string): bool {
    // LLVM and native object formats permit long linker identifiers; C++
    // template mangling routinely exceeds 128 bytes. Keep input bounded for
    // compile-time evaluation without rejecting valid ABI names.
    var valid = name.size > 0 && name.size <= 4096 &&
        bootstrapForeignSymbolNameAvailable(name)
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95
        val digit = byte >= 48 && byte <= 57
        if (!alpha && !(index > 0 && digit)) valid = false
        index = index + 1
    }
    valid
}

fun bootstrapLinkerSymbolNameValid(name: string): bool {
    // internalFunction names an object-format symbol, not a C declaration.
    // Accept the portable unquoted ELF/assembler spelling shared by LLVM and
    // GNU-family assemblers. In particular, compiler-created local helpers
    // conventionally contain `.` and `$`. Keep whitespace, quoting, version
    // suffixes, and assembler punctuation out so this remains data, never
    // injected syntax.
    var valid = name.size > 0 && name.size <= 4096 &&
        bootstrapForeignSymbolNameAvailable(name)
    var index = 0
    while (valid && index < name.size) {
        val byte = name[index]
        val alpha = (byte >= 65 && byte <= 90) ||
            (byte >= 97 && byte <= 122) || byte == 95
        val digit = byte >= 48 && byte <= 57
        val linkerPunctuation = byte == 46 || byte == 36
        if (!alpha && !linkerPunctuation && !(index > 0 && digit)) {
            valid = false
        }
        index = index + 1
    }
    valid
}

fun bootstrapExportScalarTypeValid(type: string): bool =
    type == "bool" || type == "i8" || type == "u8" ||
    type == "char" || type == "i16" || type == "u16" ||
    type == "i32" || type == "u32" || type == "i64" || type == "u64" ||
    type == "f32" || type == "f64"

fun bootstrapExportResultTypeValid(type: string): bool =
    type == "void" || type == "string" ||
    bootstrapExportScalarTypeValid(type)

fun bootstrapExportParameterTypeValid(type: string): bool =
    type == "string" || type == "function:(i64)->i64" ||
    bootstrapExportScalarTypeValid(type)

fun bootstrapExportRuntimeType(
    declarations: array<BootstrapDeclaration>,
    type: string
): string {
    val normalized = bootstrapNormalizeType(type)
    val underlying = bootstrapScalarTypeUnderlying(
        declarations, normalized
    )
    if (underlying == "") normalized else underlying
}

fun bootstrapExportCallbackUseValidAt(
    expression: BootstrapExpression,
    name: string,
    nestedFunction: bool
): bool {
    var valid = true
    if (expression.text == name) {
        valid = expression.kind == "call" && !nestedFunction
    }
    val nested = nestedFunction || expression.kind == "lambda" ||
        expression.kind == "lambda.move"
    var child = 0
    while (valid && child < expression.children.size) {
        valid = bootstrapExportCallbackUseValidAt(
            expression.children[child],
            name,
            nested
        )
        child = child + 1
    }
    valid
}

// A callback borrowed from a foreign caller is valid only for the duration of
// the exported call. Restrict its source uses to immediate invocations in the
// exported function itself: it cannot be stored, returned, captured, or passed
// to another function that might retain it.
fun bootstrapExportCallbackUseValid(
    expression: BootstrapExpression,
    name: string
): bool = bootstrapExportCallbackUseValidAt(expression, name, false)

fun bootstrapStageAnnotatedExports(parsed: BootstrapParseResult): int {
    var errors = 0
    var declarationIndex = 0
    while (declarationIndex < parsed.declarations.size) {
        val declaration = parsed.declarations[declarationIndex]
        var annotation = 0
        while (annotation < declaration.annotations.size) {
            val annotationName = declaration.annotations[annotation]
            if (annotationName == "export" ||
                annotationName == "exportChecked") {
                val exportNames: array<string> = []
                var valid = annotation < declaration.annotationArguments.size
                if (valid) {
                    val argument = declaration.annotationArguments[annotation]
                    if (argument.kind == "string") {
                        exportNames.append(argument.text)
                    } else if (argument.kind == "array" &&
                               argument.children.size > 0) {
                        var exportArgument = 0
                        while (valid && exportArgument <
                               argument.children.size) {
                            val candidate =
                                argument.children[exportArgument]
                            valid = candidate.kind == "string"
                            if (valid) exportNames.append(candidate.text)
                            exportArgument = exportArgument + 1
                        }
                    } else valid = false
                }
                valid = valid && declaration.kind == "fun" &&
                    declaration.extensionOwner == "" &&
                    declaration.parameters.size <= 16 &&
                    exportNames.size > 0
                var exportNameIndex = 0
                while (valid && exportNameIndex < exportNames.size) {
                    valid = bootstrapExportNameValid(
                        exportNames[exportNameIndex]
                    )
                    exportNameIndex = exportNameIndex + 1
                }
                val resultType = bootstrapExportRuntimeType(
                    parsed.declarations, declaration.resultType
                )
                valid = valid && bootstrapExportResultTypeValid(resultType)
                val parameterNames: array<string> = []
                val parameterTypes: array<string> = []
                var parameter = 0
                while (valid && parameter < declaration.parameters.size) {
                    val parameterType = bootstrapExportRuntimeType(
                        parsed.declarations,
                        declaration.parameterTypes[parameter]
                    )
                    valid = declaration.parameterKinds[parameter] ==
                        "parameter" &&
                        bootstrapExportParameterTypeValid(parameterType)
                    if (valid &&
                        parameterType == "function:(i64)->i64") {
                        valid = bootstrapExportCallbackUseValid(
                            declaration.expression,
                            declaration.parameters[parameter]
                        )
                    }
                    if (valid) {
                        parameterNames.append(
                            declaration.parameters[parameter]
                        )
                        parameterTypes.append(parameterType)
                    }
                    parameter = parameter + 1
                }
                val exportRequestBegin = bootstrapExportRequestCount
                exportNameIndex = 0
                while (valid && exportNameIndex < exportNames.size) {
                    valid = bootstrapStageExportRequest(
                        BootstrapExportRequest(
                            declaration.name,
                            exportNames[exportNameIndex],
                            resultType,
                            parameterNames,
                            parameterTypes,
                            annotationName == "exportChecked",
                            false,
                            false
                        )
                    )
                    exportNameIndex = exportNameIndex + 1
                }
                if (!valid) bootstrapTruncateExportRequests(exportRequestBegin)
                if (!valid) {
                    errors = errors + 1
                    bootstrapStageDriverDiagnostic(
                        "error[E_EXPORT_ANNOTATION]: @${annotationName} on `${declaration.name}` requires unique non-reserved string name(s) and a supported top-level export signature\n"
                    )
                }
            }
            annotation = annotation + 1
        }
        declarationIndex = declarationIndex + 1
    }
    errors
}

fun bootstrapExportRequestsEqual(
    left: BootstrapExportRequest,
    right: BootstrapExportRequest
): bool {
    var equal = left.source == right.source &&
        left.name == right.name &&
        left.resultType == right.resultType &&
        left.checked == right.checked &&
        left.internal == right.internal &&
        left.required == right.required &&
        left.parameterNames.size == right.parameterNames.size &&
        left.parameterTypes.size == right.parameterTypes.size
    var index = 0
    while (equal && index < left.parameterNames.size) {
        equal = left.parameterNames[index] == right.parameterNames[index]
        index = index + 1
    }
    index = 0
    while (equal && index < left.parameterTypes.size) {
        equal = left.parameterTypes[index] == right.parameterTypes[index]
        index = index + 1
    }
    equal
}

// A staged request is one file: its fields as tokens (bootstrapCompileGlobalToken).
fun bootstrapExportRequestRecord(request: BootstrapExportRequest): string {
    var record = "${bootstrapCompileGlobalToken(request.source)}${bootstrapCompileGlobalToken(request.name)}${bootstrapCompileGlobalToken(request.resultType)}${if (request.checked) "1:1" else "1:0"}${if (request.internal) "1:1" else "1:0"}${if (request.required) "1:1" else "1:0"}${bootstrapCompileGlobalToken("${request.parameterTypes.size}")}"
    var parameter = 0
    while (parameter < request.parameterTypes.size) {
        record = "$record${bootstrapCompileGlobalToken(request.parameterNames[parameter])}${bootstrapCompileGlobalToken(request.parameterTypes[parameter])}"
        parameter = parameter + 1
    }
    record
}

fun bootstrapExportRequestAt(
    root: string,
    index: int
): BootstrapExportRequest {
    val reader = BootstrapCompileGlobalReader(Path("$root/$index").readText(), 0, true)
    val source = reader.token()
    val name = reader.token()
    val resultType = reader.token()
    val checked = reader.token() == "1"
    val internal = reader.token() == "1"
    val required = reader.token() == "1"
    val parameterCount = bootstrapDecimalIndex(reader.token())
    val parameterNames: array<string> = []
    val parameterTypes: array<string> = []
    var parameter = 0
    while (parameter < parameterCount) {
        parameterNames.append(reader.token())
        parameterTypes.append(reader.token())
        parameter = parameter + 1
    }
    BootstrapExportRequest(
        source, name, resultType, parameterNames, parameterTypes,
        checked, internal, required
    )
}

fun bootstrapStageExportRequest(request: BootstrapExportRequest): bool {
    var valid = if (request.internal) {
        bootstrapLinkerSymbolNameValid(request.name)
    } else bootstrapExportNameValid(request.name)
    val root = bootstrapExportRequestRoot()
    // `names` lists the staged names, one per line in staging order (names have
    // no line breaks), so a duplicate is found in one read: reading every earlier
    // request's files took seconds for a slice program with hundreds of entries.
    val names = if (bootstrapExportRequestCount > 0) Path("$root/names").readText() else ""
    var index = 0
    var start = 0
    while (valid && index < bootstrapExportRequestCount && start < names.size) {
        var end = start
        while (end < names.size && names[end] != 10) end = end + 1
        if (names.slice(start, end) == request.name) {
            // Framework aggregators may independently discover the same
            // monolithic link edge. Repeating an identical request is
            // idempotent; a different source, ABI, or linkage for the same
            // object symbol remains a real collision.
            if (bootstrapExportRequestsEqual(
                bootstrapExportRequestAt(root, index), request
            )) return true
            valid = false
        }
        start = end + 1
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapExportRequestCount
    if (valid) valid = Path("$root/$requestIndex").writeText(
        bootstrapExportRequestRecord(request)
    )
    // The record is complete before its name is listed.
    if (valid) valid = Path("$root/names").appendText("${request.name}\n")
    if (valid) bootstrapExportRequestCount = requestIndex + 1
    if (!valid) Path("$root/$requestIndex").remove()
    valid
}

// Forgets the requests staged after the first `count` (their files are rewritten
// by later requests; the name list keeps its first `count` lines).
fun bootstrapTruncateExportRequests(count: int): void {
    if (count < bootstrapExportRequestCount) {
        val path = Path("${bootstrapExportRequestRoot()}/names")
        val names = path.readText()
        var end = 0
        var kept = 0
        while (kept < count && end < names.size) {
            if (names[end] == 10) kept = kept + 1
            end = end + 1
        }
        val rewritten = path.writeText(names.slice(0, end))
        bootstrapExportRequestCount = count
    }
    return
}

fun bootstrapTakeExportRequests(): array<BootstrapExportRequest> {
    val requests: array<BootstrapExportRequest> = []
    val root = bootstrapExportRequestRoot()
    var index = 0
    while (index < bootstrapExportRequestCount) {
        requests.append(bootstrapExportRequestAt(root, index))
        Path("$root/$index").remove()
        index = index + 1
    }
    bootstrapExportRequestCount = 0
    Path("$root/names").remove()
    Path(root).remove()
    requests
}

// Required internal definitions must enter source lowering before the LLVM
// reachability pass consumes the staged requests. Ordinary internalFunction
// mappings deliberately do not become roots here: their native/assembly edges
// remain responsible for retaining them.
fun bootstrapRequiredInternalFunctionSources(): array<string> {
    val sources: array<string> = []
    val root = bootstrapExportRequestRoot()
    var index = 0
    while (index < bootstrapExportRequestCount) {
        val request = bootstrapExportRequestAt(root, index)
        if (request.required) sources.append(request.source)
        index = index + 1
    }
    sources
}

fun bootstrapDriverDiagnosticRoot(): string =
    "build/.abla-driver-diagnostics-${linuxProcessId()}"

fun bootstrapNoteDiagnosedLoweringErrors(count: int): void {
    bootstrapDiagnosedLoweringErrors = bootstrapDiagnosedLoweringErrors + count
    bootstrapSemanticUnit()
}

// Named-argument errors of the current compilation (module.ab's normalizer):
// semantic mistakes the parse result counts, which code generation must not
// lower into verifier noise.
var bootstrapNamedArgumentErrors: int = 0

fun bootstrapNoteNamedArgumentErrors(count: int): void {
    bootstrapNamedArgumentErrors = bootstrapNamedArgumentErrors + count
    bootstrapSemanticUnit()
}

fun bootstrapPeekNamedArgumentErrors(): int = bootstrapNamedArgumentErrors

fun bootstrapTakeNamedArgumentErrors(): int {
    val count = bootstrapNamedArgumentErrors
    bootstrapNamedArgumentErrors = 0
    count
}

fun bootstrapTakeDiagnosedLoweringErrors(): int {
    val count = bootstrapDiagnosedLoweringErrors
    bootstrapDiagnosedLoweringErrors = 0
    count
}

fun bootstrapStageDriverDiagnostic(diagnostic: string): void {
    // Past 8 KiB a diagnostic keeps its first whole lines, so its first errors
    // still say what they are.
    var kept = diagnostic
    if (kept.size > 8192) {
        var end = 8192
        while (end > 0 && kept[end - 1] != 10) end = end - 1
        kept = kept.slice(0, end)
    }
    if (kept.size > 0 && bootstrapDriverDiagnosticCount < 64) {
        val root = bootstrapDriverDiagnosticRoot()
        if (Path(root).createDirectories() && Path(
            "$root/$bootstrapDriverDiagnosticCount"
        ).writeText(kept)) {
            bootstrapDriverDiagnosticCount =
                bootstrapDriverDiagnosticCount + 1
        }
    }
    bootstrapSemanticUnit()
}

fun bootstrapTakeDriverDiagnostics(): string {
    var diagnostics = ""
    val root = bootstrapDriverDiagnosticRoot()
    var index = 0
    while (index < bootstrapDriverDiagnosticCount) {
        val path = Path("$root/$index")
        diagnostics = "$diagnostics${path.readText()}"
        path.remove()
        index = index + 1
    }
    bootstrapDriverDiagnosticCount = 0
    Path(root).remove()
    diagnostics
}

fun bootstrapCompileProgramRequestRoot(): string =
    "build/.abla-program-requests-${linuxProcessId()}"

fun bootstrapStageCompileProgramRequest(
    request: BootstrapCompileProgramRequest
): bool {
    var valid = bootstrapCompileProgramRequestCount < 32
    val root = bootstrapCompileProgramRequestRoot()
    var index = 0
    while (valid && index < bootstrapCompileProgramRequestCount) {
        if (Path("$root/$index.name").readText() == request.name ||
            Path("$root/$index.output").readText() == request.output) {
            valid = false
        }
        index = index + 1
    }
    if (valid) valid = Path(root).createDirectories()
    val requestIndex = bootstrapCompileProgramRequestCount
    if (valid) valid = Path("$root/$requestIndex.name").writeTextAtomic(
        request.name
    )
    if (valid) valid = Path("$root/$requestIndex.entry").writeTextAtomic(
        request.entry
    )
    if (valid) valid = Path("$root/$requestIndex.output").writeTextAtomic(
        request.output
    )
    if (valid) valid = Path("$root/$requestIndex.target").writeTextAtomic(
        request.target
    )
    if (valid) valid = Path("$root/$requestIndex.artifact").writeTextAtomic(
        request.artifact
    )
    if (valid) valid = Path("$root/$requestIndex.fast").writeTextAtomic(
        if (request.fast) "1" else "0"
    )
    if (valid) valid = Path("$root/$requestIndex.cache").writeTextAtomic(
        if (request.cache) "1" else "0"
    )
    if (valid) bootstrapCompileProgramRequestCount = requestIndex + 1
    if (!valid) {
        Path("$root/$requestIndex.name").remove()
        Path("$root/$requestIndex.entry").remove()
        Path("$root/$requestIndex.output").remove()
        Path("$root/$requestIndex.target").remove()
        Path("$root/$requestIndex.artifact").remove()
        Path("$root/$requestIndex.fast").remove()
        Path("$root/$requestIndex.cache").remove()
    }
    valid
}

fun bootstrapTakeCompileProgramRequests(
): array<BootstrapCompileProgramRequest> {
    val requests: array<BootstrapCompileProgramRequest> = []
    val root = bootstrapCompileProgramRequestRoot()
    var index = 0
    while (index < bootstrapCompileProgramRequestCount) {
        requests.append(BootstrapCompileProgramRequest(
            Path("$root/$index.name").readText(),
            Path("$root/$index.entry").readText(),
            Path("$root/$index.output").readText(),
            Path("$root/$index.target").readText(),
            Path("$root/$index.artifact").readText(),
            Path("$root/$index.fast").readText() == "1",
            Path("$root/$index.cache").readText() == "1"
        ))
        Path("$root/$index.name").remove()
        Path("$root/$index.entry").remove()
        Path("$root/$index.output").remove()
        Path("$root/$index.target").remove()
        Path("$root/$index.artifact").remove()
        Path("$root/$index.fast").remove()
        Path("$root/$index.cache").remove()
        index = index + 1
    }
    bootstrapCompileProgramRequestCount = 0
    Path(root).remove()
    requests
}

fun bootstrapCompileOutputRoot(): string =
    "build/.abla-compile-outputs-${linuxProcessId()}"

fun bootstrapBuildTransactionRoot(): string =
    "build/.abla-build-transaction-${linuxProcessId()}"

fun bootstrapClearBuildTransactionJournal(): void {
    val root = bootstrapBuildTransactionRoot()
    var index = 0
    while (index < bootstrapBuildTransactionCount) {
        Path("$root/$index.path").remove()
        Path("$root/$index.existed").remove()
        Path("$root/$index.data").remove()
        Path("$root/$index.dropped").remove()
        index = index + 1
    }
    Path(root).remove()
    bootstrapBuildTransactionCount = 0
    bootstrapSemanticUnit()
}

fun bootstrapBeginBuildTransaction(): void {
    bootstrapBuildTransactionActive = false
    bootstrapClearBuildTransactionJournal()
    bootstrapBuildTransactionActive = true
    bootstrapSemanticUnit()
}

fun bootstrapRecordBuildTransactionPath(path: string): bool {
    // Callers only journal while a transaction is active. Keeping the active
    // flag out of this leaf also avoids making filesystem safety depend on a
    // managed global surviving a compiler memory-region boundary.
    var valid = path.size > 0 && path.size <= 4096
    val root = bootstrapBuildTransactionRoot()
    var recorded = false
    var index = 0
    while (valid && !recorded && index < bootstrapBuildTransactionCount) {
        if (Path("$root/$index.path").readText() == path) recorded = true
        index = index + 1
    }
    if (recorded) return true
    if (bootstrapBuildTransactionCount >= BOOTSTRAP_COMPILE_OUTPUT_LIMIT) valid = false
    val destination = Path(path)
    val existed = destination.exists()
    val journalIndex = bootstrapBuildTransactionCount
    if (valid) valid = Path(root).createDirectories()
    if (valid) valid = Path("$root/$journalIndex.path").writeTextAtomic(path)
    if (valid) valid = Path("$root/$journalIndex.existed").writeTextAtomic(
        if (existed) "1" else "0"
    )
    if (valid && existed) valid = destination.moveTo(
        Path("$root/$journalIndex.data")
    )
    if (valid) {
        bootstrapBuildTransactionCount = journalIndex + 1
    } else {
        Path("$root/$journalIndex.path").remove()
        Path("$root/$journalIndex.existed").remove()
    }
    valid
}

/** A journaled output the build removed on purpose: committing leaves it removed (a rollback
 *  still restores it). */
fun bootstrapDropBuildTransactionPath(path: string): void {
    val root = bootstrapBuildTransactionRoot()
    var index = 0
    while (index < bootstrapBuildTransactionCount) {
        if (Path("$root/$index.path").readText() == path) {
            Path("$root/$index.dropped").writeTextAtomic("1")
        }
        index = index + 1
    }
    return
}

fun bootstrapCommitBuildTransaction(): void {
    bootstrapBuildTransactionActive = false
    val root = bootstrapBuildTransactionRoot()
    var index = 0
    while (index < bootstrapBuildTransactionCount) {
        val path = Path("$root/$index.path").readText()
        if (Path("$root/$index.existed").readText() == "1" &&
            !Path(path).exists() && !Path("$root/$index.dropped").exists()) {
            Path("$root/$index.data").moveTo(Path(path))
        }
        index = index + 1
    }
    bootstrapClearBuildTransactionJournal()
    bootstrapSemanticUnit()
}

fun bootstrapRollbackBuildTransaction(): bool {
    bootstrapBuildTransactionActive = false
    var restored = true
    val root = bootstrapBuildTransactionRoot()
    var index = bootstrapBuildTransactionCount
    while (index > 0) {
        index = index - 1
        val path = Path("$root/$index.path").readText()
        if (Path("$root/$index.existed").readText() == "1") {
            Path(path).remove()
            if (!Path("$root/$index.data").moveTo(Path(path))) {
                restored = false
            }
        } else if (!Path(path).remove() && Path(path).exists()) {
            restored = false
        }
    }
    bootstrapClearBuildTransactionJournal()
    restored
}

/** A compilation starts: no outputs staged, no compile-time globals kept. */
fun bootstrapBeginCompileOutputs(): void {
    bootstrapClearCompileOutputs()
    bootstrapForgetCompileGlobals()
    bootstrapSemanticUnit()
}

fun bootstrapClearCompileOutputs(): void {
    val root = bootstrapCompileOutputRoot()
    var index = 0
    while (index < bootstrapCompileOutputCount) {
        Path("$root/$index.path").remove()
        Path("$root/$index.data").remove()
        Path("$root/$index.kind").remove()
        Path("$root/$index.revision").remove()
        index = index + 1
    }
    Path(root).remove()
    bootstrapCompileOutputCount = 0
    bootstrapCompileOutputBytes = 0
    bootstrapSemanticUnit()
}

// --- compile-time globals ------------------------------------------------------
//
// A `compile val` / `compile var` holds one value for a whole compilation: the first
// reference evaluates its initializer, and what any evaluation changes through it (an
// object's fields, an array's elements, a var's assignment) is what every later one sees —
// parser handlers, finalizers, transforms and compile expressions alike, across modules.
// Between evaluations the values live in a per-process journal (like the compile outputs:
// only scalar counters are process globals), so a kept value holds data only — integers,
// booleans, strings, null, arrays and objects. A value holding anything else (a closure,
// a handle) is evaluated afresh at each evaluation, as before.

fun bootstrapCompileGlobalRoot(): string =
    "build/.abla-compile-globals-${linuxProcessId()}"

fun bootstrapCompileGlobalKey(declaration: BootstrapDeclaration): string =
    "${declaration.sourceIdentity}:${declaration.name}"

fun bootstrapForgetCompileGlobals(): void {
    val root = bootstrapCompileGlobalRoot()
    var index = 0
    while (index < bootstrapCompileGlobalCount) {
        Path("$root/$index.key").remove()
        Path("$root/$index.value").remove()
        index = index + 1
    }
    Path(root).remove()
    bootstrapCompileGlobalCount = 0
    bootstrapSemanticUnit()
}

fun bootstrapCompileGlobalSlot(key: string): int {
    val root = bootstrapCompileGlobalRoot()
    var found = -1
    var index = 0
    while (found < 0 && index < bootstrapCompileGlobalCount) {
        if (Path("$root/$index.key").readText() == key) found = index
        index = index + 1
    }
    found
}

/** What an earlier evaluation kept under `key` (invalid when none); a kept
 *  closure's lambda joins `syntax`. */
fun bootstrapCompileGlobalLoad(
    key: string,
    declarations: array<BootstrapDeclaration>,
    syntax: array<BootstrapExpression>
): BootstrapEvalValue {
    val slot = bootstrapCompileGlobalSlot(key)
    if (slot < 0) return bootstrapEvalInvalid()
    val text = Path("${bootstrapCompileGlobalRoot()}/$slot.value").readText()
    if (text == "") return bootstrapEvalInvalid()
    val decoded = bootstrapLiftDecode(text, declarations, syntax)
    if (decoded.problem != "") return bootstrapEvalInvalid()
    decoded.value
}

/** Keep the globals an evaluation read (and possibly changed) for the next
 *  ones, in the lift codec (shared and cyclic values, closures). */
fun bootstrapCompileGlobalsKeep(
    keys: array<string>,
    values: array<BootstrapEvalValue>,
    syntax: array<BootstrapExpression>,
    declarations: array<BootstrapDeclaration>
): void {
    val root = bootstrapCompileGlobalRoot()
    var index = 0
    while (index < keys.size) {
        val encoded = bootstrapLiftEncode(
            values[index], syntax, declarations
        ).bytes
        var slot = bootstrapCompileGlobalSlot(keys[index])
        if (encoded == "") {
            if (slot >= 0) Path("$root/$slot.value").writeText("")
        } else {
            var written = true
            if (slot < 0) {
                slot = bootstrapCompileGlobalCount
                written = Path(root).createDirectories() &&
                    Path("$root/$slot.key").writeText(keys[index])
                if (written) bootstrapCompileGlobalCount = slot + 1
            }
            if (written) Path("$root/$slot.value").writeText(encoded)
        }
        index = index + 1
    }
    bootstrapSemanticUnit()
}

/** The compile globals' kept values as they are now ("key", "value" pairs),
 *  for a round of lowering that runs again to start from them. */
fun bootstrapSnapshotCompileGlobals(): array<string> {
    val root = bootstrapCompileGlobalRoot()
    val pairs: array<string> = []
    var index = 0
    while (index < bootstrapCompileGlobalCount) {
        pairs.append(Path("$root/$index.key").readText())
        pairs.append(Path("$root/$index.value").readText())
        index = index + 1
    }
    pairs
}

/** Puts back what bootstrapSnapshotCompileGlobals took. */
fun bootstrapRestoreCompileGlobals(pairs: array<string>): void {
    bootstrapForgetCompileGlobals()
    val root = bootstrapCompileGlobalRoot()
    var index = 0
    while (index + 1 < pairs.size) {
        val slot = bootstrapCompileGlobalCount
        if (Path(root).createDirectories() &&
            Path("$root/$slot.key").writeText(pairs[index]) &&
            Path("$root/$slot.value").writeText(pairs[index + 1])) {
            bootstrapCompileGlobalCount = slot + 1
        }
        index = index + 2
    }
    return
}

fun bootstrapCompileGlobalToken(text: string): string = "${text.size}:$text"

/** Bytewise `a < b`. */
fun bootstrapTextBefore(a: string, b: string): bool {
    var index = 0
    while (index < a.size && index < b.size) {
        if (a[index] != b[index]) return a[index] < b[index]
        index = index + 1
    }
    a.size < b.size
}

/** The names in directory `path` ("." and ".." left out), sorted bytewise. */
/** `names` sorted bytewise. */
fun bootstrapSortedNames(names: array<string>): array<string> {
    val sorted: array<string> = []
    for (name in names) {
        sorted.append(name)
        var at = sorted.size - 1
        while (at > 0 && bootstrapTextBefore(sorted[at], sorted[at - 1])) {
            val swap = sorted[at - 1]
            sorted[at - 1] = sorted[at]
            sorted[at] = swap
            at = at - 1
        }
    }
    sorted
}

/** A data value's journal text: "" when it holds anything but data. */
fun bootstrapCompileGlobalEncode(value: BootstrapEvalValue): string {
    var budget = BootstrapCompileGlobalBudget(0)
    bootstrapCompileGlobalEncodeWithin(value, 0, budget)
}

// What the journal encodes is a tree: a value nested deeper than this, or
// with more parts, isn't kept (a cyclic graph, reached again through itself,
// never ends, and a graph sharing its parts would be written out once per
// path). Such a value is made afresh by the next evaluation.
val BOOTSTRAP_COMPILE_GLOBAL_DEPTH = 512
val BOOTSTRAP_COMPILE_GLOBAL_PARTS = 1000000

class BootstrapCompileGlobalBudget(var parts: int)

fun bootstrapCompileGlobalEncodeWithin(
    value: BootstrapEvalValue,
    depth: int,
    var budget: BootstrapCompileGlobalBudget
): string {
    budget.parts = budget.parts + 1
    if (depth > BOOTSTRAP_COMPILE_GLOBAL_DEPTH ||
        budget.parts > BOOTSTRAP_COMPILE_GLOBAL_PARTS) return ""
    val kind = value.kind
    if (kind != "integer" && kind != "boolean" && kind != "string" &&
        kind != "null" && kind != "void" && kind != "array" &&
        kind != "object" && kind != "f64" && kind != "f32" &&
        kind != "map" && kind != "delegate") return ""
    var out = "${bootstrapCompileGlobalToken(kind)}${bootstrapCompileGlobalToken("${value.integer}")}${bootstrapCompileGlobalToken(if (value.boolean) "1" else "0")}${bootstrapCompileGlobalToken(value.text)}${bootstrapCompileGlobalToken(value.owner)}${bootstrapCompileGlobalToken("${value.fieldNames.size}")}"
    var index = 0
    while (index < value.fieldNames.size) {
        out = "$out${bootstrapCompileGlobalToken(value.fieldNames[index])}"
        index = index + 1
    }
    out = "$out${bootstrapCompileGlobalToken("${value.elements.size}")}"
    index = 0
    while (index < value.elements.size) {
        val element = bootstrapCompileGlobalEncodeWithin(
            value.elements[index], depth + 1, budget
        )
        if (element == "") return ""
        out = "$out$element"
        index = index + 1
    }
    out
}

class BootstrapCompileGlobalReader(val text: string, var at: int, var ok: bool) {
    fun token(): string {
        var length = 0
        var digits = 0
        while (this.ok && this.at < this.text.size && this.text[this.at] != 58) {
            val digit = this.text[this.at] - 48
            if (digit < 0 || digit > 9) this.ok = false
            length = length * 10 + digit
            digits = digits + 1
            this.at = this.at + 1
        }
        if (digits == 0 || this.at >= this.text.size) this.ok = false
        if (!this.ok || this.at + 1 + length > this.text.size) {
            this.ok = false
            return ""
        }
        val begin = this.at + 1
        this.at = begin + length
        this.text.slice(begin, begin + length)
    }

    fun number(): int {
        val text = this.token()
        var negative = false
        var value = 0
        var index = 0
        if (text.size > 0 && text[0] == 45) {
            negative = true
            index = 1
        }
        if (index >= text.size) this.ok = false
        while (index < text.size) {
            val digit = text[index] - 48
            if (digit < 0 || digit > 9) this.ok = false
            value = value * 10 + digit
            index = index + 1
        }
        if (negative) 0 - value else value
    }

    fun value(): BootstrapEvalValue {
        val kind = this.token()
        val integer = this.number()
        val boolean = this.token() == "1"
        val text = this.token()
        val owner = this.token()
        val fieldNames: array<string> = []
        var count = this.number()
        while (this.ok && count > 0) {
            fieldNames.append(this.token())
            count = count - 1
        }
        val elements: array<BootstrapEvalValue> = []
        count = this.number()
        while (this.ok && count > 0) {
            elements.append(this.value())
            count = count - 1
        }
        BootstrapEvalValue(kind, integer, boolean, text, elements, owner, fieldNames)
    }
}

/** A compilation ends (committed or not): the staged outputs and the kept globals go. */
fun bootstrapDiscardCompileOutputs(): void {
    bootstrapClearCompileOutputs()
    bootstrapForgetCompileGlobals()
    bootstrapSemanticUnit()
}

fun bootstrapCompileOutputPathValid(path: string): bool {
    var valid = path.size > 0 && path.size <= 4096 && path[0] != 47
    var begin = 0
    var index = 0
    while (valid && index <= path.size) {
        val boundary = index == path.size || path[index] == 47
        if (boundary) {
            val length = index - begin
            if (length == 0 ||
                (length == 1 && path[begin] == 46) ||
                (length == 2 && path[begin] == 46 &&
                 path[begin + 1] == 46)) valid = false
            begin = index + 1
        } else if (path[index] == 0) valid = false
        index = index + 1
    }
    valid
}

// How many distinct paths one compilation may stage, and how many bytes in all.
val BOOTSTRAP_COMPILE_OUTPUT_LIMIT = 4096
val BOOTSTRAP_COMPILE_OUTPUT_BYTES = 268435456

/** The slot already staging `path`, -1 none. */
fun bootstrapCompileOutputSlot(path: string): int {
    val root = bootstrapCompileOutputRoot()
    var found = -1
    var index = 0
    while (found < 0 && index < bootstrapCompileOutputCount) {
        if (Path("$root/$index.path").readText() == path) found = index
        index = index + 1
    }
    found
}

// A slot stages a file (its data is the contents), a directory (made when
// published) or a removal (the path is deleted when published and is absent
// until then): its `.kind` file says which, none for a file. Its `.revision`
// counts its changes, which is the path's revision under `#`.

/** The kind slot `slot` stages: "file", "directory" or "removed". */
fun bootstrapCompileOutputKind(slot: int): string {
    val kindFile = Path("${bootstrapCompileOutputRoot()}/$slot.kind")
    if (kindFile.exists()) kindFile.readText() else "file"
}

/** How many times slot `slot` changed (1 once staged). */
fun bootstrapCompileOutputRevision(slot: int): int {
    val revisionFile = Path("${bootstrapCompileOutputRoot()}/$slot.revision")
    val revision = if (revisionFile.exists()) bootstrapDecimalIndex(revisionFile.readText()) else 1
    if (revision > 0) revision else 1
}

/** The path slot `slot` stages. */
fun bootstrapCompileOutputPath(slot: int): string =
    Path("${bootstrapCompileOutputRoot()}/$slot.path").readText()

/** Slot `slot` now stages `kind` with `contents`, one revision later. */
fun bootstrapRestageCompileOutput(slot: int, kind: string, contents: string): bool {
    val root = bootstrapCompileOutputRoot()
    val dataFile = Path("$root/$slot.data")
    val previous = dataFile.readText().size
    val nextBytes = bootstrapCompileOutputBytes - previous + contents.size
    if (nextBytes > BOOTSTRAP_COMPILE_OUTPUT_BYTES) return false
    if (!dataFile.writeTextAtomic(contents)) return false
    bootstrapCompileOutputBytes = nextBytes
    val kindFile = Path("$root/$slot.kind")
    val kept = if (kind == "file") kindFile.remove() || !kindFile.exists()
        else kindFile.writeTextAtomic(kind)
    kept && Path("$root/$slot.revision").writeTextAtomic(
        "${bootstrapCompileOutputRevision(slot) + 1}"
    )
}

/** Stages `kind` ("directory" or "removed") at `path`: true when staged. */
fun bootstrapStageCompileEntry(path: string, kind: string): bool {
    if (!bootstrapCompileOutputPathValid(path)) return false
    val slot = bootstrapCompileOutputSlot(path)
    if (slot >= 0) return bootstrapRestageCompileOutput(slot, kind, "")
    if (bootstrapCompileOutputCount >= BOOTSTRAP_COMPILE_OUTPUT_LIMIT) return false
    val root = bootstrapCompileOutputRoot()
    val index = bootstrapCompileOutputCount
    var valid = Path(root).createDirectories() &&
        Path("$root/$index.path").writeTextAtomic(path) &&
        Path("$root/$index.data").writeTextAtomic("") &&
        Path("$root/$index.kind").writeTextAtomic(kind)
    if (!valid) {
        Path("$root/$index.path").remove()
        Path("$root/$index.data").remove()
        Path("$root/$index.kind").remove()
    } else bootstrapCompileOutputCount = index + 1
    valid
}

fun bootstrapStageCompileOutput(path: string, contents: string): bool {
    var valid = bootstrapCompileOutputPathValid(path) &&
        contents.size <= 16777216
    // A path written again in the same compilation: the last contents win, in its slot.
    val slot = if (valid) bootstrapCompileOutputSlot(path) else -1
    if (slot >= 0) return bootstrapRestageCompileOutput(slot, "file", contents)
    val nextBytes = bootstrapCompileOutputBytes + contents.size
    if (nextBytes > BOOTSTRAP_COMPILE_OUTPUT_BYTES) valid = false
    if (bootstrapCompileOutputCount >= BOOTSTRAP_COMPILE_OUTPUT_LIMIT) valid = false
    if (valid) {
        val root = bootstrapCompileOutputRoot()
        valid = Path(root).createDirectories()
        val pathFile = Path("$root/$bootstrapCompileOutputCount.path")
        val dataFile = Path("$root/$bootstrapCompileOutputCount.data")
        valid = pathFile.writeTextAtomic(path)
        if (valid) valid = dataFile.writeTextAtomic(contents)
        if (!valid) {
            pathFile.remove()
            dataFile.remove()
        }
    }
    if (valid) {
        bootstrapCompileOutputCount = bootstrapCompileOutputCount + 1
        bootstrapCompileOutputBytes = nextBytes
    }
    valid
}

// Toolchain-owned sidecars inherit the already validated/authorized artifact
// output path, which may be absolute for a root CLI build. Keep this separate
// from compilerWriteFile so staged user code remains project-relative.
fun bootstrapStageToolchainOutput(path: string, contents: string): bool {
    var valid = path.size > 0 && path.size <= 4096 &&
        contents.size <= 16777216
    var index = 0
    while (valid && index < path.size) {
        if (path[index] == 0) valid = false
        index = index + 1
    }
    val nextBytes = bootstrapCompileOutputBytes + contents.size
    if (nextBytes > BOOTSTRAP_COMPILE_OUTPUT_BYTES) valid = false
    if (bootstrapCompileOutputCount >= BOOTSTRAP_COMPILE_OUTPUT_LIMIT) valid = false
    if (valid) {
        val root = bootstrapCompileOutputRoot()
        val pathFile = Path("$root/$bootstrapCompileOutputCount.path")
        val dataFile = Path("$root/$bootstrapCompileOutputCount.data")
        valid = pathFile.writeTextAtomic(path)
        if (valid) valid = dataFile.writeTextAtomic(contents)
        if (!valid) {
            pathFile.remove()
            dataFile.remove()
        }
    }
    if (valid) {
        bootstrapCompileOutputCount = bootstrapCompileOutputCount + 1
        bootstrapCompileOutputBytes = nextBytes
    }
    valid
}

fun bootstrapCommitCompileOutputs(): bool {
    var committed = true
    var index = 0
    val root = bootstrapCompileOutputRoot()
    while (committed && index < bootstrapCompileOutputCount) {
        val pathFile = Path("$root/$index.path")
        val dataFile = Path("$root/$index.data")
        committed = pathFile.exists() && dataFile.exists()
        val kind = bootstrapCompileOutputKind(index)
        val target = Path(pathFile.readText())
        // Recording a path in the transaction moves what was there aside.
        if (committed && bootstrapBuildTransactionActive && kind != "directory") {
            committed = bootstrapRecordBuildTransactionPath(target.text)
        }
        if (committed && kind == "file") committed = target.writeTextAtomic(dataFile.readText())
        if (committed && kind == "directory") committed = target.createDirectories()
        // A staged removal is intentional, including a move's source. The
        // transaction otherwise restores a journaled path that stays absent.
        if (committed && kind == "removed" && bootstrapBuildTransactionActive) {
            bootstrapDropBuildTransactionPath(target.text)
        }
        if (committed && kind == "removed" && target.exists()) {
            target.remove()
            committed = !target.exists()
        }
        index = index + 1
    }
    bootstrapDiscardCompileOutputs()
    committed
}

// Scalar values (integers, floats, booleans, strings, void, null, invalid) share one
// empty element list and one empty field list, so each is a single allocation.
// Nothing changes them: only an aggregate's own lists are appended to or stored into.
val BOOTSTRAP_EVAL_NO_ELEMENTS: array<BootstrapEvalValue> = []
val BOOTSTRAP_EVAL_NO_FIELDS: array<string> = []

class BootstrapEvalValue(
    val kind: string,
    val integer: int,
    val boolean: bool,
    val text: string,
    val elements: array<BootstrapEvalValue>,
    val owner: string,
    val fieldNames: array<string>
)

class BootstrapEvalResult(
    val value: BootstrapEvalValue,
    val errors: int,
    val diagnostics: string,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    val generatedDeclarations: array<BootstrapDeclaration>,
    // The syntax closure values index (`value.integer`): lifting a closure
    // into the program lowers its lambda from here (ct_lift.ab).
    val syntax: array<BootstrapExpression> = [],
    // A native result's typing so far: its closures' captures are typed when
    // lifted, against the same values (bootstrapCtLiftDecode).
    val liftMemo: BootstrapLiftMemo? = null
)

// Values nothing tells apart by identity are shared: invalid (never lifted), the two
// booleans and the small integers (the lift codec tracks no scalar's identity).
val BOOTSTRAP_EVAL_INVALID: BootstrapEvalValue =
    BootstrapEvalValue("invalid", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
val BOOTSTRAP_EVAL_TRUE: BootstrapEvalValue =
    BootstrapEvalValue("boolean", 0, true, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
val BOOTSTRAP_EVAL_FALSE: BootstrapEvalValue =
    BootstrapEvalValue("boolean", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
val BOOTSTRAP_EVAL_SMALL_INTEGERS: array<BootstrapEvalValue> = bootstrapEvalSmallIntegers()

fun bootstrapEvalSmallIntegers(): array<BootstrapEvalValue> {
    val values: array<BootstrapEvalValue> = []
    var value = 0
    while (value < 1024) {
        values.append(BootstrapEvalValue(
            "integer", value, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS
        ))
        value = value + 1
    }
    values
}

fun bootstrapEvalInvalid(): BootstrapEvalValue = BOOTSTRAP_EVAL_INVALID

fun bootstrapEvalInteger(value: int): BootstrapEvalValue =
    if (value >= 0 && value < 1024) BOOTSTRAP_EVAL_SMALL_INTEGERS[value]
    else BootstrapEvalValue("integer", value, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)

/** An integer of scalar type `width` (eval_scalar.ab), wrapped to it, of the
 *  nominal scalar type `nominal` when that is not "". */
fun bootstrapEvalScalar(value: int, width: string, nominal: string): BootstrapEvalValue =
    BootstrapEvalValue("integer", bootstrapEvalWrap(value, width), false, nominal, BOOTSTRAP_EVAL_NO_ELEMENTS, width, BOOTSTRAP_EVAL_NO_FIELDS)

/** The first of `values` that leaves its expression (a `return`, `break` or
 *  `continue` reached while evaluating an argument or initializer), or -1. */
fun bootstrapEvalFirstEscape(values: array<BootstrapEvalValue>): int {
    var index = 0
    while (index < values.size) {
        val kind = values[index].kind
        if (kind == "return" || kind == "break" || kind == "continue") return index
        index = index + 1
    }
    -1
}

/** What a `type` declaration named `name` stands for, normalized; "" when
 *  `name` is no scalar type declaration. */
fun bootstrapEvalScalarUnderlying(var evaluator: BootstrapEvaluator, name: string): string {
    if (!bootstrapCouldNameScalarType(name)) return ""
    var node = evaluator.firstNamed(name)
    while (node >= 0) {
        val declaration = evaluator.declarations[evaluator.namedDeclaration(node)]
        if (declaration.kind == "type" && declaration.name == name) {
            return bootstrapNormalizeType(declaration.resultType)
        }
        node = evaluator.nextNamed(node)
    }
    ""
}

/** `value` as it reaches a place declared `type` (a parameter, a result, a
 *  field, a typed local): an integer takes the type's width and nominal name. */
fun bootstrapEvalCoerce(
    var evaluator: BootstrapEvaluator,
    value: BootstrapEvalValue,
    type: string
): BootstrapEvalValue {
    if (value.kind != "integer") return value
    val normalized = bootstrapNormalizeType(type)
    var width = bootstrapEvalIntegerWidth(normalized)
    var nominal = ""
    if (width == "-") {
        width = bootstrapEvalIntegerWidth(bootstrapEvalScalarUnderlying(evaluator, normalized))
        if (width == "-") return value
        nominal = normalized
    }
    if (width == value.owner && nominal == value.text) value
    else bootstrapEvalScalar(value.integer, width, nominal)
}

/** `T(x)` for a builtin integer type or a nominal scalar type T: `x` converted
 *  to T; invalid when `name` names neither. */
fun bootstrapEvalScalarConversion(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    name: string
): BootstrapEvalValue {
    if (expression.children.size != 1) return bootstrapEvalInvalid()
    var width = bootstrapEvalIntegerWidth(bootstrapNormalizeType(name))
    var nominal = ""
    if (width == "-") {
        val underlying = bootstrapEvalScalarUnderlying(evaluator, name)
        if (underlying == "") return bootstrapEvalInvalid()
        width = bootstrapEvalIntegerWidth(underlying)
        nominal = name
    }
    val value = evaluator.evaluate(expression.children[0])
    // A nominal f64, f32 or bool keeps the representation it wraps.
    if (width == "-" || value.kind != "integer") value
    else bootstrapEvalScalar(value.integer, width, nominal)
}

/** The receiver type an integer's method resolves on: its nominal type, then
 *  its builtin width, then i64, the first that declares `name`. */
fun bootstrapEvalIntegerReceiverType(
    var evaluator: BootstrapEvaluator,
    receiver: BootstrapEvalValue,
    name: string
): string {
    val candidates: array<string> = []
    if (receiver.text != "") candidates.append(receiver.text)
    if (receiver.owner != "") candidates.append(receiver.owner)
    for (candidate in candidates) {
        var node = evaluator.firstNamed(name)
        while (node >= 0) {
            val declaration = evaluator.declarations[evaluator.namedDeclaration(node)]
            if (declaration.extensionOwner != "" &&
                bootstrapNormalizeType(declaration.extensionOwner) == candidate) return candidate
            node = evaluator.nextNamed(node)
        }
    }
    "i64"
}

/** A value's type as far as the value says (an element's, a key's), else "". */
fun bootstrapEvalElementType(value: BootstrapEvalValue): string = when (value.kind) {
    "string" -> "string"
    "boolean" -> "bool"
    "f64" -> "f64"
    "f32" -> "f32"
    "object" -> value.owner
    "integer" -> if (value.text != "") value.text else if (value.owner != "") value.owner else "i64"
    else -> ""
}

/** The type of an array or map receiver for extension `name` (`array:i64`,
 *  `map:string:i64`): a value doesn't keep its element types, so the
 *  extension named so on an array (map) is taken, the one whose element
 *  (key and value) types fit the first element when several are. "" when
 *  there is none. */
fun bootstrapEvalContainerReceiverType(
    var evaluator: BootstrapEvaluator,
    receiver: BootstrapEvalValue,
    name: string
): string {
    val prefix = if (receiver.kind == "array") "array:" else "map:"
    var element = ""
    if (receiver.kind == "array" && receiver.elements.size > 0) {
        element = "$prefix${bootstrapEvalElementType(receiver.elements[0])}"
    } else if (receiver.kind == "map" && receiver.elements.size == 2 &&
               receiver.elements[0].elements.size > 0 && receiver.elements[1].elements.size > 0) {
        element = "$prefix${bootstrapEvalElementType(receiver.elements[0].elements[0])}:${bootstrapEvalElementType(receiver.elements[1].elements[0])}"
    }
    var first = ""
    var node = evaluator.firstNamed(name)
    while (node >= 0) {
        val declaration = evaluator.declarations[evaluator.namedDeclaration(node)]
        val owner = bootstrapNormalizeType(declaration.extensionOwner)
        if (declaration.extensionOwner != "" && owner.size > prefix.size &&
            owner.slice(0, prefix.size) == prefix) {
            if (owner == element) return owner
            if (first == "") first = owner
        }
        node = evaluator.nextNamed(node)
    }
    first
}

fun bootstrapEvalBoolean(value: bool): BootstrapEvalValue =
    if (value) BOOTSTRAP_EVAL_TRUE else BOOTSTRAP_EVAL_FALSE

fun bootstrapEvalString(value: string): BootstrapEvalValue =
    BootstrapEvalValue("string", 0, false, value, BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)

fun bootstrapEvalBase64Encode(value: string): string {
    val alphabet =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var output = ""
    var index = 0
    while (index < value.size) {
        val remaining = value.size - index
        val first = value[index]
        val second = if (remaining > 1) value[index + 1] else 0
        val third = if (remaining > 2) value[index + 2] else 0
        val combined = (first << 16) | (second << 8) | third
        output = "$output${alphabet.slice(
            (combined >>> 18) & 63,
            ((combined >>> 18) & 63) + 1
        )}${alphabet.slice(
            (combined >>> 12) & 63,
            ((combined >>> 12) & 63) + 1
        )}"
        if (remaining > 1) output = "$output${alphabet.slice(
            (combined >>> 6) & 63,
            ((combined >>> 6) & 63) + 1
        )}"
        else output = "${output}="
        if (remaining > 2) output = "$output${alphabet.slice(
            combined & 63,
            (combined & 63) + 1
        )}"
        else output = "${output}="
        index = index + 3
    }
    output
}

fun bootstrapEvalBase64DecodeDigit(value: int): int {
    if (value >= 65 && value <= 90) value - 65
    else if (value >= 97 && value <= 122) value - 71
    else if (value >= 48 && value <= 57) value + 4
    else if (value == 43) 62
    else if (value == 47) 63
    else -1
}

fun bootstrapEvalBase64Decode(value: string): string {
    var output = ""
    var valid = value.size > 0 && (value.size & 3) == 0
    var index = 0
    while (valid && index < value.size) {
        val byte2 = value[index + 2]
        val byte3 = value[index + 3]
        val padded2 = byte2 == 61
        val padded3 = byte3 == 61
        val a = bootstrapEvalBase64DecodeDigit(value[index])
        val b = bootstrapEvalBase64DecodeDigit(value[index + 1])
        val c = if (padded2) 0 else bootstrapEvalBase64DecodeDigit(byte2)
        val d = if (padded3) 0 else bootstrapEvalBase64DecodeDigit(byte3)
        valid = a >= 0 && b >= 0 && c >= 0 && d >= 0 &&
            (!padded2 || padded3) &&
            (!(padded2 || padded3) || index + 4 == value.size)
        if (valid) {
            val combined = (a << 18) | (b << 12) | (c << 6) | d
            output = "$output${byteEncode((combined >>> 16) & 255)}"
            if (!padded2) {
                output = "$output${byteEncode((combined >>> 8) & 255)}"
            }
            if (!padded3) output = "$output${byteEncode(combined & 255)}"
        }
        index = index + 4
    }
    if (valid) output else ""
}

fun bootstrapEvalByteChunksJoin(
    chunks: BootstrapEvalValue,
    byteCount: int
): BootstrapEvalValue {
    val values = bootstrapEvalUnwrapBorrow(chunks)
    var output = ""
    var valid = values.kind == "array" && byteCount >= 0
    var index = 0
    while (valid && index < values.elements.size) {
        val chunk = bootstrapEvalUnwrapBorrow(values.elements[index])
        valid = chunk.kind == "string" &&
            output.size + chunk.text.size <= byteCount
        if (valid) output = "$output${chunk.text}"
        index = index + 1
    }
    if (valid && output.size == byteCount) bootstrapEvalString(output)
    else bootstrapEvalInvalid()
}

fun bootstrapEvalNull(): BootstrapEvalValue =
    BootstrapEvalValue("null", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)

fun bootstrapEvalVoid(): BootstrapEvalValue =
    BootstrapEvalValue("void", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)

// The evaluation steps a build may take at compile time: enough for tables
// of tens of thousands of computed entries, while an endless loop still
// stops (in seconds).
val BOOTSTRAP_EVAL_STEP_LIMIT = 50000000

// A float at compile time keeps its IEEE bits in `integer` (an f32's in the
// low 32), so arithmetic on it is the target's own f64/f32 arithmetic.
fun bootstrapEvalF64(value: f64): BootstrapEvalValue =
    BootstrapEvalValue("f64", ablaBitF64ToI64(value), false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)

fun bootstrapEvalF32(value: f32): BootstrapEvalValue =
    BootstrapEvalValue("f32", ablaBitF32ToI32(value), false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)

fun bootstrapEvalAsF64(value: BootstrapEvalValue): f64 =
    ablaBitI64ToF64(value.integer)

fun bootstrapEvalAsF32(value: BootstrapEvalValue): f32 =
    ablaBitI32ToF32(value.integer)

fun bootstrapEvalFloat(value: BootstrapEvalValue): bool =
    value.kind == "f64" || value.kind == "f32"

fun bootstrapEvalEqual(
    left: BootstrapEvalValue,
    right: BootstrapEvalValue
): bool {
    var equal = left.kind == right.kind
    if (left.kind == "integer") {
        equal = equal && left.integer == right.integer
    }
    if (left.kind == "f64" && right.kind == "f64") {
        equal = bootstrapEvalAsF64(left) == bootstrapEvalAsF64(right)
    }
    if (left.kind == "f32" && right.kind == "f32") {
        equal = bootstrapEvalAsF32(left) == bootstrapEvalAsF32(right)
    }
    if (left.kind == "boolean") {
        equal = equal && left.boolean == right.boolean
    }
    if (left.kind == "string") equal = equal && left.text == right.text
    if (left.kind == "shared" || left.kind == "weak") {
        equal = equal && left.elements[0] == right.elements[0]
    }
    // Objects, arrays, maps and closures are references, as at run time: equal
    // only when they are the same one (one value, or one backing storage),
    // never by their contents.
    if (left.kind == "object" || left.kind == "array" || left.kind == "map" ||
        left.kind == "closure" || left.kind == "cell") {
        equal = equal && (left == right ||
            (left.elements.size > 0 && left.elements == right.elements))
    }
    equal
}

fun bootstrapEvalF64Arithmetic(operation: string, left: f64, right: f64): f64 =
    when (operation) {
        "+" -> left + right
        "-" -> left - right
        "*" -> left * right
        "/" -> left / right
        else -> left % right
    }

fun bootstrapEvalF32Arithmetic(operation: string, left: f32, right: f32): f32 =
    when (operation) {
        "+" -> left + right
        "-" -> left - right
        "*" -> left * right
        "/" -> left / right
        else -> left % right
    }

// An f32 widens to f64 exactly, so comparing the widened values is the same.
fun bootstrapEvalF64Compare(operation: string, left: f64, right: f64): bool =
    when (operation) {
        "<" -> left < right
        "<=" -> left <= right
        ">" -> left > right
        else -> left >= right
    }

// The float intrinsics of abla/float and abla/math at compile time, computed
// by the same operations the compiled program uses.
fun bootstrapEvalFloatCall(
    name: string,
    argument: BootstrapEvalValue
): BootstrapEvalValue {
    val integer = argument.kind == "integer"
    val double = argument.kind == "f64"
    val single = argument.kind == "f32"
    var result = BootstrapEvalValue("invalid", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
    if (name == "ablaBitF64ToI64" && double) {
        result = bootstrapEvalInteger(argument.integer)
    }
    if (name == "ablaBitI64ToF64" && integer) {
        result = BootstrapEvalValue(
            "f64", argument.integer, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS
        )
    }
    if (name == "ablaConvertI64ToF64" && integer) {
        result = bootstrapEvalF64(ablaConvertI64ToF64(argument.integer))
    }
    if (name == "ablaConvertF64ToI64" && double) {
        result = bootstrapEvalInteger(
            ablaConvertF64ToI64(bootstrapEvalAsF64(argument))
        )
    }
    if (name == "ablaBitF32ToI32" && single) {
        result = bootstrapEvalInteger(argument.integer)
    }
    if (name == "ablaBitI32ToF32" && integer) {
        result = bootstrapEvalF32(ablaBitI32ToF32(argument.integer))
    }
    if (name == "ablaConvertU32ToF32" && integer) {
        result = bootstrapEvalF32(ablaConvertU32ToF32(u32(argument.integer)))
    }
    if (name == "ablaConvertI32ToF32" && integer) {
        result = bootstrapEvalF32(ablaConvertI32ToF32(i32(argument.integer)))
    }
    if (name == "ablaConvertF32ToU32" && single) {
        result = bootstrapEvalScalar(
            bootstrapEvalSaturatingTruncate(
                f32ToF64(bootstrapEvalAsF32(argument)), 0, 4294967295
            ),
            "u32",
            ""
        )
    }
    if (name == "ablaConvertF32ToI32" && single) {
        result = bootstrapEvalScalar(
            bootstrapEvalSaturatingTruncate(
                f32ToF64(bootstrapEvalAsF32(argument)), -2147483648, 2147483647
            ),
            "i32",
            ""
        )
    }
    if (name == "ablaConvertF64ToF32" && double) {
        result = bootstrapEvalF32(
            ablaConvertF64ToF32(bootstrapEvalAsF64(argument))
        )
    }
    if (name == "ablaConvertF32ToF64" && single) {
        result = bootstrapEvalF64(
            ablaConvertF32ToF64(bootstrapEvalAsF32(argument))
        )
    }
    if (double) {
        val value = bootstrapEvalAsF64(argument)
        if (name == "ablaF64Sqrt") result = bootstrapEvalF64(ablaF64Sqrt(value))
        if (name == "ablaF64Floor") result = bootstrapEvalF64(ablaF64Floor(value))
        if (name == "ablaF64Ceil") result = bootstrapEvalF64(ablaF64Ceil(value))
        if (name == "ablaF64Trunc") result = bootstrapEvalF64(ablaF64Trunc(value))
        if (name == "ablaF64Abs") result = bootstrapEvalF64(ablaF64Abs(value))
        if (name == "ablaF64RoundEven") {
            result = bootstrapEvalF64(ablaF64RoundEven(value))
        }
    }
    result
}

fun bootstrapEvalReturn(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("return", 0, false, "", [value], "", [])

fun bootstrapEvalLoopControl(kind: string): BootstrapEvalValue =
    BootstrapEvalValue(kind, 0, false, "", [], "", [])

fun bootstrapEvalFunction(name: string): BootstrapEvalValue =
    BootstrapEvalValue("function", 0, false, name, [], "", [])

fun bootstrapEvalClosure(
    expression: int,
    family: string,
    captures: array<BootstrapEvalValue>,
    names: array<string>
): BootstrapEvalValue = BootstrapEvalValue(
    "closure",
    expression,
    family == "once",
    "",
    captures,
    family,
    names
)

fun bootstrapEvalArray(
    elements: array<BootstrapEvalValue>
): BootstrapEvalValue = BootstrapEvalValue(
    "array",
    0,
    false,
    "",
    elements,
    "",
    []
)

fun bootstrapEvalObject(
    owner: string,
    fieldNames: array<string>,
    fields: array<BootstrapEvalValue>
): BootstrapEvalValue = BootstrapEvalValue(
    "object",
    0,
    false,
    "",
    fields,
    owner,
    fieldNames
)

fun bootstrapEvalShared(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = BootstrapEvalValue(
        "shared.control",
        0,
        false,
        "",
        [value, bootstrapEvalInteger(1), bootstrapEvalInteger(1)],
        "",
        []
    )
    BootstrapEvalValue("shared", 0, false, "", [control], "", [])
}

fun bootstrapEvalSharedClone(
    value: BootstrapEvalValue
): BootstrapEvalValue {
    val control = value.elements[0]
    control.elements[1] = bootstrapEvalInteger(
        control.elements[1].integer + 1
    )
    BootstrapEvalValue("shared", 0, false, "", [control], "", [])
}

fun bootstrapEvalBorrow(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("borrow", 0, false, "", [value], "", [])

fun bootstrapEvalCell(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("cell", 0, false, "", [value], "", [])

/** The evaluator's own box around a binding that a closure captures or a
 *  generator keeps across suspensions (a "slot"): reading the name reads its
 *  content. A program's `Cell` is a "cell" and stays one when read. */
fun bootstrapEvalSlot(value: BootstrapEvalValue): BootstrapEvalValue =
    BootstrapEvalValue("slot", 0, false, "", [value], "", [])

fun bootstrapEvalDelegate(
    value: BootstrapEvalValue,
    mutable: bool
): BootstrapEvalValue = BootstrapEvalValue(
    "delegate", 0, mutable, "", [value], "", []
)

fun bootstrapEvalUnwrapBorrow(value: BootstrapEvalValue): BootstrapEvalValue {
    var result = value
    while (result.kind == "borrow" && result.elements.size == 1) {
        result = result.elements[0]
    }
    result
}

// Compiler-owned, pointer-free dependency metadata. Paths are materialized as
// opaque evaluator values only while a finalizer is inspecting one typed
// snapshot; generated/runtime programs never retain these records.
class BootstrapAccessPath(
    val rootKind: string,
    val rootIdentity: string,
    val rootParameter: int,
    val segmentKinds: array<string>,
    val segmentNames: array<string>,
    val segmentIndexes: array<int>
)

class BootstrapAccessSummary(
    val reads: array<BootstrapAccessPath>,
    val writes: array<BootstrapAccessPath>,
    val consumes: array<BootstrapAccessPath>,
    var readsUnknown: bool,
    var writesUnknown: bool
)

class BootstrapLiftValidity(val valid: Cell<bool>)

fun bootstrapAccessSummary(): BootstrapAccessSummary =
    BootstrapAccessSummary([], [], [], false, false)

fun bootstrapAccessClonePath(path: BootstrapAccessPath): BootstrapAccessPath {
    val kinds: array<string> = []
    val names: array<string> = []
    val indexes: array<int> = []
    var segment = 0
    while (segment < path.segmentKinds.size) {
        kinds.append(path.segmentKinds[segment])
        names.append(path.segmentNames[segment])
        indexes.append(path.segmentIndexes[segment])
        segment = segment + 1
    }
    BootstrapAccessPath(
        path.rootKind,
        path.rootIdentity,
        path.rootParameter,
        kinds,
        names,
        indexes
    )
}

fun bootstrapAccessPathKey(path: BootstrapAccessPath): string {
    var key = "${path.rootKind}:${path.rootIdentity}:${path.rootParameter}"
    var segment = 0
    while (segment < path.segmentKinds.size) {
        key = "$key/${path.segmentKinds[segment]}:${path.segmentNames[segment]}:${path.segmentIndexes[segment]}"
        segment = segment + 1
    }
    key
}

fun bootstrapAccessAppendUnique(
    var paths: array<BootstrapAccessPath>,
    path: BootstrapAccessPath
): void {
    val key = bootstrapAccessPathKey(path)
    var found = false
    var index = 0
    while (index < paths.size) {
        if (bootstrapAccessPathKey(paths[index]) == key) found = true
        index = index + 1
    }
    if (!found && paths.size < 64) paths.append(path)
}

fun bootstrapAccessPathAppend(
    path: BootstrapAccessPath,
    kind: string,
    name: string,
    index: int
): BootstrapAccessPath {
    val result = bootstrapAccessClonePath(path)
    if (result.segmentKinds.size < 8) {
        result.segmentKinds.append(kind)
        result.segmentNames.append(name)
        result.segmentIndexes.append(index)
    } else if (result.segmentKinds.size == 8 &&
        result.segmentKinds[7] != "wildcard") {
        result.segmentKinds[7] = "wildcard"
        result.segmentNames[7] = ""
        result.segmentIndexes[7] = -1
    }
    result
}

fun bootstrapAccessPathsIntersect(
    left: BootstrapAccessPath,
    right: BootstrapAccessPath
): bool {
    var intersects = left.rootKind == right.rootKind &&
        left.rootIdentity == right.rootIdentity &&
        (left.rootParameter == right.rootParameter ||
         left.rootParameter < 0 || right.rootParameter < 0)
    var segment = 0
    val shared = if (left.segmentKinds.size < right.segmentKinds.size) {
        left.segmentKinds.size
    } else right.segmentKinds.size
    while (intersects && segment < shared) {
        val leftKind = left.segmentKinds[segment]
        val rightKind = right.segmentKinds[segment]
        if (leftKind == "wildcard" || rightKind == "wildcard") {
            segment = shared
        } else if ((leftKind == "index.dynamic" &&
                    (rightKind == "index.dynamic" ||
                     rightKind == "index.constant")) ||
                   (rightKind == "index.dynamic" &&
                    leftKind == "index.constant")) {
            intersects = intersects
        } else if (leftKind != rightKind) intersects = false
        else if (leftKind == "field" &&
            left.segmentNames[segment] != right.segmentNames[segment]) {
            intersects = false
        } else if (leftKind == "index.constant" &&
            left.segmentIndexes[segment] != right.segmentIndexes[segment]) {
            intersects = false
        }
        segment = segment + 1
    }
    intersects
}

fun bootstrapEvalValueNeedsBorrow(value: BootstrapEvalValue): bool =
    value.kind == "object" || value.kind == "array" ||
    value.kind == "string" || value.kind == "shared" ||
    value.kind == "weak" || value.kind == "closure" || value.kind == "cell"

fun bootstrapEvalSharedGet(value: BootstrapEvalValue): BootstrapEvalValue =
    bootstrapEvalBorrow(value.elements[0].elements[0])

fun bootstrapEvalWeak(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = value.elements[0]
    control.elements[2] = bootstrapEvalInteger(
        control.elements[2].integer + 1
    )
    BootstrapEvalValue("weak", 0, false, "", [control], "", [])
}

fun bootstrapEvalWeakClone(value: BootstrapEvalValue): BootstrapEvalValue =
    bootstrapEvalWeak(value)

fun bootstrapEvalWeakUpgrade(value: BootstrapEvalValue): BootstrapEvalValue {
    val control = value.elements[0]
    var result = bootstrapEvalNull()
    if (control.elements[1].integer > 0) {
        control.elements[1] = bootstrapEvalInteger(
            control.elements[1].integer + 1
        )
        result = BootstrapEvalValue(
            "shared", 0, false, "", [control], "", []
        )
    }
    result
}

// What every evaluation over one declarations array shares: its affine type names and
// its name index. A caller that evaluates many times reuses a context while the array
// keeps its size (bootstrapEvalContextFor); a subparser stage that grows it gets a new
// one. ABLA_EVAL_INDEX_CHECK=1 checks each lookup against a scan of every declaration.
class BootstrapEvalContext(
    val size: int,
    val affineTypes: array<string>,
    val index: BootstrapDeclarationNameIndex,
    val check: bool,
    val stepLimit: int,
    // Each class's field names, by declaration index: built at its first
    // construction and shared by its instances (constructionKnown says which).
    val constructionFields: array<array<string>> = [],
    val constructionKnown: array<bool> = [],
    // Whether the program declares extension fields, once looked (one entry): an
    // instance then gets its own copy of the names, since gaining an
    // extension field appends to them (bootstrapEvaluatePlace).
    val extensionFields: array<bool> = []
)

// ABLA_EVAL_STEP_LIMIT lowers the step limit (never raises it), so a test can
// pin how many steps a program takes without running fifty million of them.
fun bootstrapEvalStepLimit(): int {
    val configured = linuxEnvironment("ABLA_EVAL_STEP_LIMIT")
    var limit = BOOTSTRAP_EVAL_STEP_LIMIT
    if (configured.found && configured.value.size <= 9) {
        val parsed = bootstrapDecimalIndex(configured.value)
        if (parsed > 0 && parsed < limit) limit = parsed
    }
    limit
}

fun bootstrapEvalContext(
    declarations: array<BootstrapDeclaration>
): BootstrapEvalContext {
    val configured = linuxEnvironment("ABLA_EVAL_INDEX_CHECK")
    BootstrapEvalContext(
        declarations.size,
        bootstrapBuildAffineTypeNames(declarations),
        bootstrapDeclarationNameIndex(declarations),
        configured.found && configured.value == "1",
        bootstrapEvalStepLimit()
    )
}

/** Under ABLA_EVAL_INDEX_CHECK, a lookup that a scan of every declaration contradicts. */
fun bootstrapEvalIndexCheckFailed(message: string): void {
    linuxPrintStandardError("error[E_INTERNAL]: eval.index-check: $message\n")
}

/** No context yet: its size never matches an array's. */
fun bootstrapEvalNoContext(): BootstrapEvalContext =
    BootstrapEvalContext(-1, [], BootstrapDeclarationNameIndex([], [], [], [], [], []), false, BOOTSTRAP_EVAL_STEP_LIMIT)

/** `context` while it was built for `declarations`' size, else a new one. */
fun bootstrapEvalContextFor(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>
): BootstrapEvalContext =
    if (context.size == declarations.size) context
    else bootstrapEvalContext(declarations)

// The context successive evaluations over one declaration list share
// (bootstrapEvaluateWithEffects: every compile expression a lowering meets, say):
// building one indexes every declaration, about a million instructions in a program
// that imports the standard library, so it is built once per list (the same count
// and the same first and last declaration) instead of once per expression. Inside a
// `region` (the REPL compiles each line in one) nothing is kept: the region frees
// what it allocated, and a global must never point there.
var bootstrapSharedEvalContext: BootstrapEvalContext = bootstrapEvalNoContext()
var bootstrapSharedEvalKey: string = ""

fun bootstrapSharedEvalContextFor(
    declarations: array<BootstrapDeclaration>
): BootstrapEvalContext {
    if (runtimeMemoryRegionActive()) return bootstrapEvalContext(declarations)
    val last = declarations.size - 1
    val key = if (last < 0) "0" else
        "${declarations.size}:${declarations[0].name}:${declarations[0].begin}:${declarations[last].name}:${declarations[last].begin}"
    if (key != bootstrapSharedEvalKey || bootstrapSharedEvalContext.size != declarations.size) {
        bootstrapSharedEvalContext = bootstrapEvalContext(declarations)
        bootstrapSharedEvalKey = key
    }
    bootstrapSharedEvalContext
}

class BootstrapEvaluator(
    val declarations: array<BootstrapDeclaration>,
    val affineTypes: array<string>,
    val context: BootstrapEvalContext,
    val names: array<string>,
    val values: array<BootstrapEvalValue>,
    val mutable: array<bool>,
    val cursors: array<BootstrapSubparserCursor>,
    val syntax: array<BootstrapExpression>,
    val typedCalls: array<BootstrapTypedCall>,
    val reflectedTypes: array<string>,
    val generatedDeclarations: array<BootstrapDeclaration>,
    val extensionRequests: array<BootstrapExtensionRequest>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>,
    // The compile-time globals this evaluation has read (`compile val` / `compile var`), by
    // key, shared with the evaluations it calls; kept for the compilation at its end.
    val globalKeys: array<string>,
    val globalValues: array<BootstrapEvalValue>,
    val allowedCompileEffects: int,
    var errors: int,
    var steps: int,
    var diagnostics: string,
    // The source of the code being evaluated, which an evaluation failure
    // names (bootstrapEvaluateFrom sets it for a declaration's body).
    var sourceIdentity: string = ""
) {
    /** Whether `name` is a field of the method receiver `this`. */
    fun receiverHasField(name: string): bool {
        val index = this.find("this")
        if (index < 0) return false
        var receiver = this.values[index]
        if (receiver.kind == "slot") receiver = receiver.elements[0]
        if (receiver.kind != "object") return false
        for (field in receiver.fieldNames) {
            if (field == name) return true
        }
        false
    }

    fun recordEvaluatorDiagnostic(code: string, message: string): void {
        this.diagnostics =
            "${this.diagnostics}error[$code]: $message\n"
        bootstrapSemanticUnit()
    }

    fun functionHandleLimit(): int {
        var limit = this.declarations.size
        var declaration = 0
        while (declaration < this.declarations.size) {
            limit = limit + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        limit
    }

    fun recordInvalidFunctionHandle(operation: string, handle: int): void {
        val limit = this.functionHandleLimit()
        var classification = "wrong declaration kind"
        var code = "E_EXT_FUNCTION_HANDLE_WRONG_KIND"
        if (handle < 0) classification = "unknown"
        if (handle < 0) code = "E_EXT_FUNCTION_HANDLE_UNKNOWN"
        if (handle >= limit) {
            classification = "out of range"
            code = "E_EXT_FUNCTION_HANDLE_OUT_OF_RANGE"
        }
        val domain =
            "compilation-scoped function declaration handle in [0, $limit)"
        val message =
            "compiler API `$operation` received invalid function handle $handle ($classification; expected a $domain)"
        this.recordEvaluatorDiagnostic(code, message)
    }

    fun accessContainingHandle(expression: BootstrapExpression): int {
        var result = -1
        var bestSpan = 2147483647
        var bestPriority = 2
        var sourceIdentity = ""
        var request = 0
        while (request < this.extensionRequests.size) {
            val candidate = this.extensionRequests[request]
            if (candidate.expression.begin == expression.begin &&
                candidate.expression.end == expression.end &&
                candidate.expression.kind == expression.kind) {
                sourceIdentity = candidate.sourceIdentity
            }
            request = request + 1
        }
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            val moduleIdentity =
                bootstrapCanonicalDeclarationModuleIdentity(candidate.name)
            var priority = 2
            if (sourceIdentity != "" &&
                candidate.sourceIdentity == sourceIdentity) priority = 0
            else if (sourceIdentity != "" &&
                candidate.sourceIdentity == "" &&
                moduleIdentity == sourceIdentity) priority = 0
            else if (candidate.sourceIdentity == "" &&
                moduleIdentity == "") priority = 1
            if ((candidate.kind == "fun" ||
                 candidate.kind == "compile.fun") &&
                candidate.generatedNamespace == "" &&
                priority < 2 &&
                candidate.expression.begin <= expression.begin &&
                candidate.expression.end >= expression.end) {
                val span = candidate.expression.end - candidate.expression.begin
                if (priority < bestPriority ||
                    (priority == bestPriority && span < bestSpan)) {
                    result = declaration
                    bestSpan = span
                    bestPriority = priority
                }
            }
            var method = 0
            while (priority < 2 && method < candidate.methods.size) {
                val found = candidate.methods[method]
                if (found.expression.begin <= expression.begin &&
                    found.expression.end >= expression.end) {
                    val span = found.expression.end - found.expression.begin
                    if (priority < bestPriority ||
                        (priority == bestPriority && span < bestSpan)) {
                        result = this.methodHandle(declaration, method)
                        bestSpan = span
                        bestPriority = priority
                    }
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
        result
    }

    fun accessAliasIndex(names: array<string>, name: string): int {
        var result = -1
        var index = 0
        while (index < names.size) {
            if (names[index] == name) result = index
            index = index + 1
        }
        result
    }

    fun accessDelegatedTypeInExpression(
        expression: BootstrapExpression,
        name: string,
        before: int
    ): string {
        var result = "unknown"
        if ((expression.kind == "local.val" ||
             expression.kind == "local.var") && expression.text == name &&
            expression.begin < before && expression.children.size > 0 &&
            expression.children[0].kind == "delegate.initializer" &&
            expression.children[0].children.size > 0) {
            result = this.staticSyntaxType(
                expression.children[0].children[0]
            )
        }
        var child = 0
        while (child < expression.children.size) {
            val found = this.accessDelegatedTypeInExpression(
                expression.children[child], name, before
            )
            if (found != "unknown") result = found
            child = child + 1
        }
        result
    }

    fun accessDelegatedType(
        name: string,
        context: int,
        before: int
    ): string {
        var result = "unknown"
        var declarationNode = this.firstNamed(name)
        while (declarationNode >= 0) {
            val declaration = this.namedDeclaration(declarationNode)
            val candidate = this.declarations[declaration]
            if (bootstrapDeclarationIsValue(candidate.kind) &&
                candidate.name == name &&
                candidate.expression.kind == "delegate.initializer" &&
                candidate.expression.children.size > 0) {
                result = this.staticSyntaxType(
                    candidate.expression.children[0]
                )
            }
            declarationNode = this.nextNamed(declarationNode)
        }
        if (context >= 0 && this.functionHandleValid(context)) {
            val local = this.accessDelegatedTypeInExpression(
                this.functionHandleDeclaration(context).expression,
                name,
                before
            )
            if (local != "unknown") result = local
        }
        result
    }

    fun accessMethodHandle(ownerName: string, name: string): int {
        var result = -1
        var declaration = 0
        while (declaration < this.declarations.size) {
            val owner = this.declarations[declaration]
            if (owner.kind == "class" && owner.name == ownerName) {
                var method = 0
                while (method < owner.methods.size) {
                    if (owner.methods[method].name == name) {
                        result = this.methodHandle(declaration, method)
                    }
                    method = method + 1
                }
            }
            if (result < 0 && owner.extensionOwner != "" &&
                owner.name == name &&
                bootstrapNormalizeType(owner.extensionOwner) == ownerName) result = declaration
            declaration = declaration + 1
        }
        result
    }

    fun accessRootPath(
        name: string,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): BootstrapAccessPath {
        val alias = this.accessAliasIndex(aliasNames, name)
        if (alias >= 0 && alias < aliasPaths.size) {
            bootstrapAccessClonePath(aliasPaths[alias])
        } else {
            var rootKind = "unknown"
            var identity = name
            var parameter = -1
            if (context >= 0 && this.functionHandleValid(context)) {
                val declaration = this.functionHandleDeclaration(context)
                var index = 0
                while (index < declaration.parameters.size) {
                    if (declaration.parameters[index] == name) {
                        rootKind = "parameter"
                        identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                            declaration.name
                        )}:${declaration.name}#$index"
                        parameter = index
                    }
                    index = index + 1
                }
                if (name == "this" && this.functionHandleOwner(context) >= 0) {
                    rootKind = "receiver"
                    val ownerName = this.declarations[
                        this.functionHandleOwner(context)
                    ].name
                    identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                        ownerName
                    )}:$ownerName"
                    parameter = -1
                }
            }
            var declarationIndexNode = this.firstNamed(name)
            while (rootKind == "unknown" &&
                declarationIndexNode >= 0) {
                val declarationIndex = this.namedDeclaration(declarationIndexNode)
                val declaration = this.declarations[declarationIndex]
                if (bootstrapDeclarationIsValue(declaration.kind) &&
                    declaration.name == name) {
                    rootKind = "global"
                    identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                        declaration.name
                    )}:${declaration.name}"
                }
                declarationIndexNode = this.nextNamed(declarationIndexNode)
            }
            if (rootKind == "unknown" && context >= 0 &&
                this.functionHandleOwner(context) >= 0) {
                val ownerIndex = this.functionHandleOwner(context)
                val owner = this.declarations[ownerIndex]
                var field = 0
                while (field < owner.parameters.size) {
                    if (owner.parameters[field] == name &&
                        field < owner.parameterKinds.size &&
                        (owner.parameterKinds[field] == "val" ||
                         owner.parameterKinds[field] == "var")) {
                        rootKind = "receiver"
                        identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                            owner.name
                        )}:${owner.name}"
                        parameter = -1
                    }
                    field = field + 1
                }
                if (rootKind == "receiver") {
                    val receiver = BootstrapAccessPath(
                        rootKind, identity, parameter, [], [], []
                    )
                    return bootstrapAccessPathAppend(
                        receiver, "field", name, -1
                    )
                }
            }
            if (rootKind == "unknown" && context >= 0) {
                rootKind = "local"
                val declaration = this.functionHandleDeclaration(context)
                identity = "${bootstrapCanonicalDeclarationModuleIdentity(
                    declaration.name
                )}:${declaration.name}:$name"
            }
            BootstrapAccessPath(
                rootKind,
                identity,
                parameter,
                [],
                [],
                []
            )
        }
    }

    fun accessPathForPlace(
        expression: BootstrapExpression,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): BootstrapAccessPath {
        var result = BootstrapAccessPath("unknown", "", -1, [], [], [])
        if (expression.kind == "identifier") {
            result = this.accessRootPath(
                expression.text,
                context,
                aliasNames,
                aliasPaths
            )
        }
        if (expression.kind == "member" && expression.children.size > 0) {
            result = bootstrapAccessPathAppend(
                this.accessPathForPlace(
                    expression.children[0],
                    context,
                    aliasNames,
                    aliasPaths
                ),
                "field",
                expression.text,
                -1
            )
        }
        if (expression.kind == "index" && expression.children.size > 1) {
            var kind = "index.dynamic"
            var index = -1
            if (expression.children[1].kind == "integer") {
                kind = "index.constant"
                index = bootstrapDecimalIndex(expression.children[1].text)
            }
            result = bootstrapAccessPathAppend(
                this.accessPathForPlace(
                    expression.children[0],
                    context,
                    aliasNames,
                    aliasPaths
                ),
                kind,
                "",
                index
            )
        }
        if (expression.kind == "delegate.project" &&
            expression.children.size == 1) {
            result = bootstrapAccessPathAppend(
                this.accessPathForPlace(
                    expression.children[0],
                    context,
                    aliasNames,
                    aliasPaths
                ),
                "delegate",
                "",
                -1
            )
        }
        result
    }

    fun accessTypeIsScalar(type: string): bool {
        val normalized = bootstrapNormalizeType(type)
        normalized == "bool" || normalized == "char" ||
        normalized == "i8" || normalized == "i16" ||
        normalized == "i32" || normalized == "i64" ||
        normalized == "u8" || normalized == "u16" ||
        normalized == "u32" || normalized == "u64" ||
        normalized == "f32" || normalized == "f64" ||
        normalized == "cstring" || bootstrapIsNullableType(normalized)
    }

    fun accessNameIsClass(name: string): bool {
        var found = false
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].kind == "class" &&
                this.declarations[declaration].name == name) found = true
            declaration = declaration + 1
        }
        found
    }

    fun accessSubstitutedPath(
        path: BootstrapAccessPath,
        call: BootstrapExpression,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): BootstrapAccessPath {
        var base = bootstrapAccessClonePath(path)
        var argument = -1
        if (path.rootKind == "receiver" && call.kind == "member.call" &&
            call.children.size > 0) argument = 0
        if (path.rootKind == "parameter") {
            argument = path.rootParameter
            if (call.kind == "member.call") argument = argument + 1
        }
        if (argument >= 0 && argument < call.children.size) {
            val supplied = this.accessPathForPlace(
                call.children[argument],
                context,
                aliasNames,
                aliasPaths
            )
            if (supplied.rootKind != "unknown") {
                base = supplied
                var segment = 0
                while (segment < path.segmentKinds.size) {
                    base = bootstrapAccessPathAppend(
                        base,
                        path.segmentKinds[segment],
                        path.segmentNames[segment],
                        path.segmentIndexes[segment]
                    )
                    segment = segment + 1
                }
            } else base = BootstrapAccessPath(
                "value", "", -1, [], [], []
            )
        }
        base
    }

    fun accessMergeCallSummary(
        var summary: BootstrapAccessSummary,
        call: BootstrapExpression,
        callee: BootstrapAccessSummary,
        context: int,
        aliasNames: array<string>,
        aliasPaths: array<BootstrapAccessPath>
    ): void {
        var index = 0
        while (index < callee.reads.size) {
            val path = this.accessSubstitutedPath(
                callee.reads[index], call, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.readsUnknown = true
            else if (callee.reads[index].rootKind != "local") {
                if (path.rootKind != "value") {
                    bootstrapAccessAppendUnique(summary.reads, path)
                }
            }
            index = index + 1
        }
        index = 0
        while (index < callee.writes.size) {
            val path = this.accessSubstitutedPath(
                callee.writes[index], call, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else if (callee.writes[index].rootKind != "local") {
                if (path.rootKind != "value") {
                    bootstrapAccessAppendUnique(summary.writes, path)
                }
            }
            index = index + 1
        }
        index = 0
        while (index < callee.consumes.size) {
            val path = this.accessSubstitutedPath(
                callee.consumes[index], call, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else if (callee.consumes[index].rootKind != "local") {
                if (path.rootKind != "value") {
                    bootstrapAccessAppendUnique(summary.consumes, path)
                }
            }
            index = index + 1
        }
        if (callee.readsUnknown) summary.readsUnknown = true
        if (callee.writesUnknown) summary.writesUnknown = true
    }

    fun accessSummaryForFunctionAt(
        handle: int,
        depth: int,
        visited: array<int>
    ): BootstrapAccessSummary {
        val summary = bootstrapAccessSummary()
        if (!this.functionHandleValid(handle)) {
            summary.readsUnknown = true
            summary.writesUnknown = true
        } else if (depth >= 8 || this.intArrayContains(visited, handle)) {
            summary.readsUnknown = true
            summary.writesUnknown = true
        } else {
            val declaration = this.functionHandleDeclaration(handle)
            if (declaration.kind == "extern") {
                summary.readsUnknown = true
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter < declaration.parameterKinds.size &&
                        declaration.parameterKinds[parameter] == "var") {
                        val wildcard = bootstrapAccessPathAppend(
                            this.accessRootPath(
                                declaration.parameters[parameter],
                                handle,
                                [],
                                []
                            ),
                            "wildcard",
                            "",
                            -1
                        )
                        bootstrapAccessAppendUnique(summary.writes, wildcard)
                    }
                    parameter = parameter + 1
                }
            } else if (declaration.expression.kind == "missing") {
                summary.readsUnknown = true
                summary.writesUnknown = true
            } else {
                val nestedVisited: array<int> = []
                var seen = 0
                while (seen < visited.size) {
                    nestedVisited.append(visited[seen])
                    seen = seen + 1
                }
                nestedVisited.append(handle)
                this.accessAnalyzeExpression(
                    declaration.expression,
                    summary,
                    handle,
                    [],
                    [],
                    depth,
                    nestedVisited,
                    true
                )
            }
        }
        summary
    }

    fun accessAnalyzeExpression(
        expression: BootstrapExpression,
        var summary: BootstrapAccessSummary,
        context: int,
        var aliasNames: array<string>,
        var aliasPaths: array<BootstrapAccessPath>,
        depth: int,
        visited: array<int>,
        valueRead: bool
    ): void {
        if (summary.reads.size >= 64 || summary.writes.size >= 64) {
            summary.readsUnknown = true
            summary.writesUnknown = true
            return
        }
        if (expression.kind == "identifier" && valueRead) {
            val path = this.accessPathForPlace(
                expression, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.readsUnknown = true
            else bootstrapAccessAppendUnique(summary.reads, path)
            val delegateType = this.accessDelegatedType(
                expression.text,
                context,
                expression.begin
            )
            val getter = this.accessMethodHandle(delegateType, "getValue")
            if (getter >= 0) {
                val projected = BootstrapExpression(
                    "delegate.project", "", expression.begin,
                    expression.end, [expression]
                )
                val call = BootstrapExpression(
                    "member.call", "getValue", expression.begin,
                    expression.end, [projected]
                )
                this.accessMergeCallSummary(
                    summary,
                    call,
                    this.accessSummaryForFunctionAt(
                        getter, depth + 1, visited
                    ),
                    context,
                    aliasNames,
                    aliasPaths
                )
            }
        } else if ((expression.kind == "member" ||
                    expression.kind == "index" ||
                    expression.kind == "delegate.project") && valueRead) {
            val path = this.accessPathForPlace(
                expression, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.readsUnknown = true
            else bootstrapAccessAppendUnique(summary.reads, path)
            if (expression.kind == "index" &&
                expression.children.size > 1 &&
                expression.children[1].kind != "integer") {
                this.accessAnalyzeExpression(
                    expression.children[1], summary, context,
                    aliasNames, aliasPaths, depth, visited, true
                )
            }
        } else if (expression.kind == "assign") {
            val path = this.accessRootPath(
                expression.text, context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else bootstrapAccessAppendUnique(summary.writes, path)
            if (expression.children.size > 0) this.accessAnalyzeExpression(
                expression.children[0], summary, context,
                aliasNames, aliasPaths, depth, visited, true
            )
            val delegateType = this.accessDelegatedType(
                expression.text,
                context,
                expression.begin
            )
            val setter = this.accessMethodHandle(delegateType, "setValue")
            if (setter >= 0 && expression.children.size > 0) {
                val receiver = BootstrapExpression(
                    "delegate.project", "", expression.begin,
                    expression.end, [BootstrapExpression(
                        "identifier", expression.text, expression.begin,
                        expression.end, []
                    )]
                )
                val call = BootstrapExpression(
                    "member.call", "setValue", expression.begin,
                    expression.end, [receiver, expression.children[0]]
                )
                this.accessMergeCallSummary(
                    summary,
                    call,
                    this.accessSummaryForFunctionAt(
                        setter, depth + 1, visited
                    ),
                    context,
                    aliasNames,
                    aliasPaths
                )
            }
        } else if ((expression.kind == "member.assign" ||
                    expression.kind == "index.assign" ||
                    expression.kind == "delegate.assign") &&
            expression.children.size > 0) {
            val target = if (expression.kind == "delegate.assign") {
                BootstrapExpression(
                    "delegate.project", "", expression.begin,
                    expression.end, [expression.children[0]]
                )
            } else if (expression.kind == "index.assign" &&
                expression.children.size > 1) {
                BootstrapExpression(
                    "index", "", expression.begin, expression.end,
                    [expression.children[0], expression.children[1]]
                )
            } else expression.children[0]
            var path = this.accessPathForPlace(
                target, context, aliasNames, aliasPaths
            )
            if (expression.kind == "member.assign") {
                path = bootstrapAccessPathAppend(
                    path, "field", expression.text, -1
                )
            }
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else bootstrapAccessAppendUnique(summary.writes, path)
            val valueIndex = expression.children.size - 1
            this.accessAnalyzeExpression(
                expression.children[valueIndex], summary, context,
                aliasNames, aliasPaths, depth, visited, true
            )
        } else if ((expression.kind == "local.val" ||
                    expression.kind == "local.var") &&
            expression.children.size > 0) {
            val initializer = expression.children[0]
            val aliasPath = this.accessPathForPlace(
                initializer, context, aliasNames, aliasPaths
            )
            if (aliasPath.rootKind == "unknown" ||
                this.accessTypeIsScalar(this.staticSyntaxType(initializer))) {
                this.accessAnalyzeExpression(
                    initializer, summary, context,
                    aliasNames, aliasPaths, depth, visited, true
                )
            }
            if (aliasPath.rootKind != "unknown") {
                aliasNames.append(expression.text)
                aliasPaths.append(aliasPath)
            }
        } else if (expression.kind == "call" &&
            expression.text == "move" && expression.children.size == 1) {
            val path = this.accessPathForPlace(
                expression.children[0], context, aliasNames, aliasPaths
            )
            if (path.rootKind == "unknown") summary.writesUnknown = true
            else bootstrapAccessAppendUnique(summary.consumes, path)
        } else if ((expression.kind == "call" ||
                    expression.kind == "member.call")) {
            val cellReceiver = expression.kind == "member.call" &&
                expression.children.size > 0 && bootstrapIsCellType(
                    this.staticSyntaxType(expression.children[0])
                )
            if (cellReceiver && expression.text == "get") {
                val cell = bootstrapAccessPathAppend(
                    this.accessPathForPlace(
                        expression.children[0], context,
                        aliasNames, aliasPaths
                    ),
                    "cell",
                    "",
                    -1
                )
                if (cell.rootKind == "unknown") summary.readsUnknown = true
                else bootstrapAccessAppendUnique(summary.reads, cell)
            } else if (cellReceiver && expression.text == "set") {
                val cell = bootstrapAccessPathAppend(
                    this.accessPathForPlace(
                        expression.children[0], context,
                        aliasNames, aliasPaths
                    ),
                    "cell",
                    "",
                    -1
                )
                if (cell.rootKind == "unknown") summary.writesUnknown = true
                else bootstrapAccessAppendUnique(summary.writes, cell)
                if (expression.children.size > 1) {
                    this.accessAnalyzeExpression(
                        expression.children[1], summary, context,
                        aliasNames, aliasPaths, depth, visited, true
                    )
                }
            } else {
                val target = this.directCallTarget(expression, 0)
                var offset = 0
                if (expression.kind == "member.call") offset = 1
                var argument = offset
                while (argument < expression.children.size) {
                    var readArgument = target < 0
                    val parameter = argument - offset
                    if (target >= 0 && this.accessTypeIsScalar(
                        this.functionHandleParameterType(target, parameter)
                    )) readArgument = true
                    if (readArgument) this.accessAnalyzeExpression(
                        expression.children[argument], summary, context,
                        aliasNames, aliasPaths, depth, visited, true
                    )
                    argument = argument + 1
                }
                if (target >= 0) {
                    val callee = this.accessSummaryForFunctionAt(
                        target, depth + 1, visited
                    )
                    this.accessMergeCallSummary(
                        summary, expression, callee, context,
                        aliasNames, aliasPaths
                    )
                } else if (!this.accessNameIsClass(expression.text)) {
                    summary.readsUnknown = true
                    summary.writesUnknown = true
                }
            }
        } else {
            var child = 0
            while (child < expression.children.size) {
                this.accessAnalyzeExpression(
                    expression.children[child], summary, context,
                    aliasNames, aliasPaths, depth, visited, true
                )
                child = child + 1
            }
        }
    }

    fun accessSummaryForExpression(
        expression: BootstrapExpression
    ): BootstrapAccessSummary {
        val summary = bootstrapAccessSummary()
        val aliases: array<string> = []
        val aliasPaths: array<BootstrapAccessPath> = []
        val visited: array<int> = []
        this.accessAnalyzeExpression(
            expression,
            summary,
            this.accessContainingHandle(expression),
            aliases,
            aliasPaths,
            0,
            visited,
            true
        )
        summary
    }

    fun accessExpressionEffectMask(expression: BootstrapExpression): int {
        val effects = bootstrapBuildCompileEffectSummary(this.declarations)
        val delegatedNames: array<string> = []
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (bootstrapDeclarationIsValue(candidate.kind) &&
                candidate.expression.kind == "delegate.initializer") {
                delegatedNames.append(candidate.name)
            }
            declaration = declaration + 1
        }
        bootstrapCollectDelegatedNames(expression, delegatedNames)
        bootstrapExpressionDelegatedCompileEffects(
            expression,
            effects,
            delegatedNames
        )
    }

    fun accessFunctionEffectMask(handle: int): int {
        var mask = 0
        if (this.functionHandleValid(handle)) {
            val declaration = this.functionHandleDeclaration(handle)
            val effects = bootstrapBuildCompileEffectSummary(this.declarations)
            mask = bootstrapCompileEffectLookup(
                effects,
                declaration.name,
                this.functionHandleOwner(handle) >= 0
            )
        }
        mask
    }

    fun accessPathValue(path: BootstrapAccessPath): BootstrapEvalValue {
        val segments: array<BootstrapEvalValue> = []
        var segment = 0
        while (segment < path.segmentKinds.size) {
            segments.append(BootstrapEvalValue(
                "typed.access.segment",
                path.segmentIndexes[segment],
                false,
                path.segmentNames[segment],
                [],
                path.segmentKinds[segment],
                []
            ))
            segment = segment + 1
        }
        BootstrapEvalValue(
            "typed.access.path",
            path.rootParameter,
            false,
            path.rootIdentity,
            segments,
            path.rootKind,
            []
        )
    }

    fun accessValuePath(value: BootstrapEvalValue): BootstrapAccessPath {
        val kinds: array<string> = []
        val names: array<string> = []
        val indexes: array<int> = []
        if (value.kind == "typed.access.path") {
            var segment = 0
            while (segment < value.elements.size) {
                val found = value.elements[segment]
                kinds.append(found.owner)
                names.append(found.text)
                indexes.append(found.integer)
                segment = segment + 1
            }
        }
        BootstrapAccessPath(
            if (value.kind == "typed.access.path") value.owner else "unknown",
            if (value.kind == "typed.access.path") value.text else "",
            if (value.kind == "typed.access.path") value.integer else -1,
            kinds,
            names,
            indexes
        )
    }

    fun recordCompileInput(path: string, contents: string): void {
        var found = -1
        var index = 0
        while (index < this.compileInputPaths.size) {
            if (this.compileInputPaths[index] == path) found = index
            index = index + 1
        }
        if (found >= 0) {
            this.compileInputContents[found] = contents
        } else {
            this.compileInputPaths.append(path)
            this.compileInputContents.append(contents)
        }
    }

    fun uninitializedValue(): BootstrapEvalValue = BootstrapEvalValue(
        "uninitialized",
        0,
        false,
        "",
        BOOTSTRAP_EVAL_NO_ELEMENTS,
        "",
        BOOTSTRAP_EVAL_NO_FIELDS
    )

    fun directResourceHasDrop(value: BootstrapEvalValue): bool {
        var found = false
        if (value.kind == "object") {
            // The declarations named like the value's class (the name index; without one
            // for these declarations, every declaration).
            val indexed = this.context.size == this.declarations.size
            var node = if (indexed) this.firstNamed(value.owner) else -1
            var scanned = 0
            while (if (indexed) node >= 0 else scanned < this.declarations.size) {
                val declarationIndex = if (indexed) this.namedDeclaration(node) else scanned
                if (indexed) node = this.nextNamed(node) else scanned = scanned + 1
                val declaration = this.declarations[declarationIndex]
                if (declaration.kind == "class" && declaration.isResource &&
                    declaration.name == value.owner) {
                    var methodIndex = 0
                    while (methodIndex < declaration.methods.size) {
                        if (declaration.methods[methodIndex].name == "drop") {
                            found = true
                        }
                        methodIndex = methodIndex + 1
                    }
                }
            }
        }
        found
    }

    fun valueIsAffine(value: BootstrapEvalValue): bool {
        var affine = value.kind == "object" &&
            bootstrapAffineNamesContain(this.affineTypes, value.owner)
        if (value.kind == "shared") affine = true
        if (value.kind == "weak") affine = true
        if (value.kind == "closure" &&
            (value.owner == "mut" || value.owner == "once")) affine = true
        if (value.kind == "generator" || value.kind == "task" ||
            value.kind == "thread") affine = true
        if (value.kind == "array") {
            var element = 0
            while (element < value.elements.size && !affine) {
                affine = this.valueIsAffine(value.elements[element])
                element = element + 1
            }
        }
        if (value.kind == "delegate" && value.elements.size == 1) {
            affine = this.valueIsAffine(value.elements[0])
        }
        // A map is as affine as its values.
        if (value.kind == "map" && value.elements.size > 1) {
            affine = this.valueIsAffine(value.elements[1])
        }
        affine
    }

    fun dropValue(var value: BootstrapEvalValue): void {
        if (bootstrapEvalIsGenerator(value)) bootstrapEvalGeneratorDrop(this, value)
        if (value.kind == "delegate" && value.elements.size == 1 &&
            value.elements[0].kind != "uninitialized") {
            this.dropValue(value.elements[0])
            value.elements[0] = this.uninitializedValue()
        }
        if (value.kind == "shared" && value.elements.size == 1) {
            val control = value.elements[0]
            val next = control.elements[1].integer - 1
            control.elements[1] = bootstrapEvalInteger(next)
            if (next == 0 &&
                control.elements[0].kind != "uninitialized") {
                this.dropValue(control.elements[0])
                control.elements[0] = this.uninitializedValue()
                control.elements[2] = bootstrapEvalInteger(
                    control.elements[2].integer - 1
                )
            }
        }
        if (value.kind == "weak" && value.elements.size == 1) {
            val control = value.elements[0]
            control.elements[2] = bootstrapEvalInteger(
                control.elements[2].integer - 1
            )
        }
        if (value.kind == "closure" &&
            (value.owner == "mut" || value.owner == "once")) {
            var capture = value.elements.size
            while (capture > 0) {
                capture = capture - 1
                if (value.elements[capture].kind != "uninitialized") {
                    this.dropValue(value.elements[capture])
                    value.elements[capture] = this.uninitializedValue()
                }
            }
        }
        if ((value.kind == "generator" || value.kind == "task" ||
             value.kind == "thread") && value.elements.size == 1 &&
            value.elements[0].kind != "uninitialized") {
            this.dropValue(value.elements[0])
            value.elements[0] = this.uninitializedValue()
        }
        if (value.kind == "map" && value.elements.size > 1) {
            this.dropValue(value.elements[1])
        }
        // First to last, as the generated drop function does at run time.
        if (value.kind == "array" && this.valueIsAffine(value)) {
            var element = 0
            while (element < value.elements.size) {
                if (value.elements[element].kind != "uninitialized") {
                    this.dropValue(value.elements[element])
                    value.elements[element] = this.uninitializedValue()
                }
                element = element + 1
            }
        }
        if (value.kind == "object" &&
            bootstrapAffineNamesContain(this.affineTypes, value.owner)) {
            if (this.directResourceHasDrop(value)) {
                this.evaluateMethod(value, BootstrapExpression(
                    "member.call",
                    "drop",
                    0,
                    0,
                    []
                ))
            }
            var field = value.elements.size
            while (field > 0) {
                field = field - 1
                if (value.elements[field].kind != "uninitialized") {
                    this.dropValue(value.elements[field])
                    value.elements[field] = this.uninitializedValue()
                }
            }
        }
    }

    fun dropOwnedParameters(
        parameterKinds: array<string>,
        returned: BootstrapEvalValue,
        offset: int
    ): void {
        var parameter = parameterKinds.size
        while (parameter > 0) {
            parameter = parameter - 1
            val valueIndex = parameter + offset
            if (parameterKinds[parameter] == "own" &&
                valueIndex < this.values.size &&
                this.values[valueIndex].kind != "uninitialized" &&
                this.values[valueIndex] != returned) {
                val owned = this.values[valueIndex]
                this.dropValue(owned)
                this.values[valueIndex] = this.uninitializedValue()
            }
        }
    }

    /** A `compile val` / `compile var`'s value: one for the whole compilation. The first
     *  reference evaluates its initializer (or takes what an earlier evaluation kept);
     *  changes through it last for every later evaluation. */
    fun compileGlobal(declaration: BootstrapDeclaration): BootstrapEvalValue {
        val key = bootstrapCompileGlobalKey(declaration)
        var index = 0
        while (index < this.globalKeys.size) {
            if (this.globalKeys[index] == key) return this.globalValues[index]
            index = index + 1
        }
        var value = bootstrapCompileGlobalLoad(key, this.declarations, this.syntax)
        if (value.kind == "invalid") value = this.evaluate(declaration.expression)
        this.globalKeys.append(key)
        this.globalValues.append(value)
        value
    }

    /** The `compile var` declaration named `name`, -1 none. */
    fun compileVar(name: string): int {
        var result = -1
        var index = 0
        while (index < this.declarations.size) {
            if (this.declarations[index].kind == "compile.var" &&
                this.declarations[index].name == name) result = index
            index = index + 1
        }
        result
    }

    // The last binding of `name`: scanned from the end, the first match.
    fun find(name: string): int {
        var result = -1
        var index = this.names.size - 1
        while (result < 0 && index >= 0) {
            if (this.names[index] == name) result = index
            index = index - 1
        }
        if (this.context.check) {
            var scanned = -1
            index = 0
            while (index < this.names.size) {
                if (this.names[index] == name) scanned = index
                index = index + 1
            }
            if (scanned != result) {
                bootstrapEvalIndexCheckFailed("find `$name`: $result, a scan finds $scanned")
            }
        }
        result
    }

    // The first node of the declarations named `name` (BootstrapDeclarationNameIndex); walk on
    // with nextNamed and read each with namedDeclaration.
    fun firstNamed(name: string): int {
        val first = this.context.index.first(name)
        if (this.context.check) {
            var node = first
            var declaration = 0
            var same = this.context.size == this.declarations.size
            while (same && declaration < this.declarations.size) {
                if (this.declarations[declaration].name == name) {
                    same = node >= 0 &&
                        this.context.index.nodeDeclarations[node] == declaration
                    if (same) node = this.context.index.nodeNexts[node]
                }
                declaration = declaration + 1
            }
            if (!same || node >= 0) {
                bootstrapEvalIndexCheckFailed("the declarations named `$name` differ from a scan")
            }
        }
        first
    }

    fun nextNamed(node: int): int = this.context.index.nodeNexts[node]

    fun namedDeclaration(node: int): int = this.context.index.nodeDeclarations[node]


    fun invokeDelegateMethod(
        delegate: BootstrapEvalValue,
        name: string,
        argument: BootstrapEvalValue,
        hasArgument: bool,
        begin: int,
        end: int
    ): BootstrapEvalValue {
        // A TVar delegate is read and written directly.
        var unwrapped = bootstrapEvalUnwrapBorrow(delegate)
        if (unwrapped.kind == "tvar" && unwrapped.elements.size == 1) {
            if (name == "getValue") return unwrapped.elements[0]
            bootstrapEvalStmWrite(unwrapped, argument)
            return bootstrapEvalVoid()
        }
        val children: array<BootstrapExpression> = []
        if (hasArgument) {
            val temporary = "__delegate_argument_${this.steps}_${this.names.size}"
            this.names.append(temporary)
            this.values.append(argument)
            this.mutable.append(false)
            children.append(BootstrapExpression(
                "invalid", "delegate-receiver", begin, begin, []
            ))
            children.append(BootstrapExpression(
                "identifier", temporary, begin, end, []
            ))
            val result = this.evaluateMethod(
                bootstrapEvalUnwrapBorrow(delegate),
                BootstrapExpression(
                    "member.call", name, begin, end, children
                )
            )
            this.values[this.values.size - 1] = this.uninitializedValue()
            this.names[this.names.size - 1] = ""
            result
        } else this.evaluateMethod(
            bootstrapEvalUnwrapBorrow(delegate),
            BootstrapExpression("member.call", name, begin, end, children)
        )
    }

    fun delegatedSlot(name: string): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        val found = this.find(name)
        if (found >= 0) {
            result = this.values[found]
            if (result.kind == "slot" && result.elements.size == 1) {
                result = result.elements[0]
            }
        }
        // A top-level delegate is one slot for the whole compilation, as other
        // globals are (bootstrapRuntimeGlobal): every function reading or
        // assigning it reaches the same delegate.
        if (result.kind == "invalid") {
            var declarationNode = this.firstNamed(name)
            while (result.kind == "invalid" && declarationNode >= 0) {
                val declaration = this.namedDeclaration(declarationNode)
                val candidate = this.declarations[declaration]
                if (bootstrapDeclarationIsValue(candidate.kind) &&
                    candidate.name == name &&
                    candidate.expression.kind == "delegate.initializer") {
                    val key = if (candidate.kind == "compile.val" ||
                        candidate.kind == "compile.var")
                        bootstrapCompileGlobalKey(candidate)
                        else "runtime:${bootstrapCompileGlobalKey(candidate)}"
                    var index = 0
                    while (result.kind == "invalid" && index < this.globalKeys.size) {
                        if (this.globalKeys[index] == key) result = this.globalValues[index]
                        index = index + 1
                    }
                    if (result.kind == "invalid") {
                        result = bootstrapCompileGlobalLoad(
                            key, this.declarations, this.syntax
                        )
                        if (result.kind == "invalid") {
                            result = this.evaluate(candidate.expression)
                        }
                        this.globalKeys.append(key)
                        this.globalValues.append(result)
                    }
                }
                declarationNode = this.nextNamed(declarationNode)
            }
        }
        result
    }

    fun printable(shown: BootstrapEvalValue): string {
        // A view (a field read through Shared.get(), say) prints as its value.
        val value = bootstrapEvalUnwrapBorrow(shown)
        var result = value.text
        if (value.kind == "integer") {
            result = if (value.owner == "char") byteEncode(value.integer)
                else bootstrapEvalIntegerText(value.integer, value.owner)
        }
        if (value.kind == "f64") result = f64Text(bootstrapEvalAsF64(value))
        if (value.kind == "f32") {
            result = f64Text(f32ToF64(bootstrapEvalAsF32(value)))
        }
        if (value.kind == "boolean") {
            result = if (value.boolean) "true" else "false"
        }
        if (value.kind == "null") result = "null"
        result
    }

    fun syntaxValue(expression: BootstrapExpression): BootstrapEvalValue {
        val handle = this.syntax.size
        this.syntax.append(expression)
        BootstrapEvalValue("syntax", handle, false, "", [], "", [])
    }

    // The syntax a value's handle names. After an earlier error (a value that
    // is no syntax handle, e.g. from the depth guard) it counts an error and
    // gives an invalid expression instead of reading past the table.
    fun syntaxAt(handle: int): BootstrapExpression {
        if (handle >= 0 && handle < this.syntax.size) return this.syntax[handle]
        this.errors = this.errors + 1
        BootstrapExpression("invalid", "", 0, 0, [])
    }

    fun reflectedTypeHandle(type: string): int {
        val normalized = bootstrapNormalizeType(type)
        var found = -1
        var index = 0
        while (index < this.reflectedTypes.size) {
            if (this.reflectedTypes[index] == normalized) found = index
            index = index + 1
        }
        if (found < 0 && normalized != "" && normalized != "unknown" &&
            this.reflectedTypes.size < 4096) {
            this.reflectedTypes.append(normalized)
            found = this.reflectedTypes.size - 1
        }
        found
    }

    fun reflectedTypeValid(handle: int): bool =
        handle >= 0 && handle < this.reflectedTypes.size

    fun reflectedTypeKind(type: string): string {
        var kind = "nominal"
        if (type == "void" || type == "never" || type == "null" ||
            type == "bool" || type == "char" || type == "string" ||
            type == "i8" || type == "i16" || type == "i32" ||
            type == "i64" || type == "u8" || type == "u16" ||
            type == "u32" || type == "u64" || type == "f32" ||
            type == "f64") kind = "primitive"
        if (bootstrapIsNullableType(type)) kind = "nullable"
        if (bootstrapIsArrayType(type)) kind = "array"
        if (bootstrapIsSharedType(type)) kind = "shared"
        if (bootstrapIsWeakType(type)) kind = "weak"
        if (bootstrapIsMutexType(type)) kind = "mutex"
        if (bootstrapIsBorrowType(type)) kind = "borrow"
        if (bootstrapIsFunctionType(type)) kind = "function"
        if (bootstrapIsOnceFunctionType(type)) kind = "function.once"
        if (bootstrapIsMutableFunctionType(type)) kind = "function.mutable"
        if (type.size > 0 && type[type.size - 1] == 42) kind = "pointer"
        kind
    }

    fun reflectedTypeElement(type: string): string {
        var element = "unknown"
        if (bootstrapIsNullableType(type)) {
            element = bootstrapNullableElementType(type)
        }
        if (bootstrapIsArrayType(type)) element = bootstrapArrayElementType(type)
        if (bootstrapIsSharedType(type)) element = bootstrapSharedElementType(type)
        if (bootstrapIsWeakType(type)) element = bootstrapWeakElementType(type)
        if (bootstrapIsMutexType(type)) element = bootstrapMutexElementType(type)
        if (bootstrapIsBorrowType(type)) element = bootstrapBorrowElementType(type)
        if (type.size > 0 && type[type.size - 1] == 42) {
            element = type.slice(0, type.size - 1)
        }
        element
    }

    fun generatedIdentifierPart(text: string): string {
        var result = ""
        var index = 0
        while (index < text.size) {
            val byte = text[index]
            if ((byte >= 65 && byte <= 90) ||
                (byte >= 97 && byte <= 122) ||
                (byte >= 48 && byte <= 57) || byte == 95) {
                result = "$result${text.slice(index, index + 1)}"
            } else result = "${result}_"
            index = index + 1
        }
        if (result == "") result = "generated"
        result
    }

    fun generatedStringLiteral(text: string): string {
        var result = "\""
        var index = 0
        while (index < text.size) {
            val byte = text[index]
            if (byte == 34) result = "${result}\\\""
            else if (byte == 92) result = "${result}\\\\"
            else if (byte == 10) result = "${result}\\n"
            else if (byte == 13) result = "${result}\\r"
            else if (byte == 9) result = "${result}\\t"
            else result = "$result${text.slice(index, index + 1)}"
            index = index + 1
        }
        "$result\""
    }

    fun generatedSyntaxSource(
        expression: BootstrapExpression,
        depth: int
    ): string {
        var result = ""
        if (depth <= 128) {
        if (expression.kind == "integer") result = expression.text
        if (expression.kind == "string") {
            result = this.generatedStringLiteral(expression.text)
        }
        if (expression.kind == "identifier") result = expression.text
        if (expression.kind == "true" || expression.kind == "false" ||
            expression.kind == "null") result = expression.kind
        if (expression.kind == "if" && expression.children.size == 3) {
            result = "if (${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}) ${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )} else ${this.generatedSyntaxSource(
                expression.children[2], depth + 1
            )}"
        }
        if (expression.kind == "array") {
            result = "["
            var element = 0
            while (element < expression.children.size) {
                if (element > 0) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[element], depth + 1
                )}"
                element = element + 1
            }
            result = "$result]"
        }
        if (expression.kind == "call") {
            var name = expression.text
            if (expression.begin < 0) {
                val handle = 0 - expression.begin - 1
                if (this.functionHandleValid(handle)) {
                    val owner = this.functionHandleOwner(handle)
                    if (owner < 0) name = this.declarations[handle].name
                }
            }
            result = "$name("
            var argument = 0
            while (argument < expression.children.size) {
                if (argument > 0) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[argument], depth + 1
                )}"
                argument = argument + 1
            }
            result = "$result)"
        }
        if (expression.kind == "member.call" &&
            expression.children.size > 0) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}.${expression.text}("
            var argument = 1
            while (argument < expression.children.size) {
                if (argument > 1) result = "$result, "
                result = "$result${this.generatedSyntaxSource(
                    expression.children[argument], depth + 1
                )}"
                argument = argument + 1
            }
            result = "$result)"
        }
        if (expression.kind == "member" && expression.children.size == 1) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}.${expression.text}"
        }
        if (expression.kind == "index" && expression.children.size == 2) {
            result = "${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}[${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )}]"
        }
        if (expression.children.size == 2 && expression.text != "" &&
            result == "") {
            result = "(${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )} ${expression.text} ${this.generatedSyntaxSource(
                expression.children[1], depth + 1
            )})"
        }
        if (expression.kind == "return") {
            result = "return"
            if (expression.children.size > 0) {
                result = "$result ${this.generatedSyntaxSource(
                    expression.children[0], depth + 1
                )}"
            }
        }
        if (expression.kind == "defer" && expression.children.size == 1) {
            result = "defer ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if ((expression.kind == "generator" || expression.kind == "task" ||
             expression.kind == "thread") && expression.children.size == 1) {
            result = "${expression.kind} ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if ((expression.kind == "await" || expression.kind == "yield") &&
            expression.children.size == 1) {
            result = "${expression.kind} ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if (expression.kind == "assign" &&
            expression.children.size == 1) {
            result = "${expression.text} = ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if ((expression.kind == "local.val" ||
             expression.kind == "local.var") &&
            expression.children.size > 0) {
            val keyword = if (expression.kind == "local.val") "val" else "var"
            result = "$keyword ${expression.text}"
            if (expression.children.size > 1 &&
                expression.children[1].text != "inferred") {
                result = "$result: ${expression.children[1].text}"
            }
            result = "$result = ${this.generatedSyntaxSource(
                expression.children[0], depth + 1
            )}"
        }
        if (expression.kind == "block") {
            result = "{\n"
            var statement = 0
            while (statement < expression.children.size) {
                result = "$result${this.generatedSyntaxSource(
                    expression.children[statement], depth + 1
                )}\n"
                statement = statement + 1
            }
            result = "$result}"
        }
        if ((expression.kind == "lambda" ||
             expression.kind == "lambda.move") &&
            expression.children.size > 0) {
            result = ""
            if (expression.kind == "lambda.move") result = "move "
            result = "$result{"
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                if (parameter > 0) result = "$result, "
                val found = expression.children[parameter]
                result = "$result${found.text}: ${found.children[0].text}"
                parameter = parameter + 1
            }
            result = "$result -> ${this.generatedSyntaxSource(
                expression.children[expression.children.size - 1],
                depth + 1
            )}}"
        }
        }
        result
    }

    fun liftedCaptureIndex(names: array<string>, name: string): int {
        var result = -1
        var index = 0
        while (index < names.size) {
            if (names[index] == name) result = index
            index = index + 1
        }
        result
    }

    fun liftedNameIsDeclaration(name: string): bool {
        var found = false
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].name == name) found = true
            declaration = declaration + 1
        }
        found
    }

    fun rewriteLiftedExpression(
        expression: BootstrapExpression,
        captureNames: array<string>,
        parameterNames: array<string>,
        var bound: array<string>,
        validity: BootstrapLiftValidity
    ): BootstrapExpression {
        var text = expression.text
        val children: array<BootstrapExpression> = []
        if (expression.kind == "block") {
            var statement = 0
            while (statement < expression.children.size) {
                val child = expression.children[statement]
                children.append(this.rewriteLiftedExpression(
                    child,
                    captureNames,
                    parameterNames,
                    bound,
                    validity
                ))
                if (child.kind == "local.val" || child.kind == "local.var") {
                    bound.append(child.text)
                }
                statement = statement + 1
            }
        } else if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            val nested: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nested.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                nested.append(expression.children[parameter].text)
                children.append(expression.children[parameter])
                parameter = parameter + 1
            }
            children.append(this.rewriteLiftedExpression(
                expression.children[expression.children.size - 1],
                captureNames,
                parameterNames,
                nested,
                validity
            ))
        } else {
            var child = 0
            while (child < expression.children.size) {
                children.append(this.rewriteLiftedExpression(
                    expression.children[child],
                    captureNames,
                    parameterNames,
                    bound,
                    validity
                ))
                child = child + 1
            }
        }
        if (expression.kind == "identifier" ||
            expression.kind == "assign" || expression.kind == "call") {
            val capture = this.liftedCaptureIndex(captureNames, text)
            if (capture >= 0 && capture < parameterNames.size &&
                !this.nameIsBound(bound, text)) {
                text = parameterNames[capture]
            } else if (expression.kind == "identifier" &&
                !this.nameIsBound(bound, text) &&
                !this.liftedNameIsDeclaration(text)) {
                validity.valid.set(false)
            }
            if (expression.kind == "assign" &&
                !this.nameIsBound(bound, text) &&
                !this.liftedNameIsDeclaration(text) && capture < 0) {
                validity.valid.set(false)
            }
        }
        BootstrapExpression(
            expression.kind,
            text,
            expression.begin,
            expression.end,
            children
        )
    }

    fun generatedDeclarationName(
        module: BootstrapEvalValue,
        hint: string
    ): string {
        val namespace = this.generatedIdentifierPart(module.text)
        val readable = this.generatedIdentifierPart(hint)
        val base = "__abla_generated_${namespace}_${module.integer}_${module.elements.size}_${readable}"
        var result = base
        var suffix = 0
        var collision = true
        while (collision && suffix < 1024) {
            collision = false
            var declaration = 0
            while (declaration < this.declarations.size) {
                if (this.declarations[declaration].name == result) {
                    collision = true
                }
                declaration = declaration + 1
            }
            var generated = 0
            while (generated < module.fieldNames.size) {
                if (module.fieldNames[generated] == result) collision = true
                generated = generated + 1
            }
            if (collision) {
                suffix = suffix + 1
                result = "${base}_$suffix"
            }
        }
        if (collision) "" else result
    }

    fun generatedExportName(
        module: BootstrapEvalValue,
        name: string
    ): string {
        var available = name != "" &&
            this.generatedIdentifierPart(name) == name
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].name == name) available = false
            declaration = declaration + 1
        }
        var generated = 0
        while (generated < module.fieldNames.size) {
            if (module.fieldNames[generated] == name) available = false
            generated = generated + 1
        }
        if (available) name else ""
    }

    fun methodHandle(owner: int, method: int): int {
        var handle = this.declarations.size
        var declaration = 0
        while (declaration < owner) {
            handle = handle + this.declarations[declaration].methods.size
            declaration = declaration + 1
        }
        handle + method
    }

    fun functionHandleOwner(handle: int): int {
        var owner = -1
        if (handle >= this.declarations.size) {
            var cursor = this.declarations.size
            var declaration = 0
            while (owner < 0 && declaration < this.declarations.size) {
                val next = cursor +
                    this.declarations[declaration].methods.size
                if (handle >= cursor && handle < next) owner = declaration
                cursor = next
                declaration = declaration + 1
            }
        }
        owner
    }

    fun functionHandleMethod(handle: int): int {
        val owner = this.functionHandleOwner(handle)
        var method = -1
        if (owner >= 0) method = handle - this.methodHandle(owner, 0)
        method
    }

    fun functionHandleValid(handle: int): bool {
        var valid = handle >= 0 && handle < this.declarations.size &&
            (this.declarations[handle].kind == "fun" ||
             this.declarations[handle].kind == "compile.fun" ||
             this.declarations[handle].kind == "extern")
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size) valid = true
        valid
    }

    fun functionHandleResultType(handle: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size) {
            result = bootstrapReflectedResultType(this.declarations[handle])
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size) {
            result = bootstrapReflectedResultType(
                this.declarations[owner].methods[method]
            )
        }
        result
    }

    fun generatedDeclarationCount(module: BootstrapEvalValue): int {
        var count = 0
        var element = 0
        if (module.kind == "generated.module") {
            while (element < module.elements.size) {
                if (module.elements[element].kind ==
                    "generated.declaration") count = count + 1
                element = element + 1
            }
        }
        count
    }

    fun generatedDeclarationAt(
        module: BootstrapEvalValue,
        ordinal: int
    ): int {
        var result = -1
        var current = 0
        var element = 0
        if (module.kind == "generated.module" && ordinal >= 0) {
            while (element < module.elements.size) {
                val candidate = module.elements[element]
                if (candidate.kind == "generated.declaration") {
                    if (current == ordinal) result = candidate.integer
                    current = current + 1
                }
                element = element + 1
            }
        }
        if (result < 0 || result >= this.generatedDeclarations.size) {
            result = -1
        }
        result
    }

    fun functionHandleParameterType(handle: int, parameter: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size && parameter >= 0 &&
            parameter < this.declarations[handle].parameterTypes.size) {
            result = bootstrapNormalizeType(
                this.declarations[handle].parameterTypes[parameter]
            )
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size && parameter >= 0 &&
            parameter <
                this.declarations[owner].methods[method].parameterTypes.size) {
            result = bootstrapNormalizeType(
                this.declarations[owner].methods[method].parameterTypes[parameter]
            )
        }
        result
    }

    fun functionHandleParameterKind(handle: int, parameter: int): string {
        var result = "parameter"
        if (handle >= 0 && handle < this.declarations.size && parameter >= 0 &&
            parameter < this.declarations[handle].parameterKinds.size) {
            result = this.declarations[handle].parameterKinds[parameter]
        }
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0 &&
            method < this.declarations[owner].methods.size && parameter >= 0 &&
            parameter <
                this.declarations[owner].methods[method].parameterKinds.size) {
            val declaration = this.declarations[owner].methods[method]
            result = declaration.parameterKinds[parameter]
        }
        result
    }

    fun functionHandleDeclaration(handle: int): BootstrapDeclaration {
        val owner = this.functionHandleOwner(handle)
        val method = this.functionHandleMethod(handle)
        if (owner >= 0 && method >= 0) {
            this.declarations[owner].methods[method]
        } else this.declarations[handle]
    }

    fun bindingHandleValid(handle: int): bool =
        handle >= 0 && handle < this.declarations.size &&
        bootstrapDeclarationIsValue(this.declarations[handle].kind)

    fun bindingIsDelegated(handle: int): bool =
        this.bindingHandleValid(handle) &&
        this.declarations[handle].expression.kind == "delegate.initializer" &&
        this.declarations[handle].expression.children.size == 2

    fun bindingDelegateType(handle: int): string {
        var result = "unknown"
        if (this.bindingIsDelegated(handle)) {
            result = this.staticSyntaxType(
                this.declarations[handle].expression.children[0]
            )
        }
        result
    }

    fun bindingMethodHandle(handle: int, name: string): int {
        var result = -1
        val ownerName = this.bindingDelegateType(handle)
        var declaration = 0
        while (declaration < this.declarations.size) {
            val owner = this.declarations[declaration]
            if (owner.kind == "class" && owner.name == ownerName) {
                var method = 0
                while (method < owner.methods.size) {
                    if (owner.methods[method].name == name) {
                        result = this.methodHandle(declaration, method)
                    }
                    method = method + 1
                }
            }
            if (result < 0 && owner.extensionOwner != "" &&
                owner.name == name &&
                bootstrapNormalizeType(owner.extensionOwner) == ownerName) result = declaration
            declaration = declaration + 1
        }
        result
    }

    fun bindingExposedType(handle: int): string {
        var result = "unknown"
        if (this.bindingHandleValid(handle)) {
            val declaration = this.declarations[handle]
            if (declaration.resultType != "inferred") {
                result = bootstrapNormalizeType(declaration.resultType)
            } else if (this.bindingIsDelegated(handle)) {
                val getter = this.bindingMethodHandle(handle, "getValue")
                if (getter >= 0) result = this.functionHandleResultType(getter)
            } else result = this.staticSyntaxType(declaration.expression)
        }
        result
    }

    fun classFieldType(handle: int, wanted: int): string {
        var result = "unknown"
        if (handle >= 0 && handle < this.declarations.size &&
            this.declarations[handle].kind == "class" && wanted >= 0) {
            val declaration = this.declarations[handle]
            var field = 0
            var parameter = 0
            while (parameter < declaration.parameterKinds.size) {
                if (declaration.parameterKinds[parameter] == "val" ||
                    declaration.parameterKinds[parameter] == "var") {
                    if (field == wanted &&
                        parameter < declaration.parameterTypes.size) {
                        // A delegated property is the type it reads as.
                        result = if (bootstrapIsAnyDelegatedProperty(declaration, parameter))
                            bootstrapDelegatedPropertyType(declaration, parameter)
                        else bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                    }
                    field = field + 1
                }
                parameter = parameter + 1
            }
        }
        result
    }

    fun lexicalTypeInExpression(
        container: BootstrapExpression,
        name: string,
        position: int,
        depth: int
    ): string {
        var result = "unknown"
        if (depth < 32 && container.kind == "block") {
            var child = 0
            while (child < container.children.size) {
                val statement = container.children[child]
                if ((statement.kind == "local.val" ||
                     statement.kind == "local.var") &&
                    statement.text == name && statement.begin < position) {
                    if (statement.children.size > 1 &&
                        statement.children[1].text != "inferred") {
                        result = bootstrapNormalizeType(
                            statement.children[1].text
                        )
                    } else if (statement.children.size > 0) {
                        result = this.staticSyntaxTypeAt(
                            statement.children[0], depth + 1
                        )
                    }
                }
                if (statement.begin <= position &&
                    statement.end >= position) {
                    val nested = this.lexicalTypeInExpression(
                        statement, name, position, depth + 1
                    )
                    if (nested != "unknown") result = nested
                }
                child = child + 1
            }
        } else if (depth < 32 &&
            container.begin <= position && container.end >= position) {
            if (container.kind == "lambda" ||
                container.kind == "lambda.move") {
                var parameter = 0
                while (parameter + 1 < container.children.size) {
                    val found = container.children[parameter]
                    if (found.kind == "lambda.parameter" &&
                        found.text == name && found.children.size > 0) {
                        result = bootstrapNormalizeType(
                            found.children[0].text
                        )
                    }
                    parameter = parameter + 1
                }
            }
            var child = 0
            while (child < container.children.size) {
                val nested = this.lexicalTypeInExpression(
                    container.children[child],
                    name,
                    position,
                    depth + 1
                )
                if (nested != "unknown") result = nested
                child = child + 1
            }
        }
        result
    }

    fun lexicalSyntaxType(name: string, position: int, depth: int): string {
        var result = "unknown"
        var declaration = 0
        while (declaration < this.declarations.size) {
            val candidate = this.declarations[declaration]
            if (candidate.expression.begin <= position &&
                candidate.expression.end >= position) {
                var parameter = 0
                while (parameter < candidate.parameters.size &&
                    parameter < candidate.parameterTypes.size) {
                    if (candidate.parameters[parameter] == name) {
                        result = bootstrapNormalizeType(
                            candidate.parameterTypes[parameter]
                        )
                    }
                    parameter = parameter + 1
                }
                if (candidate.extensionOwner != "" && name == "this") {
                    result = bootstrapNormalizeType(candidate.extensionOwner)
                }
                val local = this.lexicalTypeInExpression(
                    candidate.expression,
                    name,
                    position,
                    depth
                )
                if (local != "unknown") result = local
            }
            var method = 0
            while (method < candidate.methods.size) {
                val member = candidate.methods[method]
                if (member.expression.begin <= position &&
                    member.expression.end >= position) {
                    if (name == "this") result = candidate.name
                    var parameter = 0
                    while (parameter < member.parameters.size &&
                        parameter < member.parameterTypes.size) {
                        if (member.parameters[parameter] == name) {
                            result = bootstrapNormalizeType(
                                member.parameterTypes[parameter]
                            )
                        }
                        parameter = parameter + 1
                    }
                    val local = this.lexicalTypeInExpression(
                        member.expression,
                        name,
                        position,
                        depth
                    )
                    if (local != "unknown") result = local
                }
                method = method + 1
            }
            declaration = declaration + 1
        }
        result
    }

    fun directCallTarget(
        expression: BootstrapExpression,
        depth: int
    ): int {
        var handle = -1
        if ((expression.kind == "call" ||
             expression.kind == "member.call") && expression.begin < 0) {
            val marked = 0 - expression.begin - 1
            if (this.functionHandleValid(marked)) handle = marked
        }
        if (handle < 0 && expression.kind == "call") {
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun" ||
                     candidate.kind == "extern") &&
                    candidate.name == expression.text) {
                    if (handle >= 0) handle = -2
                    if (handle == -1) handle = declaration
                }
                declaration = declaration + 1
            }
        }
        if (handle < 0 && expression.kind == "member.call" &&
            expression.children.size > 0) {
            val receiver = bootstrapBorrowElementType(
                this.staticSyntaxTypeAt(expression.children[0], depth + 1)
            )
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (candidate.name == expression.text &&
                    bootstrapNormalizeType(candidate.extensionOwner) == receiver) {
                    if (handle >= 0) handle = -2
                    if (handle == -1) handle = declaration
                }
                if (candidate.kind == "class" &&
                    candidate.name == receiver) {
                    var method = 0
                    while (method < candidate.methods.size) {
                        if (candidate.methods[method].name == expression.text) {
                            if (handle >= 0) handle = -2
                            if (handle == -1) {
                                handle = this.methodHandle(declaration, method)
                            }
                        }
                        method = method + 1
                    }
                }
                declaration = declaration + 1
            }
        }
        handle
    }

    fun staticSyntaxTypeAt(
        expression: BootstrapExpression,
        depth: int
    ): string {
        var result = "unknown"
        if (depth >= 8) result = "unknown"
        if (expression.kind == "integer") result = "i64"
        if (expression.kind == "true" || expression.kind == "false") {
            result = "bool"
        }
        if (expression.kind == "string") result = "string"
        if (expression.kind == "null") result = "null"
        if (expression.kind == "+" || expression.kind == "-" ||
            expression.kind == "*" || expression.kind == "/" ||
            expression.kind == "%" ||
            expression.kind == "&" || expression.kind == "|" ||
            expression.kind == "^" || expression.kind == "<<" ||
            expression.kind == ">>" || expression.kind == ">>>" ||
            expression.kind == "unary~") {
            result = "i64"
        }
        if (expression.kind == "==" || expression.kind == "!=" ||
            expression.kind == "<" || expression.kind == "<=" ||
            expression.kind == ">" || expression.kind == ">=") {
            result = "bool"
        }
        if (depth < 8 && expression.kind == "identifier") {
            result = this.lexicalSyntaxType(
                expression.text,
                expression.begin,
                depth + 1
            )
            var declarationNode = this.firstNamed(expression.text)
            while (declarationNode >= 0) {
                val declaration = this.namedDeclaration(declarationNode)
                val candidate = this.declarations[declaration]
                if (bootstrapDeclarationIsValue(candidate.kind) &&
                    candidate.name == expression.text && result == "unknown") {
                    if (candidate.resultType == "inferred") {
                        result = this.staticSyntaxTypeAt(
                            candidate.expression,
                            depth + 1
                        )
                    } else result = bootstrapNormalizeType(
                        candidate.resultType
                    )
                }
                if ((candidate.kind == "fun" ||
                     candidate.kind == "compile.fun" ||
                    candidate.kind == "extern") &&
                    candidate.name == expression.text && result == "unknown") {
                    result = bootstrapInferredFunctionType(
                        bootstrapDeclarationFunctionType(candidate),
                        bootstrapReflectedResultType(candidate)
                    )
                }
                declarationNode = this.nextNamed(declarationNode)
            }
        }
        if (depth < 8 && expression.kind == "array") {
            var elementType = "unknown"
            var element = 0
            while (element < expression.children.size) {
                val found = this.staticSyntaxTypeAt(
                    expression.children[element], depth + 1
                )
                if (elementType == "unknown") elementType = found
                if (elementType != found) elementType = "unknown"
                element = element + 1
            }
            result = "array:$elementType"
        }
        if (depth < 8 && expression.kind == "member" &&
            expression.children.size > 0) {
            val receiver = bootstrapBorrowElementType(
                this.staticSyntaxTypeAt(expression.children[0], depth + 1)
            )
            if (expression.text == "size" &&
                (receiver == "string" || bootstrapIsArrayType(receiver))) {
                result = "i64"
            }
            var declaration = 0
            while (declaration < this.declarations.size) {
                val candidate = this.declarations[declaration]
                if (candidate.kind == "class" &&
                    candidate.name == receiver) {
                    var field = 0
                    while (field < candidate.parameters.size) {
                        if (candidate.parameters[field] == expression.text &&
                            field < candidate.parameterKinds.size &&
                            (candidate.parameterKinds[field] == "val" ||
                             candidate.parameterKinds[field] == "var") &&
                            field < candidate.parameterTypes.size) {
                            result = bootstrapNormalizeType(
                                candidate.parameterTypes[field]
                            )
                        }
                        field = field + 1
                    }
                }
                declaration = declaration + 1
            }
        }
        if (depth < 8) {
            val target = this.directCallTarget(expression, depth)
            if (target >= 0) result = this.functionHandleResultType(target)
            if (expression.kind == "call" && target < 0) {
                var declaration = 0
                while (declaration < this.declarations.size) {
                    if (this.declarations[declaration].kind == "class" &&
                        this.declarations[declaration].name == expression.text) {
                        result = this.declarations[declaration].name
                    }
                    declaration = declaration + 1
                }
            }
        }
        result
    }

    fun staticSyntaxType(expression: BootstrapExpression): string =
        this.staticSyntaxTypeAt(expression, 0)

    fun typedCallIndex(expression: BootstrapExpression): int {
        var result = -1
        var index = 0
        while (result < 0 && index < this.typedCalls.size) {
            val candidate = this.typedCalls[index]
            if (candidate.begin == expression.begin &&
                candidate.end == expression.end &&
                candidate.kind == expression.kind &&
                candidate.name == expression.text) result = index
            index = index + 1
        }
        result
    }

    fun appendUniqueName(var names: array<string>, name: string): void {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        if (!found) names.append(name)
    }

    fun nameIsBound(names: array<string>, name: string): bool {
        var found = false
        var index = 0
        while (index < names.size) {
            if (names[index] == name) found = true
            index = index + 1
        }
        found
    }

    fun collectLambdaFreeNames(
        expression: BootstrapExpression,
        bound: array<string>,
        var free: array<string>
    ): void {
        var nested = false
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            nested = true
            val nestedBound: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nestedBound.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                this.appendUniqueName(
                    nestedBound,
                    expression.children[parameter].text
                )
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.collectLambdaFreeNames(body, nestedBound, free)
        }
        if (!nested) {
            if (expression.kind == "identifier" &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            if ((expression.kind == "call" ||
                 expression.kind == "assign") &&
                !this.nameIsBound(bound, expression.text)) {
                this.appendUniqueName(free, expression.text)
            }
            if (expression.kind == "block") {
                val scoped = bootstrapCopyBoundNames(bound)
                var child = 0
                while (child < expression.children.size) {
                    val statement = expression.children[child]
                    this.collectLambdaFreeNames(statement, scoped, free)
                    if (bootstrapStatementDeclaresLocal(statement)) {
                        scoped.append(statement.text)
                    }
                    child = child + 1
                }
            } else {
                var child = 0
                while (child < expression.children.size) {
                    this.collectLambdaFreeNames(
                        expression.children[child],
                        bound,
                        free
                    )
                    child = child + 1
                }
            }
        }
    }

    fun declarationIndexByName(name: string): int {
        var result = -1
        var declaration = 0
        while (declaration < this.declarations.size) {
            if (this.declarations[declaration].name == name) {
                result = declaration
            }
            declaration = declaration + 1
        }
        result
    }

    fun nameArrayContains(values: array<string>, value: string): bool {
        var found = false
        var index = 0
        while (index < values.size) {
            if (values[index] == value) found = true
            index = index + 1
        }
        found
    }

    fun intArrayContains(values: array<int>, value: int): bool {
        var found = false
        var index = 0
        while (index < values.size) {
            if (values[index] == value) found = true
            index = index + 1
        }
        found
    }

    fun intArrayAppendUnique(var values: array<int>, value: int): void {
        if (!this.intArrayContains(values, value)) values.append(value)
    }

    fun sliceCollectReferencedDeclarations(
        expression: BootstrapExpression,
        var bound: array<string>,
        var references: array<int>
    ): void {
        var processChildren = true
        if (expression.kind == "local.val" ||
            expression.kind == "local.var") {
            processChildren = false
            if (expression.children.size > 0) {
                this.sliceCollectReferencedDeclarations(
                    expression.children[0],
                    bound,
                    references
                )
                if (expression.children.size > 1) {
                    this.sliceCollectReferencedDeclarations(
                        expression.children[1],
                        bound,
                        references
                    )
                }
            }
            this.appendUniqueName(bound, expression.text)
        }
        if (expression.kind == "lambda" ||
            expression.kind == "lambda.move") {
            processChildren = false
            val nested: array<string> = []
            var inherited = 0
            while (inherited < bound.size) {
                nested.append(bound[inherited])
                inherited = inherited + 1
            }
            var parameter = 0
            while (parameter + 1 < expression.children.size) {
                nested.append(expression.children[parameter].text)
                parameter = parameter + 1
            }
            val body = expression.children[expression.children.size - 1]
            this.sliceCollectReferencedDeclarations(body, nested, references)
        }
        if ((expression.kind == "identifier" &&
             !this.nameIsBound(bound, expression.text)) ||
            (expression.kind == "call" &&
             !this.nameIsBound(bound, expression.text)) ||
            (expression.kind == "assign" &&
             !this.nameIsBound(bound, expression.text))) {
            val declaration = this.declarationIndexByName(expression.text)
            if (declaration >= 0 && declaration < this.declarations.size) {
                this.intArrayAppendUnique(
                    references,
                    declaration
                )
            }
        }
        if (processChildren && expression.kind == "block") {
            // A block's locals stay bound to its end only.
            val scoped = bootstrapCopyBoundNames(bound)
            var child = 0
            while (child < expression.children.size) {
                this.sliceCollectReferencedDeclarations(
                    expression.children[child],
                    scoped,
                    references
                )
                child = child + 1
            }
        } else if (processChildren) {
            var child = 0
            while (child < expression.children.size) {
                this.sliceCollectReferencedDeclarations(
                    expression.children[child],
                    bound,
                    references
                )
                child = child + 1
            }
        }
    }

    fun slicePathFromReachableUnsupported(
        declaration: int,
        var seen: array<int>,
        path: string
    ): string {
        var result = ""
        if (declaration >= 0 && declaration < this.declarations.size &&
            !this.intArrayContains(seen, declaration)) {
            seen.append(declaration)
            val root = this.declarations[declaration]
            if (root.kind == "var" ||
                (root.kind == "val" &&
                 root.expression.kind != "compile")) result = path
            val references: array<int> = []
            var bound: array<string> = []
            if (result == "" &&
                (root.kind == "fun" || root.kind == "compile.fun")) {
                var parameter = 0
                while (parameter < root.parameters.size) {
                    bound.append(root.parameters[parameter])
                    parameter = parameter + 1
                }
            }
            if (result == "" &&
                (root.kind == "fun" || root.kind == "compile.fun" ||
                 root.kind == "val")) {
                this.sliceCollectReferencedDeclarations(
                    root.expression,
                    bound,
                    references
                )
            }
            var dependency = 0
            while (result == "" && dependency < references.size) {
                val handle = references[dependency]
                result = this.slicePathFromReachableUnsupported(
                    handle,
                    seen,
                    "$path -> ${this.declarations[handle].name}"
                )
                dependency = dependency + 1
            }
        }
        result
    }

    fun lambdaMutatesCapturedPlace(
        expression: BootstrapExpression,
        bound: array<string>
    ): bool {
        var mutates = false
        if (expression.kind == "assign" &&
            !this.nameIsBound(bound, expression.text) &&
            (this.find(expression.text) >= 0 ||
             this.find("this") >= 0)) mutates = true
        if ((expression.kind == "member.assign" ||
             expression.kind == "index.assign") &&
            expression.children.size > 0) {
            val root = bootstrapPlaceRootName(expression.children[0])
            if (root != "" && !this.nameIsBound(bound, root) &&
                this.find(root) >= 0) mutates = true
        }
        if (expression.kind == "call" &&
            !this.nameIsBound(bound, expression.text)) {
            val target = this.find(expression.text)
            if (target >= 0 && this.values[target].kind == "closure" &&
                this.values[target].owner == "mut") mutates = true
        }
        if (expression.kind == "block") {
            val scoped = bootstrapCopyBoundNames(bound)
            var child = 0
            while (!mutates && child < expression.children.size) {
                val statement = expression.children[child]
                mutates = this.lambdaMutatesCapturedPlace(statement, scoped)
                if (bootstrapStatementDeclaresLocal(statement)) {
                    scoped.append(statement.text)
                }
                child = child + 1
            }
        } else if (expression.kind != "lambda" &&
            expression.kind != "lambda.move") {
            var child = 0
            while (!mutates && child < expression.children.size) {
                mutates = this.lambdaMutatesCapturedPlace(
                    expression.children[child],
                    bound
                )
                child = child + 1
            }
        }
        mutates
    }

    fun lambdaRequiresMutableCall(
        expression: BootstrapExpression
    ): bool {
        val bound: array<string> = []
        var parameter = 0
        while (parameter + 1 < expression.children.size) {
            bound.append(expression.children[parameter].text)
            parameter = parameter + 1
        }
        val body = expression.children[expression.children.size - 1]
        this.lambdaMutatesCapturedPlace(body, bound)
    }

    fun evaluateCall(expression: BootstrapExpression): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        var targetName = expression.text
        var target = this.find(expression.text)
        var callable = bootstrapEvalInvalid()
        if (target >= 0) callable = this.values[target]
        // A local captures the call only as a closure that takes these
        // arguments; any other local leaves it to the top-level declarations.
        if (target >= 0 && (callable.kind != "closure" && callable.kind != "function" ||
            callable.kind == "closure" &&
            this.syntax[callable.integer].children.size - 1 != expression.children.size)) {
            target = -1
        }
        if (target < 0) callable = bootstrapEvalGlobalCallable(this, expression.text)
        if (callable.kind == "function") targetName = callable.text
        if (callable.kind == "closure") {
            result = bootstrapEvaluateClosureCall(
                this, expression, callable, target
            )
            // A local callable is called as itself: no builtin or top-level
            // function of the same name stands in for it.
            if (target >= 0) {
                if (result.kind == "invalid") this.errors = this.errors + 1
                return result
            }
        }
        if (target < 0 && result.kind == "invalid") {
            result = bootstrapEvalScalarConversion(this, expression, targetName)
        }
        // An extern of a module imported under an alias keeps the module's
        // prefix (`__abla_module_<hex>__ablaF64Sqrt`); its intrinsic or host
        // provider knows it by its declared name, as the backend links it.
        val builtinName = bootstrapEvalExternBuiltinName(this, targetName)
        // ABLA_COMPILE_EVAL=bridge performs routed externs through the
        // native-code bridge (src/ct_bridge.ab) instead of directly.
        val routed = if (callable.kind != "closure" &&
            ctBridgeLoopbackEnabled()) {
            ctBridgeLoopbackTarget(this, builtinName)
        } else -1
        val errorsBefore = this.errors
        if (routed >= 0) {
            result = ctBridgeLoopbackCall(this, expression, routed)
        } else result = bootstrapEvaluateIntrinsicCall(
            this, expression, builtinName, result
        )
        // A provider that failed (a denied capability, `panic`, `exit`) is the
        // call's outcome: its body, which would act on the host, never runs.
        if (result.kind == "invalid" && this.errors > errorsBefore &&
            ctNativeProviderName(builtinName)) return result
        var declarationIndexNode = this.firstNamed(targetName)
        while (result.kind == "invalid" &&
               declarationIndexNode >= 0) {
            val declarationIndex = this.namedDeclaration(declarationIndexNode)
            val declaration = this.declarations[declarationIndex]
            if (declaration.kind == "class" &&
                declaration.name == targetName) {
                // A runtime-valued class's instance (a TVar) is the
                // evaluator's own value for it.
                result = if (bootstrapRuntimeValueConstructor(bootstrapRuntimeValueSpec(declaration)) ==
                        "__ablaRuntimeTVarCreate") bootstrapEvaluateCallTVar(this, expression)
                    else bootstrapEvaluateConstruction(
                        this, expression, declaration, declarationIndex
                    )
            }
            if (declaration.name == targetName &&
                (declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner == "") {
                val callNames: array<string> = []
                val callValues: array<BootstrapEvalValue> = []
                val callMutable: array<bool> = []
                var argument = 0
                while (argument < declaration.parameters.size) {
                    // A default sees the parameters bound before it: the name
                    // joins once its value is there (bootstrapEvalDefaultArgument).
                    if (argument < expression.children.size) {
                        callValues.append(bootstrapEvalCoerce(
                            this,
                            this.evaluate(expression.children[argument]),
                            if (argument < declaration.parameterTypes.size)
                                declaration.parameterTypes[argument]
                            else "inferred"
                        ))
                        argument = argument
                    } else if (argument < declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[argument].kind !=
                            "missing") {
                        callValues.append(bootstrapEvalDefaultArgument(
                            this,
                            declaration.parameterDefaults[argument],
                            callNames,
                            callValues,
                            callMutable
                        ))
                    } else {
                        callValues.append(bootstrapEvalInvalid())
                        this.errors = this.errors + 1
                    }
                    callNames.append(declaration.parameters[argument])
                    callMutable.append(false)
                    argument = argument + 1
                }
                val invocation = bootstrapEvalInvocation(
                    this, callNames, callValues, callMutable
                )
                // An argument that left its expression leaves the call too.
                val escaped = bootstrapEvalFirstEscape(callValues)
                result = if (escaped >= 0) bootstrapEvalInvalid()
                    else bootstrapEvaluateFrom(
                        invocation, declaration.sourceIdentity, declaration.expression
                    )
                if (result.kind == "return" && result.elements.size == 1) {
                    result = result.elements[0]
                }
                result = bootstrapEvalCoerce(this, result, declaration.resultType)
                invocation.dropOwnedParameters(
                    declaration.parameterKinds,
                    result,
                    0
                )
                this.errors = invocation.errors
                this.steps = invocation.steps
                this.diagnostics = invocation.diagnostics
                if (escaped >= 0) result = callValues[escaped]
            }
            if (declaration.name == targetName &&
                declaration.kind == "extern" &&
                declaration.externalLibrary == "c" &&
                declaration.extensionOwner == "") {
                result = ctNativeEvaluateExternCall(this, expression, declaration)
            }
            declarationIndexNode = this.nextNamed(declarationIndexNode)
        }
        if (result.kind == "invalid") this.errors = this.errors + 1
        result
    }

    fun evaluateMethod(
        receiver: BootstrapEvalValue,
        expression: BootstrapExpression,
        // An interface whose default body answers (`this` stays the instance).
        defaultOwner: string = ""
    ): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        val lookupOwner = if (defaultOwner != "") defaultOwner else receiver.owner
        var receiverType = receiver.owner
        if (receiver.kind == "string") receiverType = "string"
        if (receiver.kind == "integer") {
            receiverType = bootstrapEvalIntegerReceiverType(this, receiver, expression.text)
        }
        if (receiver.kind == "boolean") receiverType = "bool"
        if (receiver.kind == "f64") receiverType = "f64"
        if (receiver.kind == "f32") receiverType = "f32"
        // An extension on `array<T>` or `Map<K, V>` (generics.ab makes them per type).
        if ((receiver.kind == "array" || receiver.kind == "map") && receiverType == "") {
            receiverType = bootstrapEvalContainerReceiverType(this, receiver, expression.text)
        }
        if (receiver.owner == "Compiler") {
            var target = ""
            if (expression.text == "functions") {
                target = "compilerFunctions"
            }
            if (expression.text == "functionsAnnotated") {
                target = "compilerFunctionsAnnotated"
            }
            if (expression.text == "findFunction") {
                target = "compilerFindFunction"
            }
            if (expression.text == "functionName") {
                target = "compilerFunctionName"
            }
            if (expression.text == "functionIdentity") {
                target = "compilerFunctionCanonicalIdentity"
            }
            if (expression.text == "functionModuleIdentity") {
                target = "compilerFunctionModuleIdentity"
            }
            if (expression.text == "functionOwner") {
                target = "compilerFunctionOwner"
            }
            if (expression.text == "parameterCount") {
                target = "compilerFunctionParameterCount"
            }
            if (expression.text == "parameterName") {
                target = "compilerFunctionParameterName"
            }
            if (expression.text == "parameterType") {
                target = "compilerFunctionParameterType"
            }
            if (expression.text == "resultType") {
                target = "compilerFunctionResultType"
            }
            if (expression.text == "annotationCount") {
                target = "compilerFunctionAnnotationCount"
            }
            if (expression.text == "annotation") {
                target = "compilerFunctionAnnotation"
            }
            if (expression.text == "isCompileOnly") {
                target = "compilerFunctionIsCompileOnly"
            }
            if (expression.text == "isTrusted") {
                target = "compilerFunctionIsTrusted"
            }
            if (expression.text == "isExternal") {
                target = "compilerFunctionIsExternal"
            }
            if (expression.text == "replaceFunctionBody") {
                target = "compilerReplaceFunctionBody"
            }
            if (expression.text == "addFunctionAnnotation") {
                target = "compilerAddFunctionAnnotation"
            }
            if (expression.text == "generateModule") {
                target = "compilerGenerateModule"
            }
            if (expression.text == "writeFile") {
                target = "compilerWriteFile"
            }
            if (expression.text == "buildProgram") {
                target = "compilerBuildProgram"
            }
            if (expression.text == "defineTarget") {
                target = "compilerDefineTarget"
            }
            if (expression.text == "contributeArtifactRoot") {
                target = "compilerContributeArtifactRoot"
            }
            if (expression.text == "exportFunction") {
                target = "compilerExportFunction"
            }
            if (expression.text == "internalFunction") {
                target = "compilerInternalFunction"
            }
            if (expression.text == "requiredInternalFunction") {
                target = "compilerRequiredInternalFunction"
            }
            if (expression.text == "exportCheckedFunction") {
                target = "compilerExportCheckedFunction"
            }
            if (target != "") {
                val arguments: array<BootstrapExpression> = []
                var argument = 1
                while (argument < expression.children.size) {
                    arguments.append(expression.children[argument])
                    argument = argument + 1
                }
                result = this.evaluateCall(BootstrapExpression(
                    "call",
                    target,
                    expression.begin,
                    expression.end,
                    arguments
                ))
            }
        }
        // An extension method named like the call or a method of the receiver's class: the
        // first such declaration, in declaration order. The name index walks just the
        // declarations of those two names (both chains ascend, so merged they keep the
        // order); without one for these declarations, every declaration is scanned.
        // (An interface's default body is found by a scan: the index names
        // only what a call can name.)
        val indexed = defaultOwner == "" &&
            this.context.size == this.declarations.size
        var methodNode = if (indexed) this.firstNamed(expression.text) else -1
        var ownerNode = if (indexed && lookupOwner != "" &&
            lookupOwner != expression.text) this.firstNamed(lookupOwner) else -1
        var scanned = 0
        while (result.kind == "invalid") {
            var declarationIndex = -1
            if (indexed) {
                val fromMethod = if (methodNode >= 0) this.namedDeclaration(methodNode) else -1
                val fromOwner = if (ownerNode >= 0) this.namedDeclaration(ownerNode) else -1
                if (fromMethod >= 0 && (fromOwner < 0 || fromMethod < fromOwner)) {
                    declarationIndex = fromMethod
                    methodNode = this.nextNamed(methodNode)
                } else if (fromOwner >= 0) {
                    declarationIndex = fromOwner
                    ownerNode = this.nextNamed(ownerNode)
                }
            } else if (scanned < this.declarations.size) {
                declarationIndex = scanned
                scanned = scanned + 1
            }
            if (declarationIndex < 0) break
            val declaration = this.declarations[declarationIndex]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.name == expression.text &&
                bootstrapNormalizeType(declaration.extensionOwner) == receiverType) {
                val extensionNames: array<string> = ["this"]
                val extensionValues: array<BootstrapEvalValue> = [
                    bootstrapEvalCoerce(this, receiver, declaration.extensionOwner)
                ]
                val extensionMutable: array<bool> = [false]
                var parameter = 0
                while (parameter < declaration.parameters.size) {
                    if (parameter + 1 < expression.children.size) {
                        extensionValues.append(bootstrapEvalCoerce(
                            this,
                            this.evaluate(expression.children[parameter + 1]),
                            if (parameter < declaration.parameterTypes.size)
                                declaration.parameterTypes[parameter]
                            else "inferred"
                        ))
                    } else if (parameter <
                            declaration.parameterDefaults.size &&
                        declaration.parameterDefaults[parameter].kind !=
                            "missing") {
                        val defaults = BootstrapEvaluator(
                            this.declarations,
                            this.affineTypes,
                            this.context,
                            extensionNames,
                            extensionValues,
                            extensionMutable,
                            this.cursors,
                            this.syntax,
                            this.typedCalls,
                            this.reflectedTypes,
                            this.generatedDeclarations,
                            this.extensionRequests,
                            this.compileInputPaths,
                            this.compileInputContents,
                            this.globalKeys,
                            this.globalValues,
                            this.allowedCompileEffects,
                            this.errors,
                            this.steps,
                            this.diagnostics,
                            this.sourceIdentity
                        )
                        extensionValues.append(defaults.evaluate(
                            declaration.parameterDefaults[parameter]
                        ))
                        this.errors = defaults.errors
                        this.steps = defaults.steps
                        this.diagnostics = defaults.diagnostics
                    } else {
                        extensionValues.append(bootstrapEvalInvalid())
                        this.errors = this.errors + 1
                    }
                    extensionNames.append(declaration.parameters[parameter])
                    extensionMutable.append(false)
                    parameter = parameter + 1
                }
                val invocation = BootstrapEvaluator(
                    this.declarations,
                    this.affineTypes,
                    this.context,
                    extensionNames,
                    extensionValues,
                    extensionMutable,
                    this.cursors,
                    this.syntax,
                    this.typedCalls,
                    this.reflectedTypes,
                    this.generatedDeclarations,
                    this.extensionRequests,
                    this.compileInputPaths,
                    this.compileInputContents,
                    this.globalKeys,
                    this.globalValues,
                    this.allowedCompileEffects,
                    this.errors,
                    this.steps,
                    this.diagnostics,
                    this.sourceIdentity
                )
                val escaped = bootstrapEvalFirstEscape(extensionValues)
                result = if (escaped >= 0) bootstrapEvalInvalid()
                    else bootstrapEvaluateFrom(
                        invocation, declaration.sourceIdentity, declaration.expression
                    )
                if (result.kind == "return" && result.elements.size == 1) {
                    result = result.elements[0]
                }
                result = bootstrapEvalCoerce(this, result, declaration.resultType)
                invocation.dropOwnedParameters(
                    declaration.parameterKinds,
                    result,
                    1
                )
                this.errors = invocation.errors
                this.steps = invocation.steps
                this.diagnostics = invocation.diagnostics
                if (escaped >= 0) result = extensionValues[escaped]
            }
            if ((declaration.kind == "class" ||
                 declaration.kind == "interface" && defaultOwner != "") &&
                declaration.name == lookupOwner) {
                var methodIndex = 0
                while (methodIndex < declaration.methods.size) {
                    val method = declaration.methods[methodIndex]
                    if (if (declaration.kind == "interface")
                            bootstrapEvalIsDefaultBody(method, expression.text)
                        else method.name == expression.text) {
                        val methodNames: array<string> = ["this"]
                        val methodValues: array<BootstrapEvalValue> = [receiver]
                        val methodMutable: array<bool> = [false]
                        var parameter = 0
                        while (parameter < method.parameters.size) {
                            if (parameter + 1 < expression.children.size) {
                                methodValues.append(this.evaluate(
                                    expression.children[parameter + 1]
                                ))
                                this.steps = this.steps
                            } else if (parameter <
                                    method.parameterDefaults.size &&
                                method.parameterDefaults[parameter].kind !=
                                    "missing") {
                                val defaults = BootstrapEvaluator(
                                    this.declarations,
                                    this.affineTypes,
                                    this.context,
                                    methodNames,
                                    methodValues,
                                    methodMutable,
                                    this.cursors,
                                    this.syntax,
                                    this.typedCalls,
                                    this.reflectedTypes,
                                    this.generatedDeclarations,
                                    this.extensionRequests,
                                    this.compileInputPaths,
                                    this.compileInputContents,
                                    this.globalKeys,
                                    this.globalValues,
                                    this.allowedCompileEffects,
                                    this.errors,
                                    this.steps,
                                    this.diagnostics,
                                    this.sourceIdentity
                                )
                                methodValues.append(defaults.evaluate(
                                    method.parameterDefaults[parameter]
                                ))
                                this.errors = defaults.errors
                                this.steps = defaults.steps
                                this.diagnostics = defaults.diagnostics
                            } else {
                                methodValues.append(bootstrapEvalInvalid())
                                this.errors = this.errors + 1
                            }
                            methodNames.append(method.parameters[parameter])
                            methodMutable.append(false)
                            parameter = parameter + 1
                        }
                        val invocation = BootstrapEvaluator(
                            this.declarations,
                            this.affineTypes,
                            this.context,
                            methodNames,
                            methodValues,
                            methodMutable,
                        this.cursors,
                        this.syntax,
                        this.typedCalls,
                        this.reflectedTypes,
                        this.generatedDeclarations,
                        this.extensionRequests,
                            this.compileInputPaths,
                            this.compileInputContents,
                            this.globalKeys,
                            this.globalValues,
                            this.allowedCompileEffects,
                            this.errors,
                            this.steps,
                            this.diagnostics,
                            this.sourceIdentity
                        )
                        val escaped = bootstrapEvalFirstEscape(methodValues)
                        result = if (escaped >= 0) bootstrapEvalInvalid()
                            else bootstrapEvaluateFrom(
                                invocation,
                                if (method.sourceIdentity != "") method.sourceIdentity
                                else declaration.sourceIdentity,
                                method.expression
                            )
                        if (result.kind == "return" &&
                            result.elements.size == 1) {
                            result = result.elements[0]
                        }
                        invocation.dropOwnedParameters(
                            method.parameterKinds,
                            result,
                            1
                        )
                        this.errors = invocation.errors
                        this.steps = invocation.steps
                        this.diagnostics = invocation.diagnostics
                        if (escaped >= 0) result = methodValues[escaped]
                    }
                    methodIndex = methodIndex + 1
                }
            }
        }
        // A class without the method: the default body of an interface it
        // conforms to.
        if (result.kind == "invalid" && defaultOwner == "" &&
            receiver.kind == "object") {
            val interfaceName = this.defaultMethodInterface(
                receiver.owner, expression.text
            )
            if (interfaceName != "") {
                return this.evaluateMethod(receiver, expression, interfaceName)
            }
        }
        if (result.kind == "invalid") this.errors = this.errors + 1
        result
    }

    /** The interface whose default body answers `method` for instances of
     *  `owner` (a class without its own), or "". */
    fun defaultMethodInterface(owner: string, method: string): string {
        val provider = bootstrapDefaultInterface(this.declarations, owner, method)
        if (provider == "?") "" else provider
    }

    fun evaluateMapCall(
        map: BootstrapEvalValue,
        expression: BootstrapExpression
    ): BootstrapEvalValue {
        val keys = map.elements[0]
        val values = map.elements[1]
        val method = expression.text
        val key = if (expression.children.size > 1) {
            bootstrapEvalUnwrapBorrow(this.evaluate(expression.children[1]))
        } else bootstrapEvalNull()
        var entry = -1
        var index = 0
        while (expression.children.size > 1 && entry < 0 &&
            index < keys.elements.size) {
            if (bootstrapEvalEqual(keys.elements[index], key)) entry = index
            index = index + 1
        }
        var result = bootstrapEvalVoid()
        // Affine values stay the map's: `get`/`values` lend them, `take` moves
        // one out, and one replaced, removed or cleared is dropped.
        if (method == "get") {
            result = if (entry < 0) bootstrapEvalNull()
                else if (this.valueIsAffine(values.elements[entry])) {
                    bootstrapEvalBorrow(values.elements[entry])
                } else values.elements[entry]
        } else if (method == "has") {
            result = bootstrapEvalBoolean(entry >= 0)
        } else if (method == "set" && expression.children.size == 3) {
            val value = this.evaluate(expression.children[2])
            if (entry >= 0) {
                val previous = values.elements[entry]
                values.elements[entry] = value
                if (this.valueIsAffine(previous)) this.dropValue(previous)
            } else {
                keys.elements.append(key)
                values.elements.append(value)
            }
        } else if (method == "remove" || method == "take") {
            result = if (method == "take") bootstrapEvalNull()
                else bootstrapEvalBoolean(entry >= 0)
            if (entry >= 0) {
                val removed = values.elements[entry]
                if (method == "take") result = removed
                else if (this.valueIsAffine(removed)) this.dropValue(removed)
                var shift = entry
                while (shift + 1 < keys.elements.size) {
                    keys.elements[shift] = keys.elements[shift + 1]
                    values.elements[shift] = values.elements[shift + 1]
                    shift = shift + 1
                }
                keys.elements.truncate(keys.elements.size - 1)
                values.elements.truncate(values.elements.size - 1)
            }
        } else if (method == "keys" || method == "values") {
            val source = if (method == "keys") keys else values
            val copy: array<BootstrapEvalValue> = []
            var element = 0
            while (element < source.elements.size) {
                copy.append(source.elements[element])
                element = element + 1
            }
            result = bootstrapEvalArray(copy)
            if (method == "values" && this.valueIsAffine(result)) {
                result = bootstrapEvalBorrow(result)
            }
        } else if (method == "clear") {
            if (this.valueIsAffine(values)) this.dropValue(values)
            keys.elements.truncate(0)
            values.elements.truncate(0)
        } else {
            this.errors = this.errors + 1
            result = bootstrapEvalInvalid()
        }
        result
    }

    /** The object's field `name`: a declared one, or an extension field (its
     *  value if the object holds it, else its default, not stored). Invalid
     *  for neither. */
    fun objectField(
        receiver: BootstrapEvalValue,
        name: string
    ): BootstrapEvalValue {
        var result = bootstrapEvalInvalid()
        var found = false
        var field = 0
        while (field < receiver.fieldNames.size) {
            if (receiver.fieldNames[field] == name) {
                result = receiver.elements[field]
                found = true
            }
            field = field + 1
        }
        if (!found) {
            val declaration = this.extensionFieldDefaultDeclaration(receiver.owner, name)
            if (declaration >= 0) result = this.extensionFieldDefault(receiver, declaration)
        }
        result
    }

    /** The default function of the extension field `owner.field`
     *  (bootstrapExtensionFieldDefaultName), -1 when there is none. */
    fun extensionFieldDefaultDeclaration(owner: string, field: string): int {
        val index = this.namedExtension(
            bootstrapExtensionFieldDefaultName(field), owner, "fun"
        )
        index
    }

    /** Whether `owner.field` is an extension `val`, assigned once per object. */
    fun extensionFieldIsValue(owner: string, field: string): bool =
        this.namedExtension(field, owner, "extension.val") >= 0

    /** The first declaration of kind `kind` named `name` extending `owner`
     *  (through the name index when it covers the declarations), or -1. */
    fun namedExtension(name: string, owner: string, kind: string): int {
        var result = -1
        val indexed = this.context.size == this.declarations.size
        var node = if (indexed) this.firstNamed(name) else -1
        var scanned = 0
        var more = true
        while (result < 0 && more) {
            var index = -1
            if (indexed) {
                if (node >= 0) {
                    index = this.namedDeclaration(node)
                    node = this.nextNamed(node)
                }
            } else if (scanned < this.declarations.size) {
                index = scanned
                scanned = scanned + 1
            }
            if (index < 0) {
                more = false
            } else {
                val declaration = this.declarations[index]
                if (declaration.kind == kind && declaration.name == name &&
                    declaration.extensionOwner != "" &&
                    bootstrapNormalizeType(declaration.extensionOwner) == owner) result = index
            }
        }
        result
    }

    /** Runs an extension field's default function with `receiver` as `this`. */
    fun extensionFieldDefault(
        receiver: BootstrapEvalValue,
        index: int
    ): BootstrapEvalValue {
        val declaration = this.declarations[index]
        val invocation = BootstrapEvaluator(
            this.declarations,
            this.affineTypes,
            this.context,
            ["this"],
            [bootstrapEvalCoerce(this, receiver, declaration.extensionOwner)],
            [false],
            this.cursors,
            this.syntax,
            this.typedCalls,
            this.reflectedTypes,
            this.generatedDeclarations,
            this.extensionRequests,
            this.compileInputPaths,
            this.compileInputContents,
            this.globalKeys,
            this.globalValues,
            this.allowedCompileEffects,
            this.errors,
            this.steps,
            this.diagnostics,
            this.sourceIdentity
        )
        var result = bootstrapEvaluateFrom(
            invocation, declaration.sourceIdentity, declaration.expression
        )
        if (result.kind == "return" && result.elements.size == 1) {
            result = result.elements[0]
        }
        result = bootstrapEvalCoerce(this, result, declaration.resultType)
        this.errors = invocation.errors
        this.steps = invocation.steps
        this.diagnostics = invocation.diagnostics
        result
    }

    fun evaluate(expression: BootstrapExpression): BootstrapEvalValue {
        val errorsBefore = this.errors
        val diagnosticsBefore = this.diagnostics.size
        this.steps = this.steps + 1
        // A `retry` leaving an `orElse` alternative (bootstrapEvaluateOrElse).
        if (bootstrapEvalStmRetrying) return bootstrapEvalInvalid()
        if (this.steps > this.context.stepLimit) {
            // Past the limit nothing is evaluated: a loop the limit cut short
            // leaves values no later code expects (a slice out of range).
            bootstrapEvalStepLimitReached(this)
            return bootstrapEvalInvalid()
        }
        // Each level of a nested evaluation holds frames on the compiler's own
        // stack: past the depth that stack can take, stop with a diagnostic
        // instead of crashing (deep compile-time recursion).
        if (bootstrapEvalDepth == 0) {
            bootstrapEvalStackBase = bootstrapEvalStackMark()
        } else if ((bootstrapEvalDepth % 8 == 0 &&
                    bootstrapEvalStackBase - bootstrapEvalStackMark() >
                        bootstrapEvalStackBudget()) ||
                   bootstrapEvalDepth >= bootstrapEvalDepthLimit()) {
            bootstrapEvalDepthLimitReached(this)
            return bootstrapEvalInvalid()
        }
        bootstrapEvalDepth = bootstrapEvalDepth + 1
        // The cases are @noinline functions of their own, so a nested
        // evaluation holds a small frame per level, not every case's locals.
        val form = bootstrapEvalCase(expression)
        var result = when (form) {
            1 -> bootstrapEvaluateInteger(this, expression)
            2 -> bootstrapEvalBoolean(expression.kind == "true")
            3 -> bootstrapEvalString(expression.text)
            8 -> bootstrapEvaluateIdentifier(this, expression)
            15 -> this.evaluateCall(expression)
            16 -> this.evaluate(expression.children[0])
            17 -> this.evaluate(expression.children[0])
            21 -> bootstrapEvaluateTemplate(this, expression)
            22 -> bootstrapEvaluateBlock(this, expression)
            24 -> bootstrapEvaluateReturn(this, expression)
            26 -> bootstrapEvaluateLocal(this, expression)
            27 -> bootstrapEvaluateAssign(this, expression)
            30 -> bootstrapEvaluateArrayLiteral(this, expression)
            32 -> bootstrapEvaluateMember(this, expression)
            34 -> bootstrapEvaluateIndex(this, expression)
            36 -> bootstrapEvaluateMemberCall(this, expression)
            41 -> bootstrapEvaluateArithmetic(this, expression)
            43 -> bootstrapEvaluateEquality(this, expression)
            44 -> bootstrapEvaluateComparison(this, expression)
            45 -> bootstrapEvaluateAnd(this, expression)
            46 -> bootstrapEvaluateOr(this, expression)
            47 -> bootstrapEvaluateIf(this, expression)
            48 -> bootstrapEvaluateWhen(this, expression)
            49 -> bootstrapEvaluateWhile(this, expression)
            51 -> bootstrapEvaluateFor(this, expression)
            else -> bootstrapEvaluateUncommon(this, expression, form)
        }
        bootstrapEvalDepth = bootstrapEvalDepth - 1
        // While a stack-depth stop unwinds, the levels it passes through
        // failed because of it: it is the one diagnostic, not one per level.
        val unwinding = bootstrapEvalDepthReported
        if (bootstrapEvalDepth == 0) bootstrapEvalDepthReported = false
        if (!unwinding && this.errors > errorsBefore &&
            this.diagnostics.size == diagnosticsBefore) {
            bootstrapEvalExpressionFailed(this, expression)
        }
        result
    }
}

/** A type, class or function name as `#` code writes it, a generic's
 *  instance by its type arguments (`Box<int>`), as the program names it. */
fun bootstrapEvalGenericSpelling(evaluator: BootstrapEvaluator, text: string): string {
    var angle = false
    for (byte in text) if (byte == 60) angle = true
    if (!angle) return text
    val spelled = bootstrapGenericSpelledName(text, bootstrapGenericTableOf(evaluator.declarations))
    if (bootstrapIsGenericInstanceName(spelled)) spelled else text
}

// The compiler's builtins, by family: each family's cases (and their locals)
// live in a frame of their own, entered only for a name of that family.
@noinline
fun bootstrapEvaluateIntrinsicCall(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName.startsWith("__abla") ||
        targetName.startsWith("git") ||
        targetName.startsWith("import") ||
        targetName.startsWith("resolved")) {
        result = bootstrapEvaluateCallImports(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("compiler") ||
        targetName.startsWith("typed")) {
        result = bootstrapEvaluateCallReflection(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("abla") ||
        targetName.startsWith("runtime")) {
        result = bootstrapEvaluateCallText(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("compiler")) {
        result = bootstrapEvaluateCallCompiler(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("abla") ||
        targetName.startsWith("compiler")) {
        result = bootstrapEvaluateCallHost(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("parser")) {
        result = bootstrapEvaluateCallParser(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("syntax")) {
        result = bootstrapEvaluateCallSyntax(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("compilerGenerated")) {
        result = bootstrapEvaluateCallGenerated(
            evaluator, expression, targetName, result
        )
    }
    if (targetName.startsWith("typed")) {
        result = bootstrapEvaluateCallTyped(
            evaluator, expression, targetName, result
        )
    }
    if (result.kind == "invalid" && ctNativeScalarConversion(targetName)) {
        result = ctNativeEvaluateScalarConversion(evaluator, expression, targetName)
    }
    if (result.kind == "invalid" && ctNativeIntrinsicPrefix(targetName) &&
        ctNativeIntrinsic(targetName)) {
        result = ctNativeEvaluateIntrinsic(evaluator, expression, targetName)
    }
    if (result.kind == "invalid" && ctNativeProviderName(targetName)) {
        val effect = ctNativeProviderTarget(evaluator, "", targetName)
        if (effect >= 0) {
            result = ctNativeEvaluateProvider(evaluator, expression, targetName, effect)
        }
    }
    // A provider method by its key (the JIT tier's bridge): the receiver is
    // the first child.
    if (result.kind == "invalid" && targetName.startsWith("Path.") &&
        expression.children.size > 0) {
        val receiver = bootstrapEvalUnwrapBorrow(evaluator.evaluate(expression.children[0]))
        val method = targetName.slice(5, targetName.size)
        val effect = ctNativePathProvider(evaluator, receiver, method)
        if (effect >= 0) {
            result = ctNativeEvaluatePathMethod(
                evaluator, receiver, method, expression.children, 1, effect
            )
        }
    }
    result
}

@noinline
fun bootstrapEvalGlobalCallable(
    var evaluator: BootstrapEvaluator,
    name: string
): BootstrapEvalValue {
    var callable = bootstrapEvalInvalid()
    var globalNode = evaluator.firstNamed(name)
    while (callable.kind == "invalid" &&
           globalNode >= 0) {
        val global = evaluator.namedDeclaration(globalNode)
        val declaration = evaluator.declarations[global]
        if (bootstrapDeclarationIsValue(declaration.kind) &&
            declaration.name == name) {
            callable = bootstrapEvaluateFrom(
                evaluator, declaration.sourceIdentity, declaration.expression
            )
        }
        globalNode = evaluator.nextNamed(globalNode)
    }
    callable
}

@noinline
fun bootstrapEvaluateConstruction(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    declaration: BootstrapDeclaration,
    declarationIndex: int
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val fields: array<BootstrapEvalValue> = []
    val context = evaluator.context
    val cacheable = declarationIndex >= 0 && declarationIndex < context.size &&
        context.size == evaluator.declarations.size
    if (cacheable) {
        while (context.constructionKnown.size < context.size) {
            context.constructionKnown.append(false)
            context.constructionFields.append(BOOTSTRAP_EVAL_NO_FIELDS)
        }
    }
    val known = cacheable && context.constructionKnown[declarationIndex]
    val fieldNames: array<string> =
        if (known) context.constructionFields[declarationIndex] else []
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        var value = bootstrapEvalInvalid()
        if (parameter < expression.children.size) {
            value = evaluator.evaluate(expression.children[parameter])
        } else if (parameter < declaration.parameterDefaults.size &&
            declaration.parameterDefaults[parameter].kind !=
                "missing") {
            value = evaluator.evaluate(
                declaration.parameterDefaults[parameter]
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            value = value
        }
        if (parameter < declaration.parameterTypes.size) {
            value = bootstrapEvalCoerce(
                evaluator, value, declaration.parameterTypes[parameter]
            )
        }
        if (parameter < declaration.parameterKinds.size &&
            (declaration.parameterKinds[parameter] == "val" ||
             declaration.parameterKinds[parameter] == "var")) {
            if (!known) fieldNames.append(declaration.parameters[parameter])
            fields.append(value)
        }
        parameter = parameter + 1
    }
    if (cacheable && !known) {
        context.constructionFields[declarationIndex] = fieldNames
        context.constructionKnown[declarationIndex] = true
    }
    // Where the program declares extension fields, an instance gets its own
    // names: gaining one appends to them (bootstrapEvaluatePlace).
    if (context.extensionFields.size == 0) {
        var found = false
        for (candidate in evaluator.declarations) {
            if (bootstrapIsExtensionFieldKind(candidate.kind)) found = true
        }
        context.extensionFields.append(found)
    }
    val instanceNames: array<string> = []
    if (context.extensionFields[0]) {
        for (name in fieldNames) instanceNames.append(name)
    }
    result = bootstrapEvalObject(
        declaration.name,
        if (context.extensionFields[0]) instanceNames else fieldNames,
        fields
    )
    val escaped = bootstrapEvalFirstEscape(fields)
    if (escaped >= 0) result = fields[escaped]
    result
}

/** An evaluator for a call's body: the caller's declarations and shared
 *  state, the callee's bindings, and the caller's error and step counts. */
@noinline
fun bootstrapEvalInvocation(
    var evaluator: BootstrapEvaluator,
    names: array<string>,
    values: array<BootstrapEvalValue>,
    mutable: array<bool>
): BootstrapEvaluator = BootstrapEvaluator(
    evaluator.declarations,
    evaluator.affineTypes,
    evaluator.context,
    names,
    values,
    mutable,
    evaluator.cursors,
    evaluator.syntax,
    evaluator.typedCalls,
    evaluator.reflectedTypes,
    evaluator.generatedDeclarations,
    evaluator.extensionRequests,
    evaluator.compileInputPaths,
    evaluator.compileInputContents,
    evaluator.globalKeys,
    evaluator.globalValues,
    evaluator.allowedCompileEffects,
    evaluator.errors,
    evaluator.steps,
    evaluator.diagnostics,
    evaluator.sourceIdentity
)

/** A default argument, evaluated with the parameters bound before it. */
@noinline
fun bootstrapEvalDefaultArgument(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    names: array<string>,
    values: array<BootstrapEvalValue>,
    mutable: array<bool>
): BootstrapEvalValue {
    val defaults = bootstrapEvalInvocation(evaluator, names, values, mutable)
    val value = defaults.evaluate(expression)
    evaluator.errors = defaults.errors
    evaluator.steps = defaults.steps
    evaluator.diagnostics = defaults.diagnostics
    value
}

// How deeply `evaluate` is nested now, and the optional level cap (0 until
// first computed).
var bootstrapEvalDepth: int = 0
var bootstrapEvalDepthLimitValue: int = 0
// The limit is reported once per outermost evaluation, not by every level that
// then unwinds into it again.
var bootstrapEvalDepthReported: bool = false

// The stack the outermost evaluation started at, and how far below it nested
// evaluation may go: the stack limit less 1 MB for the compiler's own frames
// above it and 512 KB for the deepest levels (checked every 8 of them) and the
// diagnostic. Measuring bytes, not levels, keeps the guard right when a
// level's frames grow or shrink.
var bootstrapEvalStackBase: int = 0
var bootstrapEvalStackBudgetValue: int = 0

// An address in this call's own frame, just below the caller's.
@noinline
trusted fun bootstrapEvalStackMark(): int = nativeStackAllocate(16)

fun bootstrapEvalStackBudget(): int {
    if (bootstrapEvalStackBudgetValue == 0) {
        var stackBytes = 8 * 1024 * 1024
        val limits = linuxStackLimits()
        if (limits.size == 2) {
            stackBytes = if (limits[0] < 0) 512 * 1024 * 1024 else limits[0]
        }
        var budget = stackBytes - 1024 * 1024 - 512 * 1024
        if (budget < 1024 * 1024) budget = 1024 * 1024
        bootstrapEvalStackBudgetValue = budget
    }
    bootstrapEvalStackBudgetValue
}

// ABLA_EVAL_DEPTH_LIMIT caps the nesting in levels (for tests); without it
// only the stack budget applies.
fun bootstrapEvalDepthLimit(): int {
    if (bootstrapEvalDepthLimitValue == 0) {
        var limit = 1000000000
        val configured = linuxEnvironment("ABLA_EVAL_DEPTH_LIMIT")
        if (configured.found && configured.value.size <= 9) {
            val parsed = bootstrapDecimalIndex(configured.value)
            if (parsed > 0) limit = parsed
        }
        bootstrapEvalDepthLimitValue = limit
    }
    bootstrapEvalDepthLimitValue
}

// How many stack-depth stops have been reported, ever: a caller compares it
// before and after an evaluation to tell whether one happened inside.
var bootstrapEvalDepthStops: int = 0

/** The number of `error[` lines in `diagnostics`. */
fun bootstrapEvalErrorLines(diagnostics: string): int {
    var count = 0
    var index = 0
    var lineStart = true
    while (index < diagnostics.size) {
        if (lineStart && index + 6 <= diagnostics.size &&
            diagnostics.slice(index, index + 6) == "error[") count = count + 1
        lineStart = diagnostics[index] == 10
        index = index + 1
    }
    count
}

@noinline
fun bootstrapEvalDepthLimitReached(var evaluator: BootstrapEvaluator): void {
    evaluator.errors = evaluator.errors + 1
    if (bootstrapEvalDepthReported) return
    bootstrapEvalDepthReported = true
    bootstrapEvalDepthStops = bootstrapEvalDepthStops + 1
    evaluator.recordEvaluatorDiagnostic(
        "E_EVAL_STACK_DEPTH",
        "compile-time evaluation nested ${bootstrapEvalDepth} levels deep and used up the compiler's stack (unbounded recursion, or recursion deeper than the compiler's stack allows)"
    )
}

// The evaluator's diagnostics are built apart from `evaluate`, whose frame
// every level of a nested evaluation holds.
@noinline
fun bootstrapEvalStepLimitReached(var evaluator: BootstrapEvaluator): void {
    val stepLimit = evaluator.context.stepLimit
    evaluator.errors = evaluator.errors + 1
    if (evaluator.steps == stepLimit + 1) {
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_STEP_LIMIT",
            "compile-time evaluation ran past $stepLimit steps (an endless loop?)"
        )
    }
}

// Where compiled code would panic (eval_checks.ab): a compile-time error with
// the panic's text, at `expression`.
@noinline
fun bootstrapEvalRuntimePanic(
    var evaluator: BootstrapEvaluator,
    code: string,
    message: string,
    expression: BootstrapExpression
): BootstrapEvalValue {
    evaluator.errors = evaluator.errors + 1
    val source = evaluator.sourceIdentity
    if (source == "") {
        evaluator.recordEvaluatorDiagnostic(
            code, "$message at ${expression.begin}:${expression.end}"
        )
    } else {
        evaluator.recordEvaluatorDiagnostic(code, message)
        evaluator.diagnostics =
            "${evaluator.diagnostics}source[eval]:$source:${expression.begin}:${expression.end}\n"
    }
    bootstrapEvalInvalid()
}

@noinline
fun bootstrapEvalExpressionFailed(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): void {
    val source = evaluator.sourceIdentity
    if (source == "") {
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_EXPRESSION",
            "compile-time evaluation failed while evaluating `${expression.kind}` `${expression.text}` at ${expression.begin}:${expression.end}"
        )
    } else {
        evaluator.recordEvaluatorDiagnostic(
            "E_EVAL_EXPRESSION",
            "compile-time evaluation failed while evaluating `${expression.kind}` `${expression.text}`"
        )
        evaluator.diagnostics =
            "${evaluator.diagnostics}source[eval]:$source:${expression.begin}:${expression.end}\n"
    }
}

// Evaluates a declaration's body as code of the source it came from, which an
// evaluation failure names.
@noinline
fun bootstrapEvaluateFrom(
    var evaluator: BootstrapEvaluator,
    source: string,
    expression: BootstrapExpression
): BootstrapEvalValue {
    if (source == "" || source == evaluator.sourceIdentity) {
        return evaluator.evaluate(expression)
    }
    val previous = evaluator.sourceIdentity
    evaluator.sourceIdentity = source
    val previousRawContext = ctNativeEnterSource(source)
    val result = evaluator.evaluate(expression)
    ctNativeRawContext = previousRawContext
    evaluator.sourceIdentity = previous
    result
}

// A program global (`val` / `var`) read by compile-time code: like a `compile val`,
// one value for the whole compilation, so what compile-time code changes through
// it or assigns to it is what every later evaluation reads, as within one run of
// the program. The program itself starts from its own initializer; nothing leaks
// into it. The program initializes its globals before anything changes them, so
// an initializer here reads the others' initial values (`initial:` keys), not
// what the evaluation has changed since: a global first read after another was
// assigned still starts where the program's does.
fun bootstrapRuntimeGlobalKey(declaration: BootstrapDeclaration): string =
    "runtime:${bootstrapCompileGlobalKey(declaration)}"

fun bootstrapEvalGlobalSlot(evaluator: BootstrapEvaluator, key: string): int {
    var index = 0
    while (index < evaluator.globalKeys.size) {
        if (evaluator.globalKeys[index] == key) return index
        index = index + 1
    }
    -1
}

@noinline
fun bootstrapRuntimeGlobal(
    var evaluator: BootstrapEvaluator,
    declaration: BootstrapDeclaration
): BootstrapEvalValue {
    var initializing = false
    var binding = evaluator.names.size
    while (!initializing && binding > 0) {
        binding = binding - 1
        if (evaluator.names[binding] == "#initial") initializing = true
    }
    val key = if (initializing) "initial:${bootstrapCompileGlobalKey(declaration)}"
        else bootstrapRuntimeGlobalKey(declaration)
    val slot = bootstrapEvalGlobalSlot(evaluator, key)
    if (slot >= 0) return evaluator.globalValues[slot]
    var value = bootstrapCompileGlobalLoad(
        key, evaluator.declarations, evaluator.syntax
    )
    if (value.kind == "invalid" && !initializing) {
        value = bootstrapRuntimeGlobalInitial(evaluator, declaration)
    } else if (value.kind == "invalid") {
        // In a scope of its own: the initializer sees globals, not the locals
        // of the code that first read it.
        var initializer = bootstrapEvalInvocation(
            evaluator, ["#initial"], [bootstrapEvalVoid()], [false]
        )
        value = bootstrapEvaluateFrom(
            initializer, declaration.sourceIdentity, declaration.expression
        )
        evaluator.errors = initializer.errors
        evaluator.steps = initializer.steps
        evaluator.diagnostics = initializer.diagnostics
    }
    evaluator.globalKeys.append(key)
    evaluator.globalValues.append(value)
    value
}

// A global's initial value: its initializer, reading the initial values of
// the globals it names. The live value starts as this same value (an object
// stays one object, whichever way it is reached).
fun bootstrapRuntimeGlobalInitial(
    var evaluator: BootstrapEvaluator,
    declaration: BootstrapDeclaration
): BootstrapEvalValue {
    var initializer = bootstrapEvalInvocation(
        evaluator, ["#initial"], [bootstrapEvalVoid()], [false]
    )
    val value = bootstrapRuntimeGlobal(initializer, declaration)
    evaluator.errors = initializer.errors
    evaluator.steps = initializer.steps
    evaluator.diagnostics = initializer.diagnostics
    value
}

/** Whether the evaluation runs a method whose receiver has a field `name`. */
fun bootstrapEvalReceiverHasField(evaluator: BootstrapEvaluator, name: string): bool {
    val receiver = evaluator.find("this")
    if (receiver < 0 || evaluator.values[receiver].kind != "object") return false
    for (fieldName in evaluator.values[receiver].fieldNames) {
        if (fieldName == name) return true
    }
    false
}

/** The program `var` global named `name`, -1 none. */
fun bootstrapRuntimeVar(evaluator: BootstrapEvaluator, name: string): int {
    var result = -1
    var index = 0
    while (index < evaluator.declarations.size) {
        if (evaluator.declarations[index].kind == "var" &&
            evaluator.declarations[index].name == name) result = index
        index = index + 1
    }
    result
}

// A failed `#` expression of the program: its diagnostics, counted as one error
// per `error[` line (bootstrapDiagnosedLoweringErrors).
fun bootstrapStageEvaluationFailure(diagnostics: string): void {
    var text = diagnostics
    if (text == "") {
        text = "error[E_EVAL_EXPRESSION]: compile-time evaluation failed\n"
    }
    var lines = 0
    var index = 0
    while (index + 6 <= text.size) {
        if ((index == 0 || text[index - 1] == 10) &&
            text.slice(index, index + 6) == "error[") lines = lines + 1
        index = index + 1
    }
    if (lines == 0) {
        text = "error[E_EVAL_EXPRESSION]: compile-time evaluation failed\n$text"
        lines = 1
    }
    bootstrapStageDriverDiagnostic(text)
    bootstrapNoteDiagnosedLoweringErrors(lines)
    return
}

// The kinds `evaluate` dispatches through here are the ones that rarely nest
// deeply; each case `evaluate` handles itself costs its frame a few slots.
@noinline
fun bootstrapEvaluateUncommon(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    form: int
): BootstrapEvalValue = when (form) {
    4 -> bootstrapEvaluateDeclarationBlock(evaluator, expression)
    5 -> bootstrapEvalNull()
    6 -> bootstrapEvaluateDelegateInitializer(evaluator, expression)
    7 -> bootstrapEvaluateLambda(evaluator, expression)
    9 -> bootstrapEvaluateMove(evaluator, expression)
    10 -> bootstrapEvaluateCallShared(evaluator, expression)
    11 -> bootstrapEvaluateCallMutex(evaluator, expression)
    // A compile-time map: its keys and values in insertion order.
    12 -> bootstrapEvaluateCallMap(evaluator, expression)
    13 -> bootstrapEvaluateCallCell(evaluator, expression)
    14 -> bootstrapEvaluateFilledArray(evaluator, expression)
    18 -> bootstrapEvaluateTask(evaluator, expression)
    19 -> bootstrapEvaluateAwait(evaluator, expression)
    20 -> bootstrapEvaluateGenerator(evaluator, expression)
    23 -> bootstrapEvalVoid()
    25 -> bootstrapEvalLoopControl(expression.kind)
    28 -> bootstrapEvaluateDelegateProject(evaluator, expression)
    29 -> bootstrapEvaluateDelegateAssign(evaluator, expression)
    31 -> bootstrapEvaluateRange(evaluator, expression)
    33 -> bootstrapEvaluateMemberAssign(evaluator, expression)
    35 -> bootstrapEvaluateIndexAssign(evaluator, expression)
    37 -> bootstrapEvaluateNegate(evaluator, expression)
    38 -> bootstrapEvalF64(f64Parse(expression.text))
    39 -> bootstrapEvaluateNot(evaluator, expression)
    40 -> bootstrapEvaluateComplement(evaluator, expression)
    42 -> bootstrapEvaluateBitwise(evaluator, expression)
    50 -> bootstrapEvaluateDoWhile(evaluator, expression)
    52 -> bootstrapEvaluateCallValue(evaluator, expression)
    // An argument native code passed to an intrinsic (src/ct_bridge.ab).
    53 -> ctBridgeArgument(expression)
    54 -> bootstrapEvaluateInterfaceCast(evaluator, expression)
    // (55, `TVar(…)`, is a class's construction: evaluateCall.)
    56 -> bootstrapEvaluateAtomic(evaluator, expression)
    57 -> bootstrapEvaluateOrElse(evaluator, expression)
    else -> bootstrapEvalInvalid()
}

/** A class (or function) named `name` in its source whose name carries its
 *  module's prefix (a private one, or any in a module imported under an
 *  alias): the calling module's own when the evaluation knows it, else the
 *  only one in the program. -1 when there is none, or more than one. */
fun bootstrapEvalPrivateHandle(
    evaluator: BootstrapEvaluator,
    name: string,
    wantClass: bool
): int {
    var own = -1
    var only = -1
    var count = 0
    var index = 0
    while (index < evaluator.declarations.size) {
        val declaration = evaluator.declarations[index]
        if (declaration.extensionOwner == "" && declaration.name != name &&
            (if (wantClass) declaration.kind == "class"
             else declaration.kind == "fun" || declaration.kind == "compile.fun") &&
            bootstrapSourceVisibleType(declaration.name) == name) {
            if (declaration.sourceIdentity == evaluator.sourceIdentity) own = index
            only = index
            count = count + 1
        }
        index = index + 1
    }
    if (own >= 0) own else if (count == 1) only else -1
}

/** Whether `member` of an interface is the default body of `name`: the member
 *  itself, or (once lowering made `name` a dispatcher, interfaces.ab) the body
 *  kept as `name__default`. */
fun bootstrapEvalIsDefaultBody(member: BootstrapDeclaration, name: string): bool =
    (member.name == name || member.name == "${name}__default") &&
        member.expression.kind != "missing" &&
        member.expression.kind != "interface.dispatch"

/** `value as? Square`: the value when it is an instance of the class, else
 *  null. */
fun bootstrapEvaluateInterfaceCast(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    val value = bootstrapEvalUnwrapBorrow(evaluator.evaluate(expression.children[0]))
    if (value.kind == "object" &&
        value.owner == bootstrapNormalizeType(expression.text)) value
    else if (value.kind == "invalid") value
    else bootstrapEvalNull()
}

/** Which case of BootstrapEvaluator.evaluate handles `expression`: one
 *  test of its kind (and a call's name) here keeps the comparisons out
 *  of the evaluator's recursive frames. 0: none. */
@noinline
fun bootstrapEvalCase(expression: BootstrapExpression): int {
    if (expression.kind == "integer") return 1
    if (expression.kind == "true" || expression.kind == "false") return 2
    if (expression.kind == "string") return 3
    if (expression.kind == "declaration.block") return 4
    if (expression.kind == "null") return 5
    if (expression.kind == "delegate.initializer" &&
        expression.children.size > 0) return 6
    if (expression.kind == "lambda" ||
        expression.kind == "lambda.move") return 7
    if (expression.kind == "identifier") return 8
    if (expression.kind == "call" && expression.text == "move") return 9
    if (expression.kind == "call" && expression.text == "Shared") return 10
    if (expression.kind == "call" && expression.text == "Mutex") return 11
    if (expression.kind == "call" && expression.text == "Map") return 12
    if (expression.kind == "call" && expression.text == "Cell") return 13
    if (expression.kind == "call" && expression.text == "filledArray") return 14
    if (expression.kind == "call" && expression.text != "move" &&
        expression.text != "Shared" && expression.text != "Mutex" &&
        expression.text != "Cell" && expression.text != "filledArray" &&
        expression.text != "Map") return 15
    if (expression.kind == "compile") return 16
    if (expression.kind == "region") return 17
    if ((expression.kind == "task" || expression.kind == "thread") &&
        expression.children.size == 1) return 18
    if (expression.kind == "await" && expression.children.size == 1) return 19
    if (expression.kind == "generator" || expression.kind == "yield" ||
        expression.kind.startsWith("generator.")) return 20
    if (expression.kind == "string.template") return 21
    if (expression.kind == "block") return 22
    if (expression.kind == "defer") return 23
    if (expression.kind == "return") return 24
    if (expression.kind == "break" || expression.kind == "continue") return 25
    if (expression.kind == "local.val" ||
        expression.kind == "local.var") return 26
    if (expression.kind == "assign") return 27
    if (expression.kind == "delegate.project" &&
        expression.children.size == 1 &&
        expression.children[0].kind == "identifier") return 28
    if (expression.kind == "delegate.assign" &&
        expression.children.size == 2 &&
        expression.children[0].kind == "identifier") return 29
    if (expression.kind == "array") return 30
    if (expression.kind == "range.closed" ||
        expression.kind == "range.until") return 31
    if (expression.kind == "member") return 32
    if (expression.kind == "member.assign") return 33
    if (expression.kind == "index") return 34
    if (expression.kind == "index.assign") return 35
    if (expression.kind == "member.call") return 36
    if (expression.kind == "unary-" || expression.kind == "unary+") return 37
    if (expression.kind == "float") return 38
    if (expression.kind == "unary!") return 39
    if (expression.kind == "unary~") return 40
    if (expression.kind == "+" || expression.kind == "-" ||
        expression.kind == "*" || expression.kind == "/" ||
        expression.kind == "%") return 41
    if (expression.kind == "&" || expression.kind == "|" ||
        expression.kind == "^" || expression.kind == "<<" ||
        expression.kind == ">>" || expression.kind == ">>>") return 42
    if (expression.kind == "==" || expression.kind == "!=") return 43
    if (expression.kind == "<" || expression.kind == "<=" ||
        expression.kind == ">" || expression.kind == ">=") return 44
    if (expression.kind == "&&") return 45
    if (expression.kind == "||") return 46
    if (expression.kind == "if") return 47
    if (expression.kind == "when") return 48
    if (expression.kind == "while") return 49
    if (expression.kind == "do.while") return 50
    if (expression.kind == "for") return 51
    if (expression.kind == "call.value") return 52
    if (expression.kind == "bridge.value") return 53
    if (expression.kind == "as?") return 54
    if (expression.kind == "atomic" && expression.children.size == 1) return 56
    if (expression.kind == "stm.orElse" && expression.children.size == 2) return 57
    0
}

@noinline
fun bootstrapEvaluateInteger(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var value = 0
    var index = 0
    // The parser writes a literal's value in decimal; 9223372036854775808 (the
    // magnitude of the smallest integer) wraps to text with a leading `-`.
    val negative = expression.text.size > 0 && expression.text[0] == 45
    if (negative) index = 1
    while (index < expression.text.size) {
        val byte = expression.text[index]
        if (byte != 95) {
            value = if (negative) value * 10 - (byte - 48)
                else value * 10 + byte - 48
        }
        index = index + 1
    }
    result = bootstrapEvalInteger(value)
    result
}

@noinline
fun bootstrapEvaluateDeclarationBlock(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var sourceIdentity = ""
    if (expression.children.size == 1 &&
        expression.children[0].kind == "declaration.block.source") {
        sourceIdentity = expression.children[0].text
    }
    result = BootstrapEvalValue(
        "declaration.block",
        0,
        false,
        expression.text,
        [],
        sourceIdentity,
        []
    )
    result
}

@noinline
fun bootstrapEvaluateDelegateInitializer(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    result = bootstrapEvalDelegate(
        evaluator.evaluate(expression.children[0]),
        expression.text == "var"
    )
    result
}

@noinline
fun bootstrapEvaluateCallShared(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.children.size == 1) {
        result = bootstrapEvalShared(
            evaluator.evaluate(expression.children[0])
        )
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateCallMutex(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.children.size == 1) {
        result = bootstrapEvalShared(
            evaluator.evaluate(expression.children[0])
        )
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateCallMap(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    result = BootstrapEvalValue(
        "map", 0, false, "", [bootstrapEvalArray([]),
            bootstrapEvalArray([])], "", []
    )
    result
}

/** `TVar(value)` at compile time (the construction of abla/stm's TVar,
 *  whose instances are the runtime's): a box like a Cell's ("tvar"). `#` code runs
 *  transactions as plain code (bootstrapEvalStmWrite keeps what they undo). */
@noinline
fun bootstrapEvaluateCallTVar(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    if (expression.children.size != 1) {
        evaluator.errors = evaluator.errors + 1
        return bootstrapEvalInvalid()
    }
    BootstrapEvalValue(
        "tvar", 0, false, "", [evaluator.evaluate(expression.children[0])], "", []
    )
}

// The writes of the running compile-time transactions, oldest first: each
// TVar written and the value it held before (bootstrapEvalStmWrite), for an
// `orElse` (or a failed transaction) to put back.
var bootstrapEvalStmDepth = 0
val bootstrapEvalStmUndoTVars: array<BootstrapEvalValue> = []
val bootstrapEvalStmUndoValues: array<BootstrapEvalValue> = []

/** A TVar's write at compile time: in place, the old value kept while a
 *  transaction runs. */
fun bootstrapEvalStmWrite(var tvar: BootstrapEvalValue, value: BootstrapEvalValue): void {
    if (bootstrapEvalStmDepth > 0) {
        bootstrapEvalStmUndoTVars.append(tvar)
        bootstrapEvalStmUndoValues.append(tvar.elements[0])
    }
    tvar.elements[0] = value
    return
}

// The `orElse` first alternatives running, and whether a `retry` is leaving
// one: until its `orElse` takes it, nothing is evaluated (evaluate).
var bootstrapEvalStmOrElseDepth = 0
var bootstrapEvalStmRetrying = false

/** Calls the body (a closure of no parameters) of `atomic` or `orElse`. */
fun bootstrapEvalStmBody(
    var evaluator: BootstrapEvaluator,
    body: BootstrapExpression,
    at: BootstrapExpression
): BootstrapEvalValue {
    val closure = bootstrapEvalUnwrapBorrow(evaluator.evaluate(body))
    if (closure.kind != "closure") {
        evaluator.errors = evaluator.errors + 1
        return bootstrapEvalInvalid()
    }
    val none: array<BootstrapExpression> = []
    bootstrapEvaluateClosureCall(
        evaluator, BootstrapExpression("call", "", at.begin, at.end, none), closure, -1
    )
}

/** `atomic { … }` at compile time: plain code (no other thread runs), with
 *  each TVar write kept until the outermost transaction ends. */
@noinline
fun bootstrapEvaluateAtomic(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    bootstrapEvalStmDepth = bootstrapEvalStmDepth + 1
    val result = bootstrapEvalStmBody(evaluator, expression.children[0], expression)
    bootstrapEvalStmDepth = bootstrapEvalStmDepth - 1
    // The outermost one committed: nothing is left to put back.
    if (bootstrapEvalStmDepth == 0) {
        bootstrapEvalStmUndoTVars.truncate(0)
        bootstrapEvalStmUndoValues.truncate(0)
    }
    result
}

/** `a orElse b` at compile time: `a`, or, when it retries, `b` after `a`'s
 *  writes are put back. */
@noinline
fun bootstrapEvaluateOrElse(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    val mark = bootstrapEvalStmUndoTVars.size
    val errors = evaluator.errors
    val diagnostics = evaluator.diagnostics
    bootstrapEvalStmOrElseDepth = bootstrapEvalStmOrElseDepth + 1
    val first = bootstrapEvalStmBody(evaluator, expression.children[0], expression)
    bootstrapEvalStmOrElseDepth = bootstrapEvalStmOrElseDepth - 1
    if (!bootstrapEvalStmRetrying) return first
    // What the retried alternative left (values nothing used) is not an error.
    bootstrapEvalStmRetrying = false
    evaluator.errors = errors
    evaluator.diagnostics = diagnostics
    bootstrapEvalStmUndo(mark)
    bootstrapEvalStmBody(evaluator, expression.children[1], expression)
}

/** `retry` at compile time: the nearest `orElse` takes it; with none, nothing
 *  could ever change what the transaction read (as at run time, one thread). */
@noinline
fun bootstrapEvaluateRetry(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    if (bootstrapEvalStmDepth > 0 && bootstrapEvalStmOrElseDepth > 0) {
        bootstrapEvalStmRetrying = true
        return bootstrapEvalInvalid()
    }
    if (bootstrapEvalStmDepth == 0) {
        return bootstrapEvalRuntimePanic(
            evaluator, "E_CT_PANIC", "retry outside a transaction", expression
        )
    }
    bootstrapEvalRuntimePanic(
        evaluator, "E_CT_PANIC",
        "retry can never wake: no other thread can change what the transaction read",
        expression
    )
}

/** Puts back the compile-time TVar writes after the first `mark`, newest first. */
fun bootstrapEvalStmUndo(mark: int): void {
    var index = bootstrapEvalStmUndoTVars.size - 1
    while (index >= mark) {
        var tvar = bootstrapEvalStmUndoTVars[index]
        tvar.elements[0] = bootstrapEvalStmUndoValues[index]
        index = index - 1
    }
    bootstrapEvalStmUndoTVars.truncate(mark)
    bootstrapEvalStmUndoValues.truncate(mark)
    return
}

@noinline
fun bootstrapEvaluateCallCell(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.children.size == 1) {
        result = bootstrapEvalCell(
            evaluator.evaluate(expression.children[0])
        )
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

// A generator is a state machine (generator.ab, generator_eval.ab).
@noinline
fun bootstrapEvaluateGenerator(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    bootstrapEvaluateGeneratorNode(evaluator, expression)
}

@noinline
fun bootstrapEvaluateReturn(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var value = bootstrapEvalVoid()
    if (expression.children.size > 0 &&
        expression.children[0].kind != "missing") {
        value = evaluator.evaluate(expression.children[0])
    }
    result = bootstrapEvalReturn(value)
    result
}

@noinline
fun bootstrapEvaluateNot(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val value = evaluator.evaluate(expression.children[0])
    result = bootstrapEvalBoolean(!value.boolean)
    result
}

@noinline
fun bootstrapEvaluateComplement(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val value = evaluator.evaluate(expression.children[0])
    result = bootstrapEvalScalar(bitNot(value.integer), value.owner, value.text)
    result
}

@noinline
fun bootstrapEvaluateLambda(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var family = "fn"
    if (expression.kind == "lambda.move") family = "once"
    if (expression.kind == "lambda" &&
        evaluator.lambdaRequiresMutableCall(expression)) family = "mut"
    val bound: array<string> = []
    var parameter = 0
    while (parameter + 1 < expression.children.size) {
        bound.append(expression.children[parameter].text)
        parameter = parameter + 1
    }
    val body = expression.children[expression.children.size - 1]
    val free: array<string> = []
    evaluator.collectLambdaFreeNames(body, bound, free)
    val captureNames: array<string> = []
    val captureValues: array<BootstrapEvalValue> = []
    var capture = 0
    while (capture < free.size) {
        var name = free[capture]
        var found = evaluator.find(name)
        // A field read inside a method's lambda captures the receiver, as
        // lowering does.
        if (found < 0 && evaluator.receiverHasField(name)) {
            name = "this"
            found = evaluator.find(name)
        }
        if (found >= 0 &&
            !evaluator.nameIsBound(captureNames, name)) {
            var value = evaluator.values[found]
            captureNames.append(name)
            // A move closure takes an affine value out of a generator's
            // slot, as lowering does.
            if (expression.kind == "lambda.move" && value.kind == "slot" &&
                value.elements.size == 1 && evaluator.valueIsAffine(value.elements[0])) {
                val content = value.elements[0]
                value.elements[0] = evaluator.uninitializedValue()
                captureValues.append(content)
                capture = capture + 1
                continue
            }
            // The receiver binding never changes: it is captured as is.
            if (name != "this" && !(expression.kind == "lambda.move" &&
                  evaluator.valueIsAffine(value))) {
                if (value.kind != "slot") {
                    value = bootstrapEvalSlot(value)
                    evaluator.values[found] = value
                }
            }
            captureValues.append(value)
            if (expression.kind == "lambda.move" &&
                evaluator.valueIsAffine(value)) {
                evaluator.values[found] = evaluator.uninitializedValue()
            }
        }
        capture = capture + 1
    }
    val handle = evaluator.syntax.size
    evaluator.syntax.append(expression)
    result = bootstrapEvalClosure(
        handle,
        family,
        captureValues,
        captureNames
    )
    result
}

@noinline
fun bootstrapEvaluateIdentifier(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val found = evaluator.find(expression.text)
    if (found >= 0) {
        result = evaluator.values[found]
        if (result.kind == "slot" && result.elements.size == 1) {
            result = result.elements[0]
        }
        if (result.kind == "uninitialized") {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
        evaluator.errors = evaluator.errors
    }
    else {
        val receiverIndex = evaluator.find("this")
        // A closure made in a method holds its receiver in a cell.
        val receiverValue = if (receiverIndex < 0) bootstrapEvalInvalid()
            else if (evaluator.values[receiverIndex].kind == "slot")
                evaluator.values[receiverIndex].elements[0]
            else evaluator.values[receiverIndex]
        if (receiverValue.kind == "object") {
            val receiver = receiverValue
            var field = 0
            while (field < receiver.fieldNames.size) {
                if (receiver.fieldNames[field] == expression.text) {
                    result = receiver.elements[field]
                }
                field = field + 1
            }
        }
        var declarationIndexNode = evaluator.firstNamed(expression.text)
        while (result.kind == "invalid" &&
               declarationIndexNode >= 0) {
            val declarationIndex = evaluator.namedDeclaration(declarationIndexNode)
            val declaration = evaluator.declarations[declarationIndex]
            if (bootstrapDeclarationIsValue(declaration.kind) &&
                declaration.name == expression.text) {
                if (declaration.expression.kind ==
                    "delegate.initializer") {
                    result = evaluator.delegatedSlot(expression.text)
                } else if (declaration.kind == "compile.val" ||
                    declaration.kind == "compile.var") {
                    result = evaluator.compileGlobal(declaration)
                } else result = bootstrapRuntimeGlobal(evaluator, declaration)
            }
            // A plain name is never an extension function (`Cell.store` is
            // reached through its receiver): a global of that name wins.
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner == "" &&
                declaration.name == expression.text) {
                result = bootstrapEvalFunction(declaration.name)
            }
            declarationIndexNode = evaluator.nextNamed(declarationIndexNode)
        }
        // `retry`, where nothing else has the name: a transaction's.
        if (result.kind == "invalid" && expression.text == "retry") {
            return bootstrapEvaluateRetry(evaluator, expression)
        }
        if (result.kind == "invalid") {
            evaluator.errors = evaluator.errors + 1
        } else evaluator.errors = evaluator.errors
    }
    if (result.kind == "delegate" &&
        result.elements.size == 1) {
        result = evaluator.invokeDelegateMethod(
            result.elements[0],
            "getValue",
            bootstrapEvalInvalid(),
            false,
            expression.begin,
            expression.end
        )
    }
    result
}

@noinline
fun bootstrapEvaluateMove(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (expression.children.size == 1 &&
        expression.children[0].kind == "identifier") {
        val found = evaluator.find(expression.children[0].text)
        if (found >= 0 && evaluator.values[found].kind == "slot" &&
            evaluator.values[found].elements.size == 1) {
            // A captured binding: what moves is its value, and an affine
            // value leaves the cell (a generator's slot) empty.
            val cell = evaluator.values[found]
            result = cell.elements[0]
            if (evaluator.valueIsAffine(result)) {
                cell.elements[0] = evaluator.uninitializedValue()
            }
            if (result.kind == "uninitialized") {
                evaluator.errors = evaluator.errors + 1
                result = bootstrapEvalInvalid()
            }
        } else if (found >= 0 && evaluator.values[found].kind != "uninitialized") {
            result = evaluator.values[found]
            evaluator.values[found] = evaluator.uninitializedValue()
            bootstrapSemanticUnit()
        } else {
            evaluator.errors = evaluator.errors + 1
            bootstrapSemanticUnit()
        }
        bootstrapSemanticUnit()
    } else if (expression.children.size == 1 &&
        (expression.children[0].kind == "member" ||
         expression.children[0].kind == "index")) {
        val place = expression.children[0]
        if (place.kind == "member") {
            val receiver = evaluator.evaluate(place.children[0])
            var field = 0
            while (field < receiver.fieldNames.size) {
                if (receiver.fieldNames[field] == place.text) {
                    result = receiver.elements[field]
                    receiver.elements[field] = evaluator.uninitializedValue()
                }
                field = field + 1
            }
        } else {
            val receiver = evaluator.evaluate(place.children[0])
            val index = evaluator.evaluate(place.children[1]).integer
            if (receiver.kind == "array" && index >= 0 &&
                index < receiver.elements.size) {
                result = receiver.elements[index]
                receiver.elements[index] = evaluator.uninitializedValue()
                bootstrapSemanticUnit()
            } else {
                evaluator.errors = evaluator.errors + 1
                bootstrapSemanticUnit()
            }
        }
        if (result.kind == "uninitialized") {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
            bootstrapSemanticUnit()
        }
        bootstrapSemanticUnit()
    } else {
        evaluator.errors = evaluator.errors + 1
        bootstrapSemanticUnit()
    }
    result
}

@noinline
fun bootstrapEvaluateFilledArray(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val count = if (expression.children.size == 2) {
        evaluator.evaluate(expression.children[0])
    } else bootstrapEvalInvalid()
    if (count.kind == "integer" && count.integer >= 0) {
        val value = evaluator.evaluate(expression.children[1])
        val elements: array<BootstrapEvalValue> = []
        var index = 0
        while (index < count.integer) {
            elements.append(value)
            index = index + 1
        }
        result = bootstrapEvalArray(elements)
    } else if (count.kind == "integer") {
        result = bootstrapEvalRuntimePanic(
            evaluator, "E_EVAL_OUT_OF_BOUNDS",
            bootstrapEvalFilledPanicText(count.integer), expression
        )
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateTask(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val closure = evaluator.evaluate(BootstrapExpression(
        "lambda.move",
        "",
        expression.begin,
        expression.end,
        [expression.children[0]]
    ))
    result = BootstrapEvalValue(
        expression.kind, 0, false, "", [closure], "", []
    )
    result
}

@noinline
fun bootstrapEvaluateAwait(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val operation = evaluator.evaluate(expression.children[0])
    if ((operation.kind == "task" || operation.kind == "thread") &&
        operation.elements.size == 1 &&
        operation.elements[0].kind != "uninitialized") {
        val name = "await_${expression.begin}_${evaluator.steps}"
        evaluator.names.append(name)
        evaluator.values.append(operation.elements[0])
        evaluator.mutable.append(false)
        result = evaluator.evaluate(BootstrapExpression(
            "call", name, expression.begin, expression.end, []
        ))
        operation.elements[0] = evaluator.uninitializedValue()
        evaluator.values[evaluator.values.size - 1] = evaluator.uninitializedValue()
        evaluator.names[evaluator.names.size - 1] = ""
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateTemplate(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var text = ""
    var part = 0
    while (part < expression.children.size) {
        text = "$text${evaluator.printable(evaluator.evaluate(
            expression.children[part]
        ))}"
        part = part + 1
    }
    result = bootstrapEvalString(text)
    result
}

@noinline
fun bootstrapEvaluateBlock(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    val scopeBegin = evaluator.names.size
    val deferred: array<string> = []
    var result = BootstrapEvalValue("void", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
    var assigned = false
    var statement = 0
    while (statement < expression.children.size &&
           result.kind != "return" && result.kind != "break" &&
           result.kind != "continue" && result.kind != "goto") {
        val current = expression.children[statement]
        if (current.kind == "defer" && current.children.size == 1) {
            result = bootstrapEvalDeferStatement(evaluator, current, deferred)
        } else result = evaluator.evaluate(current)
        if (statement + 1 < expression.children.size) {
            bootstrapEvalDropDiscarded(evaluator, current, result)
        }
        assigned = current.kind == "assign" || current.kind == "member.assign" ||
            current.kind == "index.assign"
        statement = statement + 1
    }
    // A trailing assignment hands nothing on: the assigned local is dropped
    // with the block, as at run time.
    bootstrapEvalCloseScope(
        evaluator, expression, scopeBegin, deferred,
        if (assigned) bootstrapEvalVoid() else result
    )
    result
}

/** A discarded value (sema.ab, bootstrapExpressionYieldsFreshValue) that is
 *  a resource nothing else holds is dropped where it is discarded, as
 *  lowering drops it (ir.ab, dropDiscarded). */
fun bootstrapEvalDropDiscarded(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    value: BootstrapEvalValue
): void {
    if (value.kind != "object" && value.kind != "shared") return
    if (bootstrapExpressionYieldsFreshValue(expression) && evaluator.valueIsAffine(value)) {
        var discarded = value
        evaluator.dropValue(discarded)
    }
    return
}

/** A block's `defer`: its body becomes a closure the block calls on exit. */
@noinline
fun bootstrapEvalDeferStatement(
    var evaluator: BootstrapEvaluator,
    current: BootstrapExpression,
    var deferred: array<string>
): BootstrapEvalValue {
    val name = "defer_${current.begin}_${deferred.size}"
    val closure = evaluator.evaluate(BootstrapExpression(
        "lambda.move",
        "",
        current.begin,
        current.end,
        [current.children[0]]
    ))
    evaluator.names.append(name)
    evaluator.values.append(closure)
    evaluator.mutable.append(false)
    deferred.append(name)
    bootstrapEvalVoid()
}

/** A block ends: its deferred closures run, last first, and its locals are
 *  dropped, except an affine value it hands on. */
@noinline
fun bootstrapEvalCloseScope(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    scopeBegin: int,
    deferred: array<string>,
    result: BootstrapEvalValue
): void {
    var deferredIndex = deferred.size
    while (deferredIndex > 0) {
        deferredIndex = deferredIndex - 1
        evaluator.evaluate(BootstrapExpression(
            "call",
            deferred[deferredIndex],
            expression.end,
            expression.end,
            []
        ))
    }
    var transferred = result
    if (result.kind == "return" && result.elements.size == 1) {
        transferred = result.elements[0]
    }
    var local = evaluator.names.size
    while (local > scopeBegin) {
        local = local - 1
        val value = evaluator.values[local]
        if (value.kind != "uninitialized" && value == transferred &&
            evaluator.valueIsAffine(value)) {
            evaluator.values[local] = evaluator.uninitializedValue()
            bootstrapSemanticUnit()
        } else if (value.kind != "uninitialized") {
            evaluator.dropValue(value)
            evaluator.values[local] = evaluator.uninitializedValue()
            bootstrapSemanticUnit()
        }
        evaluator.names[local] = ""
    }
    // The block's slots go, so a loop that declares a local doesn't leave
    // one behind per iteration for every later lookup to scan past.
    if (evaluator.names.size > scopeBegin) {
        evaluator.names.truncate(scopeBegin)
        evaluator.values.truncate(scopeBegin)
        evaluator.mutable.truncate(scopeBegin)
    }
}

@noinline
fun bootstrapEvaluateLocal(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var value = BootstrapEvalValue(
        "uninitialized",
        0,
        false,
        "",
        BOOTSTRAP_EVAL_NO_ELEMENTS,
        "",
        BOOTSTRAP_EVAL_NO_FIELDS
    )
    if (expression.children[0].kind != "missing") {
        value = evaluator.evaluate(expression.children[0])
    }
    if (expression.children.size > 1 &&
        expression.children[1].text != "inferred") {
        value = bootstrapEvalCoerce(evaluator, value, expression.children[1].text)
    }
    evaluator.names.append(expression.text)
    evaluator.values.append(value)
    evaluator.mutable.append(expression.kind == "local.var")
    result = BootstrapEvalValue("void", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
    // An initializer that left its expression leaves the block too.
    if (bootstrapEvalFirstEscape([value]) == 0) result = value
    result
}

@noinline
fun bootstrapEvaluateAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    // In a method, assigning a field's name assigns the field, whatever global
    // shares the name.
    val field = expression.kind == "assign" && evaluator.find(expression.text) < 0 &&
        bootstrapEvalReceiverHasField(evaluator, expression.text)
    if (expression.kind == "assign" && evaluator.find(expression.text) < 0 && !field &&
        evaluator.compileVar(expression.text) >= 0 &&
        evaluator.declarations[evaluator.compileVar(expression.text)].expression.kind !=
            "delegate.initializer") {
        // A `compile var` takes the new value for the rest of the compilation.
        val declaration = evaluator.declarations[evaluator.compileVar(expression.text)]
        val key = bootstrapCompileGlobalKey(declaration)
        val value = evaluator.evaluate(expression.children[0])
        var slot = -1
        var index = 0
        while (index < evaluator.globalKeys.size) {
            if (evaluator.globalKeys[index] == key) slot = index
            index = index + 1
        }
        if (slot >= 0) evaluator.globalValues[slot] = value
        else {
            evaluator.globalKeys.append(key)
            evaluator.globalValues.append(value)
        }
        result = value
    } else if (expression.kind == "assign" && evaluator.find(expression.text) < 0 &&
        !field && evaluator.delegatedSlot(expression.text).kind != "delegate" &&
        bootstrapRuntimeVar(evaluator, expression.text) >= 0) {
        // A program `var` assigned by compile-time code: its value for the rest
        // of the compilation (bootstrapRuntimeGlobal).
        val declaration =
            evaluator.declarations[bootstrapRuntimeVar(evaluator, expression.text)]
        val key = bootstrapRuntimeGlobalKey(declaration)
        val value = evaluator.evaluate(expression.children[0])
        var slot = -1
        var index = 0
        while (index < evaluator.globalKeys.size) {
            if (evaluator.globalKeys[index] == key) slot = index
            index = index + 1
        }
        if (slot >= 0) evaluator.globalValues[slot] = value
        else {
            evaluator.globalKeys.append(key)
            evaluator.globalValues.append(value)
        }
        result = value
    } else if (expression.kind == "assign") {
        var found = evaluator.find(expression.text)
        // A top-level delegate is assigned through its one slot, never bound
        // as a local here: leaving this scope would drop the shared delegate.
        var global = bootstrapEvalInvalid()
        if (found < 0 && !field) global = evaluator.delegatedSlot(expression.text)
        val value = evaluator.evaluate(expression.children[0])
        var slot = bootstrapEvalInvalid()
        if (found >= 0) slot = evaluator.values[found]
        else if (global.kind == "delegate") slot = global
        if (slot.kind == "slot" && slot.elements.size == 1) {
            slot = slot.elements[0]
        }
        if (slot.kind == "delegate" && slot.elements.size == 1) {
            if (slot.boolean) {
                evaluator.invokeDelegateMethod(
                    slot.elements[0],
                    "setValue",
                    value,
                    true,
                    expression.begin,
                    expression.end
                )
                result = value
            } else {
                evaluator.errors = evaluator.errors + 1
                result = value
            }
        } else if (found >= 0 && evaluator.mutable[found]) {
            if (evaluator.values[found].kind == "slot" &&
                evaluator.values[found].elements.size == 1) {
                val cell = evaluator.values[found]
                if (cell.elements[0].kind != "uninitialized") {
                    evaluator.dropValue(cell.elements[0])
                }
                cell.elements[0] = value
            } else {
                if (evaluator.values[found].kind != "uninitialized") {
                    val previous = evaluator.values[found]
                    evaluator.dropValue(previous)
                }
                evaluator.values[found] = value
            }
            result = value
        } else {
            var fieldAssigned = false
            val receiverIndex = evaluator.find("this")
            if (receiverIndex >= 0 &&
                evaluator.values[receiverIndex].kind == "object") {
                val receiver = evaluator.values[receiverIndex]
                var field = 0
                while (field < receiver.fieldNames.size) {
                    if (receiver.fieldNames[field] == expression.text) {
                        if (receiver.elements[field].kind !=
                            "uninitialized") {
                            evaluator.dropValue(receiver.elements[field])
                        }
                        receiver.elements[field] = value
                        fieldAssigned = true
                    }
                    field = field + 1
                }
            }
            if (!fieldAssigned) evaluator.errors = evaluator.errors + 1
            result = value
        }
    }
    result
}

@noinline
fun bootstrapEvaluateDelegateProject(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val slot = evaluator.delegatedSlot(expression.children[0].text)
    if (slot.kind == "delegate" && slot.elements.size == 1) {
        result = slot.elements[0]
    } else {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateDelegateAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val slot = evaluator.delegatedSlot(expression.children[0].text)
    val value = evaluator.evaluate(expression.children[1])
    if (slot.kind == "delegate" && slot.elements.size == 1 &&
        slot.boolean) {
        if (slot.elements[0].kind != "uninitialized") {
            evaluator.dropValue(slot.elements[0])
        }
        slot.elements[0] = value
        result = value
    } else {
        evaluator.errors = evaluator.errors + 1
        result = value
    }
    result
}

@noinline
fun bootstrapEvaluateArrayLiteral(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val elements: array<BootstrapEvalValue> = []
    var element = 0
    while (element < expression.children.size) {
        elements.append(evaluator.evaluate(expression.children[element]))
        element = element + 1
    }
    result = bootstrapEvalArray(elements)
    result
}

@noinline
fun bootstrapEvaluateRange(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val begin = evaluator.evaluate(expression.children[0]).integer
    val end = evaluator.evaluate(expression.children[1]).integer
    val elements: array<BootstrapEvalValue> = []
    var current = begin
    var more = current < end
    if (expression.kind == "range.closed") more = current <= end
    while (more && evaluator.steps <= evaluator.context.stepLimit) {
        elements.append(bootstrapEvalInteger(current))
        current = current + 1
        more = current < end
        if (expression.kind == "range.closed") more = current <= end
        evaluator.steps = evaluator.steps + 1
    }
    result = bootstrapEvalArray(elements)
    result
}

@noinline
fun bootstrapEvaluateMember(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val rawReceiver = evaluator.evaluate(expression.children[0])
    val receiver = bootstrapEvalUnwrapBorrow(rawReceiver)
    // An object's own field named `size` (FileInfo.size) is a field read.
    if (expression.text == "size" && receiver.kind != "object") {
        if (receiver.kind == "string") {
            result = bootstrapEvalInteger(receiver.text.size)
        } else if (receiver.kind == "array") {
            result = bootstrapEvalInteger(receiver.elements.size)
        } else if (receiver.kind == "map") {
            result = bootstrapEvalInteger(
                receiver.elements[0].elements.size
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            result = result
        }
    } else if (receiver.kind == "object") {
        result = evaluator.objectField(receiver, expression.text)
    } else result = result
    if (rawReceiver.kind == "borrow" &&
        bootstrapEvalValueNeedsBorrow(result)) {
        result = bootstrapEvalBorrow(result)
    }
    result
}

/** The value a mutation goes through (the receiver of `append`, `clear`, a
 *  map's `set`, an element or a field assignment): along a member chain, an
 *  extension field the object doesn't have takes its default, stored, so
 *  the mutation stays (as compiled code does at sema's mutation places). */
fun bootstrapEvaluatePlace(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    if (expression.kind != "member" || expression.children.size != 1 ||
        expression.text == "size") return evaluator.evaluate(expression)
    val rawReceiver = bootstrapEvaluatePlace(evaluator, expression.children[0])
    val receiver = bootstrapEvalUnwrapBorrow(rawReceiver)
    var result = bootstrapEvalInvalid()
    if (receiver.kind == "object") {
        var held = false
        for (field in receiver.fieldNames) {
            if (field == expression.text) held = true
        }
        result = evaluator.objectField(receiver, expression.text)
        if (!held && result.kind != "invalid") {
            receiver.fieldNames.append(expression.text)
            receiver.elements.append(result)
        }
    }
    if (rawReceiver.kind == "borrow" &&
        bootstrapEvalValueNeedsBorrow(result)) {
        result = bootstrapEvalBorrow(result)
    }
    result
}

@noinline
fun bootstrapEvaluateMemberAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val receiver = bootstrapEvalUnwrapBorrow(
        bootstrapEvaluatePlace(evaluator, expression.children[0])
    )
    val value = evaluator.evaluate(expression.children[1])
    var assigned = false
    var field = 0
    while (field < receiver.fieldNames.size) {
        if (receiver.fieldNames[field] == expression.text) {
            if (evaluator.extensionFieldIsValue(receiver.owner, expression.text)) {
                return bootstrapEvalRuntimePanic(
                    evaluator, "E_EVAL_EXTENSION_REASSIGNED",
                    "field.extension-reassigned:${receiver.owner}.${expression.text}",
                    expression
                )
            }
            if (receiver.elements[field].kind != "uninitialized") {
                evaluator.dropValue(receiver.elements[field])
            }
            receiver.elements[field] = value
            assigned = true
        }
        field = field + 1
    }
    // An extension field the object doesn't hold yet.
    if (!assigned && receiver.kind == "object" &&
        evaluator.extensionFieldDefaultDeclaration(receiver.owner, expression.text) >= 0) {
        receiver.fieldNames.append(expression.text)
        receiver.elements.append(value)
        assigned = true
    }
    if (!assigned) evaluator.errors = evaluator.errors + 1
    result = value
    result
}

@noinline
fun bootstrapEvaluateIndex(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val rawReceiver = evaluator.evaluate(expression.children[0])
    val receiver = bootstrapEvalUnwrapBorrow(rawReceiver)
    val index = evaluator.evaluate(expression.children[1]).integer
    if (receiver.kind == "string" && index >= 0 &&
        index < receiver.text.size) {
        result = bootstrapEvalInteger(receiver.text[index])
    } else if (receiver.kind == "array" && index >= 0 &&
        index < receiver.elements.size) {
        result = receiver.elements[index]
    } else if (receiver.kind == "string" || receiver.kind == "array") {
        result = bootstrapEvalRuntimePanic(
            evaluator, "E_EVAL_OUT_OF_BOUNDS",
            bootstrapEvalIndexPanicText(
                index,
                if (receiver.kind == "string") receiver.text.size
                else receiver.elements.size,
                receiver.kind
            ),
            expression
        )
    } else {
        evaluator.errors = evaluator.errors + 1
        result = result
    }
    if (rawReceiver.kind == "borrow" &&
        bootstrapEvalValueNeedsBorrow(result)) {
        result = bootstrapEvalBorrow(result)
    }
    result
}

@noinline
fun bootstrapEvaluateIndexAssign(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val receiver = bootstrapEvalUnwrapBorrow(
        bootstrapEvaluatePlace(evaluator, expression.children[0])
    )
    val index = evaluator.evaluate(expression.children[1]).integer
    val value = evaluator.evaluate(expression.children[2])
    if (receiver.kind == "array" && index >= 0 &&
        index < receiver.elements.size) {
        if (receiver.elements[index].kind != "uninitialized") {
            evaluator.dropValue(receiver.elements[index])
        }
        receiver.elements[index] = value
        result = value
    } else if (receiver.kind == "array") {
        bootstrapEvalRuntimePanic(
            evaluator, "E_EVAL_OUT_OF_BOUNDS",
            bootstrapEvalIndexPanicText(index, receiver.elements.size, "array"),
            expression
        )
        result = value
    } else {
        evaluator.errors = evaluator.errors + 1
        result = value
    }
    result
}

@noinline
fun bootstrapEvaluateMemberCall(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    // A mutating built-in (an array's append, truncate and clear; a map's set,
    // remove, clear and take) goes through its receiver as a place.
    val mutates = expression.text == "append" || expression.text == "truncate" ||
        expression.text == "clear" || expression.text == "set" ||
        expression.text == "remove" || expression.text == "take"
    val receiver = bootstrapEvalUnwrapBorrow(
        if (mutates) bootstrapEvaluatePlace(evaluator, expression.children[0])
        else evaluator.evaluate(expression.children[0])
    )
    val pathProvider = ctNativePathProvider(evaluator, receiver, expression.text)
    if (pathProvider >= 0) {
        result = ctNativeEvaluatePathMethod(
            evaluator, receiver, expression.text, expression.children, 1, pathProvider
        )
    } else if (receiver.kind == "cell" || receiver.kind == "shared" ||
        receiver.kind == "weak" || receiver.kind == "tvar") {
        result = bootstrapEvaluateReferenceMethod(evaluator, expression, receiver)
    } else if (receiver.kind == "map" &&
               bootstrapIsMapBuiltinMethod(expression.text)) {
        result = evaluator.evaluateMapCall(receiver, expression)
    } else if (expression.text == "append" &&
        receiver.kind == "array" &&
        expression.children.size == 2) {
        receiver.elements.append(evaluator.evaluate(expression.children[1]))
        result = BootstrapEvalValue(
            "void", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS
        )
    } else if ((expression.text == "truncate" ||
                expression.text == "clear") &&
        receiver.kind == "array") {
        val count = if (expression.text == "clear") 0
            else evaluator.evaluate(expression.children[1]).integer
        if (count < 0) {
            result = bootstrapEvalRuntimePanic(
                evaluator, "E_EVAL_OUT_OF_BOUNDS",
                bootstrapEvalTruncatePanicText(count), expression
            )
        } else {
            // At or past the size, nothing changes.
            if (count < receiver.elements.size) receiver.elements.truncate(count)
            result = BootstrapEvalValue(
                "void", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS
            )
        }
    } else if (expression.text == "slice" &&
        receiver.kind == "string" &&
        expression.children.size == 3) {
        val begin = evaluator.evaluate(expression.children[1]).integer
        val end = evaluator.evaluate(expression.children[2]).integer
        result = if (begin < 0 || end < begin || end > receiver.text.size) {
            bootstrapEvalRuntimePanic(
                evaluator, "E_EVAL_OUT_OF_BOUNDS",
                bootstrapEvalSlicePanicText(begin, end, receiver.text.size),
                expression
            )
        } else bootstrapEvalString(receiver.text.slice(begin, end))
    } else if (receiver.kind == "object" &&
               bootstrapEvalFieldCallable(evaluator, receiver, expression.text).kind != "invalid") {
        // `holder.callback(4)` with no method `callback`: the field's value.
        result = bootstrapEvalCallValueWith(
            evaluator, expression,
            bootstrapEvalFieldCallable(evaluator, receiver, expression.text)
        )
    } else if (receiver.kind == "object" ||
               receiver.kind == "string" ||
               receiver.kind == "integer" ||
               receiver.kind == "boolean" ||
               // An extension of `array<T>` or `Map<K, V>`.
               receiver.kind == "array" ||
               receiver.kind == "map") {
        result = evaluator.evaluateMethod(receiver, expression)
    } else result = result
    result
}

/** The value of `receiver`'s field `name` when `receiver.name(...)` calls it:
 *  the receiver's type has no method `name`, and the field holds a function.
 *  Invalid otherwise. */
fun bootstrapEvalFieldCallable(
    evaluator: BootstrapEvaluator,
    receiver: BootstrapEvalValue,
    name: string
): BootstrapEvalValue {
    var field = -1
    var index = 0
    while (index < receiver.fieldNames.size && index < receiver.elements.size) {
        if (receiver.fieldNames[index] == name) field = index
        index = index + 1
    }
    if (field < 0) return bootstrapEvalInvalid()
    val value = receiver.elements[field]
    if (value.kind != "closure" && value.kind != "function") return bootstrapEvalInvalid()
    for (declaration in evaluator.declarations) {
        if (declaration.kind == "class" && declaration.name == receiver.owner) {
            for (method in declaration.methods) {
                if (method.name == name) return bootstrapEvalInvalid()
            }
        }
        if ((declaration.kind == "fun" || declaration.kind == "compile.fun") &&
            declaration.name == name && declaration.extensionOwner != "" &&
            bootstrapNormalizeType(declaration.extensionOwner) ==
                bootstrapNormalizeType(receiver.owner)) return bootstrapEvalInvalid()
    }
    value
}

/** A call of a value (`f(1)(2)`, `handlers[0]()`): the callee, then the
 *  arguments, as a call of a closure or of a named function. */
@noinline
fun bootstrapEvaluateCallValue(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    val callee = bootstrapEvalUnwrapBorrow(evaluator.evaluate(expression.children[0]))
    bootstrapEvalCallValueWith(evaluator, expression, callee)
}

/** Calls `callee` with the arguments of `expression` (its children after the
 *  first: the callee or the receiver). */
@noinline
fun bootstrapEvalCallValueWith(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    callee: BootstrapEvalValue
): BootstrapEvalValue {
    val arguments: array<BootstrapExpression> = []
    var argument = 1
    while (argument < expression.children.size) {
        arguments.append(expression.children[argument])
        argument = argument + 1
    }
    var result = bootstrapEvalInvalid()
    if (callee.kind == "closure") {
        result = bootstrapEvaluateClosureCall(
            evaluator,
            BootstrapExpression("call", "", expression.begin, expression.end, arguments),
            callee,
            -1
        )
    } else if (callee.kind == "function") {
        result = evaluator.evaluate(BootstrapExpression(
            "call", callee.text, expression.begin, expression.end, arguments
        ))
    }
    if (result.kind == "invalid") evaluator.errors = evaluator.errors + 1
    result
}

/** `get`/`set` of a Cell, `with`/`clone`/`get`/`downgrade` of a Shared and
 *  `clone`/`upgrade`/`isAlive` of a weak reference. */
@noinline
fun bootstrapEvaluateReferenceMethod(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    var receiver: BootstrapEvalValue
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    if (receiver.kind == "tvar" && expression.text == "getValue" &&
        expression.children.size == 1) {
        result = receiver.elements[0]
    } else if (receiver.kind == "tvar" && expression.text == "setValue" &&
        expression.children.size == 2) {
        bootstrapEvalStmWrite(receiver, evaluator.evaluate(expression.children[1]))
        result = bootstrapEvalVoid()
    } else if (receiver.kind == "cell" && expression.text == "get" &&
        expression.children.size == 1) {
        result = receiver.elements[0]
    } else if (receiver.kind == "cell" &&
               expression.text == "set" &&
               expression.children.size == 2) {
        receiver.elements[0] = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalVoid()
    } else if (receiver.kind == "shared" && expression.text == "with" &&
        expression.children.size == 2 &&
        expression.children[1].kind == "identifier") {
        val temporary = "__mutex_payload_${evaluator.steps}"
        evaluator.names.append(temporary)
        evaluator.values.append(receiver.elements[0].elements[0])
        evaluator.mutable.append(false)
        result = evaluator.evaluateCall(BootstrapExpression(
            "call",
            expression.children[1].text,
            expression.begin,
            expression.end,
            [BootstrapExpression(
                "identifier",
                temporary,
                expression.begin,
                expression.end,
                []
            )]
        ))
        evaluator.values[evaluator.values.size - 1] = evaluator.uninitializedValue()
        evaluator.names[evaluator.names.size - 1] = ""
    } else if (receiver.kind == "shared" &&
        expression.text == "clone" &&
        expression.children.size == 1) {
        result = bootstrapEvalSharedClone(receiver)
    } else if (receiver.kind == "shared" &&
               expression.text == "get" &&
               expression.children.size == 1) {
        result = bootstrapEvalSharedGet(receiver)
    } else if (receiver.kind == "shared" &&
               expression.text == "downgrade" &&
               expression.children.size == 1) {
        result = bootstrapEvalWeak(receiver)
    } else if (receiver.kind == "weak" &&
               expression.text == "clone" &&
               expression.children.size == 1) {
        result = bootstrapEvalWeakClone(receiver)
    } else if (receiver.kind == "weak" &&
               expression.text == "upgrade" &&
               expression.children.size == 1) {
        result = bootstrapEvalWeakUpgrade(receiver)
    } else if (receiver.kind == "weak" &&
               expression.text == "isAlive" &&
               expression.children.size == 1) {
        result = bootstrapEvalBoolean(
            receiver.elements[0].elements[1].integer > 0
        )
    }
    result
}


@noinline
fun bootstrapEvaluateNegate(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val value = evaluator.evaluate(expression.children[0])
    var integer = value.integer
    if (expression.kind == "unary-") integer = -integer
    result = if (value.kind == "f64") {
        if (expression.kind == "unary-") {
            bootstrapEvalF64(-bootstrapEvalAsF64(value))
        } else value
    } else if (value.kind == "f32") {
        if (expression.kind == "unary-") {
            bootstrapEvalF32(-bootstrapEvalAsF32(value))
        } else value
    } else bootstrapEvalScalar(integer, value.owner, value.text)
    result
}

@noinline
fun bootstrapEvaluateArithmetic(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    // A view (a field read through Shared.get(), say) operates as its value.
    val leftValue = bootstrapEvalUnwrapBorrow(
        evaluator.evaluate(expression.children[0])
    )
    val rightValue = bootstrapEvalUnwrapBorrow(
        evaluator.evaluate(expression.children[1])
    )
    result = if (expression.kind == "+" && leftValue.kind == "string" &&
        rightValue.kind == "string") {
        bootstrapEvalString("${leftValue.text}${rightValue.text}")
    } else if (leftValue.kind == "f64" && rightValue.kind == "f64") {
        bootstrapEvalF64(bootstrapEvalF64Arithmetic(
            expression.kind,
            bootstrapEvalAsF64(leftValue),
            bootstrapEvalAsF64(rightValue)
        ))
    } else if (leftValue.kind == "f32" && rightValue.kind == "f32") {
        bootstrapEvalF32(bootstrapEvalF32Arithmetic(
            expression.kind,
            bootstrapEvalAsF32(leftValue),
            bootstrapEvalAsF32(rightValue)
        ))
    } else {
        // Float payloads are IEEE bits, not integers. In particular a
        // floating zero must never reach an integer division first.
        val width = bootstrapEvalOperationWidth(leftValue.owner, rightValue.owner)
        if ((expression.kind == "/" || expression.kind == "%") &&
            rightValue.integer == 0) bootstrapEvalRuntimePanic(
            evaluator, "E_EVAL_DIVISION_BY_ZERO", "division by zero",
            expression
        ) else bootstrapEvalScalar(
            bootstrapEvalIntegerArithmetic(
                expression.kind, leftValue.integer, rightValue.integer, width
            ),
            width,
            bootstrapEvalOperationWidth(leftValue.text, rightValue.text)
        )
    }
    result
}

@noinline
fun bootstrapEvaluateBitwise(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val left = evaluator.evaluate(expression.children[0])
    val right = evaluator.evaluate(expression.children[1])
    // A shift has its left operand's type.
    val shift = expression.kind == "<<" || expression.kind == ">>" ||
        expression.kind == ">>>"
    val width = if (shift) left.owner
        else bootstrapEvalOperationWidth(left.owner, right.owner)
    result = bootstrapEvalScalar(
        bootstrapEvalIntegerBitwise(
            expression.kind, left.integer, right.integer, width
        ),
        width,
        if (shift) left.text else bootstrapEvalOperationWidth(left.text, right.text)
    )
    result
}

@noinline
fun bootstrapEvaluateEquality(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val left = evaluator.evaluate(expression.children[0])
    val right = evaluator.evaluate(expression.children[1])
    var equal = bootstrapEvalEqual(left, right)
    if (expression.kind == "!=") equal = !equal
    result = bootstrapEvalBoolean(equal)
    result
}

@noinline
fun bootstrapEvaluateComparison(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val leftValue = evaluator.evaluate(expression.children[0])
    val rightValue = evaluator.evaluate(expression.children[1])
    val left = leftValue.integer
    val right = rightValue.integer
    var value = left < right
    if (expression.kind == "<=") value = left <= right
    if (expression.kind == ">") value = left > right
    if (expression.kind == ">=") value = left >= right
    if (leftValue.kind == "integer" &&
        bootstrapEvalOperationWidth(leftValue.owner, rightValue.owner) == "u64") {
        value = bootstrapEvalUnsignedCompare(expression.kind, left, right)
    }
    if (leftValue.kind == "string" && rightValue.kind == "string") {
        value = bootstrapEvalOrdered(
            expression.kind,
            bootstrapEvalStringOrder(leftValue.text, rightValue.text)
        )
    }
    if (bootstrapEvalFloat(leftValue) && bootstrapEvalFloat(rightValue)) {
        value = bootstrapEvalF64Compare(
            expression.kind,
            if (leftValue.kind == "f32") {
                f32ToF64(bootstrapEvalAsF32(leftValue))
            } else bootstrapEvalAsF64(leftValue),
            if (rightValue.kind == "f32") {
                f32ToF64(bootstrapEvalAsF32(rightValue))
            } else bootstrapEvalAsF64(rightValue)
        )
    }
    result = bootstrapEvalBoolean(value)
    result
}

@noinline
fun bootstrapEvaluateAnd(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val pending: array<BootstrapExpression> = []
    val operands: array<BootstrapExpression> = []
    pending.append(expression)
    var pendingSize = 1
    while (pendingSize > 0) {
        pendingSize = pendingSize - 1
        val current = pending[pendingSize]
        if (current.kind == "&&" && current.children.size == 2) {
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[1]
            } else pending.append(current.children[1])
            pendingSize = pendingSize + 1
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[0]
            } else pending.append(current.children[0])
            pendingSize = pendingSize + 1
        } else operands.append(current)
    }
    var operand = 0
    result = bootstrapEvalBoolean(true)
    while (result.boolean && operand < operands.size) {
        result = evaluator.evaluate(operands[operand])
        operand = operand + 1
    }
    result
}

@noinline
fun bootstrapEvaluateOr(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val pending: array<BootstrapExpression> = []
    val operands: array<BootstrapExpression> = []
    pending.append(expression)
    var pendingSize = 1
    while (pendingSize > 0) {
        pendingSize = pendingSize - 1
        val current = pending[pendingSize]
        if (current.kind == "||" && current.children.size == 2) {
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[1]
            } else pending.append(current.children[1])
            pendingSize = pendingSize + 1
            if (pendingSize < pending.size) {
                pending[pendingSize] = current.children[0]
            } else pending.append(current.children[0])
            pendingSize = pendingSize + 1
        } else operands.append(current)
    }
    var operand = 0
    result = bootstrapEvalBoolean(false)
    while (!result.boolean && operand < operands.size) {
        result = evaluator.evaluate(operands[operand])
        operand = operand + 1
    }
    result
}

// An `else if` chain is walked here, not through `evaluate` for each link,
// so a long chain holds one frame; each link counts as the step `evaluate`
// would count for it.
@noinline
fun bootstrapEvaluateIf(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var current = expression
    var pending = true
    while (pending) {
        pending = false
        if (evaluator.evaluate(current.children[0]).boolean) {
            result = evaluator.evaluate(current.children[1])
            // Without `else`, the branch's value is discarded.
            if (current.children[2].kind == "missing") {
                bootstrapEvalDropDiscarded(evaluator, current.children[1], result)
            }
        } else if (current.children[2].kind == "missing") {
            result = BootstrapEvalValue("void", 0, false, "", BOOTSTRAP_EVAL_NO_ELEMENTS, "", BOOTSTRAP_EVAL_NO_FIELDS)
        } else if (current.children[2].kind != "if") {
            result = evaluator.evaluate(current.children[2])
        } else {
            current = current.children[2]
            evaluator.steps = evaluator.steps + 1
            if (evaluator.steps > evaluator.context.stepLimit) {
                bootstrapEvalStepLimitReached(evaluator)
            } else pending = true
        }
    }
    result
}

@noinline
fun bootstrapEvaluateWhen(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val subject = evaluator.evaluate(expression.children[0])
    var selected = false
    var branch = 1
    while (!selected && branch + 1 < expression.children.size) {
        val match = expression.children[branch]
        // `is T`: an instance of the class T, or of a class conforming to it.
        val unwrapped = bootstrapEvalUnwrapBorrow(subject)
        if (match.kind == "missing" ||
            (match.kind == "is" && unwrapped.kind == "object" &&
             bootstrapTypeConformsOrIs(
                evaluator.declarations, unwrapped.owner,
                bootstrapNormalizeType(match.text)
             )) ||
            (match.kind != "is" && bootstrapEvalEqual(
                subject,
                evaluator.evaluate(match)
            ))) {
            result = evaluator.evaluate(expression.children[branch + 1])
            selected = true
        }
        branch = branch + 2
    }
    if (!selected) {
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalInvalid()
    }
    result
}

@noinline
fun bootstrapEvaluateWhile(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var looping = true
    result = bootstrapEvalVoid()
    while (looping &&
           evaluator.evaluate(expression.children[0]).boolean &&
           evaluator.steps <= evaluator.context.stepLimit) {
        result = evaluator.evaluate(expression.children[1])
        bootstrapEvalDropDiscarded(evaluator, expression.children[1], result)
        // A stack-depth stop unwinding through the loop ends it: another turn
        // would only descend into the stop again.
        if (bootstrapEvalDepthReported) looping = false
        // A generator's jump (generator.goto) leaves the loop like `return`.
        if (result.kind == "return" || result.kind == "goto") looping = false
        if (result.kind == "break") {
            result = bootstrapEvalVoid()
            looping = false
        }
        if (result.kind == "continue") {
            result = bootstrapEvalVoid()
        }
    }
    result
}

@noinline
fun bootstrapEvaluateDoWhile(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    var more = true
    var looping = true
    result = bootstrapEvalVoid()
    while (more && looping && evaluator.steps <= evaluator.context.stepLimit) {
        result = evaluator.evaluate(expression.children[0])
        bootstrapEvalDropDiscarded(evaluator, expression.children[0], result)
        // A stack-depth stop unwinding through the loop ends it: another turn
        // would only descend into the stop again.
        if (bootstrapEvalDepthReported) looping = false
        if (result.kind == "return" || result.kind == "goto") looping = false
        if (result.kind == "break") {
            result = bootstrapEvalVoid()
            looping = false
        }
        if (result.kind == "continue") {
            result = bootstrapEvalVoid()
        }
        if (looping) {
            more = evaluator.evaluate(expression.children[1]).boolean
        }
    }
    result
}

@noinline
fun bootstrapEvaluateFor(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    // A borrowed array (a map's affine `values()`) iterates as the array.
    var source = bootstrapEvalUnwrapBorrow(evaluator.evaluate(expression.children[0]))
    val generated = bootstrapEvalIsGenerator(source)
    // A generator is iterated in place: the loop owns it, asks it for each
    // element as it needs one, and closes it however the loop ends.
    bootstrapEvalMoveForSource(evaluator, expression.children[0], source)
    val iteratorIndex = evaluator.names.size
    evaluator.names.append(expression.text)
    evaluator.values.append(bootstrapEvalInvalid())
    evaluator.mutable.append(false)
    var element = 0
    var looping = true
    result = bootstrapEvalVoid()
    var count = source.elements.size
    if (source.kind == "string") count = source.text.size
    while ((if (generated) looping && bootstrapEvalGeneratorNext(evaluator, source)
            else element < count && looping) &&
           evaluator.steps <= evaluator.context.stepLimit) {
        if (generated) {
            evaluator.values[iteratorIndex] = source.elements[1]
        } else if (source.kind == "string") {
            evaluator.values[iteratorIndex] = bootstrapEvalInteger(
                source.text[element]
            )
        } else {
            evaluator.values[iteratorIndex] = source.elements[element]
        }
        result = evaluator.evaluate(expression.children[1])
        bootstrapEvalDropDiscarded(evaluator, expression.children[1], result)
        // A stack-depth stop unwinding through the loop ends it: another turn
        // would only descend into the stop again.
        if (bootstrapEvalDepthReported) looping = false
        if (result.kind == "return" || result.kind == "goto") looping = false
        if (result.kind == "break") {
            result = bootstrapEvalVoid()
            looping = false
        }
        if (result.kind == "continue") {
            result = bootstrapEvalVoid()
        }
        element = element + 1
    }
    evaluator.values[iteratorIndex] = evaluator.uninitializedValue()
    evaluator.names[iteratorIndex] = ""
    if (generated) bootstrapEvalGeneratorDrop(evaluator, source)
    result
}

@noinline
fun bootstrapEvaluateClosureCall(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    callable: BootstrapEvalValue,
    target: int
): BootstrapEvalValue {
    var result = bootstrapEvalInvalid()
    val closure = callable
    val lambda = evaluator.syntaxAt(closure.integer)
    val callNames: array<string> = []
    val callValues: array<BootstrapEvalValue> = []
    val callMutable: array<bool> = []
    var capture = 0
    while (capture < closure.fieldNames.size) {
        callNames.append(closure.fieldNames[capture])
        callValues.append(closure.elements[capture])
        callMutable.append(closure.owner == "mut")
        capture = capture + 1
    }
    var parameter = 0
    while (parameter + 1 < lambda.children.size) {
        callNames.append(lambda.children[parameter].text)
        var argumentValue = bootstrapEvalInvalid()
        if (parameter < expression.children.size) {
            argumentValue = evaluator.evaluate(
                expression.children[parameter]
            )
            bootstrapSemanticUnit()
        } else {
            evaluator.errors = evaluator.errors + 1
            bootstrapSemanticUnit()
        }
        callValues.append(argumentValue)
        callMutable.append(false)
        parameter = parameter + 1
    }
    val invocation = BootstrapEvaluator(
        evaluator.declarations,
        evaluator.affineTypes,
        evaluator.context,
        callNames,
        callValues,
        callMutable,
        evaluator.cursors,
        evaluator.syntax,
        evaluator.typedCalls,
        evaluator.reflectedTypes,
        evaluator.generatedDeclarations,
        evaluator.extensionRequests,
        evaluator.compileInputPaths,
        evaluator.compileInputContents,
        evaluator.globalKeys,
        evaluator.globalValues,
        evaluator.allowedCompileEffects,
        evaluator.errors,
        evaluator.steps,
        evaluator.diagnostics,
        evaluator.sourceIdentity
    )
    result = invocation.evaluate(
        lambda.children[lambda.children.size - 1]
    )
    if (result.kind == "return" && result.elements.size == 1) {
        result = result.elements[0]
    }
    if (closure.boolean) {
        capture = closure.elements.size
        while (capture > 0) {
            capture = capture - 1
            val captured = invocation.values[capture]
            if (captured.kind != "uninitialized" &&
                captured != result) {
                invocation.dropValue(captured)
            }
            invocation.values[capture] =
                invocation.uninitializedValue()
            closure.elements[capture] = evaluator.uninitializedValue()
        }
        if (target >= 0) {
            evaluator.values[target] = evaluator.uninitializedValue()
        }
    }
    evaluator.errors = invocation.errors
    evaluator.steps = invocation.steps
    evaluator.diagnostics = invocation.diagnostics
    result
}

@noinline
fun bootstrapEvaluateCallImports(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    // Import providers construct typed, deferred sources. Normal discovery
    // evaluates the source value but never invokes its resolver closure.
    if (targetName == "importFile" && expression.children.size == 2) {
        val path = evaluator.evaluate(expression.children[0])
        val contents = evaluator.evaluate(expression.children[1])
        if (path.kind == "string" && contents.kind == "string") {
            result = bootstrapEvalObject(
                "ImportFile", ["path", "contents"], [path, contents]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "resolvedImport" &&
        expression.children.size == 3) {
        val revision = evaluator.evaluate(expression.children[0])
        val entry = evaluator.evaluate(expression.children[1])
        val files = evaluator.evaluate(expression.children[2])
        if (revision.kind == "string" && entry.kind == "string" &&
            files.kind == "array") {
            result = bootstrapEvalObject(
                "ResolvedImport",
                ["revision", "entry", "files"],
                [revision, entry, files]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "importSource" &&
        expression.children.size == 4) {
        val name = evaluator.evaluate(expression.children[0])
        val identity = evaluator.evaluate(expression.children[1])
        val selector = evaluator.evaluate(expression.children[2])
        val resolver = evaluator.evaluate(expression.children[3])
        if (name.kind == "string" && identity.kind == "string" &&
            selector.kind == "string" &&
            (resolver.kind == "closure" || resolver.kind == "function")) {
            result = bootstrapEvalObject(
                "ImportSource",
                [
                    "name", "identity", "selector", "provider",
                    "source", "selectorKind", "resolver",
                    "resolvedRevision", "resolvedEntry", "resolvedFiles"
                ],
                [
                    name, identity, selector,
                    bootstrapEvalString("content"),
                    bootstrapEvalString(""), bootstrapEvalString(""),
                    resolver, bootstrapEvalString(""),
                    bootstrapEvalString(""), bootstrapEvalArray([])
                ]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    // This evaluator-only operation is intentionally absent from semantic
    // builtins: package update may synthesize it, user programs cannot.
    if (targetName == "__ablaResolveImportSource" &&
        bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 1024) &&
        expression.children.size == 1) {
        val source = evaluator.evaluate(expression.children[0])
        if (source.kind == "object" && source.owner == "ImportSource" &&
            source.elements.size == 10 &&
            (source.elements[6].kind == "closure" ||
             source.elements[6].kind == "function")) {
            val resolverName = "__abla_import_resolver_${evaluator.steps}"
            evaluator.names.append(resolverName)
            evaluator.values.append(source.elements[6])
            evaluator.mutable.append(false)
            val resolved = evaluator.evaluateCall(BootstrapExpression(
                "call", resolverName, expression.begin,
                expression.end, []
            ))
            if (resolved.kind == "object" &&
                resolved.owner == "ResolvedImport" &&
                resolved.elements.size == 3) {
                result = bootstrapEvalObject(
                    "ImportSource",
                    source.fieldNames,
                    [
                        source.elements[0], source.elements[1],
                        source.elements[2], source.elements[3],
                        source.elements[4], source.elements[5],
                        source.elements[6], resolved.elements[0],
                        resolved.elements[1], resolved.elements[2]
                    ]
                )
            } else evaluator.errors = evaluator.errors + 1
        } else if (source.kind == "object" &&
            source.owner == "ImportSource" && source.elements.size == 10 &&
            source.elements[3].kind == "string" &&
            source.elements[3].text == "git") {
            result = source
        } else evaluator.errors = evaluator.errors + 1
    }
    // Git remains one provider implementation of the generic source
    // contract. The package updater owns Git/network authority.
    if (targetName == "gitImportSource" &&
        expression.children.size == 4) {
        val name = evaluator.evaluate(expression.children[0])
        val source = evaluator.evaluate(expression.children[1])
        val selectorKind = evaluator.evaluate(expression.children[2])
        val selector = evaluator.evaluate(expression.children[3])
        if (name.kind == "string" && source.kind == "string" &&
            selectorKind.kind == "string" && selector.kind == "string") {
            result = bootstrapEvalObject(
                "ImportSource",
                [
                    "name", "identity", "selector", "provider",
                    "source", "selectorKind", "resolver",
                    "resolvedRevision", "resolvedEntry", "resolvedFiles"
                ],
                [
                    name, bootstrapEvalString("git:${source.text}"),
                    selector, bootstrapEvalString("git"), source,
                    selectorKind, bootstrapEvalNull(),
                    bootstrapEvalString(""), bootstrapEvalString(""),
                    bootstrapEvalArray([])
                ]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "github" && expression.children.size == 1) {
        val repository = evaluator.evaluate(expression.children[0])
        if (repository.kind == "string") {
            var slash = -1
            var index = 0
            while (index < repository.text.size) {
                if (repository.text[index] == 47) slash = index
                index = index + 1
            }
            val name = repository.text.slice(slash + 1, repository.text.size)
            val source = bootstrapEvalString(
                "https://github.com/${repository.text}.git"
            )
            result = bootstrapEvalObject(
                "ImportSource",
                [
                    "name", "identity", "selector", "provider",
                    "source", "selectorKind", "resolver",
                    "resolvedRevision", "resolvedEntry", "resolvedFiles"
                ],
                [
                    bootstrapEvalString(name),
                    bootstrapEvalString("github:${repository.text}"),
                    bootstrapEvalString("HEAD"),
                    bootstrapEvalString("git"), source,
                    bootstrapEvalString("head"), bootstrapEvalNull(),
                    bootstrapEvalString(""), bootstrapEvalString(""),
                    bootstrapEvalArray([])
                ]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
fun bootstrapEvaluateCallReflection(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    // Compiler reflection handles are declaration indexes. They are
    // stable for one compilation and need no host state, so reflection
    // works identically in the self-hosted compile-time evaluator.
    if (targetName == "compilerFindType") {
        val name = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalInteger(evaluator.reflectedTypeHandle(
            bootstrapEvalGenericSpelling(evaluator, name.text)
        ))
    }
    if (targetName == "typedExpressionTypeHandle") {
        val syntaxHandle = evaluator.evaluate(expression.children[0]).integer
        if (syntaxHandle >= 0 && syntaxHandle < evaluator.syntax.size) {
            val syntaxExpression = evaluator.syntax[syntaxHandle]
            val typed = evaluator.typedCallIndex(syntaxExpression)
            var type = evaluator.staticSyntaxType(syntaxExpression)
            if (typed >= 0) type = evaluator.typedCalls[typed].type
            if ((syntaxExpression.kind == "call" ||
                 syntaxExpression.kind == "member.call") && typed < 0) {
                evaluator.errors = evaluator.errors + 1
            } else result = bootstrapEvalInteger(
                evaluator.reflectedTypeHandle(type)
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctionParameterTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val parameter = evaluator.evaluate(expression.children[1]).integer
        val type = evaluator.functionHandleParameterType(handle, parameter)
        val typeHandle = evaluator.reflectedTypeHandle(type)
        if (evaluator.functionHandleValid(handle) && typeHandle >= 0) {
            result = bootstrapEvalInteger(typeHandle)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctionResultTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val typeHandle = evaluator.reflectedTypeHandle(
            evaluator.functionHandleResultType(handle)
        )
        if (evaluator.functionHandleValid(handle) && typeHandle >= 0) {
            result = bootstrapEvalInteger(typeHandle)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerClassFieldTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val field = evaluator.evaluate(expression.children[1]).integer
        val typeHandle = evaluator.reflectedTypeHandle(
            evaluator.classFieldType(handle, field)
        )
        if (typeHandle >= 0) result = bootstrapEvalInteger(typeHandle)
        else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerTypeName" ||
        targetName == "compilerTypeModuleIdentity" ||
        targetName == "compilerTypeKind" ||
        targetName == "compilerTypeIsNullable" ||
        targetName == "compilerTypeIsAffine" ||
        targetName == "compilerTypeArgumentCount" ||
        targetName == "compilerTypeElement" ||
        targetName == "compilerTypeResult" ||
        targetName == "compilerTypeDeclaration") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.reflectedTypeValid(handle)) {
            val type = evaluator.reflectedTypes[handle]
            val kind = evaluator.reflectedTypeKind(type)
            if (targetName == "compilerTypeName") {
                // A generic's instance as written: `Box<i64>`.
                result = bootstrapEvalString(
                    bootstrapGenericVisible(bootstrapSourceVisibleType(type))
                )
            }
            if (targetName == "compilerTypeModuleIdentity") {
                var nominal = type
                if (bootstrapIsNullableType(nominal)) {
                    nominal = bootstrapNullableElementType(nominal)
                }
                result = bootstrapEvalString(
                    bootstrapCanonicalDeclarationModuleIdentity(nominal)
                )
            }
            if (targetName == "compilerTypeKind") {
                result = bootstrapEvalString(kind)
            }
            if (targetName == "compilerTypeIsNullable") {
                result = bootstrapEvalBoolean(bootstrapIsNullableType(type))
            }
            if (targetName == "compilerTypeIsAffine") {
                result = bootstrapEvalBoolean(bootstrapSummaryTypeIsAffine(
                    type,
                    evaluator.affineTypes
                ))
            }
            if (targetName == "compilerTypeArgumentCount") {
                // A generic class's instance: its type arguments.
                var count = bootstrapGenericInstanceArguments(type).size
                if (kind == "nullable" || kind == "array" ||
                    kind == "shared" || kind == "weak" ||
                    kind == "mutex" || kind == "borrow" ||
                    kind == "pointer") count = 1
                if (bootstrapIsFunctionType(type)) {
                    count = bootstrapFunctionParameterCount(type)
                }
                result = bootstrapEvalInteger(count)
            }
            if (targetName == "compilerTypeElement") {
                val element = evaluator.reflectedTypeHandle(
                    evaluator.reflectedTypeElement(type)
                )
                if (element >= 0) result = bootstrapEvalInteger(element)
                else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerTypeResult") {
                val resultType = evaluator.reflectedTypeHandle(
                    bootstrapFunctionResultType(type)
                )
                if (bootstrapIsFunctionType(type) && resultType >= 0) {
                    result = bootstrapEvalInteger(resultType)
                } else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerTypeDeclaration") {
                var declaration = -1
                var candidate = 0
                while (candidate < evaluator.declarations.size) {
                    if (evaluator.declarations[candidate].kind == "class" &&
                        bootstrapNormalizeType(
                            evaluator.declarations[candidate].name
                        ) == type) declaration = candidate
                    candidate = candidate + 1
                }
                result = bootstrapEvalInteger(declaration)
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerTypeArgument") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val argument = evaluator.evaluate(expression.children[1]).integer
        if (evaluator.reflectedTypeValid(handle)) {
            val type = evaluator.reflectedTypes[handle]
            var argumentType = "unknown"
            val kind = evaluator.reflectedTypeKind(type)
            if (argument == 0 && (kind == "nullable" || kind == "array" ||
                kind == "shared" || kind == "weak" || kind == "mutex" ||
                kind == "borrow" || kind == "pointer")) {
                argumentType = evaluator.reflectedTypeElement(type)
            }
            if (bootstrapIsFunctionType(type) && argument >= 0 &&
                argument < bootstrapFunctionParameterCount(type)) {
                argumentType = bootstrapFunctionParameterType(type, argument)
            }
            val instanceArguments = bootstrapGenericInstanceArguments(type)
            if (argument >= 0 && argument < instanceArguments.size) argumentType = instanceArguments[argument]
            val argumentHandle = evaluator.reflectedTypeHandle(argumentType)
            if (argumentHandle >= 0) {
                result = bootstrapEvalInteger(argumentHandle)
            } else evaluator.errors = evaluator.errors + 1
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctions") {
        val handles: array<BootstrapEvalValue> = []
        var declarationIndex = 0
        while (declarationIndex < evaluator.declarations.size) {
            val declaration = evaluator.declarations[declarationIndex]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun") &&
                declaration.extensionOwner != "Compiler" &&
                declaration.extensionOwner != "FunctionReference" &&
                declaration.extensionOwner != "IndependentModule") {
                handles.append(bootstrapEvalInteger(declarationIndex))
            }
            var method = 0
            while (method < declaration.methods.size) {
                handles.append(bootstrapEvalInteger(
                    evaluator.methodHandle(declarationIndex, method)
                ))
                method = method + 1
            }
            declarationIndex = declarationIndex + 1
        }
        result = bootstrapEvalArray(handles)
    }
    if (targetName == "compilerBindings") {
        val handles: array<BootstrapEvalValue> = []
        var declaration = 0
        while (declaration < evaluator.declarations.size) {
            if (bootstrapDeclarationIsValue(
                evaluator.declarations[declaration].kind
            )) handles.append(bootstrapEvalInteger(declaration))
            declaration = declaration + 1
        }
        result = bootstrapEvalArray(handles)
    }
    if (targetName == "compilerFunctionsAnnotated") {
        val annotation = evaluator.evaluate(expression.children[0])
        val handles: array<BootstrapEvalValue> = []
        if (annotation.kind == "string") {
            var declarationIndex = 0
            while (declarationIndex < evaluator.declarations.size) {
                val declaration = evaluator.declarations[declarationIndex]
                var matched = false
                var annotationIndex = 0
                while (annotationIndex < declaration.annotations.size) {
                    if (declaration.annotations[annotationIndex] ==
                        annotation.text) matched = true
                    annotationIndex = annotationIndex + 1
                }
                if (matched && declaration.kind == "fun" &&
                    declaration.extensionOwner == "") {
                    handles.append(bootstrapEvalInteger(declarationIndex))
                }
                declarationIndex = declarationIndex + 1
            }
            result = bootstrapEvalArray(handles)
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
/** The name an intrinsic or host provider knows the call's target by: an
 *  extern's declared name when `name` carries an aliased module's prefix
 *  (bootstrapCanonicalDeclarationSourceName), else `name`. */
fun bootstrapEvalExternBuiltinName(var evaluator: BootstrapEvaluator, name: string): string {
    if (bootstrapCanonicalNameDelimiter(name) < 0) return name
    var node = evaluator.firstNamed(name)
    while (node >= 0) {
        val declaration = evaluator.declarations[evaluator.namedDeclaration(node)]
        if (declaration.name == name && declaration.kind == "extern") {
            return bootstrapCanonicalDeclarationSourceName(name)
        }
        node = evaluator.nextNamed(node)
    }
    name
}

fun bootstrapEvaluateCallText(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "ablaUtf8EncodeScalar") {
        val scalar = evaluator.evaluate(expression.children[0])
        if (scalar.kind == "integer") {
            result = bootstrapEvalString(utf8Encode(scalar.integer))
        } else evaluator.errors = evaluator.errors + 1
    }
    // Compile-time code is a program the compiler runs with no arguments: no
    // arguments, and an empty program path (index -1).
    if (expression.children.size == 0 &&
        (targetName == "ablaLinuxArgumentCount" ||
         targetName == "ablaHostArgumentCount")) {
        result = bootstrapEvalInteger(0)
    }
    if (expression.children.size == 1 &&
        (targetName == "ablaLinuxArgument" || targetName == "ablaHostArgument")) {
        evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString("")
    }
    // Compile-time code cannot reach raw memory; ablaAtCompileTime lets the
    // standard library take a plain path here.
    if (targetName == "ablaAtCompileTime") result = bootstrapEvalBoolean(true)
    // The interpreter has no heap of the program's to measure, collect or
    // reset, so the runtime memory API fails here, saying why, rather than
    // answering what a program wouldn't (it ran as an empty, unbounded heap).
    // Natively compiled compile-time code has a runtime of its own to ask.
    if (targetName == "runtimeMemoryCollect" ||
        targetName == "runtimeMemoryLiveBytes" ||
        targetName == "runtimeMemoryCheckpoint" ||
        targetName == "runtimeMemoryLimit" ||
        targetName == "runtimeMemoryReset" ||
        targetName == "runtimeMemorySetLimit") {
        // Once per function: a loop that checkpoints and resets would
        // otherwise repeat the same error every iteration.
        val message =
            "`$targetName` has no program heap to inspect in the compile-time interpreter"
        if (!bootstrapTextContains(evaluator.diagnostics, message)) {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic("E_EVAL_MEMORY_UNAVAILABLE", message)
        }
        // A placeholder (the error stands), so the call doesn't go on to
        // evaluate the runtime's own implementation.
        result = bootstrapEvalInteger(0)
    }
    // The evaluator's values live in no region: nothing is freed when a region ends,
    // so a string needs no promotion out of one (an HTTP response is built so).
    if (targetName == "runtimeMemoryRegionActive" ||
        targetName == "__ablaRuntimePlatformRegionActive") {
        result = bootstrapEvalBoolean(false)
    }
    if (targetName == "runtimeMemoryPromoteString" && expression.children.size == 1) {
        result = evaluator.evaluate(expression.children[0])
    }
    val floatIntrinsic = bootstrapEvalFloatIntrinsic(targetName)
    if (floatIntrinsic && expression.children.size == 1) {
        result = bootstrapEvalFloatCall(
            targetName, evaluator.evaluate(expression.children[0])
        )
        if (result.kind == "invalid") {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "$targetName expected a number"
            )
        }
    }
    if (targetName == "ablaByteEncode") {
        val byte = evaluator.evaluate(expression.children[0])
        if (byte.kind == "integer") {
            result = bootstrapEvalString(byteEncode(byte.integer))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "ablaTextFindSequence") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val sequence = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[1])
        )
        val begin = evaluator.evaluate(expression.children[2])
        val end = evaluator.evaluate(expression.children[3])
        if (text.kind == "string" && sequence.kind == "string" &&
            begin.kind == "integer" && end.kind == "integer") {
            var found = -1
            val beginOffset = begin.integer
            val endOffset = end.integer
            val sequenceLength = sequence.text.size
            if (beginOffset >= 0 && endOffset >= beginOffset &&
                endOffset <= text.text.size) {
                if (sequenceLength == 0) found = beginOffset
                else if (sequenceLength <= endOffset - beginOffset) {
                    var offset = beginOffset
                    val last = endOffset - sequenceLength
                    while (found < 0 && offset <= last) {
                        var equal = true
                        var index = 0
                        while (equal && index < sequenceLength) {
                            equal = text.text[offset + index] ==
                                sequence.text[index]
                            index = index + 1
                        }
                        if (equal) found = offset
                        offset = offset + 1
                    }
                }
            }
            result = bootstrapEvalInteger(found)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextFindSequence expected two strings and two integer bounds"
            )
        }
    }
    if (targetName == "ablaTextFindByte") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val byte = evaluator.evaluate(expression.children[1])
        val begin = evaluator.evaluate(expression.children[2])
        val end = evaluator.evaluate(expression.children[3])
        if (text.kind == "string" && byte.kind == "integer" &&
            begin.kind == "integer" && end.kind == "integer") {
            var found = -1
            var offset = begin.integer
            if (byte.integer >= 0 && byte.integer <= 255 &&
                offset >= 0 && end.integer >= offset &&
                end.integer <= text.text.size) {
                while (found < 0 && offset < end.integer) {
                    if (text.text[offset] == byte.integer) found = offset
                    offset = offset + 1
                }
            }
            result = bootstrapEvalInteger(found)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextFindByte expected a string and three integer arguments"
            )
        }
    }
    if (targetName == "ablaTextAsciiEqualInsensitive") {
        val left = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val right = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[1])
        )
        if (left.kind == "string" && right.kind == "string") {
            var equal = left.text.size == right.text.size
            var index = 0
            while (equal && index < left.text.size) {
                var leftByte = left.text[index]
                var rightByte = right.text[index]
                if (leftByte >= 65 && leftByte <= 90) {
                    leftByte = leftByte + 32
                }
                if (rightByte >= 65 && rightByte <= 90) {
                    rightByte = rightByte + 32
                }
                equal = leftByte == rightByte
                index = index + 1
            }
            result = bootstrapEvalBoolean(equal)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextAsciiEqualInsensitive expected two strings"
            )
        }
    }
    if (targetName == "ablaTextReadU32LittleEndian") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val offset = evaluator.evaluate(expression.children[1])
        if (text.kind == "string" && offset.kind == "integer") {
            var value = -1
            if (offset.integer >= 0 &&
                offset.integer + 4 <= text.text.size) {
                value = bitOr(
                    bitOr(
                        text.text[offset.integer],
                        bitShiftLeft(text.text[offset.integer + 1], 8)
                    ),
                    bitOr(
                        bitShiftLeft(text.text[offset.integer + 2], 16),
                        bitShiftLeft(text.text[offset.integer + 3], 24)
                    )
                )
            }
            result = bootstrapEvalInteger(value)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextReadU32LittleEndian expected a string and integer offset"
            )
        }
    }
    if (targetName == "ablaBase64Encode") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            result = bootstrapEvalString(
                bootstrapEvalBase64Encode(text.text)
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaBase64Encode expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaBase64Decode") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            result = bootstrapEvalString(
                bootstrapEvalBase64Decode(text.text)
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaBase64Decode expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaByteChunksJoin") {
        val chunks = evaluator.evaluate(expression.children[0])
        val byteCount = evaluator.evaluate(expression.children[1])
        if (byteCount.kind == "integer") {
            result = bootstrapEvalByteChunksJoin(
                chunks, byteCount.integer
            )
            if (result.kind == "invalid") {
                evaluator.errors = evaluator.errors + 1
                evaluator.recordEvaluatorDiagnostic(
                    "E_EVAL_INTRINSIC_ARGUMENT",
                    "ablaByteChunksJoin received inconsistent chunks"
                )
            }
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaByteChunksJoin expected integer byte count, got ${byteCount.kind}"
            )
        }
    }
    if (targetName == "ablaTextIsValidUtf8") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            result = bootstrapEvalBoolean(utf8Info(text.text).valid)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaTextIsValidUtf8 expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaJsonFindPlainStringEnd") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        val end = evaluator.evaluate(expression.children[2])
        if (text.kind == "string" && begin.kind == "integer" &&
            end.kind == "integer") {
            var found = -1
            var offset = begin.integer
            var plain = offset >= 0 && end.integer >= offset &&
                end.integer <= text.text.size
            while (plain && found < 0 && offset < end.integer) {
                val lead = text.text[offset]
                if (lead == 34) found = offset
                else if (lead == 92 || lead < 32) plain = false
                else if (lead < 128) offset = offset + 1
                else {
                    var count = 0
                    if (lead >= 194 && lead <= 223) count = 2
                    if (lead >= 224 && lead <= 239) count = 3
                    if (lead >= 240 && lead <= 244) count = 4
                    plain = count > 0 && offset + count <= end.integer
                    var index = 1
                    while (plain && index < count) {
                        val byte = text.text[offset + index]
                        plain = byte >= 128 && byte <= 191
                        index = index + 1
                    }
                    if (plain && count == 3 && lead == 224) {
                        plain = text.text[offset + 1] >= 160
                    }
                    if (plain && count == 3 && lead == 237) {
                        plain = text.text[offset + 1] <= 159
                    }
                    if (plain && count == 4 && lead == 240) {
                        plain = text.text[offset + 1] >= 144
                    }
                    if (plain && count == 4 && lead == 244) {
                        plain = text.text[offset + 1] <= 143
                    }
                    if (plain) offset = offset + count
                }
            }
            result = bootstrapEvalInteger(found)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonFindPlainStringEnd expected a string and two integer bounds"
            )
        }
    }
    if (targetName == "ablaJsonStringIsPlain") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        if (text.kind == "string") {
            var plain = utf8Info(text.text).valid
            var index = 0
            while (plain && index < text.text.size) {
                val byte = text.text[index]
                plain = byte >= 32 && byte != 34 && byte != 92
                index = index + 1
            }
            result = bootstrapEvalBoolean(plain)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonStringIsPlain expected string, got ${text.kind}"
            )
        }
    }
    if (targetName == "ablaJsonMatchCompactObjectField") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val offset = evaluator.evaluate(expression.children[1])
        val name = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[2])
        )
        val comma = evaluator.evaluate(expression.children[3])
        if (text.kind == "string" && offset.kind == "integer" &&
            name.kind == "string" && comma.kind == "boolean") {
            var cursor = offset.integer
            var matches = cursor >= 0 && cursor <= text.text.size
            if (matches && comma.boolean) {
                matches = cursor < text.text.size &&
                    text.text[cursor] == 44
                cursor = cursor + 1
            }
            val end = cursor + 1 + name.text.size
            matches = matches && cursor < text.text.size &&
                text.text[cursor] == 34 && end + 1 < text.text.size &&
                text.text.slice(cursor + 1, end) == name.text &&
                text.text[end] == 34 && text.text[end + 1] == 58
            result = bootstrapEvalInteger(if (matches) end + 2 else -1)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonMatchCompactObjectField expected two strings, an integer offset, and a boolean"
            )
        }
    }
    if (targetName == "ablaJsonCompactArrayNext") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val offset = evaluator.evaluate(expression.children[1])
        val first = evaluator.evaluate(expression.children[2])
        if (text.kind == "string" && offset.kind == "integer" &&
            first.kind == "boolean") {
            var cursor = offset.integer
            var compact = cursor >= 0 && cursor < text.text.size
            if (compact && !first.boolean) {
                compact = text.text[cursor] == 44
                cursor = cursor + 1
                compact = compact && cursor < text.text.size
            }
            var encoded = 0
            if (compact) {
                val byte = text.text[cursor]
                if (byte == 93) {
                    if (first.boolean) encoded = 0 - cursor - 2
                } else if (byte != 32 && byte != 9 && byte != 10 &&
                           byte != 13) encoded = cursor + 1
            }
            result = bootstrapEvalInteger(encoded)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonCompactArrayNext expected a string, integer offset, and boolean"
            )
        }
    }
    if (targetName == "ablaJsonAvailableIntegerEnd") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        if (text.kind == "string" && begin.kind == "integer") {
            var cursor = begin.integer
            var negative = false
            var valid = cursor >= 0 && cursor < text.text.size
            if (valid && text.text[cursor] == 45) {
                negative = true
                cursor = cursor + 1
            }
            val digitBegin = cursor
            if (valid && cursor < text.text.size &&
                text.text[cursor] == 48) {
                cursor = cursor + 1
                if (cursor < text.text.size &&
                    text.text[cursor] >= 48 &&
                    text.text[cursor] <= 57) valid = false
            } else if (valid && cursor < text.text.size &&
                text.text[cursor] >= 49 && text.text[cursor] <= 57) {
                while (cursor < text.text.size &&
                       text.text[cursor] >= 48 &&
                       text.text[cursor] <= 57) cursor = cursor + 1
            } else valid = false
            if (valid && cursor < text.text.size &&
                (text.text[cursor] == 43 || text.text[cursor] == 45 ||
                 text.text[cursor] == 46 || text.text[cursor] == 101 ||
                 text.text[cursor] == 69)) valid = false
            val digits = cursor - digitBegin
            if (valid && digits > 19) valid = false
            if (valid && digits == 19) {
                var accumulator = 0
                var index = digitBegin
                while (valid && index < cursor) {
                    val digit = text.text[index] - 48
                    if (accumulator < -922337203685477580 ||
                        (accumulator == -922337203685477580 &&
                         digit > (if (negative) 8 else 7))) valid = false
                    else accumulator = accumulator * 10 - digit
                    index = index + 1
                }
            }
            result = bootstrapEvalInteger(if (valid) cursor else -1)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonAvailableIntegerEnd expected a string and integer offset"
            )
        }
    }
    if (targetName == "ablaJsonIntegerValueAt") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        val end = evaluator.evaluate(expression.children[2])
        if (text.kind == "string" && begin.kind == "integer" &&
            end.kind == "integer" && begin.integer >= 0 &&
            end.integer > begin.integer &&
            end.integer <= text.text.size) {
            val negative = text.text[begin.integer] == 45
            var cursor = if (negative) begin.integer + 1
                else begin.integer
            var value = 0
            while (cursor < end.integer) {
                value = value * 10 - (text.text[cursor] - 48)
                cursor = cursor + 1
            }
            result = bootstrapEvalInteger(if (negative) value else 0 - value)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonIntegerValueAt expected a string and two integer bounds"
            )
        }
    }
    if (targetName == "ablaJsonWhitespaceEnd") {
        val text = bootstrapEvalUnwrapBorrow(
            evaluator.evaluate(expression.children[0])
        )
        val begin = evaluator.evaluate(expression.children[1])
        if (text.kind == "string" && begin.kind == "integer") {
            var cursor = begin.integer
            var scanning = cursor >= 0 && cursor <= text.text.size
            while (scanning && cursor < text.text.size) {
                val byte = text.text[cursor]
                scanning = byte == 32 || byte == 9 || byte == 10 ||
                    byte == 13
                if (scanning) cursor = cursor + 1
            }
            result = bootstrapEvalInteger(cursor)
        } else {
            evaluator.errors = evaluator.errors + 1
            evaluator.recordEvaluatorDiagnostic(
                "E_EVAL_INTRINSIC_ARGUMENT",
                "ablaJsonWhitespaceEnd expected a string and integer offset"
            )
        }
    }
    result
}

@noinline
fun bootstrapEvaluateCallCompiler(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "compilerFindFunction") {
        val written = evaluator.evaluate(expression.children[0])
        // `first<int>`: the generic's instance.
        val name = bootstrapEvalString(bootstrapEvalGenericSpelling(evaluator, written.text))
        var handle = -1
        var declarationIndex = 0
        while (declarationIndex < evaluator.declarations.size) {
            val declaration = evaluator.declarations[declarationIndex]
            if ((declaration.kind == "fun" ||
                 declaration.kind == "compile.fun" ||
                 declaration.kind == "extern") &&
                declaration.extensionOwner == "" &&
                declaration.name == name.text) handle = declarationIndex
            if (declaration.extensionOwner != "" &&
                "${declaration.extensionOwner}.${declaration.name}" ==
                    name.text) handle = declarationIndex
            var method = 0
            while (method < declaration.methods.size) {
                if ("${declaration.name}.${declaration.methods[method].name}" ==
                    name.text) {
                    handle = evaluator.methodHandle(declarationIndex, method)
                }
                method = method + 1
            }
            declarationIndex = declarationIndex + 1
        }
        // The calling module's own private function, by its source name.
        if (handle < 0) handle = bootstrapEvalPrivateHandle(evaluator, name.text, false)
        result = bootstrapEvalInteger(handle)
    }
    if (targetName == "compilerIsPrivate") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        result = bootstrapEvalBoolean(
            handle >= 0 && handle < evaluator.declarations.size &&
                evaluator.declarations[handle].isPrivate
        )
    }
    if (targetName == "compilerFindBinding") {
        val name = evaluator.evaluate(expression.children[0])
        var handle = -1
        var declaration = 0
        while (declaration < evaluator.declarations.size) {
            val candidate = evaluator.declarations[declaration]
            if (bootstrapDeclarationIsValue(candidate.kind) &&
                candidate.name == name.text) handle = declaration
            declaration = declaration + 1
        }
        result = bootstrapEvalInteger(handle)
    }
    if (targetName == "compilerBindingName" ||
        targetName == "compilerBindingIsDelegated" ||
        targetName == "compilerBindingExposedType" ||
        targetName == "compilerBindingDelegateType" ||
        targetName == "compilerBindingIsMutable" ||
        targetName == "compilerBindingGetter" ||
        targetName == "compilerBindingSetter" ||
        targetName == "compilerBindingCanReplaceDelegate" ||
        targetName == "compilerBindingByBegin" ||
        targetName == "compilerBindingByEnd") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.bindingHandleValid(handle)) {
            val declaration = evaluator.declarations[handle]
            val delegated = evaluator.bindingIsDelegated(handle)
            val mutable = declaration.kind == "var" ||
                declaration.kind == "compile.var"
            if (targetName == "compilerBindingName") {
                result = bootstrapEvalString(declaration.name)
            }
            if (targetName == "compilerBindingIsDelegated") {
                result = bootstrapEvalBoolean(delegated)
            }
            if (targetName == "compilerBindingExposedType") {
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(
                        evaluator.bindingExposedType(handle)
                    )
                )
            }
            if (targetName == "compilerBindingDelegateType") {
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(
                        evaluator.bindingDelegateType(handle)
                    )
                )
            }
            if (targetName == "compilerBindingIsMutable") {
                result = bootstrapEvalBoolean(mutable)
            }
            if (targetName == "compilerBindingGetter") {
                result = bootstrapEvalInteger(
                    evaluator.bindingMethodHandle(handle, "getValue")
                )
            }
            if (targetName == "compilerBindingSetter") {
                result = bootstrapEvalInteger(
                    evaluator.bindingMethodHandle(handle, "setValue")
                )
            }
            if (targetName == "compilerBindingCanReplaceDelegate") {
                result = bootstrapEvalBoolean(delegated && mutable)
            }
            if (targetName == "compilerBindingByBegin") {
                result = bootstrapEvalInteger(
                    if (delegated) declaration.expression.begin else -1
                )
            }
            if (targetName == "compilerBindingByEnd") {
                result = bootstrapEvalInteger(
                    if (delegated) declaration.expression.end else -1
                )
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerFunctionName" ||
        targetName == "compilerFunctionCanonicalIdentity" ||
        targetName == "compilerFunctionModuleIdentity" ||
        targetName == "compilerFunctionOwner" ||
        targetName == "compilerFunctionParameterCount" ||
        targetName == "compilerFunctionParameterName" ||
        targetName == "compilerFunctionParameterType" ||
        targetName == "compilerFunctionResultType" ||
        targetName == "compilerFunctionAnnotationCount" ||
        targetName == "compilerFunctionAnnotation" ||
        targetName == "compilerFunctionAnnotationArgumentCount" ||
        targetName == "compilerFunctionAnnotationArgumentKind" ||
        targetName == "compilerFunctionAnnotationArgumentText" ||
        targetName == "compilerFunctionAnnotationArgument" ||
        targetName == "compilerFunctionIsCompileOnly" ||
        targetName == "compilerFunctionIsTrusted" ||
        targetName == "compilerFunctionIsExternal") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val validHandle = evaluator.functionHandleValid(handle)
        if (validHandle) {
            val owner = evaluator.functionHandleOwner(handle)
            val method = evaluator.functionHandleMethod(handle)
            var declarationIndex = handle
            if (owner >= 0) declarationIndex = owner
            var declaration = evaluator.declarations[declarationIndex]
            if (owner >= 0) {
                declaration = evaluator.declarations[owner].methods[method]
            }
            if (targetName == "compilerFunctionName") {
                result = bootstrapEvalString(
                    bootstrapCanonicalDeclarationSourceName(
                        declaration.name
                    )
                )
            }
            if (targetName == "compilerFunctionModuleIdentity") {
                var canonicalName = declaration.name
                if (owner >= 0) {
                    canonicalName = evaluator.declarations[owner].name
                }
                result = bootstrapEvalString(
                    bootstrapCanonicalDeclarationModuleIdentity(
                        canonicalName
                    )
                )
            }
            if (targetName == "compilerFunctionOwner") {
                var ownerName = declaration.extensionOwner
                if (owner >= 0) {
                    ownerName = evaluator.declarations[owner].name
                }
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(ownerName)
                )
            }
            if (targetName == "compilerFunctionCanonicalIdentity") {
                var identity = declaration.name
                if (owner >= 0) {
                    identity = "${evaluator.declarations[owner].name}.${declaration.name}"
                } else if (declaration.extensionOwner != "") {
                    identity = "${bootstrapNormalizeType(
                        declaration.extensionOwner
                    )}.${declaration.name}"
                }
                result = bootstrapEvalString(identity)
            }
            if (targetName == "compilerFunctionParameterCount") {
                result = bootstrapEvalInteger(declaration.parameters.size)
            }
            if (targetName == "compilerFunctionParameterName") {
                val parameter = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (parameter >= 0 &&
                    parameter < declaration.parameters.size) {
                    result = bootstrapEvalString(
                        declaration.parameters[parameter]
                    )
                } else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerFunctionParameterType") {
                val parameter = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (parameter >= 0 &&
                    parameter < declaration.parameterTypes.size) {
                    result = bootstrapEvalString(bootstrapSourceVisibleType(
                        bootstrapNormalizeType(
                            declaration.parameterTypes[parameter]
                        )
                    ))
                } else evaluator.errors = evaluator.errors + 1
            }
            if (targetName == "compilerFunctionResultType") {
                result = bootstrapEvalString(
                    bootstrapSourceVisibleType(
                        bootstrapReflectedResultType(declaration)
                    )
                )
            }
            if (targetName == "compilerFunctionAnnotationCount") {
                result = bootstrapEvalInteger(declaration.annotations.size)
            }
            if (targetName == "compilerFunctionAnnotation") {
                val annotation = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (annotation >= 0 &&
                    annotation < declaration.annotations.size) {
                    result = bootstrapEvalString(
                        declaration.annotations[annotation]
                    )
                } else evaluator.errors = evaluator.errors + 1
            }
            // An annotation's argument: `@route("/users")` has one, a bare
            // `@marker` none. Literals report their kind and text; any
            // argument is also available as a syntax handle.
            if (targetName == "compilerFunctionAnnotationArgumentCount" ||
                targetName == "compilerFunctionAnnotationArgumentKind" ||
                targetName == "compilerFunctionAnnotationArgumentText" ||
                targetName == "compilerFunctionAnnotationArgument") {
                val annotation = evaluator.evaluate(
                    expression.children[1]
                ).integer
                val argument = if (expression.children.size > 2) {
                    evaluator.evaluate(expression.children[2]).integer
                } else 0
                val present = annotation >= 0 &&
                    annotation < declaration.annotations.size &&
                    annotation < declaration.annotationArguments.size &&
                    declaration.annotationArguments[annotation].kind !=
                        "missing"
                if (annotation < 0 ||
                    annotation >= declaration.annotations.size) {
                    evaluator.errors = evaluator.errors + 1
                } else if (targetName ==
                    "compilerFunctionAnnotationArgumentCount") {
                    result = bootstrapEvalInteger(if (present) 1 else 0)
                } else if (!present || argument != 0) {
                    evaluator.errors = evaluator.errors + 1
                } else {
                    val value = declaration.annotationArguments[annotation]
                    if (targetName ==
                        "compilerFunctionAnnotationArgumentKind") {
                        result = bootstrapEvalString(value.kind)
                    }
                    if (targetName ==
                        "compilerFunctionAnnotationArgumentText") {
                        result = bootstrapEvalString(value.text)
                    }
                    if (targetName == "compilerFunctionAnnotationArgument") {
                        result = evaluator.syntaxValue(value)
                    }
                }
            }
            if (targetName == "compilerFunctionIsCompileOnly") {
                result = bootstrapEvalBoolean(
                    declaration.kind == "compile.fun"
                )
            }
            if (targetName == "compilerFunctionIsTrusted") {
                result = bootstrapEvalBoolean(declaration.isTrusted)
            }
            if (targetName == "compilerFunctionIsExternal") {
                result = bootstrapEvalBoolean(
                    declaration.kind == "extern"
                )
            }
        }
        if (!validHandle) {
            evaluator.recordInvalidFunctionHandle(targetName, handle)
        }
    }
    if (targetName == "compilerFunctionGenericSubstitutionCount" ||
        targetName == "compilerFunctionGenericSubstitutionName" ||
        targetName == "compilerFunctionGenericSubstitutionTypeHandle") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.functionHandleValid(handle)) {
            // An instance of a generic (or a method of one) carries its type
            // arguments; any other function has none.
            val owner = evaluator.functionHandleOwner(handle)
            val method = evaluator.functionHandleMethod(handle)
            val declaration = if (owner >= 0 && method >= 0) evaluator.declarations[owner].methods[method]
                else evaluator.declarations[handle]
            val names = bootstrapGenericSubstitutions(declaration, true)
            val types = bootstrapGenericSubstitutions(declaration, false)
            if (targetName ==
                "compilerFunctionGenericSubstitutionCount") {
                result = bootstrapEvalInteger(names.size)
            } else {
                val substitution = evaluator.evaluate(expression.children[1]).integer
                if (substitution < 0 || substitution >= names.size) {
                    evaluator.errors = evaluator.errors + 1
                } else if (targetName == "compilerFunctionGenericSubstitutionName") {
                    result = bootstrapEvalString(names[substitution])
                } else {
                    result = bootstrapEvalInteger(evaluator.reflectedTypeHandle(types[substitution]))
                }
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    // A generic's instances, by name (`Box`, `first`), as written
    // (`Box<i64>`).
    if (targetName == "compilerGenericInstanceCount" ||
        targetName == "compilerGenericInstanceName") {
        val generic = evaluator.evaluate(expression.children[0]).text
        val names: array<string> = []
        for (declaration in evaluator.declarations) {
            if (bootstrapIsGenericInstanceName(declaration.name) &&
                !bootstrapGenericMentionsParameter(declaration.name) &&
                bootstrapSourceVisibleType(bootstrapGenericInstanceGeneric(declaration.name)) == generic) {
                names.append(bootstrapGenericVisible(declaration.name))
            }
        }
        if (targetName == "compilerGenericInstanceCount") {
            result = bootstrapEvalInteger(names.size)
        } else {
            val wanted = evaluator.evaluate(expression.children[1]).integer
            if (wanted < 0 || wanted >= names.size) {
                evaluator.errors = evaluator.errors + 1
            } else result = bootstrapEvalString(names[wanted])
        }
    }
    // `instantiate`: from a transform, the instance is made with the
    // program's others (a generated declaration asks the generics pass for
    // it); elsewhere it must exist already. Either way, its name as written.
    if (targetName == "compilerInstantiate") {
        val spelling = evaluator.evaluate(expression.children[0]).text
        // While a round of lowering runs, the generics themselves are in its
        // raw program (the analyzed one has only their instances).
        val known: array<BootstrapDeclaration> = []
        for (declaration in evaluator.declarations) known.append(declaration)
        if (bootstrapCompileEditRound >= 0) {
            for (declaration in bootstrapCompileRoundRaw) known.append(declaration)
        }
        val table = bootstrapGenericTableOf(known)
        val generic = bootstrapGenericCalleeName(spelling)
        val template = table.findFree(generic)
        val instance = bootstrapGenericSpelledName(spelling, table)
        var exists = false
        for (declaration in evaluator.declarations) {
            if (declaration.name == instance) exists = true
        }
        var valid = template >= 0 && bootstrapIsGenericInstanceName(instance) &&
            bootstrapGenericInstanceArguments(instance).size ==
                bootstrapGenericParameterNames(table.declarations[template]).size
        if (valid && !exists) {
            if (bootstrapCompilerTransformActive) {
                valid = bootstrapStageGeneratedModule(BootstrapGeneratedModuleRequest(
                    "instantiate:$instance",
                    "@__abla_instantiate(\"$spelling\")\ncompile fun __abla_instantiate_${bootstrapGenericEscape(instance)}(): void {\n    return\n}\n"
                ))
            } else if (bootstrapCompileEditRound >= 0 && !__ablaRuntimePlatformRegionActive()) {
                // From a `#` site: an edit the next round of lowering commits
                // (bootstrapApplyDeclarationEdits), after which the instance
                // is the program's like any other.
                val origin = bootstrapCompileEditOrigin(evaluator, expression)
                bootstrapCompileRoundEdits.append(BootstrapDeclarationEdit(
                    "instantiate",
                    bootstrapGenericSourceFile(table.declarations[template].sourceIdentity),
                    "",
                    bootstrapGenericVisible(instance),
                    "",
                    spelling,
                    [],
                    origin,
                    "round ${bootstrapCompileEditRound + 1}: $origin"
                ))
            } else valid = false
        }
        if (valid) {
            result = bootstrapEvalString(bootstrapGenericVisible(instance))
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_GENERIC_INSTANTIATE",
                "compiler.instantiate(\"${generic}\", …) requires a generic class or function and one type argument per type parameter"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalString("")
        }
    }
    if (targetName == "compilerFindClass") {
        val name = bootstrapEvalGenericSpelling(evaluator, evaluator.evaluate(expression.children[0]).text)
        var handle = -1
        var declaration = 0
        while (declaration < evaluator.declarations.size) {
            if (evaluator.declarations[declaration].kind == "class" &&
                evaluator.declarations[declaration].name == name) {
                handle = declaration
            }
            declaration = declaration + 1
        }
        if (handle < 0) handle = bootstrapEvalPrivateHandle(evaluator, name, true)
        result = bootstrapEvalInteger(handle)
    }
    if (targetName == "compilerClassFieldCount" ||
        targetName == "compilerClassFieldName" ||
        targetName == "compilerClassFieldType" ||
        targetName == "compilerClassFieldIsMutable" ||
        targetName == "compilerClassFieldIsDelegated" ||
        targetName == "compilerClassFieldDelegateType") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val valid = handle >= 0 && handle < evaluator.declarations.size &&
            evaluator.declarations[handle].kind == "class"
        if (valid) {
            val declaration = evaluator.declarations[handle]
            if (targetName == "compilerClassFieldCount") {
                var count = 0
                var parameter = 0
                while (parameter < declaration.parameterKinds.size) {
                    if (declaration.parameterKinds[parameter] == "val" ||
                        declaration.parameterKinds[parameter] == "var") {
                        count = count + 1
                    }
                    parameter = parameter + 1
                }
                result = bootstrapEvalInteger(count)
            } else {
                val wanted = evaluator.evaluate(
                    expression.children[1]
                ).integer
                var field = -1
                var count = 0
                var parameter = 0
                while (parameter < declaration.parameterKinds.size) {
                    if (declaration.parameterKinds[parameter] == "val" ||
                        declaration.parameterKinds[parameter] == "var") {
                        if (count == wanted) field = parameter
                        count = count + 1
                    }
                    parameter = parameter + 1
                }
                if (field >= 0) {
                    if (targetName == "compilerClassFieldName") {
                        result = bootstrapEvalString(
                            declaration.parameters[field]
                        )
                    }
                    // A delegated property: the type it reads as, and its
                    // delegate's (what its field holds).
                    val delegated = bootstrapIsAnyDelegatedProperty(declaration, field)
                    if (targetName == "compilerClassFieldType") {
                        result = bootstrapEvalString(
                            if (delegated) bootstrapDelegatedPropertyType(declaration, field)
                            else bootstrapNormalizeType(declaration.parameterTypes[field])
                        )
                    }
                    if (targetName == "compilerClassFieldIsDelegated") {
                        result = bootstrapEvalBoolean(delegated)
                    }
                    if (targetName == "compilerClassFieldDelegateType") {
                        result = bootstrapEvalString(
                            if (bootstrapIsRewrittenDelegatedProperty(declaration, field))
                                bootstrapNormalizeType(declaration.parameterTypes[field])
                            else ""
                        )
                    }
                    if (targetName == "compilerClassFieldIsMutable") {
                        result = bootstrapEvalBoolean(
                            declaration.parameterKinds[field] == "var"
                        )
                    }
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    // A class's extension fields (`var Point.label: T = default`), in
    // declaration order: how many, and each one's name, type and mutability.
    if (targetName == "compilerExtensionFieldCount" ||
        targetName == "compilerExtensionFieldName" ||
        targetName == "compilerExtensionFieldType" ||
        targetName == "compilerExtensionFieldIsMutable") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val fields = if (handle >= 0 && handle < evaluator.declarations.size &&
            evaluator.declarations[handle].kind == "class")
            bootstrapEvalExtensionFields(evaluator.declarations, evaluator.declarations[handle].name)
            else []
        if (handle < 0 || handle >= evaluator.declarations.size ||
            evaluator.declarations[handle].kind != "class") {
            evaluator.errors = evaluator.errors + 1
        } else if (targetName == "compilerExtensionFieldCount") {
            result = bootstrapEvalInteger(fields.size)
        } else {
            val wanted = evaluator.evaluate(expression.children[1]).integer
            if (wanted < 0 || wanted >= fields.size) {
                evaluator.errors = evaluator.errors + 1
            } else {
                val field = evaluator.declarations[fields[wanted]]
                if (targetName == "compilerExtensionFieldName") {
                    result = bootstrapEvalString(field.name)
                }
                if (targetName == "compilerExtensionFieldType") {
                    result = bootstrapEvalString(bootstrapNormalizeType(field.resultType))
                }
                if (targetName == "compilerExtensionFieldIsMutable") {
                    result = bootstrapEvalBoolean(field.kind == "extension.var")
                }
            }
        }
    }
    // Declares an extension field from a transform: a generated module
    // `var Owner.name: type = default` (`val` when not mutable), checked with
    // the complete candidate program as a written one is.
    if (targetName == "compilerAddExtensionField") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val name = evaluator.evaluate(expression.children[1])
        val type = evaluator.evaluate(expression.children[2])
        val initial = evaluator.evaluate(expression.children[3])
        val mutable = evaluator.evaluate(expression.children[4])
        val valid = handle >= 0 && handle < evaluator.declarations.size &&
            evaluator.declarations[handle].kind == "class" &&
            name.kind == "string" && type.kind == "string" &&
            initial.kind == "string" && mutable.kind == "boolean" &&
            bootstrapStageGeneratedModule(BootstrapGeneratedModuleRequest(
                "extension-field:${evaluator.declarations[handle].name}.${name.text}",
                "${if (mutable.boolean) "var" else "val"} ${evaluator.declarations[handle].name}.${name.text}: ${type.text} = ${initial.text}\n"
            ))
        if (!valid) {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_EXTENSION_FIELD",
                "compiler.addExtensionField requires a class handle, a field name, a type and a default's source, inside compiler.transform"
            )
            evaluator.errors = evaluator.errors + 1
        }
        result = bootstrapEvalBoolean(valid)
    }
    // Interfaces: a class's conformances, an interface's implementers, and
    // the class's witness for one (member by member).
    if (targetName == "compilerConformanceCount" ||
        targetName == "compilerConformanceName") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle < 0 || handle >= evaluator.declarations.size ||
            evaluator.declarations[handle].kind != "class") {
            evaluator.errors = evaluator.errors + 1
        } else {
            val names = bootstrapClassInterfaces(
                evaluator.declarations, evaluator.declarations[handle].name
            )
            if (targetName == "compilerConformanceCount") {
                result = bootstrapEvalInteger(names.size)
            } else {
                val wanted = evaluator.evaluate(expression.children[1]).integer
                if (wanted < 0 || wanted >= names.size) {
                    evaluator.errors = evaluator.errors + 1
                } else result = bootstrapEvalString(bootstrapGenericVisible(names[wanted]))
            }
        }
    }
    if (targetName == "compilerImplementerCount" ||
        targetName == "compilerImplementerName") {
        val name = bootstrapEvalGenericSpelling(evaluator, evaluator.evaluate(expression.children[0]).text)
        val names: array<string> = []
        for (candidate in evaluator.declarations) {
            if (candidate.kind == "class") {
                for (conformance in bootstrapClassInterfaces(
                    evaluator.declarations, candidate.name
                )) {
                    if (conformance == name) names.append(candidate.name)
                }
            }
        }
        if (targetName == "compilerImplementerCount") {
            result = bootstrapEvalInteger(names.size)
        } else {
            val wanted = evaluator.evaluate(expression.children[1]).integer
            if (wanted < 0 || wanted >= names.size) {
                evaluator.errors = evaluator.errors + 1
            } else result = bootstrapEvalString(bootstrapGenericVisible(names[wanted]))
        }
    }
    if (targetName == "compilerWitnessCount" ||
        targetName == "compilerWitnessEntry") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val name = evaluator.evaluate(expression.children[1]).text
        var interfaceIndex = -1
        var index = 0
        while (index < evaluator.declarations.size) {
            if (evaluator.declarations[index].kind == "interface" &&
                evaluator.declarations[index].name == name) interfaceIndex = index
            index = index + 1
        }
        if (handle < 0 || handle >= evaluator.declarations.size ||
            evaluator.declarations[handle].kind != "class" || interfaceIndex < 0) {
            evaluator.errors = evaluator.errors + 1
        } else {
            val interfaceDeclaration = evaluator.declarations[interfaceIndex]
            val members = bootstrapInterfaceMembers(interfaceDeclaration)
            if (targetName == "compilerWitnessCount") {
                result = bootstrapEvalInteger(members.size)
            } else {
                val wanted = evaluator.evaluate(expression.children[2]).integer
                if (wanted < 0 || wanted >= members.size) {
                    evaluator.errors = evaluator.errors + 1
                } else {
                    val kind = bootstrapWitnessKind(
                        evaluator.declarations,
                        evaluator.declarations[handle],
                        interfaceDeclaration,
                        members[wanted]
                    )
                    result = bootstrapEvalString(
                        "${members[wanted].name}:${if (kind == "") "missing" else kind}"
                    )
                }
            }
        }
    }
    // From a transform: an interface, as a generated module.
    if (targetName == "compilerDeclareInterface") {
        val name = evaluator.evaluate(expression.children[0])
        val members = evaluator.evaluate(expression.children[1])
        val parents = evaluator.evaluate(expression.children[2])
        val valid = name.kind == "string" && members.kind == "string" &&
            parents.kind == "string" && name.text.size > 0 &&
            bootstrapStageGeneratedModule(BootstrapGeneratedModuleRequest(
                "interface:${name.text}",
                "interface ${name.text}${if (parents.text == "") "" else " : ${parents.text}"} {\n${members.text}}\n"
            ))
        if (!valid) {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_INTERFACE",
                "compiler.declareInterface requires a name and the members' sources, inside compiler.transform"
            )
            evaluator.errors = evaluator.errors + 1
        }
        result = bootstrapEvalBoolean(valid)
    }
    // From a transform: `extend <class> : name`, its members as extension
    // functions of the class (each member's source starts a line with `fun`).
    if (targetName == "compilerAddConformance") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val name = evaluator.evaluate(expression.children[1])
        val members = evaluator.evaluate(expression.children[2])
        var valid = handle >= 0 && handle < evaluator.declarations.size &&
            evaluator.declarations[handle].kind == "class" &&
            name.kind == "string" && name.text.size > 0 &&
            members.kind == "string"
        val refused = if (valid) bootstrapCompilerTransformTarget(
            evaluator.declarations, handle, "compiler.addConformance", false
        ) else ""
        if (refused != "") valid = false
        if (valid) {
            val owner = evaluator.declarations[handle].name
            var source = "extend $owner : ${name.text}\n"
            var lineStart = true
            var index = 0
            while (index < members.text.size) {
                if (lineStart && index + 4 <= members.text.size &&
                    members.text.slice(index, index + 4) == "fun ") {
                    source = "${source}fun $owner."
                    index = index + 4
                    lineStart = false
                } else {
                    source = "$source${members.text.slice(index, index + 1)}"
                    lineStart = members.text[index] == 10
                    index = index + 1
                }
            }
            valid = bootstrapStageGeneratedModule(BootstrapGeneratedModuleRequest(
                "conformance:$owner:${name.text}", source
            ))
        }
        if (refused != "") {
            evaluator.diagnostics = "${evaluator.diagnostics}$refused"
            evaluator.errors = evaluator.errors + 1
        } else if (!valid) {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_INTERFACE",
                "compiler.addConformance requires a class handle, an interface name and the members' sources (each starting `fun`), inside compiler.transform"
            )
            evaluator.errors = evaluator.errors + 1
        }
        result = bootstrapEvalBoolean(valid)
    }
    // Removes one of the transform's own module's extension fields (with its
    // default function) before analysis.
    if (targetName == "compilerRemoveExtensionField") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val name = evaluator.evaluate(expression.children[1])
        var field = -1
        if (handle >= 0 && handle < evaluator.declarations.size &&
            evaluator.declarations[handle].kind == "class" && name.kind == "string") {
            for (candidate in bootstrapEvalExtensionFields(
                evaluator.declarations, evaluator.declarations[handle].name
            )) {
                if (evaluator.declarations[candidate].name == name.text) field = candidate
            }
        }
        val refused = if (field >= 0) bootstrapCompilerTransformTarget(
            evaluator.declarations, field, "compiler.removeExtensionField", true
        ) else ""
        val library = field < 0 || refused != "" || !bootstrapCompilerTransformActive ||
            bootstrapCompilerLibraryChange(
                evaluator, field, "compiler.removeExtensionField", bootstrapCompilerTransformOrigin
            )
        val valid = field >= 0 && refused == "" && bootstrapCompilerTransformActive && library
        if (valid && bootstrapCompilerTransformOwns(field)) {
            bootstrapExtensionFieldRemovals.append(
                "${evaluator.declarations[handle].name}.${name.text}"
            )
        } else if (valid) {
            bootstrapTransformEdits.append(BootstrapDeclarationEdit(
                "removeField",
                evaluator.declarations[field].sourceIdentity,
                evaluator.declarations[handle].name,
                name.text,
                "",
                "",
                [],
                bootstrapCompilerTransformOrigin,
                "transform"
            ))
        } else if (refused != "") {
            evaluator.diagnostics = "${evaluator.diagnostics}$refused"
            evaluator.errors = evaluator.errors + 1
        } else if (!library) {
            bootstrapSemanticUnit()
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_EXTENSION_FIELD",
                "compiler.removeExtensionField requires a class handle and the name of one of its extension fields, inside compiler.transform"
            )
            evaluator.errors = evaluator.errors + 1
        }
        result = bootstrapEvalBoolean(valid)
    }
    // Literal top-level `#compilerRegisterSubparser`, `#compilerGrant` and
    // `#compilerGenerateModule` actions are collected from source before any
    // compile-time code runs and are never evaluated. Reaching one here means
    // compile-time code called it.
    if (targetName == "compilerRegisterSubparser") {
        var argument = 0
        while (argument < expression.children.size) {
            evaluator.evaluate(expression.children[argument])
            argument = argument + 1
        }
        evaluator.recordEvaluatorDiagnostic(
            "E_EXT_SUBPARSER_REGISTRATION",
            "compilerRegisterSubparser registers a subparser only as a literal top-level action (`#compilerRegisterSubparser(\"name\", handler)`): subparsers are registered before any compile-time code runs"
        )
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalVoid()
    }
    if (targetName == "compilerGrant") {
        evaluator.evaluate(expression.children[0])
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILE_GRANT_PHASE",
            "compilerGrant grants a capability only as a literal top-level action (`#compilerGrant(\"capability\")`), so that every grant is visible in source"
        )
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalVoid()
    }
    if (targetName == "compilerGenerateModule") {
        val namespace = evaluator.evaluate(expression.children[0])
        val source = evaluator.evaluate(expression.children[1])
        if (!bootstrapCompilerTransformActive) {
            evaluator.recordEvaluatorDiagnostic(
                "E_EXT_GENERATED_MODULE_PHASE",
                "compilerGenerateModule adds a module only as a literal top-level action or from a compiler.transform handler, which run before the program is analyzed; this call ran after"
            )
            evaluator.errors = evaluator.errors + 1
        } else if (namespace.kind != "string" || source.kind != "string" ||
            !bootstrapStageGeneratedModule(BootstrapGeneratedModuleRequest(
                namespace.text, source.text
            ))) {
            evaluator.recordEvaluatorDiagnostic(
                "E_EXT_GENERATED_MODULE_REQUEST",
                "compilerGenerateModule requires a unique non-empty namespace and at most 65536 bytes of source"
            )
            evaluator.errors = evaluator.errors + 1
        }
        result = bootstrapEvalVoid()
    }
    if (targetName == "compilerReplaceFunctionBody") {
        val reflected = evaluator.evaluate(expression.children[0])
        val body = evaluator.evaluate(expression.children[1])
        var valid = reflected.kind == "integer" &&
            body.kind == "string" &&
            evaluator.functionHandleValid(reflected.integer) &&
            reflected.integer < evaluator.declarations.size &&
            evaluator.declarations[reflected.integer].kind == "fun"
        val refused = if (valid) bootstrapCompilerTransformTarget(
            evaluator.declarations, reflected.integer, "compiler.replaceFunctionBody", true
        ) else ""
        if (refused != "") {
            valid = false
            evaluator.diagnostics = "${evaluator.diagnostics}$refused"
        }
        val origin = if (bootstrapCompilerTransformActive) bootstrapCompilerTransformOrigin
            else bootstrapCompileEditOrigin(evaluator, expression)
        var library = true
        if (valid) {
            library = bootstrapCompilerLibraryChange(
                evaluator, reflected.integer, "compiler.replaceFunctionBody", origin
            )
            valid = library
        }
        // From a `#` site while the program is lowered: an edit the next round
        // of lowering commits.
        if (valid && !bootstrapCompilerTransformActive && bootstrapCompileEditRound >= 0) {
            valid = body.text.size > 0 && body.text.size <= 65536 &&
                bootstrapStageCompileRoundEdit(
                    evaluator.declarations, reflected.integer, "replaceBody", body.text,
                    bootstrapCompileEditOrigin(evaluator, expression)
                )
        } else if (valid) valid = bootstrapStageFunctionBodyReplacement(
            BootstrapFunctionBodyReplacement(
                reflected.integer,
                body.text
            )
        )
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else if (refused != "") {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        } else if (!library) {
            result = bootstrapEvalBoolean(false)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_REQUEST",
                "compiler.replaceFunctionBody requires one unique top-level runtime function handle and a bounded body inside compiler.transform"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerAddFunctionAnnotation") {
        val reflected = evaluator.evaluate(expression.children[0])
        val annotation = evaluator.evaluate(expression.children[1])
        var valid = reflected.kind == "integer" &&
            annotation.kind == "string" &&
            evaluator.functionHandleValid(reflected.integer) &&
            reflected.integer < evaluator.declarations.size &&
            evaluator.declarations[reflected.integer].kind == "fun"
        val refused = if (valid) bootstrapCompilerTransformTarget(
            evaluator.declarations, reflected.integer, "compiler.addFunctionAnnotation", false
        ) else ""
        if (refused != "") {
            valid = false
            evaluator.diagnostics = "${evaluator.diagnostics}$refused"
        }
        if (valid && !bootstrapCompilerTransformActive && bootstrapCompileEditRound >= 0) {
            valid = bootstrapTargetTokenValid(annotation.text) &&
                bootstrapStageCompileRoundEdit(
                    evaluator.declarations, reflected.integer, "annotate", annotation.text,
                    bootstrapCompileEditOrigin(evaluator, expression)
                )
        } else if (valid) valid = bootstrapStageFunctionAnnotationAddition(
            BootstrapFunctionAnnotationAddition(
                reflected.integer,
                annotation.text
            )
        )
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else if (refused != "") {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_COMPILER_TRANSFORM_ANNOTATION",
                "compiler.addFunctionAnnotation requires a unique top-level runtime function, a valid annotation name, and compiler.transform context"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerApplyTransform") {
        // This marker is consumed before final semantic analysis. Reaching
        // it in an ordinary evaluator is always a staging error.
        evaluator.recordEvaluatorDiagnostic(
            "E_COMPILER_TRANSFORM_PHASE",
            "compiler.transform is only valid as a top-level compile action"
        )
        evaluator.errors = evaluator.errors + 1
        result = bootstrapEvalBoolean(false)
    }
    if (targetName == "compilerContributeArtifactRoot") {
        val name = evaluator.evaluate(expression.children[0])
        val target = evaluator.evaluate(expression.children[1])
        val artifact = evaluator.evaluate(expression.children[2])
        val output = evaluator.evaluate(expression.children[3])
        val reflected = evaluator.evaluate(expression.children[4])
        val exportName = evaluator.evaluate(expression.children[5])
        val fast = evaluator.evaluate(expression.children[6])
        val cache = evaluator.evaluate(expression.children[7])
        var valid = name.kind == "string" && target.kind == "string" &&
            artifact.kind == "string" && output.kind == "string" &&
            reflected.kind == "integer" &&
            exportName.kind == "string" && fast.kind == "boolean" &&
            cache.kind == "boolean" &&
            reflected.integer >= 0 &&
            reflected.integer < evaluator.declarations.size &&
            evaluator.declarations[reflected.integer].kind == "fun"
        var conflict = false
        var functionName = ""
        if (valid) {
            val declaration = evaluator.declarations[reflected.integer]
            functionName = declaration.name
            val resultType = bootstrapNormalizeType(
                declaration.resultType
            )
            valid = declaration.extensionOwner == "" &&
                (resultType == "void" || resultType == "bool" ||
                 resultType == "i64")
            var parameter = 0
            while (valid && parameter < declaration.parameters.size) {
                val parameterType = bootstrapNormalizeType(
                    declaration.parameterTypes[parameter]
                )
                valid = declaration.parameterKinds[parameter] ==
                    "parameter" &&
                    (parameterType == "bool" || parameterType == "i64")
                parameter = parameter + 1
            }
            var matches = 0
            var candidate = 0
            while (candidate < evaluator.declarations.size) {
                if (evaluator.declarations[candidate].name == functionName &&
                    (evaluator.declarations[candidate].kind == "fun" ||
                     evaluator.declarations[candidate].kind == "extern" ||
                     evaluator.declarations[candidate].kind == "compile.fun")) {
                    matches = matches + 1
                }
                candidate = candidate + 1
            }
            if (matches != 1) valid = false
        }
        if (valid && !bootstrapArtifactSliceActive) {
            valid = bootstrapStageArtifactRootRequest(
                BootstrapArtifactRootRequest(
                    name.text,
                    target.text,
                    artifact.text,
                    output.text,
                    functionName,
                    exportName.text,
                    fast.boolean,
                    cache.boolean
                )
            )
            if (!valid) conflict = true
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            if (conflict) {
                evaluator.recordEvaluatorDiagnostic(
                    "E_ARTIFACT_ROOT_CONFLICT",
                    "compiler.contributeArtifactRoot conflicts with an existing contribution for artifact `${name.text}`; one artifact requires consistent settings and one declaration/export mapping"
                )
            } else {
                evaluator.recordEvaluatorDiagnostic(
                    "E_ARTIFACT_ROOT_REQUEST",
                    "compiler.contributeArtifactRoot requires a unique top-level bool/int function and one consistent bounded artifact contribution"
                )
            }
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerNewIndependentModule") {
        val name = evaluator.evaluate(expression.children[0])
        var handle = -1
        var valid = bootstrapArtifactSliceActive ||
            (name.kind == "string" &&
             bootstrapTargetTokenValid(name.text) &&
             bootstrapIndependentModules.size < 32)
        var module = 0
        while (valid && !bootstrapArtifactSliceActive &&
               module < bootstrapIndependentModules.size) {
            if (bootstrapIndependentModules[module].name == name.text) {
                valid = false
            }
            module = module + 1
        }
        if (valid && !bootstrapArtifactSliceActive) {
            handle = bootstrapIndependentModules.size
            bootstrapIndependentModules.append(
                BootstrapIndependentModuleState(
                    name.text,
                    [], [], [], [], [], [], [], [], [],
                    false
                )
            )
        }
        if (valid) {
            result = bootstrapEvalInteger(handle)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_CREATE",
                "compiler.newModule requires a unique bounded module name"
            )
            evaluator.errors = evaluator.errors + 1
        }
    }
    if (targetName == "compilerIndependentModuleUse") {
        val module = evaluator.evaluate(expression.children[0])
        val reflected = evaluator.evaluate(expression.children[1])
        val annotations = evaluator.evaluate(expression.children[2])
        val exportName = evaluator.evaluate(expression.children[3])
        val checkedExport = evaluator.evaluate(expression.children[4])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             reflected.kind == "integer" &&
             annotations.kind == "array" &&
             exportName.kind == "string" &&
             checkedExport.kind == "boolean" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             reflected.integer >= 0 &&
             reflected.integer < evaluator.declarations.size)
        var functionName = ""
        var sourceIdentity = ""
        if (valid && !bootstrapArtifactSliceActive) {
            val declaration = evaluator.declarations[reflected.integer]
            functionName = declaration.name
            sourceIdentity = declaration.sourceIdentity
            valid = declaration.kind == "fun" &&
                declaration.extensionOwner == "" &&
                bootstrapIndependentModuleSourceValid(sourceIdentity)
            if (valid && exportName.text != "") {
                valid = bootstrapExportNameValid(exportName.text)
            }
            var matches = 0
            var candidate = 0
            while (candidate < evaluator.declarations.size) {
                val found = evaluator.declarations[candidate]
                if ((found.kind == "fun" || found.kind == "extern" ||
                     found.kind == "compile.fun") &&
                    found.extensionOwner == "" &&
                    found.name == functionName) matches = matches + 1
                candidate = candidate + 1
            }
            valid = valid && matches == 1
            var annotation = 0
            while (valid && annotation < annotations.elements.size) {
                val addition = annotations.elements[annotation]
                valid = addition.kind == "string" &&
                    bootstrapTargetTokenValid(addition.text)
                var existing = 0
                while (valid && existing < declaration.annotations.size) {
                    if (declaration.annotations[existing] == addition.text) {
                        valid = false
                    }
                    existing = existing + 1
                }
                var previous = 0
                while (valid && previous < annotation) {
                    if (annotations.elements[previous].text ==
                        addition.text) valid = false
                    previous = previous + 1
                }
                annotation = annotation + 1
            }
        }
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && state.functionNames.size < 128
            var exported = 0
            while (valid && exportName.text != "" &&
                   exported < state.exportNames.size) {
                if (state.exportNames[exported] == exportName.text) {
                    valid = false
                }
                exported = exported + 1
            }
            if (valid) {
                val additions: array<string> = []
                var annotation = 0
                while (annotation < annotations.elements.size) {
                    additions.append(annotations.elements[annotation].text)
                    annotation = annotation + 1
                }
                state.functionNames.append(functionName)
                state.sourceIdentities.append(sourceIdentity)
                state.functionAnnotations.append(additions)
                if (exportName.text != "") {
                    state.exportSourceNames.append(functionName)
                    state.exportNames.append(exportName.text)
                    state.checkedExports.append(checkedExport.boolean)
                }
            }
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_USE",
                "independent module use requires a live module, one unique top-level runtime function reference, new annotation identifiers, and an optional unique valid export"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleExport") {
        val module = evaluator.evaluate(expression.children[0])
        val sourceName = evaluator.evaluate(expression.children[1])
        val exportName = evaluator.evaluate(expression.children[2])
        val checked = evaluator.evaluate(expression.children[3])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             sourceName.kind == "string" &&
             bootstrapIndependentDeclarationNameValid(sourceName.text) &&
             exportName.kind == "string" &&
             bootstrapExportNameValid(exportName.text) &&
             checked.kind == "boolean")
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && state.exportNames.size < 128
            var existing = 0
            while (valid && existing < state.exportNames.size) {
                if (state.exportNames[existing] == exportName.text) {
                    valid = false
                }
                existing = existing + 1
            }
            if (valid) {
                state.exportSourceNames.append(sourceName.text)
                state.exportNames.append(exportName.text)
                state.checkedExports.append(checked.boolean)
            }
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_EXPORT",
                "independent module export requires a live un-emitted module, one declaration identifier, and one unique valid foreign export name"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleDeclare") {
        val module = evaluator.evaluate(expression.children[0])
        val declarations = evaluator.evaluate(expression.children[1])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             declarations.kind == "declaration.block" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             declarations.text.size > 0 &&
             declarations.text.size <= 1048576 &&
             bootstrapIndependentModuleSourceValid(declarations.owner))
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && state.declarationSources.size < 32
            if (valid) {
                state.declarationSources.append(declarations.text)
                state.declarationSourceIdentities.append(declarations.owner)
            }
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_DECLARE",
                "independent module declare requires a declaration block owned by compile-time source and a live un-emitted module"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleDeclareGenerated") {
        val module = evaluator.evaluate(expression.children[0])
        val declarations = evaluator.evaluate(expression.children[1])
        var source = ""
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             declarations.kind == "generated.module" &&
             bootstrapIndependentModuleHandleValid(module.integer))
        if (valid && !bootstrapArtifactSliceActive) {
            var declaration = 0
            while (declaration < declarations.elements.size) {
                if (declarations.elements[declaration].kind ==
                    "generated.declaration") {
                    source = "$source${declarations.elements[declaration].text}"
                }
                declaration = declaration + 1
            }
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted && source.size > 0 &&
                source.size <= 1048576 &&
                state.generatedDeclarationSources.size < 32
            if (valid) state.generatedDeclarationSources.append(source)
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_DECLARE_GENERATED",
                "independent module generated declarations require a non-empty compiler-owned builder and a live un-emitted module"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerIndependentModuleEmit") {
        val module = evaluator.evaluate(expression.children[0])
        val output = evaluator.evaluate(expression.children[1])
        val target = evaluator.evaluate(expression.children[2])
        val artifact = evaluator.evaluate(expression.children[3])
        val fast = evaluator.evaluate(expression.children[4])
        val cache = evaluator.evaluate(expression.children[5])
        var valid = bootstrapArtifactSliceActive ||
            (module.kind == "integer" &&
             bootstrapIndependentModuleHandleValid(module.integer) &&
             output.kind == "string" &&
             bootstrapCompileOutputPathValid(output.text) &&
             target.kind == "string" &&
             bootstrapTargetTokenValid(target.text) &&
             artifact.kind == "string" &&
             bootstrapTargetTokenValid(artifact.text) &&
             fast.kind == "boolean" && cache.kind == "boolean")
        if (valid && !bootstrapArtifactSliceActive) {
            val state = bootstrapIndependentModules[module.integer]
            valid = !state.emitted &&
                (state.declarationSources.size > 0 ||
                 state.generatedDeclarationSources.size > 0 ||
                 state.exportNames.size > 0)
            val sources: array<string> = []
            var used = 0
            while (valid && used < state.sourceIdentities.size) {
                val source = bootstrapIndependentModuleSourcePath(
                    state.sourceIdentities[used]
                )
                if (!bootstrapIndependentModuleHasSource(sources, source)) {
                    sources.append(source)
                }
                used = used + 1
            }
            var block = 0
            while (valid && block <
                   state.declarationSourceIdentities.size) {
                val source = bootstrapIndependentModuleSourcePath(
                    state.declarationSourceIdentities[block]
                )
                if (!bootstrapIndependentModuleHasSource(sources, source)) {
                    sources.append(source)
                }
                block = block + 1
            }
            var source = ""
            var imported = 0
            while (valid && imported < sources.size) {
                source = "${source}import ${evaluator.generatedStringLiteral(sources[imported])}\n"
                imported = imported + 1
            }
            var annotationCount = 0
            used = 0
            while (used < state.functionAnnotations.size) {
                annotationCount = annotationCount +
                    state.functionAnnotations[used].size
                used = used + 1
            }
            if (annotationCount > 0 || state.exportNames.size > 0) {
                source = "${source}import \"abla/compiler\"\n"
            }
            if (annotationCount > 0) {
                source = "${source}compile fun __abla_independent_annotations(): void {\n"
                used = 0
                while (used < state.functionNames.size) {
                    var annotation = 0
                    while (annotation <
                           state.functionAnnotations[used].size) {
                        val functionLiteral = evaluator.generatedStringLiteral(
                            state.functionNames[used]
                        )
                        val annotationLiteral = evaluator.generatedStringLiteral(
                            state.functionAnnotations[used][annotation]
                        )
                        source = "${source}    compiler.addFunctionAnnotation(compiler.findFunction($functionLiteral), $annotationLiteral)\n"
                        annotation = annotation + 1
                    }
                    used = used + 1
                }
                source = "${source}    return\n}\n#compiler.transform(__abla_independent_annotations)\n"
            }
            block = 0
            while (block < state.declarationSources.size) {
                source = "${source}${state.declarationSources[block]}\n"
                block = block + 1
            }
            block = 0
            while (block < state.generatedDeclarationSources.size) {
                source = "${source}${state.generatedDeclarationSources[block]}\n"
                block = block + 1
            }
            if (state.exportNames.size > 0) {
                var exported = 0
                while (exported < state.exportNames.size) {
                    val sourceLiteral = evaluator.generatedStringLiteral(
                        state.exportSourceNames[exported]
                    )
                    val exportLiteral = evaluator.generatedStringLiteral(
                        state.exportNames[exported]
                    )
                    var method = "exportFunction"
                    if (state.checkedExports[exported]) {
                        method = "exportCheckedFunction"
                    }
                    source = "${source}#compiler.$method(compiler.findFunction($sourceLiteral), $exportLiteral)\n"
                    exported = exported + 1
                }
            }
            val entry =
                "build/.abla-independent/${state.name}.abla-independent.ab"
            if (valid) valid = bootstrapStageToolchainOutput(entry, source)
            if (valid) valid = bootstrapStageCompileProgramRequest(
                BootstrapCompileProgramRequest(
                    state.name, entry, output.text, target.text,
                    artifact.text, fast.boolean, cache.boolean
                )
            )
            if (valid) state.emitted = true
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            evaluator.recordEvaluatorDiagnostic(
                "E_INDEPENDENT_MODULE_EMIT",
                "independent module emit requires a live module with declarations and one valid, unique program output"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerBuildProgram") {
        val name = evaluator.evaluate(expression.children[0])
        val entry = evaluator.evaluate(expression.children[1])
        val output = evaluator.evaluate(expression.children[2])
        val target = evaluator.evaluate(expression.children[3])
        val artifact = evaluator.evaluate(expression.children[4])
        val fast = evaluator.evaluate(expression.children[5])
        val cache = evaluator.evaluate(expression.children[6])
        var valid = name.kind == "string" && name.text.size > 0 &&
            name.text.size <= 128 && entry.kind == "string" &&
            bootstrapCompileOutputPathValid(entry.text) &&
            output.kind == "string" &&
            bootstrapCompileOutputPathValid(output.text) &&
            target.kind == "string" && target.text.size > 0 &&
            target.text.size <= 128 && artifact.kind == "string" &&
            artifact.text.size > 0 && artifact.text.size <= 64 &&
            fast.kind == "boolean" && cache.kind == "boolean"
        if (valid) {
            valid = bootstrapStageCompileProgramRequest(
                BootstrapCompileProgramRequest(
                    name.text, entry.text, output.text, target.text,
                    artifact.text, fast.boolean, cache.boolean
                )
            )
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            bootstrapStageDriverDiagnostic(
                "error[E_BUILD_PROGRAM_REQUEST]: compilerBuildProgram received an invalid or duplicate program node\n"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerDefineTarget") {
        val name = evaluator.evaluate(expression.children[0])
        val triple = evaluator.evaluate(expression.children[1])
        val format = evaluator.evaluate(expression.children[2])
        val linker = evaluator.evaluate(expression.children[3])
        val emulation = evaluator.evaluate(expression.children[4])
        val hosted = evaluator.evaluate(expression.children[5])
        val libcFree = evaluator.evaluate(expression.children[6])
        var valid = name.kind == "string" &&
            triple.kind == "string" && format.kind == "string" &&
            linker.kind == "string" && emulation.kind == "string" &&
            hosted.kind == "boolean" && libcFree.kind == "boolean"
        if (valid && !bootstrapArtifactSliceActive) {
            valid = bootstrapStageDefinedTarget(
            BootstrapDefinedTarget(
                name.text,
                triple.text,
                format.text,
                linker.text,
                emulation.text,
                hosted.boolean,
                libcFree.boolean
            )
            )
        }
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            bootstrapStageDriverDiagnostic(
                "error[E_BUILD_TARGET_DEFINITION]: compilerDefineTarget received an invalid or duplicate bounded target descriptor\n"
            )
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerExportFunction" ||
        targetName == "compilerInternalFunction" ||
        targetName == "compilerRequiredInternalFunction" ||
        targetName == "compilerExportCheckedFunction") {
        val reflected = evaluator.evaluate(expression.children[0])
        val exportName = evaluator.evaluate(expression.children[1])
        var valid = reflected.kind == "integer" &&
            exportName.kind == "string" &&
            (if (targetName == "compilerInternalFunction" ||
                targetName == "compilerRequiredInternalFunction") {
                bootstrapLinkerSymbolNameValid(exportName.text)
            } else bootstrapExportNameValid(exportName.text)) &&
            evaluator.functionHandleValid(reflected.integer) &&
            reflected.integer >= 0 &&
            reflected.integer < evaluator.declarations.size
        var source = ""
        var resultType = ""
        var reflectedKind = reflected.kind
        var declarationKind = "out-of-range"
        if (reflected.integer >= 0 &&
            reflected.integer < evaluator.declarations.size) {
            declarationKind =
                evaluator.declarations[reflected.integer].kind
        }
        val parameterNames: array<string> = []
        val parameterTypes: array<string> = []
        if (valid) {
            val declaration = evaluator.declarations[reflected.integer]
            source = declaration.name
            resultType = bootstrapExportRuntimeType(
                evaluator.declarations, declaration.resultType
            )
            valid = declaration.kind == "fun" &&
                declaration.parameters.size <= 16 &&
                bootstrapExportResultTypeValid(resultType)
            var parameter = 0
            while (valid && parameter < declaration.parameters.size) {
                val parameterType = bootstrapExportRuntimeType(
                    evaluator.declarations,
                    declaration.parameterTypes[parameter]
                )
                valid = declaration.parameterKinds[parameter] ==
                    "parameter" &&
                    bootstrapExportParameterTypeValid(parameterType)
                if (valid &&
                    parameterType == "function:(i64)->i64") {
                    valid = bootstrapExportCallbackUseValid(
                        declaration.expression,
                        declaration.parameters[parameter]
                    )
                }
                if (valid) {
                    parameterNames.append(
                        declaration.parameters[parameter]
                    )
                    parameterTypes.append(parameterType)
                }
                parameter = parameter + 1
            }
        }
        var declarationPath = ""
        if (bootstrapArtifactSliceActive) {
            val path = evaluator.slicePathFromReachableUnsupported(
                reflected.integer,
                [],
                evaluator.declarations[reflected.integer].name
            )
            if (path != "") {
                declarationPath = path
                valid = false
            }
        }
        if (valid) valid = bootstrapStageExportRequest(
            BootstrapExportRequest(
                source,
                exportName.text,
                resultType,
                parameterNames,
                parameterTypes,
                targetName == "compilerExportCheckedFunction",
                targetName == "compilerInternalFunction" ||
                    targetName == "compilerRequiredInternalFunction",
                targetName == "compilerRequiredInternalFunction"
            )
        )
        if (valid) {
            result = bootstrapEvalBoolean(true)
        } else {
            if (declarationPath == "") {
                val symbolRequirement =
                    if (targetName == "compilerInternalFunction" ||
                        targetName == "compilerRequiredInternalFunction") {
                        "a unique bounded linker symbol name"
                    } else "a unique non-reserved C identifier"
                bootstrapStageDriverDiagnostic(
                    "error[E_EXPORT_SIGNATURE_UNSUPPORTED]: $targetName rejected $reflectedKind handle ${reflected.integer} (declaration `$declarationKind`, source `$source`, result `$resultType`, export `${exportName.text}`); it requires $symbolRequirement and a top-level function with at most 16 value bool, fixed-width integer/char/f32/f64, copied borrowed-string, or direct non-escaping (i64)->i64 callback parameters, returning void, a supported scalar, or owned string\n"
                )
            } else {
                bootstrapStageDriverDiagnostic(
                    "error[E_ARTIFACT_SLICE_REACHABILITY]: compilerExportFunction rejected $reflectedKind handle ${reflected.integer} (declaration `$declarationKind`, source `$source`, result `$resultType`, export `${exportName.text}`); selected root `${source}` cannot be included because it reaches unsupported declaration `${declarationPath}`\n"
                )
            }
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalBoolean(false)
        }
    }
    if (targetName == "compilerRecordExtensionRequest" ||
        targetName == "compilerRecordGeneratedExtensionRequest") {
        val namespace = evaluator.evaluate(expression.children[0])
        val payload = evaluator.evaluate(expression.children[1])
        val syntaxHandle = evaluator.evaluate(expression.children[2])
        val finalizer = evaluator.evaluate(expression.children[3])
        var sourceIdentity = "<unknown>"
        if (evaluator.cursors.size > 0) {
            sourceIdentity = evaluator.cursors[0].sourceIdentity
        }
        if (namespace.kind == "string" && namespace.text != "" &&
            payload.kind == "string" && syntaxHandle.kind == "syntax" &&
            syntaxHandle.integer >= 0 &&
            syntaxHandle.integer < evaluator.syntax.size &&
            finalizer.kind == "function" &&
            evaluator.extensionRequests.size < 256) {
            evaluator.extensionRequests.append(BootstrapExtensionRequest(
                namespace.text,
                payload.text,
                evaluator.syntaxAt(syntaxHandle.integer),
                finalizer.text,
                targetName == "compilerRecordGeneratedExtensionRequest",
                sourceIdentity,
                ""
            ))
        } else {
            var reason = "request limit exceeded"
            if (finalizer.kind != "function") {
                reason = "finalizer is not a compile-time function"
            }
            if (syntaxHandle.kind != "syntax" ||
                syntaxHandle.integer < 0 ||
                syntaxHandle.integer >= evaluator.syntax.size) {
                reason = "expression is not a live syntax handle"
            }
            if (payload.kind != "string") {
                reason = "payload is not a string"
            }
            if (namespace.kind != "string" || namespace.text == "") {
                reason = "namespace must be a non-empty string"
            }
            var origin = BootstrapExpression(
                "invalid", "", expression.begin, expression.end, []
            )
            if (syntaxHandle.kind == "syntax" &&
                syntaxHandle.integer >= 0 &&
                syntaxHandle.integer < evaluator.syntax.size) {
                origin = evaluator.syntaxAt(syntaxHandle.integer)
            }
            evaluator.extensionRequests.append(BootstrapExtensionRequest(
                if (namespace.kind == "string") namespace.text
                    else "<invalid>",
                if (payload.kind == "string") payload.text else "",
                origin,
                if (finalizer.kind == "function") finalizer.text else "",
                targetName == "compilerRecordGeneratedExtensionRequest",
                sourceIdentity,
                "extension.request:${if (namespace.kind == "string") namespace.text else "<invalid>"}:$sourceIdentity:${origin.begin}:${origin.end}:$reason\n"
            ))
            evaluator.errors = evaluator.errors + 1
        }
        result = bootstrapEvalVoid()
    }
    result
}

@noinline
fun bootstrapEvaluateCallHost(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "ablaHostReadFile") {
        if (bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 4)) {
            val path = evaluator.evaluate(expression.children[0])
            // The compile-time file view (ct_native.ab): staged files too.
            val read = ctNativeViewRead(evaluator, path.text, true)
            result = bootstrapEvalString(if (read.succeeded) read.text else "")
        } else {
            // Parser staging precedes full semantic analysis. Reject the
            // invocation here so an unauthorized handler cannot touch the
            // host merely because its eventual program would be denied, with
            // the denial its body (`Path(path).readText()`) would report.
            result = ctNativeDenied(evaluator, "call to `Path.readText`", 4)
        }
    }
    if (targetName == "ablaHostListDirectory") {
        // A directory's entry names, sorted (bytewise) so a build sees the same order
        // on every host; [] when it doesn't exist.
        if (bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 4)) {
            val path = evaluator.evaluate(expression.children[0])
            val names = bootstrapSortedNames(ctNativeViewEntries(evaluator, path.text))
            var listing = ""
            val elements: array<BootstrapEvalValue> = []
            var index = 0
            while (index < names.size) {
                elements.append(bootstrapEvalString(names[index]))
                listing = "$listing${names[index]}\n"
                index = index + 1
            }
            evaluator.recordCompileInput("abla-input:directory:${path.text}", listing)
            result = bootstrapEvalArray(elements)
        } else {
            // As its body (`Path(path).entries()`) would be denied.
            result = ctNativeDenied(evaluator, "call to `Path.entries`", 4)
        }
    }
    if (targetName == "compilerWriteFile") {
        val path = evaluator.evaluate(expression.children[0])
        val contents = evaluator.evaluate(expression.children[1])
        if (path.kind == "string" && contents.kind == "string" &&
            bootstrapCompileEffectHas(
                evaluator.allowedCompileEffects,
                8
            )) {
            result = bootstrapEvalBoolean(bootstrapStageCompileOutput(
                path.text,
                contents.text
            ))
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerEnvironment") {
        val name = evaluator.evaluate(expression.children[0])
        var valid = name.kind == "string" && name.text.size > 0 &&
            name.text.size <= 256
        var index = 0
        while (valid && index < name.text.size) {
            if (name.text[index] == 0 || name.text[index] == 61) {
                valid = false
            }
            index = index + 1
        }
        if (valid && bootstrapCompileEffectHas(
            evaluator.allowedCompileEffects,
            16
        )) {
            val observed = linuxEnvironment(name.text)
            val contents = if (observed.found) observed.value else ""
            evaluator.recordCompileInput(
                "abla-input:environment:${name.text}",
                contents
            )
            result = bootstrapEvalString(contents)
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerClockMilliseconds") {
        if (bootstrapCompileEffectHas(
            evaluator.allowedCompileEffects,
            128
        )) {
            result = bootstrapEvalInteger(linuxMonotonicMilliseconds())
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerRandomInteger") {
        val maximum = evaluator.evaluate(expression.children[0])
        if (maximum.kind == "integer" && maximum.integer > 0 &&
            bootstrapCompileEffectHas(
                evaluator.allowedCompileEffects,
                256
            )) {
            result = bootstrapEvalInteger(
                linuxRandomInteger(maximum.integer)
            )
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerRunProcess") {
        val arguments = evaluator.evaluate(expression.children[0])
        var valid = arguments.kind == "array" &&
            arguments.elements.size > 0 &&
            arguments.elements.size <= 128
        var argument = 0
        while (valid && argument < arguments.elements.size) {
            val value = arguments.elements[argument]
            if (value.kind != "string" || value.text.size > 4096) {
                valid = false
            }
            argument = argument + 1
        }
        if (valid && bootstrapCompileEffectHas(
            evaluator.allowedCompileEffects,
            32
        )) {
            val command = linuxCommand(arguments.elements[0].text)
            argument = 1
            while (argument < arguments.elements.size) {
                command.argument(arguments.elements[argument].text)
                argument = argument + 1
            }
            result = bootstrapEvalInteger(command.run())
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    if (targetName == "compilerTcpExchange") {
        val address = evaluator.evaluate(expression.children[0])
        val port = evaluator.evaluate(expression.children[1])
        val request = evaluator.evaluate(expression.children[2])
        val maximum = evaluator.evaluate(expression.children[3])
        val timeout = evaluator.evaluate(expression.children[4])
        var valid = address.kind == "string" &&
            port.kind == "integer" && request.kind == "string" &&
            maximum.kind == "integer" && timeout.kind == "integer" &&
            request.text.size <= 1048576 && maximum.integer > 0 &&
            maximum.integer <= 1048576 && timeout.integer > 0 &&
            timeout.integer <= 10000 &&
            bootstrapCompileEffectHas(evaluator.allowedCompileEffects, 64)
        if (valid) {
            val connection = tcpConnectIpv4(
                address.text,
                port.integer,
                timeout.integer
            )
            var response = ""
            if (connection.descriptor >= 0) {
                val written = connection.write(request.text)
                if (written == request.text.size) {
                    response = connection.readWithTimeout(
                        maximum.integer,
                        timeout.integer
                    )
                }
                connection.close()
            }
            result = bootstrapEvalString(response)
        } else {
            evaluator.errors = evaluator.errors + 1
            result = bootstrapEvalInvalid()
        }
    }
    result
}

@noinline
fun bootstrapEvaluateCallParser(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "parserExpect") {
        val cursor = evaluator.evaluate(expression.children[0])
        val expected = evaluator.evaluate(expression.children[1])
        evaluator.cursors[cursor.integer].expect(expected.text)
        result = bootstrapEvalVoid()
    }
    if (targetName == "parserAt") {
        val cursor = evaluator.evaluate(expression.children[0])
        val expected = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].at(expected.text)
        )
    }
    if (targetName == "parserConsume") {
        val cursor = evaluator.evaluate(expression.children[0])
        val expected = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].consume(expected.text)
        )
    }
    if (targetName == "parserCurrentText") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].currentText()
        )
    }
    if (targetName == "parserTextAhead") {
        val cursor = evaluator.evaluate(expression.children[0])
        val ahead = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].textAhead(ahead.integer)
        )
    }
    if (targetName == "parserRawAt") {
        val cursor = evaluator.evaluate(expression.children[0])
        val text = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].rawAt(text.text)
        )
    }
    if (targetName == "parserRawConsume") {
        val cursor = evaluator.evaluate(expression.children[0])
        val text = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].rawConsume(text.text)
        )
    }
    if (targetName == "parserRawExpect") {
        val cursor = evaluator.evaluate(expression.children[0])
        val text = evaluator.evaluate(expression.children[1])
        evaluator.cursors[cursor.integer].rawExpect(text.text)
        result = bootstrapEvalVoid()
    }
    if (targetName == "parserRawTakeUntil") {
        val cursor = evaluator.evaluate(expression.children[0])
        val delimiters = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeUntil(delimiters.text)
        )
    }
    if (targetName == "parserRawTakeUntilText") {
        val cursor = evaluator.evaluate(expression.children[0])
        val delimiter = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeUntilText(delimiter.text)
        )
    }
    if (targetName == "parserRawLineRecordsValid") {
        val source = evaluator.evaluate(expression.children[0])
        val directiveCatalog = evaluator.evaluate(expression.children[1])
        result = bootstrapEvalBoolean(bootstrapRawLineRecordsValid(
            source.text, directiveCatalog.text
        ))
    }
    if (targetName == "parserRawInsertAfterTopLevelRecord") {
        val source = evaluator.evaluate(expression.children[0])
        val record = evaluator.evaluate(expression.children[1])
        val insertion = evaluator.evaluate(expression.children[2])
        result = bootstrapEvalString(
            bootstrapRawInsertAfterTopLevelRecord(
                source.text, record.text, insertion.text
            )
        )
    }
    if (targetName == "parserRawInsertBeforeTopLevelRecord") {
        val source = evaluator.evaluate(expression.children[0])
        val record = evaluator.evaluate(expression.children[1])
        val insertion = evaluator.evaluate(expression.children[2])
        result = bootstrapEvalString(
            bootstrapRawInsertBeforeTopLevelRecord(
                source.text, record.text, insertion.text
            )
        )
    }
    if (targetName == "parserRawGuardNestedEntries") {
        val source = evaluator.evaluate(expression.children[0])
        val entryRecord = evaluator.evaluate(expression.children[1])
        val beforeEntry = evaluator.evaluate(expression.children[2])
        val afterEntry = evaluator.evaluate(expression.children[3])
        result = bootstrapEvalString(
            bootstrapRawGuardNestedEntries(
                source.text,
                entryRecord.text,
                beforeEntry.text,
                afterEntry.text
            )
        )
    }
    if (targetName == "parserRawWrapTopLevelRecord") {
        val source = evaluator.evaluate(expression.children[0])
        val record = evaluator.evaluate(expression.children[1])
        val beforeRecord = evaluator.evaluate(expression.children[2])
        val afterRecord = evaluator.evaluate(expression.children[3])
        result = bootstrapEvalString(
            bootstrapRawWrapTopLevelRecord(
                source.text,
                record.text,
                beforeRecord.text,
                afterRecord.text
            )
        )
    }
    if (targetName == "parserRawTakeName") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeName()
        )
    }
    if (targetName == "parserRawTakeSymbol") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].rawTakeSymbol()
        )
    }
    if (targetName == "parserRawSkipWhitespace") {
        val cursor = evaluator.evaluate(expression.children[0])
        evaluator.cursors[cursor.integer].rawSkipWhitespace()
        result = bootstrapEvalVoid()
    }
    if (targetName == "parserRawEnd") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalBoolean(
            evaluator.cursors[cursor.integer].rawEnd()
        )
    }
    if (targetName == "parserRawPosition") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalInteger(
            evaluator.cursors[cursor.integer].rawPosition
        )
    }
    if (targetName == "parserSourceIdentity") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = bootstrapEvalString(
            evaluator.cursors[cursor.integer].sourceIdentity
        )
    }
    // A failure a subparser reports while a stack-depth stop unwinds through
    // it follows from that stop, which is the one diagnostic.
    if (targetName == "parserFail" && bootstrapEvalDepthReported) {
        result = bootstrapEvalVoid()
    } else if (targetName == "parserFail") {
        val cursor = evaluator.evaluate(expression.children[0])
        val message = evaluator.evaluate(expression.children[1])
        evaluator.recordEvaluatorDiagnostic(
            "E_SUBPARSER_FAILURE",
            if (message.kind == "string" && message.text != "")
                message.text
            else "subparser reported a failure"
        )
        evaluator.diagnostics =
            "${evaluator.diagnostics}source[subparser]:${evaluator.cursors[cursor.integer].sourceIdentity}:${evaluator.cursors[cursor.integer].rawPosition}:${evaluator.cursors[cursor.integer].rawPosition}\n"
        evaluator.cursors[cursor.integer].errors =
            evaluator.cursors[cursor.integer].errors + 1
        result = bootstrapEvalVoid()
    }
    // While a stack-depth stop unwinds, the text left at the cursor is not
    // parsed: it is the rest of the literal the stop gave up on, as deep as
    // the stop, and the native parser would descend it on what little stack
    // the stop left.
    if (targetName == "parserParseAblaExpression" && bootstrapEvalDepthReported) {
        result = evaluator.syntaxValue(BootstrapExpression(
            "invalid", "subparser", expression.begin, expression.end, []
        ))
    } else if (targetName == "parserParseAblaExpression") {
        val cursor = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(
            evaluator.cursors[cursor.integer].parseAblaExpression()
        )
    }
    result
}

@noinline
fun bootstrapEvaluateCallSyntax(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "syntaxKind" || targetName == "syntaxText" ||
        targetName == "syntaxChildCount" ||
        targetName == "syntaxBegin" || targetName == "syntaxEnd") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size) {
            val inspected = evaluator.syntax[handle]
            if (targetName == "syntaxKind") {
                result = bootstrapEvalString(inspected.kind)
            }
            if (targetName == "syntaxText") {
                result = bootstrapEvalString(inspected.text)
            }
            if (targetName == "syntaxChildCount") {
                result = bootstrapEvalInteger(inspected.children.size)
            }
            if (targetName == "syntaxBegin") {
                result = bootstrapEvalInteger(inspected.begin)
            }
            if (targetName == "syntaxEnd") {
                result = bootstrapEvalInteger(inspected.end)
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxChild") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val index = evaluator.evaluate(expression.children[1]).integer
        if (handle >= 0 && handle < evaluator.syntax.size && index >= 0 &&
            index < evaluator.syntax[handle].children.size) {
            val child = evaluator.syntax[handle].children[index]
            result = evaluator.syntaxValue(child)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxInteger") {
        val value = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(bootstrapSyntaxInteger(value.integer))
    }
    if (targetName == "syntaxString") {
        val value = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(bootstrapSyntaxString(value.text))
    }
    if (targetName == "syntaxBoolean") {
        val value = evaluator.evaluate(expression.children[0])
        if (value.kind == "boolean") {
            val literal = if (value.boolean) "true" else "false"
            result = evaluator.syntaxValue(BootstrapExpression(
                literal,
                literal,
                0,
                0,
                []
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxNull") {
        result = evaluator.syntaxValue(BootstrapExpression(
            "null", "", 0, 0, []
        ))
    }
    if (targetName == "syntaxIdentifier") {
        val value = evaluator.evaluate(expression.children[0])
        result = evaluator.syntaxValue(bootstrapSyntaxIdentifier(
            bootstrapSubparserVisibleName(value.text)
        ))
    }
    if (targetName == "syntaxBinary") {
        val operation = evaluator.evaluate(expression.children[0])
        val left = evaluator.evaluate(expression.children[1])
        val right = evaluator.evaluate(expression.children[2])
        result = evaluator.syntaxValue(bootstrapSyntaxBinary(
            operation.text,
            evaluator.syntaxAt(left.integer),
            evaluator.syntaxAt(right.integer)
        ))
    }
    if (targetName == "syntaxArray") {
        val values = evaluator.evaluate(expression.children[0])
        val elements: array<BootstrapExpression> = []
        var element = 0
        while (element < values.elements.size) {
            elements.append(evaluator.syntaxAt(values.elements[element].integer))
            element = element + 1
        }
        result = evaluator.syntaxValue(bootstrapSyntaxArray(elements))
    }
    if (targetName == "syntaxCall") {
        val name = evaluator.evaluate(expression.children[0])
        val values = evaluator.evaluate(expression.children[1])
        val arguments: array<BootstrapExpression> = []
        var argument = 0
        while (argument < values.elements.size) {
            arguments.append(evaluator.syntaxAt(values.elements[argument].integer))
            argument = argument + 1
        }
        result = evaluator.syntaxValue(bootstrapSyntaxCall(
            bootstrapSubparserVisibleName(name.text), arguments
        ))
    }
    if (targetName == "syntaxCallTarget" ||
        targetName == "syntaxMethodCallTarget") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        var receiver = bootstrapEvalInvalid()
        var valuesIndex = 1
        if (targetName == "syntaxMethodCallTarget") {
            receiver = evaluator.evaluate(expression.children[1])
            valuesIndex = 2
        }
        val values = evaluator.evaluate(expression.children[valuesIndex])
        val owner = evaluator.functionHandleOwner(handle)
        val method = evaluator.functionHandleMethod(handle)
        var valid = evaluator.functionHandleValid(handle) &&
            values.kind == "array"
        if (targetName == "syntaxCallTarget" && owner >= 0) valid = false
        if (targetName == "syntaxMethodCallTarget" &&
            (receiver.kind != "syntax" || receiver.integer < 0 ||
             receiver.integer >= evaluator.syntax.size)) valid = false
        var declarationIndex = handle
        if (owner >= 0) declarationIndex = owner
        var declarationName = ""
        var extensionOwner = ""
        if (valid) {
            declarationName = evaluator.declarations[declarationIndex].name
            extensionOwner =
                evaluator.declarations[declarationIndex].extensionOwner
            if (owner >= 0) {
                declarationName =
                    evaluator.declarations[owner].methods[method].name
                extensionOwner = evaluator.declarations[owner].name
            }
            if (targetName == "syntaxMethodCallTarget" && owner < 0 &&
                extensionOwner == "") valid = false
            if (targetName == "syntaxCallTarget" &&
                extensionOwner != "") valid = false
        }
        val arguments: array<BootstrapExpression> = []
        var argument = 0
        while (valid && argument < values.elements.size) {
            val syntaxHandle = values.elements[argument].integer
            if (values.elements[argument].kind != "syntax" ||
                syntaxHandle < 0 || syntaxHandle >= evaluator.syntax.size) {
                valid = false
            } else arguments.append(evaluator.syntax[syntaxHandle])
            argument = argument + 1
        }
        if (valid && targetName == "syntaxCallTarget") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "call",
                declarationName,
                0 - handle - 1,
                0,
                arguments
            ))
        }
        if (valid && targetName == "syntaxMethodCallTarget") {
            val children: array<BootstrapExpression> = [
                evaluator.syntaxAt(receiver.integer)
            ]
            argument = 0
            while (argument < arguments.size) {
                children.append(arguments[argument])
                argument = argument + 1
            }
            result = evaluator.syntaxValue(BootstrapExpression(
                "member.call",
                declarationName,
                0 - handle - 1,
                0,
                children
            ))
        }
        if (!valid) evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxMember") {
        val receiver = evaluator.evaluate(expression.children[0])
        val name = evaluator.evaluate(expression.children[1])
        if (receiver.kind == "syntax" &&
            evaluator.generatedIdentifierPart(name.text) == name.text) {
            result = evaluator.syntaxValue(BootstrapExpression(
                "member",
                name.text,
                0,
                0,
                [evaluator.syntaxAt(receiver.integer)]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxIndex") {
        val receiver = evaluator.evaluate(expression.children[0])
        val index = evaluator.evaluate(expression.children[1])
        if (receiver.kind == "syntax" && index.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "index",
                "",
                0,
                0,
                [evaluator.syntaxAt(receiver.integer), evaluator.syntaxAt(index.integer)]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxIf") {
        val condition = evaluator.evaluate(expression.children[0])
        val thenExpression = evaluator.evaluate(expression.children[1])
        val elseExpression = evaluator.evaluate(expression.children[2])
        if (condition.kind == "syntax" &&
            thenExpression.kind == "syntax" &&
            elseExpression.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "if",
                "",
                0,
                0,
                [
                    evaluator.syntaxAt(condition.integer),
                    evaluator.syntaxAt(thenExpression.integer),
                    evaluator.syntaxAt(elseExpression.integer)
                ]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxReturn") {
        val value = evaluator.evaluate(expression.children[0])
        if (value.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "return", "", 0, 0, [evaluator.syntaxAt(value.integer)]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxBlock") {
        val values = evaluator.evaluate(expression.children[0])
        val statements: array<BootstrapExpression> = []
        var statement = 0
        var valid = values.kind == "array"
        while (valid && statement < values.elements.size) {
            val value = values.elements[statement]
            if (value.kind == "syntax" && value.integer >= 0 &&
                value.integer < evaluator.syntax.size) {
                statements.append(evaluator.syntaxAt(value.integer))
            } else valid = false
            statement = statement + 1
        }
        if (valid) {
            result = evaluator.syntaxValue(BootstrapExpression(
                "block", "", 0, 0, statements
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxLocal" ||
        targetName == "syntaxVariable") {
        val name = evaluator.evaluate(expression.children[0])
        val typeHandle = evaluator.evaluate(expression.children[1]).integer
        val initializer = evaluator.evaluate(expression.children[2])
        if (name.kind == "string" &&
            evaluator.generatedIdentifierPart(name.text) == name.text &&
            evaluator.reflectedTypeValid(typeHandle) &&
            initializer.kind == "syntax") {
            var kind = "local.val"
            if (targetName == "syntaxVariable") kind = "local.var"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind,
                name.text,
                0,
                0,
                [
                    evaluator.syntaxAt(initializer.integer),
                    BootstrapExpression(
                        "type", evaluator.reflectedTypes[typeHandle], 0, 0, []
                    )
                ]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxAssign") {
        val name = evaluator.evaluate(expression.children[0])
        val value = evaluator.evaluate(expression.children[1])
        if (name.kind == "string" &&
            evaluator.generatedIdentifierPart(name.text) == name.text &&
            value.kind == "syntax") {
            result = evaluator.syntaxValue(BootstrapExpression(
                "assign", bootstrapSubparserVisibleName(name.text), 0, 0,
                [evaluator.syntaxAt(value.integer)]
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxLambda") {
        val names = evaluator.evaluate(expression.children[0])
        val types = evaluator.evaluate(expression.children[1])
        val body = evaluator.evaluate(expression.children[2])
        val moving = evaluator.evaluate(expression.children[3])
        var valid = names.kind == "array" && types.kind == "array" &&
            names.elements.size == types.elements.size &&
            body.kind == "syntax" && moving.kind == "boolean"
        val children: array<BootstrapExpression> = []
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val name = names.elements[parameter]
            val type = types.elements[parameter]
            if (name.kind != "string" ||
                evaluator.generatedIdentifierPart(name.text) != name.text ||
                type.kind != "integer" ||
                !evaluator.reflectedTypeValid(type.integer)) {
                valid = false
            } else children.append(BootstrapExpression(
                "lambda.parameter", name.text, 0, 0,
                [BootstrapExpression(
                    "type", evaluator.reflectedTypes[type.integer], 0, 0, []
                )]
            ))
            parameter = parameter + 1
        }
        if (valid) {
            children.append(evaluator.syntaxAt(body.integer))
            var kind = "lambda"
            if (moving.boolean) kind = "lambda.move"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind, "", 0, 0, children
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "syntaxInferredLambda") {
        val names = evaluator.evaluate(expression.children[0])
        val body = evaluator.evaluate(expression.children[1])
        val moving = evaluator.evaluate(expression.children[2])
        var valid = names.kind == "array" && body.kind == "syntax" &&
            moving.kind == "boolean"
        val children: array<BootstrapExpression> = []
        val used: array<string> = []
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val name = names.elements[parameter]
            var duplicate = false
            var previous = 0
            while (!duplicate && previous < used.size) {
                if (used[previous] == name.text) duplicate = true
                previous = previous + 1
            }
            if (name.kind != "string" ||
                evaluator.generatedIdentifierPart(name.text) != name.text ||
                duplicate) {
                valid = false
            } else {
                used.append(name.text)
                children.append(BootstrapExpression(
                    "lambda.parameter", name.text, 0, 0,
                    [BootstrapExpression("type", "unknown", 0, 0, [])]
                ))
            }
            parameter = parameter + 1
        }
        if (valid) {
            children.append(evaluator.syntaxAt(body.integer))
            var kind = "lambda"
            if (moving.boolean) kind = "lambda.move"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind, "", 0, 0, children
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
fun bootstrapEvaluateCallGenerated(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "compilerGeneratedModule") {
        val namespace = evaluator.evaluate(expression.children[0])
        val origin = evaluator.evaluate(expression.children[1])
        if (namespace.kind == "string" && namespace.text != "" &&
            origin.kind == "syntax" && origin.integer >= 0 &&
            origin.integer < evaluator.syntax.size) {
            result = BootstrapEvalValue(
                "generated.module",
                evaluator.syntaxAt(origin.integer).begin,
                false,
                namespace.text,
                [BootstrapEvalValue(
                    "generated.origin",
                    evaluator.syntaxAt(origin.integer).end,
                    false,
                    "",
                    [],
                    "",
                    []
                )],
                "",
                []
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedLiftedFunction") {
        val module = evaluator.evaluate(expression.children[0])
        val hint = evaluator.evaluate(expression.children[1])
        val captures = evaluator.evaluate(expression.children[2])
        val names = evaluator.evaluate(expression.children[3])
        val types = evaluator.evaluate(expression.children[4])
        val mutableCaptures = evaluator.evaluate(expression.children[5])
        val resultType = evaluator.evaluate(expression.children[6]).integer
        val body = evaluator.evaluate(expression.children[7])
        var valid = module.kind == "generated.module" &&
            hint.kind == "string" && captures.kind == "array" &&
            names.kind == "array" && types.kind == "array" &&
            mutableCaptures.kind == "array" &&
            captures.elements.size == names.elements.size &&
            names.elements.size == types.elements.size &&
            types.elements.size == mutableCaptures.elements.size &&
            evaluator.reflectedTypeValid(resultType) && body.kind == "syntax" &&
            module.elements.size < 256
        var ownershipValid = true
        var mutableValid = true
        val captureNames: array<string> = []
        val parameterNames: array<string> = []
        val parameterTypes: array<string> = []
        val parameterKinds: array<string> = []
        val parameterDefaults: array<BootstrapExpression> = []
        var source = ""
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val capture = captures.elements[parameter]
            val name = names.elements[parameter]
            val type = types.elements[parameter]
            val mutable = mutableCaptures.elements[parameter]
            if (capture.kind != "string" || name.kind != "string" ||
                type.kind != "integer" || mutable.kind != "boolean" ||
                evaluator.generatedIdentifierPart(capture.text) != capture.text ||
                evaluator.generatedIdentifierPart(name.text) != name.text ||
                !evaluator.reflectedTypeValid(type.integer)) {
                valid = false
            } else {
                val typeName = evaluator.reflectedTypes[type.integer]
                if (bootstrapIsBorrowType(typeName) ||
                    bootstrapSummaryTypeIsAffine(
                        typeName,
                        evaluator.affineTypes
                    )) {
                    valid = false
                    ownershipValid = false
                }
                captureNames.append(capture.text)
                parameterNames.append(name.text)
                parameterTypes.append(typeName)
                parameterKinds.append(
                    if (mutable.boolean) "var" else "parameter"
                )
                parameterDefaults.append(BootstrapExpression(
                    "missing", "", module.integer, module.integer, []
                ))
                if (parameter > 0) source = "$source, "
                if (mutable.boolean) source = "${source}var "
                source = "$source${name.text}: $typeName"
            }
            parameter = parameter + 1
        }
        if (valid) {
            val bodyExpression = evaluator.syntaxAt(body.integer)
            val bodySummary = evaluator.accessSummaryForExpression(
                bodyExpression
            )
            val bodyContext = evaluator.accessContainingHandle(bodyExpression)
            var capture = 0
            while (capture < captureNames.size &&
                capture < mutableCaptures.elements.size) {
                if (!mutableCaptures.elements[capture].boolean) {
                    val root = evaluator.accessRootPath(
                        captureNames[capture],
                        bodyContext,
                        [],
                        []
                    )
                    var write = 0
                    while (write < bodySummary.writes.size) {
                        val candidate = bodySummary.writes[write]
                        if (candidate.rootKind == root.rootKind &&
                            candidate.rootIdentity == root.rootIdentity &&
                            candidate.rootParameter == root.rootParameter) {
                            mutableValid = false
                        }
                        write = write + 1
                    }
                    if (bodySummary.writesUnknown) mutableValid = false
                }
                capture = capture + 1
            }
            if (!mutableValid) valid = false
        }
        val bound: array<string> = []
        val validity = BootstrapLiftValidity(Cell(valid))
        var rewritten = BootstrapExpression(
            "invalid", "lift", module.integer, module.integer, []
        )
        if (valid) rewritten = evaluator.rewriteLiftedExpression(
            evaluator.syntaxAt(body.integer),
            captureNames,
            parameterNames,
            bound,
            validity
        )
        valid = validity.valid.get()
        val generatedName = evaluator.generatedDeclarationName(
            module,
            hint.text
        )
        if (generatedName == "") valid = false
        if (valid) {
            val resultName = evaluator.reflectedTypes[resultType]
            var rendered = "fun $generatedName($source): $resultName "
            if (rewritten.kind != "block") rendered = "$rendered= "
            rendered = "$rendered${evaluator.generatedSyntaxSource(
                rewritten,
                0
            )}\n"
            if (rendered.size > 65536) valid = false
            if (valid) {
                var originEnd = module.integer
                if (module.elements.size > 0 &&
                    module.elements[0].kind == "generated.origin") {
                    originEnd = module.elements[0].integer
                }
                val declarationIndex = evaluator.generatedDeclarations.size
                evaluator.generatedDeclarations.append(BootstrapDeclaration(
                    "fun",
                    generatedName,
                    module.integer,
                    originEnd,
                    rewritten,
                    parameterNames,
                    parameterTypes,
                    evaluator.reflectedTypes[resultType],
                    [],
                    parameterDefaults,
                    "",
                    parameterKinds,
                    "",
                    false,
                    false,
                    false,
                    module.text,
                    module.integer,
                    originEnd,
                    [],
                    [],
                    [],
                    [],
                    ""
                ))
                module.elements.append(BootstrapEvalValue(
                    "generated.declaration",
                    declarationIndex,
                    false,
                    rendered,
                    [],
                    "",
                    []
                ))
                module.fieldNames.append(generatedName)
                result = bootstrapEvalString(generatedName)
            }
        }
        if (!valid) {
            if (!ownershipValid) evaluator.recordEvaluatorDiagnostic(
                "E_REACTIVE_LIFT_OWNERSHIP",
                "generated lifted function cannot capture a borrowed or affine value"
            )
            else if (!mutableValid) evaluator.recordEvaluatorDiagnostic(
                "E_REACTIVE_HANDLER_CAPTURE",
                "generated lifted function writes through a capture that was not declared mutable"
            )
            else evaluator.recordEvaluatorDiagnostic(
                "E_REACTIVE_LIFT_FREE_VARIABLE",
                "generated lifted function has an invalid or unlisted free variable"
            )
        }
    }
    if (targetName == "compilerGeneratedFunction" ||
        targetName == "compilerGeneratedExportFunction") {
        val module = evaluator.evaluate(expression.children[0])
        val hint = evaluator.evaluate(expression.children[1])
        val names = evaluator.evaluate(expression.children[2])
        val types = evaluator.evaluate(expression.children[3])
        val resultType = evaluator.evaluate(expression.children[4]).integer
        val body = evaluator.evaluate(expression.children[5])
        var valid = module.kind == "generated.module" &&
            hint.kind == "string" && names.kind == "array" &&
            types.kind == "array" &&
            names.elements.size == types.elements.size &&
            evaluator.reflectedTypeValid(resultType) && body.kind == "syntax" &&
            module.elements.size < 256
        var generatedName = evaluator.generatedDeclarationName(module, hint.text)
        if (targetName == "compilerGeneratedExportFunction") {
            generatedName = evaluator.generatedExportName(module, hint.text)
        }
        if (generatedName == "") valid = false
        var source = "fun $generatedName("
        val generatedParameterNames: array<string> = []
        val generatedParameterTypes: array<string> = []
        val generatedParameterDefaults: array<BootstrapExpression> = []
        val generatedParameterKinds: array<string> = []
        var parameter = 0
        while (valid && parameter < names.elements.size) {
            val parameterName = names.elements[parameter]
            val parameterType = types.elements[parameter]
            if (parameterName.kind != "string" ||
                evaluator.generatedIdentifierPart(parameterName.text) !=
                    parameterName.text ||
                parameterType.kind != "integer" ||
                !evaluator.reflectedTypeValid(parameterType.integer)) {
                valid = false
            } else {
                if (parameter > 0) source = "$source, "
                val parameterTypeName =
                    evaluator.reflectedTypes[parameterType.integer]
                generatedParameterNames.append(parameterName.text)
                generatedParameterTypes.append(parameterTypeName)
                generatedParameterDefaults.append(BootstrapExpression(
                    "missing", "", module.integer, module.integer, []
                ))
                generatedParameterKinds.append("parameter")
                source = "$source${parameterName.text}: $parameterTypeName"
            }
            parameter = parameter + 1
        }
        if (valid) {
            val generatedResultType = evaluator.reflectedTypes[resultType]
            source = "$source): $generatedResultType "
            val bodyExpression = evaluator.syntaxAt(body.integer)
            if (bodyExpression.kind != "block") source = "$source= "
            source = "$source${evaluator.generatedSyntaxSource(
                bodyExpression, 0
            )}\n"
            if (source.size > 65536) valid = false
        }
        if (valid) {
            var originEnd = module.integer
            if (module.elements.size > 0 &&
                module.elements[0].kind == "generated.origin") {
                originEnd = module.elements[0].integer
            }
            val declarationIndex = evaluator.generatedDeclarations.size
            evaluator.generatedDeclarations.append(BootstrapDeclaration(
                "fun",
                generatedName,
                module.integer,
                originEnd,
                evaluator.syntaxAt(body.integer),
                generatedParameterNames,
                generatedParameterTypes,
                evaluator.reflectedTypes[resultType],
                [],
                generatedParameterDefaults,
                "",
                generatedParameterKinds,
                "",
                false,
                false,
                false,
                module.text,
                module.integer,
                originEnd,
                [],
                [],
                [],
                [],
                ""
            ))
            module.elements.append(BootstrapEvalValue(
                "generated.declaration",
                declarationIndex,
                false,
                source,
                [],
                "",
                []
            ))
            module.fieldNames.append(generatedName)
            result = bootstrapEvalString(generatedName)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedValue") {
        val module = evaluator.evaluate(expression.children[0])
        val hint = evaluator.evaluate(expression.children[1])
        val typeHandle = evaluator.evaluate(expression.children[2]).integer
        val initializer = evaluator.evaluate(expression.children[3])
        var valid = module.kind == "generated.module" &&
            hint.kind == "string" &&
            evaluator.reflectedTypeValid(typeHandle) &&
            initializer.kind == "syntax" && module.elements.size < 256
        val generatedName = evaluator.generatedDeclarationName(module, hint.text)
        if (generatedName == "") valid = false
        if (valid) {
            val typeName = evaluator.reflectedTypes[typeHandle]
            val initializerSource = evaluator.generatedSyntaxSource(
                evaluator.syntaxAt(initializer.integer), 0
            )
            val source = "val $generatedName: $typeName = $initializerSource\n"
            if (source.size <= 65536) {
                var originEnd = module.integer
                if (module.elements.size > 0 &&
                    module.elements[0].kind == "generated.origin") {
                    originEnd = module.elements[0].integer
                }
                val declarationIndex = evaluator.generatedDeclarations.size
                evaluator.generatedDeclarations.append(BootstrapDeclaration(
                    "val",
                    generatedName,
                    module.integer,
                    originEnd,
                    evaluator.syntaxAt(initializer.integer),
                    [],
                    [],
                    typeName,
                    [],
                    [],
                    "",
                    [],
                    "",
                    false,
                    false,
                    false,
                    module.text,
                    module.integer,
                    originEnd,
                    [],
                    [],
                    [],
                    [],
                    ""
                ))
                module.elements.append(BootstrapEvalValue(
                    "generated.declaration",
                    declarationIndex,
                    false,
                    source,
                    [],
                    "",
                    []
                ))
                module.fieldNames.append(generatedName)
                result = bootstrapEvalString(generatedName)
            } else valid = false
        }
        if (!valid) evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedModuleSource") {
        val module = evaluator.evaluate(expression.children[0])
        if (module.kind == "generated.module") {
            var source = ""
            var declaration = 0
            while (declaration < module.elements.size) {
                source = "$source${module.elements[declaration].text}"
                declaration = declaration + 1
            }
            result = bootstrapEvalString(source)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedDeclarationCount") {
        val module = evaluator.evaluate(expression.children[0])
        if (module.kind == "generated.module") {
            result = bootstrapEvalInteger(
                evaluator.generatedDeclarationCount(module)
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedDeclarationNamespace" ||
        targetName == "compilerGeneratedDeclarationOriginBegin" ||
        targetName == "compilerGeneratedDeclarationOriginEnd") {
        val module = evaluator.evaluate(expression.children[0])
        val ordinal = evaluator.evaluate(expression.children[1]).integer
        val declarationIndex = evaluator.generatedDeclarationAt(
            module,
            ordinal
        )
        if (declarationIndex >= 0) {
            val declaration = evaluator.generatedDeclarations[declarationIndex]
            if (targetName ==
                "compilerGeneratedDeclarationNamespace") {
                result = bootstrapEvalString(
                    declaration.generatedNamespace
                )
            }
            if (targetName ==
                "compilerGeneratedDeclarationOriginBegin") {
                result = bootstrapEvalInteger(
                    declaration.generatedOriginBegin
                )
            }
            if (targetName ==
                "compilerGeneratedDeclarationOriginEnd") {
                result = bootstrapEvalInteger(
                    declaration.generatedOriginEnd
                )
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "compilerGeneratedDeclarationReference" ||
        targetName == "compilerGeneratedDeclarationCall") {
        val module = evaluator.evaluate(expression.children[0])
        val ordinal = evaluator.evaluate(expression.children[1]).integer
        val declarationIndex = evaluator.generatedDeclarationAt(
            module, ordinal
        )
        val arguments: array<BootstrapExpression> = []
        var valid = declarationIndex >= 0
        if (targetName == "compilerGeneratedDeclarationCall") {
            val values = evaluator.evaluate(expression.children[2])
            valid = valid && values.kind == "array"
            var argument = 0
            while (valid && argument < values.elements.size) {
                val value = values.elements[argument]
                if (value.kind == "syntax" && value.integer >= 0 &&
                    value.integer < evaluator.syntax.size) {
                    arguments.append(evaluator.syntaxAt(value.integer))
                } else valid = false
                argument = argument + 1
            }
        }
        if (valid) {
            val declaration = evaluator.generatedDeclarations[declarationIndex]
            var kind = "identifier"
            if (targetName ==
                "compilerGeneratedDeclarationCall") kind = "call"
            result = evaluator.syntaxValue(BootstrapExpression(
                kind,
                declaration.name,
                0,
                -1,
                arguments
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

@noinline
fun bootstrapEvaluateCallTyped(
    var evaluator: BootstrapEvaluator,
    expression: BootstrapExpression,
    targetName: string,
    initial: BootstrapEvalValue
): BootstrapEvalValue {
    var result = initial
    if (targetName == "typedExpressionReadCount" ||
        targetName == "typedExpressionRead" ||
        targetName == "typedExpressionWriteCount" ||
        targetName == "typedExpressionWrite" ||
        targetName == "typedExpressionConsumeCount" ||
        targetName == "typedExpressionConsume" ||
        targetName == "typedExpressionReadsUnknown" ||
        targetName == "typedExpressionWritesUnknown") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.typedCallIndex(evaluator.syntax[handle]) >= 0) {
            val summary = evaluator.accessSummaryForExpression(
                evaluator.syntax[handle]
            )
            if (targetName == "typedExpressionReadCount") {
                result = bootstrapEvalInteger(summary.reads.size)
            }
            if (targetName == "typedExpressionWriteCount") {
                result = bootstrapEvalInteger(summary.writes.size)
            }
            if (targetName == "typedExpressionConsumeCount") {
                result = bootstrapEvalInteger(summary.consumes.size)
            }
            if (targetName == "typedExpressionReadsUnknown") {
                result = bootstrapEvalBoolean(summary.readsUnknown)
            }
            if (targetName == "typedExpressionWritesUnknown") {
                result = bootstrapEvalBoolean(summary.writesUnknown)
            }
            if (targetName == "typedExpressionRead" ||
                targetName == "typedExpressionWrite" ||
                targetName == "typedExpressionConsume") {
                val index = evaluator.evaluate(expression.children[1]).integer
                var valid = false
                if (targetName == "typedExpressionRead" && index >= 0 &&
                    index < summary.reads.size) {
                    result = evaluator.accessPathValue(summary.reads[index])
                    valid = true
                }
                if (targetName == "typedExpressionWrite" && index >= 0 &&
                    index < summary.writes.size) {
                    result = evaluator.accessPathValue(summary.writes[index])
                    valid = true
                }
                if (targetName == "typedExpressionConsume" && index >= 0 &&
                    index < summary.consumes.size) {
                    result = evaluator.accessPathValue(summary.consumes[index])
                    valid = true
                }
                if (!valid) evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.recordEvaluatorDiagnostic(
            "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
            "typed access reflection requires a resolved deferred expression"
        )
    }
    if (targetName == "typedFunctionReadCount" ||
        targetName == "typedFunctionRead" ||
        targetName == "typedFunctionWriteCount" ||
        targetName == "typedFunctionWrite" ||
        targetName == "typedFunctionReadsUnknown" ||
        targetName == "typedFunctionWritesUnknown") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (evaluator.functionHandleValid(handle)) {
            val summary = evaluator.accessSummaryForFunctionAt(
                handle,
                0,
                []
            )
            if (targetName == "typedFunctionReadCount") {
                result = bootstrapEvalInteger(summary.reads.size)
            }
            if (targetName == "typedFunctionWriteCount") {
                result = bootstrapEvalInteger(summary.writes.size)
            }
            if (targetName == "typedFunctionReadsUnknown") {
                result = bootstrapEvalBoolean(summary.readsUnknown)
            }
            if (targetName == "typedFunctionWritesUnknown") {
                result = bootstrapEvalBoolean(summary.writesUnknown)
            }
            if (targetName == "typedFunctionRead" ||
                targetName == "typedFunctionWrite") {
                val index = evaluator.evaluate(expression.children[1]).integer
                val paths = if (targetName == "typedFunctionRead") {
                    summary.reads
                } else summary.writes
                if (index >= 0 && index < paths.size) {
                    result = evaluator.accessPathValue(paths[index])
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.recordInvalidFunctionHandle(targetName, handle)
    }
    if (targetName == "typedExpressionHasEffect") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val effectName = evaluator.evaluate(expression.children[1])
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.typedCallIndex(evaluator.syntax[handle]) >= 0 &&
            effectName.kind == "string") {
            val effect = bootstrapCompileEffectFromName(effectName.text)
            if (effect > 0) result = bootstrapEvalBoolean(
                bootstrapCompileEffectHas(
                    evaluator.accessExpressionEffectMask(evaluator.syntax[handle]),
                    effect
                )
            )
            else evaluator.errors = evaluator.errors + 1
        } else evaluator.recordEvaluatorDiagnostic(
            "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
            "typed effect reflection requires a resolved deferred expression"
        )
    }
    if (targetName == "typedFunctionHasEffect") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val effectName = evaluator.evaluate(expression.children[1])
        if (evaluator.functionHandleValid(handle) &&
            effectName.kind == "string") {
            val effect = bootstrapCompileEffectFromName(effectName.text)
            if (effect > 0) result = bootstrapEvalBoolean(
                bootstrapCompileEffectHas(
                    evaluator.accessFunctionEffectMask(handle),
                    effect
                )
            )
            else evaluator.errors = evaluator.errors + 1
        } else evaluator.recordInvalidFunctionHandle(targetName, handle)
    }
    if (targetName == "typedAccessRootKind" ||
        targetName == "typedAccessRootIdentity" ||
        targetName == "typedAccessRootParameter" ||
        targetName == "typedAccessSegmentCount" ||
        targetName == "typedAccessSegmentKind" ||
        targetName == "typedAccessSegmentName" ||
        targetName == "typedAccessSegmentIndex") {
        val path = evaluator.evaluate(expression.children[0])
        if (path.kind == "typed.access.path") {
            if (targetName == "typedAccessRootKind") {
                result = bootstrapEvalString(path.owner)
            }
            if (targetName == "typedAccessRootIdentity") {
                result = bootstrapEvalString(path.text)
            }
            if (targetName == "typedAccessRootParameter") {
                result = bootstrapEvalInteger(path.integer)
            }
            if (targetName == "typedAccessSegmentCount") {
                result = bootstrapEvalInteger(path.elements.size)
            }
            if (targetName == "typedAccessSegmentKind" ||
                targetName == "typedAccessSegmentName" ||
                targetName == "typedAccessSegmentIndex") {
                val index = evaluator.evaluate(expression.children[1]).integer
                if (index >= 0 && index < path.elements.size) {
                    val segment = path.elements[index]
                    if (targetName == "typedAccessSegmentKind") {
                        result = bootstrapEvalString(segment.owner)
                    }
                    if (targetName == "typedAccessSegmentName") {
                        result = bootstrapEvalString(segment.text)
                    }
                    if (targetName == "typedAccessSegmentIndex") {
                        result = bootstrapEvalInteger(segment.integer)
                    }
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.recordEvaluatorDiagnostic(
            "E_REACTIVE_DEPENDENCY_UNAVAILABLE",
            "typed access query received a stale or invalid path handle"
        )
    }
    if (targetName == "typedAccessPathsIntersect") {
        val left = evaluator.evaluate(expression.children[0])
        val right = evaluator.evaluate(expression.children[1])
        if (left.kind == "typed.access.path" &&
            right.kind == "typed.access.path") {
            result = bootstrapEvalBoolean(bootstrapAccessPathsIntersect(
                evaluator.accessValuePath(left),
                evaluator.accessValuePath(right)
            ))
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedExpressionType" ||
        targetName == "typedExpressionKind") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size) {
            if (targetName == "typedExpressionType") {
                val typed = evaluator.typedCallIndex(evaluator.syntax[handle])
                if (typed >= 0) {
                    result = bootstrapEvalString(
                        evaluator.typedCalls[typed].type
                    )
                } else evaluator.errors = evaluator.errors + 1
            } else result = bootstrapEvalString(
                evaluator.syntax[handle].kind
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallTarget") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size) {
            val typed = evaluator.typedCallIndex(evaluator.syntax[handle])
            if (typed >= 0) {
                result = bootstrapEvalInteger(evaluator.typedCalls[typed].target)
            } else evaluator.recordEvaluatorDiagnostic(
                "E_EXT_TYPED_QUERY_BEFORE_RESOLUTION",
                "compiler API `typedCallTarget` requires a resolved deferred expression"
            )
        } else evaluator.recordEvaluatorDiagnostic(
            "E_EXT_EXPRESSION_HANDLE_INVALID",
            "compiler API `typedCallTarget` received invalid expression handle $handle"
        )
    }
    if (targetName == "typedCallArgumentType") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val argument = evaluator.evaluate(expression.children[1]).integer
        var typed = -1
        if (handle >= 0 && handle < evaluator.syntax.size) {
            typed = evaluator.typedCallIndex(evaluator.syntax[handle])
        }
        if (typed >= 0 && argument >= 0 &&
            argument < evaluator.typedCalls[typed].argumentTypes.size) {
            result = bootstrapEvalString(
                evaluator.typedCalls[typed].argumentTypes[argument]
            )
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallArgumentCount") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size &&
            (evaluator.syntax[handle].kind == "call" ||
             evaluator.syntax[handle].kind == "member.call")) {
            var count = evaluator.syntax[handle].children.size
            if (evaluator.syntax[handle].kind == "member.call") {
                count = count - 1
            }
            result = bootstrapEvalInteger(count)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallArgument") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        val argument = evaluator.evaluate(expression.children[1]).integer
        var offset = 0
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.syntax[handle].kind == "member.call") offset = 1
        if (handle >= 0 && handle < evaluator.syntax.size &&
            (evaluator.syntax[handle].kind == "call" ||
             evaluator.syntax[handle].kind == "member.call") &&
            argument >= 0 &&
            argument + offset < evaluator.syntax[handle].children.size) {
            val child = evaluator.syntax[handle].children[argument + offset]
            result = evaluator.syntaxValue(child)
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallReceiverType") {
        val handle = evaluator.evaluate(expression.children[0]).integer
        if (handle >= 0 && handle < evaluator.syntax.size &&
            evaluator.syntax[handle].kind == "member.call" &&
            evaluator.syntax[handle].children.size > 0) {
            val typed = evaluator.typedCallIndex(evaluator.syntax[handle])
            if (typed >= 0) result = bootstrapEvalString(
                evaluator.typedCalls[typed].receiverType
            )
            else evaluator.errors = evaluator.errors + 1
        } else evaluator.errors = evaluator.errors + 1
    }
    if (targetName == "typedCallParameterTypeHandle" ||
        targetName == "typedCallResultTypeHandle" ||
        targetName == "typedCallArgumentParameter" ||
        targetName == "typedCallArgumentConversion" ||
        targetName == "typedCallInsertedDefaultCount" ||
        targetName == "typedCallParameterOwnership" ||
        targetName == "typedCallIsCompileOnly" ||
        targetName == "typedCallIsTrusted" ||
        targetName == "typedCallIsContract") {
        val syntaxHandle = evaluator.evaluate(expression.children[0]).integer
        var typed = -1
        if (syntaxHandle >= 0 && syntaxHandle < evaluator.syntax.size) {
            typed = evaluator.typedCallIndex(evaluator.syntax[syntaxHandle])
        }
        if (typed >= 0) {
            val call = evaluator.typedCalls[typed]
            if (targetName == "typedCallResultTypeHandle") {
                result = bootstrapEvalInteger(evaluator.reflectedTypeHandle(
                    call.type
                ))
            }
            if (targetName == "typedCallInsertedDefaultCount") {
                result = bootstrapEvalInteger(call.insertedDefaults)
            }
            if (targetName == "typedCallIsCompileOnly") {
                result = bootstrapEvalBoolean(call.isCompileOnly)
            }
            if (targetName == "typedCallIsTrusted") {
                result = bootstrapEvalBoolean(call.isTrusted)
            }
            if (targetName == "typedCallIsContract") {
                result = bootstrapEvalBoolean(call.isContract)
            }
            if (targetName == "typedCallParameterTypeHandle" ||
                targetName == "typedCallArgumentParameter" ||
                targetName == "typedCallArgumentConversion" ||
                targetName == "typedCallParameterOwnership") {
                val selected = evaluator.evaluate(
                    expression.children[1]
                ).integer
                if (selected >= 0) {
                    if (targetName ==
                            "typedCallParameterTypeHandle" &&
                        selected < call.parameterTypes.size) {
                        result = bootstrapEvalInteger(
                            evaluator.reflectedTypeHandle(
                                call.parameterTypes[selected]
                            )
                        )
                    }
                    if (targetName == "typedCallArgumentParameter" &&
                        selected < call.argumentParameters.size) {
                        result = bootstrapEvalInteger(
                            call.argumentParameters[selected]
                        )
                    }
                    if (targetName == "typedCallArgumentConversion" &&
                        selected < call.argumentConversions.size) {
                        result = bootstrapEvalString(
                            call.argumentConversions[selected]
                        )
                    }
                    if (targetName ==
                            "typedCallParameterOwnership" &&
                        selected < call.parameterKinds.size) {
                        result = bootstrapEvalString(
                            call.parameterKinds[selected]
                        )
                    }
                    if (result.kind == "invalid") {
                        evaluator.errors = evaluator.errors + 1
                    }
                } else evaluator.errors = evaluator.errors + 1
            }
        } else evaluator.errors = evaluator.errors + 1
    }
    result
}

fun bootstrapEvaluateWithEffects(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapEvalResult = bootstrapEvaluateWithEffectsIn(
    bootstrapSharedEvalContextFor(declarations), expression, declarations, allowedCompileEffects
)

fun bootstrapEvaluateWithEffectsIn(
    context: BootstrapEvalContext,
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int,
    source: string = ""
): BootstrapEvalResult {
    val names: array<string> = []
    val values: array<BootstrapEvalValue> = []
    val mutable: array<bool> = []
    val cursors: array<BootstrapSubparserCursor> = []
    val syntax: array<BootstrapExpression> = []
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        names,
        values,
        mutable,
        cursors,
        syntax,
        [],
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        "",
        source
    )
    val result = evaluator.evaluate(expression)
    bootstrapCompileGlobalsKeep(
        globalKeys, globalValues, evaluator.syntax, evaluator.declarations
    )
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations,
        syntax
    )
}

fun bootstrapEvaluate(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    source: string = ""
): BootstrapEvalResult = bootstrapEvaluateWithEffectsIn(
    bootstrapEvalContext(declarations), expression, declarations, 1023, source
)

class BootstrapSubparserInvocation(
    val expression: BootstrapExpression,
    val errors: int,
    val diagnostics: string,
    val extensionRequests: array<BootstrapExtensionRequest>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>
)

fun bootstrapInvokeSubparserHandler(
    declarations: array<BootstrapDeclaration>,
    handler: string,
    cursor: BootstrapSubparserCursor,
    allowedCompileEffects: int
): BootstrapSubparserInvocation = bootstrapInvokeSubparserHandlerIn(
    bootstrapEvalContext(declarations), declarations, handler, cursor, allowedCompileEffects
)

fun bootstrapInvokeSubparserHandlerIn(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>,
    handler: string,
    cursor: BootstrapSubparserCursor,
    allowedCompileEffects: int
): BootstrapSubparserInvocation {
    val stopsBefore = bootstrapEvalDepthStops
    val names: array<string> = ["cursor"]
    val values: array<BootstrapEvalValue> = [BootstrapEvalValue(
        "cursor",
        0,
        false,
        "",
        [],
        "",
        []
    )]
    val mutable: array<bool> = [false]
    val cursors: array<BootstrapSubparserCursor> = [cursor]
    val syntax: array<BootstrapExpression> = []
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        names,
        values,
        mutable,
        cursors,
        syntax,
        [],
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        handler,
        cursor.rawPosition,
        cursor.rawPosition,
        [BootstrapExpression(
            "identifier",
            "cursor",
            cursor.rawPosition,
            cursor.rawPosition,
            []
        )]
    ))
    var expression = BootstrapExpression(
        "invalid",
        "subparser-result",
        cursor.rawPosition,
        cursor.rawPosition,
        []
    )
    if (result.kind == "syntax" && result.integer >= 0 &&
        result.integer < syntax.size) {
        expression = syntax[result.integer]
    }
    bootstrapCompileGlobalsKeep(
        globalKeys, globalValues, evaluator.syntax, evaluator.declarations
    )
    // After a stack-depth stop, what failed on the way out (each level's
    // cursor or value) is that one stop: count the errors it reported.
    val errors = if (bootstrapEvalDepthStops > stopsBefore)
        bootstrapEvalErrorLines(evaluator.diagnostics)
        else evaluator.errors + cursor.errors
    BootstrapSubparserInvocation(
        expression,
        errors,
        evaluator.diagnostics,
        extensionRequests,
        compileInputPaths,
        compileInputContents
    )
}

fun bootstrapInvokeExtensionFinalizer(
    declarations: array<BootstrapDeclaration>,
    request: BootstrapExtensionRequest,
    typedCalls: array<BootstrapTypedCall>,
    allowedCompileEffects: int
): BootstrapEvalResult = bootstrapInvokeExtensionFinalizerIn(
    bootstrapEvalContext(declarations), declarations, request, typedCalls, allowedCompileEffects
)

fun bootstrapInvokeExtensionFinalizerIn(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>,
    request: BootstrapExtensionRequest,
    typedCalls: array<BootstrapTypedCall>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    val names: array<string> = ["payload", "expression"]
    val values: array<BootstrapEvalValue> = [
        bootstrapEvalString(request.payload),
        BootstrapEvalValue("syntax", 0, false, "", [], "", [])
    ]
    val mutable: array<bool> = [false, false]
    val cursors: array<BootstrapSubparserCursor> = []
    val syntax: array<BootstrapExpression> = [request.expression]
    val generatedDeclarations: array<BootstrapDeclaration> = []
    // Access/effect reflection must resolve the deferred syntax inside the
    // module that produced it. Preserve the active request in the evaluator;
    // an empty list forced ambiguous source-offset fallback after flattening.
    val extensionRequests: array<BootstrapExtensionRequest> = [request]
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        names,
        values,
        mutable,
        cursors,
        syntax,
        typedCalls,
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        request.finalizer,
        request.expression.begin,
        request.expression.end,
        [
            BootstrapExpression(
                "identifier", "payload", request.expression.begin,
                request.expression.begin, []
            ),
            BootstrapExpression(
                "identifier", "expression", request.expression.begin,
                request.expression.end, []
            )
        ]
    ))
    bootstrapCompileGlobalsKeep(
        globalKeys, globalValues, evaluator.syntax, evaluator.declarations
    )
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations
    )
}

fun bootstrapInvokeCompilerTransform(
    declarations: array<BootstrapDeclaration>,
    handler: string,
    begin: int,
    end: int,
    allowedCompileEffects: int
): BootstrapEvalResult = bootstrapInvokeCompilerTransformIn(
    bootstrapEvalContext(declarations), declarations, handler, begin, end, allowedCompileEffects
)

fun bootstrapInvokeCompilerTransformIn(
    context: BootstrapEvalContext,
    declarations: array<BootstrapDeclaration>,
    handler: string,
    begin: int,
    end: int,
    allowedCompileEffects: int
): BootstrapEvalResult {
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val globalKeys: array<string> = []
    val globalValues: array<BootstrapEvalValue> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        context.affineTypes,
        context,
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        generatedDeclarations,
        [],
        compileInputPaths,
        compileInputContents,
        globalKeys,
        globalValues,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    bootstrapCompilerTransformActive = true
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        handler,
        begin,
        end,
        []
    ))
    bootstrapCompilerTransformActive = false
    bootstrapCompileGlobalsKeep(
        globalKeys, globalValues, evaluator.syntax, evaluator.declarations
    )
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations
    )
}
