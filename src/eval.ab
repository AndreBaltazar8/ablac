            this.values.append(bootstrapEvalInvalid())
            this.mutable.append(false)
            var element = 0
            var looping = true
            result = bootstrapEvalVoid()
            var count = source.elements.size
            if (source.kind == "string") count = source.text.size
            while (element < count && looping && this.steps <= 100000) {
                if (source.kind == "string") {
                    this.values[iteratorIndex] = bootstrapEvalInteger(
                        source.text[element]
                    )
                } else {
                    this.values[iteratorIndex] = source.elements[element]
                }
                result = this.evaluate(expression.children[1])
                if (result.kind == "return") looping = false
                if (result.kind == "break") {
                    result = bootstrapEvalVoid()
                    looping = false
                }
                if (result.kind == "continue") {
                    result = bootstrapEvalVoid()
                }
                element = element + 1
            }
            this.values[iteratorIndex] = this.uninitializedValue()
            this.names[iteratorIndex] = ""
        }
        if (this.errors > errorsBefore &&
            this.diagnostics.size == diagnosticsBefore) {
            this.recordEvaluatorDiagnostic(
                "E_EVAL_EXPRESSION",
                "compile-time evaluation failed while evaluating `${expression.kind}` `${expression.text}` at ${expression.begin}:${expression.end}"
            )
        }
        result
    }
}

fun bootstrapEvaluateWithEffects(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    val names: array<string> = []
    val values: array<BootstrapEvalValue> = []
    val mutable: array<bool> = []
    val cursors: array<BootstrapSubparserCursor> = []
    val syntax: array<BootstrapExpression> = []
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        bootstrapBuildAffineTypeNames(declarations),
        names,
        values,
        mutable,
        cursors,
        syntax,
        [],
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(expression)
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations
    )
}

fun bootstrapEvaluate(
    expression: BootstrapExpression,
    declarations: array<BootstrapDeclaration>
): BootstrapEvalResult = bootstrapEvaluateWithEffects(
    expression, declarations, 1023
)

class BootstrapSubparserInvocation(
    val expression: BootstrapExpression,
    val errors: int,
    val diagnostics: string,
    val extensionRequests: array<BootstrapExtensionRequest>,
    val compileInputPaths: array<string>,
    val compileInputContents: array<string>
)

fun bootstrapInvokeSubparserHandler(
    declarations: array<BootstrapDeclaration>,
    handler: string,
    cursor: BootstrapSubparserCursor,
    allowedCompileEffects: int
): BootstrapSubparserInvocation {
    val names: array<string> = ["cursor"]
    val values: array<BootstrapEvalValue> = [BootstrapEvalValue(
        "cursor",
        0,
        false,
        "",
        [],
        "",
        []
    )]
    val mutable: array<bool> = [false]
    val cursors: array<BootstrapSubparserCursor> = [cursor]
    val syntax: array<BootstrapExpression> = []
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val extensionRequests: array<BootstrapExtensionRequest> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        bootstrapBuildAffineTypeNames(declarations),
        names,
        values,
        mutable,
        cursors,
        syntax,
        [],
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        handler,
        cursor.rawPosition,
        cursor.rawPosition,
        [BootstrapExpression(
            "identifier",
            "cursor",
            cursor.rawPosition,
            cursor.rawPosition,
            []
        )]
    ))
    var expression = BootstrapExpression(
        "invalid",
        "subparser-result",
        cursor.rawPosition,
        cursor.rawPosition,
        []
    )
    if (result.kind == "syntax" && result.integer >= 0 &&
        result.integer < syntax.size) {
        expression = syntax[result.integer]
    }
    BootstrapSubparserInvocation(
        expression,
        evaluator.errors + cursor.errors,
        evaluator.diagnostics,
        extensionRequests,
        compileInputPaths,
        compileInputContents
    )
}

fun bootstrapInvokeExtensionFinalizer(
    declarations: array<BootstrapDeclaration>,
    request: BootstrapExtensionRequest,
    typedCalls: array<BootstrapTypedCall>,
    allowedCompileEffects: int
): BootstrapEvalResult {
    val names: array<string> = ["payload", "expression"]
    val values: array<BootstrapEvalValue> = [
        bootstrapEvalString(request.payload),
        BootstrapEvalValue("syntax", 0, false, "", [], "", [])
    ]
    val mutable: array<bool> = [false, false]
    val cursors: array<BootstrapSubparserCursor> = []
    val syntax: array<BootstrapExpression> = [request.expression]
    val generatedDeclarations: array<BootstrapDeclaration> = []
    // Access/effect reflection must resolve the deferred syntax inside the
    // module that produced it. Preserve the active request in the evaluator;
    // an empty list forced ambiguous source-offset fallback after flattening.
    val extensionRequests: array<BootstrapExtensionRequest> = [request]
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        bootstrapBuildAffineTypeNames(declarations),
        names,
        values,
        mutable,
        cursors,
        syntax,
        typedCalls,
        [],
        generatedDeclarations,
        extensionRequests,
        compileInputPaths,
        compileInputContents,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        request.finalizer,
        request.expression.begin,
        request.expression.end,
        [
            BootstrapExpression(
                "identifier", "payload", request.expression.begin,
                request.expression.begin, []
            ),
            BootstrapExpression(
                "identifier", "expression", request.expression.begin,
                request.expression.end, []
            )
        ]
    ))
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations
    )
}

fun bootstrapInvokeCompilerTransform(
    declarations: array<BootstrapDeclaration>,
    handler: string,
    begin: int,
    end: int,
    allowedCompileEffects: int
): BootstrapEvalResult {
    val generatedDeclarations: array<BootstrapDeclaration> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    val evaluator = BootstrapEvaluator(
        declarations,
        bootstrapBuildAffineTypeNames(declarations),
        [],
        [],
        [],
        [],
        [],
        [],
        [],
        generatedDeclarations,
        [],
        compileInputPaths,
        compileInputContents,
        allowedCompileEffects,
        0,
        0,
        ""
    )
    bootstrapCompilerTransformActive = true
    val result = evaluator.evaluate(BootstrapExpression(
        "call",
        handler,
        begin,
        end,
        []
    ))
    bootstrapCompilerTransformActive = false
    BootstrapEvalResult(
        result,
        evaluator.errors,
        evaluator.diagnostics,
        compileInputPaths,
        compileInputContents,
        generatedDeclarations
    )
}
