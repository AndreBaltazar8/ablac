// `ablac repl` on a live run (docs/toolchain.md, "Run and REPL"): one program runs for the whole session, and each line
// is a reload of it (live_reload.ab), so what a line defines stays: a variable keeps its value, a function can be
// redefined. The program's main waits until a line asks it to end (`__replQuit`); this thread reads the lines
// (bootstrapReplStep, the step llvmOrcCallMainWatched calls between waits, as --watch does).
//
// - A declaration (`fun`, `val`, `var`, `class`, `interface`, `resource class`, `import`) replaces the one of the same
//   name, or is added, and the program is reloaded: "defined" when it applies; otherwise its diagnostics or the
//   refusal go to standard error and the session is as it was.
// - Any other line is an expression: a new variable whose initializer prints it (`__replPrint("${<line>}")`), run
//   once when the reload applies (live_globals.ab), so a value of any type prints. A line that is no expression of a
//   value (an assignment, a call that returns nothing) runs as the body of a function that variable calls. A panic
//   in it is contained: the reload fails (E_LIVE_PANIC), its message goes to standard error and the session's state
//   is as it was.
// - `:reset` ends the program and starts a new one with nothing defined; `:quit` (or the end of the input) ends it.
//   `:help` lists the commands; any other `:` entry is an unknown command, refused without a compile.
// - A "line" is an entry (bootstrapReplReadEntry): it continues on the next lines while a bracket is open, in this
//   REPL and in the one of a run without live mode (orc_main.ab).
import "abla/fs"
import "abla/text"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/sys/linux"
import "abla/sys/linux/io"
import "abla/sys/linux/process"
import "abla/process/exit"
import "live_reload.ab"
import "lexer.ab"
import "repl_editor.ab"
import "diagnostic_positions.ab"

class BootstrapReplDeclaration(val key: string, val line: string)

// The session: its declarations in order, the source file the program is compiled from, the lines read, and how it
// is ending (bootstrapReplQuit: :quit or the end of the input, not :reset).
var bootstrapReplDeclarations: array<BootstrapReplDeclaration> = []
var bootstrapReplSourcePath = ""
var bootstrapReplLines = 0
var bootstrapReplEnding = false
var bootstrapReplQuit = false
var bootstrapReplMessage = ""

fun bootstrapReplDeclarationKind(line: string): string {
    for (kind in ["resource class ", "interface ", "class ", "import ", "fun ", "val ", "var "]) {
        if (line.startsWith(kind)) return kind
    }
    ""
}

fun bootstrapReplDeclaration(line: string): bool = bootstrapReplDeclarationKind(line) != ""

// What a declaration replaces: its kind's family and its name (`fun add(...)` and `fun add(...)` are the same one).
fun bootstrapReplKey(line: string): string {
    val kind = bootstrapReplDeclarationKind(line)
    if (kind == "import ") return line.trim()
    val rest = line.slice(kind.size, line.size)
    var end = 0
    while (end < rest.size) {
        val byte = rest[end]
        // ( < : = { space, line break
        if (byte == 40 || byte == 60 || byte == 58 || byte == 61 || byte == 123 || byte == 32 || byte == 10) break
        end = end + 1
    }
    val family = if (kind == "val " || kind == "var ") "variable" else if (kind == "fun ") "function" else "type"
    "$family ${rest.slice(0, end)}"
}

// Whether `text` is an entry still open: a bracket ( [ { not closed, a string, or a `/*` comment or `"""` string not
// ended. The compiler's lexer counts, so a bracket inside a string, a comment or an interpolation is not one.
fun bootstrapReplOpen(text: string): bool {
    var depth = 0
    var strings = 0
    for (token in bootstrapLex(text)) {
        val kind = token.kind
        if (kind == BOOTSTRAP_TOKEN_LPAREN || kind == BOOTSTRAP_TOKEN_LBRACKET || kind == BOOTSTRAP_TOKEN_LBRACE) {
            depth = depth + 1
        } else if (kind == BOOTSTRAP_TOKEN_RPAREN || kind == BOOTSTRAP_TOKEN_RBRACKET ||
            kind == BOOTSTRAP_TOKEN_RBRACE) {
            depth = depth - 1
        } else if (kind == BOOTSTRAP_TOKEN_STRING_START) {
            strings = strings + 1
        } else if (kind == BOOTSTRAP_TOKEN_STRING_END) {
            strings = strings - 1
        } else if (kind == BOOTSTRAP_TOKEN_INVALID && token.end == text.size) {
            val opening = text.slice(token.begin, text.size)
            if (opening.startsWith("/*") || opening.startsWith("\"\"\"")) return true
        }
    }
    depth > 0 || strings > 0
}

// One entry: a line read after the prompt "abla> ", and while it is open (bootstrapReplOpen) the lines after it, each
// read after "....> ", so a declaration or expression can span lines. An empty line ends an entry still open (the
// compiler then says what is missing), as does the end of the input. Not available at the end of the input; on a
// terminal a line is read with the REPL's editor (repl_editor.ab), and Ctrl-C there drops the entry (an empty one).
fun bootstrapReplReadEntry(var input: LinuxInput): LinuxInputLine {
    val first = bootstrapReplReadLine(input, "abla> ")
    if (first.kind == 1) return LinuxInputLine("", false)
    if (first.kind == 2) return LinuxInputLine("", true)
    var text = first.text
    while (bootstrapReplOpen(text)) {
        val next = bootstrapReplReadLine(input, "....> ")
        if (next.kind == 2) return LinuxInputLine("", true)
        if (next.kind == 1 || next.text.trim() == "") break
        text = "$text\n${next.text}"
    }
    LinuxInputLine(text, true)
}

// A line after `prompt`: with the editor on a terminal, else as it comes.
fun bootstrapReplReadLine(var input: LinuxInput, prompt: string): BootstrapReplEditorLine {
    if (bootstrapReplEditorOn()) return bootstrapReplEditorRead(prompt)
    linuxPrintStandardOutput(prompt)
    val line = input.readLine()
    BootstrapReplEditorLine(line.text, if (line.available) 0 else 1)
}

// A command entry (`:name ...`, no Abla entry starts with a colon): its name, ":help"; "" for an entry.
fun bootstrapReplCommandName(line: string): string {
    val text = line.trim()
    if (!text.startsWith(":")) return ""
    var end = 1
    // space, tab, line break
    while (end < text.size && text[end] != 32 && text[end] != 9 && text[end] != 10) end = end + 1
    text.slice(0, end)
}

// The last, empty line gives the text its final line break.
val BOOTSTRAP_REPL_HELP = """
    Commands:
      :help    this list
      :type e  the type of the expression e, which does not run
      :load f  the declarations of the file f (nothing runs; its main is loadedMain())
      :reset   forget every declaration and start again
      :quit    end the session (so does the end of the input)
    Any other entry is Abla. A declaration (fun, val, var, class, interface, resource class, import) is added, or
    replaces the one of the same name; anything else runs and its value, if it has one, prints. An entry goes on to
    the next line while a bracket, a string or a comment is open; an empty line ends it.

    """

// A command other than :quit and :reset, which the session's loop handles: :help prints the commands, any other is
// refused, never compiled.
fun bootstrapReplOtherCommand(command: string): void {
    if (command == ":help") {
        linuxPrintStandardOutput(BOOTSTRAP_REPL_HELP)
    } else linuxPrintStandardError("unknown command $command (:help lists them)\n")
    return
}

// The helpers of :type, in every session (abla/compiler cannot be imported once the program runs: its classes would be
// new to the running code). The expression is the body of a lambda that is never called, so it does not run, and its
// result type is the compiler's own; the names are shown as written in Abla.
val BOOTSTRAP_REPL_TYPE_HELPERS = """
    fun <T> __replTypeOf(make: () -> T): string = #compiler.typeName(T)

    fun __replTypeText(name: string): string {
        if (name == "i64") return "int"
        if (name == "f64") return "float"
        if (name.size > 6 && name.slice(0, 6) == "array:") return "array<" + __replTypeText(name.slice(6, name.size)) + ">"
        return name
    }

    """

// The top-level declarations of a file :load reads, each from the line it starts on to the next one's: one starts at
// a token at the start of a line outside any bracket or string (the lexer's, so a bracket in a string or comment is
// none). What comes before the first (comments) is left out. A relative `import "x.ab"` is made absolute from
// `directory` (the session's source is elsewhere), and `fun main` is `fun loadedMain`: the session's program has its
// own main.
fun bootstrapReplSplitDeclarations(text: string, directory: string): array<string> {
    val starts: array<int> = []
    var depth = 0
    var strings = 0
    for (token in bootstrapLex(text)) {
        val kind = token.kind
        val closing = kind == BOOTSTRAP_TOKEN_RPAREN || kind == BOOTSTRAP_TOKEN_RBRACKET ||
            kind == BOOTSTRAP_TOKEN_RBRACE
        if (depth == 0 && strings == 0 && !closing && token.begin < text.size &&
            (token.begin == 0 || text[token.begin - 1] == 10)) starts.append(token.begin)
        if (kind == BOOTSTRAP_TOKEN_LPAREN || kind == BOOTSTRAP_TOKEN_LBRACKET || kind == BOOTSTRAP_TOKEN_LBRACE) {
            depth = depth + 1
        } else if (closing) {
            depth = depth - 1
        } else if (kind == BOOTSTRAP_TOKEN_STRING_START) {
            strings = strings + 1
        } else if (kind == BOOTSTRAP_TOKEN_STRING_END) {
            strings = strings - 1
        }
    }
    val pieces: array<string> = []
    for (index in 0 until starts.size) {
        val end = if (index + 1 < starts.size) starts[index + 1] else text.size
        var piece = text.slice(starts[index], end).trim()
        if (piece.startsWith("import \"")) {
            val close = piece.indexOf("\"", 8)
            val path = if (close > 8) piece.slice(8, close) else ""
            if (path.endsWith(".ab") && !Path(path).isAbsolute() && !path.startsWith("abla/")) {
                piece = "import \"$directory/$path\"${piece.slice(close + 1, piece.size)}"
            }
        }
        if (piece.startsWith("fun main") && piece.size > 8) {
            val after = piece[8]
            // ( : = { space
            if (after == 40 || after == 58 || after == 61 || after == 123 || after == 32) {
                piece = "fun loadedMain${piece.slice(8, piece.size)}"
            }
        }
        if (piece != "") pieces.append(piece)
    }
    pieces
}

// :load <file>: its declarations added to the session (or replacing those of the same name), in one reload, so a
// file that does not compile leaves the session as it was. Nothing runs; a loaded main is loadedMain().
fun bootstrapReplLoad(path: string): void {
    if (path == "") {
        linuxPrintStandardError(":load needs a file (:load lib.ab)\n")
        return
    }
    val file = Path(path)
    if (!file.exists()) {
        linuxPrintStandardError(":load: no such file: $path\n")
        return
    }
    val absolute = if (Path(path).isAbsolute()) path else "${currentDirectory().text}/$path"
    val slash = absolute.lastIndexOf("/")
    val pieces = bootstrapReplSplitDeclarations(file.readText(), if (slash > 0) absolute.slice(0, slash) else "/")
    val declarations: array<BootstrapReplDeclaration> = []
    for (declaration in bootstrapReplDeclarations) {
        declarations.append(BootstrapReplDeclaration(declaration.key, declaration.line))
    }
    var renamed = false
    for (piece in pieces) {
        if (piece.startsWith("fun loadedMain")) renamed = true
        // A declaration the REPL knows by kind and name replaces its namesake; any other (an annotated or private
        // one) is known by its text.
        val key = if (bootstrapReplDeclaration(piece)) bootstrapReplKey(piece) else "text $piece"
        var replaced = false
        for (index in 0 until declarations.size) {
            if (declarations[index].key == key) {
                declarations[index] = BootstrapReplDeclaration(key, piece)
                replaced = true
            }
        }
        if (!replaced) declarations.append(BootstrapReplDeclaration(key, piece))
    }
    val status = bootstrapReplReload(declarations, "", false)
    if (status != 0) {
        bootstrapReplReport(status)
        return
    }
    bootstrapReplDeclarations = declarations
    linuxPrintStandardOutput("loaded ${pieces.size} declarations from $path${if (renamed) " (its main is loadedMain())" else ""}\n")
    return
}

// The command's argument: what follows its name ("" if nothing).
fun bootstrapReplCommandArgument(line: string, command: string): string {
    val text = line.trim()
    text.slice(command.size, text.size).trim()
}

// The session's program: its imports, the REPL's helpers, the declarations, the current line, and main, which waits. The
// frontend lowers only what is referenced: __replKeep names every variable of the session (and the current line's,
// `currentVariable`), and main refers to it under a condition that never holds, so each stays a variable of the
// program (its initializer then runs when it is new, live_globals.ab).
// `entry` is the user's text being tried, a declaration of `declarations` or a part of `current`: where it lies in the
// source goes to bootstrapDiagnosticEntryBegin and End (diagnostic_positions.ab), so a diagnostic names its place in
// the entry, not in this file.
fun bootstrapReplSource(declarations: array<BootstrapReplDeclaration>, current: string,
    currentVariable: string = "", entry: string = ""): string {
    var entryBegin = -1
    val base = "import \"abla/io\"\nimport \"abla/float/text\"\nimport \"abla/sys/linux/process\"\nimport \"abla/compiler\"\n"
    var text = "$base\n"
    for (declaration in declarations) {
        // One the session's program imports already is left out: a module imported twice is an error.
        if (declaration.line.startsWith("import ") && !base.contains("${declaration.line.trim()}\n")) {
            if (declaration.line == entry) entryBegin = text.size
            text = "$text${declaration.line}\n"
        }
    }
    text = "${text}\nvar __replQuit = 0\n\nfun __replPrint(text: string): int {\n    println(text)\n    return 0\n}\n\nfun <T> __replArray(items: array<T>): string = \"<array of size \${items.size}>\"\n\n$BOOTSTRAP_REPL_TYPE_HELPERS"
    for (declaration in declarations) {
        if (!declaration.line.startsWith("import ")) {
            if (declaration.line == entry) entryBegin = text.size
            text = "$text${declaration.line}\n"
        }
    }
    // An entry in `current` is wrapped (a function's body, an initializer): a place after it up to the end of `current`
    // (a parse error at the wrapper's `return`) is the entry's end.
    var entryLimit = entryBegin + entry.size
    val within = if (entry == "") -1 else current.indexOf(entry)
    if (within >= 0) {
        entryBegin = text.size + within
        entryLimit = text.size + current.size
    }
    bootstrapDiagnosticEntryBegin = if (entryBegin < 0) 0 else entryBegin
    bootstrapDiagnosticEntryEnd = if (entryBegin < 0) 0 else entryBegin + entry.size
    bootstrapDiagnosticEntryLimit = if (entryBegin < 0) 0 else entryLimit
    var keep = "@noinline\nfun __replKeep(): int {\n"
    var kept = 0
    for (declaration in declarations) {
        if (declaration.key.startsWith("variable ")) {
            keep = "${keep}    val __replKept$kept = ${declaration.key.slice(9, declaration.key.size)}\n"
            kept = kept + 1
        }
    }
    if (currentVariable != "") keep = "${keep}    val __replKept$kept = $currentVariable\n"
    keep = "${keep}    return 0\n}\n"
    "$text$current\n\n$keep\nfun main: int {\n    while (__replQuit == 0) {\n        if (__replQuit < 0) __replKeep()\n        linuxSleep(20)\n    }\n    0\n}\n"
}

// Writes the session's source with `current` and reloads the program: the reload's status (0 applied, 1 refused, 2
// failed, 3 unavailable), its message in bootstrapReplMessage. `quiet` sends the compiler's diagnostics nowhere (a
// first try whose failure is not the user's to read).
trusted fun bootstrapReplReload(declarations: array<BootstrapReplDeclaration>, current: string, quiet: bool,
    currentVariable: string = "", entry: string = ""): int {
    if (!Path(bootstrapReplSourcePath).writeTextAtomic(bootstrapReplSource(declarations, current, currentVariable, entry))) {
        bootstrapReplMessage = "the session's source could not be written ($bootstrapReplSourcePath)"
        return 2
    }
    var saved = -1
    val loud = linuxEnvironment("ABLA_REPL_LOUD").found
    if (quiet && !loud) {
        // F_DUPFD from 10: standard error kept aside while /dev/null takes its place.
        saved = linuxSyscall3(72, 2, 0, 10)
        val nothing = linuxOpen("/dev/null", 1).descriptor
        if (saved >= 0 && nothing >= 0) {
            linuxSyscall2(33, nothing, 2)
        }
        if (nothing >= 0) linuxSyscall1(3, nothing)
    }
    val capacity = 65536
    val buffer = nativeByteBuffer(capacity)
    buffer.storeI64(0, 0)
    val status = bootstrapLiveReloadEntry(nativePointerAddress(buffer.pointerAt(0)), capacity)
    if (saved >= 0) {
        linuxSyscall2(33, saved, 2)
        linuxSyscall1(3, saved)
    }
    var length = buffer.loadI64(0)
    if (length < 0) length = 0
    if (length > capacity - 8) length = capacity - 8
    var message = ""
    if (length > 0) {
        val address = ablaUnsafePointerAddress(ablaUnsafeAllocate(length + 1))
        ablaUnsafeCopyMemory(address, ablaUnsafePointerAddress(buffer.pointerAt(8)), length)
        ablaUnsafeStoreU8(nativePointerFromAddress(address + length), 0)
        message = adoptNativeString(address, length)
    }
    buffer.close()
    bootstrapReplMessage = message.trim()
    if (loud) linuxPrintStandardError("repl reload: status $status: $bootstrapReplMessage\n")
    status
}

// A refusal or a panic (a program that does not compile has printed its diagnostics already).
fun bootstrapReplReport(status: int): void {
    if (status == 2 && bootstrapReplMessage.startsWith("E_LIVE_COMPILE")) return
    if (status != 0) linuxPrintStandardError("$bootstrapReplMessage\n")
    return
}

// Ends the program: a line that sets __replQuit, so main returns and llvmOrcCallMainWatched stops calling the step.
fun bootstrapReplEnd(): void {
    bootstrapReplEnding = true
    bootstrapReplLines = bootstrapReplLines + 1
    val line = bootstrapReplLines
    val status = bootstrapReplReload(bootstrapReplDeclarations,
        "fun __repl_run_$line(): int {\n    __replQuit = 1\n    return 0\n}\nval __repl_$line: int = __repl_run_$line()",
        false, "__repl_$line")
    if (status != 0) {
        bootstrapReplReport(status)
        linuxPrintStandardError("ablac repl: the program could not be ended\n")
        exit(1)
    }
    return
}

var bootstrapReplInput = linuxStandardInput()

fun bootstrapReplStep(): void {
    if (bootstrapReplEnding) {
        linuxSleep(5)
        return
    }
    val input = bootstrapReplReadEntry(bootstrapReplInput)
    val command = if (input.available) bootstrapReplCommandName(input.text) else ""
    if (!input.available || command == ":quit") {
        bootstrapReplQuit = true
        bootstrapReplEnd()
        return
    }
    val line = input.text
    if (command == ":reset") {
        bootstrapReplQuit = false
        bootstrapReplEnd()
        linuxPrintStandardOutput("reset\n")
        return
    }
    if (command == ":load") {
        bootstrapReplLoad(bootstrapReplCommandArgument(line, command))
        return
    }
    if (command == ":type") {
        val expression = bootstrapReplCommandArgument(line, command)
        if (expression == "") {
            linuxPrintStandardError(":type needs an expression (:type 1 + 2)\n")
            return
        }
        bootstrapReplLines = bootstrapReplLines + 1
        val number = bootstrapReplLines
        val status = bootstrapReplReload(bootstrapReplDeclarations,
            "val __repl_$number: int = __replPrint(__replTypeText(__replTypeOf({ $expression })))", true,
            "__repl_$number", expression)
        if (status == 2 && bootstrapReplMessage.startsWith("E_LIVE_COMPILE")) {
            // Its own diagnostics (an unknown name, ...), not the helper's: the expression as the body of a function
            // nothing calls, so it does not run either.
            val checked = bootstrapReplReload(bootstrapReplDeclarations,
                "fun __repl_check_$number(): int {\n    $expression\n    return 0\n}", false, "", expression)
            if (checked == 0) linuxPrintStandardError(":type: the type of `$expression` could not be inferred\n")
            else bootstrapReplReport(checked)
        } else bootstrapReplReport(status)
        return
    }
    if (command != "") {
        bootstrapReplOtherCommand(command)
        return
    }
    if (line.trim() == "") return
    if (bootstrapReplDeclaration(line)) {
        val key = bootstrapReplKey(line)
        val declarations: array<BootstrapReplDeclaration> = []
        var replaced = false
        for (declaration in bootstrapReplDeclarations) {
            if (declaration.key == key) {
                declarations.append(BootstrapReplDeclaration(key, line))
                replaced = true
            } else declarations.append(BootstrapReplDeclaration(declaration.key, declaration.line))
        }
        if (!replaced) declarations.append(BootstrapReplDeclaration(key, line))
        val status = bootstrapReplReload(declarations, "", false, "", line)
        if (status == 0) {
            bootstrapReplDeclarations = declarations
            linuxPrintStandardOutput("defined\n")
        } else bootstrapReplReport(status)
        return
    }
    bootstrapReplLines = bootstrapReplLines + 1
    val number = bootstrapReplLines
    // An expression first, its failure unshown; then an array (which does not interpolate: its size prints, whatever
    // its elements), also unshown; then the line as a statement, whose diagnostics are the user's.
    var status = bootstrapReplReload(bootstrapReplDeclarations,
        "val __repl_$number: int = __replPrint(\"\${$line}\")", true, "__repl_$number", line)
    if (status == 2 && bootstrapReplMessage.startsWith("E_LIVE_COMPILE")) {
        status = bootstrapReplReload(bootstrapReplDeclarations,
            "val __repl_$number: int = __replPrint(__replArray($line))", true, "__repl_$number", line)
    }
    if (status == 2 && bootstrapReplMessage.startsWith("E_LIVE_COMPILE")) {
        status = bootstrapReplReload(bootstrapReplDeclarations,
            "fun __repl_run_$number(): int {\n    $line\n    return 0\n}\nval __repl_$number: int = __repl_run_$number()",
            false, "__repl_$number", line)
    }
    bootstrapReplReport(status)
    return
}

