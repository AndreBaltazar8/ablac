// What a compiler that has LLVM installs before it compiles: LLVM emission and the native compile-time tiers (backend.ab), ORC's JIT and
// the dynamic loader for compile-time extern:"c" calls (ct_native_orc.ab), and the signal trampolines (ct_signal_trampolines.ab). The
// compiler's own entry points call it first, and so does a program that embeds the compiler as a library and compiles in process; a
// compiler built without LLVM (browser_main.ab) never imports this module, so it reaches no LLVM symbol.
import "backend/llvm/backend.ab"
import "ct_native_orc.ab"

fun bootstrapNativeInstall(): void {
    ctNativeOrcInstall()
    bootstrapEmitLlvmInstall()
}
