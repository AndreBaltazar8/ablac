// The compiler for Windows (x86_64-windows-hosted, the plan's step 3): src/orc_main.ab with lld, llc and the archive writer in its own
// process (src/static_lld.ab, through runtime/abla_lld_shim.cpp), linked against LLVM's and lld's static archives for windows-msvc and the
// MSVC C runtime (#1137). Unlike src/orc_main_static.ab it brings no C library of its own (src/static_libc is Linux's): the C++ in the
// archives gets the MSVC CRT, whose startup (wmainCRTStartup) runs their constructors and calls the link's wmain bridge, which enters
// the Abla runtime (abla_windows_start: arguments as UTF-8 from GetCommandLineW, stack bounds from GetCurrentThreadStackLimits).
import "orc_main.ab" as orc
import "static_lld.ab"

fun main: int {
    staticLldInstall()
    orc.main()
}
