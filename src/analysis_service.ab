import "analysis_graph.ab"
import "frontend_diagnostics.ab"
import "frontend.ab"
// Persistent, editor-independent compiler analysis protocol.
// Editors talk to the standalone language server; compiler clients consume
// immutable source snapshots over this versioned JSON-lines service.

import "module.ab"
import "abla/json"
import "abla/runtime/memory"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/text"
import "abla/sys/linux/fs"
import "abla/sys/linux/io"
import "parser.ab"
import "sema.ab"
import "abla/bytes"
import "module_paths.ab"
import "lexer.ab"
import "borrow_inference.ab"
import "delegated_properties.ab"
import "overload.ab"
import "expected_types.ab"
import "generics.ab"
import "receiver_names.ab"

val ABLA_ANALYSIS_PROTOCOL_VERSION: int = 1
val ABLA_ANALYSIS_MAX_DOCUMENTS: int = 20000
val ABLA_COMPILER_VERSION: string = "0.2.62"

class BootstrapAnalysisDocument(
    val uri: string,
    val path: string,
    val version: int,
    val text: string,
    var active: bool
)

class BootstrapAnalysisService(
    val roots: array<string>,
    val overlays: array<BootstrapAnalysisDocument>,
    var revision: int,
    var initialized: bool,
    var running: bool,
    var graphMode: bool = false,
    // graph-v2: the symbols' ids are stable (module, container path, name, overload signature) instead of offset-based.
    var graphStableIds: bool = false,
    // graph-v2: what each document's export was at the last few revisions (see graphSince).
    var graphGenerations: array<BootstrapAnalysisGraphGeneration> = [],
    val graphEntries: array<string> = [],
    val graphInputPaths: array<string> = [],
    val graphInputValues: array<string> = [],
    var graphQueryIndex: BootstrapAnalysisGraphQueryIndex? = null,
    var graphIndexRevision: int = -1,
    // The locations of the occurrences by declaration (query/references only), built for the generation `graphReferencesRevision`.
    var graphReferences: Map<string, array<Json>> = Map(),
    var graphReferencesRevision: int = -1,
    // Each module's parse and symbols as of the source they were made from (see graphSnapshot); dropped when the entry changes.
    var graphParsed: Map<string, BootstrapAnalysisGraphParsed> = Map()
)

class BootstrapAnalysisSemanticGroup(
    val declarations: array<BootstrapDeclaration>,
    val semantic: BootstrapSemanticResult,
    val occurrenceIndex: BootstrapAnalysisOccurrenceIndex
)

fun bootstrapAnalysisHexDigit(value: int): int {
    var result = -1
    if (value >= 48 && value <= 57) result = value - 48
    if (value >= 65 && value <= 70) result = value - 65 + 10
    if (value >= 97 && value <= 102) result = value - 97 + 10
    result
}

fun bootstrapAnalysisUriPath(uri: string): string {
    var begin = 0
    if (uri.size >= 7 && uri.slice(0, 7) == "file://") begin = 7
    var output = ""
    var index = begin
    while (index < uri.size) {
        if (uri[index] == 37 && index + 2 < uri.size) {
            val high = bootstrapAnalysisHexDigit(uri[index + 1])
            val low = bootstrapAnalysisHexDigit(uri[index + 2])
            if (high >= 0 && low >= 0) {
                output = "$output${byteEncode(high * 16 + low)}"
                index = index + 3
            } else {
                output = "$output${uri.slice(index, index + 1)}"
                index = index + 1
            }
        } else {
            output = "$output${uri.slice(index, index + 1)}"
            index = index + 1
        }
    }
    output
}

fun bootstrapAnalysisPathUri(path: string): string = "file://$path"

fun BootstrapAnalysisService.overlayIndex(uri: string): int {
    var result = -1
    var index = 0
    while (result < 0 && index < this.overlays.size) {
        if (this.overlays[index].uri == uri) result = index
        index = index + 1
    }
    result
}

fun BootstrapAnalysisService.storeOverlay(
    uri: string,
    version: int,
    text: string
): bool {
    val index = this.overlayIndex(uri)
    var accepted = true
    if (index >= 0 && version < this.overlays[index].version) accepted = false
    if (accepted) {
        val document = BootstrapAnalysisDocument(
            uri, bootstrapAnalysisUriPath(uri), version, text, true
        )
        if (index >= 0) this.overlays[index] = document
        else this.overlays.append(document)
        this.revision = this.revision + 1
    }
    accepted
}

fun BootstrapAnalysisService.closeOverlay(uri: string): void {
    val index = this.overlayIndex(uri)
    if (index >= 0) {
        this.overlays[index].active = false
        this.revision = this.revision + 1
    }
}

fun bootstrapAnalysisIgnoredDirectory(name: string): bool =
    name == ".git" || name == "build" || name == "dist" ||
    name == "node_modules" || name == ".cache" || name == ".direnv"

fun bootstrapAnalysisHasPath(
    documents: array<BootstrapAnalysisDocument>,
    path: string
): bool {
    var found = false
    var index = 0
    while (!found && index < documents.size) {
        if (documents[index].path == path) found = true
        index = index + 1
    }
    found
}

fun bootstrapAnalysisCollectDirectory(
    directory: Path,
    var documents: array<BootstrapAnalysisDocument>
): void {
    if (documents.size >= ABLA_ANALYSIS_MAX_DOCUMENTS) return
    val entries = directory.entries()
    var index = 0
    while (index < entries.size &&
           documents.size < ABLA_ANALYSIS_MAX_DOCUMENTS) {
        val entry = entries[index]
        val info = entry.info()
        if (info.isDirectory() &&
            !bootstrapAnalysisIgnoredDirectory(entry.name())) {
            bootstrapAnalysisCollectDirectory(entry, documents)
        }
        if (info.isFile() && entry.extension() == "ab" &&
            !bootstrapAnalysisHasPath(documents, entry.text)) {
            documents.append(BootstrapAnalysisDocument(
                bootstrapAnalysisPathUri(entry.text),
                entry.text,
                0,
                entry.readText(),
                true
            ))
        }
        index = index + 1
    }
}

fun BootstrapAnalysisService.documents(): array<BootstrapAnalysisDocument> {
    val documents: array<BootstrapAnalysisDocument> = []
    var overlay = 0
    while (overlay < this.overlays.size) {
        if (this.overlays[overlay].active) {
            documents.append(this.overlays[overlay])
        }
        overlay = overlay + 1
    }
    var root = 0
    while (root < this.roots.size &&
           documents.size < ABLA_ANALYSIS_MAX_DOCUMENTS) {
        val path = Path(this.roots[root])
        val info = path.info()
        if (info.isDirectory()) {
            bootstrapAnalysisCollectDirectory(path, documents)
        }
        if (info.isFile() && path.extension() == "ab" &&
            !bootstrapAnalysisHasPath(documents, path.text)) {
            documents.append(BootstrapAnalysisDocument(
                bootstrapAnalysisPathUri(path.text),
                path.text,
                0,
                path.readText(),
                true
            ))
        }
        root = root + 1
    }
    documents
}

fun bootstrapAnalysisDocumentPathIndex(
    documents: array<BootstrapAnalysisDocument>,
    requested: string
): int {
    val normalized = bootstrapNormalizeModulePath(requested)
    var result = -1
    var index = 0
    while (result < 0 && index < documents.size) {
        if (bootstrapNormalizeModulePath(documents[index].path) == normalized) {
            result = index
        }
        index = index + 1
    }
    result
}

// A workspace may contain independent projects, examples, fixtures, and test
// cases with intentionally repeated declaration names. Only modules connected
// by a real import edge share a semantic universe. Keeping those components
// separate prevents an unrelated `main`, helper, or fixture from making an
// otherwise valid open document ambiguous.
fun bootstrapAnalysisComponentIds(
    documents: array<BootstrapAnalysisDocument>
): array<int> {
    val components: array<int> = []
    var document = 0
    while (document < documents.size) {
        components.append(document)
        document = document + 1
    }
    document = 0
    while (document < documents.size) {
        val scan = bootstrapScanImports(documents[document].text)
        var edge = 0
        while (edge < scan.edges.size) {
            if (!scan.edges[edge].provider) {
                val resolved = bootstrapImportAliasExposedTarget(
                    bootstrapResolveImport(
                        documents[document].path,
                        scan.edges[edge].source
                    )
                )
                val imported = bootstrapAnalysisDocumentPathIndex(
                    documents, resolved
                )
                if (imported >= 0 &&
                    components[document] != components[imported]) {
                    val replaced = components[imported]
                    val retained = components[document]
                    var index = 0
                    while (index < components.size) {
                        if (components[index] == replaced) {
                            components[index] = retained
                        }
                        index = index + 1
                    }
                }
            }
            edge = edge + 1
        }
        document = document + 1
    }
    components
}

fun bootstrapAnalysisSymbolKind(kind: string): string {
    var result = "function"
    if (kind == "class") result = "class"
    if (kind == "interface") result = "interface"
    if (kind == "enum") result = "enum"
    if (kind == "type") result = "type"
    if (kind == "val" || kind == "compile.val") result = "value"
    if (kind == "var" || kind == "compile.var") result = "variable"
    result
}

fun bootstrapAnalysisDeclarationId(
    declaration: BootstrapDeclaration
): string = "abla:${declaration.sourceIdentity}:${declaration.begin}:${declaration.name}"

/** The index of the first token that begins at or after `begin` (the tokens are in source order): the scans below start there,
 *  since nothing before it can begin inside a declaration, and stop at the first token past the end (they began at the start of the
 *  file for every declaration, parameter and expression: the quadratic part of an analysis). */
fun bootstrapAnalysisFirstTokenAt(tokens: array<BootstrapToken>, begin: int): int {
    var low = 0
    var high = tokens.size
    while (low < high) {
        val middle = low + (high - low) / 2
        if (tokens[middle].begin < begin) low = middle + 1 else high = middle
    }
    low
}

fun bootstrapAnalysisNameRange(
    tokens: array<BootstrapToken>,
    source: string,
    declaration: BootstrapDeclaration
): array<int> {
    var begin = declaration.begin
    var end = declaration.begin
    var found = false
    var index = bootstrapAnalysisFirstTokenAt(tokens, declaration.begin)
    while (!found && index < tokens.size && tokens[index].begin <= declaration.end) {
        val token = tokens[index]
        if (token.begin >= declaration.begin && token.end <= declaration.end &&
            token.kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
            bootstrapTokenText(source, token) == declaration.name) {
            begin = token.begin
            end = token.end
            found = true
        }
        index = index + 1
    }
    [begin, end]
}

/** The start of the line `at` is on. */
fun bootstrapAnalysisLineStart(source: string, at: int): int {
    var index = at
    while (index > 0 && source[index - 1] != 10) index = index - 1
    index
}

/** The first non-blank byte at or after `from` before `to`, or `to`. */
fun bootstrapAnalysisSkipBlanks(source: string, from: int, to: int): int {
    var index = from
    while (index < to && (source[index] == 32 || source[index] == 9)) index = index + 1
    index
}

/** The end of a line's text, without the blanks and the carriage return that end it. */
fun bootstrapAnalysisTrimEnd(source: string, from: int, to: int): int {
    var index = to
    while (index > from && (source[index - 1] == 32 || source[index - 1] == 9 || source[index - 1] == 13)) index = index - 1
    index
}

/** A line of a comment as text: the `//` or the leading `*` of a block comment's line, and one blank after it, left out. */
fun bootstrapAnalysisCommentLine(text: string, block: bool): string {
    var begin = 0
    var end = text.size
    while (begin < end && (text[begin] == 32 || text[begin] == 9)) begin = begin + 1
    if (!block) {
        while (begin < end && text[begin] == 47) begin = begin + 1
    } else if (begin < end && text[begin] == 42) begin = begin + 1
    if (begin < end && text[begin] == 32) begin = begin + 1
    while (end > begin && (text[end - 1] == 32 || text[end - 1] == 9 || text[end - 1] == 13)) end = end - 1
    text.slice(begin, end)
}

/** The documentation of the declaration (or constructor parameter) that begins at `offset`: the `/** ... */` block directly above it, or the
 *  run of `//` lines directly above it, as plain text. Only modifiers (`val`, `var`, `own`, `borrow`) may come before it on its line, annotation
 *  lines between the comment and it are skipped, and a blank line ends the search. "" for none. */
fun bootstrapAnalysisDocumentation(source: string, offset: int): string {
    if (offset <= 0 || offset > source.size) return ""
    val line = bootstrapAnalysisLineStart(source, offset)
    // Only blanks and modifier words before the declaration on its line.
    var cursor = bootstrapAnalysisSkipBlanks(source, line, offset)
    var modifiers = true
    while (modifiers && cursor < offset) {
        var word = cursor
        while (word < offset && source[word] != 32 && source[word] != 9) word = word + 1
        val text = source.slice(cursor, word)
        if (text == "val" || text == "var" || text == "own" || text == "borrow") cursor = bootstrapAnalysisSkipBlanks(source, word, offset)
        else modifiers = false
    }
    if (cursor < offset) return ""
    var top = line
    var collected: array<string> = []
    var found = false
    var block = false
    while (top > 0 && !found) {
        val previousStart = bootstrapAnalysisLineStart(source, top - 1)
        val first = bootstrapAnalysisSkipBlanks(source, previousStart, top - 1)
        val last = bootstrapAnalysisTrimEnd(source, first, top - 1)
        if (first == last) return ""
        if (source[first] == 64 && collected.size == 0) {
            top = previousStart
        } else if (last - first >= 2 && source[last - 2] == 42 && source[last - 1] == 47 && collected.size == 0) {
            // A block comment ends here: find where it begins.
            var open = last - 2
            while (open > 0 && !(source[open] == 47 && source[open + 1] == 42)) open = open - 1
            if (source[open] != 47 || source[open + 1] != 42 || open + 2 >= source.size || source[open + 2] != 42) return ""
            val inner = source.slice(open + 3, last - 2)
            var lineBegin = 0
            var index = 0
            while (index <= inner.size) {
                if (index == inner.size || inner[index] == 10) {
                    collected.append(bootstrapAnalysisCommentLine(inner.slice(lineBegin, index), true))
                    lineBegin = index + 1
                }
                index = index + 1
            }
            found = true
            block = true
        } else if (last - first >= 2 && source[first] == 47 && source[first + 1] == 47) {
            // A run of `//` lines, read from the bottom up.
            val lines: array<string> = []
            var upper = top
            var more = true
            while (more && upper > 0) {
                val start = bootstrapAnalysisLineStart(source, upper - 1)
                val lead = bootstrapAnalysisSkipBlanks(source, start, upper - 1)
                val trail = bootstrapAnalysisTrimEnd(source, lead, upper - 1)
                if (trail - lead >= 2 && source[lead] == 47 && source[lead + 1] == 47) {
                    lines.append(bootstrapAnalysisCommentLine(source.slice(lead, trail), false))
                    upper = start
                } else more = false
            }
            var at = lines.size
            while (at > 0) {
                at = at - 1
                collected.append(lines[at])
            }
            found = true
        } else return ""
    }
    if (!found) return ""
    var text = collected.join("\n")
    if (block) {
        // (Trailing and leading empty lines of a block comment are not part of its text.)
        var begin = 0
        var end = text.size
        while (begin < end && (text[begin] == 10 || text[begin] == 32)) begin = begin + 1
        while (end > begin && (text[end - 1] == 10 || text[end - 1] == 32)) end = end - 1
        text = text.slice(begin, end)
    }
    if (text.size > 4096) text.slice(0, 4096) else text
}

fun bootstrapAnalysisSymbolJson(
    tokens: array<BootstrapToken>,
    source: string,
    uri: string,
    declaration: BootstrapDeclaration,
    topLevel: bool,
    containerId: string
): Json {
    val selection = bootstrapAnalysisNameRange(tokens, source, declaration)
    bootstrapAnalysisNamedSymbolJson(
        bootstrapAnalysisDeclarationId(declaration),
        declaration.name,
        bootstrapAnalysisSymbolKind(declaration.kind),
        uri,
        declaration.begin,
        declaration.end,
        selection[0],
        selection[1],
        "${declaration.kind} ${declaration.resultType}",
        topLevel,
        containerId,
        bootstrapAnalysisDocumentation(source, declaration.begin)
    )
}

fun bootstrapAnalysisNamedSymbolJson(
    id: string,
    name: string,
    kind: string,
    uri: string,
    begin: int,
    end: int,
    selectionBegin: int,
    selectionEnd: int,
    detail: string,
    topLevel: bool,
    containerId: string,
    documentation: string = ""
): Json {
    val keys = [
        "id", "name", "kind", "uri", "range", "selectionRange",
        "detail", "topLevel"
    ]
    val values = [
        jsonString(id),
        jsonString(name),
        jsonString(kind),
        jsonString(uri),
        jsonObject(
            ["start", "end"],
            [jsonInteger(begin), jsonInteger(end)]
        ),
        jsonObject(
            ["start", "end"],
            [jsonInteger(selectionBegin), jsonInteger(selectionEnd)]
        ),
        jsonString(detail),
        jsonBoolean(topLevel)
    ]
    if (containerId != "") {
        keys.append("containerId")
        values.append(jsonString(containerId))
    }
    // What the comment above the declaration says of it (a client shows it where it shows the declaration).
    if (documentation != "") {
        keys.append("documentation")
        values.append(jsonString(documentation))
    }
    jsonObject(keys, values)
}

fun bootstrapAnalysisExpressionNameRange(
    tokens: array<BootstrapToken>,
    source: string,
    name: string,
    begin: int,
    end: int
): array<int> {
    var selectionBegin = begin
    var selectionEnd = begin
    var found = false
    var index = bootstrapAnalysisFirstTokenAt(tokens, begin)
    while (!found && index < tokens.size && tokens[index].begin <= end) {
        val token = tokens[index]
        if (token.begin >= begin && token.end <= end &&
            token.kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
            bootstrapTokenText(source, token) == name) {
            selectionBegin = token.begin
            selectionEnd = token.end
            found = true
        }
        index = index + 1
    }
    [selectionBegin, selectionEnd]
}

fun bootstrapAnalysisParameterRange(
    tokens: array<BootstrapToken>,
    source: string,
    declaration: BootstrapDeclaration,
    parameter: int
): array<int> {
    val name = declaration.parameters[parameter]
    var selection = [declaration.begin, declaration.begin]
    var found = false
    val headerEnd = if (declaration.expression.begin > declaration.begin) {
        declaration.expression.begin
    } else declaration.end
    var index = bootstrapAnalysisFirstTokenAt(tokens, declaration.begin)
    if (index < 1) index = 1
    while (!found && index < tokens.size && tokens[index].begin <= headerEnd) {
        val token = tokens[index]
        val previous = tokens[index - 1]
        val introducer = previous.kind == BOOTSTRAP_TOKEN_LPAREN || previous.kind ==
            BOOTSTRAP_TOKEN_COMMA ||
            (previous.kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
             bootstrapTokenText(source, previous) == "own") ||
            previous.kind == BOOTSTRAP_TOKEN_VAL ||
            previous.kind == BOOTSTRAP_TOKEN_VAR
        if (token.begin >= declaration.begin &&
            token.end <= headerEnd && introducer &&
            token.kind == BOOTSTRAP_TOKEN_IDENTIFIER &&
            bootstrapTokenText(source, token) == name) {
            selection = [token.begin, token.end]
            found = true
        }
        index = index + 1
    }
    [selection[0], selection[1]]
}

fun bootstrapAnalysisCollectLocalSymbols(
    tokens: array<BootstrapToken>,
    source: string,
    uri: string,
    sourceIdentity: string,
    expression: BootstrapExpression,
    containerId: string,
    var values: array<Json>
): void {
    var kind = ""
    var identityKind = "local"
    if (expression.kind == "local.val") kind = "value"
    if (expression.kind == "local.var") kind = "variable"
    if (expression.kind == "for") {
        kind = "value"
        identityKind = "for"
    }
    if (expression.kind == "lambda.parameter") {
        kind = "parameter"
        identityKind = "parameter"
    }
    val name = if (expression.kind == "for") bootstrapForName(expression)
        else expression.text
    if (kind != "" && name != "") {
        val selection = bootstrapAnalysisExpressionNameRange(
            tokens, source, name, expression.begin, expression.end
        )
        values.append(bootstrapAnalysisNamedSymbolJson(
            "abla:$sourceIdentity:${expression.begin}:$identityKind:${expression.text}",
            expression.text,
            kind,
            uri,
            expression.begin,
            expression.end,
            selection[0],
            selection[1],
            expression.kind,
            false,
            containerId
        ))
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapAnalysisCollectLocalSymbols(
            tokens, source, uri, sourceIdentity,
            expression.children[child], containerId, values
        )
        child = child + 1
    }
}

fun bootstrapAnalysisCollectDeclarationSymbols(
    tokens: array<BootstrapToken>,
    source: string,
    uri: string,
    declaration: BootstrapDeclaration,
    containerId: string,
    var values: array<Json>
): void {
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        val name = declaration.parameters[parameter]
        val selection = bootstrapAnalysisParameterRange(
            tokens, source, declaration, parameter
        )
        var kind = "parameter"
        var identityKind = "parameter"
        // A class's `val`/`var` parameter is its field; a function's `var` parameter is a mutable borrow, a parameter (sema names its uses so).
        if (declaration.kind == "class" && parameter < declaration.parameterKinds.size &&
            (declaration.parameterKinds[parameter] == "val" ||
             declaration.parameterKinds[parameter] == "var")) {
            kind = "property"
            identityKind = "field"
        }
        values.append(bootstrapAnalysisNamedSymbolJson(
            "abla:${declaration.sourceIdentity}:${declaration.begin}:$identityKind:$parameter:$name",
            name,
            kind,
            uri,
            selection[0],
            selection[1],
            selection[0],
            selection[1],
            if (parameter < declaration.parameterTypes.size)
                declaration.parameterTypes[parameter] else "unknown",
            false,
            containerId,
            if (kind == "property") bootstrapAnalysisDocumentation(source, selection[0]) else ""
        ))
        parameter = parameter + 1
    }
    bootstrapAnalysisCollectLocalSymbols(
        tokens, source, uri, declaration.sourceIdentity,
        declaration.expression, containerId, values
    )
}

fun bootstrapAnalysisSymbolsJson(
    source: string,
    uri: string,
    parsed: BootstrapParseResult
): Json {
    val values: array<Json> = []
    val tokens = bootstrapLex(source)
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        val id = bootstrapAnalysisDeclarationId(found)
        values.append(bootstrapAnalysisSymbolJson(
            tokens, source, uri, found, true, ""
        ))
        bootstrapAnalysisCollectDeclarationSymbols(
            tokens, source, uri, found, id, values
        )
        var method = 0
        while (method < found.methods.size) {
            val methodId = bootstrapAnalysisDeclarationId(
                found.methods[method]
            )
            values.append(bootstrapAnalysisSymbolJson(
                tokens, source, uri, found.methods[method], false, id
            ))
            bootstrapAnalysisCollectDeclarationSymbols(
                tokens, source, uri, found.methods[method], methodId, values
            )
            method = method + 1
        }
        declaration = declaration + 1
    }
    jsonArray(values)
}

/** The part of a declaration's stable id that tells overloads apart: its parameter types as written, for a function. */
fun bootstrapAnalysisStableSignature(declaration: BootstrapDeclaration): string {
    if (bootstrapAnalysisSymbolKind(declaration.kind) != "function") return ""
    "(${declaration.parameterTypes.join(",")})"
}

/** The declaration's own name as its stable id writes it: an extension is named by its owner. */
fun bootstrapAnalysisStableName(declaration: BootstrapDeclaration): string =
    if (declaration.extensionOwner != "" && !declaration.name.startsWith("${declaration.extensionOwner}."))
        "${declaration.extensionOwner}.${declaration.name}" else declaration.name

/** Where a symbol's stable id is kept while it is made: the ids taken so far (a second symbol with the same id gets `~2`, a
 *  third `~3`, ...), and the stable id of each symbol by the offset-based id the compiler's identities are translated to. */
class BootstrapAnalysisStableIds(
    val stable: Map<string, string> = Map(),
    val taken: Map<string, int> = Map()
)

fun bootstrapAnalysisStableOf(ids: BootstrapAnalysisStableIds, internal: string): string {
    val known = ids.stable.get(internal)
    if (known != null) known else ""
}

fun bootstrapAnalysisStableTake(var ids: BootstrapAnalysisStableIds, internal: string, base: string): string {
    val count = ids.taken.get(base)
    val stable = if (count == null) base else "$base~${count + 1}"
    ids.taken.set(base, if (count == null) 1 else count + 1)
    ids.stable.set(internal, stable)
    stable
}

/** Stable ids for the symbols of one module (the exported list `symbols`, whose ids are offset-based): a declaration is its
 *  module, its name and, for a function, its parameter types; a method is its class's id, its name and its parameter types; a
 *  parameter, a field, a local, a loop variable and a lambda parameter are their declaration's id and their name. An edit
 *  that moves the offsets, or adds or removes other declarations, does not change an id; only a change to the declaration's
 *  own name or parameter types does (and, for a local, the ordinal among those of the same name in its declaration). Keyed
 *  by the offset-based id. */
fun bootstrapAnalysisStableIdsOf(
    path: string,
    parsed: BootstrapParseResult,
    symbols: Json,
    enabled: bool
): Map<string, string> {
    val ids = BootstrapAnalysisStableIds()
    if (!enabled) return ids.stable
    val signatures: Map<string, string> = Map()
    for (declaration in parsed.declarations) {
        signatures.set(bootstrapAnalysisDeclarationId(declaration),
            "${bootstrapAnalysisStableName(declaration)}${bootstrapAnalysisStableSignature(declaration)}")
        for (method in declaration.methods) {
            signatures.set(bootstrapAnalysisDeclarationId(method),
                "${method.name}${bootstrapAnalysisStableSignature(method)}")
        }
    }
    for (symbol in symbols.values) {
        val internal = symbol.getString("id")
        val container = symbol.getString("containerId")
        val signature = signatures.get(internal)
        if (signature != null) {
            val owner = bootstrapAnalysisStableOf(ids, container)
            bootstrapAnalysisStableTake(ids, internal,
                if (owner != "") "${owner}.${signature}" else "abla:${path}#${signature}")
        } else {
            val owner = bootstrapAnalysisStableOf(ids, container)
            val kind = symbol.getString("kind")
            val detail = symbol.getString("detail")
            val role = if (kind == "property") "field"
                else if (kind == "parameter" && detail == "lambda.parameter") "lambda"
                else if (kind == "parameter") "param"
                else if (detail == "for") "for"
                else "local"
            val prefix = if (owner != "") owner else "abla:${path}#"
            bootstrapAnalysisStableTake(ids, internal, "${prefix}/${role}:${symbol.getString("name")}")
        }
    }
    ids.stable
}

/** `symbols` with each id (and container id) replaced by its stable id. */
fun bootstrapAnalysisStableSymbols(symbols: Json, stable: Map<string, string>): Json {
    val values: array<Json> = []
    for (symbol in symbols.values) {
        val keys: array<string> = []
        val newValues: array<Json> = []
        for (index in 0 until symbol.keys.size) {
            val key = symbol.keys[index]
            val value = symbol.values[index]
            keys.append(key)
            if (key == "id" || key == "containerId") {
                val known = stable.get(value.asString())
                newValues.append(if (known != null) jsonString(known) else value)
            } else newValues.append(value)
        }
        values.append(jsonObject(keys, newValues))
    }
    jsonArray(values)
}

fun bootstrapAnalysisCollectLocalIdentities(
    tokens: array<BootstrapToken>,
    source: string,
    sourceIdentity: string,
    expression: BootstrapExpression,
    var begins: array<int>,
    var ends: array<int>,
    var ids: array<string>
): void {
    var identityKind = ""
    if (expression.kind == "local.val" || expression.kind == "local.var") {
        identityKind = "local"
    }
    if (expression.kind == "for") identityKind = "for"
    if (expression.kind == "lambda.parameter") identityKind = "parameter"
    val name = if (expression.kind == "for") bootstrapForName(expression)
        else expression.text
    if (identityKind != "" && name != "") {
        val selection = bootstrapAnalysisExpressionNameRange(
            tokens, source, name, expression.begin, expression.end
        )
        begins.append(selection[0])
        ends.append(selection[1])
        ids.append(
            "abla:$sourceIdentity:${expression.begin}:$identityKind:$name"
        )
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapAnalysisCollectLocalIdentities(
            tokens, source, sourceIdentity, expression.children[child],
            begins, ends, ids
        )
        child = child + 1
    }
}

fun bootstrapAnalysisCollectDeclarationIdentities(
    tokens: array<BootstrapToken>,
    source: string,
    declaration: BootstrapDeclaration,
    var begins: array<int>,
    var ends: array<int>,
    var ids: array<string>
): void {
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        val selection = bootstrapAnalysisParameterRange(
            tokens, source, declaration, parameter
        )
        var identityKind = "parameter"
        if (declaration.kind == "class" && parameter < declaration.parameterKinds.size &&
            (declaration.parameterKinds[parameter] == "val" ||
             declaration.parameterKinds[parameter] == "var")) {
            identityKind = "field"
        }
        begins.append(selection[0])
        ends.append(selection[1])
        ids.append(
            "abla:${declaration.sourceIdentity}:${declaration.begin}:$identityKind:$parameter:${declaration.parameters[parameter]}"
        )
        parameter = parameter + 1
    }
    bootstrapAnalysisCollectLocalIdentities(
        tokens, source, declaration.sourceIdentity, declaration.expression,
        begins, ends, ids
    )
}

// Build once per semantic group. Preserve the legacy first-success ordering:
// declarations win, then resolved names, then the earliest successful call.
class BootstrapAnalysisOccurrenceTarget(val identity: string, val type: string, val canonical: string = "")
class BootstrapAnalysisOccurrenceIndex(
    val resolved: Map<string, BootstrapAnalysisOccurrenceTarget>,
    val calls: Map<string, array<BootstrapTypedCall>>,
    // The type declarations (class, interface, enum, type) by the name written in the source, the id of the one declaration of that
    // name in the program ("" when two declare it): sema records a name where it looks a value up, and a type is written as text, so
    // a type's uses (`s: Square`, `Square(2)`, `: Shape`) are named from here.
    val types: Map<string, string> = Map(),
    // Each top-level declaration by its module and the name written in the source (`<module path>#<name>`), "" when two of a module
    // declare it (overloads): what `geo.area` names when `geo` is an `import "…" as geo` of that module.
    val members: Map<string, string> = Map()
)

/** The key of a name occurrence in the index: the source by a short id (not its path, which each of the index's million
 *  keys would hold), then its span and name. */
fun bootstrapAnalysisOccurrenceKey(source: string, begin: int, end: int, name: string): string =
    "${bootstrapPathId(source)}:$begin:$end:$name"

fun bootstrapAnalysisOccurrenceIndex(
    declarations: array<BootstrapDeclaration>, semantic: BootstrapSemanticResult,
    builtins: Map<string, string> = Map()
): BootstrapAnalysisOccurrenceIndex {
    val resolved: Map<string, BootstrapAnalysisOccurrenceTarget> = Map()
    val calls: Map<string, array<BootstrapTypedCall>> = Map()
    for (name in semantic.resolvedNames) {
        val key = bootstrapAnalysisOccurrenceKey(name.sourceIdentity, name.begin, name.end,
            name.name)
        val previous = resolved.get(key)
        if (previous == null || previous.identity == "") {
            resolved.set(key, BootstrapAnalysisOccurrenceTarget(name.declarationIdentity,
                name.type, name.canonicalId))
        }
    }
    for (call in semantic.typedCalls) {
        val previous = calls.get(call.sourceIdentity)
        if (previous != null) previous.append(call)
        else calls.set(call.sourceIdentity, [call])
    }
    val types: Map<string, string> = Map()
    val members: Map<string, string> = Map()
    val builtinTypeNames = ["bool", "i8", "i16", "i32", "i64", "int", "u8", "u16", "u32", "u64", "f32", "f64", "char", "void", "never",
        "any", "string", "array", "Map", "Cell", "Mutex", "Shared", "Weak", "Fn", "FnMut", "FnOnce", "FnNoEscape"]
    for (index in 0 until declarations.size) {
        val declaration = declarations[index]
        // The name as written: a module imported under an alias has its names carry the module's prefix.
        val written = bootstrapCanonicalDeclarationSourceName(declaration.name)
        val memberKey = "${declaration.sourceIdentity}#$written"
        val member = members.get(memberKey)
        members.set(memberKey, if (member == null) bootstrapAnalysisDeclarationId(declaration) else "")
        val kind = declaration.kind
        if (kind == "class" || kind == "interface" || kind == "enum" || kind == "type") {
            val known = types.get(written)
            types.set(written, if (known == null) bootstrapAnalysisDeclarationId(declaration) else "")
        }
    }
    // The language's built-in types (`string`, `array`, `Map`, ...), by name, unless the program declares a type of that name: its own wins.
    for (name in builtinTypeNames) {
        if (types.get(name) == null) {
            val id = builtins.get(name)
            if (id != null) types.set(name, id)
        }
    }
    BootstrapAnalysisOccurrenceIndex(resolved, calls, types, members)
}

/** A type parameter's name: `T:Shape&Named` (a bound) is `T`. */
fun bootstrapAnalysisTypeParameterName(text: string): string {
    var end = 0
    while (end < text.size && text[end] != 58) end = end + 1
    text.slice(0, end)
}

// Index call candidates against token positions once, visiting only tokens in
// each call's source span. No scan of all program calls for every identifier.
fun bootstrapAnalysisCallTokens(
    source: string, sourceIdentity: string, tokens: array<BootstrapToken>,
    index: BootstrapAnalysisOccurrenceIndex
): Map<int, BootstrapAnalysisOccurrenceTarget> {
    val matches: Map<int, BootstrapAnalysisOccurrenceTarget> = Map()
    val calls = index.calls.get(sourceIdentity)
    if (calls == null) return matches
    for (call in calls) {
        var low = 0
        var high = tokens.size
        while (low < high) {
            val middle = low + (high - low) / 2
            if (tokens[middle].begin < call.begin) low = middle + 1 else high = middle
        }
        var cursor = low
        while (cursor < tokens.size && tokens[cursor].begin < call.end) {
            val token = tokens[cursor]
            var matchesCall = token.kind == BOOTSTRAP_TOKEN_IDENTIFIER && token.end <= call.end &&
                bootstrapTokenText(source, token) == call.name
            if (matchesCall && call.kind == "call") matchesCall = token.begin == call.begin
            if (matchesCall && call.kind == "member.call") {
                matchesCall = cursor > 0 && tokens[cursor - 1].kind == BOOTSTRAP_TOKEN_DOT
            }
            if (matchesCall) {
                val previous = matches.get(cursor)
                if (previous == null || previous.identity == "") {
                    val id = call.targetId
                    matches.set(cursor, BootstrapAnalysisOccurrenceTarget(id, call.type, call.canonicalTargetId))
                }
            }
            cursor = cursor + 1
        }
    }
    matches
}

/** The occurrences of one document in compact form: parallel arrays in token order (the span of each identifier, the
 *  declaration it names by the canonical id, "" for none, and its type, "" for none). The exported list is made from
 *  it, and the queries read it: there is no node per occurrence to keep. */
class BootstrapAnalysisOccurrenceSet(
    val begins: array<int>,
    val ends: array<int>,
    val ids: array<string>,
    val types: array<string>
)

fun bootstrapAnalysisOccurrenceSet(
    source: string,
    sourceIdentity: string,
    parsed: BootstrapParseResult,
    declarations: array<BootstrapDeclaration>,
    semantic: BootstrapSemanticResult,
    aliases: Map<string, string> = Map(),
    requireKnownIdentity: bool = false,
    occurrenceIndex: BootstrapAnalysisOccurrenceIndex? = null
): BootstrapAnalysisOccurrenceSet {
    val begins: array<int> = []
    val ends: array<int> = []
    val ids: array<string> = []
    val types: array<string> = []
    val tokens = bootstrapLex(source)
    val declarationBegins: array<int> = []
    val declarationEnds: array<int> = []
    val declarationIds: array<string> = []
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        val selection = bootstrapAnalysisNameRange(tokens, source, found)
        declarationBegins.append(selection[0])
        declarationEnds.append(selection[1])
        declarationIds.append(bootstrapAnalysisDeclarationId(found))
        bootstrapAnalysisCollectDeclarationIdentities(
            tokens, source, found,
            declarationBegins, declarationEnds, declarationIds
        )
        var method = 0
        while (method < found.methods.size) {
            val member = found.methods[method]
            val memberSelection = bootstrapAnalysisNameRange(
                tokens, source, member
            )
            declarationBegins.append(memberSelection[0])
            declarationEnds.append(memberSelection[1])
            declarationIds.append(bootstrapAnalysisDeclarationId(member))
            bootstrapAnalysisCollectDeclarationIdentities(
                tokens, source, member,
                declarationBegins, declarationEnds, declarationIds
            )
            method = method + 1
        }
        declaration = declaration + 1
    }
    val declarationAt: Map<string, string> = Map()
    for (item in 0 until declarationIds.size) {
        declarationAt.set("${declarationBegins[item]}:${declarationEnds[item]}",
            declarationIds[item])
    }
    val semanticIndex = if (occurrenceIndex != null) occurrenceIndex
        else bootstrapAnalysisOccurrenceIndex(declarations, semantic)
    val callAt = bootstrapAnalysisCallTokens(source, sourceIdentity, tokens, semanticIndex)
    // The modules this one imports under an alias, by alias: `geo.area` is the `area` of the module `geo` names.
    val aliasTargets: Map<string, string> = Map()
    val scan = bootstrapScanImports(source)
    for (edge in scan.edges) {
        if (!edge.provider && edge.alias != "") {
            aliasTargets.set(edge.alias, bootstrapImportAliasExposedTarget(
                bootstrapResolveImport(sourceIdentity, edge.source)))
        }
    }
    // A type parameter (`T`) is not the type of that name, if the program has one.
    val typeParameters: Map<string, bool> = Map()
    for (found in parsed.declarations) {
        for (parameter in found.typeParameters) typeParameters.set(bootstrapAnalysisTypeParameterName(parameter), true)
        for (member in found.methods) {
            for (parameter in member.typeParameters) typeParameters.set(bootstrapAnalysisTypeParameterName(parameter), true)
        }
    }
    // The class a token is in (the declarations are in source order, and so are the tokens), and that class's methods by name.
    var enclosing = 0
    var classMethods: Map<string, string> = Map()
    var classMethodsOf = -1
    var index = 0
    while (index < tokens.size) {
        val token = tokens[index]
        if (token.kind == BOOTSTRAP_TOKEN_IDENTIFIER) {
            val name = bootstrapTokenText(source, token)
            val declared = declarationAt.get("${token.begin}:${token.end}")
            var declarationId = if (declared != null) declared else ""
            var resolvedType = ""
            // What the service's conversion of the semantic result made of the id a sema row names (see BootstrapResolvedName.canonicalId).
            var translated = ""
            var fromRow = false
            if (declarationId == "") {
                val resolved = semanticIndex.resolved.get(bootstrapAnalysisOccurrenceKey(
                    sourceIdentity, token.begin, token.end, name))
                if (resolved != null) {
                    declarationId = resolved.identity
                    resolvedType = resolved.type
                    translated = resolved.canonical
                    fromRow = resolved.identity != ""
                }
            }
            if (declarationId == "") {
                val call = callAt.get(index)
                if (call != null) {
                    declarationId = call.identity
                    resolvedType = call.type
                    translated = call.canonical
                    fromRow = call.identity != ""
                }
            }
            if (declarationId == "" && index + 1 < tokens.size && tokens[index + 1].kind == BOOTSTRAP_TOKEN_LPAREN &&
                (index == 0 || tokens[index - 1].kind != BOOTSTRAP_TOKEN_DOT)) {
                // `twice(n)` inside a class's method, a call of its own method on `this`, written without it.
                while (enclosing < parsed.declarations.size && parsed.declarations[enclosing].end <= token.begin) enclosing = enclosing + 1
                if (enclosing < parsed.declarations.size && parsed.declarations[enclosing].kind == "class" &&
                    parsed.declarations[enclosing].begin <= token.begin) {
                    if (classMethodsOf != enclosing) {
                        classMethods = Map()
                        for (member in parsed.declarations[enclosing].methods) {
                            val known = classMethods.get(member.name)
                            classMethods.set(member.name, if (known == null) bootstrapAnalysisDeclarationId(member) else "")
                        }
                        classMethodsOf = enclosing
                    }
                    val sibling = classMethods.get(name)
                    if (sibling != null) declarationId = sibling
                }
            }
            if (declarationId == "") {
                if (index > 0 && tokens[index - 1].kind == BOOTSTRAP_TOKEN_DOT) {
                    // `geo.area`, `geo.Square`: a member of the module `geo` is an alias of.
                    if (index > 1 && tokens[index - 2].kind == BOOTSTRAP_TOKEN_IDENTIFIER) {
                        val target = aliasTargets.get(bootstrapTokenText(source, tokens[index - 2]))
                        if (target != null) {
                            val member = semanticIndex.members.get("$target#$name")
                            if (member != null) declarationId = member
                        }
                    }
                } else if (typeParameters.get(name) == null) {
                    // A type written as text: `s: Square`, `Square(2)`, `: Shape`.
                    val known = semanticIndex.types.get(name)
                    if (known != null) declarationId = known
                }
            }
            if (declarationId != "") {
                // A row's id was translated once, where the semantic result was converted (when this is asked to keep only known ones).
                val canonical = if (fromRow && requireKnownIdentity) (if (translated != "") translated else null)
                    else aliases.get(declarationId)
                if (canonical != null) declarationId = canonical
                else if (requireKnownIdentity) declarationId = ""
            }
            begins.append(token.begin)
            ends.append(token.end)
            ids.append(declarationId)
            types.append(resolvedType)
        }
        index = index + 1
    }
    BootstrapAnalysisOccurrenceSet(begins, ends, ids, types)
}

/** The exported occurrences (a name, its range, and its declarationId and type when it has them) as a tree. */
fun bootstrapAnalysisOccurrenceSetJson(source: string, set: BootstrapAnalysisOccurrenceSet): Json {
    val values: array<Json> = []
    for (item in 0 until set.begins.size) {
        val keys = ["name", "range"]
        val occurrenceValues = [
            jsonString(source.slice(set.begins[item], set.ends[item])),
            jsonObject(
                ["start", "end"],
                [jsonInteger(set.begins[item]), jsonInteger(set.ends[item])]
            )
        ]
        if (set.ids[item] != "") {
            keys.append("declarationId")
            occurrenceValues.append(jsonString(set.ids[item]))
        }
        if (set.types[item] != "") {
            keys.append("type")
            occurrenceValues.append(jsonString(set.types[item]))
        }
        values.append(jsonObject(keys, occurrenceValues))
    }
    jsonArray(values)
}

/** The same list as jsonStringify writes it, without the tree: one string per document, kept as a raw node in the answer. */
fun bootstrapAnalysisOccurrenceSetText(source: string, set: BootstrapAnalysisOccurrenceSet): string {
    val out = byteBuffer()
    out.appendText("[")
    for (item in 0 until set.begins.size) {
        if (item > 0) out.appendText(",")
        out.appendText("{\"name\":")
        out.appendText(jsonQuote(source.slice(set.begins[item], set.ends[item])))
        out.appendText(",\"range\":{\"start\":${set.begins[item]},\"end\":${set.ends[item]}}")
        if (set.ids[item] != "") {
            out.appendText(",\"declarationId\":")
            out.appendText(jsonQuote(set.ids[item]))
        }
        if (set.types[item] != "") {
            out.appendText(",\"type\":")
            out.appendText(jsonQuote(set.types[item]))
        }
        out.appendText("}")
    }
    out.appendText("]")
    out.toText()
}

fun bootstrapAnalysisOccurrencesJson(
    source: string,
    sourceIdentity: string,
    parsed: BootstrapParseResult,
    declarations: array<BootstrapDeclaration>,
    semantic: BootstrapSemanticResult,
    aliases: Map<string, string> = Map(),
    requireKnownIdentity: bool = false,
    occurrenceIndex: BootstrapAnalysisOccurrenceIndex? = null
): Json = bootstrapAnalysisOccurrenceSetJson(source, bootstrapAnalysisOccurrenceSet(source,
    sourceIdentity, parsed, declarations, semantic, aliases, requireKnownIdentity,
    occurrenceIndex))

fun bootstrapAnalysisHandleId(
    declarations: array<BootstrapDeclaration>,
    handle: int
): string {
    var id = ""
    if (handle >= 0 && handle < declarations.size) {
        id = bootstrapAnalysisDeclarationId(declarations[handle])
    }
    if (handle >= declarations.size) {
        val requested = handle - declarations.size
        var current = 0
        var owner = 0
        while (id == "" && owner < declarations.size) {
            var method = 0
            while (id == "" && method < declarations[owner].methods.size) {
                if (current == requested) id = bootstrapAnalysisDeclarationId(
                    declarations[owner].methods[method]
                )
                current = current + 1
                method = method + 1
            }
            owner = owner + 1
        }
    }
    id
}

fun bootstrapAnalysisCollectTypedRequests(
    expression: BootstrapExpression,
    sourceIdentity: string,
    var begins: array<int>,
    var ends: array<int>,
    var kinds: array<string>,
    var sources: array<string>
): void {
    if (expression.kind == "call" || expression.kind == "member.call") {
        begins.append(expression.begin)
        ends.append(expression.end)
        kinds.append(expression.kind)
        sources.append(sourceIdentity)
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapAnalysisCollectTypedRequests(
            expression.children[child], sourceIdentity,
            begins, ends, kinds, sources
        )
        child = child + 1
    }
}

fun bootstrapAnalysisCollectDeclarationRequests(
    declaration: BootstrapDeclaration,
    var begins: array<int>,
    var ends: array<int>,
    var kinds: array<string>,
    var sources: array<string>
): void {
    bootstrapAnalysisCollectTypedRequests(
        declaration.expression, declaration.sourceIdentity,
        begins, ends, kinds, sources
    )
    var value = 0
    while (value < declaration.parameterDefaults.size) {
        bootstrapAnalysisCollectTypedRequests(
            declaration.parameterDefaults[value], declaration.sourceIdentity,
            begins, ends, kinds, sources
        )
        value = value + 1
    }
    value = 0
    while (value < declaration.annotationArguments.size) {
        bootstrapAnalysisCollectTypedRequests(
            declaration.annotationArguments[value], declaration.sourceIdentity,
            begins, ends, kinds, sources
        )
        value = value + 1
    }
    var method = 0
    while (method < declaration.methods.size) {
        bootstrapAnalysisCollectDeclarationRequests(
            declaration.methods[method], begins, ends, kinds, sources
        )
        method = method + 1
    }
}

fun bootstrapAnalysisDiagnosticCode(diagnostics: string): string =
    bootstrapFrontendDiagnosticCode(diagnostics)

fun bootstrapAnalysisAppendLocatedDiagnostics(
    diagnostics: string,
    prefix: string,
    text: string,
    var values: array<Json>
): void {
    val located: array<BootstrapFrontendDiagnostic> = []
    bootstrapFrontendAppendLocatedDiagnostics(diagnostics, prefix, "", text, located)
    for (diagnostic in located) {
        values.append(jsonObject(
            ["code", "message", "range"],
            [jsonString(diagnostic.code), jsonString(diagnostic.message),
                jsonObject(["start", "end"],
                    [jsonInteger(diagnostic.begin), jsonInteger(diagnostic.end)])]
        ))
    }
    return
}

fun bootstrapAnalysisDiagnosticsJson(
    text: string,
    parsed: BootstrapParseResult,
    semantic: BootstrapSemanticResult,
    sourceIdentity: string
): Json {
    val values: array<Json> = []
    bootstrapAnalysisAppendLocatedDiagnostics(
        parsed.diagnostics,
        "source[parser]:$sourceIdentity:",
        text,
        values
    )
    // Extension diagnostics do not all carry a normalized source identity yet.
    // Preserve a visible fallback until every generated/subparser producer does.
    if (values.size == 0 && (parsed.errors > 0 ||
        parsed.extensionErrors > 0 || parsed.diagnostics != "")) {
        values.append(jsonObject(
            ["code", "message", "range"],
            [
                jsonString(bootstrapAnalysisDiagnosticCode(
                    parsed.diagnostics
                )),
                jsonString(parsed.diagnostics),
                jsonObject(
                    ["start", "end"],
                    [jsonInteger(0), jsonInteger(if (text.size > 0) 1 else 0)]
                )
            ]
        ))
    }
    bootstrapAnalysisAppendLocatedDiagnostics(
        semantic.diagnostics,
        "source[semantic]:$sourceIdentity:",
        text,
        values
    )
    jsonArray(values)
}

fun bootstrapAnalysisDocumentJson(
    document: BootstrapAnalysisDocument,
    parsed: BootstrapParseResult,
    declarations: array<BootstrapDeclaration>,
    semantic: BootstrapSemanticResult,
    occurrenceIndex: BootstrapAnalysisOccurrenceIndex
): Json {
    jsonObject(
        [
            "uri", "version", "text", "symbols", "occurrences",
            "diagnostics"
        ],
        [
            jsonString(document.uri),
            jsonInteger(document.version),
            jsonString(document.text),
            bootstrapAnalysisSymbolsJson(document.text, document.uri, parsed),
            bootstrapAnalysisOccurrencesJson(
                document.text, document.path, parsed, declarations, semantic, Map(), false,
                occurrenceIndex
            ),
            bootstrapAnalysisDiagnosticsJson(
                document.text, parsed, semantic, document.path
            )
        ]
    )
}

fun bootstrapAnalysisSemanticGroup(
    documents: array<BootstrapAnalysisDocument>,
    parsedDocuments: array<BootstrapParseResult>,
    components: array<int>,
    requestedComponent: int
): BootstrapAnalysisSemanticGroup {
    val declarations: array<BootstrapDeclaration> = []
    val actions: array<BootstrapExpression> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    var errors = 0
    var extensionErrors = 0
    var diagnostics = ""
    val typedBegins: array<int> = []
    val typedEnds: array<int> = []
    val typedKinds: array<string> = []
    val typedSources: array<string> = []
    var document = 0
    while (document < documents.size) {
        if (components[document] == requestedComponent) {
            val parsed = parsedDocuments[document]
            errors = errors + parsed.errors
            extensionErrors = extensionErrors + parsed.extensionErrors
            diagnostics = "$diagnostics${parsed.diagnostics}"
            var declaration = 0
            while (declaration < parsed.declarations.size) {
                declarations.append(parsed.declarations[declaration])
                bootstrapAnalysisCollectDeclarationRequests(
                    parsed.declarations[declaration],
                    typedBegins, typedEnds, typedKinds, typedSources
                )
                declaration = declaration + 1
            }
            var action = 0
            while (action < parsed.actions.size) {
                actions.append(parsed.actions[action])
                bootstrapAnalysisCollectTypedRequests(
                    parsed.actions[action], documents[document].path,
                    typedBegins, typedEnds, typedKinds, typedSources
                )
                action = action + 1
            }
        }
        document = document + 1
    }
    val merged = BootstrapParseResult(
        declarations, actions, errors, extensionErrors,
        compileInputPaths, compileInputContents, diagnostics
    )
    val semantic = bootstrapFrontendAnalyzeRequested(
        merged, typedBegins, typedEnds, typedKinds, typedSources
    )
    BootstrapAnalysisSemanticGroup(declarations, semantic,
        bootstrapAnalysisOccurrenceIndex(declarations, semantic))
}

fun BootstrapAnalysisService.legacySnapshot(): Json {
    val documents = this.documents()
    val parsedDocuments: array<BootstrapParseResult> = []
    var documentIndex = 0
    while (documentIndex < documents.size) {
        val parsed = bootstrapParseWithIdentity(
            documents[documentIndex].text,
            documents[documentIndex].path
        )
        parsedDocuments.append(parsed)
        documentIndex = documentIndex + 1
    }
    val components = bootstrapAnalysisComponentIds(documents)
    val groupIds: array<int> = []
    val groups: array<BootstrapAnalysisSemanticGroup> = []
    val values: array<Json> = []
    var index = 0
    while (index < documents.size) {
        var group = -1
        var candidate = 0
        while (group < 0 && candidate < groupIds.size) {
            if (groupIds[candidate] == components[index]) group = candidate
            candidate = candidate + 1
        }
        if (group < 0) {
            groupIds.append(components[index])
            groups.append(bootstrapAnalysisSemanticGroup(
                documents, parsedDocuments, components, components[index]
            ))
            group = groups.size - 1
        }
        values.append(bootstrapAnalysisDocumentJson(
            documents[index], parsedDocuments[index],
            groups[group].declarations, groups[group].semantic, groups[group].occurrenceIndex
        ))
        index = index + 1
    }
    jsonObject(
        ["revision", "documents"],
        [jsonString("${this.revision}"), jsonArray(values)]
    )
}

fun BootstrapAnalysisService.snapshot(): Json =
    if (this.graphMode) this.graphSnapshot() else this.legacySnapshot()

fun bootstrapAnalysisSnapshotDiagnosticCount(
    snapshot: Json,
    uri: string,
    code: string,
    message: string
): int {
    var count = 0
    val documents = snapshot.get("documents")
    var document = 0
    while (documents.isArray() && document < documents.size()) {
        val found = documents.at(document)
        if (uri == "" || found.getString("uri") == uri) {
            val diagnostics = found.get("diagnostics")
            var diagnostic = 0
            while (diagnostics.isArray() && diagnostic < diagnostics.size()) {
                val candidate = diagnostics.at(diagnostic)
                if ((code == "" || candidate.getString("code") == code) &&
                    (message == "" ||
                     candidate.getString("message") == message)) {
                    count = count + 1
                }
                diagnostic = diagnostic + 1
            }
        }
        document = document + 1
    }
    count
}

fun bootstrapAnalysisSnapshotIntroducesDiagnostic(
    baseline: Json,
    prospective: Json
): bool {
    var introduced = false
    val documents = prospective.get("documents")
    var document = 0
    while (!introduced && documents.isArray() && document < documents.size()) {
        val found = documents.at(document)
        val uri = found.getString("uri")
        val diagnostics = found.get("diagnostics")
        var diagnostic = 0
        while (!introduced && diagnostics.isArray() &&
            diagnostic < diagnostics.size()) {
            val candidate = diagnostics.at(diagnostic)
            val code = candidate.getString("code")
            val message = candidate.getString("message")
            val candidateCount = bootstrapAnalysisSnapshotDiagnosticCount(
                prospective, uri, code, message
            )
            val baselineCount = bootstrapAnalysisSnapshotDiagnosticCount(
                baseline, uri, code, message
            )
            if (candidateCount > baselineCount) introduced = true
            diagnostic = diagnostic + 1
        }
        document = document + 1
    }
    introduced
}

fun bootstrapAnalysisEditsUri(edits: Json, uri: string): bool {
    var found = false
    var edit = 0
    while (!found && edits.isArray() && edit < edits.size()) {
        if (edits.at(edit).getString("uri") == uri) found = true
        edit = edit + 1
    }
    found
}

fun bootstrapAnalysisSnapshotPreservesUneditedSymbols(
    baseline: Json,
    prospective: Json,
    edits: Json
): bool {
    var preserved = true
    val baselineDocuments = baseline.get("documents")
    val prospectiveDocuments = prospective.get("documents")
    var document = 0
    while (preserved && baselineDocuments.isArray() &&
        document < baselineDocuments.size()) {
        val before = baselineDocuments.at(document)
        val uri = before.getString("uri")
        if (!bootstrapAnalysisEditsUri(edits, uri)) {
            var afterIndex = 0
            var matched = false
            while (!matched && prospectiveDocuments.isArray() &&
                afterIndex < prospectiveDocuments.size()) {
                val after = prospectiveDocuments.at(afterIndex)
                if (after.getString("uri") == uri) {
                    matched = jsonStringify(before.get("symbols")) ==
                        jsonStringify(after.get("symbols"))
                }
                afterIndex = afterIndex + 1
            }
            if (!matched) preserved = false
        }
        document = document + 1
    }
    preserved
}

fun bootstrapAnalysisOwnedString(value: string): string = "$value"

fun BootstrapAnalysisService.validateEdit(params: Json): Json {
    val graphBaseline = if (this.graphMode) this.graphSnapshot() else jsonNull()
    var valid = params.getString("baseRevision") == "${this.revision}"
    var reason = if (valid) "" else "analysis revision is stale"
    val candidate = BootstrapAnalysisService([], [], this.revision, true, true)
    candidate.graphMode = this.graphMode
    candidate.graphStableIds = this.graphStableIds
    for (entry in this.graphEntries) candidate.graphEntries.append(entry)
    var root = 0
    while (root < this.roots.size) {
        candidate.roots.append(bootstrapAnalysisOwnedString(this.roots[root]))
        root = root + 1
    }
    val documents = this.documents()
    var document = 0
    while (document < documents.size) {
        val found = documents[document]
        candidate.overlays.append(BootstrapAnalysisDocument(
            bootstrapAnalysisOwnedString(found.uri),
            bootstrapAnalysisOwnedString(found.path),
            found.version,
            bootstrapAnalysisOwnedString(found.text),
            true
        ))
        document = document + 1
    }

    val createdDocuments = params.get("createdDocuments")
    if (!createdDocuments.isNull() && !createdDocuments.isArray()) {
        valid = false
        reason = "createdDocuments must be an array"
    }
    document = 0
    while (valid && createdDocuments.isArray() &&
        document < createdDocuments.size()) {
        val created = createdDocuments.at(document)
        val uri = created.getString("uri")
        if (uri.size == 0) {
            valid = false
            reason = "created document URI must not be empty"
        } else if (candidate.overlayIndex(uri) >= 0) {
            valid = false
            reason = "created document already exists"
        } else candidate.overlays.append(BootstrapAnalysisDocument(
            bootstrapAnalysisOwnedString(uri),
            bootstrapAnalysisUriPath(uri),
            1,
            bootstrapAnalysisOwnedString(created.getString("text")),
            true
        ))
        document = document + 1
    }

    val edits = params.get("edits")
    if (!edits.isArray()) {
        valid = false
        reason = "edits must be an array"
    }
    document = 0
    var edit = 0
    while (valid && document < candidate.overlays.size) {
        val uri = candidate.overlays[document].uri
        var text = bootstrapAnalysisOwnedString(
            candidate.overlays[document].text
        )
        val applied: array<bool> = []
        edit = 0
        while (edit < edits.size()) {
            applied.append(edits.at(edit).getString("uri") != uri)
            edit = edit + 1
        }
        var remaining = true
        while (valid && remaining) {
            remaining = false
            var selected = -1
            var selectedStart = -1
            edit = 0
            while (edit < edits.size()) {
                if (!applied[edit]) {
                    remaining = true
                    val start = edits.at(edit).getInt("start")
                    if (start > selectedStart) {
                        selected = edit
                        selectedStart = start
                    }
                }
                edit = edit + 1
            }
            if (selected >= 0) {
                val requested = edits.at(selected)
                val start = requested.getInt("start")
                val end = requested.getInt("end")
                if (start < 0 || end < start || end > text.size) {
                    valid = false
                    reason = "edit range is outside its document"
                } else text = "${text.slice(0, start)}${requested.getString(
                    "newText"
                )}${text.slice(end, text.size)}"
                applied[selected] = true
            }
        }
        if (valid && text != candidate.overlays[document].text) {
            val previous = candidate.overlays[document]
            candidate.overlays[document] = BootstrapAnalysisDocument(
                bootstrapAnalysisOwnedString(previous.uri),
                bootstrapAnalysisOwnedString(previous.path),
                previous.version + 1,
                text,
                true
            )
        }
        document = document + 1
    }
    edit = 0
    while (valid && edit < edits.size()) {
        if (candidate.overlayIndex(edits.at(edit).getString("uri")) < 0) {
            valid = false
            reason = "edit targets an unanalyzed document"
        }
        edit = edit + 1
    }

    val baseline = if (this.graphMode) graphBaseline else this.snapshot()
    if (this.graphMode && !baseline.get("complete").asBoolean()) {
        return jsonObject(["valid", "reason"], [jsonBoolean(false),
            jsonString("graph analysis is incomplete; compile-time evaluation was not performed")])
    }
    if (this.graphMode) {
        candidate.graphEntries.truncate(0)
        candidate.graphEntries.append(baseline.getString("entry"))
    }
    val prospective = if (valid) candidate.snapshot() else jsonNull()
    if (valid && this.graphMode && !prospective.get("complete").asBoolean()) {
        valid = false
        reason =
            "prospective graph analysis is incomplete; compile-time evaluation was not performed"
    }
    if (valid && bootstrapAnalysisSnapshotIntroducesDiagnostic(
        baseline, prospective
    )) {
        valid = false
        reason = "prospective edit introduces compiler diagnostics"
    }
    if (valid && !bootstrapAnalysisSnapshotPreservesUneditedSymbols(
        baseline, prospective, edits
    )) {
        valid = false
        reason = "prospective edit changes symbols outside edited documents"
    }
    if (valid) jsonObject(
        ["valid", "snapshot"],
        [jsonBoolean(true), prospective]
    ) else jsonObject(
        ["valid", "reason"],
        [jsonBoolean(false), jsonString(reason)]
    )
}

fun bootstrapAnalysisResponse(id: int, result: Json): string =
    jsonStringify(jsonObject(
        ["schema", "id", "result"],
        [jsonInteger(ABLA_ANALYSIS_PROTOCOL_VERSION), jsonInteger(id), result]
    ))

fun bootstrapAnalysisError(id: int, code: string, message: string): string =
    jsonStringify(jsonObject(
        ["schema", "id", "error"],
        [
            jsonInteger(ABLA_ANALYSIS_PROTOCOL_VERSION),
            jsonInteger(id),
            jsonObject(
                ["code", "message"],
                [jsonString(code), jsonString(message)]
            )
        ]
    ))

fun BootstrapAnalysisService.initialize(params: Json): Json {
    val requestedRoots = params.get("workspaceRoots")
    var index = 0
    if (requestedRoots.isArray()) {
        while (index < requestedRoots.size()) {
            val root = requestedRoots.at(index)
            if (root.isString()) this.roots.append(root.asString())
            index = index + 1
        }
    }
    this.graphMode = params.getString("analysisMode") == "graph-v1" ||
        params.getString("analysisMode") == "graph-v2"
    this.graphStableIds = params.getString("analysisMode") == "graph-v2"
    val entries = params.get("entryPoints")
    var entryIndex = 0
    while (entries.isArray() && entryIndex < entries.size()) {
        if (entries.at(entryIndex).isString()) this.graphEntries.append(entries.at(entryIndex)
            .asString())
        entryIndex = entryIndex + 1
    }
    val capabilities = [jsonString("document-overlays"), jsonString("parser-diagnostics"),
        jsonString("declarations"), jsonString("semantic-call-references"),
        jsonString("semantic-name-references")]
    if (this.graphMode) {
        capabilities.append(jsonString("module-graph-analysis-v1"))
        if (this.graphStableIds) {
            capabilities.append(jsonString("stable-declaration-ids-v1"))
            capabilities.append(jsonString("analysis-since-v1"))
        }
        capabilities.append(jsonString("no-eval-ct"))
        capabilities.append(jsonString("pre-ct-types"))
        capabilities.append(jsonString("analysis-queries-v1"))
        capabilities.append(jsonString("analysis-fields-v1"))
        capabilities.append(jsonString("refactor-validation-complete-only"))
    }
    this.initialized = true
    jsonObject(
        ["compilerVersion", "protocolVersion", "capabilities"],
        [
            jsonString(ABLA_COMPILER_VERSION),
            jsonInteger(ABLA_ANALYSIS_PROTOCOL_VERSION),
            jsonArray(capabilities)
        ]
    )
}

fun BootstrapAnalysisService.handle(request: Json): string {
    val id = request.getInt("id")
    val schema = request.getInt("schema")
    val method = request.getString("method")
    val params = request.get("params")
    var response = ""
    if (schema != ABLA_ANALYSIS_PROTOCOL_VERSION) {
        response = bootstrapAnalysisError(
            id, "unsupported_schema", "unsupported analysis protocol schema"
        )
    } else if (method == "initialize") {
        val mode = params.getString("analysisMode")
        if (mode != "" && mode != "graph-v1" && mode != "graph-v2") response = bootstrapAnalysisError(id,
            "unsupported_analysis_mode", "unsupported analysisMode")
        else if (this.initialized && (this.graphMode || mode == "graph-v1" || mode == "graph-v2")) response =
            bootstrapAnalysisError(id, "already_initialized",
                "initialize may only run once in graph mode")
        else response = bootstrapAnalysisResponse(id, this.initialize(params))
    } else if (!this.initialized) {
        response = bootstrapAnalysisError(
            id, "not_initialized", "initialize must be the first request"
        )
    } else if (method == "document/open" || method == "document/change") {
        val uri = params.getString("uri")
        if (this.graphMode && !bootstrapAnalysisGraphUriValid(uri)) return bootstrapAnalysisError(
            id, "invalid_params", "graph documents require a local absolute file URI")
        if (this.graphMode) {
            for (overlay in this.overlays) {
                if (overlay.active && overlay.uri != uri &&
                    bootstrapAnalysisGraphPath(overlay.path) == bootstrapAnalysisGraphPath(uri)) {
                    return bootstrapAnalysisError(id, "duplicate_document_path",
                        "the same lexical path is already open under another URI")
                }
            }
        }
        val accepted = this.storeOverlay(
            uri, params.getInt("version"), params.getString("text")
        )
        if (uri == "") response = bootstrapAnalysisError(
            id, "invalid_params", "document uri must not be empty"
        )
        else if (!accepted) response = bootstrapAnalysisError(
            id, "stale_document", "document version is older than the overlay"
        )
        else response = bootstrapAnalysisResponse(id, jsonNull())
    } else if (method == "document/close") {
        this.closeOverlay(params.getString("uri"))
        response = bootstrapAnalysisResponse(id, jsonNull())
    } else if (method == "analyze") {
        if (this.graphMode && params.has("fields") &&
            !bootstrapAnalysisGraphFieldsValid(params.get("fields"))) {
            return bootstrapAnalysisError(id, "invalid_params",
                "fields must be an array of distinct diagnostics, symbols or occurrences")
        }
        if (this.graphMode && params.get("roots").isArray()) {
            this.graphEntries.truncate(0)
            for (root in params.get("roots").values) {
                if (root.isString()) this.graphEntries.append(root.asString())
            }
        }
        if (params.has("since") && (!this.graphStableIds || !params.get("since").isString())) {
            return bootstrapAnalysisError(id, "invalid_params",
                "since is a revision string, and needs analysisMode graph-v2")
        }
        val snapshot = this.snapshot()
        val answer = this.graphMaterialize(if (params.has("since")) this.graphSince(snapshot, params.getString("since"))
            else snapshot)
        response = bootstrapAnalysisResponse(id,
            if (this.graphMode && params.has("fields")) bootstrapAnalysisGraphProjection(answer,
                params.get("fields"))
            else answer)
    } else if (this.graphMode && (method == "query/definition" || method == "query/hover" ||
        method == "query/references")) {
        response = this.graphQuery(id, method, params)
    } else if (method == "refactor/validate") {
        response = bootstrapAnalysisResponse(id, this.validateEdit(params))
    } else if (method == "shutdown") {
        bootstrapAnalysisSampleMemory("shutdown")
        this.running = false
        response = bootstrapAnalysisResponse(id, jsonNull())
    } else if (method == "cancel") {
        response = ""
    } else response = bootstrapAnalysisError(
        id, "method_not_found", "unsupported analysis method `$method`"
    )
    response
}

/** With ABLA_COMPILER_MEMORY_TRACE set, at a phase boundary of an analysis: collects the heap and prints the bytes still reachable to standard
 *  error as `abla-analysis-memory <label> <bytes>` (tools/test-analysis-memory.sh bounds the edit loop's peak against the cold analysis's).
 *  The collection comes first because live bytes read between two collections hold the garbage made since the last one (up to the collection
 *  growth, 256 MB, and where that falls moves with the allocation order); unlike the process's resident size, the reachable bytes do not
 *  depend on when the kernel gives pages back or on how loaded the machine is. */
fun bootstrapAnalysisSampleMemory(label: string): void {
    val configured = linuxEnvironment("ABLA_COMPILER_MEMORY_TRACE")
    if (!configured.found || configured.value == "") return
    runtimeMemoryCollect()
    linuxWriteStandardError("abla-analysis-memory $label ${runtimeMemoryLiveBytes()}\n")
    // Bytes held in read-only frozen groups (counted in the live bytes above): the part a collection does not mark.
    val frozen = runtimeMemoryHeapStat(11)
    if (frozen > 0) linuxWriteStandardError("abla-analysis-frozen $frozen\n")
    return
}

fun bootstrapAnalysisService(): int {
    // The editor's collections stop the service while it answers: four threads mark and sweep (ABLA_GC_WORKERS overrides).
    runtimeMemorySetGcWorkers(4)
    val service = BootstrapAnalysisService([], [], 1, false, true)
    val standardInput = linuxStandardInput()
    while (service.running) {
        val input = standardInput.readLine()
        if (!input.available) service.running = false
        else if (input.text != "") {
            val parsed = jsonParse(input.text)
            var response = ""
            if (!parsed.succeeded || !parsed.value.isObject()) {
                response = bootstrapAnalysisError(
                    0, "parse_error", "invalid JSON request"
                )
            } else response = service.handle(parsed.value)
            if (response != "") linuxPrintStandardOutput("$response\n")
        }
    }
    0
}
