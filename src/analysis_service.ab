// Persistent, editor-independent compiler analysis protocol.
// Editors talk to the standalone language server; compiler clients consume
// immutable source snapshots over this versioned JSON-lines service.

import "module.ab"
import "abla/json"
import "abla/sys/linux/fs"
import "abla/sys/linux/io"

val ABLA_ANALYSIS_PROTOCOL_VERSION: int = 1
val ABLA_ANALYSIS_MAX_DOCUMENTS: int = 20000
val ABLA_COMPILER_VERSION: string = "0.2.12"

class BootstrapAnalysisDocument(
    val uri: string,
    val path: string,
    val version: int,
    val text: string,
    var active: bool
)

class BootstrapAnalysisService(
    val roots: array<string>,
    val overlays: array<BootstrapAnalysisDocument>,
    var revision: int,
    var initialized: bool,
    var running: bool
)

class BootstrapAnalysisSemanticGroup(
    val declarations: array<BootstrapDeclaration>,
    val semantic: BootstrapSemanticResult
)

fun bootstrapAnalysisHexDigit(value: int): int {
    var result = -1
    if (value >= 48 && value <= 57) result = value - 48
    if (value >= 65 && value <= 70) result = value - 65 + 10
    if (value >= 97 && value <= 102) result = value - 97 + 10
    result
}

fun bootstrapAnalysisUriPath(uri: string): string {
    var begin = 0
    if (uri.size >= 7 && uri.slice(0, 7) == "file://") begin = 7
    var output = ""
    var index = begin
    while (index < uri.size) {
        if (uri[index] == 37 && index + 2 < uri.size) {
            val high = bootstrapAnalysisHexDigit(uri[index + 1])
            val low = bootstrapAnalysisHexDigit(uri[index + 2])
            if (high >= 0 && low >= 0) {
                output = "$output${byteEncode(high * 16 + low)}"
                index = index + 3
            } else {
                output = "$output${uri.slice(index, index + 1)}"
                index = index + 1
            }
        } else {
            output = "$output${uri.slice(index, index + 1)}"
            index = index + 1
        }
    }
    output
}

fun bootstrapAnalysisPathUri(path: string): string = "file://$path"

fun BootstrapAnalysisService.overlayIndex(uri: string): int {
    var result = -1
    var index = 0
    while (result < 0 && index < this.overlays.size) {
        if (this.overlays[index].uri == uri) result = index
        index = index + 1
    }
    result
}

fun BootstrapAnalysisService.storeOverlay(
    uri: string,
    version: int,
    text: string
): bool {
    val index = this.overlayIndex(uri)
    var accepted = true
    if (index >= 0 && version < this.overlays[index].version) accepted = false
    if (accepted) {
        val document = BootstrapAnalysisDocument(
            uri, bootstrapAnalysisUriPath(uri), version, text, true
        )
        if (index >= 0) this.overlays[index] = document
        else this.overlays.append(document)
        this.revision = this.revision + 1
    }
    accepted
}

fun BootstrapAnalysisService.closeOverlay(uri: string): void {
    val index = this.overlayIndex(uri)
    if (index >= 0) {
        this.overlays[index].active = false
        this.revision = this.revision + 1
    }
}

fun bootstrapAnalysisIgnoredDirectory(name: string): bool =
    name == ".git" || name == "build" || name == "dist" ||
    name == "node_modules" || name == ".cache" || name == ".direnv"

fun bootstrapAnalysisHasPath(
    documents: array<BootstrapAnalysisDocument>,
    path: string
): bool {
    var found = false
    var index = 0
    while (!found && index < documents.size) {
        if (documents[index].path == path) found = true
        index = index + 1
    }
    found
}

fun bootstrapAnalysisCollectDirectory(
    directory: Path,
    var documents: array<BootstrapAnalysisDocument>
): void {
    if (documents.size >= ABLA_ANALYSIS_MAX_DOCUMENTS) return
    val entries = directory.entries()
    var index = 0
    while (index < entries.size &&
           documents.size < ABLA_ANALYSIS_MAX_DOCUMENTS) {
        val entry = entries[index]
        val info = entry.info()
        if (info.isDirectory() &&
            !bootstrapAnalysisIgnoredDirectory(entry.name())) {
            bootstrapAnalysisCollectDirectory(entry, documents)
        }
        if (info.isFile() && entry.extension() == "ab" &&
            !bootstrapAnalysisHasPath(documents, entry.text)) {
            documents.append(BootstrapAnalysisDocument(
                bootstrapAnalysisPathUri(entry.text),
                entry.text,
                0,
                entry.readText(),
                true
            ))
        }
        index = index + 1
    }
}

fun BootstrapAnalysisService.documents(): array<BootstrapAnalysisDocument> {
    val documents: array<BootstrapAnalysisDocument> = []
    var overlay = 0
    while (overlay < this.overlays.size) {
        if (this.overlays[overlay].active) {
            documents.append(this.overlays[overlay])
        }
        overlay = overlay + 1
    }
    var root = 0
    while (root < this.roots.size &&
           documents.size < ABLA_ANALYSIS_MAX_DOCUMENTS) {
        val path = Path(this.roots[root])
        val info = path.info()
        if (info.isDirectory()) {
            bootstrapAnalysisCollectDirectory(path, documents)
        }
        if (info.isFile() && path.extension() == "ab" &&
            !bootstrapAnalysisHasPath(documents, path.text)) {
            documents.append(BootstrapAnalysisDocument(
                bootstrapAnalysisPathUri(path.text),
                path.text,
                0,
                path.readText(),
                true
            ))
        }
        root = root + 1
    }
    documents
}

fun bootstrapAnalysisDocumentPathIndex(
    documents: array<BootstrapAnalysisDocument>,
    requested: string
): int {
    val normalized = bootstrapNormalizeModulePath(requested)
    var result = -1
    var index = 0
    while (result < 0 && index < documents.size) {
        if (bootstrapNormalizeModulePath(documents[index].path) == normalized) {
            result = index
        }
        index = index + 1
    }
    result
}

// A workspace may contain independent projects, examples, fixtures, and test
// cases with intentionally repeated declaration names. Only modules connected
// by a real import edge share a semantic universe. Keeping those components
// separate prevents an unrelated `main`, helper, or fixture from making an
// otherwise valid open document ambiguous.
fun bootstrapAnalysisComponentIds(
    documents: array<BootstrapAnalysisDocument>
): array<int> {
    val components: array<int> = []
    var document = 0
    while (document < documents.size) {
        components.append(document)
        document = document + 1
    }
    document = 0
    while (document < documents.size) {
        val scan = bootstrapScanImports(documents[document].text)
        var edge = 0
        while (edge < scan.edges.size) {
            if (!scan.edges[edge].provider) {
                val resolved = bootstrapImportAliasExposedTarget(
                    bootstrapResolveImport(
                        documents[document].path,
                        scan.edges[edge].source
                    )
                )
                val imported = bootstrapAnalysisDocumentPathIndex(
                    documents, resolved
                )
                if (imported >= 0 &&
                    components[document] != components[imported]) {
                    val replaced = components[imported]
                    val retained = components[document]
                    var index = 0
                    while (index < components.size) {
                        if (components[index] == replaced) {
                            components[index] = retained
                        }
                        index = index + 1
                    }
                }
            }
            edge = edge + 1
        }
        document = document + 1
    }
    components
}

fun bootstrapAnalysisSymbolKind(kind: string): string {
    var result = "function"
    if (kind == "class") result = "class"
    if (kind == "interface") result = "interface"
    if (kind == "enum") result = "enum"
    if (kind == "type") result = "type"
    if (kind == "val" || kind == "compile.val") result = "value"
    if (kind == "var" || kind == "compile.var") result = "variable"
    result
}

fun bootstrapAnalysisDeclarationId(
    declaration: BootstrapDeclaration
): string = "abla:${declaration.sourceIdentity}:${declaration.begin}:${declaration.name}"

fun bootstrapAnalysisNameRange(
    tokens: array<BootstrapToken>,
    source: string,
    declaration: BootstrapDeclaration
): array<int> {
    var begin = declaration.begin
    var end = declaration.begin
    var found = false
    var index = 0
    while (!found && index < tokens.size) {
        val token = tokens[index]
        if (token.begin >= declaration.begin && token.end <= declaration.end &&
            token.kind == "identifier" &&
            bootstrapTokenText(source, token) == declaration.name) {
            begin = token.begin
            end = token.end
            found = true
        }
        index = index + 1
    }
    [begin, end]
}

fun bootstrapAnalysisSymbolJson(
    tokens: array<BootstrapToken>,
    source: string,
    uri: string,
    declaration: BootstrapDeclaration,
    topLevel: bool,
    containerId: string
): Json {
    val selection = bootstrapAnalysisNameRange(tokens, source, declaration)
    bootstrapAnalysisNamedSymbolJson(
        bootstrapAnalysisDeclarationId(declaration),
        declaration.name,
        bootstrapAnalysisSymbolKind(declaration.kind),
        uri,
        declaration.begin,
        declaration.end,
        selection[0],
        selection[1],
        "${declaration.kind} ${declaration.resultType}",
        topLevel,
        containerId
    )
}

fun bootstrapAnalysisNamedSymbolJson(
    id: string,
    name: string,
    kind: string,
    uri: string,
    begin: int,
    end: int,
    selectionBegin: int,
    selectionEnd: int,
    detail: string,
    topLevel: bool,
    containerId: string
): Json {
    val keys = [
        "id", "name", "kind", "uri", "range", "selectionRange",
        "detail", "topLevel"
    ]
    val values = [
        jsonString(id),
        jsonString(name),
        jsonString(kind),
        jsonString(uri),
        jsonObject(
            ["start", "end"],
            [jsonInteger(begin), jsonInteger(end)]
        ),
        jsonObject(
            ["start", "end"],
            [jsonInteger(selectionBegin), jsonInteger(selectionEnd)]
        ),
        jsonString(detail),
        jsonBoolean(topLevel)
    ]
    if (containerId != "") {
        keys.append("containerId")
        values.append(jsonString(containerId))
    }
    jsonObject(keys, values)
}

fun bootstrapAnalysisExpressionNameRange(
    tokens: array<BootstrapToken>,
    source: string,
    name: string,
    begin: int,
    end: int
): array<int> {
    var selectionBegin = begin
    var selectionEnd = begin
    var found = false
    var index = 0
    while (!found && index < tokens.size) {
        val token = tokens[index]
        if (token.begin >= begin && token.end <= end &&
            token.kind == "identifier" &&
            bootstrapTokenText(source, token) == name) {
            selectionBegin = token.begin
            selectionEnd = token.end
            found = true
        }
        index = index + 1
    }
    [selectionBegin, selectionEnd]
}

fun bootstrapAnalysisParameterRange(
    tokens: array<BootstrapToken>,
    source: string,
    declaration: BootstrapDeclaration,
    parameter: int
): array<int> {
    val name = declaration.parameters[parameter]
    var selection = [declaration.begin, declaration.begin]
    var found = false
    val headerEnd = if (declaration.expression.begin > declaration.begin) {
        declaration.expression.begin
    } else declaration.end
    var index = 1
    while (!found && index < tokens.size) {
        val token = tokens[index]
        val previous = tokens[index - 1]
        val introducer = previous.kind == "(" || previous.kind == "," ||
            previous.kind == "own" || previous.kind == "val" ||
            previous.kind == "var"
        if (token.begin >= declaration.begin &&
            token.end <= headerEnd && introducer &&
            token.kind == "identifier" &&
            bootstrapTokenText(source, token) == name) {
            selection = [token.begin, token.end]
            found = true
        }
        index = index + 1
    }
    [selection[0], selection[1]]
}

fun bootstrapAnalysisCollectLocalSymbols(
    tokens: array<BootstrapToken>,
    source: string,
    uri: string,
    sourceIdentity: string,
    expression: BootstrapExpression,
    containerId: string,
    var values: array<Json>
): void {
    var kind = ""
    var identityKind = "local"
    if (expression.kind == "local.val") kind = "value"
    if (expression.kind == "local.var") kind = "variable"
    if (expression.kind == "for") {
        kind = "value"
        identityKind = "for"
    }
    if (expression.kind == "lambda.parameter") {
        kind = "parameter"
        identityKind = "parameter"
    }
    if (kind != "" && expression.text != "") {
        val selection = bootstrapAnalysisExpressionNameRange(
            tokens, source, expression.text, expression.begin, expression.end
        )
        values.append(bootstrapAnalysisNamedSymbolJson(
            "abla:$sourceIdentity:${expression.begin}:$identityKind:${expression.text}",
            expression.text,
            kind,
            uri,
            expression.begin,
            expression.end,
            selection[0],
            selection[1],
            expression.kind,
            false,
            containerId
        ))
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapAnalysisCollectLocalSymbols(
            tokens, source, uri, sourceIdentity,
            expression.children[child], containerId, values
        )
        child = child + 1
    }
}

fun bootstrapAnalysisCollectDeclarationSymbols(
    tokens: array<BootstrapToken>,
    source: string,
    uri: string,
    declaration: BootstrapDeclaration,
    containerId: string,
    var values: array<Json>
): void {
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        val name = declaration.parameters[parameter]
        val selection = bootstrapAnalysisParameterRange(
            tokens, source, declaration, parameter
        )
        var kind = "parameter"
        var identityKind = "parameter"
        if (parameter < declaration.parameterKinds.size &&
            (declaration.parameterKinds[parameter] == "val" ||
             declaration.parameterKinds[parameter] == "var")) {
            kind = "property"
            identityKind = "field"
        }
        values.append(bootstrapAnalysisNamedSymbolJson(
            "abla:${declaration.sourceIdentity}:${declaration.begin}:$identityKind:$parameter:$name",
            name,
            kind,
            uri,
            selection[0],
            selection[1],
            selection[0],
            selection[1],
            if (parameter < declaration.parameterTypes.size)
                declaration.parameterTypes[parameter] else "unknown",
            false,
            containerId
        ))
        parameter = parameter + 1
    }
    bootstrapAnalysisCollectLocalSymbols(
        tokens, source, uri, declaration.sourceIdentity,
        declaration.expression, containerId, values
    )
}

fun bootstrapAnalysisSymbolsJson(
    source: string,
    uri: string,
    parsed: BootstrapParseResult
): Json {
    val values: array<Json> = []
    val tokens = bootstrapLex(source)
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        val id = bootstrapAnalysisDeclarationId(found)
        values.append(bootstrapAnalysisSymbolJson(
            tokens, source, uri, found, true, ""
        ))
        bootstrapAnalysisCollectDeclarationSymbols(
            tokens, source, uri, found, id, values
        )
        var method = 0
        while (method < found.methods.size) {
            val methodId = bootstrapAnalysisDeclarationId(
                found.methods[method]
            )
            values.append(bootstrapAnalysisSymbolJson(
                tokens, source, uri, found.methods[method], false, id
            ))
            bootstrapAnalysisCollectDeclarationSymbols(
                tokens, source, uri, found.methods[method], methodId, values
            )
            method = method + 1
        }
        declaration = declaration + 1
    }
    jsonArray(values)
}

fun bootstrapAnalysisCollectLocalIdentities(
    tokens: array<BootstrapToken>,
    source: string,
    sourceIdentity: string,
    expression: BootstrapExpression,
    var begins: array<int>,
    var ends: array<int>,
    var ids: array<string>
): void {
    var identityKind = ""
    if (expression.kind == "local.val" || expression.kind == "local.var") {
        identityKind = "local"
    }
    if (expression.kind == "for") identityKind = "for"
    if (expression.kind == "lambda.parameter") identityKind = "parameter"
    if (identityKind != "" && expression.text != "") {
        val selection = bootstrapAnalysisExpressionNameRange(
            tokens, source, expression.text, expression.begin, expression.end
        )
        begins.append(selection[0])
        ends.append(selection[1])
        ids.append(
            "abla:$sourceIdentity:${expression.begin}:$identityKind:${expression.text}"
        )
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapAnalysisCollectLocalIdentities(
            tokens, source, sourceIdentity, expression.children[child],
            begins, ends, ids
        )
        child = child + 1
    }
}

fun bootstrapAnalysisCollectDeclarationIdentities(
    tokens: array<BootstrapToken>,
    source: string,
    declaration: BootstrapDeclaration,
    var begins: array<int>,
    var ends: array<int>,
    var ids: array<string>
): void {
    var parameter = 0
    while (parameter < declaration.parameters.size) {
        val selection = bootstrapAnalysisParameterRange(
            tokens, source, declaration, parameter
        )
        var identityKind = "parameter"
        if (parameter < declaration.parameterKinds.size &&
            (declaration.parameterKinds[parameter] == "val" ||
             declaration.parameterKinds[parameter] == "var")) {
            identityKind = "field"
        }
        begins.append(selection[0])
        ends.append(selection[1])
        ids.append(
            "abla:${declaration.sourceIdentity}:${declaration.begin}:$identityKind:$parameter:${declaration.parameters[parameter]}"
        )
        parameter = parameter + 1
    }
    bootstrapAnalysisCollectLocalIdentities(
        tokens, source, declaration.sourceIdentity, declaration.expression,
        begins, ends, ids
    )
}

fun bootstrapAnalysisOccurrencesJson(
    source: string,
    sourceIdentity: string,
    parsed: BootstrapParseResult,
    declarations: array<BootstrapDeclaration>,
    semantic: BootstrapSemanticResult
): Json {
    val values: array<Json> = []
    val tokens = bootstrapLex(source)
    val declarationBegins: array<int> = []
    val declarationEnds: array<int> = []
    val declarationIds: array<string> = []
    var declaration = 0
    while (declaration < parsed.declarations.size) {
        val found = parsed.declarations[declaration]
        val selection = bootstrapAnalysisNameRange(tokens, source, found)
        declarationBegins.append(selection[0])
        declarationEnds.append(selection[1])
        declarationIds.append(bootstrapAnalysisDeclarationId(found))
        bootstrapAnalysisCollectDeclarationIdentities(
            tokens, source, found,
            declarationBegins, declarationEnds, declarationIds
        )
        var method = 0
        while (method < found.methods.size) {
            val member = found.methods[method]
            val memberSelection = bootstrapAnalysisNameRange(
                tokens, source, member
            )
            declarationBegins.append(memberSelection[0])
            declarationEnds.append(memberSelection[1])
            declarationIds.append(bootstrapAnalysisDeclarationId(member))
            bootstrapAnalysisCollectDeclarationIdentities(
                tokens, source, member,
                declarationBegins, declarationEnds, declarationIds
            )
            method = method + 1
        }
        declaration = declaration + 1
    }
    var index = 0
    while (index < tokens.size) {
        val token = tokens[index]
        if (token.kind == "identifier") {
            val name = bootstrapTokenText(source, token)
            val keys = ["name", "range"]
            val occurrenceValues = [
                jsonString(name),
                jsonObject(
                    ["start", "end"],
                    [jsonInteger(token.begin), jsonInteger(token.end)]
                )
            ]
            declaration = 0
            var declarationId = ""
            var resolvedType = ""
            while (declaration < declarationIds.size) {
                if (declarationBegins[declaration] == token.begin &&
                    declarationEnds[declaration] == token.end) {
                    declarationId = declarationIds[declaration]
                }
                declaration = declaration + 1
            }
            var resolvedName = 0
            while (declarationId == "" &&
                resolvedName < semantic.resolvedNames.size) {
                val resolved = semantic.resolvedNames[resolvedName]
                if (resolved.sourceIdentity == sourceIdentity &&
                    resolved.begin == token.begin &&
                    resolved.end == token.end && resolved.name == name) {
                    declarationId = resolved.declarationIdentity
                    resolvedType = resolved.type
                }
                resolvedName = resolvedName + 1
            }
            var call = 0
            while (declarationId == "" && call < semantic.typedCalls.size) {
                val typed = semantic.typedCalls[call]
                var matches = typed.sourceIdentity == sourceIdentity &&
                    typed.name == name && token.begin >= typed.begin &&
                    token.end <= typed.end
                if (matches && typed.kind == "call") {
                    matches = token.begin == typed.begin
                }
                if (matches && typed.kind == "member.call") {
                    matches = index > 0 && tokens[index - 1].kind == "."
                }
                if (matches) {
                    declarationId = bootstrapAnalysisHandleId(
                        declarations, typed.target
                    )
                    resolvedType = typed.type
                }
                call = call + 1
            }
            if (declarationId != "") {
                keys.append("declarationId")
                occurrenceValues.append(jsonString(declarationId))
            }
            if (resolvedType != "") {
                keys.append("type")
                occurrenceValues.append(jsonString(resolvedType))
            }
            values.append(jsonObject(keys, occurrenceValues))
        }
        index = index + 1
    }
    jsonArray(values)
}

fun bootstrapAnalysisHandleId(
    declarations: array<BootstrapDeclaration>,
    handle: int
): string {
    var id = ""
    if (handle >= 0 && handle < declarations.size) {
        id = bootstrapAnalysisDeclarationId(declarations[handle])
    }
    if (handle >= declarations.size) {
        val requested = handle - declarations.size
        var current = 0
        var owner = 0
        while (id == "" && owner < declarations.size) {
            var method = 0
            while (id == "" && method < declarations[owner].methods.size) {
                if (current == requested) id = bootstrapAnalysisDeclarationId(
                    declarations[owner].methods[method]
                )
                current = current + 1
                method = method + 1
            }
            owner = owner + 1
        }
    }
    id
}

fun bootstrapAnalysisCollectTypedRequests(
    expression: BootstrapExpression,
    sourceIdentity: string,
    var begins: array<int>,
    var ends: array<int>,
    var kinds: array<string>,
    var sources: array<string>
): void {
    if (expression.kind == "call" || expression.kind == "member.call") {
        begins.append(expression.begin)
        ends.append(expression.end)
        kinds.append(expression.kind)
        sources.append(sourceIdentity)
    }
    var child = 0
    while (child < expression.children.size) {
        bootstrapAnalysisCollectTypedRequests(
            expression.children[child], sourceIdentity,
            begins, ends, kinds, sources
        )
        child = child + 1
    }
}

fun bootstrapAnalysisCollectDeclarationRequests(
    declaration: BootstrapDeclaration,
    var begins: array<int>,
    var ends: array<int>,
    var kinds: array<string>,
    var sources: array<string>
): void {
    bootstrapAnalysisCollectTypedRequests(
        declaration.expression, declaration.sourceIdentity,
        begins, ends, kinds, sources
    )
    var value = 0
    while (value < declaration.parameterDefaults.size) {
        bootstrapAnalysisCollectTypedRequests(
            declaration.parameterDefaults[value], declaration.sourceIdentity,
            begins, ends, kinds, sources
        )
        value = value + 1
    }
    value = 0
    while (value < declaration.annotationArguments.size) {
        bootstrapAnalysisCollectTypedRequests(
            declaration.annotationArguments[value], declaration.sourceIdentity,
            begins, ends, kinds, sources
        )
        value = value + 1
    }
    var method = 0
    while (method < declaration.methods.size) {
        bootstrapAnalysisCollectDeclarationRequests(
            declaration.methods[method], begins, ends, kinds, sources
        )
        method = method + 1
    }
}

fun bootstrapAnalysisDiagnosticCode(diagnostics: string): string {
    var code = "E_ANALYSIS"
    var begin = -1
    var end = -1
    var index = 0
    while (begin < 0 && index + 6 < diagnostics.size) {
        if (diagnostics.slice(index, index + 6) == "error[") begin = index + 6
        index = index + 1
    }
    if (begin >= 0) {
        end = begin
        while (end < diagnostics.size && diagnostics[end] != 93) end = end + 1
        if (end < diagnostics.size) code = diagnostics.slice(begin, end)
    }
    code
}

fun bootstrapAnalysisAppendLocatedDiagnostics(
    diagnostics: string,
    prefix: string,
    text: string,
    var values: array<Json>
): void {
    var lineBegin = 0
    var previousError = ""
    while (lineBegin < diagnostics.size) {
        var lineEnd = lineBegin
        while (lineEnd < diagnostics.size &&
            diagnostics[lineEnd] != 10) lineEnd = lineEnd + 1
        val line = diagnostics.slice(lineBegin, lineEnd)
        if (line.size >= 6 && line.slice(0, 6) == "error[") {
            previousError = line
        }
        if (previousError != "" && line.size > prefix.size &&
            line.slice(0, prefix.size) == prefix) {
            val location = line.slice(prefix.size, line.size)
            var separator = 0
            while (separator < location.size &&
                location[separator] != 58) separator = separator + 1
            var begin = 0
            var digit = 0
            while (digit < separator && location[digit] >= 48 &&
                location[digit] <= 57) {
                begin = begin * 10 + location[digit] - 48
                digit = digit + 1
            }
            var end = begin + 1
            digit = separator + 1
            if (digit < location.size) {
                end = 0
                while (digit < location.size && location[digit] >= 48 &&
                    location[digit] <= 57) {
                    end = end * 10 + location[digit] - 48
                    digit = digit + 1
                }
            }
            if (begin > text.size) begin = text.size
            if (end < begin) end = begin
            if (end > text.size) end = text.size
            values.append(jsonObject(
                ["code", "message", "range"],
                [
                    jsonString(bootstrapAnalysisDiagnosticCode(previousError)),
                    jsonString(previousError),
                    jsonObject(
                        ["start", "end"],
                        [jsonInteger(begin), jsonInteger(end)]
                    )
                ]
            ))
            previousError = ""
        }
        lineBegin = lineEnd + 1
    }
}

fun bootstrapAnalysisDiagnosticsJson(
    text: string,
    parsed: BootstrapParseResult,
    semantic: BootstrapSemanticResult,
    sourceIdentity: string
): Json {
    val values: array<Json> = []
    bootstrapAnalysisAppendLocatedDiagnostics(
        parsed.diagnostics,
        "source[parser]:$sourceIdentity:",
        text,
        values
    )
    // Extension diagnostics do not all carry a normalized source identity yet.
    // Preserve a visible fallback until every generated/subparser producer does.
    if (values.size == 0 && (parsed.errors > 0 ||
        parsed.extensionErrors > 0 || parsed.diagnostics != "")) {
        values.append(jsonObject(
            ["code", "message", "range"],
            [
                jsonString(bootstrapAnalysisDiagnosticCode(
                    parsed.diagnostics
                )),
                jsonString(parsed.diagnostics),
                jsonObject(
                    ["start", "end"],
                    [jsonInteger(0), jsonInteger(if (text.size > 0) 1 else 0)]
                )
            ]
        ))
    }
    bootstrapAnalysisAppendLocatedDiagnostics(
        semantic.diagnostics,
        "source[semantic]:$sourceIdentity:",
        text,
        values
    )
    jsonArray(values)
}

fun bootstrapAnalysisDocumentJson(
    document: BootstrapAnalysisDocument,
    parsed: BootstrapParseResult,
    declarations: array<BootstrapDeclaration>,
    semantic: BootstrapSemanticResult
): Json {
    jsonObject(
        [
            "uri", "version", "text", "symbols", "occurrences",
            "diagnostics"
        ],
        [
            jsonString(document.uri),
            jsonInteger(document.version),
            jsonString(document.text),
            bootstrapAnalysisSymbolsJson(document.text, document.uri, parsed),
            bootstrapAnalysisOccurrencesJson(
                document.text, document.path, parsed, declarations, semantic
            ),
            bootstrapAnalysisDiagnosticsJson(
                document.text, parsed, semantic, document.path
            )
        ]
    )
}

fun bootstrapAnalysisSemanticGroup(
    documents: array<BootstrapAnalysisDocument>,
    parsedDocuments: array<BootstrapParseResult>,
    components: array<int>,
    requestedComponent: int
): BootstrapAnalysisSemanticGroup {
    val declarations: array<BootstrapDeclaration> = []
    val actions: array<BootstrapExpression> = []
    val compileInputPaths: array<string> = []
    val compileInputContents: array<string> = []
    var errors = 0
    var extensionErrors = 0
    var diagnostics = ""
    val typedBegins: array<int> = []
    val typedEnds: array<int> = []
    val typedKinds: array<string> = []
    val typedSources: array<string> = []
    var document = 0
    while (document < documents.size) {
        if (components[document] == requestedComponent) {
            val parsed = parsedDocuments[document]
            errors = errors + parsed.errors
            extensionErrors = extensionErrors + parsed.extensionErrors
            diagnostics = "$diagnostics${parsed.diagnostics}"
            var declaration = 0
            while (declaration < parsed.declarations.size) {
                declarations.append(parsed.declarations[declaration])
                bootstrapAnalysisCollectDeclarationRequests(
                    parsed.declarations[declaration],
                    typedBegins, typedEnds, typedKinds, typedSources
                )
                declaration = declaration + 1
            }
            var action = 0
            while (action < parsed.actions.size) {
                actions.append(parsed.actions[action])
                bootstrapAnalysisCollectTypedRequests(
                    parsed.actions[action], documents[document].path,
                    typedBegins, typedEnds, typedKinds, typedSources
                )
                action = action + 1
            }
        }
        document = document + 1
    }
    val merged = BootstrapParseResult(
        declarations, actions, errors, extensionErrors,
        compileInputPaths, compileInputContents, diagnostics
    )
    BootstrapAnalysisSemanticGroup(
        declarations,
        bootstrapAnalyzeRequestedSourceSpans(
            merged, typedBegins, typedEnds, typedKinds, typedSources
        )
    )
}

fun BootstrapAnalysisService.snapshot(): Json {
    val documents = this.documents()
    val parsedDocuments: array<BootstrapParseResult> = []
    var documentIndex = 0
    while (documentIndex < documents.size) {
        val parsed = bootstrapParseWithIdentity(
            documents[documentIndex].text,
            documents[documentIndex].path
        )
        parsedDocuments.append(parsed)
        documentIndex = documentIndex + 1
    }
    val components = bootstrapAnalysisComponentIds(documents)
    val groupIds: array<int> = []
    val groups: array<BootstrapAnalysisSemanticGroup> = []
    val values: array<Json> = []
    var index = 0
    while (index < documents.size) {
        var group = -1
        var candidate = 0
        while (group < 0 && candidate < groupIds.size) {
            if (groupIds[candidate] == components[index]) group = candidate
            candidate = candidate + 1
        }
        if (group < 0) {
            groupIds.append(components[index])
            groups.append(bootstrapAnalysisSemanticGroup(
                documents, parsedDocuments, components, components[index]
            ))
            group = groups.size - 1
        }
        values.append(bootstrapAnalysisDocumentJson(
            documents[index], parsedDocuments[index],
            groups[group].declarations, groups[group].semantic
        ))
        index = index + 1
    }
    jsonObject(
        ["revision", "documents"],
        [jsonString("${this.revision}"), jsonArray(values)]
    )
}

fun bootstrapAnalysisSnapshotDiagnosticCount(
    snapshot: Json,
    uri: string,
    code: string,
    message: string
): int {
    var count = 0
    val documents = snapshot.get("documents")
    var document = 0
    while (documents.isArray() && document < documents.size()) {
        val found = documents.at(document)
        if (uri == "" || found.getString("uri") == uri) {
            val diagnostics = found.get("diagnostics")
            var diagnostic = 0
            while (diagnostics.isArray() && diagnostic < diagnostics.size()) {
                val candidate = diagnostics.at(diagnostic)
                if ((code == "" || candidate.getString("code") == code) &&
                    (message == "" ||
                     candidate.getString("message") == message)) {
                    count = count + 1
                }
                diagnostic = diagnostic + 1
            }
        }
        document = document + 1
    }
    count
}

fun bootstrapAnalysisSnapshotIntroducesDiagnostic(
    baseline: Json,
    prospective: Json
): bool {
    var introduced = false
    val documents = prospective.get("documents")
    var document = 0
    while (!introduced && documents.isArray() && document < documents.size()) {
        val found = documents.at(document)
        val uri = found.getString("uri")
        val diagnostics = found.get("diagnostics")
        var diagnostic = 0
        while (!introduced && diagnostics.isArray() &&
            diagnostic < diagnostics.size()) {
            val candidate = diagnostics.at(diagnostic)
            val code = candidate.getString("code")
            val message = candidate.getString("message")
            val candidateCount = bootstrapAnalysisSnapshotDiagnosticCount(
                prospective, uri, code, message
            )
            val baselineCount = bootstrapAnalysisSnapshotDiagnosticCount(
                baseline, uri, code, message
            )
            if (candidateCount > baselineCount) introduced = true
            diagnostic = diagnostic + 1
        }
        document = document + 1
    }
    introduced
}

fun bootstrapAnalysisEditsUri(edits: Json, uri: string): bool {
    var found = false
    var edit = 0
    while (!found && edits.isArray() && edit < edits.size()) {
        if (edits.at(edit).getString("uri") == uri) found = true
        edit = edit + 1
    }
    found
}

fun bootstrapAnalysisSnapshotPreservesUneditedSymbols(
    baseline: Json,
    prospective: Json,
    edits: Json
): bool {
    var preserved = true
    val baselineDocuments = baseline.get("documents")
    val prospectiveDocuments = prospective.get("documents")
    var document = 0
    while (preserved && baselineDocuments.isArray() &&
        document < baselineDocuments.size()) {
        val before = baselineDocuments.at(document)
        val uri = before.getString("uri")
        if (!bootstrapAnalysisEditsUri(edits, uri)) {
            var afterIndex = 0
            var matched = false
            while (!matched && prospectiveDocuments.isArray() &&
                afterIndex < prospectiveDocuments.size()) {
                val after = prospectiveDocuments.at(afterIndex)
                if (after.getString("uri") == uri) {
                    matched = jsonStringify(before.get("symbols")) ==
                        jsonStringify(after.get("symbols"))
                }
                afterIndex = afterIndex + 1
            }
            if (!matched) preserved = false
        }
        document = document + 1
    }
    preserved
}

fun bootstrapAnalysisOwnedString(value: string): string = "$value"

fun BootstrapAnalysisService.validateEdit(params: Json): Json {
    var valid = params.getString("baseRevision") == "${this.revision}"
    var reason = if (valid) "" else "analysis revision is stale"
    val candidate = BootstrapAnalysisService([], [], this.revision, true, true)
    var root = 0
    while (root < this.roots.size) {
        candidate.roots.append(bootstrapAnalysisOwnedString(this.roots[root]))
        root = root + 1
    }
    val documents = this.documents()
    var document = 0
    while (document < documents.size) {
        val found = documents[document]
        candidate.overlays.append(BootstrapAnalysisDocument(
            bootstrapAnalysisOwnedString(found.uri),
            bootstrapAnalysisOwnedString(found.path),
            found.version,
            bootstrapAnalysisOwnedString(found.text),
            true
        ))
        document = document + 1
    }

    val edits = params.get("edits")
    if (!edits.isArray()) {
        valid = false
        reason = "edits must be an array"
    }
    document = 0
    var edit = 0
    while (valid && document < candidate.overlays.size) {
        val uri = candidate.overlays[document].uri
        var text = bootstrapAnalysisOwnedString(
            candidate.overlays[document].text
        )
        val applied: array<bool> = []
        edit = 0
        while (edit < edits.size()) {
            applied.append(edits.at(edit).getString("uri") != uri)
            edit = edit + 1
        }
        var remaining = true
        while (valid && remaining) {
            remaining = false
            var selected = -1
            var selectedStart = -1
            edit = 0
            while (edit < edits.size()) {
                if (!applied[edit]) {
                    remaining = true
                    val start = edits.at(edit).getInt("start")
                    if (start > selectedStart) {
                        selected = edit
                        selectedStart = start
                    }
                }
                edit = edit + 1
            }
            if (selected >= 0) {
                val requested = edits.at(selected)
                val start = requested.getInt("start")
                val end = requested.getInt("end")
                if (start < 0 || end < start || end > text.size) {
                    valid = false
                    reason = "edit range is outside its document"
                } else text = "${text.slice(0, start)}${requested.getString(
                    "newText"
                )}${text.slice(end, text.size)}"
                applied[selected] = true
            }
        }
        if (valid && text != candidate.overlays[document].text) {
            val previous = candidate.overlays[document]
            candidate.overlays[document] = BootstrapAnalysisDocument(
                bootstrapAnalysisOwnedString(previous.uri),
                bootstrapAnalysisOwnedString(previous.path),
                previous.version + 1,
                text,
                true
            )
        }
        document = document + 1
    }
    edit = 0
    while (valid && edit < edits.size()) {
        if (candidate.overlayIndex(edits.at(edit).getString("uri")) < 0) {
            valid = false
            reason = "edit targets an unanalyzed document"
        }
        edit = edit + 1
    }

    val baseline = this.snapshot()
    val prospective = if (valid) candidate.snapshot() else jsonNull()
    if (valid && bootstrapAnalysisSnapshotIntroducesDiagnostic(
        baseline, prospective
    )) {
        valid = false
        reason = "prospective edit introduces compiler diagnostics"
    }
    if (valid && !bootstrapAnalysisSnapshotPreservesUneditedSymbols(
        baseline, prospective, edits
    )) {
        valid = false
        reason = "prospective edit changes symbols outside edited documents"
    }
    if (valid) jsonObject(
        ["valid", "snapshot"],
        [jsonBoolean(true), prospective]
    ) else jsonObject(
        ["valid", "reason"],
        [jsonBoolean(false), jsonString(reason)]
    )
}

fun bootstrapAnalysisResponse(id: int, result: Json): string =
    jsonStringify(jsonObject(
        ["schema", "id", "result"],
        [jsonInteger(ABLA_ANALYSIS_PROTOCOL_VERSION), jsonInteger(id), result]
    ))

fun bootstrapAnalysisError(id: int, code: string, message: string): string =
    jsonStringify(jsonObject(
        ["schema", "id", "error"],
        [
            jsonInteger(ABLA_ANALYSIS_PROTOCOL_VERSION),
            jsonInteger(id),
            jsonObject(
                ["code", "message"],
                [jsonString(code), jsonString(message)]
            )
        ]
    ))

fun BootstrapAnalysisService.initialize(params: Json): Json {
    val requestedRoots = params.get("workspaceRoots")
    var index = 0
    if (requestedRoots.isArray()) {
        while (index < requestedRoots.size()) {
            val root = requestedRoots.at(index)
            if (root.isString()) this.roots.append(root.asString())
            index = index + 1
        }
    }
    this.initialized = true
    jsonObject(
        ["compilerVersion", "protocolVersion", "capabilities"],
        [
            jsonString(ABLA_COMPILER_VERSION),
            jsonInteger(ABLA_ANALYSIS_PROTOCOL_VERSION),
            jsonArray([
                jsonString("document-overlays"),
                jsonString("parser-diagnostics"),
                jsonString("declarations"),
                jsonString("semantic-call-references"),
                jsonString("semantic-name-references")
            ])
        ]
    )
}

fun BootstrapAnalysisService.handle(request: Json): string {
    val id = request.getInt("id")
    val schema = request.getInt("schema")
    val method = request.getString("method")
    val params = request.get("params")
    var response = ""
    if (schema != ABLA_ANALYSIS_PROTOCOL_VERSION) {
        response = bootstrapAnalysisError(
            id, "unsupported_schema", "unsupported analysis protocol schema"
        )
    } else if (method == "initialize") {
        response = bootstrapAnalysisResponse(id, this.initialize(params))
    } else if (!this.initialized) {
        response = bootstrapAnalysisError(
            id, "not_initialized", "initialize must be the first request"
        )
    } else if (method == "document/open" || method == "document/change") {
        val uri = params.getString("uri")
        val accepted = this.storeOverlay(
            uri, params.getInt("version"), params.getString("text")
        )
        if (uri == "") response = bootstrapAnalysisError(
            id, "invalid_params", "document uri must not be empty"
        )
        else if (!accepted) response = bootstrapAnalysisError(
            id, "stale_document", "document version is older than the overlay"
        )
        else response = bootstrapAnalysisResponse(id, jsonNull())
    } else if (method == "document/close") {
        this.closeOverlay(params.getString("uri"))
        response = bootstrapAnalysisResponse(id, jsonNull())
    } else if (method == "analyze") {
        response = bootstrapAnalysisResponse(id, this.snapshot())
    } else if (method == "refactor/validate") {
        response = bootstrapAnalysisResponse(id, this.validateEdit(params))
    } else if (method == "shutdown") {
        this.running = false
        response = bootstrapAnalysisResponse(id, jsonNull())
    } else if (method == "cancel") {
        response = ""
    } else response = bootstrapAnalysisError(
        id, "method_not_found", "unsupported analysis method `$method`"
    )
    response
}

fun bootstrapAnalysisService(): int {
    val service = BootstrapAnalysisService([], [], 1, false, true)
    val standardInput = linuxStandardInput()
    while (service.running) {
        val input = standardInput.readLine()
        if (!input.available) service.running = false
        else if (input.text != "") {
            val parsed = jsonParse(input.text)
            var response = ""
            if (!parsed.succeeded || !parsed.value.isObject()) {
                response = bootstrapAnalysisError(
                    0, "parse_error", "invalid JSON request"
                )
            } else response = service.handle(parsed.value)
            if (response != "") linuxPrintStandardOutput("$response\n")
        }
    }
    0
}
